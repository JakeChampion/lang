import "std/string";
import "./ast";
import "./astwalk";
import "./util";
import "./lexer";
import "./builtinsigs";
import "./typeinfo";
import "std/option";

struct ParamDestr { pattern: ast.Destr, synth: string, line: i32, col: i32 }

pub struct FuncDecl { stdlib: string, no_inline: boolean, always_inline: boolean, name: string, receiver_name: string, receiver_type: string, receiver_own: boolean, type_params: string[], params: ast.ParamDecl[], ret_own: boolean, ret_type: string, body: ast.Stmt[], line: i32, col: i32, import_iface: string, import_wit: string, import_weak: boolean, all_type_params: string[], bound_traits: string[], bound_modules: string[], fip: boolean, fbip: boolean, fip_allowance: i32, async: boolean, is_const: boolean, is_pub: boolean, is_package: boolean, ret_fn_ret: string, ret_fn_param_types: string, module: string, impl_trait: string, dyn_traits: string[], streams: i32[], is_unsafe: boolean }

pub struct StructFieldDecl { name: string, type_name: string, fn_ret: string, fn_param_types: string, line: i32, col: i32 }

pub const VARIANT_PAYLOAD_PREFIX: string = "__ev";

// The first enum payload field has no numeric suffix.
pub function variant_payload_name(index: i32): string {
  if (index <= 0) {
    return VARIANT_PAYLOAD_PREFIX;
  }
  return VARIANT_PAYLOAD_PREFIX + util.i32_to_string(index);
}

pub function bare_field(name: string, type_name: string): StructFieldDecl {
  return StructFieldDecl { name: name, type_name: type_name, fn_ret: "", fn_param_types: "", line: 0, col: 0 };
}

pub struct StructDecl { name: string, fields: StructFieldDecl[], type_params: string[], const_params: string[], derives: string[], line: i32, col: i32, enum_owner: string, must_consume: boolean, secret: boolean, value_type: boolean, variant_field_names: string[], is_pub: boolean, is_package: boolean, opaque: boolean, module: string }

pub struct TypeAlias { name: string, variants: string[], variant_args: string[], variant_lines: i32[], type_params: string[], const_params: string[], line: i32, col: i32, is_pub: boolean, is_package: boolean, module: string }

pub struct Import { path: string, is_reexport: boolean, reexport_names: string[], alias: string, line: i32, col: i32, resolved: string }

pub function warn_unresolved_imports(mod: Module, driver: string): boolean {
  if (mod.imports.len() == 0) {
    return false;
  }
  let paths = "";
  for i in 0..mod.imports.len() {
    if (i > 0) {
      paths += ", ";
    }
    paths = paths + "\"" + mod.imports[i].path + "\"";
  }
  eprint("warning: " + driver + " has no module loader; UNRESOLVED imports: " + paths);
  eprint("warning: any verdict below (ir/refused, exit code, eligibility bail) describes a BROKEN program, not the language.");
  eprint("warning: to judge this program use a loading driver: `fern <prog> <stdlib-root>`, or asm_load_run.");
  if (util.debug_flag("FERN_DEBUG_STRICT_IMPORTS", "FERN_STRICT_IMPORTS")) {
    eprint("error: FERN_STRICT_IMPORTS refuses an unresolvable-import run");
    exit(3);
  }
  return true;
}

pub struct TodoSite { line: i32, col: i32 }

pub struct ModuleSight { module: string, imports: string[], qualifiers: string[], direct: string[], reaches: string[], reexport_keys: string[], reexport_targets: string[], package: string }

// How near module decl is to module from: 0 for the same module, 1 for a
// direct import, 2 for the rest of the import closure, 3 when not visible.
pub function module_rank(sights: ModuleSight[], from: string, decl: string): i32 {
  if (from == decl) {
    return 0;
  }
  for sg in sights {
    if (sg.module == from) {
      if (util.has_str(sg.direct, decl)) {
        return 1;
      }
      if (util.has_str(sg.reaches, decl)) {
        return 2;
      }
      return 3;
    }
  }
  return 2;
}

pub struct Module { funcs: FuncDecl[], structs: StructDecl[], aliases: TypeAlias[], imports: Import[], top_stmts: ast.Stmt[], enums: EnumDecl[], resources: ResourceDecl[], exports: ExportBinding[], marks: FuncMark[], impls: ImplInfo[], trait_reqs: TraitReq[], trait_decls: TraitDecl[], substituted_consts: string[], todo_sites: TodoSite[], sights: ModuleSight[] }

pub function with_stdlib_origin(mod: Module, path: string): Module {
  if (!util.is_stdlib_path(path)) {
    return mod;
  }
  path = util.without_fern_ext(path);
  let funcs: FuncDecl[] = [];
  for f in mod.funcs {
    funcs = funcs.append(FuncDecl { ...f, stdlib: path });
  }
  return Module { ...mod, funcs: funcs };
}

pub struct TraitReq { trait_name: string, type_params: string[], methods: string[], req_sigs: FuncDecl[], supertraits: string[], assoc_sigs: FuncDecl[], provided: string[], assoc_types: string[], module: string, default_sigs: FuncDecl[], visible_from: string[] }

pub struct TraitDecl { name: string, type_params: string[], const_params: string[], supertraits: string[], methods: FuncDecl[], line: i32, col: i32, is_pub: boolean, is_package: boolean, assoc_types: string[] }

pub struct ImplDecl { trait_ref: string, type_ref: string, type_params: string[], bounds: string[], methods: FuncDecl[], line: i32, col: i32, assoc_names: string[], assoc_values: string[] }

pub struct FieldLines { name: string, decl_line: i32, lines: i32[] }

pub struct FunctionInlineHint { line: i32, col: i32, never: boolean }

pub struct ParsedFmt { pmod: Module, ptraits: TraitDecl[], pimpls: ImplDecl[], pflines: FieldLines[], pinline: FunctionInlineHint[], pspans: BlockSpans }

// else_of[i] is the span whose `}` comes just before `else` and span i, or -1.
pub struct BlockSpans { opens: i32[], firsts: i32[], closes: i32[], else_of: i32[] }

function token_line(t: lexer.Token): i32 {
  match (t) {
    lexer.TokEof(x) => {
      return x.line;
    },
    lexer.TokNumber(x) => {
      return x.line;
    },
    lexer.TokIdent(x) => {
      return x.line;
    },
    lexer.TokKeyword(x) => {
      return x.line;
    },
    lexer.TokPunct(x) => {
      return x.line;
    },
    lexer.TokString(x) => {
      return x.line;
    },
    lexer.TokError(x) => {
      return x.line;
    },
    lexer.TokFString(x) => {
      return x.line;
    }
  }
}

function opens_non_block(t: lexer.Token): boolean {
  if let lexer.TokKeyword(k) = t {
    return k.name == "match" || k.name == "struct" || k.name == "enum" || k.name == "trait" || k.name == "impl";
  }
  return false;
}

function block_spans(toks: lexer.Token[]): BlockSpans {
  let opens: i32[] = [];
  let firsts: i32[] = [];
  let closes: i32[] = [];
  let else_of: i32[] = [];
  let stack: i32[] = [];
  let closed = -1;
  let sp = 0;
  let nest = 0;
  let skip_at = -1;
  for i in 0..toks.len() {
    if (skip_at < 0 && opens_non_block(toks[i])) {
      skip_at = nest;
    }
    if let lexer.TokPunct(x) = toks[i] {
      if (x.text == "(" || x.text == "[") {
        nest += 1;
      } else if (x.text == ")" || x.text == "]") {
        nest -= 1;
      } else if (x.text == ";" && skip_at == nest) {
        skip_at = -1;
      } else if (x.text == "{") {
        let at = -1;
        if (skip_at == nest) {
          skip_at = -1;
        } else {
          let first = 0;
          if (i + 1 < toks.len()) {
            first = token_line(toks[i + 1]);
          }
          at = opens.len();
          opens = opens.append(x.line);
          firsts = firsts.append(first);
          closes = closes.append(0);
          else_of = else_of.append(else_owner(toks, i, closed));
        }
        if (sp < stack.len()) {
          stack = stack.with(sp, at);
        } else {
          stack = stack.append(at);
        }
        sp += 1;
      } else if (x.text == "}" && sp > 0) {
        sp -= 1;
        if (stack[sp] >= 0) {
          closes = closes.with(stack[sp], x.line);
        }
        closed = stack[sp];
      }
    }
  }
  return BlockSpans { opens: opens, firsts: firsts, closes: closes, else_of: else_of };
}

function else_owner(toks: lexer.Token[], i: i32, closed: i32): i32 {
  if (i < 2) {
    return -1;
  }
  if let lexer.TokKeyword(k) = toks[i - 1] {
    if let lexer.TokPunct(x) = toks[i - 2] {
      if (k.name == "else" && x.text == "}") {
        return closed;
      }
    }
  }
  return -1;
}

pub struct ResourceDecl { name: string, iface: string, wit: string, line: i32, col: i32 }

// A function that the image exports. @export names a wasm world export,
// and -export a C symbol (c_abi). @jni names a JNI method: `iface` is the
// Java class and `wit` the Java declaration.
pub struct ExportBinding { func_name: string, iface: string, wit: string, c_abi: boolean, method: boolean, jni: boolean }

// An attribute on a function that a later pass reads: `@provide("log")`, with
// the capability as `arg`, or `@norc`.
pub struct FuncMark { attr: string, arg: string, func_name: string, line: i32, col: i32 }

// Whether code outside the program names the function: an export, or an
// `@interrupt` handler, which the vector table calls.
pub function named_outside(mod: Module, name: string): boolean {
  for x in mod.exports {
    if (x.func_name == name) {
      return true;
    }
  }
  for m in mod.marks {
    if ((m.attr == "interrupt" || m.attr == "early" || m.attr == "secondary") && m.func_name == name) {
      return true;
    }
  }
  return false;
}

// The mark of a runtime function that only direct calls reach. Without it, a
// name that starts with "__" may be called by name from emitted text.
pub const DIRECT_MARK: string = "direct";

pub function reached_directly(mod: Module, name: string): boolean {
  for m in mod.marks {
    if (m.attr == DIRECT_MARK && m.func_name == name) {
      return true;
    }
  }
  return false;
}

// An async export is named outside too: its lift wrapper calls it.
pub function decl_named_outside(mod: Module, fd: FuncDecl): boolean {
  return fd.async && fd.import_iface == "" || named_outside(mod, fd.name);
}

pub function marked(mod: Module, attr: string): FuncMark[] {
  let out: FuncMark[] = [];
  for m in mod.marks {
    if (m.attr == attr) {
      out = out.append(m);
    }
  }
  return out;
}

pub struct EnumDecl { name: string, variant_names: string[], type_params: string[], const_params: string[], line: i32, col: i32, must_consume: boolean, try_marker: boolean, is_pub: boolean, is_package: boolean, module: string, instance: string, visible_from: string[] }

function enum_variant_names(variants: StructDecl[]): string[] {
  let out: string[] = [];
  for i in 0..variants.len() {
    out = out.append(variants[i].name);
  }
  return out;
}

function concat_enums(a: EnumDecl[], b: EnumDecl[]): EnumDecl[] {
  let out = a;
  for i in 0..b.len() {
    out = out.append(b[i]);
  }
  return out;
}

pub function e_number(text: string, suffix: string, is_float: boolean): ast.Expr {
  return ast.ExprNumber { text: text, suffix: suffix, raw: "", is_float: is_float, bits: literal_bits(text, is_float), line: 0, col: 0 };
}

pub function literal_bits(text: string, is_float: boolean): i64 {
  if (!is_float) {
    return util.lit_to_i64(text);
  }
  return util.parse_f64_bits(text);
}

function e_spelled_at(text: string, suffix: string, raw: string, is_float: boolean, line: i32, col: i32): ast.Expr {
  return ast.ExprNumber { text: text, suffix: suffix, raw: raw, is_float: is_float, bits: literal_bits(text, is_float), line: line, col: col };
}

function e_unit_at(line: i32, col: i32): ast.Expr {
  return ast.ExprNumber { text: "0", suffix: "", raw: "()", is_float: false, bits: 0, line: line, col: col };
}

pub function discard_name(name: string, line: i32, col: i32, nth: i32): string {
  if (name != "_") {
    return name;
  }
  return "__discard_" + util.i32_to_string(line) + "_" + util.i32_to_string(col) + "_" + util.i32_to_string(nth);
}

pub function is_quoted_literal(n: ast.ExprNumber): boolean {
  return n.raw.len() > 0 && (n.raw[0] == b'\'' || n.raw.len() > 1 && n.raw[0] == b'b' && n.raw[1] == b'\'');
}

pub function is_cast_op(op: string): boolean {
  return op == ast.CAST;
}

pub const BARE_RETURN: string = "bare-return";

// The import interface of a @callback("f") declaration. The compiler gives
// the declaration a body that returns the address of the C entry of f.
pub const CALLBACK_IFACE: string = "fern:callback";

pub const REPORTED: string = "reported";

pub function bare_return(e: ast.Expr): boolean {
  if let ast.ExprUnknown(u) = e {
    return u.fault.mark == BARE_RETURN;
  }
  return is_unit_expr(e);
}

pub function is_unit_expr(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return ast.is_unit_literal(n);
    },
    _ => {
      return false;
    }
  }
}

pub function e_ident(name: string): ast.Expr {
  return ast.ExprIdent { name: name, line: 0, col: 0, ty: "", builtin: false };
}

// The body assert and todo desugar to: the builtin eprint of text, then the builtin exit with status.
function abort_body(text: ast.Expr, status: string): ast.Stmt[] {
  let eprint: ast.Expr = ast.ExprIdent { name: "eprint", line: 0, col: 0, ty: "", builtin: true };
  let exit: ast.Expr = ast.ExprIdent { name: "exit", line: 0, col: 0, ty: "", builtin: true };
  return [s_expr(e_call(eprint, [text])), s_expr(e_call(exit, [e_number(status, "", false)]))];
}

function e_ident_at(name: string, line: i32, col: i32): ast.Expr {
  return ast.ExprIdent { name: name, line: line, col: col, ty: "", builtin: false };
}

function e_string(value: string): ast.Expr {
  return ast.ExprString { value: value, line: 0, col: 0 };
}

function e_string_at(value: string, line: i32, col: i32): ast.Expr {
  return ast.ExprString { value: value, line: line, col: col };
}

pub function e_bool(value: boolean): ast.Expr {
  return ast.ExprBool { value: value, line: 0, col: 0 };
}

function e_bool_at(value: boolean, line: i32, col: i32): ast.Expr {
  return ast.ExprBool { value: value, line: line, col: col };
}

pub function e_binary(op: string, left: ast.Expr, right: ast.Expr): ast.Expr {
  return ast.binary(op, left, right, 0, 0, "");
}

function e_binary_at(op: string, left: ast.Expr, right: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.binary(op, left, right, line, col, "");
}

pub function e_unary(op: string, operand: ast.Expr): ast.Expr {
  return ast.unary(op, operand, 0, 0, "");
}

function e_unary_at(op: string, operand: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.unary(op, operand, line, col, "");
}

pub function e_cast(target: string, operand: ast.Expr): ast.Expr {
  return ast.cast(operand, target, false, 0, 0, "");
}

pub function e_call(callee: ast.Expr, args: ast.Expr[]): ast.Expr {
  return ast.ExprCall { callee: callee, args: args, line: 0, col: 0, type_args: [], ty: "" };
}

function e_call_at(callee: ast.Expr, args: ast.Expr[], line: i32, col: i32): ast.Expr {
  return ast.ExprCall { callee: callee, args: args, line: line, col: col, type_args: [], ty: "" };
}

function e_array(elements: ast.Expr[]): ast.Expr {
  return ast.ExprArray { elements: elements, elem_ty: "", line: 0, col: 0 };
}

function e_array_at(elements: ast.Expr[], line: i32, col: i32): ast.Expr {
  return ast.ExprArray { elements: elements, elem_ty: "", line: line, col: col };
}

function e_tuple_at(elements: ast.Expr[], line: i32, col: i32): ast.Expr {
  return ast.ExprTuple { elements: elements, line: line, col: col };
}

pub function e_index(array: ast.Expr, index: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprIndex { array: array, index: index, unchecked: false, ty: "", line: line, col: col };
}

function e_slice(array: ast.Expr, start: ast.Expr, end: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprSlice { array: array, start: start, end: end, ty: "", open_end: false, open_start: false, line: line, col: col };
}

function e_slice_open(array: ast.Expr, start: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprSlice { array: array, start: start, end: e_number("0", "", false), ty: "", open_end: true, open_start: false, line: line, col: col };
}

function e_slice_from_start(array: ast.Expr, end: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprSlice { array: array, start: e_number("0", "", false), end: end, ty: "", open_end: false, open_start: true, line: line, col: col };
}

function e_slice_all(array: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprSlice { array: array, start: e_number("0", "", false), end: e_number("0", "", false), ty: "", open_end: true, open_start: true, line: line, col: col };
}

function e_struct_lit(type_name: string, field_names: string[], field_lines: i32[], field_cols: i32[], field_values: ast.Expr[], line: i32, col: i32): ast.Expr {
  return ast.ExprStructLit { type_name: type_name, field_names: field_names, field_lines: field_lines, field_cols: field_cols, field_values: field_values, has_base: false, base: e_unknown("no-base"), line: line, col: col, written: "" };
}

function e_struct_update(type_name: string, field_names: string[], field_lines: i32[], field_cols: i32[], field_values: ast.Expr[], base: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprStructLit { type_name: type_name, field_names: field_names, field_lines: field_lines, field_cols: field_cols, field_values: field_values, has_base: true, base: base, line: line, col: col, written: "" };
}

pub function e_field_access(obj: ast.Expr, field: string): ast.Expr {
  return ast.ExprFieldAccess { obj: obj, field: field, line: 0, col: 0, ty: "", const_read: false, display: false };
}

function e_field_access_at(obj: ast.Expr, field: string, line: i32, col: i32): ast.Expr {
  return ast.ExprFieldAccess { obj: obj, field: field, line: line, col: col, ty: "", const_read: false, display: false };
}

pub function e_lambda_at(params: ast.ParamDecl[], ret_type: string, body: ast.Stmt[], origin: string, line: i32, col: i32, ret_fn_ret: string, ret_fn_param_types: string, ret_own: boolean): ast.Expr {
  return ast.ExprLambda { params: params, ret_own: ret_own, ret_type: ret_type, body: body, use_infer: false, origin: origin, line: line, col: col, captures: [], captures_known: false, ret_fn_ret: ret_fn_ret, ret_fn_param_types: ret_fn_param_types, once: false };
}

function e_lambda_origin(params: ast.ParamDecl[], ret_type: string, body: ast.Stmt[], origin: string): ast.Expr {
  return e_lambda_at(params, ret_type, body, origin, 0, 0, "", "", false);
}

pub function e_unknown(kind: string): ast.Expr {
  return ast.ExprUnknown { fault: ast.fault_mark(kind), line: 0, col: 0 };
}

pub function path_sep_message(): string {
  return "`::` is not a path separator; write `.`";
}

pub function e_unknown_at(f: ast.Fault, line: i32, col: i32): ast.Expr {
  return ast.ExprUnknown { fault: f, line: line, col: col };
}

pub function s_var(name: string, type_name: string, init: ast.Expr): ast.Stmt {
  return ast.StmtVar { name: name, type_name: type_name, init: init, line: 0, col: 0, fn_ret: "", fn_param_types: "", destr: ast.no_destr(), header: false };
}

function s_var_at(name: string, type_name: string, init: ast.Expr, line: i32, col: i32): ast.Stmt {
  return ast.StmtVar { name: name, type_name: type_name, init: init, line: line, col: col, fn_ret: "", fn_param_types: "", destr: ast.no_destr(), header: false };
}

function s_destr_at(d: ast.Destr, init: ast.Expr, line: i32, col: i32): ast.Stmt {
  return ast.StmtVar { name: "", type_name: "", init: init, line: line, col: col, fn_ret: "", fn_param_types: "", destr: d, header: false };
}

// st, marked as a binding that the header of its block makes.
function as_header(st: ast.Stmt): ast.Stmt {
  if let ast.StmtVar(v) = st {
    return ast.StmtVar { ...v, header: true };
  }
  return st;
}

function record_pattern(record: string, binds: string[], fields: string[], at: string, rest_written: boolean): ast.Destr {
  return ast.Destr { ...ast.tuple_destr(binds), fields: fields, record: record, at: at, rest_written: rest_written };
}

function parse_destructure_names(p: Par): (ast.Destr, i32, boolean, Par) {
  if (p.too_deep()) {
    return (ast.no_destr(), 0, false, p.bail());
  }
  let (gd, g1, g2, gq) = parse_destructure_names_nested(p.with_depth(p.depth + 1));
  return (gd, g1, g2, gq.with_depth(p.depth));
}

function parse_destructure_names_nested(p: Par): (ast.Destr, i32, boolean, Par) {
  let open_line = p.peek_line();
  let open_col = p.peek_col();
  p = p.advance();
  let binds: ast.DestrBind[] = [];
  let count = 0;
  let first = true;
  while (p.peek_punct() != ")" && !p.at_end()) {
    let bind = ast.DestrBind { name: "", nested: [] };
    if (p.peek_punct() == "(") {
      let (inner_d, inner_n, inner_ok, inner_p) = parse_destructure_names(p);
      p = inner_p;
      if (!inner_ok || inner_n < 2) {
        return (ast.no_destr(), 0, false, p);
      }
      bind = ast.DestrBind { name: "", nested: [inner_d] };
    } else {
      let part = p.peek_ident();
      if (part.len() == 0) {
        return (ast.no_destr(), 0, false, p);
      }
      bind = ast.DestrBind { name: discard_name(part, open_line, open_col, count), nested: [] };
      p = p.advance();
    }
    binds = binds.append(bind);
    count += 1;
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
  }
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  return (ast.Destr { ...ast.no_destr(), binds: binds }, count, true, p);
}

// The kind of the first element of the tuple at `p` that can fail to match.
function refutable_tuple_element(p: Par): string {
  if (p.too_deep()) {
    return "";
  }
  p = p.with_depth(p.depth + 1).advance();
  while (p.peek_punct() != ")" && !p.at_end()) {
    if (p.peek_punct() == "(") {
      let inner = refutable_tuple_element(p);
      if (inner.len() > 0) {
        return inner;
      }
      p = p.advance().skip_to_close(")");
    } else if (p.peek_ident().len() == 0) {
      return "a literal tuple element";
    } else if (p.peek_punct_at(1) == "(" || p.peek_punct_at(1) == ".") {
      return "a variant tuple element";
    } else {
      p = p.advance();
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
  }
  return "";
}

function refutable_tuple_message(tuple_start: Par, site: string): string {
  let kind = refutable_tuple_element(tuple_start);
  if (kind.len() == 0) {
    kind = "a literal tuple element";
  }
  return refutable_binding_message(kind, site);
}

function parse_struct_pattern_fields(p: Par): (string[], string[], boolean, boolean, Par) {
  p = p.advance();
  let bindings: string[] = [];
  let fields: string[] = [];
  let rest_written = false;
  while (p.peek_punct() != "}" && !p.at_end()) {
    if (p.peek_punct() == "..") {
      p = p.advance();
      rest_written = true;
      break;
    }
    let fld = p.peek_ident();
    if (fld.len() == 0) {
      return ([], [], false, false, p);
    }
    p = p.advance();
    let bind = fld;
    if (p.peek_punct() == ":") {
      p = p.advance();
      let bn = p.peek_ident();
      if (bn.len() > 0) {
        bind = discard_name(bn, p.peek_line(), p.peek_col(), 0);
        p = p.advance();
      }
    }
    bindings = bindings.append(bind);
    fields = fields.append(fld);
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (bindings, fields, rest_written, true, p);
}

function parse_struct_destructure(p: Par, struct_name: string, at: string, line: i32, col: i32): (ast.Stmt, Par) {
  let (bindings, fields, fields_rest, fields_ok, fields_p) = parse_struct_pattern_fields(p);
  p = fields_p;
  if (!fields_ok) {
    return (s_unknown(p, parse_fault("a struct destructuring pattern binds field names")), p);
  }
  p = p.expect("=");
  let (init_expr, ip) = parse_expr(p);
  p = ip;
  p = p.end_of(init_expr);
  if (bindings.len() == 0) {
    return (s_unknown_at(parse_fault("struct destructure needs at least one field"), line, col), p);
  }
  return (s_destr_at(record_pattern(struct_name, bindings, fields, at, fields_rest), init_expr, line, col), p);
}

pub function s_return(value: ast.Expr): ast.Stmt {
  return ast.StmtReturn { value: value, line: 0, col: 0 };
}

function s_return_at(value: ast.Expr, line: i32, col: i32): ast.Stmt {
  return ast.StmtReturn { value: value, line: line, col: col };
}

pub function s_expr(value: ast.Expr): ast.Stmt {
  return ast.StmtExpr { value: value, line: 0, op: "" };
}

pub function s_if(cond: ast.Expr, then_body: ast.Stmt[], else_body: ast.Stmt[]): ast.Stmt {
  return s_if_chained(cond, then_body, else_body, false);
}

function s_if_origin(cond: ast.Expr, then_body: ast.Stmt[], else_body: ast.Stmt[], origin: string): ast.Stmt {
  return ast.StmtIf { cond: cond, then_body: then_body, else_body: else_body, line: 0, else_chained: false, sugar: no_match_sugar(), origin: origin };
}

pub const ORIGIN_ASSERT: string = "assert";

pub const ORIGIN_BLOCK: string = "block";

pub const ORIGIN_TODO: string = "todo";

pub const ORIGIN_MATCH_EXPR: string = "match_expr";

pub const ORIGIN_PATTERN_PROBE: string = "pattern_probe";

pub const ORIGIN_IF_EXPR: string = "if_expr";

pub const ORIGIN_IF_DEAD_THEN: string = "if_expr_dead_then";

pub const ORIGIN_IF_DEAD_ELSE: string = "if_expr_dead_else";

pub const ORIGIN_IF_DEAD_BOTH: string = "if_expr_dead_both";

pub const ORIGIN_ARR_COMP: string = "arr_comp";

pub const ORIGIN_MAP_COMP: string = "map_comp";

pub const ORIGIN_IIFE_SCOPED: string = "iife_scoped";

pub const DFA_TRYALL: string = "__dfa_tryall";

pub const DFA_TRYERR: string = "__dfa_tryerr";

pub const ORIGIN_USE: string = "use";

pub function no_match_sugar(): ast.MatchSugar {
  let no_tup: ast.TupArm[] = [];
  let no_struct: ast.StructArm[] = [];
  let no_lit: ast.LitArm[] = [];
  let no_arms: ast.MatchArm[] = [];
  return ast.MatchSugar { scrut: e_unknown(""), tup: no_tup, strct: no_struct, lits: no_lit, arms: no_arms, line: 0, col: 0, origin: "", else_chained: false, arms_open: 0 };
}

function s_if_match(body: ast.Stmt[], sugar: ast.MatchSugar): ast.Stmt {
  let no_else: ast.Stmt[] = [];
  return ast.StmtIf { cond: e_bool(true), then_body: body, else_body: no_else, line: sugar.line, else_chained: false, sugar: sugar, origin: "" };
}

function s_if_chained(cond: ast.Expr, then_body: ast.Stmt[], else_body: ast.Stmt[], chained: boolean): ast.Stmt {
  return ast.StmtIf { cond: cond, then_body: then_body, else_body: else_body, line: 0, else_chained: chained, sugar: no_match_sugar(), origin: "" };
}

function s_if_tagged(body: ast.Stmt[], origin: string): ast.Stmt {
  let no_else: ast.Stmt[] = [];
  return ast.StmtIf { cond: e_bool(true), then_body: body, else_body: no_else, line: 0, else_chained: false, sugar: no_match_sugar(), origin: origin };
}

pub function s_block(body: ast.Stmt[]): ast.Stmt {
  return s_if_tagged(body, "block");
}

pub function s_while(cond: ast.Expr, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtWhile { cond: cond, body: body, label: "", line: 0, is_loop: false };
}

function s_for(var_name: string, iter: ast.Expr, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtFor { var_name: var_name, iter: iter, body: body, label: "", line: 0, col: 0, destr: ast.no_destr() };
}

pub function with_loop_label(st: ast.Stmt, label: string): ast.Stmt {
  if (label.len() == 0) {
    return st;
  }
  match (st) {
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: w.cond, body: w.body, label: label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: fr.body, label: label, line: fr.line, col: fr.col, destr: fr.destr };
    },
    ast.StmtIf(f) => {
      let n = f.then_body.len();
      if (n == 0) {
        return st;
      }
      match (f.then_body[n - 1]) {
        ast.StmtWhile(w2) => {
          let relabelled: ast.Stmt[] = [];
          for i in 0..n - 1 {
            relabelled = relabelled.append(f.then_body[i]);
          }
          relabelled = relabelled.append(ast.StmtWhile { cond: w2.cond, body: w2.body, label: label, line: w2.line, is_loop: w2.is_loop });
          return ast.StmtIf { ...f, cond: f.cond, then_body: relabelled, else_body: f.else_body };
        },
        _ => {
          return st;
        }
      }
    },
    _ => {
      return st;
    }
  }
}

pub function s_break(): ast.Stmt {
  return ast.StmtBreak { tag: 0, line: 0, col: 0, label: "" };
}

pub function s_assign(target: string, value: ast.Expr): ast.Stmt {
  return ast.StmtAssign { target: target, value: value, line: 0, col: 0, target_line: 0, target_col: 0, op: "" };
}

pub function s_assign_at(target: string, value: ast.Expr, line: i32, col: i32, target_line: i32, target_col: i32): ast.Stmt {
  return ast.StmtAssign { target: target, value: value, line: line, col: col, target_line: target_line, target_col: target_col, op: "" };
}

pub function s_match(scrutinee: ast.Expr, arms: ast.MatchArm[]): ast.Stmt {
  let no_sugar: ast.MatchArm[] = [];
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: 0, col: 0, origin: "", sugar: no_sugar, else_chained: false, arms_open: 0 };
}

pub function s_match_at(scrutinee: ast.Expr, arms: ast.MatchArm[], line: i32, col: i32): ast.Stmt {
  let no_sugar: ast.MatchArm[] = [];
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: "", sugar: no_sugar, else_chained: false, arms_open: 0 };
}

function s_match_sugared(scrutinee: ast.Expr, arms: ast.MatchArm[], sugar: ast.MatchArm[], line: i32, col: i32): ast.Stmt {
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: "", sugar: sugar, else_chained: false, arms_open: 0 };
}

function array_builder_elem(t: string): string {
  let prefix = "ArrayBuilder[";
  let pl = prefix.len();
  if (t.len() < pl + 1) {
    return "";
  }
  if (t[t.len() - 1] != b']') {
    return "";
  }
  for i in 0..pl {
    if (t[i] != prefix[i]) {
      return "";
    }
  }
  return slice_unchecked(t, pl, t.len() - 1).to_owned();
}

function is_builder_mutation(c: ast.ExprCall, b: string): boolean {
  match (c.callee) {
    ast.ExprFieldAccess(fa) => {
      if (fa.field != "append" && fa.field != "with" && fa.field != "insert") {
        return false;
      }
      match (fa.obj) {
        ast.ExprIdent(id) => {
          return id.name == b;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

function rewrite_builder_stmt(s: ast.Stmt, b: string): ast.Stmt {
  match (s) {
    ast.StmtExpr(es) => {
      match (es.value) {
        ast.ExprCall(c) => {
          if (is_builder_mutation(c, b)) {
            return s_assign(b, es.value);
          }
          return s;
        },
        _ => {
          return s;
        }
      }
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: f.cond, then_body: rewrite_builder_stmts(f.then_body, b), else_body: rewrite_builder_stmts(f.else_body, b) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: w.cond, body: rewrite_builder_stmts(w.body, b), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: rewrite_builder_stmts(fr.body, b), label: fr.label, line: fr.line, col: fr.col, destr: fr.destr };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      for ai in 0..m.arms.len() {
        let arm = m.arms[ai];
        arms = arms.append(ast.MatchArm { ...arm, body: rewrite_builder_stmts(arm.body, b) });
      }
      return ast.StmtMatch { ...m, scrutinee: m.scrutinee, arms: arms };
    },
    _ => {
      return s;
    }
  }
}

function rewrite_builder_stmts(stmts: ast.Stmt[], b: string): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for i in 0..stmts.len() {
    out = out.append(rewrite_builder_stmt(stmts[i], b));
  }
  return out;
}

function maybe_desugar_array_build(base: ast.Expr): ast.Expr {
  match (base) {
    ast.ExprCall(call) => {
      match (call.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "build") {
            return base;
          }
          match (fa.obj) {
            ast.ExprIdent(id) => {
              if (id.name != "Array") {
                return base;
              }
              if (call.args.len() != 1) {
                return base;
              }
              match (call.args[0]) {
                ast.ExprLambda(lam) => {
                  if (lam.params.len() != 1) {
                    return base;
                  }
                  let elem = array_builder_elem(lam.params[0].type_name);
                  if (elem.len() == 0) {
                    return base;
                  }
                  let bname = lam.params[0].name;
                  let arrty = elem + "[]";
                  let stmts: ast.Stmt[] = [];
                  stmts = stmts.append(s_var(bname, arrty, e_array([])));
                  let rewritten = rewrite_builder_stmts(lam.body, bname);
                  for ri in 0..rewritten.len() {
                    stmts = stmts.append(rewritten[ri]);
                  }
                  stmts = stmts.append(s_return(e_ident(bname)));
                  let iife: ast.Expr = ast.ExprLambda { params: [], ret_own: false, ret_type: arrty, body: stmts, use_infer: false, origin: ORIGIN_ARR_COMP, line: 0, col: 0, captures: [], captures_known: false, ret_fn_ret: "", ret_fn_param_types: "", once: false };
                  return ast.ExprCall { callee: iife, args: [], line: call.line, col: call.col, type_args: [], ty: "" };
                },
                _ => {
                  return base;
                }
              }
            },
            _ => {
              return base;
            }
          }
        },
        _ => {
          return base;
        }
      }
    },
    _ => {
      return base;
    }
  }
}

function map_builder_inner(t: string): string {
  let prefix = "MapBuilder[";
  let pl = prefix.len();
  if (t.len() < pl + 1) {
    return "";
  }
  if (t[t.len() - 1] != b']') {
    return "";
  }
  for i in 0..pl {
    if (t[i] != prefix[i]) {
      return "";
    }
  }
  return slice_unchecked(t, pl, t.len() - 1).to_owned();
}

function maybe_desugar_map_build(base: ast.Expr): ast.Expr {
  match (base) {
    ast.ExprCall(call) => {
      match (call.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "build") {
            return base;
          }
          match (fa.obj) {
            ast.ExprIdent(id) => {
              if (id.name != "Map") {
                return base;
              }
              if (call.args.len() != 1) {
                return base;
              }
              match (call.args[0]) {
                ast.ExprLambda(lam) => {
                  if (lam.params.len() != 1) {
                    return base;
                  }
                  let inner = map_builder_inner(lam.params[0].type_name);
                  if (inner.len() == 0) {
                    return base;
                  }
                  let bname = lam.params[0].name;
                  let mapty = "Map[" + inner + "]";
                  let cargs: ast.Expr[] = [];
                  cargs = cargs.append(e_number("8", "", false));
                  let stmts: ast.Stmt[] = [];
                  stmts = stmts.append(s_var(bname, mapty, e_call(e_ident("map_new"), cargs)));
                  let rewritten = rewrite_builder_stmts(lam.body, bname);
                  for ri in 0..rewritten.len() {
                    stmts = stmts.append(rewritten[ri]);
                  }
                  stmts = stmts.append(s_return(e_ident(bname)));
                  let iife: ast.Expr = ast.ExprLambda { params: [], ret_own: false, ret_type: mapty, body: stmts, use_infer: false, origin: ORIGIN_MAP_COMP, line: 0, col: 0, captures: [], captures_known: false, ret_fn_ret: "", ret_fn_param_types: "", once: false };
                  return ast.ExprCall { callee: iife, args: [], line: call.line, col: call.col, type_args: [], ty: "" };
                },
                _ => {
                  return base;
                }
              }
            },
            _ => {
              return base;
            }
          }
        },
        _ => {
          return base;
        }
      }
    },
    _ => {
      return base;
    }
  }
}

function s_match_origin(scrutinee: ast.Expr, arms: ast.MatchArm[], line: i32, col: i32, origin: string): ast.Stmt {
  let no_sugar: ast.MatchArm[] = [];
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: origin, sugar: no_sugar, else_chained: false, arms_open: 0 };
}

function s_match_origin_sugared(scrutinee: ast.Expr, arms: ast.MatchArm[], sugar: ast.MatchArm[], line: i32, col: i32, origin: string): ast.Stmt {
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: origin, sugar: sugar, else_chained: false, arms_open: 0 };
}

function p_variant(type_name: string, binding: string): ast.Pattern {
  let no_extra: string[] = [];
  let no_nested: ast.Pattern[] = [];
  let no_tup_kinds: i32[] = [];
  let no_tup_binds: string[] = [];
  let no_tup_lits: ast.Expr[] = [];
  let no_tup_pats: ast.Pattern[] = [];
  return ast.PatVariant { scalar_cells: [], scalar_binding: false, bare_name: false, type_name: type_name, binding: binding, extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats, rest_written: false };
}

function p_variant_n(type_name: string, prefix: string, n: i32): ast.Pattern {
  if (n <= 0) {
    return p_variant(type_name, "");
  }
  let extra: string[] = [];
  for i in 1..n {
    extra = extra.append(prefix + dl_itoa(i));
  }
  let no_nested: ast.Pattern[] = [];
  let no_tup_kinds: i32[] = [];
  let no_tup_binds: string[] = [];
  let no_tup_lits: ast.Expr[] = [];
  let no_tup_pats: ast.Pattern[] = [];
  return ast.PatVariant { scalar_cells: [], scalar_binding: false, bare_name: false, type_name: type_name, binding: prefix + "0", extra_bindings: extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats, rest_written: false };
}

function fold_lit_cond(pat: ast.Pattern, guard: ast.Expr, has_guard: boolean): (ast.Pattern, ast.Expr, boolean) {
  match (pat) {
    ast.PatVariant(pv) => {
      if (!pv.has_lit_cond) {
        return (pat, guard, has_guard);
      }
      let no_tup_kinds: i32[] = [];
      let no_tup_binds: string[] = [];
      let no_tup_lits: ast.Expr[] = [];
      let no_tup_pats: ast.Pattern[] = [];
      let cleared: ast.Pattern = ast.PatVariant { ...pv, lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
      if (!has_guard) {
        return (cleared, pv.lit_cond, true);
      }
      return (cleared, e_binary("&&", pv.lit_cond, guard), true);
    },
    _ => {
      return (pat, guard, has_guard);
    }
  }
}

function p_wildcard(): ast.Pattern {
  return ast.PatWildcard { tag: 0 };
}

function decl_sentinel(p: Par, text: string): ast.Stmt {
  return s_unknown(p, decl_fault(text));
}

function sync_to_top_level(p: Par): Par {
  let q = p;
  while (!q.at_end() && !at_top_level_decl(q)) {
    q = q.advance();
  }
  return q;
}

function at_top_level_decl(p: Par): boolean {
  return function_head(p) || util.has_str(["struct", "enum", "import", "const", "trait", "impl", "pub"], p.peek_keyword());
}

function unsafe_function_head(p: Par): boolean {
  return p.peek_ident() == "unsafe" && p.advance().peek_keyword() == "function";
}

function function_head(p: Par): boolean {
  return p.peek_keyword() == "function" || unsafe_function_head(p);
}

function skip_body_item(p: Par): Par {
  let q = p;
  let depth = 0;
  while (!q.at_end()) {
    let pc = q.peek_punct();
    if (depth == 0 && pc == "}") {
      return q;
    }
    if (depth == 0 && pc == ";") {
      return q.advance();
    }
    if (pc == "{") {
      depth += 1;
    }
    if (pc == "}") {
      depth -= 1;
      if (depth == 0) {
        return q.advance();
      }
    }
    q = q.advance();
  }
  return q;
}

pub function malformed_fn_decl_message(): string {
  return "malformed function declaration: its name or signature could not be read (a keyword such as `use`, `type` or `match` cannot be a name)";
}

function s_unknown(p: Par, f: ast.Fault): ast.Stmt {
  return s_unknown_at(f, p.peek_line(), p.peek_col());
}

function s_unknown_at(f: ast.Fault, line: i32, col: i32): ast.Stmt {
  return ast.StmtUnknown { fault: f, line: line, col: col };
}

// The P001 error of a node the parser could not read.
pub function parse_fault(message: string): ast.Fault {
  return coded_fault("P001", message);
}

function coded_fault(code: string, message: string): ast.Fault {
  return ast.Fault { mark: "", code: code, message: message, scoped: true };
}

// A declaration error. A trait body keeps these apart from its methods.
pub const DECL_FAULT: string = "decl";

function decl_fault(message: string): ast.Fault {
  return ast.Fault { mark: DECL_FAULT, code: "P001", message: message, scoped: true };
}

// A punctuation token where an expression must be.
pub const PUNCT_FAULT: string = "punct";

function punct_fault(text: string): ast.Fault {
  return ast.Fault { mark: PUNCT_FAULT, code: "P001", message: "expected an expression, got \"" + text + "\"", scoped: true };
}

function lex_fault(e: lexer.TokError): ast.Fault {
  return ast.Fault { mark: "", code: e.code, message: e.msg, scoped: false };
}

function nest_fault(): ast.Fault {
  return coded_fault("P005", "input nests deeper than " + util.i32_to_string(MAX_NEST_DEPTH) + " levels");
}

function float_range_fault(text: string): ast.Fault {
  return coded_fault("P002", "invalid float literal \"" + text + "\": value out of range");
}

function missing_fault(what: string): ast.Fault {
  return parse_fault(match (what) {
    "= in let" => "expected \"=\" after the name in this declaration",
    "`in` in for" => "expected \"in\" after the `for` pattern",
    "for-let name" => "expected a name after \"let\" in this `for` loop",
    "binding name" => "expected a name to bind",
    "statement in braceless body" => "expected a statement",
    "{ in block" => "expected \"{\" to open a block",
    "{ in lambda body" => "expected \"{\" to open the lambda body",
    "{ in branch body" => "expected \"{\" to open the branch body",
    "field name in struct lit" => "expected a field name in this struct literal",
    ": in struct lit" => "expected \":\" after the field name in this struct literal",
    "} in struct lit" => "expected \"}\" to close this struct literal",
    "} in struct update" => "expected \"}\" to close this struct update",
    ") in call" => "expected \")\" to close this call",
    "] in slice" => "expected \"]\" to close this slice",
    "] in index" => "expected \"]\" to close this index",
    "] in array literal" => "expected \"]\" to close this array literal",
    "field name after ." => "expected a field or method name after \".\"",
    _ => "expected " + what,
  });
}

function tok_spelling(t: lexer.Token): string {
  match (t) {
    lexer.TokPunct(x) => {
      return x.text;
    },
    lexer.TokIdent(x) => {
      return x.name;
    },
    lexer.TokKeyword(x) => {
      return x.name;
    },
    lexer.TokNumber(x) => {
      return x.text;
    },
    lexer.TokString(x) => {
      return x.value;
    },
    _ => {
      return "";
    }
  }
}

function tok_desc(t: lexer.Token): string {
  if let lexer.TokEof(_) = t {
    return "the end of the file";
  }
  return "\"" + tok_spelling(t) + "\"";
}

function defer_action(st: ast.Stmt, p: Par): ast.Stmt {
  if let ast.StmtExpr(_) = st {
    return st;
  }
  if let ast.StmtAssign(_) = st {
    return st;
  }
  if let ast.StmtUnknown(_) = st {
    return st;
  }
  if let ast.StmtIf(f) = st {
    if (f.origin == "block" || f.origin == "unsafe" || f.origin == ORIGIN_ASSERT) {
      return st;
    }
  }
  return decl_sentinel(p, "expected an expression, got " + tok_desc(p.peek()));
}

pub function s_defer(action: ast.Stmt): ast.Stmt {
  return ast.StmtDefer { action: action, on_error: 0, line: 0 };
}

function s_errdefer(action: ast.Stmt): ast.Stmt {
  return ast.StmtDefer { action: action, on_error: 1, line: 0 };
}

function label_depth(labels: string[], name: string): i32 {
  let i = labels.len() - 1;
  while (i >= 0) {
    if (labels[i] == name) {
      return labels.len() - 1 - i;
    }
    i -= 1;
  }
  return -1;
}

function resolve_labels_stmt(st: ast.Stmt, labels: string[]): ast.Stmt {
  match (st) {
    ast.StmtBreak(b) => {
      if (b.label.len() == 0) {
        return st;
      }
      let d = label_depth(labels, b.label);
      if (d < 0) {
        d = 0;
      }
      return ast.StmtBreak { tag: d, line: b.line, col: b.col, label: b.label };
    },
    ast.StmtContinue(c) => {
      if (c.label.len() == 0) {
        return st;
      }
      let d2 = label_depth(labels, c.label);
      if (d2 < 0) {
        d2 = 0;
      }
      return ast.StmtContinue { tag: d2, line: c.line, col: c.col, label: c.label };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: rl_expr(w.cond, labels), body: resolve_labels_block(w.body, labels.append(w.label)), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: rl_expr(fr.iter, labels), body: resolve_labels_block(fr.body, labels.append(fr.label)), label: fr.label, line: fr.line, col: fr.col, destr: fr.destr };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: rl_expr(f.cond, labels), then_body: resolve_labels_block(f.then_body, labels), else_body: resolve_labels_block(f.else_body, labels) };
    },
    ast.StmtMatch(m) => {
      let arms2: ast.MatchArm[] = [];
      for ai in 0..m.arms.len() {
        let a = m.arms[ai];
        let ag = a.guard;
        if (a.has_guard) {
          ag = rl_expr(a.guard, labels);
        }
        arms2 = arms2.append(ast.MatchArm { ...a, body: resolve_labels_block(a.body, labels), guard: ag });
      }
      return ast.StmtMatch { ...m, scrutinee: rl_expr(m.scrutinee, labels), arms: arms2 };
    },
    ast.StmtDefer(dd) => {
      return ast.StmtDefer { action: resolve_labels_stmt(dd.action, labels), on_error: dd.on_error, line: dd.line };
    },
    ast.StmtVar(v) => {
      return ast.StmtVar { ...v, init: rl_expr(v.init, labels) };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: rl_expr(r.value, labels) };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: rl_expr(x.value, labels) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: rl_expr(a.value, labels) };
    },
    _ => {
      return st;
    }
  }
}

function rl_expr(e: ast.Expr, labels: string[]): ast.Expr {
  match (e) {
    ast.ExprLambda(lm) => {
      let fresh: string[] = [];
      return ast.ExprLambda { ...lm, body: resolve_labels_block(lm.body, fresh) };
    },
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        return dl_vb_rebuild(c, resolve_labels_block(vb_body(c), labels));
      }
      return rl_expr_kids(e, labels);
    },
    _ => {
      return rl_expr_kids(e, labels);
    }
  }
}

function rl_expr_kids(e: ast.Expr, labels: string[]): ast.Expr {
  return map_expr_kids(e, (k: ast.Expr): ast.Expr => rl_expr(k, labels));
}

pub function resolve_labels_block(stmts: ast.Stmt[], labels: string[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for i in 0..stmts.len() {
    out = out.append(resolve_labels_stmt(stmts[i], labels));
  }
  return out;
}

pub function resolve_labels_module(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  let none: string[] = [];
  for i in 0..mod.funcs.len() {
    let fd = mod.funcs[i];
    if (has_labeled_jump(fd.body)) {
      fd = FuncDecl { ...fd, body: resolve_labels_block(fd.body, none) };
    }
    funcs = funcs.append(fd);
  }
  return Module { ...mod, funcs: funcs, top_stmts: resolve_labels_block(mod.top_stmts, none) };
}

pub function has_labeled_jump(stmts: ast.Stmt[]): boolean {
  let found = false;
  for st in stmts {
    found = astwalk.fold_stmt_nodes(st, found, labeled_jump_at, astwalk.keep_flag, astwalk.descend_all);
  }
  return found;
}

function labeled_jump_at(st: ast.Stmt, own acc: boolean): boolean {
  if let ast.StmtBreak(b) = st {
    return acc || b.label.len() > 0;
  }
  if let ast.StmtContinue(c) = st {
    return acc || c.label.len() > 0;
  }
  return acc;
}

// `closers` has, for each open bracket of `toks`, the index of the token
// that closes it, or -1.
struct Par { toks: lexer.Token[], pos: i32, no_struct: boolean, map_kind: i32, structnames: string[], constnames: string[], verbatim: boolean, depth: i32, type_errs: ast.Stmt[], todos: TodoSite[], tail_at: i32[], tail_is: boolean[], strict_semi: boolean, closers: i32[] }

function scan_struct_names(toks: lexer.Token[]): string[] {
  let out: string[] = [];
  let i = 0;
  while (i < toks.len()) {
    match (toks[i]) {
      lexer.TokEof(_) => {
        return out;
      },
      lexer.TokKeyword(k) => {
        if (k.name == "struct" && i + 1 < toks.len()) {
          if let lexer.TokIdent(id) = toks[i + 1] {
            if (id.name.len() > 0) {
              out = out.append(id.name);
              i += 1;
            }
          }
        }
      },
      _ => {}
    }
    i += 1;
  }
  return out;
}

// The change of nesting depth at a bracket. A `const` inside brackets is a
// const type parameter, not a top-level const.
function scan_nesting(text: string): i32 {
  if (text == "{" || text == "(" || text == "[") {
    return 1;
  }
  if (text == "}" || text == ")" || text == "]") {
    return -1;
  }
  return 0;
}

// The names of the consts declared at the top level of the module.
function scan_const_names(toks: lexer.Token[]): string[] {
  let out: string[] = [];
  let depth = 0;
  for i in 0..toks.len() {
    if let lexer.TokPunct(x) = toks[i] {
      depth += scan_nesting(x.text);
    } else if let lexer.TokKeyword(k) = toks[i] {
      if (depth == 0 && k.name == "const" && i + 1 < toks.len()) {
        if let lexer.TokIdent(id) = toks[i + 1] {
          out = out.append(id.name);
        }
      }
    }
  }
  return out;
}

function (p: Par) at_end(): boolean {
  if (p.pos >= p.toks.len()) {
    return true;
  }
  let t = p.toks[p.pos];
  match (t) {
    lexer.TokEof(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function (p: Par) peek(): lexer.Token {
  if (p.pos < p.toks.len()) {
    return p.toks[p.pos];
  }
  return lexer.eof_tok(0, 0);
}

function (p: Par) peek_line(): i32 {
  let t = p.peek();
  match (t) {
    lexer.TokEof(x) => {
      return x.line;
    },
    lexer.TokNumber(x) => {
      return x.line;
    },
    lexer.TokIdent(x) => {
      return x.line;
    },
    lexer.TokKeyword(x) => {
      return x.line;
    },
    lexer.TokPunct(x) => {
      return x.line;
    },
    lexer.TokString(x) => {
      return x.line;
    },
    lexer.TokError(x) => {
      return x.line;
    },
    lexer.TokFString(x) => {
      return x.line;
    }
  }
}

function (p: Par) peek_col(): i32 {
  let t = p.peek();
  match (t) {
    lexer.TokEof(x) => {
      return x.col;
    },
    lexer.TokNumber(x) => {
      return x.col;
    },
    lexer.TokIdent(x) => {
      return x.col;
    },
    lexer.TokKeyword(x) => {
      return x.col;
    },
    lexer.TokPunct(x) => {
      return x.col;
    },
    lexer.TokString(x) => {
      return x.col;
    },
    lexer.TokError(x) => {
      return x.col;
    },
    lexer.TokFString(x) => {
      return x.col;
    }
  }
}

function (p: Par) advance(): Par {
  return Par { toks: p.toks, pos: p.pos + 1, no_struct: p.no_struct, map_kind: p.map_kind, structnames: p.structnames, constnames: p.constnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos, tail_at: p.tail_at, tail_is: p.tail_is, strict_semi: p.strict_semi, closers: p.closers };
}

function (p: Par) expected_type(): Par {
  return Par { ...p, type_errs: p.type_errs.append(s_unknown(p, decl_fault("expected a type, got " + tok_desc(p.peek())))) };
}

function (p: Par) refused_type(msg: string): Par {
  return Par { ...p, type_errs: p.type_errs.append(s_unknown(p, decl_fault(msg))) };
}

function (p: Par) refused_at(f: ast.Fault, line: i32, col: i32): Par {
  return Par { ...p, type_errs: p.type_errs.append(s_unknown_at(f, line, col)) };
}

function at_wildcard_fault(): ast.Fault {
  return coded_fault("P001", "`@` bindings are not supported on a `_` pattern");
}

function unit_type_message(): string {
  return "`()` is not a type; the unit type is written `void`";
}

function at_float_type(p: Par, seg: string): boolean {
  if (seg != "float" || p.peek_punct_at(1) == ".") {
    return false;
  }
  if (p.pos == 0) {
    return true;
  }
  let prev = tok_spelling(p.toks[p.pos - 1]);
  if (prev == "|" || prev == "=" && p.peek_punct_at(1) == "|") {
    return false;
  }
  return !util.has_str([".", "dyn", "+", "own", "borrow", "impl"], prev);
}

function float_type_message(): string {
  return "`float` is not a type; the 64-bit float is written `f64`";
}

function (p: Par) handle_word_misuse(word: string): Par {
  return Par { ...p, type_errs: p.type_errs.append(s_unknown(p, decl_fault(handle_word_misuse_message(word)))) };
}

function handle_word_misuse_message(word: string): string {
  if (word == "own") {
    return "`own` in a type must be followed by a resource name (`own R` for a `resource R`); a consuming parameter is written `own name: T`";
  }
  return "`borrow` in a type must be followed by a resource name (`borrow R` for a `resource R`); a parameter borrows by default, written `name: T`";
}

function (p: Par) expect_semi(): Par {
  if (p.peek_punct() == ";") {
    return p.advance();
  }
  if (p.pos > 0 && tok_spelling(p.toks[p.pos - 1]) == ";" || p.peek_punct() == ")" || p.peek_punct() == "]") {
    return p;
  }
  return Par { ...p, type_errs: p.type_errs.append(s_unknown(p, decl_fault("expected \";\", got " + tok_desc(p.peek())))) };
}

function (p: Par) expect(t: string): Par {
  if (p.peek_punct() == t || p.peek_keyword() == t) {
    return p.advance();
  }
  if (p.at_end()) {
    return p;
  }
  return Par { ...p, type_errs: p.type_errs.append(s_unknown(p, decl_fault("expected \"" + t + "\", got " + tok_desc(p.peek())))) };
}

function (p: Par) reported_at(line: i32, col: i32): boolean {
  if (p.type_errs.len() == 0) {
    return false;
  }
  if let ast.StmtUnknown(u) = p.type_errs[p.type_errs.len() - 1] {
    return u.line == line && u.col == col;
  }
  return false;
}

function missing_close(f: ast.Fault, closer: string, parts: ast.Expr[], p: Par): (ast.Expr, Par) {
  let at = e_unknown_at(f, p.peek_line(), p.peek_col());
  for e in parts {
    if (holds_sentinel(e)) {
      at = e;
      break;
    }
  }
  return (at, p.skip_to_close(closer));
}

function (p: Par) paren_then_in(): boolean {
  let depth = 0;
  while (!p.at_end()) {
    let pc = p.peek_punct();
    if (pc == "(" || pc == "[" || pc == "{") {
      depth += 1;
    } else if (pc == ")" || pc == "]" || pc == "}") {
      depth -= 1;
      if (depth == 0) {
        return p.advance().peek_ident() == "in";
      }
    }
    p = p.advance();
  }
  return false;
}

function (p: Par) skip_to_open(): Par {
  let q = p;
  let depth = 0;
  while (!q.at_end()) {
    let pc = q.peek_punct();
    if (depth == 0 && pc == "{") {
      return q;
    }
    if (depth == 0 && (pc == ";" || pc == "}" || pc == ")" || pc == "]")) {
      return p;
    }
    if (pc == "(" || pc == "[") {
      depth += 1;
    } else if (pc == ")" || pc == "]") {
      depth -= 1;
    }
    q = q.advance();
  }
  return p;
}

function (p: Par) skip_to_close(closer: string): Par {
  let depth = 0;
  while (!p.at_end()) {
    let pc = p.peek_punct();
    if (depth == 0 && pc == closer) {
      return p.advance();
    }
    if (depth == 0 && pc == ";") {
      break;
    }
    if (pc == "(" || pc == "[" || pc == "{") {
      depth += 1;
    } else if (pc == ")" || pc == "]" || pc == "}") {
      if (depth == 0) {
        break;
      }
      depth -= 1;
    }
    p = p.advance();
  }
  return p;
}

function (p: Par) end_of(e: ast.Expr): Par {
  if let ast.ExprUnknown(_) = e {
    if (p.peek_punct() == ";") {
      return p.advance();
    }
    return p;
  }
  return p.expect_semi();
}

function (p: Par) with_no_struct(v: boolean): Par {
  return Par { toks: p.toks, pos: p.pos, no_struct: v, map_kind: p.map_kind, structnames: p.structnames, constnames: p.constnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos, tail_at: p.tail_at, tail_is: p.tail_is, strict_semi: p.strict_semi, closers: p.closers };
}

function (p: Par) with_map_kind(v: i32): Par {
  return Par { toks: p.toks, pos: p.pos, no_struct: p.no_struct, map_kind: v, structnames: p.structnames, constnames: p.constnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos, tail_at: p.tail_at, tail_is: p.tail_is, strict_semi: p.strict_semi, closers: p.closers };
}

pub const MAX_NEST_DEPTH: i32 = 5000;

pub const BLOCK_VALUE_REQUIRED_MESSAGE: string = "block-expression has no trailing value (its last element is a `;`-terminated statement); a value is required here — drop the trailing `;` to make the final expression the block's value";

// The kind of the statement that ends a value branch with no trailing
// expression, when its statements do not end in a jump. The checker decides
// if the statements before it end the path.
pub const MISSING_TAIL: string = "value branch has no trailing expression";

pub function is_missing_tail(st: ast.Stmt): boolean {
  if let ast.StmtUnknown(u) = st {
    return u.fault.mark == MISSING_TAIL;
  }
  return false;
}

const BLOCK_NEST_UNITS: i32 = 8;

function (p: Par) with_depth(v: i32): Par {
  return Par { toks: p.toks, pos: p.pos, no_struct: p.no_struct, map_kind: p.map_kind, structnames: p.structnames, constnames: p.constnames, verbatim: p.verbatim, depth: v, type_errs: p.type_errs, todos: p.todos, tail_at: p.tail_at, tail_is: p.tail_is, strict_semi: p.strict_semi, closers: p.closers };
}

function (p: Par) too_deep(): boolean {
  return p.too_deep_by(1);
}

function (p: Par) too_deep_by(units: i32): boolean {
  return p.depth + units > MAX_NEST_DEPTH;
}

function (p: Par) bail(): Par {
  let last = p.toks.len() - 1;
  if (last < p.pos) {
    last = p.pos;
  }
  return Par { toks: p.toks, pos: last, no_struct: p.no_struct, map_kind: p.map_kind, structnames: p.structnames, constnames: p.constnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos, tail_at: p.tail_at, tail_is: p.tail_is, strict_semi: p.strict_semi, closers: p.closers };
}

function (p: Par) peek_punct(): string {
  let t = p.peek();
  match (t) {
    lexer.TokPunct(x) => {
      return x.text;
    },
    _ => {
      return "";
    }
  }
}

function consume_pub_package(p: Par): (boolean, Par) {
  if (p.peek_punct() != "(") {
    return (false, p);
  }
  let q = p.advance();
  if (q.peek_ident() != "package") {
    return (false, p);
  }
  q = q.advance();
  if (q.peek_punct() != ")") {
    return (false, p);
  }
  return (true, q.advance());
}

function (p: Par) peek_keyword(): string {
  let t = p.peek();
  match (t) {
    lexer.TokKeyword(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
}

function (p: Par) more_elems(close: string): (boolean, Par) {
  if (p.peek_punct() != ",") {
    return (false, p);
  }
  let q = p.advance();
  return (q.peek_punct() != close, q);
}

function (p: Par) peek2_punct(): string {
  if (p.pos + 1 < p.toks.len()) {
    let t = p.toks[p.pos + 1];
    match (t) {
      lexer.TokPunct(x) => {
        return x.text;
      },
      _ => {
        return "";
      }
    }
  }
  return "";
}

function (p: Par) peek_ident(): string {
  let t = p.peek();
  match (t) {
    lexer.TokIdent(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
}

function (p: Par) peek_punct_at(k: i32): string {
  if (p.pos + k < p.toks.len()) {
    let t = p.toks[p.pos + k];
    match (t) {
      lexer.TokPunct(x) => {
        return x.text;
      },
      _ => {
        return "";
      }
    }
  }
  return "";
}

function (p: Par) peek_ident_at(k: i32): string {
  if (p.pos + k < p.toks.len()) {
    let t = p.toks[p.pos + k];
    match (t) {
      lexer.TokIdent(x) => {
        return x.name;
      },
      _ => {
        return "";
      }
    }
  }
  return "";
}

function (p: Par) peek_number_text(): string {
  let t = p.peek();
  match (t) {
    lexer.TokNumber(x) => {
      return x.text;
    },
    _ => {
      return "";
    }
  }
}

function (p: Par) peek_const_arg(): string {
  if let lexer.TokNumber(x) = p.peek() {
    if (x.is_float() || x.suffix().len() > 0) {
      return "";
    }
    if (p.verbatim && x.raw.len() > 0) {
      return x.raw;
    }
    if (p.verbatim) {
      return x.text;
    }
    return const_arg_text(x.text);
  }
  return "";
}

function (p: Par) peek_is_literal(): boolean {
  let t = p.peek();
  match (t) {
    lexer.TokNumber(x) => {
      return true;
    },
    lexer.TokString(x) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

// A const name in a pattern is a literal of the value of the const.
function (p: Par) peek_is_const_name(): boolean {
  let name = p.peek_ident();
  if (name.len() == 0 || !util.has_str(p.constnames, name)) {
    return false;
  }
  let next = p.peek2_punct();
  return next != "(" && next != "." && next != "{" && next != "@";
}

// The name at p when it can bind: an identifier that is not a const pattern.
function (p: Par) peek_binder(): string {
  if (p.peek_is_const_name()) {
    return "";
  }
  return p.peek_ident();
}

// A literal at the head of a let. A const name before `:` or `=` is the
// name of a new binding that hides the const.
function (p: Par) peek_let_literal(): boolean {
  if (p.peek_is_const_name() && (p.peek2_punct() == ":" || p.peek2_punct() == "=")) {
    return false;
  }
  return p.peek_is_pat_literal();
}

function (p: Par) peek_at_literal(): boolean {
  if (p.peek_ident().len() == 0 || p.peek2_punct() != "@") {
    return false;
  }
  return p.advance().advance().peek_is_pat_literal();
}

function take_at_binding(p: Par): (string, Par) {
  if (!p.peek_at_literal()) {
    return ("", p);
  }
  let name = p.peek_ident();
  return (name, p.advance().advance());
}

function (p: Par) peek_is_pat_literal(): boolean {
  if (p.peek_is_literal() || p.peek_is_const_name()) {
    return true;
  }
  if (p.peek_keyword() == "true" || p.peek_keyword() == "false") {
    return true;
  }
  if (p.peek_punct() != "-") {
    return false;
  }
  if (p.pos + 1 < p.toks.len()) {
    let t = p.toks[p.pos + 1];
    match (t) {
      lexer.TokNumber(x) => {
        return true;
      },
      _ => {
        return false;
      }
    }
  }
  return false;
}

function (p: Par) punct_at(idx: i32): string {
  if (idx < 0 || idx >= p.toks.len()) {
    return "";
  }
  let t = p.toks[idx];
  match (t) {
    lexer.TokPunct(x) => {
      return x.text;
    },
    _ => {
      return "";
    }
  }
}

function (p: Par) ident_at(idx: i32): string {
  if (idx < 0 || idx >= p.toks.len()) {
    return "";
  }
  let t = p.toks[idx];
  match (t) {
    lexer.TokIdent(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
}

function (p: Par) keyword_at(idx: i32): string {
  if (idx < 0 || idx >= p.toks.len()) {
    return "";
  }
  let t = p.toks[idx];
  match (t) {
    lexer.TokKeyword(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
}

function (p: Par) if_stmt_has_else(): boolean {
  let i = p.pos + 1;
  if (p.keyword_at(i) == "let") {
    i += 1;
    let depth = 0;
    let source = false;
    while (i < p.toks.len()) {
      let pt = p.punct_at(i);
      if (source && depth == 0 && pt == "{") {
        break;
      }
      if (!source && depth == 0 && pt == "=") {
        source = true;
      } else if (pt == "(" || pt == "[" || pt == "{") {
        depth += 1;
      } else if (pt == ")" || pt == "]" || pt == "}") {
        depth -= 1;
      }
      i += 1;
    }
  }
  if (p.punct_at(i) == "(") {
    let depth = 0;
    while (i < p.toks.len()) {
      let pt = p.punct_at(i);
      if (pt == "(") {
        depth += 1;
      } else if (pt == ")") {
        depth -= 1;
        if (depth == 0) {
          i += 1;
          break;
        }
      }
      i += 1;
    }
  }
  if (p.punct_at(i) == "{") {
    let bdepth = 0;
    while (i < p.toks.len()) {
      let bt = p.punct_at(i);
      if (bt == "{") {
        bdepth += 1;
      } else if (bt == "}") {
        bdepth -= 1;
        if (bdepth == 0) {
          i += 1;
          break;
        }
      }
      i += 1;
    }
  }
  return p.keyword_at(i) == "else";
}

// The bracket `open` at `idx` has a close, and the token after that close
// is `want_a` or `want_b`.
function (p: Par) closer_followed_by(idx: i32, open: string, close: string, want_a: string, want_b: string): boolean {
  if (p.punct_at(idx) != open || p.closers[idx] < 0) {
    return false;
  }
  let aft = p.punct_at(p.closers[idx] + 1);
  if (aft.len() == 0) {
    return false;
  }
  return aft == want_a || want_b.len() > 0 && aft == want_b;
}

// The index of the close of each open bracket of `toks`, or -1. Each kind
// of bracket has its own stack, so a bracket of another kind does not end
// a nest.
function closers(toks: lexer.Token[]): i32[] {
  let out: i32[] = [];
  for _ in 0..toks.len() {
    out = out.append(-1);
  }
  out = matched(toks, out, "(", ")");
  out = matched(toks, out, "[", "]");
  return matched(toks, out, "{", "}");
}

// `out` with the close of each bracket `open` of `toks`.
function matched(toks: lexer.Token[], own out: i32[], open: string, close: string): i32[] {
  let stack: i32[] = [];
  for i in 0..toks.len() {
    let text = match (toks[i]) {
      lexer.TokPunct(x) => x.text,
      _ => "",
    };
    if (text == open) {
      stack = stack.append(i);
    } else if (text == close && stack.len() > 0) {
      out = out.with(stack[stack.len() - 1], i);
      stack = stack.truncate(stack.len() - 1);
    }
  }
  return out;
}

function (p: Par) first_param_looks_typed(idx0: i32): boolean {
  let idx = idx0;
  if (p.ident_at(idx).len() > 0 && p.punct_at(idx + 1) == "@") {
    idx += 2;
  }
  if (p.ident_at(idx) == "own" && p.ident_at(idx + 1).len() > 0) {
    idx += 1;
  }
  if (p.punct_at(idx) == "(") {
    return p.closer_followed_by(idx, "(", ")", ":", "=>");
  }
  let brace = record_pattern_brace_at(p, idx);
  if (brace >= 0) {
    return p.closer_followed_by(brace, "{", "}", ":", "");
  }
  return p.ident_at(idx).len() > 0 && p.punct_at(idx + 1) == ":";
}

function (p: Par) arrow_lambda_at(): boolean {
  let open = p.pos;
  if (p.punct_at(open + 1) == ")") {
    let after = p.punct_at(open + 2);
    return after == "=>" || after == ":";
  }
  if (!p.first_param_looks_typed(open + 1)) {
    return false;
  }
  return p.closer_followed_by(open, "(", ")", "=>", ":");
}

function parse_arrow_lambda(p: Par, once: boolean): (ast.Expr, Par) {
  let lam_line = p.peek_line();
  let lam_col = p.peek_col();
  p = p.advance();
  let params: ast.ParamDecl[] = [];
  let apd: ParamDestr[] = [];
  if (p.peek_punct() != ")") {
    while (true) {
      if (at_pattern_head(p)) {
        let (atpr_param, atpr_destr, atpr_p) = parse_pattern_param(p);
        p = atpr_p;
        if (atpr_destr.pattern.binds.len() == 0) {
          return (e_unknown_at(parse_fault("expected a parameter name or a destructuring pattern"), p.peek_line(), p.peek_col()), p);
        }
        params = params.append(atpr_param);
        apd = apd.append(atpr_destr);
        if (p.peek_punct() == ",") {
          p = p.advance();
          if (p.peek_punct() == ")") {
            break;
          }
          continue;
        }
        break;
      }
      let (pr_param, pr_p) = parse_param(p, params.len());
      p = pr_p;
      params = params.append(pr_param);
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == ")") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  let ret_own = false;
  let ret_type = "";
  let lam_fn_ret = "";
  let lam_fn_ptys = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    if (p.peek_ident() == "own") {
      ret_own = true;
      p = p.advance();
    }
    let saved = p;
    let (rtr_name, rtr_fn_ret, rtr_p) = parse_type_name(p);
    if (rtr_p.peek_punct() == "=>") {
      p = rtr_p;
      ret_type = rtr_name;
      let (gw, gwr, gwe) = parse_type_name(Par { ...saved, verbatim: true });
      let (g_ret, g_ptys) = fn_contract_of(rtr_name, gw);
      lam_fn_ret = g_ret;
      lam_fn_ptys = g_ptys;
    } else {
      let (ra_name, ra_fn_ret, ra_p) = parse_type_name_reserving_arrow(saved);
      p = ra_p;
      ret_type = ra_name;
      let (rw, rwr, rwe) = parse_type_name_reserving_arrow(Par { ...saved, verbatim: true });
      let (r_ret, r_ptys) = fn_contract_of(ra_name, rw);
      lam_fn_ret = r_ret;
      lam_fn_ptys = r_ptys;
    }
  }
  if (p.peek_punct() == "=>") {
    p = p.advance();
  }
  let body: ast.Stmt[] = [];
  if (p.peek_punct() == "{") {
    let (lb_body, lb_p) = parse_lambda_body(p, ret_type == "void");
    p = lb_p;
    body = lb_body;
  } else {
    let (ber_expr, ber_p) = parse_expr(p);
    p = ber_p;
    body = [s_return(ber_expr)];
  }
  body = prepend_param_destrs(body, apd);
  let lam = e_lambda_at(params, ret_type, body, "", lam_line, lam_col, lam_fn_ret, lam_fn_ptys, ret_own);
  if let ast.ExprLambda(lm) = lam {
    lam = ast.ExprLambda { ...lm, once: once };
  }
  return parse_postfix(p, lam);
}

function map_key_kind_of_expr(e: ast.Expr): i32 {
  match (e) {
    ast.ExprNumber(_) => {
      return 1;
    },
    ast.ExprString(_) => {
      return 0;
    },
    ast.ExprBool(_) => {
      return 1;
    },
    ast.ExprBinary(b) => {
      return map_key_kind_of_expr(b.left);
    },
    ast.ExprUnary(u) => {
      if (is_cast_op(u.op)) {
        if (util.str_range_eq(u.op, 3, u.op.len(), "string")) {
          return 0;
        }
        return 1;
      }
      return map_key_kind_of_expr(u.operand);
    },
    _ => {
      return -1;
    }
  }
}

function parse_map_lit(p: Par): (ast.Expr, Par) {
  let want_kk = p.map_kind;
  let mline = p.peek_line();
  let mcol = p.peek_col();
  p = p.with_map_kind(-1).advance();
  let mlk: ast.Expr[] = [];
  let mlv: ast.Expr[] = [];
  if (p.peek_punct() != "}") {
    while (true) {
      let (mke_expr, mke_p) = parse_expr(p);
      p = mke_p;
      if (p.peek_punct() == ":") {
        p = p.advance();
      }
      let (mve_expr, mve_p) = parse_expr(p);
      p = mve_p;
      mlk = mlk.append(mke_expr);
      mlv = mlv.append(mve_expr);
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == "}") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  if (p.verbatim) {
    return parse_postfix(p, ast.ExprMapLit { keys: mlk, vals: mlv, line: mline, col: mcol });
  }
  let kk = want_kk;
  for kki in 0..mlk.len() {
    if (kk < 0) {
      kk = map_key_kind_of_expr(mlk[kki]);
    }
  }
  let ctor: string = if (kk == 1) { "__map_new_i32" } else { "map_new" };
  let cargs: ast.Expr[] = [];
  cargs = cargs.append(e_number("8", "", false));
  let mbase = e_call_at(e_ident(ctor), cargs, mline, mcol);
  for mpi in 0..mlk.len() {
    let sargs: ast.Expr[] = [];
    sargs = sargs.append(mlk[mpi]);
    sargs = sargs.append(mlv[mpi]);
    mbase = e_call(e_field_access(mbase, "insert"), sargs);
  }
  return parse_postfix(p, mbase);
}

function map_ann_key_kind(t: string): i32 {
  if (t.len() < 5 || !t.starts_with("Map[")) {
    return -1;
  }
  let inner = slice_unchecked(t, 4, t.len());
  if (inner.len() >= 4 && inner.starts_with("i32,")) {
    return 1;
  }
  if (inner.len() >= 7 && inner.starts_with("string,")) {
    return 0;
  }
  return -1;
}

function parse_struct_lit_body(p: Par, type_name: string, sline: i32, scol: i32): (ast.Expr, Par) {
  p = p.advance();
  let fnames: string[] = [];
  let flines: i32[] = [];
  let fcols: i32[] = [];
  let fvals: ast.Expr[] = [];
  let has_base = false;
  let base = e_unknown("no-base");
  if (p.peek_punct() == "...") {
    p = p.advance();
    let (br_expr, br_p) = parse_expr(p);
    p = br_p;
    has_base = true;
    base = br_expr;
    if (p.peek_punct() == ",") {
      p = p.advance();
    } else {
      if (p.peek_punct() != "}") {
        return missing_close(missing_fault("} in struct update"), "}", [base], p);
      }
      p = p.advance();
      return (e_struct_update(type_name, fnames, flines, fcols, fvals, base, sline, scol), p);
    }
  }
  if (p.peek_punct() != "}") {
    while (true) {
      let fn = p.peek_ident();
      if (fn.len() == 0) {
        return (e_unknown_at(missing_fault("field name in struct lit"), p.peek_line(), p.peek_col()), p.skip_to_close("}"));
      }
      flines = flines.append(p.peek_line());
      fcols = fcols.append(p.peek_col());
      p = p.advance();
      if (p.peek_punct() != ":") {
        return (e_unknown_at(missing_fault(": in struct lit"), p.peek_line(), p.peek_col()), p.skip_to_close("}"));
      }
      p = p.advance();
      let (fv_expr, fv_p) = parse_expr(p);
      p = fv_p;
      fnames = fnames.append(fn);
      fvals = fvals.append(fv_expr);
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == "}") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() != "}") {
    let parts = fvals;
    if (has_base) {
      parts = [base];
      for v in fvals {
        parts = parts.append(v);
      }
    }
    return missing_close(missing_fault("} in struct lit"), "}", parts, p);
  }
  p = p.advance();
  if (has_base) {
    return (e_struct_update(type_name, fnames, flines, fcols, fvals, base, sline, scol), p);
  }
  return (e_struct_lit(type_name, fnames, flines, fcols, fvals, sline, scol), p);
}

function scan_written_type_args(p: Par): (string, i32, Par) {
  let out = "";
  let n = 0;
  while (true) {
    let tn = p.peek_const_arg();
    if (tn.len() > 0) {
      p = p.advance();
    } else {
      let (written, written_fnret, written_p) = parse_type_name(p);
      if (written.len() == 0) {
        return ("", 0, p);
      }
      tn = written;
      p = written_p;
    }
    if (n > 0) {
      out += ", ";
    }
    out += tn;
    n += 1;
    if (p.peek_punct() == ",") {
      p = p.advance();
      if (p.peek_punct() == "]") {
        break;
      }
      continue;
    }
    break;
  }
  if (p.peek_punct() != "]") {
    return ("", 0, p);
  }
  return (out, n, p);
}

function written_type_arg_list(text: string, scanned: i32, count: i32): string[] {
  if (scanned == count) {
    return split_top_commas(text);
  }
  let out: string[] = [];
  for i in 0..count {
    out = out.append("");
  }
  return out;
}

function type_shaped_bracket(p: Par): boolean {
  let named = p.peek_ident().len() > 0 || p.peek_const_arg().len() > 0;
  if (!named && p.peek_punct() != "(") {
    return false;
  }
  let shaped = false;
  let depth = 1;
  let parens = 0;
  // Bit d is set when the bracket open at depth d follows a name, as the
  // arguments of a generic type do.
  let named_at = 0;
  let j = 0;
  while (p.pos + j < p.toks.len()) {
    let pk = p.peek_punct_at(j);
    if (pk == "[") {
      depth += 1;
      named_at = bracket_name_bit(p, j, depth, named_at);
      if (is_type_keyword_tok(p, j + 1) || p.peek_punct_at(j + 1) == "]") {
        shaped = true;
      }
    } else if (pk == "," && parens == 0 && (depth == 1 || (named_at >> depth & 1) == 1) || pk == "=>" && depth == 1) {
      shaped = true;
    } else if (pk == "{") {
      return false;
    } else if (pk == "(") {
      let prev = p.peek_punct_at(j - 1);
      if (prev.len() == 0 || prev == "]" || prev == ")") {
        return false;
      }
      parens += 1;
      if (is_type_keyword_tok(p, j + 1)) {
        shaped = true;
      }
    } else if (pk == ")") {
      parens -= 1;
    } else if (pk == "]") {
      depth -= 1;
      if (depth == 0) {
        let after = p.peek_punct_at(j + 1);
        return shaped && after == "(" || named && after == "{" && !p.no_struct;
      }
    }
    j += 1;
  }
  return false;
}

function bracket_name_bit(p: Par, j: i32, depth: i32, bits: i32): i32 {
  if (depth > 30) {
    return bits;
  }
  let cleared = bits & ~(1 << depth);
  if (j > 0 && p.peek_ident_at(j - 1).len() > 0) {
    return cleared | 1 << depth;
  }
  return cleared;
}

function is_type_keyword_tok(p: Par, k: i32): boolean {
  if (p.pos + k >= p.toks.len()) {
    return false;
  }
  if let lexer.TokKeyword(kw) = p.toks[p.pos + k] {
    return kw.name == "i32" || kw.name == "i64" || kw.name == "u8" || kw.name == "u16" || kw.name == "i16" || kw.name == "u32" || kw.name == "u64" || kw.name == "usize" || kw.name == "f32" || kw.name == "f64" || typeinfo.lanes_width(kw.name) > 0 || kw.name == "string" || kw.name == "boolean" || kw.name == "void";
  }
  return false;
}

function with_written_type_args(callee: ast.Expr, args: string): ast.Expr {
  match (callee) {
    ast.ExprIdent(id) => {
      return ast.ExprIdent { ...id, name: id.name + "[" + args + "]" };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, field: fa.field + "[" + args + "]" };
    },
    _ => {
      return callee;
    }
  }
}

function parse_delimited(p: Par): (ast.Expr, Par) {
  let saved = p.no_struct;
  let (expr, next) = parse_expr(p.with_no_struct(false));
  return (expr, next.with_no_struct(saved));
}

function parse_postfix(p: Par, base: ast.Expr): (ast.Expr, Par) {
  let pending_type_arg_list: string[] = [];
  let pending_type_line = 0;
  let pending_type_col = 0;
  let pending_type_args = "";
  let path_sep_line = 0;
  let path_sep_col = 0;
  for links in 1..MAX_NEST_DEPTH + 2 {
    if (p.too_deep_by(links)) {
      return (e_unknown_at(nest_fault(), p.peek_line(), p.peek_col()), p.bail());
    }
    let pk = p.peek_punct();
    if (pk == "(") {
      let oline = p.peek_line();
      let ocol = p.peek_col();
      if (pending_type_arg_list.len() > 0) {
        oline = pending_type_line;
        ocol = pending_type_col;
      }
      p = p.advance();
      let args: ast.Expr[] = [];
      if (p.peek_punct() != ")") {
        while (true) {
          let an = p.peek_ident();
          if (an.len() > 0 && p.peek2_punct() == "=") {
            let aline = p.peek_line();
            let acol = p.peek_col();
            p = p.advance();
            p = p.advance();
            let (rv_expr, rv_p) = parse_delimited(p);
            p = rv_p;
            args = args.append(ast.binary("__named_arg", ast.ExprIdent { name: an, line: aline, col: acol, ty: "", builtin: false }, rv_expr, aline, acol, ""));
          } else {
            let (ra_expr, ra_p) = parse_delimited(p);
            p = ra_p;
            args = args.append(ra_expr);
          }
          let (ca_more, ca_p) = p.more_elems(")");
          p = ca_p;
          if (ca_more) {
            continue;
          }
          break;
        }
      }
      if (p.peek_punct() != ")") {
        return missing_close(missing_fault(") in call"), ")", args, p);
      }
      p = p.advance();
      if (pending_type_args.len() > 0) {
        base = with_written_type_args(base, pending_type_args);
      }
      base = ast.ExprCall { callee: base, args: args, line: oline, col: ocol, type_args: pending_type_arg_list, ty: "" };
      base = maybe_desugar_array_build(base);
      base = maybe_desugar_map_build(base);
      pending_type_arg_list = [];
      pending_type_args = "";
    } else if (pk == "[") {
      let bline = p.peek_line();
      let bcol = p.peek_col();
      p = p.advance();
      if (p.peek_punct() == ":") {
        p = p.advance();
        if (p.peek_punct() == "]") {
          p = p.advance();
          base = e_slice_all(base, bline, bcol);
          continue;
        }
        let (shi_expr, shi_p) = parse_delimited(p);
        p = shi_p;
        if (p.peek_punct() != "]") {
          return missing_close(missing_fault("] in slice"), "]", [shi_expr], p);
        }
        p = p.advance();
        base = e_slice_from_start(base, shi_expr, bline, bcol);
        continue;
      }
      let idxStart = p.pos;
      let (idx_expr, idx_p) = parse_delimited(p);
      if (type_shaped_bracket(p)) {
        idx_p = p;
      }
      if (idx_p.pos == idxStart) {
        let (wta_text, wta_n, wta_p) = scan_written_type_args(p);
        let written_args = "";
        if (wta_n > 0) {
          written_args = wta_text;
        }
        if (p.verbatim && wta_n > 0) {
          pending_type_args = wta_text;
          pending_type_arg_list = split_top_commas(wta_text);
          pending_type_line = bline;
          pending_type_col = bcol;
          p = wta_p;
        }
        let ta_depth = 0;
        let ta_saw = false;
        let ta_commas = 0;
        let ta_trailing = false;
        while (!p.at_end()) {
          let tp2 = p.peek_punct();
          if (tp2 == "]" && ta_depth == 0) {
            break;
          }
          if (tp2 == "[" || tp2 == "(") {
            ta_depth += 1;
          }
          if (tp2 == "]" || tp2 == ")") {
            ta_depth -= 1;
          }
          if (tp2 == "," && ta_depth == 0) {
            ta_commas += 1;
            ta_trailing = true;
          } else {
            ta_trailing = false;
          }
          ta_saw = true;
          p = p.advance();
        }
        if (ta_trailing) {
          ta_commas -= 1;
        }
        if (ta_saw) {
          pending_type_arg_list = written_type_arg_list(wta_text, wta_n, ta_commas + 1);
          pending_type_line = bline;
          pending_type_col = bcol;
        }
        if (p.peek_punct() == "]") {
          p = p.advance();
        }
        let ta_after = p.peek_punct();
        if (ta_after != "(" && (ta_after != "{" || p.no_struct)) {
          base = e_index(base, idx_expr, bline, bcol);
          pending_type_arg_list = [];
          pending_type_args = "";
          continue;
        }
        if (ta_after == "{") {
          match (base) {
            ast.ExprIdent(bid) => {
              let glit_name = bid.name;
              if (pending_type_args.len() > 0) {
                glit_name = glit_name + "[" + pending_type_args + "]";
              }
              let (glit_expr, glit_p) = parse_struct_lit_body(p, glit_name, bid.line, bid.col);
              p = glit_p;
              base = glit_expr;
              if let ast.ExprStructLit(gsl) = glit_expr {
                if (written_args.len() > 0) {
                  base = ast.ExprStructLit { ...gsl, written: bid.name + "[" + written_args + "]" };
                }
              }
              pending_type_arg_list = [];
              pending_type_args = "";
            },
            _ => {}
          }
        }
        continue;
      }
      p = idx_p;
      if (p.peek_punct() == ":") {
        p = p.advance();
        if (p.peek_punct() == "]") {
          p = p.advance();
          base = e_slice_open(base, idx_expr, bline, bcol);
          continue;
        }
        let (end_expr, end_p) = parse_delimited(p);
        p = end_p;
        if (p.peek_punct() != "]") {
          return missing_close(missing_fault("] in slice"), "]", [idx_expr, end_expr], p);
        }
        p = p.advance();
        base = e_slice(base, idx_expr, end_expr, bline, bcol);
      } else {
        if (p.peek_punct() != "]") {
          return missing_close(missing_fault("] in index"), "]", [idx_expr], p);
        }
        p = p.advance();
        base = e_index(base, idx_expr, bline, bcol);
      }
    } else if (pk == "." || pk == "::") {
      if (pk == "::" && path_sep_line == 0) {
        path_sep_line = p.peek_line();
        path_sep_col = p.peek_col();
      }
      let dline = p.peek_line();
      let dcol = p.peek_col();
      p = p.advance();
      let fname = p.peek_ident();
      if (fname.len() == 0) {
        match (p.peek()) {
          lexer.TokNumber(n) => {
            fname = n.text;
          },
          _ => {}
        }
      }
      if (fname.len() == 0) {
        return (e_unknown_at(missing_fault("field name after ."), p.peek_line(), p.peek_col()), p);
      }
      p = p.advance();
      let qname = "";
      let qline = 0;
      let qcol = 0;
      match (base) {
        ast.ExprIdent(qid) => {
          qname = qid.name;
          qline = qid.line;
          qcol = qid.col;
        },
        _ => {}
      }
      let qstruct_ok = false;
      if (qname.len() > 0 && !p.no_struct && p.peek_punct() == "{") {
        let qlook = p.advance();
        if (qlook.peek_punct() == "}") {
          qstruct_ok = true;
        } else if (qlook.peek_punct() == "...") {
          qstruct_ok = true;
        } else if (qlook.peek_ident().len() > 0) {
          let qlook2 = qlook.advance();
          if (qlook2.peek_punct() == ":") {
            qstruct_ok = true;
          }
        }
      }
      if (qstruct_ok) {
        let (qr_expr, qr_p) = parse_struct_lit_body(p, qname + "." + fname, qline, qcol);
        p = qr_p;
        base = qr_expr;
      } else {
        base = ast.ExprFieldAccess { obj: base, field: fname, line: dline, col: dcol, ty: "", const_read: false, display: false };
      }
    } else if (p.peek_keyword() == "as") {
      let asline = p.peek_line();
      let ascol = p.peek_col();
      p = p.advance();
      let is_downcast = false;
      if (p.peek_punct() == "?") {
        is_downcast = true;
        p = p.advance();
      }
      let (castty_name, castty_fn_ret, castty_p) = parse_type_name(p);
      p = castty_p;
      let tyname = castty_name;
      if (is_downcast) {
        base = ast.cast(base, tyname, true, asline, ascol, "");
      } else {
        base = ast.cast(base, tyname, false, asline, ascol, "");
      }
    } else if (p.peek_punct() == "?") {
      let qline = p.peek_line();
      let qcol = p.peek_col();
      p = p.advance();
      base = e_unary_at("try_", base, qline, qcol);
    } else {
      break;
    }
  }
  if (path_sep_line > 0) {
    return (e_unknown_at(parse_fault(path_sep_message()), path_sep_line, path_sep_col), p);
  }
  return (base, p);
}

function parse_expr_from_text(p: Par, text: string, base_line: i32, base_col: i32): (ast.Expr, Par, boolean) {
  let toks = lexer.rebase_tokens(lexer.tokenize(text), base_line, base_col);
  if let Some(le) = stream_lex_error(toks) {
    return (e_unknown_at(lex_fault(le), le.line, le.col), p, true);
  }
  let sub = Par { toks: toks, pos: 0, no_struct: false, map_kind: -1, structnames: scan_struct_names(toks), constnames: p.constnames, verbatim: p.verbatim, depth: 0, type_errs: p.type_errs, todos: p.todos, tail_at: [], tail_is: [], strict_semi: false, closers: closers(toks) };
  let (r_expr, r_p) = parse_expr(sub);
  let outer = Par { ...p, type_errs: r_p.type_errs, todos: r_p.todos };
  if (!r_p.at_end()) {
    return (e_unknown_at(parse_fault("f-string interpolation: unexpected trailing tokens after expression"), r_p.peek_line(), r_p.peek_col()), outer, true);
  }
  return (r_expr, outer, r_p.type_errs.len() > p.type_errs.len() || holds_sentinel(r_expr));
}

pub function holds_sentinel(e: ast.Expr): boolean {
  return astwalk.fold_expr_nodes(e, false, sentinel_scan_stmt, sentinel_scan_expr, astwalk.descend_all);
}

function sentinel_scan_stmt(st: ast.Stmt, own hit: boolean): boolean {
  if let ast.StmtUnknown(_) = st {
    return true;
  }
  return hit;
}

function sentinel_scan_expr(e: ast.Expr, own hit: boolean): boolean {
  if let ast.ExprUnknown(u) = e {
    return hit || u.fault.mark != BARE_RETURN;
  }
  return hit;
}

// `unsafe { …; e }` is a value block whose statements and value sit in an
// unsafe block, so it accepts the obligations of what it calls.
function parse_unsafe_value_block(p: Par): (ast.Expr, Par) {
  let line = p.peek_line();
  let col = p.peek_col();
  let (body, rt, after) = parse_branch_body(p.advance());
  let no_params: ast.ParamDecl[] = [];
  let no_args: ast.Expr[] = [];
  let lam = e_lambda_origin(no_params, rt, [s_if_tagged(body, "unsafe")], ORIGIN_BLOCK);
  return parse_postfix(after, e_call_at(lam, no_args, line, col));
}

function parse_primary(p: Par): (ast.Expr, Par) {
  if (p.too_deep()) {
    return (e_unknown_at(nest_fault(), p.peek_line(), p.peek_col()), p.bail());
  }
  let (g0, gq) = parse_primary_nested(p.with_depth(p.depth + 1));
  return (g0, gq.with_depth(p.depth));
}

function parse_primary_nested(p: Par): (ast.Expr, Par) {
  if (!p.no_struct && p.peek_ident() == "unsafe" && p.advance().peek_punct() == "{") {
    return parse_unsafe_value_block(p);
  }
  let t = p.peek();
  match (t) {
    lexer.TokNumber(x) => {
      let nline = p.peek_line();
      let ncol = p.peek_col();
      p = p.advance();
      if (!p.verbatim && x.is_float() && util.f64_lit_out_of_range(x.text)) {
        return parse_postfix(p, e_unknown_at(float_range_fault(x.text), nline, ncol));
      }
      return parse_postfix(p, e_spelled_at(x.text, x.suffix(), x.raw, x.is_float(), nline, ncol));
    },
    lexer.TokString(x) => {
      let sline = p.peek_line();
      let scol = p.peek_col();
      p = p.advance();
      return parse_postfix(p, e_string_at(x.value, sline, scol));
    },
    lexer.TokKeyword(x) => {
      if (x.name == "true" || x.name == "false") {
        let bline = p.peek_line();
        let bcol = p.peek_col();
        p = p.advance();
        return parse_postfix(p, e_bool_at(x.name == "true", bline, bcol));
      }
      if (x.name == "function") {
        return (e_unknown_at(coded_fault("P006", "`function` introduces a named declaration; write an anonymous function as an arrow lambda — `(x: T): R => …`"), p.peek_line(), p.peek_col()), p.advance());
      }
      if (x.name == "match") {
        let mc = parse_match_expr(p);
        let mno_params: ast.ParamDecl[] = [];
        let mlam_body: ast.Stmt[] = [mc.stmt];
        if (mc.value_local.len() > 0) {
          mlam_body = [s_var(mc.value_local, "", zero_expr_for(mc.rt)), mc.stmt, s_return(e_ident(mc.value_local))];
        } else if (mc.needs_default_return) {
          mlam_body = mlam_body.append(s_return(zero_expr_for(mc.rt)));
        }
        let mno_args: ast.Expr[] = [];
        if (mc.scrut_bind.len() > 0) {
          let minner = e_call(e_lambda_origin(mno_params, mc.rt, mlam_body, ORIGIN_MATCH_EXPR), mno_args);
          mlam_body = [mc.scrut_bind[0], s_return(minner)];
        }
        let miife = e_call_at(e_lambda_origin(mno_params, mc.rt, mlam_body, ORIGIN_MATCH_EXPR), mno_args, x.line, x.col);
        return parse_postfix(mc.par, miife);
      }
      if (x.name == "if") {
        let ic = parse_if_chain(p);
        let iife = value_chain_expr(ic, ORIGIN_IF_EXPR, x.line, x.col);
        return parse_postfix(ic.par, iife);
      }
      let is_tykw: boolean = x.name == "string" || x.name == "boolean" || x.name == "void"
        || x.name == "i32" || x.name == "i64"
        || x.name == "u8" || x.name == "u16" || x.name == "i16" || x.name == "u32" || x.name == "u64"
        || x.name == "usize" || x.name == "f32" || x.name == "f64" || typeinfo.lanes_width(x.name) > 0;
      if (is_tykw) {
        let kwline = p.peek_line();
        let kwcol = p.peek_col();
        let look = p.advance();
        if (look.peek_punct() == "." || look.peek_punct() == "::") {
          return parse_postfix(look, e_ident_at(x.name, kwline, kwcol));
        }
      }
      return (e_unknown_at(parse_fault("expected an expression, got \"" + x.name + "\""), p.peek_line(), p.peek_col()), p);
    },
    lexer.TokIdent(x) => {
      let idline = p.peek_line();
      let idcol = p.peek_col();
      p = p.advance();
      // `once` is a word only before a lambda: a name is not valid there.
      if (x.name == "once" && p.peek_punct() == "(" && p.arrow_lambda_at()) {
        return parse_arrow_lambda(p, true);
      }
      let base = e_ident_at(x.name, idline, idcol);
      if (x.name == "Map" && !p.no_struct && p.peek_punct() == "{") {
        return parse_map_lit(p);
      }
      if (!p.no_struct && p.peek_punct() == "{") {
        let (slr_expr, slr_p) = parse_struct_lit_body(p, x.name, idline, idcol);
        p = slr_p;
        base = slr_expr;
      }
      return parse_postfix(p, base);
    },
    lexer.TokPunct(x) => {
      if (x.text == "(") {
        if (p.arrow_lambda_at()) {
          return parse_arrow_lambda(p, false);
        }
        let tpl = p.peek_line();
        let tpc = p.peek_col();
        p = p.advance();
        if (p.peek_punct() == ")") {
          p = p.advance();
          return parse_postfix(p, e_unit_at(tpl, tpc));
        }
        let (inner_expr, inner_p) = parse_delimited(p);
        p = inner_p;
        if (p.peek_punct() == ",") {
          let elems: ast.Expr[] = [];
          elems = elems.append(inner_expr);
          while (p.peek_punct() == ",") {
            p = p.advance();
            if (p.peek_punct() == ")") {
              break;
            }
            let (er_expr, er_p) = parse_delimited(p);
            p = er_p;
            elems = elems.append(er_expr);
          }
          if (p.peek_punct() == ")") {
            p = p.advance();
          }
          return parse_postfix(p, e_tuple_at(elems, tpl, tpc));
        }
        if (p.peek_punct() == ")") {
          p = p.advance();
        }
        return parse_postfix(p, inner_expr);
      }
      if (x.text == "[") {
        p = p.advance();
        let elems: ast.Expr[] = [];
        if (p.peek_punct() != "]") {
          while (true) {
            let (er_expr, er_p) = parse_delimited(p);
            p = er_p;
            elems = elems.append(er_expr);
            let (ea_more, ea_p) = p.more_elems("]");
            p = ea_p;
            if (ea_more) {
              continue;
            }
            break;
          }
        }
        if (p.peek_punct() != "]") {
          return missing_close(missing_fault("] in array literal"), "]", elems, p);
        }
        p = p.advance();
        return parse_postfix(p, e_array_at(elems, x.line, x.col));
      }
      if (x.text == "{" && !p.no_struct) {
        let (bb_body, bb_rt, bb_p) = parse_branch_body(p);
        let bx_params: ast.ParamDecl[] = [];
        let bx_args: ast.Expr[] = [];
        let iife = e_call_at(e_lambda_origin(bx_params, bb_rt, bb_body, ORIGIN_BLOCK), bx_args, x.line, x.col);
        return parse_postfix(bb_p, iife);
      }
      if (util.has_str(["-", "!", "~"], x.text)) {
        let uline = p.peek_line();
        let ucol = p.peek_col();
        p = p.advance();
        let (operand_expr, operand_p) = parse_primary(p);
        return (e_unary_at(x.text, operand_expr, uline, ucol), operand_p);
      }
      let badline = p.peek_line();
      let badcol = p.peek_col();
      let bad = punct_fault(x.text);
      if (p.reported_at(badline, badcol)) {
        bad = ast.fault_mark(REPORTED);
      }
      p = p.advance();
      return (e_unknown_at(bad, badline, badcol), p);
    },
    lexer.TokEof(_) => {
      return (e_unknown_at(parse_fault("expected an expression, got the end of the file"), p.peek_line(), p.peek_col()), p);
    },
    lexer.TokError(x) => {
      return (e_unknown_at(lex_fault(x), x.line, x.col), p);
    },
    lexer.TokFString(f) => {
      p = p.advance();
      if (p.verbatim) {
        let vlits: string[] = [];
        let vexprs: ast.Expr[] = [];
        let vflags: boolean[] = [];
        for vi in 0..f.parts.len() {
          let vpart = f.parts[vi];
          vflags = vflags.append(vpart.is_expr);
          if (vpart.is_expr) {
            vlits = vlits.append("");
            let (ve, vp, _) = parse_expr_from_text(p, vpart.expr, vpart.line, vpart.col);
            p = vp;
            if let ast.ExprUnknown(_) = ve {
              return (ve, p);
            }
            vexprs = vexprs.append(ve);
          } else {
            vlits = vlits.append(vpart.lit);
            vexprs = vexprs.append(e_unknown("fstring-literal-part"));
          }
        }
        return parse_postfix(p, ast.ExprFString { lits: vlits, exprs: vexprs, is_expr: vflags, line: f.line, col: f.col });
      }
      let built = e_string("");
      let has = false;
      for i in 0..f.parts.len() {
        let part = f.parts[i];
        let piece = e_string(part.lit);
        if (part.is_expr) {
          let no_args: ast.Expr[] = [];
          let (pe, pp, failed) = parse_expr_from_text(p, part.expr, part.line, part.col);
          p = pp;
          if (failed) {
            return (pe, p);
          }
          let shown: ast.Expr = ast.ExprFieldAccess { obj: pe, field: "to_string", line: f.line, col: f.col, ty: "", const_read: false, display: true };
          piece = e_call_at(shown, no_args, f.line, f.col);
        }
        if (!has) {
          built = piece;
          has = true;
        } else {
          built = e_binary("+", built, piece);
        }
      }
      return parse_postfix(p, built);
    }
  }
}

// The lowest precedence inside one literal of a pattern: the operators that
// bind tighter than `|`, which separates the alternatives of a pattern.
function pattern_min_prec(): i32 {
  return precedence("|") + 1;
}

function precedence(op: string): i32 {
  if (op == "||") {
    return 1;
  }
  if (op == "&&") {
    return 2;
  }
  if (op == "==" || op == "!=") {
    return 3;
  }
  if (op == "<" || op == ">" || op == "<=" || op == ">=") {
    return 4;
  }
  if (op == "|") {
    return 5;
  }
  if (op == "^") {
    return 6;
  }
  if (op == "&") {
    return 7;
  }
  if (op == "<<" || op == ">>" || op == "<<|" || op == "<<?" || op == ">>?") {
    return 8;
  }
  if (op == "+" || op == "-" || op == "+|" || op == "-|" || op == "+?" || op == "-?") {
    return 9;
  }
  if (op == "*" || op == "/" || op == "%" || op == "*|" || op == "*?" || op == "/?" || op == "%?") {
    return 10;
  }
  return -1;
}

function parse_binary(p: Par, min_prec: i32): (ast.Expr, Par) {
  if (p.too_deep()) {
    return (e_unknown_at(nest_fault(), p.peek_line(), p.peek_col()), p.bail());
  }
  let (g0, gq) = parse_binary_nested(p.with_depth(p.depth + 1), min_prec);
  return (g0, gq.with_depth(p.depth));
}

function parse_binary_nested(p: Par, min_prec: i32): (ast.Expr, Par) {
  let (lhs_expr, lhs_p) = parse_primary(p);
  p = lhs_p;
  for links in 1..MAX_NEST_DEPTH + 2 {
    let op = p.peek_punct();
    let prec = precedence(op);
    if (prec < min_prec) {
      return (lhs_expr, p);
    }
    if (p.too_deep_by(links)) {
      break;
    }
    let opline = p.peek_line();
    let opcol = p.peek_col();
    p = p.advance();
    let (rhs_expr, rhs_p) = parse_binary(p, prec + 1);
    p = rhs_p;
    lhs_expr = e_binary_at(op, lhs_expr, rhs_expr, opline, opcol);
  }
  return (e_unknown_at(nest_fault(), p.peek_line(), p.peek_col()), p.bail());
}

function parse_expr(p: Par): (ast.Expr, Par) {
  return parse_pipe(p);
}

pub struct IfChain { par: Par, stmt: ast.Stmt, rt: string, needs_default_return: boolean, value_local: string, scrut_bind: ast.Stmt[] }

function value_arm_body(body: ast.Stmt[], val: string): ast.Stmt[] {
  if (body.len() == 0) {
    return body;
  }
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      let out: ast.Stmt[] = [];
      for i in 0..body.len() - 1 {
        out = out.append(body[i]);
      }
      if (stmts_exit(out, false)) {
        return out;
      }
      if let Some(st) = exiting_if_tail(r.value) {
        return out.append(st);
      }
      return out.append(s_assign(val, r.value));
    },
    _ => {
      return body;
    }
  }
}

function zero_expr_for(rt: string): ast.Expr {
  if (rt == "string" || rt == "str") {
    return e_string("");
  }
  if (rt == "boolean") {
    return e_bool(false);
  }
  if (rt == "f64") {
    return e_number("0", "", true);
  }
  if (rt == "i64" || rt == "u64") {
    return e_number("0", rt, false);
  }
  return e_number("0", "", false);
}

function if_expr_rt(e: ast.Expr): string {
  match (e) {
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprBool(_) => {
      return "boolean";
    },
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return "f64";
      }
      if (n.suffix.len() > 0) {
        return n.suffix;
      }
      if (ast.literal_is_i64(n.text)) {
        return "i64";
      }
      return "i32";
    },
    ast.ExprCall(c) => {
      if (c.args.len() != 0) {
        return "i32";
      }
      match (c.callee) {
        ast.ExprLambda(lam) => {
          if (lam.params.len() == 0 && lam.ret_type.len() > 0) {
            return lam.ret_type;
          }
          return "i32";
        },
        _ => {
          return "i32";
        }
      }
    },
    ast.ExprBinary(b) => {
      if (irt_is_cmp(b.op)) {
        return "boolean";
      }
      return wider_rt(if_expr_rt(b.left), if_expr_rt(b.right));
    },
    ast.ExprUnary(u) => {
      if (u.op == "!") {
        return "boolean";
      }
      if (is_cast_op(u.op)) {
        return u.cast;
      }
      return if_expr_rt(u.operand);
    },
    _ => {
      return "i32";
    }
  }
}

function wider_rt(a: string, b: string): string {
  if (a == b) {
    return a;
  }
  if (a == "i64" || a == "u64") {
    return a;
  }
  if (b == "i64" || b == "u64") {
    return b;
  }
  return a;
}

function parse_lit_or_range(p: Par): (ast.Expr, ast.Expr, boolean, boolean, Par) {
  let (lo_expr, lo_p) = parse_binary(p, pattern_min_prec());
  p = lo_p;
  let pk = p.peek_punct();
  if (pk == ".." || pk == "..=") {
    p = p.advance();
    let (hi_expr, hi_p) = parse_binary(p, pattern_min_prec());
    p = hi_p;
    return (lo_expr, hi_expr, true, pk == "..=", p);
  }
  return (lo_expr, e_bool(true), false, false, p);
}

function parse_lit_alts(p: Par): (ast.Expr[], ast.Expr[], boolean[], boolean[], Par) {
  let lits: ast.Expr[] = [];
  let his: ast.Expr[] = [];
  let hrs: boolean[] = [];
  let incs: boolean[] = [];
  let (l0, h0, hr0, inc0, p0) = parse_lit_or_range(p);
  p = p0;
  lits = lits.append(l0);
  his = his.append(h0);
  hrs = hrs.append(hr0);
  incs = incs.append(inc0);
  while (p.peek_punct() == "|") {
    p = p.advance();
    let (ln, hn, hrn, incn, pn) = parse_lit_or_range(p);
    p = pn;
    lits = lits.append(ln);
    his = his.append(hn);
    hrs = hrs.append(hrn);
    incs = incs.append(incn);
  }
  return (lits, his, hrs, incs, p);
}

function bool_closing_arm(arms: ast.LitArm[]): Option[i32] {
  let t = false;
  let f = false;
  for i in 0..arms.len() {
    let a = arms[i];
    if (a.is_wild && !a.has_guard) {
      return None;
    }
    if let ast.ExprBool(b) = a.lit {
      if (!a.is_wild && !a.has_guard && !a.has_range && a.at_binding.len() == 0) {
        t = t || b.value;
        f = f || !b.value;
      }
    }
    if (t && f) {
      return Some(i);
    }
  }
  return None;
}

function close_bool_arms(arms: ast.LitArm[]): ast.LitArm[] {
  let Some(k) = bool_closing_arm(arms) else {
    return arms;
  };
  let out: ast.LitArm[] = [];
  for i in 0..k {
    out = out.append(arms[i]);
  }
  return out.append(ast.LitArm { ...arms[k], is_wild: true });
}

function literal_pattern(arm: ast.LitArm): ast.Pattern {
  if (arm.is_wild) {
    return p_wildcard();
  }
  return ast.PatLiteral { scalar_cells: [], lit: arm.lit, range_hi: arm.range_hi, has_range: arm.has_range, range_inclusive: arm.range_inclusive, at_binding: arm.at_binding };
}

function literal_pattern_match(scrut: ast.Expr, arms: ast.LitArm[], patterns: ast.Pattern[], line: i32, col: i32): ast.Stmt {
  let out: ast.MatchArm[] = [];
  let i = 0;
  for arm in arms {
    out = out.append(ast.MatchArm { pattern: patterns[i], body: arm.body, line: arm.line, col: arm.col, guard: arm.guard, has_guard: arm.has_guard, alt_cont: arm.alt_cont });
    i += 1;
  }
  return s_match_at(scrut, out, line, col);
}

function build_literal_match(scrut: ast.Expr, arms: ast.LitArm[], mkline: i32, mkcol: i32): ast.Stmt {
  let written_arms = arms;
  arms = close_bool_arms(arms);
  let wi = 0;
  let non_last_wild = false;
  let saw_wild = false;
  while (wi < arms.len()) {
    if (arms[wi].is_wild && !arms[wi].has_guard) {
      saw_wild = true;
      if (wi < arms.len() - 1) {
        non_last_wild = true;
      }
    }
    wi += 1;
  }
  if (non_last_wild || !saw_wild) {
    let marms: ast.MatchArm[] = [];
    for mi in 0..arms.len() {
      let la = arms[mi];
      let pat = literal_pattern(la);
      let lbody = la.body;
      if (la.at_binding.len() > 0) {
        lbody = prepend_stmt(as_header(s_var_at(la.at_binding, "", scrut, la.line, la.col)), la.body);
      }
      marms = marms.append(ast.MatchArm { pattern: pat, body: lbody, line: la.line, col: la.col, guard: la.guard, has_guard: la.has_guard, alt_cont: false });
    }
    return s_match_at(scrut, marms, mkline, mkcol);
  }
  let written = scrut;
  let lm = "";
  if let ast.ExprIdent(_) = scrut {} else {
    lm = literal_scrut_local(mkline, mkcol);
    scrut = e_ident(lm);
  }
  let else_body: ast.Stmt[] = [];
  let i = arms.len() - 1;
  while (i >= 0) {
    let first = alternation_start(arms, i);
    else_body = literal_arm_chain(arms, first, i, scrut, else_body);
    i = first - 1;
  }
  if (else_body.len() == 0) {
    return s_unknown_at(parse_fault("empty literal match"), mkline, mkcol);
  }
  let sugar = ast.MatchSugar { ...no_match_sugar(), scrut: written, lits: written_arms, line: mkline, col: mkcol };
  if (lm != "") {
    return s_if_match([s_var_at(lm, "", written, mkline, mkcol), else_body[0]], sugar);
  }
  return with_match_sugar(else_body[0], sugar);
}

// alternation_start is the index of the first alternative in the written arm
// that holds arms[last]. A wildcard, which close_bool_arms can make from the
// last alternative, stays an arm of its own.
function alternation_start(arms: ast.LitArm[], last: i32): i32 {
  let first = last;
  while (first > 0 && arms[first].alt_cont && !arms[first].is_wild) {
    first -= 1;
  }
  return first;
}

// literal_arm_chain puts one `if` for the alternatives arms[first..=last] in
// front of else_body. All the alternatives share one copy of the body.
function literal_arm_chain(arms: ast.LitArm[], first: i32, last: i32, scrut: ast.Expr, else_body: ast.Stmt[]): ast.Stmt[] {
  let a = arms[last];
  if (a.is_wild) {
    if (a.has_guard) {
      return [s_if(a.guard, a.body, else_body)];
    }
    return a.body;
  }
  let abody = a.body;
  let aguard = a.guard;
  let at = shared_at_binding(arms, first, last);
  if (at.len() > 0) {
    abody = prepend_stmt(as_header(s_var_at(at, "", scrut, a.line, a.col)), a.body);
    if let ast.ExprIdent(sid) = scrut {
      aguard = astwalk.subst_ident_expr(a.guard, at, sid.name);
    }
  }
  let cond = literal_arm_test(arms[first], scrut);
  for k in first + 1..last + 1 {
    cond = e_binary("||", cond, literal_arm_test(arms[k], scrut));
  }
  if (a.has_guard) {
    cond = e_binary("&&", cond, aguard);
  }
  return [s_if(cond, abody, else_body)];
}

// The name that every alternative in arms[first..=last] binds with `@`, or ""
// when some alternative binds none.
function shared_at_binding(arms: ast.LitArm[], first: i32, last: i32): string {
  let at = arms[first].at_binding;
  for k in first + 1..last + 1 {
    if (arms[k].at_binding != at) {
      return "";
    }
  }
  return at;
}

function literal_arm_test(a: ast.LitArm, scrut: ast.Expr): ast.Expr {
  if (!a.has_range) {
    return ast.binary("==", scrut, a.lit, a.line, a.col, "");
  }
  let hi_op = "<";
  if (a.range_inclusive) {
    hi_op = "<=";
  }
  return e_binary("&&", e_binary(">=", scrut, a.lit), e_binary(hi_op, scrut, a.range_hi));
}

function with_match_sugar(st: ast.Stmt, sugar: ast.MatchSugar): ast.Stmt {
  match (st) {
    ast.StmtIf(i) => {
      return ast.StmtIf { ...i, sugar: sugar };
    },
    _ => {
      return st;
    }
  }
}

pub function literal_scrut_local(line: i32, col: i32): string {
  return "__lm" + util.i32_to_string(line) + "_" + util.i32_to_string(col);
}

pub function is_literal_scrut_local(name: string): boolean {
  return name.len() > 4 && name.starts_with("__lm");
}

function with_written_scrut(st: ast.Stmt, written: ast.Expr): ast.Stmt {
  match (st) {
    ast.StmtIf(i) => {
      return ast.StmtIf { ...i, sugar: ast.MatchSugar { ...i.sugar, scrut: written } };
    },
    _ => {
      return st;
    }
  }
}

// else_chained records that an if-let's else was written `else if`.
function with_sugar_origin(st: ast.Stmt, origin: string, else_chained: boolean): ast.Stmt {
  match (st) {
    ast.StmtIf(i) => {
      return ast.StmtIf { ...i, sugar: ast.MatchSugar { ...i.sugar, origin: origin, else_chained: else_chained } };
    },
    ast.StmtMatch(m) => {
      return ast.StmtMatch { ...m, origin: origin, else_chained: else_chained };
    },
    _ => {
      return st;
    }
  }
}

function p_tuple_carrier(kinds: i32[], binds: string[], lits: ast.Expr[], pats: ast.Pattern[]): ast.Pattern {
  let no_extra: string[] = [];
  let no_nested: ast.Pattern[] = [];
  return ast.PatVariant { scalar_cells: [], scalar_binding: false, bare_name: false, type_name: "", binding: "", extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: kinds, tup_binds: binds, tup_lits: lits, tup_pats: pats, rest_written: false };
}

function parse_tuple_arm_pattern(p: Par): (i32[], string[], ast.Expr[], ast.Pattern[], Par) {
  if (p.too_deep()) {
    return ([], [], [], [], p.bail());
  }
  let (g0, g1, g2, g3, gq) = parse_tuple_arm_pattern_nested(p.with_depth(p.depth + 1));
  return (g0, g1, g2, g3, gq.with_depth(p.depth));
}

function parse_tuple_arm_pattern_nested(p: Par): (i32[], string[], ast.Expr[], ast.Pattern[], Par) {
  let elem_kinds: i32[] = [];
  let binds: string[] = [];
  let lits: ast.Expr[] = [];
  let pats: ast.Pattern[] = [];
  let none: i32[] = [];
  let no_pats: ast.Pattern[] = [];
  p = p.advance();
  while (p.peek_punct() != ")" && !p.at_end()) {
    let n = p.peek_binder();
    if (n == "_") {
      p = p.advance();
      elem_kinds = elem_kinds.append(1);
      binds = binds.append("");
      lits = lits.append(e_bool(true));
      pats = pats.append(p_wildcard());
    } else if (p.peek_punct() == "(") {
      let (ne_kinds, ne_binds, ne_lits, ne_pats, ne_p) = parse_tuple_arm_pattern(p);
      p = ne_p;
      if (ne_kinds.len() == 0) {
        return (none, [], [], no_pats, p);
      }
      elem_kinds = elem_kinds.append(4);
      binds = binds.append("");
      lits = lits.append(e_bool(true));
      pats = pats.append(p_tuple_carrier(ne_kinds, ne_binds, ne_lits, ne_pats));
    } else if (n.len() > 0 && (p.peek_punct_at(1) == "(" || p.peek_punct_at(1) == ".")) {
      let (ve_pat, ve_p) = parse_pattern(p);
      p = ve_p;
      elem_kinds = elem_kinds.append(3);
      binds = binds.append("");
      lits = lits.append(e_bool(true));
      pats = pats.append(ve_pat);
    } else if (n.len() > 0) {
      p = p.advance();
      elem_kinds = elem_kinds.append(0);
      binds = binds.append(n);
      lits = lits.append(e_bool(true));
      pats = pats.append(p_wildcard());
    } else if (p.peek_is_pat_literal()) {
      let (le_expr, le_p) = parse_binary(p, pattern_min_prec());
      p = le_p;
      elem_kinds = elem_kinds.append(2);
      binds = binds.append("");
      lits = lits.append(le_expr);
      pats = pats.append(p_wildcard());
    } else {
      return (none, [], [], no_pats, p);
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (elem_kinds.len() < 2) {
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
    return (none, [], [], no_pats, p);
  }
  return (elem_kinds, binds, lits, pats, p.expect(")"));
}

function tuple_elem_pattern(prefix: string, n: i32): ast.Destr {
  let names: string[] = [];
  for k in 0..n {
    names = names.append(prefix + "_e" + util.i32_to_string(k));
  }
  return ast.tuple_destr(names);
}

function wrap_tuple_elems(path: ast.Stmt[], kinds: i32[], pats: ast.Pattern[], prefix: string, line: i32, col: i32): ast.Stmt[] {
  let cur = path;
  let wi = kinds.len() - 1;
  while (wi >= 0) {
    let en = prefix + "_e" + util.i32_to_string(wi);
    if (kinds[wi] == 3) {
      cur = match_sub_pattern(cur, en, pats[wi], line, col);
    } else if (kinds[wi] == 4) {
      let (nk, nb, nl, np) = pv_tup(pats[wi]);
      let sub = wrap_tuple_elems(cur, nk, np, en, line, col);
      let body: ast.Stmt[] = [];
      for bk in 0..nk.len() {
        if (nk[bk] == 0) {
          body = body.append(as_header(s_var_at(nb[bk], "", e_ident_at(en + "_e" + util.i32_to_string(bk), line, col), line, col)));
        }
      }
      for si in 0..sub.len() {
        body = body.append(sub[si]);
      }
      let ncond = e_bool(true);
      let has_ncond = false;
      for lk in 0..nk.len() {
        if (nk[lk] == 2) {
          let one = e_binary("==", e_ident(en + "_e" + util.i32_to_string(lk)), nl[lk]);
          if (has_ncond) {
            ncond = e_binary("&&", ncond, one);
          } else {
            ncond = one;
          }
          has_ncond = true;
        }
      }
      let nwrap: ast.Stmt[] = [];
      nwrap = nwrap.append(s_destr_at(tuple_elem_pattern(en, nk.len()), e_ident_at(en, line, col), line, col));
      if (has_ncond) {
        nwrap = nwrap.append(s_if(ncond, body, []));
      } else {
        for ci in 0..body.len() {
          nwrap = nwrap.append(body[ci]);
        }
      }
      cur = nwrap;
    }
    wi -= 1;
  }
  return cur;
}

// A tuple match takes only tuple patterns and `_`, as the oracle's checker requires.
function non_tuple_arm_error(pat: ast.Pattern, at_binding: string): Option[ast.Fault] {
  if let ast.PatWildcard(_) = pat {
    if (at_binding.len() > 0) {
      return Some(at_wildcard_fault());
    }
    return None;
  }
  return Some(coded_fault("E035", "match on a tuple only accepts tuple patterns or `_`"));
}

function build_tuple_match(scrut: ast.Expr, arms: ast.TupArm[], mkline: i32, mkcol: i32): ast.Stmt {
  if (arms.len() == 0) {
    return s_unknown_at(parse_fault("empty tuple match"), mkline, mkcol);
  }
  let n_elems = 0;
  for ai in 0..arms.len() {
    if (!arms[ai].is_wild) {
      n_elems = arms[ai].elem_kinds.len();
      break;
    }
  }
  return build_tuple_match_sized(scrut, arms, n_elems, mkline, mkcol);
}

// The test of an arm of a match lowered to a chain of ifs: no earlier arm
// set done. The first arm tests true, because done is false there.
function done_flag_cond(done: string, first: boolean): ast.Expr {
  if (first) {
    return e_bool(true);
  }
  return e_unary("!", e_ident(done));
}

pub function build_tuple_match_sized(scrut: ast.Expr, arms: ast.TupArm[], n_elems: i32, mkline: i32, mkcol: i32): ast.Stmt {
  if (n_elems < 2) {
    return s_unknown_at(parse_fault("tuple match with no tuple arm"), mkline, mkcol);
  }
  let base = "__tm" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
  let done = base + "_d";
  let whole = base + "_w";
  let names = tuple_elem_pattern(base, n_elems);
  let any_at = false;
  for qi in 0..arms.len() {
    if (!arms[qi].is_wild && arms[qi].at_binding.len() > 0) {
      any_at = true;
    }
  }
  let outer: ast.Stmt[] = [];
  if (any_at) {
    outer = outer.append(s_var_at(whole, "", scrut, mkline, mkcol));
    outer = outer.append(s_destr_at(names, e_ident(whole), mkline, mkcol));
  } else {
    outer = outer.append(s_destr_at(names, scrut, mkline, mkcol));
  }
  outer = outer.append(s_var(done, "", e_bool(false)));
  let first = true;
  let ai = 0;
  while (ai < arms.len()) {
    let a = arms[ai];
    if (!a.is_wild && a.elem_kinds.len() != n_elems) {
      outer = outer.append(s_if(e_bool(false), a.body, []));
      ai += 1;
      continue;
    }
    let cond = done_flag_cond(done, first);
    first = false;
    let inner: ast.Stmt[] = [];
    if (a.is_wild) {
      if (a.has_guard) {
        cond = e_binary("&&", cond, a.guard);
      }
      inner = inner.append(s_assign(done, e_bool(true)));
      for wb in 0..a.body.len() {
        inner = inner.append(a.body[wb]);
      }
      outer = outer.append(s_if(cond, inner, []));
      ai += 1;
      continue;
    }
    let ek = 0;
    while (ek < a.elem_kinds.len()) {
      if (a.elem_kinds[ek] == 2) {
        cond = e_binary("&&", cond, e_binary("==", e_ident(base + "_e" + util.i32_to_string(ek)), a.lits[ek]));
      }
      ek += 1;
    }
    let binds: ast.Stmt[] = [];
    if (a.at_binding.len() > 0) {
      binds = binds.append(as_header(s_var_at(a.at_binding, "", e_ident_at(whole, a.line, a.col), a.line, a.col)));
    }
    for ek in 0..a.elem_kinds.len() {
      if (a.elem_kinds[ek] == 0) {
        binds = binds.append(as_header(s_var_at(a.binds[ek], "", e_ident_at(base + "_e" + util.i32_to_string(ek), a.line, a.col), a.line, a.col)));
      }
    }
    if (a.has_guard) {
      let guarded: ast.Stmt[] = [];
      guarded = guarded.append(s_assign(done, e_bool(true)));
      for gb in 0..a.body.len() {
        guarded = guarded.append(a.body[gb]);
      }
      for bi in 0..binds.len() {
        inner = inner.append(binds[bi]);
      }
      inner = inner.append(s_if(a.guard, guarded, []));
    } else {
      inner = inner.append(s_assign(done, e_bool(true)));
      for bi2 in 0..binds.len() {
        inner = inner.append(binds[bi2]);
      }
      for ab in 0..a.body.len() {
        inner = inner.append(a.body[ab]);
      }
    }
    inner = wrap_tuple_elems(inner, a.elem_kinds, a.elem_pats, base, a.line, a.col);
    outer = outer.append(s_if(cond, inner, []));
    ai += 1;
  }
  let no_struct: ast.StructArm[] = [];
  return s_if_match(outer, ast.MatchSugar { ...no_match_sugar(), scrut: scrut, tup: arms, line: mkline, col: mkcol });
}

pub struct StructArmPattern { binds: string[], fields: string[], kinds: i32[], lits: ast.Expr[], pats: ast.Pattern[], rest_written: boolean, ok: boolean }

function parse_struct_arm_pattern(p: Par): (StructArmPattern, Par) {
  let binds: string[] = [];
  let fields: string[] = [];
  let kinds: i32[] = [];
  let lits: ast.Expr[] = [];
  let pats: ast.Pattern[] = [];
  let ok = true;
  let rest_written = false;
  if (p.peek_ident().len() > 0) {
    p = p.advance();
  }
  if (p.peek_punct() == "{") {
    p = p.advance();
  }
  while (p.peek_punct() != "}" && !p.at_end()) {
    if (p.peek_punct() == "..") {
      p = p.advance();
      rest_written = true;
      break;
    }
    let fld = p.peek_ident();
    if (fld.len() == 0) {
      p = p.advance();
      ok = false;
      break;
    }
    p = p.advance();
    let bind = fld;
    let fkind = 0;
    let flit = e_bool(true);
    let fpat = p_wildcard();
    if (p.peek_punct() == ":") {
      p = p.advance();
      if (p.peek_is_pat_literal()) {
        let (le_expr, le_p) = parse_expr(p);
        p = le_p;
        fkind = 2;
        flit = le_expr;
        bind = "";
      } else if (struct_field_variant_start(p)) {
        let (fp, fpp) = parse_pattern(p);
        p = fpp;
        fkind = 3;
        fpat = fp;
        bind = "";
      } else {
        let lc = p.peek_ident();
        if (lc.len() > 0) {
          p = p.advance();
        }
        bind = lc;
      }
    }
    binds = binds.append(bind);
    fields = fields.append(fld);
    kinds = kinds.append(fkind);
    lits = lits.append(flit);
    pats = pats.append(fpat);
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (StructArmPattern { binds: binds, fields: fields, kinds: kinds, lits: lits, pats: pats, rest_written: rest_written, ok: ok }, p);
}

function struct_field_variant_start(p: Par): boolean {
  let n = p.peek_ident();
  if (n.len() > 0 && n != "_") {
    let nx = p.peek_punct_at(1);
    if (nx == "(" || nx == ".") {
      return true;
    }
  }
  return false;
}

function build_struct_match(scrut: ast.Expr, arms: ast.StructArm[], mkline: i32, mkcol: i32): ast.Stmt {
  return build_struct_match_fields(scrut, arms, mkline, mkcol, false);
}

function struct_match_literal_cond(cond: ast.Expr, a: ast.StructArm, tmp: string): ast.Expr {
  for lk in 0..a.field_kinds.len() {
    if (a.field_kinds[lk] == 2) {
      cond = e_binary("&&", cond, e_binary("==", e_field_access_at(e_ident(tmp), a.fields[lk], a.line, a.col), a.field_lits[lk]));
    }
  }
  return cond;
}

function struct_match_bindings(a: ast.StructArm, tmp: string, record: boolean): ast.Stmt[] {
  let binds: ast.Stmt[] = [];
  if (a.at_binding.len() > 0) {
    binds = binds.append(as_header(s_var_at(a.at_binding, "", e_ident(tmp), a.line, a.col)));
  }
  let bk = 0;
  if (record && a.fields.len() > 0) {
    let pattern = record_pattern(a.type_name, record_binding_list(a.binds, a.line, a.col), a.fields, "", a.rest_written);
    binds = binds.append(as_header(s_destr_at(ast.Destr { ...pattern, struct_match: true }, e_ident(tmp), a.line, a.col)));
    bk = a.binds.len();
  }
  while (bk < a.binds.len()) {
    if (a.binds[bk].len() > 0) {
      binds = binds.append(as_header(s_var_at(a.binds[bk], "", e_field_access_at(e_ident(tmp), a.fields[bk], a.line, a.col), a.line, a.col)));
    }
    bk += 1;
  }
  return binds;
}

function build_struct_match_fields(scrut: ast.Expr, arms: ast.StructArm[], mkline: i32, mkcol: i32, record: boolean): ast.Stmt {
  if (arms.len() == 0) {
    return s_unknown_at(parse_fault("empty struct match"), mkline, mkcol);
  }
  let base = "__sm" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
  let tmp = base + "_v";
  let done = base + "_d";
  let outer: ast.Stmt[] = [];
  outer = outer.append(s_var(tmp, "", scrut));
  outer = outer.append(s_var(done, "", e_bool(false)));
  let ai = 0;
  while (ai < arms.len()) {
    let a = arms[ai];
    let cond = done_flag_cond(done, ai == 0);
    let inner: ast.Stmt[] = [];
    if (a.is_wild) {
      if (a.has_guard) {
        cond = e_binary("&&", cond, a.guard);
      }
      inner = inner.append(s_assign(done, e_bool(true)));
      for wb in 0..a.body.len() {
        inner = inner.append(a.body[wb]);
      }
      outer = outer.append(s_if(cond, inner, []));
      ai += 1;
      continue;
    }
    cond = struct_match_literal_cond(cond, a, tmp);
    let binds = struct_match_bindings(a, tmp, record);
    if (a.has_guard) {
      let guarded: ast.Stmt[] = [];
      guarded = guarded.append(s_assign(done, e_bool(true)));
      for gb in 0..a.body.len() {
        guarded = guarded.append(a.body[gb]);
      }
      for bi in 0..binds.len() {
        inner = inner.append(binds[bi]);
      }
      inner = inner.append(s_if(a.guard, guarded, []));
    } else {
      inner = inner.append(s_assign(done, e_bool(true)));
      for bi2 in 0..binds.len() {
        inner = inner.append(binds[bi2]);
      }
      for ab in 0..a.body.len() {
        inner = inner.append(a.body[ab]);
      }
    }
    inner = wrap_struct_fields(inner, a, tmp);
    outer = outer.append(s_if(cond, inner, []));
    ai += 1;
  }
  let no_tup: ast.TupArm[] = [];
  return s_if_match(outer, ast.MatchSugar { ...no_match_sugar(), scrut: scrut, strct: arms, line: mkline, col: mkcol });
}

function wrap_struct_fields(path: ast.Stmt[], a: ast.StructArm, tmp: string): ast.Stmt[] {
  let cur = path;
  let wi = a.field_kinds.len() - 1;
  while (wi >= 0) {
    if (a.field_kinds[wi] == 3) {
      let mk_arms: ast.MatchArm[] = [];
      mk_arms = mk_arms.append(ast.MatchArm { pattern: a.field_pats[wi], body: cur, line: a.line, col: a.col, guard: e_bool(true), has_guard: false, alt_cont: false });
      let mk_skip: ast.Stmt[] = [];
      mk_arms = mk_arms.append(ast.MatchArm { pattern: p_wildcard(), body: mk_skip, line: a.line, col: a.col, guard: e_bool(true), has_guard: false, alt_cont: false });
      let fv = tmp + "_f" + util.i32_to_string(wi);
      let mk_wrap: ast.Stmt[] = [];
      mk_wrap = mk_wrap.append(as_header(s_var_at(fv, "", e_field_access_at(e_ident(tmp), a.fields[wi], a.line, a.col), a.line, a.col)));
      mk_wrap = mk_wrap.append(s_match_origin(e_ident_at(fv, a.line, a.col), mk_arms, a.line, a.col, ORIGIN_PATTERN_PROBE));
      cur = mk_wrap;
    }
    wi -= 1;
  }
  return cur;
}

function is_struct_pattern_arm(p: Par): boolean {
  let head = p.peek_ident();
  if (head.len() > 0 && p.peek_punct_at(1) == "@") {
    head = p.peek_ident_at(2);
  }
  if (head.len() == 0) {
    return false;
  }
  return util.has_str(p.structnames, head);
}

function parse_struct_match_arms(p: Par, expr_form: boolean): (ast.StructArm[], string, boolean, Par) {
  let arms: ast.StructArm[] = [];
  let rt = "i32";
  let first = true;
  let all_ok = true;
  while (p.peek_punct() != "}" && !p.at_end()) {
    let sline = p.peek_line();
    let scol = p.peek_col();
    let s_wild = false;
    let s_binds: string[] = [];
    let s_fields: string[] = [];
    let s_rest = false;
    let s_field_kinds: i32[] = [];
    let s_field_lits: ast.Expr[] = [];
    let s_field_pats: ast.Pattern[] = [];
    let s_at = "";
    let s_type = "";
    if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
      s_at = p.peek_ident();
      p = p.advance();
      p = p.advance();
    }
    if (p.peek_ident() == "_" && p.peek2_punct() != "{") {
      p = p.advance();
      s_wild = true;
    } else {
      s_type = p.peek_ident();
      let (sap, spp) = parse_struct_arm_pattern(p);
      let spb = sap.binds;
      let spf = sap.fields;
      let spkinds = sap.kinds;
      let splits = sap.lits;
      let sppats = sap.pats;
      let spok = sap.ok;
      p = spp;
      s_binds = spb;
      s_fields = spf;
      s_rest = sap.rest_written;
      s_field_kinds = spkinds;
      s_field_lits = splits;
      s_field_pats = sppats;
      if (!spok) {
        all_ok = false;
      }
    }
    let s_guard = e_bool(true);
    let s_has_guard = false;
    if (p.peek_keyword() == "when") {
      p = p.advance();
      let (sgr_expr, sgr_p) = parse_expr(p);
      p = sgr_p;
      s_guard = sgr_expr;
      s_has_guard = true;
    }
    p = p.expect("=>");
    let sbody: ast.Stmt[] = [];
    let sbrt = "i32";
    if (expr_form) {
      if (p.peek_punct() == "{") {
        let (sbb_body, sbb_rt, sbb_p) = parse_branch_body(p);
        p = sbb_p;
        sbody = sbb_body;
        sbrt = sbb_rt;
      } else {
        let (ser_expr, ser_p) = parse_expr(p);
        p = ser_p;
        sbody = [s_return(ser_expr)];
        sbrt = if_expr_rt(ser_expr);
      }
    } else {
      let (sblk_body, sblk_p) = parse_match_stmt_body(p);
      p = sblk_p;
      sbody = sblk_body;
    }
    if (first) {
      rt = sbrt;
      first = false;
    }
    arms = arms.append(ast.StructArm { is_wild: s_wild, type_name: s_type, binds: s_binds, fields: s_fields, field_kinds: s_field_kinds, field_lits: s_field_lits, field_pats: s_field_pats, at_binding: s_at, rest_written: s_rest, guard: s_guard, has_guard: s_has_guard, body: sbody, line: sline, col: scol });
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  p = p.expect("}");
  return (arms, rt, all_ok, p);
}

function is_compound_assign_op(op: string): boolean {
  return op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%="
    || op == "&=" || op == "|=" || op == "^=" || op == "<<=" || op == ">>=";
}

function branch_stmt_start(p: Par): boolean {
  if (p.peek_punct() == "{") {
    return true;
  }
  if (p.peek_ident() == "unsafe" && p.advance().peek_punct() == "{") {
    return true;
  }
  let kw = p.peek_keyword();
  if (kw == "if" && !p.if_stmt_has_else()) {
    return true;
  }
  if (kw == "while" || kw == "loop" || kw == "for" || kw == "break"
    || kw == "continue" || kw == "return" || kw == "defer"
    || kw == "errdefer" || kw == "let"
    || kw == "function") {
    return true;
  }
  return false;
}

// The statements end in a jump on every path: a return, a break, a continue or
// a loop with no test. A call never counts, as only the scopes tell which
// function a name calls.
pub function branch_stmts_diverge(stmts: ast.Stmt[]): boolean {
  return stmts_exit(stmts, true);
}

function stmts_exit(stmts: ast.Stmt[], loops: boolean): boolean {
  if (stmts.len() == 0) {
    return false;
  }
  return stmt_exits(stmts[stmts.len() - 1], loops);
}

function stmt_exits(st: ast.Stmt, loops: boolean): boolean {
  match (st) {
    ast.StmtReturn(_) => {
      return true;
    },
    ast.StmtBreak(_) => {
      return true;
    },
    ast.StmtContinue(_) => {
      return true;
    },
    ast.StmtWhile(w) => {
      return loops && w.is_loop;
    },
    ast.StmtIf(f) => {
      if (f.else_body.len() == 0) {
        return false;
      }
      return stmts_exit(f.then_body, loops) && stmts_exit(f.else_body, loops);
    },
    ast.StmtMatch(m) => {
      if (m.arms.len() == 0) {
        return false;
      }
      for i in 0..m.arms.len() {
        if (!stmts_exit(m.arms[i].body, loops)) {
          return false;
        }
      }
      return true;
    },
    _ => {
      return false;
    }
  }
}

function exiting_if_tail(e: ast.Expr): Option[ast.Stmt] {
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lam) = c.callee {
      if (lam.origin != ORIGIN_IF_EXPR || c.args.len() != 0 || lam.body.len() != 1) {
        return None;
      }
      if let ast.StmtIf(f) = lam.body[0] {
        if (branch_exits_early(f.then_body) && branch_exits_early(f.else_body)) {
          return Some(ast.StmtIf { ...f, then_body: without_last(f.then_body), else_body: without_last(f.else_body) });
        }
      }
    }
  }
  return None;
}

pub function branch_exits_early(body: ast.Stmt[]): boolean {
  return body.len() >= 2 && stmt_exits(body[body.len() - 2], false);
}

pub function without_last(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i = 0;
  while (i + 1 < body.len()) {
    out = out.append(body[i]);
    i += 1;
  }
  return out;
}

function branch_dead_tail(stmts: ast.Stmt[]): ast.Expr {
  if (stmts.len() == 0) {
    return e_number("0", "", false);
  }
  match (stmts[stmts.len() - 1]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprUnknown(_) => {
          return e_number("0", "", false);
        },
        _ => {
          return r.value;
        }
      }
    },
    _ => {
      return e_number("0", "", false);
    }
  }
}

function parse_block_items(p: Par): (ast.Stmt[], boolean, ast.Expr, boolean, Par) {
  let leading: ast.Stmt[] = [];
  let have_tail = false;
  let tail = e_unknown("empty branch");
  if (p.peek_punct() != "{") {
    return (leading, have_tail, tail, false, p);
  }
  p = p.advance();
  while (p.peek_punct() != "}" && !p.at_end()) {
    if (p.peek_keyword() == "match") {
      let (valueless, stmt, next) = valueless_branch_tail(p);
      if (valueless) {
        leading = leading.append(stmt);
        p = next;
        continue;
      }
    }
    let (is_stmt, ip) = item_is_stmt(p);
    p = ip;
    if (is_stmt) {
      let (sr_stmt, sr_p) = parse_stmt(p);
      if (sr_p.pos == p.pos) {
        p = p.advance();
        continue;
      }
      p = sr_p;
      leading = leading.append(sr_stmt);
      continue;
    }
    let before = p;
    let (er_expr, er_p) = parse_expr(p);
    p = er_p;
    if (p.peek_punct() == ";") {
      p = p.advance();
      leading = leading.append(with_stmt_line(s_expr(er_expr), before.peek_line()));
      continue;
    }
    if (p.peek_punct() != "}") {
      let (asr_stmt, asr_p) = parse_stmt(before);
      if (asr_p.pos == before.pos) {
        p = p.advance();
        continue;
      }
      p = asr_p;
      leading = leading.append(asr_stmt);
      continue;
    }
    tail = er_expr;
    have_tail = true;
    break;
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (leading, have_tail, tail, true, p);
}

function item_is_stmt(p: Par): (boolean, Par) {
  if (!branch_stmt_start(p)) {
    return (false, p);
  }
  let (tail, q) = nested_block_tail(p);
  return (!tail, q);
}

function tail_item_at(p: Par, tail_value: boolean): (boolean, Par) {
  if (!tail_value) {
    return (false, p);
  }
  let (is_stmt, q) = item_is_stmt(p);
  return (!is_stmt, q);
}

function valueless_branch_tail(p: Par): (boolean, ast.Stmt, Par) {
  let kw = p.peek_keyword();
  if (kw != "match" && kw != "if" || kw == "match" && !match_arms_braced(p)) {
    return (false, s_unknown(p, ast.fault_mark("")), p);
  }
  // A branch that ends in an unterminated expression gives the value.
  let (st, q) = parse_stmt(Par { ...p, strict_semi: true });
  if (q.type_errs.len() == p.type_errs.len() && q.peek_punct() == "}") {
    return (true, st, Par { ...q, strict_semi: p.strict_semi });
  }
  return (false, st, p);
}

function match_arms_braced(p: Par): boolean {
  if (p.too_deep_by(BLOCK_NEST_UNITS)) {
    return false;
  }
  let depth = 0;
  let k = 1;
  while (p.pos + k < p.toks.len()) {
    let t = p.peek_punct_at(k);
    if (t == "=>" && depth == 1) {
      let body_start = Par { ...p, pos: p.pos + k + 1, depth: p.depth + BLOCK_NEST_UNITS };
      let (leading, have_tail, tail, ok, after) = parse_block_items(body_start);
      if (!ok || have_tail || after.type_errs.len() != p.type_errs.len()) {
        return false;
      }
      k = after.pos - p.pos;
      continue;
    }
    depth += bracket_step(t);
    if (depth == 0 && t == "}") {
      return true;
    }
    k += 1;
  }
  return false;
}

function bracket_step(t: string): i32 {
  if (t == "(" || t == "[" || t == "{") {
    return 1;
  }
  if (t == ")" || t == "]" || t == "}") {
    return -1;
  }
  return 0;
}

// A block, or an unsafe block, that ends in a value.
function nested_block_tail(p: Par): (boolean, Par) {
  let open = p;
  if (p.peek_ident() == "unsafe") {
    open = p.advance();
  }
  if (open.peek_punct() != "{") {
    return (false, p);
  }
  let k = util.index_of_i32(p.tail_at, open.pos);
  if (k >= 0) {
    return (p.tail_is[k], p);
  }
  let (nb_leading, nb_have_tail, nb_tail, nb_ok, nb_p) = parse_block_items(open);
  let yes = nb_ok && nb_have_tail && nb_p.peek_punct() == "}";
  return (yes, Par { ...p, tail_at: nb_p.tail_at.append(open.pos), tail_is: nb_p.tail_is.append(yes) });
}

function parse_branch_body(p: Par): (ast.Stmt[], string, Par) {
  let (body, rt, dead, next) = parse_branch_body_written(p);
  return (body, rt, next);
}

function parse_branch_body_written(p: Par): (ast.Stmt[], string, boolean, Par) {
  let open_line = p.peek_line();
  let open_col = p.peek_col();
  let rt = "i32";
  let (bi_leading, bi_have_tail, bi_tail, bi_ok, bi_p) = parse_block_items(p);
  if (!bi_ok) {
    let ebody: ast.Stmt[] = [];
    ebody = ebody.append(s_unknown(p, missing_fault("{ in branch body")));
    return (ebody, rt, false, p);
  }
  let leading = bi_leading;
  let have_tail = bi_have_tail;
  let tail = bi_tail;
  p = bi_p;
  if (have_tail) {
    rt = if_expr_rt(tail);
  }
  if (!have_tail) {
    if (!branch_stmts_diverge(leading)) {
      leading = leading.append(s_unknown_at(ast.fault_mark(MISSING_TAIL), open_line, open_col));
      return (leading, rt, false, p);
    }
    let dead = branch_dead_tail(leading);
    rt = if_expr_rt(dead);
    leading = leading.append(s_return(dead));
    return (leading, rt, true, p);
  }
  leading = leading.append(s_return(tail));
  return (leading, rt, false, p);
}

function value_chain_expr(chain: IfChain, origin: string, line: i32, col: i32): ast.Expr {
  let params: ast.ParamDecl[] = [];
  let args: ast.Expr[] = [];
  let body: ast.Stmt[] = [chain.stmt];
  if (chain.value_local.len() > 0) {
    body = [s_var(chain.value_local, "", zero_expr_for(chain.rt)), chain.stmt, s_return(e_ident(chain.value_local))];
  } else if (chain.needs_default_return) {
    body = body.append(s_return(zero_expr_for(chain.rt)));
  }
  if (chain.scrut_bind.len() > 0) {
    let inner = e_call(e_lambda_origin(params, chain.rt, body, origin), args);
    body = [chain.scrut_bind[0], s_return(inner)];
  }
  return e_call_at(e_lambda_origin(params, chain.rt, body, origin), args, line, col);
}

function parse_if_chain(p: Par): IfChain {
  if (p.advance().peek_keyword() == "let") {
    return parse_pattern_if(p.advance(), true);
  }
  let (condr_expr, condr_p) = parse_paren_head(p.advance());
  p = condr_p;
  let (thenb_body, thenb_rt, then_dead, thenb_p) = parse_branch_body_written(p);
  let else_written = thenb_p.peek_keyword() == "else";
  p = thenb_p.expect("else");
  let then_body = thenb_body;
  let rt = thenb_rt;
  let else_body: ast.Stmt[] = [];
  let else_dead = false;
  let chained = p.peek_keyword() == "if" && else_written;
  if (chained) {
    let nested = parse_if_chain(p);
    else_body = [nested.stmt];
    if (nested.value_local.len() > 0) {
      else_body = [s_return(value_chain_expr(nested, ORIGIN_IF_EXPR, p.peek_line(), p.peek_col()))];
    }
    p = nested.par;
  } else if (else_written || p.peek_punct() == "{") {
    let (elseb_body, elseb_rt, elseb_dead, elseb_p) = parse_branch_body_written(p);
    p = elseb_p;
    else_body = elseb_body;
    else_dead = elseb_dead;
    rt = wider_rt(rt, elseb_rt);
  }
  let origin = ORIGIN_IF_EXPR;
  if (then_dead && else_dead) {
    origin = ORIGIN_IF_DEAD_BOTH;
  } else if (then_dead) {
    origin = ORIGIN_IF_DEAD_THEN;
  } else if (else_dead) {
    origin = ORIGIN_IF_DEAD_ELSE;
  }
  let stmt: ast.Stmt = ast.StmtIf { cond: condr_expr, then_body: then_body, else_body: else_body, line: 0, else_chained: chained, sugar: no_match_sugar(), origin: origin };
  return IfChain { par: p, stmt: stmt, rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
}

function parse_match_expr(p: Par): IfChain {
  let mkline = p.peek_line();
  let mkcol = p.peek_col();
  let (sr_expr, sr_p) = parse_paren_head(p.advance());
  let mc = parse_match_expr_arms(sr_p.expect("{"), sr_expr, mkline, mkcol);
  return IfChain { ...mc, stmt: with_arms_open(mc.stmt, sr_p.peek_line()) };
}

function with_arms_open(st: ast.Stmt, line: i32): ast.Stmt {
  match (st) {
    ast.StmtIf(i) => {
      return ast.StmtIf { ...i, sugar: ast.MatchSugar { ...i.sugar, arms_open: line } };
    },
    ast.StmtMatch(m) => {
      return ast.StmtMatch { ...m, arms_open: line };
    },
    _ => {
      return st;
    }
  }
}

function parse_literal_match_expr(p: Par, sr_expr: ast.Expr, mkline: i32, mkcol: i32): IfChain {
  let rt = "i32";
  let lit_arms: ast.LitArm[] = [];
  let patterns: ast.Pattern[] = [];
  let preserve_patterns = false;
  let lfirst = true;
  while (p.peek_punct() != "}" && !p.at_end()) {
    let laline = p.peek_line();
    let lacol = p.peek_col();
    let lwild = false;
    let lpattern = p_wildcard();
    let pattern_start = p;
    let (lat, lat_p) = take_at_binding(p);
    p = lat_p;
    let lalt_lits: ast.Expr[] = [];
    let lalt_his: ast.Expr[] = [];
    let lalt_hrs: boolean[] = [];
    let lalt_incs: boolean[] = [];
    if (p.peek_is_pat_literal()) {
      let (la_lits, la_his, la_hrs, la_incs, la_p) = parse_lit_alts(p);
      p = la_p;
      lalt_lits = la_lits;
      lalt_his = la_his;
      lalt_hrs = la_hrs;
      lalt_incs = la_incs;
    } else {
      let (lpr_pattern, lpr_p) = parse_pattern(pattern_start);
      p = lpr_p;
      lwild = true;
      lpattern = lpr_pattern;
      if let ast.PatWildcard(_) = lpattern {} else {
        preserve_patterns = true;
      }
    }
    let lguard = e_bool(true);
    let lhas_guard = false;
    if (p.peek_keyword() == "when") {
      p = p.advance();
      let (lgr_expr, lgr_p) = parse_expr(p);
      p = lgr_p;
      lguard = lgr_expr;
      lhas_guard = true;
    }
    p = p.expect("=>");
    let lbody: ast.Stmt[] = [];
    let lrt = "i32";
    if (p.peek_punct() == "{") {
      let (lbb_body, lbb_rt, lbb_p) = parse_branch_body(p);
      p = lbb_p;
      lbody = lbb_body;
      lrt = lbb_rt;
    } else {
      let (ler_expr, ler_p) = parse_expr(p);
      p = ler_p;
      lbody = [s_return(ler_expr)];
      lrt = if_expr_rt(ler_expr);
    }
    if (lfirst) {
      rt = lrt;
      lfirst = false;
    }
    if (lwild) {
      lit_arms = lit_arms.append(ast.LitArm { is_wild: true, lit: e_bool(true), guard: lguard, has_guard: lhas_guard, body: lbody, line: laline, col: lacol, range_hi: e_bool(true), has_range: false, range_inclusive: false, alt_cont: false, at_binding: "" });
      patterns = patterns.append(lpattern);
    } else {
      let lai = 0;
      let alt_at = lat;
      while (lai < lalt_lits.len()) {
        lit_arms = lit_arms.append(ast.LitArm { is_wild: false, lit: lalt_lits[lai], guard: lguard, has_guard: lhas_guard, body: lbody, line: laline, col: lacol, range_hi: lalt_his[lai], has_range: lalt_hrs[lai], range_inclusive: lalt_incs[lai], alt_cont: lai > 0, at_binding: alt_at });
        alt_at = "";
        patterns = patterns.append(literal_pattern(lit_arms[lit_arms.len() - 1]));
        lai += 1;
      }
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  p = p.expect("}");
  if (preserve_patterns) {
    return IfChain { par: p, stmt: literal_pattern_match(sr_expr, lit_arms, patterns, mkline, mkcol), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
  }
  if let ast.ExprIdent(_) = sr_expr {} else {
    let lm = literal_scrut_local(mkline, mkcol);
    let lchain = build_literal_match(e_ident(lm), lit_arms, mkline, mkcol);
    if let ast.StmtIf(_) = lchain {
      return IfChain { par: p, stmt: with_written_scrut(lchain, sr_expr), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [s_var_at(lm, "", sr_expr, mkline, mkcol)] };
    }
  }
  return IfChain { par: p, stmt: build_literal_match(sr_expr, lit_arms, mkline, mkcol), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
}

function parse_match_expr_arms(p: Par, sr_expr: ast.Expr, mkline: i32, mkcol: i32): IfChain {
  let rt = "i32";
  if (p.peek_punct() == "(" || p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek_punct_at(1) == "@" && p.peek_punct_at(2) == "(") {
    let etarms: ast.TupArm[] = [];
    let etfirst = true;
    while (p.peek_punct() != "}" && !p.at_end()) {
      let etline = p.peek_line();
      let etcol = p.peek_col();
      let et_wild = false;
      let et_empty_body: ast.Stmt[] = [];
      let et_at = "";
      if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
        et_at = p.peek_ident();
        p = p.advance();
        p = p.advance();
      }
      let etpats: ast.TupArm[] = [];
      if (p.peek_punct() == "(") {
        let (etpr_elem_kinds, etpr_binds, etpr_lits, etpr_pats, etpr_p) = parse_tuple_arm_pattern(p);
        p = etpr_p;
        if (etpr_elem_kinds.len() == 0) {
          return IfChain { par: p, stmt: s_unknown(p, parse_fault("expected a tuple pattern")), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
        }
        etpats = etpats.append(ast.TupArm { is_wild: false, elem_kinds: etpr_elem_kinds, binds: etpr_binds, lits: etpr_lits, elem_pats: etpr_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: et_empty_body, line: etline, col: etcol, alt_cont: false });
        while (p.peek_punct() == "|") {
          p = p.advance();
          let (etor_kinds, etor_binds, etor_lits, etor_pats, etor_p) = parse_tuple_arm_pattern(p);
          p = etor_p;
          if (etor_kinds.len() == 0) {
            return IfChain { par: p, stmt: s_unknown(p, parse_fault("expected a tuple pattern")), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
          }
          etpats = etpats.append(ast.TupArm { is_wild: false, elem_kinds: etor_kinds, binds: etor_binds, lits: etor_lits, elem_pats: etor_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: et_empty_body, line: etline, col: etcol, alt_cont: false });
        }
      } else {
        let (etwp_pattern, etwp_p) = parse_pattern(p);
        p = etwp_p;
        if let Some(kind) = non_tuple_arm_error(etwp_pattern, et_at) {
          p = p.refused_at(kind, etline, etcol);
        }
        et_wild = true;
      }
      let et_guard = e_bool(true);
      let et_has_guard = false;
      if (p.peek_keyword() == "when") {
        p = p.advance();
        let (etgr_expr, etgr_p) = parse_expr(p);
        p = etgr_p;
        et_guard = etgr_expr;
        et_has_guard = true;
      }
      p = p.expect("=>");
      let etbody: ast.Stmt[] = [];
      let etrt = "i32";
      if (p.peek_punct() == "{") {
        let (etbb_body, etbb_rt, etbb_p) = parse_branch_body(p);
        p = etbb_p;
        etbody = etbb_body;
        etrt = etbb_rt;
      } else {
        let (eter_expr, eter_p) = parse_expr(p);
        p = eter_p;
        etbody = [s_return(eter_expr)];
        etrt = if_expr_rt(eter_expr);
      }
      if (etfirst) {
        rt = etrt;
        etfirst = false;
      }
      if (et_wild) {
        let etw_kinds: i32[] = [];
        let etw_pats: ast.Pattern[] = [];
        let etw_binds: string[] = [];
        let etw_lits: ast.Expr[] = [];
        etarms = etarms.append(ast.TupArm { is_wild: true, elem_kinds: etw_kinds, binds: etw_binds, lits: etw_lits, elem_pats: etw_pats, at_binding: "", guard: et_guard, has_guard: et_has_guard, body: etbody, line: etline, col: etcol, alt_cont: false });
      } else {
        for etalt in 0..etpats.len() {
          let etpa = etpats[etalt];
          etarms = etarms.append(ast.TupArm { is_wild: false, elem_kinds: etpa.elem_kinds, binds: etpa.binds, lits: etpa.lits, elem_pats: etpa.elem_pats, at_binding: et_at, guard: et_guard, has_guard: et_has_guard, body: etbody, line: etline, col: etcol, alt_cont: etalt > 0 });
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
        continue;
      }
      break;
    }
    p = p.expect("}");
    let etval = "__tm" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let etvarms: ast.TupArm[] = [];
    for etvi in 0..etarms.len() {
      let etva = etarms[etvi];
      etvarms = etvarms.append(ast.TupArm { ...etva, body: value_arm_body(etva.body, etval) });
    }
    return IfChain { par: p, stmt: build_tuple_match(sr_expr, etvarms, mkline, mkcol), rt: rt, needs_default_return: false, value_local: etval, scrut_bind: [] };
  }
  if (at_local_struct_pattern(p)) {
    let (smarms, smrt, smok, smp) = parse_struct_match_arms(p, true);
    p = smp;
    if (!smok) {
      return IfChain { par: p, stmt: s_unknown(p, parse_fault("a struct pattern binds field names")), rt: smrt, needs_default_return: false, value_local: "", scrut_bind: [] };
    }
    let smval = "__sm" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let smvarms: ast.StructArm[] = [];
    for smvi in 0..smarms.len() {
      let smva = smarms[smvi];
      smvarms = smvarms.append(ast.StructArm { ...smva, body: value_arm_body(smva.body, smval) });
    }
    return IfChain { par: p, stmt: build_struct_match(sr_expr, smvarms, mkline, mkcol), rt: smrt, needs_default_return: false, value_local: smval, scrut_bind: [] };
  }
  if (p.peek_is_pat_literal() || p.peek_at_literal()) {
    return parse_literal_match_expr(p, sr_expr, mkline, mkcol);
  }
  let arms: ast.MatchArm[] = [];
  let ewritten: ast.MatchArm[] = [];
  let first = true;
  while (p.peek_punct() != "}" && !p.at_end()) {
    let aline = p.peek_line();
    let acol = p.peek_col();
    let (pr_pattern, pr_p) = parse_pattern(p);
    p = pr_p;
    let pats: ast.Pattern[] = [pr_pattern];
    while (p.peek_punct() == "|") {
      p = p.advance();
      let (pr2_pattern, pr2_p) = parse_pattern(p);
      p = pr2_p;
      pats = pats.append(pr2_pattern);
    }
    let arm_guard = e_bool(true);
    let arm_has_guard = false;
    if (p.peek_keyword() == "when") {
      p = p.advance();
      let (gr_expr, gr_p) = parse_expr(p);
      p = gr_p;
      arm_guard = gr_expr;
      arm_has_guard = true;
    }
    p = p.expect("=>");
    let abody: ast.Stmt[] = [];
    let art = "i32";
    if (p.peek_punct() == "{") {
      let (abb_body, abb_rt, abb_p) = parse_branch_body(p);
      p = abb_p;
      abody = abb_body;
      art = abb_rt;
    } else {
      let (er_expr, er_p) = parse_expr(p);
      p = er_p;
      abody = [s_return(er_expr)];
      art = if_expr_rt(er_expr);
    }
    if (first) {
      rt = art;
      first = false;
    } else {
      rt = wider_rt(rt, art);
    }
    for pi in 0..pats.len() {
      ewritten = ewritten.append(ast.MatchArm { pattern: pats[pi], body: abody, line: aline, col: acol, guard: arm_guard, has_guard: arm_has_guard, alt_cont: pi > 0 });
      let (fa_pat, fa_g, fa_hg) = fold_lit_cond(pats[pi], arm_guard, arm_has_guard);
      arms = arms.append(ast.MatchArm { pattern: fa_pat, body: abody, line: aline, col: acol, guard: fa_g, has_guard: fa_hg, alt_cont: false });
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  p = p.expect("}");
  let esugar: ast.MatchArm[] = [];
  if (arms_have_written_form(ewritten)) {
    esugar = ewritten;
  }
  if (arms_have_tuple_subpattern(arms)) {
    let ntval = "__nt" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let ntarms: ast.MatchArm[] = [];
    for nti in 0..arms.len() {
      let nta = arms[nti];
      ntarms = ntarms.append(ast.MatchArm { ...nta, body: value_arm_body(nta.body, ntval) });
    }
    return IfChain { par: p, stmt: s_match_sugared(sr_expr, desugar_nested_arms(ntarms, 0, ""), esugar, mkline, mkcol), rt: rt, needs_default_return: false, value_local: ntval, scrut_bind: [] };
  }
  if (arms_take_flag_chain(arms)) {
    let naval = "__na" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let naarms: ast.MatchArm[] = [];
    for nai in 0..arms.len() {
      let naa = arms[nai];
      naarms = naarms.append(ast.MatchArm { ...naa, body: value_arm_body(naa.body, naval) });
    }
    return IfChain { par: p, stmt: build_nested_arm_match(sr_expr, naarms, ewritten, mkline, mkcol), rt: rt, needs_default_return: false, value_local: naval, scrut_bind: [] };
  }
  arms = desugar_nested_arms(arms, 0, "");
  return IfChain { par: p, stmt: s_match_sugared(sr_expr, arms, esugar, mkline, mkcol), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
}

function arms_have_tuple_subpattern(arms: ast.MatchArm[]): boolean {
  for i in 0..arms.len() {
    match (arms[i].pattern) {
      ast.PatVariant(pv) => {
        if (pv.tup_kinds.len() > 0) {
          return true;
        }
      },
      ast.PatWildcard(w) => {},
      ast.PatLiteral(_) => {}
    }
  }
  return false;
}

function pipe_prepend(head: ast.Expr, tail: ast.Expr[]): ast.Expr[] {
  let out: ast.Expr[] = [head];
  for i in 0..tail.len() {
    out = out.append(tail[i]);
  }
  return out;
}

function pipe_is_hole(e: ast.Expr): boolean {
  match (named_marker_value(e)) {
    ast.ExprIdent(id) => {
      return id.name == "_";
    },
    _ => {
      return false;
    }
  }
}

function pipe_fill(e: ast.Expr, left: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      if (b.op == "__named_arg") {
        return ast.binary(b.op, b.left, left, b.line, b.col, b.ty);
      }
    },
    _ => {}
  }
  return left;
}

// The error for the second `_` of a piped call, or None.
function pipe_second_hole(right: ast.Expr): Option[ast.Expr] {
  if let ast.ExprCall(c) = right {
    let seen = false;
    for arg in c.args {
      if (pipe_is_hole(arg)) {
        if (seen) {
          let extra = named_marker_value(arg);
          return Some(e_unknown_at(coded_fault("P004", "at most one `_` placeholder in a piped call"), ast.expr_line(extra), ast.expr_col(extra)));
        }
        seen = true;
      }
    }
  }
  return None;
}

function pipe_desugar(left: ast.Expr, right: ast.Expr, line: i32, col: i32): ast.Expr {
  if let Some(fault) = pipe_second_hole(right) {
    return fault;
  }
  match (right) {
    ast.ExprCall(c) => {
      let hole: i32 = -1;
      for hi in 0..c.args.len() {
        if (pipe_is_hole(c.args[hi])) {
          hole = hi;
        }
      }
      if (hole >= 0) {
        let subst: ast.Expr[] = [];
        for si in 0..c.args.len() {
          if (si == hole) {
            subst = subst.append(pipe_fill(c.args[si], left));
          } else {
            subst = subst.append(c.args[si]);
          }
        }
        return e_call_at(c.callee, subst, c.line, c.col);
      }
      return e_call_at(c.callee, pipe_prepend(left, c.args), c.line, c.col);
    },
    _ => {
      let one: ast.Expr[] = [left];
      return e_call_at(right, one, line, col);
    }
  }
}

// A range names its module by import path, which no identifier can spell,
// so a local or a module called `iter` cannot capture it.
pub const RANGE_MODULE: string = "core/iter";

function parse_range(p: Par): (ast.Expr, Par) {
  let (left_expr, left_p) = parse_binary(p, 1);
  p = left_p;
  let pk = p.peek_punct();
  if (pk == ".." || pk == "..=") {
    let rline = p.peek_line();
    let rcol = p.peek_col();
    p = p.advance();
    let fn = "range";
    if (pk == "..=") {
      fn = "range_incl";
    }
    let (right_expr, right_p) = parse_binary(p, 1);
    p = right_p;
    let callee = e_field_access_at(e_ident_at(RANGE_MODULE, rline, rcol), fn, rline, rcol);
    let args: ast.Expr[] = [left_expr, right_expr];
    return (e_call(callee, args), p);
  }
  return (left_expr, p);
}

function parse_pipe(p: Par): (ast.Expr, Par) {
  let (left_expr, left_p) = parse_range(p);
  p = left_p;
  let acc = left_expr;
  while (p.peek_punct() == "|>") {
    let pipe_line = p.peek_line();
    let pipe_col = p.peek_col();
    p = p.advance();
    let (right_expr, right_p) = parse_range(p);
    p = right_p;
    if (p.verbatim) {
      acc = pipe_second_hole(right_expr).unwrap_or(e_binary("|>", acc, right_expr));
      continue;
    }
    acc = pipe_desugar(acc, right_expr, pipe_line, pipe_col);
  }
  return (acc, p);
}

function parse_paren_head(p: Par): (ast.Expr, Par) {
  let opened = p.peek_punct() == "(";
  let (e, ep) = parse_expr(p.expect("("));
  if (opened || ep.peek_punct() == ")") {
    return (e, ep.expect(")"));
  }
  return (e, ep);
}

function parse_let_else_tail(p: Par): (ast.Stmt[], ast.Stmt[], Par) {
  let else_body: ast.Stmt[] = [];
  let written = p.peek_keyword() == "else";
  p = p.expect("else");
  if (written || p.peek_punct() == "{") {
    let (eb, ep) = parse_block(p);
    else_body = eb;
    p = ep;
  }
  p = p.expect_semi();
  let rest: ast.Stmt[] = [];
  while (p.peek_punct() != "}" && !p.at_end()) {
    let (rs, rp) = parse_stmt(p);
    if (rp.pos == p.pos) {
      p = p.advance();
      continue;
    }
    p = rp;
    rest = rest.append(rs);
  }
  return (else_body, rest, p);
}

function parse_block(p: Par): (ast.Stmt[], Par) {
  if (p.peek_punct() != "{") {
    let f = missing_fault("{ in block");
    if (p.reported_at(p.peek_line(), p.peek_col())) {
      f = ast.fault_mark(REPORTED);
    }
    let miss: ast.Stmt[] = [s_unknown(p, f)];
    let open = p.skip_to_open();
    if (open.peek_punct() != "{") {
      return (miss, p);
    }
    let (skipped, sp) = parse_block(open);
    return (miss, sp);
  }
  p = p.advance();
  let (r_body, r_p) = parse_block_body(p, false);
  p = r_p;
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (r_body, p);
}

function parse_block_body(p: Par, tail_value: boolean): (ast.Stmt[], Par) {
  return parse_block_body_mode(p, tail_value, false, false);
}

function parse_block_body_mode(p: Par, tail_value: boolean, discard_tail: boolean, void_branches: boolean): (ast.Stmt[], Par) {
  if (p.too_deep_by(BLOCK_NEST_UNITS)) {
    return ([s_unknown_at(nest_fault(), p.peek_line(), p.peek_col())], p.bail());
  }
  let (g0, gq) = parse_block_body_nested(p.with_depth(p.depth + BLOCK_NEST_UNITS), tail_value, discard_tail, void_branches);
  return (g0, gq.with_depth(p.depth));
}

function parse_lambda_body(p: Par, void_branches: boolean): (ast.Stmt[], Par) {
  if (p.peek_punct() != "{") {
    return ([s_unknown(p, missing_fault("{ in lambda body"))], p);
  }
  p = p.advance();
  let (lb_body, lb_p) = parse_block_body_mode(p, true, false, void_branches);
  p = lb_p;
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (lb_body, p);
}

function parse_use_stmt(p: Par, body: ast.Stmt[]): (ast.Stmt[], Par) {
  let uline = p.peek_line();
  let ucol = p.peek_col();
  p = p.advance();
  let ubad: ast.Stmt[] = [];
  let uname = p.peek_ident();
  if (uname.len() > 0) {
    p = p.advance();
  } else {
    ubad = [s_unknown(p, parse_fault("expected a name, got " + tok_desc(p.peek())))];
  }
  let utype = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    let (utn_name, utn_fn_ret, utn_p) = parse_type_name(p);
    p = utn_p;
    utype = utn_name;
  }
  if (p.peek_punct() == "<") {
    p = p.advance();
  } else if (ubad.len() == 0) {
    ubad = [s_unknown(p, parse_fault("expected \"<\", got " + tok_desc(p.peek())))];
  }
  if (p.peek_punct() == "-") {
    p = p.advance();
  } else if (ubad.len() == 0) {
    ubad = [s_unknown(p, parse_fault("expected \"-\", got " + tok_desc(p.peek())))];
  }
  let (usrc_expr, usrc_p) = parse_expr(p);
  p = usrc_p;
  p = p.end_of(usrc_expr);
  let (rest_body, rest_p) = parse_block_body(p, false);
  p = rest_p;
  let cbparam = ast.ParamDecl { name: uname, type_name: utype, own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 };
  let cbparams: ast.ParamDecl[] = [cbparam];
  let cb: ast.Expr = ast.ExprLambda { params: cbparams, ret_own: false, ret_type: "", body: rest_body, use_infer: utype.len() == 0, origin: ORIGIN_USE, line: uline, col: ucol, captures: [], captures_known: false, ret_fn_ret: "", ret_fn_param_types: "", once: false };
  if (ubad.len() > 0) {
    return (body.append(ubad[0]), p);
  }
  match (usrc_expr) {
    ast.ExprCall(c) => {
      let newargs = c.args.append(cb);
      body = body.append(s_return_at(ast.ExprCall { ...c, args: newargs }, uline, ucol));
    },
    _ => {
      body = body.append(s_unknown_at(parse_fault("use expression must be a function call (so the callback can be appended as the last arg)"), uline, ucol));
    }
  }
  return (body, p);
}

function parse_block_body_nested(p: Par, tail_value: boolean, discard_tail: boolean, void_branches: boolean): (ast.Stmt[], Par) {
  let body: ast.Stmt[] = [];
  while (p.peek_punct() != "}" && !p.at_end()) {
    if (p.peek_keyword() == "use") {
      return parse_use_stmt(p, body);
    }
    if ((discard_tail || void_branches) && (p.peek_keyword() == "if" || p.peek_keyword() == "match")) {
      let (stmt, next) = parse_stmt(p);
      if (next.type_errs.len() == p.type_errs.len() && !stmts_have_parse_error([stmt])) {
        body = body.append(stmt);
        p = next;
        continue;
      }
    }
    if (tail_value) {
      let (vb_ok, vb_stmt, vb_p) = valueless_branch_tail(p);
      if (vb_ok) {
        p = vb_p;
        body = body.append(vb_stmt);
        continue;
      }
    }
    let (tail_item, tp) = tail_item_at(p, tail_value);
    p = tp;
    if (tail_item) {
      let (tv_expr, tv_p) = parse_expr(p);
      if ((tv_p.peek_punct() == "}" || discard_tail && (p.peek_keyword() == "if" || p.peek_keyword() == "match") && tv_p.peek_punct() == ";") && (!discard_tail || tv_p.type_errs.len() == p.type_errs.len())) {
        if (discard_tail) {
          body = body.append(s_expr(tv_expr));
        } else {
          body = body.append(s_return(tv_expr));
        }
        if (discard_tail && tv_p.peek_punct() == ";") {
          p = tv_p.advance();
          continue;
        }
        return (body, tv_p);
      }
    }
    let (r_stmt, r_p) = parse_stmt(p);
    if (r_p.pos == p.pos) {
      p = p.advance();
      continue;
    }
    p = r_p;
    body = body.append(r_stmt);
  }
  return (body, p);
}

function parse_block_or_stmt(p: Par): (ast.Stmt[], Par) {
  if (p.peek_punct() == "{") {
    return parse_block(p);
  }
  let (r_stmt, r_p) = parse_stmt(p);
  if (r_p.pos == p.pos) {
    let none: ast.Stmt[] = [s_unknown(p, missing_fault("statement in braceless body"))];
    return (none, p.advance());
  }
  let one: ast.Stmt[] = [r_stmt];
  return (one, r_p);
}

function parse_pattern(p: Par): (ast.Pattern, Par) {
  if (p.too_deep()) {
    return (p_wildcard(), p.bail());
  }
  let (g0, gq) = parse_pattern_nested(p.with_depth(p.depth + 1));
  return (g0, gq.with_depth(p.depth));
}

function parse_pattern_nested(p: Par): (ast.Pattern, Par) {
  let lit_cond = e_bool(true);
  let has_lit_cond = false;
  let tup_kinds: i32[] = [];
  let tup_binds: string[] = [];
  let tup_lits: ast.Expr[] = [];
  let tup_pats: ast.Pattern[] = [];
  let name = p.peek_ident();
  let at_binding = "";
  let at_line = p.peek_line();
  let at_col = p.peek_col();
  if (name.len() > 0 && name != "_" && p.peek2_punct() == "@") {
    at_binding = name;
    p = p.advance();
    p = p.advance();
    name = p.peek_ident();
  }
  if (name.len() == 0) {
    name = p.peek_keyword();
  }
  if (name == "_") {
    p = p.advance();
    if (at_binding.len() > 0) {
      p = p.refused_at(at_wildcard_fault(), at_line, at_col);
    }
    return (p_wildcard(), p);
  }
  if (p.peek_is_pat_literal()) {
    let (lo, hi, has_range, inclusive, next) = parse_lit_or_range(p);
    return (ast.PatLiteral { scalar_cells: [], lit: lo, range_hi: hi, has_range: has_range, range_inclusive: inclusive, at_binding: at_binding }, next);
  }
  if (name.len() == 0) {
    return (p_variant("", ""), p);
  }
  p = p.advance();
  let bare_name = true;
  while (p.peek_punct() == ".") {
    bare_name = false;
    p = p.advance();
    let seg = p.peek_ident();
    if (seg.len() == 0) {
      seg = p.peek_keyword();
    }
    if (seg.len() == 0) {
      break;
    }
    name = name + "." + seg;
    p = p.advance();
  }
  let binding = "";
  let extra_bindings: string[] = [];
  let nested: ast.Pattern[] = [];
  if (p.peek_punct() == "{") {
    return parse_record_variant_pattern(p, name, at_binding);
  }
  if (p.peek_punct() == "(") {
    bare_name = false;
    p = p.advance();
    let bn = 0;
    while (p.peek_punct() != ")" && !p.at_end()) {
      if (p.peek_ident().len() > 0
        && (p.peek2_punct() == "(" || p.peek2_punct() == "{" || p.peek2_punct() == "." || p.peek2_punct() == "@")) {
        let sub_line = p.peek_line();
        let sub_col = p.peek_col();
        let (sub_pat, sub_p) = parse_pattern(p);
        p = sub_p;
        let nslot = "__np" + dl_itoa(sub_line) + "_" + dl_itoa(sub_col) + "_" + dl_itoa(bn);
        if (bn == 0) {
          binding = nslot;
        } else {
          extra_bindings = extra_bindings.append(nslot);
        }
        while (nested.len() < bn) {
          nested = nested.append(p_wildcard());
        }
        nested = nested.append(sub_pat);
        bn += 1;
      } else if (bn == 0 && p.peek_punct() == "(") {
        let (tk, tb, tl, tpp, tp) = parse_tuple_arm_pattern(p);
        p = tp;
        tup_kinds = tk;
        tup_binds = tb;
        tup_lits = tl;
        tup_pats = tpp;
        binding = "__tupslot";
        bn += 1;
      } else if (p.peek_is_pat_literal()) {
        let lit_line = p.peek_line();
        let lit_col = p.peek_col();
        let (lit_expr, lit_p) = parse_binary(p, pattern_min_prec());
        p = lit_p;
        let slot = "__pl" + dl_itoa(lit_line) + "_" + dl_itoa(lit_col);
        if (bn == 0) {
          binding = slot;
        } else {
          extra_bindings = extra_bindings.append(slot);
        }
        let one = e_binary("==", e_ident(slot), lit_expr);
        let rng = p.peek_punct();
        if (rng == ".." || rng == "..=") {
          p = p.advance();
          let (hi_expr, hi_p) = parse_binary(p, pattern_min_prec());
          p = hi_p;
          let hi_op = "<";
          if (rng == "..=") {
            hi_op = "<=";
          }
          one = e_binary("&&", e_binary(">=", e_ident(slot), lit_expr), e_binary(hi_op, e_ident(slot), hi_expr));
        }
        if (has_lit_cond) {
          lit_cond = e_binary("&&", lit_cond, one);
        } else {
          lit_cond = one;
        }
        has_lit_cond = true;
        bn += 1;
      } else {
        let inner = p.peek_ident();
        if (inner.len() > 0) {
          if (bn == 0) {
            binding = inner;
          } else {
            extra_bindings = extra_bindings.append(inner);
          }
          bn += 1;
          p = p.advance();
        } else {
          p = p.advance();
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
      } else if (p.peek_punct() != ")") {
        p = p.expect(")");
        break;
      }
    }
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
    if (nested.len() > 0) {
      while (nested.len() < bn) {
        nested = nested.append(p_wildcard());
      }
    }
  }
  let no_fields: string[] = [];
  return (ast.PatVariant { scalar_cells: [], scalar_binding: false, bare_name: bare_name, type_name: name, binding: binding, extra_bindings: extra_bindings, nested: nested, at_binding: at_binding, field_names: no_fields, lit_cond: lit_cond, has_lit_cond: has_lit_cond, tup_kinds: tup_kinds, tup_binds: tup_binds, tup_lits: tup_lits, tup_pats: tup_pats, rest_written: false }, p);
}

function parse_record_variant_pattern(p: Par, name: string, at_binding: string): (ast.Pattern, Par) {
  let tag = dl_itoa(p.peek_line()) + "_" + dl_itoa(p.peek_col()) + "_";
  let (sap, sp) = parse_struct_arm_pattern(p);
  let slots: string[] = [];
  let nested: ast.Pattern[] = [];
  let any_nested = false;
  let lit_cond = e_bool(true);
  let has_lit_cond = false;
  for k in 0..sap.fields.len() {
    let slot = sap.binds[k];
    let sub = p_wildcard();
    if (sap.kinds[k] == 2) {
      slot = "__pl" + tag + dl_itoa(k);
      lit_cond = and_cond(lit_cond, has_lit_cond, e_binary("==", e_ident(slot), sap.lits[k]));
      has_lit_cond = true;
    } else if (sap.kinds[k] == 3) {
      slot = "__np" + tag + dl_itoa(k);
      sub = sap.pats[k];
      any_nested = true;
    }
    slots = slots.append(slot);
    nested = nested.append(sub);
  }
  if (!any_nested) {
    nested = [];
  }
  let (binding, extra) = split_payload_slots(slots);
  let no_tup_kinds: i32[] = [];
  let no_tup_binds: string[] = [];
  let no_tup_lits: ast.Expr[] = [];
  let no_tup_pats: ast.Pattern[] = [];
  return (ast.PatVariant { scalar_cells: [], scalar_binding: false, bare_name: false, type_name: name, binding: binding, extra_bindings: extra, nested: nested, at_binding: at_binding, field_names: sap.fields, lit_cond: lit_cond, has_lit_cond: has_lit_cond, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats, rest_written: sap.rest_written }, sp);
}

function and_cond(acc: ast.Expr, has_acc: boolean, one: ast.Expr): ast.Expr {
  if (has_acc) {
    return e_binary("&&", acc, one);
  }
  return one;
}

function split_payload_slots(slots: string[]): (string, string[]) {
  let extra: string[] = [];
  if (slots.len() == 0) {
    return ("", extra);
  }
  for k in 1..slots.len() {
    extra = extra.append(slots[k]);
  }
  return (slots[0], extra);
}

function prepend_stmt(s: ast.Stmt, body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  out = out.append(s);
  for i in 0..body.len() {
    out = out.append(body[i]);
  }
  return out;
}

pub function pv_tup(pat: ast.Pattern): (i32[], string[], ast.Expr[], ast.Pattern[]) {
  let no_k: i32[] = [];
  let no_b: string[] = [];
  let no_l: ast.Expr[] = [];
  let no_p: ast.Pattern[] = [];
  match (pat) {
    ast.PatVariant(v) => {
      return (v.tup_kinds, v.tup_binds, v.tup_lits, v.tup_pats);
    },
    ast.PatWildcard(w) => {
      return (no_k, no_b, no_l, no_p);
    },
    ast.PatLiteral(_) => {
      return (no_k, no_b, no_l, no_p);
    }
  }
}

function pv_name(pat: ast.Pattern): string {
  match (pat) {
    ast.PatVariant(v) => {
      return v.type_name;
    },
    ast.PatWildcard(w) => {
      return "";
    },
    ast.PatLiteral(_) => {
      return "";
    }
  }
}

function pattern_is_wildcard(pat: ast.Pattern): boolean {
  if let ast.PatWildcard(_) = pat {
    return true;
  }
  return false;
}

function pattern_needs_probe(pat: ast.Pattern): boolean {
  if let ast.PatLiteral(_) = pat {
    return true;
  }
  return pv_name(pat).len() > 0;
}

function arm_is_nested(arm: ast.MatchArm): boolean {
  match (arm.pattern) {
    ast.PatVariant(v) => {
      return v.nested.len() > 0 || v.tup_kinds.len() > 0;
    },
    ast.PatWildcard(w) => {
      return false;
    },
    ast.PatLiteral(_) => {
      return false;
    }
  }
}

function arms_take_flag_chain(arms: ast.MatchArm[]): boolean {
  let any_nested = false;
  for i in 0..arms.len() {
    match (arms[i].pattern) {
      ast.PatVariant(v) => {
        if (v.tup_kinds.len() > 0) {
          return false;
        }
        if (v.nested.len() > 0) {
          any_nested = true;
        }
      },
      ast.PatWildcard(w) => {},
      ast.PatLiteral(_) => {
        return false;
      }
    }
  }
  return any_nested;
}

function clear_nested_pat(pv: ast.PatVariant): ast.Pattern {
  let none: ast.Pattern[] = [];
  return ast.PatVariant { ...pv, nested: none };
}

pub function payload_binder(pv: ast.PatVariant, i: i32): string {
  if (i == 0) {
    return pv.binding;
  }
  if (i - 1 < pv.extra_bindings.len()) {
    return pv.extra_bindings[i - 1];
  }
  return "";
}

function record_binding_list(names: string[], line: i32, col: i32): string[] {
  let out: string[] = [];
  let i = 0;
  for name in names {
    out = out.append(discard_name(name, line, col, i));
    i += 1;
  }
  return out;
}

pub function lower_struct_record_match(m: ast.StmtMatch, value: string): ast.Stmt {
  let arms: ast.StructArm[] = [];
  let written = m.arms;
  if (m.sugar.len() > 0) {
    written = m.sugar;
  }
  for arm in written {
    let fields: string[] = [];
    let binds: string[] = [];
    let at = "";
    let name = "";
    let rest = false;
    let wild = true;
    let kinds: i32[] = [];
    let lits: ast.Expr[] = [];
    let pats: ast.Pattern[] = [];
    if let ast.PatVariant(pv) = arm.pattern {
      wild = false;
      fields = pv.field_names;
      name = pv.type_name;
      at = pv.at_binding;
      rest = pv.rest_written;
      for i in 0..fields.len() {
        let bind = payload_binder(pv, i);
        binds = binds.append(bind);
        let kind = 0;
        let lit = e_bool(true);
        let pat = p_wildcard();
        if let Some(found) = record_slot_literal(pv.lit_cond, bind) {
          kind = 2;
          lit = found;
        } else {
          if (i < pv.nested.len() && pattern_needs_probe(pv.nested[i])) {
            kind = 3;
            pat = pv.nested[i];
          }
        }
        kinds = kinds.append(kind);
        lits = lits.append(lit);
        pats = pats.append(pat);
      }
    }
    let body = arm.body;
    if (value.len() > 0) {
      body = value_arm_body(body, value);
    }
    arms = arms.append(ast.StructArm { is_wild: wild, type_name: name, binds: binds, fields: fields, field_kinds: kinds, field_lits: lits, field_pats: pats, at_binding: at, rest_written: rest, guard: arm.guard, has_guard: arm.has_guard, body: body, line: arm.line, col: arm.col });
  }
  return with_sugar_origin(build_struct_match_fields(m.scrutinee, arms, m.line, m.col, true), m.origin, m.else_chained);
}

function record_slot_literal(cond: ast.Expr, slot: string): Option[ast.Expr] {
  if let ast.ExprBinary(b) = cond {
    if (b.op == "&&") {
      if let Some(found) = record_slot_literal(b.left, slot) {
        return Some(found);
      }
      return record_slot_literal(b.right, slot);
    }
    if let ast.ExprIdent(id) = b.left {
      if (b.op == "==" && id.name == slot) {
        return Some(b.right);
      }
    }
  }
  return None;
}

pub function struct_record_source(st: ast.Stmt): Option[ast.StmtMatch] {
  if let ast.StmtMatch(m) = st {
    return Some(m);
  }
  if let ast.StmtIf(f) = st {
    let sg = f.sugar;
    if (sg.arms.len() > 0) {
      return Some(ast.StmtMatch { scrutinee: sg.scrut, arms: sg.arms, sugar: [], line: sg.line, col: sg.col, origin: sg.origin, else_chained: sg.else_chained, arms_open: sg.arms_open });
    }
  }
  return None;
}

pub function struct_record_value_body(m: ast.StmtMatch, rt: string): ast.Stmt[] {
  let value = "__sm" + dl_itoa(m.line) + "_" + dl_itoa(m.col) + "_r";
  return [s_var(value, "", zero_expr_for(rt)), lower_struct_record_match(m, value), s_return(e_ident(value))];
}

pub function struct_record_head(m: ast.StmtMatch): string {
  let name = "";
  for arm in m.arms {
    if let ast.PatVariant(pv) = arm.pattern {
      if (!is_record_pattern(pv) || name.len() > 0 && name != pv.type_name) {
        return "";
      }
      name = pv.type_name;
    }
  }
  return name;
}

function match_sub_pattern(path: ast.Stmt[], scrut: string, pat: ast.Pattern, line: i32, col: i32): ast.Stmt[] {
  let body = path;
  let flat = pat;
  let tuple_slot = false;
  match (pat) {
    ast.PatVariant(pv) => {
      if (pv.tup_kinds.len() > 0) {
        tuple_slot = true;
      } else {
        body = wrap_payload_pats(path, pv, line, col);
        flat = clear_nested_pat(pv);
      }
    },
    ast.PatWildcard(w) => {},
    ast.PatLiteral(_) => {}
  }
  let (mk_pat, mk_guard, mk_hg) = fold_lit_cond(flat, e_bool(true), false);
  let mk_arms: ast.MatchArm[] = [];
  mk_arms = mk_arms.append(ast.MatchArm { pattern: mk_pat, body: body, line: line, col: col, guard: mk_guard, has_guard: mk_hg, alt_cont: false });
  let mk_skip: ast.Stmt[] = [];
  mk_arms = mk_arms.append(ast.MatchArm { pattern: p_wildcard(), body: mk_skip, line: line, col: col, guard: e_bool(true), has_guard: false, alt_cont: false });
  if (tuple_slot) {
    mk_arms = desugar_nested_arms(mk_arms, 0, scrut);
  }
  return [s_match_origin(e_ident_at(scrut, line, col), mk_arms, line, col, ORIGIN_PATTERN_PROBE)];
}

function wrap_payload_pats(path: ast.Stmt[], pv: ast.PatVariant, line: i32, col: i32): ast.Stmt[] {
  let cur = path;
  let wi = pv.nested.len() - 1;
  while (wi >= 0) {
    if (pattern_needs_probe(pv.nested[wi])) {
      cur = match_sub_pattern(cur, payload_binder(pv, wi), pv.nested[wi], line, col);
    }
    wi -= 1;
  }
  return cur;
}

function build_nested_arm_match(scrut: ast.Expr, arms: ast.MatchArm[], written: ast.MatchArm[], mkline: i32, mkcol: i32): ast.Stmt {
  let base = "__na" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
  let sname = base + "_s";
  let done = base + "_d";
  let outer: ast.Stmt[] = [];
  outer = outer.append(s_var_at(sname, "", scrut, mkline, mkcol));
  outer = outer.append(s_var(done, "", e_bool(false)));
  for ai in 0..arms.len() {
    let a = arms[ai];
    let cond = done_flag_cond(done, ai == 0);
    let flagged: ast.Stmt[] = [];
    flagged = flagged.append(s_assign(done, e_bool(true)));
    for bi in 0..a.body.len() {
      flagged = flagged.append(a.body[bi]);
    }
    let inner: ast.Stmt[] = [];
    match (a.pattern) {
      ast.PatWildcard(w) => {
        if (a.has_guard) {
          cond = e_binary("&&", cond, a.guard);
        }
        inner = flagged;
      },
      ast.PatVariant(pv) => {
        let path = flagged;
        if (a.has_guard) {
          path = [s_if(a.guard, flagged, [])];
        }
        path = wrap_payload_pats(path, pv, a.line, a.col);
        let (fp, fg, fhg) = fold_lit_cond(clear_nested_pat(pv), e_bool(true), false);
        let marms: ast.MatchArm[] = [];
        marms = marms.append(ast.MatchArm { pattern: fp, body: path, line: a.line, col: a.col, guard: fg, has_guard: fhg, alt_cont: false });
        let skip: ast.Stmt[] = [];
        marms = marms.append(ast.MatchArm { pattern: p_wildcard(), body: skip, line: a.line, col: a.col, guard: e_bool(true), has_guard: false, alt_cont: false });
        inner = [s_match_origin(e_ident_at(sname, a.line, a.col), marms, a.line, a.col, ORIGIN_PATTERN_PROBE)];
      },
      ast.PatLiteral(_) => {
        let marms: ast.MatchArm[] = [
          ast.MatchArm { ...a, body: flagged },
          ast.MatchArm { pattern: p_wildcard(), body: [], line: a.line, col: a.col, guard: e_bool(true), has_guard: false, alt_cont: false },
        ];
        inner = [s_match_origin(e_ident_at(sname, a.line, a.col), marms, a.line, a.col, ORIGIN_PATTERN_PROBE)];
      }
    }
    outer = outer.append(s_if(cond, inner, []));
  }
  let sugar_arms = arms;
  if (written.len() > 0) {
    sugar_arms = written;
  }
  return s_if_match(outer, ast.MatchSugar { ...no_match_sugar(), scrut: scrut, arms: sugar_arms, line: mkline, col: mkcol });
}

function desugar_nested_arms(arms: ast.MatchArm[], depth: i32, tag: string): ast.MatchArm[] {
  let seen_nested = false;
  for s in 0..arms.len() {
    if (arm_is_nested(arms[s])) {
      seen_nested = true;
    }
  }
  if (!seen_nested) {
    return arms;
  }
  let fall: ast.Stmt[] = [];
  let has_fall = false;
  if (arms.len() > 0) {
    let last = arms[arms.len() - 1];
    if (pattern_is_wildcard(last.pattern) && !last.has_guard) {
      fall = last.body;
      has_fall = true;
    }
  }
  let out: ast.MatchArm[] = [];
  let i = 0;
  while (i < arms.len()) {
    let vn = pv_name(arms[i].pattern);
    if (vn == "") {
      out = out.append(arms[i]);
      i += 1;
    } else {
      let j = i;
      while (j < arms.len() && pv_name(arms[j].pattern) == vn) {
        j += 1;
      }
      let any_nested = false;
      for k in i..j {
        if (arm_is_nested(arms[k])) {
          any_nested = true;
        }
      }
      if (!any_nested) {
        for c in i..j {
          out = out.append(arms[c]);
        }
      } else {
        out = out.append(build_merged_arm(vn, arms, i, j, fall, has_fall, depth, tag));
      }
      i = j;
    }
  }
  return out;
}

function group_has_tuple(arms: ast.MatchArm[], lo: i32, hi: i32): boolean {
  for i in lo..hi {
    match (arms[i].pattern) {
      ast.PatVariant(v) => {
        if (v.tup_kinds.len() > 0) {
          return true;
        }
      },
      ast.PatWildcard(w) => {},
      ast.PatLiteral(_) => {}
    }
  }
  return false;
}

function tuple_elems_irrefutable(kinds: i32[], pats: ast.Pattern[]): boolean {
  for i in 0..kinds.len() {
    if (kinds[i] == 2 || kinds[i] == 3) {
      return false;
    }
    if (kinds[i] == 4) {
      let (nk, nb, nl, np) = pv_tup(pats[i]);
      if (!tuple_elems_irrefutable(nk, np)) {
        return false;
      }
    }
  }
  return true;
}

function build_merged_arm(vn: string, arms: ast.MatchArm[], lo: i32, hi: i32, fall: ast.Stmt[], has_fall: boolean, depth: i32, tag: string): ast.MatchArm {
  let gp_line = arms[lo].line;
  let gp_col = arms[lo].col;
  let tmp = "__nest_" + util.i32_to_string(gp_line) + "_" + util.i32_to_string(gp_col) + "_" + util.i32_to_string(depth) + tag;
  let inner: ast.MatchArm[] = [];
  let has_inner_wild = false;
  for k in lo..hi {
    let g = arms[k];
    let inner_pat = p_wildcard();
    let inner_body = g.body;
    if let ast.PatVariant(gv) = g.pattern {
      if (gv.nested.len() > 0) {
        inner_pat = gv.nested[0];
      } else if (gv.binding.len() > 0 && gv.binding != "_") {
        inner_body = prepend_stmt(as_header(s_var(gv.binding, "", e_ident(tmp))), g.body);
      }
    }
    if (pattern_is_wildcard(inner_pat) && !g.has_guard) {
      has_inner_wild = true;
    }
    let (fn_pat, fn_g, fn_hg) = fold_lit_cond(inner_pat, g.guard, g.has_guard);
    inner = inner.append(ast.MatchArm { pattern: fn_pat, body: inner_body, line: g.line, col: g.col, guard: fn_g, has_guard: fn_hg, alt_cont: false });
  }
  if (!has_inner_wild && has_fall) {
    inner = inner.append(ast.MatchArm { pattern: p_wildcard(), body: fall, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false, alt_cont: false });
  }
  if (group_has_tuple(arms, lo, hi)) {
    let tarms: ast.TupArm[] = [];
    let no_k: i32[] = [];
    let no_p: ast.Pattern[] = [];
    let no_b: string[] = [];
    let no_l: ast.Expr[] = [];
    let tuple_covers = false;
    for q in lo..hi {
      let ga = arms[q];
      if let ast.PatVariant(gv2) = ga.pattern {
        if (gv2.tup_kinds.len() > 0) {
          if (!ga.has_guard && tuple_elems_irrefutable(gv2.tup_kinds, gv2.tup_pats)) {
            tuple_covers = true;
          }
          tarms = tarms.append(ast.TupArm { is_wild: false, elem_kinds: gv2.tup_kinds, binds: gv2.tup_binds, lits: gv2.tup_lits, elem_pats: gv2.tup_pats, at_binding: "", guard: ga.guard, has_guard: ga.has_guard, body: ga.body, line: ga.line, col: ga.col, alt_cont: false });
        } else {
          let b2 = ga.body;
          if (gv2.binding.len() > 0 && gv2.binding != "_") {
            b2 = prepend_stmt(as_header(s_var(gv2.binding, "", e_ident(tmp))), ga.body);
          }
          if (!ga.has_guard) {
            tuple_covers = true;
          }
          tarms = tarms.append(ast.TupArm { is_wild: true, elem_kinds: no_k, binds: no_b, lits: no_l, elem_pats: no_p, at_binding: "", guard: ga.guard, has_guard: ga.has_guard, body: b2, line: ga.line, col: ga.col, alt_cont: false });
        }
      }
    }
    if (!tuple_covers && has_fall) {
      tarms = tarms.append(ast.TupArm { is_wild: true, elem_kinds: no_k, binds: no_b, lits: no_l, elem_pats: no_p, at_binding: "", guard: e_bool(true), has_guard: false, body: fall, line: gp_line, col: gp_col, alt_cont: false });
    }
    let tmatch = with_sugar_origin(build_tuple_match(e_ident(tmp), tarms, gp_line, gp_col), ORIGIN_PATTERN_PROBE, false);
    let t_no_extra: string[] = [];
    let t_no_nested: ast.Pattern[] = [];
    let t_nk: i32[] = [];
    let t_nb: string[] = [];
    let t_nl: ast.Expr[] = [];
    let t_np: ast.Pattern[] = [];
    let t_merged: ast.Pattern = ast.PatVariant { scalar_cells: [], scalar_binding: false, bare_name: false, type_name: vn, binding: tmp, extra_bindings: t_no_extra, nested: t_no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: t_nk, tup_binds: t_nb, tup_lits: t_nl, tup_pats: t_np, rest_written: false };
    let t_body: ast.Stmt[] = [tmatch];
    return ast.MatchArm { pattern: t_merged, body: t_body, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false, alt_cont: false };
  }
  let inner_desugared = desugar_nested_arms(inner, depth + 1, tag);
  let inner_match = s_match_at(e_ident(tmp), inner_desugared, gp_line, gp_col);
  let no_extra: string[] = [];
  let no_nested: ast.Pattern[] = [];
  let no_tup_kinds: i32[] = [];
  let no_tup_binds: string[] = [];
  let no_tup_lits: ast.Expr[] = [];
  let no_tup_pats: ast.Pattern[] = [];
  let merged_pat: ast.Pattern = ast.PatVariant { scalar_cells: [], scalar_binding: false, bare_name: false, type_name: vn, binding: tmp, extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats, rest_written: false };
  let body: ast.Stmt[] = [inner_match];
  return ast.MatchArm { pattern: merged_pat, body: body, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false, alt_cont: false };
}

function stmts_have_parse_error(body: ast.Stmt[]): boolean {
  let errors: string[] = [];
  for stmt in body {
    errors = astwalk.fold_stmt_spine(stmt, errors, collect_parse_error);
  }
  return errors.len() > 0;
}

function collect_parse_error(stmt: ast.Stmt, own errors: string[]): string[] {
  if let ast.StmtUnknown(u) = stmt {
    return errors.append(u.fault.message);
  }
  return errors;
}

// An unbraced arm that starts with `if` or `match` is that statement, the
// same as the braced arm.
function parse_match_stmt_body(p: Par): (ast.Stmt[], Par) {
  if (p.peek_keyword() == "if" || p.peek_keyword() == "match") {
    let (stmt, next) = parse_stmt(p);
    if (next.type_errs.len() == p.type_errs.len() && !stmts_have_parse_error([stmt])) {
      return ([stmt], next);
    }
  }
  if (p.peek_punct() != "{") {
    let (expr, next) = parse_expr(p);
    return ([s_expr(expr)], next);
  }
  let (body, next) = parse_block_body_mode(p.advance(), true, true, false);
  return (body, next.expect("}"));
}

// parse_match_stmt reads a statement match with comma-separated arms.
// Each arm has a bare expression or a block body.
function parse_literal_match_stmt(p: Par, sr_expr: ast.Expr, mkline: i32, mkcol: i32): (ast.Stmt, Par) {
  let lit_arms: ast.LitArm[] = [];
  let patterns: ast.Pattern[] = [];
  let preserve_patterns = false;
  while (p.peek_punct() != "}" && !p.at_end()) {
    let laline = p.peek_line();
    let lacol = p.peek_col();
    let lwild = false;
    let lpattern = p_wildcard();
    let pattern_start = p;
    let (lat, lat_p) = take_at_binding(p);
    p = lat_p;
    let lalt_lits: ast.Expr[] = [];
    let lalt_his: ast.Expr[] = [];
    let lalt_hrs: boolean[] = [];
    let lalt_incs: boolean[] = [];
    if (p.peek_is_pat_literal()) {
      let (la_lits, la_his, la_hrs, la_incs, la_p) = parse_lit_alts(p);
      p = la_p;
      lalt_lits = la_lits;
      lalt_his = la_his;
      lalt_hrs = la_hrs;
      lalt_incs = la_incs;
    } else {
      let (lpr_pattern, lpr_p) = parse_pattern(pattern_start);
      p = lpr_p;
      lwild = true;
      lpattern = lpr_pattern;
      if let ast.PatWildcard(_) = lpattern {} else {
        preserve_patterns = true;
      }
    }
    let lguard = e_bool(true);
    let lhas_guard = false;
    if (p.peek_keyword() == "when") {
      p = p.advance();
      let (lgr_expr, lgr_p) = parse_expr(p);
      p = lgr_p;
      lguard = lgr_expr;
      lhas_guard = true;
    }
    p = p.expect("=>");
    let (lbb_body, lbb_p) = parse_match_stmt_body(p);
    p = lbb_p;
    if (lwild) {
      lit_arms = lit_arms.append(ast.LitArm { is_wild: true, lit: e_bool(true), guard: lguard, has_guard: lhas_guard, body: lbb_body, line: laline, col: lacol, range_hi: e_bool(true), has_range: false, range_inclusive: false, alt_cont: false, at_binding: "" });
      patterns = patterns.append(lpattern);
    } else {
      let lai = 0;
      let alt_at = lat;
      while (lai < lalt_lits.len()) {
        lit_arms = lit_arms.append(ast.LitArm { is_wild: false, lit: lalt_lits[lai], guard: lguard, has_guard: lhas_guard, body: lbb_body, line: laline, col: lacol, range_hi: lalt_his[lai], has_range: lalt_hrs[lai], range_inclusive: lalt_incs[lai], alt_cont: lai > 0, at_binding: alt_at });
        alt_at = "";
        patterns = patterns.append(literal_pattern(lit_arms[lit_arms.len() - 1]));
        lai += 1;
      }
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  p = p.expect("}");
  if (preserve_patterns) {
    return (literal_pattern_match(sr_expr, lit_arms, patterns, mkline, mkcol), p);
  }
  return (build_literal_match(sr_expr, lit_arms, mkline, mkcol), p);
}

function parse_match_stmt(p: Par): (ast.Stmt, Par) {
  let mkline = p.peek_line();
  let mkcol = p.peek_col();
  let (sr_expr, sr_p) = parse_paren_head(p.advance());
  p = sr_p.expect("{");
  if (p.peek_punct() == "(" || p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek_punct_at(1) == "@" && p.peek_punct_at(2) == "(") {
    let tarms: ast.TupArm[] = [];
    while (p.peek_punct() != "}" && !p.at_end()) {
      let taline = p.peek_line();
      let tacol = p.peek_col();
      let t_wild = false;
      let t_empty_body: ast.Stmt[] = [];
      let t_at = "";
      if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
        t_at = p.peek_ident();
        p = p.advance();
        p = p.advance();
      }
      let tpats: ast.TupArm[] = [];
      if (p.peek_punct() == "(") {
        let (tpr_elem_kinds, tpr_binds, tpr_lits, tpr_pats, tpr_p) = parse_tuple_arm_pattern(p);
        p = tpr_p;
        if (tpr_elem_kinds.len() == 0) {
          return (s_unknown(p, parse_fault("expected a tuple pattern")), p);
        }
        tpats = tpats.append(ast.TupArm { is_wild: false, elem_kinds: tpr_elem_kinds, binds: tpr_binds, lits: tpr_lits, elem_pats: tpr_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: t_empty_body, line: taline, col: tacol, alt_cont: false });
        while (p.peek_punct() == "|") {
          p = p.advance();
          let (tor_kinds, tor_binds, tor_lits, tor_pats, tor_p) = parse_tuple_arm_pattern(p);
          p = tor_p;
          if (tor_kinds.len() == 0) {
            return (s_unknown(p, parse_fault("expected a tuple pattern")), p);
          }
          tpats = tpats.append(ast.TupArm { is_wild: false, elem_kinds: tor_kinds, binds: tor_binds, lits: tor_lits, elem_pats: tor_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: t_empty_body, line: taline, col: tacol, alt_cont: false });
        }
      } else {
        let (twp_pattern, twp_p) = parse_pattern(p);
        p = twp_p;
        if let Some(kind) = non_tuple_arm_error(twp_pattern, t_at) {
          p = p.refused_at(kind, taline, tacol);
        }
        t_wild = true;
      }
      let t_guard = e_bool(true);
      let t_has_guard = false;
      if (p.peek_keyword() == "when") {
        p = p.advance();
        let (tgr_expr, tgr_p) = parse_expr(p);
        p = tgr_p;
        t_guard = tgr_expr;
        t_has_guard = true;
      }
      p = p.expect("=>");
      let (tbb_body, tbb_p) = parse_match_stmt_body(p);
      p = tbb_p;
      if (t_wild) {
        let tw_kinds: i32[] = [];
        let tw_pats: ast.Pattern[] = [];
        let tw_binds: string[] = [];
        let tw_lits: ast.Expr[] = [];
        tarms = tarms.append(ast.TupArm { is_wild: true, elem_kinds: tw_kinds, binds: tw_binds, lits: tw_lits, elem_pats: tw_pats, at_binding: "", guard: t_guard, has_guard: t_has_guard, body: tbb_body, line: taline, col: tacol, alt_cont: false });
      } else {
        for talt in 0..tpats.len() {
          let tpa = tpats[talt];
          tarms = tarms.append(ast.TupArm { is_wild: false, elem_kinds: tpa.elem_kinds, binds: tpa.binds, lits: tpa.lits, elem_pats: tpa.elem_pats, at_binding: t_at, guard: t_guard, has_guard: t_has_guard, body: tbb_body, line: taline, col: tacol, alt_cont: talt > 0 });
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
        continue;
      }
      break;
    }
    p = p.expect("}");
    return (build_tuple_match(sr_expr, tarms, mkline, mkcol), p);
  }
  if (at_local_struct_pattern(p)) {
    let (smarms, smrt, smok, smp) = parse_struct_match_arms(p, false);
    p = smp;
    if (!smok) {
      return (s_unknown(p, parse_fault("a struct pattern binds field names")), p);
    }
    return (build_struct_match(sr_expr, smarms, mkline, mkcol), p);
  }
  if (p.peek_is_pat_literal() || p.peek_at_literal()) {
    return parse_literal_match_stmt(p, sr_expr, mkline, mkcol);
  }
  let arms: ast.MatchArm[] = [];
  let written: ast.MatchArm[] = [];
  while (p.peek_punct() != "}" && !p.at_end()) {
    let aline = p.peek_line();
    let acol = p.peek_col();
    let (pr_pattern, pr_p) = parse_pattern(p);
    p = pr_p;
    let pats: ast.Pattern[] = [pr_pattern];
    while (p.peek_punct() == "|") {
      p = p.advance();
      let (pr2_pattern, pr2_p) = parse_pattern(p);
      p = pr2_p;
      pats = pats.append(pr2_pattern);
    }
    let arm_guard = e_bool(true);
    let arm_has_guard = false;
    if (p.peek_keyword() == "when") {
      p = p.advance();
      let (gr_expr, gr_p) = parse_expr(p);
      p = gr_p;
      arm_guard = gr_expr;
      arm_has_guard = true;
    }
    p = p.expect("=>");
    let (bb_body, bb_p) = parse_match_stmt_body(p);
    p = bb_p;
    for pi in 0..pats.len() {
      written = written.append(ast.MatchArm { pattern: pats[pi], body: bb_body, line: aline, col: acol, guard: arm_guard, has_guard: arm_has_guard, alt_cont: pi > 0 });
      let (fs_pat, fs_g, fs_hg) = fold_lit_cond(pats[pi], arm_guard, arm_has_guard);
      arms = arms.append(ast.MatchArm { pattern: fs_pat, body: bb_body, line: aline, col: acol, guard: fs_g, has_guard: fs_hg, alt_cont: false });
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  p = p.expect("}");
  let sugar: ast.MatchArm[] = [];
  if (arms_have_written_form(written)) {
    sugar = written;
  }
  if (arms_take_flag_chain(arms)) {
    return (build_nested_arm_match(sr_expr, arms, written, mkline, mkcol), p);
  }
  arms = desugar_nested_arms(arms, 0, "");
  return (s_match_sugared(sr_expr, arms, sugar, mkline, mkcol), p);
}

function arms_have_written_form(written: ast.MatchArm[]): boolean {
  for i in 0..written.len() {
    if (written[i].alt_cont) {
      return true;
    }
    match (written[i].pattern) {
      ast.PatVariant(v) => {
        if (v.nested.len() > 0 || v.has_lit_cond || v.tup_kinds.len() > 0) {
          return true;
        }
      },
      ast.PatWildcard(w) => {},
      ast.PatLiteral(_) => {
        return true;
      }
    }
  }
  return false;
}

function mentions_name(e: ast.Expr, name: string, hit: boolean): boolean {
  if (hit) {
    return true;
  }
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == name;
    },
    _ => {
      return false;
    }
  }
}

pub function stmt_mentions(st: ast.Stmt, name: string): boolean {
  function visit(n: ast.Expr, own a: boolean): boolean {
    return mentions_name(n, name, a);
  }
  return astwalk.fold_stmt(st, false, visit);
}

pub function stmts_mention(stmts: ast.Stmt[], name: string): boolean {
  for st in stmts {
    if (stmt_mentions(st, name)) {
      return true;
    }
  }
  return false;
}

function parse_loop_stmt(p: Par): (ast.Stmt, Par) {
  let p2 = p.advance();
  let (lb_body, lb_p) = parse_block(p2);
  return (ast.StmtWhile { cond: e_bool(true), body: lb_body, label: "", line: 0, is_loop: true }, lb_p);
}

function parse_for_stmt(p: Par): (ast.Stmt, Par) {
  let for_col = p.peek_col();
  p = p.advance();
  if (p.peek_punct() == "(") {
    let cfl = p.peek_line();
    let cfc = p.peek_col();
    let kv_open = p;
    p = p.advance();
    let is_cfor = !kv_open.paren_then_in();
    if (is_cfor) {
      let initstmts: ast.Stmt[] = [];
      let init_head = p.advance();
      if (p.peek_punct() == ";") {
        p = p.advance();
      } else if (p.peek_keyword() == "let" && init_head.peek_ident().len() == 0 && init_head.peek_punct() != "(") {
        let bad_head = s_unknown(init_head, decl_fault("expected a name, got " + tok_desc(init_head.peek())));
        let (bh_body, bh_p) = parse_block(init_head.skip_to_close(")"));
        return (bad_head, bh_p);
      } else {
        let (fcinit_stmt, fcinit_p) = parse_stmt(p);
        p = fcinit_p;
        initstmts = [fcinit_stmt];
      }
      let condexpr = e_bool(true);
      if (p.peek_punct() != ";") {
        let (fccond_expr, fccond_p) = parse_expr(p);
        p = fccond_p;
        condexpr = fccond_expr;
      }
      p = p.expect_semi();
      let stepone: ast.Stmt[] = [];
      if (p.peek_punct() != ")") {
        let (fcstep_stmt, fcstep_p) = parse_stmt(p);
        p = fcstep_p;
        stepone = [fcstep_stmt];
      }
      p = p.expect(")");
      let (fcbody_body, fcbody_p) = parse_block(p);
      p = fcbody_p;
      let flag = "__forc_" + util.i32_to_string(cfl) + "_" + util.i32_to_string(cfc);
      let noelse: ast.Stmt[] = [];
      let wbody: ast.Stmt[] = [];
      wbody = wbody.append(s_if(e_unary("!", e_ident(flag)), stepone, noelse));
      wbody = wbody.append(s_assign(flag, e_bool(false)));
      let breakone: ast.Stmt[] = [s_break()];
      wbody = wbody.append(s_if(e_unary("!", condexpr), breakone, noelse));
      let fbi = 0;
      while (fbi < fcbody_body.len()) {
        wbody = wbody.append(fcbody_body[fbi]);
        fbi += 1;
      }
      let outer: ast.Stmt[] = [];
      for ini in 0..initstmts.len() {
        outer = outer.append(initstmts[ini]);
      }
      outer = outer.append(s_var(flag, "", e_bool(true)));
      outer = outer.append(s_while(e_bool(true), wbody));
      return (s_if(e_bool(true), outer, noelse), p);
    }
    let (kvdestr, kvcount, kvok, kvnames_p) = parse_destructure_names(kv_open);
    p = kvnames_p;
    if (!kvok || kvcount < 2) {
      return for_refused(p, parse_fault("for pattern needs at least 2 binders"));
    }
    if (p.peek_ident() != "in") {
      return for_refused(p, missing_fault("`in` in for"));
    }
    p = p.advance();
    let kv_saved = p.no_struct;
    let (kvi_expr, kvi_p) = parse_expr(p.with_no_struct(true));
    p = kvi_p.with_no_struct(kv_saved);
    let (kvb_body, kvb_p) = parse_block(p);
    p = kvb_p;
    return (ast.StmtFor { var_name: "", iter: kvi_expr, body: kvb_body, label: "", line: 0, col: for_col, destr: kvdestr }, p);
  }
  let fpre: ast.Stmt[] = [];
  let fvar = "";
  if (at_pattern_head(p)) {
    let fp_line = p.peek_line();
    let fp_col = p.peek_col();
    let fp_at = "";
    if (p.peek_punct_at(1) == "@") {
      fp_at = p.peek_ident();
      p = p.advance();
      p = p.advance();
    }
    let fp_elem = "$forpat_" + util.i32_to_string(fp_line) + "_" + util.i32_to_string(fp_col);
    let fp_init = e_ident_at(fp_elem, fp_line, fp_col);
    if (p.peek_punct() == "(") {
      let (fpdestr, fpcount, fpok, fpnames_p) = parse_destructure_names(p);
      p = fpnames_p;
      if (!fpok || fpcount < 2) {
        return for_refused(p, parse_fault("for pattern needs at least 2 binders"));
      }
      fpre = [as_header(s_destr_at(ast.Destr { ...fpdestr, at: fp_at }, fp_init, fp_line, fp_col))];
    } else {
      let (fp_struct, fp_head) = parse_record_pattern_head(p);
      p = fp_head;
      let (fpbinds, fpfields, fpfields_rest, fpfields_ok, fpfields_p) = parse_struct_pattern_fields(p);
      p = fpfields_p;
      if (!fpfields_ok || fpbinds.len() == 0) {
        return (s_unknown(p, parse_fault("a struct destructuring pattern binds field names")), p);
      }
      fpre = [as_header(s_destr_at(record_pattern(fp_struct, fpbinds, fpfields, fp_at, fpfields_rest), fp_init, fp_line, fp_col))];
    }
    fvar = fp_elem;
  } else {
    fvar = p.peek_ident();
    if (fvar.len() == 0) {
      return for_refused(p, missing_fault("for-let name"));
    }
    p = p.advance();
  }
  if (p.peek_ident() != "in") {
    return for_refused(p, missing_fault("`in` in for"));
  }
  p = p.advance();
  let f_saved = p.no_struct;
  let (fiter_expr, fiter_p) = parse_binary(p.with_no_struct(true), 1);
  p = fiter_p.with_no_struct(f_saved);
  let iter_expr = fiter_expr;
  let range_punct = p.peek_punct();
  if (range_punct == ".." || range_punct == "..=") {
    p = p.advance();
    let hi_saved = p.no_struct;
    let (fhi_expr, fhi_p) = parse_binary(p.with_no_struct(true), 1);
    p = fhi_p.with_no_struct(hi_saved);
    let rargs: ast.Expr[] = [fiter_expr, fhi_expr];
    let range_fn = "__range";
    if (range_punct == "..=") {
      range_fn = "__range_incl";
    }
    iter_expr = e_call(e_ident(range_fn), rargs);
  }
  let (fb_body, fb_p) = parse_block(p);
  p = fb_p;
  for fbi in 0..fb_body.len() {
    fpre = fpre.append(fb_body[fbi]);
  }
  return (ast.StmtFor { var_name: fvar, iter: iter_expr, body: fpre, label: "", line: 0, col: for_col, destr: ast.no_destr() }, p);
}

function for_refused(p: Par, f: ast.Fault): (ast.Stmt, Par) {
  let open = p.skip_to_open();
  if (open.peek_punct() != "{") {
    return (s_unknown(p, f), p);
  }
  let (skipped, sp) = parse_block(open);
  return (s_unknown(p, f), sp);
}

function with_stmt_line(st: ast.Stmt, line: i32): ast.Stmt {
  match (st) {
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, line: line };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, line: line };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: w.cond, body: w.body, label: w.label, line: line, is_loop: w.is_loop };
    },
    ast.StmtFor(fo) => {
      return ast.StmtFor { var_name: fo.var_name, iter: fo.iter, body: fo.body, label: fo.label, line: line, col: fo.col, destr: fo.destr };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: d.action, on_error: d.on_error, line: line };
    },
    _ => {
      return st;
    }
  }
}

function parse_stmt(p: Par): (ast.Stmt, Par) {
  if (p.too_deep()) {
    return (s_unknown_at(nest_fault(), p.peek_line(), p.peek_col()), p.bail());
  }
  let (g0, gq) = parse_stmt_nested(p.with_depth(p.depth + 1));
  return (g0, gq.with_depth(p.depth));
}

function parse_stmt_nested(p: Par): (ast.Stmt, Par) {
  let stmt_line = p.peek_line();
  let (parsed, after) = parse_stmt_at(p);
  return (with_stmt_line(parsed, stmt_line), after);
}

function parse_let_pattern(p: Par, start: Par, qualified_record: boolean, vline: i32, vcol: i32): (ast.Stmt, Par) {
  let (lsp_pat, lsp_p) = parse_pattern(start);
  let lsp_pats: ast.Pattern[] = [lsp_pat];
  while (lsp_p.peek_punct() == "|") {
    lsp_p = lsp_p.advance();
    let (lsp_alt, lsp_ap) = parse_pattern(lsp_p);
    lsp_p = lsp_ap;
    lsp_pats = lsp_pats.append(lsp_alt);
  }
  let (lsp_init, lsp_ip) = parse_expr(lsp_p.expect("=").with_no_struct(false));
  lsp_ip = lsp_ip.with_no_struct(p.no_struct);
  if (qualified_record && lsp_pats.len() == 1 && lsp_ip.peek_keyword() != "else") {
    let binding = qualified_struct_binding(lsp_pat, lsp_init, vline, vcol);
    return (binding, lsp_ip.end_of(lsp_init));
  }
  let (lsp_else, lsp_rest, lsp_restp) = parse_let_else_tail(lsp_ip);
  p = lsp_restp;
  let lsp_arms: ast.MatchArm[] = [];
  let lsp_written: ast.MatchArm[] = [];
  for lsp_i in 0..lsp_pats.len() {
    lsp_written = lsp_written.append(ast.MatchArm { pattern: lsp_pats[lsp_i], body: lsp_rest, line: vline, col: vcol, guard: e_bool(true), has_guard: false, alt_cont: lsp_i > 0 });
    let (fl_pat, fl_g, fl_hg) = fold_lit_cond(lsp_pats[lsp_i], e_bool(true), false);
    lsp_arms = lsp_arms.append(ast.MatchArm { pattern: fl_pat, body: lsp_rest, line: vline, col: vcol, guard: fl_g, has_guard: fl_hg, alt_cont: false });
  }
  let lsp_wild = ast.MatchArm { pattern: p_wildcard(), body: lsp_else, line: vline, col: vcol, guard: e_bool(true), has_guard: false, alt_cont: false };
  lsp_arms = lsp_arms.append(lsp_wild);
  lsp_written = lsp_written.append(lsp_wild);
  if (arms_take_flag_chain(lsp_arms)) {
    return (with_sugar_origin(build_nested_arm_match(lsp_init, lsp_arms, lsp_written, vline, vcol), "let_else", false), p);
  }
  lsp_arms = desugar_nested_arms(lsp_arms, 0, "");
  let lsp_sugar: ast.MatchArm[] = [];
  if (arms_have_written_form(lsp_written)) {
    lsp_sugar = lsp_written;
  }
  return (s_match_origin_sugared(lsp_init, lsp_arms, lsp_sugar, vline, vcol, "let_else"), p);
}

function parse_let_value(p: Par, name: string, vline: i32, vcol: i32): (ast.Stmt, Par) {
  let type_name = "";
  let v_fn_ret = "";
  let v_fn_ptys = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    let (vtr, vtr_p) = parse_decl_type(p);
    p = vtr_p;
    type_name = vtr.name;
    v_fn_ret = vtr.fn_ret;
    v_fn_ptys = vtr.fn_params;
  }
  if (p.peek_punct() != "=") {
    return (s_unknown(p, missing_fault("= in let")), p);
  }
  p = p.advance();
  let (init_expr, init_p) = parse_expr(p.with_map_kind(map_ann_key_kind(type_name)));
  p = init_p.with_map_kind(-1);
  if (p.peek_keyword() == "else") {
    return (decl_sentinel(p, "`let " + name + "` always binds, so it takes no `else`; a pattern that can miss goes after `let`, e.g. `let Some(" + name + ") = …`"), p);
  }
  p = p.end_of(init_expr);
  if (!p.verbatim) {
    init_expr = stamp_lambda_ret(init_expr, v_fn_ret);
    init_expr = stamp_value_block_ret(init_expr, type_name);
  }
  return (ast.StmtVar { name: discard_name(name, vline, vcol, 0), type_name: type_name, init: init_expr, line: vline, col: vcol, fn_ret: v_fn_ret, fn_param_types: v_fn_ptys, destr: ast.no_destr(), header: false }, p);
}

function parse_let_stmt(p: Par): (ast.Stmt, Par) {
  let vline = p.peek_line();
  let vcol = p.peek_col();
  p = p.advance();
  let at_bind = "";
  let pattern_start = p;
  let qualified_record = qualified_record_pattern_ahead(p);
  if (p.peek_punct_at(1) == "@" && at_pattern_head(p) && !qualified_record) {
    at_bind = p.peek_ident();
    p = p.advance();
    p = p.advance();
  }
  if (p.peek_punct() == "(") {
    let tuple_start = p;
    let (tddestr, tdcount, tdok, tdp) = parse_destructure_names(p);
    p = tdp;
    if (!tdok) {
      if (let_else_ahead(pattern_start)) {
        return parse_let_tuple_else(pattern_start, vline, vcol);
      }
      let problem = s_unknown_at(decl_fault(refutable_tuple_message(tuple_start, "destructuring binding")), vline, vcol);
      p = tuple_start.advance().skip_to_close(")").expect("=");
      let (ignored, recovered) = parse_expr(p);
      return (problem, recovered.end_of(ignored));
    }
    if (tdcount < 2) {
      return (s_unknown(p, parse_fault("a tuple destructuring pattern binds names, not literals")), p);
    }
    p = p.expect("=");
    let (tdinit_expr, tdinit_p) = parse_expr(p);
    p = tdinit_p;
    p = p.end_of(tdinit_expr);
    return (s_destr_at(ast.Destr { ...tddestr, at: at_bind }, tdinit_expr, vline, vcol), p);
  }
  if (p.peek_let_literal() || p.peek_at_literal()) {
    let (lel_at, lel_atp) = take_at_binding(p);
    let (lel_lits, lel_his, lel_hrs, lel_incs, lel_p) = parse_lit_alts(lel_atp);
    let (lel_init, lel_ip) = parse_expr(lel_p.expect("=").with_no_struct(false));
    lel_ip = lel_ip.with_no_struct(p.no_struct);
    let (lel_else, lel_rest, lel_restp) = parse_let_else_tail(lel_ip);
    p = lel_restp;
    let lel_arms: ast.LitArm[] = [];
    for lel_i in 0..lel_lits.len() {
      lel_arms = lel_arms.append(ast.LitArm { is_wild: false, lit: lel_lits[lel_i], guard: e_bool(true), has_guard: false, body: lel_rest, line: vline, col: vcol, range_hi: lel_his[lel_i], has_range: lel_hrs[lel_i], range_inclusive: lel_incs[lel_i], alt_cont: lel_i > 0, at_binding: lel_at });
    }
    lel_arms = lel_arms.append(ast.LitArm { is_wild: true, lit: e_bool(true), guard: e_bool(true), has_guard: false, body: lel_else, line: vline, col: vcol, range_hi: e_bool(true), has_range: false, range_inclusive: false, alt_cont: false, at_binding: "" });
    return (with_sugar_origin(build_literal_match(lel_init, lel_arms, vline, vcol), "let_else", false), p);
  }
  let name = p.peek_ident();
  if (name.len() == 0) {
    return (s_unknown(p, missing_fault("binding name")), p);
  }
  let le_pat_start = p;
  p = p.advance();
  if (p.peek_punct() == "{") {
    return parse_struct_destructure(p, name, at_bind, vline, vcol);
  }
  if (p.peek_punct() == "(" || p.peek_punct() == "@" || p.peek_punct() == "|" || p.peek_punct() == ".") {
    return parse_let_pattern(p, le_pat_start, qualified_record, vline, vcol);
  }
  return parse_let_value(p, name, vline, vcol);
}

function at_local_struct_pattern(p: Par): boolean {
  return is_struct_pattern_arm(p) && (p.peek_ident().len() > 0 && p.peek2_punct() == "{" || p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@" && p.peek_ident_at(2).len() > 0 && p.peek_punct_at(3) == "{");
}

struct PatternIfBranches { par: Par, yes: ast.Stmt[], no: ast.Stmt[], rt: string, else_chained: boolean }

function parse_pattern_if_branches(p: Par, value_form: boolean, value_local: string): PatternIfBranches {
  if (!value_form) {
    let (yes, next) = parse_block_or_stmt(p);
    p = next;
    let no: ast.Stmt[] = [];
    let chained = false;
    if (p.peek_keyword() == "else") {
      p = p.advance();
      chained = p.peek_keyword() == "if";
      let (body, after) = parse_block_or_stmt(p);
      no = body;
      p = after;
    }
    return PatternIfBranches { par: p, yes: yes, no: no, rt: "", else_chained: chained };
  }
  let (yes, yes_rt, next) = parse_branch_body(p);
  p = next.expect("else");
  let no: ast.Stmt[] = [];
  let no_rt = "i32";
  let chained = p.peek_keyword() == "if";
  if (chained) {
    let chain = parse_if_chain(p);
    let expr = value_chain_expr(chain, ORIGIN_IF_EXPR, p.peek_line(), p.peek_col());
    no = [s_return(expr)];
    no_rt = chain.rt;
    p = chain.par;
  } else {
    let (body, rt, after) = parse_branch_body(p);
    no = body;
    no_rt = rt;
    p = after;
  }
  return PatternIfBranches { par: p, yes: value_arm_body(yes, value_local), no: value_arm_body(no, value_local), rt: wider_rt(yes_rt, no_rt), else_chained: chained };
}

function pattern_if_chain(stmt: ast.Stmt, p: Par, rt: string, value_form: boolean, value_local: string): IfChain {
  let local = "";
  if (value_form) {
    local = value_local;
  }
  return IfChain { par: p, stmt: stmt, rt: rt, needs_default_return: false, value_local: local, scrut_bind: [] };
}

// parse_pattern_if shares pattern and branch rules between the two if-let forms.
struct TupleAlternatives { at: string, pats: ast.TupArm[], ok: boolean, par: Par }

// `name @ (…) | (…)`: the tuple patterns of an `if let` or a let-else.
function parse_tuple_alternatives(p: Par): TupleAlternatives {
  let at = "";
  if (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@") {
    at = p.peek_ident();
    p = p.advance().advance();
  }
  let pats: ast.TupArm[] = [];
  let no_body: ast.Stmt[] = [];
  let more = true;
  while (more) {
    let (kinds, binds, lits, elems, next) = parse_tuple_arm_pattern(p);
    p = next;
    if (kinds.len() == 0) {
      return TupleAlternatives { at: at, pats: pats, ok: false, par: p };
    }
    pats = pats.append(ast.TupArm { is_wild: false, elem_kinds: kinds, binds: binds, lits: lits, elem_pats: elems, at_binding: "", guard: e_bool(true), has_guard: false, body: no_body, line: 0, col: 0, alt_cont: false });
    more = p.peek_punct() == "|";
    if (more) {
      p = p.advance();
    }
  }
  return TupleAlternatives { at: at, pats: pats, ok: true, par: p };
}

function tuple_alternative_arms(alts: TupleAlternatives, yes: ast.Stmt[], no: ast.Stmt[], line: i32, col: i32): ast.TupArm[] {
  let arms: ast.TupArm[] = [];
  for i in 0..alts.pats.len() {
    let a = alts.pats[i];
    arms = arms.append(ast.TupArm { is_wild: false, elem_kinds: a.elem_kinds, binds: a.binds, lits: a.lits, elem_pats: a.elem_pats, at_binding: alts.at, guard: e_bool(true), has_guard: false, body: yes, line: line, col: col, alt_cont: i > 0 });
  }
  let wk: i32[] = [];
  let wb: string[] = [];
  let wl: ast.Expr[] = [];
  let wp: ast.Pattern[] = [];
  return arms.append(ast.TupArm { is_wild: true, elem_kinds: wk, binds: wb, lits: wl, elem_pats: wp, at_binding: "", guard: e_bool(true), has_guard: false, body: no, line: line, col: col, alt_cont: false });
}

function let_else_ahead(start: Par): boolean {
  let alts = parse_tuple_alternatives(start);
  if (!alts.ok || alts.par.peek_punct() != "=") {
    return false;
  }
  let (_, after) = parse_expr(alts.par.advance().with_no_struct(false));
  return after.peek_keyword() == "else";
}

function parse_let_tuple_else(start: Par, vline: i32, vcol: i32): (ast.Stmt, Par) {
  let alts = parse_tuple_alternatives(start);
  let p = alts.par;
  if (!alts.ok) {
    return (s_unknown(p, parse_fault("expected a tuple pattern")), p);
  }
  let (scrut, sp) = parse_expr(p.expect("=").with_no_struct(false));
  let (else_body, rest, rp) = parse_let_else_tail(sp.with_no_struct(start.no_struct));
  let arms = tuple_alternative_arms(alts, rest, else_body, vline, vcol);
  return (with_sugar_origin(build_tuple_match(scrut, arms, vline, vcol), "let_else", false), rp);
}

function parse_pattern_if(p: Par, value_form: boolean): IfChain {
  let rt = "i32";
  let value_local = "__il" + dl_itoa(p.peek_line()) + "_" + dl_itoa(p.peek_col()) + "_r";
  p = p.advance();
  // Local records use the field-pattern builder.
  if (at_local_struct_pattern(p)) {
    let ils_line = p.peek_line();
    let ils_col = p.peek_col();
    let ils_at = "";
    if (p.peek_ident().len() > 0 && p.peek2_punct() == "@") {
      ils_at = p.peek_ident();
      p = p.advance();
      p = p.advance();
    }
    let ils_type = p.peek_ident();
    let (ils_sap, ils_pp) = parse_struct_arm_pattern(p);
    let ils_binds = ils_sap.binds;
    let ils_fields = ils_sap.fields;
    let ils_field_kinds = ils_sap.kinds;
    let ils_field_lits = ils_sap.lits;
    let ils_field_pats = ils_sap.pats;
    let ils_ok = ils_sap.ok;
    p = ils_pp;
    if (!ils_ok) {
      return pattern_if_chain(s_unknown(p, parse_fault("a struct pattern binds field names")), p, rt, value_form, value_local);
    }
    p = p.expect("=");
    let ils_saved = p.no_struct;
    let (ils_scrut, ils_sp) = parse_expr(p.with_no_struct(true));
    p = ils_sp.with_no_struct(ils_saved);
    let branches = parse_pattern_if_branches(p, value_form, value_local);
    p = branches.par;
    rt = branches.rt;
    let ils_then = branches.yes;
    let ils_else = branches.no;
    let ils_arms: ast.StructArm[] = [];
    ils_arms = ils_arms.append(ast.StructArm { is_wild: false, type_name: ils_type, binds: ils_binds, fields: ils_fields, field_kinds: ils_field_kinds, field_lits: ils_field_lits, field_pats: ils_field_pats, at_binding: ils_at, rest_written: ils_sap.rest_written, guard: e_bool(true), has_guard: false, body: ils_then, line: ils_line, col: ils_col });
    let ils_nb: string[] = [];
    let ils_no_pats: ast.Pattern[] = [];
    let ils_no_kinds: i32[] = [];
    let ils_no_lits: ast.Expr[] = [];
    let ils_nf: string[] = [];
    ils_arms = ils_arms.append(ast.StructArm { is_wild: true, type_name: "", binds: ils_nb, fields: ils_nf, field_kinds: ils_no_kinds, field_lits: ils_no_lits, field_pats: ils_no_pats, at_binding: "", rest_written: false, guard: e_bool(true), has_guard: false, body: ils_else, line: ils_line, col: ils_col });
    return pattern_if_chain(with_sugar_origin(build_struct_match(ils_scrut, ils_arms, ils_line, ils_col), "if_let", branches.else_chained), p, rt, value_form, value_local);
  }
  if (p.peek_punct() == "(" || p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek_punct_at(1) == "@" && p.peek_punct_at(2) == "(") {
    let ilt_line = p.peek_line();
    let ilt_col = p.peek_col();
    let ilt = parse_tuple_alternatives(p);
    p = ilt.par;
    if (!ilt.ok) {
      return pattern_if_chain(s_unknown(p, parse_fault("expected a tuple pattern")), p, rt, value_form, value_local);
    }
    p = p.expect("=");
    let ilt_saved = p.no_struct;
    let (ilt_scrut, ilt_sp) = parse_expr(p.with_no_struct(true));
    p = ilt_sp.with_no_struct(ilt_saved);
    let branches = parse_pattern_if_branches(p, value_form, value_local);
    p = branches.par;
    rt = branches.rt;
    let ilt_arms = tuple_alternative_arms(ilt, branches.yes, branches.no, ilt_line, ilt_col);
    return pattern_if_chain(with_sugar_origin(build_tuple_match(ilt_scrut, ilt_arms, ilt_line, ilt_col), "if_let", branches.else_chained), p, rt, value_form, value_local);
  }
  // Literal and range patterns share the literal match builder.
  if (p.peek_is_pat_literal() || p.peek_at_literal()) {
    let ill_line = p.peek_line();
    let ill_col = p.peek_col();
    let (ill_at, ill_atp) = take_at_binding(p);
    p = ill_atp;
    let (ill_lits, ill_his, ill_hrs, ill_incs, ill_p) = parse_lit_alts(p);
    p = ill_p;
    p = p.expect("=");
    let ill_saved = p.no_struct;
    let (ill_scrut, ill_sp) = parse_expr(p.with_no_struct(true));
    p = ill_sp.with_no_struct(ill_saved);
    let branches = parse_pattern_if_branches(p, value_form, value_local);
    p = branches.par;
    rt = branches.rt;
    let ill_then = branches.yes;
    let ill_else = branches.no;
    let ill_arms: ast.LitArm[] = [];
    for ill_i in 0..ill_lits.len() {
      ill_arms = ill_arms.append(ast.LitArm { is_wild: false, lit: ill_lits[ill_i], guard: e_bool(true), has_guard: false, body: ill_then, line: ill_line, col: ill_col, range_hi: ill_his[ill_i], has_range: ill_hrs[ill_i], range_inclusive: ill_incs[ill_i], alt_cont: ill_i > 0, at_binding: ill_at });
    }
    ill_arms = ill_arms.append(ast.LitArm { is_wild: true, lit: e_bool(true), guard: e_bool(true), has_guard: false, body: ill_else, line: ill_line, col: ill_col, range_hi: e_bool(true), has_range: false, range_inclusive: false, alt_cont: false, at_binding: "" });

    return pattern_if_chain(with_sugar_origin(build_literal_match(ill_scrut, ill_arms, ill_line, ill_col), "if_let", branches.else_chained), p, rt, value_form, value_local);
  }
  let il_line = p.peek_line();
  let il_col = p.peek_col();
  let (ilpat_pattern, ilpat_p) = parse_pattern(p);
  p = ilpat_p;
  let ilpats: ast.Pattern[] = [ilpat_pattern];
  while (p.peek_punct() == "|") {
    p = p.advance();
    let (ilalt_pattern, ilalt_p) = parse_pattern(p);
    p = ilalt_p;
    ilpats = ilpats.append(ilalt_pattern);
  }
  p = p.expect("=");
  let il_saved = p.no_struct;
  let (ilscrut_expr, ilscrut_p) = parse_expr(p.with_no_struct(true));
  p = ilscrut_p.with_no_struct(il_saved);
  let branches = parse_pattern_if_branches(p, value_form, value_local);
  p = branches.par;
  rt = branches.rt;
  let ilthen_body = branches.yes;
  let ilelse = branches.no;
  let ilarms: ast.MatchArm[] = [];
  let ilwritten: ast.MatchArm[] = [];
  for ilpi in 0..ilpats.len() {
    ilwritten = ilwritten.append(ast.MatchArm { pattern: ilpats[ilpi], body: ilthen_body, line: il_line, col: il_col, guard: e_bool(true), has_guard: false, alt_cont: false });
    let (fi_pat, fi_g, fi_hg) = fold_lit_cond(ilpats[ilpi], e_bool(true), false);
    ilarms = ilarms.append(ast.MatchArm { pattern: fi_pat, body: ilthen_body, line: il_line, col: il_col, guard: fi_g, has_guard: fi_hg, alt_cont: false });
  }
  let ilwild = ast.MatchArm { pattern: p_wildcard(), body: ilelse, line: il_line, col: il_col, guard: e_bool(true), has_guard: false, alt_cont: false };
  ilarms = ilarms.append(ilwild);
  ilwritten = ilwritten.append(ilwild);
  if (arms_take_flag_chain(ilarms)) {
    return pattern_if_chain(with_sugar_origin(build_nested_arm_match(ilscrut_expr, ilarms, ilwritten, il_line, il_col), "if_let", branches.else_chained), p, rt, value_form, value_local);
  }
  ilarms = desugar_nested_arms(ilarms, 0, "");
  let ilsugar: ast.MatchArm[] = [];
  if (arms_have_written_form(ilwritten)) {
    ilsugar = ilwritten;
  }
  return pattern_if_chain(with_sugar_origin(s_match_sugared(ilscrut_expr, ilarms, ilsugar, il_line, il_col), "if_let", branches.else_chained), p, rt, value_form, value_local);
}

function parse_if_stmt(p: Par): (ast.Stmt, Par) {
  p = p.advance();
  if (p.peek_keyword() == "let") {
    let chain = parse_pattern_if(p, false);
    return (chain.stmt, chain.par);
  }
  let (c_expr, c_p) = parse_paren_head(p);
  p = c_p;
  let (then_blk_body, then_blk_p) = parse_block_or_stmt(p);
  p = then_blk_p;
  let else_body: ast.Stmt[] = [];
  let else_chained = false;
  if (p.peek_keyword() == "else") {
    p = p.advance();
    if (p.peek_keyword() == "if") {
      let (nested_stmt, nested_p) = parse_stmt(p);
      p = nested_p;
      else_body = else_body.append(nested_stmt);
      else_chained = true;
    } else {
      let (else_blk_body, else_blk_p) = parse_block_or_stmt(p);
      p = else_blk_p;
      else_body = else_blk_body;
    }
  }
  return (s_if_chained(c_expr, then_blk_body, else_body, else_chained), p);
}

function parse_return_stmt(p: Par): (ast.Stmt, Par) {
  let rline = p.peek_line();
  let rcol = p.peek_col();
  p = p.advance();
  if (p.peek_punct() == ";") {
    let bare = e_unknown_at(ast.fault_mark(BARE_RETURN), p.peek_line(), p.peek_col());
    return (s_return_at(bare, rline, rcol), p.advance());
  }
  let (val_expr, val_p) = parse_expr(p);
  p = val_p;
  p = p.end_of(val_expr);
  return (s_return_at(val_expr, rline, rcol), p);
}

function parse_break_stmt(p: Par): (ast.Stmt, Par) {
  let bkline = p.peek_line();
  let bkcol = p.peek_col();
  p = p.advance();
  let blbl = "";
  let bid = p.peek_ident();
  if (bid.len() > 0 && p.advance().peek_punct() == ";") {
    blbl = bid;
    p = p.advance();
  }
  p = p.expect_semi();
  return (ast.StmtBreak { tag: 0, line: bkline, col: bkcol, label: blbl }, p);
}

function parse_continue_stmt(p: Par): (ast.Stmt, Par) {
  let ckline = p.peek_line();
  let ckcol = p.peek_col();
  p = p.advance();
  let clbl = "";
  let cid = p.peek_ident();
  if (cid.len() > 0 && p.advance().peek_punct() == ";") {
    clbl = cid;
    p = p.advance();
  }
  p = p.expect_semi();
  return (ast.StmtContinue { tag: 0, line: ckline, col: ckcol, label: clbl }, p);
}

function parse_expression_stmt(p: Par): (ast.Stmt, Par) {
  let (e_expr, e_p) = parse_expr(p);
  p = e_p;
  let aline = p.peek_line();
  let acol = p.peek_col();
  let assign_op = p.peek_punct();
  let is_assign = assign_op == "=";
  let is_compound = is_compound_assign_op(assign_op);
  if (is_assign || is_compound) {
    p = p.advance();
    let (av_expr, av_p) = parse_expr(p);
    p = av_p;
    if (is_compound_assign_op(p.peek_punct()) || is_compound && p.peek_punct() == "=") {
      return chained_compound(p);
    }
    if (is_assign && p.peek_punct() == "=") {
      return parse_assign_chain(p, [e_expr, av_expr], [aline], [acol]);
    }
    p = p.end_of(av_expr);
    if (!is_compound) {
      return (assign_to(e_expr, av_expr, aline, acol), p);
    }
    let bin_op = slice_unchecked(assign_op, 0, assign_op.len() - 1).to_owned();
    let st = assign_to(e_expr, e_binary_at(bin_op, read_back(e_expr), av_expr, aline, acol), aline, acol);
    return (with_compound_op(st, bin_op), p);
  }
  if (p.strict_semi || p.peek_punct() != "}") {
    p = p.end_of(e_expr);
  }
  return (s_expr(e_expr), p);
}

function parse_stmt_at(p: Par): (ast.Stmt, Par) {
  if (unsafe_function_head(p)) {
    return (decl_sentinel(p, "unsafe nested functions are not supported"), skip_body_item(p));
  }
  if (p.peek_ident() == "unsafe" && p.advance().peek_punct() == "{") {
    let (unsafe_body, unsafe_end) = parse_block(p.advance());
    return (s_if_tagged(unsafe_body, "unsafe"), unsafe_end);
  }
  if (p.peek_punct() == "{") {
    let (bb_body, bb_p) = parse_block(p);
    return (s_block(bb_body), bb_p);
  }
  let loop_label = "";
  let llid = p.peek_ident();
  if (llid.len() > 0) {
    let lp1 = p.advance();
    if (lp1.peek_punct() == ":") {
      let lp2 = lp1.advance();
      let lkw = lp2.peek_keyword();
      if (lkw == "while" || lkw == "for" || lkw == "loop") {
        loop_label = llid;
        p = lp2;
      }
    }
  }
  if (p.peek_ident() == "assert") {
    let as0 = p.advance();
    if (as0.peek_punct() == "(") {
      let asp = as0.advance();
      let (as_cond, ascp) = parse_expr(asp);
      asp = ascp;
      let as_has_msg = false;
      let as_msg = e_string("");
      if (asp.peek_punct() == ",") {
        asp = asp.advance();
        let (asm_e, asmp) = parse_expr(asp);
        as_msg = asm_e;
        asp = asmp;
        as_has_msg = true;
      }
      if (asp.peek_punct() == ")") {
        asp = asp.advance();
      }
      if (asp.peek_punct() == ";") {
        asp = asp.advance();
      }
      let as_text = e_string("assertion failed");
      if (as_has_msg) {
        as_text = e_binary("+", e_string("assertion failed: "), as_msg);
      }
      let as_noelse: ast.Stmt[] = [];
      return (s_if_origin(e_unary("!", as_cond), abort_body(as_text, "1"), as_noelse, ORIGIN_ASSERT), asp);
    }
  }
  if (p.peek_ident() == "todo") {
    let td_site = TodoSite { line: p.peek_line(), col: p.peek_col() };
    let td0 = p.advance();
    let td0p = td0.peek_punct();
    if (td0p == "(" || td0p == ";") {
      let tdp = td0;
      let td_has_msg = false;
      let td_msg = e_string("");
      if (td0p == "(") {
        tdp = tdp.advance();
        if (tdp.peek_punct() != ")") {
          let (tdm_e, tdmp) = parse_expr(tdp);
          td_msg = tdm_e;
          tdp = tdmp;
          td_has_msg = true;
        }
        if (tdp.peek_punct() == ")") {
          tdp = tdp.advance();
        }
      }
      if (tdp.peek_punct() == ";") {
        tdp = tdp.advance();
      }
      let td_text = e_string("todo: not implemented");
      if (td_has_msg) {
        td_text = e_binary("+", e_string("todo: "), td_msg);
      }
      return (s_if_tagged(abort_body(td_text, "101"), ORIGIN_TODO), Par { ...tdp, todos: tdp.todos.append(td_site) });
    }
  }
  let kw = p.peek_keyword();
  if (kw == "defer") {
    p = p.advance();
    let (da_stmt, da_p) = parse_stmt(p);
    return (s_defer(defer_action(da_stmt, p)), da_p);
  }
  if (kw == "errdefer") {
    p = p.advance();
    let (ea_stmt, ea_p) = parse_stmt(p);
    return (s_errdefer(defer_action(ea_stmt, p)), ea_p);
  }
  if (kw == "function") {
    let errors_before = p.type_errs.len();
    let (fr_func, fr_p) = parse_func_decl(p);
    p = fr_p;
    if (fr_func.name.len() == 0) {
      if (p.type_errs.len() > errors_before) {
        let last = p.type_errs.len() - 1;
        let kept: ast.Stmt[] = [];
        for i in 0..last {
          kept = kept.append(p.type_errs[i]);
        }
        return (p.type_errs[last], Par { ...p, type_errs: kept });
      }
      return (s_unknown_at(decl_fault(malformed_fn_decl_message()), fr_func.line, fr_func.col), p);
    }
    let lam = e_lambda_at(fr_func.params, fr_func.ret_type, fr_func.body, ast.ORIGIN_NESTED_FN, fr_func.line, fr_func.col, fr_func.ret_fn_ret, fr_func.ret_fn_param_types, fr_func.ret_own);
    if (p.verbatim) {
      return (s_var_at(fr_func.name, "@fndecl", lam, fr_func.line, fr_func.col), p);
    }
    return (s_var(fr_func.name, "", lam), p);
  }
  if (kw == "match") {
    let (mr_stmt, mr_p) = parse_match_stmt(p);
    if (mr_p.peek_punct() == ";") {
      return (mr_stmt, mr_p.advance());
    }
    return (mr_stmt, mr_p);
  }
  if (kw == "if") {
    let (if_stmt, if_p) = parse_if_stmt(p);
    if (if_p.peek_punct() == ";") {
      return (if_stmt, if_p.advance());
    }
    return (if_stmt, if_p);
  }
  if (kw == "while") {
    let (wc_expr, wc_p) = parse_paren_head(p.advance());
    p = wc_p;
    let (wb_body, wb_p) = parse_block(p);
    p = wb_p;
    return (with_loop_label(s_while(wc_expr, wb_body), loop_label), p);
  }
  if (kw == "loop") {
    let (lr_stmt, lr_p) = parse_loop_stmt(p);
    return (with_loop_label(lr_stmt, loop_label), lr_p);
  }
  if (kw == "for") {
    let (fr0_stmt, fr0_p) = parse_for_stmt(p);
    return (with_loop_label(fr0_stmt, loop_label), fr0_p);
  }
  if (kw == "let") {
    return parse_let_stmt(p);
  }
  if (kw == "return") {
    return parse_return_stmt(p);
  }
  if (kw == "break") {
    return parse_break_stmt(p);
  }
  if (kw == "continue") {
    return parse_continue_stmt(p);
  }
  return parse_expression_stmt(p);
}

function parse_assign_chain(p0: Par, exprs0: ast.Expr[], lines0: i32[], cols0: i32[]): (ast.Stmt, Par) {
  let p = p0;
  let exprs = exprs0;
  let lines = lines0;
  let cols = cols0;
  while (p.peek_punct() == "=") {
    lines = lines.append(p.peek_line());
    cols = cols.append(p.peek_col());
    let (nx, np) = parse_expr(p.advance());
    p = np;
    exprs = exprs.append(nx);
  }
  if (is_compound_assign_op(p.peek_punct())) {
    return chained_compound(p);
  }
  p = p.end_of(exprs[exprs.len() - 1]);
  let stmts: ast.Stmt[] = [];
  let i = exprs.len() - 2;
  while (i >= 0) {
    let rhs = exprs[i + 1];
    if (i < exprs.len() - 2) {
      rhs = read_back(rhs);
    }
    let link = assign_to(exprs[i], rhs, lines[i], cols[i]);
    if let ast.StmtUnknown(_) = link {
      return (link, p);
    }
    stmts = stmts.append(link);
    i -= 1;
  }
  return (s_if_tagged(stmts, "chain_assign"), p);
}

function chained_compound(p: Par): (ast.Stmt, Par) {
  let st = s_unknown(p, coded_fault("P001", "a compound assignment stands alone: it cannot be part of an assignment chain"));
  let depth = 0;
  while (!p.at_end()) {
    let pc = p.peek_punct();
    if (depth == 0 && (pc == ";" || pc == "}")) {
      break;
    }
    if (pc == "(" || pc == "[" || pc == "{") {
      depth += 1;
    } else if (pc == ")" || pc == "]" || pc == "}") {
      depth -= 1;
    }
    p = p.advance();
  }
  if (p.peek_punct() == ";") {
    p = p.advance();
  }
  return (st, p);
}

function assign_to(target: ast.Expr, rhs: ast.Expr, line: i32, col: i32): ast.Stmt {
  match (target) {
    ast.ExprIdent(id) => {
      return s_assign_at(id.name, rhs, line, col, id.line, id.col);
    },
    ast.ExprIndex(_) => {
      return s_expr(e_call_at(e_ident("__set_index"), [target, rhs], line, col));
    },
    ast.ExprFieldAccess(_) => {
      return s_expr(e_call_at(e_ident("__set_field"), [target, rhs], line, col));
    },
    _ => {
      return s_unknown_at(coded_fault("P003", "left-hand side of assignment is not assignable"), line, col);
    }
  }
}

function with_compound_op(st: ast.Stmt, op: string): ast.Stmt {
  if let ast.StmtAssign(a) = st {
    return ast.StmtAssign { ...a, op: op };
  }
  if let ast.StmtExpr(x) = st {
    return ast.StmtExpr { ...x, op: op };
  }
  return st;
}

function read_back(target: ast.Expr): ast.Expr {
  match (target) {
    ast.ExprIdent(id) => {
      return e_ident_at(id.name, id.line, id.col);
    },
    ast.ExprIndex(ix) => {
      return e_index(ix.array, ix.index, ix.line, ix.col);
    },
    ast.ExprFieldAccess(fa) => {
      return e_field_access_at(fa.obj, fa.field, fa.line, fa.col);
    },
    _ => {
      return target;
    }
  }
}

pub function parse_program(toks: lexer.Token[]): ast.Stmt[] {
  if let Some(le) = stream_lex_error(toks) {
    return [s_unknown_at(lex_fault(le), le.line, le.col)];
  }
  let p = Par { toks: toks, pos: 0, no_struct: false, map_kind: -1, structnames: scan_struct_names(toks), constnames: scan_const_names(toks), verbatim: false, depth: 0, type_errs: [], todos: [], tail_at: [], tail_is: [], strict_semi: false, closers: closers(toks) };
  let out: ast.Stmt[] = [];
  while (!p.at_end()) {
    let (r_stmt, r_p) = parse_stmt(p);
    p = r_p;
    out = out.append(r_stmt);
  }
  return out;
}

function is_scalar_ret_name(n: string): boolean {
  return n == "i32" || n == "i64" || n == "u8" || n == "u16" || n == "i16" || n == "u32" || n == "u64"
    || n == "f32" || n == "f64" || n == "boolean";
}

pub function is_struct_ret_name(n: string): boolean {
  if (n.len() == 0) {
    return false;
  }
  for i in 0..n.len() {
    let c = n[i] as i32;
    if (c == 91 || c == 93 || c == 40 || c == 41 || c == 44 || c == 46 || c == 32) {
      return false;
    }
  }
  if (n == "i32" || n == "i64" || n == "u8" || n == "u16" || n == "i16" || n == "u32" || n == "u64"
    || n == "f32" || n == "f64" || n == "string" || n == "boolean" || n == "void"
    || n == "fn" || n == "unknown" || n == "any") {
    return false;
  }
  return true;
}

function is_nominal_ret_name(n: string): boolean {
  if (n.len() == 0) {
    return false;
  }
  let base = n;
  let bi = 0;
  while (bi < n.len()) {
    if (n[bi] == b'[') {
      base = slice_unchecked(n, 0, bi).to_owned();
      bi = n.len();
    } else {
      bi += 1;
    }
  }
  if (base.len() == 0) {
    return false;
  }
  if (base[0] == b'(') {
    return false;
  }
  if (base == "i32" || base == "i64" || base == "u8" || base == "u16" || base == "i16" || base == "u32" || base == "u64"
    || base == "f32" || base == "f64" || base == "string" || base == "boolean" || base == "void"
    || base == "fn" || base == "unknown" || base == "any") {
    return false;
  }
  return true;
}

function ret_spelling_is_array(name: string): boolean {
  return type_ends_arr(name) || spelling_is_view(name);
}

function fn_ret_admitted(rr_name: string): string {
  if (ret_spelling_is_array(rr_name)) {
    return rr_name;
  }
  if (is_struct_ret_name(rr_name)) {
    return rr_name;
  }
  if (is_nominal_ret_name(rr_name)) {
    return rr_name;
  }
  if (rr_name == "string") {
    return "string";
  }
  if (is_scalar_ret_name(rr_name)) {
    return rr_name;
  }
  if (util.is_tuple_type_name(rr_name)) {
    return rr_name;
  }
  return "";
}

function at_unit_type(p: Par): boolean {
  return p.peek_punct() == "(" && p.peek_punct_at(1) == ")" && p.peek_punct_at(2) != "=>";
}

function consume_array_suffix(p: Par, name: string): (string, string, Par) {
  while (p.peek_punct() == "[") {
    p = p.advance();
    if (p.peek_punct() == "]") {
      p = p.advance();
      name += "[]";
    }
  }
  return (name, "", p);
}

function parse_type_dyn(p: Par): (string, string, Par) {
  p = p.advance();
  let (dinner_name, dinner_fn_ret, dinner_p) = parse_type_name(p);
  p = dinner_p;
  let dynname = dinner_name;
  while (p.peek_punct() == "+") {
    p = p.advance();
    let (dmore_name, dmore_fn_ret, dmore_p) = parse_type_name(p);
    p = dmore_p;
    if (dmore_name.len() == 0) {
      return ("", "", p);
    }
    dynname = dynname + " + " + dmore_name;
  }
  return ("dyn " + dynname, "", p);
}

function parse_type_handle(p: Par, base: string): (string, string, Par) {
  if (p.peek_ident_at(1).len() == 0) {
    let rest = p.handle_word_misuse(base).advance();
    if (!starts_misused_handle_type(rest)) {
      return consume_array_suffix(rest, base);
    }
    return parse_type_name(rest);
  }
  p = p.advance();
  let (hinner_name, hinner_fn_ret, hinner_p) = parse_type_name(p);
  return (base + " " + hinner_name, "", hinner_p);
}

function starts_misused_handle_type(p: Par): boolean {
  if (is_type_keyword_tok(p, 0) || p.peek_keyword() == "dyn" || p.peek_punct() == "(") {
    return true;
  }
  return p.peek_punct() == "[" && p.peek_punct_at(1) != "]";
}

function parse_type_paren(p: Par): (string, string, Par) {
  return parse_type_paren_arrow(p, true);
}

function parse_type_name_reserving_arrow(p: Par): (string, string, Par) {
  if (p.peek_punct() != "(") {
    return parse_type_name(p);
  }
  return parse_type_paren_arrow(p, false);
}

function misused_handle_word(p: Par, word: string): boolean {
  if (word != "own" && word != "borrow" || p.peek_ident_at(1).len() > 0) {
    return false;
  }
  return word == "borrow" || !own_prefix_position(p);
}

function own_prefix_position(p: Par): boolean {
  let next = p.punct_at(p.pos + 1);
  let prev = p.punct_at(p.pos - 1);
  if (next == "," || next == ")") {
    return false;
  }
  if (prev == "=>") {
    return starts_misused_handle_type(p.advance());
  }
  if (prev != "(" && prev != ",") {
    return false;
  }
  let open = enclosing_opener(p, p.pos - 1);
  return open >= 0 && p.punct_at(open) == "(" && p.closer_followed_by(open, "(", ")", "=>", "");
}

function enclosing_opener(p: Par, from: i32): i32 {
  let depth = 0;
  let j = from;
  while (j >= 0) {
    let t = p.punct_at(j);
    if (t == ")" || t == "]") {
      depth += 1;
    } else if (t == "(" || t == "[") {
      if (depth == 0) {
        return j;
      }
      depth -= 1;
    }
    j -= 1;
  }
  return -1;
}

function grouped_prefix_space(punct: string): string {
  return if (punct == "(" || punct == "[") { " " } else { "" };
}

function parse_type_paren_arrow(p: Par, top_arrow: boolean): (string, string, Par) {
  if (at_unit_type(p) || !top_arrow && p.peek_punct() == "(" && p.peek_punct_at(1) == ")") {
    let up = p.refused_type(unit_type_message()).advance();
    up = up.advance();
    return consume_array_suffix(up, "void");
  }
  let dpa = p.advance();
  if (dpa.peek_keyword() == "dyn") {
    let (dpw_name, dpw_fn_ret, dpw_p) = parse_type_name(dpa);
    if (dpw_p.peek_punct() == ")") {
      let dpw_after = dpw_p.advance();
      if (!top_arrow || dpw_after.peek_punct() != "=>") {
        return consume_array_suffix(dpw_after, dpw_name);
      }
    }
  }
  let tbuf = "";
  let td = 0;
  let is_fn = false;
  let top_comma = false;
  let tprev_word = false;
  let tprev_prefix = false;
  let telem_empty = true;
  let telem_after_comma = false;
  while (!p.at_end()) {
    let tpk = p.peek_punct();
    if (tprev_prefix) {
      tbuf += grouped_prefix_space(tpk);
    }
    if (at_unit_type(p)) {
      tbuf += "void";
      p = p.refused_type(unit_type_message()).advance();
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      telem_empty = false;
      continue;
    }
    if (tpk == "(") {
      td += 1;
      telem_empty = true;
      telem_after_comma = false;
      tbuf += "(";
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      continue;
    }
    if (tpk == ")") {
      if (telem_empty && telem_after_comma) {
        p = p.expected_type();
      }
      telem_empty = false;
      td -= 1;
      tbuf += ")";
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      if (td == 0) {
        break;
      }
      continue;
    }
    if (tpk == ",") {
      if (telem_empty) {
        p = p.expected_type();
      }
      telem_empty = true;
      telem_after_comma = true;
      if (td == 1) {
        top_comma = true;
      }
      tbuf += ", ";
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      continue;
    }
    if (tpk == "=>") {
      is_fn = true;
      tbuf += " => ";
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      telem_empty = true;
      continue;
    }
    if (tpk == "+") {
      tbuf += " + ";
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      telem_empty = true;
      continue;
    }
    if (tpk.len() > 0) {
      tbuf += tpk;
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      telem_empty = false;
      continue;
    }
    let tseg = p.peek_ident();
    if (tseg.len() == 0) {
      tseg = p.peek_keyword();
    }
    if (tseg.len() == 0) {
      p = p.expected_type().advance();
      continue;
    }
    if (misused_handle_word(p, tseg)) {
      p = p.handle_word_misuse(tseg);
    }
    if (at_float_type(p, tseg)) {
      p = p.refused_type(float_type_message());
      tseg = "f64";
    }
    if (tprev_word && (p.verbatim || tprev_prefix)) {
      tbuf += " ";
    }
    tbuf += tseg;
    tprev_word = true;
    tprev_prefix = tseg == "dyn" || tseg == "own" || tseg == "borrow" || tseg == "once" && p.peek_punct_at(1) == "(";
    telem_empty = false;
    p = p.advance();
  }
  if (is_fn && !top_comma && !(top_arrow && p.peek_punct() == "=>")) {
    if (p.verbatim || ref_is_once(parse_type_ref(tbuf))) {
      if (p.peek_punct() != "[") {
        return (ungrouped(tbuf), "", p);
      }
      return consume_array_suffix(p, tbuf);
    }
    let (gname, gunused, gp) = consume_array_suffix(p, "fn");
    let gref = parse_type_ref(tbuf);
    if (!ref_is_fn_value(gref)) {
      return (gname, "", gp);
    }
    let gres = render_type_ref(ref_fn_result(gref));
    return (gname, fn_ret_admitted(gres), gp);
  }
  if (top_arrow && p.peek_punct() == "=>") {
    p = p.advance();
    let result_own = p.peek_ident() == "own";
    if (result_own) {
      p = p.advance();
    }
    let (rr_name, rr_fn_ret, rr_p) = parse_type_name(p);
    if (result_own) {
      rr_name = "own " + rr_name;
    }
    p = rr_p;
    let (fnr_name, fnr_fn_ret, fnr_p) = consume_array_suffix(p, "fn");
    let fn_ret_ty = fn_ret_admitted(rr_name);
    if (p.verbatim) {
      return (tbuf + " => " + rr_name + slice_unchecked(fnr_name, 2, fnr_name.len()), fn_ret_ty, fnr_p);
    }
    return (fnr_name, fn_ret_ty, fnr_p);
  }
  if (!top_comma) {
    return consume_array_suffix(p, unwrap_grouping_parens(tbuf));
  }
  return consume_array_suffix(p, tbuf);
}

// The function type `s` with no pair of parentheses around the whole of it,
// and none around the whole of its result.
function ungrouped(s: string): string {
  let t = s;
  while (t.len() > 2 && t[0] == b'(' && matching_close(t, 0) == Some(t.len() - 1) && !group_has_top_comma(t, 0, t.len() - 1)) {
    t = slice_unchecked(t, 1, t.len() - 1).to_owned();
  }
  let arrow = top_arrow_at(t);
  if (arrow < 0) {
    return t;
  }
  let head = slice_unchecked(t, 0, arrow + 3).to_owned();
  let result = slice_unchecked(t, arrow + 3, t.len()).to_owned();
  if (result.starts_with("own ")) {
    head += "own ";
    result = slice_unchecked(result, 4, result.len()).to_owned();
  }
  return head + ungrouped(result);
}

function unwrap_grouping_parens(s: string): string {
  let t = s;
  while (t.len() > 2 && t[0] == b'(' && t[t.len() - 1] == b')') {
    t = slice_unchecked(t, 1, t.len() - 1).to_owned();
  }
  return t;
}

pub function matching_bracket(s: string, start: i32): i32 {
  let depth = 0;
  for i in start..s.len() {
    if (s[i] == b'[') {
      depth += 1;
    } else if (s[i] == b']') {
      depth -= 1;
      if (depth == 0) {
        return i;
      }
    }
  }
  return -1;
}

function matching_close(s: string, start: i32): Option[i32] {
  let depth = 0;
  for i in start..s.len() {
    let c = s[i] as i32;
    if (c == b'(' as i32) {
      depth += 1;
    } else if (c == b')' as i32) {
      depth -= 1;
      if (depth == 0) {
        return Some(i);
      }
    }
  }
  return None;
}

function group_has_top_comma(s: string, start: i32, close: i32): boolean {
  if (close <= start + 1) {
    return false;
  }
  let depth = 0;
  for i in start + 1..close {
    let c = s[i] as i32;
    if (c == b'(' as i32 || c == b'[' as i32) {
      depth += 1;
    } else if (c == b')' as i32 || c == b']' as i32) {
      depth -= 1;
    } else if (c == b',' as i32 && depth == 0) {
      return true;
    }
  }
  return false;
}

function group_inner_is_fn(s: string, start: i32, close: i32): boolean {
  let depth = 0;
  for i in start + 1..close - 1 {
    let c = s[i] as i32;
    if (c == b'(' as i32 || c == b'[' as i32) {
      depth += 1;
    } else if (c == b')' as i32 || c == b']' as i32) {
      depth -= 1;
    } else if (c == b'=' as i32 && s[i + 1] == b'>' && depth == 0) {
      return true;
    }
  }
  return false;
}

function rest_starts_with_arrow(s: string, from: i32): boolean {
  let i = from;
  while (i < s.len() && s[i] == b' ') {
    i += 1;
  }
  return i + 1 < s.len() && s[i] == b'=' && s[i + 1] == b'>';
}

function rest_starts_with_array_suffix(s: string, from: i32): boolean {
  return from + 1 < s.len() && s[from] == b'[' && s[from + 1] == b']';
}

pub function canonicalise_type_args(s: string): string {
  let i = 0;
  while (i < s.len() && s[i] != b'(') {
    i += 1;
  }
  if (i >= s.len()) {
    return s;
  }
  let head = slice_unchecked(s, 0, i).to_owned();
  let Some(close) = matching_close(s, i) else {
    return s;
  };
  let inner = slice_unchecked(s, i + 1, close).to_owned();
  let rest_from = close + 1;
  let group_is_tuple = group_has_top_comma(s, i, close);
  let group_is_fn_param = rest_starts_with_arrow(s, rest_from);
  let group_is_fn_arr = !group_is_fn_param && group_inner_is_fn(s, i, close) && rest_starts_with_array_suffix(s, rest_from);
  if (group_is_tuple || group_is_fn_param || group_is_fn_arr) {
    return head + "(" + canonicalise_type_args(inner) + ")" + canonicalise_type_args(slice_unchecked(s, rest_from, s.len()).to_owned());
  }
  return head + canonicalise_type_args(inner) + canonicalise_type_args(slice_unchecked(s, rest_from, s.len()).to_owned());
}

function parse_type_punct_led(p: Par): (string, string, Par) {
  if (p.peek_punct() == "(") {
    return parse_type_paren(p);
  }
  if (p.peek_punct() == "[") {
    p = p.advance();
    let (bracketed_name, bracketed_fn_ret, bracketed_p) = parse_type_name(p);
    p = bracketed_p;
    if (p.peek_punct() == "]") {
      p = p.advance();
    }
    let (suffixed, sp) = parse_array_suffixes(p, "[" + bracketed_name + "]");
    return (suffixed, "", sp);
  }
  return ("", "", p.expected_type());
}

function parse_type_ident_led(p: Par, base: string): (string, string, Par) {
  p = p.advance();
  while (p.peek_punct() == "." || p.peek_punct() == "::") {
    let sep = p.peek_punct();
    p = p.advance();
    let seg0 = p.peek_ident();
    if (seg0.len() == 0) {
      seg0 = p.peek_keyword();
    }
    if (seg0.len() == 0) {
      break;
    }
    base = base + sep + seg0;
    p = p.advance();
  }
  if (p.peek_punct() != "[") {
    return (base, "", p);
  }
  p = p.advance();
  let inner = "";
  let depth = 1;
  let prev_ident = false;
  let dyn_depth: i32 = -1;
  while (depth > 0 && !p.at_end()) {
    let pk = p.peek_punct();
    if (pk == "[") {
      depth += 1;
      inner += "[";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == "]") {
      depth -= 1;
      if (depth == 0) {
        break;
      }
      if (dyn_depth > depth) {
        dyn_depth = -1;
      }
      inner += "]";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == ",") {
      if (dyn_depth == depth) {
        dyn_depth = -1;
      }
      p = p.advance();
      if (p.peek_punct() == ")") {
        p = p.expected_type();
      }
      if (p.peek_punct() != "]") {
        inner += ", ";
      }
      prev_ident = false;
      continue;
    }
    if (pk == "+") {
      if (dyn_depth != depth) {
        p = p.expect("]");
      }
      inner += " + ";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (at_unit_type(p)) {
      inner += "void";
      p = p.refused_type(unit_type_message()).advance();
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == "(") {
      if (prev_ident && ends_with_once(inner)) {
        inner += " ";
      }
      inner += "(";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == ")") {
      inner += ")";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == "=>") {
      inner += " => ";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == "=") {
      inner += " = ";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == "." || pk == "::") {
      inner += pk;
      p = p.advance();
      prev_ident = false;
      continue;
    }
    // A const argument (`Ring[4, string]`).
    let carg = p.peek_const_arg();
    if (carg.len() > 0) {
      if (prev_ident) {
        inner += " ";
      }
      inner += carg;
      p = p.advance();
      prev_ident = true;
      continue;
    }
    let seg = p.peek_ident();
    if (seg.len() == 0) {
      seg = p.peek_keyword();
    }
    if (seg.len() == 0) {
      break;
    }
    if (seg == "dyn") {
      dyn_depth = depth;
    }
    if (misused_handle_word(p, seg)) {
      p = p.handle_word_misuse(seg);
    }
    if (at_float_type(p, seg)) {
      p = p.refused_type(float_type_message());
      seg = "f64";
    }
    if (prev_ident) {
      inner += " ";
    }
    inner += seg;
    p = p.advance();
    prev_ident = true;
  }
  if (p.peek_punct() == "]") {
    p = p.advance();
  }
  let nm = base + "[" + canonicalise_type_args(inner) + "]";
  if (!p.verbatim) {
    nm = canon_vec(nm);
  }
  while (p.peek_punct() == "::") {
    let pp = p.advance();
    let pseg = pp.peek_ident();
    if (pseg.len() == 0) {
      pseg = pp.peek_keyword();
    }
    if (pseg.len() == 0) {
      break;
    }
    nm = nm + "::" + pseg;
    p = pp.advance();
  }
  let (suffixed, sp) = parse_array_suffixes(p, nm);
  return (suffixed, "", sp);
}

function parse_array_suffixes(p: Par, nm: string): (string, Par) {
  let out = nm;
  while (p.peek_punct() == "[") {
    if (p.peek_punct_at(1) != "]") {
      break;
    }
    p = p.advance().advance();
    out += "[]";
  }
  return (out, p);
}

function parse_type_name(p: Par): (string, string, Par) {
  if (p.too_deep()) {
    return ("", "", p.bail());
  }
  let (g0, g1, gq) = parse_type_name_nested(p.with_depth(p.depth + 1));
  return (g0, g1, gq.with_depth(p.depth));
}

struct DeclType { name: string, fn_ret: string, fn_params: string }

function parse_decl_type(p: Par): (DeclType, Par) {
  let (name, fn_ret, end) = parse_type_name(p);
  let out = DeclType { name: name, fn_ret: fn_ret, fn_params: "" };
  if (p.verbatim || !is_fn_contract_tag(name)) {
    return (out, end);
  }
  let (written, wr_ret, wr_end) = parse_type_name(Par { ...p, verbatim: true });
  let ref = fn_ref_of(name, written);
  if (!ref_is_fn_value(ref)) {
    return (out, end);
  }
  let result = render_type_ref(ref_fn_result(ref));
  return (DeclType {
    name: name, fn_ret: result,
    fn_params: ref_fn_param_spellings(ref),
  }, end);
}

function fn_ref_of(name: string, written: string): TypeRef {
  let ref = ref_ungroup(parse_type_ref(written));
  if (name == "fn[]" && ref.array_depth == 1) {
    ref = ref_ungroup(elem_type_ref(ref));
  }
  if (name == "[fn]" && ref.is_view) {
    ref = ref_ungroup(ref.args[0]);
  }
  return ref;
}

// `once (A) => B`: a function type whose call consumes the function. The
// type keeps its whole spelling, also where a function type is a tag.
function parse_type_once(p: Par): (string, string, Par) {
  let (name, fn_ret, q) = parse_type_punct_led(Par { ...p.advance(), verbatim: true });
  q = Par { ...q, verbatim: p.verbatim };
  if (!ref_is_fn_value(parse_type_ref(name))) {
    return (name, "", q.refused_type("`once` marks a function type: write `once (A) => B`"));
  }
  return ("once " + name, "", q);
}

function fn_contract_of(name: string, written: string): (string, string) {
  if (!is_fn_contract_tag(name)) {
    return ("", "");
  }
  let ref = fn_ref_of(name, written);
  if (!ref_is_fn_value(ref)) {
    return ("", "");
  }
  return (render_type_ref(ref_fn_result(ref)), ref_fn_param_spellings(ref));
}

function parse_type_name_nested(p: Par): (string, string, Par) {
  let base = p.peek_ident();
  if (base.len() == 0) {
    base = p.peek_keyword();
  }
  if (base == "dyn") {
    return parse_type_dyn(p);
  }
  if (base == "own" || base == "borrow") {
    return parse_type_handle(p, base);
  }
  if (base == "once" && p.peek_punct_at(1) == "(") {
    return parse_type_once(p);
  }
  if (base.len() == 0) {
    return parse_type_punct_led(p);
  }
  if (at_float_type(p, base)) {
    return parse_type_ident_led(p.refused_type(float_type_message()), "f64");
  }
  return parse_type_ident_led(p, base);
}

function at_pattern_head(p: Par): boolean {
  let i = pattern_head_index(p);
  return p.punct_at(i) == "(" || record_pattern_brace_at(p, i) >= 0;
}

function pattern_head_index(p: Par): i32 {
  if (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@") {
    return p.pos + 2;
  }
  return p.pos;
}

function record_pattern_brace_at(p: Par, idx: i32): i32 {
  if (p.ident_at(idx).len() == 0) {
    return -1;
  }
  idx += 1;
  while (p.punct_at(idx) == "." && p.ident_at(idx + 1).len() > 0) {
    idx += 2;
  }
  if (p.punct_at(idx) == "{") {
    return idx;
  }
  return -1;
}

function qualified_record_pattern_ahead(p: Par): boolean {
  let i = pattern_head_index(p);
  return record_pattern_brace_at(p, i) > i + 1;
}

function parse_record_pattern_head(p: Par): (string, Par) {
  let name = p.peek_ident();
  p = p.advance();
  while (p.peek_punct() == "." && p.peek_ident_at(1).len() > 0) {
    name = name + "." + p.peek_ident_at(1);
    p = p.advance().advance();
  }
  return (name, p);
}

function qualified_struct_binding(pat: ast.Pattern, init: ast.Expr, line: i32, col: i32): ast.Stmt {
  if let ast.PatVariant(pv) = pat {
    if (is_record_pattern(pv) && !pv.has_lit_cond && pv.nested.len() == 0 && pv.field_names.len() > 0) {
      let names: string[] = [];
      for i in 0..pv.field_names.len() {
        names = names.append(discard_name(payload_binder(pv, i), line, col, i));
      }
      return s_destr_at(record_pattern(pv.type_name, names, pv.field_names, pv.at_binding, pv.rest_written), init, line, col);
    }
  }
  return s_unknown_at(parse_fault("a struct destructuring pattern binds field names"), line, col);
}

function parse_pattern_param(p: Par): (ast.ParamDecl, ParamDestr, Par) {
  let tline = p.peek_line();
  let tcol = p.peek_col();
  let bad_param = ast.ParamDecl { name: "", type_name: "", own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 };
  let bad = ParamDestr { pattern: ast.no_destr(), synth: "", line: tline, col: tcol };
  let holder = "";
  if (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@") {
    holder = p.peek_ident();
    p = p.advance();
    p = p.advance();
  }
  let pattern = ast.no_destr();
  if (p.peek_punct() == "(") {
    let tuple_start = p;
    let (tdestr, names_count, names_ok, names_p) = parse_destructure_names(p);
    p = names_p;
    if (!names_ok) {
      let refused = tuple_start.refused_type(refutable_tuple_message(tuple_start, "parameter"));
      let recovered = tuple_start.advance().skip_to_close(")");
      p = Par { ...recovered, type_errs: refused.type_errs };
      pattern = ast.tuple_destr(["__invalid_pattern"]);
    } else if (names_count < 2) {
      return (bad_param, bad, p);
    } else {
      pattern = tdestr;
    }
  } else {
    if (record_pattern_brace_at(p, p.pos) < 0) {
      return (bad_param, bad, p);
    }
    let (struct_name, head_p) = parse_record_pattern_head(p);
    p = head_p;
    let (binds, fields, fields_rest, fields_ok, fields_p) = parse_struct_pattern_fields(p);
    p = fields_p;
    if (!fields_ok || binds.len() == 0) {
      return (bad_param, bad, p);
    }
    pattern = record_pattern(struct_name, binds, fields, "", fields_rest);
  }
  if (p.peek_punct() != ":") {
    return (bad_param, bad, p);
  }
  p = p.advance();
  let (tr, tr_p) = parse_decl_type(p);
  p = tr_p;
  if (p.peek_punct() == "=") {
    return (bad_param, bad, p);
  }
  if (holder.len() == 0) {
    holder = "__ptuple_" + util.i32_to_string(tline) + "_" + util.i32_to_string(tcol);
  }
  return (ast.ParamDecl { name: holder, type_name: tr.name, own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: tr.fn_ret, fn_param_types: tr.fn_params, line: tline, col: tcol }, ParamDestr { pattern: ast.Destr { ...pattern, prelude: true }, synth: holder, line: tline, col: tcol }, p);
}

function prepend_param_destrs(body: ast.Stmt[], destrs: ParamDestr[]): ast.Stmt[] {
  if (destrs.len() == 0) {
    return body;
  }
  let out: ast.Stmt[] = [];
  for i in 0..destrs.len() {
    let d = destrs[i];
    out = out.append(as_header(s_destr_at(d.pattern, e_ident_at(d.synth, d.line, d.col), d.line, d.col)));
  }
  for j in 0..body.len() {
    out = out.append(body[j]);
  }
  return out;
}

function refutable_binding_message(kind: string, site: string): string {
  return kind + " can fail to match, so it cannot be a " + site + " pattern — there is no else branch here; destructure with a tuple `(a, b)` or struct `S { x, y }` pattern, or `match` on the value in the body";
}

function refused_variant_param(p: Par): (ast.ParamDecl, Par) {
  let refused = p.refused_type(refutable_binding_message("an enum variant pattern", "parameter"));
  let (pattern, parsed) = parse_pattern(p);
  p = Par { ...parsed, type_errs: refused.type_errs };
  p = p.expect(":");
  let (tr, next) = parse_decl_type(p);
  return (ast.ParamDecl { name: "__invalid_pattern", type_name: tr.name, own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: tr.fn_ret, fn_param_types: tr.fn_params, line: 0, col: 0 }, next);
}

function parse_param(p: Par, nth: i32): (ast.ParamDecl, Par) {
  if (p.peek_ident().len() > 0 && (p.peek_punct_at(1) == "(" || p.peek_punct_at(1) == ".")) {
    return refused_variant_param(p);
  }
  let name = p.peek_ident();
  if (name.len() == 0) {
    return (ast.ParamDecl { name: "__invalid_param", type_name: "", own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 }, p.refused_type("expected a name, got " + tok_desc(p.peek())));
  }
  let is_own = false;
  let is_send = false;
  if (name == "own" || name == "send") {
    let probe = p.advance();
    if (probe.peek_ident().len() > 0) {
      is_own = true;
      is_send = name == "send";
      p = probe;
      name = p.peek_ident();
    }
  }
  let at_line = p.peek_line();
  let at_col = p.peek_col();
  name = discard_name(name, at_line, at_col, nth);
  p = p.advance();
  if (p.peek_punct() != ":") {
    return (ast.ParamDecl { name: name, type_name: "", own: is_own, send: is_send, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: at_line, col: at_col }, p.refused_type("expected \":\", got " + tok_desc(p.peek())));
  }
  p = p.advance();
  let (tr, tr_p) = parse_decl_type(p);
  p = tr_p;
  let has_def = false;
  let def_val = e_unknown("");
  if (p.peek_punct() == "=") {
    p = p.advance();
    let (de_expr, de_p) = parse_expr(p);
    p = de_p;
    has_def = true;
    def_val = de_expr;
  }
  return (ast.ParamDecl { name: name, type_name: tr.name, own: is_own, send: is_send, has_default: has_def, default_value: def_val, fn_ret: tr.fn_ret, fn_param_types: tr.fn_params, line: at_line, col: at_col }, p);
}

struct TpList { tnames: string[], tbounds: string[] }

function parse_type_param_list(p: Par): (TpList, Par) {
  let names: string[] = [];
  let bounds: string[] = [];
  if (p.peek_punct() != "[") {
    return (TpList { tnames: names, tbounds: bounds }, p);
  }
  p = p.advance();
  while (!p.at_end()) {
    if (p.peek_punct() == "]") {
      break;
    }
    if (p.peek_keyword() == "const") {
      let (cname, cp) = parse_const_tparam(p);
      names = names.append(cname);
      bounds = bounds.append(CONST_BOUND);
      p = tparam_sep(cp);
      continue;
    }
    let tpname = p.peek_ident();
    if (tpname.len() == 0) {
      p = p.advance();
      continue;
    }
    p = p.advance();
    let this_bounds = "";
    if (p.peek_punct() == ":") {
      p = p.advance();
      let go = true;
      while (go && !p.at_end()) {
        let tname = "";
        if (p.peek_ident().len() > 0) {
          tname = p.peek_ident();
          p = p.advance();
        }
        if (p.peek_punct() == ".") {
          p = p.advance();
          if (p.peek_ident().len() > 0) {
            tname = tname + "." + p.peek_ident();
            p = p.advance();
          }
        }
        if (p.peek_punct() == "[") {
          p = p.advance();
          let bargs = "";
          while (!p.at_end() && p.peek_punct() != "]") {
            let barg = p.peek_const_arg();
            if (barg.len() > 0) {
              p = p.advance();
            } else {
              let barg_at = p.pos;
              let (bt, bt_ret, bt_p) = parse_type_name(p);
              p = bt_p;
              if (p.pos == barg_at) {
                p = p.expected_type().advance();
                continue;
              }
              barg = bt;
            }
            if (bargs.len() > 0) {
              bargs += ", ";
            }
            bargs += barg;
            if (p.peek_punct() == ",") {
              p = p.advance();
            } else if (p.peek_punct() != "]") {
              p = p.expect("]").advance();
            }
          }
          if (p.peek_punct() == "]") {
            p = p.advance();
          }
          tname = tname + "[" + bargs + "]";
        }
        if (tname.len() > 0) {
          if (this_bounds.len() > 0) {
            this_bounds += "+";
          }
          this_bounds += tname;
        }
        if (p.peek_punct() == "+") {
          p = p.advance();
        } else {
          go = false;
        }
      }
    }
    names = names.append(tpname);
    bounds = bounds.append(this_bounds);
    p = tparam_sep(p);
  }
  if (p.peek_punct() == "]") {
    p = p.advance();
  }
  return (TpList { tnames: names, tbounds: bounds }, p);
}

function tparam_sep(p: Par): Par {
  if (p.peek_punct() == ",") {
    return p.advance();
  }
  if (p.peek_punct() != "]" && !p.at_end()) {
    p = Par { ...p, type_errs: p.type_errs.append(s_unknown(p, decl_fault("expected \"]\", got " + tok_desc(p.peek())))) };
    while (!p.at_end() && p.peek_punct() != "]") {
      p = p.advance();
    }
  }
  return p;
}

pub const CONST_BOUND: string = "const";

pub function is_const_bound(bound: string): boolean {
  return bound == CONST_BOUND;
}

function parse_const_tparam(p: Par): (string, Par) {
  p = p.advance();
  let name = p.peek_ident();
  if (name.len() == 0) {
    return ("", Par { ...p, type_errs: p.type_errs.append(s_unknown(p, decl_fault("expected a name, got " + tok_desc(p.peek())))) });
  }
  p = p.advance();
  if (p.peek_punct() != ":") {
    return (name, Par { ...p, type_errs: p.type_errs.append(s_unknown(p, decl_fault("const parameter " + name + " needs a type: write const " + name + ": i32"))) });
  }
  p = p.advance();
  if (p.peek_keyword() != "i32") {
    return (name, Par { ...p, type_errs: p.type_errs.append(s_unknown(p, decl_fault("const parameter " + name + " has type i32, got " + tok_desc(p.peek())))) });
  }
  return (name, p.advance());
}

function refuse_const_tparams(p: Par, at: Par, tpl: TpList): Par {
  for i in 0..tpl.tnames.len() {
    if (is_const_bound(tpl.tbounds[i])) {
      return Par { ...p, type_errs: p.type_errs.append(s_unknown(at, decl_fault("const parameter " + tpl.tnames[i] + ": " + const_param_owners()))) };
    }
  }
  return p;
}

function receiver_clause(p: Par): boolean {
  if (p.peek_punct() != "(") {
    return false;
  }
  let q = p.advance();
  if (q.peek_ident() == "own" && q.peek_ident_at(1).len() > 0) {
    q = q.advance();
  }
  if (q.peek_ident().len() == 0) {
    return false;
  }
  q = q.advance();
  if (q.peek_punct() != ":") {
    return false;
  }
  let depth = 0;
  while (!q.at_end()) {
    if (q.peek_punct() == "(") {
      depth += 1;
    }
    if (q.peek_punct() == ")") {
      if (depth == 0) {
        q = q.advance();
        return q.peek_ident().len() > 0 && (q.peek_punct_at(1) == "(" || q.peek_punct_at(1) == "[");
      }
      depth -= 1;
    }
    q = q.advance();
  }
  return false;
}

struct RecvType { par: Par, tps: TpList }

// parse_receiver_type parses a receiver type and takes out the bounds it
// writes on its type parameters: K in `(m: OrdMap[K: cmp.Ord, V])`.
// A bound opens a type argument, a slice element or a group.
function parse_receiver_type(p: Par): (string, RecvType) {
  let stop = recv_type_end(p);
  if (!recv_has_bound(p, stop)) {
    let (plain, plain_ret, plain_p) = parse_type_name(p);
    return (plain, RecvType { par: plain_p, tps: TpList { tnames: [], tbounds: [] } });
  }
  let type_toks: lexer.Token[] = [];
  let tp_toks: lexer.Token[] = [lexer.punct_tok("[", p.peek_line(), p.peek_col())];
  let names: string[] = [];
  let errs = p.type_errs;
  let resume = p.pos;
  for i in p.pos..stop {
    if (i < resume) {
      continue;
    }
    if (!recv_slot_bound(p, i)) {
      type_toks = type_toks.append(p.toks[i]);
      continue;
    }
    let name = p.ident_at(i);
    if (util.has_str(names, name)) {
      errs = errs.append(s_unknown(Par { ...p, pos: i }, decl_fault("type parameter " + name + " has a bound at two places in the receiver; write all its bounds at one place: " + name + ": A + B")));
    }
    names = names.append(name);
    type_toks = type_toks.append(p.toks[i]);
    tp_toks = tp_toks.append(p.toks[i]).append(p.toks[i + 1]);
    resume = level_end(p, i + 2, ",])");
    for k in i + 2..resume {
      tp_toks = tp_toks.append(p.toks[k]);
    }
    tp_toks = tp_toks.append(lexer.punct_tok(",", p.peek_line(), p.peek_col()));
  }
  let end = Par { ...p, pos: stop, type_errs: errs };
  let eof: lexer.Token = lexer.TokEof { line: end.peek_line(), col: end.peek_col() };
  let (rname, rret, tp) = parse_type_name(Par { ...end, toks: type_toks.append(eof), pos: 0 });
  if (!tp.at_end()) {
    tp = tp.refused_type("expected \")\", got " + tok_desc(tp.peek()));
  }
  tp_toks = tp_toks.append(lexer.punct_tok("]", end.peek_line(), end.peek_col())).append(eof);
  let (tps, bp) = parse_type_param_list(Par { ...tp, toks: tp_toks, pos: 0 });
  return (rname, RecvType { par: Par { ...end, type_errs: bp.type_errs, todos: bp.todos }, tps: tps });
}

// recv_type_end is the index of the ")" that closes a receiver clause.
function recv_type_end(p: Par): i32 {
  return level_end(p, p.pos, ")]");
}

// level_end is the index of the first token from `from` that is one of
// the closers and is not inside a nested group, or the end of the input.
function level_end(p: Par, from: i32, closers: string): i32 {
  let resume = from;
  for k in from..p.toks.len() {
    if (k < resume) {
      continue;
    }
    let here = Par { ...p, pos: k };
    let pu = p.punct_at(k);
    if (here.at_end() || pu.len() == 1 && util.index_of_sub(closers, pu) >= 0) {
      return k;
    }
    if (pu == "(" || pu == "[") {
      resume = level_end(p, k + 1, ")]") + 1;
    }
  }
  return p.toks.len();
}

function recv_has_bound(p: Par, stop: i32): boolean {
  for i in p.pos..stop {
    if (recv_slot_bound(p, i)) {
      return true;
    }
  }
  return false;
}

function recv_slot_bound(p: Par, i: i32): boolean {
  return p.ident_at(i).len() > 0 && p.punct_at(i + 1) == ":" && opens_recv_slot(p.punct_at(i - 1));
}

function idents_between(p: Par, stop: i32): string[] {
  let out: string[] = [];
  for i in p.pos..stop {
    let name = p.ident_at(i);
    if (name.len() > 0 && !util.has_str(out, name)) {
      out = out.append(name);
    }
  }
  return out;
}

pub struct RecvPrint { recv: string, names: string[], bounds: string[] }

// receiver_with_bounds writes the bound of each type parameter that the
// receiver type names into the receiver type, and keeps the parameters
// that only the method declares.
pub function receiver_with_bounds(fd: FuncDecl): RecvPrint {
  let recv = fd.receiver_type;
  let names: string[] = [];
  let bounds: string[] = [];
  for i in 0..fd.type_params.len() {
    let tp = fd.type_params[i];
    let bound = "";
    if (i < fd.bound_traits.len()) {
      bound = fd.bound_traits[i];
    }
    let at = type_word_at(recv, tp);
    if (at < 0) {
      names = names.append(tp);
      bounds = bounds.append(bound);
    } else if (bound.len() > 0) {
      recv = bound_into(recv, at, tp, spaced_bounds(bound));
    }
  }
  return RecvPrint { recv: recv, names: names, bounds: bounds };
}

function bound_into(recv: string, at: i32, tp: string, bound: string): string {
  let k = at - 1;
  while (k >= 0 && recv[k] == b' ') {
    k -= 1;
  }
  let end = at + tp.len();
  let tail = slice_unchecked(recv, end, recv.len()).to_owned();
  if (k >= 0 && (recv[k] == b'[' || recv[k] == b'(' || recv[k] == b',')) {
    return slice_unchecked(recv, 0, end) + ": " + bound + tail;
  }
  return slice_unchecked(recv, 0, at) + "(" + tp + ": " + bound + ")" + tail;
}

// type_word_at is the index of the first unqualified name in a type
// spelling, or -1.
function type_word_at(spelling: string, name: string): i32 {
  let start: i32 = -1;
  for i in 0..spelling.len() + 1 {
    let in_word = i < spelling.len() && type_word_byte(spelling[i]);
    if (in_word && start < 0) {
      start = i;
    } else if (!in_word && start >= 0) {
      if (util.str_range_eq(spelling, start, i, name) && (start == 0 || spelling[start - 1] != b'.')) {
        return start;
      }
      start = -1;
    }
  }
  return -1;
}

function type_word_byte(c: u8): boolean {
  return c == b'_' || c >= b'0' && c <= b'9' || c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z';
}

// spaced_bounds writes a bound list `A+B` as `A + B`.
pub function spaced_bounds(bounds: string): string {
  let out = "";
  let start = 0;
  for i in 0..=bounds.len() {
    if (i == bounds.len() || bounds[i] == b'+') {
      if (out.len() > 0) {
        out += " + ";
      }
      out += slice_unchecked(bounds, start, i);
      start = i + 1;
    }
  }
  return out;
}

function opens_recv_slot(punct: string): boolean {
  return punct == "[" || punct == "(" || punct == ",";
}

function parse_func_decl(p: Par): (FuncDecl, Par) {
  let decl_unsafe = unsafe_function_head(p);
  if (decl_unsafe) {
    p = p.advance();
  }
  let fline = p.peek_line();
  let fcol = p.peek_col();
  p = p.advance();
  let errs_before = p.type_errs.len();
  let empty_params: ast.ParamDecl[] = [];
  let empty_body: ast.Stmt[] = [];
  let bounded_tps: string[] = [];
  let bound_names: string[] = [];
  let unbounded_tps: string[] = [];
  let all_tps: string[] = [];
  if (p.peek_punct() == "[") {
    let refused = Par { ...p, type_errs: p.type_errs.append(s_unknown(p, coded_fault("P008", "a function's type parameters come after its name: write function name[T](...), or function (r: R) name[T](...) for a method"))) };
    let (lead_tps, skipped) = parse_type_param_list(refused);
    p = skipped;
  }
  let receiver_name = "";
  let receiver_type = "";
  let receiver_own = false;
  let recv_tps = TpList { tnames: [], tbounds: [] };
  let recv_names: string[] = [];
  if (receiver_clause(p)) {
    p = p.advance();
    receiver_name = p.peek_ident();
    if (receiver_name == "own") {
      let rprobe = p.advance();
      if (rprobe.peek_ident().len() > 0) {
        p = rprobe;
        receiver_name = p.peek_ident();
        receiver_own = true;
      }
    }
    if (receiver_name.len() > 0) {
      p = p.advance();
      if (p.peek_punct() == ":") {
        p = p.advance();
        let (rtr_name, rtr_p) = parse_receiver_type(p);
        recv_names = idents_between(p, rtr_p.par.pos);
        p = rtr_p.par;
        receiver_type = rtr_name;
        recv_tps = rtr_p.tps;
      }
    }
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
  }
  let name = p.peek_ident();
  if (name.len() == 0) {
    p = p.refused_type("expected a name, got " + tok_desc(p.peek()));
    return (FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "", receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_own: false, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [], is_unsafe: decl_unsafe }, p);
  }
  let name_p = p;
  p = p.advance();
  let (post_tps, post_p) = parse_type_param_list(p);
  p = post_p;
  if (receiver_name.len() > 0) {
    p = refuse_const_tparams(p, name_p, post_tps);
  }
  for tpi0 in 0..post_tps.tnames.len() {
    all_tps = all_tps.append(post_tps.tnames[tpi0]);
    if (p.verbatim || post_tps.tbounds[tpi0].len() > 0) {
      bounded_tps = bounded_tps.append(post_tps.tnames[tpi0]);
      bound_names = bound_names.append(post_tps.tbounds[tpi0]);
    } else {
      unbounded_tps = unbounded_tps.append(post_tps.tnames[tpi0]);
    }
  }
  for tp in all_tps {
    if (util.has_str(recv_names, tp)) {
      p = Par { ...p, type_errs: p.type_errs.append(s_unknown(name_p, coded_fault("P007", "the receiver introduces type parameter " + tp + ", so the method must not declare it again: write a bound for " + tp + " in the receiver type, as " + tp + ": Bound"))) };
      break;
    }
  }
  for rti in 0..recv_tps.tnames.len() {
    let rtn = recv_tps.tnames[rti];
    all_tps = all_tps.append(rtn);
    bounded_tps = bounded_tps.append(rtn);
    bound_names = bound_names.append(recv_tps.tbounds[rti]);
  }
  if (p.peek_punct() != "(") {
    return (FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: name, receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_own: false, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", import_weak: false, all_type_params: all_tps, bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [], is_unsafe: decl_unsafe }, p);
  }
  p = p.advance();
  let params: ast.ParamDecl[] = [];
  let pd: ParamDestr[] = [];
  if (p.peek_punct() != ")") {
    while (true) {
      if (at_pattern_head(p)) {
        let (tpr_param, tpr_destr, tpr_p) = parse_pattern_param(p);
        p = tpr_p;
        if (tpr_destr.pattern.binds.len() == 0) {
          return (FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "", receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_own: false, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [], is_unsafe: decl_unsafe }, p);
        }
        params = params.append(tpr_param);
        pd = pd.append(tpr_destr);
        if (p.peek_punct() == ",") {
          p = p.advance();
          if (p.peek_punct() == ")") {
            break;
          }
          continue;
        }
        break;
      }
      let (pr_param, pr_p) = parse_param(p, params.len());
      p = pr_p;
      params = params.append(pr_param);
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == ")") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  let ret_own = false;
  let ret_type = "";
  let fn_ret_fn_ret = "";
  let fn_ret_fn_ptys = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    if (p.peek_ident() == "own") {
      ret_own = true;
      p = p.advance();
    }
    let (fr, fr_tr_p) = parse_decl_type(p);
    p = fr_tr_p;
    ret_type = fr.name;
    fn_ret_fn_ret = fr.fn_ret;
    fn_ret_fn_ptys = fr.fn_params;
  }
  let declared_bound = bounded_tps.len() > 0;
  for ui in 0..unbounded_tps.len() {
    let un = unbounded_tps[ui];
    let callback_feeds = fn_param_feeds_nominal(params, un);
    let feeds = feeds_specialized_type(ret_type, un) || callback_feeds;
    let bindable = callback_feeds;
    for pj in 0..params.len() {
      if (feeds_specialized_type(params[pj].type_name, un)) {
        feeds = true;
      }
      if (token_at_paren_depth0(params[pj].type_name, un) || token_in_tuple_param(params[pj].type_name, un)) {
        bindable = true;
      }
    }
    let ret_bindable = feeds_specialized_type(ret_type, un);
    let promote = feeds && (bindable || ret_bindable);
    if (all_tps.len() == 1 && has_bare_scalar_param(params, un) && feeds_wide_container(ret_type, un)) {
      promote = true;
    }
    if (receiver_type.len() == 0 && all_tps.len() == 1 && has_bare_array_param(params, un) && type_mentions_var(ret_type, un)) {
      promote = true;
    }
    if (all_tps.len() == 2 && result_two_bare_vars(ret_type, unbounded_tps) && has_any_bare_scalar_param(params, unbounded_tps)) {
      promote = true;
    }
    if (has_bare_scalar_param(params, un) && !ret_mentions_any(ret_type, unbounded_tps)
      && all_bare_scalar_bound(params, unbounded_tps)) {
      promote = true;
    }
    if (declared_bound && all_fn_param_bound(params, unbounded_tps)) {
      promote = true;
    }
    if (promote) {
      bounded_tps = bounded_tps.append(un);
      bound_names = bound_names.append("");
    }
  }
  if (p.peek_punct() == ";") {
    p = p.advance();
    if (pd.len() > 0) {
      return (FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "", receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_own: false, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [], is_unsafe: decl_unsafe }, p);
    }
    return (FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: name, receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: params, ret_own: ret_own, ret_type: ret_type, body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", import_weak: false, all_type_params: all_tps, bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: fn_ret_fn_ret, ret_fn_param_types: fn_ret_fn_ptys, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [], is_unsafe: decl_unsafe }, p);
  }
  let (blk_body, blk_p) = parse_block(p);
  p = blk_p;
  let fbody = prepend_param_destrs(blk_body, pd);
  if (p.type_errs.len() > errs_before) {
    let kept: ast.Stmt[] = [];
    for tei in 0..p.type_errs.len() {
      if (tei < errs_before) {
        kept = kept.append(p.type_errs[tei]);
      } else {
        fbody = fbody.append(p.type_errs[tei]);
      }
    }
    p = Par { ...p, type_errs: kept };
  }
  if (receiver_type.len() == 0 && (body_binds_bare_var(fbody, params, unbounded_tps, bounded_tps)
    || body_feeds_user_parametric(fbody, erased_only(unbounded_tps, bounded_tps)))) {
    let all_bindable = true;
    for di in 0..unbounded_tps.len() {
      let dn = unbounded_tps[di];
      if (util.index_of_str(bounded_tps, dn) < 0) {
        let dbind = false;
        for dpj in 0..params.len() {
          if (token_at_paren_depth0(params[dpj].type_name, dn) || token_in_tuple_param(params[dpj].type_name, dn)) {
            dbind = true;
          }
        }
        if (has_fn_param_arg_var(params, dn) || has_fn_param_ret_var(params, dn)) {
          dbind = true;
        }
        if (!dbind) {
          all_bindable = false;
        }
      }
    }
    if (all_bindable) {
      for dk in 0..unbounded_tps.len() {
        if (util.index_of_str(bounded_tps, unbounded_tps[dk]) < 0) {
          bounded_tps = bounded_tps.append(unbounded_tps[dk]);
          bound_names = bound_names.append("");
        }
      }
    }
  }
  return (FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: name, receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: params, ret_own: ret_own, ret_type: ret_type, body: fbody, line: fline, col: fcol, import_iface: "", import_wit: "", import_weak: false, all_type_params: all_tps, bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: fn_ret_fn_ret, ret_fn_param_types: fn_ret_fn_ptys, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [], is_unsafe: decl_unsafe }, p);
}

function parse_struct_field(p: Par): (StructFieldDecl, Par) {
  let at = StructFieldDecl { ...bare_field(p.peek_ident(), ""), line: p.peek_line(), col: p.peek_col() };
  if (at.name.len() == 0) {
    return (at, p);
  }
  p = p.advance();
  if (p.peek_punct() != ":") {
    return (at, p);
  }
  let (field, end) = parse_field_type(p.advance(), at.name);
  return (StructFieldDecl { ...field, line: at.line, col: at.col }, end);
}

function parse_field_type(p: Par, name: string): (StructFieldDecl, Par) {
  let (ty, end) = parse_decl_type(p);
  return (StructFieldDecl { name: name, type_name: ty.name, fn_ret: ty.fn_ret, fn_param_types: ty.fn_params, line: 0, col: 0 }, end);
}

function parse_decl_tparams(p: Par, kind: string, name: string): (string[], string[], Par) {
  let tparams: string[] = [];
  let cparams: string[] = [];
  if (p.peek_punct() != "[") {
    return (tparams, cparams, p);
  }
  let open = p;
  p = p.advance();
  let gd = 1;
  while (!p.at_end() && gd > 0) {
    if (gd == 1 && p.peek_keyword() == "const") {
      let (cname, cp) = parse_const_tparam(p);
      p = cp;
      tparams = tparams.append(cname);
      cparams = cparams.append(cname);
      if (kind != "struct" && kind != "enum" && kind != "type") {
        p = Par { ...p, type_errs: p.type_errs.append(s_unknown(open, decl_fault("const parameter " + cname + ": " + const_param_owners()))) };
      }
      continue;
    }
    let gpk = p.peek_punct();
    if (gpk == "[") {
      gd += 1;
      p = p.advance();
      continue;
    }
    if (gpk == "]") {
      gd -= 1;
      p = p.advance();
      continue;
    }
    if (gd == 1) {
      let tpn = p.peek_ident();
      if (tpn.len() > 0) {
        tparams = tparams.append(tpn);
        p = p.advance();
        if (p.peek_punct() == ":") {
          p = Par { ...p, type_errs: p.type_errs.append(s_unknown(p, decl_fault(kind + " " + name + ": a bound on type parameter " + tpn + " belongs on an impl (impl[" + tpn + ": Trait] Trait for " + name + "[" + tpn + "]), not on the declaration"))) };
        }
        continue;
      }
    }
    p = p.advance();
  }
  return (tparams, cparams, p);
}

// const_param_owners names the declarations that take a const parameter.
function const_param_owners(): string {
  return "only a function, a struct, an enum, a type alias, an impl or a trait takes a const parameter";
}

function parse_struct_decl(p: Par): (StructDecl, Par) {
  let sline = p.peek_line();
  let scol = p.peek_col();
  p = p.advance();
  let name = p.peek_ident();
  let notp0: string[] = [];
  if (name.len() == 0) {
    let empty: StructFieldDecl[] = [];
    return (StructDecl { name: "", fields: empty, type_params: notp0, const_params: [], derives: [], line: sline, col: scol, enum_owner: "", must_consume: false, secret: false, value_type: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" }, p);
  }
  p = p.advance();
  let (tparams, cparams, tp_p) = parse_decl_tparams(p, "struct", name);
  p = tp_p;
  if (p.peek_punct() != "{") {
    let empty: StructFieldDecl[] = [];
    return (StructDecl { name: name, fields: empty, type_params: tparams, const_params: cparams, derives: [], line: sline, col: scol, enum_owner: "", must_consume: false, secret: false, value_type: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" }, p);
  }
  p = p.advance();
  let fields: StructFieldDecl[] = [];
  if (p.peek_punct() != "}") {
    while (true) {
      let (fr_field, fr_p) = parse_struct_field(p);
      p = fr_p;
      fields = fields.append(fr_field);
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == "}") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (StructDecl { name: name, fields: fields, type_params: tparams, const_params: cparams, derives: [], line: sline, col: scol, enum_owner: "", must_consume: false, secret: false, value_type: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" }, p);
}

function parse_type_alias(p: Par): (TypeAlias, Par) {
  let taline = p.peek_line();
  let tacol = p.peek_col();
  p = p.advance();
  let name = p.peek_ident();
  if (name.len() == 0) {
    return (TypeAlias { name: "", variants: [], variant_args: [], variant_lines: [], type_params: [], const_params: [], line: taline, col: tacol, is_pub: true, is_package: false, module: "" }, p);
  }
  let name_at = p;
  p = p.advance();
  let (tparams, cparams, tp_p) = parse_decl_tparams(p, "type", name);
  p = tp_p;
  if (p.peek_punct() != "=") {
    return (TypeAlias { name: name, variants: [], variant_args: [], variant_lines: [], type_params: tparams, const_params: cparams, line: taline, col: tacol, is_pub: true, is_package: false, module: "" }, p);
  }
  p = p.advance();
  let variants: string[] = [];
  let vargs: string[] = [];
  let vlines: i32[] = [];
  while (true) {
    if (p.peek_ident().len() == 0) {
      return union_decl_error(p, "expected a name, got " + tok_desc(p.peek()), name, tparams, cparams, taline, tacol);
    }
    let member = p;
    vlines = vlines.append(p.peek_line());
    let (dt, dt_p) = parse_decl_type(p);
    p = dt_p;
    let r = parse_type_ref(dt.name);
    if (r.array_depth > 0) {
      return union_decl_error(member, "a union member names a struct, not an array type", name, tparams, cparams, taline, tacol);
    }
    variants = variants.append(r.base);
    vargs = vargs.append(type_ref_args_spelling(r));
    if (p.peek_punct() == "|") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() != ";") {
    return union_decl_error(p, "expected \";\", got " + tok_desc(p.peek()), name, tparams, cparams, taline, tacol);
  }
  p = p.advance();
  if (variants.len() < 2) {
    p = Par { ...p, type_errs: p.type_errs.append(s_unknown(name_at, decl_fault("union \"" + name + "\" must list two or more struct members"))) };
  }
  return (TypeAlias { name: name, variants: variants, variant_args: vargs, variant_lines: vlines, type_params: tparams, const_params: cparams, line: taline, col: tacol, is_pub: true, is_package: false, module: "" }, p);
}

// One error for a malformed union declaration. The parse resumes after its `;`
// or at the next declaration.
function union_decl_error(at: Par, message: string, name: string, tparams: string[], cparams: string[], line: i32, col: i32): (TypeAlias, Par) {
  let p = Par { ...at, type_errs: at.type_errs.append(s_unknown(at, decl_fault(message))) };
  return (TypeAlias { name: name, variants: [], variant_args: [], variant_lines: [], type_params: tparams, const_params: cparams, line: line, col: col, is_pub: true, is_package: false, module: "" }, past_union_decl(p));
}

function past_union_decl(p: Par): Par {
  let q = p;
  while (!q.at_end() && !at_top_level_decl(q) && q.peek_keyword() != "type") {
    if (q.peek_punct() == ";") {
      return q.advance();
    }
    q = q.advance();
  }
  return q;
}

function type_ref_args_spelling(r: TypeRef): string {
  let out = "";
  for a in r.args {
    if (out.len() > 0) {
      out += ", ";
    }
    out += me_ref_spelling(a);
  }
  return out;
}

function parse_enum_decl(p: Par): (string, StructDecl[], string[], string[], i32[], Par) {
  p = p.advance();
  let out: StructDecl[] = [];
  let vlines: i32[] = [];
  let name = p.peek_ident();
  if (name.len() == 0) {
    return ("", out, [], [], vlines, p);
  }
  p = p.advance();
  let (tparams, cparams, tp_p) = parse_decl_tparams(p, "enum", name);
  p = tp_p;
  if (p.peek_punct() != "{") {
    return (name, out, tparams, cparams, vlines, p);
  }
  p = p.advance();
  while (p.peek_punct() != "}" && !p.at_end()) {
    let vline = p.peek_line();
    let vcol = p.peek_col();
    let vname = p.peek_ident();
    if (vname.len() == 0) {
      break;
    }
    p = p.advance();
    let fields: StructFieldDecl[] = [];
    let vfnames: string[] = [];
    if (p.peek_punct() == "{") {
      p = p.advance();
      while (p.peek_punct() != "}" && !p.at_end()) {
        let rfname = p.peek_ident();
        if (rfname.len() == 0) {
          break;
        }
        p = p.advance();
        if (p.peek_punct() == ":") {
          p = p.advance();
        }
        let (rf, rf_p) = parse_field_type(p, variant_payload_name(fields.len()));
        p = rf_p;
        fields = fields.append(rf);
        vfnames = vfnames.append(rfname);
        if (p.peek_punct() == ",") {
          p = p.advance();
          continue;
        }
        break;
      }
      if (p.peek_punct() == "}") {
        p = p.advance();
      }
    } else if (p.peek_punct() == "(") {
      p = p.advance();
      let (tr, tr_p) = parse_field_type(p, VARIANT_PAYLOAD_PREFIX);
      p = tr_p;
      fields = fields.append(tr);
      let (pmore, pmore_p) = p.more_elems(")");
      p = pmore_p;
      while (pmore) {
        let (tr2, tr2_p) = parse_field_type(p, variant_payload_name(fields.len()));
        p = tr2_p;
        fields = fields.append(tr2);
        let (pm2, pm2_p) = p.more_elems(")");
        pmore = pm2;
        p = pm2_p;
      }
      if (p.peek_punct() == ")") {
        p = p.advance();
      }
    }
    out = out.append(StructDecl { name: vname, fields: fields, type_params: [], const_params: [], derives: [], line: vline, col: vcol, enum_owner: name, must_consume: false, secret: false, value_type: false, variant_field_names: vfnames, is_pub: true, is_package: false, opaque: false, module: "" });
    vlines = vlines.append(vline);
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (name, out, tparams, cparams, vlines, p);
}

function parse_import(p: Par): (Import, ast.Stmt[], Par) {
  let imp_line = p.peek_line();
  let imp_col = p.peek_col();
  p = p.advance();
  let path = "";
  let bad: ast.Stmt[] = [];
  let t = p.peek();
  match (t) {
    lexer.TokString(s) => {
      path = s.value;
      p = p.advance();
    },
    _ => {
      bad = bad.append(decl_sentinel(p, "malformed import: its path could not be read"));
      return (Import { path: "", is_reexport: false, reexport_names: [], alias: "", line: imp_line, col: imp_col, resolved: "" }, bad, sync_to_top_level(p));
    }
  }
  let alias = "";
  if (p.peek_keyword() == "as") {
    p = p.advance();
    alias = p.peek_ident();
    if (alias.len() > 0) {
      p = p.advance();
    } else {
      bad = bad.append(decl_sentinel(p, "malformed import alias: its name could not be read (a keyword such as `type` or `match` cannot be a name)"));
    }
  }
  p = p.expect_semi();
  return (Import { path: path, is_reexport: false, reexport_names: [], alias: alias, line: imp_line, col: imp_col, resolved: "" }, bad, p);
}

function parse_pubuse(p: Par, pu_line: i32, pu_col: i32): (Import, ast.Stmt[], Par) {
  p = p.advance();
  let none = Import { path: "", is_reexport: true, reexport_names: [], alias: "", line: pu_line, col: pu_col, resolved: "" };
  let path = "";
  let bad: ast.Stmt[] = [];
  let t = p.peek();
  match (t) {
    lexer.TokString(s) => {
      path = s.value;
      p = p.advance();
    },
    _ => {
      bad = bad.append(decl_sentinel(p, "malformed re-export: its path could not be read"));
      return (none, bad, sync_to_top_level(p));
    }
  }
  for want in [".", "{"] {
    if (p.peek_punct() != want) {
      bad = bad.append(decl_sentinel(p, "expected \"" + want + "\", got " + tok_desc(p.peek())));
      return (none, bad, sync_to_top_level(p));
    }
    p = p.advance();
  }
  let names: string[] = [];
  while (p.peek_punct() != "}") {
    let nm = p.peek_ident();
    if (nm.len() == 0) {
      bad = bad.append(decl_sentinel(p, "expected a name, got " + tok_desc(p.peek())));
      return (none, bad, sync_to_top_level(p));
    }
    names = names.append(nm);
    p = p.advance();
    if (p.peek_punct() == ",") {
      p = p.advance();
    } else if (p.peek_punct() != "}") {
      bad = bad.append(decl_sentinel(p, "expected \"}\", got " + tok_desc(p.peek())));
      return (none, bad, sync_to_top_level(p));
    }
  }
  p = p.advance();
  if (p.peek_punct() != ";") {
    bad = bad.append(decl_sentinel(p, "expected \";\", got " + tok_desc(p.peek())));
    return (none, bad, sync_to_top_level(p));
  }
  p = p.advance();
  if (names.len() == 0) {
    bad = bad.append(s_unknown_at(decl_fault("`pub use` must name at least one symbol, e.g. `pub use \"std/string\".{split};`"), pu_line, pu_col));
    return (none, bad, p);
  }
  return (Import { ...none, path: path, reexport_names: names }, bad, p);
}

function parse_const_decl(p: Par): (FuncDecl, Par) {
  let cline = p.peek_line();
  let ccol = p.peek_col();
  p = p.advance();
  let name = p.peek_ident();
  if (name.len() > 0) {
    p = p.advance();
  }
  let ty = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    let (tr_name, tr_fn_ret, tr_p) = parse_type_name(p);
    p = tr_p;
    ty = tr_name;
  }
  p = p.expect("=");
  let (er_expr, er_p) = parse_expr(p);
  p = er_p;
  p = p.end_of(er_expr);
  let body: ast.Stmt[] = [];
  body = body.append(s_return(er_expr));
  let noparams: ast.ParamDecl[] = [];
  let notp: string[] = [];
  return (FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: name, receiver_name: "", receiver_type: "", receiver_own: false, type_params: notp, params: noparams, ret_own: false, ret_type: ty, body: body, line: cline, col: ccol, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: true, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [], is_unsafe: false }, p);
}

function parse_assoc_const_decl(p: Par, require_value: boolean): (FuncDecl, Par) {
  let cline = p.peek_line();
  let ccol = p.peek_col();
  p = p.advance();
  let name = p.peek_ident();
  if (name.len() > 0) {
    p = p.advance();
  }
  p = p.expect(":");
  let (tr_name, tr_fn_ret, tr_p) = parse_type_name(p);
  p = tr_p;
  let body: ast.Stmt[] = [];
  if (require_value || p.peek_punct() == "=") {
    p = p.expect("=");
    let (er_expr, er_p) = parse_expr(p);
    p = er_p;
    p = p.end_of(er_expr);
    body = body.append(s_return(er_expr));
  }
  p = p.expect_semi();
  let noparams: ast.ParamDecl[] = [];
  let notp: string[] = [];
  return (FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: name, receiver_name: "", receiver_type: "", receiver_own: false, type_params: notp, params: noparams, ret_own: false, ret_type: tr_name, body: body, line: cline, col: ccol, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: true, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [], is_unsafe: false }, p);
}

function struct_declared(structs: StructDecl[], name: string): boolean {
  for i in 0..structs.len() {
    if (structs[i].name == name) {
      return true;
    }
  }
  return false;
}

function name_declared(structs: StructDecl[], name: string): boolean {
  if (struct_declared(structs, name)) {
    return true;
  }
  for sd in structs {
    if (sd.enum_owner == name) {
      return true;
    }
  }
  return false;
}

function add_builtin_variant(acc: StructDecl[], name: string, payload_types: string[], enum_name: string): StructDecl[] {
  for sd in acc {
    if (sd.name == name && sd.enum_owner == enum_name) {
      return acc;
    }
  }
  let fields: StructFieldDecl[] = [];
  for t in payload_types {
    fields = fields.append(bare_field(variant_payload_name(fields.len()), t));
  }
  return acc.append(StructDecl { name: name, fields: fields, type_params: [], const_params: [], derives: [], line: 0, col: 0, enum_owner: enum_name, must_consume: false, secret: false, value_type: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" });
}

