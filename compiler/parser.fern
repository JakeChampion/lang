}

pub function fromjson_container(t: string): string {
  if (t.len() > 2 && t.ends_with("[]")) {
    return "array";
  }
  if (t.len() > 8 && t.starts_with("Option[") && t[t.len() - 1] == b']') {
    return "option";
  }
  return "";
}

pub function fromjson_elem(t: string): string {
  let c = fromjson_container(t);
  if (c == "array") {
    return slice_unchecked(t, 0, t.len() - 2).to_owned();
  }
  if (c == "option") {
    return slice_unchecked(t, 7, t.len() - 1).to_owned();
  }
  return t;
}

function fj_value_name(json_alias: string): string {
  if (json_alias == "v") {
    return "__from_json_value";
  }
  return "v";
}

function fj_text_name(json_alias: string): string {
  if (json_alias == "s") {
    return "__from_json_text";
  }
  return "s";
}

function fj_local_prefix(json_alias: string): string {
  if (json_alias.starts_with("__fj_")) {
    return "__fja_";
  }
  return "__fj_";
}

function synth_from_json_value(json_alias: string, sd: StructDecl): FuncDecl {
  let fnames: string[] = [];
  let fvals: ast.Expr[] = [];
  for k in 0..sd.fields.len() {
    fnames = fnames.append(sd.fields[k].name);
    fvals = fvals.append(e_ident(fj_local_prefix(json_alias) + sd.fields[k].name));
  }
  let lit: ast.Expr = ast.ExprStructLit { type_name: sd.name, field_names: fnames, field_lines: [], field_cols: [], field_values: fvals, has_base: false, base: e_unknown("no-base"), line: 0, col: 0, written: derived_self_type(sd) };
  let body: ast.Stmt[] = [s_return(e_call(e_ident("Ok"), [lit]))];
  let fi = sd.fields.len() - 1;
  while (fi >= 0) {
    let fname = sd.fields[fi].name;
    let fty = sd.fields[fi].type_name;
    let value = fj_local_prefix(json_alias) + "v_" + fname;
    let ebind = fj_local_prefix(json_alias) + "e_" + fname;
    let getter = "from_json_field";
    if (fromjson_container(fty) == "option") {
      getter = "from_json_optional_field";
    }
    let at_err = e_call(e_ident("Err"), [fj_call(json_alias, "from_json_at", [e_string(fname), e_ident(ebind)])]);
    let inner = s_match(fromjson_decode(json_alias, fty, value), [fj_arm("Ok", fj_local_prefix(json_alias) + fname, body), fj_arm("Err", ebind, [s_return(at_err)])]);
    let outer_arms: ast.MatchArm[] = [fj_arm("Ok", value, [inner]), fj_arm("Err", ebind, [s_return(e_call(e_ident("Err"), [e_ident(ebind)]))])];
    body = [s_match(fj_call(json_alias, getter, [e_ident(fj_value_name(json_alias)), e_string(fname)]), outer_arms)];
    fi -= 1;
  }
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: fj_value_name(json_alias), type_name: json_alias + ".JsonValue", own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 }];
  let notp: string[] = [];
  return FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "from_json_value", receiver_name: "", receiver_type: sd.name, receiver_own: false, type_params: notp, params: params, ret_own: false, ret_type: "Result[" + derived_self_type(sd) + ", " + json_alias + ".JsonError]", body: body, line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "FromJson", dyn_traits: [], streams: [], is_unsafe: false };
}

function derived_self_type(sd: StructDecl): string {
  return applied_type(sd.name, sd.type_params);
}

function applied_type(name: string, type_params: string[]): string {
  if (type_params.len() == 0) {
    return name;
  }
  let tps = "";
  for ti in 0..type_params.len() {
    if (ti > 0) {
      tps += ", ";
    }
    tps += type_params[ti];
  }
  return name + "[" + tps + "]";
}

function synth_from_json_text(json_alias: string, name: string, self_ty: string): FuncDecl {
  let call: ast.Expr = ast.ExprCall { callee: e_field_access(e_ident(json_alias), "decode"), args: [e_ident(fj_text_name(json_alias))], line: 0, col: 0, type_args: [self_ty], ty: "" };
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: fj_text_name(json_alias), type_name: "string", own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 }];
  let notp: string[] = [];
  return FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "from_json", receiver_name: "", receiver_type: name, receiver_own: false, type_params: notp, params: params, ret_own: false, ret_type: "Result[" + name + ", " + json_alias + ".JsonError]", body: [s_return(call)], line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "FromJson", dyn_traits: [], streams: [], is_unsafe: false };
}

function fromjson_decode(json_alias: string, t: string, value: string): ast.Expr {
  let c = fromjson_container(t);
  let reader = "from_json_elem";
  if (c == "array") {
    reader = "from_json_array";
  }
  if (c == "option") {
    reader = "from_json_option";
  }
  return ast.ExprCall { callee: e_field_access(e_ident(json_alias), reader), args: [e_ident(value)], line: 0, col: 0, type_args: [fromjson_elem(t)], ty: "" };
}

function fj_call(json_alias: string, f: string, args: ast.Expr[]): ast.Expr {
  return e_call(e_field_access(e_ident(json_alias), f), args);
}

function fj_arm(variant: string, bind: string, body: ast.Stmt[]): ast.MatchArm {
  return ast.MatchArm { pattern: p_variant(variant, bind), body: body, line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false };
}

function fj_in(json_alias: string, variant: string, why: ast.Expr): ast.Stmt[] {
  return [s_return(e_call(e_ident("Err"), [fj_call(json_alias, "from_json_in", [e_string(variant), why])]))];
}

function synth_enum_from_json_value(json_alias: string, ename: string, self_ty: string, variants: StructDecl[]): FuncDecl {
  let stmts: ast.Stmt[] = [];
  for v in variants {
    stmts = stmts.append(s_if(e_binary("==", e_ident(fj_local_prefix(json_alias) + "tag"), e_string(v.name)), enum_from_json_variant(json_alias, v, self_ty), []));
  }
  stmts = stmts.append(s_return(e_call(e_ident("Err"), [fj_call(json_alias, "from_json_unknown_variant", [e_ident(fj_local_prefix(json_alias) + "tag")])])));
  let arms: ast.MatchArm[] = [fj_arm("Ok", fj_local_prefix(json_alias) + "tag", stmts), fj_arm("Err", fj_local_prefix(json_alias) + "e", [s_return(e_call(e_ident("Err"), [e_ident(fj_local_prefix(json_alias) + "e")]))])];
  let body: ast.Stmt[] = [s_match(fj_call(json_alias, "from_json_variant", [e_ident(fj_value_name(json_alias))]), arms), s_return(e_call(e_ident("Err"), [fj_call(json_alias, "error", [e_string("")])]))];
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: fj_value_name(json_alias), type_name: json_alias + ".JsonValue", own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 }];
  let notp: string[] = [];
  return FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "from_json_value", receiver_name: "", receiver_type: ename, receiver_own: false, type_params: notp, params: params, ret_own: false, ret_type: "Result[" + self_ty + ", " + json_alias + ".JsonError]", body: body, line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "FromJson", dyn_traits: [], streams: [], is_unsafe: false };
}

function enum_from_json_variant(json_alias: string, v: StructDecl, self_ty: string): ast.Stmt[] {
  let value = e_ident(v.name);
  if (v.fields.len() > 0) {
    let args: ast.Expr[] = [];
    for a in 0..v.fields.len() {
      args = args.append(e_ident(fj_local_prefix(json_alias) + v.name + "_" + dl_itoa(a)));
    }
    value = e_call(e_ident(v.name), args);
  }
  let body: ast.Stmt[] = [s_var(fj_local_prefix(json_alias) + "r", self_ty, value), s_return(e_call(e_ident("Ok"), [e_ident(fj_local_prefix(json_alias) + "r")]))];
  let k = v.fields.len() - 1;
  while (k >= 0) {
    body = enum_from_json_payload(json_alias, v, k, body);
    k -= 1;
  }
  return body;
}

function enum_from_json_payload(json_alias: string, v: StructDecl, k: i32, body: ast.Stmt[]): ast.Stmt[] {
  let n = v.fields.len();
  let pt = v.fields[k].type_name;
  let tag = v.name + "_" + dl_itoa(k);
  let value = fj_local_prefix(json_alias) + "v_" + tag;
  let ebind = fj_local_prefix(json_alias) + "e_" + tag;
  let optional = "";
  if (fromjson_container(pt) == "option") {
    optional = "optional_";
  }
  let payload = fj_call(json_alias, "from_json_payload", [e_ident(fj_value_name(json_alias))]);
  let why = e_ident(ebind);
  let get = fj_call(json_alias, "from_json_" + optional + "item", [payload, e_number(dl_itoa(k), "", false), e_number(dl_itoa(n), "", false)]);
  if (v.variant_field_names.len() == n) {
    let fname = v.variant_field_names[k];
    get = fj_call(json_alias, "from_json_" + optional + "field", [payload, e_string(fname)]);
    why = fj_call(json_alias, "from_json_at", [e_string(fname), why]);
  } else if (n > 1) {
    why = fj_call(json_alias, "from_json_index", [e_number(dl_itoa(k), "", false), why]);
  }
  let inner = s_match(fromjson_decode(json_alias, pt, value), [fj_arm("Ok", fj_local_prefix(json_alias) + tag, body), fj_arm("Err", ebind, fj_in(json_alias, v.name, why))]);
  return [s_match(get, [fj_arm("Ok", value, [inner]), fj_arm("Err", ebind, fj_in(json_alias, v.name, e_ident(ebind)))])];
}

