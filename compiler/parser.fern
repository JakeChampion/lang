  return [
    "print", "write", "eprint", "putchar",
    "exit", "args", "set_args", "env", "config_get", "subprocess",
    "proc_fork", "proc_waitpid", "proc_waitpid_nohang", "proc_exec",
    "proc_waitpid_status",
    "proc_exec_as",
    "pipe",
    "chdir", "signal_mask", "signal_disposition",
    "chroot", "setuid", "setgid", "setgroups",
    "process_alive",
    "signal_send",
    "set_process_group",
    "priority", "set_priority",
    "stdin", "stdout", "stderr", "isatty",
    "target_os", "target_arch",
    "open_reader", "open_writer", "open_appender", "open_exclusive",
    "open_reader_with", "open_writer_with",
    "open_dir",
    "read_file", "read_file_bytes", "write_file", "write_file_bytes", "write_file_exec", "read_dir", "read_dir_all", "read_dir_ino", "read_dir_ino_all", "remove_dir_all", "remove_file",
    "create_dir_all", "stat", "lstat", "access", "temp_dir",
    "statfs", "mounts",
    "sysctl",
    "create_dir", "remove_dir", "create_link", "create_symlink", "read_link", "umask", "rename",
    "clone_file",
    "rename_noreplace", "rename_exchange",
    "getxattr", "getxattr_bytes", "lgetxattr", "lgetxattr_bytes",
    "setxattr", "setxattr_bytes", "lsetxattr", "lsetxattr_bytes",
    "chmod", "chmod_at", "set_file_times",
    "truncate",
    "sync",
    "mknod",
    "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc",
    "chown_at",
    "geteuid", "getegid", "hostname",
    "getuid", "getgid", "getgroups", "environ",
    "uname_field", "getcwd", "cpu_count",
    "rlimit_nofile",
    "disable_core_dumps",
    "signal_ignore", "signal_default", "signal_catch", "signal_taken", "signal_catch_interrupting",
    "signal_raise",
    "now_unix_ms", "now_ns", "monotonic_ns", "sleep_ms", "sleep_ns", "random_bytes",
    "random_i32", "poll", "timer_fd", "wasm_timer_pollable",
    "clock_resolution", "clock_set",
    "wasm_pollable_drop", "wasm_block", "wasm_poll",
    "map_new", "__map_new_i32", "string_from_bytes_unchecked", "string_from_bytes_range_unchecked", "slice_unchecked",
    "buf_new", "buf_push", "buf_push_range", "buf_push_mapped", "buf_push_filtered", "buf_push_expanded", "buf_push_bytes_mapped", "buf_push_bytes_filtered", "buf_push_bytes_expanded", "buf_push_byte", "buf_push_u64", "buf_len",
    "buf_take", "buf_take_bytes", "buf_push_bytes_range", "buf_clear", "buf_free",
    "cell_new",
    "f64_bits", "f64_from_bits", "f32_bits", "f32_from_bits",
    "tcp_listen", "tcp_accept", "tcp_local_port", "tcp_send_bytes", "tcp_close",
    "tcp_pollable", "tcp_listen_with", "tcp_socket_ctl",
    "udp_bind", "udp_bind_with", "udp_connect", "udp_sendto", "udp_recvfrom", "tcp_connect_with", "unix_listen", "unix_connect",
    "udp_sendto_bytes",
    "reactor_new", "reactor_ctl", "reactor_wait", "ring_new", "ring_ctl", "ring_wait", "ring_recv", "ring_send_zc", "tcp_recv_into", "tcp_ktls", "tcp_sendfile", "tcp_send_buf",
  ];
}

pub function is_builtin_function(name: string): boolean {
  return util.index_of_str(builtin_function_names(), name) >= 0;
}

pub function builtin_enum_of(name: string): string {
  if (name == "Some" || name == "None") {
    return "Option";
  }
  if (name == "Ok" || name == "Err") {
    return "Result";
  }
  if (name == "NotFound" || name == "PermissionDenied" || name == "AlreadyExists" || name == "InvalidUtf8" || name == "Interrupted" || name == "Unsupported" || name == "Other") {
    return "IoError";
  }
  if (name == "BodyText" || name == "BodyBytes" || name == "BodyStream" || name == "BodyFile" || name == "BodyChunks" || name == "BodyFileRanges") {
    return "Body";
  }
  return "";
}

pub function inject_builtin_enums(structs: StructDecl[]): StructDecl[] {
  let none: string[] = [];
  structs = add_builtin_variant(structs, "NotFound", ["string"], "IoError");
  structs = add_builtin_variant(structs, "PermissionDenied", ["string"], "IoError");
  structs = add_builtin_variant(structs, "AlreadyExists", ["string"], "IoError");
  structs = add_builtin_variant(structs, "InvalidUtf8", ["string"], "IoError");
  structs = add_builtin_variant(structs, "Interrupted", none, "IoError");
  structs = add_builtin_variant(structs, "Unsupported", none, "IoError");
  structs = add_builtin_variant(structs, "BodyText", ["string"], "Body");
  structs = add_builtin_variant(structs, "BodyBytes", ["u8[]"], "Body");
  structs = add_builtin_variant(structs, "BodyStream", ["Stream"], "Body");
  structs = add_builtin_variant(structs, "BodyFile", ["string"], "Body");
  structs = add_builtin_variant(structs, "BodyChunks", ["ChunkProducer"], "Body");
  structs = add_builtin_variant(structs, "BodyFileRanges", ["string", "i64[]", "u8[][]"], "Body");
  structs = add_builtin_variant(structs, "Other", ["string", "string", "i32"], "IoError");
  if (!name_declared(structs, "FileStat")) {
    let fsf: StructFieldDecl[] = [];
    fsf = fsf.append(StructFieldDecl { name: "is_file", type_name: "boolean", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "is_dir", type_name: "boolean", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "size", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "mode", type_name: "u32", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "nlink", type_name: "u32", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "uid", type_name: "u32", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "gid", type_name: "u32", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "dev", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "rdev", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "ino", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "blksize", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "blocks", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "atime", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "atime_nsec", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "mtime", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "mtime_nsec", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "ctime", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "ctime_nsec", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "btime", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "btime_nsec", type_name: "i64", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "FileStat", fields: fsf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" });
  }
  if (!name_declared(structs, "DirEntry")) {
    let def: StructFieldDecl[] = [];
    def = def.append(StructFieldDecl { name: "name", type_name: "string", fn_ret: "", fn_param_types: "" });
    def = def.append(StructFieldDecl { name: "ino", type_name: "i64", fn_ret: "", fn_param_types: "" });
    def = def.append(StructFieldDecl { name: "kind", type_name: "u32", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "DirEntry", fields: def, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" });
  }
  if (!name_declared(structs, "FsStat")) {
