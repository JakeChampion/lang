}

function e_lambda_origin(params: ast.ParamDecl[], ret_type: string, body: ast.Stmt[], origin: string): ast.Expr {
  return e_lambda_at(params, ret_type, body, origin, 0, 0, "", "");
}

pub function e_unknown(kind: string): ast.Expr {
  return ast.ExprUnknown { kind: kind, line: 0, col: 0 };
}

pub function path_sep_message(): string {
  return "`::` is not a path separator; write `.`";
}

pub function e_unknown_at(kind: string, line: i32, col: i32): ast.Expr {
