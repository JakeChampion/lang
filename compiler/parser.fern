// compiler/parser.fern — recursive-descent parser
// layered on the Fern-port lexer (`./lexer`). Together they form
// the second concrete step of the self-host port (after the
// standalone lexer in `lexer.fern`). Now that cross-module
// qualified variant patterns work (`lexer.TokIdent(x) => …`),
// the parser imports the lexer rather than inlining a copy.
//
// Scope:
//   - Expressions with precedence: + - * / % comparisons
//     equality && || (mirrors Go parser's precedence climbing)
//   - Numbers (with float / integer / suffix distinction
//     surfaced on the AST node)
//   - Identifier expressions + function calls `f(a, b)`
//   - Parenthesised grouping
//   - Statements: `let x = expr;`, `return expr;`, expression
//     stmts
//
// Out of scope (Go parser covers them; follow-up port):
//   - Types / type annotations
//   - Struct / enum / union decls
//   - `if` / `while` / `for` / `match` / `defer` / `arena`
//   - String / f-string handling (lexer recognises them; parser
//     stub treats them as opaque ExprUnknown)
//   - Receivers, type-params, `pub`, `import`

import "./ast";
import "./astwalk";
import "./util";
import "./lexer";
import "./typeinfo";

// =================== PARSER ====================

// ParamDestr is the desugar of ONE destructuring parameter, in the shape the
// body prelude needs: `names` is the comma-joined binding list a destructuring
// StmtVar carries in its name, `marker` is the `@sd:<Struct>:<fields>` tag a
// STRUCT pattern puts in type_name (empty for a tuple pattern), `synth` names
// the holder parameter the prelude reads, and line/col are the pattern's
// position. See parse_pattern_param.
struct ParamDestr { names: string, marker: string, synth: string, line: i32, col: i32 }

// Receiver fields capture `function (recv: RecvType) name(…)`
// — the self-host source uses them heavily for struct methods
// like `function (p: Par) advance(): Par`. Both fields are
// empty for plain functions. Downstream consumers treat
// receiver methods as plain functions for now (the receiver
// is conceptually a hidden first parameter — a later slice
// can prepend it to `params` during method-call lowering).
// type_params holds the BOUNDED type-parameter names (e.g. `["T"]` for
// `function f[T: Eq](…)`). It's empty for non-generic functions and for
// UNBOUNDED generics (`id[T]`), which the self-host still handles by
// erasure. A non-empty type_params marks a function the monomorphiser
// must clone per concrete call-site type — see monomorphize_module and
// docs/TRAITS.md (self-host slice 2).
// import_iface / import_wit bind a body-less function to a WIT import via an
// `@import("wasi:iface@x.y.z", "wit-func-name")` attribute (bring-your-own
// WIT, P4 — docs/WIT-BRING-YOUR-OWN.md). Both empty for an ordinary function;
// when set, body is empty and a call lowers to a core wasm import of
// (import_iface, import_wit).
// bound_traits runs PARALLEL to type_params: bound_traits[i] holds the
// trait bound(s) on type_params[i] as a `+`-joined list of trait names
// (each as written, module qualifier and type arguments included, e.g.
// `cmp.Ord` or `Iterator[T]`), or "" for a type param with
// no trait bound (an UNBOUNDED param the monomorphiser promoted into
// type_params — see the promotion loop in parse_func_decl). It exists so
// the checker can flag E021 generic-bound conformance at call sites
// (#4842); it is checker-only and never read by codegen, so it is
// fixpoint-neutral. Empty for non-generic functions.
// ret_fn_ret / ret_fn_param_types describe a function that RETURNS a function
// value (`function mk(): (f64) => f64`). parse_type_name coarsens that return
// to the flat "fn" tag, so `mk()(4.5)` reaches the checker with an untyped
// callee and the lowering with no signature to dispatch on. The two sidecars are the
// FuncDecl-level members of the family ParamDecl, StructFieldDecl and StmtVar
// already carry, recorded through the same non-consuming lookahead and read
// through the same rules, so a call through a returned fn value and a call
// through a parameter cannot disagree about the signature (#5986).
// impl_trait is the simple name of the trait a method was written for: an impl
// method or inherited default (claim_method_name), or a derived method; "" for a
// free function and an inherent method. dyn_traits is every trait, by simple
// name, whose `dyn` dispatch on this method's receiver type calls this method
// (resolve_dyn_traits); dyn_arm_matches selects arms by it. streams lists the
// slots of an async import that were `stream[T]` before
// lower_stream_signatures rewrote them to `T[]`: -1 for the result, else a
// parameter index. stdlib is the canonical standard-library import supplied
// by the loader, or "" for user and synthetic declarations. It survives
// renaming and instantiation, independently of the mangled module prefix.
pub struct FuncDecl { stdlib: string, no_inline: boolean, name: string, receiver_name: string, receiver_type: string, receiver_own: boolean, type_params: string[], params: ast.ParamDecl[], ret_type: string, body: ast.Stmt[], line: i32, col: i32, import_iface: string, import_wit: string, all_type_params: string[], bound_traits: string[], fip: boolean, fbip: boolean, fip_allowance: i32, async: boolean, is_const: boolean, is_pub: boolean, is_package: boolean, ret_fn_ret: string, ret_fn_param_types: string, module: string, impl_trait: string, dyn_traits: string[], streams: i32[] }

// Top-level struct decl: `struct Name { field1: T1, field2: T2 }`.
// Same simplifying assumption as FuncDecl: type names are
// captured as bare strings; full type syntax (arrays /
// generics / unions) lands in a follow-up.
pub struct StructFieldDecl { name: string, type_name: string, fn_ret: string, fn_param_types: string }

// type_params holds a generic struct's parameter names (`["T"]` for
// `struct Box[T]`); empty for a non-generic struct. The monomorphiser
// uses it to clone `Box[i32]` → a concrete `Box__i32` with the field
// types substituted, so primitive/string payloads resolve their methods.
// must_consume records a `@must_consume` attribute on the struct decl
// (docs/MUST-CONSUME.md): the checker's E067 obligation walk consults it.
// derives records the trait names of an `@derive(…)` attribute on the
// decl (an enum's derives are stamped on each variant record): the
// synthesis itself happens at parse time (synth_derives), but the
// checker's E021 derive-field conformance pre-check (#5392) needs to
// know which traits were derived.
// variant_field_names holds a RECORD-form enum variant's field names
// (`Rect { w: f64, h: f64 }` → ["w", "h"]), parallel to `fields`, whose
// entries stay the positional `__ev` / `__ev1` / … payload markers so the
// layout and every downstream `__ev` test are unchanged. Empty for a plain
// struct and for a positional (`Pair(A, B)`) or payloadless variant.
pub struct StructDecl { name: string, fields: StructFieldDecl[], type_params: string[], derives: string[], line: i32, col: i32, enum_owner: string, must_consume: boolean, variant_field_names: string[], is_pub: boolean, is_package: boolean }

// Top-level union type alias: `type Name = V1 | V2 | V3;`. `variant_args[i]`
// is the argument list a member is written with (`Leaf[T]` keeps "T"), ""
// for a bare member; `type_params` are the alias's own.
// Variants are captured as bare type-name strings — they
// resolve to other struct decls in the same module (or to
// primitives in a later milestone). The `pub` modifier is
// optional and currently consumed and discarded, since
// the self-host pipeline doesn't yet distinguish exported
// from private decls.
pub struct TypeAlias { name: string, variants: string[], variant_args: string[], variant_lines: i32[], type_params: string[], line: i32, col: i32, is_pub: boolean, is_package: boolean, module: string }

// Top-level import: `import "./path";`. The path is captured
// verbatim (including the quotes-stripped value). Resolution
// across files is a later milestone — for now the parser
// just gathers them into the Module so the rest of the
// pipeline can see what dependencies a source declares.
// `is_reexport` distinguishes a plain `import "path";` (false) from a
// `pub use "path".{names…};` re-export directive (true). A re-export
// import carries the re-exported names in `reexport_names`; the module
// loader still treats it as an import (so the target module is loaded +
// bundled), and the bundler reads the names to build the re-export table
// that redirects a consumer's `facade.name` to the original module's
// mangled symbol. See flatten.bundle / docs/PRELUDE-TO-MODULES.md.
// `resolved` is the module IDENTITY the driver resolved `path` to — one
// string per distinct FILE, where `path` is only what this module wrote.
// Two modules can spell the same file differently (`./lib/gnu` and `./gnu`)
// and two files can share a basename (`std/sort` and `coreutils/sort`), so
// the basename is not an identity and flatten cannot recover one. Empty when
// no loader filled it, which is every single-file driver.
pub struct Import { path: string, is_reexport: boolean, reexport_names: string[], alias: string, line: i32, resolved: string }

// warn_unresolved_imports prints a stderr diagnostic when `mod` declares imports
// that the CALLER has no module loader to resolve, and reports whether it did.
//
// The single-program drivers — interp_run, wasm_run, asm_ir_run, wasm_ir_run,
// asm_run, asm_pathprobe_run — run `parse_module` on raw stdin and resolve
// nothing. Feed one a program that imports `std/string` and it does not
// complain: the import is ignored, the qualified names go undefined, and the
// driver reports whatever a broken program reports — `refused` from a path probe,
// exit 254 from an interpreter, a bail from an eligibility check. Every one of
// those reads exactly like a compiler gap.
//
// It is not a hypothetical. Three issue diagnoses were wrong for this reason:
// #5990 recorded "to_ascii_lower absent from interp.fern" (really: std/string
// never loaded; the true blocker is that interp.fern implements none of the
// raw-memory intrinsics, #5998), #5992 recorded "to_lower is not IR-eligible on
// wasm" from a wasm_run `ast` verdict, as `refused` was then spelled (it is eligible — the emitted module
// called an undefined helper), and a third was made while fixing the second.
// docs/TEST-GATES.md documents the trap in prose; a trap that careful readers
// walk into repeatedly needs a warning at the point of use.
//
// Deliberately a WARNING, not an error, and deliberately not touching the exit
// code: dozens of existing tests feed these drivers programs whose imports are
// incidental (they use builtin `Map` syntax while carrying `import "core/map"`),
// and those programs compile correctly. Breaking them would buy nothing — the
// harm was always to a human reading a verdict, and a human reads stderr.
// FERN_STRICT_IMPORTS=1 promotes it to a hard exit for anyone who wants the
// stronger guarantee, mirroring FERN_STRICT_IR.
pub function warn_unresolved_imports(mod: Module, driver: string): boolean {
  if (mod.imports.len() == 0) {
    return false;
  }
  let paths: string = "";
  let i: i32 = 0;
  while (i < mod.imports.len()) {
    if (i > 0) {
      paths = paths + ", ";
    }
    paths = paths + "\"" + mod.imports[i].path + "\"";
    i = i + 1;
  }
  eprint("warning: " + driver + " has no module loader; UNRESOLVED imports: " + paths);
  eprint("warning: any verdict below (ir/refused, exit code, eligibility bail) describes a BROKEN program, not the language.");
  eprint("warning: to judge this program use a loading driver: `fern <prog> <stdlib-root>`, or asm_load_run.");
  match (env("FERN_STRICT_IMPORTS")) {
    Some(_) => {
      eprint("error: FERN_STRICT_IMPORTS=1 refuses an unresolvable-import run");
      exit(3);
    },
    None => {}
  }
  return true;
}

// A whole compilation unit: the funcs declared at top level and
// any stmts that appear outside a function decl. The interp /
// checker treat funcs first (build a signature table) and then
// either dispatch to `main` if it exists or fall back to the
// top-level stmt stream as the entry point.
// impls / trait_reqs carry the trait-conformance data the checker needs for
// E021 (#4347): trait_reqs lists each trait's REQUIRED (abstract, body-less)
// method names, and impls records every `impl Trait for Type` block with the
// methods it explicitly provides. parse_module populates both; the
// transformation passes propagate them unchanged.
// TodoSite is where a `todo` stub was written; `-check` warns at each one.
pub struct TodoSite { line: i32, col: i32 }

pub struct Module { funcs: FuncDecl[], structs: StructDecl[], aliases: TypeAlias[], imports: Import[], top_stmts: ast.Stmt[], enums: EnumDecl[], resources: ResourceDecl[], exports: ExportBinding[], impls: ImplInfo[], trait_reqs: TraitReq[], trait_decls: TraitDecl[], inferred_consts: string[], todo_sites: TodoSite[] }

// Only a loading driver supplies this provenance after resolving a standard
// library import. Parsing source, including mangled-looking names, never does.
// Declaration copies and generic instances preserve it independently of names.
pub function with_stdlib_origin(mod: Module, path: string): Module {
  if (!util.is_stdlib_path(path)) {
    return mod;
  }
  let funcs: FuncDecl[] = [];
  for f in mod.funcs {
    funcs = funcs.append(FuncDecl { ...f, stdlib: path });
  }
  return Module { ...mod, funcs: funcs };
}

// TraitReq is one trait's required-method set: the abstract (body-less)
// signatures an `impl` MUST provide. A defaulted (bodied) method is NOT
// required (the default is synthesised onto impls that omit it), so it never
// appears here. Drives the E021 missing-method check (#4347).
// TraitReq carries a trait's ABSTRACT (required) methods for the E021
// conformance check (#4347). `methods` is the required method names; `req_sigs`
// is the parallel full signatures (same length/order) so the checker can also
// diagnose an impl method whose arity / param types / return type disagree with
// the trait's declaration (Self resolves to the impl type at the check site).
// assoc_sigs is the callable associated-function set, including DEFAULTS.
// Keep it separate from required signatures: an impl may omit a default, but
// a bounded type parameter may still call it through the trait.
// provided is every method name the trait declares — abstract, defaulted, or
// associated — the set a bound on a type parameter makes callable.
// default_sigs is the signature of each defaulted method, its body dropped:
// a `dyn` of the trait dispatches to it as to a required one.
// `module` is the bundle prefix of the module that declared the trait, "" for
// the program's own module; it is what a qualified `@derive(cmp.Eq)` resolves
// against, since `trait_name` is simplified past any qualifier.
pub struct TraitReq { trait_name: string, methods: string[], req_sigs: FuncDecl[], supertraits: string[], assoc_sigs: FuncDecl[], provided: string[], assoc_types: string[], module: string, default_sigs: FuncDecl[] }

// TraitDecl is the `trait` block as WRITTEN, retained for the formatter
// (#6773) and, since it is the only record of a trait's TYPE PARAMETERS, for
// the E021 conformance check. The compile path reads two DERIVED views of it
// and neither can be printed from: TraitReq keeps the abstract method set for
// E021, with names simplified past any `mod.` qualifier, and TraitDefault
// keeps the bodied methods so they can be synthesised onto impls that omit
// them. Between them they drop the `pub`, the type parameters, the source
// position, and the order the methods were written in — so a formatted file
// lost its `trait` blocks entirely and every `impl` of one then named a trait
// the file no longer declared. A method's body is empty when it was written
// abstract.
pub struct TraitDecl { name: string, type_params: string[], supertraits: string[], methods: FuncDecl[], line: i32, col: i32, is_pub: boolean, is_package: boolean, assoc_types: string[] }

// ImplDecl is an `impl` block as WRITTEN, retained for the formatter (#6783) for
// the same reason TraitDecl is. parse_impl_decl desugars on the way in — each
// method becomes an ordinary receiver method on `Module.funcs` and the block
// reduces to an ImplInfo (trait name, impl type, method names) for the E021
// conformance walk — so a formatted file re-declared each method as a plain
// receiver method and the `impl` it belonged to was gone. A type stopped
// implementing the trait.
//
// `methods` holds the DESUGARED forms, which is what native prints too: `Self`
// already reads as the concrete impl type there, and a method's `self` receiver
// is re-inserted as its first parameter at print time. `trait_ref` is "" for an
// inherent `impl Type { … }`.
pub struct ImplDecl { trait_ref: string, type_ref: string, type_params: string[], bounds: string[], methods: FuncDecl[], line: i32, col: i32, assoc_names: string[], assoc_values: string[] }

// FieldLines records the source line of each FIELD of one struct, or of each
// VARIANT of one enum, for the formatter alone. Both formatters force the
// multi-line block form when a comment sits inside the braces, and drain each
// comment against the field it was written above; with no line per field the
// self-host printed the one-liner instead and every such comment was re-emitted
// above the NEXT declaration, where it documents the wrong thing (#6802).
//
// It sits beside Module for the reason TraitDecl does: 57 StructFieldDecl
// literals across the self-host would each have to carry a line none of them
// reads.
pub struct FieldLines { name: string, decl_line: i32, lines: i32[] }

// An inlining hint has no self-host codegen consumer yet, but formatting must
// preserve it for subsequent native builds. Bind it to the declaration's full
// source position, not its name: receiver methods can share names and a line
// can contain more than one declaration. Absence means no explicit hint.
pub struct FunctionInlineHint { line: i32, col: i32, never: boolean }

// ParsedFmt is parse_module_verbatim's result: the module plus the decls kept
// only for printing.
pub struct ParsedFmt { pmod: Module, ptraits: TraitDecl[], pimpls: ImplDecl[], pflines: FieldLines[], pinline: FunctionInlineHint[], pspans: BlockSpans }

// BlockSpans lists every `{ … }` in source order: the lines of its two braces,
// and `firsts`, the line of the token after the `{`. The statement-list AST
// keeps no brace positions, and the first statement's line is what a printer
// walking the blocks in source order can match against (#10154).
pub struct BlockSpans { opens: i32[], firsts: i32[], closes: i32[] }

function token_line(t: lexer.Token): i32 {
  match (t) {
    lexer.TokEof(x) => {
      return x.line;
    },
    lexer.TokNumber(x) => {
      return x.line;
    },
    lexer.TokIdent(x) => {
      return x.line;
    },
    lexer.TokKeyword(x) => {
      return x.line;
    },
    lexer.TokPunct(x) => {
      return x.line;
    },
    lexer.TokString(x) => {
      return x.line;
    },
    lexer.TokError(x) => {
      return x.line;
    },
    lexer.TokFString(x) => {
      return x.line;
    }
  }
  return 0;
}

// A `{` opening a match's arms or a declaration's members is never a
// statement block, so it stays out of the list: its first token shares a line
// with the first arm's body often enough to claim that body's braces.
function opens_non_block(t: lexer.Token): boolean {
  if let lexer.TokKeyword(k) = t {
    return k.name == "match" || k.name == "struct" || k.name == "enum" || k.name == "trait" || k.name == "impl";
  }
  return false;
}

function block_spans(toks: lexer.Token[]): BlockSpans {
  let opens: i32[] = [];
  let firsts: i32[] = [];
  let closes: i32[] = [];
  // Each open brace's index into the lists, -1 for one left out.
  let stack: i32[] = [];
  let sp: i32 = 0;
  let nest: i32 = 0;
  let skip_at: i32 = -1;
  let i: i32 = 0;
  while (i < toks.len()) {
    if (skip_at < 0 && opens_non_block(toks[i])) {
      skip_at = nest;
    }
    if let lexer.TokPunct(x) = toks[i] {
      if (x.text == "(" || x.text == "[") {
        nest = nest + 1;
      } else if (x.text == ")" || x.text == "]") {
        nest = nest - 1;
      } else if (x.text == ";" && skip_at == nest) {
        skip_at = -1;
      } else if (x.text == "{") {
        let at: i32 = -1;
        if (skip_at == nest) {
          skip_at = -1;
        } else {
          let first: i32 = 0;
          if (i + 1 < toks.len()) {
            first = token_line(toks[i + 1]);
          }
          at = opens.len();
          opens = opens.append(x.line);
          firsts = firsts.append(first);
          closes = closes.append(0);
        }
        if (sp < stack.len()) {
          stack = stack.with(sp, at);
        } else {
          stack = stack.append(at);
        }
        sp = sp + 1;
      } else if (x.text == "}" && sp > 0) {
        sp = sp - 1;
        if (stack[sp] >= 0) {
          closes = closes.with(stack[sp], x.line);
        }
      }
    }
    i = i + 1;
  }
  return BlockSpans { opens: opens, firsts: firsts, closes: closes };
}

// ResourceDecl records a `resource Name;` declaration (P5 — WIT resource-handle
// types, docs/WIT-BRING-YOUR-OWN.md). `iface` / `wit` carry the WIT identity
// from an `@import("iface", "wit-resource-name")` attribute (empty for an
// unbound resource). lower_defers_prepass_module uses the binding to synthesize the
// `[resource-drop]` import an owned handle is released through.
pub struct ResourceDecl { name: string, iface: string, wit: string, line: i32, col: i32 }

// ExportBinding records a function the outside world calls by name. One from
// an `@export("iface", "wit-name") function f {…}` binding (P6 —
// docs/WIT-BRING-YOUR-OWN.md) implements the WIT world export (iface, wit):
// the wasm emitter surfaces a core export `iface#wit-name` for each so the Go
// world-driven composer lifts it. One with `c_abi` is a `-shared` library's
// export, called through a C-ABI entry (fern.fern's export_entry) and with no
// iface or wit. Kept as a Module side-list (like resources) rather than a
// FuncDecl field to avoid rippling through every FuncDecl literal.
pub struct ExportBinding { func_name: string, iface: string, wit: string, c_abi: boolean }

// EnumDecl preserves an enum's name + the names of its variants. The
// parser desugars each enum into variant structs (pushed to `structs`)
// for codegen, which drops the enum -> variants grouping; this record
// keeps it so the checker can detect enum-level declaration errors (an
// enum redeclared, a duplicate variant) that the flat struct table can't
// distinguish from ordinary structs. Codegen ignores it.
// must_consume mirrors StructDecl.must_consume for `@must_consume enum`
// declarations (docs/MUST-CONSUME.md, E067).
// try_marker records an `@try` attribute on the enum decl: the opt-in that
// makes the type usable with `?`. Native enforces the two-variant shape the
// operator lowers against (E078); this side carries the mark so the parse
// round-trips and lowering can key on it. See docs/TRY.md.
// A clone retains its original instantiated type spelling. Typed lowering
// uses this provenance when context completes a partially inferred enum.
pub struct EnumDecl { name: string, variant_names: string[], type_params: string[], line: i32, col: i32, must_consume: boolean, try_marker: boolean, is_pub: boolean, is_package: boolean, module: string, instance: string }

// enum_variant_names extracts the variant names from an enum's desugared
// variant structs.
function enum_variant_names(variants: StructDecl[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < variants.len()) {
    out = out.append(variants[i].name);
    i = i + 1;
  }
  return out;
}

// concat_enums appends two enum-decl lists (used when merging modules).
function concat_enums(a: EnumDecl[], b: EnumDecl[]): EnumDecl[] {
  let out: EnumDecl[] = a;
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

// Helper wraps to satisfy the implicit-union-wrap return-position
// rule. Same pattern lexer.fern uses for Token construction.

function e_number(text: string, suffix: string, is_float: boolean): ast.Expr {
  return ast.ExprNumber { text: text, suffix: suffix, raw: "", is_float: is_float, line: 0, col: 0 };
}

function e_number_at(text: string, suffix: string, is_float: boolean, line: i32, col: i32): ast.Expr {
  return ast.ExprNumber { text: text, suffix: suffix, raw: "", is_float: is_float, line: line, col: col };
}

function e_quoted_at(text: string, suffix: string, raw: string, line: i32, col: i32): ast.Expr {
  return ast.ExprNumber { text: text, suffix: suffix, raw: raw, is_float: false, line: line, col: col };
}

// e_unit_at builds the unit value `()`. Its payload is the constant 0 the
// native compiler lowers its UnitLit to, and `()` is kept as the source
// spelling so the printer writes the unit back rather than the decoded payload.
function e_unit_at(line: i32, col: i32): ast.Expr {
  return ast.ExprNumber { text: "0", suffix: "", raw: "()", is_float: false, line: line, col: col };
}

// discard_name maps a binding name to the name that enters scope. `_` is a
// DISCARD wherever a binding is introduced — a var, a tuple- or
// struct-destructure element, a parameter — so each occurrence gets its own
// internal name: two discards in one scope do not collide, and `_` itself is
// never in scope, so reading it back is an undefined identifier rather than a
// way to recover the value. Renaming rather than binding nothing keeps every
// downstream consumer keyed off a real local, as native's discardName does;
// the printer's written_name reverses it.
pub function discard_name(name: string, line: i32, col: i32, nth: i32): string {
  if (name != "_") {
    return name;
  }
  return "__discard_" + util.i32_to_string(line) + "_" + util.i32_to_string(col) + "_" + util.i32_to_string(nth);
}

// is_unit_literal reads back what e_unit_at wrote: this node is the unit, not
// a written `0`. It is the one thing that tells them apart, since the payload
// is the same constant — the checker types it `void` and the number rules
// (float settling, destination-width reading) skip it.
pub function is_unit_literal(n: ast.ExprNumber): boolean {
  return n.raw == "()";
}

// is_quoted_literal: the node is a character or byte literal (`'a'`, `b'0'`),
// whose `raw` is its quoted spelling. A `0o` / `0b` numeral keeps a `raw` too,
// and is a written numeral like any other.
pub function is_quoted_literal(n: ast.ExprNumber): boolean {
  return n.raw.len() > 0 && (n.raw[0] == b'\'' || n.raw.len() > 1 && n.raw[0] == b'b' && n.raw[1] == b'\'');
}

// is_cast_op reads back what the `as` postfix wrote: a unary operator whose
// name is "as_" followed by the target type's spelling. The `as?` downcast
// writes "as?_" and is deliberately NOT one of these — it tests a runtime
// variant rather than naming a destination type.
pub function is_cast_op(op: string): boolean {
  return op.len() > 3 && slice_unchecked(op, 0, 3) == "as_";
}

// bare_return reports whether a `return`'s value is absent: a bare `return;`
// leaves the `punct:;` placeholder in the value slot.
pub function bare_return(e: ast.Expr): boolean {
  if let ast.ExprUnknown(u) = e {
    return u.kind == "punct:;";
  }
  return is_unit_expr(e);
}

// is_unit_expr asks the same of any expression.
pub function is_unit_expr(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return is_unit_literal(n);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function e_ident(name: string): ast.Expr {
  return ast.ExprIdent { name: name, line: 0, col: 0, ty: "" };
}

function e_ident_at(name: string, line: i32, col: i32): ast.Expr {
  return ast.ExprIdent { name: name, line: line, col: col, ty: "" };
}

function e_string(value: string): ast.Expr {
  return ast.ExprString { value: value, line: 0, col: 0 };
}

function e_string_at(value: string, line: i32, col: i32): ast.Expr {
  return ast.ExprString { value: value, line: line, col: col };
}

pub function e_bool(value: boolean): ast.Expr {
  return ast.ExprBool { value: value, line: 0, col: 0 };
}

// e_bool_at is a written `true` / `false`, carrying its position.
function e_bool_at(value: boolean, line: i32, col: i32): ast.Expr {
  return ast.ExprBool { value: value, line: line, col: col };
}

function e_binary(op: string, left: ast.Expr, right: ast.Expr): ast.Expr {
  return ast.ExprBinary { op: op, left: left, right: right, line: 0, col: 0, ty: "" };
}

function e_binary_at(op: string, left: ast.Expr, right: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprBinary { op: op, left: left, right: right, line: line, col: col, ty: "" };
}

function e_unary(op: string, operand: ast.Expr): ast.Expr {
  return ast.ExprUnary { op: op, operand: operand, line: 0, col: 0, ty: "" };
}

function e_unary_at(op: string, operand: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprUnary { op: op, operand: operand, line: line, col: col, ty: "" };
}

function e_call(callee: ast.Expr, args: ast.Expr[]): ast.Expr {
  return ast.ExprCall { callee: callee, args: args, line: 0, col: 0, type_args: [], ty: "" };
}

function e_call_at(callee: ast.Expr, args: ast.Expr[], line: i32, col: i32): ast.Expr {
  return ast.ExprCall { callee: callee, args: args, line: line, col: col, type_args: [], ty: "" };
}

function e_array(elements: ast.Expr[]): ast.Expr {
  return ast.ExprArray { elements: elements, elem_ty: "", line: 0, col: 0 };
}

function e_array_at(elements: ast.Expr[], line: i32, col: i32): ast.Expr {
  return ast.ExprArray { elements: elements, elem_ty: "", line: line, col: col };
}

function e_tuple_at(elements: ast.Expr[], line: i32, col: i32): ast.Expr {
  return ast.ExprTuple { elements: elements, line: line, col: col };
}

function e_index(array: ast.Expr, index: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprIndex { array: array, index: index, unchecked: false, ty: "", line: line, col: col };
}

function e_slice(array: ast.Expr, start: ast.Expr, end: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprSlice { array: array, start: start, end: end, ty: "", open_end: false, open_start: false, line: line, col: col };
}

// e_slice_open builds `array[start:]` — no upper bound written, so `end`
// is an unevaluated placeholder and every consumer reads the receiver's
// length instead.
function e_slice_open(array: ast.Expr, start: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprSlice { array: array, start: start, end: e_number("0", "", false), ty: "", open_end: true, open_start: false, line: line, col: col };
}

// e_slice_from_start builds `array[:end]`. The omitted low bound is a real
// literal 0, so only the printer needs `open_start` — to write back the
// bound the source left out instead of the zero standing in for it.
function e_slice_from_start(array: ast.Expr, end: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprSlice { array: array, start: e_number("0", "", false), end: end, ty: "", open_end: false, open_start: true, line: line, col: col };
}

// e_slice_all builds `array[:]` — neither bound written.
function e_slice_all(array: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprSlice { array: array, start: e_number("0", "", false), end: e_number("0", "", false), ty: "", open_end: true, open_start: true, line: line, col: col };
}

function e_struct_lit(type_name: string, field_names: string[], field_values: ast.Expr[], line: i32, col: i32): ast.Expr {
  return ast.ExprStructLit { type_name: type_name, field_names: field_names, field_values: field_values, has_base: false, base: e_unknown("no-base"), line: line, col: col, written: "" };
}

// e_struct_update builds a struct-update literal carrying a base
// spread source. The base is the value whose un-overridden fields
// are copied into the new box; the listed fields override.
function e_struct_update(type_name: string, field_names: string[], field_values: ast.Expr[], base: ast.Expr, line: i32, col: i32): ast.Expr {
  return ast.ExprStructLit { type_name: type_name, field_names: field_names, field_values: field_values, has_base: true, base: base, line: line, col: col, written: "" };
}

function e_field_access(obj: ast.Expr, field: string): ast.Expr {
  return ast.ExprFieldAccess { obj: obj, field: field, line: 0, col: 0, ty: "" };
}

function e_field_access_at(obj: ast.Expr, field: string, line: i32, col: i32): ast.Expr {
  return ast.ExprFieldAccess { obj: obj, field: field, line: line, col: col, ty: "" };
}

// e_lambda_at is the one place the ExprLambda literal is written; e_lambda_fn
// and e_lambda_origin route through it. Only the two parses of a lambda the
// source WROTE pass a position — the synthesised ones have none to give; see
// ExprLambda.line. It takes the #5986 sidecar pair because a source lambda can
// be annotated `: (i32) => i32` too, and fn_contract_of at the parse site hands
// it both halves.
function e_lambda_at(params: ast.ParamDecl[], ret_type: string, body: ast.Stmt[], origin: string, line: i32, col: i32, ret_fn_ret: string, ret_fn_param_types: string): ast.Expr {
  return ast.ExprLambda { params: params, ret_type: ret_type, body: body, use_infer: false, origin: origin, line: line, col: col, captures: [], captures_known: false, ret_fn_ret: ret_fn_ret, ret_fn_param_types: ret_fn_param_types };
}

// e_lambda_fn builds a lambda the PARSER synthesised for a declaration that
// RETURNS a function value, carrying the signature `parse_type_name` coarsened
// to the flat "fn" tag. Only a caller holding BOTH halves uses it:
// `fn_tag_spelling` reads the result to decide whether it can rebuild the
// spelling at all, and a result with no parameter list would rebuild `() => R`
// for a function that takes arguments.
function e_lambda_fn(params: ast.ParamDecl[], ret_type: string, body: ast.Stmt[], fn_ret: string, fn_ptys: string): ast.Expr {
  return e_lambda_at(params, ret_type, body, ast.ORIGIN_NESTED_FN, 0, 0, fn_ret, fn_ptys);
}

// e_lambda_origin builds a lambda the PARSER synthesised, labelled
// with the source form it stands in for so `-fmt` reprints that form. "block"
// is a value-position `{ … }`; see ExprLambda.origin.
function e_lambda_origin(params: ast.ParamDecl[], ret_type: string, body: ast.Stmt[], origin: string): ast.Expr {
  return e_lambda_at(params, ret_type, body, origin, 0, 0, "", "");
}

pub function e_unknown(kind: string): ast.Expr {
  return ast.ExprUnknown { kind: kind, line: 0, col: 0 };
}

pub function e_unknown_at(kind: string, line: i32, col: i32): ast.Expr {
  return ast.ExprUnknown { kind: kind, line: line, col: col };
}

function s_var(name: string, type_name: string, init: ast.Expr): ast.Stmt {
  return ast.StmtVar { name: name, type_name: type_name, init: init, line: 0, col: 0, fn_ret: "", fn_param_types: "" };
}

// s_var_at is s_var with an explicit source position (used at the parse
// site so a `let` declaration's diagnostics — E003 / E013 / E020 — point
// at the `let` keyword).
function s_var_at(name: string, type_name: string, init: ast.Expr, line: i32, col: i32): ast.Stmt {
  return ast.StmtVar { name: name, type_name: type_name, init: init, line: line, col: col, fn_ret: "", fn_param_types: "" };
}

// parse_destructure_names consumes `(a, b, …)` with the cursor ON the opening
// `(`, returning the comma-joined binding encoding a tuple-destructure StmtVar
// carries in its name. A NESTED element `(a, (b, c))` encodes as the inner list
// in parens — `"a,(b,c)"` — and lower_var splits on TOP-LEVEL commas, binding
// the parenthesised position to a temp it destructures again. ok=false when an
// element is not a binder: native rejects the same shape, because a literal
// element can fail to match and a destructuring bind has no else branch. The
// count is this level's position count, which the no-singleton-tuples rule
// needs and a comma scan cannot give (a nested position carries its own).
// parse_destructure_names is the depth-guarded face of parse_destructure_names_nested: see MAX_NEST_DEPTH.
function parse_destructure_names(p: Par): (string, i32, boolean, Par) {
  if (p.too_deep()) {
    return ("", 0, false, p.bail());
  }
  let (g0, g1, g2, gq) = parse_destructure_names_nested(p.with_depth(p.depth + 1));
  return (g0, g1, g2, gq.with_depth(p.depth));
}

function parse_destructure_names_nested(p: Par): (string, i32, boolean, Par) {
  let open_line: i32 = p.peek_line();
  let open_col: i32 = p.peek_col();
  p = p.advance();  // consume `(`
  let names: string = "";
  let count: i32 = 0;
  let first: boolean = true;
  while (p.peek_punct() != ")" && !p.at_end()) {
    let part: string = "";
    if (p.peek_punct() == "(") {
      let (inner, inner_n, inner_ok, inner_p) = parse_destructure_names(p);
      p = inner_p;
      if (!inner_ok || inner_n < 2) {
        return ("", 0, false, p);
      }
      part = "(" + inner + ")";
    } else {
      part = p.peek_ident();
      if (part.len() == 0) {
        return ("", 0, false, p);
      }
      part = discard_name(part, open_line, open_col, count);
      p = p.advance();
    }
    if (!first) {
      names = names + ",";
    }
    names = names + part;
    first = false;
    count = count + 1;
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
  }
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  return (names, count, true, p);
}

// parse_struct_pattern_fields consumes the `{ x, y: b, .. }` field list of a
// struct pattern, cursor on the opening `{`. It returns the comma-joined
// BINDING names and the comma-joined FIELD names — the two differ exactly where
// a field is renamed on binding — and ok=false when a non-ident token stands
// where a field name belongs. A trailing `..` marks intentionally-omitted
// fields (partial bind); it binds nothing, so it comes back as its own flag
// for the printer to put back rather than joining either list. Shared by the
// statement form (`let P { x } = E;`) and the parameter form (`P { x }: P`),
// which encode the same binding.
function parse_struct_pattern_fields(p: Par): (string, string, boolean, boolean, Par) {
  p = p.advance();  // consume `{`
  let bindings: string = "";
  let fields: string = "";
  let rest_written: boolean = false;
  let first: boolean = true;
  while (p.peek_punct() != "}" && !p.at_end()) {
    if (p.peek_punct() == "..") {
      p = p.advance();
      rest_written = true;
      break;
    }
    let fld: string = p.peek_ident();
    // Same finiteness argument as the tuple loop: nothing below consumes
    // a non-ident field token, so it has to end the parse.
    if (fld.len() == 0) {
      return ("", "", false, false, p);
    }
    p = p.advance();
    let bind: string = fld;
    if (p.peek_punct() == ":") {
      p = p.advance();
      let bn: string = p.peek_ident();
      if (bn.len() > 0) {
        bind = discard_name(bn, p.peek_line(), p.peek_col(), 0);
        p = p.advance();
      }
    }
    if (!first) {
      bindings = bindings + ",";
      fields = fields + ",";
    }
    bindings = bindings + bind;
    fields = fields + fld;
    first = false;
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (bindings, fields, rest_written, true, p);
}

// parse_struct_destructure consumes `{ x, y: b, .. } = E;` with the cursor
// on the opening `{` (the struct-type name already consumed as `struct_name`).
// It encodes the whole binding as ONE StmtVar the way tuple destructure does:
// `name` carries the comma-joined BINDING names ("x,b"), and `type_name`
// carries the marker "@sd:<StructName>:<comma-joined FIELD names>". semsource
// decodes it into per-field `let bind = tmp.field;`
// binds.
function parse_struct_destructure(p: Par, struct_name: string, at: string, line: i32, col: i32): (ast.Stmt, Par) {
  let (bindings, fields, fields_rest, fields_ok, fields_p) = parse_struct_pattern_fields(p);
  p = fields_p;
  if (!fields_ok) {
    return (s_unknown(p, "a struct destructuring pattern binds field names"), p);
  }
  if (p.peek_punct() == "=") {
    p = p.advance();
  }
  let (init_expr, ip) = parse_expr(p);
  p = ip;
  if (p.peek_punct() == ";") {
    p = p.advance();
  }
  return (s_var_at(bindings, destr_marker(at, fields_rest, "@sd:" + struct_name + ":" + fields), init_expr, line, col), p);
}

function s_return(value: ast.Expr): ast.Stmt {
  return ast.StmtReturn { value: value, line: 0, col: 0 };
}

// s_return_at carries the `return` keyword position so E002 / E012 point at it.
function s_return_at(value: ast.Expr, line: i32, col: i32): ast.Stmt {
  return ast.StmtReturn { value: value, line: line, col: col };
}

function s_expr(value: ast.Expr): ast.Stmt {
  return ast.StmtExpr { value: value, line: 0 };
}

function s_if(cond: ast.Expr, then_body: ast.Stmt[], else_body: ast.Stmt[]): ast.Stmt {
  return s_if_chained(cond, then_body, else_body, false);
}

// s_if_origin is s_if plus the marker naming the source form the `if` was
// desugared FROM, so a later pass can find it again. `assert` uses it: `-O`
// drops the check, and a desugared assert is otherwise indistinguishable from
// a hand-written `if`.
function s_if_origin(cond: ast.Expr, then_body: ast.Stmt[], else_body: ast.Stmt[], origin: string): ast.Stmt {
  return ast.StmtIf { cond: cond, then_body: then_body, else_body: else_body, line: 0, else_chained: false, sugar: no_match_sugar(), origin: origin };
}

// ORIGIN_ASSERT marks the `if (!cond) { eprint(…); exit(1); }` an `assert`
// desugars to. constfold.elide_asserts keys off it.
pub const ORIGIN_ASSERT: string = "assert";

// The value-block origins. Each names the source form whose desugar produced a
// zero-arg call of a zero-param lambda — the shape the lowering INLINES rather than
// calls. is_value_block tests membership of this set, because a hand-written
// IIFE has the identical shape and must NOT be inlined: it is a call with a
// scope of its own, so a `defer` inside it runs when IT returns (#7192).
// ORIGIN_BLOCK doubles as the printer's flag for reprinting `{ … }`.
pub const ORIGIN_BLOCK: string = "block";

pub const ORIGIN_MATCH_EXPR: string = "match_expr";

pub const ORIGIN_IF_EXPR: string = "if_expr";

pub const ORIGIN_ARR_COMP: string = "arr_comp";

pub const ORIGIN_MAP_COMP: string = "map_comp";

// ORIGIN_IIFE_SCOPED marks a hand-written IIFE whose body the defer lowering
// scoped as its own — i.e. one that actually contains a defer. It is NOT a
// value-block origin: the lowering must CALL it, because inlining would splice the
// defer machinery into the enclosing function and hoist the cleanup with it.
//
// A defer-free IIFE is left unmarked: the lambda lift hoists it to a direct
// `__lam_N` call either way (lift.lift_capturing_iife for a capturing one),
// and only one the lift declines is inlined.
pub const ORIGIN_IIFE_SCOPED: string = "iife_scoped";

// DFA_TRYALL and DFA_TRYERR are the always-false flags the defer lowering
// declares in every scope it lowers, guarding the cleanup a `?` exit owes:
// plain defers behind the first, errdefers behind the second.
pub const DFA_TRYALL: string = "__dfa_tryall";

pub const DFA_TRYERR: string = "__dfa_tryerr";

// ORIGIN_USE marks the callback lambda a `use NAME[: TYPE] <- CALL;` desugars
// to, appended as CALL's last argument. The printer reads it back to reprint
// the `use`; nothing else treats the lambda differently from a written one,
// which is what is_written_lambda_origin admitting it keeps true.
pub const ORIGIN_USE: string = "use";

// no_match_sugar is the empty MatchSugar every StmtIf but the two match
// desugars carries.
pub function no_match_sugar(): ast.MatchSugar {
  let no_tup: ast.TupArm[] = [];
  let no_struct: ast.StructArm[] = [];
  let no_lit: ast.LitArm[] = [];
  let no_arms: ast.MatchArm[] = [];
  return ast.MatchSugar { scrut: e_unknown(""), tup: no_tup, strct: no_struct, lits: no_lit, arms: no_arms, line: 0, col: 0, origin: "" };
}

// s_if_match wraps the done-flag chain a tuple- or struct-scrutinee match
// desugars to, carrying the arms as WRITTEN so the printer reprints the match.
function s_if_match(body: ast.Stmt[], sugar: ast.MatchSugar): ast.Stmt {
  let no_else: ast.Stmt[] = [];
  return ast.StmtIf { cond: e_bool(true), then_body: body, else_body: no_else, line: sugar.line, else_chained: false, sugar: sugar, origin: "" };
}

// s_if_chained is s_if for the one caller that knows how the else was WRITTEN:
// the `if` statement parse. Every other construction is synthesised, and a
// synthesised else-body is printed in block form (both spellings re-parse to
// the same AST, so only source fidelity is at stake).
function s_if_chained(cond: ast.Expr, then_body: ast.Stmt[], else_body: ast.Stmt[], chained: boolean): ast.Stmt {
  return ast.StmtIf { cond: cond, then_body: then_body, else_body: else_body, line: 0, else_chained: chained, sugar: no_match_sugar(), origin: "" };
}

// s_if_tagged is a scoping `if (true) { … }` labelled with the source form it
// stands in for, so `-fmt` reprints that form rather than the scope.
function s_if_tagged(body: ast.Stmt[], origin: string): ast.Stmt {
  let no_else: ast.Stmt[] = [];
  return ast.StmtIf { cond: e_bool(true), then_body: body, else_body: no_else, line: 0, else_chained: false, sugar: no_match_sugar(), origin: origin };
}

// s_block is the bare `{ … }` statement.
function s_block(body: ast.Stmt[]): ast.Stmt {
  return s_if_tagged(body, "block");
}

function s_while(cond: ast.Expr, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtWhile { cond: cond, body: body, label: "", line: 0, is_loop: false };
}

function s_for(var_name: string, iter: ast.Expr, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtFor { var_name: var_name, iter: iter, body: body, label: "", line: 0 };
}

// with_loop_label stamps a parsed loop label onto a freshly-built while/for loop
// (a no-op for the empty label or a non-loop stmt). `loop`/for-range parse helpers
// return a StmtWhile/StmtFor; this re-wraps it carrying the label.
function with_loop_label(st: ast.Stmt, label: string): ast.Stmt {
  if (label.len() == 0) {
    return st;
  }
  match (st) {
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: w.cond, body: w.body, label: label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: fr.body, label: label, line: fr.line };
    },
    ast.StmtIf(f) => {
      // A C-style `for` desugars to `if (true) { INIT; let __forc_…;
      // while (true) { … } }` (parse_for_stmt), so the source label
      // belongs to that inner while — without this a `break outer`
      // inside the loop finds no loop carrying the name.
      let n: i32 = f.then_body.len();
      if (n == 0) {
        return st;
      }
      match (f.then_body[n - 1]) {
        ast.StmtWhile(w2) => {
          let relabelled: ast.Stmt[] = [];
          let i: i32 = 0;
          while (i < n - 1) {
            relabelled = relabelled.append(f.then_body[i]);
            i = i + 1;
          }
          relabelled = relabelled.append(ast.StmtWhile { cond: w2.cond, body: w2.body, label: label, line: w2.line, is_loop: w2.is_loop });
          return ast.StmtIf { ...f, cond: f.cond, then_body: relabelled, else_body: f.else_body };
        },
        _ => {
          return st;
        }
      }
      return st;
    },
    _ => {
      return st;
    }
  }
  return st;
}

function s_break(): ast.Stmt {
  return ast.StmtBreak { tag: 0, line: 0, col: 0, label: "" };
}

function s_assign(target: string, value: ast.Expr): ast.Stmt {
  return ast.StmtAssign { target: target, value: value, line: 0, col: 0, target_line: 0, target_col: 0 };
}

// s_assign_at carries the `=`-token position (line/col, where E003 points)
// and the target identifier's position (target_line/target_col, where the
// Go checker reports E001 for an undefined assignment target).
function s_assign_at(target: string, value: ast.Expr, line: i32, col: i32, target_line: i32, target_col: i32): ast.Stmt {
  return ast.StmtAssign { target: target, value: value, line: line, col: col, target_line: target_line, target_col: target_col };
}

function s_match(scrutinee: ast.Expr, arms: ast.MatchArm[]): ast.Stmt {
  let no_sugar: ast.MatchArm[] = [];
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: 0, col: 0, origin: "", sugar: no_sugar };
}

function s_match_at(scrutinee: ast.Expr, arms: ast.MatchArm[], line: i32, col: i32): ast.Stmt {
  let no_sugar: ast.MatchArm[] = [];
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: "", sugar: no_sugar };
}

// s_match_sugared is s_match_at plus the written-form arms for the printer.
function s_match_sugared(scrutinee: ast.Expr, arms: ast.MatchArm[], sugar: ast.MatchArm[], line: i32, col: i32): ast.Stmt {
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: "", sugar: sugar };
}

// array_builder_elem extracts T from an "ArrayBuilder[T]" type spelling
// (the self-host parser keeps param types as strings). Returns "" when the
// spelling isn't ArrayBuilder[...]. See docs/ARRAY-BUILDER-PLAN.md.
function array_builder_elem(t: string): string {
  let prefix: string = "ArrayBuilder[";
  let pl: i32 = prefix.len();
  if (t.len() < pl + 1) {
    return "";
  }
  if (t[t.len() - 1] != b']') {
    return "";
  }
  // Manual prefix match (parser.fern doesn't import std/string for
  // starts_with) — byte-compare against "ArrayBuilder[".
  let i: i32 = 0;
  while (i < pl) {
    if (t[i] != prefix[i]) {
      return "";
    }
    i = i + 1;
  }
  return slice_unchecked(t, pl, t.len() - 1) + "";
}

// is_builder_mutation is true when `c` is `b.append(...)` / `b.with(...)` /
// `b.insert(...)` — an in-place builder mutation that becomes a reassignment.
// `insert` covers the Map.build builder (`b.insert(k, v)`).
function is_builder_mutation(c: ast.ExprCall, b: string): boolean {
  match (c.callee) {
    ast.ExprFieldAccess(fa) => {
      if (fa.field != "append" && fa.field != "with" && fa.field != "insert") {
        return false;
      }
      match (fa.obj) {
        ast.ExprIdent(id) => {
          return id.name == b;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// rewrite_builder_stmt retargets statement-position `b.append(...)` /
// `b.with(...)` into `b = b.append(...)`, recursing into every statement
// container so a builder mutated inside a loop / branch is handled. A
// builder call left unrewritten (e.g. inside a nested lambda, not descended
// into) stays a discarded value-returning result and trips E055 — reported, not
// a silent lost write.
function rewrite_builder_stmt(s: ast.Stmt, b: string): ast.Stmt {
  match (s) {
    ast.StmtExpr(es) => {
      match (es.value) {
        ast.ExprCall(c) => {
          if (is_builder_mutation(c, b)) {
            return s_assign(b, es.value);
          }
          return s;
        },
        _ => {
          return s;
        }
      }
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: f.cond, then_body: rewrite_builder_stmts(f.then_body, b), else_body: rewrite_builder_stmts(f.else_body, b) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: w.cond, body: rewrite_builder_stmts(w.body, b), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: rewrite_builder_stmts(fr.body, b), label: fr.label, line: fr.line };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let ai: i32 = 0;
      while (ai < m.arms.len()) {
        let arm: ast.MatchArm = m.arms[ai];
        arms = arms.append(ast.MatchArm { ...arm, body: rewrite_builder_stmts(arm.body, b) });
        ai = ai + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: m.scrutinee, arms: arms };
    },
    _ => {
      return s;
    }
  }
  return s;
}

function rewrite_builder_stmts(stmts: ast.Stmt[], b: string): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(rewrite_builder_stmt(stmts[i], b));
    i = i + 1;
  }
  return out;
}

// maybe_desugar_array_build lowers `Array.build((b: ArrayBuilder[T]):
// void { BODY })` into a unique-local IIFE — the self-host mirror of the Go
// parser desugar (docs/ARRAY-BUILDER-PLAN.md). Returns `base` unchanged when
// it isn't a well-formed Array.build call.
function maybe_desugar_array_build(base: ast.Expr): ast.Expr {
  match (base) {
    ast.ExprCall(call) => {
      match (call.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "build") {
            return base;
          }
          match (fa.obj) {
            ast.ExprIdent(id) => {
              if (id.name != "Array") {
                return base;
              }
              if (call.args.len() != 1) {
                return base;
              }
              match (call.args[0]) {
                ast.ExprLambda(lam) => {
                  if (lam.params.len() != 1) {
                    return base;
                  }
                  let elem: string = array_builder_elem(lam.params[0].type_name);
                  if (elem.len() == 0) {
                    return base;
                  }
                  let bname: string = lam.params[0].name;
                  let arrty: string = elem + "[]";
                  let stmts: ast.Stmt[] = [];
                  stmts = stmts.append(s_var(bname, arrty, e_array([])));
                  let rewritten: ast.Stmt[] = rewrite_builder_stmts(lam.body, bname);
                  let ri: i32 = 0;
                  while (ri < rewritten.len()) {
                    stmts = stmts.append(rewritten[ri]);
                    ri = ri + 1;
                  }
                  stmts = stmts.append(s_return(e_ident(bname)));
                  let iife: ast.Expr = ast.ExprLambda { params: [], ret_type: arrty, body: stmts, use_infer: false, origin: ORIGIN_ARR_COMP, line: 0, col: 0, captures: [], captures_known: false, ret_fn_ret: "", ret_fn_param_types: "" };
                  return ast.ExprCall { callee: iife, args: [], line: call.line, col: call.col, type_args: [], ty: "" };
                },
                _ => {
                  return base;
                }
              }
            },
            _ => {
              return base;
            }
          }
        },
        _ => {
          return base;
        }
      }
    },
    _ => {
      return base;
    }
  }
  return base;
}

// map_builder_inner extracts "K, V" from a "MapBuilder[K, V]" type spelling
// (kept as a string by the self-host parser). Returns "" when the spelling
// isn't MapBuilder[...]. The map sibling of array_builder_elem.
function map_builder_inner(t: string): string {
  let prefix: string = "MapBuilder[";
  let pl: i32 = prefix.len();
  if (t.len() < pl + 1) {
    return "";
  }
  if (t[t.len() - 1] != b']') {
    return "";
  }
  let i: i32 = 0;
  while (i < pl) {
    if (t[i] != prefix[i]) {
      return "";
    }
    i = i + 1;
  }
  return slice_unchecked(t, pl, t.len() - 1) + "";
}

// maybe_desugar_map_build lowers `Map.build((b: MapBuilder[K, V]):
// void { BODY })` into a unique-local IIFE — the map sibling of
// maybe_desugar_array_build (docs/ARRAY-BUILDER-PLAN.md). `b` is a fresh
// non-escaping map so every `b.insert(k, v)` (rewritten to `b = b.insert(...)`)
// is the in-place fast path. Returns `base` unchanged when it isn't a
// well-formed Map.build call.
function maybe_desugar_map_build(base: ast.Expr): ast.Expr {
  match (base) {
    ast.ExprCall(call) => {
      match (call.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "build") {
            return base;
          }
          match (fa.obj) {
            ast.ExprIdent(id) => {
              if (id.name != "Map") {
                return base;
              }
              if (call.args.len() != 1) {
                return base;
              }
              match (call.args[0]) {
                ast.ExprLambda(lam) => {
                  if (lam.params.len() != 1) {
                    return base;
                  }
                  let inner: string = map_builder_inner(lam.params[0].type_name);
                  if (inner.len() == 0) {
                    return base;
                  }
                  let bname: string = lam.params[0].name;
                  let mapty: string = "Map[" + inner + "]";
                  let cargs: ast.Expr[] = [];
                  cargs = cargs.append(e_number("8", "", false));
                  let stmts: ast.Stmt[] = [];
                  stmts = stmts.append(s_var(bname, mapty, e_call(e_ident("map_new"), cargs)));
                  let rewritten: ast.Stmt[] = rewrite_builder_stmts(lam.body, bname);
                  let ri: i32 = 0;
                  while (ri < rewritten.len()) {
                    stmts = stmts.append(rewritten[ri]);
                    ri = ri + 1;
                  }
                  stmts = stmts.append(s_return(e_ident(bname)));
                  let iife: ast.Expr = ast.ExprLambda { params: [], ret_type: mapty, body: stmts, use_infer: false, origin: ORIGIN_MAP_COMP, line: 0, col: 0, captures: [], captures_known: false, ret_fn_ret: "", ret_fn_param_types: "" };
                  return ast.ExprCall { callee: iife, args: [], line: call.line, col: call.col, type_args: [], ty: "" };
                },
                _ => {
                  return base;
                }
              }
            },
            _ => {
              return base;
            }
          }
        },
        _ => {
          return base;
        }
      }
    },
    _ => {
      return base;
    }
  }
  return base;
}

// s_match_origin is s_match_at tagged with the desugar that produced it
// ("if_let" / "let_else"); see StmtMatch.origin.
function s_match_origin(scrutinee: ast.Expr, arms: ast.MatchArm[], line: i32, col: i32, origin: string): ast.Stmt {
  let no_sugar: ast.MatchArm[] = [];
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: origin, sugar: no_sugar };
}

// s_match_origin_sugared is s_match_origin plus the written-form arms.
function s_match_origin_sugared(scrutinee: ast.Expr, arms: ast.MatchArm[], sugar: ast.MatchArm[], line: i32, col: i32, origin: string): ast.Stmt {
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: origin, sugar: sugar };
}

function p_variant(type_name: string, binding: string): ast.Pattern {
  let no_extra: string[] = [];
  let no_nested: ast.Pattern[] = [];
  let no_tup_kinds: i32[] = [];
  let no_tup_binds: string[] = [];
  let no_tup_lits: ast.Expr[] = [];
  let no_tup_pats: ast.Pattern[] = [];
  return ast.PatVariant { type_name: type_name, binding: binding, extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
}

// p_variant_n builds a variant pattern binding N payloads as `<prefix>0` …
// `<prefix>N-1`. p_variant's single `binding` covers only the first, which is
// why every @derive synthesiser over enum variants silently ignored payloads
// past it — a `Rect(2, 3)` compared, hashed and rendered as if it were
// `Rect(2)`. n <= 0 binds nothing (a unit variant).
function p_variant_n(type_name: string, prefix: string, n: i32): ast.Pattern {
  if (n <= 0) {
    return p_variant(type_name, "");
  }
  let extra: string[] = [];
  let i: i32 = 1;
  while (i < n) {
    extra = extra.append(prefix + dl_itoa(i));
    i = i + 1;
  }
  let no_nested: ast.Pattern[] = [];
  let no_tup_kinds: i32[] = [];
  let no_tup_binds: string[] = [];
  let no_tup_lits: ast.Expr[] = [];
  let no_tup_pats: ast.Pattern[] = [];
  return ast.PatVariant { type_name: type_name, binding: prefix + "0", extra_bindings: extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
}

// fold_lit_cond moves a pattern's implied literal-payload condition onto the
// arm being built and clears it from the pattern. Call it at every point the
// PARSER turns a freshly parsed Pattern into a MatchArm — the outer arm for a
// direct slot, build_merged_arm's inner arm for a nested one. After the fold
// the arm is an ordinary guarded arm, so no later stage needs to know literal
// payload slots exist.
function fold_lit_cond(pat: ast.Pattern, guard: ast.Expr, has_guard: boolean): (ast.Pattern, ast.Expr, boolean) {
  match (pat) {
    ast.PatVariant(pv) => {
      if (!pv.has_lit_cond) {
        return (pat, guard, has_guard);
      }
      let no_tup_kinds: i32[] = [];
      let no_tup_binds: string[] = [];
      let no_tup_lits: ast.Expr[] = [];
      let no_tup_pats: ast.Pattern[] = [];
      let cleared: ast.Pattern = ast.PatVariant { ...pv, lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
      if (!has_guard) {
        return (cleared, pv.lit_cond, true);
      }
      return (cleared, e_binary("&&", pv.lit_cond, guard), true);
    },
    _ => {
      return (pat, guard, has_guard);
    }
  }
}

function p_wildcard(): ast.Pattern {
  return ast.PatWildcard { tag: 0 };
}

// decl_sentinel is a `decl:` sentinel at the cursor: parse_unknown_errors_module
// reports its text as P001, for a declaration part the parser discards rather
// than records, so no declaration gate could see it.
function decl_sentinel(p: Par, text: string): ast.Stmt {
  return s_unknown(p, "decl:" + text);
}

// sync_to_top_level steps to the next token that can open a top-level
// declaration, as native's syncToTopLevel does, so the rest of a malformed one
// raises no diagnostics of its own.
function sync_to_top_level(p: Par): Par {
  let q: Par = p;
  while (!q.at_end()) {
    let kw: string = q.peek_keyword();
    if (kw == "function" || kw == "struct" || kw == "enum" || kw == "import" || kw == "const" || kw == "trait" || kw == "impl" || kw == "pub") {
      return q;
    }
    q = q.advance();
  }
  return q;
}

// skip_body_item steps past the rest of a malformed trait or impl body item: to
// a `;` at depth 0 (consumed), past a `{ … }` block, or up to the body's own `}`
// (left for the caller), so one bad item raises one diagnostic.
function skip_body_item(p: Par): Par {
  let q: Par = p;
  let depth: i32 = 0;
  while (!q.at_end()) {
    let pc: string = q.peek_punct();
    if (depth == 0 && pc == "}") {
      return q;
    }
    if (depth == 0 && pc == ";") {
      return q.advance();
    }
    if (pc == "{") {
      depth = depth + 1;
    }
    if (pc == "}") {
      depth = depth - 1;
      if (depth == 0) {
        return q.advance();
      }
    }
    q = q.advance();
  }
  return q;
}

// malformed_fn_decl_message is the one text for a function declaration the
// parser returned nameless. parse_func_decl does that for several causes it
// does not tell apart, so the message names none of them as the cause.
pub function malformed_fn_decl_message(): string {
  return "malformed function declaration: its name or signature could not be read (a keyword such as `use`, `type` or `match` cannot be a name)";
}

// s_unknown builds the statement-level parse-error sentinel at the position of
// the token the parser stopped on. It takes the parser rather than offering a
// positionless overload so a sentinel cannot be raised without a position.
function s_unknown(p: Par, kind: string): ast.Stmt {
  return s_unknown_at(kind, p.peek_line(), p.peek_col());
}

// s_unknown_at serves the desugars that hold a construct's position directly
// (the `match` keyword) rather than a parser cursor.
function s_unknown_at(kind: string, line: i32, col: i32): ast.Stmt {
  return ast.StmtUnknown { kind: kind, line: line, col: col };
}

// tok_spelling is a token as an "expected …, got X" diagnostic quotes it.
function tok_spelling(t: lexer.Token): string {
  match (t) {
    lexer.TokPunct(x) => {
      return x.text;
    },
    lexer.TokIdent(x) => {
      return x.name;
    },
    lexer.TokKeyword(x) => {
      return x.name;
    },
    lexer.TokNumber(x) => {
      return x.text;
    },
    lexer.TokString(x) => {
      return x.value;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// defer_action is `st`, parsed at `p` after `defer`, when it is a block, an
// expression (`assert(...)` among them, which parses to its desugared `if`) or
// an assignment, and a P001 at its first token otherwise.
function defer_action(st: ast.Stmt, p: Par): ast.Stmt {
  if let ast.StmtExpr(_) = st {
    return st;
  }
  if let ast.StmtAssign(_) = st {
    return st;
  }
  if let ast.StmtUnknown(_) = st {
    return st;
  }
  if let ast.StmtIf(f) = st {
    if (f.origin == "block" || f.origin == ORIGIN_ASSERT) {
      return st;
    }
  }
  return decl_sentinel(p, "unexpected token \"" + tok_spelling(p.peek()) + "\"");
}

function s_defer(action: ast.Stmt): ast.Stmt {
  return ast.StmtDefer { action: action, on_error: 0, line: 0 };
}

function s_errdefer(action: ast.Stmt): ast.Stmt {
  return ast.StmtDefer { action: action, on_error: 1, line: 0 };
}

// label_depth returns the relative loop depth of `name` in the enclosing-loop
// label stack (the last entry is the innermost loop), or -1 if absent. Depth 0 is
// the innermost loop, 1 its enclosing loop, and so on.
function label_depth(labels: string[], name: string): i32 {
  let i: i32 = labels.len() - 1;
  while (i >= 0) {
    if (labels[i] == name) {
      return labels.len() - 1 - i;
    }
    i = i - 1;
  }
  return 0 - 1;
}

// resolve_labels_stmt rewrites a labeled `break`/`continue`'s `tag` to the
// relative loop depth of its target label, recursing through every statement
// container (if / while / for / match / defer) so a break/continue
// anywhere in the nest is resolved against the live enclosing-loop label stack
// (`labels`; "" for an unlabeled loop). An unlabeled break/continue keeps tag 0
// (the innermost loop). This runs on the RAW parsed module before any desugar
// pass, so the loop labels are still in place and every downstream pass only has
// to carry the already-resolved `tag` (which break/continue stmts preserve by
// identity through those passes).
function resolve_labels_stmt(st: ast.Stmt, labels: string[]): ast.Stmt {
  match (st) {
    ast.StmtBreak(b) => {
      if (b.label.len() == 0) {
        return st;
      }
      let d: i32 = label_depth(labels, b.label);
      if (d < 0) {
        d = 0;
      }
      return ast.StmtBreak { tag: d, line: b.line, col: b.col, label: b.label };
    },
    ast.StmtContinue(c) => {
      if (c.label.len() == 0) {
        return st;
      }
      let d2: i32 = label_depth(labels, c.label);
      if (d2 < 0) {
        d2 = 0;
      }
      return ast.StmtContinue { tag: d2, line: c.line, col: c.col, label: c.label };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: rl_expr(w.cond, labels), body: resolve_labels_block(w.body, labels.append(w.label)), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: rl_expr(fr.iter, labels), body: resolve_labels_block(fr.body, labels.append(fr.label)), label: fr.label, line: fr.line };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: rl_expr(f.cond, labels), then_body: resolve_labels_block(f.then_body, labels), else_body: resolve_labels_block(f.else_body, labels) };
    },
    ast.StmtMatch(m) => {
      let arms2: ast.MatchArm[] = [];
      let ai: i32 = 0;
      while (ai < m.arms.len()) {
        let a: ast.MatchArm = m.arms[ai];
        let ag: ast.Expr = a.guard;
        if (a.has_guard) {
          ag = rl_expr(a.guard, labels);
        }
        arms2 = arms2.append(ast.MatchArm { ...a, body: resolve_labels_block(a.body, labels), guard: ag });
        ai = ai + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: rl_expr(m.scrutinee, labels), arms: arms2 };
    },
    ast.StmtDefer(dd) => {
      return ast.StmtDefer { action: resolve_labels_stmt(dd.action, labels), on_error: dd.on_error, line: dd.line };
    },
    ast.StmtVar(v) => {
      // The statement forms whose EXPRESSIONS can hold a lambda. Without these
      // the `_` arm returned them untouched, so a labeled loop inside a lambda
      // body was never resolved and its `break`/`continue` degraded to tag 0 —
      // the innermost loop. `break outer` silently broke the wrong loop, and
      // `continue outer` re-entered the inner loop forever (#7199).
      return ast.StmtVar { ...v, init: rl_expr(v.init, labels) };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: rl_expr(r.value, labels) };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: rl_expr(x.value, labels) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: rl_expr(a.value, labels) };
    },
    _ => {
      return st;
    }
  }
  return st;
}

// rl_expr resolves the labels of any loop living inside an EXPRESSION — in
// practice a lambda body, which is a statement list no statement walk reaches.
//
// A LAMBDA gets a FRESH scope: a label does not cross a function boundary, and
// native rejects `break outer` from inside one with "E011: break outside of a
// loop", so leaking the enclosing labels in would resolve a jump the language
// forbids. A VALUE BLOCK is the opposite — it matches the same shape (a
// zero-arg call of a zero-param lambda) but is an if-/match-expression or
// comprehension desugar that the lowering INLINES, so `t = t + { if (c) { break; } i }`
// breaks the enclosing loop and must keep seeing its labels.
function rl_expr(e: ast.Expr, labels: string[]): ast.Expr {
  match (e) {
    ast.ExprLambda(lm) => {
      let fresh: string[] = [];
      return ast.ExprLambda { ...lm, body: resolve_labels_block(lm.body, fresh) };
    },
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        return dl_vb_rebuild(c, resolve_labels_block(vb_body(c), labels));
      }
      return rl_expr_kids(e, labels);
    },
    _ => {
      return rl_expr_kids(e, labels);
    }
  }
  return e;
}

function rl_expr_kids(e: ast.Expr, labels: string[]): ast.Expr {
  return map_expr_kids(e, (k: ast.Expr): ast.Expr => rl_expr(k, labels));
}

function resolve_labels_block(stmts: ast.Stmt[], labels: string[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(resolve_labels_stmt(stmts[i], labels));
    i = i + 1;
  }
  return out;
}

// resolve_labels_module bakes each labeled break/continue's relative loop depth
// into its `tag` (see resolve_labels_stmt). Runs first in the prepare pipeline,
// on the freshly parsed module.
pub function resolve_labels_module(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  let none: string[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    if (has_labeled_jump(fd.body)) {
      fd = FuncDecl { ...fd, body: resolve_labels_block(fd.body, none) };
    }
    funcs = funcs.append(fd);
    i = i + 1;
  }
  return Module { ...mod, funcs: funcs, top_stmts: resolve_labels_block(mod.top_stmts, none) };
}

// has_labeled_jump: some `break`/`continue` in `stmts` names a label, the only
// statements resolve_labels_block changes.
function has_labeled_jump(stmts: ast.Stmt[]): boolean {
  let found: boolean = false;
  for st in stmts {
    found = astwalk.fold_stmt_nodes(st, found, labeled_jump_at, keep_flag, astwalk.descend_all);
  }
  return found;
}

function labeled_jump_at(st: ast.Stmt, own acc: boolean): boolean {
  if let ast.StmtBreak(b) = st {
    return acc || b.label.len() > 0;
  }
  if let ast.StmtContinue(c) = st {
    return acc || c.label.len() > 0;
  }
  return acc;
}

function keep_flag(e: ast.Expr, own acc: boolean): boolean {
  return acc;
}

// Parser state. `toks` is the lexer's output; `pos` is the
// current cursor into it. We mutate via value-semantics (return
// fresh Par from each consume()).

// `no_struct` suppresses the `Ident { … }` / `pkg.Type { … }`
// struct-literal shortcut in parse_primary while parsing an
// expression whose trailing `{` opens a block instead — the
// `for VAR in EXPR { body }` iter being the motivating case
// (`for x in a {}` must read `a` + an empty block, not the empty
// struct literal `a {}`). Set true only around the iter parse and
// restored afterward; it is carried through advance() so it stays in
// force for the whole iter sub-expression, matching the Go
// parser's noStructLit (which likewise blocks nested struct lits
// in the iter — `for x in f(Foo{…})` is rejected on both).
// `map_kind` is the KEY KIND a `Map { … }` literal about to be parsed should be
// built with — 1 for i32, 0 for string, -1 for "no annotation, guess". Set by
// the var-decl parser from the declared type and consumed by parse_map_lit,
// the same parse-context shape as no_struct. It reaches ONLY a literal: a
// hand-written `map_new(8).insert(1, 10)` chain keeps the constructor the
// author wrote, so the E038 gate on it (asmcore.check_map_new_chain, which
// mirrors a native rejection) still fires.
// structnames lists every struct DECLARED in this token stream. A match arm
// `Rect { w, h }` is spelled exactly like the struct pattern `Point { x, y }`,
// and which one it is depends on the scrutinee's type, which the parser does not
// know — so it decides on the name: a locally-declared struct takes the
// struct-pattern desugar, anything else (a record-form enum variant, or a name
// from an import) takes the variant path. The tie goes to the variant because a
// record variant destructured by name is otherwise unparseable — the `{` ends
// the arm and the rest of the file is reinterpreted (#6676) — while a struct
// pattern on an imported struct has never been written here. Pre-scanned once
// per stream rather than accumulated as decls are parsed, so a match written
// ahead of the struct it destructures still resolves.
// verbatim keeps the WRITTEN spelling of a type where the compile parse
// canonicalises it — a `[T]` view erased to `T[]`, a function type coarsed to
// the flat `fn` tag (#6773). Only `-fmt` sets it: those canonicalisations are
// what every downstream `== "fn"` dispatch site reads, and the formatter is
// the one consumer that parses without compiling.
// type_errs holds a `decl:` sentinel for each type position whose token
// starts no type (native's P001 "expected type"); parse_module_flagged reports
// them with the top-level statements.
// todos is the position of every `todo` stub parsed so far (Module.todo_sites).
struct Par { toks: lexer.Token[], pos: i32, no_struct: boolean, map_kind: i32, structnames: string[], verbatim: boolean, depth: i32, type_errs: ast.Stmt[], todos: TodoSite[] }

// scan_struct_names walks the token stream for `struct N` / `pub struct N`
// declarations and returns the names. A shape scan, not a parse: `struct` is a
// keyword, so the ident that follows one is always a declared struct name.
function scan_struct_names(toks: lexer.Token[]): string[] {
  let out: string[] = [];
  let q: Par = Par { toks: toks, pos: 0, no_struct: false, map_kind: 0 - 1, structnames: out, verbatim: false, depth: 0, type_errs: [], todos: [] };
  while (!q.at_end()) {
    if (q.peek_keyword() != "struct") {
      q = q.advance();
      continue;
    }
    q = q.advance();
    let nm: string = q.peek_ident();
    if (nm.len() > 0) {
      out = out.append(nm);
      q = q.advance();
    }
  }
  return out;
}

function (p: Par) at_end(): boolean {
  if (p.pos >= p.toks.len()) {
    return true;
  }
  let t: lexer.Token = p.toks[p.pos];
  match (t) {
    lexer.TokEof(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function (p: Par) peek(): lexer.Token {
  if (p.pos < p.toks.len()) {
    return p.toks[p.pos];
  }
  return lexer.eof_tok(0, 0);
}

// peek_line / peek_col return the 1-based source position of the current
// token (0 when unavailable) — every token variant carries line/col, so
// the parser can stamp positions onto the AST nodes it builds.
function (p: Par) peek_line(): i32 {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokEof(x) => {
      return x.line;
    },
    lexer.TokNumber(x) => {
      return x.line;
    },
    lexer.TokIdent(x) => {
      return x.line;
    },
    lexer.TokKeyword(x) => {
      return x.line;
    },
    lexer.TokPunct(x) => {
      return x.line;
    },
    lexer.TokString(x) => {
      return x.line;
    },
    lexer.TokError(x) => {
      return x.line;
    },
    lexer.TokFString(x) => {
      return x.line;
    }
  }
  return 0;
}

function (p: Par) peek_col(): i32 {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokEof(x) => {
      return x.col;
    },
    lexer.TokNumber(x) => {
      return x.col;
    },
    lexer.TokIdent(x) => {
      return x.col;
    },
    lexer.TokKeyword(x) => {
      return x.col;
    },
    lexer.TokPunct(x) => {
      return x.col;
    },
    lexer.TokString(x) => {
      return x.col;
    },
    lexer.TokError(x) => {
      return x.col;
    },
    lexer.TokFString(x) => {
      return x.col;
    }
  }
  return 0;
}

function (p: Par) advance(): Par {
  return Par { toks: p.toks, pos: p.pos + 1, no_struct: p.no_struct, map_kind: p.map_kind, structnames: p.structnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos };
}

// with_no_struct returns a cursor with the struct-literal-suppression
// flag set as given (position unchanged).
// expected_type records that the cursor's token starts no type, where one is
// required: native's P001 "expected type, got X".
function (p: Par) expected_type(): Par {
  return Par { ...p, type_errs: p.type_errs.append(s_unknown(p, "decl:expected type, got \"" + tok_spelling(p.peek()) + "\"")) };
}

function (p: Par) with_no_struct(v: boolean): Par {
  return Par { toks: p.toks, pos: p.pos, no_struct: v, map_kind: p.map_kind, structnames: p.structnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos };
}

function (p: Par) with_map_kind(v: i32): Par {
  return Par { toks: p.toks, pos: p.pos, no_struct: p.no_struct, map_kind: v, structnames: p.structnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos };
}

// MAX_NEST_DEPTH bounds recursive descent. Past it the parse stops with a
// "nest:too-deep" sentinel instead of running the stack out — a native build
// gets no fatal-error diagnostic for that, just SIGSEGV, so the depth has to
// be refused before the hardware notices. Chosen to match what native's
// internal/syntax/parser accepts (its own budget is 5000 units at ~2 units per
// nesting level), so the two front ends agree on which programs are legal.
// Both count ~2 units per parenthesised level, so the same number here and in
// native's maxNestDepth puts the two acceptance thresholds on top of each
// other — pinned by TestSelfHostDeepNestingMatchesNativeAndDoesNotCrash. The
// deepest source in this repository nests 183 levels.
const MAX_NEST_DEPTH: i32 = 5000;

// BLOCK_NEST_UNITS is what one nested block costs against MAX_NEST_DEPTH. A
// unit has to cost about the same stack whichever construct spends it, and a
// block does not: its level runs through the statement machinery and costs
// roughly four times the stack of a parenthesis level — on an 8 MiB stack the
// compiled compiler crashed between 1000 and 1100 nested `{` (about 2100 units
// at one unit a block) where 2400 nested `(` parsed. At 8 units the deepest
// block nesting the bound admits (about 550 levels) sits under half of that
// crash point. Native's blockNestUnits is the same number.
const BLOCK_NEST_UNITS: i32 = 8;

function (p: Par) with_depth(v: i32): Par {
  return Par { toks: p.toks, pos: p.pos, no_struct: p.no_struct, map_kind: p.map_kind, structnames: p.structnames, verbatim: p.verbatim, depth: v, type_errs: p.type_errs, todos: p.todos };
}

// too_deep reports whether entering one more recursive-descent level would
// cross the bound.
function (p: Par) too_deep(): boolean {
  return p.too_deep_by(1);
}

// too_deep_by is too_deep for a construct that costs `units` rather than one.
function (p: Par) too_deep_by(units: i32): boolean {
  return p.depth + units > MAX_NEST_DEPTH;
}

// bail parks the cursor on the final token so every `while (!q.at_end())`
// loop above the guard unwinds at once. Returning the cursor unmoved would
// leave those loops spinning on a position that never advances, turning a
// depth refusal into a hang.
function (p: Par) bail(): Par {
  let last: i32 = p.toks.len() - 1;
  if (last < p.pos) {
    last = p.pos;
  }
  return Par { toks: p.toks, pos: last, no_struct: p.no_struct, map_kind: p.map_kind, structnames: p.structnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos };
}

// Token-shape queries: each returns "" when the token isn't of
// the expected kind, otherwise the text/name. Callers branch on
// the empty-string result rather than re-matching.
function (p: Par) peek_punct(): string {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokPunct(x) => {
      return x.text;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// consume_pub_package consumes an optional `(package)` after a `pub` keyword
// and reports whether it was there. `pub(package)` is a THIRD visibility level,
// not a flavour of `pub`: the decl is visible to other modules in the same
// package (directory) and to nobody else, so the two flags are mutually
// exclusive. See docs/PUB-PACKAGE.md.
function consume_pub_package(p: Par): (boolean, Par) {
  if (p.peek_punct() != "(") {
    return (false, p);
  }
  let q: Par = p.advance();
  if (q.peek_ident() != "package") {
    return (false, p);
  }
  q = q.advance();
  if (q.peek_punct() != ")") {
    return (false, p);
  }
  return (true, q.advance());
}

// at_path_sep reports whether the cursor is on a path separator. `.` and `::`
// are interchangeable in EXPRESSION position (`mod.f` / `mod::f`), so every
// site that walks a dotted name accepts either. Type position is the
// exception and does NOT use this: there `::` means an associated-type
// projection and `.` a module-qualified name (docs/ASSOCIATED-TYPES.md).
function (p: Par) at_path_sep(): boolean {
  let pk: string = p.peek_punct();
  return pk == "." || pk == "::";
}

function (p: Par) peek_keyword(): string {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokKeyword(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// more_elems consumes a comma-separated list's separator and reports
// whether another element follows, alongside the advanced cursor. It
// answers false both when there is no comma and when the comma is a
// TRAILING one sitting directly before `close` — so every list routed
// through it accepts a trailing comma. The mirror of the native
// parser's `moreElems` (internal/syntax/parser/parser.go); the two must agree
// or a program's legality depends on which compiler reads it.
function (p: Par) more_elems(close: string): (boolean, Par) {
  if (p.peek_punct() != ",") {
    return (false, p);
  }
  let q: Par = p.advance();
  return (q.peek_punct() != close, q);
}

// peek2_punct returns the punctuation text of the token ONE past the
// cursor ("" when it isn't a punctuator / out of range). The 2-token
// lookahead the call-argument parser needs to spot a named argument
// (`name = value`): the current token is the IDENT, this is the `=`.
function (p: Par) peek2_punct(): string {
  if (p.pos + 1 < p.toks.len()) {
    let t: lexer.Token = p.toks[p.pos + 1];
    match (t) {
      lexer.TokPunct(x) => {
        return x.text;
      },
      _ => {
        return "";
      }
    }
  }
  return "";
}

function (p: Par) peek_ident(): string {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokIdent(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// peek_punct_at / peek_ident_at read the token k slots past the cursor
// (0 == the cursor), returning "" when it is the wrong kind or out of
// range. The wider lookahead the struct `@`-pattern dispatch needs to spot
// `name @ Ident {` before committing to the struct-match desugar.
function (p: Par) peek_punct_at(k: i32): string {
  if (p.pos + k < p.toks.len()) {
    let t: lexer.Token = p.toks[p.pos + k];
    match (t) {
      lexer.TokPunct(x) => {
        return x.text;
      },
      _ => {
        return "";
      }
    }
  }
  return "";
}

function (p: Par) peek_ident_at(k: i32): string {
  if (p.pos + k < p.toks.len()) {
    let t: lexer.Token = p.toks[p.pos + k];
    match (t) {
      lexer.TokIdent(x) => {
        return x.name;
      },
      _ => {
        return "";
      }
    }
  }
  return "";
}

// peek_is_literal reports whether the cursor sits on a number or
// string literal token. Used by the match-arm parser to recognise a
// literal-pattern arm (`0 => …`, `"yes" => …`) — a match on a
// non-enum (i32 / string) scrutinee — and desugar the whole match to
// an if/else-if chain (see build_literal_match), mirroring the native
// compiler's emitLiteralMatch.
// peek_number_text is the source text of a number-literal token at the
// cursor, or "" for any other token. The graded `fip(n)` / `fbip(n)`
// allowance is the only reader: it needs the digits, not just the kind
// peek_is_literal reports.
function (p: Par) peek_number_text(): string {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokNumber(x) => {
      return x.text;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function (p: Par) peek_is_literal(): boolean {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokNumber(x) => {
      return true;
    },
    lexer.TokString(x) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// peek_is_pat_literal is peek_is_literal widened by one token for PATTERN
// position: the sign of a negative literal is a separate `-` punct, so the
// one-token test declined `-1 => …` and the whole match fell to the variant
// path and bailed (#6394). The grammar has always permitted it —
// `LiteralPattern = [ '-' ] ( NUMBER | FLOAT ) | …`.
//
// Only the GATE needs widening: every literal-pattern site parses through
// parse_binary, which already handles unary minus, so the sign folds in with
// no change to the arms themselves.
// peek_at_literal reports an `n @ <literal or range>` head: a binder, `@`,
// then a scalar pattern, which binds the whole scrutinee to `n`.
function (p: Par) peek_at_literal(): boolean {
  if (p.peek_ident().len() == 0 || p.peek2_punct() != "@") {
    return false;
  }
  return p.advance().advance().peek_is_pat_literal();
}

// take_at_binding consumes an `n @` in front of a scalar pattern and answers
// the binder, or "" with the cursor unmoved when there is none.
function take_at_binding(p: Par): (string, Par) {
  if (!p.peek_at_literal()) {
    return ("", p);
  }
  let name: string = p.peek_ident();
  return (name, p.advance().advance());
}

function (p: Par) peek_is_pat_literal(): boolean {
  if (p.peek_is_literal()) {
    return true;
  }
  if (p.peek_keyword() == "true" || p.peek_keyword() == "false") {
    return true;
  }
  if (p.peek_punct() != "-") {
    return false;
  }
  if (p.pos + 1 < p.toks.len()) {
    let t: lexer.Token = p.toks[p.pos + 1];
    match (t) {
      lexer.TokNumber(x) => {
        return true;
      },
      _ => {
        return false;
      }
    }
  }
  return false;
}

// peek_member_name returns the identifier at the cursor, OR a reserved
// keyword that is nonetheless allowed in MEMBER position — currently only
// `default` (a reserved keyword that doubles as the `Default` trait's
// method name `Type.default()`). Returns "" otherwise. Mirrors the Go
// parser's expectMemberName; used for function/method names and field
// access so `function default()` and `obj.default()` parse while the
// keyword stays reserved everywhere else.
function (p: Par) peek_member_name(): string {
  let nm: string = p.peek_ident();
  if (nm.len() > 0) {
    return nm;
  }
  if (p.peek_keyword() == "default") {
    return "default";
  }
  return "";
}

// punct_at returns the punctuation text of the token at absolute index
// `idx` ("" when out of range or not a punct token). Used by the
// arrow-lambda lookahead, which must peek several tokens ahead of the
// cursor without advancing.
function (p: Par) punct_at(idx: i32): string {
  if (idx < 0 || idx >= p.toks.len()) {
    return "";
  }
  let t: lexer.Token = p.toks[idx];
  match (t) {
    lexer.TokPunct(x) => {
      return x.text;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// ident_at returns the identifier name of the token at absolute index
// `idx` ("" when out of range or not an ident token).
function (p: Par) ident_at(idx: i32): string {
  if (idx < 0 || idx >= p.toks.len()) {
    return "";
  }
  let t: lexer.Token = p.toks[idx];
  match (t) {
    lexer.TokIdent(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// keyword_at returns the keyword text of the token at absolute index
// `idx` ("" when out of range or not a keyword token). Used by the
// if_stmt_has_else lookahead (#4522), which scans past an `if`'s
// paren-balanced condition and brace-balanced then-body to peek for
// a trailing `else`.
function (p: Par) keyword_at(idx: i32): string {
  if (idx < 0 || idx >= p.toks.len()) {
    return "";
  }
  let t: lexer.Token = p.toks[idx];
  match (t) {
    lexer.TokKeyword(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// if_stmt_has_else reports whether the `if` the cursor is on has a
// trailing `else` clause, by skipping its paren-balanced condition and
// brace-balanced then-body and peeking for `else`. Used by
// branch_stmt_start (#4522) to route an else-LESS `if` in a block body
// through the statement path — such an `if` cannot be a value expression
// (an if-EXPRESSION requires `else`), so it is control flow. Mirrors the
// Go parser's ifStmtHasElse.
function (p: Par) if_stmt_has_else(): boolean {
  let i: i32 = p.pos + 1;  // skip `if`
  // Skip `( … )` (paren-balanced).
  if (p.punct_at(i) == "(") {
    let depth: i32 = 0;
    while (i < p.toks.len()) {
      let pt: string = p.punct_at(i);
      if (pt == "(") {
        depth = depth + 1;
      } else if (pt == ")") {
        depth = depth - 1;
        if (depth == 0) {
          i = i + 1;
          break;
        }
      }
      i = i + 1;
    }
  }
  // Skip `{ … }` (brace-balanced) then-body.
  if (p.punct_at(i) == "{") {
    let bdepth: i32 = 0;
    while (i < p.toks.len()) {
      let bt: string = p.punct_at(i);
      if (bt == "{") {
        bdepth = bdepth + 1;
      } else if (bt == "}") {
        bdepth = bdepth - 1;
        if (bdepth == 0) {
          i = i + 1;
          break;
        }
      }
      i = i + 1;
    }
  }
  return p.keyword_at(i) == "else";
}

// closer_followed_by scans from the opening bracket at absolute index `idx`
// to its match and reports whether the punctuation after it is `want_a` or
// `want_b` (pass "" for want_b when only one spelling qualifies).
function (p: Par) closer_followed_by(idx: i32, open: string, close: string, want_a: string, want_b: string): boolean {
  let depth: i32 = 0;
  let j: i32 = idx;
  while (j < p.toks.len()) {
    let t: string = p.punct_at(j);
    if (t == open) {
      depth = depth + 1;
    } else if (t == close) {
      depth = depth - 1;
      if (depth == 0) {
        let aft: string = p.punct_at(j + 1);
        if (aft.len() == 0) {
          return false;
        }
        return aft == want_a || want_b.len() > 0 && aft == want_b;
      }
    }
    j = j + 1;
  }
  return false;
}

// first_param_looks_typed reports whether the tokens at absolute index `idx`
// open a PARAMETER rather than an expression — the disambiguator between an
// arrow lambda's parens and a grouping / tuple. Three shapes, each pinned by
// a `:` an expression cannot have in that position:
//
//	IDENT :          a plain typed param
//	( … ) :          a tuple-destructuring param
//	IDENT { … } :    a struct-destructuring param
//
// An `@` binding may precede either destructuring form. Ported from the
// native parser's firstParamLooksTyped.
function (p: Par) first_param_looks_typed(idx0: i32): boolean {
  let idx: i32 = idx0;
  // `w @ <pattern>` — skip the binder so the shapes below are what is tested.
  if (p.ident_at(idx).len() > 0 && p.punct_at(idx + 1) == "@") {
    idx = idx + 2;
  }
  // `own x: T` — the consuming-parameter modifier, contextual exactly as
  // on a declaration: an ident after `own` means the modifier, a `:` means
  // `own` is the parameter's own name.
  if (p.ident_at(idx) == "own" && p.ident_at(idx + 1).len() > 0) {
    idx = idx + 1;
  }
  if (p.punct_at(idx) == "(") {
    // `(a, b): (T, U)` — the annotation colon follows the matching `)`.
    // `((a, b), c)` / `((a + b) * c)` never put one there.
    return p.closer_followed_by(idx, "(", ")", ":", "=>");
  }
  if (p.ident_at(idx).len() > 0 && p.punct_at(idx + 1) == "{") {
    // `P { x, y }: P` — a parenthesised struct LITERAL puts its colons
    // INSIDE the braces, so only a pattern has one after the `}`.
    return p.closer_followed_by(idx + 1, "{", "}", ":", "");
  }
  return p.ident_at(idx).len() > 0 && p.punct_at(idx + 1) == ":";
}

// arrow_lambda_at reports whether the cursor (sitting on `(`) begins an
// arrow lambda — `() => …`, `(): R => …`, or `(PARAM, …) [: R] => …` — as
// opposed to a grouping `(e)` or tuple `(e0, e1)`. The disambiguator
// (ported from the native parser's looksLikeArrowLambda, #2701): an arrow
// lambda's parens are empty or start with a shape only a parameter has
// (first_param_looks_typed), and the matching `)` is followed by `=>` or
// `:` (the return-type colon). It scans to the balanced `)` and checks the
// token after it.
function (p: Par) arrow_lambda_at(): boolean {
  // p.pos is at "(".
  let open: i32 = p.pos;
  // Empty params: `(` `)` then `=>` / `:`.
  if (p.punct_at(open + 1) == ")") {
    let after: string = p.punct_at(open + 2);
    return after == "=>" || after == ":";
  }
  if (!p.first_param_looks_typed(open + 1)) {
    return false;
  }
  // Scan to the matching `)` and check the token after it.
  return p.closer_followed_by(open, "(", ")", "=>", ":");
}

// parse_arrow_lambda parses `(params) [: R] => body` into an ExprLambda,
// producing the same AST the verbose `(params): R => { … }` form does,
// so the lambda-lift + IR-lowering machinery handles it with no further
// changes. An expression body becomes the single statement `[return expr]`; a
// braced body becomes the block's own statements, plus a `return` of its
// trailing value when it has one. The cursor is on the opening `(`. Parameter
// types are required (as in the verbose form); the return type is optional.
// Ported from the native parser's parseArrowLambda (#2701).
function parse_arrow_lambda(p: Par): (ast.Expr, Par) {
  let lam_line: i32 = p.peek_line();
  let lam_col: i32 = p.peek_col();
  p = p.advance();  // consume `(`
  let params: ast.ParamDecl[] = [];
  let apd: ParamDestr[] = [];
  if (p.peek_punct() != ")") {
    while (true) {
      if (at_pattern_head(p)) {
        let (atpr_param, atpr_destr, atpr_p) = parse_pattern_param(p);
        p = atpr_p;
        if (atpr_destr.names.len() == 0) {
          return (e_unknown_at("lambda: bad destructuring param", p.peek_line(), p.peek_col()), p);
        }
        params = params.append(atpr_param);
        apd = apd.append(atpr_destr);
        if (p.peek_punct() == ",") {
          p = p.advance();
          if (p.peek_punct() == ")") {
            break;
          }
          continue;
        }
        break;
      }
      let (pr_param, pr_p) = parse_param(p, params.len());
      p = pr_p;
      params = params.append(pr_param);
      // A trailing comma before `)` must not start another parameter —
      // parse_param returns its empty sentinel for `)`, and appending that
      // gives the function one phantom nameless param. Harmless-looking on a
      // register backend, fatal on wasm, where a function's arity is
      // DECLARED: `(n: i32,) => n * 2` hoisted `$__lam_0` with two params and
      // the one-argument call site underflowed the stack (#6354). Mirrors the
      // struct-field and struct-literal parsers, which have guarded this
      // since they were written.
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == ")") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  let ret_type: string = "";
  let lam_fn_ret: string = "";
  let lam_fn_ptys: string = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    // A parenthesised annotation is ambiguous with a function type:
    // `(): (string, i32) => …` reads as a two-parameter function type and
    // goes looking for its result in the lambda's body, so a tuple return
    // had no spelling at all once #2673 retired the braced `function`
    // expression (#8743). Read it greedily first, and when that leaves no
    // `=>` for the lambda it took ours: re-read from the saved cursor with
    // the top-level arrow reserved. Only a read that swallows the arrow
    // can reach the second call, so nothing that parses today changes —
    // including a function-typed return, whose explicit parens keep its
    // arrow off the top level.
    let saved: Par = p;
    let (rtr_name, rtr_fn_ret, rtr_p) = parse_type_name(p);
    if (rtr_p.peek_punct() == "=>") {
      p = rtr_p;
      ret_type = rtr_name;
      // The same verbatim re-read parse_decl_type does, with the reader
      // that produced this tag. It yields BOTH halves of the contract,
      // where the coarse `fn_ret` of parse_type_name is only one — and
      // half a signature is worse than none, since fn_tag_spelling would
      // rebuild `() => R` for a function that takes arguments.
      let (gw, gwr, gwe) = parse_type_name(Par { ...saved, verbatim: true });
      let (g_ret, g_ptys) = fn_contract_of(rtr_name, gw);
      lam_fn_ret = g_ret;
      lam_fn_ptys = g_ptys;
    } else {
      let (ra_name, ra_fn_ret, ra_p) = parse_type_name_reserving_arrow(saved);
      p = ra_p;
      ret_type = ra_name;
      let (rw, rwr, rwe) = parse_type_name_reserving_arrow(Par { ...saved, verbatim: true });
      let (r_ret, r_ptys) = fn_contract_of(ra_name, rw);
      lam_fn_ret = r_ret;
      lam_fn_ptys = r_ptys;
    }
  }
  if (p.peek_punct() == "=>") {
    p = p.advance();
  }
  let body: ast.Stmt[] = [];
  if (p.peek_punct() == "{") {
    // A braced body IS a function body — statements, the `use` desugar,
    // and an optional trailing value — not a value block. That is what
    // lets a lambda whose body only runs statements be void rather than a
    // value-less block in value position, and it takes the `{` before
    // parse_expr can read it as a value block (which `no_struct` would
    // suppress in a loop / if HEADER anyway).
    let (lb_body, lb_p) = parse_lambda_body(p);
    p = lb_p;
    body = lb_body;
  } else {
    let (ber_expr, ber_p) = parse_expr(p);
    p = ber_p;
    body = [s_return(ber_expr)];
  }
  body = prepend_param_destrs(body, apd);
  return parse_postfix(p, e_lambda_at(params, ret_type, body, "", lam_line, lam_col, lam_fn_ret, lam_fn_ptys));
}

// Parse results are `(parsed_thing…, Par)` tuple returns — both pieces
// of the value + new-parser pair threaded through recursive-descent
// (docs/CURSOR-IDIOM.md). Avoids a stateful `let p: Par` shared across
// helpers.

// map_key_kind_of_expr classifies a map-literal KEY as 1 (integer-keyed),
// 0 (string-keyed) or -1 (undecidable) by walking down to its leftmost
// literal leaf. A key is rarely a bare literal — `(1 + 1)`, `(560 | (x <<|
// 6))` and `-3` all reach a decisive leaf one or two nodes down — and the
// leftmost operand is the one that fixes the type of an arithmetic or
// concatenation chain.
//
// Only a leaf can decide. An identifier, a call or an `if` expression is
// genuinely unclassifiable here: the parser has no types, which is the root
// of why this decision is awkward in the first place (the native compiler
// keeps a typed `ast.MapLit` and lets the checker answer). Those return -1.
// Where the literal initializes an ANNOTATED binding, parse_map_lit takes the
// key kind straight off the declaration (Par.map_kind) and never asks this.
// This is the fallback for every other position.
function map_key_kind_of_expr(e: ast.Expr): i32 {
  match (e) {
    ast.ExprNumber(_) => {
      return 1;
    },
    ast.ExprString(_) => {
      return 0;
    },
    ast.ExprBool(_) => {
      // A boolean is a non-pointer scalar, so it lives in the INTEGER key
      // column like an i32 — same reason u8 and u32 do (#9973). Without
      // this arm `Map { true: 1 }` fell to -1, took the string constructor,
      // and the raw 0/1 went through the string runtime as an address:
      // the process dies, at the insert or at the first read. That is the
      // #6207 shape this walk exists to prevent.
      return 1;
    },
    ast.ExprBinary(b) => {
      return map_key_kind_of_expr(b.left);
    },
    ast.ExprUnary(u) => {
      // An `as <type>` cast (op "as_<type>") is DECISIVE on its target,
      // whatever the operand is — `(f(x) >> 32u64) as i32` is an integer
      // key even though nothing below the cast can be classified. Reading
      // the target rather than recursing into the operand mirrors
      // mono_infer, which already treats casts this way; recursing was
      // what left a generated map keyed entirely on casts and
      // if-expressions still falling back to the string constructor after
      // the first #6207 fix.
      if (is_cast_op(u.op)) {
        if (slice_unchecked(u.op, 3, u.op.len()) == "string") {
          return 0;
        }
        return 1;
      }
      return map_key_kind_of_expr(u.operand);
    },
    _ => {
      return 0 - 1;
    }
  }
  return 0 - 1;
}

// parse_map_lit parses a map literal `Map { k0: v0, k1: v1, … }` (the
// cursor is on the opening `{`) and desugars it to a chained
// `map_new[_i32](n).insert(k0,v0).insert(k1,v1)…` — insert returns the map, so
// the whole thing is one expression. The constructor carries the KEY KIND,
// which the chained .set dispatch reads back to pick the right key compare.
//
// This used to match the FIRST key against `ExprNumber` and nothing else, so
// every non-literal key — including `(1 + 1)` — fell through to map_new, the
// STRING constructor. An i32-keyed map then built itself as string-keyed and
// __fern_map_set compared its integer keys through __fern_str_eq, dereferencing
// them as pointers: a SIGSEGV at construction, with no read of the map
// anywhere (#6207). One computed key merely mistyped the map silently; two
// reached the compare.
//
// The key walk below is the guess of last resort. A `let m: Map[K, V] = …`
// declaration answers the same question exactly and arrives as Par.map_kind,
// which takes precedence where it is set.
function parse_map_lit(p: Par): (ast.Expr, Par) {
  // Take the declaration's answer for THIS literal, then clear it: a
  // `Map[string, i32]` literal appearing as a VALUE inside a `Map[i32, …]`
  // literal must not inherit the outer key kind, which would reintroduce
  // this bug in a rarer shape.
  let want_kk: i32 = p.map_kind;
  let mline: i32 = p.peek_line();
  let mcol: i32 = p.peek_col();
  p = p.with_map_kind(0 - 1).advance();  // consume `{`
  let mlk: ast.Expr[] = [];
  let mlv: ast.Expr[] = [];
  if (p.peek_punct() != "}") {
    while (true) {
      let (mke_expr, mke_p) = parse_expr(p);
      p = mke_p;
      if (p.peek_punct() == ":") {
        p = p.advance();
      }
      let (mve_expr, mve_p) = parse_expr(p);
      p = mve_p;
      mlk = mlk.append(mke_expr);
      mlv = mlv.append(mve_expr);
      if (p.peek_punct() == ",") {
        p = p.advance();
        // A TRAILING comma closes the literal — `Map { 1: 2, }`. Without
        // this the loop went back to parse_expr on the `}` and reported
        // P001, while native, the interpreter, and this parser's own
        // array and struct literals all accept one.
        if (p.peek_punct() == "}") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  if (p.verbatim) {
    return parse_postfix(p, ast.ExprMapLit { keys: mlk, vals: mlv, line: mline, col: mcol });
  }
  // The first key that CAN be classified decides, rather than the first key
  // full stop: keys are homogeneous, so a later decisive one describes the
  // map just as well as the first, and consulting it costs nothing. Only an
  // all-undecidable key set (identifiers, calls) still falls back to
  // map_new — the case the parser cannot answer without types.
  let kk: i32 = want_kk;
  let kki: i32 = 0;
  while (kki < mlk.len()) {
    if (kk < 0) {
      kk = map_key_kind_of_expr(mlk[kki]);
    }
    kki = kki + 1;
  }
  let ctor: string = if (kk == 1) { "__map_new_i32" } else { "map_new" };
  let cargs: ast.Expr[] = [];
  cargs = cargs.append(e_number("8", "", false));
  // Positioned at the literal, like the ExprMapLit the verbatim parse keeps:
  // the desugared constructor is the only node left for a diagnostic about
  // the literal to land on, and E001's missing-`core/map` report reads it.
  let mbase: ast.Expr = e_call_at(e_ident(ctor), cargs, mline, mcol);
  let mpi: i32 = 0;
  while (mpi < mlk.len()) {
    let sargs: ast.Expr[] = [];
    sargs = sargs.append(mlk[mpi]);
    sargs = sargs.append(mlv[mpi]);
    mbase = e_call(e_field_access(mbase, "insert"), sargs);
    mpi = mpi + 1;
  }
  return parse_postfix(p, mbase);
}

// map_ann_key_kind reads a map DECLARATION's key kind out of its type
// annotation — 1 for `Map[i32, …]`, 0 for `Map[string, …]`, -1 for anything
// else (not a map, or a struct/enum key, which map_new/__map_new_i32 cannot
// spell — those keep whatever the construction site chose). The "i32," /
// "string," spelling is parse_type_name's canonical join (", " between
// generic args, no space after `[`); the lowering's annotated-`map_new` path
// matches the same two prefixes.
function map_ann_key_kind(t: string): i32 {
  if (t.len() < 5 || slice_unchecked(t, 0, 4) != "Map[") {
    return 0 - 1;
  }
  let inner: str = slice_unchecked(t, 4, t.len());
  if (inner.len() >= 4 && slice_unchecked(inner, 0, 4) == "i32,") {
    return 1;
  }
  if (inner.len() >= 7 && slice_unchecked(inner, 0, 7) == "string,") {
    return 0;
  }
  return 0 - 1;
}

// parse_struct_lit_body parses `{ f: v, … }` (the cursor is on the
// opening `{`) and returns an ExprStructLit with the given
// type_name. Shared by the bare-ident struct literal in
// parse_primary and the qualified `pkg.Type { … }` form in
// parse_postfix.
function parse_struct_lit_body(p: Par, type_name: string, sline: i32, scol: i32): (ast.Expr, Par) {
  p = p.advance();  // consume `{`
  let fnames: string[] = [];
  let fvals: ast.Expr[] = [];
  // Struct-update `Name { ...base, field: value }`: a leading
  // `...base` spread copies the un-overridden fields from `base`,
  // the listed fields override. `...base` must be first. With no
  // overrides (`Name { ...base }`) it's a legal pure copy.
  let has_base: boolean = false;
  let base: ast.Expr = e_unknown("no-base");
  if (p.peek_punct() == "...") {
    p = p.advance();
    let (br_expr, br_p) = parse_expr(p);
    p = br_p;
    has_base = true;
    base = br_expr;
    if (p.peek_punct() == ",") {
      p = p.advance();
    } else {
      // No overrides — expect the closing brace (pure copy).
      if (p.peek_punct() != "}") {
        return (e_unknown_at("missing } in struct update", p.peek_line(), p.peek_col()), p);
      }
      p = p.advance();
      return (e_struct_update(type_name, fnames, fvals, base, sline, scol), p);
    }
  }
  if (p.peek_punct() != "}") {
    while (true) {
      let fn: string = p.peek_ident();
      if (fn.len() == 0) {
        return (e_unknown_at("missing field name in struct lit", p.peek_line(), p.peek_col()), p);
      }
      p = p.advance();
      if (p.peek_punct() != ":") {
        return (e_unknown_at("missing : in struct lit", p.peek_line(), p.peek_col()), p);
      }
      p = p.advance();
      let (fv_expr, fv_p) = parse_expr(p);
      p = fv_p;
      fnames = fnames.append(fn);
      fvals = fvals.append(fv_expr);
      if (p.peek_punct() == ",") {
        p = p.advance();
        // Trailing comma before the closing brace is allowed
        // (std/test's TestRunner literals use it).
        if (p.peek_punct() == "}") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() != "}") {
    return (e_unknown_at("missing } in struct lit", p.peek_line(), p.peek_col()), p);
  }
  p = p.advance();
  if (has_base) {
    return (e_struct_update(type_name, fnames, fvals, base, sline, scol), p);
  }
  return (e_struct_lit(type_name, fnames, fvals, sline, scol), p);
}

// parse_postfix runs the chained-postfix loop on a base
// expression. Handles call (`(args)`), index / slice (`[i]`,
// `[i:j]`), and field access (`.name` / `.0`). Returns when
// the next token isn't one of these. Used by parse_primary
// to share the loop across multiple base shapes — ident
// chains, parenthesised exprs, tuple / array literals.
// scan_written_type_args reconstructs a `[T1, T2, …]` instantiation as written.
// The cursor sits just past the `[` and is left on the matching `]`. Each
// argument goes through parse_type_name, so the spelling is the type grammar's
// own — which under `-fmt` keeps `str`, `[T]` and fn types as the author wrote
// them. A count of 0 means the brackets do not hold a type list; the cursor is
// then wherever the attempt stopped and the caller must restore it.
function scan_written_type_args(p: Par): (string, i32, Par) {
  let out: string = "";
  let n: i32 = 0;
  while (true) {
    let (tn, tn_fnret, tn_p) = parse_type_name(p);
    if (tn.len() == 0) {
      return ("", 0, p);
    }
    p = tn_p;
    if (n > 0) {
      out = out + ", ";
    }
    out = out + tn;
    n = n + 1;
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() != "]") {
    return ("", 0, p);
  }
  return (out, n, p);
}

// written_type_arg_list is the `count` type arguments of a call as written:
// the scanned spellings when the type grammar read all of them, else `count`
// unknown ("") entries.
function written_type_arg_list(text: string, scanned: i32, count: i32): string[] {
  if (scanned == count) {
    return split_top_commas(text);
  }
  let out: string[] = [];
  let i: i32 = 0;
  while (i < count) {
    out = out.append("");
    i = i + 1;
  }
  return out;
}

// type_shaped_bracket reports whether the bracket the cursor sits just inside
// opens with a name yet holds a type list, from shapes an index cannot take: a
// top-level comma (`[Box, Loc]`) or a nested `[` opening a type keyword or `[]`
// (`[Pair[i32]]`, `[Box[]]`), closed by a `]` that a `(` follows; before a `{`
// any name list is a struct literal's. Mirrors native's peekTypeArgs; a lone
// name before `(` stays an index for retag_type_arg_indexes to settle.
function type_shaped_bracket(p: Par): boolean {
  if (p.peek_ident().len() == 0) {
    return false;
  }
  let shaped: boolean = false;
  let depth: i32 = 1;
  let j: i32 = 0;
  while (p.pos + j < p.toks.len()) {
    let pk: string = p.peek_punct_at(j);
    if (pk == "[") {
      depth = depth + 1;
      if (is_type_keyword_tok(p, j + 1) || p.peek_punct_at(j + 1) == "]") {
        shaped = true;
      }
    } else if (pk == "," && depth == 1) {
      shaped = true;
    } else if (pk == "{") {
      return false;
    } else if (pk == "(") {
      let prev: string = p.peek_punct_at(j - 1);
      if (prev.len() == 0 || prev == "]" || prev == ")") {
        return false;
      }
    } else if (pk == "]") {
      depth = depth - 1;
      if (depth == 0) {
        let after: string = p.peek_punct_at(j + 1);
        return shaped && after == "(" || after == "{" && !p.no_struct;
      }
    }
    j = j + 1;
  }
  return false;
}

function is_type_keyword_tok(p: Par, k: i32): boolean {
  if (p.pos + k >= p.toks.len()) {
    return false;
  }
  if let lexer.TokKeyword(kw) = p.toks[p.pos + k] {
    return kw.name == "i32" || kw.name == "i64" || kw.name == "u8" || kw.name == "u32" || kw.name == "u64" || kw.name == "usize" || kw.name == "f32" || kw.name == "f64" || kw.name == "string" || kw.name == "boolean" || kw.name == "void";
  }
  return false;
}

// with_written_type_args spells a call's explicit instantiation onto the callee's
// written name — `empty` + `[i32]` for `empty[i32]()`, the method's field name
// for a receiver call. Formatter-only: the compile parse erases type args to
// their count, and no consumer reads a name back apart from the printer.
function with_written_type_args(callee: ast.Expr, args: string): ast.Expr {
  match (callee) {
    ast.ExprIdent(id) => {
      return ast.ExprIdent { name: id.name + "[" + args + "]", line: id.line, col: id.col, ty: id.ty };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { obj: fa.obj, field: fa.field + "[" + args + "]", line: fa.line, col: fa.col, ty: fa.ty };
    },
    _ => {
      return callee;
    }
  }
  return callee;
}

function parse_postfix(p: Par, base: ast.Expr): (ast.Expr, Par) {
  // Carries the explicit type arguments from a `[...]` instantiation to the
  // call `(...)` that immediately follows (`f[i32](x)`). Reset after each call.
  let pending_type_arg_list: string[] = [];
  // The same instantiation AS WRITTEN, for `-fmt` only (Par.verbatim). The
  // count alone cannot be printed, so a formatted `empty[i32]()` came back as
  // `empty()` — E040, the formatter deleting the syntax the diagnostic asks
  // for. Attached to the callee's written name rather than to a new ExprCall
  // field, the way parse_type_name carries a bound's args on the type name.
  let pending_type_args: string = "";
  while (true) {
    let pk: string = p.peek_punct();
    if (pk == "(") {
      // The Go parser positions a Call at its opening paren
      // (`Call{P: open.Pos}`), so E004 (arity) lands here.
      let oline: i32 = p.peek_line();
      let ocol: i32 = p.peek_col();
      p = p.advance();
      let args: ast.Expr[] = [];
      if (p.peek_punct() != ")") {
        while (true) {
          // Named argument `name = value`: an IDENT immediately
          // followed by a single `=` (peek2 is exactly "=", never
          // "==" / "=>"). Encode it as a synthetic
          // `ExprBinary("__named_arg", <name ident>, value)` marker;
          // fill_default_args_module reorders these into positional
          // order against the callee's params and fills omitted
          // defaults, mirroring the native `defaultargs` pass. Without
          // this, parse_expr reads `name` as a bare value and stops at
          // `=`, breaking the call.
          let an: string = p.peek_ident();
          if (an.len() > 0 && p.peek2_punct() == "=") {
            let aline: i32 = p.peek_line();
            let acol: i32 = p.peek_col();
            p = p.advance();  // consume the parameter name
            p = p.advance();  // consume `=`
            let (rv_expr, rv_p) = parse_expr(p);
            p = rv_p;
            args = args.append(ast.ExprBinary { op: "__named_arg", left: ast.ExprIdent { name: an, line: aline, col: acol, ty: "" }, right: rv_expr, line: aline, col: acol, ty: "" });
          } else {
            let (ra_expr, ra_p) = parse_expr(p);
            p = ra_p;
            args = args.append(ra_expr);
          }
          let (ca_more, ca_p) = p.more_elems(")");
          p = ca_p;
          if (ca_more) {
            continue;
          }
          break;
        }
      }
      if (p.peek_punct() != ")") {
        return (e_unknown_at("missing ) in call", p.peek_line(), p.peek_col()), p);
      }
      p = p.advance();
      if (pending_type_args.len() > 0) {
        base = with_written_type_args(base, pending_type_args);
      }
      base = ast.ExprCall { callee: base, args: args, line: oline, col: ocol, type_args: pending_type_arg_list, ty: "" };
      base = maybe_desugar_array_build(base);
      base = maybe_desugar_map_build(base);
      pending_type_arg_list = [];
      pending_type_args = "";
    } else if (pk == "[") {
      // Native positions an index or slice at its `[`.
      let bline: i32 = p.peek_line();
      let bcol: i32 = p.peek_col();
      p = p.advance();
      // Leading-colon slice `a[:hi]` (low implicitly 0), mirroring the
      // Go parseCall's `[:b]` form. The `:` isn't a value expression, so
      // without handling it here the type-arg probe below would misread
      // `:hi` as erased type args and drop the slice (#4339). `a[:]` is
      // the full slice `[0:len]`.
      if (p.peek_punct() == ":") {
        p = p.advance();  // consume `:`
        if (p.peek_punct() == "]") {
          p = p.advance();
          base = e_slice_all(base, bline, bcol);
          continue;
        }
        let (shi_expr, shi_p) = parse_expr(p);
        p = shi_p;
        if (p.peek_punct() != "]") {
          return (e_unknown_at("missing ] in slice", p.peek_line(), p.peek_col()), p);
        }
        p = p.advance();
        base = e_slice_from_start(base, shi_expr, bline, bcol);
        continue;
      }
      // Generic instantiation `f[i32](…)` / `Box[T] { … }`: the
      // bracket holds type arguments, not a value index. Detect it by
      // probing parse_expr — if it makes no progress (a type keyword
      // like `i32` isn't a value expression), skip to the matching
      // `]` and erase the type args, leaving `base` unchanged.
      let idxStart: i32 = p.pos;
      let (idx_expr, idx_p) = parse_expr(p);
      if (type_shaped_bracket(p)) {
        idx_p = p;
      }
      if (idx_p.pos == idxStart) {
        // `-fmt` reads the arguments back out as types before the skip
        // loop erases them. On anything the type grammar does not accept
        // the cursor is restored and the erasing walk below runs as it
        // always did, so a shape only the compile path understands cannot
        // desync the parse.
        let (wta_text, wta_n, wta_p) = scan_written_type_args(p);
        // A struct literal keeps its written instantiation on the compile
        // path too, so `Box[i32] { … }` is checked as a Box[i32].
        let written_args: string = "";
        if (wta_n > 0) {
          written_args = wta_text;
        }
        if (p.verbatim && wta_n > 0) {
          pending_type_args = wta_text;
          pending_type_arg_list = split_top_commas(wta_text);
          p = wta_p;
        }
        // Count the top-level (comma-separated) type arguments while
        // skipping them, tracking nested `[...]` / `(...)` depth so a
        // comma inside `Map[K, V]` or a tuple type doesn't inflate it.
        let ta_depth: i32 = 0;
        let ta_saw: boolean = false;
        let ta_commas: i32 = 0;
        // A TRAILING comma closes no further argument — `pick[i32,]`
        // is one type argument, and counting it as two reported E040
        // against a call the grammar allows.
        let ta_trailing: boolean = false;
        while (!p.at_end()) {
          let tp2: string = p.peek_punct();
          if (tp2 == "]" && ta_depth == 0) {
            break;
          }
          if (tp2 == "[" || tp2 == "(") {
            ta_depth = ta_depth + 1;
          }
          if (tp2 == "]" || tp2 == ")") {
            ta_depth = ta_depth - 1;
          }
          if (tp2 == "," && ta_depth == 0) {
            ta_commas = ta_commas + 1;
            ta_trailing = true;
          } else {
            ta_trailing = false;
          }
          ta_saw = true;
          p = p.advance();
        }
        if (ta_trailing) {
          ta_commas = ta_commas - 1;
        }
        if (ta_saw) {
          pending_type_arg_list = written_type_arg_list(wta_text, wta_n, ta_commas + 1);
        }
        if (p.peek_punct() == "]") {
          p = p.advance();
        }
        // `Name[T] { … }` — a generic struct construction: the
        // erased base is the struct name; parse the literal body.
        if (p.peek_punct() == "{") {
          match (base) {
            ast.ExprIdent(bid) => {
              // The written instantiation is stored in the literal's
              // type name under `-fmt`: dropping it re-infers the
              // literal, so `Box[i64] { val: 42 }` came back as
              // `Box { val: 42 }` and quietly became `Box[i32]`.
              let glit_name: string = bid.name;
              if (pending_type_args.len() > 0) {
                glit_name = glit_name + "[" + pending_type_args + "]";
              }
              let (glit_expr, glit_p) = parse_struct_lit_body(p, glit_name, bid.line, bid.col);
              p = glit_p;
              base = glit_expr;
              if let ast.ExprStructLit(gsl) = glit_expr {
                if (written_args.len() > 0) {
                  base = ast.ExprStructLit { ...gsl, written: bid.name + "[" + written_args + "]" };
                }
              }
              pending_type_arg_list = [];
              pending_type_args = "";
            },
            _ => {}
          }
        }
        continue;
      }
      p = idx_p;
      if (p.peek_punct() == ":") {
        p = p.advance();
        // Open-ended high bound `a[lo:]` — the end defaults to the
        // source length, mirroring the Go parser's nil `High`. We
        // synthesise `base.len()` inline (no new Expr-typed local,
        // which the checker mis-resolves in this nested scope) so
        // every downstream consumer — checker, the three AST
        // emitters, and SSA build_func — sees a real i32 end rather
        // than the `ExprUnknown` placeholder they each mistranslate.
        if (p.peek_punct() == "]") {
          p = p.advance();
          base = e_slice_open(base, idx_expr, bline, bcol);
          continue;
        }
        let (end_expr, end_p) = parse_expr(p);
        p = end_p;
        if (p.peek_punct() != "]") {
          return (e_unknown_at("missing ] in slice", p.peek_line(), p.peek_col()), p);
        }
        p = p.advance();
        base = e_slice(base, idx_expr, end_expr, bline, bcol);
      } else {
        if (p.peek_punct() != "]") {
          return (e_unknown_at("missing ] in index", p.peek_line(), p.peek_col()), p);
        }
        p = p.advance();
        base = e_index(base, idx_expr, bline, bcol);
      }
    } else if (pk == "." || pk == "::") {
      // Field access `obj.field`. Field is either an
      // ident (struct field) or a numeric literal
      // (tuple index — `.0`, `.1`, …). Both shapes
      // store the field name as a bare string.
      // The Go parser positions a FieldAccess at its dot
      // (`FieldAccess{P: dot.Pos}`), so E043 / E046 land there.
      let dline: i32 = p.peek_line();
      let dcol: i32 = p.peek_col();
      p = p.advance();
      let fname: string = p.peek_member_name();
      if (fname.len() == 0) {
        match (p.peek()) {
          lexer.TokNumber(n) => {
            fname = n.text;
          },
          _ => {}
        }
      }
      if (fname.len() == 0) {
        return (e_unknown_at("missing field name after .", p.peek_line(), p.peek_col()), p);
      }
      p = p.advance();
      // Qualified struct literal: `pkg.Type { f: v, … }`. Only
      // when the base is a bare (module) ident and a struct-lit
      // `{` follows — same look-ahead guard parse_primary uses
      // for bare `Name { … }` so it doesn't swallow a
      // `for x in pkg.iter { body }` block. flatten.fern
      // reconstructs parser AST nodes this way
      // (`ast.ExprBinary { … }`), so the self-host parser
      // must accept it to parse its own source.
      let qname: string = "";
      let qline: i32 = 0;
      let qcol: i32 = 0;
      match (base) {
        ast.ExprIdent(qid) => {
          qname = qid.name;
          qline = qid.line;
          qcol = qid.col;
        },
        _ => {}
      }
      let qstruct_ok: boolean = false;
      if (qname.len() > 0 && !p.no_struct && p.peek_punct() == "{") {
        let qlook: Par = p.advance();
        if (qlook.peek_punct() == "}") {
          qstruct_ok = true;
        } else if (qlook.peek_punct() == "...") {
          // Struct-update spread: `pkg.Type { ...base, f: v }`.
          // Mirrors the bare-ident look-ahead below; without
          // this the `...` falls through to a field access and
          // the `{ … }` is mis-parsed (a qualified-type spread
          // such as `asmcore.EmitState { ...s, … }`).
          qstruct_ok = true;
        } else if (qlook.peek_ident().len() > 0) {
          let qlook2: Par = qlook.advance();
          if (qlook2.peek_punct() == ":") {
            qstruct_ok = true;
          }
        }
      }
      if (qstruct_ok) {
        let (qr_expr, qr_p) = parse_struct_lit_body(p, qname + "." + fname, qline, qcol);
        p = qr_p;
        base = qr_expr;
      } else {
        base = e_field_access_at(base, fname, dline, dcol);
      }
    } else if (p.peek_keyword() == "as") {
      // `expr as Type` cast. Desugar to a unary op
      // `as_<Type>` (operand = base); the emitter masks /
      // sign-extends per the target integer width (see
      // asm.fern). Modelling it as a unary keeps `base` in
      // argument position — the checker mishandles `Expr`
      // identity for a reassigned local in var-decl / array-
      // push position but accepts it as a function argument
      // (cf. e_call(base, …) above). Without this branch the
      // parser would stall on the `as` keyword.
      let asline: i32 = p.peek_line();
      let ascol: i32 = p.peek_col();
      p = p.advance();
      // `expr as? Type` downcast (docs/DYN-TRAITS.md §9): an `as`
      // immediately followed by `?` is the fallible `dyn Trait`
      // downcast, NOT the numeric/ascription cast. Disambiguate by
      // peeking the `?` here and tagging the unary op `as?_<Type>`
      // (vs the plain `as_<Type>`); the lowering lowers it to a shape
      // read + compare yielding Option[T]. Consume the `?` now so it
      // binds to `as` and isn't mis-read as the postfix `?` try op.
      let is_downcast: boolean = false;
      if (p.peek_punct() == "?") {
        is_downcast = true;
        p = p.advance();
      }
      // Read the full target type spelling via parse_type_name so the
      // cast op name carries any generic args / array `[]` / qualified
      // `pkg.Type` suffix (`e as i32[]` → `as_i32[]`, `e as Option[i32]`
      // → `as_Option[i32]`) instead of stalling on the brackets or
      // mis-reading them as a postfix index. Earlier this dropped the
      // generic args, so a binding `let x = None as Option[i32]` rebound
      // to the payload-less `let x: Option = None` — which the self-host
      // IR path can't size (a bare `None` has no statically-known payload
      // type), bailing the whole module (#2669). The
      // generic suffix only matters for a payload-less operand like
      // `None` (a `Some(e)` / `[e]` operand carries its own type), but
      // preserving it is uniformly correct and the cast still lowers as a
      // zero-cost identity. Numeric targets (`as i32`, `as f64`) come
      // back as the bare name, so is_numeric_cast_op still recognises
      // them. parse_type_name also folds a trailing `[]` and a qualified
      // `pkg.Type` chain the old single-ident read left on the cursor.
      let (castty_name, castty_fn_ret, castty_p) = parse_type_name(p);
      p = castty_p;
      let tyname: string = castty_name;
      if (is_downcast) {
        base = e_unary_at("as?_" + tyname, base, asline, ascol);
      } else {
        base = e_unary_at("as_" + tyname, base, asline, ascol);
      }
    } else if (p.peek_punct() == "?") {
      // `expr?` try operator. Desugar to the unary op `try_`
      // (operand = base); the emitter unwraps a Some/Ok payload
      // or early-returns the None/Err box from the enclosing
      // (Option/Result-returning) function. Stamp the `?` token's
      // position so the E042 diagnostics anchor where native does.
      let qline: i32 = p.peek_line();
      let qcol: i32 = p.peek_col();
      p = p.advance();
      base = e_unary_at("try_", base, qline, qcol);
    } else {
      break;
    }
  }
  return (base, p);
}

// parse_expr_from_text re-lexes + parses an f-string interpolant's
// raw text into an Expr. The lexer already isolated the interpolant
// (balanced braces, inner string literals skipped), so a fresh
// tokenize + parse_expr round-trip recovers the AST. Mirrors the Go
// parser's parseExprFromText.
//
// `base_line` / `base_col` are where `text` starts in the enclosing
// file. The re-lex numbers `text` from 1:1, so the tokens are rebased
// before parsing and every node the parse produces names the file.
function parse_expr_from_text(text: string, base_line: i32, base_col: i32): ast.Expr {
  let toks: lexer.Token[] = lexer.rebase_tokens(lexer.tokenize(text), base_line, base_col);
  let sub: Par = Par { toks: toks, pos: 0, no_struct: false, map_kind: 0 - 1, structnames: scan_struct_names(toks), verbatim: false, depth: 0, type_errs: [], todos: [] };
  let (r_expr, r_p) = parse_expr(sub);
  return r_expr;
}

// parse_primary: number, ident (which may extend to call), string,
// bool, parenthesised expr, unknown otherwise.
// parse_primary is the depth-guarded face of parse_primary_nested: see MAX_NEST_DEPTH.
function parse_primary(p: Par): (ast.Expr, Par) {
  if (p.too_deep()) {
    return (e_unknown_at("nest:too-deep", p.peek_line(), p.peek_col()), p.bail());
  }
  let (g0, gq) = parse_primary_nested(p.with_depth(p.depth + 1));
  return (g0, gq.with_depth(p.depth));
}

function parse_primary_nested(p: Par): (ast.Expr, Par) {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokNumber(x) => {
      let nline: i32 = p.peek_line();
      let ncol: i32 = p.peek_col();
      p = p.advance();
      // Range-check a float literal where the token becomes a value, the
      // same point the Go parser hands the text to strconv.ParseFloat: a
      // magnitude f64 cannot hold is P002 on both engines, not a silent
      // +Inf (#6842). The rejection uses an ExprUnknown, since the parser
      // has no error list, and still goes through parse_postfix so token
      // consumption is unchanged.
      // `-fmt` opts out (Par.verbatim): a reformat must return the text it
      // was given, and the marker replaces the literal, so keeping the
      // check here would print the program's number away.
      if (!p.verbatim && x.is_float && util.f64_lit_out_of_range(x.text)) {
        return parse_postfix(p, e_unknown_at(util.f64_range_kind(x.text), nline, ncol));
      }
      // Route through parse_postfix so a numeric primary can
      // carry a trailing `as Type` cast (e.g. `15 as u8`).
      if (x.raw.len() > 0) {
        return parse_postfix(p, e_quoted_at(x.text, x.suffix, x.raw, nline, ncol));
      }
      return parse_postfix(p, e_number_at(x.text, x.suffix, x.is_float, nline, ncol));
    },
    lexer.TokString(x) => {
      let sline: i32 = p.peek_line();
      let scol: i32 = p.peek_col();
      p = p.advance();
      // Allow postfix chains on string literals — e.g.
      // `"a,b,c".split(",")`. Without parse_postfix the
      // `.split` would dangle and the surrounding caller
      // would treat the literal as the whole expression.
      return parse_postfix(p, e_string_at(x.value, sline, scol));
    },
    lexer.TokKeyword(x) => {
      if (x.name == "true" || x.name == "false") {
        let bline: i32 = p.peek_line();
        let bcol: i32 = p.peek_col();
        p = p.advance();
        // Route through parse_postfix like the number / string literal
        // arms so a postfix chain on a bool literal (`true.to_i()`) is
        // parsed, not silently dropped (#4338).
        return parse_postfix(p, e_bool_at(x.name == "true", bline, bcol));
      }
      if (x.name == "function") {
        // `function` introduces a NAMED declaration and nothing
        // else (#2673). parse_stmt routes the named form before
        // primary parsing sees it, so reaching here means the
        // keyword appeared mid-expression — the retired anonymous
        // form. Name the arrow lambda that replaced it rather than
        // reporting an unknown token. Mirrors native P006.
        return (e_unknown_at("`function` introduces a named declaration; write an anonymous function as an arrow lambda — `(x: T): R => …`", p.peek_line(), p.peek_col()), p.advance());
      }
      if (x.name == "match") {
        // match-expression in value position: desugar to an
        // immediately-invoked closure wrapping a statement-match whose
        // arms `return` (see parse_match_expr), reusing the existing
        // match + lambda codegen. Route through parse_postfix so
        // `(match …).method()` chains.
        let mc: IfChain = parse_match_expr(p);
        let mno_params: ast.ParamDecl[] = [];
        let mlam_body: ast.Stmt[] = [mc.stmt];
        // The tuple / struct desugars carry their value in a LOCAL (their
        // arm bodies assign to it, see IfChain.value_local) — declare it
        // ahead of the chain and return it after, so the IIFE has exactly
        // one terminal return and lower_value_block treats it as the
        // block's value instead of letting an arm's `return` escape.
        if (mc.value_local.len() > 0) {
          mlam_body = [s_var(mc.value_local, "", zero_expr_for(mc.rt)), mc.stmt, s_return(e_ident(mc.value_local))];
        } else if (mc.needs_default_return) {
          // A desugar with no terminal return at all gets a synthetic one so
          // the IIFE lambda always returns.
          mlam_body = mlam_body.append(s_return(zero_expr_for(mc.rt)));
        }
        let mno_args: ast.Expr[] = [];
        // `{ let __lm = scrut; <the match over __lm> }` — the block a
        // programmer would write to read the scrutinee once.
        if (mc.scrut_bind.len() > 0) {
          let minner: ast.Expr = e_call(e_lambda_origin(mno_params, mc.rt, mlam_body, ORIGIN_MATCH_EXPR), mno_args);
          mlam_body = [mc.scrut_bind[0], s_return(minner)];
        }
        let miife: ast.Expr = e_call(e_lambda_origin(mno_params, mc.rt, mlam_body, ORIGIN_MATCH_EXPR), mno_args);
        return parse_postfix(mc.par, miife);
      }
      if (x.name == "if") {
        // if-expression in value position: desugar to an
        // immediately-invoked closure (see parse_if_chain). Route
        // through parse_postfix so `(if …).method()` chains.
        let ic: IfChain = parse_if_chain(p);
        let no_params: ast.ParamDecl[] = [];
        let lam_body: ast.Stmt[] = [ic.stmt];
        let no_args: ast.Expr[] = [];
        let iife: ast.Expr = e_call(e_lambda_origin(no_params, ic.rt, lam_body, ORIGIN_IF_EXPR), no_args);
        return parse_postfix(ic.par, iife);
      }
      // A TYPE keyword used as a MODULE name: `string.repeat_char(…)`
      // imports std/string, whose basename alias `string` collides with the
      // `string` type keyword, so the lexer emits a keyword token, not an
      // ident. When a type keyword is immediately followed by `.`, it is a
      // module-qualified reference base (not a type) — parse it as a bare
      // ident and let parse_postfix handle the `.field(…)` chain;
      // flatten_qualified then rewrites `string.f` -> `string__f`. Without
      // this the keyword fell through to e_unknown and the call never lowered
      // (the native parser already accepts this form). Guarded by the
      // following `.` so a type keyword in any other position is unaffected.
      let is_tykw: boolean = x.name == "string" || x.name == "boolean" || x.name == "void"
        || x.name == "i32" || x.name == "i64"
        || x.name == "u8" || x.name == "u32" || x.name == "u64"
        || x.name == "usize" || x.name == "f32" || x.name == "f64";
      if (is_tykw) {
        let kwline: i32 = p.peek_line();
        let kwcol: i32 = p.peek_col();
        let look: Par = p.advance();
        if (look.at_path_sep()) {
          return parse_postfix(look, e_ident_at(x.name, kwline, kwcol));
        }
      }
      return (e_unknown_at("keyword:" + x.name, p.peek_line(), p.peek_col()), p);
    },
    lexer.TokIdent(x) => {
      let idline: i32 = p.peek_line();
      let idcol: i32 = p.peek_col();
      p = p.advance();
      let base: ast.Expr = e_ident_at(x.name, idline, idcol);
      // Map literal `Map { k0: v0, … }` — parsed in a helper
      // (kept out of this arm so it stays small enough for the
      // backend's branch-displacement limits).
      if (x.name == "Map" && p.peek_punct() == "{") {
        return parse_map_lit(p);
      }
      // Struct literal: `Name { f: v, g: w }`. Only valid
      // when the base is still a bare ident (the struct
      // type's name). Consumes the whole construct;
      // subsequent postfixes (field access, etc.) can
      // chain through the postfix loop. We disambiguate
      // from `for x in Name { body }` (where `Name` is
      // the iter, not a struct-lit type) by peeking two
      // tokens ahead: a real struct-lit is either empty
      // (`{}`) or starts with `Ident :`. Anything else
      // means the `{` belongs to a surrounding block.
      let struct_lit_ok: boolean = false;
      if (!p.no_struct && p.peek_punct() == "{") {
        let look: Par = p.advance();
        if (look.peek_punct() == "}") {
          struct_lit_ok = true;
        } else if (look.peek_punct() == "...") {
          // `Name { ...base ... }` — struct-update spread.
          struct_lit_ok = true;
        } else if (look.peek_ident().len() > 0) {
          let look2: Par = look.advance();
          if (look2.peek_punct() == ":") {
            struct_lit_ok = true;
          }
        }
      }
      if (struct_lit_ok) {
        // Delegate to the shared body parser (same as the qualified
        // `pkg.Type { … }` path at parse_postfix and the generic
        // `Name[T] { … }` path) rather than re-implementing the
        // spread / field / trailing-comma loop inline (SH-040).
        let (slr_expr, slr_p) = parse_struct_lit_body(p, x.name, idline, idcol);
        p = slr_p;
        base = slr_expr;
      }
      return parse_postfix(p, base);
    },
    lexer.TokPunct(x) => {
      if (x.text == "(") {
        // Arrow lambda `(params) [: R] => expr` — a concise anonymous
        // function whose body is a single expression (desugared to
        // `(params): R => { return expr; }`, the same ExprLambda
        // the verbose form produces). Checked before the grouping /
        // tuple parse: an arrow lambda's parens hold a parameter list
        // (`IDENT : TYPE`, or empty), which a grouping (`(e)`) or tuple
        // (`(e0, e1)`) never does. See #2701.
        if (p.arrow_lambda_at()) {
          return parse_arrow_lambda(p);
        }
        // `(expr)` — grouping. `(e0, e1, …)` — tuple
        // literal. The first expr decides whether we're
        // grouping or building a tuple: a `,` follow-up
        // means tuple; anything else (`)`) means a plain
        // parenthesized expression. Either way the
        // result feeds through the postfix loop so
        // `(a, b).0` and `(f(x)).y` both work.
        let tpl: i32 = p.peek_line();
        let tpc: i32 = p.peek_col();
        p = p.advance();
        // `()` — the unit value (#6040), the sole inhabitant of
        // `void` and the payload of a Result that succeeded with
        // nothing to report (`write_file(...)` → `Ok(())`). It
        // lowers to a constant 0, exactly as the native compiler
        // lowers its UnitLit, so both agree on the payload slot.
        // arrow_lambda_at() already claimed `() => e` above.
        if (p.peek_punct() == ")") {
          p = p.advance();
          return parse_postfix(p, e_unit_at(tpl, tpc));
        }
        let (inner_expr, inner_p) = parse_expr(p);
        p = inner_p;
        if (p.peek_punct() == ",") {
          let elems: ast.Expr[] = [];
          elems = elems.append(inner_expr);
          while (p.peek_punct() == ",") {
            p = p.advance();
            if (p.peek_punct() == ")") {
              break;
            }
            let (er_expr, er_p) = parse_expr(p);
            p = er_p;
            elems = elems.append(er_expr);
          }
          if (p.peek_punct() == ")") {
            p = p.advance();
          }
          return parse_postfix(p, e_tuple_at(elems, tpl, tpc));
        }
        if (p.peek_punct() == ")") {
          p = p.advance();
        }
        return parse_postfix(p, inner_expr);
      }
      if (x.text == "[") {
        // Array literal `[e1, e2, e3]`. Empty `[]` allowed.
        p = p.advance();
        let elems: ast.Expr[] = [];
        if (p.peek_punct() != "]") {
          while (true) {
            let (er_expr, er_p) = parse_expr(p);
            p = er_p;
            elems = elems.append(er_expr);
            let (ea_more, ea_p) = p.more_elems("]");
            p = ea_p;
            if (ea_more) {
              continue;
            }
            break;
          }
        }
        if (p.peek_punct() != "]") {
          return (e_unknown_at("missing ] in array literal", p.peek_line(), p.peek_col()), p);
        }
        p = p.advance();
        return parse_postfix(p, e_array_at(elems, x.line, x.col));
      }
      if (x.text == "{" && !p.no_struct) {
        // General value-position block-expression (#4521) — the
        // self-host mirror of the Go parser's parsePrimary `{` case.
        // Reuse parse_branch_body (the if/match value-branch machinery,
        // which already desugars `{ s; …; tail }` to `[<stmts…>,
        // s_return(tail)]`) and wrap it in an immediately-invoked
        // zero-arg lambda, exactly like the if/match value expressions
        // desugar above. Gated on !no_struct like the `Ident { … }`
        // struct-literal case so a loop/if HEADER's trailing `{` still
        // opens the body rather than being consumed here.
        let (bb_body, bb_rt, bb_p) = parse_branch_body(p);
        let bx_params: ast.ParamDecl[] = [];
        let bx_args: ast.Expr[] = [];
        let iife: ast.Expr = e_call(e_lambda_origin(bx_params, bb_rt, bb_body, ORIGIN_BLOCK), bx_args);
        return parse_postfix(bb_p, iife);
      }
      if (x.text == "-" || x.text == "!") {
        // The Go parser positions a Unary at its operator token
        // (`Unary{P: op.Pos}`), so E009 (`!`) lands there.
        let uline: i32 = p.peek_line();
        let ucol: i32 = p.peek_col();
        p = p.advance();
        let (operand_expr, operand_p) = parse_primary(p);
        return (e_unary_at(x.text, operand_expr, uline, ucol), operand_p);
      }
      // Unknown leading punct — advance past it so the
      // surrounding parse loop can recover. Skipping the
      // advance would loop forever in parse_program when
      // a stmt has stray trailing punct (e.g. tuple-lit
      // postfix that doesn't pair with the TokIdent's
      // chain loop).
      // Capture before the recovery advance: the sentinel names the
      // punct that failed, not the token the parser resumed at.
      let badline: i32 = p.peek_line();
      let badcol: i32 = p.peek_col();
      p = p.advance();
      return (e_unknown_at("punct:" + x.text, badline, badcol), p);
    },
    lexer.TokEof(_) => {
      return (e_unknown_at("eof", p.peek_line(), p.peek_col()), p);
    },
    lexer.TokError(x) => {
      return (e_unknown_at("lex error: " + x.msg, p.peek_line(), p.peek_col()), p);
    },
    lexer.TokFString(f) => {
      p = p.advance();
      if (p.verbatim) {
        let vlits: string[] = [];
        let vexprs: ast.Expr[] = [];
        let vflags: boolean[] = [];
        let vi: i32 = 0;
        while (vi < f.parts.len()) {
          let vpart: lexer.FStringPart = f.parts[vi];
          vflags = vflags.append(vpart.is_expr);
          if (vpart.is_expr) {
            vlits = vlits.append("");
            vexprs = vexprs.append(parse_expr_from_text(vpart.expr, vpart.line, vpart.col));
          } else {
            vlits = vlits.append(vpart.lit);
            vexprs = vexprs.append(e_unknown("fstring-literal-part"));
          }
          vi = vi + 1;
        }
        return parse_postfix(p, ast.ExprFString { lits: vlits, exprs: vexprs, is_expr: vflags, line: f.line, col: f.col });
      }
      // Desugar to a `+`-chain, mirroring the Go checker's
      // FString lowering: literal parts → string literals,
      // interpolant parts → `(<sub-parsed expr>).to_string()`,
      // folded left-to-right. An empty f-string desugars to "".
      let built: ast.Expr = e_string("");
      let has: boolean = false;
      let i: i32 = 0;
      while (i < f.parts.len()) {
        let part: lexer.FStringPart = f.parts[i];
        let piece: ast.Expr = e_string(part.lit);
        if (part.is_expr) {
          let no_args: ast.Expr[] = [];
          piece = e_call(e_field_access(parse_expr_from_text(part.expr, part.line, part.col), "to_string"), no_args);
        }
        if (!has) {
          built = piece;
          has = true;
        } else {
          built = e_binary("+", built, piece);
        }
        i = i + 1;
      }
      // Allow postfix chains on the f-string value (`f"...".len()`),
      // consistent with the plain string-literal arm.
      return parse_postfix(p, built);
    }
  }
  return (e_unknown_at("primary", p.peek_line(), p.peek_col()), p);
}

// precedence: higher binds tighter. Returns -1 for non-binop
// punctuators. Mirrors the Go parser's Pratt-style table.
function precedence(op: string): i32 {
  if (op == "||") {
    return 1;
  }
  if (op == "&&") {
    return 2;
  }
  if (op == "|") {
    return 3;
  }
  if (op == "^") {
    return 4;
  }
  if (op == "&") {
    return 5;
  }
  if (op == "==" || op == "!=") {
    return 6;
  }
  if (op == "<" || op == ">" || op == "<=" || op == ">=") {
    return 7;
  }
  if (op == "<<" || op == ">>" || op == "<<|" || op == "<<?" || op == ">>?") {
    return 8;
  }
  if (op == "+" || op == "-" || op == "+|" || op == "-|" || op == "+?" || op == "-?") {
    return 9;
  }
  if (op == "*" || op == "/" || op == "%" || op == "*|" || op == "*?" || op == "/?" || op == "%?") {
    return 10;
  }
  return 0 - 1;
}

// parse_binary uses precedence climbing. `min_prec` is the
// minimum precedence the caller will accept — recursively
// climbs while the next operator's prec is >= min_prec.
// parse_binary is the depth-guarded face of parse_binary_nested: see MAX_NEST_DEPTH.
function parse_binary(p: Par, min_prec: i32): (ast.Expr, Par) {
  if (p.too_deep()) {
    return (e_unknown_at("nest:too-deep", p.peek_line(), p.peek_col()), p.bail());
  }
  let (g0, gq) = parse_binary_nested(p.with_depth(p.depth + 1), min_prec);
  return (g0, gq.with_depth(p.depth));
}

function parse_binary_nested(p: Par, min_prec: i32): (ast.Expr, Par) {
  let (lhs_expr, lhs_p) = parse_primary(p);
  p = lhs_p;
  while (true) {
    let op: string = p.peek_punct();
    let prec: i32 = precedence(op);
    if (prec < min_prec) {
      return (lhs_expr, p);
    }
    // The Go parser positions a Binary at its operator token
    // (`Binary{P: opTok.Pos}`), so E009 / E041 land there.
    let opline: i32 = p.peek_line();
    let opcol: i32 = p.peek_col();
    p = p.advance();
    let (rhs_expr, rhs_p) = parse_binary(p, prec + 1);
    p = rhs_p;
    lhs_expr = e_binary_at(op, lhs_expr, rhs_expr, opline, opcol);
  }
  return (lhs_expr, p);
}

function parse_expr(p: Par): (ast.Expr, Par) {
  return parse_pipe(p);
}

// IfChain carries a parsed if-expression chain: the StmtIf (whose arms
// `return` the branch expressions) plus a return-type tag for the IIFE.
// needs_default_return marks a desugar whose statement (a struct- or tuple-match
// done-flag if-chain) has no guaranteed terminal return, so the wrapping match-
// expression IIFE lambda would fall through without returning and bail lowering
// (unlike the enum StmtMatch / literal `_`-chain forms, which always return).
// The IIFE builder appends a synthetic terminal `return <zero of rt>` when set;
// the arms are exhaustive so it is unreachable, present only to satisfy the
// return checker. Kept false for enum / literal / if-expr so their emit is
// unchanged.
// value_local names the IIFE-body local a desugar STORES its value into
// instead of returning it. The tuple- / struct-pattern desugars splice their
// arm bodies into a `done`-flag if-chain, so an arm's `return E` ends up as a
// plain statement in the IIFE body — and a multi-statement IIFE body lowers
// INLINE (lower_value_block), which means that `return` returned from the
// ENCLOSING function and the match-expression never produced a value at all.
// With value_local set, parse_primary builds the body as
// `[let v = <zero>; <chain>; return v;]`: the chain's arm tails assign, and the
// single terminal return is the block's value. Empty for every other desugar
// (the StmtIf / StmtMatch forms, whose arm returns ARE the value because their
// bodies are single-statement).
// scrut_bind holds the declaration of the local a literal match reads its
// scrutinee from, when it is not a bare name; stmt then tests that local, and
// parse_primary wraps the match's IIFE in a block that declares it first.
pub struct IfChain { par: Par, stmt: ast.Stmt, rt: string, needs_default_return: boolean, value_local: string, scrut_bind: ast.Stmt[] }

// value_arm_body rewrites a match-EXPRESSION arm body so its value-producing
// terminal `return E` becomes `val = E`. Leading statements are untouched, so
// a user `return` among them still returns from the enclosing function — the
// same rule iife_rewrite_arm_body applies to the StmtMatch form. A body whose
// last statement is not a return (a divergent arm) is left alone; the value
// local keeps its zero.
function value_arm_body(body: ast.Stmt[], val: string): ast.Stmt[] {
  if (body.len() == 0) {
    return body;
  }
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      let out: ast.Stmt[] = [];
      let i: i32 = 0;
      while (i < body.len() - 1) {
        out = out.append(body[i]);
        i = i + 1;
      }
      return out.append(s_assign(val, r.value));
    },
    _ => {
      return body;
    }
  }
  return body;
}

// zero_expr_for builds a throwaway value of scalar return-type `rt` for the
// synthetic terminal return above.
//
// A 64-BIT integer width is carried on the zero as a literal suffix. The value local
// is declared unannotated, so a bare `let v = 0` gives it an i32 slot and the
// arm store `v = 5000000000i64` then has nowhere to go — the module bails with
// "assignment to `…_r` from number literal". The narrower integer tags need no
// suffix: they already fit the i32 slot. Anything else (rt is whatever
// if_expr_rt read off the first arm, including a literal's own suffix) falls to
// i32 0, which at worst re-bails rather than miscompiling.
function zero_expr_for(rt: string): ast.Expr {
  if (rt == "string" || rt == "str") {
    return e_string("");
  }
  if (rt == "boolean") {
    return e_bool(false);
  }
  if (rt == "f64") {
    return e_number("0", "", true);
  }
  if (rt == "i64" || rt == "u64") {
    return e_number("0", rt, false);
  }
  return e_number("0", "", false);
}

// if_expr_rt picks a return-type tag for the if-expression's IIFE from
// the then-branch's shape. The IIFE value itself is always correct (an
// 8-byte slot); this tag only labels the result for the rare case of
// dispatching a method directly on an unannotated if-expression.
function if_expr_rt(e: ast.Expr): string {
  match (e) {
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprBool(_) => {
      return "boolean";
    },
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return "f64";
      }
      // A WIDE literal — explicit `i64` / `u64` suffix, or a magnitude past
      // i32-max — names i64. Defaulting it to i32 gave the desugared IIFE a
      // return type its body contradicted, and since that type is non-empty
      // infer_ret_types_module never revisited it: `let w: i64 = (if (c) {
      // 5000000000 } else { … })` bailed the whole module off the IR path.
      //
      // The other branch kinds were already classified, which is why only
      // wide integers were affected — string / boolean / f64 branches, i64 branches
      // through an IDENT (the slot carries the width), and an i64 if-expr
      // in `return` position inside an i64 function (the enclosing return
      // type supplies it) all lowered fine. A bare wide literal is the one
      // shape with nothing but this classifier to go on.
      // ANY suffix names the type outright, and must be read BEFORE the
      // magnitude rule below: `2147484197u32` is a u32 that happens to
      // exceed i32-max, so classifying it by magnitude calls it i64 and the
      // IIFE returns the wrong type. `mono_infer` in this file already does
      // exactly this; the two are sibling literal classifiers.
      if (n.suffix.len() > 0) {
        return n.suffix;
      }
      if (literal_is_i64(n.text)) {
        return "i64";
      }
      return "i32";
    },
    ast.ExprCall(c) => {
      // A NESTED if / match-EXPRESSION. Both desugar to a 0-arg IIFE over a
      // 0-param lambda whose ret_type this function just computed one level
      // down, so read it back rather than falling through to "i32" — that
      // fall-through is what made nesting lose a width the inner expression
      // had already worked out: `match (…) { Some(v) => v, None => (if (c)
      // { id(803i64) } else { 421i64 }) }` labelled its IIFE i32 and bailed
      // the module, while the same if-expression unnested was fine. Reading
      // the lambda covers a hand-written `((): T => { … })()` too, where
      // the annotation is the author's. #6276.
      if (c.args.len() != 0) {
        return "i32";
      }
      match (c.callee) {
        ast.ExprLambda(lam) => {
          if (lam.params.len() == 0 && lam.ret_type.len() > 0) {
            return lam.ret_type;
          }
          return "i32";
        },
        _ => {
          return "i32";
        }
      }
    },
    ast.ExprBinary(b) => {
      // ARITHMETIC over the branch value. The comment above says "the other
      // branch kinds were already classified" — a binary was not, so
      // `if (c) { 107u64 / 42u64 } else { … }` labelled its IIFE i32 while the
      // body computed u64. Being non-empty, that tag also stops
      // infer_ret_types_module revisiting the lambda, so nothing downstream
      // can recover the width and the module bails ("did not lower: `return`
      // of binary `/`").
      //
      // A comparison yields a boolean whatever its operands are; anything else
      // takes wider_rt of the two sides, the same combination parse_if_chain
      // already applies ACROSS branches, so a width appearing on either side
      // survives.
      if (irt_is_cmp(b.op)) {
        return "boolean";
      }
      return wider_rt(if_expr_rt(b.left), if_expr_rt(b.right));
    },
    ast.ExprUnary(u) => {
      // `!x` is a boolean whatever x is, a cast names its target, and a
      // negation has its operand's width — the same reading mono_infer gives.
      if (u.op == "!") {
        return "boolean";
      }
      if (is_cast_op(u.op)) {
        return slice_unchecked(u.op, 3, u.op.len()) + "";
      }
      return if_expr_rt(u.operand);
    },
    _ => {
      return "i32";
    }
  }
}

// wider_rt combines the two branch tags of an if-expression. The branches yield
// ONE value, so one tag has to describe both, and a 64-bit branch is the one
// that cannot be narrowed: declaring i32 over it is the same contradiction
// if_expr_rt was fixed to stop producing. Anything else keeps the then-branch's
// tag, which is what parse_if_chain did unconditionally — it computed the else
// branch's tag and discarded it, so width appearing only in the else
// branch was still lost (`if (c) { 6 } else { 5000000000 }`).
function wider_rt(a: string, b: string): string {
  if (a == b) {
    return a;
  }
  if (a == "i64" || a == "u64") {
    return a;
  }
  if (b == "i64" || b == "u64") {
    return b;
  }
  return a;
}

// parse_lit_or_range parses a scalar-pattern low bound and, when a `..` /
// `..=` follows, the high bound of a range pattern. Returns (low, high,
// has_range, inclusive, par); high is a dummy when has_range is false.
//
// Bounds parse with parse_binary(p, 4) — min-precedence 4 (just above `|`,
// precedence 3), so a bare `|` is left for the or-pattern splitter
// (parse_lit_alts) rather than being consumed as bitwise-or. A plain literal
// is a primary, so this is byte-identical to the previous min-prec 1 for
// every scalar pattern that doesn't top-level a `|` / `&&` / `||` (none do).
function parse_lit_or_range(p: Par): (ast.Expr, ast.Expr, boolean, boolean, Par) {
  let (lo_expr, lo_p) = parse_binary(p, 4);
  p = lo_p;
  let pk: string = p.peek_punct();
  if (pk == ".." || pk == "..=") {
    p = p.advance();
    let (hi_expr, hi_p) = parse_binary(p, 4);
    p = hi_p;
    return (lo_expr, hi_expr, true, pk == "..=", p);
  }
  return (lo_expr, e_bool(true), false, false, p);
}

// parse_lit_alts parses one-or-more `|`-separated scalar patterns
// (`1 | 2 | 3`, or ranges) sharing a guard + body. Each alternative becomes
// its own LitArm; the parallel arrays run in alternative order.
function parse_lit_alts(p: Par): (ast.Expr[], ast.Expr[], boolean[], boolean[], Par) {
  let lits: ast.Expr[] = [];
  let his: ast.Expr[] = [];
  let hrs: boolean[] = [];
  let incs: boolean[] = [];
  let (l0, h0, hr0, inc0, p0) = parse_lit_or_range(p);
  p = p0;
  lits = lits.append(l0);
  his = his.append(h0);
  hrs = hrs.append(hr0);
  incs = incs.append(inc0);
  while (p.peek_punct() == "|") {
    p = p.advance();
    let (ln, hn, hrn, incn, pn) = parse_lit_or_range(p);
    p = pn;
    lits = lits.append(ln);
    his = his.append(hn);
    hrs = hrs.append(hrn);
    incs = incs.append(incn);
  }
  return (lits, his, hrs, incs, p);
}

// build_literal_match lowers a match on a non-enum scrutinee to a nested
// if/else-if chain — the same shape the native compiler's emitLiteralMatch
// emits. The chain is built
// backwards: the `_` arm's body is the base else; each literal arm wraps
// it as `if (scrut == lit) { body } else { rest }` (a guard folds in as
// `scrut == lit && guard`). The caller only routes here when at least
// one literal arm exists, so the result is always an if statement.
// EXCEPTIONS: two shapes are handed back as a real StmtMatch instead of
// being desugared, because with no StmtMatch left the checker cannot see
// the arms at all — and both are errors it has a rule for.
//
//   * a wildcard `_` that isn't the LAST arm is E026 (native: "wildcard
//     `_` arm must be last"); the backward desugar would silently swallow
//     the unreachable post-`_` arms.
//   * NO unguarded `_` anywhere is E030 — the i32 / string / f64 / boolean
//     domains are open, so native requires the wildcard and
//     scalar_match_exhaustive_diags ports that rule. Desugared, the chain
//     just ends with an empty else, and the arms' `return`s became
//     invisible to the return-path walk: the diagnostic the user got was
//     E052 ("can fall off the end"), naming the wrong problem entirely,
//     and in a void function there was no diagnostic at all (#6683).
//
// The StmtMatch spells the `_` arm as PatWildcard and every literal arm as
// a bare PatVariant("") whose empty type-name the E028 / E015 / union-E030
// checks all skip, so the existing match_diags / block_exits passes emit
// exactly the one code native produces. Neither shape ever type-checks, so
// this StmtMatch never reaches codegen, and a well-formed literal match
// (an unguarded wildcard, last) still desugars unchanged.
function build_literal_match(scrut: ast.Expr, arms: ast.LitArm[], mkline: i32, mkcol: i32): ast.Stmt {
  let wi: i32 = 0;
  let non_last_wild: boolean = false;
  let saw_wild: boolean = false;
  while (wi < arms.len()) {
    // The two questions take DIFFERENT views of a guarded `_ when c`.
    //
    // E026 ("wildcard `_` arm must be last") counts it: native reports the
    // misplaced-wildcard error for any `_` before the end, guard or no
    // guard, and the self-host accepted `_ when c => …, _ => …` outright
    // until this counted it too.
    //
    // Exhaustiveness does not: a guarded `_` may fall through, so only an
    // UNGUARDED one closes the domain and answers E030.
    if (arms[wi].is_wild) {
      if (!arms[wi].has_guard) {
        saw_wild = true;
      }
      if (wi < arms.len() - 1) {
        non_last_wild = true;
      }
    }
    wi = wi + 1;
  }
  if (non_last_wild || !saw_wild) {
    let marms: ast.MatchArm[] = [];
    let mi: i32 = 0;
    while (mi < arms.len()) {
      let la: ast.LitArm = arms[mi];
      let pat: ast.Pattern = p_variant("", "");
      if (la.is_wild) {
        pat = p_wildcard();
      }
      let lbody: ast.Stmt[] = la.body;
      if (la.at_binding.len() > 0) {
        lbody = prepend_stmt(s_var_at(la.at_binding, "", scrut, la.line, la.col), la.body);
      }
      marms = marms.append(ast.MatchArm { pattern: pat, body: lbody, line: la.line, col: la.col, guard: la.guard, has_guard: la.has_guard, alt_cont: false });
      mi = mi + 1;
    }
    return s_match_at(scrut, marms, mkline, mkcol);
  }
  // Every arm's test reads the scrutinee, so anything but a name is
  // evaluated once into a local first.
  let written: ast.Expr = scrut;
  let lm: string = "";
  if let ast.ExprIdent(_) = scrut {} else {
    lm = literal_scrut_local(mkline, mkcol);
    scrut = e_ident(lm);
  }
  let else_body: ast.Stmt[] = [];
  let i: i32 = arms.len() - 1;
  while (i >= 0) {
    let a: ast.LitArm = arms[i];
    if (a.is_wild) {
      if (a.has_guard) {
        else_body = [s_if(a.guard, a.body, else_body)];
      } else {
        else_body = a.body;
      }
    } else {
      // `n @ <pattern>` binds the scrutinee for the body; a guard reads
      // it as the scrutinee itself, which is a name by now.
      let abody: ast.Stmt[] = a.body;
      let aguard: ast.Expr = a.guard;
      if (a.at_binding.len() > 0) {
        abody = prepend_stmt(s_var_at(a.at_binding, "", scrut, a.line, a.col), a.body);
        if let ast.ExprIdent(sid) = scrut {
          aguard = astwalk.subst_ident_expr(a.guard, a.at_binding, sid.name);
        }
      }
      let cond: ast.Expr = e_binary("==", scrut, a.lit);
      if (a.has_range) {
        // `lo..hi` / `lo..=hi` → `scrut >= lo && scrut <op> hi`.
        // Built at parse time, so the self-host checker settles the
        // comparison widths — no manual stamping needed (unlike the
        // native IR path).
        let hi_op: string = "<";
        if (a.range_inclusive) {
          hi_op = "<=";
        }
        cond = e_binary("&&", e_binary(">=", scrut, a.lit), e_binary(hi_op, scrut, a.range_hi));
      }
      if (a.has_guard) {
        cond = e_binary("&&", cond, aguard);
      }
      else_body = [s_if(cond, abody, else_body)];
    }
    i = i - 1;
  }
  if (else_body.len() == 0) {
    return s_unknown_at("empty literal match", mkline, mkcol);
  }
  // The chain replaces the match outright — there is no StmtMatch left — so
  // hang the arms as written off its outermost statement for `-fmt` (#7072).
  let sugar: ast.MatchSugar = ast.MatchSugar { ...no_match_sugar(), scrut: written, lits: arms, line: mkline, col: mkcol };
  if (lm != "") {
    return s_if_match([s_var_at(lm, "", written, mkline, mkcol), else_body[0]], sugar);
  }
  return with_match_sugar(else_body[0], sugar);
}

// with_match_sugar records the match a desugar stands in for on the `if` that
// desugar produced. Printer-only: the arms it carries hold the same statement
// objects the chain does, so every other pass reads the chain.
function with_match_sugar(st: ast.Stmt, sugar: ast.MatchSugar): ast.Stmt {
  match (st) {
    ast.StmtIf(i) => {
      return ast.StmtIf { ...i, sugar: sugar };
    },
    _ => {
      return st;
    }
  }
}

// literal_scrut_local names the local a literal match reads a non-name
// scrutinee from.
pub function literal_scrut_local(line: i32, col: i32): string {
  return "__lm" + util.i32_to_string(line) + "_" + util.i32_to_string(col);
}

// is_literal_scrut_local reports whether `name` is one literal_scrut_local made.
pub function is_literal_scrut_local(name: string): boolean {
  return name.len() > 4 && slice_unchecked(name, 0, 4) == "__lm";
}

// with_written_scrut puts the scrutinee as WRITTEN back on a literal match built
// over its cached local, so `-fmt` reprints the source rather than the local.
function with_written_scrut(st: ast.Stmt, written: ast.Expr): ast.Stmt {
  match (st) {
    ast.StmtIf(i) => {
      return ast.StmtIf { ...i, sugar: ast.MatchSugar { ...i.sugar, scrut: written } };
    },
    _ => {
      return st;
    }
  }
}

// with_sugar_origin re-tags a desugared chain with the source form it stands
// in for. The tuple / struct / literal match builders have no way to know their
// arms came from an `if let` or `let … else` head rather than a `match`, so
// those sites stamp the result rather than every builder growing a parameter.
function with_sugar_origin(st: ast.Stmt, origin: string): ast.Stmt {
  match (st) {
    ast.StmtIf(i) => {
      return ast.StmtIf { ...i, sugar: ast.MatchSugar { ...i.sugar, origin: origin } };
    },
    _ => {
      return st;
    }
  }
}

// p_tuple_carrier wraps a nested tuple element's encoding in a Pattern so it
// can be stored in elem_pats. The variant fields are inert — elem_kinds says 4, and
// only the tup_* fields are read back.
function p_tuple_carrier(kinds: i32[], binds: string[], lits: ast.Expr[], pats: ast.Pattern[]): ast.Pattern {
  let no_extra: string[] = [];
  let no_nested: ast.Pattern[] = [];
  return ast.PatVariant { type_name: "", binding: "", extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: kinds, tup_binds: binds, tup_lits: lits, tup_pats: pats };
}

// parse_tuple_arm_pattern consumes `(p0, p1, …)` with the cursor on the
// opening `(`, returning the element encoding. A parse problem yields
// elem_kinds.len() == 0 (the callers emit a degenerate stmt).

// parse_tuple_arm_pattern is the depth-guarded face of parse_tuple_arm_pattern_nested: see MAX_NEST_DEPTH.
function parse_tuple_arm_pattern(p: Par): (i32[], string[], ast.Expr[], ast.Pattern[], Par) {
  if (p.too_deep()) {
    return ([], [], [], [], p.bail());
  }
  let (g0, g1, g2, g3, gq) = parse_tuple_arm_pattern_nested(p.with_depth(p.depth + 1));
  return (g0, g1, g2, g3, gq.with_depth(p.depth));
}

function parse_tuple_arm_pattern_nested(p: Par): (i32[], string[], ast.Expr[], ast.Pattern[], Par) {
  let elem_kinds: i32[] = [];
  let binds: string[] = [];
  let lits: ast.Expr[] = [];
  let pats: ast.Pattern[] = [];
  let none: i32[] = [];
  let no_pats: ast.Pattern[] = [];
  p = p.advance();  // consume `(`
  while (p.peek_punct() != ")" && !p.at_end()) {
    let n: string = p.peek_ident();
    if (n == "_") {
      p = p.advance();
      elem_kinds = elem_kinds.append(1);
      binds = binds.append("");
      lits = lits.append(e_bool(true));
      pats = pats.append(p_wildcard());
    } else if (p.peek_punct() == "(") {
      // Nested tuple element: the same production, one level down, so
      // `(a, (b, (c, d)))` nests to any depth and every element rule
      // applies at every level (including the 2-element minimum).
      let (ne_kinds, ne_binds, ne_lits, ne_pats, ne_p) = parse_tuple_arm_pattern(p);
      p = ne_p;
      if (ne_kinds.len() == 0) {
        return (none, [], [], no_pats, p);
      }
      elem_kinds = elem_kinds.append(4);
      binds = binds.append("");
      lits = lits.append(e_bool(true));
      pats = pats.append(p_tuple_carrier(ne_kinds, ne_binds, ne_lits, ne_pats));
    } else if (n.len() > 0 && (p.peek_punct_at(1) == "(" || p.peek_punct_at(1) == "." || p.peek_punct_at(1) == "::")) {
      // Variant sub-pattern: a binder is followed by `,` or `)`, so `(`
      // (payload list, empty for a payload-less variant) and `.` (a
      // `mod.` qualifier) both say variant unambiguously. The payload
      // list is the ARM-position production, so a payload slot may hold
      // a nested variant (`A(Ok(n))`), a literal (`A(0)`) or a tuple
      // (`A((a, b))`) — wrap_tuple_elems routes each through the same
      // desugar an arm-position payload takes.
      let (ve_pat, ve_p) = parse_pattern(p);
      p = ve_p;
      elem_kinds = elem_kinds.append(3);
      binds = binds.append("");
      lits = lits.append(e_bool(true));
      pats = pats.append(ve_pat);
    } else if (n.len() > 0) {
      p = p.advance();
      elem_kinds = elem_kinds.append(0);
      binds = binds.append(n);
      lits = lits.append(e_bool(true));
      pats = pats.append(p_wildcard());
    } else if (p.peek_is_pat_literal()) {
      let (le_expr, le_p) = parse_expr(p);
      p = le_p;
      elem_kinds = elem_kinds.append(2);
      binds = binds.append("");
      lits = lits.append(le_expr);
      pats = pats.append(p_wildcard());
    } else {
      return (none, [], [], no_pats, p);
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  if (elem_kinds.len() < 2) {
    return (none, [], [], no_pats, p);
  }
  return (elem_kinds, binds, lits, pats, p);
}

// tuple_elem_names joins the per-element temp names for one level's
// destructure — `prefix_e0,prefix_e1,…`, the comma-joined form a multi-name
// `let` declaration takes.
function tuple_elem_names(prefix: string, n: i32): string {
  let names: string = "";
  let k: i32 = 0;
  while (k < n) {
    if (k > 0) {
      names = names + ",";
    }
    names = names + prefix + "_e" + util.i32_to_string(k);
    k = k + 1;
  }
  return names;
}

// wrap_tuple_elems wraps an arm's matched path in whatever its non-binder
// elements need, innermost element last, and returns the wrapped path.
//
// A variant element (kind 3) nests the path inside a match on the element
// temp — the tag test and the payload binds are exactly what a match arm
// already does, so a payload SUB-PATTERN needs nothing new either: the two
// synthesised arms go through fold_lit_cond and desugar_nested_arms, the same
// pair an arm-position payload takes. A nested tuple element (kind 4)
// destructures the element temp one level deeper, recurses for that level's
// own elements, declares its binders and tests its literals. The destructure
// is irrefutable, so running it before the level's own tests is safe.
function wrap_tuple_elems(path: ast.Stmt[], kinds: i32[], pats: ast.Pattern[], prefix: string, line: i32, col: i32): ast.Stmt[] {
  let cur: ast.Stmt[] = path;
  let wi: i32 = kinds.len() - 1;
  while (wi >= 0) {
    let en: string = prefix + "_e" + util.i32_to_string(wi);
    if (kinds[wi] == 3) {
      let (mk_pat, mk_guard, mk_hg) = fold_lit_cond(pats[wi], e_bool(true), false);
      let mk_arms: ast.MatchArm[] = [];
      mk_arms = mk_arms.append(ast.MatchArm { pattern: mk_pat, body: cur, line: line, col: col, guard: mk_guard, has_guard: mk_hg, alt_cont: false });
      let mk_skip: ast.Stmt[] = [];
      mk_arms = mk_arms.append(ast.MatchArm { pattern: p_wildcard(), body: mk_skip, line: line, col: col, guard: e_bool(true), has_guard: false, alt_cont: false });
      let mk_wrap: ast.Stmt[] = [];
      // Every element of every level shares the arm's line/col, so the
      // element temp name is what keeps the desugar's own temps apart.
      mk_wrap = mk_wrap.append(s_match_at(e_ident_at(en, line, col), desugar_nested_arms(mk_arms, 0, en), line, col));
      cur = mk_wrap;
    } else if (kinds[wi] == 4) {
      let (nk, nb, nl, np) = pv_tup(pats[wi]);
      let sub: ast.Stmt[] = wrap_tuple_elems(cur, nk, np, en, line, col);
      // This level's binder decls sit outside the deeper wraps, so they
      // are in scope for everything the wrap encloses — the deeper
      // elements' tests, the guard and the body.
      let body: ast.Stmt[] = [];
      let bk: i32 = 0;
      while (bk < nk.len()) {
        if (nk[bk] == 0) {
          body = body.append(s_var_at(nb[bk], "", e_ident_at(en + "_e" + util.i32_to_string(bk), line, col), line, col));
        }
        bk = bk + 1;
      }
      let si: i32 = 0;
      while (si < sub.len()) {
        body = body.append(sub[si]);
        si = si + 1;
      }
      let ncond: ast.Expr = e_bool(true);
      let has_ncond: boolean = false;
      let lk: i32 = 0;
      while (lk < nk.len()) {
        if (nk[lk] == 2) {
          let one: ast.Expr = e_binary("==", e_ident(en + "_e" + util.i32_to_string(lk)), nl[lk]);
          if (has_ncond) {
            ncond = e_binary("&&", ncond, one);
          } else {
            ncond = one;
          }
          has_ncond = true;
        }
        lk = lk + 1;
      }
      let nwrap: ast.Stmt[] = [];
      nwrap = nwrap.append(s_var_at(tuple_elem_names(en, nk.len()), "", e_ident_at(en, line, col), line, col));
      if (has_ncond) {
        nwrap = nwrap.append(s_if(ncond, body, []));
      } else {
        let ci: i32 = 0;
        while (ci < body.len()) {
          nwrap = nwrap.append(body[ci]);
          ci = ci + 1;
        }
      }
      cur = nwrap;
    }
    wi = wi - 1;
  }
  return cur;
}

// build_tuple_match assembles the desugared statement described above.
function build_tuple_match(scrut: ast.Expr, arms: ast.TupArm[], mkline: i32, mkcol: i32): ast.Stmt {
  if (arms.len() == 0) {
    return s_unknown_at("empty tuple match", mkline, mkcol);
  }
  // Element count comes from the first tuple-pattern arm (the checker
  // guarantees all arms agree with the scrutinee's arity).
  let n_elems: i32 = 0;
  let ai: i32 = 0;
  while (ai < arms.len()) {
    if (!arms[ai].is_wild) {
      n_elems = arms[ai].elem_kinds.len();
      break;
    }
    ai = ai + 1;
  }
  if (n_elems < 2) {
    return s_unknown_at("tuple match with no tuple arm", mkline, mkcol);
  }
  let base: string = "__tm" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
  let done: string = base + "_d";
  let whole: string = base + "_w";
  let names: string = tuple_elem_names(base, n_elems);
  // Any `@` binding forces caching the whole tuple in `whole` first, so the
  // at-name can alias it while the element destructure reads from it (a
  // single scrutinee eval). Without `@` the destructure reads `scrut`
  // directly — the compiler's own sources take this path, so the emit
  // stays byte-identical.
  let any_at: boolean = false;
  let qi: i32 = 0;
  while (qi < arms.len()) {
    if (!arms[qi].is_wild && arms[qi].at_binding.len() > 0) {
      any_at = true;
    }
    qi = qi + 1;
  }
  let outer: ast.Stmt[] = [];
  if (any_at) {
    outer = outer.append(s_var_at(whole, "", scrut, mkline, mkcol));
    outer = outer.append(s_var_at(names, "", e_ident(whole), mkline, mkcol));
  } else {
    outer = outer.append(s_var_at(names, "", scrut, mkline, mkcol));
  }
  outer = outer.append(s_var(done, "", e_bool(false)));
  ai = 0;
  while (ai < arms.len()) {
    let a: ast.TupArm = arms[ai];
    let cond: ast.Expr = e_unary("!", e_ident(done));
    let inner: ast.Stmt[] = [];
    if (a.is_wild) {
      // `_` arm: no element tests, no binds; a guard folds into
      // the condition (short-circuit keeps it after the flag).
      if (a.has_guard) {
        cond = e_binary("&&", cond, a.guard);
      }
      inner = inner.append(s_assign(done, e_bool(true)));
      let wb: i32 = 0;
      while (wb < a.body.len()) {
        inner = inner.append(a.body[wb]);
        wb = wb + 1;
      }
      outer = outer.append(s_if(cond, inner, []));
      ai = ai + 1;
      continue;
    }
    let ek: i32 = 0;
    while (ek < a.elem_kinds.len()) {
      if (a.elem_kinds[ek] == 2) {
        cond = e_binary("&&", cond, e_binary("==", e_ident(base + "_e" + util.i32_to_string(ek)), a.lits[ek]));
      }
      ek = ek + 1;
    }
    // Binder decls run on the matched path, before the guard.
    let binds: ast.Stmt[] = [];
    // `@` binding: bind the whole matched tuple (cached in `whole`) to
    // the at-name, in scope for the guard + body.
    if (a.at_binding.len() > 0) {
      binds = binds.append(s_var_at(a.at_binding, "", e_ident_at(whole, a.line, a.col), a.line, a.col));
    }
    ek = 0;
    while (ek < a.elem_kinds.len()) {
      if (a.elem_kinds[ek] == 0) {
        binds = binds.append(s_var_at(a.binds[ek], "", e_ident_at(base + "_e" + util.i32_to_string(ek), a.line, a.col), a.line, a.col));
      }
      ek = ek + 1;
    }
    if (a.has_guard) {
      let guarded: ast.Stmt[] = [];
      guarded = guarded.append(s_assign(done, e_bool(true)));
      let gb: i32 = 0;
      while (gb < a.body.len()) {
        guarded = guarded.append(a.body[gb]);
        gb = gb + 1;
      }
      let bi: i32 = 0;
      while (bi < binds.len()) {
        inner = inner.append(binds[bi]);
        bi = bi + 1;
      }
      inner = inner.append(s_if(a.guard, guarded, []));
    } else {
      inner = inner.append(s_assign(done, e_bool(true)));
      let bi2: i32 = 0;
      while (bi2 < binds.len()) {
        inner = inner.append(binds[bi2]);
        bi2 = bi2 + 1;
      }
      let ab: i32 = 0;
      while (ab < a.body.len()) {
        inner = inner.append(a.body[ab]);
        ab = ab + 1;
      }
    }
    // The variant and nested-tuple elements wrap the arm's whole matched
    // path (innermost = last element). The `done` flag is set inside, so a
    // failing tag or nested-literal test falls through to the next arm the
    // way a failing top-level literal test does.
    inner = wrap_tuple_elems(inner, a.elem_kinds, a.elem_pats, base, a.line, a.col);
    outer = outer.append(s_if(cond, inner, []));
    ai = ai + 1;
  }
  let no_struct: ast.StructArm[] = [];
  return s_if_match(outer, ast.MatchSugar { ...no_match_sugar(), scrut: scrut, tup: arms, line: mkline, col: mkcol });
}

// ---- Struct-pattern match (`match (p) { Point { x, y } => … }`) ----
//
// The self-host has no named-field ENUM variant patterns, so an
// `Ident {` at an arm position is unambiguously a STRUCT pattern. A struct
// has one shape, so a struct-pattern arm is irrefutable — it binds the named
// fields and (with a guard) the first arm whose guard passes runs. It
// desugars at parse time, like build_tuple_match, into the `done`-flag chain
// with per-field `let bind = tmp.field;` binds — no checker/lowering changes:
// the field reads + ifs lower through the ordinary paths.
// field_kinds / field_lits / field_pats run parallel to binds / fields and
// carry a field SUB-PATTERN (`P { x: 0, y }`), using the same encoding TupArm
// uses for tuple elements: 0 = plain binder or rename, 2 = literal (tested as
// a condition, because the IR lowers a literal match only through the
// parse-time literal desugar), 3 = variant sub-pattern (the arm's matched path
// nests inside a match on the field). A slot carrying a sub-pattern binds
// nothing itself — its pattern introduces the bindings.
// StructArmPattern is what a struct-match arm's `P { … }` head binds: the
// field projected for each position, the binding, the kind of that position
// (0 = bind, 2 = literal, 3 = sub-pattern) with its literal / sub-pattern, and
// whether the source wrote the trailing `..`. Returned as one value rather
// than as an eighth positional result.
pub struct StructArmPattern { binds: string[], fields: string[], kinds: i32[], lits: ast.Expr[], pats: ast.Pattern[], rest_written: boolean, ok: boolean }

// parse_struct_arm_pattern consumes `S { x, y }` (shorthand fields) or
// `S { x: a, y: b }` (renamed: field `x` bound to local `a`); a trailing
// `..` marks omitted fields, the cursor on the struct-name ident. Returns the
// parallel binding + field name lists (fields[i] is the projected field,
// binds[i] the local it binds). The struct name is not retained — the
// scrutinee's type drives field resolution at lowering.
function parse_struct_arm_pattern(p: Par): (StructArmPattern, Par) {
  let binds: string[] = [];
  let fields: string[] = [];
  let kinds: i32[] = [];
  let lits: ast.Expr[] = [];
  let pats: ast.Pattern[] = [];
  let ok: boolean = true;
  let rest_written: boolean = false;
  if (p.peek_ident().len() > 0) {  // struct name
    p = p.advance();
  }
  if (p.peek_punct() == "{") {
    p = p.advance();
  }
  while (p.peek_punct() != "}" && !p.at_end()) {
    if (p.peek_punct() == "..") {
      p = p.advance();
      rest_written = true;
      break;
    }
    let fld: string = p.peek_ident();
    // Nothing below consumes a non-ident field token, so the loop stops on
    // one or it spins. The arm is malformed, and `ok` is what says so —
    // dropping the token instead would compile a pattern binding less
    // than the source asked for.
    if (fld.len() == 0) {
      p = p.advance();
      ok = false;
      break;
    }
    p = p.advance();
    let bind: string = fld;
    let fkind: i32 = 0;
    let flit: ast.Expr = e_bool(true);
    let fpat: ast.Pattern = p_wildcard();
    if (p.peek_punct() == ":") {
      p = p.advance();
      // `field: <x>` is a rename when x is a plain local — an ident
      // followed by `,` or `}` — and a SUB-PATTERN otherwise. The same
      // line the native parser draws, so the two agree on what recurses.
      if (p.peek_is_pat_literal()) {
        let (le_expr, le_p) = parse_expr(p);
        p = le_p;
        fkind = 2;
        flit = le_expr;
        bind = "";
      } else if (struct_field_variant_start(p)) {
        let (fp, fpp) = parse_pattern(p);
        p = fpp;
        fkind = 3;
        fpat = fp;
        bind = "";
      } else {
        let lc: string = p.peek_ident();
        if (lc.len() > 0) {
          p = p.advance();
        }
        bind = lc;
      }
    }
    binds = binds.append(bind);
    fields = fields.append(fld);
    kinds = kinds.append(fkind);
    lits = lits.append(flit);
    pats = pats.append(fpat);
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (StructArmPattern { binds: binds, fields: fields, kinds: kinds, lits: lits, pats: pats, rest_written: rest_written, ok: ok }, p);
}

// struct_field_variant_start reports whether the cursor (just past a
// `field:`) opens a VARIANT sub-pattern rather than naming a rename local. A
// rename is a bare ident followed by `,` or `}`, so `(` (payload list, empty
// for a payload-less variant) and `.` (a `mod.` qualifier) both say variant.
function struct_field_variant_start(p: Par): boolean {
  let n: string = p.peek_ident();
  if (n.len() > 0 && n != "_") {
    let nx: string = p.peek_punct_at(1);
    if (nx == "(" || nx == "." || nx == "::") {
      return true;
    }
  }
  return false;
}

function build_struct_match(scrut: ast.Expr, arms: ast.StructArm[], mkline: i32, mkcol: i32): ast.Stmt {
  if (arms.len() == 0) {
    return s_unknown_at("empty struct match", mkline, mkcol);
  }
  let base: string = "__sm" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
  let tmp: string = base + "_v";
  let done: string = base + "_d";
  let outer: ast.Stmt[] = [];
  outer = outer.append(s_var(tmp, "", scrut));
  outer = outer.append(s_var(done, "", e_bool(false)));
  let ai: i32 = 0;
  while (ai < arms.len()) {
    let a: ast.StructArm = arms[ai];
    let cond: ast.Expr = e_unary("!", e_ident(done));
    let inner: ast.Stmt[] = [];
    if (a.is_wild) {
      if (a.has_guard) {
        cond = e_binary("&&", cond, a.guard);
      }
      inner = inner.append(s_assign(done, e_bool(true)));
      let wb: i32 = 0;
      while (wb < a.body.len()) {
        inner = inner.append(a.body[wb]);
        wb = wb + 1;
      }
      outer = outer.append(s_if(cond, inner, []));
      ai = ai + 1;
      continue;
    }
    // A LITERAL field is an equality test folded into the arm condition —
    // the same treatment a literal tuple element gets, and the reason it
    // is not a nested match: the IR lowers a literal match only through
    // the parse-time literal desugar, not from a raw match node.
    let lk: i32 = 0;
    while (lk < a.field_kinds.len()) {
      if (a.field_kinds[lk] == 2) {
        cond = e_binary("&&", cond, e_binary("==", e_field_access_at(e_ident(tmp), a.fields[lk], a.line, a.col), a.field_lits[lk]));
      }
      lk = lk + 1;
    }
    let binds: ast.Stmt[] = [];
    // `@` binding: bind the whole matched struct (the cached scrutinee
    // `tmp`) to the at-name, in scope for the guard + body.
    if (a.at_binding.len() > 0) {
      binds = binds.append(s_var_at(a.at_binding, "", e_ident(tmp), a.line, a.col));
    }
    let bk: i32 = 0;
    while (bk < a.binds.len()) {
      // A field carrying a sub-pattern binds nothing itself — the
      // wrap below matches it and its pattern introduces the bindings.
      if (a.binds[bk].len() > 0) {
        binds = binds.append(s_var_at(a.binds[bk], "", e_field_access_at(e_ident(tmp), a.fields[bk], a.line, a.col), a.line, a.col));
      }
      bk = bk + 1;
    }
    if (a.has_guard) {
      let guarded: ast.Stmt[] = [];
      guarded = guarded.append(s_assign(done, e_bool(true)));
      let gb: i32 = 0;
      while (gb < a.body.len()) {
        guarded = guarded.append(a.body[gb]);
        gb = gb + 1;
      }
      let bi: i32 = 0;
      while (bi < binds.len()) {
        inner = inner.append(binds[bi]);
        bi = bi + 1;
      }
      inner = inner.append(s_if(a.guard, guarded, []));
    } else {
      inner = inner.append(s_assign(done, e_bool(true)));
      let bi2: i32 = 0;
      while (bi2 < binds.len()) {
        inner = inner.append(binds[bi2]);
        bi2 = bi2 + 1;
      }
      let ab: i32 = 0;
      while (ab < a.body.len()) {
        inner = inner.append(a.body[ab]);
        ab = ab + 1;
      }
    }
    // A field sub-pattern (`P { x: 0, y }`) tests the field and binds
    // whatever its pattern binds — which is what a match arm already
    // does, so the arm's whole matched path nests inside one match per
    // such field (innermost = last field). The `done` flag is set inside,
    // so a failing field falls through to the next arm.
    inner = wrap_struct_fields(inner, a, tmp);
    outer = outer.append(s_if(cond, inner, []));
    ai = ai + 1;
  }
  let no_tup: ast.TupArm[] = [];
  return s_if_match(outer, ast.MatchSugar { ...no_match_sugar(), scrut: scrut, strct: arms, line: mkline, col: mkcol });
}

// wrap_struct_fields nests the arm's matched path inside a match on each
// field that carries a sub-pattern, innermost field last.
function wrap_struct_fields(path: ast.Stmt[], a: ast.StructArm, tmp: string): ast.Stmt[] {
  let cur: ast.Stmt[] = path;
  let wi: i32 = a.field_kinds.len() - 1;
  while (wi >= 0) {
    if (a.field_kinds[wi] == 3) {
      let mk_arms: ast.MatchArm[] = [];
      mk_arms = mk_arms.append(ast.MatchArm { pattern: a.field_pats[wi], body: cur, line: a.line, col: a.col, guard: e_bool(true), has_guard: false, alt_cont: false });
      let mk_skip: ast.Stmt[] = [];
      mk_arms = mk_arms.append(ast.MatchArm { pattern: p_wildcard(), body: mk_skip, line: a.line, col: a.col, guard: e_bool(true), has_guard: false, alt_cont: false });
      // Match on an IDENT holding the field, not on the field access
      // itself: the scrutinee is read once, and the IR lowers a match on
      // a local where a match on a field expression bails to the AST
      // emitter (which no longer exists).
      let fv: string = tmp + "_f" + util.i32_to_string(wi);
      let mk_wrap: ast.Stmt[] = [];
      mk_wrap = mk_wrap.append(s_var_at(fv, "", e_field_access_at(e_ident(tmp), a.fields[wi], a.line, a.col), a.line, a.col));
      mk_wrap = mk_wrap.append(s_match_at(e_ident_at(fv, a.line, a.col), mk_arms, a.line, a.col));
      cur = mk_wrap;
    }
    wi = wi - 1;
  }
  return cur;
}

// is_struct_pattern_arm reports whether the arm the cursor sits on destructures
// a STRUCT (`Point { x, y }`, or `w @ Point { x, y }`) rather than a record-form
// enum variant, which is spelled identically — see Par.structnames for how the
// two are told apart. Only the arm's head name is inspected: the struct-pattern
// desugar is chosen once, off the first arm, so this decides for the match.
function is_struct_pattern_arm(p: Par): boolean {
  let head: string = p.peek_ident();
  if (head.len() > 0 && p.peek_punct_at(1) == "@") {
    head = p.peek_ident_at(2);
  }
  if (head.len() == 0) {
    return false;
  }
  return util.has_str(p.structnames, head);
}

// parse_struct_match_arms parses the arm list of a struct match (cursor just
// past the opening `{`), returning the arms + the first arm's return-type tag.
// Shared by the statement and expression forms: expr_form=true parses each arm
// body as a value branch (`parse_branch_body` / a bare tail expr, so the IIFE
// wrapper yields it); expr_form=false parses a statement block (`parse_block`).
function parse_struct_match_arms(p: Par, expr_form: boolean): (ast.StructArm[], string, boolean, Par) {
  let arms: ast.StructArm[] = [];
  let rt: string = "i32";
  let first: boolean = true;
  let all_ok: boolean = true;
  while (p.peek_punct() != "}" && !p.at_end()) {
    let sline: i32 = p.peek_line();
    let scol: i32 = p.peek_col();
    let s_wild: boolean = false;
    let s_binds: string[] = [];
    let s_fields: string[] = [];
    let s_rest: boolean = false;
    let s_field_kinds: i32[] = [];
    let s_field_lits: ast.Expr[] = [];
    let s_field_pats: ast.Pattern[] = [];
    let s_at: string = "";
    let s_type: string = "";
    // Optional `name @` prefix: bind the whole matched struct to `name`
    // while destructuring its fields (`w @ Point { x, y }`).
    if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
      s_at = p.peek_ident();
      p = p.advance();
      p = p.advance();
    }
    if (p.peek_ident() == "_" && p.peek2_punct() != "{") {
      p = p.advance();
      s_wild = true;
    } else {
      // The struct name the arm spelled. parse_struct_arm_pattern
      // consumes and discards it (the desugar binds fields off a temp
      // and never needs it); the printer does need it, and the cursor
      // is on it here.
      s_type = p.peek_ident();
      let (sap, spp) = parse_struct_arm_pattern(p);
      let spb: string[] = sap.binds;
      let spf: string[] = sap.fields;
      let spkinds: i32[] = sap.kinds;
      let splits: ast.Expr[] = sap.lits;
      let sppats: ast.Pattern[] = sap.pats;
      let spok: boolean = sap.ok;
      p = spp;
      s_binds = spb;
      s_fields = spf;
      s_rest = sap.rest_written;
      s_field_kinds = spkinds;
      s_field_lits = splits;
      s_field_pats = sppats;
      if (!spok) {
        all_ok = false;
      }
    }
    let s_guard: ast.Expr = e_bool(true);
    let s_has_guard: boolean = false;
    if (p.peek_keyword() == "when") {
      p = p.advance();
      let (sgr_expr, sgr_p) = parse_expr(p);
      p = sgr_p;
      s_guard = sgr_expr;
      s_has_guard = true;
    }
    if (p.peek_punct() == "=>") {
      p = p.advance();
    }
    let sbody: ast.Stmt[] = [];
    let sbrt: string = "i32";
    if (expr_form) {
      if (p.peek_punct() == "{") {
        let (sbb_body, sbb_rt, sbb_p) = parse_branch_body(p);
        p = sbb_p;
        sbody = sbb_body;
        sbrt = sbb_rt;
      } else {
        let (ser_expr, ser_p) = parse_expr(p);
        p = ser_p;
        sbody = [s_return(ser_expr)];
        sbrt = if_expr_rt(ser_expr);
      }
    } else {
      let (sblk_body, sblk_p) = parse_block(p);
      p = sblk_p;
      sbody = sblk_body;
    }
    if (first) {
      rt = sbrt;
      first = false;
    }
    arms = arms.append(ast.StructArm { is_wild: s_wild, type_name: s_type, binds: s_binds, fields: s_fields, field_kinds: s_field_kinds, field_lits: s_field_lits, field_pats: s_field_pats, at_binding: s_at, rest_written: s_rest, guard: s_guard, has_guard: s_has_guard, body: sbody, line: sline, col: scol });
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (arms, rt, all_ok, p);
}

// parse_branch_body yields a parsed if/match value-branch body: the
// Stmt[] (leading statements followed by `s_return(tail)`) plus the
// return-type tag derived from the TAIL expression (the block's value).

// branch_stmt_start reports whether the next token begins a STATEMENT
// inside an if/match value-branch body (block-expressions slice 1). These
// are the keyword-led statements parse_stmt handles directly (each
// consumes its own terminator) plus a nested `{`-block. `if` / `match`
// are deliberately EXCLUDED: they stand as the trailing value expression
// (`{ …; if (c) { a } else { b } }`) and the single-expr branch form
// `else { if (c) { … } else { … } }` relies on the inner if/match parsing
// as a value-expression. Everything else parses as an expression
// (an ExprStmt when a `;` follows, else the trailing tail). Mirrors the
// Go parser's branchStmtStart.
// is_compound_assign_op reports whether `op` is one of the compound
// assignment tokens parse_stmt desugars to `target = target <op> rhs`. The set
// mirrors the native parser's compoundOps map exactly, so both front-ends
// desugar the same operators to the same binary op.
function is_compound_assign_op(op: string): boolean {
  return op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%="
    || op == "&=" || op == "|=" || op == "^=" || op == "<<=" || op == ">>=";
}

function branch_stmt_start(p: Par): boolean {
  if (p.peek_punct() == "{") {
    return true;
  }
  let kw: string = p.peek_keyword();
  // #4522: an else-LESS `if` in a block body is a control-flow STATEMENT
  // (`{ if (early) { return 0; } …; tail }`), not the value expression — an
  // if-EXPRESSION requires `else`, so an else-less `if` can never be a tail
  // value. An `if` WITH `else` stays on the expression path so
  // `{ …; if (c) { a } else { b } }` still yields a value and the else-if
  // chain form is unaffected.
  if (kw == "if" && !p.if_stmt_has_else()) {
    return true;
  }
  if (kw == "while" || kw == "loop" || kw == "for" || kw == "break"
    || kw == "continue" || kw == "return" || kw == "defer"
    || kw == "errdefer" || kw == "let"
    || kw == "function") {
    return true;
  }
  return false;
}

// branch_stmts_diverge reports whether a value-branch body's statements exit
// on every path, so the block never falls through to a trailing value. Mirrors
// the Go checker's stmtsDiverge / stmtDiverges: only the LAST statement is
// consulted, `loop { … }` counts as unconditional (breaks are ignored, the same
// conservative stance the Go side takes), an `if` needs both arms, and a `match`
// needs every arm.
pub function branch_stmts_diverge(stmts: ast.Stmt[]): boolean {
  if (stmts.len() == 0) {
    return false;
  }
  return branch_stmt_diverges(stmts[stmts.len() - 1]);
}

function branch_stmt_diverges(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtReturn(_) => {
      return true;
    },
    ast.StmtBreak(_) => {
      return true;
    },
    ast.StmtContinue(_) => {
      return true;
    },
    ast.StmtWhile(w) => {
      return w.is_loop;
    },
    ast.StmtIf(f) => {
      if (f.else_body.len() == 0) {
        return false;
      }
      return branch_stmts_diverge(f.then_body) && branch_stmts_diverge(f.else_body);
    },
    ast.StmtMatch(m) => {
      if (m.arms.len() == 0) {
        return false;
      }
      let i: i32 = 0;
      while (i < m.arms.len()) {
        if (!branch_stmts_diverge(m.arms[i].body)) {
          return false;
        }
        i = i + 1;
      }
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// branch_dead_tail picks the UNREACHABLE value a diverging branch is given so
// its shape matches every other value branch (leading statements + a trailing
// value). It reuses the `return E` the block leaves through; anything else — a
// `loop`, a bare `break`, a void `return` — takes a zero, which no path can
// read. Its type is the enclosing function's, not the block's, so the checker
// does not count a diverging branch among the block's arm types.
function branch_dead_tail(stmts: ast.Stmt[]): ast.Expr {
  if (stmts.len() == 0) {
    return e_number("0", "", false);
  }
  match (stmts[stmts.len() - 1]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprUnknown(_) => {
          return e_number("0", "", false);
        },
        _ => {
          return r.value;
        }
      }
    },
    _ => {
      return e_number("0", "", false);
    }
  }
  return e_number("0", "", false);
}

// parse_branch_body parses the `{ … }` body of an if/match value-branch
// (block-expressions slice 1), mirroring the Go parser's parseBranchBody.
// The body is a sequence of `;`-terminated statements run before an
// optional trailing expression written WITHOUT a `;` — that trailing
// expression is the branch's value. The cursor is expected on `{`.
//
//   - `{ e }`          → `[s_return(e)]` (single-expr branch, kept
//     byte-identical to the pre-block-expr behaviour so existing
//     if/match expressions don't regress).
//   - `{ s; …; tail }` → `[<leading stmts…>, s_return(tail)]`, which
//     the lowering already lowers (leading statements +
//     a final value-producing statement).
//
// A keyword-led item (var/let/while/… or a nested `{`-block) parses as a
// statement via parse_stmt. A non-keyword item parses as an expression:
// an ExprStmt if a `;` follows, otherwise the trailing TAIL (which must
// be followed by `}`). The `rt` tag is derived from the TAIL expression
// (the value), not a leading statement, so the desugared IIFE / value-
// lowering gets the right return type.
// parse_block_items scans a `{ … }` body into its leading statements plus
// an optional trailing value, without deciding what a missing value means —
// that is the caller's, because a value BRANCH must produce one (E061) and a
// lambda body need not (it is simply void). The cursor is expected on `{`;
// `ok` is false when it is not, and the caller reports the shape it wanted.
function parse_block_items(p: Par): (ast.Stmt[], boolean, ast.Expr, boolean, Par) {
  let leading: ast.Stmt[] = [];
  let have_tail: boolean = false;
  let tail: ast.Expr = e_unknown("empty branch");
  if (p.peek_punct() != "{") {
    return (leading, have_tail, tail, false, p);
  }
  p = p.advance();  // consume `{`
  while (p.peek_punct() != "}" && !p.at_end()) {
    if (branch_stmt_start(p)) {
      let (sr_stmt, sr_p) = parse_stmt(p);
      // Progress guard: a malformed statement that consumed no token
      // would otherwise spin forever — skip it instead.
      if (sr_p.pos == p.pos) {
        p = p.advance();
        continue;
      }
      p = sr_p;
      leading = leading.append(sr_stmt);
      continue;
    }
    // Non-keyword item: an expression that is either an ExprStmt
    // (followed by `;`) or the trailing value (followed by `}`).
    let before: Par = p;
    let (er_expr, er_p) = parse_expr(p);
    p = er_p;
    if (p.peek_punct() == ";") {
      p = p.advance();
      leading = leading.append(s_expr(er_expr));
      continue;
    }
    if (p.peek_punct() != "}") {
      // Neither a `;` nor the closing brace follows, so this item is not
      // a value. Two shapes reach here: an ASSIGNMENT, whose target
      // parse_expr read as an expression before stopping in front of the
      // `=` (none of the assign operators is in the precedence table),
      // and an `if` / `match` STATEMENT with more statements after it —
      // both stay on the expression path because either can also be the
      // block's trailing value, and only what follows tells them apart.
      // Read the item again from the top as the statement it is.
      let (asr_stmt, asr_p) = parse_stmt(before);
      if (asr_p.pos == before.pos) {
        p = p.advance();
        continue;
      }
      p = asr_p;
      leading = leading.append(asr_stmt);
      continue;
    }
    // `}` follows, so this is the trailing tail expression.
    tail = er_expr;
    have_tail = true;
    break;
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (leading, have_tail, tail, true, p);
}

function parse_branch_body(p: Par): (ast.Stmt[], string, Par) {
  let rt: string = "i32";
  let (bi_leading, bi_have_tail, bi_tail, bi_ok, bi_p) = parse_block_items(p);
  if (!bi_ok) {
    let ebody: ast.Stmt[] = [];
    ebody = ebody.append(s_unknown(p, "missing { in branch body"));
    return (ebody, rt, p);
  }
  let leading: ast.Stmt[] = bi_leading;
  let have_tail: boolean = bi_have_tail;
  let tail: ast.Expr = bi_tail;
  p = bi_p;
  if (have_tail) {
    rt = if_expr_rt(tail);
  }
  // A value-less block (no trailing tail) in value position has no
  // result — yield a StmtUnknown so the branch surfaces an error rather
  // than silently miscompiling (the Go checker reports E061). A block
  // whose statements ALWAYS exit early never reaches a trailing value:
  // its type is `never`, not void, so it is admitted (#4522). Every one of
  // its statements stays LEADING — the value-block lowering runs those inline,
  // which is what lets their `return` / `break` leave the enclosing function
  // or loop — and the block gets an unreachable tail so its shape is the one
  // the lowering reads (leading statements + a trailing value).
  if (!have_tail) {
    if (!branch_stmts_diverge(leading)) {
      leading = leading.append(s_unknown(p, "value branch has no trailing expression"));
      return (leading, rt, p);
    }
    let dead: ast.Expr = branch_dead_tail(leading);
    rt = if_expr_rt(dead);
    leading = leading.append(s_return(dead));
    return (leading, rt, p);
  }
  leading = leading.append(s_return(tail));
  return (leading, rt, p);
}

// parse_if_chain parses `if (c) { E1 } else { E2 }` (and `else if`
// chains, via recursion through the else arm) into a StmtIf whose arms
// `return` the branch expressions. parse_primary wraps the result in an
// IIFE `((): RT => { <stmt> })()`, so it lowers to the ExprCall +
// ExprLambda the rest of the pipeline already handles — no new AST node,
// so every backend supports if-expressions at once. The IIFE captures
// any referenced locals automatically (the lambda machinery computes
// captures). Mirrors the Go parser's parseIfExpr: then/else are
// block-with-tail bodies (block-expressions slice 1) — a multi-statement
// branch (`{ let k = …; k }`) runs the leading statements then yields the
// trailing tail — and a final `else` is required (the if-expression is
// total). A lone trailing expression with no leading statements stays
// `[s_return(expr)]`, byte-identical to the pre-block-expr behaviour.
function parse_if_chain(p: Par): IfChain {
  p = p.advance();  // `if`
  if (p.peek_punct() == "(") {
    p = p.advance();
  }
  let (condr_expr, condr_p) = parse_expr(p);
  p = condr_p;
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  let (thenb_body, thenb_rt, thenb_p) = parse_branch_body(p);
  p = thenb_p;
  let then_body: ast.Stmt[] = thenb_body;
  let rt: string = thenb_rt;
  if (p.peek_keyword() == "else") {
    p = p.advance();
  }
  let else_body: ast.Stmt[] = [];
  if (p.peek_keyword() == "if") {
    // `else if (…) { … }` — the else arm is itself an if-chain.
    let nested: IfChain = parse_if_chain(p);
    p = nested.par;
    else_body = [nested.stmt];
  } else {
    let (elseb_body, elseb_rt, elseb_p) = parse_branch_body(p);
    p = elseb_p;
    else_body = elseb_body;
    rt = wider_rt(rt, elseb_rt);
  }
  return IfChain { par: p, stmt: s_if(condr_expr, then_body, else_body), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
}

// parse_match_expr parses `match (e) { Pat => E, Pat when C => E, … }` in value
// position into a StmtMatch whose arms `return` their (bare) expression, plus a
// return-type tag for the IIFE. parse_primary wraps the result in an IIFE
// (`((): RT => { <stmt> })()`), so it reuses the statement-match + lambda
// codegen every backend already supports — no new AST node, so all backends
// get match-expressions at once (mirrors parse_if_chain).
function parse_match_expr(p: Par): IfChain {
  let mkline: i32 = p.peek_line();
  let mkcol: i32 = p.peek_col();
  p = p.advance();  // `match`
  if (p.peek_punct() == "(") {
    p = p.advance();
  }
  let (sr_expr, sr_p) = parse_expr(p);
  p = sr_p;
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  let rt: string = "i32";
  if (p.peek_punct() == "{") {
    p = p.advance();
  }
  // A `(` at the FIRST arm's pattern position marks a match on a
  // TUPLE scrutinee — same build_tuple_match desugar as the statement
  // form; the surrounding IIFE (built by the caller) turns the
  // arm bodies' `return`s into the expression's value.
  if (p.peek_punct() == "(" || p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek_punct_at(1) == "@" && p.peek_punct_at(2) == "(") {
    let etarms: ast.TupArm[] = [];
    let etfirst: boolean = true;
    while (p.peek_punct() != "}" && !p.at_end()) {
      let etline: i32 = p.peek_line();
      let etcol: i32 = p.peek_col();
      let et_wild: boolean = false;
      let et_empty_body: ast.Stmt[] = [];
      let et_at: string = "";
      // Optional `name @` prefix: bind the whole matched tuple.
      if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
        et_at = p.peek_ident();
        p = p.advance();
        p = p.advance();
      }
      // Partial-TupArm buffer (guard + body filled after parsing),
      // same IR-eligible struct-array shape as the statement form.
      let etpats: ast.TupArm[] = [];
      if (p.peek_punct() == "(") {
        let (etpr_elem_kinds, etpr_binds, etpr_lits, etpr_pats, etpr_p) = parse_tuple_arm_pattern(p);
        p = etpr_p;
        if (etpr_elem_kinds.len() == 0) {
          return IfChain { par: p, stmt: s_unknown(p, "bad tuple pattern"), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
        }
        etpats = etpats.append(ast.TupArm { is_wild: false, elem_kinds: etpr_elem_kinds, binds: etpr_binds, lits: etpr_lits, elem_pats: etpr_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: et_empty_body, line: etline, col: etcol, alt_cont: false });
        // Tuple or-patterns: one TupArm per `|` alternative sharing
        // the guard + body (per-alternative binds), same as the
        // statement form and the native per-alternative desugar.
        while (p.peek_punct() == "|") {
          p = p.advance();
          let (etor_kinds, etor_binds, etor_lits, etor_pats, etor_p) = parse_tuple_arm_pattern(p);
          p = etor_p;
          if (etor_kinds.len() == 0) {
            return IfChain { par: p, stmt: s_unknown(p, "bad tuple pattern"), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
          }
          etpats = etpats.append(ast.TupArm { is_wild: false, elem_kinds: etor_kinds, binds: etor_binds, lits: etor_lits, elem_pats: etor_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: et_empty_body, line: etline, col: etcol, alt_cont: false });
        }
      } else {
        let (etwp_pattern, etwp_p) = parse_pattern(p);
        p = etwp_p;
        et_wild = true;
      }
      let et_guard: ast.Expr = e_bool(true);
      let et_has_guard: boolean = false;
      if (p.peek_keyword() == "when") {
        p = p.advance();
        let (etgr_expr, etgr_p) = parse_expr(p);
        p = etgr_p;
        et_guard = etgr_expr;
        et_has_guard = true;
      }
      if (p.peek_punct() == "=>") {
        p = p.advance();
      }
      let etbody: ast.Stmt[] = [];
      let etrt: string = "i32";
      if (p.peek_punct() == "{") {
        let (etbb_body, etbb_rt, etbb_p) = parse_branch_body(p);
        p = etbb_p;
        etbody = etbb_body;
        etrt = etbb_rt;
      } else {
        let (eter_expr, eter_p) = parse_expr(p);
        p = eter_p;
        etbody = [s_return(eter_expr)];
        etrt = if_expr_rt(eter_expr);
      }
      if (etfirst) {
        rt = etrt;
        etfirst = false;
      }
      if (et_wild) {
        let etw_kinds: i32[] = [];
        let etw_pats: ast.Pattern[] = [];
        let etw_binds: string[] = [];
        let etw_lits: ast.Expr[] = [];
        etarms = etarms.append(ast.TupArm { is_wild: true, elem_kinds: etw_kinds, binds: etw_binds, lits: etw_lits, elem_pats: etw_pats, at_binding: "", guard: et_guard, has_guard: et_has_guard, body: etbody, line: etline, col: etcol, alt_cont: false });
      } else {
        let etalt: i32 = 0;
        while (etalt < etpats.len()) {
          let etpa: ast.TupArm = etpats[etalt];
          etarms = etarms.append(ast.TupArm { is_wild: false, elem_kinds: etpa.elem_kinds, binds: etpa.binds, lits: etpa.lits, elem_pats: etpa.elem_pats, at_binding: et_at, guard: et_guard, has_guard: et_has_guard, body: etbody, line: etline, col: etcol, alt_cont: etalt > 0 });
          etalt = etalt + 1;
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
        continue;
      }
      break;
    }
    if (p.peek_punct() == "}") {
      p = p.advance();
    }
    // Route the arm values through a value LOCAL rather than through
    // `return`: build_tuple_match splices each arm body into the done-flag
    // if-chain, where a `return` would leave the enclosing function instead
    // of yielding the expression's value (see IfChain.value_local).
    let etval: string = "__tm" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let etvarms: ast.TupArm[] = [];
    let etvi: i32 = 0;
    while (etvi < etarms.len()) {
      let etva: ast.TupArm = etarms[etvi];
      etvarms = etvarms.append(ast.TupArm { ...etva, body: value_arm_body(etva.body, etval) });
      etvi = etvi + 1;
    }
    return IfChain { par: p, stmt: build_tuple_match(sr_expr, etvarms, mkline, mkcol), rt: rt, needs_default_return: false, value_local: etval, scrut_bind: [] };
  }
  // A declared struct's `Ident {` at the FIRST arm marks a STRUCT-pattern match
  // (is_struct_pattern_arm; a record-form enum variant is spelled the same way
  // but needs the variant path's tag test): desugar to the field-bind flag
  // chain (build_struct_match).
  if (is_struct_pattern_arm(p) && (p.peek_ident().len() > 0 && p.peek2_punct() == "{" || p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@" && p.peek_ident_at(2).len() > 0 && p.peek_punct_at(3) == "{")) {
    let (smarms, smrt, smok, smp) = parse_struct_match_arms(p, true);
    p = smp;
    if (!smok) {
      return IfChain { par: p, stmt: s_unknown(p, "a struct pattern binds field names"), rt: smrt, needs_default_return: false, value_local: "", scrut_bind: [] };
    }
    // Same value-local routing as the tuple desugar above: build_struct_match
    // splices arm bodies into the same done-flag if-chain shape.
    // `_r`, not `_v`: build_struct_match already uses `<base>_v` for its
    // cached scrutinee, and reusing it made the arm store overwrite the
    // scrutinee instead of the result.
    let smval: string = "__sm" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let smvarms: ast.StructArm[] = [];
    let smvi: i32 = 0;
    while (smvi < smarms.len()) {
      let smva: ast.StructArm = smarms[smvi];
      smvarms = smvarms.append(ast.StructArm { ...smva, body: value_arm_body(smva.body, smval) });
      smvi = smvi + 1;
    }
    return IfChain { par: p, stmt: build_struct_match(sr_expr, smvarms, mkline, mkcol), rt: smrt, needs_default_return: false, value_local: smval, scrut_bind: [] };
  }
  // A literal at the FIRST arm's pattern position marks a match on a
  // non-enum (i32 / string) scrutinee: parse every arm as a literal /
  // `_` and desugar to an if/else-if chain (build_literal_match). The
  // decision is made once, up front, so the common enum/variant match
  // takes the normal StmtMatch path below with no extra allocation.
  if (p.peek_is_pat_literal() || p.peek_at_literal()) {
    let lit_arms: ast.LitArm[] = [];
    let lfirst: boolean = true;
    while (p.peek_punct() != "}" && !p.at_end()) {
      let laline: i32 = p.peek_line();
      let lacol: i32 = p.peek_col();
      let lwild: boolean = false;
      let (lat, lat_p) = take_at_binding(p);
      p = lat_p;
      let lalt_lits: ast.Expr[] = [];
      let lalt_his: ast.Expr[] = [];
      let lalt_hrs: boolean[] = [];
      let lalt_incs: boolean[] = [];
      if (p.peek_is_pat_literal()) {
        let (la_lits, la_his, la_hrs, la_incs, la_p) = parse_lit_alts(p);
        p = la_p;
        lalt_lits = la_lits;
        lalt_his = la_his;
        lalt_hrs = la_hrs;
        lalt_incs = la_incs;
      } else {
        let (lpr_pattern, lpr_p) = parse_pattern(p);
        p = lpr_p;
        lwild = true;
      }
      let lguard: ast.Expr = e_bool(true);
      let lhas_guard: boolean = false;
      if (p.peek_keyword() == "when") {
        p = p.advance();
        let (lgr_expr, lgr_p) = parse_expr(p);
        p = lgr_p;
        lguard = lgr_expr;
        lhas_guard = true;
      }
      if (p.peek_punct() == "=>") {
        p = p.advance();
      }
      // A `{ … }` arm body is a block-with-tail (block-expressions
      // slice 1): leading statements then the trailing value. A bare
      // expression arm body stays the pre-block-expr single-expr form.
      let lbody: ast.Stmt[] = [];
      let lrt: string = "i32";
      if (p.peek_punct() == "{") {
        let (lbb_body, lbb_rt, lbb_p) = parse_branch_body(p);
        p = lbb_p;
        lbody = lbb_body;
        lrt = lbb_rt;
      } else {
        let (ler_expr, ler_p) = parse_expr(p);
        p = ler_p;
        lbody = [s_return(ler_expr)];
        lrt = if_expr_rt(ler_expr);
      }
      if (lfirst) {
        rt = lrt;
        lfirst = false;
      }
      if (lwild) {
        lit_arms = lit_arms.append(ast.LitArm { is_wild: true, lit: e_bool(true), guard: lguard, has_guard: lhas_guard, body: lbody, line: laline, col: lacol, range_hi: e_bool(true), has_range: false, range_inclusive: false, alt_cont: false, at_binding: "" });
      } else {
        // One LitArm per `|` alternative, sharing the guard + body.
        let lai: i32 = 0;
        while (lai < lalt_lits.len()) {
          lit_arms = lit_arms.append(ast.LitArm { is_wild: false, lit: lalt_lits[lai], guard: lguard, has_guard: lhas_guard, body: lbody, line: laline, col: lacol, range_hi: lalt_his[lai], has_range: lalt_hrs[lai], range_inclusive: lalt_incs[lai], alt_cont: lai > 0, at_binding: lat });
          lai = lai + 1;
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
        continue;
      }
      break;
    }
    if (p.peek_punct() == "}") {
      p = p.advance();
    }
    // Anything but a name is read once into a local declared ahead of the
    // match, so the chain itself keeps the single-statement shape. The
    // refused shapes build_literal_match hands back as a StmtMatch never
    // lower, so they keep the scrutinee as written.
    if let ast.ExprIdent(_) = sr_expr {} else {
      let lm: string = literal_scrut_local(mkline, mkcol);
      let lchain: ast.Stmt = build_literal_match(e_ident(lm), lit_arms, mkline, mkcol);
      if let ast.StmtIf(_) = lchain {
        return IfChain { par: p, stmt: with_written_scrut(lchain, sr_expr), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [s_var_at(lm, "", sr_expr, mkline, mkcol)] };
      }
    }
    return IfChain { par: p, stmt: build_literal_match(sr_expr, lit_arms, mkline, mkcol), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
  }
  let arms: ast.MatchArm[] = [];
  let ewritten: ast.MatchArm[] = [];
  let first: boolean = true;
  while (p.peek_punct() != "}" && !p.at_end()) {
    let aline: i32 = p.peek_line();
    let acol: i32 = p.peek_col();
    let (pr_pattern, pr_p) = parse_pattern(p);
    p = pr_p;
    // Or-patterns: `A | B | … => expr` — one MatchArm per alternative,
    // sharing the guard + body. Variant patterns only (see the stmt-form
    // note); a literal-first match takes the build_literal_match path.
    let pats: ast.Pattern[] = [pr_pattern];
    while (p.peek_punct() == "|") {
      p = p.advance();
      let (pr2_pattern, pr2_p) = parse_pattern(p);
      p = pr2_p;
      pats = pats.append(pr2_pattern);
    }
    let arm_guard: ast.Expr = e_bool(true);
    let arm_has_guard: boolean = false;
    if (p.peek_keyword() == "when") {
      p = p.advance();
      let (gr_expr, gr_p) = parse_expr(p);
      p = gr_p;
      arm_guard = gr_expr;
      arm_has_guard = true;
    }
    if (p.peek_punct() == "=>") {
      p = p.advance();
    }
    // A `{ … }` arm body is a block-with-tail (block-expressions slice
    // 1): leading statements then the trailing value. A bare expression
    // arm body stays the pre-block-expr single-expr form.
    let abody: ast.Stmt[] = [];
    let art: string = "i32";
    if (p.peek_punct() == "{") {
      let (abb_body, abb_rt, abb_p) = parse_branch_body(p);
      p = abb_p;
      abody = abb_body;
      art = abb_rt;
    } else {
      let (er_expr, er_p) = parse_expr(p);
      p = er_p;
      abody = [s_return(er_expr)];
      art = if_expr_rt(er_expr);
    }
    // Combine every arm's tag, not just the first one's. The arms yield ONE
    // value, so one tag has to describe all of them, and a 64-bit arm is the
    // one that cannot be narrowed — see wider_rt, which #6246 introduced for
    // exactly this on the if-expression side. First-arm-wins lost the width
    // whenever the leading arm was the one with nothing to go on:
    // `match (x %? y) { Some(v) => v, None => 111i64 }` read `v` as i32,
    // labelled the IIFE i32, and the i64 `return` then bailed the module.
    if (first) {
      rt = art;
      first = false;
    } else {
      rt = wider_rt(rt, art);
    }
    let pi: i32 = 0;
    while (pi < pats.len()) {
      ewritten = ewritten.append(ast.MatchArm { pattern: pats[pi], body: abody, line: aline, col: acol, guard: arm_guard, has_guard: arm_has_guard, alt_cont: pi > 0 });
      let (fa_pat, fa_g, fa_hg) = fold_lit_cond(pats[pi], arm_guard, arm_has_guard);
      arms = arms.append(ast.MatchArm { pattern: fa_pat, body: abody, line: aline, col: acol, guard: fa_g, has_guard: fa_hg, alt_cont: false });
      pi = pi + 1;
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  let esugar: ast.MatchArm[] = [];
  if (arms_have_written_form(ewritten)) {
    esugar = ewritten;
  }
  // A TUPLE sub-pattern (`Pr((a, b))`) makes build_merged_arm splice the arm
  // bodies into build_tuple_match's done-flag chain, where an arm's `return`
  // leaves the enclosing function instead of yielding the expression's value.
  // That is the same shape the tuple- and struct-SCRUTINEE desugars above hit,
  // so it takes the same fix: route the arm values through a value local
  // (see IfChain.value_local). A variant sub-pattern needs none of this — its
  // inner match is a StmtMatch, whose arm returns lower_iife_match rewrites.
  if (arms_have_tuple_subpattern(arms)) {
    let ntval: string = "__nt" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let ntarms: ast.MatchArm[] = [];
    let nti: i32 = 0;
    while (nti < arms.len()) {
      let nta: ast.MatchArm = arms[nti];
      ntarms = ntarms.append(ast.MatchArm { ...nta, body: value_arm_body(nta.body, ntval) });
      nti = nti + 1;
    }
    return IfChain { par: p, stmt: s_match_sugared(sr_expr, desugar_nested_arms(ntarms, 0, ""), esugar, mkline, mkcol), rt: rt, needs_default_return: false, value_local: ntval, scrut_bind: [] };
  }
  // Arms with payload sub-patterns take the flag chain here too. The chain
  // is statements, not a match whose arms `return`, so the arm values route
  // through a value local exactly as the tuple-sub-pattern branch above does.
  if (arms_take_flag_chain(arms)) {
    let naval: string = "__na" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let naarms: ast.MatchArm[] = [];
    let nai: i32 = 0;
    while (nai < arms.len()) {
      let naa: ast.MatchArm = arms[nai];
      naarms = naarms.append(ast.MatchArm { ...naa, body: value_arm_body(naa.body, naval) });
      nai = nai + 1;
    }
    return IfChain { par: p, stmt: build_nested_arm_match(sr_expr, naarms, ewritten, mkline, mkcol), rt: rt, needs_default_return: false, value_local: naval, scrut_bind: [] };
  }
  arms = desugar_nested_arms(arms, 0, "");
  return IfChain { par: p, stmt: s_match_sugared(sr_expr, arms, esugar, mkline, mkcol), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
}

// arms_have_tuple_subpattern reports whether any arm holds a tuple sub-pattern
// in its payload slot — the arms that build_merged_arm routes through
// build_tuple_match rather than through a variant inner match.
function arms_have_tuple_subpattern(arms: ast.MatchArm[]): boolean {
  let i: i32 = 0;
  while (i < arms.len()) {
    match (arms[i].pattern) {
      ast.PatVariant(pv) => {
        if (pv.tup_kinds.len() > 0) {
          return true;
        }
      },
      ast.PatWildcard(w) => {}
    }
    i = i + 1;
  }
  return false;
}

// pipe_prepend builds [head] ++ tail — the argument list for a piped
// call where `head` (the piped value) becomes the first argument.
function pipe_prepend(head: ast.Expr, tail: ast.Expr[]): ast.Expr[] {
  let out: ast.Expr[] = [head];
  let i: i32 = 0;
  while (i < tail.len()) {
    out = out.append(tail[i]);
    i = i + 1;
  }
  return out;
}

// pipe_is_hole reports an argument that is the `_` topic placeholder, bare or
// as a named argument's value (`b = _`).
function pipe_is_hole(e: ast.Expr): boolean {
  match (fda_marker_value(e)) {
    ast.ExprIdent(id) => {
      return id.name == "_";
    },
    _ => {
      return false;
    }
  }
  return false;
}

// pipe_fill puts the piped value where the hole argument `e` held `_`,
// keeping a named argument's name.
function pipe_fill(e: ast.Expr, left: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      if (b.op == "__named_arg") {
        return ast.ExprBinary { ...b, right: left };
      }
    },
    _ => {}
  }
  return left;
}

// pipe_desugar lowers `left |> right`. `x |> f(a, b)` prepends x to the
// call's args → `f(x, a, b)`; `x |> f(a, _)` or `x |> f(b = _)` substitutes
// x at the `_` topic placeholder instead → `f(a, x)` (at most one `_`,
// direct args only — the native parser rejects two with P004, so a
// native-valid program has at most one; this mirror substitutes at the first);
// `x |> f` (a bare callee) wraps it as a single-arg call → `f(x)`.
// Mirrors the Go parser's parsePipe, lowering to the same ExprCall the
// rest of the pipeline already handles.
function pipe_desugar(left: ast.Expr, right: ast.Expr): ast.Expr {
  match (right) {
    ast.ExprCall(c) => {
      let hole: i32 = 0 - 1;
      let hi: i32 = 0;
      while (hi < c.args.len()) {
        if (hole < 0 && pipe_is_hole(c.args[hi])) {
          hole = hi;
        }
        hi = hi + 1;
      }
      if (hole >= 0) {
        let subst: ast.Expr[] = [];
        let si: i32 = 0;
        while (si < c.args.len()) {
          if (si == hole) {
            subst = subst.append(pipe_fill(c.args[si], left));
          } else {
            subst = subst.append(c.args[si]);
          }
          si = si + 1;
        }
        return e_call(c.callee, subst);
      }
      return e_call(c.callee, pipe_prepend(left, c.args));
    },
    _ => {
      let one: ast.Expr[] = [left];
      return e_call(right, one);
    }
  }
}

// parse_pipe sits just above parse_binary (looser than every binary
// operator, left-associative): the operands of `|>` are full binary
// expressions and the pipe itself only binds at the expression top
// level, matching the Go grammar (parseExpr -> parsePipe -> parseLogicOr).
// parse_range handles the range EXPRESSION `a..b` / `a..=b`, desugaring it to a
// first-class iterator value: `iter.range(a, b)` / `iter.range_incl(a, b)` —
// core/iter's `Range`, which implements `Iterator`, so `iter.sum(0..n)` and
// `(0..10)` passed to any combinator flow through the iterator protocol
// (requires `import "core/iter"`; flatten_qualified rewrites `iter.range` ->
// `iter__range`). It sits just below the pipe operator and reads its operands
// with parse_binary so `0..n+1` is `0..(n+1)`. The `for i in LOW..HIGH` loop
// keeps its own counted-loop desugar — parse_for_stmt reads its bounds with
// parse_binary (below this level), so a range there stays the optimized form.
function parse_range(p: Par): (ast.Expr, Par) {
  let (left_expr, left_p) = parse_binary(p, 1);
  p = left_p;
  let pk: string = p.peek_punct();
  if (pk == ".." || pk == "..=") {
    let rline: i32 = p.peek_line();
    let rcol: i32 = p.peek_col();
    p = p.advance();
    let fn: string = "range";
    if (pk == "..=") {
      fn = "range_incl";
    }
    let (right_expr, right_p) = parse_binary(p, 1);
    p = right_p;
    // The desugared names point at the operator, so a missing core/iter is
    // reported where the range is written.
    let callee: ast.Expr = e_field_access_at(e_ident_at("iter", rline, rcol), fn, rline, rcol);
    let args: ast.Expr[] = [left_expr, right_expr];
    return (e_call(callee, args), p);
  }
  return (left_expr, p);
}

function parse_pipe(p: Par): (ast.Expr, Par) {
  let (left_expr, left_p) = parse_range(p);
  p = left_p;
  let acc: ast.Expr = left_expr;
  while (p.peek_punct() == "|>") {
    p = p.advance();
    let (right_expr, right_p) = parse_range(p);
    p = right_p;
    // `-fmt` keeps the written pipe. The desugar folds the LHS into the
    // call's argument list (or into its `_` hole), which is unrecoverable
    // afterwards — a reformat rewrote `x |> f` as `f(x)`. Held as an
    // ExprBinary rather than a new node: the RHS as written is exactly what
    // the printer has to emit after the arrow.
    if (p.verbatim) {
      acc = e_binary("|>", acc, right_expr);
      continue;
    }
    acc = pipe_desugar(acc, right_expr);
  }
  return (acc, p);
}

// parse_stmt: `let x = expr;`, `return expr;`, or `expr;`.
// parse_block consumes `{ stmt; stmt; … }` and returns the
// resulting Stmt[]. The opening `{` is expected to be the current
// token. On malformed input — missing `{` or `}` — the result is
// a single StmtUnknown so the outer caller can still surface a
// reasonable error site.

function parse_block(p: Par): (ast.Stmt[], Par) {
  if (p.peek_punct() != "{") {
    let miss: ast.Stmt[] = [s_unknown(p, "missing { in block")];
    return (miss, p);
  }
  p = p.advance();
  let (r_body, r_p) = parse_block_body(p, false);
  p = r_p;
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (r_body, p);
}

// parse_block_body parses statements up to (but not consuming) the block's
// closing `}`. Split from parse_block so the callback-passing `use` bind can
// recurse on the rest of the block.
// parse_block_body is the depth-guarded face of parse_block_body_nested: see MAX_NEST_DEPTH.
//
// tail_value says whether the block may end in a VALUE — an expression written
// without a `;`, which becomes a `return` of it. Only a lambda's braced body
// can: it is the one block whose result is the enclosing construct's value. A
// lambda body is parsed here rather than by parse_block_items because `use`
// rewrites the REST of the block it appears in, and this is the only parser
// that has that remainder to give it (#8593).
function parse_block_body(p: Par, tail_value: boolean): (ast.Stmt[], Par) {
  if (p.too_deep_by(BLOCK_NEST_UNITS)) {
    return ([s_unknown_at("nest:too-deep", p.peek_line(), p.peek_col())], p.bail());
  }
  let (g0, gq) = parse_block_body_nested(p.with_depth(p.depth + BLOCK_NEST_UNITS), tail_value);
  return (g0, gq.with_depth(p.depth));
}

// parse_lambda_body parses a lambda's braced body: a function body, with the
// statements and the `use` rest-of-block desugar an ordinary body has, plus an
// optional trailing value. The cursor is on `{`.
function parse_lambda_body(p: Par): (ast.Stmt[], Par) {
  if (p.peek_punct() != "{") {
    return ([s_unknown(p, "missing { in lambda body")], p);
  }
  p = p.advance();
  let (lb_body, lb_p) = parse_block_body(p, true);
  p = lb_p;
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (lb_body, p);
}

function parse_block_body_nested(p: Par, tail_value: boolean): (ast.Stmt[], Par) {
  let body: ast.Stmt[] = [];
  while (p.peek_punct() != "}" && !p.at_end()) {
    // `use NAME [: TYPE] <- CALL;` — monadic-bind / callback-passing sugar
    // (native parseUse). The rest of the enclosing block becomes the body
    // of a callback lambda appended as CALL's last argument, and the block
    // returns CALL's result. `use n <- apply(41); <rest>` desugars to
    // `return apply(41, (n) => { <rest> });`. A nested `use` in <rest>
    // recurses. Without this the line mis-parsed (#4335).
    if (p.peek_keyword() == "use") {
      let uline: i32 = p.peek_line();
      let ucol: i32 = p.peek_col();
      p = p.advance();  // consume `use`
      let uname: string = p.peek_ident();
      if (uname.len() > 0) {
        p = p.advance();
      }
      let utype: string = "";
      if (p.peek_punct() == ":") {
        p = p.advance();
        let (utn_name, utn_fn_ret, utn_p) = parse_type_name(p);
        p = utn_p;
        utype = utn_name;
      }
      // `<-` lexes as `<` then `-`.
      if (p.peek_punct() == "<") {
        p = p.advance();
      }
      if (p.peek_punct() == "-") {
        p = p.advance();
      }
      let (usrc_expr, usrc_p) = parse_expr(p);
      p = usrc_p;
      if (p.peek_punct() == ";") {
        p = p.advance();
      }
      // The rest of the block is the callback body (recurse so a further
      // `use` chains).
      let (rest_body, rest_p) = parse_block_body(p, false);
      p = rest_p;
      let cbparam: ast.ParamDecl = ast.ParamDecl { name: uname, type_name: utype, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" };
      let cbparams: ast.ParamDecl[] = [cbparam];
      // use_infer marks the synthesised callback when the user wrote
      // no `: TYPE` — the checker's E032 rule verifies the binding
      // type is inferrable from the callee's signature (native
      // inferUseParam). An annotated `use n: T <- …` never draws E032.
      let cb: ast.Expr = ast.ExprLambda { params: cbparams, ret_type: "", body: rest_body, use_infer: utype.len() == 0, origin: ORIGIN_USE, line: 0, col: 0, captures: [], captures_known: false, ret_fn_ret: "", ret_fn_param_types: "" };
      match (usrc_expr) {
        ast.ExprCall(c) => {
          let newargs: ast.Expr[] = c.args.append(cb);
          // The return stands for the `use` line, so it carries the
          // keyword's position for comment and blank-line placement.
          body = body.append(s_return_at(e_call(c.callee, newargs), uline, ucol));
        },
        _ => {
          body = body.append(s_unknown(p, "use source must be a function call"));
        }
      }
      return (body, p);
    }
    if (tail_value && !branch_stmt_start(p)) {
      // A non-keyword item that the closing `}` follows is the body's
      // trailing value. Anything else — including the same expression
      // followed by a `;` — is an ordinary statement, so the cursor is
      // put back and the statement parser reads it.
      let (tv_expr, tv_p) = parse_expr(p);
      if (tv_p.peek_punct() == "}") {
        body = body.append(s_return(tv_expr));
        return (body, tv_p);
      }
    }
    let (r_stmt, r_p) = parse_stmt(p);
    // Guarantee progress: a malformed statement that doesn't consume a
    // token would otherwise spin forever — skip it instead.
    if (r_p.pos == p.pos) {
      p = p.advance();
      continue;
    }
    p = r_p;
    body = body.append(r_stmt);
  }
  return (body, p);
}

// parse_block_or_stmt accepts EITHER a braced `{ … }` block OR a single
// braceless statement, wrapping the latter in a one-element body. Native
// control-flow bodies (if-then/else, while, loop, `for x in it`) are a
// `parseStmt`, so `if (x == 0) x = 40;` is valid there; the self-host used
// to require `{` and mis-parsed a braceless body into an
// `/*unknown-stmt: missing { in block*/` with the real statement hoisted to
// run unconditionally (#4337). Only the control-flow body sites route here,
// `if let` among them; function / match-arm / lambda blocks still require
// braces.
function parse_block_or_stmt(p: Par): (ast.Stmt[], Par) {
  if (p.peek_punct() == "{") {
    return parse_block(p);
  }
  let (r_stmt, r_p) = parse_stmt(p);
  // Guarantee progress on a malformed body token rather than spinning.
  if (r_p.pos == p.pos) {
    let none: ast.Stmt[] = [s_unknown(p, "missing statement in braceless body")];
    return (none, p.advance());
  }
  let one: ast.Stmt[] = [r_stmt];
  return (one, r_p);
}

// parse_pattern reads a single match-arm pattern. Forms accepted:
//   _                  — PatWildcard
//   Name               — PatVariant { type_name: Name, binding: "" }
//   Name(_)            — PatVariant { type_name: Name, binding: "_" }
//   Name(ident)        — PatVariant { type_name: Name, binding: ident }
// The lexer treats `_` as an identifier (underscore is a valid
// alpha byte) so wildcards arrive here via peek_ident.

// parse_pattern is the depth-guarded face of parse_pattern_nested: see MAX_NEST_DEPTH.
function parse_pattern(p: Par): (ast.Pattern, Par) {
  if (p.too_deep()) {
    return (p_wildcard(), p.bail());
  }
  let (g0, gq) = parse_pattern_nested(p.with_depth(p.depth + 1));
  return (g0, gq.with_depth(p.depth));
}

function parse_pattern_nested(p: Par): (ast.Pattern, Par) {
  // Accumulates the condition implied by any literal payload slots; see
  // PatVariant.lit_cond.
  let lit_cond: ast.Expr = e_bool(true);
  let has_lit_cond: boolean = false;
  let tup_kinds: i32[] = [];
  let tup_binds: string[] = [];
  let tup_lits: ast.Expr[] = [];
  let tup_pats: ast.Pattern[] = [];
  let name: string = p.peek_ident();
  // `n @ Variant(...)` — bind the whole matched value to `n` while also
  // matching the variant. Consume the `IDENT @` prefix; the variant name
  // follows. Only meaningful before a variant pattern.
  let at_binding: string = "";
  if (name.len() > 0 && name != "_" && p.peek2_punct() == "@") {
    at_binding = name;
    p = p.advance();  // binder name
    p = p.advance();  // `@`
    name = p.peek_ident();
  }
  // `true` / `false` arms (and other keyword-named patterns) arrive as
  // keyword tokens, not idents — fall back to the keyword text.
  if (name.len() == 0) {
    name = p.peek_keyword();
  }
  if (name == "_") {
    p = p.advance();
    return (p_wildcard(), p);
  }
  // A literal-pattern arm (`1 => …`, `"yes" => …`) only reaches
  // parse_pattern when an EARLIER arm wasn't a literal (so the whole
  // match took the variant path) — e.g. a wildcard-first match
  // `_ => …, 1 => …`, which is itself an E026 error. The literal token
  // is not an ident/keyword, so without consuming it here the cursor
  // would stick on it: the arm's `=>` and body would fail to parse,
  // corrupting the return-path (E052) analysis. Consume it and yield a
  // bare PatVariant("") — the empty type-name is skipped by the E028 /
  // E015 variant checks, leaving only the E026 the misplaced wildcard
  // already earns.
  if (p.peek_is_pat_literal()) {
    p = p.advance();
    return (p_variant("", ""), p);
  }
  if (name.len() == 0) {
    return (p_variant("", ""), p);
  }
  p = p.advance();
  // Qualified variant pattern: `pkg.Variant` (e.g.
  // `lexer.TokNumber(n)`). Consume the `.ident` suffix chain so
  // cross-module variant patterns parse. Without this the `.` is
  // left on the cursor and parse_match_stmt's arm loop can't
  // advance — it spins, allocating until OOM. parser.fern's own
  // matches use `lexer.TokX(...)` throughout, so this is required
  // for the self-host parser to parse its own source. Same gap as
  // parse_type_name's qualified-name handling.
  while (p.at_path_sep()) {
    p = p.advance();  // consume `.`
    let seg: string = p.peek_ident();
    if (seg.len() == 0) {
      seg = p.peek_keyword();
    }
    if (seg.len() == 0) {
      break;
    }
    name = name + "." + seg;
    p = p.advance();
  }
  let binding: string = "";
  let extra_bindings: string[] = [];
  let nested: ast.Pattern[] = [];
  let field_names: string[] = [];
  if (p.peek_punct() == "{") {
    // Record-form pattern `Rect { h, w }`: each entry names a FIELD, bound to
    // a local of the same name, and the order is free. The names are recorded
    // as written and both bindings and order are settled later, against the
    // variant's declaration, by resolve_variant_fields_module.
    //
    // field_names holds the FIELDS and the bindings the LOCALS they were bound
    // to — the same pair native carries. They differ only under the `f: local`
    // renaming form, which parses here (native accepts it syntactically too)
    // and is rejected by the checker.
    p = p.advance();
    while (p.peek_punct() != "}" && !p.at_end()) {
      let fnm: string = p.peek_ident();
      if (fnm.len() == 0) {
        p = p.advance();
        continue;
      }
      p = p.advance();
      let local: string = fnm;
      if (p.peek_punct() == ":") {
        p = p.advance();
        let ren: string = p.peek_ident();
        if (ren.len() > 0) {
          local = ren;
          p = p.advance();
        }
      }
      field_names = field_names.append(fnm);
      if (field_names.len() == 1) {
        binding = local;
      } else {
        extra_bindings = extra_bindings.append(local);
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
      }
    }
    if (p.peek_punct() == "}") {
      p = p.advance();
    }
  } else if (p.peek_punct() == "(") {
    p = p.advance();
    // Parse comma-separated payload bindings: `Variant(a, b, …)`. The
    // first is `binding`; the rest go to `extra_bindings` so the checker
    // can flag a payload-arity mismatch (E015). Single-payload variants
    // (all the self-host supports) use only `binding`.
    //
    // A single-payload slot that itself begins a variant pattern
    // (`Some(Ok(n))` — an ident followed by `(` / `{` / `.`) is a NESTED
    // sub-pattern: recurse and record it in `nested`; desugar_nested_arms
    // later rewrites the arm to a flat outer arm + inner match. A bare
    // ident stays a plain binder, so `Some(x)` is unchanged.
    let bn: i32 = 0;
    while (p.peek_punct() != ")" && !p.at_end()) {
      if (p.peek_ident().len() > 0
        && (p.peek2_punct() == "(" || p.peek2_punct() == "{" || p.peek2_punct() == "." || p.peek2_punct() == "::")) {
        // The slot binds a synthetic temp and `nested` records the
        // pattern the temp is matched against — the same shape the
        // literal slot below uses, so a sub-pattern works at ANY
        // position rather than only the first (#7524). `nested` runs
        // parallel to the payload list, padded with wildcards at the
        // slots that are plain binders.
        let sub_line: i32 = p.peek_line();
        let sub_col: i32 = p.peek_col();
        let (sub_pat, sub_p) = parse_pattern(p);
        p = sub_p;
        let nslot: string = "__np" + dl_itoa(sub_line) + "_" + dl_itoa(sub_col) + "_" + dl_itoa(bn);
        if (bn == 0) {
          binding = nslot;
        } else {
          extra_bindings = extra_bindings.append(nslot);
        }
        while (nested.len() < bn) {
          nested = nested.append(p_wildcard());
        }
        nested = nested.append(sub_pat);
        bn = bn + 1;
      } else if (bn == 0 && p.peek_punct() == "(") {
        // A TUPLE sub-pattern in the slot (`Pr((a, b))`). Pattern has
        // no tuple case, so the elements are stored on PatVariant and
        // build_merged_arm turns them into a tuple inner match.
        let (tk, tb, tl, tpp, tp) = parse_tuple_arm_pattern(p);
        p = tp;
        tup_kinds = tk;
        tup_binds = tb;
        tup_lits = tl;
        tup_pats = tpp;
        binding = "__tupslot";
        bn = bn + 1;
      } else if (p.peek_is_pat_literal()) {
        // A literal payload slot (`Sm(0)`) tests the payload rather
        // than binding it. Bind the slot to a synthetic name and
        // record `name == literal`; the arm builder folds that into
        // the arm's guard, so every backend sees an ordinary guarded
        // arm. Dropping the token here — which is what used to
        // happen — left a bare `Sm` arm that matched every payload.
        let lit_line: i32 = p.peek_line();
        let lit_col: i32 = p.peek_col();
        let (lit_expr, lit_p) = parse_binary(p, 4);
        p = lit_p;
        let slot: string = "__pl" + dl_itoa(lit_line) + "_" + dl_itoa(lit_col);
        if (bn == 0) {
          binding = slot;
        } else {
          extra_bindings = extra_bindings.append(slot);
        }
        // A RANGE payload (`V(1..5)` / `V(1..=5)`) tests the bound
        // pair rather than equality. Native has always accepted one
        // here; the self-host stopped at the low bound and took the
        // high one for a second payload slot, so `V(1..5)` drew
        // "variant V has 1 payload(s), got 2 binding(s)".
        let one: ast.Expr = e_binary("==", e_ident(slot), lit_expr);
        let rng: string = p.peek_punct();
        if (rng == ".." || rng == "..=") {
          p = p.advance();
          let (hi_expr, hi_p) = parse_binary(p, 4);
          p = hi_p;
          let hi_op: string = "<";
          if (rng == "..=") {
            hi_op = "<=";
          }
          one = e_binary("&&", e_binary(">=", e_ident(slot), lit_expr), e_binary(hi_op, e_ident(slot), hi_expr));
        }
        if (has_lit_cond) {
          lit_cond = e_binary("&&", lit_cond, one);
        } else {
          lit_cond = one;
        }
        has_lit_cond = true;
        bn = bn + 1;
      } else {
        let inner: string = p.peek_ident();
        if (inner.len() > 0) {
          if (bn == 0) {
            binding = inner;
          } else {
            extra_bindings = extra_bindings.append(inner);
          }
          bn = bn + 1;
          p = p.advance();
        } else {
          p = p.advance();
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
      }
    }
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
    // Keep `nested` exactly as long as the payload list when any slot
    // carries a pattern, so index i always addresses slot i.
    if (nested.len() > 0) {
      while (nested.len() < bn) {
        nested = nested.append(p_wildcard());
      }
    }
  }
  return (ast.PatVariant { type_name: name, binding: binding, extra_bindings: extra_bindings, nested: nested, at_binding: at_binding, field_names: field_names, lit_cond: lit_cond, has_lit_cond: has_lit_cond, tup_kinds: tup_kinds, tup_binds: tup_binds, tup_lits: tup_lits, tup_pats: tup_pats }, p);
}

// prepend_stmt returns a fresh statement list with `s` in front of `body`.
// Isolating the concat in a helper (rather than an inline `let xs: Stmt[] =
// []` + appends of field-derived elements) keeps the element type canonical
// through the parameter, so the imported-module type mangling stays
// consistent.
function prepend_stmt(s: ast.Stmt, body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  out = out.append(s);
  let i: i32 = 0;
  while (i < body.len()) {
    out = out.append(body[i]);
    i = i + 1;
  }
  return out;
}

// pv_tup returns a pattern's tuple sub-pattern encoding, empty for a wildcard.
pub function pv_tup(pat: ast.Pattern): (i32[], string[], ast.Expr[], ast.Pattern[]) {
  let no_k: i32[] = [];
  let no_b: string[] = [];
  let no_l: ast.Expr[] = [];
  let no_p: ast.Pattern[] = [];
  match (pat) {
    ast.PatVariant(v) => {
      return (v.tup_kinds, v.tup_binds, v.tup_lits, v.tup_pats);
    },
    ast.PatWildcard(w) => {
      return (no_k, no_b, no_l, no_p);
    }
  }
  return (no_k, no_b, no_l, no_p);
}

// pv_name returns a pattern's variant type-name, or "" for a wildcard.
function pv_name(pat: ast.Pattern): string {
  match (pat) {
    ast.PatVariant(v) => {
      return v.type_name;
    },
    ast.PatWildcard(w) => {
      return "";
    }
  }
  return "";
}

// arm_is_nested reports whether an arm's pattern carries a nested sub-pattern.
function arm_is_nested(arm: ast.MatchArm): boolean {
  match (arm.pattern) {
    ast.PatVariant(v) => {
      return v.nested.len() > 0 || v.tup_kinds.len() > 0;
    },
    ast.PatWildcard(w) => {
      return false;
    }
  }
  return false;
}

// ---- Nested arm-position patterns (`match (v) { P(Ok2(a), Ok2(b)) => … }`) ----
//
// An arm carrying payload SUB-PATTERNS lowers to a done-flag chain — one
// guarded `if` per SOURCE arm, in source order:
//
//   if (true) {
//     let __naL_C_s = <scrutinee>;
//     let __naL_C_d = false;
//     if (!__naL_C_d) {                       // one per arm
//       match (__naL_C_s) {
//         P(t0, t1) => { match (t0) { Ok2(a) => { match (t1) { Ok2(b) => {
//                          __naL_C_d = true; <body>
//                      }, _ => {} } }, _ => {} } },
//         _ => {}
//       }
//     }
//     …
//   }
//
// The flag is what gives fall-to-next-arm, and it is why this shape can
// express what the merge could not. `done` is set INSIDE the innermost
// sub-pattern match, so a sub-pattern that fails simply leaves it false and
// the next arm's `if` runs. The merge collapsed a run of same-variant arms
// into one arm plus an inner match whose wildcard was the outer `_`, so "the
// next arm of the outer match" did not survive it (#7524).
//
// Same shape build_tuple_match already uses for a tuple scrutinee, for the
// same reason — which is why this stays inside the parser: the chain is
// ordinary Fern statements, so the checker, the lowering and interp need no
// notion of arm-position nesting at all.
// arms_take_flag_chain reports whether this arm list wants the done-flag
// chain: some arm carries a payload sub-pattern, and none carries a TUPLE
// sub-pattern. A tuple slot uses build_merged_arm's own tuple branch, which
// wrap_payload_pats does not reproduce, so those keep the merge — they are
// single-slot by construction and the merge expresses them correctly.
function arms_take_flag_chain(arms: ast.MatchArm[]): boolean {
  let any_nested: boolean = false;
  let i: i32 = 0;
  while (i < arms.len()) {
    match (arms[i].pattern) {
      ast.PatVariant(v) => {
        if (v.tup_kinds.len() > 0) {
          return false;
        }
        if (v.nested.len() > 0) {
          any_nested = true;
        }
      },
      ast.PatWildcard(w) => {}
    }
    i = i + 1;
  }
  return any_nested;
}

function clear_nested_pat(pv: ast.PatVariant): ast.Pattern {
  let none: ast.Pattern[] = [];
  return ast.PatVariant { ...pv, nested: none };
}

// payload_binder is the name a variant pattern binds at payload slot i —
// `binding` for slot 0, `extra_bindings` after it. A slot carrying a
// sub-pattern binds the synthetic temp parse_pattern minted for it.
function payload_binder(pv: ast.PatVariant, i: i32): string {
  if (i == 0) {
    return pv.binding;
  }
  if (i - 1 < pv.extra_bindings.len()) {
    return pv.extra_bindings[i - 1];
  }
  return "";
}

// wrap_payload_pats wraps an arm's matched path in one
// `match (slot) { <sub-pattern> => …, _ => {} }` per payload slot that
// carries one, innermost last — the shape wrap_tuple_elems builds for a
// variant tuple element.
//
// A sub-pattern that nests further routes back through desugar_nested_arms,
// which is correct at depth: the inner match has exactly one real arm plus
// the `_`, so there is no sibling for the merge to collapse and nothing to
// fall to but this level's skip.
function wrap_payload_pats(path: ast.Stmt[], pv: ast.PatVariant, line: i32, col: i32): ast.Stmt[] {
  let cur: ast.Stmt[] = path;
  let wi: i32 = pv.nested.len() - 1;
  while (wi >= 0) {
    if (pv_name(pv.nested[wi]) != "") {
      let slot: string = payload_binder(pv, wi);
      let (mk_pat, mk_guard, mk_hg) = fold_lit_cond(pv.nested[wi], e_bool(true), false);
      let mk_arms: ast.MatchArm[] = [];
      mk_arms = mk_arms.append(ast.MatchArm { pattern: mk_pat, body: cur, line: line, col: col, guard: mk_guard, has_guard: mk_hg, alt_cont: false });
      let mk_skip: ast.Stmt[] = [];
      mk_arms = mk_arms.append(ast.MatchArm { pattern: p_wildcard(), body: mk_skip, line: line, col: col, guard: e_bool(true), has_guard: false, alt_cont: false });
      let mk_wrap: ast.Stmt[] = [];
      mk_wrap = mk_wrap.append(s_match_at(e_ident_at(slot, line, col), desugar_nested_arms(mk_arms, 0, slot), line, col));
      cur = mk_wrap;
    }
    wi = wi - 1;
  }
  return cur;
}

// `written` is the arms as SPELLED — before fold_lit_cond moved a literal
// payload into the guard and before or-alternatives were split — and is what
// the printer reprints. Empty falls back to the lowered arms.
function build_nested_arm_match(scrut: ast.Expr, arms: ast.MatchArm[], written: ast.MatchArm[], mkline: i32, mkcol: i32): ast.Stmt {
  let base: string = "__na" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
  let sname: string = base + "_s";
  let done: string = base + "_d";
  let outer: ast.Stmt[] = [];
  outer = outer.append(s_var_at(sname, "", scrut, mkline, mkcol));
  outer = outer.append(s_var(done, "", e_bool(false)));
  let ai: i32 = 0;
  while (ai < arms.len()) {
    let a: ast.MatchArm = arms[ai];
    let cond: ast.Expr = e_unary("!", e_ident(done));
    // The flag is set beside the body, so it runs only where the body
    // does — inside every sub-pattern match and inside the guard.
    let flagged: ast.Stmt[] = [];
    flagged = flagged.append(s_assign(done, e_bool(true)));
    let bi: i32 = 0;
    while (bi < a.body.len()) {
      flagged = flagged.append(a.body[bi]);
      bi = bi + 1;
    }
    let inner: ast.Stmt[] = [];
    match (a.pattern) {
      ast.PatWildcard(w) => {
        // A `_` arm has nothing to test; a guard folds into the
        // condition, after the flag, so a guard-false falls through.
        if (a.has_guard) {
          cond = e_binary("&&", cond, a.guard);
        }
        inner = flagged;
      },
      ast.PatVariant(pv) => {
        let path: ast.Stmt[] = flagged;
        // The guard sits INSIDE the wraps so it sees every binding
        // the sub-patterns introduced.
        if (a.has_guard) {
          path = [s_if(a.guard, flagged, [])];
        }
        path = wrap_payload_pats(path, pv, a.line, a.col);
        let (fp, fg, fhg) = fold_lit_cond(clear_nested_pat(pv), e_bool(true), false);
        let marms: ast.MatchArm[] = [];
        marms = marms.append(ast.MatchArm { pattern: fp, body: path, line: a.line, col: a.col, guard: fg, has_guard: fhg, alt_cont: false });
        let skip: ast.Stmt[] = [];
        marms = marms.append(ast.MatchArm { pattern: p_wildcard(), body: skip, line: a.line, col: a.col, guard: e_bool(true), has_guard: false, alt_cont: false });
        inner = [s_match_at(e_ident_at(sname, a.line, a.col), marms, a.line, a.col)];
      }
    }
    outer = outer.append(s_if(cond, inner, []));
    ai = ai + 1;
  }
  let sugar_arms: ast.MatchArm[] = arms;
  if (written.len() > 0) {
    sugar_arms = written;
  }
  return s_if_match(outer, ast.MatchSugar { ...no_match_sugar(), scrut: scrut, arms: sugar_arms, line: mkline, col: mkcol });
}

// desugar_nested_arms rewrites arms carrying nested sub-patterns
// (`Some(Ok(n))`) into flat arms whose body re-matches the payload on an
// inner match, grouping contiguous same-variant arms into one merged arm
// `V(__nest…) => match __nest… { … }`. A no-op returning the arms unchanged
// when no arm nests — so every existing match (the whole self-host source
// among them) parses byte-identically. `depth` keeps the synthesised payload
// temp unique across nesting levels, and `tag` across callers that synthesise
// arms sharing one line/col — pass "" when the arms come from distinct source
// positions. Recurses so `Some(Ok(Some(x)))` desugars at every depth.
function desugar_nested_arms(arms: ast.MatchArm[], depth: i32, tag: string): ast.MatchArm[] {
  // Any-nested short-circuit: leaves the common (flat) case allocation-free
  // and, more importantly, byte-identical to the pre-feature output.
  let seen_nested: boolean = false;
  let s: i32 = 0;
  while (s < arms.len()) {
    if (arm_is_nested(arms[s])) {
      seen_nested = true;
    }
    s = s + 1;
  }
  if (!seen_nested) {
    return arms;
  }
  // An unguarded trailing `_` is the outer fallthrough: copied into each
  // merged inner match so a payload matching no inner pattern runs it.
  let fall: ast.Stmt[] = [];
  let has_fall: boolean = false;
  if (arms.len() > 0) {
    let last: ast.MatchArm = arms[arms.len() - 1];
    if (pv_name(last.pattern) == "" && !last.has_guard) {
      fall = last.body;
      has_fall = true;
    }
  }
  let out: ast.MatchArm[] = [];
  let i: i32 = 0;
  while (i < arms.len()) {
    let vn: string = pv_name(arms[i].pattern);
    if (vn == "") {
      out = out.append(arms[i]);
      i = i + 1;
    } else {
      let j: i32 = i;
      while (j < arms.len() && pv_name(arms[j].pattern) == vn) {
        j = j + 1;
      }
      let any_nested: boolean = false;
      let k: i32 = i;
      while (k < j) {
        if (arm_is_nested(arms[k])) {
          any_nested = true;
        }
        k = k + 1;
      }
      if (!any_nested) {
        let c: i32 = i;
        while (c < j) {
          out = out.append(arms[c]);
          c = c + 1;
        }
      } else {
        out = out.append(build_merged_arm(vn, arms, i, j, fall, has_fall, depth, tag));
      }
      i = j;
    }
  }
  return out;
}

// build_merged_arm collapses one contiguous run of same-variant arms
// (arms[lo..hi], at least one nested) into a single flat arm
// `V(__nest) => match __nest { <inner arms> }`. A flat sibling arm rebinds
// the whole payload to its binder; a trailing outer `_` becomes the inner
// wildcard so unmatched payloads fall through.
// group_has_tuple reports whether any arm of a merged variant group carries a
// tuple sub-pattern, which decides whether the inner match is a tuple match.
function group_has_tuple(arms: ast.MatchArm[], lo: i32, hi: i32): boolean {
  let i: i32 = lo;
  while (i < hi) {
    match (arms[i].pattern) {
      ast.PatVariant(v) => {
        if (v.tup_kinds.len() > 0) {
          return true;
        }
      },
      ast.PatWildcard(w) => {}
    }
    i = i + 1;
  }
  return false;
}

// tuple_elems_irrefutable reports whether every element matches every value —
// a binder (kind 0), a `_` (kind 1), or a nested tuple (kind 4) all of whose
// own elements do. A literal (kind 2) and a variant sub-pattern (kind 3) can
// fail, at any depth.
function tuple_elems_irrefutable(kinds: i32[], pats: ast.Pattern[]): boolean {
  let i: i32 = 0;
  while (i < kinds.len()) {
    if (kinds[i] == 2 || kinds[i] == 3) {
      return false;
    }
    if (kinds[i] == 4) {
      let (nk, nb, nl, np) = pv_tup(pats[i]);
      if (!tuple_elems_irrefutable(nk, np)) {
        return false;
      }
    }
    i = i + 1;
  }
  return true;
}

function build_merged_arm(vn: string, arms: ast.MatchArm[], lo: i32, hi: i32, fall: ast.Stmt[], has_fall: boolean, depth: i32, tag: string): ast.MatchArm {
  let gp_line: i32 = arms[lo].line;
  let gp_col: i32 = arms[lo].col;
  let tmp: string = "__nest_" + util.i32_to_string(gp_line) + "_" + util.i32_to_string(gp_col) + "_" + util.i32_to_string(depth) + tag;
  let inner: ast.MatchArm[] = [];
  let has_inner_wild: boolean = false;
  let k: i32 = lo;
  while (k < hi) {
    let g: ast.MatchArm = arms[k];
    let inner_pat: ast.Pattern = p_wildcard();
    let inner_body: ast.Stmt[] = g.body;
    match (g.pattern) {
      ast.PatVariant(gv) => {
        if (gv.nested.len() > 0) {
          inner_pat = gv.nested[0];
        } else if (gv.binding.len() > 0 && gv.binding != "_") {
          // A flat sibling (`Some(x)`): rebind the whole payload.
          inner_body = prepend_stmt(s_var(gv.binding, "", e_ident(tmp)), g.body);
        }
      },
      ast.PatWildcard(w) => {}
    }
    if (pv_name(inner_pat) == "" && !g.has_guard) {
      has_inner_wild = true;
    }
    let (fn_pat, fn_g, fn_hg) = fold_lit_cond(inner_pat, g.guard, g.has_guard);
    inner = inner.append(ast.MatchArm { pattern: fn_pat, body: inner_body, line: g.line, col: g.col, guard: fn_g, has_guard: fn_hg, alt_cont: false });
    k = k + 1;
  }
  if (!has_inner_wild && has_fall) {
    inner = inner.append(ast.MatchArm { pattern: p_wildcard(), body: fall, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false, alt_cont: false });
  }
  // A TUPLE sub-pattern makes the inner match a TUPLE match. Same merge
  // shape as the variant case — the slot binds a temp and each arm of the
  // group contributes one inner arm — but routed through build_tuple_match,
  // because Pattern cannot express a tuple. A flat sibling (`Pr(x)`) becomes
  // a wildcard tuple arm that rebinds the whole slot, exactly as it becomes
  // a wildcard variant arm on the other path.
  if (group_has_tuple(arms, lo, hi)) {
    let tarms: ast.TupArm[] = [];
    let no_k: i32[] = [];
    let no_p: ast.Pattern[] = [];
    let no_b: string[] = [];
    let no_l: ast.Expr[] = [];
    let tuple_covers: boolean = false;
    let q: i32 = lo;
    while (q < hi) {
      let ga: ast.MatchArm = arms[q];
      match (ga.pattern) {
        ast.PatVariant(gv2) => {
          if (gv2.tup_kinds.len() > 0) {
            if (!ga.has_guard && tuple_elems_irrefutable(gv2.tup_kinds, gv2.tup_pats)) {
              tuple_covers = true;
            }
            tarms = tarms.append(ast.TupArm { is_wild: false, elem_kinds: gv2.tup_kinds, binds: gv2.tup_binds, lits: gv2.tup_lits, elem_pats: gv2.tup_pats, at_binding: "", guard: ga.guard, has_guard: ga.has_guard, body: ga.body, line: ga.line, col: ga.col, alt_cont: false });
          } else {
            let b2: ast.Stmt[] = ga.body;
            if (gv2.binding.len() > 0 && gv2.binding != "_") {
              b2 = prepend_stmt(s_var(gv2.binding, "", e_ident(tmp)), ga.body);
            }
            if (!ga.has_guard) {
              tuple_covers = true;
            }
            tarms = tarms.append(ast.TupArm { is_wild: true, elem_kinds: no_k, binds: no_b, lits: no_l, elem_pats: no_p, at_binding: "", guard: ga.guard, has_guard: ga.has_guard, body: b2, line: ga.line, col: ga.col, alt_cont: false });
          }
        },
        ast.PatWildcard(w2) => {}
      }
      q = q + 1;
    }
    // Only route the outer fallthrough in when nothing above already
    // covers every value — an all-binder tuple arm does, and appending
    // after it would emit an arm that can never run.
    if (!tuple_covers && has_fall) {
      tarms = tarms.append(ast.TupArm { is_wild: true, elem_kinds: no_k, binds: no_b, lits: no_l, elem_pats: no_p, at_binding: "", guard: e_bool(true), has_guard: false, body: fall, line: gp_line, col: gp_col, alt_cont: false });
    }
    let tmatch: ast.Stmt = build_tuple_match(e_ident(tmp), tarms, gp_line, gp_col);
    let t_no_extra: string[] = [];
    let t_no_nested: ast.Pattern[] = [];
    let t_nk: i32[] = [];
    let t_nb: string[] = [];
    let t_nl: ast.Expr[] = [];
    let t_np: ast.Pattern[] = [];
    let t_merged: ast.Pattern = ast.PatVariant { type_name: vn, binding: tmp, extra_bindings: t_no_extra, nested: t_no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: t_nk, tup_binds: t_nb, tup_lits: t_nl, tup_pats: t_np };
    let t_body: ast.Stmt[] = [tmatch];
    return ast.MatchArm { pattern: t_merged, body: t_body, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false, alt_cont: false };
  }
  let inner_desugared: ast.MatchArm[] = desugar_nested_arms(inner, depth + 1, tag);
  let inner_match: ast.Stmt = s_match_at(e_ident(tmp), inner_desugared, gp_line, gp_col);
  let no_extra: string[] = [];
  let no_nested: ast.Pattern[] = [];
  let no_tup_kinds: i32[] = [];
  let no_tup_binds: string[] = [];
  let no_tup_lits: ast.Expr[] = [];
  let no_tup_pats: ast.Pattern[] = [];
  let merged_pat: ast.Pattern = ast.PatVariant { type_name: vn, binding: tmp, extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
  let body: ast.Stmt[] = [inner_match];
  return ast.MatchArm { pattern: merged_pat, body: body, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false, alt_cont: false };
}

// parse_match_stmt consumes `match (scrutinee) { arm, arm, … }`
// starting from the `match` keyword. Arms separate with `,`
// (trailing comma optional). Each arm is `Pat => { stmts… }`.
// Malformed input recovers by yielding an empty-arm StmtMatch
// — the surrounding parse_module loop continues at the next
// token.

function parse_match_stmt(p: Par): (ast.Stmt, Par) {
  // E030 (non-exhaustive match) is reported at the `match` keyword.
  let mkline: i32 = p.peek_line();
  let mkcol: i32 = p.peek_col();
  p = p.advance();  // consume `match`
  let empty_arms: ast.MatchArm[] = [];
  if (p.peek_punct() != "(") {
    return (s_match(e_unknown_at("match: missing (", p.peek_line(), p.peek_col()), empty_arms), p);
  }
  p = p.advance();
  let (sr_expr, sr_p) = parse_expr(p);
  p = sr_p;
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  if (p.peek_punct() != "{") {
    return (s_match_at(sr_expr, empty_arms, mkline, mkcol), p);
  }
  p = p.advance();
  // A `(` at the FIRST arm's pattern position marks a match on a
  // TUPLE scrutinee: parse every arm as a tuple pattern / `_` and
  // desugar to the flag-chain build_tuple_match emits.
  if (p.peek_punct() == "(" || p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek_punct_at(1) == "@" && p.peek_punct_at(2) == "(") {
    let tarms: ast.TupArm[] = [];
    while (p.peek_punct() != "}" && !p.at_end()) {
      let taline: i32 = p.peek_line();
      let tacol: i32 = p.peek_col();
      let t_wild: boolean = false;
      let t_empty_body: ast.Stmt[] = [];
      let t_at: string = "";
      // Optional `name @` prefix: bind the whole matched tuple to
      // `name` while destructuring its elements (`w @ (a, b)`).
      if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
        t_at = p.peek_ident();
        p = p.advance();
        p = p.advance();
      }
      // Buffer each `|` alternative as a partial TupArm (guard + body
      // filled in once parsed). A TupArm[] is the same struct-array
      // build_tuple_match already consumes, so its array fields stay
      // on the IR-eligible path — no bare nested-array locals.
      let tpats: ast.TupArm[] = [];
      if (p.peek_punct() == "(") {
        let (tpr_elem_kinds, tpr_binds, tpr_lits, tpr_pats, tpr_p) = parse_tuple_arm_pattern(p);
        p = tpr_p;
        if (tpr_elem_kinds.len() == 0) {
          return (s_unknown(p, "bad tuple pattern"), p);
        }
        tpats = tpats.append(ast.TupArm { is_wild: false, elem_kinds: tpr_elem_kinds, binds: tpr_binds, lits: tpr_lits, elem_pats: tpr_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: t_empty_body, line: taline, col: tacol, alt_cont: false });
        // Tuple or-patterns: `(1, 2) | (3, 4) => …`. Each `|`
        // alternative becomes its own TupArm sharing the guard +
        // body (per-alternative binds), matching the literal path
        // above and the native per-alternative desugar.
        while (p.peek_punct() == "|") {
          p = p.advance();
          let (tor_kinds, tor_binds, tor_lits, tor_pats, tor_p) = parse_tuple_arm_pattern(p);
          p = tor_p;
          if (tor_kinds.len() == 0) {
            return (s_unknown(p, "bad tuple pattern"), p);
          }
          tpats = tpats.append(ast.TupArm { is_wild: false, elem_kinds: tor_kinds, binds: tor_binds, lits: tor_lits, elem_pats: tor_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: t_empty_body, line: taline, col: tacol, alt_cont: false });
        }
      } else {
        let (twp_pattern, twp_p) = parse_pattern(p);
        p = twp_p;
        t_wild = true;
      }
      let t_guard: ast.Expr = e_bool(true);
      let t_has_guard: boolean = false;
      if (p.peek_keyword() == "when") {
        p = p.advance();
        let (tgr_expr, tgr_p) = parse_expr(p);
        p = tgr_p;
        t_guard = tgr_expr;
        t_has_guard = true;
      }
      if (p.peek_punct() == "=>") {
        p = p.advance();
      }
      let (tbb_body, tbb_p) = parse_block(p);
      p = tbb_p;
      if (t_wild) {
        let tw_kinds: i32[] = [];
        let tw_pats: ast.Pattern[] = [];
        let tw_binds: string[] = [];
        let tw_lits: ast.Expr[] = [];
        tarms = tarms.append(ast.TupArm { is_wild: true, elem_kinds: tw_kinds, binds: tw_binds, lits: tw_lits, elem_pats: tw_pats, at_binding: "", guard: t_guard, has_guard: t_has_guard, body: tbb_body, line: taline, col: tacol, alt_cont: false });
      } else {
        let talt: i32 = 0;
        while (talt < tpats.len()) {
          let tpa: ast.TupArm = tpats[talt];
          tarms = tarms.append(ast.TupArm { is_wild: false, elem_kinds: tpa.elem_kinds, binds: tpa.binds, lits: tpa.lits, elem_pats: tpa.elem_pats, at_binding: t_at, guard: t_guard, has_guard: t_has_guard, body: tbb_body, line: taline, col: tacol, alt_cont: talt > 0 });
          talt = talt + 1;
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
        continue;
      }
      break;
    }
    if (p.peek_punct() == "}") {
      p = p.advance();
    }
    return (build_tuple_match(sr_expr, tarms, mkline, mkcol), p);
  }
  // An `Ident {` at the FIRST arm marks a STRUCT-pattern match (see
  // parse_match_expr) — desugar to the field-bind flag chain.
  if (is_struct_pattern_arm(p) && (p.peek_ident().len() > 0 && p.peek2_punct() == "{" || p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@" && p.peek_ident_at(2).len() > 0 && p.peek_punct_at(3) == "{")) {
    let (smarms, smrt, smok, smp) = parse_struct_match_arms(p, false);
    p = smp;
    if (!smok) {
      return (s_unknown(p, "a struct pattern binds field names"), p);
    }
    return (build_struct_match(sr_expr, smarms, mkline, mkcol), p);
  }
  // A literal at the FIRST arm's pattern position marks a match on a
  // non-enum (i32 / string) scrutinee: parse every arm as a literal /
  // `_` and desugar to an if/else-if chain (build_literal_match). The
  // decision is made once, up front, so the common enum/variant match
  // takes the normal StmtMatch path below with no extra allocation.
  if (p.peek_is_pat_literal() || p.peek_at_literal()) {
    let lit_arms: ast.LitArm[] = [];
    while (p.peek_punct() != "}" && !p.at_end()) {
      let laline: i32 = p.peek_line();
      let lacol: i32 = p.peek_col();
      let lwild: boolean = false;
      let (lat, lat_p) = take_at_binding(p);
      p = lat_p;
      let lalt_lits: ast.Expr[] = [];
      let lalt_his: ast.Expr[] = [];
      let lalt_hrs: boolean[] = [];
      let lalt_incs: boolean[] = [];
      if (p.peek_is_pat_literal()) {
        let (la_lits, la_his, la_hrs, la_incs, la_p) = parse_lit_alts(p);
        p = la_p;
        lalt_lits = la_lits;
        lalt_his = la_his;
        lalt_hrs = la_hrs;
        lalt_incs = la_incs;
      } else {
        let (lpr_pattern, lpr_p) = parse_pattern(p);
        p = lpr_p;
        lwild = true;
      }
      let lguard: ast.Expr = e_bool(true);
      let lhas_guard: boolean = false;
      if (p.peek_keyword() == "when") {
        p = p.advance();
        let (lgr_expr, lgr_p) = parse_expr(p);
        p = lgr_p;
        lguard = lgr_expr;
        lhas_guard = true;
      }
      if (p.peek_punct() == "=>") {
        p = p.advance();
      }
      let (lbb_body, lbb_p) = parse_block(p);
      p = lbb_p;
      if (lwild) {
        lit_arms = lit_arms.append(ast.LitArm { is_wild: true, lit: e_bool(true), guard: lguard, has_guard: lhas_guard, body: lbb_body, line: laline, col: lacol, range_hi: e_bool(true), has_range: false, range_inclusive: false, alt_cont: false, at_binding: "" });
      } else {
        // One LitArm per `|` alternative, sharing the guard + body.
        let lai: i32 = 0;
        while (lai < lalt_lits.len()) {
          lit_arms = lit_arms.append(ast.LitArm { is_wild: false, lit: lalt_lits[lai], guard: lguard, has_guard: lhas_guard, body: lbb_body, line: laline, col: lacol, range_hi: lalt_his[lai], has_range: lalt_hrs[lai], range_inclusive: lalt_incs[lai], alt_cont: lai > 0, at_binding: lat });
          lai = lai + 1;
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
        continue;
      }
      break;
    }
    if (p.peek_punct() == "}") {
      p = p.advance();
    }
    return (build_literal_match(sr_expr, lit_arms, mkline, mkcol), p);
  }
  let arms: ast.MatchArm[] = [];
  let written: ast.MatchArm[] = [];
  while (p.peek_punct() != "}" && !p.at_end()) {
    // E026 / E028 are reported at the arm (Go's `arm.P`), which is the
    // pattern's first token.
    let aline: i32 = p.peek_line();
    let acol: i32 = p.peek_col();
    let (pr_pattern, pr_p) = parse_pattern(p);
    p = pr_p;
    // Or-patterns: `A | B | … => body`. Each `|`-separated variant
    // pattern becomes its own MatchArm sharing the guard + body, so the
    // checker (exhaustiveness) and lowering see a flat arm list. Bindings
    // are per-alternative; the body only sees those the alternative
    // introduces. (Variant patterns only — a literal arm takes the
    // build_literal_match path above, and bare `|` is bitwise-or there.)
    let pats: ast.Pattern[] = [pr_pattern];
    while (p.peek_punct() == "|") {
      p = p.advance();
      let (pr2_pattern, pr2_p) = parse_pattern(p);
      p = pr2_p;
      pats = pats.append(pr2_pattern);
    }
    // Optional guard: `Pattern when <expr> => …`. The arm matches only
    // when the guard is true (E027 checks it is boolean). Applies to
    // every alternative of an or-pattern.
    let arm_guard: ast.Expr = e_bool(true);
    let arm_has_guard: boolean = false;
    if (p.peek_keyword() == "when") {
      p = p.advance();
      let (gr_expr, gr_p) = parse_expr(p);
      p = gr_p;
      arm_guard = gr_expr;
      arm_has_guard = true;
    }
    // `=>` arrives as a single punct token from the lexer.
    if (p.peek_punct() == "=>") {
      p = p.advance();
    }
    let (bb_body, bb_p) = parse_block(p);
    p = bb_p;
    let pi: i32 = 0;
    while (pi < pats.len()) {
      // The WRITTEN arm goes to `sugar` before fold_lit_cond moves a
      // literal payload into the guard and before desugar_nested_arms
      // merges a nested one — those two are what the printer must not
      // reprint in place of the source.
      written = written.append(ast.MatchArm { pattern: pats[pi], body: bb_body, line: aline, col: acol, guard: arm_guard, has_guard: arm_has_guard, alt_cont: pi > 0 });
      let (fs_pat, fs_g, fs_hg) = fold_lit_cond(pats[pi], arm_guard, arm_has_guard);
      arms = arms.append(ast.MatchArm { pattern: fs_pat, body: bb_body, line: aline, col: acol, guard: fs_g, has_guard: fs_hg, alt_cont: false });
      pi = pi + 1;
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  let sugar: ast.MatchArm[] = [];
  if (arms_have_written_form(written)) {
    sugar = written;
  }
  // Arms carrying payload sub-patterns take the flag chain, which keeps
  // them FLAT and in source order so a failing sub-pattern falls to the
  // next arm. Everything else takes the untouched path, so the emit for
  // every match the compiler's own sources contain stays byte-identical.
  if (arms_take_flag_chain(arms)) {
    return (build_nested_arm_match(sr_expr, arms, written, mkline, mkcol), p);
  }
  arms = desugar_nested_arms(arms, 0, "");
  return (s_match_sugared(sr_expr, arms, sugar, mkline, mkcol), p);
}

// arms_have_written_form reports whether any arm's pattern carries something
// the lowering consumes — a nested payload or a literal one — so the written
// arms are worth keeping for the printer. False for every ordinary match.
function arms_have_written_form(written: ast.MatchArm[]): boolean {
  let i: i32 = 0;
  while (i < written.len()) {
    if (written[i].alt_cont) {
      return true;
    }
    match (written[i].pattern) {
      ast.PatVariant(v) => {
        if (v.nested.len() > 0 || v.has_lit_cond || v.tup_kinds.len() > 0) {
          return true;
        }
      },
      ast.PatWildcard(w) => {}
    }
    i = i + 1;
  }
  return false;
}

// mentions_name is the mentions family's per-node contribution: one node is a
// mention when it reads `name` as an identifier.
function mentions_name(e: ast.Expr, name: string, hit: boolean): boolean {
  if (hit) {
    return true;
  }
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == name;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// stmt_mentions / stmts_mention report whether `name` appears as an
// identifier anywhere in a statement / statement list. Used to detect a
// recursive nested function (one on a cycle of references), which
// hl_rewrite lifts to top level. Conservative: any mention counts.
//
// Folding these onto astwalk WIDENS them by one node: the hand-written walk's
// `_ =>` tail had no StmtDefer arm, so a name mentioned only inside a defer
// action read as absent. astwalk enumerates all twelve Stmt cases, so it is
// seen. Widening is the safe direction — every caller treats absence as a
// licence.
//
// The other two nodes the `_ =>` swallowed, ExprFString and ExprMapLit, change
// nothing: parse_module desugars both to calls before any consumer runs.
pub function stmt_mentions(st: ast.Stmt, name: string): boolean {
  function visit(n: ast.Expr, own a: boolean): boolean {
    return mentions_name(n, name, a);
  }
  return astwalk.fold_stmt(st, false, visit);
}

pub function stmts_mention(stmts: ast.Stmt[], name: string): boolean {
  for st in stmts {
    if (stmt_mentions(st, name)) {
      return true;
    }
  }
  return false;
}

// parse_loop_stmt parses `loop { body }` — the canonical infinite loop —
// and desugars it to `while (true) { body }` so it uses the existing
// StmtWhile IR lowering (block/loop/br_if) with no new node or emitter
// arm. Kept in its own function so parse_stmt (already very large) doesn't
// grow — an oversized function miscompiles on the native backend (#2720).
function parse_loop_stmt(p: Par): (ast.Stmt, Par) {
  let p2: Par = p.advance();
  let (lb_body, lb_p) = parse_block_or_stmt(p2);
  // `loop` and `while (true)` are the same loop to every consumer below the
  // printer, which is why one node models both; is_loop records which was
  // written so a reformat does not rewrite one into the other.
  return (ast.StmtWhile { cond: e_bool(true), body: lb_body, label: "", line: 0, is_loop: true }, lb_p);
}

// parse_for_stmt parses a `for` statement (`p` is positioned at the
// `for` keyword). Split out of parse_stmt's keyword dispatch so that
// already-large function stays under the native backend's per-function
// size limit (oversized functions miscompile — cf. #2720). Three forms:
// `for (k, v) in m { body }` (map destructuring), `for x in EXPR { body }`
// (array / range foreach), and the range form `for i in LOW..HIGH` /
// `for i in LOW..=HIGH` — the latter two encode the interval as a
// synthetic `__range` / `__range_incl` call (see below).
function parse_for_stmt(p: Par): (ast.Stmt, Par) {
  // `for VAR in EXPR { body }`. `in` arrives as a plain
  // TokIdent (not in the lexer's keyword set), so peek
  // it through peek_ident rather than peek_keyword.
  p = p.advance();  // consume `for`
  // `for (a, b) in EXPR { body }` — destructuring iteration. The binders
  // are the comma-joined encoding a `let (a, b) = …` destructure carries,
  // and lower_stmt_for picks the loop from the iterand's type: a map local
  // walks its key/value columns, anything else binds the pattern against
  // each element.
  if (p.peek_punct() == "(") {
    let cfl: i32 = p.peek_line();
    let cfc: i32 = p.peek_col();
    let kv_open: Par = p;
    p = p.advance();
    // C-style `for (INIT; COND; STEP) { BODY }` — distinguished from the
    // destructuring form by a top-level `;` in the header (a pattern has
    // none). Native accepts a `let` init, an expression init, or
    // an empty init/cond (`parser.go` parseFor); the self-host previously
    // gated only on a `let` init (#2820), so `for (i = 0; …)` / `for (;
    // …)` fell into the map arm and mis-parsed (#4339). The Stmt union has
    // no C-style-for node, so desugar to a scoped while loop with a
    // first-iteration flag, so a `continue` re-runs STEP (matching C
    // semantics) instead of skipping it. Reuses if / while / break.
    //
    // Detect via a lookahead: scan a copy of the cursor for a top-level
    // `;` before the matching `)`, tracking ()[]{} nesting depth.
    let scan: Par = p;
    let sc_depth: i32 = 0;
    let is_cfor: boolean = false;
    while (!scan.at_end()) {
      let sp: string = scan.peek_punct();
      if (sp == "(" || sp == "[" || sp == "{") {
        sc_depth = sc_depth + 1;
      } else if (sp == ")" || sp == "]" || sp == "}") {
        if (sc_depth == 0) {
          break;
        }
        sc_depth = sc_depth - 1;
      } else if (sp == ";" && sc_depth == 0) {
        is_cfor = true;
        break;
      }
      scan = scan.advance();
    }
    if (is_cfor) {
      // INIT: empty (`;`), `let …`, or an expression statement — each
      // terminated by `;` (parse_stmt eats it for the var/expr forms).
      let initstmts: ast.Stmt[] = [];
      if (p.peek_punct() == ";") {
        p = p.advance();
      } else {
        let (fcinit_stmt, fcinit_p) = parse_stmt(p);
        p = fcinit_p;
        initstmts = [fcinit_stmt];
      }
      // COND: empty means "always true" (`for (…; ; …)` loops forever).
      let condexpr: ast.Expr = e_bool(true);
      if (p.peek_punct() != ";") {
        let (fccond_expr, fccond_p) = parse_expr(p);
        p = fccond_p;
        condexpr = fccond_expr;
      }
      if (p.peek_punct() == ";") {
        p = p.advance();
      }
      let stepone: ast.Stmt[] = [];  // STEP (no `;`, stops at `)`)
      if (p.peek_punct() != ")") {
        let (fcstep_stmt, fcstep_p) = parse_stmt(p);
        p = fcstep_p;
        stepone = [fcstep_stmt];
      }
      if (p.peek_punct() == ")") {
        p = p.advance();
      }
      let (fcbody_body, fcbody_p) = parse_block(p);
      p = fcbody_p;
      let flag: string = "__forc_" + util.i32_to_string(cfl) + "_" + util.i32_to_string(cfc);
      let noelse: ast.Stmt[] = [];
      let wbody: ast.Stmt[] = [];
      // if (!first) { STEP }   -- runs STEP before every iteration but
      //                           the first, so a `continue` runs it too.
      wbody = wbody.append(s_if(e_unary("!", e_ident(flag)), stepone, noelse));
      // first = false
      wbody = wbody.append(s_assign(flag, e_bool(false)));
      // if (!(COND)) { break }  — with an empty cond, COND is `true`, so
      // this is `if (!true) break`, i.e. never breaks (infinite loop).
      let breakone: ast.Stmt[] = [s_break()];
      wbody = wbody.append(s_if(e_unary("!", condexpr), breakone, noelse));
      let fbi: i32 = 0;
      while (fbi < fcbody_body.len()) {
        wbody = wbody.append(fcbody_body[fbi]);
        fbi = fbi + 1;
      }
      // { INIT; let first = true; while (true) { <wbody> } }  (scoped via if-true)
      let outer: ast.Stmt[] = [];
      let ini: i32 = 0;
      while (ini < initstmts.len()) {
        outer = outer.append(initstmts[ini]);
        ini = ini + 1;
      }
      outer = outer.append(s_var(flag, "", e_bool(true)));
      outer = outer.append(s_while(e_bool(true), wbody));
      return (s_if(e_bool(true), outer, noelse), p);
    }
    // The binder list is the same production a `let` destructure takes, so
    // arity, a trailing comma (`for (k, v,) in m`) and a nested position
    // (`for ((a, b), c) in xs`) all behave here as they do there, and the
    // comma-joined encoding it returns is the one lower_stmt_var already
    // decodes.
    let (kvnames, kvcount, kvok, kvnames_p) = parse_destructure_names(kv_open);
    p = kvnames_p;
    if (!kvok || kvcount < 2) {
      return (s_unknown(p, "for pattern needs at least 2 binders"), p);
    }
    if (p.peek_ident() == "in") {
      p = p.advance();
    }
    // Suppress trailing struct-literal parsing — the `{` that
    // follows the iter opens the loop body, not a struct lit.
    let kv_saved: boolean = p.no_struct;
    let (kvi_expr, kvi_p) = parse_expr(p.with_no_struct(true));
    p = kvi_p.with_no_struct(kv_saved);
    let (kvb_body, kvb_p) = parse_block(p);
    p = kvb_p;
    return (s_for(kvnames, kvi_expr, kvb_body), p);
  }
  // A pattern-shaped header — `for Point { x, y } in ps`, `for w @ (a, b) in
  // xs` — takes the same grammar every other binding site does. It desugars
  // to the plain foreach plus a destructure of the element, which is the
  // shape the encoded `for (a, b) in xs` form already takes,
  // so nothing below the parser learns a new
  // header. An `@` binding names the element itself, exactly as it names a
  // destructured parameter's holder. The bare tuple head stays on the
  // encoded path above: it is the only one that can also iterate a Map,
  // whose key and value columns are not an element to destructure.
  let fpre: ast.Stmt[] = [];
  let fvar: string = "";
  if (at_pattern_head(p)) {
    let fp_line: i32 = p.peek_line();
    let fp_col: i32 = p.peek_col();
    // The `@` binding is carried on the DESTRUCTURE, which already names the
    // temp holding the whole value after it — so the element local stays
    // synthetic and the printer has one rule for every pattern header:
    // a `$forpat_` element whose first body statement destructures it.
    let fp_at: string = "";
    if (p.peek_punct_at(1) == "@") {
      fp_at = p.peek_ident();
      p = p.advance();
      p = p.advance();
    }
    let fp_elem: string = "$forpat_" + util.i32_to_string(fp_line) + "_" + util.i32_to_string(fp_col);
    let fp_init: ast.Expr = e_ident_at(fp_elem, fp_line, fp_col);
    if (p.peek_punct() == "(") {
      let (fpnames, fpcount, fpok, fpnames_p) = parse_destructure_names(p);
      p = fpnames_p;
      if (!fpok || fpcount < 2) {
        return (s_unknown(p, "for pattern needs at least 2 binders"), p);
      }
      fpre = [s_var_at(fpnames, destr_marker(fp_at, false, ""), fp_init, fp_line, fp_col)];
    } else {
      let fp_struct: string = p.peek_ident();
      p = p.advance();
      let (fpbinds, fpfields, fpfields_rest, fpfields_ok, fpfields_p) = parse_struct_pattern_fields(p);
      p = fpfields_p;
      if (!fpfields_ok || fpbinds.len() == 0) {
        return (s_unknown(p, "a struct destructuring pattern binds field names"), p);
      }
      fpre = [s_var_at(fpbinds, destr_marker(fp_at, fpfields_rest, "@sd:" + fp_struct + ":" + fpfields), fp_init, fp_line, fp_col)];
    }
    fvar = fp_elem;
  } else {
    fvar = p.peek_ident();
    if (fvar.len() == 0) {
      return (s_unknown(p, "missing for-let name"), p);
    }
    p = p.advance();
  }
  if (p.peek_ident() != "in") {
    return (s_unknown(p, "missing `in` in for"), p);
  }
  p = p.advance();  // consume `in`
  // Suppress trailing struct-literal parsing on the iter so that
  // `for x in a {}` reads `a` + an empty block, not `a {}`.
  let f_saved: boolean = p.no_struct;
  // Read the iterable / LOW bound BELOW the range-expression level
  // (parse_binary, not parse_expr) so `for i in 0..n` stops at `..` and keeps
  // the counted-loop desugar below, instead of collapsing `0..n` into an
  // `iter.range(0, n)` iterator value.
  let (fiter_expr, fiter_p) = parse_binary(p.with_no_struct(true), 1);
  p = fiter_p.with_no_struct(f_saved);
  let iter_expr: ast.Expr = fiter_expr;
  // Range form `for IDENT in LOW..HIGH { body }`. parse_expr stops
  // at `..` (not a binary operator), so `fiter_expr` is LOW; read
  // `..` + HIGH and encode the half-open interval as a synthetic
  // `__range(LOW, HIGH)` call — the same parser-internal-builtin
  // idiom as `__set_index` / `__set_field`. The checker binds the
  // loop var at its bounds' type and the lowering lowers it to a counted
  // loop; the call shape goes through constfold / substitution /
  // printing for free (LOW, HIGH are ordinary sub-expressions). The
  // inclusive form `LOW..=HIGH` emits `__range_incl(LOW, HIGH)`
  // instead, which the lowering lowers with a `<=` (closed-interval)
  // condition.
  let range_punct: string = p.peek_punct();
  if (range_punct == ".." || range_punct == "..=") {
    p = p.advance();  // consume `..` or `..=`
    let hi_saved: boolean = p.no_struct;
    let (fhi_expr, fhi_p) = parse_binary(p.with_no_struct(true), 1);
    p = fhi_p.with_no_struct(hi_saved);
    let rargs: ast.Expr[] = [fiter_expr, fhi_expr];
    let range_fn: string = "__range";
    if (range_punct == "..=") {
      range_fn = "__range_incl";
    }
    iter_expr = e_call(e_ident(range_fn), rargs);
  }
  let (fb_body, fb_p) = parse_block_or_stmt(p);
  p = fb_p;
  let fbi: i32 = 0;
  while (fbi < fb_body.len()) {
    fpre = fpre.append(fb_body[fbi]);
    fbi = fbi + 1;
  }
  return (s_for(fvar, iter_expr, fpre), p);
}

// with_stmt_line stamps the source line a statement STARTS on. Five Stmt kinds
// grew the field for the formatter, which places a comment by comparing its
// line against the line of the statement that follows it (#6769); the other
// kinds already carried a position from their own construction, and a
// synthesised statement keeps the 0 its literal gives it — the same
// "0 cannot name anything the user wrote" convention print_module already uses
// to skip `@derive`'s methods.
function with_stmt_line(st: ast.Stmt, line: i32): ast.Stmt {
  match (st) {
    ast.StmtExpr(x) => {
      return ast.StmtExpr { value: x.value, line: line };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, line: line };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: w.cond, body: w.body, label: w.label, line: line, is_loop: w.is_loop };
    },
    ast.StmtFor(fo) => {
      return ast.StmtFor { var_name: fo.var_name, iter: fo.iter, body: fo.body, label: fo.label, line: line };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: d.action, on_error: d.on_error, line: line };
    },
    _ => {
      return st;
    }
  }
  return st;
}

// parse_stmt parses one statement and stamps the line it began on.
// parse_stmt is the depth-guarded face of parse_stmt_nested: see MAX_NEST_DEPTH.
function parse_stmt(p: Par): (ast.Stmt, Par) {
  if (p.too_deep()) {
    return (s_unknown_at("nest:too-deep", p.peek_line(), p.peek_col()), p.bail());
  }
  let (g0, gq) = parse_stmt_nested(p.with_depth(p.depth + 1));
  return (g0, gq.with_depth(p.depth));
}

function parse_stmt_nested(p: Par): (ast.Stmt, Par) {
  let stmt_line: i32 = p.peek_line();
  let (parsed, after) = parse_stmt_at(p);
  return (with_stmt_line(parsed, stmt_line), after);
}

function parse_stmt_at(p: Par): (ast.Stmt, Par) {
  // A bare block `{ ... }` in statement position is its own scope. The
  // self-host Stmt union has no StmtBlock node, so desugar it to
  // `if (true) { ... }` — reusing the scoped if-body (the same trick
  // `loop` uses for `while (true)`), tagged so `-fmt` reprints the braces.
  // Map / struct literals only appear in expression position, so a leading
  // `{` here is unambiguously a block.
  if (p.peek_punct() == "{") {
    let (bb_body, bb_p) = parse_block(p);
    return (s_block(bb_body), bb_p);
  }
  // Loop label `outer: while (…) { … }` / `outer: for … ` / `outer: loop { … }`.
  // A leading `IDENT :` immediately before a loop keyword is a label (a bare
  // `IDENT :` at statement start has no other meaning). Capture it, consume the
  // `IDENT :`, and attach it to the loop below via with_loop_label; a labeled
  // `break outer` / `continue outer` targets it (resolve_labels bakes the
  // relative depth into the break/continue tag).
  let loop_label: string = "";
  let llid: string = p.peek_ident();
  if (llid.len() > 0) {
    let lp1: Par = p.advance();
    if (lp1.peek_punct() == ":") {
      let lp2: Par = lp1.advance();
      let lkw: string = lp2.peek_keyword();
      if (lkw == "while" || lkw == "for" || lkw == "loop") {
        loop_label = llid;
        p = lp2;
      }
    }
  }
  // `assert(cond)` / `assert(cond, msg)` builtin — desugar to
  // `if (!cond) { eprint("assertion failed[: msg]"); exit(1); }`. A
  // parser-level rewrite over the existing `!` / string-`+` / eprint /
  // exit primitives, so it lowers with no dedicated codegen on every
  // backend and both IR paths — mirroring the native parser's
  // parseAssert. `assert` is an identifier (not a keyword), so we only
  // intercept the statement-position `assert (` shape and leave the
  // name free for ordinary use elsewhere. #4416.
  if (p.peek_ident() == "assert") {
    let as0: Par = p.advance();  // consume `assert`
    if (as0.peek_punct() == "(") {
      let asp: Par = as0.advance();  // consume `(`
      let (as_cond, ascp) = parse_expr(asp);
      asp = ascp;
      let as_has_msg: boolean = false;
      let as_msg: ast.Expr = e_string("");
      if (asp.peek_punct() == ",") {
        asp = asp.advance();
        let (asm_e, asmp) = parse_expr(asp);
        as_msg = asm_e;
        asp = asmp;
        as_has_msg = true;
      }
      if (asp.peek_punct() == ")") {
        asp = asp.advance();
      }
      if (asp.peek_punct() == ";") {
        asp = asp.advance();
      }
      let as_text: ast.Expr = e_string("assertion failed");
      if (as_has_msg) {
        as_text = e_binary("+", e_string("assertion failed: "), as_msg);
      }
      let as_body: ast.Stmt[] = [];
      let as_eargs: ast.Expr[] = [];
      as_eargs = as_eargs.append(as_text);
      as_body = as_body.append(s_expr(e_call(e_ident("eprint"), as_eargs)));
      let as_xargs: ast.Expr[] = [];
      as_xargs = as_xargs.append(e_number("1", "", false));
      as_body = as_body.append(s_expr(e_call(e_ident("exit"), as_xargs)));
      let as_noelse: ast.Stmt[] = [];
      return (s_if_origin(e_unary("!", as_cond), as_body, as_noelse, ORIGIN_ASSERT), asp);
    }
  }
  // `todo;` / `todo("msg");` builtin — desugar to
  // `while (true) { eprint("todo[: msg]"); exit(101); }`, mirroring
  // the native parser's parseTodo (whose `loop { ... }` desugar this
  // parser lowers to the same while-true shape — see parse_loop_stmt).
  // The always-true loop makes the stub DIVERGE for the checker's
  // missing-return / let-else analyses, so `todo;` can stand in for a
  // whole non-void function body; exit(101) fires on the first
  // iteration. Only the statement-position `todo ;` / `todo (` shapes
  // are intercepted, so `todo` stays usable as an ordinary identifier
  // elsewhere. The runtime message must stay byte-identical to the
  // native parser's.
  if (p.peek_ident() == "todo") {
    let td_site: TodoSite = TodoSite { line: p.peek_line(), col: p.peek_col() };
    let td0: Par = p.advance();  // consume `todo`
    let td0p: string = td0.peek_punct();
    if (td0p == "(" || td0p == ";") {
      let tdp: Par = td0;
      let td_has_msg: boolean = false;
      let td_msg: ast.Expr = e_string("");
      if (td0p == "(") {
        tdp = tdp.advance();  // consume `(`
        if (tdp.peek_punct() != ")") {
          let (tdm_e, tdmp) = parse_expr(tdp);
          td_msg = tdm_e;
          tdp = tdmp;
          td_has_msg = true;
        }
        if (tdp.peek_punct() == ")") {
          tdp = tdp.advance();
        }
      }
      if (tdp.peek_punct() == ";") {
        tdp = tdp.advance();
      }
      let td_text: ast.Expr = e_string("todo: not implemented");
      if (td_has_msg) {
        td_text = e_binary("+", e_string("todo: "), td_msg);
      }
      let td_body: ast.Stmt[] = [];
      let td_eargs: ast.Expr[] = [];
      td_eargs = td_eargs.append(td_text);
      td_body = td_body.append(s_expr(e_call(e_ident("eprint"), td_eargs)));
      let td_xargs: ast.Expr[] = [];
      td_xargs = td_xargs.append(e_number("101", "", false));
      td_body = td_body.append(s_expr(e_call(e_ident("exit"), td_xargs)));
      return (s_while(e_bool(true), td_body), Par { ...tdp, todos: tdp.todos.append(td_site) });
    }
  }
  let kw: string = p.peek_keyword();
  if (kw == "defer") {
    // `defer ACTION;` — the deferred action is a block, an expression or an
    // assignment; lower_defers schedules it at function exit.
    p = p.advance();  // consume `defer`
    let (da_stmt, da_p) = parse_stmt(p);
    return (s_defer(defer_action(da_stmt, p)), da_p);
  }
  if (kw == "errdefer") {
    // `errdefer ACTION;` — like `defer`, but lower_defers schedules it
    // only on an error exit (a `return` of a None/Err value).
    p = p.advance();  // consume `errdefer`
    let (ea_stmt, ea_p) = parse_stmt(p);
    return (s_errdefer(defer_action(ea_stmt, p)), ea_p);
  }
  if (kw == "function") {
    // Local (nested) function declaration: desugar to a closure-valued
    // local `let name = (params): ret => { body };`. Calls resolve
    // through the closure-call path, and references to enclosing locals
    // are captured by the lambda machinery. Mirrors the Go parser
    // marking it IsLocal + the closureconv hoist; ast.var_binds_itself
    // is what lets it call itself.
    let (fr_func, fr_p) = parse_func_decl(p);
    p = fr_p;
    // The FuncDecl is discarded below, so check_decl_names never sees it;
    // what that gate would refuse is reported through a `decl:` sentinel.
    if (fr_func.name.len() == 0) {
      return (s_unknown_at("decl:" + malformed_fn_decl_message(), fr_func.line, fr_func.col), p);
    }
    for prm in fr_func.params {
      if (prm.type_name.len() == 0) {
        return (s_unknown_at("decl:parameter \"" + prm.name + "\" of \"" + fr_func.name + "\" has no type: expected \":\" after its name", fr_func.line, fr_func.col), p);
      }
    }
    let lam: ast.Expr = e_lambda_fn(fr_func.params, fr_func.ret_type, fr_func.body, fr_func.ret_fn_ret, fr_func.ret_fn_param_types);
    // `-fmt` records which of the two spellings was written, the way a
    // struct destructure uses the same field ("@sd:…"): both parse to a
    // lambda-valued local, so without the marker a nested declaration came
    // back as `let f = (…) => { … };`.
    if (p.verbatim) {
      return (s_var_at(fr_func.name, "@fndecl", lam, fr_func.line, fr_func.col), p);
    }
    return (s_var(fr_func.name, "", lam), p);
  }
