function s_var(name: string, type_name: string, init: ast.Expr): ast.Stmt {
  return ast.StmtVar { name: name, type_name: type_name, init: init, line: 0, col: 0, fn_ret: "", fn_param_types: "" };
}

function s_var_at(name: string, type_name: string, init: ast.Expr, line: i32, col: i32): ast.Stmt {
  return ast.StmtVar { name: name, type_name: type_name, init: init, line: line, col: col, fn_ret: "", fn_param_types: "" };
}

function parse_destructure_names(p: Par): (string, i32, boolean, Par) {
  if (p.too_deep()) {
    return ("", 0, false, p.bail());
  }
  let (g0, g1, g2, gq) = parse_destructure_names_nested(p.with_depth(p.depth + 1));
  return (g0, g1, g2, gq.with_depth(p.depth));
}

function parse_destructure_names_nested(p: Par): (string, i32, boolean, Par) {
  let open_line: i32 = p.peek_line();
  let open_col: i32 = p.peek_col();
  p = p.advance();
  let names: string = "";
  let count: i32 = 0;
  let first: boolean = true;
  while (p.peek_punct() != ")" && !p.at_end()) {
    let part: string = "";
    if (p.peek_punct() == "(") {
      let (inner, inner_n, inner_ok, inner_p) = parse_destructure_names(p);
      p = inner_p;
      if (!inner_ok || inner_n < 2) {
        return ("", 0, false, p);
      }
      part = "(" + inner + ")";
    } else {
      part = p.peek_ident();
      if (part.len() == 0) {
        return ("", 0, false, p);
      }
      part = discard_name(part, open_line, open_col, count);
      p = p.advance();
    }
    if (!first) {
      names = names + ",";
    }
    names = names + part;
    first = false;
    count = count + 1;
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
  }
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  return (names, count, true, p);
}

function parse_struct_pattern_fields(p: Par): (string, string, boolean, boolean, Par) {
  p = p.advance();
  let bindings: string = "";
  let fields: string = "";
  let rest_written: boolean = false;
  let first: boolean = true;
  while (p.peek_punct() != "}" && !p.at_end()) {
    if (p.peek_punct() == "..") {
      p = p.advance();
      rest_written = true;
      break;
    }
    let fld: string = p.peek_ident();
    if (fld.len() == 0) {
      return ("", "", false, false, p);
    }
    p = p.advance();
    let bind: string = fld;
    if (p.peek_punct() == ":") {
      p = p.advance();
      let bn: string = p.peek_ident();
      if (bn.len() > 0) {
        bind = discard_name(bn, p.peek_line(), p.peek_col(), 0);
        p = p.advance();
      }
    }
    if (!first) {
      bindings = bindings + ",";
      fields = fields + ",";
    }
    bindings = bindings + bind;
    fields = fields + fld;
    first = false;
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (bindings, fields, rest_written, true, p);
}

function parse_struct_destructure(p: Par, struct_name: string, at: string, line: i32, col: i32): (ast.Stmt, Par) {
  let (bindings, fields, fields_rest, fields_ok, fields_p) = parse_struct_pattern_fields(p);
  p = fields_p;
  if (!fields_ok) {
    return (s_unknown(p, "a struct destructuring pattern binds field names"), p);
  }
  p = p.expect("=");
  let (init_expr, ip) = parse_expr(p);
  p = ip;
  p = p.end_of(init_expr);
  if (bindings.len() == 0) {
    return (s_unknown_at("struct destructure needs at least one field", line, col), p);
  }
  return (s_var_at(bindings, destr_marker(at, fields_rest, "@sd:" + struct_name + ":" + fields), init_expr, line, col), p);
}

function s_return(value: ast.Expr): ast.Stmt {
  return ast.StmtReturn { value: value, line: 0, col: 0 };
}

function s_return_at(value: ast.Expr, line: i32, col: i32): ast.Stmt {
  return ast.StmtReturn { value: value, line: line, col: col };
}

function s_expr(value: ast.Expr): ast.Stmt {
  return ast.StmtExpr { value: value, line: 0 };
}

function s_if(cond: ast.Expr, then_body: ast.Stmt[], else_body: ast.Stmt[]): ast.Stmt {
  return s_if_chained(cond, then_body, else_body, false);
}

function s_if_origin(cond: ast.Expr, then_body: ast.Stmt[], else_body: ast.Stmt[], origin: string): ast.Stmt {
  return ast.StmtIf { cond: cond, then_body: then_body, else_body: else_body, line: 0, else_chained: false, sugar: no_match_sugar(), origin: origin };
}

pub const ORIGIN_ASSERT: string = "assert";

pub const ORIGIN_BLOCK: string = "block";

pub const ORIGIN_MATCH_EXPR: string = "match_expr";

pub const ORIGIN_PATTERN_PROBE: string = "pattern_probe";

pub const ORIGIN_IF_EXPR: string = "if_expr";

pub const ORIGIN_IF_DEAD_THEN: string = "if_expr_dead_then";

pub const ORIGIN_IF_DEAD_ELSE: string = "if_expr_dead_else";

pub const ORIGIN_IF_DEAD_BOTH: string = "if_expr_dead_both";

pub const ORIGIN_ARR_COMP: string = "arr_comp";

pub const ORIGIN_MAP_COMP: string = "map_comp";

pub const ORIGIN_IIFE_SCOPED: string = "iife_scoped";

pub const DFA_TRYALL: string = "__dfa_tryall";

pub const DFA_TRYERR: string = "__dfa_tryerr";

pub const ORIGIN_USE: string = "use";

pub function no_match_sugar(): ast.MatchSugar {
  let no_tup: ast.TupArm[] = [];
  let no_struct: ast.StructArm[] = [];
  let no_lit: ast.LitArm[] = [];
  let no_arms: ast.MatchArm[] = [];
  return ast.MatchSugar { scrut: e_unknown(""), tup: no_tup, strct: no_struct, lits: no_lit, arms: no_arms, line: 0, col: 0, origin: "" };
}

function s_if_match(body: ast.Stmt[], sugar: ast.MatchSugar): ast.Stmt {
  let no_else: ast.Stmt[] = [];
  return ast.StmtIf { cond: e_bool(true), then_body: body, else_body: no_else, line: sugar.line, else_chained: false, sugar: sugar, origin: "" };
}

function s_if_chained(cond: ast.Expr, then_body: ast.Stmt[], else_body: ast.Stmt[], chained: boolean): ast.Stmt {
  return ast.StmtIf { cond: cond, then_body: then_body, else_body: else_body, line: 0, else_chained: chained, sugar: no_match_sugar(), origin: "" };
}

function s_if_tagged(body: ast.Stmt[], origin: string): ast.Stmt {
  let no_else: ast.Stmt[] = [];
  return ast.StmtIf { cond: e_bool(true), then_body: body, else_body: no_else, line: 0, else_chained: false, sugar: no_match_sugar(), origin: origin };
}

function s_block(body: ast.Stmt[]): ast.Stmt {
  return s_if_tagged(body, "block");
}

function s_while(cond: ast.Expr, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtWhile { cond: cond, body: body, label: "", line: 0, is_loop: false, todo: false };
}

function s_for(var_name: string, iter: ast.Expr, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtFor { var_name: var_name, iter: iter, body: body, label: "", line: 0, col: 0 };
}

function with_loop_label(st: ast.Stmt, label: string): ast.Stmt {
  if (label.len() == 0) {
    return st;
  }
  match (st) {
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: w.cond, body: w.body, label: label, line: w.line, is_loop: w.is_loop, todo: w.todo };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: fr.body, label: label, line: fr.line, col: fr.col };
    },
    ast.StmtIf(f) => {
      let n: i32 = f.then_body.len();
      if (n == 0) {
        return st;
      }
      match (f.then_body[n - 1]) {
        ast.StmtWhile(w2) => {
          let relabelled: ast.Stmt[] = [];
          let i: i32 = 0;
          while (i < n - 1) {
            relabelled = relabelled.append(f.then_body[i]);
            i = i + 1;
          }
          relabelled = relabelled.append(ast.StmtWhile { cond: w2.cond, body: w2.body, label: label, line: w2.line, is_loop: w2.is_loop, todo: w2.todo });
          return ast.StmtIf { ...f, cond: f.cond, then_body: relabelled, else_body: f.else_body };
        },
        _ => {
          return st;
        }
      }
      return st;
    },
    _ => {
      return st;
    }
  }
  return st;
}

function s_break(): ast.Stmt {
  return ast.StmtBreak { tag: 0, line: 0, col: 0, label: "" };
}

function s_assign(target: string, value: ast.Expr): ast.Stmt {
  return ast.StmtAssign { target: target, value: value, line: 0, col: 0, target_line: 0, target_col: 0 };
}

function s_assign_at(target: string, value: ast.Expr, line: i32, col: i32, target_line: i32, target_col: i32): ast.Stmt {
  return ast.StmtAssign { target: target, value: value, line: line, col: col, target_line: target_line, target_col: target_col };
}

function s_match(scrutinee: ast.Expr, arms: ast.MatchArm[]): ast.Stmt {
  let no_sugar: ast.MatchArm[] = [];
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: 0, col: 0, origin: "", sugar: no_sugar };
}

function s_match_at(scrutinee: ast.Expr, arms: ast.MatchArm[], line: i32, col: i32): ast.Stmt {
  let no_sugar: ast.MatchArm[] = [];
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: "", sugar: no_sugar };
}

function s_match_sugared(scrutinee: ast.Expr, arms: ast.MatchArm[], sugar: ast.MatchArm[], line: i32, col: i32): ast.Stmt {
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: "", sugar: sugar };
}

function array_builder_elem(t: string): string {
  let prefix: string = "ArrayBuilder[";
  let pl: i32 = prefix.len();
  if (t.len() < pl + 1) {
    return "";
  }
  if (t[t.len() - 1] != b']') {
    return "";
  }
  let i: i32 = 0;
  while (i < pl) {
    if (t[i] != prefix[i]) {
      return "";
    }
    i = i + 1;
  }
  return slice_unchecked(t, pl, t.len() - 1) + "";
}

function is_builder_mutation(c: ast.ExprCall, b: string): boolean {
  match (c.callee) {
    ast.ExprFieldAccess(fa) => {
      if (fa.field != "append" && fa.field != "with" && fa.field != "insert") {
        return false;
      }
      match (fa.obj) {
        ast.ExprIdent(id) => {
          return id.name == b;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

function rewrite_builder_stmt(s: ast.Stmt, b: string): ast.Stmt {
  match (s) {
    ast.StmtExpr(es) => {
      match (es.value) {
        ast.ExprCall(c) => {
          if (is_builder_mutation(c, b)) {
            return s_assign(b, es.value);
          }
          return s;
        },
        _ => {
          return s;
        }
      }
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: f.cond, then_body: rewrite_builder_stmts(f.then_body, b), else_body: rewrite_builder_stmts(f.else_body, b) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: w.cond, body: rewrite_builder_stmts(w.body, b), label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: rewrite_builder_stmts(fr.body, b), label: fr.label, line: fr.line, col: fr.col };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let ai: i32 = 0;
      while (ai < m.arms.len()) {
        let arm: ast.MatchArm = m.arms[ai];
        arms = arms.append(ast.MatchArm { ...arm, body: rewrite_builder_stmts(arm.body, b) });
        ai = ai + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: m.scrutinee, arms: arms };
    },
    _ => {
      return s;
    }
  }
  return s;
}

function rewrite_builder_stmts(stmts: ast.Stmt[], b: string): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(rewrite_builder_stmt(stmts[i], b));
    i = i + 1;
  }
  return out;
}

function maybe_desugar_array_build(base: ast.Expr): ast.Expr {
  match (base) {
    ast.ExprCall(call) => {
      match (call.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "build") {
            return base;
          }
          match (fa.obj) {
            ast.ExprIdent(id) => {
              if (id.name != "Array") {
                return base;
              }
              if (call.args.len() != 1) {
                return base;
              }
              match (call.args[0]) {
                ast.ExprLambda(lam) => {
                  if (lam.params.len() != 1) {
                    return base;
                  }
                  let elem: string = array_builder_elem(lam.params[0].type_name);
                  if (elem.len() == 0) {
                    return base;
                  }
                  let bname: string = lam.params[0].name;
                  let arrty: string = elem + "[]";
                  let stmts: ast.Stmt[] = [];
                  stmts = stmts.append(s_var(bname, arrty, e_array([])));
                  let rewritten: ast.Stmt[] = rewrite_builder_stmts(lam.body, bname);
                  let ri: i32 = 0;
                  while (ri < rewritten.len()) {
                    stmts = stmts.append(rewritten[ri]);
                    ri = ri + 1;
                  }
                  stmts = stmts.append(s_return(e_ident(bname)));
                  let iife: ast.Expr = ast.ExprLambda { params: [], ret_type: arrty, body: stmts, use_infer: false, origin: ORIGIN_ARR_COMP, line: 0, col: 0, captures: [], captures_known: false, ret_fn_ret: "", ret_fn_param_types: "" };
                  return ast.ExprCall { callee: iife, args: [], line: call.line, col: call.col, type_args: [], ty: "" };
                },
                _ => {
                  return base;
                }
              }
            },
            _ => {
              return base;
            }
          }
        },
        _ => {
          return base;
        }
      }
    },
    _ => {
      return base;
    }
  }
  return base;
}

function map_builder_inner(t: string): string {
  let prefix: string = "MapBuilder[";
  let pl: i32 = prefix.len();
  if (t.len() < pl + 1) {
    return "";
  }
  if (t[t.len() - 1] != b']') {
    return "";
  }
  let i: i32 = 0;
  while (i < pl) {
    if (t[i] != prefix[i]) {
      return "";
    }
    i = i + 1;
  }
  return slice_unchecked(t, pl, t.len() - 1) + "";
}

function maybe_desugar_map_build(base: ast.Expr): ast.Expr {
  match (base) {
    ast.ExprCall(call) => {
      match (call.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "build") {
            return base;
          }
          match (fa.obj) {
            ast.ExprIdent(id) => {
              if (id.name != "Map") {
                return base;
              }
              if (call.args.len() != 1) {
                return base;
              }
              match (call.args[0]) {
                ast.ExprLambda(lam) => {
                  if (lam.params.len() != 1) {
                    return base;
                  }
                  let inner: string = map_builder_inner(lam.params[0].type_name);
                  if (inner.len() == 0) {
                    return base;
                  }
                  let bname: string = lam.params[0].name;
                  let mapty: string = "Map[" + inner + "]";
                  let cargs: ast.Expr[] = [];
                  cargs = cargs.append(e_number("8", "", false));
                  let stmts: ast.Stmt[] = [];
                  stmts = stmts.append(s_var(bname, mapty, e_call(e_ident("map_new"), cargs)));
                  let rewritten: ast.Stmt[] = rewrite_builder_stmts(lam.body, bname);
                  let ri: i32 = 0;
                  while (ri < rewritten.len()) {
                    stmts = stmts.append(rewritten[ri]);
                    ri = ri + 1;
                  }
                  stmts = stmts.append(s_return(e_ident(bname)));
                  let iife: ast.Expr = ast.ExprLambda { params: [], ret_type: mapty, body: stmts, use_infer: false, origin: ORIGIN_MAP_COMP, line: 0, col: 0, captures: [], captures_known: false, ret_fn_ret: "", ret_fn_param_types: "" };
                  return ast.ExprCall { callee: iife, args: [], line: call.line, col: call.col, type_args: [], ty: "" };
                },
                _ => {
                  return base;
                }
              }
            },
            _ => {
              return base;
            }
          }
        },
        _ => {
          return base;
        }
      }
    },
    _ => {
      return base;
    }
  }
  return base;
}

function s_match_origin(scrutinee: ast.Expr, arms: ast.MatchArm[], line: i32, col: i32, origin: string): ast.Stmt {
  let no_sugar: ast.MatchArm[] = [];
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: origin, sugar: no_sugar };
}

function s_match_origin_sugared(scrutinee: ast.Expr, arms: ast.MatchArm[], sugar: ast.MatchArm[], line: i32, col: i32, origin: string): ast.Stmt {
  return ast.StmtMatch { scrutinee: scrutinee, arms: arms, line: line, col: col, origin: origin, sugar: sugar };
}

function p_variant(type_name: string, binding: string): ast.Pattern {
  let no_extra: string[] = [];
  let no_nested: ast.Pattern[] = [];
  let no_tup_kinds: i32[] = [];
  let no_tup_binds: string[] = [];
  let no_tup_lits: ast.Expr[] = [];
  let no_tup_pats: ast.Pattern[] = [];
  return ast.PatVariant { type_name: type_name, binding: binding, extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats, rest_written: false };
}

function p_variant_n(type_name: string, prefix: string, n: i32): ast.Pattern {
  if (n <= 0) {
    return p_variant(type_name, "");
  }
  let extra: string[] = [];
  let i: i32 = 1;
  while (i < n) {
    extra = extra.append(prefix + dl_itoa(i));
    i = i + 1;
  }
  let no_nested: ast.Pattern[] = [];
  let no_tup_kinds: i32[] = [];
  let no_tup_binds: string[] = [];
  let no_tup_lits: ast.Expr[] = [];
  let no_tup_pats: ast.Pattern[] = [];
  return ast.PatVariant { type_name: type_name, binding: prefix + "0", extra_bindings: extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats, rest_written: false };
}

function fold_lit_cond(pat: ast.Pattern, guard: ast.Expr, has_guard: boolean): (ast.Pattern, ast.Expr, boolean) {
  match (pat) {
    ast.PatVariant(pv) => {
      if (!pv.has_lit_cond) {
        return (pat, guard, has_guard);
      }
      let no_tup_kinds: i32[] = [];
      let no_tup_binds: string[] = [];
      let no_tup_lits: ast.Expr[] = [];
      let no_tup_pats: ast.Pattern[] = [];
      let cleared: ast.Pattern = ast.PatVariant { ...pv, lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
      if (!has_guard) {
        return (cleared, pv.lit_cond, true);
      }
      return (cleared, e_binary("&&", pv.lit_cond, guard), true);
    },
    _ => {
      return (pat, guard, has_guard);
    }
  }
}

function p_wildcard(): ast.Pattern {
  return ast.PatWildcard { tag: 0 };
}

function decl_sentinel(p: Par, text: string): ast.Stmt {
  return s_unknown(p, "decl:" + text);
}

function sync_to_top_level(p: Par): Par {
  let q: Par = p;
  while (!q.at_end() && !at_top_level_decl(q)) {
    q = q.advance();
  }
  return q;
}

function at_top_level_decl(p: Par): boolean {
  return util.has_str(["function", "struct", "enum", "import", "const", "trait", "impl", "pub"], p.peek_keyword());
}

function skip_body_item(p: Par): Par {
  let q: Par = p;
  let depth: i32 = 0;
  while (!q.at_end()) {
    let pc: string = q.peek_punct();
    if (depth == 0 && pc == "}") {
      return q;
    }
    if (depth == 0 && pc == ";") {
      return q.advance();
    }
    if (pc == "{") {
      depth = depth + 1;
    }
    if (pc == "}") {
      depth = depth - 1;
      if (depth == 0) {
        return q.advance();
      }
    }
    q = q.advance();
  }
  return q;
}

pub function malformed_fn_decl_message(): string {
  return "malformed function declaration: its name or signature could not be read (a keyword such as `use`, `type` or `match` cannot be a name)";
}

function s_unknown(p: Par, kind: string): ast.Stmt {
  return s_unknown_at(kind, p.peek_line(), p.peek_col());
}

function s_unknown_at(kind: string, line: i32, col: i32): ast.Stmt {
  return ast.StmtUnknown { kind: kind, line: line, col: col };
}

function tok_spelling(t: lexer.Token): string {
  match (t) {
    lexer.TokPunct(x) => {
      return x.text;
    },
    lexer.TokIdent(x) => {
      return x.name;
    },
    lexer.TokKeyword(x) => {
      return x.name;
    },
    lexer.TokNumber(x) => {
      return x.text;
    },
    lexer.TokString(x) => {
      return x.value;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function tok_desc(t: lexer.Token): string {
  if let lexer.TokEof(_) = t {
    return "the end of the file";
  }
  return "\"" + tok_spelling(t) + "\"";
}

function defer_action(st: ast.Stmt, p: Par): ast.Stmt {
  if let ast.StmtExpr(_) = st {
    return st;
  }
  if let ast.StmtAssign(_) = st {
    return st;
  }
  if let ast.StmtUnknown(_) = st {
    return st;
  }
  if let ast.StmtIf(f) = st {
    if (f.origin == "block" || f.origin == ORIGIN_ASSERT) {
      return st;
    }
  }
  return decl_sentinel(p, "expected an expression, got " + tok_desc(p.peek()));
}

function s_defer(action: ast.Stmt): ast.Stmt {
  return ast.StmtDefer { action: action, on_error: 0, line: 0 };
}

function s_errdefer(action: ast.Stmt): ast.Stmt {
  return ast.StmtDefer { action: action, on_error: 1, line: 0 };
}

function label_depth(labels: string[], name: string): i32 {
  let i: i32 = labels.len() - 1;
  while (i >= 0) {
    if (labels[i] == name) {
      return labels.len() - 1 - i;
    }
    i = i - 1;
  }
  return 0 - 1;
}

function resolve_labels_stmt(st: ast.Stmt, labels: string[]): ast.Stmt {
  match (st) {
    ast.StmtBreak(b) => {
      if (b.label.len() == 0) {
        return st;
      }
      let d: i32 = label_depth(labels, b.label);
      if (d < 0) {
        d = 0;
      }
      return ast.StmtBreak { tag: d, line: b.line, col: b.col, label: b.label };
    },
    ast.StmtContinue(c) => {
      if (c.label.len() == 0) {
        return st;
      }
      let d2: i32 = label_depth(labels, c.label);
      if (d2 < 0) {
        d2 = 0;
      }
      return ast.StmtContinue { tag: d2, line: c.line, col: c.col, label: c.label };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: rl_expr(w.cond, labels), body: resolve_labels_block(w.body, labels.append(w.label)), label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: rl_expr(fr.iter, labels), body: resolve_labels_block(fr.body, labels.append(fr.label)), label: fr.label, line: fr.line, col: fr.col };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: rl_expr(f.cond, labels), then_body: resolve_labels_block(f.then_body, labels), else_body: resolve_labels_block(f.else_body, labels) };
    },
    ast.StmtMatch(m) => {
      let arms2: ast.MatchArm[] = [];
      let ai: i32 = 0;
      while (ai < m.arms.len()) {
        let a: ast.MatchArm = m.arms[ai];
        let ag: ast.Expr = a.guard;
        if (a.has_guard) {
          ag = rl_expr(a.guard, labels);
        }
        arms2 = arms2.append(ast.MatchArm { ...a, body: resolve_labels_block(a.body, labels), guard: ag });
        ai = ai + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: rl_expr(m.scrutinee, labels), arms: arms2 };
    },
    ast.StmtDefer(dd) => {
      return ast.StmtDefer { action: resolve_labels_stmt(dd.action, labels), on_error: dd.on_error, line: dd.line };
    },
    ast.StmtVar(v) => {
      return ast.StmtVar { ...v, init: rl_expr(v.init, labels) };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: rl_expr(r.value, labels) };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: rl_expr(x.value, labels) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: rl_expr(a.value, labels) };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function rl_expr(e: ast.Expr, labels: string[]): ast.Expr {
  match (e) {
    ast.ExprLambda(lm) => {
      let fresh: string[] = [];
      return ast.ExprLambda { ...lm, body: resolve_labels_block(lm.body, fresh) };
    },
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        return dl_vb_rebuild(c, resolve_labels_block(vb_body(c), labels));
      }
      return rl_expr_kids(e, labels);
    },
    _ => {
      return rl_expr_kids(e, labels);
    }
  }
  return e;
}

function rl_expr_kids(e: ast.Expr, labels: string[]): ast.Expr {
  return map_expr_kids(e, (k: ast.Expr): ast.Expr => rl_expr(k, labels));
}

function resolve_labels_block(stmts: ast.Stmt[], labels: string[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(resolve_labels_stmt(stmts[i], labels));
    i = i + 1;
  }
  return out;
}

pub function resolve_labels_module(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  let none: string[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    if (has_labeled_jump(fd.body)) {
      fd = FuncDecl { ...fd, body: resolve_labels_block(fd.body, none) };
    }
    funcs = funcs.append(fd);
    i = i + 1;
  }
  return Module { ...mod, funcs: funcs, top_stmts: resolve_labels_block(mod.top_stmts, none) };
}

function has_labeled_jump(stmts: ast.Stmt[]): boolean {
  let found: boolean = false;
  for st in stmts {
    found = astwalk.fold_stmt_nodes(st, found, labeled_jump_at, keep_flag, astwalk.descend_all);
  }
  return found;
}

function labeled_jump_at(st: ast.Stmt, own acc: boolean): boolean {
  if let ast.StmtBreak(b) = st {
    return acc || b.label.len() > 0;
  }
  if let ast.StmtContinue(c) = st {
    return acc || c.label.len() > 0;
  }
  return acc;
}

function keep_flag(e: ast.Expr, own acc: boolean): boolean {
  return acc;
}

struct Par { toks: lexer.Token[], pos: i32, no_struct: boolean, map_kind: i32, structnames: string[], verbatim: boolean, depth: i32, type_errs: ast.Stmt[], todos: TodoSite[], tail_at: i32[], tail_is: boolean[] }

function scan_struct_names(toks: lexer.Token[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < toks.len()) {
    match (toks[i]) {
      lexer.TokEof(_) => {
        return out;
      },
      lexer.TokKeyword(k) => {
        if (k.name == "struct" && i + 1 < toks.len()) {
          if let lexer.TokIdent(id) = toks[i + 1] {
            if (id.name.len() > 0) {
              out = out.append(id.name);
              i = i + 1;
            }
          }
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return out;
}

function (p: Par) at_end(): boolean {
  if (p.pos >= p.toks.len()) {
    return true;
  }
  let t: lexer.Token = p.toks[p.pos];
  match (t) {
    lexer.TokEof(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function (p: Par) peek(): lexer.Token {
  if (p.pos < p.toks.len()) {
    return p.toks[p.pos];
  }
  return lexer.eof_tok(0, 0);
}

function (p: Par) peek_line(): i32 {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokEof(x) => {
      return x.line;
    },
    lexer.TokNumber(x) => {
      return x.line;
    },
    lexer.TokIdent(x) => {
      return x.line;
    },
    lexer.TokKeyword(x) => {
      return x.line;
    },
    lexer.TokPunct(x) => {
      return x.line;
    },
    lexer.TokString(x) => {
      return x.line;
    },
    lexer.TokError(x) => {
      return x.line;
    },
    lexer.TokFString(x) => {
      return x.line;
    }
  }
  return 0;
}

function (p: Par) peek_col(): i32 {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokEof(x) => {
      return x.col;
    },
    lexer.TokNumber(x) => {
      return x.col;
    },
    lexer.TokIdent(x) => {
      return x.col;
    },
    lexer.TokKeyword(x) => {
      return x.col;
    },
    lexer.TokPunct(x) => {
      return x.col;
    },
    lexer.TokString(x) => {
      return x.col;
    },
    lexer.TokError(x) => {
      return x.col;
    },
    lexer.TokFString(x) => {
      return x.col;
    }
  }
  return 0;
}

function (p: Par) advance(): Par {
  return Par { toks: p.toks, pos: p.pos + 1, no_struct: p.no_struct, map_kind: p.map_kind, structnames: p.structnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos, tail_at: p.tail_at, tail_is: p.tail_is };
}

function (p: Par) expected_type(): Par {
  return Par { ...p, type_errs: p.type_errs.append(s_unknown(p, "decl:expected a type, got " + tok_desc(p.peek()))) };
}

function (p: Par) refused_type(msg: string): Par {
  return Par { ...p, type_errs: p.type_errs.append(s_unknown(p, "decl:" + msg)) };
}

function unit_type_message(): string {
  return "`()` is not a type; the unit type is written `void`";
}

function at_float_type(p: Par, seg: string): boolean {
  if (seg != "float" || p.peek_punct_at(1) == ".") {
    return false;
  }
  if (p.pos == 0) {
    return true;
  }
  let prev: string = tok_spelling(p.toks[p.pos - 1]);
  if (prev == "|" || prev == "=" && p.peek_punct_at(1) == "|") {
    return false;
  }
  return !util.has_str([".", "dyn", "+", "own", "borrow", "impl"], prev);
}

function float_type_message(): string {
  return "`float` is not a type; the 64-bit float is written `f64`";
}

function (p: Par) handle_word_misuse(word: string): Par {
  return Par { ...p, type_errs: p.type_errs.append(s_unknown(p, "decl:" + handle_word_misuse_message(word))) };
}

function handle_word_misuse_message(word: string): string {
  if (word == "own") {
    return "`own` in a type must be followed by a resource name (`own R` for a `resource R`); a consuming parameter is written `own name: T`";
  }
  return "`borrow` in a type must be followed by a resource name (`borrow R` for a `resource R`); a parameter borrows by default, written `name: T`";
}

function (p: Par) expect_semi(): Par {
  if (p.peek_punct() == ";") {
    return p.advance();
  }
  if (p.pos > 0 && tok_spelling(p.toks[p.pos - 1]) == ";" || p.peek_punct() == ")" || p.peek_punct() == "]") {
    return p;
  }
  return Par { ...p, type_errs: p.type_errs.append(s_unknown(p, "decl:expected \";\", got " + tok_desc(p.peek()))) };
}

function (p: Par) expect(t: string): Par {
  if (p.peek_punct() == t || p.peek_keyword() == t) {
    return p.advance();
  }
  if (p.at_end()) {
    return p;
  }
  return Par { ...p, type_errs: p.type_errs.append(s_unknown(p, "decl:expected \"" + t + "\", got " + tok_desc(p.peek()))) };
}

function (p: Par) reported_at(line: i32, col: i32): boolean {
  if (p.type_errs.len() == 0) {
    return false;
  }
  if let ast.StmtUnknown(u) = p.type_errs[p.type_errs.len() - 1] {
    return u.line == line && u.col == col;
  }
  return false;
}

function missing_close(kind: string, closer: string, parts: ast.Expr[], p: Par): (ast.Expr, Par) {
  let at: ast.Expr = e_unknown_at(kind, p.peek_line(), p.peek_col());
  for e in parts {
    if (holds_sentinel(e)) {
      at = e;
      break;
    }
  }
  return (at, p.skip_to_close(closer));
}

function (p: Par) paren_then_in(): boolean {
  let depth: i32 = 0;
  while (!p.at_end()) {
    let pc: string = p.peek_punct();
    if (pc == "(" || pc == "[" || pc == "{") {
      depth = depth + 1;
    } else if (pc == ")" || pc == "]" || pc == "}") {
      depth = depth - 1;
      if (depth == 0) {
        return p.advance().peek_ident() == "in";
      }
    }
    p = p.advance();
  }
  return false;
}

function (p: Par) skip_to_open(): Par {
  let q: Par = p;
  let depth: i32 = 0;
  while (!q.at_end()) {
    let pc: string = q.peek_punct();
    if (depth == 0 && pc == "{") {
      return q;
    }
    if (depth == 0 && (pc == ";" || pc == "}" || pc == ")" || pc == "]")) {
      return p;
    }
    if (pc == "(" || pc == "[") {
      depth = depth + 1;
    } else if (pc == ")" || pc == "]") {
      depth = depth - 1;
    }
    q = q.advance();
  }
  return p;
}

function (p: Par) skip_to_close(closer: string): Par {
  let depth: i32 = 0;
  while (!p.at_end()) {
    let pc: string = p.peek_punct();
    if (depth == 0 && pc == closer) {
      return p.advance();
    }
    if (depth == 0 && pc == ";") {
      break;
    }
    if (pc == "(" || pc == "[" || pc == "{") {
      depth = depth + 1;
    } else if (pc == ")" || pc == "]" || pc == "}") {
      if (depth == 0) {
        break;
      }
      depth = depth - 1;
    }
    p = p.advance();
  }
  return p;
}

function (p: Par) end_of(e: ast.Expr): Par {
  if let ast.ExprUnknown(_) = e {
    if (p.peek_punct() == ";") {
      return p.advance();
    }
    return p;
  }
  return p.expect_semi();
}

function (p: Par) with_no_struct(v: boolean): Par {
  return Par { toks: p.toks, pos: p.pos, no_struct: v, map_kind: p.map_kind, structnames: p.structnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos, tail_at: p.tail_at, tail_is: p.tail_is };
}

function (p: Par) with_map_kind(v: i32): Par {
  return Par { toks: p.toks, pos: p.pos, no_struct: p.no_struct, map_kind: v, structnames: p.structnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos, tail_at: p.tail_at, tail_is: p.tail_is };
}

pub const MAX_NEST_DEPTH: i32 = 5000;

pub const BLOCK_VALUE_REQUIRED_MESSAGE: string = "block-expression has no trailing value (its last element is a `;`-terminated statement); a value is required here — drop the trailing `;` to make the final expression the block's value";

const BLOCK_NEST_UNITS: i32 = 8;

function (p: Par) with_depth(v: i32): Par {
  return Par { toks: p.toks, pos: p.pos, no_struct: p.no_struct, map_kind: p.map_kind, structnames: p.structnames, verbatim: p.verbatim, depth: v, type_errs: p.type_errs, todos: p.todos, tail_at: p.tail_at, tail_is: p.tail_is };
}

function (p: Par) too_deep(): boolean {
  return p.too_deep_by(1);
}

function (p: Par) too_deep_by(units: i32): boolean {
  return p.depth + units > MAX_NEST_DEPTH;
}

function (p: Par) bail(): Par {
  let last: i32 = p.toks.len() - 1;
  if (last < p.pos) {
    last = p.pos;
  }
  return Par { toks: p.toks, pos: last, no_struct: p.no_struct, map_kind: p.map_kind, structnames: p.structnames, verbatim: p.verbatim, depth: p.depth, type_errs: p.type_errs, todos: p.todos, tail_at: p.tail_at, tail_is: p.tail_is };
}

function (p: Par) peek_punct(): string {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokPunct(x) => {
      return x.text;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function consume_pub_package(p: Par): (boolean, Par) {
  if (p.peek_punct() != "(") {
    return (false, p);
  }
  let q: Par = p.advance();
  if (q.peek_ident() != "package") {
    return (false, p);
  }
  q = q.advance();
  if (q.peek_punct() != ")") {
    return (false, p);
  }
  return (true, q.advance());
}

function (p: Par) peek_keyword(): string {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokKeyword(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function (p: Par) more_elems(close: string): (boolean, Par) {
  if (p.peek_punct() != ",") {
    return (false, p);
  }
  let q: Par = p.advance();
  return (q.peek_punct() != close, q);
}

function (p: Par) peek2_punct(): string {
  if (p.pos + 1 < p.toks.len()) {
    let t: lexer.Token = p.toks[p.pos + 1];
    match (t) {
      lexer.TokPunct(x) => {
        return x.text;
      },
      _ => {
        return "";
      }
    }
  }
  return "";
}

function (p: Par) peek_ident(): string {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokIdent(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function (p: Par) peek_punct_at(k: i32): string {
  if (p.pos + k < p.toks.len()) {
    let t: lexer.Token = p.toks[p.pos + k];
    match (t) {
      lexer.TokPunct(x) => {
        return x.text;
      },
      _ => {
        return "";
      }
    }
  }
  return "";
}

function (p: Par) peek_ident_at(k: i32): string {
  if (p.pos + k < p.toks.len()) {
    let t: lexer.Token = p.toks[p.pos + k];
    match (t) {
      lexer.TokIdent(x) => {
        return x.name;
      },
      _ => {
        return "";
      }
    }
  }
  return "";
}

function (p: Par) peek_number_text(): string {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokNumber(x) => {
      return x.text;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function (p: Par) peek_const_arg(): string {
  if let lexer.TokNumber(x) = p.peek() {
    if (x.is_float || x.suffix.len() > 0) {
      return "";
    }
    if (p.verbatim && x.raw.len() > 0) {
      return x.raw;
    }
    if (p.verbatim) {
      return x.text;
    }
    return const_arg_text(x.text);
  }
  return "";
}

function (p: Par) peek_is_literal(): boolean {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokNumber(x) => {
      return true;
    },
    lexer.TokString(x) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function (p: Par) peek_at_literal(): boolean {
  if (p.peek_ident().len() == 0 || p.peek2_punct() != "@") {
    return false;
  }
  return p.advance().advance().peek_is_pat_literal();
}

function take_at_binding(p: Par): (string, Par) {
  if (!p.peek_at_literal()) {
    return ("", p);
  }
  let name: string = p.peek_ident();
  return (name, p.advance().advance());
}

function (p: Par) peek_is_pat_literal(): boolean {
  if (p.peek_is_literal()) {
    return true;
  }
  if (p.peek_keyword() == "true" || p.peek_keyword() == "false") {
    return true;
  }
  if (p.peek_punct() != "-") {
    return false;
  }
  if (p.pos + 1 < p.toks.len()) {
    let t: lexer.Token = p.toks[p.pos + 1];
    match (t) {
      lexer.TokNumber(x) => {
        return true;
      },
      _ => {
        return false;
      }
    }
  }
  return false;
}

function (p: Par) punct_at(idx: i32): string {
  if (idx < 0 || idx >= p.toks.len()) {
    return "";
  }
  let t: lexer.Token = p.toks[idx];
  match (t) {
    lexer.TokPunct(x) => {
      return x.text;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function (p: Par) ident_at(idx: i32): string {
  if (idx < 0 || idx >= p.toks.len()) {
    return "";
  }
  let t: lexer.Token = p.toks[idx];
  match (t) {
    lexer.TokIdent(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function (p: Par) keyword_at(idx: i32): string {
  if (idx < 0 || idx >= p.toks.len()) {
    return "";
  }
  let t: lexer.Token = p.toks[idx];
  match (t) {
    lexer.TokKeyword(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function (p: Par) if_stmt_has_else(): boolean {
  let i: i32 = p.pos + 1;
  if (p.punct_at(i) == "(") {
    let depth: i32 = 0;
    while (i < p.toks.len()) {
      let pt: string = p.punct_at(i);
      if (pt == "(") {
        depth = depth + 1;
      } else if (pt == ")") {
        depth = depth - 1;
        if (depth == 0) {
          i = i + 1;
          break;
        }
      }
      i = i + 1;
    }
  }
  if (p.punct_at(i) == "{") {
    let bdepth: i32 = 0;
    while (i < p.toks.len()) {
      let bt: string = p.punct_at(i);
      if (bt == "{") {
        bdepth = bdepth + 1;
      } else if (bt == "}") {
        bdepth = bdepth - 1;
        if (bdepth == 0) {
          i = i + 1;
          break;
        }
      }
      i = i + 1;
    }
  }
  return p.keyword_at(i) == "else";
}

function (p: Par) closer_followed_by(idx: i32, open: string, close: string, want_a: string, want_b: string): boolean {
  let depth: i32 = 0;
  let j: i32 = idx;
  while (j < p.toks.len()) {
    let t: string = p.punct_at(j);
    if (t == open) {
      depth = depth + 1;
    } else if (t == close) {
      depth = depth - 1;
      if (depth == 0) {
        let aft: string = p.punct_at(j + 1);
        if (aft.len() == 0) {
          return false;
        }
        return aft == want_a || want_b.len() > 0 && aft == want_b;
      }
    }
    j = j + 1;
  }
  return false;
}

function (p: Par) first_param_looks_typed(idx0: i32): boolean {
  let idx: i32 = idx0;
  if (p.ident_at(idx).len() > 0 && p.punct_at(idx + 1) == "@") {
    idx = idx + 2;
  }
  if (p.ident_at(idx) == "own" && p.ident_at(idx + 1).len() > 0) {
    idx = idx + 1;
  }
  if (p.punct_at(idx) == "(") {
    return p.closer_followed_by(idx, "(", ")", ":", "=>");
  }
  let brace: i32 = record_pattern_brace_at(p, idx);
  if (brace >= 0) {
    return p.closer_followed_by(brace, "{", "}", ":", "");
  }
  return p.ident_at(idx).len() > 0 && p.punct_at(idx + 1) == ":";
}

function (p: Par) arrow_lambda_at(): boolean {
  let open: i32 = p.pos;
  if (p.punct_at(open + 1) == ")") {
    let after: string = p.punct_at(open + 2);
    return after == "=>" || after == ":";
  }
  if (!p.first_param_looks_typed(open + 1)) {
    return false;
  }
  return p.closer_followed_by(open, "(", ")", "=>", ":");
}

function parse_arrow_lambda(p: Par): (ast.Expr, Par) {
  let lam_line: i32 = p.peek_line();
  let lam_col: i32 = p.peek_col();
  p = p.advance();
  let params: ast.ParamDecl[] = [];
  let apd: ParamDestr[] = [];
  if (p.peek_punct() != ")") {
    while (true) {
      if (at_pattern_head(p)) {
        let (atpr_param, atpr_destr, atpr_p) = parse_pattern_param(p);
        p = atpr_p;
        if (atpr_destr.names.len() == 0) {
          return (e_unknown_at("lambda: bad destructuring param", p.peek_line(), p.peek_col()), p);
        }
        params = params.append(atpr_param);
        apd = apd.append(atpr_destr);
        if (p.peek_punct() == ",") {
          p = p.advance();
          if (p.peek_punct() == ")") {
            break;
          }
          continue;
        }
        break;
      }
      let (pr_param, pr_p) = parse_param(p, params.len());
      p = pr_p;
      params = params.append(pr_param);
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == ")") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  let ret_type: string = "";
  let lam_fn_ret: string = "";
  let lam_fn_ptys: string = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    let saved: Par = p;
    let (rtr_name, rtr_fn_ret, rtr_p) = parse_type_name(p);
    if (rtr_p.peek_punct() == "=>") {
      p = rtr_p;
      ret_type = rtr_name;
      let (gw, gwr, gwe) = parse_type_name(Par { ...saved, verbatim: true });
      let (g_ret, g_ptys) = fn_contract_of(rtr_name, gw);
      lam_fn_ret = g_ret;
      lam_fn_ptys = g_ptys;
    } else {
      let (ra_name, ra_fn_ret, ra_p) = parse_type_name_reserving_arrow(saved);
      p = ra_p;
      ret_type = ra_name;
      let (rw, rwr, rwe) = parse_type_name_reserving_arrow(Par { ...saved, verbatim: true });
      let (r_ret, r_ptys) = fn_contract_of(ra_name, rw);
      lam_fn_ret = r_ret;
      lam_fn_ptys = r_ptys;
    }
  }
  if (p.peek_punct() == "=>") {
    p = p.advance();
  }
  let body: ast.Stmt[] = [];
  if (p.peek_punct() == "{") {
    let (lb_body, lb_p) = parse_lambda_body(p);
    p = lb_p;
    body = lb_body;
  } else {
    let (ber_expr, ber_p) = parse_expr(p);
    p = ber_p;
    body = [s_return(ber_expr)];
  }
  body = prepend_param_destrs(body, apd);
  return parse_postfix(p, e_lambda_at(params, ret_type, body, "", lam_line, lam_col, lam_fn_ret, lam_fn_ptys));
}

function map_key_kind_of_expr(e: ast.Expr): i32 {
  match (e) {
    ast.ExprNumber(_) => {
      return 1;
    },
    ast.ExprString(_) => {
      return 0;
    },
    ast.ExprBool(_) => {
      return 1;
    },
    ast.ExprBinary(b) => {
      return map_key_kind_of_expr(b.left);
    },
    ast.ExprUnary(u) => {
      if (is_cast_op(u.op)) {
        if (slice_unchecked(u.op, 3, u.op.len()) == "string") {
          return 0;
        }
        return 1;
      }
      return map_key_kind_of_expr(u.operand);
    },
    _ => {
      return 0 - 1;
    }
  }
  return 0 - 1;
}

function parse_map_lit(p: Par): (ast.Expr, Par) {
  let want_kk: i32 = p.map_kind;
  let mline: i32 = p.peek_line();
  let mcol: i32 = p.peek_col();
  p = p.with_map_kind(0 - 1).advance();
  let mlk: ast.Expr[] = [];
  let mlv: ast.Expr[] = [];
  if (p.peek_punct() != "}") {
    while (true) {
      let (mke_expr, mke_p) = parse_expr(p);
      p = mke_p;
      if (p.peek_punct() == ":") {
        p = p.advance();
      }
      let (mve_expr, mve_p) = parse_expr(p);
      p = mve_p;
      mlk = mlk.append(mke_expr);
      mlv = mlv.append(mve_expr);
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == "}") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  if (p.verbatim) {
    return parse_postfix(p, ast.ExprMapLit { keys: mlk, vals: mlv, line: mline, col: mcol });
  }
  let kk: i32 = want_kk;
  let kki: i32 = 0;
  while (kki < mlk.len()) {
    if (kk < 0) {
      kk = map_key_kind_of_expr(mlk[kki]);
    }
    kki = kki + 1;
  }
  let ctor: string = if (kk == 1) { "__map_new_i32" } else { "map_new" };
  let cargs: ast.Expr[] = [];
  cargs = cargs.append(e_number("8", "", false));
  let mbase: ast.Expr = e_call_at(e_ident(ctor), cargs, mline, mcol);
  let mpi: i32 = 0;
  while (mpi < mlk.len()) {
    let sargs: ast.Expr[] = [];
    sargs = sargs.append(mlk[mpi]);
    sargs = sargs.append(mlv[mpi]);
    mbase = e_call(e_field_access(mbase, "insert"), sargs);
    mpi = mpi + 1;
  }
  return parse_postfix(p, mbase);
}

function map_ann_key_kind(t: string): i32 {
  if (t.len() < 5 || slice_unchecked(t, 0, 4) != "Map[") {
    return 0 - 1;
  }
  let inner: str = slice_unchecked(t, 4, t.len());
  if (inner.len() >= 4 && slice_unchecked(inner, 0, 4) == "i32,") {
    return 1;
  }
  if (inner.len() >= 7 && slice_unchecked(inner, 0, 7) == "string,") {
    return 0;
  }
  return 0 - 1;
}

function parse_struct_lit_body(p: Par, type_name: string, sline: i32, scol: i32): (ast.Expr, Par) {
  p = p.advance();
  let fnames: string[] = [];
  let flines: i32[] = [];
  let fcols: i32[] = [];
  let fvals: ast.Expr[] = [];
  let has_base: boolean = false;
  let base: ast.Expr = e_unknown("no-base");
  if (p.peek_punct() == "...") {
    p = p.advance();
    let (br_expr, br_p) = parse_expr(p);
    p = br_p;
    has_base = true;
    base = br_expr;
    if (p.peek_punct() == ",") {
      p = p.advance();
    } else {
      if (p.peek_punct() != "}") {
        return missing_close("missing } in struct update", "}", [base], p);
      }
      p = p.advance();
      return (e_struct_update(type_name, fnames, flines, fcols, fvals, base, sline, scol), p);
    }
  }
  if (p.peek_punct() != "}") {
    while (true) {
      let fn: string = p.peek_ident();
      if (fn.len() == 0) {
        return (e_unknown_at("missing field name in struct lit", p.peek_line(), p.peek_col()), p.skip_to_close("}"));
      }
      flines = flines.append(p.peek_line());
      fcols = fcols.append(p.peek_col());
      p = p.advance();
      if (p.peek_punct() != ":") {
        return (e_unknown_at("missing : in struct lit", p.peek_line(), p.peek_col()), p.skip_to_close("}"));
      }
      p = p.advance();
      let (fv_expr, fv_p) = parse_expr(p);
      p = fv_p;
      fnames = fnames.append(fn);
      fvals = fvals.append(fv_expr);
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == "}") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() != "}") {
    let parts: ast.Expr[] = fvals;
    if (has_base) {
      parts = [base];
      for v in fvals {
        parts = parts.append(v);
      }
    }
    return missing_close("missing } in struct lit", "}", parts, p);
  }
  p = p.advance();
  if (has_base) {
    return (e_struct_update(type_name, fnames, flines, fcols, fvals, base, sline, scol), p);
  }
  return (e_struct_lit(type_name, fnames, flines, fcols, fvals, sline, scol), p);
}

function scan_written_type_args(p: Par): (string, i32, Par) {
  let out: string = "";
  let n: i32 = 0;
  while (true) {
    let tn: string = p.peek_const_arg();
    if (tn.len() > 0) {
      p = p.advance();
    } else {
      let (written, written_fnret, written_p) = parse_type_name(p);
      if (written.len() == 0) {
        return ("", 0, p);
      }
      tn = written;
      p = written_p;
    }
    if (n > 0) {
      out = out + ", ";
    }
    out = out + tn;
    n = n + 1;
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() != "]") {
    return ("", 0, p);
  }
  return (out, n, p);
}

function written_type_arg_list(text: string, scanned: i32, count: i32): string[] {
  if (scanned == count) {
    return split_top_commas(text);
  }
  let out: string[] = [];
  let i: i32 = 0;
  while (i < count) {
    out = out.append("");
    i = i + 1;
  }
  return out;
}

function type_shaped_bracket(p: Par): boolean {
  let named: boolean = p.peek_ident().len() > 0 || p.peek_const_arg().len() > 0;
  if (!named && p.peek_punct() != "(") {
    return false;
  }
  let shaped: boolean = false;
  let depth: i32 = 1;
  let parens: i32 = 0;
  let j: i32 = 0;
  while (p.pos + j < p.toks.len()) {
    let pk: string = p.peek_punct_at(j);
    if (pk == "[") {
      depth = depth + 1;
      if (is_type_keyword_tok(p, j + 1) || p.peek_punct_at(j + 1) == "]") {
        shaped = true;
      }
    } else if (pk == "," && depth == 1 && parens == 0 || pk == "=>" && depth == 1) {
      shaped = true;
    } else if (pk == "{") {
      return false;
    } else if (pk == "(") {
      let prev: string = p.peek_punct_at(j - 1);
      if (prev.len() == 0 || prev == "]" || prev == ")") {
        return false;
      }
      parens = parens + 1;
      if (is_type_keyword_tok(p, j + 1)) {
        shaped = true;
      }
    } else if (pk == ")") {
      parens = parens - 1;
    } else if (pk == "]") {
      depth = depth - 1;
      if (depth == 0) {
        let after: string = p.peek_punct_at(j + 1);
        return shaped && after == "(" || named && after == "{" && !p.no_struct;
      }
    }
    j = j + 1;
  }
  return false;
}

function is_type_keyword_tok(p: Par, k: i32): boolean {
  if (p.pos + k >= p.toks.len()) {
    return false;
  }
  if let lexer.TokKeyword(kw) = p.toks[p.pos + k] {
    return kw.name == "i32" || kw.name == "i64" || kw.name == "u8" || kw.name == "u32" || kw.name == "u64" || kw.name == "usize" || kw.name == "f32" || kw.name == "f64" || typeinfo.lanes_width(kw.name) > 0 || kw.name == "string" || kw.name == "boolean" || kw.name == "void";
  }
  return false;
}

function with_written_type_args(callee: ast.Expr, args: string): ast.Expr {
  match (callee) {
    ast.ExprIdent(id) => {
      return ast.ExprIdent { name: id.name + "[" + args + "]", line: id.line, col: id.col, ty: id.ty };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, field: fa.field + "[" + args + "]" };
    },
    _ => {
      return callee;
    }
  }
  return callee;
}

function parse_postfix(p: Par, base: ast.Expr): (ast.Expr, Par) {
  let pending_type_arg_list: string[] = [];
  let pending_type_line: i32 = 0;
  let pending_type_col: i32 = 0;
  let pending_type_args: string = "";
  let path_sep_line: i32 = 0;
  let path_sep_col: i32 = 0;
  while (true) {
    let pk: string = p.peek_punct();
    if (pk == "(") {
      let oline: i32 = p.peek_line();
      let ocol: i32 = p.peek_col();
      if (pending_type_arg_list.len() > 0) {
        oline = pending_type_line;
        ocol = pending_type_col;
      }
      p = p.advance();
      let args: ast.Expr[] = [];
      if (p.peek_punct() != ")") {
        while (true) {
          let an: string = p.peek_ident();
          if (an.len() > 0 && p.peek2_punct() == "=") {
            let aline: i32 = p.peek_line();
            let acol: i32 = p.peek_col();
            p = p.advance();
            p = p.advance();
            let (rv_expr, rv_p) = parse_expr(p);
            p = rv_p;
            args = args.append(ast.ExprBinary { op: "__named_arg", left: ast.ExprIdent { name: an, line: aline, col: acol, ty: "" }, right: rv_expr, line: aline, col: acol, ty: "" });
          } else {
            let (ra_expr, ra_p) = parse_expr(p);
            p = ra_p;
            args = args.append(ra_expr);
          }
          let (ca_more, ca_p) = p.more_elems(")");
          p = ca_p;
          if (ca_more) {
            continue;
          }
          break;
        }
      }
      if (p.peek_punct() != ")") {
        return missing_close("missing ) in call", ")", args, p);
      }
      p = p.advance();
      if (pending_type_args.len() > 0) {
        base = with_written_type_args(base, pending_type_args);
      }
      base = ast.ExprCall { callee: base, args: args, line: oline, col: ocol, type_args: pending_type_arg_list, ty: "" };
      base = maybe_desugar_array_build(base);
      base = maybe_desugar_map_build(base);
      pending_type_arg_list = [];
      pending_type_args = "";
    } else if (pk == "[") {
      let bline: i32 = p.peek_line();
      let bcol: i32 = p.peek_col();
      p = p.advance();
      if (p.peek_punct() == ":") {
        p = p.advance();
        if (p.peek_punct() == "]") {
          p = p.advance();
          base = e_slice_all(base, bline, bcol);
          continue;
        }
        let (shi_expr, shi_p) = parse_expr(p);
        p = shi_p;
        if (p.peek_punct() != "]") {
          return missing_close("missing ] in slice", "]", [shi_expr], p);
        }
        p = p.advance();
        base = e_slice_from_start(base, shi_expr, bline, bcol);
        continue;
      }
      let idxStart: i32 = p.pos;
      let (idx_expr, idx_p) = parse_expr(p);
      if (type_shaped_bracket(p)) {
        idx_p = p;
      }
      if (idx_p.pos == idxStart) {
        let (wta_text, wta_n, wta_p) = scan_written_type_args(p);
        let written_args: string = "";
        if (wta_n > 0) {
          written_args = wta_text;
        }
        if (p.verbatim && wta_n > 0) {
          pending_type_args = wta_text;
          pending_type_arg_list = split_top_commas(wta_text);
          p = wta_p;
        }
        let ta_depth: i32 = 0;
        let ta_saw: boolean = false;
        let ta_commas: i32 = 0;
        let ta_trailing: boolean = false;
        while (!p.at_end()) {
          let tp2: string = p.peek_punct();
          if (tp2 == "]" && ta_depth == 0) {
            break;
          }
          if (tp2 == "[" || tp2 == "(") {
            ta_depth = ta_depth + 1;
          }
          if (tp2 == "]" || tp2 == ")") {
            ta_depth = ta_depth - 1;
          }
          if (tp2 == "," && ta_depth == 0) {
            ta_commas = ta_commas + 1;
            ta_trailing = true;
          } else {
            ta_trailing = false;
          }
          ta_saw = true;
          p = p.advance();
        }
        if (ta_trailing) {
          ta_commas = ta_commas - 1;
        }
        if (ta_saw) {
          pending_type_arg_list = written_type_arg_list(wta_text, wta_n, ta_commas + 1);
          pending_type_line = bline;
          pending_type_col = bcol;
        }
        if (p.peek_punct() == "]") {
          p = p.advance();
        }
        let ta_after: string = p.peek_punct();
        if (ta_after != "(" && (ta_after != "{" || p.no_struct)) {
          base = e_index(base, idx_expr, bline, bcol);
          pending_type_arg_list = [];
          pending_type_args = "";
          continue;
        }
        if (ta_after == "{") {
          match (base) {
            ast.ExprIdent(bid) => {
              let glit_name: string = bid.name;
              if (pending_type_args.len() > 0) {
                glit_name = glit_name + "[" + pending_type_args + "]";
              }
              let (glit_expr, glit_p) = parse_struct_lit_body(p, glit_name, bid.line, bid.col);
              p = glit_p;
              base = glit_expr;
              if let ast.ExprStructLit(gsl) = glit_expr {
                if (written_args.len() > 0) {
                  base = ast.ExprStructLit { ...gsl, written: bid.name + "[" + written_args + "]" };
                }
              }
              pending_type_arg_list = [];
              pending_type_args = "";
            },
            _ => {}
          }
        }
        continue;
      }
      p = idx_p;
      if (p.peek_punct() == ":") {
        p = p.advance();
        if (p.peek_punct() == "]") {
          p = p.advance();
          base = e_slice_open(base, idx_expr, bline, bcol);
          continue;
        }
        let (end_expr, end_p) = parse_expr(p);
        p = end_p;
        if (p.peek_punct() != "]") {
          return missing_close("missing ] in slice", "]", [idx_expr, end_expr], p);
        }
        p = p.advance();
        base = e_slice(base, idx_expr, end_expr, bline, bcol);
      } else {
        if (p.peek_punct() != "]") {
          return missing_close("missing ] in index", "]", [idx_expr], p);
        }
        p = p.advance();
        base = e_index(base, idx_expr, bline, bcol);
      }
    } else if (pk == "." || pk == "::") {
      if (pk == "::" && path_sep_line == 0) {
        path_sep_line = p.peek_line();
        path_sep_col = p.peek_col();
      }
      let dline: i32 = p.peek_line();
      let dcol: i32 = p.peek_col();
      p = p.advance();
      let fname: string = p.peek_ident();
      if (fname.len() == 0) {
        match (p.peek()) {
          lexer.TokNumber(n) => {
            fname = n.text;
          },
          _ => {}
        }
      }
      if (fname.len() == 0) {
        return (e_unknown_at("missing field name after .", p.peek_line(), p.peek_col()), p);
      }
      p = p.advance();
      let qname: string = "";
      let qline: i32 = 0;
      let qcol: i32 = 0;
      match (base) {
        ast.ExprIdent(qid) => {
          qname = qid.name;
          qline = qid.line;
          qcol = qid.col;
        },
        _ => {}
      }
      let qstruct_ok: boolean = false;
      if (qname.len() > 0 && !p.no_struct && p.peek_punct() == "{") {
        let qlook: Par = p.advance();
        if (qlook.peek_punct() == "}") {
          qstruct_ok = true;
        } else if (qlook.peek_punct() == "...") {
          qstruct_ok = true;
        } else if (qlook.peek_ident().len() > 0) {
          let qlook2: Par = qlook.advance();
          if (qlook2.peek_punct() == ":") {
            qstruct_ok = true;
          }
        }
      }
      if (qstruct_ok) {
        let (qr_expr, qr_p) = parse_struct_lit_body(p, qname + "." + fname, qline, qcol);
        p = qr_p;
        base = qr_expr;
      } else {
        base = ast.ExprFieldAccess { obj: base, field: fname, line: dline, col: dcol, ty: "", const_read: false };
      }
    } else if (p.peek_keyword() == "as") {
      let asline: i32 = p.peek_line();
      let ascol: i32 = p.peek_col();
      p = p.advance();
      let is_downcast: boolean = false;
      if (p.peek_punct() == "?") {
        is_downcast = true;
        p = p.advance();
      }
      let (castty_name, castty_fn_ret, castty_p) = parse_type_name(p);
      p = castty_p;
      let tyname: string = castty_name;
      if (is_downcast) {
        base = e_unary_at("as?_" + tyname, base, asline, ascol);
      } else {
        base = e_unary_at("as_" + tyname, base, asline, ascol);
      }
    } else if (p.peek_punct() == "?") {
      let qline: i32 = p.peek_line();
      let qcol: i32 = p.peek_col();
      p = p.advance();
      base = e_unary_at("try_", base, qline, qcol);
    } else {
      break;
    }
  }
  if (path_sep_line > 0) {
    return (e_unknown_at(path_sep_message(), path_sep_line, path_sep_col), p);
  }
  return (base, p);
}

function parse_expr_from_text(p: Par, text: string, base_line: i32, base_col: i32): (ast.Expr, Par, boolean) {
  let toks: lexer.Token[] = lexer.rebase_tokens(lexer.tokenize(text), base_line, base_col);
  if let Some(le) = stream_lex_error(toks) {
    return (e_unknown_at(lex_error_kind(le), le.line, le.col), p, true);
  }
  let sub: Par = Par { toks: toks, pos: 0, no_struct: false, map_kind: 0 - 1, structnames: scan_struct_names(toks), verbatim: p.verbatim, depth: 0, type_errs: p.type_errs, todos: p.todos, tail_at: [], tail_is: [] };
  let (r_expr, r_p) = parse_expr(sub);
  let outer: Par = Par { ...p, type_errs: r_p.type_errs, todos: r_p.todos };
  if (!r_p.at_end()) {
    return (e_unknown_at("f-string interpolation: unexpected trailing tokens after expression", r_p.peek_line(), r_p.peek_col()), outer, true);
  }
  return (r_expr, outer, r_p.type_errs.len() > p.type_errs.len() || holds_sentinel(r_expr));
}

function holds_sentinel(e: ast.Expr): boolean {
  return astwalk.fold_expr_nodes(e, false, sentinel_scan_stmt, sentinel_scan_expr, astwalk.descend_all);
}

function sentinel_scan_stmt(st: ast.Stmt, own hit: boolean): boolean {
  if let ast.StmtUnknown(_) = st {
    return true;
  }
  return hit;
}

function sentinel_scan_expr(e: ast.Expr, own hit: boolean): boolean {
  if let ast.ExprUnknown(u) = e {
    return hit || u.kind != BARE_RETURN;
  }
  return hit;
}

function parse_primary(p: Par): (ast.Expr, Par) {
  if (p.too_deep()) {
    return (e_unknown_at("nest:too-deep", p.peek_line(), p.peek_col()), p.bail());
  }
  let (g0, gq) = parse_primary_nested(p.with_depth(p.depth + 1));
  return (g0, gq.with_depth(p.depth));
}

function parse_primary_nested(p: Par): (ast.Expr, Par) {
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokNumber(x) => {
      let nline: i32 = p.peek_line();
      let ncol: i32 = p.peek_col();
      p = p.advance();
      if (!p.verbatim && x.is_float && util.f64_lit_out_of_range(x.text)) {
        return parse_postfix(p, e_unknown_at(util.f64_range_kind(x.text), nline, ncol));
      }
      return parse_postfix(p, e_spelled_at(x.text, x.suffix, x.raw, x.is_float, nline, ncol));
    },
    lexer.TokString(x) => {
      let sline: i32 = p.peek_line();
      let scol: i32 = p.peek_col();
      p = p.advance();
      return parse_postfix(p, e_string_at(x.value, sline, scol));
    },
    lexer.TokKeyword(x) => {
      if (x.name == "true" || x.name == "false") {
        let bline: i32 = p.peek_line();
        let bcol: i32 = p.peek_col();
        p = p.advance();
        return parse_postfix(p, e_bool_at(x.name == "true", bline, bcol));
      }
      if (x.name == "function") {
        return (e_unknown_at(coded_kind("P006", "`function` introduces a named declaration; write an anonymous function as an arrow lambda — `(x: T): R => …`"), p.peek_line(), p.peek_col()), p.advance());
      }
      if (x.name == "match") {
        let mc: IfChain = parse_match_expr(p);
        let mno_params: ast.ParamDecl[] = [];
        let mlam_body: ast.Stmt[] = [mc.stmt];
        if (mc.value_local.len() > 0) {
          mlam_body = [s_var(mc.value_local, "", zero_expr_for(mc.rt)), mc.stmt, s_return(e_ident(mc.value_local))];
        } else if (mc.needs_default_return) {
          mlam_body = mlam_body.append(s_return(zero_expr_for(mc.rt)));
        }
        let mno_args: ast.Expr[] = [];
        if (mc.scrut_bind.len() > 0) {
          let minner: ast.Expr = e_call(e_lambda_origin(mno_params, mc.rt, mlam_body, ORIGIN_MATCH_EXPR), mno_args);
          mlam_body = [mc.scrut_bind[0], s_return(minner)];
        }
        let miife: ast.Expr = e_call_at(e_lambda_origin(mno_params, mc.rt, mlam_body, ORIGIN_MATCH_EXPR), mno_args, x.line, x.col);
        return parse_postfix(mc.par, miife);
      }
      if (x.name == "if") {
        let ic: IfChain = parse_if_chain(p);
        let no_params: ast.ParamDecl[] = [];
        let lam_body: ast.Stmt[] = [ic.stmt];
        let no_args: ast.Expr[] = [];
        let iife: ast.Expr = e_call_at(e_lambda_origin(no_params, ic.rt, lam_body, ORIGIN_IF_EXPR), no_args, x.line, x.col);
        return parse_postfix(ic.par, iife);
      }
      let is_tykw: boolean = x.name == "string" || x.name == "boolean" || x.name == "void"
        || x.name == "i32" || x.name == "i64"
        || x.name == "u8" || x.name == "u32" || x.name == "u64"
        || x.name == "usize" || x.name == "f32" || x.name == "f64" || x.name == "f64x2" || x.name == "f32x4";
      if (is_tykw) {
        let kwline: i32 = p.peek_line();
        let kwcol: i32 = p.peek_col();
        let look: Par = p.advance();
        if (look.peek_punct() == "." || look.peek_punct() == "::") {
          return parse_postfix(look, e_ident_at(x.name, kwline, kwcol));
        }
      }
      return (e_unknown_at("keyword:" + x.name, p.peek_line(), p.peek_col()), p);
    },
    lexer.TokIdent(x) => {
      let idline: i32 = p.peek_line();
      let idcol: i32 = p.peek_col();
      p = p.advance();
      let base: ast.Expr = e_ident_at(x.name, idline, idcol);
      if (x.name == "Map" && !p.no_struct && p.peek_punct() == "{") {
        return parse_map_lit(p);
      }
      if (!p.no_struct && p.peek_punct() == "{") {
        let (slr_expr, slr_p) = parse_struct_lit_body(p, x.name, idline, idcol);
        p = slr_p;
        base = slr_expr;
      }
      return parse_postfix(p, base);
    },
    lexer.TokPunct(x) => {
      if (x.text == "(") {
        if (p.arrow_lambda_at()) {
          return parse_arrow_lambda(p);
        }
        let tpl: i32 = p.peek_line();
        let tpc: i32 = p.peek_col();
        p = p.advance();
        if (p.peek_punct() == ")") {
          p = p.advance();
          return parse_postfix(p, e_unit_at(tpl, tpc));
        }
        let (inner_expr, inner_p) = parse_expr(p);
        p = inner_p;
        if (p.peek_punct() == ",") {
          let elems: ast.Expr[] = [];
          elems = elems.append(inner_expr);
          while (p.peek_punct() == ",") {
            p = p.advance();
            if (p.peek_punct() == ")") {
              break;
            }
            let (er_expr, er_p) = parse_expr(p);
            p = er_p;
            elems = elems.append(er_expr);
          }
          if (p.peek_punct() == ")") {
            p = p.advance();
          }
          return parse_postfix(p, e_tuple_at(elems, tpl, tpc));
        }
        if (p.peek_punct() == ")") {
          p = p.advance();
        }
        return parse_postfix(p, inner_expr);
      }
      if (x.text == "[") {
        p = p.advance();
        let elems: ast.Expr[] = [];
        if (p.peek_punct() != "]") {
          while (true) {
            let (er_expr, er_p) = parse_expr(p);
            p = er_p;
            elems = elems.append(er_expr);
            let (ea_more, ea_p) = p.more_elems("]");
            p = ea_p;
            if (ea_more) {
              continue;
            }
            break;
          }
        }
        if (p.peek_punct() != "]") {
          return missing_close("missing ] in array literal", "]", elems, p);
        }
        p = p.advance();
        return parse_postfix(p, e_array_at(elems, x.line, x.col));
      }
      if (x.text == "{" && !p.no_struct) {
        let (bb_body, bb_rt, bb_p) = parse_branch_body(p);
        let bx_params: ast.ParamDecl[] = [];
        let bx_args: ast.Expr[] = [];
        let iife: ast.Expr = e_call_at(e_lambda_origin(bx_params, bb_rt, bb_body, ORIGIN_BLOCK), bx_args, x.line, x.col);
        return parse_postfix(bb_p, iife);
      }
      if (x.text == "-" || x.text == "!") {
        let uline: i32 = p.peek_line();
        let ucol: i32 = p.peek_col();
        p = p.advance();
        let (operand_expr, operand_p) = parse_primary(p);
        return (e_unary_at(x.text, operand_expr, uline, ucol), operand_p);
      }
      let badline: i32 = p.peek_line();
      let badcol: i32 = p.peek_col();
      let bad: string = "punct:" + x.text;
      if (p.reported_at(badline, badcol)) {
        bad = REPORTED;
      }
      p = p.advance();
      return (e_unknown_at(bad, badline, badcol), p);
    },
    lexer.TokEof(_) => {
      return (e_unknown_at("eof", p.peek_line(), p.peek_col()), p);
    },
    lexer.TokError(x) => {
      return (e_unknown_at(lex_error_kind(x), x.line, x.col), p);
    },
    lexer.TokFString(f) => {
      p = p.advance();
      if (p.verbatim) {
        let vlits: string[] = [];
        let vexprs: ast.Expr[] = [];
        let vflags: boolean[] = [];
        let vi: i32 = 0;
        while (vi < f.parts.len()) {
          let vpart: lexer.FStringPart = f.parts[vi];
          vflags = vflags.append(vpart.is_expr);
          if (vpart.is_expr) {
            vlits = vlits.append("");
            let (ve, vp, _) = parse_expr_from_text(p, vpart.expr, vpart.line, vpart.col);
            p = vp;
            if let ast.ExprUnknown(_) = ve {
              return (ve, p);
            }
            vexprs = vexprs.append(ve);
          } else {
            vlits = vlits.append(vpart.lit);
            vexprs = vexprs.append(e_unknown("fstring-literal-part"));
          }
          vi = vi + 1;
        }
        return parse_postfix(p, ast.ExprFString { lits: vlits, exprs: vexprs, is_expr: vflags, line: f.line, col: f.col });
      }
      let built: ast.Expr = e_string("");
      let has: boolean = false;
      let i: i32 = 0;
      while (i < f.parts.len()) {
        let part: lexer.FStringPart = f.parts[i];
        let piece: ast.Expr = e_string(part.lit);
        if (part.is_expr) {
          let no_args: ast.Expr[] = [];
          let (pe, pp, failed) = parse_expr_from_text(p, part.expr, part.line, part.col);
          p = pp;
          if (failed) {
            return (pe, p);
          }
          piece = e_call_at(e_field_access_at(pe, "to_string", f.line, f.col), no_args, f.line, f.col);
        }
        if (!has) {
          built = piece;
          has = true;
        } else {
          built = e_binary("+", built, piece);
        }
        i = i + 1;
      }
      return parse_postfix(p, built);
    }
  }
  return (e_unknown_at("primary", p.peek_line(), p.peek_col()), p);
}

function precedence(op: string): i32 {
  if (op == "||") {
    return 1;
  }
  if (op == "&&") {
    return 2;
  }
  if (op == "|") {
    return 3;
  }
  if (op == "^") {
    return 4;
  }
  if (op == "&") {
    return 5;
  }
  if (op == "==" || op == "!=") {
    return 6;
  }
  if (op == "<" || op == ">" || op == "<=" || op == ">=") {
    return 7;
  }
  if (op == "<<" || op == ">>" || op == "<<|" || op == "<<?" || op == ">>?") {
    return 8;
  }
  if (op == "+" || op == "-" || op == "+|" || op == "-|" || op == "+?" || op == "-?") {
    return 9;
  }
  if (op == "*" || op == "/" || op == "%" || op == "*|" || op == "*?" || op == "/?" || op == "%?") {
    return 10;
  }
  return 0 - 1;
}

function parse_binary(p: Par, min_prec: i32): (ast.Expr, Par) {
  if (p.too_deep()) {
    return (e_unknown_at("nest:too-deep", p.peek_line(), p.peek_col()), p.bail());
  }
  let (g0, gq) = parse_binary_nested(p.with_depth(p.depth + 1), min_prec);
  return (g0, gq.with_depth(p.depth));
}

function parse_binary_nested(p: Par, min_prec: i32): (ast.Expr, Par) {
  let (lhs_expr, lhs_p) = parse_primary(p);
  p = lhs_p;
  while (true) {
    let op: string = p.peek_punct();
    let prec: i32 = precedence(op);
    if (prec < min_prec) {
      return (lhs_expr, p);
    }
    let opline: i32 = p.peek_line();
    let opcol: i32 = p.peek_col();
    p = p.advance();
    let (rhs_expr, rhs_p) = parse_binary(p, prec + 1);
    p = rhs_p;
    lhs_expr = e_binary_at(op, lhs_expr, rhs_expr, opline, opcol);
  }
  return (lhs_expr, p);
}

function parse_expr(p: Par): (ast.Expr, Par) {
  return parse_pipe(p);
}

pub struct IfChain { par: Par, stmt: ast.Stmt, rt: string, needs_default_return: boolean, value_local: string, scrut_bind: ast.Stmt[] }

function value_arm_body(body: ast.Stmt[], val: string): ast.Stmt[] {
  if (body.len() == 0) {
    return body;
  }
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      let out: ast.Stmt[] = [];
      let i: i32 = 0;
      while (i < body.len() - 1) {
        out = out.append(body[i]);
        i = i + 1;
      }
      if (stmts_exit(out, false)) {
        return out;
      }
      if let Some(st) = exiting_if_tail(r.value) {
        return out.append(st);
      }
      return out.append(s_assign(val, r.value));
    },
    _ => {
      return body;
    }
  }
  return body;
}

function zero_expr_for(rt: string): ast.Expr {
  if (rt == "string" || rt == "str") {
    return e_string("");
  }
  if (rt == "boolean") {
    return e_bool(false);
  }
  if (rt == "f64") {
    return e_number("0", "", true);
  }
  if (rt == "i64" || rt == "u64") {
    return e_number("0", rt, false);
  }
  return e_number("0", "", false);
}

function if_expr_rt(e: ast.Expr): string {
  match (e) {
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprBool(_) => {
      return "boolean";
    },
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return "f64";
      }
      if (n.suffix.len() > 0) {
        return n.suffix;
      }
      if (literal_is_i64(n.text)) {
        return "i64";
      }
      return "i32";
    },
    ast.ExprCall(c) => {
      if (c.args.len() != 0) {
        return "i32";
      }
      match (c.callee) {
        ast.ExprLambda(lam) => {
          if (lam.params.len() == 0 && lam.ret_type.len() > 0) {
            return lam.ret_type;
          }
          return "i32";
        },
        _ => {
          return "i32";
        }
      }
    },
    ast.ExprBinary(b) => {
      if (irt_is_cmp(b.op)) {
        return "boolean";
      }
      return wider_rt(if_expr_rt(b.left), if_expr_rt(b.right));
    },
    ast.ExprUnary(u) => {
      if (u.op == "!") {
        return "boolean";
      }
      if (is_cast_op(u.op)) {
        return slice_unchecked(u.op, 3, u.op.len()) + "";
      }
      return if_expr_rt(u.operand);
    },
    _ => {
      return "i32";
    }
  }
}

function wider_rt(a: string, b: string): string {
  if (a == b) {
    return a;
  }
  if (a == "i64" || a == "u64") {
    return a;
  }
  if (b == "i64" || b == "u64") {
    return b;
  }
  return a;
}

function parse_lit_or_range(p: Par): (ast.Expr, ast.Expr, boolean, boolean, Par) {
  let (lo_expr, lo_p) = parse_binary(p, 4);
  p = lo_p;
  let pk: string = p.peek_punct();
  if (pk == ".." || pk == "..=") {
    p = p.advance();
    let (hi_expr, hi_p) = parse_binary(p, 4);
    p = hi_p;
    return (lo_expr, hi_expr, true, pk == "..=", p);
  }
  return (lo_expr, e_bool(true), false, false, p);
}

function parse_lit_alts(p: Par): (ast.Expr[], ast.Expr[], boolean[], boolean[], Par) {
  let lits: ast.Expr[] = [];
  let his: ast.Expr[] = [];
  let hrs: boolean[] = [];
  let incs: boolean[] = [];
  let (l0, h0, hr0, inc0, p0) = parse_lit_or_range(p);
  p = p0;
  lits = lits.append(l0);
  his = his.append(h0);
  hrs = hrs.append(hr0);
  incs = incs.append(inc0);
  while (p.peek_punct() == "|") {
    p = p.advance();
    let (ln, hn, hrn, incn, pn) = parse_lit_or_range(p);
    p = pn;
    lits = lits.append(ln);
    his = his.append(hn);
    hrs = hrs.append(hrn);
    incs = incs.append(incn);
  }
  return (lits, his, hrs, incs, p);
}

function bool_closing_arm(arms: ast.LitArm[]): i32 {
  let t: boolean = false;
  let f: boolean = false;
  let i: i32 = 0;
  while (i < arms.len()) {
    let a: ast.LitArm = arms[i];
    if (a.is_wild && !a.has_guard) {
      return 0 - 1;
    }
    if let ast.ExprBool(b) = a.lit {
      if (!a.is_wild && !a.has_guard && !a.has_range && a.at_binding.len() == 0) {
        t = t || b.value;
        f = f || !b.value;
      }
    }
    if (t && f) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function close_bool_arms(arms: ast.LitArm[]): ast.LitArm[] {
  let k: i32 = bool_closing_arm(arms);
  if (k < 0) {
    return arms;
  }
  let out: ast.LitArm[] = [];
  let i: i32 = 0;
  while (i < k) {
    out = out.append(arms[i]);
    i = i + 1;
  }
  return out.append(ast.LitArm { ...arms[k], is_wild: true });
}

function build_literal_match(scrut: ast.Expr, arms: ast.LitArm[], mkline: i32, mkcol: i32): ast.Stmt {
  let written_arms: ast.LitArm[] = arms;
  arms = close_bool_arms(arms);
  let wi: i32 = 0;
  let non_last_wild: boolean = false;
  let saw_wild: boolean = false;
  while (wi < arms.len()) {
    if (arms[wi].is_wild) {
      if (!arms[wi].has_guard) {
        saw_wild = true;
      }
      if (wi < arms.len() - 1) {
        non_last_wild = true;
      }
    }
    wi = wi + 1;
  }
  if (non_last_wild || !saw_wild) {
    let marms: ast.MatchArm[] = [];
    let mi: i32 = 0;
    while (mi < arms.len()) {
      let la: ast.LitArm = arms[mi];
      let pat: ast.Pattern = p_variant("", "");
      if (la.is_wild) {
        pat = p_wildcard();
      }
      let lbody: ast.Stmt[] = la.body;
      if (la.at_binding.len() > 0) {
        lbody = prepend_stmt(s_var_at(la.at_binding, "", scrut, la.line, la.col), la.body);
      }
      marms = marms.append(ast.MatchArm { pattern: pat, body: lbody, line: la.line, col: la.col, guard: la.guard, has_guard: la.has_guard, alt_cont: false });
      mi = mi + 1;
    }
    return s_match_at(scrut, marms, mkline, mkcol);
  }
  let written: ast.Expr = scrut;
  let lm: string = "";
  if let ast.ExprIdent(_) = scrut {} else {
    lm = literal_scrut_local(mkline, mkcol);
    scrut = e_ident(lm);
  }
  let else_body: ast.Stmt[] = [];
  let i: i32 = arms.len() - 1;
  while (i >= 0) {
    let a: ast.LitArm = arms[i];
    if (a.is_wild) {
      if (a.has_guard) {
        else_body = [s_if(a.guard, a.body, else_body)];
      } else {
        else_body = a.body;
      }
    } else {
      let abody: ast.Stmt[] = a.body;
      let aguard: ast.Expr = a.guard;
      if (a.at_binding.len() > 0) {
        abody = prepend_stmt(s_var_at(a.at_binding, "", scrut, a.line, a.col), a.body);
        if let ast.ExprIdent(sid) = scrut {
          aguard = astwalk.subst_ident_expr(a.guard, a.at_binding, sid.name);
        }
      }
      let cond: ast.Expr = ast.ExprBinary { op: "==", left: scrut, right: a.lit, line: a.line, col: a.col, ty: "" };
      if (a.has_range) {
        let hi_op: string = "<";
        if (a.range_inclusive) {
          hi_op = "<=";
        }
        cond = e_binary("&&", e_binary(">=", scrut, a.lit), e_binary(hi_op, scrut, a.range_hi));
      }
      if (a.has_guard) {
        cond = e_binary("&&", cond, aguard);
      }
      else_body = [s_if(cond, abody, else_body)];
    }
    i = i - 1;
  }
  if (else_body.len() == 0) {
    return s_unknown_at("empty literal match", mkline, mkcol);
  }
  let sugar: ast.MatchSugar = ast.MatchSugar { ...no_match_sugar(), scrut: written, lits: written_arms, line: mkline, col: mkcol };
  if (lm != "") {
    return s_if_match([s_var_at(lm, "", written, mkline, mkcol), else_body[0]], sugar);
  }
  return with_match_sugar(else_body[0], sugar);
}

function with_match_sugar(st: ast.Stmt, sugar: ast.MatchSugar): ast.Stmt {
  match (st) {
    ast.StmtIf(i) => {
      return ast.StmtIf { ...i, sugar: sugar };
    },
    _ => {
      return st;
    }
  }
}

pub function literal_scrut_local(line: i32, col: i32): string {
  return "__lm" + util.i32_to_string(line) + "_" + util.i32_to_string(col);
}

pub function is_literal_scrut_local(name: string): boolean {
  return name.len() > 4 && slice_unchecked(name, 0, 4) == "__lm";
}

function with_written_scrut(st: ast.Stmt, written: ast.Expr): ast.Stmt {
  match (st) {
    ast.StmtIf(i) => {
      return ast.StmtIf { ...i, sugar: ast.MatchSugar { ...i.sugar, scrut: written } };
    },
    _ => {
      return st;
    }
  }
}

function with_sugar_origin(st: ast.Stmt, origin: string): ast.Stmt {
  match (st) {
    ast.StmtIf(i) => {
      return ast.StmtIf { ...i, sugar: ast.MatchSugar { ...i.sugar, origin: origin } };
    },
    _ => {
      return st;
    }
  }
}

function p_tuple_carrier(kinds: i32[], binds: string[], lits: ast.Expr[], pats: ast.Pattern[]): ast.Pattern {
  let no_extra: string[] = [];
  let no_nested: ast.Pattern[] = [];
  return ast.PatVariant { type_name: "", binding: "", extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: kinds, tup_binds: binds, tup_lits: lits, tup_pats: pats, rest_written: false };
}

function parse_tuple_arm_pattern(p: Par): (i32[], string[], ast.Expr[], ast.Pattern[], Par) {
  if (p.too_deep()) {
    return ([], [], [], [], p.bail());
  }
  let (g0, g1, g2, g3, gq) = parse_tuple_arm_pattern_nested(p.with_depth(p.depth + 1));
  return (g0, g1, g2, g3, gq.with_depth(p.depth));
}

function parse_tuple_arm_pattern_nested(p: Par): (i32[], string[], ast.Expr[], ast.Pattern[], Par) {
  let elem_kinds: i32[] = [];
  let binds: string[] = [];
  let lits: ast.Expr[] = [];
  let pats: ast.Pattern[] = [];
  let none: i32[] = [];
  let no_pats: ast.Pattern[] = [];
  p = p.advance();
  while (p.peek_punct() != ")" && !p.at_end()) {
    let n: string = p.peek_ident();
    if (n == "_") {
      p = p.advance();
      elem_kinds = elem_kinds.append(1);
      binds = binds.append("");
      lits = lits.append(e_bool(true));
      pats = pats.append(p_wildcard());
    } else if (p.peek_punct() == "(") {
      let (ne_kinds, ne_binds, ne_lits, ne_pats, ne_p) = parse_tuple_arm_pattern(p);
      p = ne_p;
      if (ne_kinds.len() == 0) {
        return (none, [], [], no_pats, p);
      }
      elem_kinds = elem_kinds.append(4);
      binds = binds.append("");
      lits = lits.append(e_bool(true));
      pats = pats.append(p_tuple_carrier(ne_kinds, ne_binds, ne_lits, ne_pats));
    } else if (n.len() > 0 && (p.peek_punct_at(1) == "(" || p.peek_punct_at(1) == ".")) {
      let (ve_pat, ve_p) = parse_pattern(p);
      p = ve_p;
      elem_kinds = elem_kinds.append(3);
      binds = binds.append("");
      lits = lits.append(e_bool(true));
      pats = pats.append(ve_pat);
    } else if (n.len() > 0) {
      p = p.advance();
      elem_kinds = elem_kinds.append(0);
      binds = binds.append(n);
      lits = lits.append(e_bool(true));
      pats = pats.append(p_wildcard());
    } else if (p.peek_is_pat_literal()) {
      let (le_expr, le_p) = parse_expr(p);
      p = le_p;
      elem_kinds = elem_kinds.append(2);
      binds = binds.append("");
      lits = lits.append(le_expr);
      pats = pats.append(p_wildcard());
    } else {
      return (none, [], [], no_pats, p);
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  if (elem_kinds.len() < 2) {
    return (none, [], [], no_pats, p);
  }
  return (elem_kinds, binds, lits, pats, p);
}

function tuple_elem_names(prefix: string, n: i32): string {
  let names: string = "";
  let k: i32 = 0;
  while (k < n) {
    if (k > 0) {
      names = names + ",";
    }
    names = names + prefix + "_e" + util.i32_to_string(k);
    k = k + 1;
  }
  return names;
}

function wrap_tuple_elems(path: ast.Stmt[], kinds: i32[], pats: ast.Pattern[], prefix: string, line: i32, col: i32): ast.Stmt[] {
  let cur: ast.Stmt[] = path;
  let wi: i32 = kinds.len() - 1;
  while (wi >= 0) {
    let en: string = prefix + "_e" + util.i32_to_string(wi);
    if (kinds[wi] == 3) {
      cur = match_sub_pattern(cur, en, pats[wi], line, col);
    } else if (kinds[wi] == 4) {
      let (nk, nb, nl, np) = pv_tup(pats[wi]);
      let sub: ast.Stmt[] = wrap_tuple_elems(cur, nk, np, en, line, col);
      let body: ast.Stmt[] = [];
      let bk: i32 = 0;
      while (bk < nk.len()) {
        if (nk[bk] == 0) {
          body = body.append(s_var_at(nb[bk], "", e_ident_at(en + "_e" + util.i32_to_string(bk), line, col), line, col));
        }
        bk = bk + 1;
      }
      let si: i32 = 0;
      while (si < sub.len()) {
        body = body.append(sub[si]);
        si = si + 1;
      }
      let ncond: ast.Expr = e_bool(true);
      let has_ncond: boolean = false;
      let lk: i32 = 0;
      while (lk < nk.len()) {
        if (nk[lk] == 2) {
          let one: ast.Expr = e_binary("==", e_ident(en + "_e" + util.i32_to_string(lk)), nl[lk]);
          if (has_ncond) {
            ncond = e_binary("&&", ncond, one);
          } else {
            ncond = one;
          }
          has_ncond = true;
        }
        lk = lk + 1;
      }
      let nwrap: ast.Stmt[] = [];
      nwrap = nwrap.append(s_var_at(tuple_elem_names(en, nk.len()), "", e_ident_at(en, line, col), line, col));
      if (has_ncond) {
        nwrap = nwrap.append(s_if(ncond, body, []));
      } else {
        let ci: i32 = 0;
        while (ci < body.len()) {
          nwrap = nwrap.append(body[ci]);
          ci = ci + 1;
        }
      }
      cur = nwrap;
    }
    wi = wi - 1;
  }
  return cur;
}

function build_tuple_match(scrut: ast.Expr, arms: ast.TupArm[], mkline: i32, mkcol: i32): ast.Stmt {
  if (arms.len() == 0) {
    return s_unknown_at("empty tuple match", mkline, mkcol);
  }
  let n_elems: i32 = 0;
  let ai: i32 = 0;
  while (ai < arms.len()) {
    if (!arms[ai].is_wild) {
      n_elems = arms[ai].elem_kinds.len();
      break;
    }
    ai = ai + 1;
  }
  return build_tuple_match_sized(scrut, arms, n_elems, mkline, mkcol);
}

pub function build_tuple_match_sized(scrut: ast.Expr, arms: ast.TupArm[], n_elems: i32, mkline: i32, mkcol: i32): ast.Stmt {
  if (n_elems < 2) {
    return s_unknown_at("tuple match with no tuple arm", mkline, mkcol);
  }
  let base: string = "__tm" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
  let done: string = base + "_d";
  let whole: string = base + "_w";
  let names: string = tuple_elem_names(base, n_elems);
  let any_at: boolean = false;
  let qi: i32 = 0;
  while (qi < arms.len()) {
    if (!arms[qi].is_wild && arms[qi].at_binding.len() > 0) {
      any_at = true;
    }
    qi = qi + 1;
  }
  let outer: ast.Stmt[] = [];
  if (any_at) {
    outer = outer.append(s_var_at(whole, "", scrut, mkline, mkcol));
    outer = outer.append(s_var_at(names, "", e_ident(whole), mkline, mkcol));
  } else {
    outer = outer.append(s_var_at(names, "", scrut, mkline, mkcol));
  }
  outer = outer.append(s_var(done, "", e_bool(false)));
  let ai: i32 = 0;
  while (ai < arms.len()) {
    let a: ast.TupArm = arms[ai];
    if (!a.is_wild && a.elem_kinds.len() != n_elems) {
      outer = outer.append(s_if(e_bool(false), a.body, []));
      ai = ai + 1;
      continue;
    }
    let cond: ast.Expr = e_unary("!", e_ident(done));
    let inner: ast.Stmt[] = [];
    if (a.is_wild) {
      if (a.has_guard) {
        cond = e_binary("&&", cond, a.guard);
      }
      inner = inner.append(s_assign(done, e_bool(true)));
      let wb: i32 = 0;
      while (wb < a.body.len()) {
        inner = inner.append(a.body[wb]);
        wb = wb + 1;
      }
      outer = outer.append(s_if(cond, inner, []));
      ai = ai + 1;
      continue;
    }
    let ek: i32 = 0;
    while (ek < a.elem_kinds.len()) {
      if (a.elem_kinds[ek] == 2) {
        cond = e_binary("&&", cond, e_binary("==", e_ident(base + "_e" + util.i32_to_string(ek)), a.lits[ek]));
      }
      ek = ek + 1;
    }
    let binds: ast.Stmt[] = [];
    if (a.at_binding.len() > 0) {
      binds = binds.append(s_var_at(a.at_binding, "", e_ident_at(whole, a.line, a.col), a.line, a.col));
    }
    ek = 0;
    while (ek < a.elem_kinds.len()) {
      if (a.elem_kinds[ek] == 0) {
        binds = binds.append(s_var_at(a.binds[ek], "", e_ident_at(base + "_e" + util.i32_to_string(ek), a.line, a.col), a.line, a.col));
      }
      ek = ek + 1;
    }
    if (a.has_guard) {
      let guarded: ast.Stmt[] = [];
      guarded = guarded.append(s_assign(done, e_bool(true)));
      let gb: i32 = 0;
      while (gb < a.body.len()) {
        guarded = guarded.append(a.body[gb]);
        gb = gb + 1;
      }
      let bi: i32 = 0;
      while (bi < binds.len()) {
        inner = inner.append(binds[bi]);
        bi = bi + 1;
      }
      inner = inner.append(s_if(a.guard, guarded, []));
    } else {
      inner = inner.append(s_assign(done, e_bool(true)));
      let bi2: i32 = 0;
      while (bi2 < binds.len()) {
        inner = inner.append(binds[bi2]);
        bi2 = bi2 + 1;
      }
      let ab: i32 = 0;
      while (ab < a.body.len()) {
        inner = inner.append(a.body[ab]);
        ab = ab + 1;
      }
    }
    inner = wrap_tuple_elems(inner, a.elem_kinds, a.elem_pats, base, a.line, a.col);
    outer = outer.append(s_if(cond, inner, []));
    ai = ai + 1;
  }
  let no_struct: ast.StructArm[] = [];
  return s_if_match(outer, ast.MatchSugar { ...no_match_sugar(), scrut: scrut, tup: arms, line: mkline, col: mkcol });
}

pub struct StructArmPattern { binds: string[], fields: string[], kinds: i32[], lits: ast.Expr[], pats: ast.Pattern[], rest_written: boolean, ok: boolean }

function parse_struct_arm_pattern(p: Par): (StructArmPattern, Par) {
  let binds: string[] = [];
  let fields: string[] = [];
  let kinds: i32[] = [];
  let lits: ast.Expr[] = [];
  let pats: ast.Pattern[] = [];
  let ok: boolean = true;
  let rest_written: boolean = false;
  if (p.peek_ident().len() > 0) {
    p = p.advance();
  }
  if (p.peek_punct() == "{") {
    p = p.advance();
  }
  while (p.peek_punct() != "}" && !p.at_end()) {
    if (p.peek_punct() == "..") {
      p = p.advance();
      rest_written = true;
      break;
    }
    let fld: string = p.peek_ident();
    if (fld.len() == 0) {
      p = p.advance();
      ok = false;
      break;
    }
    p = p.advance();
    let bind: string = fld;
    let fkind: i32 = 0;
    let flit: ast.Expr = e_bool(true);
    let fpat: ast.Pattern = p_wildcard();
    if (p.peek_punct() == ":") {
      p = p.advance();
      if (p.peek_is_pat_literal()) {
        let (le_expr, le_p) = parse_expr(p);
        p = le_p;
        fkind = 2;
        flit = le_expr;
        bind = "";
      } else if (struct_field_variant_start(p)) {
        let (fp, fpp) = parse_pattern(p);
        p = fpp;
        fkind = 3;
        fpat = fp;
        bind = "";
      } else {
        let lc: string = p.peek_ident();
        if (lc.len() > 0) {
          p = p.advance();
        }
        bind = lc;
      }
    }
    binds = binds.append(bind);
    fields = fields.append(fld);
    kinds = kinds.append(fkind);
    lits = lits.append(flit);
    pats = pats.append(fpat);
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (StructArmPattern { binds: binds, fields: fields, kinds: kinds, lits: lits, pats: pats, rest_written: rest_written, ok: ok }, p);
}

function struct_field_variant_start(p: Par): boolean {
  let n: string = p.peek_ident();
  if (n.len() > 0 && n != "_") {
    let nx: string = p.peek_punct_at(1);
    if (nx == "(" || nx == ".") {
      return true;
    }
  }
  return false;
}

function build_struct_match(scrut: ast.Expr, arms: ast.StructArm[], mkline: i32, mkcol: i32): ast.Stmt {
  return build_struct_match_fields(scrut, arms, mkline, mkcol, false);
}

function struct_match_literal_cond(cond: ast.Expr, a: ast.StructArm, tmp: string): ast.Expr {
  let lk: i32 = 0;
  while (lk < a.field_kinds.len()) {
    if (a.field_kinds[lk] == 2) {
      cond = e_binary("&&", cond, e_binary("==", e_field_access_at(e_ident(tmp), a.fields[lk], a.line, a.col), a.field_lits[lk]));
    }
    lk = lk + 1;
  }
  return cond;
}

function struct_match_bindings(a: ast.StructArm, tmp: string, record: boolean): ast.Stmt[] {
  let binds: ast.Stmt[] = [];
  if (a.at_binding.len() > 0) {
    binds = binds.append(s_var_at(a.at_binding, "", e_ident(tmp), a.line, a.col));
  }
  let bk: i32 = 0;
  if (record && a.fields.len() > 0) {
    binds = binds.append(s_var_at(record_binding_list(a.binds, a.line, a.col), "@sm;" + destr_marker("", a.rest_written, "@sd:" + a.type_name + ":" + record_field_list(a.fields)), e_ident(tmp), a.line, a.col));
    bk = a.binds.len();
  }
  while (bk < a.binds.len()) {
    if (a.binds[bk].len() > 0) {
      binds = binds.append(s_var_at(a.binds[bk], "", e_field_access_at(e_ident(tmp), a.fields[bk], a.line, a.col), a.line, a.col));
    }
    bk = bk + 1;
  }
  return binds;
}

function build_struct_match_fields(scrut: ast.Expr, arms: ast.StructArm[], mkline: i32, mkcol: i32, record: boolean): ast.Stmt {
  if (arms.len() == 0) {
    return s_unknown_at("empty struct match", mkline, mkcol);
  }
  let base: string = "__sm" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
  let tmp: string = base + "_v";
  let done: string = base + "_d";
  let outer: ast.Stmt[] = [];
  outer = outer.append(s_var(tmp, "", scrut));
  outer = outer.append(s_var(done, "", e_bool(false)));
  let ai: i32 = 0;
  while (ai < arms.len()) {
    let a: ast.StructArm = arms[ai];
    let cond: ast.Expr = e_unary("!", e_ident(done));
    let inner: ast.Stmt[] = [];
    if (a.is_wild) {
      if (a.has_guard) {
        cond = e_binary("&&", cond, a.guard);
      }
      inner = inner.append(s_assign(done, e_bool(true)));
      let wb: i32 = 0;
      while (wb < a.body.len()) {
        inner = inner.append(a.body[wb]);
        wb = wb + 1;
      }
      outer = outer.append(s_if(cond, inner, []));
      ai = ai + 1;
      continue;
    }
    cond = struct_match_literal_cond(cond, a, tmp);
    let binds: ast.Stmt[] = struct_match_bindings(a, tmp, record);
    if (a.has_guard) {
      let guarded: ast.Stmt[] = [];
      guarded = guarded.append(s_assign(done, e_bool(true)));
      let gb: i32 = 0;
      while (gb < a.body.len()) {
        guarded = guarded.append(a.body[gb]);
        gb = gb + 1;
      }
      let bi: i32 = 0;
      while (bi < binds.len()) {
        inner = inner.append(binds[bi]);
        bi = bi + 1;
      }
      inner = inner.append(s_if(a.guard, guarded, []));
    } else {
      inner = inner.append(s_assign(done, e_bool(true)));
      let bi2: i32 = 0;
      while (bi2 < binds.len()) {
        inner = inner.append(binds[bi2]);
        bi2 = bi2 + 1;
      }
      let ab: i32 = 0;
      while (ab < a.body.len()) {
        inner = inner.append(a.body[ab]);
        ab = ab + 1;
      }
    }
    inner = wrap_struct_fields(inner, a, tmp);
    outer = outer.append(s_if(cond, inner, []));
    ai = ai + 1;
  }
  let no_tup: ast.TupArm[] = [];
  return s_if_match(outer, ast.MatchSugar { ...no_match_sugar(), scrut: scrut, strct: arms, line: mkline, col: mkcol });
}

function wrap_struct_fields(path: ast.Stmt[], a: ast.StructArm, tmp: string): ast.Stmt[] {
  let cur: ast.Stmt[] = path;
  let wi: i32 = a.field_kinds.len() - 1;
  while (wi >= 0) {
    if (a.field_kinds[wi] == 3) {
      let mk_arms: ast.MatchArm[] = [];
      mk_arms = mk_arms.append(ast.MatchArm { pattern: a.field_pats[wi], body: cur, line: a.line, col: a.col, guard: e_bool(true), has_guard: false, alt_cont: false });
      let mk_skip: ast.Stmt[] = [];
      mk_arms = mk_arms.append(ast.MatchArm { pattern: p_wildcard(), body: mk_skip, line: a.line, col: a.col, guard: e_bool(true), has_guard: false, alt_cont: false });
      let fv: string = tmp + "_f" + util.i32_to_string(wi);
      let mk_wrap: ast.Stmt[] = [];
      mk_wrap = mk_wrap.append(s_var_at(fv, "", e_field_access_at(e_ident(tmp), a.fields[wi], a.line, a.col), a.line, a.col));
      mk_wrap = mk_wrap.append(s_match_origin(e_ident_at(fv, a.line, a.col), mk_arms, a.line, a.col, ORIGIN_PATTERN_PROBE));
      cur = mk_wrap;
    }
    wi = wi - 1;
  }
  return cur;
}

function is_struct_pattern_arm(p: Par): boolean {
  let head: string = p.peek_ident();
  if (head.len() > 0 && p.peek_punct_at(1) == "@") {
    head = p.peek_ident_at(2);
  }
  if (head.len() == 0) {
    return false;
  }
  return util.has_str(p.structnames, head);
}

function parse_struct_match_arms(p: Par, expr_form: boolean): (ast.StructArm[], string, boolean, Par) {
  let arms: ast.StructArm[] = [];
  let rt: string = "i32";
  let first: boolean = true;
  let all_ok: boolean = true;
  while (p.peek_punct() != "}" && !p.at_end()) {
    let sline: i32 = p.peek_line();
    let scol: i32 = p.peek_col();
    let s_wild: boolean = false;
    let s_binds: string[] = [];
    let s_fields: string[] = [];
    let s_rest: boolean = false;
    let s_field_kinds: i32[] = [];
    let s_field_lits: ast.Expr[] = [];
    let s_field_pats: ast.Pattern[] = [];
    let s_at: string = "";
    let s_type: string = "";
    if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
      s_at = p.peek_ident();
      p = p.advance();
      p = p.advance();
    }
    if (p.peek_ident() == "_" && p.peek2_punct() != "{") {
      p = p.advance();
      s_wild = true;
    } else {
      s_type = p.peek_ident();
      let (sap, spp) = parse_struct_arm_pattern(p);
      let spb: string[] = sap.binds;
      let spf: string[] = sap.fields;
      let spkinds: i32[] = sap.kinds;
      let splits: ast.Expr[] = sap.lits;
      let sppats: ast.Pattern[] = sap.pats;
      let spok: boolean = sap.ok;
      p = spp;
      s_binds = spb;
      s_fields = spf;
      s_rest = sap.rest_written;
      s_field_kinds = spkinds;
      s_field_lits = splits;
      s_field_pats = sppats;
      if (!spok) {
        all_ok = false;
      }
    }
    let s_guard: ast.Expr = e_bool(true);
    let s_has_guard: boolean = false;
    if (p.peek_keyword() == "when") {
      p = p.advance();
      let (sgr_expr, sgr_p) = parse_expr(p);
      p = sgr_p;
      s_guard = sgr_expr;
      s_has_guard = true;
    }
    p = p.expect("=>");
    let sbody: ast.Stmt[] = [];
    let sbrt: string = "i32";
    if (expr_form) {
      if (p.peek_punct() == "{") {
        let (sbb_body, sbb_rt, sbb_p) = parse_branch_body(p);
        p = sbb_p;
        sbody = sbb_body;
        sbrt = sbb_rt;
      } else {
        let (ser_expr, ser_p) = parse_expr(p);
        p = ser_p;
        sbody = [s_return(ser_expr)];
        sbrt = if_expr_rt(ser_expr);
      }
    } else {
      let (sblk_body, sblk_p) = parse_block(p);
      p = sblk_p;
      sbody = sblk_body;
    }
    if (first) {
      rt = sbrt;
      first = false;
    }
    arms = arms.append(ast.StructArm { is_wild: s_wild, type_name: s_type, binds: s_binds, fields: s_fields, field_kinds: s_field_kinds, field_lits: s_field_lits, field_pats: s_field_pats, at_binding: s_at, rest_written: s_rest, guard: s_guard, has_guard: s_has_guard, body: sbody, line: sline, col: scol });
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  p = p.expect("}");
  return (arms, rt, all_ok, p);
}

function is_compound_assign_op(op: string): boolean {
  return op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%="
    || op == "&=" || op == "|=" || op == "^=" || op == "<<=" || op == ">>=";
}

function branch_stmt_start(p: Par): boolean {
  if (p.peek_punct() == "{") {
    return true;
  }
  let kw: string = p.peek_keyword();
  if (kw == "if" && !p.if_stmt_has_else()) {
    return true;
  }
  if (kw == "while" || kw == "loop" || kw == "for" || kw == "break"
    || kw == "continue" || kw == "return" || kw == "defer"
    || kw == "errdefer" || kw == "let"
    || kw == "function") {
    return true;
  }
  return false;
}

pub function branch_stmts_diverge(stmts: ast.Stmt[]): boolean {
  return stmts_exit(stmts, true);
}

function stmts_exit(stmts: ast.Stmt[], loops: boolean): boolean {
  if (stmts.len() == 0) {
    return false;
  }
  return stmt_exits(stmts[stmts.len() - 1], loops);
}

function stmt_exits(st: ast.Stmt, loops: boolean): boolean {
  match (st) {
    ast.StmtReturn(_) => {
      return true;
    },
    ast.StmtBreak(_) => {
      return true;
    },
    ast.StmtContinue(_) => {
      return true;
    },
    ast.StmtWhile(w) => {
      return loops && w.is_loop;
    },
    ast.StmtIf(f) => {
      if (f.else_body.len() == 0) {
        return false;
      }
      return stmts_exit(f.then_body, loops) && stmts_exit(f.else_body, loops);
    },
    ast.StmtMatch(m) => {
      if (m.arms.len() == 0) {
        return false;
      }
      let i: i32 = 0;
      while (i < m.arms.len()) {
        if (!stmts_exit(m.arms[i].body, loops)) {
          return false;
        }
        i = i + 1;
      }
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function exiting_if_tail(e: ast.Expr): Option[ast.Stmt] {
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lam) = c.callee {
      if (lam.origin != ORIGIN_IF_EXPR || c.args.len() != 0 || lam.body.len() != 1) {
        return None;
      }
      if let ast.StmtIf(f) = lam.body[0] {
        if (branch_exits_early(f.then_body) && branch_exits_early(f.else_body)) {
          return Some(ast.StmtIf { ...f, then_body: without_last(f.then_body), else_body: without_last(f.else_body) });
        }
      }
    }
  }
  return None;
}

pub function branch_exits_early(body: ast.Stmt[]): boolean {
  return body.len() >= 2 && stmt_exits(body[body.len() - 2], false);
}

function without_last(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    out = out.append(body[i]);
    i = i + 1;
  }
  return out;
}

function branch_dead_tail(stmts: ast.Stmt[]): ast.Expr {
  if (stmts.len() == 0) {
    return e_number("0", "", false);
  }
  match (stmts[stmts.len() - 1]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprUnknown(_) => {
          return e_number("0", "", false);
        },
        _ => {
          return r.value;
        }
      }
    },
    _ => {
      return e_number("0", "", false);
    }
  }
  return e_number("0", "", false);
}

function parse_block_items(p: Par): (ast.Stmt[], boolean, ast.Expr, boolean, Par) {
  let leading: ast.Stmt[] = [];
  let have_tail: boolean = false;
  let tail: ast.Expr = e_unknown("empty branch");
  if (p.peek_punct() != "{") {
    return (leading, have_tail, tail, false, p);
  }
  p = p.advance();
  while (p.peek_punct() != "}" && !p.at_end()) {
    let (is_stmt, ip) = item_is_stmt(p);
    p = ip;
    if (is_stmt) {
      let (sr_stmt, sr_p) = parse_stmt(p);
      if (sr_p.pos == p.pos) {
        p = p.advance();
        continue;
      }
      p = sr_p;
      leading = leading.append(sr_stmt);
      continue;
    }
    let before: Par = p;
    let (er_expr, er_p) = parse_expr(p);
    p = er_p;
    if (p.peek_punct() == ";") {
      p = p.advance();
      leading = leading.append(s_expr(er_expr));
      continue;
    }
    if (p.peek_punct() != "}") {
      let (asr_stmt, asr_p) = parse_stmt(before);
      if (asr_p.pos == before.pos) {
        p = p.advance();
        continue;
      }
      p = asr_p;
      leading = leading.append(asr_stmt);
      continue;
    }
    tail = er_expr;
    have_tail = true;
    break;
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (leading, have_tail, tail, true, p);
}

function item_is_stmt(p: Par): (boolean, Par) {
  if (!branch_stmt_start(p)) {
    return (false, p);
  }
  let (tail, q) = nested_block_tail(p);
  return (!tail, q);
}

function tail_item_at(p: Par, tail_value: boolean): (boolean, Par) {
  if (!tail_value) {
    return (false, p);
  }
  let (is_stmt, q) = item_is_stmt(p);
  return (!is_stmt, q);
}

function valueless_branch_tail(p: Par): (boolean, ast.Stmt, Par) {
  let kw: string = p.peek_keyword();
  if (kw != "match" && kw != "if" || kw == "match" && !match_arms_braced(p)) {
    return (false, s_unknown(p, ""), p);
  }
  let (st, q) = parse_stmt(p);
  if (q.type_errs.len() == p.type_errs.len() && q.peek_punct() == "}") {
    return (true, st, q);
  }
  return (false, st, p);
}

function match_arms_braced(p: Par): boolean {
  let depth: i32 = 0;
  let k: i32 = 1;
  while (p.pos + k < p.toks.len()) {
    let t: string = p.peek_punct_at(k);
    if (t == "=>" && depth == 1 && p.peek_punct_at(k + 1) != "{") {
      return false;
    }
    depth = depth + bracket_step(t);
    if (depth == 0 && t == "}") {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function bracket_step(t: string): i32 {
  if (t == "(" || t == "[" || t == "{") {
    return 1;
  }
  if (t == ")" || t == "]" || t == "}") {
    return 0 - 1;
  }
  return 0;
}

function nested_block_tail(p: Par): (boolean, Par) {
  if (p.peek_punct() != "{") {
    return (false, p);
  }
  let k: i32 = util.index_of_i32(p.tail_at, p.pos);
  if (k >= 0) {
    return (p.tail_is[k], p);
  }
  let (nb_leading, nb_have_tail, nb_tail, nb_ok, nb_p) = parse_block_items(p);
  let yes: boolean = nb_ok && nb_have_tail && nb_p.peek_punct() == "}";
  return (yes, Par { ...p, tail_at: nb_p.tail_at.append(p.pos), tail_is: nb_p.tail_is.append(yes) });
}

function parse_branch_body(p: Par): (ast.Stmt[], string, Par) {
  let (body, rt, dead, next) = parse_branch_body_written(p);
  return (body, rt, next);
}

function parse_branch_body_written(p: Par): (ast.Stmt[], string, boolean, Par) {
  let open_line: i32 = p.peek_line();
  let open_col: i32 = p.peek_col();
  let rt: string = "i32";
  let (bi_leading, bi_have_tail, bi_tail, bi_ok, bi_p) = parse_block_items(p);
  if (!bi_ok) {
    let ebody: ast.Stmt[] = [];
    ebody = ebody.append(s_unknown(p, "missing { in branch body"));
    return (ebody, rt, false, p);
  }
  let leading: ast.Stmt[] = bi_leading;
  let have_tail: boolean = bi_have_tail;
  let tail: ast.Expr = bi_tail;
  p = bi_p;
  if (have_tail) {
    rt = if_expr_rt(tail);
  }
  if (!have_tail) {
    if (!branch_stmts_diverge(leading)) {
      leading = leading.append(s_unknown_at("value branch has no trailing expression", open_line, open_col));
      return (leading, rt, false, p);
    }
    let dead: ast.Expr = branch_dead_tail(leading);
    rt = if_expr_rt(dead);
    leading = leading.append(s_return(dead));
    return (leading, rt, true, p);
  }
  leading = leading.append(s_return(tail));
  return (leading, rt, false, p);
}

function parse_if_chain(p: Par): IfChain {
  let (condr_expr, condr_p) = parse_paren_head(p.advance());
  p = condr_p;
  let (thenb_body, thenb_rt, then_dead, thenb_p) = parse_branch_body_written(p);
  let else_written: boolean = thenb_p.peek_keyword() == "else";
  p = thenb_p.expect("else");
  let then_body: ast.Stmt[] = thenb_body;
  let rt: string = thenb_rt;
  let else_body: ast.Stmt[] = [];
  let else_dead = false;
  if (p.peek_keyword() == "if" && else_written) {
    let nested: IfChain = parse_if_chain(p);
    p = nested.par;
    else_body = [nested.stmt];
  } else if (else_written || p.peek_punct() == "{") {
    let (elseb_body, elseb_rt, elseb_dead, elseb_p) = parse_branch_body_written(p);
    p = elseb_p;
    else_body = elseb_body;
    else_dead = elseb_dead;
    rt = wider_rt(rt, elseb_rt);
  }
  let origin = ORIGIN_IF_EXPR;
  if (then_dead && else_dead) {
    origin = ORIGIN_IF_DEAD_BOTH;
  } else if (then_dead) {
    origin = ORIGIN_IF_DEAD_THEN;
  } else if (else_dead) {
    origin = ORIGIN_IF_DEAD_ELSE;
  }
  return IfChain { par: p, stmt: s_if_origin(condr_expr, then_body, else_body, origin), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
}

function parse_match_expr(p: Par): IfChain {
  let mkline: i32 = p.peek_line();
  let mkcol: i32 = p.peek_col();
  let (sr_expr, sr_p) = parse_paren_head(p.advance());
  p = sr_p.expect("{");
  let rt: string = "i32";
  if (p.peek_punct() == "(" || p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek_punct_at(1) == "@" && p.peek_punct_at(2) == "(") {
    let etarms: ast.TupArm[] = [];
    let etfirst: boolean = true;
    while (p.peek_punct() != "}" && !p.at_end()) {
      let etline: i32 = p.peek_line();
      let etcol: i32 = p.peek_col();
      let et_wild: boolean = false;
      let et_empty_body: ast.Stmt[] = [];
      let et_at: string = "";
      if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
        et_at = p.peek_ident();
        p = p.advance();
        p = p.advance();
      }
      let etpats: ast.TupArm[] = [];
      if (p.peek_punct() == "(") {
        let (etpr_elem_kinds, etpr_binds, etpr_lits, etpr_pats, etpr_p) = parse_tuple_arm_pattern(p);
        p = etpr_p;
        if (etpr_elem_kinds.len() == 0) {
          return IfChain { par: p, stmt: s_unknown(p, "bad tuple pattern"), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
        }
        etpats = etpats.append(ast.TupArm { is_wild: false, elem_kinds: etpr_elem_kinds, binds: etpr_binds, lits: etpr_lits, elem_pats: etpr_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: et_empty_body, line: etline, col: etcol, alt_cont: false });
        while (p.peek_punct() == "|") {
          p = p.advance();
          let (etor_kinds, etor_binds, etor_lits, etor_pats, etor_p) = parse_tuple_arm_pattern(p);
          p = etor_p;
          if (etor_kinds.len() == 0) {
            return IfChain { par: p, stmt: s_unknown(p, "bad tuple pattern"), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
          }
          etpats = etpats.append(ast.TupArm { is_wild: false, elem_kinds: etor_kinds, binds: etor_binds, lits: etor_lits, elem_pats: etor_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: et_empty_body, line: etline, col: etcol, alt_cont: false });
        }
      } else {
        let (etwp_pattern, etwp_p) = parse_pattern(p);
        p = etwp_p;
        et_wild = true;
      }
      let et_guard: ast.Expr = e_bool(true);
      let et_has_guard: boolean = false;
      if (p.peek_keyword() == "when") {
        p = p.advance();
        let (etgr_expr, etgr_p) = parse_expr(p);
        p = etgr_p;
        et_guard = etgr_expr;
        et_has_guard = true;
      }
      p = p.expect("=>");
      let etbody: ast.Stmt[] = [];
      let etrt: string = "i32";
      if (p.peek_punct() == "{") {
        let (etbb_body, etbb_rt, etbb_p) = parse_branch_body(p);
        p = etbb_p;
        etbody = etbb_body;
        etrt = etbb_rt;
      } else {
        let (eter_expr, eter_p) = parse_expr(p);
        p = eter_p;
        etbody = [s_return(eter_expr)];
        etrt = if_expr_rt(eter_expr);
      }
      if (etfirst) {
        rt = etrt;
        etfirst = false;
      }
      if (et_wild) {
        let etw_kinds: i32[] = [];
        let etw_pats: ast.Pattern[] = [];
        let etw_binds: string[] = [];
        let etw_lits: ast.Expr[] = [];
        etarms = etarms.append(ast.TupArm { is_wild: true, elem_kinds: etw_kinds, binds: etw_binds, lits: etw_lits, elem_pats: etw_pats, at_binding: "", guard: et_guard, has_guard: et_has_guard, body: etbody, line: etline, col: etcol, alt_cont: false });
      } else {
        let etalt: i32 = 0;
        while (etalt < etpats.len()) {
          let etpa: ast.TupArm = etpats[etalt];
          etarms = etarms.append(ast.TupArm { is_wild: false, elem_kinds: etpa.elem_kinds, binds: etpa.binds, lits: etpa.lits, elem_pats: etpa.elem_pats, at_binding: et_at, guard: et_guard, has_guard: et_has_guard, body: etbody, line: etline, col: etcol, alt_cont: etalt > 0 });
          etalt = etalt + 1;
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
        continue;
      }
      break;
    }
    p = p.expect("}");
    let etval: string = "__tm" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let etvarms: ast.TupArm[] = [];
    let etvi: i32 = 0;
    while (etvi < etarms.len()) {
      let etva: ast.TupArm = etarms[etvi];
      etvarms = etvarms.append(ast.TupArm { ...etva, body: value_arm_body(etva.body, etval) });
      etvi = etvi + 1;
    }
    return IfChain { par: p, stmt: build_tuple_match(sr_expr, etvarms, mkline, mkcol), rt: rt, needs_default_return: false, value_local: etval, scrut_bind: [] };
  }
  if (at_local_struct_pattern(p)) {
    let (smarms, smrt, smok, smp) = parse_struct_match_arms(p, true);
    p = smp;
    if (!smok) {
      return IfChain { par: p, stmt: s_unknown(p, "a struct pattern binds field names"), rt: smrt, needs_default_return: false, value_local: "", scrut_bind: [] };
    }
    let smval: string = "__sm" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let smvarms: ast.StructArm[] = [];
    let smvi: i32 = 0;
    while (smvi < smarms.len()) {
      let smva: ast.StructArm = smarms[smvi];
      smvarms = smvarms.append(ast.StructArm { ...smva, body: value_arm_body(smva.body, smval) });
      smvi = smvi + 1;
    }
    return IfChain { par: p, stmt: build_struct_match(sr_expr, smvarms, mkline, mkcol), rt: smrt, needs_default_return: false, value_local: smval, scrut_bind: [] };
  }
  if (p.peek_is_pat_literal() || p.peek_at_literal()) {
    let lit_arms: ast.LitArm[] = [];
    let lfirst: boolean = true;
    while (p.peek_punct() != "}" && !p.at_end()) {
      let laline: i32 = p.peek_line();
      let lacol: i32 = p.peek_col();
      let lwild: boolean = false;
      let (lat, lat_p) = take_at_binding(p);
      p = lat_p;
      let lalt_lits: ast.Expr[] = [];
      let lalt_his: ast.Expr[] = [];
      let lalt_hrs: boolean[] = [];
      let lalt_incs: boolean[] = [];
      if (p.peek_is_pat_literal()) {
        let (la_lits, la_his, la_hrs, la_incs, la_p) = parse_lit_alts(p);
        p = la_p;
        lalt_lits = la_lits;
        lalt_his = la_his;
        lalt_hrs = la_hrs;
        lalt_incs = la_incs;
      } else {
        let (lpr_pattern, lpr_p) = parse_pattern(p);
        p = lpr_p;
        lwild = true;
      }
      let lguard: ast.Expr = e_bool(true);
      let lhas_guard: boolean = false;
      if (p.peek_keyword() == "when") {
        p = p.advance();
        let (lgr_expr, lgr_p) = parse_expr(p);
        p = lgr_p;
        lguard = lgr_expr;
        lhas_guard = true;
      }
      p = p.expect("=>");
      let lbody: ast.Stmt[] = [];
      let lrt: string = "i32";
      if (p.peek_punct() == "{") {
        let (lbb_body, lbb_rt, lbb_p) = parse_branch_body(p);
        p = lbb_p;
        lbody = lbb_body;
        lrt = lbb_rt;
      } else {
        let (ler_expr, ler_p) = parse_expr(p);
        p = ler_p;
        lbody = [s_return(ler_expr)];
        lrt = if_expr_rt(ler_expr);
      }
      if (lfirst) {
        rt = lrt;
        lfirst = false;
      }
      if (lwild) {
        lit_arms = lit_arms.append(ast.LitArm { is_wild: true, lit: e_bool(true), guard: lguard, has_guard: lhas_guard, body: lbody, line: laline, col: lacol, range_hi: e_bool(true), has_range: false, range_inclusive: false, alt_cont: false, at_binding: "" });
      } else {
        let lai: i32 = 0;
        while (lai < lalt_lits.len()) {
          lit_arms = lit_arms.append(ast.LitArm { is_wild: false, lit: lalt_lits[lai], guard: lguard, has_guard: lhas_guard, body: lbody, line: laline, col: lacol, range_hi: lalt_his[lai], has_range: lalt_hrs[lai], range_inclusive: lalt_incs[lai], alt_cont: lai > 0, at_binding: lat });
          lai = lai + 1;
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
        continue;
      }
      break;
    }
    p = p.expect("}");
    if let ast.ExprIdent(_) = sr_expr {} else {
      let lm: string = literal_scrut_local(mkline, mkcol);
      let lchain: ast.Stmt = build_literal_match(e_ident(lm), lit_arms, mkline, mkcol);
      if let ast.StmtIf(_) = lchain {
        return IfChain { par: p, stmt: with_written_scrut(lchain, sr_expr), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [s_var_at(lm, "", sr_expr, mkline, mkcol)] };
      }
    }
    return IfChain { par: p, stmt: build_literal_match(sr_expr, lit_arms, mkline, mkcol), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
  }
  let arms: ast.MatchArm[] = [];
  let ewritten: ast.MatchArm[] = [];
  let first: boolean = true;
  while (p.peek_punct() != "}" && !p.at_end()) {
    let aline: i32 = p.peek_line();
    let acol: i32 = p.peek_col();
    let (pr_pattern, pr_p) = parse_pattern(p);
    p = pr_p;
    let pats: ast.Pattern[] = [pr_pattern];
    while (p.peek_punct() == "|") {
      p = p.advance();
      let (pr2_pattern, pr2_p) = parse_pattern(p);
      p = pr2_p;
      pats = pats.append(pr2_pattern);
    }
    let arm_guard: ast.Expr = e_bool(true);
    let arm_has_guard: boolean = false;
    if (p.peek_keyword() == "when") {
      p = p.advance();
      let (gr_expr, gr_p) = parse_expr(p);
      p = gr_p;
      arm_guard = gr_expr;
      arm_has_guard = true;
    }
    p = p.expect("=>");
    let abody: ast.Stmt[] = [];
    let art: string = "i32";
    if (p.peek_punct() == "{") {
      let (abb_body, abb_rt, abb_p) = parse_branch_body(p);
      p = abb_p;
      abody = abb_body;
      art = abb_rt;
    } else {
      let (er_expr, er_p) = parse_expr(p);
      p = er_p;
      abody = [s_return(er_expr)];
      art = if_expr_rt(er_expr);
    }
    if (first) {
      rt = art;
      first = false;
    } else {
      rt = wider_rt(rt, art);
    }
    let pi: i32 = 0;
    while (pi < pats.len()) {
      ewritten = ewritten.append(ast.MatchArm { pattern: pats[pi], body: abody, line: aline, col: acol, guard: arm_guard, has_guard: arm_has_guard, alt_cont: pi > 0 });
      let (fa_pat, fa_g, fa_hg) = fold_lit_cond(pats[pi], arm_guard, arm_has_guard);
      arms = arms.append(ast.MatchArm { pattern: fa_pat, body: abody, line: aline, col: acol, guard: fa_g, has_guard: fa_hg, alt_cont: false });
      pi = pi + 1;
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  p = p.expect("}");
  let esugar: ast.MatchArm[] = [];
  if (arms_have_written_form(ewritten)) {
    esugar = ewritten;
  }
  if (arms_have_tuple_subpattern(arms)) {
    let ntval: string = "__nt" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let ntarms: ast.MatchArm[] = [];
    let nti: i32 = 0;
    while (nti < arms.len()) {
      let nta: ast.MatchArm = arms[nti];
      ntarms = ntarms.append(ast.MatchArm { ...nta, body: value_arm_body(nta.body, ntval) });
      nti = nti + 1;
    }
    return IfChain { par: p, stmt: s_match_sugared(sr_expr, desugar_nested_arms(ntarms, 0, ""), esugar, mkline, mkcol), rt: rt, needs_default_return: false, value_local: ntval, scrut_bind: [] };
  }
  if (arms_take_flag_chain(arms)) {
    let naval: string = "__na" + dl_itoa(mkline) + "_" + dl_itoa(mkcol) + "_r";
    let naarms: ast.MatchArm[] = [];
    let nai: i32 = 0;
    while (nai < arms.len()) {
      let naa: ast.MatchArm = arms[nai];
      naarms = naarms.append(ast.MatchArm { ...naa, body: value_arm_body(naa.body, naval) });
      nai = nai + 1;
    }
    return IfChain { par: p, stmt: build_nested_arm_match(sr_expr, naarms, ewritten, mkline, mkcol), rt: rt, needs_default_return: false, value_local: naval, scrut_bind: [] };
  }
  arms = desugar_nested_arms(arms, 0, "");
  return IfChain { par: p, stmt: s_match_sugared(sr_expr, arms, esugar, mkline, mkcol), rt: rt, needs_default_return: false, value_local: "", scrut_bind: [] };
}

function arms_have_tuple_subpattern(arms: ast.MatchArm[]): boolean {
  let i: i32 = 0;
  while (i < arms.len()) {
    match (arms[i].pattern) {
      ast.PatVariant(pv) => {
        if (pv.tup_kinds.len() > 0) {
          return true;
        }
      },
      ast.PatWildcard(w) => {}
    }
    i = i + 1;
  }
  return false;
}

function pipe_prepend(head: ast.Expr, tail: ast.Expr[]): ast.Expr[] {
  let out: ast.Expr[] = [head];
  let i: i32 = 0;
  while (i < tail.len()) {
    out = out.append(tail[i]);
    i = i + 1;
  }
  return out;
}

function pipe_is_hole(e: ast.Expr): boolean {
  match (fda_marker_value(e)) {
    ast.ExprIdent(id) => {
      return id.name == "_";
    },
    _ => {
      return false;
    }
  }
  return false;
}

function pipe_fill(e: ast.Expr, left: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      if (b.op == "__named_arg") {
        return ast.ExprBinary { ...b, right: left };
      }
    },
    _ => {}
  }
  return left;
}

function pipe_desugar(left: ast.Expr, right: ast.Expr): ast.Expr {
  match (right) {
    ast.ExprCall(c) => {
      let hole: i32 = 0 - 1;
      let hi: i32 = 0;
      while (hi < c.args.len()) {
        if (pipe_is_hole(c.args[hi])) {
          if (hole >= 0) {
            let extra: ast.Expr = fda_marker_value(c.args[hi]);
            return e_unknown_at(coded_kind("P004", "at most one `_` placeholder in a piped call"), ast.expr_line(extra), ast.expr_col(extra));
          }
          hole = hi;
        }
        hi = hi + 1;
      }
      if (hole >= 0) {
        let subst: ast.Expr[] = [];
        let si: i32 = 0;
        while (si < c.args.len()) {
          if (si == hole) {
            subst = subst.append(pipe_fill(c.args[si], left));
          } else {
            subst = subst.append(c.args[si]);
          }
          si = si + 1;
        }
        return e_call(c.callee, subst);
      }
      return e_call(c.callee, pipe_prepend(left, c.args));
    },
    _ => {
      let one: ast.Expr[] = [left];
      return e_call(right, one);
    }
  }
}

function parse_range(p: Par): (ast.Expr, Par) {
  let (left_expr, left_p) = parse_binary(p, 1);
  p = left_p;
  let pk: string = p.peek_punct();
  if (pk == ".." || pk == "..=") {
    let rline: i32 = p.peek_line();
    let rcol: i32 = p.peek_col();
    p = p.advance();
    let fn: string = "range";
    if (pk == "..=") {
      fn = "range_incl";
    }
    let (right_expr, right_p) = parse_binary(p, 1);
    p = right_p;
    let callee: ast.Expr = e_field_access_at(e_ident_at("iter", rline, rcol), fn, rline, rcol);
    let args: ast.Expr[] = [left_expr, right_expr];
    return (e_call(callee, args), p);
  }
  return (left_expr, p);
}

function parse_pipe(p: Par): (ast.Expr, Par) {
  let (left_expr, left_p) = parse_range(p);
  p = left_p;
  let acc: ast.Expr = left_expr;
  while (p.peek_punct() == "|>") {
    p = p.advance();
    let (right_expr, right_p) = parse_range(p);
    p = right_p;
    if (p.verbatim) {
      acc = e_binary("|>", acc, right_expr);
      continue;
    }
    acc = pipe_desugar(acc, right_expr);
  }
  return (acc, p);
}

function parse_paren_head(p: Par): (ast.Expr, Par) {
  let opened: boolean = p.peek_punct() == "(";
  let (e, ep) = parse_expr(p.expect("("));
  if (opened || ep.peek_punct() == ")") {
    return (e, ep.expect(")"));
  }
  return (e, ep);
}

function parse_let_else_tail(p: Par): (ast.Stmt[], ast.Stmt[], Par) {
  let else_body: ast.Stmt[] = [];
  let written: boolean = p.peek_keyword() == "else";
  p = p.expect("else");
  if (written || p.peek_punct() == "{") {
    let (eb, ep) = parse_block(p);
    else_body = eb;
    p = ep;
  }
  p = p.expect_semi();
  let rest: ast.Stmt[] = [];
  while (p.peek_punct() != "}" && !p.at_end()) {
    let (rs, rp) = parse_stmt(p);
    if (rp.pos == p.pos) {
      p = p.advance();
      continue;
    }
    p = rp;
    rest = rest.append(rs);
  }
  return (else_body, rest, p);
}

function parse_block(p: Par): (ast.Stmt[], Par) {
  if (p.peek_punct() != "{") {
    let kind: string = "missing { in block";
    if (p.reported_at(p.peek_line(), p.peek_col())) {
      kind = REPORTED;
    }
    let miss: ast.Stmt[] = [s_unknown(p, kind)];
    let open: Par = p.skip_to_open();
    if (open.peek_punct() != "{") {
      return (miss, p);
    }
    let (skipped, sp) = parse_block(open);
    return (miss, sp);
  }
  p = p.advance();
  let (r_body, r_p) = parse_block_body(p, false);
  p = r_p;
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (r_body, p);
}

function parse_block_body(p: Par, tail_value: boolean): (ast.Stmt[], Par) {
  if (p.too_deep_by(BLOCK_NEST_UNITS)) {
    return ([s_unknown_at("nest:too-deep", p.peek_line(), p.peek_col())], p.bail());
  }
  let (g0, gq) = parse_block_body_nested(p.with_depth(p.depth + BLOCK_NEST_UNITS), tail_value);
  return (g0, gq.with_depth(p.depth));
}

function parse_lambda_body(p: Par): (ast.Stmt[], Par) {
  if (p.peek_punct() != "{") {
    return ([s_unknown(p, "missing { in lambda body")], p);
  }
  p = p.advance();
  let (lb_body, lb_p) = parse_block_body(p, true);
  p = lb_p;
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (lb_body, p);
}

function parse_block_body_nested(p: Par, tail_value: boolean): (ast.Stmt[], Par) {
  let body: ast.Stmt[] = [];
  while (p.peek_punct() != "}" && !p.at_end()) {
    if (p.peek_keyword() == "use") {
      let uline: i32 = p.peek_line();
      let ucol: i32 = p.peek_col();
      p = p.advance();
      let ubad: ast.Stmt[] = [];
      let uname: string = p.peek_ident();
      if (uname.len() > 0) {
        p = p.advance();
      } else {
        ubad = [s_unknown(p, "expected a name, got " + tok_desc(p.peek()))];
      }
      let utype: string = "";
      if (p.peek_punct() == ":") {
        p = p.advance();
        let (utn_name, utn_fn_ret, utn_p) = parse_type_name(p);
        p = utn_p;
        utype = utn_name;
      }
      if (p.peek_punct() == "<") {
        p = p.advance();
      } else if (ubad.len() == 0) {
        ubad = [s_unknown(p, "expected \"<\", got " + tok_desc(p.peek()))];
      }
      if (p.peek_punct() == "-") {
        p = p.advance();
      } else if (ubad.len() == 0) {
        ubad = [s_unknown(p, "expected \"-\", got " + tok_desc(p.peek()))];
      }
      let (usrc_expr, usrc_p) = parse_expr(p);
      p = usrc_p;
      p = p.end_of(usrc_expr);
      let (rest_body, rest_p) = parse_block_body(p, false);
      p = rest_p;
      let cbparam: ast.ParamDecl = ast.ParamDecl { name: uname, type_name: utype, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" };
      let cbparams: ast.ParamDecl[] = [cbparam];
      let cb: ast.Expr = ast.ExprLambda { params: cbparams, ret_type: "", body: rest_body, use_infer: utype.len() == 0, origin: ORIGIN_USE, line: uline, col: ucol, captures: [], captures_known: false, ret_fn_ret: "", ret_fn_param_types: "" };
      if (ubad.len() > 0) {
        return (body.append(ubad[0]), p);
      }
      match (usrc_expr) {
        ast.ExprCall(c) => {
          let newargs: ast.Expr[] = c.args.append(cb);
          body = body.append(s_return_at(ast.ExprCall { ...c, args: newargs }, uline, ucol));
        },
        _ => {
          body = body.append(s_unknown_at("use expression must be a function call (so the callback can be appended as the last arg)", uline, ucol));
        }
      }
      return (body, p);
    }
    if (tail_value) {
      let (vb_ok, vb_stmt, vb_p) = valueless_branch_tail(p);
      if (vb_ok) {
        p = vb_p;
        body = body.append(vb_stmt);
        continue;
      }
    }
    let (tail_item, tp) = tail_item_at(p, tail_value);
    p = tp;
    if (tail_item) {
      let (tv_expr, tv_p) = parse_expr(p);
      if (tv_p.peek_punct() == "}") {
        body = body.append(s_return(tv_expr));
        return (body, tv_p);
      }
    }
    let (r_stmt, r_p) = parse_stmt(p);
    if (r_p.pos == p.pos) {
      p = p.advance();
      continue;
    }
    p = r_p;
    body = body.append(r_stmt);
  }
  return (body, p);
}

function parse_block_or_stmt(p: Par): (ast.Stmt[], Par) {
  if (p.peek_punct() == "{") {
    return parse_block(p);
  }
  let (r_stmt, r_p) = parse_stmt(p);
  if (r_p.pos == p.pos) {
    let none: ast.Stmt[] = [s_unknown(p, "missing statement in braceless body")];
    return (none, p.advance());
  }
  let one: ast.Stmt[] = [r_stmt];
  return (one, r_p);
}

function parse_pattern(p: Par): (ast.Pattern, Par) {
  if (p.too_deep()) {
    return (p_wildcard(), p.bail());
  }
  let (g0, gq) = parse_pattern_nested(p.with_depth(p.depth + 1));
  return (g0, gq.with_depth(p.depth));
}

function parse_pattern_nested(p: Par): (ast.Pattern, Par) {
  let lit_cond: ast.Expr = e_bool(true);
  let has_lit_cond: boolean = false;
  let tup_kinds: i32[] = [];
  let tup_binds: string[] = [];
  let tup_lits: ast.Expr[] = [];
  let tup_pats: ast.Pattern[] = [];
  let name: string = p.peek_ident();
  let at_binding: string = "";
  if (name.len() > 0 && name != "_" && p.peek2_punct() == "@") {
    at_binding = name;
    p = p.advance();
    p = p.advance();
    name = p.peek_ident();
  }
  if (name.len() == 0) {
    name = p.peek_keyword();
  }
  if (name == "_") {
    p = p.advance();
    return (p_wildcard(), p);
  }
  if (p.peek_is_pat_literal()) {
    p = p.advance();
    return (p_variant("", ""), p);
  }
  if (name.len() == 0) {
    return (p_variant("", ""), p);
  }
  p = p.advance();
  while (p.peek_punct() == ".") {
    p = p.advance();
    let seg: string = p.peek_ident();
    if (seg.len() == 0) {
      seg = p.peek_keyword();
    }
    if (seg.len() == 0) {
      break;
    }
    name = name + "." + seg;
    p = p.advance();
  }
  let binding: string = "";
  let extra_bindings: string[] = [];
  let nested: ast.Pattern[] = [];
  if (p.peek_punct() == "{") {
    return parse_record_variant_pattern(p, name, at_binding);
  }
  if (p.peek_punct() == "(") {
    p = p.advance();
    let bn: i32 = 0;
    while (p.peek_punct() != ")" && !p.at_end()) {
      if (p.peek_ident().len() > 0
        && (p.peek2_punct() == "(" || p.peek2_punct() == "{" || p.peek2_punct() == "." || p.peek2_punct() == "@")) {
        let sub_line: i32 = p.peek_line();
        let sub_col: i32 = p.peek_col();
        let (sub_pat, sub_p) = parse_pattern(p);
        p = sub_p;
        let nslot: string = "__np" + dl_itoa(sub_line) + "_" + dl_itoa(sub_col) + "_" + dl_itoa(bn);
        if (bn == 0) {
          binding = nslot;
        } else {
          extra_bindings = extra_bindings.append(nslot);
        }
        while (nested.len() < bn) {
          nested = nested.append(p_wildcard());
        }
        nested = nested.append(sub_pat);
        bn = bn + 1;
      } else if (bn == 0 && p.peek_punct() == "(") {
        let (tk, tb, tl, tpp, tp) = parse_tuple_arm_pattern(p);
        p = tp;
        tup_kinds = tk;
        tup_binds = tb;
        tup_lits = tl;
        tup_pats = tpp;
        binding = "__tupslot";
        bn = bn + 1;
      } else if (p.peek_is_pat_literal()) {
        let lit_line: i32 = p.peek_line();
        let lit_col: i32 = p.peek_col();
        let (lit_expr, lit_p) = parse_binary(p, 4);
        p = lit_p;
        let slot: string = "__pl" + dl_itoa(lit_line) + "_" + dl_itoa(lit_col);
        if (bn == 0) {
          binding = slot;
        } else {
          extra_bindings = extra_bindings.append(slot);
        }
        let one: ast.Expr = e_binary("==", e_ident(slot), lit_expr);
        let rng: string = p.peek_punct();
        if (rng == ".." || rng == "..=") {
          p = p.advance();
          let (hi_expr, hi_p) = parse_binary(p, 4);
          p = hi_p;
          let hi_op: string = "<";
          if (rng == "..=") {
            hi_op = "<=";
          }
          one = e_binary("&&", e_binary(">=", e_ident(slot), lit_expr), e_binary(hi_op, e_ident(slot), hi_expr));
        }
        if (has_lit_cond) {
          lit_cond = e_binary("&&", lit_cond, one);
        } else {
          lit_cond = one;
        }
        has_lit_cond = true;
        bn = bn + 1;
      } else {
        let inner: string = p.peek_ident();
        if (inner.len() > 0) {
          if (bn == 0) {
            binding = inner;
          } else {
            extra_bindings = extra_bindings.append(inner);
          }
          bn = bn + 1;
          p = p.advance();
        } else {
          p = p.advance();
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
      }
    }
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
    if (nested.len() > 0) {
      while (nested.len() < bn) {
        nested = nested.append(p_wildcard());
      }
    }
  }
  let no_fields: string[] = [];
  return (ast.PatVariant { type_name: name, binding: binding, extra_bindings: extra_bindings, nested: nested, at_binding: at_binding, field_names: no_fields, lit_cond: lit_cond, has_lit_cond: has_lit_cond, tup_kinds: tup_kinds, tup_binds: tup_binds, tup_lits: tup_lits, tup_pats: tup_pats, rest_written: false }, p);
}

function parse_record_variant_pattern(p: Par, name: string, at_binding: string): (ast.Pattern, Par) {
  let tag: string = dl_itoa(p.peek_line()) + "_" + dl_itoa(p.peek_col()) + "_";
  let (sap, sp) = parse_struct_arm_pattern(p);
  let slots: string[] = [];
  let nested: ast.Pattern[] = [];
  let any_nested: boolean = false;
  let lit_cond: ast.Expr = e_bool(true);
  let has_lit_cond: boolean = false;
  let k: i32 = 0;
  while (k < sap.fields.len()) {
    let slot: string = sap.binds[k];
    let sub: ast.Pattern = p_wildcard();
    if (sap.kinds[k] == 2) {
      slot = "__pl" + tag + dl_itoa(k);
      lit_cond = and_cond(lit_cond, has_lit_cond, e_binary("==", e_ident(slot), sap.lits[k]));
      has_lit_cond = true;
    } else if (sap.kinds[k] == 3) {
      slot = "__np" + tag + dl_itoa(k);
      sub = sap.pats[k];
      any_nested = true;
    }
    slots = slots.append(slot);
    nested = nested.append(sub);
    k = k + 1;
  }
  if (!any_nested) {
    nested = [];
  }
  let (binding, extra) = split_payload_slots(slots);
  let no_tup_kinds: i32[] = [];
  let no_tup_binds: string[] = [];
  let no_tup_lits: ast.Expr[] = [];
  let no_tup_pats: ast.Pattern[] = [];
  return (ast.PatVariant { type_name: name, binding: binding, extra_bindings: extra, nested: nested, at_binding: at_binding, field_names: sap.fields, lit_cond: lit_cond, has_lit_cond: has_lit_cond, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats, rest_written: sap.rest_written }, sp);
}

function and_cond(acc: ast.Expr, has_acc: boolean, one: ast.Expr): ast.Expr {
  if (has_acc) {
    return e_binary("&&", acc, one);
  }
  return one;
}

function split_payload_slots(slots: string[]): (string, string[]) {
  let extra: string[] = [];
  if (slots.len() == 0) {
    return ("", extra);
  }
  let k: i32 = 1;
  while (k < slots.len()) {
    extra = extra.append(slots[k]);
    k = k + 1;
  }
  return (slots[0], extra);
}

function prepend_stmt(s: ast.Stmt, body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  out = out.append(s);
  let i: i32 = 0;
  while (i < body.len()) {
    out = out.append(body[i]);
    i = i + 1;
  }
  return out;
}

pub function pv_tup(pat: ast.Pattern): (i32[], string[], ast.Expr[], ast.Pattern[]) {
  let no_k: i32[] = [];
  let no_b: string[] = [];
  let no_l: ast.Expr[] = [];
  let no_p: ast.Pattern[] = [];
  match (pat) {
    ast.PatVariant(v) => {
      return (v.tup_kinds, v.tup_binds, v.tup_lits, v.tup_pats);
    },
    ast.PatWildcard(w) => {
      return (no_k, no_b, no_l, no_p);
    }
  }
  return (no_k, no_b, no_l, no_p);
}

function pv_name(pat: ast.Pattern): string {
  match (pat) {
    ast.PatVariant(v) => {
      return v.type_name;
    },
    ast.PatWildcard(w) => {
      return "";
    }
  }
  return "";
}

function arm_is_nested(arm: ast.MatchArm): boolean {
  match (arm.pattern) {
    ast.PatVariant(v) => {
      return v.nested.len() > 0 || v.tup_kinds.len() > 0;
    },
    ast.PatWildcard(w) => {
      return false;
    }
  }
  return false;
}

function arms_take_flag_chain(arms: ast.MatchArm[]): boolean {
  let any_nested: boolean = false;
  let i: i32 = 0;
  while (i < arms.len()) {
    match (arms[i].pattern) {
      ast.PatVariant(v) => {
        if (v.tup_kinds.len() > 0) {
          return false;
        }
        if (v.nested.len() > 0) {
          any_nested = true;
        }
      },
      ast.PatWildcard(w) => {}
    }
    i = i + 1;
  }
  return any_nested;
}

function clear_nested_pat(pv: ast.PatVariant): ast.Pattern {
  let none: ast.Pattern[] = [];
  return ast.PatVariant { ...pv, nested: none };
}

pub function payload_binder(pv: ast.PatVariant, i: i32): string {
  if (i == 0) {
    return pv.binding;
  }
  if (i - 1 < pv.extra_bindings.len()) {
    return pv.extra_bindings[i - 1];
  }
  return "";
}

function record_field_list(fields: string[]): string {
  let out: string = "";
  for field in fields {
    if (out.len() > 0) {
      out = out + ",";
    }
    out = out + field;
  }
  return out;
}

function record_binding_list(names: string[], line: i32, col: i32): string {
  let out: string[] = [];
  let i: i32 = 0;
  for name in names {
    out = out.append(discard_name(name, line, col, i));
    i = i + 1;
  }
  return record_field_list(out);
}

pub function lower_struct_record_match(m: ast.StmtMatch, value: string): ast.Stmt {
  let arms: ast.StructArm[] = [];
  let written: ast.MatchArm[] = m.arms;
  if (m.sugar.len() > 0) {
    written = m.sugar;
  }
  for arm in written {
    let fields: string[] = [];
    let binds: string[] = [];
    let at: string = "";
    let name: string = "";
    let rest: boolean = false;
    let wild: boolean = true;
    let kinds: i32[] = [];
    let lits: ast.Expr[] = [];
    let pats: ast.Pattern[] = [];
    if let ast.PatVariant(pv) = arm.pattern {
      wild = false;
      fields = pv.field_names;
      name = pv.type_name;
      at = pv.at_binding;
      rest = pv.rest_written;
      let i: i32 = 0;
      while (i < fields.len()) {
        let bind: string = payload_binder(pv, i);
        binds = binds.append(bind);
        let kind: i32 = 0;
        let lit: ast.Expr = e_bool(true);
        let pat: ast.Pattern = p_wildcard();
        if let Some(found) = record_slot_literal(pv.lit_cond, bind) {
          kind = 2;
          lit = found;
        } else {
          if (i < pv.nested.len() && pv_name(pv.nested[i]).len() > 0) {
            kind = 3;
            pat = pv.nested[i];
          }
        }
        kinds = kinds.append(kind);
        lits = lits.append(lit);
        pats = pats.append(pat);
        i = i + 1;
      }
    }
    let body: ast.Stmt[] = arm.body;
    if (value.len() > 0) {
      body = value_arm_body(body, value);
    }
    arms = arms.append(ast.StructArm { is_wild: wild, type_name: name, binds: binds, fields: fields, field_kinds: kinds, field_lits: lits, field_pats: pats, at_binding: at, rest_written: rest, guard: arm.guard, has_guard: arm.has_guard, body: body, line: arm.line, col: arm.col });
  }
  return with_sugar_origin(build_struct_match_fields(m.scrutinee, arms, m.line, m.col, true), m.origin);
}

function record_slot_literal(cond: ast.Expr, slot: string): Option[ast.Expr] {
  if let ast.ExprBinary(b) = cond {
    if (b.op == "&&") {
      if let Some(found) = record_slot_literal(b.left, slot) {
        return Some(found);
      }
      return record_slot_literal(b.right, slot);
    }
    if let ast.ExprIdent(id) = b.left {
      if (b.op == "==" && id.name == slot) {
        return Some(b.right);
      }
    }
  }
  return None;
}

pub function struct_record_source(st: ast.Stmt): Option[ast.StmtMatch] {
  if let ast.StmtMatch(m) = st {
    return Some(m);
  }
  if let ast.StmtIf(f) = st {
    let sg: ast.MatchSugar = f.sugar;
    if (sg.arms.len() > 0) {
      return Some(ast.StmtMatch { scrutinee: sg.scrut, arms: sg.arms, sugar: [], line: sg.line, col: sg.col, origin: sg.origin });
    }
  }
  return None;
}

pub function struct_record_value_body(m: ast.StmtMatch, rt: string): ast.Stmt[] {
  let value: string = "__sm" + dl_itoa(m.line) + "_" + dl_itoa(m.col) + "_r";
  return [s_var(value, "", zero_expr_for(rt)), lower_struct_record_match(m, value), s_return(e_ident(value))];
}

pub function struct_record_head(m: ast.StmtMatch): string {
  let name: string = "";
  for arm in m.arms {
    if let ast.PatVariant(pv) = arm.pattern {
      if (!is_record_pattern(pv) || name.len() > 0 && name != pv.type_name) {
        return "";
      }
      name = pv.type_name;
    }
  }
  return name;
}

function match_sub_pattern(path: ast.Stmt[], scrut: string, pat: ast.Pattern, line: i32, col: i32): ast.Stmt[] {
  let body: ast.Stmt[] = path;
  let flat: ast.Pattern = pat;
  let tuple_slot: boolean = false;
  match (pat) {
    ast.PatVariant(pv) => {
      if (pv.tup_kinds.len() > 0) {
        tuple_slot = true;
      } else {
        body = wrap_payload_pats(path, pv, line, col);
        flat = clear_nested_pat(pv);
      }
    },
    ast.PatWildcard(w) => {}
  }
  let (mk_pat, mk_guard, mk_hg) = fold_lit_cond(flat, e_bool(true), false);
  let mk_arms: ast.MatchArm[] = [];
  mk_arms = mk_arms.append(ast.MatchArm { pattern: mk_pat, body: body, line: line, col: col, guard: mk_guard, has_guard: mk_hg, alt_cont: false });
  let mk_skip: ast.Stmt[] = [];
  mk_arms = mk_arms.append(ast.MatchArm { pattern: p_wildcard(), body: mk_skip, line: line, col: col, guard: e_bool(true), has_guard: false, alt_cont: false });
  if (tuple_slot) {
    mk_arms = desugar_nested_arms(mk_arms, 0, scrut);
  }
  return [s_match_origin(e_ident_at(scrut, line, col), mk_arms, line, col, ORIGIN_PATTERN_PROBE)];
}

function wrap_payload_pats(path: ast.Stmt[], pv: ast.PatVariant, line: i32, col: i32): ast.Stmt[] {
  let cur: ast.Stmt[] = path;
  let wi: i32 = pv.nested.len() - 1;
  while (wi >= 0) {
    if (pv_name(pv.nested[wi]) != "") {
      cur = match_sub_pattern(cur, payload_binder(pv, wi), pv.nested[wi], line, col);
    }
    wi = wi - 1;
  }
  return cur;
}

function build_nested_arm_match(scrut: ast.Expr, arms: ast.MatchArm[], written: ast.MatchArm[], mkline: i32, mkcol: i32): ast.Stmt {
  let base: string = "__na" + util.i32_to_string(mkline) + "_" + util.i32_to_string(mkcol);
  let sname: string = base + "_s";
  let done: string = base + "_d";
  let outer: ast.Stmt[] = [];
  outer = outer.append(s_var_at(sname, "", scrut, mkline, mkcol));
  outer = outer.append(s_var(done, "", e_bool(false)));
  let ai: i32 = 0;
  while (ai < arms.len()) {
    let a: ast.MatchArm = arms[ai];
    let cond: ast.Expr = e_unary("!", e_ident(done));
    let flagged: ast.Stmt[] = [];
    flagged = flagged.append(s_assign(done, e_bool(true)));
    let bi: i32 = 0;
    while (bi < a.body.len()) {
      flagged = flagged.append(a.body[bi]);
      bi = bi + 1;
    }
    let inner: ast.Stmt[] = [];
    match (a.pattern) {
      ast.PatWildcard(w) => {
        if (a.has_guard) {
          cond = e_binary("&&", cond, a.guard);
        }
        inner = flagged;
      },
      ast.PatVariant(pv) => {
        let path: ast.Stmt[] = flagged;
        if (a.has_guard) {
          path = [s_if(a.guard, flagged, [])];
        }
        path = wrap_payload_pats(path, pv, a.line, a.col);
        let (fp, fg, fhg) = fold_lit_cond(clear_nested_pat(pv), e_bool(true), false);
        let marms: ast.MatchArm[] = [];
        marms = marms.append(ast.MatchArm { pattern: fp, body: path, line: a.line, col: a.col, guard: fg, has_guard: fhg, alt_cont: false });
        let skip: ast.Stmt[] = [];
        marms = marms.append(ast.MatchArm { pattern: p_wildcard(), body: skip, line: a.line, col: a.col, guard: e_bool(true), has_guard: false, alt_cont: false });
        inner = [s_match_origin(e_ident_at(sname, a.line, a.col), marms, a.line, a.col, ORIGIN_PATTERN_PROBE)];
      }
    }
    outer = outer.append(s_if(cond, inner, []));
    ai = ai + 1;
  }
  let sugar_arms: ast.MatchArm[] = arms;
  if (written.len() > 0) {
    sugar_arms = written;
  }
  return s_if_match(outer, ast.MatchSugar { ...no_match_sugar(), scrut: scrut, arms: sugar_arms, line: mkline, col: mkcol });
}

function desugar_nested_arms(arms: ast.MatchArm[], depth: i32, tag: string): ast.MatchArm[] {
  let seen_nested: boolean = false;
  let s: i32 = 0;
  while (s < arms.len()) {
    if (arm_is_nested(arms[s])) {
      seen_nested = true;
    }
    s = s + 1;
  }
  if (!seen_nested) {
    return arms;
  }
  let fall: ast.Stmt[] = [];
  let has_fall: boolean = false;
  if (arms.len() > 0) {
    let last: ast.MatchArm = arms[arms.len() - 1];
    if (pv_name(last.pattern) == "" && !last.has_guard) {
      fall = last.body;
      has_fall = true;
    }
  }
  let out: ast.MatchArm[] = [];
  let i: i32 = 0;
  while (i < arms.len()) {
    let vn: string = pv_name(arms[i].pattern);
    if (vn == "") {
      out = out.append(arms[i]);
      i = i + 1;
    } else {
      let j: i32 = i;
      while (j < arms.len() && pv_name(arms[j].pattern) == vn) {
        j = j + 1;
      }
      let any_nested: boolean = false;
      let k: i32 = i;
      while (k < j) {
        if (arm_is_nested(arms[k])) {
          any_nested = true;
        }
        k = k + 1;
      }
      if (!any_nested) {
        let c: i32 = i;
        while (c < j) {
          out = out.append(arms[c]);
          c = c + 1;
        }
      } else {
        out = out.append(build_merged_arm(vn, arms, i, j, fall, has_fall, depth, tag));
      }
      i = j;
    }
  }
  return out;
}

function group_has_tuple(arms: ast.MatchArm[], lo: i32, hi: i32): boolean {
  let i: i32 = lo;
  while (i < hi) {
    match (arms[i].pattern) {
      ast.PatVariant(v) => {
        if (v.tup_kinds.len() > 0) {
          return true;
        }
      },
      ast.PatWildcard(w) => {}
    }
    i = i + 1;
  }
  return false;
}

function tuple_elems_irrefutable(kinds: i32[], pats: ast.Pattern[]): boolean {
  let i: i32 = 0;
  while (i < kinds.len()) {
    if (kinds[i] == 2 || kinds[i] == 3) {
      return false;
    }
    if (kinds[i] == 4) {
      let (nk, nb, nl, np) = pv_tup(pats[i]);
      if (!tuple_elems_irrefutable(nk, np)) {
        return false;
      }
    }
    i = i + 1;
  }
  return true;
}

function build_merged_arm(vn: string, arms: ast.MatchArm[], lo: i32, hi: i32, fall: ast.Stmt[], has_fall: boolean, depth: i32, tag: string): ast.MatchArm {
  let gp_line: i32 = arms[lo].line;
  let gp_col: i32 = arms[lo].col;
  let tmp: string = "__nest_" + util.i32_to_string(gp_line) + "_" + util.i32_to_string(gp_col) + "_" + util.i32_to_string(depth) + tag;
  let inner: ast.MatchArm[] = [];
  let has_inner_wild: boolean = false;
  let k: i32 = lo;
  while (k < hi) {
    let g: ast.MatchArm = arms[k];
    let inner_pat: ast.Pattern = p_wildcard();
    let inner_body: ast.Stmt[] = g.body;
    match (g.pattern) {
      ast.PatVariant(gv) => {
        if (gv.nested.len() > 0) {
          inner_pat = gv.nested[0];
        } else if (gv.binding.len() > 0 && gv.binding != "_") {
          inner_body = prepend_stmt(s_var(gv.binding, "", e_ident(tmp)), g.body);
        }
      },
      ast.PatWildcard(w) => {}
    }
    if (pv_name(inner_pat) == "" && !g.has_guard) {
      has_inner_wild = true;
    }
    let (fn_pat, fn_g, fn_hg) = fold_lit_cond(inner_pat, g.guard, g.has_guard);
    inner = inner.append(ast.MatchArm { pattern: fn_pat, body: inner_body, line: g.line, col: g.col, guard: fn_g, has_guard: fn_hg, alt_cont: false });
    k = k + 1;
  }
  if (!has_inner_wild && has_fall) {
    inner = inner.append(ast.MatchArm { pattern: p_wildcard(), body: fall, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false, alt_cont: false });
  }
  if (group_has_tuple(arms, lo, hi)) {
    let tarms: ast.TupArm[] = [];
    let no_k: i32[] = [];
    let no_p: ast.Pattern[] = [];
    let no_b: string[] = [];
    let no_l: ast.Expr[] = [];
    let tuple_covers: boolean = false;
    let q: i32 = lo;
    while (q < hi) {
      let ga: ast.MatchArm = arms[q];
      match (ga.pattern) {
        ast.PatVariant(gv2) => {
          if (gv2.tup_kinds.len() > 0) {
            if (!ga.has_guard && tuple_elems_irrefutable(gv2.tup_kinds, gv2.tup_pats)) {
              tuple_covers = true;
            }
            tarms = tarms.append(ast.TupArm { is_wild: false, elem_kinds: gv2.tup_kinds, binds: gv2.tup_binds, lits: gv2.tup_lits, elem_pats: gv2.tup_pats, at_binding: "", guard: ga.guard, has_guard: ga.has_guard, body: ga.body, line: ga.line, col: ga.col, alt_cont: false });
          } else {
            let b2: ast.Stmt[] = ga.body;
            if (gv2.binding.len() > 0 && gv2.binding != "_") {
              b2 = prepend_stmt(s_var(gv2.binding, "", e_ident(tmp)), ga.body);
            }
            if (!ga.has_guard) {
              tuple_covers = true;
            }
            tarms = tarms.append(ast.TupArm { is_wild: true, elem_kinds: no_k, binds: no_b, lits: no_l, elem_pats: no_p, at_binding: "", guard: ga.guard, has_guard: ga.has_guard, body: b2, line: ga.line, col: ga.col, alt_cont: false });
          }
        },
        ast.PatWildcard(w2) => {}
      }
      q = q + 1;
    }
    if (!tuple_covers && has_fall) {
      tarms = tarms.append(ast.TupArm { is_wild: true, elem_kinds: no_k, binds: no_b, lits: no_l, elem_pats: no_p, at_binding: "", guard: e_bool(true), has_guard: false, body: fall, line: gp_line, col: gp_col, alt_cont: false });
    }
    let tmatch: ast.Stmt = build_tuple_match(e_ident(tmp), tarms, gp_line, gp_col);
    let t_no_extra: string[] = [];
    let t_no_nested: ast.Pattern[] = [];
    let t_nk: i32[] = [];
    let t_nb: string[] = [];
    let t_nl: ast.Expr[] = [];
    let t_np: ast.Pattern[] = [];
    let t_merged: ast.Pattern = ast.PatVariant { type_name: vn, binding: tmp, extra_bindings: t_no_extra, nested: t_no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: t_nk, tup_binds: t_nb, tup_lits: t_nl, tup_pats: t_np, rest_written: false };
    let t_body: ast.Stmt[] = [tmatch];
    return ast.MatchArm { pattern: t_merged, body: t_body, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false, alt_cont: false };
  }
  let inner_desugared: ast.MatchArm[] = desugar_nested_arms(inner, depth + 1, tag);
  let inner_match: ast.Stmt = s_match_at(e_ident(tmp), inner_desugared, gp_line, gp_col);
  let no_extra: string[] = [];
  let no_nested: ast.Pattern[] = [];
  let no_tup_kinds: i32[] = [];
  let no_tup_binds: string[] = [];
  let no_tup_lits: ast.Expr[] = [];
  let no_tup_pats: ast.Pattern[] = [];
  let merged_pat: ast.Pattern = ast.PatVariant { type_name: vn, binding: tmp, extra_bindings: no_extra, nested: no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats, rest_written: false };
  let body: ast.Stmt[] = [inner_match];
  return ast.MatchArm { pattern: merged_pat, body: body, line: gp_line, col: gp_col, guard: e_bool(true), has_guard: false, alt_cont: false };
}

function parse_match_stmt(p: Par): (ast.Stmt, Par) {
  let mkline: i32 = p.peek_line();
  let mkcol: i32 = p.peek_col();
  let (sr_expr, sr_p) = parse_paren_head(p.advance());
  p = sr_p.expect("{");
  if (p.peek_punct() == "(" || p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek_punct_at(1) == "@" && p.peek_punct_at(2) == "(") {
    let tarms: ast.TupArm[] = [];
    while (p.peek_punct() != "}" && !p.at_end()) {
      let taline: i32 = p.peek_line();
      let tacol: i32 = p.peek_col();
      let t_wild: boolean = false;
      let t_empty_body: ast.Stmt[] = [];
      let t_at: string = "";
      if (p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek2_punct() == "@") {
        t_at = p.peek_ident();
        p = p.advance();
        p = p.advance();
      }
      let tpats: ast.TupArm[] = [];
      if (p.peek_punct() == "(") {
        let (tpr_elem_kinds, tpr_binds, tpr_lits, tpr_pats, tpr_p) = parse_tuple_arm_pattern(p);
        p = tpr_p;
        if (tpr_elem_kinds.len() == 0) {
          return (s_unknown(p, "bad tuple pattern"), p);
        }
        tpats = tpats.append(ast.TupArm { is_wild: false, elem_kinds: tpr_elem_kinds, binds: tpr_binds, lits: tpr_lits, elem_pats: tpr_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: t_empty_body, line: taline, col: tacol, alt_cont: false });
        while (p.peek_punct() == "|") {
          p = p.advance();
          let (tor_kinds, tor_binds, tor_lits, tor_pats, tor_p) = parse_tuple_arm_pattern(p);
          p = tor_p;
          if (tor_kinds.len() == 0) {
            return (s_unknown(p, "bad tuple pattern"), p);
          }
          tpats = tpats.append(ast.TupArm { is_wild: false, elem_kinds: tor_kinds, binds: tor_binds, lits: tor_lits, elem_pats: tor_pats, at_binding: "", guard: e_bool(true), has_guard: false, body: t_empty_body, line: taline, col: tacol, alt_cont: false });
        }
      } else {
        let (twp_pattern, twp_p) = parse_pattern(p);
        p = twp_p;
        t_wild = true;
      }
      let t_guard: ast.Expr = e_bool(true);
      let t_has_guard: boolean = false;
      if (p.peek_keyword() == "when") {
        p = p.advance();
        let (tgr_expr, tgr_p) = parse_expr(p);
        p = tgr_p;
        t_guard = tgr_expr;
        t_has_guard = true;
      }
      p = p.expect("=>");
      let (tbb_body, tbb_p) = parse_block(p);
      p = tbb_p;
      if (t_wild) {
        let tw_kinds: i32[] = [];
        let tw_pats: ast.Pattern[] = [];
        let tw_binds: string[] = [];
        let tw_lits: ast.Expr[] = [];
        tarms = tarms.append(ast.TupArm { is_wild: true, elem_kinds: tw_kinds, binds: tw_binds, lits: tw_lits, elem_pats: tw_pats, at_binding: "", guard: t_guard, has_guard: t_has_guard, body: tbb_body, line: taline, col: tacol, alt_cont: false });
      } else {
        let talt: i32 = 0;
        while (talt < tpats.len()) {
          let tpa: ast.TupArm = tpats[talt];
          tarms = tarms.append(ast.TupArm { is_wild: false, elem_kinds: tpa.elem_kinds, binds: tpa.binds, lits: tpa.lits, elem_pats: tpa.elem_pats, at_binding: t_at, guard: t_guard, has_guard: t_has_guard, body: tbb_body, line: taline, col: tacol, alt_cont: talt > 0 });
          talt = talt + 1;
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
        continue;
      }
      break;
    }
    p = p.expect("}");
    return (build_tuple_match(sr_expr, tarms, mkline, mkcol), p);
  }
  if (at_local_struct_pattern(p)) {
    let (smarms, smrt, smok, smp) = parse_struct_match_arms(p, false);
    p = smp;
    if (!smok) {
      return (s_unknown(p, "a struct pattern binds field names"), p);
    }
    return (build_struct_match(sr_expr, smarms, mkline, mkcol), p);
  }
  if (p.peek_is_pat_literal() || p.peek_at_literal()) {
    let lit_arms: ast.LitArm[] = [];
    while (p.peek_punct() != "}" && !p.at_end()) {
      let laline: i32 = p.peek_line();
      let lacol: i32 = p.peek_col();
      let lwild: boolean = false;
      let (lat, lat_p) = take_at_binding(p);
      p = lat_p;
      let lalt_lits: ast.Expr[] = [];
      let lalt_his: ast.Expr[] = [];
      let lalt_hrs: boolean[] = [];
      let lalt_incs: boolean[] = [];
      if (p.peek_is_pat_literal()) {
        let (la_lits, la_his, la_hrs, la_incs, la_p) = parse_lit_alts(p);
        p = la_p;
        lalt_lits = la_lits;
        lalt_his = la_his;
        lalt_hrs = la_hrs;
        lalt_incs = la_incs;
      } else {
        let (lpr_pattern, lpr_p) = parse_pattern(p);
        p = lpr_p;
        lwild = true;
      }
      let lguard: ast.Expr = e_bool(true);
      let lhas_guard: boolean = false;
      if (p.peek_keyword() == "when") {
        p = p.advance();
        let (lgr_expr, lgr_p) = parse_expr(p);
        p = lgr_p;
        lguard = lgr_expr;
        lhas_guard = true;
      }
      p = p.expect("=>");
      let (lbb_body, lbb_p) = parse_block(p);
      p = lbb_p;
      if (lwild) {
        lit_arms = lit_arms.append(ast.LitArm { is_wild: true, lit: e_bool(true), guard: lguard, has_guard: lhas_guard, body: lbb_body, line: laline, col: lacol, range_hi: e_bool(true), has_range: false, range_inclusive: false, alt_cont: false, at_binding: "" });
      } else {
        let lai: i32 = 0;
        while (lai < lalt_lits.len()) {
          lit_arms = lit_arms.append(ast.LitArm { is_wild: false, lit: lalt_lits[lai], guard: lguard, has_guard: lhas_guard, body: lbb_body, line: laline, col: lacol, range_hi: lalt_his[lai], has_range: lalt_hrs[lai], range_inclusive: lalt_incs[lai], alt_cont: lai > 0, at_binding: lat });
          lai = lai + 1;
        }
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
        continue;
      }
      break;
    }
    p = p.expect("}");
    return (build_literal_match(sr_expr, lit_arms, mkline, mkcol), p);
  }
  let arms: ast.MatchArm[] = [];
  let written: ast.MatchArm[] = [];
  while (p.peek_punct() != "}" && !p.at_end()) {
    let aline: i32 = p.peek_line();
    let acol: i32 = p.peek_col();
    let (pr_pattern, pr_p) = parse_pattern(p);
    p = pr_p;
    let pats: ast.Pattern[] = [pr_pattern];
    while (p.peek_punct() == "|") {
      p = p.advance();
      let (pr2_pattern, pr2_p) = parse_pattern(p);
      p = pr2_p;
      pats = pats.append(pr2_pattern);
    }
    let arm_guard: ast.Expr = e_bool(true);
    let arm_has_guard: boolean = false;
    if (p.peek_keyword() == "when") {
      p = p.advance();
      let (gr_expr, gr_p) = parse_expr(p);
      p = gr_p;
      arm_guard = gr_expr;
      arm_has_guard = true;
    }
    p = p.expect("=>");
    let (bb_body, bb_p) = parse_block(p);
    p = bb_p;
    let pi: i32 = 0;
    while (pi < pats.len()) {
      written = written.append(ast.MatchArm { pattern: pats[pi], body: bb_body, line: aline, col: acol, guard: arm_guard, has_guard: arm_has_guard, alt_cont: pi > 0 });
      let (fs_pat, fs_g, fs_hg) = fold_lit_cond(pats[pi], arm_guard, arm_has_guard);
      arms = arms.append(ast.MatchArm { pattern: fs_pat, body: bb_body, line: aline, col: acol, guard: fs_g, has_guard: fs_hg, alt_cont: false });
      pi = pi + 1;
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  p = p.expect("}");
  let sugar: ast.MatchArm[] = [];
  if (arms_have_written_form(written)) {
    sugar = written;
  }
  if (arms_take_flag_chain(arms)) {
    return (build_nested_arm_match(sr_expr, arms, written, mkline, mkcol), p);
  }
  arms = desugar_nested_arms(arms, 0, "");
  return (s_match_sugared(sr_expr, arms, sugar, mkline, mkcol), p);
}

function arms_have_written_form(written: ast.MatchArm[]): boolean {
  let i: i32 = 0;
  while (i < written.len()) {
    if (written[i].alt_cont) {
      return true;
    }
    match (written[i].pattern) {
      ast.PatVariant(v) => {
        if (v.nested.len() > 0 || v.has_lit_cond || v.tup_kinds.len() > 0) {
          return true;
        }
      },
      ast.PatWildcard(w) => {}
    }
    i = i + 1;
  }
  return false;
}

function mentions_name(e: ast.Expr, name: string, hit: boolean): boolean {
  if (hit) {
    return true;
  }
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == name;
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub function stmt_mentions(st: ast.Stmt, name: string): boolean {
  function visit(n: ast.Expr, own a: boolean): boolean {
    return mentions_name(n, name, a);
  }
  return astwalk.fold_stmt(st, false, visit);
}

pub function stmts_mention(stmts: ast.Stmt[], name: string): boolean {
  for st in stmts {
    if (stmt_mentions(st, name)) {
      return true;
    }
  }
  return false;
}

function parse_loop_stmt(p: Par): (ast.Stmt, Par) {
  let p2: Par = p.advance();
  let (lb_body, lb_p) = parse_block_or_stmt(p2);
  return (ast.StmtWhile { cond: e_bool(true), body: lb_body, label: "", line: 0, is_loop: true, todo: false }, lb_p);
}

function parse_for_stmt(p: Par): (ast.Stmt, Par) {
  p = p.advance();
  if (p.peek_punct() == "(") {
    let cfl: i32 = p.peek_line();
    let cfc: i32 = p.peek_col();
    let kv_open: Par = p;
    p = p.advance();
    let is_cfor: boolean = !kv_open.paren_then_in();
    if (is_cfor) {
      let initstmts: ast.Stmt[] = [];
      let init_head: Par = p.advance();
      if (p.peek_punct() == ";") {
        p = p.advance();
      } else if (p.peek_keyword() == "let" && init_head.peek_ident().len() == 0 && init_head.peek_punct() != "(") {
        let bad_head: ast.Stmt = s_unknown(init_head, "decl:expected a name, got " + tok_desc(init_head.peek()));
        let (bh_body, bh_p) = parse_block(init_head.skip_to_close(")"));
        return (bad_head, bh_p);
      } else {
        let (fcinit_stmt, fcinit_p) = parse_stmt(p);
        p = fcinit_p;
        initstmts = [fcinit_stmt];
      }
      let condexpr: ast.Expr = e_bool(true);
      if (p.peek_punct() != ";") {
        let (fccond_expr, fccond_p) = parse_expr(p);
        p = fccond_p;
        condexpr = fccond_expr;
      }
      p = p.expect_semi();
      let stepone: ast.Stmt[] = [];
      if (p.peek_punct() != ")") {
        let (fcstep_stmt, fcstep_p) = parse_stmt(p);
        p = fcstep_p;
        stepone = [fcstep_stmt];
      }
      p = p.expect(")");
      let (fcbody_body, fcbody_p) = parse_block(p);
      p = fcbody_p;
      let flag: string = "__forc_" + util.i32_to_string(cfl) + "_" + util.i32_to_string(cfc);
      let noelse: ast.Stmt[] = [];
      let wbody: ast.Stmt[] = [];
      wbody = wbody.append(s_if(e_unary("!", e_ident(flag)), stepone, noelse));
      wbody = wbody.append(s_assign(flag, e_bool(false)));
      let breakone: ast.Stmt[] = [s_break()];
      wbody = wbody.append(s_if(e_unary("!", condexpr), breakone, noelse));
      let fbi: i32 = 0;
      while (fbi < fcbody_body.len()) {
        wbody = wbody.append(fcbody_body[fbi]);
        fbi = fbi + 1;
      }
      let outer: ast.Stmt[] = [];
      let ini: i32 = 0;
      while (ini < initstmts.len()) {
        outer = outer.append(initstmts[ini]);
        ini = ini + 1;
      }
      outer = outer.append(s_var(flag, "", e_bool(true)));
      outer = outer.append(s_while(e_bool(true), wbody));
      return (s_if(e_bool(true), outer, noelse), p);
    }
    let (kvnames, kvcount, kvok, kvnames_p) = parse_destructure_names(kv_open);
    p = kvnames_p;
    if (!kvok || kvcount < 2) {
      return for_refused(p, "for pattern needs at least 2 binders");
    }
    if (p.peek_ident() != "in") {
      return for_refused(p, "missing `in` in for");
    }
    p = p.advance();
    let kv_saved: boolean = p.no_struct;
    let (kvi_expr, kvi_p) = parse_expr(p.with_no_struct(true));
    p = kvi_p.with_no_struct(kv_saved);
    let (kvb_body, kvb_p) = parse_block(p);
    p = kvb_p;
    return (ast.StmtFor { var_name: kvnames, iter: kvi_expr, body: kvb_body, label: "", line: 0, col: kv_open.peek_col() }, p);
  }
  let fpre: ast.Stmt[] = [];
  let fvar: string = "";
  if (at_pattern_head(p)) {
    let fp_line: i32 = p.peek_line();
    let fp_col: i32 = p.peek_col();
    let fp_at: string = "";
    if (p.peek_punct_at(1) == "@") {
      fp_at = p.peek_ident();
      p = p.advance();
      p = p.advance();
    }
    let fp_elem: string = "$forpat_" + util.i32_to_string(fp_line) + "_" + util.i32_to_string(fp_col);
    let fp_init: ast.Expr = e_ident_at(fp_elem, fp_line, fp_col);
    if (p.peek_punct() == "(") {
      let (fpnames, fpcount, fpok, fpnames_p) = parse_destructure_names(p);
      p = fpnames_p;
      if (!fpok || fpcount < 2) {
        return for_refused(p, "for pattern needs at least 2 binders");
      }
      fpre = [s_var_at(fpnames, destr_marker(fp_at, false, ""), fp_init, fp_line, fp_col)];
    } else {
      let (fp_struct, fp_head) = parse_record_pattern_head(p);
      p = fp_head;
      let (fpbinds, fpfields, fpfields_rest, fpfields_ok, fpfields_p) = parse_struct_pattern_fields(p);
      p = fpfields_p;
      if (!fpfields_ok || fpbinds.len() == 0) {
        return (s_unknown(p, "a struct destructuring pattern binds field names"), p);
      }
      fpre = [s_var_at(fpbinds, destr_marker(fp_at, fpfields_rest, "@sd:" + fp_struct + ":" + fpfields), fp_init, fp_line, fp_col)];
    }
    fvar = fp_elem;
  } else {
    fvar = p.peek_ident();
    if (fvar.len() == 0) {
      return for_refused(p, "missing for-let name");
    }
    p = p.advance();
  }
  if (p.peek_ident() != "in") {
    return for_refused(p, "missing `in` in for");
  }
  p = p.advance();
  let f_saved: boolean = p.no_struct;
  let (fiter_expr, fiter_p) = parse_binary(p.with_no_struct(true), 1);
  p = fiter_p.with_no_struct(f_saved);
  let iter_expr: ast.Expr = fiter_expr;
  let range_punct: string = p.peek_punct();
  if (range_punct == ".." || range_punct == "..=") {
    p = p.advance();
    let hi_saved: boolean = p.no_struct;
    let (fhi_expr, fhi_p) = parse_binary(p.with_no_struct(true), 1);
    p = fhi_p.with_no_struct(hi_saved);
    let rargs: ast.Expr[] = [fiter_expr, fhi_expr];
    let range_fn: string = "__range";
    if (range_punct == "..=") {
      range_fn = "__range_incl";
    }
    iter_expr = e_call(e_ident(range_fn), rargs);
  }
  let (fb_body, fb_p) = parse_block_or_stmt(p);
  p = fb_p;
  let fbi: i32 = 0;
  while (fbi < fb_body.len()) {
    fpre = fpre.append(fb_body[fbi]);
    fbi = fbi + 1;
  }
  return (s_for(fvar, iter_expr, fpre), p);
}

function for_refused(p: Par, kind: string): (ast.Stmt, Par) {
  let open: Par = p.skip_to_open();
  if (open.peek_punct() != "{") {
    return (s_unknown(p, kind), p);
  }
  let (skipped, sp) = parse_block(open);
  return (s_unknown(p, kind), sp);
}

function with_stmt_line(st: ast.Stmt, line: i32): ast.Stmt {
  match (st) {
    ast.StmtExpr(x) => {
      return ast.StmtExpr { value: x.value, line: line };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, line: line };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: w.cond, body: w.body, label: w.label, line: line, is_loop: w.is_loop, todo: w.todo };
    },
    ast.StmtFor(fo) => {
      return ast.StmtFor { var_name: fo.var_name, iter: fo.iter, body: fo.body, label: fo.label, line: line, col: fo.col };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: d.action, on_error: d.on_error, line: line };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function parse_stmt(p: Par): (ast.Stmt, Par) {
  if (p.too_deep()) {
    return (s_unknown_at("nest:too-deep", p.peek_line(), p.peek_col()), p.bail());
  }
  let (g0, gq) = parse_stmt_nested(p.with_depth(p.depth + 1));
  return (g0, gq.with_depth(p.depth));
}

function parse_stmt_nested(p: Par): (ast.Stmt, Par) {
  let stmt_line: i32 = p.peek_line();
  let (parsed, after) = parse_stmt_at(p);
  return (with_stmt_line(parsed, stmt_line), after);
}

function parse_let_pattern(p: Par, start: Par, qualified_record: boolean, vline: i32, vcol: i32): (ast.Stmt, Par) {
  let (lsp_pat, lsp_p) = parse_pattern(start);
  let lsp_pats: ast.Pattern[] = [lsp_pat];
  while (lsp_p.peek_punct() == "|") {
    lsp_p = lsp_p.advance();
    let (lsp_alt, lsp_ap) = parse_pattern(lsp_p);
    lsp_p = lsp_ap;
    lsp_pats = lsp_pats.append(lsp_alt);
  }
  let (lsp_init, lsp_ip) = parse_expr(lsp_p.expect("=").with_no_struct(false));
  lsp_ip = lsp_ip.with_no_struct(p.no_struct);
  if (qualified_record && lsp_pats.len() == 1 && lsp_ip.peek_keyword() != "else") {
    let binding: ast.Stmt = qualified_struct_binding(lsp_pat, lsp_init, vline, vcol);
    return (binding, lsp_ip.end_of(lsp_init));
  }
  let (lsp_else, lsp_rest, lsp_restp) = parse_let_else_tail(lsp_ip);
  p = lsp_restp;
  let lsp_arms: ast.MatchArm[] = [];
  let lsp_written: ast.MatchArm[] = [];
  let lsp_i: i32 = 0;
  while (lsp_i < lsp_pats.len()) {
    lsp_written = lsp_written.append(ast.MatchArm { pattern: lsp_pats[lsp_i], body: lsp_rest, line: vline, col: vcol, guard: e_bool(true), has_guard: false, alt_cont: lsp_i > 0 });
    let (fl_pat, fl_g, fl_hg) = fold_lit_cond(lsp_pats[lsp_i], e_bool(true), false);
    lsp_arms = lsp_arms.append(ast.MatchArm { pattern: fl_pat, body: lsp_rest, line: vline, col: vcol, guard: fl_g, has_guard: fl_hg, alt_cont: false });
    lsp_i = lsp_i + 1;
  }
  let lsp_wild: ast.MatchArm = ast.MatchArm { pattern: p_wildcard(), body: lsp_else, line: vline, col: vcol, guard: e_bool(true), has_guard: false, alt_cont: false };
  lsp_arms = lsp_arms.append(lsp_wild);
  lsp_written = lsp_written.append(lsp_wild);
  if (arms_take_flag_chain(lsp_arms)) {
    return (with_sugar_origin(build_nested_arm_match(lsp_init, lsp_arms, lsp_written, vline, vcol), "let_else"), p);
  }
  lsp_arms = desugar_nested_arms(lsp_arms, 0, "");
  let lsp_sugar: ast.MatchArm[] = [];
  if (arms_have_written_form(lsp_written)) {
    lsp_sugar = lsp_written;
  }
  return (s_match_origin_sugared(lsp_init, lsp_arms, lsp_sugar, vline, vcol, "let_else"), p);
}

function parse_let_value(p: Par, name: string, vline: i32, vcol: i32): (ast.Stmt, Par) {
  let type_name: string = "";
  let v_fn_ret: string = "";
  let v_fn_ptys: string = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    let (vtr, vtr_p) = parse_decl_type(p);
    p = vtr_p;
    type_name = vtr.name;
    v_fn_ret = vtr.fn_ret;
    v_fn_ptys = vtr.fn_params;
  }
  if (p.peek_punct() != "=") {
    return (s_unknown(p, "missing = in let"), p);
  }
  p = p.advance();
  let (init_expr, init_p) = parse_expr(p.with_map_kind(map_ann_key_kind(type_name)));
  p = init_p.with_map_kind(0 - 1);
  if (p.peek_keyword() == "else") {
    return (decl_sentinel(p, "`let " + name + "` always binds, so it takes no `else`; a pattern that can miss goes after `let`, e.g. `let Some(" + name + ") = …`"), p);
  }
  p = p.end_of(init_expr);
  if (!p.verbatim) {
    init_expr = stamp_lambda_ret(init_expr, v_fn_ret);
    init_expr = stamp_value_block_ret(init_expr, type_name);
  }
  return (ast.StmtVar { name: discard_name(name, vline, vcol, 0), type_name: type_name, init: init_expr, line: vline, col: vcol, fn_ret: v_fn_ret, fn_param_types: v_fn_ptys }, p);
}

function parse_let_stmt(p: Par): (ast.Stmt, Par) {
  let vline: i32 = p.peek_line();
  let vcol: i32 = p.peek_col();
  p = p.advance();
  let at_bind: string = "";
  let qualified_record: boolean = qualified_record_pattern_ahead(p);
  if (p.peek_punct_at(1) == "@" && at_pattern_head(p) && !qualified_record) {
    at_bind = p.peek_ident();
    p = p.advance();
    p = p.advance();
  }
  if (p.peek_punct() == "(") {
    let tuple_start: Par = p;
    let (tdnames, tdcount, tdok, tdp) = parse_destructure_names(p);
    p = tdp;
    if (!tdok) {
      let problem: ast.Stmt = s_unknown_at("decl:" + refutable_binding_message("a literal tuple element", "destructuring binding"), vline, vcol);
      p = tuple_start.advance().skip_to_close(")").expect("=");
      let (ignored, recovered) = parse_expr(p);
      return (problem, recovered.end_of(ignored));
    }
    if (tdcount < 2) {
      return (s_unknown(p, "a tuple destructuring pattern binds names, not literals"), p);
    }
    p = p.expect("=");
    let (tdinit_expr, tdinit_p) = parse_expr(p);
    p = tdinit_p;
    p = p.end_of(tdinit_expr);
    return (s_var_at(tdnames, destr_marker(at_bind, false, ""), tdinit_expr, vline, vcol), p);
  }
  if (p.peek_is_pat_literal() || p.peek_at_literal()) {
    let (lel_at, lel_atp) = take_at_binding(p);
    let (lel_lits, lel_his, lel_hrs, lel_incs, lel_p) = parse_lit_alts(lel_atp);
    let (lel_init, lel_ip) = parse_expr(lel_p.expect("=").with_no_struct(false));
    lel_ip = lel_ip.with_no_struct(p.no_struct);
    let (lel_else, lel_rest, lel_restp) = parse_let_else_tail(lel_ip);
    p = lel_restp;
    let lel_arms: ast.LitArm[] = [];
    let lel_i: i32 = 0;
    while (lel_i < lel_lits.len()) {
      lel_arms = lel_arms.append(ast.LitArm { is_wild: false, lit: lel_lits[lel_i], guard: e_bool(true), has_guard: false, body: lel_rest, line: vline, col: vcol, range_hi: lel_his[lel_i], has_range: lel_hrs[lel_i], range_inclusive: lel_incs[lel_i], alt_cont: lel_i > 0, at_binding: lel_at });
      lel_i = lel_i + 1;
    }
    lel_arms = lel_arms.append(ast.LitArm { is_wild: true, lit: e_bool(true), guard: e_bool(true), has_guard: false, body: lel_else, line: vline, col: vcol, range_hi: e_bool(true), has_range: false, range_inclusive: false, alt_cont: false, at_binding: "" });
    return (with_sugar_origin(build_literal_match(lel_init, lel_arms, vline, vcol), "let_else"), p);
  }
  let name: string = p.peek_ident();
  if (name.len() == 0) {
    return (s_unknown(p, "missing binding name"), p);
  }
  let le_pat_start: Par = p;
  p = p.advance();
  if (p.peek_punct() == "{") {
    return parse_struct_destructure(p, name, at_bind, vline, vcol);
  }
  if (p.peek_punct() == "(" || p.peek_punct() == "@" || p.peek_punct() == "|" || p.peek_punct() == ".") {
    return parse_let_pattern(p, le_pat_start, qualified_record, vline, vcol);
  }
  return parse_let_value(p, name, vline, vcol);
}

function at_local_struct_pattern(p: Par): boolean {
  return is_struct_pattern_arm(p) && (p.peek_ident().len() > 0 && p.peek2_punct() == "{" || p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@" && p.peek_ident_at(2).len() > 0 && p.peek_punct_at(3) == "{");
}

function parse_if_stmt(p: Par): (ast.Stmt, Par) {
  p = p.advance();
  if (p.peek_keyword() == "let") {
    p = p.advance();
    if (at_local_struct_pattern(p)) {
      let ils_line: i32 = p.peek_line();
      let ils_col: i32 = p.peek_col();
      let ils_at: string = "";
      if (p.peek_ident().len() > 0 && p.peek2_punct() == "@") {
        ils_at = p.peek_ident();
        p = p.advance();
        p = p.advance();
      }
      let ils_type: string = p.peek_ident();
      let (ils_sap, ils_pp) = parse_struct_arm_pattern(p);
      let ils_binds: string[] = ils_sap.binds;
      let ils_fields: string[] = ils_sap.fields;
      let ils_field_kinds: i32[] = ils_sap.kinds;
      let ils_field_lits: ast.Expr[] = ils_sap.lits;
      let ils_field_pats: ast.Pattern[] = ils_sap.pats;
      let ils_ok: boolean = ils_sap.ok;
      p = ils_pp;
      if (!ils_ok) {
        return (s_unknown(p, "a struct pattern binds field names"), p);
      }
      p = p.expect("=");
      let ils_saved: boolean = p.no_struct;
      let (ils_scrut, ils_sp) = parse_expr(p.with_no_struct(true));
      p = ils_sp.with_no_struct(ils_saved);
      let (ils_then, ils_tp) = parse_block_or_stmt(p);
      p = ils_tp;
      let ils_else: ast.Stmt[] = [];
      if (p.peek_keyword() == "else") {
        p = p.advance();
        let (ils_eb, ils_ep) = parse_block_or_stmt(p);
        p = ils_ep;
        ils_else = ils_eb;
      }
      let ils_arms: ast.StructArm[] = [];
      ils_arms = ils_arms.append(ast.StructArm { is_wild: false, type_name: ils_type, binds: ils_binds, fields: ils_fields, field_kinds: ils_field_kinds, field_lits: ils_field_lits, field_pats: ils_field_pats, at_binding: ils_at, rest_written: ils_sap.rest_written, guard: e_bool(true), has_guard: false, body: ils_then, line: ils_line, col: ils_col });
      let ils_nb: string[] = [];
      let ils_no_pats: ast.Pattern[] = [];
      let ils_no_kinds: i32[] = [];
      let ils_no_lits: ast.Expr[] = [];
      let ils_nf: string[] = [];
      ils_arms = ils_arms.append(ast.StructArm { is_wild: true, type_name: "", binds: ils_nb, fields: ils_nf, field_kinds: ils_no_kinds, field_lits: ils_no_lits, field_pats: ils_no_pats, at_binding: "", rest_written: false, guard: e_bool(true), has_guard: false, body: ils_else, line: ils_line, col: ils_col });
      return (with_sugar_origin(build_struct_match(ils_scrut, ils_arms, ils_line, ils_col), "if_let"), p);
    }
    if (p.peek_punct() == "(" || p.peek_ident().len() > 0 && p.peek_ident() != "_" && p.peek_punct_at(1) == "@" && p.peek_punct_at(2) == "(") {
      let ilt_line: i32 = p.peek_line();
      let ilt_col: i32 = p.peek_col();
      let ilt_at: string = "";
      if (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@") {
        ilt_at = p.peek_ident();
        p = p.advance();
        p = p.advance();
      }
      let ilt_empty: ast.Stmt[] = [];
      let ilt_pats: ast.TupArm[] = [];
      let (ilt_kinds, ilt_binds, ilt_lits, ilt_elems, ilt_pp) = parse_tuple_arm_pattern(p);
      p = ilt_pp;
      if (ilt_kinds.len() == 0) {
        return (s_unknown(p, "bad tuple pattern"), p);
      }
      ilt_pats = ilt_pats.append(ast.TupArm { is_wild: false, elem_kinds: ilt_kinds, binds: ilt_binds, lits: ilt_lits, elem_pats: ilt_elems, at_binding: "", guard: e_bool(true), has_guard: false, body: ilt_empty, line: ilt_line, col: ilt_col, alt_cont: false });
      while (p.peek_punct() == "|") {
        p = p.advance();
        let (ilo_kinds, ilo_binds, ilo_lits, ilo_elems, ilo_p) = parse_tuple_arm_pattern(p);
        p = ilo_p;
        if (ilo_kinds.len() == 0) {
          return (s_unknown(p, "bad tuple pattern"), p);
        }
        ilt_pats = ilt_pats.append(ast.TupArm { is_wild: false, elem_kinds: ilo_kinds, binds: ilo_binds, lits: ilo_lits, elem_pats: ilo_elems, at_binding: "", guard: e_bool(true), has_guard: false, body: ilt_empty, line: ilt_line, col: ilt_col, alt_cont: false });
      }
      p = p.expect("=");
      let ilt_saved: boolean = p.no_struct;
      let (ilt_scrut, ilt_sp) = parse_expr(p.with_no_struct(true));
      p = ilt_sp.with_no_struct(ilt_saved);
      let (ilt_then, ilt_tp) = parse_block_or_stmt(p);
      p = ilt_tp;
      let ilt_else: ast.Stmt[] = [];
      if (p.peek_keyword() == "else") {
        p = p.advance();
        let (ilt_eb, ilt_ep) = parse_block_or_stmt(p);
        p = ilt_ep;
        ilt_else = ilt_eb;
      }
      let ilt_arms: ast.TupArm[] = [];
      let ilt_i: i32 = 0;
      while (ilt_i < ilt_pats.len()) {
        let ilt_a: ast.TupArm = ilt_pats[ilt_i];
        ilt_arms = ilt_arms.append(ast.TupArm { is_wild: false, elem_kinds: ilt_a.elem_kinds, binds: ilt_a.binds, lits: ilt_a.lits, elem_pats: ilt_a.elem_pats, at_binding: ilt_at, guard: e_bool(true), has_guard: false, body: ilt_then, line: ilt_line, col: ilt_col, alt_cont: ilt_i > 0 });
        ilt_i = ilt_i + 1;
      }
      let ilt_wk: i32[] = [];
      let ilt_wb: string[] = [];
      let ilt_wl: ast.Expr[] = [];
      let ilt_wp: ast.Pattern[] = [];
      ilt_arms = ilt_arms.append(ast.TupArm { is_wild: true, elem_kinds: ilt_wk, binds: ilt_wb, lits: ilt_wl, elem_pats: ilt_wp, at_binding: "", guard: e_bool(true), has_guard: false, body: ilt_else, line: ilt_line, col: ilt_col, alt_cont: false });
      return (with_sugar_origin(build_tuple_match(ilt_scrut, ilt_arms, ilt_line, ilt_col), "if_let"), p);
    }
    if (p.peek_is_pat_literal() || p.peek_at_literal()) {
      let ill_line: i32 = p.peek_line();
      let ill_col: i32 = p.peek_col();
      let (ill_at, ill_atp) = take_at_binding(p);
      p = ill_atp;
      let (ill_lits, ill_his, ill_hrs, ill_incs, ill_p) = parse_lit_alts(p);
      p = ill_p;
      p = p.expect("=");
      let ill_saved: boolean = p.no_struct;
      let (ill_scrut, ill_sp) = parse_expr(p.with_no_struct(true));
      p = ill_sp.with_no_struct(ill_saved);
      let (ill_then, ill_tp) = parse_block_or_stmt(p);
      p = ill_tp;
      let ill_else: ast.Stmt[] = [];
      if (p.peek_keyword() == "else") {
        p = p.advance();
        let (ill_eb, ill_ep) = parse_block_or_stmt(p);
        p = ill_ep;
        ill_else = ill_eb;
      }
      let ill_arms: ast.LitArm[] = [];
      let ill_i: i32 = 0;
      while (ill_i < ill_lits.len()) {
        ill_arms = ill_arms.append(ast.LitArm { is_wild: false, lit: ill_lits[ill_i], guard: e_bool(true), has_guard: false, body: ill_then, line: ill_line, col: ill_col, range_hi: ill_his[ill_i], has_range: ill_hrs[ill_i], range_inclusive: ill_incs[ill_i], alt_cont: ill_i > 0, at_binding: ill_at });
        ill_i = ill_i + 1;
      }
      ill_arms = ill_arms.append(ast.LitArm { is_wild: true, lit: e_bool(true), guard: e_bool(true), has_guard: false, body: ill_else, line: ill_line, col: ill_col, range_hi: e_bool(true), has_range: false, range_inclusive: false, alt_cont: false, at_binding: "" });
      return (with_sugar_origin(build_literal_match(ill_scrut, ill_arms, ill_line, ill_col), "if_let"), p);
    }
    let il_line: i32 = p.peek_line();
    let il_col: i32 = p.peek_col();
    let (ilpat_pattern, ilpat_p) = parse_pattern(p);
    p = ilpat_p;
    let ilpats: ast.Pattern[] = [ilpat_pattern];
    while (p.peek_punct() == "|") {
      p = p.advance();
      let (ilalt_pattern, ilalt_p) = parse_pattern(p);
      p = ilalt_p;
      ilpats = ilpats.append(ilalt_pattern);
    }
    p = p.expect("=");
    let il_saved: boolean = p.no_struct;
    let (ilscrut_expr, ilscrut_p) = parse_expr(p.with_no_struct(true));
    p = ilscrut_p.with_no_struct(il_saved);
    let (ilthen_body, ilthen_p) = parse_block_or_stmt(p);
    p = ilthen_p;
    let ilelse: ast.Stmt[] = [];
    if (p.peek_keyword() == "else") {
      p = p.advance();
      let (ileb_body, ileb_p) = parse_block_or_stmt(p);
      p = ileb_p;
      ilelse = ileb_body;
    }
    let ilarms: ast.MatchArm[] = [];
    let ilwritten: ast.MatchArm[] = [];
    let ilpi: i32 = 0;
    while (ilpi < ilpats.len()) {
      ilwritten = ilwritten.append(ast.MatchArm { pattern: ilpats[ilpi], body: ilthen_body, line: il_line, col: il_col, guard: e_bool(true), has_guard: false, alt_cont: false });
      let (fi_pat, fi_g, fi_hg) = fold_lit_cond(ilpats[ilpi], e_bool(true), false);
      ilarms = ilarms.append(ast.MatchArm { pattern: fi_pat, body: ilthen_body, line: il_line, col: il_col, guard: fi_g, has_guard: fi_hg, alt_cont: false });
      ilpi = ilpi + 1;
    }
    let ilwild: ast.MatchArm = ast.MatchArm { pattern: p_wildcard(), body: ilelse, line: il_line, col: il_col, guard: e_bool(true), has_guard: false, alt_cont: false };
    ilarms = ilarms.append(ilwild);
    ilwritten = ilwritten.append(ilwild);
    if (arms_take_flag_chain(ilarms)) {
      return (with_sugar_origin(build_nested_arm_match(ilscrut_expr, ilarms, ilwritten, il_line, il_col), "if_let"), p);
    }
    ilarms = desugar_nested_arms(ilarms, 0, "");
    let ilsugar: ast.MatchArm[] = [];
    if (arms_have_written_form(ilwritten)) {
      ilsugar = ilwritten;
    }
    return (s_match_origin_sugared(ilscrut_expr, ilarms, ilsugar, il_line, il_col, "if_let"), p);
  }
  let (c_expr, c_p) = parse_paren_head(p);
  p = c_p;
  let (then_blk_body, then_blk_p) = parse_block_or_stmt(p);
  p = then_blk_p;
  let else_body: ast.Stmt[] = [];
  let else_chained: boolean = false;
  if (p.peek_keyword() == "else") {
    p = p.advance();
    if (p.peek_keyword() == "if") {
      let (nested_stmt, nested_p) = parse_stmt(p);
      p = nested_p;
      else_body = else_body.append(nested_stmt);
      else_chained = true;
    } else {
      let (else_blk_body, else_blk_p) = parse_block_or_stmt(p);
      p = else_blk_p;
      else_body = else_blk_body;
    }
  }
  return (s_if_chained(c_expr, then_blk_body, else_body, else_chained), p);
}

function parse_return_stmt(p: Par): (ast.Stmt, Par) {
  let rline: i32 = p.peek_line();
  let rcol: i32 = p.peek_col();
  p = p.advance();
  if (p.peek_punct() == ";") {
    let bare: ast.Expr = e_unknown_at(BARE_RETURN, p.peek_line(), p.peek_col());
    return (s_return_at(bare, rline, rcol), p.advance());
  }
  let (val_expr, val_p) = parse_expr(p);
  p = val_p;
  p = p.end_of(val_expr);
  return (s_return_at(val_expr, rline, rcol), p);
}

function parse_break_stmt(p: Par): (ast.Stmt, Par) {
  let bkline: i32 = p.peek_line();
  let bkcol: i32 = p.peek_col();
  p = p.advance();
  let blbl: string = "";
  let bid: string = p.peek_ident();
  if (bid.len() > 0 && p.advance().peek_punct() == ";") {
    blbl = bid;
    p = p.advance();
  }
  p = p.expect_semi();
  return (ast.StmtBreak { tag: 0, line: bkline, col: bkcol, label: blbl }, p);
}

function parse_continue_stmt(p: Par): (ast.Stmt, Par) {
  let ckline: i32 = p.peek_line();
  let ckcol: i32 = p.peek_col();
  p = p.advance();
  let clbl: string = "";
  let cid: string = p.peek_ident();
  if (cid.len() > 0 && p.advance().peek_punct() == ";") {
    clbl = cid;
    p = p.advance();
  }
  p = p.expect_semi();
  return (ast.StmtContinue { tag: 0, line: ckline, col: ckcol, label: clbl }, p);
}

function parse_expression_stmt(p: Par): (ast.Stmt, Par) {
  let (e_expr, e_p) = parse_expr(p);
  p = e_p;
  let aline: i32 = p.peek_line();
  let acol: i32 = p.peek_col();
  let assign_op: string = p.peek_punct();
  let is_assign: boolean = assign_op == "=";
  let is_compound: boolean = is_compound_assign_op(assign_op);
  if (is_assign || is_compound) {
    p = p.advance();
    let (av_expr, av_p) = parse_expr(p);
    p = av_p;
    if (is_compound_assign_op(p.peek_punct()) || is_compound && p.peek_punct() == "=") {
      return chained_compound(p);
    }
    if (is_assign && p.peek_punct() == "=") {
      return parse_assign_chain(p, [e_expr, av_expr], [aline], [acol]);
    }
    p = p.end_of(av_expr);
    let rhs: ast.Expr = av_expr;
    if (is_compound) {
      rhs = e_binary(slice_unchecked(assign_op, 0, assign_op.len() - 1), read_back(e_expr), av_expr);
    }
    return (assign_to(e_expr, rhs, aline, acol), p);
  }
  p = p.end_of(e_expr);
  return (s_expr(e_expr), p);
}

function parse_stmt_at(p: Par): (ast.Stmt, Par) {
  if (p.peek_punct() == "{") {
    let (bb_body, bb_p) = parse_block(p);
    return (s_block(bb_body), bb_p);
  }
  let loop_label: string = "";
  let llid: string = p.peek_ident();
  if (llid.len() > 0) {
    let lp1: Par = p.advance();
    if (lp1.peek_punct() == ":") {
      let lp2: Par = lp1.advance();
      let lkw: string = lp2.peek_keyword();
      if (lkw == "while" || lkw == "for" || lkw == "loop") {
        loop_label = llid;
        p = lp2;
      }
    }
  }
  if (p.peek_ident() == "assert") {
    let as0: Par = p.advance();
    if (as0.peek_punct() == "(") {
      let asp: Par = as0.advance();
      let (as_cond, ascp) = parse_expr(asp);
      asp = ascp;
      let as_has_msg: boolean = false;
      let as_msg: ast.Expr = e_string("");
      if (asp.peek_punct() == ",") {
        asp = asp.advance();
        let (asm_e, asmp) = parse_expr(asp);
        as_msg = asm_e;
        asp = asmp;
        as_has_msg = true;
      }
      if (asp.peek_punct() == ")") {
        asp = asp.advance();
      }
      if (asp.peek_punct() == ";") {
        asp = asp.advance();
      }
      let as_text: ast.Expr = e_string("assertion failed");
      if (as_has_msg) {
        as_text = e_binary("+", e_string("assertion failed: "), as_msg);
      }
      let as_body: ast.Stmt[] = [];
      let as_eargs: ast.Expr[] = [];
      as_eargs = as_eargs.append(as_text);
      as_body = as_body.append(s_expr(e_call(e_ident("eprint"), as_eargs)));
      let as_xargs: ast.Expr[] = [];
      as_xargs = as_xargs.append(e_number("1", "", false));
      as_body = as_body.append(s_expr(e_call(e_ident("exit"), as_xargs)));
      let as_noelse: ast.Stmt[] = [];
      return (s_if_origin(e_unary("!", as_cond), as_body, as_noelse, ORIGIN_ASSERT), asp);
    }
  }
  if (p.peek_ident() == "todo") {
    let td_site: TodoSite = TodoSite { line: p.peek_line(), col: p.peek_col() };
    let td0: Par = p.advance();
    let td0p: string = td0.peek_punct();
    if (td0p == "(" || td0p == ";") {
      let tdp: Par = td0;
      let td_has_msg: boolean = false;
      let td_msg: ast.Expr = e_string("");
      if (td0p == "(") {
        tdp = tdp.advance();
        if (tdp.peek_punct() != ")") {
          let (tdm_e, tdmp) = parse_expr(tdp);
          td_msg = tdm_e;
          tdp = tdmp;
          td_has_msg = true;
        }
        if (tdp.peek_punct() == ")") {
          tdp = tdp.advance();
        }
      }
      if (tdp.peek_punct() == ";") {
        tdp = tdp.advance();
      }
      let td_text: ast.Expr = e_string("todo: not implemented");
      if (td_has_msg) {
        td_text = e_binary("+", e_string("todo: "), td_msg);
      }
      let td_body: ast.Stmt[] = [];
      let td_eargs: ast.Expr[] = [];
      td_eargs = td_eargs.append(td_text);
      td_body = td_body.append(s_expr(e_call(e_ident("eprint"), td_eargs)));
      let td_xargs: ast.Expr[] = [];
      td_xargs = td_xargs.append(e_number("101", "", false));
      td_body = td_body.append(s_expr(e_call(e_ident("exit"), td_xargs)));
      return (ast.StmtWhile { cond: e_bool(true), body: td_body, label: "", line: 0, is_loop: false, todo: true }, Par { ...tdp, todos: tdp.todos.append(td_site) });
    }
  }
  let kw: string = p.peek_keyword();
  if (kw == "defer") {
    p = p.advance();
    let (da_stmt, da_p) = parse_stmt(p);
    return (s_defer(defer_action(da_stmt, p)), da_p);
  }
  if (kw == "errdefer") {
    p = p.advance();
    let (ea_stmt, ea_p) = parse_stmt(p);
    return (s_errdefer(defer_action(ea_stmt, p)), ea_p);
  }
  if (kw == "function") {
    let errors_before: i32 = p.type_errs.len();
    let (fr_func, fr_p) = parse_func_decl(p);
    p = fr_p;
    if (fr_func.name.len() == 0) {
      if (p.type_errs.len() > errors_before) {
        let last: i32 = p.type_errs.len() - 1;
        let kept: ast.Stmt[] = [];
        let i: i32 = 0;
        while (i < last) {
          kept = kept.append(p.type_errs[i]);
          i = i + 1;
        }
        return (p.type_errs[last], Par { ...p, type_errs: kept });
      }
      return (s_unknown_at("decl:" + malformed_fn_decl_message(), fr_func.line, fr_func.col), p);
    }
    let lam: ast.Expr = e_lambda_fn(fr_func.params, fr_func.ret_type, fr_func.body, fr_func.ret_fn_ret, fr_func.ret_fn_param_types);
    if (p.verbatim) {
      return (s_var_at(fr_func.name, "@fndecl", lam, fr_func.line, fr_func.col), p);
    }
    return (s_var(fr_func.name, "", lam), p);
  }
  if (kw == "match") {
    let (mr_stmt, mr_p) = parse_match_stmt(p);
    return (mr_stmt, mr_p);
  }
  if (kw == "if") {
    return parse_if_stmt(p);
  }
  if (kw == "while") {
    let (wc_expr, wc_p) = parse_paren_head(p.advance());
    p = wc_p;
    let (wb_body, wb_p) = parse_block_or_stmt(p);
    p = wb_p;
    return (with_loop_label(s_while(wc_expr, wb_body), loop_label), p);
  }
  if (kw == "loop") {
    let (lr_stmt, lr_p) = parse_loop_stmt(p);
    return (with_loop_label(lr_stmt, loop_label), lr_p);
  }
  if (kw == "for") {
    let (fr0_stmt, fr0_p) = parse_for_stmt(p);
    return (with_loop_label(fr0_stmt, loop_label), fr0_p);
  }
  if (kw == "let") {
    return parse_let_stmt(p);
  }
  if (kw == "return") {
    return parse_return_stmt(p);
  }
  if (kw == "break") {
    return parse_break_stmt(p);
  }
  if (kw == "continue") {
    return parse_continue_stmt(p);
  }
  return parse_expression_stmt(p);
}

function parse_assign_chain(p0: Par, exprs0: ast.Expr[], lines0: i32[], cols0: i32[]): (ast.Stmt, Par) {
  let p: Par = p0;
  let exprs: ast.Expr[] = exprs0;
  let lines: i32[] = lines0;
  let cols: i32[] = cols0;
  while (p.peek_punct() == "=") {
    lines = lines.append(p.peek_line());
    cols = cols.append(p.peek_col());
    let (nx, np) = parse_expr(p.advance());
    p = np;
    exprs = exprs.append(nx);
  }
  if (is_compound_assign_op(p.peek_punct())) {
    return chained_compound(p);
  }
  p = p.end_of(exprs[exprs.len() - 1]);
  let stmts: ast.Stmt[] = [];
  let i: i32 = exprs.len() - 2;
  while (i >= 0) {
    let rhs: ast.Expr = exprs[i + 1];
    if (i < exprs.len() - 2) {
      rhs = read_back(rhs);
    }
    let link: ast.Stmt = assign_to(exprs[i], rhs, lines[i], cols[i]);
    if let ast.StmtUnknown(_) = link {
      return (link, p);
    }
    stmts = stmts.append(link);
    i = i - 1;
  }
  return (s_if_tagged(stmts, "chain_assign"), p);
}

function chained_compound(p: Par): (ast.Stmt, Par) {
  let st: ast.Stmt = s_unknown(p, coded_kind("P001", "a compound assignment stands alone: it cannot be part of an assignment chain"));
  let depth: i32 = 0;
  while (!p.at_end()) {
    let pc: string = p.peek_punct();
    if (depth == 0 && (pc == ";" || pc == "}")) {
      break;
    }
    if (pc == "(" || pc == "[" || pc == "{") {
      depth = depth + 1;
    } else if (pc == ")" || pc == "]" || pc == "}") {
      depth = depth - 1;
    }
    p = p.advance();
  }
  if (p.peek_punct() == ";") {
    p = p.advance();
  }
  return (st, p);
}

function assign_to(target: ast.Expr, rhs: ast.Expr, line: i32, col: i32): ast.Stmt {
  match (target) {
    ast.ExprIdent(id) => {
      return s_assign_at(id.name, rhs, line, col, id.line, id.col);
    },
    ast.ExprIndex(ix) => {
      return s_expr(e_call_at(e_ident("__set_index"), [ix.array, ix.index, rhs], ix.line, ix.col));
    },
    ast.ExprFieldAccess(fa) => {
      return s_expr(e_call(e_ident("__set_field"), [fa.obj, e_string_at(fa.field, fa.line, fa.col), rhs]));
    },
    _ => {
      return s_unknown_at(coded_kind("P003", "left-hand side of assignment is not assignable"), line, col);
    }
  }
}

function read_back(target: ast.Expr): ast.Expr {
  match (target) {
    ast.ExprIdent(id) => {
      return e_ident(id.name);
    },
    ast.ExprIndex(ix) => {
      return e_index(ix.array, ix.index, ix.line, ix.col);
    },
    ast.ExprFieldAccess(fa) => {
      return e_field_access(fa.obj, fa.field);
    },
    _ => {
      return target;
    }
  }
}

pub function parse_program(toks: lexer.Token[]): ast.Stmt[] {
  if let Some(le) = stream_lex_error(toks) {
    return [s_unknown_at(lex_error_kind(le), le.line, le.col)];
  }
  let p: Par = Par { toks: toks, pos: 0, no_struct: false, map_kind: 0 - 1, structnames: scan_struct_names(toks), verbatim: false, depth: 0, type_errs: [], todos: [], tail_at: [], tail_is: [] };
  let out: ast.Stmt[] = [];
  while (!p.at_end()) {
    let (r_stmt, r_p) = parse_stmt(p);
    p = r_p;
    out = out.append(r_stmt);
  }
  return out;
}

function is_scalar_ret_name(n: string): boolean {
  return n == "i32" || n == "i64" || n == "u8" || n == "u32" || n == "u64"
    || n == "f32" || n == "f64" || n == "boolean";
}

pub function is_struct_ret_name(n: string): boolean {
  if (n.len() == 0) {
    return false;
  }
  let i: i32 = 0;
  while (i < n.len()) {
    let c: i32 = n[i] as i32;
    if (c == 91 || c == 93 || c == 40 || c == 41 || c == 44 || c == 46 || c == 32) {
      return false;
    }
    i = i + 1;
  }
  if (n == "i32" || n == "i64" || n == "u8" || n == "u32" || n == "u64"
    || n == "f32" || n == "f64" || n == "string" || n == "boolean" || n == "void"
    || n == "fn" || n == "unknown" || n == "any") {
    return false;
  }
  return true;
}

function is_nominal_ret_name(n: string): boolean {
  if (n.len() == 0) {
    return false;
  }
  let base: string = n;
  let bi: i32 = 0;
  while (bi < n.len()) {
    if (n[bi] == b'[') {
      base = slice_unchecked(n, 0, bi) + "";
      bi = n.len();
    } else {
      bi = bi + 1;
    }
  }
  if (base.len() == 0) {
    return false;
  }
  if (base[0] == b'(') {
    return false;
  }
  if (base == "i32" || base == "i64" || base == "u8" || base == "u32" || base == "u64"
    || base == "f32" || base == "f64" || base == "string" || base == "boolean" || base == "void"
    || base == "fn" || base == "unknown" || base == "any") {
    return false;
  }
  return true;
}

function ret_spelling_is_array(name: string): boolean {
  return type_ends_arr(name) || spelling_is_view(name);
}

function fn_ret_admitted(rr_name: string): string {
  if (ret_spelling_is_array(rr_name)) {
    return rr_name;
  }
  if (is_struct_ret_name(rr_name)) {
    return rr_name;
  }
  if (is_nominal_ret_name(rr_name)) {
    return rr_name;
  }
  if (rr_name == "string") {
    return "string";
  }
  if (is_scalar_ret_name(rr_name)) {
    return rr_name;
  }
  if (util.is_tuple_type_name(rr_name)) {
    return rr_name;
  }
  return "";
}

function at_unit_type(p: Par): boolean {
  return p.peek_punct() == "(" && p.peek_punct_at(1) == ")" && p.peek_punct_at(2) != "=>";
}

function consume_array_suffix(p: Par, name: string): (string, string, Par) {
  while (p.peek_punct() == "[") {
    p = p.advance();
    if (p.peek_punct() == "]") {
      p = p.advance();
      name = name + "[]";
    }
  }
  return (name, "", p);
}

function parse_type_dyn(p: Par): (string, string, Par) {
  p = p.advance();
  let (dinner_name, dinner_fn_ret, dinner_p) = parse_type_name(p);
  p = dinner_p;
  let dynname: string = dinner_name;
  while (p.peek_punct() == "+") {
    p = p.advance();
    let (dmore_name, dmore_fn_ret, dmore_p) = parse_type_name(p);
    p = dmore_p;
    if (dmore_name.len() == 0) {
      return ("", "", p);
    }
    dynname = dynname + " + " + dmore_name;
  }
  return ("dyn " + dynname, "", p);
}

function parse_type_handle(p: Par, base: string): (string, string, Par) {
  if (p.peek_ident_at(1).len() == 0) {
    let rest: Par = p.handle_word_misuse(base).advance();
    if (!starts_misused_handle_type(rest)) {
      return consume_array_suffix(rest, base);
    }
    return parse_type_name(rest);
  }
  p = p.advance();
  let (hinner_name, hinner_fn_ret, hinner_p) = parse_type_name(p);
  return (base + " " + hinner_name, "", hinner_p);
}

function starts_misused_handle_type(p: Par): boolean {
  if (is_type_keyword_tok(p, 0) || p.peek_keyword() == "dyn" || p.peek_punct() == "(") {
    return true;
  }
  return p.peek_punct() == "[" && p.peek_punct_at(1) != "]";
}

function parse_type_paren(p: Par): (string, string, Par) {
  return parse_type_paren_arrow(p, true);
}

function parse_type_name_reserving_arrow(p: Par): (string, string, Par) {
  if (p.peek_punct() != "(") {
    return parse_type_name(p);
  }
  return parse_type_paren_arrow(p, false);
}

function misused_handle_word(p: Par, word: string): boolean {
  if (word != "own" && word != "borrow" || p.peek_ident_at(1).len() > 0) {
    return false;
  }
  if (word == "borrow") {
    return true;
  }
  let next: string = p.punct_at(p.pos + 1);
  let prev: string = p.punct_at(p.pos - 1);
  if (next == "," || next == ")" || prev != "(" && prev != ",") {
    return true;
  }
  let open: i32 = enclosing_opener(p, p.pos - 1);
  return open < 0 || p.punct_at(open) != "(" || !p.closer_followed_by(open, "(", ")", "=>", "");
}

function enclosing_opener(p: Par, from: i32): i32 {
  let depth: i32 = 0;
  let j: i32 = from;
  while (j >= 0) {
    let t: string = p.punct_at(j);
    if (t == ")" || t == "]") {
      depth = depth + 1;
    } else if (t == "(" || t == "[") {
      if (depth == 0) {
        return j;
      }
      depth = depth - 1;
    }
    j = j - 1;
  }
  return 0 - 1;
}

function parse_type_paren_arrow(p: Par, top_arrow: boolean): (string, string, Par) {
  if (at_unit_type(p) || !top_arrow && p.peek_punct() == "(" && p.peek_punct_at(1) == ")") {
    let up: Par = p.refused_type(unit_type_message()).advance();
    up = up.advance();
    return consume_array_suffix(up, "void");
  }
  let dpa: Par = p.advance();
  if (dpa.peek_keyword() == "dyn") {
    let (dpw_name, dpw_fn_ret, dpw_p) = parse_type_name(dpa);
    if (dpw_p.peek_punct() == ")") {
      let dpw_after: Par = dpw_p.advance();
      if (!top_arrow || dpw_after.peek_punct() != "=>") {
        return consume_array_suffix(dpw_after, dpw_name);
      }
    }
  }
  let tbuf: string = "";
  let td: i32 = 0;
  let is_fn: boolean = false;
  let top_comma: boolean = false;
  let tprev_word: boolean = false;
  let tprev_prefix: boolean = false;
  let telem_empty: boolean = true;
  let telem_after_comma: boolean = false;
  while (!p.at_end()) {
    let tpk: string = p.peek_punct();
    if (at_unit_type(p)) {
      tbuf = tbuf + "void";
      p = p.refused_type(unit_type_message()).advance();
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      telem_empty = false;
      continue;
    }
    if (tpk == "(") {
      td = td + 1;
      telem_empty = true;
      telem_after_comma = false;
      tbuf = tbuf + "(";
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      continue;
    }
    if (tpk == ")") {
      if (telem_empty && telem_after_comma) {
        p = p.expected_type();
      }
      telem_empty = false;
      td = td - 1;
      tbuf = tbuf + ")";
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      if (td == 0) {
        break;
      }
      continue;
    }
    if (tpk == ",") {
      if (telem_empty) {
        p = p.expected_type();
      }
      telem_empty = true;
      telem_after_comma = true;
      if (td == 1) {
        top_comma = true;
      }
      tbuf = tbuf + ", ";
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      continue;
    }
    if (tpk == "=>") {
      is_fn = true;
      tbuf = tbuf + " => ";
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      telem_empty = true;
      continue;
    }
    if (tpk == "+") {
      tbuf = tbuf + " + ";
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      telem_empty = true;
      continue;
    }
    if (tpk.len() > 0) {
      tbuf = tbuf + tpk;
      p = p.advance();
      tprev_word = false;
      tprev_prefix = false;
      telem_empty = false;
      continue;
    }
    let tseg: string = p.peek_ident();
    if (tseg.len() == 0) {
      tseg = p.peek_keyword();
    }
    if (tseg.len() == 0) {
      p = p.expected_type().advance();
      continue;
    }
    if (misused_handle_word(p, tseg)) {
      p = p.handle_word_misuse(tseg);
    }
    if (at_float_type(p, tseg)) {
      p = p.refused_type(float_type_message());
      tseg = "f64";
    }
    if (tprev_word && (p.verbatim || tprev_prefix)) {
      tbuf = tbuf + " ";
    }
    tbuf = tbuf + tseg;
    tprev_word = true;
    tprev_prefix = tseg == "dyn" || tseg == "own" || tseg == "borrow";
    telem_empty = false;
    p = p.advance();
  }
  if (is_fn && !top_comma && !(top_arrow && p.peek_punct() == "=>")) {
    if (p.verbatim) {
      return consume_array_suffix(p, tbuf);
    }
    let (gname, gunused, gp) = consume_array_suffix(p, "fn");
    let gref: TypeRef = parse_type_ref(tbuf);
    if (!ref_is_fn_value(gref)) {
      return (gname, "", gp);
    }
    let gres: string = render_type_ref(ref_fn_result(gref));
    return (gname, fn_ret_admitted(gres), gp);
  }
  if (top_arrow && p.peek_punct() == "=>") {
    p = p.advance();
    let (rr_name, rr_fn_ret, rr_p) = parse_type_name(p);
    p = rr_p;
    let (fnr_name, fnr_fn_ret, fnr_p) = consume_array_suffix(p, "fn");
    let fn_ret_ty: string = fn_ret_admitted(rr_name);
    if (p.verbatim) {
      return (tbuf + " => " + rr_name + slice_unchecked(fnr_name, 2, fnr_name.len()), fn_ret_ty, fnr_p);
    }
    return (fnr_name, fn_ret_ty, fnr_p);
  }
  if (!top_comma) {
    return consume_array_suffix(p, unwrap_grouping_parens(tbuf));
  }
  return consume_array_suffix(p, tbuf);
}

function unwrap_grouping_parens(s: string): string {
  let t: string = s;
  while (t.len() > 2 && t[0] == b'(' && t[t.len() - 1] == b')') {
    t = slice_unchecked(t, 1, t.len() - 1) + "";
  }
  return t;
}

function matching_bracket(s: string, start: i32): i32 {
  let depth: i32 = 0;
  let i: i32 = start;
  while (i < s.len()) {
    if (s[i] == b'[') {
      depth = depth + 1;
    } else if (s[i] == b']') {
      depth = depth - 1;
      if (depth == 0) {
        return i;
      }
    }
    i = i + 1;
  }
  return 0 - 1;
}

function matching_close(s: string, start: i32): i32 {
  let depth: i32 = 0;
  let i: i32 = start;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    if (c == b'(' as i32) {
      depth = depth + 1;
    } else if (c == b')' as i32) {
      depth = depth - 1;
      if (depth == 0) {
        return i;
      }
    }
    i = i + 1;
  }
  return -1;
}

function group_has_top_comma(s: string, start: i32, close: i32): boolean {
  if (close <= start + 1) {
    return false;
  }
  let depth: i32 = 0;
  let i: i32 = start + 1;
  while (i < close) {
    let c: i32 = s[i] as i32;
    if (c == b'(' as i32 || c == b'[' as i32) {
      depth = depth + 1;
    } else if (c == b')' as i32 || c == b']' as i32) {
      depth = depth - 1;
    } else if (c == b',' as i32 && depth == 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function group_inner_is_fn(s: string, start: i32, close: i32): boolean {
  let depth: i32 = 0;
  let i: i32 = start + 1;
  while (i < close - 1) {
    let c: i32 = s[i] as i32;
    if (c == b'(' as i32 || c == b'[' as i32) {
      depth = depth + 1;
    } else if (c == b')' as i32 || c == b']' as i32) {
      depth = depth - 1;
    } else if (c == b'=' as i32 && s[i + 1] == b'>' && depth == 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function rest_starts_with_arrow(s: string, from: i32): boolean {
  let i: i32 = from;
  while (i < s.len() && s[i] == b' ') {
    i = i + 1;
  }
  return i + 1 < s.len() && s[i] == b'=' && s[i + 1] == b'>';
}

function rest_starts_with_array_suffix(s: string, from: i32): boolean {
  return from + 1 < s.len() && s[from] == b'[' && s[from + 1] == b']';
}

pub function canonicalise_type_args(s: string): string {
  let i: i32 = 0;
  while (i < s.len() && s[i] != b'(') {
    i = i + 1;
  }
  if (i >= s.len()) {
    return s;
  }
  let head: string = slice_unchecked(s, 0, i) + "";
  let close: i32 = matching_close(s, i);
  if (close < 0) {
    return s;
  }
  let inner: string = slice_unchecked(s, i + 1, close) + "";
  let rest_from: i32 = close + 1;
  let group_is_tuple: boolean = group_has_top_comma(s, i, close);
  let group_is_fn_param: boolean = rest_starts_with_arrow(s, rest_from);
  let group_is_fn_arr: boolean = !group_is_fn_param && group_inner_is_fn(s, i, close) && rest_starts_with_array_suffix(s, rest_from);
  if (group_is_tuple || group_is_fn_param || group_is_fn_arr) {
    return head + "(" + canonicalise_type_args(inner) + ")" + canonicalise_type_args(slice_unchecked(s, rest_from, s.len()) + "");
  }
  return head + canonicalise_type_args(inner) + canonicalise_type_args(slice_unchecked(s, rest_from, s.len()) + "");
}

function parse_type_punct_led(p: Par): (string, string, Par) {
  if (p.peek_punct() == "(") {
    return parse_type_paren(p);
  }
  if (p.peek_punct() == "[") {
    p = p.advance();
    let (bracketed_name, bracketed_fn_ret, bracketed_p) = parse_type_name(p);
    p = bracketed_p;
    if (p.peek_punct() == "]") {
      p = p.advance();
    }
    let (suffixed, sp) = parse_array_suffixes(p, "[" + bracketed_name + "]");
    return (suffixed, "", sp);
  }
  return ("", "", p.expected_type());
}

function parse_type_ident_led(p: Par, base: string): (string, string, Par) {
  p = p.advance();
  while (p.peek_punct() == "." || p.peek_punct() == "::") {
    let sep: string = p.peek_punct();
    p = p.advance();
    let seg0: string = p.peek_ident();
    if (seg0.len() == 0) {
      seg0 = p.peek_keyword();
    }
    if (seg0.len() == 0) {
      break;
    }
    base = base + sep + seg0;
    p = p.advance();
  }
  if (p.peek_punct() != "[") {
    return (base, "", p);
  }
  p = p.advance();
  let inner: string = "";
  let depth: i32 = 1;
  let prev_ident: boolean = false;
  let dyn_depth: i32 = 0 - 1;
  while (depth > 0 && !p.at_end()) {
    let pk: string = p.peek_punct();
    if (pk == "[") {
      depth = depth + 1;
      inner = inner + "[";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == "]") {
      depth = depth - 1;
      if (depth == 0) {
        break;
      }
      if (dyn_depth > depth) {
        dyn_depth = 0 - 1;
      }
      inner = inner + "]";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == ",") {
      if (dyn_depth == depth) {
        dyn_depth = 0 - 1;
      }
      p = p.advance();
      if (p.peek_punct() == ")") {
        p = p.expected_type();
      }
      if (p.peek_punct() != "]") {
        inner = inner + ", ";
      }
      prev_ident = false;
      continue;
    }
    if (pk == "+") {
      if (dyn_depth != depth) {
        p = p.expect("]");
      }
      inner = inner + " + ";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (at_unit_type(p)) {
      inner = inner + "void";
      p = p.refused_type(unit_type_message()).advance();
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == "(") {
      inner = inner + "(";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == ")") {
      inner = inner + ")";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == "=>") {
      inner = inner + " => ";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == "=") {
      inner = inner + " = ";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == "." || pk == "::") {
      inner = inner + pk;
      p = p.advance();
      prev_ident = false;
      continue;
    }
    let seg: string = p.peek_ident();
    if (seg.len() == 0) {
      seg = p.peek_keyword();
    }
    if (seg.len() == 0) {
      break;
    }
    if (seg == "dyn") {
      dyn_depth = depth;
    }
    if (misused_handle_word(p, seg)) {
      p = p.handle_word_misuse(seg);
    }
    if (at_float_type(p, seg)) {
      p = p.refused_type(float_type_message());
      seg = "f64";
    }
    if (prev_ident) {
      inner = inner + " ";
    }
    inner = inner + seg;
    p = p.advance();
    prev_ident = true;
  }
  if (p.peek_punct() == "]") {
    p = p.advance();
  }
  let nm: string = base + "[" + canonicalise_type_args(inner) + "]";
  while (p.peek_punct() == "::") {
    let pp: Par = p.advance();
    let pseg: string = pp.peek_ident();
    if (pseg.len() == 0) {
      pseg = pp.peek_keyword();
    }
    if (pseg.len() == 0) {
      break;
    }
    nm = nm + "::" + pseg;
    p = pp.advance();
  }
  let (suffixed, sp) = parse_array_suffixes(p, nm);
  return (suffixed, "", sp);
}

function parse_array_suffixes(p: Par, nm: string): (string, Par) {
  let out: string = nm;
  while (p.peek_punct() == "[") {
    if (p.peek_punct_at(1) != "]") {
      break;
    }
    p = p.advance().advance();
    out = out + "[]";
  }
  return (out, p);
}

function parse_type_name(p: Par): (string, string, Par) {
  if (p.too_deep()) {
    return ("", "", p.bail());
  }
  let (g0, g1, gq) = parse_type_name_nested(p.with_depth(p.depth + 1));
  return (g0, g1, gq.with_depth(p.depth));
}

struct DeclType { name: string, fn_ret: string, fn_params: string }

function parse_decl_type(p: Par): (DeclType, Par) {
  let (name, fn_ret, end) = parse_type_name(p);
  let out: DeclType = DeclType { name: name, fn_ret: fn_ret, fn_params: "" };
  if (p.verbatim || !is_fn_contract_tag(name)) {
    return (out, end);
  }
  let (written, wr_ret, wr_end) = parse_type_name(Par { ...p, verbatim: true });
  let ref: TypeRef = fn_ref_of(name, written);
  if (!ref_is_fn_value(ref)) {
    return (out, end);
  }
  let result: string = render_type_ref(ref_fn_result(ref));
  return (DeclType {
    name: name, fn_ret: result,
    fn_params: ref_fn_param_spellings(ref),
  }, end);
}

function fn_ref_of(name: string, written: string): TypeRef {
  let ref: TypeRef = ref_ungroup(parse_type_ref(written));
  if (name == "fn[]" && ref.array_depth == 1) {
    ref = ref_ungroup(elem_type_ref(ref));
  }
  if (name == "[fn]" && ref.is_view) {
    ref = ref_ungroup(ref.args[0]);
  }
  return ref;
}

function fn_contract_of(name: string, written: string): (string, string) {
  if (!is_fn_contract_tag(name)) {
    return ("", "");
  }
  let ref: TypeRef = fn_ref_of(name, written);
  if (!ref_is_fn_value(ref)) {
    return ("", "");
  }
  return (render_type_ref(ref_fn_result(ref)), ref_fn_param_spellings(ref));
}

function parse_type_name_nested(p: Par): (string, string, Par) {
  let base: string = p.peek_ident();
  if (base.len() == 0) {
    base = p.peek_keyword();
  }
  if (base == "dyn") {
    return parse_type_dyn(p);
  }
  if (base == "own" || base == "borrow") {
    return parse_type_handle(p, base);
  }
  if (base.len() == 0) {
    return parse_type_punct_led(p);
  }
  if (at_float_type(p, base)) {
    return parse_type_ident_led(p.refused_type(float_type_message()), "f64");
  }
  return parse_type_ident_led(p, base);
}

function at_pattern_head(p: Par): boolean {
  let i: i32 = pattern_head_index(p);
  return p.punct_at(i) == "(" || record_pattern_brace_at(p, i) >= 0;
}

function pattern_head_index(p: Par): i32 {
  if (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@") {
    return p.pos + 2;
  }
  return p.pos;
}

function record_pattern_brace_at(p: Par, idx: i32): i32 {
  if (p.ident_at(idx).len() == 0) {
    return 0 - 1;
  }
  idx = idx + 1;
  while (p.punct_at(idx) == "." && p.ident_at(idx + 1).len() > 0) {
    idx = idx + 2;
  }
  if (p.punct_at(idx) == "{") {
    return idx;
  }
  return 0 - 1;
}

function qualified_record_pattern_ahead(p: Par): boolean {
  let i: i32 = pattern_head_index(p);
  return record_pattern_brace_at(p, i) > i + 1;
}

function parse_record_pattern_head(p: Par): (string, Par) {
  let name: string = p.peek_ident();
  p = p.advance();
  while (p.peek_punct() == "." && p.peek_ident_at(1).len() > 0) {
    name = name + "." + p.peek_ident_at(1);
    p = p.advance().advance();
  }
  return (name, p);
}

function qualified_struct_binding(pat: ast.Pattern, init: ast.Expr, line: i32, col: i32): ast.Stmt {
  if let ast.PatVariant(pv) = pat {
    if (is_record_pattern(pv) && !pv.has_lit_cond && pv.nested.len() == 0 && pv.field_names.len() > 0) {
      let names: string = "";
      let fields: string = "";
      let i: i32 = 0;
      while (i < pv.field_names.len()) {
        if (i > 0) {
          names = names + ",";
          fields = fields + ",";
        }
        names = names + discard_name(payload_binder(pv, i), line, col, i);
        fields = fields + pv.field_names[i];
        i = i + 1;
      }
      return s_var_at(names, destr_marker(pv.at_binding, pv.rest_written, "@sd:" + pv.type_name + ":" + fields), init, line, col);
    }
  }
  return s_unknown_at("a struct destructuring pattern binds field names", line, col);
}

pub struct DestrMarker { at: string, rest_written: boolean, struct_match: boolean, tag: string }

pub function destr_marker(at: string, rest_written: boolean, tag: string): string {
  let out: string = tag;
  if (rest_written) {
    out = "@rest;" + out;
  }
  if (at.len() > 0) {
    out = "@at:" + at + ";" + out;
  }
  return out;
}

pub function pp_marker(rest: string): string {
  return "@pp;" + rest;
}

pub function is_param_prelude_marker(type_name: string): boolean {
  return util.str_has_prefix(type_name, "@pp;");
}

pub function strip_pp_marker(marker: string): string {
  if (!util.str_has_prefix(marker, "@pp;")) {
    return marker;
  }
  return slice_unchecked(marker, 4, marker.len()) + "";
}

pub function destr_marker_split(marker0: string): DestrMarker {
  let at: string = "";
  let m: string = strip_pp_marker(marker0);
  let struct_match: boolean = util.str_has_prefix(m, "@sm;");
  if (struct_match) {
    m = slice_unchecked(m, 4, m.len()) + "";
  }
  if (util.str_has_prefix(m, "@at:")) {
    let i: i32 = 4;
    while (i < m.len()) {
      if (m[i] == b';') {
        at = slice_unchecked(m, 4, i) + "";
        m = slice_unchecked(m, i + 1, m.len()) + "";
        break;
      }
      i = i + 1;
    }
  }
  let rest_written: boolean = false;
  if (util.str_has_prefix(m, "@rest;")) {
    rest_written = true;
    m = slice_unchecked(m, 6, m.len()) + "";
  }
  return DestrMarker { at: at, rest_written: rest_written, struct_match: struct_match, tag: m };
}

pub function is_struct_destr_marker(type_name: string): boolean {
  return util.str_has_prefix(destr_marker_split(type_name).tag, "@sd:");
}

pub function is_destr_marker(type_name: string): boolean {
  return type_name.len() > 0 && type_name[0] == b'@'
    && (util.str_has_prefix(type_name, "@pp;")
    || util.str_has_prefix(type_name, "@sm;")
    || util.str_has_prefix(type_name, "@at:")
    || util.str_has_prefix(type_name, "@rest;")
    || util.str_has_prefix(type_name, "@sd:"));
}

function parse_pattern_param(p: Par): (ast.ParamDecl, ParamDestr, Par) {
  let tline: i32 = p.peek_line();
  let tcol: i32 = p.peek_col();
  let bad_param: ast.ParamDecl = ast.ParamDecl { name: "", type_name: "", own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" };
  let bad: ParamDestr = ParamDestr { names: "", marker: "", synth: "", line: tline, col: tcol };
  let holder: string = "";
  if (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@") {
    holder = p.peek_ident();
    p = p.advance();
    p = p.advance();
  }
  let names: string = "";
  let marker: string = "";
  if (p.peek_punct() == "(") {
    let tuple_start: Par = p;
    let (tnames, names_count, names_ok, names_p) = parse_destructure_names(p);
    p = names_p;
    if (!names_ok) {
      let refused: Par = tuple_start.refused_type(refutable_binding_message("a literal tuple element", "parameter"));
      let recovered: Par = tuple_start.advance().skip_to_close(")");
      p = Par { ...recovered, type_errs: refused.type_errs };
      names = "__invalid_pattern";
    } else if (names_count < 2) {
      return (bad_param, bad, p);
    } else {
      names = tnames;
    }
  } else {
    if (record_pattern_brace_at(p, p.pos) < 0) {
      return (bad_param, bad, p);
    }
    let (struct_name, head_p) = parse_record_pattern_head(p);
    p = head_p;
    let (binds, fields, fields_rest, fields_ok, fields_p) = parse_struct_pattern_fields(p);
    p = fields_p;
    if (!fields_ok || binds.len() == 0) {
      return (bad_param, bad, p);
    }
    names = binds;
    marker = destr_marker("", fields_rest, "@sd:" + struct_name + ":" + fields);
  }
  if (p.peek_punct() != ":") {
    return (bad_param, bad, p);
  }
  p = p.advance();
  let (tr, tr_p) = parse_decl_type(p);
  p = tr_p;
  if (p.peek_punct() == "=") {
    return (bad_param, bad, p);
  }
  if (holder.len() == 0) {
    holder = "__ptuple_" + util.i32_to_string(tline) + "_" + util.i32_to_string(tcol);
  }
  return (ast.ParamDecl { name: holder, type_name: tr.name, own: false, has_default: false, default_value: e_unknown(""), fn_ret: tr.fn_ret, fn_param_types: tr.fn_params }, ParamDestr { names: names, marker: marker, synth: holder, line: tline, col: tcol }, p);
}

function prepend_param_destrs(body: ast.Stmt[], destrs: ParamDestr[]): ast.Stmt[] {
  if (destrs.len() == 0) {
    return body;
  }
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < destrs.len()) {
    let d: ParamDestr = destrs[i];
    out = out.append(s_var_at(d.names, pp_marker(d.marker), e_ident_at(d.synth, d.line, d.col), d.line, d.col));
    i = i + 1;
  }
  let j: i32 = 0;
  while (j < body.len()) {
    out = out.append(body[j]);
    j = j + 1;
  }
  return out;
}

function refutable_binding_message(kind: string, site: string): string {
  return kind + " can fail to match, so it cannot be a " + site + " pattern — there is no else branch here; destructure with a tuple `(a, b)` or struct `S { x, y }` pattern, or `match` on the value in the body";
}

function refused_variant_param(p: Par): (ast.ParamDecl, Par) {
  let refused: Par = p.refused_type(refutable_binding_message("an enum variant pattern", "parameter"));
  let (pattern, parsed) = parse_pattern(p);
  p = Par { ...parsed, type_errs: refused.type_errs };
  p = p.expect(":");
  let (tr, next) = parse_decl_type(p);
  return (ast.ParamDecl { name: "__invalid_pattern", type_name: tr.name, own: false, has_default: false, default_value: e_unknown(""), fn_ret: tr.fn_ret, fn_param_types: tr.fn_params }, next);
}

function parse_param(p: Par, nth: i32): (ast.ParamDecl, Par) {
  if (p.peek_ident().len() > 0 && (p.peek_punct_at(1) == "(" || p.peek_punct_at(1) == ".")) {
    return refused_variant_param(p);
  }
  let name: string = p.peek_ident();
  if (name.len() == 0) {
    return (ast.ParamDecl { name: "__invalid_param", type_name: "", own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }, p.refused_type("expected a name, got " + tok_desc(p.peek())));
  }
  let is_own: boolean = false;
  if (name == "own") {
    let probe: Par = p.advance();
    if (probe.peek_ident().len() > 0) {
      is_own = true;
      p = probe;
      name = p.peek_ident();
    }
  }
  name = discard_name(name, p.peek_line(), p.peek_col(), nth);
  p = p.advance();
  if (p.peek_punct() != ":") {
    return (ast.ParamDecl { name: name, type_name: "", own: is_own, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }, p.refused_type("expected \":\", got " + tok_desc(p.peek())));
  }
  p = p.advance();
  let (tr, tr_p) = parse_decl_type(p);
  p = tr_p;
  let has_def: boolean = false;
  let def_val: ast.Expr = e_unknown("");
  if (p.peek_punct() == "=") {
    p = p.advance();
    let (de_expr, de_p) = parse_expr(p);
    p = de_p;
    has_def = true;
    def_val = de_expr;
  }
  return (ast.ParamDecl { name: name, type_name: tr.name, own: is_own, has_default: has_def, default_value: def_val, fn_ret: tr.fn_ret, fn_param_types: tr.fn_params }, p);
}

struct TpList { tnames: string[], tbounds: string[] }

function parse_type_param_list(p: Par): (TpList, Par) {
  let names: string[] = [];
  let bounds: string[] = [];
  if (p.peek_punct() != "[") {
    return (TpList { tnames: names, tbounds: bounds }, p);
  }
  p = p.advance();
  while (!p.at_end()) {
    if (p.peek_punct() == "]") {
      break;
    }
    if (p.peek_keyword() == "const") {
      let (cname, cp) = parse_const_tparam(p);
      names = names.append(cname);
      bounds = bounds.append(CONST_BOUND);
      p = tparam_sep(cp);
      continue;
    }
    let tpname: string = p.peek_ident();
    if (tpname.len() == 0) {
      p = p.advance();
      continue;
    }
    p = p.advance();
    let this_bounds: string = "";
    if (p.peek_punct() == ":") {
      p = p.advance();
      let go: boolean = true;
      while (go && !p.at_end()) {
        let tname: string = "";
        if (p.peek_ident().len() > 0) {
          tname = p.peek_ident();
          p = p.advance();
        }
        if (p.peek_punct() == ".") {
          p = p.advance();
          if (p.peek_ident().len() > 0) {
            tname = tname + "." + p.peek_ident();
            p = p.advance();
          }
        }
        if (p.peek_punct() == "[") {
          p = p.advance();
          let bargs: string = "";
          while (!p.at_end() && p.peek_punct() != "]") {
            let barg_at: i32 = p.pos;
            let (barg, barg_ret, barg_p) = parse_type_name(p);
            p = barg_p;
            if (p.pos == barg_at) {
              p = p.expected_type().advance();
              continue;
            }
            if (bargs.len() > 0) {
              bargs = bargs + ", ";
            }
            bargs = bargs + barg;
            if (p.peek_punct() == ",") {
              p = p.advance();
            } else if (p.peek_punct() != "]") {
              p = p.expect("]").advance();
            }
          }
          if (p.peek_punct() == "]") {
            p = p.advance();
          }
          tname = tname + "[" + bargs + "]";
        }
        if (tname.len() > 0) {
          if (this_bounds.len() > 0) {
            this_bounds = this_bounds + "+";
          }
          this_bounds = this_bounds + tname;
        }
        if (p.peek_punct() == "+") {
          p = p.advance();
        } else {
          go = false;
        }
      }
    }
    names = names.append(tpname);
    bounds = bounds.append(this_bounds);
    p = tparam_sep(p);
  }
  if (p.peek_punct() == "]") {
    p = p.advance();
  }
  return (TpList { tnames: names, tbounds: bounds }, p);
}

function tparam_sep(p: Par): Par {
  if (p.peek_punct() == ",") {
    return p.advance();
  }
  if (p.peek_punct() != "]" && !p.at_end()) {
    p = Par { ...p, type_errs: p.type_errs.append(s_unknown(p, "decl:expected \"]\", got " + tok_desc(p.peek()))) };
    while (!p.at_end() && p.peek_punct() != "]") {
      p = p.advance();
    }
  }
  return p;
}

pub const CONST_BOUND: string = "const";

pub function is_const_bound(bound: string): boolean {
  return bound == CONST_BOUND;
}

function parse_const_tparam(p: Par): (string, Par) {
  p = p.advance();
  let name: string = p.peek_ident();
  if (name.len() == 0) {
    return ("", Par { ...p, type_errs: p.type_errs.append(s_unknown(p, "decl:expected a name, got " + tok_desc(p.peek()))) });
  }
  p = p.advance();
  if (p.peek_punct() != ":") {
    return (name, Par { ...p, type_errs: p.type_errs.append(s_unknown(p, "decl:const parameter " + name + " needs a type: write const " + name + ": i32")) });
  }
  p = p.advance();
  if (p.peek_keyword() != "i32") {
    return (name, Par { ...p, type_errs: p.type_errs.append(s_unknown(p, "decl:const parameter " + name + " has type i32, got " + tok_desc(p.peek()))) });
  }
  return (name, p.advance());
}

function refuse_const_tparams(p: Par, at: Par, tpl: TpList): Par {
  let i: i32 = 0;
  while (i < tpl.tnames.len()) {
    if (is_const_bound(tpl.tbounds[i])) {
      return Par { ...p, type_errs: p.type_errs.append(s_unknown(at, "decl:const parameter " + tpl.tnames[i] + ": only a function takes a const parameter")) };
    }
    i = i + 1;
  }
  return p;
}

function receiver_clause(p: Par): boolean {
  if (p.peek_punct() != "(") {
    return false;
  }
  let q: Par = p.advance();
  if (q.peek_ident() == "own" && q.peek_ident_at(1).len() > 0) {
    q = q.advance();
  }
  if (q.peek_ident().len() == 0) {
    return false;
  }
  q = q.advance();
  if (q.peek_punct() != ":") {
    return false;
  }
  let depth: i32 = 0;
  while (!q.at_end()) {
    if (q.peek_punct() == "(") {
      depth = depth + 1;
    }
    if (q.peek_punct() == ")") {
      if (depth == 0) {
        q = q.advance();
        return q.peek_ident().len() > 0 && (q.peek_punct_at(1) == "(" || q.peek_punct_at(1) == "[");
      }
      depth = depth - 1;
    }
    q = q.advance();
  }
  return false;
}

function parse_func_decl(p: Par): (FuncDecl, Par) {
  let fline: i32 = p.peek_line();
  let fcol: i32 = p.peek_col();
  p = p.advance();
  let errs_before: i32 = p.type_errs.len();
  let empty_params: ast.ParamDecl[] = [];
  let empty_body: ast.Stmt[] = [];
  let bounded_tps: string[] = [];
  let bound_names: string[] = [];
  let unbounded_tps: string[] = [];
  let all_tps: string[] = [];
  let (pre_tps, pre_p) = parse_type_param_list(p);
  p = pre_p;
  let tpi1: i32 = 0;
  while (tpi1 < pre_tps.tnames.len()) {
    all_tps = all_tps.append(pre_tps.tnames[tpi1]);
    if (p.verbatim || pre_tps.tbounds[tpi1].len() > 0) {
      bounded_tps = bounded_tps.append(pre_tps.tnames[tpi1]);
      bound_names = bound_names.append(pre_tps.tbounds[tpi1]);
    } else {
      unbounded_tps = unbounded_tps.append(pre_tps.tnames[tpi1]);
    }
    tpi1 = tpi1 + 1;
  }
  let receiver_name: string = "";
  let receiver_type: string = "";
  let receiver_own: boolean = false;
  if (receiver_clause(p)) {
    p = p.advance();
    receiver_name = p.peek_ident();
    if (receiver_name == "own") {
      let rprobe: Par = p.advance();
      if (rprobe.peek_ident().len() > 0) {
        p = rprobe;
        receiver_name = p.peek_ident();
        receiver_own = true;
      }
    }
    if (receiver_name.len() > 0) {
      p = p.advance();
      if (p.peek_punct() == ":") {
        p = p.advance();
        let (rtr_name, rtr_fn_ret, rtr_p) = parse_type_name(p);
        p = rtr_p;
        receiver_type = rtr_name;
      }
    }
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
  }
  let name: string = p.peek_ident();
  if (name.len() == 0) {
    p = p.refused_type("expected a name, got " + tok_desc(p.peek()));
    return (FuncDecl { stdlib: "", no_inline: false, name: "", receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: [], bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
  }
  let name_p: Par = p;
  p = p.advance();
  let (post_tps, post_p) = parse_type_param_list(p);
  p = post_p;
  if (receiver_name.len() > 0) {
    p = refuse_const_tparams(refuse_const_tparams(p, name_p, pre_tps), name_p, post_tps);
  }
  let tpi0: i32 = 0;
  while (tpi0 < post_tps.tnames.len()) {
    all_tps = all_tps.append(post_tps.tnames[tpi0]);
    if (p.verbatim || post_tps.tbounds[tpi0].len() > 0) {
      bounded_tps = bounded_tps.append(post_tps.tnames[tpi0]);
      bound_names = bound_names.append(post_tps.tbounds[tpi0]);
    } else {
      unbounded_tps = unbounded_tps.append(post_tps.tnames[tpi0]);
    }
    tpi0 = tpi0 + 1;
  }
  if (p.peek_punct() != "(") {
    return (FuncDecl { stdlib: "", no_inline: false, name: name, receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: all_tps, bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
  }
  p = p.advance();
  let params: ast.ParamDecl[] = [];
  let pd: ParamDestr[] = [];
  if (p.peek_punct() != ")") {
    while (true) {
      if (at_pattern_head(p)) {
        let (tpr_param, tpr_destr, tpr_p) = parse_pattern_param(p);
        p = tpr_p;
        if (tpr_destr.names.len() == 0) {
          return (FuncDecl { stdlib: "", no_inline: false, name: "", receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: [], bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
        }
        params = params.append(tpr_param);
        pd = pd.append(tpr_destr);
        if (p.peek_punct() == ",") {
          p = p.advance();
          if (p.peek_punct() == ")") {
            break;
          }
          continue;
        }
        break;
      }
      let (pr_param, pr_p) = parse_param(p, params.len());
      p = pr_p;
      params = params.append(pr_param);
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == ")") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  let ret_type: string = "";
  let fn_ret_fn_ret: string = "";
  let fn_ret_fn_ptys: string = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    let (fr, fr_tr_p) = parse_decl_type(p);
    p = fr_tr_p;
    ret_type = fr.name;
    fn_ret_fn_ret = fr.fn_ret;
    fn_ret_fn_ptys = fr.fn_params;
  }
  let declared_bound: boolean = bounded_tps.len() > 0;
  let ui: i32 = 0;
  while (ui < unbounded_tps.len()) {
    let un: string = unbounded_tps[ui];
    let feeds: boolean = feeds_user_parametric(ret_type, un) || feeds_map_typearg(ret_type, un);
    let bindable: boolean = false;
    let pj: i32 = 0;
    while (pj < params.len()) {
      if (feeds_user_parametric(params[pj].type_name, un) || feeds_map_typearg(params[pj].type_name, un)) {
        feeds = true;
      }
      if (token_at_paren_depth0(params[pj].type_name, un) || token_in_tuple_param(params[pj].type_name, un)) {
        bindable = true;
      }
      pj = pj + 1;
    }
    let ret_bindable: boolean = feeds_user_parametric(ret_type, un) || feeds_map_typearg(ret_type, un);
    let promote: boolean = feeds && (bindable || ret_bindable);
    if (all_tps.len() == 1 && has_bare_scalar_param(params, un) && feeds_wide_container(ret_type, un)) {
      promote = true;
    }
    if (receiver_type.len() == 0 && all_tps.len() == 1 && has_bare_array_param(params, un) && type_mentions_var(ret_type, un)) {
      promote = true;
    }
    if (all_tps.len() == 2 && result_two_bare_vars(ret_type, unbounded_tps) && has_any_bare_scalar_param(params, unbounded_tps)) {
      promote = true;
    }
    if (has_bare_scalar_param(params, un) && !ret_mentions_any(ret_type, unbounded_tps)
      && all_bare_scalar_bound(params, unbounded_tps)) {
      promote = true;
    }
    if (declared_bound && all_fn_param_bound(params, unbounded_tps)) {
      promote = true;
    }
    if (promote) {
      bounded_tps = bounded_tps.append(un);
      bound_names = bound_names.append("");
    }
    ui = ui + 1;
  }
  if (p.peek_punct() == ";") {
    p = p.advance();
    if (pd.len() > 0) {
      return (FuncDecl { stdlib: "", no_inline: false, name: "", receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: [], bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
    }
    return (FuncDecl { stdlib: "", no_inline: false, name: name, receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: params, ret_type: ret_type, body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: all_tps, bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: fn_ret_fn_ret, ret_fn_param_types: fn_ret_fn_ptys, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
  }
  let (blk_body, blk_p) = parse_block(p);
  p = blk_p;
  let fbody: ast.Stmt[] = prepend_param_destrs(blk_body, pd);
  if (p.type_errs.len() > errs_before) {
    let kept: ast.Stmt[] = [];
    let tei: i32 = 0;
    while (tei < p.type_errs.len()) {
      if (tei < errs_before) {
        kept = kept.append(p.type_errs[tei]);
      } else {
        fbody = fbody.append(p.type_errs[tei]);
      }
      tei = tei + 1;
    }
    p = Par { ...p, type_errs: kept };
  }
  if (receiver_type.len() == 0 && (body_binds_bare_var(fbody, params, unbounded_tps, bounded_tps)
    || body_feeds_user_parametric(fbody, erased_only(unbounded_tps, bounded_tps)))) {
    let all_bindable: boolean = true;
    let di: i32 = 0;
    while (di < unbounded_tps.len()) {
      let dn: string = unbounded_tps[di];
      if (util.index_of_str(bounded_tps, dn) < 0) {
        let dbind: boolean = false;
        let dpj: i32 = 0;
        while (dpj < params.len()) {
          if (token_at_paren_depth0(params[dpj].type_name, dn) || token_in_tuple_param(params[dpj].type_name, dn)) {
            dbind = true;
          }
          dpj = dpj + 1;
        }
        if (has_fn_param_arg_var(params, dn) || has_fn_param_ret_var(params, dn)) {
          dbind = true;
        }
        if (!dbind) {
          all_bindable = false;
        }
      }
      di = di + 1;
    }
    if (all_bindable) {
      let dk: i32 = 0;
      while (dk < unbounded_tps.len()) {
        if (util.index_of_str(bounded_tps, unbounded_tps[dk]) < 0) {
          bounded_tps = bounded_tps.append(unbounded_tps[dk]);
          bound_names = bound_names.append("");
        }
        dk = dk + 1;
      }
    }
  }
  return (FuncDecl { stdlib: "", no_inline: false, name: name, receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: params, ret_type: ret_type, body: fbody, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: all_tps, bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: fn_ret_fn_ret, ret_fn_param_types: fn_ret_fn_ptys, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
}

function parse_struct_field(p: Par): (StructFieldDecl, Par) {
  let name: string = p.peek_ident();
  if (name.len() == 0) {
    return (StructFieldDecl { name: "", type_name: "", fn_ret: "", fn_param_types: "" }, p);
  }
  p = p.advance();
  if (p.peek_punct() != ":") {
    return (StructFieldDecl { name: name, type_name: "", fn_ret: "", fn_param_types: "" }, p);
  }
  p = p.advance();
  return parse_field_type(p, name);
}

function parse_field_type(p: Par, name: string): (StructFieldDecl, Par) {
  let (ty, end) = parse_decl_type(p);
  return (StructFieldDecl { name: name, type_name: ty.name, fn_ret: ty.fn_ret, fn_param_types: ty.fn_params }, end);
}

function parse_decl_tparams(p: Par, kind: string, name: string): (string[], Par) {
  let tparams: string[] = [];
  if (p.peek_punct() != "[") {
    return (tparams, p);
  }
  p = p.advance();
  let gd: i32 = 1;
  while (!p.at_end() && gd > 0) {
    let gpk: string = p.peek_punct();
    if (gpk == "[") {
      gd = gd + 1;
      p = p.advance();
      continue;
    }
    if (gpk == "]") {
      gd = gd - 1;
      p = p.advance();
      continue;
    }
    if (gd == 1) {
      let tpn: string = p.peek_ident();
      if (tpn.len() > 0) {
        tparams = tparams.append(tpn);
        p = p.advance();
        if (p.peek_punct() == ":") {
          p = Par { ...p, type_errs: p.type_errs.append(s_unknown(p, "decl:" + kind + " " + name + ": a bound on type parameter " + tpn + " belongs on an impl (impl[" + tpn + ": Trait] Trait for " + name + "[" + tpn + "]), not on the declaration")) };
        }
        continue;
      }
    }
    p = p.advance();
  }
  return (tparams, p);
}

function parse_struct_decl(p: Par): (StructDecl, i32[], Par) {
  let sline: i32 = p.peek_line();
  let scol: i32 = p.peek_col();
  let flines: i32[] = [];
  p = p.advance();
  let name: string = p.peek_ident();
  let notp0: string[] = [];
  if (name.len() == 0) {
    let empty: StructFieldDecl[] = [];
    return (StructDecl { name: "", fields: empty, type_params: notp0, derives: [], line: sline, col: scol, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" }, flines, p);
  }
  p = p.advance();
  let (tparams, tp_p) = parse_decl_tparams(p, "struct", name);
  p = tp_p;
  if (p.peek_punct() != "{") {
    let empty: StructFieldDecl[] = [];
    return (StructDecl { name: name, fields: empty, type_params: tparams, derives: [], line: sline, col: scol, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" }, flines, p);
  }
  p = p.advance();
  let fields: StructFieldDecl[] = [];
  if (p.peek_punct() != "}") {
    while (true) {
      let fline: i32 = p.peek_line();
      let (fr_field, fr_p) = parse_struct_field(p);
      p = fr_p;
      fields = fields.append(fr_field);
      flines = flines.append(fline);
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == "}") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (StructDecl { name: name, fields: fields, type_params: tparams, derives: [], line: sline, col: scol, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" }, flines, p);
}

function parse_type_alias(p: Par): (TypeAlias, Par) {
  let taline: i32 = p.peek_line();
  let tacol: i32 = p.peek_col();
  p = p.advance();
  let name: string = p.peek_ident();
  if (name.len() == 0) {
    return (TypeAlias { name: "", variants: [], variant_args: [], variant_lines: [], type_params: [], line: taline, col: tacol, is_pub: true, is_package: false, module: "" }, p);
  }
  p = p.advance();
  let (tparams, tp_p) = parse_decl_tparams(p, "type", name);
  p = tp_p;
  if (p.peek_punct() != "=") {
    return (TypeAlias { name: name, variants: [], variant_args: [], variant_lines: [], type_params: tparams, line: taline, col: tacol, is_pub: true, is_package: false, module: "" }, p);
  }
  p = p.advance();
  let variants: string[] = [];
  let vargs: string[] = [];
  let vlines: i32[] = [];
  while (p.peek_ident().len() > 0) {
    vlines = vlines.append(p.peek_line());
    let (dt, dt_p) = parse_decl_type(p);
    p = dt_p;
    let r: TypeRef = parse_type_ref(dt.name);
    variants = variants.append(r.base);
    vargs = vargs.append(type_ref_args_spelling(r));
    if (p.peek_punct() == "|") {
      p = p.advance();
      continue;
    }
    break;
  }
  p = p.expect_semi();
  return (TypeAlias { name: name, variants: variants, variant_args: vargs, variant_lines: vlines, type_params: tparams, line: taline, col: tacol, is_pub: true, is_package: false, module: "" }, p);
}

function type_ref_args_spelling(r: TypeRef): string {
  let out: string = "";
  for a in r.args {
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + me_ref_spelling(a);
  }
  return out;
}

function parse_enum_decl(p: Par): (string, StructDecl[], string[], i32[], Par) {
  p = p.advance();
  let out: StructDecl[] = [];
  let vlines: i32[] = [];
  let name: string = p.peek_ident();
  if (name.len() == 0) {
    return ("", out, [], vlines, p);
  }
  p = p.advance();
  let (tparams, tp_p) = parse_decl_tparams(p, "enum", name);
  p = tp_p;
  if (p.peek_punct() != "{") {
    return (name, out, tparams, vlines, p);
  }
  p = p.advance();
  while (p.peek_punct() != "}" && !p.at_end()) {
    let vline: i32 = p.peek_line();
    let vname: string = p.peek_ident();
    if (vname.len() == 0) {
      break;
    }
    p = p.advance();
    let fields: StructFieldDecl[] = [];
    let vfnames: string[] = [];
    if (p.peek_punct() == "{") {
      p = p.advance();
      let rnum: i32 = 0;
      while (p.peek_punct() != "}" && !p.at_end()) {
        let rfname: string = p.peek_ident();
        if (rfname.len() == 0) {
          break;
        }
        p = p.advance();
        if (p.peek_punct() == ":") {
          p = p.advance();
        }
        let mark: string = "__ev";
        if (rnum > 0) {
          mark = "__ev" + dl_itoa(rnum);
        }
        let (rf, rf_p) = parse_field_type(p, mark);
        p = rf_p;
        fields = fields.append(rf);
        vfnames = vfnames.append(rfname);
        rnum = rnum + 1;
        if (p.peek_punct() == ",") {
          p = p.advance();
          continue;
        }
        break;
      }
      if (p.peek_punct() == "}") {
        p = p.advance();
      }
    } else if (p.peek_punct() == "(") {
      p = p.advance();
      let (tr, tr_p) = parse_field_type(p, "__ev");
      p = tr_p;
      fields = fields.append(tr);
      let pnum: i32 = 1;
      let (pmore, pmore_p) = p.more_elems(")");
      p = pmore_p;
      while (pmore) {
        let (tr2, tr2_p) = parse_field_type(p, "__ev" + dl_itoa(pnum));
        p = tr2_p;
        fields = fields.append(tr2);
        pnum = pnum + 1;
        let (pm2, pm2_p) = p.more_elems(")");
        pmore = pm2;
        p = pm2_p;
      }
      if (p.peek_punct() == ")") {
        p = p.advance();
      }
    }
    out = out.append(StructDecl { name: vname, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: name, must_consume: false, variant_field_names: vfnames, is_pub: true, is_package: false, opaque: false, module: "" });
    vlines = vlines.append(vline);
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (name, out, tparams, vlines, p);
}

function parse_import(p: Par): (Import, ast.Stmt[], Par) {
  let imp_line: i32 = p.peek_line();
  let imp_col: i32 = p.peek_col();
  p = p.advance();
  let path: string = "";
  let bad: ast.Stmt[] = [];
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokString(s) => {
      path = s.value;
      p = p.advance();
    },
    _ => {
      bad = bad.append(decl_sentinel(p, "malformed import: its path could not be read"));
      return (Import { path: "", is_reexport: false, reexport_names: [], alias: "", line: imp_line, col: imp_col, resolved: "" }, bad, sync_to_top_level(p));
    }
  }
  let alias: string = "";
  if (p.peek_keyword() == "as") {
    p = p.advance();
    alias = p.peek_ident();
    if (alias.len() > 0) {
      p = p.advance();
    } else {
      bad = bad.append(decl_sentinel(p, "malformed import alias: its name could not be read (a keyword such as `type` or `match` cannot be a name)"));
    }
  }
  p = p.expect_semi();
  return (Import { path: path, is_reexport: false, reexport_names: [], alias: alias, line: imp_line, col: imp_col, resolved: "" }, bad, p);
}

function parse_pubuse(p: Par, pu_line: i32, pu_col: i32): (Import, ast.Stmt[], Par) {
  p = p.advance();
  let none: Import = Import { path: "", is_reexport: true, reexport_names: [], alias: "", line: pu_line, col: pu_col, resolved: "" };
  let path: string = "";
  let bad: ast.Stmt[] = [];
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokString(s) => {
      path = s.value;
      p = p.advance();
    },
    _ => {
      bad = bad.append(decl_sentinel(p, "malformed re-export: its path could not be read"));
      return (none, bad, sync_to_top_level(p));
    }
  }
  for want in [".", "{"] {
    if (p.peek_punct() != want) {
      bad = bad.append(decl_sentinel(p, "expected \"" + want + "\", got " + tok_desc(p.peek())));
      return (none, bad, sync_to_top_level(p));
    }
    p = p.advance();
  }
  let names: string[] = [];
  while (p.peek_punct() != "}") {
    let nm: string = p.peek_ident();
    if (nm.len() == 0) {
      bad = bad.append(decl_sentinel(p, "expected a name, got " + tok_desc(p.peek())));
      return (none, bad, sync_to_top_level(p));
    }
    names = names.append(nm);
    p = p.advance();
    if (p.peek_punct() == ",") {
      p = p.advance();
    } else if (p.peek_punct() != "}") {
      bad = bad.append(decl_sentinel(p, "expected \"}\", got " + tok_desc(p.peek())));
      return (none, bad, sync_to_top_level(p));
    }
  }
  p = p.advance();
  if (p.peek_punct() != ";") {
    bad = bad.append(decl_sentinel(p, "expected \";\", got " + tok_desc(p.peek())));
    return (none, bad, sync_to_top_level(p));
  }
  p = p.advance();
  if (names.len() == 0) {
    bad = bad.append(s_unknown_at("decl:`pub use` must name at least one symbol, e.g. `pub use \"std/string\".{split};`", pu_line, pu_col));
    return (none, bad, p);
  }
  return (Import { ...none, path: path, reexport_names: names }, bad, p);
}

function parse_const_decl(p: Par): (FuncDecl, Par) {
  let cline: i32 = p.peek_line();
  let ccol: i32 = p.peek_col();
  p = p.advance();
  let name: string = p.peek_ident();
  if (name.len() > 0) {
    p = p.advance();
  }
  let ty: string = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    let (tr_name, tr_fn_ret, tr_p) = parse_type_name(p);
    p = tr_p;
    ty = tr_name;
  }
  p = p.expect("=");
  let (er_expr, er_p) = parse_expr(p);
  p = er_p;
  p = p.end_of(er_expr);
  let body: ast.Stmt[] = [];
  body = body.append(s_return(er_expr));
  let noparams: ast.ParamDecl[] = [];
  let notp: string[] = [];
  return (FuncDecl { stdlib: "", no_inline: false, name: name, receiver_name: "", receiver_type: "", receiver_own: false, type_params: notp, params: noparams, ret_type: ty, body: body, line: cline, col: ccol, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: true, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
}

function parse_assoc_const_decl(p: Par, require_value: boolean): (FuncDecl, Par) {
  let cline: i32 = p.peek_line();
  let ccol: i32 = p.peek_col();
  p = p.advance();
  let name: string = p.peek_ident();
  if (name.len() > 0) {
    p = p.advance();
  }
  p = p.expect(":");
  let (tr_name, tr_fn_ret, tr_p) = parse_type_name(p);
  p = tr_p;
  let body: ast.Stmt[] = [];
  if (require_value || p.peek_punct() == "=") {
    p = p.expect("=");
    let (er_expr, er_p) = parse_expr(p);
    p = er_p;
    p = p.end_of(er_expr);
    body = body.append(s_return(er_expr));
  }
  p = p.expect_semi();
  let noparams: ast.ParamDecl[] = [];
  let notp: string[] = [];
  return (FuncDecl { stdlib: "", no_inline: false, name: name, receiver_name: "", receiver_type: "", receiver_own: false, type_params: notp, params: noparams, ret_type: tr_name, body: body, line: cline, col: ccol, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: true, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
}

function struct_declared(structs: StructDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].name == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function name_declared(structs: StructDecl[], name: string): boolean {
  if (struct_declared(structs, name)) {
    return true;
  }
  for sd in structs {
    if (sd.enum_owner == name) {
      return true;
    }
  }
  return false;
}

function add_builtin_variant(acc: StructDecl[], name: string, payload_types: string[], enum_name: string): StructDecl[] {
  for sd in acc {
    if (sd.name == name && sd.enum_owner == enum_name) {
      return acc;
    }
  }
  let fields: StructFieldDecl[] = [];
  for t in payload_types {
    let field: string = "__ev";
    if (fields.len() > 0) {
      field = "__ev" + dl_itoa(fields.len());
    }
    fields = fields.append(StructFieldDecl { name: field, type_name: t, fn_ret: "", fn_param_types: "" });
  }
  return acc.append(StructDecl { name: name, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: enum_name, must_consume: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" });
}

