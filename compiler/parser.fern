    let hj: i32 = 0;
    while (hj < v.fields.len()) {
      let fs: ast.Stmt[] = dv_hash_stmts("__h", v.fields[hj].type_name, e_ident("__p" + dl_itoa(hj)), dl_itoa(i) + "_" + dl_itoa(hj));
      let k: i32 = 0;
      while (k < fs.len()) {
        stmts = stmts.append(fs[k]);
        k = k + 1;
      }
      hj = hj + 1;
    }
    stmts = stmts.append(s_return(e_ident("__h")));
    arms = arms.append(ast.MatchArm { pattern: p_variant_n(v.name, "__p", v.fields.len()), body: stmts, line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    i = i + 1;
  }
  let body: ast.Stmt[] = [s_match(e_ident("self"), arms), s_return(e_number("0", "", false))];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "hash", receiver_name: "self", receiver_type: ename, receiver_own: false, type_params: notp, params: noparams, ret_type: "i32", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Hash", dyn_traits: [], streams: [] };
}

function synth_enum_json(ename: string, variants: StructDecl[]): FuncDecl {
  let arms: ast.MatchArm[] = [];
  let i: i32 = 0;
  while (i < variants.len()) {
    let v: StructDecl = variants[i];
    if (v.fields.len() > 0) {
      let e: ast.Expr = e_binary("+", e_string("{\"" + v.name + "\":"), enum_json_payloads(v));
      e = e_binary("+", e, e_string("}"));
      arms = arms.append(ast.MatchArm { pattern: p_variant_n(v.name, "__p", v.fields.len()), body: [s_return(e)], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    } else {
      arms = arms.append(ast.MatchArm { pattern: p_variant(v.name, ""), body: [s_return(e_string("\"" + v.name + "\""))], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    }
    i = i + 1;
  }
  let body: ast.Stmt[] = [s_match(e_ident("self"), arms), s_return(e_string(""))];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "to_json", receiver_name: "self", receiver_type: ename, receiver_own: false, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Json", dyn_traits: [], streams: [] };
}

function enum_json_payloads(v: StructDecl): ast.Expr {
  let named: boolean = v.variant_field_names.len() == v.fields.len();
  let open: string = "[";
  let close: string = "]";
  if (named) {
    open = "{";
    close = "}";
  } else if (v.fields.len() == 1) {
    open = "";
    close = "";
  }
  let e: ast.Expr = e_string(open);
  let pj: i32 = 0;
  while (pj < v.fields.len()) {
    let sep: string = "";
    if (pj > 0) {
      sep = ",";
    }
    if (named) {
      sep = sep + "\"" + v.variant_field_names[pj] + "\":";
    }
    e = e_binary("+", e, e_string(sep));
    e = e_binary("+", e, dv_call0(e_ident("__p" + dl_itoa(pj)), "to_json"));
    pj = pj + 1;
  }
  return e_binary("+", e, e_string(close));
}

function enum_default_derivable(variants: StructDecl[]): boolean {
  if (variants.len() == 0) {
    return false;
  }
  let v0: StructDecl = variants[0];
  let i: i32 = 0;
  while (i < v0.fields.len()) {
    if (!dv_default_derivable(v0.fields[i].type_name)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function synth_enum_default(ename: string, variants: StructDecl[]): FuncDecl {
  let v0: StructDecl = variants[0];
  let value: ast.Expr = e_ident(v0.name);
  if (v0.fields.len() > 0) {
    let args: ast.Expr[] = [];
    let i: i32 = 0;
    while (i < v0.fields.len()) {
      args = args.append(dv_default_expr(v0.fields[i].type_name));
      i = i + 1;
    }
    value = e_call(e_ident(v0.name), args);
  }
  let body: ast.Stmt[] = [s_return(value)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "default", receiver_name: "", receiver_type: ename, receiver_own: false, type_params: notp, params: noparams, ret_type: ename, body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Default", dyn_traits: [], streams: [] };
}

function synth_enum_derives(ename: string, type_params: string[], declared: StructDecl[], derives: string[], funcs: FuncDecl[], has_json_import: boolean): FuncDecl[] {
  let variants: StructDecl[] = [];
  for vd in declared {
    variants = variants.append(erase_view_struct(vd));
  }
  let di: i32 = 0;
  while (di < derives.len()) {
    let kind: string = derive_simple_name(derives[di]);
    if (kind == "Display") {
      funcs = funcs.append(synth_enum_display(ename, variants));
    }
    if (kind == "Debug") {
      funcs = funcs.append(synth_enum_debug(ename, variants));
    }
    if (kind == "Eq") {
      funcs = funcs.append(synth_enum_eq(ename, variants));
    }
    if (kind == "Ord") {
      funcs = funcs.append(synth_enum_ord(ename, variants));
    }
    if (kind == "Hash") {
      funcs = funcs.append(synth_enum_hash(ename, variants));
    }
    funcs = synth_enum_json_derive(kind, ename, type_params, variants, funcs, has_json_import);
    if (kind == "Default") {
      if (enum_default_derivable(declared)) {
        funcs = funcs.append(synth_enum_default(ename, variants));
      }
    }
    di = di + 1;
  }
  return funcs;
}

function synth_enum_json_derive(kind: string, ename: string, type_params: string[], variants: StructDecl[], funcs: FuncDecl[], has_json_import: boolean): FuncDecl[] {
  if (kind == "Json") {
    return funcs.append(synth_enum_json(ename, variants));
  }
  if (kind == "FromJson" && has_json_import) {
    let self_ty: string = applied_type(ename, type_params);
    return funcs.append(synth_enum_from_json_value(ename, self_ty, variants)).append(synth_from_json_text(ename, self_ty));
  }
  return funcs;
}

function dv_is_scalar(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u8" || t == "u32" || t == "u64"
    || t == "f32" || t == "f64" || t == "boolean" || t == "string";
}

function dv_default_derivable(t: string): boolean {
  if (dv_is_scalar(t)) {
    return true;
  }
  if (t.len() == 0 || t == "str") {
    return false;
  }
  let i: i32 = 0;
  while (i < t.len()) {
    let c: i32 = t[i] as i32;
    if (c == 91 || c == 93 || c == 40 || c == 41 || c == 44 || c == 32) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function dv_default_expr(t: string): ast.Expr {
  if (t == "string") {
    return e_string("");
  }
  if (t == "boolean") {
    return e_bool(false);
  }
  if (t == "f32" || t == "f64") {
    return e_number("0.0", t, true);
  }
  if (dv_is_scalar(t)) {
    return e_number("0", t, false);
  }
  let noargs: ast.Expr[] = [];
  return e_call(e_field_access(e_ident(t), "default"), noargs);
}

function dv_eq_expr(ty: string, lhs: ast.Expr, rhs: ast.Expr): ast.Expr {
  if (dv_is_scalar(ty)) {
    return e_binary("==", lhs, rhs);
  }
  return dv_call1(lhs, "eq", rhs);
}

function dv_cmp_stmts(vn: string, ty: string, lhs: ast.Expr, rhs: ast.Expr): ast.Stmt[] {
  if (dv_is_num_scalar(ty) || ty == "string") {
    let neg1: ast.Expr = e_binary("-", e_number("0", "", false), e_number("1", "", false));
    let out: ast.Stmt[] = [s_var(vn, "i32", e_number("0", "", false))];
    out = out.append(s_if(e_binary("<", lhs, rhs), [s_assign(vn, neg1)], []));
    out = out.append(s_if(e_binary(">", lhs, rhs), [s_assign(vn, e_number("1", "", false))], []));
    return out;
  }
  return [s_var(vn, "i32", dv_call1(lhs, "cmp", rhs))];
}

function dv_hash_stmts(hv: string, ty: string, recv: ast.Expr, sfx: string): ast.Stmt[] {
  let mul: ast.Expr = e_binary("*", e_ident(hv), e_number("31", "", false));
  if (ty == "string") {
    let iv: string = "__hsi" + sfx;
    let body: ast.Stmt[] = [s_assign(hv, e_binary(
      "+",
      e_binary("*", e_ident(hv), e_number("31", "", false)),
      e_unary("as_i32", e_index(recv, e_ident(iv), 0, 0)),
    ))];
    body = body.append(s_assign(iv, e_binary("+", e_ident(iv), e_number("1", "", false))));
    let out: ast.Stmt[] = [s_assign(hv, mul)];
    out = out.append(s_var(iv, "i32", e_number("0", "", false)));
    out = out.append(s_while(e_binary("<", e_ident(iv), dv_call0(recv, "len")), body));
    return out;
  }
  if (ty == "boolean") {
    let t: ast.Stmt[] = [s_assign(hv, e_binary("+", e_ident(hv), e_number("1", "", false)))];
    return [s_assign(hv, mul), s_if(recv, t, [])];
  }
  if (dv_is_num_scalar(ty)) {
    let v: ast.Expr = recv;
    if (ty != "i32") {
      v = e_unary("as_i32", recv);
    }
    return [s_assign(hv, e_binary("+", mul, v))];
  }
  return [s_assign(hv, e_binary("+", mul, dv_call0(recv, "hash")))];
}

function dv_is_num_scalar(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u32" || t == "u64"
    || t == "f32" || t == "f64";
}

function dv_num_identity_expr(t: string, one: boolean): ast.Expr {
  if (t == "f32" || t == "f64") {
    if (one) {
      return e_number("1.0", t, true);
    }
    return e_number("0.0", t, true);
  }
  if (one) {
    return e_number("1", t, false);
  }
  return e_number("0", t, false);
}

function struct_default_derivable(sd: StructDecl): boolean {
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    if (!dv_default_derivable(sd.fields[i].type_name)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function synth_struct_default(sd: StructDecl): FuncDecl {
  let fnames: string[] = [];
  let fvals: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    fnames = fnames.append(sd.fields[i].name);
    fvals = fvals.append(dv_default_expr(sd.fields[i].type_name));
    i = i + 1;
  }
  let lit: ast.Expr = e_struct_lit(sd.name, fnames, [], [], fvals, 0, 0);
  let body: ast.Stmt[] = [s_return(lit)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "default", receiver_name: "", receiver_type: sd.name, receiver_own: false, type_params: notp, params: noparams, ret_type: sd.name, body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Default", dyn_traits: [], streams: [] };
}

function synth_derives(declared: StructDecl, derives: string[], funcs: FuncDecl[], has_json_import: boolean): FuncDecl[] {
  let sd: StructDecl = erase_view_struct(declared);
  let di: i32 = 0;
  while (di < derives.len()) {
    let kind: string = derive_simple_name(derives[di]);
    if (kind == "Display") {
      funcs = funcs.append(synth_struct_display(sd));
    }
    if (kind == "Debug") {
      funcs = funcs.append(synth_struct_debug(sd));
    }
    if (kind == "Eq") {
      funcs = funcs.append(synth_struct_eq(sd));
    }
    if (kind == "Ord") {
      funcs = funcs.append(synth_struct_ord(sd));
    }
    if (kind == "Hash") {
      funcs = funcs.append(synth_struct_hash(sd));
    }
    if (kind == "Json") {
      funcs = funcs.append(synth_struct_json(sd));
    }
    if (kind == "FromJson" && has_json_import) {
      funcs = funcs.append(synth_from_json_value(sd));
      funcs = funcs.append(synth_from_json_text(sd.name, derived_self_type(sd)));
    }
    if (kind == "Default") {
      if (struct_default_derivable(declared)) {
        funcs = funcs.append(synth_struct_default(sd));
      }
    }
    di = di + 1;
  }
  return funcs;
}

function imports_have_std_json(imports: Import[]): boolean {
  let i: i32 = 0;
  while (i < imports.len()) {
    if (imports[i].path == "std/json") {
      return true;
    }
    i = i + 1;
  }
  return false;
}

struct DeclAttr { name: string, derives: string[], iface: string, wit: string }

function no_decl_attr(): DeclAttr {
  return DeclAttr { name: "", derives: [], iface: "", wit: "" };
}

pub function inherent_impl_message(typ: string): string {
  return "`impl " + typ + "` needs a trait, as in `impl cmp.Eq for " + typ + "`; declare a method as `function (self: " + typ + ") name(…)` and a constructor as a plain function";
}

function expected_here(p: Par, what: string): ast.Stmt[] {
  return [decl_sentinel(p, "expected " + what + ", got " + tok_desc(p.peek()))];
}

function parse_decl_attr(p: Par): (DeclAttr, ast.Stmt[], Par) {
  let at: Par = p;
  p = p.advance();
  let name: string = p.peek_ident();
  if (p.peek_keyword() == "import") {
    name = "import";
  }
  if (name.len() == 0) {
    return (no_decl_attr(), expected_here(p, "a name"), p);
  }
  p = p.advance();
  if (name == "derive") {
    return parse_derive_args(p);
  }
  if (name == "import" || name == "export") {
    return parse_wit_pair(name, p);
  }
  if (name == "must_consume" || name == "try" || name == "inline" || name == "noinline") {
    return (DeclAttr { ...no_decl_attr(), name: name }, [], p);
  }
  return (no_decl_attr(), [decl_sentinel(at, "unknown attribute @" + name + " (only @derive, @import, @export, @must_consume, @try, @inline, and @noinline are supported)")], p);
}

function parse_derive_args(p: Par): (DeclAttr, ast.Stmt[], Par) {
  if (p.peek_punct() != "(") {
    return (no_decl_attr(), expected_here(p, "\"(\""), p);
  }
  p = p.advance();
  let derives: string[] = [];
  while (true) {
    let tn: string = p.peek_ident();
    if (tn.len() == 0) {
      return (no_decl_attr(), expected_here(p, "a name"), p);
    }
    p = p.advance();
    if (p.peek_punct() == ".") {
      p = p.advance();
      let seg: string = p.peek_ident();
      if (seg.len() > 0) {
        tn = tn + "." + seg;
        p = p.advance();
      }
    }
    derives = derives.append(tn);
    if (p.peek_punct() != ",") {
      break;
    }
    p = p.advance();
  }
  if (p.peek_punct() != ")") {
    return (no_decl_attr(), expected_here(p, "\")\""), p);
  }
  return (DeclAttr { ...no_decl_attr(), name: "derive", derives: derives }, [], p.advance());
}

function parse_wit_pair(name: string, p: Par): (DeclAttr, ast.Stmt[], Par) {
  if (p.peek_punct() != "(") {
    return (no_decl_attr(), expected_here(p, "\"(\""), p);
  }
  p = p.advance();
  let parts: string[] = [];
  while (parts.len() < 2) {
    match (p.peek()) {
      lexer.TokString(s) => {
        parts = parts.append(s.value);
        p = p.advance();
      },
      _ => {
        return (no_decl_attr(), expected_here(p, "a string literal"), p);
      }
    }
    let close: string = ",";
    if (parts.len() == 2) {
      close = ")";
    }
    if (p.peek_punct() != close) {
      return (no_decl_attr(), expected_here(p, "\"" + close + "\""), p);
    }
    p = p.advance();
  }
  return (DeclAttr { ...no_decl_attr(), name: name, iface: parts[0], wit: parts[1] }, [], p);
}

function attr_fits(name: string, kind: string): boolean {
  if (name.len() == 0) {
    return true;
  }
  if (name == "derive" || name == "must_consume") {
    return kind == "struct" || kind == "enum";
  }
  if (name == "try") {
    return kind == "enum";
  }
  if (name == "import") {
    return kind == "function" || kind == "resource";
  }
  return kind == "function";
}

function attr_misplaced(name: string): string {
  if (name == "derive" || name == "must_consume") {
    return "@" + name + " only applies to a `struct` or `enum` declaration";
  }
  if (name == "try") {
    return "@try only applies to an `enum` declaration";
  }
  if (name == "import") {
    return "@import only applies to a function or resource declaration";
  }
  if (name == "export") {
    return "@export only applies to a function declaration";
  }
  return "@inline / @noinline only applies to a function declaration";
}

function pub_errors(pub_at: Par, p: Par): ast.Stmt[] {
  if (p.peek_punct() == "(") {
    let q: Par = p.advance();
    if (q.peek_ident() == "package") {
      return expected_here(q.advance(), "\")\"");
    }
    return [decl_sentinel(pub_at, "`pub(...)` only supports `pub(package)`")];
  }
  if (str_list_contains(["function", "struct", "enum", "type", "trait", "const", "use"], p.peek_keyword()) || str_list_contains(["opaque", "fip", "fbip", "async"], p.peek_ident())) {
    return [];
  }
  return [decl_sentinel(pub_at, "`pub` must be followed by `function`, `struct`, `enum`, `type`, `trait`, `const`, `opaque`, `fip`, `fbip`, or `async`")];
}

function skip_failed_decl(p: Par, start: i32): Par {
  let q: Par = sync_to_top_level(p);
  if (q.pos == start) {
    return q.advance();
  }
  return q;
}

function parse_resource_decl_name(p: Par): (string, Par) {
  p = p.advance();
  let name: string = p.peek_ident();
  if (name.len() > 0) {
    p = p.advance();
  }
  if (p.peek_punct() == ";") {
    p = p.advance();
  }
  return (name, p);
}

function parse_impl_decl(p: Par): (FuncDecl[], string, string, string[], string[], string[], string, ImplDecl, ast.Stmt[], Par) {
  let out: FuncDecl[] = [];
  let impl_bad: ast.Stmt[] = [];
  let method_names: string[] = [];
  let iline: i32 = p.peek_line();
  let icol: i32 = p.peek_col();
  p = p.advance();
  let (impl_tpl, impl_tp_p) = parse_type_param_list(p);
  p = refuse_const_tparams(impl_tp_p, p, impl_tpl);
  let impl_tps: string[] = [];
  let impl_tbs: string[] = [];
  let itpi: i32 = 0;
  while (itpi < impl_tpl.tnames.len()) {
    if (impl_tpl.tbounds[itpi].len() > 0) {
      impl_tps = impl_tps.append(impl_tpl.tnames[itpi]);
      impl_tbs = impl_tbs.append(impl_tpl.tbounds[itpi]);
    }
    itpi = itpi + 1;
  }
  let first_spelling: string = "";
  if (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "." && p.peek_ident_at(2).len() > 0) {
    first_spelling = p.peek_ident() + p.peek_punct_at(1) + p.peek_ident_at(2);
  }
  let first_is_kw: boolean = p.peek_ident().len() == 0 && p.peek_keyword().len() > 0;
  let first_at: Par = p;
  let (tnr_name, tnr_fn_ret, tnr_p) = parse_type_name(p);
  p = tnr_p;
  let first_name: string = tnr_name;
  let trait_spelling: string = "";
  let trait_name: string = "";
  let impl_type: string = "";
  if (p.peek_keyword() == "for") {
    if (first_is_kw) {
      impl_bad = impl_bad.append(decl_sentinel(first_at, "malformed impl: its trait name could not be read (a keyword such as `use`, `type` or `match` cannot be a name)"));
    }
    p = p.advance();
    trait_name = first_name;
    trait_spelling = first_spelling;
    let (ity_name, ity_fn_ret, ity_p) = parse_type_name(p);
    p = ity_p;
    impl_type = ity_name;
  } else {
    impl_bad = impl_bad.append(decl_sentinel(first_at, inherent_impl_message(first_name)));
    impl_type = first_name;
  }
  if (p.peek_punct() == "{") {
    p = p.advance();
  }
  let assoc_names: string[] = [];
  let assoc_values: string[] = [];
  while (!p.at_end()) {
    if (p.peek_punct() == "}") {
      break;
    }
    let kw: string = p.peek_keyword();
    if (kw == "pub") {
      p = p.advance();
      kw = p.peek_keyword();
    }
    if (kw == "type") {
      p = p.advance();
      let ab_name: string = p.peek_ident();
      if (ab_name.len() > 0) {
        p = p.advance();
      } else {
        impl_bad = impl_bad.append(decl_sentinel(p, "malformed associated type binding: its name could not be read (a keyword such as `type` or `match` cannot be a name)"));
      }
      p = p.expect("=");
      let (ab_ty, ab_fnret, ab_p) = parse_type_name(p);
      p = ab_p;
      p = p.expect_semi();
      if (ab_name.len() > 0) {
        assoc_names = assoc_names.append(ab_name);
        assoc_values = assoc_values.append(subst_self(ab_ty, impl_type));
      }
      continue;
    }
    if (kw == "const") {
      let (ic_func, ic_p) = parse_assoc_const_decl(p, true);
      p = ic_p;
      if (p.verbatim) {
        out = out.append(ic_func);
      } else {
        out = out.append(finalize_impl_method(ic_func, impl_type, impl_tps, impl_tbs));
      }
      method_names = method_names.append(ic_func.name);
      continue;
    }
    if (kw != "function") {
      impl_bad = impl_bad.append(decl_sentinel(p, "unexpected token in an impl body: expected `function`, `type` or `const`"));
      p = skip_body_item(p.advance());
      continue;
    }
    let name_at: Par = p.advance();
    let (fr_func, fr_p) = parse_func_decl(p);
    p = fr_p;
    if (fr_func.receiver_name.len() == 0) {
      p = refuse_const_tparams(p, name_at, TpList { tnames: fr_func.type_params, tbounds: fr_func.bound_traits });
    }
    if (fr_func.name.len() == 0) {
      p = skip_body_item(p);
    }
    let m: FuncDecl = fr_func;
    if (p.verbatim) {
      out = out.append(m);
    } else {
      out = out.append(finalize_impl_method(m, impl_type, impl_tps, impl_tbs));
    }
    method_names = method_names.append(m.name);
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (out, derive_simple_name(strip_struct_base(trait_name)), impl_type, impl_tps, impl_tbs, method_names, trait_spelling, ImplDecl { trait_ref: trait_name, type_ref: impl_type, type_params: impl_tpl.tnames, bounds: impl_tpl.tbounds, methods: out, line: iline, col: icol, assoc_names: assoc_names, assoc_values: assoc_values }, impl_bad, p);
}

pub function ident_byte(b: i32): boolean {
  return b >= 97 && b <= 122 || b >= 65 && b <= 90 || b >= 48 && b <= 57 || b == 95;
}

function is_builtin_generic_base(b: string): boolean {
  return b == "Option" || b == "Result" || b == "Map";
}

function enclosing_bracket_base(ty: string, pos: i32): string {
  let bal: i32 = 0;
  let i: i32 = pos - 1;
  while (i >= 0) {
    let c: u8 = ty[i];
    if (c == b']') {
      bal = bal + 1;
    } else if (c == b'[') {
      if (bal == 0) {
        let st: i32 = i;
        while (st > 0 && ident_byte(ty[st - 1] as i32)) {
          st = st - 1;
        }
        return slice_unchecked(ty, st, i) + "";
      }
      bal = bal - 1;
    }
    i = i - 1;
  }
  return "";
}

function feeds_user_parametric(ty: string, name: string): boolean {
  let i: i32 = 0;
  let nl: i32 = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && slice_unchecked(ty, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + nl < ty.len() && ident_byte(ty[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        let b: string = enclosing_bracket_base(ty, i);
        if (b.len() > 0 && !is_builtin_generic_base(b)) {
          return true;
        }
      }
    }
    i = i + 1;
  }
  return false;
}

function feeds_map_typearg(ty: string, name: string): boolean {
  let i: i32 = 0;
  let nl: i32 = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && slice_unchecked(ty, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + nl < ty.len() && ident_byte(ty[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        if (enclosing_bracket_base(ty, i) == "Map") {
          return true;
        }
      }
    }
    i = i + 1;
  }
  return false;
}

function feeds_wide_container(ty: string, name: string): boolean {
  let i: i32 = 0;
  let nl: i32 = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && slice_unchecked(ty, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let nxt: i32 = i + nl;
      let next_ok: boolean = true;
      if (nxt < ty.len() && ident_byte(ty[nxt] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        if (nxt + 1 < ty.len() && ty[nxt] == b'[' && ty[nxt + 1] == b']') {
          return true;
        }
        let b: string = enclosing_bracket_base(ty, i);
        if (b == "Option" || b == "Result") {
          return true;
        }
      }
    }
    i = i + 1;
  }
  return false;
}

function all_bare_scalar_bound(params: ast.ParamDecl[], tps: string[]): boolean {
  let i: i32 = 0;
  while (i < tps.len()) {
    if (!has_bare_scalar_param(params, tps[i])) {
      return false;
    }
    i = i + 1;
  }
  return tps.len() > 0;
}

function ret_mentions_any(ret_type: string, tps: string[]): boolean {
  let i: i32 = 0;
  while (i < tps.len()) {
    if (type_mentions_var(ret_type, tps[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function type_mentions_var(ty: string, name: string): boolean {
  let i: i32 = 0;
  let nl: i32 = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && slice_unchecked(ty, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let nxt: i32 = i + nl;
      let next_ok: boolean = true;
      if (nxt < ty.len() && ident_byte(ty[nxt] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

function has_bare_array_param(params: ast.ParamDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < params.len()) {
    if (params[i].type_name == name + "[]" || params[i].type_name == "[" + name + "]") {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function body_binds_bare_var(stmts: ast.Stmt[], params: ast.ParamDecl[], tps: string[], bounded: string[]): boolean {
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (util.index_of_str(tps, v.type_name) >= 0 && util.index_of_str(bounded, v.type_name) < 0) {
          return true;
        }
      },
      ast.StmtAssign(a) => {
        let pi: i32 = 0;
        while (pi < params.len()) {
          if (params[pi].name == a.target && util.index_of_str(tps, params[pi].type_name) >= 0
            && util.index_of_str(bounded, params[pi].type_name) < 0) {
            return true;
          }
          pi = pi + 1;
        }
      },
      ast.StmtIf(f) => {
        if (body_binds_bare_var(f.then_body, params, tps, bounded)) {
          return true;
        }
        if (body_binds_bare_var(f.else_body, params, tps, bounded)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_binds_bare_var(w.body, params, tps, bounded)) {
          return true;
        }
      },
      ast.StmtFor(fr) => {
        if (body_binds_bare_var(fr.body, params, tps, bounded)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (body_binds_bare_var(arm.body, params, tps, bounded)) {
            return true;
          }
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        if (body_binds_bare_var(one, params, tps, bounded)) {
          return true;
        }
      },
      _ => {}
    }
  }
  return false;
}

function erased_only(tps: string[], bounded: string[]): string[] {
  let out: string[] = [];
  for t in tps {
    if (util.index_of_str(bounded, t) < 0) {
      out = out.append(t);
    }
  }
  return out;
}

struct ParScan { vars: string[], hit: boolean }

function body_feeds_user_parametric(stmts: ast.Stmt[], vars: string[]): boolean {
  if (vars.len() == 0) {
    return false;
  }
  let scan: ParScan = ParScan { vars: vars, hit: false };
  for st in stmts {
    scan = astwalk.fold_stmt_nodes(st, scan, par_scan_stmt, par_scan_expr, astwalk.descend_all);
  }
  return scan.hit;
}

function spelled_feeds(t: string, vars: string[]): boolean {
  for v in vars {
    if (feeds_user_parametric(t, v)) {
      return true;
    }
  }
  return false;
}

function par_scan_stmt(st: ast.Stmt, own acc: ParScan): ParScan {
  if (acc.hit) {
    return acc;
  }
  if let ast.StmtVar(v) = st {
    if (spelled_feeds(v.type_name, acc.vars) || spelled_feeds(v.fn_ret, acc.vars) || spelled_feeds(v.fn_param_types, acc.vars)) {
      return ParScan { ...acc, hit: true };
    }
  }
  return acc;
}

function par_scan_expr(e: ast.Expr, own acc: ParScan): ParScan {
  if (acc.hit) {
    return acc;
  }
  let hit: boolean = false;
  match (e) {
    ast.ExprStructLit(sl) => {
      hit = spelled_feeds(sl.type_name, acc.vars) || spelled_feeds(sl.written, acc.vars);
    },
    ast.ExprZero(z) => {
      hit = spelled_feeds(z.type_name, acc.vars);
    },
    ast.ExprCall(c) => {
      for t in c.type_args {
        if (spelled_feeds(t, acc.vars)) {
          hit = true;
        }
      }
    },
    ast.ExprLambda(lm) => {
      hit = spelled_feeds(lm.ret_type, acc.vars) || spelled_feeds(lm.ret_fn_ret, acc.vars) || spelled_feeds(lm.ret_fn_param_types, acc.vars);
      for lp in lm.params {
        if (spelled_feeds(lp.type_name, acc.vars) || spelled_feeds(lp.fn_ret, acc.vars) || spelled_feeds(lp.fn_param_types, acc.vars)) {
          hit = true;
        }
      }
    },
    _ => {}
  }
  if (hit) {
    return ParScan { ...acc, hit: true };
  }
  return acc;
}

function all_fn_param_bound(params: ast.ParamDecl[], tps: string[]): boolean {
  let i: i32 = 0;
  while (i < tps.len()) {
    if (!has_fn_param_arg_var(params, tps[i]) && !has_fn_param_ret_var(params, tps[i])) {
      return false;
    }
    i = i + 1;
  }
  return tps.len() > 0;
}

function has_fn_param_ret_var(params: ast.ParamDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < params.len()) {
    if (is_fn_contract_tag(params[i].type_name) && type_mentions_var(params[i].fn_ret, name)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function has_fn_param_arg_var(params: ast.ParamDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < params.len()) {
    if (is_fn_contract_tag(params[i].type_name) && params[i].fn_param_types.len() > 0) {
      for seg in split_top_commas(params[i].fn_param_types) {
        if (token_at_paren_depth0(strip_ws(seg), name)) {
          return true;
        }
      }
    }
    i = i + 1;
  }
  return false;
}

function has_bare_scalar_param(params: ast.ParamDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < params.len()) {
    if (params[i].type_name == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function has_any_bare_scalar_param(params: ast.ParamDecl[], tps: string[]): boolean {
  let i: i32 = 0;
  while (i < tps.len()) {
    if (has_bare_scalar_param(params, tps[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function strip_ws(s: string): string {
  let a: i32 = 0;
  let b: i32 = s.len();
  while (a < b && (s[a] == b' ' || s[a] == b'\t')) {
    a = a + 1;
  }
  while (b > a && (s[b - 1] == b' ' || s[b - 1] == b'\t')) {
    b = b - 1;
  }
  return slice_unchecked(s, a, b) + "";
}

function result_two_bare_vars(ret_type: string, unbounded_tps: string[]): boolean {
  if (unbounded_tps.len() != 2) {
    return false;
  }
  let n: i32 = ret_type.len();
  if (n < 9 || slice_unchecked(ret_type, 0, 7) != "Result[" || ret_type[n - 1] != b']') {
    return false;
  }
  let inner: string = slice_unchecked(ret_type, 7, n - 1) + "";
  let depth: i32 = 0;
  let ci: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < inner.len() && ci < 0) {
    let c: u8 = inner[i];
    if (c == b'[') {
      depth = depth + 1;
    } else if (c == b']') {
      depth = depth - 1;
    } else if (c == b',' && depth == 0) {
      ci = i;
    }
    i = i + 1;
  }
  if (ci < 0) {
    return false;
  }
  let a: string = strip_ws(slice_unchecked(inner, 0, ci) + "");
  let b: string = strip_ws(slice_unchecked(inner, ci + 1, inner.len()) + "");
  let t0: string = unbounded_tps[0];
  let t1: string = unbounded_tps[1];
  return a == t0 && b == t1 || a == t1 && b == t0;
}

function token_at_paren_depth0(ty: string, name: string): boolean {
  let pdepth: i32 = 0;
  let i: i32 = 0;
  let nl: i32 = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    let c: i32 = ty[i] as i32;
    if (c == 40) {
      pdepth = pdepth + 1;
      i = i + 1;
      continue;
    }
    if (c == 41) {
      pdepth = pdepth - 1;
      i = i + 1;
      continue;
    }
    if (pdepth == 0 && i + nl <= ty.len() && slice_unchecked(ty, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + nl < ty.len() && ident_byte(ty[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

function token_in_tuple_param(ty: string, name: string): boolean {
  if (name.len() == 0) {
    return false;
  }
  let t: string = ty;
  while (type_ends_arr(t)) {
    t = slice_unchecked(t, 0, t.len() - 2) + "";
  }
  if (t.len() < 2 || slice_unchecked(t, 0, 1) != "(" || slice_unchecked(t, t.len() - 1, t.len()) != ")") {
    return false;
  }
  let inner: str = slice_unchecked(t, 1, t.len() - 1);
  let i: i32 = 0;
  let nl: i32 = name.len();
  while (i < inner.len()) {
    if (i + nl <= inner.len() && slice_unchecked(inner, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(inner[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + nl < inner.len() && ident_byte(inner[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

function replace_struct_ident(ty: string, from: string, to: string): string {
  return replace_ident(ty, from, to, false);
}

function replace_ident(ty: string, from: string, to: string, bare_only: boolean): string {
  if (ty.len() == 0 || from.len() == 0 || from == to) {
    return ty;
  }
  let out: string = "";
  let i: i32 = 0;
  let fl: i32 = from.len();
  while (i < ty.len()) {
    if (i + fl <= ty.len() && slice_unchecked(ty, i, i + fl) == from) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + fl < ty.len() && (ident_byte(ty[i + fl] as i32) || bare_only && ty[i + fl] == b'[')) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        out = out + to;
        i = i + fl;
        continue;
      }
    }
    out = out + slice_unchecked(ty, i, i + 1);
    i = i + 1;
  }
  return out;
}

pub function subst_self(ty: string, impl_type: string): string {
  if (ty.len() == 0) {
    return ty;
  }
  let out: string = "";
  let i: i32 = 0;
  while (i < ty.len()) {
    if (i + 4 <= ty.len() && slice_unchecked(ty, i, i + 4) == "Self") {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + 4 < ty.len() && ident_byte(ty[i + 4] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        out = out + impl_type;
        i = i + 4;
        continue;
      }
    }
    out = out + slice_unchecked(ty, i, i + 1);
    i = i + 1;
  }
  return out;
}

function renamed_list(xs: string[], from: string[], to: string[]): string[] {
  let out: string[] = [];
  for x in xs {
    let at: i32 = util.index_of_str(from, x);
    if (at >= 0) {
      out = out.append(to[at]);
    } else {
      out = out.append(x);
    }
  }
  return out;
}

pub function inherit_default(m: FuncDecl, trait_params: string[], im: ImplInfo): FuncDecl {
  let args: string[] = type_args_of(im.trait_ref);
  let from: string[] = [];
  let to: string[] = [];
  for v in m.all_type_params {
    let fresh: string = v;
    let n: i32 = 1;
    while (str_in(im.all_type_params, fresh) || str_in(args, fresh) || fresh != v && str_in(m.all_type_params, fresh)) {
      fresh = v + util.i32_to_string(n);
      n = n + 1;
    }
    if (fresh != v) {
      from = from.append(v);
      to = to.append(fresh);
    }
  }
  if (args.len() == trait_params.len()) {
    from = util.append_all(from, trait_params);
    to = util.append_all(to, args);
  }
  from = from.append("Self");
  to = to.append(im.impl_type);
  let params: ast.ParamDecl[] = [];
  for pd in m.params {
    params = params.append(ast.ParamDecl { ...pd, type_name: subst_ty(pd.type_name, from, to), fn_ret: subst_ty(pd.fn_ret, from, to), fn_param_types: subst_ty_list(pd.fn_param_types, from, to) });
  }
  let sub: FuncDecl = FuncDecl { ...m, type_params: renamed_list(m.type_params, from, to), all_type_params: renamed_list(m.all_type_params, from, to), params: params, ret_type: subst_ty(m.ret_type, from, to), ret_fn_ret: subst_ty(m.ret_fn_ret, from, to), ret_fn_param_types: subst_ty_list(m.ret_fn_param_types, from, to), body: subst_stmts(m.body, from, to) };
  return finalize_impl_method(sub, im.impl_type, im.type_params, im.bounds);
}

function finalize_impl_method(m0: FuncDecl, impl_type: string, impl_tps: string[], impl_tbs: string[]): FuncDecl {
  let m: FuncDecl = FuncDecl { ...m0, body: subst_stmts(m0.body, ["Self"], [impl_type]) };
  let rt: string = subst_self(m.ret_type, impl_type);
  let mtps: string[] = m.type_params;
  let mtbs: string[] = m.bound_traits;
  while (mtbs.len() < m.type_params.len()) {
    mtbs = mtbs.append("");
  }
  let ti: i32 = 0;
  while (ti < impl_tps.len()) {
    mtps = mtps.append(impl_tps[ti]);
    mtbs = mtbs.append(impl_tbs[ti]);
    ti = ti + 1;
  }
  let has_self: boolean = false;
  if (m.params.len() > 0) {
    if (m.params[0].name == "self" && m.params[0].type_name.len() > 0) {
      has_self = true;
    }
  }
  if (!has_self) {
    let aparams: ast.ParamDecl[] = [];
    let ai: i32 = 0;
    while (ai < m.params.len()) {
      let apt: string = m.params[ai].type_name;
      apt = subst_self(apt, impl_type);
      aparams = aparams.append(ast.ParamDecl { name: m.params[ai].name, type_name: apt, own: m.params[ai].own, has_default: m.params[ai].has_default, default_value: m.params[ai].default_value, fn_ret: m.params[ai].fn_ret, fn_param_types: m.params[ai].fn_param_types });
      ai = ai + 1;
    }
    return FuncDecl { ...m, receiver_name: "", receiver_type: impl_type, type_params: mtps, bound_traits: mtbs, params: aparams, ret_type: rt };
  }
  let rname: string = "self";
  let newparams: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < m.params.len()) {
    if (i == 0) {
      rname = m.params[i].name;
    } else {
      let pt: string = m.params[i].type_name;
      pt = subst_self(pt, impl_type);
      newparams = newparams.append(ast.ParamDecl { name: m.params[i].name, type_name: pt, own: m.params[i].own, has_default: m.params[i].has_default, default_value: m.params[i].default_value, fn_ret: m.params[i].fn_ret, fn_param_types: m.params[i].fn_param_types });
    }
    i = i + 1;
  }
  return FuncDecl { ...m, receiver_name: rname, receiver_type: impl_type, receiver_own: m.params[0].own, type_params: mtps, bound_traits: mtbs, params: newparams, ret_type: rt };
}

function required_own_tps(bad: ast.Stmt[], at: Par, fd: FuncDecl): ast.Stmt[] {
  if (fd.body.len() == 0 && fd.all_type_params.len() > 0) {
    return bad.append(decl_sentinel(at, "trait method \"" + fd.name + "\" declares its own type parameters, so it must have a default body"));
  }
  return bad;
}

function parse_trait_decl(p: Par): (TraitDefault[], TraitReq, TraitDecl, ast.Stmt[], Par) {
  let defaults: TraitDefault[] = [];
  let trait_bad: ast.Stmt[] = [];
  let required: string[] = [];
  let required_sigs: FuncDecl[] = [];
  let assoc_sigs: FuncDecl[] = [];
  let provided: string[] = [];
  let default_sigs: FuncDecl[] = [];
  let supertraits: string[] = [];
  let decl_methods: FuncDecl[] = [];
  let decl_supers: string[] = [];
  let assoc_types: string[] = [];
  let tline: i32 = p.peek_line();
  let tcol: i32 = p.peek_col();
  p = p.advance();
  let tname: string = p.peek_ident();
  if (tname.len() > 0) {
    p = p.advance();
  }
  let simple: string = derive_simple_name(tname);
  let (trait_tps, trait_tp_p) = parse_type_param_list(p);
  p = refuse_const_tparams(trait_tp_p, p, trait_tps);
  if (p.peek_punct() == ":") {
    p = p.advance();
    let go_sup: boolean = true;
    while (go_sup && !p.at_end()) {
      let sup_name: string = "";
      let sup_written: string = "";
      if (p.peek_ident().len() > 0) {
        sup_name = p.peek_ident();
        sup_written = sup_name;
        p = p.advance();
      }
      if (p.peek_punct() == ".") {
        p = p.advance();
        if (p.peek_ident().len() > 0) {
          sup_name = p.peek_ident();
          sup_written = sup_written + "." + sup_name;
          p = p.advance();
        }
      }
      if (sup_name.len() > 0) {
        supertraits = supertraits.append(derive_simple_name(sup_name));
        decl_supers = decl_supers.append(sup_written);
      }
      if (p.peek_punct() == "+") {
        p = p.advance();
      } else {
        go_sup = false;
      }
    }
  }
  if (p.peek_punct() != "{") {
    trait_bad = trait_bad.append(decl_sentinel(p, "expected \"{\", got " + tok_desc(p.peek())));
    while (!p.at_end() && p.peek_punct() != "{" && !at_top_level_decl(p)) {
      p = p.advance();
    }
  }
  if (p.peek_punct() == "{") {
    p = p.advance();
    while (!p.at_end()) {
      if (p.peek_punct() == "}") {
        break;
      }
      if (p.peek_keyword() == "type") {
        p = p.advance();
        let at_name: string = p.peek_ident();
        if (at_name.len() > 0) {
          p = p.advance();
          assoc_types = assoc_types.append(at_name);
        } else {
          trait_bad = trait_bad.append(decl_sentinel(p, "malformed associated type declaration: its name could not be read (a keyword such as `type` or `match` cannot be a name)"));
        }
        p = p.expect_semi();
        continue;
      }
      if (p.peek_keyword() == "const") {
        let (ac_func, ac_p) = parse_assoc_const_decl(p, false);
        p = ac_p;
        decl_methods = decl_methods.append(ac_func);
        provided = provided.append(ac_func.name);
        assoc_sigs = assoc_sigs.append(ac_func);
        if (ac_func.body.len() > 0) {
          defaults = defaults.append(TraitDefault { trait_name: simple, trait_params: trait_tps.tnames, method: ac_func });
          default_sigs = default_sigs.append(FuncDecl { ...ac_func, body: [] });
        } else {
          required = required.append(ac_func.name);
          required_sigs = required_sigs.append(ac_func);
        }
        continue;
      }
      if (p.peek_keyword() == "function") {
        let fn_at: Par = p;
        let (fr_func, fr_p) = parse_func_decl(p);
        p = fr_p;
        trait_bad = required_own_tps(trait_bad, fn_at, fr_func);
        if (fr_func.name.len() == 0) {
          p = skip_body_item(p);
          continue;
        }
        let method_body: ast.Stmt[] = [];
        for st in fr_func.body {
          if let ast.StmtUnknown(u) = st {
            if (util.str_has_prefix(u.kind, "decl:")) {
              trait_bad = trait_bad.append(st);
              continue;
            }
          }
          method_body = method_body.append(st);
        }
        fr_func = FuncDecl { ...fr_func, body: method_body };
        decl_methods = decl_methods.append(fr_func);
        provided = provided.append(fr_func.name);
        if (fr_func.params.len() == 0 || fr_func.params[0].name != "self") {
          assoc_sigs = assoc_sigs.append(fr_func);
        }
        if (fr_func.body.len() > 0) {
          defaults = defaults.append(TraitDefault { trait_name: simple, trait_params: trait_tps.tnames, method: fr_func });
          default_sigs = default_sigs.append(FuncDecl { ...fr_func, body: [] });
        } else {
          required = required.append(fr_func.name);
          required_sigs = required_sigs.append(fr_func);
        }
      } else {
        trait_bad = trait_bad.append(decl_sentinel(p, "unexpected token in a trait body: expected `function`, `type` or `const`"));
        p = skip_body_item(p.advance());
      }
    }
    if (p.peek_punct() == "}") {
      p = p.advance();
    }
  }
  return (defaults, TraitReq { trait_name: simple, type_params: trait_tps.tnames, methods: required, req_sigs: required_sigs, supertraits: supertraits, assoc_sigs: assoc_sigs, provided: provided, assoc_types: assoc_types, module: "", default_sigs: default_sigs, visible_from: [] }, TraitDecl { name: tname, type_params: trait_tps.tnames, supertraits: decl_supers, methods: decl_methods, line: tline, col: tcol, is_pub: false, assoc_types: assoc_types, is_package: false }, trait_bad, p);
}

function skip_decl_modifier(p: Par, name: string, before: string): Par {
  if (p.peek_ident() != name) {
    return p;
  }
  let probe: Par = p.advance();
  if (probe.peek_keyword() != before) {
    return p;
  }
  return probe;
}

function is_float_type_name(t: string): boolean {
  return t == "f64" || t == "f32";
}

function is_unsettled_int_literal(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return !n.is_float && n.suffix.len() == 0 && !is_unit_literal(n);
    },
    ast.ExprUnary(u) => {
      if (u.op != "-" && u.op != "+") {
        return false;
      }
      return is_unsettled_int_literal(u.operand);
    },
    ast.ExprBinary(b) => {
      if (b.op != "+" && b.op != "-" && b.op != "*" && b.op != "/") {
        return false;
      }
      return is_unsettled_int_literal(b.left) && is_unsettled_int_literal(b.right);
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub function float_settled_int(n: ast.ExprNumber): boolean {
  return n.is_float && n.suffix.len() == 0 && util.index_of_sub(n.text, ".") < 0
    && util.index_of_sub(n.text, "e") < 0 && util.index_of_sub(n.text, "E") < 0;
}

function settle_float_expr(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprCall(_) => {
      return settle_float_value_branches(e);
    },
    _ => {}
  }
  if (!is_unsettled_int_literal(e)) {
    return e;
  }
  match (e) {
    ast.ExprNumber(n) => {
      return ast.ExprNumber { text: n.text, suffix: n.suffix, raw: n.raw, is_float: true, line: n.line, col: n.col };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: settle_float_expr(u.operand), line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: settle_float_expr(b.left), right: settle_float_expr(b.right), line: b.line, col: b.col, ty: b.ty };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function settled_branch_value(body: ast.Stmt[]): (ast.Expr, boolean) {
  if (body.len() > 0) {
    match (body[body.len() - 1]) {
      ast.StmtReturn(r) => {
        return (r.value, true);
      },
      _ => {}
    }
  }
  return (ast.ExprUnknown { kind: "no-branch-value", line: 0, col: 0 }, false);
}

function float_settleable(e: ast.Expr): boolean {
  if (is_unsettled_int_literal(e)) {
    return true;
  }
  match (e) {
    ast.ExprNumber(n) => {
      return n.is_float;
    },
    ast.ExprUnary(u) => {
      if (u.op != "-" && u.op != "+") {
        return false;
      }
      return float_settleable(u.operand);
    },
    ast.ExprBinary(b) => {
      if (b.op != "+" && b.op != "-" && b.op != "*" && b.op != "/") {
        return false;
      }
      return float_settleable(b.left) && float_settleable(b.right);
    },
    ast.ExprCall(_) => {
      return value_branches_float_settleable(e);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function value_branches_float_settleable(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() != 0) {
        return false;
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() == 0 && lm.origin == ORIGIN_BLOCK) {
            let (tv, t_ok) = settled_branch_value(lm.body);
            return t_ok && float_settleable(tv);
          }
          if (lm.params.len() != 0 || lm.body.len() != 1) {
            return false;
          }
          match (lm.body[0]) {
            ast.StmtIf(f) => {
              return if_branches_float_settleable(f);
            },
            ast.StmtMatch(m) => {
              return match_arms_float_settleable(m);
            },
            _ => {
              return false;
            }
          }
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

function settle_branch_body(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < body.len()) {
    let keep: ast.Stmt = body[i];
    if (i == body.len() - 1) {
      match (body[i]) {
        ast.StmtReturn(r) => {
          keep = s_return_at(settle_float_expr(r.value), r.line, r.col);
        },
        _ => {}
      }
    }
    out = out.append(keep);
    i = i + 1;
  }
  return out;
}

function if_branches_float_settleable(f: ast.StmtIf): boolean {
  let (tv, t_ok) = settled_branch_value(f.then_body);
  if (!t_ok || !float_settleable(tv)) {
    return false;
  }
  if (f.else_body.len() == 1) {
    match (f.else_body[0]) {
      ast.StmtIf(nf) => {
        return if_branches_float_settleable(nf);
      },
      _ => {}
    }
  }
  let (ev, e_ok) = settled_branch_value(f.else_body);
  return e_ok && float_settleable(ev);
}

function settle_if_branches(f: ast.StmtIf): ast.Stmt {
  let nelse: ast.Stmt[] = [];
  let chained: boolean = false;
  if (f.else_body.len() == 1) {
    match (f.else_body[0]) {
      ast.StmtIf(nf) => {
        nelse = nelse.append(settle_if_branches(nf));
        chained = true;
      },
      _ => {}
    }
  }
  if (!chained) {
    nelse = settle_branch_body(f.else_body);
  }
  return s_if(f.cond, settle_branch_body(f.then_body), nelse);
}

function match_arms_float_settleable(m: ast.StmtMatch): boolean {
  if (m.arms.len() == 0) {
    return false;
  }
  let a: i32 = 0;
  while (a < m.arms.len()) {
    let (av, a_ok) = settled_branch_value(m.arms[a].body);
    if (!a_ok || !float_settleable(av)) {
      return false;
    }
    a = a + 1;
  }
  return true;
}

function settle_match_arms(m: ast.StmtMatch): ast.Stmt {
  let arms: ast.MatchArm[] = [];
  let a: i32 = 0;
  while (a < m.arms.len()) {
    arms = arms.append(ast.MatchArm { pattern: m.arms[a].pattern, body: settle_branch_body(m.arms[a].body), line: m.arms[a].line, col: m.arms[a].col, guard: m.arms[a].guard, has_guard: m.arms[a].has_guard, alt_cont: false });
    a = a + 1;
  }
  return s_match_origin(m.scrutinee, arms, m.line, m.col, m.origin);
}

function settle_float_value_branches(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprCall(c) => {
      if (!value_branches_float_settleable(e)) {
        return e;
      }
      if let ast.ExprLambda(lm) = c.callee {
        let nlam: ast.Expr = ast.ExprLambda { ...lm, body: settle_value_body(lm) };
        return ast.ExprCall { callee: nlam, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
      }
    },
    _ => {}
  }
  return e;
}

function settle_value_body(lm: ast.ExprLambda): ast.Stmt[] {
  if (lm.origin == ORIGIN_BLOCK) {
    return settle_branch_body(lm.body);
  }
  match (lm.body[0]) {
    ast.StmtIf(f) => {
      return [settle_if_branches(f)];
    },
    ast.StmtMatch(m) => {
      return [settle_match_arms(m)];
    },
    _ => {}
  }
  return lm.body;
}

function settle_to_type(e: ast.Expr, t: TypeRef): ast.Expr {
  if (t.array_depth > 0) {
    let inner: TypeRef = elem_type_ref(t);
    match (e) {
      ast.ExprArray(a) => {
        let els: ast.Expr[] = [];
        let ei: i32 = 0;
        while (ei < a.elements.len()) {
          els = els.append(settle_to_type(a.elements[ei], inner));
          ei = ei + 1;
        }
        return ast.ExprArray { ...a, elements: els, elem_ty: render_type_ref(inner) };
      },
      _ => {
        return e;
      }
    }
    return e;
  }
  if (t.is_tuple) {
    match (e) {
      ast.ExprTuple(tu) => {
        let tels: ast.Expr[] = [];
        let ti: i32 = 0;
        while (ti < tu.elements.len()) {
          if (ti < t.args.len()) {
            tels = tels.append(settle_to_type(tu.elements[ti], t.args[ti]));
          } else {
            tels = tels.append(tu.elements[ti]);
          }
          ti = ti + 1;
        }
        return ast.ExprTuple { elements: tels, line: tu.line, col: tu.col };
      },
      _ => {
        return e;
      }
    }
    return e;
  }
  if (is_float_type_name(t.base)) {
    return settle_float_expr(e);
  }
  return e;
}

pub function settle_to_name(e: ast.Expr, type_name: string): ast.Expr {
  if (type_name.len() == 0 || !settleable(e)) {
    return e;
  }
  return settle_to_type(e, parse_type_ref(type_name));
}

function settleable(e: ast.Expr): boolean {
  match (e) {
    ast.ExprArray(_) => {
      return true;
    },
    ast.ExprTuple(_) => {
      return true;
    },
    ast.ExprCall(c) => {
      if let ast.ExprLambda(_) = c.callee {
        return true;
      }
      return false;
    },
    _ => {}
  }
  return is_unsettled_int_literal(e);
}

struct SettleFns {
  decls: FuncDecl[],
  head: i32[],
  next: i32[],
}

function settle_buckets(): i32 {
  return 4093;
}

function settle_fns_of(decls: FuncDecl[]): SettleFns {
  let head: i32[] = [];
  let b: i32 = 0;
  let nb: i32 = settle_buckets();
  while (b < nb) {
    head = head.append(0 - 1);
    b = b + 1;
  }
  let next: i32[] = [];
  let j: i32 = 0;
  while (j < decls.len()) {
    next = next.append(0 - 1);
    j = j + 1;
  }
  let k: i32 = decls.len() - 1;
  while (k >= 0) {
    let bk: i32 = util.hash_bucket(decls[k].name, nb);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    k = k - 1;
  }
  return SettleFns { decls: decls, head: head, next: next };
}

function settle_param_type_names(f: FuncDecl): string[] {
  let out: string[] = [];
  let pi: i32 = 0;
  while (pi < f.params.len()) {
    out = out.append(f.params[pi].type_name);
    pi = pi + 1;
  }
  return out;
}

function settle_param_types(fns: SettleFns, name: string): string[] {
  let i: i32 = fns.head[util.hash_bucket(name, settle_buckets())];
  while (i >= 0) {
    let f: FuncDecl = fns.decls[i];
    if (f.name == name && f.receiver_name.len() == 0) {
      return settle_param_type_names(f);
    }
    i = fns.next[i];
  }
  return [];
}

function settle_method_param_types(fns: SettleFns, recv_type: string, name: string): string[] {
  if (recv_type.len() == 0) {
    return [];
  }
  let i: i32 = fns.head[util.hash_bucket(name, settle_buckets())];
  while (i >= 0) {
    let f: FuncDecl = fns.decls[i];
    if (f.name == name && f.receiver_type == recv_type) {
      return settle_param_type_names(f);
    }
    i = fns.next[i];
  }
  return [];
}

function settle_field_type(structs: StructDecl[], type_name: string, field: string): string {
  let i: i32 = 0;
  while (i < structs.len()) {
    let sd: StructDecl = structs[i];
    if (sd.name == type_name) {
      let fi: i32 = 0;
      while (fi < sd.fields.len()) {
        if (sd.fields[fi].name == field) {
          return sd.fields[fi].type_name;
        }
        fi = fi + 1;
      }
      return "";
    }
    i = i + 1;
  }
  return "";
}

function settle_local_type(names: string[], types: string[], name: string): string {
  let i: i32 = names.len() - 1;
  while (i >= 0) {
    if (names[i] == name) {
      return types[i];
    }
    i = i - 1;
  }
  return "";
}

function settle_expr(e: ast.Expr, names: string[], types: string[], fns: SettleFns, structs: StructDecl[]): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: settle_expr(b.left, names, types, fns, structs), right: settle_expr(b.right, names, types, fns, structs), line: b.line, col: b.col, ty: b.ty };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: settle_expr(u.operand, names, types, fns, structs), line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprCall(c) => {
      let ptypes: string[] = [];
      match (c.callee) {
        ast.ExprIdent(id) => {
          ptypes = settle_param_types(fns, id.name);
        },
        ast.ExprFieldAccess(mfa) => {
          match (mfa.obj) {
            ast.ExprIdent(rid) => {
              ptypes = settle_method_param_types(fns, settle_local_type(names, types, rid.name), mfa.field);
            },
            _ => {
              ptypes = [];
            }
          }
        },
        _ => {
          ptypes = [];
        }
      }
      let args: ast.Expr[] = [];
      let ai: i32 = 0;
      while (ai < c.args.len()) {
        let arg: ast.Expr = settle_expr(c.args[ai], names, types, fns, structs);
        if (ai < ptypes.len()) {
          arg = settle_to_name(arg, ptypes[ai]);
        }
        args = args.append(arg);
        ai = ai + 1;
      }
      return ast.ExprCall { callee: settle_expr(c.callee, names, types, fns, structs), args: args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprArray(a) => {
      let els: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < a.elements.len()) {
        els = els.append(settle_expr(a.elements[i], names, types, fns, structs));
        i = i + 1;
      }
      return ast.ExprArray { ...a, elements: els };
    },
    ast.ExprTuple(t) => {
      let tels: ast.Expr[] = [];
      let ti: i32 = 0;
      while (ti < t.elements.len()) {
        tels = tels.append(settle_expr(t.elements[ti], names, types, fns, structs));
        ti = ti + 1;
      }
      return ast.ExprTuple { elements: tels, line: t.line, col: t.col };
    },
    ast.ExprIndex(x) => {
      return ast.ExprIndex { array: settle_expr(x.array, names, types, fns, structs), index: settle_expr(x.index, names, types, fns, structs), unchecked: x.unchecked, ty: x.ty, line: x.line, col: x.col };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, array: settle_expr(sl.array, names, types, fns, structs), start: settle_expr(sl.start, names, types, fns, structs), end: settle_expr(sl.end, names, types, fns, structs) };
    },
    ast.ExprStructLit(sl) => {
      let vals: ast.Expr[] = [];
      let vi: i32 = 0;
      while (vi < sl.field_values.len()) {
        let v: ast.Expr = settle_expr(sl.field_values[vi], names, types, fns, structs);
        if (vi < sl.field_names.len()) {
          v = settle_to_name(v, settle_field_type(structs, sl.type_name, sl.field_names[vi]));
        }
        vals = vals.append(v);
        vi = vi + 1;
      }
      let base: ast.Expr = sl.base;
      if (sl.has_base) {
        base = settle_expr(sl.base, names, types, fns, structs);
      }
      return ast.ExprStructLit { ...sl, field_values: vals, base: base };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, obj: settle_expr(fa.obj, names, types, fns, structs) };
    },
    ast.ExprLambda(lm) => {
      let lnames: string[] = names;
      let ltypes: string[] = types;
      let lpi: i32 = 0;
      while (lpi < lm.params.len()) {
        lnames = lnames.append(lm.params[lpi].name);
        ltypes = ltypes.append(lm.params[lpi].type_name);
        lpi = lpi + 1;
      }
      return ast.ExprLambda { ...lm, body: settle_block(lm.body, lm.ret_type, lnames, ltypes, fns, structs) };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function settle_stmt(st: ast.Stmt, ret_type: string, names: string[], types: string[], fns: SettleFns, structs: StructDecl[]): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      let init: ast.Expr = settle_to_name(settle_expr(v.init, names, types, fns, structs), v.type_name);
      return ast.StmtVar { name: v.name, type_name: v.type_name, init: init, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: settle_to_name(settle_expr(r.value, names, types, fns, structs), ret_type), line: r.line, col: r.col };
    },
    ast.StmtAssign(a) => {
      let val: ast.Expr = settle_to_name(settle_expr(a.value, names, types, fns, structs), settle_local_type(names, types, a.target));
      return ast.StmtAssign { target: a.target, value: val, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { value: settle_expr(x.value, names, types, fns, structs), line: x.line };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: settle_expr(f.cond, names, types, fns, structs), then_body: settle_block(f.then_body, ret_type, names, types, fns, structs), else_body: settle_block(f.else_body, ret_type, names, types, fns, structs) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: settle_expr(w.cond, names, types, fns, structs), body: settle_block(w.body, ret_type, names, types, fns, structs), label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: settle_expr(fr.iter, names, types, fns, structs), body: settle_block(fr.body, ret_type, names, types, fns, structs), label: fr.label, line: fr.line, col: fr.col };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let ai: i32 = 0;
      while (ai < m.arms.len()) {
        let a: ast.MatchArm = m.arms[ai];
        arms = arms.append(ast.MatchArm { ...a, body: settle_block(a.body, ret_type, names, types, fns, structs) });
        ai = ai + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: settle_expr(m.scrutinee, names, types, fns, structs), arms: arms };
    },
    ast.StmtDefer(dd) => {
      return ast.StmtDefer { action: settle_stmt(dd.action, ret_type, names, types, fns, structs), on_error: dd.on_error, line: dd.line };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function settle_block(stmts: ast.Stmt[], ret_type: string, names: string[], types: string[], fns: SettleFns, structs: StructDecl[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(settle_stmt(stmts[i], ret_type, names, types, fns, structs));
    match (stmts[i]) {
      ast.StmtVar(v) => {
        if (v.type_name.len() > 0) {
          names = names.append(v.name);
          types = types.append(v.type_name);
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return out;
}

pub function settle_module(mod: Module): Module {
  let fns: SettleFns = settle_fns_of(mod.funcs);
  let funcs: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    let names: string[] = [];
    let types: string[] = [];
    let pi: i32 = 0;
    while (pi < fd.params.len()) {
      names = names.append(fd.params[pi].name);
      types = types.append(fd.params[pi].type_name);
      pi = pi + 1;
    }
    if (fd.receiver_name.len() > 0) {
      names = names.append(fd.receiver_name);
      types = types.append(fd.receiver_type);
    }
    funcs = funcs.append(FuncDecl { ...fd, body: settle_block(fd.body, fd.ret_type, names, types, fns, mod.structs) });
    i = i + 1;
  }
  let nonames: string[] = [];
  return Module { ...mod, funcs: funcs, top_stmts: settle_block(mod.top_stmts, "", nonames, nonames, fns, mod.structs) };
}

pub struct ConstTable { names: string[], values: ast.Expr[] }

pub function inferred_const_table(funcs: FuncDecl[], names: string[], t: ConstTable): ConstTable {
  let out: ConstTable = t;
  for fd in funcs {
    if (fd.is_const && util.has_str(names, fd.name) && fd.body.len() == 1) {
      if let ast.StmtReturn(r) = fd.body[0] {
        out = ConstTable { names: out.names.append(fd.name), values: out.values.append(astwalk.substitute_consts_expr(r.value, out.names, out.values)) };
      }
    }
  }
  return out;
}

pub function substitute_const_refs(mod: Module, t: ConstTable): Module {
  if (t.names.len() == 0) {
    return mod;
  }
  let funcs: FuncDecl[] = [];
  let earlier: string[] = [];
  for fd in mod.funcs {
    if (fd.is_const) {
      let seen: ConstTable = const_table_within(t, earlier);
      funcs = funcs.append(FuncDecl { ...fd, body: astwalk.substitute_consts(fd.body, [], seen.names, seen.values) });
      earlier = earlier.append(fd.name);
      continue;
    }
    let bound: string[] = [];
    let params: ast.ParamDecl[] = [];
    for p in fd.params {
      params = params.append(ast.ParamDecl { ...p, default_value: astwalk.substitute_consts_expr(p.default_value, t.names, t.values) });
      bound = astwalk.append_bound_name(bound, p.name);
    }
    if (fd.receiver_name.len() > 0) {
      bound = bound.append(fd.receiver_name);
    }
    funcs = funcs.append(FuncDecl { ...fd, params: params, body: astwalk.substitute_consts(fd.body, bound, t.names, t.values) });
  }
  return Module { ...mod, funcs: funcs, top_stmts: astwalk.substitute_consts(mod.top_stmts, [], t.names, t.values) };
}

pub function rewrite_assoc_const_reads(mod: Module): Module {
  let types: string[] = ["Self", "i32", "i64", "u8", "u32", "u64", "usize", "f32", "f64", "boolean", "string", "char"];
  for sd in mod.structs {
    types = types.append(sd.name);
  }
  let enums: string[] = [];
  for ed in mod.enums {
    types = types.append(ed.name);
    enums = enums.append(ed.name);
  }
  let enum_assoc: string[] = [];
  for im in mod.impls {
    let im_base: string = util.base_type_name(im.impl_type);
    if (util.has_str(enums, im_base)) {
      for mn in im.method_names {
        enum_assoc = enum_assoc.append(im_base + "." + mn);
      }
    }
  }
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    let bound: string[] = [];
    for p in fd.params {
      bound = astwalk.append_bound_name(bound, p.name);
    }
    if (fd.receiver_name.len() > 0) {
      bound = bound.append(fd.receiver_name);
    }
    let fn_types: string[] = util.append_all(util.append_all(types, fd.type_params), fd.all_type_params);
    funcs = funcs.append(FuncDecl { ...fd, body: astwalk.rewrite_assoc_const_reads(fd.body, bound, fn_types, enums, enum_assoc) });
  }
  return Module { ...mod, funcs: funcs, top_stmts: astwalk.rewrite_assoc_const_reads(mod.top_stmts, [], types, enums, enum_assoc) };
}

function const_table_within(t: ConstTable, names: string[]): ConstTable {
  let out: ConstTable = ConstTable { names: [], values: [] };
  let i: i32 = 0;
  for n in t.names {
    if (util.has_str(names, n)) {
      out = ConstTable { names: out.names.append(n), values: out.values.append(t.values[i]) };
    }
    i = i + 1;
  }
  return out;
}

function unannotated_const_names(funcs: FuncDecl[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    if (fd.is_const && fd.ret_type == "") {
      out = out.append(fd.name);
    }
  }
  return out;
}

function settle_const_types(funcs: FuncDecl[], structs: StructDecl[]): FuncDecl[] {
  let known: ast.ParamDecl[] = [];
  let out: FuncDecl[] = [];
  for fd in funcs {
    let f: FuncDecl = fd;
    if (f.is_const && f.ret_type == "" && f.body.len() == 1) {
      if let ast.StmtReturn(r) = f.body[0] {
        f = FuncDecl { ...f, ret_type: irt_guess(r.value, known, funcs, structs) };
      }
    }
    if (f.is_const && f.ret_type.len() > 0) {
      known = known.append(ast.ParamDecl { name: f.name, type_name: f.ret_type, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" });
    }
    out = out.append(f);
  }
  return out;
}

pub function parse_module(toks: lexer.Token[]): Module {
  let (m, t, im, fl, ih) = parse_module_flagged(toks, false);
  return m;
}

pub function parse_module_verbatim(toks: lexer.Token[]): ParsedFmt {
  let (m, t, im, fl, ih) = parse_module_flagged(toks, true);
  return ParsedFmt { pmod: m, ptraits: t, pimpls: im, pflines: fl, pinline: ih, pspans: block_spans(toks) };
}

function record_field_lines(acc: FieldLines[], verbatim: boolean, name: string, decl_line: i32, lines: i32[]): FieldLines[] {
  if (!verbatim) {
    return acc;
  }
  return acc.append(FieldLines { name: name, decl_line: decl_line, lines: lines });
}

function parse_module_flagged(toks: lexer.Token[], verbatim: boolean): (Module, TraitDecl[], ImplDecl[], FieldLines[], FunctionInlineHint[]) {
  if let Some(le) = stream_lex_error(toks) {
    return lex_error_module(le);
  }
  let p: Par = Par { toks: toks, pos: 0, no_struct: false, map_kind: 0 - 1, structnames: scan_struct_names(toks), verbatim: verbatim, depth: 0, type_errs: [], todos: [], tail_at: [], tail_is: [] };
  let funcs: FuncDecl[] = [];
  let trait_defaults: TraitDefault[] = [];
  let trait_reqs: TraitReq[] = [];
  let impl_infos: ImplInfo[] = [];
  let structs: StructDecl[] = [];
  let aliases: TypeAlias[] = [];
  let imports: Import[] = [];
  let top_stmts: ast.Stmt[] = [];
  let enums: EnumDecl[] = [];
  let resources: ResourceDecl[] = [];
  let exports: ExportBinding[] = [];
  let traits: TraitDecl[] = [];
  let impl_decls: ImplDecl[] = [];
  let flines: FieldLines[] = [];
  let inline_hints: FunctionInlineHint[] = [];
  let mth_keys: string[] = [];
  let mth_traits: string[] = [];
  while (!p.at_end()) {
    let decl_start: i32 = p.pos;
    let attr: DeclAttr = no_decl_attr();
    if (p.peek_punct() == "@") {
      let (da, da_bad, da_p) = parse_decl_attr(p);
      if (da_bad.len() > 0) {
        for b in da_bad {
          top_stmts = top_stmts.append(b);
        }
        p = skip_failed_decl(da_p, decl_start);
        continue;
      }
      attr = da;
      p = da_p;
    }
    let kw: string = p.peek_keyword();
    let decl_pub: boolean = false;
    let decl_package: boolean = false;
    let decl_line: i32 = p.peek_line();
    let decl_col: i32 = p.peek_col();
    if (kw == "pub") {
      let pub_at: Par = p;
      p = p.advance();
      let (mpk, mpk_p) = consume_pub_package(p);
      p = mpk_p;
      kw = p.peek_keyword();
      decl_pub = !mpk;
      decl_package = mpk;
      let pub_bad: ast.Stmt[] = pub_errors(pub_at, p);
      if (pub_bad.len() > 0) {
        for b in pub_bad {
          top_stmts = top_stmts.append(b);
        }
        p = skip_failed_decl(p, decl_start);
        continue;
      }
    }
    let decl_async: boolean = false;
    let async_p: Par = skip_decl_modifier(p, "async", "function");
    if (async_p.pos != p.pos) {
      p = async_p;
      kw = "function";
      decl_async = true;
    }
    let decl_fip: boolean = false;
    let decl_fbip: boolean = false;
    let decl_fip_allowance: i32 = 0;
    let fm_name: string = p.peek_ident();
    if (fm_name == "fip" || fm_name == "fbip") {
      let fm_probe: Par = p.advance();
      let fm_grade: i32 = 0;
      if (fm_probe.peek_punct() == "(") {
        let fm_num: Par = fm_probe.advance();
        if (fm_num.peek_is_literal()) {
          let fm_close: Par = fm_num.advance();
          if (fm_close.peek_punct() == ")") {
            fm_grade = util.digits_to_i32(fm_num.peek_number_text());
            fm_probe = fm_close.advance();
          }
        }
      }
      if (fm_probe.peek_keyword() == "function") {
        p = fm_probe;
        kw = "function";
        decl_fip = fm_name == "fip";
        decl_fbip = fm_name == "fbip";
        decl_fip_allowance = fm_grade;
      }
    }
    let opaque_p: Par = skip_decl_modifier(p, "opaque", "struct");
    let decl_opaque: boolean = opaque_p.pos != p.pos;
    if (decl_opaque) {
      p = opaque_p;
      kw = "struct";
    }
    let is_resource: boolean = p.peek_ident() == "resource" && p.advance().peek_ident().len() > 0;
    let decl_kind: string = kw;
    if (is_resource) {
      decl_kind = "resource";
    }
    if (!attr_fits(attr.name, decl_kind)) {
      top_stmts = top_stmts.append(decl_sentinel(p, attr_misplaced(attr.name)));
      p = skip_failed_decl(p, decl_start);
      continue;
    }
    if (util.has_str(["struct", "enum", "trait", "type", "const"], kw) && p.advance().peek_ident().len() == 0) {
      for bad in expected_here(p.advance(), "a name") {
        top_stmts = top_stmts.append(bad);
      }
      p = skip_failed_decl(p.advance(), decl_start);
      continue;
    }
    if (kw == "function") {
      let errors_before: i32 = p.type_errs.len();
      let (fr_func, fr_p) = parse_func_decl(p);
      p = fr_p;
      if (fr_func.name.len() == 0) {
        if (p.type_errs.len() == errors_before) {
          top_stmts = top_stmts.append(s_unknown_at("decl:" + malformed_fn_decl_message(), fr_func.line, fr_func.col));
        }
        p = sync_to_top_level(p);
        continue;
      }
      let inline_hint: boolean = attr.name == "inline" || attr.name == "noinline";
      if (verbatim && inline_hint) {
        inline_hints = inline_hints.append(FunctionInlineHint { line: fr_func.line, col: fr_func.col, never: attr.name == "noinline" });
      }
      let fr_pub: FuncDecl = FuncDecl { ...fr_func, is_pub: decl_pub, is_package: decl_package, no_inline: attr.name == "noinline" };
      if (attr.name == "import") {
        fr_pub = FuncDecl { ...fr_pub, import_iface: attr.iface, import_wit: attr.wit };
      }
      if (attr.name == "export") {
        exports = exports.append(ExportBinding { func_name: fr_func.name, iface: attr.iface, wit: attr.wit, c_abi: false });
      }
      let fr_out: FuncDecl = fr_pub;
      if (decl_fip || decl_fbip) {
        fr_out = FuncDecl { ...fr_pub, fip: decl_fip, fbip: decl_fbip, fip_allowance: decl_fip_allowance };
      } else if (decl_async) {
        fr_out = FuncDecl { ...fr_pub, async: true };
      }
      let fr_cl: MethodClaim = claim_method_name(fr_out, "", mth_keys, mth_traits);
      mth_keys = fr_cl.keys;
      mth_traits = fr_cl.traits;
      funcs = funcs.append(fr_cl.fn);
      continue;
    }
    if (kw == "struct") {
      let (sr_decl, sr_lines, sr_p) = parse_struct_decl(p);
      p = sr_p;
      flines = record_field_lines(flines, verbatim, sr_decl.name, sr_decl.line, sr_lines);
      structs = structs.append(StructDecl { ...sr_decl, derives: attr.derives, must_consume: attr.name == "must_consume", is_pub: decl_pub, is_package: decl_package, opaque: decl_opaque });
      funcs = synth_derives(sr_decl, attr.derives, funcs, imports_have_std_json(imports));
      continue;
    }
    if (kw == "type") {
      let (tr_alias, tr_p) = parse_type_alias(p);
      p = tr_p;
      aliases = aliases.append(TypeAlias { ...tr_alias, is_pub: decl_pub, is_package: decl_package });
      continue;
    }
    if (kw == "enum") {
      let eline: i32 = p.peek_line();
      let ecol: i32 = p.peek_col();
      let (enr_name, enr_variants, enr_type_params, enr_vlines, enr_p) = parse_enum_decl(p);
      p = enr_p;
      flines = record_field_lines(flines, verbatim, enr_name, eline, enr_vlines);
      enums = enums.append(EnumDecl { name: enr_name, variant_names: enum_variant_names(enr_variants), type_params: enr_type_params, line: eline, col: ecol, must_consume: attr.name == "must_consume", try_marker: attr.name == "try", is_pub: decl_pub, is_package: decl_package, module: "", instance: "", visible_from: [] });
      let ei: i32 = 0;
      while (ei < enr_variants.len()) {
        structs = structs.append(StructDecl { ...enr_variants[ei], derives: attr.derives });
        ei = ei + 1;
      }
      funcs = synth_enum_derives(enr_name, enr_type_params, enr_variants, attr.derives, funcs, imports_have_std_json(imports));
      continue;
    }
    if (kw == "const") {
      let (cr_func, cr_p) = parse_const_decl(p);
      p = cr_p;
      funcs = funcs.append(FuncDecl { ...cr_func, is_pub: decl_pub, is_package: decl_package });
      continue;
    }
    if (kw == "import") {
      let (ir_imp, ir_bad, ir_p) = parse_import(p);
      p = ir_p;
      if (ir_imp.path.len() > 0 || ir_bad.len() == 0) {
        imports = imports.append(ir_imp);
      }
      for b in ir_bad {
        top_stmts = top_stmts.append(b);
      }
      continue;
    }
    if (kw == "use") {
      let (ur_imp, ur_bad, ur_p) = parse_pubuse(p, decl_line, decl_col);
      p = ur_p;
      if (ur_imp.path.len() > 0 || ur_bad.len() == 0) {
        imports = imports.append(ur_imp);
      }
      for b in ur_bad {
        top_stmts = top_stmts.append(b);
      }
      continue;
    }
    if (kw == "trait") {
      let (tpr_defaults, tpr_req, tpr_decl, tpr_bad, tpr_p) = parse_trait_decl(p);
      p = tpr_p;
      for b in tpr_bad {
        top_stmts = top_stmts.append(b);
      }
      traits = traits.append(TraitDecl { ...tpr_decl, is_pub: decl_pub, is_package: decl_package });
      let tdi: i32 = 0;
      while (tdi < tpr_defaults.len()) {
        trait_defaults = trait_defaults.append(tpr_defaults[tdi]);
        tdi = tdi + 1;
      }
      trait_reqs = trait_reqs.append(tpr_req);
      continue;
    }
    if (kw == "impl") {
      let (imr_funcs, imr_trait_name, imr_impl_type, imr_type_params, imr_bounds, imr_method_names, imr_trait_spelling, imr_decl, imr_bad, imr_p) = parse_impl_decl(p);
      p = imr_p;
      for b in imr_bad {
        top_stmts = top_stmts.append(b);
      }
      impl_decls = impl_decls.append(imr_decl);
      let mi: i32 = 0;
      while (mi < imr_funcs.len() && !p.verbatim) {
        let im_cl: MethodClaim = claim_method_name(imr_funcs[mi], imr_trait_name, mth_keys, mth_traits);
        mth_keys = im_cl.keys;
        mth_traits = im_cl.traits;
        funcs = funcs.append(im_cl.fn);
        mi = mi + 1;
      }
      impl_infos = impl_infos.append(ImplInfo { trait_name: imr_trait_name, impl_type: imr_impl_type, type_params: imr_type_params, all_type_params: imr_decl.type_params, bounds: imr_bounds, method_names: imr_method_names, trait_spelling: imr_trait_spelling, trait_ref: imr_decl.trait_ref, assoc_names: imr_decl.assoc_names, assoc_values: imr_decl.assoc_values, trait_module: "", module: "", line: imr_decl.line, col: imr_decl.col });
      continue;
    }
    if (is_resource) {
      let rnr_line: i32 = p.peek_line();
      let rnr_col: i32 = p.peek_col();
      let (rnr_name, rnr_p) = parse_resource_decl_name(p);
      p = rnr_p;
      resources = resources.append(ResourceDecl { name: rnr_name, iface: attr.iface, wit: attr.wit, line: rnr_line, col: rnr_col });
      continue;
    }
    let (stmtR_stmt, stmtR_p) = parse_stmt(p);
    if (stmtR_p.pos == p.pos) {
      p = p.advance();
      continue;
    }
    p = stmtR_p;
    top_stmts = top_stmts.append(stmtR_stmt);
  }
  let iii: i32 = 0;
  while (iii < impl_infos.len() && !verbatim) {
    let info: ImplInfo = impl_infos[iii];
    let ddi: i32 = 0;
    while (ddi < trait_defaults.len()) {
      let td: TraitDefault = trait_defaults[ddi];
      if (td.trait_name == info.trait_name) {
        if (!str_list_contains(info.method_names, td.method.name)) {
          let td_cl: MethodClaim = claim_method_name(inherit_default(td.method, td.trait_params, info), info.trait_name, mth_keys, mth_traits);
          mth_keys = td_cl.keys;
          mth_traits = td_cl.traits;
          funcs = funcs.append(td_cl.fn);
        }
      }
      ddi = ddi + 1;
    }
    iii = iii + 1;
  }
  for te in p.type_errs {
    top_stmts = top_stmts.append(te);
  }
  match (unclosed_brace(toks)) {
    Some(ub) => {
      top_stmts = top_stmts.append(ub);
    },
    None => {}
  }
  let parsed: Module = Module { funcs: funcs, structs: structs, aliases: aliases, imports: imports, top_stmts: top_stmts, enums: enums, resources: resources, exports: exports, impls: impl_infos, trait_reqs: trait_reqs, trait_decls: traits, inferred_consts: [], todo_sites: p.todos, sights: [] };
  if (!verbatim) {
    let inferred: string[] = unannotated_const_names(funcs);
    let nothing: string[] = [];
    parsed = substitute_const_refs(parsed, inferred_const_table(funcs, inferred, ConstTable { names: nothing, values: [] }));
    parsed = rewrite_assoc_const_reads(parsed);
    parsed = Module { ...parsed, funcs: settle_const_types(parsed.funcs, structs), inferred_consts: inferred };
    parsed = desugar_union_aliases(desugar_trait_params(parsed, trait_decl_names(traits), false));
  }
  let settled: Module = settle_module(resolve_variant_fields_module(resolve_labels_module(resolve_assoc_projections(parsed))));
  if (!verbatim) {
    settled = route_inherited_defaults(resolve_dyn_traits(rename_type_vars_module(settled)));
  }
  return (settled, traits, impl_decls, flines, inline_hints);
}

function stream_lex_error(toks: lexer.Token[]): Option[lexer.TokError] {
  if (toks.len() == 0) {
    return None;
  }
  if let lexer.TokError(e) = toks[toks.len() - 1] {
    return Some(e);
  }
  return None;
}

function lex_error_kind(e: lexer.TokError): string {
  return "lex:" + e.code + ":" + e.msg;
}

function coded_kind(code: string, msg: string): string {
  return "code:" + code + ":" + msg;
}

function lex_error_module(le: lexer.TokError): (Module, TraitDecl[], ImplDecl[], FieldLines[], FunctionInlineHint[]) {
  let m: Module = Module { funcs: [], structs: [], aliases: [], imports: [], top_stmts: [s_unknown_at(lex_error_kind(le), le.line, le.col)], enums: [], resources: [], exports: [], impls: [], trait_reqs: [], trait_decls: [], inferred_consts: [], todo_sites: [], sights: [] };
  let traits: TraitDecl[] = [];
  let impls: ImplDecl[] = [];
  let flines: FieldLines[] = [];
  let hints: FunctionInlineHint[] = [];
  return (m, traits, impls, flines, hints);
}

function unclosed_brace(toks: lexer.Token[]): Option[ast.Stmt] {
  if (toks.len() == 0) {
    return None;
  }
  let end_line: i32 = 0;
  let end_col: i32 = 0;
  if let lexer.TokEof(e) = toks[toks.len() - 1] {
    end_line = e.line;
    end_col = e.col;
  } else {
    return None;
  }
  let open_lines: i32[] = [];
  let open_cols: i32[] = [];
  let depth: i32 = 0;
  for t in toks {
    if let lexer.TokPunct(x) = t {
      if (x.text == "{") {
        open_lines = push_at(open_lines, depth, x.line);
        open_cols = push_at(open_cols, depth, x.col);
        depth = depth + 1;
      } else if (x.text == "}" && depth > 0) {
        depth = depth - 1;
      }
    }
  }
  if (depth == 0) {
    return None;
  }
  let at: string = util.i32_to_string(open_lines[depth - 1]) + ":" + util.i32_to_string(open_cols[depth - 1]);
  return Some(s_unknown_at("decl:expected \"}\" before the end of the input, to close the \"{\" at " + at, end_line, end_col));
}

function push_at(xs: i32[], i: i32, v: i32): i32[] {
  if (i < xs.len()) {
    return xs.with(i, v);
  }
  return xs.append(v);
}

pub function merge_module(into: Module, from: Module): Module {
  let nfuncs: FuncDecl[] = into.funcs;
  let fi: i32 = 0;
  while (fi < from.funcs.len()) {
    nfuncs = nfuncs.append(from.funcs[fi]);
    fi = fi + 1;
  }
  let nstructs: StructDecl[] = into.structs;
  let si: i32 = 0;
  while (si < from.structs.len()) {
    nstructs = nstructs.append(from.structs[si]);
    si = si + 1;
  }
  let naliases: TypeAlias[] = into.aliases;
  let ai: i32 = 0;
  while (ai < from.aliases.len()) {
    naliases = naliases.append(from.aliases[ai]);
    ai = ai + 1;
  }
  let nresources: ResourceDecl[] = into.resources;
  let ri: i32 = 0;
  while (ri < from.resources.len()) {
    nresources = nresources.append(from.resources[ri]);
    ri = ri + 1;
  }
  let nexports: ExportBinding[] = into.exports;
  let xi: i32 = 0;
  while (xi < from.exports.len()) {
    nexports = nexports.append(from.exports[xi]);
    xi = xi + 1;
  }
  let nimpls: ImplInfo[] = into.impls;
  let nii: i32 = 0;
  while (nii < from.impls.len()) {
    nimpls = nimpls.append(from.impls[nii]);
    nii = nii + 1;
  }
  let ntdecls: TraitDecl[] = into.trait_decls;
  let tdi2: i32 = 0;
  while (tdi2 < from.trait_decls.len()) {
    ntdecls = ntdecls.append(from.trait_decls[tdi2]);
    tdi2 = tdi2 + 1;
  }
  let ntreqs: TraitReq[] = into.trait_reqs;
  let nti: i32 = 0;
  while (nti < from.trait_reqs.len()) {
    ntreqs = ntreqs.append(from.trait_reqs[nti]);
    nti = nti + 1;
  }
  return resolve_assoc_projections(Module { ...into, funcs: nfuncs, structs: nstructs, aliases: naliases, enums: concat_enums(into.enums, from.enums), resources: nresources, exports: nexports, impls: nimpls, trait_reqs: ntreqs, trait_decls: ntdecls });
}

pub function merge_module_prefixed(into: Module, from: Module, prefix: string): Module {
  let nfuncs: FuncDecl[] = into.funcs;
  let fi: i32 = 0;
  while (fi < from.funcs.len()) {
    let fd: FuncDecl = from.funcs[fi];
    nfuncs = nfuncs.append(FuncDecl { ...fd, name: prefix + "." + fd.name, is_pub: true });
    fi = fi + 1;
  }
  let nstructs: StructDecl[] = into.structs;
  let si: i32 = 0;
  while (si < from.structs.len()) {
    let sd: StructDecl = from.structs[si];
    nstructs = nstructs.append(StructDecl { name: prefix + "." + sd.name, fields: sd.fields, type_params: sd.type_params, derives: sd.derives, line: sd.line, col: sd.col, enum_owner: sd.enum_owner, must_consume: sd.must_consume, variant_field_names: sd.variant_field_names, is_pub: true, is_package: false, opaque: sd.opaque, module: sd.module });
    si = si + 1;
  }
  let naliases: TypeAlias[] = into.aliases;
  let ai: i32 = 0;
  while (ai < from.aliases.len()) {
    let ad: TypeAlias = from.aliases[ai];
    naliases = naliases.append(TypeAlias { ...ad, name: prefix + "." + ad.name, is_pub: true, is_package: false });
    ai = ai + 1;
  }
  let nresources: ResourceDecl[] = into.resources;
  let ri: i32 = 0;
  while (ri < from.resources.len()) {
    let rd: ResourceDecl = from.resources[ri];
    nresources = nresources.append(ResourceDecl { ...rd, name: prefix + "." + rd.name });
    ri = ri + 1;
  }
  let nexports: ExportBinding[] = into.exports;
  let xi: i32 = 0;
  while (xi < from.exports.len()) {
    let xb: ExportBinding = from.exports[xi];
    nexports = nexports.append(ExportBinding { func_name: prefix + "." + xb.func_name, iface: xb.iface, wit: xb.wit, c_abi: xb.c_abi });
    xi = xi + 1;
  }
  let nimpls: ImplInfo[] = into.impls;
  let nii: i32 = 0;
  while (nii < from.impls.len()) {
    nimpls = nimpls.append(from.impls[nii]);
    nii = nii + 1;
  }
  let ntdecls: TraitDecl[] = into.trait_decls;
  let tdi2: i32 = 0;
  while (tdi2 < from.trait_decls.len()) {
    ntdecls = ntdecls.append(from.trait_decls[tdi2]);
    tdi2 = tdi2 + 1;
  }
  let ntreqs: TraitReq[] = into.trait_reqs;
  let nti: i32 = 0;
  while (nti < from.trait_reqs.len()) {
    ntreqs = ntreqs.append(from.trait_reqs[nti]);
    nti = nti + 1;
  }
  return resolve_assoc_projections(Module { ...into, funcs: nfuncs, structs: nstructs, aliases: naliases, enums: concat_enums(into.enums, from.enums), resources: nresources, exports: nexports, impls: nimpls, trait_reqs: ntreqs, trait_decls: ntdecls });
}

function main(): i32 {
  let rc: i32 = check_operator_precedence();
  if (rc != 0) {
    return rc;
  }
  rc = check_if_and_while();
  if (rc != 0) {
    return rc;
  }
  rc = check_compound_assignment();
  if (rc != 0) {
    return rc;
  }
  rc = check_slice_expressions();
  if (rc != 0) {
    return rc;
  }
  rc = check_module_functions();
  if (rc != 0) {
    return rc;
  }
  rc = check_struct_declarations();
  if (rc != 0) {
    return rc;
  }
  rc = check_struct_literals();
  if (rc != 0) {
    return rc;
  }
  rc = check_type_aliases();
  if (rc != 0) {
    return rc;
  }
  rc = check_match_statements();
  if (rc != 0) {
    return rc;
  }
  rc = check_var_annotations();
  if (rc != 0) {
    return rc;
  }
  rc = check_receiver_methods();
  if (rc != 0) {
    return rc;
  }
  rc = check_imports();
  if (rc != 0) {
    return rc;
  }
  rc = check_for_in_loops();
  if (rc != 0) {
    return rc;
  }
  rc = check_tuples();
  if (rc != 0) {
    return rc;
  }
  rc = check_break_and_continue();
  if (rc != 0) {
    return rc;
  }
  rc = check_generics();
  if (rc != 0) {
    return rc;
  }
  rc = check_lambdas();
  if (rc != 0) {
    return rc;
  }
  rc = check_fstrings();
  if (rc != 0) {
    return rc;
  }
  rc = check_qualified_names();
  if (rc != 0) {
    return rc;
  }
  rc = check_struct_patterns();
  if (rc != 0) {
    return rc;
  }

  return 0;
}

function check_operator_precedence(): i32 {
  let src: string = "let x = 1 + 2 * 3; let y = (1 + 2) * 3; return x + y;";
  let toks: lexer.Token[] = lexer.tokenize(src);
  let prog: ast.Stmt[] = parse_program(toks);
  if (prog.len() != 3) {
    return 1;
  }

  match (prog[0]) {
    ast.StmtVar(s0) => {
      if (s0.name != "x") {
        return 100;
      }
      match (s0.init) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 101;
          }
          match (b.right) {
            ast.ExprBinary(rb) => {
              if (rb.op != "*") {
                return 102;
              }
            },
            _ => {
              return 103;
            }
          }
          match (b.left) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 104;
              }
            },
            _ => {
              return 105;
            }
          }
        },
        _ => {
          return 106;
        }
      }
    },
    _ => {
      return 107;
    }
  }

  match (prog[1]) {
    ast.StmtVar(s1) => {
      if (s1.name != "y") {
        return 200;
      }
      match (s1.init) {
        ast.ExprBinary(b) => {
          if (b.op != "*") {
            return 201;
          }
          match (b.left) {
            ast.ExprBinary(lb) => {
              if (lb.op != "+") {
                return 202;
              }
            },
            _ => {
              return 203;
            }
          }
        },
        _ => {
          return 204;
        }
      }
    },
    _ => {
      return 205;
    }
  }

  match (prog[2]) {
    ast.StmtReturn(s2) => {
      match (s2.value) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 300;
          }
          match (b.left) {
            ast.ExprIdent(id) => {
              if (id.name != "x") {
                return 301;
              }
            },
            _ => {
              return 302;
            }
          }
          match (b.right) {
            ast.ExprIdent(id) => {
              if (id.name != "y") {
                return 303;
              }
            },
            _ => {
              return 304;
            }
          }
        },
        _ => {
          return 305;
        }
      }
    },
    _ => {
      return 306;
    }
  }

  return 0;
}

function check_if_and_while(): i32 {
  let src2: string = "if (x < 0) { let a = 1; } else { let b = 2; }";
  let prog2: ast.Stmt[] = parse_program(lexer.tokenize(src2));
  if (prog2.len() != 1) {
    return 400;
  }
  match (prog2[0]) {
    ast.StmtIf(ifs) => {
      match (ifs.cond) {
        ast.ExprBinary(b) => {
          if (b.op != "<") {
            return 401;
          }
        },
        _ => {
          return 402;
        }
      }
      if (ifs.then_body.len() != 1) {
        return 403;
      }
      if (ifs.else_body.len() != 1) {
        return 404;
      }
    },
    _ => {
      return 405;
    }
  }

  let src3: string = "if (true) { return 1; }";
  let prog3: ast.Stmt[] = parse_program(lexer.tokenize(src3));
  match (prog3[0]) {
    ast.StmtIf(ifs) => {
      if (ifs.else_body.len() != 0) {
        return 500;
      }
    },
    _ => {
      return 501;
    }
  }

  let src4: string = "while (i < 5) { i = i + 1; }";
  let prog4: ast.Stmt[] = parse_program(lexer.tokenize(src4));
  if (prog4.len() != 1) {
    return 600;
  }
  match (prog4[0]) {
    ast.StmtWhile(w) => {
      match (w.cond) {
        ast.ExprBinary(b) => {
          if (b.op != "<") {
            return 601;
          }
        },
        _ => {
          return 602;
        }
      }
      if (w.body.len() != 1) {
        return 603;
      }
      match (w.body[0]) {
        ast.StmtAssign(a) => {
          if (a.target != "i") {
            return 604;
          }
          match (a.value) {
            ast.ExprBinary(b) => {
              if (b.op != "+") {
                return 605;
              }
            },
            _ => {
              return 606;
            }
          }
        },
        _ => {
          return 607;
        }
      }
    },
    _ => {
      return 608;
    }
  }

  return 0;
}

function check_compound_assignment(): i32 {
  let srcC: string = "x += 1;";
  let progC: ast.Stmt[] = parse_program(lexer.tokenize(srcC));
  if (progC.len() != 1) {
    return 700;
  }
  match (progC[0]) {
    ast.StmtAssign(a) => {
      if (a.target != "x") {
        return 701;
      }
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 702;
          }
          match (b.left) {
            ast.ExprIdent(id) => {
              if (id.name != "x") {
                return 703;
              }
            },
            _ => {
              return 704;
            }
          }
          match (b.right) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 705;
              }
            },
            _ => {
              return 706;
            }
          }
        },
        _ => {
          return 707;
        }
      }
    },
    _ => {
      return 708;
    }
  }

  let srcD: string = "s *= 2;";
  match (parse_program(lexer.tokenize(srcD))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "*") {
            return 720;
          }
        },
        _ => {
          return 721;
        }
      }
    },
    _ => {
      return 722;
    }
  }

  let srcBwAnd: string = "m &= 6;";
  match (parse_program(lexer.tokenize(srcBwAnd))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "&") {
            return 730;
          }
        },
        _ => {
          return 731;
        }
      }
    },
    _ => {
      return 732;
    }
  }
  let srcBwShl: string = "f <<= 3;";
  match (parse_program(lexer.tokenize(srcBwShl))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "<<") {
            return 733;
          }
        },
        _ => {
          return 734;
        }
      }
    },
    _ => {
      return 735;
    }
  }

  return 0;
}

function check_slice_expressions(): i32 {
  let srcS: string = "let t = s[1:4]; return 0;";
  let progS: ast.Stmt[] = parse_program(lexer.tokenize(srcS));
  match (progS[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprSlice(sl) => {
          match (sl.start) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 650;
              }
            },
            _ => {
              return 651;
            }
          }
          match (sl.end) {
            ast.ExprNumber(n) => {
              if (n.text != "4") {
                return 652;
              }
            },
            _ => {
              return 653;
            }
          }
        },
        _ => {
          return 654;
        }
      }
    },
    _ => {
      return 655;
    }
  }

  let srcOS: string = "let t = s[1:]; return 0;";
  let progOS: ast.Stmt[] = parse_program(lexer.tokenize(srcOS));
  match (progOS[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprSlice(sl) => {
          if (!sl.open_end) {
            return 658;
          }
          match (sl.start) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 656;
              }
            },
            _ => {
              return 657;
            }
          }
          match (sl.array) {
            ast.ExprIdent(id) => {
              if (id.name != "s") {
                return 660;
              }
            },
            _ => {
              return 661;
            }
          }
          match (sl.end) {
            ast.ExprCall(_) => {
              return 663;
            },
            _ => {}
          }
        },
        _ => {
          return 664;
        }
      }
    },
    _ => {
      return 665;
    }
  }

  return 0;
}

function check_module_functions(): i32 {
  let src5: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
  let mod: Module = parse_module(lexer.tokenize(src5));
  if (mod.funcs.len() != 2) {
    return 700;
  }
  if (mod.top_stmts.len() != 0) {
    return 701;
  }
  if (mod.funcs[0].name != "add") {
    return 702;
  }
  if (mod.funcs[0].params.len() != 2) {
    return 703;
  }
  if (mod.funcs[0].params[0].name != "x") {
    return 704;
  }
  if (mod.funcs[0].params[0].type_name != "i32") {
    return 705;
  }
  if (mod.funcs[0].ret_type != "i32") {
    return 706;
  }
  if (mod.funcs[0].body.len() != 1) {
    return 707;
  }
  if (mod.funcs[1].name != "main") {
    return 708;
  }
  if (mod.funcs[1].params.len() != 0) {
    return 709;
  }
  if (mod.funcs[1].ret_type != "i32") {
    return 710;
  }

  return 0;
}

function check_struct_declarations(): i32 {
  let srcSt: string = "struct Point { x: i32, y: i32 } struct Empty { } function main(): i32 { return 0; }";
  let modSt: Module = parse_module(lexer.tokenize(srcSt));
  if (modSt.structs.len() != 2) {
    return 720;
  }
  if (modSt.structs[0].name != "Point") {
    return 721;
  }
  if (modSt.structs[0].fields.len() != 2) {
    return 722;
  }
  if (modSt.structs[0].fields[0].name != "x") {
    return 723;
  }
  if (modSt.structs[0].fields[0].type_name != "i32") {
    return 724;
  }
  if (modSt.structs[0].fields[1].name != "y") {
    return 725;
  }
  if (modSt.structs[1].name != "Empty") {
    return 726;
  }
  if (modSt.structs[1].fields.len() != 0) {
    return 727;
  }
  if (modSt.funcs.len() != 1) {
    return 728;
  }
  if (modSt.funcs[0].name != "main") {
    return 729;
  }

  let srcTc: string = "struct Tc { a: i32, b: i32, } function main(): i32 { return 0; }";
  let modTc: Module = parse_module(lexer.tokenize(srcTc));
  if (modTc.structs.len() != 1) {
    return 730;
  }
  if (modTc.structs[0].fields.len() != 2) {
    return 731;
  }
  if (modTc.structs[0].fields[1].name != "b") {
    return 732;
  }

  return 0;
}

function check_struct_literals(): i32 {
  let srcL: string = "let p = Point { x: 3, y: 4 }; return 0;";
  let progL: ast.Stmt[] = parse_program(lexer.tokenize(srcL));
  match (progL[0]) {
    ast.StmtVar(v) => {
      if (v.name != "p") {
        return 800;
      }
      match (v.init) {
        ast.ExprStructLit(sl) => {
          if (sl.type_name != "Point") {
            return 801;
          }
          if (sl.field_names.len() != 2) {
            return 802;
          }
