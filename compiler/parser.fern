              for ck in 0..cs1.len() {
                cstmts = cstmts.append(cs1[ck]);
              }
              cstmts = cstmts.append(s_if(e_binary("!=", e_ident(cn), e_number("0", "", false)), [s_return(e_ident(cn))], emptyb));
            }
            cstmts = cstmts.append(s_return(e_number("0", "", false)));
            ibody = cstmts;
          } else {
            ibody = [s_return(e_number("0", "", false))];
          }
        }
      }
      inner = inner.append(ast.MatchArm { pattern: p_variant_n(vj.name, "__o", obn), body: ibody, line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    }
    arms = arms.append(ast.MatchArm { pattern: p_variant_n(vi.name, "__s", vi.fields.len()), body: [s_match(e_ident("other"), inner)], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
  }
  let body: ast.Stmt[] = [s_match(e_ident("self"), arms), s_return(e_number("0", "", false))];
  let notp: string[] = [];
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: "other", type_name: self_ty, own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 }];
  return FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "cmp", receiver_name: "self", receiver_type: ename, receiver_own: false, type_params: notp, params: params, ret_own: false, ret_type: "i32", body: body, line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Ord", dyn_traits: [], streams: [], is_unsafe: false };
}

