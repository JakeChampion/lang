pub function fromjson_container(t: string): string {
  if (t.len() > 2 && slice_unchecked(t, t.len() - 2, t.len()) == "[]") {
    return "array";
  }
  if (t.len() > 8 && slice_unchecked(t, 0, 7) == "Option[" && t[t.len() - 1] == b']') {
    return "option";
  }
  return "";
}

pub function fromjson_elem(t: string): string {
  let c: string = fromjson_container(t);
  if (c == "array") {
    return slice_unchecked(t, 0, t.len() - 2) + "";
  }
  if (c == "option") {
    return slice_unchecked(t, 7, t.len() - 1) + "";
  }
  return t;
}

