function synth_enum_json(ename: string, variants: StructDecl[]): FuncDecl {
  let arms: ast.MatchArm[] = [];
  for i in 0..variants.len() {
    let v = variants[i];
    if (v.fields.len() > 0) {
      let e = e_binary("+", e_string("{\"" + v.name + "\":"), enum_json_payloads(v));
      e = e_binary("+", e, e_string("}"));
      arms = arms.append(ast.MatchArm { pattern: p_variant_n(v.name, "__p", v.fields.len()), body: [s_return(e)], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    } else {
      arms = arms.append(ast.MatchArm { pattern: p_variant(v.name, ""), body: [s_return(e_string("\"" + v.name + "\""))], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    }
  }
  let body: ast.Stmt[] = [s_match(e_ident("self"), arms), s_return(e_string(""))];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "to_json", receiver_name: "self", receiver_type: ename, receiver_own: false, type_params: notp, params: noparams, ret_own: false, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Json", dyn_traits: [], streams: [], is_unsafe: false };
}

function enum_json_payloads(v: StructDecl): ast.Expr {
  let named = v.variant_field_names.len() == v.fields.len();
  let open = "[";
  let close = "]";
  if (named) {
    open = "{";
    close = "}";
  } else if (v.fields.len() == 1) {
    open = "";
    close = "";
  }
  let e = e_string(open);
  for pj in 0..v.fields.len() {
    let sep = "";
    if (pj > 0) {
      sep = ",";
    }
    if (named) {
      sep = sep + "\"" + v.variant_field_names[pj] + "\":";
    }
    e = e_binary("+", e, e_string(sep));
    e = e_binary("+", e, dv_call0(e_ident("__p" + dl_itoa(pj)), "to_json"));
  }
  return e_binary("+", e, e_string(close));
}

function enum_default_derivable(variants: StructDecl[]): boolean {
  if (variants.len() == 0) {
    return false;
  }
  let v0 = variants[0];
  for i in 0..v0.fields.len() {
    if (!dv_default_derivable(v0.fields[i].type_name)) {
      return false;
    }
  }
  return true;
}

function synth_enum_default(ename: string, type_params: string[], variants: StructDecl[]): FuncDecl {
  let v0 = variants[0];
  let value = e_ident(v0.name);
  if (v0.fields.len() > 0) {
    let args: ast.Expr[] = [];
    for i in 0..v0.fields.len() {
      args = args.append(dv_default_expr(v0.fields[i].type_name));
    }
    value = e_call(e_ident(v0.name), args);
  }
  let body: ast.Stmt[] = [s_return(value)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "default", receiver_name: "", receiver_type: ename, receiver_own: false, type_params: notp, params: noparams, ret_own: false, ret_type: applied_type(ename, type_params), body: body, line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Default", dyn_traits: [], streams: [], is_unsafe: false };
}

function synth_enum_derives(ename: string, type_params: string[], declared: StructDecl[], derives: string[], funcs: FuncDecl[], json_alias: string): FuncDecl[] {
  let variants: StructDecl[] = [];
  for vd in declared {
    variants = variants.append(erase_view_struct(vd));
  }
  for di in 0..derives.len() {
    let kind = derive_simple_name(derives[di]);
    if (kind == "Display") {
      funcs = funcs.append(synth_enum_display(ename, variants));
    }
    if (kind == "Debug") {
      funcs = funcs.append(synth_enum_debug(ename, variants));
    }
    if (kind == "Eq") {
      funcs = funcs.append(synth_enum_eq(ename, applied_type(ename, type_params), variants));
    }
    if (kind == "Ord") {
      funcs = funcs.append(synth_enum_ord(ename, applied_type(ename, type_params), variants));
    }
    if (kind == "Hash") {
      funcs = funcs.append(synth_enum_hash(ename, variants));
    }
    funcs = synth_enum_json_derive(kind, ename, type_params, variants, funcs, json_alias);
    if (kind == "Default") {
      if (enum_default_derivable(declared)) {
        funcs = funcs.append(synth_enum_default(ename, type_params, variants));
      }
    }
  }
  return funcs;
}

function synth_enum_json_derive(kind: string, ename: string, type_params: string[], variants: StructDecl[], funcs: FuncDecl[], json_alias: string): FuncDecl[] {
  if (kind == "Json") {
    return funcs.append(synth_enum_json(ename, variants));
  }
  if (kind == "FromJson" && json_alias.len() > 0) {
    let self_ty = applied_type(ename, type_params);
    return funcs.append(synth_enum_from_json_value(json_alias, ename, self_ty, variants)).append(synth_from_json_text(json_alias, ename, self_ty));
  }
  return funcs;
}

function dv_is_scalar(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u8" || t == "u16" || t == "i16" || t == "u32" || t == "u64"
    || t == "f32" || t == "f64" || t == "boolean" || t == "string";
}

function dv_default_derivable(t: string): boolean {
  if (dv_is_scalar(t)) {
    return true;
  }
  if (t.len() == 0 || t == "str") {
    return false;
  }
  for i in 0..t.len() {
    let c = t[i] as i32;
    if (c == 91 || c == 93 || c == 40 || c == 41 || c == 44 || c == 32) {
      return false;
    }
  }
  return true;
}

function dv_default_expr(t: string): ast.Expr {
  if (t == "string") {
    return e_string("");
  }
  if (t == "boolean") {
    return e_bool(false);
  }
  if (t == "f32" || t == "f64") {
    return e_number("0.0", t, true);
  }
  if (dv_is_scalar(t)) {
    return e_number("0", t, false);
  }
  let noargs: ast.Expr[] = [];
  return e_call(e_field_access(e_ident(t), "default"), noargs);
}

function dv_eq_expr(ty: string, lhs: ast.Expr, rhs: ast.Expr): ast.Expr {
  if (dv_is_scalar(ty)) {
    return e_binary("==", lhs, rhs);
  }
  return dv_call1(lhs, "eq", rhs);
}

function dv_cmp_stmts(vn: string, ty: string, lhs: ast.Expr, rhs: ast.Expr): ast.Stmt[] {
  if (dv_is_num_scalar(ty) || ty == "string") {
    let neg1 = e_binary("-", e_number("0", "", false), e_number("1", "", false));
    let out: ast.Stmt[] = [s_var(vn, "i32", e_number("0", "", false))];
    out = out.append(s_if(e_binary("<", lhs, rhs), [s_assign(vn, neg1)], []));
    out = out.append(s_if(e_binary(">", lhs, rhs), [s_assign(vn, e_number("1", "", false))], []));
    return out;
  }
  return [s_var(vn, "i32", dv_call1(lhs, "cmp", rhs))];
}

function dv_hash_stmts(hv: string, ty: string, recv: ast.Expr, sfx: string): ast.Stmt[] {
  let mul = e_binary("*", e_ident(hv), e_number("31", "", false));
  if (ty == "string") {
    let iv = "__hsi" + sfx;
    let body: ast.Stmt[] = [s_assign(hv, e_binary(
      "+",
      e_binary("*", e_ident(hv), e_number("31", "", false)),
      e_cast("i32", e_index(recv, e_ident(iv), 0, 0)),
    ))];
    body = body.append(s_assign(iv, e_binary("+", e_ident(iv), e_number("1", "", false))));
    let out: ast.Stmt[] = [s_assign(hv, mul)];
    out = out.append(s_var(iv, "i32", e_number("0", "", false)));
    out = out.append(s_while(e_binary("<", e_ident(iv), dv_call0(recv, "len")), body));
    return out;
  }
  if (ty == "boolean") {
    let t: ast.Stmt[] = [s_assign(hv, e_binary("+", e_ident(hv), e_number("1", "", false)))];
    return [s_assign(hv, mul), s_if(recv, t, [])];
  }
  if (dv_is_num_scalar(ty)) {
    let v = recv;
    if (ty != "i32") {
      v = e_cast("i32", recv);
    }
    return [s_assign(hv, e_binary("+", mul, v))];
  }
  return [s_assign(hv, e_binary("+", mul, dv_call0(recv, "hash")))];
}

function dv_is_num_scalar(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u32" || t == "u64"
    || t == "f32" || t == "f64";
}

function dv_num_identity_expr(t: string, one: boolean): ast.Expr {
  if (t == "f32" || t == "f64") {
    if (one) {
      return e_number("1.0", t, true);
    }
    return e_number("0.0", t, true);
  }
  if (one) {
    return e_number("1", t, false);
  }
  return e_number("0", t, false);
}

function struct_default_derivable(sd: StructDecl): boolean {
  for i in 0..sd.fields.len() {
    if (!dv_default_derivable(sd.fields[i].type_name)) {
      return false;
    }
  }
  return true;
}

function synth_struct_default(sd: StructDecl): FuncDecl {
  let fnames: string[] = [];
  let fvals: ast.Expr[] = [];
  for i in 0..sd.fields.len() {
    fnames = fnames.append(sd.fields[i].name);
    fvals = fvals.append(dv_default_expr(sd.fields[i].type_name));
  }
  let lit = e_struct_lit(sd.name, fnames, [], [], fvals, 0, 0);
  let body: ast.Stmt[] = [s_return(lit)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "default", receiver_name: "", receiver_type: sd.name, receiver_own: false, type_params: notp, params: noparams, ret_own: false, ret_type: derived_self_type(sd), body: body, line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Default", dyn_traits: [], streams: [], is_unsafe: false };
}

// The size in bytes of a field type in a C struct, which is also its
// alignment, or 0 when the type has no C form.
pub function clayout_width(t: string): i32 {
  if (t == "u8") {
    return 1;
  }
  if (t == "i32" || t == "u32" || t == "f32") {
    return 4;
  }
  if (t == "i64" || t == "u64" || t == "usize" || t == "f64") {
    return 8;
  }
  return 0;
}

function clayout_round(n: i32, align: i32): i32 {
  return (n + align - 1) / align * align;
}

// The C offset of each field of `sd`, and then the size of the struct. The
// size rounds up to the largest alignment of a field.
pub function clayout_offsets(sd: StructDecl): i32[] {
  let out: i32[] = [];
  let off = 0;
  let align = 1;
  for f in sd.fields {
    let w = clayout_width(f.type_name);
    off = clayout_round(off, w);
    out = out.append(off);
    off += w;
    align = align.max(w);
  }
  return out.append(clayout_round(off, align));
}

pub function struct_clayout_derivable(sd: StructDecl): boolean {
  if (sd.type_params.len() > 0) {
    return false;
  }
  for f in sd.fields {
    if (clayout_width(f.type_name) == 0) {
      return false;
    }
  }
  return true;
}

function cl_addr(off: i32): ast.Expr {
  if (off == 0) {
    return e_ident("p");
  }
  return e_binary("+", e_ident("p"), e_number(dl_itoa(off), "usize", false));
}

function cl_call(name: string, args: ast.Expr[]): ast.Expr {
  return e_call(e_ident(name), args);
}

// The value of type `t` at the address `addr`.
function cl_load(t: string, addr: ast.Expr): ast.Expr {
  return match (t) {
    "u8" => e_cast("u8", cl_call("__load_u8", [addr])),
    "i32" => cl_call("__load_i32", [addr]),
    "u32" => e_cast("u32", cl_call("__load_i32", [addr])),
    "f32" => cl_call("f32_from_bits", [cl_call("__load_i32", [addr])]),
    "i64" => cl_call("__load_i64", [addr]),
    "u64" => e_cast("u64", cl_call("__load_i64", [addr])),
    "f64" => cl_call("f64_from_bits", [cl_call("__load_i64", [addr])]),
    _ => cl_call("__load_ptr", [addr]),
  };
}

// The statement that writes `v` of type `t` at the address `addr`.
function cl_store(t: string, addr: ast.Expr, v: ast.Expr): ast.Stmt {
  if (t == "u8" || t == "u32") {
    let name = "__store_i32";
    if (t == "u8") {
      name = "__store_u8";
    }
    return s_expr(cl_call(name, [addr, e_cast("i32", v)]));
  }
  if (t == "i32") {
    return s_expr(cl_call("__store_i32", [addr, v]));
  }
  if (t == "f32") {
    return s_expr(cl_call("__store_i32", [addr, cl_call("f32_bits", [v])]));
  }
  if (t == "i64") {
    return s_expr(cl_call("__store_i64", [addr, v]));
  }
  if (t == "u64") {
    return s_expr(cl_call("__store_i64", [addr, e_cast("i64", v)]));
  }
  if (t == "f64") {
    return s_expr(cl_call("__store_i64", [addr, cl_call("f64_bits", [v])]));
  }
  return s_expr(cl_call("__store_ptr", [addr, v]));
}

function cl_param(name: string, type_name: string): ast.ParamDecl {
  return ast.ParamDecl { name: name, type_name: type_name, own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 };
}

function cl_func(sd: StructDecl, name: string, receiver: string, params: ast.ParamDecl[], ret: string, body: ast.Stmt[], unsafe_body: boolean, impl_trait: string): FuncDecl {
  let stmts = body;
  if (unsafe_body) {
    stmts = [s_if_tagged(body, "unsafe")];
  }
  let notp: string[] = [];
  return FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: name, receiver_name: receiver, receiver_type: sd.name, receiver_own: false, type_params: notp, params: params, ret_own: false, ret_type: ret, body: stmts, line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: impl_trait, dyn_traits: [], streams: [], is_unsafe: unsafe_body };
}

// The functions of @derive(CLayout): `c_size`, the unsafe `c_load` and
// `c_store` of the whole struct, and for each field F its `c_offset_F` and an
// unsafe `c_load_F` and `c_store_F`.
function synth_struct_clayout(sd: StructDecl, funcs: FuncDecl[]): FuncDecl[] {
  let offs = clayout_offsets(sd);
  let noparams: ast.ParamDecl[] = [];
  let size = e_number(dl_itoa(offs[sd.fields.len()]), "usize", false);
  funcs = funcs.append(cl_func(sd, "c_size", "", noparams, "usize", [s_return(size)], false, "CLayout"));
  let fnames: string[] = [];
  let fvals: ast.Expr[] = [];
  let stores: ast.Stmt[] = [];
  for i in 0..sd.fields.len() {
    let f = sd.fields[i];
    fnames = fnames.append(f.name);
    fvals = fvals.append(cl_load(f.type_name, cl_addr(offs[i])));
    stores = stores.append(cl_store(f.type_name, cl_addr(offs[i]), dv_self_field(f.name)));
    funcs = funcs.append(cl_func(sd, "c_offset_" + f.name, "", noparams, "usize", [s_return(e_number(dl_itoa(offs[i]), "usize", false))], false, ""));
    funcs = funcs.append(cl_func(sd, "c_load_" + f.name, "", [cl_param("p", "usize")], f.type_name, [s_return(cl_load(f.type_name, cl_addr(offs[i])))], true, ""));
    funcs = funcs.append(cl_func(sd, "c_store_" + f.name, "", [cl_param("p", "usize"), cl_param("v", f.type_name)], "void", [cl_store(f.type_name, cl_addr(offs[i]), e_ident("v"))], true, ""));
  }
  let lit = e_struct_lit(sd.name, fnames, [], [], fvals, 0, 0);
  funcs = funcs.append(cl_func(sd, "c_load", "", [cl_param("p", "usize")], sd.name, [s_return(lit)], true, "CLayout"));
  return funcs.append(cl_func(sd, "c_store", "self", [cl_param("p", "usize")], "void", stores, true, "CLayout"));
}

function synth_derives(declared: StructDecl, derives: string[], funcs: FuncDecl[], json_alias: string): FuncDecl[] {
  let sd = erase_view_struct(declared);
  for di in 0..derives.len() {
    let kind = derive_simple_name(derives[di]);
    if (kind == "Display") {
      funcs = funcs.append(synth_struct_display(sd));
    }
    if (kind == "Debug") {
      funcs = funcs.append(synth_struct_debug(sd));
    }
    if (kind == "Eq") {
      funcs = funcs.append(synth_struct_eq(sd));
    }
    if (kind == "Ord") {
      funcs = funcs.append(synth_struct_ord(sd));
    }
    if (kind == "Hash") {
      funcs = funcs.append(synth_struct_hash(sd));
    }
    if (kind == "Json") {
      funcs = funcs.append(synth_struct_json(sd));
    }
    if (kind == "FromJson" && json_alias.len() > 0) {
      funcs = funcs.append(synth_from_json_value(json_alias, sd));
      funcs = funcs.append(synth_from_json_text(json_alias, sd.name, derived_self_type(sd)));
    }
    if (kind == "Default") {
      if (struct_default_derivable(declared)) {
        funcs = funcs.append(synth_struct_default(sd));
      }
    }
    if (kind == "CLayout" && struct_clayout_derivable(declared)) {
      funcs = synth_struct_clayout(declared, funcs);
    }
  }
  return funcs;
}

// std_json_alias returns the qualifier for std/json, or an empty string.
function std_json_alias(imports: Import[]): string {
  for im in imports {
    if (im.path == "std/json") {
      if (im.alias.len() > 0) {
        return im.alias;
      }
      return "json";
    }
  }
  return "";
}

struct DeclAttr { name: string, derives: string[], iface: string, wit: string, weak: boolean }

// The export binding of an @export or @jni attribute on `f`.
function with_attr_export(exports: ExportBinding[], attr: DeclAttr, f: FuncDecl): ExportBinding[] {
  if (!util.has_str(["export", "jni"], attr.name)) {
    return exports;
  }
  return exports.append(ExportBinding { func_name: f.name, iface: attr.iface, wit: attr.wit, c_abi: false, method: f.receiver_name.len() > 0, jni: attr.name == "jni" });
}

function no_decl_attr(): DeclAttr {
  return DeclAttr { name: "", derives: [], iface: "", wit: "", weak: false };
}

pub function inherent_impl_message(typ: string): string {
  return "`impl " + typ + "` needs a trait, as in `impl cmp.Eq for " + typ + "`; declare a method as `function (self: " + typ + ") name(…)` and a constructor as a plain function";
}

function expected_here(p: Par, what: string): ast.Stmt[] {
  return [decl_sentinel(p, "expected " + what + ", got " + tok_desc(p.peek()))];
}

// The attributes before a declaration, in source order.
function parse_decl_attrs(p: Par): (DeclAttr[], ast.Stmt[], Par) {
  let attrs: DeclAttr[] = [];
  while (p.peek_punct() == "@") {
    let at = p;
    let (da, da_bad, da_p) = parse_decl_attr(p);
    if (da_bad.len() > 0) {
      return (attrs, da_bad, da_p);
    }
    let clash = attr_conflict(attrs, da);
    if (clash.len() > 0) {
      return (attrs, [decl_sentinel(at, clash)], da_p);
    }
    attrs = attrs.append(da);
    p = da_p;
  }
  return (attrs, [], p);
}

// Sets of attributes. Two attributes of one set cannot apply to one declaration together.
function attr_conflict_groups(): string[][] {
  return [["import", "export", "jni", "callback"], ["inline", "noinline"], ["value", "must_consume"], ["norc", "interrupt", "early", "secondary"]];
}

// The P001 message when the attribute `next_attr` cannot follow `attrs`, or an empty string.
function attr_conflict(attrs: DeclAttr[], next_attr: DeclAttr): string {
  let next = next_attr.name;
  let marked: string[] = [];
  if (next == "must_consume") {
    marked = decl_attr_named(attrs, "derive").derives;
  } else if (next == "derive" && has_decl_attr(attrs, "must_consume")) {
    marked = next_attr.derives;
  }
  for d in marked {
    if (derived_method_reads_value(d)) {
      return "@must_consume and @derive(" + d + ") cannot apply to one declaration, because the derived method reads a value that it does not consume";
    }
  }
  for a in attrs {
    if (a.name == next) {
      return "@" + next + " appears twice on one declaration";
    }
    for group in attr_conflict_groups() {
      if (util.has_str(group, a.name) && util.has_str(group, next)) {
        return "@" + a.name + " and @" + next + " cannot apply to one declaration";
      }
    }
  }
  return "";
}

// Whether the derive `d` makes a method that takes a value of the type without `own`.
function derived_method_reads_value(d: string): boolean {
  let kind = derive_simple_name(d);
  return kind != "Default" && kind != "FromJson";
}

// The attribute `name` among `attrs`, or no attribute.
function decl_attr_named(attrs: DeclAttr[], name: string): DeclAttr {
  for a in attrs {
    if (a.name == name) {
      return a;
    }
  }
  return no_decl_attr();
}

function has_decl_attr(attrs: DeclAttr[], name: string): boolean {
  return decl_attr_named(attrs, name).name.len() > 0;
}

// The first attribute of `attrs` that does not apply to a declaration of `kind`, or an empty string.
function first_misfit(attrs: DeclAttr[], kind: string): string {
  for a in attrs {
    if (!attr_fits(a.name, kind)) {
      return a.name;
    }
  }
  return "";
}

function parse_decl_attr(p: Par): (DeclAttr, ast.Stmt[], Par) {
  let at = p;
  p = p.advance();
  let name = p.peek_ident();
  if (p.peek_keyword() == "import") {
    name = "import";
  }
  if (name.len() == 0) {
    return (no_decl_attr(), expected_here(p, "a name"), p);
  }
  p = p.advance();
  if (name == "derive") {
    return parse_derive_args(p);
  }
  if (util.has_str(["import", "export", "jni", "callback"], name)) {
    return parse_binding_args(name, p);
  }
  if (name == "provide" || name == "interrupt") {
    return parse_string_arg(name, "", p);
  }
  if (name == "value" || name == "secret" || name == "must_consume" || name == "try" || name == "inline" || name == "noinline" || name == "norc" || name == "early" || name == "secondary") {
    return (DeclAttr { ...no_decl_attr(), name: name }, [], p);
  }
  return (no_decl_attr(), [decl_sentinel(at, "unknown attribute @" + name + " (only @derive, @import, @export, @jni, @callback, @provide, @norc, @interrupt, @early, @secondary, @must_consume, @value, @secret, @try, @inline, and @noinline are supported)")], p);
}

function parse_binding_args(name: string, p: Par): (DeclAttr, ast.Stmt[], Par) {
  if (name == "callback") {
    return parse_string_arg("callback", CALLBACK_IFACE, p);
  }
  return parse_wit_pair(name, p);
}

// The one string argument of @callback("f"), the function whose C entry address
// the declaration returns, or of @provide("log"), the capability.
function parse_string_arg(name: string, iface: string, p: Par): (DeclAttr, ast.Stmt[], Par) {
  if (p.peek_punct() != "(") {
    return (no_decl_attr(), expected_here(p, "\"(\""), p);
  }
  p = p.advance();
  let target = "";
  match (p.peek()) {
    lexer.TokString(s) => {
      target = s.value;
    },
    _ => {
      return (no_decl_attr(), expected_here(p, "a string literal"), p);
    }
  }
  p = p.advance();
  if (p.peek_punct() != ")") {
    return (no_decl_attr(), expected_here(p, "\")\""), p);
  }
  return (DeclAttr { ...no_decl_attr(), name: name, iface: iface, wit: target }, [], p.advance());
}

function parse_derive_args(p: Par): (DeclAttr, ast.Stmt[], Par) {
  if (p.peek_punct() != "(") {
    return (no_decl_attr(), expected_here(p, "\"(\""), p);
  }
  p = p.advance();
  let derives: string[] = [];
  while (true) {
    let tn = p.peek_ident();
    if (tn.len() == 0) {
      return (no_decl_attr(), expected_here(p, "a name"), p);
    }
    p = p.advance();
    if (p.peek_punct() == ".") {
      p = p.advance();
      let seg = p.peek_ident();
      if (seg.len() > 0) {
        tn = tn + "." + seg;
        p = p.advance();
      }
    }
    derives = derives.append(tn);
    if (p.peek_punct() != ",") {
      break;
    }
    p = p.advance();
  }
  if (p.peek_punct() != ")") {
    return (no_decl_attr(), expected_here(p, "\")\""), p);
  }
  return (DeclAttr { ...no_decl_attr(), name: "derive", derives: derives }, [], p.advance());
}

function parse_wit_pair(name: string, p: Par): (DeclAttr, ast.Stmt[], Par) {
  if (p.peek_punct() != "(") {
    return (no_decl_attr(), expected_here(p, "\"(\""), p);
  }
  p = p.advance();
  let parts: string[] = [];
  while (parts.len() < 2) {
    match (p.peek()) {
      lexer.TokString(s) => {
        parts = parts.append(s.value);
        p = p.advance();
      },
      _ => {
        return (no_decl_attr(), expected_here(p, "a string literal"), p);
      }
    }
    if (parts.len() < 2) {
      if (p.peek_punct() != ",") {
        return (no_decl_attr(), expected_here(p, "\",\""), p);
      }
      p = p.advance();
    }
  }
  let attr = DeclAttr { ...no_decl_attr(), name: name, iface: parts[0], wit: parts[1] };
  if (name == "import" && p.peek_punct() == ",") {
    return parse_weak_arg(attr, p.advance());
  }
  if (p.peek_punct() != ")") {
    return (no_decl_attr(), expected_here(p, "\")\""), p);
  }
  return (attr, [], p.advance());
}

// The `weak` argument of @import(library, symbol, weak): the symbol binds
// weak, so a library loads where the symbol is absent, and calls it only
// where it is present. A WIT import has no weak form.
function parse_weak_arg(attr: DeclAttr, p: Par): (DeclAttr, ast.Stmt[], Par) {
  if (p.peek_ident() != "weak") {
    return (no_decl_attr(), expected_here(p, "\"weak\""), p);
  }
  if (attr.iface.contains(":")) {
    return (no_decl_attr(), [decl_sentinel(p, "@import(..., weak) applies to a C library; the WIT interface " + attr.iface + " has no weak import")], p);
  }
  p = p.advance();
  if (p.peek_punct() != ")") {
    return (no_decl_attr(), expected_here(p, "\")\""), p);
  }
  return (DeclAttr { ...attr, weak: true }, [], p.advance());
}

function attr_fits(name: string, kind: string): boolean {
  if (name == "value" || name == "secret") {
    return kind == "struct";
  }
  if (name.len() == 0) {
    return true;
  }
  if (name == "derive" || name == "must_consume") {
    return kind == "struct" || kind == "enum";
  }
  if (name == "try") {
    return kind == "enum";
  }
  if (name == "import") {
    return kind == "function" || kind == "resource";
  }
  return kind == "function";
}

function attr_misplaced(name: string): string {
  if (name == "value" || name == "secret") {
    return "@" + name + " only applies to a `struct` declaration";
  }
  if (name == "derive" || name == "must_consume") {
    return "@" + name + " only applies to a `struct` or `enum` declaration";
  }
  if (name == "try") {
    return "@try only applies to an `enum` declaration";
  }
  if (name == "import") {
    return "@import only applies to a function or resource declaration";
  }
  if (name == "export") {
    return "@export only applies to a function declaration";
  }
  if (name == "jni") {
    return "@jni only applies to a function declaration";
  }
  if (name == "callback") {
    return "@callback only applies to a function declaration";
  }
  if (name == "provide") {
    return "@provide only applies to a function declaration";
  }
  if (name == "norc" || name == "interrupt" || name == "early" || name == "secondary") {
    return "@" + name + " only applies to a function declaration";
  }
  return "@inline / @noinline only applies to a function declaration";
}

function pub_errors(pub_at: Par, p: Par): ast.Stmt[] {
  if (p.peek_punct() == "(") {
    let q = p.advance();
    if (q.peek_ident() == "package") {
      return expected_here(q.advance(), "\")\"");
    }
    return [decl_sentinel(pub_at, "`pub(...)` only supports `pub(package)`")];
  }
  if (unsafe_function_head(p) || util.has_str(["function", "struct", "enum", "type", "trait", "const", "use"], p.peek_keyword()) || util.has_str(["opaque", "fip", "fbip", "async"], p.peek_ident())) {
    return [];
  }
  return [decl_sentinel(pub_at, "`pub` must be followed by `function`, `struct`, `enum`, `type`, `trait`, `const`, `opaque`, `fip`, `fbip`, or `async`")];
}

function skip_failed_decl(p: Par, start: i32): Par {
  let q = sync_to_top_level(p);
  if (q.pos == start) {
    return q.advance();
  }
  return q;
}

function parse_resource_decl_name(p: Par): (string, Par) {
  p = p.advance();
  let name = p.peek_ident();
  if (name.len() > 0) {
    p = p.advance();
  }
  if (p.peek_punct() == ";") {
    p = p.advance();
  }
  return (name, p);
}

function parse_impl_decl(p: Par): (FuncDecl[], string, string, string[], string[], string[], string, ImplDecl, ast.Stmt[], Par) {
  let out: FuncDecl[] = [];
  let impl_bad: ast.Stmt[] = [];
  let method_names: string[] = [];
  let iline = p.peek_line();
  let icol = p.peek_col();
  p = p.advance();
  let (impl_tpl, impl_tp_p) = parse_type_param_list(p);
  p = impl_tp_p;
  let impl_tps: string[] = [];
  let impl_tbs: string[] = [];
  for itpi in 0..impl_tpl.tnames.len() {
    if (impl_tpl.tbounds[itpi].len() > 0 && !is_const_bound(impl_tpl.tbounds[itpi])) {
      impl_tps = impl_tps.append(impl_tpl.tnames[itpi]);
      impl_tbs = impl_tbs.append(impl_tpl.tbounds[itpi]);
    }
  }
  let first_spelling = "";
  if (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "." && p.peek_ident_at(2).len() > 0) {
    first_spelling = p.peek_ident() + p.peek_punct_at(1) + p.peek_ident_at(2);
  }
  let first_is_kw = p.peek_ident().len() == 0 && p.peek_keyword().len() > 0;
  let first_at = p;
  let (tnr_name, tnr_fn_ret, tnr_p) = parse_type_name(p);
  p = tnr_p;
  let first_name = tnr_name;
  let trait_spelling = "";
  let trait_name = "";
  let impl_type = "";
  if (p.peek_keyword() == "for") {
    if (first_is_kw) {
      impl_bad = impl_bad.append(decl_sentinel(first_at, "malformed impl: its trait name could not be read (a keyword such as `use`, `type` or `match` cannot be a name)"));
    }
    p = p.advance();
    trait_name = first_name;
    trait_spelling = first_spelling;
    let (ity_name, ity_fn_ret, ity_p) = parse_type_name(p);
    p = ity_p;
    impl_type = ity_name;
  } else {
    impl_bad = impl_bad.append(decl_sentinel(first_at, inherent_impl_message(first_name)));
    impl_type = first_name;
  }
  if (p.peek_punct() == "{") {
    p = p.advance();
  }
  let assoc_names: string[] = [];
  let assoc_values: string[] = [];
  while (!p.at_end()) {
    if (p.peek_punct() == "}") {
      break;
    }
    let kw = p.peek_keyword();
    if (kw == "pub") {
      p = p.advance();
      kw = p.peek_keyword();
    }
    if (kw == "type") {
      p = p.advance();
      let ab_name = p.peek_ident();
      if (ab_name.len() > 0) {
        p = p.advance();
      } else {
        impl_bad = impl_bad.append(decl_sentinel(p, "malformed associated type binding: its name could not be read (a keyword such as `type` or `match` cannot be a name)"));
      }
      p = p.expect("=");
      let (ab_ty, ab_fnret, ab_p) = parse_type_name(p);
      p = ab_p;
      p = p.expect_semi();
      if (ab_name.len() > 0) {
        assoc_names = assoc_names.append(ab_name);
        assoc_values = assoc_values.append(subst_self(ab_ty, impl_type));
      }
      continue;
    }
    if (kw == "const") {
      let (ic_func, ic_p) = parse_assoc_const_decl(p, true);
      p = ic_p;
      if (p.verbatim) {
        out = out.append(ic_func);
      } else {
        out = out.append(finalize_impl_method(ic_func, impl_type, impl_tps, impl_tbs));
      }
      method_names = method_names.append(ic_func.name);
      continue;
    }
    let hint = "";
    if (p.peek_punct() == "@") {
      let (ma, ma_bad, ma_p) = parse_decl_attr(p);
      p = ma_p;
      hint = ma.name;
      if (ma_bad.len() == 0 && hint != "inline" && hint != "noinline") {
        ma_bad = [decl_sentinel(p, "an impl method takes only @inline or @noinline")];
      }
      if (ma_bad.len() > 0) {
        impl_bad = util.append_all(impl_bad, ma_bad);
        hint = "";
      }
    }
    if (!function_head(p)) {
      impl_bad = impl_bad.append(decl_sentinel(p, "unexpected token in an impl body: expected `function`, `type` or `const`"));
      p = skip_body_item(p.advance());
      continue;
    }
    let name_at = p.advance();
    let (fr_func0, fr_p) = parse_func_decl(p);
    let fr_func = FuncDecl { ...fr_func0, always_inline: hint == "inline", no_inline: hint == "noinline" };
    p = fr_p;
    if (fr_func.receiver_name.len() == 0) {
      p = refuse_const_tparams(p, name_at, TpList { tnames: fr_func.type_params, tbounds: fr_func.bound_traits });
    }
    if (fr_func.name.len() == 0) {
      p = skip_body_item(p);
    }
    let m = fr_func;
    if (p.verbatim) {
      out = out.append(m);
    } else {
      out = out.append(finalize_impl_method(m, impl_type, impl_tps, impl_tbs));
    }
    method_names = method_names.append(m.name);
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (out, derive_simple_name(strip_struct_base(trait_name)), impl_type, impl_tps, impl_tbs, method_names, trait_spelling, ImplDecl { trait_ref: trait_name, type_ref: impl_type, type_params: impl_tpl.tnames, bounds: impl_tpl.tbounds, methods: out, line: iline, col: icol, assoc_names: assoc_names, assoc_values: assoc_values }, impl_bad, p);
}

pub function ident_byte(b: i32): boolean {
  return b >= 97 && b <= 122 || b >= 65 && b <= 90 || b >= 48 && b <= 57 || b == 95;
}

function is_builtin_generic_base(b: string): boolean {
  return b == "Option" || b == "Result" || b == "Map";
}

function enclosing_bracket_base(ty: string, pos: i32): string {
  let bal = 0;
  let i = pos - 1;
  while (i >= 0) {
    let c = ty[i];
    if (c == b']') {
      bal += 1;
    } else if (c == b'[') {
      if (bal == 0) {
        let st = i;
        while (st > 0 && ident_byte(ty[st - 1] as i32)) {
          st -= 1;
        }
        return slice_unchecked(ty, st, i).to_owned();
      }
      bal -= 1;
    }
    i -= 1;
  }
  return "";
}

function feeds_user_parametric(ty: string, name: string): boolean {
  let i = 0;
  let nl = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && util.str_eq_at(ty, i, name)) {
      let prev_ok = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok = true;
      if (i + nl < ty.len() && ident_byte(ty[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        let b = enclosing_bracket_base(ty, i);
        if (b.len() > 0 && !is_builtin_generic_base(b)) {
          return true;
        }
      }
    }
    i += 1;
  }
  return false;
}

function feeds_map_typearg(ty: string, name: string): boolean {
  let i = 0;
  let nl = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && util.str_eq_at(ty, i, name)) {
      let prev_ok = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok = true;
      if (i + nl < ty.len() && ident_byte(ty[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        if (enclosing_bracket_base(ty, i) == "Map") {
          return true;
        }
      }
    }
    i += 1;
  }
  return false;
}

function feeds_wide_container(ty: string, name: string): boolean {
  let i = 0;
  let nl = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && util.str_eq_at(ty, i, name)) {
      let prev_ok = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let nxt = i + nl;
      let next_ok = true;
      if (nxt < ty.len() && ident_byte(ty[nxt] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        if (nxt + 1 < ty.len() && ty[nxt] == b'[' && ty[nxt + 1] == b']') {
          return true;
        }
        let b = enclosing_bracket_base(ty, i);
        if (b == "Option" || b == "Result") {
          return true;
        }
      }
    }
    i += 1;
  }
  return false;
}

function all_bare_scalar_bound(params: ast.ParamDecl[], tps: string[]): boolean {
  for i in 0..tps.len() {
    if (!has_bare_scalar_param(params, tps[i])) {
      return false;
    }
  }
  return tps.len() > 0;
}

function ret_mentions_any(ret_type: string, tps: string[]): boolean {
  for i in 0..tps.len() {
    if (type_mentions_var(ret_type, tps[i])) {
      return true;
    }
  }
  return false;
}

pub function type_mentions_var(ty: string, name: string): boolean {
  let i = 0;
  let nl = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && util.str_eq_at(ty, i, name)) {
      let prev_ok = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let nxt = i + nl;
      let next_ok = true;
      if (nxt < ty.len() && ident_byte(ty[nxt] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        return true;
      }
    }
    i += 1;
  }
  return false;
}

function has_bare_array_param(params: ast.ParamDecl[], name: string): boolean {
  for i in 0..params.len() {
    if (params[i].type_name == name + "[]" || params[i].type_name == "[" + name + "]") {
      return true;
    }
  }
  return false;
}

function body_binds_bare_var(stmts: ast.Stmt[], params: ast.ParamDecl[], tps: string[], bounded: string[]): boolean {
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (util.index_of_str(tps, v.type_name) >= 0 && util.index_of_str(bounded, v.type_name) < 0) {
          return true;
        }
      },
      ast.StmtAssign(a) => {
        for pi in 0..params.len() {
          if (params[pi].name == a.target && util.index_of_str(tps, params[pi].type_name) >= 0
            && util.index_of_str(bounded, params[pi].type_name) < 0) {
            return true;
          }
        }
      },
      ast.StmtIf(f) => {
        if (body_binds_bare_var(f.then_body, params, tps, bounded)) {
          return true;
        }
        if (body_binds_bare_var(f.else_body, params, tps, bounded)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_binds_bare_var(w.body, params, tps, bounded)) {
          return true;
        }
      },
      ast.StmtFor(fr) => {
        if (body_binds_bare_var(fr.body, params, tps, bounded)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (body_binds_bare_var(arm.body, params, tps, bounded)) {
            return true;
          }
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        if (body_binds_bare_var(one, params, tps, bounded)) {
          return true;
        }
      },
      _ => {}
    }
  }
  return false;
}

function erased_only(tps: string[], bounded: string[]): string[] {
  let out: string[] = [];
  for t in tps {
    if (util.index_of_str(bounded, t) < 0) {
      out = out.append(t);
    }
  }
  return out;
}

struct ParScan { vars: string[], hit: boolean }

function body_feeds_user_parametric(stmts: ast.Stmt[], vars: string[]): boolean {
  if (vars.len() == 0) {
    return false;
  }
  let scan = ParScan { vars: vars, hit: false };
  for st in stmts {
    scan = astwalk.fold_stmt_nodes(st, scan, par_scan_stmt, par_scan_expr, astwalk.descend_all);
  }
  return scan.hit;
}

function spelled_feeds(t: string, vars: string[]): boolean {
  for v in vars {
    if (feeds_user_parametric(t, v)) {
      return true;
    }
  }
  return false;
}

function par_scan_stmt(st: ast.Stmt, own acc: ParScan): ParScan {
  if (acc.hit) {
    return acc;
  }
  if let ast.StmtVar(v) = st {
    if (spelled_feeds(v.type_name, acc.vars) || spelled_feeds(v.fn_ret, acc.vars) || spelled_feeds(v.fn_param_types, acc.vars)) {
      return ParScan { ...acc, hit: true };
    }
  }
  return acc;
}

function par_scan_expr(e: ast.Expr, own acc: ParScan): ParScan {
  if (acc.hit) {
    return acc;
  }
  let hit = false;
  match (e) {
    ast.ExprStructLit(sl) => {
      hit = spelled_feeds(sl.type_name, acc.vars) || spelled_feeds(sl.written, acc.vars);
    },
    ast.ExprZero(z) => {
      hit = spelled_feeds(z.type_name, acc.vars);
    },
    ast.ExprCall(c) => {
      for t in c.type_args {
        if (spelled_feeds(t, acc.vars)) {
          hit = true;
        }
      }
    },
    ast.ExprLambda(lm) => {
      hit = spelled_feeds(lm.ret_type, acc.vars) || spelled_feeds(lm.ret_fn_ret, acc.vars) || spelled_feeds(lm.ret_fn_param_types, acc.vars);
      for lp in lm.params {
        if (spelled_feeds(lp.type_name, acc.vars) || spelled_feeds(lp.fn_ret, acc.vars) || spelled_feeds(lp.fn_param_types, acc.vars)) {
          hit = true;
        }
      }
    },
    _ => {}
  }
  if (hit) {
    return ParScan { ...acc, hit: true };
  }
  return acc;
}

function all_fn_param_bound(params: ast.ParamDecl[], tps: string[]): boolean {
  for i in 0..tps.len() {
    if (!has_fn_param_arg_var(params, tps[i]) && !has_fn_param_ret_var(params, tps[i])) {
      return false;
    }
  }
  return tps.len() > 0;
}

pub function feeds_specialized_type(ty: string, name: string): boolean {
  return feeds_user_parametric(ty, name) || feeds_map_typearg(ty, name);
}

pub function fn_param_feeds_nominal(params: ast.ParamDecl[], name: string): boolean {
  for pd in params {
    if (is_fn_contract_tag(pd.type_name)
      && (feeds_specialized_type(pd.fn_ret, name) || feeds_specialized_type(pd.fn_param_types, name))) {
      return true;
    }
  }
  return false;
}

pub function has_fn_param_ret_var(params: ast.ParamDecl[], name: string): boolean {
  for i in 0..params.len() {
    if (is_fn_contract_tag(params[i].type_name) && type_mentions_var(params[i].fn_ret, name)) {
      return true;
    }
  }
  return false;
}

pub function has_fn_param_arg_var(params: ast.ParamDecl[], name: string): boolean {
  for i in 0..params.len() {
    if (is_fn_contract_tag(params[i].type_name) && params[i].fn_param_types.len() > 0) {
      for seg in split_top_commas(params[i].fn_param_types) {
        if (token_at_paren_depth0(seg.trim(), name)) {
          return true;
        }
      }
    }
  }
  return false;
}

function has_bare_scalar_param(params: ast.ParamDecl[], name: string): boolean {
  for i in 0..params.len() {
    if (params[i].type_name == name) {
      return true;
    }
  }
  return false;
}

function has_any_bare_scalar_param(params: ast.ParamDecl[], tps: string[]): boolean {
  for i in 0..tps.len() {
    if (has_bare_scalar_param(params, tps[i])) {
      return true;
    }
  }
  return false;
}

function result_two_bare_vars(ret_type: string, unbounded_tps: string[]): boolean {
  if (unbounded_tps.len() != 2) {
    return false;
  }
  let n = ret_type.len();
  if (n < 9 || !ret_type.starts_with("Result[") || ret_type[n - 1] != b']') {
    return false;
  }
  let inner = slice_unchecked(ret_type, 7, n - 1).to_owned();
  let depth = 0;
  let ci: i32 = -1;
  let i = 0;
  while (i < inner.len() && ci < 0) {
    let c = inner[i];
    if (c == b'[') {
      depth += 1;
    } else if (c == b']') {
      depth -= 1;
    } else if (c == b',' && depth == 0) {
      ci = i;
    }
    i += 1;
  }
  if (ci < 0) {
    return false;
  }
  let a = slice_unchecked(inner, 0, ci).to_owned().trim();
  let b = slice_unchecked(inner, ci + 1, inner.len()).to_owned().trim();
  let t0 = unbounded_tps[0];
  let t1 = unbounded_tps[1];
  return a == t0 && b == t1 || a == t1 && b == t0;
}

pub function token_at_paren_depth0(ty: string, name: string): boolean {
  let pdepth = 0;
  let i = 0;
  let nl = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    let c = ty[i] as i32;
    if (c == 40) {
      pdepth += 1;
      i += 1;
      continue;
    }
    if (c == 41) {
      pdepth -= 1;
      i += 1;
      continue;
    }
    if (pdepth == 0 && i + nl <= ty.len() && util.str_eq_at(ty, i, name)) {
      let prev_ok = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok = true;
      if (i + nl < ty.len() && ident_byte(ty[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        return true;
      }
    }
    i += 1;
  }
  return false;
}

pub function token_in_tuple_param(ty: string, name: string): boolean {
  if (name.len() == 0) {
    return false;
  }
  let t = ty;
  while (type_ends_arr(t)) {
    t = slice_unchecked(t, 0, t.len() - 2).to_owned();
  }
  if (t.len() < 2 || !t.starts_with("(") || !t.ends_with(")")) {
    return false;
  }
  let inner = slice_unchecked(t, 1, t.len() - 1);
  let i = 0;
  let nl = name.len();
  while (i < inner.len()) {
    if (i + nl <= inner.len() && util.str_eq_at(inner, i, name)) {
      let prev_ok = true;
      if (i > 0 && ident_byte(inner[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok = true;
      if (i + nl < inner.len() && ident_byte(inner[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        return true;
      }
    }
    i += 1;
  }
  return false;
}

pub function subst_self(ty: string, impl_type: string): string {
  if (ty.len() == 0) {
    return ty;
  }
  let out = "";
  let run = 0;
  let i = 0;
  while (i < ty.len()) {
    if (i + 4 <= ty.len() && util.str_eq_at(ty, i, "Self")) {
      let prev_ok = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok = true;
      if (i + 4 < ty.len() && ident_byte(ty[i + 4] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        out = out + slice_unchecked(ty, run, i) + impl_type;
        i += 4;
        run = i;
        continue;
      }
    }
    i += 1;
  }
  return out + slice_unchecked(ty, run, ty.len());
}

function renamed_list(xs: string[], from: string[], to: string[]): string[] {
  let out: string[] = [];
  for x in xs {
    let at = util.index_of_str(from, x);
    if (at >= 0) {
      out = out.append(to[at]);
    } else {
      out = out.append(x);
    }
  }
  return out;
}

// tparam_consts is the names in tpl that are const parameters.
function tparam_consts(tpl: TpList): string[] {
  let out: string[] = [];
  for i in 0..tpl.tnames.len() {
    if (is_const_bound(tpl.tbounds[i])) {
      out = out.append(tpl.tnames[i]);
    }
  }
  return out;
}

// trait_const_reads puts in each read of a trait's const parameter the
// impl's argument for it: the integer of `impl Fixed[8] for B`, or the name
// of `impl[const M: i32] Fixed[M] for Ring[M, i32]`.
function trait_const_reads(m: FuncDecl, body: ast.Stmt[], consts: string[], trait_params: string[], args: string[]): ast.Stmt[] {
  let vars: string[] = [];
  let cts: string[] = [];
  for i in 0..trait_params.len() {
    if (i < args.len() && util.has_str(consts, trait_params[i]) && args[i] != trait_params[i]) {
      vars = vars.append(trait_params[i]);
      cts = cts.append(args[i]);
    }
  }
  if (vars.len() == 0) {
    return body;
  }
  let values = astwalk.append_bound_name([], m.receiver_name);
  for pd in m.params {
    values = astwalk.append_bound_name(values, pd.name);
  }
  return tv_obj_body(body, TvScope { vars: vars, cts: cts, values: values, lits: true });
}

pub function inherit_default(m: FuncDecl, trait_params: string[], trait_consts: string[], im: ImplInfo): FuncDecl {
  let args = type_args_of(im.trait_ref);
  let from: string[] = [];
  let to: string[] = [];
  for v in m.all_type_params {
    let fresh = v;
    let n = 1;
    while (util.has_str(im.all_type_params, fresh) || util.has_str(args, fresh) || fresh != v && util.has_str(m.all_type_params, fresh)) {
      fresh = v + util.i32_to_string(n);
      n += 1;
    }
    if (fresh != v) {
      from = from.append(v);
      to = to.append(fresh);
    }
  }
  if (args.len() == trait_params.len()) {
    from = util.append_all(from, trait_params);
    to = util.append_all(to, args);
  }
  from = from.append("Self");
  to = to.append(im.impl_type);
  let params: ast.ParamDecl[] = [];
  for pd in m.params {
    params = params.append(ast.ParamDecl { ...pd, type_name: subst_ty(pd.type_name, from, to), fn_ret: subst_ty(pd.fn_ret, from, to), fn_param_types: subst_ty_list(pd.fn_param_types, from, to) });
  }
  let sub = FuncDecl { ...m, type_params: renamed_list(m.type_params, from, to), all_type_params: renamed_list(m.all_type_params, from, to), params: params, ret_type: subst_ty(m.ret_type, from, to), ret_fn_ret: subst_ty(m.ret_fn_ret, from, to), ret_fn_param_types: subst_ty_list(m.ret_fn_param_types, from, to), body: trait_const_reads(m, subst_stmts(m.body, from, to), trait_consts, trait_params, args) };
  let modules: string[] = [];
  for i in 0..m.type_params.len() {
    let module = m.module;
    if (i < m.bound_modules.len()) {
      module = m.bound_modules[i];
    }
    modules = modules.append(module);
  }
  for tp in im.type_params {
    modules = modules.append(im.module);
  }
  return FuncDecl { ...finalize_impl_method(sub, im.impl_type, im.type_params, im.bounds), bound_modules: modules };
}

function finalize_impl_method(m0: FuncDecl, impl_type: string, impl_tps: string[], impl_tbs: string[]): FuncDecl {
  let m = FuncDecl { ...m0, body: subst_stmts(m0.body, ["Self"], [impl_type]) };
  let rt = subst_self(m.ret_type, impl_type);
  let mtps = m.type_params;
  let mtbs = m.bound_traits;
  while (mtbs.len() < m.type_params.len()) {
    mtbs = mtbs.append("");
  }
  for ti in 0..impl_tps.len() {
    mtps = mtps.append(impl_tps[ti]);
    mtbs = mtbs.append(impl_tbs[ti]);
  }
  let has_self = false;
  if (m.params.len() > 0) {
    if (m.params[0].name == "self" && m.params[0].type_name.len() > 0) {
      has_self = true;
    }
  }
  if (!has_self) {
    let aparams: ast.ParamDecl[] = [];
    for ai in 0..m.params.len() {
      let apt = m.params[ai].type_name;
      apt = subst_self(apt, impl_type);
      aparams = aparams.append(ast.ParamDecl { ...m.params[ai], type_name: apt });
    }
    return FuncDecl { ...m, receiver_name: "", receiver_type: impl_type, type_params: mtps, bound_traits: mtbs, params: aparams, ret_type: rt };
  }
  let rname = "self";
  let newparams: ast.ParamDecl[] = [];
  for i in 0..m.params.len() {
    if (i == 0) {
      rname = m.params[i].name;
    } else {
      let pt = m.params[i].type_name;
      pt = subst_self(pt, impl_type);
      newparams = newparams.append(ast.ParamDecl { ...m.params[i], type_name: pt });
    }
  }
  return FuncDecl { ...m, receiver_name: rname, receiver_type: impl_type, receiver_own: m.params[0].own, type_params: mtps, bound_traits: mtbs, params: newparams, ret_type: rt };
}

function required_own_tps(bad: ast.Stmt[], at: Par, fd: FuncDecl): ast.Stmt[] {
  if (fd.body.len() == 0 && fd.all_type_params.len() > 0) {
    return bad.append(decl_sentinel(at, "trait method \"" + fd.name + "\" declares its own type parameters, so it must have a default body"));
  }
  return bad;
}

function trait_parent_path_end(p: Par): Par {
  let out = p.advance();
  while (out.peek_punct() == "." && out.peek_ident_at(1).len() > 0) {
    out = out.advance().advance();
  }
  return out;
}

function parse_trait_decl(p: Par): (TraitDefault[], TraitReq, TraitDecl, ast.Stmt[], Par) {
  let defaults: TraitDefault[] = [];
  let trait_bad: ast.Stmt[] = [];
  let required: string[] = [];
  let required_sigs: FuncDecl[] = [];
  let assoc_sigs: FuncDecl[] = [];
  let provided: string[] = [];
  let default_sigs: FuncDecl[] = [];
  let supertraits: string[] = [];
  let decl_methods: FuncDecl[] = [];
  let decl_supers: string[] = [];
  let assoc_types: string[] = [];
  let tline = p.peek_line();
  let tcol = p.peek_col();
  p = p.advance();
  let tname = p.peek_ident();
  if (tname.len() > 0) {
    p = p.advance();
  }
  let simple = derive_simple_name(tname);
  // Trait parameters bind arguments in requirements and inherited methods.
  let (trait_tps, trait_tp_p) = parse_type_param_list(p);
  p = trait_tp_p;
  let trait_consts = tparam_consts(trait_tps);
  // Parent names retain qualifiers and type arguments.
  if (p.peek_punct() == ":") {
    p = p.advance();
    let go_sup = true;
    while (go_sup && !p.at_end()) {
      let parent_at = p;
      let parent_ident = p.peek_ident().len() > 0;
      let parent_path = trait_parent_path_end(p);
      if (parent_path.peek_punct() == "::") {
        p = parent_path;
        break;
      }
      let (sup_name, sup_ret, sup_end) = parse_type_name(p);
      let parent_ref = parse_type_ref(sup_name);
      if (!parent_ident || parent_ref.array_depth > 0 || parent_ref.is_tuple || parent_ref.is_fn || parent_ref.is_view) {
        trait_bad = trait_bad.append(decl_sentinel(parent_at, "expected a trait name with optional type arguments"));
        p = sup_end;
        break;
      }
      if (sup_end.pos == p.pos) {
        p = p.expected_type();
        break;
      }
      p = sup_end;
      supertraits = supertraits.append(sup_name);
      decl_supers = decl_supers.append(sup_name);
      if (p.peek_punct() == "+") {
        p = p.advance();
      } else {
        go_sup = false;
      }
    }
  }
  if (p.peek_punct() != "{") {
    trait_bad = trait_bad.append(decl_sentinel(p, "expected \"{\", got " + tok_desc(p.peek())));
    while (!p.at_end() && p.peek_punct() != "{" && !at_top_level_decl(p)) {
      p = p.advance();
    }
  }
  if (p.peek_punct() == "{") {
    p = p.advance();
    while (!p.at_end()) {
      if (p.peek_punct() == "}") {
        break;
      }
      if (p.peek_keyword() == "type") {
        p = p.advance();
        let at_name = p.peek_ident();
        if (at_name.len() > 0) {
          p = p.advance();
          assoc_types = assoc_types.append(at_name);
        } else {
          trait_bad = trait_bad.append(decl_sentinel(p, "malformed associated type declaration: its name could not be read (a keyword such as `type` or `match` cannot be a name)"));
        }
        p = p.expect_semi();
        continue;
      }
      if (p.peek_keyword() == "const") {
        let (ac_func, ac_p) = parse_assoc_const_decl(p, false);
        p = ac_p;
        decl_methods = decl_methods.append(ac_func);
        provided = provided.append(ac_func.name);
        assoc_sigs = assoc_sigs.append(ac_func);
        if (ac_func.body.len() > 0) {
          defaults = defaults.append(TraitDefault { trait_name: simple, trait_params: trait_tps.tnames, trait_consts: trait_consts, method: ac_func });
          default_sigs = default_sigs.append(FuncDecl { ...ac_func, body: [] });
        } else {
          required = required.append(ac_func.name);
          required_sigs = required_sigs.append(ac_func);
        }
        continue;
      }
      if (function_head(p)) {
        let fn_at = p;
        let (fr_func, fr_p) = parse_func_decl(p);
        p = fr_p;
        trait_bad = required_own_tps(trait_bad, fn_at, fr_func);
        if (fr_func.name.len() == 0) {
          p = skip_body_item(p);
          continue;
        }
        let method_body: ast.Stmt[] = [];
        for st in fr_func.body {
          if let ast.StmtUnknown(u) = st {
            if (u.fault.mark == DECL_FAULT) {
              trait_bad = trait_bad.append(st);
              continue;
            }
          }
          method_body = method_body.append(st);
        }
        fr_func = FuncDecl { ...fr_func, body: method_body };
        decl_methods = decl_methods.append(fr_func);
        provided = provided.append(fr_func.name);
        if (fr_func.params.len() == 0 || fr_func.params[0].name != "self") {
          assoc_sigs = assoc_sigs.append(fr_func);
        }
        if (fr_func.body.len() > 0) {
          defaults = defaults.append(TraitDefault { trait_name: simple, trait_params: trait_tps.tnames, trait_consts: trait_consts, method: fr_func });
          default_sigs = default_sigs.append(FuncDecl { ...fr_func, body: [] });
        } else {
          required = required.append(fr_func.name);
          required_sigs = required_sigs.append(fr_func);
        }
      } else {
        trait_bad = trait_bad.append(decl_sentinel(p, "unexpected token in a trait body: expected `function`, `type` or `const`"));
        p = skip_body_item(p.advance());
      }
    }
    if (p.peek_punct() == "}") {
      p = p.advance();
    }
  }
  return (defaults, TraitReq { trait_name: simple, type_params: trait_tps.tnames, methods: required, req_sigs: required_sigs, supertraits: supertraits, assoc_sigs: assoc_sigs, provided: provided, assoc_types: assoc_types, module: "", default_sigs: default_sigs, visible_from: [] }, TraitDecl { name: tname, type_params: trait_tps.tnames, const_params: trait_consts, supertraits: decl_supers, methods: decl_methods, line: tline, col: tcol, is_pub: false, assoc_types: assoc_types, is_package: false }, trait_bad, p);
}

function skip_decl_modifier(p: Par, name: string, before: string): Par {
  if (p.peek_ident() != name) {
    return p;
  }
  let probe = p.advance();
  if (probe.peek_keyword() != before && !(before == "function" && function_head(probe))) {
    return p;
  }
  return probe;
}

pub function is_float_type_name(t: string): boolean {
  return t == "f64" || t == "f32";
}

pub function is_lanes_type_name(t: string): boolean {
  return typeinfo.lanes_width(t) > 0;
}

// The names of the types that a 64-bit integer slot holds. A Socket is one:
// its descriptor number, and above it the close count of that number.
pub function is_wide_int_type_name(t: string): boolean {
  return t == "i64" || t == "u64" || t == "Socket";
}

pub function float_settled_int(n: ast.ExprNumber): boolean {
  return n.is_float && n.suffix.len() == 0 && util.index_of_sub(n.text, ".") < 0
    && util.index_of_sub(n.text, "e") < 0 && util.index_of_sub(n.text, "E") < 0;
}

function settle_float_expr(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprCall(_) => {
      return settle_float_value_branches(e);
    },
    _ => {}
  }
  if (!ast.is_unsettled_int_literal(e)) {
    return e;
  }
  match (e) {
    ast.ExprNumber(n) => {
      return ast.ExprNumber { text: n.text, suffix: n.suffix, raw: n.raw, is_float: true, bits: literal_bits(n.text, true), line: n.line, col: n.col };
    },
    ast.ExprUnary(u) => {
      return ast.rebuild_unary(u, settle_float_expr(u.operand), u.line, u.col, u.ty);
    },
    ast.ExprBinary(b) => {
      return ast.binary(b.op, settle_float_expr(b.left), settle_float_expr(b.right), b.line, b.col, b.ty);
    },
    _ => {
      return e;
    }
  }
}

function settled_branch_value(body: ast.Stmt[]): (ast.Expr, boolean) {
  if (body.len() > 0) {
    match (body[body.len() - 1]) {
      ast.StmtReturn(r) => {
        return (r.value, true);
      },
      _ => {}
    }
  }
  return (ast.ExprUnknown { fault: ast.fault_mark("no-branch-value"), line: 0, col: 0 }, false);
}

function float_settleable(e: ast.Expr): boolean {
  if (ast.is_unsettled_int_literal(e)) {
    return true;
  }
  match (e) {
    ast.ExprNumber(n) => {
      return n.is_float;
    },
    ast.ExprUnary(u) => {
      if (u.op != "-" && u.op != "+") {
        return false;
      }
      return float_settleable(u.operand);
    },
    ast.ExprBinary(b) => {
      if (b.op != "+" && b.op != "-" && b.op != "*" && b.op != "/") {
        return false;
      }
      return float_settleable(b.left) && float_settleable(b.right);
    },
    ast.ExprCall(_) => {
      return value_branches_float_settleable(e);
    },
    _ => {
      return false;
    }
  }
}

function value_branches_float_settleable(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() != 0) {
        return false;
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() == 0 && lm.origin == ORIGIN_BLOCK) {
            let (tv, t_ok) = settled_branch_value(lm.body);
            return t_ok && float_settleable(tv);
          }
          if (lm.params.len() != 0 || lm.body.len() != 1) {
            return false;
          }
          match (lm.body[0]) {
            ast.StmtIf(f) => {
              return if_branches_float_settleable(f);
            },
            ast.StmtMatch(m) => {
              return match_arms_float_settleable(m);
            },
            _ => {
              return false;
            }
          }
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

function settle_branch_body(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for i in 0..body.len() {
    let keep = body[i];
    if (i == body.len() - 1) {
      match (body[i]) {
        ast.StmtReturn(r) => {
          keep = s_return_at(settle_float_expr(r.value), r.line, r.col);
        },
        _ => {}
      }
    }
    out = out.append(keep);
  }
  return out;
}

function if_branches_float_settleable(f: ast.StmtIf): boolean {
  let (tv, t_ok) = settled_branch_value(f.then_body);
  if (!t_ok || !float_settleable(tv)) {
    return false;
  }
  if (f.else_body.len() == 1) {
    match (f.else_body[0]) {
      ast.StmtIf(nf) => {
        return if_branches_float_settleable(nf);
      },
      _ => {}
    }
  }
  let (ev, e_ok) = settled_branch_value(f.else_body);
  return e_ok && float_settleable(ev);
}

function settle_if_branches(f: ast.StmtIf): ast.Stmt {
  let nelse: ast.Stmt[] = [];
  let chained = false;
  if (f.else_body.len() == 1) {
    match (f.else_body[0]) {
      ast.StmtIf(nf) => {
        nelse = nelse.append(settle_if_branches(nf));
        chained = true;
      },
      _ => {}
    }
  }
  if (!chained) {
    nelse = settle_branch_body(f.else_body);
  }
  return ast.StmtIf { ...f, then_body: settle_branch_body(f.then_body), else_body: nelse };
}

function match_arms_float_settleable(m: ast.StmtMatch): boolean {
  if (m.arms.len() == 0) {
    return false;
  }
  for a in 0..m.arms.len() {
    let (av, a_ok) = settled_branch_value(m.arms[a].body);
    if (!a_ok || !float_settleable(av)) {
      return false;
    }
  }
  return true;
}

function settle_match_arms(m: ast.StmtMatch): ast.Stmt {
  let arms: ast.MatchArm[] = [];
  for arm in m.arms {
    arms = arms.append(ast.MatchArm { ...arm, body: settle_branch_body(arm.body) });
  }
  return ast.StmtMatch { ...m, arms: arms };
}

function settle_float_value_branches(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprCall(c) => {
      if (!value_branches_float_settleable(e)) {
        return e;
      }
      if let ast.ExprLambda(lm) = c.callee {
        let nlam: ast.Expr = ast.ExprLambda { ...lm, body: settle_value_body(lm) };
        return ast.ExprCall { callee: nlam, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
      }
    },
    _ => {}
  }
  return e;
}

function settle_value_body(lm: ast.ExprLambda): ast.Stmt[] {
  if (lm.origin == ORIGIN_BLOCK) {
    return settle_branch_body(lm.body);
  }
  match (lm.body[0]) {
    ast.StmtIf(f) => {
      return [settle_if_branches(f)];
    },
    ast.StmtMatch(m) => {
      return [settle_match_arms(m)];
    },
    _ => {}
  }
  return lm.body;
}

function settle_to_type(e: ast.Expr, t: TypeRef): ast.Expr {
  if (t.array_depth > 0) {
    let inner = elem_type_ref(t);
    match (e) {
      ast.ExprArray(a) => {
        let els: ast.Expr[] = [];
        for ei in 0..a.elements.len() {
          els = els.append(settle_to_type(a.elements[ei], inner));
        }
        return ast.ExprArray { ...a, elements: els, elem_ty: render_type_ref(inner) };
      },
      _ => {
        return e;
      }
    }
  }
  if (t.is_tuple) {
    match (e) {
      ast.ExprTuple(tu) => {
        let tels: ast.Expr[] = [];
        for ti in 0..tu.elements.len() {
          if (ti < t.args.len()) {
            tels = tels.append(settle_to_type(tu.elements[ti], t.args[ti]));
          } else {
            tels = tels.append(tu.elements[ti]);
          }
        }
        return ast.ExprTuple { elements: tels, line: tu.line, col: tu.col };
      },
      _ => {
        return e;
      }
    }
  }
  if (is_float_type_name(t.base)) {
    return settle_float_expr(e);
  }
  return e;
}

pub function settle_to_name(e: ast.Expr, type_name: string): ast.Expr {
  if (type_name.len() == 0 || !settleable(e)) {
    return e;
  }
  return settle_to_type(e, parse_type_ref(type_name));
}

function settleable(e: ast.Expr): boolean {
  match (e) {
    ast.ExprArray(_) => {
      return true;
    },
    ast.ExprTuple(_) => {
      return true;
    },
    ast.ExprCall(c) => {
      if let ast.ExprLambda(_) = c.callee {
        return true;
      }
      return false;
    },
    _ => {}
  }
  return ast.is_unsettled_int_literal(e);
}

struct SettleFns {
  decls: FuncDecl[],
  head: i32[],
  next: i32[],
}

function settle_buckets(): i32 {
  return 4093;
}

function settle_fns_of(decls: FuncDecl[]): SettleFns {
  let head: i32[] = [];
  let b = 0;
  let nb = settle_buckets();
  while (b < nb) {
    head = head.append(-1);
    b += 1;
  }
  let next: i32[] = [];
  for j in 0..decls.len() {
    next = next.append(-1);
  }
  let k = decls.len() - 1;
  while (k >= 0) {
    let bk = util.hash_bucket(decls[k].name, nb);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    k -= 1;
  }
  return SettleFns { decls: decls, head: head, next: next };
}

function settle_param_type_names(f: FuncDecl): string[] {
  let out: string[] = [];
  for pi in 0..f.params.len() {
    out = out.append(f.params[pi].type_name);
  }
  return out;
}

function settle_param_types(fns: SettleFns, name: string): string[] {
  let i = fns.head[util.hash_bucket(name, settle_buckets())];
  while (i >= 0) {
    let f = fns.decls[i];
    if (f.name == name && f.receiver_name.len() == 0) {
      return settle_param_type_names(f);
    }
    i = fns.next[i];
  }
  return [];
}

function settle_method_param_types(fns: SettleFns, recv_type: string, name: string): string[] {
  if (recv_type.len() == 0) {
    return [];
  }
  let i = fns.head[util.hash_bucket(name, settle_buckets())];
  while (i >= 0) {
    let f = fns.decls[i];
    if (f.name == name && f.receiver_type == recv_type) {
      return settle_param_type_names(f);
    }
    i = fns.next[i];
  }
  return [];
}

struct SettleStructs { decls: StructDecl[], index: util.NameIndex }

function settle_structs_of(decls: StructDecl[]): SettleStructs {
  let names: string[] = [];
  for sd in decls {
    names = names.append(sd.name);
  }
  return SettleStructs { decls: decls, index: util.name_index(names) };
}

function settle_field_type(structs: SettleStructs, type_name: string, field: string): string {
  let i = structs.index.find(type_name);
  if (i < 0) {
    return "";
  }
  for fd in structs.decls[i].fields {
    if (fd.name == field) {
      return fd.type_name;
    }
  }
  return "";
}

struct SettleLocals { names: string[], types: string[], by_name: util.LastIndex }

function no_settle_locals(): SettleLocals {
  return SettleLocals { names: [], types: [], by_name: util.no_last_index() };
}

function (l: SettleLocals) bound(name: string, type_name: string): SettleLocals {
  let names = l.names.append(name);
  let by_name = l.by_name.with_last_of(names);
  return SettleLocals { ...l, names: names, types: l.types.append(type_name), by_name: by_name };
}

function settle_local_type(locals: SettleLocals, name: string): string {
  let i = locals.by_name.find(locals.names, name);
  if (i < 0) {
    return "";
  }
  return locals.types[i];
}

function settle_expr(e: ast.Expr, locals: SettleLocals, fns: SettleFns, structs: SettleStructs): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return ast.binary(b.op, settle_expr(b.left, locals, fns, structs), settle_expr(b.right, locals, fns, structs), b.line, b.col, b.ty);
    },
    ast.ExprUnary(u) => {
      return ast.rebuild_unary(u, settle_expr(u.operand, locals, fns, structs), u.line, u.col, u.ty);
    },
    ast.ExprCall(c) => {
      let ptypes: string[] = [];
      match (c.callee) {
        ast.ExprIdent(id) => {
          ptypes = settle_param_types(fns, id.name);
        },
        ast.ExprFieldAccess(mfa) => {
          match (mfa.obj) {
            ast.ExprIdent(rid) => {
              ptypes = settle_method_param_types(fns, settle_local_type(locals, rid.name), mfa.field);
            },
            _ => {
              ptypes = [];
            }
          }
        },
        _ => {
          ptypes = [];
        }
      }
      let args: ast.Expr[] = [];
      for ai in 0..c.args.len() {
        let arg = settle_expr(c.args[ai], locals, fns, structs);
        if (ai < ptypes.len()) {
          arg = settle_to_name(arg, ptypes[ai]);
        }
        args = args.append(arg);
      }
      return ast.ExprCall { callee: settle_expr(c.callee, locals, fns, structs), args: args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprArray(a) => {
      let els: ast.Expr[] = [];
      for i in 0..a.elements.len() {
        els = els.append(settle_expr(a.elements[i], locals, fns, structs));
      }
      return ast.ExprArray { ...a, elements: els };
    },
    ast.ExprTuple(t) => {
      let tels: ast.Expr[] = [];
      for ti in 0..t.elements.len() {
        tels = tels.append(settle_expr(t.elements[ti], locals, fns, structs));
      }
      return ast.ExprTuple { elements: tels, line: t.line, col: t.col };
    },
    ast.ExprIndex(x) => {
      return ast.ExprIndex { array: settle_expr(x.array, locals, fns, structs), index: settle_expr(x.index, locals, fns, structs), unchecked: x.unchecked, ty: x.ty, line: x.line, col: x.col };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, array: settle_expr(sl.array, locals, fns, structs), start: settle_expr(sl.start, locals, fns, structs), end: settle_expr(sl.end, locals, fns, structs) };
    },
    ast.ExprStructLit(sl) => {
      let vals: ast.Expr[] = [];
      for vi in 0..sl.field_values.len() {
        let v = settle_expr(sl.field_values[vi], locals, fns, structs);
        if (vi < sl.field_names.len()) {
          v = settle_to_name(v, settle_field_type(structs, sl.type_name, sl.field_names[vi]));
        }
        vals = vals.append(v);
      }
      let base = sl.base;
      if (sl.has_base) {
        base = settle_expr(sl.base, locals, fns, structs);
      }
      return ast.ExprStructLit { ...sl, field_values: vals, base: base };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, obj: settle_expr(fa.obj, locals, fns, structs) };
    },
    ast.ExprLambda(lm) => {
      let inner = locals;
      for lpi in 0..lm.params.len() {
        inner = inner.bound(lm.params[lpi].name, lm.params[lpi].type_name);
      }
      return ast.ExprLambda { ...lm, body: settle_block(lm.body, lm.ret_type, inner, fns, structs) };
    },
    _ => {
      return e;
    }
  }
}

function settle_stmt(st: ast.Stmt, ret_type: string, locals: SettleLocals, fns: SettleFns, structs: SettleStructs): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      let init = settle_to_name(settle_expr(v.init, locals, fns, structs), v.type_name);
      return ast.StmtVar { name: v.name, type_name: v.type_name, init: init, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types, destr: v.destr, header: v.header };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: settle_to_name(settle_expr(r.value, locals, fns, structs), ret_type), line: r.line, col: r.col };
    },
    ast.StmtAssign(a) => {
      let val = settle_to_name(settle_expr(a.value, locals, fns, structs), settle_local_type(locals, a.target));
      return ast.StmtAssign { ...a, value: val };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: settle_expr(x.value, locals, fns, structs) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: settle_expr(f.cond, locals, fns, structs), then_body: settle_block(f.then_body, ret_type, locals, fns, structs), else_body: settle_block(f.else_body, ret_type, locals, fns, structs) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: settle_expr(w.cond, locals, fns, structs), body: settle_block(w.body, ret_type, locals, fns, structs), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: settle_expr(fr.iter, locals, fns, structs), body: settle_block(fr.body, ret_type, locals, fns, structs), label: fr.label, line: fr.line, col: fr.col, destr: fr.destr };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      for ai in 0..m.arms.len() {
        let a = m.arms[ai];
        arms = arms.append(ast.MatchArm { ...a, body: settle_block(a.body, ret_type, locals, fns, structs) });
      }
      return ast.StmtMatch { ...m, scrutinee: settle_expr(m.scrutinee, locals, fns, structs), arms: arms };
    },
    ast.StmtDefer(dd) => {
      return ast.StmtDefer { action: settle_stmt(dd.action, ret_type, locals, fns, structs), on_error: dd.on_error, line: dd.line };
    },
    _ => {
      return st;
    }
  }
}

function settle_block(stmts: ast.Stmt[], ret_type: string, locals: SettleLocals, fns: SettleFns, structs: SettleStructs): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let known = locals;
  for i in 0..stmts.len() {
    out = out.append(settle_stmt(stmts[i], ret_type, known, fns, structs));
    match (stmts[i]) {
      ast.StmtVar(v) => {
        if (v.type_name.len() > 0) {
          known = known.bound(v.name, v.type_name);
        }
      },
      _ => {}
    }
  }
  return out;
}

pub function settle_module(mod: Module): Module {
  let fns = settle_fns_of(mod.funcs);
  let structs = settle_structs_of(mod.structs);
  let funcs: FuncDecl[] = [];
  for i in 0..mod.funcs.len() {
    let fd = mod.funcs[i];
    let locals = no_settle_locals();
    for pi in 0..fd.params.len() {
      locals = locals.bound(fd.params[pi].name, fd.params[pi].type_name);
    }
    if (fd.receiver_name.len() > 0) {
      locals = locals.bound(fd.receiver_name, fd.receiver_type);
    }
    funcs = funcs.append(FuncDecl { ...fd, body: settle_block(fd.body, fd.ret_type, locals, fns, structs) });
  }
  return Module { ...mod, funcs: funcs, top_stmts: settle_block(mod.top_stmts, "", no_settle_locals(), fns, structs) };
}

pub struct ConstTable { names: string[], values: ast.Expr[] }

pub function inferred_const_table(funcs: FuncDecl[], names: string[], t: ConstTable): ConstTable {
  let out = t;
  for fd in funcs {
    if (fd.is_const && util.has_str(names, fd.name) && fd.body.len() == 1) {
      if let ast.StmtReturn(r) = fd.body[0] {
        out = ConstTable { names: out.names.append(fd.name), values: out.values.append(astwalk.substitute_consts_expr(const_value(fd, r.value), out.names, out.values)) };
      }
    }
  }
  return out;
}

pub function substitute_const_refs(mod: Module, t: ConstTable): Module {
  if (t.names.len() == 0) {
    return mod;
  }
  let named = util.name_index(t.names);
  let funcs: FuncDecl[] = [];
  let none: string[] = [];
  let earlier = util.name_index(none);
  for fd in mod.funcs {
    if (fd.is_const) {
      let seen = const_table_within(t, earlier);
      funcs = funcs.append(FuncDecl { ...fd, body: astwalk.substitute_consts(fd.body, [], seen.names, seen.values) });
      earlier = earlier.added(fd.name);
      continue;
    }
    let bound: string[] = [];
    let params: ast.ParamDecl[] = [];
    for p in fd.params {
      params = params.append(ast.ParamDecl { ...p, default_value: astwalk.substitute_consts_expr(p.default_value, t.names, t.values) });
      bound = astwalk.append_bound_name(bound, p.name);
    }
    if (fd.receiver_name.len() > 0) {
      bound = bound.append(fd.receiver_name);
    }
    if (!astwalk.names_any(fd.body, named)) {
      funcs = funcs.append(FuncDecl { ...fd, params: params });
      continue;
    }
    funcs = funcs.append(FuncDecl { ...fd, params: params, body: astwalk.substitute_consts(fd.body, bound, t.names, t.values) });
  }
  return Module { ...mod, funcs: funcs, top_stmts: astwalk.substitute_consts(mod.top_stmts, [], t.names, t.values) };
}

pub function rewrite_assoc_const_reads(mod: Module): Module {
  let qualifiers: string[] = [];
  for imp in mod.imports {
    qualifiers = qualifiers.append(import_qualifier(imp));
  }
  let types: string[] = [];
  for prim in ["Self", "i32", "i64", "u8", "u32", "u64", "usize", "f32", "f64", "boolean", "string", "char"] {
    if (!util.has_str(qualifiers, prim)) {
      types = types.append(prim);
    }
  }
  for sd in mod.structs {
    types = types.append(sd.name);
  }
  let enums: string[] = [];
  for ed in mod.enums {
    types = types.append(ed.name);
    enums = enums.append(ed.name);
  }
  let enum_assoc: string[] = [];
  for im in mod.impls {
    let im_base = util.base_type_name(im.impl_type);
    if (util.has_str(enums, im_base)) {
      for mn in im.method_names {
        enum_assoc = enum_assoc.append(im_base + "." + mn);
      }
    }
  }
  let index = util.name_index(types);
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    let bound: string[] = [];
    for p in fd.params {
      bound = astwalk.append_bound_name(bound, p.name);
    }
    if (fd.receiver_name.len() > 0) {
      bound = bound.append(fd.receiver_name);
    }
    let fn_types = astwalk.TypeNames { index: index, params: util.append_all(fd.type_params, fd.all_type_params) };
    funcs = funcs.append(FuncDecl { ...fd, body: astwalk.rewrite_assoc_const_reads(fd.body, bound, fn_types, enums, enum_assoc) });
  }
  return Module { ...mod, funcs: funcs, top_stmts: astwalk.rewrite_assoc_const_reads(mod.top_stmts, [], astwalk.TypeNames { index: index, params: [] }, enums, enum_assoc) };
}

function const_table_within(t: ConstTable, names: util.NameIndex): ConstTable {
  let out = ConstTable { names: [], values: [] };
  let i = 0;
  for n in t.names {
    if (names.has(n)) {
      out = ConstTable { names: out.names.append(n), values: out.values.append(t.values[i]) };
    }
    i += 1;
  }
  return out;
}

// The consts whose uses become their value: each one without a type, and
// each one whose value is a literal of exactly its declared type.
function substituted_const_names(funcs: FuncDecl[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    if (fd.is_const && (fd.ret_type == "" || typed_literal_const(fd))) {
      out = out.append(fd.name);
    }
  }
  return out;
}

function typed_literal_const(fd: FuncDecl): boolean {
  if (fd.body.len() != 1) {
    return false;
  }
  let ast.StmtReturn(r) = fd.body[0] else {
    return false;
  };
  match (r.value) {
    ast.ExprNumber(n) => {
      return fd.ret_type == "i32" && n.suffix == "" && !n.is_float && !ast.is_unit_literal(n) && !is_quoted_literal(n);
    },
    ast.ExprBool(_) => {
      return fd.ret_type == "boolean";
    },
    ast.ExprString(_) => {
      return fd.ret_type == "string";
    },
    _ => {
      return false;
    }
  }
}

// A typed const's literal keeps its declared type at each use.
function const_value(fd: FuncDecl, value: ast.Expr): ast.Expr {
  if let ast.ExprNumber(n) = value {
    if (fd.ret_type == "i32" && n.suffix == "") {
      return ast.ExprNumber { ...n, suffix: "i32" };
    }
  }
  return value;
}

function settle_const_types(funcs: FuncDecl[], structs: StructDecl[], enums: EnumDecl[]): FuncDecl[] {
  let known: ast.ParamDecl[] = [];
  let out: FuncDecl[] = [];
  for fd in funcs {
    let f = fd;
    if (f.is_const && f.ret_type == "" && f.body.len() == 1) {
      if let ast.StmtReturn(r) = f.body[0] {
        f = FuncDecl { ...f, ret_type: irt_guess(r.value, known, funcs, structs, enums) };
      }
    }
    if (f.is_const && f.ret_type.len() > 0) {
      known = known.append(ast.ParamDecl { name: f.name, type_name: f.ret_type, own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 });
    }
    out = out.append(f);
  }
  return out;
}

pub function parse_module(toks: lexer.Token[]): Module {
  let (m, t, im, fl, ih) = parse_module_flagged(toks, false);
  return m;
}

pub function parse_module_verbatim(toks: lexer.Token[]): ParsedFmt {
  let (m, t, im, fl, ih) = parse_module_flagged(toks, true);
  return ParsedFmt { pmod: m, ptraits: t, pimpls: im, pflines: fl, pinline: ih, pspans: block_spans(toks) };
}

function field_lines(fields: StructFieldDecl[]): i32[] {
  let out: i32[] = [];
  for f in fields {
    out = out.append(f.line);
  }
  return out;
}

function record_field_lines(acc: FieldLines[], verbatim: boolean, name: string, decl_line: i32, lines: i32[]): FieldLines[] {
  if (!verbatim) {
    return acc;
  }
  return acc.append(FieldLines { name: name, decl_line: decl_line, lines: lines });
}

function parse_module_flagged(toks: lexer.Token[], verbatim: boolean): (Module, TraitDecl[], ImplDecl[], FieldLines[], FunctionInlineHint[]) {
  if let Some(le) = stream_lex_error(toks) {
    return lex_error_module(le);
  }
  let p = Par { toks: toks, pos: 0, no_struct: false, map_kind: -1, structnames: scan_struct_names(toks), constnames: scan_const_names(toks), verbatim: verbatim, depth: 0, type_errs: [], todos: [], tail_at: [], tail_is: [], strict_semi: false, closers: closers(toks) };
  let funcs: FuncDecl[] = [];
  let trait_defaults: TraitDefault[] = [];
  let trait_reqs: TraitReq[] = [];
  let impl_infos: ImplInfo[] = [];
  let structs: StructDecl[] = [];
  let aliases: TypeAlias[] = [];
  let imports: Import[] = [];
  let top_stmts: ast.Stmt[] = [];
  let enums: EnumDecl[] = [];
  let resources: ResourceDecl[] = [];
  let exports: ExportBinding[] = [];
  let marks: FuncMark[] = [];
  let traits: TraitDecl[] = [];
  let impl_decls: ImplDecl[] = [];
  let flines: FieldLines[] = [];
  let inline_hints: FunctionInlineHint[] = [];
  let vec_impls: VecImpl[] = [];
  let mth_keys: string[] = [];
  let mth_traits: string[] = [];
  while (!p.at_end()) {
    let decl_start = p.pos;
    let (attrs, da_bad, da_p) = parse_decl_attrs(p);
    if (da_bad.len() > 0) {
      for b in da_bad {
        top_stmts = top_stmts.append(b);
      }
      p = skip_failed_decl(da_p, decl_start);
      continue;
    }
    p = da_p;
    let kw = p.peek_keyword();
    let decl_pub = false;
    let decl_package = false;
    let decl_line = p.peek_line();
    let decl_col = p.peek_col();
    if (kw == "pub") {
      let pub_at = p;
      p = p.advance();
      let (mpk, mpk_p) = consume_pub_package(p);
      p = mpk_p;
      kw = p.peek_keyword();
      decl_pub = !mpk;
      decl_package = mpk;
      let pub_bad = pub_errors(pub_at, p);
      if (pub_bad.len() > 0) {
        for b in pub_bad {
          top_stmts = top_stmts.append(b);
        }
        p = skip_failed_decl(p, decl_start);
        continue;
      }
    }
    let decl_async = false;
    let async_p = skip_decl_modifier(p, "async", "function");
    if (async_p.pos != p.pos) {
      p = async_p;
      kw = "function";
      decl_async = true;
    }
    let decl_fip = false;
    let decl_fbip = false;
    let decl_fip_allowance = 0;
    let fm_name = p.peek_ident();
    if (fm_name == "fip" || fm_name == "fbip") {
      let fm_probe = p.advance();
      let fm_grade = 0;
      if (fm_probe.peek_punct() == "(") {
        let fm_num = fm_probe.advance();
        if (fm_num.peek_is_literal()) {
          let fm_close = fm_num.advance();
          if (fm_close.peek_punct() == ")") {
            fm_grade = util.digits_to_i32(fm_num.peek_number_text());
            fm_probe = fm_close.advance();
          }
        }
      }
      if (function_head(fm_probe)) {
        p = fm_probe;
        kw = "function";
        decl_fip = fm_name == "fip";
        decl_fbip = fm_name == "fbip";
        decl_fip_allowance = fm_grade;
      }
    }
    let opaque_p = skip_decl_modifier(p, "opaque", "struct");
    let decl_opaque = opaque_p.pos != p.pos;
    if (decl_opaque) {
      p = opaque_p;
      kw = "struct";
    }
    if (unsafe_function_head(p)) {
      kw = "function";
    }
    let is_resource = p.peek_ident() == "resource" && p.advance().peek_ident().len() > 0;
    let decl_kind = kw;
    if (is_resource) {
      decl_kind = "resource";
    }
    let misfit = first_misfit(attrs, decl_kind);
    if (misfit.len() > 0) {
      top_stmts = top_stmts.append(decl_sentinel(p, attr_misplaced(misfit)));
      p = skip_failed_decl(p, decl_start);
      continue;
    }
    if (util.has_str(["struct", "enum", "trait", "type", "const"], kw) && p.advance().peek_ident().len() == 0) {
      for bad in expected_here(p.advance(), "a name") {
        top_stmts = top_stmts.append(bad);
      }
      p = skip_failed_decl(p.advance(), decl_start);
      continue;
    }
    if (kw == "function") {
      let errors_before = p.type_errs.len();
      let (fr_func, fr_p) = parse_func_decl(p);
      p = fr_p;
      if (fr_func.name.len() == 0) {
        if (p.type_errs.len() == errors_before) {
          top_stmts = top_stmts.append(s_unknown_at(decl_fault(malformed_fn_decl_message()), fr_func.line, fr_func.col));
        }
        p = sync_to_top_level(p);
        continue;
      }
      let never_inline = has_decl_attr(attrs, "noinline");
      let always_inline = has_decl_attr(attrs, "inline");
      if (verbatim && (never_inline || always_inline)) {
        inline_hints = inline_hints.append(FunctionInlineHint { line: fr_func.line, col: fr_func.col, never: never_inline });
      }
      let fr_pub = FuncDecl { ...fr_func, is_pub: decl_pub, is_package: decl_package, no_inline: never_inline, always_inline: always_inline };
      for attr in attrs {
        if (attr.name == "import" || attr.name == "callback") {
          fr_pub = FuncDecl { ...fr_pub, import_iface: attr.iface, import_wit: attr.wit, import_weak: attr.weak };
        }
        exports = with_attr_export(exports, attr, fr_func);
        if (attr.name == "provide" || attr.name == "norc" || attr.name == "interrupt" || attr.name == "early" || attr.name == "secondary") {
          marks = marks.append(FuncMark { attr: attr.name, arg: attr.wit, func_name: fr_func.name, line: fr_func.line, col: fr_func.col });
        }
      }
      let fr_out = fr_pub;
      if (decl_fip || decl_fbip) {
        fr_out = FuncDecl { ...fr_pub, fip: decl_fip, fbip: decl_fbip, fip_allowance: decl_fip_allowance };
      } else if (decl_async) {
        fr_out = FuncDecl { ...fr_pub, async: true };
      }
      let fr_cl = claim_method_name(fr_out, "", mth_keys, mth_traits);
      mth_keys = fr_cl.keys;
      mth_traits = fr_cl.traits;
      funcs = funcs.append(fr_cl.fn);
      continue;
    }
    if (kw == "struct") {
      let (sr_decl, sr_p) = parse_struct_decl(p);
      p = sr_p;
      flines = record_field_lines(flines, verbatim, sr_decl.name, sr_decl.line, field_lines(sr_decl.fields));
      let sr_derives = decl_attr_named(attrs, "derive").derives;
      structs = structs.append(StructDecl { ...sr_decl, derives: sr_derives, must_consume: has_decl_attr(attrs, "must_consume"), secret: has_decl_attr(attrs, "secret"), value_type: has_decl_attr(attrs, "value"), is_pub: decl_pub, is_package: decl_package, opaque: decl_opaque });
      funcs = synth_derives(sr_decl, sr_derives, funcs, std_json_alias(imports));
      continue;
    }
    if (kw == "type") {
      let (tr_alias, tr_p) = parse_type_alias(p);
      p = tr_p;
      aliases = aliases.append(TypeAlias { ...tr_alias, is_pub: decl_pub, is_package: decl_package });
      continue;
    }
    if (kw == "enum") {
      let eline = p.peek_line();
      let ecol = p.peek_col();
      let (enr_name, enr_variants, enr_type_params, enr_const_params, enr_vlines, enr_p) = parse_enum_decl(p);
      p = enr_p;
      flines = record_field_lines(flines, verbatim, enr_name, eline, enr_vlines);
      enums = enums.append(EnumDecl { name: enr_name, variant_names: enum_variant_names(enr_variants), type_params: enr_type_params, const_params: enr_const_params, line: eline, col: ecol, must_consume: has_decl_attr(attrs, "must_consume"), try_marker: has_decl_attr(attrs, "try"), is_pub: decl_pub, is_package: decl_package, module: "", instance: "", visible_from: [] });
      for ei in 0..enr_variants.len() {
        structs = structs.append(StructDecl { ...enr_variants[ei], derives: decl_attr_named(attrs, "derive").derives });
      }
      funcs = synth_enum_derives(enr_name, enr_type_params, enr_variants, decl_attr_named(attrs, "derive").derives, funcs, std_json_alias(imports));
      continue;
    }
    if (kw == "const") {
      let (cr_func, cr_p) = parse_const_decl(p);
      p = cr_p;
      funcs = funcs.append(FuncDecl { ...cr_func, is_pub: decl_pub, is_package: decl_package });
      continue;
    }
    if (kw == "import") {
      let (ir_imp, ir_bad, ir_p) = parse_import(p);
      p = ir_p;
      if (ir_imp.path.len() > 0 || ir_bad.len() == 0) {
        imports = imports.append(ir_imp);
      }
      for b in ir_bad {
        top_stmts = top_stmts.append(b);
      }
      continue;
    }
    if (kw == "use") {
      let (ur_imp, ur_bad, ur_p) = parse_pubuse(p, decl_line, decl_col);
      p = ur_p;
      if (ur_imp.path.len() > 0 || ur_bad.len() == 0) {
        imports = imports.append(ur_imp);
      }
      for b in ur_bad {
        top_stmts = top_stmts.append(b);
      }
      continue;
    }
    if (kw == "trait") {
      let (tpr_defaults, tpr_req, tpr_decl, tpr_bad, tpr_p) = parse_trait_decl(p);
      p = tpr_p;
      for b in tpr_bad {
        top_stmts = top_stmts.append(b);
      }
      traits = traits.append(TraitDecl { ...tpr_decl, is_pub: decl_pub, is_package: decl_package });
      for tdi in 0..tpr_defaults.len() {
        trait_defaults = trait_defaults.append(tpr_defaults[tdi]);
      }
      trait_reqs = trait_reqs.append(tpr_req);
      continue;
    }
    if (kw == "impl") {
      let (imr_funcs, imr_trait_name, imr_impl_type, imr_type_params, imr_bounds, imr_method_names, imr_trait_spelling, imr_decl, imr_bad, imr_p) = parse_impl_decl(p);
      p = imr_p;
      for b in imr_bad {
        top_stmts = top_stmts.append(b);
      }
      impl_decls = impl_decls.append(imr_decl);
      let imr_info = ImplInfo { trait_name: imr_trait_name, impl_type: imr_impl_type, type_params: imr_type_params, all_type_params: imr_decl.type_params, bounds: imr_bounds, method_names: imr_method_names, trait_spelling: imr_trait_spelling, trait_ref: imr_decl.trait_ref, assoc_names: imr_decl.assoc_names, assoc_values: imr_decl.assoc_values, trait_module: "", module: "", line: imr_decl.line, col: imr_decl.col };
      if (!p.verbatim && generic_vec_impl(imr_impl_type, imr_decl.type_params)) {
        vec_impls = vec_impls.append(VecImpl { funcs: imr_funcs, info: imr_info });
        continue;
      }
      let mi = 0;
      while (mi < imr_funcs.len() && !p.verbatim) {
        let im_cl = claim_method_name(imr_funcs[mi], imr_trait_name, mth_keys, mth_traits);
        mth_keys = im_cl.keys;
        mth_traits = im_cl.traits;
        funcs = funcs.append(im_cl.fn);
        mi += 1;
      }
      impl_infos = impl_infos.append(imr_info);
      continue;
    }
    if (is_resource) {
      let rnr_line = p.peek_line();
      let rnr_col = p.peek_col();
      let (rnr_name, rnr_p) = parse_resource_decl_name(p);
      p = rnr_p;
      let rnr_import = decl_attr_named(attrs, "import");
      resources = resources.append(ResourceDecl { name: rnr_name, iface: rnr_import.iface, wit: rnr_import.wit, line: rnr_line, col: rnr_col });
      continue;
    }
    let (stmtR_stmt, stmtR_p) = parse_stmt(p);
    if (stmtR_p.pos == p.pos) {
      p = p.advance();
      continue;
    }
    p = stmtR_p;
    top_stmts = top_stmts.append(stmtR_stmt);
  }
  let own_vec = declares_vec(structs, enums, aliases, traits);
  for v in vec_impls {
    for part in vec_impl_parts(v, own_vec) {
      for fd in part.funcs {
        let vi_cl = claim_method_name(fd, part.info.trait_name, mth_keys, mth_traits);
        mth_keys = vi_cl.keys;
        mth_traits = vi_cl.traits;
        funcs = funcs.append(vi_cl.fn);
      }
      impl_infos = impl_infos.append(part.info);
    }
  }
  let iii = 0;
  while (iii < impl_infos.len() && !verbatim) {
    let info = impl_infos[iii];
    for ddi in 0..trait_defaults.len() {
      let td = trait_defaults[ddi];
      if (td.trait_name == info.trait_name) {
        if (!util.has_str(info.method_names, td.method.name)) {
          let td_cl = claim_method_name(inherit_default(td.method, td.trait_params, td.trait_consts, info), info.trait_name, mth_keys, mth_traits);
          mth_keys = td_cl.keys;
          mth_traits = td_cl.traits;
          funcs = funcs.append(td_cl.fn);
        }
      }
    }
    iii += 1;
  }
  for te in p.type_errs {
    top_stmts = top_stmts.append(te);
  }
  match (unclosed_brace(toks)) {
    Some(ub) => {
      top_stmts = top_stmts.append(ub);
    },
    None => {}
  }
  let parsed = Module { funcs: funcs, structs: structs, aliases: aliases, imports: imports, top_stmts: top_stmts, enums: enums, resources: resources, exports: exports, marks: marks, impls: impl_infos, trait_reqs: trait_reqs, trait_decls: traits, substituted_consts: [], todo_sites: p.todos, sights: [] };
  if (!verbatim) {
    let inferred = substituted_const_names(funcs);
    let nothing: string[] = [];
    parsed = substitute_const_refs(parsed, inferred_const_table(funcs, inferred, ConstTable { names: nothing, values: [] }));
    parsed = rewrite_assoc_const_reads(parsed);
    parsed = Module { ...parsed, funcs: settle_const_types(parsed.funcs, structs, parsed.enums), substituted_consts: inferred };
    parsed = desugar_union_aliases(desugar_trait_params(parsed, trait_decl_names(traits), false));
  }
  let labelled = resolve_labels_module(resolve_assoc_projections(parsed));
  if (!verbatim) {
    labelled = resolve_variant_fields_module(labelled);
  }
  let settled = settle_module(labelled);
  if (!verbatim) {
    settled = route_inherited_defaults(resolve_dyn_traits(rename_type_vars_module(settled)));
  }
  return (settled, traits, impl_decls, flines, inline_hints);
}

function stream_lex_error(toks: lexer.Token[]): Option[lexer.TokError] {
  if (toks.len() == 0) {
    return None;
  }
  if let lexer.TokError(e) = toks[toks.len() - 1] {
    return Some(e);
  }
  return None;
}

function lex_error_module(le: lexer.TokError): (Module, TraitDecl[], ImplDecl[], FieldLines[], FunctionInlineHint[]) {
  let m = Module { funcs: [], structs: [], aliases: [], imports: [], top_stmts: [s_unknown_at(lex_fault(le), le.line, le.col)], enums: [], resources: [], exports: [], marks: [], impls: [], trait_reqs: [], trait_decls: [], substituted_consts: [], todo_sites: [], sights: [] };
  let traits: TraitDecl[] = [];
  let impls: ImplDecl[] = [];
  let flines: FieldLines[] = [];
  let hints: FunctionInlineHint[] = [];
  return (m, traits, impls, flines, hints);
}

function unclosed_brace(toks: lexer.Token[]): Option[ast.Stmt] {
  if (toks.len() == 0) {
    return None;
  }
  let end_line = 0;
  let end_col = 0;
  if let lexer.TokEof(e) = toks[toks.len() - 1] {
    end_line = e.line;
    end_col = e.col;
  } else {
    return None;
  }
  let open_lines: i32[] = [];
  let open_cols: i32[] = [];
  let depth = 0;
  for t in toks {
    if let lexer.TokPunct(x) = t {
      if (x.text == "{") {
        open_lines = push_at(open_lines, depth, x.line);
        open_cols = push_at(open_cols, depth, x.col);
        depth += 1;
      } else if (x.text == "}" && depth > 0) {
        depth -= 1;
      }
    }
  }
  if (depth == 0) {
    return None;
  }
  let at = util.i32_to_string(open_lines[depth - 1]) + ":" + util.i32_to_string(open_cols[depth - 1]);
  return Some(s_unknown_at(decl_fault("expected \"}\" before the end of the input, to close the \"{\" at " + at), end_line, end_col));
}

function push_at(xs: i32[], i: i32, v: i32): i32[] {
  if (i < xs.len()) {
    return xs.with(i, v);
  }
  return xs.append(v);
}

pub function merge_module(into: Module, from: Module): Module {
  let nfuncs = into.funcs;
  for fi in 0..from.funcs.len() {
    nfuncs = nfuncs.append(from.funcs[fi]);
  }
  let nstructs = into.structs;
  for si in 0..from.structs.len() {
    nstructs = nstructs.append(from.structs[si]);
  }
  let naliases = into.aliases;
  for ai in 0..from.aliases.len() {
    naliases = naliases.append(from.aliases[ai]);
  }
  let nresources = into.resources;
  for ri in 0..from.resources.len() {
    nresources = nresources.append(from.resources[ri]);
  }
  let nmarks = into.marks;
  for pv in from.marks {
    nmarks = nmarks.append(pv);
  }
  let nexports = into.exports;
  for xi in 0..from.exports.len() {
    nexports = nexports.append(from.exports[xi]);
  }
  let nimpls = into.impls;
  for nii in 0..from.impls.len() {
    nimpls = nimpls.append(from.impls[nii]);
  }
  let ntdecls = into.trait_decls;
  for tdi2 in 0..from.trait_decls.len() {
    ntdecls = ntdecls.append(from.trait_decls[tdi2]);
  }
  let ntreqs = into.trait_reqs;
  for nti in 0..from.trait_reqs.len() {
    ntreqs = ntreqs.append(from.trait_reqs[nti]);
  }
  return resolve_assoc_projections(Module { ...into, funcs: nfuncs, structs: nstructs, aliases: naliases, enums: concat_enums(into.enums, from.enums), resources: nresources, exports: nexports, marks: nmarks, impls: nimpls, trait_reqs: ntreqs, trait_decls: ntdecls });
}

pub function merge_module_prefixed(into: Module, from: Module, prefix: string): Module {
  let nfuncs = into.funcs;
  for fi in 0..from.funcs.len() {
    let fd = from.funcs[fi];
    nfuncs = nfuncs.append(FuncDecl { ...fd, name: prefix + "." + fd.name, is_pub: true });
  }
  let nstructs = into.structs;
  for si in 0..from.structs.len() {
    let sd = from.structs[si];
    nstructs = nstructs.append(StructDecl { name: prefix + "." + sd.name, fields: sd.fields, type_params: sd.type_params, const_params: sd.const_params, derives: sd.derives, line: sd.line, col: sd.col, enum_owner: sd.enum_owner, must_consume: sd.must_consume, secret: sd.secret, value_type: sd.value_type, variant_field_names: sd.variant_field_names, is_pub: true, is_package: false, opaque: sd.opaque, module: sd.module });
  }
  let naliases = into.aliases;
  for ai in 0..from.aliases.len() {
    let ad = from.aliases[ai];
    naliases = naliases.append(TypeAlias { ...ad, name: prefix + "." + ad.name, is_pub: true, is_package: false });
  }
  let nresources = into.resources;
  for ri in 0..from.resources.len() {
    let rd = from.resources[ri];
    nresources = nresources.append(ResourceDecl { ...rd, name: prefix + "." + rd.name });
  }
  let nmarks = into.marks;
  for pv in from.marks {
    nmarks = nmarks.append(FuncMark { ...pv, func_name: prefix + "." + pv.func_name });
  }
  let nexports = into.exports;
  for xi in 0..from.exports.len() {
    let xb = from.exports[xi];
    nexports = nexports.append(ExportBinding { func_name: prefix + "." + xb.func_name, iface: xb.iface, wit: xb.wit, c_abi: xb.c_abi, method: xb.method, jni: xb.jni });
  }
  let nimpls = into.impls;
  for nii in 0..from.impls.len() {
    nimpls = nimpls.append(from.impls[nii]);
  }
  let ntdecls = into.trait_decls;
  for tdi2 in 0..from.trait_decls.len() {
    ntdecls = ntdecls.append(from.trait_decls[tdi2]);
  }
  let ntreqs = into.trait_reqs;
  for nti in 0..from.trait_reqs.len() {
    ntreqs = ntreqs.append(from.trait_reqs[nti]);
  }
  return resolve_assoc_projections(Module { ...into, funcs: nfuncs, structs: nstructs, aliases: naliases, enums: concat_enums(into.enums, from.enums), resources: nresources, exports: nexports, marks: nmarks, impls: nimpls, trait_reqs: ntreqs, trait_decls: ntdecls });
}

function subst_impl_params(im: ImplInfo, base: string, bound: string): string {
  if (im.all_type_params.len() == 0) {
    return bound;
  }
  let pats = type_args_of(im.impl_type);
  let args = type_args_of(base);
  if (pats.len() == 0 || pats.len() != args.len()) {
    return bound;
  }
  let ps: string[] = [];
  let cs: string[] = [];
  for k in 0..pats.len() {
    if (tp_index(pats[k], im.all_type_params) >= 0) {
      ps = ps.append(pats[k]);
      cs = cs.append(args[k]);
    }
  }
  if (ps.len() == 0) {
    return bound;
  }
  return subst_ty(bound, ps, cs);
}

function assoc_binding_for(impls: ImplInfo[], base: string, name: string): string {
  let bare = util.base_type_name(base);
  for im in impls {
    if (util.base_type_name(im.impl_type) == bare) {
      for i in 0..im.assoc_names.len() {
        if (im.assoc_names[i] == name && i < im.assoc_values.len()) {
          return subst_impl_params(im, base, im.assoc_values[i]);
        }
      }
    }
  }
  return "";
}

pub function resolve_proj_in_type(t: string, impls: ImplInfo[]): string {
  if (!util.contains(t, "::")) {
    return t;
  }
  let out = "";
  let run = 0;
  let i = 0;
  while (i < t.len()) {
    if (i + 1 < t.len() && t[i] == b':' && t[i + 1] == b':') {
      out += slice_unchecked(t, run, i);
      run = i;
      let bs = out.len();
      if (bs > 0 && out[bs - 1] == b']') {
        let depth = 0;
        let j = bs;
        while (j > 0) {
          j -= 1;
          if (out[j] == b']') {
            depth += 1;
          }
          if (out[j] == b'[') {
            depth -= 1;
            if (depth == 0) {
              bs = j;
              j = 0;
            }
          }
        }
      }
      while (bs > 0 && ident_byte(out[bs - 1] as i32)) {
        bs -= 1;
      }
      let base = slice_unchecked(out, bs, out.len()).to_owned();
      let ns = i + 2;
      let ne = ns;
      while (ne < t.len() && ident_byte(t[ne] as i32)) {
        ne += 1;
      }
      let nm = slice_unchecked(t, ns, ne).to_owned();
      let bound = assoc_binding_for(impls, base, nm);
      if (base.len() > 0 && nm.len() > 0 && bound.len() > 0) {
        out = slice_unchecked(out, 0, bs) + bound;
        i = ne;
        run = i;
        continue;
      }
    }
    i += 1;
  }
  return out + slice_unchecked(t, run, t.len());
}

pub function resolve_assoc_projections(mod: Module): Module {
  let any = false;
  for im in mod.impls {
    if (im.assoc_names.len() > 0) {
      any = true;
    }
  }
  if (!any) {
    return mod;
  }
  let fs: FuncDecl[] = [];
  for f in mod.funcs {
    let ps: ast.ParamDecl[] = [];
    for pd in f.params {
      ps = ps.append(ast.ParamDecl { ...pd, type_name: resolve_proj_in_type(pd.type_name, mod.impls) });
    }
    fs = fs.append(FuncDecl {
      ...f,
      params: ps,
      ret_type: resolve_proj_in_type(f.ret_type, mod.impls),
      receiver_type: resolve_proj_in_type(f.receiver_type, mod.impls),
    });
  }
  let sds: StructDecl[] = [];
  for sd in mod.structs {
    let flds: StructFieldDecl[] = [];
    for fd in sd.fields {
      flds = flds.append(StructFieldDecl { ...fd, type_name: resolve_proj_in_type(fd.type_name, mod.impls) });
    }
    sds = sds.append(StructDecl { ...sd, fields: flds });
  }
  return Module { ...mod, funcs: fs, structs: sds };
}
