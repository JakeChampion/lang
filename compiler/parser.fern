}

function add_builtin_struct2(structs: StructDecl[], name: string, f0: string, t0: string, f1: string, t1: string): StructDecl[] {
  if (struct_declared(structs, name)) {
    return structs;
  }
  let fields: StructFieldDecl[] = [];
  fields = fields.append(bare_field(f0, t0));
  fields = fields.append(bare_field(f1, t1));
  return structs.append(StructDecl { name: name, fields: fields, type_params: [], const_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, secret: false, value_type: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" });
}

pub struct MEnv { mnames: string[], mtypes: string[] }

pub function (e: MEnv) ebind(n: string, t: string): MEnv {
  return MEnv { mnames: e.mnames.append(n), mtypes: e.mtypes.append(t) };
}

pub function (e: MEnv) elook(n: string): string {
  let i = e.mnames.len() - 1;
  while (i >= 0) {
    if (e.mnames[i] == n) {
      return e.mtypes[i];
    }
    i -= 1;
  }
  return "";
}

pub struct Insts { inames: string[], itypes: string[], iargs: string[] }

pub function (a: Insts) ihas(n: string, t: string): boolean {
  for i in 0..a.inames.len() {
    if (a.inames[i] == n && a.itypes[i] == t) {
      return true;
    }
  }
  return false;
}

pub function (a: Insts) iadd(n: string, t: string): Insts {
  if (a.ihas(n, t)) {
    return a;
  }
  return Insts { inames: a.inames.append(n), itypes: a.itypes.append(t), iargs: a.iargs.append(t) };
}

pub function (a: Insts) iadd_arg(n: string, t: string, arg: string): Insts {
  if (a.ihas(n, t)) {
    return a;
  }
  return Insts { inames: a.inames.append(n), itypes: a.itypes.append(t), iargs: a.iargs.append(arg) };
}

pub struct MFns {
  decls: FuncDecl[],
  ghead: i32[],
  gnext: i32[],
  gname: string[],
  gat: i32[],
  pix: util.NameIndex,
  pat: i32[],
  mix: util.NameIndex,
  mat: i32[],
  rix: util.NameIndex,
  rat: i32[],
  smm: string[],
  array_concrete: i32[],
  structs: StructDecl[],
  snames: util.NameIndex,
  enums: EnumDecl[],
  impls: ImplInfo[],
  keep_vars: boolean,
  on_call: string[],
  renamed: string[],
  lane_bounds: string[],
}

function mfns_buckets(): i32 {
  return 257;
}

function struct_names(structs: StructDecl[]): string[] {
  let out: string[] = [];
  for sd in structs {
    out = out.append(sd.name);
  }
  return out;
}

pub function mfns_of(decls: FuncDecl[], structs: StructDecl[], enums: EnumDecl[], impls: ImplInfo[]): MFns {
  let ghead: i32[] = [];
  let b = 0;
  let nb = mfns_buckets();
  while (b < nb) {
    ghead = ghead.append(-1);
    b += 1;
  }
  let gname: string[] = [];
  let gat: i32[] = [];
  let smm: string[] = [];
  let array_concrete: i32[] = [];
  let pnames: string[] = [];
  let pat: i32[] = [];
  let mnames: string[] = [];
  let mat: i32[] = [];
  let rnames: string[] = [];
  let rat: i32[] = [];
  for i in 0..decls.len() {
    if (is_free_bg_template(decls[i])) {
      gname = gname.append(decls[i].name);
      gat = gat.append(i);
    }
    if (decls[i].receiver_name.len() == 0 && decls[i].receiver_type.len() == 0) {
      pnames = pnames.append(decls[i].name);
      pat = pat.append(i);
    }
    if (decls[i].receiver_name.len() > 0 && decls[i].all_type_params.len() == 0) {
      mnames = mnames.append(decls[i].name);
      mat = mat.append(i);
    }
    if (decls[i].receiver_type.len() > 0) {
      rnames = rnames.append(decls[i].name);
      rat = rat.append(i);
    }
    if (decls[i].name.len() > 6 && decls[i].name.starts_with("__smm_")) {
      smm = smm.append(decls[i].name);
    }
    if (is_concrete_array_fold(decls[i])) {
      array_concrete = array_concrete.append(i);
    }
  }
  let gnext: i32[] = [];
  for j in 0..gname.len() {
    gnext = gnext.append(-1);
  }
  let k = gname.len() - 1;
  while (k >= 0) {
    let bk = util.hash_bucket(gname[k], nb);
    gnext = gnext.with(k, ghead[bk]);
    ghead = ghead.with(bk, k);
    k -= 1;
  }
  return MFns { decls: decls, ghead: ghead, gnext: gnext, gname: gname, gat: gat, pix: util.name_index(pnames), pat: pat, mix: util.name_index(mnames), mat: mat, rix: util.name_index(rnames), rat: rat, smm: smm, array_concrete: array_concrete, structs: structs, snames: util.name_index(struct_names(structs)), enums: enums, impls: impls, keep_vars: false, on_call: [], renamed: renamed_receivers(decls), lane_bounds: [] };
}

function renamed_receivers(decls: FuncDecl[]): string[] {
  let out: string[] = [];
  for fd in decls {
    if (fd.receiver_type.len() > 0 && derive_simple_name(fd.name) != fd.name) {
      let base = util.base_type_name(fd.receiver_type);
      if (!util.has_str(out, base)) {
        out = out.append(base);
      }
    }
  }
  return out;
}

function const_type(name: string, fns: MFns): string {
  let k = fns.pix.find(name);
  if (k >= 0 && fns.decls[fns.pat[k]].is_const) {
    return fns.decls[fns.pat[k]].ret_type;
  }
  return "";
}

pub function bg_find(fns: MFns, name: string): i32 {
  let e = fns.ghead[util.hash_bucket(name, fns.ghead.len())];
  while (e >= 0) {
    if (fns.gname[e] == name) {
      return fns.gat[e];
    }
    e = fns.gnext[e];
  }
  return -1;
}

function tp_index(name: string, tparams: string[]): i32 {
  for i in 0..tparams.len() {
    if (tparams[i] == name) {
      return i;
    }
  }
  return -1;
}

// The array of `elem`, the opposite of `elem_spelling`. A function type
// needs parentheses, or the array would be its result.
function array_of_spelling(elem: string): string {
  if (parse_type_ref(elem).is_fn) {
    return "(" + elem + ")[]";
  }
  return elem + "[]";
}

pub function elem_spelling(arr: string): string {
  let el = slice_unchecked(arr, 0, arr.len() - 2).to_owned();
  if (el.len() < 2 || el[0] != b'(' || el[el.len() - 1] != b')') {
    return el;
  }
  let depth = 0;
  for i in 0..el.len() {
    if (el[i] == b'(') {
      depth += 1;
    } else if (el[i] == b')') {
      depth -= 1;
      if (depth == 0 && i < el.len() - 1) {
        return el;
      }
    }
  }
  let inner = slice_unchecked(el, 1, el.len() - 1).to_owned();
  if (parse_type_ref(inner).is_fn) {
    return inner;
  }
  return el;
}

pub function type_ends_arr(s: string): boolean {
  if (s.len() < 2) {
    return false;
  }
  return s.ends_with("[]");
}

pub function import_paths(mod: Module): string[] {
  let out: string[] = [];
  for im in mod.imports {
    out = out.append(im.path);
  }
  return out;
}

pub function first_bracket(s: string): i32 {
  for i in 0..s.len() {
    if (s[i] == b'[') {
      return i;
    }
  }
  return -1;
}

pub function split_top_commas(s: string): string[] {
  let out: string[] = [];
  let depth = 0;
  let start = 0;
  let i = 0;
  while (i < s.len()) {
    if (s[i] == b'[' || s[i] == b'(') {
      depth += 1;
    }
    if (s[i] == b']' || s[i] == b')') {
      depth -= 1;
    }
    if (depth == 0 && s[i] == b',') {
      out = out.append(slice_unchecked(s, start, i).to_owned());
      i += 1;
      if (i < s.len() && s[i] == b' ') {
        i += 1;
      }
      start = i;
      continue;
    }
    i += 1;
  }
  out = out.append(slice_unchecked(s, start, s.len()).to_owned());
  return out;
}

// import_qualifier is the name an import gives to the module it loads: its
// alias, or the last segment of its path (`json` for `import "std/json"`).
pub function import_qualifier(im: Import): string {
  if (im.alias.len() > 0) {
    return im.alias;
  }
  let p = util.without_fern_ext(im.path);
  let start = 0;
  for i in 0..p.len() {
    if (p[i] == b'/') {
      start = i + 1;
    }
  }
  return slice_unchecked(p, start, p.len()).to_owned();
}

pub function std_qualifier(mod: Module, name: string): string {
  return module_qualifier(mod, "std/" + name);
}

// The qualifier mod uses for its import of want, or "" when it does not import it.
pub function module_qualifier(mod: Module, want: string): string {
  for imp in mod.imports {
    if (library_path_is(imp.path, want)) {
      return import_qualifier(imp);
    }
  }
  return "";
}

pub function library_path_is(path: string, want: string): boolean {
  let p = util.without_fern_ext(path);
  return p == want || p.len() > want.len() + 1 && p.ends_with(want) && p[p.len() - want.len() - 1] == b'/';
}

pub function is_serve_config_type(t: string, qual: string): boolean {
  let s = strip_type_spaces(t);
  return s == "serve__Config" || qual.len() > 0 && s == qual + ".Config";
}

pub function init_return_kind(rt: string, qual: string): i32 {
  let s = strip_type_spaces(rt);
  if (s.len() == 0 || s == "void") {
    return 0;
  }
  if (is_serve_config_type(s, qual)) {
    return 2;
  }
  if (s.len() > 2 && s[0] == b'(' && s[s.len() - 1] == b')') {
    let parts = split_top_commas(slice_unchecked(s, 1, s.len() - 1).to_owned());
    if (parts.len() == 2 && is_serve_config_type(parts[0], qual)) {
      return 3;
    }
  }
  return 1;
}

pub function strip_type_spaces(t: string): string {
  return t.replace(" ", "");
}

pub struct TypeRef { base: string, args: TypeRef[], array_depth: i32, is_tuple: boolean, is_fn: boolean, is_view: boolean, is_once: boolean }

pub function elem_type_ref(t: TypeRef): TypeRef {
  return TypeRef { ...t, array_depth: t.array_depth - 1 };
}

pub function top_arrow_at(s: string): i32 {
  let depth = 0;
  for i in 0..s.len() {
    if (s[i] == b'[' || s[i] == b'(') {
      depth += 1;
    }
    if (s[i] == b']' || s[i] == b')') {
      depth -= 1;
    }
    if (depth == 0 && s[i] == b'=' && i + 1 < s.len() && s[i + 1] == b'>') {
      return i;
    }
  }
  return -1;
}

pub function plain_type_spelling(s: string): boolean {
  for i in 0..s.len() {
    let c = s[i];
    if (c == b'[' || c == b'(' || c == b'=') {
      return false;
    }
  }
  return true;
}

// Reports a spelling that is a plain name with one or more `[]` after it.
pub function array_of_plain_spelling(s: string): boolean {
  let n = s.len();
  if (n < 3 || s[n - 1] != b']') {
    return false;
  }
  for i in 0..n {
    let c = s[i];
    if (c == b'(' || c == b'=' || c == b'[' && s[i + 1] != b']' || c == b']' && (i == 0 || s[i - 1] != b'[')) {
      return false;
    }
  }
  return true;
}

// The type of `e?` when `e` has the type spelled t: the payload of an Option
// or the Ok type of a Result, or "" when t is neither.
function try_payload_spelling(t: string): string {
  let tr = parse_type_ref(t);
  if (tr.array_depth == 0 && (tr.base == "Option" || tr.base == "Result") && tr.args.len() > 0) {
    return render_type_ref(tr.args[0]);
  }
  return "";
}

pub function parse_type_ref(sin: string): TypeRef {
  if (plain_type_spelling(sin)) {
    return TypeRef { base: sin, args: [], array_depth: 0, is_tuple: false, is_fn: false, is_view: false, is_once: false };
  }
  let once = once_fn_body(sin);
  if (once.len() > 0) {
    let f = parse_type_ref(once);
    if (f.is_fn) {
      return TypeRef { ...f, is_once: true };
    }
  }
  let s = sin;
  let depth = 0;
  let arrow = top_arrow_at(s);
  if (arrow > 0) {
    let lhs = slice_unchecked(s, 0, arrow).to_owned();
    while (lhs.len() > 0 && lhs[lhs.len() - 1] == b' ') {
      lhs = slice_unchecked(lhs, 0, lhs.len() - 1).to_owned();
    }
    let rhs = slice_unchecked(s, arrow + 2, s.len()).to_owned();
    while (rhs.len() > 0 && rhs[0] == b' ') {
      rhs = slice_unchecked(rhs, 1, rhs.len()).to_owned();
    }
    if (lhs.len() >= 2 && lhs[0] == b'(' && lhs[lhs.len() - 1] == b')') {
      let pinner = slice_unchecked(lhs, 1, lhs.len() - 1).to_owned();
      let fargs: TypeRef[] = [];
      if (pinner.len() > 0) {
        let psegs = split_top_commas(pinner);
        for pi in 0..psegs.len() {
          fargs = fargs.append(parse_type_ref(fn_parameter_type(psegs[pi])));
        }
      }
      fargs = fargs.append(parse_type_ref(rhs));
      return TypeRef { base: "", args: fargs, array_depth: 0, is_tuple: false, is_fn: true, is_view: false, is_once: false };
    }
  }
  while (s.len() >= 2 && s[s.len() - 2] == b'[' && s[s.len() - 1] == b']') {
    depth += 1;
    s = slice_unchecked(s, 0, s.len() - 2).to_owned();
  }
  if (spelling_is_view(s)) {
    return TypeRef { base: "", args: [parse_type_ref(slice_unchecked(s, 1, s.len() - 1).to_owned())], array_depth: depth, is_tuple: false, is_fn: false, is_view: true, is_once: false };
  }
  if (s.len() >= 2 && s[0] == b'(' && s[s.len() - 1] == b')') {
    let tsegs = split_top_commas(slice_unchecked(s, 1, s.len() - 1));
    let targs: TypeRef[] = [];
    for ti in 0..tsegs.len() {
      targs = targs.append(parse_type_ref(tsegs[ti]));
    }
    return TypeRef { base: "", args: targs, array_depth: depth, is_tuple: true, is_fn: false, is_view: false, is_once: false };
  }
  let lb: i32 = -1;
  let j = 0;
  while (j < s.len()) {
    if (s[j] == b'[') {
      lb = j;
      j = s.len();
    } else {
      j += 1;
    }
  }
  if (lb >= 0 && s.len() > 0 && s[s.len() - 1] == b']') {
    let gsegs = split_top_commas(slice_unchecked(s, lb + 1, s.len() - 1));
    let gargs: TypeRef[] = [];
    for gi in 0..gsegs.len() {
      gargs = gargs.append(parse_type_ref(gsegs[gi]));
    }
    let gbase = slice_unchecked(s, 0, lb).to_owned();
    let lanes = vec_lanes(gbase, gargs);
    if (lanes.len() > 0) {
      return TypeRef { base: lanes, args: [], array_depth: depth, is_tuple: false, is_fn: false, is_view: false, is_once: false };
    }
    return TypeRef { base: gbase, args: gargs, array_depth: depth, is_tuple: false, is_fn: false, is_view: false, is_once: false };
  }
  return TypeRef { base: s, args: [], array_depth: depth, is_tuple: false, is_fn: false, is_view: false, is_once: false };
}

// canon_vec spells a `Vec[N, T]` of the portable tier as its lane type.
pub function canon_vec(spelling: string): string {
  if (!spelling.starts_with("Vec[")) {
    return spelling;
  }
  let ref = parse_type_ref(spelling);
  if (ref.args.len() == 0 && ref.array_depth == 0 && typeinfo.lanes_width(ref.base) > 0) {
    return ref.base;
  }
  return spelling;
}

// vec_lanes is the lane type that `Vec[N, T]` names when N and T are a pair
// of the portable tier, and "" for any other spelling.
pub function vec_lanes(base: string, args: TypeRef[]): string {
  if (base != "Vec" || args.len() != 2) {
    return "";
  }
  for a in args {
    if (a.args.len() > 0 || a.array_depth > 0 || a.is_tuple || a.is_fn || a.is_view) {
      return "";
    }
  }
  return typeinfo.vec_lanes(args[0].base, args[1].base);
}

// An impl for `Vec[N, T]` whose arguments name its own parameters is one impl
// per lane type the spelling can stand for, with N and T bound to that lane
// type's count and element. A module that declares its own `Vec` keeps it.
struct VecImpl { funcs: FuncDecl[], info: ImplInfo }

function generic_vec_impl(impl_type: string, tparams: string[]): boolean {
  let ref = parse_type_ref(impl_type);
  if (ref.base != "Vec" || ref.args.len() != 2 || ref.array_depth > 0) {
    return false;
  }
  return tp_index(ref.args[0].base, tparams) >= 0 || tp_index(ref.args[1].base, tparams) >= 0;
}

pub function declares_vec(structs: StructDecl[], enums: EnumDecl[], aliases: TypeAlias[], traits: TraitDecl[]): boolean {
  for sd in structs {
    if (sd.name == "Vec") {
      return true;
    }
  }
  for ed in enums {
    if (ed.name == "Vec") {
      return true;
    }
  }
  for ad in aliases {
    if (ad.name == "Vec") {
      return true;
    }
  }
  for td in traits {
    if (td.name == "Vec") {
      return true;
    }
  }
  return false;
}

function vec_impl_parts(v: VecImpl, own_vec: boolean): VecImpl[] {
  if (own_vec) {
    return [v];
  }
  let ref = parse_type_ref(v.info.impl_type);
  let out: VecImpl[] = [];
  for lane in typeinfo.lane_types() {
    let parts = typeinfo.lane_vec_spellings(lane);
    let names = vec_binding(ref.args, v.info.all_type_params, parts);
    if (names.len() > 0) {
      out = out.append(bound_vec_impl(v, lane, names, vec_binding_values(ref.args, names, parts)));
    }
  }
  if (out.len() == 0) {
    return [v];
  }
  return out;
}

// The parameters of the impl that `args` names, when the lane type whose
// spellings are `parts` fits it, and none when it does not.
function vec_binding(args: TypeRef[], tparams: string[], parts: string[]): string[] {
  let names: string[] = [];
  let values: string[] = [];
  for k in 0..2 {
    let a = args[k];
    let bound = names_param(a, tparams);
    let at = tp_index(a.base, names);
    if (!bound && a.base != parts[k] || bound && at >= 0 && values[at] != parts[k]) {
      return [];
    }
    if (bound && at < 0) {
      names = names.append(a.base);
      values = values.append(parts[k]);
    }
  }
  return names;
}

function names_param(a: TypeRef, tparams: string[]): boolean {
  return a.args.len() == 0 && a.array_depth == 0 && tp_index(a.base, tparams) >= 0;
}

function vec_binding_values(args: TypeRef[], names: string[], parts: string[]): string[] {
  let out: string[] = [];
  for n in names {
    let k = 0;
    if (args[0].base != n) {
      k = 1;
    }
    out = out.append(parts[k]);
  }
  return out;
}

function bound_vec_impl(v: VecImpl, lane: string, names: string[], cts: string[]): VecImpl {
  let funcs: FuncDecl[] = [];
  for fd in v.funcs {
    funcs = funcs.append(bound_vec_method(fd, lane, names, cts));
  }
  let (tps, tbs) = without_params(v.info.type_params, v.info.bounds, names);
  let (all, _) = without_params(v.info.all_type_params, [], names);
  return VecImpl { funcs: funcs, info: ImplInfo { ...v.info, impl_type: lane, type_params: tps, bounds: tbs, all_type_params: all } };
}

function bound_vec_method(fd: FuncDecl, lane: string, names: string[], cts: string[]): FuncDecl {
  let params: ast.ParamDecl[] = [];
  for pd in fd.params {
    params = params.append(ast.ParamDecl { ...pd, type_name: subst_ty(pd.type_name, names, cts), fn_ret: subst_ty(pd.fn_ret, names, cts), fn_param_types: subst_ty_list(pd.fn_param_types, names, cts) });
  }
  let (tps, tbs) = without_params(fd.type_params, fd.bound_traits, names);
  let (all, _) = without_params(fd.all_type_params, [], names);
  return FuncDecl {
    ...fd,
    receiver_type: lane,
    type_params: tps,
    bound_traits: tbs,
    all_type_params: all,
    params: params,
    ret_type: subst_ty(fd.ret_type, names, cts),
    ret_fn_ret: subst_ty(fd.ret_fn_ret, names, cts),
    ret_fn_param_types: subst_ty_list(fd.ret_fn_param_types, names, cts),
    body: const_reads(fd, subst_stmts(fd.body, names, cts), names, cts),
  };
}

// The parameters, and the bounds that line up with them, less `drop`.
function without_params(params: string[], bounds: string[], drop: string[]): (string[], string[]) {
  let ps: string[] = [];
  let bs: string[] = [];
  for i in 0..params.len() {
    if (tp_index(params[i], drop) < 0) {
      ps = ps.append(params[i]);
      if (i < bounds.len()) {
        bs = bs.append(bounds[i]);
      }
    }
  }
  return (ps, bs);
}

function fn_parameter_type(spelling: string): string {
  let depth = 0;
  for i in 0..spelling.len() {
    let c = spelling[i];
    if (c == b'(' || c == b'[') {
      depth += 1;
    }
    if (c == b')' || c == b']') {
      depth -= 1;
    }
    if (c == b':' && depth == 0) {
      return slice_unchecked(spelling, i + 1, spelling.len()).to_owned().trim();
    }
  }
  return spelling;
}

pub function ref_ungroup(r: TypeRef): TypeRef {
  let t = r;
  while (t.array_depth == 0 && t.is_tuple && t.args.len() == 1) {
    t = t.args[0];
  }
  return t;
}

// Whether the spelling `s` ends with the word `once`.
function ends_with_once(s: string): boolean {
  let n = s.len();
  return n >= 4 && s.ends_with("once") && (n == 4 || !ident_byte(s[n - 5] as i32));
}

// The function type after the marker of `once (A) => B`, or "".
pub function once_fn_body(s: string): string {
  if (s.len() > 6 && s.starts_with("once ") && s[5] == b'(') {
    return slice_unchecked(s, 5, s.len()).to_owned();
  }
  return "";
}

pub function ref_is_once(r: TypeRef): boolean {
  let f = ref_ungroup(r);
  return f.array_depth == 0 && f.is_fn && f.is_once;
}

pub function ref_is_fn_value(r: TypeRef): boolean {
  let f = ref_ungroup(r);
  return f.array_depth == 0 && f.is_fn;
}

pub function spelling_is_view(spelling: string): boolean {
  return spelling.len() > 2 && spelling[0] == b'[' && spelling[spelling.len() - 1] == b']'
    && matching_bracket(spelling, 0) == spelling.len() - 1;
}

pub function spelling_is_own(spelling: string): boolean {
  let a = 0;
  while (a < spelling.len() && (spelling[a] == b' ' || spelling[a] == b'\t' || spelling[a] == b'\r')) {
    a += 1;
  }
  return spelling.len() > a + 4 && spelling[a] == b'o' && spelling[a + 1] == b'w' && spelling[a + 2] == b'n' && spelling[a + 3] == b' ';
}

pub function spelling_without_own(spelling: string): string {
  let t = spelling.trim();
  if (!spelling_is_own(t)) {
    return t;
  }
  return slice_unchecked(t, 4, t.len()).to_owned().trim();
}

pub function ref_is_own(r: TypeRef): boolean {
  return !r.is_tuple && !r.is_fn && spelling_is_own(r.base);
}

pub function ref_without_own(r: TypeRef): TypeRef {
  if (!ref_is_own(r)) {
    return r;
  }
  let base = spelling_without_own(r.base);
  if (!plain_type_spelling(base)) {
    return parse_type_ref(spelling_without_own(render_type_ref(r)));
  }
  return TypeRef { ...r, base: base };
}

pub function ref_fn_result(r: TypeRef): TypeRef {
  let f = ref_ungroup(r);
  return f.args[f.args.len() - 1];
}

pub function ref_fn_param_spellings(r: TypeRef): string {
  let f = ref_ungroup(r);
  let out = "";
  let i = 0;
  while (i + 1 < f.args.len()) {
    if (i > 0) {
      out += ",";
    }
    out += render_type_ref(f.args[i]);
    i += 1;
  }
  return out;
}

pub function is_fn_contract_tag(tag: string): boolean {
  return tag == "fn" || tag == "fn[]" || tag == "[fn]";
}

pub function fn_tag_spelling(tag: string, ret: string, params: string): string {
  if (ret.len() == 0 || !is_fn_contract_tag(tag)) {
    return tag;
  }
  let list = "";
  if (params.len() > 0) {
    let segs = split_top_commas(params);
    for i in 0..segs.len() {
      if (i > 0) {
        list += ", ";
      }
      list += segs[i].trim();
    }
  }
  let spelled: string = "(" + list + ") => " + ret;
  if (tag == "fn[]") {
    return "(" + spelled + ")[]";
  }
  if (tag == "[fn]") {
    return "[" + spelled + "]";
  }
  return spelled;
}

pub function is_coarse_fn_tag(s: string): boolean {
  let i = 2;
  if (s.len() >= 4 && s.starts_with("[fn]")) {
    i = 4;
  } else if (s.len() < 2 || !s.starts_with("fn")) {
    return false;
  }
  while (i < s.len()) {
    if (i + 2 > s.len() || !util.str_eq_at(s, i, "[]")) {
      return false;
    }
    i += 2;
  }
  return true;
}

// A function type, in parentheses when it is the element of an array.
function render_fn_ref(t: TypeRef): string {
  let inner = "(";
  let f = 0;
  while (f + 1 < t.args.len()) {
    if (f > 0) {
      inner += ", ";
    }
    inner += render_type_ref(t.args[f]);
    f += 1;
  }
  inner = inner + ") => " + render_type_ref(t.args[t.args.len() - 1]);
  if (t.is_once) {
    inner = "once " + inner;
  }
  if (t.array_depth > 0) {
    return "(" + inner + ")";
  }
  return inner;
}

pub function render_type_ref(t: TypeRef): string {
  let inner = "";
  if (t.is_fn) {
    inner = render_fn_ref(t);
  } else if (t.is_tuple) {
    inner = "(";
    for i in 0..t.args.len() {
      if (i > 0) {
        inner += ", ";
      }
      inner += render_type_ref(t.args[i]);
    }
    inner += ")";
  } else if (t.is_view) {
    inner = "[" + render_type_ref(t.args[0]) + "]";
  } else if (t.args.len() > 0) {
    inner = t.base + "[";
    for k in 0..t.args.len() {
      if (k > 0) {
        inner += ", ";
      }
      inner += render_type_ref(t.args[k]);
    }
    inner += "]";
  } else {
    inner = t.base;
  }
  for d in 0..t.array_depth {
    inner += "[]";
  }
  return inner;
}

pub function split_dunder(s: string): string[] {
  let out: string[] = [];
  let start = 0;
  let i = 0;
  while (i + 1 < s.len()) {
    if (util.str_eq_at(s, i, "__")) {
      out = out.append(slice_unchecked(s, start, i).to_owned());
      i += 2;
      start = i;
      continue;
    }
    i += 1;
  }
  out = out.append(slice_unchecked(s, start, s.len()).to_owned());
  return out;
}

pub function split_key(s: string, n: i32, structs: StructDecl[], enums: EnumDecl[]): string[] {
  if (util.contains(s, ";")) {
    return util.split_char(s, b';');
  }
  let tokens = split_dunder(s);
  if (n <= 1 && tokens.len() == 1) {
    return [s];
  }
  if (n > 1 && tokens.len() <= n) {
    return tokens;
  }
  let want = n;
  if (want < 1) {
    want = 1;
  }
  let g = group_tokens(tokens, 0, want, tokens.len() - want, structs, enums);
  if (g.pieces.len() != want || g.at != tokens.len()) {
    if (n <= 1) {
      return [s];
    }
    return tokens;
  }
  return g.pieces;
}

struct Grouped { pieces: string[], at: i32 }

function group_tokens(tokens: string[], at0: i32, n: i32, spare0: i32, structs: StructDecl[], enums: EnumDecl[]): Grouped {
  let pieces: string[] = [];
  let at = at0;
  let spare = spare0;
  while (pieces.len() < n && at < tokens.len()) {
    let one = take_piece(tokens, at, spare, structs, enums);
    spare -= one.at - at - 1;
    pieces = pieces.append(one.pieces[0]);
    at = one.at;
  }
  return Grouped { pieces: pieces, at: at };
}

function take_piece(tokens: string[], at: i32, spare: i32, structs: StructDecl[], enums: EnumDecl[]): Grouped {
  if (tokens[at] == "view" && at + 1 < tokens.len()) {
    let elem = take_piece(tokens, at + 1, spare - 1, structs, enums);
    return Grouped { pieces: ["[" + elem.pieces[0] + "]"], at: elem.at };
  }
  if (tokens[at] == "arr" && at + 1 < tokens.len()) {
    let elem = take_piece(tokens, at + 1, spare - 1, structs, enums);
    return Grouped { pieces: [elem.pieces[0] + "[]"], at: elem.at };
  }
  if (tokens[at] == "tup") {
    let tup = take_tuple(tokens, at, structs, enums);
    if (tup.at + 1 < tokens.len() && tokens[tup.at] == "fto") {
      let rest = spare - (tup.at + 1 - at);
      if (rest < 0) {
        rest = 0;
      }
      let ret = take_piece(tokens, tup.at + 1, rest, structs, enums);
      return Grouped { pieces: [tup.pieces[0] + " => " + ret.pieces[0]], at: ret.at };
    }
    return tup;
  }
  let k = spare;
  while (k >= 0) {
    let end = at + k + 1;
    let cand = join_dunder(tokens, at, end);
    let params = declared_params(cand, structs, enums);
    if (params == 0) {
      return Grouped { pieces: [cand], at: end };
    }
    if (params > 0 && spare - k - params >= 0) {
      let args = group_tokens(tokens, end, params, spare - k - params, structs, enums);
      if (args.pieces.len() == params) {
        // Built-in enums and generic structs keep their arguments in the
        // spelling rather than getting a nominal clone with a mangled name.
        if (is_reserved_enum_name(cand) || reserved_generic_params(cand) > 0) {
          return Grouped { pieces: [cand + "[" + subst_ty_join(args.pieces, ",", [], []) + "]"], at: args.at };
        }
        return Grouped { pieces: [instance_name(cand, join_dunder(args.pieces, 0, params))], at: args.at };
      }
    }
    k -= 1;
  }
  return Grouped { pieces: [tokens[at]], at: at + 1 };
}

function take_tuple(tokens: string[], at: i32, structs: StructDecl[], enums: EnumDecl[]): Grouped {
  let close = at + 1;
  let depth = 1;
  while (close < tokens.len() && depth > 0) {
    if (tokens[close] == "tup") {
      depth += 1;
    } else if (tokens[close] == "put") {
      depth -= 1;
    }
    if (depth > 0) {
      close += 1;
    }
  }
  let elems = "";
  let j = at + 1;
  while (j < close) {
    let e = take_piece(tokens, j, close - j - 1, structs, enums);
    if (elems.len() > 0) {
      elems += ", ";
    }
    elems += e.pieces[0];
    j = e.at;
  }
  return Grouped { pieces: ["(" + elems + ")"], at: close + 1 };
}

function declared_params(name: string, structs: StructDecl[], enums: EnumDecl[]): i32 {
  if (is_reserved_enum_name(name)) {
    return reserved_enum_tparams(name).len();
  }
  if (reserved_generic_params(name) > 0) {
    return reserved_generic_params(name);
  }
  for sd in structs {
    if (sd.name == name) {
      return sd.type_params.len();
    }
  }
  for ed in enums {
    if (ed.name == name) {
      return ed.type_params.len();
    }
  }
  return -1;
}

function join_dunder(xs: string[], from: i32, to: i32): string {
  let out = "";
  for i in from..to {
    if (i > from) {
      out += "__";
    }
    out += xs[i];
  }
  return out;
}

// The name of the instance of the generic `base` that `key` selects.
pub function instance_name(base: string, key: string): string {
  return util.mangled(base, sanitize_key(key));
}

pub function sanitize_key(s: string): string {
  if (!util.contains(s, "[]")) {
    return sanitize_plain_key(s);
  }
  let out = "";
  for part in util.split_char(s, b';') {
    if (out.len() > 0) {
      out += "__";
    }
    out += array_key_ref(parse_type_ref(part));
  }
  return out;
}

function array_key_ref(t: TypeRef): string {
  if (t.is_view) {
    return "view__" + array_key_ref(t.args[0]);
  }
  if (t.array_depth > 0) {
    return "arr__" + array_key_ref(TypeRef { ...t, array_depth: t.array_depth - 1 });
  }
  let out = sanitize_plain_key(t.base);
  if (t.is_tuple || t.is_fn) {
    out = "tup";
  }
  for i in 0..t.args.len() {
    if (t.is_fn && i + 1 == t.args.len()) {
      out += "__put__fto";
    }
    out = out + "__" + array_key_ref(t.args[i]);
  }
  if (t.is_tuple) {
    out += "__put";
  }
  return out;
}

pub function sanitize_plain_key(s: string): string {
  let out = "";
  let run = 0;
  let i = 0;
  while (i < s.len()) {
    let ch = s[i];
    let at = i;
    let rep = "";
    let plain = false;
    if (ch == b'[' || ch == b',' || ch == b';') {
      rep = "__";
    } else if (ch == b'(') {
      rep = "tup__";
    } else if (ch == b')') {
      rep = "__put";
    } else if (ch == b'=' && i + 1 < s.len() && s[i + 1] == b'>') {
      rep = "__fto__";
      i += 1;
    } else if (ch != b']' && ch != b' ') {
      plain = true;
    }
    i += 1;
    if (!plain) {
      out = out + slice_unchecked(s, run, at) + rep;
      run = i;
    }
  }
  return out + slice_unchecked(s, run, s.len());
}

function spelling_mentions_tparam(name: string, tparams: string[]): boolean {
  if (name.len() == 0) {
    return false;
  }
  for v in type_str_vars(name, []) {
    if (tp_index(v, tparams) >= 0) {
      return true;
    }
  }
  return false;
}

pub function bind_unify(pattern: string, concrete: string, tparams: string[], binds: MEnv, funcs: MFns): MEnv {
  return bind_argument_types(pattern, concrete, tparams, binds, funcs.structs, funcs.enums);
}

function bind_argument_types(pattern: string, concrete: string, tparams: string[], binds: MEnv, structs: StructDecl[], enums: EnumDecl[]): MEnv {
  if (tp_index(pattern, tparams) >= 0) {
    if (binds.elook(pattern).len() == 0 && concrete.len() > 0) {
      return binds.ebind(pattern, concrete);
    }
    return binds;
  }
  if (type_ends_arr(pattern) && type_ends_arr(concrete)) {
    return bind_argument_types(elem_spelling(pattern), elem_spelling(concrete), tparams, binds, structs, enums);
  }
  if (spelling_is_view(pattern)) {
    let elem = array_method_element(concrete);
    if (elem.len() > 0) {
      return bind_argument_types(array_method_element(pattern), elem, tparams, binds, structs, enums);
    }
  }
  if (util.is_tuple_type_name(pattern) && pattern.ends_with(")")
    && util.is_tuple_type_name(concrete) && concrete.ends_with(")")) {
    let tpparts = split_top_commas(slice_unchecked(pattern, 1, pattern.len() - 1));
    let tcparts = split_top_commas(slice_unchecked(concrete, 1, concrete.len() - 1));
    if (tpparts.len() == tcparts.len()) {
      let tb = binds;
      for tj in 0..tpparts.len() {
        tb = bind_argument_types(tpparts[tj], tcparts[tj], tparams, tb, structs, enums);
      }
      return tb;
    }
  }
  if (callable_ret_spelling(pattern).len() > 0 && callable_ret_spelling(concrete).len() > 0) {
    let fpp = callable_param_spellings(pattern);
    let fcp = callable_param_spellings(concrete);
    if (fpp.len() == fcp.len()) {
      let fb = binds;
      for fj in 0..fpp.len() {
        fb = bind_argument_types(fpp[fj], fcp[fj], tparams, fb, structs, enums);
      }
      return bind_argument_types(callable_ret_spelling(pattern), callable_ret_spelling(concrete), tparams, fb, structs, enums);
    }
  }
  let pb = first_bracket(pattern);
  let cb = first_bracket(concrete);
  if (pb > 0 && cb > 0 && pattern.ends_with("]") && concrete.ends_with("]")) {
    if (util.str_range_eq(pattern, 0, pb, slice_unchecked(concrete, 0, cb))) {
      let pparts = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
      let cparts = split_top_commas(slice_unchecked(concrete, cb + 1, concrete.len() - 1));
      if (pparts.len() == cparts.len()) {
        let b = binds;
        for j in 0..pparts.len() {
          b = bind_argument_types(pparts[j], cparts[j], tparams, b, structs, enums);
        }
        return b;
      }
    }
  }
  if (pb > 0 && pattern.ends_with("]") && cb < 0) {
    let pbase = slice_unchecked(pattern, 0, pb);
    let mpfx = pbase + util.NAME_SEP;
    if (concrete.len() > mpfx.len() && concrete.starts_with(mpfx)) {
      let pp = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
      let ckey = slice_unchecked(concrete, mpfx.len(), concrete.len());
      let cp = split_key(ckey + "", pp.len(), structs, enums);
      if (pp.len() == cp.len()) {
        let b2 = binds;
        for j2 in 0..pp.len() {
          b2 = bind_argument_types(pp[j2], cp[j2], tparams, b2, structs, enums);
        }
        return b2;
      }
    }
  }
  return binds;
}

function lambda_ret_of(e: ast.Expr, env: MEnv, funcs: MFns): string {
  match (e) {
    ast.ExprLambda(lm) => {
      if (lm.ret_type.len() > 0) {
        return fn_tag_spelling(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types);
      }
      let lenv = env;
      for pi in 0..lm.params.len() {
        lenv = lenv.ebind(lm.params[pi].name, lm.params[pi].type_name);
      }
      for si in 0..lm.body.len() {
        match (lm.body[si]) {
          ast.StmtReturn(r) => {
            return mono_infer(r.value, lenv, funcs);
          },
          _ => {}
        }
      }
      return "";
    },
    ast.ExprIdent(fid) => {
      let et = env.elook(fid.name);
      if (et.len() > 0) {
        return me_fn_ret_spelling(et);
      }
      return func_ret_of(funcs, fid.name);
    },
    ast.ExprCall(_) => {
      return callable_ret_spelling(fn_value_spelling(e, env, funcs));
    },
    ast.ExprFieldAccess(_) => {
      return callable_ret_spelling(fn_value_spelling(e, env, funcs));
    },
    _ => {
      return "";
    }
  }
}

pub function infer_inst(fd: FuncDecl, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  if (fd.type_params.len() == 0) {
    return "";
  }
  return binds_to_key(fd.type_params, full_ret_binds(fd, args, env, funcs, fd.type_params));
}

pub function explicit_inst_key(fd: FuncDecl, type_args: string[]): string {
  let written = fd.all_type_params;
  if (written.len() == 0) {
    written = fd.type_params;
  }
  if (fd.type_params.len() == 0 || type_args.len() != written.len()) {
    return "";
  }
  let key = "";
  for j in 0..fd.type_params.len() {
    let at = util.index_of_str(written, fd.type_params[j]);
    if (at < 0 || type_args[at].len() == 0) {
      return "";
    }
    if (j > 0) {
      key += ";";
    }
    key += type_args[at];
  }
  return key;
}

function key_parts(fd: FuncDecl, key: string): string[] {
  if (fd.type_params.len() == 1) {
    return [key];
  }
  return util.split_char(key, b';');
}

pub function binds_to_key(tparams: string[], binds: MEnv): string {
  let key = "";
  for j in 0..tparams.len() {
    let b = binds.elook(tparams[j]);
    if (b.len() == 0) {
      return "";
    }
    if (j > 0) {
      key += ";";
    }
    key += b;
  }
  return key;
}

pub function tv_word_char(c: i32): boolean {
  return c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95;
}

pub function type_str_vars(ty: string, acc: string[]): string[] {
  let out = acc;
  let i = 0;
  let n = ty.len();
  while (i < n) {
    if (tv_word_char(ty[i] as i32)) {
      let start = i;
      while (i < n && tv_word_char(ty[i] as i32)) {
        i += 1;
      }
      let tok = slice_unchecked(ty, start, i).to_owned();
      if (looks_type_var(tok) && !util.has_str(out, tok)) {
        out = out.append(tok);
      }
    } else {
      i += 1;
    }
  }
  return out;
}

function lambda_param_types_of(e: ast.Expr, env: MEnv, funcs: MFns): string[] {
  let none: string[] = [];
  match (e) {
    ast.ExprLambda(lm) => {
      let out: string[] = [];
      for pi in 0..lm.params.len() {
        out = out.append(param_spelling(lm.params[pi]));
      }
      return out;
    },
    ast.ExprIdent(fid) => {
      let bt = env.elook(fid.name);
      if (bt.len() > 0) {
        let br = parse_type_ref(bt);
        if (!ref_is_fn_value(br)) {
          return none;
        }
        let bf = ref_ungroup(br);
        let bout: string[] = [];
        let bi = 0;
        while (bi + 1 < bf.args.len()) {
          bout = bout.append(render_type_ref(bf.args[bi]));
          bi += 1;
        }
        return bout;
      }
      return func_param_types_of(funcs.decls, fid.name);
    },
    ast.ExprCall(_) => {
      return callable_param_spellings(fn_value_spelling(e, env, funcs));
    },
    ast.ExprFieldAccess(_) => {
      return callable_param_spellings(fn_value_spelling(e, env, funcs));
    },
    _ => {
      return none;
    }
  }
}

function fn_value_spelling(e: ast.Expr, env: MEnv, funcs: MFns): string {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (env.elook(id.name).len() > 0) {
        return "";
      }
      for fd in funcs.decls {
        if (fd.name == id.name && fd.receiver_type.len() == 0 && fd.ret_type == "fn" && fd.ret_fn_ret.len() > 0
          && !spelling_mentions_tparam(fd.ret_fn_ret, fd.type_params) && !spelling_mentions_tparam(fd.ret_fn_param_types, fd.type_params)) {
          return "(" + fd.ret_fn_param_types + ") => " + fd.ret_fn_ret;
        }
      }
    }
  }
  if let ast.ExprFieldAccess(fa) = e {
    let owner = inst_struct(mono_infer(fa.obj, env, funcs), funcs);
    if (owner.at >= 0) {
      let sd = funcs.structs[owner.at];
      for f in sd.fields {
        if (f.name == fa.field && f.type_name == "fn" && f.fn_ret.len() > 0) {
          return "(" + subst_ty_join(split_top_commas(f.fn_param_types), ", ", sd.type_params, owner.cts) + ") => " + subst_ty(f.fn_ret, sd.type_params, owner.cts);
        }
      }
    }
  }
  return "";
}

pub function param_spelling(p: ast.ParamDecl): string {
  return fn_tag_spelling(p.type_name, p.fn_ret, p.fn_param_types);
}

pub function callable_ret_spelling(t: string): string {
  if (t.len() == 0) {
    return "";
  }
  let r = ref_ungroup(parse_type_ref(t));
  if (!r.is_fn || r.args.len() == 0) {
    return "";
  }
  return render_type_ref(r.args[r.args.len() - 1]);
}

pub function callable_param_spellings(t: string): string[] {
  let none: string[] = [];
  if (t.len() == 0) {
    return none;
  }
  let r = ref_ungroup(parse_type_ref(t));
  if (!r.is_fn) {
    return none;
  }
  let out: string[] = [];
  let i = 0;
  while (i + 1 < r.args.len()) {
    out = out.append(render_type_ref(r.args[i]));
    i += 1;
  }
  return out;
}

function func_param_types_of(decls: FuncDecl[], name: string): string[] {
  let out: string[] = [];
  for i in 0..decls.len() {
    if (decls[i].name == name && decls[i].receiver_type.len() == 0) {
      let k = 0;
      while (k < decls[i].params.len()) {
        out = out.append(param_spelling(decls[i].params[k]));
        k += 1;
      }
      return out;
    }
  }
  return out;
}

pub function full_ret_binds(fd: FuncDecl, args: ast.Expr[], env: MEnv, funcs: MFns, vars: string[]): MEnv {
  let typed = arg_binds(fd, args, env, funcs, vars, MEnv { mnames: [], mtypes: [] }, false);
  return arg_binds(fd, args, env, funcs, vars, bound_binds(fd, typed, funcs), true);
}

function bound_binds(fd: FuncDecl, binds: MEnv, funcs: MFns): MEnv {
  let ns = binds.mnames;
  let ts = binds.mtypes;
  let k = 0;
  while (k < fd.type_params.len() && k < fd.bound_traits.len()) {
    let subject = binds.elook(fd.type_params[k]);
    if (subject.len() > 0) {
      for entry in split_plus_bounds(fd.bound_traits[k]) {
        let (n2, t2) = bound_entry_substitutions(entry, subject, funcs.impls, ns, ts);
        ns = n2;
        ts = t2;
      }
    }
    k += 1;
  }
  return MEnv { mnames: ns, mtypes: ts };
}

function arg_binds(fd: FuncDecl, args: ast.Expr[], env: MEnv, funcs: MFns, vars: string[], seed: MEnv, literals: boolean): MEnv {
  let binds = seed;
  for i in 0..fd.params.len() {
    if (i < args.len() && ast.int_literal_tree(args[i]) == literals) {
      let ct = mono_infer(args[i], env, funcs);
      let pattern = fd.params[i].type_name;
      if (pattern != "fn" && is_fn_contract_tag(pattern) && fd.params[i].fn_ret.len() > 0) {
        pattern = fn_tag_spelling(pattern, fd.params[i].fn_ret, fd.params[i].fn_param_types);
      }
      if (ct.len() > 0) {
        binds = bind_unify(pattern, ct, vars, binds, funcs);
      } else {
        binds = variant_arg_binds(fd.params[i].type_name, args[i], env, funcs, vars, binds);
      }
      if (fd.params[i].type_name == "fn" && spelling_mentions_tparam(fd.params[i].fn_ret, vars)) {
        let lr = lambda_ret_of(args[i], env, funcs);
        if (lr.len() > 0 && type_str_vars(lr, []).len() == 0) {
          binds = bind_unify(fd.params[i].fn_ret, lr, vars, binds, funcs);
        }
      }
      if (fd.params[i].type_name == "fn") {
        let fpts = split_top_commas(fd.params[i].fn_param_types);
        let lpts = lambda_param_types_of(args[i], env, funcs);
        for q in 0..fpts.len() {
          if (q < lpts.len() && lpts[q].len() > 0 && spelling_mentions_tparam(fpts[q], vars) && type_str_vars(lpts[q], []).len() == 0) {
            binds = bind_unify(fpts[q], lpts[q], vars, binds, funcs);
          }
        }
      }
    }
  }
  return binds;
}

function variant_arg_binds(pattern: string, arg: ast.Expr, env: MEnv, funcs: MFns, vars: string[], binds: MEnv): MEnv {
  if let ast.ExprCall(c) = arg {
    let vname = ctor_variant_name(c.callee, funcs.enums, env, funcs);
    if (vname.len() > 0) {
      let owner = genum_owner_of_variant(funcs.enums, vname);
      if (owner < 0) {
        return builtin_variant_arg_binds(pattern, c, env, funcs, vars, binds);
      }
      let ed = funcs.enums[owner];
      let own = me_variant_binds(ed, vname, c.args, env, funcs.structs, funcs);
      if (util.has_str(vars, pattern)) {
        let whole = bound_spelling(ed.name, ed.type_params, own);
        if (whole.len() == 0) {
          return binds;
        }
        return bind_unify(pattern, whole, vars, binds, funcs);
      }
      let pb = first_bracket(pattern);
      if (pb <= 0 || !pattern.ends_with("]")) {
        return binds;
      }
      if (!util.str_range_eq(pattern, 0, pb, ed.name)) {
        return binds;
      }
      let pargs = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
      if (pargs.len() != ed.type_params.len()) {
        return binds;
      }
      let out = binds;
      for j in 0..pargs.len() {
        let b = own.elook(ed.type_params[j]);
        if (b.len() > 0) {
          out = bind_unify(pargs[j], b, vars, out, funcs);
        }
      }
      return out;
    }
  }
  return binds;
}

function builtin_variant_arg_binds(pattern: string, c: ast.ExprCall, env: MEnv, funcs: MFns, vars: string[], binds: MEnv): MEnv {
  if (c.args.len() != 1 || number_literal_tree(c.args[0])) {
    return binds;
  }
  let slot: i32 = -1;
  let base = "";
  if let ast.ExprIdent(cid) = c.callee {
    if (cid.name == "Some") {
      base = "Option";
      slot = 0;
    }
    if (cid.name == "Ok") {
      base = "Result";
      slot = 0;
    }
    if (cid.name == "Err") {
      base = "Result";
      slot = 1;
    }
  }
  let pb = first_bracket(pattern);
  if (slot < 0 || pb <= 0 || !pattern.ends_with("]")) {
    return binds;
  }
  if (!util.str_range_eq(pattern, 0, pb, base)) {
    return binds;
  }
  let pargs = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
  if (slot >= pargs.len()) {
    return binds;
  }
  let pt = mono_infer(c.args[0], env, funcs);
  if (pt.len() == 0) {
    return binds;
  }
  return bind_unify(pargs[slot].trim(), pt, vars, binds, funcs);
}

pub function func_ret_of(funcs: MFns, name: string): string {
  let at = funcs.free_at(name);
  if (at < 0) {
    return "";
  }
  return funcs.decls[at].ret_type;
}

pub function me_map_args(rty: string): string[] {
  let r = parse_type_ref(rty);
  if (r.base != "Map" || r.args.len() != 2 || r.array_depth != 0) {
    return [];
  }
  return [render_type_ref(r.args[0]), render_type_ref(r.args[1])];
}

pub function call_ret_type(funcs: MFns, name: string, args: ast.Expr[], env: MEnv): string {
  let fi: i32 = -1;
  let e = funcs.pix.chain(name);
  while (e >= 0) {
    if (funcs.pix.names[e] == name) {
      fi = funcs.pat[e];
    }
    e = funcs.pix.next[e];
  }
  if (fi < 0) {
    return "";
  }
  return decl_call_ret_type(funcs, funcs.decls[fi], args, env);
}

function decl_call_ret_type(funcs: MFns, fd: FuncDecl, args: ast.Expr[], env: MEnv): string {
  // A function result is spelled whole, as a lambda gives it.
  let ret = fn_tag_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types);
  if (fd.type_params.len() == 0) {
    let evars = type_str_vars(ret, []);
    if (evars.len() == 0) {
      return ret;
    }
    return resolve_residual_ret(fd, args, env, funcs, ret, evars);
  }
  let key = infer_inst(fd, args, env, funcs);
  if (key.len() == 0) {
    return "";
  }
  let cts: string[] = [key];
  if (fd.type_params.len() != 1) {
    cts = util.split_char(key, b';');
  }
  let rt = resolve_proj_in_type(subst_ty(ret, fd.type_params, cts), funcs.impls);
  let rvars = type_str_vars(rt, []);
  if (rvars.len() > 0) {
    rt = resolve_residual_ret(fd, args, env, funcs, rt, rvars);
  }
  return rt;
}

function resolve_residual_ret(fd: FuncDecl, args: ast.Expr[], env: MEnv, funcs: MFns, rt0: string, rvars: string[]): string {
  let fb = full_ret_binds(fd, args, env, funcs, rvars);
  let rcts: string[] = [];
  for vi in 0..rvars.len() {
    let bv = fb.elook(rvars[vi]);
    if (bv.len() == 0) {
      bv = rvars[vi];
    }
    rcts = rcts.append(bv);
  }
  return subst_ty(rt0, rvars, rcts);
}

// The result type of the first function named method with the receiver type
// tyname, which is never empty here.
function assoc_ret_of(funcs: MFns, tyname: string, method: string): string {
  let i = funcs.rix.chain(method);
  while (i >= 0) {
    let fd = funcs.decls[funcs.rat[i]];
    if (funcs.rix.names[i] == method && fd.receiver_type == tyname) {
      return fd.ret_type;
    }
    i = funcs.rix.next[i];
  }
  return "";
}

pub function number_literal_tree(e: ast.Expr): boolean {
  return ast.int_literal_tree(e) || ast.float_literal_tree(e);
}

pub function settle_int_tree(e: ast.Expr, tag: string): ast.Expr {
  match (e) {
    ast.ExprNumber(n) => {
      let is_float = n.is_float || tag == "f32" || tag == "f64";
      return ast.ExprNumber { ...n, suffix: tag, is_float: is_float, bits: literal_bits(n.text, is_float) };
    },
    ast.ExprUnary(u) => {
      return ast.rebuild_unary(u, settle_int_tree(u.operand, tag), u.line, u.col, tag);
    },
    ast.ExprBinary(b) => {
      return ast.binary(b.op, settle_int_tree(b.left, tag), settle_int_tree(b.right, tag), b.line, b.col, tag);
    },
    _ => {
      return e;
    }
  }
}

function recv_method_ret_of(cfa: ast.ExprFieldAccess, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  let rvt = mono_infer(cfa.obj, env, funcs);
  if (rvt.len() == 0) {
    return "";
  }
  let concrete = concrete_array_method_at(funcs, rvt, cfa.field);
  if (concrete >= 0) {
    let call_args: ast.Expr[] = [cfa.obj];
    for arg in args {
      call_args = call_args.append(arg);
    }
    return decl_call_ret_type(funcs, funcs.decls[concrete], call_args, env);
  }
  let mrt = assoc_ret_of(funcs, rvt, cfa.field);
  if (mrt.len() == 0) {
    mrt = generic_recv_ret_of(funcs.decls, rvt, cfa.field);
  }
  if (mrt.len() == 0) {
    mrt = clone_recv_ret_of(funcs, rvt, cfa.field);
  }
  if (looks_type_var(mrt)) {
    return "";
  }
  return mrt;
}

function generic_recv_ret_of(funcs: FuncDecl[], tyname: string, method: string): string {
  let recv = parse_type_ref(tyname);
  if (recv.args.len() == 0) {
    return "";
  }
  let base = util.base_type_name(tyname);
  for i in 0..funcs.len() {
    if (funcs[i].name == method && funcs[i].receiver_type.len() > 0
      && util.base_type_name(funcs[i].receiver_type) == base) {
      let ns: string[] = [];
      let ts: string[] = [];
      let (n2, t2) = ref_bind(parse_type_ref(funcs[i].receiver_type), recv, [], ns, ts);
      if (n2.len() == 0) {
        return "";
      }
      return subst_ty(funcs[i].ret_type, n2, t2);
    }
  }
  return "";
}

function clone_recv_ret_of(funcs: MFns, tyname: string, method: string): string {
  let generic: StructDecl[] = [];
  for sd in funcs.structs {
    if (sd.type_params.len() > 0) {
      generic = generic.append(sd);
    }
  }
  for sd in generic {
    if (is_clone_of(tyname, sd.name)) {
      let key = slice_unchecked(tyname, sd.name.len() + 2, tyname.len()).to_owned();
      let args = split_key(key, sd.type_params.len(), funcs.structs, funcs.enums);
      if (args.len() != sd.type_params.len()) {
        return "";
      }
      let spelled = sd.name + "[";
      for k in 0..args.len() {
        if (k > 0) {
          spelled += ", ";
        }
        spelled += args[k];
      }
      let ret = generic_recv_ret_of(funcs.decls, spelled + "]", method);
      if (ret.len() == 0) {
        return "";
      }
      return mg_ty(ret, generic, Insts { inames: [], itypes: [], iargs: [] }).ty;
    }
  }
  return "";
}

pub function fold_base(t: string, method: string, funcs: MFns): string {
  let g = generic_base(t, funcs);
  if (g.len() > 0 || first_bracket(t) >= 0 || t.len() == 0) {
    return g;
  }
  if (bg_find(funcs, smm_name(t, method)) >= 0) {
    return t;
  }
  return "";
}

function generic_base(t: string, funcs: MFns): string {
  if (first_bracket(t) > 0 && t.ends_with("]")) {
    return strip_struct_base(t);
  }
  let owner = inst_struct(t, funcs);
  if (owner.at >= 0 && funcs.structs[owner.at].type_params.len() > 0) {
    return funcs.structs[owner.at].name;
  }
  return "";
}

function stamped_type(tag: string): string {
  if (util.has_str(["i32", "i64", "u8", "u16", "i16", "u32", "u64", "usize", "f32", "f64", "string", "boolean"], tag)) {
    return tag;
  }
  let elem = array_method_element(tag);
  if (elem.len() > 0 && stamped_type(elem).len() > 0) {
    return tag;
  }
  return "";
}

function mono_cell_get_type(field: ast.ExprFieldAccess, argc: i32, env: MEnv, funcs: MFns): string {
  if (field.field != "get" || argc != 0) {
    return "";
  }
  let receiver = parse_type_ref(mono_infer(field.obj, env, funcs));
  if (receiver.base == "Cell" && receiver.args.len() == 1) {
    return render_type_ref(receiver.args[0]);
  }
  return "";
}

function mono_named_call_type(c: ast.ExprCall, name: string, env: MEnv, funcs: MFns): string {
  if (name == "cell_new" && c.args.len() == 1) {
    let inner = mono_infer(c.args[0], env, funcs);
    if (inner.len() > 0) {
      return "Cell[" + inner + "]";
    }
  }
  let explicit = explicit_call_ret(c, name, funcs);
  if (explicit.len() > 0) {
    return explicit;
  }
  let result = call_ret_type(funcs, name, c.args, env);
  if (result.len() == 0 && !uninferred_generic_ret(funcs, name)) {
    result = func_ret_of(funcs, name);
  }
  if (result.len() == 0) {
    result = unsigned_call_type(c, name, env, funcs);
  }
  if (result.len() == 0 || hides_bare_var(result, funcs)) {
    return stamped_type(c.ty);
  }
  return result;
}

// The result of a call of a name with no Fern signature: a function value,
// a generic variant, or a builtin. The checker has not typed the call yet.
function unsigned_call_type(c: ast.ExprCall, name: string, env: MEnv, funcs: MFns): string {
  let fn_value = fn_spelling_ret(env.elook(name));
  if (fn_value.len() > 0) {
    return fn_value;
  }
  let variant = variant_call_type(c, name, env, funcs);
  if (variant.len() > 0) {
    return variant;
  }
  if (name == "Some" && c.args.len() == 1) {
    let inner = mono_infer(c.args[0], env, funcs);
    if (inner.len() > 0) {
      return "Option[" + inner + "]";
    }
  }
  if (!is_builtin_function(name)) {
    return "";
  }
  return builtinsigs.builtin_result(name);
}

// A generic variant constructor has the enum instance its arguments bind.
function variant_call_type(c: ast.ExprCall, name: string, env: MEnv, funcs: MFns): string {
  let owner = genum_owner_of_variant(funcs.enums, name);
  if (owner < 0) {
    return "";
  }
  let ed = funcs.enums[owner];
  let binds = me_variant_binds(ed, name, c.args, env, funcs.structs, funcs);
  let parts: string[] = [];
  for tp in ed.type_params {
    let b = binds.elook(tp);
    if (b.len() == 0) {
      return "";
    }
    parts = parts.append(b);
  }
  return ed.name + "[" + subst_ty_join(parts, ", ", [], []) + "]";
}

// A generic function's written result names its own type parameters, which are not this call's types.
function uninferred_generic_ret(funcs: MFns, name: string): boolean {
  let at = bg_find(funcs, name);
  return at >= 0 && spelling_mentions_tparam(funcs.decls[at].ret_type, funcs.decls[at].type_params);
}

function explicit_call_ret(c: ast.ExprCall, name: string, funcs: MFns): string {
  if (c.type_args.len() == 0) {
    return "";
  }
  let at = bg_find(funcs, name);
  if (at < 0) {
    return "";
  }
  let key = explicit_inst_key(funcs.decls[at], c.type_args);
  if (key.len() == 0) {
    return "";
  }
  return subst_ty(funcs.decls[at].ret_type, funcs.decls[at].type_params, key_parts(funcs.decls[at], key));
}

// The result type of a call to the function that the field `cfa.field` of
// a struct holds, or "" when the field is not a function.
function field_call_type(cfa: ast.ExprFieldAccess, env: MEnv, funcs: MFns): string {
  let owner = mono_infer(cfa.obj, env, funcs);
  if (owner.len() == 0) {
    return "";
  }
  return callable_ret_spelling(lit_field_spelling(funcs, owner, owner, cfa.field));
}

pub function mono_infer(e: ast.Expr, env: MEnv, funcs: MFns): string {
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return "f64";
      }
      if (n.suffix.len() > 0) {
        return n.suffix;
      }
      if (ast.literal_is_i64(n.text)) {
        return "i64";
      }
      return "i32";
    },
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprBool(_) => {
      return "boolean";
    },
    ast.ExprArray(a) => {
      if (a.elements.len() == 0) {
        return "";
      }
      let et = mono_infer(a.elements[0], env, funcs);
      if (et.len() == 0) {
        return "";
      }
      if (number_literal_tree(a.elements[0])) {
        for el in a.elements {
          if (!number_literal_tree(el)) {
            let st = mono_infer(el, env, funcs);
            if (is_scalar_ret_name(st) && st != "boolean") {
              return st + "[]";
            }
          }
        }
      }
      return et + "[]";
    },
    ast.ExprIdent(id) => {
      let local = env.elook(id.name);
      if (local.len() > 0) {
        return local;
      }
      return const_type(id.name, funcs);
    },
    ast.ExprSlice(sl) => {
      let source = mono_infer(sl.array, env, funcs);
      if (source == "string" || source == "str") {
        return "Option[str]";
      }
      let elem = array_method_element(source);
      if (elem.len() > 0) {
        return "[" + elem + "]";
      }
      return "";
    },
    ast.ExprLambda(lm) => {
      let lps = "";
      for li in 0..lm.params.len() {
        if (lm.params[li].type_name.len() == 0) {
          return "";
        }
        if (li > 0) {
          lps += ", ";
        }
        lps += param_spelling(lm.params[li]);
      }
      let lret = lambda_ret_of(e, env, funcs);
      if (lret.len() == 0) {
        return "";
      }
      if (lm.once) {
        return "once (" + lps + ") => " + lret;
      }
      return "(" + lps + ") => " + lret;
    },
    ast.ExprBinary(b) => {
      if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "&&" || b.op == "||") {
        return "boolean";
      }
      return mono_infer(b.left, env, funcs);
    },
    ast.ExprUnary(u) => {
      if (u.op == "!") {
        return "boolean";
      }
      if (is_cast_op(u.op)) {
        return u.cast;
      }
      if (u.op == ast.CHECKED_CAST) {
        return "Option[" + u.cast + "]";
      }
      if (u.op == "try_") {
        return try_payload_spelling(mono_infer(u.operand, env, funcs));
      }
      return mono_infer(u.operand, env, funcs);
    },
    ast.ExprStructLit(sl) => {
      return struct_lit_spelling(sl, env, funcs);
    },
    ast.ExprTuple(tu) => {
      let inner = "";
      for ti in 0..tu.elements.len() {
        let et = mono_infer(tu.elements[ti], env, funcs);
        if (et.len() == 0) {
          return "";
        }
        if (ti > 0) {
          inner += ", ";
        }
        inner += et;
      }
      return "(" + inner + ")";
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return mono_named_call_type(c, cid.name, env, funcs);
        },
        ast.ExprFieldAccess(cfa) => {
          let cell_type = mono_cell_get_type(cfa, c.args.len(), env, funcs);
          if (cell_type.len() > 0) {
            return cell_type;
          }
          if ((cfa.field == "to_string" || cfa.field == "to_debug") && c.args.len() == 0) {
            return "string";
          }
          if (cfa.field == "append" && c.args.len() == 1 || cfa.field == "with" && c.args.len() == 2) {
            let brt = mono_infer(cfa.obj, env, funcs);
            if (array_method_element(brt).len() > 0) {
              return brt;
            }
          }
          let amgi = bg_find(funcs, "__arrm_" + cfa.field);
          let vmgi = bg_find(funcs, "__viewm_" + cfa.field);
          if (amgi >= 0 || vmgi >= 0) {
            let recvt = mono_infer(cfa.obj, env, funcs);
            if (spelling_is_view(recvt)) {
              amgi = vmgi;
            }
            let el = array_method_element(recvt);
            if (amgi >= 0 && el.len() > 0) {
              let amrt = subst_ty(funcs.decls[amgi].ret_type, [funcs.decls[amgi].type_params[0]], [el + ""]);
              let amvars = type_str_vars(amrt, []);
              if (amvars.len() > 0) {
                let amargs: ast.Expr[] = [cfa.obj];
                for amk in 0..c.args.len() {
                  amargs = amargs.append(c.args[amk]);
                }
                amrt = resolve_residual_ret(funcs.decls[amgi], amargs, env, funcs, amrt, amvars);
              }
              return amrt;
            }
          }
          let mmrt = mapm_ret_of(cfa, c.args, env, funcs);
          if (mmrt.len() > 0) {
            return mmrt;
          }
          let srt = "";
          if (smm_any(funcs, cfa.field)) {
            srt = mono_infer(cfa.obj, env, funcs);
          }
          if (fold_base(srt, cfa.field, funcs).len() > 0) {
            let sgi = bg_find(funcs, smm_name(fold_base(srt, cfa.field, funcs), cfa.field));
            if (sgi >= 0) {
              let sargs: ast.Expr[] = [cfa.obj];
              for sk in 0..c.args.len() {
                sargs = sargs.append(c.args[sk]);
              }
              let skey = infer_inst(funcs.decls[sgi], sargs, env, funcs);
              if (skey.len() > 0) {
                return subst_ty(funcs.decls[sgi].ret_type, funcs.decls[sgi].type_params, util.split_char(skey, b';'));
              }
            }
          }
          let mrt = recv_method_ret_of(cfa, c.args, env, funcs);
          if (mrt.len() > 0) {
            return mrt;
          }
          match (cfa.obj) {
            ast.ExprIdent(oid) => {
              let qrt = call_ret_type(funcs, oid.name + "." + cfa.field, c.args, env);
              if (qrt.len() > 0) {
                return qrt;
              }
              let art = assoc_ret_of(funcs, oid.name, cfa.field);
              if (art.len() > 0) {
                return art;
              }
            },
            _ => {}
          }
          let held = field_call_type(cfa, env, funcs);
          if (held.len() > 0) {
            return held;
          }
          return stamped_type(c.ty);
        },
        ast.ExprLambda(lm) => {
          if (!mono_ty_mentions_var(lm.ret_type)) {
            return lm.ret_type;
          }
          return "";
        },
        _ => {
          return stamped_type(c.ty);
        }
      }
    },
    ast.ExprIndex(ix) => {
      let at = mono_infer(ix.array, env, funcs);
      let el = array_method_element(at);
      if (el.len() > 0) {
        if (hides_bare_var(el, funcs)) {
          return "";
        }
        return el;
      }
      return stamped_type(ix.ty);
    },
    ast.ExprFieldAccess(fa) => {
      let ot = mono_infer(fa.obj, env, funcs);
      if (ot.len() == 0) {
        return "";
      }
      if (util.is_all_digits(fa.field) && util.is_tuple_type_name(ot)) {
        let elems = split_top_commas(slice_unchecked(ot, 1, ot.len() - 1).to_owned());
        let k = util.digits_to_i32(fa.field);
        if (k >= elems.len() || hides_var(elems[k], funcs)) {
          return "";
        }
        return elems[k];
      }
      if (hides_var(ot, funcs)) {
        return "";
      }
      let ft = struct_field_ty_inst(ot, fa.field, funcs);
      if (hides_var(ft, funcs)) {
        return "";
      }
      return ft;
    },
    _ => {
      return "";
    }
  }
}

function hides_var(t: string, funcs: MFns): boolean {
  return !funcs.keep_vars && mono_ty_mentions_var(t);
}

function hides_bare_var(t: string, funcs: MFns): boolean {
  return !funcs.keep_vars && looks_type_var(t);
}

function inserted_map(cfa: ast.ExprFieldAccess, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  let rt = mono_infer(cfa.obj, env, funcs);
  if (me_map_args(rt).len() == 2) {
    return rt;
  }
  if (!map_literal_chain(cfa.obj)) {
    return "";
  }
  let kt = mono_infer(args[0], env, funcs);
  let vt = mono_infer(args[1], env, funcs);
  if (kt.len() == 0 || vt.len() == 0) {
    return "";
  }
  return "Map[" + kt + ", " + vt + "]";
}

function map_literal_chain(e: ast.Expr): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      return id.name == "map_new" || id.name == "__map_new_i32";
    }
    if let ast.ExprFieldAccess(fa) = c.callee {
      return fa.field == "insert" && map_literal_chain(fa.obj);
    }
  }
  return false;
}

function mapm_ret_of(cfa: ast.ExprFieldAccess, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  if (cfa.field == "insert" && args.len() == 2) {
    return inserted_map(cfa, args, env, funcs);
  }
  let gi = bg_find(funcs, "__mapm_" + cfa.field);
  let snapshot = args.len() == 0 && (cfa.field == "keys" || cfa.field == "values");
  let read = cfa.field == "get_or" && args.len() == 2 || cfa.field == "get" && args.len() == 1;
  if (gi < 0 && !snapshot && !read) {
    return "";
  }
  let rt = mono_infer(cfa.obj, env, funcs);
  if (rt.len() < 4 || !rt.starts_with("Map[")) {
    return "";
  }
  if (gi < 0) {
    let kv = type_args_of(rt);
    if (kv.len() != 2) {
      return "";
    }
    if (cfa.field == "get_or") {
      return kv[1];
    }
    if (cfa.field == "get") {
      return "Option[" + kv[1] + "]";
    }
    if (cfa.field == "keys") {
      return kv[0] + "[]";
    }
    return kv[1] + "[]";
  }
  let all: ast.Expr[] = [cfa.obj];
  for a in args {
    all = all.append(a);
  }
  let key = infer_inst(funcs.decls[gi], all, env, funcs);
  if (key.len() == 0) {
    return "";
  }
  return subst_ty(funcs.decls[gi].ret_type, funcs.decls[gi].type_params, util.split_char(key, b';'));
}

pub function mono_ty_mentions_var(t: string): boolean {
  let none: string[] = [];
  return type_str_vars(t, none).len() > 0;
}

function mono_variant_payload_ty(sty: string, vname: string, fns: MFns): string {
  if (hides_var(sty, fns)) {
    return "";
  }
  return builtin_variant_payload_type(sty, vname);
}

pub function builtin_variant_payload_type(sty: string, vname: string): string {
  let bare = pat_variant_bare(vname);
  let n = sty.len();
  if (n >= 8 && sty.starts_with("Option[") && sty[n - 1] == b']') {
    if (bare == "Some") {
      return slice_unchecked(sty, 7, n - 1).to_owned().trim();
    }
    return "";
  }
  if (n >= 8 && sty.starts_with("Result[") && sty[n - 1] == b']') {
    let parts = split_top_commas(slice_unchecked(sty, 7, n - 1).to_owned());
    if (parts.len() != 2) {
      return "";
    }
    if (bare == "Ok") {
      return parts[0].trim();
    }
    if (bare == "Err") {
      return parts[1].trim();
    }
  }
  return "";
}

pub function mono_arm_env(env: MEnv, pat: ast.Pattern, sty: string, funcs: MFns): MEnv {
  let aenv = env;
  match (pat) {
    ast.PatVariant(pv) => {
      let ftys = mono_variant_field_tys(sty, pv.type_name, funcs);
      if (pv.binding.len() > 0 && pv.binding != "_") {
        let bty = mono_variant_payload_ty(sty, pv.type_name, funcs);
        if (bty.len() == 0 && ftys.len() > 0) {
          bty = ftys[0];
        }
        aenv = aenv.ebind(pv.binding, bty);
      }
      for xbi in 0..pv.extra_bindings.len() {
        if (pv.extra_bindings[xbi].len() > 0 && pv.extra_bindings[xbi] != "_") {
          let xty = "";
          if (xbi + 1 < ftys.len()) {
            xty = ftys[xbi + 1];
          }
          aenv = aenv.ebind(pv.extra_bindings[xbi], xty);
        }
      }
      if (pv.at_binding.len() > 0) {
        let aty = sty;
        if (hides_var(aty, funcs)) {
          aty = "";
        }
        aenv = aenv.ebind(pv.at_binding, aty);
      }
    },
    _ => {}
  }
  return aenv;
}

function pat_variant_bare(vname: string): string {
  let bare = vname;
  for di in 0..vname.len() {
    if (vname[di] == b'.') {
      bare = slice_unchecked(vname, di + 1, vname.len()).to_owned();
    }
  }
  return bare;
}

pub function type_args_of(ty: string): string[] {
  let out: string[] = [];
  let lb = first_bracket(ty);
  if (lb <= 0 || !ty.ends_with("]")) {
    return out;
  }
  let parts = split_top_commas(slice_unchecked(ty, lb + 1, ty.len() - 1));
  for i in 0..parts.len() {
    out = out.append(parts[i].trim());
  }
  return out;
}

pub function mono_variant_field_tys(sty: string, vname: string, fns: MFns): string[] {
  let none: string[] = [];
  if (sty.len() == 0 || hides_var(sty, fns)) {
    return none;
  }
  return variant_field_types(sty, vname, fns.enums, fns.structs, []);
}

pub function variant_field_types(sty: string, vname: string, enums: EnumDecl[], structs: StructDecl[], field_names: string[]): string[] {
  let none: string[] = [];
  let base = strip_struct_base(sty);
  let ei: i32 = -1;
  let i = 0;
  while (i < enums.len()) {
    if (enums[i].name == base) {
      ei = i;
      i = enums.len();
    } else {
      i += 1;
    }
  }
  if (ei < 0) {
    return none;
  }
  let ed = enums[ei];
  let cts = type_args_of(sty);
  if (cts.len() != ed.type_params.len()) {
    return none;
  }
  let Some(vi) = variant_struct_index(structs, pat_variant_bare(vname), ed.name) else {
    return none;
  };
  let fields = structs[vi].fields;
  let out: string[] = [];
  if (field_names.len() > 0) {
    for name in field_names {
      let at = util.index_of_str(structs[vi].variant_field_names, name);
      if (at < 0 || at >= fields.len()) {
        return none;
      }
      out = out.append(subst_ty(fields[at].type_name, ed.type_params, cts));
    }
    return out;
  }
  for fi in 0..fields.len() {
    out = out.append(subst_ty(fields[fi].type_name, ed.type_params, cts));
  }
  return out;
}

function struct_field_ty_inst(ot: string, fname: string, funcs: MFns): string {
  let owner = inst_struct(ot, funcs);
  let structs = funcs.structs;
  if (owner.at < 0) {
    return "";
  }
  for f in structs[owner.at].fields {
    if (f.name == fname) {
      return subst_ty(field_spelling(f), structs[owner.at].type_params, owner.cts);
    }
  }
  return "";
}

pub function field_spelling(f: StructFieldDecl): string {
  return fn_tag_spelling(f.type_name, f.fn_ret, f.fn_param_types);
}

struct InstStruct { at: i32, cts: string[] }

pub function inst_struct(ot: string, funcs: MFns): InstStruct {
  let cts = type_args_of(ot);
  let si = first_struct_named(funcs, strip_struct_base(ot), false);
  if (first_bracket(ot) < 0) {
    let k = 1;
    while (k + 2 < ot.len() && si != 0) {
      if (ot[k] == b'_' && ot[k + 1] == b'_') {
        let gi = first_struct_named(funcs, slice_unchecked(ot, 0, k).to_owned(), true);
        if (gi >= 0 && (si < 0 || gi < si)) {
          si = gi;
          cts = split_key(slice_unchecked(ot, k + 2, ot.len()).to_owned(), funcs.structs[gi].type_params.len(), funcs.structs, funcs.enums);
        }
      }
      k += 1;
    }
  }
  if (si < 0 || cts.len() != funcs.structs[si].type_params.len()) {
    return InstStruct { at: -1, cts: [] };
  }
  return InstStruct { at: si, cts: cts };
}

function first_struct_named(funcs: MFns, name: string, generic: boolean): i32 {
  let i = funcs.snames.chain(name);
  while (i >= 0) {
    let sd = funcs.structs[i];
    if (funcs.snames.names[i] == name && sd.enum_owner.len() == 0 && (!generic || sd.type_params.len() > 0)) {
      return i;
    }
    i = funcs.snames.next[i];
  }
  return -1;
}

pub function menv_bind_destructure(env: MEnv, d: ast.Destr, ty: string): MEnv {
  let parts = d.binds;
  if (parts.len() <= 1) {
    return env;
  }
  if (ty.len() < 2 || !ty.starts_with("(") || !ty.ends_with(")")) {
    return env;
  }
  let tys = split_top_commas(slice_unchecked(ty, 1, ty.len() - 1));
  if (tys.len() != parts.len()) {
    return env;
  }
  let e = env;
  for i in 0..parts.len() {
    let et = tys[i].trim();
    if (parts[i].nested.len() > 0) {
      e = menv_bind_destructure(e, parts[i].nested[0], et);
    } else if (parts[i].name.len() > 0) {
      e = e.ebind(parts[i].name, et);
    }
  }
  return e;
}

pub function env_from_params(params: ast.ParamDecl[]): MEnv {
  return bind_params(MEnv { mnames: [], mtypes: [] }, params);
}

pub function bind_params(env: MEnv, params: ast.ParamDecl[]): MEnv {
  let e = env;
  for i in 0..params.len() {
    let pt = params[i].type_name;
    if (is_fn_contract_tag(pt) && params[i].fn_ret.len() > 0) {
      pt = fn_tag_spelling(pt, params[i].fn_ret, params[i].fn_param_types);
    }
    e = e.ebind(params[i].name, pt);
  }
  return e;
}

pub function env_from_decl(fd: FuncDecl): MEnv {
  let e = env_from_params(fd.params);
  if (fd.receiver_name.len() == 0) {
    return e;
  }
  return e.ebind(fd.receiver_name, fd.receiver_type);
}

pub function subst_ty_list(list: string, tparams: string[], cts: string[]): string {
  if (list.len() == 0) {
    return "";
  }
  return subst_ty_join(split_top_commas(list), ",", tparams, cts);
}

pub function subst_ty_join(parts: string[], sep: string, tparams: string[], cts: string[]): string {
  let out = "";
  for i in 0..parts.len() {
    if (i > 0) {
      out += sep;
    }
    out += subst_ty(parts[i], tparams, cts);
  }
  return out;
}

function subst_ty_each(tys: string[], tparams: string[], cts: string[]): string[] {
  let out: string[] = [];
  for t in tys {
    out = out.append(subst_ty(t, tparams, cts));
  }
  return out;
}

pub function subst_ty(name: string, tparams: string[], cts: string[]): string {
  let k = tp_index(name, tparams);
  if (k >= 0) {
    return cts[k];
  }
  if (name.len() > 4 && name.starts_with("own ")) {
    return "own " + subst_ty(slice_unchecked(name, 4, name.len()).to_owned(), tparams, cts);
  }
  let once = once_fn_body(name);
  if (once.len() > 0) {
    return "once " + subst_ty(once, tparams, cts);
  }
  if (spelling_is_view(name)) {
    return "[" + subst_ty(slice_unchecked(name, 1, name.len() - 1).to_owned(), tparams, cts) + "]";
  }
  if (type_ends_arr(name)) {
    return array_of_spelling(subst_ty(elem_spelling(name), tparams, cts));
  }
  if (name.len() > 0 && name[0] == b'(' && util.contains(name, "=>")) {
    let fref = parse_type_ref(name);
    if (fref.is_fn) {
      let parts: string[] = [];
      let changed = false;
      for a in fref.args {
        let sp = render_type_ref(a);
        let sub = subst_ty(sp, tparams, cts);
        if (sub != sp) {
          changed = true;
        }
        parts = parts.append(sub);
      }
      if (!changed) {
        return name;
      }
      let out = "(";
      let i = 0;
      while (i + 1 < parts.len()) {
        if (i > 0) {
          out += ", ";
        }
        out += parts[i];
        i += 1;
      }
      return out + ") => " + parts[parts.len() - 1];
    }
  }
  if (util.is_tuple_type_name(name) && name.ends_with(")")) {
    return "(" + subst_ty_join(split_top_commas(slice_unchecked(name, 1, name.len() - 1)), ", ", tparams, cts) + ")";
  }
  let lb = first_bracket(name);
  if (lb > 0 && name.ends_with("]")) {
    return canon_vec(slice_unchecked(name, 0, lb) + "[" + subst_ty_join(split_top_commas(slice_unchecked(name, lb + 1, name.len() - 1)), ", ", tparams, cts) + "]");
  }
  let ps = name.len() - 1;
  while (ps > 0 && ident_byte(name[ps] as i32)) {
    ps -= 1;
  }
  if (ps > 1 && ps < name.len() - 1 && name[ps] == b':' && name[ps - 1] == b':') {
    return subst_ty(slice_unchecked(name, 0, ps - 1).to_owned(), tparams, cts) + slice_unchecked(name, ps - 1, name.len());
  }
  return name;
}

function subst_expr(e: ast.Expr, tparams: string[], cts: string[]): ast.Expr {
  match (e) {
    ast.ExprIdent(id) => {
      let k = tp_index(id.name, tparams);
      if (k >= 0 && is_const_arg(cts[k])) {
        return e;
      }
      if (k >= 0) {
        return ast.ExprIdent { ...id, name: cts[k] };
      }
      return e;
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, obj: subst_expr(fa.obj, tparams, cts) };
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(cfa) => {
          match (cfa.obj) {
            ast.ExprIdent(oid) => {
              if (c.args.len() == 0) {
                let pk = tp_index(oid.name, tparams);
                if (pk >= 0) {
                  if (cfa.field == "default" && dv_is_scalar(cts[pk])) {
                    return dv_default_expr(cts[pk]);
                  }
                  if (cfa.field == "zero" && dv_is_num_scalar(cts[pk])) {
                    return dv_num_identity_expr(cts[pk], false);
                  }
                  if (cfa.field == "one" && dv_is_num_scalar(cts[pk])) {
                    return dv_num_identity_expr(cts[pk], true);
                  }
                }
              }
            },
            _ => {}
          }
        },
        _ => {}
      }
      let na: ast.Expr[] = [];
      for ci in 0..c.args.len() {
        na = na.append(subst_expr(c.args[ci], tparams, cts));
      }
      return ast.ExprCall { callee: subst_expr(c.callee, tparams, cts), args: na, line: c.line, col: c.col, type_args: subst_ty_each(c.type_args, tparams, cts), ty: c.ty };
    },
    ast.ExprStructLit(sl) => {
      let nv: ast.Expr[] = [];
      for si in 0..sl.field_values.len() {
        nv = nv.append(subst_expr(sl.field_values[si], tparams, cts));
      }
      let nb = sl.base;
      if (sl.has_base) {
        nb = subst_expr(sl.base, tparams, cts);
      }
      return ast.ExprStructLit { ...sl, field_values: nv, base: nb, written: subst_ty(sl.written, tparams, cts) };
    },
    ast.ExprBinary(b) => {
      return ast.binary(b.op, subst_expr(b.left, tparams, cts), subst_expr(b.right, tparams, cts), b.line, b.col, b.ty);
    },
    ast.ExprUnary(u) => {
      return ast.rebuild_unary(u, subst_expr(u.operand, tparams, cts), u.line, u.col, u.ty);
    },
    ast.ExprIndex(ix) => {
      return ast.ExprIndex { array: subst_expr(ix.array, tparams, cts), index: subst_expr(ix.index, tparams, cts), unchecked: ix.unchecked, ty: ix.ty, line: ix.line, col: ix.col };
    },
    ast.ExprSlice(sl2) => {
      return ast.ExprSlice { ...sl2, array: subst_expr(sl2.array, tparams, cts), start: subst_expr(sl2.start, tparams, cts), end: subst_expr(sl2.end, tparams, cts) };
    },
    ast.ExprArray(ar) => {
      let ne: ast.Expr[] = [];
      for ai in 0..ar.elements.len() {
        ne = ne.append(subst_expr(ar.elements[ai], tparams, cts));
      }
      return ast.ExprArray { ...ar, elements: ne };
    },
    ast.ExprTuple(tp) => {
      let nt: ast.Expr[] = [];
      for ti in 0..tp.elements.len() {
        nt = nt.append(subst_expr(tp.elements[ti], tparams, cts));
      }
      return ast.ExprTuple { ...tp, elements: nt };
    },
    ast.ExprLambda(lm) => {
      let lps: ast.ParamDecl[] = [];
      for lpd in lm.params {
        lps = lps.append(ast.ParamDecl { ...lpd, type_name: subst_ty(lpd.type_name, tparams, cts), fn_ret: subst_ty(lpd.fn_ret, tparams, cts), fn_param_types: subst_ty_list(lpd.fn_param_types, tparams, cts) });
      }
      return ast.ExprLambda { ...lm, params: lps, ret_type: subst_ty(lm.ret_type, tparams, cts), ret_fn_ret: subst_ty(lm.ret_fn_ret, tparams, cts), ret_fn_param_types: subst_ty_list(lm.ret_fn_param_types, tparams, cts), body: subst_stmts(lm.body, tparams, cts), captures: [], captures_known: false };
    },
    _ => {
      return e;
    }
  }
}

pub function subst_stmts(stmts: ast.Stmt[], tparams: string[], cts: string[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for i in 0..stmts.len() {
    let st = stmts[i];
    match (st) {
      ast.StmtVar(v) => {
        out = out.append(ast.StmtVar { name: v.name, type_name: subst_ty(v.type_name, tparams, cts), init: subst_expr(v.init, tparams, cts), line: v.line, col: v.col, fn_ret: subst_ty(v.fn_ret, tparams, cts), fn_param_types: subst_ty_list(v.fn_param_types, tparams, cts), destr: v.destr, header: v.header });
      },
      ast.StmtReturn(r) => {
        out = out.append(ast.StmtReturn { value: subst_expr(r.value, tparams, cts), line: r.line, col: r.col });
      },
      ast.StmtExpr(x) => {
        out = out.append(ast.StmtExpr { ...x, value: subst_expr(x.value, tparams, cts) });
      },
      ast.StmtAssign(a) => {
        out = out.append(ast.StmtAssign { ...a, value: subst_expr(a.value, tparams, cts) });
      },
      ast.StmtIf(f) => {
        out = out.append(ast.StmtIf { ...f, cond: subst_expr(f.cond, tparams, cts), then_body: subst_stmts(f.then_body, tparams, cts), else_body: subst_stmts(f.else_body, tparams, cts) });
      },
      ast.StmtWhile(w) => {
        out = out.append(ast.StmtWhile { cond: subst_expr(w.cond, tparams, cts), body: subst_stmts(w.body, tparams, cts), label: w.label, line: w.line, is_loop: w.is_loop });
      },
      ast.StmtFor(fr) => {
        out = out.append(ast.StmtFor { var_name: fr.var_name, iter: subst_expr(fr.iter, tparams, cts), body: subst_stmts(fr.body, tparams, cts), label: fr.label, line: fr.line, col: fr.col, destr: fr.destr });
      },
      ast.StmtMatch(m) => {
        let arms: ast.MatchArm[] = [];
        for j in 0..m.arms.len() {
          arms = arms.append(ast.MatchArm { pattern: m.arms[j].pattern, body: subst_stmts(m.arms[j].body, tparams, cts), line: m.arms[j].line, col: m.arms[j].col, guard: subst_expr(m.arms[j].guard, tparams, cts), has_guard: m.arms[j].has_guard, alt_cont: false });
        }
        out = out.append(ast.StmtMatch { ...m, scrutinee: subst_expr(m.scrutinee, tparams, cts), arms: arms });
      },
      ast.StmtDefer(d) => {
        out = out.append(ast.StmtDefer { ...d, action: subst_stmts([d.action], tparams, cts)[0] });
      },
      _ => {
        out = out.append(st);
      }
    }
  }
  return out;
}

pub function bound_entry_substitutions(entry: string, concrete: string, impls: ImplInfo[], names: string[], types: string[]): (string[], string[]) {
  let bref = parse_type_ref(entry);
  if (bref.args.len() == 0) {
    return (names, types);
  }
  let tr_name = derive_simple_name(util.base_type_name(entry));
  let cref = parse_type_ref(concrete);
  for im in impls {
    if (im.trait_name != tr_name) {
      continue;
    }
    if (util.base_type_name(im.impl_type) != util.base_type_name(concrete)) {
      continue;
    }
    let iref = parse_type_ref(im.trait_ref);
    if (iref.args.len() != bref.args.len()) {
      continue;
    }
    let pn: string[] = [];
    let pt: string[] = [];
    let (pn2, pt2) = ref_bind(parse_type_ref(im.impl_type), cref, im.all_type_params, pn, pt);
    let ns = names;
    let ts = types;
    for j in 0..bref.args.len() {
      let got = subst_ty(render_type_ref(iref.args[j]), pn2, pt2);
      let (n3, t3) = ref_bind(bref.args[j], parse_type_ref(got), [], ns, ts);
      ns = n3;
      ts = t3;
    }
    return (ns, ts);
  }
  return (names, types);
}

pub function ref_bind(pattern: TypeRef, actual: TypeRef, vars: string[], names: string[], types: string[]): (string[], string[]) {
  let ns = names;
  let ts = types;
  if (pattern.array_depth > 0) {
    if (actual.array_depth != pattern.array_depth) {
      return (ns, ts);
    }
    return ref_bind(elem_type_ref(pattern), elem_type_ref(actual), vars, ns, ts);
  }
  if (pattern.args.len() == 0) {
    let leaf = pattern.base;
    let binds = util.index_of_str(vars, leaf) >= 0;
    if (vars.len() == 0) {
      binds = looks_type_var(leaf);
    }
    if (binds && tp_index(leaf, ns) < 0) {
      ns = ns.append(leaf);
      ts = ts.append(render_type_ref(actual));
    }
    return (ns, ts);
  }
  if (pattern.base != actual.base || pattern.args.len() != actual.args.len()) {
    return (ns, ts);
  }
  for i in 0..pattern.args.len() {
    let (n2, t2) = ref_bind(pattern.args[i], actual.args[i], vars, ns, ts);
    ns = n2;
    ts = t2;
  }
  return (ns, ts);
}

pub function split_plus_bounds(bound: string): string[] {
  let out: string[] = [];
  if (is_const_bound(bound)) {
    return out;
  }
  let start = 0;
  let depth = 0;
  for i in 0..=bound.len() {
    if (i < bound.len() && bound[i] == b'[') {
      depth += 1;
    } else if (i < bound.len() && bound[i] == b']') {
      depth -= 1;
    }
    if (i == bound.len() || depth == 0 && bound[i] == b'+') {
      let entry = slice_unchecked(bound, start, i).to_owned().trim();
      if (entry.len() > 0) {
        out = out.append(entry);
      }
      start = i + 1;
    }
  }
  return out;
}

struct BoundUse { env: MEnv, funcs: MFns, ord: string[], eq: string[], routed: string[], bases: string[], traits: string[][], by_trait: boolean }

pub function bound_use(fd: FuncDecl, cts: string[], reqs: TraitReq[], funcs: MFns): BoundUse {
  let ord: string[] = [];
  let eq: string[] = [];
  let k = 0;
  while (k < fd.type_params.len() && k < fd.bound_traits.len() && k < cts.len()) {
    if (bound_supplies(reqs, fd.bound_traits[k], "cmp") && !native_order_agrees(cts[k])) {
      ord = ord.append(fd.type_params[k]);
    }
    if (bound_supplies(reqs, fd.bound_traits[k], "eq") && !native_eq_agrees(cts[k])) {
      eq = eq.append(fd.type_params[k]);
    }
    k += 1;
  }
  let (routed, bases, traits) = bound_routes(fd, cts, funcs);
  return BoundUse { env: env_from_decl(fd), funcs: MFns { ...funcs, keep_vars: true }, ord: ord, eq: eq, routed: routed, bases: bases, traits: traits, by_trait: false };
}

pub function route_bound_calls(fd: FuncDecl, cts: string[], reqs: TraitReq[], funcs: MFns): ast.Stmt[] {
  let ctx = BoundUse { ...bound_use(fd, cts, reqs, funcs), by_trait: true };
  if (ctx.ord.len() == 0 && ctx.eq.len() == 0 && ctx.routed.len() == 0) {
    return fd.body;
  }
  let (out, after) = bc_body(fd.body, ctx);
  return out;
}

function bound_routes(fd: FuncDecl, cts: string[], funcs: MFns): (string[], string[], string[][]) {
  let routed: string[] = [];
  let bases: string[] = [];
  let traits: string[][] = [];
  let k = 0;
  while (k < fd.type_params.len() && k < fd.bound_traits.len() && k < cts.len()) {
    let base = util.base_type_name(cts[k]);
    if (fd.bound_traits[k].len() > 0 && util.has_str(funcs.renamed, base)) {
      routed = routed.append(fd.type_params[k]);
      bases = bases.append(base);
      traits = traits.append(split_plus_bounds(fd.bound_traits[k]));
    }
    k += 1;
  }
  return (routed, bases, traits);
}

function bound_method(ty: string, m: string, receiver: boolean, ctx: BoundUse): string {
  let k = util.index_of_str(ctx.routed, ty);
  if (k < 0) {
    return m;
  }
  let Some(at) = trait_provider_index(ctx.funcs.decls, ctx.bases[k], ctx.traits[k], m, receiver) else {
    return m;
  };
  let fd = ctx.funcs.decls[at];
  if (ctx.by_trait && receiver && fd.impl_trait.len() > 0) {
    return fd.impl_trait + "." + derive_simple_name(fd.name);
  }
  return fd.name;
}

function bound_field(fa: ast.ExprFieldAccess, ctx: BoundUse): string {
  if let ast.ExprIdent(id) = fa.obj {
    if (!util.has_str(ctx.env.mnames, id.name)) {
      return bound_method(id.name, fa.field, false, ctx);
    }
  }
  return bound_method(mono_infer(fa.obj, ctx.env, ctx.funcs), fa.field, true, ctx);
}

function bound_supplies(reqs: TraitReq[], bound: string, method: string): boolean {
  for entry in split_plus_bounds(bound) {
    for ri in trait_closure(reqs, derive_simple_name(util.base_type_name(entry)), "") {
      if (util.has_str(reqs[ri].methods, method) || util.has_str(reqs[ri].provided, method)) {
        return true;
      }
    }
  }
  return false;
}

function native_order_agrees(t: string): boolean {
  return util.has_str(["i32", "i64", "u32", "u64", "u8", "u16", "i16", "usize", "f32", "f64", "string"], t);
}

function native_eq_agrees(t: string): boolean {
  return native_order_agrees(t) || t == "boolean" || t == "char";
}

pub function bc_body(stmts: ast.Stmt[], ctx: BoundUse): (ast.Stmt[], BoundUse) {
  let out: ast.Stmt[] = [];
  let cur = ctx;
  for stmt in stmts {
    let (ns, na, nh) = astwalk.map_stmt_where(stmt, cur, bc_stmt, bc_expr, astwalk.descend_all);
    out = out.append(ns);
    cur = na;
  }
  return (out, ctx);
}

function bc_rewrite(e: ast.Expr, ctx: BoundUse): ast.Expr {
  let (out, a, h) = astwalk.map_expr_where(e, ctx, bc_stmt, bc_expr, astwalk.descend_all);
  return out;
}

function bc_stmt(st: ast.Stmt, ctx: BoundUse): (ast.Stmt, BoundUse, boolean) {
  match (st) {
    ast.StmtVar(v) => {
      let ty = fn_tag_spelling(v.type_name, v.fn_ret, v.fn_param_types);
      if (ty.len() == 0) {
        ty = mono_infer(v.init, ctx.env, ctx.funcs);
      }
      let bound = menv_bind_destructure(ctx.env.ebind(v.name, ty), v.destr, ty);
      return (ast.StmtVar { ...v, init: bc_rewrite(v.init, ctx) }, BoundUse { ...ctx, env: bound }, true);
    },
    ast.StmtIf(f) => {
      let (tb, ta) = bc_body(f.then_body, ctx);
      let (eb, ea) = bc_body(f.else_body, ctx);
      return (ast.StmtIf { ...f, cond: bc_rewrite(f.cond, ctx), then_body: tb, else_body: eb }, ctx, true);
    },
    ast.StmtWhile(w) => {
      let (wb, wa) = bc_body(w.body, ctx);
      return (ast.StmtWhile { ...w, cond: bc_rewrite(w.cond, ctx), body: wb }, ctx, true);
    },
    ast.StmtFor(fr) => {
      let ety = "";
      let ity = mono_infer(fr.iter, ctx.env, ctx.funcs);
      if (type_ends_arr(ity)) {
        ety = elem_spelling(ity);
      }
      let (fb, fa) = bc_body(fr.body, BoundUse { ...ctx, env: ctx.env.ebind(fr.var_name, ety) });
      return (ast.StmtFor { ...fr, iter: bc_rewrite(fr.iter, ctx), body: fb }, ctx, true);
    },
    ast.StmtMatch(m) => {
      let sty = mono_infer(m.scrutinee, ctx.env, ctx.funcs);
      let arms: ast.MatchArm[] = [];
      for arm in m.arms {
        let actx = BoundUse { ...ctx, env: mono_arm_env(ctx.env, arm.pattern, sty, ctx.funcs) };
        let (ab, aa) = bc_body(arm.body, actx);
        let g = arm.guard;
        if (arm.has_guard) {
          g = bc_rewrite(arm.guard, actx);
        }
        arms = arms.append(ast.MatchArm { ...arm, body: ab, guard: g });
      }
      return (ast.StmtMatch { ...m, scrutinee: bc_rewrite(m.scrutinee, ctx), arms: arms }, ctx, true);
    },
    _ => {
      return (st, ctx, false);
    }
  }
}

function bc_expr(e: ast.Expr, ctx: BoundUse): (ast.Expr, BoundUse, boolean) {
  match (e) {
    ast.ExprLambda(lm) => {
      let (lb, la) = bc_body(lm.body, BoundUse { ...ctx, env: bind_params(ctx.env, lm.params) });
      return (ast.ExprLambda { ...lm, body: lb }, ctx, true);
    },
    ast.ExprBinary(b) => {
      return (bc_binary(b, ctx), ctx, true);
    },
    ast.ExprCall(c) => {
      return (bc_call(c, ctx), ctx, true);
    },
    _ => {
      return (e, ctx, false);
    }
  }
}

function bc_binary(b: ast.ExprBinary, ctx: BoundUse): ast.Expr {
  let left = bc_rewrite(b.left, ctx);
  let right = bc_rewrite(b.right, ctx);
  let lt = mono_infer(b.left, ctx.env, ctx.funcs);
  if (lt.len() == 0) {
    lt = mono_infer(b.right, ctx.env, ctx.funcs);
  }
  if (util.has_str(["<", "<=", ">", ">="], b.op) && util.has_str(ctx.ord, lt)) {
    let zero: ast.Expr = ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, bits: 0, line: b.line, col: b.col };
    return ast.binary(b.op, dv_call1(left, bound_method(lt, "cmp", true, ctx), right), zero, b.line, b.col, b.ty);
  }
  if (b.op == "==" && util.has_str(ctx.eq, lt)) {
    return dv_call1(left, bound_method(lt, "eq", true, ctx), right);
  }
  if (b.op == "!=" && util.has_str(ctx.eq, lt)) {
    return ast.unary("!", dv_call1(left, bound_method(lt, "eq", true, ctx), right), b.line, b.col, "");
  }
  return ast.binary(b.op, left, right, b.line, b.col, b.ty);
}

function bc_call(c: ast.ExprCall, ctx: BoundUse): ast.Expr {
  let args: ast.Expr[] = [];
  for a in c.args {
    args = args.append(bc_rewrite(a, ctx));
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    let field = fa.field;
    if (ctx.routed.len() > 0) {
      field = bound_field(fa, ctx);
    }
    let callee: ast.Expr = ast.ExprFieldAccess { ...fa, obj: bc_rewrite(fa.obj, ctx), field: field };
    return ast.ExprCall { ...c, callee: callee, args: args };
  }
  return ast.ExprCall { ...c, callee: bc_rewrite(c.callee, ctx), args: args };
}

pub function instantiate_func(fd: FuncDecl, name: string, tparams: string[], cts: string[], impls: ImplInfo[]): FuncDecl {
  let nparams: ast.ParamDecl[] = [];
  for i in 0..fd.params.len() {
    nparams = nparams.append(ast.ParamDecl { ...fd.params[i], type_name: resolve_proj_in_type(subst_ty(fd.params[i].type_name, tparams, cts), impls), fn_ret: subst_ty(fd.params[i].fn_ret, tparams, cts), fn_param_types: subst_ty_list(fd.params[i].fn_param_types, tparams, cts) });
  }
  let notp: string[] = [];
  return FuncDecl {
    ...fd,
    name: name,
    receiver_name: "",
    receiver_type: "",
    type_params: notp,
    all_type_params: [],
    bound_traits: notp,
    params: nparams,
    ret_type: resolve_proj_in_type(subst_ty(fd.ret_type, tparams, cts), impls),
    ret_fn_ret: subst_ty(fd.ret_fn_ret, tparams, cts),
    ret_fn_param_types: subst_ty_list(fd.ret_fn_param_types, tparams, cts),
    body: const_reads(fd, subst_stmts(fd.body, tparams, cts), tparams, cts),
  };
}

pub function const_reads(fd: FuncDecl, body: ast.Stmt[], tparams: string[], cts: string[]): ast.Stmt[] {
  let vars: string[] = [];
  let lits: string[] = [];
  let i = 0;
  while (i < tparams.len() && i < cts.len()) {
    if (is_const_arg(cts[i])) {
      vars = vars.append(tparams[i]);
      lits = lits.append(cts[i]);
    }
    i += 1;
  }
  if (vars.len() == 0) {
    return body;
  }
  let values = astwalk.append_bound_name([], fd.receiver_name);
  for pd in fd.params {
    values = astwalk.append_bound_name(values, pd.name);
  }
  return tv_obj_body(body, TvScope { vars: vars, cts: lits, values: values, lits: true });
}

pub function looks_type_var(s: string): boolean {
  if (s.len() < 3 || s[0] != b'0' || s[1] != b'_' || s[2] >= b'0' && s[2] <= b'9') {
    return false;
  }
  for i in 2..s.len() {
    if (!tv_word_char(s[i] as i32)) {
      return false;
    }
  }
  return true;
}

pub function array_method_element(spelling: string): string {
  if (type_ends_arr(spelling)) {
    return elem_spelling(spelling);
  }
  if (spelling_is_view(spelling)) {
    return render_type_ref(parse_type_ref(spelling).args[0]);
  }
  return "";
}

pub function concrete_array_method_name(receiver: string, method: string): string {
  let elem = array_method_element(receiver);
  if (elem.len() == 0) {
    return "";
  }
  let prefix = "__carrm_";
  if (spelling_is_view(receiver)) {
    prefix = "__cviewm_";
  }
  return util.mangled(prefix + sanitize_key(elem), method);
}

pub function is_concrete_array_fold(fd: FuncDecl): boolean {
  return fd.receiver_name.len() == 0
    && (fd.name.starts_with("__carrm_") || fd.name.starts_with("__cviewm_"));
}

pub function concrete_array_method_at(funcs: MFns, receiver: string, method: string): i32 {
  if (funcs.array_concrete.len() == 0) {
    return -1;
  }
  let name = concrete_array_method_name(receiver, method);
  for at in funcs.array_concrete {
    if (funcs.decls[at].name == name) {
      return at;
    }
  }
  return -1;
}

function collect_tvars(name: string, acc: string[]): string[] {
  if (looks_type_var(name)) {
    if (util.has_str(acc, name)) {
      return acc;
    }
    return acc.append(name);
  }
  if (type_ends_arr(name)) {
    return collect_tvars(slice_unchecked(name, 0, name.len() - 2), acc);
  }
  if (util.is_tuple_type_name(name) && name.ends_with(")")) {
    let tparts = split_top_commas(slice_unchecked(name, 1, name.len() - 1));
    let tcur = acc;
    for tj in 0..tparts.len() {
      tcur = collect_tvars(tparts[tj], tcur);
    }
    return tcur;
  }
  let lb = first_bracket(name);
  if (lb > 0 && name.ends_with("]")) {
    let parts = split_top_commas(slice_unchecked(name, lb + 1, name.len() - 1));
    let cur = acc;
    for j in 0..parts.len() {
      cur = collect_tvars(parts[j], cur);
    }
    return cur;
  }
  return acc;
}

pub function smm_name(base: string, method: string): string {
  return "__smm_" + base + "_" + method;
}

pub function smm_any(fns: MFns, field: string): boolean {
  let sfx = "_" + field;
  for i in 0..fns.smm.len() {
    let n = fns.smm[i];
    if (n.len() > 6 + sfx.len() && n.ends_with(sfx)) {
      return true;
    }
  }
  return false;
}

pub function declared_bound(fd: FuncDecl, name: string): string {
  let at = util.index_of_str(fd.type_params, name);
  if (at < 0 || at >= fd.bound_traits.len()) {
    return "";
  }
  return fd.bound_traits[at];
}

pub function is_bg_template(fd: FuncDecl): boolean {
  return fd.receiver_name.len() == 0 && fd.type_params.len() > 0;
}

pub function is_free_bg_template(fd: FuncDecl): boolean {
  return is_bg_template(fd) && fd.receiver_type.len() == 0;
}

pub struct TyIns { ty: string, mins: Insts }

pub function gstruct_index(gstructs: StructDecl[], base: string): i32 {
  for i in 0..gstructs.len() {
    if (gstructs[i].name == base) {
      return i;
    }
  }
  return -1;
}

pub function strip_struct_base(ty: string): string {
  let lb = first_bracket(ty);
  if (lb > 0) {
    return slice_unchecked(ty, 0, lb).to_owned();
  }
  return ty;
}

pub function mg_ty(ty: string, gstructs: StructDecl[], ins: Insts): TyIns {
  if (ty.len() > 4 && ty.starts_with("own ")) {
    let o = mg_ty(slice_unchecked(ty, 4, ty.len()).to_owned(), gstructs, ins);
    return TyIns { ty: "own " + o.ty, mins: o.mins };
  }
  let once = once_fn_body(ty);
  if (once.len() > 0) {
    let f = mg_ty(once, gstructs, ins);
    return TyIns { ty: "once " + f.ty, mins: f.mins };
  }
  if (spelling_is_view(ty)) {
    let v = mg_ty(slice_unchecked(ty, 1, ty.len() - 1).to_owned(), gstructs, ins);
    return TyIns { ty: "[" + v.ty + "]", mins: v.mins };
  }
  if (type_ends_arr(ty)) {
    let r = mg_ty(slice_unchecked(ty, 0, ty.len() - 2), gstructs, ins);
    return TyIns { ty: r.ty + "[]", mins: r.mins };
  }
  if (ty.len() > 0 && ty[0] == b'(' && util.contains(ty, "=>")) {
    let fref = parse_type_ref(ty);
    if (fref.is_fn) {
      let fcur = ins;
      let fout = "";
      let fchanged = false;
      let fi = 0;
      while (fi + 1 < fref.args.len()) {
        let psp = render_type_ref(fref.args[fi]);
        let pm = mg_ty(psp, gstructs, fcur);
        fcur = pm.mins;
        if (pm.ty != psp) {
          fchanged = true;
        }
        if (fi > 0) {
          fout += ", ";
        }
        fout += pm.ty;
        fi += 1;
      }
      let rsp = render_type_ref(fref.args[fref.args.len() - 1]);
      let rm = mg_ty(rsp, gstructs, fcur);
      fcur = rm.mins;
      if (rm.ty != rsp) {
        fchanged = true;
      }
      if (!fchanged) {
        return TyIns { ty: ty, mins: fcur };
      }
      return TyIns { ty: "(" + fout + ") => " + rm.ty, mins: fcur };
    }
  }
  if (util.is_tuple_type_name(ty) && ty.ends_with(")")) {
    let tps = split_top_commas(slice_unchecked(ty, 1, ty.len() - 1));
    let tcur = ins;
    let tnin2 = "";
    for tk in 0..tps.len() {
      let tpr = mg_ty(tps[tk], gstructs, tcur);
      tcur = tpr.mins;
      if (tk > 0) {
        tnin2 += ", ";
      }
      tnin2 += tpr.ty;
    }
    return TyIns { ty: "(" + tnin2 + ")", mins: tcur };
  }
  let lb = first_bracket(ty);
  if (lb > 0 && ty.ends_with("]")) {
    let base = slice_unchecked(ty, 0, lb);
    let inner = slice_unchecked(ty, lb + 1, ty.len() - 1);
    let parts = split_top_commas(inner);
    let gsi = gstruct_index(gstructs, base);
    if (gsi >= 0 && parts.len() == gstructs[gsi].type_params.len()) {
      let cur = ins;
      let key = "";
      for j in 0..parts.len() {
        let pr = mg_ty(parts[j], gstructs, cur);
        cur = pr.mins;
        if (j > 0) {
          key += ";";
        }
        key += pr.ty;
      }
      cur = cur.iadd(base, key);
      return TyIns { ty: instance_name(base, key), mins: cur };
    }
    let cur2 = ins;
    let ninner = "";
    for k in 0..parts.len() {
      let pr2 = mg_ty(parts[k], gstructs, cur2);
      cur2 = pr2.mins;
      if (k > 0) {
        ninner += ", ";
      }
      ninner += pr2.ty;
    }
    return TyIns { ty: base + "[" + ninner + "]", mins: cur2 };
  }
  return TyIns { ty: ty, mins: ins };
}

pub function is_clone_of(mangled: string, base: string): boolean {
  return mangled.len() > base.len() + util.NAME_SEP.len() && util.has_mangled_head(mangled, base);
}

pub function array_element_expected(e: ast.Expr, expected: string): string {
  if (expected.len() > 0 && expected[0] == b'(' && parse_type_ref(expected).is_tuple) {
    if let ast.ExprCall(c) = e {
      if (is_value_block(c)) {
        return "";
      }
    }
  }
  return expected;
}

pub function genum_index(enums: EnumDecl[], name: string): i32 {
  for i in 0..enums.len() {
    if (enums[i].name == name && enums[i].type_params.len() > 0) {
      return i;
    }
  }
  return -1;
}

pub function genum_owner_of_variant(enums: EnumDecl[], vname: string): i32 {
  for i in 0..enums.len() {
    if (enums[i].type_params.len() > 0) {
      let vn = enums[i].variant_names;
      for j in 0..vn.len() {
        if (vn[j] == vname) {
          return i;
        }
      }
    }
  }
  return -1;
}

pub function pk_is_fn_spelling(t: string): boolean {
  let n = t.len();
  if (n < 5) {
    return false;
  }
  if (t[0] != b'(') {
    return false;
  }
  let depth = 0;
  let i = 0;
  let close: i32 = -1;
  while (i < n) {
    let ch = t[i] as i32;
    if (ch == 40 || ch == 91) {
      depth += 1;
    } else if (ch == 41 || ch == 93) {
      depth -= 1;
      if (depth == 0 && ch == 41) {
        close = i;
        i = n;
      }
    }
    i += 1;
  }
  if (close < 0) {
    return false;
  }
  let j = close + 1;
  while (j < n && t[j] == b' ') {
    j += 1;
  }
  if (j + 1 >= n) {
    return false;
  }
  return t[j] == b'=' && t[j + 1] == b'>';
}

pub function fn_spelling_ret(t: string): string {
  if (!pk_is_fn_spelling(t)) {
    return "";
  }
  let n = t.len();
  let depth = 0;
  let i = 0;
  let close: i32 = -1;
  while (i < n) {
    let ch = t[i] as i32;
    if (ch == 40 || ch == 91) {
      depth += 1;
    } else if (ch == 41 || ch == 93) {
      depth -= 1;
      if (depth == 0 && ch == 41) {
        close = i;
        i = n;
      }
    }
    i += 1;
  }
  let j = close + 1;
  while (j < n && t[j] == b' ') {
    j += 1;
  }
  j += 2;
  while (j < n && t[j] == b' ') {
    j += 1;
  }
  return slice_unchecked(t, j, n).to_owned();
}

pub function me_ref_spelling(t: TypeRef): string {
  return spelling_without_own(render_type_ref(TypeRef { ...t, array_depth: 0 }));
}

pub function variant_struct_index(structs: StructDecl[], vname: string, owner: string): Option[i32] {
  for i in 0..structs.len() {
    if (structs[i].name == vname && structs[i].enum_owner == owner) {
      return Some(i);
    }
  }
  return None;
}

pub function me_variant_binds(ed: EnumDecl, vname: string, args: ast.Expr[], env: MEnv, structs: StructDecl[], funcs: MFns): MEnv {
  let binds = MEnv { mnames: [], mtypes: [] };
  let Some(vidx) = variant_struct_index(structs, vname, ed.name) else {
    return binds;
  };
  let fields = structs[vidx].fields;
  let fi = 0;
  while (fi < fields.len() && fi < args.len()) {
    let at = mono_infer(args[fi], env, funcs);
    if (at.len() > 0) {
      binds = bind_unify(fields[fi].type_name, at, ed.type_params, binds, funcs);
    }
    fi += 1;
  }
  return binds;
}

function struct_lit_spelling(sl: ast.ExprStructLit, env: MEnv, funcs: MFns): string {
  let si = gstruct_index(funcs.structs, sl.type_name);
  if (si < 0 || funcs.structs[si].type_params.len() == 0 || funcs.structs[si].enum_owner.len() > 0) {
    return sl.type_name;
  }
  let sd = funcs.structs[si];
  // A literal with a base takes the type arguments of the base.
  if (sl.has_base) {
    let from = mono_infer(sl.base, env, funcs);
    if (from.len() > sd.name.len() && strip_struct_base(from) == sd.name) {
      return from;
    }
  }
  let binds = MEnv { mnames: [], mtypes: [] };
  let k = 0;
  while (k < sl.field_names.len() && k < sl.field_values.len()) {
    for f in sd.fields {
      if (f.name == sl.field_names[k]) {
        let at = mono_infer(sl.field_values[k], env, funcs);
        if (at.len() > 0) {
          binds = bind_unify(field_spelling(f), at, sd.type_params, binds, funcs);
        }
      }
    }
    k += 1;
  }
  let whole = bound_spelling(sd.name, sd.type_params, binds);
  if (whole.len() == 0) {
    return sl.type_name;
  }
  return whole;
}

pub function ctor_variant_name(callee: ast.Expr, enums: EnumDecl[], env: MEnv, funcs: MFns): string {
  match (callee) {
    ast.ExprIdent(cid) => {
      if (util.has_str(env.mnames, cid.name)) {
        return "";
      }
      if (genum_owner_of_variant(enums, cid.name) >= 0 || cid.name == "Some" || cid.name == "Ok" || cid.name == "Err") {
        if (declares_func(cid.name, funcs.decls)) {
          return "";
        }
      }
      return cid.name;
    },
    ast.ExprFieldAccess(cfa) => {
      if let ast.ExprIdent(oid) = cfa.obj {
        if (!util.has_str(env.mnames, oid.name) && genum_index(enums, oid.name) >= 0) {
          return cfa.field;
        }
      }
    },
    _ => {}
  }
  return "";
}

pub function bound_spelling(name: string, tparams: string[], binds: MEnv): string {
  let out = name + "[";
  for j in 0..tparams.len() {
    let b = binds.elook(tparams[j]);
    if (b.len() == 0) {
      return "";
    }
    if (j > 0) {
      out += ", ";
    }
    out += b;
  }
  return out + "]";
}

pub function me_env_from_params(params: ast.ParamDecl[]): MEnv {
  let e = MEnv { mnames: [], mtypes: [] };
  for i in 0..params.len() {
    let pt = params[i].type_name;
    if (pt == "fn" && params[i].fn_ret.len() > 0) {
      pt = fn_tag_spelling(pt, params[i].fn_ret, params[i].fn_param_types);
    }
    e = e.ebind(params[i].name, pt);
  }
  return e;
}

// free_at is the position in `decls` of the first free function named
// `name`, -1 for none.
pub function (funcs: MFns) free_at(name: string): i32 {
  let k = funcs.pix.find(name);
  if (k < 0) {
    return -1;
  }
  return funcs.pat[k];
}

pub function me_field_type_of(structs: StructDecl[], sname: string, fname: string): string {
  let base = strip_struct_base(sname);
  for i in 0..structs.len() {
    if (structs[i].name == base) {
      let fs = structs[i].fields;
      for j in 0..fs.len() {
        if (fs[j].name == fname) {
          let targs = type_args_of(sname);
          if (structs[i].type_params.len() > 0 && targs.len() == structs[i].type_params.len()) {
            return subst_ty(fs[j].type_name, structs[i].type_params, targs);
          }
          return fs[j].type_name;
        }
      }
    }
  }
  return "";
}

pub function me_field_spelling_of(funcs: MFns, sname: string, fname: string): string {
  let base = strip_struct_base(sname);
  let i = funcs.snames.chain(base);
  while (i >= 0) {
    if (funcs.structs[i].name == base) {
      for f in funcs.structs[i].fields {
        if (f.name == fname) {
          return fn_tag_spelling(f.type_name, f.fn_ret, f.fn_param_types);
        }
      }
    }
    i = funcs.snames.next[i];
  }
  return "";
}

pub function lit_field_spelling(funcs: MFns, sname: string, written: string, fname: string): string {
  let spelling = me_field_spelling_of(funcs, sname, fname);
  if (spelling.len() == 0) {
    return spelling;
  }
  let base = strip_struct_base(sname);
  let args = type_args_of(written);
  let i = funcs.snames.chain(base);
  while (i >= 0) {
    let sd = funcs.structs[i];
    if (sd.name == base) {
      if (sd.type_params.len() > 0 && args.len() == sd.type_params.len()) {
        spelling = subst_ty(spelling, sd.type_params, args);
      }
      break;
    }
    i = funcs.snames.next[i];
  }
  if (type_str_vars(spelling, []).len() > 0) {
    return "";
  }
  return spelling;
}

pub function me_fn_ret_spelling(t: string): string {
  let last: i32 = -1;
  let i = 0;
  while (i + 4 <= t.len()) {
    if (util.str_eq_at(t, i, " => ")) {
      last = i;
    }
    i += 1;
  }
  if (last < 0) {
    return "";
  }
  return slice_unchecked(t, last + 4, t.len()).to_owned();
}

pub function me_tuple_elem_type(ty: string, field: string): string {
  if (ty.len() < 2 || ty[0] != b'(') {
    return "";
  }
  if (field.len() == 0) {
    return "";
  }
  let idx = 0;
  for fi in 0..field.len() {
    if (field[fi] < b'0' || field[fi] > b'9') {
      return "";
    }
    idx = idx * 10 + (field[fi] as i32 - 48);
  }
  let inner = slice_unchecked(ty, 1, ty.len() - 1).to_owned();
  let depth = 0;
  let start = 0;
  let cur = 0;
  for i in 0..=inner.len() {
    if (i == inner.len() || inner[i] == b',' && depth == 0) {
      if (cur == idx) {
        let seg = slice_unchecked(inner, start, i).to_owned();
        let s2 = 0;
        while (s2 < seg.len() && seg[s2] == b' ') {
          s2 += 1;
        }
        return slice_unchecked(seg, s2, seg.len()).to_owned();
      }
      cur += 1;
      start = i + 1;
    } else {
      if (inner[i] == b'[' || inner[i] == b'(') {
        depth += 1;
      }
      if (inner[i] == b']' || inner[i] == b')') {
        depth -= 1;
      }
    }
  }
  return "";
}

function dl_itoa(n: i32): string {
  if (n == 0) {
    return "0";
  }
  let digits = "0123456789";
  let s = "";
  let x = n;
  while (x > 0) {
    let d = x % 10;
    s = slice_unchecked(digits, d, d + 1) + s;
    x /= 10;
  }
  return s;
}

pub function is_iflet_value_local(name: string): boolean {
  return is_value_local_name(name) && name.starts_with("__il");
}

// True for the local that holds the subject of a match on a struct pattern.
pub function is_struct_match_subject(name: string): boolean {
  return name.len() > 6 && name.starts_with("__sm") && name.ends_with("_v");
}

pub function is_value_local_name(name: string): boolean {
  let n = name.len();
  if (n < 6 || !name.ends_with("_r")) {
    return false;
  }
  let head = slice_unchecked(name, 0, 4);
  return head == "__tm" || head == "__sm" || head == "__nt" || head == "__na" || head == "__il";
}

pub function is_value_block(c: ast.ExprCall): boolean {
  if (c.args.len() != 0) {
    return false;
  }
  match (c.callee) {
    ast.ExprLambda(l) => {
      if (l.params.len() != 0) {
        return false;
      }
      return is_value_block_origin(l.origin);
    },
    _ => {
      return false;
    }
  }
}

// The three send builtins take one argument and type it from the site.
pub function is_send_builtin(name: string): boolean {
  return name == "__send_copy" || name == "__send_adopt" || name == "__send_root" || name == "__send_release";
}

pub const LAMBDA_PREFIX: string = "__lam_";

const IIFE_MARK: string = "$iife";

const MKCLO_PREFIX: string = "__mkclo$";

pub function lambda_name(index: i32): string {
  return LAMBDA_PREFIX + util.i32_to_string(index);
}

pub function is_lambda_name(name: string): boolean {
  return name.len() > LAMBDA_PREFIX.len() && name.starts_with(LAMBDA_PREFIX);
}

pub function iife_name(owner: string, index: i32): string {
  return owner + IIFE_MARK + util.i32_to_string(index);
}

pub function is_iife_name(name: string): boolean {
  return util.contains(name, IIFE_MARK);
}

// The callee of the marker call that makes a closure of the function `target`.
pub function mkclo_name(target: string): string {
  return MKCLO_PREFIX + target;
}

pub function is_mkclo_name(name: string): boolean {
  return name.len() > MKCLO_PREFIX.len() && name.starts_with(MKCLO_PREFIX);
}

pub function mkclo_body(name: string): string {
  if (!is_mkclo_name(name)) {
    return "";
  }
  return slice_unchecked(name, MKCLO_PREFIX.len(), name.len()).to_owned();
}

pub function is_written_lambda_origin(origin: string): boolean {
  return origin.len() == 0 || origin == ast.ORIGIN_NESTED_FN || origin == ORIGIN_USE;
}

pub function is_value_block_origin(origin: string): boolean {
  if (origin == ORIGIN_BLOCK) {
    return true;
  }
  if (origin == ORIGIN_MATCH_EXPR) {
    return true;
  }
  if (origin == ORIGIN_IF_EXPR) {
    return true;
  }
  if (origin == ORIGIN_ARR_COMP) {
    return true;
  }
  if (origin == ORIGIN_MAP_COMP) {
    return true;
  }
  return false;
}

pub function dl_vb_rebuild(c: ast.ExprCall, body: ast.Stmt[]): ast.Expr {
  match (c.callee) {
    ast.ExprLambda(l) => {
      let lam: ast.Expr = ast.ExprLambda { ...l, body: body };
      return ast.ExprCall { callee: lam, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    _ => {
      return ast.ExprCall { callee: c.callee, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    }
  }
}

pub function dl_expr_kids(e: ast.Expr): ast.Expr[] {
  match (e) {
    ast.ExprBinary(b) => {
      return [b.left, b.right];
    },
    ast.ExprUnary(u) => {
      return [u.operand];
    },
    ast.ExprCall(c) => {
      let out: ast.Expr[] = [c.callee];
      let i = 0;
      while (i < c.args.len()) {
        out = out.append(c.args[i]);
        i += 1;
      }
      return out;
    },
    ast.ExprArray(a) => {
      return a.elements;
    },
    ast.ExprTuple(t) => {
      return t.elements;
    },
    ast.ExprIndex(x) => {
      return [x.array, x.index];
    },
    ast.ExprSlice(sl) => {
      return [sl.array, sl.start, sl.end];
    },
    ast.ExprStructLit(s) => {
      let out: ast.Expr[] = [s.base];
      let i = 0;
      while (i < s.field_values.len()) {
        out = out.append(s.field_values[i]);
        i += 1;
      }
      return out;
    },
    ast.ExprFieldAccess(fa) => {
      return [fa.obj];
    },
    ast.ExprMapLit(m) => {
      let out: ast.Expr[] = [];
      for i in 0..m.keys.len() {
        out = out.append(m.keys[i]);
      }
      for j in 0..m.vals.len() {
        out = out.append(m.vals[j]);
      }
      return out;
    },
    ast.ExprFString(f) => {
      return f.exprs;
    },
    _ => {
      let none: ast.Expr[] = [];
      return none;
    }
  }
}

pub function dl_expr_with_kids(e: ast.Expr, kids: ast.Expr[]): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return ast.binary(b.op, kids[0], kids[1], b.line, b.col, b.ty);
    },
    ast.ExprUnary(u) => {
      return ast.rebuild_unary(u, kids[0], u.line, u.col, u.ty);
    },
    ast.ExprCall(c) => {
      let args: ast.Expr[] = [];
      let i = 1;
      while (i < kids.len()) {
        args = args.append(kids[i]);
        i += 1;
      }
      return ast.ExprCall { callee: kids[0], args: args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprArray(a) => {
      return ast.ExprArray { ...a, elements: kids };
    },
    ast.ExprTuple(t) => {
      return ast.ExprTuple { elements: kids, line: t.line, col: t.col };
    },
    ast.ExprIndex(x) => {
      return ast.ExprIndex { array: kids[0], index: kids[1], unchecked: x.unchecked, ty: x.ty, line: x.line, col: x.col };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, array: kids[0], start: kids[1], end: kids[2] };
    },
    ast.ExprStructLit(s) => {
      let vals: ast.Expr[] = [];
      let i = 1;
      while (i < kids.len()) {
        vals = vals.append(kids[i]);
        i += 1;
      }
      return ast.ExprStructLit { ...s, field_values: vals, base: kids[0] };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, obj: kids[0] };
    },
    ast.ExprMapLit(m) => {
      let ks: ast.Expr[] = [];
      for i in 0..m.keys.len() {
        ks = ks.append(kids[i]);
      }
      let vs: ast.Expr[] = [];
      for j in m.keys.len()..kids.len() {
        vs = vs.append(kids[j]);
      }
      return ast.ExprMapLit { keys: ks, vals: vs, line: m.line, col: m.col };
    },
    ast.ExprFString(f) => {
      return ast.ExprFString { lits: f.lits, exprs: kids, is_expr: f.is_expr, line: f.line, col: f.col };
    },
    _ => {
      return e;
    }
  }
}

pub function map_expr_kids(e: ast.Expr, f: (ast.Expr) => ast.Expr): ast.Expr {
  let kids = dl_expr_kids(e);
  if (kids.len() == 0) {
    return e;
  }
  let nk: ast.Expr[] = [];
  for i in 0..kids.len() {
    nk = nk.append(f(kids[i]));
  }
  return dl_expr_with_kids(e, nk);
}

pub function param_names(params: ast.ParamDecl[]): string[] {
  let out: string[] = [];
  for p in params {
    out = out.append(p.name);
  }
  return out;
}

pub function vb_body(c: ast.ExprCall): ast.Stmt[] {
  match (c.callee) {
    ast.ExprLambda(l) => {
      return l.body;
    },
    _ => {
      let none: ast.Stmt[] = [];
      return none;
    }
  }
}

pub function is_reserved_enum_name(name: string): boolean {
  return name == "Option" || name == "Result" || name == "IoError" || name == "Body" || name == "StreamFault";
}

pub function reserved_enum_tparams(name: string): string[] {
  if (name == "Option") {
    return ["T"];
  }
  if (name == "Result") {
    return ["T", "E"];
  }
  let none: string[] = [];
  return none;
}

// The type parameters of a built-in generic struct, which has no
// declaration in the program, or 0 for any other name.
pub function reserved_generic_params(name: string): i32 {
  if (name == "Map") {
    return 2;
  }
  if (name == "Cell") {
    return 1;
  }
  return 0;
}

pub function is_reserved_struct_name(name: string): boolean {
  if (name.len() == 0 || name[0] < b'A' || name[0] > b'Z') {
    return false;
  }
  let reserved: string[] = [
    "BodySource", "ByteStream", "Cell", "ChunkProducer", "Date", "DateTime", "Dir", "DirEntry", "DirEntryBytes", "Duration", "FileStat",
    "FsStat", "HeaderMap", "HttpRequest", "HttpResponse", "Instant", "Map",
    "MountEntry", "Pipe", "ProcessResult",
    "Reader", "Socket", "Span", "Time", "WinSize", "Writer",
  ];
  return util.index_of_str(reserved, name) >= 0;
}

pub function reserved_struct_tparams(name: string): string[] {
  if (name == "Cell") {
    return ["T"];
  }
  if (name == "Map") {
    return ["K", "V"];
  }
  let none: string[] = [];
  return none;
}

function user_struct_tparams(mod: Module, name: string): (boolean, string[]) {
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return (true, sd.type_params);
    }
  }
  let none: string[] = [];
  return (false, none);
}

pub function union_alias_errors(mod: Module, al: TypeAlias): string[] {
  let out: string[] = [];
  let (named_struct, _) = user_struct_tparams(mod, al.name);
  if (named_struct || is_reserved_struct_name(al.name)) {
    return out.append("union \"" + al.name + "\" collides with a struct of the same name");
  }
  let seen: string[] = [];
  let mi = 0;
  while (mi < al.variants.len()) {
    let m = al.variants[mi];
    let given = alias_member_arity(al, mi);
    mi += 1;
    if (util.has_str(seen, m)) {
      out = out.append("duplicate member \"" + m + "\" in union " + al.name);
      continue;
    }
    seen = seen.append(m);
    let (found, tps) = user_struct_tparams(mod, m);
    if (!found && is_reserved_struct_name(m)) {
      found = true;
      tps = reserved_struct_tparams(m);
    }
    if (!found) {
      out = out.append("union " + al.name + " member \"" + m + "\" does not name a struct in scope");
    } else if (tps.len() == 0 && given > 0) {
      out = out.append("union " + al.name + " member \"" + m + "\" is not generic but was given " + util.i32_to_string(given) + " type argument(s)");
    } else if (tps.len() != given) {
      let params = "";
      for tp in tps {
        if (params.len() > 0) {
          params += ", ";
        }
        params += tp;
      }
      out = out.append("union " + al.name + " member \"" + m + "\" takes " + util.i32_to_string(tps.len()) + " type argument(s), got " + util.i32_to_string(given) + "; a generic struct member needs them supplied (e.g. `type " + al.name + "[" + params + "] = " + m + "[" + params + "] | …`)");
    }
  }
  return out;
}

function alias_member_arity(al: TypeAlias, i: i32): i32 {
  if (i >= al.variant_args.len() || al.variant_args[i].len() == 0) {
    return 0;
  }
  return split_top_commas(al.variant_args[i]).len();
}

pub function desugar_union_aliases(mod: Module): Module {
  let aliases: TypeAlias[] = [];
  let enums = mod.enums;
  let structs = mod.structs;
  let i = 0;
  while (i < mod.aliases.len()) {
    let al = mod.aliases[i];
    if (!alias_spells_args(al) || !alias_registers(mod, i)) {
      aliases = aliases.append(al);
      i += 1;
      continue;
    }
    for vi in 0..al.variants.len() {
      let member = al.variants[vi];
      let payload = member;
      if (vi < al.variant_args.len() && al.variant_args[vi].len() > 0) {
        payload = member + "[" + al.variant_args[vi] + "]";
      }
      structs = structs.append(StructDecl { name: member, fields: [bare_field(VARIANT_PAYLOAD_PREFIX, payload)], type_params: [], const_params: [], derives: [], line: 0, col: 0, enum_owner: al.name, must_consume: false, secret: false, value_type: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" });
    }
    enums = enums.append(EnumDecl { name: al.name, variant_names: al.variants, type_params: al.type_params, const_params: al.const_params, line: al.line, col: al.col, must_consume: false, try_marker: false, is_pub: al.is_pub, is_package: al.is_package, module: al.module, instance: "", visible_from: [] });
    i += 1;
  }
  return Module { ...mod, aliases: aliases, structs: structs, enums: enums };
}

function alias_spells_args(al: TypeAlias): boolean {
  if (al.type_params.len() > 0) {
    return true;
  }
  for a in al.variant_args {
    if (a.len() > 0) {
      return true;
    }
  }
  return false;
}

pub function alias_redeclares_enum(mod: Module, idx: i32): boolean {
  let al = mod.aliases[idx];
  if (union_alias_errors(mod, al).len() > 0) {
    return false;
  }
  if (is_reserved_enum_name(al.name)) {
    return true;
  }
  for ed in mod.enums {
    if (ed.name == al.name) {
      return true;
    }
  }
  for j in 0..idx {
    if (mod.aliases[j].name == al.name && alias_registers(mod, j)) {
      return true;
    }
  }
  return false;
}

pub function alias_registers(mod: Module, idx: i32): boolean {
  return union_alias_errors(mod, mod.aliases[idx]).len() == 0 && !alias_redeclares_enum(mod, idx);
}

pub function resource_collision(mod: Module, idx: i32): string {
  let name = mod.resources[idx].name;
  for j in 0..idx {
    if (mod.resources[j].name == name) {
      return "resource";
    }
  }
  if (is_reserved_struct_name(name)) {
    return "struct";
  }
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return "struct";
    }
  }
  if (is_reserved_enum_name(name)) {
    return "enum";
  }
  for ed in mod.enums {
    if (ed.name == name) {
      return "enum";
    }
  }
  for ai in 0..mod.aliases.len() {
    if (mod.aliases[ai].name == name && alias_registers(mod, ai)) {
      return "enum";
    }
  }
  return "";
}

pub function registered_resources(mod: Module): ResourceDecl[] {
  let out: ResourceDecl[] = [];
  for i in 0..mod.resources.len() {
    if (resource_collision(mod, i).len() == 0) {
      out = out.append(mod.resources[i]);
    }
  }
  return out;
}

pub function iterator_loop(fr: ast.StmtFor, subject: ast.Expr, col: i32): ast.Stmt {
  let at = util.i32_to_string(fr.line) + "_" + util.i32_to_string(col);
  let it = "$it_" + at;
  let step = "$at_" + at;
  let body: ast.Stmt[] = [s_assign(it, e_field_access(e_ident(step), "1"))];
  if (fr.destr.binds.len() > 0) {
    body = body.append(as_header(s_destr_at(fr.destr, e_field_access(e_ident(step), "0"), 0, 0)));
  } else if (fr.var_name != "_") {
    body = body.append(as_header(s_var(fr.var_name, "", e_field_access(e_ident(step), "0"))));
  }
  for st in fr.body {
    body = body.append(st);
  }
  let arms: ast.MatchArm[] = [
    ast.MatchArm { pattern: p_variant("Some", step), body: body, line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false },
    ast.MatchArm { pattern: p_variant("None", ""), body: [s_break()], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false },
  ];
  let pull = s_match(e_call(e_field_access(e_ident(it), "next"), []), arms);
  let walk: ast.Stmt = ast.StmtWhile { cond: e_bool(true), body: [pull], label: fr.label, line: fr.line, is_loop: false };
  return s_block([s_var(it, "", subject), walk]);
}

function variant_field_names_of(structs: StructDecl[], name: string): string[] {
  let bare = name;
  for c in 0..name.len() {
    if (name[c] == b'.') {
      bare = slice_unchecked(name, c + 1, name.len()).to_owned();
    }
  }
  for i in 0..structs.len() {
    if (structs[i].name == name || structs[i].name == bare) {
      if (structs[i].variant_field_names.len() > 0) {
        return structs[i].variant_field_names;
      }
    }
  }
  let empty: string[] = [];
  return empty;
}

pub function is_record_pattern(pv: ast.PatVariant): boolean {
  return pv.field_names.len() > 0 || pv.rest_written;
}

pub function record_pattern_settles(decl_names: string[], pv: ast.PatVariant): boolean {
  if (decl_names.len() == 0) {
    return false;
  }
  let named = 0;
  for decl in decl_names {
    let hits = 0;
    for f in pv.field_names {
      if (f == decl) {
        hits += 1;
      }
    }
    if (hits > 1) {
      return false;
    }
    named += hits;
  }
  return named == pv.field_names.len() && (pv.rest_written || named == decl_names.len());
}

pub function rebind_record_positional(pv: ast.PatVariant, decl_names: string[]): ast.PatVariant {
  let slots: string[] = [];
  let nested: ast.Pattern[] = [];
  for decl in decl_names {
    let q = util.index_of_str(pv.field_names, decl);
    let slot = "_";
    let sub = p_wildcard();
    if (q >= 0) {
      slot = payload_binder(pv, q);
      if (q < pv.nested.len()) {
        sub = pv.nested[q];
      }
    }
    slots = slots.append(slot);
    nested = nested.append(sub);
  }
  if (pv.nested.len() == 0) {
    nested = [];
  }
  let (binding, extra) = split_payload_slots(slots);
  let no_names: string[] = [];
  return ast.PatVariant { ...pv, binding: binding, extra_bindings: extra, nested: nested, field_names: no_names, rest_written: false };
}

pub function resolve_record_pattern(pv: ast.PatVariant, decl_names: string[]): ast.PatVariant {
  if (!is_record_pattern(pv) || !record_pattern_settles(decl_names, pv)) {
    return pv;
  }
  return rebind_record_positional(pv, decl_names);
}

function rvf_pattern(pat: ast.Pattern, structs: StructDecl[]): ast.Pattern {
  match (pat) {
    ast.PatVariant(pv) => {
      let np = resolve_record_pattern(pv, variant_field_names_of(structs, pv.type_name));
      return ast.PatVariant { ...np, nested: rvf_patterns(np.nested, structs), tup_pats: rvf_patterns(np.tup_pats, structs) };
    },
    _ => {
      return pat;
    }
  }
}

function rvf_patterns(pats: ast.Pattern[], structs: StructDecl[]): ast.Pattern[] {
  let out: ast.Pattern[] = [];
  for pat in pats {
    out = out.append(rvf_pattern(pat, structs));
  }
  return out;
}

function rvf_sugar(sg: ast.MatchSugar, structs: StructDecl[]): ast.MatchSugar {
  let arms: ast.MatchArm[] = [];
  for a in sg.arms {
    arms = arms.append(ast.MatchArm { ...a, pattern: rvf_pattern(a.pattern, structs) });
  }
  let tup: ast.TupArm[] = [];
  for t in sg.tup {
    tup = tup.append(ast.TupArm { ...t, elem_pats: rvf_patterns(t.elem_pats, structs) });
  }
  let strct: ast.StructArm[] = [];
  for st in sg.strct {
    strct = strct.append(ast.StructArm { ...st, field_pats: rvf_patterns(st.field_pats, structs) });
  }
  return ast.MatchSugar { ...sg, arms: arms, tup: tup, strct: strct };
}

function rvf_expr(e: ast.Expr, structs: StructDecl[]): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return ast.binary(b.op, rvf_expr(b.left, structs), rvf_expr(b.right, structs), b.line, b.col, b.ty);
    },
    ast.ExprUnary(u) => {
      return ast.rebuild_unary(u, rvf_expr(u.operand, structs), u.line, u.col, u.ty);
    },
    ast.ExprCall(c) => {
      let args: ast.Expr[] = [];
      for i in 0..c.args.len() {
        args = args.append(rvf_expr(c.args[i], structs));
      }
      return ast.ExprCall { callee: rvf_expr(c.callee, structs), args: args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprArray(a) => {
      let els: ast.Expr[] = [];
      for j in 0..a.elements.len() {
        els = els.append(rvf_expr(a.elements[j], structs));
      }
      return ast.ExprArray { ...a, elements: els };
    },
    ast.ExprTuple(t) => {
      let tels: ast.Expr[] = [];
      for k in 0..t.elements.len() {
        tels = tels.append(rvf_expr(t.elements[k], structs));
      }
      return ast.ExprTuple { elements: tels, line: t.line, col: t.col };
    },
    ast.ExprIndex(x) => {
      return ast.ExprIndex { array: rvf_expr(x.array, structs), index: rvf_expr(x.index, structs), unchecked: x.unchecked, ty: x.ty, line: x.line, col: x.col };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, array: rvf_expr(sl.array, structs), start: rvf_expr(sl.start, structs), end: rvf_expr(sl.end, structs) };
    },
    ast.ExprStructLit(st) => {
      let vals: ast.Expr[] = [];
      for v in 0..st.field_values.len() {
        vals = vals.append(rvf_expr(st.field_values[v], structs));
      }
      let nbase = st.base;
      if (st.has_base) {
        nbase = rvf_expr(st.base, structs);
      }
      return ast.ExprStructLit { ...st, field_values: vals, base: nbase };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, obj: rvf_expr(fa.obj, structs) };
    },
    ast.ExprLambda(lm) => {
      return ast.ExprLambda { ...lm, body: rvf_block(lm.body, structs) };
    },
    _ => {
      return e;
    }
  }
}

function rvf_stmt(st: ast.Stmt, structs: StructDecl[]): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar { name: v.name, type_name: v.type_name, init: rvf_expr(v.init, structs), line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types, destr: v.destr, header: v.header };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: rvf_expr(r.value, structs), line: r.line, col: r.col };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: rvf_expr(x.value, structs) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: rvf_expr(f.cond, structs), then_body: rvf_block(f.then_body, structs), else_body: rvf_block(f.else_body, structs), sugar: rvf_sugar(f.sugar, structs) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: rvf_expr(w.cond, structs), body: rvf_block(w.body, structs), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: rvf_expr(a.value, structs) };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: rvf_expr(fr.iter, structs), body: rvf_block(fr.body, structs), label: fr.label, line: fr.line, col: fr.col, destr: fr.destr };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: rvf_stmt(d.action, structs), on_error: d.on_error, line: d.line };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      for a in 0..m.arms.len() {
        arms = arms.append(ast.MatchArm { pattern: rvf_pattern(m.arms[a].pattern, structs), body: rvf_block(m.arms[a].body, structs), line: m.arms[a].line, col: m.arms[a].col, guard: rvf_expr(m.arms[a].guard, structs), has_guard: m.arms[a].has_guard, alt_cont: false });
      }
      return ast.StmtMatch { ...m, scrutinee: rvf_expr(m.scrutinee, structs), arms: arms };
    },
    _ => {
      return st;
    }
  }
}

function rvf_block(stmts: ast.Stmt[], structs: StructDecl[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for i in 0..stmts.len() {
    out = out.append(rvf_stmt(stmts[i], structs));
  }
  return out;
}

pub function resolve_variant_fields_module(mod: Module): Module {
  let any = false;
  for s in 0..mod.structs.len() {
    if (mod.structs[s].variant_field_names.len() > 0) {
      any = true;
    }
  }
  if (!any) {
    return mod;
  }
  let funcs: FuncDecl[] = [];
  for i in 0..mod.funcs.len() {
    let fd = mod.funcs[i];
    funcs = funcs.append(FuncDecl { ...fd, body: rvf_block(fd.body, mod.structs) });
  }
  return Module { ...mod, funcs: funcs, top_stmts: rvf_block(mod.top_stmts, mod.structs) };
}

pub function is_named_marker(e: ast.Expr): boolean {
  match (e) {
    ast.ExprBinary(b) => {
      return b.op == "__named_arg";
    },
    _ => {
      return false;
    }
  }
}

pub function named_marker_name(e: ast.Expr): string {
  match (e) {
    ast.ExprBinary(b) => {
      match (b.left) {
        ast.ExprIdent(id) => {
          return id.name;
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
}

pub function named_marker_value(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return b.right;
    },
    _ => {
      return e;
    }
  }
}

pub function default_nonconst_reason(e: ast.Expr): (string, boolean) {
  match (e) {
    ast.ExprBytes(_) => {
      return ("is an array literal", true);
    },
    ast.ExprNumber(n) => {
      return ("", false);
    },
    ast.ExprString(st) => {
      return ("", false);
    },
    ast.ExprBool(b) => {
      return ("", false);
    },
    ast.ExprIdent(id) => {
      return ("reads \"" + id.name + "\"", true);
    },
    ast.ExprUnary(u) => {
      if (is_cast_op(u.op)) {
        return ("is a cast", true);
      }
      return default_nonconst_reason(u.operand);
    },
    ast.ExprBinary(b) => {
      let (lwhy, lbad) = default_nonconst_reason(b.left);
      if (lbad) {
        return (lwhy, true);
      }
      return default_nonconst_reason(b.right);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          return ("calls \"" + id.name + "\"", true);
        },
        _ => {
          return ("is a call", true);
        }
      }
    },
    ast.ExprFieldAccess(fa) => {
      return ("is a field access", true);
    },
    ast.ExprIndex(ix) => {
      return ("is an index", true);
    },
    ast.ExprLambda(lm) => {
      return ("is a lambda", true);
    },
    ast.ExprStructLit(sl) => {
      return ("is a struct literal", true);
    },
    ast.ExprArray(al) => {
      return ("is an array literal", true);
    },
    ast.ExprTuple(tl) => {
      return ("is a tuple literal", true);
    },
    ast.ExprSlice(sl) => {
      return ("is not a constant expression", true);
    },
    ast.ExprMapLit(ml) => {
      return ("is not a constant expression", true);
    },
    ast.ExprFString(fs) => {
      return ("is not a constant expression", true);
    },
    ast.ExprUnknown(uk) => {
      return ("", false);
    },
    ast.ExprZero(_) => {
      return ("", false);
    }
  }
}

pub function declares_func(name: string, funcs: FuncDecl[]): boolean {
  for fd in funcs {
    if (fd.receiver_type.len() == 0 && fd.name == name) {
      return true;
    }
  }
  return false;
}

pub function retag_type_arg_indexes(mod: Module): Module {
  let generics: string[] = [];
  let types: string[] = [];
  for fd in mod.funcs {
    if (fd.all_type_params.len() > 0 && fd.receiver_type.len() == 0) {
      generics = generics.append(fd.name);
    }
  }
  let const_firsts = const_first_generics(mod.funcs);
  if (generics.len() == 0) {
    return mod;
  }
  let top_site = rta_has_index_call(mod.top_stmts);
  let sites: boolean[] = [];
  let any_site = top_site;
  for fd in mod.funcs {
    let site = rta_has_index_call(fd.body);
    sites = sites.append(site);
    any_site = any_site || site;
  }
  if (!any_site) {
    return mod;
  }
  for sd in mod.structs {
    types = types.append(sd.name);
  }
  for ed in mod.enums {
    types = types.append(ed.name);
  }
  for rd in mod.resources {
    types = types.append(rd.name);
  }
  for al in mod.aliases {
    types = types.append(al.name);
  }
  types = util.append_all(types, ["Option", "Result"]);
  let consts: string[] = [];
  for fd in mod.funcs {
    if (fd.is_const && fd.receiver_type.len() == 0) {
      consts = consts.append(fd.name);
    }
  }
  let funcs: FuncDecl[] = [];
  for k in 0..mod.funcs.len() {
    let fd = mod.funcs[k];
    if (!sites[k]) {
      funcs = funcs.append(fd);
      continue;
    }
    let shadow = astwalk.collect_bound_stmts(fd.body, consts);
    for pd in fd.params {
      shadow = shadow.append(pd.name);
    }
    let ftypes = types;
    if (fd.all_type_params.len() > 0 || fd.type_params.len() > 0) {
      ftypes = util.append_all(util.append_all(ftypes, fd.all_type_params), fd.type_params);
      for pd in fd.params {
        ftypes = rta_type_names(pd.type_name, ftypes);
      }
      ftypes = rta_type_names(fd.ret_type, ftypes);
      ftypes = rta_type_names(fd.receiver_type, ftypes);
    }
    function rw(x: ast.Expr): ast.Expr {
      return rta_call_of(x, generics, const_firsts, ftypes, shadow);
    }
    funcs = funcs.append(FuncDecl { ...fd, body: astwalk.map_stmts(fd.body, rw) });
  }
  if (!top_site) {
    return Module { ...mod, funcs: funcs };
  }
  let top_shadow = astwalk.collect_bound_stmts(mod.top_stmts, consts);
  function top_rw(x: ast.Expr): ast.Expr {
    return rta_call_of(x, generics, const_firsts, types, top_shadow);
  }
  return Module { ...mod, funcs: funcs, top_stmts: astwalk.map_stmts(mod.top_stmts, top_rw) };
}

function rta_has_index_call(stmts: ast.Stmt[]): boolean {
  let found = false;
  for st in stmts {
    found = astwalk.fold_stmt_nodes(st, found, rta_skip_stmt, rta_index_call_of, astwalk.descend_all);
  }
  return found;
}

function rta_skip_stmt(st: ast.Stmt, own acc: boolean): boolean {
  return acc;
}

function rta_index_call_of(e: ast.Expr, own acc: boolean): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIndex(_) = c.callee {
      return true;
    }
  }
  return acc;
}

function rta_type_names(ty: string, acc: string[]): string[] {
  let start: i32 = -1;
  for i in 0..=ty.len() {
    let word = i < ty.len() && lexer.is_alphanumeric(ty[i] as i32);
    if (word && start < 0) {
      start = i;
    }
    if (!word && start >= 0) {
      acc = acc.append(slice_unchecked(ty, start, i).to_owned());
      start = -1;
    }
  }
  return acc;
}

function rta_call_of(x: ast.Expr, generics: string[], const_firsts: string[], types: string[], shadow: string[]): ast.Expr {
  if let ast.ExprCall(c) = x {
    if (c.type_args.len() > 0) {
      return x;
    }
    if let ast.ExprIndex(ix) = c.callee {
      let fname = rta_callee_name(ix.array, shadow);
      let targ = rta_type_spelling(ix.index, types, shadow);
      if (targ.len() == 0 && fname.len() > 0 && util.has_str(const_firsts, fname)) {
        return ast.ExprCall { ...c, callee: ix.array, type_args: [const_bracket_spelling(ix.index)] };
      }
      if (targ.len() > 0 && fname.len() > 0 && util.has_str(generics, fname)) {
        return ast.ExprCall { ...c, callee: ix.array, type_args: [targ] };
      }
    }
  }
  return x;
}

function const_first_generics(funcs: FuncDecl[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    if (fd.all_type_params.len() > 0 && fd.receiver_type.len() == 0 && is_const_tparam(fd, fd.all_type_params[0])) {
      out = out.append(fd.name);
    }
  }
  return out;
}

pub function is_const_tparam(fd: FuncDecl, name: string): boolean {
  let i = util.index_of_str(fd.type_params, name);
  return i >= 0 && i < fd.bound_traits.len() && is_const_bound(fd.bound_traits[i]);
}

pub function is_const_arg(spelling: string): boolean {
  if (spelling.len() == 0) {
    return false;
  }
  for ch in spelling {
    if (ch < b'0' || ch > b'9') {
      return false;
    }
  }
  return true;
}

pub function const_arg_text(text: string): string {
  let hex = text.len() > 2 && text[0] == b'0' && (text[1] == b'x' || text[1] == b'X');
  let at = 0;
  if (hex) {
    at = 2;
  }
  while (at + 1 < text.len() && text[at] == b'0') {
    at += 1;
  }
  if (!hex) {
    return slice_unchecked(text, at, text.len()).to_owned();
  }
  if (text.len() - at > 15) {
    return "99999999999";
  }
  return util.i64_to_string(util.lit_to_i64(text));
}

pub function const_arg_fits(spelling: string): boolean {
  return spelling.len() <= 10 && util.lit_to_i64(spelling) <= 2147483647;
}

function const_bracket_spelling(e: ast.Expr): string {
  if let ast.ExprNumber(n) = e {
    if (!n.is_float && n.suffix.len() == 0) {
      return const_arg_text(n.text);
    }
  }
  if let ast.ExprIdent(id) = e {
    return id.name;
  }
  return "";
}

function rta_type_spelling(e: ast.Expr, types: string[], shadow: string[]): string {
  if let ast.ExprIdent(id) = e {
    if ((util.has_str(types, id.name) || id.name == "char" || id.name == "str") && !util.has_str(shadow, id.name)) {
      return id.name;
    }
    return "";
  }
  if let ast.ExprIndex(ix) = e {
    let head = rta_type_spelling(ix.array, types, shadow);
    let arg = rta_type_spelling(ix.index, types, shadow);
    if (head.len() > 0 && arg.len() > 0) {
      return head + "[" + arg + "]";
    }
  }
  return "";
}

function rta_callee_name(callee: ast.Expr, shadow: string[]): string {
  if let ast.ExprIdent(fid) = callee {
    if (util.has_str(shadow, fid.name)) {
      return "";
    }
    return fid.name;
  }
  if let ast.ExprFieldAccess(fa) = callee {
    if let ast.ExprIdent(mid) = fa.obj {
      if (util.has_str(shadow, mid.name)) {
        return "";
      }
      return mid.name + "." + fa.field;
    }
  }
  return "";
}

pub function lower_stream_signatures(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  for f in mod.funcs {
    if (f.async && f.import_iface.len() > 0) {
      funcs = funcs.append(lower_stream_signature(f));
    } else {
      funcs = funcs.append(f);
    }
  }
  return Module { ...mod, funcs: funcs };
}

function lower_stream_signature(f: FuncDecl): FuncDecl {
  let slots: i32[] = [];
  let ret = f.ret_type;
  if (stream_elem(ret).len() > 0) {
    ret = stream_elem(ret) + "[]";
    slots = slots.append(-1);
  }
  let params: ast.ParamDecl[] = [];
  for i in 0..f.params.len() {
    let p = f.params[i];
    if (stream_elem(p.type_name).len() > 0) {
      p = ast.ParamDecl { ...p, type_name: stream_elem(p.type_name) + "[]" };
      slots = slots.append(i);
    }
    params = params.append(p);
  }
  return FuncDecl { ...f, ret_type: ret, params: params, streams: slots };
}

pub function stream_elem(t: string): string {
  let pre = "Stream[";
  if (t.len() <= pre.len() + 1 || !t.starts_with(pre) || t[t.len() - 1] != b']') {
    return "";
  }
  let bytes: u8[] = [];
  for i in pre.len()..t.len() - 1 {
    bytes = bytes.append(t[i]);
  }
  unsafe {
    return string_from_bytes_unchecked(bytes);
  }
}

function irt_param_type(params: ast.ParamDecl[], name: string): string {
  for i in 0..params.len() {
    if (params[i].name == name) {
      return params[i].type_name;
    }
  }
  return "";
}

function stamp_lambda_ret(e: ast.Expr, fn_ret: string): ast.Expr {
  if (fn_ret.len() == 0) {
    return e;
  }
  match (e) {
    ast.ExprLambda(lm) => {
      if (lm.ret_type.len() > 0) {
        return e;
      }
      return ast.ExprLambda { ...lm, ret_type: fn_ret };
    },
    _ => {
      return e;
    }
  }
}

function stamp_value_block_ret(e: ast.Expr, decl_ty: string): ast.Expr {
  if (decl_ty.len() > 2 && decl_ty.ends_with("[]")) {
    let elem_ty = slice_unchecked(decl_ty, 0, decl_ty.len() - 2).to_owned();
    match (e) {
      ast.ExprArray(al) => {
        let nels: ast.Expr[] = [];
        for ai in 0..al.elements.len() {
          nels = nels.append(stamp_value_block_ret(al.elements[ai], array_element_expected(al.elements[ai], elem_ty)));
        }
        return ast.ExprArray { ...al, elements: nels };
      },
      _ => {
        return e;
      }
    }
  }
  if (decl_ty.len() == 0 || is_coarse_fn_tag(decl_ty) || collect_tvars(decl_ty, []).len() > 0) {
    return e;
  }
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() != 0) {
        return e;
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 0 || lm.ret_type == decl_ty || is_written_lambda_origin(lm.origin)) {
            return e;
          }
          let nl: ast.Expr = ast.ExprLambda { ...lm, ret_type: decl_ty };
          return ast.ExprCall { callee: nl, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
        },
        _ => {
          return e;
        }
      }
    },
    _ => {
      return e;
    }
  }
}

function irt_method_ret(funcs: FuncDecl[], recv_type: string, name: string): string {
  let base = recv_type;
  let b = 0;
  while (b < base.len()) {
    if (base[b] == b'[') {
      base = slice_unchecked(base, 0, b).to_owned();
      b = base.len();
    }
    b += 1;
  }
  for i in 0..funcs.len() {
    if (funcs[i].name == name && funcs[i].receiver_type.len() > 0) {
      let rb = funcs[i].receiver_type;
      let r2 = 0;
      while (r2 < rb.len()) {
        if (rb[r2] == b'[') {
          rb = slice_unchecked(rb, 0, r2).to_owned();
          r2 = rb.len();
        }
        r2 += 1;
      }
      if (rb == base) {
        return funcs[i].ret_type;
      }
    }
  }
  return "";
}

function irt_is_cmp(op: string): boolean {
  return op == "<" || op == "<=" || op == ">" || op == ">="
    || op == "==" || op == "!=" || op == "&&" || op == "||";
}

pub function irt_guess(e: ast.Expr, params: ast.ParamDecl[], funcs: FuncDecl[], structs: StructDecl[], enums: EnumDecl[]): string {
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return "f64";
      }
      if (n.suffix.len() > 0) {
        return n.suffix;
      }
      if (ast.literal_is_i64(n.text)) {
        return "i64";
      }
      return "i32";
    },
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprBool(_) => {
      return "boolean";
    },
    ast.ExprIdent(id) => {
      return irt_param_type(params, id.name);
    },
    ast.ExprBinary(b) => {
      if (irt_is_cmp(b.op)) {
        return "boolean";
      }
      return irt_guess(b.left, params, funcs, structs, enums);
    },
    ast.ExprStructLit(s) => {
      return s.type_name;
    },
    ast.ExprArray(al) => {
      if (al.elements.len() == 0) {
        return "";
      }
      let el = irt_guess(al.elements[0], params, funcs, structs, enums);
      if (el == "") {
        return "";
      }
      return el + "[]";
    },
    ast.ExprTuple(tl) => {
      let parts = "";
      for ti in 0..tl.elements.len() {
        let tt = irt_guess(tl.elements[ti], params, funcs, structs, enums);
        if (tt == "") {
          return "";
        }
        if (ti > 0) {
          parts += ", ";
        }
        parts += tt;
      }
      return "(" + parts + ")";
    },
    ast.ExprIndex(ix) => {
      let at = irt_guess(ix.array, params, funcs, structs, enums);
      if (at.len() >= 3 && at.ends_with("[]")) {
        return slice_unchecked(at, 0, at.len() - 2).to_owned();
      }
      if (at.len() >= 3 && at[0] == b'[' && at[at.len() - 1] == b']') {
        return slice_unchecked(at, 1, at.len() - 1).to_owned();
      }
      return "";
    },
    ast.ExprSlice(sl) => {
      let st2 = irt_guess(sl.array, params, funcs, structs, enums);
      if (st2.len() >= 3 && st2.ends_with("[]")) {
        return "[" + slice_unchecked(st2, 0, st2.len() - 2) + "]";
      }
      if (st2.len() >= 3 && st2[0] == b'[' && st2[st2.len() - 1] == b']') {
        return st2;
      }
      return "";
    },
    ast.ExprFieldAccess(fa) => {
      let ot = irt_guess(fa.obj, params, funcs, structs, enums);
      if (ot.len() == 0) {
        return "";
      }
      let tel = me_tuple_elem_type(ot, fa.field);
      if (tel.len() > 0) {
        return tel;
      }
      return me_field_type_of(structs, ot, fa.field);
    },
    ast.ExprUnary(u) => {
      if (u.op == "!") {
        return "boolean";
      }
      if (u.op == "-" || u.op == "+") {
        return irt_guess(u.operand, params, funcs, structs, enums);
      }
      if (u.op == ast.CAST && u.cast == "f64" || u.op == ast.CAST && u.cast == "float") {
        return "f64";
      }
      if (u.op == ast.CAST && u.cast == "f32") {
        return "f32";
      }
      if (u.op == ast.CAST && u.cast == "i32") {
        return "i32";
      }
      if (u.op == ast.CAST && u.cast == "i64") {
        return "i64";
      }
      if (u.op == ast.CAST && u.cast == "u8") {
        return "u8";
      }
      if (u.op == ast.CAST && u.cast == "u16") {
        return "u16";
      }
      if (u.op == ast.CAST && u.cast == "i16") {
        return "i16";
      }
      if (u.op == ast.CAST && u.cast == "u32") {
        return "u32";
      }
      if (u.op == ast.CAST && u.cast == "u64") {
        return "u64";
      }
      return "";
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          if (cid.name == "Some") {
            if (c.args.len() == 1) {
              let inner = irt_guess(c.args[0], params, funcs, structs, enums);
              if (inner != "") {
                return "Option[" + inner + "]";
              }
            }
            return "Option";
          }
          if (cid.name == "None") {
            return "Option";
          }
          if (cid.name == "Ok" || cid.name == "Err") {
            return "";
          }
          return irt_call_ret(cid.name, c, params, funcs, structs, enums);
        },
        ast.ExprFieldAccess(mfa) => {
          let rt2 = irt_guess(mfa.obj, params, funcs, structs, enums);
          if (rt2.len() == 0) {
            return "";
          }
          return irt_method_ret(funcs, rt2, mfa.field);
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
}

function irt_call_ret(name: string, call: ast.ExprCall, params: ast.ParamDecl[], funcs: FuncDecl[], structs: StructDecl[], enums: EnumDecl[]): string {
  for fd in funcs {
    if (fd.name != name || fd.receiver_type != "") {
      continue;
    }
    let vars = fd.all_type_params;
    if (vars.len() == 0 || !spelling_mentions_tparam(fd.ret_type, vars)) {
      return fd.ret_type;
    }
    if (call.type_args.len() == vars.len()) {
      return subst_ty(fd.ret_type, vars, call.type_args);
    }
    let binds = MEnv { mnames: [], mtypes: [] };
    for i in 0..fd.params.len().min(call.args.len()) {
      let formal = fd.params[i].type_name;
      if (spelling_mentions_tparam(formal, vars)) {
        let actual = irt_guess(call.args[i], params, funcs, structs, enums);
        if (actual != "") {
          binds = bind_argument_types(formal, actual, vars, binds, structs, enums);
        }
      }
    }
    for v in vars {
      if (binds.elook(v) == "" && spelling_mentions_tparam(fd.ret_type, [v])) {
        return "";
      }
    }
    return subst_ty(fd.ret_type, binds.mnames, binds.mtypes);
  }
  return "";
}

pub function erase_view_spelling(ty: string): string {
  return fold_view_spelling(erase_str_names(ty));
}

function view_opens_at(ty: string, i: i32): boolean {
  if (i + 1 < ty.len() && ty[i + 1] == b']') {
    return false;
  }
  if (i == 0) {
    return true;
  }
  let prev = ty[i - 1];
  return prev == b'(' || prev == b'[' || prev == b',' || prev == b' ';
}

function fold_view_spelling(ty: string): string {
  for i in 0..ty.len() {
    if (ty[i] == b'[' && view_opens_at(ty, i)) {
      let close = matching_bracket(ty, i);
      if (close < 0) {
        return ty;
      }
      let inner = fold_view_spelling(slice_unchecked(ty, i + 1, close).to_owned());
      return slice_unchecked(ty, 0, i) + inner + "[]" + fold_view_spelling(slice_unchecked(ty, close + 1, ty.len()).to_owned());
    }
  }
  return ty;
}

function erase_str_names(ty: string): string {
  let out = "";
  let start = 0;
  let i = 0;
  while (i < ty.len()) {
    if (!ident_byte(ty[i] as i32)) {
      i += 1;
      continue;
    }
    let j = i;
    while (j < ty.len() && ident_byte(ty[j] as i32)) {
      j += 1;
    }
    let qualified = i > 0 && (ty[i - 1] == b'.' || ty[i - 1] == b':') || j < ty.len() && (ty[j] == b'.' || ty[j] == b':');
    if (j - i == 3 && !qualified && util.str_range_eq(ty, i, j, "str")) {
      out = out + slice_unchecked(ty, start, i) + "string";
      start = j;
    }
    i = j;
  }
  if (start == 0) {
    return ty;
  }
  return out + slice_unchecked(ty, start, ty.len());
}

pub function receiver_base(receiver: string): string {
  let tuple = tuple_namespace(receiver);
  if (tuple.len() > 0) {
    return tuple;
  }
  return util.base_type_name(erase_view_spelling(receiver));
}

// tuple_namespace names the method namespace of a tuple spelling, `tuple2`
// for `(A, B)`, and is empty for any other spelling.
pub function tuple_namespace(spelling: string): string {
  if (!util.is_tuple_type_name(spelling)) {
    return "";
  }
  let r = parse_type_ref(spelling);
  if (!r.is_tuple || r.array_depth > 0) {
    return "";
  }
  return tuple_arity_namespace(r.args.len());
}

pub function tuple_arity_namespace(arity: i32): string {
  return "tuple" + util.i32_to_string(arity);
}

pub function decl_key(fd: FuncDecl): string {
  if (fd.receiver_type.len() == 0) {
    return fd.name;
  }
  return receiver_base(fd.receiver_type) + "." + fd.name;
}

pub function receiver_namespace(receiver: string): string {
  let r = parse_type_ref(receiver);
  if (r.array_depth > 0) {
    return "Array";
  }
  if (r.is_view) {
    return "slice";
  }
  return receiver_base(receiver);
}

pub function spells_view(ty: string): boolean {
  let i = 0;
  let n = ty.len();
  while (i < n) {
    let b = ty[i];
    if (b == b'[' && view_opens_at(ty, i)) {
      return true;
    }
    if (b == b's' && i + 2 < n && ty[i + 1] == b't' && ty[i + 2] == b'r'
      && (i == 0 || !ident_byte(ty[i - 1] as i32)) && (i + 3 == n || !ident_byte(ty[i + 3] as i32))) {
      return true;
    }
    i += 1;
  }
  return false;
}

pub function erase_view_structs(sds: StructDecl[]): StructDecl[] {
  let out: StructDecl[] = [];
  for sd in sds {
    out = out.append(erase_view_struct(sd));
  }
  return out;
}

function erase_view_struct(sd: StructDecl): StructDecl {
  let fields: StructFieldDecl[] = [];
  for f in sd.fields {
    fields = fields.append(StructFieldDecl { ...f, type_name: erase_view_spelling(f.type_name), fn_ret: erase_view_spelling(f.fn_ret), fn_param_types: erase_view_spelling(f.fn_param_types) });
  }
  return StructDecl { ...sd, fields: fields };
}

function tvar_spelling(name: string): string {
  if (looks_type_var(name)) {
    return name;
  }
  return "0_" + name;
}

pub function desugar_trait_params(mod: Module, traits: string[], spelled: boolean): Module {
  if (traits.len() == 0) {
    return mod;
  }
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    funcs = funcs.append(desugar_fn_trait_params(fd, traits, spelled));
  }
  return Module { ...mod, funcs: funcs };
}

function desugar_fn_trait_params(fd: FuncDecl, traits: string[], spelled: boolean): FuncDecl {
  if (fd.impl_trait.len() > 0) {
    return fd;
  }
  let params: ast.ParamDecl[] = [];
  let type_params = fd.type_params;
  let bound_traits = fd.bound_traits;
  let all_type_params = fd.all_type_params;
  for p in fd.params {
    let tr = parse_type_ref(p.type_name);
    if (tr.array_depth > 0 || tr.is_tuple || tr.is_fn || tr.is_view || !util.has_str(traits, tr.base) || util.has_str(all_type_params, tr.base)) {
      params = params.append(p);
      continue;
    }
    let tp = fresh_trait_param("T_" + p.name, all_type_params, spelled);
    type_params = type_params.append(tp);
    bound_traits = bound_traits.append(p.type_name);
    all_type_params = all_type_params.append(tp);
    params = params.append(ast.ParamDecl { ...p, type_name: tp });
  }
  return FuncDecl { ...fd, params: params, type_params: type_params, bound_traits: bound_traits, all_type_params: all_type_params };
}

pub function is_platform_param(fd: FuncDecl, i: i32, qual: string): boolean {
  let t = fd.params[i].type_name;
  for name in ["Host", "Platform"] {
    if (t == "platform__" + name || t == "platform." + name || qual.len() > 0 && t == qual + "." + name) {
      return true;
    }
  }
  let k = util.index_of_str(fd.type_params, t);
  if (k < 0 || k >= fd.bound_traits.len()) {
    return false;
  }
  for b in split_plus_bounds(fd.bound_traits[k]) {
    if (trait_simple_name(b) == "Platform") {
      return true;
    }
  }
  return false;
}

pub function trait_simple_name(b: string): string {
  let base = util.base_type_name(b);
  let i = base.len();
  while (i > 0) {
    if (base[i - 1] == b'.') {
      return slice_unchecked(base, i, base.len()).to_owned();
    }
    if (i >= 2 && base[i - 1] == b'_' && base[i - 2] == b'_') {
      return slice_unchecked(base, i, base.len()).to_owned();
    }
    i -= 1;
  }
  return base;
}

pub function trait_decl_names(traits: TraitDecl[]): string[] {
  let out: string[] = [];
  for t in traits {
    out = out.append(t.name);
  }
  return out;
}

function fresh_trait_param(want: string, taken: string[], spelled: boolean): string {
  let name = want;
  let n = 1;
  while (util.has_str(taken, name) || util.has_str(taken, "0_" + name)) {
    name = want + util.i32_to_string(n);
    n += 1;
  }
  if (spelled) {
    return "0_" + name;
  }
  return name;
}

function rename_type_vars_module(mod: Module): Module {
  return respell_type_vars_module(mod, false);
}

pub function written_type_vars_module(mod: Module): Module {
  return respell_type_vars_module(mod, true);
}

function respell_type_vars_module(mod: Module, written: boolean): Module {
  let mvals = module_value_names(mod);
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    let fvars = fn_type_vars(fd, mod, written);
    funcs = funcs.append(rename_fn_type_vars(fd, fvars, tvar_respellings(fvars, written), mvals));
  }
  let structs: StructDecl[] = [];
  for sd in mod.structs {
    let svars = type_vars(sd.type_params, sd.const_params);
    if (sd.enum_owner.len() > 0) {
      svars = decl_type_vars(sd.enum_owner, mod);
    }
    structs = structs.append(rename_struct_type_vars(sd, svars, tvar_respellings(svars, written)));
  }
  let enums: EnumDecl[] = [];
  for ed in mod.enums {
    let evars = type_vars(ed.type_params, ed.const_params);
    enums = enums.append(EnumDecl { ...ed, type_params: rename_ty_list(ed.type_params, evars, tvar_respellings(evars, written)) });
  }
  let impls: ImplInfo[] = [];
  for im in mod.impls {
    let none: string[] = [];
    let ivars = add_tvars(add_tvars(none, im.all_type_params), im.type_params);
    impls = impls.append(rename_impl_type_vars(im, ivars, tvar_respellings(ivars, written)));
  }
  let traits: TraitDecl[] = [];
  for td in mod.trait_decls {
    let tvars = type_vars(td.type_params, td.const_params);
    let methods: FuncDecl[] = [];
    for m in td.methods {
      let mvars = add_tvars(fn_type_vars(m, mod, written), tvars);
      methods = methods.append(rename_fn_type_vars(m, mvars, tvar_respellings(mvars, written), mvals));
    }
    traits = traits.append(TraitDecl { ...td, type_params: rename_ty_list(td.type_params, tvars, tvar_respellings(tvars, written)), methods: methods });
  }
  return Module { ...mod, funcs: funcs, structs: structs, enums: enums, impls: impls, trait_decls: traits };
}

function module_value_names(mod: Module): string[] {
  let out: string[] = [];
  for fd in mod.funcs {
    if (fd.receiver_type.len() == 0) {
      out = out.append(fd.name);
    }
  }
  for sd in mod.structs {
    out = out.append(sd.name);
  }
  for ed in mod.enums {
    out = out.append(ed.name);
  }
  for al in mod.aliases {
    out = out.append(al.name);
  }
  return out;
}

function tvar_respellings(vars: string[], written: boolean): string[] {
  let out: string[] = [];
  for v in vars {
    if (!written) {
      out = out.append(tvar_spelling(v));
    } else if (looks_type_var(v)) {
      out = out.append(slice_unchecked(v, 2, v.len()).to_owned());
    } else {
      out = out.append(v);
    }
  }
  return out;
}

function add_tvars(acc: string[], vars: string[]): string[] {
  let out = acc;
  for v in vars {
    if (!util.has_str(out, v)) {
      out = out.append(v);
    }
  }
  return out;
}

// decl_type_vars is the type parameters of the struct or enum `name` that
// are not const.
function decl_type_vars(name: string, mod: Module): string[] {
  for ed in mod.enums {
    if (ed.name == name) {
      return type_vars(ed.type_params, ed.const_params);
    }
  }
  for sd in mod.structs {
    if (sd.name == name) {
      return type_vars(sd.type_params, sd.const_params);
    }
  }
  let none: string[] = [];
  return none;
}

function type_vars(type_params: string[], const_params: string[]): string[] {
  let out: string[] = [];
  for tv in type_params {
    if (!util.has_str(const_params, tv)) {
      out = out.append(tv);
    }
  }
  return out;
}

function fn_type_vars(fd: FuncDecl, mod: Module, respelled: boolean): string[] {
  let none: string[] = [];
  let vars: string[] = [];
  for v in add_tvars(add_tvars(none, fd.all_type_params), fd.type_params) {
    if (!is_const_tparam(fd, v)) {
      vars = vars.append(v);
    }
  }
  if (fd.receiver_type.len() == 0) {
    return vars;
  }
  if (first_bracket(fd.receiver_type) < 0) {
    vars = add_tvars(vars, decl_type_vars(fd.receiver_type, mod));
  }
  if (respelled) {
    vars = type_str_vars(fd.receiver_type, vars);
  } else {
    vars = add_tvars(vars, receiver_type_vars(parse_type_ref(fd.receiver_type), mod));
  }
  let consts = receiver_const_names(fd.receiver_type, mod);
  let out: string[] = [];
  for v in vars {
    if (!util.has_str(consts, v)) {
      out = out.append(v);
    }
  }
  return out;
}

// receiver_const_names is the names a receiver spelling gives to the const
// parameters of its struct or enum: N in `function (r: Ring[N, T]) cap()`.
function receiver_const_names(receiver_type: string, mod: Module): string[] {
  let out: string[] = [];
  let r = parse_type_ref(receiver_type);
  for sd in mod.structs {
    if (sd.name == r.base) {
      return const_arg_names(r, sd.type_params, sd.const_params);
    }
  }
  for ed in mod.enums {
    if (ed.name == r.base) {
      return const_arg_names(r, ed.type_params, ed.const_params);
    }
  }
  return out;
}

// const_arg_names is the names r writes at the const parameters of a type
// that declares type_params.
pub function const_arg_names(r: TypeRef, type_params: string[], const_params: string[]): string[] {
  let out: string[] = [];
  for i in 0..r.args.len() {
    if (i < type_params.len() && util.has_str(const_params, type_params[i]) && r.args[i].args.len() == 0) {
      out = out.append(r.args[i].base);
    }
  }
  return out;
}

function receiver_type_vars(r: TypeRef, mod: Module): string[] {
  let out: string[] = [];
  if (r.args.len() == 0 && !r.is_tuple && !r.is_fn) {
    let leaf = r.base;
    let letter = leaf.len() == 1 && leaf[0] >= b'A' && leaf[0] <= b'Z';
    if (letter && !names_module_type(leaf, mod)) {
      out = out.append(leaf);
    }
    return out;
  }
  for a in r.args {
    out = add_tvars(out, receiver_type_vars(a, mod));
  }
  return out;
}

function names_module_type(name: string, mod: Module): boolean {
  for sd in mod.structs {
    if (sd.name == name) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == name) {
      return true;
    }
  }
  for al in mod.aliases {
    if (al.name == name) {
      return true;
    }
  }
  return false;
}

pub function rename_ty_list(list: string[], vars: string[], cts: string[]): string[] {
  let out: string[] = [];
  for t in list {
    out = out.append(subst_ty(t, vars, cts));
  }
  return out;
}

function rename_bounds(bounds: string[], vars: string[], cts: string[]): string[] {
  let out: string[] = [];
  for b in bounds {
    if (is_const_bound(b)) {
      out = out.append(b);
      continue;
    }
    let joined = "";
    for entry in split_plus_bounds(b) {
      if (joined.len() > 0) {
        joined += "+";
      }
      joined += subst_ty(entry, vars, cts);
    }
    out = out.append(joined);
  }
  return out;
}

function rename_param_type_vars(pd: ast.ParamDecl, vars: string[], cts: string[]): ast.ParamDecl {
  let dv = pd.default_value;
  if (pd.has_default) {
    dv = astwalk.map_expr(dv, (e: ast.Expr): ast.Expr => rename_tv_expr(e, vars, cts));
  }
  return ast.ParamDecl { ...pd, type_name: subst_ty(pd.type_name, vars, cts), fn_ret: subst_ty(pd.fn_ret, vars, cts), fn_param_types: subst_ty_list(pd.fn_param_types, vars, cts), default_value: dv };
}

function rename_fn_type_vars(fd: FuncDecl, vars: string[], cts: string[], mvals: string[]): FuncDecl {
  if (vars.len() == 0) {
    return fd;
  }
  let values: string[] = [];
  for v in vars {
    if (util.has_str(mvals, v)) {
      values = values.append(v);
    }
  }
  if (fd.receiver_name.len() > 0) {
    values = values.append(fd.receiver_name);
  }
  for pd in fd.params {
    values = astwalk.append_bound_name(values, pd.name);
  }
  let sc = TvScope { vars: vars, cts: cts, values: values, lits: false };
  let params: ast.ParamDecl[] = [];
  for pd in fd.params {
    let rp = rename_param_type_vars(pd, vars, cts);
    if (rp.has_default) {
      rp = ast.ParamDecl { ...rp, default_value: tv_obj_in(rp.default_value, sc) };
    }
    params = params.append(rp);
  }
  return FuncDecl {
    ...fd, receiver_type: subst_ty(fd.receiver_type, vars, cts), type_params: rename_ty_list(fd.type_params, vars, cts),
    all_type_params: rename_ty_list(fd.all_type_params, vars, cts), bound_traits: rename_bounds(fd.bound_traits, vars, cts), params: params,
    ret_type: subst_ty(fd.ret_type, vars, cts), ret_fn_ret: subst_ty(fd.ret_fn_ret, vars, cts), ret_fn_param_types: subst_ty_list(fd.ret_fn_param_types, vars, cts),
    body: tv_obj_body(rename_tv_stmts(fd.body, vars, cts), sc),
  };
}

function rename_struct_type_vars(sd: StructDecl, vars: string[], cts: string[]): StructDecl {
  if (vars.len() == 0) {
    return sd;
  }
  let fields: StructFieldDecl[] = [];
  for f in sd.fields {
    fields = fields.append(StructFieldDecl { ...f, type_name: subst_ty(f.type_name, vars, cts), fn_ret: subst_ty(f.fn_ret, vars, cts), fn_param_types: subst_ty_list(f.fn_param_types, vars, cts) });
  }
  return StructDecl { ...sd, fields: fields, type_params: rename_ty_list(sd.type_params, vars, cts), const_params: rename_ty_list(sd.const_params, vars, cts) };
}

function rename_impl_type_vars(im: ImplInfo, vars: string[], cts: string[]): ImplInfo {
  if (vars.len() == 0) {
    return im;
  }
  return ImplInfo {
    ...im, impl_type: subst_ty(im.impl_type, vars, cts), type_params: rename_ty_list(im.type_params, vars, cts),
    all_type_params: rename_ty_list(im.all_type_params, vars, cts), bounds: rename_bounds(im.bounds, vars, cts),
    trait_ref: subst_ty(im.trait_ref, vars, cts), assoc_values: rename_ty_list(im.assoc_values, vars, cts),
  };
}

function rename_tv_stmts(stmts: ast.Stmt[], vars: string[], cts: string[]): ast.Stmt[] {
  return rename_tv_annots(astwalk.map_stmts(stmts, (e: ast.Expr): ast.Expr => rename_tv_expr(e, vars, cts)), vars, cts);
}

function rename_tv_expr(e: ast.Expr, vars: string[], cts: string[]): ast.Expr {
  match (e) {
    ast.ExprIdent(id) => {
      return ast.ExprIdent { ...id, ty: subst_ty(id.ty, vars, cts) };
    },
    ast.ExprCall(c) => {
      return ast.ExprCall { ...c, type_args: rename_ty_list(c.type_args, vars, cts), ty: subst_ty(c.ty, vars, cts) };
    },
    ast.ExprBinary(b) => {
      return ast.binary(b.op, b.left, b.right, b.line, b.col, subst_ty(b.ty, vars, cts));
    },
    ast.ExprUnary(u) => {
      return ast.rebuild_unary(u, u.operand, u.line, u.col, subst_ty(u.ty, vars, cts));
    },
    ast.ExprIndex(ix) => {
      return ast.ExprIndex { ...ix, ty: subst_ty(ix.ty, vars, cts) };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, ty: subst_ty(sl.ty, vars, cts) };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, ty: subst_ty(fa.ty, vars, cts) };
    },
    ast.ExprArray(ar) => {
      return ast.ExprArray { ...ar, elem_ty: subst_ty(ar.elem_ty, vars, cts) };
    },
    ast.ExprZero(z) => {
      return ast.ExprZero { ...z, type_name: subst_ty(z.type_name, vars, cts) };
    },
    ast.ExprStructLit(sl) => {
      return ast.ExprStructLit { ...sl, type_name: subst_ty(sl.type_name, vars, cts), written: subst_ty(sl.written, vars, cts) };
    },
    ast.ExprLambda(lm) => {
      let lps: ast.ParamDecl[] = [];
      for lpd in lm.params {
        lps = lps.append(rename_param_type_vars(lpd, vars, cts));
      }
      return ast.ExprLambda {
        ...lm, params: lps, ret_type: subst_ty(lm.ret_type, vars, cts), ret_fn_ret: subst_ty(lm.ret_fn_ret, vars, cts),
        ret_fn_param_types: subst_ty_list(lm.ret_fn_param_types, vars, cts), body: rename_tv_annots(lm.body, vars, cts),
      };
    },
    _ => {
      return e;
    }
  }
}

struct TvScope { vars: string[], cts: string[], values: string[], lits: boolean }

function tv_shadow(sc: TvScope, names: string[]): TvScope {
  let values = sc.values;
  for n in names {
    values = values.append(n);
  }
  return TvScope { ...sc, values: values };
}

function tv_obj_body(stmts: ast.Stmt[], sc: TvScope): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let cur = sc;
  for st in stmts {
    let (ns, na, nh) = astwalk.map_stmt_where(st, cur, tv_obj_stmt, tv_obj_expr, astwalk.descend_all);
    out = out.append(ns);
    if let ast.StmtVar(v) = st {
      cur = tv_shadow(cur, ast.append_var_names([], v));
    }
  }
  return out;
}

function tv_obj_in(e: ast.Expr, sc: TvScope): ast.Expr {
  let (out, a, h) = astwalk.map_expr_where(e, sc, tv_obj_stmt, tv_obj_expr, astwalk.descend_all);
  return out;
}

function tv_obj_ident(e: ast.Expr, sc: TvScope): ast.Expr {
  if let ast.ExprIdent(id) = e {
    let k = tp_index(id.name, sc.vars);
    if (k >= 0 && !util.has_str(sc.values, id.name) && sc.lits && is_const_arg(sc.cts[k])) {
      return e_spelled_at(sc.cts[k], "", "", false, id.line, id.col);
    }
    if (k >= 0 && !util.has_str(sc.values, id.name)) {
      return ast.ExprIdent { ...id, name: sc.cts[k] };
    }
  }
  return e;
}

function tv_obj_expr(e: ast.Expr, sc: TvScope): (ast.Expr, TvScope, boolean) {
  match (e) {
    ast.ExprIdent(_) => {
      if (sc.lits) {
        return (tv_obj_ident(e, sc), sc, true);
      }
      return (e, sc, false);
    },
    ast.ExprFieldAccess(fa) => {
      if let ast.ExprIdent(_) = fa.obj {
        return (ast.ExprFieldAccess { ...fa, obj: tv_obj_ident(fa.obj, sc) }, sc, true);
      }
      return (e, sc, false);
    },
    ast.ExprIndex(ix) => {
      if let ast.ExprIdent(_) = ix.index {
        return (ast.ExprIndex { ...ix, array: tv_obj_in(ix.array, sc), index: tv_obj_ident(ix.index, sc) }, sc, true);
      }
      return (e, sc, false);
    },
    ast.ExprLambda(lm) => {
      let names: string[] = [];
      for lp in lm.params {
        names = astwalk.append_bound_name(names, lp.name);
      }
      return (ast.ExprLambda { ...lm, body: tv_obj_body(lm.body, tv_shadow(sc, names)) }, sc, true);
    },
    _ => {
      return (e, sc, false);
    }
  }
}

function tv_obj_stmt(st: ast.Stmt, sc: TvScope): (ast.Stmt, TvScope, boolean) {
  match (st) {
    ast.StmtIf(f) => {
      return (ast.StmtIf { ...f, cond: tv_obj_in(f.cond, sc), then_body: tv_obj_body(f.then_body, sc), else_body: tv_obj_body(f.else_body, sc) }, sc, true);
    },
    ast.StmtWhile(w) => {
      return (ast.StmtWhile { ...w, cond: tv_obj_in(w.cond, sc), body: tv_obj_body(w.body, sc) }, sc, true);
    },
    ast.StmtFor(fo) => {
      return (ast.StmtFor { ...fo, iter: tv_obj_in(fo.iter, sc), body: tv_obj_body(fo.body, tv_shadow(sc, ast.append_for_names([], fo))) }, sc, true);
    },
    ast.StmtMatch(mt) => {
      let arms: ast.MatchArm[] = [];
      for arm in mt.arms {
        let asc = tv_shadow(sc, astwalk.pattern_binders(arm.pattern, []));
        let g = arm.guard;
        if (arm.has_guard) {
          g = tv_obj_in(arm.guard, asc);
        }
        arms = arms.append(ast.MatchArm { ...arm, guard: g, body: tv_obj_body(arm.body, asc) });
      }
      return (ast.StmtMatch { ...mt, scrutinee: tv_obj_in(mt.scrutinee, sc), arms: arms }, sc, true);
    },
    _ => {
      return (st, sc, false);
    }
  }
}

function rename_tv_annots(stmts: ast.Stmt[], vars: string[], cts: string[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for st in stmts {
    out = out.append(rename_tv_annot(st, vars, cts));
  }
  return out;
}

function rename_tv_annot(st: ast.Stmt, vars: string[], cts: string[]): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar { ...v, type_name: subst_ty(v.type_name, vars, cts), fn_ret: subst_ty(v.fn_ret, vars, cts), fn_param_types: subst_ty_list(v.fn_param_types, vars, cts) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, then_body: rename_tv_annots(f.then_body, vars, cts), else_body: rename_tv_annots(f.else_body, vars, cts) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, body: rename_tv_annots(w.body, vars, cts) };
    },
    ast.StmtFor(fo) => {
      return ast.StmtFor { ...fo, body: rename_tv_annots(fo.body, vars, cts) };
    },
    ast.StmtMatch(mt) => {
      let arms: ast.MatchArm[] = [];
      for arm in mt.arms {
        arms = arms.append(ast.MatchArm { ...arm, body: rename_tv_annots(arm.body, vars, cts) });
      }
      return ast.StmtMatch { ...mt, arms: arms };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: rename_tv_annot(d.action, vars, cts) };
    },
    _ => {
      return st;
    }
  }
}

pub struct TraitDefault { trait_name: string, trait_params: string[], trait_consts: string[], method: FuncDecl }

pub struct ImplInfo { trait_name: string, impl_type: string, type_params: string[], all_type_params: string[], bounds: string[], method_names: string[], trait_spelling: string, trait_ref: string, assoc_names: string[], assoc_values: string[], trait_module: string, module: string, line: i32, col: i32 }

pub function impl_trait_key(im: ImplInfo): string {
  if (im.trait_module.len() == 0) {
    return im.trait_name;
  }
  return im.trait_module + "." + im.trait_name;
}

struct MethodClaim { fn: FuncDecl, keys: string[], traits: string[] }

function claim_method_name(fd0: FuncDecl, tname: string, keys: string[], traits: string[]): MethodClaim {
  if (fd0.receiver_type.len() == 0) {
    return MethodClaim { fn: fd0, keys: keys, traits: traits };
  }
  let fd = FuncDecl { ...fd0, impl_trait: tname };
  let base = util.base_type_name(fd.receiver_type);
  let key = base + "." + fd.name;
  let at = util.index_of_str(keys, key);
  if (at < 0) {
    return MethodClaim { fn: fd, keys: keys.append(key), traits: traits.append(tname) };
  }
  if (tname.len() == 0 || traits[at] == tname) {
    return MethodClaim { fn: fd, keys: keys, traits: traits };
  }
  let renamed = tname + "." + fd.name;
  let rkey = base + "." + renamed;
  if (util.index_of_str(keys, rkey) >= 0) {
    return MethodClaim { fn: fd, keys: keys, traits: traits };
  }
  let renamed_fd = FuncDecl { ...fd, name: renamed };
  return MethodClaim { fn: renamed_fd, keys: keys.append(rkey), traits: traits.append(tname) };
}

pub function resolve_dyn_traits(mod: Module): Module {
  let bases: string[] = [];
  let served: string[][] = [];
  for fd in mod.funcs {
    let own: string[] = [];
    let base = "";
    if (fd.receiver_type.len() > 0 && !ends_with_array_brackets(fd.receiver_type)) {
      base = receiver_base(fd.receiver_type);
      if (fd.impl_trait.len() > 0) {
        own = own.append(fd.impl_trait);
      }
    }
    bases = bases.append(base);
    served = served.append(own);
  }
  let ix = util.name_index(bases);
  for im in mod.impls {
    if (im.trait_name.len() > 0 && !ends_with_array_brackets(im.impl_type)) {
      let bn = receiver_base(im.impl_type);
      for ri in trait_closure(mod.trait_reqs, im.trait_name, im.trait_module) {
        let req = mod.trait_reqs[ri];
        for m in req.provided {
          let at = answering_method(mod.funcs, ix, bn, m, req.trait_name);
          if (at >= 0 && !util.has_str(served[at], im.trait_name)) {
            served = served.with(at, served[at].append(im.trait_name));
          }
        }
      }
    }
  }
  let out: FuncDecl[] = [];
  for i in 0..mod.funcs.len() {
    let fd = mod.funcs[i];
    if (fd.dyn_traits.len() > 0 || served[i].len() > 0) {
      fd = FuncDecl { ...fd, dyn_traits: served[i], streams: [] };
    }
    out = out.append(fd);
  }
  return Module { ...mod, funcs: out };
}

function ends_with_array_brackets(t: string): boolean {
  let n = t.len();
  return n >= 2 && t.ends_with("[]");
}

function answering_method(funcs: FuncDecl[], ix: util.NameIndex, bn: string, m: string, tn: string): i32 {
  let inherent: i32 = -1;
  let i = ix.chain(bn);
  while (i >= 0) {
    if (ix.names[i] == bn && derive_simple_name(funcs[i].name) == m) {
      if (funcs[i].impl_trait == tn) {
        return i;
      }
      if (funcs[i].impl_trait.len() == 0 && inherent < 0) {
        inherent = i;
      }
    }
    i = ix.next[i];
  }
  return inherent;
}

function trait_closure(reqs: TraitReq[], tn: string, module: string): i32[] {
  let out: i32[] = [];
  let first = trait_req_index(reqs, tn, module);
  if (first >= 0) {
    out = out.append(first);
  }
  let k = 0;
  while (k < out.len()) {
    let r = reqs[out[k]];
    for sup in r.supertraits {
      let at = trait_req_index(reqs, util.base_type_name(sup), r.module);
      if (at >= 0 && util.index_of_i32(out, at) < 0) {
        out = out.append(at);
      }
    }
    k += 1;
  }
  return out;
}

function trait_req_index(reqs: TraitReq[], tn: string, module: string): i32 {
  let base = util.base_type_name(tn);
  let name = derive_simple_name(base);
  let owner = module;
  if (base.len() > name.len()) {
    owner = slice_unchecked(base, 0, base.len() - name.len() - 1).to_owned();
  }
  let any: i32 = -1;
  for i in 0..reqs.len() {
    if (reqs[i].trait_name == name) {
      if (reqs[i].module == owner) {
        return i;
      }
      if (any < 0) {
        any = i;
      }
    }
  }
  return any;
}

pub function dyn_trait_set(ty: string): string[] {
  let out: string[] = [];
  if (ty.len() <= 4 || !ty.starts_with("dyn ")) {
    return out;
  }
  for piece in split_plus_bounds(slice_unchecked(ty, 4, ty.len()).to_owned()) {
    let part = piece.trim();
    if (part.len() > 0) {
      out = out.append(part);
    }
  }
  return out;
}

pub function dyn_arm_matches(fd: FuncDecl, traits: string[], method: string): boolean {
  return fd.receiver_name.len() > 0 && answers_traits(fd, traits, method);
}

function answers_traits(fd: FuncDecl, traits: string[], method: string): boolean {
  if (traits.len() == 0) {
    return fd.name == method;
  }
  if (derive_simple_name(fd.name) != method) {
    return false;
  }
  for t in traits {
    if (util.has_str(fd.dyn_traits, derive_simple_name(util.base_type_name(t)))) {
      return true;
    }
  }
  return false;
}

pub function dyn_provider_name(funcs: FuncDecl[], recv_type: string, traits: string[], method: string): string {
  return trait_provider_name(funcs, recv_type, traits, method, true);
}

function trait_provider_name(funcs: FuncDecl[], recv_type: string, traits: string[], method: string, receiver: boolean): string {
  let Some(at) = trait_provider_index(funcs, recv_type, traits, method, receiver) else {
    return method;
  };
  return funcs[at].name;
}

function trait_provider_index(funcs: FuncDecl[], recv_type: string, traits: string[], method: string, receiver: boolean): Option[i32] {
  if (recv_type.len() == 0) {
    return None;
  }
  for i in 0..funcs.len() {
    let fd = funcs[i];
    if (util.base_type_name(fd.receiver_type) == recv_type
      && fd.receiver_name.len() > 0 == receiver
      && answers_traits(fd, traits, method)) {
      return Some(i);
    }
  }
  return None;
}

pub function route_inherited_defaults(mod: Module): Module {
  let funcs = mod.funcs;
  let mf = MFns { ...mfns_of(mod.funcs, mod.structs, mod.enums, mod.impls), keep_vars: true };
  let i = 0;
  while (i < funcs.len()) {
    let fd = funcs[i];
    if (fd.impl_trait.len() > 0 && is_inherited_default(mod.impls, mod.trait_reqs, fd)) {
      let base = util.base_type_name(fd.receiver_type);
      let ctx = BoundUse { env: env_from_decl(fd), funcs: mf, ord: [], eq: [], routed: [fd.receiver_type], bases: [base], traits: [[fd.impl_trait]], by_trait: false };
      let (body, after) = bc_body(fd.body, ctx);
      funcs = funcs.with(i, FuncDecl { ...fd, body: body });
    }
    i += 1;
  }
  return Module { ...mod, funcs: funcs };
}

pub function is_inherited_default(impls: ImplInfo[], reqs: TraitReq[], fd: FuncDecl): boolean {
  let base = util.base_type_name(fd.receiver_type);
  let name = derive_simple_name(fd.name);
  for im in impls {
    if (im.trait_name == fd.impl_trait && util.base_type_name(im.impl_type) == base) {
      if (util.has_str(im.method_names, name)) {
        return false;
      }
      for tr in reqs {
        if (tr.trait_name == fd.impl_trait) {
          for ds in tr.default_sigs {
            if (ds.name == name) {
              return true;
            }
          }
        }
      }
      return false;
    }
  }
  return false;
}

// The function is the `drop` of its receiver type.
pub function drop_provider(fd: FuncDecl): boolean {
  let provider = fd.impl_trait == "Drop" || fd.impl_trait == "" && util.index_of_str(fd.dyn_traits, "Drop") >= 0;
  return provider && derive_simple_name(fd.name) == "drop" && fd.receiver_type != "";
}

pub function derive_simple_name(name: string): string {
  let last_dot: i32 = -1;
  for i in 0..name.len() {
    if (name[i] == b'.') {
      last_dot = i;
    }
  }
  if (last_dot >= 0) {
    return slice_unchecked(name, last_dot + 1, name.len()).to_owned();
  }
  return name;
}

pub function split_type_list(csv: string): string[] {
  let out: string[] = [];
  let start = 0;
  let depth = 0;
  for i in 0..=csv.len() {
    if (i == csv.len() || csv[i] == b',' && depth == 0) {
      out = out.append(slice_unchecked(csv, start, i).to_owned());
      start = i + 1;
    } else if (csv[i] == b'(' || csv[i] == b'[') {
      depth += 1;
    } else if (csv[i] == b')' || csv[i] == b']') {
      depth -= 1;
    }
  }
  return out;
}

function dv_self_field(f: string): ast.Expr {
  return e_field_access(e_ident("self"), f);
}

function dv_other_field(f: string): ast.Expr {
  return e_field_access(e_ident("other"), f);
}

function dv_call0(recv: ast.Expr, m: string): ast.Expr {
  let noargs: ast.Expr[] = [];
  return e_call(e_field_access(recv, m), noargs);
}

function dv_call1(recv: ast.Expr, m: string, arg: ast.Expr): ast.Expr {
  let args: ast.Expr[] = [arg];
  return e_call(e_field_access(recv, m), args);
}

function synth_struct_display(sd: StructDecl): FuncDecl {
  let expr = e_string(sd.name + " {");
  for i in 0..sd.fields.len() {
    let sep = " ";
    if (i > 0) {
      sep = ", ";
    }
    expr = e_binary("+", expr, e_string(sep + sd.fields[i].name + ": "));
    expr = e_binary("+", expr, dv_call0(dv_self_field(sd.fields[i].name), "to_string"));
  }
  if (sd.fields.len() == 0) {
    expr = e_binary("+", expr, e_string("}"));
  } else {
    expr = e_binary("+", expr, e_string(" }"));
  }
  let body: ast.Stmt[] = [s_return(expr)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "to_string", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: noparams, ret_own: false, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Display", dyn_traits: [], streams: [], is_unsafe: false };
}

function dv_is_debug_scalar(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u8" || t == "u16" || t == "i16" || t == "u32" || t == "u64"
    || t == "f32" || t == "f64" || t == "boolean";
}

function dv_debug_render(value: ast.Expr, t: string): ast.Expr {
  if (t == "string") {
    return e_binary("+", e_binary("+", e_string("\""), value), e_string("\""));
  }
  if (dv_is_debug_scalar(t)) {
    return dv_call0(value, "to_string");
  }
  return dv_call0(value, "to_debug");
}

function synth_struct_debug(sd: StructDecl): FuncDecl {
  let expr = e_string(sd.name + " {");
  for i in 0..sd.fields.len() {
    let sep = " ";
    if (i > 0) {
      sep = ", ";
