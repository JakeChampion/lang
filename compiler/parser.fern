}

function synth_struct_eq(sd: StructDecl): FuncDecl {
  let expr = e_bool(true);
  for i in 0..sd.fields.len() {
    let cm = dv_eq_expr(sd.fields[i].type_name, dv_self_field(sd.fields[i].name), dv_other_field(sd.fields[i].name));
    if (i == 0) {
      expr = cm;
    } else {
      expr = e_binary("&&", expr, cm);
    }
  }
  let body: ast.Stmt[] = [s_return(expr)];
  let notp: string[] = [];
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: "other", type_name: derived_self_type(sd), own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 }];
  return FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "eq", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: params, ret_own: false, ret_type: "boolean", body: body, line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Eq", dyn_traits: [], streams: [], is_unsafe: false };
}

function synth_struct_ord(sd: StructDecl): FuncDecl {
  let stmts: ast.Stmt[] = [];
  for i in 0..sd.fields.len() {
    let vn = "__c" + dl_itoa(i);
    let cs = dv_cmp_stmts(vn, sd.fields[i].type_name, dv_self_field(sd.fields[i].name), dv_other_field(sd.fields[i].name));
    for k in 0..cs.len() {
      stmts = stmts.append(cs[k]);
    }
    let cond = e_binary("!=", e_ident(vn), e_number("0", "", false));
    let thenb: ast.Stmt[] = [s_return(e_ident(vn))];
    let elseb: ast.Stmt[] = [];
    stmts = stmts.append(s_if(cond, thenb, elseb));
  }
  stmts = stmts.append(s_return(e_number("0", "", false)));
  let notp: string[] = [];
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: "other", type_name: derived_self_type(sd), own: false, send: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 }];
  return FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "cmp", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: params, ret_own: false, ret_type: "i32", body: stmts, line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Ord", dyn_traits: [], streams: [], is_unsafe: false };
}

