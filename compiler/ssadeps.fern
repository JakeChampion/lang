import "./ssa";
import "./ssalive";
import "./util";

function contains(values: i32[], value: i32): boolean {
  for v in values {
    if (v == value) {
      return true;
    }
  }
  return false;
}

pub function position_of(f: ssa.SFunc): i32[] {
  let top: i32 = 0;
  for b in f.blocks {
    if (b.id > top) {
      top = b.id;
    }
  }
  let out: i32[] = util.minus_ones(top + 1);
  let i: i32 = 0;
  while (i < f.blocks.len()) {
    out = out.with(f.blocks[i].id, i);
    i = i + 1;
  }
  return out;
}

pub function reachable_blocks(f: ssa.SFunc): boolean[] {
  let at: i32[] = position_of(f);
  let reachable: boolean[] = __alloc_bool(f.blocks.len());
  let entry: i32 = at[f.entry];
  reachable = reachable.with(entry, true);
  let work: i32[] = [entry];
  let depth: i32 = 1;
  while (depth > 0) {
    depth = depth - 1;
    let bi: i32 = work[depth];
    let which: i32 = 0;
    while (which < 2) {
      let id: i32 = ssa.successor_id(f.blocks[bi].term, which);
      if (id >= 0 && !reachable[at[id]]) {
        reachable = reachable.with(at[id], true);
        work = push_at(work, depth, at[id]);
        depth = depth + 1;
      }
      which = which + 1;
    }
  }
  return reachable;
}

pub struct Dom { pre: i32[], post: i32[], idom: i32[], by_clock: i32[] }

pub function dom_holds(d: Dom, bi: i32, di: i32): boolean {
  if (d.pre[bi] < 0 || d.pre[di] < 0) {
    return false;
  }
  return d.pre[di] <= d.pre[bi] && d.post[bi] <= d.post[di];
}

pub function dominates(f: ssa.SFunc): Dom {
  let n: i32 = f.blocks.len();
  let at: i32[] = position_of(f);
  let entry: i32 = at[f.entry];
  let po: i32[] = util.minus_ones(n);
  let order: i32[] = [];
  let seen: boolean[] = __alloc_bool(n);
  let stack: i32[] = [entry];
  let sp: i32 = 1;
  let next_succ: i32[] = util.minus_ones(n);
  seen = seen.with(entry, true);
  while (sp > 0) {
    let bi: i32 = stack[sp - 1];
    let term: ssa.STerm = f.blocks[bi].term;
    let k: i32 = next_succ[bi] + 1;
    let id: i32 = ssa.successor_id(term, k);
    while (id >= 0 && seen[at[id]]) {
      k = k + 1;
      id = ssa.successor_id(term, k);
    }
    next_succ = next_succ.with(bi, k);
    if (id >= 0) {
      let sk: i32 = at[id];
      seen = seen.with(sk, true);
      stack = push_at(stack, sp, sk);
      sp = sp + 1;
    } else {
      po = po.with(bi, order.len());
      order = order.append(bi);
      sp = sp - 1;
    }
  }
  let idom: i32[] = util.minus_ones(n);
  idom = idom.with(entry, entry);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let r: i32 = order.len() - 1;
    while (r >= 0) {
      let bi: i32 = order[r];
      r = r - 1;
      if (bi == entry) {
        continue;
      }
      let nd: i32 = 0 - 1;
      for pid in f.blocks[bi].preds {
        let p: i32 = at[pid];
        if (p < 0 || idom[p] < 0) {
          continue;
        }
        if (nd < 0) {
          nd = p;
        } else {
          nd = intersect(idom, po, p, nd);
        }
      }
      if (nd >= 0 && idom[bi] != nd) {
        idom = idom.with(bi, nd);
        changed = true;
      }
    }
  }
  let first_child: i32[] = util.minus_ones(n);
  let next_sibling: i32[] = util.minus_ones(n);
  let bi: i32 = 0;
  while (bi < n) {
    if (bi != entry && idom[bi] >= 0) {
      next_sibling = next_sibling.with(bi, first_child[idom[bi]]);
      first_child = first_child.with(idom[bi], bi);
    }
    bi = bi + 1;
  }
  let pre: i32[] = util.minus_ones(n);
  let post: i32[] = util.minus_ones(n);
  let clock: i32 = 0;
  let walk: i32[] = [entry];
  let wp: i32 = 1;
  let cursor: i32[] = util.minus_ones(n);
  pre = pre.with(entry, clock);
  clock = clock + 1;
  while (wp > 0) {
    let top: i32 = walk[wp - 1];
    let c: i32 = first_child[top];
    if (cursor[top] >= 0) {
      c = next_sibling[cursor[top]];
    }
    if (c >= 0) {
      cursor = cursor.with(top, c);
      pre = pre.with(c, clock);
      clock = clock + 1;
      walk = push_at(walk, wp, c);
      wp = wp + 1;
    } else {
      post = post.with(top, clock);
      clock = clock + 1;
      wp = wp - 1;
    }
  }
  let by_clock: i32[] = util.minus_ones(clock);
  bi = 0;
  while (bi < n) {
    if (pre[bi] >= 0) {
      by_clock = by_clock.with(pre[bi], bi);
    }
    bi = bi + 1;
  }
  return Dom { pre: pre, post: post, idom: idom, by_clock: by_clock };
}

function push_at(own stack: i32[], d: i32, v: i32): i32[] {
  if (d < stack.len()) {
    return stack.with(d, v);
  }
  return stack.append(v);
}

function intersect(idom: i32[], po: i32[], a: i32, b: i32): i32 {
  let x: i32 = a;
  let y: i32 = b;
  while (x != y) {
    while (po[x] < po[y]) {
      x = idom[x];
    }
    while (po[y] < po[x]) {
      y = idom[y];
    }
  }
  return x;
}

function available(value: i32, block: i32, pos: i32, defs: i32[], positions: i32[], dom: Dom): boolean {
  let definition: i32 = defs[value];
  if (definition < 0) {
    return false;
  }
  if (definition == block) {
    return positions[value] < pos;
  }
  return dom_holds(dom, block, definition);
}

function use_error(value: i32, block: i32, pos: i32, dependencies: i32[][], g: Facts): string {
  if (value < 0) {
    return "";
  }
  if (dependencies.len() == 0) {
    if (!available(value, block, pos, g.defs, g.positions, g.dom)) {
      return "value unavailable at use";
    }
    return "";
  }
  for dep in dependencies[value] {
    if (!available(dep, block, pos, g.defs, g.positions, g.dom)) {
      return "dependency unavailable at use";
    }
  }
  return "";
}

pub function analyze(f: ssa.SFunc, dependencies: i32[][]): ssalive.Flow {
  return analyze_checked(f, dependencies, unchecked());
}

pub function analyze_checked(f: ssa.SFunc, dependencies: i32[][], g: Facts): ssalive.Flow {
  let why: string = limits_error(f);
  if (why == "" && util.verify_on()) {
    if (g.checked) {
      why = dependencies_error(f, dependencies, g);
    } else {
      why = verify(f, dependencies);
    }
  }
  if (why != "") {
    return ssalive.Flow { ok: false, why: why, words: 0, live_in: [], live_out: [], slot: [], slot_value: [], at: [], none: [] };
  }
  return ssalive.compute_checked(f, dependencies);
}

pub function limits_error(f: ssa.SFunc): string {
  let n: i32 = f.blocks.len();
  if (n > 0 && n > 2147483647 / n) {
    return "dominator matrix overflow";
  }
  if (f.nvals > 0 && n > 2147483647 / f.nvals) {
    return "live matrix overflow";
  }
  return "";
}

pub struct Facts { checked: boolean, why: string, at: i32[], defs: i32[], positions: i32[], reachable: boolean[], dom: Dom }

pub function unchecked(): Facts {
  return Facts { checked: false, why: "", at: [], defs: [], positions: [], reachable: [], dom: Dom { pre: [], post: [], idom: [], by_clock: [] } };
}

function refused(why: string): Facts {
  return Facts { ...unchecked(), why: why };
}

pub function verify(f: ssa.SFunc, dependencies: i32[][]): string {
  let err: string = ssalive.dependency_error(f, dependencies);
  if (err != "") {
    return err;
  }
  let g: Facts = check_graph(f);
  if (g.why != "") {
    return g.why;
  }
  return dependencies_error(f, dependencies, g);
}

pub function check_graph(f: ssa.SFunc): Facts {
  let err: string = ssalive.graph_error(f);
  if (err != "") {
    return refused(err);
  }
  if (f.blocks.len() > 2147483647 / f.blocks.len()) {
    return refused("dominator matrix overflow");
  }
  if (f.nparams < 0 || f.nparams > f.nvals) {
    return refused("parameter dimensions");
  }
  let at: i32[] = position_of(f);
  if (f.blocks[at[f.entry]].preds.len() > 0) {
    return refused("entry has predecessors");
  }
  let defs: i32[] = util.minus_ones(f.nvals);
  let positions: i32[] = util.minus_ones(f.nvals);
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let pos: i32 = 0;
    let seen_regular: boolean = false;
    for ins in f.blocks[bi].insts {
      if (ins.kind_tag == 6 && (f.blocks[bi].id != f.entry || ins.imm < 0 || ins.imm >= f.nparams)) {
        return refused("invalid parameter definition");
      }
      if (ins.kind_tag == 8) {
        if (seen_regular || ins.result < 0) {
          return refused("invalid phi definition");
        }
      } else {
        seen_regular = true;
      }
      if (ins.result >= 0) {
        if (defs[ins.result] >= 0) {
          return refused("duplicate value definition");
        }
        defs = defs.with(ins.result, bi);
        positions = positions.with(ins.result, pos);
      }
      pos = pos + 1;
    }
    bi = bi + 1;
  }
  for b in f.blocks {
    for ins in b.insts {
      for arg in ins.args {
        if (defs[arg] < 0) {
          return refused("undefined value");
        }
      }
    }
    let used: i32 = term_value(b.term);
    if (used >= 0 && defs[used] < 0) {
      return refused("undefined value");
    }
  }
  let g: Facts = Facts { checked: true, why: "", at: at, defs: defs, positions: positions, reachable: reachable_blocks(f), dom: dominates(f) };
  err = uses_error(f, [], g);
  if (err != "") {
    return refused(err);
  }
  return g;
}

function term_value(t: ssa.STerm): i32 {
  if (t.kind_tag == 1) {
    return t.value;
  }
  if (t.kind_tag == 3) {
    return t.cond;
  }
  return 0 - 1;
}

pub function dependencies_error(f: ssa.SFunc, dependencies: i32[][], g: Facts): string {
  let err: string = ssalive.dependency_error(f, dependencies);
  if (err != "") {
    return err;
  }
  let any: boolean = false;
  let value: i32 = 0;
  while (value < f.nvals) {
    if (dependencies[value].len() > 0) {
      any = true;
      if (g.defs[value] < 0) {
        return "undefined dependency source";
      }
    }
    for dep in dependencies[value] {
      if (g.defs[dep] < 0) {
        return "undefined dependency";
      }
      if (dep == value) {
        return "cyclic dependency";
      }
      for transitive in dependencies[dep] {
        if (transitive == value) {
          return "cyclic dependency";
        }
        if (!contains(dependencies[value], transitive)) {
          return "incomplete dependency closure";
        }
      }
    }
    value = value + 1;
  }
  if (!any) {
    return "";
  }
  return uses_error(f, dependencies, g);
}

// An empty dependency table checks the values themselves.
function uses_error(f: ssa.SFunc, dependencies: i32[][], g: Facts): string {
  let err: string = "";
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let b: ssa.SBlock = f.blocks[bi];
    if (g.reachable[bi]) {
      let pos: i32 = 0;
      for ins in b.insts {
        if (ins.kind_tag == 8) {
          let pi: i32 = 0;
          while (pi < b.preds.len()) {
            let pb: i32 = g.at[b.preds[pi]];
            if (g.reachable[pb]) {
              err = use_error(ins.args[pi], pb, f.blocks[pb].insts.len(), dependencies, g);
              if (err != "") {
                return err;
              }
            }
            pi = pi + 1;
          }
        } else {
          for arg in ins.args {
            err = use_error(arg, bi, pos, dependencies, g);
            if (err != "") {
              return err;
            }
          }
        }
        pos = pos + 1;
      }
      err = use_error(term_value(b.term), bi, b.insts.len(), dependencies, g);
      if (err != "") {
        return err;
      }
    }
    bi = bi + 1;
  }
  return "";
}
