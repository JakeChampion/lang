import "./ast";
import "./lexer";
import "./parser";
import "./util";
import "core/map";
import "std/string";

function append_hex_escape(out: u8[], b: i32): u8[] {
  let a = out;
  a = a.append(92 as u8);
  a = a.append(120 as u8);
  a = a.append(util.hex_digit(b / 16));
  a = a.append(util.hex_digit(b % 16));
  return a;
}

function is_control_byte(b: i32): boolean {
  return b < 32 || b == 127;
}

// The size of the UTF-8 sequence that the byte `b` starts, or 0.
function sequence_size(b: i32): i32 {
  if (b >= 0xc2 && b < 0xe0) {
    return 2;
  }
  if (b >= 0xe0 && b < 0xf0) {
    return 3;
  }
  if (b >= 0xf0 && b < 0xf5) {
    return 4;
  }
  return 0;
}

// The scalar of the UTF-8 sequence at `i` and its size. The size is 0 when the
// bytes there are not one sequence.
function scalar_at(s: string, i: i32): (i32, i32) {
  let size = sequence_size(s[i] as i32);
  if (size == 0 || i + size > s.len()) {
    return (0, 0);
  }
  let cp = s[i] as i32 & 0xff >> size + 1;
  for k in 1..size {
    let c = s[i + k] as i32;
    if ((c & 0xc0) != 0x80) {
      return (0, 0);
    }
    cp = cp << 6 | c & 0x3f;
  }
  return (cp, size);
}

// The first and the last scalar of each range that a reader cannot see, or
// that changes the order of the text on the screen: the C1 controls, and the
// Unicode categories Cf, Zl, Zp and Zs. internal/syntax/printer/format.go
// holds the same ranges.
function hidden_ranges(): i32[] {
  return [
    0x80, 0xa0, 0xad, 0xad, 0x600, 0x605, 0x61c, 0x61c, 0x6dd, 0x6dd, 0x70f, 0x70f, 0x890, 0x891, 0x8e2, 0x8e2,
    0x1680, 0x1680, 0x180e, 0x180e, 0x2000, 0x200f, 0x2028, 0x202f, 0x205f, 0x2064, 0x2066, 0x206f, 0x3000,
    0x3000, 0xfeff, 0xfeff, 0xfff9, 0xfffb, 0x110bd, 0x110bd, 0x110cd, 0x110cd, 0x13430, 0x1343f, 0x1bca0,
    0x1bca3, 0x1d173, 0x1d17a, 0xe0001, 0xe0001, 0xe0020, 0xe007f,
  ];
}

function is_hidden_scalar(cp: i32, ranges: i32[]): boolean {
  let k = 0;
  while (k < ranges.len()) {
    if (cp >= ranges[k] && cp <= ranges[k + 1]) {
      return true;
    }
    k += 2;
  }
  return false;
}

// `\u{XXXX}` for the scalar `cp`, with 4 hex digits or more.
function append_scalar_escape(out: u8[], cp: i32): u8[] {
  let a = out;
  a = a.append(92 as u8);
  a = a.append(117 as u8);
  a = a.append(123 as u8);
  let shift = 20;
  while (shift >= 0) {
    let d = cp >> shift & 15;
    if (shift <= 12 || cp >> shift != 0) {
      if (d < 10) {
        a = a.append((48 + d) as u8);
      } else {
        a = a.append((55 + d) as u8);
      }
    }
    shift -= 4;
  }
  return a.append(125 as u8);
}

// The byte `b` of a literal as the source has it.
function append_lit_byte(out: u8[], b: i32, fstring: boolean): u8[] {
  let a = out;
  if (b == 34) {
    a = a.append(92 as u8);
    return a.append(34 as u8);
  }
  if (b == 92) {
    a = a.append(92 as u8);
    return a.append(92 as u8);
  }
  if (b == 10) {
    a = a.append(92 as u8);
    return a.append(110 as u8);
  }
  if (b == 9) {
    a = a.append(92 as u8);
    return a.append(116 as u8);
  }
  if (b == 13) {
    a = a.append(92 as u8);
    return a.append(114 as u8);
  }
  if (fstring && (b == 123 || b == 125)) {
    a = a.append(b as u8);
    return a.append(b as u8);
  }
  if (is_control_byte(b)) {
    return append_hex_escape(a, b);
  }
  return a.append(b as u8);
}

function escape_lit_body(s: string, fstring: boolean): string {
  let out: u8[] = [];
  let ranges = hidden_ranges();
  let i = 0;
  while (i < s.len()) {
    let (cp, size) = scalar_at(s, i);
    if (size > 0 && is_hidden_scalar(cp, ranges)) {
      out = append_scalar_escape(out, cp);
      i += size;
    } else {
      out = append_lit_byte(out, s[i] as i32, fstring);
      i += 1;
    }
  }
  unsafe {
    return string_from_bytes_unchecked(out);
  }
}

pub function quote_string(s: string): string {
  return "\"" + escape_lit_body(s, false) + "\"";
}

pub function escape_fstring_lit(s: string): string {
  return escape_lit_body(s, true);
}

function prec_lowest(): i32 {
  return 0;
}

function prec_assign(): i32 {
  return 1;
}

function prec_range(): i32 {
  return 3;
}

// The `..` or `..=` that a range desugar call came from, or "" for any
// other call. Only the parser writes the path-qualified callee.
function range_desugar_op(c: ast.ExprCall): string {
  if (c.args.len() != 2) {
    return "";
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    if let ast.ExprIdent(id) = fa.obj {
      if (id.name == parser.RANGE_MODULE && fa.field == "range") {
        return "..";
      }
      if (id.name == parser.RANGE_MODULE && fa.field == "range_incl") {
        return "..=";
      }
    }
  }
  return "";
}

function prec_cast(): i32 {
  return 14;
}

function prec_unary(): i32 {
  return 15;
}

function prec_primary(): i32 {
  return 16;
}

const BINARY_PREC_SET: string[] = ["<", "<=", ">", ">="];

const BINARY_PREC_SET2: string[] = ["<<", ">>", "<<|", "<<?", ">>?"];

const BINARY_PREC_SET3: string[] = ["+", "-", "+|", "-|", "+?", "-?"];

const BINARY_PREC_SET4: string[] = ["*", "/", "%", "*|", "*?", "/?", "%?"];

function binary_prec(op: string): i32 {
  if (op == "|>") {
    return 2;
  }
  if (op == "||") {
    return 4;
  }
  if (op == "&&") {
    return 5;
  }
  if (op == "==" || op == "!=") {
    return 6;
  }
  if (util.has_str(BINARY_PREC_SET, op)) {
    return 7;
  }
  if (op == "|") {
    return 8;
  }
  if (op == "^") {
    return 9;
  }
  if (op == "&") {
    return 10;
  }
  if (util.has_str(BINARY_PREC_SET2, op)) {
    return 11;
  }
  if (util.has_str(BINARY_PREC_SET3, op)) {
    return 12;
  }
  if (util.has_str(BINARY_PREC_SET4, op)) {
    return 13;
  }
  return prec_lowest();
}

function is_bitwise_op(op: string): boolean {
  return op == "&" || op == "|" || op == "^";
}

const IS_COMPARISON_OP_SET: string[] = ["==", "!=", "<", "<=", ">", ">="];

function is_comparison_op(op: string): boolean {
  return util.has_str(IS_COMPARISON_OP_SET, op);
}

// The precedence to print `operand` of the binary `op` at. Where a bitwise
// operator and a comparison meet, the operand keeps its parentheses, so the
// grouping does not depend on the reader's memory of the table.
function operand_prec(op: string, operand: ast.Expr, base: i32): i32 {
  if let ast.ExprBinary(c) = operand {
    if (is_bitwise_op(op) && is_comparison_op(c.op) || is_comparison_op(op) && is_bitwise_op(c.op)) {
      return prec_primary();
    }
  }
  return base;
}

function print_expr(e: ast.Expr, depth: i32): string {
  return print_expr_prec(e, prec_lowest(), depth);
}

function header_needs_parens(e: ast.Expr): boolean {
  match (e) {
    ast.ExprStructLit(_) => {
      return true;
    },
    ast.ExprMapLit(_) => {
      return true;
    },
    ast.ExprFieldAccess(f) => {
      return header_needs_parens(f.obj);
    },
    ast.ExprIndex(i) => {
      return header_needs_parens(i.array);
    },
    ast.ExprSlice(s) => {
      return header_needs_parens(s.array);
    },
    ast.ExprUnary(u) => {
      return header_needs_parens(u.operand);
    },
    ast.ExprBinary(b) => {
      return header_needs_parens(b.left) || header_needs_parens(b.right);
    },
    ast.ExprCall(c) => {
      if let ast.ExprLambda(l) = c.callee {
        return l.origin == parser.ORIGIN_BLOCK;
      }
      return header_needs_parens(c.callee);
    },
    _ => {
      return false;
    }
  }
}

function print_header_expr(e: ast.Expr, depth: i32): string {
  let text = print_expr(e, depth);
  if (header_needs_parens(e)) {
    return "(" + text + ")";
  }
  return text;
}

function print_lit(e: ast.Expr): string {
  return print_expr(e, 0);
}

function arrow_return_type(ret: string): string {
  if (parser.top_arrow_at(ret) >= 0) {
    return "(" + ret + ")";
  }
  return ret;
}

function print_lambda_params(lm: ast.ExprLambda, depth: i32): string {
  let (pats, _) = param_patterns_for(lm.params, lm.body);
  return print_params_with(lm.params, pats, true, depth);
}

function print_params_with(params: ast.ParamDecl[], pats: string[], defaults: boolean, depth: i32): string {
  let out = "(";
  for pi in 0..params.len() {
    if (pi > 0) {
      out += ", ";
    }
    if (params[pi].send) {
      out += "send ";
    } else if (params[pi].own) {
      out += "own ";
    }
    if (pi < pats.len() && pats[pi].len() > 0) {
      out += pats[pi];
    } else {
      out += written_name(params[pi].name);
    }
    if (params[pi].type_name.len() > 0) {
      out = out + ": " + params[pi].type_name;
    }
    out += print_param_default(params[pi], defaults, depth);
  }
  return out + ")";
}

function print_param_default(p: ast.ParamDecl, defaults: boolean, depth: i32): string {
  if (!defaults || !p.has_default) {
    return "";
  }
  return " = " + print_expr(p.default_value, depth);
}

function drop_prelude(body: ast.Stmt[], n: i32): ast.Stmt[] {
  if (n <= 0) {
    return body;
  }
  let out: ast.Stmt[] = [];
  for i in n..body.len() {
    out = out.append(body[i]);
  }
  return out;
}

function print_return_only(body: ast.Stmt[], depth: i32): string {
  let (text, _) = print_return_only_c(body, depth, empty_fmt());
  return text;
}

function print_return_only_c(body: ast.Stmt[], depth: i32, f: Fmt): (string, Fmt) {
  if (body.len() != 1) {
    return ("", f);
  }
  match (body[0]) {
    ast.StmtReturn(r) => {
      if (expr_is_missing(r.value) || match (as_use(r.value)) { Some(_) => true, None => false }) {
        return ("", f);
      }
      return print_expr_c(r.value, prec_lowest(), depth, f);
    },
    _ => {
      return ("", f);
    }
  }
}

// A body that holds a comment stays a block, so that the comment stays in the
// lambda.
function print_lambda_body(body: ast.Stmt[], depth: i32, f: Fmt): (string, Fmt) {
  if (body.len() == 0 || holds_comment(f, ast.stmt_line(body[0]))) {
    return print_block(body, depth, f);
  }
  let (av, g) = print_return_only_c(body, depth, f);
  if (av.len() > 0) {
    return (av, g);
  }
  if (body.len() == 1 && stmt_is_single_line(body[0])) {
    let (text, h) = print_stmt_body(body[0], depth, f);
    return ("{ " + text + " }", h);
  }
  return print_block(body, depth, f);
}

// Whether a comment is between the braces of the block whose first statement
// is on line first.
function holds_comment(f: Fmt, first: i32): boolean {
  let (open, close, _) = take_span(f, first);
  return open > 0 && inner_comment_pending(f, open - 1, close - 1);
}

function print_block_expr(c: ast.ExprCall, parent_prec: i32, depth: i32, f: Fmt): (string, Fmt) {
  if (c.args.len() != 0) {
    return ("", f);
  }
  match (c.callee) {
    ast.ExprLambda(lm) => {
      if (lm.origin != parser.ORIGIN_BLOCK || lm.body.len() == 0) {
        return ("", f);
      }
      if let Some(inner) = unsafe_value_body(lm.body) {
        let (text, nf) = print_value_block(inner, tail_expr(inner[inner.len() - 1]), true, depth, f);
        return ("unsafe " + text, nf);
      }
      let last = lm.body[lm.body.len() - 1];
      if (is_missing_tail(last)) {
        return print_value_block(lm.body, parser.e_unknown("block tail"), false, depth, f);
      }
      if (print_return_only([last], depth).len() == 0) {
        return ("", f);
      }
      if (lm.body.len() == 1) {
        return print_expr_c(tail_expr(last), parent_prec, depth, f);
      }
      return print_value_block(lm.body, tail_expr(last), true, depth, f);
    },
    _ => {
      return ("", f);
    }
  }
}

// The statements of an `unsafe { …; e }` value block: the parser wraps them,
// value included, in one unsafe block.
function unsafe_value_body(body: ast.Stmt[]): Option[ast.Stmt[]] {
  if (body.len() != 1) {
    return None;
  }
  if let ast.StmtIf(f) = body[0] {
    if (f.origin == "unsafe" && f.then_body.len() > 0 && print_return_only([f.then_body[f.then_body.len() - 1]], 0).len() > 0) {
      return Some(f.then_body);
    }
  }
  return None;
}

// Whether st is the statement that the parser puts where a value block has no
// trailing expression.
function is_missing_tail(st: ast.Stmt): boolean {
  if let ast.StmtUnknown(u) = st {
    return u.kind == "value branch has no trailing expression";
  }
  return false;
}

function tail_expr(st: ast.Stmt): ast.Expr {
  match (st) {
    ast.StmtReturn(r) => {
      return r.value;
    },
    _ => {
      return parser.e_unknown("block tail");
    }
  }
}

function iife_value_local(first: ast.Stmt, last: ast.Stmt): string {
  let name = "";
  match (first) {
    ast.StmtVar(v) => {
      name = v.name;
    },
    _ => {
      return "";
    }
  }
  if (name.len() == 0) {
    return "";
  }
  match (last) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprIdent(id) => {
          if (id.name == name) {
            return name;
          }
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
  return "";
}

function print_if_value_branch(body: ast.Stmt[], dead: boolean, depth: i32, f: Fmt): (string, Fmt) {
  if (body.len() == 0) {
    return ("", f);
  }
  let last = body[body.len() - 1];
  if (print_return_only([last], depth) == "") {
    return ("", f);
  }
  return print_value_block(body, tail_expr(last), !dead, depth, f);
}

function print_if_value(ifs: ast.StmtIf, depth: i32, f: Fmt): (string, Fmt) {
  if (ifs.origin != parser.ORIGIN_IF_EXPR && ifs.origin != parser.ORIGIN_IF_DEAD_THEN && ifs.origin != parser.ORIGIN_IF_DEAD_ELSE && ifs.origin != parser.ORIGIN_IF_DEAD_BOTH) {
    return ("", f);
  }
  let then_dead = ifs.origin == parser.ORIGIN_IF_DEAD_THEN || ifs.origin == parser.ORIGIN_IF_DEAD_BOTH;
  let else_dead = ifs.origin == parser.ORIGIN_IF_DEAD_ELSE || ifs.origin == parser.ORIGIN_IF_DEAD_BOTH;
  let (cond, g) = print_expr_c(ifs.cond, prec_lowest(), depth, f);
  let (tv, g1) = print_if_value_branch(ifs.then_body, then_dead, depth, g);
  let (ev, g2) = print_if_value_else(ifs, else_dead, depth, g1);
  if (tv == "" || ev == "") {
    return ("", f);
  }
  return ("if (" + cond + ") " + tv + " else " + ev, g2);
}

function print_if_value_else(ifs: ast.StmtIf, dead: boolean, depth: i32, f: Fmt): (string, Fmt) {
  if (ifs.else_chained && ifs.else_body.len() == 1) {
    match (ifs.else_body[0]) {
      ast.StmtIf(nested) => {
        return print_if_value(nested, depth, f);
      },
      ast.StmtReturn(r) => {
        return print_expr_c(r.value, prec_lowest(), depth, f);
      },
      _ => {
        return ("", f);
      }
    }
  }
  return print_if_value_branch(ifs.else_body, dead, depth, f);
}

function print_expr_iife(c: ast.ExprCall, parent_prec: i32, depth: i32, f: Fmt): (string, Fmt) {
  if (c.args.len() != 0) {
    return ("", f);
  }
  match (c.callee) {
    ast.ExprLambda(lm) => {
      if (lm.params.len() != 0) {
        return ("", f);
      }
      if (lm.origin == parser.ORIGIN_IF_EXPR && lm.body.len() == 1) {
        if let ast.StmtIf(ifs) = lm.body[0] {
          let (text, g) = print_if_value(ifs, depth, f);
          return (if_value_parens(text, parent_prec), g);
        }
      }
      if (lm.body.len() == 3) {
        return print_value_local_body(lm.body, depth, f);
      }
      if (lm.body.len() == 2) {
        return print_literal_scrut_iife(lm.body, parent_prec, depth, f);
      }
      if (lm.body.len() != 1) {
        return ("", f);
      }
      match (lm.body[0]) {
        ast.StmtMatch(m) => {
          return print_match_expr_arms(m, "", depth, f);
        },
        ast.StmtIf(ifs) => {
          if (ifs.sugar.lits.len() > 0) {
            return print_sugared_match_expr(ifs.sugar, "", depth, f);
          }
          return print_plain_if_iife(ifs, parent_prec, depth, f);
        },
        _ => {
          return ("", f);
        }
      }
      return ("", f);
    },
    _ => {
      return ("", f);
    }
  }
}

function if_value_parens(text: string, parent_prec: i32): string {
  if (text != "" && parent_prec > 3) {
    return "(" + text + ")";
  }
  return text;
}

// A value match whose result goes through a local: `let v; match ...; return v`.
function print_value_local_body(body: ast.Stmt[], depth: i32, f: Fmt): (string, Fmt) {
  let vl = iife_value_local(body[0], body[2]);
  if (vl.len() == 0) {
    return ("", f);
  }
  match (body[1]) {
    ast.StmtMatch(m) => {
      return print_match_expr_arms(m, vl, depth, f);
    },
    ast.StmtIf(vf) => {
      return print_sugared_match_expr(vf.sugar, vl, depth, f);
    },
    _ => {
      return ("", f);
    }
  }
}

// A literal match on a scrutinee that is not a name binds it to a local first.
function print_literal_scrut_iife(body: ast.Stmt[], parent_prec: i32, depth: i32, f: Fmt): (string, Fmt) {
  if let ast.StmtVar(sv) = body[0] {
    if (!parser.is_literal_scrut_local(sv.name)) {
      return ("", f);
    }
    if let ast.StmtReturn(sr) = body[1] {
      if let ast.ExprCall(ic) = sr.value {
        return print_expr_iife(ic, parent_prec, depth, f);
      }
    }
  }
  return ("", f);
}

function print_plain_if_iife(ifs: ast.StmtIf, parent_prec: i32, depth: i32, f: Fmt): (string, Fmt) {
  let (cond, g) = print_expr_c(ifs.cond, prec_lowest(), depth, f);
  let (tv, g1) = print_return_only_c(ifs.then_body, depth, g);
  let (ev, g2) = print_return_only_c(ifs.else_body, depth, g1);
  if (tv.len() == 0 || ev.len() == 0) {
    return ("", f);
  }
  return (if_value_parens("if (" + cond + ") { " + tv + " } else { " + ev + " }", parent_prec), g2);
}

function print_value_local_iife(c: ast.ExprCall, depth: i32, f: Fmt): (string, Fmt) {
  if (c.args.len() != 0) {
    return ("", f);
  }
  match (c.callee) {
    ast.ExprLambda(lm) => {
      if (lm.params.len() != 0 || lm.body.len() != 3) {
        return ("", f);
      }
      let v = value_local_name(lm.body[0], lm.body[2]);
      if (v.len() == 0) {
        return ("", f);
      }
      match (lm.body[1]) {
        ast.StmtIf(ifs) => {
          return print_sugared_match_expr(ifs.sugar, v, depth, f);
        },
        ast.StmtMatch(m) => {
          return print_match_expr_arms(m, v, depth, f);
        },
        _ => {
          return ("", f);
        }
      }
      return ("", f);
    },
    _ => {
      return ("", f);
    }
  }
}

function value_local_name(first: ast.Stmt, last: ast.Stmt): string {
  let declared = "";
  match (first) {
    ast.StmtVar(vd) => {
      declared = vd.name;
    },
    _ => {
      return "";
    }
  }
  if (declared.len() == 0) {
    return "";
  }
  match (last) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprIdent(id) => {
          if (id.name == declared) {
            return declared;
          }
          return "";
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
}

function print_match_expr_arms(m: ast.StmtMatch, v: string, depth: i32, f: Fmt): (string, Fmt) {
  let arms = m.arms;
  let val = v;
  if (m.sugar.len() > 0) {
    arms = m.sugar;
    val = "";
  }
  if (arms.len() == 0) {
    return ("", f);
  }
  let sg = ast.MatchSugar { scrut: m.scrutinee, tup: [], strct: [], lits: [], arms: arms, line: m.line, col: m.col, origin: m.origin, else_chained: m.else_chained, arms_open: m.arms_open };
  if (m.origin == "if_let") {
    return print_sugared_match_expr(sg, v, depth, f);
  }
  return print_value_match(sg.scrut, sg.arms_open, sugar_written_arms(sg), val, depth, f);
}

function print_sugared_match_expr(sg: ast.MatchSugar, v: string, depth: i32, f: Fmt): (string, Fmt) {
  let value_local = v;
  if (sg.arms.len() > 0 && sg.origin != "if_let") {
    value_local = "";
  }
  let arms = sugar_written_arms(sg);
  if (arms.len() == 0) {
    return ("", f);
  }
  if (sg.origin == "if_let" && arms.len() >= 2) {
    return print_value_if_let(sg, arms, value_local, depth, f);
  }
  return print_value_match(sg.scrut, sg.arms_open, arms, value_local, depth, f);
}

function print_value_if_let(sg: ast.MatchSugar, arms: WrittenArm[], v: string, depth: i32, f: Fmt): (string, Fmt) {
  let head = arms[0].head;
  for i in 1..arms.len() - 1 {
    head = head + " | " + arms[i].head;
  }
  let (yes, g) = arm_expr_value(arms[0].body, v, false, depth, f);
  let (no, g1) = arm_expr_value(arms[arms.len() - 1].body, v, sg.else_chained, depth, g);
  if (yes.len() == 0 || no.len() == 0) {
    return ("", f);
  }
  return ("if let " + head + " = " + print_header_expr(sg.scrut, depth) + " " + yes + " else " + no, g1);
}

// A value match keeps one arm group on each line when its arms were written
// on lines after the line open of its brace, or when an arm group does not
// fit on one line.
function print_value_match(scrut: ast.Expr, open: i32, arms: WrittenArm[], v: string, depth: i32, f: Fmt): (string, Fmt) {
  let (sv, g) = print_expr_c(scrut, prec_lowest(), depth, f);
  let head = "match (" + sv + ") {";
  if (keep_list_lines(g, open, arms[arms.len() - 1].line)) {
    return value_match_lines(head, arms, v, depth, g);
  }
  let out = head + " ";
  let h = g;
  for i in 0..arms.len() {
    let (av, g1) = print_value_arm(arms[i], v, depth, h);
    if (av.len() == 0) {
      return ("", f);
    }
    if (util.contains(av, "\n")) {
      return value_match_lines(head, arms, v, depth, g);
    }
    if (i > 0) {
      out += ", ";
    }
    out += av;
    h = g1;
  }
  return (out + " }", h);
}

function value_match_lines(head: string, arms: WrittenArm[], v: string, depth: i32, f: Fmt): (string, Fmt) {
  let (lines, g) = print_value_arm_lines(arms, v, depth, f);
  if (lines.len() == 0) {
    return ("", f);
  }
  return (head + lines + indent_str(depth) + "}", g);
}

// Arm groups written on one source line stay together, but an arm group that
// spans lines ends its line.
function print_value_arm_lines(arms: WrittenArm[], v: string, depth: i32, f: Fmt): (string, Fmt) {
  let out = "\n";
  let g = f;
  let i = 0;
  while (i < arms.len()) {
    let ln = arms[i].line;
    let (lead, g1) = drain_leading(g, ln, depth + 1);
    out = out + lead + indent_str(depth + 1);
    g = g1;
    let j = i;
    let spans = false;
    while (j < arms.len() && (j == i || arms[j].line == ln && !spans)) {
      let (av, g2) = print_value_arm(arms[j], v, depth + 1, g);
      if (av.len() == 0) {
        return ("", f);
      }
      if (j > i) {
        out += ", ";
      }
      out += av;
      spans = util.contains(av, "\n");
      g = g2;
      j += 1;
    }
    let (trail, g3) = emit_trailing(g, ln);
    out = out + "," + trail + "\n";
    g = g3;
    i = j;
  }
  return (out, g);
}

function print_value_arm(a: WrittenArm, v: string, depth: i32, f: Fmt): (string, Fmt) {
  let out = a.head;
  let g = f;
  if (a.has_guard) {
    let (gv, g1) = print_expr_c(a.guard, prec_lowest(), depth, g);
    out = out + " when " + gv;
    g = g1;
  }
  let (av, g2) = arm_expr_value(a.body, v, true, depth, g);
  if (av.len() == 0) {
    return ("", f);
  }
  return (out + " => " + av, g2);
}

// arm_expr_value prints the value of an arm body. A body that is only its
// value prints bare when bare is set, and as a block otherwise.
function arm_expr_value(body: ast.Stmt[], v: string, bare: boolean, depth: i32, f: Fmt): (string, Fmt) {
  if (body.len() == 0) {
    return ("", f);
  }
  let last = body[body.len() - 1];
  if (v.len() > 0) {
    return local_arm_value(body, v, bare, depth, f);
  }
  if (body.len() > 1 && parser.branch_stmts_diverge([body[body.len() - 2]])) {
    return print_value_block(body, tail_expr(last), false, depth, f);
  }
  if (print_return_only([last], depth).len() == 0) {
    return ("", f);
  }
  if (bare && body.len() == 1) {
    return print_expr_c(tail_expr(last), prec_lowest(), depth, f);
  }
  return print_value_block(body, tail_expr(last), true, depth, f);
}

// local_arm_value prints an arm body that ends in an assignment to the value
// local v.
function local_arm_value(body: ast.Stmt[], v: string, bare: boolean, depth: i32, f: Fmt): (string, Fmt) {
  let last = body[body.len() - 1];
  if let Some(set) = assign_parts(last) {
    if (print_expr(set.place, depth) == v) {
      if (print_expr(set.value, depth).len() == 0) {
        return ("", f);
      }
      if (bare && body.len() == 1) {
        return print_expr_c(set.value, prec_lowest(), depth, f);
      }
      return print_value_block(body, set.value, true, depth, f);
    }
  }
  if (parser.branch_stmts_diverge(body)) {
    return print_value_block(body.append(last), tail_expr(last), false, depth, f);
  }
  return ("", f);
}

// print_value_block prints the statements of body before its last, then tail
// when show_tail is set. The block is on one line when it was written on one
// line, and has one statement on each line otherwise.
function print_value_block(body: ast.Stmt[], tail: ast.Expr, show_tail: boolean, depth: i32, f: Fmt): (string, Fmt) {
  let n = body.len() - 1;
  let last = 0;
  if (show_tail) {
    last = first_line(tail);
  } else if (n > 0) {
    last = ast.stmt_line(body[n - 1]);
  }
  let first = last;
  if (n > 0 && ast.stmt_line(body[0]) > 0) {
    first = ast.stmt_line(body[0]);
  }
  let (open, _, g) = take_span(f, first);
  if (keep_list_lines(g, open, last)) {
    return print_value_block_lines(body, n, tail, show_tail, depth, g);
  }
  let out = "{ ";
  let h = g;
  for i in 0..n {
    let (text, h1) = print_stmt_body(body[i], 0, h);
    if (util.contains(text, "\n")) {
      return print_value_block_lines(body, n, tail, show_tail, depth, g);
    }
    out = out + text + " ";
    h = h1;
  }
  if (show_tail) {
    let (tv, h2) = print_expr_c(tail, prec_lowest(), depth, h);
    out = out + tv + " ";
    h = h2;
  }
  return (out + "}", h);
}

function print_value_block_lines(body: ast.Stmt[], n: i32, tail: ast.Expr, show_tail: boolean, depth: i32, f: Fmt): (string, Fmt) {
  let out = "{\n";
  let g = f;
  for i in 0..n {
    let ln = ast.stmt_line(body[i]);
    if (i > 0 && ln > 0 && g.blank_before(ln)) {
      out += "\n";
    }
    if (ln > 0) {
      let (lead, g1) = drain_leading(g, ln, depth + 1);
      out += lead;
      g = g1;
    }
    let (text, g2) = print_stmt(body[i], depth + 1, g);
    out += text;
    g = g2;
  }
  if (show_tail) {
    let (tv, g3) = print_value_tail(tail, n > 0, depth + 1, g);
    out += tv;
    g = g3;
  }
  return (out + indent_str(depth) + "}", g);
}

function print_value_tail(tail: ast.Expr, after_stmt: boolean, depth: i32, f: Fmt): (string, Fmt) {
  let ln = first_line(tail);
  let out = "";
  if (after_stmt && ln > 0 && f.blank_before(ln)) {
    out = "\n";
  }
  let (lead, g) = drain_leading(f, ln, depth);
  let (tv, g1) = print_expr_c(tail, prec_lowest(), depth, g);
  let (tr, g2) = emit_trailing(g1, ln);
  let (tr2, g3) = emit_trailing(g2, last_line(tail, g2.spans));
  return (out + lead + indent_str(depth) + tv + tr + tr2 + "\n", g3);
}

function print_expr_prec(e: ast.Expr, parent_prec: i32, depth: i32): string {
  let (text, _) = print_expr_c(e, parent_prec, depth, empty_fmt());
  return text;
}

function print_unary_c(u: ast.ExprUnary, parent_prec: i32, depth: i32, f: Fmt): (string, Fmt) {
  // Both cast forms are written after their operand. The checked form
  // uses the same precedence and parentheses as a plain cast.
  let checked_cast = u.op.len() > 4 && u.op.starts_with("as?_");
  if (checked_cast || u.op.len() > 3 && u.op.starts_with("as_")) {
    let (co, cf) = print_expr_c(u.operand, prec_unary(), depth, f);
    let start = 3;
    let cast_op = " as ";
    if (checked_cast) {
      start = 4;
      cast_op = " as? ";
    }
    let cinner = co + cast_op + slice_unchecked(u.op, start, u.op.len());
    if (parent_prec >= prec_cast()) {
      return ("(" + cinner + ")", cf);
    }
    return (cinner, cf);
  }
  if (u.op == "try_") {
    let (to, tf) = print_expr_c(u.operand, prec_unary(), depth, f);
    return (to + "?", tf);
  }
  let (uo, uf) = print_expr_c(u.operand, prec_unary(), depth, f);
  let uinner = u.op + uo;
  if (parent_prec >= prec_unary()) {
    return ("(" + uinner + ")", uf);
  }
  return (uinner, uf);
}

function print_expr_c(e: ast.Expr, parent_prec: i32, depth: i32, f: Fmt): (string, Fmt) {
  match (e) {
    ast.ExprBytes(bs) => {
      let out = "[";
      let i = 0;
      while (i < bs.value.len()) {
        if (i > 0) {
          out += ", ";
        }
        out = out + util.i32_to_string(bs.value[i] as i32) + "u8";
        i += 1;
      }
      return (out + "]", f);
    },
    ast.ExprNumber(n) => {
      if (n.raw.len() > 0) {
        return (n.raw, f);
      }
      if (n.suffix.len() > 0) {
        return (n.text + n.suffix, f);
      }
      return (n.text, f);
    },
    ast.ExprIdent(id) => {
      return (id.name, f);
    },
    ast.ExprString(s) => {
      return (quote_string(s.value), f);
    },
    ast.ExprBool(b) => {
      if (b.value) {
        return ("true", f);
      }
      return ("false", f);
    },
    ast.ExprBinary(b) => {
      if (b.op == "__named_arg") {
        let (nl, nf) = print_expr_c(b.left, prec_lowest(), depth, f);
        let (nr, nf2) = print_expr_c(b.right, prec_lowest(), depth, nf);
        return (nl + " = " + nr, nf2);
      }
      let p = binary_prec(b.op);
      let (bl, bf) = print_expr_c(b.left, operand_prec(b.op, b.left, p), depth, f);
      let gap = " ";
      if (written_break(b, f.spans)) {
        let (tr, tf) = emit_trailing(bf, last_line(b.left, bf.spans));
        let lead = "";
        if (tf.ci < tf.comments.len() && tf.comments[tf.ci].line > first_line(b.left)) {
          let (ld, lf) = drain_leading(tf, b.line, depth + 1);
          lead = ld;
          tf = lf;
        }
        gap = tr + "\n" + lead + indent_str(depth + 1);
        bf = tf;
      }
      let (br, bf2) = print_expr_c(b.right, operand_prec(b.op, b.right, p + 1), depth, bf);
      let inner = bl + gap + b.op + " " + br;
      if (p < parent_prec) {
        return ("(" + inner + ")", bf2);
      }
      return (inner, bf2);
    },
    ast.ExprUnary(u) => {
      return print_unary_c(u, parent_prec, depth, f);
    },
    ast.ExprCall(c) => {
      let dots = range_desugar_op(c);
      if (dots.len() > 0) {
        let (rl, rf) = print_expr_c(c.args[0], prec_range() + 1, depth, f);
        let (rr, rf2) = print_expr_c(c.args[1], prec_range() + 1, depth, rf);
        if (parent_prec > prec_range()) {
          return ("(" + rl + dots + rr + ")", rf2);
        }
        return (rl + dots + rr, rf2);
      }
      let (blk, bf) = print_block_expr(c, parent_prec, depth, f);
      if (blk.len() > 0) {
        return (blk, bf);
      }
      let (vl, vf) = print_value_local_iife(c, depth, f);
      if (vl.len() > 0) {
        return (vl, vf);
      }
      let (iife, ivf) = print_expr_iife(c, parent_prec, depth, f);
      if (iife.len() > 0) {
        return (iife, ivf);
      }
      let (callee, cf) = print_expr_c(c.callee, prec_primary(), depth, f);
      let (args, af) = print_list(c.args, ast.expr_line(e), "", depth, cf);
      return (callee + "(" + args + ")", af);
    },
    ast.ExprArray(a) => {
      let (elems, af) = print_list(a.elements, a.line, "", depth, f);
      return ("[" + elems + "]", af);
    },
    ast.ExprTuple(t) => {
      let out = "(";
      let i = 0;
      while (i < t.elements.len()) {
        if (i > 0) {
          out += ", ";
        }
        out += print_expr(t.elements[i], depth);
        i += 1;
      }
      return (out + ")", f);
    },
    ast.ExprIndex(x) => {
      let (xa, xf) = print_expr_c(x.array, prec_primary(), depth, f);
      let (xi, xf2) = print_expr_c(x.index, prec_lowest(), depth, xf);
      return (xa + "[" + xi + "]", xf2);
    },
    ast.ExprSlice(sl) => {
      let lo = "";
      if (!sl.open_start) {
        lo = print_expr(sl.start, depth);
      }
      let hi = "";
      if (!sl.open_end) {
        hi = print_expr(sl.end, depth);
      }
      return (print_expr_prec(sl.array, prec_primary(), depth) + "[" + lo + ":" + hi + "]", f);
    },
    ast.ExprStructLit(sl) => {
      let vals: ast.Expr[] = [];
      let prefixes: string[] = [];
      if (sl.has_base) {
        vals = vals.append(sl.base);
        prefixes = prefixes.append("...");
      }
      let i = 0;
      while (i < sl.field_names.len()) {
        vals = vals.append(sl.field_values[i]);
        prefixes = prefixes.append(sl.field_names[i] + ": ");
        i += 1;
      }
      let lns = list_lines(vals, sl.line, f);
      if (vals.len() > 0 && keep_list_lines(f, sl.line, lns[lns.len() - 1])) {
        let (lines, lf) = print_list_lines(vals, lns, prefixes, depth, f);
        return (sl.type_name + " {" + lines + indent_str(depth) + "}", lf);
      }
      let (flds, ff) = print_list_flat(vals, prefixes, depth, f);
      return (sl.type_name + " { " + flds + " }", ff);
    },
    ast.ExprFieldAccess(fa) => {
      let (fo, ff) = print_expr_c(fa.obj, prec_primary(), depth, f);
      return (fo + "." + fa.field, ff);
    },
    ast.ExprLambda(lm) => {
      let (pats, npre) = param_patterns_for(lm.params, lm.body);
      let out = print_params_with(lm.params, pats, false, depth);
      if (lm.ret_type.len() > 0) {
        out = out + ": ";
        if (lm.ret_own) {
          out += "own ";
        }
        out += arrow_return_type(lm.ret_type);
      }
      out += " => ";
      let (text, g) = print_lambda_body(drop_prelude(lm.body, npre), depth, f);
      out += text;
      if (parent_prec > prec_assign()) {
        return ("(" + out + ")", g);
      }
      return (out, g);
    },
    ast.ExprFString(fs) => {
      let out = "f\"";
      let i = 0;
      while (i < fs.lits.len()) {
        if (fs.is_expr[i]) {
          out = out + "{" + print_expr(fs.exprs[i], depth) + "}";
        } else {
          out += escape_fstring_lit(fs.lits[i]);
        }
        i += 1;
      }
      return (out + "\"", f);
    },
    ast.ExprMapLit(ml) => {
      let out = "Map {";
      for i in 0..ml.keys.len() {
        if (i > 0) {
          out += ",";
        }
        out = out + " " + print_expr(ml.keys[i], depth) + ": " + print_expr(ml.vals[i], depth);
      }
      return (out + " }", f);
    },
    ast.ExprUnknown(_) => {
      return ("", f);
    },
    ast.ExprZero(z) => {
      return ("/*zero:" + z.type_name + "*/", f);
    }
  }
}

function elem_line(e: ast.Expr, prev: i32): i32 {
  let ln = first_line(e);
  if (ln == 0) {
    return prev;
  }
  return ln;
}

function elem_lines(elems: ast.Expr[], open_line: i32): i32[] {
  let out: i32[] = [];
  let prev = open_line;
  for x in elems {
    prev = elem_line(x, prev);
    out = out.append(prev);
  }
  return out;
}

function list_lines(elems: ast.Expr[], open_line: i32, f: Fmt): i32[] {
  return grouped_lines(elems, open_line, f.spans, f.si);
}

// An element after a lambda closing brace on the same line stays in its group.
// The lambda body spans are looked up from span index from.
function grouped_lines(elems: ast.Expr[], open_line: i32, spans: parser.BlockSpans, from: i32): i32[] {
  let lines = elem_lines(elems, open_line);
  for i in 1..elems.len() {
    if (first_line(elems[i]) == first_line(elems[i - 1])) {
      lines = lines.with(i, lines[i - 1]);
    } else if let ast.ExprLambda(lm) = elems[i - 1] {
      let (_, npre) = param_patterns_for(lm.params, lm.body);
      if (npre < lm.body.len()) {
        let first = ast.stmt_line(lm.body[npre]);
        for j in from..spans.firsts.len() {
          if (spans.firsts[j] == first && spans.opens[j] >= lm.line) {
            if (spans.closes[j] == first_line(elems[i])) {
              lines = lines.with(i, lines[i - 1]);
            }
            break;
          }
        }
      }
    }
  }
  return lines;
}

function print_list(elems: ast.Expr[], open_line: i32, prefix: string, depth: i32, f: Fmt): (string, Fmt) {
  let prefixes: string[] = [];
  for x in elems {
    prefixes = prefixes.append(prefix);
  }
  let lns = list_lines(elems, open_line, f);
  if (elems.len() > 0 && keep_list_lines(f, open_line, lns[lns.len() - 1])) {
    let (lines, lf) = print_list_lines(elems, lns, prefixes, depth, f);
    return (lines + indent_str(depth), lf);
  }
  return print_list_flat(elems, prefixes, depth, f);
}

function print_list_flat(elems: ast.Expr[], prefixes: string[], depth: i32, f: Fmt): (string, Fmt) {
  let out = "";
  let g = f;
  for i in 0..elems.len() {
    if (i > 0) {
      out += ", ";
    }
    let (t, g2) = print_expr_c(elems[i], prec_lowest(), depth, g);
    out = out + prefixes[i] + t;
    g = g2;
  }
  return (out, g);
}

function print_list_lines(elems: ast.Expr[], lns: i32[], prefixes: string[], depth: i32, f: Fmt): (string, Fmt) {
  let out = "\n";
  let g = f;
  let i = 0;
  while (i < elems.len()) {
    let ln = lns[i];
    let (lead, g1) = drain_leading(g, ln, depth + 1);
    out = out + lead + indent_str(depth + 1);
    g = g1;
    let j = i;
    while (j < elems.len() && (j == i || lns[j] == ln)) {
      if (j > i) {
        out += ", ";
      }
      let (t, g2) = print_expr_c(elems[j], prec_lowest(), depth + 1, g);
      out = out + prefixes[j] + t;
      g = g2;
      j += 1;
    }
    let (trail, g3) = emit_trailing(g, ln);
    out = out + "," + trail + "\n";
    g = g3;
    i = j;
  }
  return (out, g);
}

function indent_str(depth: i32): string {
  let out = "";
  for i in 0..depth {
    out += "  ";
  }
  return out;
}

// at is the line of the statement in print. own is the span of the last block printed, or -1.
struct Fmt { comments: lexer.Comment[], ci: i32, blanks: boolean[], spans: parser.BlockSpans, si: i32, at: i32, own: i32 }

function empty_fmt(): Fmt {
  return Fmt { comments: [], ci: 0, blanks: [], spans: no_spans(), si: 0, at: 0, own: -1 };
}

function no_spans(): parser.BlockSpans {
  return parser.BlockSpans { opens: [], firsts: [], closes: [], else_of: [] };
}

function take_span(f: Fmt, first: i32): (i32, i32, Fmt) {
  if (first <= 0) {
    return (0, 0, f);
  }
  for i in f.si..f.spans.firsts.len() {
    if (f.spans.firsts[i] == first) {
      return (f.spans.opens[i], f.spans.closes[i], Fmt { ...f, si: i + 1 });
    }
  }
  return (0, 0, f);
}

function (f: Fmt) blank_at(line: i32): boolean {
  if (line < 0 || line >= f.blanks.len()) {
    return false;
  }
  return f.blanks[line];
}

function (f: Fmt) blank_before(line: i32): boolean {
  let top = line;
  if (f.ci < f.comments.len() && f.comments[f.ci].line < line) {
    top = f.comments[f.ci].line;
  }
  return f.blank_at(top - 1);
}

function drain_leading(f: Fmt, line: i32, depth: i32): (string, Fmt) {
  let out = "";
  let g = f;
  let last = 0;
  while (g.ci < g.comments.len() && g.comments[g.ci].line < line) {
    if (last > 0 && g.blank_at(g.comments[g.ci].line - 1)) {
      out += "\n";
    }
    last = g.comments[g.ci].line;
    out = out + indent_str(depth) + "//" + g.comments[g.ci].text + "\n";
    g = Fmt { ...g, ci: g.ci + 1 };
  }
  return (out, g);
}

function drain_decl_leading(f: Fmt, line: i32): (string, Fmt) {
  let chunks: string[] = [];
  let g = f;
  let last = 0;
  while (g.ci < g.comments.len() && g.comments[g.ci].line < line) {
    if (last > 0 && g.blank_at(g.comments[g.ci].line - 1)) {
      chunks = chunks.append("\n");
    }
    last = g.comments[g.ci].line;
    chunks = chunks.append("//" + g.comments[g.ci].text + "\n");
    g = Fmt { ...g, ci: g.ci + 1 };
  }
  if (last > 0 && g.blank_at(last + 1)) {
    chunks = chunks.append("\n");
  }
  return (util.str_join_chunks(chunks), g);
}

function emit_trailing(f: Fmt, line: i32): (string, Fmt) {
  if (f.ci < f.comments.len() && f.comments[f.ci].line == line && f.comments[f.ci].trailing) {
    return ("  //" + f.comments[f.ci].text, Fmt { ...f, ci: f.ci + 1 });
  }
  return ("", f);
}

function written_break(b: ast.ExprBinary, spans: parser.BlockSpans): boolean {
  if (b.line == 0) {
    return false;
  }
  let left = last_line(b.left, spans);
  return left > 0 && b.line > left || first_line(b.right) > b.line;
}

function first_line(e: ast.Expr): i32 {
  match (e) {
    ast.ExprBinary(b) => {
      return first_line(b.left);
    },
    ast.ExprCall(c) => {
      let ln = first_line(c.callee);
      if (ln == 0) {
        return c.line;
      }
      return ln;
    },
    ast.ExprIndex(ix) => {
      return first_line(ix.array);
    },
    ast.ExprSlice(sl) => {
      return first_line(sl.array);
    },
    ast.ExprFieldAccess(fa) => {
      return first_line(fa.obj);
    },
    ast.ExprUnary(u) => {
      if (is_postfix_unary(u.op)) {
        return first_line(u.operand);
      }
      return u.line;
    },
    _ => {
      return ast.expr_line(e);
    }
  }
}

function is_postfix_unary(op: string): boolean {
  return op.starts_with("as_") || op.starts_with("as?_") || op == "try_";
}

function last_line(e: ast.Expr, spans: parser.BlockSpans): i32 {
  let ln = ast.expr_line(e);
  match (e) {
    ast.ExprBinary(b) => {
      return max_line(max_line(ln, last_line(b.left, spans)), last_line(b.right, spans));
    },
    ast.ExprUnary(u) => {
      return max_line(ln, last_line(u.operand, spans));
    },
    ast.ExprCall(c) => {
      return max_line(max_line(ln, last_line(c.callee, spans)), last_line_of(c.args, spans)) + list_closer(c.line, c.args, spans);
    },
    ast.ExprArray(a) => {
      return max_line(ln, last_line_of(a.elements, spans)) + list_closer(a.line, a.elements, spans);
    },
    ast.ExprTuple(t) => {
      return max_line(ln, last_line_of(t.elements, spans));
    },
    ast.ExprIndex(ix) => {
      return max_line(max_line(ln, last_line(ix.array, spans)), last_line(ix.index, spans));
    },
    ast.ExprSlice(sl) => {
      return max_line(max_line(max_line(ln, last_line(sl.array, spans)), last_line(sl.start, spans)), last_line(sl.end, spans));
    },
    ast.ExprStructLit(st) => {
      let vals: ast.Expr[] = [];
      if (st.has_base) {
        vals = vals.append(st.base);
      }
      for v in st.field_values {
        vals = vals.append(v);
      }
      return max_line(ln, last_line_of(vals, spans)) + list_closer(st.line, vals, spans);
    },
    ast.ExprFieldAccess(fa) => {
      return max_line(ln, last_line(fa.obj, spans));
    },
    ast.ExprMapLit(ml) => {
      return max_line(max_line(ln, last_line_of(ml.keys, spans)), last_line_of(ml.vals, spans));
    },
    _ => {
      return ln;
    }
  }
}

function list_closer(open: i32, es: ast.Expr[], spans: parser.BlockSpans): i32 {
  if (open <= 0 || es.len() == 0) {
    return 0;
  }
  let lns = grouped_lines(es, open, spans, 0);
  if (lns[lns.len() - 1] > open) {
    return 1;
  }
  return 0;
}

function last_line_of(es: ast.Expr[], spans: parser.BlockSpans): i32 {
  let m = 0;
  for x in es {
    m = max_line(m, last_line(x, spans));
  }
  return m;
}

function max_line(a: i32, b: i32): i32 {
  if (a > b) {
    return a;
  }
  return b;
}

function keep_list_lines(f: Fmt, open: i32, last: i32): boolean {
  return open > 0 && last > open || inner_comment_pending(f, open, last);
}

function inner_comment_pending(f: Fmt, decl_line: i32, last: i32): boolean {
  for i in f.ci..f.comments.len() {
    let ln = f.comments[i].line;
    if (ln > last) {
      return false;
    }
    if (ln > decl_line) {
      return true;
    }
  }
  return false;
}

function field_lines_for(flines: parser.FieldLines[], name: string, decl_line: i32): i32[] {
  for i in 0..flines.len() {
    if (flines[i].name == name && flines[i].decl_line == decl_line) {
      return flines[i].lines;
    }
  }
  let none: i32[] = [];
  return none;
}

function drain_all(f: Fmt, depth: i32, wrote: boolean): (string, Fmt) {
  let out = "";
  let g = f;
  let last = 0;
  while (g.ci < g.comments.len()) {
    if (g.blank_at(g.comments[g.ci].line - 1) && (last > 0 || wrote)) {
      out += "\n";
    }
    last = g.comments[g.ci].line;
    out = out + indent_str(depth) + "//" + g.comments[g.ci].text + "\n";
    g = Fmt { ...g, ci: g.ci + 1 };
  }
  return (out, g);
}

function nested_block_owns_trailing(st: ast.Stmt, line: i32, f: Fmt): boolean {
  if let ast.StmtIf(block) = st {
    if ((block.origin == "block" || block.origin == "unsafe") && block.then_body.len() > 0
      && block.line == line && f.si < f.spans.opens.len()) {
      return f.spans.opens[f.si] == line && f.spans.closes[f.si] > line;
    }
  }
  return false;
}

function print_block(body: ast.Stmt[], depth: i32, f: Fmt): (string, Fmt) {
  if (body.len() == 0) {
    return print_empty_block(depth, f);
  }
  let (open_line, close_line, g) = take_span(f, ast.stmt_line(body[0]));
  let span = -1;
  if (open_line > 0) {
    span = g.si - 1;
  }
  let out = "{";
  if (open_line > 0 && !nested_block_owns_trailing(body[0], open_line, g)) {
    let (tc, gt) = emit_trailing(g, open_line);
    out += tc;
    g = gt;
  }
  out += "\n";
  for i in 0..body.len() {
    let ln = ast.stmt_line(body[i]);
    if (i > 0 && ln > 0 && g.blank_before(ln)) {
      out += "\n";
    }
    if (ln > 0) {
      let (lead, g1) = drain_leading(g, ln, depth + 1);
      out += lead;
      g = g1;
    }
    let (body_text, g2) = print_stmt(body[i], depth + 1, g);
    out += body_text;
    g = g2;
  }
  if (close_line > 0) {
    let (tail, gc) = drain_leading(g, close_line, depth + 1);
    out += tail;
    g = gc;
  }
  out = out + indent_str(depth) + "}";
  return (out, Fmt { ...g, own: span });
}

// An empty block takes the first span that opens on or after the line of its
// statement, when no token is between the braces of that span.
function print_empty_block(depth: i32, f: Fmt): (string, Fmt) {
  for i in f.si..f.spans.opens.len() {
    if (f.spans.opens[i] >= f.at) {
      if (f.spans.firsts[i] != f.spans.closes[i]) {
        return ("{}", Fmt { ...f, own: -1 });
      }
      return print_span_block(i, depth, Fmt { ...f, si: i + 1 });
    }
  }
  return ("{}", Fmt { ...f, own: -1 });
}

// An empty block keeps the comments between its braces.
function print_span_block(i: i32, depth: i32, f: Fmt): (string, Fmt) {
  let open = f.spans.opens[i];
  let close = f.spans.closes[i];
  let g = Fmt { ...f, own: i };
  if (close <= open || g.ci >= g.comments.len() || g.comments[g.ci].line >= close) {
    return ("{}", g);
  }
  let (tc, g1) = emit_trailing(g, open);
  let (tail, g2) = drain_leading(g1, close, depth + 1);
  return ("{" + tc + "\n" + tail + indent_str(depth) + "}", g2);
}

// The span of an empty `else` block after the block f.own, or -1.
function else_span(f: Fmt): Option[i32] {
  if (f.own < 0) {
    return None;
  }
  let end = f.spans.closes[f.own];
  let from = f.own + 1;
  for i in from..f.spans.opens.len() {
    if (f.spans.else_of[i] == f.own) {
      return Some(i);
    }
    if (f.spans.opens[i] > end) {
      return None;
    }
  }
  return None;
}

function anchored(f: Fmt, line: i32): Fmt {
  if (line > 0) {
    return Fmt { ...f, at: line };
  }
  return f;
}

function print_pattern(pat: ast.Pattern): string {
  return print_pattern_ctx(pat, false);
}

function print_pattern_ctx(pat: ast.Pattern, always_parens: boolean): string {
  match (pat) {
    ast.PatLiteral(literal) => {
      let out = print_lit(literal.lit);
      if (literal.has_range) {
        let dots = "..";
        if (literal.range_inclusive) {
          dots = "..=";
        }
        out = out + dots + print_lit(literal.range_hi);
      }
      if (literal.at_binding.len() > 0) {
        out = literal.at_binding + " @ " + out;
      }
      return out;
    },
    ast.PatWildcard(_) => {
      return "_";
    },
    ast.PatVariant(pv) => {
      let head = pv.type_name;
      if (pv.at_binding.len() > 0) {
        head = pv.at_binding + " @ " + pv.type_name;
      }
      if (parser.is_record_pattern(pv)) {
        return head + " " + print_record_fields(pv);
      }
      if (pv.nested.len() > 0) {
        let np = head + "(";
        for ni in 0..pv.nested.len() {
          if (ni > 0) {
            np += ", ";
          }
          if (pv_pattern_name(pv.nested[ni]).len() > 0) {
            np += print_pattern_ctx(pv.nested[ni], true);
          } else {
            np += payload_slot(pv, parser.payload_binder(pv, ni));
          }
        }
        return np + ")";
      }
      if (pv.tup_kinds.len() > 0) {
        return head + "(" + print_tuple_elems(pv.tup_kinds, pv.tup_binds, pv.tup_lits, pv.tup_pats) + ")";
      }
      if (pv.binding.len() == 0) {
        if (always_parens && !pv.type_name.contains(".")) {
          return head + "()";
        }
        return head;
      }
      let out = head + "(" + payload_slot(pv, pv.binding);
      for i in 0..pv.extra_bindings.len() {
        out = out + ", " + payload_slot(pv, pv.extra_bindings[i]);
      }
      return out + ")";
    }
  }
}

function pv_pattern_name(pat: ast.Pattern): string {
  match (pat) {
    ast.PatLiteral(_) => {
      return "";
    },
    ast.PatVariant(v) => {
      return v.type_name;
    },
    ast.PatWildcard(_) => {
      return "";
    }
  }
}

function range_pair(lo: ast.Expr, hi: ast.Expr, binder: string): string {
  match (lo) {
    ast.ExprBinary(lb) => {
      if (lb.op != ">=") {
        return "";
      }
      match (lb.left) {
        ast.ExprIdent(li) => {
          if (li.name != binder) {
            return "";
          }
        },
        _ => {
          return "";
        }
      }
      match (hi) {
        ast.ExprBinary(hb) => {
          if (hb.op != "<" && hb.op != "<=") {
            return "";
          }
          match (hb.left) {
            ast.ExprIdent(hri) => {
              if (hri.name != binder) {
                return "";
              }
            },
            _ => {
              return "";
            }
          }
          let sep = "..";
          if (hb.op == "<=") {
            sep = "..=";
          }
          return print_lit(lb.right) + sep + print_lit(hb.right);
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
}

function range_slot_for(cond: ast.Expr, binder: string): string {
  match (cond) {
    ast.ExprBinary(b) => {
      if (b.op != "&&") {
        return "";
      }
      let here = range_pair(b.left, b.right, binder);
      if (here.len() > 0) {
        return here;
      }
      let l = range_slot_for(b.left, binder);
      if (l.len() > 0) {
        return l;
      }
      return range_slot_for(b.right, binder);
    },
    _ => {
      return "";
    }
  }
}

function payload_slot(pv: ast.PatVariant, binder: string): string {
  if (!pv.has_lit_cond) {
    return binder;
  }
  let rng = range_slot_for(pv.lit_cond, binder);
  if (rng.len() > 0) {
    return rng;
  }
  let lit = lit_cond_for(pv.lit_cond, binder);
  if (expr_is_missing(lit)) {
    return binder;
  }
  return print_lit(lit);
}

function lit_cond_for(cond: ast.Expr, binder: string): ast.Expr {
  match (cond) {
    ast.ExprBinary(b) => {
      if (b.op == "&&") {
        let left = lit_cond_for(b.left, binder);
        if (!expr_is_missing(left)) {
          return left;
        }
        return lit_cond_for(b.right, binder);
      }
      if (b.op == "==") {
        match (b.left) {
          ast.ExprIdent(id) => {
            if (id.name == binder) {
              return b.right;
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  return parser.e_unknown("");
}

function print_tuple_elem(kind: i32, bind: string, lit: ast.Expr, pat: ast.Pattern): string {
  if (kind == 1) {
    return "_";
  }
  if (kind == 2) {
    return print_lit(lit);
  }
  if (kind == 3) {
    return print_pattern_ctx(pat, true);
  }
  if (kind == 4) {
    let (nk, nb, nl, np) = parser.pv_tup(pat);
    return print_tuple_elems(nk, nb, nl, np);
  }
  return bind;
}

function print_tuple_elems(kinds: i32[], binds: string[], lits: ast.Expr[], pats: ast.Pattern[]): string {
  let out = "(";
  for i in 0..kinds.len() {
    if (i > 0) {
      out += ", ";
    }
    out += print_tuple_elem(kinds[i], binds[i], lits[i], pats[i]);
  }
  return out + ")";
}

function print_tup_arm(a: ast.TupArm): string {
  if (a.is_wild) {
    if (a.at_binding.len() > 0) {
      return a.at_binding + " @ _";
    }
    return "_";
  }
  let pat = print_tuple_elems(a.elem_kinds, a.binds, a.lits, a.elem_pats);
  if (a.at_binding.len() > 0) {
    return a.at_binding + " @ " + pat;
  }
  return pat;
}

function print_record_fields(pv: ast.PatVariant): string {
  let out = "{ ";
  for i in 0..pv.field_names.len() {
    if (i > 0) {
      out += ", ";
    }
    let field = pv.field_names[i];
    let slot = payload_slot(pv, parser.payload_binder(pv, i));
    if (i < pv.nested.len() && pv_pattern_name(pv.nested[i]).len() > 0) {
      slot = print_pattern_ctx(pv.nested[i], true);
    }
    out += field;
    if (slot != field) {
      out = out + ": " + slot;
    }
  }
  return out + rest_suffix(pv.rest_written, pv.field_names.len()) + " }";
}

function rest_suffix(rest_written: boolean, n: i32): string {
  if (!rest_written) {
    return "";
  }
  if (n > 0) {
    return ", ..";
  }
  return "..";
}

function print_struct_arm(a: ast.StructArm): string {
  if (a.is_wild) {
    if (a.at_binding.len() > 0) {
      return a.at_binding + " @ _";
    }
    return "_";
  }
  let out = a.type_name + " { ";
  for i in 0..a.fields.len() {
    if (i > 0) {
      out += ", ";
    }
    out += a.fields[i];
    if (a.field_kinds[i] == 2) {
      out = out + ": " + print_lit(a.field_lits[i]);
    } else if (a.field_kinds[i] == 3) {
      out = out + ": " + print_pattern_ctx(a.field_pats[i], true);
    } else if (a.binds[i] != a.fields[i]) {
      out = out + ": " + a.binds[i];
    }
  }
  out += rest_suffix(a.rest_written, a.fields.len());
  out += " }";
  if (a.at_binding.len() > 0) {
    return a.at_binding + " @ " + out;
  }
  return out;
}

struct WrittenArm { head: string, body: ast.Stmt[], guard: ast.Expr, has_guard: boolean, line: i32 }

function sugar_written_arms(sg: ast.MatchSugar): WrittenArm[] {
  let out: WrittenArm[] = [];
  let i = 0;
  if (sg.arms.len() > 0) {
    while (i < sg.arms.len()) {
      let a = sg.arms[i];
      let ahead = print_pattern(a.pattern);
      while (i + 1 < sg.arms.len() && sg.arms[i + 1].alt_cont) {
        i += 1;
        ahead = ahead + " | " + print_pattern(sg.arms[i].pattern);
      }
      out = out.append(WrittenArm { head: ahead, body: a.body, guard: a.guard, has_guard: a.has_guard, line: a.line });
      i += 1;
    }
    return out;
  }
  let n = sg.tup.len() + sg.strct.len() + sg.lits.len();
  while (i < n) {
    let head = "";
    let body: ast.Stmt[] = [];
    let guard = parser.e_bool(true);
    let has_guard = false;
    let line = 0;
    if (sg.tup.len() > 0) {
      head = print_tup_arm(sg.tup[i]);
      body = sg.tup[i].body;
      line = sg.tup[i].line;
      guard = sg.tup[i].guard;
      has_guard = sg.tup[i].has_guard;
      while (i + 1 < n && sg.tup[i + 1].alt_cont) {
        i += 1;
        head = head + " | " + print_tup_arm(sg.tup[i]);
      }
    } else {
      if (sg.strct.len() > 0) {
        head = print_struct_arm(sg.strct[i]);
        body = sg.strct[i].body;
        line = sg.strct[i].line;
        guard = sg.strct[i].guard;
        has_guard = sg.strct[i].has_guard;
      } else {
        head = print_lit_pat(sg.lits[i]);
        body = sg.lits[i].body;
        line = sg.lits[i].line;
        guard = sg.lits[i].guard;
        has_guard = sg.lits[i].has_guard;
        while (i + 1 < n && sg.lits[i + 1].alt_cont) {
          i += 1;
          head = head + " | " + print_lit_pat(sg.lits[i]);
        }
      }
    }
    out = out.append(WrittenArm { head: head, body: body, guard: guard, has_guard: has_guard, line: line });
    i += 1;
  }
  return out;
}

function print_sugared_match(sg: ast.MatchSugar, depth: i32, f: Fmt): (string, Fmt) {
  let pad = indent_str(depth);
  let arms = sugar_written_arms(sg);
  let out = "match (" + print_expr(sg.scrut, depth) + ") {\n";
  let g = f;
  for i in 0..arms.len() {
    let (arm_body, g1) = print_block(arms[i].body, depth + 1, g);
    g = g1;
    out = out + indent_str(depth + 1) + arms[i].head;
    if (arms[i].has_guard) {
      out = out + " when " + print_expr(arms[i].guard, depth);
    }
    out = out + " => " + arm_body;
    if (i + 1 < arms.len()) {
      out += ",";
    }
    out += "\n";
  }
  return (out + pad + "}", g);
}

function print_sugared_let_else(sg: ast.MatchSugar, depth: i32, f: Fmt): (string, Fmt) {
  let arms = sugar_written_arms(sg);
  if (arms.len() < 2) {
    return print_sugared_match(sg, depth, f);
  }
  let g = f;
  let (els, g1) = print_block(arms[arms.len() - 1].body, depth, g);
  g = g1;
  let head = "";
  let hi = 0;
  while (hi + 1 < arms.len()) {
    if (hi > 0) {
      head += " | ";
    }
    head += arms[hi].head;
    hi += 1;
  }
  let out = "let " + head + " = " + print_expr(sg.scrut, depth) + " else " + els + ";";
  let rest = arms[0].body;
  for i in 0..rest.len() {
    let ln = ast.stmt_line(rest[i]);
    out += "\n";
    if (ln > 0 && g.blank_before(ln)) {
      out += "\n";
    }
    if (ln > 0) {
      let (lead, gl) = drain_leading(g, ln, depth);
      out += lead;
      g = gl;
    }
    let (stext, g2) = print_stmt_line(rest[i], depth, g);
    out += stext;
    g = g2;
  }
  return (out, g);
}

function print_sugared_if_let(sg: ast.MatchSugar, depth: i32, f: Fmt): (string, Fmt) {
  let arms = sugar_written_arms(sg);
  if (arms.len() < 2) {
    return print_sugared_match(sg, depth, f);
  }
  let g = f;
  let (then_block, g1) = print_block(arms[0].body, depth, g);
  g = g1;
  let out = "if let ";
  let i = 0;
  while (i + 1 < arms.len()) {
    if (i > 0) {
      out += " | ";
    }
    out += arms[i].head;
    i += 1;
  }
  out = out + " = " + print_header_expr(sg.scrut, depth) + " " + then_block;
  let (else_text, g2) = print_else(arms[arms.len() - 1].body, sg.else_chained, depth, g);
  return (out + else_text, g2);
}

function print_lit_pat(a: ast.LitArm): string {
  if (a.is_wild) {
    if (a.at_binding.len() > 0) {
      return a.at_binding;
    }
    return "_";
  }
  if (a.at_binding.len() > 0 && !a.alt_cont) {
    return a.at_binding + " @ " + print_lit_pat(ast.LitArm { ...a, at_binding: "" });
  }
  if (a.has_range) {
    let dots = "..";
    if (a.range_inclusive) {
      dots = "..=";
    }
    return print_lit(a.lit) + dots + print_lit(a.range_hi);
  }
  return print_lit(a.lit);
}

function print_match(m: ast.StmtMatch, depth: i32, f: Fmt): (string, Fmt) {
  let pad = indent_str(depth);
  let out = "match (" + print_expr(m.scrutinee, depth) + ") {\n";
  let g = f;
  let arms = m.arms;
  if (m.sugar.len() > 0) {
    arms = m.sugar;
  }
  let i = 0;
  while (i < arms.len()) {
    let (arm_body, g1) = print_block(arms[i].body, depth + 1, anchored(g, arms[i].line));
    g = g1;
    let head = print_pattern(arms[i].pattern);
    let guarded = arms[i];
    while (i + 1 < arms.len() && arms[i + 1].alt_cont) {
      i += 1;
      head = head + " | " + print_pattern(arms[i].pattern);
    }
    out = out + indent_str(depth + 1) + head;
    if (guarded.has_guard) {
      out = out + " when " + print_expr(guarded.guard, depth);
    }
    out = out + " => " + arm_body;
    if (i + 1 < arms.len()) {
      out += ",";
    }
    out += "\n";
    i += 1;
  }
  return (out + pad + "}", g);
}

function print_if_let(m: ast.StmtMatch, depth: i32, f: Fmt): (string, Fmt) {
  let arms = m.arms;
  if (m.sugar.len() > 0) {
    arms = m.sugar;
  }
  let g = f;
  let (then_block, g1) = print_block(arms[0].body, depth, g);
  g = g1;
  let out = "if let ";
  let i = 0;
  while (i + 1 < arms.len()) {
    if (i > 0) {
      out += " | ";
    }
    out += print_pattern(arms[i].pattern);
    i += 1;
  }
  out = out + " = " + print_header_expr(m.scrutinee, depth) + " " + then_block;
  let (else_text, g2) = print_else(arms[arms.len() - 1].body, m.else_chained, depth, g);
  return (out + else_text, g2);
}

function print_let_else(m: ast.StmtMatch, depth: i32, f: Fmt): (string, Fmt) {
  let arms = m.arms;
  if (m.sugar.len() > 0) {
    arms = m.sugar;
  }
  let g = f;
  let (els, g1) = print_block(arms[arms.len() - 1].body, depth, g);
  g = g1;
  let head = "";
  let hi = 0;
  while (hi + 1 < arms.len()) {
    if (hi > 0) {
      head += " | ";
    }
    head += print_pattern(arms[hi].pattern);
    hi += 1;
  }
  let out = "let " + head + " = " + print_expr(m.scrutinee, depth) + " else " + els + ";";
  let rest = arms[0].body;
  for i in 0..rest.len() {
    let ln = ast.stmt_line(rest[i]);
    out += "\n";
    if (ln > 0 && g.blank_before(ln)) {
      out += "\n";
    }
    if (ln > 0) {
      let (lead, gl) = drain_leading(g, ln, depth);
      out += lead;
      g = gl;
    }
    let (stext, g2) = print_stmt_line(rest[i], depth, g);
    out += stext;
    g = g2;
  }
  return (out, g);
}

struct UseSugar { name: string, type_name: string, call: ast.Expr, body: ast.Stmt[] }

function as_use(e: ast.Expr): Option[UseSugar] {
  if let ast.ExprCall(c) = e {
    if (c.args.len() == 0) {
      return None;
    }
    if let ast.ExprLambda(lm) = c.args[c.args.len() - 1] {
      if (lm.origin != parser.ORIGIN_USE || lm.params.len() != 1) {
        return None;
      }
      let written: ast.Expr[] = [];
      let i = 0;
      while (i + 1 < c.args.len()) {
        written = written.append(c.args[i]);
        i += 1;
      }
      let call: ast.Expr = ast.ExprCall { ...c, args: written };
      return Some(UseSugar { name: lm.params[0].name, type_name: lm.params[0].type_name, call: call, body: lm.body });
    }
  }
  return None;
}

function print_use(us: UseSugar, line: i32, depth: i32, f: Fmt): (string, Fmt) {
  let out = "use " + written_name(us.name);
  if (us.type_name.len() > 0) {
    out = out + ": " + us.type_name;
  }
  out = out + " <- " + print_expr(us.call, depth) + ";";
  let g = f;
  if (line > 0) {
    let (tr, g0) = emit_trailing(g, line);
    out += tr;
    g = g0;
  }
  for i in 0..us.body.len() {
    let ln = ast.stmt_line(us.body[i]);
    out += "\n";
    if (ln > 0 && g.blank_before(ln)) {
      out += "\n";
    }
    if (ln > 0) {
      let (lead, gl) = drain_leading(g, ln, depth);
      out += lead;
      g = gl;
    }
    let (stext, g2) = print_stmt_line(us.body[i], depth, g);
    out += stext;
    g = g2;
  }
  return (out, g);
}

function expr_is_missing(e: ast.Expr): boolean {
  match (e) {
    ast.ExprUnknown(u) => {
      return u.kind.len() == 0 || u.kind == parser.BARE_RETURN || u.kind.starts_with("punct:");
    },
    _ => {
      return false;
    }
  }
}

function stmt_is_single_line(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtReturn(r) => {
      return match (as_use(r.value)) { Some(_) => false, None => true };
    },
    ast.StmtVar(_) => {
      return true;
    },
    ast.StmtExpr(_) => {
      return true;
    },
    ast.StmtAssign(_) => {
      return true;
    },
    ast.StmtBreak(_) => {
      return true;
    },
    ast.StmtContinue(_) => {
      return true;
    },
    ast.StmtDefer(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function print_assert(ifs: ast.StmtIf, depth: i32, f: Fmt): (string, Fmt) {
  let cond = ifs.cond;
  if let ast.ExprUnary(u) = ifs.cond {
    cond = u.operand;
  }
  let (cs, cf) = print_expr_c(cond, prec_lowest(), depth, f);
  let out = "assert(" + cs;
  let g = cf;
  if (ifs.then_body.len() > 0) {
    if let ast.StmtExpr(se) = ifs.then_body[0] {
      if let ast.ExprCall(c) = se.value {
        if (c.args.len() > 0) {
          if let ast.ExprBinary(b) = c.args[0] {
            let (ms, mf) = print_expr_c(b.right, prec_lowest(), depth, g);
            out = out + ", " + ms;
            g = mf;
          }
        }
      }
    }
  }
  return (out + ");", g);
}

function print_todo(body: ast.Stmt[], depth: i32, f: Fmt): (string, Fmt) {
  if (body.len() > 0) {
    if let ast.StmtExpr(se) = body[0] {
      if let ast.ExprCall(c) = se.value {
        if (c.args.len() > 0) {
          if let ast.ExprBinary(b) = c.args[0] {
            let (ms, mf) = print_expr_c(b.right, prec_lowest(), depth, f);
            return ("todo(" + ms + ");", mf);
          }
        }
      }
    }
  }
  return ("todo;", f);
}

function print_chain_assign(stmts: ast.Stmt[], depth: i32): Option[string] {
  if (stmts.len() == 0) {
    return None;
  }
  let first: AssignParts = match (assign_parts(stmts[0])) { Some(parts) => parts, None => { return None; } };
  let out = "";
  let i = stmts.len() - 1;
  while (i > 0) {
    match (assign_parts(stmts[i])) {
      Some(parts) => {
        out = out + print_expr(parts.place, depth) + " = ";
      },
      None => {
        return None;
      }
    }
    i -= 1;
  }
  return Some(out + print_expr(first.place, depth) + " = " + print_expr(first.value, depth) + ";");
}

struct AssignParts { place: ast.Expr, value: ast.Expr, op: string }

function ident_assign(a: ast.StmtAssign): AssignParts {
  return AssignParts { place: ast.ExprIdent { name: a.target, line: 0, col: 0, ty: "", builtin: false }, value: a.value, op: a.op };
}

function print_assign(set: AssignParts, depth: i32, f: Fmt): (string, Fmt) {
  let (pv, pf) = print_expr_c(set.place, prec_lowest(), depth, f);
  if let ast.ExprBinary(b) = set.value {
    if (set.op.len() > 0 && b.op == set.op) {
      let (rv, rf) = print_expr_c(b.right, prec_lowest(), depth, pf);
      return (f"{pv} {set.op}= {rv};", rf);
    }
  }
  let (sv, sf) = print_expr_c(set.value, prec_lowest(), depth, pf);
  return (f"{pv} = {sv};", sf);
}

function assign_parts(st: ast.Stmt): Option[AssignParts] {
  match (st) {
    ast.StmtAssign(a) => {
      return Some(ident_assign(a));
    },
    ast.StmtExpr(x) => {
      if let ast.ExprCall(c) = x.value {
        if let ast.ExprIdent(callee) = c.callee {
          if (c.args.len() == 2 && (callee.name == "__set_index" || callee.name == "__set_field")) {
            return Some(AssignParts { place: c.args[0], value: c.args[1], op: x.op });
          }
        }
      }
      return None;
    },
    _ => {
      return None;
    }
  }
}

function is_block_stmt(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtIf(ifs) => {
      return ifs.origin == "block";
    },
    _ => {
      return false;
    }
  }
}

function block_stmts(st: ast.Stmt): ast.Stmt[] {
  let none: ast.Stmt[] = [];
  match (st) {
    ast.StmtIf(ifs) => {
      return ifs.then_body;
    },
    _ => {
      return none;
    }
  }
}

function print_stmt_inline(st: ast.Stmt, depth: i32): string {
  let (text, _) = print_stmt_body(st, 0, empty_fmt());
  return text;
}

pub struct ForCSugar { init: ast.Stmt[], cond: ast.Expr, step: ast.Stmt[], body: ast.Stmt[], label: string }

pub function as_c_for(ifs: ast.StmtIf): Option[ForCSugar] {
  if (!ast.is_true_literal(ifs.cond) || ifs.else_body.len() != 0) {
    return None;
  }
  let outer = ifs.then_body;
  if (outer.len() < 2) {
    return None;
  }
  let flag = "";
  match (outer[outer.len() - 2]) {
    ast.StmtVar(v) => {
      if (is_forc_name(v.name) && ast.is_true_literal(v.init)) {
        flag = v.name;
      }
    },
    _ => {}
  }
  if (flag.len() == 0) {
    return None;
  }
  let wbody: ast.Stmt[] = [];
  let label = "";
  let have_while = false;
  match (outer[outer.len() - 1]) {
    ast.StmtWhile(w) => {
      if (ast.is_true_literal(w.cond)) {
        wbody = w.body;
        label = w.label;
        have_while = true;
      }
    },
    _ => {}
  }
  if (!have_while || wbody.len() < 3) {
    return None;
  }

  let step: ast.Stmt[] = [];
  let step_ok = false;
  match (wbody[0]) {
    ast.StmtIf(s) => {
      if (is_not_of_ident(s.cond, flag) && s.else_body.len() == 0) {
        step = s.then_body;
        step_ok = true;
      }
    },
    _ => {}
  }
  if (!step_ok) {
    return None;
  }

  let assign_ok = false;
  match (wbody[1]) {
    ast.StmtAssign(a) => {
      if (a.target == flag && expr_is_false(a.value)) {
        assign_ok = true;
      }
    },
    _ => {}
  }
  if (!assign_ok) {
    return None;
  }

  let cond: ast.Expr = ast.ExprBool { value: true, line: 0, col: 0 };
  let cond_ok = false;
  match (wbody[2]) {
    ast.StmtIf(c) => {
      if (c.else_body.len() == 0 && c.then_body.len() == 1) {
        match (c.then_body[0]) {
          ast.StmtBreak(b) => {
            if (b.label.len() == 0) {
              match (c.cond) {
                ast.ExprUnary(u) => {
                  if (u.op == "!") {
                    cond = u.operand;
                    cond_ok = true;
                  }
                },
                _ => {}
              }
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  if (!cond_ok) {
    return None;
  }

  let init: ast.Stmt[] = [];
  let ii = 0;
  while (ii + 2 < outer.len()) {
    init = init.append(outer[ii]);
    ii += 1;
  }
  let body: ast.Stmt[] = [];
  for bi in 3..wbody.len() {
    body = body.append(wbody[bi]);
  }
  return Some(ForCSugar { init: init, cond: cond, step: step, body: body, label: label });
}

function is_forc_name(name: string): boolean {
  return name.len() > 7 && name.starts_with("__forc_");
}

function expr_is_false(e: ast.Expr): boolean {
  match (e) {
    ast.ExprBool(b) => {
      return !b.value;
    },
    _ => {
      return false;
    }
  }
}

function is_not_of_ident(e: ast.Expr, name: string): boolean {
  match (e) {
    ast.ExprUnary(u) => {
      if (u.op != "!") {
        return false;
      }
      match (u.operand) {
        ast.ExprIdent(id) => {
          return id.name == name;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

function print_c_for(fc: ForCSugar, depth: i32, f: Fmt): (string, Fmt) {
  let init = "";
  if (fc.init.len() == 1) {
    init = strip_semi(print_stmt_inline(fc.init[0], depth));
  }
  let step = "";
  if (fc.step.len() == 1) {
    step = strip_semi(print_stmt_inline(fc.step[0], depth));
  }
  let (body, g) = print_block(fc.body, depth, f);
  return (loop_label(fc.label) + "for (" + init + "; " + print_expr(fc.cond, depth) + "; " + step + ") " + body, g);
}

function strip_semi(s: string): string {
  if (s.len() > 0 && s[s.len() - 1] == b';') {
    return slice_unchecked(s, 0, s.len() - 1).to_owned();
  }
  return s;
}

function print_if_chain(ifs: ast.StmtIf, depth: i32, f: Fmt): (string, Fmt) {
  let (cond_text, cf) = print_expr_c(ifs.cond, prec_lowest(), depth, f);
  let (then_text, g) = print_block(ifs.then_body, depth, cf);
  let (else_text, g2) = print_else(ifs.else_body, ifs.else_chained, depth, g);
  return ("if (" + cond_text + ") " + then_text + else_text, g2);
}

function print_else(els: ast.Stmt[], chained: boolean, depth: i32, f: Fmt): (string, Fmt) {
  if (els.len() == 0) {
    let Some(at) = else_span(f) else {
      return ("", f);
    };
    let (empty_text, ge) = print_span_block(at, depth, Fmt { ...f, si: at + 1 });
    return (" else " + empty_text, ge);
  }
  if (chained && els.len() == 1) {
    let (nested_text, g) = print_stmt_body(els[0], depth, anchored(f, ast.stmt_line(els[0])));
    return (" else " + nested_text, g);
  }
  let (block_text, g2) = print_block(els, depth, f);
  return (" else " + block_text, g2);
}

function loop_label(label: string): string {
  if (label.len() == 0) {
    return "";
  }
  return label + ": ";
}

function for_binder(var_name: string): string {
  if (!util.contains(var_name, ",")) {
    return var_name;
  }
  return "(" + join_csv(var_name) + ")";
}

function drop_first_stmt(stmts: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for i in 1..stmts.len() {
    out = out.append(stmts[i]);
  }
  return out;
}

function print_for_iter(e: ast.Expr, depth: i32): string {
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() == 2) {
        match (c.callee) {
          ast.ExprIdent(id) => {
            if (id.name == "__range") {
              return print_header_expr(c.args[0], depth) + ".." + print_header_expr(c.args[1], depth);
            }
            if (id.name == "__range_incl") {
              return print_header_expr(c.args[0], depth) + "..=" + print_header_expr(c.args[1], depth);
            }
          },
          _ => {}
        }
        // A range value keeps its parentheses: without them the header is
        // the counted loop, a different program.
        if (range_desugar_op(c).len() > 0) {
          return "(" + print_header_expr(e, depth) + ")";
        }
      }
    },
    _ => {}
  }
  return print_header_expr(e, depth);
}

function print_stmt(st: ast.Stmt, depth: i32, f: Fmt): (string, Fmt) {
  let (text, g) = print_stmt_line(st, depth, f);
  return (text + "\n", g);
}

function print_stmt_line(st: ast.Stmt, depth: i32, f: Fmt): (string, Fmt) {
  let (text, g) = print_stmt_body(st, depth, anchored(f, ast.stmt_line(st)));
  let out = indent_str(depth) + text;
  if (stmt_is_single_line(st)) {
    let ln = ast.stmt_line(st);
    if (ln > 0) {
      let (tr, g2) = emit_trailing(g, ln);
      let (tr2, g3) = emit_trailing(g2, stmt_last_line(st, ln, g2.spans));
      return (out + tr + tr2, g3);
    }
  }
  return (out, g);
}

function stmt_last_line(st: ast.Stmt, ln: i32, spans: parser.BlockSpans): i32 {
  match (st) {
    ast.StmtReturn(r) => {
      return max_line(ln, last_line(r.value, spans));
    },
    ast.StmtVar(v) => {
      return max_line(ln, last_line(v.init, spans));
    },
    ast.StmtExpr(x) => {
      return max_line(ln, last_line(x.value, spans));
    },
    ast.StmtAssign(a) => {
      return max_line(ln, last_line(a.value, spans));
    },
    _ => {
      return ln;
    }
  }
}

function split_commas(csv: string): string[] {
  let out: string[] = [];
  let start = 0;
  for i in 0..=csv.len() {
    if (i == csv.len() || csv[i] == b',') {
      out = out.append(slice_unchecked(csv, start, i).to_owned());
      start = i + 1;
    }
  }
  return out;
}

function written_name(name: string): string {
  if (name.starts_with("__discard_")) {
    return "_";
  }
  return name;
}

function written_part(part: string): string {
  let lead = 0;
  while (lead < part.len() && part[lead] == b'(') {
    lead += 1;
  }
  let trail = part.len();
  while (trail > lead && part[trail - 1] == b')') {
    trail -= 1;
  }
  return slice_unchecked(part, 0, lead) + written_name(slice_unchecked(part, lead, trail).to_owned()) + slice_unchecked(part, trail, part.len());
}

function join_csv(csv: string): string {
  let parts = split_commas(csv);
  let out = "";
  for i in 0..parts.len() {
    if (i > 0) {
      out += ", ";
    }
    out += written_part(parts[i]);
  }
  return out;
}

function destr_at_prefix(type_name: string): string {
  let at = parser.destr_marker_split(type_name).at;
  if (at.len() == 0) {
    return "";
  }
  return at + " @ ";
}

function print_struct_destructure(v: ast.StmtVar, depth: i32): string {
  return "let " + destr_at_prefix(v.type_name) + struct_destr_pattern(v) + " = " + print_expr(v.init, depth) + ";";
}

function struct_destr_pattern(v: ast.StmtVar): string {
  let sd_marker = parser.destr_marker_split(v.type_name).tag;
  let rest = slice_unchecked(sd_marker, 4, sd_marker.len());
  let colon: i32 = -1;
  for ri in 0..rest.len() {
    if (rest[ri] == b':' && colon < 0) {
      colon = ri;
    }
  }
  if (colon < 0) {
    return "";
  }
  let struct_name = slice_unchecked(rest, 0, colon);
  let fields = split_commas(slice_unchecked(rest, colon + 1, rest.len()));
  let binds = split_commas(v.name);
  let out = struct_name + " { ";
  for i in 0..fields.len() {
    if (i > 0) {
      out += ", ";
    }
    out += fields[i];
    if (i < binds.len() && binds[i] != fields[i]) {
      out = out + ": " + written_name(binds[i]);
    }
  }
  out += rest_suffix(parser.destr_marker_split(v.type_name).rest_written, fields.len());
  return out + " }";
}

function param_pattern_from(st: ast.Stmt, holder: string): string {
  match (st) {
    ast.StmtVar(v) => {
      if (!parser.is_param_prelude_marker(v.type_name)) {
        return "";
      }
      let from_holder = false;
      match (v.init) {
        ast.ExprIdent(id) => {
          if (id.name == holder) {
            from_holder = true;
          }
        },
        _ => {}
      }
      if (!from_holder) {
        return "";
      }
      let at = "";
      if (!holder.starts_with("__ptuple_")) {
        at = holder + " @ ";
      }
      if (parser.is_struct_destr_marker(v.type_name)) {
        return at + struct_destr_pattern(v);
      }
      if (util.contains(v.name, ",")) {
        return at + "(" + join_csv(v.name) + ")";
      }
      return "";
    },
    _ => {}
  }
  return "";
}

function param_patterns_for(params: ast.ParamDecl[], body: ast.Stmt[]): (string[], i32) {
  let pats: string[] = [];
  for pi in 0..params.len() {
    pats = pats.append("");
  }

  let n = 0;
  while (n < body.len()) {
    let matched = false;
    let k = 0;
    while (k < params.len()) {
      if (pats[k].len() == 0) {
        let pat = param_pattern_from(body[n], params[k].name);
        if (pat.len() > 0) {
          pats = pats.with(k, pat);
          matched = true;
          k = params.len();
        }
      }
      k += 1;
    }
    if (!matched) {
      n = body.len();
    } else {
      n += 1;
    }
  }
  let found = 0;
  for j in 0..pats.len() {
    if (pats[j].len() > 0) {
      found += 1;
    }
  }
  return (pats, found);
}

function print_nested_func_decl(v: ast.StmtVar, depth: i32, f: Fmt): (string, Fmt) {
  match (v.init) {
    ast.ExprLambda(lm) => {
      let out = "function " + v.name + print_lambda_params(lm, depth);
      if (lm.ret_type.len() > 0) {
        out += ": ";
        if (lm.ret_own) {
          out += "own ";
        }
        out += lm.ret_type;
      }
      let (body, g) = print_block(lm.body, depth, anchored(f, lm.line));
      return (out + " " + body, g);
    },
    _ => {}
  }
  let (vi, vf) = print_expr_c(v.init, prec_lowest(), depth, f);
  return ("let " + v.name + " = " + vi + ";", vf);
}

function print_stmt_body(st: ast.Stmt, depth: i32, f: Fmt): (string, Fmt) {
  match (st) {
    ast.StmtDefer(d) => {
      if (is_block_stmt(d.action)) {
        let blk = block_stmts(d.action);
        let head = if (d.on_error != 0) { "errdefer " } else { "defer " };
        let inl = "{ ";
        for bi in 0..blk.len() {
          inl = inl + print_stmt_inline(blk[bi], 0) + " ";
        }
        if (!util.contains(inl, "\n")) {
          return (head + inl + "}", f);
        }
        let out = "{\n";
        let g = f;
        for bi in 0..blk.len() {
          let (text, g1) = print_stmt(blk[bi], depth + 1, g);
          out += text;
          g = g1;
        }
        return (head + out + indent_str(depth) + "}", g);
      }
      let (act, dg) = print_stmt_body(d.action, depth, f);
      if (d.on_error != 0) {
        return ("errdefer " + act, dg);
      }
      return ("defer " + act, dg);
    },
    ast.StmtVar(v) => {
      if (parser.is_struct_destr_marker(v.type_name)) {
        return (print_struct_destructure(v, depth), f);
      }
      if (v.type_name == "@fndecl") {
        return print_nested_func_decl(v, depth, f);
      }
      if (util.contains(v.name, ",")) {
        return ("let " + destr_at_prefix(v.type_name) + "(" + join_csv(v.name) + ") = " + print_expr(v.init, depth) + ";", f);
      }
      let ann = "";
      if (v.type_name.len() > 0) {
        ann = ": " + v.type_name;
      }
      let (ti, tf) = print_expr_c(v.init, prec_lowest(), depth, f);
      return ("let " + written_name(v.name) + ann + " = " + ti + ";", tf);
    },
    ast.StmtReturn(r) => {
      if (expr_is_missing(r.value)) {
        return ("return;", f);
      }
      match (as_use(r.value)) {
        Some(us) => {
          return print_use(us, r.line, depth, f);
        },
        None => {}
      }
      let (rv, rf) = print_expr_c(r.value, prec_lowest(), depth, f);
      return ("return " + rv + ";", rf);
    },
    ast.StmtExpr(x) => {
      if let Some(set) = assign_parts(st) {
        return print_assign(set, depth, f);
      }
      let (xv, xf) = print_expr_c(x.value, prec_lowest(), depth, f);
      return (xv + ";", xf);
    },
    ast.StmtIf(ifs) => {
      match (as_c_for(ifs)) {
        Some(fc) => {
          return print_c_for(fc, depth, f);
        },
        None => {}
      }
      if (ifs.sugar.tup.len() > 0 || ifs.sugar.strct.len() > 0 || ifs.sugar.lits.len() > 0 || ifs.sugar.arms.len() > 0) {
        if (ifs.sugar.origin == "if_let") {
          return print_sugared_if_let(ifs.sugar, depth, f);
        }
        if (ifs.sugar.origin == "let_else") {
          return print_sugared_let_else(ifs.sugar, depth, f);
        }
        return print_sugared_match(ifs.sugar, depth, f);
      }
      if (ifs.origin == "block") {
        return print_block(ifs.then_body, depth, f);
      }
      if (ifs.origin == "unsafe") {
        let (unsafe_body, unsafe_fmt) = print_block(ifs.then_body, depth, f);
        return ("unsafe " + unsafe_body, unsafe_fmt);
      }
      if (ifs.origin == "chain_assign") {
        match (print_chain_assign(ifs.then_body, depth)) {
          Some(text) => {
            return (text, f);
          },
          None => {
            return print_block(ifs.then_body, depth, f);
          }
        }
      }
      if (ifs.origin == parser.ORIGIN_ASSERT) {
        return print_assert(ifs, depth, f);
      }
      if (ifs.origin == parser.ORIGIN_TODO) {
        return print_todo(ifs.then_body, depth, f);
      }
      return print_if_chain(ifs, depth, f);
    },
    ast.StmtWhile(w) => {
      if (w.is_loop) {
        let (lb, lg) = print_block(w.body, depth, f);
        return (loop_label(w.label) + "loop " + lb, lg);
      }
      let (wc, wcf) = print_expr_c(w.cond, prec_lowest(), depth, f);
      let (wb, wg) = print_block(w.body, depth, wcf);
      return (loop_label(w.label) + "while (" + wc + ") " + wb, wg);
    },
    ast.StmtAssign(a) => {
      return print_assign(ident_assign(a), depth, f);
    },
    ast.StmtMatch(m) => {
      if (m.origin == "let_else" && m.arms.len() >= 2) {
        return print_let_else(m, depth, f);
      }
      if (m.origin == "if_let" && m.arms.len() >= 2) {
        return print_if_let(m, depth, f);
      }
      return print_match(m, depth, f);
    },
    ast.StmtFor(fo) => {
      let fo_body = fo.body;
      let fo_binder = for_binder(fo.var_name);
      if (fo.var_name.starts_with("$forpat_") && fo.body.len() > 0) {
        match (fo.body[0]) {
          ast.StmtVar(fpv) => {
            fo_binder = destr_at_prefix(fpv.type_name);
            if (parser.is_struct_destr_marker(fpv.type_name)) {
              fo_binder += struct_destr_pattern(fpv);
            } else {
              fo_binder = fo_binder + "(" + join_csv(fpv.name) + ")";
            }
            fo_body = drop_first_stmt(fo.body);
          },
          _ => {}
        }
      }
      let (fb, fg) = print_block(fo_body, depth, f);
      return (loop_label(fo.label) + "for " + fo_binder + " in " + print_for_iter(fo.iter, depth) + " " + fb, fg);
    },
    ast.StmtBreak(b) => {
      if (b.label.len() > 0) {
        return ("break " + b.label + ";", f);
      }
      return ("break;", f);
    },
    ast.StmtContinue(c) => {
      if (c.label.len() > 0) {
        return ("continue " + c.label + ";", f);
      }
      return ("continue;", f);
    },
    ast.StmtUnknown(_) => {
      return ("", f);
    }
  }
}

function print_type_params(fd: parser.FuncDecl): string {
  return print_tparam_list(fd.type_params, fd.bound_traits);
}

function print_tparam_list(names: string[], bounds: string[]): string {
  if (names.len() == 0) {
    return "";
  }
  let out = "[";
  for i in 0..names.len() {
    if (i > 0) {
      out += ", ";
    }
    let bound = "";
    if (i < bounds.len()) {
      bound = bounds[i];
    }
    out += print_tparam(names[i], bound);
  }
  return out + "]";
}

// print_decl_tparams is the parameter list of a struct, an enum, a type
// alias or a trait.
function print_decl_tparams(type_params: string[], const_params: string[]): string {
  if (type_params.len() == 0) {
    return "";
  }
  let parts: string[] = [];
  for tp in type_params {
    if (util.has_str(const_params, tp)) {
      parts = parts.append(print_tparam(tp, parser.CONST_BOUND));
    } else {
      parts = parts.append(tp);
    }
  }
  return "[" + parts.join(", ") + "]";
}

function print_tparam(name: string, bound: string): string {
  if (parser.is_const_bound(bound)) {
    return "const " + name + ": i32";
  }
  if (bound.len() == 0) {
    return name;
  }
  return name + ": " + parser.spaced_bounds(bound);
}

function print_resource_decl(rd: parser.ResourceDecl): string {
  let out = "";
  if (rd.iface.len() > 0) {
    out = "@import(" + quote_string(rd.iface) + ", " + quote_string(rd.wit) + ")\n";
  }
  return out + "resource " + rd.name + ";\n";
}

// The @import or @callback line of a body-less function.
function import_attr(fd: parser.FuncDecl): string {
  if (fd.import_iface == parser.CALLBACK_IFACE) {
    return "@callback(" + quote_string(fd.import_wit) + ")\n";
  }
  if (fd.import_iface.len() > 0 && fd.import_weak) {
    return "@import(" + quote_string(fd.import_iface) + ", " + quote_string(fd.import_wit) + ", weak)\n";
  }
  if (fd.import_iface.len() > 0) {
    return "@import(" + quote_string(fd.import_iface) + ", " + quote_string(fd.import_wit) + ")\n";
  }
  return "";
}

function print_func_decl(fd: parser.FuncDecl, has_inline_hint: boolean, inline_never: boolean, f: Fmt): (string, Fmt) {
  let out = "";
  out += import_attr(fd);
  if (has_inline_hint) {
    if (inline_never) {
      out += "@noinline\n";
    } else {
      out += "@inline\n";
    }
  }
  if (fd.is_pub) {
    out += "pub ";
  }
  if (fd.is_package) {
    out += "pub(package) ";
  }
  if (fd.fip || fd.fbip) {
    if (fd.fip) {
      out += "fip";
    } else {
      out += "fbip";
    }
    if (fd.fip_allowance > 0) {
      out = out + "(" + util.i32_to_string(fd.fip_allowance) + ")";
    }
    out += " ";
  }
  if (fd.async) {
    out += "async ";
  }
  if (fd.is_unsafe) {
    out += "unsafe ";
  }
  out += "function ";
  let tps = print_type_params(fd);
  if (fd.receiver_name.len() > 0) {
    let rp = parser.receiver_with_bounds(fd);
    tps = print_tparam_list(rp.names, rp.bounds);
    out = out + "(" + receiver_mode(fd) + fd.receiver_name;
    if (rp.recv.len() > 0) {
      out = out + ": " + rp.recv;
    }
    out += ") ";
  }
  out = out + fd.name + tps;
  let (dpats, dpre) = param_patterns_for(fd.params, fd.body);
  out += "(";
  for i in 0..fd.params.len() {
    if (i > 0) {
      out += ", ";
    }
    if (fd.params[i].send) {
      out += "send ";
    } else if (fd.params[i].own) {
      out += "own ";
    }
    if (i < dpats.len() && dpats[i].len() > 0) {
      out += dpats[i];
    } else {
      out += written_name(fd.params[i].name);
    }
    if (fd.params[i].type_name.len() > 0) {
      out = out + ": " + fd.params[i].type_name;
    }
    out += print_param_default(fd.params[i], true, 0);
  }
  out += ")";
  if (fd.ret_type.len() > 0) {
    out += ": ";
    if (fd.ret_own) {
      out += "own ";
    }
    out += fd.ret_type;
  }
  if (fd.import_iface.len() > 0) {
    return (out + ";\n", f);
  }
  let (body_text, g) = print_block(drop_prelude(fd.body, dpre), 0, anchored(f, fd.line));
  return (out + " " + body_text + "\n", g);
}

function print_struct_decl(sd: parser.StructDecl, flines: parser.FieldLines[], f: Fmt): (string, Fmt) {
  let out = "";
  if (sd.value_type) {
    out += "@value\n";
  }
  if (sd.derives.len() > 0) {
    out += "@derive(";
    for di in 0..sd.derives.len() {
      if (di > 0) {
        out += ", ";
      }
      out += sd.derives[di];
    }
    out += ")\n";
  }
  if (sd.must_consume) {
    out += "@must_consume\n";
  }
  if (sd.is_pub) {
    out += "pub ";
  }
  if (sd.is_package) {
    out += "pub(package) ";
  }
  if (sd.opaque) {
    out += "opaque ";
  }
  out = out + "struct " + sd.name + print_decl_tparams(sd.type_params, sd.const_params);
  let lns = field_lines_for(flines, sd.name, sd.line);
  if (lns.len() == sd.fields.len() && lns.len() > 0 && keep_list_lines(f, sd.line, lns[lns.len() - 1])) {
    out += " {\n";
    for mi in 0..sd.fields.len() {
      let (lead, f1) = drain_leading(f, lns[mi], 1);
      out += lead;
      f = f1;
      out = out + indent_str(1) + sd.fields[mi].name + ": " + sd.fields[mi].type_name + ",";
      let (tr, f2) = emit_trailing(f, lns[mi]);
      out = out + tr + "\n";
      f = f2;
    }
    return (out + "}\n", f);
  }
  out += " { ";
  for i in 0..sd.fields.len() {
    if (i > 0) {
      out += ", ";
    }
    out = out + sd.fields[i].name + ": " + sd.fields[i].type_name;
  }
  return (out + " }\n", f);
}

function print_const_decl(fd: parser.FuncDecl, f: Fmt): (string, Fmt) {
  let out = "";
  if (fd.is_pub) {
    out += "pub ";
  }
  if (fd.is_package) {
    out += "pub(package) ";
  }
  out = out + "const " + fd.name;
  if (fd.ret_type.len() > 0) {
    out += ": ";
    if (fd.ret_own) {
      out += "own ";
    }
    out += fd.ret_type;
  }
  for i in 0..fd.body.len() {
    match (fd.body[i]) {
      ast.StmtReturn(r) => {
        let (cv, cf) = print_expr_c(r.value, prec_lowest(), 0, f);
        return (out + " = " + cv + ";\n", cf);
      },
      _ => {}
    }
  }
  return (out + ";\n", f);
}

pub function enum_index(enums: parser.EnumDecl[], name: string): i32 {
  for i in 0..enums.len() {
    if (enums[i].name == name) {
      return i;
    }
  }
  return -1;
}

// enum_variant_starts gives, for each enum, the index in structs of its first
// variant, or -1 for an enum with no variant. The parser appends the variants
// of an enum in order and together, so a name that the source declares twice
// still gets its own variants.
function enum_variant_starts(enums: parser.EnumDecl[], structs: parser.StructDecl[]): i32[] {
  let out: i32[] = [];
  let si = 0;
  for ed in enums {
    if (ed.variant_names.len() == 0) {
      out = out.append(-1);
      continue;
    }
    while (si < structs.len() && (structs[si].enum_owner != ed.name || structs[si].name != ed.variant_names[0])) {
      si += 1;
    }
    out = out.append(si);
    si += ed.variant_names.len();
  }
  return out;
}

// d0 is the index in structs of the first variant of ed.
function print_enum_decl(ed: parser.EnumDecl, structs: parser.StructDecl[], d0: i32, flines: parser.FieldLines[], f: Fmt): (string, Fmt) {
  let out = "";
  if (d0 >= 0 && structs[d0].derives.len() > 0) {
    out += "@derive(";
    let di = 0;
    while (di < structs[d0].derives.len()) {
      if (di > 0) {
        out += ", ";
      }
      out += structs[d0].derives[di];
      di += 1;
    }
    out += ")\n";
  }
  if (ed.must_consume) {
    out += "@must_consume\n";
  }
  if (ed.is_pub) {
    out += "pub ";
  }
  if (ed.is_package) {
    out += "pub(package) ";
  }
  out = out + "enum " + ed.name + print_decl_tparams(ed.type_params, ed.const_params);
  let lns = field_lines_for(flines, ed.name, ed.line);
  if (lns.len() == ed.variant_names.len() && lns.len() > 0 && keep_list_lines(f, ed.line, lns[lns.len() - 1])) {
    out += " {\n";
    for mvi in 0..ed.variant_names.len() {
      let (lead, f1) = drain_leading(f, lns[mvi], 1);
      out += lead;
      f = f1;
      out = out + indent_str(1) + print_enum_variant(structs[d0 + mvi]) + ",";
      let (tr, f2) = emit_trailing(f, lns[mvi]);
      out = out + tr + "\n";
      f = f2;
    }
    return (out + "}\n", f);
  }
  out += " { ";
  for vi in 0..ed.variant_names.len() {
    if (vi > 0) {
      out += ", ";
    }
    out += print_enum_variant(structs[d0 + vi]);
  }
  return (out + " }\n", f);
}

function print_enum_variant(sd: parser.StructDecl): string {
  let out = sd.name;
  if (sd.variant_field_names.len() > 0) {
    out += " {";
    let ri = 0;
    while (ri < sd.fields.len()) {
      if (ri > 0) {
        out += ",";
      }
      out = out + " " + sd.variant_field_names[ri] + ": " + sd.fields[ri].type_name;
      ri += 1;
    }
    return out + " }";
  }
  if (sd.fields.len() > 0) {
    out += "(";
    let fi = 0;
    while (fi < sd.fields.len()) {
      if (fi > 0) {
        out += ", ";
      }
      out += sd.fields[fi].type_name;
      fi += 1;
    }
    return out + ")";
  }
  return out;
}

function print_impl_decl(id: parser.ImplDecl, f: Fmt): (string, Fmt) {
  let out = "impl";
  if (id.type_params.len() > 0) {
    out += "[";
    for tpi in 0..id.type_params.len() {
      if (tpi > 0) {
        out += ", ";
      }
      let bound = "";
      if (tpi < id.bounds.len()) {
        bound = id.bounds[tpi];
      }
      out += print_tparam(id.type_params[tpi], bound);
    }
    out += "]";
  }
  out = out + " " + id.trait_ref + " for " + id.type_ref;
  if (id.methods.len() == 0 && id.assoc_names.len() == 0) {
    return (out + " {}\n", f);
  }
  out += " {\n";
  for abi in 0..id.assoc_names.len() {
    let abv = "";
    if (abi < id.assoc_values.len()) {
      abv = id.assoc_values[abi];
    }
    out = out + indent_str(1) + "type " + id.assoc_names[abi] + " = " + abv + ";\n";
  }
  let g = f;
  for mi in 0..id.methods.len() {
    if (mi > 0 && g.blank_before(id.methods[mi].line)) {
      out += "\n";
    }
    let (lead, lg) = drain_leading(g, id.methods[mi].line, 1);
    let (mtext, mg) = print_impl_method(id.methods[mi], lg);
    out = out + lead + mtext;
    g = mg;
  }
  return (out + "}\n", g);
}

function receiver_mode(fd: parser.FuncDecl): string {
  if (fd.receiver_own) {
    return "own ";
  }
  return "";
}

function print_const_member(m: parser.FuncDecl, f: Fmt): (string, Fmt) {
  let out = indent_str(1) + "const " + m.name + ": " + m.ret_type;
  if (m.body.len() > 0) {
    if let ast.StmtReturn(r) = m.body[0] {
      let (cv, cf) = print_expr_c(r.value, prec_lowest(), 0, f);
      return (out + " = " + cv + ";\n", cf);
    }
  }
  let (tr, g0) = emit_trailing(f, m.line);
  return (out + ";" + tr + "\n", g0);
}

function print_impl_method(m: parser.FuncDecl, f: Fmt): (string, Fmt) {
  if (m.is_const) {
    return print_const_member(m, f);
  }
  let out = indent_str(1);
  if (m.always_inline) {
    out = out + "@inline\n" + indent_str(1);
  } else if (m.no_inline) {
    out = out + "@noinline\n" + indent_str(1);
  }
  if (m.is_unsafe) {
    out += "unsafe ";
  }
  out = out + "function " + m.name + print_type_params(m) + "(";
  let first = true;
  for i in 0..m.params.len() {
    if (!first) {
      out += ", ";
    }
    if (m.params[i].own) {
      out += "own ";
    }
    out += written_name(m.params[i].name);
    if (m.params[i].type_name.len() > 0) {
      out = out + ": " + m.params[i].type_name;
    }
    first = false;
  }
  out += ")";
  if (m.ret_type.len() > 0) {
    out += ": ";
    if (m.ret_own) {
      out += "own ";
    }
    out += m.ret_type;
  }
  if (m.body.len() == 0) {
    return (out + ";\n", f);
  }
  let (body, g) = print_block(m.body, 1, f);
  return (out + " " + body + "\n", g);
}

function print_trait_decl(td: parser.TraitDecl, f: Fmt): (string, Fmt) {
  let out = "";
  if (td.is_pub) {
    out += "pub ";
  }
  if (td.is_package) {
    out += "pub(package) ";
  }
  out = out + "trait " + td.name + print_decl_tparams(td.type_params, td.const_params);
  if (td.supertraits.len() > 0) {
    out += ": ";
    for spi in 0..td.supertraits.len() {
      if (spi > 0) {
        out += " + ";
      }
      out += td.supertraits[spi];
    }
  }
  if (td.methods.len() == 0 && td.assoc_types.len() == 0) {
    return (out + " {}\n", f);
  }
  out += " {\n";
  for ati in 0..td.assoc_types.len() {
    out = out + indent_str(1) + "type " + td.assoc_types[ati] + ";\n";
  }
  let g = f;
  for mi in 0..td.methods.len() {
    if (mi > 0 && g.blank_before(td.methods[mi].line)) {
      out += "\n";
    }
    let (lead, lg) = drain_leading(g, td.methods[mi].line, 1);
    let (mtext, mg) = print_trait_method(td.methods[mi], lg);
    out = out + lead + mtext;
    g = mg;
  }
  return (out + "}\n", g);
}

function print_trait_method(m: parser.FuncDecl, f: Fmt): (string, Fmt) {
  if (m.is_const) {
    return print_const_member(m, f);
  }
  let out = indent_str(1);
  if (m.is_unsafe) {
    out += "unsafe ";
  }
  out = out + "function " + m.name + print_type_params(m) + "(";
  for i in 0..m.params.len() {
    if (i > 0) {
      out += ", ";
    }
    if (m.params[i].own) {
      out += "own ";
    }
    out += written_name(m.params[i].name);
    if (m.params[i].type_name.len() > 0) {
      out = out + ": " + m.params[i].type_name;
    }
  }
  out += ")";
  if (m.ret_type.len() > 0) {
    out += ": ";
    if (m.ret_own) {
      out += "own ";
    }
    out += m.ret_type;
  }
  if (m.body.len() == 0) {
    let (tr, g0) = emit_trailing(f, m.line);
    return (out + ";" + tr + "\n", g0);
  }
  let (body, g) = print_block(m.body, 1, f);
  return (out + " " + body + "\n", g);
}

function print_type_alias(a: parser.TypeAlias): string {
  let out = "";
  if (a.is_pub) {
    out += "pub ";
  }
  if (a.is_package) {
    out += "pub(package) ";
  }
  out = out + "type " + a.name + print_decl_tparams(a.type_params, a.const_params);
  out += " = ";
  let ln = a.variant_lines;
  let n = ln.len();
  let kept = n == a.variants.len() && n > 0 && ln[0] > 0 && ln[n - 1] > ln[0];
  for i in 0..a.variants.len() {
    if (i > 0 && kept && ln[i] > ln[i - 1]) {
      out = out + "\n" + indent_str(1) + "| ";
    } else if (i > 0) {
      out += " | ";
    }
    out += a.variants[i];
    if (i < a.variant_args.len() && a.variant_args[i].len() > 0) {
      out = out + "[" + a.variant_args[i] + "]";
    }
  }
  return out + ";\n";
}

function print_import(im: parser.Import): string {
  if (im.is_reexport) {
    let re = "pub use " + quote_string(im.path) + ".{";
    for ri in 0..im.reexport_names.len() {
      if (ri > 0) {
        re += ", ";
      }
      re += im.reexport_names[ri];
    }
    return re + "};\n";
  }
  if (im.alias.len() > 0) {
    return "import " + quote_string(im.path) + " as " + im.alias + ";\n";
  }
  return "import " + quote_string(im.path) + ";\n";
}

pub function print_module(mod: parser.Module): string {
  return format_module(parser.written_type_vars_module(mod), [], [], [], [], []);
}

pub function format_module(mod: parser.Module, traits: parser.TraitDecl[], impls: parser.ImplDecl[], flines: parser.FieldLines[], comments: lexer.Comment[], blanks: boolean[]): string {
  return format_module_with_inline(mod, traits, impls, flines, [], no_spans(), comments, blanks);
}

pub function format_parsed(pf: parser.ParsedFmt, comments: lexer.Comment[], blanks: boolean[]): string {
  return format_module_with_inline(pf.pmod, pf.ptraits, pf.pimpls, pf.pflines, pf.pinline, pf.pspans, comments, blanks);
}

function print_annotated_function(fd: parser.FuncDecl, mod: parser.Module, hints: parser.FunctionInlineHint[], cursor: i32, f: Fmt): (string, Fmt, i32) {
  let prefix = "";
  for mark in mod.marks {
    if (mark.line != fd.line || mark.col != fd.col) {
      continue;
    }
    if (mark.attr == "provide" || mark.attr == "interrupt") {
      prefix = prefix + "@" + mark.attr + "(" + quote_string(mark.arg) + ")\n";
    } else {
      prefix = prefix + "@" + mark.attr + "\n";
    }
  }
  for binding in mod.exports {
    if (binding.func_name == fd.name && !binding.c_abi && fd.receiver_name.len() > 0 == binding.method) {
      let attr = "@export(";
      if (binding.jni) {
        attr = "@jni(";
      }
      prefix = prefix + attr + quote_string(binding.iface) + ", " + quote_string(binding.wit) + ")\n";
    }
  }
  let has_hint = cursor < hints.len() && hints[cursor].line == fd.line && hints[cursor].col == fd.col;
  let never = false;
  let next_hint = cursor;
  if (has_hint) {
    never = hints[cursor].never;
    next_hint = cursor + 1;
  }
  let (text, next) = print_func_decl(fd, has_hint, never, f);
  return (prefix + text, next, next_hint);
}

function format_module_with_inline(mod: parser.Module, traits: parser.TraitDecl[], impls: parser.ImplDecl[], flines: parser.FieldLines[], hints: parser.FunctionInlineHint[], spans: parser.BlockSpans, comments: lexer.Comment[], blanks: boolean[]): string {
  let f = Fmt { comments: comments, ci: 0, blanks: blanks, spans: spans, si: 0, at: 0, own: -1 };
  let chunks: string[] = [];
  let wrote = false;
  let kinds: i32[] = [];
  let idxs: i32[] = [];
  let lines: i32[] = [];
  for ii in 0..mod.imports.len() {
    kinds = kinds.append(6);
    idxs = idxs.append(ii);
    lines = lines.append(mod.imports[ii].line);
  }
  for i in 0..mod.structs.len() {
    let owner = mod.structs[i].enum_owner;
    if (owner.len() == 0 || enum_index(mod.enums, owner) < 0) {
      kinds = kinds.append(0);
      idxs = idxs.append(i);
      lines = lines.append(mod.structs[i].line);
    }
  }
  let variant_starts = enum_variant_starts(mod.enums, mod.structs);
  for vi in 0..mod.enums.len() {
    kinds = kinds.append(1);
    idxs = idxs.append(vi);
    lines = lines.append(mod.enums[vi].line);
  }
  for ai in 0..mod.aliases.len() {
    kinds = kinds.append(2);
    idxs = idxs.append(ai);
    lines = lines.append(mod.aliases[ai].line);
  }
  for ri in 0..mod.resources.len() {
    kinds = kinds.append(7);
    idxs = idxs.append(ri);
    lines = lines.append(mod.resources[ri].line);
  }
  for ti2 in 0..traits.len() {
    kinds = kinds.append(4);
    idxs = idxs.append(ti2);
    lines = lines.append(traits[ti2].line);
  }
  for ipi in 0..impls.len() {
    kinds = kinds.append(5);
    idxs = idxs.append(ipi);
    lines = lines.append(impls[ipi].line);
  }
  for fi in 0..mod.funcs.len() {
    if (mod.funcs[fi].line > 0) {
      kinds = kinds.append(3);
      idxs = idxs.append(fi);
      lines = lines.append(mod.funcs[fi].line);
    }
  }
  let si = 1;
  while (si < lines.len()) {
    let sj = si;
    while (sj > 0 && lines[sj - 1] > lines[sj]) {
      let tl = lines[sj - 1];
      let tk = kinds[sj - 1];
      let ti = idxs[sj - 1];
      lines = lines.with(sj - 1, lines[sj]);
      kinds = kinds.with(sj - 1, kinds[sj]);
      idxs = idxs.with(sj - 1, idxs[sj]);
      lines = lines.with(sj, tl);
      kinds = kinds.with(sj, tk);
      idxs = idxs.with(sj, ti);
      sj -= 1;
    }
    si += 1;
  }
  let hint_cursor = 0;
  for di in 0..kinds.len() {
    let dline = lines[di];
    if (di > 0 && !(kinds[di] == 6 && kinds[di - 1] == 6)) {
      chunks = chunks.append("\n");
    }
    if (dline > 0) {
      let (lead, fl) = drain_decl_leading(f, dline);
      chunks = chunks.append(lead);
      wrote = true;
      f = fl;
    }
    if (kinds[di] == 6) {
      chunks = chunks.append(print_import(mod.imports[idxs[di]]));
      wrote = true;
    } else if (kinds[di] == 0) {
      let (stext, sf2) = print_struct_decl(mod.structs[idxs[di]], flines, f);
      chunks = chunks.append(stext);
      wrote = true;
      f = sf2;
    } else if (kinds[di] == 1) {
      let (etext, ef) = print_enum_decl(mod.enums[idxs[di]], mod.structs, variant_starts[idxs[di]], flines, f);
      chunks = chunks.append(etext);
      wrote = true;
      f = ef;
    } else if (kinds[di] == 2) {
      chunks = chunks.append(print_type_alias(mod.aliases[idxs[di]]));
      wrote = true;
    } else if (kinds[di] == 7) {
      chunks = chunks.append(print_resource_decl(mod.resources[idxs[di]]));
      wrote = true;
    } else if (kinds[di] == 4) {
      let (ttext, tf) = print_trait_decl(traits[idxs[di]], f);
      chunks = chunks.append(ttext);
      wrote = true;
      f = tf;
    } else if (kinds[di] == 5) {
      let (itext, iff) = print_impl_decl(impls[idxs[di]], f);
      chunks = chunks.append(itext);
      wrote = true;
      f = iff;
    } else {
      if (mod.funcs[idxs[di]].is_const) {
        let (ctext, cf) = print_const_decl(mod.funcs[idxs[di]], f);
        chunks = chunks.append(ctext);
        wrote = true;
        f = cf;
      } else {
        let fd = mod.funcs[idxs[di]];
        let (ftext, ff, next_hint) = print_annotated_function(fd, mod, hints, hint_cursor, f);
        hint_cursor = next_hint;
        chunks = chunks.append(ftext);
        wrote = true;
        f = ff;
      }
    }
  }
  for j in 0..mod.top_stmts.len() {
    if (wrote) {
      chunks = chunks.append("\n");
      wrote = true;
    }
    let (stext, sf) = print_stmt(mod.top_stmts[j], 0, f);
    chunks = chunks.append(stext);
    wrote = true;
    f = sf;
  }
  let (tail, _) = drain_all(f, 0, chunks.len() > 0);
  chunks = chunks.append(tail);
  return util.str_join_chunks(chunks);
}

pub function diff_split_lines(s: string): string[] {
  let out: string[] = [];
  if (s.len() == 0) {
    return out;
  }
  let start = 0;
  for i in 0..s.len() {
    if (s[i] == b'\n') {
      out = out.append(slice_unchecked(s, start, i + 1).to_owned());
      start = i + 1;
    }
  }
  if (start < s.len()) {
    out = out.append(slice_unchecked(s, start, s.len()).to_owned());
  }
  return out;
}

pub struct DiffScript { kinds: i32[], lines: string[] }

function diff_max_search_cost(): i32 {
  return 16384;
}

struct DiffIds { ia: i32[], ib: i32[], distinct: i32 }

function diff_intern(a: string[], b: string[]): DiffIds {
  let ids: Map[string, i32] = map_new(a.len() + b.len() + 1);
  let ia: i32[] = [];
  let ib: i32[] = [];
  let next = 0;
  for i in 0..a.len() {
    let ida: i32 = ids.get_or(a[i], -1);
    if (ida < 0) {
      ida = next;
      ids = ids.insert(a[i], ida);
      next += 1;
    }
    ia = ia.append(ida);
  }
  for j in 0..b.len() {
    let idb: i32 = ids.get_or(b[j], -1);
    if (idb < 0) {
      idb = next;
      ids = ids.insert(b[j], idb);
      next += 1;
    }
    ib = ib.append(idb);
  }
  return DiffIds { ia: ia, ib: ib, distinct: next };
}

function diff_furthest(vf: i32[], vr: i32[], off: i32, size: i32, alo: i32, ahi: i32, blo: i32, bhi: i32): (i32, i32) {
  let na = ahi - alo;
  let nb = bhi - blo;
  let best_f = 0;
  let fx = 0;
  let fy = 0;
  let best_r = 0;
  let rx = 0;
  let ry = 0;
  for o in 0..size {
    let j = o - off;
    let xf = vf[o];
    if (xf >= 0) {
      let yf = xf - j;
      if (xf <= na && yf >= 0 && yf <= nb && xf + yf > best_f) {
        best_f = xf + yf;
        fx = xf;
        fy = yf;
      }
    }
    let xr = vr[o];
    if (xr >= 0) {
      let yr = xr - j;
      if (xr <= na && yr >= 0 && yr <= nb && xr + yr > best_r) {
        best_r = xr + yr;
        rx = na - xr;
        ry = nb - yr;
      }
    }
  }
  if (best_f >= best_r) {
    if (best_f > 0 && (fx < na || fy < nb)) {
      return (alo + fx, blo + fy);
    }
  } else if (rx > 0 || ry > 0) {
    return (alo + rx, blo + ry);
  }
  return (alo + na / 2, blo + nb / 2);
}

function diff_bisect(ia: i32[], ib: i32[], alo: i32, ahi: i32, blo: i32, bhi: i32, max_cost: i32): (i32, i32) {
  let na = ahi - alo;
  let nb = bhi - blo;
  let maxd: i32 = (na + nb + 3) / 2;
  let budget = maxd;
  if (budget > max_cost) {
    budget = max_cost;
  }
  let off = budget + 1;
  let size = 2 * budget + 4;
  let vf: i32[] = [];
  let vr: i32[] = [];
  for z in 0..size {
    vf = vf.append(-1);
    vr = vr.append(-1);
  }
  vf = vf.with(off + 1, 0);
  vr = vr.with(off + 1, 0);
  let delta = na - nb;
  let meet_forward = delta % 2 != 0;
  let flo = 0;
  let fhi = 0;
  let rlo = 0;
  let rhi = 0;
  for k in 0..budget {
    let jf = -k + flo;
    while (jf <= k - fhi) {
      let o = off + jf;
      let x = 0;
      if (jf == -k || jf != k && vf[o - 1] < vf[o + 1]) {
        x = vf[o + 1];
      } else {
        x = vf[o - 1] + 1;
      }
      let y = x - jf;
      while (x < na && y < nb && ia[alo + x] == ib[blo + y]) {
        x += 1;
        y += 1;
      }
      vf = vf.with(o, x);
      if (x > na) {
        fhi += 2;
      } else if (y > nb) {
        flo += 2;
      } else if (meet_forward) {
        let ro = off + delta - jf;
        if (ro >= 0 && ro < size && vr[ro] >= 0 && x >= na - vr[ro]) {
          return (alo + x, blo + y);
        }
      }
      jf += 2;
    }
    let jr = -k + rlo;
    while (jr <= k - rhi) {
      let o2 = off + jr;
      let x2 = 0;
      if (jr == -k || jr != k && vr[o2 - 1] < vr[o2 + 1]) {
        x2 = vr[o2 + 1];
      } else {
        x2 = vr[o2 - 1] + 1;
      }
      let y2 = x2 - jr;
      while (x2 < na && y2 < nb && ia[ahi - 1 - x2] == ib[bhi - 1 - y2]) {
        x2 += 1;
        y2 += 1;
      }
      vr = vr.with(o2, x2);
      if (x2 > na) {
        rhi += 2;
      } else if (y2 > nb) {
        rlo += 2;
      } else if (!meet_forward) {
        let fo = off + delta - jr;
        if (fo >= 0 && fo < size && vf[fo] >= 0 && vf[fo] >= na - x2) {
          return (alo + vf[fo], blo + vf[fo] - (delta - jr));
        }
      }
      jr += 2;
    }
  }
  return diff_furthest(vf, vr, off, size, alo, ahi, blo, bhi);
}

function diff_compare(anchors: i32[], ia: i32[], ib: i32[], alo: i32, ahi: i32, blo: i32, bhi: i32, max_cost: i32): i32[] {
  let lo_a = alo;
  let lo_b = blo;
  while (lo_a < ahi && lo_b < bhi && ia[lo_a] == ib[lo_b]) {
    anchors = anchors.append(lo_a);
    anchors = anchors.append(lo_b);
    lo_a += 1;
    lo_b += 1;
  }
  let suffix = 0;
  while (ahi - suffix > lo_a && bhi - suffix > lo_b && ia[ahi - 1 - suffix] == ib[bhi - 1 - suffix]) {
    suffix += 1;
  }
  let hi_a = ahi - suffix;
  let hi_b = bhi - suffix;
  if (lo_a < hi_a && lo_b < hi_b) {
    let (x, y) = diff_bisect(ia, ib, lo_a, hi_a, lo_b, hi_b, max_cost);
    if ((x != lo_a || y != lo_b) && (x != hi_a || y != hi_b)) {
      anchors = diff_compare(anchors, ia, ib, lo_a, x, lo_b, y, max_cost);
      anchors = diff_compare(anchors, ia, ib, x, hi_a, y, hi_b, max_cost);
    }
  }
  for s in 0..suffix {
    anchors = anchors.append(hi_a + s);
    anchors = anchors.append(hi_b + s);
  }
  return anchors;
}

pub function diff_edit_script(a: string[], b: string[]): DiffScript {
  let m = a.len();
  let n = b.len();
  let ids = diff_intern(a, b);
  let ia = ids.ia;
  let ib = ids.ib;

  let pre = 0;
  while (pre < m && pre < n && ia[pre] == ib[pre]) {
    pre += 1;
  }
  let suf = 0;
  while (suf < m - pre && suf < n - pre && ia[m - 1 - suf] == ib[n - 1 - suf]) {
    suf += 1;
  }

  let in_a: boolean[] = [];
  let in_b: boolean[] = [];
  for z in 0..ids.distinct {
    in_a = in_a.append(false);
    in_b = in_b.append(false);
  }
  let i = pre;
  while (i < m - suf) {
    in_a = in_a.with(ia[i], true);
    i += 1;
  }
  let j = pre;
  while (j < n - suf) {
    in_b = in_b.with(ib[j], true);
    j += 1;
  }
  let fa: i32[] = [];
  let map_a: i32[] = [];
  let fb: i32[] = [];
  let map_b: i32[] = [];
  for i in pre..m - suf {
    if (in_b[ia[i]]) {
      fa = fa.append(ia[i]);
      map_a = map_a.append(i);
    }
  }
  for j in pre..n - suf {
    if (in_a[ib[j]]) {
      fb = fb.append(ib[j]);
      map_b = map_b.append(j);
    }
  }
  let anchors: i32[] = [];
  anchors = diff_compare(anchors, fa, fb, 0, fa.len(), 0, fb.len(), diff_max_search_cost());

  let kinds: i32[] = [];
  let lines: string[] = [];
  let p = 0;
  while (p < pre) {
    kinds = kinds.append(0);
    lines = lines.append(a[p]);
    p += 1;
  }
  let q = pre;
  let t = 0;
  while (t < anchors.len()) {
    let ai = map_a[anchors[t]];
    let bj = map_b[anchors[t + 1]];
    while (p < ai) {
      kinds = kinds.append(1);
      lines = lines.append(a[p]);
      p += 1;
    }
    while (q < bj) {
      kinds = kinds.append(2);
      lines = lines.append(b[q]);
      q += 1;
    }
    kinds = kinds.append(0);
    lines = lines.append(a[p]);
    p += 1;
    q += 1;
    t += 2;
  }
  while (p < m - suf) {
    kinds = kinds.append(1);
    lines = lines.append(a[p]);
    p += 1;
  }
  while (q < n - suf) {
    kinds = kinds.append(2);
    lines = lines.append(b[q]);
    q += 1;
  }
  while (p < m) {
    kinds = kinds.append(0);
    lines = lines.append(a[p]);
    p += 1;
  }
  return DiffScript { kinds: kinds, lines: lines };
}

pub function unified_diff(before: string, after: string, path_before: string, path_after: string): string {
  if (before == after) {
    return "";
  }
  let script = diff_edit_script(diff_split_lines(before), diff_split_lines(after));
  let kinds = script.kinds;
  if (kinds.len() == 0) {
    return "";
  }
  let context = 3;

  let lo: i32[] = [];
  let hi: i32[] = [];
  let i = 0;
  while (i < kinds.len()) {
    if (kinds[i] == 0) {
      i += 1;
    } else {
      let s = i;
      while (i < kinds.len() && kinds[i] != 0) {
        i += 1;
      }
      if (lo.len() > 0 && s - hi[hi.len() - 1] <= 2 * context) {
        hi = hi.with(hi.len() - 1, i);
      } else {
        lo = lo.append(s);
        hi = hi.append(i);
      }
    }
  }
  if (lo.len() == 0) {
    return "";
  }

  let out = "--- " + path_before + "\n+++ " + path_after + "\n";
  for h in 0..lo.len() {
    let start = lo[h] - context;
    if (start < 0) {
      start = 0;
    }
    let end = hi[h] + context;
    if (end > kinds.len()) {
      end = kinds.len();
    }
    let a_pos = 0;
    let b_pos = 0;
    let k = 0;
    while (k < start) {
      if (kinds[k] != 2) {
        a_pos += 1;
      }
      if (kinds[k] != 1) {
        b_pos += 1;
      }
      k += 1;
    }
    let a_len = 0;
    let b_len = 0;
    k = start;
    while (k < end) {
      if (kinds[k] != 2) {
        a_len += 1;
      }
      if (kinds[k] != 1) {
        b_len += 1;
      }
      k += 1;
    }
    out = out + "@@ -" + util.i32_to_string(a_pos + 1) + "," + util.i32_to_string(a_len)
      + " +" + util.i32_to_string(b_pos + 1) + "," + util.i32_to_string(b_len) + " @@\n";
    for k in start..end {
      let mark = " ";
      if (kinds[k] == 1) {
        mark = "-";
      }
      if (kinds[k] == 2) {
        mark = "+";
      }
      let line = script.lines[k];
      out = out + mark + line;
      if (line.len() == 0 || line[line.len() - 1] != b'\n') {
        out += "\n";
      }
    }
  }
  return out;
}
