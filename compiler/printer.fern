import "./ast";
import "./lexer";
import "./parser";
import "./util";
import "core/map";

function hex_digit(d: i32): u8 {
  if (d < 10) {
    return (48 + d) as u8;
  }
  return (87 + d) as u8;
}

function append_hex_escape(out: u8[], b: i32): u8[] {
  let a: u8[] = out;
  a = a.append(92 as u8);
  a = a.append(120 as u8);
  a = a.append(hex_digit(b / 16));
  a = a.append(hex_digit(b % 16));
  return a;
}

function is_control_byte(b: i32): boolean {
  return b < 32 || b == 127;
}

function escape_lit_body(s: string, fstring: boolean): string {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b == 34) {
      out = out.append(92 as u8);
      out = out.append(34 as u8);
    } else if (b == 92) {
      out = out.append(92 as u8);
      out = out.append(92 as u8);
    } else if (b == 10) {
      out = out.append(92 as u8);
      out = out.append(110 as u8);
    } else if (b == 9) {
      out = out.append(92 as u8);
      out = out.append(116 as u8);
    } else if (b == 13) {
      out = out.append(92 as u8);
      out = out.append(114 as u8);
    } else if (fstring && (b == 123 || b == 125)) {
      out = out.append(b as u8);
      out = out.append(b as u8);
    } else if (is_control_byte(b)) {
      out = append_hex_escape(out, b);
    } else {
      out = out.append(s[i]);
    }
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

function quote_string(s: string): string {
  return "\"" + escape_lit_body(s, false) + "\"";
}

function escape_fstring_lit(s: string): string {
  return escape_lit_body(s, true);
}

function prec_lowest(): i32 {
  return 0;
}

function prec_assign(): i32 {
  return 1;
}

function prec_cast(): i32 {
  return 14;
}

function prec_unary(): i32 {
  return 15;
}

function prec_primary(): i32 {
  return 16;
}

function binary_prec(op: string): i32 {
  if (op == "|>") {
    return 2;
  }
  if (op == "||") {
    return 4;
  }
  if (op == "&&") {
    return 5;
  }
  if (op == "|") {
    return 6;
  }
  if (op == "^") {
    return 7;
  }
  if (op == "&") {
    return 8;
  }
  if (op == "==" || op == "!=") {
    return 9;
  }
  if (op == "<" || op == "<=" || op == ">" || op == ">=") {
    return 10;
  }
  if (op == "<<" || op == ">>" || op == "<<|" || op == "<<?" || op == ">>?") {
    return 11;
  }
  if (op == "+" || op == "-" || op == "+|" || op == "-|" || op == "+?" || op == "-?") {
    return 12;
  }
  if (op == "*" || op == "/" || op == "%" || op == "*|" || op == "*?" || op == "/?" || op == "%?") {
    return 13;
  }
  return prec_lowest();
}

function print_expr(e: ast.Expr, depth: i32): string {
  return print_expr_prec(e, prec_lowest(), depth);
}

function print_lit(e: ast.Expr): string {
  return print_expr(e, 0);
}

function arrow_return_type(ret: string): string {
  if (parser.top_arrow_at(ret) >= 0) {
    return "(" + ret + ")";
  }
  return ret;
}

function print_lambda_params(lm: ast.ExprLambda, depth: i32): string {
  let (pats, _) = param_patterns_for(lm.params, lm.body);
  return print_params_with(lm.params, pats, true, depth);
}

function print_params_with(params: ast.ParamDecl[], pats: string[], defaults: boolean, depth: i32): string {
  let out: string = "(";
  let pi: i32 = 0;
  while (pi < params.len()) {
    if (pi > 0) {
      out = out + ", ";
    }
    if (params[pi].own) {
      out = out + "own ";
    }
    if (pi < pats.len() && pats[pi].len() > 0) {
      out = out + pats[pi];
    } else {
      out = out + written_name(params[pi].name);
    }
    if (params[pi].type_name.len() > 0) {
      out = out + ": " + params[pi].type_name;
    }
    out = out + print_param_default(params[pi], defaults, depth);
    pi = pi + 1;
  }
  return out + ")";
}

function print_param_default(p: ast.ParamDecl, defaults: boolean, depth: i32): string {
  if (!defaults || !p.has_default) {
    return "";
  }
  return " = " + print_expr(p.default_value, depth);
}

function drop_prelude(body: ast.Stmt[], n: i32): ast.Stmt[] {
  if (n <= 0) {
    return body;
  }
  let out: ast.Stmt[] = [];
  let i: i32 = n;
  while (i < body.len()) {
    out = out.append(body[i]);
    i = i + 1;
  }
  return out;
}

function print_return_only(body: ast.Stmt[], depth: i32): string {
  if (body.len() != 1) {
    return "";
  }
  match (body[0]) {
    ast.StmtReturn(r) => {
      if (expr_is_missing(r.value) || as_use(r.value).ok) {
        return "";
      }
      return print_expr(r.value, depth);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function print_block_expr(c: ast.ExprCall, parent_prec: i32, depth: i32): string {
  if (c.args.len() != 0) {
    return "";
  }
  match (c.callee) {
    ast.ExprLambda(lm) => {
      if (lm.origin != parser.ORIGIN_BLOCK || lm.body.len() == 0) {
        return "";
      }
      let last: ast.Stmt = lm.body[lm.body.len() - 1];
      let tail: string = print_return_only([last], depth);
      if (tail.len() == 0) {
        return "";
      }
      if (lm.body.len() == 1) {
        return print_expr_prec(tail_expr(last), parent_prec, depth);
      }
      return print_value_block(lm.body, tail_expr(last), true, depth);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function tail_expr(st: ast.Stmt): ast.Expr {
  match (st) {
    ast.StmtReturn(r) => {
      return r.value;
    },
    _ => {
      return parser.e_unknown("block tail");
    }
  }
}

function iife_value_local(first: ast.Stmt, last: ast.Stmt): string {
  let name: string = "";
  match (first) {
    ast.StmtVar(v) => {
      name = v.name;
    },
    _ => {
      return "";
    }
  }
  if (name.len() == 0) {
    return "";
  }
  match (last) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprIdent(id) => {
          if (id.name == name) {
            return name;
          }
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
  return "";
}

function print_if_value_branch(body: ast.Stmt[], dead: boolean, depth: i32): string {
  if (body.len() == 0) {
    return "";
  }
  let last: ast.Stmt = body[body.len() - 1];
  if (print_return_only([last], depth) == "") {
    return "";
  }
  return print_value_block(body, tail_expr(last), !dead, depth);
}

function print_if_value(f: ast.StmtIf, depth: i32): string {
  if (f.origin != parser.ORIGIN_IF_EXPR && f.origin != parser.ORIGIN_IF_DEAD_THEN && f.origin != parser.ORIGIN_IF_DEAD_ELSE && f.origin != parser.ORIGIN_IF_DEAD_BOTH) {
    return "";
  }
  let then_dead = f.origin == parser.ORIGIN_IF_DEAD_THEN || f.origin == parser.ORIGIN_IF_DEAD_BOTH;
  let else_dead = f.origin == parser.ORIGIN_IF_DEAD_ELSE || f.origin == parser.ORIGIN_IF_DEAD_BOTH;
  let tv = print_if_value_branch(f.then_body, then_dead, depth);
  let ev = print_if_value_else(f, else_dead, depth);
  if (tv == "" || ev == "") {
    return "";
  }
  return "if (" + print_expr(f.cond, depth) + ") " + tv + " else " + ev;
}

function print_if_value_else(f: ast.StmtIf, dead: boolean, depth: i32): string {
  if (f.else_chained && f.else_body.len() == 1) {
    match (f.else_body[0]) {
      ast.StmtIf(nested) => {
        return print_if_value(nested, depth);
      },
      ast.StmtReturn(r) => {
        return print_expr(r.value, depth);
      },
      _ => {
        return "";
      }
    }
  }
  return print_if_value_branch(f.else_body, dead, depth);
}

function print_expr_iife(c: ast.ExprCall, parent_prec: i32, depth: i32): string {
  if (c.args.len() != 0) {
    return "";
  }
  match (c.callee) {
    ast.ExprLambda(lm) => {
      if (lm.params.len() != 0) {
        return "";
      }
      if (lm.origin == parser.ORIGIN_IF_EXPR && lm.body.len() == 1) {
        if let ast.StmtIf(f) = lm.body[0] {
          let text = print_if_value(f, depth);
          if (text != "" && parent_prec > 3) {
            return "(" + text + ")";
          }
          return text;
        }
      }
      if (lm.body.len() == 3) {
        let vl: string = iife_value_local(lm.body[0], lm.body[2]);
        if (vl.len() > 0) {
          match (lm.body[1]) {
            ast.StmtMatch(m) => {
              return print_match_expr_arms(m, vl, depth);
            },
            ast.StmtIf(vf) => {
              return print_sugared_match_expr(vf.sugar, vl, depth);
            },
            _ => {
              return "";
            }
          }
        }
        return "";
      }
      if (lm.body.len() == 2) {
        if let ast.StmtVar(sv) = lm.body[0] {
          if (!parser.is_literal_scrut_local(sv.name)) {
            return "";
          }
          if let ast.StmtReturn(sr) = lm.body[1] {
            if let ast.ExprCall(ic) = sr.value {
              return print_expr_iife(ic, parent_prec, depth);
            }
          }
        }
        return "";
      }
      if (lm.body.len() != 1) {
        return "";
      }
      match (lm.body[0]) {
        ast.StmtMatch(m) => {
          return print_match_expr_arms(m, "", depth);
        },
        ast.StmtIf(f) => {
          if (f.sugar.lits.len() > 0) {
            return print_sugared_match_expr(f.sugar, "", depth);
          }
          let tv: string = print_return_only(f.then_body, depth);
          if (tv.len() == 0) {
            return "";
          }
          let ev: string = print_return_only(f.else_body, depth);
          if (ev.len() == 0) {
            return "";
          }
          let text = "if (" + print_expr(f.cond, depth) + ") { " + tv + " } else { " + ev + " }";
          if (parent_prec > 3) {
            return "(" + text + ")";
          }
          return text;
        },
        _ => {
          return "";
        }
      }
      return "";
    },
    _ => {
      return "";
    }
  }
  return "";
}

function print_value_local_iife(c: ast.ExprCall, depth: i32): string {
  if (c.args.len() != 0) {
    return "";
  }
  match (c.callee) {
    ast.ExprLambda(lm) => {
      if (lm.params.len() != 0 || lm.body.len() != 3) {
        return "";
      }
      let v: string = value_local_name(lm.body[0], lm.body[2]);
      if (v.len() == 0) {
        return "";
      }
      match (lm.body[1]) {
        ast.StmtIf(ifs) => {
          return print_sugared_match_expr(ifs.sugar, v, depth);
        },
        ast.StmtMatch(m) => {
          return print_match_expr_arms(m, v, depth);
        },
        _ => {
          return "";
        }
      }
      return "";
    },
    _ => {
      return "";
    }
  }
  return "";
}

function value_local_name(first: ast.Stmt, last: ast.Stmt): string {
  let declared: string = "";
  match (first) {
    ast.StmtVar(vd) => {
      declared = vd.name;
    },
    _ => {
      return "";
    }
  }
  if (declared.len() == 0) {
    return "";
  }
  match (last) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprIdent(id) => {
          if (id.name == declared) {
            return declared;
          }
          return "";
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
  return "";
}

function print_match_expr_arms(m: ast.StmtMatch, v: string, depth: i32): string {
  let arms: ast.MatchArm[] = m.arms;
  let val: string = v;
  if (m.sugar.len() > 0) {
    arms = m.sugar;
    val = "";
  }
  if (arms.len() == 0) {
    return "";
  }
  if (m.origin == "if_let") {
    let sg: ast.MatchSugar = ast.MatchSugar { scrut: m.scrutinee, tup: [], strct: [], lits: [], arms: arms, line: m.line, col: m.col, origin: "if_let", else_chained: m.else_chained };
    return print_sugared_match_expr(sg, v, depth);
  }
  let out: string = "match (" + print_expr(m.scrutinee, depth) + ") { ";
  let i: i32 = 0;
  while (i < arms.len()) {
    let av: string = arm_expr_value(arms[i].body, val, depth);
    if (av.len() == 0) {
      return "";
    }
    if (i > 0) {
      out = out + ", ";
    }
    let head: string = print_pattern(arms[i].pattern);
    let guarded: ast.MatchArm = arms[i];
    while (i + 1 < arms.len() && arms[i + 1].alt_cont) {
      i = i + 1;
      head = head + " | " + print_pattern(arms[i].pattern);
    }
    out = out + head;
    if (guarded.has_guard) {
      out = out + " when " + print_expr(guarded.guard, depth);
    }
    out = out + " => " + av;
    i = i + 1;
  }
  return out + " }";
}

function value_branch_text(value: string): string {
  if (value.starts_with("{")) {
    return value;
  }
  return "{ " + value + " }";
}

function print_sugared_match_expr(sg: ast.MatchSugar, v: string, depth: i32): string {
  let value_local: string = v;
  if (sg.arms.len() > 0 && sg.origin != "if_let") {
    value_local = "";
  }
  let arms: WrittenArm[] = sugar_written_arms(sg);
  if (arms.len() == 0) {
    return "";
  }
  if (sg.origin == "if_let" && arms.len() >= 2) {
    let head: string = arms[0].head;
    let i: i32 = 1;
    while (i < arms.len() - 1) {
      head = head + " | " + arms[i].head;
      i = i + 1;
    }
    let yes: string = arm_expr_value(arms[0].body, value_local, depth);
    let no: string = arm_expr_value(arms[arms.len() - 1].body, value_local, depth);
    if (yes.len() == 0 || no.len() == 0) {
      return "";
    }
    let else_text: string = value_branch_text(no);
    if (sg.else_chained) {
      else_text = no;
    }
    return "if let " + head + " = " + print_expr(sg.scrut, depth) + " " + value_branch_text(yes) + " else " + else_text;
  }
  let out: string = "match (" + print_expr(sg.scrut, depth) + ") { ";
  let i: i32 = 0;
  while (i < arms.len()) {
    let av: string = arm_expr_value(arms[i].body, value_local, depth);
    if (av.len() == 0) {
      return "";
    }
    if (i > 0) {
      out = out + ", ";
    }
    out = out + arms[i].head;
    if (arms[i].has_guard) {
      out = out + " when " + print_expr(arms[i].guard, depth);
    }
    out = out + " => " + av;
    i = i + 1;
  }
  return out + " }";
}

function arm_expr_value(body: ast.Stmt[], v: string, depth: i32): string {
  if (body.len() == 0) {
    return "";
  }
  let last: ast.Stmt = body[body.len() - 1];
  let tail: string = "";
  if (v.len() == 0) {
    if (body.len() > 1 && parser.branch_stmts_diverge([body[body.len() - 2]])) {
      return print_value_block(body, tail_expr(last), false, depth);
    }
    tail = print_return_only([last], depth);
  } else {
    let set: AssignParts = assign_parts(last);
    if (!set.ok || print_expr(set.place, depth) != v) {
      if (parser.branch_stmts_diverge(body)) {
        return print_value_block(body.append(last), tail_expr(last), false, depth);
      }
      return "";
    }
    tail = print_expr(set.value, depth);
  }
  if (tail.len() == 0) {
    return "";
  }
  if (body.len() == 1) {
    return tail;
  }
  let value: ast.Expr = tail_expr(last);
  if (v.len() > 0) {
    value = assign_parts(last).value;
  }
  return print_value_block(body, value, true, depth);
}

function print_value_block(body: ast.Stmt[], tail: ast.Expr, show_tail: boolean, depth: i32): string {
  let inline: string = "{ ";
  let lines: boolean = false;
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    let text: string = print_stmt_inline(body[i], 0);
    lines = lines || util.contains(text, "\n");
    inline = inline + text + " ";
    i = i + 1;
  }
  if (!lines) {
    if (show_tail) {
      inline = inline + print_expr(tail, depth) + " ";
    }
    return inline + "}";
  }
  let out: string = "{\n";
  i = 0;
  while (i + 1 < body.len()) {
    let (text, _) = print_stmt_body(body[i], depth + 1, empty_fmt());
    out = out + indent_str(depth + 1) + text + "\n";
    i = i + 1;
  }
  if (show_tail) {
    out = out + indent_str(depth + 1) + print_expr(tail, depth + 1) + "\n";
  }
  return out + indent_str(depth) + "}";
}

function print_expr_prec(e: ast.Expr, parent_prec: i32, depth: i32): string {
  let (text, _) = print_expr_c(e, parent_prec, depth, empty_fmt());
  return text;
}

function print_expr_c(e: ast.Expr, parent_prec: i32, depth: i32, f: Fmt): (string, Fmt) {
  match (e) {
    ast.ExprBytes(bs) => {
      let out: string = "[";
      let i: i32 = 0;
      while (i < bs.value.len()) {
        if (i > 0) {
          out = out + ", ";
        }
        out = out + util.i32_to_string(bs.value[i] as i32) + "u8";
        i = i + 1;
      }
      return (out + "]", f);
    },
    ast.ExprNumber(n) => {
      if (n.raw.len() > 0) {
        return (n.raw, f);
      }
      if (n.suffix.len() > 0) {
        return (n.text + n.suffix, f);
      }
      return (n.text, f);
    },
    ast.ExprIdent(id) => {
      return (id.name, f);
    },
    ast.ExprString(s) => {
      return (quote_string(s.value), f);
    },
    ast.ExprBool(b) => {
      if (b.value) {
        return ("true", f);
      }
      return ("false", f);
    },
    ast.ExprBinary(b) => {
      if (b.op == "__named_arg") {
        let (nl, nf) = print_expr_c(b.left, prec_lowest(), depth, f);
        let (nr, nf2) = print_expr_c(b.right, prec_lowest(), depth, nf);
        return (nl + " = " + nr, nf2);
      }
      let p: i32 = binary_prec(b.op);
      let (bl, bf) = print_expr_c(b.left, p, depth, f);
      let gap: string = " ";
      if (written_break(b)) {
        let (tr, tf) = emit_trailing(bf, last_line(b.left));
        let lead: string = "";
        if (tf.ci < tf.comments.len() && tf.comments[tf.ci].line > first_line(b.left)) {
          let (ld, lf) = drain_leading(tf, b.line, depth + 1);
          lead = ld;
          tf = lf;
        }
        gap = tr + "\n" + lead + indent_str(depth + 1);
        bf = tf;
      }
      let (br, bf2) = print_expr_c(b.right, p + 1, depth, bf);
      let inner: string = bl + gap + b.op + " " + br;
      if (p < parent_prec) {
        return ("(" + inner + ")", bf2);
      }
      return (inner, bf2);
    },
    ast.ExprUnary(u) => {
      // Both cast forms are written after their operand. The checked form
      // uses the same precedence and parentheses as a plain cast.
      let checked_cast: boolean = u.op.len() > 4 && util.str_has_prefix(u.op, "as?_");
      if (checked_cast || u.op.len() > 3 && util.str_has_prefix(u.op, "as_")) {
        let (co, cf) = print_expr_c(u.operand, prec_cast(), depth, f);
        let start: i32 = 3;
        let cast_op: string = " as ";
        if (checked_cast) {
          start = 4;
          cast_op = " as? ";
        }
        let cinner: string = co + cast_op + slice_unchecked(u.op, start, u.op.len());
        if (parent_prec >= prec_cast()) {
          return ("(" + cinner + ")", cf);
        }
        return (cinner, cf);
      }
      if (u.op == "try_") {
        let (to, tf) = print_expr_c(u.operand, prec_unary(), depth, f);
        return (to + "?", tf);
      }
      let (uo, uf) = print_expr_c(u.operand, prec_unary(), depth, f);
      let uinner: string = u.op + uo;
      if (parent_prec >= prec_unary()) {
        return ("(" + uinner + ")", uf);
      }
      return (uinner, uf);
    },
    ast.ExprCall(c) => {
      let blk: string = print_block_expr(c, parent_prec, depth);
      if (blk.len() > 0) {
        return (blk, f);
      }
      let vl: string = print_value_local_iife(c, depth);
      if (vl.len() > 0) {
        return (vl, f);
      }
      let iife: string = print_expr_iife(c, parent_prec, depth);
      if (iife.len() > 0) {
        return (iife, f);
      }
      let (callee, cf) = print_expr_c(c.callee, prec_primary(), depth, f);
      let (args, af) = print_list(c.args, ast.expr_line(e), "", depth, cf);
      return (callee + "(" + args + ")", af);
    },
    ast.ExprArray(a) => {
      let (elems, af) = print_list(a.elements, a.line, "", depth, f);
      return ("[" + elems + "]", af);
    },
    ast.ExprTuple(t) => {
      let out: string = "(";
      let i: i32 = 0;
      while (i < t.elements.len()) {
        if (i > 0) {
          out = out + ", ";
        }
        out = out + print_expr(t.elements[i], depth);
        i = i + 1;
      }
      return (out + ")", f);
    },
    ast.ExprIndex(x) => {
      let (xa, xf) = print_expr_c(x.array, prec_primary(), depth, f);
      let (xi, xf2) = print_expr_c(x.index, prec_lowest(), depth, xf);
      return (xa + "[" + xi + "]", xf2);
    },
    ast.ExprSlice(sl) => {
      let lo: string = "";
      if (!sl.open_start) {
        lo = print_expr(sl.start, depth);
      }
      let hi: string = "";
      if (!sl.open_end) {
        hi = print_expr(sl.end, depth);
      }
      return (print_expr_prec(sl.array, prec_primary(), depth) + "[" + lo + ":" + hi + "]", f);
    },
    ast.ExprStructLit(sl) => {
      let vals: ast.Expr[] = [];
      let prefixes: string[] = [];
      if (sl.has_base) {
        vals = vals.append(sl.base);
        prefixes = prefixes.append("...");
      }
      let i: i32 = 0;
      while (i < sl.field_names.len()) {
        vals = vals.append(sl.field_values[i]);
        prefixes = prefixes.append(sl.field_names[i] + ": ");
        i = i + 1;
      }
      let lns: i32[] = elem_lines(vals, sl.line);
      if (vals.len() > 0 && keep_list_lines(f, sl.line, lns[lns.len() - 1])) {
        let (lines, lf) = print_list_lines(vals, lns, prefixes, depth, f);
        return (sl.type_name + " {" + lines + indent_str(depth) + "}", lf);
      }
      let (flds, ff) = print_list_flat(vals, prefixes, depth, f);
      return (sl.type_name + " { " + flds + " }", ff);
    },
    ast.ExprFieldAccess(fa) => {
      let (fo, ff) = print_expr_c(fa.obj, prec_primary(), depth, f);
      return (fo + "." + fa.field, ff);
    },
    ast.ExprLambda(lm) => {
      let (pats, npre) = param_patterns_for(lm.params, lm.body);
      let out: string = print_params_with(lm.params, pats, false, depth);
      if (lm.ret_type.len() > 0) {
        out = out + ": " + arrow_return_type(lm.ret_type);
      }
      out = out + " => ";
      let body: ast.Stmt[] = drop_prelude(lm.body, npre);
      let av: string = print_return_only(body, depth);
      if (av.len() > 0) {
        out = out + av;
      } else if (body.len() == 1 && stmt_is_single_line(body[0])) {
        out = out + "{ " + print_stmt_inline(body[0], depth) + " }";
      } else {
        let (lam_body, _) = print_block(body, depth, empty_fmt());
        out = out + lam_body;
      }
      if (parent_prec > prec_assign()) {
        return ("(" + out + ")", f);
      }
      return (out, f);
    },
    ast.ExprFString(fs) => {
      let out: string = "f\"";
      let i: i32 = 0;
      while (i < fs.lits.len()) {
        if (fs.is_expr[i]) {
          out = out + "{" + print_expr(fs.exprs[i], depth) + "}";
        } else {
          out = out + escape_fstring_lit(fs.lits[i]);
        }
        i = i + 1;
      }
      return (out + "\"", f);
    },
    ast.ExprMapLit(ml) => {
      let out: string = "Map {";
      let i: i32 = 0;
      while (i < ml.keys.len()) {
        if (i > 0) {
          out = out + ",";
        }
        out = out + " " + print_expr(ml.keys[i], depth) + ": " + print_expr(ml.vals[i], depth);
        i = i + 1;
      }
      return (out + " }", f);
    },
    ast.ExprUnknown(_) => {
      return ("", f);
    },
    ast.ExprZero(z) => {
      return ("/*zero:" + z.type_name + "*/", f);
    }
  }
}

function elem_line(e: ast.Expr, prev: i32): i32 {
  let ln: i32 = first_line(e);
  if (ln == 0) {
    return prev;
  }
  return ln;
}

function elem_lines(elems: ast.Expr[], open_line: i32): i32[] {
  let out: i32[] = [];
  let prev: i32 = open_line;
  for x in elems {
    prev = elem_line(x, prev);
    out = out.append(prev);
  }
  return out;
}

function print_list(elems: ast.Expr[], open_line: i32, prefix: string, depth: i32, f: Fmt): (string, Fmt) {
  let prefixes: string[] = [];
  for x in elems {
    prefixes = prefixes.append(prefix);
  }
  let lns: i32[] = elem_lines(elems, open_line);
  if (elems.len() > 0 && keep_list_lines(f, open_line, lns[lns.len() - 1])) {
    let (lines, lf) = print_list_lines(elems, lns, prefixes, depth, f);
    return (lines + indent_str(depth), lf);
  }
  return print_list_flat(elems, prefixes, depth, f);
}

function print_list_flat(elems: ast.Expr[], prefixes: string[], depth: i32, f: Fmt): (string, Fmt) {
  let out: string = "";
  let g: Fmt = f;
  let i: i32 = 0;
  while (i < elems.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    let (t, g2) = print_expr_c(elems[i], prec_lowest(), depth, g);
    out = out + prefixes[i] + t;
    g = g2;
    i = i + 1;
  }
  return (out, g);
}

function print_list_lines(elems: ast.Expr[], lns: i32[], prefixes: string[], depth: i32, f: Fmt): (string, Fmt) {
  let out: string = "\n";
  let g: Fmt = f;
  let i: i32 = 0;
  while (i < elems.len()) {
    let ln: i32 = lns[i];
    let (lead, g1) = drain_leading(g, ln, depth + 1);
    out = out + lead + indent_str(depth + 1);
    g = g1;
    let j: i32 = i;
    while (j < elems.len() && (j == i || lns[j] == ln)) {
      if (j > i) {
        out = out + ", ";
      }
      let (t, g2) = print_expr_c(elems[j], prec_lowest(), depth + 1, g);
      out = out + prefixes[j] + t;
      g = g2;
      j = j + 1;
    }
    let (trail, g3) = emit_trailing(g, ln);
    out = out + "," + trail + "\n";
    g = g3;
    i = j;
  }
  return (out, g);
}

function indent_str(depth: i32): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < depth) {
    out = out + "  ";
    i = i + 1;
  }
  return out;
}

struct Fmt { comments: lexer.Comment[], ci: i32, blanks: boolean[], spans: parser.BlockSpans, si: i32 }

function empty_fmt(): Fmt {
  return Fmt { comments: [], ci: 0, blanks: [], spans: no_spans(), si: 0 };
}

function no_spans(): parser.BlockSpans {
  return parser.BlockSpans { opens: [], firsts: [], closes: [] };
}

function take_span(f: Fmt, first: i32): (i32, i32, Fmt) {
  if (first <= 0) {
    return (0, 0, f);
  }
  let i: i32 = f.si;
  while (i < f.spans.firsts.len()) {
    if (f.spans.firsts[i] == first) {
      return (f.spans.opens[i], f.spans.closes[i], Fmt { ...f, si: i + 1 });
    }
    i = i + 1;
  }
  return (0, 0, f);
}

function (f: Fmt) blank_at(line: i32): boolean {
  if (line < 0 || line >= f.blanks.len()) {
    return false;
  }
  return f.blanks[line];
}

function (f: Fmt) blank_before(line: i32): boolean {
  let top: i32 = line;
  if (f.ci < f.comments.len() && f.comments[f.ci].line < line) {
    top = f.comments[f.ci].line;
  }
  return f.blank_at(top - 1);
}

function drain_leading(f: Fmt, line: i32, depth: i32): (string, Fmt) {
  let out: string = "";
  let g: Fmt = f;
  let last: i32 = 0;
  while (g.ci < g.comments.len() && g.comments[g.ci].line < line) {
    if (last > 0 && g.blank_at(g.comments[g.ci].line - 1)) {
      out = out + "\n";
    }
    last = g.comments[g.ci].line;
    out = out + indent_str(depth) + "//" + g.comments[g.ci].text + "\n";
    g = Fmt { ...g, ci: g.ci + 1 };
  }
  return (out, g);
}

function drain_decl_leading(f: Fmt, line: i32): (string, Fmt) {
  let chunks: string[] = [];
  let g: Fmt = f;
  let last: i32 = 0;
  while (g.ci < g.comments.len() && g.comments[g.ci].line < line) {
    if (last > 0 && g.blank_at(g.comments[g.ci].line - 1)) {
      chunks = chunks.append("\n");
    }
    last = g.comments[g.ci].line;
    chunks = chunks.append("//" + g.comments[g.ci].text + "\n");
    g = Fmt { ...g, ci: g.ci + 1 };
  }
  if (last > 0 && g.blank_at(last + 1)) {
    chunks = chunks.append("\n");
  }
  return (util.str_join_chunks(chunks), g);
}

function emit_trailing(f: Fmt, line: i32): (string, Fmt) {
  if (f.ci < f.comments.len() && f.comments[f.ci].line == line && f.comments[f.ci].trailing) {
    return ("  //" + f.comments[f.ci].text, Fmt { ...f, ci: f.ci + 1 });
  }
  return ("", f);
}

function written_break(b: ast.ExprBinary): boolean {
  if (b.line == 0) {
    return false;
  }
  let left: i32 = last_line(b.left);
  return left > 0 && b.line > left || first_line(b.right) > b.line;
}

function first_line(e: ast.Expr): i32 {
  match (e) {
    ast.ExprBinary(b) => {
      return first_line(b.left);
    },
    ast.ExprCall(c) => {
      return first_line(c.callee);
    },
    ast.ExprIndex(ix) => {
      return first_line(ix.array);
    },
    ast.ExprSlice(sl) => {
      return first_line(sl.array);
    },
    ast.ExprFieldAccess(fa) => {
      return first_line(fa.obj);
    },
    ast.ExprUnary(u) => {
      if (is_postfix_unary(u.op)) {
        return first_line(u.operand);
      }
      return u.line;
    },
    _ => {
      return ast.expr_line(e);
    }
  }
  return ast.expr_line(e);
}

function is_postfix_unary(op: string): boolean {
  return util.str_has_prefix(op, "as_") || util.str_has_prefix(op, "as?_") || op == "try_";
}

function last_line(e: ast.Expr): i32 {
  let ln: i32 = ast.expr_line(e);
  match (e) {
    ast.ExprBinary(b) => {
      return max_line(max_line(ln, last_line(b.left)), last_line(b.right));
    },
    ast.ExprUnary(u) => {
      return max_line(ln, last_line(u.operand));
    },
    ast.ExprCall(c) => {
      return max_line(max_line(ln, last_line(c.callee)), last_line_of(c.args)) + list_closer(c.line, c.args);
    },
    ast.ExprArray(a) => {
      return max_line(ln, last_line_of(a.elements)) + list_closer(a.line, a.elements);
    },
    ast.ExprTuple(t) => {
      return max_line(ln, last_line_of(t.elements));
    },
    ast.ExprIndex(ix) => {
      return max_line(max_line(ln, last_line(ix.array)), last_line(ix.index));
    },
    ast.ExprSlice(sl) => {
      return max_line(max_line(max_line(ln, last_line(sl.array)), last_line(sl.start)), last_line(sl.end));
    },
    ast.ExprStructLit(st) => {
      let vals: ast.Expr[] = [];
      if (st.has_base) {
        vals = vals.append(st.base);
      }
      for v in st.field_values {
        vals = vals.append(v);
      }
      return max_line(ln, last_line_of(vals)) + list_closer(st.line, vals);
    },
    ast.ExprFieldAccess(fa) => {
      return max_line(ln, last_line(fa.obj));
    },
    ast.ExprMapLit(ml) => {
      return max_line(max_line(ln, last_line_of(ml.keys)), last_line_of(ml.vals));
    },
    _ => {
      return ln;
    }
  }
  return ln;
}

function list_closer(open: i32, es: ast.Expr[]): i32 {
  if (open <= 0 || es.len() == 0) {
    return 0;
  }
  let lns: i32[] = elem_lines(es, open);
  if (lns[lns.len() - 1] > open) {
    return 1;
  }
  return 0;
}

function last_line_of(es: ast.Expr[]): i32 {
  let m: i32 = 0;
  for x in es {
    m = max_line(m, last_line(x));
  }
  return m;
}

function max_line(a: i32, b: i32): i32 {
  if (a > b) {
    return a;
  }
  return b;
}

function keep_list_lines(f: Fmt, open: i32, last: i32): boolean {
  return open > 0 && last > open || inner_comment_pending(f, open, last);
}

function inner_comment_pending(f: Fmt, decl_line: i32, last: i32): boolean {
  let i: i32 = f.ci;
  while (i < f.comments.len()) {
    let ln: i32 = f.comments[i].line;
    if (ln > last) {
      return false;
    }
    if (ln > decl_line) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function field_lines_for(flines: parser.FieldLines[], name: string, decl_line: i32): i32[] {
  let i: i32 = 0;
  while (i < flines.len()) {
    if (flines[i].name == name && flines[i].decl_line == decl_line) {
      return flines[i].lines;
    }
    i = i + 1;
  }
  let none: i32[] = [];
  return none;
}

function drain_all(f: Fmt, depth: i32, wrote: boolean): (string, Fmt) {
  let out: string = "";
  let g: Fmt = f;
  let last: i32 = 0;
  while (g.ci < g.comments.len()) {
    if (g.blank_at(g.comments[g.ci].line - 1) && (last > 0 || wrote)) {
      out = out + "\n";
    }
    last = g.comments[g.ci].line;
    out = out + indent_str(depth) + "//" + g.comments[g.ci].text + "\n";
    g = Fmt { ...g, ci: g.ci + 1 };
  }
  return (out, g);
}

function print_block(body: ast.Stmt[], depth: i32, f: Fmt): (string, Fmt) {
  if (body.len() == 0) {
    return ("{}", f);
  }
  let (open_line, close_line, g) = take_span(f, ast.stmt_line(body[0]));
  let out: string = "{";
  if (open_line > 0) {
    let (tc, gt) = emit_trailing(g, open_line);
    out = out + tc;
    g = gt;
  }
  out = out + "\n";
  let i: i32 = 0;
  while (i < body.len()) {
    let ln: i32 = ast.stmt_line(body[i]);
    if (i > 0 && ln > 0 && g.blank_before(ln)) {
      out = out + "\n";
    }
    if (ln > 0) {
      let (lead, g1) = drain_leading(g, ln, depth + 1);
      out = out + lead;
      g = g1;
    }
    let (body_text, g2) = print_stmt(body[i], depth + 1, g);
    out = out + body_text;
    g = g2;
    i = i + 1;
  }
  if (close_line > 0) {
    let (tail, gc) = drain_leading(g, close_line, depth + 1);
    out = out + tail;
    g = gc;
  }
  out = out + indent_str(depth) + "}";
  return (out, g);
}

function print_pattern(pat: ast.Pattern): string {
  return print_pattern_ctx(pat, false);
}

function print_pattern_ctx(pat: ast.Pattern, always_parens: boolean): string {
  match (pat) {
    ast.PatWildcard(_) => {
      return "_";
    },
    ast.PatVariant(pv) => {
      let head: string = pv.type_name;
      if (pv.at_binding.len() > 0) {
        head = pv.at_binding + " @ " + pv.type_name;
      }
      if (parser.is_record_pattern(pv)) {
        return head + " " + print_record_fields(pv);
      }
      if (pv.nested.len() > 0) {
        let np: string = head + "(";
        let ni: i32 = 0;
        while (ni < pv.nested.len()) {
          if (ni > 0) {
            np = np + ", ";
          }
          if (pv_pattern_name(pv.nested[ni]).len() > 0) {
            np = np + print_pattern_ctx(pv.nested[ni], true);
          } else {
            np = np + payload_slot(pv, nested_slot_binder(pv, ni));
          }
          ni = ni + 1;
        }
        return np + ")";
      }
      if (pv.tup_kinds.len() > 0) {
        return head + "(" + print_tuple_elems(pv.tup_kinds, pv.tup_binds, pv.tup_lits, pv.tup_pats) + ")";
      }
      if (pv.binding.len() == 0) {
        if (always_parens) {
          return head + "()";
        }
        return head;
      }
      let out: string = head + "(" + payload_slot(pv, pv.binding);
      let i: i32 = 0;
      while (i < pv.extra_bindings.len()) {
        out = out + ", " + payload_slot(pv, pv.extra_bindings[i]);
        i = i + 1;
      }
      return out + ")";
    }
  }
  return "_";
}

function pv_pattern_name(pat: ast.Pattern): string {
  match (pat) {
    ast.PatVariant(v) => {
      return v.type_name;
    },
    ast.PatWildcard(_) => {
      return "";
    }
  }
  return "";
}

function nested_slot_binder(pv: ast.PatVariant, i: i32): string {
  if (i == 0) {
    return pv.binding;
  }
  if (i - 1 < pv.extra_bindings.len()) {
    return pv.extra_bindings[i - 1];
  }
  return "";
}

function range_pair(lo: ast.Expr, hi: ast.Expr, binder: string): string {
  match (lo) {
    ast.ExprBinary(lb) => {
      if (lb.op != ">=") {
        return "";
      }
      match (lb.left) {
        ast.ExprIdent(li) => {
          if (li.name != binder) {
            return "";
          }
        },
        _ => {
          return "";
        }
      }
      match (hi) {
        ast.ExprBinary(hb) => {
          if (hb.op != "<" && hb.op != "<=") {
            return "";
          }
          match (hb.left) {
            ast.ExprIdent(hri) => {
              if (hri.name != binder) {
                return "";
              }
            },
            _ => {
              return "";
            }
          }
          let sep: string = "..";
          if (hb.op == "<=") {
            sep = "..=";
          }
          return print_lit(lb.right) + sep + print_lit(hb.right);
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
  return "";
}

function range_slot_for(cond: ast.Expr, binder: string): string {
  match (cond) {
    ast.ExprBinary(b) => {
      if (b.op != "&&") {
        return "";
      }
      let here: string = range_pair(b.left, b.right, binder);
      if (here.len() > 0) {
        return here;
      }
      let l: string = range_slot_for(b.left, binder);
      if (l.len() > 0) {
        return l;
      }
      return range_slot_for(b.right, binder);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function payload_slot(pv: ast.PatVariant, binder: string): string {
  if (!pv.has_lit_cond) {
    return binder;
  }
  let rng: string = range_slot_for(pv.lit_cond, binder);
  if (rng.len() > 0) {
    return rng;
  }
  let lit: ast.Expr = lit_cond_for(pv.lit_cond, binder);
  if (expr_is_missing(lit)) {
    return binder;
  }
  return print_lit(lit);
}

function lit_cond_for(cond: ast.Expr, binder: string): ast.Expr {
  match (cond) {
    ast.ExprBinary(b) => {
      if (b.op == "&&") {
        let left: ast.Expr = lit_cond_for(b.left, binder);
        if (!expr_is_missing(left)) {
          return left;
        }
        return lit_cond_for(b.right, binder);
      }
      if (b.op == "==") {
        match (b.left) {
          ast.ExprIdent(id) => {
            if (id.name == binder) {
              return b.right;
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  return parser.e_unknown("");
}

function print_tuple_elem(kind: i32, bind: string, lit: ast.Expr, pat: ast.Pattern): string {
  if (kind == 1) {
    return "_";
  }
  if (kind == 2) {
    return print_lit(lit);
  }
  if (kind == 3) {
    return print_pattern_ctx(pat, true);
  }
  if (kind == 4) {
    let (nk, nb, nl, np) = parser.pv_tup(pat);
    return print_tuple_elems(nk, nb, nl, np);
  }
  return bind;
}

function print_tuple_elems(kinds: i32[], binds: string[], lits: ast.Expr[], pats: ast.Pattern[]): string {
  let out: string = "(";
  let i: i32 = 0;
  while (i < kinds.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    out = out + print_tuple_elem(kinds[i], binds[i], lits[i], pats[i]);
    i = i + 1;
  }
  return out + ")";
}

function print_tup_arm(a: ast.TupArm): string {
  if (a.is_wild) {
    if (a.at_binding.len() > 0) {
      return a.at_binding + " @ _";
    }
    return "_";
  }
  let pat: string = print_tuple_elems(a.elem_kinds, a.binds, a.lits, a.elem_pats);
  if (a.at_binding.len() > 0) {
    return a.at_binding + " @ " + pat;
  }
  return pat;
}

function print_record_fields(pv: ast.PatVariant): string {
  let out: string = "{ ";
  let i: i32 = 0;
  while (i < pv.field_names.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    let field: string = pv.field_names[i];
    let slot: string = payload_slot(pv, nested_slot_binder(pv, i));
    if (i < pv.nested.len() && pv_pattern_name(pv.nested[i]).len() > 0) {
      slot = print_pattern_ctx(pv.nested[i], true);
    }
    out = out + field;
    if (slot != field) {
      out = out + ": " + slot;
    }
    i = i + 1;
  }
  return out + rest_suffix(pv.rest_written, pv.field_names.len()) + " }";
}

function rest_suffix(rest_written: boolean, n: i32): string {
  if (!rest_written) {
    return "";
  }
  if (n > 0) {
    return ", ..";
  }
  return "..";
}

function print_struct_arm(a: ast.StructArm): string {
  if (a.is_wild) {
    if (a.at_binding.len() > 0) {
      return a.at_binding + " @ _";
    }
    return "_";
  }
  let out: string = a.type_name + " { ";
  let i: i32 = 0;
  while (i < a.fields.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    out = out + a.fields[i];
    if (a.field_kinds[i] == 2) {
      out = out + ": " + print_lit(a.field_lits[i]);
    } else if (a.field_kinds[i] == 3) {
      out = out + ": " + print_pattern_ctx(a.field_pats[i], true);
    } else if (a.binds[i] != a.fields[i]) {
      out = out + ": " + a.binds[i];
    }
    i = i + 1;
  }
  out = out + rest_suffix(a.rest_written, a.fields.len());
  out = out + " }";
  if (a.at_binding.len() > 0) {
    return a.at_binding + " @ " + out;
  }
  return out;
}

struct WrittenArm { head: string, body: ast.Stmt[], guard: ast.Expr, has_guard: boolean }

function sugar_written_arms(sg: ast.MatchSugar): WrittenArm[] {
  let out: WrittenArm[] = [];
  let i: i32 = 0;
  if (sg.arms.len() > 0) {
    while (i < sg.arms.len()) {
      let a: ast.MatchArm = sg.arms[i];
      let ahead: string = print_pattern(a.pattern);
      while (i + 1 < sg.arms.len() && sg.arms[i + 1].alt_cont) {
        i = i + 1;
        ahead = ahead + " | " + print_pattern(sg.arms[i].pattern);
      }
      out = out.append(WrittenArm { head: ahead, body: a.body, guard: a.guard, has_guard: a.has_guard });
      i = i + 1;
    }
    return out;
  }
  let n: i32 = sg.tup.len() + sg.strct.len() + sg.lits.len();
  while (i < n) {
    let head: string = "";
    let body: ast.Stmt[] = [];
    let guard: ast.Expr = parser.e_bool(true);
    let has_guard: boolean = false;
    if (sg.tup.len() > 0) {
      head = print_tup_arm(sg.tup[i]);
      body = sg.tup[i].body;
      guard = sg.tup[i].guard;
      has_guard = sg.tup[i].has_guard;
      while (i + 1 < n && sg.tup[i + 1].alt_cont) {
        i = i + 1;
        head = head + " | " + print_tup_arm(sg.tup[i]);
      }
    } else {
      if (sg.strct.len() > 0) {
        head = print_struct_arm(sg.strct[i]);
        body = sg.strct[i].body;
        guard = sg.strct[i].guard;
        has_guard = sg.strct[i].has_guard;
      } else {
        head = print_lit_pat(sg.lits[i]);
        body = sg.lits[i].body;
        guard = sg.lits[i].guard;
        has_guard = sg.lits[i].has_guard;
        while (i + 1 < n && sg.lits[i + 1].alt_cont) {
          i = i + 1;
          head = head + " | " + print_lit_pat(sg.lits[i]);
        }
      }
    }
    out = out.append(WrittenArm { head: head, body: body, guard: guard, has_guard: has_guard });
    i = i + 1;
  }
  return out;
}

function print_sugared_match(sg: ast.MatchSugar, depth: i32, f: Fmt): (string, Fmt) {
  let pad: string = indent_str(depth);
  let arms: WrittenArm[] = sugar_written_arms(sg);
  let out: string = "match (" + print_expr(sg.scrut, depth) + ") {\n";
  let g: Fmt = f;
  let i: i32 = 0;
  while (i < arms.len()) {
    let (arm_body, g1) = print_block(arms[i].body, depth + 1, g);
    g = g1;
    out = out + indent_str(depth + 1) + arms[i].head;
    if (arms[i].has_guard) {
      out = out + " when " + print_expr(arms[i].guard, depth);
    }
    out = out + " => " + arm_body;
    if (i + 1 < arms.len()) {
      out = out + ",";
    }
    out = out + "\n";
    i = i + 1;
  }
  return (out + pad + "}", g);
}

function print_sugared_let_else(sg: ast.MatchSugar, depth: i32, f: Fmt): (string, Fmt) {
  let arms: WrittenArm[] = sugar_written_arms(sg);
  if (arms.len() < 2) {
    return print_sugared_match(sg, depth, f);
  }
  let g: Fmt = f;
  let (els, g1) = print_block(arms[arms.len() - 1].body, depth, g);
  g = g1;
  let head: string = "";
  let hi: i32 = 0;
  while (hi + 1 < arms.len()) {
    if (hi > 0) {
      head = head + " | ";
    }
    head = head + arms[hi].head;
    hi = hi + 1;
  }
  let out: string = "let " + head + " = " + print_expr(sg.scrut, depth) + " else " + els + ";";
  let rest: ast.Stmt[] = arms[0].body;
  let i: i32 = 0;
  while (i < rest.len()) {
    let ln: i32 = ast.stmt_line(rest[i]);
    out = out + "\n";
    if (ln > 0 && g.blank_before(ln)) {
      out = out + "\n";
    }
    if (ln > 0) {
      let (lead, gl) = drain_leading(g, ln, depth);
      out = out + lead;
      g = gl;
    }
    let (stext, g2) = print_stmt_line(rest[i], depth, g);
    out = out + stext;
    g = g2;
    i = i + 1;
  }
  return (out, g);
}

function print_sugared_if_let(sg: ast.MatchSugar, depth: i32, f: Fmt): (string, Fmt) {
  let arms: WrittenArm[] = sugar_written_arms(sg);
  if (arms.len() < 2) {
    return print_sugared_match(sg, depth, f);
  }
  let g: Fmt = f;
  let (then_block, g1) = print_block(arms[0].body, depth, g);
  g = g1;
  let out: string = "if let ";
  let i: i32 = 0;
  while (i + 1 < arms.len()) {
    if (i > 0) {
      out = out + " | ";
    }
    out = out + arms[i].head;
    i = i + 1;
  }
  out = out + " = " + print_expr(sg.scrut, depth) + " " + then_block;
  let (else_text, g2) = print_else(arms[arms.len() - 1].body, sg.else_chained, depth, g);
  return (out + else_text, g2);
}

function print_lit_pat(a: ast.LitArm): string {
  if (a.is_wild) {
    return "_";
  }
  if (a.at_binding.len() > 0 && !a.alt_cont) {
    return a.at_binding + " @ " + print_lit_pat(ast.LitArm { ...a, at_binding: "" });
  }
  if (a.has_range) {
    let dots: string = "..";
    if (a.range_inclusive) {
      dots = "..=";
    }
    return print_lit(a.lit) + dots + print_lit(a.range_hi);
  }
  return print_lit(a.lit);
}

function print_match(m: ast.StmtMatch, depth: i32, f: Fmt): (string, Fmt) {
  let pad: string = indent_str(depth);
  let out: string = "match (" + print_expr(m.scrutinee, depth) + ") {\n";
  let g: Fmt = f;
  let arms: ast.MatchArm[] = m.arms;
  if (m.sugar.len() > 0) {
    arms = m.sugar;
  }
  let i: i32 = 0;
  while (i < arms.len()) {
    let (arm_body, g1) = print_block(arms[i].body, depth + 1, g);
    g = g1;
    let head: string = print_pattern(arms[i].pattern);
    let guarded: ast.MatchArm = arms[i];
    while (i + 1 < arms.len() && arms[i + 1].alt_cont) {
      i = i + 1;
      head = head + " | " + print_pattern(arms[i].pattern);
    }
    out = out + indent_str(depth + 1) + head;
    if (guarded.has_guard) {
      out = out + " when " + print_expr(guarded.guard, depth);
    }
    out = out + " => " + arm_body;
    if (i + 1 < arms.len()) {
      out = out + ",";
    }
    out = out + "\n";
    i = i + 1;
  }
  return (out + pad + "}", g);
}

function print_if_let(m: ast.StmtMatch, depth: i32, f: Fmt): (string, Fmt) {
  let arms: ast.MatchArm[] = m.arms;
  if (m.sugar.len() > 0) {
    arms = m.sugar;
  }
  let g: Fmt = f;
  let (then_block, g1) = print_block(arms[0].body, depth, g);
  g = g1;
  let out: string = "if let ";
  let i: i32 = 0;
  while (i + 1 < arms.len()) {
    if (i > 0) {
      out = out + " | ";
    }
    out = out + print_pattern(arms[i].pattern);
    i = i + 1;
  }
  out = out + " = " + print_expr(m.scrutinee, depth) + " " + then_block;
  let (else_text, g2) = print_else(arms[arms.len() - 1].body, m.else_chained, depth, g);
  return (out + else_text, g2);
}

function print_let_else(m: ast.StmtMatch, depth: i32, f: Fmt): (string, Fmt) {
  let arms: ast.MatchArm[] = m.arms;
  if (m.sugar.len() > 0) {
    arms = m.sugar;
  }
  let g: Fmt = f;
  let (els, g1) = print_block(arms[arms.len() - 1].body, depth, g);
  g = g1;
  let head: string = "";
  let hi: i32 = 0;
  while (hi + 1 < arms.len()) {
    if (hi > 0) {
      head = head + " | ";
    }
    head = head + print_pattern(arms[hi].pattern);
    hi = hi + 1;
  }
  let out: string = "let " + head + " = " + print_expr(m.scrutinee, depth) + " else " + els + ";";
  let rest: ast.Stmt[] = arms[0].body;
  let i: i32 = 0;
  while (i < rest.len()) {
    let ln: i32 = ast.stmt_line(rest[i]);
    out = out + "\n";
    if (ln > 0 && g.blank_before(ln)) {
      out = out + "\n";
    }
    if (ln > 0) {
      let (lead, gl) = drain_leading(g, ln, depth);
      out = out + lead;
      g = gl;
    }
    let (stext, g2) = print_stmt_line(rest[i], depth, g);
    out = out + stext;
    g = g2;
    i = i + 1;
  }
  return (out, g);
}

struct UseSugar { ok: boolean, name: string, type_name: string, call: ast.Expr, body: ast.Stmt[] }

function as_use(e: ast.Expr): UseSugar {
  let none: UseSugar = UseSugar { ok: false, name: "", type_name: "", call: e, body: [] };
  if let ast.ExprCall(c) = e {
    if (c.args.len() == 0) {
      return none;
    }
    if let ast.ExprLambda(lm) = c.args[c.args.len() - 1] {
      if (lm.origin != parser.ORIGIN_USE || lm.params.len() != 1) {
        return none;
      }
      let written: ast.Expr[] = [];
      let i: i32 = 0;
      while (i + 1 < c.args.len()) {
        written = written.append(c.args[i]);
        i = i + 1;
      }
      let call: ast.Expr = ast.ExprCall { ...c, args: written };
      return UseSugar { ok: true, name: lm.params[0].name, type_name: lm.params[0].type_name, call: call, body: lm.body };
    }
  }
  return none;
}

function print_use(us: UseSugar, line: i32, depth: i32, f: Fmt): (string, Fmt) {
  let out: string = "use " + written_name(us.name);
  if (us.type_name.len() > 0) {
    out = out + ": " + us.type_name;
  }
  out = out + " <- " + print_expr(us.call, depth) + ";";
  let g: Fmt = f;
  if (line > 0) {
    let (tr, g0) = emit_trailing(g, line);
    out = out + tr;
    g = g0;
  }
  let i: i32 = 0;
  while (i < us.body.len()) {
    let ln: i32 = ast.stmt_line(us.body[i]);
    out = out + "\n";
    if (ln > 0 && g.blank_before(ln)) {
      out = out + "\n";
    }
    if (ln > 0) {
      let (lead, gl) = drain_leading(g, ln, depth);
      out = out + lead;
      g = gl;
    }
    let (stext, g2) = print_stmt_line(us.body[i], depth, g);
    out = out + stext;
    g = g2;
    i = i + 1;
  }
  return (out, g);
}

function expr_is_missing(e: ast.Expr): boolean {
  match (e) {
    ast.ExprUnknown(u) => {
      return u.kind.len() == 0 || u.kind == parser.BARE_RETURN || util.str_has_prefix(u.kind, "punct:");
    },
    _ => {
      return false;
    }
  }
  return false;
}

function stmt_is_single_line(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtReturn(r) => {
      return !as_use(r.value).ok;
    },
    ast.StmtVar(_) => {
      return true;
    },
    ast.StmtExpr(_) => {
      return true;
    },
    ast.StmtAssign(_) => {
      return true;
    },
    ast.StmtBreak(_) => {
      return true;
    },
    ast.StmtContinue(_) => {
      return true;
    },
    ast.StmtDefer(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function print_assert(ifs: ast.StmtIf, depth: i32, f: Fmt): (string, Fmt) {
  let cond: ast.Expr = ifs.cond;
  if let ast.ExprUnary(u) = ifs.cond {
    cond = u.operand;
  }
  let (cs, cf) = print_expr_c(cond, prec_lowest(), depth, f);
  let out: string = "assert(" + cs;
  let g: Fmt = cf;
  if (ifs.then_body.len() > 0) {
    if let ast.StmtExpr(se) = ifs.then_body[0] {
      if let ast.ExprCall(c) = se.value {
        if (c.args.len() > 0) {
          if let ast.ExprBinary(b) = c.args[0] {
            let (ms, mf) = print_expr_c(b.right, prec_lowest(), depth, g);
            out = out + ", " + ms;
            g = mf;
          }
        }
      }
    }
  }
  return (out + ");", g);
}

function print_todo(body: ast.Stmt[], depth: i32, f: Fmt): (string, Fmt) {
  if (body.len() > 0) {
    if let ast.StmtExpr(se) = body[0] {
      if let ast.ExprCall(c) = se.value {
        if (c.args.len() > 0) {
          if let ast.ExprBinary(b) = c.args[0] {
            let (ms, mf) = print_expr_c(b.right, prec_lowest(), depth, f);
            return ("todo(" + ms + ");", mf);
          }
        }
      }
    }
  }
  return ("todo;", f);
}

function print_chain_assign(stmts: ast.Stmt[], depth: i32): string {
  let out: string = "";
  let i: i32 = stmts.len() - 1;
  while (i >= 0) {
    out = out + print_expr(assign_parts(stmts[i]).place, depth) + " = ";
    i = i - 1;
  }
  return out + print_expr(assign_parts(stmts[0]).value, depth) + ";";
}

struct AssignParts { place: ast.Expr, value: ast.Expr, ok: boolean }

function assign_parts(st: ast.Stmt): AssignParts {
  let none: AssignParts = AssignParts { place: parser.e_bool(true), value: parser.e_bool(true), ok: false };
  match (st) {
    ast.StmtAssign(a) => {
      return AssignParts { place: ast.ExprIdent { name: a.target, line: 0, col: 0, ty: "" }, value: a.value, ok: true };
    },
    ast.StmtExpr(x) => {
      if let ast.ExprCall(c) = x.value {
        if let ast.ExprIdent(callee) = c.callee {
          if (c.args.len() == 3 && callee.name == "__set_index") {
            return AssignParts { place: ast.ExprIndex { array: c.args[0], index: c.args[1], unchecked: false, ty: "", line: 0, col: 0 }, value: c.args[2], ok: true };
          }
          if (c.args.len() == 3 && callee.name == "__set_field") {
            if let ast.ExprString(field) = c.args[1] {
              return AssignParts { place: ast.ExprFieldAccess { obj: c.args[0], field: field.value, line: 0, col: 0, ty: "", const_read: false }, value: c.args[2], ok: true };
            }
          }
        }
      }
      return none;
    },
    _ => {
      return none;
    }
  }
}

function is_block_stmt(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtIf(ifs) => {
      return ifs.origin == "block";
    },
    _ => {
      return false;
    }
  }
}

function block_stmts(st: ast.Stmt): ast.Stmt[] {
  let none: ast.Stmt[] = [];
  match (st) {
    ast.StmtIf(ifs) => {
      return ifs.then_body;
    },
    _ => {
      return none;
    }
  }
}

function print_stmt_inline(st: ast.Stmt, depth: i32): string {
  let (text, _) = print_stmt_body(st, 0, empty_fmt());
  return text;
}

pub struct ForCSugar { init: ast.Stmt[], cond: ast.Expr, step: ast.Stmt[], body: ast.Stmt[], label: string, ok: boolean }

function no_c_for(): ForCSugar {
  let none: ast.Stmt[] = [];
  return ForCSugar { init: none, cond: ast.ExprBool { value: true, line: 0, col: 0 }, step: none, body: none, label: "", ok: false };
}

pub function as_c_for(ifs: ast.StmtIf): ForCSugar {
  if (!expr_is_true(ifs.cond) || ifs.else_body.len() != 0) {
    return no_c_for();
  }
  let outer: ast.Stmt[] = ifs.then_body;
  if (outer.len() < 2) {
    return no_c_for();
  }
  let flag: string = "";
  match (outer[outer.len() - 2]) {
    ast.StmtVar(v) => {
      if (is_forc_name(v.name) && expr_is_true(v.init)) {
        flag = v.name;
      }
    },
    _ => {}
  }
  if (flag.len() == 0) {
    return no_c_for();
  }
  let wbody: ast.Stmt[] = [];
  let label: string = "";
  let have_while: boolean = false;
  match (outer[outer.len() - 1]) {
    ast.StmtWhile(w) => {
      if (expr_is_true(w.cond)) {
        wbody = w.body;
        label = w.label;
        have_while = true;
      }
    },
    _ => {}
  }
  if (!have_while || wbody.len() < 3) {
    return no_c_for();
  }

  let step: ast.Stmt[] = [];
  let step_ok: boolean = false;
  match (wbody[0]) {
    ast.StmtIf(s) => {
      if (is_not_of_ident(s.cond, flag) && s.else_body.len() == 0) {
        step = s.then_body;
        step_ok = true;
      }
    },
    _ => {}
  }
  if (!step_ok) {
    return no_c_for();
  }

  let assign_ok: boolean = false;
  match (wbody[1]) {
    ast.StmtAssign(a) => {
      if (a.target == flag && expr_is_false(a.value)) {
        assign_ok = true;
      }
    },
    _ => {}
  }
  if (!assign_ok) {
    return no_c_for();
  }

  let cond: ast.Expr = ast.ExprBool { value: true, line: 0, col: 0 };
  let cond_ok: boolean = false;
  match (wbody[2]) {
    ast.StmtIf(c) => {
      if (c.else_body.len() == 0 && c.then_body.len() == 1) {
        match (c.then_body[0]) {
          ast.StmtBreak(b) => {
            if (b.label.len() == 0) {
              match (c.cond) {
                ast.ExprUnary(u) => {
                  if (u.op == "!") {
                    cond = u.operand;
                    cond_ok = true;
                  }
                },
                _ => {}
              }
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  if (!cond_ok) {
    return no_c_for();
  }

  let init: ast.Stmt[] = [];
  let ii: i32 = 0;
  while (ii + 2 < outer.len()) {
    init = init.append(outer[ii]);
    ii = ii + 1;
  }
  let body: ast.Stmt[] = [];
  let bi: i32 = 3;
  while (bi < wbody.len()) {
    body = body.append(wbody[bi]);
    bi = bi + 1;
  }
  return ForCSugar { init: init, cond: cond, step: step, body: body, label: label, ok: true };
}

function is_forc_name(name: string): boolean {
  return name.len() > 7 && util.str_has_prefix(name, "__forc_");
}

function expr_is_true(e: ast.Expr): boolean {
  match (e) {
    ast.ExprBool(b) => {
      return b.value;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function expr_is_false(e: ast.Expr): boolean {
  match (e) {
    ast.ExprBool(b) => {
      return !b.value;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_not_of_ident(e: ast.Expr, name: string): boolean {
  match (e) {
    ast.ExprUnary(u) => {
      if (u.op != "!") {
        return false;
      }
      match (u.operand) {
        ast.ExprIdent(id) => {
          return id.name == name;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

function print_c_for(fc: ForCSugar, depth: i32, f: Fmt): (string, Fmt) {
  let init: string = "";
  if (fc.init.len() == 1) {
    init = strip_semi(print_stmt_inline(fc.init[0], depth));
  }
  let step: string = "";
  if (fc.step.len() == 1) {
    step = strip_semi(print_stmt_inline(fc.step[0], depth));
  }
  let (body, g) = print_block(fc.body, depth, f);
  return (loop_label(fc.label) + "for (" + init + "; " + print_expr(fc.cond, depth) + "; " + step + ") " + body, g);
}

function strip_semi(s: string): string {
  if (s.len() > 0 && s[s.len() - 1] == b';') {
    return slice_unchecked(s, 0, s.len() - 1) + "";
  }
  return s;
}

function print_if_chain(ifs: ast.StmtIf, depth: i32, f: Fmt): (string, Fmt) {
  let (cond_text, cf) = print_expr_c(ifs.cond, prec_lowest(), depth, f);
  let (then_text, g) = print_block(ifs.then_body, depth, cf);
  let (else_text, g2) = print_else(ifs.else_body, ifs.else_chained, depth, g);
  return ("if (" + cond_text + ") " + then_text + else_text, g2);
}

function print_else(els: ast.Stmt[], chained: boolean, depth: i32, f: Fmt): (string, Fmt) {
  if (els.len() == 0) {
    return ("", f);
  }
  if (chained && els.len() == 1) {
    let (nested_text, g) = print_stmt_body(els[0], depth, f);
    return (" else " + nested_text, g);
  }
  let (block_text, g2) = print_block(els, depth, f);
  return (" else " + block_text, g2);
}

function loop_label(label: string): string {
  if (label.len() == 0) {
    return "";
  }
  return label + ": ";
}

function for_binder(var_name: string): string {
  if (!util.contains(var_name, ",")) {
    return var_name;
  }
  return "(" + join_csv(var_name) + ")";
}

function drop_first_stmt(stmts: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 1;
  while (i < stmts.len()) {
    out = out.append(stmts[i]);
    i = i + 1;
  }
  return out;
}

function print_for_iter(e: ast.Expr, depth: i32): string {
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() == 2) {
        match (c.callee) {
          ast.ExprIdent(id) => {
            if (id.name == "__range") {
              return print_expr(c.args[0], depth) + ".." + print_expr(c.args[1], depth);
            }
            if (id.name == "__range_incl") {
              return print_expr(c.args[0], depth) + "..=" + print_expr(c.args[1], depth);
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  return print_expr(e, depth);
}

function print_stmt(st: ast.Stmt, depth: i32, f: Fmt): (string, Fmt) {
  let (text, g) = print_stmt_line(st, depth, f);
  return (text + "\n", g);
}

function print_stmt_line(st: ast.Stmt, depth: i32, f: Fmt): (string, Fmt) {
  let (text, g) = print_stmt_body(st, depth, f);
  let out: string = indent_str(depth) + text;
  if (stmt_is_single_line(st)) {
    let ln: i32 = ast.stmt_line(st);
    if (ln > 0) {
      let (tr, g2) = emit_trailing(g, ln);
      let (tr2, g3) = emit_trailing(g2, stmt_last_line(st, ln));
      return (out + tr + tr2, g3);
    }
  }
  return (out, g);
}

function stmt_last_line(st: ast.Stmt, ln: i32): i32 {
  match (st) {
    ast.StmtReturn(r) => {
      return max_line(ln, last_line(r.value));
    },
    ast.StmtVar(v) => {
      return max_line(ln, last_line(v.init));
    },
    ast.StmtExpr(x) => {
      return max_line(ln, last_line(x.value));
    },
    ast.StmtAssign(a) => {
      return max_line(ln, last_line(a.value));
    },
    _ => {
      return ln;
    }
  }
  return ln;
}

function split_commas(csv: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i <= csv.len()) {
    if (i == csv.len() || csv[i] == b',') {
      out = out.append(slice_unchecked(csv, start, i) + "");
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

function written_name(name: string): string {
  if (util.str_has_prefix(name, "__discard_")) {
    return "_";
  }
  return name;
}

function written_part(part: string): string {
  let lead: i32 = 0;
  while (lead < part.len() && part[lead] == b'(') {
    lead = lead + 1;
  }
  let trail: i32 = part.len();
  while (trail > lead && part[trail - 1] == b')') {
    trail = trail - 1;
  }
  return slice_unchecked(part, 0, lead) + written_name(slice_unchecked(part, lead, trail) + "") + slice_unchecked(part, trail, part.len());
}

function join_csv(csv: string): string {
  let parts: string[] = split_commas(csv);
  let out: string = "";
  let i: i32 = 0;
  while (i < parts.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    out = out + written_part(parts[i]);
    i = i + 1;
  }
  return out;
}

function destr_at_prefix(type_name: string): string {
  let at: string = parser.destr_marker_split(type_name).at;
  if (at.len() == 0) {
    return "";
  }
  return at + " @ ";
}

function print_struct_destructure(v: ast.StmtVar, depth: i32): string {
  return "let " + destr_at_prefix(v.type_name) + struct_destr_pattern(v) + " = " + print_expr(v.init, depth) + ";";
}

function struct_destr_pattern(v: ast.StmtVar): string {
  let sd_marker: string = parser.destr_marker_split(v.type_name).tag;
  let rest: str = slice_unchecked(sd_marker, 4, sd_marker.len());
  let colon: i32 = 0 - 1;
  let ri: i32 = 0;
  while (ri < rest.len()) {
    if (rest[ri] == b':' && colon < 0) {
      colon = ri;
    }
    ri = ri + 1;
  }
  if (colon < 0) {
    return "";
  }
  let struct_name: str = slice_unchecked(rest, 0, colon);
  let fields: string[] = split_commas(slice_unchecked(rest, colon + 1, rest.len()));
  let binds: string[] = split_commas(v.name);
  let out: string = struct_name + " { ";
  let i: i32 = 0;
  while (i < fields.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    out = out + fields[i];
    if (i < binds.len() && binds[i] != fields[i]) {
      out = out + ": " + written_name(binds[i]);
    }
    i = i + 1;
  }
  out = out + rest_suffix(parser.destr_marker_split(v.type_name).rest_written, fields.len());
  return out + " }";
}

function param_pattern_from(st: ast.Stmt, holder: string): string {
  match (st) {
    ast.StmtVar(v) => {
      if (!parser.is_param_prelude_marker(v.type_name)) {
        return "";
      }
      let from_holder: boolean = false;
      match (v.init) {
        ast.ExprIdent(id) => {
          if (id.name == holder) {
            from_holder = true;
          }
        },
        _ => {}
      }
      if (!from_holder) {
        return "";
      }
      let at: string = "";
      if (!util.str_has_prefix(holder, "__ptuple_")) {
        at = holder + " @ ";
      }
      if (parser.is_struct_destr_marker(v.type_name)) {
        return at + struct_destr_pattern(v);
      }
      if (util.contains(v.name, ",")) {
        return at + "(" + join_csv(v.name) + ")";
      }
      return "";
    },
    _ => {}
  }
  return "";
}

function param_patterns_for(params: ast.ParamDecl[], body: ast.Stmt[]): (string[], i32) {
  let pats: string[] = [];
  let pi: i32 = 0;
  while (pi < params.len()) {
    pats = pats.append("");
    pi = pi + 1;
  }

  let n: i32 = 0;
  while (n < body.len()) {
    let matched: boolean = false;
    let k: i32 = 0;
    while (k < params.len()) {
      if (pats[k].len() == 0) {
        let pat: string = param_pattern_from(body[n], params[k].name);
        if (pat.len() > 0) {
          pats = pats.with(k, pat);
          matched = true;
          k = params.len();
        }
      }
      k = k + 1;
    }
    if (!matched) {
      n = body.len();
    } else {
      n = n + 1;
    }
  }
  let found: i32 = 0;
  let j: i32 = 0;
  while (j < pats.len()) {
    if (pats[j].len() > 0) {
      found = found + 1;
    }
    j = j + 1;
  }
  return (pats, found);
}

function print_nested_func_decl(v: ast.StmtVar, depth: i32, f: Fmt): (string, Fmt) {
  match (v.init) {
    ast.ExprLambda(lm) => {
      let out: string = "function " + v.name + print_lambda_params(lm, depth);
      if (lm.ret_type.len() > 0) {
        out = out + ": " + lm.ret_type;
      }
      let (body, g) = print_block(lm.body, depth, f);
      return (out + " " + body, g);
    },
    _ => {}
  }
  let (vi, vf) = print_expr_c(v.init, prec_lowest(), depth, f);
  return ("let " + v.name + " = " + vi + ";", vf);
}

function print_stmt_body(st: ast.Stmt, depth: i32, f: Fmt): (string, Fmt) {
  match (st) {
    ast.StmtDefer(d) => {
      if (is_block_stmt(d.action)) {
        let blk: ast.Stmt[] = block_stmts(d.action);
        let inl: string = "{ ";
        let bi: i32 = 0;
        while (bi < blk.len()) {
          inl = inl + print_stmt_inline(blk[bi], 0) + " ";
          bi = bi + 1;
        }
        if (d.on_error != 0) {
          return ("errdefer " + inl + "}", f);
        }
        return ("defer " + inl + "}", f);
      }
      let (act, dg) = print_stmt_body(d.action, depth, f);
      if (d.on_error != 0) {
        return ("errdefer " + act, dg);
      }
      return ("defer " + act, dg);
    },
    ast.StmtVar(v) => {
      if (parser.is_struct_destr_marker(v.type_name)) {
        return (print_struct_destructure(v, depth), f);
      }
      if (v.type_name == "@fndecl") {
        return print_nested_func_decl(v, depth, f);
      }
      if (util.contains(v.name, ",")) {
        return ("let " + destr_at_prefix(v.type_name) + "(" + join_csv(v.name) + ") = " + print_expr(v.init, depth) + ";", f);
      }
      let ann: string = "";
      if (v.type_name.len() > 0) {
        ann = ": " + v.type_name;
      }
      let (ti, tf) = print_expr_c(v.init, prec_lowest(), depth, f);
      return ("let " + written_name(v.name) + ann + " = " + ti + ";", tf);
    },
    ast.StmtReturn(r) => {
      if (expr_is_missing(r.value)) {
        return ("return;", f);
      }
      let us: UseSugar = as_use(r.value);
      if (us.ok) {
        return print_use(us, r.line, depth, f);
      }
      let (rv, rf) = print_expr_c(r.value, prec_lowest(), depth, f);
      return ("return " + rv + ";", rf);
    },
    ast.StmtExpr(x) => {
      let set: AssignParts = assign_parts(st);
      if (set.ok) {
        let (pv, pf) = print_expr_c(set.place, prec_lowest(), depth, f);
        let (sv, sf) = print_expr_c(set.value, prec_lowest(), depth, pf);
        return (pv + " = " + sv + ";", sf);
      }
      let (xv, xf) = print_expr_c(x.value, prec_lowest(), depth, f);
      return (xv + ";", xf);
    },
    ast.StmtIf(ifs) => {
      let fc: ForCSugar = as_c_for(ifs);
      if (fc.ok) {
        return print_c_for(fc, depth, f);
      }
      if (ifs.sugar.tup.len() > 0 || ifs.sugar.strct.len() > 0 || ifs.sugar.lits.len() > 0 || ifs.sugar.arms.len() > 0) {
        if (ifs.sugar.origin == "if_let") {
          return print_sugared_if_let(ifs.sugar, depth, f);
        }
        if (ifs.sugar.origin == "let_else") {
          return print_sugared_let_else(ifs.sugar, depth, f);
        }
        return print_sugared_match(ifs.sugar, depth, f);
      }
      if (ifs.origin == "block") {
        return print_block(ifs.then_body, depth, f);
      }
      if (ifs.origin == "chain_assign") {
        return (print_chain_assign(ifs.then_body, depth), f);
      }
      if (ifs.origin == parser.ORIGIN_ASSERT) {
        return print_assert(ifs, depth, f);
      }
      if (ifs.origin == parser.ORIGIN_TODO) {
        return print_todo(ifs.then_body, depth, f);
      }
      return print_if_chain(ifs, depth, f);
    },
    ast.StmtWhile(w) => {
      if (w.is_loop) {
        let (lb, lg) = print_block(w.body, depth, f);
        return (loop_label(w.label) + "loop " + lb, lg);
      }
      let (wc, wcf) = print_expr_c(w.cond, prec_lowest(), depth, f);
      let (wb, wg) = print_block(w.body, depth, wcf);
      return (loop_label(w.label) + "while (" + wc + ") " + wb, wg);
    },
    ast.StmtAssign(a) => {
      let (av, af) = print_expr_c(a.value, prec_lowest(), depth, f);
      return (a.target + " = " + av + ";", af);
    },
    ast.StmtMatch(m) => {
      if (m.origin == "let_else" && m.arms.len() >= 2) {
        return print_let_else(m, depth, f);
      }
      if (m.origin == "if_let" && m.arms.len() >= 2) {
        return print_if_let(m, depth, f);
      }
      return print_match(m, depth, f);
    },
    ast.StmtFor(fo) => {
      let fo_body: ast.Stmt[] = fo.body;
      let fo_binder: string = for_binder(fo.var_name);
      if (util.str_has_prefix(fo.var_name, "$forpat_") && fo.body.len() > 0) {
        match (fo.body[0]) {
          ast.StmtVar(fpv) => {
            fo_binder = destr_at_prefix(fpv.type_name);
            if (parser.is_struct_destr_marker(fpv.type_name)) {
              fo_binder = fo_binder + struct_destr_pattern(fpv);
            } else {
              fo_binder = fo_binder + "(" + join_csv(fpv.name) + ")";
            }
            fo_body = drop_first_stmt(fo.body);
          },
          _ => {}
        }
      }
      let (fb, fg) = print_block(fo_body, depth, f);
      return (loop_label(fo.label) + "for " + fo_binder + " in " + print_for_iter(fo.iter, depth) + " " + fb, fg);
    },
    ast.StmtBreak(b) => {
      if (b.label.len() > 0) {
        return ("break " + b.label + ";", f);
      }
      return ("break;", f);
    },
    ast.StmtContinue(c) => {
      if (c.label.len() > 0) {
        return ("continue " + c.label + ";", f);
      }
      return ("continue;", f);
    },
    ast.StmtUnknown(_) => {
      return ("", f);
    }
  }
}

function print_type_params(fd: parser.FuncDecl): string {
  if (fd.type_params.len() == 0) {
    return "";
  }
  let out: string = "[";
  let i: i32 = 0;
  while (i < fd.type_params.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    let bound: string = "";
    if (i < fd.bound_traits.len()) {
      bound = fd.bound_traits[i];
    }
    out = out + print_tparam(fd.type_params[i], bound);
    i = i + 1;
  }
  return out + "]";
}

function print_tparam(name: string, bound: string): string {
  if (parser.is_const_bound(bound)) {
    return "const " + name + ": i32";
  }
  if (bound.len() == 0) {
    return name;
  }
  return name + ": " + join_plus(bound);
}

function join_plus(bounds: string): string {
  let out: string = "";
  let start: i32 = 0;
  let i: i32 = 0;
  while (i <= bounds.len()) {
    if (i == bounds.len() || bounds[i] == b'+') {
      if (out.len() > 0) {
        out = out + " + ";
      }
      out = out + slice_unchecked(bounds, start, i);
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

function print_resource_decl(rd: parser.ResourceDecl): string {
  let out: string = "";
  if (rd.iface.len() > 0) {
    out = "@import(" + quote_string(rd.iface) + ", " + quote_string(rd.wit) + ")\n";
  }
  return out + "resource " + rd.name + ";\n";
}

function print_func_decl(fd: parser.FuncDecl, has_inline_hint: boolean, inline_never: boolean, f: Fmt): (string, Fmt) {
  let out: string = "";
  if (fd.import_iface.len() > 0) {
    out = out + "@import(" + quote_string(fd.import_iface) + ", " + quote_string(fd.import_wit) + ")\n";
  }
  if (has_inline_hint) {
    if (inline_never) {
      out = out + "@noinline\n";
    } else {
      out = out + "@inline\n";
    }
  }
  if (fd.is_pub) {
    out = out + "pub ";
  }
  if (fd.is_package) {
    out = out + "pub(package) ";
  }
  if (fd.fip || fd.fbip) {
    if (fd.fip) {
      out = out + "fip";
    } else {
      out = out + "fbip";
    }
    if (fd.fip_allowance > 0) {
      out = out + "(" + util.i32_to_string(fd.fip_allowance) + ")";
    }
    out = out + " ";
  }
  if (fd.async) {
    out = out + "async ";
  }
  out = out + "function ";
  let tps: string = print_type_params(fd);
  if (fd.receiver_name.len() > 0) {
    out = out + "(" + receiver_mode(fd) + fd.receiver_name;
    if (fd.receiver_type.len() > 0) {
      out = out + ": " + fd.receiver_type;
    }
    out = out + ") ";
  }
  out = out + fd.name + tps;
  let (dpats, dpre) = param_patterns_for(fd.params, fd.body);
  out = out + "(";
  let i: i32 = 0;
  while (i < fd.params.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    if (fd.params[i].own) {
      out = out + "own ";
    }
    if (i < dpats.len() && dpats[i].len() > 0) {
      out = out + dpats[i];
    } else {
      out = out + written_name(fd.params[i].name);
    }
    if (fd.params[i].type_name.len() > 0) {
      out = out + ": " + fd.params[i].type_name;
    }
    out = out + print_param_default(fd.params[i], true, 0);
    i = i + 1;
  }
  out = out + ")";
  if (fd.ret_type.len() > 0) {
    out = out + ": " + fd.ret_type;
  }
  if (fd.import_iface.len() > 0) {
    return (out + ";\n", f);
  }
  let (body_text, g) = print_block(drop_prelude(fd.body, dpre), 0, f);
  return (out + " " + body_text + "\n", g);
}

function print_struct_decl(sd: parser.StructDecl, flines: parser.FieldLines[], f: Fmt): (string, Fmt) {
  let out: string = "";
  if (sd.derives.len() > 0) {
    out = out + "@derive(";
    let di: i32 = 0;
    while (di < sd.derives.len()) {
      if (di > 0) {
        out = out + ", ";
      }
      out = out + sd.derives[di];
      di = di + 1;
    }
    out = out + ")\n";
  }
  if (sd.must_consume) {
    out = out + "@must_consume\n";
  }
  if (sd.is_pub) {
    out = out + "pub ";
  }
  if (sd.is_package) {
    out = out + "pub(package) ";
  }
  if (sd.opaque) {
    out = out + "opaque ";
  }
  out = out + "struct " + sd.name;
  if (sd.type_params.len() > 0) {
    out = out + "[";
    let tpi: i32 = 0;
    while (tpi < sd.type_params.len()) {
      if (tpi > 0) {
        out = out + ", ";
      }
      out = out + sd.type_params[tpi];
      tpi = tpi + 1;
    }
    out = out + "]";
  }
  let lns: i32[] = field_lines_for(flines, sd.name, sd.line);
  if (lns.len() == sd.fields.len() && lns.len() > 0 && keep_list_lines(f, sd.line, lns[lns.len() - 1])) {
    out = out + " {\n";
    let mi: i32 = 0;
    while (mi < sd.fields.len()) {
      let (lead, f1) = drain_leading(f, lns[mi], 1);
      out = out + lead;
      f = f1;
      out = out + indent_str(1) + sd.fields[mi].name + ": " + sd.fields[mi].type_name + ",";
      let (tr, f2) = emit_trailing(f, lns[mi]);
      out = out + tr + "\n";
      f = f2;
      mi = mi + 1;
    }
    return (out + "}\n", f);
  }
  out = out + " { ";
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    out = out + sd.fields[i].name + ": " + sd.fields[i].type_name;
    i = i + 1;
  }
  return (out + " }\n", f);
}

function print_const_decl(fd: parser.FuncDecl, f: Fmt): (string, Fmt) {
  let out: string = "";
  if (fd.is_pub) {
    out = out + "pub ";
  }
  if (fd.is_package) {
    out = out + "pub(package) ";
  }
  out = out + "const " + fd.name;
  if (fd.ret_type.len() > 0) {
    out = out + ": " + fd.ret_type;
  }
  let i: i32 = 0;
  while (i < fd.body.len()) {
    match (fd.body[i]) {
      ast.StmtReturn(r) => {
        let (cv, cf) = print_expr_c(r.value, prec_lowest(), 0, f);
        return (out + " = " + cv + ";\n", cf);
      },
      _ => {}
    }
    i = i + 1;
  }
  return (out + ";\n", f);
}

function enum_index(enums: parser.EnumDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < enums.len()) {
    if (enums[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function variant_decl_index(structs: parser.StructDecl[], owner: string, name: string): i32 {
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].enum_owner == owner && structs[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function print_enum_decl(ed: parser.EnumDecl, structs: parser.StructDecl[], flines: parser.FieldLines[], f: Fmt): (string, Fmt) {
  let out: string = "";
  let d0: i32 = 0 - 1;
  if (ed.variant_names.len() > 0) {
    d0 = variant_decl_index(structs, ed.name, ed.variant_names[0]);
  }
  if (d0 >= 0 && structs[d0].derives.len() > 0) {
    out = out + "@derive(";
    let di: i32 = 0;
    while (di < structs[d0].derives.len()) {
      if (di > 0) {
        out = out + ", ";
      }
      out = out + structs[d0].derives[di];
      di = di + 1;
    }
    out = out + ")\n";
  }
  if (ed.must_consume) {
    out = out + "@must_consume\n";
  }
  if (ed.is_pub) {
    out = out + "pub ";
  }
  if (ed.is_package) {
    out = out + "pub(package) ";
  }
  out = out + "enum " + ed.name;
  if (ed.type_params.len() > 0) {
    out = out + "[";
    let ti: i32 = 0;
    while (ti < ed.type_params.len()) {
      if (ti > 0) {
        out = out + ", ";
      }
      out = out + ed.type_params[ti];
      ti = ti + 1;
    }
    out = out + "]";
  }
  let lns: i32[] = field_lines_for(flines, ed.name, ed.line);
  if (lns.len() == ed.variant_names.len() && lns.len() > 0 && keep_list_lines(f, ed.line, lns[lns.len() - 1])) {
    out = out + " {\n";
    let mvi: i32 = 0;
    while (mvi < ed.variant_names.len()) {
      let (lead, f1) = drain_leading(f, lns[mvi], 1);
      out = out + lead;
      f = f1;
      out = out + indent_str(1) + print_enum_variant(ed, structs, mvi) + ",";
      let (tr, f2) = emit_trailing(f, lns[mvi]);
      out = out + tr + "\n";
      f = f2;
      mvi = mvi + 1;
    }
    return (out + "}\n", f);
  }
  out = out + " { ";
  let vi: i32 = 0;
  while (vi < ed.variant_names.len()) {
    if (vi > 0) {
      out = out + ", ";
    }
    out = out + print_enum_variant(ed, structs, vi);
    vi = vi + 1;
  }
  return (out + " }\n", f);
}

function print_enum_variant(ed: parser.EnumDecl, structs: parser.StructDecl[], vi: i32): string {
  let out: string = ed.variant_names[vi];
  let si: i32 = variant_decl_index(structs, ed.name, ed.variant_names[vi]);
  if (si >= 0 && structs[si].variant_field_names.len() > 0) {
    out = out + " {";
    let ri: i32 = 0;
    while (ri < structs[si].fields.len()) {
      if (ri > 0) {
        out = out + ",";
      }
      out = out + " " + structs[si].variant_field_names[ri] + ": " + structs[si].fields[ri].type_name;
      ri = ri + 1;
    }
    return out + " }";
  }
  if (si >= 0 && structs[si].fields.len() > 0) {
    out = out + "(";
    let fi: i32 = 0;
    while (fi < structs[si].fields.len()) {
      if (fi > 0) {
        out = out + ", ";
      }
      out = out + structs[si].fields[fi].type_name;
      fi = fi + 1;
    }
    return out + ")";
  }
  return out;
}

function print_type_params_except(fd: parser.FuncDecl, skip: string[]): string {
  let names: string[] = [];
  let bounds: string[] = [];
  let i: i32 = 0;
  while (i < fd.type_params.len()) {
    if (!util.has_str(skip, fd.type_params[i])) {
      names = names.append(fd.type_params[i]);
      if (i < fd.bound_traits.len()) {
        bounds = bounds.append(fd.bound_traits[i]);
      } else {
        bounds = bounds.append("");
      }
    }
    i = i + 1;
  }
  if (names.len() == 0) {
    return "";
  }
  let out: string = "[";
  let j: i32 = 0;
  while (j < names.len()) {
    if (j > 0) {
      out = out + ", ";
    }
    out = out + print_tparam(names[j], bounds[j]);
    j = j + 1;
  }
  return out + "]";
}

function print_impl_decl(id: parser.ImplDecl, f: Fmt): (string, Fmt) {
  let out: string = "impl";
  if (id.type_params.len() > 0) {
    out = out + "[";
    let tpi: i32 = 0;
    while (tpi < id.type_params.len()) {
      if (tpi > 0) {
        out = out + ", ";
      }
      let bound: string = "";
      if (tpi < id.bounds.len()) {
        bound = id.bounds[tpi];
      }
      out = out + print_tparam(id.type_params[tpi], bound);
      tpi = tpi + 1;
    }
    out = out + "]";
  }
  out = out + " " + id.trait_ref + " for " + id.type_ref;
  if (id.methods.len() == 0 && id.assoc_names.len() == 0) {
    return (out + " {}\n", f);
  }
  out = out + " {\n";
  let abi: i32 = 0;
  while (abi < id.assoc_names.len()) {
    let abv: string = "";
    if (abi < id.assoc_values.len()) {
      abv = id.assoc_values[abi];
    }
    out = out + indent_str(1) + "type " + id.assoc_names[abi] + " = " + abv + ";\n";
    abi = abi + 1;
  }
  let g: Fmt = f;
  let mi: i32 = 0;
  while (mi < id.methods.len()) {
    if (mi > 0 && g.blank_before(id.methods[mi].line)) {
      out = out + "\n";
    }
    let (lead, lg) = drain_leading(g, id.methods[mi].line, 1);
    let (mtext, mg) = print_impl_method(id.methods[mi], lg);
    out = out + lead + mtext;
    g = mg;
    mi = mi + 1;
  }
  return (out + "}\n", g);
}

function receiver_mode(fd: parser.FuncDecl): string {
  if (fd.receiver_own) {
    return "own ";
  }
  return "";
}

function print_const_member(m: parser.FuncDecl, f: Fmt): (string, Fmt) {
  let out: string = indent_str(1) + "const " + m.name + ": " + m.ret_type;
  if (m.body.len() > 0) {
    if let ast.StmtReturn(r) = m.body[0] {
      let (cv, cf) = print_expr_c(r.value, prec_lowest(), 0, f);
      return (out + " = " + cv + ";\n", cf);
    }
  }
  let (tr, g0) = emit_trailing(f, m.line);
  return (out + ";" + tr + "\n", g0);
}

function print_impl_method(m: parser.FuncDecl, f: Fmt): (string, Fmt) {
  if (m.is_const) {
    return print_const_member(m, f);
  }
  let out: string = indent_str(1) + "function " + m.name + print_type_params(m) + "(";
  let first: boolean = true;
  let i: i32 = 0;
  while (i < m.params.len()) {
    if (!first) {
      out = out + ", ";
    }
    if (m.params[i].own) {
      out = out + "own ";
    }
    out = out + written_name(m.params[i].name);
    if (m.params[i].type_name.len() > 0) {
      out = out + ": " + m.params[i].type_name;
    }
    first = false;
    i = i + 1;
  }
  out = out + ")";
  if (m.ret_type.len() > 0) {
    out = out + ": " + m.ret_type;
  }
  if (m.body.len() == 0) {
    return (out + ";\n", f);
  }
  let (body, g) = print_block(m.body, 1, f);
  return (out + " " + body + "\n", g);
}

function print_trait_decl(td: parser.TraitDecl, f: Fmt): (string, Fmt) {
  let out: string = "";
  if (td.is_pub) {
    out = out + "pub ";
  }
  if (td.is_package) {
    out = out + "pub(package) ";
  }
  out = out + "trait " + td.name;
  if (td.type_params.len() > 0) {
    out = out + "[";
    let tpi: i32 = 0;
    while (tpi < td.type_params.len()) {
      if (tpi > 0) {
        out = out + ", ";
      }
      out = out + td.type_params[tpi];
      tpi = tpi + 1;
    }
    out = out + "]";
  }
  if (td.supertraits.len() > 0) {
    out = out + ": ";
    let spi: i32 = 0;
    while (spi < td.supertraits.len()) {
      if (spi > 0) {
        out = out + " + ";
      }
      out = out + td.supertraits[spi];
      spi = spi + 1;
    }
  }
  if (td.methods.len() == 0 && td.assoc_types.len() == 0) {
    return (out + " {}\n", f);
  }
  out = out + " {\n";
  let ati: i32 = 0;
  while (ati < td.assoc_types.len()) {
    out = out + indent_str(1) + "type " + td.assoc_types[ati] + ";\n";
    ati = ati + 1;
  }
  let g: Fmt = f;
  let mi: i32 = 0;
  while (mi < td.methods.len()) {
    if (mi > 0 && g.blank_before(td.methods[mi].line)) {
      out = out + "\n";
    }
    let (lead, lg) = drain_leading(g, td.methods[mi].line, 1);
    let (mtext, mg) = print_trait_method(td.methods[mi], lg);
    out = out + lead + mtext;
    g = mg;
    mi = mi + 1;
  }
  return (out + "}\n", g);
}

function print_trait_method(m: parser.FuncDecl, f: Fmt): (string, Fmt) {
  if (m.is_const) {
    return print_const_member(m, f);
  }
  let out: string = indent_str(1) + "function " + m.name + print_type_params(m) + "(";
  let i: i32 = 0;
  while (i < m.params.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    if (m.params[i].own) {
      out = out + "own ";
    }
    out = out + written_name(m.params[i].name);
    if (m.params[i].type_name.len() > 0) {
      out = out + ": " + m.params[i].type_name;
    }
    i = i + 1;
  }
  out = out + ")";
  if (m.ret_type.len() > 0) {
    out = out + ": " + m.ret_type;
  }
  if (m.body.len() == 0) {
    let (tr, g0) = emit_trailing(f, m.line);
    return (out + ";" + tr + "\n", g0);
  }
  let (body, g) = print_block(m.body, 1, f);
  return (out + " " + body + "\n", g);
}

function print_type_alias(a: parser.TypeAlias): string {
  let out: string = "";
  if (a.is_pub) {
    out = out + "pub ";
  }
  if (a.is_package) {
    out = out + "pub(package) ";
  }
  out = out + "type " + a.name;
  if (a.type_params.len() > 0) {
    out = out + "[";
    let ti: i32 = 0;
    while (ti < a.type_params.len()) {
      if (ti > 0) {
        out = out + ", ";
      }
      out = out + a.type_params[ti];
      ti = ti + 1;
    }
    out = out + "]";
  }
  out = out + " = ";
  let ln: i32[] = a.variant_lines;
  let n: i32 = ln.len();
  let kept: boolean = n == a.variants.len() && n > 0 && ln[0] > 0 && ln[n - 1] > ln[0];
  let i: i32 = 0;
  while (i < a.variants.len()) {
    if (i > 0 && kept && ln[i] > ln[i - 1]) {
      out = out + "\n" + indent_str(1) + "| ";
    } else if (i > 0) {
      out = out + " | ";
    }
    out = out + a.variants[i];
    if (i < a.variant_args.len() && a.variant_args[i].len() > 0) {
      out = out + "[" + a.variant_args[i] + "]";
    }
    i = i + 1;
  }
  return out + ";\n";
}

function print_import(im: parser.Import): string {
  if (im.is_reexport) {
    let re: string = "pub use " + quote_string(im.path) + ".{";
    let ri: i32 = 0;
    while (ri < im.reexport_names.len()) {
      if (ri > 0) {
        re = re + ", ";
      }
      re = re + im.reexport_names[ri];
      ri = ri + 1;
    }
    return re + "};\n";
  }
  if (im.alias.len() > 0) {
    return "import " + quote_string(im.path) + " as " + im.alias + ";\n";
  }
  return "import " + quote_string(im.path) + ";\n";
}

pub function print_module(mod: parser.Module): string {
  return format_module(parser.written_type_vars_module(mod), [], [], [], [], []);
}

pub function format_module(mod: parser.Module, traits: parser.TraitDecl[], impls: parser.ImplDecl[], flines: parser.FieldLines[], comments: lexer.Comment[], blanks: boolean[]): string {
  return format_module_with_inline(mod, traits, impls, flines, [], no_spans(), comments, blanks);
}

pub function format_parsed(pf: parser.ParsedFmt, comments: lexer.Comment[], blanks: boolean[]): string {
  return format_module_with_inline(pf.pmod, pf.ptraits, pf.pimpls, pf.pflines, pf.pinline, pf.pspans, comments, blanks);
}

function print_annotated_function(fd: parser.FuncDecl, exports: parser.ExportBinding[], hints: parser.FunctionInlineHint[], cursor: i32, f: Fmt): (string, Fmt, i32) {
  let prefix = "";
  for binding in exports {
    if (binding.func_name == fd.name && !binding.c_abi && fd.receiver_name.len() > 0 == binding.method) {
      prefix = prefix + "@export(" + quote_string(binding.iface) + ", " + quote_string(binding.wit) + ")\n";
    }
  }
  let has_hint = cursor < hints.len() && hints[cursor].line == fd.line && hints[cursor].col == fd.col;
  let never = false;
  let next_hint = cursor;
  if (has_hint) {
    never = hints[cursor].never;
    next_hint = cursor + 1;
  }
  let (text, next) = print_func_decl(fd, has_hint, never, f);
  return (prefix + text, next, next_hint);
}

function format_module_with_inline(mod: parser.Module, traits: parser.TraitDecl[], impls: parser.ImplDecl[], flines: parser.FieldLines[], hints: parser.FunctionInlineHint[], spans: parser.BlockSpans, comments: lexer.Comment[], blanks: boolean[]): string {
  let f: Fmt = Fmt { comments: comments, ci: 0, blanks: blanks, spans: spans, si: 0 };
  let chunks: string[] = [];
  let wrote: boolean = false;
  let kinds: i32[] = [];
  let idxs: i32[] = [];
  let lines: i32[] = [];
  let ii: i32 = 0;
  while (ii < mod.imports.len()) {
    kinds = kinds.append(6);
    idxs = idxs.append(ii);
    lines = lines.append(mod.imports[ii].line);
    ii = ii + 1;
  }
  let i: i32 = 0;
  while (i < mod.structs.len()) {
    let owner: string = mod.structs[i].enum_owner;
    let ei: i32 = 0 - 1;
    if (owner.len() > 0) {
      ei = enum_index(mod.enums, owner);
    }
    if (ei < 0) {
      kinds = kinds.append(0);
      idxs = idxs.append(i);
      lines = lines.append(mod.structs[i].line);
    } else if (mod.enums[ei].variant_names[0] == mod.structs[i].name) {
      kinds = kinds.append(1);
      idxs = idxs.append(ei);
      lines = lines.append(mod.enums[ei].line);
    }
    i = i + 1;
  }
  let vi: i32 = 0;
  while (vi < mod.enums.len()) {
    if (mod.enums[vi].variant_names.len() == 0) {
      kinds = kinds.append(1);
      idxs = idxs.append(vi);
      lines = lines.append(mod.enums[vi].line);
    }
    vi = vi + 1;
  }
  let ai: i32 = 0;
  while (ai < mod.aliases.len()) {
    kinds = kinds.append(2);
    idxs = idxs.append(ai);
    lines = lines.append(mod.aliases[ai].line);
    ai = ai + 1;
  }
  let ri: i32 = 0;
  while (ri < mod.resources.len()) {
    kinds = kinds.append(7);
    idxs = idxs.append(ri);
    lines = lines.append(mod.resources[ri].line);
    ri = ri + 1;
  }
  let ti2: i32 = 0;
  while (ti2 < traits.len()) {
    kinds = kinds.append(4);
    idxs = idxs.append(ti2);
    lines = lines.append(traits[ti2].line);
    ti2 = ti2 + 1;
  }
  let ipi: i32 = 0;
  while (ipi < impls.len()) {
    kinds = kinds.append(5);
    idxs = idxs.append(ipi);
    lines = lines.append(impls[ipi].line);
    ipi = ipi + 1;
  }
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    if (mod.funcs[fi].line > 0) {
      kinds = kinds.append(3);
      idxs = idxs.append(fi);
      lines = lines.append(mod.funcs[fi].line);
    }
    fi = fi + 1;
  }
  let si: i32 = 1;
  while (si < lines.len()) {
    let sj: i32 = si;
    while (sj > 0 && lines[sj - 1] > lines[sj]) {
      let tl: i32 = lines[sj - 1];
      let tk: i32 = kinds[sj - 1];
      let ti: i32 = idxs[sj - 1];
      lines = lines.with(sj - 1, lines[sj]);
      kinds = kinds.with(sj - 1, kinds[sj]);
      idxs = idxs.with(sj - 1, idxs[sj]);
      lines = lines.with(sj, tl);
      kinds = kinds.with(sj, tk);
      idxs = idxs.with(sj, ti);
      sj = sj - 1;
    }
    si = si + 1;
  }
  let hint_cursor: i32 = 0;
  let di: i32 = 0;
  while (di < kinds.len()) {
    let dline: i32 = lines[di];
    if (di > 0 && !(kinds[di] == 6 && kinds[di - 1] == 6)) {
      chunks = chunks.append("\n");
    }
    if (dline > 0) {
      let (lead, fl) = drain_decl_leading(f, dline);
      chunks = chunks.append(lead);
      wrote = true;
      f = fl;
    }
    if (kinds[di] == 6) {
      chunks = chunks.append(print_import(mod.imports[idxs[di]]));
      wrote = true;
    } else if (kinds[di] == 0) {
      let (stext, sf2) = print_struct_decl(mod.structs[idxs[di]], flines, f);
      chunks = chunks.append(stext);
      wrote = true;
      f = sf2;
    } else if (kinds[di] == 1) {
      let (etext, ef) = print_enum_decl(mod.enums[idxs[di]], mod.structs, flines, f);
      chunks = chunks.append(etext);
      wrote = true;
      f = ef;
    } else if (kinds[di] == 2) {
      chunks = chunks.append(print_type_alias(mod.aliases[idxs[di]]));
      wrote = true;
    } else if (kinds[di] == 7) {
      chunks = chunks.append(print_resource_decl(mod.resources[idxs[di]]));
      wrote = true;
    } else if (kinds[di] == 4) {
      let (ttext, tf) = print_trait_decl(traits[idxs[di]], f);
      chunks = chunks.append(ttext);
      wrote = true;
      f = tf;
    } else if (kinds[di] == 5) {
      let (itext, iff) = print_impl_decl(impls[idxs[di]], f);
      chunks = chunks.append(itext);
      wrote = true;
      f = iff;
    } else {
      if (mod.funcs[idxs[di]].is_const) {
        let (ctext, cf) = print_const_decl(mod.funcs[idxs[di]], f);
        chunks = chunks.append(ctext);
        wrote = true;
        f = cf;
      } else {
        let fd: parser.FuncDecl = mod.funcs[idxs[di]];
        let (ftext, ff, next_hint) = print_annotated_function(fd, mod.exports, hints, hint_cursor, f);
        hint_cursor = next_hint;
        chunks = chunks.append(ftext);
        wrote = true;
        f = ff;
      }
    }
    di = di + 1;
  }
  let j: i32 = 0;
  while (j < mod.top_stmts.len()) {
    if (wrote) {
      chunks = chunks.append("\n");
      wrote = true;
    }
    let (stext, sf) = print_stmt(mod.top_stmts[j], 0, f);
    chunks = chunks.append(stext);
    wrote = true;
    f = sf;
    j = j + 1;
  }
  let (tail, _) = drain_all(f, 0, chunks.len() > 0);
  chunks = chunks.append(tail);
  return util.str_join_chunks(chunks);
}

function roundtrip_verbatim(src: string): parser.Module {
  let mod: parser.Module = parser.parse_module_verbatim(lexer.tokenize(src)).pmod;
  return parser.parse_module_verbatim(lexer.tokenize(print_module(mod))).pmod;
}

function roundtrip_module(src: string): parser.Module {
  let toks: lexer.Token[] = lexer.tokenize(src);
  let mod: parser.Module = parser.parse_module(toks);
  let emitted: string = print_module(mod);
  let toks2: lexer.Token[] = lexer.tokenize(emitted);
  return parser.parse_module(toks2);
}

function main(): i32 {
  let rc: i32 = check_expressions_and_control_flow();
  if (rc != 0) {
    return rc;
  }
  rc = check_checked_casts();
  if (rc != 0) {
    return rc;
  }
  rc = check_string_and_slice_literals();
  if (rc != 0) {
    return rc;
  }
  rc = check_structs_and_aliases();
  if (rc != 0) {
    return rc;
  }
  rc = check_match_statements();
  if (rc != 0) {
    return rc;
  }
  rc = check_annotations_and_receivers();
  if (rc != 0) {
    return rc;
  }
  rc = check_imports();
  if (rc != 0) {
    return rc;
  }
  rc = check_loops_and_tuples();
  if (rc != 0) {
    return rc;
  }
  rc = check_lambdas();
  if (rc != 0) {
    return rc;
  }
  rc = check_qualified_names_and_externs();
  if (rc != 0) {
    return rc;
  }
  rc = check_declaration_modifiers();
  if (rc != 0) {
    return rc;
  }
  rc = check_enums();
  if (rc != 0) {
    return rc;
  }
  rc = check_record_patterns();
  if (rc != 0) {
    return rc;
  }
  rc = check_const_and_for_sugar();
  if (rc != 0) {
    return rc;
  }
  rc = check_visibility_and_destructuring();
  if (rc != 0) {
    return rc;
  }
  rc = check_traits_and_impls();
  if (rc != 0) {
    return rc;
  }

  return 0;
}

function check_expressions_and_control_flow(): i32 {
  let toks1: lexer.Token[] = lexer.tokenize("let a = 1 + 2 * 3; return a;");
  let mod1: parser.Module = parser.parse_module(toks1);
  let s1: string = print_module(mod1);
  let rt1: parser.Module = parser.parse_module(lexer.tokenize(s1));
  if (rt1.top_stmts.len() != 2) {
    return 10;
  }
  match (rt1.top_stmts[0]) {
    ast.StmtVar(v) => {
      if (v.name != "a") {
        return 11;
      }
      match (v.init) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 12;
          }
        },
        _ => {
          return 13;
        }
      }
    },
    _ => {
      return 14;
    }
  }

  let src2: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
  let rt2: parser.Module = roundtrip_module(src2);
  if (rt2.funcs.len() != 2) {
    return 20;
  }
  if (rt2.funcs[0].name != "add") {
    return 21;
  }
  if (rt2.funcs[0].params.len() != 2) {
    return 22;
  }
  if (rt2.funcs[0].params[0].type_name != "i32") {
    return 23;
  }
  if (rt2.funcs[1].name != "main") {
    return 24;
  }

  let src3: string = "let x = 5; if (x < 10) { x = x + 1; } else { x = 0; } return x;";
  let rt3: parser.Module = roundtrip_module(src3);
