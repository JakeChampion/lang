function check_enums(): i32 {
  let srcEnum: string = "@derive(Eq)\nenum Color { Red, Green(i32) } function main(): i32 { let c: Color = Red; return 0; }";
  let modEnum: parser.Module = parser.parse_module(lexer.tokenize(srcEnum));
  let rtEnum: parser.Module = roundtrip_module(srcEnum);
  if (rtEnum.enums.len() != 1) {
    return 210;
