    esi = esi + 1;
  }
  if (rtEnum.structs[rgi].derives.len() != 1) {
    return 221;
  }
  if (rtEnum.structs[rgi].derives[0] != "Eq") {
    return 222;
  }
  if (rtEnum.funcs.len() != modEnum.funcs.len()) {
    return 223;
  }

  let srcEG: string = "@must_consume\nenum Slot[T] { Full(T), Empty } function main(): i32 { return 0; }";
  let modEG: parser.Module = parser.parse_module(lexer.tokenize(srcEG));
