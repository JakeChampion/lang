    return 243;
  }

  let srcPB: string = "enum Pair { Two(i32, i32) } function f(p: Pair): i32 { match (p) { Two(a, b) => { return a + b; }, } return 0; } function main(): i32 { return 0; }";
  let rtPB: parser.Module = roundtrip_module(srcPB);
  if (rtPB.funcs.len() < 1) {
    return 244;
  }
  match (rtPB.funcs[0].body[0]) {
    ast.StmtMatch(m) => {
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.binding != "a") {
            return 245;
          }
          if (pv.extra_bindings.len() != 1) {
            return 246;
          }
          if (pv.extra_bindings[0] != "b") {
            return 247;
          }
        },
        _ => {
          return 248;
        }
      }
    },
    _ => {
      return 249;
    }
  }

  return 0;
}

function check_record_patterns(): i32 {
  let src: string = "function f(s: Shape): i32 { match (s) { Rect { h: hh, .. } => { return hh; }, Circle { .. } => { return 0; } } return 0; } function main(): i32 { return 0; }";
  let rt: parser.Module = roundtrip_module(src);
  if (rt.funcs.len() < 1) {
    return 377;
  }
  if let ast.StmtMatch(m) = rt.funcs[0].body[0] {
    if (m.arms.len() != 2) {
      return 378;
    }
    if let ast.PatVariant(rect) = m.arms[0].pattern {
      if (rect.field_names.len() != 1 || rect.field_names[0] != "h" || rect.binding != "hh" || !rect.rest_written) {
        return 379;
      }
    } else {
      return 380;
    }
    if let ast.PatVariant(circle) = m.arms[1].pattern {
      if (circle.field_names.len() != 0 || !circle.rest_written) {
        return 381;
      }
    } else {
      return 382;
    }
    return 0;
  }
  return 383;
}

function check_const_and_for_sugar(): i32 {
  let srcConst: string = "const LIMIT: i32 = 41; function main(): i32 { return LIMIT + 1; }";
  let rtConst: parser.Module = roundtrip_module(srcConst);
  if (rtConst.funcs.len() != 2) {
    return 250;
  }
  let limit_i: i32 = 0 - 1;
  let ci: i32 = 0;
  while (ci < rtConst.funcs.len()) {
    if (rtConst.funcs[ci].name == "LIMIT") {
      limit_i = ci;
    }
    ci = ci + 1;
  }
  if (limit_i < 0) {
    return 251;
  }
  if (!rtConst.funcs[limit_i].is_const) {
    return 252;
  }
  if (rtConst.funcs[limit_i].ret_type != "i32") {
    return 253;
  }
  let rtFn: parser.Module = roundtrip_module("function LIMIT(): i32 { return 41; }");
  if (rtFn.funcs.len() != 1) {
    return 254;
  }
  if (rtFn.funcs[0].is_const) {
    return 255;
  }

  let srcCFor: string = "function main(): i32 { let s: i32 = 0; for (let i: i32 = 0; i < 3; i = i + 1) { s = s + i; } return s; }";
  let outCFor: string = print_module(parser.parse_module(lexer.tokenize(srcCFor)));
  if (!util.contains(outCFor, "for (let i: i32 = 0; i < 3; i = i + 1) {")) {
    return 260;
  }
  if (util.contains(outCFor, "__forc_")) {
    return 261;
  }
  let rtCFor: parser.Module = roundtrip_module(srcCFor);
  if (rtCFor.funcs.len() != 1) {
    return 262;
  }
  match (rtCFor.funcs[0].body[1]) {
    ast.StmtIf(cf) => {
      if (!as_c_for(cf).ok) {
        return 263;
      }
    },
    _ => {
      return 264;
    }
  }

  let outBare: string = print_module(parser.parse_module(lexer.tokenize(
    "function main(): i32 { let i: i32 = 0; for (; i < 3; ) { i = i + 1; } return i; }",
  )));
  if (!util.contains(outBare, "for (; i < 3; ) {")) {
    return 265;
  }

  let outRange: string = print_module(parser.parse_module(lexer.tokenize(
    "function main(): i32 { let t: i32 = 0; for i in 0..4 { t = t + i; } for j in 0..=4 { t = t + j; } return t; }",
  )));
  if (!util.contains(outRange, "for i in 0..4 {")) {
    return 266;
  }
  if (!util.contains(outRange, "for j in 0..=4 {")) {
    return 267;
  }
  if (util.contains(outRange, "__range")) {
    return 268;
  }

  let outMap: string = print_module(parser.parse_module(lexer.tokenize(
    "function f(m: map[string, i32]): i32 { let t: i32 = 0; for (k, v) in m { t = t + v; } return t; }",
  )));
  if (!util.contains(outMap, "for (k, v) in m {")) {
    return 269;
  }

  let srcLabels: string = "function main(): i32 { let t: i32 = 0; outer: while (t < 10) { inner: for (let i: i32 = 0; i < 3; i = i + 1) { if (i == 2) { continue outer; } break inner; } t = t + 1; } return t; }";
  let outLabels: string = print_module(parser.parse_module(lexer.tokenize(srcLabels)));
  if (!util.contains(outLabels, "outer: while (t < 10) {")) {
    return 270;
  }
  if (!util.contains(outLabels, "inner: for (let i: i32 = 0; i < 3; i = i + 1) {")) {
    return 271;
  }
  if (!util.contains(outLabels, "continue outer;")) {
    return 272;
  }
  if (!util.contains(outLabels, "break inner;")) {
    return 273;
  }

  return 0;
}

function check_visibility_and_destructuring(): i32 {
  let srcVis: string = "pub struct A { x: i32 } struct B { y: i32 } pub enum C { P } enum D { Q } pub type E = A | B; type F = A | B; function main(): i32 { return 0; }";
  let rtVis: parser.Module = roundtrip_module(srcVis);
  if (!rtVis.structs[struct_index(rtVis.structs, "A")].is_pub) {
    return 280;
  }
  if (rtVis.structs[struct_index(rtVis.structs, "B")].is_pub) {
    return 281;
  }
  if (!rtVis.enums[enum_index(rtVis.enums, "C")].is_pub) {
    return 282;
  }
  if (rtVis.enums[enum_index(rtVis.enums, "D")].is_pub) {
    return 283;
  }
  if (rtVis.aliases.len() != 2) {
    return 284;
  }
  if (!rtVis.aliases[0].is_pub) {
    return 285;
  }
  if (rtVis.aliases[1].is_pub) {
    return 286;
  }

  let srcTd: string = "function pair(): (i32, i32) { return (1, 2); } function main(): i32 { let (a, b) = pair(); return a + b; }";
  let rtTd: parser.Module = roundtrip_module(srcTd);
  let mti: i32 = func_index(rtTd.funcs, "main");
  if (mti < 0) {
    return 287;
  }
  if (rtTd.funcs[mti].body.len() != 2) {
    return 288;
  }
  match (rtTd.funcs[mti].body[0]) {
    ast.StmtVar(v) => {
      if (v.name != "a,b") {
        return 289;
      }
      if (v.type_name.len() != 0) {
        return 290;
      }
    },
    _ => {
      return 291;
    }
  }
  let srcSd: string = "struct P { x: i32, y: i32 } function main(): i32 { let P { x, y: bb } = P { x: 1, y: 2 }; return x + bb; }";
  let rtSd: parser.Module = roundtrip_module(srcSd);
  let msi: i32 = func_index(rtSd.funcs, "main");
  if (msi < 0) {
    return 292;
  }
  match (rtSd.funcs[msi].body[0]) {
    ast.StmtVar(v) => {
      if (v.name != "x,bb") {
        return 293;
      }
      if (v.type_name != "@sd:P:x,y") {
        return 294;
      }
    },
    _ => {
      return 295;
    }
  }

  let srcMt: string = "enum Opt[T] { Some(T), None } pub function [U] (o: Opt[T]) map(f: (T) => U): Opt[U] { return None; } function main(): i32 { return 0; }";
  let rtMt: parser.Module = roundtrip_module(srcMt);
  let mmi: i32 = func_index(rtMt.funcs, "map");
  if (mmi < 0) {
    return 296;
  }
  if (rtMt.funcs[mmi].receiver_name != "o") {
    return 297;
  }
  if (rtMt.funcs[mmi].all_type_params.len() != 1) {
    return 298;
  }

  return 0;
}

function check_traits_and_impls(): i32 {
  let srcTr: string = "pub trait Greet[T]: Display { function hi(self: Self, x: T): string; function loud(self: Self, x: T): string { return self.hi(x); } } function main(): i32 { return 0; }";
  let pfTr: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(srcTr));
  let outTr: string = format_module(pfTr.pmod, pfTr.ptraits, pfTr.pimpls, pfTr.pflines, [], []);
  let rtTr: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(outTr));
  if (rtTr.ptraits.len() != 1) {
    return 299;
  }
  if (rtTr.ptraits[0].name != "Greet") {
    return 300;
  }
  if (!rtTr.ptraits[0].is_pub) {
    return 301;
  }
  if (rtTr.ptraits[0].type_params.len() != 1) {
    return 302;
  }
  if (rtTr.ptraits[0].type_params[0] != "T") {
    return 303;
  }
  if (rtTr.ptraits[0].supertraits.len() != 1) {
    return 304;
  }
  if (rtTr.ptraits[0].supertraits[0] != "Display") {
    return 305;
  }
  if (rtTr.ptraits[0].methods.len() != 2) {
    return 306;
  }
  if (rtTr.ptraits[0].methods[0].name != "hi") {
    return 307;
  }
  if (rtTr.ptraits[0].methods[0].body.len() != 0) {
    return 308;
  }
  if (rtTr.ptraits[0].methods[1].name != "loud") {
    return 309;
  }
  if (rtTr.ptraits[0].methods[1].body.len() == 0) {
    return 310;
  }
  let pfQ: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
    "import \"core/cmp\"; pub trait Sortable: cmp.Ord {} function main(): i32 { return 0; }",
  ));
  if (pfQ.ptraits.len() != 1) {
    return 311;
  }
  if (pfQ.ptraits[0].supertraits.len() != 1) {
    return 312;
  }
  if (pfQ.ptraits[0].supertraits[0] != "cmp.Ord") {
    return 313;
  }
  if (!util.contains(format_module(pfQ.pmod, pfQ.ptraits, pfQ.pimpls, pfQ.pflines, [], []), "pub trait Sortable: cmp.Ord {}")) {
    return 314;
  }

  let srcIm: string = "trait Display { function to_string(self: Self): string; } impl Display for i32 {} impl Display for boolean { function to_string(self: Self): string { return \"t\"; } } function main(): i32 { return 0; }";
  let pfIm: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(srcIm));
  if (pfIm.pimpls.len() != 2) {
    return 315;
  }
  if (pfIm.pimpls[0].trait_ref != "Display") {
    return 316;
  }
  if (pfIm.pimpls[0].type_ref != "i32") {
    return 317;
  }
  if (pfIm.pimpls[0].methods.len() != 0) {
    return 318;
  }
  if (pfIm.pimpls[1].methods.len() != 1) {
    return 319;
  }
  if (func_index(pfIm.pmod.funcs, "to_string") >= 0) {
    return 320;
  }
  let outIm: string = format_module(pfIm.pmod, pfIm.ptraits, pfIm.pimpls, pfIm.pflines, [], []);
  if (!util.contains(outIm, "impl Display for i32 {}")) {
    return 321;
  }
  if (!util.contains(outIm, "function to_string(self: Self): string {")) {
    return 322;
  }
  let rtIm: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(outIm));
  if (rtIm.pimpls.len() != 2) {
    return 323;
  }

  let pfPa: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
    "import \"core/cmp\"; struct Box[T] { item: T } impl[T: cmp.Eq] cmp.Eq for Box[T] { function eq(self: Self, other: Self): boolean { return true; } } function main(): i32 { return 0; }",
  ));
  if (pfPa.pimpls.len() != 1) {
    return 328;
  }
  let outPa: string = format_module(pfPa.pmod, pfPa.ptraits, pfPa.pimpls, pfPa.pflines, [], []);
  if (!util.contains(outPa, "impl[T: cmp.Eq] cmp.Eq for Box[T] {")) {
    return 329;
  }
  if (!util.contains(outPa, "function eq(self: Self, other: Self): boolean {")) {
    return 330;
  }

  let pfOor: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
    "function main(): i32 { let x: f64 = 1e309; return 0; }",
  ));
  let outOor: string = format_module(pfOor.pmod, pfOor.ptraits, pfOor.pimpls, pfOor.pflines, [], []);
  if (!util.contains(outOor, "let x: f64 = 1e309;")) {
    return 331;
  }

  if (quote_string("héllo\nwörld") != "\"héllo\\nwörld\"") {
    return 340;
  }
  if (escape_fstring_lit("pré{x}é") != "pré{{x}}é") {
    return 341;
  }

  if (quote_string("a\x00b\x1fc\x7fd") != "\"a\\x00b\\x1fc\\x7fd\"") {
    return 342;
  }
  if (escape_fstring_lit("a\x00b") != "a\\x00b") {
    return 343;
  }
  if (quote_string("\x07é😀") != "\"\\x07é😀\"") {
    return 347;
  }
  if (escape_fstring_lit("é{😀") != "é{{😀") {
    return 348;
  }
  let srcMb: string = "function main(): i32 { let s: string = \"héllo\"; let f: string = f\"pré {s}\"; return 0; }";
  let pfMb: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(srcMb));
  let outMb: string = format_module(pfMb.pmod, pfMb.ptraits, pfMb.pimpls, pfMb.pflines, [], []);
  let rtMb: parser.Module = parser.parse_module(lexer.tokenize(outMb));
  if (rtMb.funcs.len() != 1) {
    return 342;
  }
  if (!util.contains(outMb, "\"héllo\"")) {
    return 343;
  }
  if (!util.contains(outMb, "f\"pré {s}\"")) {
    return 344;
  }
  let dl: string[] = diff_split_lines("é\nü");
  if (dl.len() != 2) {
    return 345;
  }
  if (dl[0] != "é\n" || dl[1] != "ü") {
    return 346;
  }

  let dcode: i32 = diff_selftest();
  if (dcode != 0) {
    return dcode;
  }

  return 0;
}

function struct_index(structs: parser.StructDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].name == name && structs[i].enum_owner.len() == 0) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function func_index(funcs: parser.FuncDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function diff_split_lines(s: string): string[] {
  let out: string[] = [];
  if (s.len() == 0) {
    return out;
  }
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b'\n') {
      out = out.append(slice_unchecked(s, start, i + 1) + "");
      start = i + 1;
    }
    i = i + 1;
  }
  if (start < s.len()) {
    out = out.append(slice_unchecked(s, start, s.len()) + "");
  }
  return out;
}

struct DiffScript { kinds: i32[], lines: string[] }

function diff_max_search_cost(): i32 {
  return 16384;
}

struct DiffIds { ia: i32[], ib: i32[], distinct: i32 }

function diff_intern(a: string[], b: string[]): DiffIds {
  let ids: Map[string, i32] = map_new(a.len() + b.len() + 1);
  let ia: i32[] = [];
  let ib: i32[] = [];
  let next: i32 = 0;
  let i: i32 = 0;
  while (i < a.len()) {
    let ida: i32 = ids.get_or(a[i], 0 - 1);
    if (ida < 0) {
      ida = next;
      ids = ids.insert(a[i], ida);
      next = next + 1;
    }
    ia = ia.append(ida);
    i = i + 1;
  }
  let j: i32 = 0;
  while (j < b.len()) {
    let idb: i32 = ids.get_or(b[j], 0 - 1);
    if (idb < 0) {
      idb = next;
      ids = ids.insert(b[j], idb);
      next = next + 1;
    }
    ib = ib.append(idb);
    j = j + 1;
  }
  return DiffIds { ia: ia, ib: ib, distinct: next };
}

function diff_furthest(vf: i32[], vr: i32[], off: i32, size: i32, alo: i32, ahi: i32, blo: i32, bhi: i32): (i32, i32) {
  let na: i32 = ahi - alo;
  let nb: i32 = bhi - blo;
  let best_f: i32 = 0;
  let fx: i32 = 0;
  let fy: i32 = 0;
  let best_r: i32 = 0;
  let rx: i32 = 0;
  let ry: i32 = 0;
  let o: i32 = 0;
  while (o < size) {
    let j: i32 = o - off;
    let xf: i32 = vf[o];
    if (xf >= 0) {
      let yf: i32 = xf - j;
      if (xf <= na && yf >= 0 && yf <= nb && xf + yf > best_f) {
        best_f = xf + yf;
        fx = xf;
        fy = yf;
      }
    }
    let xr: i32 = vr[o];
    if (xr >= 0) {
      let yr: i32 = xr - j;
      if (xr <= na && yr >= 0 && yr <= nb && xr + yr > best_r) {
        best_r = xr + yr;
        rx = na - xr;
        ry = nb - yr;
      }
    }
    o = o + 1;
  }
  if (best_f >= best_r) {
    if (best_f > 0 && (fx < na || fy < nb)) {
      return (alo + fx, blo + fy);
    }
  } else if (rx > 0 || ry > 0) {
    return (alo + rx, blo + ry);
  }
  return (alo + na / 2, blo + nb / 2);
}

function diff_bisect(ia: i32[], ib: i32[], alo: i32, ahi: i32, blo: i32, bhi: i32, max_cost: i32): (i32, i32) {
  let na: i32 = ahi - alo;
  let nb: i32 = bhi - blo;
  let maxd: i32 = (na + nb + 3) / 2;
  let budget: i32 = maxd;
  if (budget > max_cost) {
    budget = max_cost;
  }
  let off: i32 = budget + 1;
  let size: i32 = 2 * budget + 4;
  let vf: i32[] = [];
  let vr: i32[] = [];
  let z: i32 = 0;
  while (z < size) {
    vf = vf.append(0 - 1);
    vr = vr.append(0 - 1);
    z = z + 1;
  }
  vf = vf.with(off + 1, 0);
  vr = vr.with(off + 1, 0);
  let delta: i32 = na - nb;
  let meet_forward: boolean = delta % 2 != 0;
  let flo: i32 = 0;
  let fhi: i32 = 0;
  let rlo: i32 = 0;
  let rhi: i32 = 0;
  let k: i32 = 0;
  while (k < budget) {
    let jf: i32 = 0 - k + flo;
    while (jf <= k - fhi) {
      let o: i32 = off + jf;
      let x: i32 = 0;
      if (jf == 0 - k || jf != k && vf[o - 1] < vf[o + 1]) {
        x = vf[o + 1];
      } else {
        x = vf[o - 1] + 1;
      }
      let y: i32 = x - jf;
      while (x < na && y < nb && ia[alo + x] == ib[blo + y]) {
        x = x + 1;
        y = y + 1;
      }
      vf = vf.with(o, x);
      if (x > na) {
        fhi = fhi + 2;
      } else if (y > nb) {
        flo = flo + 2;
      } else if (meet_forward) {
        let ro: i32 = off + delta - jf;
        if (ro >= 0 && ro < size && vr[ro] >= 0 && x >= na - vr[ro]) {
          return (alo + x, blo + y);
        }
      }
      jf = jf + 2;
    }
    let jr: i32 = 0 - k + rlo;
    while (jr <= k - rhi) {
      let o2: i32 = off + jr;
      let x2: i32 = 0;
      if (jr == 0 - k || jr != k && vr[o2 - 1] < vr[o2 + 1]) {
        x2 = vr[o2 + 1];
      } else {
        x2 = vr[o2 - 1] + 1;
      }
      let y2: i32 = x2 - jr;
      while (x2 < na && y2 < nb && ia[ahi - 1 - x2] == ib[bhi - 1 - y2]) {
        x2 = x2 + 1;
        y2 = y2 + 1;
      }
      vr = vr.with(o2, x2);
      if (x2 > na) {
        rhi = rhi + 2;
      } else if (y2 > nb) {
        rlo = rlo + 2;
      } else if (!meet_forward) {
        let fo: i32 = off + delta - jr;
        if (fo >= 0 && fo < size && vf[fo] >= 0 && vf[fo] >= na - x2) {
          return (alo + vf[fo], blo + vf[fo] - (delta - jr));
        }
      }
      jr = jr + 2;
    }
    k = k + 1;
  }
  return diff_furthest(vf, vr, off, size, alo, ahi, blo, bhi);
}

function diff_compare(anchors: i32[], ia: i32[], ib: i32[], alo: i32, ahi: i32, blo: i32, bhi: i32, max_cost: i32): i32[] {
  let lo_a: i32 = alo;
  let lo_b: i32 = blo;
  while (lo_a < ahi && lo_b < bhi && ia[lo_a] == ib[lo_b]) {
    anchors = anchors.append(lo_a);
    anchors = anchors.append(lo_b);
    lo_a = lo_a + 1;
    lo_b = lo_b + 1;
  }
  let suffix: i32 = 0;
  while (ahi - suffix > lo_a && bhi - suffix > lo_b && ia[ahi - 1 - suffix] == ib[bhi - 1 - suffix]) {
    suffix = suffix + 1;
  }
  let hi_a: i32 = ahi - suffix;
  let hi_b: i32 = bhi - suffix;
  if (lo_a < hi_a && lo_b < hi_b) {
    let (x, y) = diff_bisect(ia, ib, lo_a, hi_a, lo_b, hi_b, max_cost);
    if ((x != lo_a || y != lo_b) && (x != hi_a || y != hi_b)) {
      anchors = diff_compare(anchors, ia, ib, lo_a, x, lo_b, y, max_cost);
      anchors = diff_compare(anchors, ia, ib, x, hi_a, y, hi_b, max_cost);
    }
  }
  let s: i32 = 0;
  while (s < suffix) {
    anchors = anchors.append(hi_a + s);
    anchors = anchors.append(hi_b + s);
    s = s + 1;
  }
  return anchors;
}

function diff_edit_script(a: string[], b: string[]): DiffScript {
  let m: i32 = a.len();
  let n: i32 = b.len();
  let ids: DiffIds = diff_intern(a, b);
  let ia: i32[] = ids.ia;
  let ib: i32[] = ids.ib;

  let pre: i32 = 0;
  while (pre < m && pre < n && ia[pre] == ib[pre]) {
    pre = pre + 1;
  }
  let suf: i32 = 0;
  while (suf < m - pre && suf < n - pre && ia[m - 1 - suf] == ib[n - 1 - suf]) {
    suf = suf + 1;
  }

  let in_a: boolean[] = [];
  let in_b: boolean[] = [];
  let z: i32 = 0;
  while (z < ids.distinct) {
    in_a = in_a.append(false);
    in_b = in_b.append(false);
    z = z + 1;
  }
  let i: i32 = pre;
  while (i < m - suf) {
    in_a = in_a.with(ia[i], true);
    i = i + 1;
  }
  let j: i32 = pre;
  while (j < n - suf) {
    in_b = in_b.with(ib[j], true);
    j = j + 1;
  }
  let fa: i32[] = [];
  let map_a: i32[] = [];
  let fb: i32[] = [];
  let map_b: i32[] = [];
  i = pre;
  while (i < m - suf) {
    if (in_b[ia[i]]) {
      fa = fa.append(ia[i]);
      map_a = map_a.append(i);
    }
    i = i + 1;
  }
  j = pre;
  while (j < n - suf) {
    if (in_a[ib[j]]) {
      fb = fb.append(ib[j]);
      map_b = map_b.append(j);
    }
    j = j + 1;
  }
  let anchors: i32[] = [];
  anchors = diff_compare(anchors, fa, fb, 0, fa.len(), 0, fb.len(), diff_max_search_cost());

  let kinds: i32[] = [];
  let lines: string[] = [];
  let p: i32 = 0;
  while (p < pre) {
    kinds = kinds.append(0);
    lines = lines.append(a[p]);
    p = p + 1;
  }
  let q: i32 = pre;
  let t: i32 = 0;
  while (t < anchors.len()) {
    let ai: i32 = map_a[anchors[t]];
    let bj: i32 = map_b[anchors[t + 1]];
    while (p < ai) {
      kinds = kinds.append(1);
      lines = lines.append(a[p]);
      p = p + 1;
    }
    while (q < bj) {
      kinds = kinds.append(2);
      lines = lines.append(b[q]);
      q = q + 1;
    }
    kinds = kinds.append(0);
    lines = lines.append(a[p]);
    p = p + 1;
    q = q + 1;
    t = t + 2;
  }
  while (p < m - suf) {
    kinds = kinds.append(1);
    lines = lines.append(a[p]);
    p = p + 1;
  }
  while (q < n - suf) {
    kinds = kinds.append(2);
    lines = lines.append(b[q]);
    q = q + 1;
  }
  while (p < m) {
    kinds = kinds.append(0);
    lines = lines.append(a[p]);
    p = p + 1;
  }
  return DiffScript { kinds: kinds, lines: lines };
}

pub function unified_diff(before: string, after: string, path_before: string, path_after: string): string {
  if (before == after) {
    return "";
  }
  let script: DiffScript = diff_edit_script(diff_split_lines(before), diff_split_lines(after));
  let kinds: i32[] = script.kinds;
  if (kinds.len() == 0) {
    return "";
  }
  let context: i32 = 3;

  let lo: i32[] = [];
  let hi: i32[] = [];
  let i: i32 = 0;
  while (i < kinds.len()) {
    if (kinds[i] == 0) {
      i = i + 1;
    } else {
      let s: i32 = i;
      while (i < kinds.len() && kinds[i] != 0) {
        i = i + 1;
      }
      if (lo.len() > 0 && s - hi[hi.len() - 1] <= 2 * context) {
        hi = hi.with(hi.len() - 1, i);
      } else {
        lo = lo.append(s);
        hi = hi.append(i);
      }
    }
  }
  if (lo.len() == 0) {
    return "";
  }

  let out: string = "--- " + path_before + "\n+++ " + path_after + "\n";
  let h: i32 = 0;
  while (h < lo.len()) {
    let start: i32 = lo[h] - context;
    if (start < 0) {
      start = 0;
    }
    let end: i32 = hi[h] + context;
    if (end > kinds.len()) {
      end = kinds.len();
    }
    let a_pos: i32 = 0;
    let b_pos: i32 = 0;
    let k: i32 = 0;
    while (k < start) {
      if (kinds[k] != 2) {
        a_pos = a_pos + 1;
      }
      if (kinds[k] != 1) {
        b_pos = b_pos + 1;
      }
      k = k + 1;
    }
    let a_len: i32 = 0;
    let b_len: i32 = 0;
    k = start;
    while (k < end) {
      if (kinds[k] != 2) {
        a_len = a_len + 1;
      }
      if (kinds[k] != 1) {
        b_len = b_len + 1;
      }
      k = k + 1;
    }
    out = out + "@@ -" + util.i32_to_string(a_pos + 1) + "," + util.i32_to_string(a_len)
      + " +" + util.i32_to_string(b_pos + 1) + "," + util.i32_to_string(b_len) + " @@\n";
    k = start;
    while (k < end) {
      let mark: string = " ";
      if (kinds[k] == 1) {
        mark = "-";
      }
      if (kinds[k] == 2) {
        mark = "+";
      }
      let line: string = script.lines[k];
      out = out + mark + line;
      if (line.len() == 0 || line[line.len() - 1] != b'\n') {
        out = out + "\n";
      }
      k = k + 1;
    }
    h = h + 1;
  }
  return out;
}

function diff_replay(sc: DiffScript, keep: i32): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < sc.kinds.len()) {
    if (sc.kinds[i] == 0 || sc.kinds[i] == keep) {
      out = out + sc.lines[i];
    }
    i = i + 1;
  }
  return out;
}

function diff_edits(sc: DiffScript): i32 {
  let n: i32 = 0;
  let i: i32 = 0;
  while (i < sc.kinds.len()) {
    if (sc.kinds[i] != 0) {
      n = n + 1;
    }
    i = i + 1;
  }
  return n;
}

function diff_lcs_edits(a: string[], b: string[]): i32 {
  let m: i32 = a.len();
  let n: i32 = b.len();
  let prev: i32[] = [];
  let cur: i32[] = [];
  let z: i32 = 0;
  while (z <= n) {
    prev = prev.append(0);
    cur = cur.append(0);
    z = z + 1;
  }
  let i: i32 = m - 1;
  while (i >= 0) {
    prev = cur;
    let j: i32 = n - 1;
    while (j >= 0) {
      if (a[i] == b[j]) {
        cur = cur.with(j, prev[j + 1] + 1);
      } else if (prev[j] >= cur[j + 1]) {
        cur = cur.with(j, prev[j]);
      } else {
        cur = cur.with(j, cur[j + 1]);
      }
      j = j - 1;
    }
    i = i - 1;
  }
  return m + n - 2 * cur[0];
}

function diff_rand(s: i64): i64 {
  return s * 48271i64 % 2147483647i64;
}

function diff_lines_from(seed: i64, n: i32, alphabet: i32): string[] {
  let vocab: string[] = ["a\n", "b\n", "c\n", "d\n", "e\n"];
  let out: string[] = [];
  let s: i64 = seed;
  let i: i32 = 0;
  while (i < n) {
    s = diff_rand(s);
    out = out.append(vocab[(s % (alphabet as i64)) as i32]);
    i = i + 1;
  }
  return out;
}

function diff_selftest(): i32 {
  let s: i64 = 12345i64;
  let iter: i32 = 0;
  while (iter < 300) {
    s = diff_rand(s);
    let alphabet: i32 = 2 + (s % 4i64) as i32;
    s = diff_rand(s);
    let na: i32 = (s % 14i64) as i32;
    s = diff_rand(s);
    let nb: i32 = (s % 14i64) as i32;
    s = diff_rand(s);
    let a: string[] = diff_lines_from(s, na, alphabet);
    s = diff_rand(s);
    let b: string[] = diff_lines_from(s, nb, alphabet);
    let sc: DiffScript = diff_edit_script(a, b);
    if (diff_replay(sc, 1) != util.str_join_chunks(a)) {
      return 350;
    }
    if (diff_replay(sc, 2) != util.str_join_chunks(b)) {
      return 351;
    }
    if (diff_edits(sc) != diff_lcs_edits(a, b)) {
      return 352;
    }
    iter = iter + 1;
  }

  let la: string[] = diff_lines_from(777i64, 400, 3);
  let lb: string[] = diff_lines_from(999i64, 400, 3);
  let lsc: DiffScript = diff_edit_script(la, lb);
  if (diff_replay(lsc, 1) != util.str_join_chunks(la)) {
    return 353;
  }
  if (diff_replay(lsc, 2) != util.str_join_chunks(lb)) {
    return 354;
  }
  if (diff_edits(lsc) != diff_lcs_edits(la, lb)) {
    return 355;
  }

  let pa: string[] = diff_split_lines("one\ntwo\nthree\nfour\nfive\n");
  let pb: string[] = diff_split_lines("one\ntwo\nTHREE\nfour\nfive\n");
  let psc: DiffScript = diff_edit_script(pa, pb);
  if (diff_edits(psc) != 2) {
    return 356;
  }
  if (diff_replay(psc, 1) != "one\ntwo\nthree\nfour\nfive\n") {
    return 357;
  }
  if (diff_replay(psc, 2) != "one\ntwo\nTHREE\nfour\nfive\n") {
    return 358;
  }

  let ud: string = unified_diff("one\ntwo\nthree\nfour\nfive\n", "one\ntwo\nTHREE\nfour\nfive\n", "x.fern", "x.fern");
  if (ud != "--- x.fern\n+++ x.fern\n@@ -1,5 +1,5 @@\n one\n two\n-three\n+THREE\n four\n five\n") {
    return 359;
  }
  if (unified_diff("a\n", "a\n", "x", "y") != "") {
    return 360;
  }
  return 0;
}

function check_checked_casts(): i32 {
  for src in ["let x = value as? u8;", "let x = (value + 1) as? u8;", "let x = (value as i64) as? u32;", "let x = (value as? ByteStream)?;"] {
    let m: parser.Module = parser.parse_module(lexer.tokenize(src));
    let printed: string = print_module(m);
    if (!util.contains(printed, " as? ")) {
      return 361;
    }
    let again: parser.Module = parser.parse_module(lexer.tokenize(printed));
    if (again.top_stmts.len() != 1 || print_module(again) != printed) {
      return 362;
    }
  }
  return 0;
}
