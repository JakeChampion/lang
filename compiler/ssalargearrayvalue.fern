// Mathematical large-array capacity data, not machine or ownership evidence.
// C is the unsigned low32 capacity. All arithmetic is bounded before use.
import "./ssalargepushranges" as bins;

pub struct Interval { low: i64, high: i64 }

pub struct Value { factor: i32, offset: i64 }

pub struct Comparison { less: i32, equal: i32, less_equal: i32 }

pub function valid_interval(r: Interval): boolean {
  return r.low >= 65533 as i64 && r.low <= r.high && r.high <= 4294967295 as i64;
}

function bounded(n: i64): boolean {
  return n >= -(34359738384 as i64) && n <= 34359738384 as i64;
}

function endpoint(v: Value, c: i64): i64 {
  return v.factor as i64 * c + v.offset;
}

pub function valid(r: Interval, v: Value): boolean {
  if (!valid_interval(r) || v.factor != 0 && v.factor != 1 && v.factor != 8 || !bounded(v.offset)) {
    return false;
  }
  // The preceding bounds make both endpoint calculations safe in signed i64.
  return endpoint(v, r.low) >= 0 as i64 && endpoint(v, r.high) <= 34359738384 as i64;
}

pub function unknown(): Value {
  return Value { factor: -1, offset: 0 as i64 };
}

function checked(r: Interval, v: Value): Value {
  return if (valid(r, v)) { v } else { unknown() };
}

pub function number(r: Interval, n: i64): Value {
  return checked(r, Value { factor: 0, offset: n });
}

pub function capacity(r: Interval): Value {
  return checked(r, Value { factor: 1, offset: 0 as i64 });
}

pub function add(r: Interval, v: Value, delta: i64): Value {
  if (!valid(r, v) || !bounded(delta)) {
    return unknown();
  }
  return checked(r, Value { factor: v.factor, offset: v.offset + delta });
}

pub function times_eight(r: Interval, v: Value): Value {
  if (!valid(r, v) || v.factor != 0 && v.factor != 1) {
    return unknown();
  }
  return checked(r, Value { factor: v.factor * 8, offset: v.offset * (8 as i64) });
}

// A low half stays affine only when its quotient is constant over the entire
// interval. Refuse wrap-crossing intervals instead of sampling their ends.
pub function high32(r: Interval, v: Value): Value {
  if (!valid(r, v)) {
    return unknown();
  }
  let a = endpoint(v, r.low) / (4294967296 as i64);
  let b = endpoint(v, r.high) / (4294967296 as i64);
  return if (a == b) { number(r, a) } else { unknown() };
}

pub function low32(r: Interval, v: Value): Value {
  let high = high32(r, v);
  return if (valid(r, high)) { add(r, v, -high.offset * (4294967296 as i64)) } else { unknown() };
}

pub function join32(r: Interval, low: Value, high: Value): Value {
  if (!valid(r, low) || !valid(r, high) || high.factor != 0) {
    return unknown();
  }
  if (endpoint(low, r.high) > 4294967295 as i64 || high.offset > 8 as i64) {
    return unknown();
  }
  return add(r, low, high.offset * (4294967296 as i64));
}

function truth(always: boolean, never: boolean): i32 {
  return if (always) { 1 } else { if (never) { 0 } else { -1 } };
}

// Correlated mathematical predicates. Instruction width and flag semantics
// remain the responsibility of a private machine consumer.
pub function compare(r: Interval, v: Value, n: i64): Comparison {
  if (!valid(r, v) || !bounded(n)) {
    return Comparison { less: -1, equal: -1, less_equal: -1 };
  }
  let a = endpoint(v, r.low);
  let b = endpoint(v, r.high);
  return Comparison { less: truth(b < n, a >= n), equal: truth(a == n && b == n, n < a || n > b), less_equal: truth(b <= n, a > n) };
}

function class_at(c: i64, capacities: i32[]): i32 {
  let bytes = (c + 3 as i64) * (8 as i64);
  let index = 0;
  for size in capacities {
    if (bytes <= size as i64) {
      return index;
    }
    index = index + 1;
  }
  return -2;
}

// -2 is uniformly oversized (no recycling), -1 is invalid or crosses classes.
pub function expected_class(r: Interval): i32 {
  if (!valid_interval(r)) {
    return -1;
  }
  let capacities = bins.capacities();
  let a = class_at(r.low, capacities);
  return if (a == class_at(r.high, capacities)) { a } else { -1 };
}

pub function intervals(): Interval[] {
  let result: Interval[] = [];
  let low = 65533 as i64;
  for size in bins.capacities() {
    let high = size as i64 / (8 as i64) - 3 as i64;
    result = result.append(Interval { low: low, high: high });
    low = high + 1 as i64;
  }
  // Split oversized inputs at every byte-argument low32 wrap. The final cut
  // is also the C+3 low32 wrap, so both expressions have exact paired halves.
  let index = 1 as i64;
  while (index <= 8 as i64) {
    let cut = index * (536870912 as i64) - 3 as i64;
    result = result.append(Interval { low: low, high: cut - 1 as i64 });
    low = cut;
    index = index + 1 as i64;
  }
  return result.append(Interval { low: low, high: 4294967295 as i64 });
}
