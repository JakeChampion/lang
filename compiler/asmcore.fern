function sockaddr_un(t: string): string {
  let head: string = "__raw_store8(sa, 0, 1); __raw_store8(sa, 1, 0);";
  if (t == "arm64-darwin") {
    head = "__raw_store8(sa, 0, n + 3); __raw_store8(sa, 1, 1);";
  }
  return "let n: i32 = path.len(); let sa: usize = __raw_scratch(112); " + head + " let p: usize = __raw_data(path); let i: i32 = 0; while (i < n) { __raw_store8(sa, 2 + i, __raw_load8(p, i)); i = i + 1; } __raw_store8(sa, 2 + n, 0);";
}

function sun_path_guard(t: string): string {
  if (t == "arm64-darwin") {
    return "if (path.len() > 103) { return 0 - 63; }";
  }
  return "if (path.len() > 107) { return 0 - 36; }";
}

pub function rt_src_unix_listen(t: string): string {
  return "function __fern_unix_listen(path: string, backlog: i32): i32 { " + sun_path_guard(t) + " let fd: i32 = __syscall3(" + sysno(t, "socket") + ", 1, 1, 0) as i32; if (fd < 0) { return fd; } " + sockaddr_un(t) + " let r: i32 = __syscall3(" + sysno(t, "bind") + ", fd as i64, sa as i64, (n + 3) as i64) as i32; if (r >= 0) { r = __syscall3(" + sysno(t, "listen") + ", fd as i64, backlog as i64, 0) as i32; } if (r < 0) { __syscall3(" + sysno(t, "close") + ", fd as i64, 0, 0); return r; } return fd; }";
}

pub function rt_src_unix_connect(t: string): string {
  return "function __fern_unix_connect(path: string): i32 { " + sun_path_guard(t) + " let fd: i32 = __syscall3(" + sysno(t, "socket") + ", 1, 1, 0) as i32; if (fd < 0) { return fd; } " + sockaddr_un(t) + " let r: i32 = __syscall3(" + sysno(t, "connect") + ", fd as i64, sa as i64, (n + 3) as i64) as i32; if (r < 0) { __syscall3(" + sysno(t, "close") + ", fd as i64, 0, 0); return r; } return fd; }";
}

pub function rt_src_tcp_send_bytes(t: string, packed: boolean): string {
  let flags: string = "16384";
  if (t == "arm64-darwin") {
    flags = "524288";
  }
  let prep: string = "let p: usize = (__raw_arr_ptr(bytes) + 8);";
  if (!packed) {
    prep = "let raw: usize = __raw_arr_box(n / 8 + 1); let scratch: i32[] = __raw_array(raw); let p: usize = (__raw_arr_ptr(scratch) + 8); let j: i32 = 0; while (j < n) { __raw_store8(p, j, bytes[j]); j = j + 1; }";
  }
  return "function __fern_tcp_send_bytes" + packed_suffix(packed) + "(fd: i32, bytes: i32[]): i32 { let n: i32 = bytes.len(); " + prep + " return __syscall6(" + sysno(t, "sendto") + ", fd as i64, p as i64, n as i64, " + flags + ", 0, 0) as i32; }";
}

pub function rt_src_tcp_send_buf(t: string): string {
  let flags: string = "16384";
  if (t == "arm64-darwin") {
    flags = "524288";
  }
  return "function __fern_tcp_send_buf(fd: i32, b: usize, from: i32): i32 { let n: i32 = __raw_load_ptr(b, 1) as i32; if (from < 0 || from >= n) { return 0; } let data: usize = __raw_load_ptr(b, 0); let p: usize = data + from; return __syscall6(" + sysno(t, "sendto") + ", fd as i64, p as i64, (n - from) as i64, " + flags + ", 0, 0) as i32; }";
}

pub function rt_src_print_str(t: string): string {
  return "function __fern_print_str(s: string): i32 { return __syscall3(" + sysno(t, "write") + ", 1, __raw_data(s) as i64, s.len() as i64) as i32; }";
}

pub function rt_src_eprint_str(t: string): string {
  return "function __fern_eprint_str(s: string): i32 { let iov: usize = __raw_scratch(33); __raw_store8(iov, 32, 10); __raw_store_ptr(iov, 0, __raw_data(s)); __raw_store_ptr(iov, 1, s.len() as usize); __raw_store_ptr(iov, 2, iov + 32); __raw_store_ptr(iov, 3, 1 as usize); return __syscall3(" + sysno(t, "writev") + ", 2, iov as i64, 2) as i32; }";
}

pub function rt_src_putchar(t: string): string {
  return "function __fern_putchar(c: i32): i32 { let p: usize = __raw_scratch(1); __raw_store8(p, 0, c & 255); return __syscall3(" + sysno(t, "write") + ", 1, p as i64, 1) as i32; }";
}

pub function rt_src_reader_read_chunk(t: string): string {
  return "function __fern_reader_read_chunk(fd: i32, n: i32): Result[string, IoError] { if (n < 0) { return Err(__fern_io_error(22, \"\")); } let p: usize = __raw_alloc(n); let r: i32 = __syscall3(" + sysno(t, "read") + ", fd as i64, p as i64, n as i64) as i32; if (r > 0 && __fern_utf8_valid(p, r) == 0) { let invalid: string = __raw_string(p, n); return Err(InvalidUtf8(\"\")); } if (r == n) { return Ok(__raw_string(p, n)); } if (r <= 0) { let short: string = __raw_string(p, n); if (r < 0) { return Err(__fern_io_error(0 - r, \"\")); } return Ok(\"\"); } let q: usize = __raw_alloc(r); __memcpy(q, p, r); let full: string = __raw_string(p, n); return Ok(__raw_string(q, r)); }";
}

pub function rt_src_reader_read_chunk_bytes(t: string, packed: boolean): string {
  let copy: string = "";
  let finish: string = "let b: usize = __raw_arr_box(got); let j: i32 = 0; while (j < got) { __raw_store_ptr(b, j + 1, __raw_load8(p, j) as usize); j = j + 1; } return Ok(__raw_array(b));";
  if (packed) {
    copy = "function __fern_reader_short_bytes(scratch: i32[], got: i32): i32[] { let short: usize = __raw_arr_box(got / 8 + 1); __memcpy(short + 8, (__raw_arr_ptr(scratch) + 8), got); __store_i64(short, got as i64); return __raw_array(short); } ";
    finish = "if (got == n) { __store_i64(raw, got as i64); return Ok(scratch); } if (got == 0) { return Ok([]); } return Ok(__fern_reader_short_bytes(scratch, got));";
  }
  return copy + "function __fern_reader_read_chunk_bytes" + packed_suffix(packed) + "(fd: i32, n: i32): Result[i32[], IoError] { if (n < 0) { return Err(__fern_io_error(22, \"\")); } let raw: usize = __raw_arr_box(n / 8 + 1); let scratch: i32[] = __raw_array(raw); let p: usize = raw + 8; let got: i32 = __syscall3(" + sysno(t, "read") + ", fd as i64, p as i64, n as i64) as i32; if (got < 0) { return Err(__fern_io_error(0 - got, \"\")); } " + finish + " }";
}

pub function rt_src_reader_close(t: string): string {
  return "function __fern_reader_close(fd: i32): Result[void, IoError] { let r: i32 = __syscall3(" + sysno(t, "close") + ", fd as i64, 0, 0) as i32; if (r < 0) { return Err(__fern_io_error(0 - r, \"\")); } return Ok(()); }";
}

