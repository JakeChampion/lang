pub function rt_src_reactor_wait(t: string): string {
  let wait: string = "";
  if (t == "arm64-darwin") {
    wait = kqueue_wait_src(t);
  } else {
    wait = epoll_wait_src(t);
  }
  return "function __fern_reactor_wait(r_fd: i32, events: i32[], timeout_ms: i32): i32 { let cap: i32 = events.len() / 2; if (cap <= 0) { return 0 - 22; } " + wait + " }";
}

