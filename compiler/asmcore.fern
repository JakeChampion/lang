pub function rt_src_tcp_local_port(t: string): string {
  return "function __fern_tcp_local_port(fd: i32): i32 { let sa: usize = __raw_scratch(20); __raw_store8(sa, 16, 16); __raw_store8(sa, 17, 0); __raw_store8(sa, 18, 0); __raw_store8(sa, 19, 0); let r: i32 = __syscall3(" + sysno(t, "getsockname") + ", fd as i64, sa as i64, (sa + 16) as i64) as i32; if (r < 0) { return r; } return (__raw_load8(sa, 2) << 8) | __raw_load8(sa, 3); }";
}

pub function rt_src_sleep_ms(t: string): string {
  if (t == "arm64-darwin") {
    return "function __fern_sleep_ms(ms: i64): i32 { if (ms <= (0 as i64)) { return 0; } let tv: usize = __raw_scratch(16); let sec: i64 = ms / (1000 as i64); __store_i64(tv, sec); __store_i64(tv + 8, (ms - sec * (1000 as i64)) * (1000 as i64)); return __syscall5(" + sysno(t, "select") + ", 0, 0, 0, 0, tv as i64) as i32; }";
  }
  return "function __fern_sleep_ms(ms: i64): i32 { if (ms <= (0 as i64)) { return 0; } let ts: usize = __raw_scratch(16); let sec: i64 = ms / (1000 as i64); __store_i64(ts, sec); __store_i64(ts + 8, (ms - sec * (1000 as i64)) * (1000000 as i64)); return __syscall3(" + sysno(t, "nanosleep") + ", ts as i64, 0, 0) as i32; }";
}

pub function rt_src_sleep_ns(t: string): string {
  if (t == "arm64-darwin") {
    return "function __fern_sleep_ns(ns: i64): i32 { if (ns <= (0 as i64)) { return 0; } let tv: usize = __raw_scratch(16); let sec: i64 = ns / (1000000000 as i64); let usec: i64 = (ns - sec * (1000000000 as i64) + (999 as i64)) / (1000 as i64); if (usec == (1000000 as i64)) { sec = sec + (1 as i64); usec = 0 as i64; } __store_i64(tv, sec); __store_i64(tv + 8, usec); return __syscall5(" + sysno(t, "select") + ", 0, 0, 0, 0, tv as i64) as i32; }";
  }
  return "function __fern_sleep_ns(ns: i64): i32 { if (ns <= (0 as i64)) { return 0; } let ts: usize = __raw_scratch(16); let sec: i64 = ns / (1000000000 as i64); __store_i64(ts, sec); __store_i64(ts + 8, ns - sec * (1000000000 as i64)); return __syscall3(" + sysno(t, "nanosleep") + ", ts as i64, 0, 0) as i32; }";
}

pub function rt_src_poll(t: string): string {
  let call: string = "";
  if (t == "arm64-darwin") {
    return rt_src_poll_kqueue(t);
  }
  if (t == "x86-64-linux") {
    call = "__syscall3(" + sysno(t, "poll") + ", buf as i64, n as i64, timeout_ms as i64);";
  } else {
    call = "let tmo: usize = 0 as usize; if (timeout_ms >= 0) { let ts: usize = __raw_scratch(16); __raw_store_ptr(ts, 0, (timeout_ms / 1000) as usize); __raw_store_ptr(ts, 1, ((timeout_ms % 1000) * 1000000) as usize); tmo = ts; } __syscall5(" + sysno(t, "ppoll") + ", buf as i64, n as i64, tmo as i64, 0, 0);";
  }
  return "function __fern_poll(fds: i32[], timeout_ms: i32): i32 { let n: i32 = fds.len(); if (n <= 0) { return 0 - 1; } let buf: usize = __raw_alloc(n * 8); let i: i32 = 0; while (i < n) { __raw_store_ptr(buf, i, fds[i] as usize); __raw_store8(buf, i * 8 + 4, 1); __raw_store8(buf, i * 8 + 5, 0); __raw_store8(buf, i * 8 + 6, 0); __raw_store8(buf, i * 8 + 7, 0); i = i + 1; } " + call + " let hit: i32 = 0 - 1; let j: i32 = 0; while (j < n) { if (hit < 0) { if ((__raw_load8(buf, j * 8 + 6) & 57) != 0) { hit = j; } } j = j + 1; } let buf_own: string = __raw_string(buf, n * 8); return hit; }";
}

function rt_src_poll_kqueue(t: string): string {
  return "function __fern_poll(fds: i32[], timeout_ms: i32): i32 { "
    + "let n: i32 = fds.len(); if (n <= 0 || n > 33554431) { return 0 - 1; } "
    + "let count: i32 = 0; for fd in fds { if (fd >= 0) { count = count + 1; } } if (count == 0) { return 0 - 1; } "
    + "let kq: i32 = __syscall3(" + sysno(t, "kqueue") + ", 0, 0, 0) as i32; if (kq < 0) { return 0 - 1; } "
    + "let buf: usize = __raw_alloc(count * 64); let events: usize = buf + count * 32; "
    + "let i: i32 = n - 1; let c: i32 = 0; while (i >= 0) { if (fds[i] >= 0) { "
    + "__raw_store_ptr(buf, c * 4, fds[i] as usize); __raw_store_ptr(buf, c * 4 + 1, 4325375); "
    + "__raw_store_ptr(buf, c * 4 + 2, 0); __raw_store_ptr(buf, c * 4 + 3, i as usize); c = c + 1; } i = i - 1; } "
    + "let ts: usize = __raw_scratch(16); __raw_store_ptr(ts, 0, 0); __raw_store_ptr(ts, 1, 0); "
    + "let receipts: i32 = __syscall6(" + sysno(t, "kevent") + ", kq as i64, buf as i64, count as i64, events as i64, count as i64, ts as i64) as i32; "
    + "let valid: i32 = 0; let bad: i32 = 0 - 1; let r: i32 = 0; let wait_ms: i32 = timeout_ms; while (r < receipts) { "
    + "if (__raw_load_ptr(events, r * 4 + 2) == 0) { valid = valid + 1; } else { wait_ms = 0; "
    + "let at: i32 = __raw_load_ptr(events, r * 4 + 3) as i32; if (bad < 0 || at < bad) { bad = at; } } r = r + 1; } "
    + "let got: i32 = 0; if (valid > 0) { let tmo: usize = 0 as usize; if (wait_ms >= 0) { "
    + "__raw_store_ptr(ts, 0, (wait_ms / 1000) as usize); __raw_store_ptr(ts, 1, ((wait_ms % 1000) * 1000000) as usize); tmo = ts; } "
    + "got = __syscall6(" + sysno(t, "kevent") + ", kq as i64, 0, 0, events as i64, count as i64, tmo as i64) as i32; } "
    + "__syscall3(" + sysno(t, "close") + ", kq as i64, 0, 0); let hit: i32 = bad; let j: i32 = 0; "
    + "while (j < got) { if ((__raw_load8(events, j * 32 + 11) & 64) == 0) { "
    + "let idx: i32 = __raw_load_ptr(events, j * 4 + 3) as i32; if (hit < 0 || idx < hit) { hit = idx; } } j = j + 1; } "
    + "let buf_own: string = __raw_string(buf, count * 64); return hit; }";
}

pub function rt_src_proc_waitpid(t: string): string {
  return "function __fern_proc_waitpid(pid: i32): i32 { let st: usize = __raw_scratch(16); let rc: i32 = __syscall4(" + sysno(t, "wait4") + ", pid as i64, st as i64, 0, 0) as i32; if (rc < 0) { return rc; } let w: i32 = __load_i32(st); let sig: i32 = w & 127; if (sig != 0) { return sig + 128; } return (w >> 8) & 255; }";
}

pub function rt_src_proc_waitpid_status(t: string): string {
  return "function __fern_proc_waitpid_status(pid: i32): i32 { let st: usize = __raw_scratch(16); let rc: i32 = __syscall4(" + sysno(t, "wait4") + ", pid as i64, st as i64, 0, 0) as i32; if (rc < 0) { return rc; } return __load_i32(st); }";
}

pub function rt_src_ct_mark(): string {
  return "function __fern_ct_mark(bytes: usize, req: i64): i32 { let n: i32 = 0; let p: usize = 0; if (((bytes as i32) & 2) != 0) { let base: usize = bytes - 2; n = __load_i32(base + 8); p = __raw_load_ptr(base, 0); } else { n = __load_i32(bytes); p = bytes + 8; } "
    + "let a: usize = __raw_scratch(48); __store_i64(a, req); __store_i64(a + 8, p as i64); __store_i64(a + 16, n as i64); __store_i64(a + 24, 0 as i64); __store_i64(a + 32, 0 as i64); __store_i64(a + 40, 0 as i64); "
    + "return __raw_vg_request(a) as i32; }"
    + " function __fern_ct_secret(bytes: usize): i32 { return __fern_ct_mark(bytes, 1296236545 as i64); }"
    + " function __fern_ct_public(bytes: usize): i32 { return __fern_ct_mark(bytes, 1296236546 as i64); }";
}

pub function ct_mark_helper(declassify: i32): string {
  if (declassify == 1) {
    return "ct_public";
  }
  return "ct_secret";
}

pub function rt_src_proc_waitpid_nohang(t: string): string {
  return "function __fern_proc_waitpid_nohang(pid: i32): i32 { let st: usize = __raw_scratch(16); let rc: i32 = __syscall4(" + sysno(t, "wait4") + ", pid as i64, st as i64, 1, 0) as i32; if (rc < 0) { return rc; } if (rc == 0) { return 0 - 1; } let w: i32 = __load_i32(st); let sig: i32 = w & 127; if (sig != 0) { return sig + 128; } return (w >> 8) & 255; }";
}

pub function rt_src_proc_exec_as(t: string): string {
  return "function __fern_proc_exec_as(path: string, argv: string[], envp: string[]): i32 { let plen: i32 = path.len(); let pathz: usize = __raw_alloc(plen + 1); let i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i] as i32); i = i + 1; } __raw_store8(pathz, plen, 0); let an: i32 = argv.len(); let av: usize = __raw_alloc((an + 1) * 8); let atotal: i32 = 1; let am: i32 = 0; while (am < an) { atotal = atotal + argv[am].len() + 1; am = am + 1; } let ab: usize = __raw_alloc(atotal); let aoff: i32 = 0; let ak: i32 = 0; while (ak < an) { let aa: string = argv[ak]; let aal: i32 = aa.len(); __raw_store_ptr(av, ak, ab + aoff); let aj: i32 = 0; while (aj < aal) { __raw_store8(ab, aoff + aj, aa[aj] as i32); aj = aj + 1; } __raw_store8(ab, aoff + aal, 0); aoff = aoff + aal + 1; ak = ak + 1; } __raw_store_ptr(av, an, 0); let en: i32 = envp.len(); let ev: usize = __raw_alloc((en + 1) * 8); let etotal: i32 = 1; let em: i32 = 0; while (em < en) { etotal = etotal + envp[em].len() + 1; em = em + 1; } let eb: usize = __raw_alloc(etotal); let eoff: i32 = 0; let ek: i32 = 0; while (ek < en) { let ea: string = envp[ek]; let eal: i32 = ea.len(); __raw_store_ptr(ev, ek, eb + eoff); let ej: i32 = 0; while (ej < eal) { __raw_store8(eb, eoff + ej, ea[ej] as i32); ej = ej + 1; } __raw_store8(eb, eoff + eal, 0); eoff = eoff + eal + 1; ek = ek + 1; } __raw_store_ptr(ev, en, 0); let rc: i32 = __syscall3(" + sysno(t, "execve") + ", pathz as i64, av as i64, ev as i64) as i32; let pathz_own: string = __raw_string(pathz, plen + 1); let av_own: string = __raw_string(av, (an + 1) * 8); let ev_own: string = __raw_string(ev, (en + 1) * 8); let argv_own: string = __raw_string(ab, atotal); let envp_own: string = __raw_string(eb, etotal); return rc; }";
}

pub function rt_src_proc_exec(t: string): string {
  return "function __fern_proc_exec(path: string, args: string[]): i32 { let plen: i32 = path.len(); let pathz: usize = __raw_alloc(plen + 1); let i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i] as i32); i = i + 1; } __raw_store8(pathz, plen, 0); let n: i32 = args.len(); let argv: usize = __raw_alloc((n + 2) * 8); __raw_store_ptr(argv, 0, pathz); let total: i32 = 1; let m: i32 = 0; while (m < n) { total = total + args[m].len() + 1; m = m + 1; } let ab: usize = __raw_alloc(total); let off: i32 = 0; let k: i32 = 0; while (k < n) { let a: string = args[k]; let al: i32 = a.len(); __raw_store_ptr(argv, k + 1, ab + off); let j: i32 = 0; while (j < al) { __raw_store8(ab, off + j, a[j] as i32); j = j + 1; } __raw_store8(ab, off + al, 0); off = off + al + 1; k = k + 1; } __raw_store_ptr(argv, n + 1, 0); let rc: i32 = __syscall3(" + sysno(t, "execve") + ", pathz as i64, argv as i64, __raw_environ() as i64) as i32; let pathz_own: string = __raw_string(pathz, plen + 1); let argv_own: string = __raw_string(argv, (n + 2) * 8); let args_own: string = __raw_string(ab, total); return rc; }";
}

pub function rt_src_subprocess(t: string): string {
  let b: usize = buf_new(8192);
  buf_push(b, "function __fern_sp_drain(fd: i32, buf: usize): i32 { let got: i32 = 0; let done: i32 = 0; while (done == 0) { if (got >= 65536) { done = 1; } else { let n: i32 = __syscall3(");
  buf_push(b, sysno(t, "read"));
  buf_push(b, ", fd as i64, (buf + got) as i64, (65536 - got) as i64) as i32; if (n <= 0) { done = 1; } else { got = got + n; } } } __syscall3(");
  buf_push(b, sysno(t, "close"));
  buf_push(b, ", fd as i64, 0, 0); return got; }");
  buf_push(b, " ");
  buf_push(b, "function __fern_sp_exec_at(pre: usize, plen: i32, cmdz: usize, clen: i32, argv: usize, envp: usize): i32 { let b: usize = __raw_alloc(plen + clen + 1); let i: i32 = 0; while (i < plen) { __raw_store8(b, i, __raw_load8(pre, i)); i = i + 1; } let j: i32 = 0; while (j < clen) { __raw_store8(b, plen + j, __raw_load8(cmdz, j)); j = j + 1; } __raw_store8(b, plen + clen, 0); return __syscall3(");
  buf_push(b, sysno(t, "execve"));
  buf_push(b, ", b as i64, argv as i64, envp as i64) as i32; }");
  buf_push(b, " ");
  buf_push(b, rt_src_sp_exec_failed(t));
  buf_push(b, " ");
  buf_push(b, "function __fern_subprocess(cmd: string, args: string[], input: string): ProcessResult { let clen: i32 = cmd.len(); let cmdz: usize = __raw_alloc(clen + 1); let i: i32 = 0; while (i < clen) { __raw_store8(cmdz, i, cmd[i] as i32); i = i + 1; } __raw_store8(cmdz, clen, 0); let n: i32 = args.len(); let argv: usize = __raw_alloc((n + 2) * 8); __raw_store_ptr(argv, 0, cmdz); let total: i32 = 1; let m: i32 = 0; while (m < n) { total = total + args[m].len() + 1; m = m + 1; } let ab: usize = __raw_alloc(total); let off: i32 = 0; let k: i32 = 0; while (k < n) { let a: string = args[k]; let al: i32 = a.len(); __raw_store_ptr(argv, k + 1, ab + off); let j: i32 = 0; while (j < al) { __raw_store8(ab, off + j, a[j] as i32); j = j + 1; } __raw_store8(ab, off + al, 0); off = off + al + 1; k = k + 1; } __raw_store_ptr(argv, n + 1, 0); ");
  buf_push(b, "let fds: usize = __raw_alloc(32); __syscall3(");
  buf_push(b, sysno(t, "pipe2"));
  buf_push(b, ", fds as i64, 0, 0); __syscall3(");
  buf_push(b, sysno(t, "pipe2"));
  buf_push(b, ", (fds + 8) as i64, 0, 0); __syscall3(");
  buf_push(b, sysno(t, "pipe2"));
  buf_push(b, ", (fds + 16) as i64, 0, 0); let in_r: i32 = __load_i32(fds); let in_w: i32 = __load_i32(fds + 4); let out_r: i32 = __load_i32(fds + 8); let out_w: i32 = __load_i32(fds + 12); let err_r: i32 = __load_i32(fds + 16); let err_w: i32 = __load_i32(fds + 20); let pid: i32 = (");
  buf_push(b, fork_expr(t));
  buf_push(b, ") as i32; ");
  buf_push(b, "if (pid == 0) { __syscall3(");
  buf_push(b, sysno(t, "dup3"));
  buf_push(b, ", in_r as i64, 0, 0); __syscall3(");
  buf_push(b, sysno(t, "dup3"));
  buf_push(b, ", out_w as i64, 1, 0); __syscall3(");
  buf_push(b, sysno(t, "dup3"));
  buf_push(b, ", err_w as i64, 2, 0); __syscall3(");
  buf_push(b, sysno(t, "close"));
  buf_push(b, ", in_r as i64, 0, 0); __syscall3(");
  buf_push(b, sysno(t, "close"));
  buf_push(b, ", in_w as i64, 0, 0); __syscall3(");
  buf_push(b, sysno(t, "close"));
  buf_push(b, ", out_r as i64, 0, 0); __syscall3(");
  buf_push(b, sysno(t, "close"));
  buf_push(b, ", out_w as i64, 0, 0); __syscall3(");
  buf_push(b, sysno(t, "close"));
  buf_push(b, ", err_r as i64, 0, 0); __syscall3(");
  buf_push(b, sysno(t, "close"));
  buf_push(b, ", err_w as i64, 0, 0); let envp: usize = __raw_environ(); let rc0: i32 = __syscall3(");
  buf_push(b, sysno(t, "execve"));
  buf_push(b, ", cmdz as i64, argv as i64, envp as i64) as i32; let pre: usize = __raw_alloc(9); __raw_store8(pre, 0, 47); __raw_store8(pre, 1, 98); __raw_store8(pre, 2, 105); __raw_store8(pre, 3, 110); __raw_store8(pre, 4, 47); __fern_sp_exec_at(pre, 5, cmdz, clen, argv, envp); __raw_store8(pre, 1, 117); __raw_store8(pre, 2, 115); __raw_store8(pre, 3, 114); __raw_store8(pre, 4, 47); __raw_store8(pre, 5, 98); __raw_store8(pre, 6, 105); __raw_store8(pre, 7, 110); __raw_store8(pre, 8, 47); __fern_sp_exec_at(pre, 9, cmdz, clen, argv, envp); __fern_sp_exec_failed(cmdz, clen, rc0); } ");
  buf_push(b, "__syscall3(");
  buf_push(b, sysno(t, "close"));
  buf_push(b, ", in_r as i64, 0, 0); __syscall3(");
  buf_push(b, sysno(t, "close"));
  buf_push(b, ", out_w as i64, 0, 0); __syscall3(");
  buf_push(b, sysno(t, "close"));
  buf_push(b, ", err_w as i64, 0, 0); if (input.len() > 0) { __syscall3(");
  buf_push(b, sysno(t, "write"));
  buf_push(b, ", in_w as i64, __raw_data(input) as i64, input.len() as i64); } __syscall3(");
  buf_push(b, sysno(t, "close"));
  buf_push(b, ", in_w as i64, 0, 0); let obuf: usize = __raw_alloc(65536); let olen: i32 = __fern_sp_drain(out_r, obuf); let ebuf: usize = __raw_alloc(65536); let elen: i32 = __fern_sp_drain(err_r, ebuf); __syscall4(");
  buf_push(b, sysno(t, "wait4"));
  buf_push(b, ", pid as i64, (fds + 24) as i64, 0, 0); let w: i32 = __load_i32(fds + 24); let code: i32 = (w >> 8) & 255; if ((w & 127) != 0) { code = (w & 127) + 128; } let fds_own: string = __raw_string(fds, 32); let cmdz_own: string = __raw_string(cmdz, clen + 1); let ab_own: string = __raw_string(ab, total); let argv_own: string = __raw_string(argv, (n + 2) * 8); let sout: string = \"\"; if (olen > 0) { let so: usize = __raw_alloc(olen); __memcpy(so, obuf, olen); sout = __raw_string(so, olen); } let serr: string = \"\"; if (elen > 0) { let se: usize = __raw_alloc(elen); __memcpy(se, ebuf, elen); serr = __raw_string(se, elen); } let obuf_own: string = __raw_string(obuf, 65536); let ebuf_own: string = __raw_string(ebuf, 65536); return ProcessResult { stdout: sout, stderr: serr, exit_code: code }; }");
  let out: string = buf_take(b);
  buf_free(b);
  return out;
}

function exec_errnos(): i32[] {
  return [1, 2, 5, 7, 8, 12, 13, 14, 20, 21, 22, 23, 24, 26, 36, 40];
}

pub function rt_src_sp_exec_failed(t: string): string {
  let src: string = "function __fern_sp_exec_failed(cmdz: usize, clen: i32, rc: i32): void { let e: i32 = 0 - rc; " + strerror_unknown_text_src(t) + " let text: string = unknown;";
  let linux: i32[] = strerror_linux();
  for n in exec_errnos() {
    let i: i32 = 0;
    while (i < linux.len()) {
      if (linux[i] == n) {
        src = src + " if (e == " + util.i32_to_string(strerror_errno(t, i)) + ") { text = \"" + strerror_text(t, i) + "\"; }";
      }
      i = i + 1;
    }
  }
  return src + " let tail: string = \": \" + text + \"\\n\"; __syscall3(" + sysno(t, "write") + ", 2, cmdz as i64, clen as i64); __syscall3(" + sysno(t, "write") + ", 2, __raw_data(tail) as i64, tail.len() as i64); __syscall3(" + sysno(t, "exit") + ", 127, 0, 0); }";
}

pub function rt_src_proc_fork(t: string): string {
  return "function __fern_proc_fork(): i32 { return (" + fork_expr(t) + ") as i32; }";
}

function fork_expr(t: string): string {
  if (t == "x86-64-linux") {
    return "__syscall3(" + sysno(t, "fork") + ", 0, 0, 0)";
  }
  return "__syscall5(" + sysno(t, "clone") + ", 17, 0, 0, 0, 0)";
}

pub function rt_src_timer_fd(t: string): string {
  if (t == "arm64-darwin") {
    return "function __fern_timer_fd(ms: i32): i32 { return 0 - 1; }";
  }
  return "function __fern_timer_fd(ms: i32): i32 { let fd: i32 = __syscall3(" + sysno(t, "timerfd_create") + ", 1, 0, 0) as i32; if (fd < 0) { return fd; } let its: usize = __raw_scratch(32); __raw_store_ptr(its, 0, 0); __raw_store_ptr(its, 1, 0); __raw_store_ptr(its, 2, (ms / 1000) as usize); __raw_store_ptr(its, 3, ((ms % 1000) * 1000000) as usize); __syscall4(" + sysno(t, "timerfd_settime") + ", fd as i64, 0, its as i64, 0); return fd; }";
}

pub function rt_src_isatty(t: string): string {
  let ioctl: string = "__syscall3(" + sysno(t, "ioctl") + ", fd as i64, ";
  let attrs: string = "if (" + ioctl + "21505, buf as i64) == (0 as i64)) { return 1; } return 0;";
  if (t == "arm64-darwin") {
    attrs = "if (" + ioctl + "1074030202, buf as i64) == (0 as i64)) { if (__raw_load8(buf, 0) == 3 && __raw_load8(buf, 1) == 0 && __raw_load8(buf, 2) == 0 && __raw_load8(buf, 3) == 0) { return 1; } return 0; } if (" + ioctl + "1078490131, buf as i64) == (0 as i64)) { return 1; } return 0;";
  }
  return "function __fern_isatty(fd: i32): i32 { let buf: usize = __raw_scratch(80); " + attrs + " }";
}

pub function rt_src_window_size(t: string): string {
  let req: string = "21523";
  if (t == "arm64-darwin") {
    req = "1074295912";
  }
  return "function __fern_window_size(fd: i32): Result[WinSize, IoError] { let buf: usize = __raw_scratch(16); let rc: i32 = __syscall3(" + sysno(t, "ioctl") + ", fd as i64, " + req + ", buf as i64) as i32; if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } let r: i32 = __raw_load8(buf, 0) + __raw_load8(buf, 1) * 256; let c: i32 = __raw_load8(buf, 2) + __raw_load8(buf, 3) * 256; return Ok(WinSize { rows: (r as i64), cols: (c as i64) }); }";
}

pub function rt_src_termios_get(t: string): string {
  if (t == "arm64-darwin") {
    return "function __fern_termios_get(fd: i32): Result[i64[], IoError] { let buf: usize = __raw_alloc(72); let rc: i32 = __syscall3(" + sysno(t, "ioctl") + ", fd as i64, 1078490131, buf as i64) as i32; if (rc < 0) { let buf_own0: string = __raw_string(buf, 72); return Err(__fern_io_error(0 - rc, \"\")); } let out: i64[] = []; let i: i32 = 0; while (i < 26) { if (i < 4 || i >= 24) { let off: i32 = i * 8; if (i >= 24) { off = 56 + (i - 24) * 8; } let v: i64 = 0 as i64; let k: i32 = 7; while (k >= 0) { v = (v << 8) | (__raw_load8(buf, off + k) as i64); k = k - 1; } out = out.append(v); } else { out = out.append(__raw_load8(buf, 28 + i) as i64); } i = i + 1; } let buf_own: string = __raw_string(buf, 72); return Ok(out); }";
  }
  return "function __fern_termios_get(fd: i32): Result[i64[], IoError] { let buf: usize = __raw_alloc(36); let rc: i32 = __syscall3(" + sysno(t, "ioctl") + ", fd as i64, 21505, buf as i64) as i32; if (rc < 0) { let buf_own0: string = __raw_string(buf, 36); return Err(__fern_io_error(0 - rc, \"\")); } let out: i64[] = []; let i: i32 = 0; while (i < 4) { let b0: i64 = (__raw_load8(buf, i * 4) as i64); let b1: i64 = (__raw_load8(buf, i * 4 + 1) as i64); let b2: i64 = (__raw_load8(buf, i * 4 + 2) as i64); let b3: i64 = (__raw_load8(buf, i * 4 + 3) as i64); out = out.append(b0 + b1 * 256 + b2 * 65536 + b3 * 16777216); i = i + 1; } out = out.append(__raw_load8(buf, 16) as i64); let j: i32 = 0; while (j < 19) { out = out.append(__raw_load8(buf, 17 + j) as i64); j = j + 1; } let buf_own: string = __raw_string(buf, 36); return Ok(out); }";
}

pub function rt_src_termios_set(t: string): string {
  if (t == "arm64-darwin") {
    return "function __fern_termios_set(fd: i32, act: i32, words: i64[]): Result[void, IoError] { if (words.len() != 26 || act < 0 || act > 2) { return Err(__fern_io_error(22, \"\")); } let buf: usize = __raw_alloc(72); let z: i32 = 0; while (z < 72) { __raw_store8(buf, z, 0); z = z + 1; } let i: i32 = 0; while (i < 26) { let v: i64 = words[i]; if (i < 4 || i >= 24) { let off: i32 = i * 8; if (i >= 24) { off = 56 + (i - 24) * 8; } let k: i32 = 0; while (k < 8) { __raw_store8(buf, off + k, ((v >> ((k * 8) as i64)) & (255 as i64)) as i32); k = k + 1; } } else { __raw_store8(buf, 28 + i, (v & (255 as i64)) as i32); } i = i + 1; } let rc: i32 = __syscall3(" + sysno(t, "ioctl") + ", fd as i64, (2152231956 as i64) + (act as i64), buf as i64) as i32; let buf_own: string = __raw_string(buf, 72); if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } return Ok(()); }";
  }
  return "function __fern_termios_set(fd: i32, act: i32, words: i64[]): Result[void, IoError] { if (words.len() != 24 || act < 0 || act > 2) { return Err(__fern_io_error(22, \"\")); } let buf: usize = __raw_alloc(36); let i: i32 = 0; while (i < 4) { let v: i64 = words[i]; __raw_store8(buf, i * 4, (v % 256) as i32); __raw_store8(buf, i * 4 + 1, ((v / 256) % 256) as i32); __raw_store8(buf, i * 4 + 2, ((v / 65536) % 256) as i32); __raw_store8(buf, i * 4 + 3, ((v / 16777216) % 256) as i32); i = i + 1; } __raw_store8(buf, 16, (words[4] % 256) as i32); let j: i32 = 0; while (j < 19) { __raw_store8(buf, 17 + j, (words[5 + j] % 256) as i32); j = j + 1; } let rc: i32 = __syscall3(" + sysno(t, "ioctl") + ", fd as i64, (21506 + act) as i64, buf as i64) as i32; let buf_own: string = __raw_string(buf, 36); if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } return Ok(()); }";
}

pub function rt_src_set_extproc(t: string): string {
  if (t != "arm64-darwin") {
    return "function __fern_set_extproc(fd: i32, on: boolean): Result[void, IoError] { return Err(__fern_io_error(25, \"\")); }";
