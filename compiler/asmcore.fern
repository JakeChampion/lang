pub function strerror_errno(t: string, i: i32): i32 {
  if (t == "arm64-darwin") {
    return strerror_darwin()[i];
  }
  return strerror_linux()[i];
}

function errno_on(t: string, linux: i32): string {
  let nums: i32[] = strerror_linux();
  let i: i32 = 0;
  while (i < nums.len()) {
    if (nums[i] == linux) {
      return util.i32_to_string(strerror_errno(t, i));
    }
    i = i + 1;
  }
  return util.i32_to_string(linux);
}

pub function strerror_text(t: string, i: i32): string {
  if (t == "arm64-darwin") {
    return strerror_texts_darwin()[i];
  }
  return strerror_texts()[i];
}

pub function strerror_unknown_prefix(t: string): string {
  if (t == "arm64-darwin") {
    return "Unknown error: ";
  }
  return "Unknown error ";
}

function strerror_unknown_src(t: string): string {
  return strerror_unknown_text_src(t) + " return Other(path, unknown, 0);";
}

function strerror_unknown_text_src(t: string): string {
  let pfx: string = strerror_unknown_prefix(t);
  let plen: string = util.i32_to_string(pfx.len());
  let src: string = "let ndig: i32 = 1; let tt: i32 = e; while (tt >= 10) { ndig = ndig + 1; tt = tt / 10; } let total: i32 = " + plen + " + ndig; let buf: usize = __raw_alloc(total);";
  let k: i32 = 0;
  while (k < pfx.len()) {
    src = src + " __raw_store8(buf, " + util.i32_to_string(k) + ", " + util.i32_to_string(pfx[k] as i32) + ");";
    k = k + 1;
  }
  return src + " let pos: i32 = total - 1; let v: i32 = e; while (pos >= " + plen + ") { __raw_store8(buf, pos, 48 + (v % 10)); v = v / 10; pos = pos - 1; } let unknown: string = __raw_string(buf, total);";
}

function path_copy_src(): string {
  return "function __fern_path_copy(z: string, n: i32): string { if (n == 0) { return \"\"; } let b: usize = __raw_alloc(n); let i: i32 = 0; while (i < n) { __raw_store8(b, i, z[i] as i32); i = i + 1; } return __raw_string(b, n); }";
}

pub function wasi_socket_error_errnos(): i32[] {
  return [29, 2, 58, 28, 48, 73, 7, 28, 6, 28, 33, 4, 3, 23, 14, 15, 13, 35, 44, 6, 29];
}

pub function rt_src_io_error(t: string): string {
  let texts: string[] = strerror_texts();
  let eilseq: i32 = strerror_errno(t, util.index_of_str(texts, "Invalid or incomplete multibyte or wide character"));
  let src: string = path_copy_src() + " function __fern_io_error(e: i32, path: string): IoError { if (e == 2) { return NotFound(path); } if (e == 13) { return PermissionDenied(path); } if (e == 17) { return AlreadyExists(path); } if (e == 4) { return Interrupted; } if (e == " + util.i32_to_string(eilseq) + ") { return InvalidUtf8(path); }";
  let carried: i32[] = strerror_carried();
  let i: i32 = 0;
  while (i < texts.len()) {
    let n: i32 = strerror_errno(t, i);
    if (n != 0 && n != 2 && n != 13 && n != 17 && n != 4 && n != eilseq) {
      src = src + " if (e == " + util.i32_to_string(n) + ") { return Other(path, \"" + strerror_text(t, i) + "\", " + util.i32_to_string(carried[i]) + "); }";
    }
    i = i + 1;
  }
  return src + " " + strerror_unknown_src(t) + " }";
}

pub function rt_src_buf_text(): string {
  return "function __fern_buf_text_part(data: usize, pos: i32, n: i32): i32 {\n"
    + "  let lead: i32 = __raw_load8(data, pos);\n"
    + "  if (lead < 128) { return 1; }\n"
    + "  let width: i32 = 0;\n"
    + "  if (lead >= 194 && lead <= 223) { width = 2; }\n"
    + "  else if (lead >= 224 && lead <= 239) { width = 3; }\n"
    + "  else if (lead >= 240 && lead <= 244) { width = 4; }\n"
    + "  let used: i32 = 1;\n"
    + "  while (used < width && used < n - pos) {\n"
    + "    let next: i32 = __raw_load8(data, pos + used);\n"
    + "    if (next < 128 || next > 191) { break; }\n"
    + "    if (used == 1 && (lead == 224 && next < 160 || lead == 237 && next > 159 || lead == 240 && next < 144 || lead == 244 && next > 143)) { break; }\n"
    + "    used = used + 1;\n"
    + "  }\n"
    + "  if (used == width) { return used; }\n"
    + "  return 0 - used;\n"
    + "}\n"
    + "function __fern_buf_take_text(h: usize): string {\n"
    + "  let wide: i64 = __load_i64(h + 8);\n"
    + "  if (wide < 0 as i64 || wide > 2147483647 as i64) {\n"
    + "    let failed: usize = __raw_alloc(0 - 1);\n"
    + "    return __raw_string(failed, 0);\n"
    + "  }\n"
    + "  let n: i32 = wide as i32;\n"
    + "  if (n == 0) { return \"\"; }\n"
    + "  let data: usize = __raw_load_ptr(h, 0);\n"
    + "  let total: i64 = wide;\n"
    + "  let i: i32 = 0;\n"
    + "  let changed: boolean = false;\n"
    + "  let mask: u64 = 9259542123273814144 as u64;\n"
    + "  while (i < n) {\n"
    + "    if (n - i >= 8) {\n"
    + "      if ((__load_i64(data + i) as u64 & mask) == 0 as u64) {\n"
    + "        i = i + 8;\n"
    + "        continue;\n"
    + "      }\n"
    + "    }\n"
    + "    let part: i32 = __fern_buf_text_part(data, i, n);\n"
    + "    if (part < 0) {\n"
    + "      total = total + (3 + part) as i64;\n"
    + "      changed = true;\n"
    + "      i = i - part;\n"
    + "    } else { i = i + part; }\n"
    + "  }\n"
    + "  if (total > 2147483647 as i64) {\n"
    + "    let failed: usize = __raw_alloc(0 - 1);\n"
    + "    return __raw_string(failed, 0);\n"
    + "  }\n"
    + "  let length: i32 = total as i32;\n"
    + "  let out: usize = __raw_alloc(length);\n"
    + "  if (!changed) {\n"
    + "    __memcpy(out, data, n);\n"
    + "  } else {\n"
    + "    i = 0;\n"
    + "    let start: i32 = 0;\n"
    + "    let written: i32 = 0;\n"
    + "    while (i < n) {\n"
    + "      if (n - i >= 8) {\n"
    + "        if ((__load_i64(data + i) as u64 & mask) == 0 as u64) {\n"
    + "          i = i + 8;\n"
    + "          continue;\n"
    + "        }\n"
    + "      }\n"
    + "      let part: i32 = __fern_buf_text_part(data, i, n);\n"
    + "      if (part < 0) {\n"
    + "        __memcpy(out + written, data + start, i - start);\n"
    + "        written = written + (i - start);\n"
    + "        __raw_store8(out, written, 239);\n"
    + "        __raw_store8(out, written + 1, 191);\n"
    + "        __raw_store8(out, written + 2, 189);\n"
    + "        written = written + 3;\n"
    + "        i = i - part;\n"
    + "        start = i;\n"
    + "      } else { i = i + part; }\n"
    + "    }\n"
    + "    __memcpy(out + written, data + start, n - start);\n"
    + "  }\n"
    + "  __store_i64(h + 8, 0 as i64);\n"
    + "  return __raw_string(out, length);\n"
    + "}\n";
}

pub function rt_src_utf8_valid(): string {
  return "function __fern_utf8_valid(buf: usize, n: i32): i32 { let high: i64 = (0 - 9187201950435737472) as i64; let retry: i32 = 0; let vector: i32 = 1; let i: i32 = 0; while (i < n) { if (vector == 1 && i >= 3) { vector = 0; i = __raw_utf8_blocks(buf, i, n); if (i < 0) { return 0; } } if (i >= retry) { let more: i32 = 1; while (more == 1 && i + 32 <= n) { let w: i64 = __load_i64(buf + i) | __load_i64(buf + i + 8) | __load_i64(buf + i + 16) | __load_i64(buf + i + 24); if ((w & high) == (0 as i64)) { i = i + 32; } else { more = 0; } } retry = i + 32; } let b0: i32 = 0; if (i < n) { b0 = __raw_load8(buf, i); } if (i >= n) { i = n; } else { if (b0 < 128) { i = i + 1; } else { if (b0 < 194) { return 0; } if (b0 < 224) { if (i + 2 > n) { return 0; } let c1: i32 = __raw_load8(buf, i + 1); if (c1 < 128) { return 0; } if (c1 > 191) { return 0; } i = i + 2; } else { if (b0 < 240) { if (i + 3 > n) { return 0; } let d1: i32 = __raw_load8(buf, i + 1); let d2: i32 = __raw_load8(buf, i + 2); if (d1 < 128) { return 0; } if (d1 > 191) { return 0; } if (d2 < 128) { return 0; } if (d2 > 191) { return 0; } if (b0 == 224) { if (d1 < 160) { return 0; } } if (b0 == 237) { if (d1 > 159) { return 0; } } i = i + 3; } else { if (b0 > 244) { return 0; } if (i + 4 > n) { return 0; } let e1: i32 = __raw_load8(buf, i + 1); let e2: i32 = __raw_load8(buf, i + 2); let e3: i32 = __raw_load8(buf, i + 3); if (e1 < 128) { return 0; } if (e1 > 191) { return 0; } if (e2 < 128) { return 0; } if (e2 > 191) { return 0; } if (e3 < 128) { return 0; } if (e3 > 191) { return 0; } if (b0 == 240) { if (e1 < 144) { return 0; } } if (b0 == 244) { if (e1 > 143) { return 0; } } i = i + 4; } } } } } return 1; }";
}

pub function rt_src_remove_file(t: string): string {
  return void_path_leaf_src("__fern_remove_file(path: string)", "", "__syscall3(" + sysno(t, "unlinkat") + ", " + at_fdcwd(t) + ", pathz as i64, 0)");
}

function void_path_leaf_src(sig: string, prelude: string, call: string): string {
  return "function " + sig + ": Result[void, IoError] { let plen: i32 = path.len(); let pathz: usize = __raw_alloc(plen + 1); let i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i] as i32); i = i + 1; } __raw_store8(pathz, plen, 0); " + prelude + "let rc: i32 = " + call + " as i32; let pathz_own: string = __raw_string(pathz, plen + 1); if (rc < 0) { return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen))); } return Ok(()); }";
}

pub function rt_src_open_dir(t: string): string {
  return open_dir_src(t, "__fern_open_dir(path: string)", at_fdcwd(t), "");
}

pub function rt_src_dir_open(t: string): string {
  return open_dir_src(t, "__fern_dir_open(dirfd: i32, path: string)", "dirfd", " | " + oflag(t, "nofollow"));
}

function open_dir_src(t: string, sig: string, dirfd: string, extra: string): string {
  let flags: string = "(" + oflag(t, "rd_directory") + " | " + oflag(t, "cloexec") + extra + ")";
  return "function " + sig + ": Result[i32, IoError] { let plen: i32 = path.len(); let pathz: usize = __raw_alloc(plen + 1); let i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i] as i32); i = i + 1; } __raw_store8(pathz, plen, 0); let fd: i32 = __syscall3(" + sysno(t, "openat") + ", " + dirfd + " as i64, pathz as i64, " + flags + " as i64) as i32; let pathz_own: string = __raw_string(pathz, plen + 1); if (fd < 0) { return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen))); } return Ok(fd); }";
}

pub function rt_src_dir_unlink(t: string): string {
  return void_path_leaf_src("__fern_dir_unlink(dirfd: i32, path: string, dir: boolean)", "let fl: i32 = 0; if (dir) { fl = " + at_removedir(t) + "; } ", "__syscall3(" + sysno(t, "unlinkat") + ", dirfd as i64, pathz as i64, fl as i64)");
}

