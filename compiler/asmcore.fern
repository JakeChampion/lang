pub function ty_tag(t: Ty): string {
  match (t) {
    TyI32(_) => {
      return "i32";
    },
    TyU32(_) => {
      return "u32";
    },
    TyU64(_) => {
      return "u64";
    },
    TyI64(_) => {
      return "i64";
    },
    TyU8(_) => {
      return "u8";
    },
    TyUsize(_) => {
      return "usize";
    },
    TyBool(_) => {
      return "bool";
    },
    TyString(_) => {
      return "string";
    },
    TyF64(_) => {
      return "f64";
    },
    TyStruct(_) => {
      return "struct";
    },
    TyTuple(_) => {
      return "tuple";
    },
    TyUnknown(_) => {
      return "unknown";
    },
    TyArray(_) => {
      return "array";
    },
    TyArrayI32(_) => {
      return "array_i32";
    },
    TyArrayU32(_) => {
      return "array_u32";
    },
    TyArrayU64(_) => {
      return "array_u64";
    },
    TyArrayI64(_) => {
      return "array_i64";
    },
    TyArrayString(_) => {
      return "array_string";
    },
    TyFnAny(_) => {
      return "fn";
    },
    TyMapAny(_) => {
      return "map";
    },
    TyOption(x) => {
      return "option:" + ty_tag(x.inner);
    },
    TyResult(x) => {
      return "result:" + ty_tag(x.inner);
    },
    TyFn(x) => {
      return "fn_" + ty_tag(x.ret);
    },
    TyMapStr(x) => {
      return "map:" + ty_tag(x.val);
    },
    TyMapI32(x) => {
      return "mapI:" + ty_tag(x.val);
    },
    TyCell(x) => {
      return "cell:" + ty_tag(x.val);
    },
    TyStructNamed(x) => {
      return x.name;
    }
  }
  return "unknown";
}

pub function ty_eq(a: Ty, b: Ty): boolean {
  match (a) {
    TyOption(x) => {
      match (b) {
        TyOption(y) => {
          return ty_eq(x.inner, y.inner);
        },
        _ => {
          return false;
        }
      }
    },
    TyResult(x) => {
      match (b) {
        TyResult(y) => {
          return ty_eq(x.inner, y.inner);
        },
        _ => {
          return false;
        }
      }
    },
    TyFn(x) => {
      match (b) {
        TyFn(y) => {
          return ty_eq(x.ret, y.ret);
        },
        _ => {
          return false;
        }
      }
    },
    TyMapStr(x) => {
      match (b) {
        TyMapStr(y) => {
          return ty_eq(x.val, y.val);
        },
        _ => {
          return false;
        }
      }
    },
    TyMapI32(x) => {
      match (b) {
        TyMapI32(y) => {
          return ty_eq(x.val, y.val);
        },
        _ => {
          return false;
        }
      }
    },
    TyCell(x) => {
      match (b) {
        TyCell(y) => {
          return ty_eq(x.val, y.val);
        },
        _ => {
          return false;
        }
      }
    },
    TyStructNamed(x) => {
      match (b) {
        TyStructNamed(y) => {
          return x.name == y.name;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return ty_ord(a) == ty_ord(b);
    }
  }
  return false;
}

pub function ty_from_ref(t: parser.TypeRef): Ty {
  if (t.array_depth == 1 && !t.is_tuple && t.args.len() == 0) {
    if (t.base == "i32" || t.base == "char") {
      return ty_array_i32();
    }
    if (t.base == "u32") {
      return ty_array_u32();
    }
    if (t.base == "u64") {
      return ty_array_u64();
    }
    if (t.base == "i64") {
      return ty_array_i64();
    }
    if (t.base == "string") {
      return ty_array_string();
    }
    if (t.base == "bool" || t.base == "boolean") {
      return ty_array_i32();
    }
  }
  if (t.array_depth >= 1) {
    return ty_array();
  }
  if (t.is_tuple) {
    return ty_unknown();
  }
  if (t.args.len() > 0) {
    // Map[V] / Result[T] with only ONE arg (no comma in the
    if (t.base == "Map") {
      if (t.args.len() >= 2 && ty_is_i32(ty_from_ref(t.args[0]))) {
        return ty_map_i32(ty_from_ref(t.args[1]));
      }
      if (t.args.len() >= 2) {
        return ty_map_str(ty_from_ref(t.args[1]));
      }
      return ty_map_str(ty_unknown());
    }
    if (t.base == "Cell") {
      return ty_cell(ty_from_ref(t.args[0]));
    }
    if (t.base == "Option") {
      return ty_option(ty_from_ref(t.args[0]));
    }
    if (t.base == "Result") {
      if (t.args.len() >= 2) {
        return ty_result(ty_from_ref(t.args[0]));
      }
      return ty_result(ty_i32());
    }
    return ty_array();
  }
  if (t.base == "i32") {
    return ty_i32();
  }
  if (t.base == "char") {
    return ty_i32();
  }
  if (t.base == "u8") {
    return ty_u8();
  }
  if (t.base == "u32") {
    return ty_u32();
  }
  if (t.base == "u64") {
    return ty_u64();
  }
  if (t.base == "i64") {
    return ty_i64();
  }
  if (t.base == "usize") {
    return ty_usize();
  }
  if (t.base == "f64" || t.base == "f32") {
    return ty_f64();
  }
  if (t.base == "bool" || t.base == "boolean") {
    return ty_bool();
  }
  if (t.base == "string") {
    return ty_string();
  }
  if (t.base == "Map") {
    return ty_map_str(ty_unknown());
  }
  return ty_unknown();
}

pub function ty_from_name(name: string): Ty {
  return ty_from_ref(parser.parse_type_ref(name));
}

pub struct TwoTags { a: Ty, b: Ty }

pub function split_tuple_ret(tt: string): TwoTags {
  let t: parser.TypeRef = parser.parse_type_ref(tt);
  if (!t.is_tuple || t.args.len() < 2) {
    return TwoTags { a: ty_i32(), b: ty_i32() };
  }
  if (t.args.len() == 2) {
    return TwoTags { a: ty_from_ref(t.args[0]), b: ty_from_ref(t.args[1]) };
  }
  let rest: string = parser.render_type_ref(t.args[1]);
  let k: i32 = 2;
  while (k < t.args.len()) {
    rest = rest + ", " + parser.render_type_ref(t.args[k]);
    k = k + 1;
  }
  return TwoTags { a: ty_from_ref(t.args[0]), b: ty_from_name(rest) };
}

pub function tuple_ret_tag_at(tt: string, idx: i32): Ty {
  let t: parser.TypeRef = parser.parse_type_ref(tt);
  if (!t.is_tuple) {
    return ty_i32();
  }
  if (idx < t.args.len()) {
    return ty_from_ref(t.args[idx]);
  }
  return ty_i32();
}

pub function ty_friendly(t: Ty): string {
  match (t) {
    TyOption(x) => {
      return "Option[" + ty_friendly(x.inner) + "]";
    },
    TyResult(x) => {
      return "Result[" + ty_friendly(x.inner) + ", _]";
    },
    TyArrayI32(_) => {
      return "i32[]";
    },
    TyArrayU32(_) => {
      return "u32[]";
    },
    TyArrayU64(_) => {
      return "u64[]";
    },
    TyArrayI64(_) => {
      return "i64[]";
    },
    TyArrayString(_) => {
      return "string[]";
    },
    TyBool(_) => {
      return "boolean";
    },
    _ => {
      return ty_tag(t);
    }
  }
  return ty_tag(t);
}

function infer_call_method_type(fa: ast.ExprFieldAccess, c: ast.ExprCall, s: EmitState): Ty {
  let rt: Ty = infer_expr_type(fa.obj, s);
  if (ty_struct_name(rt) == "Reader" && fa.field == "read_chunk_bytes") {
    return ty_result(ty_array_i32());
  }
  if (ty_struct_name(rt) == "Reader" && fa.field == "read_chunk") {
    return ty_option(ty_string());
  }
  if ((ty_struct_name(rt) == "Reader" || ty_struct_name(rt) == "Writer") && fa.field == "stat") {
    return ty_result(ty_unknown());
  }
  if ((ty_struct_name(rt) == "Reader" || ty_struct_name(rt) == "Writer") && (fa.field == "seek" || fa.field == "flags")) {
    return ty_result(ty_i32());
  }
  if ((ty_struct_name(rt) == "Reader" || ty_struct_name(rt) == "Writer") && fa.field == "isatty") {
    return ty_bool();
  }
  if (ty_struct_name(rt) == "Writer" && (fa.field == "write_some" || fa.field == "write_some_bytes")) {
    return ty_result(ty_i32());
  }
  if (ty_struct_name(rt) == "Reader" && fa.field == "splice_to") {
    return ty_result(ty_i32());
  }
  if (ty_struct_name(rt) == "Writer" && (fa.field == "write" || fa.field == "write_bytes" || fa.field == "truncate")) {
    return ty_result(ty_unknown());
  }
  if ((ty_struct_name(rt) == "Reader" || ty_struct_name(rt) == "Writer") && fa.field == "dup_onto") {
    return ty_result(ty_unknown());
  }
  if (ty_struct_name(rt) == "Reader" && fa.field == "window_size") {
    return ty_result(ty_unknown());
  }
  if (ty_struct_name(rt) == "Reader" && fa.field == "termios_get") {
    return ty_result(ty_array_i64());
  }
  if (ty_struct_name(rt) == "Reader" && (fa.field == "set_window_size" || fa.field == "termios_set" || fa.field == "set_extproc")) {
    return ty_result(ty_unknown());
  }
  if (is_cell(rt) && fa.field == "get") {
    return cell_val(rt);
  }
  if (is_map(rt) && fa.field == "get") {
    return ty_option(map_val(rt));
  }
  if (is_map(rt) && fa.field == "get_or") {
    return map_val(rt);
  }
  if (is_map(rt) && fa.field == "insert") {
    return rt;
  }
  if (is_map(rt) && fa.field == "contains") {
    return ty_bool();
  }
  if (is_map(rt) && fa.field == "len") {
    return ty_i32();
  }
  if (is_map(rt) && fa.field == "keys") {
    if (map_key_is_i32(rt)) {
      return ty_array_i32();
    }
    return ty_array_string();
  }
  if (is_map(rt) && fa.field == "values") {
    let vt: Ty = map_val(rt);
    if (ty_is_i32(vt)) {
      return ty_array_i32();
    }
    if (ty_is_string(vt)) {
      return ty_array_string();
    }
    return ty_array();
  }

  if ((is_int_tag(rt) || ty_is_string(rt)) && fa.field == "to_string") {
    return ty_string();
  }
  if (ty_is_f64(rt) && fa.field == "to_string") {
    return ty_string();
  }
  if (ty_is_i32(rt) && (fa.field == "abs" || fa.field == "min" || fa.field == "max" || fa.field == "clamp" || fa.field == "pow" || fa.field == "sign" || fa.field == "gcd" || fa.field == "lcm")) {
    return ty_i32();
  }
  if (ty_is_u8(rt) && (fa.field == "to_ascii_lower" || fa.field == "to_ascii_upper")) {
    return ty_u8();
  }
  if (ty_is_u8(rt) && (fa.field == "digit_value" || fa.field == "hex_value")) {
    return ty_option(ty_i32());
  }
  if (ty_is_u8(rt) && (fa.field == "to_ascii_string" || fa.field == "hex_digit")) {
    return ty_string();
  }
  if (ty_is_i32(rt) && (fa.field == "is_even" || fa.field == "is_odd" || fa.field == "is_zero" || fa.field == "is_positive" || fa.field == "is_negative")) {
    return ty_bool();
  }
  if (ty_is_u8(rt) && (fa.field == "is_ascii_digit" || fa.field == "is_ascii_letter" || fa.field == "is_ascii_letter" || fa.field == "is_ascii_alphanumeric" || fa.field == "is_ascii_lower" || fa.field == "is_ascii_upper" || fa.field == "is_ascii_hex_digit" || fa.field == "is_ascii" || fa.field == "is_ascii_punct" || fa.field == "is_ascii_whitespace" || fa.field == "is_ascii_newline" || fa.field == "is_ascii_vowel" || fa.field == "is_ascii_printable" || fa.field == "is_ascii_control" || fa.field == "matches_any")) {
    return ty_bool();
  }
  if (fa.field == "len"
    && (ty_is_string(rt) || is_int_array_tag(rt) || ty_is_array_string(rt) || ty_is_array(rt))) {
    return ty_i32();
  }
  if (fa.field == "is_empty"
    && (ty_is_string(rt) || is_int_array_tag(rt) || ty_is_array_string(rt) || ty_is_array(rt))) {
    return ty_bool();
  }
  if ((fa.field == "append" || fa.field == "reverse" || fa.field == "concat")
    && (is_int_array_tag(rt) || ty_is_array_string(rt) || ty_is_array(rt))) {
    return rt;
  }
  if ((fa.field == "first" || fa.field == "last")
    && (is_int_array_tag(rt) || ty_is_array_string(rt))) {
    if (ty_is_array_i32(rt)) {
      return ty_i32();
    }
    if (ty_is_array_u32(rt)) {
      return ty_u32();
    }
    if (ty_is_array_u64(rt)) {
      return ty_u64();
    }
    if (ty_is_array_i64(rt)) {
      return ty_i64();
    }
    return ty_string();
  }
  if (ty_is_array_i32(rt) || ty_is_array_string(rt)) {
    if (fa.field == "index_of") {
      return ty_option(ty_i32());
    }
    if (fa.field == "contains") {
      return ty_bool();
    }
  }
  if (ty_is_array_i32(rt)
    && (fa.field == "sum" || fa.field == "product")) {
    return ty_i32();
  }
  if (ty_is_array_i32(rt) && (fa.field == "min" || fa.field == "max")) {
    return ty_option(ty_i32());
  }
  if (ty_is_array_string(rt) && fa.field == "join") {
    return ty_string();
  }
  if (ty_is_string(rt)) {
    if (fa.field == "split") {
      return ty_array_string();
    }
    if (fa.field == "lines") {
      return ty_array_string();
    }
    if (fa.field == "bytes") {
      return ty_array_i32();
    }
    if (fa.field == "as_bytes") {
      return ty_array_i32();
    }
    if (fa.field == "first_byte" || fa.field == "last_byte") {
      return ty_i32();
    }
    if (fa.field == "trim") {
      return ty_string();
    }
    if (fa.field == "to_ascii_upper") {
      return ty_string();
    }
    if (fa.field == "to_ascii_lower") {
      return ty_string();
    }
    if (fa.field == "repeat") {
      return ty_string();
    }
    if (fa.field == "replace") {
      return ty_string();
    }
  }
  if (!ty_is_unknown(rt)) {
    let mi: i32 = s.funcs_ix.chain(fa.field);
    while (mi >= 0) {
      if (s.funcs[mi].name == fa.field && s.funcs[mi].receiver_type.len() > 0
        && ty_eq(struct_local_tag(s.funcs[mi].receiver_type, s), rt)) {
        return ty_from_name(s.funcs[mi].ret_type);
      }
      mi = s.funcs_ix.next[mi];
    }
  }
  return ty_unknown();
}

