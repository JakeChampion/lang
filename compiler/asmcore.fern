pub function oflag(t: string, name: string): string {
  if (t == "arm64-darwin") {
    return oflag_darwin(name);
  }
  if (t == "x86-64-linux") {
    return oflag_x86_64(name);
  }
  if (t == "arm64-linux") {
    return oflag_arm64(name);
  }
  unknown_rt_key(t);
  return "";
}

function unknown_rt_key(t: string): void {
  eprint("error: internal: a runtime body is built for \"" + t + "\", which is not a runtime key (x86-64-linux, arm64-linux, arm64-darwin)");
  exit(3);
}

