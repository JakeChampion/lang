function rt_src_read_dir_like(t: string, fname: string, skip_dots: boolean, ino: boolean): string {
  let elem: string = "string";
  if (ino) {
    elem = "DirEntry";
  }
  return "function " + fname + "(path: string): Result[" + elem + "[], IoError] { let plen: i32 = path.len(); let pathz: usize = __raw_alloc(plen + 1); let i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i] as i32); i = i + 1; } __raw_store8(pathz, plen, 0); let fd: i32 = __syscall3(" + sysno(t, "openat") + ", " + at_fdcwd(t) + ", pathz as i64, " + oflag(t, "rd_directory") + ") as i32; let pathz_own: string = __raw_string(pathz, plen + 1); if (fd < 0) { return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen))); } " + dir_drain_src(t, elem, skip_dots, ino) + "__syscall3(" + sysno(t, "close") + ", fd as i64, 0, 0); if (bad < 0) { return Err(__fern_io_error(0 - bad, __fern_path_copy(pathz_own, plen))); } return Ok(names); }";
}

function dir_drain_src(t: string, elem: string, skip_dots: boolean, ino: boolean): string {
  let nameoff: string = direntoff(t, "name");
  let eilseq: string = util.i32_to_string(strerror_errno(t, util.index_of_str(strerror_texts(), "Invalid or incomplete multibyte or wide character")));
  let entry: string = "__raw_string(nbuf, nlen)";
  if (ino) {
    entry = "DirEntry { name: __raw_string(nbuf, nlen), ino: __load_i64((buf + pos + " + direntoff(t, "ino") + ")), kind: (__raw_load8(buf, pos + " + direntoff(t, "type") + ") as u32) << 12 }";
  }
  let guard_open: string = "";
  let guard_close: string = "";
  if (skip_dots) {
    guard_open = "let skip: i32 = 0; if (nlen == 1) { if (__raw_load8(buf, pos + " + nameoff + ") == 46) { skip = 1; } } if (nlen == 2) { if (__raw_load8(buf, pos + " + nameoff + ") == 46) { if (__raw_load8(buf, pos + " + nameoff + " + 1) == 46) { skip = 1; } } } if (skip == 0) { ";
    guard_close = "} ";
  }
  return "let basep: usize = __raw_alloc(8); let names: " + elem + "[] = []; let bad: i32 = 0; let done: i32 = 0; while (done == 0) { let buf: usize = __raw_alloc(65536); let n: i32 = __syscall4(" + sysno(t, "getdents") + ", fd as i64, buf as i64, 65536, basep as i64) as i32; if (n <= 0) { done = 1; bad = n; } else { let pos: i32 = 0; while (pos < n) { let reclen: i32 = __raw_load8(buf, pos + 16) + __raw_load8(buf, pos + 17) * 256; " + dirent_name_len(t) + "if (__fern_utf8_valid(buf + pos + " + nameoff + ", nlen) == 0) { bad = 0 - " + eilseq + "; done = 1; pos = n; } else { " + guard_open + "let nbuf: usize = __raw_alloc(nlen); __memcpy(nbuf, buf + pos + " + nameoff + ", nlen); names = names.append(" + entry + "); " + guard_close + "pos = pos + reclen; } } } let buf_own: string = __raw_string(buf, 65536); } let basep_own: string = __raw_string(basep, 8); ";
}

pub function rt_src_remove_dir_all(t: string): string {
  let nameoff: string = direntoff(t, "name");
  let source_text: usize = buf_new(4096);
  buf_push(source_text, "function __fern_remove_dir_all(path: string): Result[void, IoError] { let plen: i32 = path.len(); let pathz: usize = __raw_alloc(plen + 1); let i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i] as i32); i = i + 1; } __raw_store8(pathz, plen, 0); let fd: i32 = __syscall3(");
  buf_push(source_text, sysno(t, "openat"));
  buf_push(source_text, ", ");
  buf_push(source_text, at_fdcwd(t));
  buf_push(source_text, ", pathz as i64, ");
  buf_push(source_text, oflag(t, "rd_directory"));
  buf_push(source_text, ") as i32; if (fd < 0) { let e: i32 = 0 - fd; if (e == 20) { __syscall3(");
  buf_push(source_text, sysno(t, "unlinkat"));
  buf_push(source_text, ", ");
  buf_push(source_text, at_fdcwd(t));
  buf_push(source_text, ", pathz as i64, 0); } let pathz_own0: string = __raw_string(pathz, plen + 1); if (e == 2) { return Ok(()); } if (e == 20) { return Ok(()); } return Err(__fern_io_error(e, __fern_path_copy(pathz_own0, plen))); } let basep: usize = __raw_alloc(8); let done: i32 = 0; while (done == 0) { let buf: usize = __raw_alloc(65536); let n: i32 = __syscall4(");
  buf_push(source_text, sysno(t, "getdents"));
  buf_push(source_text, ", fd as i64, buf as i64, 65536, basep as i64) as i32; if (n <= 0) { done = 1; } else { let pos: i32 = 0; while (pos < n) { let reclen: i32 = __raw_load8(buf, pos + 16) + __raw_load8(buf, pos + 17) * 256; ");
  buf_push(source_text, dirent_name_len(t));
  buf_push(source_text, "let skip: i32 = 0; if (nlen == 1) { if (__raw_load8(buf, pos + ");
  buf_push(source_text, nameoff);
  buf_push(source_text, ") == 46) { skip = 1; } } if (nlen == 2) { if (__raw_load8(buf, pos + ");
  buf_push(source_text, nameoff);
  buf_push(source_text, ") == 46) { if (__raw_load8(buf, pos + ");
  buf_push(source_text, nameoff);
  buf_push(source_text, " + 1) == 46) { skip = 1; } } } if (skip == 0) { let cl: i32 = plen + 1 + nlen; let cb: usize = __raw_alloc(cl); __memcpy(cb, __raw_data(path), plen); __raw_store8(cb, plen, 47); __memcpy(cb + plen + 1, buf + pos + ");
  buf_push(source_text, nameoff);
  buf_push(source_text, ", nlen); match (__fern_remove_dir_all(__raw_string(cb, cl))) { Ok(_) => {}, Err(_) => {} } } pos = pos + reclen; } } let buf_own: string = __raw_string(buf, 65536); } let basep_own: string = __raw_string(basep, 8); __syscall3(");
  buf_push(source_text, sysno(t, "close"));
  buf_push(source_text, ", fd as i64, 0, 0); __syscall3(");
  buf_push(source_text, sysno(t, "unlinkat"));
  buf_push(source_text, ", ");
  buf_push(source_text, at_fdcwd(t));
  buf_push(source_text, ", pathz as i64, ");
  buf_push(source_text, atflag(t, "removedir"));
  buf_push(source_text, "); let pathz_own: string = __raw_string(pathz, plen + 1); return Ok(()); }");
  let source: string = buf_take(source_text);
  buf_free(source_text);
  return source;
}

function clock_read(t: string, clk: string): string {
  if (t == "arm64-darwin") {
    return "let ts: usize = __raw_scratch(16); __syscall3(" + sysno(t, "gettimeofday") + ", ts as i64, 0, 0); let sec: i64 = __load_i64(ts); let sub: i64 = __load_i32(ts + 8) as i64;";
  }
  return "let ts: usize = __raw_scratch(16); let vf: usize = __fern_vdso_clock(); if (vf != 1 as usize) { let r: usize = __c_call2(vf, " + clk + " as usize, ts); } else { __syscall3(" + sysno(t, "clock_gettime") + ", " + clk + ", ts as i64, 0); } let sec: i64 = __load_i64(ts); let sub: i64 = __load_i64(ts + 8);";
}

pub function vdso_wanted(s: EmitState, t: string): boolean {
  return t != "arm64-darwin" && s.any_need(["monotonic_ns", "now_unix_ms", "now_ns"]);
}

pub function rt_src_vdso(t: string): string {
  let name: string = "__kernel_clock_gettime";
  if (t == "x86-64-linux") {
    name = "__vdso_clock_gettime";
  }
  let matched: string = "";
  let i: i32 = 0;
  while (i < name.len()) {
    matched = matched + "__raw_load8(at, " + util.i32_to_string(i) + ") == " + util.i32_to_string(name[i] as i32) + " && ";
    i = i + 1;
  }
  matched = matched + "__raw_load8(at, " + util.i32_to_string(name.len()) + ") == 0";
  return "function __fern_vdso_clock(): usize { let slot: usize = __raw_vdso(); let f: usize = __raw_load_ptr(slot, 1); if (f == 0 as usize) { f = __fern_vdso_find(__raw_load_ptr(slot, 0)); __raw_store_ptr(slot, 1, f); } return f; } "
    + "function __fern_vdso_find(image: usize): usize { if (image == 0 as usize) { return 1 as usize; } "
    + "if (__raw_load8(image, 0) != 127 || __raw_load8(image, 1) != 69 || __raw_load8(image, 2) != 76 || __raw_load8(image, 3) != 70 || __raw_load8(image, 4) != 2) { return 1 as usize; } "
    + "let base: i64 = image as i64; let phoff: i64 = __load_i64(image + 32); let phsize: i32 = __raw_load8(image, 54) + __raw_load8(image, 55) * 256; let phnum: i32 = __raw_load8(image, 56) + __raw_load8(image, 57) * 256; "
    + "let bias: i64 = 0 as i64; let loaded: boolean = false; let dynv: i64 = 0 as i64; let i: i32 = 0; "
    + "while (i < phnum) { let ph: i64 = base + phoff + (i * phsize) as i64; let kind: i32 = __load_i32(ph as usize); if (kind == 1 && !loaded) { bias = base + __load_i64((ph + 8 as i64) as usize) - __load_i64((ph + 16 as i64) as usize); loaded = true; } if (kind == 2) { dynv = __load_i64((ph + 16 as i64) as usize); } i = i + 1; } "
    + "if (!loaded || dynv == 0 as i64) { return 1 as usize; } "
    + "let d: i64 = bias + dynv; let strtab: i64 = 0 as i64; let symtab: i64 = 0 as i64; let hash: i64 = 0 as i64; let tag: i64 = __load_i64(d as usize); "
    + "while (tag != 0 as i64) { let val: i64 = __load_i64((d + 8 as i64) as usize); if (tag == 4 as i64) { hash = bias + val; } if (tag == 5 as i64) { strtab = bias + val; } if (tag == 6 as i64) { symtab = bias + val; } d = d + 16 as i64; tag = __load_i64(d as usize); } "
    + "if (hash == 0 as i64 || strtab == 0 as i64 || symtab == 0 as i64) { return 1 as usize; } "
    + "let nsyms: i32 = __load_i32((hash + 4 as i64) as usize); let k: i32 = 0; "
    + "while (k < nsyms) { let sym: usize = (symtab + (k as i64) * (24 as i64)) as usize; if (__raw_load8(sym, 6) != 0 || __raw_load8(sym, 7) != 0) { let at: usize = (strtab + __load_i32(sym) as i64) as usize; if (" + matched + ") { return (bias + __load_i64(sym + 8)) as usize; } } k = k + 1; } "
    + "return 1 as usize; }";
}

function subsec_ns(t: string): string {
  if (t == "arm64-darwin") {
    return "1000";
  }
  return "1";
}

function subsec_per_ms(t: string): string {
  if (t == "arm64-darwin") {
    return "1000";
  }
  return "1000000";
}

pub function rt_src_clock(which: string, t: string): string {
  if (which == "monotonic_ns") {
    return "function __fern_monotonic_ns(): i64 { " + clock_read(t, "1") + " return sec * (1000000000 as i64) + sub * (" + subsec_ns(t) + " as i64); }";
  }
  if (which == "now_unix_ms") {
    return "function __fern_now_unix_ms(): i64 { " + clock_read(t, "0") + " return sec * (1000 as i64) + sub / (" + subsec_per_ms(t) + " as i64); }";
  }
  return "function __fern_now_ns(): i64 { " + clock_read(t, "0") + " return sec * (1000000000 as i64) + sub * (" + subsec_ns(t) + " as i64); }";
}

pub function rt_src_clock_resolution(t: string): string {
  if (t == "arm64-darwin") {
    return "function __fern_clock_resolution(): i64 { return " + subsec_ns(t) + " as i64; }";
  }
  return "function __fern_clock_resolution(): i64 { let ts: usize = __raw_scratch(16); __syscall3(" + sysno(t, "clock_getres") + ", 0, ts as i64, 0); return __load_i64(ts) * (1000000000 as i64) + __load_i64(ts + 8); }";
}

pub function rt_src_clock_set(t: string): string {
  let head: string = "function __fern_clock_set(sec: i64, nsec: i64): Result[void, IoError] { ";
  let tail: string = " if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } return Ok(()); }";
  if (t == "arm64-darwin") {
    return head + "if (nsec < (0 as i64) || nsec >= (1000000000 as i64)) { return Err(__fern_io_error(22, \"\")); } let tv: usize = __raw_scratch(16); __store_i64(tv, sec); __store_i64(tv + 8, nsec / (1000 as i64)); let rc: i32 = __syscall3(" + sysno(t, "settimeofday") + ", tv as i64, 0, 0) as i32;" + tail;
  }
  return head + "let ts: usize = __raw_scratch(16); __store_i64(ts, sec); __store_i64(ts + 8, nsec); let rc: i32 = __syscall3(" + sysno(t, "clock_settime") + ", 0, ts as i64, 0) as i32;" + tail;
}

pub function rt_src_stat(t: string): string {
  return rt_src_stat_like(t, "__fern_stat(path: string)", at_fdcwd(t), "", "0");
}

pub function rt_src_lstat(t: string): string {
  return rt_src_stat_like(t, "__fern_lstat(path: string)", at_fdcwd(t), "", atflag(t, "symlink_nofollow"));
}

function stat_slash_fixup(t: string, dirfd: string): string {
  let hi: string = "(__raw_load8(buf, " + statoff(t, "mode") + " + 1) & 240)";
  return " if (rc >= 0 && plen > 0 && path[plen - 1] == 47) { if (" + hi + " == 160) { rc = __syscall4(" + sysno(t, "fstatat") + ", " + dirfd + ", pathz as i64, buf as i64, 0) as i32; } if (rc >= 0 && " + hi + " != 64) { rc = 0 - 20; } }";
}

function rt_src_stat_like(t: string, sig: string, dirfd: string, prelude: string, at_flags: string): string {
  let head: string = "function " + sig + ": Result[FileStat, IoError] { let plen: i32 = path.len(); let pathz: usize = __raw_alloc(plen + 1); let i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i] as i32); i = i + 1; } __raw_store8(pathz, plen, 0); " + prelude;
  let tail: string = " let pathz_own: string = __raw_string(pathz, plen + 1); if (rc < 0) { return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen))); } ";
  if (t == "arm64-darwin") {
    return head + "let buf: usize = __raw_scratch(160); let rc: i32 = __syscall4(" + sysno(t, "fstatat") + ", " + dirfd + ", pathz as i64, buf as i64, " + at_flags + ") as i32;" + stat_slash_fixup(t, dirfd) + tail + stat_project_src(t) + " }";
  }
  return head + "let buf: usize = __raw_scratch(256); let rc: i32 = __syscall5(" + sysno(t, "statx") + ", " + dirfd + ", pathz as i64, " + at_flags + ", " + statx_mask() + ", buf as i64) as i32;" + tail + statx_project_src() + " }";
}

function stat_project_src(t: string): string {
  return "let mode: i32 = " + stat_load(t, "mode") + "; let mfmt: i32 = mode & 61440; let isf: boolean = mfmt == 32768; let isd: boolean = mfmt == 16384; return Ok(FileStat { is_file: isf, is_dir: isd, size: " + stat_i64(t, "size") + ", mode: (mode as u32), " + stat_fields_src(t) + " });";
}

function statx_mask(): string {
  return "4095";
}

function statx_project_src(): string {
  let o: string = "let mode: i32 = __load_i32(buf + 28) & 65535; let mfmt: i32 = mode & 61440; let isf: boolean = mfmt == 32768; let isd: boolean = mfmt == 16384; ";
  o = o + "let bt: i64 = 0 as i64; let btn: i64 = 0 as i64; if ((__load_i32(buf + 0) & 2048) != 0) { bt = __load_i64(buf + 80); btn = __load_i32(buf + 88) as i64; } ";
  o = o + "return Ok(FileStat { is_file: isf, is_dir: isd, size: __load_i64(buf + 40), mode: (mode as u32)";
  o = o + ", nlink: (__load_i32(buf + 16) as u32)";
  o = o + ", uid: (__load_i32(buf + 20) as u32)";
  o = o + ", gid: (__load_i32(buf + 24) as u32)";
  o = o + ", dev: " + statx_makedev("136", "140");
  o = o + ", rdev: " + statx_makedev("128", "132");
  o = o + ", ino: __load_i64(buf + 32)";
  o = o + ", blksize: (__load_i32(buf + 4) as i64)";
  o = o + ", blocks: __load_i64(buf + 48)";
  o = o + ", atime: __load_i64(buf + 64), atime_nsec: (__load_i32(buf + 72) as i64)";
  o = o + ", mtime: __load_i64(buf + 112), mtime_nsec: (__load_i32(buf + 120) as i64)";
  o = o + ", ctime: __load_i64(buf + 96), ctime_nsec: (__load_i32(buf + 104) as i64)";
  o = o + ", btime: bt, btime_nsec: btn });";
  return o;
}

function statx_makedev(major: string, minor: string): string {
  let maj: string = "(__load_i32((buf + " + major + ")) as i64)";
  let min: string = "(__load_i32((buf + " + minor + ")) as i64)";
  return "(((" + maj + " & (4095 as i64)) << 8) | ((" + maj + " >> 12) << 44) | (" + min + " & (255 as i64)) | ((" + min + " >> 8) << 20))";
}

pub function rt_src_fd_stat(t: string): string {
  if (t == "arm64-darwin") {
    return "function __fern_fd_stat(fd: i32): Result[FileStat, IoError] { let buf: usize = __raw_scratch(160); let rc: i32 = __syscall3(" + sysno(t, "fstat") + ", fd as i64, buf as i64, 0) as i32; if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } " + stat_project_src(t) + " }";
  }
  return "function __fern_fd_stat(fd: i32): Result[FileStat, IoError] { let ez: usize = __raw_alloc(1); __raw_store8(ez, 0, 0); let buf: usize = __raw_scratch(256); let rc: i32 = __syscall5(" + sysno(t, "statx") + ", fd as i64, ez as i64, 4096, " + statx_mask() + ", buf as i64) as i32; let ez_own: string = __raw_string(ez, 1); if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } " + statx_project_src() + " }";
}

pub function rt_src_fd_sync(t: string, name: string, call: string): string {
  return "function __fern_fd_" + name + "(fd: i32): Result[void, IoError] { let rc: i32 = __syscall3(" + sysno(t, call) + ", fd as i64, 0, 0) as i32; if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } return Ok(()); }";
}

pub function rt_src_fd_syncfs(t: string): string {
  if (t == "arm64-darwin") {
    return "function __fern_fd_syncfs(fd: i32): Result[void, IoError] { let ck: i32 = __syscall3(" + sysno(t, "fcntl") + ", fd as i64, 1, 0) as i32; if (ck < 0) { return Err(__fern_io_error(0 - ck, \"\")); } __syscall3(" + sysno(t, "sync") + ", 0, 0, 0); return Ok(()); }";
  }
  return "function __fern_fd_syncfs(fd: i32): Result[void, IoError] { let rc: i32 = __syscall3(" + sysno(t, "syncfs") + ", fd as i64, 0, 0) as i32; if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } return Ok(()); }";
}

pub function rt_src_fd_drop_cache(t: string): string {
  let head: string = "function __fern_fd_drop_cache(fd: i32, off: i64, n: i64): Result[void, IoError] { ";
  if (t == "arm64-darwin") {
    return head + "let at: i64 = __syscall3(" + sysno(t, "lseek") + ", fd as i64, 0, 1); if (at < (0 as i64)) { return Err(__fern_io_error(((0 as i64) - at) as i32, \"\")); } return Err(Unsupported); }";
  }
  return head + "let rc: i32 = __syscall5(" + sysno(t, "fadvise64") + ", fd as i64, off, n, 4, 0) as i32; if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } return Ok(()); }";
}

pub function rt_src_fd_dup_onto(t: string): string {
  return "function __fern_fd_dup_onto(fd: i32, newfd: i32): Result[void, IoError] { let rc: i32 = __syscall3(" + sysno(t, "dup3") + ", fd as i64, newfd as i64, 0) as i32; if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } return Ok(()); }";
}

pub function rt_src_sync(t: string): string {
  return "function __fern_sync(): i32 { return __syscall3(" + sysno(t, "sync") + ", 0, 0, 0) as i32; }";
}

pub function rt_src_sync_family(s: EmitState, t: string): string {
  let out: string = "";
  if (s.has_need("fd_fsync")) {
    out = out + " " + rt_src_fd_sync(t, "fsync", "fsync");
  }
  if (s.has_need("fd_fdatasync")) {
    out = out + " " + rt_src_fd_sync(t, "fdatasync", "fdatasync");
  }
  if (s.has_need("fd_syncfs")) {
    out = out + " " + rt_src_fd_syncfs(t);
  }
  if (s.has_need("fd_drop_cache")) {
    out = out + " " + rt_src_fd_drop_cache(t);
  }
  if (s.has_need("sync")) {
    out = out + " " + rt_src_sync(t);
  }
  return out;
}

pub function rt_src_reader_copy_range(t: string): string {
  let head: string = "function __fern_reader_copy_range(fd: i32, out: i32, max: i32): Result[i64, IoError] { ";
  if (t == "arm64-darwin") {
    return head + "return Err(Unsupported); }";
  }
  return head + "let n: i32 = __syscall6(" + sysno(t, "copy_file_range") + ", fd as i64, 0, out as i64, 0, max as i64, 0) as i32; if (n >= 0) { return Ok(n as i64); } "
    + "let e: i32 = 0 - n; if (e == 1 || e == 9 || e == 26 || e == 18 || e == 22 || e == 38 || e == 95) { return Err(Unsupported); } return Err(__fern_io_error(e, \"\")); }";
}

pub function rt_src_reader_splice(t: string): string {
  let head: string = "function __fern_reader_splice(fd: i32, out: i32, max: i32): Result[i64, IoError] { ";
  if (t == "arm64-darwin") {
    return head + "return Err(Unsupported); }";
  }
  let sp: string = sysno(t, "splice");
  let fc: string = sysno(t, "fcntl");
  let o: string = head + "let n: i32 = __syscall6(" + sp + ", fd as i64, 0, out as i64, 0, max as i64, 0) as i32; let p: usize = __raw_splice_pipe(); if (n >= 0) { if (__load_i32(p + 8) != out + 1) { __store_i32(p + 8, out + 1); let cap: i32 = __syscall3(" + fc + ", out as i64, 1032, 0) as i32; if (cap >= 0 && cap < max) { __syscall3(" + fc + ", out as i64, 1031, max as i64); } } return Ok(n as i64); } if (n != 0 - 22) { return Err(Unsupported); } ";
  o = o + "if (__load_i64(p) == (0 as i64)) { if (__syscall3(" + sysno(t, "pipe2") + ", p as i64, 524288, 0) != 0) { return Err(Unsupported); } __syscall3(" + sysno(t, "fcntl") + ", (__load_i32(p + 4)) as i64, 1031, max as i64); } ";
  o = o + "let pr: i32 = __load_i32(p); let pw: i32 = __load_i32(p + 4); if (__syscall6(" + sp + ", pr as i64, 0, out as i64, 0, 1, 2) != 0 - 11) { return Err(Unsupported); } ";
  o = o + "let got: i32 = __syscall6(" + sp + ", fd as i64, 0, pw as i64, 0, max as i64, 0) as i32; if (got < 0) { return Err(Unsupported); } let left: i32 = got; ";
  o = o + "while (left > 0) { let m: i32 = __syscall6(" + sp + ", pr as i64, 0, out as i64, 0, left as i64, 0) as i32; if (m > 0) { left = left - m; } else if (m != 0 - 4) { __syscall3(" + sysno(t, "close") + ", pr as i64, 0, 0); __syscall3(" + sysno(t, "close") + ", pw as i64, 0, 0); __store_i64(p, 0 as i64); let e: i32 = 0 - m; if (m == 0) { e = 5; } return Err(__fern_io_error(e, \"\")); } } ";
  return o + "return Ok(got as i64); }";
}

pub function rt_src_writer_splice_forever(t: string): string {
  let head: string = "function __fern_writer_splice_forever(fd: i32, s: string): Result[void, IoError] { ";
  if (t == "arm64-darwin") {
    return head + "return Err(Unsupported); }";
  }
  let vs: string = sysno(t, "vmsplice");
  let sp: string = sysno(t, "splice");
  let fc: string = sysno(t, "fcntl");
  let cl: string = sysno(t, "close");
  let o: string = head + "let n: i32 = s.len(); if (n == 0) { return Err(Unsupported); } let copies: i32 = 131072 / n; if (copies < 1) { copies = 1; } let len: i32 = copies * n; let pages: i32 = (len + 4095) / 4096 * 4096; let span: i32 = pages + 4096; ";
  o = o + "let m: i64 = __syscall6(" + sysno(t, "mmap") + ", 0, span as i64, 3, 34, (0 - 1) as i64, 0); if (m < (0 as i64)) { return Err(Unsupported); } let buf: usize = m as usize; let c: i32 = 0; while (c < copies) { __memcpy(buf + c * n, __raw_data(s), n); c = c + 1; } let iov: usize = buf + pages; ";
  o = o + "let out: i32 = fd; let pr: i32 = 0 - 1; __syscall3(" + fc + ", fd as i64, 1031, 524288); let off: i32 = 0; let moved: i64 = 0 as i64; let err: i32 = 0; ";
  o = o + "while (err == 0) { __store_i64(iov, (buf + off) as i64); __store_i64(iov + 8, (len - off) as i64); let gift: i32 = 0; if (off % 4096 == 0 && (len - off) % 4096 == 0) { gift = 8; } let w: i32 = __syscall4(" + vs + ", out as i64, iov as i64, 1, gift as i64) as i32; ";
  o = o + "if ((w == 0 - 9 || w == 0 - 22) && pr < 0 && moved == (0 as i64)) { let fds: usize = iov + 16; if (__syscall3(" + sysno(t, "pipe2") + ", fds as i64, 524288, 0) != 0) { err = 0 - 1; } else { pr = __load_i32(fds); out = __load_i32(fds + 4); __syscall3(" + fc + ", pr as i64, 1031, 524288); } } ";
  o = o + "else if (w < 0) { if (w != 0 - 4) { err = 0 - w; } } else { let left: i32 = w; while (pr >= 0 && left > 0 && err == 0) { let d: i32 = __syscall6(" + sp + ", pr as i64, 0, fd as i64, 0, left as i64, 1) as i32; if (d > 0) { left = left - d; moved = moved + (d as i64); } else if (d == 0 - 22 && moved == (0 as i64)) { err = 0 - 1; } else if (d != 0 - 4) { err = 0 - d; if (d == 0) { err = 5; } } } if (pr < 0) { moved = moved + (w as i64); } off = off + w; if (off >= len) { off = 0; } } } ";
  o = o + "if (pr >= 0) { __syscall3(" + cl + ", pr as i64, 0, 0); __syscall3(" + cl + ", out as i64, 0, 0); } __syscall3(" + sysno(t, "munmap") + ", m, span as i64, 0); ";
  return o + "if (err < 0) { return Err(Unsupported); } return Err(__fern_io_error(err, \"\")); }";
}

pub function rt_src_reader_seek(t: string): string {
  let swap: string = "";
  if (t == "arm64-darwin") {
    swap = "if (w == 3) { w = 4; } else if (w == 4) { w = 3; } ";
  }
  return "function __fern_reader_seek(fd: i32, off: i64, whence: i32): Result[i64, IoError] { if (whence < 0 || whence > 4) { return Err(__fern_io_error(22, \"\")); } let w: i32 = whence; " + swap + "let r: i64 = __syscall3(" + sysno(t, "lseek") + ", fd as i64, off as i64, w as i64); if (r < (0 as i64)) { return Err(__fern_io_error(((0 as i64) - r) as i32, \"\")); } return Ok(r); }";
}

pub function rt_src_writer_write_some(t: string): string {
  return "function __fern_writer_write_some(fd: i32, s: string): Result[i64, IoError] { let n: i32 = s.len(); let data: usize = __raw_data(s); let w: i32 = __syscall3(" + sysno(t, "write") + ", fd as i64, (data + 0) as i64, n as i64) as i32; if (w < 0) { return Err(__fern_io_error(0 - w, \"\")); } return Ok(w as i64); }";
}

pub function rt_src_writer_bytes(t: string, packed: boolean, all: boolean): string {
  let name: string = "write_some_bytes";
  let result: string = "Result[i64, IoError]";
  let done: string = "return Ok(w as i64);";
  if (all) {
    name = "write_bytes";
    result = "Result[void, IoError]";
    done = "at = at + w; if (at == n) { return Ok(()); } if (w == 0) { return Err(__fern_io_error(5, \"\")); }";
  }
  let param: string = "usize";
  let prep: string = "let n: i32 = 0; let p: usize = 0; if (((bytes as i32) & 2) != 0) { let base: usize = bytes - 2; n = __load_i32(base + 8); p = __raw_load_ptr(base, 0); } else { n = __load_i32(bytes); p = bytes + 8; }";
  if (!packed) {
    param = "i32[]";
    prep = "let n: i32 = bytes.len(); let raw: usize = __raw_arr_box(n / 8 + 1); let scratch: i32[] = __raw_array(raw); let p: usize = (__raw_arr_ptr(scratch) + 8); let j: i32 = 0; while (j < n) { __raw_store8(p, j, bytes[j]); j = j + 1; }";
  }
  return "function __fern_writer_" + name + packed_suffix(packed) + "(fd: i32, bytes: " + param + "): " + result + " { " + prep + " let at: i32 = 0; while (true) { let w: i32 = __syscall3(" + sysno(t, "write") + ", fd as i64, (p + at) as i64, (n - at) as i64) as i32; if (w < 0) { return Err(__fern_io_error(0 - w, \"\")); } " + done + " } }";
}

pub function rt_src_fd_flags(t: string): string {
  return "function __fern_fd_flags(fd: i32): Result[i64, IoError] { let r: i32 = __syscall3(" + sysno(t, "fcntl") + ", fd as i64, 3, 0) as i32; if (r < 0) { return Err(__fern_io_error(0 - r, \"\")); } let acc: i32 = r & 3; let bits: i32 = 0; if (acc != 1) { bits = bits | 1; } if (acc != 0) { bits = bits | 2; } if ((r & " + oflag(t, "append") + ") != 0) { bits = bits | 4; } return Ok(bits as i64); }";
}

pub function rt_src_writer_truncate(t: string): string {
  return "function __fern_writer_truncate(fd: i32, length: i64): Result[void, IoError] { let rc: i32 = __syscall3(" + sysno(t, "ftruncate") + ", fd as i64, length as i64, 0) as i32; if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } return Ok(()); }";
}

function stat_fields_src(t: string): string {
  let o: string = "nlink: " + stat_u32(t, "nlink");
  o = o + ", uid: " + stat_u32(t, "uid");
  o = o + ", gid: " + stat_u32(t, "gid");
  o = o + ", dev: " + stat_i64(t, "dev");
  o = o + ", rdev: " + stat_i64(t, "rdev");
  o = o + ", ino: " + stat_i64(t, "ino");
  o = o + ", blksize: " + stat_i64(t, "blksize");
  o = o + ", blocks: " + stat_i64(t, "blocks");
  o = o + ", atime: " + stat_i64(t, "atime");
  o = o + ", atime_nsec: " + stat_i64(t, "atime_nsec");
  o = o + ", mtime: " + stat_i64(t, "mtime");
  o = o + ", mtime_nsec: " + stat_i64(t, "mtime_nsec");
  o = o + ", ctime: " + stat_i64(t, "ctime");
  o = o + ", ctime_nsec: " + stat_i64(t, "ctime_nsec");
  o = o + ", btime: " + stat_i64(t, "btime");
  o = o + ", btime_nsec: " + stat_i64(t, "btime_nsec");
  return o;
}

function statfs_linux_path_max(): string {
  return "4096";
}

pub function statfs_bufsize(t: string): string {
  return util.i32_to_string(statfs_bufsize_n(t));
}

function statfs_bufsize_n(t: string): i32 {
  if (t == "arm64-darwin") {
    return 2176;
  }
  return 128;
}

pub function scratch_size(t: string, needs_statfs: boolean, minimum: i32): string {
  let n: i32 = minimum;
  if (needs_statfs && statfs_bufsize_n(t) > n) {
    n = statfs_bufsize_n(t);
  }
  return util.i32_to_string(n);
}

pub function statfsoff(t: string, name: string): string {
  if (t == "arm64-darwin") {
    return statfsoff_darwin(name);
  }
  return statfsoff_linux(name);
}

function statfsoff_linux(name: string): string {
  if (name == "block_size") {
    return "8";
  }
  if (name == "blocks") {
    return "16";
  }
  if (name == "blocks_free") {
    return "24";
  }
  if (name == "blocks_avail") {
    return "32";
  }
  if (name == "files") {
    return "40";
  }
  if (name == "files_free") {
    return "48";
  }
  if (name == "name_max") {
    return "64";
  }
  if (name == "fsid") {
    return "56";
  }
  if (name == "frag_size") {
    return "72";
  }
  return "0";
}

function statfsoff_darwin(name: string): string {
  if (name == "block_size") {
    return "0";
  }
  if (name == "blocks") {
    return "8";
  }
  if (name == "blocks_free") {
    return "16";
  }
  if (name == "blocks_avail") {
    return "24";
  }
  if (name == "files") {
    return "32";
  }
  if (name == "files_free") {
    return "40";
  }
  if (name == "fsid") {
    return "48";
  }
  if (name == "fs_type") {
    return "60";
  }
  if (name == "fs_type_name") {
    return "72";
  }
  return "0";
}

function statfs_field_i64(t: string, name: string): string {
  if (name == "fsid") {
    return statfs_fsid_i64(t);
  }
  let addr: string = "(buf + " + statfsoff(t, name) + ")";
  if (t == "arm64-darwin" && name != "blocks" && name != "blocks_free" && name != "blocks_avail" && name != "files" && name != "files_free") {
    return statfs_u32(addr);
  }
  return "__load_i64(" + addr + ")";
}

function statfs_u32(addr: string): string {
  return "((__load_i32(" + addr + ") as i64) & (4294967295 as i64))";
}

function statfs_fsid_i64(t: string): string {
  let off: string = statfsoff(t, "fsid");
  let hi: string = statfs_u32("(buf + " + off + ")");
  let lo: string = statfs_u32("(buf + " + off + " + 4)");
  return "((" + hi + " << (32 as i64)) | " + lo + ")";
}

function statfs_counts_src(t: string): string {
  let o: string = "block_size: " + statfs_field_i64(t, "block_size");
  o = o + ", blocks: " + statfs_field_i64(t, "blocks");
  o = o + ", blocks_free: " + statfs_field_i64(t, "blocks_free");
  o = o + ", blocks_avail: " + statfs_field_i64(t, "blocks_avail");
  o = o + ", files: " + statfs_field_i64(t, "files");
  o = o + ", files_free: " + statfs_field_i64(t, "files_free");
  o = o + ", fs_type: " + statfs_field_i64(t, "fs_type");
  o = o + ", fsid: " + statfs_field_i64(t, "fsid");
  o = o + ", frag_size: " + statfs_field_i64(t, "frag_size");
  return o;
}

pub function rt_src_statfs(t: string): string {
  let head: string = "function __fern_statfs(path: string): Result[FsStat, IoError] { let plen: i32 = path.len(); let pathz: usize = __raw_alloc(plen + 1); let i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i] as i32); i = i + 1; } __raw_store8(pathz, plen, 0); let buf: usize = __raw_scratch(" + statfs_bufsize(t) + "); let rc: i32 = __syscall3(" + sysno(t, "statfs") + ", pathz as i64, buf as i64, 0) as i32; ";
  if (t == "arm64-darwin") {
    let pc: string = sysno(t, "pathconf");
    let name: string = "let n: i32 = 0; while (n < 16 && __raw_load8(buf, " + statfsoff(t, "fs_type_name") + " + n) != 0) { n = n + 1; } let p: usize = __raw_alloc(n); __memcpy(p, (buf + " + statfsoff(t, "fs_type_name") + "), n); let type_name: string = __raw_string(p, n); ";
    return head + "let nmax: i32 = 0; let pmax: i32 = 0; if (rc >= 0) { nmax = __syscall3(" + pc + ", pathz as i64, 4, 0) as i32; rc = nmax; } if (rc >= 0) { pmax = __syscall3(" + pc + ", pathz as i64, 5, 0) as i32; rc = pmax; } let pathz_own: string = __raw_string(pathz, plen + 1); if (rc < 0) { return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen))); } " + name + "return Ok(FsStat { " + statfs_counts_src(t) + ", name_max: (nmax as i64), path_max: (pmax as i64), fs_type_name: type_name }); }";
  }
  return head + "let pathz_own: string = __raw_string(pathz, plen + 1); if (rc < 0) { return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen))); } return Ok(FsStat { " + statfs_counts_src(t) + ", name_max: " + statfs_field_i64(t, "name_max") + ", path_max: (" + statfs_linux_path_max() + " as i64), fs_type_name: \"\" }); }";
}

pub function rt_src_sysctl(t: string): string {
  if (t != "arm64-darwin") {
    return "function __fern_sysctl(mib: i32[]): Result[i32[], IoError] { return Err(__fern_io_error(38, \"\")); }";
  }
  let sc: string = sysno(t, "sysctl");
  return "function __fern_sysctl(mib: i32[]): Result[i32[], IoError] { let n: i32 = mib.len(); let m: usize = __raw_alloc(n * 4 + 4); let i: i32 = 0; while (i < n) { let v: i32 = mib[i]; __raw_store8(m, i * 4, v & 255); __raw_store8(m, i * 4 + 1, (v >> 8) & 255); __raw_store8(m, i * 4 + 2, (v >> 16) & 255); __raw_store8(m, i * 4 + 3, (v >> 24) & 255); i = i + 1; } let lenp: usize = __raw_alloc(8); __store_i64(lenp, 0 as i64); let r: i32 = __syscall6(" + sc + ", m as i64, n as i64, 0, lenp as i64, 0, 0) as i32; let size: i32 = __load_i64(lenp) as i32; let buf: usize = __raw_alloc(size + 1); if (r >= 0) { r = __syscall6(" + sc + ", m as i64, n as i64, buf as i64, lenp as i64, 0, 0) as i32; } let got: i32 = __load_i64(lenp) as i32; let m_own: string = __raw_string(m, n * 4 + 4); let lenp_own: string = __raw_string(lenp, 8); if (r < 0) { let buf_own0: string = __raw_string(buf, size + 1); return Err(__fern_io_error(0 - r, \"\")); } " + packed_box("b", "got") + " __memcpy(b + 8, buf, got); let buf_own: string = __raw_string(buf, size + 1); return Ok(__raw_array(b)); }";
}

pub function rt_src_mounts(t: string): string {
  if (t == "arm64-darwin") {
    let cstr: string = "function __fern_mount_cstr(buf: usize, off: i32, max: i32): string { let n: i32 = 0; while (n < max && __raw_load8(buf, off + n) != 0) { n = n + 1; } let p: usize = __raw_alloc(n); __memcpy(p, buf + off, n); return __raw_string(p, n); } ";
    let gf: string = sysno(t, "getfsstat");
    return cstr + "function __fern_mounts(): Result[MountEntry[], IoError] { let n: i32 = __syscall3(" + gf + ", 0, 0, 2) as i32; if (n < 0) { return Err(__fern_io_error(0 - n, \"\")); } let size: i32 = (n + 8) * 2168; let buf: usize = __raw_alloc(size); let m: i32 = __syscall3(" + gf + ", buf as i64, size as i64, 2) as i32; let st: usize = __raw_alloc(160); let out: MountEntry[] = []; let k: i32 = 0; while (k < m) { let base: i32 = k * 2168; let dev: i64 = (0 - 1) as i64; let sr: i32 = __syscall4(" + sysno(t, "fstatat") + ", " + at_fdcwd(t) + ", (buf + base + 88) as i64, st as i64, 0) as i32; if (sr >= 0) { dev = __load_i32((st + " + statoff(t, "dev") + ")) as i64; } out = out.append(MountEntry { source: __fern_mount_cstr(buf, base + 1112, 1024), target: __fern_mount_cstr(buf, base + 88, 1024), fstype: __fern_mount_cstr(buf, base + 72, 16), dev: dev }); k = k + 1; } let st_own: string = __raw_string(st, 160); let buf_own: string = __raw_string(buf, size); if (m < 0) { return Err(__fern_io_error(0 - m, \"\")); } let vi: i32 = 0; while (vi < out.len()) { let m: MountEntry = out[vi]; if (__fern_utf8_valid(__raw_data(m.source), m.source.len()) == 0 || __fern_utf8_valid(__raw_data(m.target), m.target.len()) == 0 || __fern_utf8_valid(__raw_data(m.fstype), m.fstype.len()) == 0) { return Err(InvalidUtf8(\"\")); } vi = vi + 1; } return Ok(out); }";
  }
  let blank: string = "(__raw_load8(buf, j) == 32 || __raw_load8(buf, j) == 9)";
  let octal: string = "function __fern_mount_octal(buf: usize, i: i32, b: i32): boolean { if (i + 3 >= b || __raw_load8(buf, i) != 92) { return false; } let k: i32 = 1; while (k < 4) { let c: i32 = __raw_load8(buf, i + k); if (c < 48 || c > 55) { return false; } k = k + 1; } return true; } ";
  let field: string = "function __fern_mount_field(buf: usize, a: i32, b: i32): string { let n: i32 = 0; let i: i32 = a; while (i < b) { if (__fern_mount_octal(buf, i, b)) { i = i + 4; } else { i = i + 1; } n = n + 1; } let p: usize = __raw_alloc(n); let o: i32 = 0; i = a; while (i < b) { if (__fern_mount_octal(buf, i, b)) { __raw_store8(p, o, (__raw_load8(buf, i + 1) - 48) * 64 + (__raw_load8(buf, i + 2) - 48) * 8 + (__raw_load8(buf, i + 3) - 48)); i = i + 4; } else { __raw_store8(p, o, __raw_load8(buf, i)); i = i + 1; } o = o + 1; } return __raw_string(p, n); } ";
  let devno: string = "function __fern_mount_devno(buf: usize, a: i32, b: i32): i64 { let major: i64 = 0 as i64; let minor: i64 = 0 as i64; let i: i32 = a; while (i < b && __raw_load8(buf, i) != 58) { major = major * (10 as i64) + (__raw_load8(buf, i) - 48) as i64; i = i + 1; } i = i + 1; while (i < b) { minor = minor * (10 as i64) + (__raw_load8(buf, i) - 48) as i64; i = i + 1; } return (minor & (255 as i64)) | (major << (8 as i64)) | ((minor & (0 - 256) as i64) << (12 as i64)); } ";
  let read: string = "let path: string = \"/proc/self/mountinfo\"; let plen: i32 = path.len(); let pathz: usize = __raw_alloc(plen + 1); let i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i] as i32); i = i + 1; } __raw_store8(pathz, plen, 0); let fd: i32 = __syscall3(" + sysno(t, "openat") + ", " + at_fdcwd(t) + ", pathz as i64, 0) as i32; let pathz_own: string = __raw_string(pathz, plen + 1); if (fd < 0) { return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen))); } let cap: i32 = 4096; let buf: usize = __raw_alloc(cap); let got: i32 = 0; let bad: i32 = 0; let done: i32 = 0; while (done == 0) { if (got == cap) { let nb: usize = __raw_alloc(cap * 2); __memcpy(nb, buf + 0, got); let old_own: string = __raw_string(buf, cap); buf = nb; cap = cap * 2; } let n: i32 = __syscall3(" + sysno(t, "read") + ", fd as i64, (buf + got) as i64, (cap - got) as i64) as i32; if (n < 0) { bad = n; done = 1; } else { if (n == 0) { done = 1; } else { got = got + n; } } } __syscall3(" + sysno(t, "close") + ", fd as i64, 0, 0); if (bad < 0) { let buf_own0: string = __raw_string(buf, cap); return Err(__fern_io_error(0 - bad, __fern_path_copy(pathz_own, plen))); } ";
  let parse: string = "let out: MountEntry[] = []; let ls: i32 = 0; while (ls < got) { let le: i32 = ls; while (le < got && __raw_load8(buf, le) != 10) { le = le + 1; } let fa: i32[] = []; let fb: i32[] = []; let j: i32 = ls; while (j < le) { while (j < le && " + blank + ") { j = j + 1; } if (j < le) { let st: i32 = j; while (j < le && !" + blank + ") { j = j + 1; } fa = fa.append(st); fb = fb.append(j); } } if (fa.len() >= 10) { let sep: i32 = 6; while (sep < fa.len() && !(fb[sep] - fa[sep] == 1 && __raw_load8(buf, fa[sep]) == 45)) { sep = sep + 1; } if (sep + 2 < fa.len()) { out = out.append(MountEntry { source: __fern_mount_field(buf, fa[sep + 2], fb[sep + 2]), target: __fern_mount_field(buf, fa[4], fb[4]), fstype: __fern_mount_field(buf, fa[sep + 1], fb[sep + 1]), dev: __fern_mount_devno(buf, fa[2], fb[2]) }); } } ls = le + 1; } let buf_own: string = __raw_string(buf, cap); let vi: i32 = 0; while (vi < out.len()) { let m: MountEntry = out[vi]; if (__fern_utf8_valid(__raw_data(m.source), m.source.len()) == 0 || __fern_utf8_valid(__raw_data(m.target), m.target.len()) == 0 || __fern_utf8_valid(__raw_data(m.fstype), m.fstype.len()) == 0) { return Err(InvalidUtf8(\"\")); } vi = vi + 1; } return Ok(out); }";
  return octal + field + devno + "function __fern_mounts(): Result[MountEntry[], IoError] { " + read + parse;
}

pub function rt_src_access(t: string): string {
  return void_path_leaf_src("__fern_access(path: string, mode: i32)", "", faccessat_src(t, at_fdcwd(t)));
}

function faccessat_src(t: string, dirfd: string): string {
  return "__syscall4(" + sysno(t, "faccessat") + ", " + dirfd + " as i64, pathz as i64, mode as i64, " + at_eaccess(t) + ")";
}

pub function rt_src_hostname(t: string): string {
  if (t == "arm64-darwin") {
    return rt_src_darwin_sysinfo("__fern_hostname", "", "let domain: i32 = 1; let field: i32 = 10; let valid: boolean = true;");
  }
  return "function __fern_hostname(): string { let buf: usize = __raw_alloc(390); let n: i32 = 0; if (__syscall3(" + sysno(t, "uname") + ", buf as i64, 0, 0) == 0) { while (n < 65 && __raw_load8(buf, 65 + n) != 0) { n = n + 1; } } if (__fern_utf8_valid(buf + 65, n) == 0) { n = 0; } let p: usize = __raw_alloc(n); __memcpy(p, buf + 65, n); let buf_own: string = __raw_string(buf, 390); return __raw_string(p, n); }";
}

pub function rt_src_uname_field(t: string): string {
  if (t == "arm64-darwin") {
    return rt_src_darwin_sysinfo("__fern_uname_field", "idx: i32", "let domain: i32 = 1; let field: i32 = 1; let valid: boolean = idx >= 0 && idx < 5; if (idx == 1) { field = 10; } if (idx == 2) { field = 2; } if (idx == 3) { field = 4; } if (idx == 4) { domain = 6; }");
  }
  return "function __fern_uname_field(idx: i32): string { let buf: usize = __raw_alloc(390); let n: i32 = 0; let off: i32 = 0; if (idx >= 0 && idx < 5) { off = idx * 65; if (__syscall3(" + sysno(t, "uname") + ", buf as i64, 0, 0) == 0) { while (n < 65 && __raw_load8(buf, off + n) != 0) { n = n + 1; } } } if (__fern_utf8_valid(buf + off, n) == 0) { n = 0; } let p: usize = __raw_alloc(n); __memcpy(p, buf + off, n); let buf_own: string = __raw_string(buf, 390); return __raw_string(p, n); }";
}

function rt_src_darwin_sysinfo(name: string, params: string, mib_source: string): string {
  return "function " + name + "(" + params + "): string { let buf: usize = __raw_scratch(400); " + mib_source + " let n: i32 = 0; if (valid) { __store_i32(buf, domain); __store_i32(buf + 4, field); __store_i64(buf + 8, 384i64); if (__syscall6(202, buf as i64, 2, (buf + 16) as i64, (buf + 8) as i64, 0, 0) >= 0i64) { while (n < 384 && __raw_load8(buf, 16 + n) != 0) { n = n + 1; } } } if (__fern_utf8_valid(buf + 16, n) == 0) { n = 0; } let p: usize = __raw_alloc(n); __memcpy(p, buf + 16, n); return __raw_string(p, n); }";
}

pub function rt_src_getcwd(t: string): string {
  if (t == "arm64-darwin") {
    let fstatat: string = sysno(t, "fstatat");
    let o: string = "function __fern_getcwd(): Result[string, IoError] { let dot: usize = __raw_alloc(2); __raw_store8(dot, 0, 46); __raw_store8(dot, 1, 0); ";
    o = o + "let here: usize = __raw_alloc(144); let hr: i32 = __syscall4(" + fstatat + ", " + at_fdcwd(t) + ", dot as i64, here as i64, 0) as i32; let hdev: i32 = __load_i32(here); let hino: i64 = __load_i64(here + 8); let here_own: string = __raw_string(here, 144); ";
    o = o + "let fd: i32 = __syscall4(" + sysno(t, "openat") + ", " + at_fdcwd(t) + ", dot as i64, 0, 0) as i32; let dot_own: string = __raw_string(dot, 2); if (fd < 0) { return Err(__fern_io_error(0 - fd, \"\")); } ";
    o = o + "let buf: usize = __raw_alloc(4096); __raw_store8(buf, 0, 0); let rc: i32 = __syscall3(" + sysno(t, "fcntl") + ", fd as i64, 50, buf as i64) as i32; __syscall3(" + sysno(t, "close") + ", fd as i64, 0, 0); ";
    o = o + "let seen: usize = __raw_alloc(144); let sr: i32 = 0 - 2; if (rc >= 0) { sr = __syscall4(" + fstatat + ", " + at_fdcwd(t) + ", buf as i64, seen as i64, 0) as i32; } let sdev: i32 = __load_i32(seen); let sino: i64 = __load_i64(seen + 8); let seen_own: string = __raw_string(seen, 144); ";
    o = o + "let buf_own: string = __raw_string(buf, 4096); if (hr < 0) { return Err(__fern_io_error(0 - hr, \"\")); } if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } if (sr < 0) { return Err(__fern_io_error(0 - sr, \"\")); } if (sdev != hdev || sino != hino) { return Err(__fern_io_error(2, \"\")); } ";
    return o + "let n: i32 = 0; while (n < 4096 && buf_own[n] != 0) { n = n + 1; } if (__fern_utf8_valid(buf, n) == 0) { return Err(InvalidUtf8(\"\")); } return Ok(__fern_path_copy(buf_own, n)); }";
  }
  return "function __fern_getcwd(): Result[string, IoError] { let buf: usize = __raw_alloc(4096); let rc: i32 = __syscall3(" + sysno(t, "getcwd") + ", buf as i64, 4096, 0) as i32; let buf_own: string = __raw_string(buf, 4096); if (rc < 0) { return Err(__fern_io_error(0 - rc, \"\")); } if (buf_own[0] != 47) { return Err(__fern_io_error(2, \"\")); } if (__fern_utf8_valid(buf, rc - 1) == 0) { return Err(InvalidUtf8(\"\")); } return Ok(__fern_path_copy(buf_own, rc - 1)); }";
}

pub function rt_src_cpu_count(t: string): string {
  if (t == "arm64-darwin") {
    return "function __fern_cpu_count(): i32 { let buf: usize = __raw_scratch(32); __store_i32(buf, 6); __store_i32(buf + 4, 25); __store_i64(buf + 8, 4i64); let rc: i64 = __syscall6(" + sysno(t, "sysctl") + ", buf as i64, 2, (buf + 16) as i64, (buf + 8) as i64, 0, 0); if (rc < 0i64) { return 0; } return __load_i32(buf + 16); }";
  }
  return "function __fern_cpu_count(): i32 { let buf: usize = __raw_alloc(128); let i: i32 = 0; while (i < 128) { __raw_store8(buf, i, 0); i = i + 1; } let rc: i32 = __syscall3(" + sysno(t, "sched_getaffinity") + ", 0, 128, buf as i64) as i32; if (rc <= 0) { let buf_own0: string = __raw_string(buf, 128); return 0; } if (rc > 128) { rc = 128; } let total: i32 = 0; let k: i32 = 0; while (k < rc) { let b: i32 = __raw_load8(buf, k); while (b != 0) { total = total + (b & 1); b = b >> 1; } k = k + 1; } let buf_own: string = __raw_string(buf, 128); return total; }";
}

pub function rt_src_getid(t: string, which: string): string {
  return "function __fern_" + which + "(): i32 { return __syscall3(" + sysno(t, which) + ", 0, 0, 0) as i32; }";
}

pub function rt_src_getgroups(t: string): string {
  let nr: string = sysno(t, "getgroups");
  return "function __fern_getgroups(): i64[] { let out: i64[] = []; let n: i32 = __syscall3(" + nr + ", 0, 0, 0) as i32; if (n <= 0) { return out; } let buf: usize = __raw_alloc(n * 4); let m: i32 = __syscall3(" + nr + ", n as i64, buf as i64, 0) as i32; if (m <= 0) { let buf_own0: string = __raw_string(buf, n * 4); return out; } let i: i32 = 0; while (i < m) { let b0: i64 = (__raw_load8(buf, i * 4) as i64); let b1: i64 = (__raw_load8(buf, i * 4 + 1) as i64); let b2: i64 = (__raw_load8(buf, i * 4 + 2) as i64); let b3: i64 = (__raw_load8(buf, i * 4 + 3) as i64); out = out.append(b0 + b1 * 256 + b2 * 65536 + b3 * 16777216); i = i + 1; } let buf_own: string = __raw_string(buf, n * 4); return out; }";
}

pub function rt_src_environ(): string {
  return "function __fern_environ(): string[] { let out: string[] = []; let envp: usize = __raw_environ(); let idx: i32 = 0; let done: i32 = 0; while (done == 0) { let entry: usize = __raw_load_ptr(envp, idx); if (entry == 0) { done = 1; } else { let n: i32 = 0; while (__raw_load8(entry, n) != 0) { n = n + 1; } let e: string = \"\"; if (n > 0) { let b: usize = __raw_alloc(n); __memcpy(b, entry, n); e = __raw_string(b, n); } out = out.append(e); idx = idx + 1; } } return out; }";
}

pub function rt_src_string_from_bytes(): string {
  return "function __fern_string_from_bytes(a: i32[]): string { let n: i32 = a.len(); let p: usize = __raw_alloc(n); let i: i32 = 0; while (i < n) { __raw_store8(p, i, a[i]); i = i + 1; } return __raw_string(p, n); }";
}

pub function (s: EmitState) need_array_helper(name: string): EmitState {
  if (name == "__fern_bytes_append_range") {
    return s.need("byte_append");
  }
  if (name == "__fern_bytes_write_range") {
    return s.need("byte_write");
  }
  if (name == "__fern_arr_str_join") {
    return s.need("arr_str_join");
  }
  if (name == "__fern_arr_concat") {
    return s.need("arr_concat");
  }
  if (name == "__fern_bytes_owned") {
    return s.need("bytes_owned");
  }
  if (name == "__fern_bytes_range") {
    return s.need("bytes_range");
  }
  if (name == "__fern_bytes_into") {
    return s.need("bytes_into");
  }
  return s;
}

function array_helper_need(name: string): boolean {
  return name == "arr_str_join" || name == "arr_concat" || name == "bytes_owned" || name == "bytes_range" || name == "bytes_into" || name == "byte_append" || name == "byte_write";
}

pub function rt_src_byte_copy(append: boolean, write: boolean): string {
  return rtbytecopy.native_helpers(true, append, write);
}

pub function rt_src_str_to_upper(): string {
  return "function __fern_str_to_upper(s: string): string { let n: i32 = s.len(); let p: usize = __raw_alloc(n); let i: i32 = 0; while (i < n) { let c: i32 = s[i] as i32; if (c >= 97) { if (c <= 122) { c = c - 32; } } __raw_store8(p, i, c); i = i + 1; } return __raw_string(p, n); }";
}

pub function rt_src_str_to_lower(): string {
  return "function __fern_str_to_lower(s: string): string { let n: i32 = s.len(); let p: usize = __raw_alloc(n); let i: i32 = 0; while (i < n) { let c: i32 = s[i] as i32; if (c >= 65) { if (c <= 90) { c = c + 32; } } __raw_store8(p, i, c); i = i + 1; } return __raw_string(p, n); }";
}

pub function rt_src_str_repeat(): string {
  return "function __fern_str_repeat(s: string, n: i32): string { let slen: i32 = s.len(); let count: i32 = n; if (count < 0) { count = 0; } let total64: i64 = (slen as i64) * (count as i64); let total: i32 = total64 as i32; if (total64 > 2147483647) { total = 0 - 1; } if (total == 0) { return \"\"; } let p: usize = __raw_alloc(total); let w: i32 = 0; let k: i32 = 0; while (k < count) { let j: i32 = 0; while (j < slen) { __raw_store8(p, w, s[j] as i32); w = w + 1; j = j + 1; } k = k + 1; } return __raw_string(p, total); }";
}

pub function rt_src_str_replace(): string {
  return "function __fern_str_dup(h: string): string { let n: i32 = h.len(); if (n == 0) { return \"\"; } let p: usize = __raw_alloc(n); __memcpy(p, __raw_data(h), n); return __raw_string(p, n); } "
    + "function __fern_str_replace(h: string, o: string, nw: string): string { let lenH: i32 = h.len(); let lenO: i32 = o.len(); if (lenO == 0) { return __fern_str_dup(h); } let lenN: i32 = nw.len(); let count: i32 = 0; let i: i32 = 0; while (i + lenO <= lenH) { let j: i32 = 0; let m: i32 = 1; while (j < lenO) { if (h[i + j] != o[j]) { m = 0; j = lenO; } else { j = j + 1; } } if (m == 1) { count = count + 1; i = i + lenO; } else { i = i + 1; } } if (count == 0) { return __fern_str_dup(h); } let total64: i64 = (lenH as i64) + (count as i64) * ((lenN as i64) - (lenO as i64)); let total: i32 = total64 as i32; if (total64 > 2147483647) { total = 0 - 1; } if (total == 0) { return \"\"; } let p: usize = __raw_alloc(total); let w: i32 = 0; let k: i32 = 0; while (k < lenH) { let m2: i32 = 0; if (k + lenO <= lenH) { let jj: i32 = 0; m2 = 1; while (jj < lenO) { if (h[k + jj] != o[jj]) { m2 = 0; jj = lenO; } else { jj = jj + 1; } } } if (m2 == 1) { let t: i32 = 0; while (t < lenN) { __raw_store8(p, w, nw[t] as i32); w = w + 1; t = t + 1; } k = k + lenO; } else { __raw_store8(p, w, h[k] as i32); w = w + 1; k = k + 1; } } return __raw_string(p, total); }";
}

pub function rt_src_arr_slice(): string {
  return "function __fern_arr_slice(a: i32[], start: i32, end: i32): i32[] { let n: i32 = a.len(); let bad: i32 = 0; if (end < 0) { bad = 1; } if (end > n) { bad = 1; } if (start < 0) { bad = 1; } if (start > end) { bad = 1; } if (bad == 1) { __fern_slice_abort(); } let m: i32 = end - start; let p: usize = __raw_arr_box(m); let dst: usize = p + 8; let src: usize = (__raw_arr_ptr(a) + 8); let skip: i32 = start; while (skip > 0) { let cs: i32 = skip; if (cs > 134217728) { cs = 134217728; } src = src + cs * 8; skip = skip - cs; } let left: i32 = m; while (left > 0) { let cc: i32 = left; if (cc > 134217728) { cc = 134217728; } __memcpy(dst, src, cc * 8); dst = dst + cc * 8; src = src + cc * 8; left = left - cc; } return __raw_array(p); }";
}

pub function rt_src_str_arr_free(): string {
  return "function __fern_str_arr_free(p: usize): void {\n"
    + "  if (p >= 65536 as usize && __load_i32(p - 8) == 1) {\n"
    + "    let n: i32 = __load_i32(p); let i: i32 = 0;\n"
    + "    while (i < n) { __fern_str_free(__raw_load_ptr(p, i + 1)); i = i + 1; }\n"
    + "  }\n"
    + "  __fern_rc_dec(p);\n"
    + "}\n";
}

pub function rt_src_str_cmp(): string {
  return "function __fern_str_cmp(a: string, b: string): i32 { let la: i32 = a.len(); let lb: i32 = b.len(); let n: i32 = la; if (lb < n) { n = lb; } let dl: i32 = la - lb; let p: usize = __raw_data(a); let q: usize = __raw_data(b); let end: usize = p + n; while (p + 8 <= end) { let x: i64 = __load_i64(p) ^ __load_i64(q); if (x != (0 as i64)) { let k: i32 = __ctz64(x as u64) >> 3; return __load_u8(p + k) - __load_u8(q + k); } p = p + 8; q = q + 8; } while (p < end) { let ca: i32 = __load_u8(p); let cb: i32 = __load_u8(q); if (ca != cb) { return ca - cb; } p = p + 1; q = q + 1; } return dl; }";
}

pub function rt_src_arr_str_join(): string {
  return "function __fern_arr_str_join(xs: string[], sep: string): string { let n: i32 = xs.len(); if (n == 0) { return \"\"; } let ls: i32 = sep.len(); let total: i32 = ls * (n - 1); let i: i32 = 0; while (i < n) { total = total + xs[i].len(); i = i + 1; } let p: usize = __raw_alloc(total); let off: i32 = 0; let j: i32 = 0; while (j < n) { if (j > 0) { __memcpy(p + off, __raw_data(sep), ls); off = off + ls; } let e: string = xs[j]; let le: i32 = e.len(); __memcpy(p + off, __raw_data(e), le); off = off + le; j = j + 1; } return __raw_string(p, total); }";
}

pub function rt_src_str_split(): string {
  return "function __fern_utf8_step(s: string, i: i32, n: i32): i32 { let b0: i32 = s[i] as i32; let want: i32 = 0; if (b0 < 128) { want = 1; } if (b0 >= 194 && b0 < 224) { want = 2; } if (b0 >= 224 && b0 < 240) { want = 3; } if (b0 >= 240 && b0 < 245) { want = 4; } if (want <= 1) { return 1; } if (i + 1 >= n) { return 1; } let lo: i32 = 128; if (b0 == 224) { lo = 160; } if (b0 == 240) { lo = 144; } let hi: i32 = 191; if (b0 == 237) { hi = 159; } if (b0 == 244) { hi = 143; } let c1: i32 = s[i + 1] as i32; if (c1 < lo) { return 1; } if (c1 > hi) { return 1; } let k2: i32 = 2; while (k2 < want) { if (i + k2 >= n) { return k2; } let ck: i32 = s[i + k2] as i32; if (ck < 128) { return k2; } if (ck > 191) { return k2; } k2 = k2 + 1; } return want; } function __fern_str_split(s: string, sep: string): string[] { let lenS: i32 = s.len(); let lenSep: i32 = sep.len(); let out: string[] = []; if (lenSep == 0) { let k: i32 = 0; while (k < lenS) { let w: i32 = __fern_utf8_step(s, k, lenS); out = out.append(slice_unchecked(s, k, k + w) + \"\"); k = k + w; } return out; } let start: i32 = 0; let i: i32 = 0; while (i + lenSep <= lenS) { let j: i32 = 0; let m: i32 = 1; while (j < lenSep) { if (s[i + j] != sep[j]) { m = 0; j = lenSep; } else { j = j + 1; } } if (m == 1) { out = out.append(slice_unchecked(s, start, i) + \"\"); i = i + lenSep; start = i; } else { i = i + 1; } } out = out.append(slice_unchecked(s, start, lenS) + \"\"); return out; }";
}

pub function packed_suffix(packed: boolean): string {
  if (packed) {
    return "_u8";
  }
  return "";
}

function packed_box(name: string, n: string): string {
  return "let " + name + ": usize = __raw_arr_box((" + n + " + 7) / 8); __store_i64(" + name + ", (" + n + ") as i64);";
}

pub function rt_src_str_bytes_u8(): string {
  return "function __fern_str_bytes_u8(s: string): i32[] { let n: i32 = s.len(); " + packed_box("b", "n") + " __memcpy(b + 8, __raw_data(s), n); return __raw_array(b); }";
}

pub function rt_src_string_from_bytes_range_u8(): string {
  return "function __fern_string_from_bytes_range_u8(a: i32[], from: i32, end: i32): string { let n: i32 = a.len(); let bad: i32 = 0; if (end < 0) { bad = 1; } if (end > n) { bad = 1; } if (from < 0) { bad = 1; } if (from > end) { bad = 1; } if (bad == 1) { __fern_slice_abort(); } let m: i32 = end - from; let p: usize = __raw_alloc(m); __memcpy(p, (__raw_arr_ptr(a) + 8 + from), m); return __raw_string(p, m); }";
}

pub function rt_src_string_from_bytes_u8(): string {
  return "function __fern_string_from_bytes_u8(a: i32[]): string { let n: i32 = a.len(); let p: usize = __raw_alloc(n); __memcpy(p, (__raw_arr_ptr(a) + 8), n); return __raw_string(p, n); }";
}

pub function rt_src_arr_concat(): string {
  let words_in: string = "let dst: usize = pa + 8 + na * 8; let src: usize = __raw_arr_ptr(b) + 8; let left: i32 = nb; while (left > 0) { let cc: i32 = left; if (cc > 134217728) { cc = 134217728; } __memcpy(dst, src, cc * 8); dst = dst + cc * 8; src = src + cc * 8; left = left - cc; }";
  let in_place: string = "let want: i32 = m; if (__fern_rc_is_unique(pa) != 0) { if (nb == 0) { return __raw_array(pa); } let capw: i32 = __load_i32(pa - 16); let need: i32 = m; if (width == 8) { need = (m + 7) / 8; } if (need <= capw) { if (width == 8) { __memcpy(pa + 8 + na, __raw_arr_ptr(b) + 8, nb); } else { " + words_in + " } __store_i64(pa, m as i64); return __raw_array(pa); } if (na <= 536870912 && na * 2 > want) { want = na * 2; } }";
  let packed: string = "if (width == 8) { let p: usize = __raw_arr_box((want + 7) / 8); __store_i64(p, m as i64); __memcpy(p + 8, pa + 8, na); __memcpy(p + 8 + na, __raw_arr_ptr(b) + 8, nb); return __raw_array(p); }";
  let words: string = "let q: usize = __raw_arr_box(want); __store_i64(q, m as i64); let dst2: usize = q + 8; let src2: usize = pa + 8; let left2: i32 = na; let part: i32 = 0; while (part < 2) { while (left2 > 0) { let cc2: i32 = left2; if (cc2 > 134217728) { cc2 = 134217728; } __memcpy(dst2, src2, cc2 * 8); dst2 = dst2 + cc2 * 8; src2 = src2 + cc2 * 8; left2 = left2 - cc2; } src2 = __raw_arr_ptr(b) + 8; left2 = nb; part = part + 1; } return __raw_array(q);";
  return "function __fern_arr_concat(pa: usize, b: i32[], width: i32): i32[] { let na: i32 = __load_i32(pa); let nb: i32 = b.len(); let m: i32 = na + nb; " + in_place + " " + packed + " " + words + " }";
}

pub function rt_src_bytes_owned(): string {
  return "function __fern_bytes_owned(bytes: usize): i32[] { let n: i32 = 0; let p: usize = 0; if (((bytes as i32) & 2) != 0) { let base: usize = bytes - 2; n = __load_i32(base + 8); p = __raw_load_ptr(base, 0); } else { n = __load_i32(bytes); p = bytes + 8; } if (n == 0) { return []; } "
    + packed_box("b", "n") + " __memcpy(b + 8, p, n); return __raw_array(b); }";
}

pub function rt_src_bytes_range(): string {
  return "function __fern_bytes_range(to: i32, from: i32, bytes: usize): i32[] { let n: i32 = 0; let p: usize = 0; if (((bytes as i32) & 2) != 0) { let base: usize = bytes - 2; n = __load_i32(base + 8); p = __raw_load_ptr(base, 0); } else { n = __load_i32(bytes); p = bytes + 8; } if (from < 0 || to < from || to > n) { __fern_slice_abort(); } let m: i32 = to - from; if (m == 0) { return []; } "
    + packed_box("b", "m") + " __memcpy(b + 8, p + from, m); return __raw_array(b); }";
}

pub function rt_src_bytes_into(): string {
  return "function __fern_bytes_into(n: i32, from: i32, src: usize, at: i32, dst: usize): i32[] { let sn: i32 = 0; let sp: usize = 0; if (((src as i32) & 2) != 0) { let base: usize = src - 2; sn = __load_i32(base + 8); sp = __raw_load_ptr(base, 0); } else { sn = __load_i32(src); sp = src + 8; } let dn: i32 = __load_i32(dst); if (n < 0 || at < 0 || from < 0 || at > dn - n || from > sn - n) { __fern_slice_abort(); } if (n == 0) { return __raw_array(dst); } let d: usize = dst; if (__fern_rc_is_unique(d) == 0) { "
    + packed_box("b", "dn") + " __memcpy(b + 8, d + 8, dn); __fern_rc_dec(d); d = b; } __memcpy(d + 8 + at, sp + from, n); return __raw_array(d); }";
}

pub function rt_src_arr_slice_u8(): string {
  return "function __fern_arr_slice_u8(a: i32[], start: i32, end: i32): i32[] { let n: i32 = a.len(); let bad: i32 = 0; if (end < 0) { bad = 1; } if (end > n) { bad = 1; } if (start < 0) { bad = 1; } if (start > end) { bad = 1; } if (bad == 1) { __fern_slice_abort(); } let m: i32 = end - start; " + packed_box("p", "m") + " __memcpy(p + 8, (__raw_arr_ptr(a) + 8 + start), m); return __raw_array(p); }";
}

pub function rt_src_random_bytes_u8(t: string): string {
  return "function __fern_random_bytes_u8(n: i32): i32[] { if (n < 0) { n = 0; } " + packed_box("b", "n") + " let off: i32 = 0; while (off < n) { let want: i32 = n - off; if (want > 256) { want = 256; } let r: i32 = __syscall3(" + sysno(t, "getrandom") + ", (b + 8 + off) as i64, want as i64, 0) as i32; if (r < 0) { off = n; } else { off = off + want; } } return __raw_array(b); }";
}

pub function rt_src_tcp_ktls(t: string): string {
  let set: string = sysno(t, "setsockopt");
  let attach: string = "if (op == 1) { let u: usize = __raw_scratch(4); __raw_store8(u, 0, 116); __raw_store8(u, 1, 108); __raw_store8(u, 2, 115); __raw_store8(u, 3, 0); return __syscall5(" + set + ", fd as i64, 6, 31, u as i64, 4) as i32; }";
  let keys: string = "if (op == 2 || op == 3) { return __syscall5(" + set + ", fd as i64, 282, (op - 1) as i64, p as i64, n as i64) as i32; }";
  let msg: string = "let m: usize = __raw_scratch(96); let z: i32 = 0; while (z < 96) { __raw_store8(m, z, 0); z = z + 1; } let q: usize = __raw_alloc(n + 1); __store_i64(m + 16, (m + 56) as i64); __raw_store8(m, 24, 1); __store_i64(m + 32, (m + 72) as i64); __raw_store8(m, 40, 24); __store_i64(m + 56, q as i64); __store_i64(m + 64, n as i64);";
  let send: string = "let r: i32 = 0; if (op == 4) { __memcpy(q, p, n); __raw_store8(m, 72, 17); __raw_store8(m, 80, 26); __raw_store8(m, 81, 1); __raw_store8(m, 84, 1); __raw_store8(m, 88, arg & 255); r = __syscall3(" + sysno(t, "sendmsg") + ", fd as i64, m as i64, 0) as i32; }";
  let recv: string = "if (op == 5) { r = __syscall3(" + sysno(t, "recvmsg") + ", fd as i64, m as i64, 0) as i32; if (r > 0) { __memcpy(p, q, r); } if (r >= 0) { let ty: i32 = 0; if (__raw_load8(m, 40) != 0 && __raw_load8(m, 80) == 26 && __raw_load8(m, 81) == 1 && __raw_load8(m, 84) == 2) { ty = __raw_load8(m, 88); } r = r | (ty << 24); } } let q_own: string = __raw_string(q, n + 1); return r;";
  return "function __fern_tcp_ktls_u8(fd: i32, op: i32, arg: i32, data: i32[]): i32 { let n: i32 = data.len(); let p: usize = __raw_arr_ptr(data) + 8; " + attach + " " + keys + " if (op != 4 && op != 5) { return 0 - 22; } " + msg + " " + send + " " + recv + " }";
}

pub function rt_src_tcp_recv_into_u8(t: string): string {
  return "function __fern_tcp_recv_into_u8(fd: i32, buf: i32[]): i32 { let max: i32 = buf.len(); if (max <= 0) { return 0; } return __syscall3(" + sysno(t, "read") + ", fd as i64, (__raw_arr_ptr(buf) + 8) as i64, max as i64) as i32; }";
}

pub function rt_src_str_bytes(): string {
  return "function __fern_str_bytes(s: string): i32[] { let n: i32 = s.len(); let b: usize = __raw_arr_box(n); let i: i32 = 0; while (i < n) { __raw_store_ptr(b, i + 1, s[i] as usize); i = i + 1; } return __raw_array(b); }";
}

pub function rt_src_str_lines(): string {
  return "function __fern_str_lines(s: string): string[] { let out: string[] = []; let sl: i32 = s.len(); let start: i32 = 0; let i: i32 = 0; while (i < sl) { if (s[i] == 10) { let end: i32 = i; if (end > start) { if (s[end - 1] == 13) { end = end - 1; } } out = out.append(slice_unchecked(s, start, end) + \"\"); start = i + 1; } i = i + 1; } if (start < sl) { let tail: i32 = sl; if (s[tail - 1] == 13) { tail = tail - 1; } out = out.append(slice_unchecked(s, start, tail) + \"\"); } return out; }";
}

pub function rt_src_str_trim(): string {
  return "function __fern_str_trim(s: string): string { let n: i32 = s.len(); let start: i32 = 0; let go: i32 = 1; while (go == 1) { if (start >= n) { go = 0; } else { let c: i32 = s[start] as i32; if (c == 32 || c >= 9 && c <= 13) { start = start + 1; } else { go = 0; } } } let end: i32 = n; let go2: i32 = 1; while (go2 == 1) { if (end <= start) { go2 = 0; } else { let c2: i32 = s[end - 1] as i32; if (c2 == 32 || c2 >= 9 && c2 <= 13) { end = end - 1; } else { go2 = 0; } } } return slice_unchecked(s, start, end) + \"\"; }";
}

pub function match_payload_type(scrut: ast.Expr, s: EmitState): Ty {
  match (scrut) {
    ast.ExprIdent(id) => {
      if (s.has_local(id.name)) {
        let lt: Ty = s.local_type_of(id.name);
        if (is_option(lt)) {
          return option_inner(lt);
        }
        if (is_result(lt)) {
          return result_inner(lt);
        }
      }
      return ty_unknown();
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          if ((id.name == "Some" || id.name == "Ok") && c.args.len() == 1) {
            return infer_expr_type(c.args[0], s);
          }
          if (id.name == "read_file") {
            return ty_string();
          }
          if (id.name == "temp_dir") {
            return ty_string();
          }
          if (id.name == "read_dir" || id.name == "read_dir_all") {
            return ty_array_string();
          }
          if (id.name == "read_dir_ino" || id.name == "read_dir_ino_all") {
            return ty_array();
          }
          let fi: i32 = 0;
          while (fi < s.funcs.len()) {
            if (s.funcs[fi].name == id.name && s.funcs[fi].receiver_type.len() == 0) {
              let rt: string = s.funcs[fi].ret_type;
              if (rt.len() >= 8 && slice_unchecked(rt, 0, 7) == "Option[" && rt[rt.len() - 1] == b']') {
                return ty_from_name(slice_unchecked(rt, 7, rt.len() - 1));
              }
              if (rt.len() >= 8 && slice_unchecked(rt, 0, 7) == "Result[") {
                let inner: string = "(" + slice_unchecked(rt, 7, rt.len() - 1) + ")";
                return split_tuple_ret(inner).a;
              }
              return ty_unknown();
            }
            fi = fi + 1;
          }
          return ty_unknown();
        },
        ast.ExprFieldAccess(fa) => {
          let rcv: Ty = infer_expr_type(fa.obj, s);
          if (ty_struct_name(rcv) == "Reader" && fa.field == "read_chunk_bytes") {
            return ty_array_i32();
          }
          if (ty_struct_name(rcv) == "Reader" && fa.field == "read_chunk") {
            return ty_string();
          }
          if ((ty_struct_name(rcv) == "Reader" || ty_struct_name(rcv) == "Writer") && (fa.field == "seek" || fa.field == "flags")) {
            return ty_i32();
          }
          if (ty_struct_name(rcv) == "Writer" && (fa.field == "write_some" || fa.field == "write_some_bytes")) {
            return ty_i32();
          }
          if (ty_struct_name(rcv) == "Reader" && fa.field == "splice_to") {
            return ty_i32();
          }
          if (fa.field == "get" && is_map(rcv)) {
            return map_val(rcv);
          }
          if ((fa.field == "min" || fa.field == "max") && ty_is_array_i32(rcv)) {
            return ty_i32();
          }
          if (!ty_is_unknown(rcv)) {
            let fi: i32 = 0;
            while (fi < s.funcs.len()) {
              if (s.funcs[fi].name == fa.field && ty_eq(struct_local_tag(s.funcs[fi].receiver_type, s), rcv)) {
                let rt: string = s.funcs[fi].ret_type;
                if (rt.len() >= 8 && slice_unchecked(rt, 0, 7) == "Option[" && rt[rt.len() - 1] == b']') {
                  return ty_from_name(slice_unchecked(rt, 7, rt.len() - 1));
                }
                if (rt.len() >= 8 && slice_unchecked(rt, 0, 7) == "Result[") {
                  let inner: string = "(" + slice_unchecked(rt, 7, rt.len() - 1) + ")";
                  return split_tuple_ret(inner).a;
                }
                return ty_unknown();
              }
              fi = fi + 1;
            }
          }
          return ty_unknown();
        },
        _ => {
          return ty_unknown();
        }
      }
    },
    _ => {
      return ty_unknown();
    }
  }
  return ty_unknown();
}

pub function is_struct_decl_name(name: string, s: EmitState): boolean {
  return irtables.stab_first(s.struct_decls, name) >= 0;
}

pub function is_prim_recv_name(name: string, s: EmitState): boolean {
  if (recv_is_array(name)) {
    return false;
  }
  if (is_struct_decl_name(name, s)) {
    return false;
  }
  if (is_int_tag(ty_from_name(name))) {
    return true;
  }
  if (name == "string" || name == "bool" || name == "boolean") {
    return true;
  }
  if (name == "f64" || name == "f32") {
    return true;
  }
  return false;
}

pub function recv_is_array(rt: string): boolean {
  let n: i32 = rt.len();
  if (n < 2) {
    return false;
  }
  return slice_unchecked(rt, n - 2, n) == "[]";
}

pub function field_type_tag_in(struct_name: string, field: string, s: EmitState): Ty {
  let di: i32 = irtables.stab_first(s.struct_decls, struct_name);
  if (di >= 0) {
    let sd: parser.StructDecl = s.struct_decls.decls[di];
    let fi: i32 = 0;
    while (fi < sd.fields.len()) {
      if (sd.fields[fi].name == field) {
        return struct_local_tag(sd.fields[fi].type_name, s);
      }
      fi = fi + 1;
    }
  }
  return ty_unknown();
}

pub function struct_local_tag(type_name: string, s: EmitState): Ty {
  let bi: i32 = 0;
  while (bi < type_name.len()) {
    if (type_name[bi] == b'[') {
      return ty_from_name(type_name);
    }
    bi = bi + 1;
  }
  if (is_struct_decl_name(type_name, s)) {
    return ty_named(type_name);
  }
  return ty_from_name(type_name);
}

pub struct TyI32 { tag: i32 }

pub struct TyU32 { tag: i32 }

pub struct TyU64 { tag: i32 }

pub struct TyI64 { tag: i32 }

pub struct TyU8 { tag: i32 }

pub struct TyUsize { tag: i32 }

pub struct TyBool { tag: i32 }

pub struct TyString { tag: i32 }

pub struct TyF64 { tag: i32 }

pub struct TyStruct { tag: i32 }

pub struct TyTuple { tag: i32 }

pub struct TyUnknown { tag: i32 }

pub struct TyArray { tag: i32 }

pub struct TyArrayI32 { tag: i32 }

pub struct TyArrayU32 { tag: i32 }

pub struct TyArrayU64 { tag: i32 }

pub struct TyArrayI64 { tag: i32 }

pub struct TyArrayString { tag: i32 }

pub struct TyFnAny { tag: i32 }

pub struct TyMapAny { tag: i32 }

pub struct TyOption { inner: Ty }

pub struct TyResult { inner: Ty }

pub struct TyFn { ret: Ty }

pub struct TyMapStr { val: Ty }

pub struct TyMapI32 { val: Ty }

pub struct TyMapIter { val: Ty }

pub struct TyCell { val: Ty }

pub struct TyStructNamed { name: string }

pub type Ty = TyI32 | TyU8 | TyU32 | TyU64 | TyI64 | TyUsize | TyBool | TyString | TyF64 | TyStruct
  | TyTuple | TyUnknown | TyArray | TyArrayI32 | TyArrayU32 | TyArrayU64 | TyArrayI64
  | TyArrayString | TyFnAny | TyMapAny | TyOption | TyResult | TyFn | TyMapStr | TyMapI32
  | TyMapIter | TyCell | TyStructNamed;

pub function ty_named(name: string): Ty {
  return TyStructNamed { name: name };
}

pub function ty_struct_name(t: Ty): string {
  match (t) {
    TyStructNamed(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

pub function ty_i32(): Ty {
  return TyI32 { tag: 0 };
}

pub function ty_u32(): Ty {
  return TyU32 { tag: 0 };
}

pub function ty_u64(): Ty {
  return TyU64 { tag: 0 };
}

pub function ty_i64(): Ty {
  return TyI64 { tag: 0 };
}

pub function ty_u8(): Ty {
  return TyU8 { tag: 0 };
}

pub function ty_usize(): Ty {
  return TyUsize { tag: 0 };
}

pub function ty_bool(): Ty {
  return TyBool { tag: 0 };
}

pub function ty_string(): Ty {
  return TyString { tag: 0 };
}

pub function ty_f64(): Ty {
  return TyF64 { tag: 0 };
}

pub function ty_struct(): Ty {
  return TyStruct { tag: 0 };
}

pub function ty_tuple(): Ty {
  return TyTuple { tag: 0 };
}

pub function ty_unknown(): Ty {
  return TyUnknown { tag: 0 };
}

pub function ty_array(): Ty {
  return TyArray { tag: 0 };
}

pub function ty_array_i32(): Ty {
  return TyArrayI32 { tag: 0 };
}

pub function ty_array_u32(): Ty {
  return TyArrayU32 { tag: 0 };
}

pub function ty_array_u64(): Ty {
  return TyArrayU64 { tag: 0 };
}

pub function ty_array_i64(): Ty {
  return TyArrayI64 { tag: 0 };
}

pub function ty_array_string(): Ty {
  return TyArrayString { tag: 0 };
}

pub function ty_map_any(): Ty {
  return TyMapAny { tag: 0 };
}

pub function ty_option(x: Ty): Ty {
  return TyOption { inner: x };
}

pub function ty_result(x: Ty): Ty {
  return TyResult { inner: x };
}

pub function ty_fn(x: Ty): Ty {
  return TyFn { ret: x };
}

pub function ty_map_str(x: Ty): Ty {
  return TyMapStr { val: x };
}

pub function ty_map_i32(x: Ty): Ty {
  return TyMapI32 { val: x };
