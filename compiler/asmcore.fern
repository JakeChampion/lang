pub function statkind(t: string, name: string): string {
  if (t == "arm64-darwin") {
    if (name == "mode" || name == "nlink") {
      return "u16";
    }
    if (name == "dev" || name == "rdev" || name == "blksize") {
      return "i32";
    }
    if (name == "uid" || name == "gid") {
      return "i32";
    }
    return "i64";
  }
  return "i64";
}

function stat_load(t: string, name: string): string {
  let addr: string = "(buf + " + statoff(t, name) + ")";
  if (statkind(t, name) == "u16") {
    return "(__load_i32(" + addr + ") & 65535)";
  }
  return "__load_i32(" + addr + ")";
}

function stat_i64(t: string, name: string): string {
  if (statkind(t, name) == "i64") {
    return "__load_i64((buf + " + statoff(t, name) + "))";
  }
  return "(" + stat_load(t, name) + " as i64)";
}

function stat_u32(t: string, name: string): string {
  if (statkind(t, name) == "i64") {
    return "(__load_i32((buf + " + statoff(t, name) + ")) as u32)";
  }
  return "(" + stat_load(t, name) + " as u32)";
}

pub function oflag(t: string, name: string): string {
  if (t == "arm64-darwin") {
    return oflag_darwin(name);
  }
  if (t == "x86-64-linux") {
    return oflag_x86_64(name);
  }
  if (t == "arm64-linux") {
    return oflag_arm64(name);
  }
  unknown_rt_key(t);
  return "";
}

function unknown_rt_key(t: string): void {
  eprint("error: internal: a runtime body is built for \"" + t + "\", which is not a runtime key (x86-64-linux, arm64-linux, arm64-darwin)");
  exit(3);
}

