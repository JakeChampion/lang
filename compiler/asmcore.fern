  let head: string = "function __fern_tcp_sendfile(fd: i32, file: i32, max: i32): i32 { if (max <= 0) { return 0; } ";
  if (t == "arm64-darwin") {
    return head + "let pos: i64 = __syscall3(" + sysno(t, "lseek") + ", file as i64, 0, 1); if (pos < (0 as i64)) { return pos as i32; } let lenp: usize = __raw_scratch(8); __store_i64(lenp, max as i64); let r: i64 = __syscall6(" + sysno(t, "sendfile") + ", file as i64, fd as i64, pos, lenp as i64, 0, 0); let sent: i64 = __load_i64(lenp); if (sent > (0 as i64)) { __syscall3(" + sysno(t, "lseek") + ", file as i64, pos + sent, 0); return sent as i32; } if (r < (0 as i64)) { return r as i32; } return 0; }";
  }
  return head + "return __syscall4(" + sysno(t, "sendfile") + ", fd as i64, file as i64, 0, max as i64) as i32; }";
}

function peer_word(at: string): string {
  return "(__raw_load8(sa, " + at + ") | (__raw_load8(sa, " + at + " + 1) << 8) | (__raw_load8(sa, " + at + " + 2) << 16) | (__raw_load8(sa, " + at + " + 3) << 24))";
}

function udp_byte_data(packed: boolean): string {
  if (packed) {
    return "let byte_data: usize = (__raw_arr_ptr(data) + 8);";
  }
  return "let byte_n: i32 = data.len(); let byte_raw: usize = __raw_arr_box(byte_n / 8 + 1); let byte_scratch: i32[] = __raw_array(byte_raw); let byte_data: usize = (__raw_arr_ptr(byte_scratch) + 8); let byte_j: i32 = 0; while (byte_j < byte_n) { __raw_store8(byte_data, byte_j, data[byte_j]); byte_j = byte_j + 1; }";
}

pub function rt_src_udp_bind(t: string, packed: boolean): string {
  return "function __fern_udp_bind" + packed_suffix(packed) + "(addr: i32[], port: i32): i32 { " + af_of_addr(t) + " let fd: i32 = __syscall3(" + sysno(t, "socket") + ", af as i64, 2, 0) as i32; if (fd < 0) { return fd; } let sa: usize = __raw_scratch(28); " + sockaddr_of(t, "sa", packed) + " let r: i32 = __syscall3(" + sysno(t, "bind") + ", fd as i64, sa as i64, salen as i64) as i32; if (r < 0) { __syscall3(" + sysno(t, "close") + ", fd as i64, 0, 0); return r; } return fd; }";
}

pub function rt_src_udp_bind_with(t: string, packed: boolean): string {
  return "function __fern_udp_bind_with" + packed_suffix(packed) + "(addr: i32[], port: i32, reuse_port: boolean): i32 { " + af_of_addr(t) + " let fd: i32 = __syscall3(" + sysno(t, "socket") + ", af as i64, 2, 0) as i32; if (fd < 0) { return fd; } let sa: usize = __raw_scratch(32); let r: i32 = 0; if (af == " + sockopt(t, "af_inet6") + ") { __raw_store8(sa, 28, 0); __raw_store8(sa, 29, 0); __raw_store8(sa, 30, 0); __raw_store8(sa, 31, 0); r = __syscall5(" + sysno(t, "setsockopt") + ", fd as i64, 41, " + sockopt(t, "ipv6_v6only") + ", (sa + 28) as i64, 4) as i32; } if (r >= 0 && reuse_port) { __raw_store8(sa, 28, 1); __raw_store8(sa, 29, 0); __raw_store8(sa, 30, 0); __raw_store8(sa, 31, 0); r = __syscall5(" + sysno(t, "setsockopt") + ", fd as i64, " + sockopt(t, "sol_socket") + ", " + sockopt(t, "so_reuseport") + ", (sa + 28) as i64, 4) as i32; } " + sockaddr_of(t, "sa", packed) + " if (r >= 0) { r = __syscall3(" + sysno(t, "bind") + ", fd as i64, sa as i64, salen as i64) as i32; } if (r < 0) { __syscall3(" + sysno(t, "close") + ", fd as i64, 0, 0); return r; } return fd; }";
}

pub function rt_src_udp_connect(t: string, packed: boolean): string {
  return "function __fern_udp_connect" + packed_suffix(packed) + "(fd: i32, addr: i32[], port: i32): i32 { " + af_of_addr(t) + " let sa: usize = __raw_scratch(28); " + sockaddr_of(t, "sa", packed) + " return __syscall3(" + sysno(t, "connect") + ", fd as i64, sa as i64, salen as i64) as i32; }";
}

pub function rt_src_udp_sendto(t: string, packed: boolean): string {
  return rt_src_udp_sendto_mode(t, false, packed);
}

pub function rt_src_udp_sendto_bytes(t: string, packed: boolean): string {
  return rt_src_udp_sendto_mode(t, true, packed);
}

function rt_src_udp_sendto_mode(t: string, raw: boolean, packed: boolean): string {
  let name: string = "__fern_udp_sendto" + packed_suffix(packed);
  let dtype: string = "string";
  let ptr: string = "__raw_data(data)";
  let prep: string = "";
  if (raw) {
    name = "__fern_udp_sendto_bytes" + packed_suffix(packed);
    dtype = "i32[]";
    ptr = "byte_data";
    prep = udp_byte_data(packed);
  }
  let flags: string = "16384";
  if (t == "arm64-darwin") {
    flags = "524288";
  }
  return "function " + name + "(fd: i32, addr: i32[], port: i32, data: " + dtype + "): i32 { " + prep + " if (addr.len() == 0) { return __syscall6(" + sysno(t, "sendto") + ", fd as i64, " + ptr + " as i64, data.len() as i64, " + flags + ", 0, 0) as i32; } " + af_of_addr(t) + " let sa: usize = __raw_scratch(28); " + sockaddr_of(t, "sa", packed) + " return __syscall6(" + sysno(t, "sendto") + ", fd as i64, " + ptr + " as i64, data.len() as i64, " + flags + ", sa as i64, salen as i64) as i32; }";
}

pub function rt_src_udp_recvfrom(t: string, packed: boolean): string {
  let family: string = "let fam: i32 = __raw_load8(sa, 0) | (__raw_load8(sa, 1) << 8);";
  if (t == "arm64-darwin") {
    family = "let fam: i32 = __raw_load8(sa, 1);";
  }
  return "function __fern_udp_recvfrom" + packed_suffix(packed) + "(fd: i32, buf: i32[], from: i32[]): i32 { let max: i32 = buf.len(); let p: usize = __raw_alloc(max + 1); let sa: usize = __raw_scratch(32); __raw_store8(sa, 28, 28); __raw_store8(sa, 29, 0); __raw_store8(sa, 30, 0); __raw_store8(sa, 31, 0); let n: i32 = __syscall6(" + sysno(t, "recvfrom") + ", fd as i64, p as i64, max as i64, 0, sa as i64, (sa + 28) as i64) as i32; " + recv_spread(packed) + " if (n >= 0 && from.len() >= 19) { let f: usize = __raw_arr_ptr(from); let z: i32 = 1; while (z <= 19) { " + elem_store(packed, "f", "z - 1", "0") + " z = z + 1; } " + family + " let n_addr: i32 = 0; let at: i32 = 4; if (fam == 2) { " + elem_store(packed, "f", "0", "4") + " n_addr = 4; } else if (fam == " + sockopt(t, "af_inet6") + ") { " + elem_store(packed, "f", "0", "6") + " n_addr = 16; at = 8; } let k: i32 = 0; while (k < n_addr) { " + elem_store(packed, "f", "1 + k", "__raw_load8(sa, at + k)") + " k = k + 1; } " + elem_store(packed, "f", "17", "__raw_load8(sa, 2)") + " " + elem_store(packed, "f", "18", "__raw_load8(sa, 3)") + " } let p_own: string = __raw_string(p, max + 1); return n; }";
}

function recv_spread(packed: boolean): string {
  if (packed) {
    return "if (n > 0) { __memcpy((__raw_arr_ptr(buf) + 8), p, n); }";
  }
  return "let b: usize = __raw_arr_ptr(buf); let i: i32 = 0; while (i < n) { __raw_store_ptr(b, i + 1, __raw_load8(p, i) as usize); i = i + 1; }";
}

function elem_store(packed: boolean, arr: string, i: string, v: string): string {
  if (packed) {
    return "__raw_store8(" + arr + ", 8 + (" + i + "), " + v + ");";
  }
  return "__raw_store_ptr(" + arr + ", (" + i + ") + 1, (" + v + ") as usize);";
}

pub function rt_src_reactor_new(t: string): string {
  if (t == "arm64-darwin") {
    return "function __fern_reactor_new(): i32 { return __syscall3(" + sysno(t, "kqueue") + ", 0, 0, 0) as i32; }";
  }
  return "function __fern_reactor_new(): i32 { return __syscall3(" + sysno(t, "epoll_create1") + ", 524288, 0, 0) as i32; }";
}

function kevent_change_src(ch: string, fd: string, filter: string, flags: string): string {
  return "__raw_store_ptr(" + ch + ", 0, " + fd + " as usize); __raw_store8(" + ch + ", 8, " + filter + " & 255); __raw_store8(" + ch + ", 9, (" + filter + " >> 8) & 255); __raw_store8(" + ch + ", 10, " + flags + "); __raw_store8(" + ch + ", 11, 0); "
    + "__raw_store_ptr(" + ch + ", 2, 0); __raw_store_ptr(" + ch + ", 3, 0); __raw_store8(" + ch + ", 12, 0); __raw_store8(" + ch + ", 13, 0); __raw_store8(" + ch + ", 14, 0); __raw_store8(" + ch + ", 15, 0);";
}

function kqueue_watch_src(t: string): string {
  return "let ch: usize = __raw_scratch(32); let r: i32 = 0; let filter: i32 = 0 - 1; let bit: i32 = 1; "
    + "while (bit <= 2 && r >= 0) { let flags: i32 = 2; if ((interest & bit) != 0) { flags = 5; if ((interest & 16) != 0) { flags = 21; } } "
    + "if ((interest & bit) != 0 || (interest & 16) == 0) { "
    + kevent_change_src("ch", "fd", "filter", "flags")
    + " let e: i32 = __syscall6(" + sysno(t, "kevent") + ", r_fd as i64, ch as i64, 1, 0, 0, 0) as i32; "
    + "if (e < 0 && !(flags == 2 && e == 0 - 2)) { r = e; } } filter = filter - 1; bit = bit + bit; } return r;";
}

function epoll_watch_src(t: string): string {
  let data_at: string = epoll_ev_data(t);
  return "let ev: usize = __raw_scratch(16); let bits: i32 = 0; if ((interest & 1) != 0) { bits = bits | 1; } if ((interest & 2) != 0) { bits = bits | 4; } if ((interest & 4) != 0) { bits = bits | 268435456; } if ((interest & 16) != 0) { bits = bits | 1073741824; } "
    + "__raw_store8(ev, 0, bits & 255); __raw_store8(ev, 1, (bits >> 8) & 255); __raw_store8(ev, 2, (bits >> 16) & 255); __raw_store8(ev, 3, (bits >> 24) & 255); "
    + "__raw_store8(ev, " + data_at + ", fd & 255); __raw_store8(ev, " + data_at + " + 1, (fd >> 8) & 255); __raw_store8(ev, " + data_at + " + 2, (fd >> 16) & 255); __raw_store8(ev, " + data_at + " + 3, (fd >> 24) & 255); "
    + "__raw_store8(ev, " + data_at + " + 4, 0); __raw_store8(ev, " + data_at + " + 5, 0); __raw_store8(ev, " + data_at + " + 6, 0); __raw_store8(ev, " + data_at + " + 7, 0); "
    + "let r: i32 = 0; if (interest == 0) { r = __syscall4(" + sysno(t, "epoll_ctl") + ", r_fd as i64, 2, fd as i64, ev as i64) as i32; } else if ((interest & 16) != 0) { "
    + "r = __syscall4(" + sysno(t, "epoll_ctl") + ", r_fd as i64, 3, fd as i64, ev as i64) as i32; "
    + "if (r == 0 - 2) { r = __syscall4(" + sysno(t, "epoll_ctl") + ", r_fd as i64, 1, fd as i64, ev as i64) as i32; } } else { "
    + "r = __syscall4(" + sysno(t, "epoll_ctl") + ", r_fd as i64, 1, fd as i64, ev as i64) as i32; "
    + "if (r == 0 - 17) { r = __syscall4(" + sysno(t, "epoll_ctl") + ", r_fd as i64, 3, fd as i64, ev as i64) as i32; } } return r;";
}

function signal_watch_src(t: string): string {
  if (t == "arm64-darwin") {
    return "if (op == 4) { let act: usize = __raw_scratch(32); let z: i32 = 0; while (z < 32) { __raw_store8(act, z, 0); z = z + 1; } __raw_store8(act, 0, 1); __syscall4(" + sysno(t, "sigaction") + ", fd as i64, act as i64, 0, 8); "
      + "let ch: usize = __raw_scratch(32); let sig_fd: i32 = fd; let sig_filter: i32 = 0 - 6; let sig_flags: i32 = 5; " + kevent_change_src("ch", "sig_fd", "sig_filter", "sig_flags") + " return __syscall6(" + sysno(t, "kevent") + ", r_fd as i64, ch as i64, 1, 0, 0, 0) as i32; } "
      + "if (op == 5) { let ch2: usize = __raw_scratch(32); let del_fd: i32 = fd; let del_filter: i32 = 0 - 6; let del_flags: i32 = 2; " + kevent_change_src("ch2", "del_fd", "del_filter", "del_flags") + " __syscall6(" + sysno(t, "kevent") + ", r_fd as i64, ch2 as i64, 1, 0, 0, 0); "
      + "let act2: usize = __raw_scratch(32); let z2: i32 = 0; while (z2 < 32) { __raw_store8(act2, z2, 0); z2 = z2 + 1; } return __syscall4(" + sysno(t, "sigaction") + ", fd as i64, act2 as i64, 0, 8) as i32; } ";
  }
  let data_at: string = "8";
  if (t == "x86-64-linux") {
    data_at = "4";
  }
  return "if (op == 4 || op == 5) { if (fd <= 0 || fd > 64) { return 0 - 22; } let set: usize = __raw_scratch(8); let w: i32 = 0; while (w < 8) { __raw_store8(set, w, 0); w = w + 1; } let bit: i32 = fd - 1; let bit_off: i32 = 0; if (fd > 32) { bit = fd - 33; bit_off = 4; } __raw_store8(set, bit_off + bit / 8, 1 << (bit % 8)); "
    + "if (op == 4) { let blocked: i32 = __syscall4(" + sysno(t, "rt_sigprocmask") + ", 0, set as i64, 0, 8) as i32; if (blocked < 0) { return blocked; } let sfd: i32 = __syscall4(" + sysno(t, "signalfd4") + ", 0 - 1, set as i64, 8, 526336) as i32; if (sfd < 0) { return sfd; } "
    + "let ev: usize = __raw_scratch(16); let e: i32 = 0; while (e < 16) { __raw_store8(ev, e, 0); e = e + 1; } __raw_store8(ev, 0, 1); let neg: i32 = 0 - fd; __raw_store8(ev, " + data_at + ", neg & 255); __raw_store8(ev, " + data_at + " + 1, (neg >> 8) & 255); __raw_store8(ev, " + data_at + " + 2, (neg >> 16) & 255); __raw_store8(ev, " + data_at + " + 3, (neg >> 24) & 255); "
    + "__raw_store8(ev, " + data_at + " + 4, sfd & 255); __raw_store8(ev, " + data_at + " + 5, (sfd >> 8) & 255); __raw_store8(ev, " + data_at + " + 6, (sfd >> 16) & 255); __raw_store8(ev, " + data_at + " + 7, (sfd >> 24) & 255); "
    + "let added: i32 = __syscall4(" + sysno(t, "epoll_ctl") + ", r_fd as i64, 1, sfd as i64, ev as i64) as i32; if (added < 0) { __syscall3(" + sysno(t, "close") + ", sfd as i64, 0, 0); return added; } return sfd; } "
    + "let ev2: usize = __raw_scratch(16); __syscall4(" + sysno(t, "epoll_ctl") + ", r_fd as i64, 2, arg as i64, ev2 as i64); __syscall3(" + sysno(t, "close") + ", arg as i64, 0, 0); return __syscall4(" + sysno(t, "rt_sigprocmask") + ", 1, set as i64, 0, 8) as i32; } ";
}

function parent_watch_src(t: string): string {
  if (t == "arm64-darwin") {
    return "if (op == 6) { let ppid: i32 = __syscall3(" + sysno(t, "getppid") + ", 0, 0, 0) as i32; if (ppid == 1) { return 0 - 3; } let pch: usize = __raw_scratch(32); let proc_filter: i32 = 0 - 5; let proc_flags: i32 = 17; "
      + kevent_change_src("pch", "ppid", "proc_filter", "proc_flags") + " __raw_store8(pch, 15, 128); return __syscall6(" + sysno(t, "kevent") + ", r_fd as i64, pch as i64, 1, 0, 0, 0) as i32; } ";
  }
  return "if (op == 6) { let pdeath: i32 = __syscall3(" + sysno(t, "prctl") + ", 1, 15, 0) as i32; if (pdeath < 0) { return pdeath; } if ((__syscall3(" + sysno(t, "getppid") + ", 0, 0, 0) as i32) == 1) { return 0 - 3; } return 0; } ";
}

pub function rt_src_reactor_ctl(t: string): string {
  let watch: string = "";
  if (t == "arm64-darwin") {
    watch = kqueue_watch_src(t);
  } else {
    watch = epoll_watch_src(t);
  }
  return "function __fern_reactor_ctl(r_fd: i32, op: i32, fd: i32, arg: i32): i32 { "
    + "if (op == 3) { return __syscall3(" + sysno(t, "close") + ", r_fd as i64, 0, 0) as i32; } "
    + signal_watch_src(t)
    + parent_watch_src(t)
    + "if (op != 1 && op != 2) { return 0 - 22; } let interest: i32 = arg & 23; if (op == 2) { interest = 0; } " + watch + " }";
}

function epoll_ev_size(t: string): string {
  if (t == "x86-64-linux") {
    return "12";
  }
  return "16";
}

function epoll_ev_data(t: string): string {
  if (t == "x86-64-linux") {
    return "4";
  }
  return "8";
}

function epoll_wait_src(t: string): string {
  let size: string = epoll_ev_size(t);
  let data_at: string = epoll_ev_data(t);
  return "let b: usize = __raw_arr_ptr(events); let buf: usize = b + 8; let n: i32 = __syscall6(" + sysno(t, "epoll_pwait") + ", r_fd as i64, buf as i64, cap as i64, timeout_ms as i64, 0, 8) as i32; "
    + "let i: i32 = n - 1; while (i >= 0) { let e: i32 = i * " + size + "; let bits: i32 = __raw_load8(buf, e); let ready: i32 = 0; "
    + "if ((bits & 1) != 0) { ready = ready | 1; } if ((bits & 4) != 0) { ready = ready | 2; } if ((bits & 24) != 0) { ready = ready | 4; } "
    + "let fd: i32 = __raw_load8(buf, e + " + data_at + ") | (__raw_load8(buf, e + " + data_at + " + 1) << 8) | (__raw_load8(buf, e + " + data_at + " + 2) << 16) | (__raw_load8(buf, e + " + data_at + " + 3) << 24); "
    + "if (fd < 0) { let sfd: i32 = __raw_load8(buf, e + " + data_at + " + 4) | (__raw_load8(buf, e + " + data_at + " + 5) << 8) | (__raw_load8(buf, e + " + data_at + " + 6) << 16) | (__raw_load8(buf, e + " + data_at + " + 7) << 24); let drain: usize = __raw_scratch(128); __syscall3(" + sysno(t, "read") + ", sfd as i64, drain as i64, 128); ready = 1; } "
    + "__raw_store_ptr(b, i * 2 + 1, fd as usize); __raw_store_ptr(b, i * 2 + 2, ready as usize); i = i - 1; } "
    + "return n;";
}

function kqueue_wait_src(t: string): string {
  return "let b: usize = __raw_arr_ptr(events); let buf: usize = b + 8; let kcap: i32 = cap / 2; let ts: usize = __raw_scratch(48); let tmo: usize = 0 as usize; "
    + "if (kcap < 1) { kcap = 1; buf = ts + 16; } "
    + "if (timeout_ms >= 0) { __raw_store_ptr(ts, 0, (timeout_ms / 1000) as usize); __raw_store_ptr(ts, 1, ((timeout_ms % 1000) * 1000000) as usize); tmo = ts; } "
    + "let n: i32 = __syscall6(" + sysno(t, "kevent") + ", r_fd as i64, 0, 0, buf as i64, kcap as i64, tmo as i64) as i32; "
    + "let i: i32 = 0; while (i < n) { let e: i32 = i * 32; let ready: i32 = 2; if (__raw_load8(buf, e + 8) == 255) { ready = 1; } "
    + "if ((__raw_load8(buf, e + 11) & 192) != 0) { ready = ready | 4; } "
    + "let fd: i32 = __raw_load8(buf, e) | (__raw_load8(buf, e + 1) << 8) | (__raw_load8(buf, e + 2) << 16) | (__raw_load8(buf, e + 3) << 24); "
    + "if (__raw_load8(buf, e + 8) == 250) { ready = 1; fd = 0 - fd; } if (__raw_load8(buf, e + 8) == 251) { ready = 1; fd = 0 - 15; } "
    + "__raw_store_ptr(b, i * 2 + 1, fd as usize); __raw_store_ptr(b, i * 2 + 2, ready as usize); i = i + 1; } "
    + "return n;";
}

pub function rt_src_task(t: string): string {
  return "function __fern_task_tab(): usize { let st: usize = __raw_task_state(); let tab: usize = __raw_load_ptr(st, 1); if (tab == 0 as usize) { tab = __alloc(512); let i: i32 = 0; while (i < 64) { __raw_store_ptr(tab, i, 0 as usize); i = i + 1; } __raw_store_ptr(st, 1, tab); __raw_store_ptr(st, 2, 64 as usize); } return tab; }"
    + " function __fern_task_rec(id: i32): usize { let tab: usize = __fern_task_tab(); return __raw_load_ptr(tab, id); }"
    + " function __fern_task_blank(): usize { let rec: usize = __alloc(96); let w: i32 = 0; while (w < 12) { __raw_store_ptr(rec, w, 0 as usize); w = w + 1; } return rec; }"
    + " function __fern_task_new(): i32 { let st: usize = __raw_task_state(); let tab: usize = __fern_task_tab(); let cap: i32 = __raw_load_ptr(st, 2) as i32; let id: i32 = 1; while (id < cap) { let rec: usize = __raw_load_ptr(tab, id); if (rec == 0 as usize) { __raw_store_ptr(tab, id, __fern_task_blank()); return id; } if (__raw_load_ptr(rec, 7) != 0 as usize) { __raw_store_ptr(rec, 7, 0 as usize); __raw_store_ptr(rec, 0, 0 as usize); __raw_store_ptr(rec, 1, 0 as usize); __raw_store_ptr(rec, 2, 0 as usize); __raw_store_ptr(rec, 3, 0 as usize); __raw_store_ptr(rec, 5, 0 as usize); __raw_store_ptr(rec, 9, 0 as usize); return id; } id = id + 1; } let ntab: usize = __alloc(cap * 16); let j: i32 = 0; while (j < cap * 2) { let v: usize = 0 as usize; if (j < cap) { v = __raw_load_ptr(tab, j); } __raw_store_ptr(ntab, j, v); j = j + 1; } __free(tab, cap * 8); __raw_store_ptr(st, 1, ntab); __raw_store_ptr(st, 2, (cap * 2) as usize); __raw_store_ptr(ntab, cap, __fern_task_blank()); return cap; }"
    + " function __fern_task_free(id: i32): i32 { let rec: usize = __fern_task_rec(id); if (rec != 0 as usize) { __raw_store_ptr(rec, 7, 1 as usize); } return 0; }"
    + " function __fern_task_cur(): i32 { let st: usize = __raw_task_state(); return __raw_load_ptr(st, 0) as i32; }"
