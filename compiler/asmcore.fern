function infer_call_named_type(id: ast.ExprIdent, c: ast.ExprCall, s: EmitState): Ty {
  if (s.has_local(id.name)) {
    let lt: Ty = s.local_type_of(id.name);
    if (is_fn(lt)) {
      return fn_ret(lt);
    }
    return ty_unknown();
  }
  let ctor_fn: i32 = 0 - 1;
  if (id.name == "Some" || id.name == "Ok" || id.name == "Err") {
    ctor_fn = top_level_fn(id.name, s);
  }
  if (ctor_fn >= 0) {
    return ty_from_name(s.funcs[ctor_fn].ret_type);
  }
  if (id.name == "Some" && c.args.len() == 1) {
    return ty_option(infer_expr_type(c.args[0], s));
  }
  if (id.name == "Ok" && c.args.len() == 1) {
    return ty_result(infer_expr_type(c.args[0], s));
  }
  if (id.name == "Err" && c.args.len() == 1) {
    return ty_result(ty_unknown());
  }
  if (id.name == "read_file") {
    return ty_result(ty_string());
  }
  if (id.name == "read_file_bytes") {
    return ty_result(ty_array_i32());
  }
  if (id.name == "write_file" || id.name == "write_file_bytes") {
    return ty_result(ty_unknown());
  }
  if (id.name == "write_file_exec") {
    return ty_result(ty_unknown());
  }
  if (s.builtin_i32.has(id.name)) {
    return ty_i32();
  }
  if (id.name == "remove_file") {
    return ty_option(ty_unknown());
  }
  if (id.name == "create_dir_all") {
    return ty_option(ty_unknown());
  }
  if (id.name == "create_dir") {
    return ty_option(ty_unknown());
  }
  if (id.name == "remove_dir") {
    return ty_option(ty_unknown());
  }
  if (id.name == "create_link") {
    return ty_option(ty_unknown());
  }
  if (id.name == "clone_file") {
    return ty_option(ty_unknown());
  }
  if (id.name == "create_symlink") {
    return ty_option(ty_unknown());
  }
  if (id.name == "rename") {
    return ty_option(ty_unknown());
  }
  if (id.name == "rename_noreplace") {
    return ty_option(ty_unknown());
  }
  if (id.name == "rename_exchange") {
    return ty_option(ty_unknown());
  }
  if (id.name == "chmod") {
    return ty_option(ty_unknown());
  }
  if (id.name == "chmod_at") {
    return ty_option(ty_unknown());
  }
  if (id.name == "signal_send") {
    return ty_option(ty_unknown());
  }
  if (id.name == "set_process_group") {
    return ty_option(ty_unknown());
  }
  if (id.name == "set_priority") {
    return ty_option(ty_unknown());
  }
  if (id.name == "clock_set") {
    return ty_option(ty_unknown());
  }
  if (id.name == "truncate") {
    return ty_option(ty_unknown());
  }
  if (id.name == "sync") {
    return ty_unknown();
  }
  if (id.name == "mknod") {
    return ty_option(ty_unknown());
  }
  if (id.name == "chown_at") {
    return ty_option(ty_unknown());
  }
  if (id.name == "set_file_times") {
    return ty_option(ty_unknown());
  }
  if (id.name == "read_link" || id.name == "getcwd") {
    return ty_result(ty_string());
  }
  if (id.name == "read_link_bytes" || id.name == "getxattr_bytes" || id.name == "lgetxattr_bytes") {
    return ty_result(ty_array_i32());
  }
  if (id.name == "getxattr" || id.name == "lgetxattr") {
    return ty_result(ty_string());
  }
  if (id.name == "setxattr" || id.name == "lsetxattr" || id.name == "setxattr_bytes" || id.name == "lsetxattr_bytes") {
    return ty_option(ty_unknown());
  }
  if (id.name == "window_size") {
    return ty_unknown();
  }
  if (id.name == "subprocess") {
    return ty_unknown();
  }
  if (id.name == "temp_dir") {
    return ty_result(ty_string());
  }
  if (id.name == "read_dir_bytes") {
    return ty_result(ty_array());
  }
  if (id.name == "read_dir" || id.name == "read_dir_all") {
    return ty_result(ty_array_string());
  }
  if (id.name == "read_dir_ino" || id.name == "read_dir_ino_all") {
    return ty_result(ty_array());
  }
  if (id.name == "environ") {
    return ty_array_string();
  }
  if (id.name == "stat") {
    return ty_result(ty_unknown());
  }
  if (id.name == "access") {
    return ty_result(ty_unknown());
  }
  if (id.name == "lstat") {
    return ty_result(ty_unknown());
  }
  if (id.name == "statfs") {
    return ty_result(ty_unknown());
  }
  if (id.name == "mounts") {
    return ty_result(ty_unknown());
  }
  if (id.name == "remove_dir_all") {
    return ty_option(ty_unknown());
  }
  if (id.name == "f64_from_bits" || id.name == "f32_from_bits") {
    return ty_f64();
  }
  if (id.name == "env" || id.name == "config_get") {
    return ty_option(ty_string());
  }
  if (id.name == "open_reader" || id.name == "open_reader_with") {
    return ty_result(ty_named("Reader"));
  }
  if (id.name == "open_writer_with") {
    return ty_result(ty_named("Writer"));
  }
  if (id.name == "open_writer" || id.name == "open_appender" || id.name == "open_exclusive") {
    return ty_result(ty_named("Writer"));
  }
  if (id.name == "stdin") {
    return ty_named("Reader");
  }
  if (id.name == "stdout" || id.name == "stderr") {
    return ty_named("Writer");
  }
  if (s.builtin_string.has(id.name)) {
    return ty_string();
  }
  if (id.name == "__raw_array") {
    return ty_array_i32();
  }
  if (id.name == "__fern_str_eq") {
    return ty_bool();
  }
  if (id.name == "__load_i64") {
    return ty_i64();
  }
  if (id.name == "__heap_bump_bytes") {
    return ty_i64();
  }
  if (id.name == "__heap_alloc_count") {
    return ty_i64();
  }
  if (id.name == "__heap_mark") {
    return ty_i64();
  }
  if (id.name == "__clz32" || id.name == "__ctz32" || id.name == "__popcount32"
    || id.name == "__clz64" || id.name == "__ctz64" || id.name == "__popcount64") {
    return ty_i32();
  }
  if (id.name == "__mulhi_u64") {
    return ty_u64();
  }
  if (id.name == "__arr_push_shared_bytes") {
    return ty_i64();
  }
  if (id.name == "args") {
    return ty_array_string();
  }
  if (id.name == "getgroups") {
    return ty_array_i64();
  }
  if (id.name == "__alloc_u8" || id.name == "__alloc_i32" || id.name == "__alloc_bool" || id.name == "buf_take_bytes") {
    return ty_array_i32();
  }
  if (id.name == "__alloc_i64") {
    return ty_array_i64();
  }
  if (id.name == "random_bytes") {
    return ty_array_i32();
  }
  if (id.name == "map_new") {
    return ty_map_str(ty_unknown());
  }
  if (id.name == "__map_new_i32") {
    return ty_map_i32(ty_unknown());
  }
  if (id.name == "cell_new" && c.args.len() == 1) {
    return ty_cell(infer_expr_type(c.args[0], s));
  }
  if (id.name == "__abs_f64" || id.name == "__sqrt_f64"
    || id.name == "__floor_f64" || id.name == "__ceil_f64"
    || id.name == "__trunc_f64" || id.name == "__round_f64") {
    return ty_f64();
  }
  if (id.name == "str_split") {
    return ty_array_string();
  }
  let fi: i32 = top_level_fn(id.name, s);
  if (fi >= 0) {
    return ty_from_name(s.funcs[fi].ret_type);
  }
  return ty_unknown();
}

pub function top_level_fn(name: string, s: EmitState): i32 {
  let fi: i32 = s.funcs_ix.chain(name);
  while (fi >= 0) {
    if (s.funcs[fi].name == name && s.funcs[fi].receiver_type.len() == 0) {
      return fi;
    }
    fi = s.funcs_ix.next[fi];
  }
  return 0 - 1;
}

function infer_expr_call_type(c: ast.ExprCall, s: EmitState): Ty {
  match (c.callee) {
    ast.ExprIdent(id) => {
      return infer_call_named_type(id, c, s);
    },
    ast.ExprFieldAccess(fa) => {
      return infer_call_method_type(fa, c, s);
    },
    _ => {
      return ty_unknown();
    }
  }
  return ty_unknown();
}

function infer_expr_unary_type(u: ast.ExprUnary, s: EmitState): Ty {
  if (u.op == "!") {
    return ty_bool();
  }
  if (u.op == "-") {
    return infer_expr_type(u.operand, s);
  }
  if (u.op.len() >= 3 && slice_unchecked(u.op, 0, 3) == "as_") {
    let ct: str = slice_unchecked(u.op, 3, u.op.len());
    if (ct == "f64" || ct == "f32") {
      return ty_f64();
    }
    if (ct == "u8") {
      return ty_u8();
    }
    if (ct == "i32" || ct == "usize" || ct == "char") {
      return ty_i32();
    }
    if (ct == "u32") {
      return ty_u32();
    }
    if (ct == "i64") {
      return ty_i64();
    }
    if (ct == "u64") {
      return ty_u64();
    }
    return ty_from_name(ct);
  }
  if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
    return ty_from_name("Option[" + slice_unchecked(u.op, 4, u.op.len()) + "]");
  }
  if (u.op == "try_") {
    let ot: Ty = infer_expr_type(u.operand, s);
    match (ot) {
      TyResult(_) => {
        return result_inner(ot);
      },
      TyOption(_) => {
        return option_inner(ot);
      },
      _ => {
        return ty_i32();
      }
    }
  }
  return ty_i32();
}

function infer_expr_binary_type(b: ast.ExprBinary, s: EmitState): Ty {
  if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">="
    || b.op == "==" || b.op == "!=" || b.op == "&&" || b.op == "||") {
    return ty_bool();
  }
  if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
    let lt: Ty = infer_expr_type(b.left, s);
    let rt: Ty = infer_expr_type(b.right, s);
    if (ty_is_string(lt) || ty_is_string(rt)) {
      return ty_string();
    }
    if (ty_is_f64(lt) || ty_is_f64(rt)) {
      return ty_f64();
    }
    return ty_i32();
  }
  if (b.op == "+|" || b.op == "-|" || b.op == "*|" || b.op == "<<|") {
    let slt: Ty = infer_expr_type(b.left, s);
    if (ty_is_i32(slt)) {
      return infer_expr_type(b.right, s);
    }
    return slt;
  }
  if (b.op == "+?" || b.op == "-?" || b.op == "*?" || b.op == "/?" || b.op == "%?" || b.op == "<<?" || b.op == ">>?") {
    let clt: Ty = infer_expr_type(b.left, s);
    if (ty_is_i32(clt)) {
      return ty_option(infer_expr_type(b.right, s));
    }
    return ty_option(clt);
  }
  return ty_i32();
}

pub function infer_expr_type(e: ast.Expr, s: EmitState): Ty {
  match (e) {
    ast.ExprBytes(_) => {
      return ty_array_i32();
    },
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return ty_f64();
      }
      return ty_i32();
    },
    ast.ExprBool(_) => {
      return ty_bool();
    },
    ast.ExprString(_) => {
      return ty_string();
    },
    ast.ExprArray(a) => {
      if (a.elements.len() == 0) {
        return ty_array();
      }
      let et: Ty = infer_expr_type(a.elements[0], s);
      if (ty_is_string(et)) {
        return ty_array_string();
      }
      if (ty_is_i32(et) || ty_is_bool(et)) {
        return ty_array_i32();
      }
      return ty_array();
    },
    ast.ExprTuple(_) => {
      return ty_tuple();
    },
    ast.ExprMapLit(_) => {
      return ty_map_any();
    },
    ast.ExprFString(_) => {
      return ty_string();
    },
    ast.ExprStructLit(_) => {
      return ty_struct();
    },
    ast.ExprLambda(lm) => {
      return ty_fn(ty_from_name(lm.ret_type));
    },
    ast.ExprIdent(id) => {
      if (s.has_local(id.name)) {
        return s.local_type_of(id.name);
      }
      if (id.name == "None") {
        return ty_option(ty_unknown());
      }
      let cfi: i32 = s.funcs_ix.chain(id.name);
      while (cfi >= 0) {
        if (s.funcs[cfi].name == id.name && s.funcs[cfi].receiver_type.len() == 0 && s.funcs[cfi].params.len() == 0) {
          return ty_from_name(s.funcs[cfi].ret_type);
        }
        cfi = s.funcs_ix.next[cfi];
      }
      return s.local_type_of(id.name);
    },
    ast.ExprBinary(b) => {
      return infer_expr_binary_type(b, s);
    },
    ast.ExprUnary(u) => {
      return infer_expr_unary_type(u, s);
    },
    ast.ExprCall(c) => {
      return infer_expr_call_type(c, s);
    },
    ast.ExprIndex(x) => {
      let at: Ty = infer_expr_type(x.array, s);
      if (ty_is_string(at)) {
        return ty_u8();
      }
      if (ty_is_array_string(at)) {
        return ty_string();
      }
      if (ty_is_array_u64(at)) {
        return ty_u64();
      }
      if (ty_is_array_u32(at)) {
        return ty_u32();
      }
      if (ty_is_array_i64(at)) {
        return ty_i64();
      }
      if (ty_is_array_i32(at)) {
        return ty_i32();
      }
      return ty_unknown();
    },
    ast.ExprSlice(sl) => {
      let src: Ty = infer_expr_type(sl.array, s);
      if (ty_is_string(src)) {
        return ty_option(ty_unknown());
      }
      return src;
    },
    ast.ExprFieldAccess(fa) => {
      let frt: Ty = infer_expr_type(fa.obj, s);
      return field_type_tag_in(ty_struct_name(frt), fa.field, s);
    },
    ast.ExprUnknown(_) => {
      return ty_unknown();
    },
    ast.ExprZero(z) => {
      return ty_from_name(z.type_name);
    }
  }
  return ty_unknown();
}

pub function (s: EmitState) reset_locals(): EmitState {
  let ln: string[] = [];
  let lts: Ty[] = [];
  return EmitState { ...s, local_names: ln, local_types: lts };
}

pub function (s: EmitState) has_local(name: string): boolean {
  let i: i32 = 0;
  while (i < s.local_names.len()) {
    if (s.local_names[i] == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub struct LabelOut { state: EmitState, name: string }

// Under -harden a function value points at a stub that starts with the
// landing pad an indirect call checks for, so only an address-taken
// function is a valid indirect target.
pub function cfi_stub_label(s: EmitState, target: string): string {
  if (s.str_ns.len() > 0) {
    return ".Lfern_cfi_" + s.str_ns + "_" + sanitize_label(target);
  }
  return ".Lfern_cfi_" + sanitize_label(target);
}

pub function with_cfi_stub(s: EmitState, target: string): EmitState {
  if (util.index_of_str(s.cfi_stubs, target) >= 0) {
    return s;
  }
  return EmitState { ...s, cfi_stubs: s.cfi_stubs.append(target) };
}

pub function fresh_label(s: EmitState): LabelOut {
  let name: string = ".L" + util.i32_to_string(s.label_n);
  if (s.str_ns.len() > 0) {
    name = ".L" + s.str_ns + "_" + util.i32_to_string(s.label_n);
  }
  let ns: EmitState = EmitState { ...s, label_n: s.label_n + 1 };
  return LabelOut { state: ns, name: name };
}

pub struct Lab { id: i32, pre: string, n: i32 }

pub function (l: Lab) text(): string {
  if (l.n < 0) {
    return l.pre;
  }
  return l.pre + util.i32_to_string(l.n);
}

pub struct LabNew { state: EmitState, lab: Lab }

pub function lab_new(s: EmitState, name: string): LabNew {
  return LabNew { state: EmitState { ...s, nlab: s.nlab + 1 }, lab: Lab { id: s.nlab, pre: name, n: 0 - 1 } };
}

pub function (s: EmitState) lab_take(n: i32): EmitState {
  return EmitState { ...s, nlab: s.nlab + n };
}

pub function (s: EmitState) lab_def(l: Lab): EmitState {
  if (s.records()) {
    buf_push_u64(s.recs, l.id as u64);
    return s.mark("\x04", "");
  }
  return s.write(l.text() + ":\n");
}

pub function (s: EmitState) lab_ref(payload: i64, l: Lab): EmitState {
  buf_push_u64(s.recs, (l.id as i64 << 32 | payload & 4294967295i64) as u64);
  return s.mark("\x05", "");
}

pub function (s: EmitState) cfi(kind: i32, reg: i32, off: i32): EmitState {
  buf_push_u64(s.recs, ((off as i64 & 4294967295i64) << 32 | reg as i64 << 8 | kind as i64) as u64);
  return s.mark("\x06", "");
}

pub function name_has_comma(name: string): boolean {
  let i: i32 = 0;
  while (i < name.len()) {
    if (name[i] == b',') {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub struct ConstAggOut { state: EmitState, idx: i32 }

pub function add_const_agg(s: EmitState, packed: string): ConstAggOut {
  let i: i32 = s.const_agg_ix.find(packed);
  if (i >= 0) {
    return ConstAggOut { state: s, idx: i };
  }
  let idx: i32 = s.const_aggs.len();
  return ConstAggOut { state: EmitState { ...s, const_aggs: s.const_aggs.append(packed), const_agg_ix: s.const_agg_ix.added(packed) }, idx: idx };
}

pub function str_lit_label(s: EmitState, idx: i32): string {
  if (s.str_ns.len() == 0) {
    return ".S" + util.i32_to_string(idx);
  }
  return ".S" + s.str_ns + "_" + util.i32_to_string(idx);
}

pub function str_box_label(s: EmitState, idx: i32): string {
  if (s.str_ns.len() == 0) {
    return ".SB" + util.i32_to_string(idx);
  }
  return ".SB" + s.str_ns + "_" + util.i32_to_string(idx);
}

pub function const_agg_label(s: EmitState, idx: i32): string {
  if (s.str_ns.len() == 0) {
    return ".K" + util.i32_to_string(idx);
  }
  return ".K" + s.str_ns + "_" + util.i32_to_string(idx);
}

pub struct ConstAggPack { state: EmitState, text: string }

pub function const_agg_pack(own s: EmitState, packed: string, entry: string): ConstAggPack {
  if (ir.const_struct_is_bytes(packed)) {
    return ConstAggPack { state: s, text: "8|" + ir.const_struct_payload(packed) };
  }
  let body: string = ir.const_struct_fn_body(packed);
  if (body.len() > 0) {
    let target: string = "__fn_" + sanitize_label(body) + entry;
    if (s.harden) {
      s = with_cfi_stub(s, target);
      let stub: string = cfi_stub_label(s, target);
      return ConstAggPack { state: s, text: "1|" + stub };
    }
    return ConstAggPack { state: s, text: "1|" + target };
  }
  let shp: ShapeRefOut = const_agg_shape(s, packed);
  s = shp.state;
  let text: string = shp.label + "|";
  let vals: string[] = ir.const_struct_values(packed);
  let i: i32 = 0;
  while (i < vals.len()) {
    if (i > 0) {
      text = text + ",";
    }
    let w: ConstAggPack = const_agg_word(s, vals[i], entry);
    s = w.state;
    text = text + w.text;
    i = i + 1;
  }
  return ConstAggPack { state: s, text: text };
}

function const_agg_word(own s: EmitState, word: string, entry: string): ConstAggPack {
  let inner: string = ir.const_struct_ref(word);
  if (inner.len() == 0) {
    return ConstAggPack { state: s, text: word };
  }
  if (ir.const_struct_is_str(inner)) {
    let lit: StringLitOut = add_string_lit(s, ir.const_str_text(inner));
    return ConstAggPack { state: lit.state, text: str_box_label(lit.state, lit.idx) };
  }
  let pk: ConstAggPack = const_agg_pack(s, inner, entry);
  let kout: ConstAggOut = add_const_agg(pk.state, pk.text);
  return ConstAggPack { state: kout.state, text: const_agg_label(kout.state, kout.idx) };
}

function const_agg_shape(own s: EmitState, packed: string): ShapeRefOut {
  if (ir.const_struct_is_bytes(packed)) {
    return ShapeRefOut { state: s, label: "8" };
  }
  if (ir.const_struct_is_option(packed)) {
    return ShapeRefOut { state: s, label: "o" };
  }
  if (!ir.const_struct_is_array(packed)) {
    return shape_ref(s, ir.const_struct_type(packed));
  }
  return ShapeRefOut { state: s, label: "0" };
}

pub struct StringLitOut { state: EmitState, idx: i32 }

function slit_buckets(): i32 {
  return 1021;
}

function slit_empty_buckets(): i32[] {
  return util.minus_ones(slit_buckets());
}

pub function string_lit_index(s: EmitState, v: string): i32 {
  let i: i32 = s.slit_head[util.hash_bucket(v, s.slit_head.len())];
  while (i >= 0) {
    if (s.string_lits[i] == v) {
      return i;
    }
    i = s.slit_next[i];
  }
  return 0 - 1;
}

pub function add_string_lit(own s: EmitState, v: string): StringLitOut {
  let at: i32 = string_lit_index(s, v);
  if (at >= 0) {
    return StringLitOut { state: s, idx: at };
  }
  let b: i32 = util.hash_bucket(v, s.slit_head.len());
  let idx: i32 = s.string_lits.len();
  let ns: EmitState = EmitState { ...s, string_lits: s.string_lits.append(v), slit_next: s.slit_next.append(s.slit_head[b]), slit_head: s.slit_head.with(b, idx) };
  return StringLitOut { state: ns, idx: idx };
}

pub function (s: EmitState) need(name: string): EmitState {
  if (s.has_need(name)) {
    return s;
  }
  let i: i32 = s.needed.len();
  let cur: EmitState = EmitState { ...s, needed: s.needed.append(name) };
  while (i < cur.needed.len()) {
    let deps: string[] = runtime_need_deps(cur.needed[i]);
    let j: i32 = 0;
    while (j < deps.len()) {
      if (!cur.has_need(deps[j])) {
        cur = EmitState { ...cur, needed: cur.needed.append(deps[j]) };
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return cur;
}

pub function runtime_need_deps(name: string): string[] {
  if (name == "buf_text") {
    let deps: string[] = ["buf"];
    return deps;
  }
  let heap: string[] = ["heap"];
  if (name == "str_concat" || name == "i32_to_string"
    || name == "u32_to_string" || name == "i64_to_string" || name == "u64_to_string"
    || name == "args" || name == "read_file" || name == "read_file_bytes"
    || name == "random_bytes" || name == "write_file_bytes" || name == "write_file_bytes_u8"
    || name == "str_from_bytes" || name == "alloc_u8"
    || name == "read_file_bytes_u8" || name == "random_bytes_u8"
    || name == "str_bytes_u8" || name == "str_from_bytes_u8" || name == "str_from_bytes_range_u8" || name == "arr_slice_u8" || name == "alloc_bytes"
    || name == "arr_push" || name == "arr_slice" || name == "str_own" || name == "str_borrow" || name == "str_grow"
    || name == "str_case" || name == "str_repeat"
    || name == "str_replace"
    || name == "poll" || name == "task" || name == "set_args") {
    return heap;
  }
  if (name == "str_trim") {
    let dtrim: string[] = ["heap", "str_concat"];
    return dtrim;
  }
  if (name == "arr_push_u8") {
    let du8: string[] = ["arr_push", "heap"];
    return du8;
  }
  if (name == "buf") {
    let dbuf: string[] = ["heap", "memcpy"];
    return dbuf;
  }
  if (name == "buf_u8" || name == "buf_bytes" || name == "buf_bytes_u8") {
    let dbu8: string[] = ["buf", "heap"];
    return dbu8;
  }
  if (name == "arr_own_elems") {
    let dao: string[] = ["str_own"];
    return dao;
  }
  if (name == "arr_push_owned") {
    let d2: string[] = ["arr_push"];
    return d2;
  }
  if (array_helper_need(name)) {
    let d4: string[] = ["heap"];
    return d4;
  }
  if (name == "str_lines") {
    let d5: string[] = ["heap", "arr_push", "arr_push_owned", "str_concat"];
    return d5;
  }
  if (name == "str_bytes") {
    let d6: string[] = ["heap"];
    return d6;
  }
  if (name == "str_split") {
    let d8: string[] = ["heap", "arr_push", "arr_push_owned", "str_concat"];
    return d8;
  }
  if (name == "read_dir_bytes" || name == "read_dir" || name == "read_dir_all" || name == "read_dir_ino" || name == "read_dir_ino_all") {
    let d9: string[] = ["heap", "arr_push", "arr_push_owned"];
    return d9;
  }
  if (name == "environ") {
    let d9e: string[] = ["heap", "arr_push", "arr_push_owned"];
    return d9e;
  }
  if (name == "getgroups") {
    let d9g: string[] = ["heap", "arr_push", "arr_push_owned"];
    return d9g;
  }
  if (name == "remove_dir_all") {
    let d10: string[] = ["heap"];
    return d10;
  }
  let none: string[] = [];
  return none;
}

pub function (s: EmitState) has_need(name: string): boolean {
  let i: i32 = 0;
  while (i < s.needed.len()) {
    if (s.needed[i] == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function (s: EmitState) any_need(names: string[]): boolean {
  let i: i32 = 0;
  while (i < names.len()) {
    if (s.has_need(names[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub struct ScanShape { nibble: boolean, invert: boolean, range: boolean, bytes: i32[] }

pub function scan_set_shape(members: string): ScanShape {
  let inside: ScanShape = scan_shape_of(members, b'1', false);
  let outside: ScanShape = scan_shape_of(members, b'0', true);
  if (scan_shape_cost(outside) < scan_shape_cost(inside)) {
    return outside;
  }
  return inside;
}

pub function scan_shape_cost(sh: ScanShape): i32 {
  if (sh.nibble) {
    return 11;
  }
  if (sh.range) {
    return 1 + 2 * (sh.bytes.len() - 1);
  }
  return 2 * sh.bytes.len() - 1;
}

function scan_shape_of(members: string, mark: u8, invert: boolean): ScanShape {
  let marked: i32[] = [];
  let lo: i32 = 0;
  let span: i32 = 0 - 1;
  let run: i32 = 0;
  let b: i32 = 0;
  while (b < 256) {
    if (members[b] == mark) {
      marked = marked.append(b);
      run = run + 1;
      if (run - 1 > span) {
        lo = b - run + 1;
        span = run - 1;
      }
    } else {
      run = 0;
    }
    b = b + 1;
  }
  let n: i32 = marked.len();
  let nibble: ScanShape = ScanShape { nibble: true, invert: false, range: false, bytes: [] };
  if (n == 0 || n == 256) {
    return nibble;
  }
  if (span >= 1 && n - span - 1 <= 3) {
    let bytes: i32[] = [lo, span];
    for m in marked {
      if (m < lo || m > lo + span) {
        bytes = bytes.append(m);
      }
    }
    return ScanShape { nibble: false, invert: invert, range: true, bytes: bytes };
  }
  if (n <= 4) {
    return ScanShape { nibble: false, invert: invert, range: false, bytes: marked };
  }
  return nibble;
}

pub function utf8_tables(label: string): string {
  let o: string = "    .section .rodata\n    .balign 16\n" + label + ":\n";
  o = o + "    .byte 2, 2, 2, 2, 2, 2, 2, 2, 128, 128, 128, 128, 33, 1, 21, 73\n";
  o = o + "    .byte 231, 163, 131, 131, 139, 203, 203, 203, 203, 203, 203, 203, 203, 219, 203, 203\n";
  o = o + "    .byte 1, 1, 1, 1, 1, 1, 1, 1, 230, 174, 186, 186, 1, 1, 1, 1\n";
  for c in [15, 96, 112, 128] {
    let r: string = "    .byte " + util.i32_to_string(c);
    let k: i32 = 1;
    while (k < 16) {
      r = r + ", " + util.i32_to_string(c);
      k = k + 1;
    }
    o = o + r + "\n";
  }
  return o;
}

pub function scan_set_tables(members: string): string {
  let out: u8[] = [];
  let half: i32 = 0;
  while (half < 2) {
    let lo: i32 = 0;
    while (lo < 16) {
      let bits: i32 = 0;
      let h: i32 = 0;
      while (h < 8) {
        if (members[(half * 8 + h) * 16 + lo] == b'1') {
          bits = bits | 1 << h;
        }
        h = h + 1;
      }
      out = out.append(bits as u8);
      lo = lo + 1;
    }
    half = half + 1;
  }
  let k: i32 = 0;
  while (k < 16) {
    out = out.append((1 << (k & 7)) as u8);
    k = k + 1;
  }
  for m in [143, 128, 15] {
    k = 0;
    while (k < 16) {
      out = out.append(m as u8);
      k = k + 1;
    }
  }
  k = 0;
  while (k < 256) {
    if (members[k] == b'1') {
      out = out.append(1 as u8);
    } else {
      out = out.append(0 as u8);
    }
    k = k + 1;
  }
  for c in scan_set_shape(members).bytes {
    out = out.append(c as u8);
  }
  return string_from_bytes_unchecked(out);
}

pub function escape_for_ascii(s: string): string {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b == 34) {
      out = out.append(92 as u8);
      out = out.append(34 as u8);
    } else if (b == 92) {
      out = out.append(92 as u8);
      out = out.append(92 as u8);
    } else if (b == 10) {
      out = out.append(92 as u8);
      out = out.append(110 as u8);
    } else if (b == 9) {
      out = out.append(92 as u8);
      out = out.append(116 as u8);
    } else if (b == 13) {
      out = out.append(92 as u8);
      out = out.append(114 as u8);
    } else if (b < 32 || b >= 127) {
      let o0: i32 = b % 8;
      let o1: i32 = b / 8 % 8;
      let o2: i32 = b / 64 % 8;
      out = out.append(92 as u8);
      out = out.append((48 + o2) as u8);
      out = out.append((48 + o1) as u8);
      out = out.append((48 + o0) as u8);
    } else {
      out = out.append(s[i] as u8);
    }
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

pub function has_main(mod: parser.Module): boolean {
  return declares_main(mod.funcs);
}

pub function declares_main(funcs: parser.FuncDecl[]): boolean {
  for fd in funcs {
    if (fd.name == "main") {
      return true;
    }
  }
  return false;
}

pub function is_script_module(mod: parser.Module): boolean {
  if (has_main(mod)) {
    return false;
  }
  return mod.top_stmts.len() > 0;
}

pub function synth_script_main(mod: parser.Module): parser.Module {
  if (!is_script_module(mod)) {
    return mod;
  }
  let body: ast.Stmt[] = mod.top_stmts;
  let ends_in_return: boolean = false;
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      ends_in_return = true;
    },
    _ => {}
  }
  if (!ends_in_return) {
    body = body.append(ast.StmtReturn {
      value: ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, bits: 0, line: 0, col: 0 },
      line: 0,
      col: 0,
    });
  }
  let entry: parser.FuncDecl = parser.FuncDecl {
    is_unsafe: false,
    stdlib: "", no_inline: false, always_inline: false,
    name: "main", receiver_name: "", receiver_type: "", receiver_own: false, type_params: [],
    params: [], ret_type: "i32", body: body, line: 0, col: 0,
    import_iface: "", import_wit: "", all_type_params: [],
    bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false,
    is_pub: true,
    is_const: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [],
  };
  return parser.Module { ...mod, funcs: mod.funcs.append(entry), top_stmts: [] };
}

pub struct CheckCtx { st: EmitState, diags: util.Diag[] }

pub function is_wrapper(tag: Ty): boolean {
  return is_option(tag) || is_result(tag);
}

pub function is_concrete(tag: Ty): boolean {
  return is_int_tag(tag) || ty_is_string(tag) || ty_is_bool(tag) || ty_is_f64(tag)
    || is_int_array_tag(tag) || ty_is_array_string(tag) || ty_is_array(tag);
}

pub function assignable(want: Ty, got: Ty): boolean {
  if (ty_eq(want, got)) {
    return true;
  }
  if (ty_is_unknown(want) || ty_is_unknown(got)) {
    return true;
  }
  let ww: boolean = is_wrapper(want);
  let gw: boolean = is_wrapper(got);
  if (ww && gw) {
    return true;
  }
  if (ww || gw) {
    let other: Ty = want;
    if (ww) {
      other = got;
    }
    if (is_concrete(other)) {
      return false;
    }
    return true;
  }
  return true;
}

function parse_unknown_error(where: string, kind: string, line: i32, col: i32): util.Diag {
  let lex: string = kind;
  if (util.str_has_prefix(lex, "stmt: ")) {
    lex = slice_unchecked(lex, 6, lex.len()) + "";
  }
  if (util.str_has_prefix(lex, "lex:")) {
    return util.Diag { related: [], length: 0, code: slice_unchecked(lex, 4, 8) + "", message: slice_unchecked(lex, 9, lex.len()) + "", line: line, col: col, fix: None };
  }
  if (util.str_has_prefix(lex, "code:")) {
    return util.Diag { related: [], length: 0, code: slice_unchecked(lex, 5, 9) + "", message: where + ": " + slice_unchecked(lex, 10, lex.len()), line: line, col: col, fix: None };
  }
  if (util.is_f64_range_kind(kind)) {
    return util.Diag { related: [], length: 0, code: "P002", message: where + ": " + util.f64_range_message(kind), line: line, col: col, fix: None };
  }
  if (kind == "nest:too-deep" || kind == "stmt: nest:too-deep") {
    return util.Diag { related: [], length: 0, code: "P005", message: where + ": input nests deeper than " + util.i32_to_string(parser.MAX_NEST_DEPTH) + " levels", line: line, col: col, fix: None };
  }
  if (kind == "value branch has no trailing expression" || kind == "stmt: value branch has no trailing expression") {
    return util.Diag { related: [], length: 0, code: "E061", message: parser.BLOCK_VALUE_REQUIRED_MESSAGE, line: line, col: col, fix: None };
  }
  let decl: string = decl_sentinel_text(kind);
  if (decl.len() > 0) {
    return util.Diag { related: [], length: 0, code: "P001", message: where + ": " + decl, line: line, col: col, fix: None };
  }
  return util.Diag { related: [], length: 0, code: "P001", message: where + ": " + sentinel_message(kind), line: line, col: col, fix: None };
}

function sentinel_message(kind: string): string {
  let k: string = kind;
  if (util.str_has_prefix(k, "stmt: ")) {
    k = slice_unchecked(k, 6, k.len()) + "";
  }
  if (util.str_has_prefix(k, "punct:")) {
    return "expected an expression, got \"" + slice_unchecked(k, 6, k.len()) + "\"";
  }
  if (util.str_has_prefix(k, "keyword:")) {
    return "expected an expression, got \"" + slice_unchecked(k, 8, k.len()) + "\"";
  }
  if (util.str_has_prefix(k, "missing ")) {
    return missing_message(slice_unchecked(k, 8, k.len()) + "");
  }
  if (k == "eof") {
    return "expected an expression, got the end of the file";
  }
  if (k == "primary") {
    return "expected an expression";
  }
  if (k == "lambda: bad destructuring param") {
    return "expected a parameter name or a destructuring pattern";
  }
  if (k == "bad tuple pattern") {
    return "expected a tuple pattern";
  }
  return k;
}

function missing_message(what: string): string {
  if (what == "= in let") {
    return "expected \"=\" after the name in this declaration";
  }
  if (what == "`in` in for") {
    return "expected \"in\" after the `for` pattern";
  }
  if (what == "for-let name") {
    return "expected a name after \"let\" in this `for` loop";
  }
  if (what == "binding name") {
    return "expected a name to bind";
  }
  if (what == "statement in braceless body") {
    return "expected a statement";
  }
  if (what == "{ in block") {
    return "expected \"{\" to open a block";
  }
  if (what == "{ in lambda body") {
    return "expected \"{\" to open the lambda body";
  }
  if (what == "{ in branch body") {
    return "expected \"{\" to open the branch body";
  }
  if (what == "field name in struct lit") {
    return "expected a field name in this struct literal";
  }
  if (what == ": in struct lit") {
    return "expected \":\" after the field name in this struct literal";
  }
  if (what == "} in struct lit") {
    return "expected \"}\" to close this struct literal";
  }
  if (what == "} in struct update") {
    return "expected \"}\" to close this struct update";
  }
  if (what == ") in call") {
    return "expected \")\" to close this call";
  }
  if (what == "] in slice") {
    return "expected \"]\" to close this slice";
  }
  if (what == "] in index") {
    return "expected \"]\" to close this index";
  }
  if (what == "] in array literal") {
    return "expected \"]\" to close this array literal";
  }
  if (what == "field name after .") {
    return "expected a field or method name after \".\"";
  }
  return "expected " + what;
}

function decl_sentinel_text(kind: string): string {
  if (util.str_has_prefix(kind, "decl:")) {
    return slice_unchecked(kind, 5, kind.len()) + "";
  }
  if (util.str_has_prefix(kind, "stmt: decl:")) {
    return slice_unchecked(kind, 11, kind.len()) + "";
  }
  return "";
}

struct UnkScan { where: string, errs: util.Diag[] }

function unknown_error_stmt_at(st: ast.Stmt, own a: UnkScan): UnkScan {
  match (st) {
    ast.StmtReturn(_) => {
      return a;
    },
    ast.StmtUnknown(u) => {
      if (u.kind == parser.REPORTED) {
        return a;
      }
      return UnkScan { ...a, errs: a.errs.append(parse_unknown_error(a.where, "stmt: " + u.kind, u.line, u.col)) };
    },
    ast.StmtDefer(_) => {
      return a;
    },
    ast.StmtVar(_) => {
      return a;
    },
    ast.StmtExpr(_) => {
      return a;
    },
    ast.StmtIf(_) => {
      return a;
    },
    ast.StmtWhile(_) => {
      return a;
    },
    ast.StmtAssign(_) => {
      return a;
    },
    ast.StmtMatch(_) => {
      return a;
    },
    ast.StmtFor(_) => {
      return a;
    },
    ast.StmtBreak(_) => {
      return a;
    },
    ast.StmtContinue(_) => {
      return a;
    }
  }
  return a;
}

function unknown_error_expr_at(e: ast.Expr, own a: UnkScan): UnkScan {
  match (e) {
    ast.ExprBytes(_) => {
      return a;
    },
    ast.ExprUnknown(u) => {
      if (u.kind == parser.BARE_RETURN || u.kind == parser.REPORTED) {
        return a;
      }
      return UnkScan { ...a, errs: a.errs.append(parse_unknown_error(a.where, u.kind, u.line, u.col)) };
    },
    ast.ExprIdent(_) => {
      return a;
    },
    ast.ExprNumber(_) => {
      return a;
    },
    ast.ExprString(_) => {
      return a;
    },
    ast.ExprBool(_) => {
      return a;
    },
    ast.ExprBinary(_) => {
      return a;
    },
    ast.ExprUnary(_) => {
      return a;
    },
    ast.ExprCall(_) => {
      return a;
    },
    ast.ExprArray(_) => {
      return a;
    },
    ast.ExprTuple(_) => {
      return a;
    },
    ast.ExprMapLit(_) => {
      return a;
    },
    ast.ExprFString(_) => {
      return a;
    },
    ast.ExprIndex(_) => {
      return a;
    },
    ast.ExprSlice(_) => {
      return a;
    },
    ast.ExprStructLit(_) => {
      return a;
    },
    ast.ExprFieldAccess(_) => {
      return a;
    },
    ast.ExprLambda(_) => {
      return a;
    },
    ast.ExprZero(_) => {
      return a;
    }
  }
  return a;
}

function unknown_errors_stmts(stmts: ast.Stmt[], where: string, errs: util.Diag[]): util.Diag[] {
  let a: UnkScan = UnkScan { where: where, errs: errs };
  for st in stmts {
    a = astwalk.fold_stmt_nodes(st, a, unknown_error_stmt_at, unknown_error_expr_at, astwalk.descend_all);
  }
  return a.errs;
}

function unknown_errors_expr(e: ast.Expr, where: string, errs: util.Diag[]): util.Diag[] {
  let a: UnkScan = UnkScan { where: where, errs: errs };
  a = astwalk.fold_expr_nodes(e, a, unknown_error_stmt_at, unknown_error_expr_at, astwalk.descend_all);
  return a.errs;
}

pub function parse_unknown_errors_module(mod: parser.Module): util.Diag[] {
  let errs: util.Diag[] = [];
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let where: string = "in fn '" + mod.funcs[fi].name + "'";
    if (mod.funcs[fi].name.len() == 0) {
      where = "in malformed function declaration";
    }
    let pi: i32 = 0;
    while (pi < mod.funcs[fi].params.len()) {
      if (mod.funcs[fi].params[pi].has_default) {
        errs = unknown_errors_expr(mod.funcs[fi].params[pi].default_value, where, errs);
      }
      pi = pi + 1;
    }
    errs = unknown_errors_stmts(mod.funcs[fi].body, where, errs);
    fi = fi + 1;
  }
  return unknown_errors_stmts(mod.top_stmts, "at top level", errs);
}

function display_is_dyn(label: string): boolean {
  return label.len() >= 4 && slice_unchecked(label, 0, 4) == "dyn ";
}

function display_named(label: string): boolean {
  if (label.len() == 0) {
    return false;
  }
  let i: i32 = 0;
  while (i < label.len()) {
    if (!lexer.is_alphanumeric(label[i] as i32)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function display_arg_errs(e: ast.Expr, fname: string, st: EmitState): util.Diag[] {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          if ((id.name == "print" || id.name == "write" || id.name == "eprint")
            && c.args.len() == 1) {
            let an: string = util.demangle(ast.expr_ty(c.args[0]));
            if (an == "string" || display_is_dyn(an)) {
              return [];
            }
            if (an.len() == 0) {
              let at: Ty = infer_expr_type(c.args[0], st);
              if (ty_is_unknown(at) || ty_is_string(at)) {
                return [];
              }
              an = util.demangle(ty_friendly(at));
            }
            let tn: string = an;
            if (!display_named(an)) {
              tn = "";
            }
            return [util.Diag {
              length: 0,
              related: [],
              code: "E038", message: "in fn '" + fname + "': argument 1 to \""
                + id.name + "\": " + an
                + " does not implement `Display` (no `to_string(): string` in scope)"
                + " — give " + an + " a `to_string(): string` method, or "
                + util.derive_hint(tn, "cmp.Display", "cmp.Display"),
              line: id.line, col: id.col,
              fix: None,
            }];
          }
          return [];
        },
        _ => {
          return [];
        }
      }
    },
    _ => {
      return [];
    }
  }
  return [];
}

pub function display_errs_module(mod: parser.Module, s: EmitState): util.Diag[] {
  let out: util.Diag[] = [];
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let fd: parser.FuncDecl = mod.funcs[fi];
    let ctx: DisplayCtx = DisplayCtx { st: s, fname: fd.name, diags: [] };
    let si: i32 = 0;
    while (si < fd.body.len()) {
      ctx = astwalk.fold_stmt(fd.body[si], ctx, display_fold);
      si = si + 1;
    }
    out = util.append_diags(out, ctx.diags);
    fi = fi + 1;
  }
  let tctx: DisplayCtx = DisplayCtx { st: s, fname: "main", diags: [] };
  let ti: i32 = 0;
  while (ti < mod.top_stmts.len()) {
    tctx = astwalk.fold_stmt(mod.top_stmts[ti], tctx, display_fold);
    ti = ti + 1;
  }
  return util.append_diags(out, tctx.diags);
}

struct DisplayCtx { st: EmitState, fname: string, diags: util.Diag[] }

function display_fold(e: ast.Expr, own acc: DisplayCtx): DisplayCtx {
  let errs: util.Diag[] = display_arg_errs(e, acc.fname, acc.st);
  if (errs.len() == 0) {
    return acc;
  }
  return DisplayCtx { st: acc.st, fname: acc.fname, diags: util.append_diags(acc.diags, errs) };
}

pub function check_stmt(st: ast.Stmt, want: Ty, fname: string, ctx: CheckCtx): CheckCtx {
  match (st) {
    ast.StmtExpr(ex) => {
      return CheckCtx { st: ctx.st, diags: util.append_diags(ctx.diags, display_arg_errs(ex.value, fname, ctx.st)) };
    },
    ast.StmtReturn(r) => {
      let got: Ty = infer_expr_type(r.value, ctx.st);
      if (!assignable(want, got)) {
        return CheckCtx {
          st: ctx.st,
          diags: ctx.diags.append(util.Diag {
            length: 0,
            related: [],
            code: "E002", message: "in fn '" + fname
              + "': return value: expected " + ty_friendly(want)
              + ", got " + ty_friendly(got),
            line: r.line, col: r.col,
            fix: None,
          }),
        };
      }
      return ctx;
    },
    ast.StmtVar(v) => {
      if (v.name.len() >= 2 && slice_unchecked(v.name, 0, 2) == "__") {
        return CheckCtx { st: ctx.st.bind_local_typed(v.name, ty_unknown()), diags: ctx.diags };
      }
      let got: Ty = infer_expr_type(v.init, ctx.st);
      let bind_ty: Ty = got;
      if (v.type_name.len() > 0) {
        let declared: Ty = ty_from_name(v.type_name);
        bind_ty = struct_local_tag(v.type_name, ctx.st);
        if (!assignable(declared, got)) {
          ctx = CheckCtx {
            st: ctx.st,
            diags: ctx.diags.append(util.Diag {
              length: 0,
              related: [],
              code: "E003", message: "in fn '" + fname
                + "': variable \"" + v.name + "\": expected "
                + ty_friendly(declared) + ", got "
                + ty_friendly(got),
              line: v.line, col: v.col,
              fix: None,
            }),
          };
        }
      }
      return CheckCtx { st: ctx.st.bind_local_typed(v.name, bind_ty), diags: ctx.diags };
    },
    ast.StmtAssign(a) => {
      let got: Ty = infer_expr_type(a.value, ctx.st);
      let tt: Ty = ctx.st.local_type_of(a.target);
      if (!assignable(tt, got)) {
        return CheckCtx {
          st: ctx.st,
          diags: ctx.diags.append(util.Diag {
            length: 0,
            related: [],
            code: "E003", message: "in fn '" + fname
              + "': variable \"" + a.target + "\": expected "
              + ty_friendly(tt) + ", got "
              + ty_friendly(got),
            line: a.line, col: a.col,
            fix: None,
          }),
        };
      }
      return ctx;
    },
    ast.StmtIf(f) => {
      ctx = check_stmts(f.then_body, want, fname, ctx);
      return check_stmts(f.else_body, want, fname, ctx);
    },
    ast.StmtWhile(w) => {
      return check_stmts(w.body, want, fname, ctx);
    },
    ast.StmtFor(fo) => {
      let it: Ty = infer_expr_type(fo.iter, ctx.st);
      let elem: Ty = ty_unknown();
      if (ty_is_array_i32(it)) {
        elem = ty_i32();
      }
      if (ty_is_array_u32(it)) {
        elem = ty_u32();
      }
      if (ty_is_array_u64(it)) {
        elem = ty_u64();
      }
      if (ty_is_array_i64(it)) {
        elem = ty_i64();
      }
      if (ty_is_array_string(it)) {
        elem = ty_string();
      }
      ctx = CheckCtx { st: ctx.st.bind_local_typed(fo.var_name, elem), diags: ctx.diags };
      return check_stmts(fo.body, want, fname, ctx);
    },
    ast.StmtMatch(m) => {
      let ai: i32 = 0;
      while (ai < m.arms.len()) {
        let actx: CheckCtx = ctx;
        match (m.arms[ai].pattern) {
          ast.PatVariant(pv) => {
            if ((pv.type_name == "Some" || pv.type_name == "Ok")
              && pv.binding.len() > 0) {
              actx = CheckCtx {
                st: ctx.st.bind_local_typed(
                  pv.binding,
                  match_payload_type(m.scrutinee, ctx.st),
                ),
                diags: ctx.diags,
              };
            } else {
              actx = CheckCtx { st: bind_variant_payloads(pv, ctx.st), diags: ctx.diags };
            }
          },
          ast.PatWildcard(_) => {}
        }
        actx = check_stmts(m.arms[ai].body, want, fname, actx);
        ctx = CheckCtx { st: ctx.st, diags: actx.diags };
        ai = ai + 1;
      }
      return ctx;
    },
    _ => {
      return ctx;
    }
  }
  return ctx;
}

function bind_variant_payloads(pv: ast.PatVariant, st: EmitState): EmitState {
  let name: string = pv.type_name;
  let owner: string = "";
  let dot: i32 = util.index_of_sub(name, ".");
  if (dot >= 0) {
    owner = slice_unchecked(name, 0, dot) + "";
    name = slice_unchecked(name, dot + 1, name.len()) + "";
  }
  let di: i32 = 0 - 1;
  if (owner.len() > 0) {
    di = irtables.variant_decl_index(st.struct_decls, name, owner);
  } else {
    di = irtables.stab_first(st.struct_decls, name);
    if (di >= 0 && irtables.stab_next(st.struct_decls, di, name) >= 0) {
      di = 0 - 1;
    }
  }
  let names: string[] = [];
  if (pv.binding.len() > 0 && pv.binding != "_") {
    names = names.append(pv.binding);
  }
  for extra in pv.extra_bindings {
    if (extra.len() > 0 && extra != "_") {
      names = names.append(extra);
    }
  }
  let out: EmitState = st;
  if (di < 0 || st.struct_decls.decls[di].enum_owner.len() == 0) {
    for nm in names {
      out = out.bind_local_typed(nm, ty_unknown());
    }
    return out;
  }
  let sd: parser.StructDecl = st.struct_decls.decls[di];
  let payloaded: boolean = sd.fields.len() > 0 && sd.fields[0].name == "__ev";
  if (!payloaded) {
    for nm in names {
      out = out.bind_local_typed(nm, struct_local_tag(sd.name, st));
    }
    return out;
  }
  let k: i32 = 0;
  while (k < names.len()) {
    if (names.len() == sd.fields.len()) {
      out = out.bind_local_typed(names[k], struct_local_tag(sd.fields[k].type_name, st));
    } else {
      out = out.bind_local_typed(names[k], ty_unknown());
    }
    k = k + 1;
  }
  return out;
}

pub function check_stmts(stmts: ast.Stmt[], want: Ty, fname: string, ctx: CheckCtx): CheckCtx {
  let i: i32 = 0;
  while (i < stmts.len()) {
    ctx = check_stmt(stmts[i], want, fname, ctx);
    i = i + 1;
  }
  return ctx;
}

pub function check_func(fd: parser.FuncDecl, s: EmitState): util.Diag[] {
  let want: Ty = ty_from_name(fd.ret_type);
  let s2: EmitState = s.reset_locals();
  if (fd.receiver_type.len() > 0) {
    s2 = s2.bind_local_typed(fd.receiver_name, struct_local_tag(fd.receiver_type, s2));
  }
  let pi: i32 = 0;
  while (pi < fd.params.len()) {
    s2 = s2.bind_local_typed(fd.params[pi].name, struct_local_tag(fd.params[pi].type_name, s2));
    pi = pi + 1;
  }
  let ctx: CheckCtx = CheckCtx { st: s2, diags: [] };
  ctx = check_stmts(fd.body, want, fd.name, ctx);
  return ctx.diags;
}

pub function entry_check_errors(tm: parser.Module): util.Diag[] {
  if (envflag.on("FERN_ENTRY_CHECK_TRACE")) {
    eprint("entry check\n");
  }
  let s: EmitState = new_state();
  s = with_funcs(EmitState { ...s, struct_decls: irtables.struct_tab(tm.structs) }, tm.funcs);
  let errs: util.Diag[] = check_module(tm, s);
  s.release();
  return errs;
}

pub function check_module(mod: parser.Module, s: EmitState): util.Diag[] {
  let errs: util.Diag[] = parse_unknown_errors_module(mod);
  if (errs.len() > 0) {
    return errs;
  }
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    errs = util.append_diags(errs, check_func(mod.funcs[fi], s));
    fi = fi + 1;
  }
  errs = util.append_diags(errs, check_map_new_chain(mod));
  errs = util.append_diags(errs, check_undefined_calls(mod));
  return errs;
}

function map_chain_root_ctor(e: ast.Expr): string {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          if (cid.name == "map_new" || cid.name == "__map_new_i32") {
            return cid.name;
          }
          return "";
        },
        ast.ExprFieldAccess(fa) => {
          if (fa.field == "insert" || fa.field == "get" || fa.field == "get_or"
            || fa.field == "contains" || fa.field == "remove") {
            return map_chain_root_ctor(fa.obj);
          }
          return "";
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
}

function map_chain_check_expr(e: ast.Expr, fname: string, errs: util.Diag[]): util.Diag[] {
  let out: util.Diag[] = errs;
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if ((fa.field == "insert" || fa.field == "get" || fa.field == "get_or"
            || fa.field == "contains" || fa.field == "remove") && c.args.len() > 0) {
            let mroot: string = map_chain_root_ctor(fa.obj);
            if (mroot.len() > 0) {
              let mism: boolean = false;
              match (c.args[0]) {
                ast.ExprNumber(_) => {
                  if (mroot == "map_new") {
                    mism = true;
                  }
                },
                ast.ExprString(_) => {
                  if (mroot == "__map_new_i32") {
                    mism = true;
                  }
                },
                _ => {}
              }
              if (mism) {
                out = out.append(util.Diag {
                  length: 0,
                  related: [],
                  code: "E038", message: "in fn '" + fname
                    + "': '" + fa.field + "' key does not match the key kind of the"
                    + " unannotated " + mroot + "() chain it is called on — the"
                    + " ctor's key/value types are not inferable through a method"
                    + " chain; bind it first (let m: Map[K, V] = " + mroot + "(n))",
                  line: 0, col: 0,
                  fix: None,
                });
              }
            }
          }
          out = map_chain_check_expr(fa.obj, fname, out);
        },
        _ => {
          out = map_chain_check_expr(c.callee, fname, out);
        }
      }
      let i: i32 = 0;
      while (i < c.args.len()) {
        out = map_chain_check_expr(c.args[i], fname, out);
        i = i + 1;
      }
      return out;
    },
    ast.ExprBinary(b) => {
      return map_chain_check_expr(b.right, fname, map_chain_check_expr(b.left, fname, out));
    },
    ast.ExprUnary(u) => {
      return map_chain_check_expr(u.operand, fname, out);
    },
    ast.ExprIndex(ix) => {
      return map_chain_check_expr(ix.index, fname, map_chain_check_expr(ix.array, fname, out));
    },
    ast.ExprSlice(sl) => {
      return map_chain_check_expr(sl.end, fname, map_chain_check_expr(sl.start, fname, map_chain_check_expr(sl.array, fname, out)));
    },
    ast.ExprFieldAccess(fa2) => {
      return map_chain_check_expr(fa2.obj, fname, out);
    },
    ast.ExprStructLit(sl2) => {
      if (sl2.has_base) {
        out = map_chain_check_expr(sl2.base, fname, out);
      }
      let i: i32 = 0;
      while (i < sl2.field_values.len()) {
        out = map_chain_check_expr(sl2.field_values[i], fname, out);
        i = i + 1;
      }
      return out;
    },
    ast.ExprArray(a) => {
      let i: i32 = 0;
      while (i < a.elements.len()) {
        out = map_chain_check_expr(a.elements[i], fname, out);
        i = i + 1;
      }
      return out;
    },
    ast.ExprTuple(t) => {
      let i: i32 = 0;
      while (i < t.elements.len()) {
        out = map_chain_check_expr(t.elements[i], fname, out);
        i = i + 1;
      }
      return out;
    },
    _ => {
      return out;
    }
  }
}

function map_chain_check_stmts(stmts: ast.Stmt[], fname: string, errs: util.Diag[]): util.Diag[] {
  let out: util.Diag[] = errs;
  let i: i32 = 0;
  while (i < stmts.len()) {
    match (stmts[i]) {
      ast.StmtVar(v) => {
        out = map_chain_check_expr(v.init, fname, out);
      },
      ast.StmtAssign(a) => {
        out = map_chain_check_expr(a.value, fname, out);
      },
      ast.StmtExpr(ex) => {
        out = map_chain_check_expr(ex.value, fname, out);
      },
      ast.StmtReturn(r) => {
        out = map_chain_check_expr(r.value, fname, out);
      },
      ast.StmtIf(iff) => {
        out = map_chain_check_expr(iff.cond, fname, out);
        out = map_chain_check_stmts(iff.then_body, fname, out);
        out = map_chain_check_stmts(iff.else_body, fname, out);
      },
      ast.StmtWhile(w) => {
        out = map_chain_check_expr(w.cond, fname, out);
        out = map_chain_check_stmts(w.body, fname, out);
      },
      ast.StmtFor(fo) => {
        out = map_chain_check_expr(fo.iter, fname, out);
        out = map_chain_check_stmts(fo.body, fname, out);
      },
      ast.StmtMatch(m) => {
        out = map_chain_check_expr(m.scrutinee, fname, out);
        let ai: i32 = 0;
        while (ai < m.arms.len()) {
          if (m.arms[ai].has_guard) {
            out = map_chain_check_expr(m.arms[ai].guard, fname, out);
          }
          out = map_chain_check_stmts(m.arms[ai].body, fname, out);
          ai = ai + 1;
        }
      },
      ast.StmtDefer(d) => {
        out = map_chain_check_stmts([d.action], fname, out);
      },
      _ => {}
    }
    i = i + 1;
  }
  return out;
}

pub function check_map_new_chain(mod: parser.Module): util.Diag[] {
  let errs: util.Diag[] = [];
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    errs = map_chain_check_stmts(mod.funcs[fi].body, mod.funcs[fi].name, errs);
    fi = fi + 1;
  }
  return errs;
}

struct CallGate { names: string[], names_ix: util.NameIndex, argc: i32[], known: string[], check_arity: boolean, check_undef: boolean }

function callgate_name_in(names: string[], name: string): boolean {
  let i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function emitter_call_names(): string[] {
  return [
    "str_repeat", "str_replace", "str_split", "str_trim",
    "str_to_lower", "str_to_upper",
    "i32_to_string", "int__int_to_string", "print_str",
  ];
}

function callgate_known_names(mod: parser.Module): string[] {
  let out: string[] = parser.builtin_function_names();
  let ei: i32 = 0;
  let extra: string[] = emitter_call_names();
  while (ei < extra.len()) {
    out = out.append(extra[ei]);
    ei = ei + 1;
  }
  out = out.append("Some");
  out = out.append("None");
  out = out.append("Ok");
  out = out.append("Err");
  let sd: parser.StructDecl[] = parser.inject_builtin_enums(mod.structs);
  let si: i32 = 0;
  while (si < sd.len()) {
    out = out.append(sd[si].name);
    si = si + 1;
  }
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    if (mod.funcs[fi].receiver_type.len() > 0) {
      out = out.append(mod.funcs[fi].name);
    }
    fi = fi + 1;
  }
  out = astwalk.collect_bound_stmts(mod.top_stmts, out);
  return out;
}

function callgate_module_ns(name: string, names: string[], known: string[]): string {
  let i: i32 = 1;
  while (i + 1 < name.len()) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      let ns: string = slice_unchecked(name, 0, i) + "";
      let pfx: string = ns + "__";
      if (callgate_ns_present(pfx, names) || callgate_ns_present(pfx, known)) {
        return "";
      }
      return ns;
    }
    i = i + 1;
  }
  return "";
}

function callgate_ns_present(pfx: string, names: string[]): boolean {
  let i: i32 = 0;
  while (i < names.len()) {
    let nm: string = names[i];
    if (nm.len() > pfx.len() && util.str_has_prefix(nm, pfx)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function callgate_undefined_error(g: CallGate, where: string, name: string, line: i32, col: i32): util.Diag {
  let out: string = where + ": cannot find \"" + name + "\" in this scope";
  let ns: string = callgate_module_ns(name, g.names, g.known);
  if (ns.len() > 0) {
    out = out + " — no module '" + ns + "' was loaded (a std/ or core/ import is"
      + " skipped when no stdlib was given, so every call into it dangles)";
  }
  return util.Diag { related: [], length: 0, code: "E001", message: out, line: line, col: col, fix: None };
}

function callgate_expr(e: ast.Expr, g: CallGate, where: string, bound: string[], errs: util.Diag[]): util.Diag[] {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          if (!callgate_name_in(bound, id.name)) {
            let ti: i32 = g.names_ix.find(id.name);
            let found: boolean = ti >= 0;
            if (found && g.check_arity && c.args.len() != g.argc[ti]) {
              errs = errs.append(util.Diag {
                length: 0,
                related: [],
                code: "E004", message: util.arity_message("function \"" + id.name + "\"", g.argc[ti], c.args.len(), "argument"),
                line: id.line, col: id.col,
                fix: None,
              });
            }
            if (g.check_undef && !found && !callgate_known_callee(id.name, g.known)) {
              errs = errs.append(callgate_undefined_error(g, where, id.name, id.line, id.col));
            }
          }
        },
        _ => {
          errs = callgate_expr(c.callee, g, where, bound, errs);
        }
      }
      let i: i32 = 0;
      while (i < c.args.len()) {
        errs = callgate_expr(c.args[i], g, where, bound, errs);
        i = i + 1;
      }
      return errs;
    },
    ast.ExprBinary(b) => {
      errs = callgate_expr(b.left, g, where, bound, errs);
      return callgate_expr(b.right, g, where, bound, errs);
    },
    ast.ExprUnary(u) => {
      return callgate_expr(u.operand, g, where, bound, errs);
    },
    ast.ExprIndex(x) => {
      errs = callgate_expr(x.array, g, where, bound, errs);
      return callgate_expr(x.index, g, where, bound, errs);
    },
    ast.ExprSlice(sl) => {
      errs = callgate_expr(sl.array, g, where, bound, errs);
      errs = callgate_expr(sl.start, g, where, bound, errs);
      return callgate_expr(sl.end, g, where, bound, errs);
    },
    ast.ExprArray(a) => {
      let i: i32 = 0;
      while (i < a.elements.len()) {
        errs = callgate_expr(a.elements[i], g, where, bound, errs);
        i = i + 1;
      }
      return errs;
    },
    ast.ExprTuple(t) => {
      let i: i32 = 0;
      while (i < t.elements.len()) {
        errs = callgate_expr(t.elements[i], g, where, bound, errs);
        i = i + 1;
      }
      return errs;
    },
    ast.ExprStructLit(sl) => {
      let i: i32 = 0;
      while (i < sl.field_values.len()) {
        errs = callgate_expr(sl.field_values[i], g, where, bound, errs);
        i = i + 1;
      }
      if (sl.has_base) {
        errs = callgate_expr(sl.base, g, where, bound, errs);
      }
      return errs;
    },
    ast.ExprFieldAccess(fa) => {
      return callgate_expr(fa.obj, g, where, bound, errs);
    },
    ast.ExprLambda(lm) => {
      let lb: string[] = bound;
      let pi: i32 = 0;
      while (pi < lm.params.len()) {
        lb = lb.append(lm.params[pi].name);
        pi = pi + 1;
      }
      lb = astwalk.collect_bound_stmts(lm.body, lb);
      return callgate_stmts(lm.body, g, where, lb, errs);
    },
    _ => {
      return errs;
    }
  }
  return errs;
}

function callgate_known_callee(name: string, known: string[]): boolean {
  if (name.len() == 0) {
    return true;
  }
  if (name.len() >= 2 && slice_unchecked(name, 0, 2) == "__") {
    return true;
  }
  return callgate_name_in(known, name);
}

function callgate_stmts(stmts: ast.Stmt[], g: CallGate, where: string, bound: string[], errs: util.Diag[]): util.Diag[] {
  let i: i32 = 0;
  while (i < stmts.len()) {
    match (stmts[i]) {
      ast.StmtVar(v) => {
        errs = callgate_expr(v.init, g, where, bound, errs);
      },
      ast.StmtReturn(r) => {
        errs = callgate_expr(r.value, g, where, bound, errs);
      },
      ast.StmtExpr(x) => {
        errs = callgate_expr(x.value, g, where, bound, errs);
      },
      ast.StmtAssign(a) => {
        errs = callgate_expr(a.value, g, where, bound, errs);
      },
      ast.StmtIf(f) => {
        errs = callgate_expr(f.cond, g, where, bound, errs);
        errs = callgate_stmts(f.then_body, g, where, bound, errs);
        errs = callgate_stmts(f.else_body, g, where, bound, errs);
      },
      ast.StmtWhile(w) => {
        errs = callgate_expr(w.cond, g, where, bound, errs);
        errs = callgate_stmts(w.body, g, where, bound, errs);
      },
      ast.StmtFor(fo) => {
        errs = callgate_expr(fo.iter, g, where, bound, errs);
        errs = callgate_stmts(fo.body, g, where, bound, errs);
      },
      ast.StmtMatch(m) => {
        errs = callgate_expr(m.scrutinee, g, where, bound, errs);
        let ai: i32 = 0;
        while (ai < m.arms.len()) {
          if (m.arms[ai].has_guard) {
            errs = callgate_expr(m.arms[ai].guard, g, where, bound, errs);
          }
          errs = callgate_stmts(m.arms[ai].body, g, where, bound, errs);
          ai = ai + 1;
        }
      },
      ast.StmtDefer(d) => {
        errs = callgate_stmts([d.action], g, where, bound, errs);
      },
      _ => {}
    }
    i = i + 1;
  }
  return errs;
}

function callgate_free_names(mod: parser.Module): string[] {
  let names: string[] = [];
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    if (mod.funcs[fi].receiver_type.len() == 0) {
      names = names.append(mod.funcs[fi].name);
    }
    fi = fi + 1;
  }
  return names;
}

function callgate_free_argc(mod: parser.Module): i32[] {
  let argc: i32[] = [];
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    if (mod.funcs[fi].receiver_type.len() == 0) {
      argc = argc.append(mod.funcs[fi].params.len());
    }
    fi = fi + 1;
  }
  return argc;
}

function callgate_run(mod: parser.Module, g: CallGate): util.Diag[] {
  let errs: util.Diag[] = [];
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let fd: parser.FuncDecl = mod.funcs[fi];
    let bound: string[] = [];
    if (fd.receiver_type.len() > 0) {
      bound = bound.append(fd.receiver_name);
    }
    let pi: i32 = 0;
    while (pi < fd.params.len()) {
      bound = bound.append(fd.params[pi].name);
      pi = pi + 1;
    }
    bound = astwalk.collect_bound_stmts(fd.body, bound);
    errs = callgate_stmts(fd.body, g, "in fn '" + fd.name + "'", bound, errs);
    fi = fi + 1;
  }
  if (g.check_undef) {
    let tb: string[] = astwalk.collect_bound_stmts(mod.top_stmts, []);
    errs = callgate_stmts(mod.top_stmts, g, "at top level", tb, errs);
  }
  return errs;
}

pub function check_call_arity(mod: parser.Module): util.Diag[] {
  let names: string[] = callgate_free_names(mod);
  return callgate_run(mod, CallGate {
    names: names, names_ix: util.name_index(names), argc: callgate_free_argc(mod), known: [],
    check_arity: true, check_undef: false,
  });
}

pub function check_decl_names(mod: parser.Module): util.Diag[] {
  let errs: util.Diag[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    if (mod.funcs[i].name.len() == 0 && mod.funcs[i].is_const) {
      errs = errs.append(util.Diag {
        length: 0,
        related: [],
        code: "P001", message: malformed_type_decl_message("const"),
        line: mod.funcs[i].line, col: mod.funcs[i].col,
        fix: None,
      });
    } else if (mod.funcs[i].name.len() == 0) {
      errs = errs.append(util.Diag {
        length: 0,
        related: [],
        code: "P001",
        message: parser.malformed_fn_decl_message(),
        line: mod.funcs[i].line, col: mod.funcs[i].col,
        fix: None,
      });
    }
    i = i + 1;
  }
  for td in mod.trait_decls {
    if (td.name.len() == 0) {
      errs = errs.append(util.Diag { related: [], length: 0, code: "P001", message: malformed_type_decl_message("trait"), line: td.line, col: td.col, fix: None });
    }
    for tm in td.methods {
      if (tm.name.len() == 0) {
        errs = errs.append(util.Diag { related: [], length: 0, code: "P001", message: parser.malformed_fn_decl_message(), line: tm.line, col: tm.col, fix: None });
      }
    }
  }
  let si: i32 = 0;
  while (si < mod.structs.len()) {
    if (mod.structs[si].name.len() == 0) {
      errs = errs.append(util.Diag {
        length: 0,
        related: [],
        code: "P001", message: malformed_type_decl_message("struct"),
        line: mod.structs[si].line, col: mod.structs[si].col,
        fix: None,
      });
    }
    si = si + 1;
  }
  for en in mod.enums {
    if (en.name.len() == 0) {
      errs = errs.append(util.Diag { related: [], length: 0, code: "P001", message: malformed_type_decl_message("enum"), line: en.line, col: en.col, fix: None });
    }
  }
  for al in mod.aliases {
    if (al.name.len() == 0) {
      errs = errs.append(util.Diag { related: [], length: 0, code: "P001", message: malformed_type_decl_message("type alias"), line: al.line, col: al.col, fix: None });
    }
  }
  return errs;
}

pub function parse_errors(mod: parser.Module): util.Diag[] {
  let errs: util.Diag[] = util.append_diags(parse_unknown_errors_module(mod), check_decl_names(mod));
  errs = util.append_diags(errs, check_top_level_stmts(mod));
  let ordered: util.Diag[] = [];
  for d in errs {
    ordered = insert_by_position(ordered, d);
  }
  return ordered;
}

pub function parse_errors_before_check(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for d in parse_errors(mod) {
    if (d.code != "E061") {
      out = out.append(d);
    }
  }
  return out;
}

function insert_by_position(ds: util.Diag[], d: util.Diag): util.Diag[] {
  let out: util.Diag[] = [];
  let placed: boolean = false;
  for e in ds {
    if (!placed && (d.line < e.line || d.line == e.line && d.col < e.col)) {
      out = out.append(d);
      placed = true;
    }
    out = out.append(e);
  }
  if (!placed) {
    out = out.append(d);
  }
  return out;
}

pub function refuse_parse_errors(mods: parser.Module[]): boolean {
  let errs: util.Diag[] = [];
  for m in mods {
    errs = util.append_diags(errs, parse_errors(m));
  }
  if (errs.len() == 0) {
    return false;
  }
  eprint(util.format_diags(errs));
  return true;
}

function malformed_type_decl_message(kw: string): string {
  return "malformed " + kw + " declaration: its name could not be read (a keyword such as `type` or `match` cannot be a name)";
}

pub function check_top_level_stmts(mod: parser.Module): util.Diag[] {
  let errs: util.Diag[] = [];
  if (mod.top_stmts.len() == 0) {
    return errs;
  }
  let has_main: boolean = false;
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    if (mod.funcs[fi].receiver_type.len() == 0 && mod.funcs[fi].name == "main") {
      has_main = true;
    }
    fi = fi + 1;
  }
  if (!has_main) {
    return errs;
  }
  for st in mod.top_stmts {
    if (!is_parse_sentinel(st)) {
      errs = errs.append(util.Diag {
        length: 0,
        related: [],
        code: "P001",
        message: "statement at top level: a module declaring `main` runs that, so this never executes — move it inside a function",
        line: ast.stmt_line(st), col: ast.stmt_col(st),
        fix: None,
      });
    }
  }
  return errs;
}

function is_parse_sentinel(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtUnknown(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub function check_undefined_calls(mod: parser.Module): util.Diag[] {
  let names: string[] = callgate_free_names(mod);
  return callgate_run(mod, CallGate {
    names: names, names_ix: util.name_index(names), argc: callgate_free_argc(mod),
    known: callgate_known_names(mod), check_arity: false, check_undef: true,
  });
}

pub function emit_str_box_data_from(s: EmitState, first: i32): EmitState {
  if (s.string_lits.len() <= first) {
    return s;
  }
  let st: EmitState = s.write("    .section .data\n    .align 8\n");
  let i: i32 = first;
  while (i < st.string_lits.len()) {
    st = st.write("    .quad -1\n");
    st = st.write(str_box_label(st, i) + ":\n");
    st = st.write("    .quad " + str_lit_label(st, i) + "\n");
    st = st.write("    .quad " + util.i32_to_string(st.string_lits[i].len()) + "\n");
    i = i + 1;
  }
  return st;
}

pub function const_agg_kind(packed: string): i32 {
  if (packed.len() >= 2 && (packed[0] == b'8' || packed[0] == b'o') && packed[1] == b'|') {
    return 1;
  }
  if (packed.len() >= 2 && packed[0] == b'0' && packed[1] == b'|') {
    return 1;
  }
  if (packed.len() > 2 && packed[0] == b'1' && packed[1] == b'|') {
    return 3;
  }
  return 2;
}

pub function emit_const_agg_data(s: EmitState): EmitState {
  return emit_const_agg_data_from(s, 0);
}

pub function emit_const_agg_data_from(s: EmitState, first: i32): EmitState {
  return emit_const_agg_blocks(s, first, 0);
}

pub function emit_const_agg_blocks(s: EmitState, first: i32, only: i32): EmitState {
  if (s.const_aggs.len() <= first) {
    return s;
  }
  let st: EmitState = s.write("    .section .data\n    .align 8\n");
  let i: i32 = first;
  while (i < st.const_aggs.len()) {
    let e: string = st.const_aggs[i];
    let array: boolean = const_agg_kind(e) == 1;
    if (only != 0 && const_agg_kind(e) != only) {
      i = i + 1;
      continue;
    }
    let bar: i32 = 0;
    while (bar < e.len() && e[bar] != 124) {
      bar = bar + 1;
    }
    let shp: string = slice_unchecked(e, 0, bar) + "";
    if (shp == "8") {
      st = emit_const_bytes_block(st, i, ir.const_struct_payload(e));
      i = i + 1;
      continue;
    }
    let vals: string[] = ir.const_struct_values(e);
    if (shp == "o") {
      st = st.write("    .quad 2\n    .quad -1\n" + const_agg_label(st, i) + ":\n    .quad " + vals[0] + "\n    .quad 0\n");
      i = i + 1;
      continue;
    }
    let cap: i32 = vals.len() + 1;
    if (array) {
      cap = vals.len();
      shp = util.i32_to_string(vals.len());
    }
    st = st.write("    .quad " + util.i32_to_string(cap) + "\n");
    st = st.write("    .quad -1\n");
    st = st.write(const_agg_label(st, i) + ":\n");
    st = st.write("    .quad " + shp + "\n");
    let vi: i32 = 0;
    while (vi < vals.len()) {
      st = emit_const_agg_field(st, i, vi, vals[vi]);
      vi = vi + 1;
    }
    i = i + 1;
  }
  return st;
}

function emit_const_agg_field(st: EmitState, idx: i32, vi: i32, word: string): EmitState {
  if (const_agg_holds_box(word)) {
    st = st.write(const_agg_field_label(st, idx, vi) + ":\n");
  }
  return st.write("    .quad " + word + "\n");
}

function const_agg_holds_box(word: string): boolean {
  return word.len() > 0 && word[0] == b'.';
}

function const_agg_field_label(s: EmitState, idx: i32, vi: i32): string {
  return const_agg_label(s, idx) + "_" + util.i32_to_string(vi);
}

pub function emit_const_agg_refs(s: EmitState): EmitState {
  let i: i32 = 0;
  while (i < s.const_aggs.len()) {
    let e: string = s.const_aggs[i];
    if (const_agg_kind(e) == 2 || ir.const_struct_type(e) == "0") {
      let vals: string[] = ir.const_struct_values(e);
      let vi: i32 = 0;
      while (vi < vals.len()) {
        if (const_agg_holds_box(vals[vi])) {
          s = s.write("    .quad " + const_agg_field_label(s, i, vi) + "\n");
        }
        vi = vi + 1;
      }
    }
    i = i + 1;
  }
  return s;
}

function emit_const_bytes_block(st: EmitState, i: i32, words: string): EmitState {
  let count: i32 = byteconst.count_words(words);
  st = st.write("    .quad 0\n");
  st = st.write("    .quad -1\n");
  st = st.write(const_agg_label(st, i) + ":\n");
  st = st.write("    .quad " + util.i32_to_string(count) + "\n");
  if (count > 0) {
    st = st.write("    .byte " + byteconst.spaced_words(words) + "\n");
  }
  return st.write("    .balign 8\n");
}

pub struct ShapeRefOut { state: EmitState, label: string }

pub struct DynArg { reg: string, off: i32 }

pub function shape_ref(own s: EmitState, name: string): ShapeRefOut {
  if (s.str_ns.len() == 0) {
    let lo: StringLitOut = add_string_lit(s, name);
    return ShapeRefOut { state: lo.state, label: str_lit_label(lo.state, lo.idx) };
  }
  return ShapeRefOut { state: add_shape_lit(s, name), label: shape_sym(name) };
}

pub function intern_shape(own s: EmitState, name: string): EmitState {
  return shape_ref(s, name).state;
}

pub function shape_label(s: EmitState, name: string): string {
  if (s.str_ns.len() == 0) {
    return str_lit_label(s, string_lit_index(s, name));
  }
  return shape_sym(name);
}

pub function export_runtime_fns(s: EmitState, fns: parser.FuncDecl[]): EmitState {
  if (s.str_ns.len() == 0) {
    return s;
  }
  for f in fns {
    let label: string = "__fn_" + sanitize_label(f.name);
    s = s.write(".globl " + label + "\n.globl " + label + ".r\n");
  }
  return s;
}

pub function emit_runtime_globls(s: EmitState): EmitState {
  let names: string[] = [
    "__fern_alloc", "__fern_alloc_u8", "__fern_arr_box", "__fern_str_box", "__fern_arr_push",
    "__fern_capw", "__fern_memcpy",
    "__fern_oob_abort",
    "__fern_str_oob_abort",
    "__fern_alloc_size_abort",
    "__fern_arr_push_owned",
    "__fern_alloc_bytes", "__fern_arr_push_u8", "__fern_arr_push_owned_u8",
    "__fn___fern_str_view_free", "__fern_raw_free", "__fern_map_hash_seed",
    "__fern_buf_new", "__fern_buf_push", "__fern_buf_push_range", "__fern_buf_push_mapped", "__fern_buf_push_bytes_mapped", "__fern_buf_push_bytes_filtered", "__fern_buf_push_filtered", "__fern_buf_push_expanded", "__fern_buf_push_bytes_expanded",
    "__fern_buf_push_byte", "__fern_buf_push_u64", "__fern_buf_len", "__fern_buf_clear", "__fern_buf_take",
    "__fern_buf_free",
    "__fern_buf_take_bytes", "__fern_buf_take_bytes_u8",
    "__fern_buf_push_bytes_range", "__fern_buf_push_bytes_range_u8",
    "__fern_buf_push_bytes_mapped_u8", "__fern_buf_push_bytes_filtered_u8", "__fern_buf_push_bytes_expanded_u8",
    "__fern_args", "__fern_arg_at",
    "__fn___fern_rc_inc", "__fn___fern_arr_dec", "__fn___fern_rc_is_unique", "__fn___fern_arr_inc_elems", "__fn___fern_arr_own_elems",
    "__fn___fern_str_own", "__fn___fern_str_borrow", "__fn___fern_str_grow", "__fn___fern_str_grow_range",
    "__fn___fern_str_grow_fresh", "__fn___fern_str_grow_fresh_range", "__fn___fern_account_entry",
    "__fn___fern_set_args",
    "__fn___fern_alloc_reuse",
    "__fn___fern_rc_underflow_count",
    "__fn___fern_str_eq", "__fn___fern_str_free",
    "__fn___fern_arr_dec.r", "__fn___fern_str_free.r",
    "__fn___fern_arr_dec.u", "__fn___fern_str_free.u",
    "__fn___fern_str_eq.r", "__fn___fern_arr_inc_elems.r", "__fn___fern_alloc_reuse.r",
  ];
  let i: i32 = 0;
  while (i < names.len()) {
    s = s.write(".globl " + names[i] + "\n");
    i = i + 1;
  }
  return s;
}

pub struct DbgVars { at: boolean[], rows: string[] }

pub function dbg_vars(fn_label: string, a: ssa.Alloc, r: irtables.Lowered, repl: i32[], seen_vals: i32[], seen_slots: i32[], locs: string[], npos: i32): DbgVars {
  if (seen_vals.len() == 0) {
    return DbgVars { at: [], rows: [] };
  }
  let d: DbgVars = DbgVars { at: __alloc_bool(npos + 1), rows: [] };
  let i: i32 = 0;
  while (i < r.dbg_slots.len()) {
    d = dbg_var(d, fn_label, a, r, i, repl, seen_vals, seen_slots, locs, npos);
    i = i + 1;
  }
  return d;
}

function dbg_shape_type(s: EmitState, t: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < t.len()) {
    if (t[i] == b'%') {
      let a = __memchr(t, 123, i + 1);
      let b = __memchr(t, 125, a + 1);
      if (a < 0 || b < 0) {
        return t;
      }
      out = out + slice_unchecked(t, i, a + 1) + dbg_enum_members(s, t, a + 1, b) + "}";
      i = b + 1;
    } else {
      out = out + slice_unchecked(t, i, i + 1);
      i = i + 1;
    }
  }
  return out;
}

function dbg_enum_members(s: EmitState, t: string, i: i32, end: i32): string {
  let out: string = "";
  while (i < end) {
    let j = __memchr(t, 44, i);
    if (j < 0 || j > end) {
      j = end;
    }
    let shape = slice_unchecked(t, i, j) + "";
    let label = dbg_shape_label(s, shape);
    if (label != "") {
      if (out != "") {
        out = out + ",";
      }
      let k = shape.len();
      while (k > 0 && shape[k - 1] != b'$') {
        k = k - 1;
      }
      out = out + slice_unchecked(shape, k, shape.len()) + "=" + label;
    }
    i = j + 1;
  }
  return out;
}

function dbg_shape_label(s: EmitState, name: string): string {
  if (s.str_ns == "") {
    let at = string_lit_index(s, name);
    if (at >= 0) {
      return str_lit_label(s, at);
    }
  } else if (util.index_of_str(s.shape_lits, name) >= 0) {
    return shape_sym(name);
  }
  return "";
}

function dbg_var(d: DbgVars, fn_label: string, a: ssa.Alloc, r: irtables.Lowered, i: i32, repl: i32[], seen_vals: i32[], seen_slots: i32[], locs: string[], npos: i32): DbgVars {
  let param: string = "0";
  if (r.dbg_slots[i] < r.n_params) {
    param = "1";
  }
  let done: i32[] = [];
  let j: i32 = 0;
  while (j < seen_slots.len()) {
    let v: i32 = dbg_home(a, repl, locs, npos, seen_vals[j]);
    if (seen_slots[j] == r.dbg_slots[i] && v >= 0 && util.index_of_i32(done, v) < 0) {
      done = done.append(v);
      let lo: i32 = a.def_pos[v] + 1;
      let hi: i32 = a.hi[v] + 1;
      d = DbgVars {
        at: d.at.with(lo, true).with(hi, true),
        rows: d.rows.append(fn_label + "|" + r.dbg_names[i] + "|" + r.dbg_types[i] + "|" + param + "|" + dbg_label_name(fn_label, lo) + "|" + dbg_label_name(fn_label, hi) + "|" + locs[v]),
      };
    }
    j = j + 1;
  }
  return d;
}

function dbg_home(a: ssa.Alloc, repl: i32[], locs: string[], npos: i32, v: i32): i32 {
  if (v >= 0 && v < repl.len()) {
    v = repl[v];
  }
  if (v < 0 || v >= a.def_pos.len() || v >= locs.len() || locs[v] == "") {
    return 0 - 1;
  }
  if (a.def_pos[v] < 0 || a.hi[v] <= a.def_pos[v] || a.hi[v] >= npos) {
    return 0 - 1;
  }
  return v;
}

pub function dbg_label_name(fn_label: string, pos: i32): string {
  return ".Ldbg_" + sanitize_label(fn_label) + "_" + util.i32_to_string(pos);
}

pub function dbg_label(s: EmitState, d: DbgVars, fn_label: string, pos: i32): EmitState {
  if (pos < d.at.len() && d.at[pos]) {
    return s.write(dbg_label_name(fn_label, pos) + ":\n");
  }
  return s;
}

pub function dbg_labels(s: EmitState, d: DbgVars, fn_label: string, lo: i32, hi: i32): EmitState {
  let pos: i32 = lo;
  while (pos < hi) {
    s = dbg_label(s, d, fn_label, pos);
    pos = pos + 1;
  }
  return s;
}

pub function dbg_rows(s: EmitState, d: DbgVars): EmitState {
  if (d.rows.len() == 0) {
    return s;
  }
  let rows = s.debug_rows;
  for row in d.rows {
    rows = rows.append(row);
  }
  return EmitState { ...s, debug_rows: rows };
}

pub function emit_debug_rows(s: EmitState): EmitState {
  if (s.debug_rows.len() == 0) {
    return s;
  }
  let out = EmitState { ...s, debug_rows: [] };
  for row in s.debug_rows {
    out = emit_debug_row(out, row);
  }
  return out;
}

function emit_debug_row(own s: EmitState, row: string): EmitState {
  let a = __memchr(row, 124, 0);
  let b = __memchr(row, 124, a + 1);
  let c = __memchr(row, 124, b + 1);
  let shaped = dbg_shape_type(s, slice_unchecked(row, b + 1, c) + "");
  return s.write("    .fern_var " + slice_unchecked(row, 0, b + 1) + shaped + slice_unchecked(row, c, row.len()) + "\n");
}

pub function dbg_hex(bytes: i32[]): string {
  let digits: string = "0123456789abcdef";
  let out: string = "";
  for b in bytes {
    out = out + slice_unchecked(digits, b >> 4 & 15, (b >> 4 & 15) + 1) + slice_unchecked(digits, b & 15, (b & 15) + 1);
  }
  return out;
}

pub function dbg_sleb(b: i32[], v: i32): i32[] {
  let more: boolean = true;
  while (more) {
    let byte: i32 = v & 127;
    v = v >> 7;
    if (v == 0 && (byte & 64) == 0 || v == 0 - 1 && (byte & 64) != 0) {
      more = false;
    } else {
      byte = byte | 128;
    }
    b = b.append(byte);
  }
  return b;
}

pub function sha256_k(): u32[] {
  return [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
  ];
}

pub function runtime_dir_roots(s: EmitState): string {
  let out: string = "";
  if (s.has_need("open_dir")) {
    out = out + " " + "__fern_open_dir";
  }
  if (s.has_need("dir_open")) {
    out = out + " " + "__fern_dir_open";
  }
  if (s.has_need("dir_entries")) {
    out = out + " " + "__fern_dir_entries";
  }
  if (s.has_need("dir_entries_bytes")) {
    out = out + " " + "__fern_dir_entries_bytes";
  }
  if (s.has_need("dir_stat")) {
    out = out + " " + "__fern_dir_stat";
  }
  if (s.has_need("dir_access")) {
    out = out + " " + "__fern_dir_access";
  }
  if (s.has_need("dir_unlink")) {
    out = out + " " + "__fern_dir_unlink";
  }
  if (s.has_need("dir_chmod")) {
    out = out + " " + "__fern_dir_chmod";
  }
  if (s.has_need("dir_chown")) {
    out = out + " " + "__fern_dir_chown";
  }
  return out;
}

pub function runtime_sync_roots(s: EmitState): string {
  let out: string = "";
  if (s.has_need("fd_fsync")) {
    out = out + " " + "__fern_fd_fsync";
  }
  if (s.has_need("fd_fdatasync")) {
    out = out + " " + "__fern_fd_fdatasync";
  }
  if (s.has_need("fd_syncfs")) {
    out = out + " " + "__fern_fd_syncfs";
  }
  if (s.has_need("fd_drop_cache")) {
    out = out + " " + "__fern_fd_drop_cache";
  }
  if (s.has_need("sync")) {
    out = out + " " + "__fern_sync";
  }
  return out;
}
