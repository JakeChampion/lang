function dirent_name_len(t: string): string {
  if (t == "arm64-darwin") {
    return "let nlen: i32 = __raw_load8(buf, pos + 18) + __raw_load8(buf, pos + 19) * 256; ";
  }
  let nameoff: string = direntoff(t, "name");
  return "let nlen: i32 = 0; let room: i32 = reclen - " + nameoff + "; let scan: i32 = 1; while (scan == 1 && nlen + 8 <= room) { let w: i64 = __load_i64(buf + pos + " + nameoff + " + nlen); let z: i64 = (w - (72340172838076673 as i64)) & (w ^ (0 - 1) as i64) & ((0 - 9187201950435737472) as i64); if (z != (0 as i64)) { nlen = nlen + (__ctz64(z as u64) >> 3); scan = 0; } else { nlen = nlen + 8; } } if (scan == 1) { while (__raw_load8(buf, pos + " + nameoff + " + nlen) != 0) { nlen = nlen + 1; } } ";
}

pub function rt_src_random_bytes(t: string): string {
  return "function __fern_random_bytes(n: i32): i32[] { if (n <= 0) { let none: usize = __raw_arr_box(0); return __raw_array(none); } let p: usize = __raw_alloc(n); let off: i32 = 0; while (off < n) { let want: i32 = n - off; if (want > 256) { want = 256; } let r: i32 = __syscall3(" + sysno(t, "getrandom") + ", (p + off) as i64, want as i64, 0) as i32; if (r < 0) { off = n; } else { off = off + want; } } let b: usize = __raw_arr_box(n); let i: i32 = 0; while (i < n) { __raw_store_ptr(b, i + 1, __raw_load8(p, i) as usize); i = i + 1; } let p_own: string = __raw_string(p, n); return __raw_array(b); }";
}

pub function rt_src_random_i32(t: string): string {
  return "function __fern_random_i32(): i32 { let p: usize = __raw_scratch(4); __syscall3(" + sysno(t, "getrandom") + ", p as i64, 4, 0); return __load_i32(p); }";
}

pub function rt_src_open_res(t: string): string {
  let xlate: string = "";
  if (t == "arm64-darwin") {
    xlate = "if (f == " + oflag("x86-64-linux", "wr_creat_trunc") + ") { f = " + oflag(t, "wr_creat_trunc") + "; } "
      + "if (f == " + oflag("x86-64-linux", "wr_creat_append") + ") { f = " + oflag(t, "wr_creat_append") + "; } "
      + "if (f == " + oflag("x86-64-linux", "wr_creat_excl") + ") { f = " + oflag(t, "wr_creat_excl") + "; } ";
  }
  return "function __fern_open_res(path: string, flags: i32, mode: i32): Result[i32, IoError] { let plen: i32 = path.len(); let pathz: usize = __raw_alloc(plen + 1); let i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i] as i32); i = i + 1; } __raw_store8(pathz, plen, 0); let f: i32 = flags; " + xlate + "let pathz_own: string = __raw_string(pathz, plen + 1); " + slash_write_refusal(t, " && (f & " + oflag(t, "slash_write") + ") != 0") + "let fd: i32 = __syscall4(" + sysno(t, "openat") + ", " + at_fdcwd(t) + ", pathz as i64, f as i64, mode as i64) as i32; if (fd >= 0 && fd < 3) { let moved: i32 = __syscall3(" + sysno(t, "fcntl") + ", fd as i64, 0, 3) as i32; __syscall3(" + sysno(t, "close") + ", fd as i64, 0, 0); fd = moved; } if (fd < 0) { return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen))); } " + slash_dir_check(t) + "return Ok(fd); }";
}

function slash_write_refusal(t: string, cond: string): string {
  if (t != "arm64-darwin") {
    return "";
  }
  return "if (plen > 0 && path[plen - 1] == 47" + cond + ") { return Err(__fern_io_error(21, __fern_path_copy(pathz_own, plen))); } ";
}

function slash_dir_check(t: string): string {
  if (t != "arm64-darwin") {
    return "";
  }
  return "if (plen > 0 && path[plen - 1] == 47) { let gst: usize = __raw_scratch(160); let gr: i32 = __syscall3(" + sysno(t, "fstat") + ", fd as i64, gst as i64, 0) as i32; if (gr < 0 || (__raw_load8(gst, " + statoff(t, "mode") + " + 1) & 240) != 64) { __syscall3(" + sysno(t, "close") + ", fd as i64, 0, 0); return Err(__fern_io_error(20, __fern_path_copy(pathz_own, plen))); } } ";
}

pub function rt_src_open_with(t: string): string {
  let names: string[] = ["creat", "nonblock", "excl", "direct", "directory", "dsync", "sync", "noatime", "noctty", "nofollow"];
  let refused: i32 = 0;
  let ors: string = "";
  let i: i32 = 0;
  while (i < names.len()) {
    let word: string = oflag(t, names[i]);
    if (word == "0") {
      refused = refused | 1 << i;
    } else {
      ors = ors + " if ((flags & " + util.i32_to_string(1 << i) + ") != 0) { f = f | " + word + "; }";
    }
    i = i + 1;
  }
  let head: string = "function __fern_open_with(path: string, flags: i32, write: i32): Result[i32, IoError] {";
  if (refused != 0) {
    head = head + " if ((flags & " + util.i32_to_string(refused) + ") != 0) { return Err(Unsupported); }";
  }
  return head + " let f: i32 = 0; if (write != 0) { f = 1; }" + ors + " return __fern_open_res(path, f, 438); }";
}

pub function rt_src_writer_write(t: string): string {
  return "function __fern_writer_write(fd: i32, s: string): Result[void, IoError] { let n: i32 = s.len(); let data: usize = __raw_data(s); let off: i32 = 0; while (off < n) { let w: i32 = __syscall3(" + sysno(t, "write") + ", fd as i64, (data + off) as i64, (n - off) as i64) as i32; if (w < 0) { return Err(__fern_io_error(0 - w, \"\")); } if (w == 0) { off = n; } else { off = off + w; } } return Ok(()); }";
}

