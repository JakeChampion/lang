  return TyCell { val: x };
}

pub function is_cell(t: Ty): boolean {
  match (t) {
    TyCell(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub function cell_val(t: Ty): Ty {
  match (t) {
    TyCell(x) => {
      return x.val;
    },
    _ => {
      return ty_unknown();
    }
  }
  return ty_unknown();
}

pub function ty_ord(t: Ty): i32 {
  match (t) {
    TyI32(_) => {
      return 0;
    },
    TyU32(_) => {
      return 1;
    },
    TyU64(_) => {
      return 2;
    },
    TyI64(_) => {
      return 3;
    },
    TyUsize(_) => {
      return 4;
    },
    TyBool(_) => {
      return 5;
    },
    TyString(_) => {
      return 6;
    },
    TyF64(_) => {
      return 7;
    },
    TyStruct(_) => {
      return 8;
    },
    TyTuple(_) => {
      return 9;
    },
    TyUnknown(_) => {
      return 10;
    },
    TyArray(_) => {
      return 11;
    },
    TyArrayI32(_) => {
      return 12;
    },
    TyArrayU32(_) => {
      return 13;
    },
    TyArrayU64(_) => {
      return 14;
    },
    TyArrayI64(_) => {
      return 15;
    },
    TyArrayString(_) => {
      return 16;
    },
    TyFnAny(_) => {
      return 17;
    },
    TyU8(_) => {
      return 27;
    },
    TyMapAny(_) => {
      return 18;
    },
    TyOption(_) => {
      return 19;
    },
    TyResult(_) => {
      return 20;
    },
    TyFn(_) => {
      return 21;
    },
    TyMapStr(_) => {
      return 22;
    },
    TyMapI32(_) => {
      return 23;
    },
    TyMapIter(_) => {
      return 24;
    },
    TyStructNamed(_) => {
      return 25;
    },
    TyCell(_) => {
      return 26;
    },
    _ => {
      return -1;
    }
  }
  return -1;
}

