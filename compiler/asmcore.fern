pub function statfs_bufsize(t: string): string {
  return util.i32_to_string(statfs_bufsize_n(t));
}

function statfs_bufsize_n(t: string): i32 {
  if (t == "arm64-darwin") {
    return 2176;
  }
  return 128;
}

pub function scratch_size(t: string, needs_statfs: boolean, minimum: i32): string {
  let n: i32 = minimum;
  if (needs_statfs && statfs_bufsize_n(t) > n) {
    n = statfs_bufsize_n(t);
  }
  return util.i32_to_string(n);
}

