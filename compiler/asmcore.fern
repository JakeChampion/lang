pub type Ty = TyI32 | TyU8 | TyU32 | TyU64 | TyI64 | TyUsize | TyBool | TyString | TyF64 | TyStruct
  | TyTuple | TyUnknown | TyArray | TyArrayI32 | TyArrayU32 | TyArrayU64 | TyArrayI64
  | TyArrayString | TyFnAny | TyMapAny | TyOption | TyResult | TyFn | TyMapStr | TyMapI32
  | TyCell | TyStructNamed;

pub function ty_named(name: string): Ty {
  return TyStructNamed { name: name };
}

pub function ty_struct_name(t: Ty): string {
  match (t) {
    TyStructNamed(x) => {
      return x.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

