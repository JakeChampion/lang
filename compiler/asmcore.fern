pub function task_runtime_roots(): string {
  return "__fern_task_tab __fern_task_rec __fern_task_blank __fern_task_new __fern_task_free __fern_task_cur __fern_task_enter __fern_task_leave __fern_task_mode __fern_task_park __fern_task_wait __fern_task_timeout __fern_task_set_ready __fern_task_set_cancelled __fern_task_cancelled __fern_task_reserve __fern_task_take __fern_task_pop_w";
}

pub function sanitize_label(name: string): string {
  let dot: i32 = __memchr(name, 46, 0);
  if (dot < 0) {
    return name;
  }
  let out: string = "";
  let start: i32 = 0;
  while (dot >= 0) {
    out = out + slice_unchecked(name, start, dot) + "__";
    start = dot + 1;
    dot = __memchr(name, 46, start);
  }
  return out + slice_unchecked(name, start, name.len());
}

pub function lambda_captures(lm: ast.ExprLambda, outer: EmitState): string[] {
  let refs: string[] = astwalk.collect_lambda_idents(lm, []);
  let caps: string[] = [];
  let ri: i32 = 0;
  while (ri < refs.len()) {
    let nm: string = refs[ri];
    if (!util.has_str(caps, nm) && outer.has_local(nm)) {
      caps = caps.append(nm);
    }
    ri = ri + 1;
  }
  return caps;
}

pub struct EmitState {
  out: usize,
  label_n: i32,
  builtin_i32: util.NameIndex,
  builtin_string: util.NameIndex,
  funcs_ix: util.NameIndex,
  kinds: ssa_lift.KindTable,
  local_names: string[],
  string_lits: string[],
  slit_head: i32[],
  slit_next: i32[],
  needed: string[],
  struct_decls: irtables.StructTab,
  funcs: parser.FuncDecl[],
  local_types: Ty[],
  str_ns: string,
  shape_lits: string[],
  sym_addrs: string[],
  cfi_stubs: string[],
  build_profile: string,
  build_target: string,
  const_aggs: string[],
  const_agg_ix: util.NameIndex,
  ssa_frame: i32,
  ssa_save: i32,
  lane_consts: boolean,
  ssa_lane_slots: boolean[],
  ssa_trap_suffix: string,
  ssa_x0: i32,
  reg_entries: irtables.SigReg,
  float_abi: irtables.SigReg,
  float_abi_masks: string[],
  leaves: ssa.Leaves,
  retain_prepared: boolean,
  prepared: ssaprepare.Emitted[],
  memo: rcmemo.Memo,
  retain_sites: boolean,
  native_sites: ssaprepare.UniqueSite[],
  capture: usize,
  recs: usize,
  nlab: i32,
  rt_lower: (parser.Module) => physicalbody.Lowered,
  runtime_units: RuntimeUnits,
  runtime_target: string,
  named: string[],
  rc_free_debug: boolean,
  sanitize: boolean,
  leak_check: boolean,
  backtrace: boolean,
  profile: i32,
  var_rows: boolean,
  shared: boolean,
  size: boolean,
  harden: boolean,
  pie: boolean,
  heap_limit: i64,
  quarantine: i64,
  dw_first: boolean,
  dw_pos: i64,
  line_maps: util.LineMap[],
  debug_rows: string[],
  rt_owned_allocs: boolean,
  syscalls: i32[],
  raw_syscall: string,
}

pub function preparation_context(s: EmitState, architecture: string): Option[ssaprepare.Context] {
  if (!s.retain_prepared) {
    return None;
  }
  return Some(ssaprepare.Context { architecture: architecture, reg_entries: s.reg_entries, leaves: s.leaves, records: s.records(), rc_free_debug: s.rc_free_debug, sanitize: s.sanitize, leak_check: s.leak_check, rt_owned_allocs: s.rt_owned_allocs, needed: s.needed });
}

pub function retain_body(s: EmitState, body: ssaprepare.Body, label_name: string, context: Option[ssaprepare.Context], entry: ssaprepare.ReleaseEntry, allocation: ssaprepare.Allocation): EmitState {
  match (context) {
    Some(c) => {
      let emitted = ssaprepare.Emitted { label_name: label_name, body: body, context: c, release_entry: entry, allocation: allocation, assembly: "", sites: [] };
      return EmitState { ...s, prepared: s.prepared.append(emitted) };
    },
    None => {
      return s;
    }
  }
}

pub function finish_unique_site(s: EmitState, h: usize, outer: usize, site: ssaprepare.UniqueSite): EmitState {
  let text = buf_take(h);
  buf_free(h);
  let captured = ssaprepare.UniqueSite { ...site, text: text };
  s = EmitState { ...s, capture: outer, native_sites: s.native_sites.append(captured) };
  return s.write(text);
}

pub function finish_native_text(s: EmitState, h: usize, outer: usize, sites: ssaprepare.UniqueSite[], retaining: boolean): EmitState {
  let text = buf_take(h);
  buf_free(h);
  let at = s.prepared.len() - 1;
  let row = ssaprepare.Emitted { ...s.prepared[at], assembly: text, sites: s.native_sites };
  s = EmitState { ...s, prepared: s.prepared.with(at, row), capture: outer, native_sites: sites, retain_sites: retaining };
  return s.write(text);
}

pub function (s: EmitState) syscall(nr: i32): EmitState {
  if (s.profile > 0 && nr == 231) {
    s = s.write("    pushq %rax\n    pushq %rdi\n    call __fern_profile_flush\n    popq %rdi\n    popq %rax\n");
  }
  let t: EmitState = s.write("    syscall\n");
  let at: i32 = 0;
  while (at < t.syscalls.len() && t.syscalls[at] < nr) {
    at = at + 1;
  }
  if (at < t.syscalls.len() && t.syscalls[at] == nr) {
    return t;
  }
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < t.syscalls.len()) {
    if (i == at) {
      out = out.append(nr);
    }
    out = out.append(t.syscalls[i]);
    i = i + 1;
  }
  if (at == t.syscalls.len()) {
    out = out.append(nr);
  }
  return EmitState { ...t, syscalls: out };
}

pub function (s: EmitState) raw_syscall(callee: string): EmitState {
  let t: EmitState = s.write("    syscall\n");
  if (t.raw_syscall != "") {
    return t;
  }
  return EmitState { ...t, raw_syscall: callee };
}

pub function (s: EmitState) has_named(name: string): boolean {
  return util.has_str(s.named, name);
}

pub function (s: EmitState) with_named(name: string): EmitState {
  return EmitState { ...s, named: s.named.append(name) };
}

// RuntimeUnits keeps each runtime module that this emission loaded and lowered, by its roots.
// The runtime fixpoint emits the runtime again when it finds a new need, and reuses them.
pub struct RuntimeUnits { roots: util.NameIndex, mods: parser.Module[], lowered: physicalbody.Lowered[] }

pub function with_runtime_unit(s: EmitState, roots: string, m: parser.Module, lowered: physicalbody.Lowered): EmitState {
  let u: RuntimeUnits = s.runtime_units;
  return EmitState { ...s, runtime_units: RuntimeUnits { roots: u.roots.added(roots), mods: u.mods.append(m), lowered: u.lowered.append(lowered) } };
}

pub function no_rt_lower(mod: parser.Module): physicalbody.Lowered {
  eprint("internal error: a runtime helper was appended with no typed lowering to lower it");
  exit(3);
  return physicalbody.empty();
}

pub function unit_labels(mod: parser.Module, lo: i32, hi: i32, cache: irtables.LowerResult[]): string[] {
  let out: string[] = [];
  let fi: i32 = lo;
  while (fi < hi) {
    if (cache.len() == 0 || !cache[fi].superseded) {
      let name: string = mod.funcs[fi].name;
      if (mod.funcs[fi].receiver_type.len() > 0) {
        name = util.base_type_name(mod.funcs[fi].receiver_type) + "." + name;
      }
      out = out.append(sanitize_label(name));
    }
    fi = fi + 1;
  }
  let xi: i32 = mod.funcs.len();
  while (xi < cache.len()) {
    out = out.append(sanitize_label(cache[xi].name));
    xi = xi + 1;
  }
  return out;
}

pub function tail_allocator(ins: ssa.SInst): string {
  if (ins.kind_tag == 50 && ins.str == "raw_arr_box" && ins.args.len() == 1) {
    return "__fern_arr_box";
  }
  return "";
}

pub struct FloatAbi { names: irtables.SigReg, masks: string[] }

pub function unit_float_abi(mod: parser.Module, lo: i32, hi: i32, cache: irtables.LowerResult[]): FloatAbi {
  let names: string[] = [];
  let masks: string[] = [];
  let fi: i32 = 0;
  while (fi < cache.len()) {
    let inside: boolean = fi >= mod.funcs.len() || fi >= lo && fi < hi;
    if (inside && !cache[fi].superseded && cache[fi].ok) {
      let name: string = cache[fi].name;
      if (fi < mod.funcs.len()) {
        name = mod.funcs[fi].name;
        if (mod.funcs[fi].receiver_type.len() > 0) {
          name = util.base_type_name(mod.funcs[fi].receiver_type) + "." + name;
        }
      }
      let mask: string = float_mask_of(cache[fi]);
      if (mask != "") {
        names = names.append(sanitize_label(name));
        masks = masks.append(mask);
      }
    }
    fi = fi + 1;
  }
  return FloatAbi { names: irtables.sig_reg_of(names), masks: masks };
}

function float_mask_of(r: irtables.LowerResult): string {
  let mask: string = "";
  let p: i32 = 0;
  while (p < r.n_params) {
    mask = mask + slot_class(r, p);
    p = p + 1;
  }
  let res: string = "x";
  if (r.result_kind == irtables.result_f64()) {
    res = "f";
  } else if (r.result_kind == irtables.result_v128()) {
    res = "v";
  }
  if (res == "x" && !util.contains(mask, "f") && !util.contains(mask, "v")) {
    return "";
  }
  return mask + "|" + res;
}

function slot_class(r: irtables.LowerResult, p: i32): string {
  if (util.index_of_i32(r.f64_slots, p) >= 0) {
    return "f";
  }
  if (util.index_of_i32(r.v128_slots, p) >= 0) {
    return "v";
  }
  return "x";
}

pub function (s: EmitState) float_mask(label: string): string {
  let i: i32 = irtables.sig_reg_index(s.float_abi, label);
  if (i < 0) {
    return "";
  }
  return s.float_abi_masks[i];
}

pub function float_param(mask: string, p: i32): boolean {
  return p < mask.len() && mask[p] == b'f';
}

pub function float_result(mask: string): boolean {
  return mask.len() > 0 && mask[mask.len() - 1] == b'f';
}

pub function lane_param(mask: string, p: i32): boolean {
  return p < mask.len() && mask[p] == b'v';
}

pub function has_lane_param(mask: string): boolean {
  let p: i32 = 0;
  while (p < mask.len() && mask[p] != b'|') {
    if (mask[p] == b'v') {
      return true;
    }
    p = p + 1;
  }
  return false;
}

pub function lane_result(mask: string): boolean {
  return mask.len() > 0 && mask[mask.len() - 1] == b'v';
}

pub function unit_leaves(mod: parser.Module, lo: i32, hi: i32, cache: irtables.LowerResult[], kt: ssa_lift.KindTable): UnitLeaves {
  let out: ssa.Leaf[] = [];
  let pre: Prelift[] = [];
  let fi: i32 = 0;
  while (fi < cache.len()) {
    let p: Prelift = no_prelift();
    let inside: boolean = fi >= mod.funcs.len() || fi >= lo && fi < hi;
    if (fi < mod.funcs.len() && mod.funcs[fi].no_inline) {
      inside = false;
    }
    if (inside && !cache[fi].superseded && cache[fi].ok && cache[fi].ops.len() <= 160) {
      let name: string = cache[fi].name;
      if (fi < mod.funcs.len()) {
        name = mod.funcs[fi].name;
        if (mod.funcs[fi].receiver_type.len() > 0) {
          name = util.base_type_name(mod.funcs[fi].receiver_type) + "." + name;
        }
      }
      if let Ok(lifted) = ssa_lift.lift_with_lanes(kt, name, cache[fi].n_params, cache[fi].n_locals, cache[fi].ops, false, cache[fi].v128_slots) {
        let f: ssa.Formed = ssa.register_form(lifted.func);
        for leaf in ssa.leaf_of(name, f.f) {
          out = out.append(leaf);
        }
        p = Prelift { lifted: Some(lifted), formed: Some(f) };
      }
    }
    pre = pre.append(p);
    fi = fi + 1;
  }
  let leaves: ssa.Leaves = ssa.leaves_of(out);
  return UnitLeaves { leaves: leaves, pre: unformed_callers(pre, leaves) };
}

function unformed_callers(own pre: Prelift[], leaves: ssa.Leaves): Prelift[] {
  let i: i32 = 0;
  while (i < pre.len()) {
    if let Some(l) = pre[i].lifted {
      if (ssa.calls_leaf(l.func, leaves)) {
        pre = pre.with(i, Prelift { lifted: Some(l), formed: None });
      }
    }
    i = i + 1;
  }
  return pre;
}

pub struct UnitLeaves { leaves: ssa.Leaves, pre: Prelift[] }

pub struct Prelift { lifted: Option[ssa_lift.Lifted], formed: Option[ssa.Formed] }

pub function (s: EmitState) prelift(pre: Prelift[], i: i32, r: irtables.LowerResult): Prelift {
  if (i >= pre.len() || r.source_positions.entry.line > 0 || r.dbg_slots.len() > 0 && s.var_rows) {
    return no_prelift();
  }
  return pre[i];
}

pub function no_prelift(): Prelift {
  return Prelift { lifted: None, formed: None };
}

pub function (s: EmitState) lift(pre: Prelift, label_name: string, r: irtables.Lowered): Result[ssa_lift.Lifted, string] {
  if let Some(l) = pre.lifted {
    return Ok(l);
  }
  return ssa_lift.lift_with_lanes(s.kinds, label_name, r.n_params, r.n_locals, r.ops, r.source_positions.entry.line > 0 || r.dbg_slots.len() > 0 && s.var_rows, r.v128_slots);
}

pub function (s: EmitState) finish(pre: Prelift, r: irtables.Lowered, selected: physicalbody.Selected, lifted: ssa_lift.Lifted): ssaprepare.Body {
  if let Some(f) = pre.formed {
    return ssaprepare.finish_formed(r, selected, lifted, f);
  }
  return ssaprepare.finish(r, selected, lifted, s.leaves);
}

pub function new_state(): EmitState {
  let ns: string[] = [];
  let sl: string[] = [];
  let fns: parser.FuncDecl[] = [];
  let lts: Ty[] = [];
  let nd: string[] = [];
  let s: EmitState = EmitState {
    out: buf_new(65536),
    label_n: 0,
    builtin_i32: util.name_index(builtin_i32_names()),
    builtin_string: util.name_index(builtin_string_names()),
    funcs_ix: util.name_index(ns),
    kinds: ssa_lift.kind_table(),
    local_names: ns,
    string_lits: sl,
    slit_head: slit_empty_buckets(),
    slit_next: [],
    needed: nd,
    struct_decls: irtables.struct_tab_empty(),
    funcs: fns,
    local_types: lts,
    str_ns: "",
    shape_lits: [],
    sym_addrs: [],
    cfi_stubs: [],
    build_profile: "",
    build_target: "",
    const_aggs: [],
    const_agg_ix: util.name_index([]),
    ssa_frame: 0,
    ssa_save: 0,
    lane_consts: false,
    ssa_lane_slots: [],
    ssa_trap_suffix: "",
    ssa_x0: 0 - 1,
    reg_entries: irtables.sig_reg_of([]),
    float_abi: irtables.sig_reg_of([]),
    float_abi_masks: [],
    leaves: ssa.leaves_of([]),
    retain_prepared: false,
    prepared: [],
    memo: rcmemo.off(),
    retain_sites: false,
    native_sites: [],
    capture: 0 as usize,
    nlab: 0,
    recs: 0 as usize,
    rt_lower: no_rt_lower,
    runtime_units: RuntimeUnits { roots: util.name_index([]), mods: [], lowered: [] },
    runtime_target: "arm64-linux",
    named: [],
    rc_free_debug: false,
    sanitize: false,
    leak_check: false,
    backtrace: false,
    profile: rtprofile.mode(),
    shared: false,
    size: false,
    harden: false,
    pie: false,
    heap_limit: 17179869184i64,
    quarantine: 0i64,
    var_rows: false,
    dw_first: false,
    dw_pos: 0,
    line_maps: [],
    debug_rows: [],
    rt_owned_allocs: false,
    syscalls: [],
    raw_syscall: "",
  };
  return with_switches(s, env_switches());
}

pub function sanitize_on(): boolean {
  return envflag.on("FERN_SANITIZE");
}

pub function sandbox_on(): boolean {
  return envflag.on("FERN_SANDBOX");
}

pub function stack_size(): i32 {
  return 1073741824;
}

pub function stack_guard(): i32 {
  return 1048576;
}

pub function backtrace_on(): boolean {
  match (env("FERN_BACKTRACE")) {
    Some(v) => {
      return envflag.value_on(v);
    },
    None => {
      return true;
    }
  }
}

pub function size_on(): boolean {
  return envflag.on("FERN_SIZE");
}

pub function leak_check_on(): boolean {
  return envflag.on("FERN_LEAKCHECK");
}

pub struct Switches { backtrace: boolean, sanitize: boolean, leak_check: boolean, rc_free_debug: boolean, var_rows: boolean, shared: boolean, size: boolean, harden: boolean, heap_limit: i64, quarantine: i64, pie: boolean, profile: string, target: string, line_maps: util.LineMap[] }

// The -sanitize quarantine budget in bytes when no -quarantine was given: 64 MiB.
pub function quarantine_default(): i64 {
  return 67108864i64;
}

// The arena reservation in bytes: a -heap-limit when one was given, else 16 GiB.
pub function arena_bytes(limit: i64): i64 {
  if (limit > 0i64) {
    return limit;
  }
  return 17179869184i64;
}

pub function env_switches(): Switches {
  return Switches { backtrace: backtrace_on(), sanitize: sanitize_on(), leak_check: leak_check_on(), rc_free_debug: rc_free_debug_on(), var_rows: false, shared: false, size: size_on(), harden: false, heap_limit: 0i64, quarantine: quarantine_default(), pie: false, profile: "", target: "", line_maps: [] };
}

pub function with_switches(s: EmitState, sw: Switches): EmitState {
  return EmitState { ...s, backtrace: sw.backtrace, var_rows: sw.var_rows, shared: sw.shared, size: sw.size, harden: sw.harden, pie: sw.pie, heap_limit: arena_bytes(sw.heap_limit), quarantine: sw.quarantine, build_profile: sw.profile, build_target: sw.target, line_maps: sw.line_maps, sanitize: sw.sanitize, leak_check: sw.sanitize || sw.leak_check, rc_free_debug: sw.sanitize || sw.rc_free_debug };
}

// A `.loc` row names the document line of a literate module, not its tangled line.
pub function loc_row(s: EmitState, line: i32, col: string): string {
  let (at, c) = util.doc_pos(s.line_maps, line, util.digits_to_i32(col));
  return "    .loc " + util.i32_to_string(util.pos_file_index(line) + 1) + " " + util.i32_to_string(util.pos_line(at)) + " " + util.i32_to_string(c);
}

function flag01(on: boolean): string {
  if (on) {
    return "1";
  }
  return "0";
}

// The build manifest stamped into every native executable, which
// `fern -manifest` and std/mitigations read back.
pub function build_manifest(s: EmitState): string {
  return "FERNBUILD1 target=" + s.build_target + " profile=" + s.build_profile + " harden=" + flag01(s.harden) + " pie=" + flag01(s.pie) + " sanitize=" + flag01(s.sanitize) + " backtrace=" + flag01(s.backtrace) + " size=" + flag01(s.size) + " shared=" + flag01(s.shared) + " heap_limit=" + util.i64_to_string(s.heap_limit) + " quarantine=" + util.i64_to_string(s.quarantine);
}

pub function emit_build_manifest(s: EmitState): EmitState {
  return s.write("    .section .rodata\n__fern_build:\n    .ascii \"" + build_manifest(s) + "\\n\"\n    .text\n");
}

pub function rc_free_debug_on(): boolean {
  return envflag.on("FERN_RC_FREE_DEBUG");
}

pub function with_funcs(s: EmitState, funcs: parser.FuncDecl[]): EmitState {
  let names: string[] = [];
  for fd in funcs {
    names = names.append(fd.name);
  }
  return EmitState { ...s, funcs: funcs, funcs_ix: util.name_index(names) };
}

pub function add_shape_lit(s: EmitState, name: string): EmitState {
  let i: i32 = 0;
  while (i < s.shape_lits.len()) {
    if (s.shape_lits[i] == name) {
      return s;
    }
    i = i + 1;
  }
  return EmitState { ...s, shape_lits: s.shape_lits.append(name) };
}

pub function emit_shape_lits_from(s: EmitState, from: i32): EmitState {
  if (s.shape_lits.len() <= from) {
    return s;
  }
  s = s.write("    .section .rodata\n");
  let i: i32 = from;
  while (i < s.shape_lits.len()) {
    let sym: string = shape_sym(s.shape_lits[i]);
    s = s.write(".weak " + sym + "\n");
    s = s.write(sym + ": .ascii \"" + escape_for_ascii(s.shape_lits[i]) + "\"\n");
    i = i + 1;
  }
  return s;
}

pub function dedupe_weak_into(asm_text: string, seen_in: string[], h: usize): string[] {
  let seen: string[] = seen_in;
  let i: i32 = 0;
  let n: i32 = asm_text.len();
  let state: i32 = 0;
  while (i < n) {
    let j: i32 = i;
    while (j < n && asm_text[j] != b'\n') {
      j = j + 1;
    }
    let line: string = slice_unchecked(asm_text, i, j) + "";
    let drop: boolean = false;
    if (state == 1) {
      drop = true;
      state = 2;
    } else if (state == 2) {
      let k: i32 = 0;
      while (k < line.len() && (slice_unchecked(line, k, k + 1) == " " || slice_unchecked(line, k, k + 1) == "\t")) {
        k = k + 1;
      }
      let body: string = slice_unchecked(line, k, line.len()) + "";
      if (body.len() == 0) {
        drop = true;
      } else if (body.len() > 2 && slice_unchecked(body, 0, 2) == ".L") {
        drop = true;
      } else if (k > 0 && slice_unchecked(body, 0, 1) != ".") {
        drop = true;
      } else {
        state = 0;
      }
    }
    if (state == 0 && !drop && line.len() > 6 && slice_unchecked(line, 0, 6) == ".weak ") {
      let sym: string = slice_unchecked(line, 6, line.len()) + "";
      if (util.has_str(seen, sym)) {
        drop = true;
        state = 1;
      } else {
        seen = seen.append(sym);
      }
    }
    if (!drop) {
      buf_push(h, line);
      buf_push(h, "\n");
    }
    i = j + 1;
  }
  return seen;
}

pub function dedupe_weak_defs(asm_text: string): string {
  let h: usize = buf_new(asm_text.len());
  let ignored: string[] = dedupe_weak_into(asm_text, [], h);
  let text: string = buf_take(h);
  buf_free(h);
  return text;
}

pub function buf_helper(kind: i32): string {
  if (kind == 372) {
    return "__fern_buf_push_bytes_expanded";
  }
  if (kind == 371) {
    return "__fern_buf_push_bytes_filtered";
  }
  if (kind == 370) {
    return "__fern_buf_push_bytes_mapped";
  }
  if (kind == 347) {
    return "__fern_buf_take_bytes";
  }
  if (kind == 351) {
    return "__fern_buf_push_bytes_range";
  }
  if (kind == 291) {
    return "__fern_buf_new";
  }
  if (kind == 292) {
    return "__fern_buf_push";
  }
  if (kind == 293) {
    return "__fern_buf_push_range";
  }
  if (kind == 294) {
    return "__fern_buf_push_byte";
  }
  if (kind == 295) {
    return "__fern_buf_len";
  }
  if (kind == 296) {
    return "__fern_buf_take";
  }
  if (kind == 297) {
    return "__fern_buf_free";
  }
  if (kind == 386) {
    return "__fern_buf_clear";
  }
  if (kind == 306) {
    return "__fern_buf_push_u64";
  }
  if (kind == 325) {
    return "__fern_buf_push_mapped";
  }
  if (kind == 326) {
    return "__fern_buf_push_filtered";
  }
  if (kind == 328) {
    return "__fern_buf_push_expanded";
  }
  return "";
}

pub function buf_table_helper(kind: i32, packed: boolean): string {
  if (packed && kind == 347) {
    return "__fern_buf_take_bytes_u8";
  }
  if (packed && kind == 351) {
    return "__fern_buf_push_bytes_range_u8";
  }
  if (packed && (kind == 325 || kind == 326 || kind == 328 || kind == 370 || kind == 371 || kind == 372)) {
    return buf_helper(kind) + "_u8";
  }
  return buf_helper(kind);
}

pub function buf_arity(kind: i32): i32 {
  if (kind == 293 || kind == 351) {
    return 4;
  }
  if (kind == 325 || kind == 326 || kind == 328 || kind == 370 || kind == 371 || kind == 372) {
    return 3;
  }
  if (kind == 292 || kind == 294 || kind == 306) {
    return 2;
  }
  if (buf_helper(kind) != "") {
    return 1;
  }
  return 0;
}

pub function shape_sym(name: string): string {
  return "__fern_shp_" + sanitize_label(name);
}

pub function (s: EmitState) write(text: string): EmitState {
  if (s.capture != 0 as usize) {
    buf_push(s.capture, text);
    return s;
  }
  buf_push(s.out, text);
  return s;
}

pub function (s: EmitState) take_text(): string {
  let text: string = buf_take(s.out);
  buf_free(s.out);
  return text;
}

pub function (s: EmitState) release(): void {
  buf_free(s.out);
}

pub function (s: EmitState) records(): boolean {
  return s.recs != 0 as usize && s.capture == 0 as usize;
}

pub function (s: EmitState) word(w: i64): EmitState {
  buf_push_u64(s.recs, w as u64);
  buf_push(s.out, "\x01\n");
  return s;
}

pub function (s: EmitState) mark(m: string, text: string): EmitState {
  buf_push(s.out, m);
  buf_push(s.out, text);
  buf_push(s.out, "\n");
  return s;
}

pub function (s: EmitState) bytes(b: i32[]): EmitState {
  buf_push_byte(s.recs, b.len());
  for x in b {
    buf_push_byte(s.recs, x);
  }
  buf_push(s.out, "\x01\n");
  return s;
}

pub function (s: EmitState) named(b: i32[], name: string): EmitState {
  buf_push_byte(s.recs, b.len());
  for x in b {
    buf_push_byte(s.recs, x);
  }
  return s.mark("\x07", name);
}

pub function (s: EmitState) named_abs(b: i32[], name: string): EmitState {
  buf_push_byte(s.recs, b.len());
  for x in b {
    buf_push_byte(s.recs, x);
  }
  return s.mark("\x08", name);
}

pub function (s: EmitState) branch(w: i64, label: string): EmitState {
  buf_push_u64(s.recs, w as u64);
  return s.mark("\x02", label);
}

pub function (s: EmitState) bind_local_typed(name: string, ty: Ty): EmitState {
  let ln: string[] = s.local_names.append(name);
  let lts: Ty[] = s.local_types.append(ty);
  return EmitState { ...s, local_names: ln, local_types: lts };
}

pub function (s: EmitState) local_type_of(name: string): Ty {
  let i: i32 = s.local_names.len() - 1;
  while (i >= 0) {
    if (s.local_names[i] == name) {
      return s.local_types[i];
    }
    i = i - 1;
  }
  return ty_unknown();
}

pub function sysno(t: string, name: string): string {
  let n: string = "-1";
  if (t == "x86-64-linux") {
    n = sysno_x86_64(name);
  } else if (t == "arm64-darwin") {
    n = sysno_arm64_darwin(name);
  } else if (t == "arm64-linux") {
    n = sysno_arm64_linux(name);
  } else {
    unknown_rt_key(t);
  }
  if (n == "-1") {
    eprint("error: internal: a runtime body asks for the " + t + " syscall number of " + name + ", which the sysno table has no row for");
    exit(3);
  }
  return n;
}

