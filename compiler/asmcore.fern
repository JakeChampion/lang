pub function ty_is_i32(t: Ty): boolean {
  match (t) {
    TyI32(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub function ty_is_u8(t: Ty): boolean {
  match (t) {
    TyU8(_) => {
      return true;
