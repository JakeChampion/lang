pub function is_helper(name: string): boolean {
  return name == "__fern_bytes_append_range" || name == "__fern_bytes_write_range" || name == "__fern_bytes_append_back";
}

pub function wasm_source(append: boolean, write: boolean, back: boolean): string {
  let out = "  (func $__fern_bytes_copy_bounds (param $a i32) (param $from i32) (param $n i32)\n"
    + "    (if (i32.or (i32.gt_u (local.get $from) (i32.load (local.get $a))) (i32.gt_s (local.get $n) (i32.sub (i32.load (local.get $a)) (local.get $from)))) (then (unreachable))))\n";
  if (append) {
    out = out + wasm_append();
  }
  if (write) {
    out = out + wasm_write();
  }
  if (back) {
    out = out + wasm_back();
  }
  return out;
}

function wasm_append(): string {
  return "  (func $__fern_bytes_append_range (param $n i32) (param $from i32) (param $src i32) (param $a i32) (result i32)\n"
    + "    (local $len i32) (local $total i64) (local $cap i64) (local $r i32)\n"
    + "    (if (i32.le_s (local.get $n) (i32.const 0)) (then (return (local.get $a))))\n"
    + "    (call $__fern_bytes_copy_bounds (local.get $src) (local.get $from) (local.get $n))\n"
    + "    (local.set $len (i32.load (local.get $a)))\n"
    + wasm_grow()
    + "    (memory.copy (i32.add (i32.add (local.get $r) (i32.const 8)) (local.get $len)) (i32.add (i32.add (local.get $src) (i32.const 8)) (local.get $from)) (local.get $n))\n"
    + wasm_appended();
}

function wasm_back(): string {
  return "  (func $__fern_bytes_append_back (param $n i32) (param $dist i32) (param $a i32) (result i32)\n"
    + "    (local $len i32) (local $total i64) (local $cap i64) (local $r i32) (local $base i32) (local $at i32) (local $end i32) (local $chunk i32)\n"
    + "    (if (i32.le_s (local.get $n) (i32.const 0)) (then (return (local.get $a))))\n"
    + "    (local.set $len (i32.load (local.get $a)))\n"
    + "    (if (i32.or (i32.lt_s (local.get $dist) (i32.const 1)) (i32.gt_s (local.get $dist) (local.get $len))) (then (unreachable)))\n"
    + wasm_grow()
    + "    (local.set $base (i32.add (local.get $r) (i32.const 8))) (local.set $at (local.get $len)) (local.set $end (i32.wrap_i64 (local.get $total)))\n"
    + "    (block $done (loop $copy (br_if $done (i32.ge_s (local.get $at) (local.get $end)))\n"
    + "      (local.set $chunk (local.get $dist))\n"
    + "      (if (i32.gt_s (local.get $chunk) (i32.sub (local.get $end) (local.get $at))) (then (local.set $chunk (i32.sub (local.get $end) (local.get $at)))))\n"
    + "      (memory.copy (i32.add (local.get $base) (local.get $at)) (i32.sub (i32.add (local.get $base) (local.get $at)) (local.get $dist)) (local.get $chunk))\n"
    + "      (local.set $at (i32.add (local.get $at) (local.get $chunk))) (local.set $dist (i32.add (local.get $dist) (local.get $chunk))) (br $copy)))\n"
    + wasm_appended();
}

function wasm_grow(): string {
  return "    (local.set $total (i64.add (i64.extend_i32_u (local.get $len)) (i64.extend_i32_u (local.get $n))))\n"
    + "    (if (i64.gt_u (local.get $total) (i64.const 2147483647)) (then (unreachable)))\n"
    + "    (local.set $cap (i64.extend_i32_u (i32.load offset=4 (local.get $a))))\n"
    + "    (local.set $r (local.get $a))\n"
    + "    (if (i32.or (i32.ne (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (i64.gt_u (local.get $total) (local.get $cap))) (then\n"
    + "      (if (i64.lt_u (local.get $cap) (i64.const 32)) (then (local.set $cap (i64.const 32))))\n"
    + "      (block $ready (loop $grow (br_if $ready (i64.ge_u (local.get $cap) (local.get $total))) (local.set $cap (i64.mul (local.get $cap) (i64.const 2))) (br $grow)))\n"
    + "      (if (i64.gt_u (local.get $cap) (i64.const 2147483647)) (then (local.set $cap (local.get $total))))\n"
    + "      (local.set $r (call $__fern_arr_elems (i32.wrap_i64 (local.get $cap)) (i32.const 1)))\n"
    + "      (i32.store offset=4 (local.get $r) (i32.wrap_i64 (local.get $cap)))\n"
    + "      (memory.copy (i32.add (local.get $r) (i32.const 8)) (i32.add (local.get $a) (i32.const 8)) (local.get $len))))\n";
}

function wasm_appended(): string {
  return "    (i32.store (local.get $r) (i32.wrap_i64 (local.get $total)))\n"
    + "    (if (i32.ne (local.get $r) (local.get $a)) (then (drop (call $__fern_arr_dec (local.get $a)))))\n"
    + "    (local.get $r))\n";
}

function wasm_write(): string {
  return "  (func $__fern_bytes_write_range (param $n i32) (param $from i32) (param $src i32) (param $at i32) (param $a i32) (result i32)\n"
    + "    (local $len i32) (local $cap i32) (local $r i32)\n"
    + "    (if (i32.le_s (local.get $n) (i32.const 0)) (then (return (local.get $a))))\n"
    + "    (call $__fern_bytes_copy_bounds (local.get $src) (local.get $from) (local.get $n))\n"
    + "    (call $__fern_bytes_copy_bounds (local.get $a) (local.get $at) (local.get $n))\n"
    + "    (local.set $len (i32.load (local.get $a))) (local.set $r (local.get $a))\n"
    + "    (if (i32.ne (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n"
    + "      (local.set $cap (i32.load offset=4 (local.get $a)))\n"
    + "      (local.set $r (call $__fern_arr_elems (local.get $cap) (i32.const 1)))\n"
    + "      (i32.store (local.get $r) (local.get $len)) (i32.store offset=4 (local.get $r) (local.get $cap))\n"
    + "      (memory.copy (i32.add (local.get $r) (i32.const 8)) (i32.add (local.get $a) (i32.const 8)) (local.get $len))))\n"
    + "    (memory.copy (i32.add (i32.add (local.get $r) (i32.const 8)) (local.get $at)) (i32.add (i32.add (local.get $src) (i32.const 8)) (local.get $from)) (local.get $n))\n"
    + "    (if (i32.ne (local.get $r) (local.get $a)) (then (drop (call $__fern_arr_dec (local.get $a)))))\n"
    + "    (local.get $r))\n";
}
