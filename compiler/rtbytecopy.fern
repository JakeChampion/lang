import "./util";

pub function is_helper(name: string): boolean {
  return name == "__fern_bytes_append_range" || name == "__fern_bytes_write_range" || name == "__fern_bytes_append_back" || util.has_str(kernel_names(), name);
}

// The fill and move kernels for elements of 1, 4 and 8 bytes. A shift is the
// log2 of the bytes of an element.
pub function kernel_names(): string[] {
  return ["__fern_arr_fill_u8", "__fern_arr_fill_u32", "__fern_arr_fill_u64", "__fern_arr_move_u8", "__fern_arr_move_u32", "__fern_arr_move_u64"];
}

pub function fill_name(shift: i32): string {
  return "__fern_arr_fill" + width_suffix(shift);
}

pub function move_name(shift: i32): string {
  return "__fern_arr_move" + width_suffix(shift);
}

function width_suffix(shift: i32): string {
  if (shift == 0) {
    return "_u8";
  }
  return if (shift == 2) { "_u32" } else { "_u64" };
}

function kernel_shift(name: string): i32 {
  if (name.ends_with("_u8")) {
    return 0;
  }
  return if (name.ends_with("_u32")) { 2 } else { 3 };
}

// `kernels` are the names from kernel_names() that the module calls.
pub function wasm_source(append: boolean, write: boolean, back: boolean, kernels: string[]): string {
  let out = "  (func $__fern_bytes_copy_bounds (param $a i32) (param $from i32) (param $n i32)\n"
    + "    (if (i32.or (i32.gt_u (local.get $from) (i32.load (local.get $a))) (i32.gt_s (local.get $n) (i32.sub (i32.load (local.get $a)) (local.get $from)))) (then (unreachable))))\n";
  if (kernels.len() > 0) {
    out += wasm_sole();
  }
  let fill = false;
  let move = false;
  for name in kernels {
    if (name.starts_with("__fern_arr_fill")) {
      out += wasm_fill(name);
      fill = true;
    } else {
      out += "  (func $" + name + " (param $n i32) (param $from i32) (param $at i32) (param $a i32) (result i32)\n"
        + "    (call $__fern_arr_move (local.get $a) (local.get $at) (local.get $from) (local.get $n) (i32.const " + util.i32_to_string(1 << kernel_shift(name)) + ")))\n";
      move = true;
    }
  }
  if (move) {
    out += wasm_move();
  }
  if (append) {
    out += wasm_append();
  }
  if (write) {
    out += wasm_write();
  }
  if (back) {
    out += wasm_back();
  }
  return out;
}

function wasm_append(): string {
  return "  (func $__fern_bytes_append_range (param $n i32) (param $from i32) (param $src i32) (param $a i32) (result i32)\n"
    + "    (local $len i32) (local $total i64) (local $cap i64) (local $r i32)\n"
    + "    (if (i32.le_s (local.get $n) (i32.const 0)) (then (return (local.get $a))))\n"
    + "    (call $__fern_bytes_copy_bounds (local.get $src) (local.get $from) (local.get $n))\n"
    + "    (local.set $len (i32.load (local.get $a)))\n"
    + wasm_grow()
    + "    (memory.copy (i32.add (i32.add (local.get $r) (i32.const 8)) (local.get $len)) (i32.add (i32.add (local.get $src) (i32.const 8)) (local.get $from)) (local.get $n))\n"
    + wasm_appended();
}

function wasm_back(): string {
  return "  (func $__fern_bytes_append_back (param $n i32) (param $dist i32) (param $a i32) (result i32)\n"
    + "    (local $len i32) (local $total i64) (local $cap i64) (local $r i32) (local $base i32) (local $at i32) (local $end i32) (local $chunk i32)\n"
    + "    (if (i32.le_s (local.get $n) (i32.const 0)) (then (return (local.get $a))))\n"
    + "    (local.set $len (i32.load (local.get $a)))\n"
    + "    (if (i32.or (i32.lt_s (local.get $dist) (i32.const 1)) (i32.gt_s (local.get $dist) (local.get $len))) (then (unreachable)))\n"
    + wasm_grow()
    + "    (local.set $base (i32.add (local.get $r) (i32.const 8))) (local.set $at (local.get $len)) (local.set $end (i32.wrap_i64 (local.get $total)))\n"
    + "    (block $done (loop $copy (br_if $done (i32.ge_s (local.get $at) (local.get $end)))\n"
    + "      (local.set $chunk (local.get $dist))\n"
    + "      (if (i32.gt_s (local.get $chunk) (i32.sub (local.get $end) (local.get $at))) (then (local.set $chunk (i32.sub (local.get $end) (local.get $at)))))\n"
    + "      (memory.copy (i32.add (local.get $base) (local.get $at)) (i32.sub (i32.add (local.get $base) (local.get $at)) (local.get $dist)) (local.get $chunk))\n"
    + "      (local.set $at (i32.add (local.get $at) (local.get $chunk))) (local.set $dist (i32.add (local.get $dist) (local.get $chunk))) (br $copy)))\n"
    + wasm_appended();
}

// The array itself when it is unique, else a copy, and the array is released.
function wasm_sole(): string {
  return "  (func $__fern_arr_sole (param $a i32) (param $size i32) (result i32)\n"
    + "    (local $len i32) (local $cap i32) (local $r i32)\n"
    + "    (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then (return (local.get $a))))\n"
    + "    (local.set $len (i32.load (local.get $a))) (local.set $cap (i32.load offset=4 (local.get $a)))\n"
    + "    (if (i32.lt_u (local.get $cap) (local.get $len)) (then (local.set $cap (local.get $len))))\n"
    + "    (local.set $r (call $__fern_arr_elems (local.get $cap) (local.get $size)))\n"
    + "    (i32.store (local.get $r) (local.get $len)) (i32.store offset=4 (local.get $r) (local.get $cap))\n"
    + "    (memory.copy (i32.add (local.get $r) (i32.const 8)) (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $len) (local.get $size)))\n"
    + "    (drop (call $__fern_arr_dec (local.get $a)))\n"
    + "    (local.get $r))\n";
}

function wasm_fill(name: string): string {
  let shift = kernel_shift(name);
  let size = util.i32_to_string(1 << shift);
  let vty = if (shift == 3) { "i64" } else { "i32" };
  let out = "  (func $" + name + " (param $v " + vty + ") (param $n i32) (param $at i32) (param $a i32) (result i32)\n"
    + "    (local $r i32) (local $p i32) (local $end i32)\n"
    + "    (if (i32.le_s (local.get $n) (i32.const 0)) (then (return (local.get $a))))\n"
    + "    (call $__fern_bytes_copy_bounds (local.get $a) (local.get $at) (local.get $n))\n"
    + "    (local.set $r (call $__fern_arr_sole (local.get $a) (i32.const " + size + ")))\n"
    + "    (local.set $p (i32.add (i32.add (local.get $r) (i32.const 8)) (i32.mul (local.get $at) (i32.const " + size + "))))\n";
  if (shift == 0) {
    return out + "    (memory.fill (local.get $p) (local.get $v) (local.get $n))\n    (local.get $r))\n";
  }
  let zero = if (shift == 3) { "(i64.eqz (local.get $v))" } else { "(i32.eqz (local.get $v))" };
  return out + "    (local.set $end (i32.add (local.get $p) (i32.mul (local.get $n) (i32.const " + size + "))))\n"
    + "    (if " + zero + " (then (memory.fill (local.get $p) (i32.const 0) (i32.sub (local.get $end) (local.get $p))) (return (local.get $r))))\n"
    + "    (block $done (loop $store (br_if $done (i32.ge_u (local.get $p) (local.get $end)))\n"
    + "      (" + vty + ".store (local.get $p) (local.get $v)) (local.set $p (i32.add (local.get $p) (i32.const " + size + "))) (br $store)))\n"
    + "    (local.get $r))\n";
}

// A chunk is not longer than the distance of the two ranges. Thus it reads
// only elements that hold their final values, as the loop reads them.
function wasm_move(): string {
  return "  (func $__fern_arr_move (param $a i32) (param $at i32) (param $from i32) (param $n i32) (param $size i32) (result i32)\n"
    + "    (local $r i32) (local $base i32) (local $d i32) (local $k i32) (local $c i32)\n"
    + "    (if (i32.le_s (local.get $n) (i32.const 0)) (then (return (local.get $a))))\n"
    + "    (call $__fern_bytes_copy_bounds (local.get $a) (local.get $from) (local.get $n))\n"
    + "    (call $__fern_bytes_copy_bounds (local.get $a) (local.get $at) (local.get $n))\n"
    + "    (local.set $r (call $__fern_arr_sole (local.get $a) (local.get $size)))\n"
    + "    (local.set $base (i32.add (local.get $r) (i32.const 8)))\n"
    + "    (local.set $d (i32.sub (local.get $at) (local.get $from)))\n"
    + "    (if (i32.lt_s (local.get $d) (i32.const 0)) (then (local.set $d (i32.sub (i32.const 0) (local.get $d)))))\n"
    + "    (if (i32.eqz (local.get $d)) (then (return (local.get $r))))\n"
    + "    (block $done (loop $copy (br_if $done (i32.ge_s (local.get $k) (local.get $n)))\n"
    + "      (local.set $c (local.get $d))\n"
    + "      (if (i32.gt_s (local.get $c) (i32.sub (local.get $n) (local.get $k))) (then (local.set $c (i32.sub (local.get $n) (local.get $k)))))\n"
    + "      (memory.copy (i32.add (local.get $base) (i32.mul (i32.add (local.get $at) (local.get $k)) (local.get $size)))\n"
    + "        (i32.add (local.get $base) (i32.mul (i32.add (local.get $from) (local.get $k)) (local.get $size))) (i32.mul (local.get $c) (local.get $size)))\n"
    + "      (local.set $k (i32.add (local.get $k) (local.get $c))) (br $copy)))\n"
    + "    (local.get $r))\n";
}

function wasm_grow(): string {
  return "    (local.set $total (i64.add (i64.extend_i32_u (local.get $len)) (i64.extend_i32_u (local.get $n))))\n"
    + "    (if (i64.gt_u (local.get $total) (i64.const 2147483647)) (then (unreachable)))\n"
    + "    (local.set $cap (i64.extend_i32_u (i32.load offset=4 (local.get $a))))\n"
    + "    (local.set $r (local.get $a))\n"
    + "    (if (i32.or (i32.ne (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (i64.gt_u (local.get $total) (local.get $cap))) (then\n"
    + "      (if (i64.lt_u (local.get $cap) (i64.const 32)) (then (local.set $cap (i64.const 32))))\n"
    + "      (block $ready (loop $grow (br_if $ready (i64.ge_u (local.get $cap) (local.get $total))) (local.set $cap (i64.mul (local.get $cap) (i64.const 2))) (br $grow)))\n"
    + "      (if (i64.gt_u (local.get $cap) (i64.const 2147483647)) (then (local.set $cap (local.get $total))))\n"
    + "      (local.set $r (call $__fern_arr_elems (i32.wrap_i64 (local.get $cap)) (i32.const 1)))\n"
    + "      (i32.store offset=4 (local.get $r) (i32.wrap_i64 (local.get $cap)))\n"
    + "      (memory.copy (i32.add (local.get $r) (i32.const 8)) (i32.add (local.get $a) (i32.const 8)) (local.get $len))))\n";
}

function wasm_appended(): string {
  return "    (i32.store (local.get $r) (i32.wrap_i64 (local.get $total)))\n"
    + "    (if (i32.ne (local.get $r) (local.get $a)) (then (drop (call $__fern_arr_dec (local.get $a)))))\n"
    + "    (local.get $r))\n";
}

function wasm_write(): string {
  return "  (func $__fern_bytes_write_range (param $n i32) (param $from i32) (param $src i32) (param $at i32) (param $a i32) (result i32)\n"
    + "    (local $len i32) (local $cap i32) (local $r i32)\n"
    + "    (if (i32.le_s (local.get $n) (i32.const 0)) (then (return (local.get $a))))\n"
    + "    (call $__fern_bytes_copy_bounds (local.get $src) (local.get $from) (local.get $n))\n"
    + "    (call $__fern_bytes_copy_bounds (local.get $a) (local.get $at) (local.get $n))\n"
    + "    (local.set $len (i32.load (local.get $a))) (local.set $r (local.get $a))\n"
    + "    (if (i32.ne (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n"
    + "      (local.set $cap (i32.load offset=4 (local.get $a)))\n"
    + "      (local.set $r (call $__fern_arr_elems (local.get $cap) (i32.const 1)))\n"
    + "      (i32.store (local.get $r) (local.get $len)) (i32.store offset=4 (local.get $r) (local.get $cap))\n"
    + "      (memory.copy (i32.add (local.get $r) (i32.const 8)) (i32.add (local.get $a) (i32.const 8)) (local.get $len))))\n"
    + "    (memory.copy (i32.add (i32.add (local.get $r) (i32.const 8)) (local.get $at)) (i32.add (i32.add (local.get $src) (i32.const 8)) (local.get $from)) (local.get $n))\n"
    + "    (if (i32.ne (local.get $r) (local.get $a)) (then (drop (call $__fern_arr_dec (local.get $a)))))\n"
    + "    (local.get $r))\n";
}
