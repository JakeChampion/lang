// Position index for exact byte names. Empty instruction placeholders are
// omitted; every stored position still addresses the original input array.
// Proof entry points construct this from their own supplied text, never from
// an external index or previously decoded program.
import "std/string";

pub struct Names { names: string[], order: i32[], duplicate: i32 }

function before(a: string, b: string): boolean {
  let i = 0;
  while (i < a.len() && i < b.len()) {
    if (a[i] != b[i]) {
      return a[i] < b[i];
    }
    i = i + 1;
  }
  return a.len() < b.len();
}

function merge_names(names: string[], order: i32[], left: i32, mid: i32, end: i32, output: i32[]): i32[] {
  let out = output;
  let a = left;
  let b = mid;
  let at = left;
  while (at < end) {
    if (b >= end || a < mid && !before(names[order[b]], names[order[a]])) {
      out = out.with(at, order[a]);
      a = a + 1;
    } else {
      out = out.with(at, order[b]);
      b = b + 1;
    }
    at = at + 1;
  }
  return out;
}

function names_pass(names: string[], order: i32[], width: i32): i32[] {
  let out = order;
  let left = 0;
  while (left < order.len()) {
    let mid = left + (if (width < order.len() - left) { width } else { order.len() - left });
    let end = mid + (if (width < order.len() - mid) { width } else { order.len() - mid });
    out = merge_names(names, order, left, mid, end, out);
    left = end;
  }
  return out;
}

function duplicate_name(names: string[], order: i32[]): i32 {
  let duplicate = -1;
  let i = 1;
  while (i < order.len()) {
    let at = order[i];
    if (names[at] == names[order[i - 1]] && (duplicate < 0 || at < duplicate)) {
      duplicate = at;
    }
    i = i + 1;
  }
  return duplicate;
}

pub function index(names: string[]): Names {
  let order: i32[] = [];
  let i = 0;
  while (i < names.len()) {
    if (names[i] != "") {
      order = order.append(i);
    }
    i = i + 1;
  }
  let width = 1;
  while (width < order.len()) {
    order = names_pass(names, order, width);
    width = if (width > order.len() / 2) { order.len() } else { width * 2 };
  }
  return Names { names: names, order: order, duplicate: duplicate_name(names, order) };
}

pub function position(ix: Names, name: string): i32 {
  let lo = 0;
  let hi = ix.order.len();
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2;
    let at = ix.order[mid];
    if (ix.names[at] == name) {
      return at;
    }
    if (before(ix.names[at], name)) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return -1;
}
