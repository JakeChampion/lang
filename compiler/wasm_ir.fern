  o = o + "  (func $__load_i32 (param $a i32) (result i32)\n";
  o = o + "    (i32.load (local.get $a)))\n";
  o = o + "  (func $__store_i32 (param $a i32) (param $v i32) (result i32)\n";
  o = o + "    (i32.store (local.get $a) (local.get $v))\n";
  o = o + "    (local.get $a))\n";
  o = o + "  (func $__fern_rc_inc (param $p i32) (result i32)\n";
  o = o + "    (local $rc i32)\n";
  o = o + "    (local $base i32)\n";
  o = o + "    (if (i32.eqz (local.get $p)) (then (return (local.get $p))))\n";
  o = o + "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (local.get $p))))\n";
  o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (local.get $p))))\n";
  o = o + "    (local.set $base (i32.and (local.get $p) (i32.const -3)))\n";
  o = o + "    (local.set $rc (i32.load (i32.sub (local.get $base) (i32.const 8))))\n";
  o = o + "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (local.get $p))))\n";
  o = o + "    (i32.store (i32.sub (local.get $base) (i32.const 8)) (i32.add (local.get $rc) (i32.const 1)))\n";
  o = o + "    (local.get $p))\n";
  o = o + "  (func $__fern_rc_dec (param $p i32) (result i32)\n";
  o = o + "    (local $rc i32)\n";
  o = o + "    (if (i32.eqz (local.get $p)) (then (return (local.get $p))))\n";
  o = o + "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (local.get $p))))\n";
  o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (local.get $p))))\n";
  o = o + "    (local.set $rc (i32.load (i32.sub (local.get $p) (i32.const 8))))\n";
  o = o + "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (local.get $p))))\n";
  o = o + "    (if (i32.le_s (local.get $rc) (i32.const 0))\n";
  o = o + "      (then (global.set $__fern_rc_underflow (i32.add (global.get $__fern_rc_underflow) (i32.const 1)))))\n";
  o = o + "    (i32.store (i32.sub (local.get $p) (i32.const 8)) (i32.sub (local.get $rc) (i32.const 1)))\n";
  o = o + "    (local.get $p))\n";
  o = o + "  (func $__fern_rc_is_unique (param $p i32) (result i32)\n";
  o = o + "    (local $rc i32)\n";
  o = o + "    (if (i32.eqz (local.get $p)) (then (return (i32.const 0))))\n";
  o = o + "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (i32.const 0))))\n";
  o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (i32.const 0))))\n";
  o = o + "    (local.set $p (i32.and (local.get $p) (i32.const -3)))\n";
  o = o + "    (local.set $rc (i32.load (i32.sub (local.get $p) (i32.const 8))))\n";
  o = o + "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (i32.const 0))))\n";
  o = o + "    (if (i32.eq (local.get $rc) (i32.const 1)) (then (return (i32.const 1))))\n";
  o = o + "    (i32.const 0))\n";
  o = o + "  (func $__fern_arr_inc_elems (param $a i32) (result i32)\n";
  o = o + "    (local $i i32) (local $n i32)\n";
  o = o + "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
  o = o + "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (local.get $a))))\n";
  o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + lo + ")) (then (return (local.get $a))))\n";
  o = o + "    (if (i32.lt_s (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 0)) (then (return (local.get $a))))\n";
  o = o + "    (local.set $n (i32.load (local.get $a)))\n";
  o = o + "    (local.set $i (i32.const 0))\n";
  o = o + "    (block $aie_done (loop $aie_lp\n";
  o = o + "      (br_if $aie_done (i32.ge_u (local.get $i) (local.get $n)))\n";
  o = o + "      (drop (call $__fern_rc_inc (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))))))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "      (br $aie_lp)))\n";
  o = o + "    (local.get $a))\n";
  o = o + "  (func $__fern_arr_own_elems (param $d i32) (param $s i32) (result i32)\n";
  o = o + "    (drop (call $__fern_arr_inc_elems (local.get $s)))\n";
  o = o + "    (local.get $d))\n";
  o = o + "  (func $__fern_rc_underflow_count (result i32)\n";
  o = o + "    (global.get $__fern_rc_underflow))\n";
  return o;
}

pub function arr_slice8_helper(): string {
  let o: string = "";
  o = o + "  (func $__fern_arr_slice8 (param $a i32) (param $start i32) (param $end i32) (result i32)\n";
  o = o + "    (local $n i32) (local $na i32) (local $i i32)\n";
  o = o + "    (if (i32.gt_u (local.get $end) (i32.load (local.get $a))) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (local.set $n (i32.sub (local.get $end) (local.get $start)))\n";
  o = o + "    (local.set $na (call $__fern_arr_elems (local.get $n) (i32.const 8)))\n";
  o = o + "    (i32.store (local.get $na) (local.get $n))\n";
  o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $n))\n";
  o = o + "    (local.set $i (i32.const 0))\n";
  o = o + "    (block $d (loop $c\n";
  o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
  o = o + "      (i64.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8))) (i64.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (i32.add (local.get $start) (local.get $i)) (i32.const 8)))))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "      (br $c)))\n";
  o = o + "    (local.get $na))\n";
  return o;
}

pub function bytes_owned_helper(empty: i32): string {
  let o: string = "  (func $__fern_bytes_owned (param $v i32) (result i32)\n";
  o = o + "    (local $n i32) (local $p i32) (local $r i32)\n";
  o = o + bytes_view_decode();
  o = o + bytes_copy_out("$n", "(local.get $p)", empty);
  return o;
}

pub function bytes_range_helper(empty: i32): string {
  let o: string = "  (func $__fern_bytes_range (param $v i32) (param $from i32) (param $to i32) (result i32)\n";
  o = o + "    (local $n i32) (local $p i32) (local $m i32) (local $r i32)\n";
  o = o + bytes_view_decode();
  o = o + "    (if (i32.lt_s (local.get $from) (i32.const 0)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (if (i32.lt_s (local.get $to) (local.get $from)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (if (i32.gt_s (local.get $to) (local.get $n)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (local.set $m (i32.sub (local.get $to) (local.get $from)))\n";
  o = o + bytes_copy_out("$m", "(i32.add (local.get $p) (local.get $from))", empty);
  return o;
}

pub function bytes_into_helper(): string {
  let o: string = "  (func $__fern_bytes_into (param $dst i32) (param $at i32) (param $v i32) (param $from i32) (param $m i32) (result i32)\n";
  o = o + "    (local $n i32) (local $p i32) (local $dn i32) (local $r i32)\n";
  o = o + bytes_view_decode();
  o = o + "    (local.set $dn (i32.load (local.get $dst)))\n";
  o = o + "    (if (i32.lt_s (local.get $m) (i32.const 0)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (if (i32.lt_s (local.get $at) (i32.const 0)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (if (i32.lt_s (local.get $from) (i32.const 0)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (if (i32.gt_s (local.get $at) (i32.sub (local.get $dn) (local.get $m))) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (if (i32.gt_s (local.get $from) (i32.sub (local.get $n) (local.get $m))) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (if (i32.eqz (local.get $m)) (then (return (local.get $dst))))\n";
  o = o + "    (if (i32.eqz (call $__fern_rc_is_unique (local.get $dst))) (then\n";
  o = o + "      (local.set $r (call $__fern_arr_elems (local.get $dn) (i32.const 1)))\n";
  o = o + "      (i32.store (local.get $r) (local.get $dn))\n";
  o = o + "      (i32.store offset=4 (local.get $r) (local.get $dn))\n";
  o = o + "      (memory.copy (i32.add (local.get $r) (i32.const 8)) (i32.add (local.get $dst) (i32.const 8)) (local.get $dn))\n";
  o = o + "      (drop (call $__fern_arr_dec (local.get $dst)))\n";
  o = o + "      (local.set $dst (local.get $r))))\n";
  o = o + "    (memory.copy (i32.add (i32.add (local.get $dst) (i32.const 8)) (local.get $at)) (i32.add (local.get $p) (local.get $from)) (local.get $m))\n";
  return o + "    (local.get $dst))\n";
}

function bytes_view_decode(): string {
  let o: string = "    (local.set $n (i32.load (i32.and (local.get $v) (i32.const -3))))\n";
  o = o + "    (local.set $p (i32.add (local.get $v) (i32.const 8)))\n";
  return o + "    (if (i32.and (local.get $v) (i32.const 2)) (then (local.set $p (i32.add (local.get $v) (i32.const 2)))))\n";
}

function bytes_copy_out(len: string, src: string, empty: i32): string {
  let o: string = "";
  if (empty >= 0) {
    o = "    (if (i32.eqz (local.get " + len + ")) (then (return (i32.const " + util.i32_to_string(empty) + "))))\n";
  }
  o = o + "    (local.set $r (call $__fern_arr_elems (local.get " + len + ") (i32.const 1)))\n";
  o = o + "    (i32.store (local.get $r) (local.get " + len + "))\n";
  o = o + "    (i32.store offset=4 (local.get $r) (local.get " + len + "))\n";
  o = o + "    (memory.copy (i32.add (local.get $r) (i32.const 8)) " + src + " (local.get " + len + "))\n";
  return o + "    (local.get $r))\n";
}

pub function arr_concat_helper(): string {
  let o: string = "";
  o = o + "  (func $__fern_arr_concat (param $width i32) (param $b i32) (param $a i32) (result i32)\n";
  o = o + "    (local $na i32) (local $nb i32) (local $n i32) (local $stride i32) (local $cap i32) (local $rc i32) (local $ncap i32) (local $r i32) (local $sole i32)\n";
  o = o + "    (local.set $stride (i32.shr_u (local.get $width) (i32.const 3)))\n";
  o = o + "    (local.set $na (i32.load (local.get $a)))\n";
  o = o + "    (local.set $nb (i32.load (local.get $b)))\n";
  o = o + "    (local.set $n (i32.add (local.get $na) (local.get $nb)))\n";
  o = o + "    (local.set $cap (i32.load (i32.add (local.get $a) (i32.const 4))))\n";
  o = o + "    (local.set $rc (i32.load (i32.sub (local.get $a) (i32.const 8))))\n";
  o = o + "    (local.set $sole (i32.eq (local.get $rc) (i32.const 1)))\n";
  o = o + "    (if (i32.and (local.get $sole) (i32.le_s (local.get $n) (local.get $cap))) (then\n";
  o = o + "      (memory.copy (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $na) (local.get $stride))) (i32.add (local.get $b) (i32.const 8)) (i32.mul (local.get $nb) (local.get $stride)))\n";
  o = o + "      (i32.store (local.get $a) (local.get $n))\n";
  o = o + "      (return (local.get $a))))\n";
  o = o + "    (local.set $ncap (local.get $n))\n";
  o = o + "    (if (local.get $sole) (then\n";
  o = o + "      (if (i32.gt_s (i32.mul (local.get $na) (i32.const 2)) (local.get $n)) (then (local.set $ncap (i32.mul (local.get $na) (i32.const 2)))))))\n";
  o = o + "    (local.set $r (call $__fern_arr_elems (local.get $ncap) (local.get $stride)))\n";
  o = o + "    (i32.store (local.get $r) (local.get $n))\n";
  o = o + "    (i32.store offset=4 (local.get $r) (local.get $ncap))\n";
  o = o + "    (memory.copy (i32.add (local.get $r) (i32.const 8)) (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $na) (local.get $stride)))\n";
  o = o + "    (memory.copy (i32.add (i32.add (local.get $r) (i32.const 8)) (i32.mul (local.get $na) (local.get $stride))) (i32.add (local.get $b) (i32.const 8)) (i32.mul (local.get $nb) (local.get $stride)))\n";
  o = o + "    (local.get $r))\n";
  return o;
}

pub function arr_slice_u8_helper(): string {
  let o: string = "";
  o = o + "  (func $__fern_arr_slice_u8 (param $a i32) (param $start i32) (param $end i32) (result i32)\n";
  o = o + "    (local $n i32) (local $na i32)\n";
  o = o + "    (if (i32.gt_u (local.get $end) (i32.load (local.get $a))) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o = o + "    (local.set $n (i32.sub (local.get $end) (local.get $start)))\n";
  o = o + "    (local.set $na (call $__fern_arr_elems (local.get $n) (i32.const 1)))\n";
  o = o + "    (i32.store (local.get $na) (local.get $n))\n";
  o = o + "    (i32.store offset=4 (local.get $na) (local.get $n))\n";
  o = o + "    (memory.copy (i32.add (local.get $na) (i32.const 8)) (i32.add (i32.add (local.get $a) (i32.const 8)) (local.get $start)) (local.get $n))\n";
  o = o + "    (local.get $na))\n";
  return o;
}

pub function arr_push_owned_helper(heap_base: i32): string {
  let hb: string = util.i32_to_string(heap_base);
  let o: string = "";
  o = o + "  (func $__fern_arr_push_owned (param $a i32) (param $v i32) (result i32)\n";
  o = o + "    (local $na i32) (local $rc i32)\n";
  o = o + "    (local.set $na (call $__fern_arr_push (local.get $a) (local.get $v)))\n";
  o = o + "    (if (i32.and (i32.ne (local.get $na) (local.get $a)) (i32.and (i32.ge_u (local.get $a) (i32.const " + hb + ")) (i32.eqz (i32.and (local.get $a) (i32.const 1))))) (then\n";
  o = o + "      (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
  o = o + "        (drop (call $__fern_arr_dec (local.get $a)))))))\n";
  o = o + "    (local.get $na))\n";
  return o;
}

pub function hex_digit(d: i32): string {
  if (d == 0) {
    return "0";
  } else if (d == 1) {
    return "1";
  } else if (d == 2) {
    return "2";
  } else if (d == 3) {
    return "3";
  } else if (d == 4) {
    return "4";
  } else if (d == 5) {
    return "5";
  } else if (d == 6) {
    return "6";
  } else if (d == 7) {
    return "7";
  } else if (d == 8) {
    return "8";
  } else if (d == 9) {
    return "9";
  } else if (d == 10) {
    return "a";
  } else if (d == 11) {
    return "b";
  } else if (d == 12) {
    return "c";
  } else if (d == 13) {
    return "d";
  } else if (d == 14) {
    return "e";
  } else {
    return "f";
  }
}

pub function wat_escape(s: string): string {
  let parts: string[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b >= 32 && b <= 126 && b != 34 && b != 92) {
      parts = parts.append(slice_unchecked(s, i, i + 1) + "");
    } else {
      parts = parts.append(byte_escape(b));
    }
    i = i + 1;
  }
  return util.str_join_chunks(parts);
}

pub function le32_escape(n: i32): string {
  let parts: string[] = [];
  let b: i32 = 0;
  while (b < 4) {
    parts = parts.append(byte_escape(n >> b * 8 & 255));
    b = b + 1;
  }
  return util.str_join_chunks(parts);
}

function byte_escape(v: i32): string {
  return "\\" + hex_digit(v / 16) + hex_digit(v % 16);
}

function const_agg_data(sv: string[], cv: string[], structs: irtables.StructTab, fn_table: string[]): string {
  let parts: string[] = [];
  let i: i32 = 0;
  while (i < cv.len()) {
    if (ir.const_struct_is_bytes(cv[i])) {
      parts = parts.append("  (data (i32.const " + util.i32_to_string(const_agg_offset(sv, cv, i)) + ") \"" + packed_byte_data(cv[i]) + "\")\n");
      i = i + 1;
      continue;
    }
    let vals: string[] = ir.const_struct_values(cv[i]);
    let body: string = le32_escape(0 - 1) + le32_escape(const_agg_block_bytes(cv[i]));
    let fnbody: string = ir.const_struct_fn_body(cv[i]);
    if (fnbody.len() > 0) {
      body = body + le32_escape(1) + le32_escape(1)
        + le32_escape(util.index_of_str(fn_table, fnbody)) + le32_escape(0);
    } else if (ir.const_struct_is_option(cv[i])) {
      body = body + le32_escape(util.lit_to_i32(vals[0])) + le32_escape(0);
    } else if (ir.const_struct_is_wide_array(cv[i])) {
      body = body + le32_escape(vals.len()) + le32_escape(vals.len());
      for v in vals {
        let w: i64 = util.lit_to_i64(v);
        body = body + le32_escape((w & 0xffffffff) as i32) + le32_escape((w >> 32) as i32);
      }
    } else if (ir.const_struct_is_array(cv[i])) {
      body = body + le32_escape(vals.len()) + le32_escape(vals.len());
      for v in vals {
        body = body + le32_escape(const_agg_field(sv, cv, v));
      }
      if (vals.len() % 2 == 1) {
        body = body + le32_escape(0);
      }
    } else {
      body = body + le32_escape(struct_type_id(structs, ir.const_struct_type(cv[i]))) + le32_escape(0);
      let vi: i32 = 0;
      while (vi < vals.len()) {
        if (ir.const_struct_ref(vals[vi]).len() == 0) {
          let w: i64 = util.lit_to_i64(vals[vi]);
          body = body + le32_escape((w & 0xffffffff) as i32) + le32_escape((w >> 32) as i32);
        } else {
          body = body + le32_escape(const_agg_field(sv, cv, vals[vi])) + le32_escape(0);
        }
        vi = vi + 1;
      }
    }
    parts = parts.append("  (data (i32.const " + util.i32_to_string(const_agg_offset(sv, cv, i)) + ") \"" + body + "\")\n");
    i = i + 1;
  }
  return util.str_join_chunks(parts);
}

function packed_byte_data(packed: string): string {
  let bs: u8[] = byteconst.values(ir.const_struct_payload(packed));
  let padded: i32 = (bs.len() + 7) / 8 * 8;
  let out: u8[] = __alloc_u8(padded * 3);
  let hex: string = "0123456789abcdef";
  let i: i32 = 0;
  while (i < padded) {
    let value: i32 = 0;
    if (i < bs.len()) {
      value = bs[i] as i32;
    }
    out = out.with(i * 3, 92 as u8);
    out = out.with(i * 3 + 1, hex[value >> 4]);
    out = out.with(i * 3 + 2, hex[value & 15]);
    i = i + 1;
  }
  return le32_escape(0 - 1) + le32_escape(16 + padded) + le32_escape(bs.len()) + le32_escape(bs.len()) + string_from_bytes_unchecked(out);
}

function const_agg_field(sv: string[], cv: string[], word: string): i32 {
  let inner: string = ir.const_struct_ref(word);
  if (ir.const_struct_is_str(inner)) {
    return offset_of_value(sv, ir.const_str_text(inner));
  }
  if (inner.len() > 0) {
    return const_agg_offset(sv, cv, util.index_of_str(cv, inner)) + 8;
  }
  return util.lit_to_i32(word);
}

pub function arr_push_i64_helper(): string {
  return arr_push_strided("_i64", "i64", "i64.store", 8);
}

pub function arr_push_owned_wide_helper(elem: string, vty: string, heap_base: i32): string {
  let hb: string = util.i32_to_string(heap_base);
  let o: string = "";
  o = o + "  (func $__fern_arr_push_owned_" + elem + " (param $a i32) (param $v " + vty + ") (result i32)\n";
  o = o + "    (local $na i32)\n";
  o = o + "    (local.set $na (call $__fern_arr_push_" + elem + " (local.get $a) (local.get $v)))\n";
  o = o + "    (if (i32.and (i32.ne (local.get $na) (local.get $a)) (i32.and (i32.ge_u (local.get $a) (i32.const " + hb + ")) (i32.eqz (i32.and (local.get $a) (i32.const 1))))) (then\n";
  o = o + "      (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
  o = o + "        (drop (call $__fern_arr_dec (local.get $a)))))))\n";
  o = o + "    (local.get $na))\n";
  return o;
}

pub function arr_push_f64_helper(): string {
  return arr_push_strided("_f64", "f64", "f64.store", 8);
}

pub function arr_push_u8_helper(): string {
  return arr_push_strided("_u8", "i32", "i32.store8", 1);
}

pub function arr_push_strided(suffix: string, vty: string, sop: string, stride: i32): string {
  let st: string = util.i32_to_string(stride);
  let o: string = "";
  o = o + "  (func $__fern_arr_push" + suffix + " (param $a i32) (param $v " + vty + ") (result i32)\n";
  o = o + "    (local $len i32) (local $cap i32) (local $na i32) (local $ncap i32) (local $rc i32)\n";
  o = o + "    (local.set $len (i32.load (local.get $a)))\n";
  o = o + "    (local.set $cap (i32.load (i32.add (local.get $a) (i32.const 4))))\n";
  o = o + "    (local.set $rc (i32.load (i32.sub (local.get $a) (i32.const 8))))\n";
  o = o + "    (if (i32.and (i32.or (i32.eq (local.get $rc) (i32.const 1)) (i32.lt_s (local.get $rc) (i32.const 0))) (i32.lt_s (local.get $len) (local.get $cap))) (then\n";
  o = o + "      (" + sop + " (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $len) (i32.const " + st + "))) (local.get $v))\n";
  o = o + "      (i32.store (local.get $a) (i32.add (local.get $len) (i32.const 1)))\n";
  o = o + "      (return (local.get $a))))\n";
  o = o + "    (local.set $ncap (local.get $cap))\n";
  o = o + "    (if (i32.lt_s (local.get $len) (local.get $cap)) (then\n";
  o = o + "      (i32.store (i32.const " + util.i32_to_string(arr_push_shared_addr()) + ") (i32.add (i32.load (i32.const " + util.i32_to_string(arr_push_shared_addr()) + ")) (i32.const 1)))\n";
  o = o + "      (i64.store (i32.const " + util.i32_to_string(arr_push_copied_addr()) + ") (i64.add (i64.load (i32.const " + util.i32_to_string(arr_push_copied_addr()) + ")) (i64.extend_i32_u (i32.mul (local.get $len) (i32.const " + st + ")))))))\n";
  o = o + "    (if (i32.ge_s (local.get $len) (local.get $cap)) (then\n";
  o = o + "      (local.set $ncap (i32.const 4))\n";
  o = o + "      (if (i32.gt_s (local.get $cap) (i32.const 0)) (then (local.set $ncap (i32.mul (local.get $cap) (i32.const 2)))))))\n";
  o = o + "    (local.set $na (call $__fern_arr_elems (local.get $ncap) (i32.const " + st + ")))\n";
  o = o + "    (i32.store (local.get $na) (i32.add (local.get $len) (i32.const 1)))\n";
  o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $ncap))\n";
  o = o + "    (memory.copy (i32.add (local.get $na) (i32.const 8)) (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $len) (i32.const " + st + ")))\n";
  o = o + "    (" + sop + " (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $len) (i32.const " + st + "))) (local.get $v))\n";
  o = o + "    (local.get $na))\n";
  return o;
}

function p1_file_io(needs: string[]): boolean {
  return need_any(needs, ["read_file", "read_file_bytes", "write_file", "write_file_bytes", "truncate"]) || need_dir_list(needs) || need_open_file(needs);
}

function p1_fd_read(needs: string[]): boolean {
  return p1_file_io(needs) || need_fd_read(needs);
}

function preview1_imports(needs: string[], lc: boolean): string {
  let parts: string[] = [];
  if (lc) {
    parts = parts.append("  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $__fern_proc_exit_raw (param i32)))\n");
  } else {
    parts = parts.append("  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $__fern_proc_exit (param i32)))\n");
  }
  if (need(needs, "@uses_random")) {
    parts = parts.append(random_get_import());
  }
  if (lc || needs_abort(needs) || need(needs, "print_str") || need(needs, "eprint_str") || need(needs, "putchar") || (need(needs, "write_file") || need(needs, "write_file_bytes")) || need(needs, "writer_write") || (need(needs, "write_some") || need(needs, "write_bytes") || need(needs, "write_some_bytes"))) {
    parts = parts.append("  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $__fern_fd_write (param i32 i32 i32 i32) (result i32)))\n");
  }
  if (p1_file_io(needs)) {
    parts = parts.append(file_imports());
  }
  if (need_dir_list(needs)) {
    parts = parts.append(readdir_fd_import());
  }
  if (need_fd_read(needs) && !p1_file_io(needs)) {
    parts = parts.append(stdin_fd_read_import());
  }
  if (p1_fd_read(needs)) {
    parts = parts.append(fd_fdstat_get_import());
  }
  if (need(needs, "reader_close") && !p1_file_io(needs)) {
    parts = parts.append(reader_fd_close_import());
  }
  if (need(needs, "monotonic_ns") || need(needs, "now_unix_ms") || need(needs, "now_ns")) {
    parts = parts.append("  (import \"wasi_snapshot_preview1\" \"clock_time_get\" (func $__fern_clock_time_get (param i32 i64 i32) (result i32)))\n");
  }
  if (need(needs, "clock_resolution")) {
    parts = parts.append("  (import \"wasi_snapshot_preview1\" \"clock_res_get\" (func $__fern_clock_res_get (param i32 i32) (result i32)))\n");
  }
  if (need(needs, "args")) {
    parts = parts.append(args_helpers());
  }
  if (need(needs, "env") || need(needs, "environ")) {
    parts = parts.append(env_helpers());
  }
  if (need(needs, "stat") || need(needs, "lstat")) {
    parts = parts.append(stat_import());
  }
  if (need(needs, "fd_stat") || need(needs, "reader_seek")) {
    parts = parts.append(fd_stat_import());
  }
  if (need(needs, "fd_fsync")) {
    parts = parts.append(fd_sync_import());
  }
  if (need(needs, "fd_fdatasync")) {
    parts = parts.append(fd_datasync_import());
  }
  if (need(needs, "fd_drop_cache")) {
    parts = parts.append(fd_advise_import());
  }
  if (need(needs, "reader_seek")) {
    parts = parts.append(fd_seek_import());
  }
  if (need(needs, "fd_flags") && !p1_fd_read(needs)) {
    parts = parts.append(fd_fdstat_get_import());
  }
  if (need(needs, "remove_file") || need(needs, "remove_dir_all")) {
    parts = parts.append(remove_file_import());
  }
  if (need(needs, "remove_dir_all")) {
    parts = parts.append(remove_dir_import());
  }
  if (need(needs, "temp_dir") || need(needs, "create_dir_all") || need(needs, "create_dir")) {
    parts = parts.append(temp_dir_import());
  }
  if (need(needs, "remove_dir") && !need(needs, "remove_dir_all")) {
    parts = parts.append(remove_dir_import());
  }
  if (need(needs, "create_link")) {
    parts = parts.append(link_import());
  }
  if (need(needs, "create_symlink")) {
    parts = parts.append(symlink_import());
  }
  if (need(needs, "rename")) {
    parts = parts.append(rename_import());
  }
  if (need(needs, "read_link")) {
    parts = parts.append(readlink_import());
  }
  if (need(needs, "set_file_times")) {
    parts = parts.append(set_file_times_import());
  }
  if (need(needs, "truncate") || need(needs, "writer_truncate")) {
    parts = parts.append(truncate_import());
  }
  if (need(needs, "sleep_ms") || need(needs, "sleep_ns")) {
    parts = parts.append(sleep_ms_import());
  }
  parts = parts.append(preview2_wasi_imports(needs, false));
  return util.str_join_chunks(parts);
}

function preview2_wasi_imports(needs: string[], sleep_p2: boolean): string {
  let parts: string[] = [];
  if (need_any(needs, ["tcp_connect_with", "tcp_close", "tcp_listen", "tcp_listen_with", "tcp_accept", "tcp_pollable"]) || need_udp_socket(needs)) {
    parts = parts.append(wasi_instance_network_import());
  }
  if (need_any(needs, ["tcp_connect_with", "tcp_close", "tcp_listen", "tcp_listen_with", "tcp_accept", "tcp_pollable", "tcp_socket_ctl", "reactor_ctl"])) {
    parts = parts.append(wasi_sockets_imports());
  }
  if (need_any(needs, ["tcp_send_bytes", "tcp_send_buf", "tcp_recv_into"])) {
    parts = parts.append(wasi_stream_io_imports());
  }
  if (need(needs, "reactor_ctl")) {
    parts = parts.append(wasi_stream_subscribe_imports());
  } else if (need(needs, "tcp_pollable")) {
    parts = parts.append(wasi_input_stream_subscribe_import());
  }
  if (need(needs, "tcp_recv_into")) {
    parts = parts.append(wasi_stream_read_import());
  }
  if (need_any(needs, ["tcp_listen", "tcp_listen_with", "tcp_accept"])) {
    parts = parts.append(wasi_sockets_server_imports());
  }
  if (need(needs, "tcp_listen_with")) {
    parts = parts.append(wasi_sockets_backlog_import());
  }
  if (need(needs, "tcp_socket_ctl")) {
    parts = parts.append(wasi_sockets_socket_ctl_imports());
  }
  if (need(needs, "tcp_local_port") || need(needs, "tcp_socket_ctl")) {
    parts = parts.append(wasi_sockets_local_address_import());
  }
  if ((need(needs, "tcp_local_port") || need(needs, "tcp_socket_ctl")) && need(needs, "udp_bind")) {
    parts = parts.append(wasi_udp_local_address_import());
  }
  if (need(needs, "tcp_socket_ctl") && need(needs, "udp_bind")) {
    parts = parts.append(wasi_udp_remote_address_import());
  }
  if (need_udp_socket(needs)) {
    parts = parts.append(wasi_udp_socket_imports());
  }
  if (need_udp_send(needs)) {
    parts = parts.append(wasi_udp_send_imports());
  }
  if (need(needs, "udp_recvfrom")) {
    parts = parts.append(wasi_udp_recv_imports());
  }
  if (need_udp_send(needs) || need(needs, "reactor_ctl")) {
    parts = parts.append(wasi_udp_out_subscribe_import());
  }
  if (need(needs, "udp_recvfrom") || need(needs, "reactor_ctl") || need(needs, "tcp_pollable") && need_udp_socket(needs)) {
    parts = parts.append(wasi_udp_in_subscribe_import());
  }
  let udp_waits: boolean = need_udp_send(needs) || need(needs, "udp_recvfrom");
  let connects: boolean = need(needs, "tcp_connect_with") || need(needs, "tcp_accept");
  let sleeps: boolean = sleep_p2 && need_any(needs, ["sleep_ms", "sleep_ns"]);
  if (need_any(needs, ["wasm_timer_pollable", "poll", "reactor_wait"]) || sleeps) {
    parts = parts.append(wasi_subscribe_duration_import());
  }
  if (need(needs, "wasm_block") || udp_waits || connects || sleeps) {
    parts = parts.append(wasi_pollable_block_import());
  }
  if (need_any(needs, ["wasm_pollable_drop", "reactor_ctl", "reactor_wait", "poll"]) || udp_waits || connects || sleeps) {
    parts = parts.append(wasi_pollable_drop_import());
  }
  if (need_any(needs, ["wasm_poll", "poll", "reactor_wait"])) {
    parts = parts.append(wasi_poll_import());
  }
  return util.str_join_chunks(parts);
}

pub struct WasmUnit {
  ns: string,
  text: string,
  strs: string[],
  caggs: string[],
  fns: string[],
}

pub function unit_strs(units: WasmUnit[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < units.len()) {
    let j: i32 = 0;
    while (j < units[i].strs.len()) {
      out = out.append(units[i].strs[j]);
      j = j + 1;
    }
    i = i + 1;
  }
  return out;
}

pub function unit_caggs(units: WasmUnit[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < units.len()) {
    let j: i32 = 0;
    while (j < units[i].caggs.len()) {
      out = out.append(units[i].caggs[j]);
      j = j + 1;
    }
    i = i + 1;
  }
  return out;
}

pub function unit_fns(units: WasmUnit[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < units.len()) {
    let j: i32 = 0;
    while (j < units[i].fns.len()) {
      out = out.append(units[i].fns[j]);
      j = j + 1;
    }
    i = i + 1;
  }
  return out;
}

pub function unit_ns_list(units: WasmUnit[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < units.len()) {
    out = out.append(units[i].ns);
    i = i + 1;
  }
  return out;
}

pub function unit_fn_counts(units: WasmUnit[]): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < units.len()) {
    out = out.append(units[i].fns.len());
    i = i + 1;
  }
  return out;
}

function kernel_helper_parts(needs: string[], parts0: string[]): string[] {
  let parts: string[] = parts0;
  if (need(needs, "@uses_memchr")) {
    parts = parts.append(memchr_helper());
  }
  if (need(needs, "@uses_count_byte_bytes")) {
    parts = parts.append(count_byte_bytes_helper());
  }
  if (need(needs, "@uses_sum_bytes_array")) {
    parts = parts.append(byte_reduction_helper(false));
  }
  if (need(needs, "@uses_bsd_sum_bytes")) {
    parts = parts.append(byte_reduction_helper(true));
  }
  if (need(needs, "@uses_memchr_bytes")) {
    parts = parts.append(memchr_bytes_helper());
  }
  if (need(needs, "@uses_rmemchr_bytes")) {
    parts = parts.append(rmemchr_bytes_helper());
  }
  if (need(needs, "@uses_count_runs_bytes")) {
    parts = parts.append(count_runs_bytes_helper());
  }
  if (need(needs, "@uses_scan_set_bytes")) {
    parts = parts.append(scan_set_bytes_helper());
  }
  if (need(needs, "@uses_mismatch_bytes")) {
    parts = parts.append(mismatch_bytes_helper());
  }
  if (need(needs, "@uses_mismatch_bytes_str")) {
    parts = parts.append(mismatch_bytes_str_helper());
  }
  if (need(needs, "@uses_rmemchr")) {
    parts = parts.append(rmemchr_helper());
  }
  if (need(needs, "@uses_mismatch")) {
    parts = parts.append(mismatch_helper());
  }
  if (need(needs, "@uses_count_byte")) {
    parts = parts.append(count_byte_helper());
  }
  if (need(needs, "@uses_sum_bytes")) {
    parts = parts.append(sum_bytes_helper());
  }
  if (need(needs, "@uses_scan_set")) {
    parts = parts.append(scan_set_helper());
  }
  if (need(needs, "@uses_count_runs")) {
    parts = parts.append(count_runs_helper());
  }
  if (need(needs, "@uses_bsd_sum")) {
    parts = parts.append(bsd_sum_helper());
  }
  if (need(needs, "@uses_str_hash")) {
    parts = parts.append(str_hash_helper());
  }
  if (need(needs, "@uses_scale_f64")) {
    parts = parts.append(scale_f64_helper());
  }
  if (need(needs, "@uses_outer_mul_f64")) {
    parts = parts.append(outer_mul_f64_helper());
  }
  if (need(needs, "@uses_inner_mul_add_f64")) {
    parts = parts.append(inner_mul_add_f64_helper());
  }
  return parts;
}

function path_fs_bodies(parts: string[], needs: string[], mode: i32): string[] {
  if (need(needs, "stat")) {
    parts = parts.append(stat_func());
  }
  if (need(needs, "lstat")) {
    parts = parts.append(lstat_func());
  }
  if (need(needs, "remove_file")) {
    parts = parts.append(remove_file_func());
  }
  if (need(needs, "create_dir_all")) {
    parts = parts.append(create_dir_all_func());
  }
  if (need(needs, "create_dir")) {
    parts = parts.append(create_dir_func());
  }
  if (need(needs, "remove_dir")) {
    parts = parts.append(remove_dir_func());
  }
  if (need(needs, "create_link")) {
    parts = parts.append(create_link_func());
  }
  if (need(needs, "create_symlink")) {
    parts = parts.append(create_symlink_func());
  }
  if (need(needs, "rename")) {
    parts = parts.append(rename_func());
  }
  if (need(needs, "read_link")) {
    parts = parts.append(read_link_func());
  }
  if (need(needs, "set_file_times")) {
    parts = parts.append(set_file_times_func());
  }
  if (need(needs, "truncate")) {
    parts = parts.append(truncate_body(mode));
  }
  for name in ["read_dir", "read_dir_all", "read_dir_ino", "read_dir_ino_all"] {
    if (need(needs, name)) {
      parts = parts.append(read_dir_body("__fern_" + name, mode));
    }
  }
  if (mode != 2 && (need(needs, "read_dir_ino") || need(needs, "read_dir_ino_all"))) {
    parts = parts.append(wasi_kind_func());
  }
  if (need(needs, "remove_dir_all")) {
    parts = parts.append(remove_dir_all_func(mode == 2));
  }
  if (need(needs, "temp_dir")) {
    parts = parts.append(temp_dir_func());
  }
  return parts;
}

pub function emit_ir_module_units(units: WasmUnit[], mod: parser.Module, needs: string[], fn_sigs: string[], mode: i32, sw: asmcore.Switches): string {
  let lc: boolean = census_on(sw);
  needs = runtime_needs(mod, needs);
  let reports_abort: boolean = mode != 1 && needs_abort(needs);
  let stab: irtables.StructTab = irtables.struct_tab(mod.structs);
  let parts: string[] = [];
  parts = parts.append("(module\n");
  if (mode == 0) {
    parts = parts.append(preview1_imports(needs, lc));
  }
  let stderr: boolean = component_uses_stderr(mod, needs) || lc;
  if (mode == 2) {
    parts = parts.append(component_io_imports(needs, stderr, module_is_proxy(mod)));
    parts = parts.append(preview2_wasi_imports(needs, true));
  }
  parts = parts.append(extern_imports(mod));
  parts = parts.append(async_lower_imports(mod));
  if (lifts_async(mod, mode)) {
    parts = parts.append(async_lift_imports(mod));
  }
  let sv: string[] = unit_strs(units);
  let abort_offsets: i32[] = [];
  if (reports_abort) {
    for text in wasm_abort.texts() {
      let at: i32 = sv.len();
      sv = sv.append(text);
      abort_offsets = abort_offsets.append(str_offset(sv, at));
    }
  }
  if (needs_io_error(needs)) {
    sv = with_strerror_texts(sv);
  }
  let cv: string[] = unit_caggs(units);
  parts = parts.append(wasm_abort.helpers(abort_offsets, mode));
  parts = parts.append("  (memory (export \"memory\") " + util.i32_to_string(memory_min_pages(sv, cv)) + ")\n");
  if (sv.len() > 0) {
    let sbi: i32 = 0;
    let sbstart: i32 = 0;
    while (sbi < units.len()) {
      parts = parts.append("  (global " + str_base_global(units[sbi].ns) + " i32 (i32.const "
        + util.i32_to_string(str_offset(sv, sbstart)) + "))\n");
      sbstart = sbstart + units[sbi].strs.len();
      sbi = sbi + 1;
    }
  }
  parts = parts.append(tid_globals_section(stab));
  let di: i32 = 0;
  while (di < sv.len()) {
    parts = parts.append("  (data (i32.const " + util.i32_to_string(str_offset(sv, di)) + ") \""
      + le32_escape(sv[di].len()) + wat_escape(sv[di]) + "\")\n");
    di = di + 1;
  }
  if (cv.len() > 0) {
    let kbi: i32 = 0;
    let kbstart: i32 = 0;
    while (kbi < units.len()) {
      parts = parts.append("  (global " + cagg_base_global(units[kbi].ns) + " i32 (i32.const "
        + util.i32_to_string(const_agg_offset(sv, cv, kbstart)) + "))\n");
      kbstart = kbstart + units[kbi].caggs.len();
      kbi = kbi + 1;
    }
  }
  parts = parts.append(const_agg_data(sv, cv, stab, unit_fns(units)));
  parts = parts.append(lc_globals(lc));
  if (need(needs, "@ret_word")) {
    parts = parts.append("  (global $__fern_ret_word (mut i32) (i32.const 0))\n");
    let slot: i32 = 0;
    while (slot < 3) {
      parts = parts.append("  (global $__fern_scalar_word" + util.i32_to_string(slot) + " (mut i64) (i64.const 0))\n");
      slot = slot + 1;
    }
  }
  if (mode == 2 || module_extern_needs_heap(mod) || needs_fd_sync(needs) || need_open_file(needs) || need_any(needs, [
