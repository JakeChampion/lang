  o += "            (i32.store8 offset=19 (local.get $dg) (i32.load offset=12 (local.get $flat)))\n";
  o += "            (i32.store8 offset=20 (local.get $dg) (i32.load offset=16 (local.get $flat)))\n";
  o += "            (i32.store8 offset=21 (local.get $dg) (i32.load offset=20 (local.get $flat))))))\n";
  o += "      (else (i32.store offset=8 (local.get $dg) (i32.const 0))))\n";
  o += "    (block $done\n";
  o += "      (loop $again\n";
