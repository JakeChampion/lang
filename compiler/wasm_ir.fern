}

pub function buf_helpers(needs: string[]): string {
  let o = "";
  if (need(needs, "buf_new")) {
    o += "  (func $__fern_buf_new (param $cap i32) (result i32)\n";
    o += "    (local $h i32)\n";
    o += "    (if (i32.lt_u (local.get $cap) (i32.const 16)) (then (local.set $cap (i32.const 16))))\n";
    o += "    (local.set $h (call $__fern_str_box (i32.const 16)))\n";
    o += "    (i32.store (local.get $h) (call $__fern_str_box (i32.add (i32.const 4) (local.get $cap))))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.const 0))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 8)) (local.get $cap))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 12)) (local.get $cap))\n";
    o += "    (local.get $h))\n";
  }
  if (need_any(needs, ["buf_push", "buf_push_range", "buf_push_mapped", "buf_push_filtered", "buf_push_expanded", "buf_push_bytes_mapped", "buf_push_bytes_filtered", "buf_push_bytes_expanded", "buf_push_byte", "buf_push_u64", "buf_push_decimal", "buf_push_base64", "buf_push_base32", "buf_decode_base32", "buf_push_bytes_range"])) {
    o += "  (func $__fern_buf_reserve (param $h i32) (param $need i32)\n";
    o += "    (local $ncap i32) (local $np i32) (local $i i32) (local $len i32) (local $old i32)\n";
    o += "    (local.set $ncap (i32.load (i32.add (local.get $h) (i32.const 8))))\n";
    o += "    (if (i32.eqz (local.get $ncap)) (then (local.set $ncap (i32.load (i32.add (local.get $h) (i32.const 12))))))\n";
    o += "    (if (i32.eqz (local.get $ncap)) (then (local.set $ncap (i32.const 64))))\n";
    o += "    (block $gd (loop $gl (br_if $gd (i32.ge_u (local.get $ncap) (local.get $need))) (local.set $ncap (i32.mul (local.get $ncap) (i32.const 2))) (br $gl)))\n";
    o += "    (local.set $np (call $__fern_str_box (i32.add (i32.const 4) (local.get $ncap))))\n";
    o += "    (local.set $old (i32.load (local.get $h)))\n";
    o += "    (local.set $len (i32.load (i32.add (local.get $h) (i32.const 4))))\n";
    o += "    (local.set $i (i32.const 0))\n";
    o += "    (block $cd (loop $cl (br_if $cd (i32.ge_u (local.get $i) (local.get $len)))\n";
    o += "      (i32.store8 (i32.add (i32.add (local.get $np) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $old) (i32.const 4)) (local.get $i))))\n";
    o += "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $cl)))\n";
    o += "    (if (local.get $old) (then (drop (call $__fern_arr_dec (local.get $old)))))\n";
    o += "    (i32.store (local.get $h) (local.get $np))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 8)) (local.get $ncap)))\n";
  }
  if (need(needs, "buf_push")) {
    o += "  (func $__fern_buf_push (param $h i32) (param $s i32)\n";
    o += "    (local $sl i32) (local $i i32) (local $d i32) (local $len i32)\n";
    o += "    (local.set $sl (i32.load (local.get $s)))\n";
    o += "    (if (i32.eqz (local.get $sl)) (then (return)))\n";
    o += "    (local.set $len (i32.load (i32.add (local.get $h) (i32.const 4))))\n";
    o += "    (if (i32.gt_u (i32.add (local.get $len) (local.get $sl)) (i32.load (i32.add (local.get $h) (i32.const 8))))\n";
    o += "      (then (call $__fern_buf_reserve (local.get $h) (i32.add (local.get $len) (local.get $sl)))))\n";
    o += "    (local.set $d (i32.add (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $len)))\n";
    o += "    (local.set $i (i32.const 0))\n";
    o += "    (block $ad (loop $al (br_if $ad (i32.ge_u (local.get $i) (local.get $sl)))\n";
    o += "      (i32.store8 (i32.add (local.get $d) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o += "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $al)))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.add (local.get $len) (local.get $sl))))\n";
  }
  if (need(needs, "buf_push_range")) {
    o += "  (func $__fern_buf_push_range (param $h i32) (param $s i32) (param $lo i32) (param $hi i32)\n";
    o += "    (local $n i32) (local $len i32)\n";
    o += "    (if (i32.or (i32.or (i32.lt_s (local.get $lo) (i32.const 0)) (i32.gt_s (local.get $hi) (i32.load (local.get $s)))) (i32.gt_s (local.get $lo) (local.get $hi))) (then (call $__fern_abort_slice) (unreachable)))\n";
    o += "    (local.set $n (i32.sub (local.get $hi) (local.get $lo)))\n";
    o += "    (if (i32.eqz (local.get $n)) (then (return)))\n";
    o += "    (local.set $len (i32.load (i32.add (local.get $h) (i32.const 4))))\n";
    o += "    (if (i32.gt_u (i32.add (local.get $len) (local.get $n)) (i32.load (i32.add (local.get $h) (i32.const 8))))\n";
    o += "      (then (call $__fern_buf_reserve (local.get $h) (i32.add (local.get $len) (local.get $n)))))\n";
    o += "    (memory.copy (i32.add (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $len)) (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $lo)) (local.get $n))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.add (local.get $len) (local.get $n))))\n";
  }
  o += buf_table_helpers(needs, false);
  o += buf_table_helpers(needs, true);
  if (need_any(needs, ["buf_push_byte", "buf_decode_base32"])) {
    o += "  (func $__fern_buf_push_byte (param $h i32) (param $x i32)\n";
    o += "    (local $len i32)\n";
    o += "    (local.set $len (i32.load (i32.add (local.get $h) (i32.const 4))))\n";
    o += "    (if (i32.gt_u (i32.add (local.get $len) (i32.const 1)) (i32.load (i32.add (local.get $h) (i32.const 8))))\n";
    o += "      (then (call $__fern_buf_reserve (local.get $h) (i32.add (local.get $len) (i32.const 1)))))\n";
    o += "    (i32.store8 (i32.add (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $len)) (local.get $x))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.add (local.get $len) (i32.const 1))))\n";
  }
  if (need(needs, "buf_push_u64")) {
    o += "  (func $__fern_buf_push_u64 (param $h i32) (param $v i64)\n";
    o += "    (local $len i32)\n";
    o += "    (local.set $len (i32.load (i32.add (local.get $h) (i32.const 4))))\n";
    o += "    (if (i32.gt_u (i32.add (local.get $len) (i32.const 8)) (i32.load (i32.add (local.get $h) (i32.const 8))))\n";
    o += "      (then (call $__fern_buf_reserve (local.get $h) (i32.add (local.get $len) (i32.const 8)))))\n";
    o += "    (i64.store (i32.add (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $len)) (local.get $v))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.add (local.get $len) (i32.const 8))))\n";
  }
  if (need(needs, "buf_push_decimal")) {
    o += "  (func $__fern_buf_push_decimal (param $h i32) (param $v i64)\n";
    o += "    (local $n i32) (local $len i32) (local $p i32) (local $t i64)\n";
    o += "    (local.set $n (i32.const 1)) (local.set $t (local.get $v))\n";
    o += "    (block $cd (loop $cl (br_if $cd (i64.lt_u (local.get $t) (i64.const 10)))\n";
    o += "      (local.set $t (i64.div_u (local.get $t) (i64.const 10))) (local.set $n (i32.add (local.get $n) (i32.const 1))) (br $cl)))\n";
    o += "    (local.set $len (i32.load (i32.add (local.get $h) (i32.const 4))))\n";
    o += "    (if (i32.gt_u (i32.add (local.get $len) (local.get $n)) (i32.load (i32.add (local.get $h) (i32.const 8))))\n";
    o += "      (then (call $__fern_buf_reserve (local.get $h) (i32.add (local.get $len) (local.get $n)))))\n";
    o += "    (local.set $p (i32.add (i32.add (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $len)) (local.get $n)))\n";
    o += "    (loop $dl\n";
    o += "      (local.set $p (i32.sub (local.get $p) (i32.const 1)))\n";
    o += "      (i32.store8 (local.get $p) (i32.add (i32.wrap_i64 (i64.rem_u (local.get $v) (i64.const 10))) (i32.const 48)))\n";
    o += "      (local.set $v (i64.div_u (local.get $v) (i64.const 10)))\n";
    o += "      (br_if $dl (i64.ne (local.get $v) (i64.const 0))))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.add (local.get $len) (local.get $n))))\n";
  }
  if (need(needs, "buf_push_base64")) {
    o += buf_push_base64_helper();
  }
  if (need(needs, "buf_push_base32")) {
    o += buf_push_base32_helper();
  }
  if (need(needs, "buf_decode_base32")) {
    o += buf_decode_base32_helper();
  }
  if (need(needs, "buf_len")) {
    o += "  (func $__fern_buf_len (param $h i32) (result i32)\n";
    o += "    (i32.load (i32.add (local.get $h) (i32.const 4))))\n";
  }
  if (need(needs, "buf_clear")) {
    o += "  (func $__fern_buf_clear (param $h i32)\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.const 0)))\n";
  }
  if (need(needs, "buf_take")) {
    o += buf_text_helpers();
  }
  if (need(needs, "buf_free")) {
    o += "  (func $__fern_buf_free (param $h i32)\n";
