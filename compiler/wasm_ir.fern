  }
  o += "    (i32.const 0))\n";
  return o;
}

function desc_shim(name: string, extra: string, files: boolean, method: string, args: string, bytes: string, code_off: string): string {
  let stat = name == "fd_filestat_get";
  let o = "  (func $__fern_" + name + " (param $fd i32) " + extra + " (result i32)\n";
  o += "    (local $slot i32) (local $ra i32) (local $err i32)\n";
  o += "    (local.set $slot (call $__fern_fdt_slot (local.get $fd)))\n";
  o += "    (if (i32.eqz (local.get $slot)) (then (return (i32.const 8))))\n";
  let stdio = refused_errno();
  if (stat) {
    o += "    (memory.fill (local.get $buf) (i32.const 0) (i32.const 64))\n";
    stdio = "(i32.const 0)";
  }
  if (!files) {
    return o + "    " + stdio + ")\n";
  }
  o = o + "    (if (i32.eq (i32.load offset=8 (local.get $slot)) (i32.const -1)) (then (return " + stdio + ")))\n";
  o = o + "    (local.set $ra (call $__fern_alloc (i32.const " + bytes + ")))\n";
  o = o + "    (call $__fern_" + method + " (i32.load offset=8 (local.get $slot))" + args + " (local.get $ra))\n";
  o += p2_fail_ret(code_off, bytes);
  if (stat) {
    o += "    (call $__fern_filestat_p2 (local.get $ra) (local.get $buf))\n";
  }
  return o + p2_ok_ret(bytes);
}

