    parts = parts.append("    call $" + o.str + "\n");
  } else if (o.kind_tag == ir.K_DYN_DISPATCH) {
    parts = parts.append(emit_dyn_dispatch_wat(o, structs, funcs));
  } else if (o.kind_tag == ir.K_DYN_BOX) {
    parts = emit_wasm_dyn_box(arrtmp, eltmp, f64tmp, i64tmp, o, parts);
  } else if (o.kind_tag == ir.K_CONST_FUNC) {
    parts = parts.append("    global.get " + fn_base_global(ns) + "\n    i32.const " + util.i32_to_string(util.index_of_str(fn_table, o.str) - fn_table_base()) + "\n    i32.add\n");
  } else if (o.kind_tag == ir.K_CALL_INDIRECT) {
    parts = emit_wasm_call_indirect(o, parts);
  } else if (o.kind_tag == ir.K_MULHI_U) {
    parts = parts.append("    call $__fern_mulhi_u64\n");
  } else if (o.kind_tag == ir.K_MULHI_S) {
    parts = parts.append("    call $__fern_mulhi_s64\n");
  } else if (o.kind_tag >= ir.K_DIR_OPEN && o.kind_tag <= ir.K_DIR_OPEN_FILE) {
    parts = parts.append("    unreachable\n");
  } else {
    parts = parts.append("    " + wasm_binop_w(o.kind_tag, o.width) + "\n");
  }
  return util.str_join_chunks(parts);
}

function emit_str_op_wat(o: ir.Op): string {
  if (o.kind_tag == ir.K_RET_WORD || o.kind_tag == ir.K_CALL_WORD) {
    let name = "$__fern_ret_word";
    if (o.width == 64) {
      name = "$__fern_scalar_word" + util.i32_to_string(o.i32_imm);
    } else if (o.i32_imm > 0) {
      name += util.i32_to_string(o.i32_imm);
    }
    if (o.kind_tag == ir.K_CALL_WORD) {
      return "    global.get " + name + "\n";
    }
    return "    global.set " + name + "\n    i32.const 0\n";
  }
  if (o.kind_tag == ir.K_ARR_RESERVE) {
    let stride = 4;
    if (o.width == 8) {
      stride = 1;
    } else if (o.width == 64) {
      stride = 8;
    }
    return "    i32.const " + util.i32_to_string(stride) + "\n    call $__fern_arr_reserve\n";
  }
  if (o.kind_tag == ir.K_OUTER_MUL_F64) {
    return "    call $__fern_outer_mul_f64\n";
  }
  if (o.kind_tag == ir.K_INNER_MUL_ADD_F64) {
    return "    call $__fern_inner_mul_add_f64\n";
  }
  if (o.kind_tag == ir.K_COUNT_BYTE_BYTES) {
    return "    call $__fern_count_byte_bytes\n";
  }
  if (o.kind_tag == ir.K_COUNT_BELOW_U64) {
    return "    call $__fern_count_below_u64\n";
  }
  if (o.kind_tag == ir.K_SUM_BYTES_ARRAY) {
    return "    call $__fern_sum_bytes_array\n";
  }
  if (o.kind_tag == ir.K_BSD_SUM_BYTES) {
    return "    call $__fern_bsd_sum_bytes\n";
  }
  if (o.kind_tag == ir.K_MEMCHR_BYTES) {
    return "    call $__fern_memchr_bytes\n";
  }
  if (o.kind_tag == ir.K_RMEMCHR_BYTES) {
    return "    call $__fern_rmemchr_bytes\n";
  }
  if (o.kind_tag == ir.K_COUNT_RUNS_BYTES) {
    return "    call $__fern_count_runs_bytes\n";
  }
  if (o.kind_tag == ir.K_SCAN_SET_BYTES) {
    return "    call $__fern_scan_set_bytes\n";
  }
  if (o.kind_tag == ir.K_MISMATCH_BYTES) {
    return "    call $__fern_mismatch_bytes\n";
  }
  if (o.kind_tag == ir.K_MISMATCH_BYTES_STR) {
    return "    call $__fern_mismatch_bytes_str\n";
  }
  if (o.kind_tag == ir.K_STR_LEN) {
    return "    i32.load\n";
  }
  if (o.kind_tag == ir.K_STR_SLICE) {
    return "    call $__fern_substr\n";
  }
  if (o.kind_tag == ir.K_MEMCHR) {
    return "    call $__fern_memchr\n";
  }
  if (o.kind_tag == ir.K_MISMATCH) {
    return "    call $__fern_mismatch\n";
  }
  if (o.kind_tag == ir.K_RMEMCHR) {
    return "    call $__fern_rmemchr\n";
  }
  if (o.kind_tag == ir.K_COUNT_BYTE) {
    return "    call $__fern_count_byte\n";
  }
  if (o.kind_tag == ir.K_SUM_BYTES) {
    return "    call $__fern_sum_bytes\n";
  }
  if (o.kind_tag == ir.K_SCAN_SET) {
    return "    call $__fern_scan_set\n";
  }
  if (o.kind_tag == ir.K_COUNT_RUNS) {
    return "    call $__fern_count_runs\n";
  }
  if (o.kind_tag == ir.K_STR_HASH) {
    return "    call $__fern_str_hash\n";
  }
  if (o.kind_tag == ir.K_BSD_SUM) {
    return "    call $__fern_bsd_sum\n";
  }
  if (o.kind_tag == ir.K_SCALE_F64) {
    return "    i32.const " + util.i32_to_string(o.i32_imm) + "\n    call $__fern_scale_f64\n";
  }
  if (o.kind_tag == ir.K_CRC32_CKSUM_ARRAY) {
    return "    call $__fern_crc32_cksum_array\n";
  }
  if (o.kind_tag == ir.K_CRC32_IEEE) {
    return "    call $__fern_crc32_ieee\n";
  }
  if (o.kind_tag == ir.K_CRC32_IEEE_ARRAY) {
    return "    call $__fern_crc32_ieee_array\n";
  }
  if (ir.is_byte_kernel_op(o.kind_tag)) {
    return "    call " + byte_kernel_name(o.kind_tag) + "\n";
  }
  if (o.kind_tag == ir.K_CRC32_CKSUM) {
    return "    call $__fern_crc32_cksum\n";
  }
  if (o.kind_tag == ir.K_ASCII_RUN) {
    return "    call $__fern_ascii_run\n";
  }
  if (o.kind_tag == ir.K_STR_BYTES) {
    return "    call $__fern_str_bytes\n";
  }
  if (o.kind_tag == ir.K_STR_SPLIT) {
    return "    call $__fern_str_split\n";
  }
  if (o.kind_tag == ir.K_STR_TO_UPPER) {
    return "    call $__fern_str_upper\n";
  }
  if (o.kind_tag == ir.K_STR_TO_LOWER) {
    return "    call $__fern_str_lower\n";
  }
  if (o.kind_tag == ir.K_STR_REPEAT) {
    return "    call $__fern_str_repeat\n";
  }
  if (o.kind_tag == ir.K_STR_TRIM) {
    return "    call $__fern_str_trim\n";
  }
  if (o.kind_tag == ir.K_STR_REPLACE) {
    return "    call $__fern_str_replace\n";
  }
  if (o.kind_tag == ir.K_STR_LINES) {
    return "    call $__fern_str_lines\n";
  }
  if (o.kind_tag == ir.K_STR_CONCAT) {
    return "    call $__fern_strcat\n";
  }
  if (o.kind_tag == ir.K_STR_EQ) {
    return "    call $__fern_streq\n";
  }
  if (o.kind_tag == ir.K_STR_CMP) {
    return "    call $__fern_strcmp\n";
  }
  return ircore.unsupported_op_refuse(o.kind_tag, "wasm");
}

function emit_function_ir(ns: string, r: irtables.LowerResult, fd: parser.FuncDecl, strs: Placed, caggs: Placed, structs: irtables.StructTab, fn_table: string[], funcs: parser.FuncDecl[], vgate: irverifygate.Gate): string {
  let fn_name = parser.decl_key(fd);
  let body = ircore.body_for_emit(fn_name, r);
  return emit_function_ir_named(ns, body, fn_name, result_wat(body, fd, structs), strs, caggs, structs, fn_table, funcs, vgate);
}

function result_wat(r: irtables.Lowered, fd: parser.FuncDecl, structs: irtables.StructTab): string {
  if (r.result_kind == irtables.result_from_decl() || irtables.erased_passthrough_safe(fd)) {
    return decl_result_wat(fd, structs);
  }
  return produced_result_wat(r);
}

function decl_result_wat(fd: parser.FuncDecl, structs: irtables.StructTab): string {
  if (parser.is_wide_int_type_name(fd.ret_type)) {
    return " (result i64)\n";
  }
  if (parser.is_float_type_name(fd.ret_type)) {
    return " (result f64)\n";
  }
  if (fd.ret_type == "f64x2" || fd.ret_type == "f32x4" || fd.ret_type == "u8x16") {
    return " (result v128)\n";
  }
  if (irtables.erased_passthrough_safe(fd)) {
    return " (result i64)\n";
  }
  return " (result i32)\n";
}

function produced_result_wat(r: irtables.Lowered): string {
  if (r.result_kind == irtables.result_i32()) {
    return " (result i32)\n";
  }
  if (r.result_kind == irtables.result_i64()) {
    return " (result i64)\n";
  }
  if (r.result_kind == irtables.result_f64()) {
    return " (result f64)\n";
  }
  if (r.result_kind == irtables.result_v128()) {
    return " (result v128)\n";
  }
  eprint("error: produced body " + r.name + " carries no result kind");
  exit(3);
  return "";
}

function fallthrough_value(result_wat: string): string {
  if (util.contains(result_wat, "i64")) {
    return "    i64.const 0";
  }
  if (util.contains(result_wat, "f64")) {
    return "    f64.const 0";
  }
  if (util.contains(result_wat, "v128")) {
    return "    f64.const 0\n    f64x2.splat";
  }
  return "    i32.const 0";
}

// A byte view's sub-range lent within one instruction is a window: its
// {data, len} in eight bytes of this call's shadow-stack frame, handed on as
// the window's address plus 1, which no box address has. The frame holds one
// window per frame-form raw_string op, as the native frame holds one box;
// this lists those ops' positions, in order.
function frame_windows(ops: ir.Op[]): i32[] {
  let out: i32[] = [];
  for i in 0..ops.len() {
    if (is_frame_window(ops[i])) {
      out = out.append(i);
    }
  }
  return out;
}

// The shadow stack grows down from $__fern_shadow_sp; a frame that would
// pass $__fern_shadow_lo traps rather than write over the static data.
// Every callee pops what it pushed, so in this function's body the global
// is this frame's base, and nothing holds the base across a call.
// The body runs in a block, so a branch out of it pops the frame as a
// fallthrough does; a return pops it first.
function shadow_frame_push(windows: i32, result_wat: string): string {
  if (windows == 0) {
    return "";
  }
  return "    global.get $__fern_shadow_sp\n    i32.const " + util.i32_to_string(windows * 8) + "\n    i32.sub\n"
    + "    global.set $__fern_shadow_sp\n"
    + "    global.get $__fern_shadow_sp\n    global.get $__fern_shadow_lo\n    i32.lt_u\n    if\n    unreachable\n    end\n"
    + "    block" + result_wat;
}

function shadow_frame_close(windows: i32, result_wat: string): string {
  if (windows == 0) {
    return fallthrough_value(result_wat) + ")\n";
  }
  return fallthrough_value(result_wat) + "\n    end\n" + shadow_frame_pop(windows) + "  )\n";
}

function shadow_frame_pop(windows: i32): string {
  if (windows == 0) {
    return "";
  }
  return "    global.get $__fern_shadow_sp\n    i32.const " + util.i32_to_string(windows * 8)
    + "\n    i32.add\n    global.set $__fern_shadow_sp\n";
}

// stack: data, len -> the window's address plus 1.
function frame_window_wat(cx: WasmOpCtx, data: i32, len: i32, at: i32): string {
  let d = util.i32_to_string(data);
  let l = util.i32_to_string(len);
  let w = util.i32_to_string(at);
  return "    local.set " + l + "\n    local.set " + d + "\n"
    + "    global.get $__fern_shadow_sp\n    i32.const " + util.i32_to_string(cx.window) + "\n    i32.add\n"
    + "    local.tee " + w + "\n    local.get " + d + "\n    i32.store\n"
    + "    local.get " + w + "\n    i32.const 4\n    i32.add\n    local.get " + l + "\n    i32.store\n"
    + "    local.get " + w + "\n    i32.const 1\n    i32.add\n";
}

// A view's string arm is a string {len, bytes}, a window {data, len} at its
// address less 1, or a borrowed descriptor {len | 1 << 31, data} (str_borrow_helper).
function view_string_wat(o: ir.Op, tmp: i32): string {
  let t = util.i32_to_string(tmp);
  if (o.kind_tag == ir.K_STR_LEN) {
    return "    local.tee " + t + "\n    local.get " + t + "\n    i32.const 1\n    i32.and\n    i32.const 3\n    i32.mul\n    i32.add\n    i32.load\n"
      + "    i32.const 2147483647\n    i32.and\n";
  }
  return "    local.tee " + t + "\n    i32.const 1\n    i32.and\n    if (result i32)\n"
    + "    local.get " + t + "\n    i32.const 1\n    i32.sub\n    i32.load\n"
    + "    else\n    local.get " + t + "\n    i32.load\n    i32.const 0\n    i32.lt_s\n    if (result i32)\n"
    + "    local.get " + t + "\n    i32.const 4\n    i32.add\n    i32.load\n"
    + "    else\n    local.get " + t + "\n    i32.const 4\n    i32.add\n    end\n    end\n";
}

function branch_only_if(ops: ir.Op[], i: i32): string {
  if (i + 3 >= ops.len() || ops[i].kind_tag != ir.K_IF || ops[i + 3].kind_tag != ir.K_END) {
    return "";
  }
  let branch = ops[i + 1];
  let invert = false;
  if (branch.kind_tag == ir.K_ELSE && ops[i + 2].kind_tag == ir.K_BR) {
    branch = ops[i + 2];
    invert = true;
  } else if (branch.kind_tag != ir.K_BR || ops[i + 2].kind_tag != ir.K_ELSE) {
    return "";
  }
  if (branch.i32_imm == 0) {
    return "    drop\n";
  }
  let prefix = "";
  if (invert) {
    prefix = "    i32.eqz\n";
  }
  // The removed if contributes one label to the branch depth.
  return prefix + "    br_if " + util.i32_to_string(branch.i32_imm - 1) + "\n";
}

// fern-lint: allow cyclomatic-complexity
function emit_function_ir_named(ns: string, r: irtables.Lowered, fn_name: string, result_wat: string, strs: Placed, caggs: Placed, structs: irtables.StructTab, fn_table: string[], funcs: parser.FuncDecl[], vgate: irverifygate.Gate): string {
  irverifygate.verify_or_refuse(fn_name, r.ops, r.n_params, r.n_locals, vgate);
  irverifygate.certify_ops_or_refuse(fn_name, r.ops, r.n_params, r.n_locals, vgate);
  let f = wasmlocals.coalesce(r.ops, r.n_params, r.n_locals, r.i64_slots, r.f64_slots, r.v128_slots);
  let arrtmp = f.n_locals;
  let eltmp = f.n_locals + 1;
  let f64tmp = f.n_locals + 2;
  let i64tmp = f.n_locals + 3;
  let bctmp = f.n_locals + 4;
  let parts: string[] = [];
  parts = parts.append("  (func $" + fn_name);
  for p in 0..r.n_params {
    if (slot_in_list(f.i64_slots, p)) {
      parts = parts.append(" (param i64)");
    } else if (slot_in_list(f.f64_slots, p)) {
      parts = parts.append(" (param f64)");
    } else if (slot_in_list(f.v128_slots, p)) {
      parts = parts.append(" (param v128)");
    } else {
      parts = parts.append(" (param i32)");
    }
  }
  parts = parts.append(result_wat);
  let nbody = f.n_locals - r.n_params;
  let lanes = has_lane_op(f.ops);
  let nloc = nbody + 5;
  if (lanes) {
    nloc += 2;
  }
  parts = parts.append("    (local");
  for l in 0..nloc {
    if (l == nbody + 2) {
      parts = parts.append(" f64");
    } else if (l == nbody + 3) {
      parts = parts.append(" i64");
    } else if (l >= nbody + 5) {
      parts = parts.append(" v128");
    } else if (l < nbody && slot_in_list(f.i64_slots, r.n_params + l)) {
      parts = parts.append(" i64");
    } else if (l < nbody && slot_in_list(f.f64_slots, r.n_params + l)) {
      parts = parts.append(" f64");
    } else if (l < nbody && slot_in_list(f.v128_slots, r.n_params + l)) {
      parts = parts.append(" v128");
    } else {
      parts = parts.append(" i32");
    }
  }
  parts = parts.append(")\n");
  let placed = frame_windows(f.ops);
  let windows = placed.len();
  parts = parts.append(shadow_frame_push(windows, result_wat));
  let i = 0;
  while (i < f.ops.len()) {
    let folded = branch_only_if(f.ops, i);
    if (folded.len() > 0) {
      parts = parts.append(folded);
      i += 4;
      continue;
    }
    let o = f.ops[i];
    let window = util.index_of_i32(placed, i) * 8;
    if (o.kind_tag == ir.K_RETURN) {
      parts = parts.append(shadow_frame_pop(windows));
    }
    parts = parts.append(emit_ir_op(o, WasmOpCtx { ns: ns, strs: strs, caggs: caggs, structs: structs, fn_table: fn_table, funcs: funcs, base: f.n_locals, window: window }));
    i += 1;
  }
  parts = parts.append(shadow_frame_close(windows, result_wat));
  return util.str_join_chunks(parts);
}

pub function emit_functions_view(ns: string, mod: parser.Module, cache: irtables.LowerResult[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, physical: physicalbody.Collection): string {
  mod = parser.infer_ret_types_module(mod);
  let strs = placed_strs(str_values(cache));
  let caggs = placed_caggs(const_agg_values(cache), 0);
  let ft = fn_value_table(cache);
  let vgate = irverifygate.with_memo(irverifygate.with_owned_frame_views(irverifygate.gate(irtables.fn_sig_index(all_funcs, mod.funcs, cache), ssa_lift.kind_table(), physicalbody.abis(physical))), irverifygate.open_memo("wasm32"));
  let parts: string[] = [];
  for fi in 0..mod.funcs.len() {
    if (mod.funcs[fi].import_iface.len() == 0 && !cache[fi].superseded) {
      parts = parts.append(emit_function_ir(ns, cache[fi], mod.funcs[fi], strs, caggs, all_structs, ft, all_funcs, vgate));
    }
  }
  for xi in mod.funcs.len()..cache.len() {
    let body = ircore.body_for_emit(cache[xi].name, cache[xi]);
    parts = parts.append(emit_function_ir_named(ns, body, cache[xi].name, produced_result_wat(body), strs, caggs, all_structs, ft, all_funcs, vgate));
  }
  irverifygate.report(vgate);
  irverifygate.close_memo(vgate.memo);
  return util.str_join_chunks(parts);
}

pub function emit_functions_ns(ns: string, mod: parser.Module, cache: irtables.LowerResult[], physical: physicalbody.Collection): string {
  let im = parser.infer_ret_types_module(mod);
  return emit_functions_view(ns, im, cache, im.funcs, irtables.struct_tab(im.structs), physical);
}

function struct_type_id(structs: irtables.StructTab, shape: string): i32 {
  for i in 0..structs.decls.len() {
    if (irtables.decl_shape(structs.decls[i]) == shape) {
      return i;
    }
  }
  return 0;
}

pub function build_io_error_p2_func(): string {
  let o = "";
  o += "  (func $__fern_build_io_error_p2 (param $code i32) (param $path i32) (result i32)\n";
  o += "    (call $__fern_build_io_error (call $__fern_errno_p2 (local.get $code)) (local.get $path)))\n";
  return o;
}

pub function errno_p2_func(): string {
  let o = "";
  o += "  (func $__fern_errno_p2 (param $code i32) (result i32)\n";
  o += "    (local $errno i32)\n";
  o += "    (local.set $errno (i32.const 44))\n";
  let codes = asmcore.wasi_error_code_errnos();
  for ci in 0..codes.len() {
    o = o + "    (if (i32.eq (local.get $code) (i32.const " + util.i32_to_string(ci) + ")) (then (local.set $errno (i32.const " + util.i32_to_string(codes[ci]) + "))))\n";
  }
  o += "    (local.get $errno))\n";
  return o;
}

function io_err_box_bytes(nfields: i32): string {
  return util.i32_to_string(xbox_bytes(nfields));
}

function io_err_field_off(i: i32): string {
  return util.i32_to_string(xbox_field_off(i));
}

function needs_fd_sync(needs: string[]): boolean {
  return need_any(needs, ["fd_fsync", "fd_fdatasync", "fd_syncfs", "fd_drop_cache", "fd_dup_onto", "writer_nonblocking", "reader_splice", "reader_copy_range", "writer_splice_forever", "clock_set", "clone_file"]);
}

pub function needs_io_error(needs: string[]): boolean {
  return needs_path_query_error(needs) || needs_path_change_error(needs)
    || needs_file_data_error(needs) || needs_file_handle_error(needs);
}

function needs_path_query_error(needs: string[]): boolean {
  return need(needs, "stat") || need(needs, "lstat") || need(needs, "read_link")
    || need_dir_list(needs) || need(needs, "temp_dir");
}

function needs_path_change_error(needs: string[]): boolean {
  return need(needs, "remove_file") || need(needs, "create_dir_all") || need(needs, "create_dir")
    || need(needs, "remove_dir") || need(needs, "create_link") || need(needs, "create_symlink")
    || need(needs, "rename") || need(needs, "set_file_times") || need(needs, "truncate");
}

function needs_file_data_error(needs: string[]): boolean {
  return need(needs, "read_file") || need(needs, "read_file_bytes") || need(needs, "write_file")
    || need(needs, "write_file_bytes") || need(needs, "writer_write") || need(needs, "write_some")
    || need(needs, "write_bytes") || need(needs, "write_some_bytes") || need(needs, "read_chunk")
    || need(needs, "read_chunk_bytes");
}

function needs_file_handle_error(needs: string[]): boolean {
  return need_open_file(needs) || need(needs, "reader_close") || need(needs, "fd_stat")
    || need(needs, "reader_seek") || need(needs, "writer_truncate") || need(needs, "writer_set_times") || need(needs, "fd_flags")
    || needs_fd_sync(needs);
}

pub function with_strerror_texts(sv: string[]): string[] {
  let texts = asmcore.strerror_texts();
  for i in 0..texts.len() {
    if (util.index_of_str(sv, texts[i]) < 0) {
      sv = sv.append(texts[i]);
    }
  }
  if (util.index_of_str(sv, "Unknown error ") < 0) {
    sv = sv.append("Unknown error ");
  }
  return sv;
}

function refused_errno(): string {
  return "(i32.const -1)";
}

function build_io_error_func(strs: Placed): string {
  let o = "";
  o += "  (func $__fern_build_io_error (param $errno i32) (param $path i32) (result i32)\n";
  o += "    (local $r i32) (local $e i32) (local $n i32) (local $t i32) (local $l i32)\n";
  o += "    (if (i32.eq (local.get $errno) (i32.const 44)) (then\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(1) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("NotFound")) + "))\n";
  o = o + "      (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0) + ")) (local.get $path))\n";
  o += "      (return (local.get $r))))\n";
  o += "    (if (i32.eq (local.get $errno) (i32.const 2)) (then\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(1) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("PermissionDenied")) + "))\n";
  o = o + "      (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0) + ")) (local.get $path))\n";
  o += "      (return (local.get $r))))\n";
  o += "    (if (i32.eq (local.get $errno) (i32.const 20)) (then\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(1) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("AlreadyExists")) + "))\n";
  o = o + "      (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0) + ")) (local.get $path))\n";
  o += "      (return (local.get $r))))\n";
  o += "    (if (i32.eq (local.get $errno) (i32.const 27)) (then\n";
  o += "      (drop (call $__fern_arr_dec (local.get $path)))\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(0) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("Interrupted")) + "))\n";
  o += "      (return (local.get $r))))\n";
  o = o + "    (if (i32.eq (local.get $errno) " + refused_errno() + ") (then\n";
  o += "      (drop (call $__fern_arr_dec (local.get $path)))\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(0) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("Unsupported")) + "))\n";
  o += "      (return (local.get $r))))\n";
  o += "    (if (i32.eq (local.get $errno) (i32.const 25)) (then\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(1) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("InvalidUtf8")) + "))\n";
  o = o + "      (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0) + ")) (local.get $path))\n";
  o += "      (return (local.get $r))))\n";
  let texts = asmcore.strerror_texts();
  let wasi = asmcore.strerror_wasi();
  let carried = asmcore.strerror_carried();
  for ti in 0..texts.len() {
    let en = wasi[ti];
    if (en != 0 && en != 44 && en != 2 && en != 20 && en != 27 && en != 25) {
      o = o + "    (if (i32.eq (local.get $errno) (i32.const " + util.i32_to_string(en) + ")) (then (local.set $e (i32.const " + util.i32_to_string(strs.offset_of(texts[ti], "string literal")) + ")) (local.set $l (i32.const " + util.i32_to_string(carried[ti]) + "))))\n";
    }
  }
  let pfx = "Unknown error ";
  let plen = util.i32_to_string(pfx.len());
  o += "    (if (i32.eqz (local.get $e)) (then\n";
  o = o + "      (local.set $e (call $__fern_str_box (i32.const " + util.i32_to_string(4 + pfx.len() + 10) + ")))\n";
  o = o + "      (memory.copy (i32.add (local.get $e) (i32.const 4)) (i32.const " + util.i32_to_string(strs.offset_of(pfx, "string literal") + 4) + ") (i32.const " + plen + "))\n";
  o += "      (local.set $n (i32.const 1)) (local.set $t (local.get $errno))\n";
  o += "      (block $dc (loop $dl (br_if $dc (i32.lt_u (local.get $t) (i32.const 10))) (local.set $t (i32.div_u (local.get $t) (i32.const 10))) (local.set $n (i32.add (local.get $n) (i32.const 1))) (br $dl)))\n";
  o = o + "      (i32.store (local.get $e) (i32.add (i32.const " + plen + ") (local.get $n)))\n";
  o = o + "      (local.set $t (i32.add (i32.add (local.get $e) (i32.const " + util.i32_to_string(4 + pfx.len()) + ")) (local.get $n)))\n";
  o += "      (local.set $n (local.get $errno))\n";
  o += "      (block $wd (loop $wl (local.set $t (i32.sub (local.get $t) (i32.const 1))) (i32.store8 (local.get $t) (i32.add (i32.const 48) (i32.rem_u (local.get $n) (i32.const 10)))) (local.set $n (i32.div_u (local.get $n) (i32.const 10))) (br_if $wd (i32.eqz (local.get $n))) (br $wl)))\n";
  o += "    ))\n";
  o = o + "    (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(3) + ")))\n";
  o = o + "    (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("Other")) + "))\n";
  o = o + "    (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0) + ")) (local.get $path))\n";
  o = o + "    (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(1) + ")) (local.get $e))\n";
  o = o + "    (i64.store (i32.add (local.get $r) (i32.const " + io_err_field_off(2) + ")) (i64.extend_i32_u (local.get $l)))\n";
  o += "    (local.get $r))\n";
  return o;
}

