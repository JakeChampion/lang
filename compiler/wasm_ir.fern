pub function fd_sync_funcs(needs: string[]): string {
  let o = "";
  if (need(needs, "fd_fsync")) {
    o += fd_sync_func("fsync", "fd_sync");
  }
  if (need(needs, "fd_fdatasync")) {
    o += fd_sync_func("fdatasync", "fd_datasync");
  }
  if (need(needs, "fd_syncfs")) {
    o += fd_syncfs_func();
  }
  if (need(needs, "fd_drop_cache")) {
    o += fd_drop_cache_func();
  }
  if (need(needs, "clock_set")) {
    o += clock_set_func();
  }
  if (need(needs, "clone_file")) {
    o += clone_file_func();
  }
  if (need(needs, "fd_dup_onto")) {
    o += fd_dup_onto_func();
  }
  if (need(needs, "writer_nonblocking")) {
    o += writer_nonblocking_func();
  }
  if (need(needs, "reader_splice")) {
    o += refused_copy_func("$__fern_reader_splice");
  }
  if (need(needs, "reader_copy_range")) {
