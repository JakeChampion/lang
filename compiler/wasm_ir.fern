function ip_flat_prologue(): string {
  let o = "";
  o = o + "    (local.set $flat (i32.const " + util.i32_to_string(ip_flat_addr()) + "))\n";
  o += "    (local.set $tmp (call $__fern_ip_flat (local.get $addr) (local.get $port) (local.get $flat)))\n";
  o += "    (if (local.get $tmp) (then (return (local.get $tmp))))\n";
  return o;
}

function ip_flat_words(): string {
  return "      (i32.load offset=0 (local.get $flat))\n      (i32.load offset=4 (local.get $flat))\n      (i32.load offset=8 (local.get $flat))\n      (i32.load offset=12 (local.get $flat))\n      (i32.load offset=16 (local.get $flat))\n      (i32.load offset=20 (local.get $flat))\n      (i32.load offset=24 (local.get $flat))\n      (i32.load offset=28 (local.get $flat))\n      (i32.load offset=32 (local.get $flat))\n      (i32.load offset=36 (local.get $flat))\n      (i32.load offset=40 (local.get $flat))\n      (i32.load offset=44 (local.get $flat))\n";
