  o += read_failed("(local.get $failed)", "$arr", "(i32.const 29)");
  o += "    (i32.store (local.get $arr) (local.get $off))\n";
  o += "    (i32.store offset=4 (local.get $arr) (local.get $cap))\n";
  o += "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $tmp) (i32.const 0))\n";
  o += "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $arr))\n";
  o += "    (local.get $tmp))\n";
  return o;
}

function read_stop_p2(): string {
  let o = "      (if (i32.load8_u (local.get $ra)) (then\n";
  o += "        (if (i32.eqz (i32.load8_u offset=4 (local.get $ra))) (then\n";
  o += "          (call $__fern_io_error_drop (i32.load offset=8 (local.get $ra)))\n";
  o += "          (local.set $failed (i32.const 1))))\n";
  o += "        (br $rd)))\n";
  return o;
}

function read_failed(failed: string, buf: string, errno: string): string {
  let o = "    (if " + failed + " (then\n";
  o = o + "      (drop (call $__fern_arr_dec (local.get " + buf + ")))\n";
  o += "      (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $tmp) (i32.const 1))\n";
  o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) (call $__fern_build_io_error " + errno + " (call $__fern_rc_inc (local.get $np))))\n";
  o += "      (return (local.get $tmp))))\n";
  return o;
}

function read_room(buf: string, packed: boolean, want: string): string {
  let at = "4";
  let fresh = "(call $__fern_str_box (i32.add (i32.const 4) (local.get $cap)))";
  if (packed) {
    at = "8";
    fresh = "(call $__fern_arr_elems (local.get $cap) (i32.const 1))";
  }
  let o = "";
  o = o + "      (if (i32.gt_u (i32.add (local.get $off) " + want + ") (local.get $cap)) (then\n";
  o += "        (loop $dbl\n";
  o += "          (local.set $cap (i32.shl (local.get $cap) (i32.const 1)))\n";
  o = o + "          (br_if $dbl (i32.gt_u (i32.add (local.get $off) " + want + ") (local.get $cap))))\n";
  o = o + "        (local.set $grown " + fresh + ")\n";
  o = o + "        (memory.copy (i32.add (local.get $grown) (i32.const " + at + ")) (i32.add (local.get " + buf + ") (i32.const " + at + ")) (local.get $off))\n";
  o = o + "        (drop (call $__fern_arr_dec (local.get " + buf + ")))\n";
  o = o + "        (local.set " + buf + " (local.get $grown))))\n";
  return o;
}

pub function writefile_func_p2(): string {
  let o = "";
  o += "  (func $__fern_write_file (param $np i32) (param $cp i32) (result i32)\n";
  o += "    (local $ra i32) (local $fd i32) (local $strm i32) (local $clen i32) (local $cur i32) (local $chunk i32) (local $tmp i32)\n";
  o += "    (local.set $fd (call $__fern_preopen_p2))\n";
  o += no_preopen_p2();
  o += "    (local.set $ra (call $__fern_alloc (i32.const 32)))\n";
  o += "    (call $__fern_open_at (local.get $fd) (i32.const 1) (i32.add (local.get $np) (i32.const 4)) (i32.load (local.get $np)) (i32.const 9) (i32.const 2) (local.get $ra))\n";
  o += "    (if (i32.ne (i32.load8_u (local.get $ra)) (i32.const 0)) (then\n";
  o += "      (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $tmp) (i32.const 1))\n";
  o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) " + err_payload_p2() + ")\n";
  o += "      (call $__fern_raw_free (local.get $ra) (i32.const 32))\n";
  o += "      (return (local.get $tmp))))\n";
  o += "    (local.set $fd (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
  o += "    (call $__fern_write_via_stream (local.get $fd) (i64.const 0) (local.get $ra))\n";
  o += "    (if (i32.ne (i32.load8_u (local.get $ra)) (i32.const 0)) (then\n";
  o += "      (call $__fern_desc_drop (local.get $fd))\n";
  o += "      (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $tmp) (i32.const 1))\n";
  o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) " + err_payload_p2() + ")\n";
  o += "      (call $__fern_raw_free (local.get $ra) (i32.const 32))\n";
  o += "      (return (local.get $tmp))))\n";
  o += "    (local.set $strm (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
  o += "    (local.set $clen (i32.load (local.get $cp)))\n";
  o += "    (local.set $cur (i32.const 0))\n";
  o += "    (block $wd (loop $wc\n";
  o += "      (br_if $wd (i32.ge_u (local.get $cur) (local.get $clen)))\n";
  o += "      (local.set $chunk (i32.sub (local.get $clen) (local.get $cur)))\n";
  o += "      (if (i32.gt_u (local.get $chunk) (i32.const 4096)) (then (local.set $chunk (i32.const 4096))))\n";
  o += "      (call $__fern_bwf (local.get $strm) (i32.add (i32.add (local.get $cp) (i32.const 4)) (local.get $cur)) (local.get $chunk) (local.get $ra))\n";
  o += "      (if (i32.ne (i32.load8_u (local.get $ra)) (i32.const 0)) (then\n";
  o += "        (if (i32.eqz (i32.load8_u offset=4 (local.get $ra))) (then (call $__fern_io_error_drop (i32.load offset=8 (local.get $ra)))))\n";
  o += "        (call $__fern_out_strm_drop (local.get $strm))\n";
  o += "        (call $__fern_desc_drop (local.get $fd))\n";
  o += "        (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
  o += "        (i32.store (local.get $tmp) (i32.const 1))\n";
  o += "        (i32.store (i32.add (local.get $tmp) (i32.const 4)) (call $__fern_build_io_error (i32.const 29) (call $__fern_rc_inc (local.get $np))))\n";
  o += "        (call $__fern_raw_free (local.get $ra) (i32.const 32))\n";
  o += "        (return (local.get $tmp))))\n";
  o += "      (local.set $cur (i32.add (local.get $cur) (local.get $chunk)))\n";
  o += "      (br $wc)))\n";
  o += "    (call $__fern_out_strm_drop (local.get $strm))\n";
  o += "    (call $__fern_desc_drop (local.get $fd))\n";
  o += "    (call $__fern_raw_free (local.get $ra) (i32.const 32))\n";
  o += "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $tmp) (i32.const 0))\n";
  o += "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.const 0))\n";
  o += "    (local.get $tmp))\n";
  return o;
}

pub function component_io_imports(needs: string[], stderr: boolean, proxy: boolean): string {
  let o = "  (import \"wasi:io/error@0.2.0\" \"[resource-drop]error\" (func $__fern_io_error_drop (param i32)))\n";
  if (stderr) {
    o += "  (import \"wasi:cli/stderr@0.2.0\" \"get-stderr\" (func $__fern_get_stderr (result i32)))\n";
    o += "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.blocking-write-and-flush\" (func $__fern_bwf (param i32 i32 i32 i32)))\n";
    o += "  (import \"wasi:cli/stdout@0.2.0\" \"get-stdout\" (func $__fern_get_stdout (result i32)))\n";
  } else {
    o += "  (import \"wasi:cli/stdout@0.2.0\" \"get-stdout\" (func $__fern_get_stdout (result i32)))\n";
    o += "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.blocking-write-and-flush\" (func $__fern_bwf (param i32 i32 i32 i32)))\n";
  }
  if (need(needs, "exit") && !proxy) {
    o += "  (import \"wasi:cli/exit@0.2.0\" \"exit\" (func $__fern_exit (param i32)))\n";
  }
  if (need(needs, "@uses_random")) {
    o += random_imports_p2();
  }
  if (needs_wall_clock(needs) || need(needs, "monotonic_ns")) {
    o += clock_imports_p2(needs_wall_clock(needs), need(needs, "monotonic_ns"));
  }
  if (need(needs, "clock_resolution")) {
    o += "  (import \"wasi:clocks/wall-clock@0.2.0\" \"resolution\" (func $__fern_wall_resolution (param i32)))\n";
  }
  if (need(needs, "args")) {
    o += args_imports_p2();
  }
  if (need(needs, "@proxy") && need(needs, "env")) {
    o += config_imports_p2();
  } else if (need(needs, "env") || need(needs, "environ")) {
    o += env_imports_p2();
  }
  return o + fs_imports_p2(needs);
}

pub function component_uses_stderr(mod: parser.Module, needs: string[]): boolean {
  return needs_abort(needs) || need(needs, "eprint_str") || called_names(mod).has("stderr");
}

pub function needs_abort(needs: string[]): boolean {
  return need(needs, "@allocates") || need(needs, "@abort_checks");
}

function runtime_needs(mod: parser.Module, needs: string[]): string[] {
  if (need(needs, "read_dir_bytes")) {
    needs = needs.append("read_dir");
  }
  if (need(needs, "read_link_bytes")) {
    needs = needs.append("read_link");
  }
  if (module_extern_needs_heap(mod) && !needs_abort(needs)) {
    return needs.append("@abort_checks");
  }
  return needs;
}

pub function needs_wall_clock(needs: string[]): boolean {
  return need(needs, "now_ns") || need(needs, "now_unix_ms");
}

function fd_write_handle(stderr: boolean, table: boolean): string {
  let o = "";
  let pre = "    ";
  if (table) {
    o += "    (local.set $slot (call $__fern_fdt_slot (local.get $fd)))\n";
    o += "    (if (i32.eqz (local.get $slot)) (then (return (i32.const 8))))\n";
    o += "    (if (i32.eqz (i32.and (i32.load offset=12 (local.get $slot)) (i32.const 2))) (then (return (i32.const 8))))\n";
    o += "    (if (i32.ge_u (local.get $fd) (i32.const 3)) (then (local.set $h (i32.load offset=4 (local.get $slot)))) (else\n";
    pre = "      ";
  } else {
    o += "    (if (i32.and (i32.ne (local.get $fd) (i32.const 1)) (i32.ne (local.get $fd) (i32.const 2))) (then (return (i32.const 8))))\n";
  }
  if (!stderr) {
    o = o + pre + "(if (i32.eq (local.get $fd) (i32.const 2)) (then (return (i32.const 8))))\n";
  }
  if (stderr) {
    o = o + pre + "(if (i32.eq (local.get $fd) (i32.const 2))\n";
    o = o + pre + "  (then\n";
    o = o + pre + "    (if (i32.eq (global.get $__stderr_handle) (i32.const -1))\n";
    o = o + pre + "      (then (global.set $__stderr_handle (call $__fern_get_stderr))))\n";
    o = o + pre + "    (local.set $h (global.get $__stderr_handle)))\n";
    o = o + pre + "  (else\n";
    o = o + pre + "    (if (i32.eq (global.get $__stdout_handle) (i32.const -1))\n";
    o = o + pre + "      (then (global.set $__stdout_handle (call $__fern_get_stdout))))\n";
    o = o + pre + "    (local.set $h (global.get $__stdout_handle))))\n";
  } else {
    o = o + pre + "(if (i32.eq (global.get $__stdout_handle) (i32.const -1))\n";
    o = o + pre + "  (then (global.set $__stdout_handle (call $__fern_get_stdout))))\n";
    o = o + pre + "(local.set $h (global.get $__stdout_handle))\n";
  }
  if (table) {
    o += "    ))\n";
  }
  return o;
}

function proxy_exit_shim(): string {
  return "  (func $__fern_proc_exit (param $c i32)\n    (unreachable))\n";
}

pub function component_io_shims(needs: string[], stderr: boolean, proxy: boolean, lc: boolean): string {
  let o = "  (global $__stdout_handle (mut i32) (i32.const -1))\n";
  if (stderr) {
    o += "  (global $__stderr_handle (mut i32) (i32.const -1))\n";
  }
  let table = need_fd_table(needs);
  let advance = "";
  let slot_local = "";
  if (table) {
    advance = "(call $__fern_fdt_advance (local.get $slot) (local.get $total)) ";
    slot_local = " (local $slot i32)";
  }
  o += "  (func $__fern_fd_write (param $fd i32) (param $iovs i32) (param $iovn i32) (param $nw i32) (result i32)\n";
  o = o + "    (local $h i32) (local $len i32) (local $ret i32) (local $scratch i32) (local $ptr i32) (local $at i32) (local $chunk i32) (local $vec i32) (local $total i32)" + slot_local + "\n";
  o += "    (i32.store (local.get $nw) (i32.const 0))\n";
  o += fd_write_handle(stderr, table);
  o += "    (local.set $scratch (call $__fern_str_box (i32.const 24)))\n";
  o += "    (local.set $ret (i32.and (i32.add (local.get $scratch) (i32.const 7)) (i32.const -8)))\n";
  o += "    (block $vectors_done (loop $vectors\n";
  o += "      (br_if $vectors_done (i32.ge_u (local.get $vec) (local.get $iovn)))\n";
  o += "      (local.set $ptr (i32.load (local.get $iovs)))\n";
  o += "      (local.set $len (i32.load offset=4 (local.get $iovs))) (local.set $at (i32.const 0))\n";
  o += "      (block $chunks_done (loop $chunks\n";
  o += "        (local.set $chunk (i32.sub (local.get $len) (local.get $at)))\n";
  o += "        (if (i32.gt_u (local.get $chunk) (i32.const 4096)) (then (local.set $chunk (i32.const 4096))))\n";
  o += "        (call $__fern_bwf (local.get $h) (i32.add (local.get $ptr) (local.get $at)) (local.get $chunk) (local.get $ret))\n";
  o += "        (if (i32.load8_u (local.get $ret)) (then\n";
  o += "          (if (i32.eqz (i32.load8_u offset=4 (local.get $ret))) (then (call $__fern_io_error_drop (i32.load offset=8 (local.get $ret)))))\n";
  o += "          (drop (call $__fern_arr_dec (local.get $scratch)))\n";
  o = o + "          " + advance + "(i32.store (local.get $nw) (local.get $total)) (return (i32.const 29))))\n";
  o += "        (local.set $at (i32.add (local.get $at) (local.get $chunk)))\n";
  o += "        (local.set $total (i32.add (local.get $total) (local.get $chunk)))\n";
  o += "        (br_if $chunks_done (i32.eq (local.get $at) (local.get $len))) (br $chunks)))\n";
  o += "      (local.set $vec (i32.add (local.get $vec) (i32.const 1)))\n";
  o += "      (local.set $iovs (i32.add (local.get $iovs) (i32.const 8))) (br $vectors)))\n";
  o += "    (drop (call $__fern_arr_dec (local.get $scratch)))\n";
  o = o + "    " + advance + "(i32.store (local.get $nw) (local.get $total))\n";
  o += "    (i32.const 0))\n";
  if (need(needs, "exit") && proxy) {
    o += proxy_exit_shim();
  } else if (need(needs, "exit")) {
    o = o + "  (func $__fern_proc_exit (param $c i32)\n" + lc_exit_report(lc);
    o += "    (call $__fern_exit (i32.ne (local.get $c) (i32.const 0)))\n";
    o += "    (unreachable))\n";
  }
  if (needs_wall_clock(needs) || need(needs, "monotonic_ns")) {
    o += clock_funcs_p2(needs_wall_clock(needs), need(needs, "monotonic_ns"));
  }
  if (need(needs, "clock_resolution")) {
    o += clock_resolution_func_p2();
  }
  if (need(needs, "random_bytes") || need(needs, "random_i32")) {
    o += random_func_p2();
  }
  if (need(needs, "env")) {
    if (need(needs, "@proxy")) {
      o += config_env_func_p2();
    } else {
      o += env_func_p2();
    }
  }
  if (need(needs, "environ")) {
    o += environ_func_p2();
  }
  if (need(needs, "args")) {
    o += args_func_p2(need(needs, "@calls_set_args"));
  }
  if (need_read_file(needs) || need_write_file(needs) || need_any(needs, component_fs_needs())) {
    o += errno_p2_func();
  }
  if (need_read_file(needs) || need_write_file(needs)) {
    o += build_io_error_p2_func();
  }
  o += component_fs_shims(needs, stderr);
  if (need_read_file(needs) && !need_open_file(needs)) {
    o += is_dir_at_func_p2();
  }
  if (need(needs, "read_file")) {
    o += readfile_func_p2();
  }
  if (need(needs, "read_file_bytes")) {
    o += readfile_bytes_func_p2();
  }
  if (need(needs, "write_file")) {
    o += writefile_func_p2();
  }
  if (need(needs, "write_file_bytes")) {
    o += writefile_bytes_func(true);
  }
  return o;
}

pub function emit_ir_module_mode(mod: parser.Module, ir_cache: irtables.LowerResult[], mode: i32, sw: asmcore.Switches, physical: physicalbody.Collection, rt_lower: (parser.Module) => physicalbody.Lowered): string {
  let sv = str_values(ir_cache);
  let cv = const_agg_values(ir_cache);
  let ft = fn_value_table(ir_cache);
  let unit = emit_functions_ns("", mod, ir_cache, physical);
  let needs = needs_of(ir_cache);
  if (mode == 2 && module_is_proxy(mod)) {
    needs = needs.append("@proxy");
  }
  if (mode == 2 && calls_any(called_names(mod), stdin_builtins())) {
    needs = needs.append("@stdin");
  }
  return emit_ir_module_units(
    with_runtime_units([WasmUnit { ns: "", text: unit, strs: sv, caggs: cv, fns: ft }], needs, rt_lower), mod,
    needs, indirect_fn_sigs(ir_cache), mode, sw,
  );
}

pub function ir_route_ok(lm: parser.Module, component: boolean, io: boolean, sub: ircore.Sub): boolean {
  return match (ircore.gate(ircore.with_records(lm, sub), sub)) { Some(g) => ir_route_final(g.cache, component, io, module_is_proxy(lm)), None => false };
}

pub function ir_route_final(cache: irtables.LowerResult[], component: boolean, io: boolean, proxy: boolean): boolean {
  return wasm_ir_deferrals_ok(cache) && (!component || component_refused_need(needs_of(cache), io, proxy) == "");
}

pub function emit_module_mode_or_error_sub(mod: parser.Module, component: boolean, io: boolean, sub: ircore.Sub): string {
  return emit_core_or_error_sub(mod, component, io, sub).wat;
}

pub struct EmittedCore { wat: string, needs: string[] }

pub function emit_core_or_error_sub(mod: parser.Module, component: boolean, io: boolean, sub: ircore.Sub): EmittedCore {
  ircore.refuse_claims(sub.refused);
  let lm = ircore.with_records(route_normalized(mod), sub);
  let bad_import = wasm_unsupported_import(lm);
  if (bad_import.len() > 0) {
    eprint(bad_import);
    exit(1);
  }
  let mode = 0;
  if (component) {
    mode = 1;
    if (io) {
      mode = 2;
    }
  }
  let g = match (ircore.gate(lm, sub)) { Some(g) => g, None => { ircore.eprint_ir_ineligible(); exit(1); } };
  let cache = g.cache;
  if (ir_route_final(cache, component, io, module_is_proxy(lm))) {
    return EmittedCore { wat: emit_ir_module_mode(lm, cache, mode, sub.switches, g.physical, sub.rt_lower), needs: runtime_needs(lm, needs_of(cache)) };
  }
  if (component && wasm_ir_deferrals_ok(cache)) {
    eprint("error: " + component_refused_need(needs_of(cache), io, module_is_proxy(lm))
      + " is not supported in a wasm component: the component framing has no import for it (build with -emit core-module for a preview1 module)");
    exit(1);
  }
  ircore.eprint_ir_ineligible();
  exit(1);
  return EmittedCore { wat: "", needs: [] };
}

pub function wasi_subscribe_duration_import(): string {
  return "  (import \"wasi:clocks/monotonic-clock@0.2.0\" \"subscribe-duration\" (func $__fern_wasi_subscribe_duration (param i64) (result i32)))\n";
}

pub function pollable_drop_func(): string {
  return "  (func $__fern_pollable_drop (param $p i32) (result i32)\n"
    + "    (if (i32.ge_s (local.get $p) (i32.const 0)) (then (call $__fern_wasi_pollable_drop (local.get $p))))\n"
    + "    (i32.const 0))\n";
}

pub function wasi_pollable_drop_import(): string {
  return "  (import \"wasi:io/poll@0.2.0\" \"[resource-drop]pollable\" (func $__fern_wasi_pollable_drop (param i32)))\n";
}

pub function wasi_pollable_block_import(): string {
  return "  (import \"wasi:io/poll@0.2.0\" \"[method]pollable.block\" (func $__fern_wasi_pollable_block (param i32)))\n";
}

pub function wasi_poll_import(): string {
  return "  (import \"wasi:io/poll@0.2.0\" \"poll\" (func $__fern_wasi_poll (param i32 i32 i32)))\n";
}

pub function wasi_instance_network_import(): string {
  return "  (import \"wasi:sockets/instance-network@0.2.0\" \"instance-network\" (func $__fern_wasi_instance_network (result i32)))\n";
}

pub function wasi_sockets_imports(): string {
  let o = "";
  o += "  (import \"wasi:sockets/tcp-create-socket@0.2.0\" \"create-tcp-socket\" (func $__fern_wasi_create_tcp_socket (param i32 i32)))\n";
  o += "  (import \"wasi:sockets/tcp@0.2.0\" \"[method]tcp-socket.start-connect\" (func $__fern_wasi_tcp_start_connect (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))\n";
