  o += "    (i32.store offset=4 (local.get $dg) (i32.load (local.get $data)))\n";
  o += "    (if (i32.load (local.get $addr))\n";
  o += "      (then\n";
  o += "        (i32.store offset=8 (local.get $dg) (i32.const 1))\n";
  o += "        (i32.store offset=12 (local.get $dg) (i32.load (local.get $flat)))\n";
  o += "        (i32.store16 offset=16 (local.get $dg) (i32.load offset=4 (local.get $flat)))\n";
  o += "        (if (i32.load (local.get $flat))\n";
  o += "          (then\n";
  o += "            (i32.store offset=20 (local.get $dg) (i32.const 0))\n";
  o += "            (local.set $k (i32.const 0))\n";
  o += "            (block $s (loop $sl (br_if $s (i32.ge_u (local.get $k) (i32.const 8)))\n";
  o += "              (i32.store16 (i32.add (i32.add (local.get $dg) (i32.const 24)) (i32.mul (local.get $k) (i32.const 2)))\n";
  o += "                (i32.load (i32.add (i32.add (local.get $flat) (i32.const 12)) (i32.mul (local.get $k) (i32.const 4)))))\n";
  o += "              (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $sl)))\n";
  o += "            (i32.store offset=40 (local.get $dg) (i32.const 0)))\n";
  o += "          (else\n";
