pub function fl_cells(): i32 {
  return 65536;
}

pub function large_fl_cells(): i32 {
  return 2049;
}

pub function str_values(cache: irtables.LowerResult[]): string[] {
  let vals: string[] = [];
  let fi: i32 = 0;
  while (fi < cache.len()) {
    let r: irtables.LowerResult = cache[fi];
    let i: i32 = 0;
    while (i < r.ops.len()) {
      if (r.ops[i].kind_tag == 5) {
        vals = intern_str(vals, r.ops[i].str);
      }
      if (r.ops[i].kind_tag == 218) {
        vals = nested_strs(vals, r.ops[i].str);
      }
      i = i + 1;
    }
    fi = fi + 1;
  }
  return vals;
}

function intern_str(vals: string[], v: string): string[] {
  if (util.index_of_str(vals, v) >= 0) {
    return vals;
  }
  return vals.append(v);
}

function nested_strs(vals: string[], packed: string): string[] {
  if (ir.const_struct_is_bytes(packed)) {
    return vals;
  }
  for v in ir.const_struct_values(packed) {
    let inner: string = ir.const_struct_ref(v);
    if (ir.const_struct_is_str(inner)) {
      vals = intern_str(vals, ir.const_str_text(inner));
    } else if (inner.len() > 0) {
      vals = nested_strs(vals, inner);
    }
  }
  return vals;
}

pub function arr_push_shared_addr(): i32 {
  return 20;
}

pub function arr_push_copied_addr(): i32 {
  return arr_push_shared_addr() + 4;
}

pub function map_hash_seed_addr(): i32 {
  return arr_push_copied_addr() + 8;
}

pub function sleep_scratch_addr(): i32 {
  return (map_hash_seed_addr() + 4 + 7) / 8 * 8;
}

pub function sleep_scratch_bytes(): i32 {
  return 88;
}

pub function ip_flat_addr(): i32 {
  return (sleep_scratch_addr() + sleep_scratch_bytes() + 7) / 8 * 8;
}

pub function io_ret_addr(): i32 {
  return ip_flat_addr() + 48;
}

pub function str_region_base(): i32 {
  return (io_ret_addr() + 16 + 7) / 8 * 8;
}

pub function fn_table_base(): i32 {
  return 0;
}

pub function need(needs: string[], name: string): boolean {
  return util.index_of_str(needs, name) >= 0;
}

function need_udp_socket(needs: string[]): boolean {
  return need_any(needs, ["udp_bind", "udp_connect"]);
}

function need_udp_send(needs: string[]): boolean {
  return need_any(needs, ["udp_sendto", "udp_sendto_bytes"]);
}

function need_any(needs: string[], names: string[]): boolean {
  let i: i32 = 0;
  while (i < names.len()) {
    if (need(needs, names[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function need_open_file(needs: string[]): boolean {
  return need(needs, "open_file") || need(needs, "open_with");
}

pub function need_ops(): string[] {
  return [
    "args", "arr_reserve", "arr_push", "arr_push_f64", "arr_push_i64", "arr_push_owned", "arr_push_owned_i64",
    "arr_push_owned_f64", "env", "environ", "eprint_str", "exit", "monotonic_ns", "now_ns", "now_unix_ms", "clock_resolution", "clock_set", "clone_file", "poll", "print_str", "putchar",
    "random_bytes", "read_chunk", "read_chunk_bytes", "fd_stat", "fd_fsync", "fd_fdatasync", "fd_syncfs", "fd_drop_cache",
    "fd_dup_onto", "reader_seek", "reader_splice", "reader_copy_range", "writer_splice_forever", "fd_flags", "writer_truncate", "read_dir",
    "read_dir_all", "read_dir_ino", "read_dir_ino_all", "read_file", "read_file_bytes",
    "reader_close", "remove_dir_all", "remove_file", "create_dir_all", "create_dir",
    "remove_dir", "create_link", "create_symlink", "rename", "read_link", "set_file_times",
    "truncate", "sleep_ms", "sleep_ns", "stat", "lstat", "str_bytes", "str_from_bytes", "str_from_bytes_range",
    "str_split", "tcp_accept", "tcp_close", "tcp_listen", "tcp_listen_with",
    "tcp_local_port", "tcp_pollable", "tcp_send_bytes", "tcp_socket_ctl", "temp_dir",
    "udp_bind", "udp_bind_with", "udp_connect", "udp_recvfrom", "udp_sendto", "udp_sendto_bytes", "tcp_connect_with", "wasm_block",
    "reactor_new", "reactor_ctl", "reactor_wait", "tcp_recv_into", "tcp_sendfile", "tcp_send_buf",
    "wasm_poll", "wasm_pollable_drop", "wasm_timer_pollable", "write_file", "write_file_bytes", "open_file",
    "writer_write", "write_some", "write_bytes", "write_some_bytes", "buf_take_bytes", "buf_push_bytes_range",
    "buf_new", "buf_push", "buf_push_range", "buf_push_mapped", "buf_push_filtered", "buf_push_expanded", "buf_push_bytes_mapped", "buf_push_bytes_filtered", "buf_push_bytes_expanded",
    "buf_push_byte", "buf_push_u64", "buf_len", "buf_clear", "buf_take", "buf_free",
  ];
