  o += "          (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "          (br $cn)))\n";
  o += "        (local.set $i (i32.add (local.get $i) (local.get $lo))))\n";
  o += "      (else\n";
  o += "        (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $w)) (i32.load8_u (i32.add (i32.add (local.get $h) (i32.const 4)) (local.get $i))))\n";
  o += "        (local.set $w (i32.add (local.get $w) (i32.const 1)))\n";
  o += "        (local.set $i (i32.add (local.get $i) (i32.const 1)))))\n";
  o += "      (br $cw)))\n";
  o += "    (block $dt (loop $ct\n";
  o += "      (br_if $dt (i32.ge_s (local.get $i) (local.get $lh)))\n";
  o += "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $w)) (i32.load8_u (i32.add (i32.add (local.get $h) (i32.const 4)) (local.get $i))))\n";
  o += "      (local.set $w (i32.add (local.get $w) (i32.const 1)))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $ct)))\n";
  o += "    (local.get $p))\n";
  return o;
}

