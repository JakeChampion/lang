}

function emit_str_op_wat(o: ir.Op): string {
  if (o.kind_tag == 384 || o.kind_tag == 385) {
    let name: string = "$__fern_ret_word";
    if (o.width == 64) {
      name = "$__fern_scalar_word" + util.i32_to_string(o.i32_imm);
    }
    if (o.kind_tag == 385) {
      return "    global.get " + name + "\n";
    }
    return "    global.set " + name + "\n    i32.const 0\n";
  }
  if (o.kind_tag == 383) {
    let stride: i32 = 4;
    if (o.width == 8) {
      stride = 1;
    } else if (o.width == 64) {
      stride = 8;
    }
    return "    i32.const " + util.i32_to_string(stride) + "\n    call $__fern_arr_reserve\n";
  }
  if (o.kind_tag == 381) {
    return "    call $__fern_outer_mul_f64\n";
  }
  if (o.kind_tag == 382) {
    return "    call $__fern_inner_mul_add_f64\n";
  }
  if (o.kind_tag == 359) {
    return "    call $__fern_count_byte_bytes\n";
  }
  if (o.kind_tag == 368) {
    return "    call $__fern_sum_bytes_array\n";
  }
  if (o.kind_tag == 369) {
    return "    call $__fern_bsd_sum_bytes\n";
  }
  if (o.kind_tag == 358) {
    return "    call $__fern_memchr_bytes\n";
  }
  if (o.kind_tag == 360) {
    return "    call $__fern_rmemchr_bytes\n";
  }
  if (o.kind_tag == 379) {
    return "    call $__fern_count_runs_bytes\n";
  }
  if (o.kind_tag == 361) {
    return "    call $__fern_scan_set_bytes\n";
  }
  if (o.kind_tag == 378) {
    return "    call $__fern_mismatch_bytes\n";
  }
  if (o.kind_tag == 446) {
    return "    call $__fern_mismatch_bytes_str\n";
  }
  if (o.kind_tag == 97) {
    return "    i32.load\n";
  }
  if (o.kind_tag == 102) {
    return "    call $__fern_substr\n";
  }
  if (o.kind_tag == 225) {
    return "    call $__fern_memchr\n";
  }
  if (o.kind_tag == 245) {
    return "    call $__fern_mismatch\n";
  }
  if (o.kind_tag == 234) {
    return "    call $__fern_rmemchr\n";
  }
  if (o.kind_tag == 235) {
    return "    call $__fern_count_byte\n";
  }
  if (o.kind_tag == 253) {
    return "    call $__fern_sum_bytes\n";
  }
  if (o.kind_tag == 324) {
    return "    call $__fern_scan_set\n";
  }
  if (o.kind_tag == 327) {
    return "    call $__fern_count_runs\n";
  }
  if (o.kind_tag == 390) {
    return "    call $__fern_str_hash\n";
  }
  if (o.kind_tag == 329) {
    return "    call $__fern_bsd_sum\n";
  }
  if (o.kind_tag == 322) {
    return "    i32.const " + util.i32_to_string(o.i32_imm) + "\n    call $__fern_scale_f64\n";
  }
  if (o.kind_tag == 373) {
    return "    call $__fern_crc32_cksum_array\n";
  }
  if (ir.is_aes_gcm_op(o.kind_tag)) {
    return "    call " + wasm_aes.kernel_name(o.kind_tag) + "\n";
  }
  if (ir.is_sha_blocks_op(o.kind_tag)) {
    return "    call $__fern_sha_hw_blocks\n";
  }
  if (o.kind_tag == 309) {
    return "    call $__fern_crc32_cksum\n";
  }
  if (o.kind_tag == 227) {
    return "    call $__fern_ascii_run\n";
  }
  if (o.kind_tag == 104) {
    return "    call $__fern_str_bytes\n";
  }
  if (o.kind_tag == 105) {
    return "    call $__fern_str_split\n";
  }
  if (o.kind_tag == 106) {
    return "    call $__fern_str_upper\n";
  }
  if (o.kind_tag == 107) {
    return "    call $__fern_str_lower\n";
  }
  if (o.kind_tag == 108) {
    return "    call $__fern_str_repeat\n";
  }
  if (o.kind_tag == 109) {
    return "    call $__fern_str_trim\n";
  }
  if (o.kind_tag == 111) {
    return "    call $__fern_str_replace\n";
  }
  if (o.kind_tag == 113) {
    return "    call $__fern_str_lines\n";
  }
  if (o.kind_tag == 98) {
    return "    call $__fern_strcat\n";
  }
  if (o.kind_tag == 99) {
    return "    call $__fern_streq\n";
  }
  if (o.kind_tag == 100) {
    return "    call $__fern_strcmp\n";
  }
  return ircore.unsupported_op_refuse(o.kind_tag, "wasm");
}

function emit_function_ir(ns: string, r: irtables.LowerResult, fd: parser.FuncDecl, str_vals: string[], cagg_vals: string[], structs: irtables.StructTab, fn_table: string[], funcs: parser.FuncDecl[], vgate: irverifygate.Gate): string {
  let fn_name: string = fd.name;
  if (fd.receiver_type.len() > 0) {
    fn_name = util.base_type_name(fd.receiver_type) + "." + fd.name;
  }
  return emit_function_ir_named(ns, r, fn_name, result_wat(r, fd, structs), str_vals, cagg_vals, structs, fn_table, funcs, vgate);
}

function result_wat(r: irtables.LowerResult, fd: parser.FuncDecl, structs: irtables.StructTab): string {
  if (r.result_kind == irtables.result_from_decl() || irtables.erased_passthrough_safe(fd)) {
    return decl_result_wat(fd, structs);
  }
  return produced_result_wat(r);
}

function decl_result_wat(fd: parser.FuncDecl, structs: irtables.StructTab): string {
  if (fd.ret_type == "i64" || fd.ret_type == "u64") {
    return " (result i64)\n";
  }
  if (irtables.is_f64_scalar_type_name(fd.ret_type)) {
    return " (result f64)\n";
  }
  if (fd.ret_type == "f64x2" || fd.ret_type == "f32x4") {
    return " (result v128)\n";
  }
  if (irtables.erased_passthrough_safe(fd)) {
    return " (result i64)\n";
  }
  return " (result i32)\n";
}

function produced_result_wat(r: irtables.LowerResult): string {
  if (r.result_kind == irtables.result_i32()) {
    return " (result i32)\n";
  }
  if (r.result_kind == irtables.result_i64()) {
    return " (result i64)\n";
  }
  if (r.result_kind == irtables.result_f64()) {
    return " (result f64)\n";
  }
  if (r.result_kind == irtables.result_v128()) {
    return " (result v128)\n";
  }
  eprint("error: produced body " + r.name + " carries no result kind");
  exit(3);
  return "";
}

function fallthrough_filler(result_wat: string): string {
  if (util.contains(result_wat, "i64")) {
    return "    i64.const 0)\n";
  }
  if (util.contains(result_wat, "f64")) {
    return "    f64.const 0)\n";
  }
  if (util.contains(result_wat, "v128")) {
    return "    f64.const 0\n    f64x2.splat)\n";
  }
  return "    i32.const 0)\n";
}

// fern-lint: allow cyclomatic-complexity
function emit_function_ir_named(ns: string, r: irtables.LowerResult, fn_name: string, result_wat: string, str_vals: string[], cagg_vals: string[], structs: irtables.StructTab, fn_table: string[], funcs: parser.FuncDecl[], vgate: irverifygate.Gate): string {
  ircore.lower_failed_refuse(fn_name, r);
  irverifygate.verify_or_refuse(fn_name, r.ops, r.n_params, r.n_locals, vgate);
  irverifygate.certify_ops_or_refuse(fn_name, r.ops, r.n_params, r.n_locals, vgate);
  let f: wasmlocals.Frame = wasmlocals.coalesce(r.ops, r.n_params, r.n_locals, r.i64_slots, r.f64_slots, r.v128_slots);
  let arrtmp: i32 = f.n_locals;
  let eltmp: i32 = f.n_locals + 1;
  let f64tmp: i32 = f.n_locals + 2;
  let i64tmp: i32 = f.n_locals + 3;
  let bctmp: i32 = f.n_locals + 4;
  let parts: string[] = [];
  parts = parts.append("  (func $" + fn_name);
  let p: i32 = 0;
  while (p < r.n_params) {
    if (slot_in_list(f.i64_slots, p)) {
      parts = parts.append(" (param i64)");
    } else if (slot_in_list(f.f64_slots, p)) {
      parts = parts.append(" (param f64)");
    } else if (slot_in_list(f.v128_slots, p)) {
      parts = parts.append(" (param v128)");
    } else {
      parts = parts.append(" (param i32)");
    }
    p = p + 1;
  }
  parts = parts.append(result_wat);
  let nbody: i32 = f.n_locals - r.n_params;
  let lanes: boolean = has_lane_op(f.ops);
  let nloc: i32 = nbody + 5;
  if (lanes) {
    nloc = nloc + 2;
  }
  parts = parts.append("    (local");
  let l: i32 = 0;
  while (l < nloc) {
    if (l == nbody + 2) {
      parts = parts.append(" f64");
    } else if (l == nbody + 3) {
      parts = parts.append(" i64");
    } else if (l >= nbody + 5) {
      parts = parts.append(" v128");
    } else if (l < nbody && slot_in_list(f.i64_slots, r.n_params + l)) {
      parts = parts.append(" i64");
    } else if (l < nbody && slot_in_list(f.f64_slots, r.n_params + l)) {
      parts = parts.append(" f64");
    } else if (l < nbody && slot_in_list(f.v128_slots, r.n_params + l)) {
      parts = parts.append(" v128");
    } else {
      parts = parts.append(" i32");
    }
    l = l + 1;
  }
  parts = parts.append(")\n");
  let i: i32 = 0;
  while (i < f.ops.len()) {
    let o: ir.Op = f.ops[i];
    parts = parts.append(emit_ir_op(o, WasmOpCtx { ns: ns, str_vals: str_vals, cagg_vals: cagg_vals, structs: structs, fn_table: fn_table, funcs: funcs, base: f.n_locals }));
    i = i + 1;
  }
  parts = parts.append(fallthrough_filler(result_wat));
  return util.str_join_chunks(parts);
}

pub function emit_functions_view(ns: string, mod: parser.Module, cache: irtables.LowerResult[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, physical: physicalbody.Collection): string {
  mod = parser.infer_ret_types_module(mod);
  let str_vals: string[] = str_values(cache);
  let cagg_vals: string[] = const_agg_values(cache);
  let ft: string[] = fn_value_table(cache);
  let vgate: irverifygate.Gate = irverifygate.with_memo(irverifygate.gate(irtables.fn_sig_index(all_funcs), ir.pops_by_kind(), physicalbody.abis(physical)), irverifygate.open_memo("wasm32"));
  let parts: string[] = [];
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    if (mod.funcs[fi].import_iface.len() == 0 && !cache[fi].superseded) {
      parts = parts.append(emit_function_ir(ns, cache[fi], mod.funcs[fi], str_vals, cagg_vals, all_structs, ft, all_funcs, vgate));
    }
    fi = fi + 1;
  }
  let xi: i32 = mod.funcs.len();
  while (xi < cache.len()) {
    parts = parts.append(emit_function_ir_named(ns, cache[xi], cache[xi].name, produced_result_wat(cache[xi]), str_vals, cagg_vals, all_structs, ft, all_funcs, vgate));
    xi = xi + 1;
  }
  irverifygate.report(vgate);
  irverifygate.close_memo(vgate.memo);
  return util.str_join_chunks(parts);
}

pub function emit_functions_ns(ns: string, mod: parser.Module, cache: irtables.LowerResult[], physical: physicalbody.Collection): string {
  let im: parser.Module = parser.infer_ret_types_module(mod);
  return emit_functions_view(ns, im, cache, im.funcs, irtables.struct_tab(im.structs), physical);
}

function struct_type_id(structs: irtables.StructTab, shape: string): i32 {
  let i: i32 = 0;
  while (i < structs.decls.len()) {
    if (irtables.decl_shape(structs.decls[i]) == shape) {
      return i;
    }
    i = i + 1;
  }
  return 0;
}

pub function build_io_error_p2_func(): string {
  let o: string = "";
  o = o + "  (func $__fern_build_io_error_p2 (param $code i32) (param $path i32) (result i32)\n";
  o = o + "    (call $__fern_build_io_error (call $__fern_errno_p2 (local.get $code)) (local.get $path)))\n";
  return o;
}

pub function errno_p2_func(): string {
  let o: string = "";
  o = o + "  (func $__fern_errno_p2 (param $code i32) (result i32)\n";
  o = o + "    (local $errno i32)\n";
  o = o + "    (local.set $errno (i32.const 44))\n";
  let codes: i32[] = asmcore.wasi_error_code_errnos();
  let ci: i32 = 0;
  while (ci < codes.len()) {
    o = o + "    (if (i32.eq (local.get $code) (i32.const " + util.i32_to_string(ci) + ")) (then (local.set $errno (i32.const " + util.i32_to_string(codes[ci]) + "))))\n";
    ci = ci + 1;
  }
  o = o + "    (local.get $errno))\n";
  return o;
}

function io_err_box_bytes(nfields: i32): string {
  return util.i32_to_string(xbox_bytes(nfields));
}

function io_err_field_off(i: i32): string {
  return util.i32_to_string(xbox_field_off(i));
}

function needs_fd_sync(needs: string[]): boolean {
  return need(needs, "fd_fsync") || need(needs, "fd_fdatasync") || need(needs, "fd_syncfs")
    || need(needs, "fd_drop_cache") || need(needs, "fd_dup_onto") || need(needs, "reader_splice")
    || need(needs, "reader_copy_range") || need(needs, "writer_splice_forever") || need(needs, "clock_set") || need(needs, "clone_file");
}

pub function needs_io_error(needs: string[]): boolean {
  return need(needs, "stat") || need(needs, "lstat") || need(needs, "remove_file") || need(needs, "create_dir_all") || need(needs, "create_dir") || need(needs, "remove_dir") || need(needs, "create_link") || need(needs, "create_symlink") || need(needs, "rename") || need(needs, "set_file_times") || need(needs, "truncate") || need(needs, "read_link") || need_dir_list(needs) || need(needs, "temp_dir") || need(needs, "read_file") || need(needs, "read_file_bytes") || (need(needs, "write_file") || need(needs, "write_file_bytes")) || need_open_file(needs) || need(needs, "writer_write") || (need(needs, "write_some") || need(needs, "write_bytes") || need(needs, "write_some_bytes")) || need(needs, "reader_close") || need(needs, "read_chunk") || need(needs, "read_chunk_bytes") || need(needs, "fd_stat") || need(needs, "reader_seek") || need(needs, "writer_truncate") || need(needs, "fd_flags") || needs_fd_sync(needs);
}

pub function with_strerror_texts(sv: string[]): string[] {
  let texts: string[] = asmcore.strerror_texts();
  let i: i32 = 0;
  while (i < texts.len()) {
    if (util.index_of_str(sv, texts[i]) < 0) {
      sv = sv.append(texts[i]);
    }
    i = i + 1;
  }
  if (util.index_of_str(sv, "Unknown error ") < 0) {
    sv = sv.append("Unknown error ");
  }
  return sv;
}

function refused_errno(): string {
  return "(i32.const -1)";
}

pub function build_io_error_func(sv: string[]): string {
  let o: string = "";
  o = o + "  (func $__fern_build_io_error (param $errno i32) (param $path i32) (result i32)\n";
  o = o + "    (local $r i32) (local $e i32) (local $n i32) (local $t i32) (local $l i32)\n";
  o = o + "    (if (i32.eq (local.get $errno) (i32.const 44)) (then\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(1) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("NotFound")) + "))\n";
  o = o + "      (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0) + ")) (local.get $path))\n";
  o = o + "      (return (local.get $r))))\n";
  o = o + "    (if (i32.eq (local.get $errno) (i32.const 2)) (then\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(1) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("PermissionDenied")) + "))\n";
  o = o + "      (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0) + ")) (local.get $path))\n";
  o = o + "      (return (local.get $r))))\n";
  o = o + "    (if (i32.eq (local.get $errno) (i32.const 20)) (then\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(1) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("AlreadyExists")) + "))\n";
  o = o + "      (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0) + ")) (local.get $path))\n";
  o = o + "      (return (local.get $r))))\n";
  o = o + "    (if (i32.eq (local.get $errno) (i32.const 27)) (then\n";
  o = o + "      (drop (call $__fern_arr_dec (local.get $path)))\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(0) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("Interrupted")) + "))\n";
  o = o + "      (return (local.get $r))))\n";
  o = o + "    (if (i32.eq (local.get $errno) " + refused_errno() + ") (then\n";
  o = o + "      (drop (call $__fern_arr_dec (local.get $path)))\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(0) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("Unsupported")) + "))\n";
  o = o + "      (return (local.get $r))))\n";
  o = o + "    (if (i32.eq (local.get $errno) (i32.const 25)) (then\n";
  o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(1) + ")))\n";
  o = o + "      (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("InvalidUtf8")) + "))\n";
  o = o + "      (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0) + ")) (local.get $path))\n";
  o = o + "      (return (local.get $r))))\n";
  let texts: string[] = asmcore.strerror_texts();
  let wasi: i32[] = asmcore.strerror_wasi();
  let carried: i32[] = asmcore.strerror_carried();
  let ti: i32 = 0;
  while (ti < texts.len()) {
    let en: i32 = wasi[ti];
    if (en != 0 && en != 44 && en != 2 && en != 20 && en != 27 && en != 25) {
      o = o + "    (if (i32.eq (local.get $errno) (i32.const " + util.i32_to_string(en) + ")) (then (local.set $e (i32.const " + util.i32_to_string(offset_of_value(sv, texts[ti])) + ")) (local.set $l (i32.const " + util.i32_to_string(carried[ti]) + "))))\n";
    }
    ti = ti + 1;
  }
  let pfx: string = "Unknown error ";
  let plen: string = util.i32_to_string(pfx.len());
  o = o + "    (if (i32.eqz (local.get $e)) (then\n";
  o = o + "      (local.set $e (call $__fern_str_box (i32.const " + util.i32_to_string(4 + pfx.len() + 10) + ")))\n";
  o = o + "      (memory.copy (i32.add (local.get $e) (i32.const 4)) (i32.const " + util.i32_to_string(offset_of_value(sv, pfx) + 4) + ") (i32.const " + plen + "))\n";
  o = o + "      (local.set $n (i32.const 1)) (local.set $t (local.get $errno))\n";
  o = o + "      (block $dc (loop $dl (br_if $dc (i32.lt_u (local.get $t) (i32.const 10))) (local.set $t (i32.div_u (local.get $t) (i32.const 10))) (local.set $n (i32.add (local.get $n) (i32.const 1))) (br $dl)))\n";
  o = o + "      (i32.store (local.get $e) (i32.add (i32.const " + plen + ") (local.get $n)))\n";
  o = o + "      (local.set $t (i32.add (i32.add (local.get $e) (i32.const " + util.i32_to_string(4 + pfx.len()) + ")) (local.get $n)))\n";
  o = o + "      (local.set $n (local.get $errno))\n";
  o = o + "      (block $wd (loop $wl (local.set $t (i32.sub (local.get $t) (i32.const 1))) (i32.store8 (local.get $t) (i32.add (i32.const 48) (i32.rem_u (local.get $n) (i32.const 10)))) (local.set $n (i32.div_u (local.get $n) (i32.const 10))) (br_if $wd (i32.eqz (local.get $n))) (br $wl)))\n";
  o = o + "    ))\n";
  o = o + "    (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(3) + ")))\n";
  o = o + "    (i32.store (local.get $r) (global.get " + tid_global(io_error_shape("Other")) + "))\n";
  o = o + "    (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0) + ")) (local.get $path))\n";
  o = o + "    (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(1) + ")) (local.get $e))\n";
  o = o + "    (i64.store (i32.add (local.get $r) (i32.const " + io_err_field_off(2) + ")) (i64.extend_i32_u (local.get $l)))\n";
  o = o + "    (local.get $r))\n";
  return o;
}

pub function mulhi_u64_func(): string {
  let o: string = "  (func $__fern_mulhi_u64 (param $a i64) (param $b i64) (result i64)\n";
  o = o + "    (local $al i64) (local $ah i64) (local $bl i64) (local $bh i64) (local $mid i64)\n";
  o = o + "    (local.set $al (i64.and (local.get $a) (i64.const 4294967295)))\n";
  o = o + "    (local.set $ah (i64.shr_u (local.get $a) (i64.const 32)))\n";
  o = o + "    (local.set $bl (i64.and (local.get $b) (i64.const 4294967295)))\n";
  o = o + "    (local.set $bh (i64.shr_u (local.get $b) (i64.const 32)))\n";
  o = o + "    (local.set $mid (i64.add (i64.mul (local.get $ah) (local.get $bl)) (i64.shr_u (i64.mul (local.get $al) (local.get $bl)) (i64.const 32))))\n";
  o = o + "    (i64.add (i64.add (i64.mul (local.get $ah) (local.get $bh)) (i64.shr_u (local.get $mid) (i64.const 32)))\n";
  o = o + "      (i64.shr_u (i64.add (i64.and (local.get $mid) (i64.const 4294967295)) (i64.mul (local.get $al) (local.get $bh))) (i64.const 32))))\n";
  return o;
}

