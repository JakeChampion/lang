  o += "        (i32.store (i32.add (local.get $opt) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
  o += "        (return (local.get $opt))))\n";
  o += "      (br_if $wd (i32.eqz (i32.load (i32.const 8))))\n";
  o += "      (local.set $cur (i32.add (local.get $cur) (i32.load (i32.const 8))))\n";
  o += "      (br $wc)))\n";
  o += "    (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $opt) (i32.const 0))\n";
  o += "    (i32.store (i32.add (local.get $opt) (i32.const 4)) (i32.const 0))\n";
  o += "    (local.get $opt))\n";
  return o;
}

pub function writer_bytes_func(all: boolean, p2: boolean): string {
  let name = "write_some_bytes";
  let more = "      (br $done)\n";
  let success = "    (local.set $res (call $__fern_str_box (i32.const 16))) (i32.store (local.get $res) (i32.const 0))\n    (i64.store offset=8 (local.get $res) (i64.extend_i32_u (local.get $count)))\n    (local.get $res)\n";
  if (all) {
    name = "write_bytes";
    more = "      (local.set $at (i32.add (local.get $at) (local.get $count)))\n      (br_if $done (i32.eq (local.get $at) (local.get $n)))\n      (if (i32.eqz (local.get $count)) (then (local.set $err (i32.const 29)) (br $done)))\n      (br $write)\n";
    success = "    (local.set $res (call $__fern_str_box (i32.const 8))) (i32.store (local.get $res) (i32.const 0))\n    (i32.store offset=4 (local.get $res) (i32.const 0))\n    (local.get $res)\n";
  }
  let o = "";
  o = o + "  (func $__fern_writer_" + name + " (param $fd i32) (param $bytes i32) (result i32)\n";
  o += "    (local $n i32) (local $data i32) (local $at i32) (local $count i32) (local $err i32) (local $res i32) (local $path i32)\n";
  o += byte_view_decode("$bytes", "$data", "$n");
  o += "    (block $done (loop $write\n";
  o += "      (i32.store (i32.const 0) (i32.add (local.get $data) (local.get $at)))\n";
  o = o + "      (i32.store (i32.const 4) " + p2_chunk(p2, "(i32.sub (local.get $n) (local.get $at))") + ")\n";
  o += "      (local.set $err (call $__fern_fd_write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
  o += "      (br_if $done (local.get $err))\n";
  o += "      (local.set $count (i32.load (i32.const 8)))\n";
  o += more;
  o += "    ))\n";
  o += "    (if (local.get $err) (then\n";
  o += "      (local.set $path (call $__fern_str_box (i32.const 4))) (i32.store (local.get $path) (i32.const 0))\n";
  o += "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $res) (i32.const 1))\n";
  o += "      (i32.store offset=4 (local.get $res) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
  o += "      (return (local.get $res))))\n";
  o += success;
  o += "  )\n";
  return o;
}

function p2_chunk(p2: boolean, n: string): string {
  if (!p2) {
    return n;
  }
  return "(select (i32.const 4096) " + n + " (i32.gt_u " + n + " (i32.const 4096)))";
}

pub function writer_write_some_func(p2: boolean): string {
  let o = "";
  o += "  (func $__fern_writer_write_some (param $fd i32) (param $box i32) (result i32)\n";
  o += "    (local $err i32) (local $n i32) (local $res i32) (local $path i32)\n";
  o += "    (local.set $n (i32.load (local.get $box)))\n";
  o += "    (i32.store (i32.const 0) (i32.add (local.get $box) (i32.const 4)))\n";
  o = o + "    (i32.store (i32.const 4) " + p2_chunk(p2, "(local.get $n)") + ")\n";
  o += "    (local.set $err (call $__fern_fd_write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
  o += "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
  o += "      (local.set $path (call $__fern_str_box (i32.const 4)))\n";
  o += "      (i32.store (local.get $path) (i32.const 0))\n";
  o += "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $res) (i32.const 1))\n";
  o += "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
  o += "      (return (local.get $res))))\n";
  o += "    (local.set $res (call $__fern_str_box (i32.const 16)))\n";
  o += "    (i32.store (local.get $res) (i32.const 0))\n";
  o += "    (i64.store (i32.add (local.get $res) (i32.const 8)) (i64.extend_i32_u (i32.load (i32.const 8))))\n";
  o += "    (local.get $res))\n";
  return o;
}

pub function writer_truncate_func(): string {
  let o = "";
  o += "  (func $__fern_writer_truncate (param $fd i32) (param $length i64) (result i32)\n";
  o += "    (local $err i32) (local $opt i32) (local $path i32)\n";
  o += "    (local.set $err (call $__fern_fd_filestat_set_size (local.get $fd) (local.get $length)))\n";
  o += "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
  o += "      (local.set $path (call $__fern_str_box (i32.const 4)))\n";
  o += "      (i32.store (local.get $path) (i32.const 0))\n";
  o += "      (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $opt) (i32.const 1))\n";
  o += "      (i32.store (i32.add (local.get $opt) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
  o += "      (return (local.get $opt))))\n";
  o += "    (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $opt) (i32.const 0))\n";
  o += "    (i32.store (i32.add (local.get $opt) (i32.const 4)) (i32.const 0))\n";
  o += "    (local.get $opt))\n";
  return o;
}

pub function reader_read_chunk_bytes_func(): string {
  let o = "  (func $__fern_reader_read_chunk_bytes (param $fd i32) (param $n i32) (result i32)\n";
  o += "    (local $a i32) (local $source i32) (local $got i32) (local $box i32) (local $err i32) (local $path i32)\n";
  o += "    (if (i32.lt_s (local.get $n) (i32.const 0)) (then (local.set $err (i32.const 28))) (else\n";
  o += "      (local.set $a (call $__fern_arr_elems (local.get $n) (i32.const 1)))\n";
  o += "      (i32.store (local.get $a) (i32.const 0)) (i32.store offset=4 (local.get $a) (local.get $n))\n";
  o += "      (i32.store (i32.const 0) (i32.add (local.get $a) (i32.const 8)))\n";
  o += "      (i32.store (i32.const 4) (local.get $n))\n";
  o += "      (local.set $err (call $__fern_fd_read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
  o += "      (local.set $got (i32.load (i32.const 8)))))\n";
  o += "    (if (local.get $err) (then\n";
  o += "      (if (local.get $a) (then (drop (call $__fern_arr_dec (local.get $a)))))\n";
  o += "      (local.set $path (call $__fern_str_box (i32.const 4))) (i32.store (local.get $path) (i32.const 0))\n";
  o += "      (local.set $box (call $__fern_str_box (i32.const 8))) (i32.store (local.get $box) (i32.const 1))\n";
  o += "      (i32.store offset=4 (local.get $box) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
  o += "      (return (local.get $box))))\n";
  o += "    (if (i32.lt_u (local.get $got) (local.get $n)) (then\n";
  o += "      (local.set $source (local.get $a))\n";
  o += "      (local.set $a (call $__fern_arr_elems (local.get $got) (i32.const 1)))\n";
  o += "      (i32.store offset=4 (local.get $a) (local.get $got))\n";
  o += "      (memory.copy (i32.add (local.get $a) (i32.const 8)) (i32.add (local.get $source) (i32.const 8)) (local.get $got))\n";
  o += "      (drop (call $__fern_arr_dec (local.get $source)))))\n";
  o += "    (i32.store (local.get $a) (local.get $got))\n";
  o += "    (local.set $box (call $__fern_str_box (i32.const 8))) (i32.store (local.get $box) (i32.const 0))\n";
  o += "    (i32.store offset=4 (local.get $box) (local.get $a))\n";
  return o + "    (local.get $box))\n";
}

pub function reader_read_chunk_func(): string {
  let o = "";
  o += "  (func $__fern_reader_read_chunk (param $fd i32) (param $n i32) (result i32)\n";
  o += "    (local $blk i32) (local $source i32) (local $nread i32) (local $opt i32) (local $err i32) (local $path i32)\n";
  o += "    (if (i32.lt_s (local.get $n) (i32.const 0)) (then (local.set $err (i32.const 28))) (else\n";
  o += "      (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $n))))\n";
  o += "      (i32.store (i32.const 0) (i32.add (local.get $blk) (i32.const 4)))\n";
  o += "      (i32.store (i32.const 4) (local.get $n))\n";
  o += "      (local.set $err (call $__fern_fd_read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
  o += "      (if (i32.eqz (local.get $err)) (then\n";
  o += "        (local.set $nread (i32.load (i32.const 8)))\n";
  o += "        (if (i32.eqz (call $__fern_utf8_valid (i32.add (local.get $blk) (i32.const 4)) (local.get $nread)))\n";
  o += "          (then (local.set $err (i32.const 25))))))))\n";
  o += "    (if (local.get $err) (then\n";
  o += "      (if (local.get $blk) (then (drop (call $__fern_arr_dec (local.get $blk)))))\n";
  o += "      (local.set $path (call $__fern_str_box (i32.const 4)))\n";
  o += "      (i32.store (local.get $path) (i32.const 0))\n";
  o += "      (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $opt) (i32.const 1))\n";
  o += "      (i32.store offset=4 (local.get $opt) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
  o += "      (return (local.get $opt))))\n";
  o += "    (if (i32.lt_u (local.get $nread) (local.get $n)) (then\n";
  o += "      (local.set $source (local.get $blk))\n";
  o += "      (local.set $blk (call $__fern_str_box (i32.add (local.get $nread) (i32.const 4))))\n";
  o += "      (memory.copy (i32.add (local.get $blk) (i32.const 4)) (i32.add (local.get $source) (i32.const 4)) (local.get $nread))\n";
  o += "      (drop (call $__fern_arr_dec (local.get $source)))))\n";
  o += "    (i32.store (local.get $blk) (local.get $nread))\n";
  o += "    (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $opt) (i32.const 0))\n";
  o += "    (i32.store offset=4 (local.get $opt) (local.get $blk))\n";
  o += "    (local.get $opt))\n";
  return o;
}

pub function reader_close_func(dir_off: boolean): string {
  let o = "";
  o += "  (func $__fern_reader_close (param $fd i32) (result i32)\n";
  o += "    (local $opt i32) (local $err i32) (local $path i32)\n";
  if (dir_off) {
    o += "    (call $__fern_dir_off_forget (local.get $fd))\n";
  }
  o += "    (local.set $err (call $__fern_fd_close (local.get $fd)))\n";
  o += "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
  o += "      (local.set $path (call $__fern_str_box (i32.const 4)))\n";
  o += "      (i32.store (local.get $path) (i32.const 0))\n";
  o += "      (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $opt) (i32.const 1))\n";
  o += "      (i32.store (i32.add (local.get $opt) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
  o += "      (return (local.get $opt))))\n";
  o += "    (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $opt) (i32.const 0))\n";
  o += "    (i32.store (i32.add (local.get $opt) (i32.const 4)) (i32.const 0))\n";
  o += "    (local.get $opt))\n";
  return o;
}

pub function cabi_realloc_helper(): string {
  let o = "";
  o += "  (global $__fern_lend (mut i32) (i32.const 0))\n";
  o += "  (global $__fern_lend_cap (mut i32) (i32.const 0))\n";
  o += "  (func $__fern_cabi_realloc (param $op i32) (param $os i32) (param $al i32) (param $ns i32) (result i32)\n";
  o += "    (if (i32.and (i32.and (i32.eqz (local.get $op)) (i32.ne (global.get $__fern_lend) (i32.const 0))) (i32.and (i32.ne (local.get $ns) (i32.const 0)) (i32.le_u (local.get $ns) (global.get $__fern_lend_cap)))) (then\n";
  o += "      (local.set $op (global.get $__fern_lend))\n";
  o += "      (global.set $__fern_lend (i32.const 0))\n";
  o += "      (return (local.get $op))))\n";
  o += "    (global.set $heap (i32.and (i32.add (global.get $heap) (i32.sub (local.get $al) (i32.const 1))) (i32.sub (i32.const 0) (local.get $al))))\n";
  o += "    (if (i32.eqz (local.get $ns)) (then (return (global.get $heap))))\n";
  o += "    (call $__fern_alloc (local.get $ns)))\n";
  o += "  (export \"cabi_realloc\" (func $__fern_cabi_realloc))\n";
  return o;
}

pub function divrem64_helpers(): string {
  let bad: string = "(i32.or (i64.eqz (local.get $b))"
    + " (i32.and (i64.eq (local.get $a) (i64.const -9223372036854775808))"
    + " (i64.eq (local.get $b) (i64.const -1))))";
  let parts: string[] = [];
  parts = parts.append("  (func $__fern_idiv64 (param $a i64) (param $b i64) (result i64)\n");
  parts = parts.append("    (local $safe i64)\n");
  parts = parts.append("    (local.set $safe (select (i64.const 1) (local.get $b) " + bad + "))\n");
  parts = parts.append("    (select (i64.const 0) (i64.div_s (local.get $a) (local.get $safe)) (i64.eqz (local.get $b))))\n");
  parts = parts.append("  (func $__fern_irem64 (param $a i64) (param $b i64) (result i64)\n");
  parts = parts.append("    (local $safe i64)\n");
  parts = parts.append("    (local.set $safe (select (i64.const 1) (local.get $b) " + bad + "))\n");
  parts = parts.append("    (select (local.get $a) (i64.rem_s (local.get $a) (local.get $safe)) (i64.eqz (local.get $b))))\n");
  return util.str_join_chunks(parts);
}

pub function udivrem_helpers(t: string, suffix: string): string {
  let safe = "    (local.set $safe (select (" + t + ".const 1) (local.get $b) (" + t + ".eqz (local.get $b))))\n";
  let parts: string[] = [];
  parts = parts.append("  (func $__fern_udiv" + suffix + " (param $a " + t + ") (param $b " + t + ") (result " + t + ")\n");
  parts = parts.append("    (local $safe " + t + ")\n" + safe);
  parts = parts.append("    (select (" + t + ".const 0) (" + t + ".div_u (local.get $a) (local.get $safe)) (" + t + ".eqz (local.get $b))))\n");
  parts = parts.append("  (func $__fern_urem" + suffix + " (param $a " + t + ") (param $b " + t + ") (result " + t + ")\n");
  parts = parts.append("    (local $safe " + t + ")\n" + safe);
  parts = parts.append("    (select (local.get $a) (" + t + ".rem_u (local.get $a) (local.get $safe)) (" + t + ".eqz (local.get $b))))\n");
  return util.str_join_chunks(parts);
}

pub function lc_globals(lc: boolean): string {
  if (!lc) {
    return "";
  }
  let o = "  (global $__fern_lc_alloc_count (mut i64) (i64.const 0))\n";
  o += "  (global $__fern_lc_alloc_bytes (mut i64) (i64.const 0))\n";
  o += "  (global $__fern_lc_free_count (mut i64) (i64.const 0))\n";
  o += "  (global $__fern_lc_free_bytes (mut i64) (i64.const 0))\n";
  o += "  (global $__fern_lc_exited (mut i32) (i32.const 0))\n";
  return o;
}

function lc_bump_alloc(nexpr: string, lc: boolean): string {
  if (!lc) {
    return "";
  }
  let o = "    (global.set $__fern_lc_alloc_count (i64.add (global.get $__fern_lc_alloc_count) (i64.const 1)))\n";
  o = o + "    (global.set $__fern_lc_alloc_bytes (i64.add (global.get $__fern_lc_alloc_bytes) (i64.extend_i32_u " + nexpr + ")))\n";
  return o;
}

function lc_bump_free(nexpr: string, lc: boolean): string {
  if (!lc) {
    return "";
  }
  let o = "    (global.set $__fern_lc_free_count (i64.add (global.get $__fern_lc_free_count) (i64.const 1)))\n";
  o = o + "    (global.set $__fern_lc_free_bytes (i64.add (global.get $__fern_lc_free_bytes) (i64.extend_i32_u " + nexpr + ")))\n";
  return o;
}

function lc_label(text: string): string {
  let o = "";
  let i = 0;
  while (i < text.len()) {
    let left = text.len() - i;
    let width = 1;
    if (left >= 4) {
      width = 4;
    } else if (left >= 2) {
      width = 2;
    }
    let word = 0;
    let k = width - 1;
    while (k >= 0) {
      word = word * 256 + text[i + k] as i32;
      k -= 1;
    }
    let op = "i32.store8";
    if (width == 4) {
      op = "i32.store";
    } else if (width == 2) {
      op = "i32.store16";
    }
    let at = "(local.get $b)";
    if (i > 0) {
      at = "(i32.add (local.get $b) (i32.const " + util.i32_to_string(i) + "))";
    }
    o = o + "    (" + op + " " + at + " (i32.const " + util.i32_to_string(word) + "))\n";
    i += width;
  }
  return o + "    (call $__fern_lc_wr (local.get $b) (i32.const " + util.i32_to_string(text.len()) + "))\n";
}

pub function lc_report_and_exit_wrapper(lc: boolean, sanitize: boolean, set_args: boolean, dir_off: boolean): string {
  if (!lc) {
    return "";
  }
  let tables = "";
  if (dir_off) {
    tables = dir_off_release();
  }
  return lc_report_funcs(sanitize, set_args, tables) + "  (func $__fern_proc_exit (param $c i32)\n    (global.set $__fern_lc_exited (i32.const 1))\n    (call $__fern_lc_report)\n    (call $__fern_proc_exit_raw (local.get $c)))\n";
}

function fdt_release(): string {
  let o = "    (if (global.get $__fern_fdt) (then\n";
  o += "      (call $__fern_raw_free (global.get $__fern_fdt) (i32.shl (global.get $__fern_fdt_cap) (i32.const 5)))\n";
  return o + "      (global.set $__fern_fdt (i32.const 0))))\n";
}

function dir_off_release(): string {
  let o = "    (if (global.get $__fern_dir_off) (then\n";
  o += "      (call $__fern_raw_free (global.get $__fern_dir_off) (i32.shl (global.get $__fern_dir_off_cap) (i32.const 3)))\n";
  return o + "      (global.set $__fern_dir_off (i32.const 0))))\n";
}

function lc_exit_report(lc: boolean): string {
  if (!lc) {
    return "";
  }
  return "    (global.set $__fern_lc_exited (i32.const 1))\n    (call $__fern_lc_report)\n";
}

function main_result_wat(mod: parser.Module): string {
  for fd in mod.funcs {
    if (fd.name == "main" && fd.receiver_type.len() == 0 && (fd.ret_type == "i64" || fd.ret_type == "u64")) {
      return "(i32.wrap_i64 (call $main))";
    }
  }
  return "(call $main)";
}

function low_byte_wat(result: string): string {
  return "(i32.and " + result + " (i32.const 255))";
}

function component_run_entry(report: boolean, sanitize: boolean, set_args: boolean, fdt: boolean, call_main: string): string {
  if (!report) {
    return "  (func $__fern_lang_run (result i32) (i32.eqz (i32.eqz " + call_main + ")))\n";
  }
  let tables = "";
  if (fdt) {
    tables = fdt_release();
  }
  return lc_report_funcs(sanitize, set_args, tables) + "  (func $__fern_lang_run (result i32) (local $r i32)\n    (local.set $r " + call_main + ")\n    (call $__fern_lc_report)\n    (i32.eqz (i32.eqz (local.get $r))))\n";
}

function lc_report_funcs(sanitize: boolean, set_args: boolean, tables: string): string {
  let o = "";
  o += "  (func $__fern_lc_wr (param $p i32) (param $len i32)\n";
  o += "    (i32.store (i32.const 0) (local.get $p))\n";
  o += "    (i32.store (i32.const 4) (local.get $len))\n";
  o += "    (drop (call $__fern_fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 16))))\n";
  o += "  (func $__fern_lc_wrnum (param $n i64) (param $buf i32)\n";
  o += "    (local $i i32) (local $neg i32)\n";
  o += "    (if (i64.eqz (local.get $n)) (then\n";
  o += "      (i32.store8 (local.get $buf) (i32.const 48))\n";
  o += "      (call $__fern_lc_wr (local.get $buf) (i32.const 1))\n";
  o += "      (return)))\n";
  o += "    (local.set $neg (i64.lt_s (local.get $n) (i64.const 0)))\n";
  o += "    (if (local.get $neg) (then (local.set $n (i64.sub (i64.const 0) (local.get $n)))))\n";
  o += "    (local.set $i (i32.add (local.get $buf) (i32.const 24)))\n";
  o += "    (block $d (loop $l\n";
  o += "      (br_if $d (i64.eqz (local.get $n)))\n";
  o += "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
  o += "      (i32.store8 (local.get $i) (i32.wrap_i64 (i64.add (i64.const 48) (i64.rem_u (local.get $n) (i64.const 10)))))\n";
  o += "      (local.set $n (i64.div_u (local.get $n) (i64.const 10)))\n";
  o += "      (br $l)))\n";
  o += "    (if (local.get $neg) (then\n";
  o += "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
  o += "      (i32.store8 (local.get $i) (i32.const 45))))\n";
  o += "    (call $__fern_lc_wr (local.get $i) (i32.sub (i32.add (local.get $buf) (i32.const 24)) (local.get $i))))\n";
  o += "  (func $__fern_lc_report\n";
  o += "    (local $b i32) (local $na i64) (local $nf i64) (local $live i64)\n";
  if (set_args) {
    o += "    (if (global.get $__fern_args_set) (then\n";
    o += "      (drop (call $__fern_arr_dec_ptr (global.get $__fern_args_set)))\n";
    o += "      (global.set $__fern_args_set (i32.const 0))))\n";
  }
  o += tables;
  o += "    (local.set $na (global.get $__fern_lc_alloc_count))\n";
  o += "    (local.set $nf (global.get $__fern_lc_free_count))\n";
  o += "    (local.set $live (i64.sub (global.get $__fern_lc_alloc_bytes) (global.get $__fern_lc_free_bytes)))\n";
  o += "    (local.set $b (i32.const 40))\n";
  o += lc_label("leakcheck: allocs=");
  o += "    (call $__fern_lc_wrnum (local.get $na) (local.get $b))\n";
  o += lc_label(" frees=");
  o += "    (call $__fern_lc_wrnum (local.get $nf) (local.get $b))\n";
  o += lc_label(" live_bytes=");
  o += "    (call $__fern_lc_wrnum (local.get $live) (local.get $b))\n";
  o += "    (if (global.get $__fern_lc_exited) (then\n";
  o += lc_label(" from=exit");
  o += "    ))\n";
  o += lc_label("\n");
  if (sanitize) {
    // The frames above an exit() call are never unwound, so what they hold is no leak.
    o += "    (if (i32.and (i32.eqz (global.get $__fern_lc_exited)) (i64.gt_s (local.get $live) (i64.const 0))) (then\n";
    o += lc_label("fern-sanitizer: leak ");
    o += "    (call $__fern_lc_wrnum (local.get $live) (local.get $b))\n";
    o += lc_label(" bytes in ");
    o += "    (call $__fern_lc_wrnum (i64.sub (local.get $na) (local.get $nf)) (local.get $b))\n";
    o += lc_label(" blocks\n");
    o += "    ))\n";
  }
  o += "  )\n";
  return o;
}

pub function heap_alloc_helpers(heap_base: i32, fl_base: i32, fl_cells: i32, lfl_base: i32, count: boolean, lc: boolean): string {
  let hb = util.i32_to_string(heap_base);
  let pages: i32 = (heap_base + 65535) / 65536;
  if (pages < 16) {
    pages = 16;
  }
  let flb = util.i32_to_string(fl_base);
  let flc = util.i32_to_string(fl_cells);
  let lflb = util.i32_to_string(lfl_base);
  let o = "";
  o += "  (global $__fern_rc_underflow (mut i32) (i32.const 0))\n";
  o = o + "  (global $__fern_heap_base i32 (i32.const " + hb + "))\n";
  o = o + "  (global $heap (mut i32) (i32.const " + hb + "))\n";
  o = o + "  (global $__fern_heap_pages (mut i32) (i32.const " + util.i32_to_string(pages) + "))\n";
  if (count) {
    o += "  (global $__fern_alloc_count (mut i64) (i64.const 0))\n";
  }
  o += "  (func $__fern_capw (param $w i32) (result i32)\n";
  o += "    (local $g i32)\n";
  o += "    (if (i32.le_u (local.get $w) (i32.const 256)) (then (return (local.get $w))))\n";
  o = o + "    (if (i32.ge_u (local.get $w) (i32.const " + flc + ")) (then (return (local.get $w))))\n";
  o += "    (local.set $g (i32.shl (i32.const 1) (i32.sub (i32.const 29) (i32.clz (local.get $w)))))\n";
  o += "    (local.set $w (i32.and (i32.add (local.get $w) (i32.sub (local.get $g) (i32.const 1))) (i32.sub (i32.const 0) (local.get $g))))\n";
  o = o + "    (if (i32.ge_u (local.get $w) (i32.const " + flc + ")) (then (return (i32.sub (i32.const " + flc + ") (i32.const 1)))))\n";
  o += "    (local.get $w))\n";
  o += "  (func $__fern_alloc (param $n i32) (result i32)\n";
  o += "    (local $p i32) (local $cls i32) (local $head i32)\n";
  o += "    (if (i32.gt_u (local.get $n) (i32.const 2147483647)) (then (call $__fern_abort_alloc) (unreachable)))\n";
  o += "    (local.set $n (i32.and (i32.add (local.get $n) (i32.const 7)) (i32.const -8)))\n";
  o += lc_bump_alloc("(local.get $n)", lc);
  if (count) {
    o += "    (global.set $__fern_alloc_count (i64.add (global.get $__fern_alloc_count) (i64.const 1)))\n";
  }
  o += "    (local.set $cls (call $__fern_capw (i32.shr_u (local.get $n) (i32.const 3))))\n";
  o = o + "    (if (i32.lt_u (local.get $cls) (i32.const " + flc + ")) (then\n";
  o += "      (local.set $n (i32.shl (local.get $cls) (i32.const 3)))\n";
  o = o + "      (local.set $head (i32.load (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4)))))\n";
  o += "      (if (local.get $head) (then\n";
  o = o + "        (i32.store (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4))) (i32.load (i32.add (local.get $head) (i32.const 4))))\n";
  o += "        (return (local.get $head)))))\n";
  o += "    (else (if (i32.le_u (local.get $n) (i32.const 1073741824)) (then\n";
  o += "      (local.set $n (call $__fern_large_cap (local.get $n)))\n";
  o += "      (local.set $cls (call $__fern_large_cls (local.get $n)))\n";
  o = o + "      (local.set $head (i32.load (i32.add (i32.const " + lflb + ") (i32.mul (local.get $cls) (i32.const 4)))))\n";
  o += "      (if (local.get $head) (then\n";
  o = o + "        (i32.store (i32.add (i32.const " + lflb + ") (i32.mul (local.get $cls) (i32.const 4))) (i32.load (i32.add (local.get $head) (i32.const 4))))\n";
  o += "        (return (local.get $head))))))))\n";
  // Adapter allocations can grow memory without advancing the guest heap.
  o += "    (if (i32.gt_u (memory.size) (global.get $__fern_heap_pages)) (then\n";
  o += "      (if (i32.ge_u (memory.size) (i32.const 65536)) (then (call $__fern_abort_oom) (unreachable)))\n";
  o += "      (global.set $heap (i32.shl (memory.size) (i32.const 16)))\n";
  o += "      (global.set $__fern_heap_pages (memory.size))))\n";
  o += "    (local.set $p (global.get $heap))\n";
  o += "    (global.set $heap (i32.add (global.get $heap) (local.get $n)))\n";
  o += "    (if (i32.lt_u (global.get $heap) (local.get $p)) (then (call $__fern_abort_oom) (unreachable)))\n";
  o += "    (if (i32.gt_u (global.get $heap) (i32.mul (memory.size) (i32.const 65536)))\n";
  o += "      (then (if (i32.eq (memory.grow (i32.div_u (i32.add (i32.sub (global.get $heap) (i32.mul (memory.size) (i32.const 65536))) (i32.const 65535)) (i32.const 65536))) (i32.const -1)) (then (call $__fern_abort_oom) (unreachable)))))\n";
  o += "    (global.set $__fern_heap_pages (memory.size))\n";
  o += "    (local.get $p))\n";
  o += "  (func $__fern_large_cap (param $n i32) (result i32)\n";
  o += "    (local $g i32)\n";
  o += "    (if (i32.lt_u (local.get $n) (i32.const 524288)) (then (local.set $n (i32.const 524288))))\n";
  o += "    (local.set $g (i32.shl (i32.const 1) (i32.sub (i32.const 29) (i32.clz (local.get $n)))))\n";
  o += "    (i32.and (i32.sub (i32.add (local.get $n) (local.get $g)) (i32.const 1)) (i32.sub (i32.const 0) (local.get $g))))\n";
  o += "  (func $__fern_large_cls (param $cap i32) (result i32)\n";
  o += "    (local $s i32)\n";
  o += "    (local.set $s (i32.sub (i32.const 29) (i32.clz (local.get $cap))))\n";
  o += "    (i32.sub (i32.add (i32.shr_u (local.get $cap) (local.get $s)) (i32.shl (local.get $s) (i32.const 2))) (i32.const 72)))\n";
  o += "  (func $__fern_large_push (param $base i32) (param $bytes i32)\n";
  o += "    (local $slot i32)\n";
  o += "    (if (i32.gt_u (local.get $bytes) (i32.const 1073741824)) (then (return)))\n";
  o = o + "    (local.set $slot (i32.add (i32.const " + lflb + ") (i32.mul (call $__fern_large_cls (call $__fern_large_cap (local.get $bytes))) (i32.const 4))))\n";
  o += "    (if (i32.eq (local.get $base) (i32.load (local.get $slot))) (then (call $__fern_abort_double_free) (unreachable)))\n";
  o += "    (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (local.get $slot)))\n";
  o += "    (i32.store (local.get $slot) (local.get $base)))\n";
  o += "  (func $__fern_account_entry (param $kind i32) (param $key i32) (result i32) (i32.const 0))\n";
  o += "  (func $__fern_str_grow (param $a i32) (param $b i32) (result i32)\n";
  o += "    (call $__fern_str_grow_bytes (local.get $a) (i32.add (local.get $b) (i32.const 4)) (i32.load (local.get $b))))\n";
  o += "  (func $__fern_str_grow_range (param $a i32) (param $s i32) (param $lo i32) (param $hi i32) (result i32)\n";
  o += "    (if (i32.or (i32.lt_s (local.get $lo) (i32.const 0)) (i32.or (i32.lt_s (local.get $hi) (local.get $lo)) (i32.gt_s (local.get $hi) (i32.load (local.get $s))))) (then (return (i32.const 0))))\n";
  o += "    (call $__fern_str_grow_bytes (local.get $a) (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $lo)) (i32.sub (local.get $hi) (local.get $lo))))\n";
  o += "  (func $__fern_str_grow_bytes (param $a i32) (param $src i32) (param $lb i32) (result i32)\n";
  o += "    (local $la i32) (local $bsz i32) (local $cap i32)\n";
  o += "    (if (i32.eqz (local.get $a)) (then (return (i32.const 0))))\n";
  o += "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (i32.const 0))))\n";
  o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + hb + ")) (then (return (i32.const 0))))\n";
  o += "    (if (i32.ne (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then (return (i32.const 0))))\n";
  o += "    (local.set $la (i32.load (local.get $a)))\n";
  o += "    (if (i32.gt_u (i32.add (local.get $la) (local.get $lb)) (i32.const 1073741824)) (then (return (i32.const 0))))\n";
  o += "    (local.set $bsz (i32.load (i32.sub (local.get $a) (i32.const 4))))\n";
  o += "    (local.set $cap (call $__fern_capw (i32.shr_u (local.get $bsz) (i32.const 3))))\n";
  o = o + "    (if (i32.lt_u (local.get $cap) (i32.const " + flc + "))\n";
  o += "      (then (local.set $cap (i32.shl (local.get $cap) (i32.const 3))))\n";
  o += "      (else (if (i32.gt_u (local.get $bsz) (i32.const 1073741824))\n";
  o += "        (then (local.set $cap (local.get $bsz)))\n";
  o += "        (else (local.set $cap (call $__fern_large_cap (local.get $bsz)))))))\n";
  o += "    (if (i32.gt_u (i32.and (i32.add (i32.add (local.get $la) (local.get $lb)) (i32.const 19)) (i32.const -8)) (local.get $cap)) (then (return (i32.const 0))))\n";
  o += "    (memory.copy (i32.add (i32.add (local.get $a) (i32.const 4)) (local.get $la)) (local.get $src) (local.get $lb))\n";
  o += "    (i32.store (local.get $a) (i32.add (local.get $la) (local.get $lb)))\n";
  o += "    (i32.const 1))\n";
  o += "  (func $__fern_str_grow_fresh (param $a i32) (param $b i32) (result i32)\n";
  o += "    (call $__fern_str_grow_fresh_bytes (local.get $a) (i32.add (local.get $b) (i32.const 4)) (i32.load (local.get $b))))\n";
  o += "  (func $__fern_str_grow_fresh_range (param $a i32) (param $s i32) (param $lo i32) (param $hi i32) (result i32)\n";
  o += "    (if (i32.or (i32.lt_s (local.get $lo) (i32.const 0)) (i32.or (i32.lt_s (local.get $hi) (local.get $lo)) (i32.gt_s (local.get $hi) (i32.load (local.get $s))))) (then (call $__fern_abort_str) (unreachable)))\n";
  o += "    (call $__fern_str_grow_fresh_bytes (local.get $a) (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $lo)) (i32.sub (local.get $hi) (local.get $lo))))\n";
  o += "  (func $__fern_str_grow_fresh_bytes (param $a i32) (param $src i32) (param $lb i32) (result i32)\n";
  o += "    (local $la i32) (local $need i32) (local $n i32) (local $w i32) (local $base i32)\n";
  o += "    (local.set $la (i32.load (local.get $a)))\n";
  o += "    (if (i32.gt_u (i32.add (local.get $la) (local.get $lb)) (i32.const 1073741824)) (then (call $__fern_abort_alloc) (unreachable)))\n";
  o += "    (local.set $need (i32.and (i32.add (i32.add (local.get $la) (local.get $lb)) (i32.const 19)) (i32.const -8)))\n";
  o += "    (local.set $n (i32.shl (i32.and (i32.add (local.get $la) (i32.const 19)) (i32.const -8)) (i32.const 1)))\n";
  o += "    (if (i32.lt_u (local.get $n) (local.get $need)) (then (local.set $n (local.get $need))))\n";
  o += "    (local.set $w (call $__fern_capw (i32.shr_u (local.get $n) (i32.const 3))))\n";
  o = o + "    (if (i32.lt_u (local.get $w) (i32.const " + flc + "))\n";
  o += "      (then (local.set $n (i32.shl (local.get $w) (i32.const 3))))\n";
  o += "      (else (if (i32.le_u (local.get $n) (i32.const 1073741824)) (then (local.set $n (call $__fern_large_cap (local.get $n)))))))\n";
  o += "    (local.set $base (call $__fern_alloc (local.get $n)))\n";
  o += "    (i32.store (local.get $base) (i32.const 1))\n";
  o += "    (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $n))\n";
  o += "    (i32.store (i32.add (local.get $base) (i32.const 8)) (i32.add (local.get $la) (local.get $lb)))\n";
  o += "    (memory.copy (i32.add (local.get $base) (i32.const 12)) (i32.add (local.get $a) (i32.const 4)) (local.get $la))\n";
  o += "    (memory.copy (i32.add (i32.add (local.get $base) (i32.const 12)) (local.get $la)) (local.get $src) (local.get $lb))\n";
  o += "    (i32.add (local.get $base) (i32.const 8)))\n";
  o += "  (func $__fern_raw_free (param $base i32) (param $bytes i32)\n";
  o += "    (local $cls i32) (local $slot i32)\n";
  o += "    (if (i32.eqz (local.get $base)) (then (return)))\n";
  o = o + "    (if (i32.lt_u (local.get $base) (i32.const " + hb + ")) (then (call $__fern_abort_free_range) (unreachable)))\n";
  // A zero-byte allocation can equal the heap cursor without advancing it.
  o += "    (if (i32.or (i32.gt_u (local.get $base) (global.get $heap)) (i32.and (i32.eq (local.get $base) (global.get $heap)) (i32.ne (local.get $bytes) (i32.const 0)))) (then (call $__fern_abort_free_range) (unreachable)))\n";
  o += "    (local.set $bytes (i32.and (i32.add (local.get $bytes) (i32.const 7)) (i32.const -8)))\n";
  o += lc_bump_free("(local.get $bytes)", lc);
  o += "    (if (i32.lt_u (local.get $bytes) (i32.const 8)) (then (return)))\n";
  o += "    (local.set $cls (call $__fern_capw (i32.shr_u (local.get $bytes) (i32.const 3))))\n";
  o = o + "    (if (i32.lt_u (local.get $cls) (i32.const " + flc + ")) (then\n";
  o = o + "      (local.set $slot (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4))))\n";
  o += "      (if (i32.eq (local.get $base) (i32.load (local.get $slot))) (then (call $__fern_abort_double_free) (unreachable)))\n";
  o += "      (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (local.get $slot)))\n";
  o += "      (i32.store (local.get $slot) (local.get $base))\n";
  o += "      (return)))\n";
  o += "    (call $__fern_large_push (local.get $base) (local.get $bytes)))\n";
  o += "  (func $__fern_arr_box (param $eb i32) (result i32)\n";
  o += "    (local $base i32) (local $n i32)\n";
  o += "    (local.set $n (i32.and (i32.add (i32.add (i32.const 16) (local.get $eb)) (i32.const 7)) (i32.const -8)))\n";
  o += "    (local.set $base (call $__fern_alloc (local.get $n)))\n";
  o += "    (i32.store (local.get $base) (i32.const 1))\n";
  o += "    (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $n))\n";
  o += "    (i32.add (local.get $base) (i32.const 8)))\n";
  o += "  (func $__fern_arr_elems (param $n i32) (param $stride i32) (result i32)\n";
  o += "    (local $b i64)\n";
  o += "    (local.set $b (i64.mul (i64.extend_i32_u (local.get $n)) (i64.extend_i32_u (local.get $stride))))\n";
  o += "    (if (i64.gt_u (local.get $b) (i64.const 2147483631)) (then (call $__fern_abort_alloc) (unreachable)))\n";
  o += "    (call $__fern_arr_box (i32.wrap_i64 (local.get $b))))\n";
  o += "  (func $__fern_str_box (param $p i32) (result i32)\n";
  o += "    (local $base i32) (local $n i32)\n";
  o += "    (local.set $n (i32.and (i32.add (i32.add (i32.const 8) (local.get $p)) (i32.const 7)) (i32.const -8)))\n";
  o += "    (local.set $base (call $__fern_alloc (local.get $n)))\n";
  o += "    (i32.store (local.get $base) (i32.const 1))\n";
  o += "    (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $n))\n";
  o += "    (i32.add (local.get $base) (i32.const 8)))\n";
  o += "  (func $__fern_alloc_reuse (param $t i32) (param $nf i32) (result i32)\n";
  o += "    (local $want i32) (local $base i32) (local $cls i32)\n";
  o += "    (local.set $want (i32.add (i32.const 8) (i32.mul (local.get $nf) (i32.const 8))))\n";
  o += "    (if (i32.eqz (local.get $t)) (then\n";
  o += "      (return (call $__fern_str_box (i32.mul (local.get $nf) (i32.const 8))))))\n";
  o += "    (local.set $base (i32.sub (local.get $t) (i32.const 8)))\n";
  o += "    (if (i32.eq (i32.load (i32.add (local.get $base) (i32.const 4))) (local.get $want)) (then\n";
  o += "      (return (local.get $t))))\n";
  o += lc_bump_free("(i32.load (i32.add (local.get $base) (i32.const 4)))", lc);
  o += "    (local.set $cls (call $__fern_capw (i32.shr_u (i32.load (i32.add (local.get $base) (i32.const 4))) (i32.const 3))))\n";
  o += "    (i32.store (local.get $base) (i32.const 0))\n";
  o = o + "    (if (i32.lt_u (local.get $cls) (i32.const " + flc + ")) (then\n";
  o = o + "      (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4)))))\n";
  o = o + "      (i32.store (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4))) (local.get $base)))\n";
  o += "    (else (call $__fern_large_push (local.get $base) (i32.load (i32.add (local.get $base) (i32.const 4))))))\n";
  o += "    (call $__fern_str_box (i32.mul (local.get $nf) (i32.const 8))))\n";
  o += "  (func $__fern_arr_dec (param $a i32) (result i32)\n";
  o += "    (local $base i32) (local $rc i32) (local $cls i32)\n";
  o += "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
  o += "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (local.get $a))))\n";
  o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + hb + ")) (then (return (local.get $a))))\n";
  o += "    (local.set $base (i32.sub (local.get $a) (i32.const 8)))\n";
  o += "    (local.set $rc (i32.load (local.get $base)))\n";
  o += "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (local.get $a))))\n";
  o += "    (if (i32.gt_s (local.get $rc) (i32.const 1)) (then\n";
  o += "      (i32.store (local.get $base) (i32.sub (local.get $rc) (i32.const 1)))\n";
  o += "      (return (local.get $a))))\n";
  o += "    (if (i32.le_s (local.get $rc) (i32.const 0)) (then\n";
  o += "      (global.set $__fern_rc_underflow (i32.add (global.get $__fern_rc_underflow) (i32.const 1)))\n";
  o += "      (return (local.get $a))))\n";
  o += lc_bump_free("(i32.load (i32.add (local.get $base) (i32.const 4)))", lc);
  o += "    (local.set $cls (call $__fern_capw (i32.shr_u (i32.load (i32.add (local.get $base) (i32.const 4))) (i32.const 3))))\n";
  o += "    (i32.store (local.get $base) (i32.const 0))\n";
  o = o + "    (if (i32.lt_u (local.get $cls) (i32.const " + flc + ")) (then\n";
  o = o + "      (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4)))))\n";
  o = o + "      (i32.store (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4))) (local.get $base)))\n";
  o += "    (else (call $__fern_large_push (local.get $base) (i32.load (i32.add (local.get $base) (i32.const 4))))))\n";
  o += "    (local.get $a))\n";
  o += "  (func $__fern_arr_dec_ptr (param $a i32) (result i32)\n";
  o += "    (local $i i32) (local $n i32)\n";
  o += "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
  o += "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (local.get $a))))\n";
  o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + hb + ")) (then (return (local.get $a))))\n";
  o += "    (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
  o += "      (local.set $n (i32.load (local.get $a)))\n";
  o += "      (local.set $i (i32.const 0))\n";
  o += "      (block $adp_done (loop $adp_lp\n";
  o += "        (br_if $adp_done (i32.ge_u (local.get $i) (local.get $n)))\n";
  o += "        (drop (call $__fern_arr_dec (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))))))\n";
  o += "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "        (br $adp_lp))))) \n";
  o += "    (call $__fern_arr_dec (local.get $a)))\n";
  return o;
}

pub function rc_runtime_helpers(heap_base: i32): string {
  let lo = util.i32_to_string(heap_base);
  let o = "";
  o += "  (func $__fern_oob_abort (result i32) (call $__fern_abort_arr) (unreachable))\n";
  o += "  (func $__fern_slice_abort (result i32) (call $__fern_abort_slice) (unreachable))\n";
  o += "  (func $__alloc (param $n i32) (result i32)\n";
  o += "    (call $__fern_alloc (local.get $n)))\n";
  o += "  (func $__free (param $p i32) (result i32)\n";
  o += "    (local.get $p))\n";
  o += "  (func $__load_i32 (param $a i32) (result i32)\n";
  o += "    (i32.load (local.get $a)))\n";
  o += "  (func $__store_i32 (param $a i32) (param $v i32) (result i32)\n";
  o += "    (i32.store (local.get $a) (local.get $v))\n";
  o += "    (local.get $a))\n";
  o += "  (func $__fern_rc_inc (param $p i32) (result i32)\n";
  o += "    (local $rc i32)\n";
  o += "    (local $base i32)\n";
  o += "    (if (i32.eqz (local.get $p)) (then (return (local.get $p))))\n";
  o += "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (local.get $p))))\n";
  o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (local.get $p))))\n";
  o += "    (local.set $base (i32.and (local.get $p) (i32.const -3)))\n";
  o += "    (local.set $rc (i32.load (i32.sub (local.get $base) (i32.const 8))))\n";
  o += "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (local.get $p))))\n";
  o += "    (i32.store (i32.sub (local.get $base) (i32.const 8)) (i32.add (local.get $rc) (i32.const 1)))\n";
  o += "    (local.get $p))\n";
  o += "  (func $__fern_rc_dec (param $p i32) (result i32)\n";
  o += "    (local $rc i32)\n";
  o += "    (if (i32.eqz (local.get $p)) (then (return (local.get $p))))\n";
  o += "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (local.get $p))))\n";
  o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (local.get $p))))\n";
  o += "    (local.set $rc (i32.load (i32.sub (local.get $p) (i32.const 8))))\n";
  o += "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (local.get $p))))\n";
  o += "    (if (i32.le_s (local.get $rc) (i32.const 0))\n";
  o += "      (then (global.set $__fern_rc_underflow (i32.add (global.get $__fern_rc_underflow) (i32.const 1)))))\n";
  o += "    (i32.store (i32.sub (local.get $p) (i32.const 8)) (i32.sub (local.get $rc) (i32.const 1)))\n";
  o += "    (local.get $p))\n";
  o += "  (func $__fern_rc_is_unique (param $p i32) (result i32)\n";
  o += "    (local $rc i32)\n";
  o += "    (if (i32.eqz (local.get $p)) (then (return (i32.const 0))))\n";
  o += "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (i32.const 0))))\n";
  o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (i32.const 0))))\n";
  o += "    (local.set $p (i32.and (local.get $p) (i32.const -3)))\n";
  o += "    (local.set $rc (i32.load (i32.sub (local.get $p) (i32.const 8))))\n";
  o += "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (i32.const 0))))\n";
  o += "    (if (i32.eq (local.get $rc) (i32.const 1)) (then (return (i32.const 1))))\n";
  o += "    (i32.const 0))\n";
  o += "  (func $__fern_arr_inc_elems (param $a i32) (result i32)\n";
  o += "    (local $i i32) (local $n i32)\n";
  o += "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
  o += "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (local.get $a))))\n";
  o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + lo + ")) (then (return (local.get $a))))\n";
  o += "    (if (i32.lt_s (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 0)) (then (return (local.get $a))))\n";
  o += "    (local.set $n (i32.load (local.get $a)))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $aie_done (loop $aie_lp\n";
  o += "      (br_if $aie_done (i32.ge_u (local.get $i) (local.get $n)))\n";
  o += "      (drop (call $__fern_rc_inc (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $aie_lp)))\n";
  o += "    (local.get $a))\n";
  o += "  (func $__fern_arr_own_elems (param $d i32) (param $s i32) (result i32)\n";
  o += "    (drop (call $__fern_arr_inc_elems (local.get $s)))\n";
  o += "    (local.get $d))\n";
  o += "  (func $__fern_rc_underflow_count (result i32)\n";
  o += "    (global.get $__fern_rc_underflow))\n";
  return o;
}

pub function arr_slice8_helper(): string {
  let o = "";
  o += "  (func $__fern_arr_slice8 (param $a i32) (param $start i32) (param $end i32) (result i32)\n";
  o += "    (local $n i32) (local $na i32) (local $i i32)\n";
  o += "    (if (i32.gt_u (local.get $end) (i32.load (local.get $a))) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (local.set $n (i32.sub (local.get $end) (local.get $start)))\n";
  o += "    (local.set $na (call $__fern_arr_elems (local.get $n) (i32.const 8)))\n";
  o += "    (i32.store (local.get $na) (local.get $n))\n";
  o += "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $n))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $d (loop $c\n";
  o += "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
  o += "      (i64.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8))) (i64.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (i32.add (local.get $start) (local.get $i)) (i32.const 8)))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $c)))\n";
  o += "    (local.get $na))\n";
  return o;
}

pub function bytes_owned_helper(empty: i32): string {
  let o = "  (func $__fern_bytes_owned (param $v i32) (result i32)\n";
  o += "    (local $n i32) (local $p i32) (local $r i32)\n";
  o += byte_view_decode("$v", "$p", "$n");
  o += bytes_copy_out("$n", "(local.get $p)", empty);
  return o;
}

pub function bytes_range_helper(empty: i32): string {
  let o = "  (func $__fern_bytes_range (param $v i32) (param $from i32) (param $to i32) (result i32)\n";
  o += "    (local $n i32) (local $p i32) (local $m i32) (local $r i32)\n";
  o += byte_view_decode("$v", "$p", "$n");
  o += "    (if (i32.lt_s (local.get $from) (i32.const 0)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (if (i32.lt_s (local.get $to) (local.get $from)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (if (i32.gt_s (local.get $to) (local.get $n)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (local.set $m (i32.sub (local.get $to) (local.get $from)))\n";
  o += bytes_copy_out("$m", "(i32.add (local.get $p) (local.get $from))", empty);
  return o;
}

pub function bytes_into_helper(): string {
  let o = "  (func $__fern_bytes_into (param $dst i32) (param $at i32) (param $v i32) (param $from i32) (param $m i32) (result i32)\n";
  o += "    (local $n i32) (local $p i32) (local $dn i32) (local $r i32)\n";
  o += byte_view_decode("$v", "$p", "$n");
  o += "    (local.set $dn (i32.load (local.get $dst)))\n";
  o += "    (if (i32.lt_s (local.get $m) (i32.const 0)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (if (i32.lt_s (local.get $at) (i32.const 0)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (if (i32.lt_s (local.get $from) (i32.const 0)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (if (i32.gt_s (local.get $at) (i32.sub (local.get $dn) (local.get $m))) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (if (i32.gt_s (local.get $from) (i32.sub (local.get $n) (local.get $m))) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (if (i32.eqz (local.get $m)) (then (return (local.get $dst))))\n";
  o += "    (if (i32.eqz (call $__fern_rc_is_unique (local.get $dst))) (then\n";
  o += "      (local.set $r (call $__fern_arr_elems (local.get $dn) (i32.const 1)))\n";
  o += "      (i32.store (local.get $r) (local.get $dn))\n";
  o += "      (i32.store offset=4 (local.get $r) (local.get $dn))\n";
  o += "      (memory.copy (i32.add (local.get $r) (i32.const 8)) (i32.add (local.get $dst) (i32.const 8)) (local.get $dn))\n";
  o += "      (drop (call $__fern_arr_dec (local.get $dst)))\n";
  o += "      (local.set $dst (local.get $r))))\n";
  o += "    (memory.copy (i32.add (i32.add (local.get $dst) (i32.const 8)) (local.get $at)) (i32.add (local.get $p) (local.get $from)) (local.get $m))\n";
  return o + "    (local.get $dst))\n";
}

// Sets p and n to the bytes and length of the byte view in local v: an array
// (tag 0), a string or a borrowed descriptor (tag 2) or a frame window (tag 3, frame_window_wat).
function byte_view_decode(v: string, p: string, n: string): string {
  let at = "(local.get " + v + ")";
  let o = "    (if (i32.and " + at + " (i32.const 2)) (then (if (i32.and " + at + " (i32.const 1))\n";
  o = o + "      (then (local.set " + p + " (i32.load (i32.sub " + at + " (i32.const 3)))) (local.set " + n + " (i32.load (i32.add " + at + " (i32.const 1)))))\n";
  o = o + "      (else (local.set " + p + " (i32.add " + at + " (i32.const 2))) (local.set " + n + " (i32.load (i32.sub " + at + " (i32.const 2))))"
    + borrowed_decode(at + " (i32.const 2)", p, n) + ")))\n";
  return o + "    (else (local.set " + p + " (i32.add " + at + " (i32.const 8))) (local.set " + n + " (i32.load " + at + "))))\n";
}

// Sets p and n to the bytes and length of local s, a byte view's string arm:
// a string, a borrowed descriptor, or a frame window at s less 1.
function view_string_decode(s: string, p: string, n: string): string {
  let at = "(local.get " + s + ")";
  let o = "    (local.set " + n + " (i32.load (i32.add " + at + " (i32.mul (i32.and " + at + " (i32.const 1)) (i32.const 3)))))\n";
  o = o + "    (local.set " + p + " (if (result i32) (i32.and " + at + " (i32.const 1)) (then (i32.load (i32.sub " + at + " (i32.const 1)))) (else (i32.add " + at + " (i32.const 4)))))\n";
  return o + "   " + borrowed_decode(at + " (i32.const 4)", p, n) + "\n";
}

// A borrowed descriptor marks its length's top bit; `data` is the address of its data word, as `x (i32.const k)` for an add.
function borrowed_decode(data: string, p: string, n: string): string {
  return " (if (i32.lt_s (local.get " + n + ") (i32.const 0)) (then (local.set " + p + " (i32.load (i32.add " + data + ")))"
    + " (local.set " + n + " (i32.and (local.get " + n + ") (i32.const 2147483647)))))";
}

function bytes_copy_out(len: string, src: string, empty: i32): string {
  let o = "";
  if (empty >= 0) {
    o = "    (if (i32.eqz (local.get " + len + ")) (then (return (i32.const " + util.i32_to_string(empty) + "))))\n";
  }
  o = o + "    (local.set $r (call $__fern_arr_elems (local.get " + len + ") (i32.const 1)))\n";
  o = o + "    (i32.store (local.get $r) (local.get " + len + "))\n";
  o = o + "    (i32.store offset=4 (local.get $r) (local.get " + len + "))\n";
  o = o + "    (memory.copy (i32.add (local.get $r) (i32.const 8)) " + src + " (local.get " + len + "))\n";
  return o + "    (local.get $r))\n";
}

pub function arr_concat_helper(): string {
  let o = "";
  o += "  (func $__fern_arr_concat (param $width i32) (param $nb i32) (param $src i32) (param $a i32) (result i32)\n";
  o += "    (local $na i32) (local $n i32) (local $stride i32) (local $cap i32) (local $rc i32) (local $ncap i32) (local $r i32) (local $sole i32)\n";
  o += "    (local.set $stride (i32.shr_u (local.get $width) (i32.const 3)))\n";
  o += "    (local.set $na (i32.load (local.get $a)))\n";
  o += "    (local.set $n (i32.add (local.get $na) (local.get $nb)))\n";
  o += "    (local.set $cap (i32.load (i32.add (local.get $a) (i32.const 4))))\n";
  o += "    (local.set $rc (i32.load (i32.sub (local.get $a) (i32.const 8))))\n";
  o += "    (local.set $sole (i32.eq (local.get $rc) (i32.const 1)))\n";
  o += "    (if (i32.and (local.get $sole) (i32.le_s (local.get $n) (local.get $cap))) (then\n";
  o += "      (memory.copy (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $na) (local.get $stride))) (local.get $src) (i32.mul (local.get $nb) (local.get $stride)))\n";
  o += "      (i32.store (local.get $a) (local.get $n))\n";
  o += "      (return (local.get $a))))\n";
  o += "    (local.set $ncap (local.get $n))\n";
  o += "    (if (local.get $sole) (then\n";
  o += "      (if (i32.gt_s (i32.mul (local.get $na) (i32.const 2)) (local.get $n)) (then (local.set $ncap (i32.mul (local.get $na) (i32.const 2)))))))\n";
  o += "    (local.set $r (call $__fern_arr_elems (local.get $ncap) (local.get $stride)))\n";
  o += "    (i32.store (local.get $r) (local.get $n))\n";
  o += "    (i32.store offset=4 (local.get $r) (local.get $ncap))\n";
  o += "    (memory.copy (i32.add (local.get $r) (i32.const 8)) (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $na) (local.get $stride)))\n";
  o += "    (memory.copy (i32.add (i32.add (local.get $r) (i32.const 8)) (i32.mul (local.get $na) (local.get $stride))) (local.get $src) (i32.mul (local.get $nb) (local.get $stride)))\n";
  o += "    (local.get $r))\n";
  return o;
}

pub function arr_slice_u8_helper(): string {
  let o = "";
  o += "  (func $__fern_arr_slice_u8 (param $a i32) (param $start i32) (param $end i32) (result i32)\n";
  o += "    (local $n i32) (local $na i32)\n";
  o += "    (if (i32.gt_u (local.get $end) (i32.load (local.get $a))) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (local.set $n (i32.sub (local.get $end) (local.get $start)))\n";
  o += "    (local.set $na (call $__fern_arr_elems (local.get $n) (i32.const 1)))\n";
  o += "    (i32.store (local.get $na) (local.get $n))\n";
  o += "    (i32.store offset=4 (local.get $na) (local.get $n))\n";
  o += "    (memory.copy (i32.add (local.get $na) (i32.const 8)) (i32.add (i32.add (local.get $a) (i32.const 8)) (local.get $start)) (local.get $n))\n";
  o += "    (local.get $na))\n";
  return o;
}

pub function arr_push_owned_helper(heap_base: i32): string {
  let hb = util.i32_to_string(heap_base);
  let o = "";
  o += "  (func $__fern_arr_push_owned (param $a i32) (param $v i32) (result i32)\n";
  o += "    (local $na i32) (local $rc i32)\n";
  o += "    (local.set $na (call $__fern_arr_push (local.get $a) (local.get $v)))\n";
  o = o + "    (if (i32.and (i32.ne (local.get $na) (local.get $a)) (i32.and (i32.ge_u (local.get $a) (i32.const " + hb + ")) (i32.eqz (i32.and (local.get $a) (i32.const 1))))) (then\n";
  o += "      (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
  o += "        (drop (call $__fern_arr_dec (local.get $a)))))))\n";
  o += "    (local.get $na))\n";
  return o;
}

pub function hex_digit(d: i32): string {
  if (d == 0) {
    return "0";
  } else if (d == 1) {
    return "1";
  } else if (d == 2) {
    return "2";
  } else if (d == 3) {
    return "3";
  } else if (d == 4) {
    return "4";
  } else if (d == 5) {
    return "5";
  } else if (d == 6) {
    return "6";
  } else if (d == 7) {
    return "7";
  } else if (d == 8) {
    return "8";
  } else if (d == 9) {
    return "9";
  } else if (d == 10) {
    return "a";
  } else if (d == 11) {
    return "b";
  } else if (d == 12) {
    return "c";
  } else if (d == 13) {
    return "d";
  } else if (d == 14) {
    return "e";
  } else {
    return "f";
  }
}

// The characters from the space to the tilde, in byte order.
const PRINTABLE: string = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";

// `s` can hold bytes that are not UTF-8, so no slice of `s` is safe.
pub function wat_escape(s: string): string {
  let parts: string[] = [];
  for i in 0..s.len() {
    let b = s[i] as i32;
    if (b >= 32 && b <= 126 && b != 34 && b != 92) {
      parts = parts.append(slice_unchecked(PRINTABLE, b - 32, b - 31).to_owned());
    } else {
      parts = parts.append(byte_escape(b));
    }
  }
  return util.str_join_chunks(parts);
}

pub function le32_escape(n: i32): string {
  let parts: string[] = [];
  for b in 0..4 {
    parts = parts.append(byte_escape(n >> b * 8 & 255));
  }
  return util.str_join_chunks(parts);
}

function byte_escape(v: i32): string {
  return "\\" + hex_digit(v / 16) + hex_digit(v % 16);
}

function const_agg_data(strs: Placed, caggs: Placed, structs: irtables.StructTab, fn_table: string[]): string {
  let cv = caggs.ix.names;
  let parts: string[] = [];
  let i = 0;
  while (i < cv.len()) {
    if (ir.const_struct_is_bytes(cv[i])) {
      parts = parts.append("  (data (i32.const " + util.i32_to_string(caggs.offs[i]) + ") \"" + packed_byte_data(cv[i]) + "\")\n");
      i += 1;
      continue;
    }
    let vals = ir.const_struct_values(cv[i]);
    let body = le32_escape(-1) + le32_escape(const_agg_block_bytes(cv[i]));
    let fnbody = ir.const_struct_fn_body(cv[i]);
    if (fnbody.len() > 0) {
      body = body + le32_escape(1) + le32_escape(1)
        + le32_escape(util.index_of_str(fn_table, fnbody)) + le32_escape(0);
    } else if (ir.const_struct_is_option(cv[i])) {
      body = body + le32_escape(util.lit_to_i32(vals[0])) + le32_escape(0);
    } else if (ir.const_struct_is_wide_array(cv[i])) {
      body = body + le32_escape(vals.len()) + le32_escape(vals.len());
      for v in vals {
        let w = util.lit_to_i64(v);
        body = body + le32_escape((w & 0xffffffff) as i32) + le32_escape((w >> 32) as i32);
      }
    } else if (ir.const_struct_is_array(cv[i])) {
      body = body + le32_escape(vals.len()) + le32_escape(vals.len());
      for v in vals {
        body += le32_escape(const_agg_field(strs, caggs, v));
      }
      if (vals.len() % 2 == 1) {
        body += le32_escape(0);
      }
    } else {
      body = body + le32_escape(struct_type_id(structs, ir.const_struct_type(cv[i]))) + le32_escape(0);
      for vi in 0..vals.len() {
        if (ir.const_struct_ref(vals[vi]).len() == 0) {
          let w = util.lit_to_i64(vals[vi]);
          body = body + le32_escape((w & 0xffffffff) as i32) + le32_escape((w >> 32) as i32);
        } else {
          body = body + le32_escape(const_agg_field(strs, caggs, vals[vi])) + le32_escape(0);
        }
      }
    }
    parts = parts.append("  (data (i32.const " + util.i32_to_string(caggs.offs[i]) + ") \"" + body + "\")\n");
    i += 1;
  }
  return util.str_join_chunks(parts);
}

function packed_byte_data(packed: string): string {
  let bs = byteconst.values(ir.const_struct_payload(packed));
  let padded: i32 = (bs.len() + 7) / 8 * 8;
  let out = __alloc_u8(padded * 3);
  let hex = "0123456789abcdef";
  for i in 0..padded {
    let value = 0;
    if (i < bs.len()) {
      value = bs[i] as i32;
    }
    out = out.with(i * 3, 92 as u8);
    out = out.with(i * 3 + 1, hex[value >> 4]);
    out = out.with(i * 3 + 2, hex[value & 15]);
  }
  unsafe {
    return le32_escape(-1) + le32_escape(16 + padded) + le32_escape(bs.len()) + le32_escape(bs.len()) + string_from_bytes_unchecked(out);
  }
}

function const_agg_field(strs: Placed, caggs: Placed, word: string): i32 {
  let inner = ir.const_struct_ref(word);
  if (ir.const_struct_is_str(inner)) {
    return strs.offset_of(ir.const_str_text(inner), "string literal");
  }
  if (inner.len() > 0) {
    return caggs.offset_of(inner, "aggregate constant") + 8;
  }
  return util.lit_to_i32(word);
}

pub function arr_push_i64_helper(): string {
  return arr_push_strided("_i64", "i64", "i64.store", 8);
}

pub function arr_push_owned_wide_helper(elem: string, vty: string, heap_base: i32): string {
  let hb = util.i32_to_string(heap_base);
  let o = "";
  o = o + "  (func $__fern_arr_push_owned_" + elem + " (param $a i32) (param $v " + vty + ") (result i32)\n";
  o += "    (local $na i32)\n";
  o = o + "    (local.set $na (call $__fern_arr_push_" + elem + " (local.get $a) (local.get $v)))\n";
  o = o + "    (if (i32.and (i32.ne (local.get $na) (local.get $a)) (i32.and (i32.ge_u (local.get $a) (i32.const " + hb + ")) (i32.eqz (i32.and (local.get $a) (i32.const 1))))) (then\n";
  o += "      (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
  o += "        (drop (call $__fern_arr_dec (local.get $a)))))))\n";
  o += "    (local.get $na))\n";
  return o;
}

pub function arr_push_f64_helper(): string {
  return arr_push_strided("_f64", "f64", "f64.store", 8);
}

pub function arr_push_u8_helper(): string {
  return arr_push_strided("_u8", "i32", "i32.store8", 1);
}

pub function arr_push_strided(suffix: string, vty: string, sop: string, stride: i32): string {
  let st = util.i32_to_string(stride);
  let o = "";
  o = o + "  (func $__fern_arr_push" + suffix + " (param $a i32) (param $v " + vty + ") (result i32)\n";
  o += "    (local $len i32) (local $cap i32) (local $na i32) (local $ncap i32) (local $rc i32)\n";
  o += "    (local.set $len (i32.load (local.get $a)))\n";
  o += "    (local.set $cap (i32.load (i32.add (local.get $a) (i32.const 4))))\n";
  o += "    (local.set $rc (i32.load (i32.sub (local.get $a) (i32.const 8))))\n";
  o += "    (if (i32.and (i32.or (i32.eq (local.get $rc) (i32.const 1)) (i32.lt_s (local.get $rc) (i32.const 0))) (i32.lt_s (local.get $len) (local.get $cap))) (then\n";
  o = o + "      (" + sop + " (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $len) (i32.const " + st + "))) (local.get $v))\n";
  o += "      (i32.store (local.get $a) (i32.add (local.get $len) (i32.const 1)))\n";
  o += "      (return (local.get $a))))\n";
  o += "    (local.set $ncap (local.get $cap))\n";
  o += "    (if (i32.lt_s (local.get $len) (local.get $cap)) (then\n";
  o = o + "      (i32.store (i32.const " + util.i32_to_string(arr_push_shared_addr()) + ") (i32.add (i32.load (i32.const " + util.i32_to_string(arr_push_shared_addr()) + ")) (i32.const 1)))\n";
  o = o + "      (i64.store (i32.const " + util.i32_to_string(arr_push_copied_addr()) + ") (i64.add (i64.load (i32.const " + util.i32_to_string(arr_push_copied_addr()) + ")) (i64.extend_i32_u (i32.mul (local.get $len) (i32.const " + st + ")))))))\n";
  o += "    (if (i32.ge_s (local.get $len) (local.get $cap)) (then\n";
  o += "      (local.set $ncap (i32.const 4))\n";
  o += "      (if (i32.gt_s (local.get $cap) (i32.const 0)) (then (local.set $ncap (i32.mul (local.get $cap) (i32.const 2)))))))\n";
  o = o + "    (local.set $na (call $__fern_arr_elems (local.get $ncap) (i32.const " + st + ")))\n";
  o += "    (i32.store (local.get $na) (i32.add (local.get $len) (i32.const 1)))\n";
  o += "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $ncap))\n";
  o = o + "    (memory.copy (i32.add (local.get $na) (i32.const 8)) (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $len) (i32.const " + st + ")))\n";
  o = o + "    (" + sop + " (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $len) (i32.const " + st + "))) (local.get $v))\n";
  o += "    (local.get $na))\n";
  return o;
}

function p1_file_io(needs: string[]): boolean {
  return need_any(needs, ["read_file", "read_file_bytes", "write_file", "write_file_bytes", "truncate"]) || need_dir_list(needs) || need_open_file(needs);
}

function p1_fd_read(needs: string[]): boolean {
  return p1_file_io(needs) || need_fd_read(needs);
}

function preview1_metadata_imports(parts: string[], needs: string[]): string[] {
  if (need(needs, "stat") || need(needs, "lstat")) {
    parts = parts.append(stat_import());
  }
  if (need(needs, "fd_stat") || need(needs, "reader_seek")) {
    parts = parts.append(fd_stat_import());
  }
  if (need(needs, "fd_fsync")) {
    parts = parts.append(fd_sync_import());
  }
  if (need(needs, "fd_fdatasync")) {
    parts = parts.append(fd_datasync_import());
  }
  if (need(needs, "fd_drop_cache")) {
    parts = parts.append(fd_advise_import());
  }
  if (need(needs, "reader_seek")) {
    parts = parts.append(fd_seek_import());
  }
  if (need(needs, "fd_flags") && !p1_fd_read(needs)) {
    parts = parts.append(fd_fdstat_get_import());
  }
  return parts;
}

function preview1_imports(needs: string[], lc: boolean): string {
  let parts: string[] = [];
  if (lc) {
    parts = parts.append("  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $__fern_proc_exit_raw (param i32)))\n");
  } else {
    parts = parts.append("  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $__fern_proc_exit (param i32)))\n");
  }
  if (need(needs, "@uses_random")) {
    parts = parts.append(random_get_import());
  }
  if (lc || needs_abort(needs) || need(needs, "print_str") || need(needs, "eprint_str") || need(needs, "putchar") || (need(needs, "write_file") || need(needs, "write_file_bytes")) || need(needs, "writer_write") || (need(needs, "write_some") || need(needs, "write_bytes") || need(needs, "write_some_bytes"))) {
    parts = parts.append("  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $__fern_fd_write (param i32 i32 i32 i32) (result i32)))\n");
  }
  if (p1_file_io(needs)) {
    parts = parts.append(file_imports());
  }
  if (need_dir_list(needs)) {
    parts = parts.append(readdir_fd_import());
  }
  if (need_fd_read(needs) && !p1_file_io(needs)) {
    parts = parts.append(stdin_fd_read_import());
  }
  if (p1_fd_read(needs)) {
    parts = parts.append(fd_fdstat_get_import());
  }
  if (need(needs, "reader_close") && !p1_file_io(needs)) {
    parts = parts.append(reader_fd_close_import());
  }
  if (need(needs, "monotonic_ns") || need(needs, "now_unix_ms") || need(needs, "now_ns")) {
    parts = parts.append("  (import \"wasi_snapshot_preview1\" \"clock_time_get\" (func $__fern_clock_time_get (param i32 i64 i32) (result i32)))\n");
  }
  if (need(needs, "clock_resolution")) {
    parts = parts.append("  (import \"wasi_snapshot_preview1\" \"clock_res_get\" (func $__fern_clock_res_get (param i32 i32) (result i32)))\n");
  }
  if (need(needs, "args")) {
    parts = parts.append(args_helpers());
  }
  if (need(needs, "env") || need(needs, "environ")) {
    parts = parts.append(env_helpers());
  }
  parts = preview1_metadata_imports(parts, needs);
  if (need(needs, "remove_file") || need(needs, "remove_dir_all")) {
    parts = parts.append(remove_file_import());
  }
  if (need(needs, "remove_dir_all")) {
    parts = parts.append(remove_dir_import());
  }
  if (need(needs, "temp_dir") || need(needs, "create_dir_all") || need(needs, "create_dir")) {
    parts = parts.append(temp_dir_import());
  }
  if (need(needs, "remove_dir") && !need(needs, "remove_dir_all")) {
    parts = parts.append(remove_dir_import());
  }
  if (need(needs, "create_link")) {
    parts = parts.append(link_import());
  }
  if (need(needs, "create_symlink")) {
    parts = parts.append(symlink_import());
  }
  if (need(needs, "rename")) {
    parts = parts.append(rename_import());
  }
  if (need(needs, "read_link")) {
    parts = parts.append(readlink_import());
  }
  if (need(needs, "set_file_times")) {
    parts = parts.append(set_file_times_import());
  }
  if (need(needs, "writer_set_times")) {
    parts = parts.append(writer_set_times_import());
  }
  if (need(needs, "truncate") || need(needs, "writer_truncate")) {
    parts = parts.append(truncate_import());
  }
  if (need(needs, "sleep_ms") || need(needs, "sleep_ns")) {
    parts = parts.append(sleep_ms_import());
  }
  parts = parts.append(preview2_wasi_imports(needs, false));
  return util.str_join_chunks(parts);
}

function preview2_wasi_imports(needs: string[], sleep_p2: boolean): string {
  let parts: string[] = [];
  if (need_any(needs, ["tcp_connect_with", "tcp_close", "tcp_listen", "tcp_listen_with", "tcp_accept", "tcp_accept_with", "tcp_pollable"]) || need_udp_socket(needs)) {
    parts = parts.append(wasi_instance_network_import());
  }
  if (need_any(needs, ["tcp_connect_with", "tcp_close", "tcp_listen", "tcp_listen_with", "tcp_accept", "tcp_accept_with", "tcp_pollable", "tcp_socket_ctl", "reactor_ctl"])) {
    parts = parts.append(wasi_sockets_imports());
  }
  parts = parts.append(wasi_stream_io_imports(needs));
  if (need(needs, "reactor_ctl")) {
    parts = parts.append(wasi_stream_subscribe_imports());
  } else if (need_any(needs, ["tcp_pollable", "tcp_recv_into"])) {
    parts = parts.append(wasi_input_stream_subscribe_import());
  }
  if (need(needs, "tcp_recv_into")) {
    parts = parts.append(wasi_stream_read_import());
  }
  if (need_any(needs, ["tcp_listen", "tcp_listen_with", "tcp_accept", "tcp_accept_with"])) {
    parts = parts.append(wasi_sockets_server_imports());
  }
  if (need(needs, "tcp_listen_with")) {
    parts = parts.append(wasi_sockets_backlog_import());
  }
  if (need(needs, "tcp_socket_ctl")) {
    parts = parts.append(wasi_sockets_socket_ctl_imports());
  }
  if (need_any(needs, ["tcp_socket_ctl", "tcp_addr_into"])) {
    parts = parts.append(wasi_sockets_remote_address_import());
  }
  if (need_any(needs, ["tcp_local_port", "tcp_addr_into"])) {
    parts = parts.append(wasi_sockets_local_address_import());
  }
  if (need_any(needs, ["tcp_local_port", "tcp_addr_into"]) && need(needs, "udp_bind")) {
    parts = parts.append(wasi_udp_local_address_import());
  }
  if (need(needs, "tcp_addr_into") && need(needs, "udp_bind")) {
    parts = parts.append(wasi_udp_remote_address_import());
  }
  if (need_udp_socket(needs)) {
    parts = parts.append(wasi_udp_socket_imports());
  }
  if (need_udp_send(needs)) {
    parts = parts.append(wasi_udp_send_imports());
  }
  if (need(needs, "udp_recvfrom")) {
    parts = parts.append(wasi_udp_recv_imports());
  }
  if (need_udp_send(needs) || need(needs, "reactor_ctl")) {
    parts = parts.append(wasi_udp_out_subscribe_import());
  }
  if (need(needs, "udp_recvfrom") || need(needs, "reactor_ctl") || need(needs, "tcp_pollable") && need_udp_socket(needs)) {
    parts = parts.append(wasi_udp_in_subscribe_import());
  }
  let udp_waits = need_udp_send(needs) || need(needs, "udp_recvfrom");
  let socket_waits = need_any(needs, ["tcp_connect_with", "tcp_accept", "tcp_accept_with", "tcp_recv_into"]);
  let sleeps = sleep_p2 && need_any(needs, ["sleep_ms", "sleep_ns"]);
  if (need_any(needs, ["wasm_timer_pollable", "poll", "reactor_wait"]) || sleeps) {
    parts = parts.append(wasi_subscribe_duration_import());
  }
  if (need(needs, "wasm_block") || udp_waits || socket_waits || sleeps) {
    parts = parts.append(wasi_pollable_block_import());
  }
  if (need_any(needs, ["wasm_pollable_drop", "reactor_ctl", "reactor_wait", "poll"]) || udp_waits || socket_waits || sleeps) {
    parts = parts.append(wasi_pollable_drop_import());
  }
  if (need_any(needs, ["wasm_poll", "poll", "reactor_wait"])) {
    parts = parts.append(wasi_poll_import());
  }
  return util.str_join_chunks(parts);
}

pub struct WasmUnit {
  ns: string,
  text: string,
  strs: string[],
  caggs: string[],
  fns: string[],
}

function needs_str_split(needs: string[]): boolean {
  return need(needs, "str_split") || need(needs, "@uses_str_lines");
}

pub function with_runtime_units(units: WasmUnit[], needs: string[], rt_lower: (parser.Module) => physicalbody.Lowered): WasmUnit[] {
  let roots = "";
  if (need(needs, "@uses_str_cmp")) {
    roots += " __fern_strcmp";
  }
  if (need(needs, "@uses_strings")) {
    roots += " __fern_streq";
  }
  if (needs_str_split(needs)) {
    roots += " __fern_utf8_step";
  }
  if (need(needs, "@uses_memchr_bytes")) {
    roots += " __fern_memchr_bytes";
  }
  if (need(needs, "@uses_rmemchr_bytes")) {
    roots += " __fern_rmemchr_bytes";
  }
  if (need(needs, "@uses_mulhi_u")) {
    roots += " __fern_mulhi_u64";
  }
  if (need(needs, "@uses_mulhi_s")) {
    roots += " __fern_mulhi_s64 __fern_mulhi_u64";
  }
  if (need(needs, "@uses_count_byte_bytes")) {
    roots += " __fern_count_byte_bytes";
  }
  if (need(needs, "@uses_sum_bytes")) {
    roots += " __fern_sum_bytes";
  }
  if (need(needs, "@uses_bsd_sum")) {
    roots += " __fern_bsd_sum";
  }
  if (need(needs, "@uses_bsd_sum_bytes")) {
    roots += " __fern_bsd_sum_bytes";
  }
  if (need(needs, "@uses_sum_bytes_array")) {
    roots += " __fern_sum_bytes_array";
  }
  if (need(needs, "@uses_scan_set")) {
    roots += " __fern_scan_set";
  }
  if (need(needs, "@uses_scan_set_bytes")) {
    roots += " __fern_scan_set_bytes";
  }
  if (need(needs, "@uses_count_runs")) {
    roots += " __fern_count_runs";
  }
  if (need(needs, "@uses_count_runs_bytes")) {
    roots += " __fern_count_runs_bytes";
  }
  if (roots.len() == 0) {
    return units;
  }
  let mod = rtmodule.load_wasm("wasm32-wasi", roots);
  let lowered = rt_lower(mod);
  let bodies = irtables.lowered_results(lowered.bodies);
  let text = emit_functions_ns("$runtime", mod, bodies, physicalbody.collection(lowered));
  return units.append(WasmUnit { ns: "$runtime", text: text, strs: str_values(bodies), caggs: const_agg_values(bodies), fns: fn_value_table(bodies) });
}

function module_needs_type_ids(units: WasmUnit[], needs: string[]): boolean {
  // Runtime IO helpers can read IDs outside the complete unit bodies.
  if (needs_io_error(needs)) {
    return true;
  }
  for unit in units {
    if (util.contains(unit.text, "$__tid$")) {
      return true;
    }
  }
  return false;
}

pub function unit_strs(units: WasmUnit[]): string[] {
  let out: string[] = [];
  for i in 0..units.len() {
    let j = 0;
    while (j < units[i].strs.len()) {
      out = out.append(units[i].strs[j]);
      j += 1;
    }
  }
  return out;
}

pub function unit_caggs(units: WasmUnit[]): string[] {
  let out: string[] = [];
  for i in 0..units.len() {
    let j = 0;
    while (j < units[i].caggs.len()) {
      out = out.append(units[i].caggs[j]);
      j += 1;
    }
  }
  return out;
}

pub function unit_fns(units: WasmUnit[]): string[] {
  let out: string[] = [];
  for i in 0..units.len() {
    let j = 0;
    while (j < units[i].fns.len()) {
      out = out.append(units[i].fns[j]);
      j += 1;
    }
  }
  return out;
}

pub function unit_ns_list(units: WasmUnit[]): string[] {
  let out: string[] = [];
  for i in 0..units.len() {
    out = out.append(units[i].ns);
  }
  return out;
}

pub function unit_fn_counts(units: WasmUnit[]): i32[] {
  let out: i32[] = [];
  for i in 0..units.len() {
    out = out.append(units[i].fns.len());
  }
  return out;
}

