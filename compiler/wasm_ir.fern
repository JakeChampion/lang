  o += "      (local.set $count (i32.add (local.get $count) (i32.add (i32.and (local.get $bits) (i32.const 1)) (i32.and (i32.shr_u (local.get $bits) (i32.const 1)) (i32.const 1)))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $count_loop)))\n";
  o += "    (if (i32.ge_s (local.get $timeout) (i32.const 0)) (then (local.set $count (i32.add (local.get $count) (i32.const 1)))))\n";
  o += "    (if (i32.eqz (local.get $count)) (then (return (i32.const -28))))\n";
  o += "    (if (i32.gt_u (local.get $count) (i32.load offset=20 (local.get $r))) (then\n";
  o += "      (call $__fern_raw_free (i32.load offset=12 (local.get $r)) (i32.mul (i32.load offset=20 (local.get $r)) (i32.const 4)))\n";
  o += "      (call $__fern_raw_free (i32.load offset=16 (local.get $r)) (i32.mul (i32.load offset=20 (local.get $r)) (i32.const 8)))\n";
  o += "      (call $__fern_raw_free (i32.load offset=24 (local.get $r)) (i32.mul (i32.load offset=20 (local.get $r)) (i32.const 4)))\n";
  o += "      (i32.store offset=20 (local.get $r) (i32.add (i32.mul (i32.load offset=4 (local.get $r)) (i32.const 2)) (i32.const 1)))\n";
  o += "      (i32.store offset=12 (local.get $r) (call $__fern_alloc (i32.mul (i32.load offset=20 (local.get $r)) (i32.const 4))))\n";
  o += "      (i32.store offset=16 (local.get $r) (call $__fern_alloc (i32.mul (i32.load offset=20 (local.get $r)) (i32.const 8))))\n";
  o += "      (i32.store offset=24 (local.get $r) (call $__fern_alloc (i32.mul (i32.load offset=20 (local.get $r)) (i32.const 4))))))\n";
  o += "    (local.set $list (i32.load offset=12 (local.get $r)))\n";
  o += "    (local.set $slots (i32.load offset=16 (local.get $r)))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $filled (loop $fill\n";
  o += "      (br_if $filled (i32.ge_u (local.get $i) (local.get $n)))\n";
  o += "      (local.set $e (i32.add (local.get $ents) (i32.mul (local.get $i) (i32.const 16))))\n";
  o += "      (if (i32.and (i32.load offset=4 (local.get $e)) (i32.const 1)) (then\n";
  o += reactor_slot("(i32.load offset=8 (local.get $e))", "(i32.load (local.get $e))", "(i32.const 1)");
  o += "      ))\n";
  o += "      (if (i32.and (i32.load offset=4 (local.get $e)) (i32.const 2)) (then\n";
  o += reactor_slot("(i32.load offset=12 (local.get $e))", "(i32.load (local.get $e))", "(i32.const 2)");
  o += "      ))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $fill)))\n";
  o += "    (if (i32.ge_s (local.get $timeout) (i32.const 0)) (then\n";
