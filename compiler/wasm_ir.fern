  o += "      (local.set $k (i32.const 0))\n";
  o += "      (block $a (loop $al (br_if $a (i32.ge_u (local.get $k) (i32.const 4)))\n";
  o += "        (i32.store (i32.add (i32.add (local.get $out) (i32.const 8)) (i32.mul (local.get $k) (i32.const 4)))\n";
  o += "          (i32.load8_u offset=8 (i32.add (local.get $addr) (local.get $k))))\n";
  o += "        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $al)))\n";
  o += "      (return (i32.const 0))))\n";
  o += "    (if (i32.eq (local.get $len) (i32.const 16)) (then\n";
  o += "      (i32.store (local.get $out) (i32.const 1))\n";
  o += "      (local.set $k (i32.const 0))\n";
  o += "      (block $b (loop $bl (br_if $b (i32.ge_u (local.get $k) (i32.const 8)))\n";
  o += "        (i32.store (i32.add (i32.add (local.get $out) (i32.const 12)) (i32.mul (local.get $k) (i32.const 4)))\n";
  o += "          (i32.or (i32.shl (i32.load8_u offset=8 (i32.add (local.get $addr) (i32.mul (local.get $k) (i32.const 2)))) (i32.const 8))\n";
  o += "                  (i32.load8_u offset=9 (i32.add (local.get $addr) (i32.mul (local.get $k) (i32.const 2))))))\n";
  o += "        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $bl)))\n";
