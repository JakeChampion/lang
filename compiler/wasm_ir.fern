  o += "        (br $c0)))\n";
  o += "      (return (local.get $arr))))\n";
  o += "    (local.set $start (i32.const 0))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $d (loop $c\n";
  o += "      (br_if $d (i32.gt_s (local.get $i) (i32.sub (local.get $sl) (local.get $sepl))))\n";
  o += "      (local.set $match (i32.const 1))\n";
  o += "      (local.set $j (i32.const 0))\n";
  o += "      (block $dm (loop $cm\n";
  o += "        (br_if $dm (i32.ge_s (local.get $j) (local.get $sepl)))\n";
  o += "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $sep) (i32.const 4)) (local.get $j)))) (then (local.set $match (i32.const 0)) (br $dm)))\n";
  o += "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "        (br $cm)))\n";
  o += "      (if (local.get $match) (then\n";
  o += "        (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $i)))\n";
  o += "        (local.set $arr (call $__fern_arr_push_owned (local.get $arr) (local.get $piece)))\n";
  o += "        (local.set $i (i32.add (local.get $i) (local.get $sepl)))\n";
  o += "        (local.set $start (local.get $i)))\n";
  o += "      (else (local.set $i (i32.add (local.get $i) (i32.const 1)))))\n";
  o += "      (br $c)))\n";
  o += "    (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $sl)))\n";
  o += "    (local.set $arr (call $__fern_arr_push_owned (local.get $arr) (local.get $piece)))\n";
