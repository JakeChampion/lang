pub function reactor_ctl_func(): string {
  let o = "";
  o += "  (func $__fern_reactor_ctl (param $r i32) (param $op i32) (param $fd i32) (param $arg i32) (result i32)\n";
  o += "    (local $n i32) (local $ents i32) (local $i i32) (local $e i32) (local $interest i32) (local $kind i32) (local $cap i32) (local $grown i32) (local $prev i32)\n";
  o += "    (local.set $n (i32.load (local.get $r)))\n";
  o += "    (local.set $cap (i32.load offset=4 (local.get $r)))\n";
  o += "    (local.set $ents (i32.load offset=8 (local.get $r)))\n";
  o += "    (if (i32.eq (local.get $op) (i32.const 3)) (then\n";
  o += "      (local.set $i (i32.const 0))\n";
  o += "      (block $dropped (loop $drop\n";
  o += "        (br_if $dropped (i32.ge_u (local.get $i) (local.get $n)))\n";
  o += "        (local.set $e (i32.add (local.get $ents) (i32.mul (local.get $i) (i32.const 16))))\n";
  o += reactor_drop_pollables();
  o += "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "        (br $drop)))\n";
  o += "      (call $__fern_raw_free (local.get $ents) (i32.mul (local.get $cap) (i32.const 16)))\n";
  o += "      (call $__fern_raw_free (i32.load offset=12 (local.get $r)) (i32.mul (i32.load offset=20 (local.get $r)) (i32.const 4)))\n";
  o += "      (call $__fern_raw_free (i32.load offset=16 (local.get $r)) (i32.mul (i32.load offset=20 (local.get $r)) (i32.const 8)))\n";
  o += "      (call $__fern_raw_free (i32.load offset=24 (local.get $r)) (i32.mul (i32.load offset=20 (local.get $r)) (i32.const 4)))\n";
  o += "      (if (i32.eq (global.get $__fern_reactors) (local.get $r))\n";
  o += "        (then (global.set $__fern_reactors (i32.load offset=28 (local.get $r))))\n";
  o += "        (else\n";
  o += "          (local.set $prev (global.get $__fern_reactors))\n";
  o += "          (block $unlinked (loop $walk\n";
  o += "            (br_if $unlinked (i32.eqz (local.get $prev)))\n";
  o += "            (if (i32.eq (i32.load offset=28 (local.get $prev)) (local.get $r)) (then\n";
  o += "              (i32.store offset=28 (local.get $prev) (i32.load offset=28 (local.get $r)))\n";
  o += "              (br $unlinked)))\n";
  o += "            (local.set $prev (i32.load offset=28 (local.get $prev)))\n";
  o += "            (br $walk)))))\n";
  o += "      (call $__fern_raw_free (local.get $r) (i32.const 32))\n";
  o += "      (return (i32.const 0))))\n";
  o += "    (if (i32.lt_u (i32.sub (local.get $op) (i32.const 4)) (i32.const 3)) (then (return (i32.const -58))))\n";
  o += "    (if (i32.ge_u (i32.sub (local.get $op) (i32.const 1)) (i32.const 2)) (then (return (i32.const -28))))\n";
  o += "    (if (i32.eq (local.get $op) (i32.const 1)) (then (local.set $interest (i32.and (local.get $arg) (i32.const 3)))))\n";
  o += "    (local.set $kind (i32.load offset=12 (local.get $fd)))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $searched (loop $search\n";
  o += "      (br_if $searched (i32.ge_u (local.get $i) (local.get $n)))\n";
  o += "      (local.set $e (i32.add (local.get $ents) (i32.mul (local.get $i) (i32.const 16))))\n";
  o += "      (if (i32.eq (i32.load (local.get $e)) (local.get $fd)) (then\n";
  o += reactor_drop_pollables();
  o += "        (if (i32.eqz (local.get $interest)) (then\n";
  o += "          (memory.copy (local.get $e) (i32.add (local.get $ents) (i32.mul (i32.sub (local.get $n) (i32.const 1)) (i32.const 16))) (i32.const 16))\n";
  o += "          (i32.store (local.get $r) (i32.sub (local.get $n) (i32.const 1)))\n";
  o += "          (return (i32.const 0))))\n";
  o += reactor_subscribe(1, "$__fern_wasi_input_stream_subscribe", "$__fern_wasi_output_stream_subscribe", 4, 8);
  o += reactor_subscribe(3, "$__fern_wasi_udp_in_subscribe", "$__fern_wasi_udp_subscribe", 4, 8);
  o += reactor_subscribe(0, "$__fern_wasi_tcp_subscribe", "$__fern_wasi_tcp_subscribe", 0, 0);
  o += reactor_subscribe(4, "$__fern_wasi_tcp_subscribe", "$__fern_wasi_tcp_subscribe", 0, 0);
  o += "        (i32.store offset=4 (local.get $e) (i32.const 0))\n";
  o += "        (return (i32.const -28))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $search)))\n";
  o += "    (if (i32.eqz (local.get $interest)) (then (return (i32.const 0))))\n";
  o += "    (if (i32.eq (local.get $n) (local.get $cap)) (then\n";
  o += "      (local.set $grown (call $__fern_alloc (i32.mul (local.get $cap) (i32.const 32))))\n";
  o += "      (memory.copy (local.get $grown) (local.get $ents) (i32.mul (local.get $n) (i32.const 16)))\n";
  o += "      (call $__fern_raw_free (local.get $ents) (i32.mul (local.get $cap) (i32.const 16)))\n";
  o += "      (i32.store offset=8 (local.get $r) (local.get $grown))\n";
  o += "      (i32.store offset=4 (local.get $r) (i32.mul (local.get $cap) (i32.const 2)))\n";
  o += "      (local.set $ents (local.get $grown))))\n";
  o += "    (local.set $e (i32.add (local.get $ents) (i32.mul (local.get $n) (i32.const 16))))\n";
  o += "    (i32.store (local.get $e) (local.get $fd))\n";
  o += "    (i32.store (local.get $r) (i32.add (local.get $n) (i32.const 1)))\n";
  o += reactor_subscribe(1, "$__fern_wasi_input_stream_subscribe", "$__fern_wasi_output_stream_subscribe", 4, 8);
  o += reactor_subscribe(3, "$__fern_wasi_udp_in_subscribe", "$__fern_wasi_udp_subscribe", 4, 8);
  o += reactor_subscribe(0, "$__fern_wasi_tcp_subscribe", "$__fern_wasi_tcp_subscribe", 0, 0);
  o += reactor_subscribe(4, "$__fern_wasi_tcp_subscribe", "$__fern_wasi_tcp_subscribe", 0, 0);
  o += "    (i32.store offset=4 (local.get $e) (i32.const 0))\n";
  o += "    (i32.const -28))\n";
  return o;
}

function reactor_slot(pollable: string, record: string, bit: string): string {
  return "      (i32.store (i32.add (local.get $list) (i32.mul (local.get $k) (i32.const 4))) " + pollable + ")\n"
    + "      (i32.store (i32.add (local.get $slots) (i32.mul (local.get $k) (i32.const 8))) " + record + ")\n"
    + "      (i32.store offset=4 (i32.add (local.get $slots) (i32.mul (local.get $k) (i32.const 8))) " + bit + ")\n"
    + "      (local.set $k (i32.add (local.get $k) (i32.const 1)))\n";
}

pub function reactor_wait_func(): string {
  let o = "";
  o += "  (func $__fern_reactor_wait (param $r i32) (param $events i32) (param $timeout i32) (result i32)\n";
  o += "    (local $n i32) (local $ents i32) (local $i i32) (local $e i32) (local $count i32) (local $list i32) (local $slots i32) (local $k i32)\n";
  o += "    (local $timer i32) (local $ret i32) (local $rl i32) (local $rc i32) (local $out i32) (local $cap i32) (local $idx i32) (local $bits i32) (local $j i32)\n";
  o += "    (local.set $cap (i32.div_u (i32.load (local.get $events)) (i32.const 2)))\n";
  o += "    (if (i32.eqz (local.get $cap)) (then (return (i32.const -28))))\n";
