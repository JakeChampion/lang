  o += "    (local.set $k (i32.const 0))\n";
  o += "    (block $z (loop $zl (br_if $z (i32.ge_u (local.get $k) (i32.const 48)))\n";
  o += "      (i32.store (i32.add (local.get $out) (local.get $k)) (i32.const 0))\n";
  o += "      (local.set $k (i32.add (local.get $k) (i32.const 4))) (br $zl)))\n";
  o += "    (i32.store offset=4 (local.get $out) (local.get $port))\n";
