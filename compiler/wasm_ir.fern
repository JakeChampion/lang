pub function tcp_listen_func(): string {
  return tcp_listen_wat("$__fern_tcp_listen", "(param $port i32)", false);
}

pub function tcp_listen_with_func(): string {
  return tcp_listen_wat("$__fern_tcp_listen_with", "(param $addr i32) (param $port i32) (param $backlog i32) (param $reuse i32)", true);
}

function tcp_listen_step(call: string): string {
  let o: string = "";
  o = o + "    " + call + "\n";
  o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
  o = o + "      (call $__fern_wasi_tcp_socket_drop (local.get $sock))\n";
  o = o + "      (local.set $e (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=1 (local.get $ret)))))\n";
  o = o + "      (call $__fern_raw_free (local.get $ret) (i32.const 16))\n";
  o = o + "      (return (local.get $e))))\n";
  return o;
}

function tcp_listen_wat(name: string, params: string, with_backlog: boolean): string {
  let o: string = "";
  o = o + "  (func " + name + " " + params + " (result i32)\n";
  o = o + "    (local $sock i32) (local $ret i32) (local $st i32) (local $e i32) (local $flat i32) (local $tmp i32)\n";
  if (with_backlog) {
    o = o + ip_flat_prologue();
  }
  o = o + "    (local.set $ret (call $__fern_alloc (i32.const 16)))\n";
  if (with_backlog) {
    o = o + "    (call $__fern_wasi_create_tcp_socket (i32.load (local.get $flat)) (local.get $ret))\n";
  } else {
    o = o + "    (call $__fern_wasi_create_tcp_socket (i32.const 0) (local.get $ret))\n";
  }
  o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
  o = o + "      (local.set $e (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=4 (local.get $ret)))))\n";
  o = o + "      (call $__fern_raw_free (local.get $ret) (i32.const 16))\n";
  o = o + "      (return (local.get $e))))\n";
