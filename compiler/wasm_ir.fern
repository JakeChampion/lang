function wasm_binop(tag: i32): string {
  if (tag == ir.K_ADD) {
    return "i32.add";
  }
  if (tag == ir.K_SUB) {
    return "i32.sub";
  }
  if (tag == ir.K_MUL) {
    return "i32.mul";
  }
  if (tag == ir.K_DIV_S) {
    return "call $__fern_idiv";
  }
  if (tag == ir.K_REM_S) {
    return "call $__fern_irem";
  }
  if (tag == ir.K_AND) {
    return "i32.and";
  }
  if (tag == ir.K_OR) {
    return "i32.or";
  }
  if (tag == ir.K_XOR) {
    return "i32.xor";
  }
  if (tag == ir.K_SHL) {
    return "i32.shl";
  }
  if (tag == ir.K_SHR_S) {
    return "i32.shr_s";
  }
  if (tag == ir.K_SHR_U) {
    return "i32.shr_u";
  }
  if (tag == ir.K_DIV_U) {
    return "call $__fern_udiv";
  }
  if (tag == ir.K_REM_U) {
    return "call $__fern_urem";
  }
  if (tag == ir.K_EQ) {
    return "i32.eq";
  }
  if (tag == ir.K_NE) {
    return "i32.ne";
  }
  if (tag == ir.K_LT_S) {
    return "i32.lt_s";
  }
  if (tag == ir.K_LE_S) {
    return "i32.le_s";
  }
  if (tag == ir.K_GT_S) {
    return "i32.gt_s";
  }
  if (tag == ir.K_GE_S) {
    return "i32.ge_s";
  }
  if (tag == ir.K_LT_U) {
    return "i32.lt_u";
  }
  if (tag == ir.K_LE_U) {
    return "i32.le_u";
  }
  if (tag == ir.K_GT_U) {
    return "i32.gt_u";
  }
  if (tag == ir.K_GE_U) {
    return "i32.ge_u";
  }
  return ircore.unsupported_op_refuse(tag, "wasm");
}

function wasm_binop_w(tag: i32, width: i32): string {
  if (width != 64) {
    return wasm_binop(tag);
  }
  if (tag == ir.K_ADD) {
    return "i64.add";
  }
  if (tag == ir.K_SUB) {
    return "i64.sub";
  }
  if (tag == ir.K_MUL) {
    return "i64.mul";
  }
  if (tag == ir.K_DIV_S) {
    return "call $__fern_idiv64";
  }
  if (tag == ir.K_REM_S) {
    return "call $__fern_irem64";
  }
  if (tag == ir.K_DIV_U) {
    return "call $__fern_udiv64";
  }
  if (tag == ir.K_REM_U) {
    return "call $__fern_urem64";
  }
  if (tag == ir.K_AND) {
    return "i64.and";
  }
  if (tag == ir.K_OR) {
    return "i64.or";
  }
  if (tag == ir.K_XOR) {
    return "i64.xor";
  }
  if (tag == ir.K_SHL) {
    return "i64.shl";
  }
  if (tag == ir.K_SHR_S) {
    return "i64.shr_s";
  }
  if (tag == ir.K_SHR_U) {
    return "i64.shr_u";
  }
  if (tag == ir.K_EQ) {
    return "i64.eq";
  }
  if (tag == ir.K_NE) {
    return "i64.ne";
  }
  if (tag == ir.K_LT_S) {
    return "i64.lt_s";
  }
  if (tag == ir.K_LE_S) {
    return "i64.le_s";
  }
  if (tag == ir.K_GT_S) {
    return "i64.gt_s";
  }
  if (tag == ir.K_GE_S) {
    return "i64.ge_s";
  }
  if (tag == ir.K_LT_U) {
    return "i64.lt_u";
  }
  if (tag == ir.K_LE_U) {
    return "i64.le_u";
  }
  if (tag == ir.K_GT_U) {
    return "i64.gt_u";
  }
  if (tag == ir.K_GE_U) {
    return "i64.ge_u";
  }
  if (tag == ir.K_FADD) {
    return "f64.add";
  }
  if (tag == ir.K_FSUB) {
    return "f64.sub";
  }
  if (tag == ir.K_FMUL) {
    return "f64.mul";
  }
  if (tag == ir.K_FDIV) {
    return "f64.div";
  }
  if (tag == ir.K_FSQRT) {
    return "f64.sqrt";
  }
  if (tag == ir.K_FFLOOR) {
    return "f64.floor";
  }
  if (tag == ir.K_FCEIL) {
    return "f64.ceil";
  }
  if (tag == ir.K_FTRUNC) {
    return "f64.trunc";
  }
  if (tag == ir.K_FABS) {
    return "f64.abs";
  }
  if (tag == ir.K_FNEG) {
    return "f64.neg";
  }
  if (tag == ir.K_FEQ) {
    return "f64.eq";
  }
  if (tag == ir.K_FNE) {
    return "f64.ne";
  }
  if (tag == ir.K_FLT) {
    return "f64.lt";
  }
  if (tag == ir.K_FLE) {
    return "f64.le";
  }
  if (tag == ir.K_FGT) {
    return "f64.gt";
  }
  if (tag == ir.K_FGE) {
    return "f64.ge";
  }
  return ircore.unsupported_op_refuse(tag, "wasm");
}

function slot_in_list(list: i32[], x: i32): boolean {
  for i in 0..list.len() {
    if (list[i] == x) {
      return true;
    }
  }
  return false;
}

function wasm_helper_symbol(name: string): string {
  if (name == "__fern_oob_abort") {
    return "$__fern_oob_abort";
  }
  if (name == "__fern_rc_inc" || name == "__fern_str_own") {
    return "$__fern_rc_inc";
  }
  if (name == "__fern_str_borrow") {
    return "$__fern_str_borrow";
  }
  if (name == "__fern_rc_dec") {
    return "$__fern_arr_dec";
  }
  if (name == "__fern_str_free") {
    return "$__fern_arr_dec";
  }
  if (name == "__fern_str_view_free") {
    return "$__fern_arr_dec";
  }
  if (name == "__fern_str_arr_free") {
    return "$__fern_arr_dec_ptr";
  }
  if (name == "__fern_rc_underflow_get") {
    return "$__fern_rc_underflow_count";
  }
  if (name == "__fern_i32_to_string") {
    return "$__fern_i32_to_str";
  }
  if (name == "__fern_i64_to_string") {
    return "$__fern_i64_to_str";
  }
  if (name == "__fern_u64_to_string") {
    return "$__fern_u64_to_str";
  }
  if (name == "__fern_u32_to_string") {
    return "$__fern_u32_to_str";
  }
  return "$" + name;
}

pub function module_allocates(cache: irtables.LowerResult[]): boolean {
  function needs_heap(o: ir.Op): boolean {
    return o.kind_tag == ir.K_TCP_CLOSE || ir.op_needs_heap(o);
  }
  if (any_op(cache, needs_heap)) {
    return true;
  }
  return module_uses_strings(cache);
}

pub function module_emits_op_cached(cache: irtables.LowerResult[], kind: string): boolean {
  let ktag: i32 = ir.kind_id(kind);
  function is_kind(o: ir.Op): boolean {
    return o.kind_tag == ktag;
  }
  return any_op(cache, is_kind);
}

function module_emits_push(cache: irtables.LowerResult[], kind: string, packed: boolean): boolean {
  let ktag = ir.kind_id(kind);
  function is_push(o: ir.Op): boolean {
    return o.kind_tag == ktag && ir.is_packed(o) == packed;
  }
  return any_op(cache, is_push);
}

function packed_suffix(o: ir.Op): string {
  if (ir.is_packed(o)) {
    return "_u8";
  }
  return "";
}

pub function module_uses_str_case(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "str_to_upper") || module_emits_op_cached(cache, "str_to_lower");
}

pub function module_uses_str_repeat(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "str_repeat");
}

pub function module_uses_str_trim(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "str_trim");
}

pub function module_uses_str_replace(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "str_replace");
}

pub function module_uses_str_lines(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "str_lines");
}

pub function module_uses_frame_window(cache: irtables.LowerResult[]): boolean {
  return any_op(cache, is_frame_window);
}

function is_frame_window(o: ir.Op): boolean {
  return ir.frame_box_base(o) >= 0 && o.kind_tag == ir.K_RAW_STRING;
}

pub function module_calls_direct(cache: irtables.LowerResult[], name: string): boolean {
  function is_call_to(o: ir.Op): boolean {
    return o.kind_tag == ir.K_CALL_DIRECT && o.str == name;
  }
  return any_op(cache, is_call_to);
}

pub function module_uses_task(cache: irtables.LowerResult[]): boolean {
  function is_task_call(o: ir.Op): boolean {
    // A close counts in the table of the task runtime.
    return o.kind_tag == ir.K_TCP_CLOSE || o.kind_tag == ir.K_CALL_DIRECT && ircore.is_task_runtime_fn(o.str);
  }
  return any_op(cache, is_task_call);
}

// count is true when the module has the allocation count of the program.
pub function task_funcs(lc: boolean, count: boolean): string {
  // The table of closes is storage of the runtime, not of the program.
  let fd_uncount = "";
  if (count) {
    fd_uncount = "      (global.set $__fern_alloc_count (i64.sub (global.get $__fern_alloc_count) (i64.const 1)))\n";
  }
  let uncount = "";
  if (lc) {
    uncount = "    (global.set $__fern_lc_alloc_count (i64.sub (global.get $__fern_lc_alloc_count) (i64.const 1)))\n"
      + "    (global.set $__fern_lc_alloc_bytes (i64.sub (global.get $__fern_lc_alloc_bytes) (i64.extend_i32_u (local.get $n))))\n";
  }
  return "  (global $__fern_task_cur_g (mut i32) (i32.const 0))\n"
    + "  (global $__fern_task_tab (mut i32) (i32.const 0))\n"
    + "  (global $__fern_task_cap (mut i32) (i32.const 0))\n"
    + "  (global $__fern_task_free_g (mut i32) (i32.const 0))\n"
    + "  (global $__fern_task_fresh_g (mut i32) (i32.const 1))\n"
    + "  (func $__fern_task_alloc (param $n i32) (result i32) (local $p i32)\n"
    + "    (local.set $p (call $__fern_alloc (local.get $n)))\n"
    + uncount
    + "    (local.get $p))\n"
    + "  (func $__fern_task_zalloc (param $n i32) (result i32) (local $p i32)\n"
    + "    (local.set $p (call $__fern_task_alloc (local.get $n)))\n"
    + "    (memory.fill (local.get $p) (i32.const 0) (local.get $n))\n"
    + "    (local.get $p))\n"
    + "  (func $__fern_task_slot (param $id i32) (result i32)\n"
    + "    (if (i32.or (i32.lt_s (local.get $id) (i32.const 1)) (i32.ge_s (local.get $id) (global.get $__fern_task_cap))) (then (unreachable)))\n"
    + "    (i32.wrap_i64 (i64.load (i32.add (global.get $__fern_task_tab) (i32.shl (local.get $id) (i32.const 3))))))\n"
    + "  (func $__fern_task_rec (param $id i32) (result i32) (local $r i32)\n"
    + "    (local.set $r (call $__fern_task_slot (local.get $id)))\n"
    + "    (if (i32.eqz (local.get $r)) (then (unreachable)))\n"
    + "    (if (i64.ne (i64.load offset=56 (local.get $r)) (i64.const 0)) (then (unreachable)))\n"
    + "    (local.get $r))\n"
    + "  (func $__fern_task_new (result i32) (local $id i32) (local $r i32) (local $cap i32) (local $nt i32)\n"
    + "    (if (i32.eqz (global.get $__fern_task_tab)) (then\n"
    + "      (global.set $__fern_task_tab (call $__fern_task_zalloc (i32.const 512)))\n"
    + "      (global.set $__fern_task_cap (i32.const 64))))\n"
    + "    (local.set $id (global.get $__fern_task_free_g))\n"
    + "    (if (local.get $id) (then\n"
    + "      (local.set $r (call $__fern_task_slot (local.get $id)))\n"
    + "      (global.set $__fern_task_free_g (i32.sub (i32.wrap_i64 (i64.load offset=56 (local.get $r))) (i32.const 1)))\n"
    + "      (i64.store offset=56 (local.get $r) (i64.const 0))\n"
    + "      (i64.store (local.get $r) (i64.const 0))\n"
    + "      (i64.store offset=8 (local.get $r) (i64.const 0))\n"
    + "      (i64.store offset=16 (local.get $r) (i64.const 0))\n"
    + "      (i64.store offset=24 (local.get $r) (i64.const 0))\n"
    + "      (i64.store offset=40 (local.get $r) (i64.const 0))\n"
    + "      (i64.store offset=72 (local.get $r) (i64.const 0))\n"
    + "      (return (local.get $id))))\n"
    + "    (local.set $cap (global.get $__fern_task_cap))\n"
    + "    (local.set $id (global.get $__fern_task_fresh_g))\n"
    + "    (global.set $__fern_task_fresh_g (i32.add (local.get $id) (i32.const 1)))\n"
    + "    (if (i32.lt_s (local.get $id) (local.get $cap)) (then\n"
    + "      (i64.store (i32.add (global.get $__fern_task_tab) (i32.shl (local.get $id) (i32.const 3))) (i64.extend_i32_u (call $__fern_task_zalloc (i32.const 96))))\n"
    + "      (return (local.get $id))))\n"
    + "    (local.set $nt (call $__fern_task_zalloc (i32.shl (local.get $cap) (i32.const 4))))\n"
    + "    (memory.copy (local.get $nt) (global.get $__fern_task_tab) (i32.shl (local.get $cap) (i32.const 3)))\n"
    + "    (global.set $__fern_task_tab (local.get $nt))\n"
    + "    (global.set $__fern_task_cap (i32.shl (local.get $cap) (i32.const 1)))\n"
    + "    (i64.store (i32.add (local.get $nt) (i32.shl (local.get $cap) (i32.const 3))) (i64.extend_i32_u (call $__fern_task_zalloc (i32.const 96))))\n"
    + "    (local.get $cap))\n"
    + "  (func $__fern_task_free (param $id i32) (result i32) (local $r i32)\n"
