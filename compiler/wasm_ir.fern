  o += "    (call $__fern_wasi_udp_stream (local.get $sock)\n";
  o += "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n";
  o += "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n";
  o += "      (local.get $ret))\n";
