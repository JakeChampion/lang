function filestat_bytes(): i32 {
  return 168;
}

function filestat_copy_u64(slot: i32, src: i32): string {
  return "    (i64.store (i32.add (local.get $fs) (i32.const " + util.i32_to_string(slot)
    + ")) (i64.load (i32.add (local.get $buf) (i32.const " + util.i32_to_string(src) + "))))\n";
}

function filestat_split_ns(slot: i32, src: i32): string {
  let load = "(i64.load (i32.add (local.get $buf) (i32.const " + util.i32_to_string(src) + ")))";
  let o: string = "    (i64.store (i32.add (local.get $fs) (i32.const " + util.i32_to_string(slot)
    + ")) (i64.div_u " + load + " (i64.const 1000000000)))\n";
  o = o + "    (i64.store (i32.add (local.get $fs) (i32.const " + util.i32_to_string(slot + 8)
    + ")) (i64.rem_u " + load + " (i64.const 1000000000)))\n";
  return o;
}

function filestat_zero(slot: i32): string {
  return "    (i64.store (i32.add (local.get $fs) (i32.const " + util.i32_to_string(slot)
    + ")) (i64.const 0))\n";
}

function stat_like_func(name: string, lookupflags: string): string {
  let o = "";
  o = o + "  (func $" + name + " (param $path i32) (param $fstype i32) (result i32)\n";
  o += "    (local $err i32) (local $buf i32) (local $ft i32) (local $fs i32) (local $res i32)\n";
  o += "    (local.set $buf (call $__fern_alloc (i32.const 64)))\n";
  o = o + "    (local.set $err (call $__fern_path_filestat_get (i32.const 3) (i32.const " + lookupflags + ") (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path)) (local.get $buf)))\n";
  o += "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
  o += "      (call $__fern_raw_free (local.get $buf) (i32.const 64))\n";
  o += "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $res) (i32.const 1))\n";
  o += "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get $path))))\n";
  o += "      (return (local.get $res))))\n";
  o += filestat_project_wat();
  return o;
}

pub function fd_stat_func(): string {
