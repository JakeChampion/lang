pub function byte_reduction_helper(bsd: boolean): string {
  let name = "sum_bytes_array";
  let params = "";
  if (bsd) {
    name = "bsd_sum_bytes";
    params = " (param $sum i32)";
  }
  let o = "  (func $__fern_" + name + " (param $s i32)" + params + " (result i32)\n";
  o = o + "    (local $len i32) (local $i i32)\n";
  if (!bsd) {
    o = o + "    (local $sum i32)\n";
  }
  if (bsd) {
    o = o + "    (local.set $sum (i32.and (local.get $sum) (i32.const 65535)))\n";
  }
  o = o + "    (local.set $len (i32.load (local.get $s)))\n";
  o = o + "    (block $d (loop $c\n";
  o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
  if (bsd) {
    o = o + "      (local.set $sum (i32.and (i32.or (i32.shr_u (local.get $sum) (i32.const 1)) (i32.shl (local.get $sum) (i32.const 15))) (i32.const 65535)))\n";
  }
  o = o + "      (local.set $sum (i32.add (local.get $sum) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 8)) (local.get $i)))))\n";
  if (bsd) {
    o = o + "      (local.set $sum (i32.and (local.get $sum) (i32.const 65535)))\n";
  }
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "      (br $c)))\n";
  return o + "    (local.get $sum))\n";
}

