function udp_errno(into: string, err_at: i32): string {
  return "(local.set " + into + " (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=" + util.i32_to_string(err_at) + " (local.get $ret)))))";
