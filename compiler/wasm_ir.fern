pub function module_uses_i32_to_string(cache: irtables.LowerResult[]): boolean {
  return module_calls_direct(cache, "__fern_i32_to_string");
}

pub function module_uses_i64_to_string(cache: irtables.LowerResult[]): boolean {
  return module_calls_direct(cache, "__fern_i64_to_string");
}

pub function module_uses_u64_to_string(cache: irtables.LowerResult[]): boolean {
  return module_calls_direct(cache, "__fern_u64_to_string");
}

pub function module_uses_u32_to_string(cache: irtables.LowerResult[]): boolean {
  return module_calls_direct(cache, "__fern_u32_to_string");
}

function array_helper_needs(cache: irtables.LowerResult[], own out: string[]): string[] {
  if (module_calls_direct(cache, "__fern_arr_str_join")) {
    out = out.append("@uses_arr_str_join");
  }
  if (module_calls_direct(cache, "__fern_arr_concat")) {
    out = out.append("@uses_arr_concat");
  }
  if (module_calls_direct(cache, "__fern_bytes_owned")) {
    out = out.append("@uses_bytes_owned");
  }
  if (module_calls_direct(cache, "__fern_bytes_append_range")) {
    out = out.append("@uses_byte_append");
  }
  if (module_calls_direct(cache, "__fern_bytes_write_range")) {
    out = out.append("@uses_byte_write");
  }
  if (module_calls_direct(cache, "__fern_bytes_append_back")) {
    out = out.append("@uses_byte_back");
  }
  if (module_calls_direct(cache, "__fern_bytes_range")) {
    out = out.append("@uses_bytes_range");
  }
  if (module_calls_direct(cache, "__fern_bytes_into")) {
    out = out.append("@uses_bytes_into");
  }
  return out;
}

// A byte-copy helper that the module defines itself gets no runtime copy.
function byte_copy_need(needs: string[], key: string, name: string, mod: parser.Module): boolean {
  if (!need(needs, key)) {
    return false;
  }
  for fd in mod.funcs {
    if (fd.name == name && fd.receiver_type.len() == 0) {
      return false;
    }
  }
  return true;
}

function array_helper_parts(needs: string[], mod: parser.Module, own parts: string[], empty: i32): string[] {
  if (need(needs, "@uses_arr_str_join")) {
    parts = parts.append(arr_str_join_helper());
  }
  if (need(needs, "@uses_arr_concat")) {
    parts = parts.append(arr_concat_helper());
  }
  if (need(needs, "@uses_bytes_owned")) {
    parts = parts.append(bytes_owned_helper(empty));
  }
  let append = byte_copy_need(needs, "@uses_byte_append", "__fern_bytes_append_range", mod);
  let write = byte_copy_need(needs, "@uses_byte_write", "__fern_bytes_write_range", mod);
  let back = byte_copy_need(needs, "@uses_byte_back", "__fern_bytes_append_back", mod);
  if (append || write || back) {
    parts = parts.append(rtbytecopy.wasm_source(append, write, back));
  }
  if (need(needs, "@uses_bytes_range")) {
    parts = parts.append(bytes_range_helper(empty));
  }
  if (need(needs, "@uses_bytes_into")) {
    parts = parts.append(bytes_into_helper());
  }
  return parts;
}

pub function module_uses_buf(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "buf_new") || module_emits_op_cached(cache, "buf_push")
    || module_emits_op_cached(cache, "buf_push_range") || module_emits_op_cached(cache, "buf_push_byte")
    || module_emits_op_cached(cache, "buf_push_mapped") || module_emits_op_cached(cache, "buf_push_filtered")
    || module_emits_op_cached(cache, "buf_push_expanded")
    || module_emits_op_cached(cache, "buf_push_bytes_mapped") || module_emits_op_cached(cache, "buf_push_bytes_filtered") || module_emits_op_cached(cache, "buf_push_bytes_expanded")
    || module_emits_op_cached(cache, "buf_push_u64") || module_emits_op_cached(cache, "buf_push_decimal") || module_emits_op_cached(cache, "buf_push_base64") || module_emits_op_cached(cache, "buf_push_base32") || module_emits_op_cached(cache, "buf_decode_base32")
    || module_emits_op_cached(cache, "buf_len") || module_emits_op_cached(cache, "buf_take")
    || module_emits_op_cached(cache, "buf_take_bytes")
    || module_emits_op_cached(cache, "buf_push_bytes_range")
    || module_emits_op_cached(cache, "buf_clear")
    || module_emits_op_cached(cache, "buf_free");
}

pub function module_uses_random(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "random_bytes") || module_emits_op_cached(cache, "random_i32")
    || module_emits_op_cached(cache, "map_hash_seed") || module_emits_op_cached(cache, "temp_dir");
}

pub function module_uses_divrem(cache: irtables.LowerResult[]): boolean {
  function is_divrem(o: ir.Op): boolean {
    return o.kind_tag == ir.K_DIV_S || o.kind_tag == ir.K_REM_S;
  }
  return any_op(cache, is_divrem);
}

pub function module_uses_arr_slice(cache: irtables.LowerResult[]): boolean {
  function is_arr_slice(o: ir.Op): boolean {
    return o.kind_tag == ir.K_ARR_SLICE && o.width != 64 && !ir.is_packed(o);
  }
  return any_op(cache, is_arr_slice);
}

pub function module_uses_arr_slice_u8(cache: irtables.LowerResult[]): boolean {
  function is_arr_slice_u8(o: ir.Op): boolean {
    return o.kind_tag == ir.K_ARR_SLICE && ir.is_packed(o);
  }
  return any_op(cache, is_arr_slice_u8);
}

pub function module_uses_arr_slice8(cache: irtables.LowerResult[]): boolean {
  function is_arr_slice8(o: ir.Op): boolean {
    return o.kind_tag == ir.K_ARR_SLICE && o.width == 64;
  }
  return any_op(cache, is_arr_slice8);
}

pub function module_uses_udivrem(cache: irtables.LowerResult[]): boolean {
  return any_op(cache, is_udivrem);
}

pub function module_uses_i64_udivrem(cache: irtables.LowerResult[]): boolean {
  return any_op(cache, is_i64_udivrem);
}

function is_udivrem(o: ir.Op): boolean {
  return (o.kind_tag == ir.K_DIV_U || o.kind_tag == ir.K_REM_U) && o.width != 64;
}

function is_i64_udivrem(o: ir.Op): boolean {
  return (o.kind_tag == ir.K_DIV_U || o.kind_tag == ir.K_REM_U) && o.width == 64;
}

pub function module_uses_i64_divrem(cache: irtables.LowerResult[]): boolean {
  function is_i64_divrem(o: ir.Op): boolean {
    return (o.kind_tag == ir.K_DIV_S || o.kind_tag == ir.K_REM_S) && o.width == 64;
  }
  return any_op(cache, is_i64_divrem);
}

function module_erased_wide(cache: irtables.LowerResult[]): boolean {
  for i in 0..cache.len() {
    if (cache[i].erased_wide) {
      return true;
    }
  }
  return false;
}

function all_lowered_ok(cache: irtables.LowerResult[]): boolean {
  for i in 0..cache.len() {
    if (!cache[i].ok) {
      return false;
    }
  }
  return true;
}

pub function wasm_unsupported_import(mod: parser.Module): string {
  let stab = irtables.struct_tab(mod.structs);
  let why = " fields must be integers, floats, booleans or records of them, at most 16 leaves in all";
  for i in 0..mod.funcs.len() {
    let f = mod.funcs[i];
    if (is_sync_extern(f)) {
      if (is_struct_type(stab, f.ret_type) && !extern_record_result_supported(mod, f.ret_type)) {
        return "error: @import " + f.name + " returns record " + f.ret_type + ", which wasm cannot lower: its" + why;
      }
      for p in 0..f.params.len() {
        let pt = f.params[p].type_name;
        if (is_struct_type(stab, pt) && !extern_record_param_supported(mod, pt)) {
          return "error: @import " + f.name + " takes record " + pt + ", which wasm cannot lower: its" + why;
        }
      }
    }
  }
  return "";
}

pub function wasm_ir_deferrals_ok(cache: irtables.LowerResult[]): boolean {
  return true
    && all_lowered_ok(cache)
    && !module_erased_wide(cache);
}

pub function component_refused_need(needs: string[], io: boolean, proxy: boolean): string {
  let i = 0;
  while (i < needs.len()) {
    let n = needs[i];
    if (proxy && n == "exit") {
      i += 1;
      continue;
    }
    if (n == "@uses_random") {
      if (io) {
        i += 1;
        continue;
      }
      return n;
    }
    if (n[0] == 64 || n == "free") {
      i += 1;
      continue;
    }
    if (n == "clock_set" || n == "clone_file") {
      i += 1;
      continue;
    }
    if (io && (n == "print_str" || n == "eprint_str" || n == "putchar"
      || n == "exit")) {
      i += 1;
      continue;
    }
    if (io && (n == "writer_write" || n == "write_some" || n == "write_bytes" || n == "write_some_bytes")) {
      i += 1;
      continue;
    }
    if (io && (n == "now_ns" || n == "now_unix_ms" || n == "monotonic_ns" || n == "clock_resolution"
      || n == "random_bytes" || n == "random_i32")) {
      i += 1;
      continue;
    }
    if (io && (n == "env" || n == "environ" || n == "args")) {
      i += 1;
      continue;
    }
    if (io && (n == "read_file" || n == "read_file_bytes" || n == "write_file" || n == "write_file_bytes")) {
      i += 1;
      continue;
    }
    if (io && component_admits_fs(n)) {
      i += 1;
      continue;
    }
    if (io && (util.has_str(socket_builtins(), n) || util.has_str(wait_builtins(), n))) {
      i += 1;
      continue;
    }
    if (n == "arr_reserve" || n == "arr_push" || n == "arr_push_owned" || n == "arr_push_i64"
      || n == "arr_push_f64" || n == "arr_push_owned_i64" || n == "arr_push_owned_f64"
      || n == "arr_push_u8" || n == "arr_push_owned_u8"
      || n == "str_split"
      || n == "buf_take_bytes" || n == "buf_push_bytes_range"
      || n == "buf_new" || n == "buf_push" || n == "buf_push_range"
      || n == "buf_push_mapped" || n == "buf_push_filtered" || n == "buf_push_expanded"
      || n == "buf_push_bytes_mapped" || n == "buf_push_bytes_filtered" || n == "buf_push_bytes_expanded"
      || n == "buf_push_byte" || n == "buf_push_u64" || n == "buf_push_decimal" || n == "buf_push_base64" || n == "buf_push_base32" || n == "buf_decode_base32" || n == "buf_len"
      || n == "buf_clear" || n == "buf_take" || n == "buf_free"
      || n == "str_bytes" || n == "str_from_bytes" || n == "str_from_bytes_range") {
      i += 1;
      continue;
    }
    return n;
  }
  return "";
}

pub function clock_imports_p2(has_wall: boolean, has_mono: boolean): string {
  let o = "";
  if (has_wall) {
    o += "  (import \"wasi:clocks/wall-clock@0.2.0\" \"now\" (func $__fern_wall_now (param i32)))\n";
  }
  if (has_mono) {
    o += "  (import \"wasi:clocks/monotonic-clock@0.2.0\" \"now\" (func $__fern_mono_now (result i64)))\n";
  }
  return o;
}

function p2_return_area(n: string): string {
  return "    (local.set $base (call $__fern_alloc (i32.const " + n + ")))\n"
    + "    (local.set $ra (i32.and (i32.add (local.get $base) (i32.const 7)) (i32.const -8)))\n";
}

// Empty host results have no allocated block to free.
function free_env_list_p2(): string {
  let o = "    (local.set $i (i32.const 0))\n";
  o += "    (block $fd (loop $fc\n";
  o += "      (br_if $fd (i32.ge_u (local.get $i) (local.get $count)))\n";
  o += "      (local.set $tup (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 16))))\n";
  o += "      (if (i32.load offset=4 (local.get $tup)) (then (call $__fern_raw_free (i32.load (local.get $tup)) (i32.load offset=4 (local.get $tup)))))\n";
  o += "      (if (i32.load offset=12 (local.get $tup)) (then (call $__fern_raw_free (i32.load offset=8 (local.get $tup)) (i32.load offset=12 (local.get $tup)))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $fc)))\n";
  o += "    (if (local.get $count) (then (call $__fern_raw_free (local.get $ptr) (i32.mul (local.get $count) (i32.const 16)))))\n";
  return o + "    (call $__fern_raw_free (local.get $base) (i32.const 16))\n";
}

pub function clock_funcs_p2(has_wall: boolean, has_mono: boolean): string {
  let o = "";
  if (has_wall) {
    o += "  (func $__fern_now_ns (result i64)\n";
    o += "    (local $ra i32) (local $v i64)\n";
    o = o + "    (local.set $ra (i32.const " + util.i32_to_string(io_ret_addr()) + "))\n";
    o += "    (call $__fern_wall_now (local.get $ra))\n";
    o += "    (local.set $v (i64.add (i64.mul (i64.load (local.get $ra)) (i64.const 1000000000)) (i64.extend_i32_u (i32.load (i32.add (local.get $ra) (i32.const 8))))))\n";
    o += "    (local.get $v))\n";
    o += "  (func $__fern_now_unix_ms (result i64)\n";
    o += "    (local $ra i32) (local $v i64)\n";
    o = o + "    (local.set $ra (i32.const " + util.i32_to_string(io_ret_addr()) + "))\n";
    o += "    (call $__fern_wall_now (local.get $ra))\n";
    o += "    (local.set $v (i64.add (i64.mul (i64.load (local.get $ra)) (i64.const 1000)) (i64.div_u (i64.extend_i32_u (i32.load (i32.add (local.get $ra) (i32.const 8)))) (i64.const 1000000))))\n";
    o += "    (local.get $v))\n";
  }
  if (has_mono) {
    o += "  (func $__fern_monotonic_ns (result i64)\n";
    o += "    (call $__fern_mono_now))\n";
  }
  return o;
}

pub function clock_resolution_func_p2(): string {
  let o = "  (func $__fern_clock_resolution (result i64)\n";
  o += "    (local $base i32) (local $ra i32) (local $v i64)\n";
  o += p2_return_area("16");
  o += "    (call $__fern_wall_resolution (local.get $ra))\n";
  o += "    (local.set $v (i64.add (i64.mul (i64.load (local.get $ra)) (i64.const 1000000000)) (i64.extend_i32_u (i32.load (i32.add (local.get $ra) (i32.const 8))))))\n";
  o += "    (call $__fern_raw_free (local.get $base) (i32.const 16))\n";
  return o + "    (local.get $v))\n";
}

pub function random_imports_p2(): string {
  return "  (import \"wasi:random/random@0.2.0\" \"get-random-u64\" (func $__fern_get_random_u64 (result i64)))\n";
}

pub function random_func_p2(): string {
  let o = "";
  o += "  (func $__fern_random_bytes (param $n i32) (result i32)\n";
  o += "    (local $arr i32) (local $i i32) (local $r i64)\n";
  o += "    (local.set $arr (call $__fern_arr_elems (local.get $n) (i32.const 1)))\n";
  o += "    (i32.store (local.get $arr) (local.get $n))\n";
  o += "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $n))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $d (loop $c\n";
  o += "      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))\n";
  o += "      (if (i32.eqz (i32.and (local.get $i) (i32.const 7))) (then (local.set $r (call $__fern_get_random_u64))))\n";
  o += "      (i32.store8 (i32.add (i32.add (local.get $arr) (i32.const 8)) (local.get $i)) (i32.wrap_i64 (i64.shr_u (local.get $r) (i64.extend_i32_u (i32.mul (i32.and (local.get $i) (i32.const 7)) (i32.const 8))))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $c)))\n";
  o += "    (local.get $arr))\n";
  o += "  (func $__fern_random_i32 (result i32)\n";
  o += "    (i32.wrap_i64 (call $__fern_get_random_u64)))\n";
  return o;
}

pub function env_imports_p2(): string {
  return "  (import \"wasi:cli/environment@0.2.0\" \"get-environment\" (func $__fern_get_environment (param i32)))\n";
}

pub function env_func_p2(): string {
  let o = "";
  o += "  (func $__fern_env (param $np i32) (result i32)\n";
  o += "    (local $base i32) (local $ra i32) (local $ptr i32) (local $count i32) (local $nlen i32)\n";
  o += "    (local $i i32) (local $tup i32) (local $kp i32) (local $kl i32)\n";
  o += "    (local $vp i32) (local $vl i32) (local $ok i32) (local $j i32) (local $res i32) (local $tmp i32)\n";
  o += "    (local.set $nlen (i32.load (local.get $np)))\n";
  o += p2_return_area("16");
  o += "    (call $__fern_get_environment (local.get $ra))\n";
  o += "    (local.set $ptr (i32.load (local.get $ra)))\n";
  o += "    (local.set $count (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $done (loop $cont\n";
  o += "      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))\n";
  o += "      (local.set $tup (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 16))))\n";
  o += "      (local.set $kp (i32.load (local.get $tup)))\n";
  o += "      (local.set $kl (i32.load (i32.add (local.get $tup) (i32.const 4))))\n";
  o += "      (if (i32.eq (local.get $kl) (local.get $nlen)) (then\n";
  o += "        (local.set $ok (i32.const 1))\n";
  o += "        (local.set $j (i32.const 0))\n";
  o += "        (block $md (loop $mc\n";
  o += "          (br_if $md (i32.ge_u (local.get $j) (local.get $nlen)))\n";
  o += "          (if (i32.ne (i32.load8_u (i32.add (local.get $kp) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $np) (i32.const 4)) (local.get $j)))) (then (local.set $ok (i32.const 0)) (br $md)))\n";
  o += "          (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "          (br $mc)))\n";
  o += "        (if (local.get $ok) (then\n";
  o += "          (local.set $vp (i32.load (i32.add (local.get $tup) (i32.const 8))))\n";
  o += "          (local.set $vl (i32.load (i32.add (local.get $tup) (i32.const 12))))\n";
  o += "          (local.set $res (call $__fern_str_box (i32.add (i32.const 4) (local.get $vl))))\n";
  o += "          (i32.store (local.get $res) (local.get $vl))\n";
  o += "          (local.set $j (i32.const 0))\n";
  o += "          (block $cd (loop $cc\n";
  o += "            (br_if $cd (i32.ge_u (local.get $j) (local.get $vl)))\n";
  o += "            (i32.store8 (i32.add (i32.add (local.get $res) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $vp) (local.get $j))))\n";
  o += "            (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "            (br $cc)))\n";
  o += "          (br $done)))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $cont)))\n";
  o += free_env_list_p2();
  o += "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $tmp) (i32.eqz (local.get $res)))\n";
  o += "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $res))\n";
  o += "    (local.get $tmp))\n";
  return o;
}

pub function config_imports_p2(): string {
  return "  (import \"wasi:config/store@0.2.0-rc.1\" \"get\" (func $__fern_config_get (param i32 i32 i32)))\n";
}

pub function config_env_func_p2(): string {
  let o = "";
  o += "  (func $__fern_env (param $np i32) (result i32)\n";
  o += "    (local $base i32) (local $ra i32) (local $vp i32) (local $vl i32) (local $j i32) (local $res i32) (local $tmp i32)\n";
  o += p2_return_area("24");
  o += "    (call $__fern_config_get (i32.add (local.get $np) (i32.const 4)) (i32.load (local.get $np)) (local.get $ra))\n";
  o += "    (if (i32.and (i32.eqz (i32.load8_u (local.get $ra))) (i32.eq (i32.load8_u (i32.add (local.get $ra) (i32.const 4))) (i32.const 1))) (then\n";
  o += "      (local.set $vp (i32.load (i32.add (local.get $ra) (i32.const 8))))\n";
  o += "      (local.set $vl (i32.load (i32.add (local.get $ra) (i32.const 12))))\n";
  o += "      (local.set $res (call $__fern_str_box (i32.add (i32.const 4) (local.get $vl))))\n";
  o += "      (i32.store (local.get $res) (local.get $vl))\n";
  o += "      (local.set $j (i32.const 0))\n";
  o += "      (block $cd (loop $cc\n";
  o += "        (br_if $cd (i32.ge_u (local.get $j) (local.get $vl)))\n";
  o += "        (i32.store8 (i32.add (i32.add (local.get $res) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $vp) (local.get $j))))\n";
  o += "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "        (br $cc)))))\n";
  o += "    (if (i32.or (i32.load8_u (local.get $ra)) (i32.load8_u (i32.add (local.get $ra) (i32.const 4)))) (then\n";
  o += "      (call $__fern_raw_free (i32.load (i32.add (local.get $ra) (i32.const 8))) (i32.load (i32.add (local.get $ra) (i32.const 12))))))\n";
  o += "    (call $__fern_raw_free (local.get $base) (i32.const 24))\n";
  o += "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $tmp) (i32.eqz (local.get $res)))\n";
  o += "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $res))\n";
  o += "    (local.get $tmp))\n";
  return o;
}

function module_is_proxy(mod: parser.Module): boolean {
  for e in mod.exports {
    if (e.iface == "wasi:http/incoming-handler@0.2.0") {
      return true;
    }
  }
  return false;
}

pub function args_imports_p2(): string {
  return "  (import \"wasi:cli/environment@0.2.0\" \"get-arguments\" (func $__fern_get_arguments (param i32)))\n";
}

pub function args_func_p2(set_args: boolean): string {
  let o = "";
  o += "  (func $__fern_args (result i32)\n";
  o += "    (local $base i32) (local $ra i32) (local $ptr i32) (local $count i32) (local $arr i32)\n";
  o += "    (local $i i32) (local $sp i32) (local $sl i32) (local $blk i32) (local $j i32)\n";
  o += args_set_answer(set_args);
  o += p2_return_area("16");
  o += "    (call $__fern_get_arguments (local.get $ra))\n";
  o += "    (local.set $ptr (i32.load (local.get $ra)))\n";
  o += "    (local.set $count (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
  o += "    (local.set $arr (call $__fern_arr_elems (local.get $count) (i32.const 4)))\n";
  o += "    (i32.store (local.get $arr) (local.get $count))\n";
  o += "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $count))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $d (loop $c\n";
  o += "      (br_if $d (i32.ge_u (local.get $i) (local.get $count)))\n";
  o += "      (local.set $sp (i32.load (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 8)))))\n";
  o += "      (local.set $sl (i32.load (i32.add (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 8))) (i32.const 4))))\n";
  o += "      (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $sl))))\n";
  o += "      (i32.store (local.get $blk) (local.get $sl))\n";
  o += "      (local.set $j (i32.const 0))\n";
  o += "      (block $cd (loop $cc\n";
  o += "        (br_if $cd (i32.ge_u (local.get $j) (local.get $sl)))\n";
  o += "        (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $sp) (local.get $j))))\n";
  o += "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "        (br $cc)))\n";
  o += "      (if (local.get $sl) (then (call $__fern_raw_free (local.get $sp) (local.get $sl))))\n";
  o += "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (local.get $blk))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $c)))\n";
  o += "    (if (local.get $count) (then (call $__fern_raw_free (local.get $ptr) (i32.mul (local.get $count) (i32.const 8)))))\n";
  o += "    (call $__fern_raw_free (local.get $base) (i32.const 16))\n";
  o += "    (local.get $arr))\n";
  return o;
}

pub function environ_func_p2(): string {
  let o = "";
  o += "  (func $__fern_environ (result i32)\n";
  o += "    (local $base i32) (local $ra i32) (local $ptr i32) (local $count i32) (local $arr i32)\n";
  o += "    (local $i i32) (local $tp i32) (local $tup i32) (local $kl i32) (local $vl i32) (local $blk i32) (local $j i32)\n";
  o += p2_return_area("16");
  o += "    (call $__fern_get_environment (local.get $ra))\n";
  o += "    (local.set $ptr (i32.load (local.get $ra)))\n";
  o += "    (local.set $count (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
  o += "    (local.set $arr (call $__fern_arr_elems (local.get $count) (i32.const 4)))\n";
  o += "    (i32.store (local.get $arr) (local.get $count))\n";
  o += "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $count))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $d (loop $c\n";
  o += "      (br_if $d (i32.ge_u (local.get $i) (local.get $count)))\n";
  o += "      (local.set $tp (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 16))))\n";
  o += "      (local.set $kl (i32.load (i32.add (local.get $tp) (i32.const 4))))\n";
  o += "      (local.set $vl (i32.load (i32.add (local.get $tp) (i32.const 12))))\n";
  o += "      (local.set $blk (call $__fern_str_box (i32.add (i32.const 5) (i32.add (local.get $kl) (local.get $vl)))))\n";
  o += "      (i32.store (local.get $blk) (i32.add (i32.add (local.get $kl) (local.get $vl)) (i32.const 1)))\n";
  o += "      (local.set $j (i32.const 0))\n";
  o += "      (block $kd (loop $kc\n";
  o += "        (br_if $kd (i32.ge_u (local.get $j) (local.get $kl)))\n";
  o += "        (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (i32.load (local.get $tp)) (local.get $j))))\n";
  o += "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "        (br $kc)))\n";
  o += "      (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $kl)) (i32.const 61))\n";
  o += "      (local.set $j (i32.const 0))\n";
  o += "      (block $vd (loop $vc\n";
  o += "        (br_if $vd (i32.ge_u (local.get $j) (local.get $vl)))\n";
  o += "        (i32.store8 (i32.add (i32.add (i32.add (local.get $blk) (i32.const 5)) (local.get $kl)) (local.get $j)) (i32.load8_u (i32.add (i32.load (i32.add (local.get $tp) (i32.const 8))) (local.get $j))))\n";
  o += "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "        (br $vc)))\n";
  o += "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (local.get $blk))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $c)))\n";
  o += free_env_list_p2();
  o += "    (local.get $arr))\n";
  return o;
}

pub function fs_imports_p2(needs: string[]): string {
  let o = "";
  for g in fs_import_gates_p2(needs) {
    if (g.on) {
      o = o + "  (import \"" + g.text + "\n";
    }
  }
  return o;
}

struct GatedImport { on: boolean, text: string }

function fs_import_gates_p2(needs: string[]): GatedImport[] {
  let t = "wasi:filesystem/types@0.2.0\" \"[method]descriptor.";
  let r = "wasi:filesystem/types@0.2.0\" \"[resource-drop]";
  let s = "wasi:io/streams@0.2.0\" \"";
  let rd = need_read_file(needs);
  let wr = need_write_file(needs);
  let files = need_open_file(needs);
  return [
    GatedImport { on: need_preopen_p2(needs), text: "wasi:filesystem/preopens@0.2.0\" \"get-directories\" (func $__fern_get_directories (param i32)))" },
    GatedImport { on: need_open_at_p2(needs), text: t + "open-at\" (func $__fern_open_at (param i32 i32 i32 i32 i32 i32 i32)))" },
    GatedImport { on: need_preopen_p2(needs), text: r + "descriptor\" (func $__fern_desc_drop (param i32)))" },
    GatedImport { on: rd || files, text: t + "read-via-stream\" (func $__fern_read_via_stream (param i32 i64 i32)))" },
    GatedImport { on: rd || need_fd_read(needs), text: s + "[method]input-stream.blocking-read\" (func $__fern_blocking_read (param i32 i64 i32)))" },
    GatedImport { on: need_in_drop_p2(needs), text: s + "[resource-drop]input-stream\" (func $__fern_in_strm_drop (param i32)))" },
    GatedImport { on: wr || files, text: t + "write-via-stream\" (func $__fern_write_via_stream (param i32 i64 i32)))" },
    GatedImport { on: need_out_drop_p2(needs), text: s + "[resource-drop]output-stream\" (func $__fern_out_strm_drop (param i32)))" },
    GatedImport { on: files, text: t + "append-via-stream\" (func $__fern_append_via_stream (param i32 i32)))" },
    GatedImport { on: files_need(needs, ["fd_stat", "reader_seek"]), text: t + "stat\" (func $__fern_desc_stat (param i32 i32)))" },
    GatedImport { on: need_any(needs, ["stat", "lstat"]), text: t + "stat-at\" (func $__fern_stat_at (param i32 i32 i32 i32 i32)))" },
    GatedImport { on: need(needs, "truncate") || files_need(needs, ["writer_truncate"]), text: t + "set-size\" (func $__fern_desc_set_size (param i32 i64 i32)))" },
    GatedImport { on: files_need(needs, ["fd_fsync"]), text: t + "sync\" (func $__fern_desc_sync (param i32 i32)))" },
    GatedImport { on: files_need(needs, ["writer_set_times"]), text: t + "set-times\" (func $__fern_desc_set_times (param i32 i32 i64 i32 i32 i64 i32 i32)))" },
    GatedImport { on: files_need(needs, ["fd_fdatasync"]), text: t + "sync-data\" (func $__fern_desc_sync_data (param i32 i32)))" },
    GatedImport { on: files_need(needs, ["fd_drop_cache"]), text: t + "advise\" (func $__fern_desc_advise (param i32 i64 i64 i32 i32)))" },
    GatedImport { on: need(needs, "set_file_times"), text: t + "set-times-at\" (func $__fern_set_times_at (param i32 i32 i32 i32 i32 i64 i32 i32 i64 i32 i32)))" },
    GatedImport { on: need_any(needs, ["create_dir", "create_dir_all", "temp_dir"]), text: t + "create-directory-at\" (func $__fern_create_directory_at (param i32 i32 i32 i32)))" },
    GatedImport { on: need_any(needs, ["remove_file", "remove_dir_all"]), text: t + "unlink-file-at\" (func $__fern_unlink_file_at (param i32 i32 i32 i32)))" },
    GatedImport { on: need_any(needs, ["remove_dir", "remove_dir_all"]), text: t + "remove-directory-at\" (func $__fern_remove_directory_at (param i32 i32 i32 i32)))" },
    GatedImport { on: need(needs, "rename"), text: t + "rename-at\" (func $__fern_rename_at (param i32 i32 i32 i32 i32 i32 i32)))" },
    GatedImport { on: need(needs, "create_link"), text: t + "link-at\" (func $__fern_link_at (param i32 i32 i32 i32 i32 i32 i32 i32)))" },
    GatedImport { on: need(needs, "create_symlink"), text: t + "symlink-at\" (func $__fern_symlink_at (param i32 i32 i32 i32 i32 i32)))" },
    GatedImport { on: need(needs, "read_link"), text: t + "readlink-at\" (func $__fern_readlink_at (param i32 i32 i32 i32)))" },
    GatedImport { on: need_dir_list(needs), text: t + "read-directory\" (func $__fern_read_directory (param i32 i32)))" },
    GatedImport { on: need_dir_list(needs), text: "wasi:filesystem/types@0.2.0\" \"[method]directory-entry-stream.read-directory-entry\" (func $__fern_read_dir_entry (param i32 i32)))" },
    GatedImport { on: need_dir_list(needs), text: r + "directory-entry-stream\" (func $__fern_dir_strm_drop (param i32)))" },
    GatedImport { on: need_stdin_p2(needs), text: "wasi:cli/stdin@0.2.0\" \"get-stdin\" (func $__fern_get_stdin (result i32)))" },
  ];
}

function files_need(needs: string[], ops: string[]): boolean {
  return need_open_file(needs) && need_any(needs, ops);
}

function need_in_drop_p2(needs: string[]): boolean {
  let ins = need_open_file(needs) || need(needs, "@stdin");
  return need_read_file(needs) || ins && need_any(needs, ["reader_close", "reader_seek"]);
}

function need_out_drop_p2(needs: string[]): boolean {
  return need_write_file(needs) || need(needs, "reader_close") || files_need(needs, ["reader_seek"]);
}

function need_stdin_p2(needs: string[]): boolean {
  return need(needs, "@stdin") && need_fd_read(needs);
}

function need_read_file(needs: string[]): boolean {
  return need(needs, "read_file") || need(needs, "read_file_bytes");
}

function need_write_file(needs: string[]): boolean {
  return need(needs, "write_file") || need(needs, "write_file_bytes");
}

function need_fd_read(needs: string[]): boolean {
  return need_any(needs, ["read_chunk", "read_chunk_bytes"]);
}

function need_dir_list(needs: string[]): boolean {
  return need_any(needs, ["read_dir", "read_dir_bytes", "read_dir_all", "read_dir_ino", "read_dir_ino_all", "remove_dir_all"]);
}

function need_open_at_p2(needs: string[]): boolean {
  return need_read_file(needs) || need_write_file(needs) || need_open_file(needs) || need(needs, "truncate") || need_dir_list(needs);
}

function need_preopen_p2(needs: string[]): boolean {
  return need_open_at_p2(needs) || need_any(needs, [
    "stat", "lstat", "create_dir", "create_dir_all", "remove_file", "remove_dir", "rename",
    "read_link", "read_link_bytes", "create_symlink", "create_link", "set_file_times", "temp_dir",
  ]);
}

function need_fd_table(needs: string[]): boolean {
  return need_open_file(needs) || need_fd_read(needs) || need_any(needs, [
    "reader_close", "fd_stat", "fd_fsync", "fd_fdatasync", "fd_drop_cache", "reader_seek", "fd_flags", "writer_truncate", "writer_set_times",
  ]);
}

function component_fs_needs(): string[] {
  return [
    "open_file", "open_with", "reader_close", "read_chunk", "read_chunk_bytes",
    "fd_stat", "fd_fsync", "fd_fdatasync", "fd_drop_cache", "reader_seek", "fd_flags", "writer_truncate", "writer_set_times",
    "stat", "lstat", "read_dir", "read_dir_bytes", "read_dir_all", "read_dir_ino", "read_dir_ino_all", "create_dir", "create_dir_all", "remove_file",
    "remove_dir", "remove_dir_all", "rename", "read_link", "read_link_bytes", "create_symlink", "create_link",
    "truncate", "set_file_times", "temp_dir",
  ];
}

function component_admits_fs(n: string): boolean {
  return util.has_str(component_fs_needs(), n) || util.has_str(["fd_syncfs", "fd_dup_onto", "writer_nonblocking", "reader_splice", "reader_copy_range", "writer_splice_forever"], n);
}

pub function component_framable(needs: string[]): boolean {
  return !need_any(needs, component_fs_needs());
}

pub function component_fs_shims(needs: string[], stderr: boolean): string {
  let files = need_open_file(needs);
  let o = "";
  if (need_preopen_p2(needs)) {
    o += preopen_func_p2();
  }
  if (need_fd_table(needs)) {
    o += fd_table_funcs();
  }
  if (need_any(needs, ["stat", "lstat"]) || files && need(needs, "fd_stat")) {
    o += filestat_func_p2();
  }
  if (files) {
    o = o + is_dir_at_func_p2() + path_open_shim();
  }
  if (need_fd_read(needs)) {
    o += fd_read_shim(need(needs, "@stdin"));
  }
  if (need(needs, "reader_close")) {
    o += fd_close_shim(files, files || need(needs, "@stdin"), stderr);
  }
  return o + fd_query_shims(needs, files) + path_shims(needs);
}

function fd_query_shims(needs: string[], files: boolean): string {
  let o = "";
  if (need(needs, "fd_stat")) {
    o += desc_shim("fd_filestat_get", "(param $buf i32)", files, "desc_stat", "", "104", "8");
  }
  if (need(needs, "fd_fsync")) {
    o += desc_shim("fd_sync", "", files, "desc_sync", "", "8", "1");
  }
  if (need(needs, "writer_set_times")) {
    o += desc_shim("fd_filestat_set_times", "(param $atim i64) (param $mtim i64) (param $fst i32)", files, "desc_set_times", " " + new_timestamp_p2("$atim", "1", "2") + " " + new_timestamp_p2("$mtim", "4", "8"), "8", "1");
  }
  if (need(needs, "fd_fdatasync")) {
    o += desc_shim("fd_datasync", "", files, "desc_sync_data", "", "8", "1");
  }
  if (need(needs, "fd_drop_cache")) {
    o += desc_shim("fd_advise", "(param $off i64) (param $len i64) (param $adv i32)", files, "desc_advise", " (local.get $off) (local.get $len) (local.get $adv)", "8", "1");
  }
  if (need(needs, "writer_truncate")) {
    o += desc_shim("fd_filestat_set_size", "(param $len i64)", files, "desc_set_size", " (local.get $len)", "8", "1");
  }
  if (need(needs, "reader_seek")) {
    o += fd_seek_shim(files);
  }
  if (need(needs, "fd_flags")) {
    o += fd_fdstat_shim();
  }
  return o;
}

function path_shims(needs: string[]): string {
  let o = "";
  if (need_any(needs, ["stat", "lstat"])) {
    o += path_filestat_shim();
  }
  for sh in path_mutator_shims() {
    if (need_any(needs, sh.ops)) {
      o += path_shim(sh.name, sh.sig, sh.method, sh.args);
    }
  }
  if (need(needs, "read_link")) {
    o += path_readlink_shim();
  }
  if (need_dir_list(needs)) {
    o += dir_names_func_p2();
  }
  return o;
}

function p2_preopen(bytes: string): string {
  return "    (local.set $pre (call $__fern_preopen_p2))\n"
    + "    (if (i32.lt_s (local.get $pre) (i32.const 0)) (then (return (i32.const 44))))\n"
    + "    (local.set $ra (call $__fern_alloc (i32.const " + bytes + ")))\n";
}

function p2_fail_ret(off: string, bytes: string): string {
  return "    (if (i32.load8_u (local.get $ra)) (then\n"
    + "      (local.set $err (call $__fern_errno_p2 (i32.load8_u offset=" + off + " (local.get $ra))))\n"
    + "      (call $__fern_raw_free (local.get $ra) (i32.const " + bytes + "))\n"
    + "      (return (local.get $err))))\n";
}

function p2_ok_ret(bytes: string): string {
  return "    (call $__fern_raw_free (local.get $ra) (i32.const " + bytes + "))\n    (i32.const 0))\n";
}

function preopen_func_p2(): string {
  let o = "  (global $__fern_preopen (mut i32) (i32.const -2))\n";
  o += "  (func $__fern_preopen_p2 (result i32)\n";
  o += "    (local $ra i32) (local $dirs i32) (local $count i32) (local $i i32) (local $entry i32)\n";
  o += "    (if (i32.eq (global.get $__fern_preopen) (i32.const -2)) (then\n";
  o += "      (local.set $ra (call $__fern_alloc (i32.const 8)))\n";
  o += "      (call $__fern_get_directories (local.get $ra))\n";
  o += "      (global.set $__fern_preopen (i32.const -1))\n";
  o += "      (local.set $dirs (i32.load (local.get $ra)))\n";
  o += "      (local.set $count (i32.load offset=4 (local.get $ra)))\n";
  o += "      (block $done (loop $next\n";
  o += "        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))\n";
  o += "        (local.set $entry (i32.add (local.get $dirs) (i32.mul (local.get $i) (i32.const 12))))\n";
  o += "        (if (i32.eqz (local.get $i))\n";
  o += "          (then (global.set $__fern_preopen (i32.load (local.get $entry))))\n";
  o += "          (else (call $__fern_desc_drop (i32.load (local.get $entry)))))\n";
  o += "        (if (i32.load offset=8 (local.get $entry)) (then (call $__fern_raw_free (i32.load offset=4 (local.get $entry)) (i32.load offset=8 (local.get $entry)))))\n";
  o += "        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))\n";
  o += "      (if (local.get $count) (then (call $__fern_raw_free (local.get $dirs) (i32.mul (local.get $count) (i32.const 12)))))\n";
  o += "      (call $__fern_raw_free (local.get $ra) (i32.const 8))))\n";
  o += "    (global.get $__fern_preopen))\n";
  return o;
}

function fd_table_funcs(): string {
  let o = "  (global $__fern_fdt (mut i32) (i32.const 0))\n";
  o += "  (global $__fern_fdt_cap (mut i32) (i32.const 0))\n";
  o += "  (func $__fern_fdt_init\n";
  o += "    (if (global.get $__fern_fdt) (then (return)))\n";
  o += "    (global.set $__fern_fdt_cap (i32.const 8))\n";
  o += "    (global.set $__fern_fdt (call $__fern_alloc (i32.const 256)))\n";
  o += "    (memory.fill (global.get $__fern_fdt) (i32.const 0) (i32.const 256))\n";
  o += "    (call $__fern_fdt_set (i32.const 0) (i32.const -1) (i32.const -1) (i32.const 1))\n";
  o += "    (call $__fern_fdt_set (i32.const 1) (i32.const -1) (i32.const -1) (i32.const 2))\n";
  o += "    (call $__fern_fdt_set (i32.const 2) (i32.const -1) (i32.const -1) (i32.const 2)))\n";
  o += "  (func $__fern_fdt_slot (param $fd i32) (result i32)\n";
  o += "    (local $p i32)\n";
  o += "    (call $__fern_fdt_init)\n";
  o += "    (if (i32.ge_u (local.get $fd) (global.get $__fern_fdt_cap)) (then (return (i32.const 0))))\n";
  o += "    (local.set $p (i32.add (global.get $__fern_fdt) (i32.shl (local.get $fd) (i32.const 5))))\n";
  o += "    (if (i32.eqz (i32.load (local.get $p))) (then (return (i32.const 0))))\n";
  o += "    (local.get $p))\n";
  o += "  (func $__fern_fdt_set (param $fd i32) (param $s i32) (param $d i32) (param $bits i32)\n";
  o += "    (local $p i32)\n";
  o += "    (local.set $p (i32.add (global.get $__fern_fdt) (i32.shl (local.get $fd) (i32.const 5))))\n";
  o += "    (i32.store (local.get $p) (i32.const 1))\n";
  o += "    (i32.store offset=4 (local.get $p) (local.get $s))\n";
  o += "    (i32.store offset=8 (local.get $p) (local.get $d))\n";
  o += "    (i32.store offset=12 (local.get $p) (local.get $bits))\n";
  o += "    (i64.store offset=16 (local.get $p) (i64.const 0))\n";
  o += "    (i32.store offset=24 (local.get $p) (i32.const 0)))\n";
  o += "  (func $__fern_fdt_new (result i32)\n";
  o += "    (local $fd i32) (local $old i32) (local $n i32)\n";
  o += "    (call $__fern_fdt_init)\n";
  o += "    (local.set $fd (i32.const 3))\n";
  o += "    (block $found (loop $scan\n";
  o += "      (br_if $found (i32.ge_u (local.get $fd) (global.get $__fern_fdt_cap)))\n";
  o += "      (br_if $found (i32.eqz (i32.load (i32.add (global.get $__fern_fdt) (i32.shl (local.get $fd) (i32.const 5))))))\n";
  o += "      (local.set $fd (i32.add (local.get $fd) (i32.const 1)))\n";
  o += "      (br $scan)))\n";
  o += "    (if (i32.eq (local.get $fd) (global.get $__fern_fdt_cap)) (then\n";
  o += "      (local.set $old (global.get $__fern_fdt))\n";
  o += "      (local.set $n (i32.shl (global.get $__fern_fdt_cap) (i32.const 5)))\n";
  o += "      (global.set $__fern_fdt (call $__fern_alloc (i32.shl (local.get $n) (i32.const 1))))\n";
  o += "      (memory.copy (global.get $__fern_fdt) (local.get $old) (local.get $n))\n";
  o += "      (memory.fill (i32.add (global.get $__fern_fdt) (local.get $n)) (i32.const 0) (local.get $n))\n";
  o += "      (call $__fern_raw_free (local.get $old) (local.get $n))\n";
  o += "      (global.set $__fern_fdt_cap (i32.shl (global.get $__fern_fdt_cap) (i32.const 1)))))\n";
  o += "    (local.get $fd))\n";
  o += "  (func $__fern_fdt_advance (param $slot i32) (param $n i32)\n";
  o += "    (i64.store offset=16 (local.get $slot) (i64.add (i64.load offset=16 (local.get $slot)) (i64.extend_i32_u (local.get $n))))\n";
  o += "    (if (i32.and (i32.ne (local.get $n) (i32.const 0)) (i32.ne (i32.and (i32.load offset=12 (local.get $slot)) (i32.const 4)) (i32.const 0)))\n";
  o += "      (then (i32.store offset=24 (local.get $slot) (i32.const 1)))))\n";
  return o;
}

function path_open_shim(): string {
  let o = "  (func $__fern_path_open (param $dirfd i32) (param $dirflags i32) (param $p i32) (param $l i32) (param $oflags i32) (param $rights i64) (param $inh i64) (param $fdflags i32) (param $out i32) (result i32)\n";
  o += "    (local $pre i32) (local $ra i32) (local $err i32) (local $desc i32) (local $bits i32) (local $fd i32)\n";
  o += p2_preopen("16");
  o += "    (if (i32.wrap_i64 (i64.and (local.get $rights) (i64.const 2))) (then (local.set $bits (i32.const 1))))\n";
  o += "    (if (i32.wrap_i64 (i64.and (local.get $rights) (i64.const 64))) (then (local.set $bits (i32.or (local.get $bits) (i32.const 2)))))\n";
  o += "    (call $__fern_open_at (local.get $pre) (i32.and (local.get $dirflags) (i32.const 1)) (local.get $p) (local.get $l) (i32.and (local.get $oflags) (i32.const 15))";
  o += " (i32.or (local.get $bits) (i32.or (i32.shl (i32.and (local.get $fdflags) (i32.const 2)) (i32.const 2)) (i32.shr_u (i32.and (local.get $fdflags) (i32.const 16)) (i32.const 2))))";
  o += " (local.get $ra))\n";
  o += p2_fail_ret("4", "16");
  o += "    (local.set $desc (i32.load offset=4 (local.get $ra)))\n";
  o += "    (if (i32.and (local.get $fdflags) (i32.const 1)) (then (local.set $bits (i32.or (local.get $bits) (i32.const 4)))))\n";
  o += "    (if (i32.and (local.get $bits) (i32.const 2))\n";
  o += "      (then (if (i32.and (local.get $bits) (i32.const 4))\n";
