pub function crc32_cksum_helper(): string {
  return crc32_cksum_helper_for(false);
}

function crc32_cksum_helper_for(array: boolean): string {
  let o: string = "";
  let name: string = "__fern_crc32_cksum";
  let offset: string = "4";
  if (array) {
    name = "__fern_crc32_cksum_array";
    offset = "8";
  }
  o = o + "  (func $" + name + " (param $crc i32) (param $s i32) (result i32)\n";
  o = o + "    (local $len i32) (local $i i32) (local $k i32) (local $m i32)\n";
  o = o + "    (local.set $len (i32.load (local.get $s)))\n";
  o = o + "    (block $d (loop $c\n";
  o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
  o = o + "      (local.set $crc (i32.xor (local.get $crc) (i32.shl (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const " + offset + ")) (local.get $i))) (i32.const 24))))\n";
  o = o + "      (local.set $k (i32.const 8))\n";
  o = o + "      (block $bd (loop $bc\n";
  o = o + "        (br_if $bd (i32.eqz (local.get $k)))\n";
  o = o + "        (local.set $m (i32.and (i32.shr_s (local.get $crc) (i32.const 31)) (i32.const 0x04c11db7)))\n";
  o = o + "        (local.set $crc (i32.xor (i32.shl (local.get $crc) (i32.const 1)) (local.get $m)))\n";
  o = o + "        (local.set $k (i32.sub (local.get $k) (i32.const 1)))\n";
  o = o + "        (br $bc)))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "      (br $c)))\n";
  o = o + "    (local.get $crc))\n";
  return o;
}

pub function ascii_run_helper(): string {
  let o: string = "";
  o = o + "  (func $__fern_ascii_run (param $s i32) (param $from i32) (result i32)\n";
  o = o + "    (local $len i32) (local $i i32) (local $m i32)\n";
