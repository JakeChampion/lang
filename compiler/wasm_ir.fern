  o = o + "              (i32.store16 (i32.add (i32.add (local.get $dg) (i32.const 24)) (i32.mul (local.get $k) (i32.const 2)))\n";
  o = o + "                (i32.load (i32.add (i32.add (local.get $flat) (i32.const 12)) (i32.mul (local.get $k) (i32.const 4)))))\n";
  o = o + "              (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $sl)))\n";
  o = o + "            (i32.store offset=40 (local.get $dg) (i32.const 0)))\n";
  o = o + "          (else\n";
