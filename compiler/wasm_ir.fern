function truncate_body(mode: i32): string {
  if (mode == 2) {
    return truncate_func_p2();
  }
  return truncate_func();
}

function read_dir_body(fname: string, mode: i32): string {
  if (fname == "__fern_read_dir_ino" || fname == "__fern_read_dir_ino_all") {
    if (mode == 2) {
      return read_dir_ino_func_p2(fname);
    }
    return read_dir_func_like(fname, fname == "__fern_read_dir_ino", true, false);
  }
  if (mode == 2) {
    return read_dir_func_p2(fname);
  }
  if (fname == "__fern_read_dir_all") {
    return read_dir_all_func();
  }
  return read_dir_func();
}

