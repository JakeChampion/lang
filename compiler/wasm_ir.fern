pub function udp_bind_func(): string {
  let o: string = "";
  let fail_head: string = "    (if (i32.load8_u (local.get $ret)) (then\n      (call $__fern_wasi_udp_socket_drop (local.get $sock))\n      ";
  let fail_tail: string = "\n      (call $__fern_raw_free (local.get $ret) (i32.const 16))\n      (return (local.get $e))))\n";
  o = o + "  (func $__fern_udp_bind (param $addr i32) (param $port i32) (result i32)\n";
  o = o + "    (local $ret i32) (local $sock i32) (local $e i32) (local $flat i32) (local $tmp i32)\n";
  o = o + ip_flat_prologue();
  o = o + "    (local.set $ret (call $__fern_alloc (i32.const 16)))\n";
  o = o + "    (call $__fern_wasi_create_udp_socket (i32.load (local.get $flat)) (local.get $ret))\n";
  o = o + "    (if (i32.load8_u (local.get $ret)) (then\n      " + udp_errno("$e", 4) + fail_tail;
  o = o + "    (local.set $sock (i32.load offset=4 (local.get $ret)))\n";
  o = o + "    (call $__fern_wasi_udp_start_bind (local.get $sock) (call $__fern_network_handle)\n";
  o = o + ip_flat_words() + "      (local.get $ret))\n";
  o = o + fail_head + udp_errno("$e", 1) + fail_tail;
  o = o + "    (call $__fern_wasi_udp_finish_bind (local.get $sock) (local.get $ret))\n";
  o = o + fail_head + udp_errno("$e", 1) + fail_tail;
  o = o + "    (call $__fern_wasi_udp_stream (local.get $sock)\n";
  o = o + "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n";
  o = o + "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n";
  o = o + "      (local.get $ret))\n";
  o = o + fail_head + udp_errno("$e", 4) + fail_tail;
  o = o + "    (i32.store (local.get $ret) (local.get $sock))\n";
  o = o + "    (i32.store offset=12 (local.get $ret) (i32.const 3))\n";
  o = o + "    (local.get $ret))\n";
  return o;
}

