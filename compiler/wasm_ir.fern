  o = o + "        (v128.store (local.get $p) (f64x2.mul (local.get $vv) (v128.load (i32.add (i32.add (local.get $b) (i32.const 8)) (i32.mul (local.get $j) (i32.const 8))))))\n";
  o = o + "        (local.set $p (i32.add (local.get $p) (i32.const 16)))\n        (local.set $j (i32.add (local.get $j) (i32.const 2)))\n        (br $pair)))\n";
  o = o + "      (if (i32.lt_u (local.get $j) (local.get $m)) (then\n";
  o = o + "        (f64.store (local.get $p) (f64.mul (local.get $left) (f64.load offset=8 (i32.add (local.get $b) (i32.mul (local.get $j) (i32.const 8))))))\n";
  o = o + "        (local.set $p (i32.add (local.get $p) (i32.const 8)))))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n      (br $row)))\n    (local.get $o))\n";
  return o;
