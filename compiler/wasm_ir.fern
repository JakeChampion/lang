  o += "    (local $sl i32) (local $sepl i32) (local $i i32) (local $start i32) (local $arr i32) (local $piece i32) (local $j i32) (local $match i32)\n";
  o += "    (local.set $sl (i32.load (local.get $s)))\n";
  o += "    (local.set $sepl (i32.load (local.get $sep)))\n";
