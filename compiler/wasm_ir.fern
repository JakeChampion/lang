  o = o + "    (i32.store (i32.add (local.get $opt) (i32.const 4)) (i32.const 0))\n";
  o = o + "    (local.get $opt))\n";
  return o;
}

pub function reader_read_chunk_bytes_func(): string {
  let o: string = "  (func $__fern_reader_read_chunk_bytes (param $fd i32) (param $n i32) (result i32)\n";
  o = o + "    (local $a i32) (local $source i32) (local $got i32) (local $box i32) (local $err i32) (local $path i32)\n";
  o = o + "    (if (i32.lt_s (local.get $n) (i32.const 0)) (then (local.set $err (i32.const 28))) (else\n";
  o = o + "      (local.set $a (call $__fern_arr_elems (local.get $n) (i32.const 1)))\n";
  o = o + "      (i32.store (local.get $a) (i32.const 0)) (i32.store offset=4 (local.get $a) (local.get $n))\n";
  o = o + "      (i32.store (i32.const 0) (i32.add (local.get $a) (i32.const 8)))\n";
  o = o + "      (i32.store (i32.const 4) (local.get $n))\n";
  o = o + "      (local.set $err (call $__fern_fd_read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
  o = o + "      (local.set $got (i32.load (i32.const 8)))))\n";
  o = o + "    (if (local.get $err) (then\n";
  o = o + "      (if (local.get $a) (then (drop (call $__fern_arr_dec (local.get $a)))))\n";
  o = o + "      (local.set $path (call $__fern_str_box (i32.const 4))) (i32.store (local.get $path) (i32.const 0))\n";
  o = o + "      (local.set $box (call $__fern_str_box (i32.const 8))) (i32.store (local.get $box) (i32.const 1))\n";
  o = o + "      (i32.store offset=4 (local.get $box) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
  o = o + "      (return (local.get $box))))\n";
  o = o + "    (if (i32.lt_u (local.get $got) (local.get $n)) (then\n";
  o = o + "      (local.set $source (local.get $a))\n";
  o = o + "      (local.set $a (call $__fern_arr_elems (local.get $got) (i32.const 1)))\n";
  o = o + "      (i32.store offset=4 (local.get $a) (local.get $got))\n";
  o = o + "      (memory.copy (i32.add (local.get $a) (i32.const 8)) (i32.add (local.get $source) (i32.const 8)) (local.get $got))\n";
  o = o + "      (drop (call $__fern_arr_dec (local.get $source)))))\n";
  o = o + "    (i32.store (local.get $a) (local.get $got))\n";
  o = o + "    (local.set $box (call $__fern_str_box (i32.const 8))) (i32.store (local.get $box) (i32.const 0))\n";
  o = o + "    (i32.store offset=4 (local.get $box) (local.get $a))\n";
  return o + "    (local.get $box))\n";
}

pub function reader_read_chunk_func(): string {
  let o: string = "";
  o = o + "  (func $__fern_reader_read_chunk (param $fd i32) (param $n i32) (result i32)\n";
  o = o + "    (local $blk i32) (local $source i32) (local $nread i32) (local $opt i32) (local $err i32) (local $path i32)\n";
  o = o + "    (if (i32.lt_s (local.get $n) (i32.const 0)) (then (local.set $err (i32.const 28))) (else\n";
  o = o + "      (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $n))))\n";
  o = o + "      (i32.store (i32.const 0) (i32.add (local.get $blk) (i32.const 4)))\n";
  o = o + "      (i32.store (i32.const 4) (local.get $n))\n";
  o = o + "      (local.set $err (call $__fern_fd_read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
  o = o + "      (if (i32.eqz (local.get $err)) (then\n";
  o = o + "        (local.set $nread (i32.load (i32.const 8)))\n";
  o = o + "        (if (i32.eqz (call $__fern_utf8_valid (i32.add (local.get $blk) (i32.const 4)) (local.get $nread)))\n";
  o = o + "          (then (local.set $err (i32.const 25))))))))\n";
  o = o + "    (if (local.get $err) (then\n";
  o = o + "      (if (local.get $blk) (then (drop (call $__fern_arr_dec (local.get $blk)))))\n";
  o = o + "      (local.set $path (call $__fern_str_box (i32.const 4)))\n";
  o = o + "      (i32.store (local.get $path) (i32.const 0))\n";
  o = o + "      (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
  o = o + "      (i32.store (local.get $opt) (i32.const 1))\n";
  o = o + "      (i32.store offset=4 (local.get $opt) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
  o = o + "      (return (local.get $opt))))\n";
  o = o + "    (if (i32.lt_u (local.get $nread) (local.get $n)) (then\n";
  o = o + "      (local.set $source (local.get $blk))\n";
  o = o + "      (local.set $blk (call $__fern_str_box (i32.add (local.get $nread) (i32.const 4))))\n";
  o = o + "      (memory.copy (i32.add (local.get $blk) (i32.const 4)) (i32.add (local.get $source) (i32.const 4)) (local.get $nread))\n";
  o = o + "      (drop (call $__fern_arr_dec (local.get $source)))))\n";
  o = o + "    (i32.store (local.get $blk) (local.get $nread))\n";
  o = o + "    (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
  o = o + "    (i32.store (local.get $opt) (i32.const 0))\n";
  o = o + "    (i32.store offset=4 (local.get $opt) (local.get $blk))\n";
  o = o + "    (local.get $opt))\n";
  return o;
}

pub function reader_close_func(dir_off: boolean): string {
  let o: string = "";
  o = o + "  (func $__fern_reader_close (param $fd i32) (result i32)\n";
  o = o + "    (local $opt i32) (local $err i32) (local $path i32)\n";
  if (dir_off) {
    o = o + "    (call $__fern_dir_off_forget (local.get $fd))\n";
  }
  o = o + "    (local.set $err (call $__fern_fd_close (local.get $fd)))\n";
  o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
  o = o + "      (local.set $path (call $__fern_str_box (i32.const 4)))\n";
  o = o + "      (i32.store (local.get $path) (i32.const 0))\n";
  o = o + "      (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
  o = o + "      (i32.store (local.get $opt) (i32.const 1))\n";
  o = o + "      (i32.store (i32.add (local.get $opt) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
  o = o + "      (return (local.get $opt))))\n";
  o = o + "    (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
  o = o + "    (i32.store (local.get $opt) (i32.const 0))\n";
  o = o + "    (i32.store (i32.add (local.get $opt) (i32.const 4)) (i32.const 0))\n";
  o = o + "    (local.get $opt))\n";
  return o;
}

pub function cabi_realloc_helper(): string {
  let o: string = "";
  o = o + "  (global $__fern_lend (mut i32) (i32.const 0))\n";
  o = o + "  (global $__fern_lend_cap (mut i32) (i32.const 0))\n";
  o = o + "  (func $__fern_cabi_realloc (param $op i32) (param $os i32) (param $al i32) (param $ns i32) (result i32)\n";
  o = o + "    (if (i32.and (i32.and (i32.eqz (local.get $op)) (i32.ne (global.get $__fern_lend) (i32.const 0))) (i32.and (i32.ne (local.get $ns) (i32.const 0)) (i32.le_u (local.get $ns) (global.get $__fern_lend_cap)))) (then\n";
  o = o + "      (local.set $op (global.get $__fern_lend))\n";
  o = o + "      (global.set $__fern_lend (i32.const 0))\n";
  o = o + "      (return (local.get $op))))\n";
  o = o + "    (global.set $heap (i32.and (i32.add (global.get $heap) (i32.sub (local.get $al) (i32.const 1))) (i32.sub (i32.const 0) (local.get $al))))\n";
  o = o + "    (if (i32.eqz (local.get $ns)) (then (return (global.get $heap))))\n";
  o = o + "    (call $__fern_alloc (local.get $ns)))\n";
  o = o + "  (export \"cabi_realloc\" (func $__fern_cabi_realloc))\n";
  return o;
}

pub function divrem64_helpers(): string {
  let bad: string = "(i32.or (i64.eqz (local.get $b))"
    + " (i32.and (i64.eq (local.get $a) (i64.const -9223372036854775808))"
    + " (i64.eq (local.get $b) (i64.const -1))))";
  let parts: string[] = [];
  parts = parts.append("  (func $__fern_idiv64 (param $a i64) (param $b i64) (result i64)\n");
  parts = parts.append("    (local $safe i64)\n");
  parts = parts.append("    (local.set $safe (select (i64.const 1) (local.get $b) " + bad + "))\n");
  parts = parts.append("    (select (i64.const 0) (i64.div_s (local.get $a) (local.get $safe)) (i64.eqz (local.get $b))))\n");
  parts = parts.append("  (func $__fern_irem64 (param $a i64) (param $b i64) (result i64)\n");
  parts = parts.append("    (local $safe i64)\n");
  parts = parts.append("    (local.set $safe (select (i64.const 1) (local.get $b) " + bad + "))\n");
  parts = parts.append("    (select (local.get $a) (i64.rem_s (local.get $a) (local.get $safe)) (i64.eqz (local.get $b))))\n");
  return util.str_join_chunks(parts);
}

pub function udivrem_helpers(t: string, suffix: string): string {
  let safe: string = "    (local.set $safe (select (" + t + ".const 1) (local.get $b) (" + t + ".eqz (local.get $b))))\n";
  let parts: string[] = [];
  parts = parts.append("  (func $__fern_udiv" + suffix + " (param $a " + t + ") (param $b " + t + ") (result " + t + ")\n");
  parts = parts.append("    (local $safe " + t + ")\n" + safe);
  parts = parts.append("    (select (" + t + ".const 0) (" + t + ".div_u (local.get $a) (local.get $safe)) (" + t + ".eqz (local.get $b))))\n");
  parts = parts.append("  (func $__fern_urem" + suffix + " (param $a " + t + ") (param $b " + t + ") (result " + t + ")\n");
  parts = parts.append("    (local $safe " + t + ")\n" + safe);
  parts = parts.append("    (select (local.get $a) (" + t + ".rem_u (local.get $a) (local.get $safe)) (" + t + ".eqz (local.get $b))))\n");
  return util.str_join_chunks(parts);
}

pub function lc_globals(lc: boolean): string {
  if (!lc) {
    return "";
  }
  let o: string = "  (global $__fern_lc_alloc_count (mut i64) (i64.const 0))\n";
  o = o + "  (global $__fern_lc_alloc_bytes (mut i64) (i64.const 0))\n";
  o = o + "  (global $__fern_lc_free_count (mut i64) (i64.const 0))\n";
  o = o + "  (global $__fern_lc_free_bytes (mut i64) (i64.const 0))\n";
  o = o + "  (global $__fern_lc_exited (mut i32) (i32.const 0))\n";
  return o;
}

function lc_bump_alloc(nexpr: string, lc: boolean): string {
  if (!lc) {
    return "";
  }
  let o: string = "    (global.set $__fern_lc_alloc_count (i64.add (global.get $__fern_lc_alloc_count) (i64.const 1)))\n";
  o = o + "    (global.set $__fern_lc_alloc_bytes (i64.add (global.get $__fern_lc_alloc_bytes) (i64.extend_i32_u " + nexpr + ")))\n";
  return o;
}

function lc_bump_free(nexpr: string, lc: boolean): string {
  if (!lc) {
    return "";
  }
  let o: string = "    (global.set $__fern_lc_free_count (i64.add (global.get $__fern_lc_free_count) (i64.const 1)))\n";
  o = o + "    (global.set $__fern_lc_free_bytes (i64.add (global.get $__fern_lc_free_bytes) (i64.extend_i32_u " + nexpr + ")))\n";
  return o;
}

function lc_label(text: string): string {
  let o: string = "";
  let i: i32 = 0;
  while (i < text.len()) {
    let left: i32 = text.len() - i;
    let width: i32 = 1;
    if (left >= 4) {
      width = 4;
    } else if (left >= 2) {
      width = 2;
    }
    let word: i32 = 0;
    let k: i32 = width - 1;
    while (k >= 0) {
      word = word * 256 + text[i + k] as i32;
      k = k - 1;
    }
    let op: string = "i32.store8";
    if (width == 4) {
      op = "i32.store";
    } else if (width == 2) {
      op = "i32.store16";
    }
    let at: string = "(local.get $b)";
    if (i > 0) {
      at = "(i32.add (local.get $b) (i32.const " + util.i32_to_string(i) + "))";
    }
    o = o + "    (" + op + " " + at + " (i32.const " + util.i32_to_string(word) + "))\n";
    i = i + width;
  }
  return o + "    (call $__fern_lc_wr (local.get $b) (i32.const " + util.i32_to_string(text.len()) + "))\n";
}

pub function lc_report_and_exit_wrapper(lc: boolean, sanitize: boolean, set_args: boolean, dir_off: boolean): string {
  if (!lc) {
    return "";
  }
  let tables: string = "";
  if (dir_off) {
    tables = dir_off_release();
  }
  return lc_report_funcs(sanitize, set_args, tables) + "  (func $__fern_proc_exit (param $c i32)\n    (global.set $__fern_lc_exited (i32.const 1))\n    (call $__fern_lc_report)\n    (call $__fern_proc_exit_raw (local.get $c)))\n";
}

function fdt_release(): string {
  let o: string = "    (if (global.get $__fern_fdt) (then\n";
  o = o + "      (call $__fern_raw_free (global.get $__fern_fdt) (i32.shl (global.get $__fern_fdt_cap) (i32.const 5)))\n";
  return o + "      (global.set $__fern_fdt (i32.const 0))))\n";
}

function dir_off_release(): string {
  let o: string = "    (if (global.get $__fern_dir_off) (then\n";
  o = o + "      (call $__fern_raw_free (global.get $__fern_dir_off) (i32.shl (global.get $__fern_dir_off_cap) (i32.const 3)))\n";
  return o + "      (global.set $__fern_dir_off (i32.const 0))))\n";
}

function lc_exit_report(lc: boolean): string {
  if (!lc) {
    return "";
  }
  return "    (global.set $__fern_lc_exited (i32.const 1))\n    (call $__fern_lc_report)\n";
}

function main_result_wat(mod: parser.Module): string {
  for fd in mod.funcs {
    if (fd.name == "main" && fd.receiver_type.len() == 0 && (fd.ret_type == "i64" || fd.ret_type == "u64")) {
      return "(i32.wrap_i64 (call $main))";
    }
  }
  return "(call $main)";
}

function low_byte_wat(result: string): string {
  return "(i32.and " + result + " (i32.const 255))";
}

function component_run_entry(report: boolean, sanitize: boolean, set_args: boolean, fdt: boolean, call_main: string): string {
  if (!report) {
    return "  (func $__fern_lang_run (result i32) (i32.eqz (i32.eqz " + call_main + ")))\n";
  }
  let tables: string = "";
  if (fdt) {
    tables = fdt_release();
  }
  return lc_report_funcs(sanitize, set_args, tables) + "  (func $__fern_lang_run (result i32) (local $r i32)\n    (local.set $r " + call_main + ")\n    (call $__fern_lc_report)\n    (i32.eqz (i32.eqz (local.get $r))))\n";
}

function lc_report_funcs(sanitize: boolean, set_args: boolean, tables: string): string {
  let o: string = "";
  o = o + "  (func $__fern_lc_wr (param $p i32) (param $len i32)\n";
  o = o + "    (i32.store (i32.const 0) (local.get $p))\n";
  o = o + "    (i32.store (i32.const 4) (local.get $len))\n";
  o = o + "    (drop (call $__fern_fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 16))))\n";
  o = o + "  (func $__fern_lc_wrnum (param $n i64) (param $buf i32)\n";
  o = o + "    (local $i i32) (local $neg i32)\n";
  o = o + "    (if (i64.eqz (local.get $n)) (then\n";
  o = o + "      (i32.store8 (local.get $buf) (i32.const 48))\n";
  o = o + "      (call $__fern_lc_wr (local.get $buf) (i32.const 1))\n";
  o = o + "      (return)))\n";
  o = o + "    (local.set $neg (i64.lt_s (local.get $n) (i64.const 0)))\n";
  o = o + "    (if (local.get $neg) (then (local.set $n (i64.sub (i64.const 0) (local.get $n)))))\n";
  o = o + "    (local.set $i (i32.add (local.get $buf) (i32.const 24)))\n";
  o = o + "    (block $d (loop $l\n";
  o = o + "      (br_if $d (i64.eqz (local.get $n)))\n";
  o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
  o = o + "      (i32.store8 (local.get $i) (i32.wrap_i64 (i64.add (i64.const 48) (i64.rem_u (local.get $n) (i64.const 10)))))\n";
  o = o + "      (local.set $n (i64.div_u (local.get $n) (i64.const 10)))\n";
  o = o + "      (br $l)))\n";
  o = o + "    (if (local.get $neg) (then\n";
  o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
  o = o + "      (i32.store8 (local.get $i) (i32.const 45))))\n";
  o = o + "    (call $__fern_lc_wr (local.get $i) (i32.sub (i32.add (local.get $buf) (i32.const 24)) (local.get $i))))\n";
  o = o + "  (func $__fern_lc_report\n";
  o = o + "    (local $b i32) (local $na i64) (local $nf i64) (local $live i64)\n";
  if (set_args) {
    o = o + "    (if (global.get $__fern_args_set) (then\n";
    o = o + "      (drop (call $__fern_arr_dec_ptr (global.get $__fern_args_set)))\n";
    o = o + "      (global.set $__fern_args_set (i32.const 0))))\n";
  }
  o = o + tables;
  o = o + "    (local.set $na (global.get $__fern_lc_alloc_count))\n";
  o = o + "    (local.set $nf (global.get $__fern_lc_free_count))\n";
  o = o + "    (local.set $live (i64.sub (global.get $__fern_lc_alloc_bytes) (global.get $__fern_lc_free_bytes)))\n";
  o = o + "    (local.set $b (i32.const 40))\n";
  o = o + lc_label("leakcheck: allocs=");
  o = o + "    (call $__fern_lc_wrnum (local.get $na) (local.get $b))\n";
  o = o + lc_label(" frees=");
  o = o + "    (call $__fern_lc_wrnum (local.get $nf) (local.get $b))\n";
  o = o + lc_label(" live_bytes=");
  o = o + "    (call $__fern_lc_wrnum (local.get $live) (local.get $b))\n";
  o = o + "    (if (global.get $__fern_lc_exited) (then\n";
  o = o + lc_label(" from=exit");
  o = o + "    ))\n";
  o = o + lc_label("\n");
  if (sanitize) {
    o = o + "    (if (i64.gt_s (local.get $live) (i64.const 0)) (then\n";
    o = o + lc_label("fern-sanitizer: leak ");
    o = o + "    (call $__fern_lc_wrnum (local.get $live) (local.get $b))\n";
    o = o + lc_label(" bytes in ");
    o = o + "    (call $__fern_lc_wrnum (i64.sub (local.get $na) (local.get $nf)) (local.get $b))\n";
    o = o + lc_label(" blocks\n");
    o = o + "    ))\n";
  }
  o = o + "  )\n";
  return o;
}

pub function heap_alloc_helpers(heap_base: i32, fl_base: i32, fl_cells: i32, lfl_base: i32, count: boolean, lc: boolean): string {
  let hb: string = util.i32_to_string(heap_base);
  let flb: string = util.i32_to_string(fl_base);
  let flc: string = util.i32_to_string(fl_cells);
  let lflb: string = util.i32_to_string(lfl_base);
  let o: string = "";
  o = o + "  (global $__fern_rc_underflow (mut i32) (i32.const 0))\n";
  o = o + "  (global $__fern_heap_base i32 (i32.const " + hb + "))\n";
  o = o + "  (global $heap (mut i32) (i32.const " + hb + "))\n";
  if (count) {
    o = o + "  (global $__fern_alloc_count (mut i64) (i64.const 0))\n";
  }
  o = o + "  (func $__fern_capw (param $w i32) (result i32)\n";
  o = o + "    (local $g i32)\n";
  o = o + "    (if (i32.le_u (local.get $w) (i32.const 256)) (then (return (local.get $w))))\n";
  o = o + "    (if (i32.ge_u (local.get $w) (i32.const " + flc + ")) (then (return (local.get $w))))\n";
  o = o + "    (local.set $g (i32.shl (i32.const 1) (i32.sub (i32.const 29) (i32.clz (local.get $w)))))\n";
