  o = o + "    (i32.store offset=4 (local.get $dg) (i32.load (local.get $data)))\n";
  o = o + "    (if (i32.load (local.get $addr))\n";
  o = o + "      (then\n";
  o = o + "        (i32.store offset=8 (local.get $dg) (i32.const 1))\n";
