  o += reactor_slot("(local.get $timer)", "(i32.const 0)", "(i32.const 0)");
  o += "    ))\n";
  o = o + "    (local.set $ret (i32.const " + util.i32_to_string(io_ret_addr()) + "))\n";
  o += "    (global.set $__fern_lend (i32.load offset=24 (local.get $r)))\n";
  o += "    (global.set $__fern_lend_cap (i32.mul (local.get $count) (i32.const 4)))\n";
  o += "    (call $__fern_wasi_poll (local.get $list) (local.get $count) (local.get $ret))\n";
  o += "    (global.set $__fern_lend (i32.const 0))\n";
