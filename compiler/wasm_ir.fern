    o += "    (if (i32.load (local.get $h)) (then (drop (call $__fern_arr_dec (i32.load (local.get $h))))))\n";
    o += "    (drop (call $__fern_arr_dec (local.get $h))))\n";
  }
  return o;
}

pub function divrem_helpers(): string {
  let bad: string = "(i32.or (i32.eqz (local.get $b))"
    + " (i32.and (i32.eq (local.get $a) (i32.const -2147483648))"
    + " (i32.eq (local.get $b) (i32.const -1))))";
  let parts: string[] = [];
  parts = parts.append("  (func $__fern_idiv (param $a i32) (param $b i32) (result i32)\n");
  parts = parts.append("    (local $safe i32)\n");
  parts = parts.append("    (local.set $safe (select (i32.const 1) (local.get $b) " + bad + "))\n");
  parts = parts.append("    (select (i32.const 0) (i32.div_s (local.get $a) (local.get $safe)) (i32.eqz (local.get $b))))\n");
  parts = parts.append("  (func $__fern_irem (param $a i32) (param $b i32) (result i32)\n");
  parts = parts.append("    (local $safe i32)\n");
  parts = parts.append("    (local.set $safe (select (i32.const 1) (local.get $b) " + bad + "))\n");
  parts = parts.append("    (select (local.get $a) (i32.rem_s (local.get $a) (local.get $safe)) (i32.eqz (local.get $b))))\n");
  return util.str_join_chunks(parts);
}

pub function i32_to_string_helper(): string {
  let o = "";
  o += "  (func $__fern_i32_to_str (param $n i32) (result i32)\n";
  o += "    (local $neg i32) (local $mag i32) (local $len i32) (local $blk i32) (local $p i32)\n";
  o += "    (if (i32.eqz (local.get $n)) (then\n";
  o += "      (local.set $blk (call $__fern_str_box (i32.const 5)))\n";
  o += "      (i32.store (local.get $blk) (i32.const 1))\n";
  o += "      (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (i32.const 48))\n";
  o += "      (return (local.get $blk))))\n";
  o += "    (local.set $neg (i32.lt_s (local.get $n) (i32.const 0)))\n";
  o += "    (local.set $mag (local.get $n))\n";
  o += "    (if (local.get $neg) (then (local.set $mag (i32.sub (i32.const 0) (local.get $n)))))\n";
  o += "    (local.set $len (i32.const 0))\n";
  o += "    (local.set $p (local.get $mag))\n";
  o += "    (block $cd (loop $cl\n";
  o += "      (br_if $cd (i32.eqz (local.get $p)))\n";
  o += "      (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
  o += "      (local.set $p (i32.div_u (local.get $p) (i32.const 10)))\n";
  o += "      (br $cl)))\n";
  o += "    (if (local.get $neg) (then (local.set $len (i32.add (local.get $len) (i32.const 1)))))\n";
  o += "    (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
  o += "    (i32.store (local.get $blk) (local.get $len))\n";
  o += "    (local.set $p (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $len)))\n";
  o += "    (block $fd (loop $fl\n";
  o += "      (br_if $fd (i32.eqz (local.get $mag)))\n";
  o += "      (local.set $p (i32.sub (local.get $p) (i32.const 1)))\n";
  o += "      (i32.store8 (local.get $p) (i32.add (i32.const 48) (i32.rem_u (local.get $mag) (i32.const 10))))\n";
  o += "      (local.set $mag (i32.div_u (local.get $mag) (i32.const 10)))\n";
  o += "      (br $fl)))\n";
  o += "    (if (local.get $neg) (then (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (i32.const 45))))\n";
  o += "    (local.get $blk))\n";
  return o;
}

