  o = o + "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get $path))))\n";
  o = o + "      (return (local.get $res))))\n";
  o = o + "    (local.set $fd (i32.load (i32.const 16)))\n";
  o = o + "    (local.set $arr (call $__fern_arr_box (i32.const 0)))\n";
  o = o + "    (i32.store (local.get $arr) (i32.const 0))\n";
  o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (i32.const 0))\n";
  o = o + "    (local.set $buf (call $__fern_alloc (i32.const 4096)))\n";
  o = o + "    (local.set $cookie (i64.const 0))\n";
  o = o + "    (block $rdone (loop $rloop\n";
  o = o + "      (local.set $err (call $__fern_fd_readdir (local.get $fd) (local.get $buf) (i32.const 4096) (local.get $cookie) (i32.const 8)))\n";
  o = o + "      (if (local.get $err) (then\n";
  o = o + "        (drop (call $__fern_fd_close (local.get $fd)))\n";
  o = o + "        (call $__fern_raw_free (local.get $buf) (i32.const 4096))\n";
  if (ino) {
    o = o + "        (local.set $i (i32.const 0))\n";
    o = o + "        (block $nd (loop $nl\n";
    o = o + "          (br_if $nd (i32.ge_u (local.get $i) (i32.load (local.get $arr))))\n";
    o = o + "          (drop (call $__fern_arr_dec (i32.load offset=8 (i32.load (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))))\n";
    o = o + "          (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "          (br $nl)))\n";
  }
  o = o + "        (drop (call $__fern_arr_dec_ptr (local.get $arr)))\n";
  o = o + "        (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o = o + "        (i32.store (local.get $res) (i32.const 1))\n";
