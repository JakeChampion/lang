  o += "        (local.set $w (i32.add (local.get $w) (local.get $sl)))))\n";
  o += "      (local.set $elem (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
  o += "      (local.set $el (i32.load (local.get $elem)))\n";
  o += "      (local.set $j (i32.const 0))\n";
  o += "      (block $de (loop $ce\n";
  o += "        (br_if $de (i32.ge_s (local.get $j) (local.get $el)))\n";
  o += "        (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (local.get $w) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $elem) (i32.const 4)) (local.get $j))))\n";
  o += "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
