  o = o + "    (if (i32.lt_s (local.get $bo) (i32.const 0)) (then (local.set $bo (i32.const 0))))\n";
  o = o + "    (if (i32.gt_s (local.get $bo) (local.get $nb)) (then (local.set $bo (local.get $nb))))\n";
  o = o + "    (if (i32.gt_s (local.get $n) (i32.sub (local.get $na) (local.get $ao))) (then (local.set $n (i32.sub (local.get $na) (local.get $ao)))))\n";
  o = o + "    (if (i32.gt_s (local.get $n) (i32.sub (local.get $nb) (local.get $bo))) (then (local.set $n (i32.sub (local.get $nb) (local.get $bo)))))\n";
  o = o + "    (if (i32.lt_s (local.get $n) (i32.const 0)) (then (local.set $n (i32.const 0))))\n";
  o = o + "    (local.set $pa (i32.add (i32.add (local.get $a) (i32.const " + util.i32_to_string(a_data) + ")) (local.get $ao)))\n";
  o = o + "    (local.set $pb (i32.add (i32.add (local.get $b) (i32.const " + util.i32_to_string(b_data) + ")) (local.get $bo)))\n";
  o = o + "    (block $vd (loop $vc\n";
  o = o + "      (br_if $vd (i32.lt_s (i32.sub (local.get $n) (local.get $i)) (i32.const 16)))\n";
  o = o + "      (local.set $m (i8x16.bitmask (i8x16.eq (v128.load (i32.add (local.get $pa) (local.get $i))) (v128.load (i32.add (local.get $pb) (local.get $i))))))\n";
  o = o + "      (if (i32.ne (local.get $m) (i32.const 65535)) (then (return (i32.add (local.get $i) (i32.ctz (i32.xor (local.get $m) (i32.const 65535)))))))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 16)))\n";
  o = o + "      (br $vc)))\n";
  o = o + "    (block $d (loop $c\n";
  o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
  o = o + "      (if (i32.ne (i32.load8_u (i32.add (local.get $pa) (local.get $i))) (i32.load8_u (i32.add (local.get $pb) (local.get $i)))) (then (return (local.get $i))))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
