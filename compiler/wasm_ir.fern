pub function crc32_cksum_helper(): string {
  return crc32_cksum_helper_for(false);
}

function crc32_cksum_helper_for(array: boolean): string {
  let o = "";
  let name = "__fern_crc32_cksum";
  let decode = view_string_decode("$s", "$p", "$len");
  if (array) {
    name = "__fern_crc32_cksum_array";
    decode = "    (local.set $len (i32.load (local.get $s)))\n    (local.set $p (i32.add (local.get $s) (i32.const 8)))\n";
  }
  o = o + "  (func $" + name + " (param $crc i32) (param $s i32) (result i32)\n";
  o += "    (local $len i32) (local $p i32) (local $i i32) (local $k i32) (local $m i32)\n";
  o += decode;
  o += "    (block $d (loop $c\n";
  o += "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
  o += "      (local.set $crc (i32.xor (local.get $crc) (i32.shl (i32.load8_u (i32.add (local.get $p) (local.get $i))) (i32.const 24))))\n";
  o += "      (local.set $k (i32.const 8))\n";
  o += "      (block $bd (loop $bc\n";
  o += "        (br_if $bd (i32.eqz (local.get $k)))\n";
  o += "        (local.set $m (i32.and (i32.shr_s (local.get $crc) (i32.const 31)) (i32.const 0x04c11db7)))\n";
  o += "        (local.set $crc (i32.xor (i32.shl (local.get $crc) (i32.const 1)) (local.get $m)))\n";
  o += "        (local.set $k (i32.sub (local.get $k) (i32.const 1)))\n";
  o += "        (br $bc)))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $c)))\n";
  o += "    (local.get $crc))\n";
  return o;
}

// The slice-by-8 tables of the reflected IEEE CRC-32, as little-endian words.
function crc32_ieee_table_bytes(): string {
  let t: u32[] = [];
  let i: u32 = 0;
  while (i < 256) {
    let c = i;
    for k in 0..8 {
      if ((c & 1) != 0) {
        c = c >> 1 ^ 0xedb88320;
      } else {
        c = c >> 1;
      }
    }
    t = t.append(c);
    i += 1;
  }
  for j in 0..1792 {
    t = t.append(t[j] >> 8 ^ t[(t[j] & 255) as i32]);
  }
  let out: u8[] = [];
  for w in t {
    out = out.append((w & 255) as u8).append((w >> 8 & 255) as u8).append((w >> 16 & 255) as u8).append((w >> 24) as u8);
  }
  unsafe {
    return string_from_bytes_unchecked(out);
  }
}

function crc32_ieee_lookup(table: i32, k: i32, word: string, shift: i32): string {
  let idx = "(i32.and (i32.shr_u (local.get $" + word + ") (i32.const " + util.i32_to_string(shift) + ")) (i32.const 255))";
  if (shift == 24) {
    idx = "(i32.shr_u (local.get $" + word + ") (i32.const 24))";
  }
  return "(i32.load offset=" + util.i32_to_string(table + k * 1024) + " (i32.shl " + idx + " (i32.const 2)))";
}

// The helpers update the raw register. The parameter table is the address of the crc32_ieee_table_bytes data.
function crc32_ieee_helpers(table: i32): string {
  let o = "  (func $__fern_crc32_ieee (param $crc i32) (param $s i32) (result i32)\n";
  o += "    (local $p i32) (local $len i32)\n";
  o += view_string_decode("$s", "$p", "$len");
  o += "    (call $__fern_crc32_ieee_at (local.get $crc) (local.get $p) (local.get $len)))\n";
  o += "  (func $__fern_crc32_ieee_array (param $crc i32) (param $s i32) (result i32)\n";
  o += "    (call $__fern_crc32_ieee_at (local.get $crc) (i32.add (local.get $s) (i32.const 8)) (i32.load (local.get $s))))\n";
  o += "  (func $__fern_crc32_ieee_at (param $crc i32) (param $p i32) (param $n i32) (result i32)\n";
  o += "    (local $end i32) (local $a i32) (local $b i32)\n";
  o += "    (local.set $end (i32.add (local.get $p) (local.get $n)))\n";
  o += "    (block $d8 (loop $c8\n";
  o += "      (br_if $d8 (i32.lt_u (i32.sub (local.get $end) (local.get $p)) (i32.const 8)))\n";
  o += "      (local.set $a (i32.xor (local.get $crc) (i32.load (local.get $p))))\n";
  o += "      (local.set $b (i32.load offset=4 (local.get $p)))\n";
  o = o + "      (local.set $crc (i32.xor (i32.xor (i32.xor " + crc32_ieee_lookup(table, 7, "a", 0) + " " + crc32_ieee_lookup(table, 6, "a", 8) + ")\n";
  o = o + "        (i32.xor " + crc32_ieee_lookup(table, 5, "a", 16) + " " + crc32_ieee_lookup(table, 4, "a", 24) + "))\n";
  o = o + "        (i32.xor (i32.xor " + crc32_ieee_lookup(table, 3, "b", 0) + " " + crc32_ieee_lookup(table, 2, "b", 8) + ")\n";
  o = o + "        (i32.xor " + crc32_ieee_lookup(table, 1, "b", 16) + " " + crc32_ieee_lookup(table, 0, "b", 24) + "))))\n";
  o += "      (local.set $p (i32.add (local.get $p) (i32.const 8)))\n";
  o += "      (br $c8)))\n";
  o += "    (block $d1 (loop $c1\n";
  o += "      (br_if $d1 (i32.ge_u (local.get $p) (local.get $end)))\n";
  o += "      (local.set $a (i32.and (i32.xor (local.get $crc) (i32.load8_u (local.get $p))) (i32.const 255)))\n";
  o = o + "      (local.set $crc (i32.xor (i32.shr_u (local.get $crc) (i32.const 8)) " + crc32_ieee_lookup(table, 0, "a", 0) + "))\n";
  o += "      (local.set $p (i32.add (local.get $p) (i32.const 1)))\n";
  o += "      (br $c1)))\n";
  o += "    (local.get $crc))\n";
  return o;
}

