    || module_emits_op_cached(cache, "sha1x8_hw_blocks");
}

// The helper that runs a byte kernel op.
function byte_kernel_name(tag: i32): string {
  if (ir.is_aes_gcm_op(tag)) {
    return wasm_aes.kernel_name(tag);
  }
  if (tag == ir.K_CHACHA20_XOR_INTO) {
    return "$__fern_chacha20_xor_into";
  }
  if (tag == ir.K_MONT_MUL) {
    return "$__fern_mont_mul";
  }
  if (tag == ir.K_SCRYPT_BLOCK_MIX) {
    return "$__fern_scrypt_block_mix";
  }
  if (tag == ir.K_POLY1305_BLOCKS) {
    return "$__fern_poly1305_blocks";
  }
  if (tag == ir.K_CHACHA20_POLY1305_SEAL_INTO) {
    return "$__fern_chacha20_poly1305_seal_into";
  }
  if (tag == ir.K_CHACHA20_POLY1305_OPEN_INTO) {
    return "$__fern_chacha20_poly1305_open_into";
  }
  return "$__fern_sha_hw_blocks";
}

// The needs of the kernels over arrays of 64-bit words.
function limb_kernel_needs(cache: irtables.LowerResult[], own out: string[]): string[] {
  if (module_emits_op_cached(cache, "mont_mul")) {
    out = out.append("@uses_mont_mul");
  }
  if (module_emits_op_cached(cache, "scrypt_block_mix")) {
    out = out.append("@uses_scrypt");
  }
  return out;
}

function limb_kernel_parts(needs: string[], own parts: string[]): string[] {
  if (need(needs, "@uses_mont_mul")) {
    parts = parts.append(wasm_mont.funcs());
  }
  if (need(needs, "@uses_scrypt")) {
    parts = parts.append(wasm_scrypt.funcs());
  }
  return parts;
}

function crypto_helper_parts(needs: string[], own parts: string[]): string[] {
  let aead = need(needs, "@uses_chacha20poly1305");
  if (need(needs, "@uses_aes_gcm") || need(needs, "@uses_chacha20") || need(needs, "@uses_poly1305") || aead || need(needs, "@uses_mont_mul")) {
    parts = parts.append(wasm_aes.view_funcs());
  }
  if (need(needs, "@uses_aes_gcm")) {
    parts = parts.append(wasm_aes.funcs());
  }
  if (need(needs, "@uses_chacha20") || aead) {
    parts = parts.append(wasm_chacha.funcs());
  }
  if (need(needs, "@uses_poly1305") || aead) {
    parts = parts.append(wasm_poly.funcs());
  }
  if (aead) {
    parts = parts.append(wasm_poly.aead_funcs());
  }
  parts = limb_kernel_parts(needs, parts);
  if (need(needs, "@uses_bswap")) {
    parts = parts.append(wasm_aes.bswap_funcs());
  }
  if (need(needs, "@uses_sha_hw_blocks")) {
    parts = parts.append(sha_hw_blocks_helper());
  }
  return parts;
}

function sha_hw_blocks_helper(): string {
  return "  (func $__fern_sha_hw_blocks (param $state i32) (param $data i32) (result i32) (local $a i32)\n"
    + "    (local.set $a (call $__fern_arr_elems (i32.const 0) (i32.const 1)))\n"
    + "    (i32.store (local.get $a) (i32.const 0))\n"
    + "    (i32.store offset=4 (local.get $a) (i32.const 0))\n"
    + "    (local.get $a))\n";
}

