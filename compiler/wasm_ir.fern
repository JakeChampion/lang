  let n: i32 = 0;
  while (n < 4) {
    let b: string = "(i32.load8_u offset=" + util.i32_to_string(at + order[n]) + " (local.get $ret))";
    if (n > 0) {
      b = "(i32.shl " + b + " (i32.const " + util.i32_to_string(8 * n) + "))";
    }
    if (n == 0) {
      o = b;
    } else {
      o = "(i32.or " + o + " " + b + ")";
    }
    n = n + 1;
  }
  return o;
}

