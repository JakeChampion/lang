  o = o + "    (drop (call $__fern_fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))\n";
  return o;
}

pub function eprint_str_helper(): string {
  let o: string = "";
  o = o + "  (func $__fern_eprint_str (param $p i32)\n";
