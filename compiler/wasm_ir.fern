  }
  if (need(needs, "fd_fdatasync")) {
    o = o + fd_sync_func("fdatasync", "fd_datasync");
  }
  if (need(needs, "fd_syncfs")) {
    o = o + fd_syncfs_func();
  }
  if (need(needs, "fd_drop_cache")) {
    o = o + fd_drop_cache_func();
  }
  if (need(needs, "clock_set")) {
    o = o + clock_set_func();
  }
  if (need(needs, "clone_file")) {
    o = o + clone_file_func();
  }
  if (need(needs, "fd_dup_onto")) {
    o = o + fd_dup_onto_func();
  }
  if (need(needs, "reader_splice")) {
    o = o + refused_copy_func("$__fern_reader_splice");
  }
  if (need(needs, "reader_copy_range")) {
    o = o + refused_copy_func("$__fern_reader_copy_range");
  }
  if (need(needs, "writer_splice_forever")) {
    o = o + splice_forever_func();
  }
  return o;
}

