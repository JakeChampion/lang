  let stdio: string = refused_errno();
  if (stat) {
    o = o + "    (memory.fill (local.get $buf) (i32.const 0) (i32.const 64))\n";
    stdio = "(i32.const 0)";
  }
  if (!files) {
    return o + "    " + stdio + ")\n";
  }
  o = o + "    (if (i32.eq (i32.load offset=8 (local.get $slot)) (i32.const -1)) (then (return " + stdio + ")))\n";
  o = o + "    (local.set $ra (call $__fern_alloc (i32.const " + bytes + ")))\n";
  o = o + "    (call $__fern_" + method + " (i32.load offset=8 (local.get $slot))" + args + " (local.get $ra))\n";
  o = o + p2_fail_ret(code_off, bytes);
  if (stat) {
    o = o + "    (call $__fern_filestat_p2 (local.get $ra) (local.get $buf))\n";
  }
  return o + p2_ok_ret(bytes);
}

