function rda_list_p2(): string {
  let o: string = "    (local.set $names (call $__fern_dir_names_p2 (local.get $path)))\n";
  o = o + "    (if (i32.lt_s (local.get $names) (i32.const 0)) (then (local.set $err (i32.sub (i32.const 0) (local.get $names)))))\n";
  return o + rda_refusal();
}

function rda_refusal(): string {
  let o: string = "";
  o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
  o = o + "      (if (i32.eq (local.get $err) (i32.const 44)) (then (return (call $__fern_rda_ok))))\n";
  o = o + "      (if (i32.eq (local.get $err) (i32.const 54)) (then\n";
  o = o + "        (drop (call $__fern_path_unlink_file (i32.const 3) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path))))\n";
  o = o + "        (return (call $__fern_rda_ok))))\n";
  o = o + "      (return (call $__fern_rda_err (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get $path)))))))\n";
  return o;
}

pub function sleep_ms_func(p2: boolean): string {
  return sleep_body(
    "$__fern_sleep_ms", "ms",
    "(i64.mul (local.get $ms) (i64.const 1000000))",
    p2,
  );
}

pub function sleep_ns_func(p2: boolean): string {
  return sleep_body("$__fern_sleep_ns", "ns", "(local.get $ns)", p2);
}

function sleep_body(name: string, param: string, timeout: string, p2: boolean): string {
  if (p2) {
    let o2: string = "  (func " + name + " (param $" + param + " i64) (result i32)\n";
    o2 = o2 + "    (local $p i32)\n";
    o2 = o2 + "    (if (i64.gt_s (local.get $" + param + ") (i64.const 0)) (then\n";
    o2 = o2 + "      (local.set $p (call $__fern_wasi_subscribe_duration " + timeout + "))\n";
    o2 = o2 + "      (call $__fern_wasi_pollable_block (local.get $p))\n";
    o2 = o2 + "      (call $__fern_wasi_pollable_drop (local.get $p))))\n";
    o2 = o2 + "    (i32.const 0))\n";
    return o2;
  }
  let a: i32 = sleep_scratch_addr();
  let at: string = util.i32_to_string(a);
  let o: string = "  (func " + name + " (param $" + param + " i64) (result i32)\n";
  o = o + "    (if (i64.gt_s (local.get $" + param + ") (i64.const 0)) (then\n";
  o = o + "      (i64.store (i32.const " + at + ") (i64.const 0))\n";
  o = o + "      (i32.store8 (i32.const " + util.i32_to_string(a + 8) + ") (i32.const 0))\n";
  o = o + "      (i32.store (i32.const " + util.i32_to_string(a + 16) + ") (i32.const 1))\n";
  o = o + "      (i64.store (i32.const " + util.i32_to_string(a + 24) + ") " + timeout + ")\n";
  o = o + "      (i64.store (i32.const " + util.i32_to_string(a + 32) + ") (i64.const 0))\n";
  o = o + "      (i32.store16 (i32.const " + util.i32_to_string(a + 40) + ") (i32.const 0))\n";
  o = o + "      (drop (call $__fern_poll_oneoff (i32.const " + at + ") (i32.const " + util.i32_to_string(a + 48) + ") (i32.const 1) (i32.const " + util.i32_to_string(a + 80) + ")))))\n";
  o = o + "    (i32.const 0))\n";
  return o;
}

pub function temp_dir_func(): string {
  let o: string = "";
  o = o + "  (func $__fern_temp_dir (param $prefix i32) (result i32)\n";
  o = o + "    (local $plen i32) (local $tot i32) (local $blk i32) (local $base i32) (local $i i32)\n";
  o = o + "    (local $rnd i32) (local $nib i32) (local $try i32) (local $err i32) (local $res i32)\n";
  o = o + "    (local.set $plen (i32.load (local.get $prefix)))\n";
  o = o + "    (local.set $i (i32.const 0))\n";
  o = o + "    (block $sd (loop $sl\n";
  o = o + "      (br_if $sd (i32.ge_u (local.get $i) (local.get $plen)))\n";
  o = o + "      (if (i32.eq (i32.load8_u (i32.add (i32.add (local.get $prefix) (i32.const 4)) (local.get $i))) (i32.const 47)) (then\n";
  o = o + "        (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o = o + "        (i32.store (local.get $res) (i32.const 1))\n";
  o = o + "        (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (i32.const 28) (call $__fern_rc_inc (local.get $prefix))))\n";
  o = o + "        (return (local.get $res))))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "      (br $sl)))\n";
  o = o + "    (local.set $tot (i32.add (local.get $plen) (i32.const 9)))\n";
  o = o + "    (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $tot))))\n";
  o = o + "    (i32.store (local.get $blk) (local.get $tot))\n";
  o = o + "    (memory.copy (i32.add (local.get $blk) (i32.const 4)) (i32.add (local.get $prefix) (i32.const 4)) (local.get $plen))\n";
  o = o + "    (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $plen)) (i32.const 45))\n";
  o = o + "    (local.set $base (i32.add (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $plen)) (i32.const 1)))\n";
  o = o + "    (block $made (loop $next\n";
  o = o + "      (local.set $rnd (call $__fern_random_i32))\n";
  o = o + "      (local.set $i (i32.const 0))\n";
  o = o + "      (block $hd (loop $hl\n";
  o = o + "        (br_if $hd (i32.ge_u (local.get $i) (i32.const 8)))\n";
  o = o + "        (local.set $nib (i32.and (i32.shr_u (local.get $rnd) (i32.mul (local.get $i) (i32.const 4))) (i32.const 15)))\n";
  o = o + "        (i32.store8 (i32.add (local.get $base) (local.get $i)) (i32.add (i32.add (local.get $nib) (i32.const 48)) (i32.mul (i32.ge_u (local.get $nib) (i32.const 10)) (i32.const 39))))\n";
  o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "        (br $hl)))\n";
  o = o + "      (local.set $err (call $__fern_path_create_directory (i32.const 3) (i32.add (local.get $blk) (i32.const 4)) (local.get $tot)))\n";
