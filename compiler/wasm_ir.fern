  o += "        (local.set $n (i32.load (local.get $buf)))\n";
  o += "        (if (i32.lt_u (local.get $len) (local.get $n)) (then (local.set $n (local.get $len))))\n";
  o += "        (memory.copy (i32.add (local.get $buf) (i32.const 8)) (local.get $src) (local.get $n))\n";
  o += "        (if (i32.ge_u (i32.load (local.get $from)) (i32.const 19)) (then\n";
  o += "          (memory.fill (i32.add (local.get $from) (i32.const 8)) (i32.const 0) (i32.const 19))\n";
  o += "          (if (i32.load8_u offset=8 (local.get $list))\n";
  o += "            (then\n";
  o += "              (i32.store8 offset=8 (local.get $from) (i32.const 6))\n";
  o += "              (local.set $i (i32.const 0))\n";
  o += "              (block $sd (loop $sl (br_if $sd (i32.ge_u (local.get $i) (i32.const 8)))\n";
  o += "                (i32.store8 offset=9 (i32.add (local.get $from) (i32.mul (local.get $i) (i32.const 2)))\n";
  o += "                  (i32.load8_u offset=21 (i32.add (local.get $list) (i32.mul (local.get $i) (i32.const 2)))))\n";
  o += "                (i32.store8 offset=10 (i32.add (local.get $from) (i32.mul (local.get $i) (i32.const 2)))\n";
  o += "                  (i32.load8_u offset=20 (i32.add (local.get $list) (i32.mul (local.get $i) (i32.const 2)))))\n";
  o += "                (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $sl))))\n";
  o += "            (else\n";
  o += "              (i32.store8 offset=8 (local.get $from) (i32.const 4))\n";
  o += "              (i32.store offset=9 (local.get $from) (i32.load offset=14 (local.get $list)))))\n";
  o += "          (i32.store8 offset=25 (local.get $from) (i32.load8_u offset=13 (local.get $list)))\n";
  o += "          (i32.store8 offset=26 (local.get $from) (i32.load8_u offset=12 (local.get $list)))))\n";
  o += "        (if (local.get $len) (then (call $__fern_raw_free (local.get $src) (local.get $len))))\n";
  o += "        (call $__fern_raw_free (local.get $list) (i32.const 40))))\n";
  o += "    (call $__fern_raw_free (local.get $ret) (i32.const 12))\n";
  o += "    (local.get $n))\n";
  return o;
}

// The stream imports a socket's reads and sends call.
function wasi_stream_io_imports(needs: string[]): string {
  let o = "";
  if (need_any(needs, ["tcp_send_bytes", "tcp_send_buf", "tcp_recv_into"])) {
    o += "  (import \"wasi:io/error@0.2.0\" \"[resource-drop]error\" (func $__fern_wasi_io_error_drop (param i32)))\n";
  }
  if (!need_tcp_send(needs)) {
    return o;
  }
  o += "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.blocking-write-and-flush\" (func $__fern_wasi_stream_write (param i32 i32 i32 i32)))\n";
  o += "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.check-write\" (func $__fern_wasi_stream_check_write (param i32 i32)))\n";
  o += "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.write\" (func $__fern_wasi_stream_write_nb (param i32 i32 i32 i32)))\n";
  o += "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.flush\" (func $__fern_wasi_stream_flush (param i32 i32)))\n";
  o += "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.blocking-flush\" (func $__fern_wasi_stream_blocking_flush (param i32 i32)))\n";
  return o;
}

// The stream-error at $err: a failed operation (its error dropped) is -EIO,
// a closed stream -EPIPE, in the WASI numbering.
function tcp_stream_failed_func(): string {
  let o = "  (func $__fern_tcp_stream_failed (param $err i32) (result i32)\n";
  o += "    (if (i32.load8_u (local.get $err)) (then (return (i32.const -64))))\n";
  o += "    (call $__fern_wasi_io_error_drop (i32.load offset=4 (local.get $err)))\n";
  o += "    (i32.const -29))\n";
  return o;
}

// A non-blocking socket writes what check-write permits now and starts its
// flush, -EAGAIN when it permits nothing; a blocking one writes it all.
function tcp_write_func(): string {
  let o = "  (func $__fern_tcp_write (param $c i32) (param $p i32) (param $len i32) (result i32)\n";
  o += "    (local $st i32) (local $ret i32) (local $off i32) (local $n i32)\n";
  o += closed_socket_guard("c");
  o += "    (local.set $st (i32.load offset=8 (local.get $c)))\n";
  o = o + "    (local.set $ret (i32.const " + util.i32_to_string(io_ret_addr()) + "))\n";
  o += "    (if (i32.load offset=16 (local.get $c)) (then\n";
  o += "      (call $__fern_wasi_stream_check_write (local.get $st) (local.get $ret))\n";
  o += "      (if (i32.load8_u (local.get $ret)) (then (return (call $__fern_tcp_stream_failed (i32.add (local.get $ret) (i32.const 8))))))\n";
  o += "      (if (i64.lt_u (i64.load offset=8 (local.get $ret)) (i64.extend_i32_u (local.get $len))) (then (local.set $len (i32.wrap_i64 (i64.load offset=8 (local.get $ret))))))\n";
  o += "      (if (i32.eqz (local.get $len)) (then (return (i32.const -6))))\n";
  o += "      (call $__fern_wasi_stream_write_nb (local.get $st) (local.get $p) (local.get $len) (local.get $ret))\n";
  o += "      (if (i32.eqz (i32.load8_u (local.get $ret))) (then (call $__fern_wasi_stream_flush (local.get $st) (local.get $ret))))\n";
  o += "      (if (i32.load8_u (local.get $ret)) (then (return (call $__fern_tcp_stream_failed (i32.add (local.get $ret) (i32.const 4))))))\n";
  o += "      (return (local.get $len))))\n";
  o += "    (block $done (loop $more\n";
  o += "      (br_if $done (i32.ge_u (local.get $off) (local.get $len)))\n";
  o += "      (local.set $n (i32.sub (local.get $len) (local.get $off)))\n";
  o += "      (if (i32.gt_u (local.get $n) (i32.const 4096)) (then (local.set $n (i32.const 4096))))\n";
  o += "      (call $__fern_wasi_stream_write (local.get $st) (i32.add (local.get $p) (local.get $off)) (local.get $n) (local.get $ret))\n";
  o += "      (if (i32.load8_u (local.get $ret)) (then\n";
  o += "        (local.set $n (call $__fern_tcp_stream_failed (i32.add (local.get $ret) (i32.const 4))))\n";
  o += "        (if (i32.gt_u (local.get $off) (i32.const 0)) (then (return (local.get $off))))\n";
  o += "        (return (local.get $n))))\n";
  o += "      (local.set $off (i32.add (local.get $off) (local.get $n))) (br $more)))\n";
  o += "    (local.get $len))\n";
  return o;
}

function tcp_send_funcs(needs: string[]): string {
  if (!need_tcp_send(needs)) {
    return "";
  }
  let o = tcp_stream_failed_func() + tcp_write_func();
  if (need(needs, "tcp_send_bytes")) {
    o += tcp_send_bytes_func();
  }
  if (need(needs, "tcp_send_buf")) {
    o += tcp_send_buf_func();
  }
  return o;
}

pub function tcp_send_bytes_func(): string {
  let o = "  (func $__fern_tcp_send_bytes (param $c i32) (param $a i32) (result i32)\n";
  o += "    (if (i32.eqz (i32.load (local.get $a))) (then (return (i32.const 0))))\n";
  o += "    (call $__fern_tcp_write (local.get $c) (i32.add (local.get $a) (i32.const 8)) (i32.load (local.get $a))))\n";
  return o;
}

pub function tcp_send_buf_func(): string {
  let o = "  (func $__fern_tcp_send_buf (param $c i32) (param $h i32) (param $from i32) (result i32)\n";
  o += "    (local $len i32)\n";
  o += "    (if (i32.lt_s (local.get $from) (i32.const 0)) (then (return (i32.const 0))))\n";
  o += "    (local.set $len (i32.sub (i32.load offset=4 (local.get $h)) (local.get $from)))\n";
  o += "    (if (i32.le_s (local.get $len) (i32.const 0)) (then (return (i32.const 0))))\n";
  o += "    (call $__fern_tcp_write (local.get $c) (i32.add (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $from)) (local.get $len)))\n";
  return o;
}

// A handle that is not valid arrives as a negative number, which is the
// address of no socket record. The result is the code of a bad descriptor.
function closed_socket_guard(param: string): string {
  return "    (if (i32.lt_s (local.get $" + param + ") (i32.const 0)) (then (return (i32.const -8))))\n";
}

// With sends linked, a connection's output stream is flushed before it is
// dropped: wasmtime cancels a write still in flight when its stream drops.
pub function tcp_close_func(udp: boolean, watched: boolean, sends: boolean): string {
  let o = "";
  o += "  (func $__fern_tcp_close (param $c i32) (result i32)\n";
  o += closed_socket_guard("c");
  o += "    (drop (call $__fern_task_fd_closed (local.get $c)))\n";
  if (watched) {
    o += "    (call $__fern_reactor_forget (local.get $c))\n";
  }
  if (udp) {
    o += "    (if (i32.lt_u (i32.sub (i32.load offset=12 (local.get $c)) (i32.const 2)) (i32.const 2)) (then (return (call $__fern_udp_close (local.get $c)))))\n";
  }
  o += "    (if (i32.eq (i32.load offset=12 (local.get $c)) (i32.const 1)) (then\n";
  if (sends) {
    o = o + "      (call $__fern_wasi_stream_blocking_flush (i32.load offset=8 (local.get $c)) (i32.const " + util.i32_to_string(io_ret_addr()) + "))\n";
    o = o + "      (if (i32.load8_u (i32.const " + util.i32_to_string(io_ret_addr()) + ")) (then (drop (call $__fern_tcp_stream_failed (i32.const " + util.i32_to_string(io_ret_addr() + 4) + ")))))\n";
  }
  o += "      (call $__fern_wasi_input_stream_drop (i32.load offset=4 (local.get $c)))\n";
  o += "      (call $__fern_wasi_output_stream_drop (i32.load offset=8 (local.get $c)))))\n";
  o += "    (call $__fern_wasi_tcp_socket_drop (i32.load (local.get $c)))\n";
  o += "    (call $__fern_raw_free (local.get $c) (i32.const 20))\n";
  o += "    (i32.const 0))\n";
  return o;
}

pub function poll_fds_func(): string {
  let o = "";
  o += "  (func $__fern_poll (param $arr i32) (param $ms i32) (result i32)\n";
  o += "    (local $n i32) (local $buf i32) (local $t i32) (local $ret i32) (local $i i32) (local $idx i32) (local $count i32)\n";
  o += "    (if (i32.lt_s (local.get $ms) (i32.const 0)) (then\n";
  o += "      (return (call $__fern_wasm_poll (local.get $arr)))))\n";
  o += "    (local.set $n (i32.load (local.get $arr)))\n";
  o += "    (local.set $buf (call $__fern_alloc (i32.mul (i32.add (local.get $n) (i32.const 1)) (i32.const 4))))\n";
  o += "    (block $copied\n";
  o += "      (loop $more\n";
  o += "        (br_if $copied (i32.ge_u (local.get $i) (local.get $n)))\n";
  o += "        (i32.store (i32.add (local.get $buf) (i32.mul (local.get $i) (i32.const 4)))\n";
  o += "          (i32.load (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
  o += "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "        (br $more)))\n";
  o += "    (local.set $t (call $__fern_wasi_subscribe_duration\n";
  o += "      (i64.mul (i64.extend_i32_s (local.get $ms)) (i64.const 1000000))))\n";
  o += "    (i32.store (i32.add (local.get $buf) (i32.mul (local.get $n) (i32.const 4))) (local.get $t))\n";
  o += "    (local.set $ret (call $__fern_alloc (i32.const 8)))\n";
  o += "    (call $__fern_wasi_poll (local.get $buf) (i32.add (local.get $n) (i32.const 1)) (local.get $ret))\n";
  o += "    (local.set $idx (i32.const -1))\n";
  o += "    (local.set $count (i32.load offset=4 (local.get $ret)))\n";
  o += "    (if (local.get $count) (then\n";
  o += "      (local.set $idx (i32.load (i32.load (local.get $ret))))\n";
  o += "      (call $__fern_raw_free (i32.load (local.get $ret)) (i32.mul (local.get $count) (i32.const 4)))))\n";
  o += "    (call $__fern_raw_free (local.get $ret) (i32.const 8))\n";
  o += "    (call $__fern_raw_free (local.get $buf) (i32.mul (i32.add (local.get $n) (i32.const 1)) (i32.const 4)))\n";
  o += "    (call $__fern_wasi_pollable_drop (local.get $t))\n";
  o += "    (if (i32.ge_u (local.get $idx) (local.get $n)) (then (return (i32.const -1))))\n";
  o += "    (local.get $idx))\n";
  return o;
}

pub function wasm_poll_func(): string {
  let o = "";
  o += "  (func $__fern_wasm_poll (param $arr i32) (result i32)\n";
  o += "    (local $retptr i32) (local $count i32) (local $idx i32)\n";
  o += "    (local.set $retptr (call $__fern_alloc (i32.const 8)))\n";
  o += "    (call $__fern_wasi_poll (i32.add (local.get $arr) (i32.const 8))\n";
  o += "      (i32.load (local.get $arr))\n";
  o += "      (local.get $retptr))\n";
  o += "    (local.set $idx (i32.const -1))\n";
  o += "    (local.set $count (i32.load offset=4 (local.get $retptr)))\n";
  o += "    (if (local.get $count) (then\n";
  o += "      (local.set $idx (i32.load (i32.load (local.get $retptr))))\n";
  o += "      (call $__fern_raw_free (i32.load (local.get $retptr)) (i32.mul (local.get $count) (i32.const 4)))))\n";
  o += "    (call $__fern_raw_free (local.get $retptr) (i32.const 8))\n";
  o += "    (local.get $idx))\n";
  return o;
}

pub function route_normalized(mod: parser.Module): parser.Module {
  return lift_lambdas(ircore.script_normalized(ircore.scale_f64_maps_module(mod)));
}

pub function lift_lambdas(mod: parser.Module): parser.Module {
  return lift.lift_lambdas(mod);
}

pub function lift_lambdas_parts(mods: parser.Module[]): parser.Module[] {
  mods = lift.prepare_lambda_parts(mods);
  let view = lift.module_sig_view(mods);
  let out: parser.Module[] = [];
  for i in 0..mods.len() {
    out = out.append(parser.infer_ret_types_module(lift.lift_lambdas_view(mods[i], view)));
  }
  return out;
}

pub function fn_value_table(cache: irtables.LowerResult[]): string[] {
  let out: string[] = [];
  for fi in 0..cache.len() {
    let r = cache[fi];
    for i in 0..r.ops.len() {
      if (r.ops[i].kind_tag == ir.K_CONST_FUNC && util.index_of_str(out, r.ops[i].str) < 0) {
        out = out.append(r.ops[i].str);
      }
      if (r.ops[i].kind_tag == ir.K_CONST_STRUCT) {
        let cfb = ir.const_struct_fn_body(r.ops[i].str);
        if (cfb.len() > 0 && util.index_of_str(out, cfb) < 0) {
          out = out.append(cfb);
        }
      }
    }
  }
  return out;
}

pub function fn_type_name(o: ir.Op): string {
  if (o.str.len() > 0) {
    return "$fn" + o.str;
  }
  return "$fn" + util.i32_to_string(o.i32_imm);
}

pub function fn_sig_key(argc: i32): string {
  let k = "";
  for i in 0..argc {
    k += "w";
  }
  return k + "_w";
}

pub function indirect_fn_sigs(cache: irtables.LowerResult[]): string[] {
  let out: string[] = [];
  for fi in 0..cache.len() {
    let r = cache[fi];
    for i in 0..r.ops.len() {
      if (r.ops[i].kind_tag == ir.K_CALL_INDIRECT) {
        let nm = fn_type_name(r.ops[i]);
        let sg = r.ops[i].str;
        if (sg.len() == 0) {
          sg = fn_sig_key(r.ops[i].i32_imm);
        }
        let ent = nm + "|" + sg;
        if (util.index_of_str(out, ent) < 0) {
          out = out.append(ent);
        }
      }
    }
  }
  return out;
}

function wasm_type_of_char(c: string): string {
  if (c == "l") {
    return "i64";
  }
  if (c == "d") {
    return "f64";
  }
  return "i32";
}

function fn_type_decl(entry: string): string {
  let bar = 0;
  while (bar < entry.len() && entry[bar] != 124) {
    bar += 1;
  }
  let name = slice_unchecked(entry, 0, bar);
  let sig = slice_unchecked(entry, bar + 1, entry.len());
  let us = 0;
  while (us < sig.len() && sig[us] != 95) {
    us += 1;
  }
  let out = "  (type " + name + " (func";
  for i in 0..us {
    out = out + " (param " + wasm_type_of_char(slice_unchecked(sig, i, i + 1)) + ")";
  }
  return out + " (result " + wasm_type_of_char(slice_unchecked(sig, us + 1, sig.len())) + ")))\n";
}

pub function fn_support_section_units(nss: string[], all_fns: string[], counts: i32[], fn_sigs: string[]): string {
  if (all_fns.len() == 0 && fn_sigs.len() == 0) {
    return "";
  }
  let parts: string[] = [];
  for ai in 0..fn_sigs.len() {
    parts = parts.append(fn_type_decl(fn_sigs[ai]));
  }
  let tsize = all_fns.len();
  if (tsize == 0) {
    tsize = 1;
  }
  let base = 0;
  for ni in 0..nss.len() {
    parts = parts.append("  (global " + fn_base_global(nss[ni]) + " i32 (i32.const " + util.i32_to_string(base) + "))\n");
    base += counts[ni];
  }
  parts = parts.append("  (table " + util.i32_to_string(tsize) + " funcref)\n");
  if (all_fns.len() > 0) {
    parts = parts.append("  (elem (i32.const 0)");
    for ei in 0..all_fns.len() {
      parts = parts.append(" $" + all_fns[ei]);
    }
    parts = parts.append(")\n");
  }
  return util.str_join_chunks(parts);
}

function wasm_arr_bounds_check(base_local: i32, idx_local: i32, cause: string): string {
  let s = wasm_arr_index_trap(base_local, idx_local, cause);
  s = s + "    local.get " + util.i32_to_string(base_local) + "\n";
  s = s + "    local.get " + util.i32_to_string(idx_local) + "\n";
  return s;
}

function wasm_arr_index_trap(base_local: i32, idx_local: i32, cause: string): string {
  let s = "";
  s = s + "    local.tee " + util.i32_to_string(base_local) + "\n";
  s += "    i32.load\n";
  s = s + "    local.get " + util.i32_to_string(idx_local) + "\n";
  s += "    i32.le_u\n";
  return s + "    if\n      call $__fern_abort_" + cause + "\n      unreachable\n    end\n";
}

function emit_map_hash_seed_wat(): string {
  let seed_at = util.i32_to_string(map_hash_seed_addr());
  return "    i32.const " + seed_at + "\n    i32.load\n    i32.eqz\n    if\n"
    + "    i32.const " + seed_at + "\n    call $__fern_random_i32\n"
    + "    i32.const 1\n    i32.or\n    i32.store\n    end\n"
    + "    i32.const " + seed_at + "\n    i32.load\n";
}

function is_host_op_kind(tag: i32): boolean {
  return tag == ir.K_PRINT_STR || tag == ir.K_EPRINT_STR || tag == ir.K_MONOTONIC_NS || tag == ir.K_NOW_UNIX_MS
    || tag == ir.K_NOW_NS || tag == ir.K_CLOCK_RESOLUTION || tag == ir.K_CLOCK_SET || tag == 209 || tag == ir.K_READ_FILE || tag == ir.K_READ_FILE_BYTES || tag == ir.K_WRITE_FILE || tag == ir.K_WRITE_FILE_BYTES
    || tag == ir.K_OPEN_FILE || tag == ir.K_OPEN_READER_WITH || tag == ir.K_OPEN_WRITER_WITH || tag == ir.K_WRITER_WRITE || tag == ir.K_WRITE_SOME || tag == ir.K_ENV || tag == ir.K_STAT || tag == ir.K_LSTAT || tag == ir.K_REMOVE_FILE || tag == ir.K_CREATE_DIR_ALL
    || tag == ir.K_READ_DIR || tag == ir.K_READ_DIR_ALL || tag == ir.K_READ_DIR_INO || tag == ir.K_READ_DIR_INO_ALL || tag == ir.K_REMOVE_DIR_ALL || tag == ir.K_ARGS || tag == ir.K_ENVIRON || tag == ir.K_EXIT
    || tag == ir.K_CREATE_DIR || tag == ir.K_REMOVE_DIR || tag == ir.K_CREATE_LINK || tag == ir.K_CREATE_SYMLINK || tag == ir.K_READ_LINK
    || tag == ir.K_RENAME || tag == ir.K_SET_FILE_TIMES || tag == ir.K_WRITER_SET_TIMES || tag == ir.K_TRUNCATE || tag == ir.K_CLONE_FILE;
}

function emit_host_op_wat(o: ir.Op): string {
  if (o.kind_tag == ir.K_PRINT_STR) {
    return "    call $__fern_print_str\n    i32.const 0\n";
  }
  if (o.kind_tag == ir.K_EPRINT_STR) {
    return "    call $__fern_eprint_str\n    i32.const 0\n";
  }
  if (o.kind_tag == ir.K_MONOTONIC_NS) {
    return "    call $__fern_monotonic_ns\n";
  }
  if (o.kind_tag == ir.K_NOW_UNIX_MS) {
    return "    call $__fern_now_unix_ms\n";
  }
  if (o.kind_tag == ir.K_NOW_NS) {
    return "    call $__fern_now_ns\n";
  }
  if (o.kind_tag == ir.K_CLOCK_RESOLUTION) {
    return "    call $__fern_clock_resolution\n";
  }
  if (o.kind_tag == ir.K_CLOCK_SET) {
    return "    call $__fern_clock_set\n";
  }
  if (o.kind_tag == ir.K_CLONE_FILE) {
    return "    call $__fern_clone_file\n";
  }
  if (o.kind_tag == ir.K_READ_FILE) {
    return "    call $__fern_read_file\n";
  }
  if (o.kind_tag == ir.K_READ_FILE_BYTES) {
    return "    call $__fern_read_file_bytes\n";
  }
  if (o.kind_tag == ir.K_WRITE_FILE_BYTES) {
    return "    call $__fern_write_file_bytes\n";
  }
  if (o.kind_tag == ir.K_WRITE_FILE) {
    return "    call $__fern_write_file\n";
  }
  if (o.kind_tag == ir.K_OPEN_FILE) {
    return "    i32.const " + util.i32_to_string(o.i32_imm) + "\n    call $__fern_open_file\n";
  }
  if (o.kind_tag == ir.K_OPEN_READER_WITH || o.kind_tag == ir.K_OPEN_WRITER_WITH) {
    let open_write = 0;
    if (o.kind_tag == ir.K_OPEN_WRITER_WITH) {
      open_write = 1;
    }
    return "    i32.const " + util.i32_to_string(open_write) + "\n    call $__fern_open_with\n";
  }
  if (o.kind_tag == ir.K_WRITE_SOME) {
    return "    call $__fern_writer_write_some\n";
  }
  if (o.kind_tag == ir.K_WRITER_WRITE) {
    return "    call $__fern_writer_write\n";
  }
  if (o.kind_tag == ir.K_ENV) {
    return "    call $__fern_env\n";
  }
  if (o.kind_tag == ir.K_STAT) {
    return tid_get("FileStat") + "    call $__fern_stat\n";
  }
  if (o.kind_tag == ir.K_LSTAT) {
    return tid_get("FileStat") + "    call $__fern_lstat\n";
  }
  if (o.kind_tag == ir.K_REMOVE_FILE) {
    return "    call $__fern_remove_file\n";
  }
  if (o.kind_tag == ir.K_CREATE_DIR) {
    return "    call $__fern_create_dir\n";
  }
  if (o.kind_tag == ir.K_REMOVE_DIR) {
    return "    call $__fern_remove_dir\n";
  }
  if (o.kind_tag == ir.K_CREATE_LINK) {
    return "    call $__fern_create_link\n";
  }
  if (o.kind_tag == ir.K_RENAME) {
    return "    call $__fern_rename\n";
  }
  if (o.kind_tag == ir.K_CREATE_SYMLINK) {
    return "    call $__fern_create_symlink\n";
  }
  if (o.kind_tag == ir.K_TRUNCATE) {
    return "    call $__fern_truncate\n";
  }
  if (o.kind_tag == ir.K_SET_FILE_TIMES || o.kind_tag == ir.K_WRITER_SET_TIMES) {
    let helper: string = if (o.kind_tag == ir.K_WRITER_SET_TIMES) { "writer_set_times" } else { "set_file_times" };
    return "    call $__fern_" + helper + "\n";
  }
  if (o.kind_tag == ir.K_READ_LINK) {
    if (o.i32_imm != 0) {
      return "    call $__fern_read_link_bytes\n";
    }
    return "    call $__fern_read_link\n";
  }
  if (o.kind_tag == ir.K_CREATE_DIR_ALL) {
    return "    call $__fern_create_dir_all\n";
  }
  if (o.kind_tag == ir.K_READ_DIR) {
    if (o.i32_imm != 0) {
      return "    call $__fern_read_dir_bytes\n";
    }
    return "    call $__fern_read_dir\n";
  }
  if (o.kind_tag == ir.K_READ_DIR_ALL) {
    return "    call $__fern_read_dir_all\n";
  }
  if (o.kind_tag == ir.K_READ_DIR_INO) {
    return tid_get("DirEntry") + "    call $__fern_read_dir_ino\n";
  }
  if (o.kind_tag == ir.K_READ_DIR_INO_ALL) {
    return tid_get("DirEntry") + "    call $__fern_read_dir_ino_all\n";
  }
  if (o.kind_tag == ir.K_REMOVE_DIR_ALL) {
    return "    call $__fern_remove_dir_all\n";
  }
  if (o.kind_tag == ir.K_ARGS) {
    return "    call $__fern_args\n";
  }
  if (o.kind_tag == ir.K_ENVIRON) {
    return "    call $__fern_environ\n";
  }
  if (o.kind_tag == ir.K_EXIT) {
    return "    call $__fern_proc_exit\n    i32.const 0\n";
  }
  return ircore.unsupported_op_refuse(o.kind_tag, "wasm");
}

function emit_dyn_dispatch_wat(o: ir.Op, structs: irtables.StructTab, funcs: parser.FuncDecl[]): string {
  let parts: string[] = [];
  let dbase = o.i32_imm;
  let dargc = o.width;
  let drt = "i32";
  let nimpl = 0;
  for df0 in 0..funcs.len() {
    let dbn0 = util.base_type_name(funcs[df0].receiver_type);
    if (irtables.dyn_arm_matches(funcs[df0], o.str) && funcs[df0].receiver_type.len() > 0
      && (irtables.decl_is_struct(structs, dbn0) || irtables.decl_is_prim_recv(structs, dbn0)
      || !asmcore.recv_is_array(funcs[df0].receiver_type) && irtables.decl_is_enum(structs, dbn0))) {
      if (nimpl == 0) {
        if (parser.is_wide_int_type_name(funcs[df0].ret_type)) {
          drt = "i64";
        } else if (parser.is_float_type_name(funcs[df0].ret_type)) {
          drt = "f64";
        }
      }
      nimpl += 1;
    }
  }
  for dfi in 0..funcs.len() {
    let dbn = util.base_type_name(funcs[dfi].receiver_type);
    let dprim = funcs[dfi].receiver_type.len() > 0 && irtables.decl_is_prim_recv(structs, dbn);
    if (irtables.dyn_arm_matches(funcs[dfi], o.str) && funcs[dfi].receiver_type.len() > 0
      && (irtables.decl_is_struct(structs, dbn) || dprim)) {
      parts = parts.append("    local.get " + util.i32_to_string(dbase) + "\n    i32.load\n" + tid_get(dbn) + "    i32.eq\n");
      parts = parts.append("    if (result " + drt + ")\n");
      for dk in 0..dargc {
        if (dk == 0 && dprim) {
          parts = parts.append("    local.get " + util.i32_to_string(dbase) + "\n    i32.const 8\n    i32.add\n    " + dyn_prim_valtype(dbn) + ".load\n");
        } else {
          parts = parts.append("    local.get " + util.i32_to_string(dbase + dk) + "\n");
        }
      }
      parts = parts.append("    call $" + dbn + "." + funcs[dfi].name + "\n");
      parts = parts.append("    else\n");
    }
    if (irtables.dyn_arm_matches(funcs[dfi], o.str) && funcs[dfi].receiver_type.len() > 0
      && !asmcore.recv_is_array(funcs[dfi].receiver_type)
      && irtables.decl_is_enum(structs, dbn)
      && !(irtables.decl_is_struct(structs, dbn) || dprim)) {
      let denvn = 0;
      let dvi = irtables.stab_enum_first(structs, dbn);
      while (dvi >= 0) {
        parts = parts.append("    local.get " + util.i32_to_string(dbase) + "\n    i32.load\n    i32.const " + util.i32_to_string(dvi) + "\n    i32.eq\n");
        if (denvn > 0) {
          parts = parts.append("    i32.or\n");
        }
        denvn += 1;
        dvi = irtables.stab_enum_next(structs, dvi, dbn);
      }
      parts = parts.append("    if (result " + drt + ")\n");
      for dek in 0..dargc {
        parts = parts.append("    local.get " + util.i32_to_string(dbase + dek) + "\n");
      }
      parts = parts.append("    call $" + dbn + "." + funcs[dfi].name + "\n");
      parts = parts.append("    else\n");
    }
  }
  parts = parts.append("    unreachable\n");
  for de in 0..nimpl {
    parts = parts.append("    end\n");
  }
  return util.str_join_chunks(parts);
}

struct WasmOpCtx {
  ns: string,
  strs: Placed,
  caggs: Placed,
  structs: irtables.StructTab,
  fn_table: string[],
  funcs: parser.FuncDecl[],
  base: i32,
  window: i32,
}

function has_lane_op(ops: ir.Op[]): boolean {
  for o in ops {
    if (ir.is_lane_kind(o.kind_tag)) {
      return true;
    }
  }
  return false;
}

function wasm_lane_shape(width: i32): string {
  if (width == 32) {
    return "f32x4";
  }
  return "f64x2";
}

function wasm_lane_const(width: i32, text: string): string {
  if (width == 32) {
    return "    f64.const " + text + "\n    f32.demote_f64\n    f32x4.splat\n";
  }
  return "    f64.const " + text + "\n    f64x2.splat\n";
}

// An op on integer lanes of 8, 16 or 32 bits. An op that a width does
// not have is a refusal that names the op.
function emit_wasm_lane_int(o: ir.Op): string {
  let w = o.width;
  if (w != 8 && w != 16 && w != 32) {
    return ircore.unsupported_op_refuse(o.kind_tag, "wasm");
  }
  let verbs: string[] = ["add", "sub", "add_sat_s", "add_sat_u", "sub_sat_s", "sub_sat_u", "min_s", "min_u", "max_s", "max_u", "avgr_u", "eq", "ne", "lt_s", "lt_u", "neg", "abs", "splat", "extract_lane_s", "extract_lane_u", "bitmask", "replace_lane", "mul", "shl", "shr_s", "shr_u"];
  let verb = verbs[o.kind_tag - ir.LANE_INT_FIRST];
  // Lanes of 32 bits have no saturating form and no average, and lanes
  // of 8 bits have no multiply.
  if (w == 32 && (verb.contains("_sat_") || verb == "avgr_u") || w == 8 && verb == "mul") {
    return ircore.unsupported_op_refuse(o.kind_tag, "wasm");
  }
  let shape = if (w == 8) { "i8x16" } else if (w == 16) { "i16x8" } else { "i32x4" };
  if (verb.starts_with("extract_lane")) {
    // A lane of 32 bits is the whole i32, so its read has no sign.
    let read = if (w == 32) { "extract_lane" } else { verb };
    return "    " + shape + "." + read + " " + util.i32_to_string(o.i32_imm) + "\n";
  }
  if (verb == "replace_lane") {
    return "    " + shape + "." + verb + " " + util.i32_to_string(o.i32_imm) + "\n";
  }
  return "    " + shape + "." + verb + "\n";
}

function emit_wasm_lane(o: ir.Op, cx: WasmOpCtx): string {
  if (ir.is_lane_int_kind(o.kind_tag)) {
    return emit_wasm_lane_int(o);
  }
  let k = ir.kind_name(o.kind_tag);
  if (k == "vextract_bits") {
    return "    " + (if (o.width == 32) { "i32x4" } else { "i64x2" }) + ".extract_lane " + util.i32_to_string(o.i32_imm) + "\n";
  }
  if (k == "vpermute") {
    let out = "    i8x16.shuffle";
    let bytes = o.width / 8;
    let lanes = 16 / bytes;
    for i in 0..16 {
      let lane = i / bytes;
      let selected = if (o.i32_imm == 3) { (lane + lanes / 2) % lanes } else if (o.i32_imm == 0) { lanes - 1 - lane } else { (lane & 1) * lanes + lane / 2 + (if (o.i32_imm == 2) { lanes / 2 } else { 0 }) };
      if (o.i32_imm >= 4) {
        let position = if (o.i32_imm >= 6) { 3 - lane } else { lane };
        selected = 2 * position + (o.i32_imm & 1);
      }
      out += " " + util.i32_to_string(selected * bytes + i % bytes);
    }
    return out + "\n";
  }
  if (k == "vbitmask") {
    if (o.width == 32) {
      return "    i32x4.bitmask\n";
    }
    return "    i64x2.bitmask\n";
  }
  let sh = wasm_lane_shape(o.width);
  let vtmp = util.i32_to_string(cx.base + 5);
  if (k == "vload_f32") {
    return "    i64.load\n    i64x2.splat\n    f64x2.promote_low_f32x4\n";
  }
  if (k == "vpack") {
    return "    local.set " + vtmp + "\n    f32x4.demote_f64x2_zero\n    local.get " + vtmp + "\n    f32x4.demote_f64x2_zero\n    f64x2.extract_lane 0\n    f64x2.replace_lane 1\n";
  }
  if (k == "vsplat") {
    if (o.width == 32) {
      return "    f32.demote_f64\n    f32x4.splat\n";
    }
    return "    f64x2.splat\n";
  }
  if (k == "vextract") {
    let out = "    " + sh + ".extract_lane " + util.i32_to_string(o.i32_imm) + "\n";
    if (o.width == 32) {
      return out + "    f64.promote_f32\n";
    }
    return out;
  }
  if (k == "vreplace") {
    let pre = "";
    if (o.width == 32) {
      pre = "    f32.demote_f64\n";
    }
    return pre + "    " + sh + ".replace_lane " + util.i32_to_string(o.i32_imm) + "\n";
  }
  if (k == "vfma") {
    return "    local.set " + vtmp + "\n    " + sh + ".mul\n    local.get " + vtmp + "\n    " + sh + ".add\n";
  }
  if (k == "vround") {
    return emit_wasm_lane_round(o.width, sh, vtmp);
  }
  if (util.has_str(["vget", "vset"], k)) {
    return emit_wasm_lane_group(o.width, cx.base, k == "vset", o.unsigned, o.unsigned && o.i32_imm == 1);
  }
  return "    " + wasm_lane_verb(k, sh) + "\n";
}

function emit_wasm_lane_group(width: i32, base: i32, set: boolean, packed: boolean, unchecked: boolean): string {
  let arr = util.i32_to_string(base);
  let at = "    local.get " + util.i32_to_string(base + 4) + "\n";
  let v = "    local.get " + util.i32_to_string(base + 5) + "\n";
  let out = "";
  if (set) {
    out = "    local.set " + util.i32_to_string(base + 5) + "\n";
  }
  out = out + "    local.set " + util.i32_to_string(base + 4) + "\n";
  if (!unchecked) {
    out += wasm_arr_index_trap(base, base + 4, "arr");
  } else {
    out += "    local.set " + arr + "\n";
  }
  if (packed) {
    if (!unchecked) {
      out = out + "    local.get " + arr + "\n    i32.load\n" + at + "    i32.sub\n    i32.const 16\n    i32.lt_u\n    if\n      call $__fern_abort_arr\n      unreachable\n    end\n";
    }
    out = out + "    local.get " + arr + "\n" + at + "    i32.add\n    i32.const 8\n    i32.add\n";
    if (set) {
      return out + v + "    v128.store\n";
    }
    return out + "    v128.load\n";
  }
  out = out + "    local.get " + arr + "\n    i32.load\n" + at + "    i32.const " + util.i32_to_string(128 / width - 1) + "\n    i32.add\n    i32.le_u\n    if\n      call $__fern_abort_arr\n      unreachable\n    end\n";
  out = out + "    local.get " + arr + "\n" + at + "    i32.const 8\n    i32.mul\n    i32.add\n    i32.const 8\n    i32.add\n    local.set " + util.i32_to_string(base + 4) + "\n";
  let hi = at + "    i32.const 16\n    i32.add\n";
  if (set && width == 64) {
    return out + at + v + "    v128.store\n";
  }
  if (set) {
    return out + at + v + "    f64x2.promote_low_f32x4\n    v128.store\n" + hi + v + "    f64x2.extract_lane 1\n    f64x2.splat\n    f64x2.promote_low_f32x4\n    v128.store\n";
  }
  if (width == 64) {
    return out + at + "    v128.load\n";
  }
  return out + at + "    v128.load\n    f32x4.demote_f64x2_zero\n" + hi + "    v128.load\n    f32x4.demote_f64x2_zero\n    f64x2.extract_lane 0\n    f64x2.replace_lane 1\n";
}

function wasm_lane_verb(k: string, sh: string): string {
  let names: string[] = ["vadd", "vsub", "vmul", "vdiv", "vmin", "vmax", "vsqrt", "vabs", "vneg", "vfloor", "vceil", "vtrunc", "veq", "vne", "vlt", "vle", "vgt", "vge", "vand", "vor", "vxor", "vandnot", "vselect", "vload", "vstore"];
  let verbs: string[] = ["add", "sub", "mul", "div", "pmin", "pmax", "sqrt", "abs", "neg", "floor", "ceil", "trunc", "eq", "ne", "lt", "le", "gt", "ge", "v128.and", "v128.or", "v128.xor", "v128.andnot", "v128.bitselect", "v128.load", "v128.store"];
  let v = verbs[util.index_of_str(names, k)];
  if (v.starts_with("v128.")) {
    return v;
  }
  return sh + "." + v;
}

function emit_wasm_lane_round(width: i32, sh: string, vtmp: string): string {
  let x = "    local.get " + vtmp + "\n";
  let half = "    i64.const 4602678819172646911\n    i64x2.splat\n";
  if (width == 32) {
    half = "    i64.const 4539628421151457279\n    i64x2.splat\n";
  }
  let out = "    local.set " + vtmp + "\n" + x + "    " + sh + ".abs\n" + half;
  out = out + "    " + sh + ".add\n    " + sh + ".floor\n";
  return out + x + wasm_lane_const(width, "-0.0") + "    v128.and\n    v128.or\n";
}

function wat_integer_text(text: string): string {
  let start = 0;
  if (text.len() > 0 && (text[0] == b'-' || text[0] == b'+')) {
    start = 1;
  }
  if (text.len() > start + 2 && text[start] == b'0' && text[start + 1] == b'X') {
    return slice_unchecked(text, 0, start) + "0x" + slice_unchecked(text, start + 2, text.len());
  }
  return text;
}

function wasm_text_const(o: ir.Op): string {
  if (o.width != ir.width_ptr()) {
    return o.str;
  }
  let fits = ast.magnitude_fits(o.str, 0, "4294967295");
  if (ast.is_hex_lit(o.str)) {
    fits = ast.magnitude_fits(o.str, 2, "ffffffff");
  }
  if (!fits) {
    eprint("error: literal " + o.str + " does not fit in usize on wasm32, where usize is 32 bits");
    exit(1);
  }
  return o.str;
}

// Wasm has no device memory, so an MMIO access is an ordinary access to
// linear memory, and a fence has nothing to order. A store and a fence leave the
// void placeholder. No wasm environment grants a privileged op.
function mmio_wat(o: ir.Op): string {
  if (o.kind_tag == ir.K_FENCE) {
    return "    i32.const 0\n";
  }
  if (ir.is_privileged_kind(o.kind_tag) || o.kind_tag == ir.K_PORT_IN || o.kind_tag == ir.K_PORT_OUT) {
    return "    unreachable\n";
  }
  if (o.kind_tag == ir.K_MMIO_LOAD) {
    return match (o.width) {
      8 => "    i32.load8_u\n",
      16 => "    i32.load16_u\n",
      64 => "    i64.load\n",
      _ => "    i32.load\n",
    };
  }
  return match (o.width) {
    8 => "    i32.store8\n    i32.const 0\n",
    16 => "    i32.store16\n    i32.const 0\n",
    64 => "    i64.store\n    i32.const 0\n",
    _ => "    i32.store\n    i32.const 0\n",
  };
}

// fern-lint: allow cyclomatic-complexity
function emit_ir_op(o: ir.Op, cx: WasmOpCtx): string {
  if (ir.is_lane_kind(o.kind_tag)) {
    return emit_wasm_lane(o, cx);
  }
  let parts: string[] = [];
  let ns = cx.ns;
  let caggs = cx.caggs;
  let structs = cx.structs;
  let fn_table = cx.fn_table;
  let funcs = cx.funcs;
  let arrtmp = cx.base;
  let eltmp = cx.base + 1;
  let f64tmp = cx.base + 2;
  let i64tmp = cx.base + 3;
  let bctmp = cx.base + 4;
  if (o.kind_tag == ir.K_CONST_I32) {
    parts = parts.append("    i32.const " + util.i32_to_string(o.i32_imm) + "\n");
  } else if (o.kind_tag == ir.K_CONST_I32_TEXT) {
    parts = parts.append("    i32.const " + wat_integer_text(wasm_text_const(o)) + "\n");
  } else if (o.kind_tag == ir.K_CONST_I64) {
    parts = parts.append("    i64.const " + wat_integer_text(ir.const_i64_text(o)) + "\n");
  } else if (o.kind_tag == ir.K_CONST_F64) {
    parts = parts.append("    i64.const " + util.i64_to_string(ir.const_f64_bits(o)) + "\n    f64.reinterpret_i64\n");
  } else if (o.kind_tag == ir.K_I32_TO_F64) {
    parts = emit_wasm_i32_to_f64(o, parts);
  } else if (o.kind_tag == ir.K_F64_TO_I32) {
    if (o.unsigned) {
      parts = parts.append("    i32.trunc_sat_f64_u\n");
    } else {
      parts = parts.append("    i32.trunc_sat_f64_s\n");
    }
  } else if (o.kind_tag == ir.K_F64_TO_I64) {
    if (o.width == ir.width_ptr()) {
      parts = parts.append("    i32.trunc_sat_f64_u\n");
    } else if (o.unsigned) {
      parts = parts.append("    i64.trunc_sat_f64_u\n");
    } else {
      parts = parts.append("    i64.trunc_sat_f64_s\n");
    }
  } else if (o.kind_tag == ir.K_F64_BITS) {
    parts = parts.append("    i64.reinterpret_f64\n");
  } else if (o.kind_tag == ir.K_F64_FROM_BITS) {
    parts = parts.append("    f64.reinterpret_i64\n");
  } else if (o.kind_tag == ir.K_F32_BITS) {
    parts = parts.append("    f32.demote_f64\n    i32.reinterpret_f32\n");
  } else if (o.kind_tag == ir.K_F32_FROM_BITS) {
    parts = parts.append("    f32.reinterpret_i32\n    f64.promote_f32\n");
  } else if (o.kind_tag == ir.K_FROUND) {
