  o += "      (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (i32.add (local.get $start) (local.get $i)) (i32.const 4)))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $c)))\n";
