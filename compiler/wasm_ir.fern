pub function str_join_helper(): string {
  let o = "";
  o += "  (func $__fern_str_join (param $a i32) (param $sep i32) (result i32)\n";
  o += "    (local $n i32) (local $sl i32) (local $total i32) (local $i i32) (local $p i32) (local $w i32) (local $elem i32) (local $el i32) (local $j i32)\n";
