  o += "    (if (i32.gt_u (local.get $end) (i32.load (local.get $a))) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (call $__fern_abort_slice) (unreachable)))\n";
  o += "    (local.set $n (i32.sub (local.get $end) (local.get $start)))\n";
