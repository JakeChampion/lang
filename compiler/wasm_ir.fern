  o = o + "      (if (local.get $err) (then\n";
  o = o + "        (drop (call $__fern_fd_close (local.get $fd)))\n";
  o = o + "        (call $__fern_raw_free (local.get $buf) (i32.const 4096))\n";
  o = o + "        (drop (call $__fern_arr_dec_ptr (local.get $names)))\n";
  o = o + "        (return (call $__fern_rda_err (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get $path)))))))\n";
  o = o + "      (local.set $used (i32.load (i32.const 8)))\n";
  o = o + "      (br_if $rdone (i32.eqz (local.get $used)))\n";
  o = o + "      (local.set $pos (i32.const 0))\n";
  o = o + "      (local.set $lastnext (local.get $cookie))\n";
  o = o + "      (block $pdone (loop $ploop\n";
  o = o + "        (br_if $pdone (i32.gt_u (i32.add (local.get $pos) (i32.const 24)) (local.get $used)))\n";
  o = o + "        (local.set $lastnext (i64.load (i32.add (local.get $buf) (local.get $pos))))\n";
  o = o + "        (local.set $namlen (i32.load (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 16)))))\n";
  o = o + "        (br_if $pdone (i32.gt_u (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)) (local.get $used)))\n";
  o = o + "        (local.set $nameptr (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 24))))\n";
  o = o + "        (local.set $skip (i32.const 0))\n";
  o = o + "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 1)) (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46))) (then (local.set $skip (i32.const 1))))\n";
  o = o + "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 2)) (i32.and (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46)) (i32.eq (i32.load8_u (i32.add (local.get $nameptr) (i32.const 1))) (i32.const 46)))) (then (local.set $skip (i32.const 1))))\n";
  o = o + "        (if (i32.eqz (local.get $skip)) (then\n";
  o = o + "          (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $namlen))))\n";
  o = o + "          (i32.store (local.get $blk) (local.get $namlen))\n";
  o = o + "          (local.set $i (i32.const 0))\n";
  o = o + "          (block $cd (loop $cc\n";
  o = o + "            (br_if $cd (i32.ge_u (local.get $i) (local.get $namlen)))\n";
  o = o + "            (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (local.get $nameptr) (local.get $i))))\n";
  o = o + "            (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "            (br $cc)))\n";
  o = o + "          (local.set $names (call $__fern_arr_push_owned (local.get $names) (local.get $blk)))))\n";
  o = o + "        (local.set $pos (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)))\n";
