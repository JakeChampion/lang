  o = o + reactor_subscribe(3, "$__fern_wasi_udp_in_subscribe", "$__fern_wasi_udp_subscribe", 4, 8);
  o = o + reactor_subscribe(0, "$__fern_wasi_tcp_subscribe", "$__fern_wasi_tcp_subscribe", 0, 0);
