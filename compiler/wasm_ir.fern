  o += "              (i64.extend_i32_u (i32.shl (i32.sub (local.get $len) (i32.const 1)) (i32.const 3)))))\n";
  o += "            (i64.shl (i64.extend_i32_u (i32.load8_u (i32.add (local.get $k) (i32.shr_u (local.get $len) (i32.const 1)))))\n";
  o += "              (i64.extend_i32_u (i32.shl (i32.shr_u (local.get $len) (i32.const 1)) (i32.const 3))))))))))\n";
  o += "      (local.set $h (i64.mul (i64.xor (local.get $h) (local.get $w)) (i64.const 1099511628211)))))\n";
