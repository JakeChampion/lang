  o += "    (i32.store (local.get $p) (local.get $total))\n";
  o += "    (local.set $w (i32.const 0))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $dj (loop $cj\n";
  o += "      (br_if $dj (i32.ge_s (local.get $i) (local.get $n)))\n";
  o += "      (if (i32.gt_s (local.get $i) (i32.const 0)) (then\n";
  o += "        (local.set $j (i32.const 0))\n";
  o += "        (block $ds (loop $cs\n";
  o += "          (br_if $ds (i32.ge_s (local.get $j) (local.get $sl)))\n";
  o += "          (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (local.get $w) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $sep) (i32.const 4)) (local.get $j))))\n";
  o += "          (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
