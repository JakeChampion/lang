pub function needs_of(cache: irtables.LowerResult[]): string[] {
  let out: string[] = [];
  let ops: string[] = need_ops();
  let oi: i32 = 0;
  while (oi < ops.len()) {
    if (ops[oi] == "arr_push" || ops[oi] == "arr_push_owned") {
      if (module_emits_push(cache, ops[oi], false)) {
        out = out.append(ops[oi]);
      }
      if (module_emits_push(cache, ops[oi], true)) {
        out = out.append(ops[oi] + "_u8");
      }
    } else if (module_emits_op_cached(cache, ops[oi])) {
      out = out.append(ops[oi]);
    }
    oi = oi + 1;
  }
  if (module_emits_op_cached(cache, "random_i32") || module_emits_op_cached(cache, "map_hash_seed") || module_emits_op_cached(cache, "temp_dir")) {
    out = out.append("random_i32");
  }
  if (module_emits_op_cached(cache, "open_reader_with") || module_emits_op_cached(cache, "open_writer_with")) {
    out = out.append("open_with");
  }
  if (module_emits_op_cached(cache, "udp_bind_with") && !module_emits_op_cached(cache, "udp_bind")) {
    out = out.append("udp_bind");
  }
  if (module_calls_direct(cache, "__fern_set_args")) {
    out = out.append("@calls_set_args");
  }
  if (module_emits_op_cached(cache, "heap_alloc_count")) {
    out = out.append("@heap_alloc_count");
  }
  if (module_emits_op_cached(cache, "ret_word") || module_emits_op_cached(cache, "call_word")) {
    out = out.append("@ret_word");
  }
  if (module_allocates(cache)) {
    out = out.append("@allocates");
  }
  if (module_emits_op_cached(cache, "arr_get") || module_emits_op_cached(cache, "arr_set")
    || module_emits_op_cached(cache, "vget") || module_emits_op_cached(cache, "vset")) {
    out = out.append("@abort_checks");
  }
  if (module_uses_arr_slice(cache)) {
    out = out.append("@uses_arr_slice");
  }
  if (module_uses_arr_slice8(cache)) {
    out = out.append("@uses_arr_slice8");
  }
  if (module_uses_arr_slice_u8(cache)) {
    out = out.append("@uses_arr_slice_u8");
  }
  out = array_helper_needs(cache, out);
  if (module_uses_divrem(cache)) {
    out = out.append("@uses_divrem");
  }
  if (module_uses_i32_to_string(cache)) {
    out = out.append("@uses_i32_to_string");
  }
  if (module_uses_task(cache)) {
    out = out.append("@uses_task");
  }
  if (module_uses_i64_to_string(cache)) {
    out = out.append("@uses_i64_to_string");
  }
  if (module_uses_u64_to_string(cache) || module_uses_u32_to_string(cache)) {
    out = out.append("@uses_u64_to_string");
  }
  if (module_uses_u32_to_string(cache)) {
    out = out.append("@uses_u32_to_string");
  }
  if (module_uses_i64_divrem(cache)) {
    out = out.append("@uses_i64_divrem");
  }
  if (module_uses_udivrem(cache)) {
    out = out.append("@uses_udivrem");
  }
  if (module_uses_i64_udivrem(cache)) {
    out = out.append("@uses_i64_udivrem");
  }
  if (module_emits_op_cached(cache, "mulhi_u")) {
    out = out.append("@uses_mulhi_u");
  }
  if (module_uses_random(cache)) {
    out = out.append("@uses_random");
  }
  if (module_uses_str_case(cache)) {
    out = out.append("@uses_str_case");
  }
  if (module_uses_str_cmp(cache)) {
    out = out.append("@uses_str_cmp");
  }
  if (module_uses_str_lines(cache)) {
    out = out.append("@uses_str_lines");
  }
  if (module_uses_str_repeat(cache)) {
    out = out.append("@uses_str_repeat");
  }
  if (module_uses_str_replace(cache)) {
    out = out.append("@uses_str_replace");
  }
  if (module_uses_str_slice(cache)) {
    out = out.append("@uses_str_slice");
  }
  if (module_calls_direct(cache, "__fern_str_borrow") || module_uses_frame_string(cache)) {
    out = out.append("@uses_str_borrow");
  }
  if (module_uses_memchr(cache)) {
    out = out.append("@uses_memchr");
  }
  if (module_emits_op_cached(cache, "count_byte_bytes")) {
    out = out.append("@uses_count_byte_bytes");
  }
  if (module_emits_op_cached(cache, "sum_bytes_array")) {
    out = out.append("@uses_sum_bytes_array");
  }
  if (module_emits_op_cached(cache, "bsd_sum_bytes")) {
    out = out.append("@uses_bsd_sum_bytes");
  }
  if (module_emits_op_cached(cache, "memchr_bytes")) {
    out = out.append("@uses_memchr_bytes");
  }
  if (module_emits_op_cached(cache, "rmemchr_bytes")) {
    out = out.append("@uses_rmemchr_bytes");
  }
  if (module_emits_op_cached(cache, "count_runs_bytes")) {
    out = out.append("@uses_count_runs_bytes");
  }
  if (module_emits_op_cached(cache, "scan_set_bytes")) {
    out = out.append("@uses_scan_set_bytes");
  }
  if (module_emits_op_cached(cache, "mismatch_bytes")) {
    out = out.append("@uses_mismatch_bytes");
  }
  if (module_emits_op_cached(cache, "mismatch_bytes_str")) {
    out = out.append("@uses_mismatch_bytes_str");
  }
  if (module_uses_rmemchr(cache)) {
    out = out.append("@uses_rmemchr");
  }
  if (module_uses_mismatch(cache)) {
    out = out.append("@uses_mismatch");
  }
  if (module_uses_count_byte(cache)) {
    out = out.append("@uses_count_byte");
  }
  if (module_uses_sum_bytes(cache)) {
    out = out.append("@uses_sum_bytes");
  }
  if (module_uses_scan_set(cache)) {
    out = out.append("@uses_scan_set");
  }
  if (module_uses_count_runs(cache)) {
    out = out.append("@uses_count_runs");
  }
  if (module_uses_bsd_sum(cache)) {
    out = out.append("@uses_bsd_sum");
  }
  if (module_uses_str_hash(cache)) {
    out = out.append("@uses_str_hash");
  }
  if (module_uses_scale_f64(cache)) {
    out = out.append("@uses_scale_f64");
  }
  if (module_emits_op_cached(cache, "outer_mul_f64")) {
    out = out.append("@uses_outer_mul_f64");
  }
  if (module_emits_op_cached(cache, "inner_mul_add_f64")) {
    out = out.append("@uses_inner_mul_add_f64");
  }
  if (module_uses_crc32_cksum(cache)) {
    out = out.append("@uses_crc32_cksum");
  }
  if (module_emits_op_cached(cache, "crc32_cksum_array")) {
    out = out.append("@uses_crc32_cksum_array");
  }
  if (module_uses_aes_gcm(cache)) {
    out = out.append("@uses_aes_gcm");
  }
  if (module_uses_sha_hw_blocks(cache)) {
    out = out.append("@uses_sha_hw_blocks");
  }
  if (module_uses_aes_gcm(cache) || module_emits_op_cached(cache, "bswap")) {
    out = out.append("@uses_bswap");
  }
  if (module_uses_ascii_run(cache)) {
    out = out.append("@uses_ascii_run");
  }
  if (module_uses_str_trim(cache)) {
    out = out.append("@uses_str_trim");
  }
  if (module_uses_buf(cache)) {
    out = out.append("@uses_buf");
  }
  if (module_uses_strings(cache)) {
    out = out.append("@uses_strings");
  }
  return out;
}

pub function union_strs(a: string[], b: string[]): string[] {
  let out: string[] = a;
  let k: i32 = 0;
  while (k < b.len()) {
    if (util.index_of_str(out, b[k]) < 0) {
      out = out.append(b[k]);
    }
    k = k + 1;
  }
  return out;
}

pub function str_base_global(ns: string): string {
  return "$__str_base" + ns;
}

pub function fn_base_global(ns: string): string {
  return "$__fn_base" + ns;
}

pub function tid_global(name: string): string {
  return "$__tid$" + name;
}

pub function tid_get(name: string): string {
  return "    global.get " + tid_global(name) + "\n";
}

pub function tid_named(): string[] {
  return ["FileStat", "DirEntry", io_error_shape("NotFound"), io_error_shape("PermissionDenied"), io_error_shape("AlreadyExists"), io_error_shape("Interrupted"), io_error_shape("Unsupported"), io_error_shape("InvalidUtf8"), io_error_shape("Other")];
}

function io_error_shape(variant: string): string {
  return irtables.variant_shape("IoError", variant);
}

pub function tid_globals_section(structs: irtables.StructTab): string {
  let parts: string[] = [];
  let seen: string[] = [];
  let i: i32 = 0;
  while (i < structs.decls.len()) {
    let shape: string = irtables.decl_shape(structs.decls[i]);
    if (util.index_of_str(seen, shape) < 0) {
      seen = seen.append(shape);
      parts = parts.append("  (global " + tid_global(shape) + " i32 (i32.const " + util.i32_to_string(i) + "))\n");
    }
    i = i + 1;
  }
  let prims: string[] = irtables.prim_type_ids();
  let p: i32 = 0;
  while (p < prims.len()) {
    if (util.index_of_str(seen, prims[p]) < 0) {
      seen = seen.append(prims[p]);
      parts = parts.append("  (global " + tid_global(prims[p]) + " i32 (i32.const " + util.i32_to_string(irtables.prim_type_id(structs, prims[p])) + "))\n");
    }
    p = p + 1;
  }
  let named: string[] = tid_named();
  let n: i32 = 0;
  while (n < named.len()) {
    if (util.index_of_str(seen, named[n]) < 0) {
      seen = seen.append(named[n]);
      parts = parts.append("  (global " + tid_global(named[n]) + " i32 (i32.const " + util.i32_to_string(struct_type_id(structs, named[n])) + "))\n");
    }
    n = n + 1;
  }
  return util.str_join_chunks(parts);
}

pub function str_offset(vals: string[], idx: i32): i32 {
  let off: i32 = str_region_base();
  let i: i32 = 0;
  while (i < idx) {
    off = (off + 4 + vals[i].len() + 3) / 4 * 4;
    i = i + 1;
  }
  return off;
}

function offset_of_value(vals: string[], v: string): i32 {
  let i: i32 = 0;
  while (i < vals.len()) {
    if (vals[i] == v) {
      return str_offset(vals, i);
    }
    i = i + 1;
  }
  eprint("wasm-ir: string literal not interned: " + v);
  exit(1);
  return 0 - 1;
}

pub function const_agg_values(cache: irtables.LowerResult[]): string[] {
  let vals: string[] = [];
  let fi: i32 = 0;
  while (fi < cache.len()) {
    let r: irtables.LowerResult = cache[fi];
    let i: i32 = 0;
    while (i < r.ops.len()) {
      if (r.ops[i].kind_tag == 218) {
        vals = intern_const_agg(vals, r.ops[i].str);
      }
      if (answers_empty_bytes(r.ops[i]) && util.index_of_str(vals, empty_bytes_const()) < 0) {
        vals = vals.append(empty_bytes_const());
      }
      i = i + 1;
    }
    fi = fi + 1;
  }
  return vals;
}

function answers_empty_bytes(o: ir.Op): boolean {
  return o.kind_tag == 77 || o.kind_tag == 149 && (o.str == "__fern_bytes_owned" || o.str == "__fern_bytes_range");
}

function intern_const_agg(vals: string[], packed: string): string[] {
  if (util.index_of_str(vals, packed) >= 0) {
    return vals;
  }
  if (ir.const_struct_is_bytes(packed)) {
    return vals.append(packed);
  }
  for v in ir.const_struct_values(packed) {
    let inner: string = ir.const_struct_ref(v);
    if (inner.len() > 0 && !ir.const_struct_is_str(inner)) {
      vals = intern_const_agg(vals, inner);
    }
  }
  return vals.append(packed);
}

pub function const_agg_block_bytes(packed: string): i32 {
  if (ir.const_struct_fn_body(packed).len() > 0) {
    return 24;
  }
  if (ir.const_struct_is_bytes(packed)) {
    return 16 + (byteconst.count_words(ir.const_struct_payload(packed)) + 7) / 8 * 8;
  }
  if (ir.const_struct_is_option(packed)) {
    return 16;
  }
  if (ir.const_struct_is_wide_array(packed)) {
    return 16 + ir.const_struct_values(packed).len() * 8;
  }
  if (ir.const_struct_is_array(packed)) {
    return 16 + (ir.const_struct_values(packed).len() + 1) / 2 * 8;
  }
  return 16 + ir.const_struct_values(packed).len() * 8;
}

pub function const_agg_rel(cv: string[], idx: i32): i32 {
  let off: i32 = 0;
  let i: i32 = 0;
  while (i < idx) {
    off = off + const_agg_block_bytes(cv[i]);
    i = i + 1;
  }
  return off;
}

pub function const_agg_region_base(sv: string[]): i32 {
  return (str_offset(sv, sv.len()) + 7) / 8 * 8;
}

pub function const_agg_offset(sv: string[], cv: string[], idx: i32): i32 {
  return const_agg_region_base(sv) + const_agg_rel(cv, idx);
}

pub function fl_base_for_strs(sv: string[], cv: string[]): i32 {
  return const_agg_offset(sv, cv, cv.len());
}

pub function large_fl_base_for_strs(sv: string[], cv: string[]): i32 {
  return fl_base_for_strs(sv, cv) + fl_cells() * 4;
}

function heap_align8(n: i32): i32 {
  return (n + 7) / 8 * 8;
}

pub function heap_base_for_strs(sv: string[], cv: string[]): i32 {
  return heap_align8(large_fl_base_for_strs(sv, cv) + large_fl_cells() * 4);
}

pub function memory_min_pages(sv: string[], cv: string[]): i32 {
  let need: i32 = (heap_base_for_strs(sv, cv) + 65535) / 65536;
  if (need < 16) {
    return 16;
  }
  return need;
}

pub function cagg_base_global(ns: string): string {
  return "$__cagg_base" + ns;
}

pub function any_op(cache: irtables.LowerResult[], pred: (ir.Op) => boolean): boolean {
  let fi: i32 = 0;
  while (fi < cache.len()) {
    let r: irtables.LowerResult = cache[fi];
    let i: i32 = 0;
    while (i < r.ops.len()) {
      if (pred(r.ops[i])) {
        return true;
      }
      i = i + 1;
    }
    fi = fi + 1;
  }
  return false;
}

pub function module_uses_strings(cache: irtables.LowerResult[]): boolean {
  function is_string_use(o: ir.Op): boolean {
    return o.kind_tag == 5 || o.kind_tag == 97 || o.kind_tag == 98
      || o.kind_tag == 99 || o.kind_tag == 100
      || o.kind_tag == 101 || o.kind_tag == 102;
  }
  return any_op(cache, is_string_use);
}

pub function module_uses_str_cmp(cache: irtables.LowerResult[]): boolean {
  function is_str_cmp(o: ir.Op): boolean {
    return o.kind_tag == 100;
  }
  return any_op(cache, is_str_cmp);
}

pub function module_uses_memchr(cache: irtables.LowerResult[]): boolean {
  function is_memchr(o: ir.Op): boolean {
    return o.kind_tag == 225;
  }
  return any_op(cache, is_memchr);
}

pub function module_uses_mismatch(cache: irtables.LowerResult[]): boolean {
  function is_mismatch(o: ir.Op): boolean {
    return o.kind_tag == 245;
  }
  return any_op(cache, is_mismatch);
}

