// The helper consumes the array. A unique array becomes the string in its own
// block. The length stays at offset 0, and the bytes move down four bytes.
pub function string_from_bytes_helper(): string {
  let o = "";
  o += "  (func $__fern_string_from_bytes (param $arr i32) (result i32)\n";
  o += "    (local $n i32) (local $s i32)\n";
  o += "    (local.set $n (i32.load (local.get $arr)))\n";
  o += "    (if (call $__fern_rc_is_unique (local.get $arr)) (then\n";
  o += "      (memory.copy (i32.add (local.get $arr) (i32.const 4)) (i32.add (local.get $arr) (i32.const 8)) (local.get $n))\n";
  o += "      (return (local.get $arr))))\n";
  o += "    (local.set $s (call $__fern_str_box (i32.add (i32.const 4) (local.get $n))))\n";
  o += "    (i32.store (local.get $s) (local.get $n))\n";
  o += "    (memory.copy (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $arr) (i32.const 8)) (local.get $n))\n";
  o += "    (drop (call $__fern_arr_dec (local.get $arr)))\n";
  o += "    (local.get $s))\n";
  return o;
}

pub function string_from_bytes_range_helper(): string {
  let o = "";
  o += "  (func $__fern_string_from_bytes_range (param $arr i32) (param $from i32) (param $end i32) (result i32)\n";
  o += "    (local $n i32) (local $s i32)\n";
  o += "    (if (i32.gt_u (local.get $end) (i32.load (local.get $arr))) (then (call $__fern_abort_slice) (unreachable)))\n";
