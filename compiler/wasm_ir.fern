    o = o + "    (if (i32.lt_s (local.get $" + dim + ") (i32.const 0)) (then (call $__fern_abort_arr) (unreachable)))\n";
  }
  o += "    (if (i64.ne (i64.mul (i64.extend_i32_u (local.get $rows)) (i64.extend_i32_u (local.get $extent))) (i64.extend_i32_u (i32.load (local.get $a)))) (then (call $__fern_abort_arr) (unreachable)))\n";
