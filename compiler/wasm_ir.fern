function desc_shim(name: string, extra: string, files: boolean, method: string, args: string, bytes: string, code_off: string): string {
  let stat: boolean = name == "fd_filestat_get";
  let o: string = "  (func $__fern_" + name + " (param $fd i32) " + extra + " (result i32)\n";
  o = o + "    (local $slot i32) (local $ra i32) (local $err i32)\n";
  o = o + "    (local.set $slot (call $__fern_fdt_slot (local.get $fd)))\n";
