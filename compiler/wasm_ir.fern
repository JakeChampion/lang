  o += "      (i32.store8 (local.get $p) (i32.wrap_i64 (i64.add (i64.const 48) (i64.rem_u (local.get $mag) (i64.const 10)))))\n";
  o += "      (local.set $mag (i64.div_u (local.get $mag) (i64.const 10)))\n";
