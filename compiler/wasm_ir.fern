pub function tcp_listen_func(): string {
  return tcp_listen_wat("$__fern_tcp_listen", "(param $port i32)", false);
}

pub function tcp_listen_with_func(): string {
  return tcp_listen_wat("$__fern_tcp_listen_with", "(param $addr i32) (param $port i32) (param $backlog i32) (param $reuse i32)", true);
}

function tcp_listen_step(call: string): string {
  let o = "";
  o = o + "    " + call + "\n";
  o += "    (if (i32.load8_u (local.get $ret)) (then\n";
  o += "      (call $__fern_wasi_tcp_socket_drop (local.get $sock))\n";
  o += "      (local.set $e (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=1 (local.get $ret)))))\n";
  o += "      (call $__fern_raw_free (local.get $ret) (i32.const 20))\n";
  o += "      (return (local.get $e))))\n";
  return o;
}

function tcp_listen_wat(name: string, params: string, with_backlog: boolean): string {
  let o = "";
  o = o + "  (func " + name + " " + params + " (result i32)\n";
  o += "    (local $sock i32) (local $ret i32) (local $st i32) (local $e i32) (local $flat i32) (local $tmp i32)\n";
  if (with_backlog) {
    o += ip_flat_prologue();
  }
  o += "    (local.set $ret (call $__fern_alloc (i32.const 20)))\n";
  if (with_backlog) {
    o += "    (call $__fern_wasi_create_tcp_socket (i32.load (local.get $flat)) (local.get $ret))\n";
  } else {
    o += "    (call $__fern_wasi_create_tcp_socket (i32.const 0) (local.get $ret))\n";
  }
  o += "    (if (i32.load8_u (local.get $ret)) (then\n";
  o += "      (local.set $e (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=4 (local.get $ret)))))\n";
  o += "      (call $__fern_raw_free (local.get $ret) (i32.const 20))\n";
  o += "      (return (local.get $e))))\n";
  o += "    (local.set $sock (i32.load offset=4 (local.get $ret)))\n";
  if (with_backlog) {
    o = o + "    (call $__fern_wasi_tcp_start_bind (local.get $sock) (call $__fern_network_handle)\n" + ip_flat_words() + "      (local.get $ret))\n";
    o += tcp_listen_step("");
  } else {
    o = o + tcp_listen_step("(call $__fern_wasi_tcp_start_bind (local.get $sock) (call $__fern_network_handle)\n"
      + "      (i32.const 0) (local.get $port)\n"
      + "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n"
      + "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n"
      + "      (local.get $ret))");
  }
  o += tcp_listen_step("(call $__fern_wasi_tcp_finish_bind (local.get $sock) (local.get $ret))");
  if (with_backlog) {
    o += tcp_listen_step("(call $__fern_wasi_tcp_set_listen_backlog_size (local.get $sock) (i64.extend_i32_u (local.get $backlog)) (local.get $ret))");
  }
  o += tcp_listen_step("(call $__fern_wasi_tcp_start_listen (local.get $sock) (local.get $ret))");
  o += tcp_listen_step("(call $__fern_wasi_tcp_finish_listen (local.get $sock) (local.get $ret))");
  o += "    (local.set $st (local.get $ret))\n";
  o += "    (i32.store (local.get $st) (local.get $sock))\n";
  o += "    (i32.store offset=4 (local.get $st) (i32.const 0))\n";
  o += "    (i32.store offset=8 (local.get $st) (i32.const 0))\n";
  o += "    (i32.store offset=12 (local.get $st) (i32.const 0))\n";
  o += "    (i32.store offset=16 (local.get $st) (i32.const 0))\n";
  o += "    (local.get $st))\n";
  return o;
}

// tcp_addr_into_func fills out with the 19-byte sender record udp_recvfrom
// writes: the family, the address in network order, then the port.
pub function tcp_addr_into_func(udp: boolean): string {
  let o = "";
  o += "  (func $__fern_tcp_addr_into (param $c i32) (param $peer i32) (param $out i32) (result i32)\n";
  o += "    (local $ret i32) (local $e i32) (local $k i32)\n";
  o += closed_socket_guard("c");
  o += "    (if (i32.lt_u (i32.load (local.get $out)) (i32.const 19)) (then (return (i32.const -28))))\n";
  o += "    (local.set $ret (call $__fern_alloc (i32.const 36)))\n";
  let remote = "(call $__fern_wasi_tcp_remote_address (i32.load (local.get $c)) (local.get $ret))";
  let local = "(call $__fern_wasi_tcp_local_address (i32.load (local.get $c)) (local.get $ret))";
  if (udp) {
    let is_udp = "(i32.lt_u (i32.sub (i32.load offset=12 (local.get $c)) (i32.const 2)) (i32.const 2))";
    remote = "(if " + is_udp + " (then (call $__fern_wasi_udp_remote_address (i32.load (local.get $c)) (local.get $ret))) (else " + remote + "))";
    local = "(if " + is_udp + " (then (call $__fern_wasi_udp_local_address (i32.load (local.get $c)) (local.get $ret))) (else " + local + "))";
  }
  o = o + "    (if (local.get $peer) (then " + remote + ") (else " + local + "))\n";
  o += "    (if (i32.load8_u (local.get $ret)) (then\n";
  o += "      (local.set $e (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=4 (local.get $ret)))))\n";
  o += "      (call $__fern_raw_free (local.get $ret) (i32.const 36))\n";
  o += "      (return (local.get $e))))\n";
  o += "    (memory.fill (i32.add (local.get $out) (i32.const 8)) (i32.const 0) (i32.const 19))\n";
  o += "    (if (i32.load8_u offset=4 (local.get $ret))\n";
  o += "      (then\n";
  o += "        (i32.store8 offset=8 (local.get $out) (i32.const 6))\n";
  o += "        (loop $group\n";
  o += "          (i32.store8 offset=9 (i32.add (local.get $out) (i32.shl (local.get $k) (i32.const 1))) (i32.load8_u offset=17 (i32.add (local.get $ret) (i32.shl (local.get $k) (i32.const 1)))))\n";
  o += "          (i32.store8 offset=10 (i32.add (local.get $out) (i32.shl (local.get $k) (i32.const 1))) (i32.load8_u offset=16 (i32.add (local.get $ret) (i32.shl (local.get $k) (i32.const 1)))))\n";
  o += "          (local.set $k (i32.add (local.get $k) (i32.const 1)))\n";
  o += "          (br_if $group (i32.lt_u (local.get $k) (i32.const 8)))))\n";
  o += "      (else\n";
  o += "        (i32.store8 offset=8 (local.get $out) (i32.const 4))\n";
  o += "        (i32.store offset=9 (local.get $out) (i32.load offset=10 (local.get $ret)))))\n";
  o += "    (i32.store8 offset=25 (local.get $out) (i32.load8_u offset=9 (local.get $ret)))\n";
  o += "    (i32.store8 offset=26 (local.get $out) (i32.load8_u offset=8 (local.get $ret)))\n";
  o += "    (call $__fern_raw_free (local.get $ret) (i32.const 36))\n";
  o += "    (i32.const 19))\n";
  return o;
}

