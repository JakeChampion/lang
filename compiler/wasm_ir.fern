    o = o + "    (i32.load (i32.add (local.get $h) (i32.const 4))))\n";
  }
  if (need(needs, "buf_clear")) {
    o = o + "  (func $__fern_buf_clear (param $h i32)\n";
    o = o + "    (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.const 0)))\n";
  }
  if (need(needs, "buf_take")) {
    o = o + buf_text_helpers();
  }
  if (need(needs, "buf_free")) {
    o = o + "  (func $__fern_buf_free (param $h i32)\n";
    o = o + "    (if (i32.eqz (local.get $h)) (then (return)))\n";
    o = o + "    (if (i32.load (local.get $h)) (then (drop (call $__fern_arr_dec (i32.load (local.get $h))))))\n";
    o = o + "    (drop (call $__fern_arr_dec (local.get $h))))\n";
  }
  return o;
}

pub function divrem_helpers(): string {
  let bad: string = "(i32.or (i32.eqz (local.get $b))"
    + " (i32.and (i32.eq (local.get $a) (i32.const -2147483648))"
    + " (i32.eq (local.get $b) (i32.const -1))))";
  let parts: string[] = [];
  parts = parts.append("  (func $__fern_idiv (param $a i32) (param $b i32) (result i32)\n");
  parts = parts.append("    (local $safe i32)\n");
  parts = parts.append("    (local.set $safe (select (i32.const 1) (local.get $b) " + bad + "))\n");
  parts = parts.append("    (select (i32.const 0) (i32.div_s (local.get $a) (local.get $safe)) (i32.eqz (local.get $b))))\n");
  parts = parts.append("  (func $__fern_irem (param $a i32) (param $b i32) (result i32)\n");
  parts = parts.append("    (local $safe i32)\n");
  parts = parts.append("    (local.set $safe (select (i32.const 1) (local.get $b) " + bad + "))\n");
  parts = parts.append("    (select (local.get $a) (i32.rem_s (local.get $a) (local.get $safe)) (i32.eqz (local.get $b))))\n");
  return util.str_join_chunks(parts);
}

