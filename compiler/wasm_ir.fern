    o += "    (block $ed (loop $el (br_if $ed (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $c (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const " + offset + ")) (local.get $i))))\n";
    o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o += "      (if (i32.lt_u (local.get $c) (local.get $m))\n";
    o += "        (then\n";
    o += "          (local.set $r (i32.add (i32.add (local.get $t) (i32.const 8)) (i32.mul (local.get $c) (i32.const 8))))\n";
    o += "          (local.set $l (i32.load8_u (local.get $r)))\n";
    o += "          (if (i32.gt_u (local.get $l) (i32.const 7)) (then (local.set $l (i32.const 7))))\n";
    o += "          (local.set $k (i32.const 0))\n";
    o += "          (block $bd (loop $bl (br_if $bd (i32.ge_u (local.get $k) (local.get $l)))\n";
    o += "            (i32.store8 (i32.add (local.get $d) (local.get $j)) (i32.load8_u offset=1 (i32.add (local.get $r) (local.get $k))))\n";
    o += "            (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o += "            (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $bl))))\n";
    o += "        (else\n";
    o += "          (i32.store8 (i32.add (local.get $d) (local.get $j)) (local.get $c))\n";
    o += "          (local.set $j (i32.add (local.get $j) (i32.const 1)))))\n";
    o += "      (br $el)))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.add (local.get $len) (local.get $j))))\n";
  }
