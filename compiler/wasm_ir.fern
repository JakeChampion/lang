pub function component_io_imports(needs: string[], stderr: boolean, proxy: boolean): string {
  let o: string = "  (import \"wasi:io/error@0.2.0\" \"[resource-drop]error\" (func $__fern_io_error_drop (param i32)))\n";
  if (stderr) {
    o = o + "  (import \"wasi:cli/stderr@0.2.0\" \"get-stderr\" (func $__fern_get_stderr (result i32)))\n";
    o = o + "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.blocking-write-and-flush\" (func $__fern_bwf (param i32 i32 i32 i32)))\n";
    o = o + "  (import \"wasi:cli/stdout@0.2.0\" \"get-stdout\" (func $__fern_get_stdout (result i32)))\n";
  } else {
    o = o + "  (import \"wasi:cli/stdout@0.2.0\" \"get-stdout\" (func $__fern_get_stdout (result i32)))\n";
    o = o + "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.blocking-write-and-flush\" (func $__fern_bwf (param i32 i32 i32 i32)))\n";
  }
  if (need(needs, "exit") && !proxy) {
    o = o + "  (import \"wasi:cli/exit@0.2.0\" \"exit\" (func $__fern_exit (param i32)))\n";
  }
  if (need(needs, "@uses_random")) {
    o = o + random_imports_p2();
  }
  if (needs_wall_clock(needs) || need(needs, "monotonic_ns")) {
    o = o + clock_imports_p2(needs_wall_clock(needs), need(needs, "monotonic_ns"));
  }
  if (need(needs, "clock_resolution")) {
    o = o + "  (import \"wasi:clocks/wall-clock@0.2.0\" \"resolution\" (func $__fern_wall_resolution (param i32)))\n";
  }
  if (need(needs, "args")) {
    o = o + args_imports_p2();
  }
  if (need(needs, "@proxy") && need(needs, "env")) {
    o = o + config_imports_p2();
  } else if (need(needs, "env") || need(needs, "environ")) {
    o = o + env_imports_p2();
  }
  return o + fs_imports_p2(needs);
}

pub function component_uses_stderr(mod: parser.Module, needs: string[]): boolean {
  return needs_abort(needs) || need(needs, "eprint_str") || called_names(mod).has("stderr");
}

pub function needs_abort(needs: string[]): boolean {
  return need(needs, "@allocates") || need(needs, "@abort_checks");
}

function runtime_needs(mod: parser.Module, needs: string[]): string[] {
  if (module_extern_needs_heap(mod) && !needs_abort(needs)) {
    return needs.append("@abort_checks");
  }
  return needs;
}

pub function needs_wall_clock(needs: string[]): boolean {
  return need(needs, "now_ns") || need(needs, "now_unix_ms");
}

function fd_write_handle(stderr: boolean, table: boolean): string {
  let o: string = "";
  let pre: string = "    ";
  if (table) {
    o = o + "    (local.set $slot (call $__fern_fdt_slot (local.get $fd)))\n";
    o = o + "    (if (i32.eqz (local.get $slot)) (then (return (i32.const 8))))\n";
    o = o + "    (if (i32.eqz (i32.and (i32.load offset=12 (local.get $slot)) (i32.const 2))) (then (return (i32.const 8))))\n";
    o = o + "    (if (i32.ge_u (local.get $fd) (i32.const 3)) (then (local.set $h (i32.load offset=4 (local.get $slot)))) (else\n";
    pre = "      ";
  } else {
    o = o + "    (if (i32.and (i32.ne (local.get $fd) (i32.const 1)) (i32.ne (local.get $fd) (i32.const 2))) (then (return (i32.const 8))))\n";
  }
  if (!stderr) {
    o = o + pre + "(if (i32.eq (local.get $fd) (i32.const 2)) (then (return (i32.const 8))))\n";
  }
  if (stderr) {
    o = o + pre + "(if (i32.eq (local.get $fd) (i32.const 2))\n";
    o = o + pre + "  (then\n";
    o = o + pre + "    (if (i32.eq (global.get $__stderr_handle) (i32.const -1))\n";
    o = o + pre + "      (then (global.set $__stderr_handle (call $__fern_get_stderr))))\n";
    o = o + pre + "    (local.set $h (global.get $__stderr_handle)))\n";
    o = o + pre + "  (else\n";
    o = o + pre + "    (if (i32.eq (global.get $__stdout_handle) (i32.const -1))\n";
    o = o + pre + "      (then (global.set $__stdout_handle (call $__fern_get_stdout))))\n";
    o = o + pre + "    (local.set $h (global.get $__stdout_handle))))\n";
  } else {
    o = o + pre + "(if (i32.eq (global.get $__stdout_handle) (i32.const -1))\n";
    o = o + pre + "  (then (global.set $__stdout_handle (call $__fern_get_stdout))))\n";
    o = o + pre + "(local.set $h (global.get $__stdout_handle))\n";
  }
  if (table) {
    o = o + "    ))\n";
  }
  return o;
}

function proxy_exit_shim(): string {
  return "  (func $__fern_proc_exit (param $c i32)\n    (unreachable))\n";
}

pub function component_io_shims(needs: string[], stderr: boolean, proxy: boolean, lc: boolean): string {
  let o: string = "  (global $__stdout_handle (mut i32) (i32.const -1))\n";
  if (stderr) {
    o = o + "  (global $__stderr_handle (mut i32) (i32.const -1))\n";
  }
  let table: boolean = need_fd_table(needs);
  let advance: string = "";
  let slot_local: string = "";
  if (table) {
    advance = "(call $__fern_fdt_advance (local.get $slot) (local.get $total)) ";
    slot_local = " (local $slot i32)";
  }
  o = o + "  (func $__fern_fd_write (param $fd i32) (param $iovs i32) (param $iovn i32) (param $nw i32) (result i32)\n";
  o = o + "    (local $h i32) (local $len i32) (local $ret i32) (local $scratch i32) (local $ptr i32) (local $at i32) (local $chunk i32) (local $vec i32) (local $total i32)" + slot_local + "\n";
  o = o + "    (i32.store (local.get $nw) (i32.const 0))\n";
  o = o + fd_write_handle(stderr, table);
  o = o + "    (local.set $scratch (call $__fern_str_box (i32.const 24)))\n";
  o = o + "    (local.set $ret (i32.and (i32.add (local.get $scratch) (i32.const 7)) (i32.const -8)))\n";
  o = o + "    (block $vectors_done (loop $vectors\n";
  o = o + "      (br_if $vectors_done (i32.ge_u (local.get $vec) (local.get $iovn)))\n";
  o = o + "      (local.set $ptr (i32.load (local.get $iovs)))\n";
  o = o + "      (local.set $len (i32.load offset=4 (local.get $iovs))) (local.set $at (i32.const 0))\n";
  o = o + "      (block $chunks_done (loop $chunks\n";
  o = o + "        (local.set $chunk (i32.sub (local.get $len) (local.get $at)))\n";
  o = o + "        (if (i32.gt_u (local.get $chunk) (i32.const 4096)) (then (local.set $chunk (i32.const 4096))))\n";
  o = o + "        (call $__fern_bwf (local.get $h) (i32.add (local.get $ptr) (local.get $at)) (local.get $chunk) (local.get $ret))\n";
  o = o + "        (if (i32.load8_u (local.get $ret)) (then\n";
  o = o + "          (if (i32.eqz (i32.load8_u offset=4 (local.get $ret))) (then (call $__fern_io_error_drop (i32.load offset=8 (local.get $ret)))))\n";
  o = o + "          (drop (call $__fern_arr_dec (local.get $scratch)))\n";
  o = o + "          " + advance + "(i32.store (local.get $nw) (local.get $total)) (return (i32.const 29))))\n";
  o = o + "        (local.set $at (i32.add (local.get $at) (local.get $chunk)))\n";
  o = o + "        (local.set $total (i32.add (local.get $total) (local.get $chunk)))\n";
  o = o + "        (br_if $chunks_done (i32.eq (local.get $at) (local.get $len))) (br $chunks)))\n";
  o = o + "      (local.set $vec (i32.add (local.get $vec) (i32.const 1)))\n";
  o = o + "      (local.set $iovs (i32.add (local.get $iovs) (i32.const 8))) (br $vectors)))\n";
  o = o + "    (drop (call $__fern_arr_dec (local.get $scratch)))\n";
  o = o + "    " + advance + "(i32.store (local.get $nw) (local.get $total))\n";
  o = o + "    (i32.const 0))\n";
  if (need(needs, "exit") && proxy) {
    o = o + proxy_exit_shim();
  } else if (need(needs, "exit")) {
    o = o + "  (func $__fern_proc_exit (param $c i32)\n" + lc_exit_report(lc);
    o = o + "    (call $__fern_exit (i32.ne (local.get $c) (i32.const 0)))\n";
    o = o + "    (unreachable))\n";
  }
  if (needs_wall_clock(needs) || need(needs, "monotonic_ns")) {
    o = o + clock_funcs_p2(needs_wall_clock(needs), need(needs, "monotonic_ns"));
  }
  if (need(needs, "clock_resolution")) {
    o = o + clock_resolution_func_p2();
  }
  if (need(needs, "random_bytes") || need(needs, "random_i32")) {
    o = o + random_func_p2();
  }
  if (need(needs, "env")) {
    if (need(needs, "@proxy")) {
      o = o + config_env_func_p2();
    } else {
      o = o + env_func_p2();
    }
  }
  if (need(needs, "environ")) {
    o = o + environ_func_p2();
  }
  if (need(needs, "args")) {
    o = o + args_func_p2(need(needs, "@calls_set_args"));
  }
  if (need_read_file(needs) || need_write_file(needs) || need_any(needs, component_fs_needs())) {
    o = o + errno_p2_func();
  }
  if (need_read_file(needs) || need_write_file(needs)) {
    o = o + build_io_error_p2_func();
  }
  o = o + component_fs_shims(needs, stderr);
  if (need_read_file(needs) && !need_open_file(needs)) {
    o = o + is_dir_at_func_p2();
  }
  if (need(needs, "read_file")) {
    o = o + readfile_func_p2();
  }
  if (need(needs, "read_file_bytes")) {
    o = o + readfile_bytes_func_p2();
  }
  if (need(needs, "write_file")) {
    o = o + writefile_func_p2();
  }
  if (need(needs, "write_file_bytes")) {
    o = o + writefile_bytes_func(true);
  }
  return o;
}

pub function emit_ir_module_mode(mod: parser.Module, ir_cache: irtables.LowerResult[], mode: i32, sw: asmcore.Switches, physical: physicalbody.Collection): string {
  ircore.check_fip_claims(mod.funcs, 0, mod.funcs.len(), ir_cache);
  let sv: string[] = str_values(ir_cache);
  let cv: string[] = const_agg_values(ir_cache);
  let ft: string[] = fn_value_table(ir_cache);
  let unit: string = emit_functions_ns("", mod, ir_cache, physical);
  let needs: string[] = needs_of(ir_cache);
  if (mode == 2 && module_is_proxy(mod)) {
    needs = needs.append("@proxy");
  }
  if (mode == 2 && calls_any(called_names(mod), stdin_builtins())) {
    needs = needs.append("@stdin");
  }
  return emit_ir_module_units(
    [WasmUnit { ns: "", text: unit, strs: sv, caggs: cv, fns: ft }], mod,
    needs, indirect_fn_sigs(ir_cache), mode, sw,
  );
}

pub function ir_route_ok(lm: parser.Module, component: boolean, io: boolean, sub: ircore.Sub): boolean {
  let g: ircore.Lowered = ircore.gate(ircore.with_records(lm, sub), sub);
  return g.ok && ir_route_final(g.cache, component, io, module_is_proxy(lm));
}

pub function ir_route_final(cache: irtables.LowerResult[], component: boolean, io: boolean, proxy: boolean): boolean {
  return wasm_ir_deferrals_ok(cache) && (!component || component_refused_need(needs_of(cache), io, proxy) == "");
}

pub function emit_module_mode_or_error_sub(mod: parser.Module, component: boolean, io: boolean, sub: ircore.Sub): string {
  return emit_core_or_error_sub(mod, component, io, sub).wat;
}

pub struct EmittedCore { wat: string, needs: string[] }

pub function emit_core_or_error_sub(mod: parser.Module, component: boolean, io: boolean, sub: ircore.Sub): EmittedCore {
  let lm: parser.Module = ircore.with_records(route_normalized(mod), sub);
  let bad_import: string = wasm_unsupported_import(lm);
  if (bad_import.len() > 0) {
    eprint(bad_import);
    exit(1);
  }
  let mode: i32 = 0;
  if (component) {
    mode = 1;
    if (io) {
      mode = 2;
    }
  }
  let g: ircore.Lowered = ircore.gate(lm, sub);
  let cache: irtables.LowerResult[] = g.cache;
  if (g.ok && ir_route_final(cache, component, io, module_is_proxy(lm))) {
    return EmittedCore { wat: emit_ir_module_mode(lm, cache, mode, sub.switches, g.physical), needs: runtime_needs(lm, needs_of(cache)) };
  }
  if (g.ok && component && wasm_ir_deferrals_ok(cache)) {
    eprint("error: " + component_refused_need(needs_of(cache), io, module_is_proxy(lm))
      + " is not supported in a wasm component: the component framing has no import for it (build with -emit core-module for a preview1 module)");
    exit(1);
  }
  ircore.eprint_ir_ineligible();
  exit(1);
  return EmittedCore { wat: "", needs: [] };
}

