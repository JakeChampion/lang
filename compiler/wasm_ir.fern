  o += "      (if (i64.lt_s (local.get $asec) (i64.const 0)) (then (local.set $err (i32.const 61))))))\n";
  o += "    (if (i32.eqz (i32.and (local.get $flags) (i32.const 20))) (then\n";
  o += "      (if (i64.lt_s (local.get $msec) (i64.const 0)) (then (local.set $err (i32.const 61))))))\n";
  o += "    (if (i32.eqz (local.get $err)) (then\n";
  o += "      (local.set $fst (i32.const 0))\n";
  o += "      (if (i32.eqz (i32.and (local.get $flags) (i32.const 2))) (then\n";
  o += "        (if (i32.and (local.get $flags) (i32.const 8)) (then (local.set $fst (i32.or (local.get $fst) (i32.const 2)))) (else (local.set $fst (i32.or (local.get $fst) (i32.const 1)))))))\n";
  o += "      (if (i32.eqz (i32.and (local.get $flags) (i32.const 4))) (then\n";
  o += "        (if (i32.and (local.get $flags) (i32.const 16)) (then (local.set $fst (i32.or (local.get $fst) (i32.const 8)))) (else (local.set $fst (i32.or (local.get $fst) (i32.const 4)))))))\n";
  o += "      (local.set $lf (i32.const 1))\n";
  o += "      (if (i32.and (local.get $flags) (i32.const 1)) (then (local.set $lf (i32.const 0))))\n";
  o += "      (local.set $err (call $__fern_path_filestat_set_times (i32.const 3) (local.get $lf) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path))";
  o += " (i64.add (i64.mul (local.get $asec) (i64.const 1000000000)) (local.get $ansec))";
  o += " (i64.add (i64.mul (local.get $msec) (i64.const 1000000000)) (local.get $mnsec))";
  o += " (local.get $fst)))))\n";
  o += path_result_tail("$path");
  return o;
}

function path_result_tail(pathvar: string): string {
  let o = "";
  o += "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "    (if (i32.eq (local.get $err) (i32.const 0)) (then\n";
  o += "      (i32.store (local.get $res) (i32.const 0))\n";
  o += "      (i32.store (i32.add (local.get $res) (i32.const 4)) (i32.const 0))\n";
  o += "      (return (local.get $res))))\n";
  o += "    (i32.store (local.get $res) (i32.const 1))\n";
  o = o + "    (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get " + pathvar + "))))\n";
  o += "    (local.get $res))\n";
  return o;
}

pub function read_link_func(): string {
  return read_link_payload_func(false) + read_link_payload_func(true);
}

function read_link_payload_func(raw: boolean): string {
  let o = "";
  let name = "__fern_read_link";
  if (raw) {
    name = "__fern_read_link_bytes";
  }
  o = o + "  (func $" + name + " (param $path i32) (result i32)\n";
  o += "    (local $err i32) (local $res i32) (local $buf i32) (local $used i32) (local $blk i32) (local $i i32)\n";
  o += "    (local.set $used (call $__fern_str_box (i32.const 4)))\n";
  o += "    (local.set $buf (call $__fern_str_box (i32.const 4096)))\n";
  o += "    (local.set $err (call $__fern_path_readlink (i32.const 3) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path)) (local.get $buf) (i32.const 4096) (local.get $used)))\n";
  o += "    (if (i32.eqz (local.get $err)) (then\n";
  o += "      (if (i32.ge_u (i32.load (local.get $used)) (i32.const 4096)) (then (local.set $err (i32.const 37))))))\n";
  if (!raw) {
    o += "    (if (i32.eqz (local.get $err)) (then (if (i32.eqz (call $__fern_utf8_valid (local.get $buf) (i32.load (local.get $used)))) (then (local.set $err (i32.const 25))))))\n";
  }
  o += "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
  o += "      (drop (call $__fern_arr_dec (local.get $used)))\n";
  o += "      (drop (call $__fern_arr_dec (local.get $buf)))\n";
  o += "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $res) (i32.const 1))\n";
  o += "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get $path))))\n";
  o += "      (return (local.get $res))))\n";
  let offset = "4";
  if (raw) {
    offset = "8";
    o += "    (local.set $blk (call $__fern_arr_elems (i32.load (local.get $used)) (i32.const 1)))\n";
    o += "    (i32.store (i32.add (local.get $blk) (i32.const 4)) (i32.load (local.get $used)))\n";
  } else {
    o += "    (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (i32.load (local.get $used)))))\n";
  }
  o += "    (i32.store (local.get $blk) (i32.load (local.get $used)))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $rd (loop $rl\n";
  o += "      (br_if $rd (i32.ge_u (local.get $i) (i32.load (local.get $used))))\n";
  o = o + "      (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const " + offset + ")) (local.get $i)) (i32.load8_u (i32.add (local.get $buf) (local.get $i))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $rl)))\n";
  o += "    (drop (call $__fern_arr_dec (local.get $used)))\n";
  o += "    (drop (call $__fern_arr_dec (local.get $buf)))\n";
  o += "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $res) (i32.const 0))\n";
  o += "    (i32.store (i32.add (local.get $res) (i32.const 4)) (local.get $blk))\n";
  o += "    (local.get $res))\n";
  return o;
}

pub function create_dir_all_func(): string {
  let o = "";
  o += "  (func $__fern_create_dir_all (param $path i32) (result i32)\n";
  o += "    (local $err i32) (local $res i32) (local $len i32) (local $base i32) (local $j i32)\n";
  o += "    (local.set $len (i32.load (local.get $path)))\n";
  o += "    (local.set $base (i32.add (local.get $path) (i32.const 4)))\n";
  o += "    (local.set $j (i32.const 1))\n";
  o += "    (block $cdone (loop $cloop\n";
  o += "      (br_if $cdone (i32.ge_u (local.get $j) (local.get $len)))\n";
  o += "      (if (i32.and (i32.eq (i32.load8_u (i32.add (local.get $base) (local.get $j))) (i32.const 47))\n";
  o += "                   (i32.ne (i32.load8_u (i32.sub (i32.add (local.get $base) (local.get $j)) (i32.const 1))) (i32.const 47))) (then\n";
  o += "        (drop (call $__fern_path_create_directory (i32.const 3) (local.get $base) (local.get $j)))))\n";
  o += "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "      (br $cloop)))\n";
  o += "    (local.set $err (call $__fern_path_create_directory (i32.const 3) (local.get $base) (local.get $len)))\n";
  o += "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "    (if (i32.or (i32.eq (local.get $err) (i32.const 0)) (i32.eq (local.get $err) (i32.const 20))) (then\n";
  o += "      (i32.store (local.get $res) (i32.const 0))\n";
  o += "      (i32.store (i32.add (local.get $res) (i32.const 4)) (i32.const 0))\n";
  o += "      (return (local.get $res))))\n";
  o += "    (i32.store (local.get $res) (i32.const 1))\n";
  o += "    (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get $path))))\n";
  o += "    (local.get $res))\n";
  return o;
}

pub function read_dir_func(): string {
  return read_dir_func_like("__fern_read_dir", true, false, false);
}

pub function read_dir_all_func(): string {
  return read_dir_func_like("__fern_read_dir_all", false, false, false);
}

function read_dir_func_like(fname: string, skip_dots: boolean, ino: boolean, raw: boolean): string {
  let o = "";
  let tid_param = "";
  if (ino) {
    tid_param = " (param $tid i32)";
  }
  o = o + "  (func $" + fname + " (param $path i32)" + tid_param + " (result i32)\n";
  o += "    (local $err i32) (local $fd i32) (local $arr i32) (local $buf i32) (local $ent i32)\n";
  o += "    (local $cookie i64) (local $lastnext i64) (local $used i32) (local $pos i32)\n";
  o += "    (local $namlen i32) (local $nameptr i32) (local $blk i32) (local $i i32) (local $skip i32) (local $res i32)\n";
  o += "    (local.set $err (call $__fern_path_open (i32.const 3) (i32.const 1) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path)) (i32.const 0) (i64.const 16384) (i64.const 0) (i32.const 0) (i32.const 16)))\n";
  o += "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
  o += "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $res) (i32.const 1))\n";
  o += "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get $path))))\n";
  o += "      (return (local.get $res))))\n";
  o += "    (local.set $fd (i32.load (i32.const 16)))\n";
  o += "    (local.set $arr (call $__fern_arr_box (i32.const 0)))\n";
  o += "    (i32.store (local.get $arr) (i32.const 0))\n";
  o += "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (i32.const 0))\n";
  o += "    (local.set $buf (call $__fern_alloc (i32.const 4096)))\n";
  o += "    (local.set $cookie (i64.const 0))\n";
  o += "    (block $rdone (loop $rloop\n";
  o += "      (block $rerror\n";
  o += "      (local.set $err (call $__fern_fd_readdir (local.get $fd) (local.get $buf) (i32.const 4096) (local.get $cookie) (i32.const 8)))\n";
  o += "      (br_if $rerror (local.get $err))\n";
  o += "      (local.set $used (i32.load (i32.const 8)))\n";
  o += "      (br_if $rdone (i32.eqz (local.get $used)))\n";
  o += "      (local.set $pos (i32.const 0))\n";
  o += "      (local.set $lastnext (local.get $cookie))\n";
  o += "      (block $pdone (loop $ploop\n";
  o += "        (br_if $pdone (i32.gt_u (i32.add (local.get $pos) (i32.const 24)) (local.get $used)))\n";
  o += "        (local.set $lastnext (i64.load (i32.add (local.get $buf) (local.get $pos))))\n";
  o += "        (local.set $namlen (i32.load (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 16)))))\n";
  o += "        (br_if $pdone (i32.gt_u (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)) (local.get $used)))\n";
  o += "        (local.set $nameptr (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 24))))\n";
  if (!raw) {
    o += "        (if (i32.eqz (call $__fern_utf8_valid (local.get $nameptr) (local.get $namlen))) (then (local.set $err (i32.const 25)) (br $rerror)))\n";
  }
  o += "        (local.set $skip (i32.const 0))\n";
  if (skip_dots) {
    o += "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 1)) (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46))) (then (local.set $skip (i32.const 1))))\n";
    o += "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 2)) (i32.and (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46)) (i32.eq (i32.load8_u (i32.add (local.get $nameptr) (i32.const 1))) (i32.const 46)))) (then (local.set $skip (i32.const 1))))\n";
  }
  o += "        (if (i32.eqz (local.get $skip)) (then\n";
  let offset = "4";
  if (raw) {
    offset = "8";
    o += "          (local.set $blk (call $__fern_arr_elems (local.get $namlen) (i32.const 1)))\n";
    o += "          (i32.store offset=4 (local.get $blk) (local.get $namlen))\n";
  } else {
    o += "          (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $namlen))))\n";
  }
  o += "          (i32.store (local.get $blk) (local.get $namlen))\n";
  o += "          (local.set $i (i32.const 0))\n";
  o += "          (block $cd (loop $cc\n";
  o += "            (br_if $cd (i32.ge_u (local.get $i) (local.get $namlen)))\n";
  o = o + "            (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const " + offset + ")) (local.get $i)) (i32.load8_u (i32.add (local.get $nameptr) (local.get $i))))\n";
  o += "            (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "            (br $cc)))\n";
  if (ino) {
    o += "          (local.set $ent (call $__fern_str_box (i32.const 32)))\n";
    o += "          (i32.store (local.get $ent) (local.get $tid))\n";
    o += "          (i32.store offset=8 (local.get $ent) (local.get $blk))\n";
    o += "          (i64.store offset=16 (local.get $ent) (i64.load offset=8 (i32.add (local.get $buf) (local.get $pos))))\n";
    o += "          (i64.store offset=24 (local.get $ent) (i64.extend_i32_u (call $__fern_wasi_kind (i32.load8_u offset=20 (i32.add (local.get $buf) (local.get $pos))))))\n";
    o += "          (local.set $blk (local.get $ent))\n";
  }
  o += "          (local.set $arr (call $__fern_arr_push_owned (local.get $arr) (local.get $blk)))))\n";
  o += "        (local.set $pos (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)))\n";
  o += "        (br $ploop)))\n";
  o += "      (br_if $rdone (i32.lt_u (local.get $used) (i32.const 4096)))\n";
  o += "      (local.set $cookie (local.get $lastnext))\n";
  o += "      (br $rloop))\n";
  o += "        (drop (call $__fern_fd_close (local.get $fd)))\n";
  o += "        (call $__fern_raw_free (local.get $buf) (i32.const 4096))\n";
  if (ino) {
    // An entry's name is a reference of its own, which the one-level
    // element release below does not reach.
    o += "        (local.set $i (i32.const 0))\n";
    o += "        (block $nd (loop $nl\n";
    o += "          (br_if $nd (i32.ge_u (local.get $i) (i32.load (local.get $arr))))\n";
    o += "          (drop (call $__fern_arr_dec (i32.load offset=8 (i32.load (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))))\n";
    o += "          (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o += "          (br $nl)))\n";
  }
  o += "        (drop (call $__fern_arr_dec_ptr (local.get $arr)))\n";
  o += "        (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "        (i32.store (local.get $res) (i32.const 1))\n";
  o += "        (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get $path))))\n";
  o += "        (return (local.get $res))\n";
  o += "    ))\n";
  o += "    (drop (call $__fern_fd_close (local.get $fd)))\n";
  o += "    (call $__fern_raw_free (local.get $buf) (i32.const 4096))\n";
  o += "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $res) (i32.const 0))\n";
  o += "    (i32.store (i32.add (local.get $res) (i32.const 4)) (local.get $arr))\n";
  o += "    (local.get $res))\n";
  return o;
}

pub function remove_dir_all_func(p2: boolean): string {
  let o = "";
  o += "  (func $__fern_rda_ok (result i32)\n";
  o += "    (local $r i32)\n";
  o += "    (local.set $r (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $r) (i32.const 0))\n";
  o += "    (i32.store (i32.add (local.get $r) (i32.const 4)) (i32.const 0))\n";
  o += "    (local.get $r))\n";
  o += "  (func $__fern_rda_err (param $e i32) (result i32)\n";
  o += "    (local $r i32)\n";
  o += "    (local.set $r (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $r) (i32.const 1))\n";
  o += "    (i32.store (i32.add (local.get $r) (i32.const 4)) (local.get $e))\n";
  o += "    (local.get $r))\n";
  o += "  (func $__fern_remove_dir_all (param $path i32) (result i32)\n";
  o += "    (local $err i32) (local $fd i32) (local $names i32) (local $buf i32)\n";
  o += "    (local $cookie i64) (local $lastnext i64) (local $used i32) (local $pos i32)\n";
  o += "    (local $namlen i32) (local $nameptr i32) (local $blk i32) (local $i i32) (local $skip i32)\n";
  o += "    (local $plen i32) (local $nm i32) (local $child i32) (local $j i32)\n";
  if (p2) {
    o += rda_list_p2();
  } else {
    o += rda_list_p1();
  }
  o += "    (local.set $plen (i32.load (local.get $path)))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $dd (loop $dc\n";
  o += "      (br_if $dd (i32.ge_s (local.get $i) (i32.load (local.get $names))))\n";
  o += "      (local.set $nm (i32.load (i32.add (i32.add (local.get $names) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
  o += "      (local.set $namlen (i32.load (local.get $nm)))\n";
  o += "      (local.set $child (call $__fern_alloc (i32.add (i32.const 4) (i32.add (i32.add (local.get $plen) (i32.const 1)) (local.get $namlen)))))\n";
  o += "      (i32.store (local.get $child) (i32.add (i32.add (local.get $plen) (i32.const 1)) (local.get $namlen)))\n";
  o += "      (local.set $j (i32.const 0))\n";
  o += "      (block $p1d (loop $p1c\n";
  o += "        (br_if $p1d (i32.ge_u (local.get $j) (local.get $plen)))\n";
  o += "        (i32.store8 (i32.add (i32.add (local.get $child) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (i32.add (local.get $path) (i32.const 4)) (local.get $j))))\n";
  o += "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "        (br $p1c)))\n";
  o += "      (i32.store8 (i32.add (i32.add (local.get $child) (i32.const 4)) (local.get $plen)) (i32.const 47))\n";
  o += "      (local.set $j (i32.const 0))\n";
  o += "      (block $p2d (loop $p2c\n";
  o += "        (br_if $p2d (i32.ge_u (local.get $j) (local.get $namlen)))\n";
  o += "        (i32.store8 (i32.add (i32.add (i32.add (local.get $child) (i32.const 4)) (i32.add (local.get $plen) (i32.const 1))) (local.get $j)) (i32.load8_u (i32.add (i32.add (local.get $nm) (i32.const 4)) (local.get $j))))\n";
  o += "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "        (br $p2c)))\n";
  o += "      (local.set $j (call $__fern_remove_dir_all (local.get $child)))\n";
  o += "      (if (i32.eq (i32.load (local.get $j)) (i32.const 1)) (then (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $j) (i32.const 4)))))))\n";
  o += "      (drop (call $__fern_arr_dec (local.get $j)))\n";
  o += "      (call $__fern_raw_free (local.get $child) (i32.add (i32.const 4) (i32.load (local.get $child))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $dc)))\n";
  o += "    (drop (call $__fern_arr_dec_ptr (local.get $names)))\n";
  o += "    (drop (call $__fern_path_remove_directory (i32.const 3) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path))))\n";
  o += "    (call $__fern_rda_ok))\n";
  return o;
}

function rda_list_p1(): string {
  let o = "";
  o += "    (local.set $err (call $__fern_path_open (i32.const 3) (i32.const 1) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path)) (i32.const 2) (i64.const 16384) (i64.const 0) (i32.const 0) (i32.const 16)))\n";
  o += rda_refusal();
  o += "    (local.set $fd (i32.load (i32.const 16)))\n";
  o += "    (local.set $names (call $__fern_arr_box (i32.const 0)))\n";
  o += "    (i32.store (local.get $names) (i32.const 0))\n";
  o += "    (i32.store (i32.add (local.get $names) (i32.const 4)) (i32.const 0))\n";
  o += "    (local.set $buf (call $__fern_alloc (i32.const 4096)))\n";
  o += "    (local.set $cookie (i64.const 0))\n";
  o += "    (block $rdone (loop $rloop\n";
  o += "      (local.set $err (call $__fern_fd_readdir (local.get $fd) (local.get $buf) (i32.const 4096) (local.get $cookie) (i32.const 8)))\n";
  o += "      (if (local.get $err) (then\n";
  o += "        (drop (call $__fern_fd_close (local.get $fd)))\n";
  o += "        (call $__fern_raw_free (local.get $buf) (i32.const 4096))\n";
  o += "        (drop (call $__fern_arr_dec_ptr (local.get $names)))\n";
  o += "        (return (call $__fern_rda_err (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get $path)))))))\n";
  o += "      (local.set $used (i32.load (i32.const 8)))\n";
  o += "      (br_if $rdone (i32.eqz (local.get $used)))\n";
  o += "      (local.set $pos (i32.const 0))\n";
  o += "      (local.set $lastnext (local.get $cookie))\n";
  o += "      (block $pdone (loop $ploop\n";
  o += "        (br_if $pdone (i32.gt_u (i32.add (local.get $pos) (i32.const 24)) (local.get $used)))\n";
  o += "        (local.set $lastnext (i64.load (i32.add (local.get $buf) (local.get $pos))))\n";
  o += "        (local.set $namlen (i32.load (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 16)))))\n";
  o += "        (br_if $pdone (i32.gt_u (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)) (local.get $used)))\n";
  o += "        (local.set $nameptr (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 24))))\n";
  o += "        (local.set $skip (i32.const 0))\n";
  o += "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 1)) (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46))) (then (local.set $skip (i32.const 1))))\n";
  o += "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 2)) (i32.and (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46)) (i32.eq (i32.load8_u (i32.add (local.get $nameptr) (i32.const 1))) (i32.const 46)))) (then (local.set $skip (i32.const 1))))\n";
  o += "        (if (i32.eqz (local.get $skip)) (then\n";
  o += "          (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $namlen))))\n";
  o += "          (i32.store (local.get $blk) (local.get $namlen))\n";
  o += "          (local.set $i (i32.const 0))\n";
  o += "          (block $cd (loop $cc\n";
  o += "            (br_if $cd (i32.ge_u (local.get $i) (local.get $namlen)))\n";
  o += "            (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (local.get $nameptr) (local.get $i))))\n";
  o += "            (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "            (br $cc)))\n";
  o += "          (local.set $names (call $__fern_arr_push_owned (local.get $names) (local.get $blk)))))\n";
  o += "        (local.set $pos (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)))\n";
  o += "        (br $ploop)))\n";
  o += "      (br_if $rdone (i32.lt_u (local.get $used) (i32.const 4096)))\n";
  o += "      (local.set $cookie (local.get $lastnext))\n";
  o += "      (br $rloop)))\n";
  o += "    (drop (call $__fern_fd_close (local.get $fd)))\n";
  o += "    (call $__fern_raw_free (local.get $buf) (i32.const 4096))\n";
  return o;
}

function rda_list_p2(): string {
  let o = "    (local.set $names (call $__fern_dir_names_p2 (local.get $path)))\n";
  o += "    (if (i32.lt_s (local.get $names) (i32.const 0)) (then (local.set $err (i32.sub (i32.const 0) (local.get $names)))))\n";
  return o + rda_refusal();
}

function rda_refusal(): string {
  let o = "";
  o += "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
  o += "      (if (i32.eq (local.get $err) (i32.const 44)) (then (return (call $__fern_rda_ok))))\n";
  o += "      (if (i32.eq (local.get $err) (i32.const 54)) (then\n";
  o += "        (drop (call $__fern_path_unlink_file (i32.const 3) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path))))\n";
  o += "        (return (call $__fern_rda_ok))))\n";
  o += "      (return (call $__fern_rda_err (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get $path)))))))\n";
  return o;
}

pub function sleep_ms_func(p2: boolean): string {
  return sleep_body(
    "$__fern_sleep_ms", "ms",
    "(i64.mul (local.get $ms) (i64.const 1000000))",
    p2,
  );
}

pub function sleep_ns_func(p2: boolean): string {
  return sleep_body("$__fern_sleep_ns", "ns", "(local.get $ns)", p2);
}

function sleep_body(name: string, param: string, timeout: string, p2: boolean): string {
  if (p2) {
    let o2 = "  (func " + name + " (param $" + param + " i64) (result i32)\n";
    o2 += "    (local $p i32)\n";
    o2 = o2 + "    (if (i64.gt_s (local.get $" + param + ") (i64.const 0)) (then\n";
    o2 = o2 + "      (local.set $p (call $__fern_wasi_subscribe_duration " + timeout + "))\n";
    o2 += "      (call $__fern_wasi_pollable_block (local.get $p))\n";
    o2 += "      (call $__fern_wasi_pollable_drop (local.get $p))))\n";
    o2 += "    (i32.const 0))\n";
    return o2;
  }
  let a = sleep_scratch_addr();
  let at = util.i32_to_string(a);
  let o = "  (func " + name + " (param $" + param + " i64) (result i32)\n";
  o = o + "    (if (i64.gt_s (local.get $" + param + ") (i64.const 0)) (then\n";
  o = o + "      (i64.store (i32.const " + at + ") (i64.const 0))\n";
  o = o + "      (i32.store8 (i32.const " + util.i32_to_string(a + 8) + ") (i32.const 0))\n";
  o = o + "      (i32.store (i32.const " + util.i32_to_string(a + 16) + ") (i32.const 1))\n";
  o = o + "      (i64.store (i32.const " + util.i32_to_string(a + 24) + ") " + timeout + ")\n";
  o = o + "      (i64.store (i32.const " + util.i32_to_string(a + 32) + ") (i64.const 0))\n";
  o = o + "      (i32.store16 (i32.const " + util.i32_to_string(a + 40) + ") (i32.const 0))\n";
  o = o + "      (drop (call $__fern_poll_oneoff (i32.const " + at + ") (i32.const " + util.i32_to_string(a + 48) + ") (i32.const 1) (i32.const " + util.i32_to_string(a + 80) + ")))))\n";
  o += "    (i32.const 0))\n";
  return o;
}

pub function temp_dir_func(): string {
  let o = "";
  o += "  (func $__fern_temp_dir (param $prefix i32) (result i32)\n";
  o += "    (local $plen i32) (local $tot i32) (local $blk i32) (local $base i32) (local $i i32)\n";
  o += "    (local $rnd i32) (local $nib i32) (local $try i32) (local $err i32) (local $res i32)\n";
  o += "    (local.set $plen (i32.load (local.get $prefix)))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $sd (loop $sl\n";
  o += "      (br_if $sd (i32.ge_u (local.get $i) (local.get $plen)))\n";
  o += "      (if (i32.eq (i32.load8_u (i32.add (i32.add (local.get $prefix) (i32.const 4)) (local.get $i))) (i32.const 47)) (then\n";
  o += "        (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "        (i32.store (local.get $res) (i32.const 1))\n";
  o += "        (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (i32.const 28) (call $__fern_rc_inc (local.get $prefix))))\n";
  o += "        (return (local.get $res))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $sl)))\n";
  o += "    (local.set $tot (i32.add (local.get $plen) (i32.const 9)))\n";
  o += "    (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $tot))))\n";
  o += "    (i32.store (local.get $blk) (local.get $tot))\n";
  o += "    (memory.copy (i32.add (local.get $blk) (i32.const 4)) (i32.add (local.get $prefix) (i32.const 4)) (local.get $plen))\n";
  o += "    (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $plen)) (i32.const 45))\n";
  o += "    (local.set $base (i32.add (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $plen)) (i32.const 1)))\n";
  o += "    (block $made (loop $next\n";
  o += "      (local.set $rnd (call $__fern_random_i32))\n";
  o += "      (local.set $i (i32.const 0))\n";
  o += "      (block $hd (loop $hl\n";
  o += "        (br_if $hd (i32.ge_u (local.get $i) (i32.const 8)))\n";
  o += "        (local.set $nib (i32.and (i32.shr_u (local.get $rnd) (i32.mul (local.get $i) (i32.const 4))) (i32.const 15)))\n";
  o += "        (i32.store8 (i32.add (local.get $base) (local.get $i)) (i32.add (i32.add (local.get $nib) (i32.const 48)) (i32.mul (i32.ge_u (local.get $nib) (i32.const 10)) (i32.const 39))))\n";
  o += "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "        (br $hl)))\n";
  o += "      (local.set $err (call $__fern_path_create_directory (i32.const 3) (i32.add (local.get $blk) (i32.const 4)) (local.get $tot)))\n";
  o += "      (br_if $made (i32.eqz (local.get $err)))\n";
  o += "      (local.set $try (i32.add (local.get $try) (i32.const 1)))\n";
  o += "      (br_if $next (i32.and (i32.eq (local.get $err) (i32.const 20)) (i32.lt_u (local.get $try) (i32.const 64))))\n";
  o += "      (drop (call $__fern_arr_dec (local.get $blk)))\n";
  o += "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "      (i32.store (local.get $res) (i32.const 1))\n";
  o += "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (call $__fern_rc_inc (local.get $prefix))))\n";
  o += "      (return (local.get $res))))\n";
  o += "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $res) (i32.const 0))\n";
  o += "    (i32.store (i32.add (local.get $res) (i32.const 4)) (local.get $blk))\n";
  o += "    (local.get $res))\n";
  return o;
}

pub function substr_helper(): string {
  let o = "";
  o += "  (func $__fern_substr (param $s i32) (param $start i32) (param $end i32) (result i32)\n";
  o += "    (local $len i32) (local $p i32) (local $i i32)\n";
  o += "    (if (i32.gt_u (local.get $end) (i32.load (local.get $s))) (then (call $__fern_abort_str) (unreachable)))\n";
  o += "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (call $__fern_abort_str) (unreachable)))\n";
  o += "    (local.set $len (i32.sub (local.get $end) (local.get $start)))\n";
  o += "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
  o += "    (i32.store (local.get $p) (local.get $len))\n";
  o += "    (local.set $i (i32.const 0))\n";
  o += "    (block $d (loop $c\n";
  o += "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
  o += "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $start) (local.get $i)))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $c)))\n";
  o += "    (local.get $p))\n";
  return o;
}

// A borrowed descriptor {len | 1 << 31, data}: a counted box that aliases the
// storage it was made from. A string's length never has the top bit.
pub function str_borrow_helper(): string {
  let o = "  (func $__fern_str_borrow (param $data i32) (param $len i32) (result i32)\n";
  o += "    (local $p i32)\n";
  o += "    (local.set $p (call $__fern_str_box (i32.const 8)))\n";
  o += "    (i32.store (local.get $p) (i32.or (local.get $len) (i32.const -2147483648)))\n";
  o += "    (i32.store (i32.add (local.get $p) (i32.const 4)) (local.get $data))\n";
  o += "    (local.get $p))\n";
  return o;
}

// i64x2.lt_s is a signed compare. Both sides have their top bit flipped, so it gives the unsigned order.
pub function count_below_u64_helper(): string {
  let o = "  (func $__fern_count_below_u64 (param $a i32) (param $w i64) (result i32)\n";
  o += "    (local $len i32) (local $i i32) (local $count i32) (local $bias v128) (local $t v128)\n";
  o += "    (local.set $len (i32.load (local.get $a)))\n";
  o += "    (local.set $bias (i64x2.splat (i64.shl (i64.const 1) (i64.const 63))))\n";
  o += "    (local.set $t (v128.xor (i64x2.splat (local.get $w)) (local.get $bias)))\n";
  o += "    (block $vd (loop $vc\n";
  o += "      (br_if $vd (i32.gt_s (i32.add (local.get $i) (i32.const 2)) (local.get $len)))\n";
  o += "      (local.set $count (i32.add (local.get $count) (i32.popcnt (i64x2.bitmask (i64x2.lt_s\n";
  o += "        (v128.xor (v128.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.shl (local.get $i) (i32.const 3)))) (local.get $bias))\n";
  o += "        (local.get $t))))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 2)))\n";
  o += "      (br $vc)))\n";
  o += "    (if (i32.lt_s (local.get $i) (local.get $len)) (then\n";
  o += "      (if (i64.lt_u (i64.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.shl (local.get $i) (i32.const 3)))) (local.get $w))\n";
  o += "        (then (local.set $count (i32.add (local.get $count) (i32.const 1)))))))\n";
  o += "    (local.get $count))\n";
  return o;
}

pub function mismatch_bytes_helper(): string {
  return mismatch_kernel("$__fern_mismatch_bytes", 8, 8);
}

pub function mismatch_bytes_str_helper(): string {
  return mismatch_kernel("$__fern_mismatch_bytes_str", 8, 4);
}

pub function memchr_helper(): string {
  let o = "";
  o += "  (func $__fern_memchr (param $s i32) (param $byte i32) (param $from i32) (result i32)\n";
  o += "    (local $len i32) (local $i i32) (local $m i32) (local $splat v128)\n";
  o += "    (if (i32.or (i32.lt_s (local.get $byte) (i32.const 0)) (i32.gt_s (local.get $byte) (i32.const 255))) (then (return (i32.const -1))))\n";
  o += "    (local.set $len (i32.load (local.get $s)))\n";
  o += "    (local.set $i (local.get $from))\n";
  o += "    (if (i32.lt_s (local.get $i) (i32.const 0)) (then (local.set $i (i32.const 0))))\n";
  o += "    (local.set $splat (i8x16.splat (local.get $byte)))\n";
  o += "    (block $vd (loop $vc\n";
  o += "      (br_if $vd (i32.lt_s (i32.sub (local.get $len) (local.get $i)) (i32.const 16)))\n";
  o += "      (local.set $m (i8x16.bitmask (i8x16.eq (v128.load (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))) (local.get $splat))))\n";
  o += "      (if (i32.ne (local.get $m) (i32.const 0)) (then (return (i32.add (local.get $i) (i32.ctz (local.get $m))))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 16)))\n";
  o += "      (br $vc)))\n";
  o += "    (block $d (loop $c\n";
  o += "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
  o += "      (if (i32.eq (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))) (local.get $byte)) (then (return (local.get $i))))\n";
  o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o += "      (br $c)))\n";
  o += "    (i32.const -1))\n";
  return o;
}

pub function mismatch_helper(): string {
  return mismatch_kernel("$__fern_mismatch", 4, 4);
}

// A side at data offset 4 is a string, which a byte view's string arm may
// hand over as a frame window; one at 8 is an array.
function mismatch_side(box: string, p: string, n: string, data: i32): string {
  if (data == 4) {
    return view_string_decode(box, p, n);
  }
  return "    (local.set " + n + " (i32.load (local.get " + box + ")))\n    (local.set " + p + " (i32.add (local.get " + box + ") (i32.const " + util.i32_to_string(data) + ")))\n";
}

function mismatch_kernel(name: string, a_data: i32, b_data: i32): string {
  let o = "";
  o = o + "  (func " + name + " (param $a i32) (param $ao i32) (param $b i32) (param $bo i32) (param $n i32) (result i32)\n";
  o += "    (local $na i32) (local $nb i32) (local $pa i32) (local $pb i32) (local $i i32) (local $m i32)\n";
  o += mismatch_side("$a", "$pa", "$na", a_data);
  o += mismatch_side("$b", "$pb", "$nb", b_data);
  o += "    (if (i32.lt_s (local.get $ao) (i32.const 0)) (then (local.set $ao (i32.const 0))))\n";
  o += "    (if (i32.gt_s (local.get $ao) (local.get $na)) (then (local.set $ao (local.get $na))))\n";
  o += "    (if (i32.lt_s (local.get $bo) (i32.const 0)) (then (local.set $bo (i32.const 0))))\n";
  o += "    (if (i32.gt_s (local.get $bo) (local.get $nb)) (then (local.set $bo (local.get $nb))))\n";
  o += "    (if (i32.gt_s (local.get $n) (i32.sub (local.get $na) (local.get $ao))) (then (local.set $n (i32.sub (local.get $na) (local.get $ao)))))\n";
  o += "    (if (i32.gt_s (local.get $n) (i32.sub (local.get $nb) (local.get $bo))) (then (local.set $n (i32.sub (local.get $nb) (local.get $bo)))))\n";
  o += "    (if (i32.lt_s (local.get $n) (i32.const 0)) (then (local.set $n (i32.const 0))))\n";
  o += "    (local.set $pa (i32.add (local.get $pa) (local.get $ao)))\n";
  o += "    (local.set $pb (i32.add (local.get $pb) (local.get $bo)))\n";
  o += "    (block $vd (loop $vc\n";
  o += "      (br_if $vd (i32.lt_s (i32.sub (local.get $n) (local.get $i)) (i32.const 16)))\n";
  o += "      (local.set $m (i8x16.bitmask (i8x16.eq (v128.load (i32.add (local.get $pa) (local.get $i))) (v128.load (i32.add (local.get $pb) (local.get $i))))))\n";
  o += "      (if (i32.ne (local.get $m) (i32.const 65535)) (then (return (i32.add (local.get $i) (i32.ctz (i32.xor (local.get $m) (i32.const 65535)))))))\n";
