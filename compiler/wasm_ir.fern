pub function module_uses_scale_f64(cache: irtables.LowerResult[]): boolean {
  function is_scale_f64(o: ir.Op): boolean {
    return o.kind_tag == 322;
  }
  return any_op(cache, is_scale_f64);
}

pub function module_uses_aes_gcm(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "aes_expand_key") || module_emits_op_cached(cache, "aes_ctr32") || module_emits_op_cached(cache, "ghash")
    || module_emits_op_cached(cache, "aes_gcm_seal") || module_emits_op_cached(cache, "aes_gcm_open");
}

pub function module_uses_sha_hw_blocks(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "sha256_hw_blocks") || module_emits_op_cached(cache, "sha1_hw_blocks");
}

function sha_hw_blocks_helper(): string {
  return "  (func $__fern_sha_hw_blocks (param $state i32) (param $data i32) (result i32) (local $a i32)\n"
    + "    (local.set $a (call $__fern_arr_elems (i32.const 0) (i32.const 1)))\n"
    + "    (i32.store (local.get $a) (i32.const 0))\n"
    + "    (i32.store offset=4 (local.get $a) (i32.const 0))\n"
    + "    (local.get $a))\n";
}

pub function module_uses_crc32_cksum(cache: irtables.LowerResult[]): boolean {
  function is_crc32(o: ir.Op): boolean {
    return o.kind_tag == 309;
  }
  return any_op(cache, is_crc32);
}

pub function module_uses_ascii_run(cache: irtables.LowerResult[]): boolean {
  function is_ascii_run(o: ir.Op): boolean {
    return o.kind_tag == 227;
  }
  return any_op(cache, is_ascii_run);
}

pub function module_uses_str_slice(cache: irtables.LowerResult[]): boolean {
  function is_str_slice(o: ir.Op): boolean {
    return o.kind_tag == 102;
  }
  return any_op(cache, is_str_slice);
}

function wasm_binop(tag: i32): string {
  if (tag == 21) {
    return "i32.add";
  }
  if (tag == 22) {
    return "i32.sub";
  }
  if (tag == 23) {
    return "i32.mul";
  }
  if (tag == 24) {
    return "call $__fern_idiv";
  }
  if (tag == 26) {
    return "call $__fern_irem";
  }
  if (tag == 28) {
    return "i32.and";
  }
  if (tag == 29) {
    return "i32.or";
  }
  if (tag == 30) {
    return "i32.xor";
  }
  if (tag == 31) {
    return "i32.shl";
  }
  if (tag == 32) {
    return "i32.shr_s";
  }
  if (tag == 33) {
    return "i32.shr_u";
  }
  if (tag == 25) {
    return "call $__fern_udiv";
  }
  if (tag == 27) {
    return "call $__fern_urem";
  }
  if (tag == 35) {
    return "i32.eq";
  }
  if (tag == 36) {
    return "i32.ne";
  }
  if (tag == 37) {
    return "i32.lt_s";
  }
  if (tag == 38) {
    return "i32.le_s";
  }
  if (tag == 39) {
    return "i32.gt_s";
  }
  if (tag == 40) {
    return "i32.ge_s";
  }
  if (tag == 41) {
    return "i32.lt_u";
  }
  if (tag == 42) {
    return "i32.le_u";
  }
  if (tag == 43) {
    return "i32.gt_u";
  }
  if (tag == 44) {
    return "i32.ge_u";
  }
  return ircore.unsupported_op_refuse(tag, "wasm");
}

function wasm_binop_w(tag: i32, width: i32): string {
  if (width != 64) {
    return wasm_binop(tag);
  }
  if (tag == 21) {
    return "i64.add";
  }
  if (tag == 22) {
    return "i64.sub";
  }
  if (tag == 23) {
    return "i64.mul";
  }
  if (tag == 24) {
    return "call $__fern_idiv64";
  }
  if (tag == 26) {
    return "call $__fern_irem64";
  }
  if (tag == 25) {
    return "call $__fern_udiv64";
  }
  if (tag == 27) {
    return "call $__fern_urem64";
  }
  if (tag == 28) {
    return "i64.and";
  }
  if (tag == 29) {
    return "i64.or";
  }
  if (tag == 30) {
    return "i64.xor";
  }
  if (tag == 31) {
    return "i64.shl";
  }
  if (tag == 32) {
    return "i64.shr_s";
  }
  if (tag == 33) {
    return "i64.shr_u";
  }
  if (tag == 35) {
    return "i64.eq";
  }
  if (tag == 36) {
    return "i64.ne";
  }
  if (tag == 37) {
    return "i64.lt_s";
  }
  if (tag == 38) {
    return "i64.le_s";
  }
  if (tag == 39) {
    return "i64.gt_s";
  }
  if (tag == 40) {
    return "i64.ge_s";
  }
  if (tag == 41) {
    return "i64.lt_u";
  }
  if (tag == 42) {
    return "i64.le_u";
  }
  if (tag == 43) {
    return "i64.gt_u";
  }
  if (tag == 44) {
    return "i64.ge_u";
  }
  if (tag == 45) {
    return "f64.add";
  }
  if (tag == 46) {
    return "f64.sub";
  }
  if (tag == 47) {
    return "f64.mul";
  }
  if (tag == 48) {
    return "f64.div";
  }
  if (tag == 57) {
    return "f64.sqrt";
  }
  if (tag == 59) {
    return "f64.floor";
  }
  if (tag == 58) {
    return "f64.ceil";
  }
  if (tag == 60) {
    return "f64.trunc";
  }
  if (tag == 56) {
    return "f64.abs";
  }
  if (tag == 55) {
    return "f64.neg";
  }
  if (tag == 49) {
    return "f64.eq";
  }
  if (tag == 50) {
    return "f64.ne";
  }
  if (tag == 51) {
    return "f64.lt";
  }
  if (tag == 52) {
    return "f64.le";
  }
  if (tag == 53) {
    return "f64.gt";
  }
  if (tag == 54) {
    return "f64.ge";
  }
  return ircore.unsupported_op_refuse(tag, "wasm");
}

function slot_in_list(list: i32[], x: i32): boolean {
  let i: i32 = 0;
  while (i < list.len()) {
    if (list[i] == x) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function wasm_helper_symbol(name: string): string {
  if (name == "__fern_oob_abort") {
    return "$__fern_oob_abort";
  }
  if (name == "__fern_rc_inc" || name == "__fern_str_own") {
    return "$__fern_rc_inc";
  }
  if (name == "__fern_str_borrow") {
    return "$__fern_str_borrow";
  }
  if (name == "__fern_rc_dec") {
    return "$__fern_arr_dec";
  }
  if (name == "__fern_str_free") {
    return "$__fern_arr_dec";
  }
  if (name == "__fern_str_view_free") {
    return "$__fern_arr_dec";
  }
  if (name == "__fern_str_arr_free") {
    return "$__fern_arr_dec_ptr";
  }
  if (name == "__fern_rc_underflow_get") {
    return "$__fern_rc_underflow_count";
  }
  if (name == "__fern_i32_to_string") {
    return "$__fern_i32_to_str";
  }
  if (name == "__fern_i64_to_string") {
    return "$__fern_i64_to_str";
  }
  if (name == "__fern_u64_to_string") {
    return "$__fern_u64_to_str";
  }
  if (name == "__fern_u32_to_string") {
    return "$__fern_u32_to_str";
  }
  return "$" + name;
}

pub function module_allocates(cache: irtables.LowerResult[]): boolean {
  function needs_heap(o: ir.Op): boolean {
    return o.kind_tag == 116 || ir.op_needs_heap(o);
  }
  if (any_op(cache, needs_heap)) {
    return true;
  }
  return module_uses_strings(cache);
}

pub function module_emits_op_cached(cache: irtables.LowerResult[], kind: string): boolean {
  let ktag: i32 = ir.kind_id(kind);
  function is_kind(o: ir.Op): boolean {
    return o.kind_tag == ktag;
  }
  return any_op(cache, is_kind);
}

function module_emits_push(cache: irtables.LowerResult[], kind: string, packed: boolean): boolean {
  let ktag: i32 = ir.kind_id(kind);
  function is_push(o: ir.Op): boolean {
    return o.kind_tag == ktag && ir.is_packed(o) == packed;
  }
  return any_op(cache, is_push);
}

function packed_suffix(o: ir.Op): string {
  if (ir.is_packed(o)) {
    return "_u8";
  }
  return "";
}

pub function module_uses_str_case(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "str_to_upper") || module_emits_op_cached(cache, "str_to_lower");
}

pub function module_uses_str_repeat(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "str_repeat");
}

pub function module_uses_str_trim(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "str_trim");
}

pub function module_uses_str_replace(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "str_replace");
}

pub function module_uses_str_lines(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "str_lines");
}

pub function module_uses_frame_string(cache: irtables.LowerResult[]): boolean {
  return any_op(cache, is_frame_string);
}

function is_frame_string(o: ir.Op): boolean {
  return ir.frame_box_base(o) >= 0 && o.kind_tag == ir.K_RAW_STRING;
}

pub function module_calls_direct(cache: irtables.LowerResult[], name: string): boolean {
  function is_call_to(o: ir.Op): boolean {
    return o.kind_tag == 149 && o.str == name;
  }
  return any_op(cache, is_call_to);
}

pub function module_uses_task(cache: irtables.LowerResult[]): boolean {
  function is_task_call(o: ir.Op): boolean {
    return o.kind_tag == 149 && ircore.is_task_runtime_fn(o.str);
  }
  return any_op(cache, is_task_call);
}

pub function task_funcs(lc: boolean): string {
  let uncount: string = "";
  if (lc) {
    uncount = "    (global.set $__fern_lc_alloc_count (i64.sub (global.get $__fern_lc_alloc_count) (i64.const 1)))\n"
      + "    (global.set $__fern_lc_alloc_bytes (i64.sub (global.get $__fern_lc_alloc_bytes) (i64.extend_i32_u (local.get $n))))\n";
  }
  return "  (global $__fern_task_cur_g (mut i32) (i32.const 0))\n"
    + "  (global $__fern_task_tab (mut i32) (i32.const 0))\n"
    + "  (global $__fern_task_cap (mut i32) (i32.const 0))\n"
    + "  (func $__fern_task_alloc (param $n i32) (result i32) (local $p i32)\n"
    + "    (local.set $p (call $__fern_alloc (local.get $n)))\n"
    + uncount
    + "    (local.get $p))\n"
    + "  (func $__fern_task_zalloc (param $n i32) (result i32) (local $p i32)\n"
    + "    (local.set $p (call $__fern_task_alloc (local.get $n)))\n"
    + "    (memory.fill (local.get $p) (i32.const 0) (local.get $n))\n"
    + "    (local.get $p))\n"
    + "  (func $__fern_task_rec (param $id i32) (result i32)\n"
    + "    (i32.wrap_i64 (i64.load (i32.add (global.get $__fern_task_tab) (i32.shl (local.get $id) (i32.const 3))))))\n"
    + "  (func $__fern_task_new (result i32) (local $id i32) (local $r i32) (local $cap i32) (local $nt i32)\n"
    + "    (if (i32.eqz (global.get $__fern_task_tab)) (then\n"
    + "      (global.set $__fern_task_tab (call $__fern_task_zalloc (i32.const 512)))\n"
    + "      (global.set $__fern_task_cap (i32.const 64))))\n"
    + "    (local.set $cap (global.get $__fern_task_cap))\n"
    + "    (local.set $id (i32.const 1))\n"
    + "    (block $done (loop $scan\n"
    + "      (br_if $done (i32.ge_s (local.get $id) (local.get $cap)))\n"
    + "      (local.set $r (call $__fern_task_rec (local.get $id)))\n"
    + "      (if (i32.eqz (local.get $r)) (then\n"
    + "        (i64.store (i32.add (global.get $__fern_task_tab) (i32.shl (local.get $id) (i32.const 3))) (i64.extend_i32_u (call $__fern_task_zalloc (i32.const 96))))\n"
    + "        (return (local.get $id))))\n"
    + "      (if (i64.ne (i64.load offset=56 (local.get $r)) (i64.const 0)) (then\n"
    + "        (i64.store offset=56 (local.get $r) (i64.const 0))\n"
    + "        (i64.store (local.get $r) (i64.const 0))\n"
    + "        (i64.store offset=8 (local.get $r) (i64.const 0))\n"
    + "        (i64.store offset=16 (local.get $r) (i64.const 0))\n"
    + "        (i64.store offset=24 (local.get $r) (i64.const 0))\n"
    + "        (i64.store offset=40 (local.get $r) (i64.const 0))\n"
    + "        (i64.store offset=72 (local.get $r) (i64.const 0))\n"
    + "        (return (local.get $id))))\n"
    + "      (local.set $id (i32.add (local.get $id) (i32.const 1)))\n"
    + "      (br $scan)))\n"
    + "    (local.set $nt (call $__fern_task_zalloc (i32.shl (local.get $cap) (i32.const 4))))\n"
    + "    (memory.copy (local.get $nt) (global.get $__fern_task_tab) (i32.shl (local.get $cap) (i32.const 3)))\n"
    + "    (global.set $__fern_task_tab (local.get $nt))\n"
    + "    (global.set $__fern_task_cap (i32.shl (local.get $cap) (i32.const 1)))\n"
    + "    (i64.store (i32.add (local.get $nt) (i32.shl (local.get $cap) (i32.const 3))) (i64.extend_i32_u (call $__fern_task_zalloc (i32.const 96))))\n"
    + "    (local.get $cap))\n"
    + "  (func $__fern_task_free (param $id i32) (result i32) (local $r i32)\n"
    + "    (local.set $r (call $__fern_task_rec (local.get $id)))\n"
    + "    (if (local.get $r) (then (i64.store offset=56 (local.get $r) (i64.const 1))))\n"
    + "    (i32.const 0))\n"
    + "  (func $__fern_task_cur (result i32) (global.get $__fern_task_cur_g))\n"
    + "  (func $__fern_task_enter (param $id i32) (param $mode i32) (result i32) (local $r i32)\n"
    + "    (local.set $r (call $__fern_task_rec (local.get $id)))\n"
    + "    (i64.store offset=88 (local.get $r) (i64.extend_i32_u (global.get $__fern_task_cur_g)))\n"
    + "    (global.set $__fern_task_cur_g (local.get $id))\n"
    + "    (i64.store (local.get $r) (i64.extend_i32_s (local.get $mode)))\n"
    + "    (i32.const 0))\n"
    + "  (func $__fern_task_leave (result i32) (local $r i32)\n"
    + "    (if (i32.eqz (global.get $__fern_task_cur_g)) (then (return (i32.const 0))))\n"
    + "    (local.set $r (call $__fern_task_rec (global.get $__fern_task_cur_g)))\n"
    + "    (global.set $__fern_task_cur_g (i32.wrap_i64 (i64.load offset=88 (local.get $r))))\n"
    + "    (i32.wrap_i64 (i64.load (local.get $r))))\n"
    + "  (func $__fern_task_mode (result i32)\n"
    + "    (if (i32.eqz (global.get $__fern_task_cur_g)) (then (return (i32.const 0))))\n"
    + "    (i32.wrap_i64 (i64.load (call $__fern_task_rec (global.get $__fern_task_cur_g)))))\n"
    + "  (func $__fern_task_park (param $set i32) (param $timeout i32) (result i32) (local $r i32) (local $n i32) (local $buf i32) (local $i i32)\n"
    + "    (if (i32.eqz (global.get $__fern_task_cur_g)) (then (return (i32.const -1))))\n"
    + "    (local.set $r (call $__fern_task_rec (global.get $__fern_task_cur_g)))\n"
    + "    (if (i64.eq (i64.load (local.get $r)) (i64.const 2)) (then\n"
    + "      (i64.store (local.get $r) (i64.const 0))\n"
    + "      (if (i64.ne (i64.load offset=24 (local.get $r)) (i64.const 0)) (then (return (i32.const -2))))\n"
    + "      (return (i32.wrap_i64 (i64.load offset=16 (local.get $r))))))\n"
    + "    (if (i64.ne (i64.load offset=24 (local.get $r)) (i64.const 0)) (then (return (i32.const -2))))\n"
    + "    (i64.store (local.get $r) (i64.const 1))\n"
    + "    (i64.store offset=8 (local.get $r) (i64.extend_i32_s (local.get $timeout)))\n"
    + "    (local.set $n (i32.load (local.get $set)))\n"
    + "    (local.set $buf (i32.wrap_i64 (i64.load offset=64 (local.get $r))))\n"
    + "    (if (i32.gt_s (local.get $n) (i32.wrap_i64 (i64.load offset=80 (local.get $r)))) (then\n"
    + "      (local.set $buf (call $__fern_task_alloc (i32.shl (local.get $n) (i32.const 3))))\n"
    + "      (i64.store offset=64 (local.get $r) (i64.extend_i32_u (local.get $buf)))\n"
    + "      (i64.store offset=80 (local.get $r) (i64.extend_i32_s (local.get $n)))))\n"
    + "    (local.set $i (i32.const 0))\n"
    + "    (block $done (loop $copy\n"
    + "      (br_if $done (i32.ge_s (local.get $i) (local.get $n)))\n"
    + "      (i64.store (i32.add (local.get $buf) (i32.shl (local.get $i) (i32.const 3))) (i64.extend_i32_s (i32.load offset=8 (i32.add (local.get $set) (i32.shl (local.get $i) (i32.const 2))))))\n"
    + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n"
    + "      (br $copy)))\n"
    + "    (i64.store offset=72 (local.get $r) (i64.extend_i32_s (local.get $n)))\n"
    + "    (i32.const 0))\n"
    + "  (func $__fern_task_wait (param $id i32) (result i32) (local $r i32) (local $n i32) (local $buf i32) (local $out i32) (local $i i32)\n"
    + "    (local.set $r (call $__fern_task_rec (local.get $id)))\n"
    + "    (local.set $n (i32.wrap_i64 (i64.load offset=72 (local.get $r))))\n"
    + "    (local.set $buf (i32.wrap_i64 (i64.load offset=64 (local.get $r))))\n"
    + "    (local.set $out (call $__fern_arr_box (select (i32.const 32) (i32.shl (local.get $n) (i32.const 2)) (i32.eqz (local.get $n)))))\n"
    + "    (i32.store (local.get $out) (local.get $n))\n"
    + "    (i32.store offset=4 (local.get $out) (select (i32.const 4) (local.get $n) (i32.eqz (local.get $n))))\n"
    + "    (local.set $i (i32.const 0))\n"
    + "    (block $done (loop $copy\n"
    + "      (br_if $done (i32.ge_s (local.get $i) (local.get $n)))\n"
    + "      (i32.store offset=8 (i32.add (local.get $out) (i32.shl (local.get $i) (i32.const 2))) (i32.wrap_i64 (i64.load (i32.add (local.get $buf) (i32.shl (local.get $i) (i32.const 3))))))\n"
    + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n"
    + "      (br $copy)))\n"
    + "    (local.get $out))\n"
    + "  (func $__fern_task_timeout (param $id i32) (result i32)\n"
    + "    (i32.wrap_i64 (i64.load offset=8 (call $__fern_task_rec (local.get $id)))))\n"
    + "  (func $__fern_task_set_ready (param $id i32) (param $w i32) (result i32)\n"
    + "    (i64.store offset=16 (call $__fern_task_rec (local.get $id)) (i64.extend_i32_s (local.get $w)))\n"
    + "    (i32.const 0))\n"
    + "  (func $__fern_task_set_cancelled (param $id i32) (result i32)\n"
    + "    (i64.store offset=24 (call $__fern_task_rec (local.get $id)) (i64.const 1))\n"
    + "    (i32.const 0))\n"
    + "  (func $__fern_task_cancelled (result i32)\n"
    + "    (if (i32.eqz (global.get $__fern_task_cur_g)) (then (return (i32.const 0))))\n"
    + "    (i32.wrap_i64 (i64.load offset=24 (call $__fern_task_rec (global.get $__fern_task_cur_g)))))\n"
    + "  (func $__fern_task_reserve (param $n i32) (result i32) (local $r i32) (local $len i32) (local $cap i32) (local $buf i32) (local $nbuf i32) (local $need i32)\n"
    + "    (local.set $r (call $__fern_task_rec (global.get $__fern_task_cur_g)))\n"
    + "    (local.set $len (i32.wrap_i64 (i64.load offset=40 (local.get $r))))\n"
    + "    (local.set $cap (i32.wrap_i64 (i64.load offset=48 (local.get $r))))\n"
    + "    (local.set $buf (i32.wrap_i64 (i64.load offset=32 (local.get $r))))\n"
    + "    (local.set $need (i32.add (local.get $len) (local.get $n)))\n"
    + "    (if (i32.gt_s (local.get $need) (local.get $cap)) (then\n"
    + "      (local.set $cap (select (i32.shl (local.get $cap) (i32.const 1)) (i32.const 64) (i32.gt_s (local.get $cap) (i32.const 0))))\n"
    + "      (block $big (loop $grow\n"
    + "        (br_if $big (i32.ge_s (local.get $cap) (local.get $need)))\n"
    + "        (local.set $cap (i32.shl (local.get $cap) (i32.const 1)))\n"
    + "        (br $grow)))\n"
    + "      (local.set $nbuf (call $__fern_task_alloc (i32.shl (local.get $cap) (i32.const 3))))\n"
    + "      (memory.copy (local.get $nbuf) (local.get $buf) (i32.shl (local.get $len) (i32.const 3)))\n"
    + "      (local.set $buf (local.get $nbuf))\n"
    + "      (i64.store offset=32 (local.get $r) (i64.extend_i32_u (local.get $buf)))\n"
    + "      (i64.store offset=48 (local.get $r) (i64.extend_i32_s (local.get $cap)))))\n"
    + "    (i64.store offset=40 (local.get $r) (i64.extend_i32_s (local.get $need)))\n"
    + "    (i32.add (local.get $buf) (i32.shl (local.get $len) (i32.const 3))))\n"
    + "  (func $__fern_task_take (param $n i32) (result i32) (local $r i32) (local $len i32)\n"
    + "    (local.set $r (call $__fern_task_rec (global.get $__fern_task_cur_g)))\n"
    + "    (local.set $len (i32.sub (i32.wrap_i64 (i64.load offset=40 (local.get $r))) (local.get $n)))\n"
    + "    (i64.store offset=40 (local.get $r) (i64.extend_i32_s (local.get $len)))\n"
    + "    (i32.add (i32.wrap_i64 (i64.load offset=32 (local.get $r))) (i32.shl (local.get $len) (i32.const 3))))\n"
    + "  (func $__fern_task_pop_w (result i32) (local $r i32) (local $len i32)\n"
    + "    (local.set $r (call $__fern_task_rec (global.get $__fern_task_cur_g)))\n"
    + "    (local.set $len (i32.sub (i32.wrap_i64 (i64.load offset=40 (local.get $r))) (i32.const 1)))\n"
    + "    (i64.store offset=40 (local.get $r) (i64.extend_i32_s (local.get $len)))\n"
    + "    (i32.wrap_i64 (i64.load (i32.add (i32.wrap_i64 (i64.load offset=32 (local.get $r))) (i32.shl (local.get $len) (i32.const 3))))))\n";
}

pub function module_uses_i32_to_string(cache: irtables.LowerResult[]): boolean {
  return module_calls_direct(cache, "__fern_i32_to_string");
}

pub function module_uses_i64_to_string(cache: irtables.LowerResult[]): boolean {
  return module_calls_direct(cache, "__fern_i64_to_string");
}

pub function module_uses_u64_to_string(cache: irtables.LowerResult[]): boolean {
  return module_calls_direct(cache, "__fern_u64_to_string");
}

pub function module_uses_u32_to_string(cache: irtables.LowerResult[]): boolean {
  return module_calls_direct(cache, "__fern_u32_to_string");
}

function array_helper_needs(cache: irtables.LowerResult[], own out: string[]): string[] {
  if (module_calls_direct(cache, "__fern_arr_str_join")) {
    out = out.append("@uses_arr_str_join");
  }
  if (module_calls_direct(cache, "__fern_arr_concat")) {
    out = out.append("@uses_arr_concat");
  }
  if (module_calls_direct(cache, "__fern_bytes_owned")) {
    out = out.append("@uses_bytes_owned");
  }
  if (module_calls_direct(cache, "__fern_bytes_append_range")) {
    out = out.append("@uses_byte_append");
  }
  if (module_calls_direct(cache, "__fern_bytes_write_range")) {
    out = out.append("@uses_byte_write");
  }
  if (module_calls_direct(cache, "__fern_bytes_range")) {
    out = out.append("@uses_bytes_range");
  }
  if (module_calls_direct(cache, "__fern_bytes_into")) {
    out = out.append("@uses_bytes_into");
  }
  return out;
}

function array_helper_parts(needs: string[], own parts: string[], empty: i32): string[] {
  if (need(needs, "@uses_arr_str_join")) {
    parts = parts.append(arr_str_join_helper());
  }
  if (need(needs, "@uses_arr_concat")) {
    parts = parts.append(arr_concat_helper());
  }
  if (need(needs, "@uses_bytes_owned")) {
    parts = parts.append(bytes_owned_helper(empty));
  }
  if (need(needs, "@uses_byte_append") || need(needs, "@uses_byte_write")) {
    parts = parts.append(rtbytecopy.wasm_source(need(needs, "@uses_byte_append"), need(needs, "@uses_byte_write")));
  }
  if (need(needs, "@uses_bytes_range")) {
    parts = parts.append(bytes_range_helper(empty));
  }
  if (need(needs, "@uses_bytes_into")) {
    parts = parts.append(bytes_into_helper());
  }
  return parts;
}

pub function module_uses_buf(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "buf_new") || module_emits_op_cached(cache, "buf_push")
    || module_emits_op_cached(cache, "buf_push_range") || module_emits_op_cached(cache, "buf_push_byte")
    || module_emits_op_cached(cache, "buf_push_mapped") || module_emits_op_cached(cache, "buf_push_filtered")
    || module_emits_op_cached(cache, "buf_push_expanded")
    || module_emits_op_cached(cache, "buf_push_bytes_mapped") || module_emits_op_cached(cache, "buf_push_bytes_filtered") || module_emits_op_cached(cache, "buf_push_bytes_expanded")
    || module_emits_op_cached(cache, "buf_push_u64")
    || module_emits_op_cached(cache, "buf_len") || module_emits_op_cached(cache, "buf_take")
    || module_emits_op_cached(cache, "buf_take_bytes")
    || module_emits_op_cached(cache, "buf_push_bytes_range")
    || module_emits_op_cached(cache, "buf_clear")
    || module_emits_op_cached(cache, "buf_free");
}

pub function module_uses_random(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "random_bytes") || module_emits_op_cached(cache, "random_i32")
    || module_emits_op_cached(cache, "map_hash_seed") || module_emits_op_cached(cache, "temp_dir");
}

pub function module_uses_divrem(cache: irtables.LowerResult[]): boolean {
  function is_divrem(o: ir.Op): boolean {
    return o.kind_tag == 24 || o.kind_tag == 26;
  }
  return any_op(cache, is_divrem);
}

pub function module_uses_arr_slice(cache: irtables.LowerResult[]): boolean {
  function is_arr_slice(o: ir.Op): boolean {
    return o.kind_tag == 96 && o.width != 64 && !ir.is_packed(o);
  }
  return any_op(cache, is_arr_slice);
}

pub function module_uses_arr_slice_u8(cache: irtables.LowerResult[]): boolean {
  function is_arr_slice_u8(o: ir.Op): boolean {
    return o.kind_tag == 96 && ir.is_packed(o);
  }
  return any_op(cache, is_arr_slice_u8);
}

pub function module_uses_arr_slice8(cache: irtables.LowerResult[]): boolean {
  function is_arr_slice8(o: ir.Op): boolean {
    return o.kind_tag == 96 && o.width == 64;
  }
  return any_op(cache, is_arr_slice8);
}

pub function module_uses_udivrem(cache: irtables.LowerResult[]): boolean {
  return any_op(cache, is_udivrem);
}

pub function module_uses_i64_udivrem(cache: irtables.LowerResult[]): boolean {
  return any_op(cache, is_i64_udivrem);
}

function is_udivrem(o: ir.Op): boolean {
  return (o.kind_tag == 25 || o.kind_tag == 27) && o.width != 64;
}

function is_i64_udivrem(o: ir.Op): boolean {
  return (o.kind_tag == 25 || o.kind_tag == 27) && o.width == 64;
}

pub function module_uses_i64_divrem(cache: irtables.LowerResult[]): boolean {
  function is_i64_divrem(o: ir.Op): boolean {
    return (o.kind_tag == 24 || o.kind_tag == 26) && o.width == 64;
  }
  return any_op(cache, is_i64_divrem);
}

function module_erased_wide(cache: irtables.LowerResult[]): boolean {
  let i: i32 = 0;
  while (i < cache.len()) {
    if (cache[i].erased_wide) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function all_lowered_ok(cache: irtables.LowerResult[]): boolean {
  let i: i32 = 0;
  while (i < cache.len()) {
    if (!cache[i].ok) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function wasm_unsupported_import(mod: parser.Module): string {
  let stab: irtables.StructTab = irtables.struct_tab(mod.structs);
  let why: string = " fields must be integers, floats, booleans or records of them, at most 16 leaves in all";
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let f: parser.FuncDecl = mod.funcs[i];
    if (is_sync_extern(f)) {
      if (is_struct_type(stab, f.ret_type) && !extern_record_result_supported(mod, f.ret_type)) {
        return "error: @import " + f.name + " returns record " + f.ret_type + ", which wasm cannot lower: its" + why;
      }
      let p: i32 = 0;
      while (p < f.params.len()) {
        let pt: string = f.params[p].type_name;
        if (is_struct_type(stab, pt) && !extern_record_param_supported(mod, pt)) {
          return "error: @import " + f.name + " takes record " + pt + ", which wasm cannot lower: its" + why;
        }
        p = p + 1;
      }
    }
    i = i + 1;
  }
  return "";
}

pub function wasm_ir_deferrals_ok(cache: irtables.LowerResult[]): boolean {
  return true
    && all_lowered_ok(cache)
    && !module_erased_wide(cache);
}

pub function component_refused_need(needs: string[], io: boolean, proxy: boolean): string {
  let i: i32 = 0;
  while (i < needs.len()) {
    let n: string = needs[i];
    if (proxy && n == "exit") {
      i = i + 1;
      continue;
    }
    if (n == "@uses_random") {
      if (io) {
        i = i + 1;
        continue;
      }
      return n;
    }
    if (n[0] == 64) {
      i = i + 1;
      continue;
    }
    if (n == "clock_set" || n == "clone_file") {
      i = i + 1;
      continue;
    }
    if (io && (n == "print_str" || n == "eprint_str" || n == "putchar"
      || n == "exit")) {
      i = i + 1;
      continue;
    }
    if (io && (n == "writer_write" || n == "write_some" || n == "write_bytes" || n == "write_some_bytes")) {
      i = i + 1;
      continue;
    }
    if (io && (n == "now_ns" || n == "now_unix_ms" || n == "monotonic_ns" || n == "clock_resolution"
      || n == "random_bytes" || n == "random_i32")) {
      i = i + 1;
      continue;
    }
    if (io && (n == "env" || n == "environ" || n == "args")) {
      i = i + 1;
      continue;
    }
    if (io && (n == "read_file" || n == "read_file_bytes" || n == "write_file" || n == "write_file_bytes")) {
      i = i + 1;
      continue;
    }
    if (io && component_admits_fs(n)) {
      i = i + 1;
      continue;
    }
    if (io && (util.has_str(socket_builtins(), n) || util.has_str(wait_builtins(), n))) {
      i = i + 1;
      continue;
    }
    if (n == "arr_reserve" || n == "arr_push" || n == "arr_push_owned" || n == "arr_push_i64"
      || n == "arr_push_f64" || n == "arr_push_owned_i64" || n == "arr_push_owned_f64"
      || n == "arr_push_u8" || n == "arr_push_owned_u8"
      || n == "str_split"
      || n == "buf_take_bytes" || n == "buf_push_bytes_range"
      || n == "buf_new" || n == "buf_push" || n == "buf_push_range"
      || n == "buf_push_mapped" || n == "buf_push_filtered" || n == "buf_push_expanded"
      || n == "buf_push_bytes_mapped" || n == "buf_push_bytes_filtered" || n == "buf_push_bytes_expanded"
      || n == "buf_push_byte" || n == "buf_push_u64" || n == "buf_len"
      || n == "buf_clear" || n == "buf_take" || n == "buf_free"
      || n == "str_bytes" || n == "str_from_bytes" || n == "str_from_bytes_range") {
      i = i + 1;
      continue;
    }
    return n;
  }
  return "";
}

pub function clock_imports_p2(has_wall: boolean, has_mono: boolean): string {
  let o: string = "";
  if (has_wall) {
    o = o + "  (import \"wasi:clocks/wall-clock@0.2.0\" \"now\" (func $__fern_wall_now (param i32)))\n";
  }
  if (has_mono) {
    o = o + "  (import \"wasi:clocks/monotonic-clock@0.2.0\" \"now\" (func $__fern_mono_now (result i64)))\n";
  }
  return o;
}

function p2_return_area(n: string): string {
  return "    (local.set $base (call $__fern_alloc (i32.const " + n + ")))\n"
    + "    (local.set $ra (i32.and (i32.add (local.get $base) (i32.const 7)) (i32.const -8)))\n";
}

function free_env_list_p2(): string {
  let o: string = "    (local.set $i (i32.const 0))\n";
  o = o + "    (block $fd (loop $fc\n";
  o = o + "      (br_if $fd (i32.ge_u (local.get $i) (local.get $count)))\n";
  o = o + "      (local.set $tup (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 16))))\n";
  o = o + "      (call $__fern_raw_free (i32.load (local.get $tup)) (i32.load offset=4 (local.get $tup)))\n";
  o = o + "      (call $__fern_raw_free (i32.load offset=8 (local.get $tup)) (i32.load offset=12 (local.get $tup)))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "      (br $fc)))\n";
  o = o + "    (call $__fern_raw_free (local.get $ptr) (i32.mul (local.get $count) (i32.const 16)))\n";
  return o + "    (call $__fern_raw_free (local.get $base) (i32.const 16))\n";
}

pub function clock_funcs_p2(has_wall: boolean, has_mono: boolean): string {
  let o: string = "";
  if (has_wall) {
    o = o + "  (func $__fern_now_ns (result i64)\n";
    o = o + "    (local $ra i32) (local $v i64)\n";
    o = o + "    (local.set $ra (i32.const " + util.i32_to_string(io_ret_addr()) + "))\n";
    o = o + "    (call $__fern_wall_now (local.get $ra))\n";
    o = o + "    (local.set $v (i64.add (i64.mul (i64.load (local.get $ra)) (i64.const 1000000000)) (i64.extend_i32_u (i32.load (i32.add (local.get $ra) (i32.const 8))))))\n";
    o = o + "    (local.get $v))\n";
    o = o + "  (func $__fern_now_unix_ms (result i64)\n";
    o = o + "    (local $ra i32) (local $v i64)\n";
    o = o + "    (local.set $ra (i32.const " + util.i32_to_string(io_ret_addr()) + "))\n";
    o = o + "    (call $__fern_wall_now (local.get $ra))\n";
    o = o + "    (local.set $v (i64.add (i64.mul (i64.load (local.get $ra)) (i64.const 1000)) (i64.div_u (i64.extend_i32_u (i32.load (i32.add (local.get $ra) (i32.const 8)))) (i64.const 1000000))))\n";
    o = o + "    (local.get $v))\n";
  }
  if (has_mono) {
    o = o + "  (func $__fern_monotonic_ns (result i64)\n";
    o = o + "    (call $__fern_mono_now))\n";
  }
  return o;
}

pub function clock_resolution_func_p2(): string {
  let o: string = "  (func $__fern_clock_resolution (result i64)\n";
  o = o + "    (local $base i32) (local $ra i32) (local $v i64)\n";
  o = o + p2_return_area("16");
  o = o + "    (call $__fern_wall_resolution (local.get $ra))\n";
  o = o + "    (local.set $v (i64.add (i64.mul (i64.load (local.get $ra)) (i64.const 1000000000)) (i64.extend_i32_u (i32.load (i32.add (local.get $ra) (i32.const 8))))))\n";
  o = o + "    (call $__fern_raw_free (local.get $base) (i32.const 16))\n";
  return o + "    (local.get $v))\n";
}

pub function random_imports_p2(): string {
  return "  (import \"wasi:random/random@0.2.0\" \"get-random-u64\" (func $__fern_get_random_u64 (result i64)))\n";
}

pub function random_func_p2(): string {
  let o: string = "";
  o = o + "  (func $__fern_random_bytes (param $n i32) (result i32)\n";
  o = o + "    (local $arr i32) (local $i i32) (local $r i64)\n";
  o = o + "    (local.set $arr (call $__fern_arr_elems (local.get $n) (i32.const 1)))\n";
  o = o + "    (i32.store (local.get $arr) (local.get $n))\n";
  o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $n))\n";
  o = o + "    (local.set $i (i32.const 0))\n";
  o = o + "    (block $d (loop $c\n";
  o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))\n";
  o = o + "      (if (i32.eqz (i32.and (local.get $i) (i32.const 7))) (then (local.set $r (call $__fern_get_random_u64))))\n";
  o = o + "      (i32.store8 (i32.add (i32.add (local.get $arr) (i32.const 8)) (local.get $i)) (i32.wrap_i64 (i64.shr_u (local.get $r) (i64.extend_i32_u (i32.mul (i32.and (local.get $i) (i32.const 7)) (i32.const 8))))))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "      (br $c)))\n";
  o = o + "    (local.get $arr))\n";
  o = o + "  (func $__fern_random_i32 (result i32)\n";
  o = o + "    (i32.wrap_i64 (call $__fern_get_random_u64)))\n";
  return o;
}

pub function env_imports_p2(): string {
  return "  (import \"wasi:cli/environment@0.2.0\" \"get-environment\" (func $__fern_get_environment (param i32)))\n";
}

pub function env_func_p2(): string {
  let o: string = "";
  o = o + "  (func $__fern_env (param $np i32) (result i32)\n";
  o = o + "    (local $base i32) (local $ra i32) (local $ptr i32) (local $count i32) (local $nlen i32)\n";
  o = o + "    (local $i i32) (local $tup i32) (local $kp i32) (local $kl i32)\n";
  o = o + "    (local $vp i32) (local $vl i32) (local $ok i32) (local $j i32) (local $res i32) (local $tmp i32)\n";
  o = o + "    (local.set $nlen (i32.load (local.get $np)))\n";
  o = o + p2_return_area("16");
  o = o + "    (call $__fern_get_environment (local.get $ra))\n";
  o = o + "    (local.set $ptr (i32.load (local.get $ra)))\n";
  o = o + "    (local.set $count (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
  o = o + "    (local.set $i (i32.const 0))\n";
  o = o + "    (block $done (loop $cont\n";
  o = o + "      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))\n";
  o = o + "      (local.set $tup (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 16))))\n";
  o = o + "      (local.set $kp (i32.load (local.get $tup)))\n";
  o = o + "      (local.set $kl (i32.load (i32.add (local.get $tup) (i32.const 4))))\n";
  o = o + "      (if (i32.eq (local.get $kl) (local.get $nlen)) (then\n";
  o = o + "        (local.set $ok (i32.const 1))\n";
  o = o + "        (local.set $j (i32.const 0))\n";
  o = o + "        (block $md (loop $mc\n";
  o = o + "          (br_if $md (i32.ge_u (local.get $j) (local.get $nlen)))\n";
  o = o + "          (if (i32.ne (i32.load8_u (i32.add (local.get $kp) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $np) (i32.const 4)) (local.get $j)))) (then (local.set $ok (i32.const 0)) (br $md)))\n";
  o = o + "          (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o = o + "          (br $mc)))\n";
  o = o + "        (if (local.get $ok) (then\n";
  o = o + "          (local.set $vp (i32.load (i32.add (local.get $tup) (i32.const 8))))\n";
  o = o + "          (local.set $vl (i32.load (i32.add (local.get $tup) (i32.const 12))))\n";
  o = o + "          (local.set $res (call $__fern_str_box (i32.add (i32.const 4) (local.get $vl))))\n";
  o = o + "          (i32.store (local.get $res) (local.get $vl))\n";
  o = o + "          (local.set $j (i32.const 0))\n";
  o = o + "          (block $cd (loop $cc\n";
  o = o + "            (br_if $cd (i32.ge_u (local.get $j) (local.get $vl)))\n";
  o = o + "            (i32.store8 (i32.add (i32.add (local.get $res) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $vp) (local.get $j))))\n";
  o = o + "            (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o = o + "            (br $cc)))\n";
  o = o + "          (br $done)))))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "      (br $cont)))\n";
  o = o + free_env_list_p2();
  o = o + "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
  o = o + "    (i32.store (local.get $tmp) (i32.eqz (local.get $res)))\n";
  o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $res))\n";
  o = o + "    (local.get $tmp))\n";
  return o;
}

pub function config_imports_p2(): string {
  return "  (import \"wasi:config/store@0.2.0-rc.1\" \"get\" (func $__fern_config_get (param i32 i32 i32)))\n";
}

pub function config_env_func_p2(): string {
  let o: string = "";
  o = o + "  (func $__fern_env (param $np i32) (result i32)\n";
  o = o + "    (local $base i32) (local $ra i32) (local $vp i32) (local $vl i32) (local $j i32) (local $res i32) (local $tmp i32)\n";
  o = o + p2_return_area("24");
  o = o + "    (call $__fern_config_get (i32.add (local.get $np) (i32.const 4)) (i32.load (local.get $np)) (local.get $ra))\n";
  o = o + "    (if (i32.and (i32.eqz (i32.load8_u (local.get $ra))) (i32.eq (i32.load8_u (i32.add (local.get $ra) (i32.const 4))) (i32.const 1))) (then\n";
  o = o + "      (local.set $vp (i32.load (i32.add (local.get $ra) (i32.const 8))))\n";
  o = o + "      (local.set $vl (i32.load (i32.add (local.get $ra) (i32.const 12))))\n";
  o = o + "      (local.set $res (call $__fern_str_box (i32.add (i32.const 4) (local.get $vl))))\n";
  o = o + "      (i32.store (local.get $res) (local.get $vl))\n";
  o = o + "      (local.set $j (i32.const 0))\n";
  o = o + "      (block $cd (loop $cc\n";
  o = o + "        (br_if $cd (i32.ge_u (local.get $j) (local.get $vl)))\n";
  o = o + "        (i32.store8 (i32.add (i32.add (local.get $res) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $vp) (local.get $j))))\n";
  o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o = o + "        (br $cc)))))\n";
  o = o + "    (if (i32.or (i32.load8_u (local.get $ra)) (i32.load8_u (i32.add (local.get $ra) (i32.const 4)))) (then\n";
  o = o + "      (call $__fern_raw_free (i32.load (i32.add (local.get $ra) (i32.const 8))) (i32.load (i32.add (local.get $ra) (i32.const 12))))))\n";
  o = o + "    (call $__fern_raw_free (local.get $base) (i32.const 24))\n";
  o = o + "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
  o = o + "    (i32.store (local.get $tmp) (i32.eqz (local.get $res)))\n";
  o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $res))\n";
  o = o + "    (local.get $tmp))\n";
  return o;
}

function module_is_proxy(mod: parser.Module): boolean {
  for e in mod.exports {
    if (e.iface == "wasi:http/incoming-handler@0.2.0") {
      return true;
    }
  }
  return false;
}

pub function args_imports_p2(): string {
  return "  (import \"wasi:cli/environment@0.2.0\" \"get-arguments\" (func $__fern_get_arguments (param i32)))\n";
}

pub function args_func_p2(set_args: boolean): string {
  let o: string = "";
  o = o + "  (func $__fern_args (result i32)\n";
  o = o + "    (local $base i32) (local $ra i32) (local $ptr i32) (local $count i32) (local $arr i32)\n";
  o = o + "    (local $i i32) (local $sp i32) (local $sl i32) (local $blk i32) (local $j i32)\n";
  o = o + args_set_answer(set_args);
  o = o + p2_return_area("16");
  o = o + "    (call $__fern_get_arguments (local.get $ra))\n";
  o = o + "    (local.set $ptr (i32.load (local.get $ra)))\n";
  o = o + "    (local.set $count (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
  o = o + "    (local.set $arr (call $__fern_arr_elems (local.get $count) (i32.const 4)))\n";
  o = o + "    (i32.store (local.get $arr) (local.get $count))\n";
  o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $count))\n";
  o = o + "    (local.set $i (i32.const 0))\n";
  o = o + "    (block $d (loop $c\n";
  o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $count)))\n";
  o = o + "      (local.set $sp (i32.load (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 8)))))\n";
  o = o + "      (local.set $sl (i32.load (i32.add (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 8))) (i32.const 4))))\n";
  o = o + "      (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $sl))))\n";
  o = o + "      (i32.store (local.get $blk) (local.get $sl))\n";
  o = o + "      (local.set $j (i32.const 0))\n";
  o = o + "      (block $cd (loop $cc\n";
  o = o + "        (br_if $cd (i32.ge_u (local.get $j) (local.get $sl)))\n";
  o = o + "        (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $sp) (local.get $j))))\n";
  o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o = o + "        (br $cc)))\n";
  o = o + "      (call $__fern_raw_free (local.get $sp) (local.get $sl))\n";
  o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (local.get $blk))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "      (br $c)))\n";
  o = o + "    (call $__fern_raw_free (local.get $ptr) (i32.mul (local.get $count) (i32.const 8)))\n";
  o = o + "    (call $__fern_raw_free (local.get $base) (i32.const 16))\n";
  o = o + "    (local.get $arr))\n";
  return o;
}

pub function environ_func_p2(): string {
  let o: string = "";
  o = o + "  (func $__fern_environ (result i32)\n";
  o = o + "    (local $base i32) (local $ra i32) (local $ptr i32) (local $count i32) (local $arr i32)\n";
  o = o + "    (local $i i32) (local $tp i32) (local $tup i32) (local $kl i32) (local $vl i32) (local $blk i32) (local $j i32)\n";
  o = o + p2_return_area("16");
  o = o + "    (call $__fern_get_environment (local.get $ra))\n";
  o = o + "    (local.set $ptr (i32.load (local.get $ra)))\n";
  o = o + "    (local.set $count (i32.load (i32.add (local.get $ra) (i32.const 4))))\n";
  o = o + "    (local.set $arr (call $__fern_arr_elems (local.get $count) (i32.const 4)))\n";
  o = o + "    (i32.store (local.get $arr) (local.get $count))\n";
  o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $count))\n";
  o = o + "    (local.set $i (i32.const 0))\n";
  o = o + "    (block $d (loop $c\n";
  o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $count)))\n";
  o = o + "      (local.set $tp (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 16))))\n";
  o = o + "      (local.set $kl (i32.load (i32.add (local.get $tp) (i32.const 4))))\n";
  o = o + "      (local.set $vl (i32.load (i32.add (local.get $tp) (i32.const 12))))\n";
  o = o + "      (local.set $blk (call $__fern_str_box (i32.add (i32.const 5) (i32.add (local.get $kl) (local.get $vl)))))\n";
  o = o + "      (i32.store (local.get $blk) (i32.add (i32.add (local.get $kl) (local.get $vl)) (i32.const 1)))\n";
  o = o + "      (local.set $j (i32.const 0))\n";
  o = o + "      (block $kd (loop $kc\n";
  o = o + "        (br_if $kd (i32.ge_u (local.get $j) (local.get $kl)))\n";
  o = o + "        (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (i32.load (local.get $tp)) (local.get $j))))\n";
  o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o = o + "        (br $kc)))\n";
  o = o + "      (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $kl)) (i32.const 61))\n";
  o = o + "      (local.set $j (i32.const 0))\n";
  o = o + "      (block $vd (loop $vc\n";
  o = o + "        (br_if $vd (i32.ge_u (local.get $j) (local.get $vl)))\n";
  o = o + "        (i32.store8 (i32.add (i32.add (i32.add (local.get $blk) (i32.const 5)) (local.get $kl)) (local.get $j)) (i32.load8_u (i32.add (i32.load (i32.add (local.get $tp) (i32.const 8))) (local.get $j))))\n";
  o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o = o + "        (br $vc)))\n";
  o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (local.get $blk))\n";
  o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
  o = o + "      (br $c)))\n";
  o = o + free_env_list_p2();
  o = o + "    (local.get $arr))\n";
  return o;
}

pub function fs_imports_p2(needs: string[]): string {
  let o: string = "";
  for g in fs_import_gates_p2(needs) {
    if (g.on) {
      o = o + "  (import \"" + g.text + "\n";
    }
  }
  return o;
}

struct GatedImport { on: boolean, text: string }

function fs_import_gates_p2(needs: string[]): GatedImport[] {
  let t: string = "wasi:filesystem/types@0.2.0\" \"[method]descriptor.";
  let r: string = "wasi:filesystem/types@0.2.0\" \"[resource-drop]";
  let s: string = "wasi:io/streams@0.2.0\" \"";
  let rd: boolean = need_read_file(needs);
  let wr: boolean = need_write_file(needs);
  let files: boolean = need_open_file(needs);
  return [
    GatedImport { on: need_preopen_p2(needs), text: "wasi:filesystem/preopens@0.2.0\" \"get-directories\" (func $__fern_get_directories (param i32)))" },
    GatedImport { on: need_open_at_p2(needs), text: t + "open-at\" (func $__fern_open_at (param i32 i32 i32 i32 i32 i32 i32)))" },
    GatedImport { on: need_preopen_p2(needs), text: r + "descriptor\" (func $__fern_desc_drop (param i32)))" },
    GatedImport { on: rd || files, text: t + "read-via-stream\" (func $__fern_read_via_stream (param i32 i64 i32)))" },
    GatedImport { on: rd || need_fd_read(needs), text: s + "[method]input-stream.blocking-read\" (func $__fern_blocking_read (param i32 i64 i32)))" },
    GatedImport { on: need_in_drop_p2(needs), text: s + "[resource-drop]input-stream\" (func $__fern_in_strm_drop (param i32)))" },
    GatedImport { on: wr || files, text: t + "write-via-stream\" (func $__fern_write_via_stream (param i32 i64 i32)))" },
    GatedImport { on: need_out_drop_p2(needs), text: s + "[resource-drop]output-stream\" (func $__fern_out_strm_drop (param i32)))" },
    GatedImport { on: files, text: t + "append-via-stream\" (func $__fern_append_via_stream (param i32 i32)))" },
    GatedImport { on: files_need(needs, ["fd_stat", "reader_seek"]), text: t + "stat\" (func $__fern_desc_stat (param i32 i32)))" },
    GatedImport { on: need_any(needs, ["stat", "lstat"]), text: t + "stat-at\" (func $__fern_stat_at (param i32 i32 i32 i32 i32)))" },
    GatedImport { on: need(needs, "truncate") || files_need(needs, ["writer_truncate"]), text: t + "set-size\" (func $__fern_desc_set_size (param i32 i64 i32)))" },
    GatedImport { on: files_need(needs, ["fd_fsync"]), text: t + "sync\" (func $__fern_desc_sync (param i32 i32)))" },
    GatedImport { on: files_need(needs, ["fd_fdatasync"]), text: t + "sync-data\" (func $__fern_desc_sync_data (param i32 i32)))" },
    GatedImport { on: files_need(needs, ["fd_drop_cache"]), text: t + "advise\" (func $__fern_desc_advise (param i32 i64 i64 i32 i32)))" },
    GatedImport { on: need(needs, "set_file_times"), text: t + "set-times-at\" (func $__fern_set_times_at (param i32 i32 i32 i32 i32 i64 i32 i32 i64 i32 i32)))" },
    GatedImport { on: need_any(needs, ["create_dir", "create_dir_all", "temp_dir"]), text: t + "create-directory-at\" (func $__fern_create_directory_at (param i32 i32 i32 i32)))" },
    GatedImport { on: need_any(needs, ["remove_file", "remove_dir_all"]), text: t + "unlink-file-at\" (func $__fern_unlink_file_at (param i32 i32 i32 i32)))" },
    GatedImport { on: need_any(needs, ["remove_dir", "remove_dir_all"]), text: t + "remove-directory-at\" (func $__fern_remove_directory_at (param i32 i32 i32 i32)))" },
    GatedImport { on: need(needs, "rename"), text: t + "rename-at\" (func $__fern_rename_at (param i32 i32 i32 i32 i32 i32 i32)))" },
    GatedImport { on: need(needs, "create_link"), text: t + "link-at\" (func $__fern_link_at (param i32 i32 i32 i32 i32 i32 i32 i32)))" },
    GatedImport { on: need(needs, "create_symlink"), text: t + "symlink-at\" (func $__fern_symlink_at (param i32 i32 i32 i32 i32 i32)))" },
    GatedImport { on: need(needs, "read_link"), text: t + "readlink-at\" (func $__fern_readlink_at (param i32 i32 i32 i32)))" },
    GatedImport { on: need_dir_list(needs), text: t + "read-directory\" (func $__fern_read_directory (param i32 i32)))" },
    GatedImport { on: need_dir_list(needs), text: "wasi:filesystem/types@0.2.0\" \"[method]directory-entry-stream.read-directory-entry\" (func $__fern_read_dir_entry (param i32 i32)))" },
    GatedImport { on: need_dir_list(needs), text: r + "directory-entry-stream\" (func $__fern_dir_strm_drop (param i32)))" },
    GatedImport { on: need_stdin_p2(needs), text: "wasi:cli/stdin@0.2.0\" \"get-stdin\" (func $__fern_get_stdin (result i32)))" },
  ];
}

function files_need(needs: string[], ops: string[]): boolean {
  return need_open_file(needs) && need_any(needs, ops);
}

function need_in_drop_p2(needs: string[]): boolean {
  let ins: boolean = need_open_file(needs) || need(needs, "@stdin");
  return need_read_file(needs) || ins && need_any(needs, ["reader_close", "reader_seek"]);
}

function need_out_drop_p2(needs: string[]): boolean {
  return need_write_file(needs) || need(needs, "reader_close") || files_need(needs, ["reader_seek"]);
}

function need_stdin_p2(needs: string[]): boolean {
  return need(needs, "@stdin") && need_fd_read(needs);
}

function need_read_file(needs: string[]): boolean {
  return need(needs, "read_file") || need(needs, "read_file_bytes");
}

function need_write_file(needs: string[]): boolean {
  return need(needs, "write_file") || need(needs, "write_file_bytes");
}

function need_fd_read(needs: string[]): boolean {
  return need_any(needs, ["read_chunk", "read_chunk_bytes"]);
}

function need_dir_list(needs: string[]): boolean {
  return need_any(needs, ["read_dir", "read_dir_all", "read_dir_ino", "read_dir_ino_all", "remove_dir_all"]);
}

function need_open_at_p2(needs: string[]): boolean {
  return need_read_file(needs) || need_write_file(needs) || need_open_file(needs) || need(needs, "truncate") || need_dir_list(needs);
}

function need_preopen_p2(needs: string[]): boolean {
  return need_open_at_p2(needs) || need_any(needs, [
    "stat", "lstat", "create_dir", "create_dir_all", "remove_file", "remove_dir", "rename",
    "read_link", "create_symlink", "create_link", "set_file_times", "temp_dir",
  ]);
}

function need_fd_table(needs: string[]): boolean {
  return need_open_file(needs) || need_fd_read(needs) || need_any(needs, [
    "reader_close", "fd_stat", "fd_fsync", "fd_fdatasync", "fd_drop_cache", "reader_seek", "fd_flags", "writer_truncate",
  ]);
}

function component_fs_needs(): string[] {
  return [
    "open_file", "open_with", "reader_close", "read_chunk", "read_chunk_bytes",
    "fd_stat", "fd_fsync", "fd_fdatasync", "fd_drop_cache", "reader_seek", "fd_flags", "writer_truncate",
    "stat", "lstat", "read_dir", "read_dir_all", "read_dir_ino", "read_dir_ino_all", "create_dir", "create_dir_all", "remove_file",
    "remove_dir", "remove_dir_all", "rename", "read_link", "create_symlink", "create_link",
    "truncate", "set_file_times", "temp_dir",
  ];
}

function component_admits_fs(n: string): boolean {
  return util.has_str(component_fs_needs(), n) || util.has_str(["fd_syncfs", "fd_dup_onto", "reader_splice", "reader_copy_range", "writer_splice_forever"], n);
}

pub function component_framable(needs: string[]): boolean {
  return !need_any(needs, component_fs_needs());
}

pub function component_fs_shims(needs: string[], stderr: boolean): string {
  let files: boolean = need_open_file(needs);
  let o: string = "";
  if (need_preopen_p2(needs)) {
    o = o + preopen_func_p2();
  }
  if (need_fd_table(needs)) {
    o = o + fd_table_funcs();
  }
  if (need_any(needs, ["stat", "lstat"]) || files && need(needs, "fd_stat")) {
    o = o + filestat_func_p2();
  }
  if (files) {
    o = o + is_dir_at_func_p2() + path_open_shim();
  }
  if (need_fd_read(needs)) {
    o = o + fd_read_shim(need(needs, "@stdin"));
  }
  if (need(needs, "reader_close")) {
    o = o + fd_close_shim(files, files || need(needs, "@stdin"), stderr);
  }
  return o + fd_query_shims(needs, files) + path_shims(needs);
}

function fd_query_shims(needs: string[], files: boolean): string {
  let o: string = "";
  if (need(needs, "fd_stat")) {
    o = o + desc_shim("fd_filestat_get", "(param $buf i32)", files, "desc_stat", "", "104", "8");
  }
  if (need(needs, "fd_fsync")) {
    o = o + desc_shim("fd_sync", "", files, "desc_sync", "", "8", "1");
  }
  if (need(needs, "fd_fdatasync")) {
    o = o + desc_shim("fd_datasync", "", files, "desc_sync_data", "", "8", "1");
  }
  if (need(needs, "fd_drop_cache")) {
    o = o + desc_shim("fd_advise", "(param $off i64) (param $len i64) (param $adv i32)", files, "desc_advise", " (local.get $off) (local.get $len) (local.get $adv)", "8", "1");
  }
  if (need(needs, "writer_truncate")) {
    o = o + desc_shim("fd_filestat_set_size", "(param $len i64)", files, "desc_set_size", " (local.get $len)", "8", "1");
  }
  if (need(needs, "reader_seek")) {
    o = o + fd_seek_shim(files);
  }
  if (need(needs, "fd_flags")) {
    o = o + fd_fdstat_shim();
  }
  return o;
}

function path_shims(needs: string[]): string {
  let o: string = "";
  if (need_any(needs, ["stat", "lstat"])) {
    o = o + path_filestat_shim();
  }
  for sh in path_mutator_shims() {
    if (need_any(needs, sh.ops)) {
      o = o + path_shim(sh.name, sh.sig, sh.method, sh.args);
    }
  }
  if (need(needs, "read_link")) {
    o = o + path_readlink_shim();
  }
  if (need_dir_list(needs)) {
    o = o + dir_names_func_p2();
  }
  return o;
}

function p2_preopen(bytes: string): string {
  return "    (local.set $pre (call $__fern_preopen_p2))\n"
    + "    (if (i32.lt_s (local.get $pre) (i32.const 0)) (then (return (i32.const 44))))\n"
    + "    (local.set $ra (call $__fern_alloc (i32.const " + bytes + ")))\n";
}

function p2_fail_ret(off: string, bytes: string): string {
  return "    (if (i32.load8_u (local.get $ra)) (then\n"
    + "      (local.set $err (call $__fern_errno_p2 (i32.load8_u offset=" + off + " (local.get $ra))))\n"
    + "      (call $__fern_raw_free (local.get $ra) (i32.const " + bytes + "))\n"
    + "      (return (local.get $err))))\n";
}

function p2_ok_ret(bytes: string): string {
  return "    (call $__fern_raw_free (local.get $ra) (i32.const " + bytes + "))\n    (i32.const 0))\n";
}

function preopen_func_p2(): string {
  let o: string = "  (global $__fern_preopen (mut i32) (i32.const -2))\n";
  o = o + "  (func $__fern_preopen_p2 (result i32)\n";
  o = o + "    (local $ra i32) (local $dirs i32) (local $count i32) (local $i i32) (local $entry i32)\n";
  o = o + "    (if (i32.eq (global.get $__fern_preopen) (i32.const -2)) (then\n";
  o = o + "      (local.set $ra (call $__fern_alloc (i32.const 8)))\n";
