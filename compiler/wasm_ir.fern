pub function module_uses_aes_gcm(cache: irtables.LowerResult[]): boolean {
  return module_emits_op_cached(cache, "aes_expand_key") || module_emits_op_cached(cache, "aes_ctr32") || module_emits_op_cached(cache, "ghash")
    || module_emits_op_cached(cache, "aes_gcm_seal_into") || module_emits_op_cached(cache, "aes_gcm_open_into");
}

