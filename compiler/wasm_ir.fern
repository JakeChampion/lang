  o += "    (local.set $size (i64.mul (i64.extend_i32_u (local.get $rows)) (i64.extend_i32_u (local.get $columns))))\n";
  o += "    (if (i64.gt_u (local.get $size) (i64.const 2147483647)) (then (call $__fern_abort_alloc) (unreachable)))\n";
  o += "    (local.set $out (call $__fern_arr_elems (i32.wrap_i64 (local.get $size)) (i32.const 8)))\n    (i32.store (local.get $out) (i32.wrap_i64 (local.get $size)))\n    (i32.store offset=4 (local.get $out) (i32.wrap_i64 (local.get $size)))\n";
  o += "    (if (i64.eqz (local.get $size)) (then (return (local.get $out))))\n    (local.set $p (i32.add (local.get $out) (i32.const 8)))\n";
  o += "    (block $done (loop $row_loop\n      (br_if $done (i32.ge_u (local.get $row) (local.get $rows)))\n      (local.set $col (i32.const 0))\n      (local.set $left (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (i32.mul (local.get $row) (local.get $extent)) (i32.const 8))))\n";
  o += "      (block $tail (loop $pair\n        (br_if $tail (i32.ge_u (i32.add (local.get $col) (i32.const 1)) (local.get $columns)))\n        (local.set $right (i32.add (i32.add (local.get $b) (i32.const 8)) (i32.mul (local.get $col) (i32.const 8))))\n        (local.set $acc (f64x2.splat (local.get $init)))\n        (local.set $k (i32.const 0))\n";
  o += "        (block $store (loop $dot\n          (br_if $store (i32.ge_u (local.get $k) (local.get $extent)))\n          (local.set $acc (f64x2.add (local.get $acc) (f64x2.mul (f64x2.splat (f64.load (i32.add (local.get $left) (i32.mul (local.get $k) (i32.const 8))))) (v128.load (local.get $right)))))\n          (local.set $right (i32.add (local.get $right) (i32.mul (local.get $columns) (i32.const 8))))\n          (local.set $k (i32.add (local.get $k) (i32.const 1)))\n          (br $dot)))\n";
  o += "        (v128.store (local.get $p) (local.get $acc))\n        (local.set $p (i32.add (local.get $p) (i32.const 16)))\n        (local.set $col (i32.add (local.get $col) (i32.const 2)))\n        (br $pair)))\n";
  o += "      (if (i32.lt_u (local.get $col) (local.get $columns)) (then\n        (local.set $right (i32.add (i32.add (local.get $b) (i32.const 8)) (i32.mul (local.get $col) (i32.const 8))))\n        (local.set $sacc (local.get $init))\n        (local.set $k (i32.const 0))\n";
  o += "        (block $scalar_store (loop $scalar\n          (br_if $scalar_store (i32.ge_u (local.get $k) (local.get $extent)))\n          (local.set $sacc (f64.add (local.get $sacc) (f64.mul (f64.load (i32.add (local.get $left) (i32.mul (local.get $k) (i32.const 8)))) (f64.load (local.get $right)))))\n          (local.set $right (i32.add (local.get $right) (i32.mul (local.get $columns) (i32.const 8))))\n          (local.set $k (i32.add (local.get $k) (i32.const 1)))\n          (br $scalar)))\n        (f64.store (local.get $p) (local.get $sacc))\n        (local.set $p (i32.add (local.get $p) (i32.const 8)))))\n";
  o += "      (local.set $row (i32.add (local.get $row) (i32.const 1)))\n      (br $row_loop)))\n    (local.get $out))\n";
  return o;
