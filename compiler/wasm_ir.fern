  o += "          (if (i32.eq (i32.load8_u offset=4 (local.get $ret)) (i32.const 8))\n";
  o += "            (then (local.set $e (i32.const -26)))\n";
  o += "            (else (local.set $e (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=4 (local.get $ret))))))))\n";
  o += "        (else\n";
  o += "          (i32.store offset=4 (local.get $c) (i32.load offset=4 (local.get $ret)))\n";
  o += "          (i32.store offset=8 (local.get $c) (i32.load offset=8 (local.get $ret)))\n";
  o += "          (i32.store offset=12 (local.get $c) (i32.const 1))\n";
  o += "          (local.set $e (i32.const 0))))\n";
  o += "      (call $__fern_raw_free (local.get $ret) (i32.const 16))\n";
  o += "      (return (local.get $e))))\n";
  o += "    (if (i32.and (i32.ne (local.get $op) (i32.const 2)) (i32.ne (local.get $op) (i32.const 4))) (then (return (i32.const -28))))\n";
  o += "    (local.set $ret (call $__fern_alloc (i32.const 4)))\n";
  o += "    (if (i32.eq (local.get $op) (i32.const 2))\n";
  o += "      (then (call $__fern_wasi_tcp_set_keep_alive_enabled (i32.load (local.get $c)) (i32.ne (local.get $arg) (i32.const 0)) (local.get $ret)))\n";
  o += "      (else (call $__fern_wasi_tcp_shutdown (i32.load (local.get $c)) (local.get $arg) (local.get $ret))))\n";
  o += "    (if (i32.load8_u (local.get $ret))\n";
  o += "      (then (local.set $e (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=1 (local.get $ret))))))\n";
  o += "      (else (local.set $e (i32.const 0))))\n";
  o += "    (call $__fern_raw_free (local.get $ret) (i32.const 4))\n";
  o += "    (local.get $e))\n";
  return o;
}

function peer_word(at: i32, swapped: boolean): string {
  let order: i32[] = [0, 1, 2, 3];
  if (swapped) {
    order = [1, 0, 3, 2];
  }
  let o = "";
  for n in 0..4 {
    let b = "(i32.load8_u offset=" + util.i32_to_string(at + order[n]) + " (local.get $ret))";
    if (n > 0) {
      b = "(i32.shl " + b + " (i32.const " + util.i32_to_string(8 * n) + "))";
    }
    if (n == 0) {
      o = b;
    } else {
      o = "(i32.or " + o + " " + b + ")";
    }
  }
  return o;
}

pub function tcp_accept_func(): string {
  return "  (func $__fern_tcp_accept (param $l i32) (result i32)\n    (call $__fern_tcp_accept_with (local.get $l) (i32.const 0)))\n";
}

// The accepted record's blocking flag (offset 16) is the caller's nonblocking
// argument; wasi:sockets has no accept4, so the flag is all the argument sets.
pub function tcp_accept_with_func(): string {
  let o = "";
  o += "  (func $__fern_tcp_accept_with (param $l i32) (param $nb i32) (result i32)\n";
  o += "    (local $sock i32) (local $p i32) (local $ret i32) (local $st i32) (local $e i32)\n";
  o += closed_socket_guard("l");
  o += "    (local.set $sock (i32.load (local.get $l)))\n";
  o += "    (if (i32.eqz (i32.load offset=12 (local.get $l))) (then\n";
  o += "      (if (i32.eqz (i32.load offset=16 (local.get $l))) (then\n";
  o += "        (local.set $p (call $__fern_wasi_tcp_subscribe (local.get $sock)))\n";
  o += "        (call $__fern_wasi_pollable_block (local.get $p))\n";
  o += "        (call $__fern_wasi_pollable_drop (local.get $p))))))\n";
  o += "    (local.set $ret (call $__fern_alloc (i32.const 20)))\n";
  o += "    (call $__fern_wasi_tcp_accept (local.get $sock) (local.get $ret))\n";
  o += "    (if (i32.load8_u (local.get $ret)) (then\n";
  o += "      (local.set $e (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=4 (local.get $ret)))))\n";
  o += "      (call $__fern_raw_free (local.get $ret) (i32.const 20))\n";
  o += "      (return (local.get $e))))\n";
  o += "    (local.set $st (local.get $ret))\n";
  o += "    (i32.store (local.get $st) (i32.load offset=4 (local.get $ret)))\n";
  o += "    (i32.store offset=4 (local.get $st) (i32.load offset=8 (local.get $ret)))\n";
  o += "    (i32.store offset=8 (local.get $st) (i32.load offset=12 (local.get $ret)))\n";
  o += "    (i32.store offset=12 (local.get $st) (i32.const 1))\n";
  o += "    (i32.store offset=16 (local.get $st) (i32.ne (local.get $nb) (i32.const 0)))\n";
  o += "    (local.get $st))\n";
  return o;
}

