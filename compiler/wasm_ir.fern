  o = o + "    (global.get $__fern_net))\n";
  return o;
}

pub function ip_flat_func(): string {
  let o: string = "";
  o = o + "  (func $__fern_ip_flat (param $addr i32) (param $port i32) (param $out i32) (result i32)\n";
  o = o + "    (local $len i32) (local $k i32)\n";
  o = o + "    (local.set $len (i32.load (local.get $addr)))\n";
  o = o + "    (local.set $k (i32.const 0))\n";
  o = o + "    (block $z (loop $zl (br_if $z (i32.ge_u (local.get $k) (i32.const 48)))\n";
  o = o + "      (i32.store (i32.add (local.get $out) (local.get $k)) (i32.const 0))\n";
  o = o + "      (local.set $k (i32.add (local.get $k) (i32.const 4))) (br $zl)))\n";
  o = o + "    (i32.store offset=4 (local.get $out) (local.get $port))\n";
  o = o + "    (if (i32.eq (local.get $len) (i32.const 4)) (then\n";
  o = o + "      (local.set $k (i32.const 0))\n";
  o = o + "      (block $a (loop $al (br_if $a (i32.ge_u (local.get $k) (i32.const 4)))\n";
  o = o + "        (i32.store (i32.add (i32.add (local.get $out) (i32.const 8)) (i32.mul (local.get $k) (i32.const 4)))\n";
  o = o + "          (i32.load8_u offset=8 (i32.add (local.get $addr) (local.get $k))))\n";
  o = o + "        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $al)))\n";
  o = o + "      (return (i32.const 0))))\n";
  o = o + "    (if (i32.eq (local.get $len) (i32.const 16)) (then\n";
  o = o + "      (i32.store (local.get $out) (i32.const 1))\n";
  o = o + "      (local.set $k (i32.const 0))\n";
  o = o + "      (block $b (loop $bl (br_if $b (i32.ge_u (local.get $k) (i32.const 8)))\n";
  o = o + "        (i32.store (i32.add (i32.add (local.get $out) (i32.const 12)) (i32.mul (local.get $k) (i32.const 4)))\n";
  o = o + "          (i32.or (i32.shl (i32.load8_u offset=8 (i32.add (local.get $addr) (i32.mul (local.get $k) (i32.const 2)))) (i32.const 8))\n";
  o = o + "                  (i32.load8_u offset=9 (i32.add (local.get $addr) (i32.mul (local.get $k) (i32.const 2))))))\n";
  o = o + "        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $bl)))\n";
  o = o + "      (return (i32.const 0))))\n";
  o = o + "    (i32.const -5))\n";
  return o;
}

function ip_flat_prologue(): string {
  let o: string = "";
  o = o + "    (local.set $flat (i32.const " + util.i32_to_string(ip_flat_addr()) + "))\n";
  o = o + "    (local.set $tmp (call $__fern_ip_flat (local.get $addr) (local.get $port) (local.get $flat)))\n";
  o = o + "    (if (local.get $tmp) (then (return (local.get $tmp))))\n";
  return o;
}

function ip_flat_words(): string {
  return "      (i32.load offset=0 (local.get $flat))\n      (i32.load offset=4 (local.get $flat))\n      (i32.load offset=8 (local.get $flat))\n      (i32.load offset=12 (local.get $flat))\n      (i32.load offset=16 (local.get $flat))\n      (i32.load offset=20 (local.get $flat))\n      (i32.load offset=24 (local.get $flat))\n      (i32.load offset=28 (local.get $flat))\n      (i32.load offset=32 (local.get $flat))\n      (i32.load offset=36 (local.get $flat))\n      (i32.load offset=40 (local.get $flat))\n      (i32.load offset=44 (local.get $flat))\n";
}

pub function tcp_connect_with_func(): string {
  let o: string = "";
  o = o + "  (func $__fern_tcp_connect_with (param $addr i32) (param $port i32) (param $nb i32) (result i32)\n";
  o = o + "    (local $sock i32) (local $ret i32) (local $st i32) (local $e i32) (local $p i32) (local $flat i32) (local $tmp i32)\n";
  o = o + ip_flat_prologue();
  o = o + "    (local.set $ret (call $__fern_alloc (i32.const 16)))\n";
  o = o + "    (call $__fern_wasi_create_tcp_socket (i32.load (local.get $flat)) (local.get $ret))\n";
  o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
  o = o + "      (local.set $e (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=4 (local.get $ret)))))\n";
  o = o + "      (call $__fern_raw_free (local.get $ret) (i32.const 16))\n";
  o = o + "      (return (local.get $e))))\n";
  o = o + "    (local.set $sock (i32.load offset=4 (local.get $ret)))\n";
  o = o + "    (call $__fern_wasi_tcp_start_connect (local.get $sock) (call $__fern_network_handle)\n";
  o = o + ip_flat_words();
  o = o + "      (local.get $ret))\n";
  o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
  o = o + "      (call $__fern_wasi_tcp_socket_drop (local.get $sock))\n";
  o = o + "      (local.set $e (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=1 (local.get $ret)))))\n";
  o = o + "      (call $__fern_raw_free (local.get $ret) (i32.const 16))\n";
  o = o + "      (return (local.get $e))))\n";
  o = o + "    (if (local.get $nb) (then\n";
  o = o + "      (i32.store (local.get $ret) (local.get $sock))\n";
  o = o + "      (i32.store offset=12 (local.get $ret) (i32.const 4))\n";
  o = o + "      (return (local.get $ret))))\n";
  o = o + "    (local.set $p (call $__fern_wasi_tcp_subscribe (local.get $sock)))\n";
  o = o + "    (call $__fern_wasi_pollable_block (local.get $p))\n";
  o = o + "    (call $__fern_wasi_pollable_drop (local.get $p))\n";
  o = o + "    (call $__fern_wasi_tcp_finish_connect (local.get $sock) (local.get $ret))\n";
  o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
  o = o + "      (call $__fern_wasi_tcp_socket_drop (local.get $sock))\n";
  o = o + "      (local.set $e (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=4 (local.get $ret)))))\n";
  o = o + "      (call $__fern_raw_free (local.get $ret) (i32.const 16))\n";
  o = o + "      (return (local.get $e))))\n";
  o = o + "    (local.set $st (local.get $ret))\n";
  o = o + "    (i32.store (local.get $st) (local.get $sock))\n";
  o = o + "    (i32.store offset=4 (local.get $st) (i32.load offset=4 (local.get $ret)))\n";
  o = o + "    (i32.store offset=8 (local.get $st) (i32.load offset=8 (local.get $ret)))\n";
  o = o + "    (i32.store offset=12 (local.get $st) (i32.const 1))\n";
  o = o + "    (local.get $st))\n";
  return o;
}

