pub function writer_bytes_func(all: boolean, p2: boolean): string {
  let name: string = "write_some_bytes";
  let more: string = "      (br $done)\n";
  let success: string = "    (local.set $res (call $__fern_str_box (i32.const 16))) (i32.store (local.get $res) (i32.const 0))\n    (i64.store offset=8 (local.get $res) (i64.extend_i32_u (local.get $count)))\n    (local.get $res)\n";
  if (all) {
    name = "write_bytes";
    more = "      (local.set $at (i32.add (local.get $at) (local.get $count)))\n      (br_if $done (i32.eq (local.get $at) (local.get $n)))\n      (if (i32.eqz (local.get $count)) (then (local.set $err (i32.const 29)) (br $done)))\n      (br $write)\n";
    success = "    (local.set $res (call $__fern_str_box (i32.const 8))) (i32.store (local.get $res) (i32.const 0))\n    (i32.store offset=4 (local.get $res) (i32.const 0))\n    (local.get $res)\n";
  }
  let o: string = "";
  o = o + "  (func $__fern_writer_" + name + " (param $fd i32) (param $bytes i32) (result i32)\n";
  o = o + "    (local $n i32) (local $data i32) (local $at i32) (local $count i32) (local $err i32) (local $res i32) (local $path i32)\n";
  o = o + "    (if (i32.and (local.get $bytes) (i32.const 2)) (then\n";
  o = o + "      (local.set $bytes (i32.sub (local.get $bytes) (i32.const 2)))\n";
  o = o + "      (local.set $data (i32.add (local.get $bytes) (i32.const 4))))\n";
  o = o + "    (else (local.set $data (i32.add (local.get $bytes) (i32.const 8)))))\n";
  o = o + "    (local.set $n (i32.load (local.get $bytes)))\n";
  o = o + "    (block $done (loop $write\n";
  o = o + "      (i32.store (i32.const 0) (i32.add (local.get $data) (local.get $at)))\n";
  o = o + "      (i32.store (i32.const 4) " + p2_chunk(p2, "(i32.sub (local.get $n) (local.get $at))") + ")\n";
  o = o + "      (local.set $err (call $__fern_fd_write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
  o = o + "      (br_if $done (local.get $err))\n";
  o = o + "      (local.set $count (i32.load (i32.const 8)))\n";
  o = o + more;
  o = o + "    ))\n";
  o = o + "    (if (local.get $err) (then\n";
  o = o + "      (local.set $path (call $__fern_str_box (i32.const 4))) (i32.store (local.get $path) (i32.const 0))\n";
  o = o + "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
  o = o + "      (i32.store (local.get $res) (i32.const 1))\n";
  o = o + "      (i32.store offset=4 (local.get $res) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
  o = o + "      (return (local.get $res))))\n";
  o = o + success;
  o = o + "  )\n";
  return o;
}

function p2_chunk(p2: boolean, n: string): string {
  if (!p2) {
    return n;
  }
  return "(select (i32.const 4096) " + n + " (i32.gt_u " + n + " (i32.const 4096)))";
}

