  o += "      (local.set $bits (i32.load offset=4 (i32.add (local.get $slots) (i32.mul (local.get $idx) (i32.const 8)))))\n";
  o += "      (if (i32.and (i32.ne (local.get $bits) (i32.const 0)) (i32.lt_u (local.get $out) (local.get $cap))) (then\n";
  o += "        (i32.store (i32.add (i32.add (local.get $events) (i32.const 8)) (i32.mul (local.get $out) (i32.const 8))) (i32.load (i32.add (local.get $slots) (i32.mul (local.get $idx) (i32.const 8)))))\n";
  o += "        (i32.store offset=4 (i32.add (i32.add (local.get $events) (i32.const 8)) (i32.mul (local.get $out) (i32.const 8))) (local.get $bits))\n";
  o += "        (local.set $out (i32.add (local.get $out) (i32.const 1)))))\n";
  o += "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
  o += "      (br $report)))\n";
  o += "    (if (i32.and (i32.ne (local.get $rc) (i32.const 0)) (i32.ne (local.get $rl) (i32.load offset=24 (local.get $r)))) (then (call $__fern_raw_free (local.get $rl) (i32.mul (local.get $rc) (i32.const 4)))))\n";
  o += "    (if (i32.ge_s (local.get $timeout) (i32.const 0)) (then (call $__fern_wasi_pollable_drop (local.get $timer))))\n";
  o += "    (local.get $out))\n";
  return o;
}

