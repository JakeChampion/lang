pub function udp_bind_func(): string {
  let o = "";
  let fail_head = "    (if (i32.load8_u (local.get $ret)) (then\n      (call $__fern_wasi_udp_socket_drop (local.get $sock))\n      ";
  let fail_tail = "\n      (call $__fern_raw_free (local.get $ret) (i32.const 16))\n      (return (local.get $e))))\n";
  o += "  (func $__fern_udp_bind (param $addr i32) (param $port i32) (result i32)\n";
