function emit_wasm_buf_op(o: ir.Op, parts: string[]): string[] {
  if (o.kind_tag == ir.K_BUF_PUSH_BYTES_MAPPED) {
    return parts.append("    call $__fern_buf_push_bytes_mapped\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_BYTES_FILTERED) {
    return parts.append("    call $__fern_buf_push_bytes_filtered\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_BYTES_EXPANDED) {
    return parts.append("    call $__fern_buf_push_bytes_expanded\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_TAKE_BYTES) {
    return parts.append("    call $__fern_buf_take_bytes\n");
  }
  if (o.kind_tag == ir.K_BUF_NEW) {
    return parts.append("    call $__fern_buf_new\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH) {
    return parts.append("    call $__fern_buf_push\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_RANGE) {
    return parts.append("    call $__fern_buf_push_range\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_BYTES_RANGE) {
    return parts.append("    call $__fern_buf_push_bytes_range\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_MAPPED) {
    return parts.append("    call $__fern_buf_push_mapped\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_FILTERED) {
    return parts.append("    call $__fern_buf_push_filtered\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_EXPANDED) {
    return parts.append("    call $__fern_buf_push_expanded\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_BYTE) {
    return parts.append("    call $__fern_buf_push_byte\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_U64) {
    return parts.append("    call $__fern_buf_push_u64\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_DECIMAL) {
    return parts.append("    call $__fern_buf_push_decimal\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_BASE64) {
    return parts.append("    call $__fern_buf_push_base64\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_PUSH_BASE32) {
    return parts.append("    call $__fern_buf_push_base32\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_DECODE_BASE32) {
    return parts.append("    call $__fern_buf_decode_base32\n");
  }
  if (o.kind_tag == ir.K_BUF_LEN) {
    return parts.append("    call $__fern_buf_len\n");
  }
  if (o.kind_tag == ir.K_BUF_CLEAR) {
    return parts.append("    call $__fern_buf_clear\n    i32.const 0\n");
  }
  if (o.kind_tag == ir.K_BUF_TAKE) {
    return parts.append("    call $__fern_buf_take\n");
  }
  return parts.append("    call $__fern_buf_free\n    i32.const 0\n");
}

// Four alphabet characters for each whole group of three bytes in a[lo..hi).
function buf_push_base64_helper(): string {
  let o = "  (func $__fern_buf_push_base64 (param $h i32) (param $a i32) (param $lo i32) (param $hi i32) (param $t i32)\n";
  o += "    (local $n i32) (local $len i32) (local $out i32) (local $p i32) (local $s i32) (local $v i32)\n";
  o += "    (if (i32.lt_s (local.get $lo) (i32.const 0)) (then (local.set $lo (i32.const 0))))\n";
  o += "    (if (i32.gt_s (local.get $hi) (i32.load (local.get $a))) (then (local.set $hi (i32.load (local.get $a)))))\n";
  o += "    (if (i32.le_s (local.get $hi) (local.get $lo)) (then (return)))\n";
  o += "    (local.set $n (i32.div_u (i32.sub (local.get $hi) (local.get $lo)) (i32.const 3)))\n";
  o += "    (if (i32.eqz (local.get $n)) (then (return)))\n";
  o += "    (if (i32.lt_u (i32.load (local.get $t)) (i32.const 64)) (then (call $__fern_abort_arr) (unreachable)))\n";
  o += "    (local.set $out (i32.shl (local.get $n) (i32.const 2)))\n";
  o += "    (local.set $len (i32.load offset=4 (local.get $h)))\n";
  o += "    (if (i32.gt_u (i32.add (local.get $len) (local.get $out)) (i32.load offset=8 (local.get $h))) (then (call $__fern_buf_reserve (local.get $h) (i32.add (local.get $len) (local.get $out)))))\n";
  o += "    (local.set $p (i32.add (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $len)))\n";
  o += "    (local.set $s (i32.add (i32.add (local.get $a) (i32.const 8)) (local.get $lo)))\n";
  o += "    (local.set $t (i32.add (local.get $t) (i32.const 8)))\n";
  o += "    (loop $l\n";
  o += "      (local.set $v (i32.or (i32.or (i32.shl (i32.load8_u (local.get $s)) (i32.const 16)) (i32.shl (i32.load8_u offset=1 (local.get $s)) (i32.const 8))) (i32.load8_u offset=2 (local.get $s))))\n";
  o += "      (i32.store8 (local.get $p) (i32.load8_u (i32.add (local.get $t) (i32.shr_u (local.get $v) (i32.const 18)))))\n";
  o += "      (i32.store8 offset=1 (local.get $p) (i32.load8_u (i32.add (local.get $t) (i32.and (i32.shr_u (local.get $v) (i32.const 12)) (i32.const 63)))))\n";
  o += "      (i32.store8 offset=2 (local.get $p) (i32.load8_u (i32.add (local.get $t) (i32.and (i32.shr_u (local.get $v) (i32.const 6)) (i32.const 63)))))\n";
  o += "      (i32.store8 offset=3 (local.get $p) (i32.load8_u (i32.add (local.get $t) (i32.and (local.get $v) (i32.const 63)))))\n";
  o += "      (local.set $s (i32.add (local.get $s) (i32.const 3)))\n";
  o += "      (local.set $p (i32.add (local.get $p) (i32.const 4)))\n";
  o += "      (local.set $n (i32.sub (local.get $n) (i32.const 1)))\n";
  o += "      (br_if $l (local.get $n)))\n";
  return o + "    (i32.store offset=4 (local.get $h) (i32.add (local.get $len) (local.get $out))))\n";
}

// Eight alphabet characters for each whole group of five bytes in a[lo..hi).
function buf_push_base32_helper(): string {
  let o = "  (func $__fern_buf_push_base32 (param $h i32) (param $a i32) (param $lo i32) (param $hi i32) (param $t i32)\n";
  o += "    (local $n i32) (local $len i32) (local $out i32) (local $p i32) (local $s i32) (local $v i64) (local $k i32)\n";
  o += "    (if (i32.lt_s (local.get $lo) (i32.const 0)) (then (local.set $lo (i32.const 0))))\n";
  o += "    (if (i32.gt_s (local.get $hi) (i32.load (local.get $a))) (then (local.set $hi (i32.load (local.get $a)))))\n";
  o += "    (if (i32.le_s (local.get $hi) (local.get $lo)) (then (return)))\n";
  o += "    (local.set $n (i32.div_u (i32.sub (local.get $hi) (local.get $lo)) (i32.const 5)))\n";
  o += "    (if (i32.eqz (local.get $n)) (then (return)))\n";
  o += "    (if (i32.lt_u (i32.load (local.get $t)) (i32.const 32)) (then (call $__fern_abort_arr) (unreachable)))\n";
  o += "    (local.set $out (i32.shl (local.get $n) (i32.const 3)))\n";
  o += "    (local.set $len (i32.load offset=4 (local.get $h)))\n";
  o += "    (if (i32.gt_u (i32.add (local.get $len) (local.get $out)) (i32.load offset=8 (local.get $h))) (then (call $__fern_buf_reserve (local.get $h) (i32.add (local.get $len) (local.get $out)))))\n";
  o += "    (local.set $p (i32.add (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $len)))\n";
  o += "    (local.set $s (i32.add (i32.add (local.get $a) (i32.const 8)) (local.get $lo)))\n";
  o += "    (local.set $t (i32.add (local.get $t) (i32.const 8)))\n";
  o += "    (loop $l\n";
  o += "      (local.set $v (i64.or (i64.shl (i64.extend_i32_u (i32.load8_u (local.get $s))) (i64.const 32)) (i64.extend_i32_u (i32.or (i32.or (i32.shl (i32.load8_u offset=1 (local.get $s)) (i32.const 24)) (i32.shl (i32.load8_u offset=2 (local.get $s)) (i32.const 16))) (i32.or (i32.shl (i32.load8_u offset=3 (local.get $s)) (i32.const 8)) (i32.load8_u offset=4 (local.get $s)))))))\n";
  o += "      (local.set $k (i32.const 0))\n";
  o += "      (loop $c\n";
  o += "        (i32.store8 (i32.add (local.get $p) (local.get $k)) (i32.load8_u (i32.add (local.get $t) (i32.wrap_i64 (i64.and (i64.shr_u (local.get $v) (i64.extend_i32_u (i32.sub (i32.const 35) (i32.mul (local.get $k) (i32.const 5))))) (i64.const 31))))))\n";
  o += "        (local.set $k (i32.add (local.get $k) (i32.const 1)))\n";
  o += "        (br_if $c (i32.lt_u (local.get $k) (i32.const 8))))\n";
  o += "      (local.set $s (i32.add (local.get $s) (i32.const 5)))\n";
  o += "      (local.set $p (i32.add (local.get $p) (i32.const 8)))\n";
  o += "      (local.set $n (i32.sub (local.get $n) (i32.const 1)))\n";
  o += "      (br_if $l (local.get $n)))\n";
  return o + "    (i32.store offset=4 (local.get $h) (i32.add (local.get $len) (local.get $out))))\n";
}

// Five bytes for each whole group of eight characters in a[lo..hi), up to the
// first character outside both ranges in $r. Returns the index it stops at.
function buf_decode_base32_helper(): string {
  let o = "  (func $__fern_buf_decode_base32 (param $h i32) (param $a i32) (param $lo i32) (param $hi i32) (param $r i32) (result i32)\n";
  o += "    (local $s i32) (local $p i32) (local $k i32) (local $c i32) (local $d i32) (local $v i64)\n";
  o += "    (if (i32.lt_s (local.get $lo) (i32.const 0)) (then (local.set $lo (i32.const 0))))\n";
  o += "    (if (i32.gt_s (local.get $hi) (i32.load (local.get $a))) (then (local.set $hi (i32.load (local.get $a)))))\n";
  o += "    (if (i32.lt_s (i32.sub (local.get $hi) (local.get $lo)) (i32.const 8)) (then (return (local.get $lo))))\n";
  o += "    (if (i32.lt_u (i32.load (local.get $r)) (i32.const 4)) (then (call $__fern_abort_arr) (unreachable)))\n";
  o += "    (local.set $r (i32.add (local.get $r) (i32.const 8)))\n";
  o += "    (local.set $s (local.get $lo))\n";
  o += "    (block $done (loop $g\n";
  o += "      (br_if $done (i32.gt_s (i32.add (local.get $s) (i32.const 8)) (local.get $hi)))\n";
  o += "      (local.set $v (i64.const 0))\n";
  o += "      (local.set $k (i32.const 0))\n";
  o += "      (loop $c8\n";
  o += "        (local.set $c (i32.load8_u offset=8 (i32.add (i32.add (local.get $a) (local.get $s)) (local.get $k))))\n";
  o += "        (local.set $d (i32.and (i32.sub (local.get $c) (i32.load8_u (local.get $r))) (i32.const 255)))\n";
  o += "        (if (i32.ge_u (local.get $d) (i32.load8_u offset=1 (local.get $r))) (then\n";
  o += "          (local.set $d (i32.and (i32.sub (local.get $c) (i32.load8_u offset=2 (local.get $r))) (i32.const 255)))\n";
  o += "          (br_if $done (i32.ge_u (local.get $d) (i32.load8_u offset=3 (local.get $r))))\n";
  o += "          (local.set $d (i32.add (local.get $d) (i32.load8_u offset=1 (local.get $r))))))\n";
  o += "        (local.set $v (i64.or (i64.shl (local.get $v) (i64.const 5)) (i64.extend_i32_u (local.get $d))))\n";
  o += "        (local.set $k (i32.add (local.get $k) (i32.const 1)))\n";
  o += "        (br_if $c8 (i32.lt_u (local.get $k) (i32.const 8))))\n";
  o += "      (local.set $k (i32.const 32))\n";
  o += "      (loop $b5\n";
  o += "        (call $__fern_buf_push_byte (local.get $h) (i32.wrap_i64 (i64.and (i64.shr_u (local.get $v) (i64.extend_i32_u (local.get $k))) (i64.const 255))))\n";
  o += "        (local.set $k (i32.sub (local.get $k) (i32.const 8)))\n";
  o += "        (br_if $b5 (i32.ge_s (local.get $k) (i32.const 0))))\n";
  o += "      (local.set $s (i32.add (local.get $s) (i32.const 8)))\n";
  o += "      (br $g)))\n";
  return o + "    (local.get $s))\n";
}

function buf_push_bytes_range_helper(): string {
  let o = "  (func $__fern_buf_push_bytes_range (param $h i32) (param $a i32) (param $lo i32) (param $hi i32)\n";
  o += "    (local $n i32) (local $len i32)\n";
  o += "    (if (i32.lt_s (local.get $lo) (i32.const 0)) (then (local.set $lo (i32.const 0))))\n";
  o += "    (if (i32.gt_s (local.get $hi) (i32.load (local.get $a))) (then (local.set $hi (i32.load (local.get $a)))))\n";
  o += "    (if (i32.le_s (local.get $hi) (local.get $lo)) (then (return)))\n";
  o += "    (local.set $n (i32.sub (local.get $hi) (local.get $lo)))\n";
  o += "    (local.set $len (i32.load offset=4 (local.get $h)))\n";
  o += "    (if (i32.gt_u (i32.add (local.get $len) (local.get $n)) (i32.load offset=8 (local.get $h))) (then (call $__fern_buf_reserve (local.get $h) (i32.add (local.get $len) (local.get $n)))))\n";
  o += "    (memory.copy (i32.add (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $len)) (i32.add (i32.add (local.get $a) (i32.const 8)) (local.get $lo)) (local.get $n))\n";
  return o + "    (i32.store offset=4 (local.get $h) (i32.add (local.get $len) (local.get $n))))\n";
}

function buf_text_helpers(): string {
  return "  ;; Positive width is valid; negative width consumes one maximal subpart.\n"
    + "  (func $__fern_buf_text_part (param $p i32) (param $left i32) (result i32)\n"
    + "    (local $lead i32) (local $width i32) (local $used i32) (local $next i32)\n"
    + "    (local.set $lead (i32.load8_u (local.get $p)))\n"
    + "    (if (i32.lt_u (local.get $lead) (i32.const 128)) (then (return (i32.const 1))))\n"
    + "    (if (i32.and (i32.ge_u (local.get $lead) (i32.const 194)) (i32.le_u (local.get $lead) (i32.const 223))) (then (local.set $width (i32.const 2))))\n"
    + "    (if (i32.and (i32.ge_u (local.get $lead) (i32.const 224)) (i32.le_u (local.get $lead) (i32.const 239))) (then (local.set $width (i32.const 3))))\n"
    + "    (if (i32.and (i32.ge_u (local.get $lead) (i32.const 240)) (i32.le_u (local.get $lead) (i32.const 244))) (then (local.set $width (i32.const 4))))\n"
    + "    (local.set $used (i32.const 1))\n"
    + "    (block $done (loop $scan\n"
    + "      (br_if $done (i32.ge_u (local.get $used) (local.get $width)))\n"
    + "      (br_if $done (i32.ge_u (local.get $used) (local.get $left)))\n"
    + "      (local.set $next (i32.load8_u (i32.add (local.get $p) (local.get $used))))\n"
    + "      (br_if $done (i32.or (i32.lt_u (local.get $next) (i32.const 128)) (i32.gt_u (local.get $next) (i32.const 191))))\n"
    + "      (if (i32.eq (local.get $used) (i32.const 1)) (then\n"
    + "        (br_if $done (i32.and (i32.eq (local.get $lead) (i32.const 224)) (i32.lt_u (local.get $next) (i32.const 160))))\n"
    + "        (br_if $done (i32.and (i32.eq (local.get $lead) (i32.const 237)) (i32.gt_u (local.get $next) (i32.const 159))))\n"
    + "        (br_if $done (i32.and (i32.eq (local.get $lead) (i32.const 240)) (i32.lt_u (local.get $next) (i32.const 144))))\n"
    + "        (br_if $done (i32.and (i32.eq (local.get $lead) (i32.const 244)) (i32.gt_u (local.get $next) (i32.const 143))))))\n"
    + "      (local.set $used (i32.add (local.get $used) (i32.const 1)))\n"
    + "      (br $scan)))\n"
    + "    (if (i32.eq (local.get $used) (local.get $width)) (then (return (local.get $used))))\n"
    + "    (i32.sub (i32.const 0) (local.get $used)))\n"
    + "  (func $__fern_buf_take (param $h i32) (result i32)\n"
    + "    (local $n i32) (local $src i32) (local $i i32) (local $part i32)\n"
    + "    (local $total i64) (local $changed i32) (local $box i32) (local $out i32)\n"
    + "    (local $start i32) (local $written i32)\n"
    + "    (local.set $n (i32.load offset=4 (local.get $h)))\n"
    + "    (local.set $src (i32.add (i32.load (local.get $h)) (i32.const 4)))\n"
    + "    (local.set $total (i64.extend_i32_u (local.get $n)))\n"
    + "    (block $counted (loop $count\n"
    + "      (br_if $counted (i32.ge_u (local.get $i) (local.get $n)))\n"
    + "      (if (i32.ge_u (i32.sub (local.get $n) (local.get $i)) (i32.const 8)) (then\n"
    + "        (if (i64.eqz (i64.and (i64.load (i32.add (local.get $src) (local.get $i))) (i64.const -9187201950435737472))) (then\n"
    + "          (local.set $i (i32.add (local.get $i) (i32.const 8))) (br $count)))))\n"
    + "      (local.set $part (call $__fern_buf_text_part (i32.add (local.get $src) (local.get $i)) (i32.sub (local.get $n) (local.get $i))))\n"
    + "      (if (i32.lt_s (local.get $part) (i32.const 0)) (then\n"
    + "        (local.set $total (i64.add (local.get $total) (i64.extend_i32_s (i32.add (i32.const 3) (local.get $part)))))\n"
    + "        (local.set $changed (i32.const 1))\n"
    + "        (local.set $i (i32.sub (local.get $i) (local.get $part))))\n"
    + "        (else (local.set $i (i32.add (local.get $i) (local.get $part)))))\n"
    + "      (br $count)))\n"
    + "    (if (i64.gt_u (local.get $total) (i64.const 2147483643)) (then (call $__fern_abort_alloc) (unreachable)))\n"
    + "    (local.set $box (call $__fern_str_box (i32.add (i32.wrap_i64 (local.get $total)) (i32.const 4))))\n"
    + "    (i32.store (local.get $box) (i32.wrap_i64 (local.get $total)))\n"
    + "    (local.set $out (i32.add (local.get $box) (i32.const 4)))\n"
    + "    (if (i32.eqz (local.get $changed)) (then\n"
    + "      (memory.copy (local.get $out) (local.get $src) (local.get $n)))\n"
    + "      (else\n"
    + "        (local.set $i (i32.const 0))\n"
    + "        (block $copied (loop $copy\n"
    + "          (br_if $copied (i32.ge_u (local.get $i) (local.get $n)))\n"
    + "          (if (i32.ge_u (i32.sub (local.get $n) (local.get $i)) (i32.const 8)) (then\n"
    + "            (if (i64.eqz (i64.and (i64.load (i32.add (local.get $src) (local.get $i))) (i64.const -9187201950435737472))) (then\n"
    + "              (local.set $i (i32.add (local.get $i) (i32.const 8))) (br $copy)))))\n"
    + "          (local.set $part (call $__fern_buf_text_part (i32.add (local.get $src) (local.get $i)) (i32.sub (local.get $n) (local.get $i))))\n"
    + "          (if (i32.lt_s (local.get $part) (i32.const 0)) (then\n"
    + "            (memory.copy (i32.add (local.get $out) (local.get $written)) (i32.add (local.get $src) (local.get $start)) (i32.sub (local.get $i) (local.get $start)))\n"
    + "            (local.set $written (i32.add (local.get $written) (i32.sub (local.get $i) (local.get $start))))\n"
    + "            (i32.store8 (i32.add (local.get $out) (local.get $written)) (i32.const 239))\n"
    + "            (i32.store8 offset=1 (i32.add (local.get $out) (local.get $written)) (i32.const 191))\n"
    + "            (i32.store8 offset=2 (i32.add (local.get $out) (local.get $written)) (i32.const 189))\n"
    + "            (local.set $written (i32.add (local.get $written) (i32.const 3)))\n"
    + "            (local.set $i (i32.sub (local.get $i) (local.get $part)))\n"
    + "            (local.set $start (local.get $i)))\n"
    + "            (else (local.set $i (i32.add (local.get $i) (local.get $part)))))\n"
    + "          (br $copy)))\n"
    + "        (memory.copy (i32.add (local.get $out) (local.get $written)) (i32.add (local.get $src) (local.get $start)) (i32.sub (local.get $n) (local.get $start)))))\n"
    + "    (i32.store offset=4 (local.get $h) (i32.const 0))\n"
    + "    (local.get $box))\n";
}

function buf_take_bytes_helper(): string {
  let o = "  (func $__fern_buf_take_bytes (param $h i32) (result i32)\n";
  o += "    (local $n i32) (local $a i32)\n";
  o += "    (local.set $n (i32.load offset=4 (local.get $h)))\n";
  o += "    (local.set $a (call $__fern_arr_elems (local.get $n) (i32.const 1)))\n";
  o += "    (i32.store (local.get $a) (local.get $n))\n";
  o += "    (i32.store offset=4 (local.get $a) (local.get $n))\n";
  o += "    (memory.copy (i32.add (local.get $a) (i32.const 8)) (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $n))\n";
  o += "    (i32.store offset=4 (local.get $h) (i32.const 0))\n";
  return o + "    (local.get $a))\n";
}

function buf_table_helpers(needs: string[], raw: boolean): string {
  let variant = "";
  let offset = "4";
  if (raw) {
    variant = "bytes_";
    offset = "8";
  }
  let o = "";
  if (need(needs, "buf_push_" + variant + "mapped")) {
    o = o + "  (func $__fern_buf_push_" + variant + "mapped (param $h i32) (param $s i32) (param $t i32)\n";
    o += "    (local $n i32) (local $i i32) (local $d i32) (local $len i32) (local $m i32) (local $c i32)\n";
    o += "    (local.set $n (i32.load (local.get $s)))\n";
    o += "    (if (i32.eqz (local.get $n)) (then (return)))\n";
    o += "    (local.set $len (i32.load (i32.add (local.get $h) (i32.const 4))))\n";
    o += "    (if (i32.gt_u (i32.add (local.get $len) (local.get $n)) (i32.load (i32.add (local.get $h) (i32.const 8))))\n";
    o += "      (then (call $__fern_buf_reserve (local.get $h) (i32.add (local.get $len) (local.get $n)))))\n";
    o += "    (local.set $d (i32.add (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $len)))\n";
    o += "    (local.set $m (i32.load (local.get $t)))\n";
    o += "    (block $md (loop $ml (br_if $md (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $c (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const " + offset + ")) (local.get $i))))\n";
    o += "      (if (i32.lt_u (local.get $c) (local.get $m)) (then\n";
    o += "        (local.set $c (i32.load8_u (i32.add (i32.add (local.get $t) (i32.const 8)) (local.get $c))))))\n";
    o += "      (i32.store8 (i32.add (local.get $d) (local.get $i)) (local.get $c))\n";
    o += "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $ml)))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.add (local.get $len) (local.get $n))))\n";
  }
  if (need(needs, "buf_push_" + variant + "filtered")) {
    o = o + "  (func $__fern_buf_push_" + variant + "filtered (param $h i32) (param $s i32) (param $t i32)\n";
    o += "    (local $n i32) (local $i i32) (local $d i32) (local $len i32) (local $m i32) (local $c i32) (local $j i32)\n";
    o += "    (local.set $n (i32.load (local.get $s)))\n";
    o += "    (if (i32.eqz (local.get $n)) (then (return)))\n";
    o += "    (local.set $len (i32.load (i32.add (local.get $h) (i32.const 4))))\n";
    o += "    (if (i32.gt_u (i32.add (local.get $len) (local.get $n)) (i32.load (i32.add (local.get $h) (i32.const 8))))\n";
    o += "      (then (call $__fern_buf_reserve (local.get $h) (i32.add (local.get $len) (local.get $n)))))\n";
    o += "    (local.set $d (i32.add (i32.add (i32.load (local.get $h)) (i32.const 4)) (local.get $len)))\n";
    o += "    (local.set $m (i32.load (local.get $t)))\n";
    o += "    (block $fd (loop $fl (br_if $fd (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $c (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const " + offset + ")) (local.get $i))))\n";
    o += "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o += "      (if (i32.lt_u (local.get $c) (local.get $m)) (then\n";
    o += "        (br_if $fl (i32.load8_u (i32.add (i32.add (local.get $t) (i32.const 8)) (local.get $c))))))\n";
    o += "      (i32.store8 (i32.add (local.get $d) (local.get $j)) (local.get $c))\n";
    o += "      (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $fl)))\n";
    o += "    (i32.store (i32.add (local.get $h) (i32.const 4)) (i32.add (local.get $len) (local.get $j))))\n";
  }
  if (need(needs, "buf_push_" + variant + "expanded")) {
    o = o + "  (func $__fern_buf_push_" + variant + "expanded (param $h i32) (param $s i32) (param $t i32)\n";
    o += "    (local $n i32) (local $i i32) (local $d i32) (local $len i32) (local $m i32) (local $c i32) (local $j i32) (local $r i32) (local $l i32) (local $k i32)\n";
    o += "    (local.set $n (i32.load (local.get $s)))\n";
    o += "    (if (i32.eqz (local.get $n)) (then (return)))\n";
    o += "    (local.set $len (i32.load (i32.add (local.get $h) (i32.const 4))))\n";
    o += "    (if (i32.gt_u (i32.add (local.get $len) (i32.mul (local.get $n) (i32.const 7))) (i32.load (i32.add (local.get $h) (i32.const 8))))\n";
    o += "      (then (call $__fern_buf_reserve (local.get $h) (i32.add (local.get $len) (i32.mul (local.get $n) (i32.const 7))))))\n";
