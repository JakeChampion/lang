pub function wasi_socket_errno_func(): string {
  let o: string = "  (func $__fern_wasi_socket_errno (param $code i32) (result i32)\n";
  let codes: i32[] = asmcore.wasi_socket_error_errnos();
  let i: i32 = 0;
  while (i < codes.len()) {
    o = o + "    (if (i32.eq (local.get $code) (i32.const " + util.i32_to_string(i) + ")) (then (return (i32.const " + util.i32_to_string(codes[i]) + "))))\n";
    i = i + 1;
  }
  return o + "    (i32.const 29))\n";
}

pub function network_handle_func(): string {
  let o: string = "";
