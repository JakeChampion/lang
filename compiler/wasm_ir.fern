pub function fd_seek_func(): string {
  let o = "  (global $__fern_dir_off (mut i32) (i32.const 0))\n";
  o += "  (global $__fern_dir_off_cap (mut i32) (i32.const 0))\n";
  o += "  (func $__fern_fd_seek (param $fd i32) (param $off i64) (param $whence i32) (param $rb i32) (result i32)\n";
  o += "    (local $err i32) (local $st i32) (local $base i64) (local $target i64) (local $old i32) (local $n i32)\n";
  o += "    (local.set $err (call $__fern_fd_seek_host (local.get $fd) (local.get $off) (local.get $whence) (local.get $rb)))\n";
  o += "    (if (i32.ne (local.get $err) (i32.const 8)) (then (return (local.get $err))))\n";
  o += "    (local.set $st (call $__fern_alloc (i32.const 64)))\n";
  o += "    (if (i32.or (call $__fern_fd_filestat_get (local.get $fd) (local.get $st)) (i32.ne (i32.load8_u offset=16 (local.get $st)) (i32.const 3))) (then\n";
  o += "      (call $__fern_raw_free (local.get $st) (i32.const 64))\n";
  o += "      (return (i32.const 8))))\n";
  o += "    (if (i32.eq (local.get $whence) (i32.const 2)) (then (local.set $base (i64.load offset=32 (local.get $st)))))\n";
  o += "    (call $__fern_raw_free (local.get $st) (i32.const 64))\n";
  o += "    (if (i32.and (i32.eq (local.get $whence) (i32.const 1)) (i32.lt_u (local.get $fd) (global.get $__fern_dir_off_cap)))\n";
  o += "      (then (local.set $base (i64.load (i32.add (global.get $__fern_dir_off) (i32.shl (local.get $fd) (i32.const 3)))))))\n";
  o += "    (local.set $target (i64.add (local.get $off) (local.get $base)))\n";
  o += "    (if (i64.lt_s (local.get $target) (i64.const 0)) (then (return (i32.const 28))))\n";
  o += "    (if (i32.ge_u (local.get $fd) (global.get $__fern_dir_off_cap)) (then\n";
  o += "      (local.set $old (global.get $__fern_dir_off))\n";
  o += "      (local.set $n (i32.add (local.get $fd) (i32.const 8)))\n";
  o += "      (global.set $__fern_dir_off (call $__fern_alloc (i32.shl (local.get $n) (i32.const 3))))\n";
  o += "      (memory.fill (global.get $__fern_dir_off) (i32.const 0) (i32.shl (local.get $n) (i32.const 3)))\n";
  o += "      (if (local.get $old) (then\n";
  o += "        (memory.copy (global.get $__fern_dir_off) (local.get $old) (i32.shl (global.get $__fern_dir_off_cap) (i32.const 3)))\n";
  o += "        (call $__fern_raw_free (local.get $old) (i32.shl (global.get $__fern_dir_off_cap) (i32.const 3)))))\n";
  o += "      (global.set $__fern_dir_off_cap (local.get $n))))\n";
  o += "    (i64.store (i32.add (global.get $__fern_dir_off) (i32.shl (local.get $fd) (i32.const 3))) (local.get $target))\n";
  o += "    (i64.store (local.get $rb) (local.get $target))\n";
  o += "    (i32.const 0))\n";
  o += "  (func $__fern_dir_off_forget (param $fd i32)\n";
  o += "    (if (i32.lt_u (local.get $fd) (global.get $__fern_dir_off_cap))\n";
  o += "      (then (i64.store (i32.add (global.get $__fern_dir_off) (i32.shl (local.get $fd) (i32.const 3))) (i64.const 0)))))\n";
  return o;
}

