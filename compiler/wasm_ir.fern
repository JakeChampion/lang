}

function reactor_subscribe(kind: i32, read_sub: string, write_sub: string, read_off: i32, write_off: i32): string {
  let o = "";
  o = o + "    (if (i32.eq (local.get $kind) (i32.const " + util.i32_to_string(kind) + ")) (then\n";
  o = o + "      (if (i32.and (local.get $interest) (i32.const 1)) (then (i32.store offset=8 (local.get $e) (call " + read_sub + " (i32.load offset=" + util.i32_to_string(read_off) + " (local.get $fd))))))\n";
  o = o + "      (if (i32.and (local.get $interest) (i32.const 2)) (then (i32.store offset=12 (local.get $e) (call " + write_sub + " (i32.load offset=" + util.i32_to_string(write_off) + " (local.get $fd))))))\n";
  o += "      (i32.store offset=4 (local.get $e) (local.get $interest))\n";
  o += "      (return (i32.const 0))))\n";
  return o;
}

