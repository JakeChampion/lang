  o = o + "          (br_if $dbl (i32.gt_u (i32.add (local.get $off) " + want + ") (local.get $cap))))\n";
  o = o + "        (local.set $grown " + fresh + ")\n";
  o = o + "        (memory.copy (i32.add (local.get $grown) (i32.const " + at + ")) (i32.add (local.get " + buf + ") (i32.const " + at + ")) (local.get $off))\n";
