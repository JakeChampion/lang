struct PathShim { name: string, sig: string, method: string, args: string, ops: string[] }

function path_mutator_shims(): PathShim[] {
  let pl: string = "(local.get $p) (local.get $l)";
  let on: string = "(local.get $op) (local.get $ol)";
  let nn: string = "(local.get $np) (local.get $nl)";
  return [
    PathShim { name: "path_unlink_file", sig: "(param $dirfd i32) (param $p i32) (param $l i32)", method: "unlink_file_at", args: pl, ops: ["remove_file", "remove_dir_all"] },
    PathShim { name: "path_create_directory", sig: "(param $dirfd i32) (param $p i32) (param $l i32)", method: "create_directory_at", args: pl, ops: ["create_dir", "create_dir_all", "temp_dir"] },
    PathShim { name: "path_remove_directory", sig: "(param $dirfd i32) (param $p i32) (param $l i32)", method: "remove_directory_at", args: pl, ops: ["remove_dir", "remove_dir_all"] },
    PathShim { name: "path_rename", sig: "(param $dirfd i32) (param $op i32) (param $ol i32) (param $nfd i32) (param $np i32) (param $nl i32)", method: "rename_at", args: on + " (local.get $pre) " + nn, ops: ["rename"] },
    PathShim { name: "path_link", sig: "(param $dirfd i32) (param $flags i32) (param $op i32) (param $ol i32) (param $nfd i32) (param $np i32) (param $nl i32)", method: "link_at", args: "(i32.and (local.get $flags) (i32.const 1)) " + on + " (local.get $pre) " + nn, ops: ["create_link"] },
    PathShim { name: "path_symlink", sig: "(param $op i32) (param $ol i32) (param $dirfd i32) (param $np i32) (param $nl i32)", method: "symlink_at", args: on + " " + nn, ops: ["create_symlink"] },
    PathShim { name: "path_filestat_set_times", sig: "(param $dirfd i32) (param $flags i32) (param $p i32) (param $l i32) (param $atim i64) (param $mtim i64) (param $fst i32)", method: "set_times_at", args: "(i32.and (local.get $flags) (i32.const 1)) " + pl + " " + new_timestamp_p2("$atim", "1", "2") + " " + new_timestamp_p2("$mtim", "4", "8"), ops: ["set_file_times"] },
  ];
}

function new_timestamp_p2(v: string, set: string, now: string): string {
  let disc: string = "(select (i32.const 2) (select (i32.const 1) (i32.const 0) (i32.and (local.get $fst) (i32.const " + now + "))) (i32.and (local.get $fst) (i32.const " + set + ")))";
  return disc + " (i64.div_u (local.get " + v + ") (i64.const 1000000000)) (i32.wrap_i64 (i64.rem_u (local.get " + v + ") (i64.const 1000000000)))";
}

function path_shim(name: string, sig: string, method: string, args: string): string {
