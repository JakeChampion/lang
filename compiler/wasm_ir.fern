  if (need(needs, "@uses_inner_mul_add_f64")) {
    parts = parts.append(inner_mul_add_f64_helper());
  }
  return parts;
}

function path_fs_bodies(parts: string[], needs: string[], mode: i32): string[] {
  parts = path_fs_metadata_bodies(parts, needs);
  parts = path_fs_link_bodies(parts, needs, mode);
  return path_fs_directory_bodies(parts, needs, mode);
}

function path_fs_metadata_bodies(parts: string[], needs: string[]): string[] {
  if (need(needs, "stat")) {
    parts = parts.append(stat_func());
  }
  if (need(needs, "lstat")) {
    parts = parts.append(lstat_func());
  }
  if (need(needs, "remove_file")) {
    parts = parts.append(remove_file_func());
  }
  if (need(needs, "create_dir_all")) {
    parts = parts.append(create_dir_all_func());
  }
  if (need(needs, "create_dir")) {
    parts = parts.append(create_dir_func());
  }
  if (need(needs, "remove_dir")) {
    parts = parts.append(remove_dir_func());
  }
  return parts;
}

function path_fs_link_bodies(parts: string[], needs: string[], mode: i32): string[] {
  if (need(needs, "create_link")) {
    parts = parts.append(create_link_func());
  }
  if (need(needs, "create_symlink")) {
    parts = parts.append(create_symlink_func());
  }
  if (need(needs, "rename")) {
    parts = parts.append(rename_func());
  }
  if (need(needs, "read_link")) {
    parts = parts.append(read_link_func());
  }
  if (need(needs, "set_file_times")) {
    parts = parts.append(set_file_times_func());
  }
  if (need(needs, "writer_set_times")) {
    parts = parts.append(writer_set_times_func());
  }
  if (need(needs, "truncate")) {
    parts = parts.append(truncate_body(mode));
  }
  return parts;
}

function path_fs_directory_bodies(parts: string[], needs: string[], mode: i32): string[] {
  for name in ["read_dir", "read_dir_all", "read_dir_ino", "read_dir_ino_all"] {
    if (need(needs, name)) {
      parts = parts.append(read_dir_body("__fern_" + name, mode));
      if (name == "read_dir") {
        if (mode == 2) {
          parts = parts.append(read_dir_bytes_func_p2());
        } else {
          parts = parts.append(read_dir_func_like("__fern_read_dir_bytes", true, false, true));
        }
      }
    }
  }
  if (mode != 2 && (need(needs, "read_dir_ino") || need(needs, "read_dir_ino_all"))) {
    parts = parts.append(wasi_kind_func());
  }
  if (need(needs, "remove_dir_all")) {
    parts = parts.append(remove_dir_all_func(mode == 2));
  }
  if (need(needs, "temp_dir")) {
    parts = parts.append(temp_dir_func());
  }
  return parts;
}

pub function emit_ir_module_units(units: WasmUnit[], mod: parser.Module, needs: string[], fn_sigs: string[], mode: i32, sw: asmcore.Switches): string {
  let lc = census_on(sw);
  needs = runtime_needs(mod, needs);
  let reports_abort = mode != 1 && needs_abort(needs);
  let stab = irtables.struct_tab(mod.structs);
  let parts: string[] = [];
  parts = parts.append("(module\n");
  if (mode == 0) {
    parts = parts.append(preview1_imports(needs, lc));
  }
  let stderr = component_uses_stderr(mod, needs) || lc;
  if (mode == 2) {
    parts = parts.append(component_io_imports(needs, stderr, module_is_proxy(mod)));
    parts = parts.append(preview2_wasi_imports(needs, true));
  }
  parts = parts.append(extern_imports(mod));
  parts = parts.append(async_lower_imports(mod));
  if (lifts_async(mod, mode)) {
    parts = parts.append(async_lift_imports(mod));
  }
  let sv = unit_strs(units);
  let abort_from = sv.len();
  if (reports_abort) {
    for text in wasm_abort.texts() {
      sv = sv.append(text);
    }
  }
  let abort_to = sv.len();
  if (needs_io_error(needs)) {
    sv = with_strerror_texts(sv);
  }
  let crc32_at = sv.len();
  if (need(needs, "@uses_crc32_ieee")) {
    sv = sv.append(crc32_ieee_table_bytes());
  }
  let strs = placed_strs(sv);
  let abort_offsets: i32[] = [];
  for at in abort_from..abort_to {
    abort_offsets = abort_offsets.append(strs.offs[at]);
  }
  let crc32_table = 0;
  if (crc32_at < sv.len()) {
    crc32_table = strs.offs[crc32_at] + 4;
  }
  let cv = unit_caggs(units);
  let caggs = placed_caggs(cv, const_agg_region_base(sv));
  let shadow = shadow_stack_bytes(needs);
  parts = parts.append(wasm_abort.helpers(abort_offsets, mode));
  parts = parts.append("  (memory (export \"memory\") " + util.i32_to_string(memory_min_pages(sv, cv, shadow)) + ")\n");
  if (shadow > 0) {
    let lo = shadow_lo_for_strs(sv, cv);
    parts = parts.append("  (global $__fern_shadow_lo i32 (i32.const " + util.i32_to_string(lo) + "))\n");
    parts = parts.append("  (global $__fern_shadow_sp (mut i32) (i32.const " + util.i32_to_string(lo + shadow) + "))\n");
  }
  if (sv.len() > 0) {
    let sbi = 0;
    let sbstart = 0;
    while (sbi < units.len()) {
      parts = parts.append("  (global " + str_base_global(units[sbi].ns) + " i32 (i32.const "
        + util.i32_to_string(strs.offs[sbstart]) + "))\n");
      sbstart += units[sbi].strs.len();
      sbi += 1;
    }
  }
  if (module_needs_type_ids(units, needs)) {
    parts = parts.append(tid_globals_section(stab));
  }
  for di in 0..sv.len() {
    parts = parts.append("  (data (i32.const " + util.i32_to_string(strs.offs[di]) + ") \""
      + le32_escape(sv[di].len()) + wat_escape(sv[di]) + "\")\n");
  }
  if (cv.len() > 0) {
    let kbi = 0;
    let kbstart = 0;
    while (kbi < units.len()) {
      parts = parts.append("  (global " + cagg_base_global(units[kbi].ns) + " i32 (i32.const "
        + util.i32_to_string(caggs.offs[kbstart]) + "))\n");
      kbstart += units[kbi].caggs.len();
      kbi += 1;
    }
  }
  parts = parts.append(const_agg_data(strs, caggs, stab, unit_fns(units)));
  parts = parts.append(lc_globals(lc));
  if (need(needs, "@ret_word")) {
    parts = parts.append("  (global $__fern_ret_word (mut i32) (i32.const 0))\n");
    parts = parts.append("  (global $__fern_ret_word1 (mut i32) (i32.const 0))\n");
    for slot in 0..3 {
      parts = parts.append("  (global $__fern_scalar_word" + util.i32_to_string(slot) + " (mut i64) (i64.const 0))\n");
    }
  }
  if (mode == 2 || module_extern_needs_heap(mod) || needs_fd_sync(needs) || need_open_file(needs) || need_any(needs, [
    "free", "@allocates", "@uses_i32_to_string", "@uses_i64_to_string", "@uses_u64_to_string", "@uses_u32_to_string", "@uses_buf",
    "env", "stat", "lstat", "remove_file", "create_dir_all", "read_dir", "read_dir_bytes", "read_dir_all", "read_dir_ino", "read_dir_ino_all", "remove_dir_all", "temp_dir", "read_chunk", "read_chunk_bytes", "reader_close", "fd_stat", "reader_seek", "writer_truncate", "writer_set_times",
    "writer_write", "write_some", "write_bytes", "write_some_bytes", "wasm_poll", "tcp_connect_with", "tcp_send_bytes", "tcp_send_buf", "tcp_listen", "tcp_listen_with", "tcp_socket_ctl", "tcp_addr_into", "tcp_accept", "tcp_accept_with", "tcp_local_port", "udp_bind", "udp_connect", "udp_sendto", "udp_sendto_bytes", "udp_recvfrom", "poll", "reactor_new", "reactor_ctl", "reactor_wait", "tcp_recv_into",
  ])) {
    parts = parts.append(heap_alloc_helpers(heap_base_for_strs(sv, cv, shadow), fl_base_for_strs(sv, cv), fl_cells(), large_fl_base_for_strs(sv, cv), need(needs, "@heap_alloc_count"), lc));
    parts = parts.append(rc_runtime_helpers(heap_base_for_strs(sv, cv, shadow)));
  }
  if (need(needs, "@calls_set_args")) {
    parts = parts.append(set_args_func());
  }
  if (mode == 2) {
    parts = parts.append(component_io_shims(needs, stderr, module_is_proxy(mod), lc));
  } else if (mode == 1 && module_is_proxy(mod) && need(needs, "exit")) {
    parts = parts.append(proxy_exit_shim());
  }
  if (need(needs, "@uses_buf")) {
    parts = parts.append(buf_helpers(needs));
  }
  if (need(needs, "buf_push_bytes_range")) {
    parts = parts.append(buf_push_bytes_range_helper());
  }
  if (need(needs, "buf_take_bytes")) {
    parts = parts.append(buf_take_bytes_helper());
  }
  if (module_needs_extern_wrappers(mod)) {
    parts = parts.append(extern_wrappers(mod));
  }
  parts = parts.append(async_lower_wrappers(mod));
  if (need(needs, "@uses_divrem")) {
    parts = parts.append(divrem_helpers());
  }
  if (need(needs, "@uses_i64_divrem")) {
    parts = parts.append(divrem64_helpers());
  }
  if (need(needs, "@uses_udivrem")) {
    parts = parts.append(udivrem_helpers("i32", ""));
  }
  if (need(needs, "@uses_i64_udivrem")) {
    parts = parts.append(udivrem_helpers("i64", "64"));
  }
  if (need(needs, "@uses_strings")) {
    parts = parts.append(strcat_helper());
  }
  if (need(needs, "@uses_i32_to_string")) {
    parts = parts.append(i32_to_string_helper());
  }
  if (need(needs, "@uses_i64_to_string")) {
    parts = parts.append(i64_to_string_helper());
  }
  if (need(needs, "@uses_u64_to_string")) {
    parts = parts.append(u64_to_string_helper());
  }
  if (need(needs, "@uses_u32_to_string")) {
    parts = parts.append(u32_to_string_helper());
  }
  if (mode != 2 && (need(needs, "monotonic_ns") || need(needs, "now_unix_ms") || need(needs, "now_ns"))) {
    parts = parts.append(clock_funcs());
  }
  if (mode != 2 && need(needs, "clock_resolution")) {
    parts = parts.append(clock_resolution_func());
  }
  if (mode != 2 && need(needs, "args")) {
    parts = parts.append(args_func(need(needs, "@calls_set_args")));
  }
  if (mode != 2 && need(needs, "env")) {
    parts = parts.append(env_func());
  }
  if (mode != 2 && need(needs, "environ")) {
    parts = parts.append(environ_func());
  }
  if (needs_io_error(needs)) {
    parts = parts.append(build_io_error_func(strs));
  }
  parts = path_fs_bodies(parts, needs, mode);
  if (need(needs, "sleep_ms")) {
    parts = parts.append(sleep_ms_func(mode == 2));
  }
  if (need(needs, "sleep_ns")) {
    parts = parts.append(sleep_ns_func(mode == 2));
  }
  if (need(needs, "wasm_poll")) {
    parts = parts.append(wasm_poll_func());
  }
  if (need(needs, "poll") && !need(needs, "wasm_poll")) {
    parts = parts.append(wasm_poll_func());
  }
  if (need(needs, "poll")) {
    parts = parts.append(poll_fds_func());
  }
  if (module_has_extern_composite_result(mod) || export_needs_realloc(mod) || need_any(needs, [
    "wasm_poll", "poll", "tcp_send_bytes", "tcp_send_buf", "udp_recvfrom", "reactor_wait", "tcp_recv_into",
  ]) || mode == 2 && (need_any(needs, ["env", "environ", "args"]) || need_preopen_p2(needs) || need_fd_read(needs))) {
    parts = parts.append(cabi_realloc_helper());
  }
  if (need_any(needs, ["tcp_connect_with", "tcp_listen", "tcp_listen_with", "udp_bind"])) {
    parts = parts.append(network_handle_func());
  }
  if (need_any(needs, ["tcp_connect_with", "tcp_listen", "tcp_listen_with", "tcp_socket_ctl", "tcp_addr_into", "tcp_accept", "tcp_accept_with", "tcp_local_port", "udp_bind", "udp_connect", "udp_sendto", "udp_sendto_bytes", "udp_recvfrom"])) {
    parts = parts.append(wasi_socket_errno_func());
  }
  if (need_any(needs, ["tcp_connect_with", "tcp_listen_with", "udp_bind", "udp_connect", "udp_sendto", "udp_sendto_bytes"])) {
    parts = parts.append(ip_flat_func());
  }
  if (need(needs, "tcp_connect_with")) {
    parts = parts.append(tcp_connect_with_func());
  }
  if (need(needs, "wasm_pollable_drop")) {
    parts = parts.append(pollable_drop_func());
  }
  if (need(needs, "tcp_close")) {
    parts = parts.append(tcp_close_func(need_udp_socket(needs), need(needs, "reactor_ctl"), need_tcp_send(needs)));
  }
  parts = parts.append(tcp_send_funcs(needs));
  if (need(needs, "tcp_listen")) {
    parts = parts.append(tcp_listen_func());
  }
  if (need(needs, "tcp_listen_with")) {
    parts = parts.append(tcp_listen_with_func());
  }
  if (need(needs, "tcp_socket_ctl")) {
    parts = parts.append(tcp_socket_ctl_func());
  }
  if (need(needs, "tcp_addr_into")) {
    parts = parts.append(tcp_addr_into_func(need(needs, "udp_bind")));
  }
  if (need(needs, "tcp_sendfile")) {
    parts = parts.append(tcp_sendfile_func());
  }
  if (need_any(needs, ["tcp_accept", "tcp_accept_with"])) {
    parts = parts.append(tcp_accept_with_func());
  }
  if (need(needs, "tcp_accept")) {
    parts = parts.append(tcp_accept_func());
  }
  if (need(needs, "tcp_local_port")) {
    parts = parts.append(tcp_local_port_func(need(needs, "udp_bind")));
  }
  if (need(needs, "tcp_pollable")) {
    parts = parts.append(tcp_pollable_func(need_udp_socket(needs)));
  }
  if (need_udp_socket(needs)) {
    parts = parts.append(udp_close_func());
  }
  if (need(needs, "udp_bind")) {
    parts = parts.append(udp_bind_func());
  }
  if (need(needs, "udp_bind_with")) {
    parts = parts.append(udp_bind_with_func());
  }
  if (need(needs, "udp_connect")) {
    parts = parts.append(udp_connect_func());
  }
  if (need(needs, "udp_sendto")) {
    parts = parts.append(udp_sendto_func(false));
  }
  if (need(needs, "udp_sendto_bytes")) {
    parts = parts.append(udp_sendto_func(true));
  }
  if (need(needs, "udp_recvfrom")) {
    parts = parts.append(udp_recvfrom_func());
  }
  if (need_any(needs, ["reactor_new", "reactor_ctl"])) {
    parts = parts.append(reactor_list_global());
  }
  if (need(needs, "reactor_new")) {
    parts = parts.append(reactor_new_func());
  }
  if (need(needs, "reactor_ctl")) {
    parts = parts.append(reactor_ctl_func());
    parts = parts.append(reactor_forget_func());
  }
  if (need(needs, "reactor_wait")) {
    parts = parts.append(reactor_wait_func());
  }
  if (need(needs, "@uses_task")) {
    parts = parts.append(task_funcs(lc, need(needs, "@heap_alloc_count")));
  }
  if (need(needs, "tcp_recv_into")) {
    parts = parts.append(tcp_recv_into_func());
  }
  if (need(needs, "read_file") || need(needs, "read_chunk") || need(needs, "read_dir") || need(needs, "read_dir_all") || need(needs, "read_dir_ino") || need(needs, "read_dir_ino_all") || need(needs, "read_link")) {
    parts = parts.append(utf8_valid_func());
  }
  if (mode == 0 && p1_fd_read(needs)) {
    parts = parts.append(fd_read_func());
  }
  if (mode != 2 && need(needs, "read_file")) {
    parts = parts.append(readfile_func());
  }
  if (mode != 2 && need(needs, "read_file_bytes")) {
    parts = parts.append(readfile_bytes_func());
  }
  if (mode != 2 && need(needs, "write_file")) {
    parts = parts.append(writefile_func());
  }
  if (mode != 2 && need(needs, "write_file_bytes")) {
    parts = parts.append(writefile_bytes_func(false));
  }
  if (need_open_file(needs)) {
    parts = parts.append(open_file_func());
  }
  if (need(needs, "open_with")) {
    parts = parts.append(open_with_func());
  }
  if (need(needs, "writer_write")) {
    parts = parts.append(writer_write_func());
  }
  if (need(needs, "write_some")) {
    parts = parts.append(writer_write_some_func(mode == 2));
  }
  if (need(needs, "write_bytes")) {
    parts = parts.append(writer_bytes_func(true, mode == 2));
  }
  if (need(needs, "write_some_bytes")) {
    parts = parts.append(writer_bytes_func(false, mode == 2));
  }
  if (need(needs, "read_chunk")) {
    parts = parts.append(reader_read_chunk_func());
  }
  if (need(needs, "read_chunk_bytes")) {
    parts = parts.append(reader_read_chunk_bytes_func());
  }
  if (need(needs, "reader_close")) {
    parts = parts.append(reader_close_func(mode == 0 && need(needs, "reader_seek")));
  }
  if (need(needs, "fd_stat")) {
    parts = parts.append(fd_stat_func());
  }
  parts = parts.append(fd_sync_funcs(needs));
  if (mode == 0 && need(needs, "reader_seek")) {
    parts = parts.append(fd_seek_func());
  }
  if (need(needs, "reader_seek")) {
    parts = parts.append(reader_seek_func());
  }
  if (need(needs, "fd_flags")) {
    parts = parts.append(fd_flags_func());
  }
  if (need(needs, "writer_truncate")) {
    parts = parts.append(writer_truncate_func());
  }
  if (need(needs, "@uses_str_slice") || need(needs, "str_split") || need(needs, "@uses_str_lines")) {
    parts = parts.append(substr_helper());
  }
  if (need(needs, "@uses_str_borrow")) {
    parts = parts.append(str_borrow_helper());
  }
  parts = kernel_helper_parts(needs, parts);
  if (need(needs, "arr_reserve")) {
    parts = parts.append(array_reserve_helper());
  }
  if (need(needs, "@uses_crc32_cksum")) {
    parts = parts.append(crc32_cksum_helper());
  }
  if (need(needs, "@uses_crc32_cksum_array")) {
    parts = parts.append(crc32_cksum_helper_for(true));
  }
  if (need(needs, "@uses_crc32_ieee")) {
    parts = parts.append(crc32_ieee_helpers(crc32_table));
  }
  parts = crypto_helper_parts(needs, parts);
  if (need(needs, "@uses_ascii_run")) {
    parts = parts.append(ascii_run_helper());
  }
  if (needs_str_split(needs)) {
    parts = parts.append(str_split_helper());
  }
  let ei = caggs.ix.find(empty_bytes_const());
  let empty: i32 = -1;
  if (ei >= 0) {
    empty = caggs.offs[ei] + 8;
  }
  parts = array_helper_parts(needs, mod, parts, empty);
  if (need(needs, "@uses_str_case")) {
    parts = parts.append(str_case_helpers());
  }
  if (need(needs, "@uses_str_repeat")) {
    parts = parts.append(str_repeat_helper());
  }
  if (need(needs, "@uses_str_trim")) {
    parts = parts.append(str_trim_helper());
  }
  if (need(needs, "@uses_str_replace")) {
    parts = parts.append(str_replace_helper());
  }
  if (need(needs, "@uses_str_lines")) {
    parts = parts.append(str_lines_helper());
  }
  if (need(needs, "@uses_arr_slice")) {
    parts = parts.append(arr_slice_helper());
  }
  if (need(needs, "@uses_arr_slice8")) {
    parts = parts.append(arr_slice8_helper());
  }
  if (need(needs, "@uses_arr_slice_u8")) {
    parts = parts.append(arr_slice_u8_helper());
  }
  let needs_arr_push = need(needs, "arr_push") || need(needs, "arr_push_owned") || need_dir_list(needs);
  let split_emits_push = need(needs, "str_split") || need(needs, "@uses_str_lines");
  if (needs_arr_push && !split_emits_push) {
    parts = parts.append(arr_push_helper());
  }
  if (need_push_owned(needs, mode) || split_emits_push) {
    parts = parts.append(arr_push_owned_helper(heap_base_for_strs(sv, cv, shadow)));
  }
  if (need(needs, "arr_push_i64") || need(needs, "arr_push_owned_i64")) {
    parts = parts.append(arr_push_i64_helper());
  }
  if (need(needs, "arr_push_f64") || need(needs, "arr_push_owned_f64")) {
    parts = parts.append(arr_push_f64_helper());
  }
  if (need(needs, "arr_push_owned_i64")) {
    parts = parts.append(arr_push_owned_wide_helper("i64", "i64", heap_base_for_strs(sv, cv, shadow)));
  }
  if (need(needs, "arr_push_owned_f64")) {
    parts = parts.append(arr_push_owned_wide_helper("f64", "f64", heap_base_for_strs(sv, cv, shadow)));
  }
  if (need(needs, "arr_push_u8") || need(needs, "arr_push_owned_u8")) {
    parts = parts.append(arr_push_u8_helper());
  }
  if (need(needs, "arr_push_owned_u8")) {
    parts = parts.append(arr_push_owned_wide_helper("u8", "i32", heap_base_for_strs(sv, cv, shadow)));
  }
  if (mode != 2 && need(needs, "random_bytes")) {
    parts = parts.append(random_bytes_ir_func());
  }
  if (mode != 2 && need(needs, "random_i32")) {
    parts = parts.append(random_i32_func());
  }
  if (need(needs, "print_str")) {
    parts = parts.append(print_str_helper());
  }
  if (need(needs, "eprint_str")) {
    parts = parts.append(eprint_str_helper());
  }
  if (need(needs, "str_bytes")) {
    parts = parts.append(str_bytes_func());
  }
  if (need(needs, "str_from_bytes")) {
    parts = parts.append(string_from_bytes_helper());
  }
  if (need(needs, "str_from_bytes_range")) {
    parts = parts.append(string_from_bytes_range_helper());
  }
  parts = parts.append(fn_support_section_units(unit_ns_list(units), unit_fns(units), unit_fn_counts(units), fn_sigs));
  for ui in 0..units.len() {
    parts = parts.append(units[ui].text);
  }
  let xps = extern_exports(mod);
  if (!asmcore.has_main(mod)) {
    parts = parts.append("  (func $main (result i32)\n    (i32.const 0))\n");
  }
  if (mode == 0) {
    parts = parts.append(lc_report_and_exit_wrapper(lc, sw.sanitize, need(needs, "@calls_set_args"), need(needs, "reader_seek")));
    parts = parts.append(xps);
    if (lc) {
      parts = parts.append("  (func $__fern_main_reporting (result i32) (local $r i32)\n    (local.set $r " + main_result_wat(mod) + ")\n    (call $__fern_lc_report)\n    (local.get $r))\n");
      parts = parts.append("  (func $__fern_start (call $__fern_proc_exit_raw " + low_byte_wat("(call $__fern_main_reporting)") + "))\n");
      parts = parts.append("  (export \"main\" (func $__fern_main_reporting))\n");
    } else {
      parts = parts.append("  (func $__fern_start (call $__fern_proc_exit " + low_byte_wat(main_result_wat(mod)) + "))\n");
      parts = parts.append("  (export \"main\" (func $main))\n");
    }
    parts = parts.append("  (export \"_start\" (func $__fern_start)))\n");
    return util.str_join_chunks(parts);
  }
  parts = parts.append("  (export \"main\" (func $main))\n");
  parts = parts.append(xps);
  if (lifts_async(mod, mode)) {
    parts = parts.append(async_lift_wrappers(mod));
  }
  parts = parts.append(component_run_entry(lc && !module_is_proxy(mod), sw.sanitize, need(needs, "@calls_set_args"), mode == 2 && need_fd_table(needs), low_byte_wat(main_result_wat(mod))));
  parts = parts.append("  (export \"_lang_run\" (func $__fern_lang_run)))\n");
  return util.str_join_chunks(parts);
}

pub function is_struct_type(structs: irtables.StructTab, t: string): boolean {
  for i in 0..structs.decls.len() {
    if (structs.decls[i].name == t) {
      return true;
    }
  }
  return false;
}

pub function wat_extern_valtype(t: string): string {
  if (parser.is_float_type_name(t)) {
    return "f64";
  }
  if (t == "i64" || t == "u64" || t == "s64") {
    return "i64";
  }
  return "i32";
}

function extern_core_valtype(t: string): string {
  if (t == "f32") {
    return "f32";
  }
  return wat_extern_valtype(t);
}

function extern_core_arg(t: string, local: string): string {
  if (t == "f32") {
    return "(f32.demote_f64 (local.get " + local + "))";
  }
  return "(local.get " + local + ")";
}

function has_extern_f32(f: parser.FuncDecl): boolean {
  if (f.ret_type == "f32") {
    return true;
  }
  for i in 0..f.params.len() {
    if (f.params[i].type_name == "f32") {
      return true;
    }
  }
  return false;
}

pub function is_extern_composite_ret(mod: parser.Module, t: string): boolean {
  return t == "string" || t == "u8[]" || t == "boolean[]" || extern_array_param_supported(t) || extern_record_result_supported(mod, t) || extern_sum_result_supported(t) || extern_variant_result_supported(mod, t) || extern_string_tuple_array_result(t) || extern_tuple_param_supported(t);
}

pub function extern_array_param_supported(t: string): boolean {
  if (t.len() <= 2 || !t.ends_with("[]")) {
    return false;
  }
  let k = slice_unchecked(t, 0, t.len() - 2);
  return k == "i32" || k == "u32" || k == "i64" || k == "u64" || k == "f32" || k == "f64";
}

// The list types an @export function takes and returns through the canonical ABI.
pub function extern_export_list(t: string): boolean {
  return extern_array_param_supported(t) || t == "u8[]";
}

pub function extern_byte_array_param(t: string): boolean {
  return t == "u8[]" || t == "boolean[]";
}

function extern_param_repacks(t: string): boolean {
  return extern_array_param_supported(t) || t == "boolean[]";
}

pub function extern_field_is_scalar(ft: string): boolean {
  return ft == "i32" || ft == "u32" || ft == "u8" || ft == "boolean" || ft == "i64" || ft == "u64" || parser.is_float_type_name(ft);
}

function extern_param_field_load(ft: string, addr: string): string {
  if (ft == "i64" || ft == "u64") {
    return "(i64.load " + addr + ")";
  }
  if (ft == "f32") {
    return "(f32.demote_f64 (f64.load " + addr + "))";
  }
  if (parser.is_float_type_name(ft)) {
    return "(f64.load " + addr + ")";
  }
  return "(" + extern_field_load_op(ft) + " " + addr + ")";
}

function extern_record_leaf_valtypes(mod: parser.Module, t: string): string[] {
  let out: string[] = [];
  for i in 0..mod.structs.len() {
    if (mod.structs[i].name == t) {
      let j = 0;
      while (j < mod.structs[i].fields.len()) {
        let ft = mod.structs[i].fields[j].type_name;
        if (extern_field_is_scalar(ft)) {
          out = out.append(extern_core_valtype(ft));
        } else {
          out = util.append_all(out, extern_record_leaf_valtypes(mod, ft));
        }
        j += 1;
      }
      return out;
    }
  }
  return out;
}

pub function extern_record_leaf_count(mod: parser.Module, t: string): i32 {
  for i in 0..mod.structs.len() {
    if (mod.structs[i].name == t) {
      let n = mod.structs[i].fields.len();
      let leaves = 0;
      for j in 0..n {
        let ft = mod.structs[i].fields[j].type_name;
        if (extern_field_is_scalar(ft)) {
          leaves += 1;
        } else {
          leaves += extern_record_leaf_count(mod, ft);
        }
      }
      return leaves;
    }
  }
  return 0;
}

pub function extern_record_nestable(mod: parser.Module, t: string): boolean {
  for i in 0..mod.structs.len() {
    if (mod.structs[i].name == t) {
      let n = mod.structs[i].fields.len();
      if (n == 0 || n > 16) {
        return false;
      }
      for j in 0..n {
        let ft = mod.structs[i].fields[j].type_name;
        if (!extern_field_is_scalar(ft) && !extern_record_nestable(mod, ft)) {
          return false;
        }
      }
      return true;
    }
  }
  return false;
}

pub function extern_record_depth(mod: parser.Module, t: string): i32 {
  for i in 0..mod.structs.len() {
    if (mod.structs[i].name == t) {
      let n = mod.structs[i].fields.len();
      let maxd = 0;
      for j in 0..n {
        let ft = mod.structs[i].fields[j].type_name;
        if (!extern_field_is_scalar(ft)) {
          let d = 1 + extern_record_depth(mod, ft);
          if (d > maxd) {
            maxd = d;
          }
        }
      }
      return maxd;
    }
  }
  return 0;
}

pub function extern_record_param_supported(mod: parser.Module, t: string): boolean {
  for i in 0..mod.structs.len() {
    if (mod.structs[i].name == t) {
      let n = mod.structs[i].fields.len();
      if (n == 0 || n > 16) {
        return false;
      }
      for j in 0..n {
        let ft = mod.structs[i].fields[j].type_name;
        if (!extern_field_is_scalar(ft) && !extern_record_nestable(mod, ft)) {
          return false;
        }
      }
      let leaves = extern_record_leaf_count(mod, t);
      return leaves >= 1 && leaves <= 16;
    }
  }
  return false;
}

pub function extern_record_result_supported(mod: parser.Module, t: string): boolean {
  for i in 0..mod.structs.len() {
    if (mod.structs[i].name == t) {
      let n = mod.structs[i].fields.len();
      if (n == 0 || n > 16) {
        return false;
      }
      for j in 0..n {
        let ft = mod.structs[i].fields[j].type_name;
        if (!extern_field_is_scalar(ft) && !extern_record_nestable(mod, ft)) {
          return false;
        }
      }
      let leaves = extern_record_leaf_count(mod, t);
      if (leaves < 1 || leaves > 16) {
        return false;
      }
      let direct_scalar = n == 1 && extern_field_is_scalar(mod.structs[i].fields[0].type_name);
      if (leaves == 1 && !direct_scalar) {
        return false;
      }
      return true;
    }
  }
  return false;
}

pub function extern_plain_enum_param(mod: parser.Module, t: string): boolean {
  let stab = irtables.struct_tab(mod.structs);
  for i in 0..mod.enums.len() {
    if (mod.enums[i].name == t) {
      let n = mod.enums[i].variant_names.len();
      if (n == 0) {
        return false;
      }
      for j in 0..n {
        let vn = mod.enums[i].variant_names[j];
        if (!is_struct_type(stab, vn) || struct_field_count(stab, vn) != 0) {
          return false;
        }
      }
      return true;
    }
  }
  return false;
}

pub function extern_variant_param_supported(mod: parser.Module, t: string): boolean {
  let stab = irtables.struct_tab(mod.structs);
  for i in 0..mod.enums.len() {
    if (mod.enums[i].name == t) {
      let n = mod.enums[i].variant_names.len();
      if (n == 0) {
        return false;
      }
      let anyp = false;
      let maxf = 0;
      for j in 0..n {
        let vn = mod.enums[i].variant_names[j];
        if (!is_struct_type(stab, vn)) {
          return false;
        }
        let fc = struct_field_count(stab, vn);
        if (fc > maxf) {
          maxf = fc;
        }
        if (fc >= 1) {
          anyp = true;
        }
      }
      if (!anyp) {
        return false;
      }
      if (maxf >= 2) {
        for k in 0..n {
          let vn2 = mod.enums[i].variant_names[k];
          let fcc = struct_field_count(stab, vn2);
          for fj in 0..fcc {
            if (extern_flat_scalar(struct_field_type_at(stab, vn2, fj)) == "") {
              return false;
            }
          }
        }
        return true;
      }
      let any_f32 = false;
      let any_i32 = false;
      let any_64 = false;
      for k2 in 0..n {
        let vn3 = mod.enums[i].variant_names[k2];
        if (struct_field_count(stab, vn3) == 1) {
          let ft3 = struct_field_type_at(stab, vn3, 0);
          if (ft3 != "i32" && ft3 != "u32" && ft3 != "i64" && ft3 != "u64" && ft3 != "f64" && ft3 != "f32") {
            return false;
          }
          if (ft3 == "f32") {
            any_f32 = true;
          }
          if (ft3 == "i32" || ft3 == "u32") {
            any_i32 = true;
          }
          if (ft3 == "i64" || ft3 == "u64" || ft3 == "f64") {
            any_64 = true;
          }
        }
      }
      if (any_f32 && (!any_i32 || any_64)) {
        return false;
      }
      return true;
    }
  }
  return false;
}

pub function extern_variant_max_fields(mod: parser.Module, t: string): i32 {
  let stab = irtables.struct_tab(mod.structs);
  for i in 0..mod.enums.len() {
    if (mod.enums[i].name == t) {
      let n = mod.enums[i].variant_names.len();
      let maxf = 0;
      for j in 0..n {
        let fc = struct_field_count(stab, mod.enums[i].variant_names[j]);
        if (fc > maxf) {
          maxf = fc;
        }
      }
      return maxf;
    }
  }
  return 0;
}

pub function extern_variant_is_multifield(mod: parser.Module, t: string): boolean {
  return extern_variant_max_fields(mod, t) >= 2;
}

function extern_flat_scalar(ft: string): string {
  if (ft == "i32" || ft == "u32") {
    return "i32";
  }
  if (ft == "i64" || ft == "u64") {
    return "i64";
  }
  if (ft == "f32" || ft == "f64") {
    return ft;
  }
  return "";
}

function extern_flat_join(a: string, b: string): string {
  if (a == b) {
    return a;
  }
  if ((a == "i32" || a == "f32") && (b == "i32" || b == "f32")) {
    return "i32";
  }
  return "i64";
}

function extern_variant_slot_join(mod: parser.Module, t: string, j: i32): string {
  let stab = irtables.struct_tab(mod.structs);
  let join = "";
  for ei in 0..mod.enums.len() {
    if (mod.enums[ei].name == t) {
      let k = 0;
      while (k < mod.enums[ei].variant_names.len()) {
        let vn = mod.enums[ei].variant_names[k];
        if (j < struct_field_count(stab, vn)) {
          let ft = extern_flat_scalar(struct_field_type_at(stab, vn, j));
          if (join == "") {
            join = ft;
          } else {
            join = extern_flat_join(join, ft);
          }
        }
        k += 1;
      }
    }
  }
  return join;
}

function extern_box_field_load(ft: string, addr: string): string {
  let flat = extern_flat_scalar(ft);
  if (flat == "f32") {
    return "(f32.demote_f64 (f64.load " + addr + "))";
  }
  return "(" + flat + ".load " + addr + ")";
}

function extern_flat_coerce(v: string, from: string, to: string): string {
  if (from == to) {
    return v;
  }
  if (to == "i32") {
    return "(i32.reinterpret_f32 " + v + ")";
  }
  if (from == "i32") {
    return "(i64.extend_i32_u " + v + ")";
  }
  if (from == "f32") {
    return "(i64.extend_i32_u (i32.reinterpret_f32 " + v + "))";
  }
  return "(i64.reinterpret_f64 " + v + ")";
}

pub function extern_variant_multifield_slot(mod: parser.Module, t: string, j: i32, boxloc: string): string {
  let stab = irtables.struct_tab(mod.structs);
  let join = extern_variant_slot_join(mod, t, j);
  for ei in 0..mod.enums.len() {
    if (mod.enums[ei].name == t) {
      let n = mod.enums[ei].variant_names.len();
      let acc = extern_variant_arm_slot(mod, mod.enums[ei].variant_names[n - 1], j, join, boxloc);
      let k = n - 2;
      while (k >= 0) {
        let sid = struct_id(stab, mod.enums[ei].variant_names[k]);
        acc = "(if (result " + join + ") (i32.eq (i32.load (local.get " + boxloc + ")) (i32.const " + util.i32_to_string(sid) + ")) (then " + extern_variant_arm_slot(mod, mod.enums[ei].variant_names[k], j, join, boxloc) + ") (else " + acc + "))";
        k -= 1;
      }
      return acc;
    }
  }
  return "(" + join + ".const 0)";
}

pub function extern_variant_arm_slot(mod: parser.Module, vn: string, j: i32, join: string, boxloc: string): string {
  let stab = irtables.struct_tab(mod.structs);
  if (j < struct_field_count(stab, vn)) {
    let ft = struct_field_type_at(stab, vn, j);
    let addr = "(i32.add (local.get " + boxloc + ") (i32.const " + util.i32_to_string(xbox_field_off(j)) + "))";
    return extern_flat_coerce(extern_box_field_load(ft, addr), extern_flat_scalar(ft), join);
  }
  return "(" + join + ".const 0)";
}

function extern_variant_payload_align(mod: parser.Module, t: string): i32 {
  let stab = irtables.struct_tab(mod.structs);
  let a = 4;
  for ei in 0..mod.enums.len() {
    if (mod.enums[ei].name == t) {
      let k = 0;
      while (k < mod.enums[ei].variant_names.len()) {
        let vn = mod.enums[ei].variant_names[k];
        let fj = 0;
        while (fj < struct_field_count(stab, vn)) {
          if (extern_flat_size(extern_flat_scalar(struct_field_type_at(stab, vn, fj))) == 8) {
            a = 8;
          }
          fj += 1;
        }
        k += 1;
      }
    }
  }
  return a;
}

function extern_flat_size(flat: string): i32 {
  if (flat == "i64" || flat == "f64") {
    return 8;
  }
  return 4;
}

function extern_arm_canon_offs(mod: parser.Module, vn: string): i32[] {
  let stab = irtables.struct_tab(mod.structs);
  let offs: i32[] = [];
  let off = 0;
  let fj = 0;
  while (fj < struct_field_count(stab, vn)) {
    let sz = extern_flat_size(extern_flat_scalar(struct_field_type_at(stab, vn, fj)));
    off = (off + sz - 1) / sz * sz;
    offs = offs.append(off);
    off += sz;
    fj += 1;
  }
  return offs.append(off);
}

function extern_variant_multifield_lift(mod: parser.Module, t: string, poff: i32): string {
  let stab = irtables.struct_tab(mod.structs);
  let o = "";
  for ei in 0..mod.enums.len() {
    if (mod.enums[ei].name == t) {
      let k = 0;
      while (k < mod.enums[ei].variant_names.len()) {
        let vn = mod.enums[ei].variant_names[k];
        let fc = struct_field_count(stab, vn);
        if (fc > 0) {
          let offs = extern_arm_canon_offs(mod, vn);
          o = o + "    (if (i32.eq (local.get $d) (i32.const " + util.i32_to_string(k) + ")) (then\n";
          for fj in 0..fc {
            let flat = extern_flat_scalar(struct_field_type_at(stab, vn, fj));
            let src = "(" + flat + ".load offset=" + util.i32_to_string(poff + offs[fj]) + " (local.get $rb))";
            let dst = util.i32_to_string(xbox_field_off(fj));
            if (flat == "f32") {
              o = o + "      (f64.store offset=" + dst + " (local.get $s) (f64.promote_f32 " + src + "))\n";
            } else {
              o = o + "      (" + flat + ".store offset=" + dst + " (local.get $s) " + src + ")\n";
            }
          }
          o += "    ))\n";
        }
        k += 1;
      }
    }
  }
  return o;
}

function extern_variant_area_size(mod: parser.Module, t: string): i32 {
  let stab = irtables.struct_tab(mod.structs);
  let big = 0;
  for ei in 0..mod.enums.len() {
    if (mod.enums[ei].name == t) {
      let k = 0;
      while (k < mod.enums[ei].variant_names.len()) {
        let offs = extern_arm_canon_offs(mod, mod.enums[ei].variant_names[k]);
        if (offs[offs.len() - 1] > big) {
          big = offs[offs.len() - 1];
        }
        k += 1;
      }
    }
  }
  return extern_variant_payload_align(mod, t) + big;
}

pub function extern_variant_join_is64(mod: parser.Module, t: string): boolean {
  let stab = irtables.struct_tab(mod.structs);
  for i in 0..mod.enums.len() {
    if (mod.enums[i].name == t) {
      let n = mod.enums[i].variant_names.len();
      for j in 0..n {
        let vn = mod.enums[i].variant_names[j];
        if (struct_field_count(stab, vn) == 1) {
          let ft = struct_field_type_at(stab, vn, 0);
          if (ft == "i64" || ft == "u64" || ft == "f64") {
            return true;
          }
        }
      }
      return false;
    }
  }
  return false;
}

pub function extern_variant_is_uniform_f64(mod: parser.Module, t: string): boolean {
  let stab = irtables.struct_tab(mod.structs);
  for i in 0..mod.enums.len() {
    if (mod.enums[i].name == t) {
      let n = mod.enums[i].variant_names.len();
      let anyp = false;
      for j in 0..n {
        let vn = mod.enums[i].variant_names[j];
        if (struct_field_count(stab, vn) == 1) {
          if (struct_field_type_at(stab, vn, 0) != "f64") {
            return false;
          }
          anyp = true;
        }
      }
      return anyp;
    }
  }
  return false;
}

pub function extern_variant_has_f32_arm(mod: parser.Module, t: string): boolean {
  let stab = irtables.struct_tab(mod.structs);
  for i in 0..mod.enums.len() {
    if (mod.enums[i].name == t) {
      let n = mod.enums[i].variant_names.len();
      for j in 0..n {
        let vn = mod.enums[i].variant_names[j];
        if (struct_field_count(stab, vn) == 1 && struct_field_type_at(stab, vn, 0) == "f32") {
          return true;
        }
      }
      return false;
    }
  }
  return false;
}

pub function extern_variant_payload_join_i64(mod: parser.Module, t: string, boxloc: string): string {
  let stab = irtables.struct_tab(mod.structs);
  for ei in 0..mod.enums.len() {
    if (mod.enums[ei].name == t) {
      let n = mod.enums[ei].variant_names.len();
      let acc = extern_variant_arm_join_i64(mod, mod.enums[ei].variant_names[n - 1], boxloc);
      let k = n - 2;
      while (k >= 0) {
        let sid = struct_id(stab, mod.enums[ei].variant_names[k]);
        acc = "(if (result i64) (i32.eq (i32.load (local.get " + boxloc + ")) (i32.const " + util.i32_to_string(sid) + ")) (then " + extern_variant_arm_join_i64(mod, mod.enums[ei].variant_names[k], boxloc) + ") (else " + acc + "))";
        k -= 1;
      }
      return acc;
    }
  }
  return "(i64.const 0)";
}

pub function extern_variant_arm_join_i64(mod: parser.Module, vn: string, boxloc: string): string {
  let stab = irtables.struct_tab(mod.structs);
  if (struct_field_count(stab, vn) == 1) {
    let ft = struct_field_type_at(stab, vn, 0);
    let poff = util.i32_to_string(xbox_field_off(0));
    if (ft == "i64" || ft == "u64" || ft == "f64") {
      return "(i64.load offset=" + poff + " (local.get " + boxloc + "))";
    }
    return "(i64.extend_i32_u (i32.load offset=" + poff + " (local.get " + boxloc + ")))";
  }
  return "(i64.const 0)";
}

pub function extern_variant_payload_join_i32_f32(mod: parser.Module, t: string, boxloc: string): string {
  let stab = irtables.struct_tab(mod.structs);
  for ei in 0..mod.enums.len() {
    if (mod.enums[ei].name == t) {
      let n = mod.enums[ei].variant_names.len();
      let acc = extern_variant_arm_join_i32_f32(mod, mod.enums[ei].variant_names[n - 1], boxloc);
      let k = n - 2;
      while (k >= 0) {
        let sid = struct_id(stab, mod.enums[ei].variant_names[k]);
        acc = "(if (result i32) (i32.eq (i32.load (local.get " + boxloc + ")) (i32.const " + util.i32_to_string(sid) + ")) (then " + extern_variant_arm_join_i32_f32(mod, mod.enums[ei].variant_names[k], boxloc) + ") (else " + acc + "))";
        k -= 1;
      }
      return acc;
    }
  }
  return "(i32.const 0)";
}

pub function extern_variant_arm_join_i32_f32(mod: parser.Module, vn: string, boxloc: string): string {
  let stab = irtables.struct_tab(mod.structs);
  if (struct_field_count(stab, vn) == 1) {
    let poff = util.i32_to_string(xbox_field_off(0));
    if (struct_field_type_at(stab, vn, 0) == "f32") {
      return "(i32.reinterpret_f32 (f32.demote_f64 (f64.load offset=" + poff + " (local.get " + boxloc + "))))";
    }
    return "(i32.load offset=" + poff + " (local.get " + boxloc + "))";
  }
  return "(i32.const 0)";
}

pub function extern_variant_result_store_f32(mod: parser.Module, t: string): string {
  for ei in 0..mod.enums.len() {
    if (mod.enums[ei].name == t) {
      let n = mod.enums[ei].variant_names.len();
      let acc = extern_variant_result_store_f32_arm(mod, mod.enums[ei].variant_names[n - 1]);
      let k = n - 2;
      while (k >= 0) {
        acc = "(if (i32.eq (local.get $d) (i32.const " + util.i32_to_string(k) + ")) (then " + extern_variant_result_store_f32_arm(mod, mod.enums[ei].variant_names[k]) + ") (else " + acc + "))";
        k -= 1;
      }
      return acc;
    }
  }
  return "(i32.store offset=" + util.i32_to_string(xbox_field_off(0)) + " (local.get $s) (i32.load offset=4 (local.get $rb)))";
}

pub function extern_variant_result_store_f32_arm(mod: parser.Module, vn: string): string {
  let stab = irtables.struct_tab(mod.structs);
  let poff = util.i32_to_string(xbox_field_off(0));
  if (struct_field_count(stab, vn) == 1 && struct_field_type_at(stab, vn, 0) == "f32") {
    return "(f64.store offset=" + poff + " (local.get $s) (f64.promote_f32 (f32.reinterpret_i32 (i32.load offset=4 (local.get $rb)))))";
  }
  return "(i32.store offset=" + poff + " (local.get $s) (i32.load offset=4 (local.get $rb)))";
}

pub function extern_variant_result_supported(mod: parser.Module, t: string): boolean {
  return extern_variant_param_supported(mod, t) || extern_variant_string_arms(mod, t).len() > 0;
}

pub function extern_variant_string_arms(mod: parser.Module, t: string): i32[] {
  let stab = irtables.struct_tab(mod.structs);
  let arms: i32[] = [];
  for i in 0..mod.enums.len() {
    if (mod.enums[i].name == t) {
      let n = mod.enums[i].variant_names.len();
      for j in 0..n {
        let vn = mod.enums[i].variant_names[j];
        if (!is_struct_type(stab, vn)) {
          return [];
        }
        let fc = struct_field_count(stab, vn);
        if (fc > 1) {
          return [];
        }
        if (fc == 1) {
          if (struct_field_type_at(stab, vn, 0) != "string") {
            return [];
          }
          arms = arms.append(j);
        }
      }
      return arms;
    }
  }
  return [];
}

function extern_variant_string_arm_test(arms: i32[]): string {
  let acc = "(i32.eq (local.get $d) (i32.const " + util.i32_to_string(arms[0]) + "))";
  for i in 1..arms.len() {
    acc = "(i32.or " + acc + " (i32.eq (local.get $d) (i32.const " + util.i32_to_string(arms[i]) + ")))";
  }
  return acc;
}

pub function extern_plain_enum_disc(mod: parser.Module, t: string, eploc: string): string {
  let stab = irtables.struct_tab(mod.structs);
  for ei in 0..mod.enums.len() {
    if (mod.enums[ei].name == t) {
      let n = mod.enums[ei].variant_names.len();
      let acc = "(i32.const " + util.i32_to_string(n - 1) + ")";
      let k = n - 2;
      while (k >= 0) {
        let sid = struct_id(stab, mod.enums[ei].variant_names[k]);
        acc = "(select (i32.const " + util.i32_to_string(k) + ") " + acc + " (i32.eq (i32.load (local.get " + eploc + ")) (i32.const " + util.i32_to_string(sid) + ")))";
        k -= 1;
      }
      return acc;
    }
  }
  return "(i32.const 0)";
}

pub function extern_plain_enum_sid(mod: parser.Module, t: string, dloc: string): string {
  let stab = irtables.struct_tab(mod.structs);
  for ei in 0..mod.enums.len() {
    if (mod.enums[ei].name == t) {
      let n = mod.enums[ei].variant_names.len();
      let acc = "(i32.const " + util.i32_to_string(struct_id(stab, mod.enums[ei].variant_names[n - 1])) + ")";
      let k = n - 2;
      while (k >= 0) {
        let sid = struct_id(stab, mod.enums[ei].variant_names[k]);
        acc = "(select (i32.const " + util.i32_to_string(sid) + ") " + acc + " (i32.eq (local.get " + dloc + ") (i32.const " + util.i32_to_string(k) + ")))";
        k -= 1;
      }
      return acc;
    }
  }
  return "(i32.const 0)";
}

pub function extern_field_load_op(ft: string): string {
  if (ft == "u8" || ft == "boolean") {
    return "i32.load8_u";
  }
  return "i32.load";
}

pub function extern_canon_field_size(ft: string): i32 {
  if (ft == "u8" || ft == "boolean") {
    return 1;
  }
  if (ft == "i64" || ft == "u64" || ft == "f64") {
    return 8;
  }
  return 4;
}

function extern_canon_load(ft: string, addr: string): string {
  if (ft == "i64" || ft == "u64") {
    return "(i64.load " + addr + ")";
  }
  if (ft == "f32") {
    return "(f32.load " + addr + ")";
  }
  if (parser.is_float_type_name(ft)) {
    return "(f64.load " + addr + ")";
  }
  return "(" + extern_field_load_op(ft) + " " + addr + ")";
}

function extern_slot_store(ft: string, addr: string, v: string): string {
  if (ft == "i64" || ft == "u64") {
    return "(i64.store " + addr + " " + v + ")";
  }
  if (ft == "f32") {
    return "(f64.store " + addr + " (f64.promote_f32 " + v + "))";
  }
  if (parser.is_float_type_name(ft)) {
    return "(f64.store " + addr + " " + v + ")";
  }
  return "(i32.store " + addr + " " + v + ")";
}

pub function extern_canon_field_align(mod: parser.Module, ft: string): i32 {
  let stab = irtables.struct_tab(mod.structs);
  if (extern_field_is_scalar(ft)) {
    return extern_canon_field_size(ft);
  }
  let n = struct_field_count(stab, ft);
  let maxa = 1;
  for i in 0..n {
    let a = extern_canon_field_align(mod, struct_field_type_at(stab, ft, i));
    if (a > maxa) {
      maxa = a;
    }
  }
  return maxa;
}

pub function extern_canon_field_csize(mod: parser.Module, ft: string): i32 {
  if (extern_field_is_scalar(ft)) {
    return extern_canon_field_size(ft);
  }
  return extern_canon_record_size_nested(mod, ft);
}

pub function extern_canon_top_off(mod: parser.Module, tn: string, idx: i32): i32 {
  let stab = irtables.struct_tab(mod.structs);
  let pos = 0;
  for i in 0..idx {
    let ft = struct_field_type_at(stab, tn, i);
    let a = extern_canon_field_align(mod, ft);
    let rem = pos % a;
    if (rem != 0) {
      pos += a - rem;
    }
    pos += extern_canon_field_csize(mod, ft);
  }
  let fa = extern_canon_field_align(mod, struct_field_type_at(stab, tn, idx));
  let frem = pos % fa;
  if (frem != 0) {
    pos += fa - frem;
  }
  return pos;
}

pub function extern_canon_record_size_nested(mod: parser.Module, tn: string): i32 {
  let stab = irtables.struct_tab(mod.structs);
  let n = struct_field_count(stab, tn);
  if (n == 0) {
    return 0;
  }
  let last = n - 1;
  let lsz = extern_canon_field_csize(mod, struct_field_type_at(stab, tn, last));
  let size = extern_canon_top_off(mod, tn, last) + lsz;
  let maxa = 1;
  for i in 0..n {
    let a = extern_canon_field_align(mod, struct_field_type_at(stab, tn, i));
    if (a > maxa) {
      maxa = a;
    }
  }
  let rem = size % maxa;
  if (rem != 0) {
    size += maxa - rem;
  }
  return size;
}

pub function extern_emit_record_fill(mod: parser.Module, dst: string, tn: string, canon_base: i32, depth: i32): string {
  let stab = irtables.struct_tab(mod.structs);
  let parts: string[] = [];
  let nf = struct_field_count(stab, tn);
  for rc in 0..nf {
    let rcft = struct_field_type_at(stab, tn, rc);
    let coff = canon_base + extern_canon_top_off(mod, tn, rc);
    let foff = util.i32_to_string(xbox_field_off(rc));
    if (extern_field_is_scalar(rcft)) {
      let canon = extern_canon_load(rcft, "(i32.add (local.get $rb) (i32.const " + util.i32_to_string(coff) + "))");
      parts = parts.append("    " + extern_slot_store(rcft, "(i32.add (local.get " + dst + ") (i32.const " + foff + "))", canon) + "\n");
    } else {
      let inner_local = "$inner" + util.i32_to_string(depth);
      let inf = struct_field_count(stab, rcft);
      parts = parts.append("    (local.set " + inner_local + " (call $__fern_str_box (i32.const " + util.i32_to_string(xbox_bytes(inf)) + ")))\n");
      parts = parts.append("    (i32.store (local.get " + inner_local + ") (i32.const " + util.i32_to_string(struct_id(stab, rcft)) + "))\n");
      parts = parts.append(extern_emit_record_fill(mod, inner_local, rcft, coff, depth + 1));
      parts = parts.append("    (i32.store (i32.add (local.get " + dst + ") (i32.const " + foff + ")) (local.get " + inner_local + "))\n");
    }
  }
  return util.str_join_chunks(parts);
}

pub function extern_emit_record_param_leaves(mod: parser.Module, base_expr: string, tn: string): string {
  let stab = irtables.struct_tab(mod.structs);
  let parts: string[] = [];
  let n = struct_field_count(stab, tn);
  for fi in 0..n {
    let ft = struct_field_type_at(stab, tn, fi);
    let field_expr = "(i32.add " + base_expr + " (i32.const " + util.i32_to_string(xbox_field_off(fi)) + "))";
    if (extern_field_is_scalar(ft)) {
      parts = parts.append(" " + extern_param_field_load(ft, field_expr));
    } else {
      parts = parts.append(extern_emit_record_param_leaves(mod, "(i32.load " + field_expr + ")", ft));
    }
  }
  return util.str_join_chunks(parts);
}

pub function struct_field_type_at(structs: irtables.StructTab, tn: string, idx: i32): string {
  for i in 0..structs.decls.len() {
    if (structs.decls[i].name == tn) {
      if (idx >= 0 && idx < structs.decls[i].fields.len()) {
        return structs.decls[i].fields[idx].type_name;
      }
      return "";
    }
  }
  return "";
}

pub function extern_record_ret_direct(mod: parser.Module, t: string): boolean {
  let stab = irtables.struct_tab(mod.structs);
  return extern_record_result_supported(mod, t)
    && struct_field_count(stab, t) == 1
    && extern_field_is_scalar(struct_field_type_at(stab, t, 0));
}

pub function extern_sum_param_supported(t: string): boolean {
  let r = parser.parse_type_ref(t);
  if (r.array_depth != 0) {
    return false;
  }
  if (r.base == "Option" && r.args.len() == 1) {
    return extern_i32_payload(parser.render_type_ref(r.args[0]));
  }
  if (r.base == "Result" && r.args.len() == 2) {
    return extern_i32_payload(parser.render_type_ref(r.args[0])) && extern_i32_payload(parser.render_type_ref(r.args[1]));
  }
  return false;
}

function extern_i32_payload(p: string): boolean {
  return p == "i32" || p == "u32" || parser.spelling_is_own(p);
}

pub function extern_sum_param_is_option(t: string): boolean {
  let r = parser.parse_type_ref(t);
  return r.base == "Option" && (r.args.len() > 0 || r.array_depth > 0);
}

pub function extern_sum_result_supported(t: string): boolean {
  if (extern_sum_param_supported(t) || extern_sum_wide_payload(t)) {
    return true;
  }
  return extern_sum_heap_payload(t).len() > 0;
}

function extern_sum_wide_payload(t: string): boolean {
  let r = parser.parse_type_ref(t);
  if (r.array_depth != 0) {
    return false;
  }
  if (r.base == "Option" && r.args.len() == 1) {
    return extern_i64_payload(parser.render_type_ref(r.args[0]));
  }
  if (r.base == "Result" && r.args.len() == 2) {
    return extern_i64_payload(parser.render_type_ref(r.args[0])) && extern_i64_payload(parser.render_type_ref(r.args[1]));
  }
  return false;
}

function extern_i64_payload(p: string): boolean {
  return p == "i64" || p == "u64";
}

pub function extern_sum_heap_payload(t: string): string {
  let r = parser.parse_type_ref(t);
  if (r.array_depth != 0) {
    return "";
  }
  let p = "";
  if (r.base == "Option" && r.args.len() == 1) {
    p = parser.render_type_ref(r.args[0]);
  } else if (r.base == "Result" && r.args.len() == 2) {
    p = parser.render_type_ref(r.args[0]);
    let er = parser.render_type_ref(r.args[1]);
    if (er != "i32" && er != "u32") {
      return "";
    }
  } else {
    return "";
  }
  if (p == "string" || p == "u8[]") {
    return p;
  }
  return "";
}

pub function extern_string_tuple_array_result(t: string): boolean {
  if (t.len() <= 2 || !t.ends_with("[]")) {
    return false;
  }
  let et = slice_unchecked(t, 0, t.len() - 2);
  let n = tuple_type_elem_count(et);
  if (n < 2) {
    return false;
  }
  for i in 0..n {
    if (nth_tuple_type_elem(et, i) != "string") {
      return false;
    }
  }
  return true;
}

pub function tuple_type_elem_count(t: string): i32 {
  if (t.len() < 2 || t[0] != 40) {
    return 0;
  }
  let idx = 0;
  while (nth_tuple_type_elem(t, idx).len() > 0) {
    idx += 1;
  }
  return idx;
}

pub function extern_tuple_param_supported(t: string): boolean {
  let n = tuple_type_elem_count(t);
  if (n < 2 || n > 16) {
    return false;
  }
  for i in 0..n {
    let e = nth_tuple_type_elem(t, i);
    if (e != "i32" && e != "u32") {
      return false;
    }
  }
  return true;
}

pub function has_extern_mem_param(mod: parser.Module, f: parser.FuncDecl): boolean {
  for i in 0..f.params.len() {
    let pt = f.params[i].type_name;
    if (pt == "string" || extern_array_param_supported(pt) || extern_byte_array_param(pt) || extern_record_param_supported(mod, pt) || extern_sum_param_supported(pt) || extern_tuple_param_supported(pt) || extern_plain_enum_param(mod, pt) || extern_variant_param_supported(mod, pt)) {
      return true;
    }
  }
  return false;
}

function extern_marshals(mod: parser.Module, f: parser.FuncDecl): boolean {
  if (has_extern_mem_param(mod, f)) {
    return true;
  }
  return has_extern_f32(f) && (extern_sum_result_supported(f.ret_type) || !is_extern_composite_ret(mod, f.ret_type) && !extern_plain_enum_param(mod, f.ret_type));
}

pub function extern_needs_wrapper(mod: parser.Module, f: parser.FuncDecl): boolean {
  return is_extern_composite_ret(mod, f.ret_type) || has_extern_mem_param(mod, f) || extern_plain_enum_param(mod, f.ret_type)
    || has_extern_f32(f) || !returns_value(f.ret_type);
}

function extern_core_params(mod: parser.Module, f: parser.FuncDecl): string {
  let parts: string[] = [];
  for p in f.params {
    parts = parts.append(extern_core_param(mod, p.type_name));
  }
  return util.str_join_chunks(parts);
}

function extern_core_param(mod: parser.Module, t: string): string {
  let parts: string[] = [];
  if (t == "string" || extern_array_param_supported(t) || extern_byte_array_param(t)) {
    parts = parts.append(" (param i32) (param i32)");
  } else if (extern_record_param_supported(mod, t)) {
    let leaves = extern_record_leaf_valtypes(mod, t);
    for rn in 0..leaves.len() {
      parts = parts.append(" (param " + leaves[rn] + ")");
    }
  } else if (extern_sum_param_supported(t)) {
    parts = parts.append(" (param i32) (param i32)");
  } else if (extern_tuple_param_supported(t)) {
    let tn = 0;
    while (tn < tuple_type_elem_count(t)) {
      parts = parts.append(" (param i32)");
      tn += 1;
    }
  } else if (extern_plain_enum_param(mod, t)) {
    parts = parts.append(" (param i32)");
  } else if (extern_variant_param_supported(mod, t)) {
    parts = parts.append(" (param i32)");
    if (extern_variant_is_multifield(mod, t)) {
      let sc = extern_variant_max_fields(mod, t);
      for si in 0..sc {
        parts = parts.append(" (param " + extern_variant_slot_join(mod, t, si) + ")");
      }
    } else if (extern_variant_is_uniform_f64(mod, t)) {
      parts = parts.append(" (param f64)");
    } else if (extern_variant_join_is64(mod, t)) {
      parts = parts.append(" (param i64)");
    } else {
      parts = parts.append(" (param i32)");
    }
  } else {
    parts = parts.append(" (param " + extern_core_valtype(t) + ")");
  }
  return util.str_join_chunks(parts);
}

pub function extern_imports(mod: parser.Module): string {
  let stab = irtables.struct_tab(mod.structs);
  let parts: string[] = [];
  for i in 0..mod.funcs.len() {
    let f = mod.funcs[i];
    if (is_sync_extern(f)) {
      if (extern_needs_wrapper(mod, f)) {
        parts = parts.append("  (import \"" + f.import_iface + "\" \"" + f.import_wit + "\" (func $" + f.name + "__import");
        parts = parts.append(extern_core_params(mod, f));
        if (extern_record_ret_direct(mod, f.ret_type)) {
          parts = parts.append(" (result " + extern_core_valtype(struct_field_type_at(stab, f.ret_type, 0)) + ")))\n");
        } else if (is_extern_composite_ret(mod, f.ret_type)) {
          parts = parts.append(" (param i32)))\n");
        } else {
          if (returns_value(f.ret_type)) {
            parts = parts.append(" (result " + extern_core_valtype(f.ret_type) + ")");
          }
          parts = parts.append("))\n");
        }
      } else {
        parts = parts.append("  (import \"" + f.import_iface + "\" \"" + f.import_wit + "\" (func $" + f.name);
        for p in 0..f.params.len() {
          parts = parts.append(" (param " + wat_extern_valtype(f.params[p].type_name) + ")");
        }
        if (returns_value(f.ret_type)) {
          parts = parts.append(" (result " + wat_extern_valtype(f.ret_type) + ")");
        }
        parts = parts.append("))\n");
      }
    }
  }
  return util.str_join_chunks(parts);
}

pub function export_func_ret(mod: parser.Module, name: string): string {
  for i in 0..mod.funcs.len() {
    if (mod.funcs[i].receiver_type.len() == 0 && mod.funcs[i].name == name) {
      return mod.funcs[i].ret_type;
    }
  }
  return "";
}

pub function export_func_params(mod: parser.Module, name: string): ast.ParamDecl[] {
  let none: ast.ParamDecl[] = [];
  for i in 0..mod.funcs.len() {
    if (mod.funcs[i].receiver_type.len() == 0 && mod.funcs[i].name == name) {
      return mod.funcs[i].params;
    }
  }
  return none;
}

pub function export_has_string_param(params: ast.ParamDecl[]): boolean {
  for i in 0..params.len() {
    if (params[i].type_name == "string") {
      return true;
    }
  }
  return false;
}

pub function export_has_numeric_array_param(params: ast.ParamDecl[]): boolean {
  for i in 0..params.len() {
    if (extern_export_list(params[i].type_name)) {
      return true;
    }
  }
  return false;
}

pub function module_has_array_param_export(mod: parser.Module): boolean {
  for i in 0..mod.exports.len() {
    if (export_has_numeric_array_param(export_func_params(mod, mod.exports[i].func_name))) {
      return true;
    }
  }
  return false;
}

pub function build_export_wrapper(fname: string, params: ast.ParamDecl[], ret: string): string {
  let w_slots = 0;
  let nblk = 0;
  let j = 0;
  while (j < params.len()) {
    if (params[j].type_name == "string" || extern_export_list(params[j].type_name)) {
      w_slots += 2;
      nblk += 1;
    } else {
      w_slots += 1;
    }
    j += 1;
  }
  let str_result = ret == "string";
  let arr_result = extern_export_list(ret);
  let sum_result = extern_sum_param_supported(ret);
  let tup_result = extern_tuple_param_supported(ret);
  let i_local = w_slots + nblk;
  let s_local = w_slots + nblk + 1;
  let ra_local = w_slots + nblk + 2;
  let arr_arr = w_slots + nblk + 1;
  let arr_alen = w_slots + nblk + 2;
  let arr_buf = w_slots + nblk + 3;
  let arr_ra = w_slots + nblk + 4;
  let sum_v = w_slots + nblk + 1;
  let sum_rb = w_slots + nblk + 2;
  let tup_v = w_slots + nblk + 1;
  let tup_rb = w_slots + nblk + 2;

  let head = "  (func $__xwrap_" + fname;
  j = 0;
  while (j < params.len()) {
    if (params[j].type_name == "string" || extern_export_list(params[j].type_name)) {
      head += " (param i32) (param i32)";
    } else {
      head = head + " (param " + wat_extern_valtype(params[j].type_name) + ")";
    }
    j += 1;
  }
  if (str_result || arr_result || sum_result || tup_result) {
    head += " (result i32)";
  } else if (returns_value(ret)) {
    head = head + " (result " + wat_extern_valtype(ret) + ")";
  }
  head += "\n";

  let nlocals = nblk + 1;
  if (str_result) {
    nlocals += 2;
  }
  if (arr_result) {
    nlocals += 4;
  }
  if (sum_result) {
    nlocals += 2;
  }
  if (tup_result) {
    nlocals += 2;
  }
  let locals = "    ";
  for k in 0..nlocals {
    locals += "(local i32) ";
  }
  locals += "\n";

  let body = "";
  let wp = 0;
  let blk = w_slots;
  let callargs = "";
  for j in 0..params.len() {
    if (params[j].type_name == "string") {
      let lenI = wp + 1;
      let blkS = util.i32_to_string(blk);
      let iS = util.i32_to_string(i_local);
      let lenS = util.i32_to_string(lenI);
      let ptrS = util.i32_to_string(wp);
      let jS = util.i32_to_string(j);
      body = body + "    (local.set " + blkS + " " + xstr_new("(local.get " + lenS + ")") + ")\n";
      body = body + "    (i32.store (local.get " + blkS + ") (local.get " + lenS + "))\n";
      body = body + "    (local.set " + iS + " (i32.const 0))\n";
      body = body + "    (block $d" + jS + " (loop $c" + jS + "\n";
      body = body + "      (br_if $d" + jS + " (i32.ge_u (local.get " + iS + ") (local.get " + lenS + ")))\n";
      body = body + "      (i32.store8 (i32.add (i32.add (local.get " + blkS + ") (i32.const 4)) (local.get " + iS + ")) (i32.load8_u (i32.add (local.get " + ptrS + ") (local.get " + iS + "))))\n";
      body = body + "      (local.set " + iS + " (i32.add (local.get " + iS + ") (i32.const 1)))\n";
      body = body + "      (br $c" + jS + ")))\n";
      callargs = callargs + " (local.get " + blkS + ")";
      blk += 1;
      wp += 2;
    } else if (params[j].type_name == "u8[]") {
      let bblkS = util.i32_to_string(blk);
      let blenS = util.i32_to_string(wp + 1);
      body = body + "    (local.set " + bblkS + " (call $__fern_arr_elems (local.get " + blenS + ") (i32.const 1)))\n";
      body = body + "    (i32.store (local.get " + bblkS + ") (local.get " + blenS + "))\n";
      body = body + "    (i32.store offset=4 (local.get " + bblkS + ") (local.get " + blenS + "))\n";
      body = body + "    (memory.copy (i32.add (local.get " + bblkS + ") (i32.const 8)) (local.get " + util.i32_to_string(wp) + ") (local.get " + blenS + "))\n";
      callargs = callargs + " (local.get " + bblkS + ")";
      blk += 1;
      wp += 2;
    } else if (extern_array_param_supported(params[j].type_name)) {
      let akind = slice_unchecked(params[j].type_name, 0, params[j].type_name.len() - 2);
      let assz = util.i32_to_string(elem_slot_size(akind));
      let acsz = util.i32_to_string(extern_list_elem_size(akind));
      let ablkS = util.i32_to_string(blk);
      let aiS = util.i32_to_string(i_local);
      let alenS = util.i32_to_string(wp + 1);
      let aptrS = util.i32_to_string(wp);
      let ajS = util.i32_to_string(j);
      body = body + "    (local.set " + ablkS + " (call $__fern_arr_elems (local.get " + alenS + ") (i32.const " + assz + ")))\n";
      body = body + "    (i32.store (local.get " + ablkS + ") (local.get " + alenS + "))\n";
      body = body + "    (i32.store offset=4 (local.get " + ablkS + ") (local.get " + alenS + "))\n";
      body = body + "    (local.set " + aiS + " (i32.const 0))\n";
      body = body + "    (block $pda" + ajS + " (loop $pca" + ajS + "\n";
      body = body + "      (br_if $pda" + ajS + " (i32.ge_u (local.get " + aiS + ") (local.get " + alenS + ")))\n";
      body = body + "      " + extern_elem_from_canon(akind, "(i32.add (i32.add (local.get " + ablkS + ") (i32.const 8)) (i32.mul (local.get " + aiS + ") (i32.const " + assz + ")))", "(i32.add (local.get " + aptrS + ") (i32.mul (local.get " + aiS + ") (i32.const " + acsz + ")))") + "\n";
      body = body + "      (local.set " + aiS + " (i32.add (local.get " + aiS + ") (i32.const 1)))\n";
      body = body + "      (br $pca" + ajS + ")))\n";
      callargs = callargs + " (local.get " + ablkS + ")";
      blk += 1;
      wp += 2;
    } else {
      callargs = callargs + " (local.get " + util.i32_to_string(wp) + ")";
      wp += 1;
    }
  }
  if (str_result) {
    let sS = util.i32_to_string(s_local);
    let raS = util.i32_to_string(ra_local);
    body = body + "    (local.set " + sS + " (call $" + fname + callargs + "))\n";
    body = body + "    (local.set " + raS + " (i32.and (i32.add (call $__fern_alloc (i32.const 12)) (i32.const 3)) (i32.const -4)))\n";
    body = body + "    (i32.store (local.get " + raS + ") (i32.add (local.get " + sS + ") (i32.const 4)))\n";
    body = body + "    (i32.store (i32.add (local.get " + raS + ") (i32.const 4)) (i32.load (local.get " + sS + ")))\n";
    body = body + "    (local.get " + raS + "))\n";
  } else if (ret == "u8[]") {
    let aS = util.i32_to_string(arr_arr);
    let raS2 = util.i32_to_string(arr_ra);
    body = body + "    (local.set " + aS + " (call $" + fname + callargs + "))\n";
    body += byte_view_decode(aS, util.i32_to_string(arr_buf), util.i32_to_string(arr_alen));
    body = body + "    (local.set " + raS2 + " (i32.and (i32.add (call $__fern_alloc (i32.const 12)) (i32.const 3)) (i32.const -4)))\n";
    body = body + "    (i32.store (local.get " + raS2 + ") (local.get " + util.i32_to_string(arr_buf) + "))\n";
    body = body + "    (i32.store (i32.add (local.get " + raS2 + ") (i32.const 4)) (local.get " + util.i32_to_string(arr_alen) + "))\n";
    body = body + "    (local.get " + raS2 + "))\n";
  } else if (arr_result) {
    let rk = slice_unchecked(ret, 0, ret.len() - 2);
    let ss = util.i32_to_string(elem_slot_size(rk));
    let cs = util.i32_to_string(extern_list_elem_size(rk));
    let aS = util.i32_to_string(arr_arr);
    let lnS = util.i32_to_string(arr_alen);
    let bfS = util.i32_to_string(arr_buf);
    let raS2 = util.i32_to_string(arr_ra);
    let iS2 = util.i32_to_string(i_local);
    body = body + "    (local.set " + aS + " (call $" + fname + callargs + "))\n";
    body = body + "    (local.set " + lnS + " (i32.load (local.get " + aS + ")))\n";
    body = body + "    (local.set " + bfS + " (i32.and (i32.add (call $__fern_alloc (i32.mul (local.get " + lnS + ") (i32.const " + cs + "))) (i32.const 7)) (i32.const -8)))\n";
    body = body + "    (local.set " + iS2 + " (i32.const 0))\n";
    body += "    (block $da (loop $ca\n";
    body = body + "      (br_if $da (i32.ge_u (local.get " + iS2 + ") (local.get " + lnS + ")))\n";
    body = body + "      " + extern_elem_to_canon(rk, "(i32.add (local.get " + bfS + ") (i32.mul (local.get " + iS2 + ") (i32.const " + cs + ")))", "(i32.add (i32.add (local.get " + aS + ") (i32.const 8)) (i32.mul (local.get " + iS2 + ") (i32.const " + ss + ")))") + "\n";
    body = body + "      (local.set " + iS2 + " (i32.add (local.get " + iS2 + ") (i32.const 1)))\n";
    body += "      (br $ca)))\n";
    body = body + "    (local.set " + raS2 + " (i32.and (i32.add (call $__fern_alloc (i32.const 12)) (i32.const 3)) (i32.const -4)))\n";
    body = body + "    (i32.store (local.get " + raS2 + ") (local.get " + bfS + "))\n";
    body = body + "    (i32.store (i32.add (local.get " + raS2 + ") (i32.const 4)) (local.get " + lnS + "))\n";
    body = body + "    (local.get " + raS2 + "))\n";
  } else if (sum_result) {
    let svS = util.i32_to_string(sum_v);
    let srbS = util.i32_to_string(sum_rb);
    body = body + "    (local.set " + svS + " (call $" + fname + callargs + "))\n";
    body = body + "    (local.set " + srbS + " (i32.and (i32.add (call $__fern_alloc (i32.const 15)) (i32.const 7)) (i32.const -8)))\n";
    if (extern_sum_param_is_option(ret)) {
      body = body + "    (i32.store8 (local.get " + srbS + ") (i32.sub (i32.const 1) (i32.load (local.get " + svS + "))))\n";
    } else {
      body = body + "    (i32.store8 (local.get " + srbS + ") (i32.load (local.get " + svS + ")))\n";
    }
    body = body + "    (i32.store offset=4 (local.get " + srbS + ") (i32.load offset=4 (local.get " + svS + ")))\n";
    body = body + "    (local.get " + srbS + "))\n";
  } else if (tup_result) {
    let tvS = util.i32_to_string(tup_v);
    let trbS = util.i32_to_string(tup_rb);
    let tn = tuple_type_elem_count(ret);
    body = body + "    (local.set " + tvS + " (call $" + fname + callargs + "))\n";
    body = body + "    (local.set " + trbS + " (i32.and (i32.add (call $__fern_alloc (i32.const " + util.i32_to_string(tn * 4 + 7) + ")) (i32.const 7)) (i32.const -8)))\n";
    for ti in 0..tn {
      let canon_off = util.i32_to_string(ti * 4);
      let fern_off = util.i32_to_string(ti * 8);
      body = body + "    (i32.store (i32.add (local.get " + trbS + ") (i32.const " + canon_off + ")) (i32.load (i32.add (local.get " + tvS + ") (i32.const " + fern_off + "))))\n";
    }
    body = body + "    (local.get " + trbS + "))\n";
  } else if (!returns_value(ret)) {
    body = body + "    (drop (call $" + fname + callargs + ")))\n";
  } else {
    body = body + "    (call $" + fname + callargs + "))\n";
  }
  return head + locals + body;
}

pub function export_needs_heap(mod: parser.Module): boolean {
  for i in 0..mod.exports.len() {
    let nm = mod.exports[i].func_name;
    let params = export_func_params(mod, nm);
    if (export_func_ret(mod, nm) == "string" || export_has_string_param(params) || extern_export_list(export_func_ret(mod, nm)) || export_has_numeric_array_param(params) || extern_sum_param_supported(export_func_ret(mod, nm)) || extern_tuple_param_supported(export_func_ret(mod, nm))) {
      return true;
    }
  }
  return false;
}

pub function export_needs_realloc(mod: parser.Module): boolean {
  for i in 0..mod.exports.len() {
    let params = export_func_params(mod, mod.exports[i].func_name);
    if (export_has_string_param(params) || export_has_numeric_array_param(params)) {
      return true;
    }
  }
  return false;
}

pub function extern_exports(mod: parser.Module): string {
  let parts: string[] = [];
  for i in 0..mod.exports.len() {
    let x = mod.exports[i];
    let ret = export_func_ret(mod, x.func_name);
    let params = export_func_params(mod, x.func_name);
    if (ret == "string" || export_has_string_param(params) || extern_export_list(ret) || export_has_numeric_array_param(params) || extern_sum_param_supported(ret) || extern_tuple_param_supported(ret) || !returns_value(ret)) {
      parts = parts.append(build_export_wrapper(x.func_name, params, ret));
      parts = parts.append("  (export \"" + x.iface + "#" + x.wit + "\" (func $__xwrap_" + x.func_name + "))\n");
    } else {
      parts = parts.append("  (export \"" + x.iface + "#" + x.wit + "\" (func $" + x.func_name + "))\n");
    }
  }
  return util.str_join_chunks(parts);
}

function lifts_async(mod: parser.Module, mode: i32): boolean {
  return mode == 2 && !module_is_proxy(mod) && async_exports(mod).len() > 0;
}

pub function async_exports(mod: parser.Module): parser.FuncDecl[] {
  let out: parser.FuncDecl[] = [];
  for f in mod.funcs {
    if (f.async && f.import_iface.len() == 0) {
      out = out.append(f);
    }
  }
  return out;
}

pub function is_sync_extern(f: parser.FuncDecl): boolean {
  return f.import_iface.len() > 0 && !f.async;
}

pub function async_imports(mod: parser.Module): parser.FuncDecl[] {
  let out: parser.FuncDecl[] = [];
  for f in mod.funcs {
    if (f.async && f.import_iface.len() > 0) {
      out = out.append(f);
    }
  }
  return out;
}

function async_lower_imports(mod: parser.Module): string {
  let fs = async_imports(mod);
  if (fs.len() == 0) {
    return "";
  }
  let parts: string[] = [];
  for f in fs {
    let sig = "";
    for i in 0..f.params.len() {
      if (is_stream_slot(f, i)) {
        sig += " (param i32)";
      } else {
        sig += extern_core_param(mod, f.params[i].type_name);
      }
    }
    if (returns_value(f.ret_type)) {
      sig += " (param i32)";
    }
    parts = parts.append("  (import \"" + f.import_iface + "\" \"[async-lower]" + f.import_wit + "\" (func $" + f.name + "__async" + sig + " (result i32)))\n");
  }
  parts = parts.append(stream_imports(fs));
  let r = "  (import \"$root\" \"";
  parts = parts.append(r + "[waitable-set-new]\" (func $__fern_ws_new (result i32)))\n");
  parts = parts.append(r + "[waitable-join]\" (func $__fern_w_join (param i32 i32)))\n");
  parts = parts.append(r + "[waitable-set-wait]\" (func $__fern_ws_wait (param i32 i32) (result i32)))\n");
  parts = parts.append(r + "[subtask-drop]\" (func $__fern_subtask_drop (param i32)))\n");
  parts = parts.append(r + "[waitable-set-drop]\" (func $__fern_ws_drop (param i32)))\n");
  return util.str_join_chunks(parts);
}

function is_stream_slot(f: parser.FuncDecl, i: i32): boolean {
  for k in f.streams {
    if (k == i) {
      return true;
    }
  }
  return false;
}

function stream_elem_of(f: parser.FuncDecl, i: i32): string {
  let t = f.ret_type;
  if (i >= 0) {
    t = f.params[i].type_name;
  }
  return list_elem(t);
}

pub function stream_wit_elem(t: string): string {
  let fern: string[] = ["boolean", "u8", "i32", "u32", "i64", "u64", "f32", "f64"];
  let wit: string[] = ["bool", "u8", "s32", "u32", "s64", "u64", "f32", "f64"];
  for i in 0..fern.len() {
    if (fern[i] == t) {
      return wit[i];
    }
  }
  return "";
}

function stream_imports(fs: parser.FuncDecl[]): string {
  let reads: string[] = [];
  let writes: string[] = [];
  for f in fs {
    for k in f.streams {
      let e = stream_wit_elem(stream_elem_of(f, k));
      if (k < 0 && !util.has_str(reads, e)) {
        reads = reads.append(e);
      }
      if (k >= 0 && !util.has_str(writes, e)) {
        writes = writes.append(e);
      }
    }
  }
  let r = "  (import \"$root\" \"";
  let parts: string[] = [];
  for e in reads {
    parts = parts.append(r + "[stream-read]" + e + "\" (func $__fern_stream_read_" + e + " (param i32 i32 i32) (result i32)))\n");
    parts = parts.append(r + "[stream-drop-readable]" + e + "\" (func $__fern_stream_drop_readable_" + e + " (param i32)))\n");
  }
  for e in writes {
    parts = parts.append(r + "[stream-new]" + e + "\" (func $__fern_stream_new_" + e + " (result i64)))\n");
    parts = parts.append(r + "[stream-write]" + e + "\" (func $__fern_stream_write_" + e + " (param i32 i32 i32) (result i32)))\n");
    parts = parts.append(r + "[stream-drop-writable]" + e + "\" (func $__fern_stream_drop_writable_" + e + " (param i32)))\n");
  }
  return util.str_join_chunks(parts);
}

function async_lower_wrappers(mod: parser.Module): string {
  let parts: string[] = [];
  for f in async_imports(mod) {
    parts = parts.append(async_lower_wrapper(mod, f));
  }
  return util.str_join_chunks(parts);
}

function async_lower_wrapper(mod: parser.Module, f: parser.FuncDecl): string {
  let streamed = is_stream_slot(f, -1);
  let composite = is_extern_composite_ret(mod, f.ret_type);
  let rvt = "i32";
  let args = async_lower_args(mod, f);
  if (returns_value(f.ret_type)) {
    args += " (local.get $rb)";
    if (!composite) {
      rvt = wat_extern_valtype(f.ret_type);
    }
  }
  let o = "  (func $" + f.name + extern_param_decls(mod, f) + " (result " + rvt + ")\n" + extern_param_locals(f);
  o = o + "    (local $rb i32) (local $st i32) (local $task i32) (local $ws i32) (local $r " + rvt + ")\n";
  if (composite) {
    o += "    (local $dp i32) (local $ln i32) (local $s i32) (local $i i32)\n";
  }
  o += stream_locals(f);
  o += extern_param_prologue(f);
  o += "    (local.set $rb (call $__fern_alloc (i32.const 16)))\n";
  o += stream_param_opens(f);
  o = o + "    (local.set $st (call $" + f.name + "__async" + args + "))\n";
  o += stream_param_writes(f);
  o += "    (if (i32.ne (i32.and (local.get $st) (i32.const 15)) (i32.const 2)) (then\n";
  o += "      (local.set $task (i32.shr_u (local.get $st) (i32.const 4)))\n";
  o += "      (local.set $ws (call $__fern_ws_new))\n";
  o += "      (call $__fern_w_join (local.get $task) (local.get $ws))\n";
  o += "      (drop (call $__fern_ws_wait (local.get $ws) (i32.add (local.get $rb) (i32.const 8))))\n";
  o += "      (call $__fern_subtask_drop (local.get $task))\n";
  o += "      (call $__fern_ws_drop (local.get $ws))))\n";
  if (streamed) {
    o = o + stream_result_collect(f) + "    (local.set $r (local.get $s))\n";
  } else if (composite) {
    o += "    (local.set $dp (i32.load (local.get $rb)))\n    (local.set $ln (i32.load offset=4 (local.get $rb)))\n";
    o = o + extern_composite_lift(f.ret_type) + "    (local.set $r (local.get $s))\n";
    o += extern_host_free("$dp", extern_composite_host_bytes(f.ret_type));
  } else if (returns_value(f.ret_type)) {
    o = o + "    (local.set $r " + async_result_load(f.ret_type) + ")\n";
  }
  o += "    (call $__fern_raw_free (local.get $rb) (i32.const 16))\n";
  return o + "    (local.get $r))\n";
}

function async_lower_args(mod: parser.Module, f: parser.FuncDecl): string {
  let args = "";
  for i in 0..f.params.len() {
    if (is_stream_slot(f, i)) {
      args = args + " (local.get $sr" + util.i32_to_string(i) + ")";
    } else {
      args += extern_marshal_arg(mod, f.params[i].type_name, i);
    }
  }
  return args;
}

function stream_locals(f: parser.FuncDecl): string {
  if (f.streams.len() == 0) {
    return "";
  }
  let o = "    (local $sh i64) (local $sw i32) (local $sd i32) (local $sb i32) (local $sc i32) (local $sn i32) (local $ss i32)\n";
  for k in f.streams {
    if (k >= 0) {
      o = o + "    (local $sr" + util.i32_to_string(k) + " i32) (local $sv" + util.i32_to_string(k) + " i32)\n";
    }
  }
  return o;
}

function stream_elem_size(f: parser.FuncDecl, k: i32): string {
  let e = stream_wit_elem(stream_elem_of(f, k));
  if (e == "bool" || e == "u8") {
    return "1";
  }
  if (e == "s32" || e == "u32" || e == "f32") {
    return "4";
  }
  return "8";
}

function stream_param_opens(f: parser.FuncDecl): string {
  let o = "";
  for k in f.streams {
    if (k >= 0) {
      let n = util.i32_to_string(k);
      o = o + "    (local.set $sh (call $__fern_stream_new_" + stream_wit_elem(stream_elem_of(f, k)) + "))\n";
      o = o + "    (local.set $sr" + n + " (i32.wrap_i64 (local.get $sh)))\n";
      o = o + "    (local.set $sv" + n + " (i32.wrap_i64 (i64.shr_u (local.get $sh) (i64.const 32))))\n";
    }
  }
  return o;
}

function stream_param_writes(f: parser.FuncDecl): string {
  let o = "";
  for k in f.streams {
    if (k >= 0) {
      let n = util.i32_to_string(k);
      let e = stream_wit_elem(stream_elem_of(f, k));
      let len = "(i32.load (local.get $ep" + n + "))";
      let ptr = "(local.get $ab" + n + ")";
      if (!extern_param_repacks(f.params[k].type_name)) {
        ptr = "(i32.add (local.get $ep" + n + ") (i32.const 8))";
      }
      o += "    (local.set $sw (call $__fern_ws_new))\n";
      o = o + "    (call $__fern_w_join (local.get $sv" + n + ") (local.get $sw))\n";
      o += "    (local.set $sn (i32.const 0))\n";
      o = o + "    (block $swd" + n + " (loop $swl" + n + "\n";
      o = o + "      (br_if $swd" + n + " (i32.ge_u (local.get $sn) " + len + "))\n";
      o = o + "      (local.set $ss (call $__fern_stream_write_" + e + " (local.get $sv" + n + ") (i32.add " + ptr + " (i32.mul (local.get $sn) (i32.const " + stream_elem_size(f, k) + "))) (i32.sub " + len + " (local.get $sn))))\n";
      o += stream_wait_if_blocked();
      o += "      (local.set $sn (i32.add (local.get $sn) (i32.shr_u (local.get $ss) (i32.const 4))))\n";
      o = o + "      (br_if $swd" + n + " (i32.and (local.get $ss) (i32.const 15)))\n";
      o = o + "      (br $swl" + n + ")))\n";
      o = o + "    (call $__fern_w_join (local.get $sv" + n + ") (i32.const 0))\n";
      o = o + "    (call $__fern_stream_drop_writable_" + e + " (local.get $sv" + n + "))\n";
      o += "    (call $__fern_ws_drop (local.get $sw))\n";
    }
  }
  return o;
}

function stream_wait_if_blocked(): string {
  return "      (if (i32.eq (local.get $ss) (i32.const -1)) (then\n"
    + "        (drop (call $__fern_ws_wait (local.get $sw) (i32.add (local.get $rb) (i32.const 8))))\n"
    + "        (local.set $ss (i32.load offset=12 (local.get $rb)))))\n";
}

function stream_result_collect(f: parser.FuncDecl): string {
  let e = stream_wit_elem(stream_elem_of(f, -1));
  let sz = stream_elem_size(f, -1);
  let o = "    (local.set $sd (i32.load (local.get $rb)))\n";
  o += "    (local.set $sc (i32.const 16))\n";
  o = o + "    (local.set $sb (call $__fern_alloc (i32.mul (local.get $sc) (i32.const " + sz + "))))\n";
  o += "    (local.set $sn (i32.const 0))\n";
  o += "    (local.set $sw (call $__fern_ws_new))\n";
  o += "    (call $__fern_w_join (local.get $sd) (local.get $sw))\n";
  o += "    (block $srd (loop $srl\n";
  o += "      (if (i32.eq (local.get $sn) (local.get $sc)) (then\n";
  o = o + "        (local.set $dp (call $__fern_alloc (i32.mul (i32.shl (local.get $sc) (i32.const 1)) (i32.const " + sz + "))))\n";
  o = o + "        (memory.copy (local.get $dp) (local.get $sb) (i32.mul (local.get $sn) (i32.const " + sz + ")))\n";
  o = o + "        (call $__fern_raw_free (local.get $sb) (i32.mul (local.get $sc) (i32.const " + sz + ")))\n";
  o += "        (local.set $sb (local.get $dp))\n";
  o += "        (local.set $sc (i32.shl (local.get $sc) (i32.const 1)))))\n";
  o = o + "      (local.set $ss (call $__fern_stream_read_" + e + " (local.get $sd) (i32.add (local.get $sb) (i32.mul (local.get $sn) (i32.const " + sz + "))) (i32.sub (local.get $sc) (local.get $sn))))\n";
  o += stream_wait_if_blocked();
  o += "      (local.set $sn (i32.add (local.get $sn) (i32.shr_u (local.get $ss) (i32.const 4))))\n";
  o += "      (br_if $srd (i32.and (local.get $ss) (i32.const 15)))\n";
  o += "      (br $srl)))\n";
  o += "    (call $__fern_w_join (local.get $sd) (i32.const 0))\n";
  o = o + "    (call $__fern_stream_drop_readable_" + e + " (local.get $sd))\n";
  o += "    (call $__fern_ws_drop (local.get $sw))\n";
  o += "    (local.set $dp (local.get $sb))\n    (local.set $ln (local.get $sn))\n";
  o += extern_composite_lift(f.ret_type);
  return o + "    (call $__fern_raw_free (local.get $sb) (i32.mul (local.get $sc) (i32.const " + sz + ")))\n";
}

function async_result_load(t: string): string {
  if (t == "u8" || t == "boolean") {
    return "(i32.load8_u (local.get $rb))";
  }
  let vt = extern_core_valtype(t);
  let load = "(" + vt + ".load (local.get $rb))";
  if (vt == "f32") {
    return "(f64.promote_f32 " + load + ")";
  }
  return load;
}

pub function list_elem(t: string): string {
  let bytes: u8[] = [];
  for i in 0..t.len() - 2 {
    bytes = bytes.append(t[i]);
  }
  unsafe {
    return string_from_bytes_unchecked(bytes);
  }
}

pub function async_lift_valtype(t: string): i32 {
  let names: string[] = ["boolean", "u8", "i32", "u32", "i64", "u64", "f32", "f64"];
  let vts: i32[] = [127, 125, 122, 121, 120, 119, 118, 117];
  for i in 0..names.len() {
    if (t == names[i]) {
      return vts[i];
    }
  }
  return -1;
}

function async_lift_imports(mod: parser.Module): string {
  let parts: string[] = [];
  for f in async_exports(mod) {
    let p = "";
    if (returns_value(f.ret_type)) {
      p = " (param " + extern_core_valtype(f.ret_type) + ")";
    }
    parts = parts.append("  (import \"[export]$root\" \"[task-return]" + f.name + "\" (func $__fern_task_return_" + f.name + p + "))\n");
  }
  return util.str_join_chunks(parts);
}

function async_lift_wrappers(mod: parser.Module): string {
  let parts: string[] = [];
  for f in async_exports(mod) {
    let head = "  (func $__fern_async_lift_" + f.name;
    let args = "";
    for i in 0..f.params.len() {
      let t = f.params[i].type_name;
      head = head + " (param " + extern_core_valtype(t) + ")";
      if (t == "f32") {
        args = args + " (f64.promote_f32 (local.get " + util.i32_to_string(i) + "))";
      } else {
        args = args + " (local.get " + util.i32_to_string(i) + ")";
      }
    }
    let call = "(call $" + f.name + args + ")";
    let body = "";
    if (!returns_value(f.ret_type)) {
      body = "    (drop " + call + ")\n    (call $__fern_task_return_" + f.name + ")";
    } else if (f.ret_type == "f32") {
      body = "    (call $__fern_task_return_" + f.name + " (f32.demote_f64 " + call + "))";
    } else {
      body = "    (call $__fern_task_return_" + f.name + " " + call + ")";
    }
    parts = parts.append(head + "\n" + body + ")\n");
    parts = parts.append("  (export \"[async-lift]" + f.name + "\" (func $__fern_async_lift_" + f.name + "))\n");
  }
  return util.str_join_chunks(parts);
}

pub function module_has_extern_composite_result(mod: parser.Module): boolean {
  for i in 0..mod.funcs.len() {
    if (mod.funcs[i].import_iface.len() > 0 && is_extern_composite_ret(mod, mod.funcs[i].ret_type)) {
      return true;
    }
  }
  return false;
}

pub function module_extern_needs_heap(mod: parser.Module): boolean {
  return module_needs_extern_wrappers(mod) || module_has_extern_composite_result(mod)
    || export_needs_heap(mod) || export_needs_realloc(mod) || module_has_array_param_export(mod)
    || async_imports(mod).len() > 0;
}

pub function module_needs_extern_wrappers(mod: parser.Module): boolean {
  for i in 0..mod.funcs.len() {
    if (is_sync_extern(mod.funcs[i]) && extern_needs_wrapper(mod, mod.funcs[i])) {
      return true;
    }
  }
  return false;
}

pub function extern_copy_string(dst: string, ptr: string, len: string, ctr: string, lbl: string): string {
  let o = "";
  o = o + "    (local.set " + dst + " " + xstr_new("(local.get " + len + ")") + ")\n";
  o = o + "    (i32.store (local.get " + dst + ") (local.get " + len + "))\n";
  o = o + "    (local.set " + ctr + " (i32.const 0))\n";
  o = o + "    (block $d" + lbl + " (loop $c" + lbl + "\n";
  o = o + "      (br_if $d" + lbl + " (i32.ge_u (local.get " + ctr + ") (local.get " + len + ")))\n";
  o = o + "      (i32.store8 (i32.add (i32.add (local.get " + dst + ") (i32.const 4)) (local.get " + ctr + ")) (i32.load8_u (i32.add (local.get " + ptr + ") (local.get " + ctr + "))))\n";
  o = o + "      (local.set " + ctr + " (i32.add (local.get " + ctr + ") (i32.const 1)))\n";
  o = o + "      (br $c" + lbl + ")))\n";
  return o;
}

pub function extern_copy_bytes(ty: string, dst: string, ptr: string, len: string, ctr: string, lbl: string): string {
  let stride = "4";
  if (ty == "u8[]") {
    stride = "1";
  }
  let o = "";
  o = o + "    (local.set " + dst + " (call $__fern_arr_elems (local.get " + len + ") (i32.const " + stride + ")))\n";
  o = o + "    (i32.store (local.get " + dst + ") (local.get " + len + "))\n";
  o = o + "    (i32.store offset=4 (local.get " + dst + ") (local.get " + len + "))\n";
  if (ty == "u8[]") {
    return o + "    (memory.copy (i32.add (local.get " + dst + ") (i32.const 8)) (local.get " + ptr + ") (local.get " + len + "))\n";
  }
  o = o + "    (local.set " + ctr + " (i32.const 0))\n";
  o = o + "    (block $d" + lbl + " (loop $c" + lbl + "\n";
  o = o + "      (br_if $d" + lbl + " (i32.ge_u (local.get " + ctr + ") (local.get " + len + ")))\n";
  o = o + "      (i32.store (i32.add (i32.add (local.get " + dst + ") (i32.const 8)) (i32.mul (local.get " + ctr + ") (i32.const 4))) (i32.load8_u (i32.add (local.get " + ptr + ") (local.get " + ctr + "))))\n";
  o = o + "      (local.set " + ctr + " (i32.add (local.get " + ctr + ") (i32.const 1)))\n";
  o = o + "      (br $c" + lbl + ")))\n";
  return o;
}

function extern_sum_result_locals(): string {
  return "    (local $rbase i32) (local $rb i32) (local $s i32) (local $dp i32) (local $ln i32) (local $hp i32) (local $i i32)\n";
}

function extern_ret_area(n: i32): string {
  return "    (local.set $rbase (call $__fern_alloc (i32.const " + util.i32_to_string(n + 7) + ")))\n"
    + "    (local.set $rb (i32.and (i32.add (local.get $rbase) (i32.const 7)) (i32.const -8)))\n"
    + "    (memory.fill (local.get $rb) (i32.const 0) (i32.const " + util.i32_to_string(n) + "))\n";
}

function extern_ret_area_free(n: i32): string {
  return "    (call $__fern_raw_free (local.get $rbase) (i32.const " + util.i32_to_string(n + 7) + "))\n";
}

function extern_host_free(ptr: string, bytes: string): string {
  return "    (call $__fern_raw_free (local.get " + ptr + ") " + bytes + ")\n";
}

function extern_composite_host_bytes(ret: string): string {
  if (ret == "u8[]" || ret == "boolean[]" || !extern_array_param_supported(ret)) {
    return "(local.get $ln)";
  }
  let rk = slice_unchecked(ret, 0, ret.len() - 2);
  return "(i32.mul (local.get $ln) (i32.const " + util.i32_to_string(extern_list_elem_size(rk)) + "))";
}

function extern_sum_result_tail(fname: string, ret: string, callargs: string): string {
  let heap = extern_sum_heap_payload(ret);
  let opt = extern_sum_param_is_option(ret);
  let wide = extern_sum_wide_payload(ret);
  let o = "";
  o += extern_ret_area(64);
  o = o + "    (call $" + fname + "__import" + callargs + " (local.get $rb))\n";
  if (wide) {
    o = o + "    (local.set $s " + xbox_new(16) + ")\n";
  } else {
    o = o + "    (local.set $s " + xbox_new(8) + ")\n";
  }
  if (opt) {
    o += "    (i32.store (local.get $s) (i32.sub (i32.const 1) (i32.load8_u (local.get $rb))))\n";
  } else {
    o += "    (i32.store (local.get $s) (i32.load8_u (local.get $rb)))\n";
  }
  if (wide) {
    o += "    (i64.store offset=8 (local.get $s) (i64.load offset=8 (local.get $rb)))\n";
  } else if (heap.len() == 0) {
    o += "    (i32.store offset=4 (local.get $s) (i32.load offset=4 (local.get $rb)))\n";
  } else {
    let sel = "0";
    if (opt) {
      sel = "1";
    }
    o = o + "    (if (i32.eq (i32.load8_u (local.get $rb)) (i32.const " + sel + ")) (then\n";
    o += "      (local.set $dp (i32.load offset=4 (local.get $rb)))\n";
    o += "      (local.set $ln (i32.load offset=8 (local.get $rb)))\n";
    if (heap == "string") {
      o += extern_copy_string("$hp", "$dp", "$ln", "$i", "h");
    } else {
      o += extern_copy_bytes(heap, "$hp", "$dp", "$ln", "$i", "h");
    }
    o += extern_host_free("$dp", "(local.get $ln)");
    o += "      (i32.store offset=4 (local.get $s) (local.get $hp)))\n";
    if (opt) {
      o += "    (else (i32.store offset=4 (local.get $s) (i32.const 0))))\n";
    } else {
      o += "    (else (i32.store offset=4 (local.get $s) (i32.load offset=4 (local.get $rb)))))\n";
    }
  }
  o += extern_ret_area_free(64);
  o += "    (local.get $s))\n";
  return o;
}

function extern_tuple_result_wrapper(f: parser.FuncDecl): string {
  let n = tuple_type_elem_count(f.ret_type);
  let parts: string[] = [];
  parts = parts.append("  (func $" + f.name);
  let args = "";
  for p in 0..f.params.len() {
    parts = parts.append(" (param $ep" + util.i32_to_string(p) + " " + wat_extern_valtype(f.params[p].type_name) + ")");
    args = args + " " + extern_core_arg(f.params[p].type_name, "$ep" + util.i32_to_string(p));
  }
  parts = parts.append(" (result i32)\n");
  parts = parts.append("    (local $rbase i32) (local $rb i32) (local $s i32)\n");
  parts = parts.append(extern_ret_area(n * 4));
  parts = parts.append("    (call $" + f.name + "__import" + args + " (local.get $rb))\n");
  parts = parts.append("    (local.set $s (call $__fern_str_box (i32.const " + util.i32_to_string(n * 8) + ")))\n");
  for e in 0..n {
    parts = parts.append("    (i32.store (i32.add (local.get $s) (i32.const " + util.i32_to_string(e * 8) + ")) (i32.load (i32.add (local.get $rb) (i32.const " + util.i32_to_string(e * 4) + "))))\n");
  }
  parts = parts.append(extern_ret_area_free(n * 4));
  parts = parts.append("    (local.get $s))\n");
  return util.str_join_chunks(parts);
}

function extern_param_decls(mod: parser.Module, f: parser.FuncDecl): string {
  let parts: string[] = [];
  for pp in 0..f.params.len() {
    let ppn = "$ep" + util.i32_to_string(pp);
    if (f.params[pp].type_name == "string" || extern_array_param_supported(f.params[pp].type_name) || extern_byte_array_param(f.params[pp].type_name) || extern_record_param_supported(mod, f.params[pp].type_name) || extern_sum_param_supported(f.params[pp].type_name) || extern_tuple_param_supported(f.params[pp].type_name) || extern_plain_enum_param(mod, f.params[pp].type_name) || extern_variant_param_supported(mod, f.params[pp].type_name)) {
      parts = parts.append(" (param " + ppn + " i32)");
    } else {
      parts = parts.append(" (param " + ppn + " " + wat_extern_valtype(f.params[pp].type_name) + ")");
    }
  }
  return util.str_join_chunks(parts);
}

function extern_param_locals(f: parser.FuncDecl): string {
  let parts: string[] = [];
  let na = 0;
  for qi in 0..f.params.len() {
    if (extern_param_repacks(f.params[qi].type_name)) {
      parts = parts.append("    (local $ab" + util.i32_to_string(qi) + " i32)\n");
      na += 1;
    }
  }
  if (na > 0) {
    parts = parts.append("    (local $ai i32) (local $an i32)\n");
  }
  return util.str_join_chunks(parts);
}

function extern_param_prologue(f: parser.FuncDecl): string {
  let parts: string[] = [];
  for ci in 0..f.params.len() {
    if (extern_array_param_supported(f.params[ci].type_name)) {
      let cppn = "$ep" + util.i32_to_string(ci);
      let bn = "$ab" + util.i32_to_string(ci);
      let tn = f.params[ci].type_name;
      let k = slice_unchecked(tn, 0, tn.len() - 2);
      let ss = util.i32_to_string(elem_slot_size(k));
      let cs = util.i32_to_string(extern_list_elem_size(k));
      let lbl = util.i32_to_string(ci);
      let src = "(i32.add (i32.add (local.get " + cppn + ") (i32.const 8)) (i32.mul (local.get $ai) (i32.const " + ss + ")))";
      let dst = "(i32.add (local.get " + bn + ") (i32.mul (local.get $ai) (i32.const " + cs + ")))";
      parts = parts.append("    (local.set $an (i32.load (local.get " + cppn + ")))\n");
      parts = parts.append("    (local.set " + bn + " (i32.and (i32.add (call $__fern_alloc (i32.mul (local.get $an) (i32.const " + cs + "))) (i32.const 7)) (i32.const -8)))\n");
      parts = parts.append("    (local.set $ai (i32.const 0))\n");
      parts = parts.append("    (block $d" + lbl + " (loop $c" + lbl + "\n");
      parts = parts.append("      (br_if $d" + lbl + " (i32.ge_u (local.get $ai) (local.get $an)))\n");
      parts = parts.append("      " + extern_elem_to_canon(k, dst, src) + "\n");
      parts = parts.append("      (local.set $ai (i32.add (local.get $ai) (i32.const 1)))\n");
      parts = parts.append("      (br $c" + lbl + ")))\n");
    } else if (extern_param_repacks(f.params[ci].type_name)) {
      let ucppn = "$ep" + util.i32_to_string(ci);
      let ubn = "$ab" + util.i32_to_string(ci);
      let ulbl = util.i32_to_string(ci);
      parts = parts.append("    (local.set $an (i32.load (local.get " + ucppn + ")))\n");
      parts = parts.append("    (local.set " + ubn + " (call $__fern_alloc (local.get $an)))\n");
      parts = parts.append("    (local.set $ai (i32.const 0))\n");
      parts = parts.append("    (block $d" + ulbl + " (loop $c" + ulbl + "\n");
      parts = parts.append("      (br_if $d" + ulbl + " (i32.ge_u (local.get $ai) (local.get $an)))\n");
      parts = parts.append("      (i32.store8 (i32.add (local.get " + ubn + ") (local.get $ai)) (i32.load (i32.add (i32.add (local.get " + ucppn + ") (i32.const 8)) (i32.mul (local.get $ai) (i32.const 4)))))\n");
      parts = parts.append("      (local.set $ai (i32.add (local.get $ai) (i32.const 1)))\n");
      parts = parts.append("      (br $c" + ulbl + ")))\n");
    }
  }
  return util.str_join_chunks(parts);
}

function extern_marshal_args(mod: parser.Module, f: parser.FuncDecl): string {
  let margs = "";
  for fi in 0..f.params.len() {
    margs += extern_marshal_arg(mod, f.params[fi].type_name, fi);
  }
  return margs;
}

function extern_marshal_arg(mod: parser.Module, t: string, fi: i32): string {
  let fppn = "$ep" + util.i32_to_string(fi);
  let margs = "";
  if (t == "string") {
    margs += " (i32.add (local.get " + fppn + ") (i32.const 4)) (i32.load (local.get " + fppn + "))";
  } else if (extern_param_repacks(t)) {
    margs += " (local.get $ab" + util.i32_to_string(fi) + ") (i32.load (local.get " + fppn + "))";
  } else if (extern_byte_array_param(t)) {
    margs += " (i32.add (local.get " + fppn + ") (i32.const 8)) (i32.load (local.get " + fppn + "))";
  } else if (extern_record_param_supported(mod, t)) {
    margs += extern_emit_record_param_leaves(mod, "(local.get " + fppn + ")", t);
  } else if (extern_sum_param_supported(t)) {
    if (extern_sum_param_is_option(t)) {
      margs += " (i32.sub (i32.const 1) (i32.load (local.get " + fppn + ")))";
    } else {
      margs += " (i32.load (local.get " + fppn + "))";
    }
    margs += " (i32.load offset=4 (local.get " + fppn + "))";
  } else if (extern_tuple_param_supported(t)) {
    let tfi = 0;
    while (tfi < tuple_type_elem_count(t)) {
      margs += " (i32.load (i32.add (local.get " + fppn + ") (i32.const " + util.i32_to_string(tfi * 8) + ")))";
      tfi += 1;
    }
  } else if (extern_plain_enum_param(mod, t)) {
    margs += " " + extern_plain_enum_disc(mod, t, fppn);
  } else if (extern_variant_param_supported(mod, t)) {
    margs += " " + extern_plain_enum_disc(mod, t, fppn);
    if (extern_variant_is_multifield(mod, t)) {
      let msc = extern_variant_max_fields(mod, t);
      for msi in 0..msc {
        margs += " " + extern_variant_multifield_slot(mod, t, msi, fppn);
      }
    } else if (extern_variant_is_uniform_f64(mod, t)) {
      margs += " (f64.load (i32.add (local.get " + fppn + ") (i32.const " + util.i32_to_string(xbox_field_off(0)) + ")))";
    } else if (extern_variant_join_is64(mod, t)) {
      margs += " " + extern_variant_payload_join_i64(mod, t, fppn);
    } else if (extern_variant_has_f32_arm(mod, t)) {
      margs += " " + extern_variant_payload_join_i32_f32(mod, t, fppn);
    } else {
      margs += " (i32.load (i32.add (local.get " + fppn + ") (i32.const " + util.i32_to_string(xbox_field_off(0)) + ")))";
    }
  } else {
    margs += " " + extern_core_arg(t, fppn);
  }
  return margs;
}

function extern_composite_lift(ret: string): string {
  let parts: string[] = [];
  if (ret == "u8[]" || ret == "boolean[]") {
    parts = parts.append(extern_copy_bytes(ret, "$s", "$dp", "$ln", "$i", ""));
  } else if (extern_array_param_supported(ret)) {
    let rk = slice_unchecked(ret, 0, ret.len() - 2);
    let rss = util.i32_to_string(elem_slot_size(rk));
    let rcs = util.i32_to_string(extern_list_elem_size(rk));
    parts = parts.append("    (local.set $s (call $__fern_arr_elems (local.get $ln) (i32.const " + rss + ")))\n");
    parts = parts.append("    (i32.store (local.get $s) (local.get $ln))\n");
    parts = parts.append("    (i32.store offset=4 (local.get $s) (local.get $ln))\n");
    parts = parts.append("    (local.set $i (i32.const 0))\n");
    parts = parts.append("    (block $d (loop $c\n");
    parts = parts.append("      (br_if $d (i32.ge_u (local.get $i) (local.get $ln)))\n");
    parts = parts.append("      " + extern_elem_from_canon(rk, "(i32.add (i32.add (local.get $s) (i32.const 8)) (i32.mul (local.get $i) (i32.const " + rss + ")))", "(i32.add (local.get $dp) (i32.mul (local.get $i) (i32.const " + rcs + ")))") + "\n");
    parts = parts.append("      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n");
    parts = parts.append("      (br $c)))\n");
  } else {
    parts = parts.append("    (local.set $s " + xstr_new("(local.get $ln)") + ")\n");
    parts = parts.append("    (i32.store (local.get $s) (local.get $ln))\n");
    parts = parts.append("    (local.set $i (i32.const 0))\n");
    parts = parts.append("    (block $d (loop $c\n");
    parts = parts.append("      (br_if $d (i32.ge_u (local.get $i) (local.get $ln)))\n");
    parts = parts.append("      (i32.store8 (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (local.get $dp) (local.get $i))))\n");
    parts = parts.append("      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n");
    parts = parts.append("      (br $c)))\n");
  }
  return util.str_join_chunks(parts);
}

pub function extern_wrappers(mod: parser.Module): string {
  let stab = irtables.struct_tab(mod.structs);
  let parts: string[] = [];
  for i in 0..mod.funcs.len() {
    let f = mod.funcs[i];
    if (is_sync_extern(f) && extern_marshals(mod, f)) {
      let sum_ret = extern_sum_result_supported(f.ret_type);
      parts = parts.append("  (func $" + f.name);
      parts = parts.append(extern_param_decls(mod, f));
      let void_shim = !returns_value(f.ret_type);
      if (sum_ret) {
        parts = parts.append(" (result i32)");
      } else if (returns_value(f.ret_type)) {
        parts = parts.append(" (result " + wat_extern_valtype(f.ret_type) + ")");
      } else if (void_shim) {
        parts = parts.append(" (result i32)");
      }
      parts = parts.append("\n");
      parts = parts.append(extern_param_locals(f));
      if (sum_ret) {
        parts = parts.append(extern_sum_result_locals());
      }
      parts = parts.append(extern_param_prologue(f));
      let margs = extern_marshal_args(mod, f);
      if (sum_ret) {
        parts = parts.append(extern_sum_result_tail(f.name, f.ret_type, margs));
      } else {
        if (f.ret_type == "f32") {
          parts = parts.append("    (f64.promote_f32 (call $" + f.name + "__import" + margs + "))");
        } else {
          parts = parts.append("    (call $" + f.name + "__import" + margs + ")");
        }
        if (void_shim) {
          parts = parts.append("\n    (i32.const 0)");
        }
        parts = parts.append(")\n");
      }
    } else if (is_sync_extern(f) && extern_record_ret_direct(mod, f.ret_type)) {
      parts = parts.append("  (func $" + f.name);
      for dp in 0..f.params.len() {
        parts = parts.append(" (param $ep" + util.i32_to_string(dp) + " " + wat_extern_valtype(f.params[dp].type_name) + ")");
      }
      parts = parts.append(" (result i32)\n");
      parts = parts.append("    (local $s i32)\n");
      parts = parts.append("    (local.set $s " + xbox_new(xbox_bytes(1)) + ")\n");
      parts = parts.append("    (i32.store (local.get $s) (i32.const " + util.i32_to_string(struct_id(stab, f.ret_type)) + "))\n");
      let dcall: string[] = ["(call $" + f.name + "__import"];
      for da in 0..f.params.len() {
        dcall = dcall.append(" " + extern_core_arg(f.params[da].type_name, "$ep" + util.i32_to_string(da)));
      }
      dcall = dcall.append(")");
      let dslot = "(i32.add (local.get $s) (i32.const " + util.i32_to_string(xbox_field_off(0)) + "))";
      parts = parts.append("    " + extern_slot_store(struct_field_type_at(stab, f.ret_type, 0), dslot, util.str_join_chunks(dcall)) + "\n");
      parts = parts.append("    (local.get $s))\n");
    } else if (is_sync_extern(f) && extern_record_result_supported(mod, f.ret_type)) {
      let nf = struct_field_count(stab, f.ret_type);
      let canonsz = extern_canon_record_size_nested(mod, f.ret_type);
      let maxdepth = extern_record_depth(mod, f.ret_type);
      parts = parts.append("  (func $" + f.name);
      for rp in 0..f.params.len() {
        parts = parts.append(" (param $ep" + util.i32_to_string(rp) + " " + wat_extern_valtype(f.params[rp].type_name) + ")");
      }
      parts = parts.append(" (result i32)\n");
      parts = parts.append("    (local $rbase i32) (local $rb i32) (local $s i32)");
      for dl in 0..maxdepth {
        parts = parts.append(" (local $inner" + util.i32_to_string(dl) + " i32)");
      }
      parts = parts.append("\n");
      parts = parts.append(extern_ret_area(canonsz));
      parts = parts.append("    (call $" + f.name + "__import");
      for ra in 0..f.params.len() {
        parts = parts.append(" " + extern_core_arg(f.params[ra].type_name, "$ep" + util.i32_to_string(ra)));
      }
      parts = parts.append(" (local.get $rb))\n");
      parts = parts.append("    (local.set $s (call $__fern_str_box (i32.const " + util.i32_to_string(xbox_bytes(nf)) + ")))\n");
      parts = parts.append("    (i32.store (local.get $s) (i32.const " + util.i32_to_string(struct_id(stab, f.ret_type)) + "))\n");
      parts = parts.append(extern_emit_record_fill(mod, "$s", f.ret_type, 0, 0));
      parts = parts.append(extern_ret_area_free(canonsz));
      parts = parts.append("    (local.get $s))\n");
    } else if (is_sync_extern(f) && extern_tuple_param_supported(f.ret_type)) {
      parts = parts.append(extern_tuple_result_wrapper(f));
    } else if (is_sync_extern(f) && extern_sum_result_supported(f.ret_type)) {
      parts = parts.append("  (func $" + f.name);
      let sp2 = 0;
      let sargs = "";
      while (sp2 < f.params.len()) {
        parts = parts.append(" (param $ep" + util.i32_to_string(sp2) + " " + wat_extern_valtype(f.params[sp2].type_name) + ")");
        sargs = sargs + " " + extern_core_arg(f.params[sp2].type_name, "$ep" + util.i32_to_string(sp2));
        sp2 += 1;
      }
      parts = parts.append(" (result i32)\n");
      parts = parts.append(extern_sum_result_locals());
      parts = parts.append(extern_sum_result_tail(f.name, f.ret_type, sargs));
    } else if (is_sync_extern(f) && extern_plain_enum_param(mod, f.ret_type)) {
      parts = parts.append("  (func $" + f.name);
      for enp in 0..f.params.len() {
        parts = parts.append(" (param $ep" + util.i32_to_string(enp) + " " + wat_extern_valtype(f.params[enp].type_name) + ")");
      }
      parts = parts.append(" (result i32)\n");
      parts = parts.append("    (local $d i32) (local $s i32)\n");
      parts = parts.append("    (local.set $d (call $" + f.name + "__import");
      for ena in 0..f.params.len() {
        parts = parts.append(" " + extern_core_arg(f.params[ena].type_name, "$ep" + util.i32_to_string(ena)));
      }
      parts = parts.append("))\n");
      parts = parts.append("    (local.set $s " + xbox_new(xbox_bytes(0)) + ")\n");
      parts = parts.append("    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n");
      parts = parts.append("    (local.get $s))\n");
    } else if (is_sync_extern(f) && extern_variant_string_arms(mod, f.ret_type).len() > 0) {
      let sarms = extern_variant_string_arms(mod, f.ret_type);
      parts = parts.append("  (func $" + f.name);
      let svp = 0;
      let svargs = "";
      while (svp < f.params.len()) {
        parts = parts.append(" (param $ep" + util.i32_to_string(svp) + " " + wat_extern_valtype(f.params[svp].type_name) + ")");
        svargs = svargs + " " + extern_core_arg(f.params[svp].type_name, "$ep" + util.i32_to_string(svp));
        svp += 1;
      }
      parts = parts.append(" (result i32)\n");
      parts = parts.append("    (local $d i32)" + extern_sum_result_locals());
      parts = parts.append(extern_ret_area(64));
      parts = parts.append("    (call $" + f.name + "__import" + svargs + " (local.get $rb))\n");
      parts = parts.append("    (local.set $d (i32.load8_u (local.get $rb)))\n");
      parts = parts.append("    (local.set $s " + xbox_new(xbox_bytes(1)) + ")\n");
      parts = parts.append("    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n");
      let spoff = util.i32_to_string(xbox_field_off(0));
      parts = parts.append("    (if " + extern_variant_string_arm_test(sarms) + " (then\n");
      parts = parts.append("      (local.set $dp (i32.load offset=4 (local.get $rb)))\n");
      parts = parts.append("      (local.set $ln (i32.load offset=8 (local.get $rb)))\n");
      parts = parts.append(extern_copy_string("$hp", "$dp", "$ln", "$i", "h"));
      parts = parts.append(extern_host_free("$dp", "(local.get $ln)"));
      parts = parts.append("      (i32.store offset=" + spoff + " (local.get $s) (local.get $hp)))\n");
      parts = parts.append("    (else (i32.store offset=" + spoff + " (local.get $s) (i32.const 0))))\n");
      parts = parts.append(extern_ret_area_free(64));
      parts = parts.append("    (local.get $s))\n");
    } else if (is_sync_extern(f) && extern_variant_result_supported(mod, f.ret_type)) {
      let vj64 = extern_variant_join_is64(mod, f.ret_type);
      let vmf = extern_variant_is_multifield(mod, f.ret_type);
      let vsc = extern_variant_max_fields(mod, f.ret_type);
      parts = parts.append("  (func $" + f.name);
      for vrp in 0..f.params.len() {
        parts = parts.append(" (param $ep" + util.i32_to_string(vrp) + " " + wat_extern_valtype(f.params[vrp].type_name) + ")");
      }
      parts = parts.append(" (result i32)\n");
      parts = parts.append("    (local $rbase i32) (local $rb i32) (local $d i32) (local $s i32)\n");
      let varea = 8;
      if (vmf) {
        varea = extern_variant_area_size(mod, f.ret_type);
      } else if (vj64) {
        varea = 16;
      }
      parts = parts.append(extern_ret_area(varea));
      parts = parts.append("    (call $" + f.name + "__import");
      for vra in 0..f.params.len() {
        parts = parts.append(" " + extern_core_arg(f.params[vra].type_name, "$ep" + util.i32_to_string(vra)));
      }
      parts = parts.append(" (local.get $rb))\n");
      parts = parts.append("    (local.set $d (i32.load8_u (local.get $rb)))\n");
      let poff = util.i32_to_string(xbox_field_off(0));
      if (vmf) {
        parts = parts.append("    (local.set $s " + xbox_new(xbox_bytes(vsc)) + ")\n");
        parts = parts.append("    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n");
        parts = parts.append(extern_variant_multifield_lift(mod, f.ret_type, extern_variant_payload_align(mod, f.ret_type)));
      } else if (extern_variant_is_uniform_f64(mod, f.ret_type)) {
        parts = parts.append("    (local.set $s " + xbox_new(xbox_bytes(1)) + ")\n");
        parts = parts.append("    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n");
        parts = parts.append("    (f64.store offset=" + poff + " (local.get $s) (f64.load offset=8 (local.get $rb)))\n");
      } else if (vj64) {
        parts = parts.append("    (local.set $s " + xbox_new(xbox_bytes(1)) + ")\n");
        parts = parts.append("    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n");
        parts = parts.append("    (i64.store offset=" + poff + " (local.get $s) (i64.load offset=8 (local.get $rb)))\n");
      } else if (extern_variant_has_f32_arm(mod, f.ret_type)) {
        parts = parts.append("    (local.set $s " + xbox_new(xbox_bytes(1)) + ")\n");
        parts = parts.append("    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n");
        parts = parts.append("    " + extern_variant_result_store_f32(mod, f.ret_type) + "\n");
      } else {
        parts = parts.append("    (local.set $s " + xbox_new(xbox_bytes(1)) + ")\n");
        parts = parts.append("    (i32.store (local.get $s) " + extern_plain_enum_sid(mod, f.ret_type, "$d") + ")\n");
        parts = parts.append("    (i32.store offset=" + poff + " (local.get $s) (i32.load offset=4 (local.get $rb)))\n");
      }
      parts = parts.append(extern_ret_area_free(varea));
      parts = parts.append("    (local.get $s))\n");
    } else if (is_sync_extern(f) && extern_string_tuple_array_result(f.ret_type)) {
      let ttn = tuple_type_elem_count(slice_unchecked(f.ret_type, 0, f.ret_type.len() - 2));
      let tstride = util.i32_to_string(ttn * 8);
      parts = parts.append("  (func $" + f.name);
      let ttargs = "";
      for ttp in 0..f.params.len() {
        parts = parts.append(" (param $ep" + util.i32_to_string(ttp) + " " + wat_extern_valtype(f.params[ttp].type_name) + ")");
        ttargs = ttargs + " " + extern_core_arg(f.params[ttp].type_name, "$ep" + util.i32_to_string(ttp));
      }
      parts = parts.append(" (result i32)\n");
      parts = parts.append("    (local $rbase i32) (local $rb i32) (local $dp i32) (local $ln i32) (local $s i32) (local $i i32) (local $t i32) (local $sp i32) (local $sl i32) (local $hp i32) (local $q i32)\n");
      parts = parts.append(extern_ret_area(8));
      parts = parts.append("    (call $" + f.name + "__import" + ttargs + " (local.get $rb))\n");
      parts = parts.append("    (local.set $dp (i32.load (local.get $rb)))\n");
      parts = parts.append("    (local.set $ln (i32.load offset=4 (local.get $rb)))\n");
      parts = parts.append("    (local.set $s (call $__fern_arr_elems (local.get $ln) (i32.const 4)))\n");
      parts = parts.append("    (i32.store (local.get $s) (local.get $ln))\n");
      parts = parts.append("    (i32.store offset=4 (local.get $s) (local.get $ln))\n");
      parts = parts.append("    (local.set $i (i32.const 0))\n");
      parts = parts.append("    (block $da (loop $ca\n");
      parts = parts.append("      (br_if $da (i32.ge_u (local.get $i) (local.get $ln)))\n");
      parts = parts.append("      (local.set $t (call $__fern_str_box (i32.const " + tstride + ")))\n");
      for tj in 0..ttn {
        let toff = util.i32_to_string(tj * 8);
        let tloff = util.i32_to_string(tj * 8 + 4);
        parts = parts.append("      (local.set $sp (i32.load offset=" + toff + " (i32.add (local.get $dp) (i32.mul (local.get $i) (i32.const " + tstride + ")))))\n");
        parts = parts.append("      (local.set $sl (i32.load offset=" + tloff + " (i32.add (local.get $dp) (i32.mul (local.get $i) (i32.const " + tstride + ")))))\n");
        parts = parts.append(extern_copy_string("$hp", "$sp", "$sl", "$q", "e" + util.i32_to_string(tj)));
        parts = parts.append(extern_host_free("$sp", "(local.get $sl)"));
        parts = parts.append("      (i32.store offset=" + toff + " (local.get $t) (local.get $hp))\n");
      }
      parts = parts.append("      (i32.store (i32.add (i32.add (local.get $s) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (local.get $t))\n");
      parts = parts.append("      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n");
      parts = parts.append("      (br $ca)))\n");
      parts = parts.append(extern_host_free("$dp", "(i32.mul (local.get $ln) (i32.const " + tstride + "))"));
      parts = parts.append(extern_ret_area_free(8));
      parts = parts.append("    (local.get $s))\n");
    } else if (is_sync_extern(f) && is_extern_composite_ret(mod, f.ret_type)) {
      parts = parts.append("  (func $" + f.name);
      let args = "";
      for p in 0..f.params.len() {
        let pn = "$ep" + util.i32_to_string(p);
        parts = parts.append(" (param " + pn + " " + wat_extern_valtype(f.params[p].type_name) + ")");
        args = args + " (local.get " + pn + ")";
      }
      parts = parts.append(" (result i32)\n");
      parts = parts.append("    (local $rbase i32) (local $rb i32) (local $dp i32) (local $ln i32) (local $s i32) (local $i i32)\n");
      parts = parts.append(extern_ret_area(8));
      parts = parts.append("    (call $" + f.name + "__import" + args + " (local.get $rb))\n");
      parts = parts.append("    (local.set $dp (i32.load (local.get $rb)))\n");
      parts = parts.append("    (local.set $ln (i32.load offset=4 (local.get $rb)))\n");
      parts = parts.append(extern_composite_lift(f.ret_type));
      parts = parts.append(extern_host_free("$dp", extern_composite_host_bytes(f.ret_type)));
      parts = parts.append(extern_ret_area_free(8));
      parts = parts.append("    (local.get $s))\n");
    } else if (is_sync_extern(f) && !returns_value(f.ret_type)) {
      parts = parts.append("  (func $" + f.name);
      for vp in 0..f.params.len() {
        parts = parts.append(" (param $ep" + util.i32_to_string(vp) + " " + wat_extern_valtype(f.params[vp].type_name) + ")");
      }
      parts = parts.append(" (result i32)\n");
      parts = parts.append("    (call $" + f.name + "__import");
      for va in 0..f.params.len() {
        parts = parts.append(" " + extern_core_arg(f.params[va].type_name, "$ep" + util.i32_to_string(va)));
      }
      parts = parts.append(")\n    (i32.const 0))\n");
    }
  }
  return util.str_join_chunks(parts);
}

pub function struct_field_count(structs: irtables.StructTab, tn: string): i32 {
  for i in 0..structs.decls.len() {
    if (structs.decls[i].name == tn) {
      return structs.decls[i].fields.len();
    }
  }
  return 0;
}

pub function struct_id(structs: irtables.StructTab, name: string): i32 {
  for i in 0..structs.decls.len() {
    if (structs.decls[i].name == name) {
      return i;
    }
  }
  return -1;
}

pub function xbox_field_off(idx: i32): i32 {
  return 8 * (1 + idx);
}

pub function xbox_bytes(nf: i32): i32 {
  return 8 * (1 + nf);
}

pub function xbox_new(bytes: i32): string {
  return "(call $__fern_str_box (i32.const " + util.i32_to_string(bytes) + "))";
}

pub function xstr_new(len_expr: string): string {
  return "(call $__fern_str_box (i32.add (i32.const 4) " + len_expr + "))";
}

pub function nth_tuple_type_elem(spelling: string, idx: i32): string {
  let r = parser.parse_type_ref(spelling);
  if (r.array_depth != 0 || !r.is_tuple) {
    return "";
  }
  if (idx < 0 || idx >= r.args.len()) {
    return "";
  }
  return parser.render_type_ref(r.args[idx]);
}

function extern_list_elem_size(kind: string): i32 {
  if (kind == "f32") {
    return 4;
  }
  return elem_slot_size(kind);
}

function extern_elem_to_canon(kind: string, dst: string, src: string): string {
  if (kind == "f32") {
    return "(f32.store " + dst + " (f32.demote_f64 (f64.load " + src + ")))";
  }
  return "(" + elem_store_op(kind) + " " + dst + " (" + elem_load_op(kind) + " " + src + "))";
}

function extern_elem_from_canon(kind: string, dst: string, src: string): string {
  if (kind == "f32") {
    return "(f64.store " + dst + " (f64.promote_f32 (f32.load " + src + ")))";
  }
  return "(" + elem_store_op(kind) + " " + dst + " (" + elem_load_op(kind) + " " + src + "))";
}

pub function elem_slot_size(kind: string): i32 {
  if (elem_is_i64slot(kind) || parser.is_float_type_name(kind)) {
    return 8;
  }
  return 4;
}

pub function elem_store_op(kind: string): string {
  if (elem_is_i64slot(kind)) {
    return "i64.store";
  }
  if (parser.is_float_type_name(kind)) {
    return "f64.store";
  }
  return "i32.store";
}

function elem_is_i64slot(kind: string): boolean {
  return kind == "i64" || kind == "u64";
}

pub function elem_load_op(kind: string): string {
  if (elem_is_i64slot(kind)) {
    return "i64.load";
  }
  if (parser.is_float_type_name(kind)) {
    return "f64.load";
  }
  return "i32.load";
}

pub function returns_value(ret_type: string): boolean {
  if (ret_type.len() == 0) {
    return false;
  }
  if (ret_type == "void") {
    return false;
  }
  return true;
}

pub function parse_result_err_payload(t: string): string {
  let r = parser.parse_type_ref(t);
  if (r.array_depth == 0 && r.base == "Result" && r.args.len() >= 2) {
    return parser.render_type_ref(r.args[1]);
  }
  return "";
}

pub function parse_option_payload(t: string): string {
  let r = parser.parse_type_ref(t);
  if (r.array_depth == 0 && (r.base == "Option" || r.base == "Result") && r.args.len() >= 1) {
    return parser.render_type_ref(r.args[0]);
  }
  return "";
}

function call_name_of(e: ast.Expr, own acc: Map[string, boolean]): Map[string, boolean] {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          return acc.insert(id.name, true);
        },
        _ => {}
      }
    },
    _ => {}
  }
  return acc;
}

function called_names(mod: parser.Module): util.NameIndex {
  let acc: Map[string, boolean] = map_new(64);
  for t in 0..mod.top_stmts.len() {
    acc = astwalk.fold_stmt(mod.top_stmts[t], acc, call_name_of);
  }
  for f in 0..mod.funcs.len() {
    let i = 0;
    while (i < mod.funcs[f].body.len()) {
      acc = astwalk.fold_stmt(mod.funcs[f].body[i], acc, call_name_of);
      i += 1;
    }
  }
  return util.name_index(acc.keys());
}

struct HostNeeds { io: boolean, rd: boolean, wr: boolean, env: boolean, args: boolean, rnd: boolean, clkw: boolean, clkm: boolean, clkres: boolean, ep: boolean, ex: boolean, net: boolean, fs: boolean, wait: boolean }

pub function census_on(sw: asmcore.Switches): boolean {
  return sw.sanitize || sw.leak_check;
}

function host_needs(mod: parser.Module, census: boolean): HostNeeds {
  let calls = called_names(mod);
  return HostNeeds {
    io: calls.has("print") || calls.has("write") || calls.has("putchar") || calls.has("stdout"),
    rd: calls.has("read_file") || calls.has("read_file_bytes"),
    wr: calls.has("write_file") || calls.has("write_file_bytes"),
    env: calls.has("env") || calls.has("environ") || calls.has("config_get"),
    args: calls.has("args"),
    rnd: calls.has("random_bytes") || calls.has("random_i32") || calls.has("__map_hash_seed"),
    clkw: calls.has("now_unix_ms") || calls.has("now_ns"),
    clkm: calls.has("monotonic_ns"),
    clkres: calls.has("clock_resolution"),
    ep: calls.has("eprint") || calls.has("stderr") || census,
    ex: calls.has("exit"),
    net: calls_any(calls, socket_builtins()),
    fs: calls_any(calls, fs_builtins()),
    wait: calls_any(calls, wait_builtins()),
  };
}

function calls_any(calls: util.NameIndex, names: string[]): boolean {
  for name in names {
    if (calls.has(name)) {
      return true;
    }
  }
  return false;
}

function stdin_builtins(): string[] {
  return ["stdin"];
}

function fs_builtins(): string[] {
  return [
    "open_reader", "open_writer", "open_appender", "open_exclusive", "open_reader_with", "open_writer_with",
    "stdin", "stat", "lstat", "read_dir", "read_dir_bytes", "read_dir_all", "read_dir_ino", "read_dir_ino_all", "create_dir", "create_dir_all", "remove_file",
    "remove_dir", "remove_dir_all", "rename", "read_link", "read_link_bytes", "create_symlink", "create_link", "truncate",
    "set_file_times", "temp_dir",
  ];
}

function socket_builtins(): string[] {
  return [
    "tcp_accept", "tcp_accept_with", "tcp_close", "__tcp_close_unchecked", "__fd_close", "tcp_connect_with", "tcp_listen", "tcp_listen_with",
    "tcp_local_port", "tcp_pollable", "tcp_recv_into", "tcp_send_bytes", "tcp_send_buf", "tcp_sendfile", "tcp_socket_ctl", "tcp_addr_into",
    "udp_bind", "udp_bind_with", "udp_connect", "udp_recvfrom", "udp_sendto", "udp_sendto_bytes", "udp_sendmmsg", "udp_recvmmsg",
  ];
}

function wait_builtins(): string[] {
  return [
    "sleep_ms", "sleep_ns", "poll", "wasm_poll", "wasm_timer_pollable", "wasm_block", "wasm_pollable_drop",
    "reactor_new", "reactor_ctl", "reactor_wait",
  ];
}

pub function lowered_shape(mod: parser.Module, sw: asmcore.Switches, bodies: irtables.LowerResult[]): i32 {
  if (needs_abort(runtime_needs(mod, needs_of(bodies)))) {
    return -1;
  }
  let shape = component_shape(mod, sw);
  if (shape >= 0 && !host_needs(mod, census_on(sw)).ex && module_emits_op_cached(bodies, "exit")) {
    return -1;
  }
  return shape;
}

pub function component_needs_host(mod: parser.Module, sw: asmcore.Switches): boolean {
  let n = host_needs(mod, census_on(sw));
  return n.io || n.rd || n.wr || n.env || n.args || n.rnd || n.clkw || n.clkm || n.clkres || n.ep || n.ex || n.net || n.fs || n.wait;
}

pub function component_shape(mod: parser.Module, sw: asmcore.Switches): i32 {
  let n = host_needs(mod, census_on(sw));
  let io = n.io;
  let rd = n.rd;
  let wr = n.wr;
  let env = n.env;
  let args = n.args;
  let rnd = n.rnd;
  let clkw = n.clkw;
  let clkm = n.clkm;
  let ep = n.ep;
  let ex = n.ex;
  if (n.net || n.fs || n.wait || n.clkres) {
    return -1;
  }
  let cats = 0;
  if (rd || wr) {
    cats += 1;
  }
  if (env) {
    cats += 1;
  }
  if (args) {
    cats += 1;
  }
  if (rnd) {
    cats += 1;
  }
  if (clkw || clkm) {
    cats += 1;
  }
  if (ep) {
    cats += 1;
  }
  if (ex) {
    cats += 1;
  }
  if (cats > 2) {
    return -1;
  }
  if (cats == 0) {
    if (io) {
      return 1;
    }
    return 0;
  }
  if (cats == 2) {
    if (ep && ex) {
      return 17;
    }
    if ((rd || wr) && env) {
      if (rd && wr) {
        return 11;
      }
      if (rd) {
        return 10;
      }
      return -1;
    }
    if ((rd || wr) && args) {
      if (rd && wr) {
        return 16;
      }
      if (rd) {
        return 15;
      }
      return -1;
    }
    if (rnd && wr && !rd) {
      return 12;
    }
    return -1;
  }
  if (rd || wr) {
    if (rd && wr) {
      return 4;
    }
    if (wr) {
      return 3;
    }
    return 2;
  }
  if (rnd) {
    return 5;
  }
  if (env) {
    return 6;
  }
  if (args) {
    return 7;
  }
  if (clkw || clkm) {
    if (clkw && clkm) {
      return -1;
    }
    if (clkm) {
      return 9;
    }
    return 8;
  }
  if (ep) {
    return 13;
  }
  if (ex) {
    return 14;
  }
  return -1;
}

function emit_wasm_i32_to_f64(o: ir.Op, parts: string[]): string[] {
  if (o.width == 64) {
    if (o.unsigned) {
      parts = parts.append("    f64.convert_i64_u\n");
    } else {
      parts = parts.append("    f64.convert_i64_s\n");
    }
  } else if (o.unsigned) {
    parts = parts.append("    f64.convert_i32_u\n");
  } else {
    parts = parts.append("    f64.convert_i32_s\n");
  }

  return parts;
}

function emit_wasm_fround(f64tmp: i32, parts: string[]): string[] {
  let lx = "    local.get " + util.i32_to_string(f64tmp) + "\n";
  parts = parts.append("    local.set " + util.i32_to_string(f64tmp) + "\n");
  parts = parts.append(lx);
  parts = parts.append(lx + "    f64.trunc\n");
  parts = parts.append("    f64.sub\n    f64.abs\n");
  parts = parts.append("    f64.const 0.5\n    f64.ge\n");
  parts = parts.append("    if (result f64)\n");
  parts = parts.append(lx + "    f64.trunc\n");
  parts = parts.append("    f64.const 1.0\n" + lx + "    f64.copysign\n");
  parts = parts.append("    f64.add\n");
  parts = parts.append("    else\n");
  parts = parts.append(lx + "    f64.trunc\n");
  parts = parts.append("    end\n");

  return parts;
}

// On WASI each of these ops drops its operand and gives 0.
function drops_to_zero(k: i32): boolean {
  return k == ir.K_ISATTY || k == ir.K_SIGNAL_IGNORE || k == ir.K_SIGNAL_DEFAULT || k == ir.K_SIGNAL_CATCH
    || k == ir.K_SIGNAL_CATCH_INTERRUPTING || k == ir.K_SIGNAL_TAKEN || k == ir.K_CT_MARK || k == ir.K_SIGNAL_DISPOSITION;
}

function emit_wasm_signal_raise(parts: string[]): string[] {
  parts = parts.append("    drop\n    i32.const -58\n");

  return parts;
}

function emit_wasm_signal_mask(parts: string[]): string[] {
  parts = parts.append("    drop\n    drop\n    i64.const 0\n");

  return parts;
}

function emit_wasm_hostname(bctmp: i32, parts: string[]): string[] {
  parts = parts.append("    i32.const 4\n    call $__fern_str_box\n    local.tee " + util.i32_to_string(bctmp) + "\n    i32.const 0\n    i32.store\n    local.get " + util.i32_to_string(bctmp) + "\n");
  return parts;
}

function emit_wasm_wasm_timer_pollable(parts: string[]): string[] {
  parts = parts.append("    call $__fern_wasi_subscribe_duration\n");

  return parts;
}

function emit_wasm_wasm_block(parts: string[]): string[] {
  parts = parts.append("    call $__fern_wasi_pollable_block\n");
  parts = parts.append("    i32.const 0\n");

  return parts;
}

function emit_wasm_wasm_poll(parts: string[]): string[] {
  parts = parts.append("    call $__fern_wasm_poll\n");

  return parts;
}

function emit_wasm_temp_dir(parts: string[]): string[] {
  parts = parts.append("    call $__fern_temp_dir\n");

  return parts;
}

function emit_wasm_heap_bump_bytes(parts: string[]): string[] {
  return parts.append("    global.get $heap\n    global.get $__fern_heap_base\n    i32.sub\n    i64.extend_i32_u\n");
}

function empty_bytes_const(): string {
  return ir.op_const_bytes("").str;
}

function emit_wasm_alloc_u8(caggs: Placed, ns: string, arrtmp: i32, eltmp: i32, o: ir.Op, parts: string[]): string[] {
  let stride = 4;
  if (ir.is_packed(o)) {
    stride = 1;
  } else if (o.width == 64) {
    stride = 8;
  }
  let n = "    local.get " + util.i32_to_string(eltmp) + "\n";
  let bytes = n;
  if (stride != 1) {
    bytes = n + "    i32.const " + util.i32_to_string(stride) + "\n    i32.mul\n";
  }
  parts = parts.append("    local.set " + util.i32_to_string(eltmp) + "\n");
  parts = parts.append(n + "    i32.eqz\n    if (result i32)\n");
  parts = emit_wasm_const_struct(caggs, ns, ir.op_const_bytes(""), parts);
  parts = parts.append("    else\n");
  parts = parts.append(n + "    i32.const " + util.i32_to_string(stride) + "\n    call $__fern_arr_elems\n    local.set " + util.i32_to_string(arrtmp) + "\n");
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n" + n + "    i32.store\n");
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const 4\n    i32.add\n" + n + "    i32.store\n");
  if (o.kind_tag != ir.K_ALLOC_UNINIT) {
    parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const 8\n    i32.add\n    i32.const 0\n" + bytes + "    memory.fill\n");
  }
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    end\n");

  return parts;
}

function emit_wasm_raw_store_ptr(arrtmp: i32, eltmp: i32, parts: string[]): string[] {
  parts = parts.append("    local.set " + util.i32_to_string(eltmp) + "\n");
  parts = parts.append("    local.set " + util.i32_to_string(arrtmp) + "\n");
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const 4\n    i32.mul\n    i32.add\n");
  parts = parts.append("    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n");
  parts = parts.append("    local.get " + util.i32_to_string(eltmp) + "\n");

  return parts;
}

function emit_wasm_arr_make(arrtmp: i32, eltmp: i32, f64tmp: i32, i64tmp: i32, o: ir.Op, parts: string[]): string[] {
  let n = o.i32_imm;
  let esz = 4;
  if (o.width == 64) {
    esz = 8;
  } else if (ir.is_packed(o)) {
    esz = 1;
  }
  let cap = n;
  let bytes = n * esz;
  if (n == 0) {
    cap = 4;
    bytes = 32;
  }
  parts = parts.append("    i32.const " + util.i32_to_string(bytes) + "\n    call $__fern_arr_box\n    local.set " + util.i32_to_string(arrtmp) + "\n");
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(n) + "\n    i32.store\n");
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const 4\n    i32.add\n    i32.const " + util.i32_to_string(cap) + "\n    i32.store\n");
  let em = n - 1;
  while (em >= 0) {
    if (o.width == 64 && o.unsigned) {
      parts = parts.append("    local.set " + util.i32_to_string(i64tmp) + "\n");
      parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(8 + em * 8) + "\n    i32.add\n    local.get " + util.i32_to_string(i64tmp) + "\n    i64.store\n");
    } else if (o.width == 64) {
      parts = parts.append("    local.set " + util.i32_to_string(f64tmp) + "\n");
      parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(8 + em * 8) + "\n    i32.add\n    local.get " + util.i32_to_string(f64tmp) + "\n    f64.store\n");
    } else if (ir.is_packed(o)) {
      parts = parts.append("    local.set " + util.i32_to_string(eltmp) + "\n");
      parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(8 + em) + "\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store8\n");
    } else {
      parts = parts.append("    local.set " + util.i32_to_string(eltmp) + "\n");
      parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(8 + em * 4) + "\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n");
    }
    em -= 1;
  }
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n");

  return parts;
}

function emit_wasm_arr_get(arrtmp: i32, bctmp: i32, o: ir.Op, parts: string[]): string[] {
  parts = parts.append("    local.set " + util.i32_to_string(bctmp) + "\n");
  if (o.i32_imm == 2) {
    parts = parts.append(wasm_arr_index_trap(arrtmp, bctmp, "arr"));
    if (o.width == 64 && o.unsigned) {
      return parts.append("    i64.const 0\n");
    }
    if (o.width == 64) {
      return parts.append("    f64.const 0\n");
    }
    return parts.append("    i32.const 0\n");
  }
  if (o.i32_imm == 1) {
    parts = parts.append("    local.get " + util.i32_to_string(bctmp) + "\n");
  } else {
    parts = parts.append(wasm_arr_bounds_check(arrtmp, bctmp, "arr"));
  }
  if (o.width == 64 && o.unsigned) {
    parts = parts.append("    i32.const 8\n    i32.mul\n    i32.const 8\n    i32.add\n    i32.add\n    i64.load\n");
  } else if (o.width == 64) {
    parts = parts.append("    i32.const 8\n    i32.mul\n    i32.const 8\n    i32.add\n    i32.add\n    f64.load\n");
  } else if (ir.is_packed(o)) {
    parts = parts.append("    i32.const 8\n    i32.add\n    i32.add\n    i32.load8_u\n");
  } else {
    parts = parts.append("    i32.const 4\n    i32.mul\n    i32.const 8\n    i32.add\n    i32.add\n    i32.load\n");
  }

  return parts;
}

function emit_wasm_str_index(arrtmp: i32, bctmp: i32, check: boolean, parts: string[]): string[] {
  parts = parts.append("    local.set " + util.i32_to_string(bctmp) + "\n");
  if (check) {
    return parts.append(wasm_arr_index_trap(arrtmp, bctmp, "str")).append("    i32.const 0\n");
  }
  parts = parts.append(wasm_arr_bounds_check(arrtmp, bctmp, "str"));
  parts = parts.append("    i32.const 4\n    i32.add\n    i32.add\n    i32.load8_u\n");
  return parts;
}

function emit_wasm_arr_set(arrtmp: i32, bctmp: i32, eltmp: i32, f64tmp: i32, i64tmp: i32, o: ir.Op, parts: string[]): string[] {
  if (o.width == 64 && o.unsigned) {
    parts = parts.append("    local.set " + util.i32_to_string(i64tmp) + "\n");
    parts = parts.append("    local.set " + util.i32_to_string(bctmp) + "\n");
    parts = parts.append(wasm_arr_bounds_check(arrtmp, bctmp, "arr"));
    parts = parts.append("    i32.const 8\n    i32.mul\n    i32.const 8\n    i32.add\n    i32.add\n    local.get " + util.i32_to_string(i64tmp) + "\n    i64.store\n");
  } else if (o.width == 64) {
    parts = parts.append("    local.set " + util.i32_to_string(f64tmp) + "\n");
    parts = parts.append("    local.set " + util.i32_to_string(bctmp) + "\n");
    parts = parts.append(wasm_arr_bounds_check(arrtmp, bctmp, "arr"));
    parts = parts.append("    i32.const 8\n    i32.mul\n    i32.const 8\n    i32.add\n    i32.add\n    local.get " + util.i32_to_string(f64tmp) + "\n    f64.store\n");
  } else if (ir.is_packed(o)) {
    parts = parts.append("    local.set " + util.i32_to_string(eltmp) + "\n");
    parts = parts.append("    local.set " + util.i32_to_string(bctmp) + "\n");
    parts = parts.append(wasm_arr_bounds_check(arrtmp, bctmp, "arr"));
    parts = parts.append("    i32.const 8\n    i32.add\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store8\n");
  } else {
    parts = parts.append("    local.set " + util.i32_to_string(eltmp) + "\n");
    parts = parts.append("    local.set " + util.i32_to_string(bctmp) + "\n");
    parts = parts.append(wasm_arr_bounds_check(arrtmp, bctmp, "arr"));
    parts = parts.append("    i32.const 4\n    i32.mul\n    i32.const 8\n    i32.add\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n");
  }

  return parts;
}

function emit_wasm_putchar(eltmp: i32, parts: string[]): string[] {
  parts = parts.append("    local.set " + util.i32_to_string(eltmp) + "\n");
  parts = parts.append("    i32.const 16\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store8\n");
  parts = parts.append("    i32.const 0\n    i32.const 16\n    i32.store\n");
  parts = parts.append("    i32.const 4\n    i32.const 1\n    i32.store\n");
  parts = parts.append("    i32.const 1\n    i32.const 0\n    i32.const 1\n    i32.const 8\n    call $__fern_fd_write\n    drop\n");
  parts = parts.append("    i32.const 0\n");

  return parts;
}

function fn_slot_push(cx: WasmOpCtx, name: string): string {
  return "    global.get " + fn_base_global(cx.ns) + "\n    i32.const " + util.i32_to_string(util.index_of_str(cx.fn_table, name) - fn_table_base()) + "\n    i32.add\n";
}

function emit_wasm_struct_make(arrtmp: i32, eltmp: i32, f64tmp: i32, i64tmp: i32, o: ir.Op, structs: irtables.StructTab, parts: string[]): string[] {
  let nf = o.i32_imm;
  parts = parts.append("    i32.const " + util.i32_to_string(8 + nf * 8) + "\n    call $__fern_str_box\n    local.set " + util.i32_to_string(arrtmp) + "\n");
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n" + tid_get(o.str) + "    i32.store\n");
  let em = nf - 1;
  while (em >= 0) {
    let emoff = 8 + em * 8;
    let emft = irtables.decl_at_field_type(structs, o.decl, em);
    if (parser.is_wide_int_type_name(emft)) {
      parts = parts.append("    local.set " + util.i32_to_string(i64tmp) + "\n");
      parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(emoff) + "\n    i32.add\n    local.get " + util.i32_to_string(i64tmp) + "\n    i64.store\n");
    } else if (emft == "f64" || emft == "f32") {
      parts = parts.append("    local.set " + util.i32_to_string(f64tmp) + "\n");
      parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(emoff) + "\n    i32.add\n    local.get " + util.i32_to_string(f64tmp) + "\n    f64.store\n");
    } else {
      parts = parts.append("    local.set " + util.i32_to_string(eltmp) + "\n");
      parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(emoff) + "\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n");
    }
    em -= 1;
  }
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n");

  return parts;
}

function emit_wasm_const_struct(caggs: Placed, ns: string, o: ir.Op, parts: string[]): string[] {
  parts = parts.append("    global.get " + cagg_base_global(ns) + "\n    i32.const "
    + util.i32_to_string(caggs.offset_of(o.str, "aggregate constant") + 8) + "\n    i32.add\n");

  return parts;
}

function emit_wasm_struct_get(o: ir.Op, parts: string[]): string[] {
  parts = parts.append("    i32.const " + util.i32_to_string(8 + o.i32_imm * 8) + "\n    i32.add\n");
  if (o.width == 64 && o.unsigned) {
    parts = parts.append("    i64.load\n");
  } else if (o.width == 64) {
    parts = parts.append("    f64.load\n");
  } else {
    parts = parts.append("    i32.load\n");
  }

  return parts;
}

function emit_wasm_struct_set(eltmp: i32, f64tmp: i32, i64tmp: i32, o: ir.Op, parts: string[]): string[] {
  let soff = 8 + o.i32_imm * 8;
  if (o.width == 64 && o.unsigned) {
    parts = parts.append("    local.set " + util.i32_to_string(i64tmp) + "\n    i32.const " + util.i32_to_string(soff) + "\n    i32.add\n    local.get " + util.i32_to_string(i64tmp) + "\n    i64.store\n");
  } else if (o.width == 64) {
    parts = parts.append("    local.set " + util.i32_to_string(f64tmp) + "\n    i32.const " + util.i32_to_string(soff) + "\n    i32.add\n    local.get " + util.i32_to_string(f64tmp) + "\n    f64.store\n");
  } else {
    parts = parts.append("    local.set " + util.i32_to_string(eltmp) + "\n    i32.const " + util.i32_to_string(soff) + "\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n");
  }

  return parts;
}

function emit_wasm_tuple_set(eltmp: i32, f64tmp: i32, i64tmp: i32, o: ir.Op, parts: string[]): string[] {
  let toff = o.i32_imm * 8;
  if (o.width == 64 && o.unsigned) {
    parts = parts.append("    local.set " + util.i32_to_string(i64tmp) + "\n    i32.const " + util.i32_to_string(toff) + "\n    i32.add\n    local.get " + util.i32_to_string(i64tmp) + "\n    i64.store\n");
  } else if (o.width == 64) {
    parts = parts.append("    local.set " + util.i32_to_string(f64tmp) + "\n    i32.const " + util.i32_to_string(toff) + "\n    i32.add\n    local.get " + util.i32_to_string(f64tmp) + "\n    f64.store\n");
  } else {
    parts = parts.append("    local.set " + util.i32_to_string(eltmp) + "\n    i32.const " + util.i32_to_string(toff) + "\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n");
  }

  return parts;
}

function emit_wasm_tuple_make(arrtmp: i32, eltmp: i32, f64tmp: i32, i64tmp: i32, o: ir.Op, parts: string[]): string[] {
  let tn = o.i32_imm;
  parts = parts.append("    i32.const " + util.i32_to_string(tn * 8) + "\n    call $__fern_str_box\n    local.set " + util.i32_to_string(arrtmp) + "\n");
  let tem = tn - 1;
  while (tem >= 0) {
    let tk = irtables.csv_nth(o.str, tem);
    if (tk == "i64") {
      parts = parts.append("    local.set " + util.i32_to_string(i64tmp) + "\n");
      parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(tem * 8) + "\n    i32.add\n    local.get " + util.i32_to_string(i64tmp) + "\n    i64.store\n");
    } else if (parser.is_float_type_name(tk)) {
      parts = parts.append("    local.set " + util.i32_to_string(f64tmp) + "\n");
      parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(tem * 8) + "\n    i32.add\n    local.get " + util.i32_to_string(f64tmp) + "\n    f64.store\n");
    } else {
      parts = parts.append("    local.set " + util.i32_to_string(eltmp) + "\n");
      parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(tem * 8) + "\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n");
    }
    tem -= 1;
  }
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n");

  return parts;
}

function emit_wasm_call_direct(parts: string[]): string[] {
  parts = parts.append("    call $__fern_rc_inc\n");

  return parts;
}

function emit_wasm_dyn_box(arrtmp: i32, eltmp: i32, f64tmp: i32, i64tmp: i32, o: ir.Op, parts: string[]): string[] {
  let vt = dyn_prim_valtype(o.str);
  let tmp = eltmp;
  if (vt == "i64") {
    tmp = i64tmp;
  }
  if (vt == "f64") {
    tmp = f64tmp;
  }
  parts = parts.append("    local.set " + util.i32_to_string(tmp) + "\n");
  parts = parts.append("    i32.const 16\n    call $__fern_str_box\n    local.set " + util.i32_to_string(arrtmp) + "\n");
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n" + tid_get(o.str) + "    i32.store\n");
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const 8\n    i32.add\n    local.get " + util.i32_to_string(tmp) + "\n    " + vt + ".store\n");
  parts = parts.append("    local.get " + util.i32_to_string(arrtmp) + "\n");

  return parts;
}

function dyn_prim_valtype(name: string): string {
  if (name == "i64" || name == "u64") {
    return "i64";
  }
  if (name == "f64" || name == "f32") {
    return "f64";
  }
  return "i32";
}

function emit_wasm_call_indirect(o: ir.Op, parts: string[]): string[] {
  parts = parts.append("    call_indirect (type " + fn_type_name(o) + ")\n");

  return parts;
}
