    parts = parts.append(xps);
    if (lc) {
      parts = parts.append("  (func $__fern_main_reporting (result i32) (local $r i32)\n    (local.set $r " + main_result_wat(mod) + ")\n    (call $__fern_lc_report)\n    (local.get $r))\n");
      parts = parts.append("  (func $__fern_start (call $__fern_proc_exit_raw " + low_byte_wat("(call $__fern_main_reporting)") + "))\n");
      parts = parts.append("  (export \"main\" (func $__fern_main_reporting))\n");
    } else {
      parts = parts.append("  (func $__fern_start (call $__fern_proc_exit " + low_byte_wat(main_result_wat(mod)) + "))\n");
      parts = parts.append("  (export \"main\" (func $main))\n");
