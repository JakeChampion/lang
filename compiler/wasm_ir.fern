pub function tcp_local_port_func(udp: boolean): string {
  let o = "";
  o += "  (func $__fern_tcp_local_port (param $c i32) (result i32)\n";
  o += "    (local $ret i32) (local $result i32)\n";
  o += closed_socket_guard("c");
  o += "    (local.set $ret (call $__fern_alloc (i32.const 36)))\n";
  if (udp) {
    o += "    (if (i32.lt_u (i32.sub (i32.load offset=12 (local.get $c)) (i32.const 2)) (i32.const 2))\n";
    o += "      (then (call $__fern_wasi_udp_local_address (i32.load (local.get $c)) (local.get $ret)))\n";
    o += "      (else (call $__fern_wasi_tcp_local_address (i32.load (local.get $c)) (local.get $ret))))\n";
  } else {
    o += "    (call $__fern_wasi_tcp_local_address (i32.load (local.get $c)) (local.get $ret))\n";
  }
  o += "    (if (i32.load8_u (local.get $ret)) (then\n";
  o += "      (local.set $result (i32.sub (i32.const 0) (call $__fern_wasi_socket_errno (i32.load8_u offset=4 (local.get $ret))))))\n";
  o += "    (else (local.set $result (i32.load16_u offset=8 (local.get $ret)))))\n";
  o += "    (call $__fern_raw_free (local.get $ret) (i32.const 36))\n";
  o += "    (local.get $result))\n";
  return o;
}

pub function tcp_pollable_func(has_udp: boolean): string {
  let o = "";
  o += "  (func $__fern_tcp_pollable (param $c i32) (result i32)\n";
  o += closed_socket_guard("c");
  o += "    (if (i32.eq (i32.load offset=12 (local.get $c)) (i32.const 1)) (then\n";
  o += "      (return (call $__fern_wasi_input_stream_subscribe (i32.load offset=4 (local.get $c))))))\n";
  if (has_udp) {
    o += "    (if (i32.eq (i32.load offset=12 (local.get $c)) (i32.const 3)) (then\n";
    o += "      (return (call $__fern_wasi_udp_in_subscribe (i32.load offset=4 (local.get $c))))))\n";
  }
  o += "    (if (i32.or (i32.eq (i32.load offset=12 (local.get $c)) (i32.const 0)) (i32.eq (i32.load offset=12 (local.get $c)) (i32.const 4))) (then\n";
  o += "      (return (call $__fern_wasi_tcp_subscribe (i32.load (local.get $c))))))\n";
  o += "    (i32.const -1))\n";
  return o;
}

