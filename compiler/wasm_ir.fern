function read_dir_func_like(fname: string, skip_dots: boolean, ino: boolean): string {
  let o: string = "";
  let tid_param: string = "";
  if (ino) {
    tid_param = " (param $tid i32)";
  }
  o = o + "  (func $" + fname + " (param $path i32)" + tid_param + " (result i32)\n";
  o = o + "    (local $err i32) (local $fd i32) (local $arr i32) (local $buf i32) (local $ent i32)\n";
