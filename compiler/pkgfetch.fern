import "std/crypto";
import "std/hex";
import "core/error";
import "std/fetch";
import "std/http";
import "./fern";
import "./modloader";
import "./pkgarchive";
import "./util";

const MAX_ARCHIVE: i32 = 67108864;

pub function fetch(url: string, hash: string): fern.Fetched {
  let (raw, derr) = download(url);
  if (derr.len() > 0) {
    return failed(derr);
  }
  let got = "sha256:" + hex.encode(crypto.sha256_new().update(raw).finish());
  if (hash.len() > 0 && got != hash) {
    return failed("fetch " + url + ": hash mismatch — manifest declares " + hash + ", server sent " + got + "; refusing to unpack");
  }
  let dir = "";
  match (modloader.store_dir(got)) {
    Some(d) => {
      dir = slice_unchecked(d, 0, d.len() - 1) + "";
    },
    None => {
      return failed("fetch " + url + ": no cache directory for the package store: set FERN_CACHE_DIR, XDG_CACHE_HOME or HOME");
    }
  }
  if (util.is_dir(dir)) {
    return fern.Fetched { hash: got, dir: dir, err: "" };
  }
  let uerr = pkgarchive.unpack_into(dir, raw);
  if (uerr.len() > 0) {
    return failed("fetch " + url + ": " + uerr);
  }
  return fern.Fetched { hash: got, dir: dir, err: "" };
}

function failed(err: string): fern.Fetched {
  return fern.Fetched { hash: "", dir: "", err: err };
}

function download(url: string): (u8[], string) {
  let limits = http.HttpLimits { ...http.limits(), body: MAX_ARCHIVE };
  let req = fetch.get(url).with_header("Accept-Encoding", "identity").with_limits(limits);
  match (fetch.send(req)) {
    Ok(resp) => {
      if (resp.status != 200) {
        return ([], "fetch " + url + ": HTTP " + util.i32_to_string(resp.status));
      }
      return (resp.body_bytes(), "");
    },
    Err(e) => {
      return ([], "fetch " + url + ": " + e.message());
    }
  }
}
