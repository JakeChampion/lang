import "./aborts";
import "./util";

pub function texts(): string[] {
  return [aborts.arr_oob() + "\n", aborts.str_oob() + "\n", aborts.slice_range() + "\n", aborts.alloc_size() + "\n", aborts.oom() + "\n"];
}

pub function helpers(offsets: i32[], mode: i32): string {
  let names: string[] = ["arr", "str", "slice", "alloc", "oom"];
  let messages: string[] = texts();
  let out: string = "";
  let i: i32 = 0;
  while (i < names.len()) {
    out = out + "  (func $__fern_abort_" + names[i] + "\n";
    if (i < offsets.len()) {
      let ptr: string = util.i32_to_string(offsets[i] + 4);
      let len: string = util.i32_to_string(messages[i].len());
      if (mode == 0) {
        out = out + "    (i32.store (i32.const 0) (i32.const " + ptr + "))\n";
        out = out + "    (i32.store (i32.const 4) (i32.const " + len + "))\n";
        out = out + "    (drop (call $__fern_fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
      } else {
        out = out + "    (call $__fern_bwf (call $__fern_get_stderr) (i32.const " + ptr + ") (i32.const " + len + ") (i32.const 0))\n";
      }
    }
    out = out + "    (unreachable))\n";
    i = i + 1;
  }
  return out;
}
