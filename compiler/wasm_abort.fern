import "./aborts";
import "./util";

pub function texts(): string[] {
  return [aborts.arr_oob() + "\n", aborts.str_oob() + "\n", aborts.slice_range() + "\n", aborts.alloc_size() + "\n", aborts.oom() + "\n", aborts.free_range() + "\n", aborts.double_free() + "\n"];
}

pub function helpers(offsets: i32[], mode: i32): string {
  let names: string[] = ["arr", "str", "slice", "alloc", "oom", "free_range", "double_free"];
  let messages = texts();
  let out = "";
  for i in 0..names.len() {
    out = out + "  (func $__fern_abort_" + names[i] + "\n";
    if (i < offsets.len()) {
      let ptr = util.i32_to_string(offsets[i] + 4);
      let len = util.i32_to_string(messages[i].len());
      if (mode == 0) {
        out = out + "    (i32.store (i32.const 0) (i32.const " + ptr + "))\n";
        out = out + "    (i32.store (i32.const 4) (i32.const " + len + "))\n";
        out += "    (drop (call $__fern_fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
      } else {
        out = out + "    (call $__fern_bwf (call $__fern_get_stderr) (i32.const " + ptr + ") (i32.const " + len + ") (i32.const 0))\n";
      }
    }
    out += "    (unreachable))\n";
  }
  return out;
}
