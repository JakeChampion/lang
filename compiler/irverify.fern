import "./ir";
import "./util";

pub struct Problem {
  fn_name: string,
  op: i32,
  kind: string,
  msg: string,
}

pub function problem_str(p: Problem): string {
  if (p.op < 0) {
    return p.fn_name + ": " + p.msg;
  }
  return p.fn_name + ": op " + util.i32_to_string(p.op) + " (" + p.kind + "): " + p.msg;
}

pub function format_problems(ps: Problem[], max: i32): string {
  let out = "";
  for i in 0..ps.len() {
    if (i == max) {
      return out + "\n    ... and " + util.i32_to_string(ps.len() - max) + " more";
    }
    out = out + "\n    " + problem_str(ps[i]);
  }
  return out;
}

pub struct FnSig { name: string, n_params: i32 }

pub struct NameIndex {
  head: i32[],
  next: i32[],
  names: string[],
  params: i32[],
}

function name_index_buckets(): i32 {
  return 1021;
}

function chain_names(names: string[], params: i32[]): NameIndex {
  let nb = name_index_buckets();
  let head = util.minus_ones(nb);
  let next = util.minus_ones(names.len());
  let k = names.len() - 1;
  while (k >= 0) {
    let bk = util.hash_bucket(names[k], nb);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    k -= 1;
  }
  return NameIndex { head: head, next: next, names: names, params: params };
}

pub function index_row(ix: NameIndex, name: string): i32 {
  let i = ix.head[util.hash_bucket(name, ix.head.len())];
  while (i >= 0) {
    if (ix.names[i] == name) {
      return i;
    }
    i = ix.next[i];
  }
  return -1;
}

pub function name_index(names: string[]): NameIndex {
  let params: i32[] = [];
  for i in 0..names.len() {
    params = params.append(-1);
  }
  return chain_names(names, params);
}

pub function sig_index(sigs: FnSig[]): NameIndex {
  let names: string[] = [];
  let params: i32[] = [];
  for i in 0..sigs.len() {
    names = names.append(sigs[i].name);
    params = params.append(sigs[i].n_params);
  }
  return chain_names(names, params);
}

pub function index_has(ix: NameIndex, name: string): boolean {
  return index_row(ix, name) >= 0;
}

pub function index_params(ix: NameIndex, name: string): i32 {
  let r = index_row(ix, name);
  if (r < 0) {
    return -1;
  }
  return ix.params[r];
}

function elem_width_kind(kt: i32): boolean {
  return kt == ir.K_ARR_MAKE || kt == ir.K_ARR_GET || kt == ir.K_ARR_SET || kt == ir.K_ARR_SLICE
    || kt == ir.K_ARR_RESERVE || kt == ir.K_ALLOC_U8;
}

// The element widths that the backends read. Each other width is read as a word.
// An alloc_u8 also gives 0 for the default and 1 for a boolean, both words.
pub function elem_width_ok(kt: i32, w: i32): boolean {
  if (w == 8 || w == 16 || w == 32 || w == 64 || w == ir.width_ptr()) {
    return true;
  }
  return kt == ir.K_ALLOC_U8 && (w == 0 || w == 1);
}

function bit_count_kind(kt: i32): boolean {
  return kt == ir.K_CLZ || kt == ir.K_CTZ || kt == ir.K_POPCOUNT || kt == ir.K_BSWAP;
}

// The widths of a conversion that the backends read. An int_extend and an
// int_wrap of the pointer width are no-ops on a 64-bit target. An i32_to_f64
// reads 64 as an i64 source and 0 or 32 as an i32 source. An f64_to_i64 reads
// the pointer width as the pointer type. Each other conversion has no width.
function conv_width_refusal(kt: i32, w: i32): string {
  let p = ir.width_ptr();
  if (kt == ir.K_INT_EXTEND) {
    return if (w == 64 || w == p) { "" } else { "64 or the pointer width" };
  }
  if (kt == ir.K_INT_WRAP || kt == ir.K_F64_TO_I64) {
    return if (w == 0 || w == p) { "" } else { "0 or the pointer width" };
  }
  if (kt == ir.K_I32_TO_F64) {
    return if (w == 0 || w == 32 || w == 64 || w == p) { "" } else { "0, 32, 64 or the pointer width" };
  }
  if (kt == ir.K_F64_TO_I32 || kt == ir.K_INT_CAST || kt == ir.K_U32_WRAP) {
    return if (w == 0) { "" } else { "0" };
  }
  return "";
}

// The widths of a memory access that the backends read. A `load` is lowered
// only as the 16-bit load. The native backends read an MMIO width other than
// 8, 16 or 32 as 64 bits, and wasm reads it as 32 bits. Each load or store of
// a fixed size has no width.
function mem_width_refusal(kt: i32, w: i32): string {
  if (kt == ir.K_LOAD) {
    return if (w == 16) { "" } else { "16" };
  }
  if (kt == ir.K_MMIO_LOAD || kt == ir.K_MMIO_STORE) {
    return if (w == 8 || w == 16 || w == 32 || w == 64) { "" } else { "8, 16, 32 or 64" };
  }
  if (kt >= ir.K_LOAD_I32 && kt <= ir.K_STORE_PTR || kt == ir.K_STORE_I64 || kt >= ir.K_RAW_STORE8 && kt <= ir.K_RAW_LOAD_PTR) {
    return if (w == 0) { "" } else { "0" };
  }
  return "";
}

// The widths of a lane op that the backends read. A float lane op reads 32
// as f32x4 and each other width as f64x2. An unpacked group access scales its
// index by the width on x86-64 and wasm, and by 4 or 8 on arm64, so it also
// has only 32 and 64. A bitwise op and a group access of packed bytes read
// no width. The integer lane ops have 8, 16 and 32.
function lane_widths(kt: i32, packed: boolean): i32[] {
  if (kt == ir.K_VPACK) {
    return [32];
  }
  if (kt == ir.K_VLOAD_F32) {
    return [64];
  }
  if (kt >= ir.K_VAND && kt <= ir.K_VSELECT || (kt == ir.K_VGET || kt == ir.K_VSET) && packed) {
    return [8, 16, 32, 64];
  }
  if (ir.is_lane_int_kind(kt)) {
    return [8, 16, 32];
  }
  if (kt >= ir.K_VIWIDENLOS && kt <= ir.K_VIWIDENHIU) {
    return [8, 16];
  }
  if (kt == ir.K_VINARROWS || kt == ir.K_VINARROWU) {
    return [16, 32];
  }
  if (kt == ir.K_VISWIZZLE) {
    return [8];
  }
  return [32, 64];
}

function lane_width_refusal(kt: i32, w: i32, packed: boolean): string {
  let ws = lane_widths(kt, packed);
  let text = "";
  for i in 0..ws.len() {
    if (ws[i] == w) {
      return "";
    }
    let sep = if (i == 0) { "" } else if (i == ws.len() - 1) { " or " } else { ", " };
    text = text + sep + util.i32_to_string(ws[i]);
  }
  return text;
}

// A lane op that names a lane must name one of the 128 / width lanes. A
// permute mode of 4 to 7 moves 32-bit lanes.
function lane_index_refusal(kt: i32, w: i32, imm: i32): string {
  if (kt == ir.K_VPERMUTE) {
    let top = if (w == 32) { 8 } else { 4 };
    return if (imm >= 0 && imm < top) { "" } else { "permute mode " + util.i32_to_string(imm) + " is not 0 to " + util.i32_to_string(top - 1) };
  }
  let names = kt == ir.K_VEXTRACT || kt == ir.K_VREPLACE || kt == ir.K_VEXTRACT_BITS || kt == ir.K_VIEXTRACTS || kt == ir.K_VIEXTRACTU || kt == ir.K_VIREPLACE;
  if (!names || w <= 0 || imm >= 0 && imm < 128 / w) {
    return "";
  }
  return "lane " + util.i32_to_string(imm) + " is outside the " + util.i32_to_string(128 / w) + " lanes of width " + util.i32_to_string(w);
}

// The backends read an integer arithmetic or compare op as 64 bits, as the
// pointer width, or else as 32 bits. Only 0 and 32 name the 32-bit form.
// The backends have a bit-count op only for 32 and 64 bits.
// The result is the widths that the op can have, or "" when `w` is one of them.
function width_refusal(kt: i32, w: i32): string {
  if (kt >= ir.K_INT_EXTEND && kt <= ir.K_F64_TO_I64) {
    return conv_width_refusal(kt, w);
  }
  let mem = mem_width_refusal(kt, w);
  if (mem != "") {
    return mem;
  }
  if (bit_count_kind(kt)) {
    return if (w == 32 || w == 64) { "" } else { "32 or 64" };
  }
  if (kt >= ir.K_ADD && kt <= ir.K_GE_U || kt == ir.K_MULHI_U || kt == ir.K_MULHI_S) {
    return if (w == 0 || w == 32 || w == 64 || w == ir.width_ptr()) { "" } else { "0, 32, 64 or the pointer width" };
  }
  return "";
}

pub function verify_fn(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, sigs: NameIndex): Problem[] {
  let out: Problem[] = [];

  let k_load = ir.K_LOAD_LOCAL;
  let k_store = ir.K_STORE_LOCAL;
  let k_tee = ir.K_TEE_LOCAL;
  let k_block = ir.K_BLOCK;
  let k_loop = ir.K_LOOP;
  let k_if = ir.K_IF;
  let k_else = ir.K_ELSE;
  let k_end = ir.K_END;
  let k_br = ir.K_BR;
  let k_brif = ir.K_BRIF;
  let k_calld = ir.K_CALL_DIRECT;
  let k_calli = ir.K_CALL_INDIRECT;
  let k_callc = ir.K_CALL_CLOSURE_DIRECT;

  let st_kind: i32[] = [];
  let st_at: i32[] = [];
  let st_else: i32[] = [];
  let depth = 0;

  for i in 0..ops.len() {
    let op = ops[i];
    let kt = op.kind_tag;

    if (elem_width_kind(kt) && !elem_width_ok(kt, op.width)) {
      out = out.append(Problem {
        fn_name: fn_name, op: i, kind: ir.kind_name(kt),
        msg: "element width " + util.i32_to_string(op.width)
          + " is not 8, 16, 32, 64 or the pointer width",
      });
    }
    let widths = width_refusal(kt, op.width);
    if (widths != "") {
      out = out.append(Problem {
        fn_name: fn_name, op: i, kind: ir.kind_name(kt),
        msg: "width " + util.i32_to_string(op.width) + " is not " + widths,
      });
    }
    if (ir.is_lane_kind(kt)) {
      let lw = lane_width_refusal(kt, op.width, op.unsigned);
      let li = if (lw == "") { lane_index_refusal(kt, op.width, op.i32_imm) } else { "" };
      if (lw != "" || li != "") {
        out = out.append(Problem {
          fn_name: fn_name, op: i, kind: ir.kind_name(kt),
          msg: if (lw != "") { "lane width " + util.i32_to_string(op.width) + " is not " + lw } else { li },
        });
      }
    }

    if (kt == k_load || kt == k_store || kt == k_tee) {
      if (op.i32_imm < 0 || op.i32_imm >= n_locals) {
        out = out.append(Problem {
          fn_name: fn_name, op: i, kind: ir.kind_name(kt),
          msg: "local index " + util.i32_to_string(op.i32_imm)
            + " is outside the frame (" + util.i32_to_string(n_params)
            + " params + " + util.i32_to_string(n_locals - n_params)
            + " locals = " + util.i32_to_string(n_locals) + " slots)",
        });
      }
    } else if (kt == k_block || kt == k_loop || kt == k_if) {
      if (depth < st_kind.len()) {
        st_kind = st_kind.with(depth, kt);
        st_at = st_at.with(depth, i);
        st_else = st_else.with(depth, -1);
      } else {
        st_kind = st_kind.append(kt);
        st_at = st_at.append(i);
        st_else = st_else.append(-1);
      }
      depth += 1;
    } else if (kt == k_else) {
      if (depth == 0) {
        out = out.append(Problem { fn_name: fn_name, op: i, kind: "else", msg: "else with no open scope" });
      } else if (st_kind[depth - 1] != k_if) {
        out = out.append(Problem {
          fn_name: fn_name, op: i, kind: "else",
          msg: "else closes a " + ir.kind_name(st_kind[depth - 1])
            + " opened at op " + util.i32_to_string(st_at[depth - 1]) + ", not an if",
        });
      } else if (st_else[depth - 1] >= 0) {
        out = out.append(Problem {
          fn_name: fn_name, op: i, kind: "else",
          msg: "second else for the if opened at op " + util.i32_to_string(st_at[depth - 1])
            + " (first at op " + util.i32_to_string(st_else[depth - 1]) + ")",
        });
      } else {
        st_else = st_else.with(depth - 1, i);
      }
    } else if (kt == k_end) {
      if (depth == 0) {
        out = out.append(Problem { fn_name: fn_name, op: i, kind: "end", msg: "end with no open scope" });
      } else {
        depth -= 1;
      }
    } else if (kt == k_br || kt == k_brif) {
      if (op.i32_imm < 0 || op.i32_imm > depth) {
        out = out.append(Problem {
          fn_name: fn_name, op: i, kind: ir.kind_name(kt),
          msg: "branch depth " + util.i32_to_string(op.i32_imm)
            + " has no target - only " + util.i32_to_string(depth) + " scopes are open",
        });
      }
    } else if (kt == k_calld) {
      if (op.i32_imm < 0) {
        out = out.append(Problem {
          fn_name: fn_name, op: i, kind: "call_direct",
          msg: "negative argument count " + util.i32_to_string(op.i32_imm),
        });
      } else if (op.str.len() == 0) {
        out = out.append(Problem { fn_name: fn_name, op: i, kind: "call_direct", msg: "call with no callee name" });
      } else {
        let np = index_params(sigs, op.str);
        if (np >= 0 && op.i32_imm != np) {
          out = out.append(Problem {
            fn_name: fn_name, op: i, kind: "call_direct",
            msg: "calls " + op.str + " with " + util.i32_to_string(op.i32_imm)
              + " args, but it declares " + util.i32_to_string(np) + " parameters",
          });
        }
      }
    } else if (kt == k_calli || kt == k_callc) {
      if (op.i32_imm < 0) {
        out = out.append(Problem {
          fn_name: fn_name, op: i, kind: ir.kind_name(kt),
          msg: "negative argument count " + util.i32_to_string(op.i32_imm),
        });
      }
    }
  }

  for d in 0..depth {
    out = out.append(Problem {
      fn_name: fn_name, op: st_at[d], kind: ir.kind_name(st_kind[d]),
      msg: "scope is never closed - the function ends with it still open",
    });
  }
  return out;
}
