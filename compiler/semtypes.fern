import "./typeinfo";
import "std/string";

pub function equal(a: typeinfo.Type, b: typeinfo.Type): boolean {
  match (a) {
    typeinfo.TypeArray(x) => {
      if let typeinfo.TypeArray(y) = b {
        return x.view == y.view && equal(x.elem, y.elem);
      }
    },
    typeinfo.TypeTuple(x) => {
      if let typeinfo.TypeTuple(y) = b {
        return equal_list(x.elements, y.elements);
      }
    },
    typeinfo.TypeMap(x) => {
      if let typeinfo.TypeMap(y) = b {
        return equal(x.key, y.key) && equal(x.value, y.value);
      }
    },
    typeinfo.TypeErased(x) => {
      if let typeinfo.TypeErased(y) = b {
        return x.name == y.name;
      }
    },
    typeinfo.TypeStruct(x) => {
      if let typeinfo.TypeStruct(y) = b {
        return named_args_equal(x.name, x.args, y.name, y.args);
      }
    },
    typeinfo.TypeUnion(x) => {
      if let typeinfo.TypeUnion(y) = b {
        return named_args_equal(x.name, x.args, y.name, y.args);
      }
    },
    typeinfo.TypeFunc(x) => {
      if let typeinfo.TypeFunc(y) = b {
        return callable_equal(x, y);
      }
    },
    typeinfo.TypeDyn(x) => {
      if let typeinfo.TypeDyn(y) = b {
        return x.traits == y.traits;
      }
    },
    typeinfo.TypeHandle(x) => {
      if let typeinfo.TypeHandle(y) = b {
        return x.resource == y.resource && x.borrowed == y.borrowed;
      }
    },
    typeinfo.TypeI32(x) => {
      if let typeinfo.TypeI32(y) = b {
        return x.width == y.width && x.unsigned == y.unsigned && x.is_char == y.is_char && x.polymorphic == y.polymorphic;
      }
    },
    typeinfo.TypeFloat(x) => {
      if let typeinfo.TypeFloat(y) = b {
        return x.width == y.width && x.polymorphic == y.polymorphic;
      }
    },
    typeinfo.TypeLanes(x) => {
      if let typeinfo.TypeLanes(y) = b {
        return x.width == y.width && x.kind == y.kind;
      }
    },
    typeinfo.TypeNever(_) => {
      return is_never(b);
    },
    typeinfo.TypeBool(_) => {
      if let typeinfo.TypeBool(_) = b {
        return true;
      }
    },
    typeinfo.TypeString(x) => {
      if let typeinfo.TypeString(y) = b {
        return x.tag == y.tag;
      }
    },
    typeinfo.TypeVoid(_) => {
      if let typeinfo.TypeVoid(_) = b {
        return true;
      }
    },
    typeinfo.TypeConst(x) => {
      if let typeinfo.TypeConst(y) = b {
        return x.value == y.value;
      }
    },
    typeinfo.TypeUnknown(_) => {}
  }
  return false;
}

pub function lends_array(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = from {
    if let typeinfo.TypeArray(b) = to {
      return !a.view && b.view && equal(a.elem, b.elem);
    }
  }
  return false;
}

pub function is_never(t: typeinfo.Type): boolean {
  if let typeinfo.TypeNever(_) = t {
    return true;
  }
  return false;
}

function named_args_equal(a: string, aa: typeinfo.Type[], b: string, ba: typeinfo.Type[]): boolean {
  return a == b && equal_list(aa, ba);
}

pub function erased(t: typeinfo.Type): boolean {
  if let typeinfo.TypeErased(_) = t {
    return true;
  }
  return false;
}

pub function shaped(t: typeinfo.Type, allow_void: boolean): boolean {
  return erased(t) || shaped_container(t) || shaped_named(t) || concrete(t, allow_void);
}

function shaped_container(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return shaped(a.elem, false);
  }
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements.len() >= 2 && shaped_list(tup.elements);
  }
  if let typeinfo.TypeMap(m) = t {
    return shaped(m.key, false) && shaped(m.value, false);
  }
  return false;
}

function shaped_named(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFunc(f) = t {
    return f.params_known && shaped_list(f.param_types) && shaped(f.ret_type, true);
  }
  if let typeinfo.TypeStruct(s) = t {
    return s.name.len() > 0 && shaped_list(s.args);
  }
  if let typeinfo.TypeUnion(u) = t {
    return u.name.len() > 0 && shaped_payloads(u.args);
  }
  return false;
}

function shaped_list(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (!shaped(t, false)) {
      return false;
    }
  }
  return true;
}

function shaped_payloads(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (!shaped(t, true)) {
      return false;
    }
  }
  return true;
}

function own_masks_equal(a: typeinfo.TypeFunc, b: typeinfo.TypeFunc): boolean {
  for i in 0..a.param_types.len() {
    if (typeinfo.fn_own_at(a, i) != typeinfo.fn_own_at(b, i)) {
      return false;
    }
  }
  return true;
}

function callable_equal(a: typeinfo.TypeFunc, b: typeinfo.TypeFunc): boolean {
  return a.ret_own == b.ret_own && a.params_known == b.params_known && equal_list(a.param_types, b.param_types)
    && own_masks_equal(a, b) && equal(a.ret_type, b.ret_type);
}

function equal_list(a: typeinfo.Type[], b: typeinfo.Type[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for i in 0..a.len() {
    if (!equal(a[i], b[i])) {
      return false;
    }
  }
  return true;
}

pub function concrete(t: typeinfo.Type, allow_void: boolean): boolean {
  match (t) {
    typeinfo.TypeI32(i) => {
      return concrete_integer(i);
    },
    typeinfo.TypeFloat(f) => {
      return !f.polymorphic && (f.width == 32 || f.width == 64);
    },
    typeinfo.TypeLanes(l) => {
      return l.width == 32 || l.width == 64;
    },
    typeinfo.TypeBool(_) => {
      return true;
    },
    typeinfo.TypeString(st) => {
      return st.tag == 0 || st.tag == 1;
    },
    typeinfo.TypeDyn(d) => {
      return d.traits.len() > 0;
    },
    typeinfo.TypeHandle(h) => {
      return h.resource.len() > 0;
    },
    typeinfo.TypeVoid(_) => {
      return allow_void;
    },
    typeinfo.TypeConst(c) => {
      return c.value.len() > 0;
    },
    typeinfo.TypeArray(a) => {
      return is_never(a.elem) || concrete(a.elem, false);
    },
    typeinfo.TypeTuple(tup) => {
      return tup.elements.len() >= 2 && concrete_payloads(tup.elements);
    },
    typeinfo.TypeMap(m) => {
      return (is_never(m.key) || concrete(m.key, false)) && (is_never(m.value) || concrete(m.value, false));
    },
    typeinfo.TypeStruct(st) => {
      return concrete_struct(st);
    },
    typeinfo.TypeUnion(u) => {
      return concrete_union(u);
    },
    typeinfo.TypeFunc(f) => {
      return f.params_known && concrete_list(f.param_types) && concrete(f.ret_type, true);
    },
    _ => {
      return false;
    }
  }
}

// concrete_scalar is true for a concrete i32, float or bool type.
pub function concrete_scalar(t: typeinfo.Type): boolean {
  if (!concrete(t, false)) {
    return false;
  }
  if let typeinfo.TypeI32(_) = t {
    return true;
  }
  if let typeinfo.TypeFloat(_) = t {
    return true;
  }
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  return false;
}

function concrete_integer(i: typeinfo.TypeI32): boolean {
  if (i.polymorphic) {
    return false;
  }
  if (i.is_char) {
    return i.width == 32 && !i.unsigned;
  }
  return i.width == 32 || i.width == 64 || i.width == 8 && i.unsigned || i.width == typeinfo.width_ptr() && i.unsigned;
}

pub function env_prefix(): string {
  return "__env$";
}

pub function is_env(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(s) = t {
    return prefixed(s.name, env_prefix());
  }
  return false;
}

pub function env_captures(t: typeinfo.Type): typeinfo.Type[] {
  if let typeinfo.TypeStruct(s) = t {
    return s.args;
  }
  return [];
}

pub function env_body(t: typeinfo.Type): string {
  if let typeinfo.TypeStruct(s) = t {
    return slice_unchecked(s.name, env_prefix().len(), s.name.len()).to_owned();
  }
  return "";
}

function prefixed(name: string, prefix: string): boolean {
  let n = prefix.len();
  if (name.len() <= n) {
    return false;
  }
  for i in 0..n {
    if (name[i] != prefix[i]) {
      return false;
    }
  }
  return true;
}

pub function cell_elem(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeStruct(s) = t {
    if (s.args.len() == 1) {
      return s.args[0];
    }
  }
  return typeinfo.unchecked();
}

pub function is_handle(t: typeinfo.Type): boolean {
  return is_resource_handle(t) || is_fd_handle(t);
}

pub function is_resource_handle(t: typeinfo.Type): boolean {
  if let typeinfo.TypeHandle(_) = t {
    return true;
  }
  return false;
}

// The built-in types that own a descriptor. Only the call that opens one
// makes it, and its close consumes it.
pub function is_fd_handle_name(name: string): boolean {
  return name == "Reader" || name == "Writer" || name == "Dir" || name == "Socket";
}

pub function is_socket(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(s) = t {
    return s.name == "Socket";
  }
  return false;
}

pub function is_fd_handle(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(s) = t {
    return is_fd_handle_name(s.name);
  }
  return false;
}

function concrete_struct(s: typeinfo.TypeStruct): boolean {
  if (s.name == "Cell") {
    return s.args.len() == 1 && concrete(s.args[0], false);
  }
  return s.name.len() > 0 && concrete_list(s.args);
}

function concrete_union(u: typeinfo.TypeUnion): boolean {
  if (u.name.len() == 0) {
    return false;
  }
  if (u.name == "Option" && u.args.len() != 1) {
    return false;
  }
  if (u.name == "Result" && u.args.len() != 2) {
    return false;
  }
  return concrete_payloads(u.args);
}

function concrete_list(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (!concrete(t, true)) {
      return false;
    }
  }
  return true;
}

function concrete_payloads(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (!is_never(t) && !concrete(t, true)) {
      return false;
    }
  }
  return true;
}

pub function needs_anchor(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(_) = t {
    return false;
  }
  if let typeinfo.TypeBool(_) = t {
    return false;
  }
  if let typeinfo.TypeFloat(_) = t {
    return false;
  }
  if let typeinfo.TypeLanes(_) = t {
    return false;
  }
  if let typeinfo.TypeVoid(_) = t {
    return false;
  }
  if (is_handle(t)) {
    return false;
  }
  return true;
}
