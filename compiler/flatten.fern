import "./ast";
import "./util";
import "./lexer";
import "./parser";
import "./decltypes";
import "./astwalk";
import "./platforms";
import "./builtinsigs";
import "./caps";
import "std/string";

pub struct ImportedEnum { name: string, prefix: string }

pub struct RewriteCtx { modnames: string[], modprefixes: string[], prefix: string, declnames: string[], declnames_mangled: string[], dn_head: i32[], dn_next: i32[], locals: string[], enumnames: string[], imported_enums: ImportedEnum[], ivar_names: string[], ivar_mangled: string[], variant_scope: string[], reexport_keys: string[], reexport_targets: string[], type_params: string[], own_variants: string[] }

function imported_enum_prefix(name: string, ctx: RewriteCtx): string {
  for en in ctx.imported_enums {
    if (en.name == name) {
      return en.prefix;
    }
  }
  return "";
}

function imported_enums(imports: LoadedModule[], pfxs: string[]): ImportedEnum[] {
  let out: ImportedEnum[] = [];
  for i in 0..imports.len() {
    for en in imports[i].mod.enums {
      out = out.append(ImportedEnum { name: pfxs[i] + "__" + en.name, prefix: pfxs[i] });
    }
  }
  return out;
}

function declname_buckets(n: i32): i32 {
  if (n < 8) {
    return 8;
  }
  return n * 2 + 1;
}

function build_declname_head(names: string[]): i32[] {
  let nb = declname_buckets(names.len());
  let head = util.minus_ones(nb);
  let i = names.len() - 1;
  while (i >= 0) {
    let k = util.hash_bucket(names[i], nb);
    head = head.with(k, i);
    i -= 1;
  }
  return head;
}

function build_declname_next(names: string[]): i32[] {
  let nb = declname_buckets(names.len());
  let seen = util.minus_ones(nb);
  let next = util.minus_ones(names.len());
  let i = names.len() - 1;
  while (i >= 0) {
    let k = util.hash_bucket(names[i], nb);
    next = next.with(i, seen[k]);
    seen = seen.with(k, i);
    i -= 1;
  }
  return next;
}

function declname_index_of(name: string, ctx: RewriteCtx): i32 {
  if (ctx.dn_head.len() == 0) {
    return -1;
  }
  let i = ctx.dn_head[util.hash_bucket(name, ctx.dn_head.len())];
  while (i >= 0) {
    if (ctx.declnames[i] == name) {
      return i;
    }
    i = ctx.dn_next[i];
  }
  return -1;
}

pub function is_runtime_helper_name(name: string): boolean {
  if (name.starts_with("__primitive_")) {
    return true;
  }
  if (name == "map_new_impl") {
    return true;
  }
  if (name.len() >= 6 && name.starts_with("__map_")) {
    return true;
  }
  return false;
}

pub function mangled_name(prefix: string, name: string): string {
  if (is_runtime_helper_name(name)) {
    return name;
  }
  return prefix + "__" + name;
}

function build_mangled_names(prefix: string, names: string[]): string[] {
  let out: string[] = [];
  for i in 0..names.len() {
    out = out.append(mangled_name(prefix, names[i]));
  }
  return out;
}

function resolve_prefix(qualifier: string, ctx: RewriteCtx): string {
  for i in 0..ctx.modnames.len() {
    if (ctx.modnames[i] == qualifier) {
      if (i < ctx.modprefixes.len()) {
        return ctx.modprefixes[i];
      }
      return qualifier;
    }
  }
  return qualifier;
}

function lookup_reexport(mangled: string, ctx: RewriteCtx): string {
  return decltypes.follow_reexports(mangled, ctx.reexport_keys, ctx.reexport_targets);
}

struct IvarMatch { mangled: string, ambiguous: boolean }

function match_ivar(name: string, ctx: RewriteCtx): IvarMatch {
  let first = "";
  for i in 0..ctx.ivar_names.len() {
    if (ctx.ivar_names[i] == name && ivar_visible(ctx.ivar_mangled[i], name, ctx)) {
      if (first.len() > 0) {
        return IvarMatch { mangled: first, ambiguous: true };
      }
      first = ctx.ivar_mangled[i];
    }
  }
  return IvarMatch { mangled: first, ambiguous: first.len() > 0 && parser.builtin_enum_of(name).len() > 0 };
}

function ivar_visible(mangled: string, name: string, ctx: RewriteCtx): boolean {
  return util.has_str(ctx.variant_scope, slice_unchecked(mangled, 0, mangled.len() - name.len() - 2).to_owned());
}

struct ImportGraph { starts: i32[], edges: i32[] }

function import_graph(imports: LoadedModule[], ids: string[], pfxs: string[]): ImportGraph {
  let starts: i32[] = [];
  let edges: i32[] = [];
  for k in 0..imports.len() {
    starts = starts.append(edges.len());
    for p in import_prefixes(imports[k].mod, ids, pfxs) {
      edges = edges.append(util.index_of_str(pfxs, p));
    }
  }
  starts = starts.append(edges.len());
  return ImportGraph { starts: starts, edges: edges };
}

function importers_of(target: i32, imports: LoadedModule[], g: ImportGraph, pfxs: string[], entry: parser.Module): string[] {
  let out: string[] = [];
  let std = is_stdlib_ident(imports[target].ident);
  for k in 0..imports.len() {
    let direct = false;
    let e = g.starts[k];
    while (e < g.starts[k + 1]) {
      if (g.edges[e] == target) {
        direct = true;
      }
      e += 1;
    }
    if (k != target && (direct || std && is_stdlib_ident(imports[k].ident))) {
      out = out.append(pfxs[k]);
    }
  }
  if (util.index_of_str(import_prefixes(entry, module_ids(imports), pfxs), pfxs[target]) >= 0) {
    out = out.append("");
  }
  return out;
}

function is_stdlib_ident(ident: string): boolean {
  return ident.starts_with("std/") || ident.starts_with("core/") || util.index_of_sub(ident, "/std/") >= 0 || util.index_of_sub(ident, "/core/") >= 0;
}

pub function import_cycle(entry: parser.Module, entry_ident: string, imports: LoadedModule[], root: string): Option[parser.Import] {
  let ids = module_ids(imports);
  let pfxs = assign_prefixes(imports);
  let w = CycleWalk { g: import_graph(imports, ids, pfxs), ids: ids, entry: entry_ident, root: root };
  let state: i32[] = [];
  while (state.len() < imports.len()) {
    state = state.append(0);
  }
  for p in import_prefixes(entry, ids, pfxs) {
    let t = util.index_of_str(pfxs, p);
    if (t >= 0 && state[t] == 0) {
      let (k, e, st) = cycle_from(t, w, state);
      if (k >= 0) {
        return Some(imports[k].mod.imports[e - w.g.starts[k]]);
      }
      state = st;
    }
  }
  return None;
}

struct CycleWalk { g: ImportGraph, ids: string[], entry: string, root: string }

function cycle_from(k: i32, w: CycleWalk, state: i32[]): (i32, i32, i32[]) {
  let st = state.with(k, 1);
  let e = w.g.starts[k];
  while (e < w.g.starts[k + 1]) {
    let t = w.g.edges[e];
    if (t >= 0 && (st[t] == 1 || w.ids[t] == w.entry) && !under_root(w.ids[t], w.root)) {
      return (k, e, st);
    }
    if (t >= 0 && st[t] == 0) {
      let (fk, fe, st2) = cycle_from(t, w, st);
      if (fk >= 0) {
        return (fk, fe, st2);
      }
      st = st2;
    }
    e += 1;
  }
  return (-1, -1, st.with(k, 2));
}

pub function under_root(ident: string, root: string): boolean {
  return root.len() > 0 && ident.len() > root.len() && ident.starts_with(root) && ident[root.len()] == b'/';
}

function variant_scope(mod: parser.Module, g: ImportGraph, ids: string[], pfxs: string[]): string[] {
  return prefixes_at(import_closure(mod, g, ids, pfxs), pfxs);
}

function prefixes_at(ks: i32[], pfxs: string[]): string[] {
  let out: string[] = [];
  for k in ks {
    out = out.append(pfxs[k]);
  }
  return out;
}

function import_closure(mod: parser.Module, g: ImportGraph, ids: string[], pfxs: string[]): i32[] {
  let seen: boolean[] = [];
  while (seen.len() < pfxs.len()) {
    seen = seen.append(false);
  }
  let queue: i32[] = [];
  for p in import_prefixes(mod, ids, pfxs) {
    let d = util.index_of_str(pfxs, p);
    if (d >= 0 && !seen[d]) {
      seen = seen.with(d, true);
      queue = queue.append(d);
    }
  }
  let qi = 0;
  while (qi < queue.len()) {
    let e = g.starts[queue[qi]];
    while (e < g.starts[queue[qi] + 1]) {
      let t = g.edges[e];
      if (t >= 0 && !seen[t]) {
        seen = seen.with(t, true);
        queue = queue.append(t);
      }
      e += 1;
    }
    qi += 1;
  }
  return queue;
}

function enum_viewers(closures: i32[][], entry_closure: i32[], pfxs: string[]): string[][] {
  let none: string[] = [];
  let out: string[][] = [];
  while (out.len() < pfxs.len()) {
    out = out.append(none);
  }
  for k in 0..closures.len() {
    for t in closures[k] {
      if (t != k) {
        out = out.with(t, out[t].append(pfxs[k]));
      }
    }
  }
  for t in entry_closure {
    out = out.with(t, out[t].append(""));
  }
  return out;
}

function module_sights(entry: parser.Module, imports: LoadedModule[], g: ImportGraph, ids: string[], pfxs: string[], rx: ReexportTable): parser.ModuleSight[] {
  let out: parser.ModuleSight[] = [];
  for i in 0..imports.len() {
    let reaches = prefixes_at(import_closure(imports[i].mod, g, ids, pfxs), pfxs);
    out = out.append(parser.ModuleSight { module: pfxs[i], imports: parser.import_paths(imports[i].mod), qualifiers: mod_names(imports[i].mod), direct: import_prefixes(imports[i].mod, ids, pfxs), reaches: reaches, reexport_keys: rx.keys, reexport_targets: rx.targets, package: "" });
  }
  return out.append(parser.ModuleSight { module: "", imports: parser.import_paths(entry), qualifiers: mod_names(entry), direct: import_prefixes(entry, ids, pfxs), reaches: prefixes_at(import_closure(entry, g, ids, pfxs), pfxs), reexport_keys: rx.keys, reexport_targets: rx.targets, package: "" });
}

function with_enum_viewers(mod: parser.Module, viewers: string[]): parser.Module {
  let enums: parser.EnumDecl[] = [];
  for ed in mod.enums {
    enums = enums.append(parser.EnumDecl { ...ed, visible_from: viewers });
  }
  return parser.Module { ...mod, enums: enums };
}

function is_in(name: string, list: string[]): boolean {
  for i in 0..list.len() {
    if (list[i] == name) {
      return true;
    }
  }
  return false;
}

// The parser's range desugar qualifies its call with the import path
// `parser.RANGE_MODULE`, so that path resolves like the import's own name.
function range_import_at(mod: parser.Module): i32 {
  for i in 0..mod.imports.len() {
    if (mod.imports[i].path == parser.RANGE_MODULE) {
      return i;
    }
  }
  return -1;
}

function path_aliased_names(mod: parser.Module, names: string[]): string[] {
  if (range_import_at(mod) < 0) {
    return names;
  }
  return names.append(parser.RANGE_MODULE);
}

function path_aliased_prefixes(mod: parser.Module, prefixes: string[]): string[] {
  let at = range_import_at(mod);
  if (at < 0 || at >= prefixes.len()) {
    return prefixes;
  }
  return prefixes.append(prefixes[at]);
}

pub function mod_names(mod: parser.Module): string[] {
  let out: string[] = [];
  for i in 0..mod.imports.len() {
    if (mod.imports[i].alias.len() > 0) {
      out = out.append(mod.imports[i].alias);
    } else {
      out = out.append(util.import_qualifier(mod.imports[i].path));
    }
  }
  return out;
}

pub function module_ident(mpath: string): string {
  if (mpath.len() > 5) {
    if (mpath.ends_with(".fern")) {
      return slice_unchecked(mpath, 0, mpath.len() - 5).to_owned();
    }
  }
  return mpath;
}

pub function resolve_imports(mod: parser.Module, dir: string, root: string): parser.Module {
  let d = dir;
  if (d.len() > 1 && d[d.len() - 1] == b'/') {
    d = slice_unchecked(d, 0, d.len() - 1).to_owned();
  }
  let out: parser.Import[] = [];
  for i in 0..mod.imports.len() {
    let r = module_ident(util.resolve_path(mod.imports[i].path, d, root));
    out = out.append(parser.Import { ...mod.imports[i], resolved: r });
  }
  return parser.Module { ...mod, imports: out };
}

pub function handler_serve_diags(entry: parser.Module, target: string): util.Diag[] {
  if (top_fn_index(entry, "main") >= 0 || platforms.for_target(target).environment == "wasi-http") {
    return [];
  }
  let hi = top_fn_index(entry, "handle");
  if (hi < 0 || parser.std_qualifier(entry, "serve").len() > 0 || top_fn_index(entry, "serve__config") >= 0) {
    return [];
  }
  return [util.Diag { code: "E001", message: "a top-level `handle` requires `std/serve`: add `import \"std/serve\";`", line: entry.funcs[hi].line, col: entry.funcs[hi].col, length: 0, related: [], fix: None }];
}

pub function with_handler_main(entry: parser.Module, target: string): parser.Module {
  if (handler_serve_diags(entry, target).len() > 0) {
    return entry;
  }
  if (top_fn_index(entry, "main") >= 0) {
    return entry;
  }
  if (platforms.for_target(target).environment == "wasi-http") {
    return entry;
  }
  let hi = top_fn_index(entry, "handle");
  if (hi < 0) {
    return entry;
  }
  let ii = top_fn_index(entry, "init");
  let init_kind = 0;
  let init_args: ast.Expr[] = [];
  let qual = parser.std_qualifier(entry, "serve");
  if (ii >= 0) {
    init_kind = parser.init_return_kind(entry.funcs[ii].ret_type, qual);
    if (entry.funcs[ii].params.len() > 1) {
      return entry;
    }
    if (entry.funcs[ii].params.len() == 1) {
      if (!parser.is_platform_param(entry.funcs[ii], 0, parser.std_qualifier(entry, "platform"))) {
        return entry;
      }
      let plat: ast.Expr = ast.ExprCall { callee: serve_ref(qual, "__init_platform"), args: [], line: 0, col: 0, type_args: [], ty: "" };
      init_args = [plat];
    }
  }
  let returns_state = init_kind == 1 || init_kind == 3;
  let takes_state = entry.funcs[hi].params.len() == 3;
  if (returns_state != takes_state) {
    return entry;
  }
  let si = top_fn_index(entry, "shutdown");
  if (si >= 0 && entry.funcs[si].params.len() != 1 + util.bool_i32(takes_state)) {
    return entry;
  }
  let port: ast.Expr = ast.ExprCall { callee: serve_ref(qual, "__port_from_env"), args: [ast.ExprString { value: "PORT", line: 0, col: 0 }, ast.ExprNumber { text: "8080", suffix: "", raw: "", is_float: false, bits: 0, line: 0, col: 0 }], line: 0, col: 0, type_args: [], ty: "" };
  let handle: ast.Expr = ast.ExprIdent { name: "handle", line: 0, col: 0, ty: "", builtin: false };
  let init_call: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "init", line: 0, col: 0, ty: "", builtin: false }, args: init_args, line: 0, col: 0, type_args: [], ty: "" };
  let hook: ast.Expr = ast.ExprIdent { name: "shutdown", line: 0, col: 0, ty: "", builtin: false };
  let body: ast.Stmt[] = [];
  let opts: ast.Expr = ast.ExprCall { callee: serve_ref(qual, "config"), args: [], line: 0, col: 0, type_args: [], ty: "" };
  let state: ast.Expr = init_call;
  if (init_kind == 3) {
    body = body.append(ast.StmtVar { name: "__fern_opts,__fern_state", type_name: "", init: init_call, line: 0, col: 0, fn_ret: "", fn_param_types: "" });
    opts = ast.ExprIdent { name: "__fern_opts", line: 0, col: 0, ty: "", builtin: false };
    state = ast.ExprIdent { name: "__fern_state", line: 0, col: 0, ty: "", builtin: false };
  } else if (init_kind == 2) {
    opts = init_call;
  } else if (ii >= 0 && init_kind == 0) {
    body = body.append(ast.StmtExpr { value: init_call, line: 0, op: "" });
  }
  let supervised = target.len() == 0 || platforms.has_capability(target, "proc");
  let entry_name = "run";
  if (supervised) {
    entry_name = "supervise";
  }
  let args: ast.Expr[] = [port, opts, handle];
  if (takes_state) {
    entry_name += "_with";
    args = [port, opts, state, handle];
  }
  if (si >= 0) {
    entry_name += "_shutdown";
    args = args.append(hook);
  }
  let serve: ast.Expr = ast.ExprCall { callee: serve_ref(qual, entry_name), args: args, line: 0, col: 0, type_args: [], ty: "" };
  let status: ast.Expr = ast.ExprCall { callee: serve_ref(qual, "exit_code"), args: [serve], line: 0, col: 0, type_args: [], ty: "" };
  body = body.append(ast.StmtReturn { value: status, line: 0, col: 0 });
  let main: parser.FuncDecl = parser.FuncDecl {
    bound_modules: [], is_unsafe: false,
    stdlib: "", no_inline: false, always_inline: false,
    name: "main", receiver_name: "", receiver_type: "", receiver_own: false, type_params: [],
    params: [], ret_own: false, ret_type: "i32", body: body, line: 0, col: 0,
    import_iface: "", import_wit: "", import_weak: false, all_type_params: [],
    bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false,
    is_const: false, is_pub: true, is_package: false, ret_fn_ret: "", ret_fn_param_types: "", module: "", impl_trait: "", dyn_traits: [], streams: [],
  };
  return parser.Module { ...entry, funcs: entry.funcs.append(main) };
}

function top_fn_index(mod: parser.Module, name: string): i32 {
  for i in 0..mod.funcs.len() {
    if (mod.funcs[i].name == name && mod.funcs[i].receiver_type.len() == 0) {
      return i;
    }
  }
  return -1;
}

pub function with_result_handler(entry: parser.Module, error_pfx: string, http_pfx: string): parser.Module {
  let hi = top_fn_index(entry, "handle");
  if (hi < 0) {
    return entry;
  }
  let handle = entry.funcs[hi];
  let ret = "";
  let with_state = "";
  let result = "";
  if (handle.params.len() == 2 && result_of_response(handle.ret_type)) {
    ret = "HttpResponse";
    result = handle.ret_type;
  } else if (handle.params.len() == 3) {
    let (state, second) = tuple_halves(handle.ret_type);
    if (state.len() > 0 && result_of_response(second)) {
      ret = "(" + state + ", HttpResponse)";
      with_state = "_with";
      result = second;
    }
  }
  if (ret.len() == 0) {
    return entry;
  }
  let args: ast.Expr[] = [];
  for p in handle.params {
    args = args.append(ast.ExprIdent { name: p.name, line: 0, col: 0, ty: "", builtin: false });
  }
  let inner: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "__fern_handle_result", line: 0, col: 0, ty: "", builtin: false }, args: args, line: 0, col: 0, type_args: [], ty: "" };
  let adapter = "respond" + with_state;
  let adapter_args: ast.Expr[] = [inner];
  if (result_err_is_dyn_error(error_pfx, result)) {
    adapter = "respond_error" + with_state;
    adapter_args = adapter_args.append(ast.ExprIdent { name: handle.params[handle.params.len() - 1].name, line: 0, col: 0, ty: "", builtin: false });
  }
  if (http_pfx.len() > 0) {
    adapter = mangled_name(http_pfx, adapter);
  }
  let call: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: adapter, line: 0, col: 0, ty: "", builtin: false }, args: adapter_args, line: 0, col: 0, type_args: [], ty: "" };
  let wrapper = parser.FuncDecl { ...handle, name: "handle", ret_type: ret, body: [ast.StmtReturn { value: call, line: 0, col: 0 }], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, ret_fn_ret: "", ret_fn_param_types: "" };
  let funcs: parser.FuncDecl[] = [];
  for i in 0..entry.funcs.len() {
    if (i == hi) {
      funcs = funcs.append(parser.FuncDecl { ...handle, name: "__fern_handle_result" });
    } else {
      funcs = funcs.append(entry.funcs[i]);
    }
  }
  return parser.Module { ...entry, funcs: funcs.append(wrapper) };
}

function result_err_is_dyn_error(error_pfx: string, result: string): boolean {
  if (error_pfx.len() == 0) {
    return false;
  }
  return parser.strip_type_spaces(result) == "Result[HttpResponse,dyn" + error_pfx + ".Error]";
}

function loaded_prefix(imports: LoadedModule[], pfxs: string[], path: string): string {
  for i in 0..imports.len() {
    let hit = imports[i].name == util.module_name(path);
    if (imports[i].ident.len() > 0) {
      hit = path_is(imports[i].ident, path);
    }
    if (hit) {
      return pfxs[i];
    }
  }
  return "";
}

function path_is(p: string, want: string): boolean {
  return p == want || p.len() > want.len() + 1 && p.ends_with(want) && p[p.len() - want.len() - 1] == b'/';
}

function result_of_response(t: string): boolean {
  let s = parser.strip_type_spaces(t);
  return s.len() > 20 && s.starts_with("Result[HttpResponse,");
}

function tuple_halves(t: string): (string, string) {
  let s = parser.strip_type_spaces(t);
  if (s.len() < 4 || s[0] != b'(' || s[s.len() - 1] != b')') {
    return ("", "");
  }
  let depth = 0;
  for i in 1..s.len() - 1 {
    let ch = s[i];
    if (ch == b'[' || ch == b'(') {
      depth += 1;
    }
    if (ch == b']' || ch == b')') {
      depth -= 1;
    }
    if (ch == b',' && depth == 0) {
      return (slice_unchecked(s, 1, i).to_owned(), slice_unchecked(s, i + 1, s.len() - 1).to_owned());
    }
  }
  return ("", "");
}

function serve_ref(qual: string, name: string): ast.Expr {
  if (qual.len() == 0) {
    return ast.ExprIdent { name: name, line: 0, col: 0, ty: "", builtin: false };
  }
  return ast.ExprFieldAccess { obj: ast.ExprIdent { name: qual, line: 0, col: 0, ty: "", builtin: false }, field: name, line: 0, col: 0, ty: "", const_read: false };
}

function import_prefixes(mod: parser.Module, ids: string[], pfxs: string[]): string[] {
  let out: string[] = [];
  for i in 0..mod.imports.len() {
    let k: i32 = -1;
    if (mod.imports[i].resolved.len() > 0) {
      k = util.index_of_str(ids, mod.imports[i].resolved);
    }
    if (k >= 0) {
      out = out.append(pfxs[k]);
    } else {
      out = out.append(util.mangle_prefix(util.path_base(mod.imports[i].path)));
    }
  }
  return out;
}

pub function assign_prefixes(imports: LoadedModule[]): string[] {
  let pfxs: string[] = [];
  let order: i32[] = [];
  for i in 0..imports.len() {
    pfxs = pfxs.append("");
    order = order.append(i);
    let j = order.len() - 1;
    while (j > 0 && prefix_before(imports[order[j]], imports[order[j - 1]])) {
      let prev = order[j - 1];
      order = order.with(j - 1, order[j]).with(j, prev);
      j -= 1;
    }
  }
  let used: string[] = [];
  for k in order {
    let base = imports[k].name;
    if (imports[k].ident.len() > 0) {
      base = util.path_base(imports[k].ident);
    }
    let pf = unique_prefix(util.mangle_prefix(base), used);
    used = used.append(pf);
    pfxs = pfxs.with(k, pf);
  }
  return pfxs;
}

function prefix_before(a: LoadedModule, b: LoadedModule): boolean {
  let ak = a.ident;
  let bk = b.ident;
  if (ak.len() == 0) {
    ak = a.name;
  }
  if (bk.len() == 0) {
    bk = b.name;
  }
  let a_std = is_stdlib_ident(ak);
  let b_std = is_stdlib_ident(bk);
  if (a_std != b_std) {
    return a_std;
  }
  return util.str_less(ak, bk);
}

function module_ids(imports: LoadedModule[]): string[] {
  let out: string[] = [];
  for i in 0..imports.len() {
    out = out.append(imports[i].ident);
  }
  return out;
}

// A callback names a function of its own module, so the target is mangled
// with the declaration.
function callback_target(fd: parser.FuncDecl, ctx: RewriteCtx): string {
  if (fd.import_iface == parser.CALLBACK_IFACE) {
    return mangle_bare(fd.import_wit, ctx);
  }
  return fd.import_wit;
}

function mangle_bare(name: string, ctx: RewriteCtx): string {
  return resolve_bare(name, ctx, false);
}

function mangle_bare_value(name: string, ctx: RewriteCtx): string {
  return resolve_bare(name, ctx, true);
}

function resolve_bare(name: string, ctx: RewriteCtx, as_value: boolean): string {
  if (util.has_str(ctx.type_params, name)) {
    return name;
  }
  let di = declname_index_of(name, ctx);
  if (di >= 0 && di < ctx.declnames_mangled.len()) {
    return ctx.declnames_mangled[di];
  }
  let iv = match_ivar(name, ctx);
  if (as_value && iv.ambiguous) {
    if (ctx.prefix.len() == 0) {
      return name;
    }
    return mangled_name(ctx.prefix, name);
  }
  if (iv.mangled.len() > 0) {
    return iv.mangled;
  }
  return name;
}

function rewrite_unary_op(op: string, ctx: RewriteCtx): string {
  if (op.starts_with("as?_")) {
    return "as?_" + rewrite_type_name(slice_unchecked(op, 4, op.len()), ctx);
  }
  if (op.starts_with("as_")) {
    return "as_" + rewrite_type_name(slice_unchecked(op, 3, op.len()), ctx);
  }
  return op;
}

function rewrite_written(w: string, ctx: RewriteCtx): string {
  if (w.len() == 0) {
    return w;
  }
  return rewrite_type_name(w, ctx);
}

function with_type_params(ctx: RewriteCtx, names: string[]): RewriteCtx {
  if (names.len() == 0) {
    return ctx;
  }
  return RewriteCtx { ...ctx, type_params: util.append_all(ctx.type_params, names) };
}

pub function rewrite_type_name(tn: string, ctx: RewriteCtx): string {
  if (parser.spelling_is_own(tn)) {
    return "own " + rewrite_type_spelling(parser.spelling_without_own(tn), ctx);
  }
  return rewrite_type_spelling(tn, ctx);
}

function rewrite_type_spelling(tn: string, ctx: RewriteCtx): string {
  let tref = parser.parse_type_ref(tn);
  if (util.has_str(ctx.type_params, tref.base)) {
    return tn;
  }
  if (tref.is_tuple) {
    let out = "(";
    for ti in 0..tref.args.len() {
      if (ti > 0) {
        out += ", ";
      }
      out += rewrite_type_name(parser.render_type_ref(tref.args[ti]), ctx);
    }
    out += ")";
    for td in 0..tref.array_depth {
      out += "[]";
    }
    return out;
  }
  if (tref.is_fn) {
    let fout = "(";
    let fi = 0;
    while (fi + 1 < tref.args.len()) {
      if (fi > 0) {
        fout += ", ";
      }
      fout += rewrite_type_name(parser.render_type_ref(tref.args[fi]), ctx);
      fi += 1;
    }
    fout = fout + ") => " + rewrite_type_name(parser.render_type_ref(tref.args[tref.args.len() - 1]), ctx);
    for fd in 0..tref.array_depth {
      fout += "[]";
    }
    return fout;
  }
  if (!tref.is_tuple && !tref.is_fn && tref.args.len() == 0 && parser.dyn_trait_set(tref.base).len() > 0) {
    let dout = canon_dyn(tref.base, ctx);
    for dd in 0..tref.array_depth {
      dout += "[]";
    }
    return dout;
  }
  if (!tref.is_tuple && tref.args.len() > 0) {
    let gout = rewrite_type_name(tref.base, ctx) + "[";
    for gi in 0..tref.args.len() {
      if (gi > 0) {
        gout += ", ";
      }
      gout += rewrite_type_name(parser.render_type_ref(tref.args[gi]), ctx);
    }
    gout += "]";
    for gad in 0..tref.array_depth {
      gout += "[]";
    }
    return gout;
  }
  let dot = util.index_of_byte(tn, b'.', 0);
  if (dot >= 0) {
    let qual = slice_unchecked(tn, 0, dot);
    if (is_in(qual, ctx.modnames)) {
      let prefix = resolve_prefix(qual, ctx);
      let rest = slice_unchecked(tn, dot + 1, tn.len());
      let member_dot = util.index_of_byte(rest, b'.', 0);
      if (member_dot >= 0) {
        let en = lookup_reexport(prefix + "__" + slice_unchecked(rest, 0, member_dot), ctx);
        let owner = imported_enum_prefix(en, ctx);
        if (owner.len() > 0) {
          return en + "." + mangled_name(owner, slice_unchecked(rest, member_dot + 1, rest.len()).to_owned());
        }
      }
      let rb = parser.first_bracket(rest);
      if (rb < 0) {
        return lookup_reexport(prefix + "__" + rest, ctx);
      }
      let rbase = slice_unchecked(rest, 0, rb);
      return lookup_reexport(prefix + "__" + rbase, ctx) + slice_unchecked(rest, rb, rest.len());
    }
    if (is_in(qual, ctx.enumnames)) {
      return mangle_bare(qual + "", ctx) + "." + mangle_bare(slice_unchecked(tn, dot + 1, tn.len()).to_owned(), ctx);
    }
    return tn;
  }
  let br = parser.first_bracket(tn);
  if (br < 0) {
    return bare_type(tn, ctx);
  }
  let base = slice_unchecked(tn, 0, br);
  if (declname_index_of(base + "", ctx) >= 0) {
    return ctx.prefix + "__" + base + slice_unchecked(tn, br, tn.len());
  }
  return tn;
}

// A variant under a built-in type's name does not take that name in a type.
function bare_type(tn: string, ctx: RewriteCtx): string {
  let builtin = parser.is_reserved_struct_name(tn) || parser.is_reserved_enum_name(tn);
  if (builtin && (util.has_str(ctx.own_variants, tn) || declname_index_of(tn, ctx) < 0)) {
    return tn;
  }
  return mangle_bare(tn, ctx);
}

function rewrite_variant_name(tn: string, ctx: RewriteCtx): string {
  if (util.index_of_byte(tn, b'.', 0) < 0 && parser.first_bracket(tn) < 0) {
    return mangle_bare(tn, ctx);
  }
  return rewrite_type_name(tn, ctx);
}

function rewrite_pattern(p: ast.Pattern, ctx: RewriteCtx): ast.Pattern {
  match (p) {
    ast.PatVariant(pv) => {
      let nested: ast.Pattern[] = [];
      for pat in pv.nested {
        nested = nested.append(rewrite_pattern(pat, ctx));
      }
      let tuple_patterns: ast.Pattern[] = [];
      for pat in pv.tup_pats {
        tuple_patterns = tuple_patterns.append(rewrite_pattern(pat, ctx));
      }
      let cond = pv.lit_cond;
      if (pv.has_lit_cond) {
        cond = rewrite_expr(cond, ctx);
      }
      return ast.PatVariant { ...pv, type_name: rewrite_variant_name(pv.type_name, ctx), nested: nested, tup_pats: tuple_patterns, lit_cond: cond };
    },
    _ => {
      return p;
    }
  }
}

pub function rewrite_expr(e: ast.Expr, ctx: RewriteCtx): ast.Expr {
  match (e) {
    ast.ExprIdent(id) => {
      if (is_in(id.name, ctx.locals)) {
        return ast.ExprIdent { ...id };
      }
      return ast.ExprIdent { ...id, name: mangle_bare_value(id.name, ctx) };
    },
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(id) => {
          if (is_in(id.name, ctx.modnames) && !is_in(id.name, ctx.locals)) {
            let mangled = lookup_reexport(resolve_prefix(id.name, ctx) + "__" + fa.field, ctx);
            // Primitive display bodies share the compiler's canonical ABI.
            if (fa.field.starts_with("__primitive_")) {
              mangled = fa.field;
            }
            // `ty: ""` and not `id.ty`: the result names a module-qualified
            // FUNCTION, so the module ident's own tag says nothing about it.
            return ast.ExprIdent { ...id, name: mangled, ty: "" };
          }
          if (!is_in(id.name, ctx.locals) && is_in(id.name, ctx.enumnames)) {
            return ast.ExprFieldAccess { ...fa, obj: ast.ExprIdent { ...id, name: mangle_bare(id.name, ctx) }, field: mangle_bare(fa.field, ctx) };
          }
        },
        _ => {}
      }
      let obj = rewrite_expr(fa.obj, ctx);
      if let ast.ExprFieldAccess(_) = fa.obj {
        if let ast.ExprIdent(id) = obj {
          let owner = imported_enum_prefix(id.name, ctx);
          if (owner.len() > 0 && !is_in(id.name, ctx.locals)) {
            return ast.ExprFieldAccess { ...fa, obj: obj, field: mangled_name(owner, fa.field) };
          }
        }
      }
      return ast.ExprFieldAccess { ...fa, obj: obj };
    },
    ast.ExprCall(c) => {
      let args: ast.Expr[] = [];
      let i = 0;
      while (i < c.args.len()) {
        args = args.append(rewrite_expr(c.args[i], ctx));
        i += 1;
      }
      let targs: string[] = [];
      for ta in c.type_args {
        targs = targs.append(rewrite_type_name(ta, ctx));
      }
      return ast.ExprCall { callee: rewrite_expr(c.callee, ctx), args: args, line: c.line, col: c.col, type_args: targs, ty: c.ty };
    },
    ast.ExprBinary(b) => {
      return ast.binary(b.op, rewrite_expr(b.left, ctx), rewrite_expr(b.right, ctx), b.line, b.col, b.ty);
    },
    ast.ExprUnary(u) => {
      return ast.unary(rewrite_unary_op(u.op, ctx), rewrite_expr(u.operand, ctx), u.line, u.col, u.ty);
    },
    ast.ExprIndex(x) => {
      return ast.ExprIndex {
        array: rewrite_expr(x.array, ctx),
        index: rewrite_expr(x.index, ctx),
        unchecked: x.unchecked,
        ty: x.ty, line: x.line, col: x.col,
      };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice {
        ...sl,
        array: rewrite_expr(sl.array, ctx),
        start: rewrite_expr(sl.start, ctx),
        end: rewrite_expr(sl.end, ctx),
      };
    },
    ast.ExprTuple(t) => {
      let elems: ast.Expr[] = [];
      let i = 0;
      while (i < t.elements.len()) {
        elems = elems.append(rewrite_expr(t.elements[i], ctx));
        i += 1;
      }
      return ast.ExprTuple { elements: elems, line: t.line, col: t.col };
    },
    ast.ExprArray(a) => {
      let elems: ast.Expr[] = [];
      let i = 0;
      while (i < a.elements.len()) {
        elems = elems.append(rewrite_expr(a.elements[i], ctx));
        i += 1;
      }
      return ast.ExprArray { ...a, elements: elems };
    },
    ast.ExprStructLit(slit) => {
      let fvs: ast.Expr[] = [];
      for i in 0..slit.field_values.len() {
        fvs = fvs.append(rewrite_expr(slit.field_values[i], ctx));
      }
      let new_base = slit.base;
      if (slit.has_base) {
        new_base = rewrite_expr(slit.base, ctx);
      }
      return ast.ExprStructLit { ...slit, type_name: rewrite_type_name(slit.type_name, ctx), field_values: fvs, base: new_base, written: rewrite_written(slit.written, ctx) };
    },
    ast.ExprLambda(lm) => {
      let inner = ctx.locals;
      for lp in lm.params {
        inner = inner.append(lp.name);
      }
      let lctx = RewriteCtx { ...ctx, locals: inner };
      return ast.ExprLambda {
        ...lm,
        params: rewrite_params(lm.params, ctx),
        ret_type: rewrite_type_name(lm.ret_type, ctx),
        ret_fn_ret: rewrite_type_name(lm.ret_fn_ret, ctx),
        ret_fn_param_types: rewrite_type_name_list(lm.ret_fn_param_types, ctx),
        body: rewrite_block(lm.body, lctx),
      };
    },
    _ => {
      return e;
    }
  }
}

pub function rewrite_block(stmts: ast.Stmt[], ctx: RewriteCtx): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let scope = ctx;
  for st in stmts {
    out = out.append(rewrite_stmt(st, scope));
    match (st) {
      ast.StmtVar(v) => {
        scope = RewriteCtx { ...scope, locals: astwalk.append_bound_name(scope.locals, v.name) };
      },
      _ => {}
    }
  }
  return out;
}

function rewrite_var_type(tn: string, ctx: RewriteCtx): string {
  if (!parser.is_struct_destr_marker(tn)) {
    return rewrite_type_name(tn, ctx);
  }
  let at = util.index_of_sub(tn, "@sd:") + 4;
  let rest = slice_unchecked(tn, at, tn.len()).to_owned();
  let colon = util.index_of_sub(rest, ":");
  if (colon < 0) {
    return tn;
  }
  return slice_unchecked(tn, 0, at) + rewrite_type_name(slice_unchecked(rest, 0, colon).to_owned(), ctx) + slice_unchecked(rest, colon, rest.len());
}

function rewrite_stmt(st: ast.Stmt, ctx: RewriteCtx): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar {
        name: v.name,
        type_name: rewrite_var_type(v.type_name, ctx),
        init: rewrite_expr(v.init, ctx),
        line: v.line, col: v.col,
        fn_ret: rewrite_type_name(v.fn_ret, ctx),
        fn_param_types: rewrite_type_name_list(v.fn_param_types, ctx),
      };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: rewrite_expr(r.value, ctx), line: r.line, col: r.col };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: rewrite_expr(x.value, ctx) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: rewrite_expr(a.value, ctx) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf {
        ...f,
        cond: rewrite_expr(f.cond, ctx),
        then_body: rewrite_block(f.then_body, ctx),
        else_body: rewrite_block(f.else_body, ctx),
        sugar: rewrite_match_sugar(f.sugar, ctx),
      };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: rewrite_expr(w.cond, ctx), body: rewrite_block(w.body, ctx), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtFor(f) => {
      let loop_locals = ctx.locals;
      return ast.StmtFor {
        var_name: f.var_name,
        iter: rewrite_expr(f.iter, ctx),
        body: rewrite_block(f.body, RewriteCtx { ...ctx, locals: astwalk.append_bound_name(loop_locals, f.var_name) }),
        label: f.label,
        line: f.line,
        col: f.col,
      };
    },
    ast.StmtMatch(m) => {
      return ast.StmtMatch { ...m, scrutinee: rewrite_expr(m.scrutinee, ctx), arms: rewrite_match_arms(m.arms, ctx), sugar: rewrite_match_arms(m.sugar, ctx) };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: rewrite_stmt(d.action, ctx), on_error: d.on_error, line: d.line };
    },
    _ => {
      return st;
    }
  }
}

function rewrite_match_arms(arms: ast.MatchArm[], ctx: RewriteCtx): ast.MatchArm[] {
  let out: ast.MatchArm[] = [];
  for arm in arms {
    let locals = util.append_all(ctx.locals, astwalk.pattern_binders(arm.pattern, []));
    let actx = RewriteCtx { ...ctx, locals: locals };
    out = out.append(ast.MatchArm { ...arm, pattern: rewrite_pattern(arm.pattern, ctx), body: rewrite_block(arm.body, actx), guard: rewrite_expr(arm.guard, actx) });
  }
  return out;
}

function rewrite_tuple_arm(arm: ast.TupArm, ctx: RewriteCtx): ast.TupArm {
  let locals = util.append_all(ctx.locals, []);
  locals = astwalk.append_bound_name(locals, arm.at_binding);
  for name in arm.binds {
    locals = astwalk.append_bound_name(locals, name);
  }
  let patterns: ast.Pattern[] = [];
  for pattern in arm.elem_pats {
    locals = astwalk.pattern_binders(pattern, locals);
    patterns = patterns.append(rewrite_pattern(pattern, ctx));
  }
  let literals: ast.Expr[] = [];
  for literal in arm.lits {
    literals = literals.append(rewrite_expr(literal, ctx));
  }
  let actx = RewriteCtx { ...ctx, locals: locals };
  return ast.TupArm { ...arm, elem_pats: patterns, lits: literals, body: rewrite_block(arm.body, actx), guard: rewrite_expr(arm.guard, actx) };
}

function rewrite_match_sugar(sg: ast.MatchSugar, ctx: RewriteCtx): ast.MatchSugar {
  if (sg.arms.len() == 0 && sg.tup.len() == 0) {
    return sg;
  }
  let tuples: ast.TupArm[] = [];
  for arm in sg.tup {
    tuples = tuples.append(rewrite_tuple_arm(arm, ctx));
  }
  return ast.MatchSugar { ...sg, scrut: rewrite_expr(sg.scrut, ctx), arms: rewrite_match_arms(sg.arms, ctx), tup: tuples };
}

function rewrite_params(params: ast.ParamDecl[], ctx: RewriteCtx): ast.ParamDecl[] {
  let out: ast.ParamDecl[] = [];
  for i in 0..params.len() {
    out = out.append(ast.ParamDecl {
      ...params[i],
      type_name: rewrite_type_name(params[i].type_name, ctx),
      fn_ret: rewrite_type_name(params[i].fn_ret, ctx),
      fn_param_types: rewrite_type_name_list(params[i].fn_param_types, ctx),
    });
  }
  return out;
}

function rewrite_type_name_list(list: string, ctx: RewriteCtx): string {
  if (list.len() == 0) {
    return "";
  }
  let parts = parser.split_top_commas(list);
  let out = "";
  for i in 0..parts.len() {
    if (i > 0) {
      out += ",";
    }
    out += rewrite_type_name(parts[i], ctx);
  }
  return out;
}

function canon_trait(d: string, ctx: RewriteCtx): string {
  let dot = d.len() - 1;
  while (dot >= 0 && d[dot] != b'.') {
    dot -= 1;
  }
  if (dot < 0) {
    if (ctx.prefix.len() == 0) {
      return d;
    }
    return ctx.prefix + "." + d;
  }
  let k = util.index_of_str(ctx.modnames, slice_unchecked(d, 0, dot).to_owned());
  if (k < 0) {
    return d;
  }
  let name = slice_unchecked(d, dot + 1, d.len()).to_owned();
  return canonical_imported_trait(ctx.modprefixes[k], name, ctx.reexport_keys, ctx.reexport_targets);
}

pub function canonical_imported_trait(prefix: string, name: string, keys: string[], targets: string[]): string {
  return decltypes.canonical_imported_trait(prefix, name, keys, targets);
}

function canon_derives(derives: string[], ctx: RewriteCtx): string[] {
  let out: string[] = [];
  for d in derives {
    out = out.append(canon_trait(d, ctx));
  }
  return out;
}

function trait_module_of(im: parser.ImplInfo, ctx: RewriteCtx): string {
  let spelling = im.trait_spelling;
  if (spelling.len() == 0) {
    spelling = im.trait_name;
  }
  let canon = canon_trait(util.base_type_name(spelling), ctx);
  let dot = canon.len() - 1;
  while (dot >= 0 && canon[dot] != b'.') {
    dot -= 1;
  }
  if (dot < 0) {
    return "";
  }
  return slice_unchecked(canon, 0, dot).to_owned();
}

function canon_dyn(set: string, ctx: RewriteCtx): string {
  let out = "dyn ";
  let first = true;
  for tr in parser.dyn_trait_set(set) {
    if (!first) {
      out += " + ";
    }
    let head = util.base_type_name(tr);
    out = out + canon_trait(head, ctx) + slice_unchecked(tr, head.len(), tr.len());
    first = false;
  }
  return out;
}

function rewrite_struct_fields(fields: parser.StructFieldDecl[], ctx: RewriteCtx): parser.StructFieldDecl[] {
  let out: parser.StructFieldDecl[] = [];
  for i in 0..fields.len() {
    out = out.append(parser.StructFieldDecl {
      ...fields[i],
      type_name: rewrite_type_name(fields[i].type_name, ctx),
      fn_ret: rewrite_type_name(fields[i].fn_ret, ctx),
      fn_param_types: rewrite_type_name_list(fields[i].fn_param_types, ctx),
    });
  }
  return out;
}

function param_names(fd: parser.FuncDecl): string[] {
  let out: string[] = [];
  if (fd.receiver_name.len() > 0) {
    out = out.append(fd.receiver_name);
  }
  for i in 0..fd.params.len() {
    out = out.append(fd.params[i].name);
  }
  return out;
}

function rewrite_module_bodies(mod: parser.Module, ctx: RewriteCtx): parser.Module {
  let funcs: parser.FuncDecl[] = [];
  for i in 0..mod.funcs.len() {
    let fd = mod.funcs[i];
    let tctx = with_type_params(ctx, fd.all_type_params);
    let new_name = fd.name;
    if (fd.receiver_type == "") {
      new_name = mangle_bare(fd.name, ctx);
    }
    let bctx: RewriteCtx = RewriteCtx {
      type_params: tctx.type_params,
      modnames: ctx.modnames, modprefixes: ctx.modprefixes, prefix: ctx.prefix,
      declnames: ctx.declnames, declnames_mangled: ctx.declnames_mangled, dn_head: ctx.dn_head, dn_next: ctx.dn_next, locals: param_names(fd),
      enumnames: ctx.enumnames, imported_enums: ctx.imported_enums, ivar_names: ctx.ivar_names, ivar_mangled: ctx.ivar_mangled, variant_scope: ctx.variant_scope,
      reexport_keys: ctx.reexport_keys, reexport_targets: ctx.reexport_targets, own_variants: ctx.own_variants,
    };
    let bound_modules: string[] = [];
    for module in fd.bound_modules {
      if (module.len() == 0) {
        bound_modules = bound_modules.append(ctx.prefix);
      } else {
        bound_modules = bound_modules.append(module);
      }
    }
    funcs = funcs.append(parser.FuncDecl { ...fd, name: new_name, import_wit: callback_target(fd, ctx), receiver_type: rewrite_type_name(fd.receiver_type, tctx), params: rewrite_params(fd.params, bctx), ret_type: rewrite_type_name(fd.ret_type, tctx), ret_fn_ret: rewrite_type_name(fd.ret_fn_ret, tctx), ret_fn_param_types: rewrite_type_name_list(fd.ret_fn_param_types, tctx), body: rewrite_block(fd.body, bctx), module: ctx.prefix, bound_modules: bound_modules });
  }
  let structs: parser.StructDecl[] = [];
  for j in 0..mod.structs.len() {
    structs = structs.append(parser.StructDecl {
      name: mangle_bare(mod.structs[j].name, ctx),
      fields: rewrite_struct_fields(mod.structs[j].fields, with_type_params(ctx, mod.structs[j].type_params)),
      type_params: mod.structs[j].type_params, const_params: mod.structs[j].const_params,
      derives: canon_derives(mod.structs[j].derives, ctx),
      line: mod.structs[j].line,
      col: mod.structs[j].col,
      enum_owner: mangle_bare(mod.structs[j].enum_owner, ctx),
      must_consume: mod.structs[j].must_consume,
      value_type: mod.structs[j].value_type,
      variant_field_names: mod.structs[j].variant_field_names,
      is_pub: true,
      is_package: false,
      opaque: mod.structs[j].opaque,
      module: ctx.prefix,
    });
  }
  let aliases: parser.TypeAlias[] = [];
  for k in 0..mod.aliases.len() {
    let tctx = with_type_params(ctx, mod.aliases[k].type_params);
    let variants: string[] = [];
    let v = 0;
    while (v < mod.aliases[k].variants.len()) {
      variants = variants.append(rewrite_type_name(mod.aliases[k].variants[v], tctx));
      v += 1;
    }
    let vargs: string[] = [];
    for a in mod.aliases[k].variant_args {
      vargs = vargs.append(rewrite_type_name_list(a, tctx));
    }
    aliases = aliases.append(parser.TypeAlias {
      name: mangle_bare(mod.aliases[k].name, ctx),
      variants: variants,
      variant_args: vargs,
      variant_lines: mod.aliases[k].variant_lines,
      type_params: mod.aliases[k].type_params,
      const_params: mod.aliases[k].const_params,
      line: mod.aliases[k].line,
      col: mod.aliases[k].col,
      is_pub: true,
      is_package: false, module: ctx.prefix,
    });
  }
  let exports: parser.ExportBinding[] = [];
  for binding in mod.exports {
    exports = exports.append(parser.ExportBinding { ...binding, func_name: mangle_bare(binding.func_name, ctx) });
  }
  let marks: parser.FuncMark[] = [];
  for pv in mod.marks {
    marks = marks.append(parser.FuncMark { ...pv, func_name: mangle_bare(pv.func_name, ctx) });
  }
  return parser.Module { ...mod, funcs: funcs, structs: structs, aliases: aliases, exports: exports, marks: marks, top_stmts: rewrite_block(mod.top_stmts, RewriteCtx { type_params: [], modnames: ctx.modnames, modprefixes: ctx.modprefixes, prefix: ctx.prefix, declnames: ctx.declnames, declnames_mangled: ctx.declnames_mangled, dn_head: ctx.dn_head, dn_next: ctx.dn_next, locals: [], enumnames: ctx.enumnames, imported_enums: ctx.imported_enums, ivar_names: ctx.ivar_names, ivar_mangled: ctx.ivar_mangled, variant_scope: ctx.variant_scope, reexport_keys: ctx.reexport_keys, reexport_targets: ctx.reexport_targets, own_variants: ctx.own_variants }), enums: mangle_enum_decls(mod.enums, ctx), impls: mangle_impls(mod.impls, ctx), trait_reqs: mangle_trait_reqs(mod.trait_reqs, ctx) };
}

function rewrite_trait_ref(spelling: string, ctx: RewriteCtx): string {
  let ref = parser.parse_type_ref(spelling);
  let args: parser.TypeRef[] = [];
  for arg in ref.args {
    args = args.append(parser.parse_type_ref(rewrite_type_name(parser.render_type_ref(arg), ctx)));
  }
  return parser.render_type_ref(parser.TypeRef { ...ref, base: canon_trait(ref.base, ctx), args: args });
}

function mangle_trait_reqs(reqs: parser.TraitReq[], ctx: RewriteCtx): parser.TraitReq[] {
  let out: parser.TraitReq[] = [];
  for r in reqs {
    let tctx = with_type_params(ctx, r.type_params);
    let parents: string[] = [];
    for parent in r.supertraits {
      parents = parents.append(rewrite_trait_ref(parent, tctx));
    }
    out = out.append(parser.TraitReq { ...r, supertraits: parents, req_sigs: mangle_sigs(r.req_sigs, tctx), assoc_sigs: mangle_sigs(r.assoc_sigs, tctx), default_sigs: mangle_sigs(r.default_sigs, tctx) });
  }
  return out;
}

function mangle_sigs(sigs: parser.FuncDecl[], ctx: RewriteCtx): parser.FuncDecl[] {
  let out: parser.FuncDecl[] = [];
  for fd in sigs {
    let tctx = with_type_params(ctx, fd.all_type_params);
    out = out.append(parser.FuncDecl { ...fd, params: rewrite_params(fd.params, tctx), ret_type: rewrite_type_name(fd.ret_type, tctx), ret_fn_ret: rewrite_type_name(fd.ret_fn_ret, tctx), ret_fn_param_types: rewrite_type_name_list(fd.ret_fn_param_types, tctx) });
  }
  return out;
}

function mangle_impls(impls: parser.ImplInfo[], ctx: RewriteCtx): parser.ImplInfo[] {
  let out: parser.ImplInfo[] = [];
  for i in 0..impls.len() {
    let im = impls[i];
    let tctx = with_type_params(ctx, im.all_type_params);
    let mangled_vals: string[] = [];
    for vi in 0..im.assoc_values.len() {
      mangled_vals = mangled_vals.append(rewrite_type_name(im.assoc_values[vi], tctx));
    }
    out = out.append(parser.ImplInfo {
      trait_name: im.trait_name,
      impl_type: rewrite_type_name(im.impl_type, tctx),
      type_params: im.type_params,
      all_type_params: im.all_type_params,
      bounds: im.bounds,
      method_names: im.method_names,
      trait_spelling: im.trait_spelling,
      trait_ref: rewrite_trait_ref(im.trait_ref, tctx),
      assoc_names: im.assoc_names,
      assoc_values: mangled_vals,
      trait_module: trait_module_of(im, ctx),
      module: ctx.prefix,
      line: im.line,
      col: im.col,
    });
  }
  return out;
}

function mangle_enum_decls(enums: parser.EnumDecl[], ctx: RewriteCtx): parser.EnumDecl[] {
  let out: parser.EnumDecl[] = [];
  for i in 0..enums.len() {
    let e = enums[i];
    let nvn: string[] = [];
    for v in 0..e.variant_names.len() {
      nvn = nvn.append(mangle_bare(e.variant_names[v], ctx));
    }
    out = out.append(parser.EnumDecl {
      name: mangle_bare(e.name, ctx),
      variant_names: nvn,
      type_params: e.type_params,
      const_params: e.const_params,
      line: e.line,
      col: e.col,
      must_consume: e.must_consume,
      try_marker: e.try_marker,
      is_pub: e.is_pub,
      is_package: e.is_package, module: ctx.prefix,
      instance: rewrite_type_name(e.instance, with_type_params(ctx, e.type_params)),
      visible_from: e.visible_from,
    });
  }
  return out;
}

pub function flatten_qualified(mod: parser.Module, ids: string[], pfxs: string[], scope: string[], ivar_names: string[], ivar_mangled: string[], reexport_keys: string[], reexport_targets: string[], imported: ImportedEnum[]): parser.Module {
  let empty: string[] = [];
  let own = collect_decl_names(mod);
  let ivn: string[] = [];
  let ivm: string[] = [];
  for i in 0..ivar_names.len() {
    if (!util.has_str(own, ivar_names[i])) {
      ivn = ivn.append(ivar_names[i]);
      ivm = ivm.append(ivar_mangled[i]);
    }
  }
  let shadows = builtin_shadows(mod);
  let ctx = RewriteCtx { type_params: [], modnames: path_aliased_names(mod, mod_names(mod)), modprefixes: path_aliased_prefixes(mod, import_prefixes(mod, ids, pfxs)), prefix: "", declnames: shadows, declnames_mangled: entry_shadow_names(shadows), dn_head: build_declname_head(shadows), dn_next: build_declname_next(shadows), locals: empty, enumnames: empty, imported_enums: imported, ivar_names: ivn, ivar_mangled: ivm, variant_scope: scope, reexport_keys: reexport_keys, reexport_targets: reexport_targets, own_variants: empty };
  return rewrite_module_bodies(mod, ctx);
}

// The bundle names of the entry functions `names`. An imported module's own
// functions have their module prefix, so they cannot collide with a builtin.
function entry_shadow_names(names: string[]): string[] {
  let out: string[] = [];
  for n in names {
    out = out.append(util.ENTRY_SHADOW_PREFIX + n);
  }
  return out;
}

// The free functions of the entry module that have the name of a builtin.
// Each one shadows the builtin in the module, as a function of an imported
// module does. The mangled name of a built-in method is not a name that a
// program can take.
function builtin_shadows(mod: parser.Module): string[] {
  let out: string[] = [];
  for fd in mod.funcs {
    if (fd.receiver_type.len() == 0 && !fd.is_const && !fd.name.starts_with("__method_") && (builtinsigs.builtin_row(fd.name).len() > 0 || caps.is_builtin(fd.name)) && !util.has_str(out, fd.name)) {
      out = out.append(fd.name);
    }
  }
  return out;
}

// Diagnostic drivers have an unloaded module. Rewrite its builtin shadows
// without qualifying names from imports that the driver has not loaded.
pub function qualify_entry_builtins(mod: parser.Module): parser.Module {
  let shadows = builtin_shadows(mod);
  if (shadows.len() == 0) {
    return mod;
  }
  let empty: string[] = [];
  let ctx = RewriteCtx { type_params: [], modnames: empty, modprefixes: empty, prefix: "", declnames: shadows, declnames_mangled: entry_shadow_names(shadows), dn_head: build_declname_head(shadows), dn_next: build_declname_next(shadows), locals: empty, enumnames: empty, imported_enums: [], ivar_names: empty, ivar_mangled: empty, variant_scope: empty, reexport_keys: empty, reexport_targets: empty, own_variants: empty };
  return rewrite_module_bodies(mod, ctx);
}

pub function collect_decl_names(mod: parser.Module): string[] {
  let names: string[] = [];
  for i in 0..mod.funcs.len() {
    if (mod.funcs[i].receiver_type == "") {
      names = names.append(mod.funcs[i].name);
    }
  }
  for j in 0..mod.structs.len() {
    names = names.append(mod.structs[j].name);
  }
  for k in 0..mod.aliases.len() {
    names = names.append(mod.aliases[k].name);
  }
  for en in 0..mod.enums.len() {
    names = names.append(mod.enums[en].name);
  }
  return names;
}

pub function collect_enum_names(mod: parser.Module): string[] {
  let names: string[] = [];
  for i in 0..mod.enums.len() {
    names = names.append(mod.enums[i].name);
  }
  return names;
}

function unique_prefix(base: string, used: string[]): string {
  let cand = base;
  let k = 1;
  while (is_in(cand, used)) {
    cand = base + "_" + util.i32_to_string(k);
    k += 1;
  }
  return cand;
}

pub function mangle_module(mod: parser.Module, prefix: string, ids: string[], pfxs: string[], scope: string[], ivar_names: string[], ivar_mangled: string[], reexport_keys: string[], reexport_targets: string[], imported: ImportedEnum[]): parser.Module {
  return rewrite_module_bodies(mod, module_ctx(mod, prefix, ids, pfxs, scope, ivar_names, ivar_mangled, reexport_keys, reexport_targets, imported));
}

function module_ctx(mod: parser.Module, prefix: string, ids: string[], pfxs: string[], scope: string[], ivar_names: string[], ivar_mangled: string[], reexport_keys: string[], reexport_targets: string[], imported: ImportedEnum[]): RewriteCtx {
  let decls = collect_decl_names(mod);
  return RewriteCtx {
    type_params: [],
    modnames: path_aliased_names(mod, mod_names(mod)),
    modprefixes: path_aliased_prefixes(mod, import_prefixes(mod, ids, pfxs)),
    prefix: prefix,
    declnames: decls,
    declnames_mangled: build_mangled_names(prefix, decls),
    dn_head: build_declname_head(decls),
    dn_next: build_declname_next(decls),
    locals: [],
    enumnames: collect_enum_names(mod), imported_enums: imported,
    ivar_names: ivar_names,
    ivar_mangled: ivar_mangled,
    variant_scope: scope,
    reexport_keys: reexport_keys,
    reexport_targets: reexport_targets,
    own_variants: variant_names(mod),
  };
}

function variant_names(mod: parser.Module): string[] {
  let names: string[] = [];
  for sd in mod.structs {
    if (sd.enum_owner.len() > 0) {
      names = names.append(sd.name);
    }
  }
  return names;
}

struct TraitDefaultIn { key: string, params: string[], consts: string[], method: parser.FuncDecl }

function module_trait_defaults(mod: parser.Module, ctx: RewriteCtx, acc: TraitDefaultIn[]): TraitDefaultIn[] {
  for td in mod.trait_decls {
    for m in td.methods {
      if (m.body.len() > 0) {
        let tctx = with_type_params(with_type_params(ctx, td.type_params), m.all_type_params);
        let bctx = RewriteCtx { ...tctx, locals: param_names(m) };
        let rm = parser.FuncDecl { ...m, params: rewrite_params(m.params, bctx), ret_type: rewrite_type_name(m.ret_type, tctx), ret_fn_ret: rewrite_type_name(m.ret_fn_ret, tctx), ret_fn_param_types: rewrite_type_name_list(m.ret_fn_param_types, tctx), body: rewrite_block(m.body, bctx), module: ctx.prefix };
        acc = acc.append(TraitDefaultIn { key: ctx.prefix + "." + td.name, params: td.type_params, consts: td.const_params, method: rm });
      }
    }
  }
  return acc;
}

function inherit_trait_defaults(mod: parser.Module, own: string, defaults: TraitDefaultIn[]): parser.Module {
  let funcs = mod.funcs;
  for im in mod.impls {
    if (im.trait_name.len() > 0 && im.trait_module != own) {
      let key = parser.impl_trait_key(im);
      for d in defaults {
        if (d.key == key && util.index_of_str(im.method_names, d.method.name) < 0) {
          funcs = funcs.append(parser.FuncDecl { ...parser.inherit_default(d.method, d.params, d.consts, im), module: d.method.module, impl_trait: im.trait_name });
        }
      }
    }
  }
  return parser.Module { ...mod, funcs: funcs };
}

struct RenamedImports { mods: parser.Module[], defaults: TraitDefaultIn[] }

function rename_imports(entry: parser.Module, imports: LoadedModule[], ids: string[], pfxs: string[], graph: ImportGraph, ivar_names: string[], ivar_mangled: string[], rx: ReexportTable): RenamedImports {
  let imported = imported_enums(imports, pfxs);
  let ctxs: RewriteCtx[] = [];
  let closures: i32[][] = [];
  let defaults: TraitDefaultIn[] = [];
  for i in 0..imports.len() {
    let closure = import_closure(imports[i].mod, graph, ids, pfxs);
    closures = closures.append(closure);
    let cx = module_ctx(imports[i].mod, pfxs[i], ids, pfxs, prefixes_at(closure, pfxs), ivar_names, ivar_mangled, rx.keys, rx.targets, imported);
    ctxs = ctxs.append(cx);
    defaults = module_trait_defaults(imports[i].mod, cx, defaults);
  }
  let viewers = enum_viewers(closures, import_closure(entry, graph, ids, pfxs), pfxs);
  let mods: parser.Module[] = [];
  for j in 0..imports.len() {
    mods = mods.append(with_enum_viewers(inherit_trait_defaults(rewrite_module_bodies(imports[j].mod, ctxs[j]), pfxs[j], defaults), viewers[j]));
  }
  return RenamedImports { mods: mods, defaults: defaults };
}

pub struct LoadedModule { name: string, ident: string, mod: parser.Module }

pub function modules(loaded: LoadedModule[]): parser.Module[] {
  let out: parser.Module[] = [];
  for lm in loaded {
    out = out.append(lm.mod);
  }
  return out;
}

struct MethodDedup { mod: parser.Module, keys: string[] }

function disambiguate_methods(mod: parser.Module, ns: string, claimed: string[]): MethodDedup {
  let out: parser.FuncDecl[] = [];
  let added: string[] = [];
  let i = 0;
  while (i < mod.funcs.len()) {
    let fd = mod.funcs[i];
    if (fd.receiver_type.len() == 0) {
      out = out.append(fd);
      i += 1;
      continue;
    }
    let base = util.base_type_name(fd.receiver_type);
    if (fd.impl_trait.len() == 0) {
      base = parser.receiver_namespace(fd.receiver_type);
    }
    let key = base + "." + fd.name;
    if (util.index_of_str(claimed, key) < 0) {
      if (util.index_of_str(added, key) < 0) {
        added = added.append(key);
      }
      out = out.append(fd);
      i += 1;
      continue;
    }
    let renamed = ns + "." + fd.name;
    let rkey = base + "." + renamed;
    if (util.index_of_str(claimed, rkey) >= 0 || util.index_of_str(added, rkey) >= 0) {
      out = out.append(fd);
      i += 1;
      continue;
    }
    added = added.append(rkey);
    out = out.append(parser.FuncDecl { ...fd, name: renamed });
    i += 1;
  }
  let keys = claimed;
  for k in 0..added.len() {
    keys = keys.append(added[k]);
  }
  let deduped = parser.Module { ...mod, funcs: out };
  return MethodDedup { mod: deduped, keys: keys };
}

function imported_trait_spellings(mod: parser.Module, imports: LoadedModule[]): string[] {
  let ids = module_ids(imports);
  let quals = mod_names(mod);
  let out: string[] = [];
  for i in 0..mod.imports.len() {
    let k: i32 = -1;
    if (mod.imports[i].resolved.len() > 0) {
      k = util.index_of_str(ids, mod.imports[i].resolved);
    }
    if (k < 0) {
      k = loaded_index_by_name(imports, util.path_base(mod.imports[i].path));
    }
    if (k >= 0) {
      for t in imports[k].mod.trait_decls {
        out = out.append(quals[i] + "." + t.name);
      }
    }
  }
  return out;
}

function loaded_index_by_name(imports: LoadedModule[], name: string): i32 {
  for i in 0..imports.len() {
    if (imports[i].name == name) {
      return i;
    }
  }
  return -1;
}

function desugar_imported_trait_params(imports: LoadedModule[]): LoadedModule[] {
  let out: LoadedModule[] = [];
  for lm in imports {
    out = out.append(LoadedModule { ...lm, mod: parser.desugar_trait_params(lm.mod, imported_trait_spellings(lm.mod, imports), true) });
  }
  return out;
}

pub struct Qualifiers { aliases: string[], prefixes: string[], own: string, reexport_keys: string[], reexport_targets: string[] }

pub function bundle_qualifiers(entry: parser.Module, imports: LoadedModule[]): Qualifiers[] {
  let ids = module_ids(imports);
  let pfxs = assign_prefixes(imports);
  let rx = build_reexports(imports, ids, pfxs);
  let out: Qualifiers[] = [Qualifiers { aliases: mod_names(entry), prefixes: import_prefixes(entry, ids, pfxs), own: "", reexport_keys: rx.keys, reexport_targets: rx.targets }];
  for i in 0..imports.len() {
    let m = imports[i].mod;
    out = out.append(Qualifiers { aliases: mod_names(m), prefixes: import_prefixes(m, ids, pfxs), own: pfxs[i], reexport_keys: rx.keys, reexport_targets: rx.targets });
  }
  return out;
}

pub function qualified_name(q: Qualifiers, alias: string, name: string): string {
  let i = util.index_of_str(q.aliases, alias);
  if (i < 0) {
    return "";
  }
  return decltypes.follow_reexports(q.prefixes[i] + "__" + name, q.reexport_keys, q.reexport_targets);
}

pub function bundle(entry0: parser.Module, imports0: LoadedModule[], target: string): parser.Module {
  return parser.resolve_variant_fields_module(bundle_with_prefixes(entry0, imports0, target, assign_prefixes(imports0)));
}

pub function bundle_with_prefixes(entry0: parser.Module, imports0: LoadedModule[], target: string, pfxs: string[]): parser.Module {
  let imports = desugar_imported_trait_params(imports0);
  let entry = parser.desugar_trait_params(with_handler_main(entry0, target), imported_trait_spellings(entry0, imports0), true);
  let funcs: parser.FuncDecl[] = [];
  let structs: parser.StructDecl[] = [];
  let aliases: parser.TypeAlias[] = [];
  let enums: parser.EnumDecl[] = [];
  let resources: parser.ResourceDecl[] = [];
  let exports: parser.ExportBinding[] = [];
  let marks: parser.FuncMark[] = [];
  let impls: parser.ImplInfo[] = [];
  let trait_reqs: parser.TraitReq[] = [];
  let trait_decls: parser.TraitDecl[] = [];
  let ids = module_ids(imports);
  let ivar_names: string[] = [];
  let ivar_mangled: string[] = [];
  for iv in 0..imports.len() {
    let isd = 0;
    while (isd < imports[iv].mod.structs.len()) {
      let sd = imports[iv].mod.structs[isd];
      if (sd.enum_owner.len() > 0) {
        ivar_names = ivar_names.append(sd.name);
        ivar_mangled = ivar_mangled.append(pfxs[iv] + "__" + sd.name);
      }
      isd += 1;
    }
  }
  let rx = build_reexports(imports, ids, pfxs);
  let graph = import_graph(imports, ids, pfxs);
  let inferred = mangled_substituted_consts(imports, pfxs, entry);
  let renamed = rename_imports(entry, imports, ids, pfxs, graph, ivar_names, ivar_mangled, rx);
  let mclaims: string[] = [];
  for i in 0..imports.len() {
    let pfx = pfxs[i];
    let md = disambiguate_methods(renamed.mods[i], pfx, mclaims);
    mclaims = md.keys;
    let m = md.mod;
    funcs = util.append_all(funcs, m.funcs);
    structs = util.append_all(structs, m.structs);
    aliases = util.append_all(aliases, m.aliases);
    enums = util.append_all(enums, m.enums);
    for ri in 0..m.resources.len() {
      resources = resources.append(m.resources[ri]);
    }
    for mxi in 0..m.exports.len() {
      exports = exports.append(m.exports[mxi]);
    }
    marks = util.append_all(marks, m.marks);
    for mii in 0..m.impls.len() {
      impls = impls.append(m.impls[mii]);
    }
    for mti in 0..m.trait_reqs.len() {
      trait_reqs = trait_reqs.append(parser.TraitReq { ...m.trait_reqs[mti], module: pfx, visible_from: importers_of(i, imports, graph, pfxs, entry) });
    }
    for mdi in 0..m.trait_decls.len() {
      trait_decls = trait_decls.append(m.trait_decls[mdi]);
    }
  }
  let flat = with_result_handler(flatten_qualified(entry, ids, pfxs, variant_scope(entry, graph, ids, pfxs), ivar_names, ivar_mangled, rx.keys, rx.targets, imported_enums(imports, pfxs)), loaded_prefix(imports, pfxs, "core/error"), loaded_prefix(imports, pfxs, "std/http"));
  let e = disambiguate_methods(inherit_trait_defaults(flat, "", renamed.defaults), "__entry", mclaims).mod;
  funcs = util.append_all(funcs, e.funcs);
  structs = util.append_all(structs, e.structs);
  aliases = util.append_all(aliases, e.aliases);
  enums = util.append_all(enums, e.enums);
  for rj in 0..e.resources.len() {
    resources = resources.append(e.resources[rj]);
  }
  for exj in 0..e.exports.len() {
    exports = exports.append(e.exports[exj]);
  }
  marks = util.append_all(marks, e.marks);
  for eii in 0..e.impls.len() {
    impls = impls.append(e.impls[eii]);
  }
  for eti in 0..e.trait_reqs.len() {
    trait_reqs = trait_reqs.append(e.trait_reqs[eti]);
  }
  for edi in 0..e.trait_decls.len() {
    trait_decls = trait_decls.append(e.trait_decls[edi]);
  }
  let closure: parser.Import[] = [];
  let closure_paths: string[] = [];
  for ci in 0..entry.imports.len() {
    if (util.index_of_str(closure_paths, entry.imports[ci].path) < 0) {
      closure_paths = closure_paths.append(entry.imports[ci].path);
      closure = closure.append(entry.imports[ci]);
    }
  }
  for cm in 0..imports.len() {
    let cmi = 0;
    while (cmi < imports[cm].mod.imports.len()) {
      if (util.index_of_str(closure_paths, imports[cm].mod.imports[cmi].path) < 0) {
        closure_paths = closure_paths.append(imports[cm].mod.imports[cmi].path);
        closure = closure.append(imports[cm].mod.imports[cmi]);
      }
      cmi += 1;
    }
  }
  let merged: parser.Module = parser.Module {
    funcs: funcs,
    structs: structs,
    aliases: aliases,
    imports: closure,
    top_stmts: e.top_stmts,
    enums: enums,
    resources: resources,
    exports: exports,
    marks: marks,
    impls: impls,
    trait_reqs: trait_reqs,
    trait_decls: trait_decls,
    substituted_consts: inferred,
    todo_sites: e.todo_sites,
    sights: module_sights(entry, imports, graph, ids, pfxs, rx),
  };
  return parser.lower_stream_signatures(parser.route_inherited_defaults(parser.resolve_dyn_traits(parser.settle_module(parser.rewrite_assoc_const_reads(parser.substitute_const_refs(merged, merged_const_table(funcs, inferred)))))));
}

function mangled_substituted_consts(imports: LoadedModule[], pfxs: string[], entry: parser.Module): string[] {
  let out: string[] = [];
  for i in 0..imports.len() {
    for n in imports[i].mod.substituted_consts {
      out = out.append(mangled_name(pfxs[i], n));
    }
  }
  return util.append_all(out, entry.substituted_consts);
}

function merged_const_table(funcs: parser.FuncDecl[], inferred: string[]): parser.ConstTable {
  let nothing: string[] = [];
  return parser.inferred_const_table(funcs, inferred, parser.ConstTable { names: nothing, values: [] });
}

pub struct ReexportTable { keys: string[], targets: string[] }

pub function build_reexports(imports: LoadedModule[], ids: string[], pfxs: string[]): ReexportTable {
  let keys: string[] = [];
  let targets: string[] = [];
  for i in 0..imports.len() {
    let ns = pfxs[i];
    let imps = imports[i].mod.imports;
    for j in 0..imps.len() {
      if (imps[j].is_reexport) {
        let ok: i32 = -1;
        if (imps[j].resolved.len() > 0) {
          ok = util.index_of_str(ids, imps[j].resolved);
        }
        let origin = util.mangle_prefix(util.path_base(imps[j].path));
        if (ok >= 0) {
          origin = pfxs[ok];
        }
        let names = imps[j].reexport_names;
        for n in 0..names.len() {
          keys = keys.append(ns + "__" + names[n]);
          targets = targets.append(origin + "__" + names[n]);
        }
      }
    }
  }
  return with_reexported_variants(ReexportTable { keys: keys, targets: targets }, imports, pfxs);
}

// The table with each variant of a re-exported enum: the facade's qualified
// variant resolves to the variant of the enum's own module, as the enum does.
function with_reexported_variants(rx: ReexportTable, imports: LoadedModule[], pfxs: string[]): ReexportTable {
  let keys = rx.keys;
  let targets = rx.targets;
  for k in 0..rx.keys.len() {
    let enum_name = decltypes.follow_reexports(rx.targets[k], rx.keys, rx.targets);
    let ns = slice_unchecked(rx.keys[k], 0, rx.keys[k].len() - mangled_tail(rx.targets[k]).len() + 2).to_owned();
    for i in 0..imports.len() {
      for sd in imports[i].mod.structs {
        if (sd.enum_owner.len() > 0 && pfxs[i] + "__" + sd.enum_owner == enum_name) {
          keys = keys.append(ns + sd.name);
          targets = targets.append(pfxs[i] + "__" + sd.name);
        }
      }
    }
  }
  return ReexportTable { keys: keys, targets: targets };
}

// The name after the last "__" of a mangled name, with that "__".
function mangled_tail(mangled: string): string {
  let at = mangled.len() - 2;
  while (at > 0 && !util.str_eq_at(mangled, at, "__")) {
    at -= 1;
  }
  return slice_unchecked(mangled, at, mangled.len()).to_owned();
}

pub struct PerModule { ns: string, ident: string, mod: parser.Module, is_entry: boolean }

pub function bundle_per_module(entry0: parser.Module, imports0: LoadedModule[], target: string): PerModule[] {
  let imports = desugar_imported_trait_params(imports0);
  let entry = parser.desugar_trait_params(with_handler_main(entry0, target), imported_trait_spellings(entry0, imports0), true);
  let ids = module_ids(imports);
  let pfxs = assign_prefixes(imports);
  let ivar_names: string[] = [];
  let ivar_mangled: string[] = [];
  for iv in 0..imports.len() {
    let isd = 0;
    while (isd < imports[iv].mod.structs.len()) {
      let sd = imports[iv].mod.structs[isd];
      if (sd.enum_owner.len() > 0) {
        ivar_names = ivar_names.append(sd.name);
        ivar_mangled = ivar_mangled.append(pfxs[iv] + "__" + sd.name);
      }
      isd += 1;
    }
  }
  let rx = build_reexports(imports, ids, pfxs);
  let graph = import_graph(imports, ids, pfxs);
  let inferred = mangled_substituted_consts(imports, pfxs, entry);
  let mods: parser.Module[] = [];
  let all_funcs: parser.FuncDecl[] = [];
  let renamed = rename_imports(entry, imports, ids, pfxs, graph, ivar_names, ivar_mangled, rx);
  let mclaims: string[] = [];
  for i in 0..imports.len() {
    let pfx = pfxs[i];
    let md = disambiguate_methods(renamed.mods[i], pfx, mclaims);
    mclaims = md.keys;
    mods = mods.append(md.mod);
    all_funcs = util.append_all(all_funcs, md.mod.funcs);
  }
  let flat = with_result_handler(flatten_qualified(entry, ids, pfxs, variant_scope(entry, graph, ids, pfxs), ivar_names, ivar_mangled, rx.keys, rx.targets, imported_enums(imports, pfxs)), loaded_prefix(imports, pfxs, "core/error"), loaded_prefix(imports, pfxs, "std/http"));
  let e = disambiguate_methods(inherit_trait_defaults(flat, "", renamed.defaults), "__entry", mclaims).mod;
  all_funcs = util.append_all(all_funcs, e.funcs);
  let table = merged_const_table(all_funcs, inferred);
  let out: PerModule[] = [];
  for j in 0..imports.len() {
    out = out.append(PerModule { ns: pfxs[j], ident: imports[j].ident, mod: parser.lower_stream_signatures(parser.rewrite_assoc_const_reads(parser.substitute_const_refs(mods[j], table))), is_entry: false });
  }
  out = out.append(PerModule { ns: "__entry", ident: "", mod: parser.lower_stream_signatures(parser.rewrite_assoc_const_reads(parser.substitute_const_refs(e, table))), is_entry: true });
  return out;
}

function flatten_source(src: string): parser.Module {
  let none: string[] = [];
  return flatten_qualified(parser.parse_module(lexer.tokenize(src)), none, none, none, none, none, none, none, []);
}

function mangle_source(src: string, prefix: string): parser.Module {
  let none: string[] = [];
  return mangle_module(parser.parse_module(lexer.tokenize(src)), prefix, none, none, none, none, none, none, none, []);
}

function check_prefix_collisions(): boolean {
  let empty = parser.parse_module([]);
  let collisions: LoadedModule[] = [
    LoadedModule { name: "frame", ident: "/project/frame", mod: empty },
    LoadedModule { name: "frame", ident: "std/http/h3/frame", mod: empty },
    LoadedModule { name: "frame", ident: "std/http/h2/frame", mod: empty },
    LoadedModule { name: "frame_1", ident: "std/frame_1", mod: empty },
  ];
  let prefixes = assign_prefixes(collisions);
  return prefixes[0] == "frame_3" && prefixes[1] == "frame_2" && prefixes[2] == "frame" && prefixes[3] == "frame_1";
}

function main(): i32 {
  if (!check_prefix_collisions()) {
    return 115;
  }
  let src: string = "import \"./lexer\";"
    + " function f(): i32 {"
    + "   let t: lexer.Token = lexer.tokenize(\"x\");"
    + "   match (t) { lexer.TokNumber(n) => { return 1; }, _ => { return 0; } }"
    + "   return 0;"
    + " }";
  let mod = flatten_source(src);
  if (mod.funcs.len() != 1) {
    return 1;
  }
  if (mod.funcs[0].name != "f") {
    return 2;
  }
  let body = mod.funcs[0].body;
  match (body[0]) {
    ast.StmtVar(v) => {
      if (v.type_name != "lexer__Token") {
        return 10;
      }
      match (v.init) {
        ast.ExprCall(c) => {
          match (c.callee) {
            ast.ExprIdent(id) => {
              if (id.name != "lexer__tokenize") {
                return 11;
              }
            },
            _ => {
              return 12;
            }
          }
        },
        _ => {
          return 13;
        }
      }
    },
    _ => {
      return 14;
    }
  }
  match (body[1]) {
    ast.StmtMatch(m) => {
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "lexer__TokNumber") {
            return 21;
          }
        },
        _ => {
          return 23;
        }
      }
    },
