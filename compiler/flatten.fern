  match (mod2.funcs[0].body[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "x") {
            return 30;
          }
          match (fa.obj) {
            ast.ExprIdent(id) => {
              if (id.name != "p") {
                return 31;
              }
            },
            _ => {
              return 32;
            }
          }
        },
        _ => {
          return 33;
        }
      }
    },
    _ => {
      return 34;
    }
  }

  let msrc: string = "struct Box { v: i32 }"
    + " function (b: Box) get(): i32 { return b.v; }"
