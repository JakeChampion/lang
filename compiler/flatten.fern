  let loaded: LoadedModule[] = [];
  loaded = loaded.append(LoadedModule { name: "a", ident: "", mod: amod });
  let merged = bundle(emod, loaded, "");

  if (merged.imports.len() != 1 || merged.imports[0].path != "./a") {
