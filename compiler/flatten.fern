  let mn: string[] = [];
  mn = mn.append("lexer");
  mn = mn.append("test");
  let dn: string[] = [];
  dn = dn.append("Token");
  let ivn: string[] = [];
  ivn = ivn.append("Fail");
  let ivm: string[] = [];
  ivm = ivm.append("test__Fail");
  let rxk: string[] = [];
  let rxt: string[] = [];
  let ctx = RewriteCtx { type_params: [], modnames: mn, modprefixes: mn, prefix: "lx", declnames: dn, declnames_mangled: build_mangled_names("lx", dn), dn_head: build_declname_head(dn), dn_next: build_declname_next(dn), locals: [], enumnames: [], imported_enums: [], ivar_names: ivn, ivar_mangled: ivm, variant_scope: mn, reexport_keys: rxk, reexport_targets: rxt, own_variants: [] };
  if (rewrite_type_name("lexer.Token[]", ctx) != "lexer__Token[]") {
