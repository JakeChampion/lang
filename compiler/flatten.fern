  let rxt2: string[] = [];
  rxt2 = rxt2.append("orig__Token");
  let rctx = RewriteCtx { type_params: [], modnames: mn, modprefixes: mn, prefix: "lx", declnames: dn, declnames_mangled: build_mangled_names("lx", dn), dn_head: build_declname_head(dn), dn_next: build_declname_next(dn), locals: [], enumnames: [], imported_enums: [], ivar_names: ivn, ivar_mangled: ivm, variant_scope: mn, reexport_keys: rxk2, reexport_targets: rxt2, own_variants: [] };
  if (rewrite_type_name("lexer.Token", rctx) != "orig__Token") {
