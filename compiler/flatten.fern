  match (mm.funcs[2].body[0]) {
    ast.StmtVar(v) => {
      if (v.type_name != "m__Box") {
        return 70;
      }
      match (v.init) {
        ast.ExprCall(c) => {
          match (c.callee) {
            ast.ExprIdent(id) => {
              if (id.name != "m__make") {
                return 71;
              }
            },
            _ => {
              return 72;
            }
          }
        },
        _ => {
          return 73;
        }
      }
    },
    _ => {
      return 74;
    }
  }
  match (mm.funcs[2].body[1]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprCall(c) => {
          match (c.callee) {
            ast.ExprFieldAccess(fa) => {
              if (fa.field != "get") {
