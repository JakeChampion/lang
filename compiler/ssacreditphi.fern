import "./ssa";
import "./ssacreditguard" as guard;
import "./util";

pub struct Value { kind: i32, identity: i32, available: i32 }

pub struct Edge { predecessor: i32, path: i32, values: Value[] }

pub struct Binding { result: i32, value: Value }

pub struct Joined { arena: guard.Arena, bindings: Binding[], path: i32, error: string }

function failed(a: guard.Arena, why: string): Joined {
  return Joined { arena: a, bindings: [], path: -1, error: why };
}

function implies(a: guard.Arena, path: i32, condition: i32): Result[guard.Built, guard.BuildError] {
  let one = guard.constant(a, 1);
  let valid: guard.Built = match (guard.combine(one.arena, 4, condition, one.id)) { Ok(value) => value, Err(error) => { return Err(error); } };
  let inverse: guard.Built = match (guard.combine(valid.arena, 1, one.id, condition)) { Ok(value) => value, Err(error) => { return Err(error); } };
  return guard.combine(inverse.arena, 4, path, inverse.id);
}

pub function merge(a: guard.Arena, block: ssa.SBlock, edges: Edge[], nvals: i32): Joined {
  return merge_values(a, block, edges, nvals, [], nvals);
}

pub function merge_mapped(a: guard.Arena, block: ssa.SBlock, edges: Edge[], nvals: i32, ids: i32[]): Joined {
  if (nvals < 1 || ids.len() == 0) {
    return failed(a, "invalid phi value mapping");
  }
  let seen: i32[] = [];
  for id in ids {
    if (id < 0 || id >= nvals || util.index_of_i32(seen, id) >= 0) {
      return failed(a, "invalid phi value mapping");
    }
    seen = seen.append(id);
  }
  return merge_values(a, block, edges, nvals, ids, ids.len());
}

function value_slot(ids: i32[], id: i32, nvals: i32): i32 {
  if (id < 0 || id >= nvals) {
    return -1;
  }
  if (ids.len() == 0) {
    return id;
  }
  return util.index_of_i32(ids, id);
}

function merge_values(a: guard.Arena, block: ssa.SBlock, edges: Edge[], nvals: i32, ids: i32[], count: i32): Joined {
  if (nvals < 1 || block.preds.len() == 0 || edges.len() != block.preds.len()) {
    return failed(a, "phi predecessor count");
  }
  let zero = guard.constant(a, 0);
  let one = guard.constant(zero.arena, 1);
  let arena = one.arena;
  let path = zero.id;
  let seen: i32[] = [];
  for e in edges {
    if (e.predecessor < 0 || util.index_of_i32(seen, e.predecessor) >= 0 || util.index_of_i32(block.preds, e.predecessor) < 0 || e.values.len() != count) {
      return failed(arena, "invalid phi predecessor");
    }
    seen = seen.append(e.predecessor);
    let mask: guard.Built = match (guard.combine(arena, 4, e.path, one.id)) { Ok(value) => value, Err(error) => { return failed(error.arena, error.message); } };
    let overlap: guard.Built = match (guard.combine(mask.arena, 4, path, e.path)) { Ok(value) => value, Err(error) => { return failed(error.arena, "overlapping phi edges"); } };
    if (!guard.is_constant(overlap.arena, overlap.id, 0)) {
      return failed(overlap.arena, "overlapping phi edges");
    }
    let joined: guard.Built = match (guard.combine(overlap.arena, 0, path, e.path)) { Ok(value) => value, Err(error) => { return failed(error.arena, error.message); } };
    arena = joined.arena;
    path = joined.id;
  }
  seen = [];
  for pred in block.preds {
    if (util.index_of_i32(seen, pred) >= 0) {
      return failed(arena, "duplicate phi predecessor");
    }
    seen = seen.append(pred);
  }
  let definitions: i32[] = [];
  let body = false;
  for op in block.insts {
    if (value_slot(ids, op.result, nvals) < 0 || util.index_of_i32(definitions, op.result) >= 0) {
      return failed(arena, "invalid phi block definition");
    }
    definitions = definitions.append(op.result);
    if (op.kind_tag == 8) {
      if (body || op.args.len() != block.preds.len()) {
        return failed(arena, "phi predecessor arity or position");
      }
    } else {
      body = true;
    }
  }
  let bindings: Binding[] = [];
  for op in block.insts {
    if (op.kind_tag == 8) {
      let identity = zero.id;
      let kind: i32 = 0;
      let scalar = zero.id;
      for e in edges {
        let pos = util.index_of_i32(block.preds, e.predecessor);
        let arg = op.args[pos];
        let slot = value_slot(ids, arg, nvals);
        if (slot < 0 || util.index_of_i32(definitions, arg) >= 0) {
          return failed(arena, "invalid acyclic phi operand");
        }
        if (!guard.is_constant(arena, e.path, 0)) {
          let value = e.values[slot];
          if (value.kind != 0 && value.kind != 1) {
            return failed(arena, "unreadable phi operand");
          }
          let available: guard.Built = match (implies(arena, e.path, value.available)) { Ok(value) => value, Err(error) => { return failed(error.arena, error.message); } };
          if (!guard.is_constant(available.arena, available.id, 0)) {
            return failed(available.arena, "unavailable phi operand");
          }
          let contribution: guard.Built = match (guard.combine(available.arena, 4, e.path, value.identity)) { Ok(value) => value, Err(error) => { return failed(error.arena, error.message); } };
          arena = contribution.arena;
          if (value.kind == 1) {
            kind = 1;
            let negative: guard.Built = match (guard.combine(arena, 3, contribution.id, zero.id)) { Ok(value) => value, Err(error) => { return failed(error.arena, "invalid reference identity"); } };
            if (!guard.is_constant(negative.arena, negative.id, 0)) {
              return failed(negative.arena, "invalid reference identity");
            }
            arena = negative.arena;
          } else {
            let sum: guard.Built = match (guard.combine(arena, 0, scalar, contribution.id)) { Ok(value) => value, Err(error) => { return failed(error.arena, error.message); } };
            arena = sum.arena;
            scalar = sum.id;
          }
          let sum: guard.Built = match (guard.combine(arena, 0, identity, contribution.id)) { Ok(value) => value, Err(error) => { return failed(error.arena, error.message); } };
          arena = sum.arena;
          identity = sum.id;
        }
      }
      if (kind == 1 && !guard.is_constant(arena, scalar, 0)) {
        return failed(arena, "non-null scalar phi reference");
      }
      bindings = bindings.append(Binding { result: op.result, value: Value { kind: kind, identity: identity, available: path } });
    }
  }
  return Joined { arena: arena, bindings: bindings, path: path, error: "" };
}

pub function is_null(a: guard.Arena, value: Value, path: i32): Result[guard.Built, guard.BuildError] {
  if (value.kind != 1) {
    return Err(guard.BuildError { arena: a, message: "reference null test required" });
  }
  let available: guard.Built = match (implies(a, path, value.available)) { Ok(result) => result, Err(error) => { return Err(error); } };
  if (!guard.is_constant(available.arena, available.id, 0)) {
    return Err(guard.BuildError { arena: available.arena, message: "unavailable null-test operand" });
  }
  let zero = guard.constant(available.arena, 0);
  let negative: guard.Built = match (guard.combine(zero.arena, 3, value.identity, zero.id)) { Ok(result) => result, Err(error) => { return Err(error); } };
  let feasible: guard.Built = match (guard.combine(negative.arena, 4, path, negative.id)) { Ok(result) => result, Err(error) => { return Err(error); } };
  if (!guard.is_constant(feasible.arena, feasible.id, 0)) {
    return Err(guard.BuildError { arena: feasible.arena, message: "invalid reference identity" });
  }
  let eq: guard.Built = match (guard.combine(feasible.arena, 2, value.identity, zero.id)) { Ok(result) => result, Err(error) => { return Err(error); } };
  return guard.combine(eq.arena, 4, path, eq.id);
}
