pub struct AsyncLift { name: string, core_name: string, param_names: string[], param_types: i32[][], result: i32[] }

pub struct AsyncLower { iface: string, name: string, param_names: string[], param_types: i32[][], result: i32[] }

pub struct AsyncSurface { lifts: AsyncLift[], lowers: AsyncLower[] }

function comp_resultlist(b: i32[], vt: i32[]): i32[] {
  if (vt.len() == 0) {
    b = b.append(1);
    return b.append(0);
  }
  return util.append_all(b.append(0), vt);
}

function comp_canon_task_return(vt: i32): i32[] {
  let r: i32[] = [];
  if (vt >= 0) {
    r = [vt];
  }
  let b = comp_resultlist([1, 9], r);
  b = b.append(0);
  return wsection(8, b);
}

function async_functype(b: i32[], names: string[], vts: i32[][], result: i32[]): i32[] {
  b = b.append(67);
  b = leb_u32(b, vts.len());
  for i in 0..vts.len() {
    b = util.append_all(wname(b, names[i]), vts[i]);
  }
  return comp_resultlist(b, result);
}

function comp_type_async_func(l: AsyncLift): i32[] {
  return wsection(7, async_functype([1], l.param_names, l.param_types, l.result));
}

struct InstanceTypes { b: i32[], n: i32 }

function instance_valtype(it: InstanceTypes, t: i32[]): (InstanceTypes, i32[]) {
  if (t.len() <= 1) {
    return (it, t);
  }
  let b = util.append_all(it.b.append(1), t);
  return (InstanceTypes { b: b, n: it.n + 1 }, leb_u32([], it.n));
}

pub function comp_type_async_instance(lowers: AsyncLower[]): i32[] {
  let it = InstanceTypes { b: [], n: 0 };
  for l in lowers {
    let vts: i32[][] = [];
    for t in l.param_types {
      let (it2, vt) = instance_valtype(it, t);
      it = it2;
      vts = vts.append(vt);
    }
    let (it3, rvt) = instance_valtype(it, l.result);
    let fb = async_functype(it3.b.append(1), l.param_names, vts, rvt);
    let eb = wname(util.append_all(fb, [4, 0]), l.name);
    eb = eb.append(1);
    it = InstanceTypes { b: leb_u32(eb, it3.n), n: it3.n + 1 };
  }
  return wsection(7, util.append_all(leb_u32([1, 66], it.n + lowers.len()), it.b));
}

pub function comp_type_stream(vt: i32): i32[] {
  return wsection(7, [1, 102, 1, vt]);
}

pub function comp_import_instance(name: string, typeidx: i32): i32[] {
  let b = wname([1, 0], name);
  b = b.append(5);
  b = leb_u32(b, typeidx);
  return wsection(10, b);
}

function comp_canon_lift_async(corefunc: i32, typeidx: i32): i32[] {
  let b: i32[] = [1, 0, 0];
  b = leb_u32(b, corefunc);
  b = b.append(1);
  b = b.append(6);
  b = leb_u32(b, typeidx);
  return wsection(8, b);
}

function comp_canon_typed(kind: i32, typeop: i32): i32[] {
  if (kind == 3) {
    return comp_canon_resource_drop(typeop);
  }
  if (kind == 4) {
    return comp_canon_task_return(typeop);
  }
  if (kind >= 11) {
    let ops: i32[] = [14, 19, 20];
    return wsection(8, leb_u32([1, ops[kind - 11]], typeop));
  }
  return wsection(8, [1, typeop]);
}

function trampolined(k: i32): boolean {
  return k == 1 || k == 2 || k >= 5 && k <= 7 || k == 9 || k == 10;
}

function lowers_realloc(k: i32): boolean {
  return k == 2 || k == 6;
}

pub function lowered_name(name: string): string {
  let pre = "[async-lower]";
  if (name.len() <= pre.len() || !name.starts_with(pre)) {
    return name;
  }
  let bytes: u8[] = [];
  for i in pre.len()..name.len() {
    bytes = bytes.append(name[i]);
  }
  unsafe {
    return string_from_bytes_unchecked(bytes);
  }
}

function suffix_memory_canon(o: i32[], k: i32, inst: i32, name: string, typeop: i32, n_cfunc: i32, realloc_f: i32): (i32[], i32) {
  if (k == 7) {
    return (util.append_all(o, wsection(8, [1, 32, 0, 0])), n_cfunc);
  }
  if (k == 9 || k == 10) {
    return (util.append_all(o, wsection(8, util.append_all(leb_u32([1, k + 6], typeop), [2, 6, 3, 0]))), n_cfunc);
  }
  o = util.append_all(o, comp_alias_inst_func(inst, lowered_name(name)));
  let opts: i32[] = [3, 0];
  let n_opts = 1;
  if (k == 5 || k == 6) {
    opts = [6, 3, 0];
    n_opts = 2;
  }
  if (lowers_realloc(k)) {
    opts = opts.append(4);
    opts = leb_u32(opts, realloc_f);
    n_opts += 1;
  }
  let b: i32[] = [1, 1, 0];
  b = leb_u32(b, n_cfunc);
  b = leb_u32(b, n_opts);
  return (util.append_all(o, wsection(8, util.append_all(b, opts))), n_cfunc + 1);
}

function comp_export_one_func(name: string, funcidx: i32): i32[] {
  let b: i32[] = [1, 0];
  b = wname(b, name);
  b = b.append(1);
  b = leb_u32(b, funcidx);
  b = b.append(0);
  return wsection(11, b);
}

function suffix_group_find(order: string[], iface: string): i32 {
  for i in 0..order.len() {
    if (order[i] == iface) {
      return i;
    }
  }
  return -1;
}

struct SuffixWired { o: i32[], n_cfunc: i32, n_corefunc: i32, n_inst: i32, user_inst: i32 }

function component_suffix_wired(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_results: i32[][], imp_typeop: i32[], n_inst0: i32, user_mod: i32): SuffixWired {
  let n = imp_iface.len();
  let o: i32[] = [];
  let none: i32[] = [];
  let tramp_mod: i32[] = [];
  let fixup_mod: i32[] = [];
  let tramp_inst: i32[] = [];
  let tbl: i32[] = [];
  let coref: i32[] = [];
  let i = 0;
  while (i < n) {
    tramp_mod = tramp_mod.append(0);
    fixup_mod = fixup_mod.append(0);
    tramp_inst = tramp_inst.append(0);
    tbl = tbl.append(0);
    coref = coref.append(0);
    i += 1;
  }
  let n_mod = user_mod + 1;
  let n_cfunc = 0;
  let n_corefunc = 0;
  let n_coreinst = 0;
  let n_coretab = 0;
  let n_inst = n_inst0;
  i = 0;
  while (i < n) {
    if (trampolined(imp_kind[i])) {
      tramp_mod = tramp_mod.with(i, n_mod);
      n_mod += 1;
      o = util.append_all(o, comp_core_module_section(shim_trampoline_core(imp_params[i], imp_results[i])));
      fixup_mod = fixup_mod.with(i, n_mod);
      n_mod += 1;
      o = util.append_all(o, comp_core_module_section(shim_tablefill_core(imp_params[i], imp_results[i])));
    }
    i += 1;
  }
  i = 0;
  while (i < n) {
    if (trampolined(imp_kind[i])) {
      tramp_inst = tramp_inst.with(i, n_coreinst);
      n_coreinst += 1;
      o = util.append_all(o, comp_core_instance_instantiate(tramp_mod[i]));
    }
    i += 1;
  }
  let order: string[] = [];
  let group_names: string[][] = [];
  let group_idxs: i32[][] = [];
  i = 0;
  while (i < n) {
    let k = imp_kind[i];
    let idx = 0;
    if (k == 0) {
      o = util.append_all(o, comp_alias_inst_func(imp_inst[i], imp_name[i]));
      let cf = n_cfunc;
      n_cfunc += 1;
      idx = n_corefunc;
      o = util.append_all(o, comp_canon_lower_noopts(cf));
      n_corefunc += 1;
    } else if (trampolined(k)) {
      idx = n_corefunc;
      o = util.append_all(o, comp_alias_core_func(tramp_inst[i], "0"));
      n_corefunc += 1;
    } else {
      idx = n_corefunc;
      o = util.append_all(o, comp_canon_typed(k, imp_typeop[i]));
      n_corefunc += 1;
    }
    let gi = suffix_group_find(order, imp_iface[i]);
    if (gi < 0) {
      order = order.append(imp_iface[i]);
      group_names = group_names.append([imp_name[i]]);
      group_idxs = group_idxs.append([idx]);
    } else {
      group_names = group_names.with(gi, group_names[gi].append(imp_name[i]));
      group_idxs = group_idxs.with(gi, group_idxs[gi].append(idx));
    }
    i += 1;
  }
  let arg_insts: i32[] = [];
  for g in 0..order.len() {
    let gn = group_names[g];
    let gx = group_idxs[g];
    let sorts: i32[] = [];
    for s in 0..gn.len() {
      sorts = sorts.append(0);
    }
    o = util.append_all(o, comp_core_instance_from_exports(gn, sorts, gx));
    arg_insts = arg_insts.append(n_coreinst);
    n_coreinst += 1;
  }
  let user_inst = n_coreinst;
  o = util.append_all(o, comp_core_instance_instantiate_args(user_mod, order, arg_insts));
  n_coreinst += 1;
  let need_mem = false;
  let need_realloc = false;
  i = 0;
  while (i < n) {
    need_mem = need_mem || trampolined(imp_kind[i]);
    need_realloc = need_realloc || lowers_realloc(imp_kind[i]);
    i += 1;
  }
  if (need_mem) {
    o = util.append_all(o, comp_alias_core_export(2, user_inst, "memory"));
  }
  let realloc_f = 0;
  if (need_realloc) {
    realloc_f = n_corefunc;
    o = util.append_all(o, comp_alias_core_export(0, user_inst, "cabi_realloc"));
    n_corefunc += 1;
  }
  i = 0;
  while (i < n) {
    if (trampolined(imp_kind[i])) {
      tbl = tbl.with(i, n_coretab);
      n_coretab += 1;
      o = util.append_all(o, comp_alias_core_export(1, tramp_inst[i], "$imports"));
    }
    i += 1;
  }
  i = 0;
  while (i < n) {
    if (trampolined(imp_kind[i])) {
      let (o2, nc) = suffix_memory_canon(o, imp_kind[i], imp_inst[i], imp_name[i], imp_typeop[i], n_cfunc, realloc_f);
      o = o2;
      n_cfunc = nc;
      coref = coref.with(i, n_corefunc);
      n_corefunc += 1;
    }
    i += 1;
  }
  for i in 0..n {
    if (trampolined(imp_kind[i])) {
      let arg = n_coreinst;
      o = util.append_all(o, comp_core_instance_from_exports(["$imports", "0"], [1, 0], [tbl[i], coref[i]]));
      n_coreinst += 1;
      o = util.append_all(o, comp_core_instance_instantiate_args(fixup_mod[i], [""], [arg]));
      n_coreinst += 1;
    }
  }
  return SuffixWired { o: o, n_cfunc: n_cfunc, n_corefunc: n_corefunc, n_inst: n_inst, user_inst: user_inst };
}

pub function component_suffix(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_results: i32[][], imp_typeop: i32[], n_type0: i32, n_inst0: i32, user_mod: i32, core_export: string, lifts: AsyncLift[]): i32[] {
  let w = component_suffix_wired(imp_iface, imp_name, imp_kind, imp_inst, imp_params, imp_results, imp_typeop, n_inst0, user_mod);
  let o = w.o;
  let run_core_f = w.n_corefunc;
  o = util.append_all(o, comp_alias_core_func(w.user_inst, core_export));
  o = util.append_all(o, comp_type_result_unit(n_type0));
  let lifted = w.n_cfunc;
  o = util.append_all(o, comp_canon_lift_noopts(run_core_f, n_type0 + 1));
  let run_inst = w.n_inst;
  o = util.append_all(o, comp_instance_one_func("run", lifted));
  o = util.append_all(o, comp_export_one_instance("wasi:cli/run@0.2.0", run_inst));
  for i in 0..lifts.len() {
    o = util.append_all(o, comp_alias_core_func(w.user_inst, "[async-lift]" + lifts[i].core_name));
    o = util.append_all(o, comp_type_async_func(lifts[i]));
    o = util.append_all(o, comp_canon_lift_async(run_core_f + 1 + i, n_type0 + 2 + i));
    o = util.append_all(o, comp_export_one_func(lifts[i].name, lifted + 1 + 2 * i));
  }
  return o;
}

pub function component_suffix_http(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_results: i32[][], imp_typeop: i32[], n_type0: i32, n_inst0: i32, user_mod: i32, req_t: i32, out_t: i32): i32[] {
  let w = component_suffix_wired(imp_iface, imp_name, imp_kind, imp_inst, imp_params, imp_results, imp_typeop, n_inst0, user_mod);
  let o = w.o;
  let handle_core_f = w.n_corefunc;
  o = util.append_all(o, comp_alias_core_func(w.user_inst, "wasi:http/incoming-handler@0.2.0#handle"));
  o = util.append_all(o, comp_type_own(req_t));
  o = util.append_all(o, comp_type_own(out_t));
  o = util.append_all(o, comp_type_handle_func(n_type0, n_type0 + 1));
  let lifted = w.n_cfunc;
  o = util.append_all(o, comp_canon_lift_noopts(handle_core_f, n_type0 + 2));
  let handler_inst = w.n_inst;
  o = util.append_all(o, comp_instance_one_func("handle", lifted));
  return util.append_all(o, comp_export_one_instance("wasi:http/incoming-handler@0.2.0", handler_inst));
}

function no_results(n: i32): i32[][] {
  let out: i32[][] = [];
  let none: i32[] = [];
  for i in 0..n {
    out = out.append(none);
  }
  return out;
}

function component_suffix_io(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_typeop: i32[], n_type0: i32, n_inst0: i32, user_mod: i32, core_export: string): i32[] {
  let at = 0;
  let i = 0;
  while (i < imp_iface.len()) {
    if (imp_iface[i] == "wasi:io/streams@0.2.0") {
      at = i + 1;
    }
    i += 1;
  }
  let none: i32[] = [];
  let iface: string[] = [];
  let name: string[] = [];
  let kind: i32[] = [];
  let inst: i32[] = [];
  let params: i32[][] = [];
  let res: i32[] = [];
  for i in 0..=imp_iface.len() {
    if (i == at) {
      iface = iface.append("wasi:io/error@0.2.0");
      name = name.append("[resource-drop]error");
      kind = kind.append(3);
      inst = inst.append(0);
      params = params.append(none);
      res = res.append(1);
    }
    if (i < imp_iface.len()) {
      iface = iface.append(imp_iface[i]);
      name = name.append(imp_name[i]);
      kind = kind.append(imp_kind[i]);
      inst = inst.append(imp_inst[i]);
      params = params.append(imp_params[i]);
      res = res.append(imp_typeop[i]);
    }
  }
  return component_suffix(iface, name, kind, inst, params, no_results(params.len()), res, n_type0, n_inst0, user_mod, core_export, []);
}

function blocking_write_name(): string {
  return "[method]output-stream.blocking-write-and-flush";
}

function component_suffix_stdout(): i32[] {
  let none: i32[] = [];
  return component_suffix_io(
    ["wasi:io/streams@0.2.0", "wasi:cli/stdout@0.2.0"],
    [blocking_write_name(), "get-stdout"],
    [1, 0],
    [1, 2],
    [[127, 127, 127, 127], none],
    [0, 0],
    5, 3, 0, "_lang_run",
  );
}

