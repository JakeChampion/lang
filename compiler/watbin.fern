function labels_push(labels: string[], x: string): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < labels.len()) {
    out = out.append(labels[i]);
    i = i + 1;
  }
  out = out.append(x);
  return out;
}

function label_depth(labels: string[], name: string): i32 {
  let i: i32 = labels.len() - 1;
  while (i >= 0) {
    if (labels[i] == name) {
      return labels.len() - 1 - i;
    }
    i = i - 1;
  }
  return 0;
}

function sat_trunc_opcode(op: string): i32 {
  if (op == "i32.trunc_sat_f32_s") {
    return 0;
  }
  if (op == "i32.trunc_sat_f32_u") {
    return 1;
  }
  if (op == "i32.trunc_sat_f64_s") {
    return 2;
  }
  if (op == "i32.trunc_sat_f64_u") {
    return 3;
  }
  if (op == "i64.trunc_sat_f32_s") {
    return 4;
  }
  if (op == "i64.trunc_sat_f32_u") {
    return 5;
  }
  if (op == "i64.trunc_sat_f64_s") {
    return 6;
  }
  if (op == "i64.trunc_sat_f64_u") {
    return 7;
  }
  return 0 - 1;
}

function simd_opcode(op: string): i32 {
  if (op == "v128.load") {
    return 0;
  }
  if (op == "v128.store") {
    return 11;
  }
  if (op == "i8x16.splat") {
    return 15;
  }
  if (op == "i8x16.eq") {
    return 35;
  }
  if (op == "i8x16.bitmask") {
    return 100;
  }
  if (op == "v128.not") {
    return 77;
  }
  if (op == "v128.and") {
    return 78;
  }
  if (op == "v128.andnot") {
    return 79;
  }
  if (op == "v128.or") {
    return 80;
  }
  if (op == "v128.xor") {
    return 81;
  }
  if (op == "v128.bitselect") {
    return 82;
  }
  if (op == "f64x2.splat") {
    return 20;
  }
  if (op == "i32x4.bitmask") {
    return 164;
  }
  if (op == "i64x2.bitmask") {
    return 196;
  }
  if (op == "f64x2.extract_lane") {
    return 33;
  }
  if (op == "f64x2.replace_lane") {
    return 34;
  }
  if (op == "f64x2.eq") {
    return 71;
  }
  if (op == "f64x2.ne") {
    return 72;
  }
  if (op == "f64x2.lt") {
    return 73;
  }
  if (op == "f64x2.gt") {
    return 74;
  }
  if (op == "f64x2.le") {
    return 75;
  }
  if (op == "f64x2.ge") {
    return 76;
  }
  if (op == "f64x2.ceil") {
    return 116;
  }
  if (op == "f64x2.floor") {
    return 117;
  }
  if (op == "f64x2.trunc") {
    return 122;
  }
  if (op == "f64x2.nearest") {
    return 148;
  }
  if (op == "f64x2.abs") {
    return 236;
  }
  if (op == "f64x2.neg") {
    return 237;
  }
  if (op == "f64x2.sqrt") {
    return 239;
  }
  if (op == "f64x2.add") {
    return 240;
  }
  if (op == "f64x2.sub") {
    return 241;
  }
  if (op == "f64x2.mul") {
    return 242;
  }
  if (op == "f64x2.div") {
    return 243;
  }
  if (op == "f64x2.min") {
    return 244;
  }
  if (op == "f64x2.max") {
    return 245;
  }
  if (op == "f64x2.pmin") {
    return 246;
