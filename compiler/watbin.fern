  o = util.append_all(o, wsection(1, core));
  let none: i32[] = [];
  return util.append_all(o, component_suffix_io(
    ["wasi:io/streams@0.2.0", "wasi:cli/stdout@0.2.0", "wasi:cli/stderr@0.2.0", "wasi:cli/exit@0.2.0"],
    [blocking_write_name(), "get-stdout", "get-stderr", "exit"],
    [1, 0, 0, 0],
    [1, 2, 3, 4],
    [[127, 127, 127, 127], none, none, none],
    [0, 0, 0, 0],
    7, 5, 0, "_lang_run",
  ));
}

