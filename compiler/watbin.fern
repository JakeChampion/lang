function comp_core_instance_instantiate_args(modidx: i32, names: string[], insts: i32[]): i32[] {
  let b: i32[] = [1, 0];
  b = leb_u32(b, modidx);
  b = leb_u32(b, names.len());
  let i: i32 = 0;
  while (i < names.len()) {
    b = wname(b, names[i]);
    b = b.append(18);
    b = leb_u32(b, insts[i]);
    i = i + 1;
  }
  return wsection(2, b);
}

function comp_core_instance_from_exports(names: string[], sorts: i32[], idxs: i32[]): i32[] {
  let b: i32[] = [1, 1];
  b = leb_u32(b, names.len());
  let i: i32 = 0;
  while (i < names.len()) {
    b = wname(b, names[i]);
    b = b.append(sorts[i]);
    b = leb_u32(b, idxs[i]);
    i = i + 1;
  }
  return wsection(2, b);
}

function comp_alias_inst_func(inst: i32, name: string): i32[] {
  let b: i32[] = [1, 1, 0];
  b = leb_u32(b, inst);
  b = wname(b, name);
  return wsection(6, b);
}

function comp_alias_core_func(coreinst: i32, name: string): i32[] {
  let b: i32[] = [1, 0, 0, 1];
  b = leb_u32(b, coreinst);
  b = wname(b, name);
  return wsection(6, b);
}

function comp_alias_core_export(coresort: i32, coreinst: i32, name: string): i32[] {
  let b: i32[] = [1, 0, coresort, 1];
  b = leb_u32(b, coreinst);
  b = wname(b, name);
  return wsection(6, b);
}

function comp_canon_lower_noopts(funcidx: i32): i32[] {
  let b: i32[] = [1, 1, 0];
  b = leb_u32(b, funcidx);
  b = b.append(0);
  return wsection(8, b);
}

function comp_canon_lift_noopts(corefunc: i32, typeidx: i32): i32[] {
  let b: i32[] = [1, 0, 0];
  b = leb_u32(b, corefunc);
  b = b.append(0);
  b = leb_u32(b, typeidx);
  return wsection(8, b);
}

function comp_type_result_unit(rt: i32): i32[] {
  let b: i32[] = [2, 106, 0, 0, 64, 0, 0];
  b = leb_u32(b, rt);
  return wsection(7, b);
}

function comp_instance_one_func(name: string, funcidx: i32): i32[] {
  let b: i32[] = [1, 1, 1, 0];
  b = wname(b, name);
  b = b.append(1);
  b = leb_u32(b, funcidx);
  return wsection(5, b);
}

function comp_export_one_instance(name: string, inst: i32): i32[] {
  let b: i32[] = [1, 0];
  b = wname(b, name);
  b = b.append(5);
  b = leb_u32(b, inst);
  b = b.append(0);
  return wsection(11, b);
}

pub function comp_alias_inst_type(inst: i32, name: string): i32[] {
  let b: i32[] = [1, 3, 0];
  b = leb_u32(b, inst);
  b = wname(b, name);
  return wsection(6, b);
}

function comp_type_own(rt: i32): i32[] {
  let b: i32[] = [1, 105];
  b = leb_u32(b, rt);
  return wsection(7, b);
}

function comp_type_handle_func(own_req: i32, own_out: i32): i32[] {
  let b: i32[] = [1, 64, 2];
  b = wname(b, "request");
  b = leb_u32(b, own_req);
  b = wname(b, "response-out");
  b = leb_u32(b, own_out);
  b = b.append(1);
  b = b.append(0);
  return wsection(7, b);
}

function comp_canon_resource_drop(rt: i32): i32[] {
  let b: i32[] = [1, 3];
  b = leb_u32(b, rt);
  return wsection(8, b);
}

pub struct AsyncLift { name: string, core_name: string, param_names: string[], param_types: i32[][], result: i32[] }

pub struct AsyncLower { iface: string, name: string, param_names: string[], param_types: i32[][], result: i32[] }

pub struct AsyncSurface { lifts: AsyncLift[], lowers: AsyncLower[] }

function comp_resultlist(b: i32[], vt: i32[]): i32[] {
  if (vt.len() == 0) {
    b = b.append(1);
    return b.append(0);
  }
  return wcat(b.append(0), vt);
}

function comp_canon_task_return(vt: i32): i32[] {
  let r: i32[] = [];
  if (vt >= 0) {
    r = [vt];
  }
  let b: i32[] = comp_resultlist([1, 9], r);
  b = b.append(0);
  return wsection(8, b);
}

function async_functype(b: i32[], names: string[], vts: i32[][], result: i32[]): i32[] {
  b = b.append(67);
  b = leb_u32(b, vts.len());
  let i: i32 = 0;
  while (i < vts.len()) {
    b = wcat(wname(b, names[i]), vts[i]);
    i = i + 1;
  }
  return comp_resultlist(b, result);
}

function comp_type_async_func(l: AsyncLift): i32[] {
  return wsection(7, async_functype([1], l.param_names, l.param_types, l.result));
}

struct InstanceTypes { b: i32[], n: i32 }

function instance_valtype(it: InstanceTypes, t: i32[]): (InstanceTypes, i32[]) {
  if (t.len() <= 1) {
    return (it, t);
  }
  let b: i32[] = wcat(it.b.append(1), t);
  return (InstanceTypes { b: b, n: it.n + 1 }, leb_u32([], it.n));
}

pub function comp_type_async_instance(lowers: AsyncLower[]): i32[] {
  let it: InstanceTypes = InstanceTypes { b: [], n: 0 };
  for l in lowers {
    let vts: i32[][] = [];
    for t in l.param_types {
      let (it2, vt) = instance_valtype(it, t);
      it = it2;
      vts = vts.append(vt);
    }
    let (it3, rvt) = instance_valtype(it, l.result);
    let fb: i32[] = async_functype(it3.b.append(1), l.param_names, vts, rvt);
    let eb: i32[] = wname(wcat(fb, [4, 0]), l.name);
    eb = eb.append(1);
    it = InstanceTypes { b: leb_u32(eb, it3.n), n: it3.n + 1 };
  }
  return wsection(7, wcat(leb_u32([1, 66], it.n + lowers.len()), it.b));
}

pub function comp_type_stream(vt: i32): i32[] {
  return wsection(7, [1, 102, 1, vt]);
}

pub function comp_import_instance(name: string, typeidx: i32): i32[] {
  let b: i32[] = wname([1, 0], name);
  b = b.append(5);
  b = leb_u32(b, typeidx);
  return wsection(10, b);
}

function comp_canon_lift_async(corefunc: i32, typeidx: i32): i32[] {
  let b: i32[] = [1, 0, 0];
  b = leb_u32(b, corefunc);
  b = b.append(1);
  b = b.append(6);
  b = leb_u32(b, typeidx);
  return wsection(8, b);
}

function comp_canon_typed(kind: i32, typeop: i32): i32[] {
  if (kind == 3) {
    return comp_canon_resource_drop(typeop);
  }
  if (kind == 4) {
    return comp_canon_task_return(typeop);
  }
  if (kind >= 11) {
    let ops: i32[] = [14, 19, 20];
    return wsection(8, leb_u32([1, ops[kind - 11]], typeop));
  }
  return wsection(8, [1, typeop]);
}

function trampolined(k: i32): boolean {
  return k == 1 || k == 2 || k >= 5 && k <= 7 || k == 9 || k == 10;
}

function lowers_realloc(k: i32): boolean {
  return k == 2 || k == 6;
}

pub function lowered_name(name: string): string {
  let pre: string = "[async-lower]";
  if (name.len() <= pre.len() || slice_unchecked(name, 0, pre.len()) != pre) {
    return name;
  }
  let bytes: u8[] = [];
  let i: i32 = pre.len();
  while (i < name.len()) {
    bytes = bytes.append(name[i]);
    i = i + 1;
  }
  return string_from_bytes_unchecked(bytes);
}

function suffix_memory_canon(o: i32[], k: i32, inst: i32, name: string, typeop: i32, n_cfunc: i32, realloc_f: i32): (i32[], i32) {
  if (k == 7) {
    return (wcat(o, wsection(8, [1, 32, 0, 0])), n_cfunc);
  }
  if (k == 9 || k == 10) {
    return (wcat(o, wsection(8, wcat(leb_u32([1, k + 6], typeop), [2, 6, 3, 0]))), n_cfunc);
  }
  o = wcat(o, comp_alias_inst_func(inst, lowered_name(name)));
  let opts: i32[] = [3, 0];
  let n_opts: i32 = 1;
  if (k == 5 || k == 6) {
    opts = [6, 3, 0];
    n_opts = 2;
  }
  if (lowers_realloc(k)) {
    opts = opts.append(4);
    opts = leb_u32(opts, realloc_f);
    n_opts = n_opts + 1;
  }
  let b: i32[] = [1, 1, 0];
  b = leb_u32(b, n_cfunc);
  b = leb_u32(b, n_opts);
  return (wcat(o, wsection(8, wcat(b, opts))), n_cfunc + 1);
}

function comp_export_one_func(name: string, funcidx: i32): i32[] {
  let b: i32[] = [1, 0];
  b = wname(b, name);
  b = b.append(1);
  b = leb_u32(b, funcidx);
  b = b.append(0);
  return wsection(11, b);
}

function suffix_group_find(order: string[], iface: string): i32 {
  let i: i32 = 0;
  while (i < order.len()) {
    if (order[i] == iface) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

struct SuffixWired { o: i32[], n_cfunc: i32, n_corefunc: i32, n_inst: i32, user_inst: i32 }

function component_suffix_wired(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_results: i32[][], imp_typeop: i32[], n_inst0: i32, user_mod: i32): SuffixWired {
  let n: i32 = imp_iface.len();
  let o: i32[] = [];
  let none: i32[] = [];
  let tramp_mod: i32[] = [];
  let fixup_mod: i32[] = [];
  let tramp_inst: i32[] = [];
  let tbl: i32[] = [];
  let coref: i32[] = [];
  let i: i32 = 0;
  while (i < n) {
    tramp_mod = tramp_mod.append(0);
    fixup_mod = fixup_mod.append(0);
    tramp_inst = tramp_inst.append(0);
    tbl = tbl.append(0);
    coref = coref.append(0);
    i = i + 1;
  }
  let n_mod: i32 = user_mod + 1;
  let n_cfunc: i32 = 0;
  let n_corefunc: i32 = 0;
  let n_coreinst: i32 = 0;
  let n_coretab: i32 = 0;
  let n_inst: i32 = n_inst0;
  i = 0;
  while (i < n) {
    if (trampolined(imp_kind[i])) {
      tramp_mod = tramp_mod.with(i, n_mod);
      n_mod = n_mod + 1;
      o = wcat(o, comp_core_module_section(shim_trampoline_core(imp_params[i], imp_results[i])));
      fixup_mod = fixup_mod.with(i, n_mod);
      n_mod = n_mod + 1;
      o = wcat(o, comp_core_module_section(shim_tablefill_core(imp_params[i], imp_results[i])));
    }
    i = i + 1;
  }
  i = 0;
  while (i < n) {
    if (trampolined(imp_kind[i])) {
      tramp_inst = tramp_inst.with(i, n_coreinst);
      n_coreinst = n_coreinst + 1;
      o = wcat(o, comp_core_instance_instantiate(tramp_mod[i]));
    }
    i = i + 1;
  }
  let order: string[] = [];
  let group_names: string[][] = [];
  let group_idxs: i32[][] = [];
  i = 0;
  while (i < n) {
    let k: i32 = imp_kind[i];
    let idx: i32 = 0;
    if (k == 0) {
      o = wcat(o, comp_alias_inst_func(imp_inst[i], imp_name[i]));
      let cf: i32 = n_cfunc;
      n_cfunc = n_cfunc + 1;
      idx = n_corefunc;
      o = wcat(o, comp_canon_lower_noopts(cf));
      n_corefunc = n_corefunc + 1;
    } else if (trampolined(k)) {
      idx = n_corefunc;
      o = wcat(o, comp_alias_core_func(tramp_inst[i], "0"));
      n_corefunc = n_corefunc + 1;
    } else {
      idx = n_corefunc;
      o = wcat(o, comp_canon_typed(k, imp_typeop[i]));
      n_corefunc = n_corefunc + 1;
    }
    let gi: i32 = suffix_group_find(order, imp_iface[i]);
    if (gi < 0) {
      order = order.append(imp_iface[i]);
      group_names = group_names.append([imp_name[i]]);
      group_idxs = group_idxs.append([idx]);
    } else {
      group_names = group_names.with(gi, group_names[gi].append(imp_name[i]));
      group_idxs = group_idxs.with(gi, group_idxs[gi].append(idx));
    }
    i = i + 1;
  }
  let arg_insts: i32[] = [];
  let g: i32 = 0;
  while (g < order.len()) {
    let gn: string[] = group_names[g];
    let gx: i32[] = group_idxs[g];
    let sorts: i32[] = [];
    let s: i32 = 0;
    while (s < gn.len()) {
      sorts = sorts.append(0);
      s = s + 1;
    }
    o = wcat(o, comp_core_instance_from_exports(gn, sorts, gx));
    arg_insts = arg_insts.append(n_coreinst);
    n_coreinst = n_coreinst + 1;
    g = g + 1;
  }
  let user_inst: i32 = n_coreinst;
  o = wcat(o, comp_core_instance_instantiate_args(user_mod, order, arg_insts));
  n_coreinst = n_coreinst + 1;
  let need_mem: boolean = false;
  let need_realloc: boolean = false;
  i = 0;
  while (i < n) {
    need_mem = need_mem || trampolined(imp_kind[i]);
    need_realloc = need_realloc || lowers_realloc(imp_kind[i]);
    i = i + 1;
  }
  if (need_mem) {
    o = wcat(o, comp_alias_core_export(2, user_inst, "memory"));
  }
  let realloc_f: i32 = 0;
  if (need_realloc) {
    realloc_f = n_corefunc;
    o = wcat(o, comp_alias_core_export(0, user_inst, "cabi_realloc"));
    n_corefunc = n_corefunc + 1;
  }
  i = 0;
  while (i < n) {
    if (trampolined(imp_kind[i])) {
      tbl = tbl.with(i, n_coretab);
      n_coretab = n_coretab + 1;
      o = wcat(o, comp_alias_core_export(1, tramp_inst[i], "$imports"));
    }
    i = i + 1;
  }
  i = 0;
  while (i < n) {
    if (trampolined(imp_kind[i])) {
      let (o2, nc) = suffix_memory_canon(o, imp_kind[i], imp_inst[i], imp_name[i], imp_typeop[i], n_cfunc, realloc_f);
      o = o2;
      n_cfunc = nc;
      coref = coref.with(i, n_corefunc);
      n_corefunc = n_corefunc + 1;
    }
    i = i + 1;
  }
  i = 0;
  while (i < n) {
    if (trampolined(imp_kind[i])) {
      let arg: i32 = n_coreinst;
      o = wcat(o, comp_core_instance_from_exports(["$imports", "0"], [1, 0], [tbl[i], coref[i]]));
      n_coreinst = n_coreinst + 1;
      o = wcat(o, comp_core_instance_instantiate_args(fixup_mod[i], [""], [arg]));
      n_coreinst = n_coreinst + 1;
    }
    i = i + 1;
  }
  return SuffixWired { o: o, n_cfunc: n_cfunc, n_corefunc: n_corefunc, n_inst: n_inst, user_inst: user_inst };
}

pub function component_suffix(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_results: i32[][], imp_typeop: i32[], n_type0: i32, n_inst0: i32, user_mod: i32, core_export: string, lifts: AsyncLift[]): i32[] {
  let w: SuffixWired = component_suffix_wired(imp_iface, imp_name, imp_kind, imp_inst, imp_params, imp_results, imp_typeop, n_inst0, user_mod);
  let o: i32[] = w.o;
  let run_core_f: i32 = w.n_corefunc;
  o = wcat(o, comp_alias_core_func(w.user_inst, core_export));
  o = wcat(o, comp_type_result_unit(n_type0));
  let lifted: i32 = w.n_cfunc;
  o = wcat(o, comp_canon_lift_noopts(run_core_f, n_type0 + 1));
  let run_inst: i32 = w.n_inst;
  o = wcat(o, comp_instance_one_func("run", lifted));
  o = wcat(o, comp_export_one_instance("wasi:cli/run@0.2.0", run_inst));
  let i: i32 = 0;
  while (i < lifts.len()) {
    o = wcat(o, comp_alias_core_func(w.user_inst, "[async-lift]" + lifts[i].core_name));
    o = wcat(o, comp_type_async_func(lifts[i]));
    o = wcat(o, comp_canon_lift_async(run_core_f + 1 + i, n_type0 + 2 + i));
    o = wcat(o, comp_export_one_func(lifts[i].name, lifted + 1 + 2 * i));
    i = i + 1;
  }
  return o;
}

pub function component_suffix_http(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_results: i32[][], imp_typeop: i32[], n_type0: i32, n_inst0: i32, user_mod: i32, req_t: i32, out_t: i32): i32[] {
  let w: SuffixWired = component_suffix_wired(imp_iface, imp_name, imp_kind, imp_inst, imp_params, imp_results, imp_typeop, n_inst0, user_mod);
  let o: i32[] = w.o;
  let handle_core_f: i32 = w.n_corefunc;
  o = wcat(o, comp_alias_core_func(w.user_inst, "wasi:http/incoming-handler@0.2.0#handle"));
  o = wcat(o, comp_type_own(req_t));
  o = wcat(o, comp_type_own(out_t));
  o = wcat(o, comp_type_handle_func(n_type0, n_type0 + 1));
  let lifted: i32 = w.n_cfunc;
  o = wcat(o, comp_canon_lift_noopts(handle_core_f, n_type0 + 2));
  let handler_inst: i32 = w.n_inst;
  o = wcat(o, comp_instance_one_func("handle", lifted));
  return wcat(o, comp_export_one_instance("wasi:http/incoming-handler@0.2.0", handler_inst));
}

function no_results(n: i32): i32[][] {
  let out: i32[][] = [];
  let none: i32[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(none);
    i = i + 1;
  }
  return out;
}

function component_suffix_io(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_typeop: i32[], n_type0: i32, n_inst0: i32, user_mod: i32, core_export: string): i32[] {
  let at: i32 = 0;
  let i: i32 = 0;
  while (i < imp_iface.len()) {
    if (imp_iface[i] == "wasi:io/streams@0.2.0") {
      at = i + 1;
    }
    i = i + 1;
  }
  let none: i32[] = [];
  let iface: string[] = [];
  let name: string[] = [];
  let kind: i32[] = [];
  let inst: i32[] = [];
  let params: i32[][] = [];
  let res: i32[] = [];
  i = 0;
  while (i <= imp_iface.len()) {
    if (i == at) {
      iface = iface.append("wasi:io/error@0.2.0");
      name = name.append("[resource-drop]error");
      kind = kind.append(3);
      inst = inst.append(0);
      params = params.append(none);
      res = res.append(1);
    }
    if (i < imp_iface.len()) {
      iface = iface.append(imp_iface[i]);
      name = name.append(imp_name[i]);
      kind = kind.append(imp_kind[i]);
      inst = inst.append(imp_inst[i]);
      params = params.append(imp_params[i]);
      res = res.append(imp_typeop[i]);
    }
    i = i + 1;
  }
  return component_suffix(iface, name, kind, inst, params, no_results(params.len()), res, n_type0, n_inst0, user_mod, core_export, []);
}

function blocking_write_name(): string {
  return "[method]output-stream.blocking-write-and-flush";
}

function component_suffix_stdout(): i32[] {
  let none: i32[] = [];
  return component_suffix_io(
    ["wasi:io/streams@0.2.0", "wasi:cli/stdout@0.2.0"],
    [blocking_write_name(), "get-stdout"],
    [1, 0],
    [1, 2],
    [[127, 127, 127, 127], none],
    [0, 0],
    5, 3, 0, "_lang_run",
  );
}

function component_suffix_eprint(): i32[] {
  let none: i32[] = [];
  return component_suffix_io(
    ["wasi:io/streams@0.2.0", "wasi:cli/stdout@0.2.0", "wasi:cli/stderr@0.2.0"],
    [blocking_write_name(), "get-stdout", "get-stderr"],
    [1, 0, 0],
    [1, 2, 3],
    [[127, 127, 127, 127], none, none],
    [0, 0, 0],
    6, 4, 0, "_lang_run",
  );
}

function component_suffix_exit(): i32[] {
  let none: i32[] = [];
  return component_suffix_io(
    ["wasi:io/streams@0.2.0", "wasi:cli/stdout@0.2.0", "wasi:cli/exit@0.2.0"],
    [blocking_write_name(), "get-stdout", "exit"],
    [1, 0, 0],
    [1, 2, 3],
    [[127, 127, 127, 127], none, none],
    [0, 0, 0],
    6, 4, 0, "_lang_run",
  );
}

function component_suffix_fs_read(): i32[] {
  let none: i32[] = [];
  return component_suffix_io(
    ["wasi:filesystem/preopens@0.2.0", "wasi:filesystem/types@0.2.0", "wasi:filesystem/types@0.2.0", "wasi:filesystem/types@0.2.0", "wasi:io/streams@0.2.0", "wasi:io/streams@0.2.0", "wasi:io/streams@0.2.0", "wasi:cli/stdout@0.2.0"],
    ["get-directories", "[method]descriptor.open-at", "[method]descriptor.read-via-stream", "[resource-drop]descriptor", blocking_write_name(), "[method]input-stream.blocking-read", "[resource-drop]input-stream", "get-stdout"],
