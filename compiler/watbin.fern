  if (op == "f32x4.extract_lane") {
    return 31;
  }
  if (op == "f32x4.replace_lane") {
    return 32;
  }
  if (op == "f32x4.eq") {
    return 65;
  }
  if (op == "f32x4.ne") {
    return 66;
  }
  if (op == "f32x4.lt") {
