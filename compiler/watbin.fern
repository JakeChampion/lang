function functype(params: i32[], results: i32[]): i32[] {
  let t: i32[] = [96];
  t = leb_u32(t, params.len());
  t = wcat(t, params);
  t = leb_u32(t, results.len());
  return wcat(t, results);
}

function shim_trampoline_core(params: i32[], results: i32[]): i32[] {
  let o: i32[] = [0, 97, 115, 109, 1, 0, 0, 0];
  o = wcat(o, wsection(1, wvec(1, functype(params, results))));
  o = wcat(o, wsection(3, [1, 0]));
  o = wcat(o, wsection(4, [1, 112, 1, 1, 1]));
  let ex: i32[] = [2];
  ex = wname(ex, "0");
  ex = ex.append(0);
  ex = ex.append(0);
  ex = wname(ex, "$imports");
  ex = ex.append(1);
  ex = ex.append(0);
  o = wcat(o, wsection(7, ex));
  let body: i32[] = [0];
  let k: i32 = 0;
  while (k < params.len()) {
    body = body.append(32);
    body = body.append(k);
    k = k + 1;
  }
  body = body.append(65);
  body = body.append(0);
  body = body.append(17);
  body = body.append(0);
  body = body.append(0);
  body = body.append(11);
  let fe: i32[] = [];
  fe = leb_u32(fe, body.len());
  fe = wcat(fe, body);
  return wcat(o, wsection(10, wvec(1, fe)));
}

function shim_tablefill_core(params: i32[], results: i32[]): i32[] {
  let o: i32[] = [0, 97, 115, 109, 1, 0, 0, 0];
  o = wcat(o, wsection(1, wvec(1, functype(params, results))));
  let im: i32[] = [2];
  im = im.append(0);
  im = wname(im, "0");
  im = im.append(0);
  im = im.append(0);
  im = im.append(0);
  im = wname(im, "$imports");
  im = im.append(1);
  im = im.append(112);
  im = im.append(1);
  im = im.append(1);
  im = im.append(1);
  o = wcat(o, wsection(2, im));
  return wcat(o, wsection(9, [1, 0, 65, 0, 11, 1, 0]));
}

