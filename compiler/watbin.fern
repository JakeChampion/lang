function type_block(body: string, rest: string): i32[] {
  return wcat(wsection(7, blob_to_bytes(body)), blob_to_bytes(rest));
}

pub function hex_to_bytes(s: string): i32[] {
  let o: i32[] = [];
  let i: i32 = 0;
  while (i + 1 < s.len()) {
    o = o.append(hexval(s[i] as i32) * 16 + hexval(s[i + 1] as i32));
    i = i + 2;
  }
  return o;
}

pub function blob_to_bytes(s: string): i32[] {
  let o: i32[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    o = o.append(s[i] as i32);
    i = i + 1;
  }
  return o;
}

