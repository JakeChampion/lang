function simd_has_memarg(op: string): boolean {
  return op == "v128.load" || op == "v128.store";
}

function simd_has_lane(op: string): boolean {
  return str_ends_with(op, ".extract_lane") || str_ends_with(op, ".replace_lane");
}

function str_ends_with(s: string, suffix: string): boolean {
  if (suffix.len() > s.len()) {
    return false;
  }
  return slice_unchecked(s, s.len() - suffix.len(), s.len()) == suffix;
}

function str_starts_with(s: string, prefix: string): boolean {
  if (prefix.len() > s.len()) {
    return false;
  }
  return slice_unchecked(s, 0, prefix.len()) == prefix;
}

function simd_lane_index(op: string, text: string): i32 {
  let lanes: i32 = 16;
  if (str_starts_with(op, "f64x2.") || str_starts_with(op, "i64x2.")) {
    lanes = 2;
  } else if (str_starts_with(op, "f32x4.") || str_starts_with(op, "i32x4.")) {
    lanes = 4;
  } else if (str_starts_with(op, "i16x8.")) {
    lanes = 8;
  }
  let idx: i32 = parse_dec(text);
  if (idx < 0 || idx >= lanes) {
    eprint("watbin: lane index out of range: " + op + " " + text);
    exit(1);
  }
  return idx;
}

function simd_arity(op: string): i32 {
  if (op == "v128.bitselect") {
    return 3;
  }
  if (op == "v128.store" || str_ends_with(op, ".replace_lane")) {
    return 2;
  }
  if (simd_binary_verb(op)) {
    return 2;
  }
  return 1;
}

function simd_binary_verb(op: string): boolean {
  return str_ends_with(op, ".add") || str_ends_with(op, ".sub") || str_ends_with(op, ".mul") || str_ends_with(op, ".div")
    || str_ends_with(op, ".min") || str_ends_with(op, ".max") || str_ends_with(op, ".pmin") || str_ends_with(op, ".pmax")
    || str_ends_with(op, ".eq") || str_ends_with(op, ".ne") || str_ends_with(op, ".lt") || str_ends_with(op, ".gt")
    || str_ends_with(op, ".le") || str_ends_with(op, ".ge")
    || str_ends_with(op, ".and") || str_ends_with(op, ".andnot") || str_ends_with(op, ".or") || str_ends_with(op, ".xor");
}

function bulk_mem_opcode(op: string): i32 {
  if (op == "memory.copy") {
    return 10;
  }
  if (op == "memory.fill") {
    return 11;
  }
  return 0 - 1;
}

function bulk_mem_tail(out: i32[], idx: i32): i32[] {
  let o: i32[] = leb_u32(out, idx);
  o = o.append(0);
  if (idx == 10) {
    o = o.append(0);
  }
  return o;
}

function is_offset_atom(n: SExpr): boolean {
  if (n.kind == 0) {
    return false;
  }
  if (n.text.len() < 7) {
    return false;
  }
  return slice_unchecked(n.text, 0, 7) == "offset=";
}

function offset_atom_value(n: SExpr): i32 {
  return parse_dec(slice_unchecked(n.text, 7, n.text.len()));
}

function memarg_align(op: string): i32 {
  if (op == "i32.load8_u" || op == "i32.load8_s" || op == "i32.store8") {
    return 0;
  }
  if (op == "i32.load16_u" || op == "i32.load16_s" || op == "i32.store16") {
    return 1;
  }
  if (op == "i64.load" || op == "f64.load" || op == "i64.store" || op == "f64.store") {
    return 3;
  }
  return 2;
}

function mem_load_opcode(op: string): i32 {
  if (op == "i32.load") {
    return 40;
  }
  if (op == "i64.load") {
    return 41;
  }
  if (op == "f32.load") {
    return 42;
  }
  if (op == "f64.load") {
    return 43;
  }
  if (op == "i32.load8_u") {
    return 45;
  }
  if (op == "i32.load8_s") {
    return 44;
  }
  if (op == "i32.load16_s") {
    return 46;
  }
  if (op == "i32.load16_u") {
    return 47;
  }
  return 0;
}

function mem_store_opcode(op: string): i32 {
  if (op == "i32.store") {
    return 54;
  }
  if (op == "i64.store") {
    return 55;
  }
  if (op == "f32.store") {
    return 56;
  }
  if (op == "f64.store") {
    return 57;
  }
  if (op == "i32.store8") {
    return 58;
  }
  if (op == "i32.store16") {
    return 59;
  }
  return 0;
}

function enc_instr(node: SExpr, lnames: string[], fnames: string[], gnames: string[], labels: string[], tnames: string[]): i32[] {
  let out: i32[] = [];
  let op: string = node.items[0].text;
  if (op == "i32.const") {
    out = out.append(65);
    return leb_i32(out, parse_dec(node.items[1].text));
  }
  if (op == "i64.const") {
    out = out.append(66);
    return leb_i64(out, parse_dec_i64(node.items[1].text));
  }
  if (op == "f64.const") {
    out = out.append(68);
    let bits: i64 = f64_bits(parse_f64(node.items[1].text));
    let k: i32 = 0;
    while (k < 8) {
      out = out.append((bits >> k * 8 & 255) as i32);
      k = k + 1;
    }
    return out;
  }
  if (op == "local.get") {
    out = out.append(32);
    return leb_u32(out, flat_idx(node.items[1].text, lnames));
  }
  if (op == "local.set") {
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(33);
    return leb_u32(out, flat_idx(node.items[1].text, lnames));
  }
  if (op == "local.tee") {
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(34);
    return leb_u32(out, flat_idx(node.items[1].text, lnames));
  }
  if (op == "global.get") {
    out = out.append(35);
    return leb_u32(out, name_idx(gnames, node.items[1].text));
  }
  if (op == "global.set") {
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(36);
    return leb_u32(out, name_idx(gnames, node.items[1].text));
  }
  if (op == "unreachable") {
    out = out.append(0);
    return out;
  }
  if (op == "return") {
    if (node.items.len() > 1) {
      out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    }
    out = out.append(15);
    return out;
  }
  if (op == "drop") {
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = out.append(26);
    return out;
  }
  if (op == "call") {
    let k: i32 = 2;
    while (k < node.items.len()) {
      out = wcat(out, enc_instr(node.items[k], lnames, fnames, gnames, labels, tnames));
      k = k + 1;
    }
    out = out.append(16);
    return leb_u32(out, name_idx(fnames, node.items[1].text));
  }
  if (op == "call_indirect") {
    let lasti: i32 = node.items.len() - 1;
    let k: i32 = 2;
    while (k < lasti) {
      out = wcat(out, enc_instr(node.items[k], lnames, fnames, gnames, labels, tnames));
      k = k + 1;
    }
    out = wcat(out, enc_instr(node.items[lasti], lnames, fnames, gnames, labels, tnames));
    out = out.append(17);
    out = leb_u32(out, name_idx(tnames, node.items[1].items[1].text));
    return leb_u32(out, 0);
  }
  if (op == "memory.size") {
    out = out.append(63);
    return out.append(0);
  }
  if (op == "memory.grow") {
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = out.append(64);
    return out.append(0);
  }
  if (op == "br") {
    out = out.append(12);
    return leb_u32(out, label_depth(labels, node.items[1].text));
  }
  if (op == "br_if") {
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(13);
    return leb_u32(out, label_depth(labels, node.items[1].text));
  }
  if (op == "block" || op == "loop") {
    let bi: i32 = 1;
    let label: string = "";
    if (node.items[1].kind == 2 && node.items[1].text[0] == b'$') {
      label = node.items[1].text;
      bi = 2;
    }
    let bt: i32 = 64;
    if (bi < node.items.len() && node_head(node.items[bi]) == "result") {
      bt = valtype_byte(node.items[bi].items[1].text);
      bi = bi + 1;
    }
    if (op == "block") {
      out = out.append(2);
    } else {
      out = out.append(3);
    }
    out = out.append(bt);
    let inner: string[] = labels_push(labels, label);
    while (bi < node.items.len()) {
      out = wcat(out, enc_instr(node.items[bi], lnames, fnames, gnames, inner, tnames));
      bi = bi + 1;
    }
    out = out.append(11);
    return out;
  }
  if (op == "if") {
    let ci: i32 = 1;
    let ibt: i32 = 64;
    if (node_head(node.items[1]) == "result") {
      ibt = valtype_byte(node.items[1].items[1].text);
      ci = 2;
    }
    out = wcat(out, enc_instr(node.items[ci], lnames, fnames, gnames, labels, tnames));
    out = out.append(4);
    out = out.append(ibt);
    let iinner: string[] = labels_push(labels, "");
    let thenN: SExpr = node.items[ci + 1];
    let tk: i32 = 1;
    while (tk < thenN.items.len()) {
      out = wcat(out, enc_instr(thenN.items[tk], lnames, fnames, gnames, iinner, tnames));
      tk = tk + 1;
    }
    if (node.items.len() > ci + 2 && node_head(node.items[ci + 2]) == "else") {
      out = out.append(5);
      let elseN: SExpr = node.items[ci + 2];
      let ek: i32 = 1;
      while (ek < elseN.items.len()) {
        out = wcat(out, enc_instr(elseN.items[ek], lnames, fnames, gnames, iinner, tnames));
        ek = ek + 1;
      }
    }
    out = out.append(11);
    return out;
  }
  let ml: i32 = mem_load_opcode(op);
  if (ml != 0) {
    let loff: i32 = 0;
    let lopnd: i32 = 1;
    if (node.items.len() > 2 && is_offset_atom(node.items[1])) {
      loff = offset_atom_value(node.items[1]);
      lopnd = 2;
    }
    out = wcat(out, enc_instr(node.items[lopnd], lnames, fnames, gnames, labels, tnames));
    out = out.append(ml);
    out = leb_u32(out, memarg_align(op));
    out = leb_u32(out, loff);
    return out;
  }
  let ms: i32 = mem_store_opcode(op);
  if (ms != 0) {
    let soff: i32 = 0;
    let sbase: i32 = 1;
    if (node.items.len() > 3 && is_offset_atom(node.items[1])) {
      soff = offset_atom_value(node.items[1]);
      sbase = 2;
    }
    out = wcat(out, enc_instr(node.items[sbase], lnames, fnames, gnames, labels, tnames));
    out = wcat(out, enc_instr(node.items[sbase + 1], lnames, fnames, gnames, labels, tnames));
    out = out.append(ms);
    out = leb_u32(out, memarg_align(op));
    out = leb_u32(out, soff);
    return out;
  }
  if (op == "select") {
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = wcat(out, enc_instr(node.items[3], lnames, fnames, gnames, labels, tnames));
    out = out.append(27);
    return out;
  }
  let stf: i32 = sat_trunc_opcode(op);
  if (stf >= 0) {
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = out.append(252);
    return leb_u32(out, stf);
  }
  let sop: i32 = simd_opcode(op);
  if (sop >= 0) {
    let sa: i32 = simd_arity(op);
    let first: i32 = 1;
    if (simd_has_lane(op)) {
      first = 2;
    }
    let sk: i32 = first;
    while (sk < first + sa) {
      out = wcat(out, enc_instr(node.items[sk], lnames, fnames, gnames, labels, tnames));
      sk = sk + 1;
    }
    out = out.append(253);
    out = leb_u32(out, sop);
    if (simd_has_memarg(op)) {
      out = leb_u32(out, 0);
      out = leb_u32(out, 0);
    }
    if (simd_has_lane(op)) {
      out = out.append(simd_lane_index(op, node.items[1].text));
    }
    return out;
  }
  let blk: i32 = bulk_mem_opcode(op);
  if (blk >= 0) {
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = wcat(out, enc_instr(node.items[3], lnames, fnames, gnames, labels, tnames));
    out = out.append(252);
    return bulk_mem_tail(out, blk);
  }
  let ao: i32 = arith_opcode(op);
  if (ao != 0) {
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    if (op != "i32.eqz" && node.items.len() > 2) {
      out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    }
    out = out.append(ao);
    return out;
  }
  if (op.len() > 0) {
    eprint("watbin: unknown instruction: " + op);
    exit(1);
  }
  return out;
}

function flat_idx(text: string, names: string[]): i32 {
  if (text.len() > 0 && text[0] == b'$') {
    return name_idx(names, text);
  }
  return parse_dec(text);
}

function enc_flat_body(instrs: SExpr[], lnames: string[], fnames: string[], gnames: string[], tnames: string[]): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < instrs.len()) {
    let op: string = instrs[i].text;
    if (op == "i32.const") {
      out = out.append(65);
      out = leb_i32(out, parse_dec(instrs[i + 1].text));
      i = i + 2;
    } else if (op == "i64.const") {
      out = out.append(66);
      out = leb_i64(out, parse_dec_i64(instrs[i + 1].text));
      i = i + 2;
    } else if (op == "f64.const") {
      out = out.append(68);
      let fbits: i64 = f64_bits(parse_f64(instrs[i + 1].text));
      let fk: i32 = 0;
      while (fk < 8) {
        out = out.append((fbits >> fk * 8 & 255) as i32);
        fk = fk + 1;
      }
      i = i + 2;
    } else if (op == "local.get") {
      out = out.append(32);
      out = leb_u32(out, flat_idx(instrs[i + 1].text, lnames));
      i = i + 2;
    } else if (op == "local.set") {
      out = out.append(33);
      out = leb_u32(out, flat_idx(instrs[i + 1].text, lnames));
      i = i + 2;
    } else if (op == "local.tee") {
      out = out.append(34);
      out = leb_u32(out, flat_idx(instrs[i + 1].text, lnames));
      i = i + 2;
    } else if (op == "global.get") {
      out = out.append(35);
      out = leb_u32(out, name_idx(gnames, instrs[i + 1].text));
      i = i + 2;
    } else if (op == "global.set") {
      out = out.append(36);
      out = leb_u32(out, name_idx(gnames, instrs[i + 1].text));
      i = i + 2;
    } else if (op == "call") {
      out = out.append(16);
      out = leb_u32(out, name_idx(fnames, instrs[i + 1].text));
      i = i + 2;
    } else if (op == "call_indirect") {
      out = out.append(17);
      out = leb_u32(out, name_idx(tnames, instrs[i + 1].items[1].text));
      out = leb_u32(out, 0);
      i = i + 2;
    } else if (op == "br") {
      out = out.append(12);
      out = leb_u32(out, parse_dec(instrs[i + 1].text));
      i = i + 2;
    } else if (op == "br_if") {
      out = out.append(13);
      out = leb_u32(out, parse_dec(instrs[i + 1].text));
      i = i + 2;
    } else if (op == "block" || op == "loop" || op == "if") {
      if (op == "block") {
        out = out.append(2);
      } else if (op == "loop") {
        out = out.append(3);
      } else {
        out = out.append(4);
      }
      let bt: i32 = 64;
      if (i + 1 < instrs.len() && node_head(instrs[i + 1]) == "result") {
        bt = valtype_byte(instrs[i + 1].items[1].text);
        i = i + 1;
      }
      out = out.append(bt);
      i = i + 1;
    } else if (op == "else") {
      out = out.append(5);
      i = i + 1;
    } else if (op == "end") {
      out = out.append(11);
      i = i + 1;
    } else if (op == "unreachable") {
      out = out.append(0);
      i = i + 1;
    } else if (op == "return") {
      out = out.append(15);
      i = i + 1;
    } else if (op == "drop") {
      out = out.append(26);
      i = i + 1;
    } else {
      let ml: i32 = mem_load_opcode(op);
      let ms: i32 = mem_store_opcode(op);
      let ao: i32 = arith_opcode(op);
      let stf: i32 = sat_trunc_opcode(op);
      let blk: i32 = bulk_mem_opcode(op);
      let sop: i32 = simd_opcode(op);
      if (ml != 0) {
        out = out.append(ml);
        out = leb_u32(out, memarg_align(op));
        out = leb_u32(out, 0);
      } else if (ms != 0) {
        out = out.append(ms);
        out = leb_u32(out, memarg_align(op));
        out = leb_u32(out, 0);
      } else if (sop >= 0) {
        out = out.append(253);
        out = leb_u32(out, sop);
        if (simd_has_memarg(op)) {
          out = leb_u32(out, 0);
          out = leb_u32(out, 0);
        }
        if (simd_has_lane(op)) {
          out = out.append(simd_lane_index(op, instrs[i + 1].text));
          i = i + 1;
        }
      } else if (stf >= 0) {
        out = out.append(252);
        out = leb_u32(out, stf);
      } else if (blk >= 0) {
        out = out.append(252);
        out = bulk_mem_tail(out, blk);
      } else if (ao != 0) {
        out = out.append(ao);
      } else if (op.len() > 0) {
        eprint("watbin: unknown instruction: " + op);
        exit(1);
      }
      i = i + 1;
    }
  }
  return out;
}

function enc_locals_vec(types: string[]): i32[] {
  let runs: i32 = 0;
  let i: i32 = 0;
  while (i < types.len()) {
    if (i == 0 || types[i] != types[i - 1]) {
      runs = runs + 1;
    }
    i = i + 1;
  }
  let body: i32[] = [];
  i = 0;
  while (i < types.len()) {
    let n: i32 = 1;
    while (i + n < types.len() && types[i + n] == types[i]) {
      n = n + 1;
    }
    body = leb_u32(body, n);
    body = body.append(valtype_byte(types[i]));
    i = i + n;
  }
  return wvec(runs, body);
}

function enc_functype(params: string[], results: string[]): i32[] {
  let o: i32[] = [];
  o = o.append(96);
  let pb: i32[] = [];
  let i: i32 = 0;
  while (i < params.len()) {
    pb = pb.append(valtype_byte(params[i]));
    i = i + 1;
  }
  o = wcat(o, wvec(params.len(), pb));
  let rb: i32[] = [];
  i = 0;
  while (i < results.len()) {
    rb = rb.append(valtype_byte(results[i]));
    i = i + 1;
  }
  o = wcat(o, wvec(results.len(), rb));
  return o;
}

function body_instrs(fnode: SExpr): SExpr[] {
  let out: SExpr[] = [];
  let i: i32 = func_header_end(fnode);
  while (i < fnode.items.len()) {
    out = out.append(fnode.items[i]);
    i = i + 1;
  }
  return out;
}

function emit_binary(mod: SExpr): i32[] {
  let fnames: string[] = collect_func_names(mod);
  let gnames: string[] = [];
  let gi: i32 = 0;
  while (gi < mod.items.len()) {
    if (node_head(mod.items[gi]) == "global") {
      gnames = gnames.append(mod.items[gi].items[1].text);
    }
    gi = gi + 1;
  }

  let importNodes: SExpr[] = [];
  let definedNodes: SExpr[] = [];
  let i: i32 = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "import") {
      importNodes = importNodes.append(mod.items[i]);
    }
    if (node_head(mod.items[i]) == "func") {
      definedNodes = definedNodes.append(mod.items[i]);
    }
    i = i + 1;
  }

  let tnames: string[] = [];
  let namedTypeBody: i32[] = [];
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "type") {
      let tn: SExpr = mod.items[i];
      tnames = tnames.append(tn.items[1].text);
      let tf: SExpr = tn.items[2];
      namedTypeBody = wcat(namedTypeBody, enc_functype(func_param_types(tf), func_result_types(tf)));
    }
    i = i + 1;
  }
  let ntypes: i32 = tnames.len();

  let nfuncs: i32 = importNodes.len() + definedNodes.len();
  let typeBody: i32[] = namedTypeBody;
  i = 0;
  while (i < importNodes.len()) {
    let fn: SExpr = func_node(importNodes[i]);
    typeBody = wcat(typeBody, enc_functype(func_param_types(fn), func_result_types(fn)));
    i = i + 1;
  }
  i = 0;
  while (i < definedNodes.len()) {
    typeBody = wcat(typeBody, enc_functype(func_param_types(definedNodes[i]), func_result_types(definedNodes[i])));
    i = i + 1;
  }

  let impBody: i32[] = [];
  i = 0;
  while (i < importNodes.len()) {
    let imp: SExpr = importNodes[i];
    impBody = wname(impBody, imp.items[1].text);
    impBody = wname(impBody, imp.items[2].text);
    impBody = impBody.append(0);
    impBody = leb_u32(impBody, ntypes + i);
    i = i + 1;
  }

  let funcBody: i32[] = [];
  i = 0;
  while (i < definedNodes.len()) {
    funcBody = leb_u32(funcBody, ntypes + importNodes.len() + i);
    i = i + 1;
  }

  let memBody: i32[] = [];
  let memCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "memory") {
      let mn: SExpr = mod.items[i];
      let minv: i32 = parse_dec(mn.items[mn.items.len() - 1].text);
      memBody = memBody.append(0);
      memBody = leb_u32(memBody, minv);
      memCount = memCount + 1;
    }
    i = i + 1;
  }

  let globBody: i32[] = [];
  let globCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "global") {
      let gn: SExpr = mod.items[i];
      globBody = globBody.append(valtype_byte(global_valtype(gn)));
      globBody = globBody.append(1);
      globBody = wcat(globBody, enc_instr(gn.items[gn.items.len() - 1], [], fnames, gnames, [], []));
      globBody = globBody.append(11);
      globCount = globCount + 1;
    }
    i = i + 1;
  }

  let expBody: i32[] = [];
  let expCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "memory") {
      let mm: SExpr = mod.items[i];
      let j: i32 = 1;
      while (j < mm.items.len()) {
        if (node_head(mm.items[j]) == "export") {
          expBody = wname(expBody, mm.items[j].items[1].text);
          expBody = expBody.append(2);
          expBody = leb_u32(expBody, 0);
          expCount = expCount + 1;
        }
        j = j + 1;
      }
    }
    if (node_head(mod.items[i]) == "export") {
      let ex: SExpr = mod.items[i];
      expBody = wname(expBody, ex.items[1].text);
      expBody = expBody.append(0);
      expBody = leb_u32(expBody, name_idx(fnames, ex.items[2].items[1].text));
      expCount = expCount + 1;
    }
    i = i + 1;
  }

  let codeBody: i32[] = [];
  i = 0;
  while (i < definedNodes.len()) {
    let fnode: SExpr = definedNodes[i];
    let lnames: string[] = local_names(fnode);
    let fbody: i32[] = enc_locals_vec(local_decl_types(fnode));
    let instrs: SExpr[] = body_instrs(fnode);
    if (instrs.len() > 0 && instrs[0].kind != 0) {
      fbody = wcat(fbody, enc_flat_body(instrs, lnames, fnames, gnames, tnames));
    } else {
      let k: i32 = 0;
      while (k < instrs.len()) {
        fbody = wcat(fbody, enc_instr(instrs[k], lnames, fnames, gnames, [], tnames));
        k = k + 1;
      }
    }
    fbody = fbody.append(11);
    codeBody = leb_u32(codeBody, fbody.len());
    codeBody = wcat(codeBody, fbody);
    i = i + 1;
  }

  let dataBody: i32[] = [];
  let dataCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "data") {
      let dn: SExpr = mod.items[i];
      dataBody = dataBody.append(0);
      dataBody = wcat(dataBody, enc_instr(dn.items[1], [], fnames, gnames, [], []));
      dataBody = dataBody.append(11);
      let bytes: i32[] = data_bytes(dn.items[2].text);
      dataBody = leb_u32(dataBody, bytes.len());
      dataBody = wcat(dataBody, bytes);
      dataCount = dataCount + 1;
    }
    i = i + 1;
  }

  let tableBody: i32[] = [];
  let tableCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "table") {
      let tbn: SExpr = mod.items[i];
      tableBody = tableBody.append(112);
      tableBody = tableBody.append(0);
      tableBody = leb_u32(tableBody, parse_dec(tbn.items[1].text));
      tableCount = tableCount + 1;
    }
    i = i + 1;
  }

  let elemBody: i32[] = [];
  let elemCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "elem") {
      let en: SExpr = mod.items[i];
      elemBody = elemBody.append(0);
      elemBody = wcat(elemBody, enc_instr(en.items[1], [], fnames, gnames, [], []));
      elemBody = elemBody.append(11);
      let fb: i32[] = [];
      let ei: i32 = 2;
      while (ei < en.items.len()) {
        fb = leb_u32(fb, name_idx(fnames, en.items[ei].text));
        ei = ei + 1;
      }
      elemBody = wcat(elemBody, wvec(en.items.len() - 2, fb));
      elemCount = elemCount + 1;
    }
    i = i + 1;
  }

  let out: i32[] = wmagic();
  out = wcat(out, wsection(1, wvec(ntypes + nfuncs, typeBody)));
  out = wcat(out, wsection(2, wvec(importNodes.len(), impBody)));
  out = wcat(out, wsection(3, wvec(definedNodes.len(), funcBody)));
  if (tableCount > 0) {
    out = wcat(out, wsection(4, wvec(tableCount, tableBody)));
  }
  if (memCount > 0) {
    out = wcat(out, wsection(5, wvec(memCount, memBody)));
  }
  if (globCount > 0) {
    out = wcat(out, wsection(6, wvec(globCount, globBody)));
  }
  if (expCount > 0) {
    out = wcat(out, wsection(7, wvec(expCount, expBody)));
  }
  if (elemCount > 0) {
    out = wcat(out, wsection(9, wvec(elemCount, elemBody)));
  }
  out = wcat(out, wsection(10, wvec(definedNodes.len(), codeBody)));
  if (dataCount > 0) {
    out = wcat(out, wsection(11, wvec(dataCount, dataBody)));
  }
  return out;
}

function func_sig(fn: SExpr): string {
  let o: string = "";
  let ps: string[] = func_param_types(fn);
  let i: i32 = 0;
  while (i < ps.len()) {
    o = o + ps[i] + ",";
    i = i + 1;
  }
  o = o + "->";
  let rs: string[] = func_result_types(fn);
  i = 0;
  while (i < rs.len()) {
    o = o + rs[i] + ",";
    i = i + 1;
  }
  return o;
}

function rename_atoms(n: SExpr, from: string[], to: string[]): SExpr {
  if (n.kind == 2) {
    let k: i32 = index_of_str(from, n.text);
    if (k >= 0) {
      return SExpr { kind: 2, text: to[k], items: [] };
    }
    return n;
  }
  if (n.kind != 0) {
    return n;
  }
  let out: SExpr[] = [];
  let i: i32 = 0;
  while (i < n.items.len()) {
    out = out.append(rename_atoms(n.items[i], from, to));
    i = i + 1;
  }
  return SExpr { kind: 0, text: n.text, items: out };
}

function merge_duplicate_imports(mod: SExpr): SExpr {
  let keep: SExpr[] = [];
  let seen_key: string[] = [];
  let seen_name: string[] = [];
  let from: string[] = [];
  let to: string[] = [];
  let i: i32 = 0;
  while (i < mod.items.len()) {
    let it: SExpr = mod.items[i];
    if (node_head(it) == "import" && it.items.len() == 4 && node_head(it.items[3]) == "func") {
      let fn: SExpr = func_node(it);
      let key: string = it.items[1].text + "\n" + it.items[2].text + "\n" + func_sig(fn);
      let k: i32 = index_of_str(seen_key, key);
      if (k >= 0) {
        from = from.append(func_name(fn));
        to = to.append(seen_name[k]);
        i = i + 1;
        continue;
      }
      seen_key = seen_key.append(key);
      seen_name = seen_name.append(func_name(fn));
    }
    keep = keep.append(it);
    i = i + 1;
  }
  if (from.len() == 0) {
    return mod;
  }
  return rename_atoms(SExpr { kind: mod.kind, text: mod.text, items: keep }, from, to);
}

pub function wat_to_binary(wat: string): i32[] {
  return emit_binary(merge_duplicate_imports(wat_parse(wat_tokenize(wat))));
}

pub function component_preamble(): i32[] {
  let o: i32[] = [];
  o = o.append(0);
  o = o.append(97);
  o = o.append(115);
  o = o.append(109);
  o = o.append(13);
  o = o.append(0);
  o = o.append(1);
  o = o.append(0);
  return o;
}

function component_wrap(core: i32[]): i32[] {
  let o: i32[] = component_preamble();
  return wcat(o, wsection(1, core));
}

pub function component_full(core: i32[]): i32[] {
  let o: i32[] = component_preamble();
  o = wcat(o, wsection(1, core));

  o = wcat(o, wsection(2, [1, 0, 0, 0]));

  let al: i32[] = [1, 0, 0, 1, 0];
  al = wname(al, "_lang_run");
  o = wcat(o, wsection(6, al));

  o = wcat(o, wsection(7, [2, 106, 0, 0, 64, 0, 0, 0]));

  o = wcat(o, wsection(8, [1, 0, 0, 0, 0, 1]));

  let inst: i32[] = [1, 1, 1, 0];
  inst = wname(inst, "run");
  inst = inst.append(1);
  inst = inst.append(0);
  o = wcat(o, wsection(5, inst));

  let ex: i32[] = [1, 0];
  ex = wname(ex, "wasi:cli/run@0.2.0");
  ex = ex.append(5);
  ex = ex.append(0);
  ex = ex.append(0);
  o = wcat(o, wsection(11, ex));

  return o;
}

function tb_io_error(): i32[] {
  return type_block("\x01B\x01\x04\x00\x05error\x03\x01", "\n\x18\x01\x00\x13wasi:io/error@0.2.0\x05\x00\x06\n\x01\x03\x00\x00\x05error");
}

function tb_io_streams_out(): i32[] {
  return type_block("\x01B\x0b\x04\x00\routput-stream\x03\x01\x02\x03\x02\x01\x01\x04\x00\x05error\x03\x00\x01\x01i\x02\x01q\x02\x15last-operation-failed\x01\x03\x00\x06closed\x00\x00\x04\x00\x0cstream-error\x03\x00\x04\x01h\x00\x01p}\x01j\x00\x01\x05\x01@\x02\x04self\x06\x08contents\x07\x00\x08\x04\x00.[method]output-stream.blocking-write-and-flush\x01\t", "\n\x1a\x01\x00\x15wasi:io/streams@0.2.0\x05\x02\x06\x12\x01\x03\x00\x01\routput-stream");
}

function tb_io_streams_inout(): i32[] {
