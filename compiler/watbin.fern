function functype(params: i32[], results: i32[]): i32[] {
  let t: i32[] = [96];
  t = leb_u32(t, params.len());
  t = util.append_all(t, params);
  t = leb_u32(t, results.len());
  return util.append_all(t, results);
}

function shim_trampoline_core(params: i32[], results: i32[]): i32[] {
  let o: i32[] = [0, 97, 115, 109, 1, 0, 0, 0];
  o = util.append_all(o, wsection(1, wvec(1, functype(params, results))));
  o = util.append_all(o, wsection(3, [1, 0]));
  o = util.append_all(o, wsection(4, [1, 112, 1, 1, 1]));
  let ex: i32[] = [2];
  ex = wname(ex, "0");
  ex = ex.append(0);
  ex = ex.append(0);
  ex = wname(ex, "$imports");
  ex = ex.append(1);
  ex = ex.append(0);
  o = util.append_all(o, wsection(7, ex));
  let body: i32[] = [0];
  for k in 0..params.len() {
    body = body.append(32);
    body = body.append(k);
  }
  body = body.append(65);
  body = body.append(0);
  body = body.append(17);
  body = body.append(0);
  body = body.append(0);
  body = body.append(11);
  let fe: i32[] = [];
  fe = leb_u32(fe, body.len());
  fe = util.append_all(fe, body);
  return util.append_all(o, wsection(10, wvec(1, fe)));
}

function shim_tablefill_core(params: i32[], results: i32[]): i32[] {
  let o: i32[] = [0, 97, 115, 109, 1, 0, 0, 0];
  o = util.append_all(o, wsection(1, wvec(1, functype(params, results))));
  let im: i32[] = [2];
  im = im.append(0);
  im = wname(im, "0");
  im = im.append(0);
  im = im.append(0);
  im = im.append(0);
  im = wname(im, "$imports");
  im = im.append(1);
  im = im.append(112);
  im = im.append(1);
  im = im.append(1);
  im = im.append(1);
  o = util.append_all(o, wsection(2, im));
  return util.append_all(o, wsection(9, [1, 0, 65, 0, 11, 1, 0]));
}

pub function comp_core_module_section(mod: i32[]): i32[] {
