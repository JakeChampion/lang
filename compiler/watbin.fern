import "./util";
import "std/string";

function leb128_mask25(): i32 {
  return 33554431;
}

pub function leb_u32(buf: i32[], value: i32): i32[] {
  let v = value;
  let more = true;
  while (more) {
    let b = v & 127;
    v = v >> 7 & leb128_mask25();
    if (v == 0) {
      more = false;
    } else {
      b = b | 128;
    }
    buf = buf.append(b);
  }
  return buf;
}

pub function leb_i32(buf: i32[], value: i32): i32[] {
  let v = value;
  let more = true;
  while (more) {
    let b = v & 127;
    v = v >> 7;
    let sign = b & 64;
    if (v == 0 && sign == 0 || v == -1 && sign != 0) {
      more = false;
    } else {
      b = b | 128;
    }
    buf = buf.append(b);
  }
  return buf;
}

function leb_i64(buf: i32[], value: i64): i32[] {
  let v = value;
  let more = true;
  while (more) {
    let b = (v & 127) as i32;
    v = v >> 7;
    let sign = b & 64;
    if (v == 0 && sign == 0 || v == -1 && sign != 0) {
      more = false;
    } else {
      b = b | 128;
    }
    buf = buf.append(b);
  }
  return buf;
}

pub struct WatTok { kind: i32, text: string }

function wat_is_space(c: i32): boolean {
  return c == 32 || c == 9 || c == 10 || c == 13;
}

function wat_tokenize(src: string): WatTok[] {
  let toks: WatTok[] = [];
  let i = 0;
  let n = src.len();
  while (i < n) {
    let c = src[i] as i32;
    if (wat_is_space(c)) {
      i += 1;
    } else if (c == 40) {
      toks = toks.append(WatTok { kind: 0, text: "(" });
      i += 1;
    } else if (c == 41) {
      toks = toks.append(WatTok { kind: 1, text: ")" });
      i += 1;
    } else if (c == 34) {
      let start = i + 1;
      let j = start;
      while (j < n && src[j] != b'"') {
        if (src[j] == b'\\') {
          j += 2;
        } else {
          j += 1;
        }
      }
      toks = toks.append(WatTok { kind: 3, text: slice_unchecked(src, start, j).to_owned() });
      i = j + 1;
    } else {
      let astart = i;
      while (i < n) {
        let ch = src[i] as i32;
        if (wat_is_space(ch) || ch == 40 || ch == 41 || ch == 34) {
          break;
        }
        i += 1;
      }
      toks = toks.append(WatTok { kind: 2, text: slice_unchecked(src, astart, i).to_owned() });
    }
  }
  return toks;
}

pub struct SExpr { kind: i32, text: string, items: SExpr[] }

pub struct ParseOne { node: SExpr, pos: i32 }

function wat_parse_one(toks: WatTok[], i: i32): ParseOne {
  let t = toks[i];
  if (t.kind != 0) {
    return ParseOne { node: SExpr { kind: t.kind, text: t.text, items: [] }, pos: i + 1 };
  }
  let children: SExpr[] = [];
  let j = i + 1;
  while (j < toks.len() && toks[j].kind != 1) {
    let r = wat_parse_one(toks, j);
    children = children.append(r.node);
    j = r.pos;
  }
  return ParseOne { node: SExpr { kind: 0, text: "", items: children }, pos: j + 1 };
}

function wat_parse(toks: WatTok[]): SExpr {
  let r = wat_parse_one(toks, 0);
  return r.node;
}

function wstr_bytes(buf: i32[], s: string): i32[] {
  let i = 0;
  while (i < s.len()) {
    buf = buf.append(s[i] as i32);
    i += 1;
  }
  return buf;
}

pub function wname(buf: i32[], s: string): i32[] {
  buf = leb_u32(buf, s.len());
  return wstr_bytes(buf, s);
}

pub function wsection(id: i32, contents: i32[]): i32[] {
  let o: i32[] = [];
  o = o.append(id);
  o = leb_u32(o, contents.len());
  return util.append_all(o, contents);
}

function wvec(count: i32, elems: i32[]): i32[] {
  let o: i32[] = [];
  o = leb_u32(o, count);
  return util.append_all(o, elems);
}

function global_valtype(gn: SExpr): string {
  if (gn.items.len() < 3) {
    return "i32";
  }
  let ty = gn.items[2];
  if (ty.kind == 2) {
    return ty.text;
  }
  if (node_head(ty) == "mut" && ty.items.len() > 1 && ty.items[1].kind == 2) {
    return ty.items[1].text;
  }
  return "i32";
}

function valtype_byte(t: string): i32 {
  return match (t) {
    "i32" => 127,
    "i64" => 126,
    "f32" => 125,
    "f64" => 124,
    "funcref" => 112,
    "v128" => 123,
    _ => 127,
  };
}

function wmagic(): i32[] {
  let o: i32[] = [];
  o = o.append(0);
  o = o.append(97);
  o = o.append(115);
  o = o.append(109);
  o = o.append(1);
  o = o.append(0);
  o = o.append(0);
  o = o.append(0);
  return o;
}

function name_idx(names: util.NameIndex, n: string): i32 {
  let k = names.find(n);
  if (k < 0) {
    eprint("watbin: reference to undefined " + n);
    exit(1);
  }
  return k;
}

function node_head(n: SExpr): string {
  if (n.kind == 0 && n.items.len() > 0 && n.items[0].kind == 2) {
    return n.items[0].text;
  }
  return "";
}

function parse_dec(s: string): i32 {
  let n = parse_integer(s);
  if (n.magnitude > 4294967295) {
    bad_number(s);
  }
  let v = n.magnitude as i32;
  if (n.neg) {
    return -v;
  }
  return v;
}

function parse_dec_i64(s: string): i64 {
  let n = parse_integer(s);
  let v = n.magnitude as i64;
  if (n.neg) {
    return 0i64 - v;
  }
  return v;
}

struct Integer { neg: boolean, magnitude: u64 }

// The magnitude wraps nothing: a digit outside the base or a value past
// u64 stops the build, so a bad immediate cannot become a wrong one.
function parse_integer(s: string): Integer {
  let neg = false;
  let i = 0;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  } else if (s.len() > 0 && s[0] == b'+') {
    i = 1;
  }
  let base: u64 = 10;
  if (s.len() > i + 2 && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
    base = 16;
    i += 2;
  }
  let limit: u64 = 18446744073709551615;
  let v: u64 = 0;
  let digits = 0;
  while (i < s.len()) {
    if (s[i] != b'_') {
      let Some(d) = digit_value(s[i] as i32, base as i32) else {
        bad_number(s);
        return Integer { neg: neg, magnitude: 0 };
      };
      let du = d as u64;
      if (v > (limit - du) / base) {
        bad_number(s);
      }
      v = v * base + du;
      digits += 1;
    }
    i += 1;
  }
  if (digits == 0) {
    bad_number(s);
  }
  return Integer { neg: neg, magnitude: v };
}

function bad_number(s: string): void {
  eprint("watbin: bad integer \"" + s + "\"");
  exit(1);
}

function hex_at(s: string, i: i32): i32 {
  if let Some(d) = digit_value(s[i] as i32, 16) {
    return d;
  }
  eprint("watbin: bad hex escape in \"" + s + "\"");
  exit(1);
  return 0;
}

function digit_value(c: i32, base: i32): Option[i32] {
  let d = base;
  if (c >= b'0' as i32 && c <= b'9' as i32) {
    d = c - b'0' as i32;
  } else if (c >= b'a' as i32 && c <= b'f' as i32) {
    d = c - b'a' as i32 + 10;
  } else if (c >= b'A' as i32 && c <= b'F' as i32) {
    d = c - b'A' as i32 + 10;
  }
  if (d >= base) {
    return None;
  }
  return Some(d);
}

function data_bytes(s: string): i32[] {
  let out: i32[] = [];
  let i = 0;
  while (i < s.len()) {
    let c = s[i] as i32;
    if (c == 92 && i + 1 < s.len()) {
      let n = s[i + 1] as i32;
      if (n == 110) {
        out = out.append(10);
        i += 2;
      } else if (n == 116) {
        out = out.append(9);
        i += 2;
      } else if (n == 92) {
        out = out.append(92);
        i += 2;
      } else if (n == 34) {
        out = out.append(34);
        i += 2;
      } else if (i + 2 < s.len()) {
        out = out.append(hex_at(s, i + 1) * 16 + hex_at(s, i + 2));
        i += 3;
      } else {
        out = out.append(c);
        i += 1;
      }
    } else {
      out = out.append(c);
      i += 1;
    }
  }
  return out;
}

function func_node(child: SExpr): SExpr {
  if (node_head(child) == "import") {
    return child.items[child.items.len() - 1];
  }
  return child;
}

function func_name(fnode: SExpr): string {
  return fnode.items[1].text;
}

function collect_func_names(mod: SExpr): string[] {
  let names: string[] = [];
  let i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "import") {
      names = names.append(func_name(func_node(mod.items[i])));
    }
    i += 1;
  }
  for i in 0..mod.items.len() {
    if (node_head(mod.items[i]) == "func") {
      names = names.append(func_name(mod.items[i]));
    }
  }
  return names;
}

function func_header_end(fnode: SExpr): i32 {
  for i in 2..fnode.items.len() {
    let h = node_head(fnode.items[i]);
    if (h != "param" && h != "result" && h != "local") {
      return i;
    }
  }
  return fnode.items.len();
}

function func_param_types(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop = func_header_end(fnode);
  for i in 1..stop {
    let c = fnode.items[i];
    if (node_head(c) == "param") {
      if (c.items.len() >= 2 && c.items[1].text[0] == b'$') {
        out = out.append(c.items[2].text);
      } else {
        for j in 1..c.items.len() {
          out = out.append(c.items[j].text);
        }
      }
    }
  }
  return out;
}

function func_result_types(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop = func_header_end(fnode);
  for i in 1..stop {
    let c = fnode.items[i];
    if (node_head(c) == "result") {
      for j in 1..c.items.len() {
        out = out.append(c.items[j].text);
      }
    }
  }
  return out;
}

function local_names(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop = func_header_end(fnode);
  let i = 2;
  while (i < stop) {
    if (node_head(fnode.items[i]) == "param") {
      out = add_slot_names(out, fnode.items[i]);
    }
    i += 1;
  }
  for i in 2..stop {
    if (node_head(fnode.items[i]) == "local") {
      out = add_slot_names(out, fnode.items[i]);
    }
  }
  return out;
}

function add_slot_names(out: string[], c: SExpr): string[] {
  if (c.items.len() >= 2 && c.items[1].text.len() > 0 && c.items[1].text[0] == b'$') {
    return out.append(c.items[1].text);
  }
  for k in 1..c.items.len() {
    out = out.append("");
  }
  return out;
}

function local_decl_types(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop = func_header_end(fnode);
  for i in 2..stop {
    let c = fnode.items[i];
    if (node_head(c) == "local") {
      if (c.items.len() >= 3 && c.items[1].text.len() > 0 && c.items[1].text[0] == b'$') {
        out = out.append(c.items[2].text);
      } else {
        for k in 1..c.items.len() {
          out = out.append(c.items[k].text);
        }
      }
    }
  }
  return out;
}

