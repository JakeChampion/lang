function tb_fswrite_random_tail(): i32[] {
  return type_block("\x01B\x02\x01@\x00\x00w\x04\x00\x0eget-random-u64\x01\x00", "\n\x1d\x01\x00\x18wasi:random/random@0.2.0\x05\x08");
}

function type_block(body: string, rest: string): i32[] {
  return util.append_all(wsection(7, blob_to_bytes(body)), blob_to_bytes(rest));
}

pub function hex_to_bytes(s: string): i32[] {
  let o: i32[] = [];
  let i = 0;
  while (i + 1 < s.len()) {
    o = o.append(hex_at(s, i) * 16 + hex_at(s, i + 1));
    i += 2;
  }
  return o;
}

pub function blob_to_bytes(s: string): i32[] {
  let o: i32[] = [];
  for i in 0..s.len() {
    o = o.append(s[i] as i32);
  }
  return o;
}

