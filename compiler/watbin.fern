function shuffle_digits(text: string, start: i32, radix: i32): Option[i32] {
  let value = 0;
  let previous_digit = false;
  for i in start..text.len() {
    if (text[i] == b'_') {
      if (!previous_digit) {
        return None;
      }
      previous_digit = false;
      continue;
    }
    let Some(digit) = digit_value(text[i] as i32, radix) else {
      return None;
    };
    value = value * radix + digit;
    if (value > 31) {
      return None;
    }
    previous_digit = true;
  }
  return if (previous_digit) { Some(value) } else { None };
}

function shuffle_index(text: string): Option[i32] {
  if (text.len() == 0) {
    return None;
  }
  let start = if (text[0] == b'+') { 1 } else { 0 };
  let radix = 10;
  if (text.len() > start + 1 && text[start] == b'0' && text[start + 1] == b'x') {
    start += 2;
    radix = 16;
  }
  return shuffle_digits(text, start, radix);
}

function shuffle_indices(own out: i32[], nodes: SExpr[], start: i32): i32[] {
  if (start < 0 || start + 16 > nodes.len()) {
    eprint("watbin: shuffle requires 16 byte indices");
    exit(1);
  }
  for i in start..start + 16 {
    let Some(index) = shuffle_index(nodes[i].text) else {
      eprint("watbin: shuffle byte index must be from 0 to 31");
      exit(1);
      return out;
    };
    out = out.append(index);
  }
  return out;
}

function simd_has_memarg(op: string): boolean {
  return op == "v128.load" || op == "v128.store";
}

function simd_has_lane(op: string): boolean {
  return op.ends_with(".extract_lane") || op.ends_with(".replace_lane");
}

function simd_lane_index(op: string, text: string): i32 {
  let lanes = 16;
  if (op.starts_with("f64x2.") || op.starts_with("i64x2.")) {
    lanes = 2;
  } else if (op.starts_with("f32x4.") || op.starts_with("i32x4.")) {
    lanes = 4;
  } else if (op.starts_with("i16x8.")) {
    lanes = 8;
  }
  let idx = parse_dec(text);
  if (idx < 0 || idx >= lanes) {
    eprint("watbin: lane index out of range: " + op + " " + text);
    exit(1);
  }
  return idx;
}

function simd_arity(op: string): i32 {
  if (op == "i8x16.shuffle") {
    return 2;
  }
  if (op == "v128.bitselect") {
    return 3;
  }
  if (op == "v128.store" || op.ends_with(".replace_lane")) {
    return 2;
  }
  if (simd_binary_verb(op)) {
    return 2;
  }
  return 1;
}

function simd_binary_verb(op: string): boolean {
  return op.ends_with(".add") || op.ends_with(".sub") || op.ends_with(".mul") || op.ends_with(".div")
    || op.ends_with(".min") || op.ends_with(".max") || op.ends_with(".pmin") || op.ends_with(".pmax")
    || op.ends_with(".eq") || op.ends_with(".ne") || op.ends_with(".lt") || op.ends_with(".gt") || op.ends_with(".lt_s")
    || op.ends_with(".le") || op.ends_with(".ge")
    || op.ends_with(".and") || op.ends_with(".andnot") || op.ends_with(".or") || op.ends_with(".xor");
}

function bulk_mem_opcode(op: string): i32 {
  if (op == "memory.copy") {
    return 10;
  }
  if (op == "memory.fill") {
    return 11;
  }
  return -1;
}

function bulk_mem_tail(out: i32[], idx: i32): i32[] {
  let o = leb_u32(out, idx);
  o = o.append(0);
  if (idx == 10) {
    o = o.append(0);
  }
  return o;
}

function is_offset_atom(n: SExpr): boolean {
  if (n.kind == 0) {
    return false;
  }
  if (n.text.len() < 7) {
    return false;
  }
  return n.text.starts_with("offset=");
}

function offset_atom_value(n: SExpr): i32 {
  return parse_dec(slice_unchecked(n.text, 7, n.text.len()));
}

function memarg_align(op: string): i32 {
  if (op == "i32.load8_u" || op == "i32.load8_s" || op == "i32.store8") {
    return 0;
  }
  if (op == "i32.load16_u" || op == "i32.load16_s" || op == "i32.store16") {
    return 1;
  }
  if (op == "i64.load" || op == "f64.load" || op == "i64.store" || op == "f64.store") {
    return 3;
  }
  return 2;
}

function mem_load_opcode(op: string): i32 {
  return match (op) {
    "i32.load" => 40,
    "i64.load" => 41,
    "f32.load" => 42,
    "f64.load" => 43,
    "i32.load8_u" => 45,
    "i32.load8_s" => 44,
    "i32.load16_s" => 46,
    "i32.load16_u" => 47,
    _ => 0,
  };
}

function mem_store_opcode(op: string): i32 {
  return match (op) {
    "i32.store" => 54,
    "i64.store" => 55,
    "f32.store" => 56,
    "f64.store" => 57,
    "i32.store8" => 58,
    "i32.store16" => 59,
    _ => 0,
  };
}

function enc_instr(node: SExpr, lnames: util.NameIndex, fnames: util.NameIndex, gnames: util.NameIndex, labels: string[], tnames: util.NameIndex): i32[] {
  let out: i32[] = [];
  let op = node.items[0].text;
  if (op == "i32.const") {
    out = out.append(65);
    return leb_i32(out, parse_dec(node.items[1].text));
  }
  if (op == "i64.const") {
    out = out.append(66);
    return leb_i64(out, parse_dec_i64(node.items[1].text));
  }
  if (op == "f64.const") {
    out = out.append(68);
    let bits = util.parse_f64_bits(node.items[1].text);
    let k: i32 = 0;
    while (k < 8) {
      out = out.append((bits >> k * 8 & 255) as i32);
      k += 1;
    }
    return out;
  }
  if (op == "local.get") {
    out = out.append(32);
    return leb_u32(out, flat_idx(node.items[1].text, lnames));
  }
  if (op == "local.set") {
    out = util.append_all(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(33);
    return leb_u32(out, flat_idx(node.items[1].text, lnames));
  }
  if (op == "local.tee") {
    out = util.append_all(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(34);
    return leb_u32(out, flat_idx(node.items[1].text, lnames));
  }
  if (op == "global.get") {
    out = out.append(35);
    return leb_u32(out, name_idx(gnames, node.items[1].text));
  }
  if (op == "global.set") {
    out = util.append_all(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(36);
    return leb_u32(out, name_idx(gnames, node.items[1].text));
  }
  if (op == "unreachable") {
    out = out.append(0);
    return out;
  }
  if (op == "return") {
    if (node.items.len() > 1) {
      out = util.append_all(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    }
    out = out.append(15);
    return out;
  }
  if (op == "drop") {
    out = util.append_all(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = out.append(26);
    return out;
  }
  if (op == "call") {
    let k = 2;
    while (k < node.items.len()) {
      out = util.append_all(out, enc_instr(node.items[k], lnames, fnames, gnames, labels, tnames));
      k += 1;
    }
    out = out.append(16);
    return leb_u32(out, name_idx(fnames, node.items[1].text));
  }
  if (op == "call_indirect") {
    let lasti = node.items.len() - 1;
    for k in 2..lasti {
      out = util.append_all(out, enc_instr(node.items[k], lnames, fnames, gnames, labels, tnames));
    }
    out = util.append_all(out, enc_instr(node.items[lasti], lnames, fnames, gnames, labels, tnames));
    out = out.append(17);
    out = leb_u32(out, name_idx(tnames, node.items[1].items[1].text));
    return leb_u32(out, 0);
  }
  if (op == "memory.size") {
    out = out.append(63);
    return out.append(0);
  }
  if (op == "memory.grow") {
    out = util.append_all(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = out.append(64);
    return out.append(0);
  }
  if (op == "br") {
    out = out.append(12);
    return leb_u32(out, label_depth(labels, node.items[1].text));
  }
  if (op == "br_if") {
    out = util.append_all(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(13);
    return leb_u32(out, label_depth(labels, node.items[1].text));
  }
  if (op == "block" || op == "loop") {
    let bi = 1;
    let label = "";
    if (node.items[1].kind == 2 && node.items[1].text[0] == b'$') {
      label = node.items[1].text;
      bi = 2;
    }
    let bt = 64;
    if (bi < node.items.len() && node_head(node.items[bi]) == "result") {
      bt = valtype_byte(node.items[bi].items[1].text);
      bi += 1;
    }
    if (op == "block") {
      out = out.append(2);
    } else {
      out = out.append(3);
    }
    out = out.append(bt);
    let inner = labels_push(labels, label);
    while (bi < node.items.len()) {
      out = util.append_all(out, enc_instr(node.items[bi], lnames, fnames, gnames, inner, tnames));
      bi += 1;
    }
    out = out.append(11);
    return out;
  }
  if (op == "if") {
    let ci = 1;
    let ibt = 64;
    if (node_head(node.items[1]) == "result") {
      ibt = valtype_byte(node.items[1].items[1].text);
      ci = 2;
    }
    out = util.append_all(out, enc_instr(node.items[ci], lnames, fnames, gnames, labels, tnames));
    out = out.append(4);
    out = out.append(ibt);
    let iinner = labels_push(labels, "");
    let thenN = node.items[ci + 1];
    for tk in 1..thenN.items.len() {
      out = util.append_all(out, enc_instr(thenN.items[tk], lnames, fnames, gnames, iinner, tnames));
    }
    if (node.items.len() > ci + 2 && node_head(node.items[ci + 2]) == "else") {
      out = out.append(5);
      let elseN = node.items[ci + 2];
      for ek in 1..elseN.items.len() {
        out = util.append_all(out, enc_instr(elseN.items[ek], lnames, fnames, gnames, iinner, tnames));
      }
    }
    out = out.append(11);
    return out;
  }
  let ml = mem_load_opcode(op);
  if (ml != 0) {
    let loff = 0;
    let lopnd = 1;
    if (node.items.len() > 2 && is_offset_atom(node.items[1])) {
      loff = offset_atom_value(node.items[1]);
      lopnd = 2;
    }
    out = util.append_all(out, enc_instr(node.items[lopnd], lnames, fnames, gnames, labels, tnames));
    out = out.append(ml);
    out = leb_u32(out, memarg_align(op));
    out = leb_u32(out, loff);
    return out;
  }
  let ms = mem_store_opcode(op);
  if (ms != 0) {
    let soff = 0;
    let sbase = 1;
    if (node.items.len() > 3 && is_offset_atom(node.items[1])) {
      soff = offset_atom_value(node.items[1]);
      sbase = 2;
    }
    out = util.append_all(out, enc_instr(node.items[sbase], lnames, fnames, gnames, labels, tnames));
    out = util.append_all(out, enc_instr(node.items[sbase + 1], lnames, fnames, gnames, labels, tnames));
    out = out.append(ms);
    out = leb_u32(out, memarg_align(op));
    out = leb_u32(out, soff);
    return out;
  }
  if (op == "select") {
    out = util.append_all(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = util.append_all(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = util.append_all(out, enc_instr(node.items[3], lnames, fnames, gnames, labels, tnames));
    out = out.append(27);
    return out;
  }
  let stf = sat_trunc_opcode(op);
  if (stf >= 0) {
    out = util.append_all(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = out.append(252);
    return leb_u32(out, stf);
  }
  let sop = simd_opcode(op);
  if (sop >= 0) {
    let sa = simd_arity(op);
    let first = 1;
    if (simd_has_lane(op)) {
      first = 2;
    }
    if (op == "i8x16.shuffle") {
      first = 17;
    }
    for sk in first..first + sa {
      out = util.append_all(out, enc_instr(node.items[sk], lnames, fnames, gnames, labels, tnames));
    }
    out = out.append(253);
    out = leb_u32(out, sop);
    if (op == "i8x16.shuffle") {
      out = shuffle_indices(out, node.items, 1);
    }
    if (simd_has_memarg(op)) {
      out = leb_u32(out, 0);
      out = leb_u32(out, 0);
    }
    if (simd_has_lane(op)) {
      out = out.append(simd_lane_index(op, node.items[1].text));
    }
    return out;
  }
  let blk = bulk_mem_opcode(op);
  if (blk >= 0) {
    out = util.append_all(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = util.append_all(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = util.append_all(out, enc_instr(node.items[3], lnames, fnames, gnames, labels, tnames));
    out = out.append(252);
    return bulk_mem_tail(out, blk);
  }
  let ao = arith_opcode(op);
  if (ao != 0) {
    out = util.append_all(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    if (op != "i32.eqz" && node.items.len() > 2) {
      out = util.append_all(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    }
    out = out.append(ao);
    return out;
  }
  if (op.len() > 0) {
    eprint("watbin: unknown instruction: " + op);
    exit(1);
  }
  return out;
}

function flat_idx(text: string, names: util.NameIndex): i32 {
  if (text.len() > 0 && text[0] == b'$') {
    return name_idx(names, text);
  }
  return parse_dec(text);
}

function enc_flat_body(instrs: SExpr[], lnames: util.NameIndex, fnames: util.NameIndex, gnames: util.NameIndex, tnames: util.NameIndex): i32[] {
  let out: i32[] = [];
  let i = 0;
  while (i < instrs.len()) {
    let op = instrs[i].text;
    if (op == "i32.const") {
      out = out.append(65);
      out = leb_i32(out, parse_dec(instrs[i + 1].text));
      i += 2;
    } else if (op == "i64.const") {
      out = out.append(66);
      out = leb_i64(out, parse_dec_i64(instrs[i + 1].text));
      i += 2;
    } else if (op == "f64.const") {
      out = out.append(68);
      let fbits = util.parse_f64_bits(instrs[i + 1].text);
      for fk in 0..8 {
        out = out.append((fbits >> fk * 8 & 255) as i32);
      }
      i += 2;
    } else if (op == "local.get") {
      out = out.append(32);
      out = leb_u32(out, flat_idx(instrs[i + 1].text, lnames));
      i += 2;
    } else if (op == "local.set") {
      out = out.append(33);
      out = leb_u32(out, flat_idx(instrs[i + 1].text, lnames));
      i += 2;
    } else if (op == "local.tee") {
      out = out.append(34);
      out = leb_u32(out, flat_idx(instrs[i + 1].text, lnames));
      i += 2;
    } else if (op == "global.get") {
      out = out.append(35);
      out = leb_u32(out, name_idx(gnames, instrs[i + 1].text));
      i += 2;
    } else if (op == "global.set") {
      out = out.append(36);
      out = leb_u32(out, name_idx(gnames, instrs[i + 1].text));
      i += 2;
    } else if (op == "call") {
      out = out.append(16);
      out = leb_u32(out, name_idx(fnames, instrs[i + 1].text));
      i += 2;
    } else if (op == "call_indirect") {
      out = out.append(17);
      out = leb_u32(out, name_idx(tnames, instrs[i + 1].items[1].text));
      out = leb_u32(out, 0);
      i += 2;
    } else if (op == "br") {
      out = out.append(12);
      out = leb_u32(out, parse_dec(instrs[i + 1].text));
      i += 2;
    } else if (op == "br_if") {
      out = out.append(13);
      out = leb_u32(out, parse_dec(instrs[i + 1].text));
      i += 2;
    } else if (op == "block" || op == "loop" || op == "if") {
      if (op == "block") {
        out = out.append(2);
      } else if (op == "loop") {
        out = out.append(3);
      } else {
        out = out.append(4);
      }
      let bt = 64;
      if (i + 1 < instrs.len() && node_head(instrs[i + 1]) == "result") {
        bt = valtype_byte(instrs[i + 1].items[1].text);
        i += 1;
      }
      out = out.append(bt);
      i += 1;
    } else if (op == "else") {
      out = out.append(5);
      i += 1;
    } else if (op == "end") {
      out = out.append(11);
      i += 1;
    } else if (op == "unreachable") {
      out = out.append(0);
      i += 1;
    } else if (op == "return") {
      out = out.append(15);
      i += 1;
    } else if (op == "drop") {
      out = out.append(26);
      i += 1;
    } else {
      let ml = mem_load_opcode(op);
      let ms = mem_store_opcode(op);
      let ao = arith_opcode(op);
      let stf = sat_trunc_opcode(op);
      let blk = bulk_mem_opcode(op);
      let sop = simd_opcode(op);
      if (ml != 0) {
        out = out.append(ml);
        out = leb_u32(out, memarg_align(op));
        out = leb_u32(out, 0);
      } else if (ms != 0) {
        out = out.append(ms);
        out = leb_u32(out, memarg_align(op));
        out = leb_u32(out, 0);
      } else if (sop >= 0) {
        out = out.append(253);
        out = leb_u32(out, sop);
        if (op == "i8x16.shuffle") {
          out = shuffle_indices(out, instrs, i + 1);
          i += 16;
        }
        if (simd_has_memarg(op)) {
          out = leb_u32(out, 0);
          out = leb_u32(out, 0);
        }
        if (simd_has_lane(op)) {
          out = out.append(simd_lane_index(op, instrs[i + 1].text));
          i += 1;
        }
      } else if (stf >= 0) {
        out = out.append(252);
        out = leb_u32(out, stf);
      } else if (blk >= 0) {
        out = out.append(252);
        out = bulk_mem_tail(out, blk);
      } else if (ao != 0) {
        out = out.append(ao);
      } else if (op.len() > 0) {
        eprint("watbin: unknown instruction: " + op);
        exit(1);
      }
      i += 1;
    }
  }
  return out;
}

function enc_locals_vec(types: string[]): i32[] {
  let runs = 0;
  let i = 0;
  while (i < types.len()) {
    if (i == 0 || types[i] != types[i - 1]) {
      runs += 1;
    }
    i += 1;
  }
  let body: i32[] = [];
  i = 0;
  while (i < types.len()) {
    let n = 1;
    while (i + n < types.len() && types[i + n] == types[i]) {
      n += 1;
    }
    body = leb_u32(body, n);
    body = body.append(valtype_byte(types[i]));
    i += n;
  }
  return wvec(runs, body);
}

function enc_functype(params: string[], results: string[]): i32[] {
  let o: i32[] = [];
  o = o.append(96);
  let pb: i32[] = [];
  let i = 0;
  while (i < params.len()) {
    pb = pb.append(valtype_byte(params[i]));
    i += 1;
  }
  o = util.append_all(o, wvec(params.len(), pb));
  let rb: i32[] = [];
  for i in 0..results.len() {
    rb = rb.append(valtype_byte(results[i]));
  }
  o = util.append_all(o, wvec(results.len(), rb));
  return o;
}

function body_instrs(fnode: SExpr): SExpr[] {
  let out: SExpr[] = [];
  for i in func_header_end(fnode)..fnode.items.len() {
    out = out.append(fnode.items[i]);
  }
  return out;
}

function emit_binary(mod: SExpr): i32[] {
  let fnames = util.name_index(collect_func_names(mod));
  let global_names: string[] = [];
  for gi in 0..mod.items.len() {
    if (node_head(mod.items[gi]) == "global") {
      global_names = global_names.append(mod.items[gi].items[1].text);
    }
  }
  let gnames = util.name_index(global_names);

  let importNodes: SExpr[] = [];
  let definedNodes: SExpr[] = [];
  let i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "import") {
      importNodes = importNodes.append(mod.items[i]);
    }
    if (node_head(mod.items[i]) == "func") {
      definedNodes = definedNodes.append(mod.items[i]);
    }
    i += 1;
  }

  let type_names: string[] = [];
  let namedTypeBody: i32[] = [];
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "type") {
      let tn = mod.items[i];
      type_names = type_names.append(tn.items[1].text);
      let tf = tn.items[2];
      namedTypeBody = util.append_all(namedTypeBody, enc_functype(func_param_types(tf), func_result_types(tf)));
    }
    i += 1;
  }
  let ntypes = type_names.len();
  let tnames = util.name_index(type_names);

  let nfuncs = importNodes.len() + definedNodes.len();
  let typeBody = namedTypeBody;
  i = 0;
  while (i < importNodes.len()) {
    let fn = func_node(importNodes[i]);
    typeBody = util.append_all(typeBody, enc_functype(func_param_types(fn), func_result_types(fn)));
    i += 1;
  }
  i = 0;
  while (i < definedNodes.len()) {
    typeBody = util.append_all(typeBody, enc_functype(func_param_types(definedNodes[i]), func_result_types(definedNodes[i])));
    i += 1;
  }

  let impBody: i32[] = [];
  i = 0;
  while (i < importNodes.len()) {
    let imp = importNodes[i];
    impBody = wname(impBody, imp.items[1].text);
    impBody = wname(impBody, imp.items[2].text);
    impBody = impBody.append(0);
    impBody = leb_u32(impBody, ntypes + i);
    i += 1;
  }

  let funcBody: i32[] = [];
  i = 0;
  while (i < definedNodes.len()) {
    funcBody = leb_u32(funcBody, ntypes + importNodes.len() + i);
    i += 1;
  }

  let memBody: i32[] = [];
  let memCount = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "memory") {
      let mn = mod.items[i];
      let minv = parse_dec(mn.items[mn.items.len() - 1].text);
      memBody = memBody.append(0);
      memBody = leb_u32(memBody, minv);
      memCount += 1;
    }
    i += 1;
  }

  let globBody: i32[] = [];
  let globCount = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "global") {
      let gn = mod.items[i];
      globBody = globBody.append(valtype_byte(global_valtype(gn)));
      globBody = globBody.append(1);
      globBody = util.append_all(globBody, enc_instr(gn.items[gn.items.len() - 1], util.name_index([]), fnames, gnames, [], util.name_index([])));
      globBody = globBody.append(11);
      globCount += 1;
    }
    i += 1;
  }

  let expBody: i32[] = [];
  let expCount = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "memory") {
      let mm = mod.items[i];
      for j in 1..mm.items.len() {
        if (node_head(mm.items[j]) == "export") {
          expBody = wname(expBody, mm.items[j].items[1].text);
          expBody = expBody.append(2);
          expBody = leb_u32(expBody, 0);
          expCount += 1;
        }
      }
    }
    if (node_head(mod.items[i]) == "export") {
      let ex = mod.items[i];
      expBody = wname(expBody, ex.items[1].text);
      expBody = expBody.append(0);
      expBody = leb_u32(expBody, name_idx(fnames, ex.items[2].items[1].text));
      expCount += 1;
    }
    i += 1;
  }

  let codeBody: i32[] = [];
  i = 0;
  while (i < definedNodes.len()) {
    let fnode = definedNodes[i];
    let lnames = util.name_index(local_names(fnode));
    let fbody = enc_locals_vec(local_decl_types(fnode));
    let instrs = body_instrs(fnode);
    if (instrs.len() > 0 && instrs[0].kind != 0) {
      fbody = util.append_all(fbody, enc_flat_body(instrs, lnames, fnames, gnames, tnames));
    } else {
      for k in 0..instrs.len() {
        fbody = util.append_all(fbody, enc_instr(instrs[k], lnames, fnames, gnames, [], tnames));
      }
    }
    fbody = fbody.append(11);
    codeBody = leb_u32(codeBody, fbody.len());
    codeBody = util.append_all(codeBody, fbody);
    i += 1;
  }

  let dataBody: i32[] = [];
  let dataCount = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "data") {
      let dn = mod.items[i];
      dataBody = dataBody.append(0);
      dataBody = util.append_all(dataBody, enc_instr(dn.items[1], util.name_index([]), fnames, gnames, [], util.name_index([])));
      dataBody = dataBody.append(11);
      let bytes = data_bytes(dn.items[2].text);
      dataBody = leb_u32(dataBody, bytes.len());
      dataBody = util.append_all(dataBody, bytes);
      dataCount += 1;
    }
    i += 1;
  }

  let tableBody: i32[] = [];
  let tableCount = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "table") {
      let tbn = mod.items[i];
      tableBody = tableBody.append(112);
      tableBody = tableBody.append(0);
      tableBody = leb_u32(tableBody, parse_dec(tbn.items[1].text));
      tableCount += 1;
    }
    i += 1;
  }

  let elemBody: i32[] = [];
  let elemCount = 0;
  for i in 0..mod.items.len() {
    if (node_head(mod.items[i]) == "elem") {
      let en = mod.items[i];
      elemBody = elemBody.append(0);
      elemBody = util.append_all(elemBody, enc_instr(en.items[1], util.name_index([]), fnames, gnames, [], util.name_index([])));
      elemBody = elemBody.append(11);
      let fb: i32[] = [];
      for ei in 2..en.items.len() {
        fb = leb_u32(fb, name_idx(fnames, en.items[ei].text));
      }
      elemBody = util.append_all(elemBody, wvec(en.items.len() - 2, fb));
      elemCount += 1;
    }
  }

  let out = wmagic();
  out = util.append_all(out, wsection(1, wvec(ntypes + nfuncs, typeBody)));
  out = util.append_all(out, wsection(2, wvec(importNodes.len(), impBody)));
  out = util.append_all(out, wsection(3, wvec(definedNodes.len(), funcBody)));
  if (tableCount > 0) {
    out = util.append_all(out, wsection(4, wvec(tableCount, tableBody)));
  }
  if (memCount > 0) {
    out = util.append_all(out, wsection(5, wvec(memCount, memBody)));
  }
  if (globCount > 0) {
    out = util.append_all(out, wsection(6, wvec(globCount, globBody)));
  }
  if (expCount > 0) {
    out = util.append_all(out, wsection(7, wvec(expCount, expBody)));
  }
  if (elemCount > 0) {
    out = util.append_all(out, wsection(9, wvec(elemCount, elemBody)));
  }
  out = util.append_all(out, wsection(10, wvec(definedNodes.len(), codeBody)));
  if (dataCount > 0) {
    out = util.append_all(out, wsection(11, wvec(dataCount, dataBody)));
  }
  return out;
}

function func_sig(fn: SExpr): string {
  let o = "";
  let ps = func_param_types(fn);
  let i = 0;
  while (i < ps.len()) {
    o = o + ps[i] + ",";
    i += 1;
  }
  o += "->";
  let rs = func_result_types(fn);
  for i in 0..rs.len() {
    o = o + rs[i] + ",";
  }
  return o;
}

function rename_atoms(n: SExpr, from: string[], to: string[]): SExpr {
  if (n.kind == 2) {
    let k = util.index_of_str(from, n.text);
    if (k >= 0) {
      return SExpr { kind: 2, text: to[k], items: [] };
    }
    return n;
  }
  if (n.kind != 0) {
    return n;
  }
  let out: SExpr[] = [];
  for i in 0..n.items.len() {
    out = out.append(rename_atoms(n.items[i], from, to));
  }
  return SExpr { kind: 0, text: n.text, items: out };
}

function merge_duplicate_imports(mod: SExpr): SExpr {
  let keep: SExpr[] = [];
  let seen_key: string[] = [];
  let seen_name: string[] = [];
  let from: string[] = [];
  let to: string[] = [];
  let i = 0;
  while (i < mod.items.len()) {
    let it = mod.items[i];
    if (node_head(it) == "import" && it.items.len() == 4 && node_head(it.items[3]) == "func") {
      let fn = func_node(it);
      let key = it.items[1].text + "\n" + it.items[2].text + "\n" + func_sig(fn);
      let k = util.index_of_str(seen_key, key);
      if (k >= 0) {
        from = from.append(func_name(fn));
        to = to.append(seen_name[k]);
        i += 1;
        continue;
      }
      seen_key = seen_key.append(key);
      seen_name = seen_name.append(func_name(fn));
    }
    keep = keep.append(it);
    i += 1;
  }
  if (from.len() == 0) {
    return mod;
  }
  return rename_atoms(SExpr { kind: mod.kind, text: mod.text, items: keep }, from, to);
}

pub function wat_to_binary(wat: string): i32[] {
  return emit_binary(merge_duplicate_imports(wat_parse(wat_tokenize(wat))));
}

pub function component_preamble(): i32[] {
  let o: i32[] = [];
  o = o.append(0);
  o = o.append(97);
  o = o.append(115);
  o = o.append(109);
  o = o.append(13);
  o = o.append(0);
  o = o.append(1);
  o = o.append(0);
  return o;
}

function component_wrap(core: i32[]): i32[] {
  let o = component_preamble();
  return util.append_all(o, wsection(1, core));
}

pub function component_full(core: i32[]): i32[] {
  let o = component_preamble();
  o = util.append_all(o, wsection(1, core));

  o = util.append_all(o, wsection(2, [1, 0, 0, 0]));

  let al: i32[] = [1, 0, 0, 1, 0];
  al = wname(al, "_lang_run");
  o = util.append_all(o, wsection(6, al));

  o = util.append_all(o, wsection(7, [2, 106, 0, 0, 64, 0, 0, 0]));

  o = util.append_all(o, wsection(8, [1, 0, 0, 0, 0, 1]));

  let inst: i32[] = [1, 1, 1, 0];
  inst = wname(inst, "run");
  inst = inst.append(1);
  inst = inst.append(0);
  o = util.append_all(o, wsection(5, inst));

  let ex: i32[] = [1, 0];
  ex = wname(ex, "wasi:cli/run@0.2.0");
  ex = ex.append(5);
  ex = ex.append(0);
  ex = ex.append(0);
  o = util.append_all(o, wsection(11, ex));

  return o;
}

