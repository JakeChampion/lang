function labels_push(labels: string[], x: string): string[] {
  let out: string[] = [];
  for i in 0..labels.len() {
    out = out.append(labels[i]);
  }
  out = out.append(x);
  return out;
}

function label_depth(labels: string[], name: string): i32 {
  let i = labels.len() - 1;
  while (i >= 0) {
    if (labels[i] == name) {
      return labels.len() - 1 - i;
    }
    i -= 1;
  }
  return 0;
}

function sat_trunc_opcode(op: string): i32 {
  return match (op) {
    "i32.trunc_sat_f32_s" => 0,
    "i32.trunc_sat_f32_u" => 1,
    "i32.trunc_sat_f64_s" => 2,
    "i32.trunc_sat_f64_u" => 3,
    "i64.trunc_sat_f32_s" => 4,
    "i64.trunc_sat_f32_u" => 5,
    "i64.trunc_sat_f64_s" => 6,
    "i64.trunc_sat_f64_u" => 7,
    _ => -1,
  };
}

