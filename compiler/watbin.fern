function leb128_mask25(): i32 {
  return 33554431;
}

pub function leb_u32(buf: i32[], value: i32): i32[] {
  let v: i32 = value;
  let more: boolean = true;
  while (more) {
    let b: i32 = v & 127;
    v = v >> 7 & leb128_mask25();
    if (v == 0) {
      more = false;
    } else {
      b = b | 128;
    }
    buf = buf.append(b);
  }
  return buf;
}

pub function leb_i32(buf: i32[], value: i32): i32[] {
  let v: i32 = value;
  let more: boolean = true;
  while (more) {
    let b: i32 = v & 127;
    v = v >> 7;
    let sign: i32 = b & 64;
    if (v == 0 && sign == 0 || v == 0 - 1 && sign != 0) {
      more = false;
    } else {
      b = b | 128;
    }
    buf = buf.append(b);
  }
  return buf;
}

function leb_i64(buf: i32[], value: i64): i32[] {
  let v: i64 = value;
  let more: boolean = true;
  while (more) {
    let b: i32 = (v & 127) as i32;
    v = v >> 7;
    let sign: i32 = b & 64;
    if (v == 0 && sign == 0 || v == 0 - 1 && sign != 0) {
      more = false;
    } else {
      b = b | 128;
    }
    buf = buf.append(b);
  }
  return buf;
}

pub struct WatTok { kind: i32, text: string }

function wat_is_space(c: i32): boolean {
  return c == 32 || c == 9 || c == 10 || c == 13;
}

function wat_tokenize(src: string): WatTok[] {
  let toks: WatTok[] = [];
  let i: i32 = 0;
  let n: i32 = src.len();
  while (i < n) {
    let c: i32 = src[i] as i32;
    if (wat_is_space(c)) {
      i = i + 1;
    } else if (c == 40) {
      toks = toks.append(WatTok { kind: 0, text: "(" });
      i = i + 1;
    } else if (c == 41) {
      toks = toks.append(WatTok { kind: 1, text: ")" });
      i = i + 1;
    } else if (c == 34) {
      let start: i32 = i + 1;
      let j: i32 = start;
      while (j < n && src[j] != b'"') {
        if (src[j] == b'\\') {
          j = j + 2;
        } else {
          j = j + 1;
        }
      }
      toks = toks.append(WatTok { kind: 3, text: slice_unchecked(src, start, j) + "" });
      i = j + 1;
    } else {
      let astart: i32 = i;
      while (i < n) {
        let ch: i32 = src[i] as i32;
        if (wat_is_space(ch) || ch == 40 || ch == 41 || ch == 34) {
          break;
        }
        i = i + 1;
      }
      toks = toks.append(WatTok { kind: 2, text: slice_unchecked(src, astart, i) + "" });
    }
  }
  return toks;
}

pub struct SExpr { kind: i32, text: string, items: SExpr[] }

pub struct ParseOne { node: SExpr, pos: i32 }

function wat_parse_one(toks: WatTok[], i: i32): ParseOne {
  let t: WatTok = toks[i];
  if (t.kind != 0) {
    return ParseOne { node: SExpr { kind: t.kind, text: t.text, items: [] }, pos: i + 1 };
  }
  let children: SExpr[] = [];
  let j: i32 = i + 1;
  while (j < toks.len() && toks[j].kind != 1) {
    let r: ParseOne = wat_parse_one(toks, j);
    children = children.append(r.node);
    j = r.pos;
  }
  return ParseOne { node: SExpr { kind: 0, text: "", items: children }, pos: j + 1 };
}

function wat_parse(toks: WatTok[]): SExpr {
  let r: ParseOne = wat_parse_one(toks, 0);
  return r.node;
}

pub function wcat(buf: i32[], src: i32[]): i32[] {
  let i: i32 = 0;
  while (i < src.len()) {
    buf = buf.append(src[i]);
    i = i + 1;
  }
  return buf;
}

function wstr_bytes(buf: i32[], s: string): i32[] {
  let i: i32 = 0;
  while (i < s.len()) {
    buf = buf.append(s[i] as i32);
    i = i + 1;
  }
  return buf;
}

pub function wname(buf: i32[], s: string): i32[] {
  buf = leb_u32(buf, s.len());
  return wstr_bytes(buf, s);
}

pub function wsection(id: i32, contents: i32[]): i32[] {
  let o: i32[] = [];
  o = o.append(id);
  o = leb_u32(o, contents.len());
  return wcat(o, contents);
}

function wvec(count: i32, elems: i32[]): i32[] {
  let o: i32[] = [];
  o = leb_u32(o, count);
  return wcat(o, elems);
}

function global_valtype(gn: SExpr): string {
  if (gn.items.len() < 3) {
    return "i32";
  }
  let ty: SExpr = gn.items[2];
  if (ty.kind == 2) {
    return ty.text;
  }
  if (node_head(ty) == "mut" && ty.items.len() > 1 && ty.items[1].kind == 2) {
    return ty.items[1].text;
  }
  return "i32";
}

function valtype_byte(t: string): i32 {
  if (t == "i32") {
    return 127;
  }
  if (t == "i64") {
    return 126;
  }
  if (t == "f32") {
    return 125;
  }
  if (t == "f64") {
    return 124;
  }
  if (t == "funcref") {
    return 112;
  }
  if (t == "v128") {
    return 123;
  }
  return 127;
}

function wmagic(): i32[] {
  let o: i32[] = [];
  o = o.append(0);
  o = o.append(97);
  o = o.append(115);
  o = o.append(109);
  o = o.append(1);
  o = o.append(0);
  o = o.append(0);
  o = o.append(0);
  return o;
}

function index_of_str(xs: string[], s: string): i32 {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == s) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function name_idx(names: string[], n: string): i32 {
  let k: i32 = index_of_str(names, n);
  if (k < 0) {
    eprint("watbin: reference to undefined " + n);
    exit(1);
  }
  return k;
}

function node_head(n: SExpr): string {
  if (n.kind == 0 && n.items.len() > 0 && n.items[0].kind == 2) {
    return n.items[0].text;
  }
  return "";
}

function parse_dec(s: string): i32 {
  let neg: boolean = false;
  let i: i32 = 0;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  } else if (s.len() > 0 && s[0] == b'+') {
    i = 1;
  }
  let base: i32 = 10;
  if (s.len() > i + 2 && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
    base = 16;
    i = i + 2;
  }
  let v: i32 = 0;
  while (i < s.len()) {
    if (s[i] != b'_') {
      v = v * base + hexval(s[i] as i32);
    }
    i = i + 1;
  }
  if (neg) {
    return 0 - v;
  }
  return v;
}

function parse_dec_i64(s: string): i64 {
  let neg: boolean = false;
  let i: i32 = 0;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  } else if (s.len() > 0 && s[0] == b'+') {
    i = 1;
  }
  let base: i64 = 10;
  if (s.len() > i + 2 && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
    base = 16;
    i = i + 2;
  }
  let v: i64 = 0;
  while (i < s.len()) {
    if (s[i] != b'_') {
      v = v * base + hexval(s[i] as i32) as i64;
    }
    i = i + 1;
  }
  let z: i64 = 0;
  if (neg) {
    return z - v;
  }
  return v;
}

pub function parse_f64(s: string): f64 {
  return f64_from_bits(parse_f64_bits(s));
}

function pf64_div2(b: i32[]): i32[] {
  let out: i32[] = [];
  let r: i32 = 0;
  let i: i32 = 0;
  while (i < b.len()) {
    let cur: i32 = r * 10 + b[i];
    out = out.append(cur / 2);
    r = cur % 2;
    i = i + 1;
  }
  if (r != 0) {
    out = out.append(5);
  }
  return out;
}

function pf64_mul2(b: i32[]): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(0);
    i = i + 1;
  }
  let carry: i32 = 0;
  let j: i32 = b.len() - 1;
  while (j >= 0) {
    let cur: i32 = b[j] * 2 + carry;
    out = out.with(j, cur % 10);
    carry = cur / 10;
    j = j - 1;
  }
  let res: i32[] = [carry];
  let k: i32 = 0;
  while (k < out.len()) {
    res = res.append(out[k]);
    k = k + 1;
  }
  return res;
}

function pf64_sub(b: i32[], from: i32, upto: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = from;
  while (i < upto) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

function pf64_all_zero(b: i32[]): boolean {
  let i: i32 = 0;
  while (i < b.len()) {
    if (b[i] != 0) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function parse_f64_bits(s: string): i64 {
  let i: i32 = 0;
  let neg: boolean = false;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  } else if (s.len() > 0 && s[0] == b'+') {
    i = 1;
  }
  let signbit: i64 = 0;
  if (neg) {
    let one: i64 = 1;
    signbit = one << 63;
  }
  let digits: i32[] = [];
  let dp: i32 = 0;
  let sticky: boolean = false;
  let started: boolean = false;
  while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
    let d: i32 = s[i] as i32 - 48;
    if (started || d != 0) {
      started = true;
      if (digits.len() < 800) {
        digits = digits.append(d);
      } else {
        if (d != 0) {
          sticky = true;
        }
      }
      dp = dp + 1;
    }
    i = i + 1;
  }
  if (i < s.len() && s[i] == b'.') {
    i = i + 1;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      let fd: i32 = s[i] as i32 - 48;
      if (started || fd != 0) {
        started = true;
        if (digits.len() < 800) {
          digits = digits.append(fd);
        } else {
          if (fd != 0) {
            sticky = true;
          }
        }
      } else {
        dp = dp - 1;
      }
      i = i + 1;
    }
  }
  if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
    i = i + 1;
    let eneg: boolean = false;
    if (i < s.len() && s[i] == b'-') {
      eneg = true;
      i = i + 1;
    } else if (i < s.len() && s[i] == b'+') {
      i = i + 1;
    }
    let exp: i32 = 0;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      if (exp < 100000) {
        exp = exp * 10 + (s[i] as i32 - 48);
      }
      i = i + 1;
    }
    if (eneg) {
      dp = dp - exp;
    } else {
      dp = dp + exp;
    }
  }
  while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
    digits = pf64_sub(digits, 0, digits.len() - 1);
  }
  if (digits.len() == 0) {
    return signbit;
  }
  if (dp > 310) {
    let inf: i64 = 2047;
    return signbit | inf << 52;
  }
  if (dp < 0 - 350) {
    return signbit;
  }
  let bexp: i32 = 0;
  while (dp > 0) {
    let hb: i32[] = pf64_div2(digits);
    if (hb.len() > 0 && hb[0] == 0) {
      digits = pf64_sub(hb, 1, hb.len());
      dp = dp - 1;
    } else {
      digits = hb;
    }
    bexp = bexp + 1;
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
      digits = pf64_sub(digits, 0, digits.len() - 1);
    }
  }
  while (dp < 0 || digits.len() > 0 && digits[0] < 5) {
    let db: i32[] = pf64_mul2(digits);
    if (db[0] != 0) {
      digits = db;
      dp = dp + 1;
    } else {
      digits = pf64_sub(db, 1, db.len());
    }
    bexp = bexp - 1;
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
      digits = pf64_sub(digits, 0, digits.len() - 1);
    }
    if (digits.len() == 0) {
      return signbit;
    }
  }
  let e: i32 = bexp + 1022;
  if (e >= 2047) {
    let inf2: i64 = 2047;
    return signbit | inf2 << 52;
  }
  let nbits: i32 = 53;
  if (e <= 0) {
    nbits = 52 + e;
  }
  if (nbits < 0) {
    return signbit;
  }
  let mant: i64 = 0;
  let k2: i32 = 0;
  while (k2 < nbits) {
    let mb: i32[] = pf64_mul2(digits);
    mant = mant * 2 + mb[0] as i64;
    digits = pf64_sub(mb, 1, mb.len());
    k2 = k2 + 1;
  }
  let rb: i32[] = pf64_mul2(digits);
  let roundbit: i32 = rb[0];
  let rest: i32[] = pf64_sub(rb, 1, rb.len());
  let st: boolean = sticky || !pf64_all_zero(rest);
  if (roundbit == 1 && (st || (mant & 1) == 1)) {
    mant = mant + 1;
  }
  if (e <= 0) {
    return signbit | mant;
  }
  let full: i64 = 1;
  full = full << 53;
  if (mant == full) {
    mant = mant / 2;
    e = e + 1;
    if (e >= 2047) {
      let inf3: i64 = 2047;
      return signbit | inf3 << 52;
    }
  }
  let hidden: i64 = 1;
  hidden = hidden << 52;
  return signbit | e as i64 << 52 | mant - hidden;
}

function hexval(c: i32): i32 {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 97 + 10;
  }
  if (c >= 65 && c <= 70) {
    return c - 65 + 10;
  }
  return 0;
}

function data_bytes(s: string): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    if (c == 92 && i + 1 < s.len()) {
      let n: i32 = s[i + 1] as i32;
      if (n == 110) {
        out = out.append(10);
        i = i + 2;
      } else if (n == 116) {
        out = out.append(9);
        i = i + 2;
      } else if (n == 92) {
        out = out.append(92);
        i = i + 2;
      } else if (n == 34) {
        out = out.append(34);
        i = i + 2;
      } else if (i + 2 < s.len()) {
        out = out.append(hexval(n) * 16 + hexval(s[i + 2] as i32));
        i = i + 3;
      } else {
        out = out.append(c);
        i = i + 1;
      }
    } else {
      out = out.append(c);
      i = i + 1;
    }
  }
  return out;
}

function func_node(child: SExpr): SExpr {
  if (node_head(child) == "import") {
    return child.items[child.items.len() - 1];
  }
  return child;
}

function func_name(fnode: SExpr): string {
  return fnode.items[1].text;
}

function collect_func_names(mod: SExpr): string[] {
  let names: string[] = [];
  let i: i32 = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "import") {
      names = names.append(func_name(func_node(mod.items[i])));
    }
    i = i + 1;
  }
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "func") {
      names = names.append(func_name(mod.items[i]));
    }
    i = i + 1;
  }
  return names;
}

function func_header_end(fnode: SExpr): i32 {
  let i: i32 = 2;
  while (i < fnode.items.len()) {
    let h: string = node_head(fnode.items[i]);
    if (h != "param" && h != "result" && h != "local") {
      return i;
    }
    i = i + 1;
  }
  return fnode.items.len();
}

function func_param_types(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop: i32 = func_header_end(fnode);
  let i: i32 = 1;
  while (i < stop) {
    let c: SExpr = fnode.items[i];
    if (node_head(c) == "param") {
      if (c.items.len() >= 2 && c.items[1].text[0] == b'$') {
        out = out.append(c.items[2].text);
      } else {
        let j: i32 = 1;
        while (j < c.items.len()) {
          out = out.append(c.items[j].text);
          j = j + 1;
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function func_result_types(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop: i32 = func_header_end(fnode);
  let i: i32 = 1;
  while (i < stop) {
    let c: SExpr = fnode.items[i];
    if (node_head(c) == "result") {
      let j: i32 = 1;
      while (j < c.items.len()) {
        out = out.append(c.items[j].text);
        j = j + 1;
      }
    }
    i = i + 1;
  }
  return out;
}

function local_names(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop: i32 = func_header_end(fnode);
  let i: i32 = 2;
  while (i < stop) {
    if (node_head(fnode.items[i]) == "param") {
      out = add_slot_names(out, fnode.items[i]);
    }
    i = i + 1;
  }
  i = 2;
  while (i < stop) {
    if (node_head(fnode.items[i]) == "local") {
      out = add_slot_names(out, fnode.items[i]);
    }
    i = i + 1;
  }
  return out;
}

function add_slot_names(out: string[], c: SExpr): string[] {
  if (c.items.len() >= 2 && c.items[1].text.len() > 0 && c.items[1].text[0] == b'$') {
    return out.append(c.items[1].text);
  }
  let k: i32 = 1;
  while (k < c.items.len()) {
    out = out.append("");
    k = k + 1;
  }
  return out;
}

function local_decl_types(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop: i32 = func_header_end(fnode);
  let i: i32 = 2;
  while (i < stop) {
    let c: SExpr = fnode.items[i];
    if (node_head(c) == "local") {
      if (c.items.len() >= 3 && c.items[1].text.len() > 0 && c.items[1].text[0] == b'$') {
        out = out.append(c.items[2].text);
      } else {
        let k: i32 = 1;
        while (k < c.items.len()) {
          out = out.append(c.items[k].text);
          k = k + 1;
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function arith_opcode(op: string): i32 {
  if (op == "i32.add") {
    return 106;
  }
  if (op == "i32.sub") {
    return 107;
  }
  if (op == "i32.mul") {
    return 108;
  }
  if (op == "i32.div_s") {
    return 109;
  }
  if (op == "i32.div_u") {
    return 110;
  }
  if (op == "i32.rem_s") {
    return 111;
  }
  if (op == "i32.rem_u") {
    return 112;
  }
  if (op == "i32.and") {
    return 113;
  }
  if (op == "i32.or") {
    return 114;
  }
  if (op == "i32.xor") {
    return 115;
  }
  if (op == "i32.shl") {
    return 116;
  }
  if (op == "i32.shr_s") {
    return 117;
  }
  if (op == "i32.shr_u") {
    return 118;
  }
  if (op == "i32.rotl") {
    return 119;
  }
  if (op == "i32.rotr") {
    return 120;
  }
  if (op == "i32.eq") {
    return 70;
  }
  if (op == "i32.ne") {
    return 71;
  }
  if (op == "i32.lt_s") {
    return 72;
  }
  if (op == "i32.lt_u") {
    return 73;
  }
  if (op == "i32.gt_s") {
    return 74;
  }
  if (op == "i32.gt_u") {
    return 75;
  }
  if (op == "i32.le_s") {
    return 76;
  }
  if (op == "i32.le_u") {
    return 77;
  }
  if (op == "i32.ge_s") {
    return 78;
  }
  if (op == "i32.ge_u") {
    return 79;
  }
  if (op == "i32.eqz") {
    return 69;
  }
  if (op == "i32.clz") {
    return 103;
  }
  if (op == "i32.ctz") {
    return 104;
  }
  if (op == "i32.popcnt") {
    return 105;
  }
  if (op == "i64.add") {
    return 124;
  }
  if (op == "i64.sub") {
    return 125;
  }
  if (op == "i64.mul") {
    return 126;
  }
  if (op == "i64.div_s") {
    return 127;
  }
  if (op == "i64.div_u") {
    return 128;
  }
  if (op == "i64.rem_s") {
    return 129;
  }
  if (op == "i64.rem_u") {
    return 130;
  }
