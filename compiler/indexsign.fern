import "std/crypto";
import "std/crypto/ed25519";
import "std/hex";
import "std/rand";
import "std/tls/pem";
import "./util";

// `fern -sign-index -key KEY INDEX` signs a package index. KEY is a PKCS#8
// PEM file that holds an ed25519 private key, as `openssl genpkey -algorithm
// ed25519` writes it. INDEX.sig gets the 128 hex digits of the signature
// over the exact bytes of INDEX, which `fern -resolve` verifies against the
// index_key of fern.toml. Stdout gets that index_key line.
//
// `fern -index-keygen KEY` makes such a key from the entropy of getrandom.

// The DER of a PKCS#8 ed25519 private key is these 16 bytes and the 32-byte
// seed: version 0, the algorithm 1.3.101.112, and the seed in an octet
// string. A key with attributes or a public key in it is refused.
function pkcs8_prefix(): u8[] {
  return [48, 46, 2, 1, 0, 48, 5, 6, 3, 43, 101, 112, 4, 34, 4, 32];
}

// The 32-byte seed of the ed25519 key in the PEM text, or a refusal.
pub function key_seed(text: string): Result[u8[], string] {
  let blocks = match (pem.decode(text)) {
    Ok(b) => b,
    Err(e) => {
      return Err("the key is not PEM: " + e.message());
    },
  };
  let found: u8[] = [];
  let n = 0;
  for b in blocks {
    if (b.label == "PRIVATE KEY") {
      found = b.bytes;
      n += 1;
    }
  }
  if (n != 1) {
    return Err("the key must hold one PRIVATE KEY block, found " + n.to_string());
  }
  let prefix = pkcs8_prefix();
  if (found.len() != prefix.len() + 32) {
    return Err("the PRIVATE KEY block is not a PKCS#8 ed25519 key");
  }
  for i in 0..prefix.len() {
    if (found[i] != prefix[i]) {
      return Err("the PRIVATE KEY block is not a PKCS#8 ed25519 key");
    }
  }
  let seed: u8[] = [];
  for i in prefix.len()..found.len() {
    seed = seed.append(found[i]);
  }
  crypto.erase(found);
  return Ok(seed);
}

// The signature over index and the index_key that verifies it.
pub struct Signed { sig_hex: string, index_key: string }

pub function sign(index: [u8], seed: [u8]): Result[Signed, string] {
  let key = match (ed25519.private_key(seed)) {
    Ok(k) => k,
    Err(e) => {
      return Err("the key is not an ed25519 seed: " + e.message());
    },
  };
  let sig = key.sign(index);
  let public = hex.encode(key.public_point());
  key.erase();
  return Ok(Signed { sig_hex: hex.encode(sig), index_key: "ed25519:" + public });
}

// Runs `fern -sign-index`: 0 when INDEX.sig is written, 1 on a refusal.
pub function run(index_path: string, key_path: string): i32 {
  if (key_path.len() == 0) {
    eprint("fern: -sign-index needs -key FILE, the ed25519 private key in PKCS#8 PEM");
    return 1;
  }
  let key_text = match (read_file(key_path)) {
    Ok(s) => s,
    Err(e) => {
      eprint("fern: cannot read the key " + key_path + ": " + e.message());
      return 1;
    },
  };
  let index = match (read_file_bytes(index_path)) {
    Ok(b) => b,
    Err(e) => {
      eprint("fern: cannot read the index " + index_path + ": " + e.message());
      return 1;
    },
  };
  let seed = match (key_seed(key_text)) {
    Ok(s) => s,
    Err(message) => {
      eprint("fern: key " + key_path + ": " + message);
      return 1;
    },
  };
  let result = sign(index, seed);
  crypto.erase(seed);
  let signed = match (result) {
    Ok(s) => s,
    Err(message) => {
      eprint("fern: key " + key_path + ": " + message);
      return 1;
    },
  };
  match (write_file(index_path + ".sig", signed.sig_hex + "\n")) {
    Ok(_) => {},
    Err(e) => {
      eprint("fern: cannot write " + index_path + ".sig: " + e.message());
      return 1;
    }
  }
  print("index_key = \"" + signed.index_key + "\"");
  return 0;
}

// Runs `fern -index-keygen`: 0 when KEY is a new file that holds a new key.
// The file gets mode 0600, and a path that exists is refused.
pub function keygen(key_path: string): i32 {
  let seed = rand.bytes(32);
  let der = pkcs8_prefix();
  for b in seed {
    der = der.append(b);
  }
  let text = pem.encode("PRIVATE KEY", der);
  crypto.erase(der);
  let public = match (ed25519.private_key(seed)) {
    Ok(k) => {
      let p = hex.encode(k.public_point());
      k.erase();
      p
    },
    Err(e) => {
      eprint("fern: the entropy source gave no 32-byte seed: " + e.message());
      return 1;
    },
  };
  crypto.erase(seed);
  match (util.write_new_file(key_path, text)) {
    Ok(_) => {},
    Err(e) => {
      eprint("fern: cannot create the key " + key_path + ": " + e.message());
      return 1;
    }
  }
  print("index_key = \"ed25519:" + public + "\"");
  return 0;
}
