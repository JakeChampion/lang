// compiler/fern_toml.fern — the fern.toml / fern.lock reader for the
// self-hosted compiler's module loader, mirroring the Go oracle's
// internal/pkg/manifest + internal/pkg/mvs.
//
// The manifest parser accepts exactly the manifests manifest.Parse accepts
// and refuses the rest with the same message: [package], [dependencies] (path,
// workspace, version and url+hash forms, each with an optional capabilities
// grant), [workspace], [exclude], [lint] and [lint.options]. A url dependency
// and a url-sourced lock entry parse to their `sha256:<hex>` hash, which
// modloader.store_dir resolves from the per-machine content-addressed store;
// populating and verifying that store is `fern -fetch` (#4949).

import "./util";
import "./capvocab";
import "./docsummary";

// Dep is one declared dependency. `kind` tags the form the loader must
// resolve: "path" (dir given by `path`), "workspace" (a sibling
// workspace member, located by name), "version" (an MVS dependency
// resolved through fern.lock — `path` unused, the lock pins the source),
// or "url" (a url+hash dep resolved from the per-machine content-
// addressed store by `hash` — the loader never touches the network;
// #4949). `hash` is the manifest's `sha256:<hex>` for a url dep, ""
// otherwise, and `url` where it is downloaded from.
//
// `governed` records whether the entry carried a `capabilities` key at
// all, which is a different question from what `caps` holds: an empty
// grant list (`capabilities = []`) denies everything, while no key at
// all is warn-and-allow (docs/PACKAGE-CAPABILITIES-BRIEF.md, #6634).
pub struct Dep {
  name: string,
  kind: string,
  path: string,
  url: string,
  hash: string,
  version: string,
  governed: boolean,
  caps: string[],
}

// Manifest is the subset the loader reads: the [package] name + lib
// module (empty lib ⇒ default "lib.fern"), the declared dependencies,
// and the [workspace] members list (empty ⇒ not a workspace). `err` is the
// first diagnostic, worded as manifest.Parse words it, or "".
//
// `index` is the [package] index path — the version authority MVS resolves
// versioned dependencies against (empty ⇒ none). `excl_pkg` / `excl_ver`
// are the [exclude] table as parallel arrays, one pair per banned version;
// only the ROOT manifest's excludes reach resolution, which is what keeps
// it deterministic.
pub struct Manifest {
  name: string,
  lib: string,
  index: string,
  deps: Dep[],
  members: string[],
  excl_pkg: string[],
  excl_ver: string[],
  // lint_keys / lint_vals are the [lint] and [lint.options] tables as raw
  // `key = value` pairs, in file order; a dotted key is a rule option.
  lint_keys: string[],
  lint_vals: string[],
  err: string,
}

// index_of returns the first index of the single-char needle `c` in `s`
// at or after `from`, or -1.
function index_of(s: string, c: u8, from: i32): i32 {
  let i: i32 = from;
  while (i < s.len()) {
    if (s[i] == c) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// quoted_value extracts the first double-quoted string's contents that
// appears at or after `from` in `s`, or None.
function quoted_value(s: string, from: i32): Option[string] {
  let q1: i32 = index_of(s, b'"', from);
  if (q1 < 0) {
    return None;
  }
  let q2: i32 = index_of(s, b'"', q1 + 1);
  if (q2 < 0) {
    return None;
  }
  return Some(slice_unchecked(s, q1 + 1, q2) + "");
}

// split_char splits `src` on the byte `c`, keeping empty fields.
function split_char(src: string, c: u8): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < src.len()) {
    if (src[i] == c) {
      out = out.append(slice_unchecked(src, start, i) + "");
      start = i + 1;
    }
    i = i + 1;
  }
  out = out.append(slice_unchecked(src, start, src.len()) + "");
  return out;
}

// line_content is a source line without its comment or the space around
// it: a `#` outside a double-quoted string starts a comment.
pub function line_content(raw: string): string {
  let quoted: boolean = false;
  let i: i32 = 0;
  while (i < raw.len()) {
    if (raw[i] == b'"') {
      quoted = !quoted;
    } else if (raw[i] == b'#' && !quoted) {
      return util.trim(slice_unchecked(raw, 0, i));
    }
    i = i + 1;
  }
  return util.trim(raw);
}

// is_integer_text reports whether `s` is decimal digits, after an optional
// leading `-`.
function is_integer_text(s: string): boolean {
  let i: i32 = 0;
  if (s.len() > 1 && s[0] == b'-') {
    i = 1;
  }
  while (i < s.len()) {
    if (s[i] < b'0' || s[i] > b'9') {
      return false;
    }
    i = i + 1;
  }
  return s.len() > 0;
}

// parse reads a fern.toml source into a Manifest. It accepts exactly what
// native manifest.Parse accepts and refuses the rest in its words: `err` is
// the first diagnostic, and the other fields are partial when it is set.
pub function parse(src: string): Manifest {
  let m: Manifest = Manifest {
    name: "", lib: "lib.fern", index: "", deps: [], members: [],
    excl_pkg: [], excl_ver: [], lint_keys: [], lint_vals: [], err: "",
  };
  let workspace: boolean = false;
  let section: string = "";
  // Every section header and `section\nkey` seen so far: TOML defines each
  // once, and a repeat is refused rather than silently overriding the first.
  let seen: string[] = [];
  let lines: string[] = split_char(src, b'\n');
  let li: i32 = 0;
  while (li < lines.len() && m.err.len() == 0) {
    let line: string = line_content(lines[li]);
    li = li + 1;
    let at: string = "line " + util.i32_to_string(li) + ": ";
    if (line.len() == 0) {
      continue;
    }
    if (line[0] == b'[') {
      if (line[line.len() - 1] != b']') {
        return Manifest { ...m, err: at + "malformed section header " + docsummary.quote(line) };
      }
      section = util.trim(slice_unchecked(line, 1, line.len() - 1));
      workspace = workspace || section == "workspace";
      m = Manifest { ...m, err: section_error(section, seen, at) };
      seen = seen.append("[" + section + "]");
      continue;
    }
    m = with_entry(m, section, line, at, seen);
    seen = seen.append(section + "\n" + entry_key(line));
  }
  if (m.err.len() == 0 && m.name.len() == 0 && !workspace) {
    return Manifest { ...m, err: "missing [package] name" };
  }
  return m;
}

function section_error(section: string, seen: string[], at: string): string {
  let known: string[] = ["package", "dependencies", "workspace", "exclude", "lint", "lint.options"];
  if (!util.has_str(known, section)) {
    return at + "unknown section [" + section + "] (supported: [package], [dependencies], [workspace], [exclude], [lint], [lint.options])";
  }
  if (util.has_str(seen, "[" + section + "]")) {
    return at + "duplicate section [" + section + "]";
  }
  return "";
}

// entry_key is the key of a `key = value` line.
function entry_key(line: string): string {
  let eq: i32 = index_of(line, b'=', 0);
  if (eq < 0) {
    return "";
  }
  return util.trim(slice_unchecked(line, 0, eq));
}

function failed(m: Manifest, err: string): Manifest {
  return Manifest { ...m, err: err };
}

// with_entry is `m` with one `key = value` line of `section` applied.
function with_entry(m: Manifest, section: string, line: string, at: string, seen: string[]): Manifest {
  let eq: i32 = index_of(line, b'=', 0);
  if (eq < 0) {
    return failed(m, at + "expected `key = value`, got " + docsummary.quote(line));
  }
  let key: string = util.trim(slice_unchecked(line, 0, eq));
  let val: string = util.trim(slice_unchecked(line, eq + 1, line.len()));
  if (section.len() > 0 && util.has_str(seen, section + "\n" + key)) {
    return failed(m, at + "duplicate key " + docsummary.quote(key) + " in [" + section + "]");
  }
  if (section == "package") {
    return with_package_key(m, key, val, at);
  }
  if (section == "dependencies") {
    return with_dep(m, key, val, at);
  }
  if (section == "workspace") {
    return with_members(m, key, val, at);
  }
  if (section == "lint" || section == "lint.options") {
    return with_lint(m, section, key, val, at);
  }
  if (section == "exclude") {
    return with_exclude(m, key, val, at);
  }
  return failed(m, at + docsummary.quote(key) + " outside a section (start with [package], [dependencies], or [workspace])");
}

function with_package_key(m: Manifest, key: string, val: string, at: string): Manifest {
  let s: Parsed = parse_string(val);
  if (s.err.len() > 0) {
    return failed(m, at + key + ": " + s.err);
  }
  if (key == "name") {
    return Manifest { ...m, name: s.value };
  }
  if (key == "lib") {
    return Manifest { ...m, lib: s.value };
  }
  if (key == "index") {
    return Manifest { ...m, index: s.value };
  }
  if (key == "version") {
    return m;
  }
  return failed(m, at + "unknown [package] key " + docsummary.quote(key) + " (supported: name, version, lib, index)");
}

function with_dep(m: Manifest, key: string, val: string, at: string): Manifest {
  let d: DepResult = parse_dep(key, val);
  if (d.err.len() > 0) {
    return failed(m, at + "dependency " + docsummary.quote(key) + ": " + d.err);
  }
  if (!valid_dep_name(key)) {
    return failed(m, at + "invalid dependency name " + docsummary.quote(key) + " (letters, digits, `_`, `-`; must not start with a digit)");
  }
  return Manifest { ...m, deps: m.deps.append(d.dep) };
}

function with_members(m: Manifest, key: string, val: string, at: string): Manifest {
  if (key != "members") {
    return failed(m, at + "unknown [workspace] key " + docsummary.quote(key) + " (supported: members)");
  }
  let ms: ParsedList = parse_str_array(val);
  if (ms.err.len() > 0) {
    return failed(m, at + "members: " + ms.err);
  }
  return Manifest { ...m, members: ms.values };
}

// with_lint keeps a [lint] or [lint.options] pair for the linter, which
// reads the tables; under [lint.options] the key is `<rule>.<option>`.
function with_lint(m: Manifest, section: string, key: string, val: string, at: string): Manifest {
  let v: Parsed = parse_scalar(val);
  if (v.err.len() > 0) {
    return failed(m, at + "[" + section + "] " + key + ": " + v.err);
  }
  if (section == "lint.options" && index_of(key, b'.', 0) < 0) {
    return failed(m, at + "[lint.options] key " + docsummary.quote(key) + " must be spelled <rule>.<option>");
  }
  return Manifest { ...m, lint_keys: m.lint_keys.append(key), lint_vals: m.lint_vals.append(v.value) };
}

function with_exclude(m: Manifest, key: string, val: string, at: string): Manifest {
  if (!valid_dep_name(key)) {
    return failed(m, at + "invalid [exclude] package name " + docsummary.quote(key) + " (letters, digits, `_`, `-`; must not start with a digit)");
  }
  let vs: ParsedList = parse_str_array(val);
  if (vs.err.len() > 0) {
    return failed(m, at + "exclude " + key + ": " + vs.err);
  }
  let excl_pkg: string[] = m.excl_pkg;
  let excl_ver: string[] = m.excl_ver;
  for v in vs.values {
    if (!is_version(v)) {
      return failed(m, at + "exclude " + key + ": version must be MAJOR.MINOR.PATCH digits, got " + docsummary.quote(v));
    }
    excl_pkg = excl_pkg.append(key);
    excl_ver = excl_ver.append(v);
  }
  return Manifest { ...m, excl_pkg: excl_pkg, excl_ver: excl_ver };
}

// Parsed is one scalar value, or why it is not one.
struct Parsed { value: string, err: string }

pub struct ParsedList { values: string[], err: string }

// parse_string accepts a double-quoted string with no escapes.
function parse_string(val: string): Parsed {
  if (val.len() < 2 || val[0] != b'"' || val[val.len() - 1] != b'"') {
    return Parsed { value: "", err: "expected a double-quoted string, got " + docsummary.quote(val) };
  }
  let s: string = slice_unchecked(val, 1, val.len() - 1) + "";
  if (index_of(s, b'"', 0) >= 0 || index_of(s, b'\\', 0) >= 0) {
    return Parsed { value: "", err: "escapes are not supported in " + docsummary.quote(val) + " (use forward slashes in paths)" };
  }
  return Parsed { value: s, err: "" };
}

// parse_scalar accepts a quoted string or a bare integer.
function parse_scalar(val: string): Parsed {
  if (val.len() > 0 && val[0] == b'"') {
    return parse_string(val);
  }
  if (val.len() == 0) {
    return Parsed { value: "", err: "expected a quoted string or a number, got an empty value" };
  }
  if (!is_integer_text(val)) {
    return Parsed { value: "", err: "expected a quoted string or a number, got " + docsummary.quote(val) };
  }
  return Parsed { value: val, err: "" };
}

// parse_str_array parses a single-line inline array of quoted strings:
// `["a", "b/c"]` → ["a", "b/c"].
function parse_str_array(val: string): ParsedList {
  if (val.len() < 2 || val[0] != b'[' || val[val.len() - 1] != b']') {
    return ParsedList { values: [], err: "expected an array like [\"a\", \"b\"], got " + docsummary.quote(val) };
  }
  let out: string[] = [];
  for raw in split_char(slice_unchecked(val, 1, val.len() - 1) + "", b',') {
    let part: string = util.trim(raw);
    if (part.len() > 0) {
      let s: Parsed = parse_string(part);
      if (s.err.len() > 0) {
        return ParsedList { values: [], err: s.err };
      }
      out = out.append(s.value);
    }
  }
  return ParsedList { values: out, err: "" };
}

// is_version reports whether `s` is a bare MAJOR.MINOR.PATCH version.
pub function is_version(s: string): boolean {
  let parts: string[] = split_char(s, b'.');
  if (parts.len() != 3) {
    return false;
  }
  for p in parts {
    if (p.len() == 0 || p[0] == b'-' || !is_integer_text(p)) {
      return false;
    }
  }
  return true;
}

// valid_dep_name: letters, digits, `_` and `-`, not starting with a digit.
pub function valid_dep_name(s: string): boolean {
  if (s.len() == 0 || is_digit(s[0])) {
    return false;
  }
  for c in s {
    if (!is_digit(c) && !is_letter(c) && c != b'_' && c != b'-') {
      return false;
    }
  }
  return true;
}

function is_digit(c: u8): boolean {
  return c >= b'0' && c <= b'9';
}

function is_letter(c: u8): boolean {
  return c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z';
}

// HashResult is validate_hash's outcome: the 64 hex digits of the archive
// digest, or a diagnostic naming what a hash must look like.
pub struct HashResult {
  hex: string,
  err: string,
}

// validate_hash checks a package hash is exactly `sha256:` + 64 lowercase hex
// digits, returning the hex part. Every route that records a hash goes through
// here, because the hex is joined onto the content-addressed store root: an
// unvalidated hash is a directory traversal that also skips verification —
// there is nothing to verify against and nothing to download. Uppercase hex is
// rejected, so one spelling of a digest names one store directory.
//
// Mirrors native pkgcache.ValidateHash, message included: the two compilers
// must agree on what a hash is, or a lock one accepts is one the other refuses.
pub function validate_hash(hash: string): HashResult {
  let bad: string = "must be `sha256:` + 64 lowercase hex digits of the archive bytes, got "
    + docsummary.quote(hash);
  if (hash.len() < 7 || slice_unchecked(hash, 0, 7) != "sha256:") {
    return HashResult { hex: "", err: bad };
  }
  let hex: string = slice_unchecked(hash, 7, hash.len()) + "";
  if (hex.len() != 64) {
    return HashResult { hex: "", err: bad };
  }
  let i: i32 = 0;
  while (i < hex.len()) {
    let c: u8 = hex[i];
    let digit: boolean = c >= b'0' && c <= b'9';
    let lower: boolean = c >= b'a' && c <= b'f';
    if (!digit && !lower) {
      return HashResult { hex: "", err: bad };
    }
    i = i + 1;
  }
  return HashResult { hex: hex, err: "" };
}

struct DepResult { dep: Dep, err: string }

function dep_failed(d: Dep, err: string): DepResult {
  return DepResult { dep: d, err: err };
}

// parse_dep reads one [dependencies] value: a bare version string, or an
// inline table of `path`, `url` + `hash`, `workspace = true` or `version`,
// any of them with a `capabilities` grant.
function parse_dep(name: string, val: string): DepResult {
  let d: Dep = Dep { name: name, kind: "", path: "", url: "", hash: "", version: "", governed: false, caps: [] };
  if (val.len() == 0 || val[0] != b'{') {
    let s: Parsed = parse_string(val);
    if (s.err.len() > 0) {
      return dep_failed(d, "a bare dependency value must be a version string like \"1.2.0\" (or use an inline table): " + s.err);
    }
    let r: DepResult = with_dep_string(d, "version", s.value);
    if (r.err.len() > 0) {
      return r;
    }
    return classified(r.dep);
  }
  if (val[val.len() - 1] != b'}') {
    return dep_failed(d, "malformed inline table " + docsummary.quote(val));
  }
  for raw in inline_parts(util.trim(slice_unchecked(val, 1, val.len() - 1))) {
    let part: string = util.trim(raw);
    if (part.len() > 0) {
      let r: DepResult = with_dep_field(d, part);
      if (r.err.len() > 0) {
        return r;
      }
      d = r.dep;
    }
  }
  return classified(d);
}

// with_dep_field applies one `key = value` field of an inline dependency
// table. A `workspace = true` field marks the kind until classified() checks
// it stands alone.
function with_dep_field(d: Dep, part: string): DepResult {
  let eq: i32 = index_of(part, b'=', 0);
  if (eq < 0) {
    return dep_failed(d, "expected `key = value` in inline table, got " + docsummary.quote(part));
  }
  let k: string = util.trim(slice_unchecked(part, 0, eq));
  let v: string = util.trim(slice_unchecked(part, eq + 1, part.len()));
  if (k == "workspace") {
    if (v != "true") {
      return dep_failed(d, "workspace must be `true` (the only supported value), got " + docsummary.quote(v));
    }
    return DepResult { dep: Dep { ...d, kind: "workspace" }, err: "" };
  }
  if (k == "capabilities") {
    let cs: ParsedList = parse_capabilities(v);
    if (cs.err.len() > 0) {
      return dep_failed(d, "capabilities: " + cs.err);
    }
    return DepResult { dep: Dep { ...d, governed: true, caps: cs.values }, err: "" };
  }
  let s: Parsed = parse_string(v);
  if (s.err.len() > 0) {
    return dep_failed(d, k + ": " + s.err);
  }
  return with_dep_string(d, k, s.value);
}

function with_dep_string(d: Dep, k: string, s: string): DepResult {
  if (k == "path") {
    if (s.len() == 0) {
      return dep_failed(d, "path must not be empty");
    }
    return DepResult { dep: Dep { ...d, path: s }, err: "" };
  }
  if (k == "url") {
    if (!util.str_has_prefix(s, "https://") && !util.str_has_prefix(s, "http://")) {
      return dep_failed(d, "url must be http(s), got " + docsummary.quote(s));
    }
    return DepResult { dep: Dep { ...d, url: s }, err: "" };
  }
  if (k == "hash") {
    let hr: HashResult = validate_hash(s);
    if (hr.err.len() > 0) {
      return dep_failed(d, "hash " + hr.err);
    }
    return DepResult { dep: Dep { ...d, hash: s }, err: "" };
  }
  if (k == "version") {
    if (!is_version(s)) {
      return dep_failed(d, "version must be MAJOR.MINOR.PATCH digits, got " + docsummary.quote(s));
    }
    return DepResult { dep: Dep { ...d, version: s }, err: "" };
  }
  return dep_failed(d, "unknown dependency key " + docsummary.quote(k) + " (supported: path, url, hash, workspace, version, capabilities)");
}

// classified settles the kind from the fields an inline table set, refusing
// a combination that names more than one source.
function classified(d: Dep): DepResult {
  let remote: boolean = d.url.len() > 0 || d.hash.len() > 0;
  if (d.kind == "workspace") {
    if (d.path.len() > 0 || remote || d.version.len() > 0) {
      return dep_failed(d, "a `workspace` dependency takes no path/url/hash/version");
    }
    return DepResult { dep: d, err: "" };
  }
  if (d.version.len() > 0) {
    if (d.path.len() > 0 || remote) {
      return dep_failed(d, "a `version` dependency takes no path/url/hash (the version resolves through the index)");
    }
    return DepResult { dep: Dep { ...d, kind: "version" }, err: "" };
  }
  return source_classified(d, remote);
}

// source_classified settles a dependency that is neither a workspace member
// nor versioned: a `path`, or a `url` + `hash` pair.
function source_classified(d: Dep, remote: boolean): DepResult {
  if (d.path.len() > 0) {
    if (remote) {
      return dep_failed(d, "a dependency is either `path` or `url`+`hash`, not both");
    }
    return DepResult { dep: Dep { ...d, kind: "path" }, err: "" };
  }
  if (d.url.len() > 0 && d.hash.len() > 0) {
    return DepResult { dep: Dep { ...d, kind: "url" }, err: "" };
  }
  if (remote) {
    return dep_failed(d, "url dependencies need BOTH `url` and `hash` — the hash is the identity, the url just a mirror hint");
  }
  return dep_failed(d, "missing `path` (or `url` + `hash`, `workspace = true`, or a version)");
}

// inline_parts splits an inline-table body at the commas outside any quoted
// string or `[...]`, so an array-valued field stays one part.
function inline_parts(body: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let depth: i32 = 0;
  let quoted: boolean = false;
  let i: i32 = 0;
  while (i < body.len()) {
    let c: u8 = body[i];
    if (c == b'"') {
      quoted = !quoted;
    } else if (!quoted && c == b'[') {
      depth = depth + 1;
    } else if (!quoted && c == b']') {
      depth = depth - 1;
    } else if (!quoted && c == b',' && depth == 0) {
      out = out.append(slice_unchecked(body, start, i) + "");
      start = i + 1;
    }
    i = i + 1;
  }
  return out.append(slice_unchecked(body, start, body.len()) + "");
}

// parse_capabilities parses a `capabilities = [...]` grant: every name from
// the vocabulary, deduped and in vocabulary order. Empty grants nothing.
pub function parse_capabilities(val: string): ParsedList {
  let names: ParsedList = parse_str_array(val);
  if (names.err.len() > 0) {
    return names;
  }
  for name in names.values {
    if (!util.has_str(capvocab.capabilities(), name)) {
      return ParsedList { values: [], err: "unknown capability " + docsummary.quote(name) + " (valid capabilities: " + capability_choices() + ")" };
    }
  }
  return ParsedList { values: ordered_caps(names.values), err: "" };
}

function capability_choices(): string {
  let out: string = "";
  for cap in capvocab.capabilities() {
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + cap;
  }
  return out;
}

function ordered_caps(values: string[]): string[] {
  let out: string[] = [];
  for cap in capvocab.capabilities() {
    if (util.has_str(values, cap)) {
      out = out.append(cap);
    }
  }
  return out;
}

// dep_path returns the declared PATH of a path dependency `name`, or
// None. Iterates m.deps directly (no Option[Dep] intermediary): a struct-
// payload Option (Some(dep)) is outside the self-host IR emitter's lowered
// subset, so returning the primitive Option[string] keeps this module
// per-module-IR-eligible.
pub function dep_path(m: Manifest, name: string): Option[string] {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name && m.deps[i].kind == "path") {
      return Some(m.deps[i].path + "");
    }
    i = i + 1;
  }
  return None;
}

// has_dep reports whether `name` is declared at all.
pub function has_dep(m: Manifest, name: string): boolean {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// dep_kind returns the kind of dependency `name` ("path"/"workspace"/
// "version"/"url"), or "" when undeclared. Iterates m.deps directly (see
// dep_path on why no Option[Dep] intermediary).
pub function dep_kind(m: Manifest, name: string): string {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name) {
      return m.deps[i].kind + "";
    }
    i = i + 1;
  }
  return "";
}

// dep_names lists every declared dependency, in manifest order.
pub function dep_names(m: Manifest): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < m.deps.len()) {
    out = out.append(m.deps[i].name + "");
    i = i + 1;
  }
  return out;
}

// dep_governed reports whether dependency `name`'s entry carries a
// `capabilities` key — the question that decides whether reaching outside
// the grant is an error or a warning (#6634).
pub function dep_governed(m: Manifest, name: string): boolean {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name) {
      return m.deps[i].governed;
    }
    i = i + 1;
  }
  return false;
}

// dep_caps returns the capabilities granted to dependency `name`, empty
// when undeclared or ungoverned. Same primitive-return shape as dep_kind.
pub function dep_caps(m: Manifest, name: string): string[] {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name) {
      return m.deps[i].caps;
    }
    i = i + 1;
  }
  let empty: string[] = [];
  return empty;
}

// dep_hash returns the `sha256:<hex>` hash of a url dependency `name`,
// or None (undeclared, or not a url dep). Same primitive-Option shape as
// dep_path.
pub function dep_hash(m: Manifest, name: string): Option[string] {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name && m.deps[i].kind == "url" && m.deps[i].hash.len() > 0) {
      return Some(m.deps[i].hash + "");
    }
    i = i + 1;
  }
  return None;
}

// LockEntry is one resolved dependency from fern.lock: the package name
// plus, for a `path`-sourced version, its directory, and for a
// `url`-sourced version, its `sha256:<hex>` hash — resolved from the
// per-machine content-addressed store (#4949). `version` is the pinned
// version; the loader does not need it, but a diagnostic naming what was
// selected does.
pub struct LockEntry {
  name: string,
  version: string,
  path: string,
  url: string,
  hash: string,
}

// LockResult is parse_lock's outcome: the entries, or the first diagnostic.
// A lock that names a source the loader would go on to open has to be able to
// refuse — a `hash` is joined onto the store root, so an unchecked one picks
// the directory the build compiles from.
pub struct LockResult {
  entries: LockEntry[],
  err: string,
}

// parse_lock reads a fern.lock's `[[package]]` entries, keeping the name
// plus the `path` directory (path-sourced) or the `hash` (url-sourced).
pub function parse_lock(src: string): LockResult {
  let out: LockEntry[] = [];
  let blank: LockEntry = LockEntry { name: "", version: "", path: "", url: "", hash: "" };
  let cur: LockEntry = blank;
  let have: boolean = false;
  let lines: string[] = split_char(src, b'\n');
  let li: i32 = 0;
  while (li < lines.len()) {
    let line: string = line_content(lines[li]);
    li = li + 1;
    if (line == "[[package]]") {
      if (have) {
        out = out.append(cur);
      }
      cur = blank;
      have = true;
      continue;
    }
    let eq: i32 = index_of(line, b'=', 0);
    if (eq < 0) {
      continue;
    }
    let key: string = util.trim(slice_unchecked(line, 0, eq));
    match (quoted_value(util.trim(slice_unchecked(line, eq + 1, line.len())), 0)) {
      Some(v) => {
        let hr: HashResult = validate_hash(v);
        if (key == "hash" && hr.err.len() > 0) {
          let none: LockEntry[] = [];
          return LockResult { entries: none, err: "fern.lock line "
            + util.i32_to_string(li) + ": hash " + hr.err };
        }
        cur = with_lock_field(cur, key, v);
      },
      None => {}
    }
  }
  if (have) {
    out = out.append(cur);
  }
  return LockResult { entries: out, err: "" };
}

// with_lock_field is `e` with the lock key `key` set to `v`; any other key
// leaves it as it is.
function with_lock_field(e: LockEntry, key: string, v: string): LockEntry {
  if (key == "name") {
    return LockEntry { ...e, name: v };
  }
  if (key == "version") {
    return LockEntry { ...e, version: v };
  }
  if (key == "path") {
    return LockEntry { ...e, path: v };
  }
  if (key == "url") {
    return LockEntry { ...e, url: v };
  }
  if (key == "hash") {
    return LockEntry { ...e, hash: v };
  }
  return e;
}

// lock_has returns whether `name` has a [[package]] entry at all — the
// question "is this dependency resolved?", which lock_path_of / lock_hash_of
// cannot answer on their own (each is None for the other's source form).
pub function lock_has(entries: LockEntry[], name: string): boolean {
  let i: i32 = 0;
  while (i < entries.len()) {
    if (entries[i].name == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// lock_version_of returns the version pinned for `name`, or "".
pub function lock_version_of(entries: LockEntry[], name: string): string {
  let i: i32 = 0;
  while (i < entries.len()) {
    if (entries[i].name == name) {
      return entries[i].version + "";
    }
    i = i + 1;
  }
  return "";
}

// lock_path_of returns the resolved directory of a `path`-sourced locked
// dependency `name`, or None (undeclared, or a url source the self-host
// can't reach).
pub function lock_path_of(entries: LockEntry[], name: string): Option[string] {
  let i: i32 = 0;
  while (i < entries.len()) {
    if (entries[i].name == name && entries[i].path.len() > 0) {
      return Some(entries[i].path + "");
    }
    i = i + 1;
  }
  return None;
}

// lock_hash_of returns the `sha256:<hex>` hash of a url-sourced locked
// dependency `name`, or None — the store-resolution counterpart of
// lock_path_of (#4949).
pub function lock_hash_of(entries: LockEntry[], name: string): Option[string] {
  let i: i32 = 0;
  while (i < entries.len()) {
    if (entries[i].name == name && entries[i].hash.len() > 0) {
      return Some(entries[i].hash + "");
    }
    i = i + 1;
  }
  return None;
}
