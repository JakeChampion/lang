import "./util";
import "./capvocab";
import "./docsummary";

pub struct Dep {
  name: string,
  kind: string,
  path: string,
  url: string,
  hash: string,
  version: string,
  governed: boolean,
  caps: string[],
  line: i32,
}

pub struct Manifest {
  name: string,
  lib: string,
  index: string,
  deps: Dep[],
  members: string[],
  excl_pkg: string[],
  excl_ver: string[],
  lint_keys: string[],
  lint_vals: string[],
  err: string,
  err_line: i32,
}

function index_of(s: string, c: u8, from: i32): i32 {
  let i: i32 = from;
  while (i < s.len()) {
    if (s[i] == c) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function quoted_value(s: string, from: i32): Option[string] {
  let q1: i32 = index_of(s, b'"', from);
  if (q1 < 0) {
    return None;
  }
  let q2: i32 = index_of(s, b'"', q1 + 1);
  if (q2 < 0) {
    return None;
  }
  return Some(slice_unchecked(s, q1 + 1, q2) + "");
}

function split_char(src: string, c: u8): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < src.len()) {
    if (src[i] == c) {
      out = out.append(slice_unchecked(src, start, i) + "");
      start = i + 1;
    }
    i = i + 1;
  }
  out = out.append(slice_unchecked(src, start, src.len()) + "");
  return out;
}

pub function line_content(raw: string): string {
  let quoted: boolean = false;
  let i: i32 = 0;
  while (i < raw.len()) {
    if (raw[i] == b'"') {
      quoted = !quoted;
    } else if (raw[i] == b'#' && !quoted) {
      return util.trim(slice_unchecked(raw, 0, i));
    }
    i = i + 1;
  }
  return util.trim(raw);
}

function is_integer_text(s: string): boolean {
  let i: i32 = 0;
  if (s.len() > 1 && s[0] == b'-') {
    i = 1;
  }
  while (i < s.len()) {
    if (s[i] < b'0' || s[i] > b'9') {
      return false;
    }
    i = i + 1;
  }
  return s.len() > 0;
}

pub function parse(src: string): Manifest {
  let m: Manifest = Manifest {
    name: "", lib: "lib.fern", index: "", deps: [], members: [],
    excl_pkg: [], excl_ver: [], lint_keys: [], lint_vals: [], err: "", err_line: 0,
  };
  let package_line: i32 = 1;
  let workspace: boolean = false;
  let section: string = "";
  let seen: string[] = [];
  let lines: string[] = split_char(src, b'\n');
  let li: i32 = 0;
  while (li < lines.len() && m.err.len() == 0) {
    let line: string = line_content(lines[li]);
    li = li + 1;
    if (line.len() == 0) {
      continue;
    }
    if (line[0] == b'[') {
      if (line[line.len() - 1] != b']') {
        return Manifest { ...m, err: "malformed section header " + docsummary.quote(line), err_line: li };
      }
      section = util.trim(slice_unchecked(line, 1, line.len() - 1));
      if (section == "package") {
        package_line = li;
      }
      workspace = workspace || section == "workspace";
      m = Manifest { ...m, err: section_error(section, seen), err_line: li };
      seen = seen.append("[" + section + "]");
      continue;
    }
    m = Manifest { ...with_entry(m, section, line, li, seen), err_line: li };
    seen = seen.append(section + "\n" + entry_key(line));
  }
  if (m.err.len() == 0 && m.name.len() == 0 && !workspace) {
    return Manifest { ...m, err: "missing [package] name", err_line: package_line };
  }
  return m;
}

pub function diagnostic(path: string, m: Manifest): string {
  let at: string = util.i32_to_string(m.err_line) + ":1";
  if (path.len() > 0) {
    at = path + ":" + at;
  }
  return at + ": error[E088]: " + m.err;
}

function section_error(section: string, seen: string[]): string {
  let known: string[] = ["package", "dependencies", "workspace", "exclude", "lint", "lint.options"];
  if (!util.has_str(known, section)) {
    return "unknown section [" + section + "] (supported: [package], [dependencies], [workspace], [exclude], [lint], [lint.options])";
  }
  if (util.has_str(seen, "[" + section + "]")) {
    return "duplicate section [" + section + "]";
  }
  return "";
}

function entry_key(line: string): string {
  let eq: i32 = index_of(line, b'=', 0);
  if (eq < 0) {
    return "";
  }
  return util.trim(slice_unchecked(line, 0, eq));
}

function failed(m: Manifest, err: string): Manifest {
  return Manifest { ...m, err: err };
}

function with_entry(m: Manifest, section: string, line: string, at: i32, seen: string[]): Manifest {
  let eq: i32 = index_of(line, b'=', 0);
  if (eq < 0) {
    return failed(m, "expected `key = value`, got " + docsummary.quote(line));
  }
  let key: string = util.trim(slice_unchecked(line, 0, eq));
  let val: string = util.trim(slice_unchecked(line, eq + 1, line.len()));
  if (section.len() > 0 && util.has_str(seen, section + "\n" + key)) {
    return failed(m, "duplicate key " + docsummary.quote(key) + " in [" + section + "]");
  }
  if (section == "package") {
    return with_package_key(m, key, val);
  }
  if (section == "dependencies") {
    return with_dep(m, key, val, at);
  }
  if (section == "workspace") {
    return with_members(m, key, val);
  }
  if (section == "lint" || section == "lint.options") {
    return with_lint(m, section, key, val);
  }
  if (section == "exclude") {
    return with_exclude(m, key, val);
  }
  return failed(m, docsummary.quote(key) + " outside a section (start with [package], [dependencies], or [workspace])");
}

function with_package_key(m: Manifest, key: string, val: string): Manifest {
  match (parse_string(val)) {
    Ok(value) => {
      if (key == "name") {
        return Manifest { ...m, name: value };
      }
      if (key == "lib") {
        return Manifest { ...m, lib: value };
      }
      if (key == "index") {
        return Manifest { ...m, index: value };
      }
      if (key == "version") {
        return m;
      }
      return failed(m, "unknown [package] key " + docsummary.quote(key) + " (supported: name, version, lib, index)");
    },
    Err(message) => {
      return failed(m, key + ": " + message);
    }
  }
}

function with_dep(m: Manifest, key: string, val: string, at: i32): Manifest {
  match (parse_dep(key, val)) {
    Ok(d) => {
      if (!valid_dep_name(key)) {
        return failed(m, "invalid dependency name " + docsummary.quote(key) + " (letters, digits, `_`, `-`; must not start with a digit)");
      }
      return Manifest { ...m, deps: m.deps.append(Dep { ...d, line: at }) };
    },
    Err(message) => {
      return failed(m, "dependency " + docsummary.quote(key) + ": " + message);
    }
  }
}

function with_members(m: Manifest, key: string, val: string): Manifest {
  if (key != "members") {
    return failed(m, "unknown [workspace] key " + docsummary.quote(key) + " (supported: members)");
  }
  match (parse_str_array(val)) {
    Ok(members) => {
      return Manifest { ...m, members: members };
    },
    Err(message) => {
      return failed(m, "members: " + message);
    }
  }
}

function with_lint(m: Manifest, section: string, key: string, val: string): Manifest {
  match (parse_scalar(val)) {
    Ok(value) => {
      if (section == "lint.options" && index_of(key, b'.', 0) < 0) {
        return failed(m, "[lint.options] key " + docsummary.quote(key) + " must be spelled <rule>.<option>");
      }
      return Manifest { ...m, lint_keys: m.lint_keys.append(key), lint_vals: m.lint_vals.append(value) };
    },
    Err(message) => {
      return failed(m, "[" + section + "] " + key + ": " + message);
    }
  }
}

function with_exclude(m: Manifest, key: string, val: string): Manifest {
  if (!valid_dep_name(key)) {
    return failed(m, "invalid [exclude] package name " + docsummary.quote(key) + " (letters, digits, `_`, `-`; must not start with a digit)");
  }
  match (parse_str_array(val)) {
    Ok(versions) => {
      let excl_pkg: string[] = m.excl_pkg;
      let excl_ver: string[] = m.excl_ver;
      for v in versions {
        if (!is_version(v)) {
          return failed(m, "exclude " + key + ": version must be MAJOR.MINOR.PATCH digits, got " + docsummary.quote(v));
        }
        excl_pkg = excl_pkg.append(key);
        excl_ver = excl_ver.append(v);
      }
      return Manifest { ...m, excl_pkg: excl_pkg, excl_ver: excl_ver };
    },
    Err(message) => {
      return failed(m, "exclude " + key + ": " + message);
    }
  }
}

function parse_string(val: string): Result[string, string] {
  if (val.len() < 2 || val[0] != b'"' || val[val.len() - 1] != b'"') {
    return Err("expected a double-quoted string, got " + docsummary.quote(val));
  }
  let s: string = slice_unchecked(val, 1, val.len() - 1) + "";
  if (index_of(s, b'"', 0) >= 0 || index_of(s, b'\\', 0) >= 0) {
    return Err("escapes are not supported in " + docsummary.quote(val) + " (use forward slashes in paths)");
  }
  return Ok(s);
}

function parse_scalar(val: string): Result[string, string] {
  if (val.len() > 0 && val[0] == b'"') {
    return parse_string(val);
  }
  if (val.len() == 0) {
    return Err("expected a quoted string or a number, got an empty value");
  }
  if (!is_integer_text(val)) {
    return Err("expected a quoted string or a number, got " + docsummary.quote(val));
  }
  return Ok(val);
}

function parse_str_array(val: string): Result[string[], string] {
  if (val.len() < 2 || val[0] != b'[' || val[val.len() - 1] != b']') {
    return Err("expected an array like [\"a\", \"b\"], got " + docsummary.quote(val));
  }
  let out: string[] = [];
  for raw in split_char(slice_unchecked(val, 1, val.len() - 1) + "", b',') {
    let part: string = util.trim(raw);
    if (part.len() > 0) {
      match (parse_string(part)) {
        Ok(value) => {
          out = out.append(value);
        },
        Err(message) => {
          return Err(message);
        }
      }
    }
  }
  return Ok(out);
}

pub function is_version(s: string): boolean {
  let parts: string[] = split_char(s, b'.');
  if (parts.len() != 3) {
    return false;
  }
  for p in parts {
    if (p.len() == 0 || p[0] == b'-' || !is_integer_text(p)) {
      return false;
    }
  }
  return true;
}

pub function valid_dep_name(s: string): boolean {
  if (s.len() == 0 || is_digit(s[0])) {
    return false;
  }
  for c in s {
    if (!is_digit(c) && !is_letter(c) && c != b'_' && c != b'-') {
      return false;
    }
  }
  return true;
}

function is_digit(c: u8): boolean {
  return c >= b'0' && c <= b'9';
}

function is_letter(c: u8): boolean {
  return c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z';
}

pub function validate_hash(hash: string): Result[string, string] {
  let bad: string = "must be `sha256:` + 64 lowercase hex digits of the archive bytes, got "
    + docsummary.quote(hash);
  if (hash.len() < 7 || slice_unchecked(hash, 0, 7) != "sha256:") {
    return Err(bad);
  }
  let hex: string = slice_unchecked(hash, 7, hash.len()) + "";
  if (hex.len() != 64) {
    return Err(bad);
  }
  let i: i32 = 0;
  while (i < hex.len()) {
    let c: u8 = hex[i];
    let digit: boolean = c >= b'0' && c <= b'9';
    let lower: boolean = c >= b'a' && c <= b'f';
    if (!digit && !lower) {
      return Err(bad);
    }
    i = i + 1;
  }
  return Ok(hex);
}

function parse_dep(name: string, val: string): Result[Dep, string] {
  let d: Dep = Dep { name: name, kind: "", path: "", url: "", hash: "", version: "", governed: false, caps: [], line: 0 };
  if (val.len() == 0 || val[0] != b'{') {
    match (parse_string(val)) {
      Ok(value) => {
        match (with_dep_string(d, "version", value)) {
          Ok(dep) => {
            return classified(dep);
          },
          Err(message) => {
            return Err(message);
          }
        }
      },
      Err(message) => {
        return Err("a bare dependency value must be a version string like \"1.2.0\" (or use an inline table): " + message);
      }
    }
  }
  if (val[val.len() - 1] != b'}') {
    return Err("malformed inline table " + docsummary.quote(val));
  }
  for raw in inline_parts(util.trim(slice_unchecked(val, 1, val.len() - 1))) {
    let part: string = util.trim(raw);
    if (part.len() > 0) {
      match (with_dep_field(d, part)) {
        Ok(dep) => {
          d = dep;
        },
        Err(message) => {
          return Err(message);
        }
      }
    }
  }
  return classified(d);
}

function with_dep_field(d: Dep, part: string): Result[Dep, string] {
  let eq: i32 = index_of(part, b'=', 0);
  if (eq < 0) {
    return Err("expected `key = value` in inline table, got " + docsummary.quote(part));
  }
  let k: string = util.trim(slice_unchecked(part, 0, eq));
  let v: string = util.trim(slice_unchecked(part, eq + 1, part.len()));
  if (k == "workspace") {
    if (v != "true") {
      return Err("workspace must be `true` (the only supported value), got " + docsummary.quote(v));
    }
    return Ok(Dep { ...d, kind: "workspace" });
  }
  if (k == "capabilities") {
    match (parse_capabilities(v)) {
      Ok(caps) => {
        return Ok(Dep { ...d, governed: true, caps: caps });
      },
      Err(message) => {
        return Err("capabilities: " + message);
      }
    }
  }
  match (parse_string(v)) {
    Ok(value) => {
      return with_dep_string(d, k, value);
    },
    Err(message) => {
      return Err(k + ": " + message);
    }
  }
}

function with_dep_string(d: Dep, k: string, s: string): Result[Dep, string] {
  if (k == "path") {
    if (s.len() == 0) {
      return Err("path must not be empty");
    }
    return Ok(Dep { ...d, path: s });
  }
  if (k == "url") {
    if (!util.str_has_prefix(s, "https://") && !util.str_has_prefix(s, "http://")) {
      return Err("url must be http(s), got " + docsummary.quote(s));
    }
    return Ok(Dep { ...d, url: s });
  }
  if (k == "hash") {
    if let Err(message) = validate_hash(s) {
      return Err("hash " + message);
    }
    return Ok(Dep { ...d, hash: s });
  }
  if (k == "version") {
    if (!is_version(s)) {
      return Err("version must be MAJOR.MINOR.PATCH digits, got " + docsummary.quote(s));
    }
    return Ok(Dep { ...d, version: s });
  }
  return Err("unknown dependency key " + docsummary.quote(k) + " (supported: path, url, hash, workspace, version, capabilities)");
}

function classified(d: Dep): Result[Dep, string] {
  let remote: boolean = d.url.len() > 0 || d.hash.len() > 0;
  if (d.kind == "workspace") {
    if (d.path.len() > 0 || remote || d.version.len() > 0) {
      return Err("a `workspace` dependency takes no path/url/hash/version");
    }
    return Ok(d);
  }
  if (d.version.len() > 0) {
    if (d.path.len() > 0 || remote) {
      return Err("a `version` dependency takes no path/url/hash (the version resolves through the index)");
    }
    return Ok(Dep { ...d, kind: "version" });
  }
  return source_classified(d, remote);
}

function source_classified(d: Dep, remote: boolean): Result[Dep, string] {
  if (d.path.len() > 0) {
    if (remote) {
      return Err("a dependency is either `path` or `url`+`hash`, not both");
    }
    return Ok(Dep { ...d, kind: "path" });
  }
  if (d.url.len() > 0 && d.hash.len() > 0) {
    return Ok(Dep { ...d, kind: "url" });
  }
  if (remote) {
    return Err("url dependencies need BOTH `url` and `hash` — the hash is the identity, the url just a mirror hint");
  }
  return Err("missing `path` (or `url` + `hash`, `workspace = true`, or a version)");
}

function inline_parts(body: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let depth: i32 = 0;
  let quoted: boolean = false;
  let i: i32 = 0;
  while (i < body.len()) {
    let c: u8 = body[i];
    if (c == b'"') {
      quoted = !quoted;
    } else if (!quoted && c == b'[') {
      depth = depth + 1;
    } else if (!quoted && c == b']') {
      depth = depth - 1;
    } else if (!quoted && c == b',' && depth == 0) {
      out = out.append(slice_unchecked(body, start, i) + "");
      start = i + 1;
    }
    i = i + 1;
  }
  return out.append(slice_unchecked(body, start, body.len()) + "");
}

pub function parse_capabilities(val: string): Result[string[], string] {
  match (parse_str_array(val)) {
    Ok(names) => {
      for name in names {
        if (!util.has_str(capvocab.capabilities(), name)) {
          return Err("unknown capability " + docsummary.quote(name) + " (valid capabilities: " + capability_choices() + ")");
        }
      }
      return Ok(ordered_caps(names));
    },
    Err(message) => {
      return Err(message);
    }
  }
}

function capability_choices(): string {
  let out: string = "";
  for cap in capvocab.capabilities() {
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + cap;
  }
  return out;
}

function ordered_caps(values: string[]): string[] {
  let out: string[] = [];
  for cap in capvocab.capabilities() {
    if (util.has_str(values, cap)) {
      out = out.append(cap);
    }
  }
  return out;
}

pub function dep_path(m: Manifest, name: string): Option[string] {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name && m.deps[i].kind == "path") {
      return Some(m.deps[i].path + "");
    }
    i = i + 1;
  }
  return None;
}

pub function has_dep(m: Manifest, name: string): boolean {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function dep_kind(m: Manifest, name: string): string {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name) {
      return m.deps[i].kind + "";
    }
    i = i + 1;
  }
  return "";
}

pub function dep_names(m: Manifest): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < m.deps.len()) {
    out = out.append(m.deps[i].name + "");
    i = i + 1;
  }
  return out;
}

pub function dep_governed(m: Manifest, name: string): boolean {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name) {
      return m.deps[i].governed;
    }
    i = i + 1;
  }
  return false;
}

pub function dep_caps(m: Manifest, name: string): string[] {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name) {
      return m.deps[i].caps;
    }
    i = i + 1;
  }
  let empty: string[] = [];
  return empty;
}

pub function dep_hash(m: Manifest, name: string): Option[string] {
  let i: i32 = 0;
  while (i < m.deps.len()) {
    if (m.deps[i].name == name && m.deps[i].kind == "url" && m.deps[i].hash.len() > 0) {
      return Some(m.deps[i].hash + "");
    }
    i = i + 1;
  }
  return None;
}

pub struct LockEntry {
  name: string,
  version: string,
  path: string,
  url: string,
  hash: string,
}

pub struct LockResult {
  entries: LockEntry[],
  err: string,
}

pub function parse_lock(src: string): LockResult {
  let out: LockEntry[] = [];
  let blank: LockEntry = LockEntry { name: "", version: "", path: "", url: "", hash: "" };
  let cur: LockEntry = blank;
  let have: boolean = false;
  let lines: string[] = split_char(src, b'\n');
  let li: i32 = 0;
  while (li < lines.len()) {
    let line: string = line_content(lines[li]);
    li = li + 1;
    if (line == "[[package]]") {
      if (have) {
        out = out.append(cur);
      }
      cur = blank;
      have = true;
      continue;
    }
    let eq: i32 = index_of(line, b'=', 0);
    if (eq < 0) {
      continue;
    }
    let key: string = util.trim(slice_unchecked(line, 0, eq));
    match (quoted_value(util.trim(slice_unchecked(line, eq + 1, line.len())), 0)) {
      Some(v) => {
        if (key == "hash") {
          if let Err(message) = validate_hash(v) {
            let none: LockEntry[] = [];
            return LockResult { entries: none, err: "fern.lock line "
              + util.i32_to_string(li) + ": hash " + message };
          }
        }
        cur = with_lock_field(cur, key, v);
      },
      None => {}
    }
  }
  if (have) {
    out = out.append(cur);
  }
  return LockResult { entries: out, err: "" };
}

function with_lock_field(e: LockEntry, key: string, v: string): LockEntry {
  if (key == "name") {
    return LockEntry { ...e, name: v };
  }
  if (key == "version") {
    return LockEntry { ...e, version: v };
  }
  if (key == "path") {
    return LockEntry { ...e, path: v };
  }
  if (key == "url") {
    return LockEntry { ...e, url: v };
  }
  if (key == "hash") {
    return LockEntry { ...e, hash: v };
  }
  return e;
}

pub function lock_has(entries: LockEntry[], name: string): boolean {
  let i: i32 = 0;
  while (i < entries.len()) {
    if (entries[i].name == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function lock_version_of(entries: LockEntry[], name: string): string {
  let i: i32 = 0;
  while (i < entries.len()) {
    if (entries[i].name == name) {
      return entries[i].version + "";
    }
    i = i + 1;
  }
  return "";
}

pub function lock_path_of(entries: LockEntry[], name: string): Option[string] {
  let i: i32 = 0;
  while (i < entries.len()) {
    if (entries[i].name == name && entries[i].path.len() > 0) {
      return Some(entries[i].path + "");
    }
    i = i + 1;
  }
  return None;
}

pub function lock_hash_of(entries: LockEntry[], name: string): Option[string] {
  let i: i32 = 0;
  while (i < entries.len()) {
    if (entries[i].name == name && entries[i].hash.len() > 0) {
      return Some(entries[i].hash + "");
    }
    i = i + 1;
  }
  return None;
}
