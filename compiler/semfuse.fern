// Producer-consumer fusion of std/array pipelines (#11072): a chain of `map`,
// `filter`, `take`, `take_while` and `flat_map` stages ending in `fold`,
// `reduce` or `scan` becomes one loop, with an inner loop per `flat_map`.
// Intermediate arrays are never built; scan reserves its output once. A lazy
// core/iter chain (#6795) fuses the same way: `iter.of(xs)` or
// `iter.range(lo, hi)`, then `map`, `filter`, `take` and `flat_map` adapters,
// ending in `fold` or `count`. Its adapter calls take the place of stages, and
// its root is replaced by the array or the integers the loop runs over. This
// runs on the typed semantic graphs every backend lowers from, before
// ownership planning accounts for the output.
//
// docs/ARRAY-FUSION-OPERATORS.md is the contract: each stage contributes a
// step (pass through, rebind, skip, stop, or loop over many), the fused body
// is the steps concatenated. Each sink seeds and finishes its accumulator; scan also appends
// each prefix to its output. docs/ARRAY-ALGEBRA.md §1 is the purity boundary: every
// element function is a closure built here whose body reaches no effect, since
// fusing interleaves the stages' calls.
//
// A chain is refused, and left exactly as it was, unless:
//   - each intermediate has one use, the next stage, so nothing else reads
//     the array the loop never builds;
//   - the stages and the sink sit in one block with nothing but inert values
//     between them, so no effect moves relative to the stages' calls;
//   - every element and the accumulator is a scalar, and a `flat_map`'s
//     function returns an array of them;
//   - no stage ahead of a `take` or `take_while` can abort, since the stop
//     skips the applications the eager chain would make past it.
import "./ssa";
import "./ssasem";
import "./semtypes";
import "./typeinfo";
import "./util";
import "./semarrayreport";

// What the pass made of each function, and whether it rewrote the graph.
pub struct Fused { funcs: ssasem.Func[], rewritten: boolean[], sites: semarrayreport.Site[] }

// `index` finds a body by the name a call carries; `verbs[i]` is the std/array
// combinator body i is, or ""; `bad[i]` says body i can reach an effect. A
// body that was not produced is no combinator and counts as effectful. `any`
// says the module holds a combinator at all.
// `aborts[i]` says body i may abort.
struct Context { index: util.NameIndex, verbs: string[], report_verbs: string[], bad: boolean[], aborts: boolean[], any: boolean }

// One recognised chain. `stages` are instruction positions in `block`, head
// first, with `verbs` and the element function values `fns` beside them.
// `roots` holds the position of the core/iter call the chain starts from, when
// it does, which goes with the stages: `of(xs)`, after which `base` is `xs`,
// or `range(lo, hi)`, after which `base` is `lo` and `hi` its bound. `hi` is
// -1 for a chain over an array.
struct Chain { ok: boolean, block: i32, sink: i32, verb: string, stages: i32[], verbs: string[], fns: i32[], base: i32, roots: i32[], hi: i32 }

struct Def { block: i32, pos: i32 }

struct Decision { reason: i32, stage: i32 }

// `usable[i]` says body i was produced and may be read and rewritten.
// `stdlib` and `iter_lib` name the bodies std/array and core/iter supplied.
pub function fuse_pipelines(funcs: ssasem.Func[], names: string[], usable: boolean[], stdlib: string[], iter_lib: string[], enabled: boolean, report: boolean): Fused {
  let cx: Context = context(funcs, names, usable, util.name_index(stdlib), util.name_index(iter_lib), report);
  let out: ssasem.Func[] = [];
  let rewritten: boolean[] = [];
  let sites: semarrayreport.Site[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let f: ssasem.Func = funcs[i];
    let changed: boolean = false;
    if (cx.any && usable[i] && cx.verbs[i] == "") {
      let c: Chain = no_chain();
      if (enabled) {
        c = find_chain(f, cx);
      }
      while (c.ok) {
        if (report) {
          sites = sites.append(fused_site(f, c, names[i]));
        }
        f = fuse(f, c);
        changed = true;
        c = find_chain(f, cx);
      }
      if (report) {
        sites = util.append_all(sites, remaining_sites(f, cx, names[i], enabled));
      }
    }
    out = out.append(f);
    rewritten = rewritten.append(changed);
    i = i + 1;
  }
  return Fused { funcs: out, rewritten: rewritten, sites: sites };
}

@noinline
function context(funcs: ssasem.Func[], names: string[], usable: boolean[], trusted: util.NameIndex, iter_trusted: util.NameIndex, report: boolean): Context {
  let index: util.NameIndex = util.name_index(names);
  let verbs: string[] = [];
  let report_verbs: string[] = [];
  let any: boolean = false;
  let i: i32 = 0;
  while (i < funcs.len()) {
    let v: string = fn_verb(usable[i], names[i], trusted, iter_trusted);
    if (report) {
      report_verbs = report_verbs.append(v);
    }
    if (!util.has_str(["map", "filter", "take", "take_while", "flat_map", "fold", "reduce", "scan", "count", "of", "range"], v)) {
      v = "";
    }
    verbs = verbs.append(v);
    any = any || v != "" || report && report_verbs[i] != "";
    i = i + 1;
  }
  // A module with no combinator body has no chain, and is spared the effect
  // analysis.
  if (!any) {
    return Context { index: index, verbs: verbs, report_verbs: report_verbs, bad: [], aborts: [], any: false };
  }
  return Context { index: index, verbs: verbs, report_verbs: report_verbs, bad: effectful(funcs, usable, index), aborts: may_abort(funcs, usable, index), any: true };
}

// fn_verb is the combinator a usable body from std/array or core/iter
// implements, by its name.
function fn_verb(usable: boolean, name: string, trusted: util.NameIndex, iter_trusted: util.NameIndex): string {
  if (!usable) {
    return "";
  }
  if (trusted.has(name)) {
    return verb_of(name);
  }
  if (iter_trusted.has(name)) {
    return iter_verb_of(name);
  }
  return "";
}

// ---- recognition ----------------------------------------------------------

// Name recognition follows the loader-origin check in context. Neither a
// basename nor a call to a stdlib function proves a user's wrapper equivalent
// to that function. The trusted free functions and array-method wrappers keep
// these names through instantiation, with `__` or `$` suffixes.
function verb_of(name: string): string {
  if (!util.str_has_prefix(name, "__arrm_") && !util.str_has_prefix(name, "array__")) {
    return "";
  }
  let v: string = slice_unchecked(name, 7, suffix_at(name, 7)) + "";
  if (util.has_str(["map", "filter", "fold", "reduce", "scan", "zip", "take", "take_while", "drop", "drop_while", "flat_map", "flatten", "chunks", "chunks_exact", "windows", "partition", "enumerate", "reverse"], v)) {
    return v;
  }
  return "";
}

// The core/iter body a trusted name is: `of` or `range`, which start an
// iterator over an array or a run of integers, or a lazy adapter or sink of
// the Iterator trait. An adapter or sink
// with no type parameter of its own is a method, `Recv.verb`; one with its own
// is folded to `__smm_<Recv>_<verb>`, and a type name is never a lower-case
// verb, so the first `_<verb>` there that a suffix or the end follows is it.
function iter_verb_of(name: string): string {
  let verbs: string[] = ["map", "filter", "take", "flat_map", "skip", "enumerate", "zip", "fold", "count", "collect", "find", "any", "all"];
  let n: string = slice_unchecked(name, 0, dollar_at(name)) + "";
  if (n == "iter__range") {
    return "range";
  }
  if (util.str_has_prefix(n, "iter__of")) {
    if (n.len() == 8 || util.str_has_prefix(slice_unchecked(n, 8, n.len()) + "", "__")) {
      return "of";
    }
    return "";
  }
  let dot: i32 = last_dot(n);
  if (dot >= 0) {
    let m: string = slice_unchecked(n, dot + 1, n.len()) + "";
    if (util.has_str(verbs, m)) {
      return m;
    }
    return "";
  }
  if (!util.str_has_prefix(n, "__smm_")) {
    return "";
  }
  return smm_verb(n, verbs);
}

// smm_verb is the verb a folded method's name `__smm_<Base>_<verb>...` ends
// its base with, the earliest one when several match.
function smm_verb(n: string, verbs: string[]): string {
  let best: i32 = n.len();
  let found: string = "";
  for v in verbs {
    let at: i32 = verb_end(n, "_" + v);
    if (at >= 0 && at < best) {
      best = at;
      found = v;
    }
  }
  return found;
}

// Where `_verb` first stands in `n` followed by `__` or the end, or -1.
function verb_end(n: string, tag: string): i32 {
  let at: i32 = 6;
  while (at + tag.len() <= n.len()) {
    let end: i32 = at + tag.len();
    if (slice_unchecked(n, at, end) == tag && (end == n.len() || end + 1 < n.len() && n[end] == b'_' && n[end + 1] == b'_')) {
      return at;
    }
    at = at + 1;
  }
  return 0 - 1;
}

function last_dot(n: string): i32 {
  let i: i32 = n.len() - 1;
  while (i >= 0 && n[i] != b'.') {
    i = i - 1;
  }
  return i;
}

function dollar_at(name: string): i32 {
  let i: i32 = 0;
  while (i < name.len() && name[i] != b'$') {
    i = i + 1;
  }
  return i;
}

// Where the instance suffixes start: the first `$` or `__` at or after `from`.
function suffix_at(name: string, from: i32): i32 {
  let end: i32 = from;
  while (end < name.len() && name[end] != b'$' && !(name[end] == b'_' && end + 1 < name.len() && name[end + 1] == b'_')) {
    end = end + 1;
  }
  return end;
}

function verb_at(cx: Context, callee: string): string {
  let at: i32 = cx.index.find(callee);
  if (at < 0) {
    return "";
  }
  return cx.verbs[at];
}

function report_verb(cx: Context, callee: string): string {
  let at: i32 = cx.index.find(callee);
  if (at < 0 || at >= cx.report_verbs.len()) {
    return "";
  }
  return cx.report_verbs[at];
}

// ---- the purity boundary --------------------------------------------------

// The kinds that compute a value and nothing else. Everything outside the
// list counts as an effect: a call through a function value (its target is
// not known here), a cell write, a map iterator's cursor, and any kind added
// later until it is placed here on purpose. A direct call is pure when its
// callee is, which `effectful` settles over the whole module.
//
// The semantic kinds are numbered downward without gaps, so the pure ones are
// two runs: `array_new` through `arr_slice` less the call through a value and
// the cell write, and `dyn_up` through `dyn_as`, and then `arr_concat`. The
// map iterator kinds sit between the runs; the holes and anything newer
// sit past the second.
function pure_kind(k: i32): boolean {
  if (k >= 1) {
    return k <= 10;
  }
  if (k == ssasem.call_value() || k == ssasem.cell_set()) {
    return false;
  }
  return k >= ssasem.arr_slice() || k <= ssasem.dyn_up() && k >= ssasem.dyn_as() || k == ssasem.arr_concat();
}

function direct_effect(f: ssasem.Func): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (!pure_kind(ins.kind_tag)) {
        return true;
      }
    }
  }
  return false;
}

// A body is effectful when it holds an effect or calls anything that is not a
// pure body of this module: a builtin, an unproduced body, or an effectful
// one. Recursion between pure bodies stays pure: the walk only ever marks.
function effectful(funcs: ssasem.Func[], usable: boolean[], index: util.NameIndex): boolean[] {
  let bad: boolean[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    bad = bad.append(!usable[i] || direct_effect(funcs[i]));
    i = i + 1;
  }
  return through_calls(funcs, bad, index);
}

// docs/ARRAY-ALGEBRA.md §2: what aborts is an index or slice out of range and
// an allocation that does not fit; integer division is total and float
// arithmetic does not trap. So a body that only computes scalars, converts
// them, and reads its captures cannot abort, and anything else may.
function aborting_kind(k: i32): boolean {
  if (k >= 1) {
    return k > 10;
  }
  return k != ssasem.call() && k != ssasem.cast() && k != ssasem.tuple_get() && k != ssasem.record_get() && k != ssasem.zero();
}

function direct_abort(f: ssasem.Func): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (aborting_kind(ins.kind_tag) || concatenates(f, ins)) {
        return true;
      }
    }
  }
  return false;
}

// A `+` that yields text joins two strings into a fresh allocation.
function concatenates(f: ssasem.Func, ins: ssa.SInst): boolean {
  return ins.kind_tag == 9 && ins.str == "+" && ssasem.is_text(f.values[ins.result]);
}

function may_abort(funcs: ssasem.Func[], usable: boolean[], index: util.NameIndex): boolean[] {
  let bad: boolean[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    bad = bad.append(!usable[i] || direct_abort(funcs[i]));
    i = i + 1;
  }
  return through_calls(funcs, bad, index);
}

// Spreads `bad` from callee to caller until nothing changes.
function through_calls(funcs: ssasem.Func[], bad: boolean[], index: util.NameIndex): boolean[] {
  let i: i32 = 0;
  let changed: boolean = true;
  while (changed) {
    changed = false;
    i = 0;
    while (i < funcs.len()) {
      if (!bad[i] && calls_bad(funcs[i], bad, index)) {
        bad = bad.with(i, true);
        changed = true;
      }
      i = i + 1;
    }
  }
  return bad;
}

function calls_bad(f: ssasem.Func, bad: boolean[], index: util.NameIndex): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call()) {
        let at: i32 = index.find(ins.str);
        if (at < 0 || bad[at]) {
          return true;
        }
      }
    }
  }
  return false;
}

// ---- finding a chain ------------------------------------------------------

function no_chain(): Chain {
  return Chain { ok: false, block: 0, sink: 0, verb: "", stages: [], verbs: [], fns: [], base: 0, roots: [], hi: 0 - 1 };
}

@noinline
function find_chain(f: ssasem.Func, cx: Context): Chain {
  let uses: i32[] = use_counts(f.graph);
  let defs: Def[] = defs_of(f.graph);
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let k: i32 = 0;
    while (k < f.graph.blocks[bi].insts.len()) {
      let c: Chain = chain_at(f, cx, uses, defs, bi, k);
      if (c.ok) {
        return c;
      }
      k = k + 1;
    }
    bi = bi + 1;
  }
  return no_chain();
}

// The chain whose sink is the instruction at (bi, k), walked back from the
// sink through every intermediate that only its next stage reads.
function chain_at(f: ssasem.Func, cx: Context, uses: i32[], defs: Def[], bi: i32, k: i32): Chain {
  let sink: ssa.SInst = f.graph.blocks[bi].insts[k];
  let verb: string = sink_verb(sink, cx);
  if (verb == "") {
    return no_chain();
  }
  let c: Chain = Chain { ...no_chain(), block: bi, sink: k, verb: verb, base: sink.args[0] };
  let d: Def = defs[c.base];
  while (d.block == bi && uses[c.base] == 1 && stage_verb(f.graph.blocks[bi].insts[d.pos], cx) != "") {
    let p: ssa.SInst = f.graph.blocks[bi].insts[d.pos];
    c = Chain { ...c, stages: prepend(d.pos, c.stages), verbs: prepend_str(stage_verb(p, cx), c.verbs), fns: prepend(p.args[1], c.fns), base: p.args[0] };
    d = defs[c.base];
  }
  if (d.block == bi && uses[c.base] == 1) {
    c = with_root(c, cx, f.graph.blocks[bi].insts[d.pos], d.pos);
  }
  return Chain { ...c, ok: admissible(f, cx, defs, c) };
}

// with_root takes a lazy chain's `of(xs)` or `range(lo, hi)` root at `pos` into
// the chain, whose base becomes the root's array or lower bound.
function with_root(c: Chain, cx: Context, r: ssa.SInst, pos: i32): Chain {
  if (r.kind_tag != ssasem.call()) {
    return c;
  }
  if (r.args.len() == 1 && verb_at(cx, r.str) == "of") {
    return Chain { ...c, roots: [pos], base: r.args[0] };
  }
  if (r.args.len() == 2 && verb_at(cx, r.str) == "range") {
    return Chain { ...c, roots: [pos], base: r.args[0], hi: r.args[1] };
  }
  return c;
}

function sink_verb(ins: ssa.SInst, cx: Context): string {
  if (ins.kind_tag != ssasem.call()) {
    return "";
  }
  let v: string = verb_at(cx, ins.str);
  if ((v == "fold" || v == "scan") && ins.args.len() == 3 || v == "reduce" && ins.args.len() == 2 || v == "count" && ins.args.len() == 1) {
    return v;
  }
  return "";
}

function admissible(f: ssasem.Func, cx: Context, defs: Def[], c: Chain): boolean {
  return decision(f, cx, defs, c).reason == semarrayreport.fusion_fused();
}

function decision(f: ssasem.Func, cx: Context, defs: Def[], c: Chain): Decision {
  if (c.stages.len() == 0 && c.roots.len() == 0) {
    return absent_producer(f, cx, defs, c);
  }
  // A lazy chain is fused over the array an `of` iterates or the integers a
  // `range` counts, and no other iterator.
  if (c.hi < 0 && !is_array(f.values[c.base])) {
    return Decision { reason: semarrayreport.fusion_no_producer(), stage: first_pos(c) };
  }
  let between: i32 = effect_between(f.graph.blocks[c.block], c);
  if (between >= 0) {
    return Decision { reason: semarrayreport.fusion_effect_boundary(), stage: between };
  }
  let purity: Decision = purity_decision(f, cx, defs, c);
  if (purity.reason != semarrayreport.fusion_fused()) {
    return purity;
  }
  let non_scalar: i32 = non_scalar_stage(f, c);
  if (non_scalar >= 0) {
    return Decision { reason: semarrayreport.fusion_non_scalar(), stage: non_scalar };
  }
  return Decision { reason: semarrayreport.fusion_fused(), stage: c.sink };
}

function absent_producer(f: ssasem.Func, cx: Context, defs: Def[], c: Chain): Decision {
  let d: Def = defs[c.base];
  if (d.block >= 0) {
    let ins: ssa.SInst = f.graph.blocks[d.block].insts[d.pos];
    if (stage_verb(ins, cx) != "") {
      if (d.block != c.block) {
        return Decision { reason: semarrayreport.fusion_control_flow_boundary(), stage: c.sink };
      }
      return Decision { reason: semarrayreport.fusion_intermediate_shared(), stage: d.pos };
    }
    if (d.block == c.block && ins.kind_tag == ssasem.call() && report_verb(cx, ins.str) != "" && sink_verb(ins, cx) == "") {
      return Decision { reason: semarrayreport.fusion_operator_outside_algebra(), stage: d.pos };
    }
  }
  return Decision { reason: semarrayreport.fusion_no_producer(), stage: c.sink };
}

function stage_verb(ins: ssa.SInst, cx: Context): string {
  if (ins.kind_tag != ssasem.call() || ins.args.len() != 2) {
    return "";
  }
  let v: string = verb_at(cx, ins.str);
  if (util.has_str(["map", "filter", "take", "take_while", "flat_map"], v)) {
    return v;
  }
  return "";
}

// Between the first stage and the sink, only values that read nothing but
// their operands: the closures and the seed the stages are handed. A call
// there would run before stages it used to follow.
function effect_between(b: ssa.SBlock, c: Chain): i32 {
  let p: i32 = first_pos(c) + 1;
  while (p < c.sink) {
    let k: i32 = b.insts[p].kind_tag;
    if (!removed(c, p) && (k == ssasem.call() || !pure_kind(k))) {
      return p;
    }
    p = p + 1;
  }
  return 0 - 1;
}

// Every element function, and the sink's, is a closure built in this body
// whose own body reaches no effect. A stage ahead of a `take` or `take_while`
// loses the applications past the stop, so its function must also be unable
// to abort.
// A `take`'s operand is its count, not a function.
function purity_decision(f: ssasem.Func, cx: Context, defs: Def[], c: Chain): Decision {
  let sink: ssa.SInst = f.graph.blocks[c.block].insts[c.sink];
  let last_take: i32 = last_take_of(c.verbs);
  let j: i32 = 0;
  for v in checked_fns(c, sink) {
    let stage: i32 = c.sink;
    if (j < c.stages.len()) {
      stage = c.stages[j];
    }
    if (j >= c.verbs.len() || c.verbs[j] != "take") {
      let d: Decision = fn_decision(f, cx, defs[v], stage, j < last_take);
      if (d.reason != semarrayreport.fusion_fused()) {
        return d;
      }
    }
    j = j + 1;
  }
  return Decision { reason: semarrayreport.fusion_fused(), stage: c.sink };
}

// checked_fns is every stage's operand and the sink's function; a count has
// none of its own.
function checked_fns(c: Chain, sink: ssa.SInst): i32[] {
  if (c.verb == "count") {
    return c.fns;
  }
  return c.fns.append(sink.args[sink.args.len() - 1]);
}

function last_take_of(verbs: string[]): i32 {
  let last: i32 = 0 - 1;
  let j: i32 = 0;
  while (j < verbs.len()) {
    if (verbs[j] == "take" || verbs[j] == "take_while") {
      last = j;
    }
    j = j + 1;
  }
  return last;
}

// fn_decision judges one element function: a closure built in this body whose
// own body reaches no effect, and that cannot abort when a take follows it.
function fn_decision(f: ssasem.Func, cx: Context, d: Def, stage: i32, before_take: boolean): Decision {
  if (d.block < 0) {
    return Decision { reason: semarrayreport.fusion_element_fn_unresolved(), stage: stage };
  }
  let ins: ssa.SInst = f.graph.blocks[d.block].insts[d.pos];
  let at: i32 = cx.index.find(ins.str);
  if (ins.kind_tag != ssasem.closure_new() || at < 0) {
    return Decision { reason: semarrayreport.fusion_element_fn_unresolved(), stage: stage };
  }
  if (cx.bad[at]) {
    return Decision { reason: semarrayreport.fusion_element_fn_effectful(), stage: stage };
  }
  if (before_take && cx.aborts[at]) {
    return Decision { reason: semarrayreport.fusion_element_fn_may_abort(), stage: stage };
  }
  return Decision { reason: semarrayreport.fusion_fused(), stage: stage };
}

// Successful entries are captured immediately before their actual rewrite.
// Refusals are read from the final graph, so a partially fused chain cannot
// claim that its retained prefix was eliminated too.
function stage_name(ins: ssa.SInst): string {
  let name: string = ins.str;
  if (name == "") {
    name = "op" + util.i32_to_string(ins.kind_tag);
  }
  return name + "@v" + util.i32_to_string(ins.result);
}

function chain_text(c: Chain): string {
  let out: string = "";
  if (c.roots.len() > 0 && c.hi >= 0) {
    out = "range -> ";
  } else if (c.roots.len() > 0) {
    out = "of -> ";
  }
  for v in c.verbs {
    out = out + v + " -> ";
  }
  return out + c.verb;
}

function fused_site(f: ssasem.Func, c: Chain, name: string): semarrayreport.Site {
  let storage: string = "no-intermediate-arrays";
  if (c.verb == "scan") {
    storage = "no-intermediate-arrays/one-output-buffer";
  }
  // A flat_map can yield more elements than the input has, past the reserve.
  if (c.verb == "scan" && util.has_str(c.verbs, "flat_map")) {
    storage = "no-intermediate-arrays/grown-output-buffer";
  }
  return semarrayreport.Site { owner: name, stage: stage_name(f.graph.blocks[c.block].insts[c.sink]), plan: chain_text(c) + "; one traversal", reason: semarrayreport.fusion_fused(), storage: storage };
}

function escapes(f: ssasem.Func, value: i32): boolean {
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1 && b.term.value == value) {
      return true;
    }
  }
  return false;
}

function standalone_reason(f: ssasem.Func, ins: ssa.SInst, uses: i32[]): i32 {
  if (uses[ins.result] > 1) {
    return semarrayreport.fusion_intermediate_shared();
  }
  if (escapes(f, ins.result)) {
    return semarrayreport.fusion_result_escapes();
  }
  return semarrayreport.fusion_no_reduction_sink();
}

function remaining_site(f: ssasem.Func, cx: Context, uses: i32[], defs: Def[], bi: i32, k: i32, name: string, enabled: boolean): semarrayreport.Site {
  let ins: ssa.SInst = f.graph.blocks[bi].insts[k];
  let c: Chain = chain_at(f, cx, uses, defs, bi, k);
  let why: Decision = Decision { reason: standalone_reason(f, ins, uses), stage: k };
  let plan: string = report_verb(cx, ins.str);
  if (stage_verb(ins, cx) == "" && sink_verb(ins, cx) == "") {
    why = Decision { reason: semarrayreport.fusion_operator_outside_algebra(), stage: k };
  }
  if (c.verb != "") {
    why = decision(f, cx, defs, c);
    plan = chain_text(c);
  }
  if (!enabled && why.reason == semarrayreport.fusion_fused()) {
    why = Decision { reason: semarrayreport.fusion_disabled(), stage: k };
  }
  return semarrayreport.Site { owner: name, stage: stage_name(f.graph.blocks[bi].insts[why.stage]), plan: plan + "; not fused", reason: why.reason, storage: "deferred-to-ownership" };
}

// A sink's verdict covers all single-use producers in its chain, including
// refused chains. Those stages must not independently claim to lack a sink.
function covered_stages(f: ssasem.Func, cx: Context, uses: i32[], defs: Def[], bi: i32): i32[] {
  let covered: i32[] = [];
  let k: i32 = 0;
  while (k < f.graph.blocks[bi].insts.len()) {
    let c: Chain = chain_at(f, cx, uses, defs, bi, k);
    covered = util.append_all(util.append_all(covered, c.stages), c.roots);
    k = k + 1;
  }
  return covered;
}

@noinline
function remaining_sites(f: ssasem.Func, cx: Context, name: string, enabled: boolean): semarrayreport.Site[] {
  let out: semarrayreport.Site[] = [];
  let uses: i32[] = use_counts(f.graph);
  let defs: Def[] = defs_of(f.graph);
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let covered: i32[] = covered_stages(f, cx, uses, defs, bi);
    let k: i32 = 0;
    for ins in f.graph.blocks[bi].insts {
      if (ins.kind_tag == ssasem.call() && !util.has_str(["", "of", "range"], report_verb(cx, ins.str)) && util.index_of_i32(covered, k) < 0) {
        out = out.append(remaining_site(f, cx, uses, defs, bi, k, name, enabled));
      }
      k = k + 1;
    }
    bi = bi + 1;
  }
  return out;
}

function scalar(t: typeinfo.Type): boolean {
  return ssasem.is_integer(t) || ssasem.is_float(t) || ssasem.is_bool(t) || ssasem.is_char(t);
}

function is_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  return false;
}

function element(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeArray(a) = t {
    return a.elem;
  }
  return typeinfo.unchecked();
}

// The array the chain starts from, every intermediate, and the accumulator
// are all scalars, so no value in the loop carries a count. A stage's element
// is read off what the stage does, since a lazy stage yields an iterator
// rather than an array: a `map` yields its function's result, a `flat_map`
// the elements of the array its function returns, and the rest pass theirs on.
function non_scalar_stage(f: ssasem.Func, c: Chain): i32 {
  let b: ssa.SBlock = f.graph.blocks[c.block];
  let sink: ssa.SInst = b.insts[c.sink];
  let e: typeinfo.Type = base_element(f, c);
  if (!scalar(e)) {
    return first_pos(c);
  }
  let j: i32 = 0;
  while (j < c.stages.len()) {
    if (c.verbs[j] == "map") {
      e = ssasem.func_result(f.values[c.fns[j]]);
    }
    if (c.verbs[j] == "flat_map") {
      e = element(ssasem.func_result(f.values[c.fns[j]]));
    }
    if (!scalar(e)) {
      return c.stages[j];
    }
    j = j + 1;
  }
  if (sink_not_scalar(f, c.verb, sink)) {
    return c.sink;
  }
  return 0 - 1;
}

// sink_not_scalar: a count's result is not an integer, or a fold's or scan's
// accumulator is not a scalar of its seed's type.
function sink_not_scalar(f: ssasem.Func, verb: string, sink: ssa.SInst): boolean {
  if (verb == "count") {
    return !ssasem.is_integer(f.values[sink.result]);
  }
  if (verb == "fold") {
    return !scalar(f.values[sink.result]) || !semtypes.equal(f.values[sink.args[1]], f.values[sink.result]);
  }
  if (verb == "scan") {
    return !scalar(element(f.values[sink.result])) || !semtypes.equal(f.values[sink.args[1]], element(f.values[sink.result]));
  }
  return false;
}

// What the loop's cursor yields: an element of the array, or for a range the
// cursor itself.
function base_element(f: ssasem.Func, c: Chain): typeinfo.Type {
  if (c.hi >= 0) {
    return int32();
  }
  return element(f.values[c.base]);
}

// The first instruction the chain removes, and whether it removes `p`.
function first_pos(c: Chain): i32 {
  if (c.roots.len() > 0) {
    return c.roots[0];
  }
  return c.stages[0];
}

function removed(c: Chain, p: i32): boolean {
  return index_of(c.stages, p) >= 0 || index_of(c.roots, p) >= 0;
}

// ---- graph helpers --------------------------------------------------------

function use_counts(g: ssa.SFunc): i32[] {
  let out: i32[] = __alloc_i32(g.nvals);
  for b in g.blocks {
    for ins in b.insts {
      for a in ins.args {
        out = out.with(a, out[a] + 1);
      }
    }
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      out = out.with(b.term.value, out[b.term.value] + 1);
    }
    if (b.term.kind_tag == 3) {
      out = out.with(b.term.cond, out[b.term.cond] + 1);
    }
  }
  return out;
}

function defs_of(g: ssa.SFunc): Def[] {
  let out: Def[] = [];
  let v: i32 = 0;
  while (v < g.nvals) {
    out = out.append(Def { block: 0 - 1, pos: 0 - 1 });
    v = v + 1;
  }
  let bi: i32 = 0;
  while (bi < g.blocks.len()) {
    let k: i32 = 0;
    while (k < g.blocks[bi].insts.len()) {
      let r: i32 = g.blocks[bi].insts[k].result;
      if (r >= 0 && r < out.len()) {
        out = out.with(r, Def { block: bi, pos: k });
      }
      k = k + 1;
    }
    bi = bi + 1;
  }
  return out;
}

function index_of(xs: i32[], x: i32): i32 {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == x) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function prepend(x: i32, xs: i32[]): i32[] {
  let out: i32[] = [x];
  for y in xs {
    out = out.append(y);
  }
  return out;
}

function prepend_str(x: string, xs: string[]): string[] {
  let out: string[] = [x];
  for y in xs {
    out = out.append(y);
  }
  return out;
}

function next_block_id(g: ssa.SFunc): i32 {
  let hi: i32 = 0;
  for b in g.blocks {
    if (b.id >= hi) {
      hi = b.id + 1;
    }
  }
  return hi;
}

function br(target: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function brif(cond: i32, t: i32, f: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 3, cond: cond, target: 0, t: t, f: f, value: 0 };
}

function term_targets(t: ssa.STerm): i32[] {
  if (t.kind_tag == 2) {
    return [t.target];
  }
  if (t.kind_tag == 3) {
    return [t.t, t.f];
  }
  return [];
}

// ---- building the loop ----------------------------------------------------

function int32(): typeinfo.Type {
  return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: false };
}

// The blocks built so far, the open block, and the next free block id.
struct Build { values: typeinfo.Type[], blocks: ssa.SBlock[], id: i32, preds: i32[], insts: ssa.SInst[], next: i32 }

struct Emitted { s: Build, v: i32 }

function emit(s: Build, kind: i32, t: typeinfo.Type, args: i32[], imm: i32, str: string): Emitted {
  let v: i32 = s.values.len();
  let ins: ssa.SInst = ssa.SInst { kind_tag: kind, result: v, args: args, imm: imm, str: str };
  return Emitted { s: Build { ...s, values: s.values.append(t), insts: s.insts.append(ins) }, v: v };
}

// An instruction defining a value that already has an id and a type: the
// sink's result, so every later reader of it is left as it was.
function emit_at(s: Build, kind: i32, args: i32[], result: i32): Build {
  return Build { ...s, insts: s.insts.append(ssa.SInst { kind_tag: kind, result: result, args: args, imm: 0, str: "" }) };
}

function close(s: Build, term: ssa.STerm): Build {
  return Build { ...s, blocks: s.blocks.append(ssa.SBlock { id: s.id, insts: s.insts, term: term, preds: s.preds }), insts: [] };
}

function open(s: Build, id: i32, preds: i32[]): Build {
  return Build { ...s, id: id, preds: preds, insts: [] };
}

function fresh(s: Build, n: i32): Build {
  return Build { ...s, next: s.next + n };
}

// One level of the fused loop: the outer loop over the base array, or the
// inner loop a `flat_map` runs over each array its function returns. Besides
// its cursor, a level carries `vars`: the accumulator, then an arrival flag
// for an unpeeled reduce at `seen_at`, an output array for scan at `out_at`,
// and one count per `take` from `count_at` on. `vars` are the header's phis,
// `inits` what the entry edge supplies, `cur` the values on the path being
// built, and `rows` what each back edge supplies, one row per edge. `exits`
// are the blocks a stop leaves the pipeline from, with `exit_rows` beside.
struct Loop { head: i32, i: i32, next_i: i32, start: i32, entry: i32, vars: i32[], inits: i32[], cur: i32[], backs: i32[], rows: i32[], exits: i32[], exit_rows: i32[], seen_at: i32, out_at: i32, count_at: i32 }

function no_loop(): Loop {
  return Loop { head: 0 - 1, i: 0 - 1, next_i: 0 - 1, start: 0 - 1, entry: 0 - 1, vars: [], inits: [], cur: [], backs: [], rows: [], exits: [], exit_rows: [], seen_at: 0 - 1, out_at: 0 - 1, count_at: 0 };
}

function back(l: Loop, from: i32, cur: i32[]): Loop {
  return Loop { ...l, backs: l.backs.append(from), rows: util.append_all(l.rows, cur) };
}

function stop(l: Loop, from: i32): Loop {
  return Loop { ...l, exits: l.exits.append(from), exit_rows: util.append_all(l.exit_rows, l.cur) };
}

// `outer` are the levels around `l`, outermost first.
struct Stepped { s: Build, l: Loop, e: i32, outer: Loop[] }

// The stages' steps, concatenated: a `map` rebinds the element, a `filter`
// whose predicate says no skips straight back to the header, a `take`
// counts the element, a `take_while` whose predicate says no leaves the
// pipeline, and a `flat_map` opens an inner level over the array its
// function returns, in which the later stages and the sink run. A take's
// stop is the guard `guards` puts ahead of the fetch of the level it runs
// in, so no stage runs on an element past it.
function steps(f: ssasem.Func, c: Chain, s: Build, l: Loop, e: i32): Stepped {
  let st: Stepped = Stepped { s: s, l: l, e: e, outer: [] };
  let j: i32 = 0;
  let k: i32 = 0;
  while (j < c.stages.len()) {
    let v: string = c.verbs[j];
    if (v == "take") {
      st = count(st, k);
      k = k + 1;
    } else if (v == "flat_map") {
      st = inner(f, c, st, j);
    } else {
      st = call_step(f, st, v, c.fns[j]);
    }
    j = j + 1;
  }
  return st;
}

function count(st: Stepped, k: i32): Stepped {
  let at: i32 = st.l.count_at + k;
  let one: Emitted = emit(st.s, 1, int32(), [], 1, "");
  let more: Emitted = emit(one.s, 9, int32(), [st.l.cur[at], one.v], 0, "+");
  return Stepped { ...st, s: more.s, l: Loop { ...st.l, cur: st.l.cur.with(at, more.v) } };
}

function call_step(f: ssasem.Func, st: Stepped, v: string, fn: i32): Stepped {
  if (v == "map") {
    let m: Emitted = emit(st.s, ssasem.call_value(), ssasem.func_result(f.values[fn]), [fn, st.e], 0, "");
    return Stepped { ...st, s: m.s, e: m.v };
  }
  let keep: Emitted = emit(st.s, ssasem.call_value(), typeinfo.TypeBool { tag: 0 }, [fn, st.e], 0, "");
  let from: i32 = keep.s.id;
  let yes: i32 = keep.s.next;
  if (v == "take_while") {
    let s: Build = open(close(fresh(keep.s, 1), brif(keep.v, yes, pipeline_exit(st))), yes, [from]);
    return Stepped { ...st, s: s, l: stop(st.l, from) };
  }
  let s: Build = close(fresh(keep.s, 2), brif(keep.v, yes, yes + 1));
  s = close(open(s, yes + 1, [from]), br(st.l.head));
  return Stepped { ...st, s: open(s, yes, [from]), l: back(st.l, yes + 1, st.l.cur) };
}

function pipeline_exit(st: Stepped): i32 {
  if (st.outer.len() > 0) {
    return st.outer[0].head + 2;
  }
  return st.l.head + 2;
}

// A `flat_map` calls its function on the element and loops over the array it
// returns. The inner level carries everything the outer one does, entering
// with the outer path's values; `unwind` makes its exit an outer back edge.
function inner(f: ssasem.Func, c: Chain, st: Stepped, j: i32): Stepped {
  let fn: i32 = c.fns[j];
  let arr_t: typeinfo.Type = ssasem.func_result(f.values[fn]);
  let ys: Emitted = emit(st.s, ssasem.call_value(), arr_t, [fn, st.e], 0, "");
  let n: Emitted = emit(ys.s, ssasem.length(), int32(), [ys.v], 0, "");
  let zero: Emitted = emit(n.s, 1, int32(), [], 0, "");
  let s: Build = zero.s;
  let o: Loop = st.l;
  let head: i32 = s.next;
  let l: Loop = Loop { ...o, head: head, i: s.values.len(), start: zero.v, entry: s.id, inits: o.cur, backs: [], rows: [], exits: [], exit_rows: [] };
  s = Build { ...fresh(s, 3), values: s.values.append(int32()) };
  let vars: i32[] = [];
  for v in o.vars {
    vars = vars.append(s.values.len());
    s = Build { ...s, values: s.values.append(s.values[v]) };
  }
  l = Loop { ...l, vars: vars, cur: vars };
  let h: Opened = loop_head(Opened { s: open(close(s, br(head)), head, []), l: l, yes: 0 - 1 }, n.v);
  h = guards(c, h, j + 1, pipeline_exit(st));
  let fetched: Emitted = emit(h.s, ssasem.array_get(), element(arr_t), [ys.v, h.l.i], 1, "");
  return Stepped { s: fetched.s, l: h.l, e: fetched.v, outer: st.outer.append(o) };
}

// Closes the inner levels, innermost first: each header gets its phis, and
// each exit branches back to the level around it with the header's values.
function unwind(st: Stepped): Stepped {
  let s: Build = st.s;
  let l: Loop = st.l;
  let k: i32 = st.outer.len() - 1;
  while (k >= 0) {
    let o: Loop = st.outer[k];
    s = header(s, l);
    let exit: i32 = l.head + 2;
    s = close(open(s, exit, [l.head]), br(o.head));
    o = back(o, exit, l.vars);
    l = Loop { ...o, exits: util.append_all(o.exits, l.exits), exit_rows: util.append_all(o.exit_rows, l.exit_rows) };
    k = k - 1;
  }
  return Stepped { ...st, s: s, l: l, outer: [] };
}

// The sink's step. `fold` combines into the accumulator; `reduce` takes the
// first element to arrive as the accumulator and combines the rest, so its
// combining function never sees a lone element.
function sink_step(c: Chain, combine: i32, t: typeinfo.Type, st: Stepped, yes: i32): Stepped {
  let s: Build = st.s;
  let l: Loop = st.l;
  if (c.verb == "count") {
    let one: Emitted = emit(s, 1, t, [], 1, "");
    let more: Emitted = emit(one.s, 9, t, [l.cur[0], one.v], 0, "+");
    return Stepped { ...st, s: close(more.s, br(l.head)), l: back(l, more.s.id, l.cur.with(0, more.v)) };
  }
  if (c.verb == "fold" || l.seen_at < 0) {
    let a: Emitted = emit(s, ssasem.call_value(), t, [combine, l.cur[0], st.e], 0, "");
    let cur: i32[] = l.cur.with(0, a.v);
    s = a.s;
    if (c.verb == "scan") {
      let out: Emitted = emit(s, ssasem.append(), s.values[l.cur[l.out_at]], [l.cur[l.out_at], a.v], 0, "");
      s = out.s;
      cur = cur.with(l.out_at, out.v);
    }
    return Stepped { ...st, s: close(s, br(l.head)), l: back(l, s.id, cur) };
  }
  let from: i32 = s.id;
  let comb: i32 = s.next;
  s = close(fresh(s, 3), brif(l.cur[l.seen_at], comb, comb + 1));
  let a: Emitted = emit(open(s, comb, [from]), ssasem.call_value(), t, [combine, l.cur[0], st.e], 0, "");
  s = close(a.s, br(comb + 2));
  s = close(open(s, comb + 1, [from]), br(comb + 2));
  let joined: Emitted = emit(open(s, comb + 2, [comb, comb + 1]), 8, t, [a.v, st.e], 0, "");
  return Stepped { ...st, s: close(joined.s, br(l.head)), l: back(l, comb + 2, l.cur.with(0, joined.v).with(l.seen_at, yes)) };
}

struct Ended { s: Build, finals: i32[] }

// What the pipeline ends with, in the exit block: the outer header's values,
// unless a stop leaves an inner level with values of its own, when each
// takes a phi over the exit's predecessors. Counts end with the loop.
function exit_values(s: Build, l: Loop): Ended {
  let w: i32 = l.vars.len();
  let same: boolean = true;
  let x: i32 = 0;
  while (x < l.exit_rows.len()) {
    same = same && l.exit_rows[x] == l.vars[x % w];
    x = x + 1;
  }
  if (same) {
    return Ended { s: s, finals: l.vars };
  }
  let finals: i32[] = [];
  for v in l.vars {
    finals = finals.append(v);
  }
  let at: i32 = 0;
  while (at < l.count_at) {
    let args: i32[] = [l.vars[at]];
    let e: i32 = 0;
    while (e < l.exits.len()) {
      args = args.append(l.exit_rows[e * w + at]);
      e = e + 1;
    }
    let phi: Emitted = emit(s, 8, s.values[l.vars[at]], args, 0, "");
    s = phi.s;
    finals = finals.with(at, phi.v);
    at = at + 1;
  }
  return Ended { s: s, finals: finals };
}

// The sink's finish, left in the sink's own result: fold's accumulator, or
// reduce's `Some(acc)`, `None` when nothing arrived.
function finish(f: ssasem.Func, c: Chain, s: Build, l: Loop, finals: i32[], result: i32): Build {
  if (c.verb == "scan") {
    return emit_at(s, 7, [finals[l.out_at]], result);
  }
  if (c.verb == "fold" || c.verb == "count") {
    return emit_at(s, 7, [finals[0]], result);
  }
  let whole: typeinfo.Type = f.values[result];
  let from: i32 = s.id;
  let some: i32 = s.next;
  s = close(fresh(s, 3), brif(finals[l.seen_at], some, some + 1));
  let vs: Emitted = emit(open(s, some, [from]), ssasem.variant_new(), whole, [finals[0]], 0, "Some");
  s = close(vs.s, br(some + 2));
  let vn: Emitted = emit(open(s, some + 1, [from]), ssasem.variant_new(), whole, [], 0, "None");
  s = close(vn.s, br(some + 2));
  return emit_at(open(s, some + 2, [some, some + 1]), 8, [vs.v, vn.v], result);
}

// A level's header phis, completed once every back edge is known.
function header(s: Build, l: Loop): Build {
  let at: i32 = 0;
  while (s.blocks[at].id != l.head) {
    at = at + 1;
  }
  let h: ssa.SBlock = s.blocks[at];
  let is: i32[] = [l.start];
  for _ in l.backs {
    is = is.append(l.next_i);
  }
  let phis: ssa.SInst[] = [ssa.SInst { kind_tag: 8, result: l.i, args: is, imm: 0, str: "" }];
  let w: i32 = l.vars.len();
  let v: i32 = 0;
  while (v < w) {
    let args: i32[] = [l.inits[v]];
    let b: i32 = 0;
    while (b < l.backs.len()) {
      args = args.append(l.rows[b * w + v]);
      b = b + 1;
    }
    phis = phis.append(ssa.SInst { kind_tag: 8, result: l.vars[v], args: args, imm: 0, str: "" });
    v = v + 1;
  }
  for ins in h.insts {
    phis = phis.append(ins);
  }
  let full: ssa.SBlock = ssa.SBlock { ...h, insts: phis, preds: prepend(l.entry, l.backs) };
  return Build { ...s, blocks: s.blocks.with(at, full) };
}

// `yes` is the constant an unpeeled reduce records an arrival with.
struct Opened { s: Build, l: Loop, yes: i32 }

// What runs once before the loop: the invariant length, cursor and seed, and
// scan's output, reserved at the input's length. A peeled reduction starts at
// one; other sinks start at zero, as every take's count does, since a chain
// with a take is never peeled.
function enter(f: ssasem.Func, c: Chain, s: Build, acc_t: typeinfo.Type, seed: i32): Opened {
  let i32t: typeinfo.Type = int32();
  let bool_t: typeinfo.Type = typeinfo.TypeBool { tag: 0 };
  let n: Emitted = Emitted { s: s, v: c.hi };
  if (c.hi < 0) {
    n = emit(s, ssasem.length(), i32t, [c.base], 0, "");
  }
  let first: i32 = 0;
  if (seed >= 0) {
    first = 1;
  }
  let start: Emitted = emit(n.s, 1, i32t, [], first, "");
  s = start.s;
  let cursor: i32 = start.v;
  if (c.hi >= 0) {
    cursor = c.base;
  }
  let entry: i32 = s.id;
  let sink: ssa.SInst = f.graph.blocks[c.block].insts[c.sink];
  let seeded: Opened = seed_inits(c.verb, sink, s, acc_t, seed, start.v);
  s = seeded.s;
  let inits: i32[] = seeded.l.inits;
  let yes: i32 = seeded.yes;
  let out: i32 = 0 - 1;
  if (c.verb == "scan") {
    let result: i32 = sink.result;
    let reserved: Emitted = emit(s, ssasem.array_reserve(), f.values[result], [n.v], 0, "");
    out = reserved.s.values.len();
    s = Build { ...reserved.s, values: reserved.s.values.append(f.values[result]) };
    inits = inits.append(reserved.v);
  }
  let head: i32 = s.next;
  let l: Loop = Loop { ...no_loop(), head: head, i: s.values.len(), start: cursor, entry: entry, vars: [s.values.len() + 1] };
  s = Build { ...fresh(s, 3), values: s.values.append(i32t).append(acc_t) };
  if (yes >= 0) {
    l = Loop { ...l, seen_at: 1, vars: l.vars.append(s.values.len()) };
    s = Build { ...s, values: s.values.append(bool_t) };
  }
  if (out >= 0) {
    l = Loop { ...l, out_at: l.vars.len(), vars: l.vars.append(out) };
  }
  l = Loop { ...l, count_at: l.vars.len() };
  for v in c.verbs {
    if (v == "take") {
      l = Loop { ...l, vars: l.vars.append(s.values.len()) };
      inits = inits.append(start.v);
      s = Build { ...s, values: s.values.append(i32t) };
    }
  }
  l = Loop { ...l, inits: inits, cur: l.vars };
  return loop_head(Opened { s: open(close(s, br(head)), head, []), l: l, yes: yes }, n.v);
}

// seed_inits gives the accumulator its starting values: the seed of a peeled
// reduction, a fold's or scan's own initial value, a count's zero start, or
// zero and a "no element yet" flag for a reduce, whose `yes` constant records
// an arrival.
function seed_inits(verb: string, sink: ssa.SInst, s: Build, acc_t: typeinfo.Type, seed: i32, start: i32): Opened {
  if (seed >= 0) {
    return Opened { s: s, l: Loop { ...no_loop(), inits: [seed] }, yes: 0 - 1 };
  }
  if (verb == "fold" || verb == "scan") {
    return Opened { s: s, l: Loop { ...no_loop(), inits: [sink.args[1]] }, yes: 0 - 1 };
  }
  if (verb == "count") {
    return Opened { s: s, l: Loop { ...no_loop(), inits: [start] }, yes: 0 - 1 };
  }
  let bool_t: typeinfo.Type = typeinfo.TypeBool { tag: 0 };
  let z: Emitted = emit(s, ssasem.zero(), acc_t, [], 0, "");
  let no: Emitted = emit(z.s, 2, bool_t, [], 0, "");
  let y: Emitted = emit(no.s, 2, bool_t, [], 1, "");
  return Opened { s: y.s, l: Loop { ...no_loop(), inits: [z.v, no.v] }, yes: y.v };
}

// The header tests the cursor against the level's length, and the body
// advances it first. The dominating bound also proves the increment cannot
// overflow, which the physical SSA pass uses to remove the redundant
// signed32 wrap without changing integer semantics.
function loop_head(o: Opened, n: i32): Opened {
  let head: i32 = o.l.head;
  let more: Emitted = emit(o.s, 9, typeinfo.TypeBool { tag: 0 }, [o.l.i, n], 0, "<");
  let s: Build = close(more.s, brif(more.v, head + 1, head + 2));
  let one: Emitted = emit(open(s, head + 1, [head]), 1, int32(), [], 1, "");
  let step: Emitted = emit(one.s, 9, int32(), [o.l.i, one.v], 0, "+");
  return Opened { ...o, s: step.s, l: Loop { ...o.l, next_i: step.v } };
}

// Each `take` in a level stops the pipeline once its count reaches its
// operand, before the level fetches an element. A count at or below zero
// stops it before the first. A level runs the stages from `from` to the next
// `flat_map`.
function guards(c: Chain, o: Opened, from: i32, exit: i32): Opened {
  let s: Build = o.s;
  let l: Loop = o.l;
  let k: i32 = 0;
  let j: i32 = 0;
  while (j < c.stages.len() && (j < from || c.verbs[j] != "flat_map")) {
    if (c.verbs[j] == "take" && j >= from) {
      let below: Emitted = emit(s, 9, typeinfo.TypeBool { tag: 0 }, [l.cur[l.count_at + k], c.fns[j]], 0, "<");
      let at: i32 = below.s.id;
      let on: i32 = below.s.next;
      s = open(close(fresh(below.s, 1), brif(below.v, on, exit)), on, [at]);
      l = stop(l, at);
    }
    if (c.verbs[j] == "take") {
      k = k + 1;
    }
    j = j + 1;
  }
  return Opened { ...o, s: s, l: l };
}

// A reduction whose stages cannot skip is seeded from index zero, behind a
// non-empty guard. The same stage fragments run there and in the loop; the
// combining callback runs only in the loop. Filters retain the arrival flag.
struct Peeled { s: Build, seed: i32, empty: i32, none: i32, join: i32 }

function peel_seed(f: ssasem.Func, c: Chain, s: Build): Peeled {
  let out: Peeled = Peeled { s: s, seed: 0 - 1, empty: 0 - 1, none: 0 - 1, join: 0 - 1 };
  for v in c.verbs {
    if (v != "map") {
      return out;
    }
  }
  if (c.verb != "reduce") {
    return out;
  }
  let i32t: typeinfo.Type = int32();
  let n: Emitted = emit(s, ssasem.length(), i32t, [c.base], 0, "");
  let zero: Emitted = emit(n.s, 1, i32t, [], 0, "");
  let nonempty: Emitted = emit(zero.s, 9, typeinfo.TypeBool { tag: 0 }, [n.v, zero.v], 0, ">");
  let from: i32 = s.id;
  let empty: i32 = s.next;
  s = close(fresh(nonempty.s, 3), brif(nonempty.v, empty + 1, empty));
  let result: i32 = f.graph.blocks[c.block].insts[c.sink].result;
  let none: Emitted = emit(open(s, empty, [from]), ssasem.variant_new(), f.values[result], [], 0, "None");
  s = open(close(none.s, br(empty + 2)), empty + 1, [from]);
  let value: Emitted = emit(s, ssasem.array_get(), element(f.values[c.base]), [c.base, zero.v], 1, "");
  let st: Stepped = steps(f, c, value.s, no_loop(), value.v);
  return Peeled { s: st.s, seed: st.e, empty: empty, none: none.v, join: empty + 2 };
}

function finish_seeded(f: ssasem.Func, c: Chain, e: Ended, l: Loop, p: Peeled, result: i32): Build {
  if (p.seed < 0) {
    return finish(f, c, e.s, l, e.finals, result);
  }
  let some: Emitted = emit(e.s, ssasem.variant_new(), f.values[result], [e.finals[0]], 0, "Some");
  let from: i32 = e.s.id;
  return emit_at(open(close(some.s, br(p.join)), p.join, [p.empty, from]), 8, [p.none, some.v], result);
}

// Replaces the chain with one loop. The block holding it is split: what came
// before the sink (less the stages) runs first, the loop follows, and what
// came after the sink continues from the loop's exit under the old
// terminator.
@noinline
function fuse(f: ssasem.Func, c: Chain): ssasem.Func {
  let g: ssa.SFunc = f.graph;
  let b: ssa.SBlock = g.blocks[c.block];
  let sink: ssa.SInst = b.insts[c.sink];
  let acc_t: typeinfo.Type = f.values[sink.result];
  if (c.verb == "reduce") {
    acc_t = element(f.values[sink.args[0]]);
  }
  if (c.verb == "scan") {
    acc_t = element(f.values[sink.result]);
  }
  let s: Build = Build { values: f.values, blocks: [], id: b.id, preds: b.preds, insts: kept_before(b, c), next: next_block_id(g) };
  let peeled: Peeled = peel_seed(f, c, s);
  let o: Opened = enter(f, c, peeled.s, acc_t, peeled.seed);
  o = guards(c, o, 0, o.l.head + 2);
  let fetched: Emitted = Emitted { s: o.s, v: o.l.i };
  if (c.hi < 0) {
    fetched = emit(o.s, ssasem.array_get(), element(f.values[c.base]), [c.base, o.l.i], 1, "");
  }
  let st: Stepped = steps(f, c, fetched.s, o.l, fetched.v);
  st = unwind(sink_step(c, sink.args[sink.args.len() - 1], acc_t, st, o.yes));
  let l: Loop = st.l;
  let ended: Ended = exit_values(open(st.s, l.head + 2, prepend(l.head, l.exits)), l);
  s = finish_seeded(f, c, ended, l, peeled, sink.result);
  let p: i32 = c.sink + 1;
  while (p < b.insts.len()) {
    s = Build { ...s, insts: s.insts.append(b.insts[p]) };
    p = p + 1;
  }
  s = header(close(s, b.term), l);
  let graph: ssa.SFunc = ssa.SFunc { ...g, blocks: spliced(g, c.block, s.blocks), nvals: s.values.len() };
  let gone: string[] = [sink.str];
  for at in util.append_all(c.stages, c.roots) {
    gone = gone.append(b.insts[at].str);
  }
  return ssasem.Func { ...f, graph: graph, values: s.values, calls: still_called(f.calls, gone, graph) };
}

function kept_before(b: ssa.SBlock, c: Chain): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  let p: i32 = 0;
  while (p < c.sink) {
    if (!removed(c, p)) {
      out = out.append(b.insts[p]);
    }
    p = p + 1;
  }
  return out;
}

// The old block's place takes the first built block; the rest go last. A
// successor of the old block now follows the block its terminator moved to.
function spliced(g: ssa.SFunc, at: i32, built: ssa.SBlock[]): ssa.SBlock[] {
  let old: ssa.SBlock = g.blocks[at];
  let last: i32 = built[built.len() - 1].id;
  let targets: i32[] = term_targets(old.term);
  let out: ssa.SBlock[] = [];
  let i: i32 = 0;
  while (i < g.blocks.len()) {
    let blk: ssa.SBlock = g.blocks[i];
    if (i == at) {
      blk = built[0];
    }
    if (index_of(targets, blk.id) >= 0) {
      blk = ssa.SBlock { ...blk, preds: renamed(blk.preds, old.id, last) };
    }
    out = out.append(blk);
    i = i + 1;
  }
  i = 1;
  while (i < built.len()) {
    out = out.append(built[i]);
    i = i + 1;
  }
  return out;
}

function renamed(xs: i32[], from: i32, to: i32): i32[] {
  let out: i32[] = [];
  for x in xs {
    if (x == from) {
      out = out.append(to);
    } else {
      out = out.append(x);
    }
  }
  return out;
}

// The call table less the combinators the fusion removed the last call to.
function still_called(calls: ssasem.Contract[], gone: string[], g: ssa.SFunc): ssasem.Contract[] {
  let named: string[] = [];
  for b in g.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call()) {
        named = named.append(ins.str);
      }
    }
  }
  let out: ssasem.Contract[] = [];
  for c in calls {
    if (!util.has_str(gone, c.name) || util.has_str(named, c.name)) {
      out = out.append(c);
    }
  }
  return out;
}
