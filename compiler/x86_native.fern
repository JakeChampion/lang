    want_src = "%dx";
    want_dst = acc;
  }
  if (l.src != want_src || l.dst != want_dst) {
    return x86_gas_bad(a, mnem + " " + l.rest);
  }
  if (l.ext > 255) {
    buf_push_byte(a.code, l.ext >> 8);
  }
  buf_push_byte(a.code, l.ext & 255);
  return a;
}

// 0F, the opcode, and the memory operand with the extension in the ModRM reg field.
