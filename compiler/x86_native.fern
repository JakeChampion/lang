  }
  let rv = x86_gas_vreg(rm);
  if (rv < 0) {
    return x86_gas_bad(a, mnem + " " + rm);
  }
  let rr = rv & 15;
  util.push_bytes(a.code, x86_vex([], reg >= 8, false, rr >= 8, mmmmm, w, vvvv, l, pp));
  buf_push_byte(a.code, op);
  buf_push_byte(a.code, x86_modrm(3, reg, rr));
  return a;
}

function x86_gas_vex_two(own a: X86Asm, mnem: string, src: string, dst: string): X86Asm {
  if (mnem == "vmovupd" || mnem == "vmovdqu") {
    return x86_gas_vex_move(a, mnem, src, dst);
  }
  if (mnem == "vmovq") {
    let qd = x86_gas_xmm(dst);
    let qs = x86_gas_reg(src);
    if (qd < 0 || qs < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    util.push_bytes(a.code, x86_vex([], qd >= 8, false, qs >= 8, 1, true, 0, false, 1));
    buf_push_byte(a.code, 110);
    buf_push_byte(a.code, x86_modrm(3, qd & 7, qs & 7));
    return a;
  }
  if (mnem == "vbroadcasti128") {
    let id = x86_gas_ymm(dst);
    if (id < 0 || !x86_gas_has_paren(src)) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    return x86_gas_vex_rm(a, mnem, 2, 1, 0, 90, id, src, true, false);
  }
  if (mnem == "vpbroadcastb" && x86_gas_has_paren(src)) {
    let md = x86_gas_ymm(dst);
    if (md < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    return x86_gas_vex_rm(a, mnem, 2, 1, 0, 120, md, src, true, false);
  }
  if (mnem == "vpbroadcastb" || mnem == "vpbroadcastd" || mnem == "vbroadcastsd") {
    let bv = x86_gas_vreg(dst);
    let bx = x86_gas_xmm(src);
    if (bv < 0 || bx < 0 || mnem == "vbroadcastsd" && bv < 16) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    let bd = bv & 15;
    util.push_bytes(a.code, x86_vex([], bd >= 8, false, bx >= 8, 2, false, 0, bv >= 16, 1));
    buf_push_byte(a.code, x86_broadcast_op(mnem));
    buf_push_byte(a.code, x86_modrm(3, bd, bx));
    return a;
  }
  let rd = x86_gas_reg32(dst);
  let vs = x86_gas_vreg(src);
  if (rd < 0 || vs < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  let ys = vs & 15;
  util.push_bytes(a.code, x86_vex([], rd >= 8, false, ys >= 8, 1, false, 0, vs >= 16, 1));
  if (mnem == "vmovmskpd") {
    buf_push_byte(a.code, 80);
    buf_push_byte(a.code, x86_modrm(3, rd, ys));
    return a;
  }
  buf_push_byte(a.code, 215);
  buf_push_byte(a.code, x86_modrm(3, rd, ys));
  return a;
}

// The 0F38 opcode of each broadcast from an xmm register.
function x86_broadcast_op(mnem: string): i32 {
  if (mnem == "vbroadcastsd") {
    return 25;
  }
  if (mnem == "vpbroadcastd") {
    return 88;
  }
  return 120;
}

function x86_gas_vex_move(own a: X86Asm, mnem: string, src: string, dst: string): X86Asm {
  let store = x86_gas_has_paren(dst);
  let v = x86_gas_vreg(dst);
  if (store) {
    v = x86_gas_vreg(src);
  }
  if (v < 0 || mnem == "vmovupd" && v < 16) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  let pp = 2;
  let op = 111;
  if (mnem == "vmovupd") {
    pp = 1;
    op = 16;
  }
  if (store) {
    return x86_gas_vex_rm(a, mnem, 1, pp, 0, op + x86_vex_store_delta(mnem), v & 15, dst, v >= 16, false);
  }
  return x86_gas_vex_rm(a, mnem, 1, pp, 0, op, v & 15, src, v >= 16, false);
}

function x86_vex_store_delta(mnem: string): i32 {
  if (mnem == "vmovupd") {
    return 1;
  }
  return 16;
}

function x86_gas_is_vex_two(mnem: string): boolean {
  return mnem == "vmovdqu" || mnem == "vmovupd" || mnem == "vpbroadcastb" || mnem == "vpbroadcastd" || mnem == "vbroadcastsd" || mnem == "vbroadcasti128" || mnem == "vpmovmskb" || mnem == "vmovmskpd" || mnem == "vmovq";
}

// The opcode of each VEX three-operand integer and FMA instruction: 256 plus
// the 0F opcode, or 512 plus the 0F38 opcode.
const VEX_THREE_NAMES: string[] = ["vfmadd213ps", "vfmadd213pd", "vpcmpeqb", "vmulpd", "vpsubusb", "vpminub", "vpand", "vpmullw", "vpmulhuw", "vpaddusb", "vpor", "vpxor", "vpsubb", "vpshufb", "vpcmpgtq", "vpackuswb", "vpmaddubsw", "vpmaddwd", "vpsadbw", "vpunpckldq", "vpunpckhdq", "vpunpcklqdq", "vpunpckhqdq", "vpaddb", "vpmaxub", "vpaddsb", "vpsubsb", "vpavgb", "vpminsb", "vpmaxsb", "vpcmpgtb", "vpaddw", "vpaddd", "vpsubw", "vpsubd", "vpaddsw", "vpaddusw", "vpsubsw", "vpsubusw", "vpminsw", "vpmaxsw", "vpminuw", "vpmaxuw", "vpminsd", "vpmaxsd", "vpminud", "vpmaxud", "vpavgw", "vpcmpeqw", "vpcmpeqd", "vpcmpgtw", "vpcmpgtd", "vpmulld", "vpsllw", "vpslld", "vpsrld", "vpsraw", "vpsrad", "vpsrlw"];

const VEX_THREE_OPS: i32[] = [680, 680, 372, 345, 472, 474, 475, 469, 484, 476, 491, 495, 504, 512, 567, 359, 516, 501, 502, 354, 362, 364, 365, 508, 478, 492, 488, 480, 568, 572, 356, 509, 510, 505, 506, 493, 477, 489, 473, 490, 494, 570, 574, 569, 573, 571, 575, 483, 373, 374, 357, 358, 576, 497, 498, 466, 481, 482, 465];

// Each shift by an immediate: its 0F opcode times 8, plus the /digit.
const VEX_SHIFT_NAMES: string[] = ["vpsrlw", "vpsrlq", "vpsllq"];

const VEX_SHIFT_OPS: i32[] = [906, 922, 926];

function x86_vex_shift_imm(mnem: string): i32 {
  for k in 0..VEX_SHIFT_NAMES.len() {
    if (VEX_SHIFT_NAMES[k] == mnem) {
      return VEX_SHIFT_OPS[k];
    }
  }
  return -1;
}

function x86_vex_three_op(mnem: string): i32 {
  if (mnem.len() >= 4 && mnem[0] == b'v') {
    let name = slice_unchecked(mnem, 1, mnem.len()).to_owned();
    for packed in [
      "addpd", "subpd", "mulpd", "divpd", "andpd", "orpd", "xorpd", "andnpd", "minpd", "maxpd",
      "addps", "subps", "mulps", "divps", "andps", "orps", "xorps", "andnps", "minps", "maxps",
    ] {
      if (packed == name) {
        return 256 + (x86_gas_sse_fp_op(name) & 255);
      }
    }
  }
  for k in 0..VEX_THREE_NAMES.len() {
    if (VEX_THREE_NAMES[k] == mnem) {
      return VEX_THREE_OPS[k];
    }
  }
  return -1;
}

function x86_gas_vex_shuffle(own a: X86Asm, rest: string): X86Asm {
  let ops = x86_gas_split_ops(rest);
  if (ops.len() != 4 || !ops[0].starts_with("$")) {
    return x86_gas_bad(a, "vshufps " + rest);
  }
  let first = x86_gas_vreg(ops[2]);
  let dest = x86_gas_vreg(ops[3]);
  let second = x86_gas_vreg(ops[1]);
  if (first < 0 || dest < 0 || first >= 16 != dest >= 16 || second >= 0 && second >= 16 != dest >= 16) {
    return x86_gas_bad(a, "vshufps " + rest);
  }
  a = x86_gas_vex_rm(a, "vshufps", 1, 0, first & 15, 198, dest & 15, ops[1], dest >= 16, false, 1);
  buf_push_byte(a.code, x86_gas_atoi(ops[0]) & 255);
  return a;
}

function x86_gas_vex_three(own a: X86Asm, mnem: string, rest: string): X86Asm {
  if (mnem == "vshufps") {
    return x86_gas_vex_shuffle(a, rest);
  }
  let ops = x86_gas_split_ops(rest);
  if (ops.len() != 3) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let v1 = x86_gas_vreg(ops[1]);
  let vd = x86_gas_vreg(ops[2]);
  if (v1 < 0 || vd < 0 || v1 >= 16 != vd >= 16) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let shift = x86_vex_shift_imm(mnem);
  if (shift >= 0 && ops[0].starts_with("$")) {
    util.push_bytes(a.code, x86_vex([], false, false, (v1 & 15) >= 8, 1, false, vd & 15, vd >= 16, 1));
    buf_push_byte(a.code, shift / 8);
    buf_push_byte(a.code, x86_modrm(3, shift % 8, v1 & 15));
    buf_push_byte(a.code, x86_gas_atoi(ops[0]) & 255);
    return a;
  }
  let v0 = x86_gas_vreg(ops[0]);
  if (v0 >= 0 && v0 >= 16 != vd >= 16) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let mo = x86_vex_three_op(mnem);
  if (mo < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let pp = 1;
  if (mnem.len() >= 2 && mnem[mnem.len() - 2] == b'p' && mnem[mnem.len() - 1] == b's' && mnem != "vfmadd213ps") {
    pp = 0;
  }
  return x86_gas_vex_rm(a, mnem, mo / 256, pp, v1 & 15, mo & 255, vd & 15, ops[0], vd >= 16, mnem == "vfmadd213pd");
}

function x86_gas_andn(own a: X86Asm, mnem: string, size: i32, rest: string): X86Asm {
  let ops = x86_gas_split_ops(rest);
  if (ops.len() != 3) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let inv = x86_gas_reg_w(ops[1], size);
  let dst = x86_gas_reg_w(ops[2], size);
  if (inv < 0 || dst < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  if (x86_gas_has_paren(ops[0])) {
    let m = x86_gas_parse_mem(ops[0]);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + rest);
    }
    let ix = !m.is_rip && m.has_index && m.index >= 8;
    let bs = !m.is_rip && m.base >= 8;
    util.push_bytes(a.code, x86_vex([], dst >= 8, ix, bs, 2, size == 64, inv, false, 0));
    buf_push_byte(a.code, 242);
    return x86_gas_membytes(a, dst, m, 0);
  }
  let other = x86_gas_reg_w(ops[0], size);
  if (other < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  util.push_bytes(a.code, x86_rec_andn_rr(size, dst, inv, other));
  return a;
}

function x86_shiftx_pp(mnem: string): i32 {
  if (mnem == "shlxl" || mnem == "shlxq") {
    return 1;
  }
  if (mnem == "sarxl" || mnem == "sarxq") {
    return 2;
  }
  if (mnem == "shrxl" || mnem == "shrxq") {
    return 3;
  }
  return 0;
}

// AT&T order: the count, the source (a register or memory), the destination.
function x86_gas_shiftx(own a: X86Asm, mnem: string, ext: i32, rest: string): X86Asm {
  let size = ext & 127;
  let pp = ext >> 7;
  let ops = x86_gas_split_ops(rest);
  if (ops.len() != 3) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let count = x86_gas_reg_w(ops[0], size);
  let dst = x86_gas_reg_w(ops[2], size);
  if (count < 0 || dst < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  if (x86_gas_has_paren(ops[1])) {
    let m = x86_gas_parse_mem(ops[1]);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + rest);
    }
    let ix = !m.is_rip && m.has_index && m.index >= 8;
    let bs = !m.is_rip && m.base >= 8;
    util.push_bytes(a.code, x86_vex([], dst >= 8, ix, bs, 2, size == 64, count, false, pp));
    buf_push_byte(a.code, 247);
    return x86_gas_membytes(a, dst, m, 0);
  }
  let src = x86_gas_reg_w(ops[1], size);
  if (src < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  util.push_bytes(a.code, x86_rec_shiftx_rr(size, pp, dst, src, count));
  return a;
}

pub function x86_rec_shiftx_rr(size: i32, pp: i32, dst: i32, src: i32, count: i32): i32[] {
  let b = x86_vex([], dst >= 8, false, src >= 8, 2, size == 64, count, false, pp);
  return b.append(247).append(x86_modrm(3, dst, src));
}

pub function x86_rec_andn_rr(size: i32, dst: i32, inverted: i32, other: i32): i32[] {
  let b = x86_vex([], dst >= 8, false, other >= 8, 2, size == 64, inverted, false, 0);
  return b.append(242).append(x86_modrm(3, dst, other));
}

function x86_gas_rorx(own a: X86Asm, mnem: string, size: i32, rest: string): X86Asm {
  let ops = x86_gas_split_ops(rest);
  if (ops.len() != 3 || ops[0].len() == 0 || ops[0][0] != b'$') {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let imm = x86_gas_atoi(ops[0]);
  let rd = x86_gas_reg_w(ops[2], size);
  if (rd < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  if (x86_gas_has_paren(ops[1])) {
    let m = x86_gas_parse_mem(ops[1]);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + ops[1]);
    }
    let ix = false;
    let bs = false;
    if (!m.is_rip) {
      if (m.has_index) {
        ix = m.index >= 8;
      }
      bs = m.base >= 8;
    }
    util.push_bytes(a.code, x86_vex([], rd >= 8, ix, bs, 3, size == 64, 0, false, 3));
    buf_push_byte(a.code, 240);
    a = x86_gas_membytes(a, rd, m, 1);
    buf_push_byte(a.code, imm & 255);
    return a;
  }
  let rs = x86_gas_reg_w(ops[1], size);
  if (rs < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  util.push_bytes(a.code, x86_rec_rorx_rr(size, rd, rs, imm));
  return a;
}

pub function x86_rec_rorx_rr(size: i32, dst: i32, src: i32, n: i32): i32[] {
  let b = x86_vex([], dst >= 8, false, src >= 8, 3, size == 64, 0, false, 3);
  b = b.append(240);
  b = b.append(x86_modrm(3, dst, src));
  return b.append(n & 255);
}

function x86_pack1(b0: i32): i32 {
  return 16777216 + b0;
}

function x86_pack2(b0: i32, b1: i32): i32 {
  return 33554432 + b1 * 256 + b0;
}

function x86_pack3(b0: i32, b1: i32, b2: i32): i32 {
  return 50331648 + b2 * 65536 + b1 * 256 + b0;
}

