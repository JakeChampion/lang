  }
  let rd: i32 = x86_gas_reg32(dst);
  let vs: i32 = x86_gas_vreg(src);
  if (rd < 0 || vs < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  let ys: i32 = vs & 15;
  x86_push_arr(a.code, x86_vex([], rd >= 8, false, ys >= 8, 1, false, 0, vs >= 16, 1));
  buf_push_byte(a.code, 215);
