import "./sysreg";
import "./util";
import "./gas";
import "std/string";
import "std/option";

function x86_rax(): i32 {
  return 0;
}

function x86_rcx(): i32 {
  return 1;
}

function x86_rdx(): i32 {
  return 2;
}

function x86_rsp(): i32 {
  return 4;
}

function x86_rbp(): i32 {
  return 5;
}

function x86_rdi(): i32 {
  return 7;
}

function x86_rex_w(): i32 {
  return 72;
}

function x86_rex(w: i32, reg: i32, index: i32, base: i32): i32 {
  let v = 64;
  if (w != 0) {
    v = v | 8;
  }
  if (reg >= 8) {
    v = v | 4;
  }
  if (index >= 8) {
    v = v | 2;
  }
  if (base >= 8) {
    v = v | 1;
  }
  return v;
}

function x86_modrm(md: i32, reg: i32, rm: i32): i32 {
  return (md & 3) << 6 | (reg & 7) << 3 | rm & 7;
}

function x86_mov_r32_imm32(own buf: i32[], reg: i32, imm: i32): i32[] {
  if (reg >= 8) {
    buf = buf.append(x86_rex(0, 0, 0, reg));
  }
  buf = buf.append(184 + (reg & 7));
  return util.le32(buf, imm);
}

function x86_mov_r64_imm32(own buf: i32[], reg: i32, imm: i32): i32[] {
  buf = buf.append(x86_rex(1, 0, 0, reg));
  buf = buf.append(199);
  buf = buf.append(x86_modrm(3, 0, reg));
  return util.le32(buf, imm);
}

function x86_mov_r64_r64(own buf: i32[], dst: i32, src: i32): i32[] {
  buf = buf.append(x86_rex(1, src, 0, dst));
  buf = buf.append(137);
  buf = buf.append(x86_modrm(3, src, dst));
  return buf;
}

function x86_add_r64_r64(own buf: i32[], dst: i32, src: i32): i32[] {
  buf = buf.append(x86_rex(1, src, 0, dst));
  buf = buf.append(1);
  buf = buf.append(x86_modrm(3, src, dst));
  return buf;
}

function x86_sub_r64_r64(own buf: i32[], dst: i32, src: i32): i32[] {
  buf = buf.append(x86_rex(1, src, 0, dst));
  buf = buf.append(41);
  buf = buf.append(x86_modrm(3, src, dst));
  return buf;
}

function x86_push_r64(own buf: i32[], reg: i32): i32[] {
  if (reg >= 8) {
    buf = buf.append(x86_rex(0, 0, 0, reg));
  }
  return buf.append(80 + (reg & 7));
}

function x86_push_imm32(own buf: i32[], imm: i32): i32[] {
  buf = buf.append(104);
  return util.le32(buf, imm);
}

function x86_pop_r64(own buf: i32[], reg: i32): i32[] {
  if (reg >= 8) {
    buf = buf.append(x86_rex(0, 0, 0, reg));
  }
  return buf.append(88 + (reg & 7));
}

function x86_syscall(own buf: i32[]): i32[] {
  buf = buf.append(15);
  buf = buf.append(5);
  return buf;
}

function x86_ret(own buf: i32[]): i32[] {
  return buf.append(195);
}

function x86_opsel(opbase: i32, size: i32): i32 {
  if (size == 8) {
    return opbase;
  }
  return opbase | 1;
}

function x86_osz(own buf: i32[], size: i32): i32[] {
  if (size == 16) {
    return buf.append(102);
  }
  return buf;
}

function x86_rex8_force(size: i32, reg: i32): boolean {
  return size == 8 && reg >= 4 && reg <= 7;
}

function x86_rex_w_of(size: i32): i32 {
  if (size == 64) {
    return 1;
  }
  return 0;
}

function x86_rex_rr(own buf: i32[], size: i32, reg: i32, rm: i32): i32[] {
  let rex = x86_rex(x86_rex_w_of(size), reg, 0, rm);
  if (rex != 64 || x86_rex8_force(size, reg) || x86_rex8_force(size, rm)) {
    buf = buf.append(rex);
  }
  return buf;
}

function x86_rex_r(own buf: i32[], size: i32, reg: i32): i32[] {
  let rex = x86_rex(x86_rex_w_of(size), 0, 0, reg);
  if (rex != 64 || x86_rex8_force(size, reg)) {
    buf = buf.append(rex);
  }
  return buf;
}

function x86_op_rr(own buf: i32[], size: i32, opbase: i32, reg: i32, rm: i32): i32[] {
  buf = x86_osz(buf, size);
  buf = x86_rex_rr(buf, size, reg, rm);
  buf = buf.append(x86_opsel(opbase, size));
  return buf.append(x86_modrm(3, reg, rm));
}

function x86_op0f_rr(own buf: i32[], size: i32, op: i32, reg: i32, rm: i32): i32[] {
  buf = x86_osz(buf, size);
  buf = x86_rex_rr(buf, size, reg, rm);
  buf = buf.append(15);
  buf = buf.append(op);
  return buf.append(x86_modrm(3, reg, rm));
}

function x86_imm_fits8(v: i32): boolean {
  return v >= -128 && v <= 127;
}

function x86_imm_wide(own buf: i32[], size: i32, imm: i32): i32[] {
  if (size == 16) {
    buf = buf.append(imm & 255);
    return buf.append(imm >> 8 & 255);
  }
  return util.le32(buf, imm);
}

function x86_grp1_imm32_r(own buf: i32[], size: i32, ext: i32, reg: i32, imm: i32): i32[] {
  buf = x86_rex_r(buf, size, reg);
  buf = buf.append(129);
  buf = buf.append(x86_modrm(3, ext, reg));
  return util.le32(buf, imm);
}

function x86_grp1_imm_r(own buf: i32[], size: i32, ext: i32, reg: i32, imm: i32): i32[] {
  buf = x86_osz(buf, size);
  buf = x86_rex_r(buf, size, reg);
  if (size == 8) {
    if (reg == 0) {
      buf = buf.append(4 + ext * 8);
      return buf.append(imm & 255);
    }
    buf = buf.append(128);
    buf = buf.append(x86_modrm(3, ext, reg));
    return buf.append(imm & 255);
  }
  if (x86_imm_fits8(imm)) {
    buf = buf.append(131);
    buf = buf.append(x86_modrm(3, ext, reg));
    return buf.append(imm & 255);
  }
  if (reg == 0) {
    buf = buf.append(5 + ext * 8);
    return x86_imm_wide(buf, size, imm);
  }
  buf = buf.append(129);
  buf = buf.append(x86_modrm(3, ext, reg));
  return x86_imm_wide(buf, size, imm);
}

function x86_unary_r(own buf: i32[], size: i32, opbase: i32, ext: i32, reg: i32): i32[] {
  buf = x86_osz(buf, size);
  buf = x86_rex_r(buf, size, reg);
  buf = buf.append(x86_opsel(opbase, size));
  return buf.append(x86_modrm(3, ext, reg));
}

function x86_test_imm_r(own buf: i32[], size: i32, reg: i32, imm: i32): i32[] {
  buf = x86_osz(buf, size);
  buf = x86_rex_r(buf, size, reg);
  if (reg == 0) {
    buf = buf.append(x86_opsel(168, size));
    if (size == 8) {
      return buf.append(imm & 255);
    }
    return x86_imm_wide(buf, size, imm);
  }
  buf = buf.append(x86_opsel(246, size));
  buf = buf.append(x86_modrm(3, 0, reg));
  if (size == 8) {
    return buf.append(imm & 255);
  }
  return x86_imm_wide(buf, size, imm);
}

function x86_shift_r_imm(own buf: i32[], size: i32, ext: i32, reg: i32, imm: i32): i32[] {
  buf = x86_osz(buf, size);
  buf = x86_rex_r(buf, size, reg);
  if (imm == 1) {
    buf = buf.append(x86_opsel(208, size));
    return buf.append(x86_modrm(3, ext, reg));
  }
  buf = buf.append(x86_opsel(192, size));
  buf = buf.append(x86_modrm(3, ext, reg));
  return buf.append(imm & 255);
}

function x86_shift_r_cl(own buf: i32[], size: i32, ext: i32, reg: i32): i32[] {
  buf = x86_osz(buf, size);
  buf = x86_rex_r(buf, size, reg);
  buf = buf.append(x86_opsel(210, size));
  return buf.append(x86_modrm(3, ext, reg));
}

function x86_cmovcc_rr(own buf: i32[], size: i32, cc: i32, dst: i32, src: i32): i32[] {
  return x86_op0f_rr(buf, size, 64 + (cc & 15), dst, src);
}

function x86_cqo(own buf: i32[]): i32[] {
  buf = buf.append(x86_rex_w());
  buf = buf.append(153);
  return buf;
}

function x86_sib(scale: i32, index: i32, base: i32): i32 {
  return (scale & 3) << 6 | (index & 7) << 3 | base & 7;
}

function x86_emit_mem(own buf: i32[], reg: i32, base: i32, disp: i32): i32[] {
  let b = base & 7;
  let is_rsp = b == 4;
  let is_rbp = b == 5;

  let md = 2;
  let has_disp8 = false;
  if (disp == 0 && !is_rbp) {
    md = 0;
  } else if (disp >= -128 && disp <= 127) {
    md = 1;
    has_disp8 = true;
  }

  buf = buf.append(x86_modrm(md, reg, b));
  if (is_rsp) {
    buf = buf.append(x86_sib(0, 4, 4));
  }
  if (has_disp8) {
    buf = buf.append(disp & 255);
  } else {
    if (md == 2) {
      buf = util.le32(buf, disp);
    }
  }
  return buf;
}

function x86_mov_load_r64(own buf: i32[], dst: i32, base: i32, disp: i32): i32[] {
  buf = buf.append(x86_rex(1, dst, 0, base));
  buf = buf.append(139);
  return x86_emit_mem(buf, dst, base, disp);
}

function x86_mov_store_r64(own buf: i32[], base: i32, disp: i32, src: i32): i32[] {
  buf = buf.append(x86_rex(1, src, 0, base));
  buf = buf.append(137);
  return x86_emit_mem(buf, src, base, disp);
}

function x86_lea_load(own buf: i32[], size: i32, dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
  let ix = 0;
  if (has_index) {
    ix = index;
  }
  buf = x86_osz(buf, size);
  let w = 0;
  if (size == 64) {
    w = 1;
  }
  let rex = x86_rex(w, dst, ix, base);
  if (rex != 64) {
    buf = buf.append(rex);
  }
  buf = buf.append(141);
  return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

function x86_lea_idx_nobase(own buf: i32[], dst: i32, index: i32, scale: i32, disp: i32): i32[] {
  buf = buf.append(x86_rex(1, dst, index, 0));
  buf = buf.append(141);
  buf = buf.append(x86_modrm(0, dst, 4));
  buf = buf.append(x86_sib(x86_scale_bits(scale), index, 5));
  return util.le32(buf, disp);
}

function x86_scale_bits(scale: i32): i32 {
  return match (scale) {
    2 => 1,
    4 => 2,
    8 => 3,
    _ => 0,
  };
}

function x86_emit_mem_idx(own buf: i32[], reg: i32, base: i32, index: i32, scale: i32, disp: i32): i32[] {
  let b = base & 7;
  let is_rbp = b == 5;
  let md = 2;
  let has_disp8 = false;
  if (disp == 0 && !is_rbp) {
    md = 0;
  } else {
    if (disp >= -128 && disp <= 127) {
      md = 1;
      has_disp8 = true;
    }
  }
  buf = buf.append(x86_modrm(md, reg, 4));
  buf = buf.append(x86_sib(x86_scale_bits(scale), index, base));
  if (has_disp8) {
    buf = buf.append(disp & 255);
  } else {
    if (md == 2) {
      buf = util.le32(buf, disp);
    }
  }
  return buf;
}

function x86_mov_load_r64_idx(own buf: i32[], dst: i32, base: i32, index: i32, scale: i32, disp: i32): i32[] {
  buf = buf.append(x86_rex(1, dst, index, base));
  buf = buf.append(139);
  return x86_emit_mem_idx(buf, dst, base, index, scale, disp);
}

function x86_mov_store_r64_idx(own buf: i32[], base: i32, index: i32, scale: i32, disp: i32, src: i32): i32[] {
  buf = buf.append(x86_rex(1, src, index, base));
  buf = buf.append(137);
  return x86_emit_mem_idx(buf, src, base, index, scale, disp);
}

function x86_byte_mem_rex(own buf: i32[], w: i32, reg: i32, has_index: boolean, index: i32, base: i32): i32[] {
  let ix = 0;
  if (has_index) {
    ix = index;
  }
  let rex = x86_rex(w, reg, ix, base);
  let force = w == 0 && reg >= 4 && reg <= 7;
  if (rex != 64 || force) {
    buf = buf.append(rex);
  }
  return buf;
}

function x86_byte_mem_operand(own buf: i32[], reg: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
  if (has_index) {
    return x86_emit_mem_idx(buf, reg, base, index, scale, disp);
  }
  return x86_emit_mem(buf, reg, base, disp);
}

function x86_movb_imm_mem(own buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32, imm: i32): i32[] {
  buf = x86_byte_mem_rex(buf, 0, 0, has_index, index, base);
  buf = buf.append(198);
  buf = x86_byte_mem_operand(buf, 0, base, has_index, index, scale, disp);
  return buf.append(imm & 255);
}

function x86_movb_reg_mem(own buf: i32[], reg8: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
  buf = x86_byte_mem_rex(buf, 0, reg8, has_index, index, base);
  buf = buf.append(136);
  return x86_byte_mem_operand(buf, reg8, base, has_index, index, scale, disp);
}

function x86_movzb_mem(own buf: i32[], w: i32, dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
  return x86_movext_mem(buf, 182, w, dst, base, has_index, index, scale, disp);
}

function x86_movext_mem(own buf: i32[], op: i32, w: i32, dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
  let ix = 0;
  if (has_index) {
    ix = index;
  }
  let rex = x86_rex(w, dst, ix, base);
  if (rex != 64) {
    buf = buf.append(rex);
  }
  buf = buf.append(15);
  buf = buf.append(op);
  return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

function x86_movzb_reg(own buf: i32[], w: i32, dst: i32, src8: i32): i32[] {
  return x86_movext_reg(buf, 182, w, dst, src8);
}

function x86_movext_reg(own buf: i32[], op: i32, w: i32, dst: i32, src: i32): i32[] {
  let rex = x86_rex(w, dst, 0, src);
  let force = (op == 182 || op == 190) && x86_rex8_force(8, src);
  if (rex != 64 || force) {
    buf = buf.append(rex);
  }
  buf = buf.append(15);
  buf = buf.append(op);
  return buf.append(x86_modrm(3, dst, src));
}

function x86_push_mem(own buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
  let ix = 0;
  if (has_index) {
    ix = index;
  }
  let rex = x86_rex(0, 0, ix, base);
  if (rex != 64) {
    buf = buf.append(rex);
  }
  buf = buf.append(255);
  return x86_byte_mem_operand(buf, 6, base, has_index, index, scale, disp);
}

function x86_pop_mem(own buf: i32[], base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
  let ix = 0;
  if (has_index) {
    ix = index;
  }
  let rex = x86_rex(0, 0, ix, base);
  if (rex != 64) {
    buf = buf.append(rex);
  }
  buf = buf.append(143);
  return x86_byte_mem_operand(buf, 0, base, has_index, index, scale, disp);
}

function x86_setcc_reg8(own buf: i32[], op: i32, reg8: i32): i32[] {
  let rex = x86_rex(0, 0, 0, reg8);
  let force = reg8 >= 4 && reg8 <= 7;
  if (rex != 64 || force) {
    buf = buf.append(rex);
  }
  buf = buf.append(15);
  buf = buf.append(op);
  buf = buf.append(x86_modrm(3, 0, reg8));
  return buf;
}

function x86_le64_i64(own buf: i32[], v: i64): i32[] {
  buf = buf.append((v & 255) as i32);
  buf = buf.append((v >> 8 & 255) as i32);
  buf = buf.append((v >> 16 & 255) as i32);
  buf = buf.append((v >> 24 & 255) as i32);
  buf = buf.append((v >> 32 & 255) as i32);
  buf = buf.append((v >> 40 & 255) as i32);
  buf = buf.append((v >> 48 & 255) as i32);
  buf = buf.append((v >> 56 & 255) as i32);
  return buf;
}

function x86_movq_gpr_to_xmm(own buf: i32[], xmm: i32, gpr: i32): i32[] {
  buf = buf.append(102);
  buf = buf.append(x86_rex(1, xmm, 0, gpr));
  buf = buf.append(15);
  buf = buf.append(110);
  buf = buf.append(x86_modrm(3, xmm, gpr));
  return buf;
}

function x86_movq_xmm_to_gpr(own buf: i32[], xmm: i32, gpr: i32): i32[] {
  buf = buf.append(102);
  buf = buf.append(x86_rex(1, xmm, 0, gpr));
  buf = buf.append(15);
  buf = buf.append(126);
  buf = buf.append(x86_modrm(3, xmm, gpr));
  return buf;
}

function x86_sse_any_rr(own buf: i32[], pfx: i32, opcode: i32, reg: i32, rm: i32): i32[] {
  if (pfx != 0) {
    buf = buf.append(pfx);
  }
  let rex = x86_rex(0, reg, 0, rm);
  if (rex != 64) {
    buf = buf.append(rex);
  }
  buf = buf.append(15);
  buf = buf.append(opcode);
  return buf.append(x86_modrm(3, reg, rm));
}

function x86_sse_3a_imm(own buf: i32[], w: i32, opcode: i32, reg: i32, rm: i32, imm: i32): i32[] {
  buf = buf.append(102);
  let rex = x86_rex(w, reg, 0, rm);
  if (w == 1 || rex != 64) {
    buf = buf.append(rex);
  }
  buf = buf.append(15);
  buf = buf.append(58);
  buf = buf.append(opcode);
  buf = buf.append(x86_modrm(3, reg, rm));
  return buf.append(imm & 255);
}

function x86_movd_gpr_to_xmm(own buf: i32[], xmm: i32, gpr: i32): i32[] {
  buf = buf.append(102);
  let rex = x86_rex(0, xmm, 0, gpr);
  if (rex != 64) {
    buf = buf.append(rex);
  }
  buf = buf.append(15);
  buf = buf.append(110);
  return buf.append(x86_modrm(3, xmm, gpr));
}

function x86_movd_xmm_to_gpr(own buf: i32[], xmm: i32, gpr: i32): i32[] {
  buf = buf.append(102);
  let rex = x86_rex(0, xmm, 0, gpr);
  if (rex != 64) {
    buf = buf.append(rex);
  }
  buf = buf.append(15);
  buf = buf.append(126);
  return buf.append(x86_modrm(3, xmm, gpr));
}

function x86_bitscan_r32(own buf: i32[], opcode: i32, dst: i32, src: i32): i32[] {
  return x86_bitscan_rr(buf, 0, opcode, 0, dst, src);
}

function x86_bitscan_rr(own buf: i32[], pfx: i32, opcode: i32, w: i32, dst: i32, src: i32): i32[] {
  if (pfx != 0) {
    buf = buf.append(pfx);
  }
  let rex = x86_rex(w, dst, 0, src);
  if (w == 1 || rex != 64) {
    buf = buf.append(rex);
  }
  buf = buf.append(15);
  buf = buf.append(opcode);
  return buf.append(x86_modrm(3, dst, src));
}

function x86_bsf_r32(own buf: i32[], dst: i32, src: i32): i32[] {
  return x86_bitscan_r32(buf, 188, dst, src);
}

function x86_bsr_r32(own buf: i32[], dst: i32, src: i32): i32[] {
  return x86_bitscan_r32(buf, 189, dst, src);
}

function x86_cvt_to_gpr(own buf: i32[], pfx: i32, op: i32, w: i32, gpr: i32, xmm: i32): i32[] {
  buf = buf.append(pfx);
  let rex = x86_rex(w, gpr, 0, xmm);
  if (w == 1 || rex != 64) {
    buf = buf.append(rex);
  }
  buf = buf.append(15);
  buf = buf.append(op);
  return buf.append(x86_modrm(3, gpr, xmm));
}

function x86_cvt_to_xmm(own buf: i32[], pfx: i32, w: i32, xmm: i32, gpr: i32): i32[] {
  buf = buf.append(pfx);
  let rex = x86_rex(w, xmm, 0, gpr);
  if (w == 1 || rex != 64) {
    buf = buf.append(rex);
  }
  buf = buf.append(15);
  buf = buf.append(42);
  return buf.append(x86_modrm(3, xmm, gpr));
}

function x86_cvttsd2si(own buf: i32[], gpr: i32, xmm: i32): i32[] {
  return x86_cvt_to_gpr(buf, 242, 44, 1, gpr, xmm);
}

function x86_cvtsi2sd(own buf: i32[], w: i32, xmm: i32, gpr: i32): i32[] {
  return x86_cvt_to_xmm(buf, 242, w, xmm, gpr);
}

function x86_alu_r64_imm32(own buf: i32[], slash: i32, reg: i32, imm: i32): i32[] {
  buf = buf.append(x86_rex(1, 0, 0, reg));
  buf = buf.append(129);
  buf = buf.append(x86_modrm(3, slash, reg));
  return util.le32(buf, imm);
}

function x86_add_r64_imm32(own buf: i32[], reg: i32, imm: i32): i32[] {
  return x86_alu_r64_imm32(buf, 0, reg, imm);
}

function x86_sub_r64_imm32(own buf: i32[], reg: i32, imm: i32): i32[] {
  return x86_alu_r64_imm32(buf, 5, reg, imm);
}

function x86_cmp_r64_imm32(own buf: i32[], reg: i32, imm: i32): i32[] {
  return x86_alu_r64_imm32(buf, 7, reg, imm);
}

function x86_cmp_r64_r64(own buf: i32[], a: i32, b: i32): i32[] {
  buf = buf.append(x86_rex(1, b, 0, a));
  buf = buf.append(57);
  buf = buf.append(x86_modrm(3, b, a));
  return buf;
}

function x86_cc_e(): i32 {
  return 4;
}

function x86_cc_ne(): i32 {
  return 5;
}

function x86_cc_l(): i32 {
  return 12;
}

function x86_cc_ge(): i32 {
  return 13;
}

function x86_cc_a(): i32 {
  return 7;
}

function x86_cc_s(): i32 {
  return 8;
}

function x86_movabsq(own buf: i32[], reg: i32, imm: i64): i32[] {
  buf = buf.append(x86_rex(1, 0, 0, reg));
  buf = buf.append(184 + (reg & 7));
  return x86_le64_i64(buf, imm);
}

function x86_mov_load_rip_label(own a: X86Asm, dst: i32, name: string): X86Asm {
  buf_push_byte(a.code, x86_rex(1, dst, 0, 0));
  buf_push_byte(a.code, 139);
  buf_push_byte(a.code, x86_modrm(0, dst, 5));
  return x86_rip_offset(a, name, 0);
}

function x86_movl_load_rip_label(own a: X86Asm, dst: i32, name: string): X86Asm {
  util.push_bytes(a.code, x86_rex_opt([], dst, 0, 0));
  buf_push_byte(a.code, 139);
  buf_push_byte(a.code, x86_modrm(0, dst, 5));
  return x86_rip_offset(a, name, 0);
}

function x86_store_imm_rip_label(own a: X86Asm, opcode: i32, w: i32, name: string, imm: i32, imm_bytes: i32): X86Asm {
  if (w != 0) {
    buf_push_byte(a.code, x86_rex(1, 0, 0, 0));
  }
  buf_push_byte(a.code, opcode);
  buf_push_byte(a.code, x86_modrm(0, 0, 5));
  a = x86_rip_offset(a, name, imm_bytes);
  if (imm_bytes == 1) {
    buf_push_byte(a.code, imm & 255);
    return a;
  }
  util.push_bytes(a.code, util.le32([], imm));
  return a;
}

function x86_fix_tail(a: X86Asm, patch_off: i32): i32 {
  for i in 0..a.fix_tail_offs.len() {
    if (a.fix_tail_offs[i] == patch_off) {
      return a.fix_tail_bytes[i];
    }
  }
  return 0;
}

function x86_mov_store_rip_label(own a: X86Asm, src: i32, name: string): X86Asm {
  buf_push_byte(a.code, x86_rex(1, src, 0, 0));
  buf_push_byte(a.code, 137);
  buf_push_byte(a.code, x86_modrm(0, src, 5));
  return x86_rip_offset(a, name, 0);
}

function x86_movl_store_rip_label(own a: X86Asm, src: i32, name: string): X86Asm {
  if (src >= 8) {
    buf_push_byte(a.code, x86_rex(0, src, 0, 0));
  }
  buf_push_byte(a.code, 137);
  buf_push_byte(a.code, x86_modrm(0, src, 5));
  return x86_rip_offset(a, name, 0);
}

function x86_rex_opt(own buf: i32[], reg: i32, index: i32, base: i32): i32[] {
  let rex = x86_rex(0, reg, index, base);
  if (rex != 64) {
    buf = buf.append(rex);
  }
  return buf;
}

function x86_mov_r32_r32(own buf: i32[], dst: i32, src: i32): i32[] {
  buf = x86_rex_opt(buf, src, 0, dst);
  buf = buf.append(137);
  return buf.append(x86_modrm(3, src, dst));
}

function x86_movl_load(own buf: i32[], dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
  let ix = 0;
  if (has_index) {
    ix = index;
  }
  buf = x86_rex_opt(buf, dst, ix, base);
  buf = buf.append(139);
  return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

function x86_movslq_load(own buf: i32[], dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
  let ix = 0;
  if (has_index) {
    ix = index;
  }
  buf = buf.append(x86_rex(1, dst, ix, base));
  buf = buf.append(99);
  return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

function x86_movslq_rr(own buf: i32[], dst: i32, src: i32): i32[] {
  buf = buf.append(x86_rex(1, dst, 0, src));
  buf = buf.append(99);
  return buf.append(x86_modrm(3, dst, src));
}

function x86_movzwq_load(own buf: i32[], dst: i32, base: i32, has_index: boolean, index: i32, scale: i32, disp: i32): i32[] {
  let ix = 0;
  if (has_index) {
    ix = index;
  }
  buf = buf.append(x86_rex(1, dst, ix, base));
  buf = buf.append(15);
  buf = buf.append(183);
  return x86_byte_mem_operand(buf, dst, base, has_index, index, scale, disp);
}

function x86_nop_fill(own buf: i32[], n: i32): i32[] {
  if (n == 1) {
    return buf.append(144);
  }
  if (n == 2) {
    buf = buf.append(102);
    return buf.append(144);
  }
  if (n >= 9 || n == 6) {
    buf = buf.append(102);
  }
  if (n == 11) {
    buf = buf.append(102);
  }
  if (n >= 10) {
    buf = buf.append(46);
  }
  buf = buf.append(15);
  buf = buf.append(31);
  if (n == 3) {
    return buf.append(0);
  }
  if (n == 4) {
    buf = buf.append(64);
    return buf.append(0);
  }
  if (n == 5 || n == 6) {
    buf = buf.append(68);
    buf = buf.append(0);
    return buf.append(0);
  }
  if (n == 7) {
    buf = buf.append(128);
  } else {
    buf = buf.append(132);
  }
  if (n != 7) {
    buf = buf.append(0);
  }
  buf = buf.append(0);
  buf = buf.append(0);
  buf = buf.append(0);
  return buf.append(0);
}

function x86_nop_pad(own buf: i32[], n: i32): i32[] {
  while (n > 11) {
    buf = x86_nop_fill(buf, 11);
    n -= 11;
  }
  if (n > 0) {
    buf = x86_nop_fill(buf, n);
  }
  return buf;
}

function x86_jcc_rel32(own buf: i32[], cc: i32, rel: i32): i32[] {
  buf = buf.append(15);
  buf = buf.append(128 + (cc & 15));
  return util.le32(buf, rel);
}

function x86_je_rel32(own buf: i32[], rel: i32): i32[] {
  return x86_jcc_rel32(buf, x86_cc_e(), rel);
}

function x86_jne_rel32(own buf: i32[], rel: i32): i32[] {
  return x86_jcc_rel32(buf, x86_cc_ne(), rel);
}

function x86_jmp_rel32(own buf: i32[], rel: i32): i32[] {
  buf = buf.append(233);
  return util.le32(buf, rel);
}

function x86_branch_rel(target_off: i32, branch_off: i32, branch_len: i32): i32 {
  return target_off - (branch_off + branch_len);
}

function x86_call_rel32(own buf: i32[], rel: i32): i32[] {
  buf = buf.append(232);
  return util.le32(buf, rel);
}

function x86_patch_rel32(own buf: i32[], at: i32, rel: i32): i32[] {
  buf = buf.with(at, rel & 255);
  buf = buf.with(at + 1, rel >> 8 & 255);
  buf = buf.with(at + 2, rel >> 16 & 255);
  buf = buf.with(at + 3, rel >> 24 & 255);
  return buf;
}

function x86_patch_rel32_bytes(own buf: u8[], at: i32, rel: i32): u8[] {
  buf = buf.with(at, (rel & 255) as u8);
  buf = buf.with(at + 1, (rel >> 8 & 255) as u8);
  buf = buf.with(at + 2, (rel >> 16 & 255) as u8);
  buf = buf.with(at + 3, (rel >> 24 & 255) as u8);
  return buf;
}

function x86_rel_to(target_off: i32, patch_off: i32): i32 {
  return target_off - (patch_off + 4);
}

pub struct X86Asm {
  code: usize,
  text: u8[],
  rodata: i32[],
  ro: i32[],
  relro: i32[],
  relro_pad: i32,
  rfix_offs: i32[],
  rfix_names: string[],
  rfix_idx: i32[],
  ro_base: i32,
  code_end: i32,
  bss_size: i32,
  data_offset: i32,
  dfix_offs: i32[],
  dfix_names: string[],
  dfix_idx: i32[],
  afix_offs: i32[],
  afix_names: string[],
  afix_idx: i32[],
  lab_names: string[],
  lab_secs: i32[],
  lab_offs: i32[],
  files: string[],
  loc_offs: i32[],
  loc_files: i32[],
  loc_lines: i32[],
  loc_cols: i32[],
  loc_flags: i32[],
  dvars: string[],
  lab_head: i32[],
  lab_tail: i32[],
  lab_next: i32[],
  fixq: usize,
  fix_names: string[],
  fixes: u8[],
  relaxing: boolean,
  brq: usize,
  br_offs: i32[],
  br_hi: i32[],
  br_names: string[],
  fix_tail_offs: i32[],
  fix_tail_bytes: i32[],
  unknown: string[],
  cfi: gas.CfiState,
  pads: i32[],
  pad_labels: i32[],
  pad_marks: i32[],
}

function x86_asm_new(): X86Asm {
  return X86Asm { code: buf_new(4096), text: [], rodata: [], ro: [], relro: [], relro_pad: 0, rfix_offs: [], rfix_names: [], rfix_idx: [], ro_base: -1, code_end: -1, bss_size: 0, data_offset: -1, files: [], loc_offs: [], loc_files: [], loc_lines: [], loc_cols: [], loc_flags: [], dvars: [], dfix_offs: [], dfix_names: [], dfix_idx: [], afix_offs: [], afix_names: [], afix_idx: [], lab_names: [], lab_secs: [], lab_offs: [], lab_head: gas.empty_buckets(), lab_tail: gas.empty_buckets(), lab_next: [], fixq: 0 as usize, fix_names: [], fixes: [], fix_tail_offs: [], fix_tail_bytes: [], relaxing: false, brq: 0 as usize, br_offs: [], br_hi: [], br_names: [], unknown: [], cfi: gas.cfi_new(cfi_profile_x86()), pads: [], pad_labels: [], pad_marks: [] };
}

function x86_asm_new_prepared(labs: GasLabels): X86Asm {
  let n = labs.names.len() + labs.nids;
  return X86Asm { code: buf_new(4096), text: [], rodata: [], ro: [], relro: [], relro_pad: 0, rfix_offs: [], rfix_names: [], rfix_idx: [], ro_base: -1, code_end: -1, bss_size: 0, data_offset: -1, files: [], loc_offs: [], loc_files: [], loc_lines: [], loc_cols: [], loc_flags: [], dvars: [], dfix_offs: [], dfix_names: [], dfix_idx: [], afix_offs: [], afix_names: [], afix_idx: [], lab_names: labs.names, lab_secs: util.filled_i32(n, -1), lab_offs: util.filled_i32(n, -1), lab_head: labs.head, lab_tail: labs.tail, lab_next: labs.next, fixq: 0 as usize, fix_names: [], fixes: [], fix_tail_offs: [], fix_tail_bytes: [], relaxing: true, brq: 0 as usize, br_offs: [], br_hi: [], br_names: [], unknown: [], cfi: gas.cfi_new(cfi_profile_x86()), pads: [], pad_labels: [], pad_marks: [] };
}

pub function x86_eh_frame(a: X86Asm, text_vaddr: i64, eh_vaddr: i64): i32[] {
  return gas.cfi_eh_frame(a.cfi, cfi_profile_x86(), text_vaddr, eh_vaddr);
}

pub function x86_debug_frame(a: X86Asm, text_vaddr: i64): i32[] {
  return gas.cfi_debug_frame(a.cfi, cfi_profile_x86(), text_vaddr);
}

pub function x86_eh_frame_hdr_len(a: X86Asm): i32 {
  return gas.cfi_eh_frame_hdr_len(a.cfi);
}

pub function x86_eh_frame_hdr(a: X86Asm, text_vaddr: i64, eh_vaddr: i64, hdr_vaddr: i64): i32[] {
  return gas.cfi_eh_frame_hdr(a.cfi, cfi_profile_x86(), text_vaddr, eh_vaddr, hdr_vaddr);
}

function x86_align8(n: i32): i32 {
  let p = n;
  while (p % 8 != 0) {
    p += 1;
  }
  return p;
}

function x86_align16(n: i32): i32 {
  return n + 15 - (n + 15) % 16;
}

function x86_align4(n: i32): i32 {
  let p = n;
  while (p % 4 != 0) {
    p += 1;
  }
  return p;
}

function x86_add_label(own a: X86Asm, name: string, sec: i32, off: i32): X86Asm {
  let at = a.lab_names.len();
  let b = util.hash_bucket(name, 4093);
  let prev = a.lab_tail[b];
  a = X86Asm { ...a, lab_names: a.lab_names.append(name) };
  a = X86Asm { ...a, lab_secs: a.lab_secs.append(sec) };
  a = X86Asm { ...a, lab_offs: a.lab_offs.append(off) };
  a = X86Asm { ...a, lab_next: a.lab_next.append(-1) };
  if (prev < 0) {
    a = X86Asm { ...a, lab_head: a.lab_head.with(b, at) };
  } else {
    a = X86Asm { ...a, lab_next: a.lab_next.with(prev, at) };
  }
  a = X86Asm { ...a, lab_tail: a.lab_tail.with(b, at) };
  return a;
}

function x86_place_label(own a: X86Asm, idx: i32, sec: i32, off: i32): X86Asm {
  a = X86Asm { ...a, lab_secs: a.lab_secs.with(idx, sec) };
  return X86Asm { ...a, lab_offs: a.lab_offs.with(idx, off) };
}

function x86_label(own a: X86Asm, name: string): X86Asm {
  let off = buf_len(a.code);
  return x86_add_label(a, name, 0, off);
}

function x86_label_at(own a: X86Asm, name: string, idx: i32): X86Asm {
  if (idx < 0) {
    return x86_label(a, name);
  }
  let off = buf_len(a.code);
  a = x86_place_label(a, idx, 0, off);
  let n = a.pads.len();
  if (n > 0 && a.pads[n - 5] + a.pads[n - 4] == off) {
    a = X86Asm { ...a, pad_labels: a.pad_labels.append(idx).append(n / 5 - 1) };
  }
  return a;
}

function x86_rodata_label(own a: X86Asm, name: string, sec: i32): X86Asm {
  let off = a.rodata.len();
  return x86_add_label(a, name, sec, off);
}

function x86_rodata_label_at(own a: X86Asm, name: string, idx: i32, sec: i32): X86Asm {
  if (idx < 0) {
    return x86_rodata_label(a, name, sec);
  }
  let off = a.rodata.len();
  return x86_place_label(a, idx, sec, off);
}

// Sections 0 to 4 are text, .data, .bss, .rodata and .data.rel.ro.
function x86_section_kind(line: string): i32 {
  if (util.contains(line, ".rodata")) {
    return 3;
  }
  if (util.contains(line, ".bss")) {
    return 2;
  }
  if (util.contains(line, ".data.rel.ro")) {
    return 4;
  }
  if (util.contains(line, ".data")) {
    return 1;
  }
  return 0;
}

// The sections whose bytes the data directives fill.
function x86_quad_sym_at(own a: X86Asm, section: i32, name: string, idx: i32): X86Asm {
  if (section == 3) {
    return X86Asm { ...a, unknown: a.unknown.append(".quad " + name + " in .rodata") };
  }
  if (section == 4) {
    return x86_relro_quad_sym_at(a, name, idx);
  }
  return x86_rodata_quad_sym_at(a, name, idx);
}

// The active buffer is `rodata`: .data in sections 0 to 2, read-only data in
// section 3, and the read-only-after-start data in section 4. A switch parks
// the active buffer in its home and loads the home of the next section.
function x86_enter_section(own a: X86Asm, from: i32, to: i32): X86Asm {
  if (from == to) {
    return a;
  }
  a = x86_section_swap(a, from);
  return x86_section_swap(a, to);
}

function x86_section_swap(own a: X86Asm, sec: i32): X86Asm {
  let active = a.rodata;
  if (sec == 3) {
    return X86Asm { ...a, rodata: a.ro, ro: active };
  }
  if (sec == 4) {
    return X86Asm { ...a, rodata: a.relro, relro: active };
  }
  return a;
}

function x86_rodata_quad(own a: X86Asm, v: i64): X86Asm {
  return X86Asm { ...a, rodata: x86_le64_i64(a.rodata, v) };
}

function x86_bss_label(own a: X86Asm, name: string): X86Asm {
  let off = a.bss_size;
  return x86_add_label(a, name, 2, off);
}

function x86_bss_label_at(own a: X86Asm, name: string, idx: i32): X86Asm {
  if (idx < 0) {
    return x86_bss_label(a, name);
  }
  let off = a.bss_size;
  return x86_place_label(a, idx, 2, off);
}

function x86_bss_skip(own a: X86Asm, n: i32): X86Asm {
  a = X86Asm { ...a, bss_size: a.bss_size + n };
  return a;
}

function x86_label_idx(a: X86Asm, name: string): i32 {
  let i = a.lab_head[util.hash_bucket(name, 4093)];
  while (i >= 0) {
    if (a.lab_names[i] == name) {
      return i;
    }
    i = a.lab_next[i];
  }
  return -1;
}

pub function x86_label_off(a: X86Asm, name: string): i32 {
  let i = x86_label_idx(a, name);
  if (i < 0 || a.lab_secs[i] != 0) {
    return -1;
  }
  return a.lab_offs[i];
}

function x86_label_off_at(a: X86Asm, idx: i32): i32 {
  if (idx < 0 || a.lab_secs[idx] != 0) {
    return -1;
  }
  return a.lab_offs[idx];
}

function x86_label_target(a: X86Asm, name: string, idx: i32): i32 {
  if (idx >= 0) {
    return x86_label_off_at(a, idx);
  }
  return x86_label_off(a, name);
}

function x86_final_off(a: X86Asm, name: string, padded_text: i32, bss_base: i32): i32 {
  return x86_final_off_at(a, x86_label_idx(a, name), padded_text, bss_base);
}

function x86_final_off_at(a: X86Asm, i: i32, padded_text: i32, bss_base: i32): i32 {
  if (i < 0 || a.lab_secs[i] < 0) {
    return -1;
  }
  if (a.lab_secs[i] == 1 || a.lab_secs[i] == 4) {
    return padded_text + a.lab_offs[i];
  }
  if (a.lab_secs[i] == 2) {
    return bss_base + a.lab_offs[i];
  }
  if (a.lab_secs[i] == 3) {
    return a.ro_base + a.lab_offs[i];
  }
  return a.lab_offs[i];
}

function x86_final_target(a: X86Asm, name: string, idx: i32, padded_text: i32, bss_base: i32): i32 {
  if (idx >= 0) {
    return x86_final_off_at(a, idx, padded_text, bss_base);
  }
  let direct = x86_final_off(a, name, padded_text, bss_base);
  if (direct >= 0) {
    return direct;
  }
  let Some(split) = x86_symbol_addend_at(name) else {
    return -1;
  };
  let symbol = x86_gas_trimmed(slice_unchecked(name, 0, split).to_owned());
  let target = x86_final_off(a, symbol, padded_text, bss_base);
  let addend = x86_symbol_addend_value(slice_unchecked(name, split + 1, name.len()).to_owned());
  if (target < 0 || addend < 0) {
    return -1;
  }
  if (name[split] == 45) {
    addend = -addend;
  }
  let value = target as i64 + addend;
  if (value < 0 as i64 || value > 2147483647i64) {
    return -1;
  }
  return value as i32;
}

function x86_symbol_addend_at(name: string): Option[i32] {
  let quoted = false;
  let escaped = false;
  for i in 0..name.len() {
    let c = name[i] as i32;
    if (escaped) {
      escaped = false;
    } else if (quoted && c == 92) {
      escaped = true;
    } else if (c == 34) {
      quoted = !quoted;
    } else if (!quoted && i > 0 && (c == 43 || c == 45)) {
      return Some(i);
    }
  }
  return None;
}

function x86_addend_digit(c: i32): i32 {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  return -1;
}

function x86_symbol_addend_value(token: string): i64 {
  return x86_unsigned_value(token, 2147483647i64);
}

function x86_unsigned_value(token: string, limit: i64): i64 {
  let s = x86_gas_trimmed(token);
  let radix: i64 = 10;
  let i = 0;
  if (s.len() >= 2 && s[0] == 48) {
    radix = 8;
    i = 1;
    if (s[1] == 120 || s[1] == 88) {
      radix = 16;
      i = 2;
    } else if (s[1] == 98 || s[1] == 66) {
      radix = 2;
      i = 2;
    }
  }
  if (i == s.len()) {
    return -1;
  }
  let value: i64 = 0;
  while (i < s.len()) {
    let d = x86_addend_digit(s[i] as i32) as i64;
    if (d < 0 as i64 || d >= radix || value > (limit - d) / radix) {
      return -1;
    }
    value = value * radix + d;
    i += 1;
  }
  return value;
}

function x86_queue_rel32_at(own a: X86Asm, name: string, idx: i32): X86Asm {
  let at = buf_len(a.code) - 4;
  return x86_queue_fixup_at(a, at, 4, name, idx);
}

function x86_queue_abs32_at(own a: X86Asm, name: string, idx: i32): X86Asm {
  let at = buf_len(a.code) - 4;
  return X86Asm { ...a, afix_offs: a.afix_offs.append(at), afix_names: a.afix_names.append(name), afix_idx: a.afix_idx.append(idx) };
}

function x86_queue_fixup(own a: X86Asm, at: i32, width: i32, name: string): X86Asm {
  return x86_queue_fixup_at(a, at, width, name, -1);
}

function x86_queue_fixup_at(own a: X86Asm, at: i32, width: i32, name: string, idx: i32): X86Asm {
  let hi = idx << 2;
  if (idx < 0) {
    hi = a.fix_names.len() << 2 | 2;
    a = X86Asm { ...a, fix_names: a.fix_names.append(name) };
  }
  if (width == 1) {
    hi = hi | 1;
  }
  if (a.fixq == 0 as usize) {
    a = X86Asm { ...a, fixq: buf_new(8192) };
  }
  buf_push_u64(a.fixq, (hi as i64 << 32 | at as i64 & 4294967295i64) as u64);
  return a;
}

function x86_br_count(a: X86Asm): i32 {
  if (a.brq != 0 as usize) {
    return buf_len(a.brq) / 8;
  }
  return a.br_offs.len();
}

function x86_br_idx(a: X86Asm, k: i32): i32 {
  if ((a.br_hi[k] & 2) != 0) {
    return -1;
  }
  return a.br_hi[k] >> 2;
}

function x86_br_name(a: X86Asm, k: i32): string {
  if ((a.br_hi[k] & 2) != 0) {
    return a.br_names[a.br_hi[k] >> 2];
  }
  return "";
}

struct LeSplit { lo: i32[], hi: i32[] }

function x86_le32_split(b: u8[]): LeSplit {
  let lo: i32[] = [];
  let hi: i32[] = [];
  let i = 0;
  let n = b.len() - 7;
  while (i < n) {
    lo = lo.append(b[i] as i32 | b[i + 1] as i32 << 8 | b[i + 2] as i32 << 16 | b[i + 3] as i32 << 24);
    hi = hi.append(b[i + 4] as i32 | b[i + 5] as i32 << 8 | b[i + 6] as i32 << 16 | b[i + 7] as i32 << 24);
    i += 8;
  }
  return LeSplit { lo: lo, hi: hi };
}

function x86_branch_record(own a: X86Asm, at: i32, name: string, idx: i32, short: boolean): X86Asm {
  let hi = idx << 2;
  if (idx < 0) {
    hi = a.br_names.len() << 2 | 2;
    a = X86Asm { ...a, br_names: a.br_names.append(name) };
  }
  if (short) {
    hi = hi | 1;
  }
  if (a.brq == 0 as usize) {
    a = X86Asm { ...a, brq: buf_new(8192) };
  }
  buf_push_u64(a.brq, (hi as i64 << 32 | at as i64 & 4294967295i64) as u64);
  return a;
}

function x86_lea_rip_label(own a: X86Asm, dst: i32, name: string): X86Asm {
  buf_push_byte(a.code, x86_rex(1, dst, 0, 0));
  buf_push_byte(a.code, 141);
  buf_push_byte(a.code, x86_modrm(0, dst, 5));
  return x86_rip_offset(a, name, 0);
}

function x86_jcc_label(own a: X86Asm, cc: i32, name: string): X86Asm {
  return x86_jcc_label_at(a, cc, name, -1);
}

function x86_jcc_label_at(own a: X86Asm, cc: i32, name: string, idx: i32): X86Asm {
  if (a.relaxing) {
    buf_push_byte(a.code, 112 + (cc & 15));
    buf_push_byte(a.code, 0);
    let at = buf_len(a.code) - 1;
    a = x86_queue_fixup_at(a, at, 1, name, idx);
    return x86_branch_record(a, at, name, idx, true);
  }
  util.push_bytes(a.code, x86_jcc_rel32([], cc, 0));
  let at4 = buf_len(a.code) - 4;
  a = x86_queue_rel32_at(a, name, idx);
  return x86_branch_record(a, at4, name, idx, false);
}

function x86_jmp_label_at(own a: X86Asm, name: string, idx: i32): X86Asm {
  if (a.relaxing) {
    buf_push_byte(a.code, 235);
    buf_push_byte(a.code, 0);
    let at = buf_len(a.code) - 1;
    a = x86_queue_fixup_at(a, at, 1, name, idx);
    return x86_branch_record(a, at, name, idx, true);
  }
  util.push_bytes(a.code, x86_jmp_rel32([], 0));
  let at4 = buf_len(a.code) - 4;
  a = x86_queue_rel32_at(a, name, idx);
  return x86_branch_record(a, at4, name, idx, false);
}

function x86_call_reg(own buf: i32[], reg: i32): i32[] {
  if (reg >= 8) {
    buf = buf.append(x86_rex(0, 0, 0, reg));
  }
  buf = buf.append(255);
  return buf.append(x86_modrm(3, 2, reg));
}

function x86_jmp_reg(own buf: i32[], reg: i32): i32[] {
  if (reg >= 8) {
    buf = buf.append(x86_rex(0, 0, 0, reg));
  }
  buf = buf.append(255);
  return buf.append(x86_modrm(3, 4, reg));
}

function x86_call_label(own a: X86Asm, name: string): X86Asm {
  return x86_call_label_at(a, name, -1);
}

function x86_call_label_at(own a: X86Asm, name: string, idx: i32): X86Asm {
  util.push_bytes(a.code, x86_call_rel32([], 0));
  return x86_queue_rel32_at(a, name, idx);
}

function x86_gas_is_symbol(tok: string): boolean {
  if (tok.len() == 0) {
    return false;
  }
  let c = tok[0] as i32;
  if (c == 45 || c == 36) {
    return false;
  }
  if (c >= 48 && c <= 57) {
    return false;
  }
  return true;
}

function x86_rodata_quad_sym_at(own a: X86Asm, name: string, idx: i32): X86Asm {
  let off = a.rodata.len();
  a = X86Asm { ...a, rodata: x86_le64_i64(a.rodata, 0) };
  a = X86Asm { ...a, dfix_offs: a.dfix_offs.append(off) };
  a = X86Asm { ...a, dfix_names: a.dfix_names.append(name) };
  return X86Asm { ...a, dfix_idx: a.dfix_idx.append(idx) };
}

function x86_relro_quad_sym_at(own a: X86Asm, name: string, idx: i32): X86Asm {
  let off = a.rodata.len();
  a = X86Asm { ...a, rodata: x86_le64_i64(a.rodata, 0) };
  a = X86Asm { ...a, rfix_offs: a.rfix_offs.append(off) };
  a = X86Asm { ...a, rfix_names: a.rfix_names.append(name) };
  return X86Asm { ...a, rfix_idx: a.rfix_idx.append(idx) };
}

// Zero bytes after the read-only region, so that it ends on a page at the
// address the image writer gives the segment. Every .data label and word
// moves behind them.
pub function x86_relro_gap(own a: X86Asm, gap: i32): X86Asm {
  if (gap == 0 || a.relro_pad == 0) {
    return a;
  }
  let at = a.relro_pad;
  let data: i32[] = [];
  for i in 0..at {
    data = data.append(a.rodata[i]);
  }
  for i in 0..gap {
    data = data.append(0);
  }
  for i in at..a.rodata.len() {
    data = data.append(a.rodata[i]);
  }
  let dfix_offs = a.dfix_offs;
  for i in 0..dfix_offs.len() {
    if (dfix_offs[i] >= at) {
      dfix_offs = dfix_offs.with(i, dfix_offs[i] + gap);
    }
  }
  let offs = a.lab_offs;
  for i in 0..offs.len() {
    if (a.lab_secs[i] == 1 && offs[i] >= at) {
      offs = offs.with(i, offs[i] + gap);
    }
  }
  return X86Asm { ...a, rodata: data, relro_pad: at + gap, dfix_offs: dfix_offs, lab_offs: offs };
}

// The read-only region leads the data segment. Every .data label and word
// moves behind it. A label of the region keeps section 4, so a later gap
// after the region moves the .data labels alone.
function x86_fold_relro(own a: X86Asm): X86Asm {
  if (a.relro.len() == 0) {
    return a;
  }
  let pad: i32 = (a.relro.len() + 15) / 16 * 16;
  let data = a.relro;
  while (data.len() < pad) {
    data = data.append(0);
  }
  for b in a.rodata {
    data = data.append(b);
  }
  let dfix_offs = a.rfix_offs;
  let dfix_names = a.rfix_names;
  let dfix_idx = a.rfix_idx;
  for i in 0..a.dfix_offs.len() {
    dfix_offs = dfix_offs.append(a.dfix_offs[i] + pad);
    dfix_names = dfix_names.append(a.dfix_names[i]);
    dfix_idx = dfix_idx.append(a.dfix_idx[i]);
  }
  let offs = a.lab_offs;
  for i in 0..offs.len() {
    if (a.lab_secs[i] == 1) {
      offs = offs.with(i, offs[i] + pad);
    }
  }
  return X86Asm { ...a, rodata: data, relro: [], relro_pad: pad, dfix_offs: dfix_offs, dfix_names: dfix_names, dfix_idx: dfix_idx, rfix_offs: [], rfix_names: [], rfix_idx: [], lab_offs: offs };
}

function x86_unwind_eh_len(a: X86Asm): i32 {
  if (gas.cfi_empty(a.cfi)) {
    return 0;
  }
  return gas.cfi_eh_frame(a.cfi, cfi_profile_x86(), 0 as i64, 0 as i64).len();
}

pub function x86_data_base(a: X86Asm, text_len: i32): i32 {
  if (a.data_offset >= 0) {
    return a.data_offset;
  }
  let end = text_len;
  let hdr_len = x86_eh_frame_hdr_len(a);
  let eh_len = x86_unwind_eh_len(a);
  if (hdr_len > 0 && eh_len > 0) {
    end = x86_align8(x86_align4(end) + hdr_len) + eh_len;
  }
  return x86_align16(end);
}

pub function x86_symbol_addr(a: X86Asm, name: string, text_vaddr: i32): i32 {
  let padded_text = x86_data_base(a, a.text.len());
  let off = x86_final_off(a, name, padded_text, padded_text + a.rodata.len());
  if (off < 0) {
    return -1;
  }
  return text_vaddr + off;
}

pub function x86_resolve_data(own a: X86Asm, text_vaddr: i32): X86Asm {
  let padded_text = x86_data_base(a, a.text.len());
  let bss_base = padded_text + a.rodata.len();
  let rodata = a.rodata;
  a = X86Asm { ...a, rodata: [] };
  let i = 0;
  while (i < a.dfix_offs.len()) {
    let name = a.dfix_names[i];
    let target = x86_final_target(a, name, a.dfix_idx[i], padded_text, bss_base);
    if (target < 0) {
      a = X86Asm { ...a, unknown: a.unknown.append(".quad " + name) };
    } else {
      let at = a.dfix_offs[i];
      let abs = text_vaddr as i64 + target as i64;
      for j in 0..8 {
        rodata = rodata.with(at + j, (abs >> (j * 8) as i64 & 255 as i64) as i32);
      }
    }
    i += 1;
  }
  let text = a.text;
  a = X86Asm { ...a, text: [] };
  i = 0;
  while (i < a.afix_offs.len()) {
    let name = a.afix_names[i];
    let target = x86_final_target(a, name, a.afix_idx[i], padded_text, bss_base);
    let abs = text_vaddr as i64 + target as i64;
    if (target < 0 || abs > 2147483647i64) {
      a = X86Asm { ...a, unknown: a.unknown.append("imm32 address of " + name) };
    } else {
      text = x86_patch_rel32_bytes(text, a.afix_offs[i], abs as i32);
    }
    i += 1;
  }
  return X86Asm { ...a, rodata: rodata, text: text };
}

pub function x86_link(a: X86Asm, text_vaddr: i32, data_vaddr: i32): X86Asm {
  return x86_resolve_data(x86_patch(X86Asm { ...a, data_offset: data_vaddr - text_vaddr }), text_vaddr);
}

function x86_resolve(own a: X86Asm): X86Asm {
  return x86_patch(x86_take(a));
}

function x86_fold_ro(own a: X86Asm): X86Asm {
  if (a.ro.len() == 0) {
    return a;
  }
  let text = a.text;
  let ro = a.ro;
  let end = text.len();
  a = X86Asm { ...a, text: [], ro: [] };
  while (text.len() % 16 != 0) {
    text = text.append(0 as u8);
  }
  let base = text.len();
  for b in ro {
    text = text.append(b as u8);
  }
  return X86Asm { ...a, text: text, ro_base: base, code_end: end };
}

function x86_take(own a: X86Asm): X86Asm {
  let code = buf_take_bytes(a.code);
  buf_free(a.code);
  a = X86Asm { ...a, code: 0 as usize, text: code };
  if (a.fixq != 0 as usize) {
    let fq = buf_take_bytes(a.fixq);
    buf_free(a.fixq);
    a = X86Asm { ...a, fixq: 0 as usize, fixes: fq };
  }
  if (a.brq != 0 as usize) {
    let bq = x86_le32_split(buf_take_bytes(a.brq));
    buf_free(a.brq);
    a = X86Asm { ...a, brq: 0 as usize, br_offs: bq.lo, br_hi: bq.hi };
  }
  return a;
}

function x86_patch(own a: X86Asm): X86Asm {
  while (a.rodata.len() % 16 != 0) {
    a = X86Asm { ...a, rodata: a.rodata.append(0) };
  }
  a = x86_fold_relro(x86_fold_ro(a));
  let padded_text = x86_data_base(a, a.text.len());
  let bss_base = padded_text + a.rodata.len();
  let code = a.text;
  let fq = a.fixes;
  a = X86Asm { ...a, text: [], fixes: [] };
  let nfix = fq.len() / 8;
  for i in 0..nfix {
    let at = 8 * i;
    let patch_off = fq[at] as i32 | fq[at + 1] as i32 << 8 | fq[at + 2] as i32 << 16 | fq[at + 3] as i32 << 24;
    let hi = fq[at + 4] as i32 | fq[at + 5] as i32 << 8 | fq[at + 6] as i32 << 16 | fq[at + 7] as i32 << 24;
    let idx = hi >> 2;
    let name = "";
    if ((hi & 2) != 0) {
      name = a.fix_names[idx];
      idx = -1;
    } else if (idx < a.lab_names.len()) {
      name = a.lab_names[idx];
    }
    let target = x86_final_target(a, name, idx, padded_text, bss_base);
    if (target < 0) {
      a = X86Asm { ...a, unknown: a.unknown.append("unresolved symbol " + name) };
    } else if ((hi & 1) != 0) {
      let rel8 = target - (patch_off + 1);
      if (rel8 < -128 || rel8 > 127) {
        a = X86Asm { ...a, unknown: a.unknown.append("rel8 out of range for " + name) };
      } else {
        code = code.with(patch_off, (rel8 & 255) as u8);
      }
    } else {
      code = x86_patch_rel32_bytes(code, patch_off, x86_rel_to(target, patch_off) - x86_fix_tail(a, patch_off));
    }
  }
  return X86Asm { ...a, text: code };
}

function x86_gas_has_paren(s: string): boolean {
  return __memchr(s, 40, 0) >= 0;
}

function x86_str_split(s: string, sep: string): string[] {
  let out: string[] = [];
  let m = sep.len();
  if (m == 0) {
    out = out.append(s);
    return out;
  }
  let n = s.len();
  let c0 = sep[0];
  let last = n - m;
  let start = 0;
  let i = 0;
  while (i <= last) {
    i = __memchr(s, c0 as i32, i);
    if (i < 0 || i > last) {
      break;
    }
    let j = 1;
    while (j < m && s[i + j] == sep[j]) {
      j += 1;
    }
    if (j == m) {
      out = out.append(slice_unchecked(s, start, i).to_owned());
      i += m;
      start = i;
    } else {
      i += 1;
    }
  }
  out = out.append(slice_unchecked(s, start, n).to_owned());
  return out;
}

struct GasMem {
  is_rip: boolean,
  label: string,
  base: i32,
  disp: i32,
  has_index: boolean,
  index: i32,
  scale: i32,
  no_base: boolean,
}

function x86_gas_trimmed(s: str): str {
  let a = 0;
  let b = s.len();
  while (a < b && (s[a] == b' ' || s[a] == b'\t')) {
    a += 1;
  }
  while (b > a && (s[b - 1] == b' ' || s[b - 1] == b'\t')) {
    b -= 1;
  }
  return slice_unchecked(s, a, b);
}

function x86_gas_reg_decode(tok: string): i32 {
  let i = 0;
  if (tok.len() > 0 && tok[0] == b'%') {
    i = 1;
  }
  let n = tok.len() - i;
  if (n >= 2 && tok[i] == b'r' && tok[i + 1] >= b'0' && tok[i + 1] <= b'9') {
    return x86_gas_reg_numbered(tok, i + 1);
  }
  if (n == 2) {
    if (tok[i + 1] == b'l') {
      let low = x86_gas_reg_pair(tok[i], b'x');
      if (low >= 0 && low < 4) {
        return 8 * 16 + low;
      }
      return -1;
    }
    let word = x86_gas_reg_pair(tok[i], tok[i + 1]);
    if (word >= 0) {
      return 16 * 16 + word;
    }
    return -1;
  }
  if (n != 3) {
    return -1;
  }
  let tail = x86_gas_reg_pair(tok[i + 1], tok[i + 2]);
  if (tail >= 0 && tok[i] == b'r') {
    return 64 * 16 + tail;
  }
  if (tail >= 0 && tok[i] == b'e') {
    return 32 * 16 + tail;
  }
  let head = x86_gas_reg_pair(tok[i], tok[i + 1]);
  if (head >= 4 && tok[i + 2] == b'l') {
    return 8 * 16 + head;
  }
  return -1;
}

function x86_gas_reg_pair(a: u8, b: u8): i32 {
  if (b == b'x') {
    if (a == b'a') {
      return 0;
    }
    if (a == b'c') {
      return 1;
    }
    if (a == b'd') {
      return 2;
    }
    if (a == b'b') {
      return 3;
    }
    return -1;
  }
  if (a == b's' && b == b'p') {
    return 4;
  }
  if (a == b'b' && b == b'p') {
    return 5;
  }
  if (a == b's' && b == b'i') {
    return 6;
  }
  if (a == b'd' && b == b'i') {
    return 7;
  }
  return -1;
}

function x86_gas_reg_numbered(tok: string, at: i32): i32 {
  let j = at;
  let num: i32 = -1;
  if (tok[j] == b'8' || tok[j] == b'9') {
    num = tok[j] as i32 - 48;
    j += 1;
  } else if (tok[j] == b'1' && j + 1 < tok.len() && tok[j + 1] >= b'0' && tok[j + 1] <= b'5') {
    num = tok[j + 1] as i32 - 38;
    j += 2;
  }
  if (num < 0) {
    return -1;
  }
  if (j == tok.len()) {
    return 64 * 16 + num;
  }
  if (j + 1 != tok.len()) {
    return -1;
  }
  if (tok[j] == b'd') {
    return 32 * 16 + num;
  }
  if (tok[j] == b'w') {
    return 16 * 16 + num;
  }
  if (tok[j] == b'b') {
    return 8 * 16 + num;
  }
  return -1;
}

function x86_gas_reg_sized(tok: string, width: i32): i32 {
  let r = x86_gas_reg_decode(tok);
  if (r >= 0 && r / 16 == width) {
    return r % 16;
  }
  return -1;
}

function x86_gas_reg(tok: string): i32 {
  let r = x86_gas_reg_decode(tok);
  if (r >= 0 && (r / 16 == 64 || r / 16 == 32)) {
    return r % 16;
  }
  return -1;
}

function x86_gas_reg8(tok: string): i32 {
  return x86_gas_reg_sized(tok, 8);
}

function x86_gas_reg16(tok: string): i32 {
  return x86_gas_reg_sized(tok, 16);
}

function x86_gas_reg32(tok: string): i32 {
  return x86_gas_reg_sized(tok, 32);
}

function x86_gas_reg64(tok: string): i32 {
  return x86_gas_reg_sized(tok, 64);
}

function x86_gas_reg_w(tok: string, size: i32): i32 {
  return match (size) {
    8 => x86_gas_reg8(tok),
    16 => x86_gas_reg16(tok),
    32 => x86_gas_reg32(tok),
    _ => x86_gas_reg64(tok),
  };
}

function x86_gas_suffix_size(mnem: string): i32 {
  if (mnem.len() < 2) {
    return 0;
  }
  let c = mnem[mnem.len() - 1];
  if (c == b'b') {
    return 8;
  }
  if (c == b'w') {
    return 16;
  }
  if (c == b'l') {
    return 32;
  }
  if (c == b'q') {
    return 64;
  }
  return 0;
}

function x86_gas_strip_suffix(mnem: string): string {
  return slice_unchecked(mnem, 0, mnem.len() - 1).to_owned();
}

function x86_gas_is_xmm(tok: string): boolean {
  let at = 0;
  if (tok.len() > 0 && tok[0] == b'%') {
    at = 1;
  }
  return tok.len() >= at + 3 && tok[at] == b'x' && tok[at + 1] == b'm' && tok[at + 2] == b'm';
}

function x86_gas_xmm(tok: string): i32 {
  let s = tok;
  if (s.len() > 0 && s[0] == b'%') {
    s = slice_unchecked(s, 1, s.len()).to_owned();
  }
  if (s.len() < 4) {
    return -1;
  }
  if (s[0] != b'x' || s[1] != b'm' || s[2] != b'm') {
    return -1;
  }
  let v = 0;
  for i in 3..s.len() {
    let c = s[i] as i32;
    if (c >= 48 && c <= 57) {
      v = v * 10 + (c - 48);
    }
  }
  return v;
}

function x86_gas_ymm(tok: string): i32 {
  let s = tok;
  if (s.len() > 0 && s[0] == b'%') {
    s = slice_unchecked(s, 1, s.len()).to_owned();
  }
  if (s.len() < 4) {
    return -1;
  }
  if (s[0] != b'y' || s[1] != b'm' || s[2] != b'm') {
    return -1;
  }
  let v = 0;
  for i in 3..s.len() {
    let c = s[i] as i32;
    if (c >= 48 && c <= 57) {
      v = v * 10 + (c - 48);
    }
  }
  return v;
}

function x86_gas_vreg(tok: string): i32 {
  let y = x86_gas_ymm(tok);
  if (y >= 0) {
    return y + 16;
  }
  return x86_gas_xmm(tok);
}

function x86_gas_ascii(own buf: i32[], line: string): i32[] {
  let q1 = util.index_of_sub(line, "\"");
  if (q1 < 0) {
    return buf;
  }
  let i = q1 + 1;
  while (i < line.len()) {
    let c = line[i] as i32;
    if (c == 34) {
      return buf;
    }
    if (c == 92 && i + 1 < line.len()) {
      let (eb, span) = gas.escape(line, i);
      c = eb;
      i = i + span - 1;
    }
    buf = buf.append(c & 255);
    i += 1;
  }
  return buf;
}

function x86_gas_atoi(tok: string): i32 {
  let s = tok;
  let i = 0;
  if (s.len() > 0 && s[0] == b'$') {
    i = 1;
  }
  let neg = false;
  if (i < s.len() && s[i] == b'-') {
    neg = true;
    i += 1;
  }
  let v = 0;
  if (i + 1 < s.len() && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
    i += 2;
    while (i < s.len()) {
      let c = s[i] as i32;
      let d: i32 = -1;
      if (c >= 48 && c <= 57) {
        d = c - 48;
      } else {
        if (c >= 97 && c <= 102) {
          d = c - 97 + 10;
        } else {
          if (c >= 65 && c <= 70) {
            d = c - 65 + 10;
          }
        }
      }
      if (d >= 0) {
        v = v * 16 + d;
      }
      i += 1;
    }
  } else {
    while (i < s.len()) {
      let c = s[i] as i32;
      if (c >= 48 && c <= 57) {
        v = v * 10 + (c - 48);
      }
      i += 1;
    }
  }
  if (neg) {
    return -v;
  }
  return v;
}

function x86_gas_atoi64(tok: string): i64 {
  let s = tok;
  if (s.len() > 0 && s[0] == b'$') {
    s = slice_unchecked(s, 1, s.len()).to_owned();
  }
  let neg = false;
  let i = 0;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  }
  let v: i64 = 0;
  if (i + 1 < s.len() && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
    i += 2;
    while (i < s.len()) {
      let c = s[i] as i32;
      let d: i32 = -1;
      if (c >= 48 && c <= 57) {
        d = c - 48;
      } else {
        if (c >= 97 && c <= 102) {
          d = c - 97 + 10;
        } else {
          if (c >= 65 && c <= 70) {
            d = c - 65 + 10;
          }
        }
      }
      if (d >= 0) {
        v = v * 16 + d as i64;
      }
      i += 1;
    }
  } else {
    while (i < s.len()) {
      let c = s[i] as i32;
      if (c >= 48 && c <= 57) {
        v = v * 10 + (c - 48) as i64;
      }
      i += 1;
    }
  }
  if (neg) {
    return -v;
  }
  return v;
}

function x86_gas_parse_mem(op: string): GasMem {
  let lp = util.index_of_sub(op, "(");
  if (lp < 0) {
    return GasMem { is_rip: false, label: "", base: x86_gas_reg(op), disp: 0, has_index: false, index: 0, scale: 1, no_base: false };
  }
  let disp_str = slice_unchecked(op, 0, lp);
  let inner = slice_unchecked(op, lp + 1, op.len() - 1);
  if (inner == "%rip") {
    return GasMem { is_rip: true, label: disp_str + "", base: 0, disp: 0, has_index: false, index: 0, scale: 1, no_base: false };
  }
  let d = 0;
  if (disp_str.len() > 0) {
    d = x86_gas_atoi(disp_str);
  }
  let c1 = util.index_of_sub(inner, ",");
  if (c1 < 0) {
    return GasMem { is_rip: false, label: "", base: x86_gas_reg(x86_gas_trimmed(inner)), disp: d, has_index: false, index: 0, scale: 1, no_base: false };
  }
  let b0 = x86_gas_trimmed(slice_unchecked(inner, 0, c1));
  let after = slice_unchecked(inner, c1 + 1, inner.len());
  let c2 = util.index_of_sub(after, ",");
  if (c2 < 0) {
    return GasMem { is_rip: false, label: "", base: x86_gas_reg(b0), disp: d, has_index: true, index: x86_gas_reg(x86_gas_trimmed(after)), scale: 1, no_base: b0.len() == 0 };
  }
  let ix = x86_gas_reg(x86_gas_trimmed(slice_unchecked(after, 0, c2)));
  let scale_str = slice_unchecked(after, c2 + 1, after.len());
  let c3 = util.index_of_sub(scale_str, ",");
  if (c3 >= 0) {
    scale_str = slice_unchecked(scale_str, 0, c3);
  }
  let sc = x86_gas_atoi(x86_gas_trimmed(scale_str));
  return GasMem { is_rip: false, label: "", base: x86_gas_reg(b0), disp: d, has_index: true, index: ix, scale: sc, no_base: b0.len() == 0 };
}

// The number of a control-register operand such as %cr3, or -1.
function x86_gas_creg(tok: string): i32 {
  if (!tok.starts_with("%cr")) {
    return -1;
  }
  return sysreg.x86_control(slice_unchecked(tok, 1, tok.len()).to_owned());
}

// movq to or from a control register: 0F 20 reads it and 0F 22 writes it. The
// ModRM reg field holds the control register and r/m holds the 64-bit register.
function x86_gas_movq_creg(own a: X86Asm, src: string, dst: string): X86Asm {
  let cr = x86_gas_creg(src);
  let gpr = x86_gas_reg64(dst);
  let op = 32;
  if (cr < 0) {
    cr = x86_gas_creg(dst);
    gpr = x86_gas_reg64(src);
    op = 34;
  }
  if (cr < 0) {
    return x86_gas_movq(a, src, dst);
  }
  if (gpr < 0) {
    return x86_gas_bad(a, "movq " + src + ", " + dst);
  }
  let rex = cr / 8 * 4 + gpr / 8;
  if (rex != 0) {
    buf_push_byte(a.code, 64 + rex);
  }
  buf_push_byte(a.code, 15);
  buf_push_byte(a.code, op);
  buf_push_byte(a.code, 192 + cr % 8 * 8 + gpr % 8);
  return a;
}

function x86_gas_movq(own a: X86Asm, src: string, dst: string): X86Asm {
  let src_xmm = x86_gas_is_xmm(src);
  let dst_xmm = x86_gas_is_xmm(dst);
  if (dst_xmm && src_xmm) {
    util.push_bytes(a.code, x86_sse_any_rr([], 243, 126, x86_gas_xmm(dst), x86_gas_xmm(src)));
    return a;
  }
  if (dst_xmm && !src_xmm) {
    if (x86_gas_has_paren(src)) {
      let xm = x86_gas_parse_mem(src);
      if (!x86_gas_mem_ok(xm)) {
        return x86_gas_bad(a, "movq " + src + ", " + dst);
      }
      buf_push_byte(a.code, 102);
      util.push_bytes(a.code, x86_gas_mem_rex([], 64, x86_gas_xmm(dst), xm, false));
      buf_push_byte(a.code, 15);
      buf_push_byte(a.code, 110);
      return x86_gas_membytes(a, x86_gas_xmm(dst), xm, 0);
    }
    let gs = x86_gas_reg(src);
    if (gs < 0) {
      return x86_gas_bad(a, "movq " + src + ", " + dst);
    }
    util.push_bytes(a.code, x86_movq_gpr_to_xmm([], x86_gas_xmm(dst), gs));
    return a;
  }
  if (src_xmm && !dst_xmm) {
    if (x86_gas_has_paren(dst)) {
      let xm2 = x86_gas_parse_mem(dst);
      if (!x86_gas_mem_ok(xm2)) {
        return x86_gas_bad(a, "movq " + src + ", " + dst);
      }
      buf_push_byte(a.code, 102);
      util.push_bytes(a.code, x86_gas_mem_rex([], 64, x86_gas_xmm(src), xm2, false));
      buf_push_byte(a.code, 15);
      buf_push_byte(a.code, 126);
      return x86_gas_membytes(a, x86_gas_xmm(src), xm2, 0);
    }
    let gd = x86_gas_reg(dst);
    if (gd < 0) {
      return x86_gas_bad(a, "movq " + src + ", " + dst);
    }
    util.push_bytes(a.code, x86_movq_xmm_to_gpr([], x86_gas_xmm(src), gd));
    return a;
  }
  return x86_gas_mov_rm(a, "movq", 64, src, dst);
}

function x86_gas_top_comma(s: string): i32 {
  let depth = 0;
  for i in 0..s.len() {
    let c = s[i];
    if (c == b'(') {
      depth += 1;
    } else {
      if (c == b')') {
        depth -= 1;
      } else {
        if (c == b',' && depth == 0) {
          return i;
        }
      }
    }
  }
  return -1;
}

