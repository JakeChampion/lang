}

function x86_gas_sse_table(own a: X86Asm, mnem: string, pfx: i32, op: i32, src: string, dst: string): X86Asm {
  let xd = x86_gas_xmm(dst);
  if (xd < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  if (x86_gas_has_paren(src)) {
    let m = x86_gas_parse_mem(src);
    if (!x86_gas_mem_ok(m) || x86_gas_sse_reg_only(mnem)) {
      return x86_gas_bad(a, mnem + " " + src);
    }
    return x86_gas_sse_mem(a, pfx, op, xd, m, 0);
  }
  let xs = x86_gas_xmm(src);
  if (xs < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  util.push_bytes(a.code, x86_sse_any_rr([], pfx, op, xd, xs));
  return a;
}

function x86_gas_movdq(own a: X86Asm, mnem: string, src: string, dst: string): X86Asm {
  let pfx = x86_gas_movdq_pfx(mnem);
  if (x86_gas_has_paren(dst)) {
    let m = x86_gas_parse_mem(dst);
    let xs = x86_gas_xmm(src);
    if (!x86_gas_mem_ok(m) || xs < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    return x86_gas_sse_mem(a, pfx, 127, xs, m, 0);
  }
  return x86_gas_sse_table(a, mnem, pfx, 111, src, dst);
}

function x86_gas_sse_mov10(own a: X86Asm, mnem: string, pfx: i32, src: string, dst: string): X86Asm {
