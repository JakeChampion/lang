    let ix: boolean = false;
    let bs: boolean = false;
    if (!m.is_rip) {
      if (m.has_index) {
        ix = m.index >= 8;
      }
      bs = m.base >= 8;
    }
    x86_push_arr(a.code, x86_vex([], reg >= 8, ix, bs, mmmmm, w, vvvv, l, pp));
    buf_push_byte(a.code, op);
    return x86_gas_membytes(a, reg, m, 0);
  }
  let rv: i32 = x86_gas_vreg(rm);
