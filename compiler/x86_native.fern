  if (!rex_x) {
    c2 = c2 | 64;
  }
  if (!rex_b) {
    c2 = c2 | 32;
  }
  let c3: i32 = pp & 3 | lbit | vinv;
  if (w) {
    c3 = c3 | 128;
  }
  buf = buf.append(196);
  buf = buf.append(c2);
  return buf.append(c3);
}

function x86_gas_vex_rm(own a: X86Asm, mnem: string, mmmmm: i32, pp: i32, vvvv: i32, op: i32, reg: i32, rm: string, l: boolean, w: boolean): X86Asm {
  if (x86_gas_has_paren(rm)) {
    let m: GasMem = x86_gas_parse_mem(rm);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + rm);
