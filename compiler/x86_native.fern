  if (store) {
    return x86_gas_vex_rm(a, mnem, 1, pp, 0, op + x86_vex_store_delta(mnem), v & 15, dst, v >= 16, false);
  }
  return x86_gas_vex_rm(a, mnem, 1, pp, 0, op, v & 15, src, v >= 16, false);
}

function x86_vex_store_delta(mnem: string): i32 {
  if (mnem == "vmovupd") {
