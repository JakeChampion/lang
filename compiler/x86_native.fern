    }
    return x86_gas_vex_rm(a, mnem, 2, 1, 0, 120, md, src, true, false);
  }
  if (mnem == "vpbroadcastb" || mnem == "vbroadcastsd") {
    let bd: i32 = x86_gas_ymm(dst);
