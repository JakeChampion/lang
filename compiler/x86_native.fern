function pf64_div2(b: i32[]): i32[] {
  let out: i32[] = [];
  let r: i32 = 0;
  let i: i32 = 0;
  while (i < b.len()) {
    let cur: i32 = r * 10 + b[i];
    out = out.append(cur / 2);
    r = cur % 2;
    i = i + 1;
  }
  if (r != 0) {
    out = out.append(5);
  }
  return out;
}

function pf64_mul2(b: i32[]): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(0);
    i = i + 1;
  }
  let carry: i32 = 0;
  let j: i32 = b.len() - 1;
  while (j >= 0) {
    let cur: i32 = b[j] * 2 + carry;
    out = out.with(j, cur % 10);
    carry = cur / 10;
    j = j - 1;
  }
  let res: i32[] = [carry];
  let k: i32 = 0;
  while (k < out.len()) {
    res = res.append(out[k]);
    k = k + 1;
  }
  return res;
}

function pf64_sub(b: i32[], from: i32, upto: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = from;
  while (i < upto) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

function pf64_all_zero(b: i32[]): boolean {
  let i: i32 = 0;
  while (i < b.len()) {
    if (b[i] != 0) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function parse_f64_bits(s: string): i64 {
  let i: i32 = 0;
  let neg: boolean = false;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  } else if (s.len() > 0 && s[0] == b'+') {
    i = 1;
  }
  let signbit: i64 = 0;
  if (neg) {
    let one: i64 = 1;
    signbit = one << 63;
  }
  let digits: i32[] = [];
  let dp: i32 = 0;
  let sticky: boolean = false;
  let started: boolean = false;
  while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
    let d: i32 = s[i] as i32 - 48;
    if (started || d != 0) {
      started = true;
      if (digits.len() < 800) {
        digits = digits.append(d);
      } else {
        if (d != 0) {
          sticky = true;
        }
      }
      dp = dp + 1;
    }
    i = i + 1;
  }
  if (i < s.len() && s[i] == b'.') {
    i = i + 1;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      let fd: i32 = s[i] as i32 - 48;
      if (started || fd != 0) {
        started = true;
        if (digits.len() < 800) {
          digits = digits.append(fd);
        } else {
          if (fd != 0) {
            sticky = true;
          }
        }
      } else {
        dp = dp - 1;
      }
      i = i + 1;
    }
  }
  if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
    i = i + 1;
    let eneg: boolean = false;
    if (i < s.len() && s[i] == b'-') {
      eneg = true;
      i = i + 1;
    } else if (i < s.len() && s[i] == b'+') {
      i = i + 1;
    }
    let exp: i32 = 0;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      if (exp < 100000) {
        exp = exp * 10 + (s[i] as i32 - 48);
      }
      i = i + 1;
    }
    if (eneg) {
      dp = dp - exp;
    } else {
      dp = dp + exp;
    }
  }
  while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
    digits = pf64_sub(digits, 0, digits.len() - 1);
  }
  if (digits.len() == 0) {
    return signbit;
  }
  if (dp > 310) {
    let inf: i64 = 2047;
    return signbit | inf << 52;
  }
  if (dp < 0 - 350) {
    return signbit;
  }
  let bexp: i32 = 0;
  while (dp > 0) {
    let hb: i32[] = pf64_div2(digits);
    if (hb.len() > 0 && hb[0] == 0) {
      digits = pf64_sub(hb, 1, hb.len());
      dp = dp - 1;
    } else {
      digits = hb;
    }
    bexp = bexp + 1;
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
      digits = pf64_sub(digits, 0, digits.len() - 1);
    }
  }
  while (dp < 0 || digits.len() > 0 && digits[0] < 5) {
    let db: i32[] = pf64_mul2(digits);
    if (db[0] != 0) {
      digits = db;
      dp = dp + 1;
    } else {
      digits = pf64_sub(db, 1, db.len());
    }
    bexp = bexp - 1;
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
      digits = pf64_sub(digits, 0, digits.len() - 1);
    }
    if (digits.len() == 0) {
      return signbit;
    }
  }
  let e: i32 = bexp + 1022;
  if (e >= 2047) {
    let inf2: i64 = 2047;
    return signbit | inf2 << 52;
  }
  let nbits: i32 = 53;
  if (e <= 0) {
    nbits = 52 + e;
  }
  if (nbits < 0) {
    return signbit;
  }
  let mant: i64 = 0;
  let k2: i32 = 0;
  while (k2 < nbits) {
    let mb: i32[] = pf64_mul2(digits);
    mant = mant * 2 + mb[0] as i64;
    digits = pf64_sub(mb, 1, mb.len());
    k2 = k2 + 1;
  }
  let rb: i32[] = pf64_mul2(digits);
  let roundbit: i32 = rb[0];
  let rest: i32[] = pf64_sub(rb, 1, rb.len());
  let st: boolean = sticky || !pf64_all_zero(rest);
  if (roundbit == 1 && (st || (mant & 1) == 1)) {
    mant = mant + 1;
  }
  if (e <= 0) {
    return signbit | mant;
  }
  let full: i64 = 1;
  full = full << 53;
  if (mant == full) {
    mant = mant / 2;
    e = e + 1;
    if (e >= 2047) {
      let inf3: i64 = 2047;
      return signbit | inf3 << 52;
    }
  }
  let hidden: i64 = 1;
  hidden = hidden << 52;
  return signbit | e as i64 << 52 | mant - hidden;
}

function x86_gas_parse_f64(s: string): f64 {
  return f64_from_bits(parse_f64_bits(s));
}

function x86_gas_escape(line: string, i: i32): (i32, i32) {
  let e: i32 = line[i + 1] as i32;
  if (e == 110) {
    return (10, 2);
  }
  if (e == 116) {
    return (9, 2);
  }
  if (e == 114) {
    return (13, 2);
  }
  if (e >= 48 && e <= 55) {
    let v: i32 = e - 48;
    let n: i32 = 2;
    while (n < 4 && i + n < line.len()) {
      let d: i32 = line[i + n] as i32;
      if (d < 48 || d > 55) {
        break;
      }
      v = v * 8 + (d - 48);
      n = n + 1;
    }
    return (v & 255, n);
  }
  return (e, 2);
}

function x86_gas_ascii(own buf: i32[], line: string): i32[] {
  let q1: i32 = x86_str_indexof(line, "\"");
  if (q1 < 0) {
    return buf;
  }
  let i: i32 = q1 + 1;
  while (i < line.len()) {
    let c: i32 = line[i] as i32;
    if (c == 34) {
      return buf;
    }
    if (c == 92 && i + 1 < line.len()) {
      let (eb, span) = x86_gas_escape(line, i);
      c = eb;
      i = i + span - 1;
    }
    buf = buf.append(c & 255);
    i = i + 1;
  }
  return buf;
}

function x86_gas_atoi(tok: string): i32 {
  let s: string = tok;
  let i: i32 = 0;
  if (s.len() > 0 && s[0] == b'$') {
    i = 1;
  }
  let neg: boolean = false;
  if (i < s.len() && s[i] == b'-') {
    neg = true;
    i = i + 1;
  }
  let v: i32 = 0;
  if (i + 1 < s.len() && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
    i = i + 2;
    while (i < s.len()) {
      let c: i32 = s[i] as i32;
      let d: i32 = 0 - 1;
      if (c >= 48 && c <= 57) {
        d = c - 48;
      } else {
        if (c >= 97 && c <= 102) {
          d = c - 97 + 10;
        } else {
          if (c >= 65 && c <= 70) {
            d = c - 65 + 10;
          }
        }
      }
      if (d >= 0) {
        v = v * 16 + d;
      }
      i = i + 1;
    }
  } else {
    while (i < s.len()) {
      let c: i32 = s[i] as i32;
      if (c >= 48 && c <= 57) {
        v = v * 10 + (c - 48);
      }
      i = i + 1;
    }
  }
  if (neg) {
    return 0 - v;
  }
  return v;
}

