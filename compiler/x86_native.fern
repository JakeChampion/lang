  buf_push_byte(a.code, packed & 255);
  buf_push_byte(a.code, x86_modrm(3, packed / 256, xr));
  buf_push_byte(a.code, x86_gas_atoi(src) & 255);
  return a;
}

function x86_gas_sse38(own a: X86Asm, mnem: string, op: i32, src: string, dst: string): X86Asm {
  let xd = x86_gas_xmm(dst);
  if (xd < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  if (x86_gas_has_paren(src)) {
    let m = x86_gas_parse_mem(src);
    if (!x86_gas_mem_ok(m)) {
