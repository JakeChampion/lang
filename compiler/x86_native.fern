function x86_gas_emit_packed(own a: X86Asm, packed: i32): X86Asm {
  let n = packed / 16777216;
  buf_push_byte(a.code, packed & 255);
  if (n >= 2) {
    buf_push_byte(a.code, packed / 256 & 255);
  }
  if (n >= 3) {
    buf_push_byte(a.code, packed / 65536 & 255);
  }
  return a;
}

function x86_gas_alu_family(own a: X86Asm, mnem: string, ext: i32, size: i32, src: string, dst: string): X86Asm {
  if (src.len() > 1 && src[0] == b'$' && x86_gas_is_symbol(slice_unchecked(src, 1, src.len()).to_owned())) {
    let name = slice_unchecked(src, 1, src.len()).to_owned();
    if (size != 64 && size != 32) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    if (x86_gas_has_paren(dst)) {
      let mi = x86_gas_parse_mem(dst);
      if (!x86_gas_mem_ok(mi) || mi.is_rip) {
        return x86_gas_bad(a, mnem + " " + src + ", " + dst);
      }
      util.push_bytes(a.code, util.le32(x86_mem_op_bytes([], size, false, 129, ext, mi, false), 0));
      return x86_queue_abs32_at(a, name, -1);
    }
    let rd = x86_gas_reg_w(dst, size);
    if (rd < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    util.push_bytes(a.code, x86_grp1_imm32_r([], size, ext, rd, 0));
    return x86_queue_abs32_at(a, name, -1);
  }
  let b = x86_rec_alu(ext, size, src, dst);
  if (b.len() > 0) {
    util.push_bytes(a.code, b);
    return a;
  }
  if (src.len() > 0 && src[0] == b'$') {
    if (!x86_gas_has_paren(dst)) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    let mi = x86_gas_parse_mem(dst);
    if (!x86_gas_mem_ok(mi)) {
      return x86_gas_bad(a, mnem + " " + dst);
    }
    let imm = x86_gas_atoi(src);
    if (size == 8 || x86_imm_fits8(imm)) {
      let opi = 131;
      if (size == 8) {
        opi = 128;
      }
      a = x86_gas_mem_op(a, size, false, opi, ext, mi, false, 1);
      buf_push_byte(a.code, imm & 255);
      return a;
    }
    let ib = 4;
    if (size == 16) {
      ib = 2;
    }
    a = x86_gas_mem_op(a, size, false, 129, ext, mi, false, ib);
    util.push_bytes(a.code, x86_imm_wide([], size, imm));
    return a;
  }
  let src_mem = x86_gas_has_paren(src);
  let dst_mem = x86_gas_has_paren(dst);
  if (src_mem != dst_mem) {
    let mt = dst;
    let rt = src;
    let op = ext * 8;
    if (src_mem) {
      mt = src;
      rt = dst;
      op = op | 2;
    }
    let m = x86_gas_parse_mem(mt);
    let r = x86_gas_reg_w(rt, size);
    if (x86_gas_mem_ok(m) && r >= 0) {
      return x86_gas_mem_op(a, size, false, x86_opsel(op, size), r, m, x86_rex8_force(size, r), 0);
    }
  }
  return x86_gas_bad(a, mnem + " " + src + ", " + dst);
}

pub function x86_rec_alu(ext: i32, size: i32, src: string, dst: string): i32[] {
  let opbase = ext * 8;
  if (src.len() > 0 && src[0] == b'$') {
    let imm = x86_gas_atoi(src);
    if (x86_gas_has_paren(dst)) {
      let mi = x86_gas_parse_mem(dst);
      if (!x86_gas_mem_ok(mi) || mi.is_rip) {
        return [];
      }
      if (size == 8 || x86_imm_fits8(imm)) {
        let opi = 131;
        if (size == 8) {
          opi = 128;
        }
        return x86_mem_op_bytes([], size, false, opi, ext, mi, false).append(imm & 255);
      }
      return x86_imm_wide(x86_mem_op_bytes([], size, false, 129, ext, mi, false), size, imm);
    }
    let rd = x86_gas_reg_w(dst, size);
    if (rd < 0) {
      return [];
    }
    return x86_rec_alu_ir(ext, size, imm, rd);
  }
  let src_mem = x86_gas_has_paren(src);
  let dst_mem = x86_gas_has_paren(dst);
  if (src_mem && dst_mem) {
    return [];
  }
  if (src_mem || dst_mem) {
    let mt = dst;
    let rt = src;
    let op = opbase;
    if (src_mem) {
      mt = src;
      rt = dst;
      op = opbase | 2;
    }
    let m = x86_gas_parse_mem(mt);
    let r = x86_gas_reg_w(rt, size);
    if (!x86_gas_mem_ok(m) || m.is_rip || r < 0) {
      return [];
    }
    return x86_mem_op_bytes([], size, false, x86_opsel(op, size), r, m, x86_rex8_force(size, r));
  }
  let r1 = x86_gas_reg_w(src, size);
  let r2 = x86_gas_reg_w(dst, size);
  if (r1 < 0 || r2 < 0) {
    return [];
  }
  return x86_rec_alu_rr(ext, size, r1, r2);
}

function x86_gas_test_family(own a: X86Asm, size: i32, src: string, dst: string): X86Asm {
  let b = x86_rec_test(size, src, dst);
  if (b.len() > 0) {
    util.push_bytes(a.code, b);
    return a;
  }
  if (src.len() > 0 && src[0] == b'$') {
    if (!x86_gas_has_paren(dst)) {
      return x86_gas_bad(a, "test " + src + ", " + dst);
    }
    let mi = x86_gas_parse_mem(dst);
    if (!x86_gas_mem_ok(mi)) {
      return x86_gas_bad(a, "test " + dst);
    }
    let imm = x86_gas_atoi(src);
    let ib = 4;
    if (size == 8) {
      ib = 1;
    }
    if (size == 16) {
      ib = 2;
    }
    a = x86_gas_mem_op(a, size, false, x86_opsel(246, size), 0, mi, false, ib);
    if (size == 8) {
      buf_push_byte(a.code, imm & 255);
      return a;
    }
    util.push_bytes(a.code, x86_imm_wide([], size, imm));
    return a;
  }
  let src_mem = x86_gas_has_paren(src);
  if (src_mem != x86_gas_has_paren(dst)) {
    let mop = src;
    let rop = dst;
    if (!src_mem) {
      mop = dst;
      rop = src;
    }
    let m2 = x86_gas_parse_mem(mop);
    let rr = x86_gas_reg_w(rop, size);
    if (x86_gas_mem_ok(m2) && rr >= 0) {
      return x86_gas_mem_op(a, size, false, x86_opsel(132, size), rr, m2, x86_rex8_force(size, rr), 0);
    }
  }
  return x86_gas_bad(a, "test " + src + ", " + dst);
}

pub function x86_rec_test(size: i32, src: string, dst: string): i32[] {
  if (src.len() > 0 && src[0] == b'$') {
    let imm = x86_gas_atoi(src);
    if (x86_gas_has_paren(dst)) {
      let mi = x86_gas_parse_mem(dst);
      if (!x86_gas_mem_ok(mi) || mi.is_rip) {
        return [];
      }
      let mb = x86_mem_op_bytes([], size, false, x86_opsel(246, size), 0, mi, false);
      if (size == 8) {
        return mb.append(imm & 255);
      }
      return x86_imm_wide(mb, size, imm);
    }
    let rd = x86_gas_reg_w(dst, size);
    if (rd < 0) {
      return [];
    }
    return x86_rec_test_ir(size, imm, rd);
  }
  let src_mem = x86_gas_has_paren(src);
  let dst_mem = x86_gas_has_paren(dst);
  if (src_mem && dst_mem) {
    return [];
  }
  if (src_mem || dst_mem) {
    let mop = src;
    let rop = dst;
    if (dst_mem) {
      mop = dst;
      rop = src;
    }
    let m2 = x86_gas_parse_mem(mop);
    let rr = x86_gas_reg_w(rop, size);
    if (!x86_gas_mem_ok(m2) || m2.is_rip || rr < 0) {
      return [];
    }
    return x86_mem_op_bytes([], size, false, x86_opsel(132, size), rr, m2, x86_rex8_force(size, rr));
  }
  let r1 = x86_gas_reg_w(src, size);
  let r2 = x86_gas_reg_w(dst, size);
  if (r1 < 0 || r2 < 0) {
    return [];
  }
  return x86_rec_test_rr(size, r1, r2);
}

function x86_gas_unary_family(own a: X86Asm, mnem: string, opbase: i32, ext: i32, size: i32, op: string): X86Asm {
  if (x86_gas_has_paren(op)) {
    let m = x86_gas_parse_mem(op);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + op);
    }
    return x86_gas_mem_op(a, size, false, x86_opsel(opbase, size), ext, m, false, 0);
  }
  let r = x86_gas_reg_w(op, size);
  if (r < 0) {
    return x86_gas_bad(a, mnem + " " + op);
  }
  util.push_bytes(a.code, x86_unary_r([], size, opbase, ext, r));
  return a;
}

function x86_gas_shift_family(own a: X86Asm, mnem: string, ext: i32, size: i32, src: string, dst: string): X86Asm {
  let by_cl = src == "%cl";
  if (!by_cl && (src.len() == 0 || src[0] != b'$')) {
    return x86_gas_bad(a, mnem + " " + src);
  }
  let imm = 0;
  if (!by_cl) {
    imm = x86_gas_atoi(src);
  }
  if (x86_gas_has_paren(dst)) {
    let m = x86_gas_parse_mem(dst);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + dst);
    }
    let op = x86_opsel(210, size);
    let tail = 0;
    if (!by_cl) {
      if (imm == 1) {
        op = x86_opsel(208, size);
      } else {
        op = x86_opsel(192, size);
        tail = 1;
      }
    }
    a = x86_gas_mem_op(a, size, false, op, ext, m, false, tail);
    if (tail == 1) {
      buf_push_byte(a.code, imm & 255);
      return a;
    }
    return a;
  }
  let r = x86_gas_reg_w(dst, size);
  if (r < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  if (by_cl) {
    util.push_bytes(a.code, x86_shift_r_cl([], size, ext, r));
    return a;
  }
  util.push_bytes(a.code, x86_shift_r_imm([], size, ext, r, imm));
  return a;
}

function x86_gas_shld_family(own a: X86Asm, mnem: string, opimm: i32, size: i32, rest: string): X86Asm {
  let ops = x86_gas_split_ops(rest);
  if (ops.len() != 3 || size == 8) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let rs = x86_gas_reg_w(ops[1], size);
  if (rs < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let by_cl = ops[0] == "%cl";
  if (!by_cl && (ops[0].len() == 0 || ops[0][0] != b'$')) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let op = opimm;
  if (by_cl) {
    op = opimm + 1;
  }
  let imm = 0;
  let tail = 0;
  if (!by_cl) {
    imm = x86_gas_atoi(ops[0]);
    tail = 1;
  }
  if (x86_gas_has_paren(ops[2])) {
    let m = x86_gas_parse_mem(ops[2]);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + ops[2]);
    }
    a = x86_gas_mem_op(a, size, true, op, rs, m, false, tail);
    if (!by_cl) {
      buf_push_byte(a.code, imm & 255);
      return a;
    }
    return a;
  }
  let rd = x86_gas_reg_w(ops[2], size);
  if (rd < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  util.push_bytes(a.code, x86_op0f_rr([], size, op, rs, rd));
  if (!by_cl) {
    buf_push_byte(a.code, imm & 255);
    return a;
  }
  return a;
}

function x86_gas_bt_family(own a: X86Asm, mnem: string, idx: i32, size: i32, src: string, dst: string): X86Asm {
  if (size == 8) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  if (src.len() > 0 && src[0] == b'$') {
    let imm = x86_gas_atoi(src);
    if (x86_gas_has_paren(dst)) {
      let mi = x86_gas_parse_mem(dst);
      if (!x86_gas_mem_ok(mi)) {
        return x86_gas_bad(a, mnem + " " + dst);
      }
      a = x86_gas_mem_op(a, size, true, 186, 4 + idx, mi, false, 1);
      buf_push_byte(a.code, imm & 255);
      return a;
    }
    let rd = x86_gas_reg_w(dst, size);
    if (rd < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    util.push_bytes(a.code, x86_op0f_rr([], size, 186, 4 + idx, rd));
    buf_push_byte(a.code, imm & 255);
    return a;
  }
  let rs = x86_gas_reg_w(src, size);
  if (rs < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  let regop = 163 + idx * 8;
  if (x86_gas_has_paren(dst)) {
    let m = x86_gas_parse_mem(dst);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + dst);
    }
    return x86_gas_mem_op(a, size, true, regop, rs, m, false, 0);
  }
  let rd2 = x86_gas_reg_w(dst, size);
  if (rd2 < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  util.push_bytes(a.code, x86_op0f_rr([], size, regop, rs, rd2));
  return a;
}

function x86_gas_rmw_family(own a: X86Asm, mnem: string, opbase: i32, size: i32, src: string, dst: string): X86Asm {
  let rs = x86_gas_reg_w(src, size);
  if (rs < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  let op = x86_opsel(opbase, size);
  if (x86_gas_has_paren(dst)) {
    let m = x86_gas_parse_mem(dst);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + dst);
    }
    return x86_gas_mem_op(a, size, true, op, rs, m, x86_rex8_force(size, rs), 0);
  }
  let rd = x86_gas_reg_w(dst, size);
  if (rd < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  util.push_bytes(a.code, x86_op0f_rr([], size, op, rs, rd));
  return a;
}

function x86_gas_xchg_family(own a: X86Asm, mnem: string, size: i32, src: string, dst: string): X86Asm {
  let src_mem = x86_gas_has_paren(src);
  let dst_mem = x86_gas_has_paren(dst);
  if (src_mem != dst_mem) {
    let mop = src;
    let rop = dst;
    if (dst_mem) {
      mop = dst;
      rop = src;
    }
    let m = x86_gas_parse_mem(mop);
    let rr = x86_gas_reg_w(rop, size);
    if (!x86_gas_mem_ok(m) || rr < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    return x86_gas_mem_op(a, size, false, x86_opsel(134, size), rr, m, x86_rex8_force(size, rr), 0);
  }
  let r1 = x86_gas_reg_w(src, size);
  let r2 = x86_gas_reg_w(dst, size);
  if (r1 < 0 || r2 < 0 || src_mem) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  util.push_bytes(a.code, x86_op_rr([], size, 134, r1, r2));
  return a;
}

function x86_gas_cmov_family(own a: X86Asm, mnem: string, src: string, dst: string): X86Asm {
  let cond = slice_unchecked(mnem, 4, mnem.len()).to_owned();
  let size = 0;
  let cc = x86_gas_cc_code(cond);
  if (cc >= 0) {
    size = 64;
    if (x86_gas_reg32(dst) >= 0) {
      size = 32;
    }
    if (x86_gas_reg16(dst) >= 0) {
      size = 16;
    }
  } else {
    size = x86_gas_suffix_size(mnem);
    if (size == 0 || size == 8) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
    cc = x86_gas_cc_code(slice_unchecked(cond, 0, cond.len() - 1).to_owned());
    if (cc < 0) {
      return x86_gas_bad(a, mnem + " " + src + ", " + dst);
    }
  }
  let rd = x86_gas_reg_w(dst, size);
  if (rd < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  if (x86_gas_has_paren(src)) {
    let m = x86_gas_parse_mem(src);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, mnem + " " + src);
    }
    return x86_gas_mem_op(a, size, true, 64 + cc, rd, m, false, 0);
  }
  let rs = x86_gas_reg_w(src, size);
  if (rs < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  util.push_bytes(a.code, x86_cmovcc_rr([], size, cc, rd, rs));
  return a;
}

function x86_gas_imul_ops(rest: string): string[] {
  let ops = x86_gas_split_ops(rest);
  if (ops.len() == 2 && ops[0].len() > 0 && ops[0][0] == b'$') {
    return ops.append(ops[1]);
  }
  return ops;
}

function x86_gas_imul_family(own a: X86Asm, mnem: string, size: i32, rest: string): X86Asm {
  let ops = x86_gas_imul_ops(rest);
  if (ops.len() == 1) {
    return x86_gas_unary_family(a, mnem, 246, 5, size, ops[0]);
  }
  if (size == 8) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  if (ops.len() == 2) {
    let rd = x86_gas_reg_w(ops[1], size);
    if (rd < 0) {
      return x86_gas_bad(a, mnem + " " + rest);
    }
    if (x86_gas_has_paren(ops[0])) {
      let m = x86_gas_parse_mem(ops[0]);
      if (!x86_gas_mem_ok(m)) {
        return x86_gas_bad(a, mnem + " " + ops[0]);
      }
      return x86_gas_mem_op(a, size, true, 175, rd, m, false, 0);
    }
    let rs = x86_gas_reg_w(ops[0], size);
    if (rs < 0) {
      return x86_gas_bad(a, mnem + " " + rest);
    }
    util.push_bytes(a.code, x86_op0f_rr([], size, 175, rd, rs));
    return a;
  }
  if (ops.len() != 3 || ops[0].len() == 0 || ops[0][0] != b'$') {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  let imm = x86_gas_atoi(ops[0]);
  let rs3 = x86_gas_reg_w(ops[1], size);
  let rd3 = x86_gas_reg_w(ops[2], size);
  if (rs3 < 0 || rd3 < 0) {
    return x86_gas_bad(a, mnem + " " + rest);
  }
  util.push_bytes(a.code, x86_osz([], size));
  util.push_bytes(a.code, x86_rex_rr([], size, rd3, rs3));
  if (x86_imm_fits8(imm)) {
    buf_push_byte(a.code, 107);
    buf_push_byte(a.code, x86_modrm(3, rd3, rs3));
    buf_push_byte(a.code, imm & 255);
    return a;
  }
  buf_push_byte(a.code, 105);
  buf_push_byte(a.code, x86_modrm(3, rd3, rs3));
  util.push_bytes(a.code, x86_imm_wide([], size, imm));
  return a;
}

function x86_gas_bswap(own a: X86Asm, mnem: string, size: i32, op: string): X86Asm {
  if (size == 0 && x86_gas_reg32(op) >= 0) {
    size = 32;
  } else if (size == 0 && x86_gas_reg64(op) >= 0) {
    size = 64;
  }
  if (size != 32 && size != 64) {
    return x86_gas_bad(a, mnem + " " + op);
  }
  let r = x86_gas_reg_w(op, size);
  if (r < 0) {
    return x86_gas_bad(a, mnem + " " + op);
  }
  let rex = x86_rex(x86_rex_w_of(size), 0, 0, r);
  if (rex != 64) {
    buf_push_byte(a.code, rex);
  }
  buf_push_byte(a.code, 15);
  buf_push_byte(a.code, 200 + (r & 7));
  return a;
}

function x86_gas_crc32_family(own a: X86Asm, size: i32, src: string, dst: string): X86Asm {
  let dsize = 32;
  let rd = x86_gas_reg32(dst);
  if (rd < 0) {
    rd = x86_gas_reg64(dst);
    dsize = 64;
  }
  if (rd < 0) {
    return x86_gas_bad(a, "crc32 " + dst);
  }
  if (dsize == 64 && size != 8 && size != 64) {
    return x86_gas_bad(a, "crc32 " + src + ", " + dst);
  }
  if (dsize == 32 && size == 64) {
    return x86_gas_bad(a, "crc32 " + src + ", " + dst);
  }
  let op = 241;
  if (size == 8) {
    op = 240;
  }
  if (size == 16) {
    buf_push_byte(a.code, 102);
  }
  buf_push_byte(a.code, 242);
  if (x86_gas_has_paren(src)) {
    let m = x86_gas_parse_mem(src);
    if (!x86_gas_mem_ok(m)) {
      return x86_gas_bad(a, "crc32 " + src);
    }
    util.push_bytes(a.code, x86_gas_mem_rex([], dsize, rd, m, false));
    buf_push_byte(a.code, 15);
    buf_push_byte(a.code, 56);
    buf_push_byte(a.code, op);
    return x86_gas_membytes(a, rd, m, 0);
  }
  let rs = x86_gas_reg_w(src, size);
  if (rs < 0) {
    return x86_gas_bad(a, "crc32 " + src + ", " + dst);
  }
  let rex = x86_rex(x86_rex_w_of(dsize), rd, 0, rs);
  if (rex != 64 || x86_rex8_force(size, rs)) {
    buf_push_byte(a.code, rex);
  }
  buf_push_byte(a.code, 15);
  buf_push_byte(a.code, 56);
  buf_push_byte(a.code, op);
  buf_push_byte(a.code, x86_modrm(3, rd, rs));
  return a;
}

