function x86_gas_parse_mem(op: string): GasMem {
  let lp: i32 = x86_str_indexof(op, "(");
  if (lp < 0) {
    return GasMem { is_rip: false, label: "", base: x86_gas_reg(op), disp: 0, has_index: false, index: 0, scale: 1, no_base: false };
  }
  let disp_str: str = slice_unchecked(op, 0, lp);
  let inner: str = slice_unchecked(op, lp + 1, op.len() - 1);
  if (inner == "%rip") {
    return GasMem { is_rip: true, label: disp_str + "", base: 0, disp: 0, has_index: false, index: 0, scale: 1, no_base: false };
  }
  let d: i32 = 0;
  if (disp_str.len() > 0) {
    d = x86_gas_atoi(disp_str);
  }
  let c1: i32 = x86_str_indexof(inner, ",");
  if (c1 < 0) {
    return GasMem { is_rip: false, label: "", base: x86_gas_reg(x86_gas_trimmed(inner)), disp: d, has_index: false, index: 0, scale: 1, no_base: false };
  }
  let b0: str = x86_gas_trimmed(slice_unchecked(inner, 0, c1));
  let after: str = slice_unchecked(inner, c1 + 1, inner.len());
  let c2: i32 = x86_str_indexof(after, ",");
  if (c2 < 0) {
    return GasMem { is_rip: false, label: "", base: x86_gas_reg(b0), disp: d, has_index: true, index: x86_gas_reg(x86_gas_trimmed(after)), scale: 1, no_base: b0.len() == 0 };
  }
  let ix: i32 = x86_gas_reg(x86_gas_trimmed(slice_unchecked(after, 0, c2)));
  let scale_str: str = slice_unchecked(after, c2 + 1, after.len());
  let c3: i32 = x86_str_indexof(scale_str, ",");
  if (c3 >= 0) {
    scale_str = slice_unchecked(scale_str, 0, c3);
  }
  let sc: i32 = x86_gas_atoi(x86_gas_trimmed(scale_str));
  return GasMem { is_rip: false, label: "", base: x86_gas_reg(b0), disp: d, has_index: true, index: ix, scale: sc, no_base: b0.len() == 0 };
}

function x86_gas_movq(own a: X86Asm, src: string, dst: string): X86Asm {
  let src_xmm: boolean = x86_gas_is_xmm(src);
  let dst_xmm: boolean = x86_gas_is_xmm(dst);
  if (dst_xmm && src_xmm) {
    x86_push_arr(a.code, x86_sse_any_rr([], 243, 126, x86_gas_xmm(dst), x86_gas_xmm(src)));
    return a;
  }
  if (dst_xmm && !src_xmm) {
    if (x86_gas_has_paren(src)) {
      let xm: GasMem = x86_gas_parse_mem(src);
      if (!x86_gas_mem_ok(xm)) {
        return x86_gas_bad(a, "movq " + src + ", " + dst);
      }
      buf_push_byte(a.code, 102);
      x86_push_arr(a.code, x86_gas_mem_rex([], 64, x86_gas_xmm(dst), xm, false));
      buf_push_byte(a.code, 15);
      buf_push_byte(a.code, 110);
      return x86_gas_membytes(a, x86_gas_xmm(dst), xm, 0);
    }
    let gs: i32 = x86_gas_reg(src);
    if (gs < 0) {
      return x86_gas_bad(a, "movq " + src + ", " + dst);
    }
    x86_push_arr(a.code, x86_movq_gpr_to_xmm([], x86_gas_xmm(dst), gs));
    return a;
  }
  if (src_xmm && !dst_xmm) {
    if (x86_gas_has_paren(dst)) {
      let xm2: GasMem = x86_gas_parse_mem(dst);
      if (!x86_gas_mem_ok(xm2)) {
        return x86_gas_bad(a, "movq " + src + ", " + dst);
      }
      buf_push_byte(a.code, 102);
      x86_push_arr(a.code, x86_gas_mem_rex([], 64, x86_gas_xmm(src), xm2, false));
      buf_push_byte(a.code, 15);
      buf_push_byte(a.code, 126);
      return x86_gas_membytes(a, x86_gas_xmm(src), xm2, 0);
    }
    let gd: i32 = x86_gas_reg(dst);
    if (gd < 0) {
      return x86_gas_bad(a, "movq " + src + ", " + dst);
    }
    x86_push_arr(a.code, x86_movq_xmm_to_gpr([], x86_gas_xmm(src), gd));
    return a;
  }
  return x86_gas_mov_rm(a, "movq", 64, src, dst);
}

function x86_gas_top_comma(s: string): i32 {
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    let c: u8 = s[i];
    if (c == b'(') {
      depth = depth + 1;
    } else {
      if (c == b')') {
        depth = depth - 1;
      } else {
        if (c == b',' && depth == 0) {
          return i;
        }
      }
    }
    i = i + 1;
  }
  return 0 - 1;
}

