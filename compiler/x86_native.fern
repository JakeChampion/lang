function x86_gas_movmsk(own a: X86Asm, mnem: string, pfx: i32, op: i32, src: string, dst: string): X86Asm {
  let rd = x86_gas_reg32(dst);
  if (rd < 0) {
    rd = x86_gas_reg64(dst);
  }
  let xs = x86_gas_xmm(src);
  if (rd < 0 || xs < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
  }
  util.push_bytes(a.code, x86_sse_any_rr([], pfx, op, rd, xs));
  return a;
}

function x86_gas_vshift_imm(own a: X86Asm, mnem: string, packed: i32, src: string, dst: string): X86Asm {
  let xr = x86_gas_xmm(dst);
  if (xr < 0) {
    return x86_gas_bad(a, mnem + " " + src + ", " + dst);
