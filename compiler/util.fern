import "std/envflag";

pub function arity_message(subject: string, want: i32, got: i32, unit: string): string {
  let units: string = unit;
  if (want != 1) {
    units = unit + "s";
  }
  return subject + " takes " + i32_to_string(want) + " " + units + " but was given " + i32_to_string(got);
}

pub function i32_to_string(n: i32): string {
  if (n == 0) {
    return "0";
  }
  if (n < 0 && 0 - n == n) {
    return "-2147483648";
  }
  let neg: boolean = n < 0;
  if (neg) {
    n = 0 - n;
  }
  let len: i32 = 0;
  let m: i32 = n;
  while (m > 0) {
    len = len + 1;
    m = m / 10;
  }
  if (neg) {
    len = len + 1;
  }
  let buf: u8[] = __alloc_u8(len);
  let at: i32 = len;
  while (n > 0) {
    at = at - 1;
    buf = buf.with(at, (48 + n % 10) as u8);
    n = n / 10;
  }
  if (neg) {
    buf = buf.with(0, 45 as u8);
  }
  return string_from_bytes_unchecked(buf);
}

pub function i64_to_string(n: i64): string {
  if (n == 0) {
    return "0";
  }
  if (n < 0 && 0 - n == n) {
    return "-9223372036854775808";
  }
  let neg: boolean = n < 0;
  if (neg) {
    n = 0 - n;
  }
  let len: i32 = 0;
  let m: i64 = n;
  while (m > 0) {
    len = len + 1;
    m = m / 10;
  }
  if (neg) {
    len = len + 1;
  }
  let buf: u8[] = __alloc_u8(len);
  let at: i32 = len;
  while (n > 0) {
    at = at - 1;
    buf = buf.with(at, (48 + (n % 10) as i32) as u8);
    n = n / 10;
  }
  if (neg) {
    buf = buf.with(0, 45 as u8);
  }
  return string_from_bytes_unchecked(buf);
}

pub function digest_start(): i64 {
  return 0 - 3750763034362895579i64;
}

pub function roll_wide(d: i64, v: i64): i64 {
  let h: i64 = (d ^ v) * (0 - 7046029254386353131i64);
  return h ^ h >> 32 & 4294967295i64;
}

pub function roll(d: i64, w: i32): i64 {
  return roll_wide(d, w as i64);
}

pub function roll_text(d: i64, s: string): i64 {
  let out: i64 = roll(d, s.len());
  let i: i32 = 0;
  while (i < s.len()) {
    out = roll(out, s[i] as i32);
    i = i + 1;
  }
  return out;
}

pub function roll_words(d: i64, xs: i32[]): i64 {
  let out: i64 = roll(d, xs.len());
  let i: i32 = 0;
  while (i < xs.len()) {
    out = roll(out, xs[i]);
    i = i + 1;
  }
  return out;
}

pub function roll_flag(d: i64, x: boolean): i64 {
  if (x) {
    return roll(d, 1);
  }
  return roll(d, 0);
}

pub function digest_text(d: i64): string {
  return i32_to_string((d >> 32) as i32) + "_" + i32_to_string(d as i32);
}

pub function hash_key(s: string): string {
  let a: i32 = 208357;
  let b: i32 = 5381;
  let i: i32 = 0;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    a = a * 31 + c + 1 & 1073741823;
    b = b * 131 + c + 7 & 1073741823;
    i = i + 1;
  }
  a = a * 31 + s.len() & 1073741823;
  b = b * 131 + s.len() & 1073741823;
  return i32_to_string(a) + "_" + i32_to_string(b);
}

pub function hash_bucket(s: string, n: i32): i32 {
  if (n <= 1) {
    return 0;
  }
  return (__str_hash(s, 0) & 1073741823) % n;
}

pub function minus_ones(n: i32): i32[] {
  let out: i32[] = __alloc_i32(n);
  let i: i32 = 0;
  while (i < n) {
    out = out.with(i, 0 - 1);
    i = i + 1;
  }
  return out;
}

pub struct NameIndex { names: string[], head: i32[], next: i32[] }

pub function name_bucket(s: string, mask: i32): i32 {
  return __str_hash(s, 0) & mask;
}

function bucket_count(n: i32): i32 {
  let nb: i32 = 2;
  while (nb <= n * 2) {
    nb = nb * 2;
  }
  return nb;
}

pub function name_index(names: string[]): NameIndex {
  let nb: i32 = bucket_count(names.len());
  let head: i32[] = minus_ones(nb);
  let next: i32[] = minus_ones(names.len());
  let k: i32 = names.len() - 1;
  while (k >= 0) {
    let b: i32 = name_bucket(names[k], nb - 1);
    next = next.with(k, head[b]);
    head = head.with(b, k);
    k = k - 1;
  }
  return NameIndex { names: names, head: head, next: next };
}

pub function (ix: NameIndex) chain(name: string): i32 {
  return ix.head[name_bucket(name, ix.head.len() - 1)];
}

pub function (ix: NameIndex) find(name: string): i32 {
  let i: i32 = ix.head[name_bucket(name, ix.head.len() - 1)];
  while (i >= 0) {
    if (ix.names[i] == name) {
      return i;
    }
    i = ix.next[i];
  }
  return 0 - 1;
}

pub function (ix: NameIndex) has(name: string): boolean {
  return ix.find(name) >= 0;
}

pub function (ix: NameIndex) added(name: string): NameIndex {
  let names: string[] = ix.names.append(name);
  if (names.len() > ix.head.len()) {
    return name_index(names);
  }
  let k: i32 = names.len() - 1;
  let b: i32 = name_bucket(name, ix.head.len() - 1);
  let head: i32[] = ix.head;
  let next: i32[] = ix.next.append(0 - 1);
  if (head[b] < 0) {
    head = head.with(b, k);
  } else {
    let t: i32 = head[b];
    while (next[t] >= 0) {
      t = next[t];
    }
    next = next.with(t, k);
  }
  return NameIndex { names: names, head: head, next: next };
}

pub function lit_to_i32(s: string): i32 {
  if (s.len() == 0) {
    return 0;
  }
  let neg: boolean = false;
  let start: i32 = 0;
  if (s[0] == b'-') {
    neg = true;
    start = 1;
  }
  if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'x' || s[start + 1] == b'X')) {
    let acc: i32 = 0;
    let i: i32 = start + 2;
    while (i < s.len()) {
      let b: i32 = s[i] as i32;
      let d: i32 = 0 - 1;
      if (b >= 48 && b <= 57) {
        d = b - 48;
      } else if (b >= 97 && b <= 102) {
        d = b - 97 + 10;
      } else if (b >= 65 && b <= 70) {
        d = b - 65 + 10;
      }
      if (d < 0) {
        break;
      }
      acc = acc * 16 + d;
      i = i + 1;
    }
    if (neg) {
      return 0 - acc;
    }
    return acc;
  }
  if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'b' || s[start + 1] == b'B')) {
    let bacc: i32 = 0;
    let bi: i32 = start + 2;
    while (bi < s.len()) {
      let bb: i32 = s[bi] as i32;
      if (bb != 48 && bb != 49) {
        break;
      }
      bacc = bacc * 2 + (bb - 48);
      bi = bi + 1;
    }
    if (neg) {
      return 0 - bacc;
    }
    return bacc;
  }
  return digits_to_i32(s);
}

pub function lit_to_i64(s: string): i64 {
  if (s.len() == 0) {
    return 0;
  }
  let neg: boolean = false;
  let start: i32 = 0;
  if (s[0] == b'-') {
    neg = true;
    start = 1;
  }
  if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'x' || s[start + 1] == b'X')) {
    let acc: i64 = 0;
    let i: i32 = start + 2;
    while (i < s.len()) {
      let b: i32 = s[i] as i32;
      let d: i32 = 0 - 1;
      if (b >= 48 && b <= 57) {
        d = b - 48;
      } else if (b >= 97 && b <= 102) {
        d = b - 97 + 10;
      } else if (b >= 65 && b <= 70) {
        d = b - 65 + 10;
      }
      if (d < 0) {
        break;
      }
      acc = acc * 16 + d as i64;
      i = i + 1;
    }
    if (neg) {
      return 0 - acc;
    }
    return acc;
  }
  if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'b' || s[start + 1] == b'B')) {
    let bacc: i64 = 0;
    let bi: i32 = start + 2;
    while (bi < s.len()) {
      let bb: i32 = s[bi] as i32;
      if (bb != 48 && bb != 49) {
        break;
      }
      bacc = bacc * 2 + (bb - 48) as i64;
      bi = bi + 1;
    }
    if (neg) {
      return 0 - bacc;
    }
    return bacc;
  }
  return digits_to_i64(s);
}

pub function digits_to_i32(s: string): i32 {
  if (s.len() == 0) {
    return 0;
  }
  let neg: boolean = false;
  let start: i32 = 0;
  if (s[0] == b'-') {
    neg = true;
    start = 1;
  }
  let acc: i32 = 0;
  let i: i32 = start;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b < 48 || b > 57) {
      if (neg) {
        return 0 - acc;
      }
      return acc;
    }
    acc = acc * 10 + (b - 48);
    i = i + 1;
  }
  if (neg) {
    return 0 - acc;
  }
  return acc;
}

pub function is_decimal_i32(s: string): boolean {
  return decimal_within(s, "2147483647", "2147483648");
}

pub function is_decimal_i64(s: string): boolean {
  return decimal_within(s, "9223372036854775807", "9223372036854775808");
}

function decimal_within(s: string, pos: string, neg: string): boolean {
  let start: i32 = 0;
  if (s.len() > 0 && s[0] == b'-') {
    start = 1;
  }
  let n: i32 = s.len() - start;
  if (n == 0) {
    return false;
  }
  let i: i32 = start;
  while (i < s.len()) {
    if (s[i] < b'0' || s[i] > b'9') {
      return false;
    }
    i = i + 1;
  }
  if (s[start] == b'0') {
    return n == 1 && start == 0;
  }
  let limit: string = pos;
  if (start == 1) {
    limit = neg;
  }
  if (n != limit.len()) {
    return n < limit.len();
  }
  i = 0;
  while (i < n) {
    if (s[start + i] != limit[i]) {
      return s[start + i] < limit[i];
    }
    i = i + 1;
  }
  return true;
}

pub function digits_to_i64(s: string): i64 {
  if (s.len() == 0) {
    return 0;
  }
  let neg: boolean = false;
  let start: i32 = 0;
  if (s[0] == b'-') {
    neg = true;
    start = 1;
  }
  let acc: i64 = 0;
  let i: i32 = start;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b < 48 || b > 57) {
      if (neg) {
        return 0 - acc;
      }
      return acc;
    }
    acc = acc * 10 + (b - 48) as i64;
    i = i + 1;
  }
  if (neg) {
    return 0 - acc;
  }
  return acc;
}

pub function is_all_digits(s: string): boolean {
  if (s.len() == 0) {
    return false;
  }
  let i: i32 = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b < 48 || b > 57) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function has_str(xs: string[], s: string): boolean {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == s) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function base_type_name(t: string): string {
  let i: i32 = 0;
  while (i < t.len()) {
    if (t[i] == b'[') {
      return slice_unchecked(t, 0, i) + "";
    }
    i = i + 1;
  }
  return t;
}

pub function is_tuple_type_name(t: string): boolean {
  return t.len() >= 2 && slice_unchecked(t, 0, 1) == "(";
}

pub function mangled_module(name: string): string {
  let i: i32 = 1;
  while (i + 1 < name.len()) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      return slice_unchecked(name, 0, i) + "";
    }
    i = i + 1;
  }
  return "";
}

pub function mangled_name(name: string): string {
  let i: i32 = 1;
  while (i + 1 < name.len()) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      return slice_unchecked(name, i + 2, name.len()) + "";
    }
    i = i + 1;
  }
  return name;
}

pub function str_less(a: string, b: string): boolean {
  let n: i32 = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  let i: i32 = 0;
  while (i < n) {
    if (a[i] != b[i]) {
      return a[i] < b[i];
    }
    i = i + 1;
  }
  return a.len() < b.len();
}

pub function index_of_str(xs: string[], s: string): i32 {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == s) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function index_of_i32(xs: i32[], n: i32): i32 {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == n) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function str_has_prefix(s: string, prefix: string): boolean {
  if (s.len() < prefix.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < prefix.len()) {
    if (s[i] != prefix[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function str_has_suffix(s: string, suffix: string): boolean {
  let at: i32 = s.len() - suffix.len();
  if (at < 0) {
    return false;
  }
  let i: i32 = 0;
  while (i < suffix.len()) {
    if (s[at + i] != suffix[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function contains(haystack: string, needle: string): boolean {
  return index_of_sub(haystack, needle) >= 0;
}

pub function index_of_sub(haystack: string, needle: string): i32 {
  let n: i32 = needle.len();
  if (n == 0) {
    return 0;
  }
  let last: i32 = haystack.len() - n;
  let first: i32 = needle[0] as i32;
  let i: i32 = __memchr(haystack, first, 0);
  while (i >= 0 && i <= last) {
    if (__mismatch(haystack, i, needle, 0, n) == n) {
      return i;
    }
    i = __memchr(haystack, first, i + 1);
  }
  return 0 - 1;
}

pub function index_of_sub_from(haystack: string, needle: string, from: i32): i32 {
  let start: i32 = from;
  if (start < 0) {
    start = 0;
  }
  if (start > haystack.len()) {
    start = haystack.len();
  }
  let n: i32 = needle.len();
  if (n == 0) {
    return start;
  }
  let last: i32 = haystack.len() - n;
  let first: i32 = needle[0] as i32;
  let i: i32 = __memchr(haystack, first, start);
  while (i >= 0 && i <= last) {
    if (__mismatch(haystack, i, needle, 0, n) == n) {
      return i;
    }
    i = __memchr(haystack, first, i + 1);
  }
  return 0 - 1;
}

pub function parse_f64_bits(s: string): i64 {
  let i: i32 = 0;
  let neg: boolean = false;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  } else if (s.len() > 0 && s[0] == b'+') {
    i = 1;
  }
  let signbit: i64 = 0;
  if (neg) {
    let one: i64 = 1;
    signbit = one << 63;
  }
  let digits: i32[] = [];
  let dp: i32 = 0;
  let sticky: boolean = false;
  let started: boolean = false;
  while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
    let d: i32 = s[i] as i32 - 48;
    if (started || d != 0) {
      started = true;
      if (digits.len() < 800) {
        digits = digits.append(d);
      } else {
        if (d != 0) {
          sticky = true;
        }
      }
      dp = dp + 1;
    }
    i = i + 1;
  }
  if (i < s.len() && s[i] == b'.') {
    i = i + 1;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      let fd: i32 = s[i] as i32 - 48;
      if (started || fd != 0) {
        started = true;
        if (digits.len() < 800) {
          digits = digits.append(fd);
        } else {
          if (fd != 0) {
            sticky = true;
          }
        }
      } else {
        dp = dp - 1;
      }
      i = i + 1;
    }
  }
  if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
    i = i + 1;
    let eneg: boolean = false;
    if (i < s.len() && s[i] == b'-') {
      eneg = true;
      i = i + 1;
    } else if (i < s.len() && s[i] == b'+') {
      i = i + 1;
    }
    let exp: i32 = 0;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      if (exp < 100000) {
        exp = exp * 10 + (s[i] as i32 - 48);
      }
      i = i + 1;
    }
    if (eneg) {
      dp = dp - exp;
    } else {
      dp = dp + exp;
    }
  }
  while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
    digits = pf64_sub(digits, 0, digits.len() - 1);
  }
  if (digits.len() == 0) {
    return signbit;
  }
  if (dp > 310) {
    let inf: i64 = 2047;
    return signbit | inf << 52;
  }
  if (dp < 0 - 350) {
    return signbit;
  }
  let bexp: i32 = 0;
  while (dp > 0) {
    let hb: i32[] = pf64_div2(digits);
    if (hb.len() > 0 && hb[0] == 0) {
      digits = pf64_sub(hb, 1, hb.len());
      dp = dp - 1;
    } else {
      digits = hb;
    }
    bexp = bexp + 1;
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
      digits = pf64_sub(digits, 0, digits.len() - 1);
    }
  }
  while (dp < 0 || digits.len() > 0 && digits[0] < 5) {
    let db: i32[] = pf64_mul2(digits);
    if (db[0] != 0) {
      digits = db;
      dp = dp + 1;
    } else {
      digits = pf64_sub(db, 1, db.len());
    }
    bexp = bexp - 1;
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
      digits = pf64_sub(digits, 0, digits.len() - 1);
    }
    if (digits.len() == 0) {
      return signbit;
    }
  }
  let e: i32 = bexp + 1022;
  if (e >= 2047) {
    let inf2: i64 = 2047;
    return signbit | inf2 << 52;
  }
  let nbits: i32 = 53;
  if (e <= 0) {
    nbits = 52 + e;
  }
  if (nbits < 0) {
    return signbit;
  }
  let mant: i64 = 0;
  let k2: i32 = 0;
  while (k2 < nbits) {
    let mb: i32[] = pf64_mul2(digits);
    mant = mant * 2 + mb[0] as i64;
    digits = pf64_sub(mb, 1, mb.len());
    k2 = k2 + 1;
  }
  let rb: i32[] = pf64_mul2(digits);
  let roundbit: i32 = rb[0];
  let rest: i32[] = pf64_sub(rb, 1, rb.len());
  let st: boolean = sticky || !pf64_all_zero(rest);
  if (roundbit == 1 && (st || (mant & 1) == 1)) {
    mant = mant + 1;
  }
  if (e <= 0) {
    return signbit | mant;
  }
  let full: i64 = 1;
  full = full << 53;
  if (mant == full) {
    mant = mant / 2;
    e = e + 1;
    if (e >= 2047) {
      let inf3: i64 = 2047;
      return signbit | inf3 << 52;
    }
  }
  let hidden: i64 = 1;
  hidden = hidden << 52;
  return signbit | e as i64 << 52 | mant - hidden;
}

pub function f64_lit_out_of_range(s: string): boolean {
  if (!f64_lit_reaches_1e309(s)) {
    return false;
  }
  let expmask: i64 = 2047;
  return (parse_f64_bits(s) >> 52 & expmask) == expmask;
}

function f64_lit_reaches_1e309(s: string): boolean {
  let i: i32 = 0;
  if (i < s.len() && (s[i] == b'-' || s[i] == b'+')) {
    i = i + 1;
  }
  while (i < s.len() && s[i] == b'0') {
    i = i + 1;
  }
  let intdigits: i32 = 0;
  while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
    intdigits = intdigits + 1;
    i = i + 1;
  }
  if (i < s.len() && s[i] == b'.') {
    i = i + 1;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      i = i + 1;
    }
  }
  let exp: i32 = 0;
  if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
    i = i + 1;
    let eneg: boolean = false;
    if (i < s.len() && s[i] == b'-') {
      eneg = true;
      i = i + 1;
    } else if (i < s.len() && s[i] == b'+') {
      i = i + 1;
    }
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      if (exp < 100000) {
        exp = exp * 10 + (s[i] as i32 - 48);
      }
      i = i + 1;
    }
    if (eneg) {
      exp = 0 - exp;
    }
  }
  return intdigits + exp >= 309;
}

function f64_range_prefix(): string {
  return "float literal out of range: ";
}

pub function f64_range_kind(text: string): string {
  return f64_range_prefix() + text;
}

pub function is_f64_range_kind(kind: string): boolean {
  return str_has_prefix(kind, f64_range_prefix());
}

pub function f64_range_message(kind: string): string {
  let pre: string = f64_range_prefix();
  return "invalid float literal \"" + slice_unchecked(kind, pre.len(), kind.len()) + "\": value out of range";
}

function pf64_div2(b: i32[]): i32[] {
  let out: i32[] = [];
  let r: i32 = 0;
  let i: i32 = 0;
  while (i < b.len()) {
    let cur: i32 = r * 10 + b[i];
    out = out.append(cur / 2);
    r = cur % 2;
    i = i + 1;
  }
  if (r != 0) {
    out = out.append(5);
  }
  return out;
}

function pf64_mul2(b: i32[]): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(0);
    i = i + 1;
  }
  let carry: i32 = 0;
  let j: i32 = b.len() - 1;
  while (j >= 0) {
    let cur: i32 = b[j] * 2 + carry;
    out = out.with(j, cur % 10);
    carry = cur / 10;
    j = j - 1;
  }
  let res: i32[] = [carry];
  let k: i32 = 0;
  while (k < out.len()) {
    res = res.append(out[k]);
    k = k + 1;
  }
  return res;
}

function pf64_sub(b: i32[], from: i32, upto: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = from;
  while (i < upto) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

function pf64_all_zero(b: i32[]): boolean {
  let i: i32 = 0;
  while (i < b.len()) {
    if (b[i] != 0) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub const RC_UNDERFLOW_EXIT: i32 = 120;

pub function rc_underflow_guard(who: string, code: i32): i32 {
  let n: i32 = __rc_underflow_count();
  if (n == 0) {
    return code;
  }
  eprint(who + ": internal error: rc over-release detected (" + i32_to_string(n) + " dec(s) on an already-released block)");
  return RC_UNDERFLOW_EXIT;
}

pub function verify_on(): boolean {
  return envflag.on("FERN_IR_VERIFY");
}

pub function certify_mode(): i32 {
  match (env("FERN_RC_CERTIFY")) {
    Some(v) => {
      if (v == "report") {
        return 1;
      }
      if (!envflag.value_on(v)) {
        return 0;
      }
      return 2;
    },
    None => {
      return 2;
    }
  }
}

pub function arr_push_cliff_report(who: string, code: i32): i32 {
  if (envflag.on("FERN_CLIFF_REPORT")) {
    let copied: i64 = __arr_push_shared_bytes();
    eprint(who + ": arr_push_shared_count=" + i32_to_string(__arr_push_shared_count())
      + " arr_push_shared_bytes=" + i64_to_string(copied)
      + " heap_bump_bytes=" + i64_to_string(__heap_bump_bytes()));
  }
  return code;
}

pub function str_join_range(parts: string[], lo: i32, hi: i32): string {
  let n: i32 = hi - lo;
  if (n <= 0) {
    return "";
  }
  if (n == 1) {
    return parts[lo];
  }
  let mid: i32 = lo + n / 2;
  return str_join_range(parts, lo, mid) + str_join_range(parts, mid, hi);
}

pub function str_join_chunks(parts: string[]): string {
  return str_join_range(parts, 0, parts.len());
}

pub struct Diag { code: string, message: string, line: i32, col: i32, length: i32, fix: Option[Fix], related: Related[] }

pub struct Related { line: i32, col: i32, length: i32, message: string }

pub struct Fix { line: i32, col: i32, old: string, new_text: string, title: string }

pub function violation_diag(code: string, msg: string, fn_module: string, line: i32, col: i32): Diag {
  if (fn_module.len() > 0) {
    line = 0;
  }
  return Diag { related: [], length: 0, code: code, message: msg, line: line, col: col, fix: None };
}

pub function is_diagnostic_code(code: string): boolean {
  if (code.len() != 4) {
    return false;
  }
  let head: i32 = code[0] as i32;
  if (head != 69 && head != 80) {
    return false;
  }
  let i: i32 = 1;
  while (i < 4) {
    let b: i32 = code[i] as i32;
    if (b < 48 || b > 57) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

const LINE_SPAN: i32 = 1048576;

pub function line_base(index: i32): i32 {
  return (index + 1) * LINE_SPAN;
}

pub function pos_line(line: i32): i32 {
  return line % LINE_SPAN;
}

pub function pos_file_index(line: i32): i32 {
  return line / LINE_SPAN;
}

pub function pos_file(files: string[], line: i32): string {
  let k: i32 = line / LINE_SPAN - 1;
  if (k < 0 || k >= files.len()) {
    return "";
  }
  return files[k];
}

pub function pos_str(entry: string, files: string[], line: i32, col: i32): string {
  let at: string = i32_to_string(pos_line(line)) + ":" + i32_to_string(col);
  let f: string = pos_file(files, line);
  if (f.len() == 0) {
    f = entry;
  }
  if (f.len() == 0) {
    return at;
  }
  return f + ":" + at;
}

pub struct LineMap { doc: string, lits: i32[], shifts: i32[] }

pub function no_line_map(): LineMap {
  return LineMap { doc: "", lits: [], shifts: [] };
}

pub function doc_diag(maps: LineMap[], d: Diag): Diag {
  let (line, col) = doc_pos(maps, d.line, d.col);
  let out: Diag = Diag { ...d, line: line, col: col, related: doc_related(maps, d.related) };
  if let Some(f) = d.fix {
    let (fl, fc) = doc_pos(maps, f.line, f.col);
    if (fl == 0) {
      return Diag { ...out, fix: None };
    }
    return Diag { ...out, fix: Some(Fix { ...f, line: fl, col: fc }) };
  }
  return out;
}

function doc_related(maps: LineMap[], related: Related[]): Related[] {
  let out: Related[] = [];
  for r in related {
    let (line, col) = doc_pos(maps, r.line, r.col);
    if (line > 0) {
      out = out.append(Related { ...r, line: line, col: col });
    }
  }
  return out;
}

pub function doc_pos(maps: LineMap[], line: i32, col: i32): (i32, i32) {
  let m: i32 = pos_file_index(line);
  if (m < 0 || m >= maps.len() || maps[m].doc.len() == 0) {
    return (line, col);
  }
  let k: i32 = pos_line(line);
  if (k < 1 || k > maps[m].lits.len()) {
    return (0, 0);
  }
  let c: i32 = col - maps[m].shifts[k - 1];
  if (c < 1) {
    c = 1;
  }
  return (line - k + maps[m].lits[k - 1], c);
}

pub function format_diags(diags: Diag[]): string {
  return format_diags_in(diags, []);
}

pub function format_diags_in(diags: Diag[], files: string[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < diags.len()) {
    let d: Diag = diags[i];
    let tag: string = "";
    if (d.code.len() > 0) {
      tag = "error[" + d.code + "]: ";
    }
    if (i > 0) {
      out = out + "\n";
    }
    out = out + tag + d.message + " (" + pos_str("", files, d.line, d.col) + ")";
    for r in d.related {
      out = out + "\n    note: " + r.message + " (" + pos_str("", files, r.line, r.col) + ")";
    }
    i = i + 1;
  }
  return out;
}

pub function diag_after(a: Diag, b: Diag): boolean {
  if (b.line <= 0) {
    return a.line > 0;
  }
  if (a.line <= 0) {
    return false;
  }
  if (a.line != b.line) {
    return a.line > b.line;
  }
  return a.col > b.col;
}

pub function sorted_by[T](xs: T[], after: (T, T) => boolean): T[] {
  let out: T[] = [];
  for x in xs {
    let at: i32 = out.len();
    while (at > 0 && after(out[at - 1], x)) {
      at = at - 1;
    }
    let next: T[] = [];
    let i: i32 = 0;
    while (i <= out.len()) {
      if (i == at) {
        next = next.append(x);
      }
      if (i < out.len()) {
        next = next.append(out[i]);
      }
      i = i + 1;
    }
    out = next;
  }
  return out;
}

pub function append_diags(a: Diag[], b: Diag[]): Diag[] {
  let i: i32 = 0;
  while (i < b.len()) {
    a = a.append(b[i]);
    i = i + 1;
  }
  return a;
}

pub function dunder_at(name: string): i32 {
  let i: i32 = 1;
  while (i + 1 < name.len()) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function show_type_vars(text: string): string {
  let out: string = "";
  let start: i32 = 0;
  let i: i32 = 0;
  while (i + 2 < text.len()) {
    let boundary: boolean = i == 0 || !(ident_start_byte(text[i - 1]) || text[i - 1] >= b'0' && text[i - 1] <= b'9');
    if (boundary && text[i] == b'0' && text[i + 1] == b'_' && ident_start_byte(text[i + 2])) {
      out = out + slice_unchecked(text, start, i);
      start = i + 2;
      i = i + 2;
    } else {
      i = i + 1;
    }
  }
  if (start == 0) {
    return text;
  }
  return out + slice_unchecked(text, start, text.len());
}

pub function ident_from(line: string, col: i32, name: string): i32 {
  let at: i32 = col - 1;
  while (at >= 0 && at + name.len() <= line.len()) {
    let i: i32 = index_of_sub(slice_unchecked(line, at, line.len()) + "", name);
    if (i < 0) {
      return 0;
    }
    at = at + i;
    if (!ident_byte_at(line, at - 1) && !ident_byte_at(line, at + name.len())) {
      return at + 1;
    }
    at = at + 1;
  }
  return 0;
}

function ident_byte_at(s: string, i: i32): boolean {
  return i >= 0 && i < s.len() && (ident_start_byte(s[i]) || s[i] >= b'0' && s[i] <= b'9');
}

function ident_start_byte(c: u8): boolean {
  return c >= b'A' && c <= b'Z' || c >= b'a' && c <= b'z' || c == b'_';
}

pub function is_ident(s: string): boolean {
  if (s.len() == 0 || !ident_start_byte(s[0])) {
    return false;
  }
  let i: i32 = 1;
  while (i < s.len()) {
    if (!ident_start_byte(s[i]) && !(s[i] >= b'0' && s[i] <= b'9')) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function demangle(name: string): string {
  let cut: i32 = dunder_at(name);
  if (cut < 0) {
    return name;
  }
  return slice_unchecked(name, 0, cut) + "." + slice_unchecked(name, cut + 2, name.len());
}

pub function demangle_all(text: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < text.len()) {
    if (!ident_start_byte(text[i])) {
      out = out + slice_unchecked(text, i, i + 1);
      i = i + 1;
      continue;
    }
    let j: i32 = i;
    while (j < text.len() && (ident_start_byte(text[j]) || text[j] >= b'0' && text[j] <= b'9')) {
      j = j + 1;
    }
    let word: string = slice_unchecked(text, i, j) + "";
    if (word[0] == b'_') {
      out = out + word;
    } else {
      out = out + demangle(word);
    }
    i = j;
  }
  return out;
}

pub function derive_hint(tn: string, derive: string, trait_name: string): string {
  let cut: i32 = dunder_at(tn);
  let routes: string = "`@derive(" + derive + ")`";
  if (cut < 0) {
    if (trait_name.len() > 0) {
      routes = routes + " (or `impl " + trait_name + " for " + tn + "`)";
    }
    return "add " + routes + ", which requires `import \"core/cmp\";`";
  }
  let orphan: string = "";
  if (trait_name.len() > 0) {
    routes = routes + " (or `impl " + trait_name + " for " + slice_unchecked(tn, cut + 2, tn.len()) + "`)";
    orphan = " (an impl written here instead would be an orphan impl)";
  }
  return "add " + routes + " in module `" + slice_unchecked(tn, 0, cut) + "`, which declares it and needs `import \"core/cmp\";` there" + orphan;
}

pub function last_slash(p: string): i32 {
  let i: i32 = 0;
  let last: i32 = 0 - 1;
  while (i < p.len()) {
    if (p[i] == b'/') {
      last = i;
    }
    i = i + 1;
  }
  return last;
}

pub function dir_of(p: string): string {
  let ls: i32 = last_slash(p);
  if (ls < 0) {
    return "";
  }
  return slice_unchecked(p, 0, ls) + "";
}

pub function module_name(import_path: string): string {
  let path: string = without_fern_ext(import_path);
  let ls: i32 = last_slash(path);
  if (ls >= 0) {
    return slice_unchecked(path, ls + 1, path.len()) + "";
  }
  return path;
}

pub function without_fern_ext(path: string): string {
  if (str_has_suffix(path, ".fern.md")) {
    return slice_unchecked(path, 0, path.len() - 8) + "";
  }
  if (str_has_suffix(path, ".fern")) {
    return slice_unchecked(path, 0, path.len() - 5) + "";
  }
  return path;
}

pub function dep_name(import_path: string): string {
  let i: i32 = 0;
  while (i < import_path.len()) {
    if (import_path[i] == b'/') {
      return slice_unchecked(import_path, 0, i) + "";
    }
    i = i + 1;
  }
  return import_path;
}

pub function dep_subpath(import_path: string): string {
  let n: string = dep_name(import_path);
  if (n.len() >= import_path.len()) {
    return "";
  }
  return slice_unchecked(import_path, n.len() + 1, import_path.len()) + "";
}

pub function import_qualifier(path: string): string {
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < path.len()) {
    if (path[i] == b'/') {
      start = i + 1;
    }
    i = i + 1;
  }
  let end: i32 = path.len();
  if (str_has_suffix(path, ".fern")) {
    end = end - 5;
  }
  let out: string = "";
  let from: i32 = start;
  i = start;
  while (i < end) {
    if (path[i] == b'-') {
      out = out + slice_unchecked(path, from, i) + "_";
      from = i + 1;
    }
    i = i + 1;
  }
  return out + slice_unchecked(path, from, end);
}

pub function mangle_prefix(name: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < name.len()) {
    let c: i32 = name[i] as i32;
    let ok: boolean = c >= 97 && c <= 122 || c >= 65 && c <= 90 || c == 95;
    if (ok) {
      out = out + slice_unchecked(name, i, i + 1);
    } else {
      if (c >= 48 && c <= 57) {
        if (i == 0) {
          out = out + "_";
        }
        out = out + slice_unchecked(name, i, i + 1);
      } else {
        out = out + "_";
      }
    }
    i = i + 1;
  }
  if (out.len() == 0) {
    return "_";
  }
  return out;
}

pub function is_local(import_path: string): boolean {
  if (import_path.len() == 0) {
    return false;
  }
  return import_path[0] == b'.';
}

pub function clean_path(p: string): string {
  let out: string = "";
  let skip: i32 = 0;
  let end: i32 = p.len();
  let i: i32 = p.len() - 1;
  while (i >= 0 - 1) {
    if (i < 0 || p[i] == b'/') {
      let seg: string = slice_unchecked(p, i + 1, end) + "";
      if (seg == "..") {
        skip = skip + 1;
      } else if (seg.len() > 0 && seg != ".") {
        if (skip > 0) {
          skip = skip - 1;
        } else if (out.len() == 0) {
          out = seg;
        } else {
          out = seg + "/" + out;
        }
      }
      end = i;
    }
    i = i - 1;
  }
  if (p.len() > 0 && p[0] == b'/') {
    return "/" + out;
  }
  while (skip > 0) {
    if (out.len() == 0) {
      out = "..";
    } else {
      out = "../" + out;
    }
    skip = skip - 1;
  }
  if (out.len() == 0) {
    return ".";
  }
  return out;
}

pub function module_path_join(dir: string, name: string): string {
  if (dir.len() == 0) {
    return name + ".fern";
  }
  return dir + "/" + name + ".fern";
}

pub function should_load(import_path: string, root: string, deps: string[]): boolean {
  if (import_path.len() == 0) {
    return false;
  }
  if (is_local(import_path)) {
    return true;
  }
  if (has_str(deps, dep_name(import_path))) {
    return true;
  }
  if (root.len() == 0) {
    return !is_stdlib_path(import_path);
  }
  return true;
}

pub function is_stdlib_path(import_path: string): boolean {
  return str_has_prefix(import_path, "std/") || str_has_prefix(import_path, "core/");
}

pub function is_dir(path: string): boolean {
  match (read_dir(path)) {
    Ok(names) => {
      return true;
    },
    Err(e) => {
      return false;
    }
  }
  return false;
}

pub function resolve_path(import_path: string, entry_dir: string, root: string): string {
  if (is_stdlib_path(import_path) && root.len() > 0) {
    return clean_path(root + "/" + without_fern_ext(import_path) + ".fern");
  }
  let rel: string = without_fern_ext(import_path);
  if (rel.len() >= 2 && slice_unchecked(rel, 0, 2) == "./") {
    rel = slice_unchecked(rel, 2, rel.len()) + "";
  }
  return clean_path(module_path_join(entry_dir, rel));
}

pub function trim(s: string): string {
  let a: i32 = 0;
  let b: i32 = s.len();
  while (a < b && (s[a] == b' ' || s[a] == b'\t' || s[a] == b'\r')) {
    a = a + 1;
  }
  while (b > a && (s[b - 1] == b' ' || s[b - 1] == b'\t' || s[b - 1] == b'\r')) {
    b = b - 1;
  }
  return slice_unchecked(s, a, b) + "";
}

pub function levenshtein(a: string, b: string): i32 {
  if (a == b) {
    return 0;
  }
  if (a.len() == 0) {
    return b.len();
  }
  if (b.len() == 0) {
    return a.len();
  }
  let prev: i32[] = [];
  let j: i32 = 0;
  while (j <= b.len()) {
    prev = prev.append(j);
    j = j + 1;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    let cur: i32[] = [i + 1];
    let k: i32 = 0;
    while (k < b.len()) {
      let cost: i32 = 1;
      if (a[i] == b[k]) {
        cost = 0;
      }
      let best: i32 = prev[k] + cost;
      if (cur[k] + 1 < best) {
        best = cur[k] + 1;
      }
      if (prev[k + 1] + 1 < best) {
        best = prev[k + 1] + 1;
      }
      cur = cur.append(best);
      k = k + 1;
    }
    prev = cur;
    i = i + 1;
  }
  return prev[b.len()];
}

pub function suggest(name: string, candidates: string[]): string {
  if (name.len() == 0 || candidates.len() == 0) {
    return "";
  }
  let budget: i32 = 2;
  if (name.len() <= 3) {
    budget = 1;
  }
  let best: string = "";
  let best_dist: i32 = budget + 1;
  let i: i32 = 0;
  while (i < candidates.len()) {
    if (candidates[i] != name) {
      let d: i32 = levenshtein(name, candidates[i]);
      if (d < best_dist) {
        best = candidates[i];
        best_dist = d;
      }
    }
    i = i + 1;
  }
  if (best_dist > budget) {
    return "";
  }
  return best;
}

pub function append_all[T](into: T[], more: T[]): T[] {
  let i: i32 = 0;
  while (i < more.len()) {
    into = into.append(more[i]);
    i = i + 1;
  }
  return into;
}

pub function to_u8(b: i32[]): u8[] {
  let o: u8[] = [];
  let i: i32 = 0;
  while (i < b.len()) {
    o = o.append(b[i] as u8);
    i = i + 1;
  }
  return o;
}

pub function cache_base(): string {
  if let Some(d) = envflag.value("FERN_CACHE_DIR") {
    return d;
  }
  let darwin: boolean = target_os() == "darwin";
  if (!darwin) {
    if let Some(x) = envflag.value("XDG_CACHE_HOME") {
      return x + "/fern";
    }
  }
  if let Some(h) = envflag.value("HOME") {
    if (darwin) {
      return h + "/Library/Caches/fern";
    }
    return h + "/.cache/fern";
  }
  return "";
}
