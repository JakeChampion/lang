import "std/envflag";
import "std/string";

pub function arity_message(subject: string, want: i32, got: i32, unit: string): string {
  let units = unit;
  if (want != 1) {
    units = unit + "s";
  }
  return subject + " takes " + i32_to_string(want) + " " + units + " but was given " + i32_to_string(got);
}

pub function i32_to_string(n: i32): string {
  return n.to_string();
}

// A fixed-point loop stopped at its round cap while it still changed the
// code. The output is correct but depends on the cap.
pub function report_unsettled(pass: string, rounds: i32, where: string): void {
  let at = "";
  if (where != "") {
    at = " in " + where;
  }
  eprint("fern: internal: " + pass + " stopped after " + i32_to_string(rounds) + " rounds before it settled" + at + " (#14583)");
}

pub function i64_to_string(n: i64): string {
  if (n == 0) {
    return "0";
  }
  if (n < 0 && -n == n) {
    return "-9223372036854775808";
  }
  let neg = n < 0;
  if (neg) {
    n = -n;
  }
  let len = 0;
  let m = n;
  while (m > 0) {
    len += 1;
    m /= 10;
  }
  if (neg) {
    len += 1;
  }
  let buf = __alloc_u8(len);
  let at = len;
  while (n > 0) {
    at -= 1;
    buf = buf.with(at, (48 + (n % 10) as i32) as u8);
    n /= 10;
  }
  if (neg) {
    buf = buf.with(0, 45 as u8);
  }
  unsafe {
    return string_from_bytes_unchecked(buf);
  }
}

pub function digest_start(): i64 {
  return 0 - 3750763034362895579i64;
}

pub function roll_wide(d: i64, v: i64): i64 {
  let h: i64 = (d ^ v) * (0 - 7046029254386353131i64);
  return h ^ h >> 32 & 4294967295i64;
}

pub function roll(d: i64, w: i32): i64 {
  return roll_wide(d, w as i64);
}

pub function roll_text(d: i64, s: string): i64 {
  let out = roll(d, s.len());
  for i in 0..s.len() {
    out = roll(out, s[i] as i32);
  }
  return out;
}

pub function roll_words(d: i64, xs: i32[]): i64 {
  let out = roll(d, xs.len());
  for i in 0..xs.len() {
    out = roll(out, xs[i]);
  }
  return out;
}

pub function roll_flag(d: i64, x: boolean): i64 {
  if (x) {
    return roll(d, 1);
  }
  return roll(d, 0);
}

pub function digest_text(d: i64): string {
  return i32_to_string((d >> 32) as i32) + "_" + i32_to_string(d as i32);
}

pub function hash_key(s: string): string {
  let a = 208357;
  let b = 5381;
  for i in 0..s.len() {
    let c = s[i] as i32;
    a = a * 31 + c + 1 & 1073741823;
    b = b * 131 + c + 7 & 1073741823;
  }
  a = a * 31 + s.len() & 1073741823;
  b = b * 131 + s.len() & 1073741823;
  return i32_to_string(a) + "_" + i32_to_string(b);
}

pub function hash_bucket(s: string, n: i32): i32 {
  if (n <= 1) {
    return 0;
  }
  return (__str_hash(s, 0) & 1073741823) % n;
}

pub function minus_ones(n: i32): i32[] {
  let out = __alloc_i32(n);
  for i in 0..n {
    out = out.with(i, -1);
  }
  return out;
}

pub struct NameIndex { names: string[], head: i32[], next: i32[] }

pub function name_bucket(s: string, mask: i32): i32 {
  return __str_hash(s, 0) & mask;
}

function bucket_count(n: i32): i32 {
  let nb = 2;
  while (nb <= n * 2) {
    nb *= 2;
  }
  return nb;
}

pub function name_index(names: string[]): NameIndex {
  if (names.len() == 0) {
    return NameIndex { names: names, head: [], next: [] };
  }
  let nb = bucket_count(names.len());
  let head = minus_ones(nb);
  let next = minus_ones(names.len());
  let k = names.len() - 1;
  while (k >= 0) {
    let b = name_bucket(names[k], nb - 1);
    next = next.with(k, head[b]);
    head = head.with(b, k);
    k -= 1;
  }
  return NameIndex { names: names, head: head, next: next };
}

pub function (ix: NameIndex) chain(name: string): i32 {
  if (ix.head.len() == 0) {
    return -1;
  }
  return ix.head[name_bucket(name, ix.head.len() - 1)];
}

pub function (ix: NameIndex) find(name: string): i32 {
  let i = ix.chain(name);
  while (i >= 0) {
    if (ix.names[i] == name) {
      return i;
    }
    i = ix.next[i];
  }
  return -1;
}

pub function (ix: NameIndex) has(name: string): boolean {
  return ix.find(name) >= 0;
}

pub function (ix: NameIndex) added(name: string): NameIndex {
  let names = ix.names.append(name);
  if (names.len() > ix.head.len()) {
    return name_index(names);
  }
  let k = names.len() - 1;
  let b = name_bucket(name, ix.head.len() - 1);
  let head = ix.head;
  let next = ix.next.append(-1);
  if (head[b] < 0) {
    head = head.with(b, k);
  } else {
    let t = head[b];
    while (next[t] >= 0) {
      t = next[t];
    }
    next = next.with(t, k);
  }
  return NameIndex { names: names, head: head, next: next };
}

pub function lit_to_i32(s: string): i32 {
  if (s.len() == 0) {
    return 0;
  }
  let neg = false;
  let start = 0;
  if (s[0] == b'-') {
    neg = true;
    start = 1;
  }
  if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'x' || s[start + 1] == b'X')) {
    let acc = 0;
    for i in start + 2..s.len() {
      let b = s[i] as i32;
      let d: i32 = -1;
      if (b >= 48 && b <= 57) {
        d = b - 48;
      } else if (b >= 97 && b <= 102) {
        d = b - 97 + 10;
      } else if (b >= 65 && b <= 70) {
        d = b - 65 + 10;
      }
      if (d < 0) {
        break;
      }
      acc = acc * 16 + d;
    }
    if (neg) {
      return -acc;
    }
    return acc;
  }
  if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'b' || s[start + 1] == b'B')) {
    let bacc = 0;
    for bi in start + 2..s.len() {
      let bb = s[bi] as i32;
      if (bb != 48 && bb != 49) {
        break;
      }
      bacc = bacc * 2 + (bb - 48);
    }
    if (neg) {
      return -bacc;
    }
    return bacc;
  }
  return digits_to_i32(s);
}

pub function lit_to_i64(s: string): i64 {
  if (s.len() == 0) {
    return 0;
  }
  let neg = false;
  let start = 0;
  if (s[0] == b'-') {
    neg = true;
    start = 1;
  }
  if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'x' || s[start + 1] == b'X')) {
    let acc: i64 = 0;
    for i in start + 2..s.len() {
      let b = s[i] as i32;
      let d: i32 = -1;
      if (b >= 48 && b <= 57) {
        d = b - 48;
      } else if (b >= 97 && b <= 102) {
        d = b - 97 + 10;
      } else if (b >= 65 && b <= 70) {
        d = b - 65 + 10;
      }
      if (d < 0) {
        break;
      }
      acc = acc * 16 + d as i64;
    }
    if (neg) {
      return -acc;
    }
    return acc;
  }
  if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'b' || s[start + 1] == b'B')) {
    let bacc: i64 = 0;
    for bi in start + 2..s.len() {
      let bb = s[bi] as i32;
      if (bb != 48 && bb != 49) {
        break;
      }
      bacc = bacc * 2 + (bb - 48) as i64;
    }
    if (neg) {
      return -bacc;
    }
    return bacc;
  }
  return digits_to_i64(s);
}

pub function digits_to_i32(s: string): i32 {
  if (s.len() == 0) {
    return 0;
  }
  let neg = false;
  let start = 0;
  if (s[0] == b'-') {
    neg = true;
    start = 1;
  }
  let acc = 0;
  for i in start..s.len() {
    let b = s[i] as i32;
    if (b < 48 || b > 57) {
      if (neg) {
        return -acc;
      }
      return acc;
    }
    acc = acc * 10 + (b - 48);
  }
  if (neg) {
    return -acc;
  }
  return acc;
}

pub function is_decimal_i32(s: string): boolean {
  return decimal_within(s, "2147483647", "2147483648");
}

pub function is_decimal_i64(s: string): boolean {
  return decimal_within(s, "9223372036854775807", "9223372036854775808");
}

function decimal_within(s: string, pos: string, neg: string): boolean {
  let start = 0;
  if (s.len() > 0 && s[0] == b'-') {
    start = 1;
  }
  let n = s.len() - start;
  if (n == 0) {
    return false;
  }
  let i = start;
  while (i < s.len()) {
    if (s[i] < b'0' || s[i] > b'9') {
      return false;
    }
    i += 1;
  }
  if (s[start] == b'0') {
    return n == 1 && start == 0;
  }
  let limit = pos;
  if (start == 1) {
    limit = neg;
  }
  if (n != limit.len()) {
    return n < limit.len();
  }
  for i in 0..n {
    if (s[start + i] != limit[i]) {
      return s[start + i] < limit[i];
    }
  }
  return true;
}

pub function digits_to_i64(s: string): i64 {
  if (s.len() == 0) {
    return 0;
  }
  let neg = false;
  let start = 0;
  if (s[0] == b'-') {
    neg = true;
    start = 1;
  }
  let acc: i64 = 0;
  for i in start..s.len() {
    let b = s[i] as i32;
    if (b < 48 || b > 57) {
      if (neg) {
        return -acc;
      }
      return acc;
    }
    acc = acc * 10 + (b - 48) as i64;
  }
  if (neg) {
    return -acc;
  }
  return acc;
}

pub function is_all_digits(s: string): boolean {
  if (s.len() == 0) {
    return false;
  }
  for i in 0..s.len() {
    let b = s[i] as i32;
    if (b < 48 || b > 57) {
      return false;
    }
  }
  return true;
}

pub function has_str(xs: string[], s: string): boolean {
  for i in 0..xs.len() {
    if (xs[i] == s) {
      return true;
    }
  }
  return false;
}

pub function base_type_name(t: string): string {
  for i in 0..t.len() {
    if (t[i] == b'[') {
      return slice_unchecked(t, 0, i).to_owned();
    }
  }
  return t;
}

pub function is_tuple_type_name(t: string): boolean {
  return t.len() >= 2 && t.starts_with("(");
}

pub function mangled_module(name: string): string {
  let i = 1;
  while (i + 1 < name.len()) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      return slice_unchecked(name, 0, i).to_owned();
    }
    i += 1;
  }
  return "";
}

pub function mangled_name(name: string): string {
  let i = 1;
  while (i + 1 < name.len()) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      return slice_unchecked(name, i + 2, name.len()).to_owned();
    }
    i += 1;
  }
  return name;
}

pub function str_less(a: string, b: string): boolean {
  let n = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  for i in 0..n {
    if (a[i] != b[i]) {
      return a[i] < b[i];
    }
  }
  return a.len() < b.len();
}

// True when the bytes of `t` are in `s` at byte offset `at`.
pub function str_eq_at(s: string, at: i32, t: string): boolean {
  let n = t.len();
  if (at < 0 || at > s.len() - n) {
    return false;
  }
  return __mismatch(s, at, t, 0, n) == n;
}

// True when the byte range `lo..hi` of `s` is equal to `t`.
pub function str_range_eq(s: string, lo: i32, hi: i32, t: string): boolean {
  return hi - lo == t.len() && str_eq_at(s, lo, t);
}

pub function index_of_str(xs: string[], s: string): i32 {
  for i in 0..xs.len() {
    if (xs[i] == s) {
      return i;
    }
  }
  return -1;
}

pub function index_of_i32(xs: i32[], n: i32): i32 {
  for i in 0..xs.len() {
    if (xs[i] == n) {
      return i;
    }
  }
  return -1;
}

pub function has_i32(xs: i32[], n: i32): boolean {
  return index_of_i32(xs, n) >= 0;
}

pub function count_str(xs: string[], s: string): i32 {
  let n = 0;
  for x in xs {
    if (x == s) {
      n += 1;
    }
  }
  return n;
}

pub function any_true(xs: boolean[]): boolean {
  for x in xs {
    if (x) {
      return true;
    }
  }
  return false;
}

pub function filled_i32(n: i32, v: i32): i32[] {
  let out: i32[] = [];
  while (out.len() < n) {
    out = out.append(v);
  }
  return out;
}

pub function empty_i32_lists(n: i32): i32[][] {
  let out: i32[][] = [];
  while (out.len() < n) {
    out = out.append([]);
  }
  return out;
}

pub function bool_i32(b: boolean): i32 {
  if (b) {
    return 1;
  }
  return 0;
}

pub function quoted(s: string): string {
  return "\"" + s + "\"";
}

// is_symbol_byte is true for a byte an assembler symbol name may hold.
pub function is_symbol_byte(c: u8): boolean {
  return c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c >= b'0' && c <= b'9' || c == b'_' || c == b'.' || c == b'$';
}

pub function push_bytes(b: usize, xs: i32[]): void {
  for x in xs {
    buf_push_byte(b, x);
  }
}

pub function put_u8(out: u8[], v: i32): u8[] {
  return out.append((v & 255) as u8);
}

pub function append_bytes(out: u8[], b: [u8]): u8[] {
  for x in b {
    out = out.append(x);
  }
  return out;
}

// index_of_byte is the first index at or after from that holds c, or -1.
pub function index_of_byte(s: string, c: u8, from: i32): i32 {
  for i in from..s.len() {
    if (s[i] == c) {
      return i;
    }
  }
  return -1;
}

// hex_digit is the lower-case hex character for d in 0..16.
pub function hex_digit(d: i32): u8 {
  if (d < 10) {
    return (48 + d) as u8;
  }
  return (87 + d) as u8;
}

// hex_value is the value of the hex digit c in either case, or -1.
pub function hex_value(c: u8): i32 {
  if (c >= b'0' && c <= b'9') {
    return (c - b'0') as i32;
  }
  let lower = c | 32u8;
  if (lower >= b'a' && lower <= b'f') {
    return (lower - b'a') as i32 + 10;
  }
  return -1;
}

// hex_digits reports whether text has one or more bytes from `from` and each is a hex digit.
pub function hex_digits(text: string, from: i32): boolean {
  if (from >= text.len()) {
    return false;
  }
  for i in from..text.len() {
    if (hex_value(text[i]) < 0) {
      return false;
    }
  }
  return true;
}

// path_base is the part of path after its last slash.
pub function path_base(path: string): string {
  let start = 0;
  for i in 0..path.len() {
    if (path[i] == b'/') {
      start = i + 1;
    }
  }
  return slice_unchecked(path, start, path.len()).to_owned();
}

pub function same_i32s(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for i in 0..a.len() {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

// drop_last_i32 is a without its last element.
pub function drop_last_i32(a: i32[]): i32[] {
  let out: i32[] = [];
  for i in 0..a.len() - 1 {
    out = out.append(a[i]);
  }
  return out;
}

pub function contains(haystack: string, needle: string): boolean {
  return index_of_sub(haystack, needle) >= 0;
}

pub function index_of_sub(haystack: string, needle: string): i32 {
  let n = needle.len();
  if (n == 0) {
    return 0;
  }
  let last = haystack.len() - n;
  let first = needle[0] as i32;
  let i = __memchr(haystack, first, 0);
  while (i >= 0 && i <= last) {
    if (__mismatch(haystack, i, needle, 0, n) == n) {
      return i;
    }
    i = __memchr(haystack, first, i + 1);
  }
  return -1;
}

pub function index_of_sub_from(haystack: string, needle: string, from: i32): i32 {
  let start = from;
  if (start < 0) {
    start = 0;
  }
  if (start > haystack.len()) {
    start = haystack.len();
  }
  let n = needle.len();
  if (n == 0) {
    return start;
  }
  let last = haystack.len() - n;
  let first = needle[0] as i32;
  let i = __memchr(haystack, first, start);
  while (i >= 0 && i <= last) {
    if (__mismatch(haystack, i, needle, 0, n) == n) {
      return i;
    }
    i = __memchr(haystack, first, i + 1);
  }
  return -1;
}

pub function parse_f64_bits(s: string): i64 {
  let i = 0;
  let neg = false;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  } else if (s.len() > 0 && s[0] == b'+') {
    i = 1;
  }
  let signbit: i64 = 0;
  if (neg) {
    let one: i64 = 1;
    signbit = one << 63;
  }
  let buf = __alloc_i32(PF64_CAP);
  let lo = PF64_HEAD;
  let hi = PF64_HEAD;
  let dp = 0;
  let sticky = false;
  let started = false;
  while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
    let d = s[i] as i32 - 48;
    if (started || d != 0) {
      started = true;
      if (hi - lo < PF64_DIGITS) {
        buf = buf.with(hi, d);
        hi += 1;
      } else {
        if (d != 0) {
          sticky = true;
        }
      }
      dp += 1;
    }
    i += 1;
  }
  if (i < s.len() && s[i] == b'.') {
    i += 1;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      let fd = s[i] as i32 - 48;
      if (started || fd != 0) {
        started = true;
        if (hi - lo < PF64_DIGITS) {
          buf = buf.with(hi, fd);
          hi += 1;
        } else {
          if (fd != 0) {
            sticky = true;
          }
        }
      } else {
        dp -= 1;
      }
      i += 1;
    }
  }
  if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
    i += 1;
    let eneg = false;
    if (i < s.len() && s[i] == b'-') {
      eneg = true;
      i += 1;
    } else if (i < s.len() && s[i] == b'+') {
      i += 1;
    }
    let exp = 0;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      if (exp < 100000) {
        exp = exp * 10 + (s[i] as i32 - 48);
      }
      i += 1;
    }
    if (eneg) {
      dp -= exp;
    } else {
      dp += exp;
    }
  }
  hi = pf64_trim(buf, lo, hi);
  if (hi == lo) {
    return signbit;
  }
  if (dp > 310) {
    let inf: i64 = 2047;
    return signbit | inf << 52;
  }
  if (dp < -350) {
    return signbit;
  }
  let bexp = 0;
  while (dp > 0) {
    let lead_zero = buf[lo] < 2;
    let odd = buf[hi - 1] % 2 == 1;
    buf = pf64_halve(buf, lo, hi);
    if (odd) {
      hi += 1;
    }
    if (lead_zero) {
      lo += 1;
      dp -= 1;
    }
    bexp += 1;
    hi = pf64_trim(buf, lo, hi);
  }
  while (dp < 0 || hi > lo && buf[lo] < 5) {
    let carry = buf[lo] >= 5;
    buf = pf64_double(buf, lo, hi);
    if (carry) {
      lo -= 1;
      dp += 1;
    }
    bexp -= 1;
    hi = pf64_trim(buf, lo, hi);
    if (hi == lo) {
      return signbit;
    }
  }
  let e = bexp + 1022;
  if (e >= 2047) {
    let inf2: i64 = 2047;
    return signbit | inf2 << 52;
  }
  let nbits = 53;
  if (e <= 0) {
    nbits = 52 + e;
  }
  if (nbits < 0) {
    return signbit;
  }
  let mant: i64 = 0;
  for k2 in 0..nbits {
    mant = mant * 2 + pf64_top_bit(buf, lo);
    buf = pf64_double(buf, lo, hi);
  }
  let roundbit = pf64_top_bit(buf, lo);
  buf = pf64_double(buf, lo, hi);
  let st = sticky || pf64_trim(buf, lo, hi) > lo;
  if (roundbit == 1 && (st || (mant & 1) == 1)) {
    mant += 1;
  }
  if (e <= 0) {
    return signbit | mant;
  }
  let full: i64 = 1;
  full = full << 53;
  if (mant == full) {
    mant /= 2;
    e += 1;
    if (e >= 2047) {
      let inf3: i64 = 2047;
      return signbit | inf3 << 52;
    }
  }
  let hidden: i64 = 1;
  hidden = hidden << 52;
  return signbit | e as i64 << 52 | mant - hidden;
}

pub function f64_lit_out_of_range(s: string): boolean {
  if (!f64_lit_reaches_1e309(s)) {
    return false;
  }
  let expmask: i64 = 2047;
  return (parse_f64_bits(s) >> 52 & expmask) == expmask;
}

function f64_lit_reaches_1e309(s: string): boolean {
  let i = 0;
  if (i < s.len() && (s[i] == b'-' || s[i] == b'+')) {
    i += 1;
  }
  while (i < s.len() && s[i] == b'0') {
    i += 1;
  }
  let intdigits = 0;
  while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
    intdigits += 1;
    i += 1;
  }
  if (i < s.len() && s[i] == b'.') {
    i += 1;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      i += 1;
    }
  }
  let exp = 0;
  if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
    i += 1;
    let eneg = false;
    if (i < s.len() && s[i] == b'-') {
      eneg = true;
      i += 1;
    } else if (i < s.len() && s[i] == b'+') {
      i += 1;
    }
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      if (exp < 100000) {
        exp = exp * 10 + (s[i] as i32 - 48);
      }
      i += 1;
    }
    if (eneg) {
      exp = -exp;
    }
  }
  return intdigits + exp >= 309;
}

function f64_range_prefix(): string {
  return "float literal out of range: ";
}

pub function f64_range_kind(text: string): string {
  return f64_range_prefix() + text;
}

pub function is_f64_range_kind(kind: string): boolean {
  return kind.starts_with(f64_range_prefix());
}

pub function f64_range_message(kind: string): string {
  let pre = f64_range_prefix();
  return "invalid float literal \"" + slice_unchecked(kind, pre.len(), kind.len()) + "\": value out of range";
}

// parse_f64_bits keeps the decimal digits in buf[lo..hi]. Doubling can add a
// digit before lo, and halving can add one at hi.
const PF64_DIGITS: i32 = 800;

const PF64_HEAD: i32 = 512;

const PF64_CAP: i32 = 2560;

function pf64_halve(own buf: i32[], lo: i32, hi: i32): i32[] {
  let r = 0;
  for i in lo..hi {
    let cur = r * 10 + buf[i];
    buf = buf.with(i, cur / 2);
    r = cur % 2;
  }
  if (r != 0) {
    buf = buf.with(hi, 5);
  }
  return buf;
}

function pf64_double(own buf: i32[], lo: i32, hi: i32): i32[] {
  let carry = 0;
  let j = hi - 1;
  while (j >= lo) {
    let cur = buf[j] * 2 + carry;
    buf = buf.with(j, cur % 10);
    carry = cur / 10;
    j -= 1;
  }
  return buf.with(lo - 1, carry);
}

function pf64_top_bit(buf: i32[], lo: i32): i64 {
  if (buf[lo] >= 5) {
    return 1;
  }
  return 0;
}

function pf64_trim(buf: i32[], lo: i32, hi: i32): i32 {
  let h = hi;
  while (h > lo && buf[h - 1] == 0) {
    h -= 1;
  }
  return h;
}

pub const RC_UNDERFLOW_EXIT: i32 = 120;

pub function rc_underflow_guard(who: string, code: i32): i32 {
  let n = __rc_underflow_count();
  if (n == 0) {
    return code;
  }
  eprint(who + ": internal error: rc over-release detected (" + i32_to_string(n) + " dec(s) on an already-released block)");
  return RC_UNDERFLOW_EXIT;
}

pub function verify_on(): boolean {
  match (env("FERN_IR_VERIFY")) {
    Some(v) => {
      return envflag.value_on(v);
    },
    None => {
      return true;
    }
  }
}

pub function certify_mode(): i32 {
  match (env("FERN_RC_CERTIFY")) {
    Some(v) => {
      if (v == "report") {
        return 1;
      }
      if (!envflag.value_on(v)) {
        return 0;
      }
      return 2;
    },
    None => {
      return 2;
    }
  }
}

pub function arr_push_cliff_report(who: string, code: i32): i32 {
  if (envflag.on("FERN_CLIFF_REPORT")) {
    let copied = __arr_push_shared_bytes();
    eprint(who + ": arr_push_shared_count=" + i32_to_string(__arr_push_shared_count())
      + " arr_push_shared_bytes=" + i64_to_string(copied)
      + " heap_bump_bytes=" + i64_to_string(__heap_bump_bytes()));
  }
  return code;
}

pub function str_join_range(parts: string[], lo: i32, hi: i32): string {
  let n = hi - lo;
  if (n <= 0) {
    return "";
  }
  if (n == 1) {
    return parts[lo];
  }
  let mid = lo + n / 2;
  return str_join_range(parts, lo, mid) + str_join_range(parts, mid, hi);
}

pub function str_join_chunks(parts: string[]): string {
  return str_join_range(parts, 0, parts.len());
}

pub struct Diag { code: string, message: string, line: i32, col: i32, length: i32, fix: Option[Fix], related: Related[] }

pub struct Related { line: i32, col: i32, length: i32, message: string }

pub struct Fix { line: i32, col: i32, old: string, new_text: string, title: string }

pub function violation_diag(code: string, msg: string, fn_module: string, line: i32, col: i32): Diag {
  if (fn_module.len() > 0) {
    line = 0;
  }
  return Diag { related: [], length: 0, code: code, message: msg, line: line, col: col, fix: None };
}

pub function is_diagnostic_code(code: string): boolean {
  if (code.len() != 4) {
    return false;
  }
  let head = code[0] as i32;
  if (head != 69 && head != 80 && head != 87) {
    return false;
  }
  for i in 1..4 {
    let b = code[i] as i32;
    if (b < 48 || b > 57) {
      return false;
    }
  }
  return true;
}

const LINE_SPAN: i32 = 1048576;

pub function line_base(index: i32): i32 {
  return (index + 1) * LINE_SPAN;
}

pub function pos_line(line: i32): i32 {
  return line % LINE_SPAN;
}

pub function pos_file_index(line: i32): i32 {
  return line / LINE_SPAN;
}

pub function pos_file(files: string[], line: i32): string {
  let k = line / LINE_SPAN - 1;
  if (k < 0 || k >= files.len()) {
    return "";
  }
  return files[k];
}

pub function pos_str(entry: string, files: string[], line: i32, col: i32): string {
  let at = i32_to_string(pos_line(line)) + ":" + i32_to_string(col);
  let f = pos_file(files, line);
  if (f.len() == 0) {
    f = entry;
  }
  if (f.len() == 0) {
    return at;
  }
  return f + ":" + at;
}

pub struct LineMap { doc: string, lits: i32[], shifts: i32[] }

pub function no_line_map(): LineMap {
  return LineMap { doc: "", lits: [], shifts: [] };
}

pub function doc_diag(maps: LineMap[], d: Diag): Diag {
  let (line, col) = doc_pos(maps, d.line, d.col);
  let out = Diag { ...d, line: line, col: col, related: doc_related(maps, d.related) };
  if let Some(f) = d.fix {
    let (fl, fc) = doc_pos(maps, f.line, f.col);
    if (fl == 0) {
      return Diag { ...out, fix: None };
    }
    return Diag { ...out, fix: Some(Fix { ...f, line: fl, col: fc }) };
  }
  return out;
}

function doc_related(maps: LineMap[], related: Related[]): Related[] {
  let out: Related[] = [];
  for r in related {
    let (line, col) = doc_pos(maps, r.line, r.col);
    if (line > 0) {
      out = out.append(Related { ...r, line: line, col: col });
    }
  }
  return out;
}

pub function doc_pos(maps: LineMap[], line: i32, col: i32): (i32, i32) {
  let m = pos_file_index(line);
  if (m < 0 || m >= maps.len() || maps[m].doc.len() == 0) {
    return (line, col);
  }
  let k = pos_line(line);
  if (k < 1 || k > maps[m].lits.len()) {
    return (0, 0);
  }
  let c = col - maps[m].shifts[k - 1];
  if (c < 1) {
    c = 1;
  }
  return (line - k + maps[m].lits[k - 1], c);
}

pub function format_diags(diags: Diag[]): string {
  let out = "";
  for i in 0..diags.len() {
    let d = diags[i];
    let tag = "";
    if (d.code.len() > 0) {
      tag = "error[" + d.code + "]: ";
    }
    if (i > 0) {
      out += "\n";
    }
    out = out + tag + d.message + " (" + pos_str("", [], d.line, d.col) + ")";
    for r in d.related {
      out = out + "\n    note: " + r.message + " (" + pos_str("", [], r.line, r.col) + ")";
    }
  }
  return out;
}

pub function diag_after(a: Diag, b: Diag): boolean {
  if (b.line <= 0) {
    return a.line > 0;
  }
  if (a.line <= 0) {
    return false;
  }
  if (a.line != b.line) {
    return a.line > b.line;
  }
  return a.col > b.col;
}

// A stable bottom-up merge sort: `after(a, b)` says that a sorts after b.
pub function sorted_by[T](xs: T[], after: (T, T) => boolean): T[] {
  let src = xs;
  let width = 1;
  while (width < src.len()) {
    let dst: T[] = [];
    let lo = 0;
    while (lo < src.len()) {
      let mid = if (lo + width < src.len()) { lo + width } else { src.len() };
      let hi = if (lo + 2 * width < src.len()) { lo + 2 * width } else { src.len() };
      let i = lo;
      let j = mid;
      while (i < mid || j < hi) {
        if (j >= hi || i < mid && !after(src[i], src[j])) {
          dst = dst.append(src[i]);
          i += 1;
        } else {
          dst = dst.append(src[j]);
          j += 1;
        }
      }
      lo = hi;
    }
    src = dst;
    width *= 2;
  }
  return src;
}

pub function append_diags(a: Diag[], b: Diag[]): Diag[] {
  for i in 0..b.len() {
    a = a.append(b[i]);
  }
  return a;
}

pub function dunder_at(name: string): i32 {
  let i = 1;
  while (i + 1 < name.len()) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      return i;
    }
    i += 1;
  }
  return -1;
}

pub function show_type_vars(text: string): string {
  let out = "";
  let start = 0;
  let i = 0;
  while (i + 2 < text.len()) {
    let boundary = i == 0 || !(ident_start_byte(text[i - 1]) || text[i - 1] >= b'0' && text[i - 1] <= b'9');
    if (boundary && text[i] == b'0' && text[i + 1] == b'_' && ident_start_byte(text[i + 2])) {
      out += slice_unchecked(text, start, i);
      start = i + 2;
      i += 2;
    } else {
      i += 1;
    }
  }
  if (start == 0) {
    return text;
  }
  return out + slice_unchecked(text, start, text.len());
}

pub function ident_from(line: string, col: i32, name: string): i32 {
  let at = col - 1;
  while (at >= 0 && at + name.len() <= line.len()) {
    let i = index_of_sub(slice_unchecked(line, at, line.len()).to_owned(), name);
    if (i < 0) {
      return 0;
    }
    at += i;
    if (!ident_byte_at(line, at - 1) && !ident_byte_at(line, at + name.len())) {
      return at + 1;
    }
    at += 1;
  }
  return 0;
}

function ident_byte_at(s: string, i: i32): boolean {
  return i >= 0 && i < s.len() && (ident_start_byte(s[i]) || s[i] >= b'0' && s[i] <= b'9');
}

function ident_start_byte(c: u8): boolean {
  return c >= b'A' && c <= b'Z' || c >= b'a' && c <= b'z' || c == b'_';
}

pub function is_ident(s: string): boolean {
  if (s.len() == 0 || !ident_start_byte(s[0])) {
    return false;
  }
  for i in 1..s.len() {
    if (!ident_start_byte(s[i]) && !(s[i] >= b'0' && s[i] <= b'9')) {
      return false;
    }
  }
  return true;
}

// The prefix of an entry-module function that shadows a builtin.
pub const ENTRY_SHADOW_PREFIX: string = "__entry__";

// The first line of each arm64 assembly file: the baseline of the arm64 targets.
pub const ARM64_ARCH: string = ".arch armv8.2-a+crypto";

pub function demangle(name: string): string {
  if (name.starts_with(ENTRY_SHADOW_PREFIX)) {
    return slice_unchecked(name, ENTRY_SHADOW_PREFIX.len(), name.len()).to_owned();
  }
  let cut = dunder_at(name);
  if (cut < 0) {
    return name;
  }
  return slice_unchecked(name, 0, cut) + "." + slice_unchecked(name, cut + 2, name.len());
}

// demangle_named demangles each whole word of `text` that `mangled` holds,
// leaving every other word as written.
pub function demangle_named(text: string, mangled: NameIndex): string {
  let out = "";
  let kept = 0;
  let i = 0;
  while (i < text.len()) {
    if (!ident_byte_at(text, i)) {
      i += 1;
      continue;
    }
    let j = i;
    while (ident_byte_at(text, j)) {
      j += 1;
    }
    let word = slice_unchecked(text, i, j).to_owned();
    if (mangled.find(word) >= 0) {
      out = out + slice_unchecked(text, kept, i) + demangle(word);
      kept = j;
    }
    i = j;
  }
  if (kept == 0) {
    return text;
  }
  return out + slice_unchecked(text, kept, text.len());
}

pub function derive_hint(tn: string, derive: string, trait_name: string): string {
  let cut = dunder_at(tn);
  let routes = "`@derive(" + derive + ")`";
  if (cut < 0) {
    if (trait_name.len() > 0) {
      routes = routes + " (or `impl " + trait_name + " for " + tn + "`)";
    }
    return "add " + routes + ", which requires `import \"core/cmp\";`";
  }
  let orphan = "";
  if (trait_name.len() > 0) {
    routes = routes + " (or `impl " + trait_name + " for " + slice_unchecked(tn, cut + 2, tn.len()) + "`)";
    orphan = " (an impl written here instead would be an orphan impl)";
  }
  return "add " + routes + " in module `" + slice_unchecked(tn, 0, cut) + "`, which declares it and needs `import \"core/cmp\";` there" + orphan;
}

pub function last_slash(p: string): i32 {
  let i = 0;
  let last: i32 = -1;
  while (i < p.len()) {
    if (p[i] == b'/') {
      last = i;
    }
    i += 1;
  }
  return last;
}

pub function dir_of(p: string): string {
  let ls = last_slash(p);
  if (ls < 0) {
    return "";
  }
  return slice_unchecked(p, 0, ls).to_owned();
}

pub function module_name(import_path: string): string {
  let path = without_fern_ext(import_path);
  let ls = last_slash(path);
  if (ls >= 0) {
    return slice_unchecked(path, ls + 1, path.len()).to_owned();
  }
  return path;
}

pub function without_fern_ext(path: string): string {
  if (path.ends_with(".fern.md")) {
    return slice_unchecked(path, 0, path.len() - 8).to_owned();
  }
  if (path.ends_with(".fern")) {
    return slice_unchecked(path, 0, path.len() - 5).to_owned();
  }
  return path;
}

pub function dep_name(import_path: string): string {
  for i in 0..import_path.len() {
    if (import_path[i] == b'/') {
      return slice_unchecked(import_path, 0, i).to_owned();
    }
  }
  return import_path;
}

pub function dep_subpath(import_path: string): string {
  let n = dep_name(import_path);
  if (n.len() >= import_path.len()) {
    return "";
  }
  return slice_unchecked(import_path, n.len() + 1, import_path.len()).to_owned();
}

pub function import_qualifier(path: string): string {
  let start = 0;
  let i = 0;
  while (i < path.len()) {
    if (path[i] == b'/') {
      start = i + 1;
    }
    i += 1;
  }
  let end = path.len();
  if (path.ends_with(".fern")) {
    end -= 5;
  }
  let out = "";
  let from = start;
  for i in start..end {
    if (path[i] == b'-') {
      out = out + slice_unchecked(path, from, i) + "_";
      from = i + 1;
    }
  }
  return out + slice_unchecked(path, from, end);
}

pub function mangle_prefix(name: string): string {
  let out = "";
  for i in 0..name.len() {
    let c = name[i] as i32;
    let ok = c >= 97 && c <= 122 || c >= 65 && c <= 90 || c == 95;
    if (ok) {
      out += slice_unchecked(name, i, i + 1);
    } else {
      if (c >= 48 && c <= 57) {
        if (i == 0) {
          out += "_";
        }
        out += slice_unchecked(name, i, i + 1);
      } else {
        out += "_";
      }
    }
  }
  if (out.len() == 0) {
    return "_";
  }
  return out;
}

pub function is_local(import_path: string): boolean {
  if (import_path.len() == 0) {
    return false;
  }
  return import_path[0] == b'.';
}

pub function clean_path(p: string): string {
  let out = "";
  let skip = 0;
  let end = p.len();
  let i = p.len() - 1;
  while (i >= -1) {
    if (i < 0 || p[i] == b'/') {
      let seg = slice_unchecked(p, i + 1, end).to_owned();
      if (seg == "..") {
        skip += 1;
      } else if (seg.len() > 0 && seg != ".") {
        if (skip > 0) {
          skip -= 1;
        } else if (out.len() == 0) {
          out = seg;
        } else {
          out = seg + "/" + out;
        }
      }
      end = i;
    }
    i -= 1;
  }
  if (p.len() > 0 && p[0] == b'/') {
    return "/" + out;
  }
  while (skip > 0) {
    if (out.len() == 0) {
      out = "..";
    } else {
      out = "../" + out;
    }
    skip -= 1;
  }
  if (out.len() == 0) {
    return ".";
  }
  return out;
}

pub function module_path_join(dir: string, name: string): string {
  if (dir.len() == 0) {
    return name + ".fern";
  }
  return dir + "/" + name + ".fern";
}

pub function should_load(import_path: string, root: string, deps: string[]): boolean {
  if (import_path.len() == 0) {
    return false;
  }
  if (is_local(import_path)) {
    return true;
  }
  if (has_str(deps, dep_name(import_path))) {
    return true;
  }
  if (root.len() == 0) {
    return !is_stdlib_path(import_path);
  }
  return true;
}

pub function is_stdlib_path(import_path: string): boolean {
  return import_path.starts_with("std/") || import_path.starts_with("core/");
}

pub function is_dir(path: string): boolean {
  match (read_dir(path)) {
    Ok(names) => {
      return true;
    },
    Err(e) => {
      return false;
    }
  }
}

pub function resolve_path(import_path: string, entry_dir: string, root: string): string {
  if (is_stdlib_path(import_path) && root.len() > 0) {
    return clean_path(root + "/" + without_fern_ext(import_path) + ".fern");
  }
  let rel = without_fern_ext(import_path);
  if (rel.len() >= 2 && rel.starts_with("./")) {
    rel = slice_unchecked(rel, 2, rel.len()).to_owned();
  }
  return clean_path(module_path_join(entry_dir, rel));
}

pub function levenshtein(a: string, b: string): i32 {
  if (a == b) {
    return 0;
  }
  if (a.len() == 0) {
    return b.len();
  }
  if (b.len() == 0) {
    return a.len();
  }
  let prev: i32[] = [];
  for j in 0..=b.len() {
    prev = prev.append(j);
  }
  for i in 0..a.len() {
    let cur: i32[] = [i + 1];
    for k in 0..b.len() {
      let cost = 1;
      if (a[i] == b[k]) {
        cost = 0;
      }
      let best = prev[k] + cost;
      if (cur[k] + 1 < best) {
        best = cur[k] + 1;
      }
      if (prev[k + 1] + 1 < best) {
        best = prev[k + 1] + 1;
      }
      cur = cur.append(best);
    }
    prev = cur;
  }
  return prev[b.len()];
}

pub function suggest(name: string, candidates: string[]): string {
  if (name.len() == 0 || candidates.len() == 0) {
    return "";
  }
  let budget = 2;
  if (name.len() <= 3) {
    budget = 1;
  }
  let best = "";
  let best_dist = budget + 1;
  for i in 0..candidates.len() {
    if (candidates[i] != name) {
      let d = levenshtein(name, candidates[i]);
      if (d < best_dist) {
        best = candidates[i];
        best_dist = d;
      }
    }
  }
  if (best_dist > budget) {
    return "";
  }
  return best;
}

pub function append_all[T](into: T[], more: T[]): T[] {
  for i in 0..more.len() {
    into = into.append(more[i]);
  }
  return into;
}

pub function le32(buf: i32[], v: i32): i32[] {
  buf = buf.append(v & 255);
  buf = buf.append(v >> 8 & 255);
  buf = buf.append(v >> 16 & 255);
  return buf.append(v >> 24 & 255);
}

// is_inner_label is true for an assembler label that stays out of the symbol table.
pub function is_inner_label(s: string): boolean {
  for i in 0..s.len() {
    if (s[i] == b'.' || s[i] == b'#') {
      return true;
    }
  }
  return false;
}

pub function to_u8(b: i32[]): u8[] {
  let o: u8[] = [];
  for i in 0..b.len() {
    o = o.append(b[i] as u8);
  }
  return o;
}

// The cache directory as a clean path: a module id is a clean path, and the
// loader compares the stdlib root with module ids.
pub function cache_base(): string {
  let base = cache_dir();
  if (base.len() == 0) {
    return "";
  }
  return clean_path(base);
}

function cache_dir(): string {
  if let Some(d) = envflag.value("FERN_CACHE_DIR") {
    return d;
  }
  let darwin = target_os() == "darwin";
  if (!darwin) {
    if let Some(x) = envflag.value("XDG_CACHE_HOME") {
      return x + "/fern";
    }
  }
  if let Some(h) = envflag.value("HOME") {
    if (darwin) {
      return h + "/Library/Caches/fern";
    }
    return h + "/.cache/fern";
  }
  return "";
}

pub function split_char(s: string, c: u8): string[] {
  let out: string[] = [];
  let start = 0;
  for i in 0..s.len() {
    if (s[i] == c) {
      out = out.append(slice_unchecked(s, start, i).to_owned());
      start = i + 1;
    }
  }
  out = out.append(slice_unchecked(s, start, s.len()).to_owned());
  return out;
}

// Writes text to a new file at path with mode 0600, and refuses a path that
// exists, a symbolic link included.
pub function write_new_file(path: string, text: string): Result[void, IoError] {
  match (open_exclusive(path)) {
    Ok(writer) => {
      let written = writer.write(text);
      let closed = writer.close();
      match (written) {
        Ok(_) => {
          return closed;
        },
        Err(e) => {
          return Err(e);
        }
      }
    },
    Err(e) => {
      return Err(e);
    }
  }
}
