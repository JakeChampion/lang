  s = s.write("    subq $1, %rax\n    cmpl $192, %r8d\n    jae .Lutf8_ret\n    jmp .Lutf8_back\n");
  s = s.write(".Lutf8_bad:\n    movq $-1, %rax\n.Lutf8_ret:\n    ret\n    .size __fern_utf8_blocks, .-__fern_utf8_blocks\n");
  return s;
