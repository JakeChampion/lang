  s = s.write("    paddq %xmm1, %xmm2\n");
  s = s.write("    movd %xmm2, %eax\n");
  s = s.write(".Lsum_bytes_tail:\n");
  s = s.write("    cmpq %r9, %rdi\n");
  s = s.write("    jae .Lsum_bytes_ret\n");
