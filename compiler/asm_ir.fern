    s = s.write("    movq 8(%rsp), %rdx\n");  // b
    s = s.write("    movq 8(%rdx), %rsi\n");  // lb
    s = s.write("    movq (%rdx), %rdx\n");  // b's data
    s = s.write("    jmp .Lsgf_body\n");
    s = s.write("__fn___fern_str_grow_fresh_range:\n");
    s = hev_shim_site(s, "sgfr");
