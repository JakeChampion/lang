  s = s.write("    pclmulqdq $1, %xmm9, %xmm3\n");
  s = s.write("    pxor %xmm3, %xmm6\n");
  s = s.write("    movdqu 16(%rsi), %xmm4\n");
  s = s.write("    pshufb %xmm5, %xmm4\n");
  s = s.write("    pxor %xmm4, %xmm6\n");
  s = s.write("    movdqa %xmm7, %xmm3\n");
  s = s.write("    pclmulqdq $16, %xmm9, %xmm7\n");
  s = s.write("    pclmulqdq $1, %xmm9, %xmm3\n");
  s = s.write("    pxor %xmm3, %xmm7\n");
  s = s.write("    movdqu 32(%rsi), %xmm4\n");
  s = s.write("    pshufb %xmm5, %xmm4\n");
  s = s.write("    pxor %xmm4, %xmm7\n");
  s = s.write("    movdqa %xmm8, %xmm3\n");
  s = s.write("    pclmulqdq $16, %xmm9, %xmm8\n");
  s = s.write("    pclmulqdq $1, %xmm9, %xmm3\n");
  s = s.write("    pxor %xmm3, %xmm8\n");
  s = s.write("    movdqu 48(%rsi), %xmm4\n");
  s = s.write("    pshufb %xmm5, %xmm4\n");
  s = s.write("    pxor %xmm4, %xmm8\n");
  s = s.write("    addq $64, %rsi\n");
  s = s.write("    subl $64, %edx\n");
  s = s.write("    jmp .Lcrc32_fold4\n");
