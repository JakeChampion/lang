  s = s.write("    cmpl $16, %ecx\n");
  s = s.write("    jae .Lcrc32_tail\n");
  s = s.write("    movzbl -16(%rbp,%rcx), %r8d\n");
  s = s.write("    shll $24, %r8d\n");
