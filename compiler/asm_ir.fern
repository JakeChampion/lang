  // __fern_str_borrow(data@16(%rsp), len@8(%rsp)) -> a counted box over bytes
  // it does not own: rc = 1 and the borrowed-data marker, so its last release
  // (__fern_str_free) frees the 24-byte box alone. The caller's lifetime
  // anchors keep the bytes alive.
  if (s.has_need("str_borrow")) {
    s = s.write("__fn___fern_str_borrow:\n");
    s = s.write("    movq $24, %rdi\n");
    s = s.write("    call __fern_alloc\n");  // %rax = base
    s = s.write("    movl $1, (%rax)\n");  // rc = 1 @ base
    s = s.write("    movl $" + util.i32_to_string(borrowed_marker()) + ", 4(%rax)\n");
    s = s.write("    movq 16(%rsp), %rcx\n");
    s = s.write("    movq %rcx, 8(%rax)\n");  // data @ base+8
    s = s.write("    movq 8(%rsp), %rcx\n");
    s = s.write("    movq %rcx, 16(%rax)\n");  // len  @ base+16
    s = s.write("    addq $8, %rax\n");  // box = base+8
    s = s.write("    ret\n");
  }
  // __fern_str_own(s@8(%rsp)) -> a string its holder owns a unit of. A
  // counted string or view descriptor is retained and answered. A legacy
  // arena view box with an immortal rc is answered as a fresh counted box
  // over the same bytes. A view box outside the arena (a literal) is never
  // freed, so it is answered as is.
  if (s.has_need("str_own")) {
    s = s.write("__fn___fern_str_own:\n");
    s = s.write("    movq 8(%rsp), %rax\n");
    s = s.write("    testb $1, %al\n");
    s = s.write("    jnz .Lso_ret\n");
    s = s.write("    cmpq $0x10000, %rax\n");
    s = s.write("    jb .Lso_ret\n");
    s = s.write("    movl -8(%rax), %ecx\n");  // rc
    s = s.write(san_poison_check("%ecx", s.rc_free_debug));
    s = s.write("    testl %ecx, %ecx\n");
    s = s.write("    js .Lso_view\n");
    s = s.write("    pushq %rax\n");
    s = s.write("    call __fn___fern_rc_inc\n");
    s = ssa_pop_r(s, "%rax");
    s = s.write("    ret\n");
    s = s.write(".Lso_view:\n");
    s = s.write("    leaq -8(%rax), %rdx\n");  // box base
    s = s.write("    cmpq __fern_heap_base(%rip), %rdx\n");
    s = s.write("    jb .Lso_ret\n");
    s = s.write("    cmpq __fern_heap_end(%rip), %rdx\n");
    s = s.write("    jae .Lso_ret\n");
    s = s.write("    pushq %rax\n");
    s = s.write("    movq $24, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    popq %rcx\n");  // the shared box
    s = s.write("    movl $1, (%rax)\n");
    s = s.write("    movl $" + util.i32_to_string(borrowed_marker()) + ", 4(%rax)\n");
    s = s.write("    movq (%rcx), %rdx\n");
    s = s.write("    movq %rdx, 8(%rax)\n");  // data
    s = s.write("    movq 8(%rcx), %rdx\n");
    s = s.write("    movq %rdx, 16(%rax)\n");  // len
    s = s.write("    addq $8, %rax\n");
    s = s.write(".Lso_ret:\n");
    s = s.write("    ret\n");
