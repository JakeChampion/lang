function emit_ir_map_hash_seed(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_map_hash_seed:\n");
  s = s.write("    movl __fern_map_seed(%rip), %eax\n");
  s = s.write("    testl %eax, %eax\n");
  s = s.write("    jne .Lmapseed_ret\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    call __fn___fern_random_i32\n");
  s = s.write("    orl $1, %eax\n");
  s = s.write("    movl %eax, __fern_map_seed(%rip)\n");
  s = s.write("    leave\n");
  s = s.write(".Lmapseed_ret:\n");
  s = s.write("    ret\n");
  return s;
}

function emit_ccall_shim1(s: asmcore.EmitState, variant: string, n: i32): asmcore.EmitState {
  s = s.write("\n__fn_" + variant + ":\n");
  s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n");
  s = s.write("    movq 16(%rbp), %r11\n");
  if (n >= 1) {
    s = s.write("    movq 24(%rbp), %rdi\n");
  }
  if (n >= 2) {
    s = s.write("    movq 32(%rbp), %rsi\n");
  }
  if (n >= 3) {
    s = s.write("    movq 40(%rbp), %rdx\n");
  }
  if (n >= 4) {
    s = s.write("    movq 48(%rbp), %rcx\n");
  }
  s = s.write("    andq $-16, %rsp\n");
  if (s.shared) {
    s = s.write("    movl $0, __fern_busy(%rip)\n");
  }
  s = s.write("    call *%r11\n");
  if (s.shared) {
    s = s.write(busy_take_x86());
  }
  if (util.str_has_suffix(variant, "_f32")) {
    s = s.write("    cvtss2sd %xmm0, %xmm0\n");
  }
  if (util.str_has_suffix(variant, "_f32") || util.str_has_suffix(variant, "_f64")) {
    s = s.write("    movq %xmm0, %rax\n");
  }
  s = s.write("    movq %rbp, %rsp\n    popq %rbp\n    ret\n");
  return s;
}

pub function busy_take_x86(): string {
  return "    movl $1, %r11d\n    xchgl %r11d, __fern_busy(%rip)\n    testl %r11d, %r11d\n    jnz __fern_busy_abort\n";
}

function emit_ccall_shims(s: asmcore.EmitState): asmcore.EmitState {
  let arity: i32 = 0;
  while (arity <= 4) {
    let base: string = "__c_call" + util.i32_to_string(arity);
    if (s.has_need("ccall:" + base)) {
      s = emit_ccall_shim1(s, base, arity);
    }
    if (s.has_need("ccall:" + base + "_f32")) {
      s = emit_ccall_shim1(s, base + "_f32", arity);
    }
    if (s.has_need("ccall:" + base + "_f64")) {
      s = emit_ccall_shim1(s, base + "_f64", arity);
    }
    arity = arity + 1;
  }
  return s;
}

function any_ccall_need(s: asmcore.EmitState): boolean {
  let arity: i32 = 0;
  while (arity <= 4) {
    let base: string = "__c_call" + util.i32_to_string(arity);
    if (s.has_need("ccall:" + base)) {
      return true;
    }
    if (s.has_need("ccall:" + base + "_f32")) {
      return true;
    }
    if (s.has_need("ccall:" + base + "_f64")) {
      return true;
    }
    arity = arity + 1;
  }
  return false;
}

function rc_trace_on(): boolean {
  return envflag.on("FERN_RC_TRACE");
}

function rc_trace_deep_on(): boolean {
  return envflag.on("FERN_RC_TRACE_DEEP");
}

function fused_marker(): i32 {
  return 1934589965;
}

function borrowed_marker(): i32 {
  return 1112494674;
}

function grown_marker(): i32 {
  return 1196576599;
}

function rc_poison(): string {
  return "2129525454";
}

function quarantine_rc(addr: string, on: boolean): string {
  if (on) {
    return "    movl $" + rc_poison() + ", " + addr + "\n";
  }
  return "    movl $0, " + addr + "\n";
}

function san_poison_check(reg: string, on: boolean): string {
  if (on) {
    return "    cmpl $" + rc_poison() + ", " + reg + "\n    je __fern_san_abort_uaf\n";
  }
  return "";
}

function hev_on(s: asmcore.EmitState): boolean {
  return rc_trace_on() || s.leak_check || rtprofile.allocation(s.profile);
}

function str_grow_census(s: asmcore.EmitState): asmcore.EmitState {
  if (rc_trace_on()) {
    s = s.write("    movq %r9, %rax\n");
    s = s.write("    shlq $3, %rax\n");
    s = s.write("    subq %rax, __fern_lc_free_bytes(%rip)\n");
    s = s.write("    subq %rax, __fern_lc_alloc_bytes(%rip)\n");
    s = s.write("    subq $1, __fern_lc_free_count(%rip)\n");
    s = s.write("    subq $1, __fern_lc_alloc_count(%rip)\n");
    return s;
  }
  s = s.write("    movq %r10, %rax\n");
  s = s.write("    subq %r9, %rax\n");
  s = s.write("    shlq $3, %rax\n");
  s = s.write("    addq %rax, __fern_lc_alloc_bytes(%rip)\n");
  return s;
}

function freelist_push(s: asmcore.EmitState, ptr: string, words: string, tmp: string): asmcore.EmitState {
  return freelist_push_classed(capw_class(s, words), ptr, words, tmp);
}

function freelist_push_classed(s: asmcore.EmitState, ptr: string, words: string, tmp: string): asmcore.EmitState {
  s = s.write("    leaq __fern_freelist(%rip), %r8\n");
  s = s.write("    movq (%r8," + words + ",8), " + tmp + "\n");
  s = s.write("    movq " + tmp + ", (" + ptr + ")\n");
  s = s.write("    movq " + ptr + ", (%r8," + words + ",8)\n");
  return s;
}

function capw_class(s: asmcore.EmitState, words: string): asmcore.EmitState {
  let l: asmcore.LabelOut = asmcore.fresh_label(s);
  s = l.state.write("    cmpq $256, " + words + "\n");
  s = s.write("    jbe " + l.name + "\n");
  s = s.write("    pushq " + words + "\n");
  s = s.write("    call __fern_capw\n");
  s = s.write("    popq " + words + "\n");
  return s.write(l.name + ":\n");
}

function large_class(s: asmcore.EmitState): asmcore.EmitState {
  let l: asmcore.LabelOut = asmcore.fresh_label(s);
  s = l.state.write("    cmpq $524288, %rax\n");
  s = s.write("    jae " + l.name + "\n");
  s = s.write("    movl $524288, %eax\n");
  s = s.write(l.name + ":\n");
  s = s.write("    bsrq %rax, %rcx\n");
  s = s.write("    subl $2, %ecx\n");
  s = s.write("    movl $1, %edx\n");
  s = s.write("    shlq %cl, %rdx\n");
  s = s.write("    leaq -1(%rax,%rdx), %rax\n");
  s = s.write("    negq %rdx\n");
  s = s.write("    andq %rdx, %rax\n");
  s = s.write("    bsrq %rax, %rcx\n");
  s = s.write("    subl $2, %ecx\n");
  s = s.write("    movq %rax, %rdx\n");
  s = s.write("    shrq %cl, %rdx\n");
  s = s.write("    shlq $2, %rcx\n");
  s = s.write("    addq %rcx, %rdx\n");
  return s.write("    subq $72, %rdx\n");
}

function buf_block_free(s: asmcore.EmitState, ptr: string, words: string, lbl: string): asmcore.EmitState {
  s = s.write("    cmpq $65536, " + words + "\n");
  s = s.write("    jae ." + lbl + "_large\n");
  s = hev_free(s, ptr, words);
  if (!s.rc_free_debug) {
    s = freelist_push(s, ptr, words, "%rsi");
  }
  s = s.write("    jmp ." + lbl + "_done\n");
  s = s.write("." + lbl + "_large:\n");
  s = s.write("    movq " + ptr + ", %r8\n");
  s = s.write("    leaq 0(," + words + ",8), %rsi\n");
  s = s.write("    call __fern_large_push\n");
  s = s.write("." + lbl + "_done:\n");
  return s;
}

function emit_alloc_bytes(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(empty_array_block(".Lfern_empty_bytes"));
  s = s.write("__fern_alloc_bytes:\n");
  s = s.write("    testl %edi, %edi\n    js __fern_alloc_size_abort.c\n    jz .Lfern_alloc_bytes_empty\n");
  s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n    pushq %r12\n    pushq %r13\n");
  s = s.write("    movq %rdi, %r12\n    leaq 7(%rdi), %rdi\n    shrq $3, %rdi\n    movq %rdi, %r13\n");
  s = s.write("    call __fern_arr_box\n");
  s = s.write("    movq %r12, (%rax)\n    movq %rax, %rdx\n    leaq 8(%rax), %rdi\n    movq %r13, %rcx\n");
  s = s.write("    xorl %eax, %eax\n    rep stosq\n    movq %rdx, %rax\n");
  s = s.write("    popq %r13\n    popq %r12\n    popq %rbp\n    ret\n");
  s = s.write(".Lfern_alloc_bytes_empty:\n    leaq .Lfern_empty_bytes(%rip), %rax\n    ret\n");
  return s;
}

function empty_array_block(label: string): string {
  return "    .section .data\n    .balign 8\n    .quad 0\n    .quad -1\n" + label + ":\n    .quad 0\n    .section .text\n";
}

function apo_grow(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movl -8(%rdi), %ecx\n");
  s = s.write("    testl %ecx, %ecx\n");
  s = s.write("    js .Larr_push_slow\n");
  s = s.write("    cmpl $1, %ecx\n");
  s = s.write("    jne .Larr_push_slow\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %r12\n");
  s = s.write("    pushq %r13\n");
  s = s.write("    pushq %r14\n");
  s = s.write("    pushq %r15\n");
  s = s.write("    movq %rdi, %r12\n");
  s = s.write("    movq %rsi, %r13\n");
  s = s.write("    movq (%r12), %r14\n");
  s = s.write("    movq -16(%r12), %r15\n");
  s = s.write("    leaq (%r15,%r15), %rcx\n");
  s = s.write("    testq %rcx, %rcx\n");
  s = s.write("    jnz .Lapo_cap\n");
  s = s.write("    movq $4, %rcx\n");
  s = s.write(".Lapo_cap:\n");
  s = s.write("    leaq 24(,%rcx,8), %rdi\n");
  s = s.write("    cmpq $2048, %rdi\n");
  s = s.write("    ja .Lapo_alloc\n");
  s = s.write("    leaq __fern_freelist(%rip), %rax\n");
  s = s.write("    addq %rax, %rdi\n");
  s = s.write("    movq (%rdi), %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jz .Lapo_miss\n");
  s = s.write("    movq (%rax), %rdx\n");
  s = s.write("    movq %rdx, (%rdi)\n");
  s = s.write(".Lapo_box:\n");
  s = s.write("    movq %rcx, (%rax)\n");
  s = s.write("    movq $1, 8(%rax)\n");
  s = s.write("    addq $16, %rax\n");
  s = s.write("    leaq 1(%r14), %rcx\n");
  s = s.write("    movq %rcx, (%rax)\n");
  s = s.write(arr_copy_elems(".Lapo"));
  s = s.write("    movq %r13, 8(%rax,%r14,8)\n");
  s = s.write("    leaq 3(%r15), %rcx\n");
  s = s.write("    cmpq $65536, %rcx\n");
  s = s.write("    jae .Lapo_large\n");
  s = s.write(quarantine_rc("-8(%r12)", false));
  s = s.write("    leaq -16(%r12), %rdx\n");
  s = freelist_push(s, "%rdx", "%rcx", "%rdi");
  s = s.write(".Lapo_ret:\n");
  s = s.write("    popq %r15\n");
  s = s.write("    popq %r14\n");
  s = s.write("    popq %r13\n");
  s = s.write("    popq %r12\n");
  s = s.write("    leave\n");
  s = s.write("    ret\n");
  s = s.write(".Lapo_miss:\n");
  s = s.write("    leaq __fern_freelist(%rip), %rax\n");
  s = s.write("    subq %rax, %rdi\n");
  s = s.write(".Lapo_alloc:\n");
  s = s.write("    call __fern_alloc\n");
  s = s.write("    jmp .Lapo_box\n");
  return s;
}

function apo_wrapped(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.rc_free_debug) {
    s = s.write("    cmpq $0, (%rdi)\n");
    s = s.write("    jne .Lapo_grow\n");
    s = s.write("    cmpq $0, -16(%rdi)\n");
    s = s.write("    jne .Lapo_grow\n");
    s = s.write("    cmpl $0, -8(%rdi)\n");
    s = s.write("    js .Larr_push_slow\n");
    s = s.write(".Lapo_grow:\n");
  }
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %r12\n");
  s = s.write("    pushq %r13\n");
  s = s.write("    movq %rdi, %r12\n");
  if (s.rc_free_debug) {
    s = s.write("    call __fern_arr_push\n");
  } else {
    s = s.write("    call .Larr_push_slow\n");
  }
  s = s.write("    cmpq %rax, %r12\n");
  s = s.write("    je .Lapo_ret\n");
  s = s.write("    cmpq $0x10000, %r12\n");
  s = s.write("    jb .Lapo_ret\n");
  s = s.write("    movl -8(%r12), %ecx\n");
  s = s.write(san_poison_check("%ecx", s.rc_free_debug));
  s = s.write("    testl %ecx, %ecx\n");
  s = s.write("    js .Lapo_ret\n");
  s = s.write("    cmpl $1, %ecx\n");
  s = s.write("    jne .Lapo_ret\n");
  s = s.write("    movl -16(%r12), %ecx\n");
  s = s.write("    addq $3, %rcx\n");
  s = s.write("    cmpq $65536, %rcx\n");
  s = s.write("    jae .Lapo_large\n");
  s = s.write(quarantine_rc("-8(%r12)", s.rc_free_debug));
  s = s.write("    leaq -16(%r12), %rdx\n");
  s = hev_free(s, "%rdx", "%rcx");
  if (!s.rc_free_debug) {
    s = freelist_push(s, "%rdx", "%rcx", "%rdi");
  }
  s = s.write(".Lapo_ret:\n");
  s = s.write("    popq %r13\n");
  s = s.write("    popq %r12\n");
  s = s.write("    leave\n");
  s = s.write("    ret\n");
  return s;
}

function apo_large(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(".Lapo_large:\n");
  s = s.write(quarantine_rc("-8(%r12)", s.rc_free_debug));
  s = s.write("    leaq -16(%r12), %r8\n");
  s = s.write("    leaq 0(,%rcx,8), %rsi\n");
  s = s.write("    pushq %rax\n");
  s = s.write("    call __fern_large_push\n");
  s = ssa_pop_r(s, "%rax");
  s = s.write("    jmp .Lapo_ret\n");
  return s;
}

function emit_arr_push_u8(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_arr_push_u8:\n");
  s = s.write(arr_push_fast_u8(".Larr_push_u8_slow", s.rc_free_debug));
  s = s.write(".Larr_push_u8_slow:\n");
  s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n");
  s = s.write("    movq %rdi, %r12\n    movq %rsi, %r13\n    movq (%r12), %r14\n    movq -16(%r12), %r15\n");
  if (!s.rc_free_debug) {
    s = s.write("    jmp .Larr_push_u8_grow\n");
  }
  s = s.write("    movl -8(%r12), %ecx\n");
  s = s.write(san_poison_check("%ecx", s.rc_free_debug));
  s = s.write("    cmpl $1, %ecx\n    je .Larr_push_u8_rc_ok\n    testl %ecx, %ecx\n    js .Larr_push_u8_rc_ok\n    jmp .Larr_push_u8_grow\n");
  s = s.write(".Larr_push_u8_rc_ok:\n");
  s = s.write("    movq %r15, %rcx\n    shlq $3, %rcx\n    cmpq %rcx, %r14\n    jge .Larr_push_u8_grow\n");
  s = s.write("    movb %r13b, 8(%r12,%r14)\n    incq %r14\n    movq %r14, (%r12)\n    movq %r12, %rax\n    jmp .Larr_push_u8_ret\n");
  s = s.write(".Larr_push_u8_grow:\n");
  s = s.write("    movq %r15, %rcx\n    movq %r15, %rax\n    shlq $3, %rax\n    cmpq %rax, %r14\n    jl .Larr_push_u8_cliff\n");
  s = s.write("    testq %rcx, %rcx\n    jne .Larr_push_u8_dbl\n    movq $4, %rcx\n    jmp .Larr_push_u8_cap\n");
  s = s.write(".Larr_push_u8_cliff:\n");
  s = s.write("    incq __fern_arr_push_shared(%rip)\n    addq %r14, __fern_arr_push_copied(%rip)\n    jmp .Larr_push_u8_cap\n");
  s = s.write(".Larr_push_u8_dbl:\n    shlq $1, %rcx\n");
  s = s.write(".Larr_push_u8_cap:\n    movq %rcx, %rdi\n    call __fern_arr_box\n");
  s = s.write("    leaq 1(%r14), %rcx\n    movq %rcx, (%rax)\n");
  s = s.write("    leaq 8(%r12), %rsi\n    leaq 8(%rax), %rdi\n    movq %r14, %rcx\n    rep movsb\n");
  s = s.write("    movb %r13b, 8(%rax,%r14)\n");
  s = s.write(".Larr_push_u8_ret:\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    leave\n    ret\n");
  s = s.write("__fern_arr_push_owned_u8:\n");
  s = s.write(arr_push_fast_u8(".Lapou_slow", s.rc_free_debug));
  s = s.write(".Lapou_slow:\n");
  s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n    pushq %r12\n    pushq %r13\n    movq %rdi, %r12\n");
  if (s.rc_free_debug) {
    s = s.write("    call __fern_arr_push_u8\n");
  } else {
    s = s.write("    call .Larr_push_u8_slow\n");
  }
  s = s.write("    cmpq %rax, %r12\n    je .Lapou_ret\n    cmpq $0x10000, %r12\n    jb .Lapou_ret\n");
  s = s.write("    movl -8(%r12), %ecx\n");
  s = s.write(san_poison_check("%ecx", s.rc_free_debug));
  s = s.write("    testl %ecx, %ecx\n    js .Lapou_ret\n    cmpl $1, %ecx\n    jne .Lapou_ret\n");
  s = s.write("    movl -16(%r12), %ecx\n    addq $3, %rcx\n    cmpq $65536, %rcx\n    jae .Lapou_large\n");
  s = s.write(quarantine_rc("-8(%r12)", s.rc_free_debug));
  s = s.write("    leaq -16(%r12), %rdx\n");
  s = hev_free(s, "%rdx", "%rcx");
  if (!s.rc_free_debug) {
    s = freelist_push(s, "%rdx", "%rcx", "%rdi");
  }
  s = s.write(".Lapou_ret:\n    popq %r13\n    popq %r12\n    leave\n    ret\n");
  s = s.write(".Lapou_large:\n");
  s = s.write(quarantine_rc("-8(%r12)", s.rc_free_debug));
  s = s.write("    leaq -16(%r12), %r8\n    leaq 0(,%rcx,8), %rsi\n    pushq %rax\n    call __fern_large_push\n    popq %rax\n    jmp .Lapou_ret\n");
  return s;
}

function arr_push_fast_u8(slow: string, on: boolean): string {
  if (on) {
    return "";
  }
  let ok: string = slow + "_ok";
  return "    movq (%rdi), %rdx\n    movq -16(%rdi), %rcx\n    shlq $3, %rcx\n    cmpq %rcx, %rdx\n    jge " + slow + "\n"
    + "    movl -8(%rdi), %ecx\n    cmpl $1, %ecx\n    je " + ok + "\n"
    + "    testl %ecx, %ecx\n    jns " + slow + "\n"
    + ok + ":\n    movb %sil, 8(%rdi,%rdx)\n    incq %rdx\n    movq %rdx, (%rdi)\n"
    + "    movq %rdi, %rax\n    ret\n";
}

function arr_copy_elems(l: string): string {
  return "    leaq 8(%r12), %rsi\n    leaq 8(%rax), %rdi\n    movq %r14, %rcx\n    subq $8, %rcx\n    jl " + l + "_copy_lt8\n"
    + l + "_copy8:\n    vmovdqu (%rsi), %ymm0\n    vmovdqu 32(%rsi), %ymm1\n    vmovdqu %ymm0, (%rdi)\n    vmovdqu %ymm1, 32(%rdi)\n"
    + "    addq $64, %rsi\n    addq $64, %rdi\n    subq $8, %rcx\n    jge " + l + "_copy8\n    vzeroupper\n"
    + l + "_copy_lt8:\n    addq $8, %rcx\n    cmpq $4, %rcx\n    jl " + l + "_copy1\n"
    + "    movdqu (%rsi), %xmm0\n    movdqu 16(%rsi), %xmm1\n    movdqu %xmm0, (%rdi)\n    movdqu %xmm1, 16(%rdi)\n"
    + "    addq $32, %rsi\n    addq $32, %rdi\n    subq $4, %rcx\n"
    + l + "_copy1:\n    testq %rcx, %rcx\n    jz " + l + "_copy_done\n"
    + l + "_copy1_loop:\n    movq (%rsi), %rdx\n    movq %rdx, (%rdi)\n    addq $8, %rsi\n    addq $8, %rdi\n    decq %rcx\n    jnz " + l + "_copy1_loop\n"
    + l + "_copy_done:\n";
}

function arr_push_fast(slow: string, on: boolean): string {
  if (on) {
    return "";
  }
  let ok: string = slow + "_ok";
  return "    movq (%rdi), %rdx\n    cmpq -16(%rdi), %rdx\n    jge " + slow + "\n"
    + "    movl -8(%rdi), %ecx\n    cmpl $1, %ecx\n    je " + ok + "\n"
    + "    testl %ecx, %ecx\n    jns " + slow + "\n"
    + ok + ":\n    movq %rsi, 8(%rdi,%rdx,8)\n    incq %rdx\n    movq %rdx, (%rdi)\n"
    + "    movq %rdi, %rax\n    ret\n";
}

function hev_free(s: asmcore.EmitState, ptr: string, words: string): asmcore.EmitState {
  if (!hev_on(s)) {
    return s;
  }
  s = s.write("    pushq " + words + "\n");
  s = s.write("    pushq " + ptr + "\n");
  s = s.write("    call __fern_hev_f\n");
  s = s.write("    addq $16, %rsp\n");
  return s;
}

