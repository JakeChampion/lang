    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    movq %rdi, %rbx\n");
    s = s.write("    cmpq $16, %rbx\n");
    s = s.write("    jae .Lbufnew_cap\n");
    s = s.write("    movq $16, %rbx\n");
    s = s.write(".Lbufnew_cap:\n");
    s = s.write("    movq $32, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq %rax, %r12\n");  // control block
    s = s.write("    movq %rbx, %rdi\n");
    s = s.write("    call __fern_alloc\n");
