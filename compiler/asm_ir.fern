function hev_shim_site(s: asmcore.EmitState, tag: string): asmcore.EmitState {
  if (!hev_on(s)) {
    return s;
  }
  s = s.write("    movq __fern_hev_site(%rip), %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jne .L" + tag + "_hs\n");
  s = s.write("    movq (%rsp), %rax\n");
  s = s.write("    movq %rax, __fern_hev_site(%rip)\n");
  s = s.write(".L" + tag + "_hs:\n");
  return s;
}

// Appends a space and the sixteen hex digits of reg at the cursor in %rdi.
function hev_field(s: asmcore.EmitState, reg: string): asmcore.EmitState {
  s = s.write("    movb $32, (%rdi)\n");
  s = s.write("    addq $1, %rdi\n");
  s = s.write("    movq " + reg + ", %rax\n");
  s = s.write("    call .Lhev_hex\n");
  return s;
}

function hev_save(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    pushq %rax\n    pushq %rcx\n    pushq %rdx\n    pushq %rsi\n");
  s = s.write("    pushq %rdi\n    pushq %r8\n    pushq %r9\n    pushq %r10\n");
  s = s.write("    pushq %r11\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n");
  s = s.write("    pushq %r14\n");
  return s;
}

function hev_restore(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n");
  s = s.write("    popq %r11\n    popq %r10\n    popq %r9\n    popq %r8\n");
  s = s.write("    popq %rdi\n    popq %rsi\n    popq %rdx\n    popq %rcx\n");
  s = s.write("    popq %rax\n");
  return s;
}

function rt_x86_str_eq(): string {
  let s = "__fn___fern_str_eq:\n";
  s += "    movq 8(%rsp), %rax\n    movq 16(%rsp), %rsi\n";
  s += "__fn___fern_str_eq.r:\n";
  s += "    cmpq %rsi, %rax\n    jz .Lseq_yes\n";
  s += "    movq 8(%rax), %rdx\n    cmpq 8(%rsi), %rdx\n    jnz .Lseq_no\n";
  s += "    movq (%rax), %rcx\n    movq (%rsi), %rsi\n";
  s += "    cmpq %rsi, %rcx\n    jz .Lseq_yes\n";
  s += "    cmpq $8, %rdx\n    jb .Lseq_short\n";
  s += "    leaq -8(%rcx,%rdx), %r8\n    leaq -8(%rsi,%rdx), %r9\n";
  s += ".Lseq_word:\n";
  s += "    movq (%rcx), %rax\n    cmpq (%rsi), %rax\n    jnz .Lseq_no\n";
  s += "    addq $8, %rcx\n    addq $8, %rsi\n";
  s += "    cmpq %r8, %rcx\n    jb .Lseq_word\n";
  s += "    movq (%r8), %rax\n    cmpq (%r9), %rax\n    jnz .Lseq_no\n";
  s += "    jmp .Lseq_yes\n";
  s += ".Lseq_short:\n";
  s += "    testq %rdx, %rdx\n    jz .Lseq_yes\n";
  s += "    cmpq $4, %rdx\n    jb .Lseq_byte\n";
  s += "    movl (%rcx), %eax\n    cmpl (%rsi), %eax\n    jnz .Lseq_no\n";
  s += "    movl -4(%rcx,%rdx), %eax\n    cmpl -4(%rsi,%rdx), %eax\n    jnz .Lseq_no\n";
  s += "    jmp .Lseq_yes\n";
  s += ".Lseq_byte:\n";
  s += "    movzbl (%rcx), %eax\n    cmpb (%rsi), %al\n    jnz .Lseq_no\n";
  s += "    movzbl -1(%rcx,%rdx), %eax\n    cmpb -1(%rsi,%rdx), %al\n    jnz .Lseq_no\n";
  s += "    cmpq $3, %rdx\n    jb .Lseq_yes\n";
  s += "    movzbl 1(%rcx), %eax\n    cmpb 1(%rsi), %al\n    jnz .Lseq_no\n";
  s += ".Lseq_yes:\n    movl $1, %eax\n    ret\n";
  s += ".Lseq_no:\n    xorl %eax, %eax\n    ret\n";
  s += ".size __fn___fern_str_eq, .-__fn___fern_str_eq\n";
  return s;
}

function emit_rt_signal_flags(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.any_need(["signal_catch", "signal_taken"])) {
    return s;
  }
  s = s.write("    .section .bss\n    .align 8\n__fern_sig_flags: .skip 65\n    .text\n");
  if (s.has_need("signal_catch")) {
    s = s.write("    .globl __fern_sig_catcher\n    .globl __fern_sig_return\n__fern_sig_catcher:\n    movslq %edi, %rdi\n    leaq __fern_sig_flags(%rip), %rax\n    movb $1, (%rax,%rdi)\n    ret\n");
    s = s.write("__fern_sig_return:\n    movq $15, %rax\n");
    s = s.syscall(15);
  }
  if (s.has_need("signal_taken")) {
    s = s.write("    .globl __fern_signal_taken\n    .type __fern_signal_taken, @function\n__fern_signal_taken:\n");
    s = s.write("    xorl %eax, %eax\n    movl %edi, %ecx\n    subl $1, %ecx\n    cmpl $63, %ecx\n    ja .Lsig_taken_none\n");
    s = s.write("    movslq %edi, %rdi\n    leaq __fern_sig_flags(%rip), %rcx\n    xchgb %al, (%rcx,%rdi)\n.Lsig_taken_none:\n    ret\n");
  }
  return s;
}

function emit_rt_utf8_blocks(s: asmcore.EmitState): asmcore.EmitState {
