  // __fern_eprint_str and __fern_putchar are Fern runtime functions (#2649):
  // asmcore.rt_src_eprint_str / rt_src_putchar, lowered through the IR pipeline
  // via emit_ir_runtime_fern_fn in the entry block. Both write their one scratch
  // byte — the newline, the character — into the static __fern_scratch, which is
  // why they join its gate; a Fern helper has no way to name a stack slot.
  // Global string-builder primitive — the amortised-O(1) output accumulator
  // (strbuf_reset / strbuf_append / strbuf_take). The buffer is a heap block
  // that doubles (from 64 KiB) when an append would not fit, so the
  // accumulated output has no fixed ceiling (#8212). Three .bss words: len,
  // data ptr, cap. take allocates a fresh box via __fern_alloc (so this is
  // heap-gated too). Gated on the strbuf need the op handlers marked.
  if (s.has_need("strbuf") || s.has_need("buf")) {
    s = emit_runtime_memcpy(s);
  }
  if (s.has_need("strbuf")) {
    s = s.write("    .section .bss\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_strbuf_len: .quad 0\n");
    s = s.write("__fern_strbuf_ptr: .quad 0\n");
    s = s.write("__fern_strbuf_cap: .quad 0\n");
    s = s.write("    .section .text\n");
    s = s.write("__fern_strbuf_reset:\n");
    s = s.write("    movq $0, __fern_strbuf_len(%rip)\n");
    s = s.write("    ret\n");
    // grow(need in %rdi): replace the buffer with one of at least `need`
    // bytes and copy the live bytes across. The old buffer is left to the
    // arena, like the wasm runtime's strbuf. %rbx = need / new buffer,
    // %r12 = new cap, across the __fern_alloc call.
    s = s.write("__fern_strbuf_grow:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    movq %rdi, %rbx\n");
    s = s.write("    movq __fern_strbuf_cap(%rip), %r12\n");
    s = s.write("    testq %r12, %r12\n");
    s = s.write("    jne .Lsbgrow_dbl\n");
    s = s.write("    movq $65536, %r12\n");
    s = s.write(".Lsbgrow_dbl:\n");
    s = s.write("    cmpq %rbx, %r12\n");
    s = s.write("    jae .Lsbgrow_alloc\n");
    s = s.write("    addq %r12, %r12\n");
    s = s.write("    jmp .Lsbgrow_dbl\n");
    s = s.write(".Lsbgrow_alloc:\n");
    s = s.write("    movq %r12, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    if (s.leak_check) {
