  // caller's drop can be the last.
  if (s.has_need("set_args")) {
    s = s.write("    .section .bss\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_args_set: .quad 0\n");
    s = s.write("    .section .text\n");
    s = s.write("__fn___fern_set_args:\n");
    s = s.write("    pushq 8(%rsp)\n");
    s = s.write("    call __fn___fern_rc_inc\n");
    s = s.write("    popq %rax\n");
    s = s.write("    movq __fern_args_set(%rip), %rcx\n");
    s = s.write("    movq %rax, __fern_args_set(%rip)\n");
    s = s.write("    testq %rcx, %rcx\n");
    s = s.write("    je .Lsetargs_ret\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    call __fn___fern_str_arr_free\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write(".Lsetargs_ret:\n");
    s = s.write("    xorl %eax, %eax\n");
    s = s.write("    ret\n");
