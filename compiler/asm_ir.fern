    s = s.write("    movslq 16(%rsp), %rax\n");  // lo
    s = s.write("    movslq 8(%rsp), %rsi\n");  // hi
    s = s.write("    movq 24(%rsp), %rdx\n");  // s
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    js __fern_slice_abort.c\n");
    s = s.write("    cmpq 8(%rdx), %rsi\n");
    s = s.write("    jg __fern_slice_abort.c\n");
    s = s.write("    subq %rax, %rsi\n");  // lb
    s = s.write("    js __fern_slice_abort.c\n");
    s = s.write("    movq (%rdx), %rdx\n");
    s = s.write("    addq %rax, %rdx\n");  // s's data + lo
    s = s.write(".Lsgf_body:\n");
    s = s.write("    movq 8(%r8), %rcx\n");  // la
    s = s.write("    leaq (%rcx,%rsi), %rdi\n");  // grown length
    s = s.write("    cmpq $0x7fffffff, %rdi\n");
    s = s.write("    ja __fern_alloc_size_abort.c\n");
    s = s.write("    leaq 39(%rdi), %r9\n");
    s = s.write("    shrq $3, %r9\n");  // words the grown string needs
    s = s.write("    leaq 31(%rcx), %r10\n");
    s = s.write("    shrq $3, %r10\n");  // a's words as a fused box
    s = s.write("    addq %r10, %r10\n");
    s = s.write("    cmpq %r9, %r10\n");
    s = s.write("    jae .Lsgf_class\n");
    s = s.write("    movq %r9, %r10\n");
    s = s.write(".Lsgf_class:\n");
    s = s.write("    cmpq $65536, %r10\n");
    s = s.write("    jae .Lsgf_large\n");
    s = s.write("    pushq %r10\n");
    s = s.write("    call __fern_capw\n");
    s = s.write("    popq %r10\n");  // the class's capacity, which the block is bumped at
    s = s.write("    jmp .Lsgf_alloc\n");
    s = s.write(".Lsgf_large:\n");
    s = s.write("    cmpq $0x8000000, %r10\n");  // past 1 GiB the block is exact
    s = s.write("    ja .Lsgf_alloc\n");
    s = s.write("    leaq 0(,%r10,8), %rax\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    pushq %rdx\n");
    s = large_class(s);
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    shrq $3, %rax\n");
    s = s.write("    movq %rax, %r10\n");
    s = s.write(".Lsgf_alloc:\n");
    s = s.write("    leaq 0(,%r10,8), %rdi\n");
    s = s.write("    call __fern_alloc\n");  // %rax = base; %rcx, %rdx, %rsi, %r8, %r10 survive
    s = s.write("    movq %r10, (%rax)\n");  // the capacity, in words
    s = s.write("    movl $1, 8(%rax)\n");  // rc
    s = s.write("    movl $" + util.i32_to_string(grown_marker()) + ", 12(%rax)\n");
    s = s.write("    leaq 32(%rax), %rdi\n");  // data
    s = s.write("    movq %rdi, 16(%rax)\n");
    s = s.write("    leaq (%rcx,%rsi), %r9\n");
    s = s.write("    movq %r9, 24(%rax)\n");  // len
    s = s.write("    movq %rsi, %r9\n");  // lb
    s = s.write("    movq (%r8), %rsi\n");  // a's bytes
    s = s.write("    rep movsb\n");  // %rcx = la; %rdi ends past them
    s = s.write("    movq %rdx, %rsi\n");
    s = s.write("    movq %r9, %rcx\n");
    s = s.write("    rep movsb\n");
    s = s.write("    addq $16, %rax\n");  // box = base+16
    s = s.write("    ret\n");
