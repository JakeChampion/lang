  // +Inf trips the overflow branch and -Inf the underflow one, so only NaN
  // needs its own test.
  s = s.write(".globl __fern_exp_f64\n");
  s = s.write(".type __fern_exp_f64, @function\n");
  s = s.write("__fern_exp_f64:\n");
  s = s.write("    ucomisd %xmm0, %xmm0\n    jp .Lfexp_ret\n");
  s = s.write(fc_ld("%xmm1", ".Lfc_expovf") + "    ucomisd %xmm1, %xmm0\n    ja .Lfexp_inf\n");
  s = s.write(fc_ld("%xmm1", ".Lfc_expunf") + "    ucomisd %xmm1, %xmm0\n    jb .Lfexp_zero\n");
  s = s.write(fc_ld("%xmm1", ".Lfc_invln2") + "    mulsd %xmm0, %xmm1\n");
  s = s.write("    roundsd $0, %xmm1, %xmm1\n    cvttsd2si %xmm1, %rax\n");  // k
  s = s.write("    movapd %xmm1, %xmm2\n" + fc_ld("%xmm7", ".Lfc_ln2hi") + "    mulsd %xmm7, %xmm2\n");
  s = s.write("    movapd %xmm0, %xmm3\n    subsd %xmm2, %xmm3\n");  // hi
  s = s.write(fc_ld("%xmm7", ".Lfc_ln2lo") + "    mulsd %xmm7, %xmm1\n");  // lo
  s = s.write("    movapd %xmm3, %xmm0\n    subsd %xmm1, %xmm0\n");  // r
  s = s.write("    movapd %xmm0, %xmm4\n    mulsd %xmm0, %xmm4\n");  // t
  s = s.write(fc_ld("%xmm5", ".Lfc_p5"));
  s = s.write(fc_horner("%xmm5", "%xmm4", "%xmm7", ".Lfc_p4"));
  s = s.write(fc_horner("%xmm5", "%xmm4", "%xmm7", ".Lfc_p3"));
  s = s.write(fc_horner("%xmm5", "%xmm4", "%xmm7", ".Lfc_p2"));
  s = s.write(fc_horner("%xmm5", "%xmm4", "%xmm7", ".Lfc_p1"));
  s = s.write("    mulsd %xmm4, %xmm5\n");  // t*(…)
  s = s.write("    movapd %xmm0, %xmm6\n    subsd %xmm5, %xmm6\n");  // c
  s = s.write("    movapd %xmm0, %xmm7\n    mulsd %xmm6, %xmm7\n");  // r*c
  s = s.write(fc_ld("%xmm2", ".Lfc_two") + "    subsd %xmm6, %xmm2\n");  // 2-c
  s = s.write("    divsd %xmm2, %xmm7\n");
  s = s.write("    movapd %xmm1, %xmm2\n    subsd %xmm7, %xmm2\n");  // lo - …
  s = s.write("    subsd %xmm3, %xmm2\n");  // - hi
  s = s.write(fc_ld("%xmm0", ".Lfc_one") + "    subsd %xmm2, %xmm0\n");
  // 2^k as two half-scales; one exponent field cannot hold the subnormal
  // band, where the low bits of k land in the sign bit.
  s = s.write("    movq %rax, %rcx\n    sarq $1, %rcx\n    subq %rcx, %rax\n");
  s = s.write("    addq $1023, %rcx\n    shlq $52, %rcx\n    movq %rcx, %xmm1\n");
  s = s.write("    addq $1023, %rax\n    shlq $52, %rax\n    movq %rax, %xmm2\n");
  s = s.write("    mulsd %xmm1, %xmm0\n    mulsd %xmm2, %xmm0\n");
  s = s.write(".Lfexp_ret:\n    ret\n");
  s = s.write(".Lfexp_inf:\n" + fc_retbits("0x7ff0000000000000"));
  s = s.write(".Lfexp_zero:\n    xorpd %xmm0, %xmm0\n    ret\n");
  s = s.write(".size __fern_exp_f64, .-__fern_exp_f64\n");

  // __fern_log_f64(%xmm0 = x) -> ln x, the table-driven kernel
  // internal/tables/fdlibm/logtab.go documents; instruction for instruction native
  // x86-64's, with each table operand loaded into %xmm1 first. %r8 holds
  // .Lfc_logtab's address throughout, %rdx is 3·i, the row's index in doubles.
  s = s.write(".globl __fern_log_f64\n");
  s = s.write(".type __fern_log_f64, @function\n");
  s = s.write("__fern_log_f64:\n");
  s = s.write("    leaq .Lfc_logtab(%rip), %r8\n    movq %xmm0, %rax\n");
  s = s.write("    movabsq $0x3fee000000000000, %rcx\n    movq %rax, %rdx\n    subq %rcx, %rdx\n");
  s = s.write("    movabsq $0x0003090000000000, %rcx\n    cmpq %rcx, %rdx\n    jb .Lflog_near1\n");
  s = s.write("    movq %rax, %rcx\n    shrq $52, %rcx\n    subq $1, %rcx\n");
  s = s.write("    cmpq $0x7fe, %rcx\n    jae .Lflog_special\n");  // zero, subnormal, negative, Inf or NaN
  s = s.write(".Lflog_main:\n");
  s = s.write("    movabsq $0x3fe6000000000000, %rcx\n    movq %rax, %rsi\n    subq %rcx, %rsi\n");  // tmp
  s = s.write("    movq %rsi, %rcx\n    sarq $52, %rcx\n");
  s = s.write("    xorps %xmm4, %xmm4\n    cvtsi2sd %rcx, %xmm4\n");  // k
  s = s.write("    shlq $52, %rcx\n    subq %rcx, %rax\n");  // bits(z)
  s = s.write("    movq %rsi, %rdx\n    shrq $45, %rdx\n    andq $127, %rdx\n    leaq (%rdx,%rdx,2), %rdx\n");
  s = s.write("    movq %rax, %xmm0\n");  // z
  s = s.write("    shrq $44, %rax\n    orq $1, %rax\n    shlq $44, %rax\n    movq %rax, %xmm1\n");  // c
  s = s.write("    subsd %xmm1, %xmm0\n    movsd 112(%r8,%rdx,8), %xmm1\n    mulsd %xmm1, %xmm0\n");  // r
  s = s.write("    movapd %xmm4, %xmm2\n" + fc_ld("%xmm1", ".Lfc_ln2hi") + "    mulsd %xmm1, %xmm2\n");
  s = s.write("    movsd 120(%r8,%rdx,8), %xmm1\n    addsd %xmm1, %xmm2\n");  // w
  s = s.write("    movapd %xmm2, %xmm3\n    addsd %xmm0, %xmm3\n");  // hi
  s = s.write("    subsd %xmm3, %xmm2\n    addsd %xmm0, %xmm2\n");
  s = s.write(fc_ld("%xmm1", ".Lfc_ln2lo") + "    mulsd %xmm1, %xmm4\n");
  s = s.write("    movsd 128(%r8,%rdx,8), %xmm1\n    addsd %xmm1, %xmm4\n    addsd %xmm4, %xmm2\n");  // lo
  s = s.write("    movapd %xmm0, %xmm5\n    mulsd %xmm0, %xmm5\n");  // r2
  s = s.write("    movapd %xmm0, %xmm6\n    movsd 8(%r8), %xmm1\n    mulsd %xmm1, %xmm6\n");
  s = s.write("    movsd (%r8), %xmm1\n    addsd %xmm1, %xmm6\n");
  s = s.write("    movapd %xmm0, %xmm7\n    movsd 24(%r8), %xmm1\n    mulsd %xmm1, %xmm7\n");
  s = s.write("    movsd 16(%r8), %xmm1\n    addsd %xmm1, %xmm7\n");
  s = s.write("    mulsd %xmm5, %xmm7\n    addsd %xmm7, %xmm6\n");  // p
  s = s.write("    movapd %xmm5, %xmm7\n" + fc_ld("%xmm1", ".Lfc_half") + "    mulsd %xmm1, %xmm7\n    subsd %xmm7, %xmm2\n");
  s = s.write("    mulsd %xmm0, %xmm5\n    mulsd %xmm6, %xmm5\n    addsd %xmm5, %xmm2\n");
  s = s.write("    addsd %xmm3, %xmm2\n    movapd %xmm2, %xmm0\n    ret\n");
  // log1p(r) for r = x - 1, which is exact here. p = ((B[a] + r*B[a+1]) +
  // r2*B[a+2]) + r3*tail, innermost first.
  s = s.write(".Lflog_near1:\n");
  s = s.write(fc_ld("%xmm1", ".Lfc_one") + "    subsd %xmm1, %xmm0\n");  // r
  s = s.write("    movapd %xmm0, %xmm1\n    mulsd %xmm0, %xmm1\n");  // r2
  s = s.write("    movapd %xmm0, %xmm2\n    mulsd %xmm1, %xmm2\n");  // r3
  let a: i32 = 6;
  while (a >= 0) {
    s = s.write("    movapd %xmm0, %xmm4\n    movsd " + util.i32_to_string(32 + 8 * (a + 1)) + "(%r8), %xmm6\n    mulsd %xmm6, %xmm4\n");
    s = s.write("    movsd " + util.i32_to_string(32 + 8 * a) + "(%r8), %xmm6\n    addsd %xmm6, %xmm4\n");
    s = s.write("    movapd %xmm1, %xmm5\n    movsd " + util.i32_to_string(32 + 8 * (a + 2)) + "(%r8), %xmm6\n    mulsd %xmm6, %xmm5\n    addsd %xmm5, %xmm4\n");
    if (a == 6) {
      s = s.write("    movapd %xmm2, %xmm3\n    movsd 104(%r8), %xmm6\n    mulsd %xmm6, %xmm3\n");
    } else {
      s = s.write("    mulsd %xmm2, %xmm3\n");
    }
    s = s.write("    addsd %xmm4, %xmm3\n");
    a = a - 3;
  }
  s = s.write("    mulsd %xmm2, %xmm3\n");  // y
  s = s.write("    movabsq $0x41a0000000000000, %rax\n    movq %rax, %xmm1\n    mulsd %xmm0, %xmm1\n");  // r·2^27
  s = s.write("    movapd %xmm0, %xmm4\n    addsd %xmm1, %xmm4\n    subsd %xmm1, %xmm4\n");  // rhi
  s = s.write("    movapd %xmm0, %xmm5\n    subsd %xmm4, %xmm5\n");  // rlo
  s = s.write(fc_ld("%xmm7", ".Lfc_half"));
  s = s.write("    movapd %xmm4, %xmm6\n    mulsd %xmm4, %xmm6\n    mulsd %xmm7, %xmm6\n");  // h
  s = s.write("    movapd %xmm0, %xmm2\n    subsd %xmm6, %xmm2\n");  // hi
  s = s.write("    movapd %xmm0, %xmm1\n    subsd %xmm2, %xmm1\n    subsd %xmm6, %xmm1\n");  // lo
  s = s.write("    addsd %xmm0, %xmm4\n    mulsd %xmm7, %xmm5\n    mulsd %xmm4, %xmm5\n    subsd %xmm5, %xmm1\n");
  s = s.write("    addsd %xmm1, %xmm3\n    addsd %xmm2, %xmm3\n    movapd %xmm3, %xmm0\n    ret\n");
  // %rax = bits(x), %rcx = top-1 with top the sign and exponent.
  s = s.write(".Lflog_special:\n");
  s = s.write("    movq %rax, %rdx\n    addq %rdx, %rdx\n    jz .Lflog_neginf\n");  // ±0
  s = s.write("    ucomisd %xmm0, %xmm0\n    jp .Lflog_ret\n");
  s = s.write("    testq %rax, %rax\n    js .Lflog_nan\n");
  s = s.write("    cmpq $0x7fe, %rcx\n    je .Lflog_ret\n");  // +Inf
  // Subnormal: scale into the normal range, then take the 52 back off the
  // exponent field so the reduction's k comes out right.
  s = s.write("    movabsq $0x4330000000000000, %rdx\n    movq %rdx, %xmm1\n    mulsd %xmm1, %xmm0\n");
  s = s.write("    movq %xmm0, %rax\n    movabsq $0x0340000000000000, %rdx\n    subq %rdx, %rax\n");
  s = s.write("    jmp .Lflog_main\n");
  s = s.write(".Lflog_ret:\n    ret\n");
  s = s.write(".Lflog_nan:\n" + fc_retbits("0x7ff8000000000000"));
  s = s.write(".Lflog_neginf:\n" + fc_retbits("0xfff0000000000000"));
  s = s.write(".size __fern_log_f64, .-__fern_log_f64\n");

  // __fern_pow_f64(%xmm0 = x, %xmm1 = y) -> x^y.
  //
  // Integer-exponent fast path. exp(y·ln x) CANNOT return exactly 9 for
  // pow(3,2): a 1-ulp error in ln 3 is amplified by the exponential to ~4e-15
  // on a result of 9, so it lands just under and `as i32` truncates to 8.
  // Repeated squaring is exact wherever the result is representable, and
  // cheaper than two transcendental calls for small |n|.
  //
  // Integrality is tested by an i64 round-trip rather than a compare against
  // trunc(y), so a NaN or out-of-range y falls out as a huge |n| and the range
  // check catches it instead of needing a parity branch.
  s = s.write(".globl __fern_pow_f64\n");
  s = s.write(".type __fern_pow_f64, @function\n");
  s = s.write("__fern_pow_f64:\n");
  s = s.write("    cvttsd2si %xmm1, %rax\n    xorps %xmm2, %xmm2\n    cvtsi2sd %rax, %xmm2\n");
  s = s.write("    ucomisd %xmm1, %xmm2\n    jne .Lfpow_general\n");
  // |n|, branch-free: (n ^ (n>>63)) - (n>>63). Re-entered once with a
  // reciprocated base and a negated n; see the overflow retry below.
  s = s.write(".Lfpow_retry:\n");
  s = s.write("    movq %rax, %rcx\n    movq %rax, %rdx\n    sarq $63, %rdx\n");
  s = s.write("    xorq %rdx, %rcx\n    subq %rdx, %rcx\n");
  s = s.write("    cmpq $1074, %rcx\n    ja .Lfpow_general\n");
  s = s.write(fc_ld("%xmm3", ".Lfc_one") + "    movapd %xmm0, %xmm4\n");
  s = s.write(".Lfpow_loop:\n    testq $1, %rcx\n    jz .Lfpow_skip\n");
  s = s.write("    mulsd %xmm4, %xmm3\n");
  s = s.write(".Lfpow_skip:\n    mulsd %xmm4, %xmm4\n    shrq $1, %rcx\n    jnz .Lfpow_loop\n");
  s = s.write("    testq %rax, %rax\n    jns .Lfpow_done\n");
  s = s.write(fc_ld("%xmm5", ".Lfc_one") + "    divsd %xmm3, %xmm5\n");
  // 1/acc is zero only when acc reached an infinity, so the magnitude
  // overflowed on the way to a result that may itself be representable.
  // Redo on 1/x; negating n makes the second pass return the accumulator
  // directly, so the retry runs at most once and needs no flag.
  s = s.write("    xorpd %xmm6, %xmm6\n    ucomisd %xmm6, %xmm5\n");
  s = s.write("    jne .Lfpow_recip\n    jp .Lfpow_recip\n");
  s = s.write(fc_ld("%xmm5", ".Lfc_one") + "    divsd %xmm0, %xmm5\n    movapd %xmm5, %xmm0\n");
  s = s.write("    negq %rax\n    jmp .Lfpow_retry\n");
  s = s.write(".Lfpow_recip:\n    movapd %xmm5, %xmm3\n");
  s = s.write(".Lfpow_done:\n    movapd %xmm3, %xmm0\n    ret\n");
  // General case: x^y = sign · exp(y·ln|x|). ln is defined only for x > 0, so
  // a negative base is split into a sign and |x| first: for an integral y the
  // sign is (-1)^y, and a non-integral y makes the result NaN. Every |y| >= 2^53
  // is an even integer, which is what leaves pow(x<0, ±Inf) a magnitude rather
  // than a NaN.
  //
  // The only non-leaf helper: SysV has no callee-saved xmm registers, so y and
  // the sign multiplier are stashed on the stack across the log call, where
  // arm64 can use callee-saved d8.
  s = s.write(".Lfpow_general:\n    subq $16, %rsp\n    movsd %xmm1, (%rsp)\n");
  s = s.write(fc_ld("%xmm2", ".Lfc_one") + "    movsd %xmm2, 8(%rsp)\n");  // sign of the result
  s = s.write("    movq %xmm0, %rax\n    testq %rax, %rax\n    jns .Lfpow_mag\n");  // +0 or a positive base
  s = s.write("    movabsq $0x7fffffffffffffff, %rcx\n    andq %rcx, %rax\n");
  s = s.write("    movq %rax, %xmm0\n");  // |x|
  s = s.write("    movq %xmm1, %rdx\n    andq %rcx, %rdx\n");  // |y|
  s = s.write("    movabsq $0x4340000000000000, %rcx\n    cmpq %rcx, %rdx\n    jb .Lfpow_parity\n");
  s = s.write("    movabsq $0x7ff0000000000000, %rcx\n    cmpq %rcx, %rdx\n    jbe .Lfpow_mag\n");  // |y| >= 2^53, finite or ±Inf: an even integer
  s = s.write("    jmp .Lfpow_nan\n");  // y is NaN
  s = s.write(".Lfpow_parity:\n    cvttsd2si %xmm1, %rdx\n    xorps %xmm2, %xmm2\n    cvtsi2sd %rdx, %xmm2\n");
  s = s.write("    ucomisd %xmm1, %xmm2\n    jne .Lfpow_nan\n");  // y is not an integer
  s = s.write("    testq $1, %rdx\n    jz .Lfpow_mag\n");  // even exponent
  s = s.write("    movabsq $0xbff0000000000000, %rcx\n    movq %rcx, %xmm2\n    movsd %xmm2, 8(%rsp)\n");
  // |x| == 1 is 1 for every y, including the NaN and ±Inf that exp(y·ln|x|)
  // would turn into NaN through y·0.
  s = s.write(".Lfpow_mag:\n    movq %xmm0, %rax\n");
  s = s.write("    movabsq $0x3ff0000000000000, %rcx\n    cmpq %rcx, %rax\n    je .Lfpow_sign\n");
  s = s.write("    call __fern_log_f64\n");
  s = s.write("    movsd (%rsp), %xmm1\n    mulsd %xmm1, %xmm0\n");
  s = s.write("    call __fern_exp_f64\n");
  s = s.write(".Lfpow_sign:\n    mulsd 8(%rsp), %xmm0\n");
  s = s.write("    addq $16, %rsp\n    ret\n");
  s = s.write(".Lfpow_nan:\n    addq $16, %rsp\n" + fc_retbits("0x7ff8000000000000"));
  s = s.write(".size __fern_pow_f64, .-__fern_pow_f64\n");
  return s;
}

// needs_fs_runtime is the gate on the io_error call-graph bundle: every
// need whose generated Fern body is emitted from that block. The filesystem
// is all of it bar the two process ops, which are there because they classify an
// errno the same way and so shares the same call graph.
function needs_fs_runtime(s: asmcore.EmitState): boolean {
  return s.any_need([
    "stat", "lstat", "statfs", "mounts", "sysctl", "access", "read_file",
    "read_file_bytes", "read_file_bytes_u8", "remove_file", "create_dir_all", "create_dir",
    "remove_dir", "create_link", "clone_file", "create_symlink", "rename", "rename_noreplace", "rename_exchange", "getxattr", "getxattr_bytes", "getxattr_bytes_u8", "lgetxattr", "lgetxattr_bytes", "lgetxattr_bytes_u8", "setxattr", "setxattr_bytes", "setxattr_bytes_u8", "lsetxattr", "lsetxattr_bytes", "lsetxattr_bytes_u8", "chmod", "chmod_at",
    "truncate", "mknod", "chown_at", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc", "pipe", "set_file_times",
    "read_link", "getcwd", "chdir", "chroot", "setuid", "setgid", "setgroups", "fd_fsync", "fd_fdatasync", "fd_syncfs", "fd_drop_cache", "sync",
    "umask", "write_file", "write_file_bytes", "write_file_bytes_u8", "write_file_exec", "temp_dir", "read_dir", "read_dir_all", "read_dir_ino",
    "remove_dir_all", "open_file", "open_with", "writer_write", "write_some",
    "reader", "read_chunk_bytes", "read_chunk_bytes_u8", "write_bytes", "write_bytes_u8", "write_some_bytes", "write_some_bytes_u8", "signal_send", "set_process_group", "set_priority", "clock_set",
    "open_dir", "dir_open", "dir_entries", "dir_stat", "dir_access", "dir_unlink", "dir_chmod", "dir_chown",
  ]);
}

// needs_heap_runtime gates the allocator and the RC runtime. `heap` is the
// need an allocating op marks; the rest are the helpers whose own bodies
// allocate, so a program that never allocates directly still pulls the
// runtime in through one of them.
function needs_heap_runtime(s: asmcore.EmitState): boolean {
  return s.any_need([
    "heap", "i32_to_string", "u32_to_string",
    "str_read_line", "strbuf", "buf", "reader",
    "write_file", "write_file_bytes", "write_file_bytes_u8", "write_file_exec", "remove_dir_all", "temp_dir",
    "read_dir", "read_dir_all", "read_dir_ino", "remove_file", "create_dir_all", "create_dir",
    "remove_dir", "create_link", "clone_file", "create_symlink", "rename", "rename_noreplace", "rename_exchange", "getxattr", "getxattr_bytes", "getxattr_bytes_u8", "lgetxattr", "lgetxattr_bytes", "lgetxattr_bytes_u8", "setxattr", "setxattr_bytes", "setxattr_bytes_u8", "lsetxattr", "lsetxattr_bytes", "lsetxattr_bytes_u8", "chmod", "chmod_at",
    "truncate", "mknod", "chown_at", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc", "pipe", "set_file_times",
    "read_link", "getcwd", "chdir", "chroot", "setuid", "setgid", "setgroups",
    "umask", "env", "environ", "raw_environ", "getgroups", "stat", "lstat", "statfs", "mounts", "sysctl",
    "access", "fd_fsync", "fd_fdatasync", "fd_syncfs", "fd_drop_cache", "subprocess",
    "signal_send", "set_process_group", "set_priority", "clock_set",
    "open_dir", "dir_open", "dir_entries", "dir_stat", "dir_access", "dir_unlink", "dir_chmod", "dir_chown",
  ]);
}

// Borrow a byte range and reserve once. Packed arrays copy in bulk; the legacy
// array layout contributes the low byte of each eight-byte slot.
function emit_buf_push_bytes_range(s: asmcore.EmitState, packed: boolean): asmcore.EmitState {
  let suffix: string = asmcore.packed_suffix(packed);
  let sym: string = "__fern_buf_push_bytes_range" + suffix;
  let label: string = ".Lbufbyterange" + suffix;
  s = s.write(".globl " + sym + "\n.type " + sym + ", @function\n" + sym + ":\n");
  s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n");
  s = s.write("    movq %rdi, %rbx\n    movq %rsi, %r14\n    movslq %edx, %r12\n    movslq %ecx, %r13\n");
  s = s.write("    xorq %rax, %rax\n    testq %r12, %r12\n    cmovsq %rax, %r12\n    cmpq (%r14), %r13\n    cmovgq (%r14), %r13\n");
  s = s.write("    subq %r12, %r13\n    jle " + label + "_done\n    movq 8(%rbx), %rsi\n    addq %r13, %rsi\n    cmpq 16(%rbx), %rsi\n    jbe " + label + "_fits\n    call __fern_buf_reserve\n" + label + "_fits:\n");
  s = s.write("    movq (%rbx), %rdi\n    addq 8(%rbx), %rdi\n");
  if (packed) {
    s = s.write("    leaq 8(%r14,%r12), %rsi\n    movq %r13, %rdx\n    call __fern_memcpy\n");
  } else {
    s = s.write("    leaq 8(%r14,%r12,8), %rsi\n    movq %r13, %rcx\n" + label + "_copy:\n    movb (%rsi), %al\n    movb %al, (%rdi)\n    addq $8, %rsi\n    incq %rdi\n    decq %rcx\n    jne " + label + "_copy\n");
  }
  s = s.write("    addq %r13, 8(%rbx)\n" + label + "_done:\n    xorl %eax, %eax\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    popq %rbp\n    ret\n.size " + sym + ", .-" + sym + "\n");
  return s;
}

// Copy raw builder storage into a fresh array in the requested layout.
function emit_buf_take_bytes(s: asmcore.EmitState, packed: boolean): asmcore.EmitState {
  let suffix: string = asmcore.packed_suffix(packed);
  let sym: string = "__fern_buf_take_bytes" + suffix;
  let done: string = ".Lbufbytes_done" + suffix;
  let copy_loop: string = ".Lbufbytes_loop" + suffix;
  s = s.write(".globl " + sym + "\n.type " + sym + ", @function\n" + sym + ":\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %rbx\n");
  s = s.write("    pushq %r12\n");
  s = s.write("    pushq %r13\n");
  s = s.write("    pushq %r14\n");
  s = s.write("    movq %rdi, %rbx\n");
  s = s.write("    movq 8(%rbx), %r12\n");
  s = s.write("    movq %r12, %rdi\n");
  if (packed) {
    s = s.write("    addq $7, %rdi\n    shrq $3, %rdi\n");
  }
  s = s.write("    call __fern_arr_box\n    movq %rax, %r13\n    movq %r12, (%r13)\n    movq (%rbx), %rsi\n");
  if (packed) {
    s = s.write("    leaq 8(%r13), %rdi\n    movq %r12, %rdx\n    call __fern_memcpy\n");
  } else {
    s = s.write("    xorq %rcx, %rcx\n" + copy_loop + ":\n    cmpq %r12, %rcx\n    jae " + done + "\n");
    s = s.write("    movzbl (%rsi,%rcx), %eax\n    movq %rax, 8(%r13,%rcx,8)\n    incq %rcx\n    jmp " + copy_loop + "\n" + done + ":\n");
  }
  s = s.write("    movq $0, 8(%rbx)\n    movq %r13, %rax\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    popq %rbp\n    ret\n.size " + sym + ", .-" + sym + "\n");
  return s;
}

// emit_buf_table_helpers emits the three buffer pushes that read a u8[]
// table: a slot table holds entry i in the low byte of the 8-byte slot
// 8 + i*8, a packed one (the `_u8` helpers) at byte 8 + i. An expanded
// table's record c is eight entries from entry c*8 either way.
function emit_buf_table_helpers(s: asmcore.EmitState, packed: boolean, raw: boolean): asmcore.EmitState {
  let sfx: string = asmcore.packed_suffix(packed);
  let prefix: string = "__fern_buf_push_";
  let label: string = "";
  if (raw) {
    prefix = prefix + "bytes_";
    label = "_bytes";
  }
  let source_len: string = "    movq 8(%r12), %r13\n";
  let source_data: string = "    movq (%r12), %rsi\n";
  if (raw) {
    source_len = "    movq (%r12), %r13\n";
    source_data = "    leaq 8(%r12), %rsi\n";
  }
  let lm: string = ".Lbufmap" + label + sfx;
  let lf: string = ".Lbuffilt" + label + sfx;
  let le: string = ".Lbufexp" + label + sfx;
  let srcscale: string = "";
  if (raw && !packed) {
    srcscale = ",8";
  }
  let sc: string = ",8";
  let rshift: string = "6";
  let rbyte: string = "16(%r10,%r8,8), %rax";
  if (packed) {
    sc = "";
    rshift = "3";
    rbyte = "9(%r10,%r8), %rax";
  }
  // __fern_buf_push_mapped(%rdi = H, %rsi = box, %rdx = table): append
  // table[c] for each byte c of the box's data, or c itself when it is
  // past the table's length at (table). Entry i of the table is the low
  // byte of the 8-byte slot 8 + i*8; a table covering every byte value
  // takes the loop with no length check.
  s = s.write(prefix + "mapped" + sfx + ":\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %rbx\n");
  s = s.write("    pushq %r12\n");
  s = s.write("    pushq %r13\n");
  s = s.write("    pushq %r14\n");
  s = s.write("    movq %rdi, %rbx\n");
  s = s.write("    movq %rsi, %r12\n");
  s = s.write("    movq %rdx, %r14\n");  // table
  s = s.write(source_len);  // n
  s = s.write("    testq %r13, %r13\n");
  s = s.write("    jz " + lm + "_done\n");
  s = s.write("    movq 8(%rbx), %rax\n");
  s = s.write("    addq %r13, %rax\n");
  s = s.write("    movq 16(%rbx), %rcx\n");
  s = s.write("    cmpq %rcx, %rax\n");
  s = s.write("    jbe " + lm + "_fits\n");
  s = s.write("    movq %rbx, %rdi\n");
  s = s.write("    movq %rax, %rsi\n");
  s = s.write("    call __fern_buf_reserve\n");
  s = s.write(lm + "_fits:\n");
  s = s.write(source_data);  // src data
  s = s.write("    movq (%rbx), %rdx\n");
  s = s.write("    addq 8(%rbx), %rdx\n");  // dst = data + len
  s = s.write("    movq (%r14), %r9\n");  // table length
  s = s.write("    xorq %rcx, %rcx\n");
  s = s.write("    cmpq $256, %r9\n");
  s = s.write("    jb " + lm + "_short\n");
  s = s.write(lm + "_full:\n");
  s = s.write("    movzbq (%rsi,%rcx" + srcscale + "), %rax\n");
  s = s.write("    movzbq 8(%r14,%rax" + sc + "), %rax\n");
  s = s.write("    movb %al, (%rdx,%rcx)\n");
  s = s.write("    incq %rcx\n");
  s = s.write("    cmpq %r13, %rcx\n");
  s = s.write("    jb " + lm + "_full\n");
  s = s.write("    jmp " + lm + "_len\n");
  s = s.write(lm + "_short:\n");
  s = s.write("    movzbq (%rsi,%rcx" + srcscale + "), %rax\n");
  s = s.write("    cmpq %r9, %rax\n");
  s = s.write("    jae " + lm + "_keep\n");
  s = s.write("    movzbq 8(%r14,%rax" + sc + "), %rax\n");
  s = s.write(lm + "_keep:\n");
  s = s.write("    movb %al, (%rdx,%rcx)\n");
  s = s.write("    incq %rcx\n");
  s = s.write("    cmpq %r13, %rcx\n");
  s = s.write("    jb " + lm + "_short\n");
  s = s.write(lm + "_len:\n");
  s = s.write("    addq %r13, 8(%rbx)\n");
  s = s.write(lm + "_done:\n");
  s = s.write("    popq %r14\n");
  s = s.write("    popq %r13\n");
  s = s.write("    popq %r12\n");
  s = s.write("    popq %rbx\n");
  s = s.write("    popq %rbp\n");
  s = s.write("    ret\n");
  // __fern_buf_push_filtered(%rdi = H, %rsi = box, %rdx = drop): append
  // each byte c of the box's data whose drop entry (the low byte of
  // the 8-byte slot 8 + c*8) is zero, or that is past the table's
  // length at (drop). Room for the whole box is reserved; the full-table
  // loop stores every byte and advances the kept count only past a
  // kept one.
  s = s.write(prefix + "filtered" + sfx + ":\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %rbx\n");
  s = s.write("    pushq %r12\n");
  s = s.write("    pushq %r13\n");
  s = s.write("    pushq %r14\n");
  s = s.write("    movq %rdi, %rbx\n");
  s = s.write("    movq %rsi, %r12\n");
  s = s.write("    movq %rdx, %r14\n");  // drop
  s = s.write(source_len);  // n
  s = s.write("    testq %r13, %r13\n");
  s = s.write("    jz " + lf + "_done\n");
  s = s.write("    movq 8(%rbx), %rax\n");
  s = s.write("    addq %r13, %rax\n");
  s = s.write("    movq 16(%rbx), %rcx\n");
  s = s.write("    cmpq %rcx, %rax\n");
  s = s.write("    jbe " + lf + "_fits\n");
  s = s.write("    movq %rbx, %rdi\n");
  s = s.write("    movq %rax, %rsi\n");
  s = s.write("    call __fern_buf_reserve\n");
  s = s.write(lf + "_fits:\n");
  s = s.write(source_data);  // src data
  s = s.write("    movq (%rbx), %rdx\n");
  s = s.write("    addq 8(%rbx), %rdx\n");  // dst = data + len
  s = s.write("    movq (%r14), %r9\n");  // table length
  s = s.write("    xorq %rcx, %rcx\n");  // i
  s = s.write("    xorq %r8, %r8\n");  // kept
  s = s.write("    cmpq $256, %r9\n");
  s = s.write("    jb " + lf + "_short\n");
  s = s.write(lf + "_full:\n");
  s = s.write("    movzbq (%rsi,%rcx" + srcscale + "), %rax\n");
  s = s.write("    movzbq 8(%r14,%rax" + sc + "), %r10\n");
  s = s.write("    movb %al, (%rdx,%r8)\n");
  s = s.write("    cmpq $1, %r10\n");
  s = s.write("    adcq $0, %r8\n");
  s = s.write("    incq %rcx\n");
  s = s.write("    cmpq %r13, %rcx\n");
  s = s.write("    jb " + lf + "_full\n");
  s = s.write("    jmp " + lf + "_len\n");
  s = s.write(lf + "_short:\n");
  s = s.write("    movzbq (%rsi,%rcx" + srcscale + "), %rax\n");
  s = s.write("    cmpq %r9, %rax\n");
  s = s.write("    jae " + lf + "_keep\n");
  s = s.write("    cmpb $0, 8(%r14,%rax" + sc + ")\n");
  s = s.write("    jne " + lf + "_next\n");
  s = s.write(lf + "_keep:\n");
  s = s.write("    movb %al, (%rdx,%r8)\n");
  s = s.write("    incq %r8\n");
  s = s.write(lf + "_next:\n");
  s = s.write("    incq %rcx\n");
  s = s.write("    cmpq %r13, %rcx\n");
  s = s.write("    jb " + lf + "_short\n");
  s = s.write(lf + "_len:\n");
  s = s.write("    addq %r8, 8(%rbx)\n");
  s = s.write(lf + "_done:\n");
  s = s.write("    popq %r14\n");
  s = s.write("    popq %r13\n");
  s = s.write("    popq %r12\n");
  s = s.write("    popq %rbx\n");
  s = s.write("    popq %rbp\n");
  s = s.write("    ret\n");
  // __fern_buf_push_expanded(%rdi = H, %rsi = box, %rdx = table): append
  // each byte c of the box's data as the record at table[c*8], a length
  // (above 7 counts as 7) and then the bytes, or c itself when its
  // record is not wholly inside the table. Entry i of the table is the
  // low byte of the 8-byte slot 8 + i*8, so byte c's record starts at
  // table + 8 + c*64. A push of 256 bytes or more through a table of
  // every record first packs the records into 2 KiB of frame, then
  // copies each as one eight-byte store, as native's kernel does.
  s = s.write(prefix + "expanded" + sfx + ":\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %rbx\n");
  s = s.write("    pushq %r12\n");
  s = s.write("    pushq %r13\n");
  s = s.write("    pushq %r14\n");
  s = s.write("    movq %rdi, %rbx\n");
  s = s.write("    movq %rsi, %r12\n");
  s = s.write("    movq %rdx, %r14\n");  // table
  s = s.write(source_len);  // n
  s = s.write("    testq %r13, %r13\n");
  s = s.write("    jz " + le + "_done\n");
  s = s.write("    leaq 8(,%r13,8), %rax\n");
  s = s.write("    addq 8(%rbx), %rax\n");  // a whole record stored per byte
  s = s.write("    movq 16(%rbx), %rcx\n");
  s = s.write("    cmpq %rcx, %rax\n");
  s = s.write("    jbe " + le + "_fits\n");
  s = s.write("    movq %rbx, %rdi\n");
  s = s.write("    movq %rax, %rsi\n");
  s = s.write("    call __fern_buf_reserve\n");
  s = s.write(le + "_fits:\n");
  s = s.write(source_data);  // src data
  s = s.write("    movq (%rbx), %rdx\n");
  s = s.write("    addq 8(%rbx), %rdx\n");  // dst = data + len
  s = s.write("    movq (%r14), %r9\n");
  s = s.write("    shrq $3, %r9\n");  // whole records
  s = s.write("    xorq %rcx, %rcx\n");
  s = s.write("    cmpq $256, %r9\n    jb " + le + "_loop\n");
  s = s.write("    cmpq $256, %r13\n    jb " + le + "_loop\n");
  s = s.write("    subq $2048, %rsp\n");
  s = s.write(le + "_pack:\n");
  s = s.write("    movzbq 8(%r14,%rcx" + sc + "), %rax\n    movb %al, (%rsp,%rcx)\n");
  s = s.write("    incq %rcx\n    cmpq $2048, %rcx\n    jb " + le + "_pack\n");
  s = s.write("    xorq %rcx, %rcx\n    movq $7, %r10\n");
  s = s.write(le + "_fast:\n");
  s = s.write("    movzbq (%rsi,%rcx" + srcscale + "), %rax\n    movq (%rsp,%rax,8), %r8\n");
  s = s.write("    movzbq %r8b, %r9\n    cmpq %r10, %r9\n    cmovaq %r10, %r9\n");
  s = s.write("    shrq $8, %r8\n    movq %r8, (%rdx)\n    addq %r9, %rdx\n");
  s = s.write("    incq %rcx\n    cmpq %r13, %rcx\n    jb " + le + "_fast\n");
  s = s.write("    addq $2048, %rsp\n    jmp " + le + "_len\n");
  s = s.write(le + "_loop:\n");
  s = s.write("    cmpq %r13, %rcx\n");
  s = s.write("    jae " + le + "_len\n");
  s = s.write("    movzbq (%rsi,%rcx" + srcscale + "), %rax\n");
  s = s.write("    cmpq %r9, %rax\n");
  s = s.write("    jae " + le + "_keep\n");
  s = s.write("    movq %rax, %r10\n");
  s = s.write("    shlq $" + rshift + ", %r10\n");
  s = s.write("    addq %r14, %r10\n");  // the record's slots, less 8
  s = s.write("    movzbq 8(%r10), %r11\n");  // its length
  s = s.write("    cmpq $7, %r11\n");
  s = s.write("    jbe " + le + "_room\n");
  s = s.write("    movq $7, %r11\n");
  s = s.write(le + "_room:\n");
  s = s.write("    xorq %r8, %r8\n");
  s = s.write(le + "_byte:\n");
  s = s.write("    cmpq %r11, %r8\n");
  s = s.write("    jae " + le + "_next\n");
  s = s.write("    movzbq " + rbyte + "\n");
  s = s.write("    movb %al, (%rdx)\n");
  s = s.write("    incq %rdx\n");
  s = s.write("    incq %r8\n");
  s = s.write("    jmp " + le + "_byte\n");
  s = s.write(le + "_keep:\n");
  s = s.write("    movb %al, (%rdx)\n");
  s = s.write("    incq %rdx\n");
  s = s.write(le + "_next:\n");
  s = s.write("    incq %rcx\n");
  s = s.write("    jmp " + le + "_loop\n");
  s = s.write(le + "_len:\n");
  s = s.write("    subq (%rbx), %rdx\n");  // the new length
  s = s.write("    movq %rdx, 8(%rbx)\n");
  s = s.write(le + "_done:\n");
  s = s.write("    popq %r14\n");
  s = s.write("    popq %r13\n");
  s = s.write("    popq %r12\n");
  s = s.write("    popq %rbx\n");
  s = s.write("    popq %rbp\n");
  s = s.write("    ret\n");
  return s;
}

// emit_runtime_memcpy emits `__fern_memcpy(%rdi = dst, %rsi = src, %rdx = n)`
// for the builders' copies, the same size classes as native's: `rep movsb` is
// nearly all start-up at the few bytes a line push copies. Each class covers
// its range with two overlapping accesses; the regions must not overlap.
// Clobbers %rax, %rsi, %rdi, %r8, %r9, %xmm0 and %xmm1.
function emit_runtime_memcpy(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_memcpy:\n");
  s = s.write("    movq %rdi, %rax\n");
  s = s.write("    cmpq $8, %rdx\n");
  s = s.write("    jb .Lmcp_lt8\n");
  s = s.write("    cmpq $16, %rdx\n");
  s = s.write("    jb .Lmcp_8_15\n");
  s = s.write("    cmpq $32, %rdx\n");
  s = s.write("    jbe .Lmcp_16_32\n");
  s = s.write("    leaq -32(%rdi,%rdx), %r8\n");
  s = s.write("    leaq -32(%rsi,%rdx), %r9\n");
  s = s.write(".Lmcp_bulk:\n");
  s = s.write("    movdqu (%rsi), %xmm0\n");
  s = s.write("    movdqu 16(%rsi), %xmm1\n");
  s = s.write("    movdqu %xmm0, (%rdi)\n");
  s = s.write("    movdqu %xmm1, 16(%rdi)\n");
  s = s.write("    addq $32, %rsi\n");
  s = s.write("    addq $32, %rdi\n");
  s = s.write("    cmpq %r8, %rdi\n");
  s = s.write("    jb .Lmcp_bulk\n");
  s = s.write("    movdqu (%r9), %xmm0\n");
  s = s.write("    movdqu 16(%r9), %xmm1\n");
  s = s.write("    movdqu %xmm0, (%r8)\n");
  s = s.write("    movdqu %xmm1, 16(%r8)\n");
  s = s.write("    ret\n");
  s = s.write(".Lmcp_16_32:\n");
  s = s.write("    movdqu (%rsi), %xmm0\n");
  s = s.write("    movdqu -16(%rsi,%rdx), %xmm1\n");
  s = s.write("    movdqu %xmm0, (%rdi)\n");
  s = s.write("    movdqu %xmm1, -16(%rdi,%rdx)\n");
  s = s.write("    ret\n");
  s = s.write(".Lmcp_8_15:\n");
  s = s.write("    movq (%rsi), %r8\n");
  s = s.write("    movq -8(%rsi,%rdx), %r9\n");
  s = s.write("    movq %r8, (%rdi)\n");
  s = s.write("    movq %r9, -8(%rdi,%rdx)\n");
  s = s.write("    ret\n");
  s = s.write(".Lmcp_lt8:\n");
  s = s.write("    cmpq $4, %rdx\n");
  s = s.write("    jb .Lmcp_lt4\n");
  s = s.write("    movl (%rsi), %r8d\n");
  s = s.write("    movl -4(%rsi,%rdx), %r9d\n");
  s = s.write("    movl %r8d, (%rdi)\n");
  s = s.write("    movl %r9d, -4(%rdi,%rdx)\n");
  s = s.write("    ret\n");
  s = s.write(".Lmcp_lt4:\n");
  s = s.write("    testq %rdx, %rdx\n");
  s = s.write("    je .Lmcp_done\n");
  s = s.write("    movzbq (%rsi), %r8\n");
  s = s.write("    movzbq -1(%rsi,%rdx), %r9\n");
  s = s.write("    movb %r8b, (%rdi)\n");
  s = s.write("    movb %r9b, -1(%rdi,%rdx)\n");
  s = s.write("    cmpq $3, %rdx\n");
  s = s.write("    jb .Lmcp_done\n");
  s = s.write("    movzbq 1(%rsi), %r8\n");
  s = s.write("    movb %r8b, 1(%rdi)\n");
  s = s.write(".Lmcp_done:\n");
  return s.write("    ret\n");
}

// oob_leaf_trap is the array-bounds trap a frameless leaf with n saved
// registers branches to.
function oob_leaf_trap(n: i32): string {
  return "__fern_oob_abort.l" + util.i32_to_string(n);
}

// abort_trap emits the trap `label`: it points %rsi / %rdx at the cause line
// `text` (laid down in .rodata under `msg`) and tail-jumps to __fern_report
// with the exit status in %rdi.
function abort_trap(s: asmcore.EmitState, label: string, msg: string, text: string, status: i32): asmcore.EmitState {
  s = s.write("    .section .rodata\n");
  s = s.write(msg + ":\n    .ascii \"" + text + "\\n\"\n");
  s = s.write("    .section .text\n");
  s = s.write(label + ":\n");
  s = ssa_lea_sym(s, msg, "%rsi");
  s = s.write("    movq $" + util.i32_to_string(text.len() + 1) + ", %rdx\n");
  s = s.write("    movq $" + util.i32_to_string(status) + ", %rdi\n");
  s = s.write("    jmp __fern_report\n");
  return s;
}

// emit_report emits __fern_report(%rsi = cause line, %rdx = its length,
// %rdi = exit status): write(2) the line, then exit with the status — through
// __fern_bt_exit's frame-pointer walk when the build keeps the backtrace,
// which is also where the sanitizer's reports end. The status rides %r15,
// which the walk reads; nothing here returns.
function emit_report(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_report:\n");
  s = s.write("    movq %rdi, %r15\n");
  s = s.write("    movq $2, %rdi\n");
  s = s.write("    movq $1, %rax\n");
  s = s.syscall(1);
  if (s.backtrace) {
    s = s.write("    jmp __fern_bt_exit\n");
    return emit_bt_exit(s);
  }
  s = s.write("    movq %r15, %rdi\n");
  s = s.write("    movq $60, %rax\n");
  return s.syscall(60);
}

function emit_ir_runtime(s: asmcore.EmitState): asmcore.EmitState {
  // .bss: heap bump pointer + arena end, the over-release detector, and the
  // size-classed freelist (65536 classes * 8 bytes). The heap arena itself is
  // mmap'd lazily at runtime (see __fern_alloc below) rather than reserved as
  // a multi-GiB `.bss` block, so the emitted binary makes no assumption about
  // the linker's .bss layout — bfd / lld / mold all work (issue #4081).
  s = s.write("    .section .bss\n");
  s = s.write("    .align 8\n");
  // .globl on the cursor + end pair for the reason spelled out on
  // __fern_arr_push_shared below: __heap_bump_bytes lowers to an INLINE read of
  // BOTH (`movq __fern_heap_ptr(%rip)` / `movq __fern_heap_end(%rip)`, kind_tag
  // 80), never a call through a global accessor, so a file-local symbol is
  // unreachable from any unit but the one holding the runtime.
  s = s.write("    .globl __fern_heap_ptr\n");
  s = s.write("__fern_heap_ptr: .quad 0\n");  // bump cursor (0 until first mmap)
  s = s.write("    .align 8\n");
  s = s.write("    .globl __fern_heap_end\n");
  s = s.write("__fern_heap_end: .quad 0\n");  // arena end (base + heap_size), set at mmap time
  s = s.write("    .align 8\n");
  // arena BASE (the mmap return), set once at first alloc. Bounds the freeable
  // heap range [base, end) so __fern_str_free can free a heap string's data
  // buffer but skip a static string LITERAL's .rodata data pointer (which sits
  // below the arena) — the heap-vs-literal test the header-less asm string box
  // otherwise can't make. Used only by __fern_str_free (#2649 string RC).
  s = s.write("__fern_heap_base: .quad 0\n");
  s = s.write("    .align 8\n");
  if (s.has_need("alloc_count")) {
    // The allocator's call count (#9596), read inline by kind_tag 315 —
    // .globl for the same reason as the cursor pair above, since the read
    // is an inline `movq` from whichever unit asked for it.
    s = s.write("    .globl __fern_alloc_count\n");
    s = s.write("__fern_alloc_count: .quad 0\n");
    s = s.write("    .align 8\n");
  }
  s = s.write("__fern_rc_underflow: .quad 0\n");
  s = s.write("    .align 8\n");
  // core/map's per-process string-hash seed (#6194). Read and filled only
  // by __fern_map_hash_seed, which lives in this same unit, so it needs no
  // .globl (unlike the cliff counter below, which ops read inline).
  s = s.write("__fern_map_seed: .quad 0\n");
  s = s.write("    .align 8\n");
  // The rc==1 append cliff counter (#6023): appends that copied a buffer which
  // still had spare capacity, so the copy was bought by an extra reference
  // rather than a full buffer. Bumped on the un-share path in __fern_arr_push,
  // read by __arr_push_shared_count. 0 on a healthy run.
  //
  // .globl because __arr_push_shared_count lowers to an INLINE read of this
  // word (`movq __fern_arr_push_shared(%rip)`), unlike its sibling
  // __rc_underflow_count which lowers to a CALL to the global
  // __fn___fern_rc_underflow_count that reads its word from inside this same
  // unit. An inline read cannot reach a file-local symbol in another unit, so
  // under -per-module-emit-all — which does no cross-module DCE, and so emits
  // every function whether or not the bundle calls it — a caller landing in
  // any unit but this one failed to link with "undefined reference to
  // __fern_arr_push_shared". Whole-program builds never saw it: one unit, one
  // file, local resolution. See #6058.
  //
  // These two — the cliff counter and the heap cursor/end pair above — are the
  // ONLY .bss words an op lowering reads inline; every other reference
  // (__fern_rc_underflow, __fern_freelist, __fern_envp, __fern_strbuf_*,
  // __fern_heap_base) is emitted inside a runtime helper, which lands in this
  // same unit. That is why __fern_heap_base stays local: only __fern_str_free
  // reads it.
  s = s.write("    .globl __fern_arr_push_shared\n");
  s = s.write("__fern_arr_push_shared: .quad 0\n");
  s = s.write("    .align 8\n");
  // The same crossings WEIGHTED by the bytes they copied (len * 8 — the
  // self-host array model is uniform 8-byte slots), read by
  // __arr_push_shared_bytes. The count says whether the cliff was crossed;
  // this says whether it cost anything, and the two readings differ by three
  // orders of magnitude on real runs. .globl for exactly the reason the
  // counter above is: its reader lowers to an INLINE read of this word, which
  // cannot reach a file-local symbol in another unit under
  // -per-module-emit-all (#6058, #6066).
  s = s.write("    .globl __fern_arr_push_copied\n");
  s = s.write("__fern_arr_push_copied: .quad 0\n");
  s = s.write("    .align 8\n");
  s = s.write("__fern_freelist: .skip 524288\n");
  s = s.write("    .align 8\n");
  // Large-tier segregated freelist (#3425): the 65536-word __fern_freelist above
  // recycles blocks <512 KiB exactly; blocks >=512 KiB previously LEAKED (no class),
  // so a long-running emit that frees big per-function analysis arrays exhausted the
  // arena (exit 137) — the self-host runtime lagging the native two-tier design. This
  // array is the large tier: native's 3-significant-bit capacities (large_class),
  // four classes per power of two from 512 KiB to 1 GiB, so 45 slots suffice
  // (2560 kept). A geometric tier is what lets an accumulator grown in place
  // copy only every ~12.5% of its size (#9077).
  // Each large ALLOC rounds the request up to its class capacity
  // and bumps at THAT — so every block in a class has one capacity and any freed block
  // satisfies any same-class request; each large FREE re-derives the class from the
  // logical size via the same round-up and pushes the block (successor pointer in its
  // first 8 bytes; 0 = empty). >1 GiB is never freelisted (bump/leak only).
  s = s.write("__fern_large_freelist: .skip 20480\n");
  // Shadows for the arena checkpoint (#6728): __heap_mark copies both head
  // tables here, __heap_release_to copies them back. .bss, so they cost image
  // size nothing and are zero-filled — a release with no preceding mark
  // restores all-empty heads, which is a bounded leak rather than corruption.
  s = s.write("    .align 8\n");
  s = s.write("__fern_freelist_shadow: .skip 524288\n");
  s = s.write("    .align 8\n");
  s = s.write("__fern_large_freelist_shadow: .skip 20480\n");
  s = s.write("    .section .text\n");
  // __fern_alloc(%rdi = bytes) -> %rax = block. Size-classed freelist reuse
  // (class = __fern_capw(words) below 65536 words) then bump; OOM traps with
  // exit 125.
  //
  // Under a heap-event build the body becomes __fern_alloc_inner and this is
  // a wrapper around it, so ONE hook covers all three allocation exits (the
  // small-class freelist pop, the large-class pop, and the bump) instead of
  // three hooks at three different live-register states. The wrapper is also
  // where the reported site is naturally correct: [rsp] on entry is the
  // caller's return address, i.e. the code that ASKED for the memory, not
  // the exit path that happened to satisfy it.
  //
  // Callers see the same contract either way — %rax is the block, %rdi is
  // clobbered, everything else preserved (%rsi is saved and restored around
  // the hook; __fern_hev_a itself clobbers nothing).
  //
  // Note the site is the IMMEDIATE caller. Allocations routed through the
  // box shims (__fern_arr_box / __fern_str_box) therefore report the shim,
  // not the code that wanted the box — the same limitation the native hook
  // has, and the reason an `a` line naming a shim needs one gdb frame walk
  // to attribute.
  if (hev_on(s)) {
    s = s.write("__fern_alloc:\n");
    if (s.has_need("alloc_count")) {
      s = s.write("    incq __fern_alloc_count(%rip)\n");
    }
    s = s.write("    pushq %rdi\n");  // requested bytes
    s = s.write("    call __fern_alloc_inner\n");
    s = s.write("    popq %rdi\n");
    s = s.write("    pushq %rsi\n");
    s = s.write("    movq 8(%rsp), %rsi\n");  // site = our caller's return address
    s = s.write("    addq $7, %rdi\n");  // the rounding __fern_alloc_inner applies
    s = s.write("    shrq $3, %rdi\n");  // words
    s = s.write("    pushq %rdi\n");
    s = s.write("    pushq %rax\n");
    s = s.write("    pushq %rsi\n");
    s = s.write("    call __fern_hev_a\n");
    s = s.write("    addq $24, %rsp\n");
    s = s.write("    popq %rsi\n");
    s = s.write("    ret\n");
    s = s.write("__fern_alloc_inner:\n");
  } else {
    s = s.write("__fern_alloc:\n");
    // Ahead of every exit — the two freelist pops and the bump — so a
    // recycled block is counted exactly like a bumped one. Under a
    // heap-event build the wrapper above counts instead, so the inner
    // body must not count again.
    if (s.has_need("alloc_count")) {
      s = s.write("    incq __fern_alloc_count(%rip)\n");
    }
  }
  // A request of at most 256 words is served with %rax and %rdi alone, so it
  // needs no frame and saves nothing: below 257 words a class is its word
  // count, so the rounded byte count indexes the freelist directly and is
  // also the size to bump on a miss. Only the first allocation, before the
  // arena is mapped, takes the full path.
  s = s.write("    addq $7, %rdi\n");
  s = s.write("    andq $-8, %rdi\n");
  s = s.write("    cmpq $2048, %rdi\n");
  s = s.write("    ja .Lalloc_full\n");
  s = s.write("    leaq __fern_freelist(%rip), %rax\n");
  s = s.write("    addq %rax, %rdi\n");
  s = s.write("    movq (%rdi), %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jz .Lalloc_fast_miss\n");
  s = s.write("    pushq (%rax)\n");
  s = s.write("    popq (%rdi)\n");
  s = s.write("    ret\n");
  s = s.write(".Lalloc_fast_miss:\n");
  s = s.write("    leaq __fern_freelist(%rip), %rax\n");
  s = s.write("    subq %rax, %rdi\n");
  s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jz .Lalloc_full\n");
  s = s.write("    addq %rax, %rdi\n");
  s = s.write("    cmpq __fern_heap_end(%rip), %rdi\n");
  s = s.write("    ja .Lalloc_oom\n");
  s = s.write("    movq %rdi, __fern_heap_ptr(%rip)\n");
  s = s.write("    ret\n");
  s = s.write(".Lalloc_full:\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %rcx\n");
  s = s.write("    pushq %rdx\n");
  s = s.write("    movq %rdi, %rcx\n");
  s = s.write("    shrq $3, %rcx\n");
  s = s.write("    cmpq $65536, %rcx\n");
  s = s.write("    jae .Lalloc_large\n");
  // The small tier bumps a block at its class's capacity, so any freed block
  // of the class satisfies any request that rounds to it.
  s = capw_class(s, "%rcx");
  s = s.write("    leaq 0(,%rcx,8), %rdi\n");
  s = s.write("    leaq __fern_freelist(%rip), %rdx\n");
  s = s.write("    movq (%rdx,%rcx,8), %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jz .Lalloc_nofl\n");
  s = s.write("    movq (%rax), %rdi\n");
  s = s.write("    movq %rdi, (%rdx,%rcx,8)\n");
  s = s.write("    popq %rdx\n");
  s = s.write("    popq %rcx\n");
  s = s.write("    popq %rbp\n");
  s = s.write("    ret\n");
  // Large tier (#3425): a >=512 KiB request. Round the byte size UP to its
  // class capacity (large_class) and bump AT it, so every block in a class has
  // one size and any freed block satisfies any same-class request; pop the
  // large freelist, and an empty class falls through to the bump with %rdi =
  // capacity. >1 GiB is bump-only. %rcx/%rdx are already saved.
  s = s.write(".Lalloc_large:\n");
  s = s.write("    cmpq $0x40000000, %rdi\n");  // > 1 GiB: bump exact, no freelist
  s = s.write("    ja .Lalloc_nofl\n");
  s = s.write("    movq %rdi, %rax\n");
  s = large_class(s);
  s = s.write("    movq %rax, %rdi\n");  // %rdi = cap = bytes to bump
  s = s.write("    movq %rdx, %rax\n");  // class
  s = s.write("    leaq __fern_large_freelist(%rip), %rdx\n");
  s = s.write("    movq (%rdx,%rax,8), %rcx\n");  // head
  s = s.write("    testq %rcx, %rcx\n");
  s = s.write("    jz .Lalloc_nofl\n");  // empty class: bump at cap (%rdi)
  s = s.write("    movq (%rcx), %rdi\n");  // head.next
  s = s.write("    movq %rdi, (%rdx,%rax,8)\n");  // heads[class] = next
  s = s.write("    movq %rcx, %rax\n");  // return reused block
  s = s.write("    popq %rdx\n");
  s = s.write("    popq %rcx\n");
  s = s.write("    popq %rbp\n");
  s = s.write("    ret\n");
  s = s.write(".Lalloc_nofl:\n");
  s = s.write("    popq %rdx\n");
  s = s.write("    popq %rcx\n");
  s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jne .Lalloc_inited\n");
  // First allocation: lazily mmap the arena at hint 0x10000000
  // (MAP_PRIVATE | MAP_ANONYMOUS, R+W). Runs once. The kernel hands back
  // the base, so the heap address is NOT derived from the linker's .bss
  // layout (issue #4081). %rdi (rounded size) is live; every register but
  // %rax/%rdi (the clobber contract) is saved across the syscall.
  s = s.write("    pushq %rdi\n");
  s = s.write("    pushq %rsi\n");
  s = s.write("    pushq %rcx\n");
  s = s.write("    pushq %rdx\n");
  s = s.write("    pushq %r8\n");
  s = s.write("    pushq %r9\n");
  s = s.write("    pushq %r10\n");
  s = s.write("    pushq %r11\n");
  s = s.write("    movl $0x10000000, %edi\n");  // addr hint
  s = s.write("    movabs $17179869184, %rsi\n");  // length = 0x400000000, 16 GiB (64-bit imm; lockstep with asm_arm64_ir.fern + native x86-64)
  s = s.write("    movl $3, %edx\n");  // PROT_READ | PROT_WRITE
  s = s.write("    movl $0x4022, %r10d\n");  // MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE (exempt from overcommit accounting; lockstep with asm.fern + the native x86-64 backend)
  s = s.write("    movq $-1, %r8\n");  // fd
  s = s.write("    xorl %r9d, %r9d\n");  // offset
  s = s.write("    movl $9, %eax\n");  // __NR_mmap
  s = s.syscall(9);
  s = s.write("    cmpq $0, %rax\n");  // mmap returns -errno on failure
  s = s.write("    jl .Lalloc_oom\n");
  s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
  s = s.write("    movq %rax, __fern_heap_base(%rip)\n");  // record arena base (freeable-range lower bound)
  s = s.write("    movabs $17179869184, %rcx\n");  // heap_size (64-bit imm)
  s = s.write("    addq %rax, %rcx\n");  // %rcx = base + heap_size (END)
  s = s.write("    movq %rcx, __fern_heap_end(%rip)\n");
  s = s.write("    popq %r11\n");
  s = s.write("    popq %r10\n");
  s = s.write("    popq %r9\n");
  s = s.write("    popq %r8\n");
  s = s.write("    popq %rdx\n");
  s = s.write("    popq %rcx\n");
  s = s.write("    popq %rsi\n");
  s = s.write("    popq %rdi\n");
  s = s.write(".Lalloc_inited:\n");
  s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
  s = s.write("    addq %rax, %rdi\n");
  s = s.write("    cmpq __fern_heap_end(%rip), %rdi\n");  // arena end recorded at mmap time
  s = s.write("    ja .Lalloc_oom\n");
  s = s.write("    movq %rdi, __fern_heap_ptr(%rip)\n");
  s = s.write("    popq %rbp\n");
  s = s.write("    ret\n");
  // 125, not 137: 137 is 128+9, what a shell reports for SIGKILL, so an arena
  // trap could not be told apart from the kernel OOM-killer. Opposite causes,
  // opposite fixes. Lockstep with the native backends' ExitArenaExhausted.
  s = abort_trap(s, ".Lalloc_oom", ".Lmsg_oom", asmcore.msg_oom(), 125);
  // The fatal aborts (#5538, #11405): each trap names its cause and
  // tail-jumps to __fern_report, so a per-access check stays a compare + a
  // jae to a shared label. __fern_oob_abort is arr_get / arr_set,
  // __fern_str_oob_abort the inline str_slice view, __fern_slice_abort the
  // __fern_arr_slice bodies' range check, __fern_alloc_size_abort a
  // raw_alloc or __alloc_u8 size that is negative as an i32, which is how a
  // helper's `la + lb` looks once it wraps past 2 GiB. Texts and statuses
  // match the native backends'.
  s = abort_trap(s, "__fern_oob_abort", ".Lmsg_arr_oob", asmcore.msg_arr_oob(), 134);
  // A leaf with no frame (ssa_needs_frame) traps with %rbp still its caller's
  // frame and its own return address at 8 * n(%rsp), above the n callee-saved
  // registers it pushed, so the walk would start a frame too far out and lose
  // the caller. Its trap goes through the stub for its n, which builds the
  // frame the leaf did not: the return address copied under a fresh %rbp link.
  let n: i32 = 0;
  while (n <= ssa_nsaved()) {
    s = s.write(oob_leaf_trap(n) + ":\n");
    s = s.write("    pushq " + util.i32_to_string(8 * n) + "(%rsp)\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    jmp __fern_oob_abort\n");
    n = n + 1;
  }
  s = abort_trap(s, "__fern_str_oob_abort", ".Lmsg_str_oob", asmcore.msg_str_oob(), 134);
  s = abort_trap(s, "__fern_slice_abort", ".Lmsg_slice", asmcore.msg_slice_range(), 134);
  s = abort_trap(s, "__fern_alloc_size_abort", ".Lmsg_alloc_size", asmcore.msg_alloc_size(), 134);
  // __fern_arr_box(%rdi = cap element count) -> %rax = data ptr (base+16).
  // base = [cap, rc=1, len=cap, e0..]; element i at data+(i+1)*8.
  s = s.write("__fern_arr_box:\n");
  s = hev_shim_site(s, "arrbox");
  // __fern_alloc clobbers only %rax and %rdi, so the capacity rides the stack
  // across it, and that one push aligns the call. A traced build keeps the
  // frame: it names allocation sites by the frame chain.
  if (hev_on(s)) {
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
  }
  s = s.write("    pushq %rdi\n");
  s = s.write("    addq $3, %rdi\n");
  s = s.write("    shlq $3, %rdi\n");
  s = s.write("    call __fern_alloc\n");
  s = s.write("    popq %rdi\n");
  s = s.write("    movq %rdi, (%rax)\n");
  s = s.write("    movq $1, 8(%rax)\n");
  s = s.write("    movq %rdi, 16(%rax)\n");
  s = s.write("    addq $16, %rax\n");
  if (hev_on(s)) {
    s = s.write("    leave\n");
  }
  s = s.write("    ret\n");
  // __fn___fern_struct_copy(%rdi = src box data, %rsi = nf) -> %rax = fresh box that is
  // a shallow word-for-word copy of src (shape@0 + nf field slots). Allocates via
  // __fern_arr_box(cap = nf+1) so the copy has a fresh rc=1 header + the same free
  // size, byte-identical to struct_make's box; then copies nf+1 words src -> dst
  // (field pointers shared, matching the inline base-copy path). The compact base
  // copy of `T { ...base, f: v }` (#4650): one call instead of nf struct_get/store.
  s = s.write("__fn___fern_struct_copy:\n");
  s = hev_shim_site(s, "scopy");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %rdi\n");  // save src            [-8(%rbp)]
  s = s.write("    pushq %rsi\n");  // save nf             [-16(%rbp)]
  s = s.write("    leaq 1(%rsi), %rdi\n");  // cap = nf+1 words
  s = s.write("    call __fern_arr_box\n");  // %rax = dst data (rc=1)
  s = s.write("    movq -8(%rbp), %rsi\n");  // src
  s = s.write("    movq -16(%rbp), %rcx\n");  // nf
  s = s.write("    incq %rcx\n");  // nf+1 words (shape + fields)
  s = s.write("    xorq %rdx, %rdx\n");  // i = 0
  s = s.write(".Lfern_scp_loop:\n");
  s = s.write("    cmpq %rcx, %rdx\n");
  s = s.write("    jge .Lfern_scp_done\n");
  s = s.write("    movq (%rsi,%rdx,8), %r8\n");
  s = s.write("    movq %r8, (%rax,%rdx,8)\n");
  s = s.write("    incq %rdx\n");
  s = s.write("    jmp .Lfern_scp_loop\n");
  s = s.write(".Lfern_scp_done:\n");
  s = s.write("    leave\n");
  s = s.write("    ret\n");
  // __fern_str_box(%rdi = data ptr, %rsi = len) -> %rax = box (rc-HEADERED, #2649
  // Option A). Block = [rc=1@base, fused=0@base+4, data@base+8, len@base+16]
  // (24 bytes, freelist class 3); box = base+8, so data@box+0 / len@box+8
  // (byte-identical to the old raw-16 layout, so every string CONSUMER —
  // len/index/slice/concat/eq — is unchanged) and rc@box-8 uses the SAME rc word
  // as arrays (__fern_rc_inc / __fn___fern_rc_is_unique read -8(ptr)). Freed by the
  // rc-aware __fern_str_free at rc==1.
  //
  // This is the SEPARATE-BUFFER form, for data the box does not own the block of:
  // argv entries, the strbuf drain, the subprocess pipe buffers. Data that came
  // from __raw_alloc goes through __fern_str_box_hdr instead and costs no second
  // allocation; the `fused` word at base+4 (zeroed here by the 8-byte rc store) is
  // what tells __fern_str_free the two apart.
  s = s.write("__fern_str_box:\n");
  s = hev_shim_site(s, "strbox");
  s = s.write("    pushq %rsi\n");  // save len
  s = s.write("    pushq %rdi\n");  // save data (alloc consumes %rdi)
  s = s.write("    movq $24, %rdi\n");
  s = s.write("    call __fern_alloc\n");  // %rax = base
  s = s.write("    movq $1, (%rax)\n");  // rc = 1 @ base, fused = 0 @ base+4
  s = s.write("    popq %rdi\n");  // data
  s = s.write("    popq %rsi\n");  // len
  s = s.write("    movq %rdi, 8(%rax)\n");  // data @ base+8
  s = s.write("    movq %rsi, 16(%rax)\n");  // len  @ base+16
  s = s.write("    addq $8, %rax\n");  // box = base+8
  s = s.write("    ret\n");
  // __fern_str_box_hdr(%rdi = data ptr, %rsi = len) -> %rax = box — the FUSED
  // form (#7351). `data` is a __raw_alloc pointer, which reserves 24 bytes ahead
  // of itself for exactly this box, so the whole string is ONE block: rc and the
  // fused marker at data-24, data/len where every consumer already reads them,
  // box = data-16. Allocates nothing, so it needs no hev site and no leakcheck
  // event — the one __raw_alloc already accounted for the block. `fused = 1` is
  // what tells __fern_str_free to return that single 24+len block.
  s = s.write("__fern_str_box_hdr:\n");
  s = s.write("    leaq -24(%rdi), %rax\n");  // base = data - 24
  s = s.write("    movl $1, (%rax)\n");  // rc = 1 @ base
  s = s.write("    movl $" + util.i32_to_string(fused_marker()) + ", 4(%rax)\n");  // fused marker @ base+4
  s = s.write("    movq %rdi, 8(%rax)\n");  // data @ base+8
  s = s.write("    movq %rsi, 16(%rax)\n");  // len  @ base+16
  s = s.write("    addq $8, %rax\n");  // box = base+8 = data-16
  s = s.write("    ret\n");
  // RC helpers — stack-arg ABI (arg at 8(%rsp)); rc is the 32-bit field at
  // data-8. Guard chain: SSO inline tag / low-address (null included) /
  // static sentinel. __fn___fern_arr_dec frees (size-class freelist) at rc==1.
  s = s.write("__fn___fern_rc_inc:\n");
  s = s.write("    movq 8(%rsp), %rax\n");
  s = s.write("    testb $1, %al\n");
  s = s.write("    jnz .Lshrcinc_ret\n");
  s = s.write("    cmpq $0x10000, %rax\n");
  s = s.write("    jb .Lshrcinc_ret\n");
  // Byte views retain the untagged descriptor but return their original value.
  s = s.write("    andq $-3, %rax\n");
  s = s.write("    movl -8(%rax), %ecx\n");
  s = s.write(san_poison_check("%ecx", s.rc_free_debug));
  s = s.write("    testl %ecx, %ecx\n");
  s = s.write("    js .Lshrcinc_ret\n");
  s = s.write("    addl $1, %ecx\n");
  s = s.write("    movl %ecx, -8(%rax)\n");
  s = s.write(".Lshrcinc_ret:\n");
  s = s.write("    movq 8(%rsp), %rax\n");
  s = s.write("    ret\n");
  s = s.write("__fn___fern_rc_underflow_count:\n");
  s = s.write("    movl __fern_rc_underflow(%rip), %eax\n");
  s = s.write("    ret\n");
  // __fern_large_push(base = %r8, bytes = %rsi): return a freed >=512 KiB block
  // to the large tier (#3425). Bins by the same large_class round-up
  // __fern_alloc's .Lalloc_large uses (so the block returns to the class whose
  // capacity it was bumped at) and pushes it (successor pointer in its first 8
  // bytes). >1 GiB is dropped (never freelisted, matching alloc). Clobbers
  // %rax/%rcx/%rdx/%rsi, preserves %r8 — a subset of every caller free-site's
  // documented scratch set, so a large-block free site sets %r8=base, %rsi=bytes
  // and CALLs it in place of its former leak. Leaf (integer-only), so callers need
  // no stack realignment.
  s = s.write("__fern_large_push:\n");
  s = s.write("    cmpq $0x40000000, %rsi\n");  // > 1 GiB: drop (leak, matches alloc)
  s = s.write("    ja .Llpush_ret\n");
  // The large tier's single choke point, so one hook covers every >=512 KiB
  // free — the small-tier sites above all `jae` here. Placed AFTER the >1 GiB
  // test on purpose: that block is dropped rather than recycled, so it is a
  // leak, not a free, and counting it would hide exactly the thing leakcheck
  // exists to show. %rax is inside this helper's documented clobber set.
  if (hev_on(s)) {
    s = s.write("    movq %rsi, %rax\n");
    s = s.write("    shrq $3, %rax\n");  // words
    s = s.write("    pushq %rax\n");
    s = s.write("    pushq %r8\n");
    s = s.write("    call __fern_hev_f\n");
    s = s.write("    addq $16, %rsp\n");
  }
  // Quarantine (rc_free_debug_on): the large tier's single choke point —
  // one decline covers every >=512 KiB free. Callers with an rc word have
  // already poisoned it at their own rc store.
  if (!s.rc_free_debug) {
    s = s.write("    movq %rsi, %rax\n");
    s = large_class(s);
    s = s.write("    movq %rdx, %rax\n");  // class
    s = s.write("    leaq __fern_large_freelist(%rip), %rdx\n");
    s = s.write("    movq (%rdx,%rax,8), %rcx\n");  // old head
    s = s.write("    movq %rcx, (%r8)\n");  // *base = old head
    s = s.write("    movq %r8, (%rdx,%rax,8)\n");  // heads[class] = base
  }
  s = s.write(".Llpush_ret:\n");
  s = s.write("    ret\n");
  // __fern_capw(words) -> class, in place in its one stack slot: the small
  // tier's size class for a block of `words` 8-byte words, which is also the
  // capacity __fern_alloc bumps the block at. Exact up to 256 words (2 KiB),
  // which the callers test for inline before calling, then native's
  // 3-significant-bit capacities, so a buffer that grows a little at a time
  // finds the block it just freed rather than a new class per step. Clamped
  // below 65536, where the large tier takes over. Preserves
  // every register.
  s = s.write("__fern_capw:\n");
  s = s.write("    pushq %rax\n");
  s = s.write("    pushq %rcx\n");
  s = s.write("    pushq %rdx\n");
  s = s.write("    movq 32(%rsp), %rax\n");
  s = s.write("    cmpq $256, %rax\n");
  s = s.write("    jbe .Lcapw_ret\n");
  s = s.write("    bsrq %rax, %rcx\n");
  s = s.write("    subl $2, %ecx\n");
  s = s.write("    movl $1, %edx\n");
  s = s.write("    shlq %cl, %rdx\n");  // granule = 1 << (msb - 2)
  s = s.write("    leaq -1(%rax,%rdx), %rax\n");
  s = s.write("    negq %rdx\n");
  s = s.write("    andq %rdx, %rax\n");  // round up to the granule
  s = s.write("    cmpq $65536, %rax\n");
  s = s.write("    jb .Lcapw_store\n");
  s = s.write("    movl $65535, %eax\n");
  s = s.write(".Lcapw_store:\n");
  s = s.write("    movq %rax, 32(%rsp)\n");
  s = s.write(".Lcapw_ret:\n");
  s = s.write("    popq %rdx\n");
  s = s.write("    popq %rcx\n");
  s = s.write("    popq %rax\n");
  s = s.write("    ret\n");
  // __fern_raw_free(%rdi = block, %rsi = bytes) — the return path for a block
  // `__fern_alloc` handed out raw, with no rc header: core/map's buffers, and
  // whatever else reaches the `__free` builtin. The block's own first word is
  // the freelist link, so a block too small to hold one is dropped, exactly as
  // the allocator's classing assumes. Same two tiers as __fern_alloc, so a
  // freed block satisfies the next request of its class.
  s = s.write("__fern_raw_free:\n");
  s = s.write("    testq %rdi, %rdi\n");
  s = s.write("    jz .Lrawfree_ret\n");
  s = s.write("    addq $7, %rsi\n");
  s = s.write("    andq $-8, %rsi\n");
  s = s.write("    cmpq $8, %rsi\n");
  s = s.write("    jb .Lrawfree_ret\n");
  // Under the quarantine the block's first word takes the poison: it is the
  // rc word of a box freed through __fern_box_free, which a second release
  // then reads as a use-after-free.
  if (s.rc_free_debug) {
    s = s.write(quarantine_rc("(%rdi)", s.rc_free_debug));
  }
  s = s.write("    movq %rsi, %rcx\n");
  s = s.write("    shrq $3, %rcx\n");
  s = s.write("    cmpq $65536, %rcx\n");
  s = s.write("    jae .Lrawfree_large\n");
  s = hev_free(s, "%rdi", "%rcx");
  // Quarantine: with the detector on nothing is recycled, so a freed block
  // cannot come back under a fresh allocation and overwrite the evidence.
  if (!s.rc_free_debug) {
    s = freelist_push(s, "%rdi", "%rcx", "%rdx");
  }
  s = s.write(".Lrawfree_ret:\n");
  s = s.write("    ret\n");
  s = s.write(".Lrawfree_large:\n");
  s = s.write("    movq %rdi, %r8\n");
  s = s.write("    call __fern_large_push\n");
  s = s.write("    ret\n");
  s = s.write("__fn___fern_arr_dec:\n");
  s = s.write("    movq 8(%rsp), %rax\n");
  s = s.write("__fn___fern_arr_dec.r:\n");
  s = s.write("    cmpq $0x10000, %rax\n");
  s = s.write("    jb .Larrdec_ret\n");
  s = s.write("    movl -8(%rax), %ecx\n");
  s = s.write(san_poison_check("%ecx", s.rc_free_debug));
  s = s.write("    testl %ecx, %ecx\n");
  s = s.write("    js .Larrdec_ret\n");
  s = s.write("    cmpl $1, %ecx\n");
  s = s.write("    je .Larrdec_free\n");
  s = s.write("    jg .Larrdec_dec\n");
  s = s.write("    incl __fern_rc_underflow(%rip)\n");
  s = s.write(san_underflow_abort(s));
  s = s.write("    jmp .Larrdec_ret\n");
  s = s.write(".Larrdec_dec:\n");
  s = s.write("    subl $1, %ecx\n");
  s = s.write("    movl %ecx, -8(%rax)\n");
  s = s.write("    jmp .Larrdec_ret\n");
  s = s.write(".Larrdec_free:\n");
  s = s.write(quarantine_rc("-8(%rax)", s.rc_free_debug));
  s = s.write("    movl -16(%rax), %ecx\n");
  s = s.write("    addq $3, %rcx\n");
  s = s.write("    cmpq $65536, %rcx\n");
  s = s.write("    jae .Larrdec_large\n");
  s = s.write("    leaq -16(%rax), %rdx\n");
  s = hev_free(s, "%rdx", "%rcx");
  if (!s.rc_free_debug) {
    s = freelist_push(s, "%rdx", "%rcx", "%rdi");
  }
  s = s.write(".Larrdec_ret:\n");
  s = s.write("    ret\n");
  // Large tier (#3425): return the >=512 KiB array block (base = arr-16, bytes =
  // words*8) to the large freelist instead of leaking it.
  s = s.write(".Larrdec_large:\n");
  s = s.write("    leaq -16(%rax), %r8\n");  // base = arr-16
  s = s.write("    leaq 0(,%rcx,8), %rsi\n");  // bytes = words*8
  s = s.write("    call __fern_large_push\n");
  s = s.write("    ret\n");
  // __fern_str_free(box) — RC-AWARE release of a HEAP string box (#2649
  // Option A rc-headered string). A self-host heap string is the 24-byte
  // block __fern_str_box builds: {rc@base, data@base+8, len@base+16}, with
  // box = base+8 (so box[0]=data, box[8]=len, box-8=rc). This helper is the
  // per-element step of __fern_str_arr_free and the rc-aware analogue of
  // __fern_arr_dec: rc<0 = immortal/literal (skip), rc>1 = shared (dec, keep),
  // rc==1 = sole owner (free the data buffer at size-class ceil(len/8) words
  // AND the 24-byte box at class 3), rc==0 = double free (underflow counter,
  // no heap corruption). So it is SAFE to call on any string box — including a
  // map column element that other owners still reference (it only decs) — not
  // just a compile-time-proven-unique temp. A literal's data lives below
  // heap_base and is guarded out of the data-buffer free; len==0 / large-tier
  // buffers leak (sound). Stack-arg ABI (box at 8(%rsp)), or the register entry `.r` with the box in %rax; scratch
  // %rcx/%rdx/%rsi/%r8. (The former "header-less, no rc word, unique-only"
  // contract described the pre-#2649 layout and was stale — the code below
  // reads/decrements rc at box-8 and matches __fern_str_box's 24-byte block.)
  s = s.write("__fn___fern_str_free:\n");
  s = s.write("    movq 8(%rsp), %rax\n");  // box
  s = s.write("__fn___fern_str_free.r:\n");
  s = s.write("    testb $1, %al\n");  // tagged / SSO sentinel (defensive)
  s = s.write("    jnz .Lstrfree_ret\n");
  s = s.write("    cmpq $0x10000, %rax\n");  // low-addr guard
  s = s.write("    jb .Lstrfree_ret\n");
  // rc word @ box-8 (#2649 Option A rc-headered string box): a negative rc is the
  // immortal/sentinel marker (skip); rc>1 decrements without freeing (the box is
  // still shared — once inc-on-alias is wired in A2, an aliased string survives);
  // rc==1 frees the box and any owned data; rc==0 is a double-free, caught by the
  // underflow counter (matching __fn___fern_arr_dec) rather than corrupting the heap.
  s = s.write("    movl -8(%rax), %ecx\n");  // rc
  s = s.write(san_poison_check("%ecx", s.rc_free_debug));
  s = s.write("    testl %ecx, %ecx\n");
  s = s.write("    js .Lstrfree_ret\n");  // negative = immortal -> skip
  s = s.write("    cmpl $1, %ecx\n");
  s = s.write("    jg .Lstrfree_dec\n");  // rc>1 -> dec, keep
  s = s.write("    jl .Lstrfree_uf\n");  // rc==0 -> underflow (double free)
  // rc==1, FUSED box (#7351): data lives inside this block, so there is one
  // 24+len-byte allocation to return, not a box and a buffer.
  s = s.write("    movl -4(%rax), %edx\n");  // fused marker @ box-4
  s = s.write("    cmpl $" + util.i32_to_string(fused_marker()) + ", %edx\n");
  s = s.write("    je .Lstrfree_fused\n");
  s = s.write("    cmpl $" + util.i32_to_string(borrowed_marker()) + ", %edx\n");
  s = s.write("    je .Lstrfree_box\n");
  // rc==1: sole owner -> free data buffer (heap-guarded) then the 24-byte box.
  s = s.write("    movq (%rax), %rcx\n");  // data = box[0]
  s = s.write("    movq 8(%rax), %rdx\n");  // len  = box[8]
  // Free the data buffer ONLY when it is a heap allocation, i.e. in
  // [__fern_heap_base, __fern_heap_end). A string LITERAL's data points into
  // .rodata (below the arena), so this skips it — freeing it would push a
  // read-only address onto the freelist and fault when written as a node. This
  // is the heap-vs-literal test that lets the accumulator's initial "" literal
  // pass through __fern_str_free harmlessly (its box is still freed).
  s = s.write("    movq __fern_heap_base(%rip), %rsi\n");
  s = s.write("    cmpq %rsi, %rcx\n");  // data < heap_base -> literal/.rodata, skip
  s = s.write("    jb .Lstrfree_box\n");
  s = s.write("    cmpq __fern_heap_end(%rip), %rcx\n");  // data >= heap_end -> not our arena, skip
  s = s.write("    jae .Lstrfree_box\n");
  s = s.write("    testq %rdx, %rdx\n");  // len <= 0 -> skip buffer free (leak, sound)
  s = s.write("    jle .Lstrfree_box\n");
  s = s.write("    addq $7, %rdx\n");  // words = ceil(len/8)
  s = s.write("    shrq $3, %rdx\n");
  s = s.write("    cmpq $65536, %rdx\n");  // large tier -> recycle via __fern_large_push
  s = s.write("    jae .Lstrfree_large\n");
  s = hev_free(s, "%rcx", "%rdx");
  // Quarantine (rc_free_debug_on): the DATA buffer carries no rc word, so
  // declining the push is the whole treatment for it.
  if (!s.rc_free_debug) {
    s = freelist_push(s, "%rcx", "%rdx", "%rsi");
  }
  s = s.write(".Lstrfree_box:\n");
  // The rc-headered block is base = box-8 (24 bytes = class 3). The rc store
  // (0, or the quarantine poison) lands before the push so a re-free reads a
  // dead count, then base goes onto freelist[3].
  s = s.write(quarantine_rc("-8(%rax)", s.rc_free_debug));
  s = s.write("    leaq -8(%rax), %rdx\n");  // base = box-8
  s = hev_free(s, "%rdx", "$3");
  if (!s.rc_free_debug) {
    s = s.write("    leaq __fern_freelist(%rip), %r8\n");
    s = s.write("    movq 24(%r8), %rsi\n");  // freelist[3] (24-byte block = 3 words)
    s = s.write("    movq %rsi, (%rdx)\n");  // *base = old head
    s = s.write("    movq %rdx, 24(%r8)\n");  // freelist[3] = base
  }
  s = s.write("    jmp .Lstrfree_ret\n");
  // Large tier (#3425): recycle the >=512 KiB string DATA buffer (%rcx = data,
  // %rdx = words) instead of leaking, then continue to free the 24-byte box. %rax
  // (box) is preserved across the call — __fern_large_push clobbers it.
  s = s.write(".Lstrfree_large:\n");
  s = s.write("    movq %rcx, %r8\n");  // base = data
  s = s.write("    leaq 0(,%rdx,8), %rsi\n");  // bytes = words*8
  s = s.write("    pushq %rax\n");  // preserve box across the call
  s = s.write("    call __fern_large_push\n");
  s = s.write("    popq %rax\n");
  s = s.write("    jmp .Lstrfree_box\n");
  // Fused block (#7351): base = box-8 = data-24, size = the 24-byte header plus
  // the buffer, so class = 3 + ceil(len/8) words. len is the LOGICAL length; a
  // producer that over-allocated hands the freelist a block bigger than the class it lands in, which wastes the
  // slack but never overruns — the same trade the separate-buffer path above has
  // always made when it freed at ceil(len/8).
  s = s.write(".Lstrfree_fused:\n");
  s = s.write("    movq 8(%rax), %rdx\n");  // len = box[8]
  s = s.write("    addq $7, %rdx\n");  // words = ceil(len/8) + 3
  s = s.write("    shrq $3, %rdx\n");
  s = s.write("    addq $3, %rdx\n");
  s = s.write("    leaq -8(%rax), %rcx\n");  // base = box-8
  s = s.write("    cmpq $65536, %rdx\n");  // large tier -> __fern_large_push
  s = s.write("    jae .Lstrfree_fused_large\n");
  s = s.write(quarantine_rc("-8(%rax)", s.rc_free_debug));
  s = hev_free(s, "%rcx", "%rdx");
  if (!s.rc_free_debug) {
    s = freelist_push(s, "%rcx", "%rdx", "%rsi");
  }
  s = s.write("    jmp .Lstrfree_ret\n");
  // The large tier's own free hook lives inside __fern_large_push, so this arm
  // must NOT emit its own — .Lstrfree_large above is silent for the same reason.
  s = s.write(".Lstrfree_fused_large:\n");
  s = s.write(quarantine_rc("-8(%rax)", s.rc_free_debug));
  s = s.write("    movq %rcx, %r8\n");  // base
  s = s.write("    leaq 0(,%rdx,8), %rsi\n");  // bytes = words*8
  s = s.write("    call __fern_large_push\n");
  s = s.write("    jmp .Lstrfree_ret\n");
  s = s.write(".Lstrfree_dec:\n");
  s = s.write("    subl $1, %ecx\n");
  s = s.write("    movl %ecx, -8(%rax)\n");
  s = s.write("    jmp .Lstrfree_ret\n");
  s = s.write(".Lstrfree_uf:\n");
  s = s.write("    incl __fern_rc_underflow(%rip)\n");
  s = s.write(san_underflow_abort(s));
  s = s.write(".Lstrfree_ret:\n");
  s = s.write("    ret\n");
  // __fern_str_view_free releases counted strings and borrowed-data boxes
  // through str_free. It also accepts legacy immortal heap view descriptors:
  // those release the box alone, once its sole holder has finished reading.
  //
  // The heap-range guard on the BOX BASE is what makes the sentinel an exact
  // test for a view: the other immortal producers are the frame form of this
  // same op (a box in the caller's stack frame) and emit_const_agg_data's
  // `.data` blocks, neither of which is in the arena.
  s = s.write("__fn___fern_str_view_free:\n");
  s = s.write("    movq 8(%rsp), %rax\n");  // box
  s = s.write("    testb $1, %al\n");  // tagged / SSO sentinel (defensive)
  s = s.write("    jnz .Lstrvfree_ret\n");
  s = s.write("    cmpq $0x10000, %rax\n");  // low-addr guard
  s = s.write("    jb .Lstrvfree_ret\n");
  s = s.write("    movl -8(%rax), %ecx\n");  // rc
  s = s.write("    testl %ecx, %ecx\n");
  s = s.write("    js .Lstrvfree_view\n");  // negative = immortal -> the view case
  s = s.write("    jmp __fn___fern_str_free\n");  // otherwise: the ordinary rc-aware release
  s = s.write(".Lstrvfree_view:\n");
  s = s.write("    leaq -8(%rax), %rdx\n");  // base = box-8
  s = s.write("    movq __fern_heap_base(%rip), %rsi\n");
  s = s.write("    cmpq %rsi, %rdx\n");  // base < heap_base -> frame / .data box, skip
  s = s.write("    jb .Lstrvfree_ret\n");
  s = s.write("    cmpq __fern_heap_end(%rip), %rdx\n");
  s = s.write("    jae .Lstrvfree_ret\n");  // base >= heap_end -> not our arena, skip
  s = s.write(quarantine_rc("-8(%rax)", s.rc_free_debug));
  s = hev_free(s, "%rdx", "$3");
  if (!s.rc_free_debug) {
    s = s.write("    leaq __fern_freelist(%rip), %r8\n");
    s = s.write("    movq 24(%r8), %rsi\n");  // freelist[3] (24-byte block = 3 words)
    s = s.write("    movq %rsi, (%rdx)\n");  // *base = old head
    s = s.write("    movq %rdx, 24(%r8)\n");  // freelist[3] = base
  }
  s = s.write(".Lstrvfree_ret:\n");
  s = s.write("    ret\n");
  // __fern_str_arr_free(arr) — string[] ELEMENT reclaim (#4355), the
  // element-walking sibling of __fn___fern_arr_dec. rc word at [arr-8]:
  // negative = immortal (skip); rc>1 = shared -> dec, elements untouched
  // (they live on through the other owner); rc==0 = double free -> underflow
  // detector; rc==1 = sole owner -> __fn___fern_str_free every element box
  // (each fully rc-guarded: a shared element decs, a literal's .rodata data
  // is heap-guard-skipped, an immortal view is skipped, a null slot is a
  // no-op) then return the buffer to its size-class freelist exactly as
  // __fn___fern_arr_dec's free path does (base = arr-16, class = cap+3).
  // Array layout (__fern_arr_box): cap@[arr-16], rc@[arr-8], len@[arr],
  // element i @ [arr+8+i*8]. Called ONLY on compile-time-proven fresh,
  // non-escaping string[] locals with fresh/static elements.
  // Stack-arg ABI (arr at 8(%rsp));
  // %rbx/%r12/%r13 (callee-saved) hold arr/len/i across the per-element
  // calls (__fn___fern_str_free clobbers only %rax/%rcx/%rdx/%rsi/%r8).
  s = emit_ir_arr_deep_free_variant(s, "str_arr_free", "saf", arr_deep_free_call("str_free"));
  // __fern_arrarr_free(arr) — one rc-guarded dec per element, then the buffer
  // (#4355 slice 9): the sibling of __fn___fern_str_arr_free with the identical
  // guard chain and buffer free; only the per-element call differs — each
  // element is released fully by one __fn___fern_arr_dec (rc-guarded: a shared
  // element decs, null no-ops). Gated on need: a binary that never calls it
  // must not carry these bodies — the strarrarr one's inner
  // `call __fn___fern_str_arr_free` text trips the negative asm-grep
  // contracts (strarr-elem-alias-excluded) in every unrelated program.
  if (s.has_need("arrarr_free")) {
    s = emit_ir_arr_deep_free_variant(s, "arrarr_free", "aaf", arr_deep_free_call("arr_dec"));
  }
  // __fern_strarrarr_free(arr) — STRING-array-of-arrays reclaim (#4355
  // slice 9): each element is a string[] INNER buffer released fully by
  // __fn___fern_str_arr_free (its string boxes + the inner buffer, all
  // rc-guarded). Same shell as __fn___fern_arrarr_free above; same
  // need-gating rationale.
  if (s.has_need("strarrarr_free")) {
    s = emit_ir_arr_deep_free_variant(s, "strarrarr_free", "ssaf", arr_deep_free_call("str_arr_free"));
  }
  // __fern_optarrarr_free(arr) — Option[<scalar-arr>][] reclaim (#4365):
  // walks a fresh, sole-owned array of OPTION boxes. Per element (an
  // rc-headered [tag@0, payload@8] box): a UNIQUELY-owned box first decs
  // its Some-payload buffer (tag 0; None/Err skip), then the box itself is
  // arr_dec'd (rc-guarded — a shared box just decs, leaving its payload to
  // the surviving owner), then the outer buffer is freed exactly like
  // __fn___fern_arrarr_free. Called ONLY on compile-time-proven fresh,
  // non-escaping Option-array locals (slot_is_reclaimable_optaarr). Same
  // need-gating rationale as the arrarr bodies above.
  if (s.has_need("optarrarr_free")) {
    s = emit_ir_arr_deep_free_variant(s, "optarrarr_free", "oaf", optarrarr_elem());
  }
  // __fern_rc_is_unique(ptr) -> i32 — 1 iff a live heap object with rc == 1.
  // Gates the struct/enum-array field-drop's element walk (walk + free the
  // element boxes only when THIS drop frees the buffer, i.e. the sole owner).
  s = s.write("__fn___fern_rc_is_unique:\n");
  s = s.write("    movq 8(%rsp), %rcx\n");
  s = s.write("    movq $0, %rax\n");
  s = s.write("    testb $1, %cl\n");
  s = s.write("    jnz .Lshuniq_ret\n");
  s = s.write("    cmpq $0x10000, %rcx\n");
  s = s.write("    jb .Lshuniq_ret\n");
  s = s.write("    andq $-3, %rcx\n");
  s = s.write("    movl -8(%rcx), %edx\n");
  s = s.write(san_poison_check("%edx", s.rc_free_debug));
  s = s.write("    testl %edx, %edx\n");
  s = s.write("    js .Lshuniq_ret\n");
  s = s.write("    cmpl $1, %edx\n");
  s = s.write("    jne .Lshuniq_ret\n");
  s = s.write("    movq $1, %rax\n");
  s = s.write(".Lshuniq_ret:\n");
  s = s.write("    ret\n");
  // __fern_arr_inc_elems(arr) -> arr: one retain per element of a
  // pointer-element array. The lowering emits it ahead of a copy of a
  // pointer-element buffer (the un-share push of a shared receiver, the clone
  // the value forms take): the copy duplicates every element pointer, so both
  // buffers must hold a count of each element for the last owner's element
  // walk to free them once. Null / low-address / immortal buffers are skipped
  // like the deep-free walks skip them, and each element takes rc_inc's guards
  // inline: a tagged or low pointer and a static box's negative count are
  // left alone. It makes no call, so it needs no saved register: %rsi / %rdx
  // hold len / i and %rcx / %edi the element and its count.
  if (s.has_need("arr_inc_elems")) {
    s = s.write("__fn___fern_arr_inc_elems:\n");
    s = s.write("    movq 8(%rsp), %rax\n");  // arr (also the result)
    s = s.write("__fn___fern_arr_inc_elems.r:\n");
    s = s.write("    cmpq $0x10000, %rax\n");
