  // rather than left to the arena: a builder that doubles its way up from the
  // floor would otherwise strand every prefix it passed through.
  if (s.has_need("buf")) {
    if (s.has_need("buf_push_bytes_range")) {
      s = emit_buf_push_bytes_range(s, false);
    }
    if (s.has_need("buf_push_bytes_range_u8")) {
      s = emit_buf_push_bytes_range(s, true);
    }
    if (s.has_need("buf_take_bytes")) {
      s = emit_buf_take_bytes(s, false);
    }
    if (s.has_need("buf_take_bytes_u8")) {
      s = emit_buf_take_bytes(s, true);
