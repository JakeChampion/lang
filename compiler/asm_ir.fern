  s = s.write("    vpand %ymm11, %ymm1, %ymm5\n    vpshufb %ymm5, %ymm9, %ymm5\n    vpand %ymm5, %ymm4, %ymm4\n");
  s = s.write("    vpsrlw $4, %ymm0, %ymm5\n    vpand %ymm11, %ymm5, %ymm5\n    vpshufb %ymm5, %ymm10, %ymm5\n    vpand %ymm5, %ymm4, %ymm4\n");
  s = s.write("    vpsubusb %ymm12, %ymm2, %ymm5\n    vpsubusb %ymm13, %ymm3, %ymm6\n    vpor %ymm6, %ymm5, %ymm5\n");
  s = s.write("    vpand %ymm14, %ymm5, %ymm5\n    vpxor %ymm5, %ymm4, %ymm4\n    vpor %ymm4, %ymm15, %ymm15\n");
  s = s.write(".Lutf8_next:\n    addq $32, %rax\n    jmp .Lutf8_loop\n");
  s = s.write(".Lutf8_done:\n    vpxor %ymm4, %ymm4, %ymm4\n    vpcmpeqb %ymm4, %ymm15, %ymm15\n    vpmovmskb %ymm15, %r8d\n    vzeroupper\n");
