    s = s.write("    movq %rdi, 8(%r8)\n");  // len = grown length
    s = s.write("    movq (%r8), %rdi\n");
    s = s.write("    addq %rcx, %rdi\n");  // dst = data + la
    s = s.write("    movq %rsi, %rcx\n");
    s = s.write("    movq %rdx, %rsi\n");  // src
    s = s.write("    rep movsb\n");
    s = s.write("    movl $1, %eax\n");
    s = s.write(".Lsg_ret:\n");
    s = s.write("    ret\n");
