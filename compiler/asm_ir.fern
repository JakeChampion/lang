    s = s.write("    movq $4, %rcx\n");
    s = s.write("    jmp .Larr_push_cap\n");
    s = s.write(".Larr_push_shared_cliff:\n");
    s = s.write("    incq __fern_arr_push_shared(%rip)\n");
    s = s.write("    movq %r14, %rax\n");
    s = s.write("    shlq $3, %rax\n");
    s = s.write("    addq %rax, __fern_arr_push_copied(%rip)\n");
    s = s.write("    jmp .Larr_push_cap\n");
    s = s.write(".Larr_push_dbl:\n");
    s = s.write("    shlq $1, %rcx\n");
    s = s.write(".Larr_push_cap:\n");
    s = s.write("    leaq 1(%r14), %rax\n    cmpq %rax, %rcx\n    cmovbq %rax, %rcx\n");
    s = s.write("    movq %rcx, %r15\n");
    s = s.write("    movq %r15, %rdi\n");
    s = s.write("    call __fern_arr_box\n");
    s = s.write("    movq %r14, %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    movq %rcx, (%rax)\n");
    s = s.write(arr_copy_elems(".Larr_push"));
    s = s.write("    movq %r14, %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    movq %r13, (%rax,%rcx,8)\n");
    s = s.write(".Larr_push_ret:\n");
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
  }

  if (s.has_need("arr_push")) {
    s = s.write("__fern_arr_push_owned:\n");
    s = s.write(arr_push_fast(".Lapo_slow", s.rc_free_debug));
    s = s.write(".Lapo_slow:\n");
    if (!s.rc_free_debug && !hev_on(s) && !s.has_need("alloc_count")) {
      s = apo_grow(s);
    } else {
      s = apo_wrapped(s);
    }
    s = apo_large(s);
  }

  if (s.has_need("arr_push_u8")) {
    s = emit_arr_push_u8(s);
  }
  if (s.has_need("alloc_bytes") || s.has_need("alloc_bytes_uninit")) {
    s = emit_alloc_bytes(s);
  }

  return s;
}

function ir_bin_asm(tag: i32, width: i32, d: string, r: string): string {
  if (tag == 430) {
    return "    mulq " + r + "\n    movq %rdx, " + d + "\n";
  }
  if (tag == 484) {
    return "    imulq " + r + "\n    movq %rdx, " + d + "\n";
  }
  if (tag == 21) {
    return "    addq " + r + ", " + d + "\n";
  }
  if (tag == 22) {
    return "    subq " + r + ", " + d + "\n";
  }
  if (tag == 23) {
    if (r[0] == 36) {
      return "    imulq " + r + ", " + d + ", " + d + "\n";
    }
    return "    imulq " + r + ", " + d + "\n";
  }
  if (tag == 28) {
    return "    andq " + r + ", " + d + "\n";
  }
  if (tag == 29) {
    return "    orq " + r + ", " + d + "\n";
  }
  if (tag == 30) {
    return "    xorq " + r + ", " + d + "\n";
  }
  if (width == 64) {
    if (tag == 31) {
      return "    shlq %cl, " + d + "\n";
    }
    if (tag == 32) {
      return "    sarq %cl, " + d + "\n";
    }
    if (tag == 33) {
      return "    shrq %cl, " + d + "\n";
    }
  }
  return match (tag) {
    31 => "    andl $31, %ecx\n    shlq %cl, " + d + "\n",
    32 => "    andl $31, %ecx\n    sarq %cl, " + d + "\n",
    33 => "    andl $31, %ecx\n    shrq %cl, " + d + "\n",
    35 => "    cmpq " + r + ", " + d + "\n    sete " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n",
    36 => "    cmpq " + r + ", " + d + "\n    setne " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n",
    37 => "    cmpq " + r + ", " + d + "\n    setl " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n",
    38 => "    cmpq " + r + ", " + d + "\n    setle " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n",
    39 => "    cmpq " + r + ", " + d + "\n    setg " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n",
    40 => "    cmpq " + r + ", " + d + "\n    setge " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n",
    41 => "    cmpq " + r + ", " + d + "\n    setb " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n",
    42 => "    cmpq " + r + ", " + d + "\n    setbe " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n",
    43 => "    cmpq " + r + ", " + d + "\n    seta " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n",
    44 => "    cmpq " + r + ", " + d + "\n    setae " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n",
    _ => ircore.unsupported_op_refuse(tag, "x86-64"),
  };
}

function ir_cmp_jcc(tag: i32, when_true: boolean): i32 {
  let direct = J_JAE;
  let neg = J_JB;
  if (tag == 35) {
    direct = J_JE;
    neg = J_JNE;
  } else if (tag == 36) {
    direct = J_JNE;
    neg = J_JE;
  } else if (tag == 37) {
    direct = J_JL;
    neg = J_JGE;
  } else if (tag == 38) {
    direct = J_JLE;
    neg = J_JG;
  } else if (tag == 39) {
    direct = J_JG;
    neg = J_JLE;
  } else if (tag == 40) {
    direct = J_JGE;
    neg = J_JL;
  } else if (tag == 41) {
    direct = J_JB;
    neg = J_JAE;
  } else if (tag == 42) {
    direct = J_JBE;
    neg = J_JA;
  } else if (tag == 43) {
    direct = J_JA;
    neg = J_JBE;
  }
  if (when_true) {
    return direct;
  }
  return neg;
}

function shift_imm_asm(tag: i32, width: i32, count: i64, d: string): string {
  let k = count as i32 & 31;
  if (width == 64) {
    k = count as i32 & 63;
  }
  let imm = " $" + util.i32_to_string(k) + ", " + d + "\n";
  if (tag == 31) {
    return "    shlq" + imm;
  }
  if (tag == 32) {
    return "    sarq" + imm;
  }
  return "    shrq" + imm;
}

struct DivRegs {
  a: string,
  c: string,
  d: string,
  sfx: string,
  bits: i32,
}

function div_regs(w64: boolean): DivRegs {
  if (w64) {
    return DivRegs { a: "%rax", c: "%rcx", d: "%rdx", sfx: "q", bits: 64 };
  }
  return DivRegs { a: "%eax", c: "%ecx", d: "%edx", sfx: "l", bits: 32 };
}

function ir_div_guarded(tag: i32, width: i32, lb: string): string {
  let r = div_regs(width == 64);
  let s = "    test" + r.sfx + " " + r.c + ", " + r.c + "\n";
  if (tag == 25 || tag == 27) {
    let divide = "    xorl %edx, %edx\n    div" + r.sfx + " " + r.c + "\n";
    if (tag == 25) {
      s = s + "    jz " + lb + "_dz\n" + divide;
      s = s + "    jmp " + lb + "_dn\n";
      s = s + lb + "_dz:\n    xorl %eax, %eax\n";
    } else {
      s = s + "    jz " + lb + "_dn\n" + divide;
      s = s + "    mov" + r.sfx + " " + r.d + ", " + r.a + "\n";
    }
    return s + lb + "_dn:\n";
  }
  let idivide = "    cqto\n    idivq %rcx\n";
  if (width != 64) {
    idivide = "    cltd\n    idivl %ecx\n";
  }
  let cmp_neg1 = "    cmp" + r.sfx + " $-1, " + r.c + "\n";
  if (tag == 24) {
    s = s + "    jz " + lb + "_dz\n";
    s = s + cmp_neg1 + "    je " + lb + "_ng\n" + idivide;
    s = s + "    jmp " + lb + "_dn\n";
    s = s + lb + "_ng:\n    neg" + r.sfx + " " + r.a + "\n    jmp " + lb + "_dn\n";
    s = s + lb + "_dz:\n    xorl %eax, %eax\n";
  } else {
    s = s + "    jz " + lb + "_dn\n";
    s = s + cmp_neg1 + "    je " + lb + "_z0\n" + idivide;
    s = s + "    mov" + r.sfx + " " + r.d + ", " + r.a + "\n    jmp " + lb + "_dn\n";
    s = s + lb + "_z0:\n    xorl %eax, %eax\n";
  }
  s = s + lb + "_dn:\n";
  if (width != 64) {
    s += "    cltq\n";
  }
  return s;
}

function ir_div_const(tag: i32, width: i32, k: i64): string {
  let w64 = width == 64;
  let uns = tag == 25 || tag == 27;
  let body = ir_div_const_body(w64, uns, tag == 26 || tag == 27, k);
  if (!w64 && !uns) {
    body += "    cltq\n";
  }
  return body;
}

function ir_div_const_body(w64: boolean, uns: boolean, is_rem: boolean, k: i64): string {
  let r = div_regs(w64);
  let mag = k;
  let neg = false;
  if (uns) {
    if (!w64) {
      mag = (k as i32) as i64 & 4294967295i64;
    }
  } else {
    let v = k;
    if (!w64) {
      v = (k as i32) as i64;
    }
    let min: i64 = -2147483648i64;
    if (w64) {
      min = -9223372036854775808i64;
    }
    if (v == min) {
      return ir_div_const_generic(r, uns, is_rem, k);
    }
    if (v < 0i64) {
      neg = true;
      mag = 0i64 - v;
    } else {
      mag = v;
    }
  }
  if (mag == 0i64) {
    if (is_rem) {
      return "";
    }
    return "    xorl %eax, %eax\n";
  }
  if (mag == 1i64) {
    if (is_rem) {
      return "    xorl %eax, %eax\n";
    }
    if (neg) {
      return "    neg" + r.sfx + " " + r.a + "\n";
    }
    return "";
  }
  let sh = ir.pow2_shift_i64(mag);
  let max_sh = r.bits - 2;
  if (uns) {
    max_sh = r.bits - 1;
  }
  if (sh >= 0 && sh <= max_sh) {
    return ir_div_const_pow2(r, uns, is_rem, neg, sh);
  }
  return ir_div_const_magic(r, uns, is_rem, k);
}

function ir_div_const_pow2(r: DivRegs, uns: boolean, is_rem: boolean, neg: boolean, sh: i32): string {
  let shs = util.i32_to_string(sh);
  if (uns) {
    if (is_rem) {
      return mask_low_bits(r, r.a, sh, true);
    }
    return "    shr" + r.sfx + " $" + shs + ", " + r.a + "\n";
  }
  let s = "    mov" + r.sfx + " " + r.a + ", " + r.c + "\n";
  s = s + "    sar" + r.sfx + " $" + util.i32_to_string(r.bits - 1) + ", " + r.c + "\n";
  s = s + "    shr" + r.sfx + " $" + util.i32_to_string(r.bits - sh) + ", " + r.c + "\n";
  s = s + "    add" + r.sfx + " " + r.a + ", " + r.c + "\n";
  if (is_rem) {
    s += mask_low_bits(r, r.c, sh, false);
    return s + "    sub" + r.sfx + " " + r.c + ", " + r.a + "\n";
  }
  s = s + "    mov" + r.sfx + " " + r.c + ", " + r.a + "\n";
  s = s + "    sar" + r.sfx + " $" + shs + ", " + r.a + "\n";
  if (neg) {
    s = s + "    neg" + r.sfx + " " + r.a + "\n";
  }
  return s;
}

function mask_low_bits(r: DivRegs, reg: string, sh: i32, keep: boolean): string {
  if (keep && sh <= 31) {
    return "    and" + r.sfx + " $" + util.i64_to_string((1i64 << sh) - 1i64) + ", " + reg + "\n";
  }
  if (keep) {
    let back = util.i32_to_string(r.bits - sh);
    return "    shl" + r.sfx + " $" + back + ", " + reg + "\n    shr" + r.sfx + " $" + back + ", " + reg + "\n";
  }
  if (sh <= 31) {
    return "    and" + r.sfx + " $" + util.i64_to_string(0i64 - (1i64 << sh)) + ", " + reg + "\n";
  }
  let shs = util.i32_to_string(sh);
  return "    shr" + r.sfx + " $" + shs + ", " + reg + "\n    shl" + r.sfx + " $" + shs + ", " + reg + "\n";
}

function ir_div_const_magic(r: DivRegs, uns: boolean, is_rem: boolean, k: i64): string {
  let x = r.sfx;
  let s = "    mov" + x + " " + r.a + ", " + r.c + "\n";
  let load = "    movl $";
  if (r.bits == 64) {
    load = "    movabsq $";
  }
  let d = k;
  if (r.bits == 32) {
    d = (k as i32) as i64;
  }
  if (uns) {
    let du = k as u64 & 0u64 - 1u64 >> (64 - r.bits) as u64;
    let mu = ir.derive_magic_u(du, r.bits);
    let pre = 0;
    if (mu.add && (du & 1u64) == 0u64) {
      while ((du >> pre as u64 & 1u64) == 0u64) {
        pre += 1;
      }
      mu = ir.derive_magic_u_below(du >> pre as u64, r.bits, pre);
    }
    let m = mu.m as i64;
    if (r.bits == 32) {
      m = ((mu.m as u32) as i32) as i64;
    }
    if (pre > 0) {
      s = s + "    mov" + x + " " + r.c + ", " + r.d + "\n    shr" + x + " $" + util.i32_to_string(pre) + ", " + r.d + "\n";
      s = s + load + util.i64_to_string(m) + ", " + r.a + "\n    mul" + x + " " + r.d + "\n";
    } else {
      s = s + load + util.i64_to_string(m) + ", " + r.a + "\n    mul" + x + " " + r.c + "\n";
    }
    if (!mu.add) {
      s = s + "    shr" + x + " $" + util.i32_to_string(mu.s) + ", " + r.d + "\n    mov" + x + " " + r.d + ", " + r.a + "\n";
    } else {
      s = s + "    mov" + x + " " + r.c + ", " + r.a + "\n    sub" + x + " " + r.d + ", " + r.a + "\n";
      s = s + "    shr" + x + " $1, " + r.a + "\n    add" + x + " " + r.d + ", " + r.a + "\n";
      s = s + "    shr" + x + " $" + util.i32_to_string(mu.s - 1) + ", " + r.a + "\n";
    }
  } else if (r.bits == 32) {
    s = ir_div_s32_quotient(d);
  } else {
    let ms = ir.derive_magic_s(d);
    s = s + load + util.i64_to_string(ms.m) + ", " + r.a + "\n    imul" + x + " " + r.c + "\n";
    if (ms.add) {
      s = s + "    add" + x + " " + r.c + ", " + r.d + "\n";
    }
    if (ms.sub) {
      s = s + "    sub" + x + " " + r.c + ", " + r.d + "\n";
    }
    if (ms.s != 0) {
      s = s + "    sar" + x + " $" + util.i32_to_string(ms.s) + ", " + r.d + "\n";
    }
    s = s + "    mov" + x + " " + r.d + ", " + r.a + "\n    shr" + x + " $" + util.i32_to_string(r.bits - 1) + ", " + r.d + "\n";
    s = s + "    add" + x + " " + r.d + ", " + r.a + "\n";
  }
  if (is_rem) {
    if (d == (d as i32) as i64) {
      s = s + "    imul" + x + " $" + util.i64_to_string(d) + ", " + r.a + ", " + r.a + "\n";
    } else {
      s = s + "    movabsq $" + util.i64_to_string(d) + ", %rdx\n    imulq %rdx, %rax\n";
    }
    s = s + "    sub" + x + " " + r.a + ", " + r.c + "\n    mov" + x + " " + r.c + ", " + r.a + "\n";
  }
  return s;
}

// The quotient of %eax by a signed 32-bit divisor, left in %eax with the
// dividend kept in %ecx. The rounding term (the sign bit of x * d) is made
// beside the multiply, so it is not on the dependency chain.
function ir_div_s32_quotient(d: i64): string {
  let mg = ir.derive_magic_s32(d);
  let s = "    movslq %eax, %rcx\n";
  if (d > 0i64) {
    s += "    movl %ecx, %edx\n    shrl $31, %edx\n";
  } else {
    s += "    movq %rcx, %rdx\n    negq %rdx\n    shrq $63, %rdx\n";
  }
  if (mg.m >= 0i64) {
    s = s + "    movl $" + util.i64_to_string((mg.m as i32) as i64) + ", %eax\n";
  } else if (mg.m >= -2147483648i64) {
    s = s + "    movq $" + util.i64_to_string(mg.m) + ", %rax\n";
  } else {
    s = s + "    movabsq $" + util.i64_to_string(mg.m) + ", %rax\n";
  }
  s = s + "    imulq %rcx, %rax\n    sarq $" + util.i32_to_string(mg.s) + ", %rax\n";
  return s + "    addl %edx, %eax\n";
}

function ir_div_const_generic(r: DivRegs, uns: boolean, is_rem: boolean, k: i64): string {
  let s = "    movl $" + util.i64_to_string(k) + ", %ecx\n";
  if (r.bits == 64) {
    s = "    movabsq $" + util.i64_to_string(k) + ", %rcx\n";
  }
  if (uns) {
    s = s + "    xorl %edx, %edx\n    div" + r.sfx + " " + r.c + "\n";
  } else if (r.bits == 64) {
    s += "    cqto\n    idivq %rcx\n";
  } else {
    s += "    cltd\n    idivl %ecx\n";
  }
  if (is_rem) {
    s = s + "    mov" + r.sfx + " " + r.d + ", " + r.a + "\n";
  }
  return s;
}

function ir_fround_rax(lb: string, d: string): string {
  let s = "    movq " + d + ", %xmm0\n";
  s += "    roundsd $3, %xmm0, %xmm1\n";
  s += "    subsd %xmm1, %xmm0\n";
  s += "    movq %xmm0, %rcx\n    movabsq $0x7fffffffffffffff, %rdx\n    andq %rdx, %rcx\n";
  s += "    movq %rcx, %xmm0\n";
  s += "    movabsq $0x3fe0000000000000, %rcx\n    movq %rcx, %xmm2\n";
  s = s + "    ucomisd %xmm2, %xmm0\n    jb " + lb + "_rdone\n";
  s = s + "    movq " + d + ", %rcx\n    movabsq $0x8000000000000000, %rdx\n    andq %rdx, %rcx\n";
  s += "    movabsq $0x3ff0000000000000, %rdx\n    orq %rdx, %rcx\n";
  s += "    movq %rcx, %xmm0\n    addsd %xmm0, %xmm1\n";
  s = s + lb + "_rdone:\n    movq %xmm1, " + d + "\n";
  return s;
}

function ir_f2i_sat_rax(width: i32, lb: string, d: string): string {
  if (width != 64) {
    let s = "    movq " + d + ", %xmm0\n";
    s = s + "    ucomisd %xmm0, %xmm0\n    jp " + lb + "_nan\n";
    s += "    movabsq $0x41dfffffffc00000, %rcx\n    movq %rcx, %xmm1\n    minsd %xmm1, %xmm0\n";
    s += "    movabsq $0xc1e0000000000000, %rcx\n    movq %rcx, %xmm1\n    maxsd %xmm1, %xmm0\n";
    s = s + "    cvttsd2si %xmm0, " + ssa_r32(d) + "\n    movslq " + ssa_r32(d) + ", " + d + "\n    jmp " + lb + "_done\n";
    s = s + lb + "_nan:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n";
    s = s + lb + "_done:\n";
    return s;
  }
  let s64 = "    movq " + d + ", %xmm0\n    cvttsd2si %xmm0, " + d + "\n";
  s64 = s64 + "    movabsq $0x8000000000000000, %rcx\n    cmpq %rcx, " + d + "\n    jne " + lb + "_done\n";
  s64 = s64 + "    ucomisd %xmm0, %xmm0\n    jp " + lb + "_nan\n";
  s64 = s64 + "    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm0\n    jbe " + lb + "_done\n";
  s64 = s64 + "    movabsq $0x7fffffffffffffff, " + d + "\n    jmp " + lb + "_done\n";
  s64 = s64 + lb + "_nan:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n";
  s64 = s64 + lb + "_done:\n";
  return s64;
}

function ir_f2u_sat_rax(width: i32, lb: string, d: string): string {
  if (width != 64) {
    let s = "    movq " + d + ", %xmm0\n    cvttsd2si %xmm0, " + d + "\n";
    s = s + "    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm0\n    jb " + lb + "_zero\n";
    s += "    movabsq $0x41f0000000000000, %rcx\n    movq %rcx, %xmm1\n";
    s = s + "    ucomisd %xmm1, %xmm0\n    jae " + lb + "_max\n    jmp " + lb + "_done\n";
    s = s + lb + "_zero:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n    jmp " + lb + "_done\n";
    s = s + lb + "_max:\n    movl $0xffffffff, " + ssa_r32(d) + "\n";
    s = s + lb + "_done:\n";
    return s;
  }
  let u = "    movq " + d + ", %xmm0\n    movaps %xmm0, %xmm2\n";
  u += "    movabsq $0x43e0000000000000, %rcx\n    movq %rcx, %xmm1\n";
  u = u + "    ucomisd %xmm1, %xmm0\n    jae " + lb + "_big\n";
  u = u + "    cvttsd2si %xmm0, " + d + "\n    jmp " + lb + "_sat\n";
  u = u + lb + "_big:\n    subsd %xmm1, %xmm0\n    cvttsd2si %xmm0, " + d + "\n";
  u = u + "    movabsq $0x8000000000000000, %rcx\n    xorq %rcx, " + d + "\n";
  u = u + lb + "_sat:\n    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm2\n    jb " + lb + "_zero\n";
  u += "    movabsq $0x43f0000000000000, %rcx\n    movq %rcx, %xmm1\n";
  u = u + "    ucomisd %xmm1, %xmm2\n    jae " + lb + "_umax\n    jmp " + lb + "_done\n";
  u = u + lb + "_zero:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n    jmp " + lb + "_done\n";
  u = u + lb + "_umax:\n    movq $-1, " + d + "\n";
  u = u + lb + "_done:\n";
  return u;
}

function emit_scan_set_blocks(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let names: string[] = [];
  while (names.len() < 9) {
    let lo = asmcore.fresh_label(s);
    names = names.append(lo.name);
    s = lo.state;
  }
  let lit = asmcore.add_string_lit(asmcore.EmitState { ...s }, asmcore.scan_set_tables(o.str));
  s = lit.state;
  let tables = asmcore.str_lit_label(s, lit.idx);
  let l_from_ok = names[0];
  let l_loop = names[1];
  let l_hit16 = names[2];
  let l_tail = names[3];
  let l_hit = names[4];
  let l_end = names[5];
  let l_done = names[6];
  let l_half = names[7];
  let l_rest = names[8];
  s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n");
  if (o.kind_tag == ir.K_SCAN_SET_BYTES) {
    s = s.write("    movq (%rax), %r8\n    addq $8, %rax\n");
  } else {
    s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
  }
  s = s.write("    testq %rcx, %rcx\n    jns " + l_from_ok + "\n    xorq %rcx, %rcx\n");
  s = s.write(l_from_ok + ":\n    leaq " + tables + "(%rip), %r11\n");
  s = s.write("    leaq (%rax,%rcx), %r9\n    leaq -16(%rax,%r8), %r10\n");
  s = s.write("    cmpq %r10, %r9\n    jg " + l_tail + "\n");
  let shape = asmcore.scan_set_shape(o.str);
  s = s.write(scan_set_setup(shape));
  s = s.write(l_loop + ":\n    leaq 16(%r9), %rdx\n    cmpq %r10, %rdx\n    jg " + l_half + "\n");
  s = s.write("    vmovdqu (%r9), %ymm0\n" + scan_set_classify(shape, "ymm") + "    vpmovmskb %ymm1, %edx\n");
  if (shape.invert) {
    s = s.write("    notl %edx\n");
  }
  s = s.write("    testl %edx, %edx\n    jnz " + l_hit16 + "\n");
  s = s.write("    addq $32, %r9\n    jmp " + l_loop + "\n");
  s = s.write(l_half + ":\n    cmpq %r10, %r9\n    jg " + l_rest + "\n");
  s = s.write("    vmovdqu (%r9), %xmm0\n" + scan_set_classify(shape, "xmm") + "    vpmovmskb %xmm1, %edx\n");
  if (shape.invert) {
    s = s.write("    xorl $65535, %edx\n");
  }
  s = s.write("    testl %edx, %edx\n    jnz " + l_hit16 + "\n    addq $16, %r9\n");
  s = s.write(l_rest + ":\n    vzeroupper\n    movq %r9, %rcx\n    subq %rax, %rcx\n    jmp " + l_tail + "\n");
  s = s.write(l_hit16 + ":\n    vzeroupper\n    bsfl %edx, %edx\n    subq %rax, %r9\n    addq %rdx, %r9\n");
  s = s.write("    pushq %r9\n    jmp " + l_done + "\n");
  s = s.write(l_tail + ":\n    cmpq %r8, %rcx\n    jge " + l_end + "\n");
  s = s.write("    movzbq (%rax,%rcx), %r9\n    cmpb $0, 96(%r11,%r9)\n    jne " + l_hit + "\n");
  s = s.write("    addq $1, %rcx\n    jmp " + l_tail + "\n");
  s = s.write(l_hit + ":\n    pushq %rcx\n    jmp " + l_done + "\n");
  s = s.write(l_end + ":\n    pushq %r8\n");
  return s.write(l_done + ":\n");
}

function scan_set_setup(shape: asmcore.ScanShape): string {
  if (shape.nibble) {
    return "    vbroadcasti128 (%r11), %ymm2\n    vbroadcasti128 16(%r11), %ymm3\n    vbroadcasti128 32(%r11), %ymm4\n"
      + "    vbroadcasti128 48(%r11), %ymm5\n    vbroadcasti128 64(%r11), %ymm6\n    vbroadcasti128 80(%r11), %ymm7\n";
  }
  let r = "";
  for j in 0..shape.bytes.len() {
    r = r + "    vpbroadcastb " + util.i32_to_string(352 + j) + "(%r11), %ymm" + util.i32_to_string(2 + j) + "\n";
  }
  return r;
}

function scan_set_classify(shape: asmcore.ScanShape, w: string): string {
  if (shape.nibble) {
    return scan_set_classify_nibble(w);
  }
  let r = "";
  let j = 0;
  if (shape.range) {
    r = "    vpsubb %" + w + "2, %" + w + "0, %" + w + "1\n    vpminub %" + w + "3, %" + w + "1, %" + w + "8\n"
      + "    vpcmpeqb %" + w + "8, %" + w + "1, %" + w + "1\n";
    j = 2;
  } else {
    r = "    vpcmpeqb %" + w + "2, %" + w + "0, %" + w + "1\n";
    j = 1;
  }
  while (j < shape.bytes.len()) {
    r = r + "    vpcmpeqb %" + w + util.i32_to_string(2 + j) + ", %" + w + "0, %" + w + "8\n    vpor %" + w + "8, %" + w + "1, %" + w + "1\n";
    j += 1;
  }
  return r;
}

function scan_set_classify_nibble(w: string): string {
  let r = "    vpand %" + w + "5, %" + w + "0, %" + w + "1\n";
  r = r + "    vpxor %" + w + "6, %" + w + "0, %" + w + "8\n    vpand %" + w + "5, %" + w + "8, %" + w + "8\n";
  r = r + "    vpshufb %" + w + "1, %" + w + "2, %" + w + "9\n";
  r = r + "    vpshufb %" + w + "8, %" + w + "3, %" + w + "1\n    vpor %" + w + "9, %" + w + "1, %" + w + "1\n";
  r = r + "    vpsrlw $4, %" + w + "0, %" + w + "0\n    vpand %" + w + "7, %" + w + "0, %" + w + "0\n";
  r = r + "    vpshufb %" + w + "0, %" + w + "4, %" + w + "8\n";
  return r + "    vpand %" + w + "8, %" + w + "1, %" + w + "1\n    vpcmpeqb %" + w + "8, %" + w + "1, %" + w + "1\n";
}

function set_entry_test(o: ir.Op, idx: string): string {
  if (ir.is_packed(o)) {
    return "cmpb $0, 8(%rdx," + idx + ")";
  }
  return "cmpq $0, 8(%rdx," + idx + ",8)";
}

// AVX2 has only a signed 64-bit compare. Both sides have their top bit flipped,
// so the signed compare gives the unsigned order. Four words go in each step.
// Every vector instruction is VEX-encoded: a legacy SSE write after vbroadcastsd
// pays the SSE/AVX transition on each call.
function emit_count_below_u64(s: asmcore.EmitState): asmcore.EmitState {
  let lo1 = asmcore.fresh_label(s);
  let c_vec = lo1.name;
  let lo2 = asmcore.fresh_label(lo1.state);
  let c_tail = lo2.name;
  let lo3 = asmcore.fresh_label(lo2.state);
  let c_next = lo3.name;
  let lo4 = asmcore.fresh_label(lo3.state);
  let c_done = lo4.name;
  let lo5 = asmcore.fresh_label(lo4.state);
  let c_vec_done = lo5.name;
  s = lo5.state;
  s = s.write("    popq %rcx\n    popq %rax\n");
  s = s.write("    movq (%rax), %r8\n    xorq %rdx, %rdx\n    xorq %r10, %r10\n");
  s = s.write("    movabsq $-9223372036854775808, %r9\n    vmovq %r9, %xmm2\n    vbroadcastsd %xmm2, %ymm2\n");
  s = s.write("    movq %rcx, %r11\n    xorq %r9, %r11\n    vmovq %r11, %xmm1\n    vbroadcastsd %xmm1, %ymm1\n");
  s = s.write("    leaq -4(%r8), %r9\n");
  s = s.write(c_vec + ":\n    cmpq %r9, %rdx\n    jg " + c_vec_done + "\n");
  s = s.write("    vpxor 8(%rax,%rdx,8), %ymm2, %ymm0\n    vpcmpgtq %ymm0, %ymm1, %ymm0\n");
  s = s.write("    vmovmskpd %ymm0, %r11d\n    popcntl %r11d, %r11d\n    addq %r11, %r10\n");
  s = s.write("    addq $4, %rdx\n    jmp " + c_vec + "\n");
  s = s.write(c_vec_done + ":\n    vzeroupper\n");
  s = s.write(c_tail + ":\n    cmpq %r8, %rdx\n    jge " + c_done + "\n");
  s = s.write("    movq 8(%rax,%rdx,8), %r11\n    cmpq %rcx, %r11\n    jae " + c_next + "\n");
  s = s.write("    addq $1, %r10\n");
  s = s.write(c_next + ":\n    addq $1, %rdx\n    jmp " + c_tail + "\n");
  return s.write(c_done + ":\n    pushq %r10\n");
}

function emit_mismatch_x86(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let mlo = asmcore.fresh_label(s);
  let lb = mlo.name;
  s = mlo.state;
  s = s.write("    popq %r8\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %rax\n");
  if (o.kind_tag == ir.K_MISMATCH_BYTES || o.kind_tag == ir.K_MISMATCH_BYTES_STR) {
    s = s.write("    movq (%rax), %r9\n    addq $8, %rax\n");
  } else {
    s = s.write("    movq 8(%rax), %r9\n    movq (%rax), %rax\n");
  }
  if (o.kind_tag == ir.K_MISMATCH_BYTES) {
    s = s.write("    movq (%rdx), %r10\n    addq $8, %rdx\n");
  } else {
    s = s.write("    movq 8(%rdx), %r10\n    movq (%rdx), %rdx\n");
  }
  s = s.write("    cmpq $0, %rsi\n    jge " + lb + "_aop\n    xorq %rsi, %rsi\n");
  s = s.write(lb + "_aop:\n    cmpq %r9, %rsi\n    jle " + lb + "_aok\n    movq %r9, %rsi\n");
  s = s.write(lb + "_aok:\n    cmpq $0, %rcx\n    jge " + lb + "_bop\n    xorq %rcx, %rcx\n");
  s = s.write(lb + "_bop:\n    cmpq %r10, %rcx\n    jle " + lb + "_bok\n    movq %r10, %rcx\n");
  s = s.write(lb + "_bok:\n    subq %rsi, %r9\n    subq %rcx, %r10\n");
  s = s.write("    cmpq %r9, %r8\n    jle " + lb + "_na\n    movq %r9, %r8\n");
  s = s.write(lb + "_na:\n    cmpq %r10, %r8\n    jle " + lb + "_nb\n    movq %r10, %r8\n");
  s = s.write(lb + "_nb:\n    cmpq $0, %r8\n    jge " + lb + "_nok\n    xorq %r8, %r8\n");
  s = s.write(lb + "_nok:\n");
  if (o.kind_tag == ir.K_MISMATCH_BYTES && !ir.is_packed(o)) {
    s = s.write("    leaq (%rax,%rsi,8), %rsi\n    leaq (%rdx,%rcx,8), %rcx\n    xorq %rdx, %rdx\n");
    s = s.write(lb + "_slots:\n    cmpq %r8, %rdx\n    jge " + lb + "_slots_done\n");
    s = s.write("    movzbq (%rsi,%rdx,8), %rax\n    movzbq (%rcx,%rdx,8), %rdi\n    cmpq %rdi, %rax\n    jne " + lb + "_slots_done\n");
    s = s.write("    addq $1, %rdx\n    jmp " + lb + "_slots\n");
    return s.write(lb + "_slots_done:\n    pushq %rdx\n");
  }
  s = s.write("    addq %rax, %rsi\n    addq %rdx, %rcx\n    xorq %rdx, %rdx\n");
  s = s.write("    cmpq $16, %r8\n    jge " + lb + "_vec\n");
  s = s.write("    cmpq $8, %r8\n    jge " + lb + "_w8\n");
  s = s.write("    cmpq $4, %r8\n    jge " + lb + "_w4\n");
  s = s.write("    cmpq $2, %r8\n    jge " + lb + "_w2\n    jmp " + lb + "_tail\n");
  s = s.write(lb + "_w8:\n    movq (%rsi), %rax\n    xorq (%rcx), %rax\n    jnz " + lb + "_w8l\n");
  s = s.write("    movq %r8, %rdi\n    subq $8, %rdi\n");
  s = s.write("    movq (%rsi,%rdi), %rax\n    xorq (%rcx,%rdi), %rax\n    jz " + lb + "_eq\n");
  s = s.write("    bsfq %rax, %rax\n    shrq $3, %rax\n    addq %rdi, %rax\n    jmp " + lb + "_done\n");
  s = s.write(lb + "_w8l:\n    bsfq %rax, %rax\n    shrq $3, %rax\n    jmp " + lb + "_done\n");
  s = s.write(lb + "_w4:\n    movl (%rsi), %eax\n    xorl (%rcx), %eax\n    jnz " + lb + "_w4l\n");
  s = s.write("    movq %r8, %rdi\n    subq $4, %rdi\n");
  s = s.write("    movl (%rsi,%rdi), %eax\n    xorl (%rcx,%rdi), %eax\n    jz " + lb + "_eq\n");
  s = s.write("    bsfl %eax, %eax\n    shrl $3, %eax\n    addq %rdi, %rax\n    jmp " + lb + "_done\n");
  s = s.write(lb + "_w4l:\n    bsfl %eax, %eax\n    shrl $3, %eax\n    jmp " + lb + "_done\n");
  s = s.write(lb + "_w2:\n    movzwl (%rsi), %eax\n    movzwl (%rcx), %r9d\n    xorl %r9d, %eax\n    jnz " + lb + "_w2l\n");
  s = s.write("    movq %r8, %rdi\n    subq $2, %rdi\n");
  s = s.write("    movzwl (%rsi,%rdi), %eax\n    movzwl (%rcx,%rdi), %r9d\n    xorl %r9d, %eax\n    jz " + lb + "_eq\n");
  s = s.write("    bsfl %eax, %eax\n    shrl $3, %eax\n    addq %rdi, %rax\n    jmp " + lb + "_done\n");
  s = s.write(lb + "_w2l:\n    bsfl %eax, %eax\n    shrl $3, %eax\n    jmp " + lb + "_done\n");
  s = s.write(lb + "_vec:\n    movq %r8, %rax\n    subq %rdx, %rax\n    cmpq $16, %rax\n    jl " + lb + "_vlast\n");
  s = s.write("    movdqu (%rsi,%rdx), %xmm0\n    movdqu (%rcx,%rdx), %xmm1\n");
  s = s.write("    pcmpeqb %xmm1, %xmm0\n    pmovmskb %xmm0, %eax\n");
  s = s.write("    cmpl $65535, %eax\n    jne " + lb + "_hit\n");
  s = s.write("    addq $16, %rdx\n    jmp " + lb + "_vec\n");
  // The last 16 bytes end at the end of the range and may overlap bytes
  // that already compared equal, so no byte is compared on its own.
  s = s.write(lb + "_vlast:\n    cmpq %r8, %rdx\n    jge " + lb + "_eq\n    movq %r8, %rdx\n    subq $16, %rdx\n");
  s = s.write("    movdqu (%rsi,%rdx), %xmm0\n    movdqu (%rcx,%rdx), %xmm1\n");
  s = s.write("    pcmpeqb %xmm1, %xmm0\n    pmovmskb %xmm0, %eax\n");
  s = s.write("    cmpl $65535, %eax\n    jne " + lb + "_hit\n    jmp " + lb + "_eq\n");
  s = s.write(lb + "_hit:\n    notl %eax\n    bsfl %eax, %eax\n    addq %rdx, %rax\n    jmp " + lb + "_done\n");
  s = s.write(lb + "_tail:\n    cmpq %r8, %rdx\n    jge " + lb + "_eq\n");
  s = s.write("    movzbq (%rsi,%rdx), %rax\n    movzbq (%rcx,%rdx), %rdi\n");
  s = s.write("    cmpq %rdi, %rax\n    jne " + lb + "_th\n");
  s = s.write("    addq $1, %rdx\n    jmp " + lb + "_tail\n");
  s = s.write(lb + "_th:\n    movq %rdx, %rax\n    jmp " + lb + "_done\n");
  s = s.write(lb + "_eq:\n    movq %r8, %rax\n");
  s = s.write(lb + "_done:\n    pushq %rax\n");
  return s;
}

function emit_outer_mul_f64(s: asmcore.EmitState): asmcore.EmitState {
  let a = asmcore.fresh_label(s);
  let b = asmcore.fresh_label(a.state);
  let c = asmcore.fresh_label(b.state);
  let d = asmcore.fresh_label(c.state);
  s = d.state;
  s = s.write("    popq %rsi\n    popq %rdx\n    movq (%rdx), %rdi\n    imulq (%rsi), %rdi\n    cmpq $2147483647, %rdi\n    ja __fern_oob_abort\n");
  s = s.write("    pushq %rdx\n    pushq %rsi\n    call __fern_arr_box\n    popq %rsi\n    popq %rdx\n");
  s = s.write("    leaq 8(%rax), %r11\n    xorq %r8, %r8\n    movq (%rsi), %r10\n    testq %r10, %r10\n    jz " + d.name + "\n    andq $-2, %r10\n");
  s = s.write(a.name + ":\n    cmpq (%rdx), %r8\n    jge " + d.name + "\n");
  s = s.write("    movsd 8(%rdx,%r8,8), %xmm1\n    unpcklpd %xmm1, %xmm1\n    xorq %rcx, %rcx\n");
  s = s.write(b.name + ":\n    cmpq %r10, %rcx\n    jge " + c.name + "\n");
  s = s.write("    movupd 8(%rsi,%rcx,8), %xmm0\n    movapd %xmm1, %xmm2\n    mulpd %xmm0, %xmm2\n    movupd %xmm2, (%r11)\n    addq $16, %r11\n    addq $2, %rcx\n    jmp " + b.name + "\n");
  s = s.write(c.name + ":\n    cmpq (%rsi), %rcx\n    jge " + c.name + "_next\n");
  s = s.write("    movsd 8(%rsi,%rcx,8), %xmm0\n    movapd %xmm1, %xmm2\n    mulsd %xmm0, %xmm2\n    movsd %xmm2, (%r11)\n    addq $8, %r11\n");
  s = s.write(c.name + "_next:\n    addq $1, %r8\n    jmp " + a.name + "\n");
  s = s.write(d.name + ":\n    pushq %rax\n");
  return s.need("heap");
}

function emit_inner_mul_add_f64(s: asmcore.EmitState): asmcore.EmitState {
  let label = asmcore.fresh_label(s);
  s = label.state;
  let lb = label.name;
  s = s.write("    popq %r9\n    popq %r8\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %r10\n");
  s = s.write("    testl %edx, %edx\n    js __fern_oob_abort\n    testl %ecx, %ecx\n    js __fern_oob_abort\n    testl %r8d, %r8d\n    js __fern_oob_abort\n    movl %edx, %edx\n    movl %ecx, %ecx\n    movl %r8d, %r8d\n");
  s = s.write("    movq %rdx, %rdi\n    imulq %rcx, %rdi\n    cmpq (%r10), %rdi\n    jne __fern_oob_abort\n    movq %rcx, %rdi\n    imulq %r8, %rdi\n    cmpq (%rsi), %rdi\n    jne __fern_oob_abort\n    movq %rdx, %rdi\n    imulq %r8, %rdi\n    cmpq $2147483647, %rdi\n    ja __fern_oob_abort\n");
  s = s.write("    pushq %r10\n    pushq %rsi\n    pushq %rdx\n    pushq %rcx\n    pushq %r8\n    pushq %r9\n    call __fern_arr_box\n    popq %r9\n    popq %r8\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %r10\n    pushq %rax\n");
  s = s.write("    testq %rdx, %rdx\n    jz " + lb + "_done\n    testq %r8, %r8\n    jz " + lb + "_done\n    leaq 8(%rax), %r11\n    leaq 8(%r10), %rdi\n    addq $8, %rsi\n    movq %r9, %xmm3\n    unpcklpd %xmm3, %xmm3\n");
  s = s.write(lb + "_row:\n    xorq %r10, %r10\n" + lb + "_pair:\n    leaq 1(%r10), %rax\n    cmpq %r8, %rax\n    jge " + lb + "_tail\n    leaq (%rsi,%r10,8), %rax\n    movapd %xmm3, %xmm2\n    xorq %r9, %r9\n");
  s = s.write(lb + "_k:\n    cmpq %rcx, %r9\n    jge " + lb + "_store\n    movsd (%rdi,%r9,8), %xmm1\n    unpcklpd %xmm1, %xmm1\n    movupd (%rax), %xmm0\n    mulpd %xmm0, %xmm1\n    addpd %xmm1, %xmm2\n    leaq (%rax,%r8,8), %rax\n    addq $1, %r9\n    jmp " + lb + "_k\n");
  s = s.write(lb + "_store:\n    movupd %xmm2, (%r11)\n    addq $16, %r11\n    addq $2, %r10\n    jmp " + lb + "_pair\n");
  s = s.write(lb + "_tail:\n    cmpq %r8, %r10\n    jge " + lb + "_next\n    leaq (%rsi,%r10,8), %rax\n    movapd %xmm3, %xmm2\n    xorq %r9, %r9\n");
  s = s.write(lb + "_scalar:\n    cmpq %rcx, %r9\n    jge " + lb + "_scalar_store\n    movsd (%rdi,%r9,8), %xmm1\n    mulsd (%rax), %xmm1\n    addsd %xmm1, %xmm2\n    leaq (%rax,%r8,8), %rax\n    addq $1, %r9\n    jmp " + lb + "_scalar\n");
  s = s.write(lb + "_scalar_store:\n    movsd %xmm2, (%r11)\n    addq $8, %r11\n" + lb + "_next:\n    leaq (%rdi,%rcx,8), %rdi\n    subq $1, %rdx\n    jnz " + lb + "_row\n" + lb + "_done:\n");
  return s.need("heap");
}

function emit_str_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  if (o.kind_tag == ir.K_RET_WORD || o.kind_tag == ir.K_CALL_WORD) {
    let reg: string = ["rdx", "rcx", "r11"][o.i32_imm];
    if (o.kind_tag == ir.K_RET_WORD) {
      return s.write("    popq %" + reg + "\n    pushq %" + reg + "\n");
    }
    return s.write("    pushq %" + reg + "\n");
  }
  if (o.kind_tag == ir.K_ARR_RESERVE) {
    s = s.write("    popq %rdi\n    testl %edi, %edi\n    js __fern_oob_abort\n    movl %edi, %edi\n");
    if (o.width == 8) {
      s = s.write("    addq $7, %rdi\n    shrq $3, %rdi\n");
    }
    s = s.write("    call __fern_arr_box\n    movq $0, (%rax)\n    pushq %rax\n");
    return s.need("heap");
  }
  if (o.kind_tag == ir.K_INNER_MUL_ADD_F64) {
    return emit_inner_mul_add_f64(s);
  }
  if (ir.is_aes_gcm_op(o.kind_tag)) {
    return emit_aes_gcm_op(o, s);
  }
  let kernel = ir.kernel_need(o.kind_tag);
  if (kernel != "") {
    s = s.need(kernel).need("heap");
    let regs: string[] = ["%rdi", "%rsi", "%rdx", "%rcx", "%r8"];
    let pops = "";
    for k in 0..ir.kernel_arity(o.kind_tag) {
      pops = "    popq " + regs[k] + "\n" + pops;
    }
    return s.write(pops + "    call " + ir.kernel_symbol(o.kind_tag) + "\n    pushq %rax\n");
  }
  if (o.kind_tag == ir.K_OUTER_MUL_F64) {
    return emit_outer_mul_f64(s);
  }
  if (o.kind_tag == ir.K_MEMCHR || o.kind_tag == ir.K_MEMCHR_BYTES) {
    let mlo = asmcore.fresh_label(s);
    let l_clamped = mlo.name;
    let mlo2 = asmcore.fresh_label(mlo.state);
    let l_vec = mlo2.name;
    let mlo3 = asmcore.fresh_label(mlo2.state);
    let l_hit = mlo3.name;
    let mlo4 = asmcore.fresh_label(mlo3.state);
    let l_tail = mlo4.name;
    let mlo5 = asmcore.fresh_label(mlo4.state);
    let l_none = mlo5.name;
    let mlo6 = asmcore.fresh_label(mlo5.state);
    let l_done = mlo6.name;
    let mlo7 = asmcore.fresh_label(mlo6.state);
    let l_avx = mlo7.name;
    let mlo8 = asmcore.fresh_label(mlo7.state);
    let l_hit32 = mlo8.name;
    let mlo9 = asmcore.fresh_label(mlo8.state);
    let l_avx_done = mlo9.name;
    let mlo10 = asmcore.fresh_label(mlo9.state);
    let l_bytes = mlo10.name;
    s = mlo10.state;
    s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n");
    if (o.kind_tag == ir.K_MEMCHR_BYTES) {
      s = s.write("    movq (%rax), %r8\n    addq $8, %rax\n");
    } else {
      s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
    }
    s = s.write("    cmpq $0, %rdx\n    jge " + l_clamped + "\n    xorq %rdx, %rdx\n");
    s = s.write(l_clamped + ":\n");
    s = s.write("    cmpq $255, %rcx\n    ja " + l_none + "\n");
    if (o.kind_tag == ir.K_MEMCHR_BYTES && !ir.is_packed(o)) {
      s = s.write(l_tail + ":\n    cmpq %r8, %rdx\n    jge " + l_none + "\n");
      s = s.write("    movzbq (%rax,%rdx,8), %r9\n    cmpq %rcx, %r9\n    je " + l_done + "\n");
      s = s.write("    addq $1, %rdx\n    jmp " + l_tail + "\n");
      s = s.write(l_none + ":\n    movq $-1, %rdx\n");
      return s.write(l_done + ":\n    pushq %rdx\n");
    }
    s = s.write("    movd %ecx, %xmm1\n    punpcklbw %xmm1, %xmm1\n");
    s = s.write("    punpcklwd %xmm1, %xmm1\n    pshufd $0, %xmm1, %xmm1\n");
    s = s.write("    vpbroadcastb %xmm1, %ymm1\n");
    s = s.write("    leaq (%rax,%rdx), %r9\n    leaq -32(%rax,%r8), %r10\n");
    s = s.write("    cmpq %r10, %r9\n    jg " + l_avx_done + "\n");
    s = s.write(l_avx + ":\n");
    s = s.write("    vpcmpeqb (%r9), %ymm1, %ymm0\n");
    s = s.write("    vpmovmskb %ymm0, %r11d\n    testl %r11d, %r11d\n    jnz " + l_hit32 + "\n");
    s = s.write("    addq $32, %r9\n    cmpq %r10, %r9\n    jle " + l_avx + "\n");
    s = s.write("    subq %rax, %r9\n    movq %r9, %rdx\n    jmp " + l_avx_done + "\n");
    s = s.write(l_hit32 + ":\n    vzeroupper\n    bsfl %r11d, %r11d\n");
    s = s.write("    subq %rax, %r9\n    leaq (%r9,%r11), %rdx\n    jmp " + l_done + "\n");
    s = s.write(l_avx_done + ":\n    vzeroupper\n");
    s = s.write(l_vec + ":\n");
    s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
    s = s.write("    cmpq $16, %r9\n    jl " + l_tail + "\n");
    s = s.write("    movdqu (%rax,%rdx), %xmm0\n    pcmpeqb %xmm1, %xmm0\n");
    s = s.write("    pmovmskb %xmm0, %r9d\n    testl %r9d, %r9d\n    jnz " + l_hit + "\n");
    s = s.write("    addq $16, %rdx\n    jmp " + l_vec + "\n");
    s = s.write(l_hit + ":\n    bsfl %r9d, %r9d\n    addq %r9, %rdx\n    jmp " + l_done + "\n");
    s = s.write(l_tail + ":\n");
    s = s.write("    cmpq %r8, %rdx\n    jge " + l_none + "\n");
    // Fewer than 16 bytes remain. One 16-byte load that stays in its page
    // covers them; a first match at or past the end is no match.
    s = s.write("    leaq (%rax,%rdx), %r9\n    movl %r9d, %r10d\n    andl $4095, %r10d\n");
    s = s.write("    cmpl $4080, %r10d\n    ja " + l_bytes + "\n");
    s = s.write("    movdqu (%r9), %xmm0\n    pcmpeqb %xmm1, %xmm0\n    pmovmskb %xmm0, %r9d\n");
    s = s.write("    testl %r9d, %r9d\n    jz " + l_none + "\n    bsfl %r9d, %r9d\n");
    s = s.write("    movq %r8, %r10\n    subq %rdx, %r10\n    cmpq %r10, %r9\n    jae " + l_none + "\n");
    s = s.write("    addq %r9, %rdx\n    jmp " + l_done + "\n");
    s = s.write(l_bytes + ":\n");
    s = s.write("    cmpq %r8, %rdx\n    jge " + l_none + "\n");
    s = s.write("    movzbq (%rax,%rdx), %r9\n");
    s = s.write("    cmpq %rcx, %r9\n    je " + l_done + "\n");
    s = s.write("    addq $1, %rdx\n    jmp " + l_bytes + "\n");
    s = s.write(l_none + ":\n    movq $-1, %rdx\n");
    s = s.write(l_done + ":\n    pushq %rdx\n");
    return s;
  }
  if (o.kind_tag == ir.K_RMEMCHR || o.kind_tag == ir.K_RMEMCHR_BYTES) {
    let rlo = asmcore.fresh_label(s);
    let r_ok = rlo.name;
    let rlo2 = asmcore.fresh_label(rlo.state);
    let r_vec = rlo2.name;
    let rlo3 = asmcore.fresh_label(rlo2.state);
    let r_hit = rlo3.name;
    let rlo4 = asmcore.fresh_label(rlo3.state);
    let r_step = rlo4.name;
    let rlo5 = asmcore.fresh_label(rlo4.state);
    let r_tail = rlo5.name;
    let rlo6 = asmcore.fresh_label(rlo5.state);
    let r_loop = rlo6.name;
    let rlo7 = asmcore.fresh_label(rlo6.state);
    let r_none = rlo7.name;
    let rlo8 = asmcore.fresh_label(rlo7.state);
    let r_done = rlo8.name;
    let rlo9 = asmcore.fresh_label(rlo8.state);
    let r_avx = rlo9.name;
    let rlo10 = asmcore.fresh_label(rlo9.state);
    let r_hit32 = rlo10.name;
    let rlo11 = asmcore.fresh_label(rlo10.state);
    let r_avx_done = rlo11.name;
    s = rlo11.state;
    s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n");
    if (o.kind_tag == ir.K_RMEMCHR_BYTES) {
      s = s.write("    movq (%rax), %r8\n    addq $8, %rax\n");
    } else {
      s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
    }
    s = s.write("    cmpq $255, %rcx\n    ja " + r_none + "\n");
    s = s.write("    subq $1, %r8\n    cmpq $0, %r8\n    jl " + r_none + "\n");
    s = s.write("    cmpq %r8, %rdx\n    jle " + r_ok + "\n    movq %r8, %rdx\n");
    s = s.write(r_ok + ":\n");
    if (o.kind_tag == ir.K_RMEMCHR_BYTES && !ir.is_packed(o)) {
      s = s.write(r_tail + ":\n    cmpq $0, %rdx\n    jl " + r_none + "\n");
      s = s.write("    movzbq (%rax,%rdx,8), %r9\n    cmpq %rcx, %r9\n    je " + r_done + "\n");
      s = s.write("    subq $1, %rdx\n    jmp " + r_tail + "\n");
      s = s.write(r_none + ":\n    movq $-1, %rdx\n");
      return s.write(r_done + ":\n    pushq %rdx\n");
    }
    s = s.write("    movd %ecx, %xmm1\n    punpcklbw %xmm1, %xmm1\n");
    s = s.write("    punpcklwd %xmm1, %xmm1\n    pshufd $0, %xmm1, %xmm1\n");
    s = s.write("    vpbroadcastb %xmm1, %ymm1\n");
    s = s.write("    cmpq $31, %rdx\n    jl " + r_avx_done + "\n");
    s = s.write("    leaq -31(%rax,%rdx), %r9\n");
    s = s.write(r_avx + ":\n");
    s = s.write("    vpcmpeqb (%r9), %ymm1, %ymm0\n");
    s = s.write("    vpmovmskb %ymm0, %r11d\n    testl %r11d, %r11d\n    jnz " + r_hit32 + "\n");
    s = s.write("    subq $32, %r9\n    cmpq %rax, %r9\n    jge " + r_avx + "\n");
    s = s.write("    subq %rax, %r9\n    leaq 31(%r9), %rdx\n    jmp " + r_avx_done + "\n");
    s = s.write(r_hit32 + ":\n    vzeroupper\n    bsrl %r11d, %r11d\n");
    s = s.write("    subq %rax, %r9\n    leaq (%r9,%r11), %rdx\n    jmp " + r_done + "\n");
    s = s.write(r_avx_done + ":\n    vzeroupper\n");
    s = s.write("    cmpq $15, %rdx\n    jl " + r_tail + "\n");
    s = s.write("    movq %rdx, %r9\n    subq $15, %r9\n");
    s = s.write("    movq %rax, %r10\n    addq %r9, %r10\n");
    s = s.write(r_vec + ":\n");
    s = s.write("    movdqu (%r10), %xmm0\n    pcmpeqb %xmm1, %xmm0\n");
    s = s.write("    pmovmskb %xmm0, %r11d\n    testl %r11d, %r11d\n    jnz " + r_hit + "\n");
    s = s.write("    subq $16, %r9\n    cmpq $0, %r9\n    jge " + r_step + "\n");
    s = s.write("    addq $15, %r9\n    movq %r9, %rdx\n    jmp " + r_tail + "\n");
    s = s.write(r_step + ":\n    subq $16, %r10\n    jmp " + r_vec + "\n");
    s = s.write(r_hit + ":\n    bsrl %r11d, %r11d\n");
    s = s.write("    movq %r9, %rdx\n    addq %r11, %rdx\n    jmp " + r_done + "\n");
    s = s.write(r_tail + ":\n");
    s = s.write("    cmpq $0, %rdx\n    jl " + r_none + "\n");
    s = s.write(r_loop + ":\n");
    s = s.write("    movzbq (%rax,%rdx), %r9\n");
    s = s.write("    cmpq %rcx, %r9\n    je " + r_done + "\n");
    s = s.write("    subq $1, %rdx\n    cmpq $0, %rdx\n    jge " + r_loop + "\n");
    s = s.write(r_none + ":\n    movq $-1, %rdx\n");
    s = s.write(r_done + ":\n    pushq %rdx\n");
    return s;
  }
  if (o.kind_tag == ir.K_COUNT_BYTE || o.kind_tag == ir.K_COUNT_BYTE_BYTES) {
    let clo = asmcore.fresh_label(s);
    let c_vec = clo.name;
    let clo2 = asmcore.fresh_label(clo.state);
    let c_tail = clo2.name;
    let clo3 = asmcore.fresh_label(clo2.state);
    let c_next = clo3.name;
    let clo4 = asmcore.fresh_label(clo3.state);
    let c_done = clo4.name;
    let clo5 = asmcore.fresh_label(clo4.state);
    let c_avx = clo5.name;
    let clo6 = asmcore.fresh_label(clo5.state);
    let c_avx_done = clo6.name;
    let clo7 = asmcore.fresh_label(clo6.state);
    let c_wide = clo7.name;
    let clo8 = asmcore.fresh_label(clo7.state);
    let c_small_wide = clo8.name;
    let clo9 = asmcore.fresh_label(clo8.state);
    let c_batch_loop = clo9.name;
    s = clo9.state;
    s = s.write("    popq %rcx\n    popq %rax\n");
    if (o.kind_tag == ir.K_COUNT_BYTE_BYTES) {
      s = s.write("    movq (%rax), %r8\n    addq $8, %rax\n");
    } else {
      s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
    }
    s = s.write("    xorq %rdx, %rdx\n    xorq %r10, %r10\n");
    s = s.write("    cmpq $255, %rcx\n    ja " + c_done + "\n");
    if (o.kind_tag == ir.K_COUNT_BYTE_BYTES && !ir.is_packed(o)) {
      s = s.write(c_tail + ":\n    cmpq %r8, %rdx\n    jge " + c_done + "\n");
      s = s.write("    movzbq (%rax,%rdx,8), %r9\n    cmpq %rcx, %r9\n    jne " + c_next + "\n");
      s = s.write("    addq $1, %r10\n");
      s = s.write(c_next + ":\n    addq $1, %rdx\n    jmp " + c_tail + "\n");
      return s.write(c_done + ":\n    pushq %r10\n");
    }
    s = s.write("    movd %ecx, %xmm1\n    punpcklbw %xmm1, %xmm1\n");
    s = s.write("    punpcklwd %xmm1, %xmm1\n    pshufd $0, %xmm1, %xmm1\n");
    s = s.write("    vpbroadcastb %xmm1, %ymm1\n");
    s = s.write(c_wide + ":\n    movq %r8, %r9\n    subq %rdx, %r9\n");
    s = s.write("    cmpq $128, %r9\n    jl " + c_avx + "\n");
    s = s.write("    cmpq $1024, %r9\n    jl " + c_small_wide + "\n");
    s = s.write("    leaq 1024(%rdx), %r11\n    vpxor %ymm2, %ymm2, %ymm2\n");
    // Each byte lane accumulates at most 32 matches before the horizontal sum.
    s = s.write(c_batch_loop + ":\n");
    for off in ["", "32", "64", "96"] {
      s = s.write("    vpcmpeqb " + off + "(%rax,%rdx), %ymm1, %ymm0\n    vpsubb %ymm0, %ymm2, %ymm2\n");
    }
    s = s.write("    addq $128, %rdx\n    cmpq %r11, %rdx\n    jl " + c_batch_loop + "\n");
    s = s.write("    vpxor %ymm3, %ymm3, %ymm3\n    vpsadbw %ymm3, %ymm2, %ymm2\n");
    s = s.write("    subq $32, %rsp\n    vmovdqu %ymm2, (%rsp)\n");
    s = s.write("    addq (%rsp), %r10\n    addq 8(%rsp), %r10\n    addq 16(%rsp), %r10\n    addq 24(%rsp), %r10\n");
    s = s.write("    addq $32, %rsp\n    jmp " + c_wide + "\n");
    s = s.write(c_small_wide + ":\n");
    s = s.write("    vpcmpeqb (%rax,%rdx), %ymm1, %ymm0\n    vpcmpeqb 32(%rax,%rdx), %ymm1, %ymm2\n");
    s = s.write("    vpmovmskb %ymm0, %r9d\n    vpmovmskb %ymm2, %r11d\n");
    s = s.write("    popcntl %r9d, %r9d\n    popcntl %r11d, %r11d\n    addq %r9, %r10\n    addq %r11, %r10\n");
    s = s.write("    vpcmpeqb 64(%rax,%rdx), %ymm1, %ymm0\n    vpcmpeqb 96(%rax,%rdx), %ymm1, %ymm2\n");
    s = s.write("    vpmovmskb %ymm0, %r9d\n    vpmovmskb %ymm2, %r11d\n");
    s = s.write("    popcntl %r9d, %r9d\n    popcntl %r11d, %r11d\n    addq %r9, %r10\n    addq %r11, %r10\n");
    s = s.write("    addq $128, %rdx\n    jmp " + c_wide + "\n");
    s = s.write(c_avx + ":\n");
    s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
    s = s.write("    cmpq $32, %r9\n    jl " + c_avx_done + "\n");
    s = s.write("    vmovdqu (%rax,%rdx), %ymm0\n    vpcmpeqb %ymm1, %ymm0, %ymm0\n");
    s = s.write("    vpmovmskb %ymm0, %r9d\n    popcntl %r9d, %r9d\n");
    s = s.write("    addq %r9, %r10\n    addq $32, %rdx\n    jmp " + c_avx + "\n");
    s = s.write(c_avx_done + ":\n    vzeroupper\n");
    s = s.write(c_vec + ":\n");
    s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
    s = s.write("    cmpq $16, %r9\n    jl " + c_tail + "\n");
    s = s.write("    movdqu (%rax,%rdx), %xmm0\n    pcmpeqb %xmm1, %xmm0\n");
    s = s.write("    pmovmskb %xmm0, %r9d\n    popcntl %r9d, %r9d\n");
    s = s.write("    addq %r9, %r10\n    addq $16, %rdx\n    jmp " + c_vec + "\n");
    s = s.write(c_tail + ":\n");
    s = s.write("    cmpq %r8, %rdx\n    jge " + c_done + "\n");
    s = s.write("    movzbq (%rax,%rdx), %r9\n");
    s = s.write("    cmpq %rcx, %r9\n    jne " + c_next + "\n");
    s = s.write("    addq $1, %r10\n");
    s = s.write(c_next + ":\n    addq $1, %rdx\n    jmp " + c_tail + "\n");
    s = s.write(c_done + ":\n    pushq %r10\n");
    return s;
  }
  if (o.kind_tag == ir.K_COUNT_BELOW_U64) {
    return emit_count_below_u64(s);
  }
  if (o.kind_tag == ir.K_SCALE_F64) {
    let flo = asmcore.fresh_label(s);
    let sf_loop = flo.name;
    let flo2 = asmcore.fresh_label(flo.state);
    let sf_done = flo2.name;
    let flo3 = asmcore.fresh_label(flo2.state);
    let sf_vec = flo3.name;
    let flo4 = asmcore.fresh_label(flo3.state);
    let sf_vend = flo4.name;
    s = flo4.state;
    s = s.write("    popq %rcx\n    popq %rax\n");
    if (o.i32_imm == 1) {
