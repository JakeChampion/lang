    s = s.write("    call __fn___fern_fd_flags\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("fd_flags");
  } else if (o.kind_tag == 242) {
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_reader_seek\n    addq $24, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("reader_seek");
  } else if (o.kind_tag == 330) {
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_reader_splice\n    addq $24, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("reader_splice");
  } else if (o.kind_tag == 407) {
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_reader_copy_range\n    addq $24, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("reader_copy_range");
  } else if (o.kind_tag == 281) {
    s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
    s = s.write("    call __fn___fern_writer_truncate\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("writer_truncate");
  } else if (o.kind_tag >= 291 && o.kind_tag <= 297 || o.kind_tag == 306 || o.kind_tag == 325 || o.kind_tag == 326 || o.kind_tag == 328 || o.kind_tag == 347 || o.kind_tag == 351 || o.kind_tag == 370 || o.kind_tag == 371 || o.kind_tag == 372 || o.kind_tag == 386) {
    s = emit_ir_op_buf(o, s);
  } else if (o.kind_tag == 181) {
    s = s.write("    call __fn___fern_sleep_ms\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("sleep_ms");
  } else if (o.kind_tag == 266) {
    s = s.write("    call __fn___fern_sleep_ns\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("sleep_ns");
  } else if (o.kind_tag == 146) {
    s = emit_ir_op_dyn_box(o, s);
  } else {
    ircore.flat_arm_missing(o);
  }
  return s;
}

function emit_ir_op_buf(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  if (o.kind_tag == 296) {
    s = s.need("buf_text");
  }
  if (o.kind_tag == 347) {
    s = s.need("buf_take_bytes" + asmcore.packed_suffix(ir.is_packed(o)));
  }
  if (o.kind_tag == 351) {
    s = s.need("buf_push_bytes_range" + asmcore.packed_suffix(ir.is_packed(o)));
  }
  let k: i32 = asmcore.buf_arity(o.kind_tag);
  while (k > 0) {
    k = k - 1;
    s = s.write("    popq " + ssa_arg_regs()[k] + "\n");
  }
  let sym: string = asmcore.buf_table_helper(o.kind_tag, ir.is_packed(o));
  s = s.write("    call " + sym + "\n    pushq %rax\n");
  s = s.need("heap");
  if (o.kind_tag >= 370 && o.kind_tag <= 372) {
    if (sym != asmcore.buf_helper(o.kind_tag)) {
      s = s.need("buf_bytes_u8");
    } else {
      s = s.need("buf_bytes");
    }
  } else if (o.kind_tag != 347 && o.kind_tag != 351 && sym != asmcore.buf_helper(o.kind_tag)) {
    s = s.need("buf_u8");
  }
  return s.need("buf");
}

function const_text_u32(t: string): boolean {
  if (t.len() > 2 && t[0] == 48 && (t[1] == 120 || t[1] == 88)) {
    return t.len() <= 10 && hex_digits(t, 2);
  }
  if (!util.is_all_digits(t) || t.len() > 10) {
    return false;
  }
  return util.digits_to_i64(t) <= 4294967295i64;
}

function hex_digits(t: string, from: i32): boolean {
  if (from >= t.len()) {
    return false;
  }
  let i: i32 = from;
  while (i < t.len()) {
    let c: i32 = t[i] as i32;
    let ok: boolean = c >= 48 && c <= 57 || c >= 97 && c <= 102 || c >= 65 && c <= 70;
    if (!ok) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function emit_ir_op_heap_bump_bytes(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
  s = s.write("    movq __fern_heap_end(%rip), %rcx\n");
  s = s.write("    movabs $17179869184, %rdx\n");
  s = s.write("    subq %rdx, %rcx\n");
  s = s.write("    movq %rax, %rdx\n");
  s = s.write("    subq %rcx, %rdx\n");
  s = s.write("    xorq %rcx, %rcx\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    cmovneq %rdx, %rcx\n");
  s = s.write("    pushq %rcx\n");
  s = s.need("heap");

  return s;
}

function emit_ir_op_heap_alloc_count(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movq __fern_alloc_count(%rip), %rax\n");
  s = s.write("    pushq %rax\n");
  s = s.need("heap");
  s = s.need("alloc_count");

  return s;
}

function emit_ir_op_heap_mark(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
  s = s.write("    pushq %rcx\n    pushq %rsi\n    pushq %rdi\n");
  s = s.write("    leaq __fern_freelist(%rip), %rsi\n");
  s = s.write("    leaq __fern_freelist_shadow(%rip), %rdi\n");
  s = s.write("    movl $65536, %ecx\n    rep movsq\n");
  s = s.write("    leaq __fern_large_freelist(%rip), %rsi\n");
  s = s.write("    leaq __fern_large_freelist_shadow(%rip), %rdi\n");
  s = s.write("    movl $2560, %ecx\n    rep movsq\n");
  s = s.write("    popq %rdi\n    popq %rsi\n    popq %rcx\n");
  s = s.write("    pushq %rax\n");
  s = s.need("heap");

  return s;
}

function emit_ir_op_heap_release_to(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let hrlo: asmcore.LabelOut = asmcore.fresh_label(s);
  let hrl_done: string = hrlo.name;
  s = hrlo.state;
  s = s.write("    popq %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jz " + hrl_done + "\n");
  s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
  s = s.write("    pushq %rcx\n    pushq %rsi\n    pushq %rdi\n");
  s = s.write("    leaq __fern_freelist_shadow(%rip), %rsi\n");
  s = s.write("    leaq __fern_freelist(%rip), %rdi\n");
  s = s.write("    movl $65536, %ecx\n    rep movsq\n");
  s = s.write("    leaq __fern_large_freelist_shadow(%rip), %rsi\n");
  s = s.write("    leaq __fern_large_freelist(%rip), %rdi\n");
  s = s.write("    movl $2560, %ecx\n    rep movsq\n");
  s = s.write("    popq %rdi\n    popq %rsi\n    popq %rcx\n");
  s = s.write(hrl_done + ":\n");
  s = s.write("    pushq %rax\n");
  s = s.need("heap");

  return s;
}

function helper_call_needs(name: string, s: asmcore.EmitState): asmcore.EmitState {
  if (name == "__fern_oob_abort" || name == "__fern_slice_abort") {
    s = s.need("heap");
  }
  if (name == "__fern_i32_to_string") {
    s = s.need("heap");
    s = s.need("i32_to_string");
  }
  if (name == "__fern_u32_to_string") {
    s = s.need("heap");
    s = s.need("u32_to_string");
  }
  if (name == "__fern_i64_to_string") {
    s = s.need("heap");
    s = s.need("i64_to_string");
  }
  if (name == "__fern_u64_to_string") {
    s = s.need("heap");
    s = s.need("u64_to_string");
  }
  s = s.need_array_helper(name);
  if (name == "__fern_arr_inc_elems") {
    s = s.need("arr_inc_elems");
  }
  if (name == "__fern_arr_own_elems") {
    s = s.need("arr_own_elems");
  }
  if (name == "__fern_str_own") {
    s = s.need("str_own");
  }
  if (name == "__fern_str_borrow") {
    s = s.need("str_borrow");
  }
  if (name == "__fern_str_grow" || name == "__fern_str_grow_range" || name == "__fern_str_grow_fresh" || name == "__fern_str_grow_fresh_range") {
    s = s.need("str_grow");
  }
  if (name == "__fern_account_entry") {
    s = s.need("account");
  }
  if (name == "__fern_set_args") {
    s = s.need("set_args");
  }
  return s;
}

function dyn_arg_operand(a: asmcore.DynArg): string {
  if (a.reg.len() > 0) {
    return a.reg;
  }
  return util.i32_to_string(a.off) + "(%rbp)";
}

function emit_dyn_dispatch_chain(arms: string, args: asmcore.DynArg[], i: i32, lp: string, own s: asmcore.EmitState): asmcore.EmitState {
  let dargc: i32 = args.len();
  s = s.write("    movq " + dyn_arg_operand(args[0]) + ", %rax\n");
  s = s.write("    movq (%rax), %rcx\n");
  let dend: string = lp + "dynend" + util.i32_to_string(i);
  let dfi: i32 = 0;
  let darmn: i32 = 0;
  while (dfi < s.funcs.len()) {
    let dfd: parser.FuncDecl = s.funcs[dfi];
    let ddbn: string = util.base_type_name(dfd.receiver_type);
    let dprim: boolean = dfd.receiver_type.len() > 0 && asmcore.is_prim_recv_name(ddbn, s);
    if (irtables.dyn_arm_matches(dfd, arms) && dfd.receiver_type.len() > 0
      && (asmcore.is_struct_decl_name(ddbn, s) || dprim)) {
      let dbn: string = ddbn;
      let dlit: asmcore.ShapeRefOut = asmcore.shape_ref(s, dbn);
      s = dlit.state;
      let dnext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      s = ssa_lea_sym(s, dlit.label, "%rdx");
      s = s.write("    cmpq %rdx, %rcx\n");
      s = s.write("    jne " + dnext + "\n");
      let dk: i32 = dargc - 1;
      while (dk >= 0) {
        if (dk == 0 && dprim) {
          s = s.write("    movq " + dyn_arg_operand(args[0]) + ", %rax\n");
          s = s.write("    pushq 8(%rax)\n");
        } else {
          s = s.write("    pushq " + dyn_arg_operand(args[dk]) + "\n");
        }
        dk = dk - 1;
      }
      s = s.write("    call __fn_" + asmcore.sanitize_label(dbn + "." + dfd.name) + "\n");
      s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
      s = s.write("    jmp " + dend + "\n");
      s = s.write(dnext + ":\n");
      darmn = darmn + 1;
    }
    if (irtables.dyn_arm_matches(dfd, arms) && dfd.receiver_type.len() > 0
      && !asmcore.recv_is_array(dfd.receiver_type)
      && irtables.decl_is_enum(s.struct_decls, ddbn)) {
      let dehit: string = lp + "dynehit" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      let denext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      let dvi: i32 = 0;
      while (dvi < s.struct_decls.decls.len()) {
        if (s.struct_decls.decls[dvi].enum_owner == ddbn) {
          let vlit_name: string = irtables.decl_shape(s.struct_decls.decls[dvi]);
          let vlit: asmcore.ShapeRefOut = asmcore.shape_ref(s, vlit_name);
          s = vlit.state;
          s = ssa_lea_sym(s, vlit.label, "%rdx");
          s = s.write("    cmpq %rdx, %rcx\n");
          s = s.write("    je " + dehit + "\n");
        }
        dvi = dvi + 1;
      }
      s = s.write("    jmp " + denext + "\n");
      s = s.write(dehit + ":\n");
      let dek: i32 = dargc - 1;
      while (dek >= 0) {
        s = s.write("    pushq " + dyn_arg_operand(args[dek]) + "\n");
        dek = dek - 1;
      }
      s = s.write("    call __fn_" + asmcore.sanitize_label(ddbn + "." + dfd.name) + "\n");
      s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
      s = s.write("    jmp " + dend + "\n");
      s = s.write(denext + ":\n");
      darmn = darmn + 1;
    }
    dfi = dfi + 1;
  }
  s = s.write("    movq $231, %rax\n    movq $134, %rdi\n").syscall(231);
  s = s.write(dend + ":\n");
  return s;
}

function emit_ir_op_dyn_box(o: ir.Op, own s: asmcore.EmitState): asmcore.EmitState {
  let dbl: asmcore.ShapeRefOut = asmcore.shape_ref(s, o.str);
  s = dbl.state;
  s = s.write("    movq $2, %rdi\n    call __fern_arr_box\n");
  s = ssa_lea_sym(s, dbl.label, "%rcx");
  s = s.write("    movq %rcx, (%rax)\n");
  s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");

  return s;
}

function ir_i2f_rax(width: i32, unsigned: boolean, lb: string, d: string): string {
  if (width == 64 && unsigned) {
    let u: string = "    testq " + d + ", " + d + "\n    js " + lb + "_big\n";
    u = u + "    cvtsi2sd " + d + ", %xmm0\n    jmp " + lb + "_done\n";
    u = u + lb + "_big:\n";
    u = u + "    movq " + d + ", %rcx\n    shrq $1, %rcx\n    andl $1, " + ssa_r32(d) + "\n    orq " + d + ", %rcx\n";
    u = u + "    cvtsi2sd %rcx, %xmm0\n    addsd %xmm0, %xmm0\n";
    u = u + lb + "_done:\n    movq %xmm0, " + d + "\n";
    return u;
  }
  if (unsigned) {
    return "    movl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n    cvtsi2sd " + d + ", %xmm0\n    movq %xmm0, " + d + "\n";
  }
  return "    cvtsi2sd " + d + ", %xmm0\n    movq %xmm0, " + d + "\n";
}

function emit_array_helpers(s: asmcore.EmitState): asmcore.EmitState {
  if (s.has_need("byte_append") || s.has_need("byte_write")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_byte_copy(s.has_need("byte_append"), s.has_need("byte_write")), s);
  }
  if (s.has_need("arr_str_join")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_str_join(), s);
  }
  if (s.has_need("arr_concat")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_concat(), s);
  }
  if (s.has_need("bytes_owned")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_bytes_owned(), s);
  }
  if (s.has_need("bytes_range")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_bytes_range(), s);
  }
  if (s.has_need("bytes_into")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_bytes_into(), s);
  }
  return s;
}

function emit_ir_runtime_fern_fn(src: string, s: asmcore.EmitState): asmcore.EmitState {
  let m: parser.Module = parser.infer_ret_types_module(parser.parse_module(lexer.tokenize(src)));
  let fns: parser.FuncDecl[] = m.funcs;
  let lit0: i32 = s.string_lits.len();
  let agg0: i32 = s.const_aggs.len();
  let sh0: i32 = s.shape_lits.len();
  let lowered: physicalbody.Lowered = s.rt_lower(src);
  let bodies: irtables.LowerResult[] = lowered.bodies;
  let physical = physicalbody.collection(lowered);
  let previous_regs: irtables.SigReg = s.reg_entries;
  let previous_leaves: ssa.Leaves = s.leaves;
  let previous_float: asmcore.FloatAbi = asmcore.FloatAbi { names: s.float_abi, masks: s.float_abi_masks };
  let unit: asmcore.UnitLeaves = asmcore.unit_leaves(m, 0, fns.len(), bodies);
  let fabi: asmcore.FloatAbi = asmcore.unit_float_abi(m, 0, fns.len(), bodies);
  s = asmcore.EmitState { ...s, reg_entries: irtables.sig_reg_of(asmcore.unit_labels(m, 0, fns.len(), bodies)), leaves: unit.leaves, float_abi: fabi.names, float_abi_masks: fabi.masks };
  let vgate: irverifygate.Gate = irverifygate.with_memo(irverifygate.gate_unreported(irtables.fn_sig_index(fns), s.kinds.pops, physicalbody.abis(physical)), s.memo);
  s = asmcore.export_runtime_fns(s, fns);
  let i: i32 = 0;
  while (i < fns.len()) {
    s = emit_function_via_ir_pre(bodies[i], physicalbody.select(physical, i), s.prelift(unit.pre, i, bodies[i]), fns[i], s, vgate);
    i = i + 1;
  }
  s = emit_named_bodies(bodies, physical, unit.pre, fns.len(), s, vgate);
  if (s.shape_lits.len() > sh0) {
    s = asmcore.emit_shape_lits_from(s, sh0);
    s = s.write("    .text\n");
  }
  if (s.string_lits.len() > lit0) {
    s = s.write("    .section .rodata\n");
    let li: i32 = lit0;
    while (li < s.string_lits.len()) {
      s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
      li = li + 1;
    }
    s = asmcore.emit_str_box_data_from(s, lit0);
    s = s.write("    .text\n");
  }
  if (s.const_aggs.len() > agg0) {
    s = asmcore.emit_const_agg_data_from(s, agg0);
    s = s.write("    .text\n");
  }
  return asmcore.EmitState { ...s, reg_entries: previous_regs, leaves: previous_leaves, float_abi: previous_float.names, float_abi_masks: previous_float.masks };
}

function emit_module_funcs(mod: parser.Module, all_funcs: parser.FuncDecl[], s: asmcore.EmitState, globl_defs: boolean, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, check_claims: boolean): asmcore.EmitState {
  let vgate: irverifygate.Gate = irverifygate.with_memo(irverifygate.gate(irtables.fn_sig_index(all_funcs), s.kinds.pops, physicalbody.abis(physical)), s.memo);
  let hh: i32 = hi;
  if (hh < 0 || hh > mod.funcs.len()) {
    hh = mod.funcs.len();
  }
  if (check_claims) {
    ircore.check_fip_claims(mod.funcs, lo, hh, cache);
  }
  let unit: asmcore.UnitLeaves = asmcore.unit_leaves(mod, lo, hh, cache);
  s = asmcore.EmitState { ...s, reg_entries: irtables.sig_reg_of(asmcore.unit_labels(mod, lo, hh, cache)), leaves: unit.leaves };
  let fabi: asmcore.FloatAbi = asmcore.unit_float_abi(mod, lo, hh, cache);
  s = asmcore.EmitState { ...s, float_abi: fabi.names, float_abi_masks: fabi.masks };
  let fi: i32 = lo;
  while (fi < hh) {
    let r: irtables.LowerResult = ircore.produced(cache, fi, mod.funcs[fi]);
    if (r.superseded) {
      fi = fi + 1;
      continue;
    }
    if (globl_defs) {
      let gname: string = mod.funcs[fi].name;
      if (mod.funcs[fi].receiver_type.len() > 0) {
        gname = util.base_type_name(mod.funcs[fi].receiver_type) + "." + mod.funcs[fi].name;
      }
      s = s.write(".globl __fn_" + asmcore.sanitize_label(gname) + "\n.globl __fn_" + asmcore.sanitize_label(gname) + ".r\n");
    }
    s = emit_function_via_ir_pre(r, physicalbody.select(physical, fi), s.prelift(unit.pre, fi, r), mod.funcs[fi], s, vgate);
    fi = fi + 1;
  }
  s = emit_named_bodies(cache, physical, unit.pre, mod.funcs.len(), s, vgate);
  irverifygate.report(vgate);
  return s;
}

function emit_named_bodies(cache: irtables.LowerResult[], physical: physicalbody.Collection, pre: asmcore.Prelift[], from: i32, s: asmcore.EmitState, vgate: irverifygate.Gate): asmcore.EmitState {
  let xi: i32 = from;
  while (xi < cache.len()) {
    if (!s.has_named(cache[xi].name)) {
      s = emit_function_via_ir_named(cache[xi], physicalbody.select(physical, xi), s.prelift(pre, xi, cache[xi]), cache[xi].name, true, s, vgate).with_named(cache[xi].name);
    }
    xi = xi + 1;
  }
  return s;
}

pub function module_runtime_needs(mod: parser.Module, all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, cache: irtables.LowerResult[], physical: physicalbody.Collection): string[] {
  let s: asmcore.EmitState = asmcore.new_state();
  s = asmcore.with_funcs(asmcore.EmitState { ...s, struct_decls: all_structs, retain_prepared: false, memo: irverifygate.open_memo("x86-64") }, all_funcs);
  s = emit_module_funcs(mod, all_funcs, s, false, 0, 0 - 1, cache, physical, false);
  irverifygate.close_memo(s.memo);
  s.release();
  return s.needed;
}

pub function emit_module_or_error_sub(mod: parser.Module, sub: ircore.Sub, recs: usize): string {
  if (!sub.checked) {
    let parse_errs: util.Diag[] = asmcore.parse_unknown_errors_module(mod);
    if (parse_errs.len() > 0) {
      eprint(util.format_diags(parse_errs));
      exit(1);
      return "";
    }
  }
  let tm: parser.Module = checker.ensure_annotated(mod);
  if (!sub.checked) {
    let check_errs: util.Diag[] = asmcore.entry_check_errors(tm);
    if (check_errs.len() > 0) {
      eprint(util.format_diags(check_errs));
      exit(1);
      return "";
    }
  }
  let lm: parser.Module = ircore.sub_lifted(sub, tm);
  let g: string = emit_module_ir_gated_sub(lm, sub, recs);
  if (g != "") {
    return g;
  }
  ircore.eprint_ir_ineligible();
  exit(1);
  return "";
}

pub function emit_module_ir_gated_sub(mod: parser.Module, sub: ircore.Sub, recs: usize): string {
  let g: ircore.Gated = ircore.gate_program(mod, sub);
  if (!g.ok) {
    return "";
  }
  return emit_module_ir_unit_flat(g.im, true, false, "", [], g.im.funcs, g.stab, 0, 0 - 1, ircore.inline_tiny_leaves(g.im, g.cache), g.physical, sub.rt_lower, recs, sub.switches);
}

pub function emit_module_ir_unit_flat(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (string) => physicalbody.Lowered, recs: usize, sw: asmcore.Switches): string {
  return emit_module_ir_unit_prepared(mod, is_entry, globl_defs, str_ns, extra_needs, all_funcs, all_structs, lo, hi, cache, physical, rt, recs, sw, false).text;
}

pub function emit_module_ir_unit_prepared(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (string) => physicalbody.Lowered, recs: usize, sw: asmcore.Switches, retain: boolean): ssaprepare.Output {
  let s: asmcore.EmitState = asmcore.new_state();
  s = asmcore.EmitState { ...s, retain_prepared: retain, memo: irverifygate.open_memo("x86-64") };
  s = asmcore.with_funcs(asmcore.with_switches(asmcore.EmitState { ...s, struct_decls: all_structs, str_ns: str_ns, rt_lower: rt, recs: recs }, sw), all_funcs);
  let derrs: util.Diag[] = asmcore.display_errs_module(mod, s);
  if (derrs.len() > 0) {
    eprint(util.format_diags(derrs));
    exit(1);
    return ssaprepare.Output { text: "", bodies: [] };
  }
  if (globl_defs && asmcore.sandbox_on()) {
    eprint("fern: FERN_SANDBOX=1 needs the whole-program emit; a per-module unit cannot see its siblings' syscalls");
    exit(1);
    return ssaprepare.Output { text: "", bodies: [] };
  }
  if (is_entry) {
    s = s.write("    .globl _start\n");
  }
  s = s.write("    .text\n");
  if (is_entry && globl_defs) {
    s = asmcore.emit_runtime_globls(s);
  }
  s = emit_module_funcs(mod, all_funcs, s, globl_defs, lo, hi, cache, physical, true);
  let en: i32 = 0;
  while (en < extra_needs.len()) {
    s = s.need(extra_needs[en]);
    en = en + 1;
  }
  if (is_entry && globl_defs) {
    s = emit_trap_stub_globls(s);
  }
  if (is_entry) {
    s = emit_process_entry(mod, s);
  }
  s = intern_runtime_shapes(s);
  s = asmcore.emit_debug_rows(s);
  if (s.string_lits.len() > 0) {
    s = s.write("    .section .rodata\n");
    let li: i32 = 0;
    while (li < s.string_lits.len()) {
      s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
      li = li + 1;
    }
    s = asmcore.emit_str_box_data_from(s, 0);
  }
  s = asmcore.emit_const_agg_data(s);
  s = emit_lane_consts(s);
  s = asmcore.emit_shape_lits_from(s, 0);
  if (is_entry) {
    s = emit_entry_runtime_settled(s);
    if (asmcore.sandbox_on()) {
      s = emit_seccomp_install(s);
    }
  }
  irverifygate.close_memo(s.memo);
  return ssaprepare.Output { text: s.take_text(), bodies: s.prepared };
}

function emit_seccomp_install(s: asmcore.EmitState): asmcore.EmitState {
  if (s.raw_syscall != "") {
    eprint("fern: " + s.raw_syscall + " passes the syscall number at run time, which the seccomp sandbox cannot allowlist; FERN_SANDBOX=1 refuses the program");
    exit(1);
    return s;
  }
  let allowed: i32[] = s.syscalls;
  let n: i32 = allowed.len();
  if (n > 255) {
    eprint("internal error: the seccomp allowlist has " + util.i32_to_string(n) + " syscalls; the u8 jump offset caps it at 255");
    exit(3);
    return s;
  }
  s = s.write("    .section .text\n__fern_seccomp_install:\n");
  s = s.write("    movq $38, %rdi\n    movq $1, %rsi\n    movq $0, %rdx\n    movq $0, %r10\n    movq $0, %r8\n    movq $157, %rax\n").syscall(157);
  s = s.write("    subq $16, %rsp\n    movq $" + util.i32_to_string(n + 6) + ", %rax\n    movq %rax, (%rsp)\n");
  s = s.write("    leaq .Lseccomp_filter(%rip), %rax\n    movq %rax, 8(%rsp)\n");
  s = s.write("    movq $1, %rdi\n    movq $0, %rsi\n    movq %rsp, %rdx\n    movq $317, %rax\n").syscall(317);
  s = s.write("    addq $16, %rsp\n    ret\n");
  s = s.write("    .section .rodata\n    .align 8\n.Lseccomp_filter:\n");
  s = bpf_insn(s, 32, 0, "4");
  s = bpf_insn(s, 21, 1, "0xC000003E");
  s = bpf_insn(s, 6, 0, "0x80000000");
  s = bpf_insn(s, 32, 0, "0");
  let i: i32 = 0;
  while (i < n) {
    s = bpf_insn(s, 21, n - i, util.i32_to_string(allowed[i]));
    i = i + 1;
  }
  s = bpf_insn(s, 6, 0, "0x80000000");
  s = bpf_insn(s, 6, 0, "0x7FFF0000");
  return s.write("    .section .text\n");
}

function bpf_insn(s: asmcore.EmitState, code: i32, jt: i32, k: string): asmcore.EmitState {
  return s.write("    .long " + util.i32_to_string(code + jt * 65536) + ", " + k + "\n");
}

function emit_entry_runtime_settled(s0: asmcore.EmitState): asmcore.EmitState {
  let s: asmcore.EmitState = s0;
  let settled: boolean = false;
  let out: asmcore.EmitState = s0;
  while (!settled) {
    let h: usize = buf_new(65536);
    let t: asmcore.EmitState = emit_entry_runtime(asmcore.EmitState { ...s, capture: h });
    let text: string = buf_take(h);
    buf_free(h);
    if (t.needed.len() == s.needed.len()) {
      settled = true;
      let back: asmcore.EmitState = asmcore.EmitState { ...t, capture: s0.capture };
      out = back.write(text);
    } else {
      s = asmcore.EmitState { ...s0, needed: t.needed };
    }
  }
  return out;
}

function emit_process_entry(mod: parser.Module, own s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("_start:\n");
  if (asmcore.sandbox_on()) {
    s = s.write("    call __fern_seccomp_install\n");
  }
  if (s.has_need("args")) {
    s = s.write("    movq (%rsp), %rax\n");
    s = s.write("    movq %rax, __fern_argc(%rip)\n");
    s = s.write("    leaq 8(%rsp), %rax\n");
    s = s.write("    movq %rax, __fern_argv(%rip)\n");
  }
  if (s.any_need(["env", "subprocess", "environ", "raw_environ"])) {
    s = s.write("    movq (%rsp), %rax\n");
    s = s.write("    leaq 16(%rsp,%rax,8), %rax\n");
    s = s.write("    movq %rax, __fern_envp(%rip)\n");
  }
  if (asmcore.vdso_wanted(s, "x86-64-linux")) {
    s = emit_vdso_scan(s);
  }
  if (!s.shared) {
    s = emit_stack_switch(s);
  }
  if (s.profile > 0) {
    s = s.write("    leaq .Lprofile_ring(%rip), %rax\n    movq %rsp, %rsi\n    leaq .Lprofile_action(%rip), %rdi\n    leaq .Lprofile_timer(%rip), %r8\n    call __fn___fern_profile_start.r\n");
  }
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  return emit_process_finish(mod, s);
}

function emit_stack_switch(own s: asmcore.EmitState): asmcore.EmitState {
  s = emit_stack_map(s, asmcore.stack_size());
  s = s.write("    cmpq $-4096, %rax\n    ja .Lfern_stack_kept\n    movq %rax, %rbx\n    movq %rax, %rdi\n    movq $" + util.i32_to_string(asmcore.stack_guard()) + ", %rsi\n    xorl %edx, %edx\n    movl $10, %eax\n");
  s = s.syscall(10);
  s = s.write("    leaq " + util.i32_to_string(asmcore.stack_size() - 16) + "(%rbx), %rsp\n.Lfern_stack_kept:\n");
  s = emit_stack_map(s, 65536);
  s = s.write("    cmpq $-4096, %rax\n    ja .Lfern_segv_skip\n    subq $32, %rsp\n    movq %rax, (%rsp)\n    movq $0, 8(%rsp)\n    movq $65536, 16(%rsp)\n    movq %rsp, %rdi\n    xorl %esi, %esi\n    movl $131, %eax\n");
  s = s.syscall(131);
  s = s.write("    leaq __fern_segv(%rip), %rax\n    movq %rax, (%rsp)\n    movq $0x0c000004, 8(%rsp)\n");
  s = emit_segv_install(s);
  return s.write("    addq $32, %rsp\n.Lfern_segv_skip:\n");
}

function emit_stack_map(own s: asmcore.EmitState, size: i32): asmcore.EmitState {
  s = s.write("    xorl %edi, %edi\n    movq $" + util.i32_to_string(size) + ", %rsi\n    movl $3, %edx\n    movl $0x24022, %r10d\n    movq $-1, %r8\n    xorl %r9d, %r9d\n    movl $9, %eax\n");
  return s.syscall(9);
}

function emit_segv_install(own s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    leaq .Lfern_segv_restorer(%rip), %rax\n    movq %rax, 16(%rsp)\n    movq $0, 24(%rsp)\n    movl $11, %edi\n    movq %rsp, %rsi\n    xorl %edx, %edx\n    movl $8, %r10d\n    movl $13, %eax\n");
  return s.syscall(13);
}

function emit_stack_overflow_runtime(s: asmcore.EmitState): asmcore.EmitState {
  let msg: string = aborts.stack_overflow();
  s = s.write("    .section .rodata\n.Lmsg_stack_overflow:\n    .ascii \"" + msg + "\\n\"\n    .text\n");
  s = s.write("__fern_segv:\n    movq 16(%rsi), %rax\n    subq 160(%rdx), %rax\n    addq $1048576, %rax\n    cmpq $2097152, %rax\n    jae .Lfern_segv_other\n    movq 168(%rdx), %rax\n    movq 120(%rdx), %rcx\n    subq $16, %rsp\n    movq %rcx, (%rsp)\n    movq %rax, 8(%rsp)\n    movq %rsp, %rbp\n    leaq .Lmsg_stack_overflow(%rip), %rsi\n    movq $" + util.i32_to_string(msg.len() + 1) + ", %rdx\n    movq $134, %rdi\n    jmp __fern_report\n.Lfern_segv_other:\n    subq $32, %rsp\n    movq $0, (%rsp)\n    movq $0x04000000, 8(%rsp)\n");
  s = emit_segv_install(s);
  s = s.write("    addq $32, %rsp\n    ret\n.Lfern_segv_restorer:\n    movl $15, %eax\n");
  return s.syscall(15);
}

function emit_process_finish(mod: parser.Module, own s: asmcore.EmitState): asmcore.EmitState {
  if (asmcore.has_main(mod)) {
    s = s.write("    call __fn_main\n");
    if (s.leak_check) {
      s = s.write("    pushq %rax\n");
      s = s.write("    call __fern_lc_report\n");
      s = ssa_pop_r(s, "%rax");
    }
    s = s.write("    movq %rax, %rdi\n");
  } else {
    if (s.leak_check) {
      s = s.write("    call __fern_lc_report\n");
    }
    s = s.write("    movq $0, %rdi\n");
  }
  s = s.write("    movq $231, %rax\n");
  s = s.syscall(231);
  return s;
}

function intern_runtime_shapes(own s: asmcore.EmitState): asmcore.EmitState {
  if (s.any_need(["stat", "lstat", "access", "fd_stat"])) {
    let fsPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "FileStat");
    s = fsPre.state;
  }
  if (s.has_need("statfs")) {
    let fvPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "FsStat");
    s = fvPre.state;
  }
  if (s.has_need("mounts")) {
    let mePre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "MountEntry");
    s = mePre.state;
  }
  if (s.has_need("read_dir_ino") || s.has_need("read_dir_ino_all")) {
    let dePre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "DirEntry");
    s = dePre.state;
  }
  if (s.has_need("window_size")) {
    let wsPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "WinSize");
    s = wsPre.state;
  }
  if (s.has_need("subprocess")) {
    let prPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "ProcessResult");
    s = prPre.state;
  }
  return s;
}

function emit_profile_alloc_hook(s: asmcore.EmitState): asmcore.EmitState {
  if (!rtprofile.allocation(s.profile)) {
    return s;
  }
  return s.write("    subq $8, %rsp\n    call __fern_profile_alloc\n    addq $8, %rsp\n");
}

function emit_profile_alloc_runtime(s: asmcore.EmitState): asmcore.EmitState {
  if (!rtprofile.allocation(s.profile)) {
    return s;
  }
  s = s.write("__fern_profile_alloc:\n    cmpq $0, .Lprofile_ring+24(%rip)\n    je .Lprofile_alloc_return\n    movq $1, %rax\n    lock xaddq %rax, .Lprofile_ring+144(%rip)\n    addq $1, %rax\n    testq $63, %rax\n    jne .Lprofile_alloc_return\n    movq $39, %rax\n");
  s = s.syscall(39);
  s = s.write("    cmpq .Lprofile_ring+128(%rip), %rax\n    jne .Lprofile_alloc_return\n    movq $186, %rax\n");
  s = s.syscall(186);
  return s.write("    movq %rax, %r10\n    xorl %eax, %eax\n    lock cmpxchgq %r10, .Lprofile_ring+40(%rip)\n    jne .Lprofile_busy\n    subq $8, %rsp\n    leaq -1(%r14), %rax\n    movq %rbp, %rsi\n    movq %rsp, %rdi\n    leaq .Lprofile_ring(%rip), %r8\n    movq %r13, %r9\n    shlq $6, %r9\n    call __fn___fern_profile_sample.r\n    testl %eax, %eax\n    je .Lprofile_alloc_unlock\n    lock addq $1, .Lprofile_ring+8(%rip)\n.Lprofile_alloc_unlock:\n    addq $8, %rsp\n    movq $0, .Lprofile_ring+40(%rip)\n.Lprofile_alloc_return:\n    ret\n");
}

function emit_profile_runtime(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .bss\n    .balign 8\n.Lprofile_ring: .zero 4337824\n    .data\n    .balign 8\n.Lprofile_action: .quad __fern_profile_signal, 335544324, __fern_profile_restorer, 0\n.Lprofile_timer: .quad 0, 10000, 0, 10000\n    .text\n");
  s = emit_ir_runtime_fern_fn(rtprofile.source("x86-64-linux", s.profile), s);
  s = s.write("__fern_profile_signal:\n    cmpq $0, .Lprofile_ring+24(%rip)\n    je .Lprofile_signal_return\n    movq $39, %rax\n");
  s = s.syscall(39);
  s = s.write("    cmpq .Lprofile_ring+128(%rip), %rax\n    jne .Lprofile_signal_return\n    movq $186, %rax\n");
  s = s.syscall(186);
  s = s.write("    movq %rax, %r10\n    xorl %eax, %eax\n    lock cmpxchgq %r10, .Lprofile_ring+40(%rip)\n    jne .Lprofile_busy\n    subq $8, %rsp\n    movq 168(%rdx), %rax\n    movq 120(%rdx), %rsi\n    movq 160(%rdx), %rdi\n    leaq .Lprofile_ring(%rip), %r8\n    movq $1, %r9\n    call __fn___fern_profile_sample.r\n    testl %eax, %eax\n    je .Lprofile_capture_ok\n    lock addq $1, .Lprofile_ring+8(%rip)\n.Lprofile_capture_ok:\n    addq $8, %rsp\n    movq $0, .Lprofile_ring+40(%rip)\n.Lprofile_signal_return:\n    ret\n.Lprofile_busy:\n    lock addq $1, .Lprofile_ring+8(%rip)\n    ret\n__fern_profile_restorer:\n    movq $15, %rax\n");
  s = s.syscall(15);
  s = s.write("    ud2\n__fern_profile_flush:\n    cmpq $2, .Lprofile_ring+32(%rip)\n    je .Lprofile_flush_return\n    movq $39, %rax\n");
  s = s.syscall(39);
  s = s.write("    cmpq .Lprofile_ring+128(%rip), %rax\n    jne .Lprofile_flush_return\n    movq $186, %rax\n");
  s = s.syscall(186);
  s = s.write("    movq %rax, %rdx\n.Lprofile_flush_lock:\n    xorl %eax, %eax\n    lock cmpxchgq %rdx, .Lprofile_ring+40(%rip)\n    je .Lprofile_flush_owned\n    cmpq %rdx, %rax\n    je .Lprofile_flush_reentrant\n    pause\n    jmp .Lprofile_flush_lock\n.Lprofile_flush_reentrant:\n    cmpq $1, .Lprofile_ring+32(%rip)\n    je .Lprofile_flush_return\n.Lprofile_flush_owned:\n    cmpq $2, .Lprofile_ring+32(%rip)\n    je .Lprofile_flush_unlock\n    movq $0, .Lprofile_ring+24(%rip)\n    movq $1, .Lprofile_ring+32(%rip)\n    subq $8, %rsp\n    leaq .Lprofile_ring(%rip), %rax\n    call __fn___fern_profile_finish.r\n    addq $8, %rsp\n    movq $2, .Lprofile_ring+32(%rip)\n.Lprofile_flush_unlock:\n    movq $0, .Lprofile_ring+40(%rip)\n.Lprofile_flush_return:\n    ret\n");
  return emit_profile_alloc_runtime(s);
}

function emit_vdso_scan(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movq (%rsp), %rax\n");
  s = s.write("    leaq 16(%rsp,%rax,8), %rax\n");
  s = s.write(".Lfern_auxv_env:\n");
  s = s.write("    movq (%rax), %rcx\n");
  s = s.write("    addq $8, %rax\n");
  s = s.write("    testq %rcx, %rcx\n");
  s = s.write("    jnz .Lfern_auxv_env\n");
  s = s.write(".Lfern_auxv_scan:\n");
  s = s.write("    movq (%rax), %rcx\n");
  s = s.write("    testq %rcx, %rcx\n");
  s = s.write("    jz .Lfern_auxv_done\n");
  s = s.write("    addq $16, %rax\n");
  s = s.write("    cmpq $33, %rcx\n");
  s = s.write("    jne .Lfern_auxv_scan\n");
  s = s.write("    movq -8(%rax), %rcx\n");
  s = s.write("    movq %rcx, __fern_vdso(%rip)\n");
  s = s.write(".Lfern_auxv_done:\n");
  return s;
}

function emit_rt_clocks(s: asmcore.EmitState): asmcore.EmitState {
  let vdso: boolean = asmcore.vdso_wanted(s, "x86-64-linux");
  if (vdso && !s.has_need("ccall:__c_call2")) {
    s = emit_ccall_shim1(s.write("    .text\n").need("ccall:__c_call2"), "__c_call2", 2);
  }
  for which in ["monotonic_ns", "now_unix_ms", "now_ns"] {
    if (s.has_need(which)) {
      s = emit_ir_runtime_fern_fn(asmcore.rt_src_clock(which, "x86-64-linux"), s.write("    .text\n"));
    }
  }
  if (vdso) {
    s = s.write("    .section .bss\n    .align 8\n__fern_vdso: .quad 0, 0\n    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_vdso("x86-64-linux"), s);
  }
  return s;
}

function emit_entry_runtime(s: asmcore.EmitState): asmcore.EmitState {
  if (s.profile > 0) {
    s = emit_profile_runtime(s);
  }
  if (s.has_need("str_cmp")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_cmp(), s);
  }
  if (needs_heap_runtime(s)) {
    s = emit_ir_runtime(s);
  }
  if (s.has_need("crc32_cksum")) {
    s = emit_rt_crc32_cksum(s);
  }
  if (s.has_need("aes_gcm")) {
    s = emit_rt_aes_gcm(s);
  }
  if (s.has_need("sha256")) {
    s = emit_rt_sha256(s);
  }
  if (s.has_need("sum_bytes")) {
