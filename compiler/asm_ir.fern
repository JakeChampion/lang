  }
  s = s.write("    ret\n");
  if (!hev_on(s) && !s.has_need("alloc_count")) {
    s = s.write(".Larrbox_miss:\n");
    s = s.write("    leaq __fern_freelist(%rip), %rax\n");
    s = s.write("    subq %rax, %rdi\n");
    s = s.write(".Larrbox_alloc:\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    jmp .Larrbox_hdr\n");
