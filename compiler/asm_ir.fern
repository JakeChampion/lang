    let rlo: asmcore.LabelOut = asmcore.fresh_label(s);
    let r_ok: string = rlo.name;
    let rlo2: asmcore.LabelOut = asmcore.fresh_label(rlo.state);
    let r_vec: string = rlo2.name;
    let rlo3: asmcore.LabelOut = asmcore.fresh_label(rlo2.state);
    let r_hit: string = rlo3.name;
    let rlo4: asmcore.LabelOut = asmcore.fresh_label(rlo3.state);
    let r_step: string = rlo4.name;
    let rlo5: asmcore.LabelOut = asmcore.fresh_label(rlo4.state);
    let r_tail: string = rlo5.name;
    let rlo6: asmcore.LabelOut = asmcore.fresh_label(rlo5.state);
    let r_loop: string = rlo6.name;
    let rlo7: asmcore.LabelOut = asmcore.fresh_label(rlo6.state);
    let r_none: string = rlo7.name;
    let rlo8: asmcore.LabelOut = asmcore.fresh_label(rlo7.state);
    let r_done: string = rlo8.name;
    let rlo9: asmcore.LabelOut = asmcore.fresh_label(rlo8.state);
    let r_avx: string = rlo9.name;
    let rlo10: asmcore.LabelOut = asmcore.fresh_label(rlo9.state);
    let r_hit32: string = rlo10.name;
    let rlo11: asmcore.LabelOut = asmcore.fresh_label(rlo10.state);
    let r_avx_done: string = rlo11.name;
