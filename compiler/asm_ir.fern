  s = s.write("    pclmulqdq $1, %xmm9, %xmm3\n");
  s = s.write("    pxor %xmm3, %xmm0\n");
  s = s.write("    movdqu (%rsi), %xmm4\n");
  s = s.write("    pshufb %xmm5, %xmm4\n");
  s = s.write("    pxor %xmm4, %xmm0\n");
  s = s.write("    movdqa %xmm6, %xmm3\n");
