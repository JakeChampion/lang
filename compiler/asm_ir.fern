      // so the census leaves it out as it left out the .bss reservation
      // it replaced. %r12 is a power of two >= 64 KiB, already 16-rounded.
      s = s.write("    movq __fern_lc_alloc_count(%rip), %rcx\n");
      s = s.write("    subq $1, %rcx\n");
      s = s.write("    movq %rcx, __fern_lc_alloc_count(%rip)\n");
      s = s.write("    movq __fern_lc_alloc_bytes(%rip), %rcx\n");
      s = s.write("    subq %r12, %rcx\n");
      s = s.write("    movq %rcx, __fern_lc_alloc_bytes(%rip)\n");
    }
    s = s.write("    movq %rax, %rbx\n");  // new buffer
    s = s.write("    movq __fern_strbuf_ptr(%rip), %rsi\n");  // old buffer (0 on the first grow)
    s = s.write("    movq __fern_strbuf_len(%rip), %rcx\n");  // live bytes (0 while old is null)
    s = s.write("    movq %rbx, %rdx\n");
    s = s.write("    cmpq $0, %rcx\n");
    s = s.write("    je .Lsbgrow_copied\n");
    s = s.write("    movq %rdx, %rdi\n");
    s = s.write("    movq %rcx, %rdx\n");
    s = s.write("    call __fern_memcpy\n");
    s = s.write(".Lsbgrow_copied:\n");
    s = s.write("    movq %rbx, __fern_strbuf_ptr(%rip)\n");
    s = s.write("    movq %r12, __fern_strbuf_cap(%rip)\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    // append(box in %rdi): grow if box.len more bytes do not fit, copy them
    // from box.data to strbuf_ptr + strbuf_len, then bump len. %rbx holds
    // the box across the grow call.
    s = s.write("__fern_strbuf_append:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    movq %rdi, %rbx\n");
    s = s.write("    movq 8(%rbx), %rcx\n");  // src len
    s = s.write("    movq __fern_strbuf_len(%rip), %rdi\n");
    s = s.write("    addq %rcx, %rdi\n");  // bytes needed after this append
    s = s.write("    movq __fern_strbuf_cap(%rip), %rax\n");
    s = s.write("    cmpq %rax, %rdi\n");
    s = s.write("    jbe .Lsbapp_fits\n");
    s = s.write("    call __fern_strbuf_grow\n");
    s = s.write(".Lsbapp_fits:\n");
    s = s.write("    movq (%rbx), %rsi\n");  // src data ptr
    s = s.write("    movq 8(%rbx), %rcx\n");  // src len
    s = s.write("    movq __fern_strbuf_ptr(%rip), %rdx\n");
    s = s.write("    addq __fern_strbuf_len(%rip), %rdx\n");  // dst = ptr + len
    s = s.write("    cmpq $0, %rcx\n");
    s = s.write("    je .Lsbapp_done\n");
    s = s.write("    movq %rdx, %rdi\n");
    s = s.write("    movq %rcx, %rdx\n");
    s = s.write("    call __fern_memcpy\n");
    s = s.write(".Lsbapp_done:\n");
    s = s.write("    movq 8(%rbx), %rcx\n");  // reload src len
    s = s.write("    addq %rcx, __fern_strbuf_len(%rip)\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write("__fern_strbuf_take:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r14\n");
    s = s.write("    pushq %r15\n");
    s = s.write("    movq __fern_strbuf_len(%rip), %r12\n");  // len
    s = s.write("    movq %r12, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq %rax, %r13\n");  // data ptr
    s = s.write("    movq __fern_strbuf_ptr(%rip), %rsi\n");
    s = s.write("    movq %r13, %rdi\n");
    s = s.write("    movq %r12, %rcx\n");
    s = s.write("    cmpq $0, %rcx\n");
    s = s.write("    je .Lsbtake_box\n");
    s = s.write("    movq %rcx, %rdx\n");
    s = s.write("    call __fern_memcpy\n");
    s = s.write(".Lsbtake_box:\n");
    // The result box comes from __fern_str_box, not a bare __fern_alloc(16):
    // the drained string is an ordinary owned string (the lowering's str-tracking
    // treats `strbuf_take()` as fresh), so a dropped one reaches
    // __fn___fern_str_free, which reads the refcount at box-8. A headerless
    // box makes that read the last word of the PRECEDING allocation — here
    // the tail of the text just copied. Native has built this one with an
    // rc-headered allocation since docs/RC-STRINGS-PLAN.md; the self-host was
    // the last producer left unconverted. data@box+0 / len@box+8 are where
    // they always were, so no consumer moves.
    s = s.write("    movq %r13, %rdi\n");  // data
    s = s.write("    movq %r12, %rsi\n");  // len
    s = s.write("    call __fern_str_box\n");
    s = s.write("    movq $0, __fern_strbuf_len(%rip)\n");  // reset
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
