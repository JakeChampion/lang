    let alo3 = asmcore.fresh_label(alo2.state);
    let a_hit = alo3.name;
    let alo4 = asmcore.fresh_label(alo3.state);
    let a_tail = alo4.name;
    let alo5 = asmcore.fresh_label(alo4.state);
    let a_none = alo5.name;
    let alo6 = asmcore.fresh_label(alo5.state);
    let a_done = alo6.name;
    let alo7 = asmcore.fresh_label(alo6.state);
    let a_avx = alo7.name;
    let alo8 = asmcore.fresh_label(alo7.state);
    let a_hit32 = alo8.name;
    let alo9 = asmcore.fresh_label(alo8.state);
    let a_avx_done = alo9.name;
    s = alo9.state;
    s = s.write("    popq %rdx\n    popq %rax\n");
    s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
    s = s.write("    cmpq $0, %rdx\n    jge " + a_clamped + "\n    xorq %rdx, %rdx\n");
    s = s.write(a_clamped + ":\n");
    s = s.write(a_avx + ":\n");
    s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
    s = s.write("    cmpq $32, %r9\n    jl " + a_avx_done + "\n");
