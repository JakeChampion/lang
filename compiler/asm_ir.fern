    s = s.write("    andq $-3, %rcx\n");
    s = s.write("    movl -8(%rcx), %edi\n");
    s = s.write(san_poison_check("%edi", s.rc_free_debug));
    s = s.write("    testl %edi, %edi\n");
    s = s.write("    js .Laie_loop\n");
    s = s.write("    addl $1, -8(%rcx)\n");
    s = s.write("    jmp .Laie_loop\n");
    s = s.write(".Laie_ret:\n");
