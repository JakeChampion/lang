function const_text_u32(t: string): boolean {
  if (t.len() > 2 && t[0] == 48 && (t[1] == 120 || t[1] == 88)) {
    return t.len() <= 10 && util.hex_digits(t, 2);
  }
  if (!util.is_all_digits(t) || t.len() > 10) {
    return false;
  }
  return util.digits_to_i64(t) <= 4294967295i64;
}

function emit_ir_op_heap_bump_bytes(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
  s = s.write("    movq __fern_heap_base(%rip), %rcx\n");
  s = s.write("    movq %rax, %rdx\n");
  s = s.write("    subq %rcx, %rdx\n");
  s = s.write("    xorq %rcx, %rcx\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    cmovneq %rdx, %rcx\n");
  s = s.write("    pushq %rcx\n");
  s = s.need("heap");

  return s;
}

function emit_ir_op_heap_alloc_count(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movq __fern_alloc_count(%rip), %rax\n");
  s = s.write("    pushq %rax\n");
  s = s.need("heap");
  s = s.need("alloc_count");

  return s;
}

function emit_ir_op_heap_mark(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
  s = s.write("    pushq %rcx\n    pushq %rsi\n    pushq %rdi\n");
  s = s.write("    leaq __fern_freelist(%rip), %rsi\n");
  s = s.write("    leaq __fern_freelist_shadow(%rip), %rdi\n");
  s = s.write("    movl $65536, %ecx\n    rep movsq\n");
  s = s.write("    leaq __fern_large_freelist(%rip), %rsi\n");
  s = s.write("    leaq __fern_large_freelist_shadow(%rip), %rdi\n");
  s = s.write("    movl $2560, %ecx\n    rep movsq\n");
  s = s.write("    popq %rdi\n    popq %rsi\n    popq %rcx\n");
  s = s.write("    pushq %rax\n");
  s = s.need("heap");

  return s;
}

// The cursor and the end move into [start, end), and both free lists are
// zeroed so no block outside the region is handed out again.
function emit_ir_op_heap_adopt(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("heap");
  s = s.need("heap_adopt");
  s = s.write("    popq %rdx\n");
  s = s.write("    popq %rax\n");
  let move = asmcore.fresh_label(s);
  let keep = asmcore.fresh_label(move.state);
  s = keep.state;
  s = s.write("    cmpq __fern_heap_base(%rip), %rax\n    jb " + move.name + "\n");
  s = s.write("    cmpq __fern_heap_end(%rip), %rax\n    jb " + keep.name + "\n");
  s = s.write(move.name + ":\n");
  s = s.write("    pushq %rcx\n");
  s = s.write("    movq __fern_heap_base(%rip), %rcx\n    movq %rcx, __fern_image_lo(%rip)\n");
  s = s.write("    movq __fern_heap_end(%rip), %rcx\n    movq %rcx, __fern_image_hi(%rip)\n");
  s = s.write("    popq %rcx\n");
  s = s.write("    movq %rax, __fern_heap_base(%rip)\n");
  if (s.leak_check) {
    s = s.write("    movq %rax, __fern_lc_adopt_lo(%rip)\n    movq %rdx, __fern_lc_adopt_hi(%rip)\n");
  }
  s = s.write(keep.name + ":\n");
  s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
  s = s.write("    movq %rdx, __fern_heap_end(%rip)\n");
  s = s.write("    pushq %rcx\n    pushq %rdi\n");
  s = s.write("    xorl %eax, %eax\n");
  s = s.write("    leaq __fern_freelist(%rip), %rdi\n");
  s = s.write("    movl $65536, %ecx\n    rep stosq\n");
  s = s.write("    leaq __fern_large_freelist(%rip), %rdi\n");
  s = s.write("    movl $2560, %ecx\n    rep stosq\n");
  s = s.write("    popq %rdi\n    popq %rcx\n");
  s = s.write("    pushq %rax\n");
  return s;
}

// The leak-check counters a worker region carries, at words 1 to 4 of its
// header. rax holds the region. The snapshot runs only when the mapping
// succeeded.
function lc_counters(): string[] {
  return ["__fern_lc_alloc_count", "__fern_lc_alloc_bytes", "__fern_lc_free_count", "__fern_lc_free_bytes"];
}

// Word 5 of a region's header is its size, which the reap reads back.
// rax holds the region and rdx the size.
function worker_region_size(s: asmcore.EmitState): asmcore.EmitState {
  let l = asmcore.fresh_label(s);
  s = l.state.write("    testq %rax, %rax\n    jle " + l.name + "\n    movq %rdx, 40(%rax)\n");
  return s.write(l.name + ":\n");
}

function worker_region_census(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  let l = asmcore.fresh_label(s);
  s = l.state.write("    testq %rax, %rax\n    jle " + l.name + "\n    pushq %rcx\n");
  for k in 0..4 {
    let off = util.i32_to_string(8 + 8 * k);
    s = s.write("    movq " + lc_counters()[k] + "(%rip), %rcx\n    movq %rcx, " + off + "(%rax)\n");
  }
  return s.write("    popq %rcx\n" + l.name + ":\n");
}

function worker_exit_census(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  s = s.write("    pushq %rcx\n");
  for k in 0..4 {
    let off = util.i32_to_string(8 + 8 * k);
    s = s.write("    movq " + lc_counters()[k] + "(%rip), %rcx\n    subq " + off + "(%rax), %rcx\n    movq %rcx, " + off + "(%rax)\n");
  }
  return s.write("    popq %rcx\n");
}

function worker_reap_census(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  let done = asmcore.fresh_label(s);
  s = done.state.write("    cmpq $0, (%rax)\n    je " + done.name + "\n    pushq %rcx\n");
  for k in 0..4 {
    let off = util.i32_to_string(8 + 8 * k);
    s = s.write("    movq " + off + "(%rax), %rcx\n    addq %rcx, " + lc_counters()[k] + "(%rip)\n");
  }
  return s.write("    popq %rcx\n" + done.name + ":\n");
}

// Snapshot live child allocations before munmap. A successful munmap frees
// the whole region, without a release into the parent's free lists. The
// count is signed: a body that frees boxes of the parent's image frees more
// than it allocates.
function emit_worker_unmap(s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("worker_unmap");
  s = s.need("worker_regions");
  s = s.write("    popq %r10\n    popq %rdx\n    popq %rax\n");
  if (s.rc_free_debug) {
    s = s.write("    movq $0, __fern_forget_lo(%rip)\n    movq $0, __fern_forget_hi(%rip)\n");
  }
  let ready = asmcore.fresh_label(s);
  let done = asmcore.fresh_label(ready.state);
  s = done.state;
  if (s.leak_check) {
    s = s.write("    xorq %r8, %r8\n    xorq %r9, %r9\n    testq %r10, %r10\n    jz " + ready.name + "\n");
    s = s.write("    movq 8(%rax), %r8\n    subq 24(%rax), %r8\n");
    s = s.write("    movq 16(%rax), %r9\n    subq 32(%rax), %r9\n");
    s = s.write(ready.name + ":\n    pushq %r8\n    pushq %r9\n");
  }
  if (rc_trace_on()) {
    s = s.write("    pushq %rdx\n    pushq %rax\n");
  }
  s = s.write("    pushq %r10\n    pushq %rdx\n    pushq %rax\n    call __fn___fern_worker_unmap\n    addq $24, %rsp\n");
  return worker_unmap_result(s, done.name);
}

function worker_unmap_result(s: asmcore.EmitState, done_label: string): asmcore.EmitState {
  if (rc_trace_on()) {
    s = s.write("    popq %rdi\n    popq %rsi\n");
  }
  if (s.leak_check) {
    s = s.write("    popq %rcx\n    popq %rdx\n");
  }
  if (s.leak_check || rc_trace_on()) {
    s = s.write("    testl %eax, %eax\n    jnz " + done_label + "\n");
  }
  if (s.leak_check) {
    s = s.write("    addq %rdx, __fern_lc_free_count(%rip)\n    addq %rcx, __fern_lc_free_bytes(%rip)\n");
  }
  if (rc_trace_on()) {
    s = s.write("    pushq %rax\n    pushq %rsi\n    pushq %rdi\n    call __fern_hev_u\n    addq $16, %rsp\n    popq %rax\n");
  }
  if (s.leak_check || rc_trace_on()) {
    s = s.write(done_label + ":\n");
  }
  return s.write("    pushq %rax\n");
}

function emit_ir_op_heap_release_to(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let hrlo = asmcore.fresh_label(s);
  let hrl_done = hrlo.name;
  s = hrlo.state;
  s = s.write("    popq %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jz " + hrl_done + "\n");
  s = s.write("    pushq %rcx\n    pushq %rsi\n    pushq %rdi\n");
  if (s.harden) {
    s = s.write("    movq __fern_heap_ptr(%rip), %rcx\n    subq %rax, %rcx\n    jbe " + hrl_done + "_kept\n");
    s = s.write("    pushq %rax\n    movq %rax, %rdi\n    xorl %eax, %eax\n    rep stosb\n    popq %rax\n" + hrl_done + "_kept:\n");
  }
  s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
  s = s.write("    leaq __fern_freelist_shadow(%rip), %rsi\n");
  s = s.write("    leaq __fern_freelist(%rip), %rdi\n");
  s = s.write("    movl $65536, %ecx\n    rep movsq\n");
  s = s.write("    leaq __fern_large_freelist_shadow(%rip), %rsi\n");
  s = s.write("    leaq __fern_large_freelist(%rip), %rdi\n");
  s = s.write("    movl $2560, %ecx\n    rep movsq\n");
  s = s.write("    popq %rdi\n    popq %rsi\n    popq %rcx\n");
  s = s.write(hrl_done + ":\n");
  s = s.write("    pushq %rax\n");
  s = s.need("heap");

  return s;
}

function helper_call_needs(name: string, s: asmcore.EmitState): asmcore.EmitState {
  if (name == "__fern_oob_abort" || name == "__fern_slice_abort") {
    s = s.need("heap");
  }
  if (name == "__fern_i32_to_string") {
    s = s.need("heap");
    s = s.need("i32_to_string");
  }
  if (name == "__fern_u32_to_string") {
    s = s.need("heap");
    s = s.need("u32_to_string");
  }
  if (name == "__fern_i64_to_string") {
    s = s.need("heap");
    s = s.need("i64_to_string");
  }
  if (name == "__fern_u64_to_string") {
    s = s.need("heap");
    s = s.need("u64_to_string");
  }
  s = s.need_array_helper(name);
  if (name == "__fern_arr_inc_elems") {
    s = s.need("arr_inc_elems");
  }
  if (name == "__fern_arr_own_elems") {
    s = s.need("arr_own_elems");
  }
  if (name == "__fern_str_own") {
    s = s.need("str_own");
  }
  if (name == "__fern_str_borrow") {
    s = s.need("str_borrow");
  }
  if (name == "__fern_str_grow" || name == "__fern_str_grow_range" || name == "__fern_str_grow_fresh" || name == "__fern_str_grow_fresh_range") {
    s = s.need("str_grow");
  }
  if (name == "__fern_account_entry") {
    s = s.need("account");
  }
  if (name == "__fern_set_args") {
    s = s.need("set_args");
  }
  return s;
}

function dyn_arg_operand(a: asmcore.DynArg): string {
  if (a.reg.len() > 0) {
    return a.reg;
  }
  return util.i32_to_string(a.off) + "(%rbp)";
}

function emit_dyn_dispatch_chain(arms: string, args: asmcore.DynArg[], own s: asmcore.EmitState): asmcore.EmitState {
  let tag = asmcore.fresh_label(s);
  s = tag.state;
  let key = tag.name;
  let dargc = args.len();
  s = s.write("    movq " + dyn_arg_operand(args[0]) + ", %rax\n");
  s = s.write("    movq (%rax), %rcx\n");
  let dend = key + "dynend";
  let dfi = 0;
  let darmn = 0;
  while (dfi < s.funcs.len()) {
    let dfd = s.funcs[dfi];
    let ddbn = util.base_type_name(dfd.receiver_type);
    let dprim = dfd.receiver_type.len() > 0 && asmcore.is_prim_recv_name(ddbn, s);
    if (irtables.dyn_arm_matches(dfd, arms) && dfd.receiver_type.len() > 0
      && (asmcore.is_struct_decl_name(ddbn, s) || dprim)) {
      let dbn = ddbn;
      let dlit = asmcore.shape_ref(s, dbn);
      s = dlit.state;
      let dnext = key + "dynnext" + util.i32_to_string(darmn);
      s = ssa_lea_sym(s, dlit.label, "%rdx");
      s = s.write("    cmpq %rdx, %rcx\n");
      s = s.write("    jne " + dnext + "\n");
      let dk = dargc - 1;
      while (dk >= 0) {
        if (dk == 0 && dprim) {
          s = s.write("    movq " + dyn_arg_operand(args[0]) + ", %rax\n");
          s = s.write("    pushq 8(%rax)\n");
        } else {
          s = s.write("    pushq " + dyn_arg_operand(args[dk]) + "\n");
        }
        dk -= 1;
      }
      s = s.write("    call __fn_" + asmcore.sanitize_label(dbn + "." + dfd.name) + "\n");
      s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
      s = s.write("    jmp " + dend + "\n");
      s = s.write(dnext + ":\n");
      darmn += 1;
    }
    if (irtables.dyn_arm_matches(dfd, arms) && dfd.receiver_type.len() > 0
      && !asmcore.recv_is_array(dfd.receiver_type)
      && irtables.decl_is_enum(s.struct_decls, ddbn)) {
      let dehit = key + "dynehit" + util.i32_to_string(darmn);
      let denext = key + "dynnext" + util.i32_to_string(darmn);
      let dvi = 0;
      while (dvi < s.struct_decls.decls.len()) {
        if (s.struct_decls.decls[dvi].enum_owner == ddbn) {
          let vlit_name = irtables.decl_shape(s.struct_decls.decls[dvi]);
          let vlit = asmcore.shape_ref(s, vlit_name);
          s = vlit.state;
          s = ssa_lea_sym(s, vlit.label, "%rdx");
          s = s.write("    cmpq %rdx, %rcx\n");
          s = s.write("    je " + dehit + "\n");
        }
        dvi += 1;
      }
      s = s.write("    jmp " + denext + "\n");
      s = s.write(dehit + ":\n");
      let dek = dargc - 1;
      while (dek >= 0) {
        s = s.write("    pushq " + dyn_arg_operand(args[dek]) + "\n");
        dek -= 1;
      }
      s = s.write("    call __fn_" + asmcore.sanitize_label(ddbn + "." + dfd.name) + "\n");
      s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
      s = s.write("    jmp " + dend + "\n");
      s = s.write(denext + ":\n");
      darmn += 1;
    }
    dfi += 1;
  }
  if (asmcore.process_entry(s)) {
    s = s.write("    movq $231, %rax\n    movq $134, %rdi\n").syscall(231);
  } else {
    s = s.write("    ud2\n");
  }
  s = s.write(dend + ":\n");
  return s;
}

function emit_ir_op_dyn_box(o: ir.Op, own s: asmcore.EmitState): asmcore.EmitState {
  let dbl = asmcore.shape_ref(s, o.str);
  s = dbl.state;
  s = s.write("    movq $2, %rdi\n    call __fern_arr_box\n");
  s = ssa_lea_sym(s, dbl.label, "%rcx");
  s = s.write("    movq %rcx, (%rax)\n");
  s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");

  return s;
}

function ir_i2f_rax(width: i32, unsigned: boolean, lb: string, d: string): string {
  if (width == 64 && unsigned) {
    let u = "    testq " + d + ", " + d + "\n    js " + lb + "_big\n";
    u = u + "    cvtsi2sd " + d + ", %xmm0\n    jmp " + lb + "_done\n";
    u = u + lb + "_big:\n";
    u = u + "    movq " + d + ", %rcx\n    shrq $1, %rcx\n    andl $1, " + ssa_r32(d) + "\n    orq " + d + ", %rcx\n";
    u += "    cvtsi2sd %rcx, %xmm0\n    addsd %xmm0, %xmm0\n";
    u = u + lb + "_done:\n    movq %xmm0, " + d + "\n";
    return u;
  }
  if (unsigned) {
    return "    movl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n    cvtsi2sd " + d + ", %xmm0\n    movq %xmm0, " + d + "\n";
  }
  return "    cvtsi2sd " + d + ", %xmm0\n    movq %xmm0, " + d + "\n";
}

function emit_array_helpers(s: asmcore.EmitState): asmcore.EmitState {
  let byte_copy = s.byte_copy_roots();
  if (byte_copy != "") {
    s = s.write("    .text\n");
    s = emit_runtime(byte_copy, s);
  }
  if (s.has_need("arr_str_join")) {
    s = s.write("    .text\n");
    s = emit_runtime("__fern_arr_str_join", s);
  }
  if (s.has_need("arr_concat")) {
    s = s.write("    .text\n");
    s = emit_runtime("__fern_arr_concat", s);
  }
  if (s.has_need("bytes_owned")) {
    s = s.write("    .text\n");
    s = emit_runtime("__fern_bytes_owned", s);
  }
  if (s.has_need("bytes_range")) {
    s = s.write("    .text\n");
    s = emit_runtime("__fern_bytes_range", s);
  }
  if (s.has_need("bytes_into")) {
    s = s.write("    .text\n");
    s = emit_runtime("__fern_bytes_into", s);
  }
  return s;
}

function emit_runtime(roots: string, s: asmcore.EmitState): asmcore.EmitState {
  let at = s.runtime_units.roots.find(roots);
  if (at >= 0) {
    return emit_runtime_module(s.runtime_units.mods[at], s.runtime_units.lowered[at], s);
  }
  let m = rtmodule.load(asmcore.runtime_files(s, "x86-64-linux"), roots);
  let lowered = s.rt_lower(m);
  return emit_runtime_module(m, lowered, asmcore.with_runtime_unit(s, roots, m, lowered));
}

// A string write for print or eprint. With a `log` provider it passes the bytes
// and the length to the provider, and returns the length.
function emit_log_write(name: string, s: asmcore.EmitState): asmcore.EmitState {
  if (s.log_provider.len() == 0) {
    return emit_runtime(name, s);
  }
  s = s.write("__fn_" + name + ":\n    movq 8(%rsp), %rax\n__fn_" + name + ".r:\n    pushq %rbp\n    movq %rsp, %rbp\n");
  s = s.write("    movslq 8(%rax), %rcx\n    pushq %rcx\n    pushq %rcx\n    pushq 0(%rax)\n    call " + s.log_provider + "\n");
  return s.write("    movq -8(%rbp), %rax\n    leave\n    ret\n");
}

function emit_runtime_module(m: parser.Module, lowered: physicalbody.Lowered, s: asmcore.EmitState): asmcore.EmitState {
  let fns = m.funcs;
  asmcore.refuse_runtime_name(s, fns);
  let lit0 = s.string_lits.len();
  let agg0 = s.const_aggs.len();
  let sh0 = s.shape_lits.len();
  let sa0 = s.sym_addrs.len();
  let cf0 = s.cfi_stubs.len();
  let bodies = irtables.lowered_results(lowered.bodies);
  let physical = physicalbody.collection(lowered);
  let previous_regs = s.reg_entries;
  let previous_leaves = s.leaves;
  let previous_float = asmcore.FloatAbi { names: s.float_abi, masks: s.float_abi_masks };
  let unit = asmcore.unit_leaves(m, 0, fns.len(), bodies, s.kinds);
  let fabi = asmcore.unit_float_abi(m, 0, fns.len(), bodies);
  s = asmcore.EmitState { ...s, reg_entries: irtables.sig_reg_of(asmcore.unit_labels(m, 0, fns.len(), bodies)), leaves: unit.leaves, float_abi: fabi.names, float_abi_masks: fabi.masks };
  let vgate = irverifygate.with_memo(irverifygate.gate_unreported(irtables.fn_sig_index(fns, m.funcs, bodies), s.kinds, physicalbody.abis(physical)), s.memo);
  s = asmcore.export_runtime_fns(s, fns);
  for i in 0..fns.len() {
    if (!s.has_named(fns[i].name)) {
      s = emit_function_via_ir_pre(bodies[i], physicalbody.select(physical, i), s.prelift(unit.pre, i, bodies[i]), fns[i], s, vgate);
      s = s.with_named(fns[i].name);
    }
  }
  s = emit_named_bodies(bodies, physical, unit.pre, fns.len(), s, vgate);
  s = emit_cfi_stubs_from(s, cf0);
  if (s.shape_lits.len() > sh0) {
    s = asmcore.emit_shape_lits_from(s, sh0);
    s = s.write("    .text\n");
  }
  if (s.string_lits.len() > lit0) {
    s = s.write("    .section .rodata\n");
    let li = lit0;
    while (li < s.string_lits.len()) {
      s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
      li += 1;
    }
    s = asmcore.emit_str_box_data_from(s, lit0);
    s = s.write("    .text\n");
  }
  if (s.const_aggs.len() > agg0) {
    s = asmcore.emit_const_agg_data_from(s, agg0);
    s = s.write("    .text\n");
  }
  s = emit_sym_addrs_from(s, sa0);
  return asmcore.EmitState { ...s, reg_entries: previous_regs, leaves: previous_leaves, float_abi: previous_float.names, float_abi_masks: previous_float.masks };
}

function emit_module_funcs(mod: parser.Module, all_funcs: parser.FuncDecl[], s: asmcore.EmitState, globl_defs: boolean, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection): asmcore.EmitState {
  let vgate = irverifygate.with_memo(irverifygate.gate(irtables.fn_sig_index(all_funcs, mod.funcs, cache), s.kinds, physicalbody.abis(physical)), s.memo);
  let hh = hi;
  if (hh < 0 || hh > mod.funcs.len()) {
    hh = mod.funcs.len();
  }
  let unit = asmcore.unit_leaves(mod, lo, hh, cache, s.kinds);
  s = asmcore.EmitState { ...s, reg_entries: irtables.sig_reg_of(asmcore.unit_labels(mod, lo, hh, cache)), leaves: unit.leaves };
  let fabi = asmcore.unit_float_abi(mod, lo, hh, cache);
  s = asmcore.EmitState { ...s, float_abi: fabi.names, float_abi_masks: fabi.masks };
  let fi = lo;
  while (fi < hh) {
    let r = ircore.produced(cache, fi, mod.funcs[fi]);
    if (r.superseded) {
      fi += 1;
      continue;
    }
    if (globl_defs) {
      let gname = parser.decl_key(mod.funcs[fi]);
      s = s.write(".globl __fn_" + asmcore.sanitize_label(gname) + "\n.globl __fn_" + asmcore.sanitize_label(gname) + ".r\n");
    }
    s = emit_function_via_ir_pre(r, physicalbody.select(physical, fi), s.prelift(unit.pre, fi, r), mod.funcs[fi], s, vgate);
    fi += 1;
  }
  s = emit_named_bodies(cache, physical, unit.pre, mod.funcs.len(), s, vgate);
  s = emit_cfi_stubs_from(s, 0);
  irverifygate.report(vgate);
  return s;
}

function emit_named_bodies(cache: irtables.LowerResult[], physical: physicalbody.Collection, pre: asmcore.Prelift[], from: i32, s: asmcore.EmitState, vgate: irverifygate.Gate): asmcore.EmitState {
  for xi in from..cache.len() {
    if (!s.has_named(cache[xi].name)) {
      s = emit_function_via_ir_named(cache[xi], physicalbody.select(physical, xi), s.prelift(pre, xi, cache[xi]), cache[xi].name, true, s, vgate).with_named(cache[xi].name);
    }
  }
  return s;
}

pub function module_runtime_needs(mod: parser.Module, all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, cache: irtables.LowerResult[], physical: physicalbody.Collection): string[] {
  let s = asmcore.new_state();
  s = asmcore.with_funcs(asmcore.EmitState { ...s, struct_decls: all_structs, retain_prepared: false, memo: irverifygate.open_memo("x86-64") }, all_funcs);
  s = emit_module_funcs(mod, all_funcs, s, false, 0, -1, cache, physical);
  irverifygate.close_memo(s.memo);
  s.release();
  return s.needed;
}

pub function emit_module_or_error_sub(mod: parser.Module, sub: ircore.Sub, recs: usize): string {
  if (!sub.checked) {
    let parse_errs = asmcore.parse_unknown_errors_module(mod);
    if (parse_errs.len() > 0) {
      eprint(util.format_diags(parse_errs));
      exit(1);
      return "";
    }
  }
  let tm = checker.ensure_annotated(mod);
  if (!sub.checked) {
    let check_errs = asmcore.entry_check_errors(tm);
    if (check_errs.len() > 0) {
      eprint(util.format_diags(check_errs));
      exit(1);
      return "";
    }
  }
  ircore.refuse_claims(sub.refused);
  let lm = ircore.sub_lifted(sub, tm);
  let g = emit_module_ir_gated_sub(lm, sub, recs);
  if (g != "") {
    return g;
  }
  ircore.eprint_ir_ineligible();
  exit(1);
  return "";
}

pub function emit_module_ir_gated_sub(mod: parser.Module, sub: ircore.Sub, recs: usize): string {
  let g = match (ircore.gate_program(mod, sub)) { Some(g) => g, None => { return ""; } };
  return emit_module_ir_unit_flat(g.im, true, false, "", [], g.im.funcs, g.stab, 0, -1, ircore.inline_tiny_leaves(g.im, g.cache), g.physical, sub.rt_lower, recs, sub.switches);
}

pub function emit_module_ir_unit_flat(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (parser.Module) => physicalbody.Lowered, recs: usize, sw: asmcore.Switches): string {
  return emit_module_ir_unit_prepared(mod, is_entry, globl_defs, str_ns, extra_needs, all_funcs, all_structs, lo, hi, cache, physical, rt, recs, sw, false).text;
}

pub function emit_module_ir_unit_prepared(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (parser.Module) => physicalbody.Lowered, recs: usize, sw: asmcore.Switches, retain: boolean): ssaprepare.Output {
  let s = asmcore.new_state();
  s = asmcore.EmitState { ...s, retain_prepared: retain, memo: irverifygate.open_memo("x86-64") };
  s = asmcore.with_funcs(asmcore.with_providers(asmcore.with_switches(asmcore.EmitState { ...s, struct_decls: all_structs, str_ns: str_ns, rt_lower: rt, recs: recs }, sw), mod), all_funcs);
  let derrs = asmcore.display_errs_module(mod, s);
  if (derrs.len() > 0) {
    eprint(util.format_diags(derrs));
    exit(1);
    return ssaprepare.Output { text: "", bodies: [] };
  }
  if (globl_defs && s.sandbox) {
    eprint("fern: FERN_SANDBOX=1 needs the whole-program emit; a per-module unit cannot see its siblings' syscalls");
    exit(1);
    return ssaprepare.Output { text: "", bodies: [] };
  }
  if (is_entry && asmcore.process_entry(s)) {
    s = s.write("    .globl _start\n");
  }
  if (is_entry && asmcore.reset_entry(s)) {
    s = s.write("    .globl _start\n    .section .bss\n__fern_bss_start:\n");
  }
  s = s.write("    .text\n");
  if (is_entry && asmcore.reset_entry(s)) {
    s = emit_reset_start(s);
  }
  if (is_entry && globl_defs) {
    s = asmcore.emit_runtime_globls(s);
  }
  s = emit_module_funcs(mod, all_funcs, s, globl_defs, lo, hi, cache, physical);
  for en in 0..extra_needs.len() {
    s = s.need(extra_needs[en]);
  }
  if (is_entry && globl_defs) {
    s = emit_trap_stub_globls(s);
  }
  if (is_entry && asmcore.process_entry(s)) {
    s = emit_process_entry(mod, s);
  }
  s = intern_runtime_shapes(s);
  s = asmcore.emit_debug_rows(s);
  if (s.string_lits.len() > 0) {
    s = s.write("    .section .rodata\n");
    let li = 0;
    while (li < s.string_lits.len()) {
      s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
      li += 1;
    }
    s = asmcore.emit_str_box_data_from(s, 0);
  }
  s = asmcore.emit_const_agg_data(s);
  s = emit_sym_addrs_from(s, 0);
  s = emit_lane_consts(s);
  s = asmcore.emit_shuffle_masks(s);
  s = asmcore.emit_shape_lits_from(s, 0);
  if (is_entry) {
    s = emit_entry_runtime_settled(s);
    if (s.sandbox) {
      s = emit_seccomp_install(s);
    }
  }
  if (is_entry && asmcore.reset_entry(s)) {
    s = s.write("    .section .data\n    .p2align 4\n    .section .bss\n    .p2align 4\n__fern_bss_end:\n    .text\n");
  }
  irverifygate.close_memo(s.memo);
  let leak = asmcore.hostless_syscall_refusal(s);
  if (is_entry && leak.len() > 0) {
    eprint(leak);
    exit(2);
    return ssaprepare.Output { text: "", bodies: [] };
  }
  return ssaprepare.Output { text: s.take_text(), bodies: s.prepared };
}

function emit_seccomp_install(s: asmcore.EmitState): asmcore.EmitState {
  let allowed = asmcore.seccomp_allowlist(s);
  s = s.write("    .section .text\n__fern_seccomp_install:\n");
  s = s.write("    movq $38, %rdi\n    movq $1, %rsi\n    movq $0, %rdx\n    movq $0, %r10\n    movq $0, %r8\n    movq $157, %rax\n").syscall(157);
  s = s.write("    subq $16, %rsp\n    movq $" + util.i32_to_string(asmcore.seccomp_filter_len(s, allowed)) + ", %rax\n    movq %rax, (%rsp)\n");
  s = s.write("    leaq .Lseccomp_filter(%rip), %rax\n    movq %rax, 8(%rsp)\n");
  s = s.write("    movq $1, %rdi\n    movq $0, %rsi\n    movq %rsp, %rdx\n    movq $317, %rax\n").syscall(317);
  s = s.write("    addq $16, %rsp\n    ret\n");
  s = asmcore.emit_seccomp_filter(s, "0xC000003E", allowed);
  return s.write("    .section .text\n");
}

function emit_entry_runtime_settled(s0: asmcore.EmitState): asmcore.EmitState {
  let s = s0;
  let settled = false;
  let out = s0;
  while (!settled) {
    let h = buf_new(65536);
    let m = buf_new(256);
    let t = emit_entry_runtime(asmcore.EmitState { ...s, capture: h, missed: m });
    let text = buf_take(h);
    buf_free(h);
    if (asmcore.settles(t, s.needed.len(), m)) {
      settled = true;
      let back = asmcore.EmitState { ...t, capture: s0.capture, missed: s0.missed };
      out = back.write(text);
    } else {
      s = asmcore.EmitState { ...s0, needed: t.needed, runtime_units: t.runtime_units };
    }
  }
  return out;
}

function emit_process_entry(mod: parser.Module, own s: asmcore.EmitState): asmcore.EmitState {
  if (s.pie) {
    s = s.write("    .section .data\n    .align 8\n.Lfern_relanchor:\n    .quad .Lfern_relanchor\n__fern_reloc_list:\n    .quad 0\n__fern_reloc_count:\n    .quad 0\n    .text\n");
  }
  s = s.write("_start:\n");
  if (s.pie) {
    s = emit_self_relocation(s);
  }
  s = emit_relro_protect(s);
  if (s.sandbox) {
    s = s.write("    call __fern_seccomp_install\n");
  }
  if (s.has_need("args")) {
    s = s.write("    movq (%rsp), %rax\n");
    s = s.write("    movq %rax, __fern_argc(%rip)\n");
    s = s.write("    leaq 8(%rsp), %rax\n");
    s = s.write("    movq %rax, __fern_argv(%rip)\n");
  }
  if (envp_wanted(s)) {
    s = s.write("    movq (%rsp), %rax\n");
    s = s.write("    leaq 16(%rsp,%rax,8), %rax\n");
    s = s.write("    movq %rax, __fern_envp(%rip)\n");
  }
  if (asmcore.vdso_wanted(s, "x86-64-linux")) {
    s = emit_vdso_scan(s);
  }
  if (!s.shared) {
    s = emit_stack_switch(s);
    if (s.harden) {
      s = emit_canary_init(s);
      s = emit_shadow_stack_enable(s);
    }
  }
  if (s.profile > 0) {
    s = s.write("    leaq .Lprofile_ring(%rip), %rax\n    movq %rsp, %rsi\n    leaq .Lprofile_action(%rip), %rdi\n    leaq .Lprofile_timer(%rip), %r8\n    call __fn___fern_profile_start.r\n");
  }
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  return emit_process_finish(mod, s);
}

// The anchor holds its own link-time address, so the difference from its runtime
// address is the load delta. Every listed word gains the delta, the anchor included.
function emit_self_relocation(own s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    leaq .Lfern_relanchor(%rip), %rax\n");
  s = s.write("    movq (%rax), %rcx\n");
  s = s.write("    subq %rcx, %rax\n");
  s = s.write("    jz .Lfern_reloc_done\n");
  s = s.write("    movq __fern_reloc_count(%rip), %rcx\n");
  s = s.write("    movq __fern_reloc_list(%rip), %rsi\n");
  s = s.write("    addq %rax, %rsi\n");
  s = s.write(".Lfern_reloc_loop:\n");
  s = s.write("    cmpq $0, %rcx\n");
  s = s.write("    je .Lfern_reloc_done\n");
  s = s.write("    movq (%rsi), %rdi\n");
  s = s.write("    addq %rax, %rdi\n");
  s = s.write("    addq %rax, (%rdi)\n");
  s = s.write("    addq $8, %rsi\n");
  s = s.write("    subq $1, %rcx\n");
  s = s.write("    jmp .Lfern_reloc_loop\n");
  s = s.write(".Lfern_reloc_done:\n");
  return s;
}

// The two slots hold the link-time address and the length of the read-only
// region. The relocation loop leaves the load delta in %rax. The start is
// rounded down and the end is rounded down to the page size the kernel
// reports in AT_PAGESZ, so no writable word is ever covered.
function emit_relro_protect(own s: asmcore.EmitState): asmcore.EmitState {
  if (!asmcore.relro_protection_needed(s)) {
    return s;
  }
  s = s.need("relro_protect");
  s = s.write("    .section .data\n    .align 8\n__fern_relro_begin:\n    .quad 0\n__fern_relro_len:\n    .quad 0\n    .text\n");
  if (!s.pie) {
    s = s.write("    xorl %eax, %eax\n");
  }
  s = s.write("    movq __fern_relro_len(%rip), %rsi\n");
  s = s.write("    testq %rsi, %rsi\n");
  s = s.write("    jz .Lfern_relro_done\n");
  s = s.write("    movq __fern_relro_begin(%rip), %rdi\n");
  s = s.write("    addq %rax, %rdi\n");
  s = s.write("    movq (%rsp), %rax\n");
  s = s.write("    leaq 16(%rsp,%rax,8), %rax\n");
  s = s.write(".Lfern_relro_env:\n");
  s = s.write("    movq (%rax), %rcx\n");
  s = s.write("    addq $8, %rax\n");
  s = s.write("    testq %rcx, %rcx\n");
  s = s.write("    jnz .Lfern_relro_env\n");
  s = s.write("    movl $4096, %ecx\n");
  s = s.write(".Lfern_relro_scan:\n");
  s = s.write("    movq (%rax), %rdx\n");
  s = s.write("    testq %rdx, %rdx\n");
  s = s.write("    jz .Lfern_relro_pagesz\n");
  s = s.write("    addq $16, %rax\n");
  s = s.write("    cmpq $6, %rdx\n");
  s = s.write("    jne .Lfern_relro_scan\n");
  s = s.write("    movq -8(%rax), %rcx\n");
  s = s.write(".Lfern_relro_pagesz:\n");
  s = s.write("    negq %rcx\n");
  s = s.write("    addq %rdi, %rsi\n");
  s = s.write("    andq %rcx, %rsi\n");
  s = s.write("    andq %rcx, %rdi\n");
  s = s.write("    subq %rdi, %rsi\n");
  s = s.write("    jle .Lfern_relro_done\n");
  s = s.write("    movl $1, %edx\n");
  s = s.write("    movl $10, %eax\n");
  s = s.syscall(10);
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jnz .Lfern_relro_failed\n");
  return s.write(".Lfern_relro_done:\n");
}

function emit_stack_switch(own s: asmcore.EmitState): asmcore.EmitState {
  s = emit_stack_map(s, asmcore.stack_size());
  s = s.write("    cmpq $-4096, %rax\n    ja .Lfern_stack_map_failed\n    movq %rax, %rbx\n    movq %rax, %rdi\n    movq $" + util.i32_to_string(asmcore.stack_guard()) + ", %rsi\n    xorl %edx, %edx\n    movl $10, %eax\n");
  s = s.syscall(10);
  s = s.write("    testq %rax, %rax\n    jnz .Lfern_stack_guard_failed\n    leaq " + util.i32_to_string(asmcore.stack_size() - 16) + "(%rbx), %rsp\n    movq %rsp, __fern_stack_top(%rip)\n");
  s = emit_stack_map(s, 65536);
  s = s.write("    cmpq $-4096, %rax\n    ja .Lfern_signal_stack_map_failed\n    subq $32, %rsp\n    movq %rax, (%rsp)\n    movq $0, 8(%rsp)\n    movq $65536, 16(%rsp)\n    movq %rsp, %rdi\n    xorl %esi, %esi\n    movl $131, %eax\n");
  s = s.syscall(131);
  s = s.write("    testq %rax, %rax\n    jnz .Lfern_signal_stack_failed\n    leaq __fern_segv(%rip), %rax\n    movq %rax, (%rsp)\n    movq $0x0c000004, 8(%rsp)\n");
  return s.write("    call .Lfern_fault_install\n    testq %rax, %rax\n    jnz .Lfern_fault_handler_failed\n    addq $32, %rsp\n");
}

function emit_stack_map(own s: asmcore.EmitState, size: i32): asmcore.EmitState {
  s = s.write("    xorl %edi, %edi\n    movq $" + util.i32_to_string(size) + ", %rsi\n    movl $3, %edx\n    movl $0x24022, %r10d\n    movq $-1, %r8\n    xorl %r9d, %r9d\n    movl $9, %eax\n");
  return s.syscall(9);
}

// Installs the action the caller built at its (%rsp) for SIGSEGV, SIGILL and
// SIGBUS, and returns the first refusal in %rax, or 0.
// The handler runs with SIGSEGV, SIGILL and SIGBUS blocked (mask 0x448).
function emit_fault_install(own s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(".Lfern_fault_install:\n    leaq .Lfern_segv_restorer(%rip), %rax\n    movq %rax, 24(%rsp)\n    movq $0x448, 32(%rsp)\n    leaq 8(%rsp), %rsi\n    xorl %edx, %edx\n    movl $8, %r10d\n");
  for signo in [11, 4, 7] {
    s = s.write("    movl $" + util.i32_to_string(signo) + ", %edi\n    movl $13, %eax\n").syscall(13);
    s = s.write("    testq %rax, %rax\n    jnz .Lfern_fault_install_done\n");
  }
  return s.write(".Lfern_fault_install_done:\n    ret\n");
}

function emit_stack_overflow_runtime(s: asmcore.EmitState): asmcore.EmitState {
  let msg = aborts.stack_overflow();
  let ill = aborts.illegal_instruction();
  let bus = aborts.bus_error();
  s = s.write("    .section .bss\n    .align 8\n__fern_sig_sp: .quad 0\n    .section .rodata\n.Lmsg_stack_overflow:\n    .ascii \"" + msg + "\\n\"\n.Lmsg_illegal_instruction:\n    .ascii \"" + ill + "\\n\"\n.Lmsg_bus_error:\n    .ascii \"" + bus + "\\n\"\n    .text\n");
  // A fault inside the guard of the runtime's own stack is an overflow.
  s = s.write("__fern_segv:\n    cmpq $11, %rdi\n    jne .Lfern_fatal_signal\n    movq 16(%rsi), %rax\n    movq __fern_stack_top(%rip), %rcx\n    subq $1073741808, %rcx\n    subq %rcx, %rax\n    cmpq $1048576, %rax\n    jae .Lfern_segv_other\n.Lfern_segv_overflow:\n    movq 168(%rdx), %rax\n    movq 120(%rdx), %rcx\n    subq $16, %rsp\n    movq %rcx, (%rsp)\n    movq %rax, 8(%rsp)\n    movq %rsp, %rbp\n    movq 160(%rdx), %rax\n    movq %rax, __fern_bt_floor(%rip)\n    leaq .Lmsg_stack_overflow(%rip), %rsi\n    movq $" + util.i32_to_string(msg.len() + 1) + ", %rdx\n    movq $134, %rdi\n    jmp __fern_report\n.Lfern_segv_other:\n    subq $32, %rsp\n    movq $0, (%rsp)\n    movq $0x04000000, 8(%rsp)\n");
  s = s.write("    call .Lfern_fault_install\n    addq $32, %rsp\n    ret\n.Lfern_segv_restorer:\n    movl $15, %eax\n");
  s = s.syscall(15);
  s = emit_fault_install(s);
  // A SIGILL or SIGBUS the kernel raised writes its cause and takes the
  // default action again: the return repeats the fault. A sent one exits.
  s = s.write(".Lfern_fatal_signal:\n    movslq 8(%rsi), %rax\n    testq %rax, %rax\n    jle .Lfern_signal_sent\n    movq %rsp, __fern_sig_sp(%rip)\n    movq 168(%rdx), %rax\n    movq 120(%rdx), %rcx\n    subq $16, %rsp\n    movq %rcx, (%rsp)\n    movq %rax, 8(%rsp)\n    movq %rsp, %rbp\n    movq 160(%rdx), %rax\n    movq %rax, __fern_bt_floor(%rip)\n");
  s = s.write("    leaq .Lmsg_illegal_instruction(%rip), %rsi\n    movq $" + util.i32_to_string(ill.len() + 1) + ", %rdx\n    cmpq $4, %rdi\n    je .Lfern_fatal_report\n    leaq .Lmsg_bus_error(%rip), %rsi\n    movq $" + util.i32_to_string(bus.len() + 1) + ", %rdx\n.Lfern_fatal_report:\n    movq $-1, %rdi\n    jmp __fern_report\n");
  s = s.write(".Lfern_signal_resume:\n    movq __fern_sig_sp(%rip), %rsp\n    jmp .Lfern_segv_other\n.Lfern_signal_sent:\n    addq $128, %rdi\n    movl $231, %eax\n");
  return s.syscall(231);
}

function emit_startup_failures(own s: asmcore.EmitState): asmcore.EmitState {
  if (s.has_need("relro_protect")) {
    s = emit_startup_failure(s, ".Lfern_relro_failed", aborts.relro());
  }
  s = emit_startup_failure(s, ".Lfern_stack_map_failed", aborts.stack_map());
  s = emit_startup_failure(s, ".Lfern_stack_guard_failed", aborts.stack_guard());
  s = emit_startup_failure(s, ".Lfern_signal_stack_map_failed", aborts.signal_stack_map());
  s = emit_startup_failure(s, ".Lfern_signal_stack_failed", aborts.signal_stack());
  s = emit_startup_failure(s, ".Lfern_fault_handler_failed", aborts.fault_handler());
  return emit_harden_failures(s);
}

function emit_harden_failures(own s: asmcore.EmitState): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  s = emit_startup_failure(s, ".Lfern_canary_read_failed", aborts.canary_read());
  s = emit_startup_failure(s, "__fern_canary_fail", aborts.canary());
  s = emit_startup_failure(s, "__fern_cfi_fail", aborts.cfi());
  return emit_startup_failure(s, "__fern_cfi_sig_fail", aborts.cfi_sig());
}

// A shared object has no startup, so its first export call reads the
// canary. The export entry calls it with the arguments still in registers.
function emit_harden_start(own s: asmcore.EmitState): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  s = s.write("__fern_harden_start:\n    pushq %rdi\n    pushq %rsi\n    pushq %rdx\n    pushq %rcx\n    pushq %r11\n    pushq %rax\n");
  s = emit_canary_init(s);
  s = s.write("    popq %rax\n    popq %r11\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %rdi\n    ret\n");
  return emit_harden_failures(s);
}

function emit_canary_init(own s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    leaq __fern_canary(%rip), %rdi\n    movl $16, %esi\n    xorl %edx, %edx\n    movl $318, %eax\n");
  s = s.syscall(318);
  s = s.write("    cmpq $16, %rax\n    jne .Lfern_canary_read_failed\n");
  return s.write("    orq $1, __fern_rng_state(%rip)\n");
}

// arch_prctl(ARCH_SHSTK_ENABLE, ARCH_SHSTK_SHSTK) turns the shadow stack on
// where the processor and the kernel have it, and ARCH_SHSTK_LOCK then keeps
// it on. A kernel without the feature answers an error, which leaves the
// process as it was. std/mitigations reports the outcome.
function emit_shadow_stack_enable(own s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movl $20481, %edi\n    movl $1, %esi\n    movl $158, %eax\n");
  s = s.syscall(158);
  s = s.write("    testq %rax, %rax\n    jnz .Lfern_shstk_off\n    movl $20483, %edi\n    movl $1, %esi\n    movl $158, %eax\n");
  s = s.syscall(158);
  return s.write(".Lfern_shstk_off:\n");
}

function emit_startup_failure(own s: asmcore.EmitState, label: string, msg: string): asmcore.EmitState {
  s = s.write("    .section .rodata\n" + label + "_msg:\n    .ascii \"" + msg + "\\n\"\n    .text\n" + label + ":\n");
  s = s.write("    leaq " + label + "_msg(%rip), %rsi\n    movq $" + util.i32_to_string(msg.len() + 1) + ", %rdx\n    movl $2, %edi\n    movl $1, %eax\n");
  s = s.syscall(1);
  s = s.write("    movl $134, %edi\n    movl $231, %eax\n");
  return s.syscall(231);
}

// The page tables and the GDT of the reset entry: a PML4, a PDPT, four page
// directories and a GDT page, below the stack.
function reset_tables(s: asmcore.EmitState): i64 {
  return s.ram_base + s.ram_size - asmcore.reset_stack_bytes() - 7i64 * 4096i64;
}

// A VMM enters _start through the PVH note in 32-bit protected mode with
// paging off, and with the address of its start info in %ebx. The 32-bit code identity-maps 4 GiB with 2 MiB pages, enables
// SSE, AVX and long mode, and returns far to __fern_start64.
function emit_reset_start(s: asmcore.EmitState): asmcore.EmitState {
  let top = s.ram_base + s.ram_size;
  let blob = reset_trampoline(reset_tables(s) as i32, top as i32);
  s = s.write("    .section .data\n    .align 8\n__fern_boot_info:\n    .quad 0\n");
  s = s.write("    .section .bss\n    .p2align 2\n__fern_irq_pending:\n    .skip " + util.i32_to_string(asmcore.irq_region_bytes()) + "\n    .text\n_start:\n");
  let i = 0;
  while (i < blob.len()) {
    let w = blob[i] | blob[i + 1] << 8 | blob[i + 2] << 16 | blob[i + 3] << 24;
    s = s.write("    .long " + util.i32_to_string(w) + "\n");
    i += 4;
  }
  s = s.write("__fern_start64:\n    movl %ebx, %eax\n    movq %rax, __fern_boot_info(%rip)\n    movabsq $" + util.i64_to_string(top) + ", %rax\n    movq %rax, %rsp\n");
  s = s.write("    leaq __fern_bss_start(%rip), %rdi\n    leaq __fern_bss_end(%rip), %rcx\n    subq %rdi, %rcx\n    xorl %eax, %eax\n    rep stosb\n");
  s = emit_idt_load(s);
  if (s.user_mode) {
    s = s.write("    call __fern_user_init\n");
  }
  if (s.early.len() > 0) {
    // The hook runs on the stack, the identity map and the IDT, before the heap
    // starts.
    s = s.write("    call " + s.early + "\n");
  }
  s = s.write("    leaq __fern_bss_end(%rip), %rdi\n    addq $15, %rdi\n    andq $-16, %rdi\n");
  s = s.write("    movabsq $" + util.i64_to_string(reset_tables(s)) + ", %rsi\n    subq %rdi, %rsi\n    call __fern_heap_init\n");
  s = s.write("    xorl %ebp, %ebp\n    pushq %rbp\n    movq %rsp, %rbp\n    call __fn_main\n    movq %rax, %rbx\n");
  if (s.leak_check) {
    s = s.write("    call __fern_lc_report\n");
  }
  s = s.write(exit_provider_call(s, "%rbx") + ".Lreset_park:\n    cli\n    hlt\n    jmp .Lreset_park\n");
  return emit_idt_vectors(s);
}

// A call of the `exit` provider with the code in `reg`, or nothing without one.
function exit_provider_call(s: asmcore.EmitState, reg: string): string {
  if (s.exit_provider.len() == 0) {
    return "";
  }
  return "    pushq " + reg + "\n    pushq " + reg + "\n    call " + s.exit_provider + "\n    addq $16, %rsp\n";
}

// The IDT has 256 interrupt gates in .bss. Each one starts at the park stub,
// and then each handler's gate goes to its trampoline.
function emit_idt_load(s: asmcore.EmitState): asmcore.EmitState {
  if (s.interrupts.len() == 0 && !s.user_mode) {
    return s;
  }
  s = s.write("    .section .bss\n    .p2align 4\n__fern_idt:\n    .skip 4096\n    .text\n");
  // The legacy 8259 PICs keep vector base 0 after a reset, where an IRQ arrives
  // as a CPU exception. Both are masked before IF can be set.
  s = s.write("    movb $255, %al\n    movl $33, %edx\n    outb %al, %dx\n    movl $161, %edx\n    outb %al, %dx\n");
  if (s.user_mode) {
    // Each vector has its own gate of 32 bytes, which knows its number.
    return s.write("    leaq __fern_idt(%rip), %rdi\n    leaq __fern_user_gates(%rip), %rax\n    movl $256, %ecx\n.Lidt_fill:\n    call __fern_idt_gate\n    addq $16, %rdi\n    addq $32, %rax\n    decl %ecx\n    jnz .Lidt_fill\n" + idt_register());
  }
  s = s.write("    leaq __fern_idt(%rip), %rdi\n    movl $256, %ecx\n.Lidt_fill:\n    leaq .Lvector_park(%rip), %rax\n    call __fern_idt_gate\n    addq $16, %rdi\n    decl %ecx\n    jnz .Lidt_fill\n");
  for entry in s.interrupts {
    let parts = util.split_char(entry, b' ');
    let at = util.i32_to_string(16 * norc.x86_vector(parts[0]));
    s = s.write("    leaq __fern_idt(%rip), %rdi\n    addq $" + at + ", %rdi\n    leaq __fern_vector_" + parts[0] + "(%rip), %rax\n    call __fern_idt_gate\n");
  }
  return s.write(idt_register());
}

function idt_register(): string {
  return "    subq $16, %rsp\n    movl $4095, (%rsp)\n    leaq __fern_idt(%rip), %rax\n    movq %rax, 2(%rsp)\n    lidt (%rsp)\n    addq $16, %rsp\n";
}

// __fern_idt_gate writes the interrupt gate at %rdi to the code at %rax: the
// 64-bit code segment 8, present, DPL 0, type 0xe.
function emit_idt_vectors(s: asmcore.EmitState): asmcore.EmitState {
  if (s.interrupts.len() == 0 && !s.user_mode) {
    return s;
  }
  s = s.write("__fern_idt_gate:\n    movl %eax, %edx\n    andl $65535, %edx\n    orl $524288, %edx\n    movl %edx, (%rdi)\n");
  s = s.write("    movl %eax, %edx\n    andl $-65536, %edx\n    orl $36352, %edx\n    movl %edx, 4(%rdi)\n");
  s = s.write("    movq %rax, %rdx\n    shrq $32, %rdx\n    movl %edx, 8(%rdi)\n    movl $0, 12(%rdi)\n    ret\n");
  s = s.write(".Lvector_park:\n    cli\n    hlt\n    jmp .Lvector_park\n");
  for entry in s.interrupts {
    let parts = util.split_char(entry, b' ');
    s = emit_idt_trampoline(s, parts[0], parts[1], norc.x86_error_code(norc.x86_vector(parts[0])));
  }
  if (s.user_mode) {
    s = emit_user_run(s);
  }
  return s;
}

// The label that takes vector `v` from ring 0: the trampoline of its handler,
// or the park stub.
function kernel_vector_target(interrupts: string[], v: i32): string {
  for entry in interrupts {
    let parts = util.split_char(entry, b' ');
    if (norc.x86_vector(parts[0]) == v) {
      return "__fern_vector_" + parts[0];
    }
  }
  return ".Lvector_park";
}

// The 16 general registers of the trap frame in `base`, in the order of their
// numbers, without %rsp and without `base`. A load reads each register from
// the frame, and a store writes it to the frame.
function user_frame_gprs(load: boolean, base: string): string {
  let names = ["rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"];
  let out = "";
  for i in 0..names.len() {
    if (names[i] != "rsp" && names[i] != base) {
      let at = util.i32_to_string(8 * i) + "(%" + base + ")";
      if (load) {
        out = out + "    movq " + at + ", %" + names[i] + "\n";
      } else {
        out = out + "    movq %" + names[i] + ", " + at + "\n";
      }
    }
  }
  return out;
}

// ymm0 to ymm15 of the trap frame in %rdi.
function user_frame_vectors(load: boolean): string {
  let out = "";
  for i in 0..16 {
    let at = util.i32_to_string(192 + 32 * i) + "(%rdi)";
    let reg = "%ymm" + util.i32_to_string(i);
    if (load) {
      out = out + "    vmovdqu " + at + ", " + reg + "\n";
    } else {
      out = out + "    vmovdqu " + reg + ", " + at + "\n";
    }
  }
  return out;
}

// A read of the model-specific register `index` into `to`, and a write of it
// from `from`. Both use %rax, %rcx and %rdx.
function msr_read(index: i64, to: string): string {
  return "    movl $" + util.i64_to_string(index) + ", %ecx\n    rdmsr\n    shlq $32, %rdx\n    orq %rdx, %rax\n    movq %rax, " + to + "\n";
}

function msr_write(index: i64, from: string): string {
  return "    movq " + from + ", %rax\n    movq %rax, %rdx\n    shrq $32, %rdx\n    movl $" + util.i64_to_string(index) + ", %ecx\n    wrmsr\n";
}

// The trap frame of __user_run: the 16 general registers at 0 in the order of
// their numbers, the PC at 128, the flags at 136, the FS and GS bases at 144
// and 152, the vector, the error code and CR2 of the last trap at 160, 168 and
// 176, MXCSR at 184, and ymm0 to ymm15 at 192, 704 bytes in all.
// __fern_user_ctx holds the frame of the running process, the stack pointer
// of the kernel and one scratch word. Only one core runs a process.
function emit_user_run(s: asmcore.EmitState): asmcore.EmitState {
  let fs = 0xc0000100i64;
  let gs = 0xc0000101i64;
  s = s.write("    .section .bss\n    .p2align 4\n__fern_user_gdt:\n    .skip 64\n__fern_user_tss:\n    .skip 112\n__fern_user_ctx:\n    .skip 32\n    .text\n");
  // The GDT keeps the kernel segments of the reset entry at 8 and 16, and adds
  // the ring 3 data segment at 32, the ring 3 code segment at 40 and the TSS
  // at 48. SYSCALL takes its segments from STAR, its target from LSTAR, and
  // clears TF, IF, DF, NT and AC through FMASK.
  s = s.write("__fern_user_init:\n    leaq __fern_user_gdt(%rip), %rdi\n    movl $65535, 8(%rdi)\n    movl $11508224, 12(%rdi)\n    movl $65535, 16(%rdi)\n    movl $13603328, 20(%rdi)\n");
  s = s.write("    movl $65535, 32(%rdi)\n    movl $13628928, 36(%rdi)\n    movl $65535, 40(%rdi)\n    movl $11532800, 44(%rdi)\n");
  s = s.write("    leaq __fern_user_tss(%rip), %rax\n    movl %eax, %edx\n    shll $16, %edx\n    orl $103, %edx\n    movl %edx, 48(%rdi)\n");
  s = s.write("    movq %rax, %rdx\n    shrq $16, %rdx\n    andl $255, %edx\n    movl %eax, %ecx\n    andl $-16777216, %ecx\n    orl %ecx, %edx\n    orl $35072, %edx\n    movl %edx, 52(%rdi)\n");
  s = s.write("    movq %rax, %rdx\n    shrq $32, %rdx\n    movl %edx, 56(%rdi)\n    movl $6815744, 100(%rax)\n");
  s = s.write("    subq $16, %rsp\n    movl $63, (%rsp)\n    movq %rdi, 2(%rsp)\n    lgdt (%rsp)\n    movl $48, (%rsp)\n    ltr (%rsp)\n    addq $16, %rsp\n");
  s = s.write("    movl $3221225600, %ecx\n    rdmsr\n    orl $1, %eax\n    wrmsr\n");
  s = s.write("    movl $3221225601, %ecx\n    xorl %eax, %eax\n    movl $1769480, %edx\n    wrmsr\n");
  s = s.write("    leaq __fern_user_syscall(%rip), %rax\n    movq %rax, %rdx\n    shrq $32, %rdx\n    movl $3221225602, %ecx\n    wrmsr\n");
  s = s.write("    movl $3221225604, %ecx\n    movl $280320, %eax\n    xorl %edx, %edx\n    wrmsr\n    ret\n");
  // __user_run(frame): keep the registers that a call keeps, the flags, and
  // the FS base, GS base and MXCSR of the kernel, which the frame replaces.
  // A PC outside the low half makes iretq fault in ring 0, so it is answered
  // as the general-protection fault that the process would take.
  s = s.write("__fern_user_run:\n    pushfq\n    pushq %rbx\n    pushq %rbp\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    subq $24, %rsp\n    cli\n    movq %rax, %rdi\n");
  s = s.write("    movq 128(%rdi), %rax\n    shrq $47, %rax\n    jnz .Luser_bad_pc\n");
  s = s.write("    movq %rdi, __fern_user_ctx(%rip)\n    movq %rsp, __fern_user_ctx+8(%rip)\n    movq %rsp, __fern_user_tss+4(%rip)\n");
  s = s.write(msr_read(fs, "0(%rsp)") + msr_read(gs, "8(%rsp)") + "    stmxcsr 16(%rsp)\n");
  s = s.write(msr_write(fs, "144(%rdi)") + msr_write(gs, "152(%rdi)") + "    ldmxcsr 184(%rdi)\n" + user_frame_vectors(true));
  // The process gets its arithmetic flags and DF. IF is set and IOPL is 0.
  s = s.write("    pushq $35\n    pushq 32(%rdi)\n    movq 136(%rdi), %rax\n    andl $3285, %eax\n    orl $514, %eax\n    pushq %rax\n    pushq $43\n    pushq 128(%rdi)\n");
  s = s.write(user_frame_gprs(true, "rdi") + "    movq 56(%rdi), %rdi\n    iretq\n");
  s = s.write(".Luser_bad_pc:\n    movq $13, 160(%rdi)\n    movq $0, 168(%rdi)\n    movl $2, %eax\n    jmp .Luser_ret\n");
  // SYSCALL leaves the user PC in %rcx and the user flags in %r11, and it
  // keeps the user stack.
  s = s.write("__fern_user_syscall:\n    movq %rcx, __fern_user_ctx+16(%rip)\n    movq __fern_user_ctx(%rip), %rcx\n" + user_frame_gprs(false, "rcx"));
  s = s.write("    movq %rsp, 32(%rcx)\n    movq __fern_user_ctx+16(%rip), %rax\n    movq %rax, 8(%rcx)\n    movq %rax, 128(%rcx)\n    movq %r11, 136(%rcx)\n");
  s = s.write("    movq %rcx, %rdi\n    movq __fern_user_ctx+8(%rip), %rsp\n    xorl %r12d, %r12d\n    jmp .Luser_leave\n");
  // A gate of a vector. An exception or an interrupt from ring 0 goes to the
  // trampoline of its handler, or parks. One from ring 3 pushes its number,
  // after a zero where the CPU pushes no error code.
  s = s.write("    .p2align 5\n__fern_user_gates:\n");
  for v in 0..256 {
    let cs = "8";
    let zero = "    pushq $0\n";
    if (norc.x86_error_code(v)) {
      cs = "16";
      zero = "";
    }
    s = s.write("    .p2align 5\n    testb $3, " + cs + "(%rsp)\n    jz " + kernel_vector_target(s.interrupts, v) + "\n" + zero + "    pushq $" + util.i32_to_string(v) + "\n    jmp __fern_user_trap\n");
  }
  // The CPU switched to the stack of the TSS, which is the kernel stack of
  // __user_run. It aligned that stack, and pushed SS, the stack pointer, the
  // flags, CS and the PC.
  s = s.write("    .p2align 5\n__fern_user_trap:\n    pushq %rdi\n    movq __fern_user_ctx(%rip), %rdi\n" + user_frame_gprs(false, "rdi"));
  s = s.write("    popq %rax\n    movq %rax, 56(%rdi)\n    popq %rax\n    movq %rax, 160(%rdi)\n    popq %rax\n    movq %rax, 168(%rdi)\n    popq %rax\n    movq %rax, 128(%rdi)\n    popq %rax\n");
  s = s.write("    popq %rax\n    movq %rax, 136(%rdi)\n    popq %rax\n    movq %rax, 32(%rdi)\n    movq __fern_user_ctx+8(%rip), %rsp\n    movq %cr2, %rax\n    movq %rax, 176(%rdi)\n");
  s = s.write("    movl $2, %r12d\n    cmpq $32, 160(%rdi)\n    jb .Luser_leave\n    movl $1, %r12d\n");
  // The frame is in %rdi and the kind in %r12, on the kernel stack.
  s = s.write(".Luser_leave:\n    cld\n" + msr_read(fs, "144(%rdi)") + msr_read(gs, "152(%rdi)") + "    stmxcsr 184(%rdi)\n" + user_frame_vectors(false));
  s = s.write(msr_write(fs, "0(%rsp)") + msr_write(gs, "8(%rsp)") + "    ldmxcsr 16(%rsp)\n    movq %r12, %rax\n    cmpl $1, %eax\n    jne .Luser_ret\n    movq 160(%rdi), %rax\n");
  // An interrupt from ring 3 runs the top half of its vector here, in ring 0
  // with the registers of the kernel, before __user_run returns.
  for entry in s.interrupts {
    let parts = util.split_char(entry, b' ');
    if (norc.x86_vector(parts[0]) >= 32) {
      s = s.write("    leaq " + parts[1] + "(%rip), %rcx\n    cmpq $" + util.i32_to_string(norc.x86_vector(parts[0])) + ", %rax\n    je .Luser_irq\n");
    }
  }
  s = s.write("    movl $1, %eax\n    jmp .Luser_ret\n");
  s = s.write(".Luser_irq:\n    movq 24(%rsp), %r15\n    movq 32(%rsp), %r14\n    movq 40(%rsp), %r13\n    movq 48(%rsp), %r12\n    movq 56(%rsp), %rbp\n    movq 64(%rsp), %rbx\n");
  s = s.write("    movq %rsp, %rax\n    andq $-16, %rsp\n    subq $16, %rsp\n    movq %rax, (%rsp)\n    call *%rcx\n    movq (%rsp), %rsp\n    movl $1, %eax\n");
  return s.write(".Luser_ret:\n    addq $24, %rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbp\n    popq %rbx\n    popfq\n    ret\n");
}

// The trampoline saves the registers that a call can change: the nine
// caller-saved general registers and ymm0 to ymm15. The frame keeps %rsp
// 16-byte aligned at the call. It drops the error code that the CPU pushed for
// some exceptions, and returns with iretq.
function emit_idt_trampoline(s: asmcore.EmitState, slot: string, handler: string, error_code: boolean): asmcore.EmitState {
  let gprs = ["rax", "rcx", "rdx", "rsi", "rdi", "r8", "r9", "r10", "r11"];
  let frame = "512";
  if (error_code) {
    frame = "520";
  }
  s = s.write("__fern_vector_" + slot + ":\n");
  for r in gprs {
    s = s.write("    pushq %" + r + "\n");
  }
  s = s.write("    subq $" + frame + ", %rsp\n");
  for i in 0..16 {
    s = s.write("    vmovdqu %ymm" + util.i32_to_string(i) + ", " + util.i32_to_string(32 * i) + "(%rsp)\n");
  }
  s = s.write("    cld\n    call " + handler + "\n");
  for i in 0..16 {
    s = s.write("    vmovdqu " + util.i32_to_string(32 * i) + "(%rsp), %ymm" + util.i32_to_string(i) + "\n");
  }
  s = s.write("    addq $" + frame + ", %rsp\n");
  let k = gprs.len() - 1;
  while (k >= 0) {
    s = s.write("    popq %" + gprs[k] + "\n");
    k -= 1;
  }
  if (error_code) {
    s = s.write("    addq $8, %rsp\n");
  }
  return s.write("    iretq\n");
}

// movl $value, address
function movl_abs(b: i32[], address: i32, value: i32): i32[] {
  return util.le32(util.le32(b.append(199).append(5), address), value);
}

// The 32-bit code of the reset entry, padded with nop to whole words. Its
// tables start at `t`, and the 64-bit code follows it.
function reset_trampoline(t: i32, top: i32): i32[] {
  // PVH leaves %esp unspecified. Set it before call or push uses the stack.
  // cli; mov $top, %esp. Set the stack segment before the first call too.
  let b = util.le32([250, 188], top);
  // Zero the seven pages: mov $t, %edi; xor %eax, %eax; mov $7168, %ecx; cld; rep stosl.
  b = util.le32(b.append(191), t).append(49).append(192);
  b = util.le32(b.append(185), 7168).append(252).append(243).append(171);
  b = movl_abs(b, t, t + 4096 + 3);
  for i in 0..4 {
    b = movl_abs(b, t + 4096 + i * 8, t + 8192 + i * 4096 + 3);
  }
  // Each PD entry maps 2 MiB: mov $t+8192, %edi; mov $0x83, %eax; mov $2048, %ecx;
  // 1: mov %eax, (%edi); add $0x200000, %eax; add $8, %edi; loop 1b.
  b = util.le32(b.append(191), t + 8192);
  b = util.le32(b.append(184), 131);
  b = util.le32(b.append(185), 2048);
  b = util.le32(b.append(137).append(7).append(5), 2097152).append(131).append(199).append(8).append(226).append(244);
  // The GDT: a 64-bit code segment at 8 and a data segment at 16, and its
  // pointer at gdt + 48.
  let gdt = t + 24576;
  b = movl_abs(movl_abs(b, gdt + 8, 65535), gdt + 12, 11508224);
  b = movl_abs(movl_abs(b, gdt + 16, 65535), gdt + 20, 13603328);
  b = util.le32(b.append(102).append(199).append(5), gdt + 48).append(23).append(0);
  b = movl_abs(b, gdt + 50, gdt);
  b = util.le32(b.append(15).append(1).append(21), gdt + 48);
  // mov $16, %eax; mov %eax to %ds, %es, %ss.
  b = util.le32(b.append(184), 16).append(142).append(216).append(142).append(192).append(142).append(208);
  // call 1f; 1: pop %ebp. The anchor uses the configured 32-bit stack.
  let anchor = b.len() + 5;
  b = b.append(232).append(0).append(0).append(0).append(0).append(93);
  // CR4: PAE, OSFXSR, OSXMMEXCPT, OSXSAVE. Then XCR0 = x87 | SSE | AVX.
  b = util.le32(b.append(15).append(32).append(224).append(13), 263712).append(15).append(34).append(224);
  b = util.le32(b.append(49).append(201).append(184), 7).append(49).append(210).append(15).append(1).append(209);
  // CR3 = PML4; EFER.LME and EFER.NXE; CR0 = PG | MP | PE with EM clear.
  b = util.le32(b.append(184), t).append(15).append(34).append(216);
  b = util.le32(b.append(185), -1073741696).append(15).append(50);
  b = util.le32(b.append(13), 2304).append(15).append(48);
  b = b.append(15).append(32).append(192).append(131).append(224).append(251);
  b = util.le32(b.append(13), -2147483645).append(15).append(34).append(192);
  // lea start64-anchor(%ebp), %eax; push $8; push %eax; lret.
  let lea_at = b.len();
  b = util.le32(b.append(141).append(133), 0).append(106).append(8).append(80).append(203);
  while (b.len() % 4 != 0) {
    b = b.append(144);
  }
  let disp = b.len() - anchor;
  for k in 0..4 {
    b = b.with(lea_at + 2 + k, disp >> k * 8 & 255);
  }
  return b;
}

function emit_process_finish(mod: parser.Module, own s: asmcore.EmitState): asmcore.EmitState {
  if (asmcore.has_main(mod)) {
    s = s.write("    call __fn_main\n");
    if (s.has_need("task")) {
      s = s.write("    pushq %rax\n    call __fern_task_close_drop\n    popq %rax\n");
    }
    if (s.leak_check) {
      s = s.write("    pushq %rax\n");
      s = s.write("    call __fern_lc_report\n");
      s = ssa_pop_r(s, "%rax");
    }
    s = s.write("    movq %rax, %rdi\n");
  } else {
    if (s.has_need("task")) {
      s = s.write("    call __fern_task_close_drop\n");
    }
    if (s.leak_check) {
      s = s.write("    call __fern_lc_report\n");
    }
    s = s.write("    movq $0, %rdi\n");
  }
  s = s.write("    movq $231, %rax\n");
  s = s.syscall(231);
  return s;
}

function intern_runtime_shapes(own s: asmcore.EmitState): asmcore.EmitState {
  if (s.any_need(["stat", "lstat", "access", "fd_stat"])) {
    let fsPre = asmcore.shape_ref(s, "FileStat");
    s = fsPre.state;
  }
  if (s.has_need("statfs")) {
    let fvPre = asmcore.shape_ref(s, "FsStat");
    s = fvPre.state;
  }
  if (s.has_need("mounts")) {
    let mePre = asmcore.shape_ref(s, "MountEntry");
    s = mePre.state;
  }
  if (s.has_need("read_dir_ino") || s.has_need("read_dir_ino_all")) {
    let dePre = asmcore.shape_ref(s, "DirEntry");
    s = dePre.state;
  }
  if (s.has_need("window_size")) {
    let wsPre = asmcore.shape_ref(s, "WinSize");
    s = wsPre.state;
  }
  if (s.has_need("subprocess")) {
    let prPre = asmcore.shape_ref(s, "ProcessResult");
    s = prPre.state;
  }
  return s;
}

function emit_profile_alloc_hook(s: asmcore.EmitState): asmcore.EmitState {
  if (!rtprofile.allocation(s.profile)) {
    return s;
  }
  return s.write("    subq $8, %rsp\n    call __fern_profile_alloc\n    addq $8, %rsp\n");
}

function emit_profile_alloc_runtime(s: asmcore.EmitState): asmcore.EmitState {
  if (!rtprofile.allocation(s.profile)) {
    return s;
  }
  s = s.write("__fern_profile_alloc:\n    cmpq $0, .Lprofile_ring+24(%rip)\n    je .Lprofile_alloc_return\n    movq $1, %rax\n    lock xaddq %rax, .Lprofile_ring+144(%rip)\n    addq $1, %rax\n    testq $63, %rax\n    jne .Lprofile_alloc_return\n    movq $39, %rax\n");
  s = s.syscall(39);
  s = s.write("    cmpq .Lprofile_ring+128(%rip), %rax\n    jne .Lprofile_alloc_return\n    movq $186, %rax\n");
  s = s.syscall(186);
  return s.write("    movq %rax, %r10\n    xorl %eax, %eax\n    lock cmpxchgq %r10, .Lprofile_ring+40(%rip)\n    jne .Lprofile_busy\n    subq $8, %rsp\n    leaq -1(%r14), %rax\n    movq %rbp, %rsi\n    movq %rsp, %rdi\n    leaq .Lprofile_ring(%rip), %r8\n    movq %r13, %r9\n    shlq $6, %r9\n    call __fn___fern_profile_sample.r\n    testl %eax, %eax\n    je .Lprofile_alloc_unlock\n    lock addq $1, .Lprofile_ring+8(%rip)\n.Lprofile_alloc_unlock:\n    addq $8, %rsp\n    movq $0, .Lprofile_ring+40(%rip)\n.Lprofile_alloc_return:\n    ret\n");
}

function emit_profile_runtime(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .bss\n    .balign 8\n.Lprofile_ring: .zero 4337824\n    .data\n    .balign 8\n.Lprofile_action: .quad __fern_profile_signal, 335544324, __fern_profile_restorer, 0\n.Lprofile_timer: .quad 0, 10000, 0, 10000\n    .text\n");
  s = emit_runtime("__fern_profile_start __fern_profile_sample __fern_profile_finish", s);
  s = s.write("__fern_profile_signal:\n    cmpq $0, .Lprofile_ring+24(%rip)\n    je .Lprofile_signal_return\n    movq $39, %rax\n");
  s = s.syscall(39);
  s = s.write("    cmpq .Lprofile_ring+128(%rip), %rax\n    jne .Lprofile_signal_return\n    movq $186, %rax\n");
  s = s.syscall(186);
  s = s.write("    movq %rax, %r10\n    xorl %eax, %eax\n    lock cmpxchgq %r10, .Lprofile_ring+40(%rip)\n    jne .Lprofile_busy\n    subq $8, %rsp\n    movq 168(%rdx), %rax\n    movq 120(%rdx), %rsi\n    movq 160(%rdx), %rdi\n    leaq .Lprofile_ring(%rip), %r8\n    movq $1, %r9\n    call __fn___fern_profile_sample.r\n    testl %eax, %eax\n    je .Lprofile_capture_ok\n    lock addq $1, .Lprofile_ring+8(%rip)\n.Lprofile_capture_ok:\n    addq $8, %rsp\n    movq $0, .Lprofile_ring+40(%rip)\n.Lprofile_signal_return:\n    ret\n.Lprofile_busy:\n    lock addq $1, .Lprofile_ring+8(%rip)\n    ret\n__fern_profile_restorer:\n    movq $15, %rax\n");
  s = s.syscall(15);
  s = s.write("    ud2\n__fern_profile_flush:\n    cmpq $2, .Lprofile_ring+32(%rip)\n    je .Lprofile_flush_return\n    movq $39, %rax\n");
  s = s.syscall(39);
  s = s.write("    cmpq .Lprofile_ring+128(%rip), %rax\n    jne .Lprofile_flush_return\n    movq $186, %rax\n");
  s = s.syscall(186);
  s = s.write("    movq %rax, %rdx\n.Lprofile_flush_lock:\n    xorl %eax, %eax\n    lock cmpxchgq %rdx, .Lprofile_ring+40(%rip)\n    je .Lprofile_flush_owned\n    cmpq %rdx, %rax\n    je .Lprofile_flush_reentrant\n    pause\n    jmp .Lprofile_flush_lock\n.Lprofile_flush_reentrant:\n    cmpq $1, .Lprofile_ring+32(%rip)\n    je .Lprofile_flush_return\n.Lprofile_flush_owned:\n    cmpq $2, .Lprofile_ring+32(%rip)\n    je .Lprofile_flush_unlock\n    movq $0, .Lprofile_ring+24(%rip)\n    movq $1, .Lprofile_ring+32(%rip)\n    subq $8, %rsp\n    leaq .Lprofile_ring(%rip), %rax\n    call __fn___fern_profile_finish.r\n    addq $8, %rsp\n    movq $2, .Lprofile_ring+32(%rip)\n.Lprofile_flush_unlock:\n    movq $0, .Lprofile_ring+40(%rip)\n.Lprofile_flush_return:\n    ret\n");
  return emit_profile_alloc_runtime(s);
}

function emit_vdso_scan(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movq (%rsp), %rax\n");
  s = s.write("    leaq 16(%rsp,%rax,8), %rax\n");
  s = s.write(".Lfern_auxv_env:\n");
  s = s.write("    movq (%rax), %rcx\n");
  s = s.write("    addq $8, %rax\n");
  s = s.write("    testq %rcx, %rcx\n");
  s = s.write("    jnz .Lfern_auxv_env\n");
  s = s.write(".Lfern_auxv_scan:\n");
  s = s.write("    movq (%rax), %rcx\n");
  s = s.write("    testq %rcx, %rcx\n");
  s = s.write("    jz .Lfern_auxv_done\n");
  s = s.write("    addq $16, %rax\n");
  s = s.write("    cmpq $33, %rcx\n");
  s = s.write("    jne .Lfern_auxv_scan\n");
  s = s.write("    movq -8(%rax), %rcx\n");
  s = s.write("    movq %rcx, __fern_vdso(%rip)\n");
  s = s.write(".Lfern_auxv_done:\n");
  return s;
}

function emit_rt_clocks(s: asmcore.EmitState): asmcore.EmitState {
  let vdso = asmcore.vdso_wanted(s, "x86-64-linux");
  if (vdso) {
    s = s.need("ccall:__c_call2");
  }
  for which in ["monotonic_ns", "now_unix_ms", "now_ns"] {
    if (s.has_need(which)) {
      s = emit_runtime("__fern_" + which, s.write("    .text\n"));
    }
  }
  if (vdso) {
    s = s.write("    .section .bss\n    .align 8\n__fern_vdso: .quad 0, 0\n    .text\n");
    s = emit_runtime("__fern_vdso_clock __fern_vdso_find", s);
  }
  return s;
}

function emit_logcat_runtime(s: asmcore.EmitState): asmcore.EmitState {
  if (asmcore.is_android(s.build_target)) {
    return emit_runtime("__fern_logcat", s);
  }
  return s;
}

function emit_entry_core_runtime(s: asmcore.EmitState): asmcore.EmitState {
  if (s.profile > 0) {
    s = emit_profile_runtime(s);
  }
  if (s.has_need("str_cmp")) {
    s = s.write("    .text\n");
    s = emit_runtime("__fern_str_cmp", s);
  }
  if (needs_heap_runtime(s)) {
    s = emit_ir_runtime(s);
  }
  if (s.has_need("crc32_cksum")) {
    s = emit_rt_crc32_cksum(s);
  }
  if (s.has_need("crc32_ieee")) {
    s = emit_rt_crc32_ieee(s);
  }
  if (s.has_need("aes_gcm")) {
    s = emit_rt_aes_gcm(s);
  }
  s = emit_rt_byte_kernels(s);
  if (s.has_need("sum_bytes")) {
    s = emit_rt_sum_bytes(s);
  }
  if (s.has_need("utf8_blocks")) {
    s = emit_rt_utf8_blocks(s);
  }
  return s;
}

function emit_entry_environment(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.shared && asmcore.process_entry(s)) {
    s = emit_stack_overflow_runtime(s);
    s = emit_startup_failures(s);
  }
  if (!asmcore.process_entry(s)) {
    s = emit_heap_init(s);
  }
  s = asmcore.emit_build_manifest(s);
  s = emit_report(s);
  s = emit_logcat_runtime(s);
  if (s.shared) {
    s = emit_busy_lock_x86(s);
    s = emit_harden_start(s);
    s = emit_shared_init_x86(s);
    if (s.has_need("shared_environ")) {
      s = s.write("    .section .data\n    .align 8\n__fern_environ_slot:\n    .quad 0\n    .text\n");
    }
  }
  if (s.rc_free_debug) {
    s = s.write("    .text\n");
    s = emit_san_uaf_abort(s);
    s = emit_san_waf_abort(s);
    s = emit_san_hbo_abort(s);
  }
  if (asmcore.vdso_wanted(s, "x86-64-linux")) {
    s = s.need("ccall:__c_call2");
  }
  if (any_ccall_need(s)) {
    s = s.write("    .text\n");
    s = emit_ccall_shims(s);
  }
  return s;
}

// Release the process-owned close table before the final heap report.
function emit_task_close_drop(s: asmcore.EmitState): asmcore.EmitState {
  if (!asmcore.process_entry(s) || !s.has_need("task") && !s.has_need("task_close_exit")) {
    return s;
  }
  s = s.write("    .text\n    .globl __fern_task_close_drop\n__fern_task_close_drop:\n");
  if (!s.has_need("task")) {
    return s.write("    ret\n");
  }
  s = s.write("    movq __fern_task_state+56(%rip), %rdi\n    testq %rdi, %rdi\n    jz .Ltask_close_drop_done\n    movq $0, __fern_task_state+56(%rip)\n    movq (%rdi), %rsi\n    addq $1, %rsi\n    shlq $3, %rsi\n");
  if (s.leak_check) {
    s = lc_rt_req_free(s);
  }
  s = s.write("    call __fern_raw_free\n");
  if (s.leak_check) {
    s = lc_rt_uncount(s, "__fern_lc_free_bytes", "__fern_lc_free_count");
  }
  return s.write(".Ltask_close_drop_done:\n    ret\n");
}

