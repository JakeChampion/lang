  s = s.write(".Larr_push_u8_dbl:\n    shlq $1, %rcx\n");
  s = s.write(".Larr_push_u8_cap:\n    leaq 8(%r14), %rax\n    shrq $3, %rax\n    cmpq %rax, %rcx\n    cmovbq %rax, %rcx\n    movq %rcx, %rdi\n    call __fern_arr_box\n");
