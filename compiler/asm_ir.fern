  s = s.write("    pushq %rdi\n");  // save data (alloc consumes %rdi)
  s = s.write("    movq $24, %rdi\n");
  s = s.write("    call __fern_alloc\n");  // %rax = base
  s = s.write("    movq $1, (%rax)\n");  // rc = 1 @ base, fused = 0 @ base+4
  s = s.write("    popq %rdi\n");  // data
  s = s.write("    popq %rsi\n");  // len
  s = s.write("    movq %rdi, 8(%rax)\n");  // data @ base+8
  s = s.write("    movq %rsi, 16(%rax)\n");  // len  @ base+16
  s = s.write("    addq $8, %rax\n");  // box = base+8
  s = s.write("    ret\n");
