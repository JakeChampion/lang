  s = s.write("    .quad 0x3feadbe87f94905e\n    .quad 0x3fc66acd4272b000\n    .quad 0xbd15790900e4e1eb\n");
  s = s.write("    .quad 0x3feaaf1d2f87ebfd\n    .quad 0x3fc740f8f5403000\n    .quad 0x3d2e9326cdfceabe\n");
  s = s.write("    .quad 0x3fea82e65130e159\n    .quad 0x3fc815c0a1435000\n    .quad 0x3d2fab5a0dbfc630\n");
  s = s.write("    .quad 0x3fea574107688a4a\n    .quad 0x3fc8e928de887000\n    .quad 0xbd15faad3b0a34ad\n");
  s = s.write("    .quad 0x3fea2c2a87c51ca0\n    .quad 0x3fc9bb362e7e0000\n    .quad 0xbd21f2a8a1ce0ffc\n");
