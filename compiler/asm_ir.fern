  s = s.write("    movl $0x78302020, (%rsp)\n");
  s = s.write("    movb $10, 20(%rsp)\n");
  s = s.write("    movl $16, %ecx\n");
  s = s.write(".Lbt_hloop:\n");
  s = s.write("    movq %rsi, %rax\n");
  s = s.write("    andl $15, %eax\n");
  s = s.write("    cmpb $10, %al\n");
  s = s.write("    jb .Lbt_hdec\n");
  s = s.write("    addb $87, %al\n");
  s = s.write("    jmp .Lbt_hput\n");
  s = s.write(".Lbt_hdec:\n");
  s = s.write("    addb $48, %al\n");
  s = s.write(".Lbt_hput:\n");
  s = s.write("    movb %al, 3(%rsp,%rcx)\n");
  s = s.write("    shrq $4, %rsi\n");
  s = s.write("    decl %ecx\n");
  s = s.write("    jnz .Lbt_hloop\n");
  s = s.write("    movq $1, %rax\n");
  s = s.write("    movq %rsp, %rsi\n");
  s = s.write("    movq $21, %rdx\n");
