  s = s.write("    movq %rdx, %r8\n    shrq $63, %r8\n");  // sign of x
  s = s.write("    movq %rdx, %rcx\n    shrq $52, %rcx\n    andq $0x7ff, %rcx\n");
  s = s.write("    movabsq $0x000fffffffffffff, %rax\n    andq %rax, %rdx\n");
  s = s.write("    movabsq $0x0010000000000000, %rax\n    orq %rax, %rdx\n");  // m, the 53-bit significand
  // x = m*2^(e-1075), and the fraction of x*(2/pi) starts at bit
  // (e-1075)+62 of the table once the product is read as a Q126.
  s = s.write("    subq $1013, %rcx\n");
  s = s.write("    movq %rcx, %r9\n    andq $63, %r9\n");  // bit offset within the limb
  s = s.write("    shrq $6, %rcx\n");  // limb index
  s = s.write("    leaq .Lfc_2opi_bits(%rip), %r10\n");
  s = s.write("    leaq (%r10,%rcx,8), %r10\n");
  s = s.write("    movq (%r10), %rsi\n    movq 8(%r10), %rdi\n");
  s = s.write("    movq 16(%r10), %r11\n    movq 24(%r10), %rax\n");
  s = s.write("    movq %r9, %rcx\n");
  s = s.write("    shldq %cl, %rdi, %rsi\n");  // w0
  s = s.write("    shldq %cl, %r11, %rdi\n");  // w1
  s = s.write("    shldq %cl, %rax, %r11\n");  // w2
  s = s.write("    movq %rdx, %r9\n");
  s = s.write("    movq %r9, %rax\n    mulq %rsi\n    movq %rax, %rsi\n");  // low(m*w0)
  s = s.write("    movq %r9, %rax\n    mulq %rdi\n    movq %rax, %rdi\n    movq %rdx, %r10\n");  // low/high(m*w1)
  s = s.write("    movq %r9, %rax\n    mulq %r11\n");  // high(m*w2) in %rdx
  s = s.write("    addq %rdx, %rdi\n");  // fraction, low 64
  s = s.write("    adcq %r10, %rsi\n");  // fraction, high 64
  s = s.write("    movq %rsi, %rax\n    shrq $62, %rax\n");  // k
  s = s.write("    movabsq $0x3fffffffffffffff, %rcx\n    andq %rcx, %rsi\n");
  s = s.write("    xorpd %xmm3, %xmm3\n");
  // A fraction past 1/2 belongs to the next quadrant, as 1 minus itself.
  s = s.write("    movabsq $0x2000000000000000, %r10\n");
  s = s.write("    cmpq %r10, %rsi\n    jb .Lfph_pos\n");
  s = s.write("    incq %rax\n");
  s = s.write("    movq %rsi, %r11\n    movq %rdi, %rcx\n");
  s = s.write("    xorq %rdi, %rdi\n    subq %rcx, %rdi\n");
  // movabsq, not mov+shl: a shift writes CF, and the borrow from the sub
  // above has to survive to the sbbq below.
  s = s.write("    movabsq $0x4000000000000000, %rsi\n");
  s = s.write("    sbbq %r11, %rsi\n");
  s = s.write("    movabsq $0x8000000000000000, %rcx\n    movq %rcx, %xmm3\n");
  s = s.write(".Lfph_pos:\n");
