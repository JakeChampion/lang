  s = s.write("    .quad 0x3fe84f00c2780614\n    .quad 0x3fd1980d2dd42000\n    .quad 0x3d2b7b3a7a361c9a\n");
  s = s.write("    .quad 0x3fe82a4a0182a4a0\n    .quad 0x3fd1f8ff9e48a000\n    .quad 0x3d27946c040cbe77\n");
  s = s.write("    .quad 0x3fe8060180601806\n    .quad 0x3fd2596010df7800\n    .quad 0xbd1c610f76c57076\n");
