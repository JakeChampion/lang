  s = s.write("    pclmulqdq $1, %xmm2, %xmm3\n");
  s = s.write("    pxor %xmm3, %xmm0\n");
  s = s.write("    pxor %xmm6, %xmm0\n");
  s = s.write("    movdqa %xmm0, %xmm3\n");
  s = s.write("    pclmulqdq $16, %xmm2, %xmm0\n");
  s = s.write("    pclmulqdq $1, %xmm2, %xmm3\n");
  s = s.write("    pxor %xmm3, %xmm0\n");
  s = s.write("    pxor %xmm7, %xmm0\n");
  s = s.write("    movdqa %xmm0, %xmm3\n");
  s = s.write("    pclmulqdq $16, %xmm2, %xmm0\n");
  s = s.write("    pclmulqdq $1, %xmm2, %xmm3\n");
  s = s.write("    pxor %xmm3, %xmm0\n");
  s = s.write("    pxor %xmm8, %xmm0\n");
  s = s.write(".Lcrc32_fold1:\n");
  s = s.write("    cmpl $16, %edx\n");
  s = s.write("    jb .Lcrc32_reduce\n");
