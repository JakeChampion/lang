  // frame, so they trap through the `.c` entries, which make one from their
  // return address.
  if (s.has_need("alloc_u8") || s.has_need("alloc_bytes") || s.has_need("str_grow")) {
    s = s.need("__fern_alloc_size_abort.c");
  }
  if (s.has_need("str_grow") || s.has_need("buf")) {
    s = s.need("__fern_slice_abort.c");
  }
  s = emit_trap_stubs(s);
  // __fern_arr_box(%rdi = cap element count) -> %rax = data ptr (base+16).
  // base = [cap, rc=1, len=cap, e0..]; element i at data+(i+1)*8.
  s = s.write("__fern_arr_box:\n");
  s = hev_shim_site(s, "arrbox");
