    s = s.need("fd_drop_cache");
  } else if (o.kind_tag == 298) {  // sync
    // No operands. sync(2) cannot fail, but its return is pushed for
    // the statement-position drop, as sleep_ns's is.
    s = s.write("    call __fn___fern_sync\n    pushq %rax\n");
    s = s.need("sync");
  } else if (o.kind_tag == 241) {  // fd_stat
    // [fd] IS param[0]; the Fern-compiled __fn___fern_fd_stat pushes a
    // fresh Result[FileStat, IoError], the FileStat shape pre-interned
    // with stat's.
    s = s.write("    call __fn___fern_fd_stat\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("fd_stat");
  } else if (o.kind_tag == 311) {  // fd_dup_onto
    // [fd][newfd]; the Fern __fn___fern_fd_dup_onto(fd, newfd) pushes
    // a fresh Option[IoError]. newfd is on top but param[0] is fd, so
    // swap before the call, as writer_truncate does.
    s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
    s = s.write("    call __fn___fern_fd_dup_onto\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("fd_dup_onto");
  } else if (o.kind_tag == 307) {  // fd_flags
    // [fd] IS param[0], like fd_stat; the Fern-compiled
    // __fn___fern_fd_flags pushes a fresh Result[i64, IoError].
    s = s.write("    call __fn___fern_fd_flags\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("fd_flags");
  } else if (o.kind_tag == 242) {  // reader_seek
    // [fd][offset][whence] (whence on top) -> Result[i64, IoError]. The
    // operands are in param order but on the wrong end: pop all three
    // and re-push with param[0] (fd) on top, as subprocess does.
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_reader_seek\n    addq $24, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("reader_seek");
  } else if (o.kind_tag == 330) {  // reader_splice
    // [fd][out_fd][max] (max on top) -> Result[i64, IoError], re-pushed
    // with param[0] (fd) on top as reader_seek is.
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_reader_splice\n    addq $24, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("reader_splice");
  } else if (o.kind_tag == 407) {  // reader_copy_range
    // [fd][out_fd][max] -> Result[i64, IoError], called as reader_splice is.
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_reader_copy_range\n    addq $24, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("reader_copy_range");
  } else if (o.kind_tag == 281) {  // writer_truncate
    // [fd][length]; the Fern __fn___fern_writer_truncate(fd, length)
    // pushes a fresh Option[IoError]. The length is on top but param[0]
    // is fd, so swap before the call, as writer_write does.
    s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
    s = s.write("    call __fn___fern_writer_truncate\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("writer_truncate");
  } else if (o.kind_tag >= 291 && o.kind_tag <= 297 || o.kind_tag == 306 || o.kind_tag == 325 || o.kind_tag == 326 || o.kind_tag == 328 || o.kind_tag == 347 || o.kind_tag == 351 || o.kind_tag == 370 || o.kind_tag == 371 || o.kind_tag == 372 || o.kind_tag == 386) {  // the buf_* builder
    s = emit_ir_op_buf(o, s);
  } else if (o.kind_tag == 181) {  // sleep_ms
    // [ms] -> nanosleep(ms). Push the syscall return so the
    // statement-level drop balances (sleep_ms is void).
    s = s.write("    call __fn___fern_sleep_ms\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("sleep_ms");
  } else if (o.kind_tag == 266) {  // sleep_ns
    // [ns] -> nanosleep(ns) at full resolution. Same stack ABI as
    // sleep_ms — one word in, the syscall return pushed for the drop.
    s = s.write("    call __fn___fern_sleep_ns\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("sleep_ns");
  } else if (o.kind_tag == 146) {  // dyn_box
    s = emit_ir_op_dyn_box(o, s);
  } else {
    ircore.flat_arm_missing(o);
  }
  return s;
}

// emit_ir_op_buf emits the capacity-carrying string builder's seven ops
// (#8773). All of them take the register ABI the __fern_buf_* bundle is written
// in, so the operands pop straight into the argument registers with none of the
// re-push a stack-ABI __fn___fern_* helper needs. Each arm pushes %rax: the
// handle, the length or the string box for the value ops, and the helper's
// return as the dummy a statement-level drop takes for the rest.
function emit_ir_op_buf(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  if (o.kind_tag == 296) {
    s = s.need("buf_text");
  }
  if (o.kind_tag == 347) {
    s = s.need("buf_take_bytes" + asmcore.packed_suffix(ir.is_packed(o)));
  }
  if (o.kind_tag == 351) {
    s = s.need("buf_push_bytes_range" + asmcore.packed_suffix(ir.is_packed(o)));
  }
  let k: i32 = asmcore.buf_arity(o.kind_tag);
  while (k > 0) {
    k = k - 1;
    s = s.write("    popq " + ssa_arg_regs()[k] + "\n");
  }
  let sym: string = asmcore.buf_table_helper(o.kind_tag, ir.is_packed(o));
  s = s.write("    call " + sym + "\n    pushq %rax\n");
  s = s.need("heap");
  if (o.kind_tag >= 370 && o.kind_tag <= 372) {
    if (sym != asmcore.buf_helper(o.kind_tag)) {
      s = s.need("buf_bytes_u8");
    } else {
      s = s.need("buf_bytes");
    }
  } else if (o.kind_tag != 347 && o.kind_tag != 351 && sym != asmcore.buf_helper(o.kind_tag)) {
    s = s.need("buf_u8");
  }
  return s.need("buf");
}

// const_text_u32 reports whether an integer literal's SOURCE TEXT spells a
// value in [0, 2^32) that `movl $TEXT, %eax` loads exactly as `movq` (or
// `movabsq`) would: a plain decimal of at most ten digits within the range,
// or `0x` and at most eight hex digits. Anything else — a leading `-`, a
// binary literal, a wider value — keeps the 64-bit form, whose sign
// extension or full width the narrow write could not reproduce.
function const_text_u32(t: string): boolean {
  if (t.len() > 2 && t[0] == 48 && (t[1] == 120 || t[1] == 88)) {
    return t.len() <= 10 && hex_digits(t, 2);
  }
  if (!util.is_all_digits(t) || t.len() > 10) {
    return false;
  }
  return util.digits_to_i64(t) <= 4294967295i64;
}

// hex_digits reports whether t[from:] is one or more hex digits.
function hex_digits(t: string, from: i32): boolean {
  if (from >= t.len()) {
    return false;
  }
  let i: i32 = from;
  while (i < t.len()) {
    let c: i32 = t[i] as i32;
    let ok: boolean = c >= 48 && c <= 57 || c >= 97 && c <= 102 || c >= 65 && c <= 70;
    if (!ok) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function emit_ir_op_heap_bump_bytes(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  // bump high-water mark = (__fern_heap_ptr == 0) ? 0 : ptr − base.
  // The arena is mmap'd lazily; its base is recoverable from the
  // recorded end (__fern_heap_end = base + heap_size), so base =
  // end − heap_size. The cursor is 0 until the first alloc, so guard
  // that case to report 0 (matching native's __fern_heap_bump_bytes).
  s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");  // cursor (0 if uninit)
  s = s.write("    movq __fern_heap_end(%rip), %rcx\n");  // arena end = base + heap_size (0 if uninit)
  s = s.write("    movabs $17179869184, %rdx\n");  // heap_size (0x400000000, 16 GiB)
  s = s.write("    subq %rdx, %rcx\n");  // %rcx = base = end − heap_size
  s = s.write("    movq %rax, %rdx\n");
  s = s.write("    subq %rcx, %rdx\n");  // ptr − base
  s = s.write("    xorq %rcx, %rcx\n");
  s = s.write("    testq %rax, %rax\n");  // ptr == 0 ?
  s = s.write("    cmovneq %rdx, %rcx\n");  // 0 if uninit, else ptr−base
  s = s.write("    pushq %rcx\n");
  s = s.need("heap");

  return s;
}

// emit_ir_op_heap_alloc_count reads the allocator's call count (#9596),
// ticked at __fern_alloc's entry so the freelist-pop path is counted exactly
// like the bump path. An inline read of the word for heap_bump_bytes's reason:
// a call would only add an ABI. `alloc_count` is the need that puts the
// counter — and the tick — into the runtime, so a program that never asks
// for the number emits neither.
function emit_ir_op_heap_alloc_count(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movq __fern_alloc_count(%rip), %rax\n");
  s = s.write("    pushq %rax\n");
  s = s.need("heap");
  s = s.need("alloc_count");

  return s;
}

function emit_ir_op_heap_mark(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  // The arena checkpoint: the cursor, plus a snapshot of BOTH freelist
  // head tables into their .bss shadows. The heads are snapshotted
  // rather than cleared because a block allocated AND freed inside the
  // window leaves a head pointing above the mark — after the rewind, a
  // pop and a bump would both hand out that address. Restoring the
  // pre-mark heads drops exactly those entries and keeps the older ones
  // reusable. One live mark at a time: the shadow is a single buffer,
  // so marks do not nest. rep movsq clobbers rcx/rsi/rdi, and the
  // operand stack around an inline op may hold live values in them, so
  // save and restore rather than lean on a caller-saved rule this
  // backend does not otherwise rely on.
  s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
  s = s.write("    pushq %rcx\n    pushq %rsi\n    pushq %rdi\n");
  s = s.write("    leaq __fern_freelist(%rip), %rsi\n");
  s = s.write("    leaq __fern_freelist_shadow(%rip), %rdi\n");
  s = s.write("    movl $65536, %ecx\n    rep movsq\n");
  s = s.write("    leaq __fern_large_freelist(%rip), %rsi\n");
  s = s.write("    leaq __fern_large_freelist_shadow(%rip), %rdi\n");
  s = s.write("    movl $2560, %ecx\n    rep movsq\n");
  s = s.write("    popq %rdi\n    popq %rsi\n    popq %rcx\n");
  s = s.write("    pushq %rax\n");
  s = s.need("heap");

  return s;
}

function emit_ir_op_heap_release_to(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  // Rewind to the mark and restore both head tables. mark == 0 means
  // "taken before the first allocation seeded the cursor", i.e. no
  // checkpoint — leave the cursor alone rather than zero it and hand
  // out the arena base. Releasing is sound only when nothing allocated
  // after the mark is still reachable; the caller owns that invariant,
  // exactly as it owns malloc/free pairing.
  let hrlo: asmcore.LabelOut = asmcore.fresh_label(s);
  let hrl_done: string = hrlo.name;
  s = hrlo.state;
  s = s.write("    popq %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jz " + hrl_done + "\n");
  s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
  s = s.write("    pushq %rcx\n    pushq %rsi\n    pushq %rdi\n");
  s = s.write("    leaq __fern_freelist_shadow(%rip), %rsi\n");
  s = s.write("    leaq __fern_freelist(%rip), %rdi\n");
  s = s.write("    movl $65536, %ecx\n    rep movsq\n");
  s = s.write("    leaq __fern_large_freelist_shadow(%rip), %rsi\n");
  s = s.write("    leaq __fern_large_freelist(%rip), %rdi\n");
  s = s.write("    movl $2560, %ecx\n    rep movsq\n");
  s = s.write("    popq %rdi\n    popq %rsi\n    popq %rcx\n");
  s = s.write(hrl_done + ":\n");
  // Push the mark back — the one-value-per-expression invariant the
  // whole op stream keeps (raw_store8 does the same); statement
  // position drops it. Without this the statement's drop pops a value
  // nothing pushed, and the next allocation runs on a corrupt frame.
  // %rax survives both paths: rep movsq clobbers only rcx/rsi/rdi.
  s = s.write("    pushq %rax\n");
  s = s.need("heap");

  return s;
}

// helper_call_needs marks the runtime bodies a call to the helper `name`
// requires, for both emits of a call_direct: the stack machine's and the
// SSA backend's. A call_direct does not imply a need, so without these a
// call site is emitted against a body the runtime never writes.
function helper_call_needs(name: string, s: asmcore.EmitState): asmcore.EmitState {
  if (name == "__fern_oob_abort" || name == "__fern_slice_abort") {
    s = s.need("heap");
  }
  if (name == "__fern_i32_to_string") {
    s = s.need("heap");
    s = s.need("i32_to_string");
  }
  // __fern_u32_to_string likewise allocates its result box (#2649).
  if (name == "__fern_u32_to_string") {
    s = s.need("heap");
    s = s.need("u32_to_string");
  }
  // The WIDE siblings (#5826) — same shape: each allocates its result
  // box, so each needs the heap runtime plus its own body.
  if (name == "__fern_i64_to_string") {
    s = s.need("heap");
    s = s.need("i64_to_string");
  }
  if (name == "__fern_u64_to_string") {
    s = s.need("heap");
    s = s.need("u64_to_string");
  }
  // arr.join(sep) needs its own body + the heap runtime it fills its
  // exact-size block from (mark_arr_str_join sets both). #5328.
  if (name == "__fern_arr_str_join") {
    s = s.mark_arr_str_join();
  }
  // arr-of-arr reclaim helpers (#4355 slice 9): bodies gated on these
  // needs in emit_ir_runtime — a binary with no arr-of-arr reclaim
  // must not carry them, since the strarrarr body's inner
  // `call __fn___fern_str_arr_free` text would trip the negative
  // asm-grep contracts (e.g. strarr-elem-alias-excluded). Both free
  // through the freelist, so they need the heap runtime.
  if (name == "__fern_arrarr_free") {
    s = s.need("heap");
    s = s.need("arrarr_free");
  }
  if (name == "__fern_arr_inc_elems") {
    s = s.need("arr_inc_elems");
  }
  if (name == "__fern_arr_own_elems") {
    s = s.need("arr_own_elems");
  }
  if (name == "__fern_str_own") {
    s = s.need("str_own");
  }
  if (name == "__fern_str_borrow") {
    s = s.need("str_borrow");
  }
  if (name == "__fern_str_grow" || name == "__fern_str_grow_range") {
    s = s.need("str_grow");
  }
  if (name == "__fern_account_entry") {
    s = s.need("account");
  }
  if (name == "__fern_set_args") {
    s = s.need("set_args");
  }
  // The VIEW-aware string[] element walk (#6544) is gated the same way
  // and for the same reason: its body's inner
  // `call __fn___fern_str_view_free` must not appear in a binary that
  // never reclaims a builtin string[]. Frees through the freelist, so
  // it needs the heap runtime.
  if (name == "__fern_strarrarr_free") {
    s = s.need("heap");
    s = s.need("strarrarr_free");
  }
  if (name == "__fern_optarrarr_free") {
    s = s.need("heap");
    s = s.need("optarrarr_free");
  }
  return s;
}

// dyn_arg_operand is the operand a `dyn Trait` call's argument is read
// from: its register, or its frame slot relative to %rbp.
function dyn_arg_operand(a: asmcore.DynArg): string {
  if (a.reg.len() > 0) {
    return a.reg;
  }
  return util.i32_to_string(a.off) + "(%rbp)";
}

// emit_dyn_dispatch_chain is a `dyn Trait` method call: it reads the
// receiver's shape pointer and dispatches to the matching `<Type>.<method>`
// through a compare-branch chain over the `arms` the op_dyn_dispatch tag
// carries. Each matched arm pushes the arguments (arg0/receiver on top, asm.fern's ABI) from
// where `args` says they are, calls, and leaves the result in %rax. %rcx
// and %rdx are scratch.
function emit_dyn_dispatch_chain(arms: string, args: asmcore.DynArg[], i: i32, lp: string, own s: asmcore.EmitState): asmcore.EmitState {
  let dargc: i32 = args.len();
  s = s.write("    movq " + dyn_arg_operand(args[0]) + ", %rax\n");
  s = s.write("    movq (%rax), %rcx\n");
  let dend: string = lp + "dynend" + util.i32_to_string(i);
  let dfi: i32 = 0;
  let darmn: i32 = 0;
  while (dfi < s.funcs.len()) {
    let dfd: parser.FuncDecl = s.funcs[dfi];
    let ddbn: string = util.base_type_name(dfd.receiver_type);
    // Dispatch arms: every arm whose receiver is a struct (value carries its shape) OR a primitive/string (value
    // is heap-boxed at coercion — docs/DYN-TRAITS.md §4.2.3). A
    // primitive arm UNBOXES: the receiver holds the box pointer, so
    // arg0 is reloaded from box+8, not pushed directly.
    let dprim: boolean = dfd.receiver_type.len() > 0 && asmcore.is_prim_recv_name(ddbn, s);
    if (irtables.dyn_arm_matches(dfd, arms) && dfd.receiver_type.len() > 0
      && (asmcore.is_struct_decl_name(ddbn, s) || dprim)) {
      let dbn: string = ddbn;
      let dlit: asmcore.ShapeRefOut = asmcore.shape_ref(s, dbn);
      s = dlit.state;
      let dnext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      s = ssa_lea_sym(s, dlit.label, "%rdx");
      s = s.write("    cmpq %rdx, %rcx\n");
      s = s.write("    jne " + dnext + "\n");
      let dk: i32 = dargc - 1;
      while (dk >= 0) {
        if (dk == 0 && dprim) {
          // arg0 is the receiver: unbox the value from box+8.
          s = s.write("    movq " + dyn_arg_operand(args[0]) + ", %rax\n");
          s = s.write("    pushq 8(%rax)\n");
        } else {
          s = s.write("    pushq " + dyn_arg_operand(args[dk]) + "\n");
        }
        dk = dk - 1;
      }
      s = s.write("    call __fn_" + asmcore.sanitize_label(dbn + "." + dfd.name) + "\n");
      s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
      s = s.write("    jmp " + dend + "\n");
      s = s.write(dnext + ":\n");
      darmn = darmn + 1;
    }
    // ENUM-receiver arm (`impl Trait for <Enum>`, #4785): an enum
    // value's offset-0 shape is its VARIANT's interned shape
    // (struct_make with the variant name — the same identity
    // op_variant_is reads), never the enum name itself, so the
    // struct-arm compare above can never identify it. Match the
    // receiver against EVERY variant of the enum; on any hit call
    // `<Enum>.<method>` with the variant box as the receiver (its
    // body's `match (self)` re-reads the variant). Keyed
    // per-variant — not a blanket last-arm fallback like the AST
    // backend's — so two enums implementing the same trait
    // dispatch to their own impls. recv_is_array excludes an
    // array method's `T[]` receiver (base_type_name strips the
    // `[]`, which would otherwise mis-read as an enum — #2766).
    if (irtables.dyn_arm_matches(dfd, arms) && dfd.receiver_type.len() > 0
      && !asmcore.recv_is_array(dfd.receiver_type)
      && irtables.decl_is_enum(s.struct_decls, ddbn)) {
      let dehit: string = lp + "dynehit" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      let denext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      let dvi: i32 = 0;
      while (dvi < s.struct_decls.decls.len()) {
        if (s.struct_decls.decls[dvi].enum_owner == ddbn) {
          let vlit_name: string = s.struct_decls.decls[dvi].name;
          let vlit: asmcore.ShapeRefOut = asmcore.shape_ref(s, vlit_name);
          s = vlit.state;
          s = ssa_lea_sym(s, vlit.label, "%rdx");
          s = s.write("    cmpq %rdx, %rcx\n");
          s = s.write("    je " + dehit + "\n");
        }
        dvi = dvi + 1;
      }
      s = s.write("    jmp " + denext + "\n");
      s = s.write(dehit + ":\n");
      let dek: i32 = dargc - 1;
      while (dek >= 0) {
        s = s.write("    pushq " + dyn_arg_operand(args[dek]) + "\n");
        dek = dek - 1;
      }
      s = s.write("    call __fn_" + asmcore.sanitize_label(ddbn + "." + dfd.name) + "\n");
      s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
      s = s.write("    jmp " + dend + "\n");
      s = s.write(denext + ":\n");
      darmn = darmn + 1;
    }
    dfi = dfi + 1;
  }
  // No arm matched. Unreachable for a well-typed dyn value, so abort
  // (exit 134, like __fern_oob_abort) rather than answer 0.
  s = s.write("    movq $60, %rax\n    movq $134, %rdi\n").syscall(60);
  s = s.write(dend + ":\n");
  return s;
}

function emit_ir_op_dyn_box(o: ir.Op, own s: asmcore.EmitState): asmcore.EmitState {
  // Heap-box a primitive/string value coerced into a `dyn Trait` slot
  // (docs/DYN-TRAITS.md §4.2.3). Cell = [shape@0, value@8], 2 words;
  // shape = the interned primitive type name (the SAME .S label struct
  // shapes use), so op_dyn_dispatch's offset-0 compare matches. The
  // cell is rc-HEADERED via __fern_arr_box(cap=2) — exactly like
  // opt_make — so a fresh, non-escaping prim/string dyn local can be
  // freed by the exit sweep's __fern_rc_dec (#4351; the former raw
  // __fern_alloc cell had no header, so it could never be reclaimed).
  // Offsets unchanged (arr_box's len@0 is overwritten by the shape;
  // cap@data-16 drives the free size). The value (one word — an
  // i32/i64/f64 scalar OR a string box pointer) is on the operand
  // stack; alloc first (it survives on the machine stack, like
  // opt_make), then store shape + value, push the cell pointer.
  let dbl: asmcore.ShapeRefOut = asmcore.shape_ref(s, o.str);
  s = dbl.state;
  s = s.write("    movq $2, %rdi\n    call __fern_arr_box\n");
  s = ssa_lea_sym(s, dbl.label, "%rcx");
  s = s.write("    movq %rcx, (%rax)\n");
  s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");

  return s;
}

// ir_i2f_rax converts the integer in %rax to an f64 pattern in %rax, selected
// by width and signedness. x86 has only the SIGNED cvtsi2sd, so a u32 is
// zero-extended into the 64-bit source first (its value fits i64, so the
// signed convert is then exact), and a u64 with bit 63 set, which a bare
// cvtsi2sd reads as negative (#6051), goes through the round-to-odd halving
// `y = (x >> 1) | (x & 1)`, converts that, and doubles; native's
// emitFConvertI64 sequence. `lb` is a per-op-unique label base.
function ir_i2f_rax(width: i32, unsigned: boolean, lb: string, d: string): string {
  if (width == 64 && unsigned) {
    let u: string = "    testq " + d + ", " + d + "\n    js " + lb + "_big\n";
    u = u + "    cvtsi2sd " + d + ", %xmm0\n    jmp " + lb + "_done\n";
    u = u + lb + "_big:\n";
    u = u + "    movq " + d + ", %rcx\n    shrq $1, %rcx\n    andl $1, " + ssa_r32(d) + "\n    orq " + d + ", %rcx\n";
    u = u + "    cvtsi2sd %rcx, %xmm0\n    addsd %xmm0, %xmm0\n";
    u = u + lb + "_done:\n    movq %xmm0, " + d + "\n";
    return u;
  }
  if (unsigned) {
    return "    movl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n    cvtsi2sd " + d + ", %xmm0\n    movq %xmm0, " + d + "\n";
  }
  return "    cvtsi2sd " + d + ", %xmm0\n    movq %xmm0, " + d + "\n";
}

// emit_ir_runtime_fern_fn lowers a runtime helper WRITTEN IN FERN through the
// IR pipeline (issue #2649). The helper emits as __fn_<name> exactly like a user
// function (so the IR call site's `call __fn___fern_<name>` resolves to it),
// replacing a hand-written stack-arg wrapper in emit_ir_runtime.
//
// The typed lowering (EmitState.rt_lower) produces the bodies. Emitted
// entry-only and gated on the helper's need by the caller; emit_runtime_globls
// already `.globl`s the symbol so the per-module link resolves it.
function emit_ir_runtime_fern_fn(src: string, s: asmcore.EmitState): asmcore.EmitState {
  let m: parser.Module = parser.infer_ret_types_module(parser.parse_module(lexer.tokenize(src)));
  let fns: parser.FuncDecl[] = m.funcs;
  // String literals the helper body interns (e.g. "\n" in str_lines's
  // s.split("\n")) land in string_lits AFTER the main .rodata pool was emitted
  // (this runs in the entry block, past the pool), so flush any NEW ones here in
  // their own .rodata block then return to .text. A literal-free helper (the
  // str_eq / str_cmp / str_trim bodies) adds none, so
  // this is a no-op for them.
  let vgate: irverifygate.Gate = irverifygate.gate_unreported(irtables.fn_sig_index(fns), s.kinds.pops);
  let lit0: i32 = s.string_lits.len();
  let agg0: i32 = s.const_aggs.len();
  let sh0: i32 = s.shape_lits.len();
  let lowered: physicalbody.Lowered = s.rt_lower(src);
  let bodies: irtables.LowerResult[] = lowered.bodies;
  let physical = physicalbody.collection(lowered);
  let i: i32 = 0;
  while (i < fns.len()) {
    s = emit_function_via_ir_pre(bodies[i], physicalbody.select(physical, i), fns[i], s, vgate);
    i = i + 1;
  }
  // Past the declarations: the drop helpers the typed lowering defines.
  s = emit_named_bodies(bodies, physical, fns.len(), s, vgate);
  if (s.shape_lits.len() > sh0) {
    s = asmcore.emit_shape_lits_from(s, sh0);
    s = s.write("    .text\n");
  }
  if (s.string_lits.len() > lit0) {
    s = s.write("    .section .rodata\n");
    let li: i32 = lit0;
    while (li < s.string_lits.len()) {
      s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
      li = li + 1;
    }
    s = asmcore.emit_str_box_data_from(s, lit0);
    s = s.write("    .text\n");
  }
  // The same applies to a static aggregate constant the helper body interns: the
  // main .data pool was written before this runs, so flush the new blocks here
  // and return to .text. No helper currently builds one, so this is a no-op
  // today — present so a future Fern-written helper that does is not silently
  // left with a dangling .K label.
  if (s.const_aggs.len() > agg0) {
    s = asmcore.emit_const_agg_data_from(s, agg0);
    s = s.write("    .text\n");
  }
  return s;
}

// emit_module_funcs emits mod's function bodies in the index window [lo, hi).
// A full window (lo=0, hi=mod.funcs.len(), or hi<0 as a "to the end" sentinel)
// reproduces the whole-module emit byte-for-byte; a partial window emits only
// that slice's `__fn_*` defs (its own string pool, its weak field-reclaims /
// struct-drops), so an oversized module (511 funcs — #3425) can be
// sharded across separate process invocations to keep each emit's peak heap
// under the leak-mode ceiling. The side-table bases (b_*) are ALWAYS computed
// over the WHOLE all_funcs (never windowed) so cross-window call tagging is
// identical to the unsharded emit; only the emit loop is windowed.
// `check_claims` is false for module_runtime_needs, which runs this whole loop
// only to read the need-set off the EmitState and discards the text. A probe
// must answer, so it does not get to refuse the module (#9655).
function emit_module_funcs(mod: parser.Module, all_funcs: parser.FuncDecl[], s: asmcore.EmitState, globl_defs: boolean, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, check_claims: boolean): asmcore.EmitState {
  // `cache` is the unit's lowered bodies, indexed by mod.funcs position.
  // The IR verify gate's callee-arity index, derived ONCE over the
  // whole-program all_funcs for the reason the registries above are: a
  // per-function rebuild would be O(n^2) on the compiler's own sources.
  let vgate: irverifygate.Gate = irverifygate.gate(irtables.fn_sig_index(all_funcs), s.kinds.pops);
  // hi<0 is the "to the end" sentinel; an over-large hi is clamped so a shard
  // window that overshoots the module length can't index past mod.funcs.
  let hh: i32 = hi;
  if (hh < 0 || hh > mod.funcs.len()) {
    hh = mod.funcs.len();
  }
  if (check_claims) {
    ircore.check_fip_claims(mod.funcs, lo, hh, cache);
  }
  s = asmcore.EmitState { ...s, reg_entries: irtables.sig_reg_of(asmcore.unit_labels(mod, lo, hh, cache)), leaves: asmcore.unit_leaves(mod, lo, hh, cache) };
  let fi: i32 = lo;
  while (fi < hh) {
    let r: irtables.LowerResult = ircore.produced(cache, fi, mod.funcs[fi]);
    // A template the substitution superseded has no body: its instances
    // are on the cache tail (emit_named_bodies).
    if (r.superseded) {
      fi = fi + 1;
      continue;
    }
    // Per-module: mark the definition `.globl` so a sibling module's
    // `call __fn_<label>` (an unresolved extern in that module) links
    // against it. The label is computed exactly as emit_function_via_ir_pre
    // writes it below (receiver-qualified for methods).
    if (globl_defs) {
      let gname: string = mod.funcs[fi].name;
      if (mod.funcs[fi].receiver_type.len() > 0) {
        gname = util.base_type_name(mod.funcs[fi].receiver_type) + "." + mod.funcs[fi].name;
      }
      s = s.write(".globl __fn_" + asmcore.sanitize_label(gname) + "\n");
    }
    s = emit_function_via_ir_pre(r, physicalbody.select(physical, fi), mod.funcs[fi], s, vgate);
    fi = fi + 1;
  }
  // Cache entries past the declarations are bodies with no FuncDecl, each
  // naming the symbol it defines. `.weak`, so a shard window or a sibling
  // unit that emits the same body co-links to one definition.
  s = emit_named_bodies(cache, physical, mod.funcs.len(), s, vgate);
  irverifygate.report(vgate);
  return s;
}

function emit_named_bodies(cache: irtables.LowerResult[], physical: physicalbody.Collection, from: i32, s: asmcore.EmitState, vgate: irverifygate.Gate): asmcore.EmitState {
  let xi: i32 = from;
  while (xi < cache.len()) {
    if (!s.has_named(cache[xi].name)) {
      s = emit_function_via_ir_named(cache[xi], physicalbody.select(physical, xi), cache[xi].name, true, s, vgate).with_named(cache[xi].name);
    }
    xi = xi + 1;
  }
  return s;
}

// module_runtime_needs returns the runtime helpers one unit of a lowered
// program requires (the closed need-set: "heap", "str_concat", …), for
// whole-program runtime aggregation in per-module emit (#3451 step 3 / #3455).
// The entry module emits the single shared runtime, but on its OWN it only
// knows its own needs — a library module that uses a helper the entry doesn't
// (e.g. str_concat) would reference an undefined symbol at link. It runs the
// unit's emit over `cache` (its lowered bodies, ircore.split_units) so the
// need-set is exact, but discards the asm (strbuf_reset) and reads `needed`.
pub function module_runtime_needs(mod: parser.Module, all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, cache: irtables.LowerResult[], physical: physicalbody.Collection): string[] {
  strbuf_reset();
  let s: asmcore.EmitState = asmcore.new_state();
  s = asmcore.with_funcs(asmcore.EmitState { ...s, struct_decls: all_structs, retain_prepared: false }, all_funcs);
  s = emit_module_funcs(mod, all_funcs, s, false, 0, 0 - 1, cache, physical, false);
  s = s.close_needs();
  strbuf_reset();
  return s.needed;
}

// emit_module_or_error_sub is the whole-program emit over the typed lowering
// `sub`: the parse-error / type-check / lambda-lift prologue, then the IR
// gate, and a module the gate declines is a hard ERROR. FERN_STRICT_IR=1
// makes the gate exit(3) naming the bail site.
//
// The prologue is ordered check-then-emit for the reason #4327 records: the
// fused gate+emit used to return ahead of the type check, so every IR-eligible
// module skipped it and an ill-typed one miscompiled silently.
pub function emit_module_or_error_sub(mod: parser.Module, sub: ircore.Sub, recs: usize): string {
  if (!sub.checked) {
    let parse_errs: util.Diag[] = asmcore.parse_unknown_errors_module(mod);
    if (parse_errs.len() > 0) {
      eprint(util.format_diags(parse_errs));
      exit(1);
      return "";
    }
  }
  // The checked boundary first: a raw driver's module reaches here without
  // the annotate pass, and asmcore's Display gate has to read the module the
  // checker rewrote (`print(q)` to `q.to_string()`, docs/TRAITS.md §3a) or
  // it refuses every non-string argument.
  let tm: parser.Module = checker.ensure_annotated(mod);
  if (!sub.checked) {
    let check_errs: util.Diag[] = asmcore.entry_check_errors(tm);
    if (check_errs.len() > 0) {
      eprint(util.format_diags(check_errs));
      exit(1);
      return "";
    }
  }
  let lm: parser.Module = ircore.sub_lifted(sub, tm);
  let g: string = emit_module_ir_gated_sub(lm, sub, recs);
  if (g != "") {
    return g;
  }
  ircore.eprint_ir_ineligible();
  exit(1);
  return "";
}

// emit_module_ir_gated_sub is the fused gate + whole-program emit (#4394
// lever 3) over a semantic lowering (ircore.Sub): the typed lowering, or
// ir_const_numeric_run's rebuilt copy of it. "" is an unambiguous
// "ineligible" sentinel: an eligible module always emits at least
// `.globl _start\n    .text\n…`, never the empty string.
pub function emit_module_ir_gated_sub(mod: parser.Module, sub: ircore.Sub, recs: usize): string {
  // A main-less module is admitted: the unit's `_start` exits 0 instead of
  // calling a __fn_main that does not exist (see its has_main branch).
  let g: ircore.Gated = ircore.gate_program(mod, sub);
  if (!g.ok) {
    return "";
  }
  // Every function eligible — emit from the cache (no second lowering).
  return emit_module_ir_unit_flat(g.im, true, false, "", [], g.im.funcs, g.stab, 0, 0 - 1, ircore.inline_tiny_leaves(g.im, g.cache), g.physical, sub.rt_lower, recs, sub.switches);
}

// `rt` lowers the runtime helpers this unit appends (asmcore.EmitState.rt_lower).
pub function emit_module_ir_unit_flat(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (string) => physicalbody.Lowered, recs: usize, sw: asmcore.Switches): string {
  return emit_module_ir_unit_prepared(mod, is_entry, globl_defs, str_ns, extra_needs, all_funcs, all_structs, lo, hi, cache, physical, rt, recs, sw, false).text;
}

// Retain the same bodies consumed by this emission, including its settled runtime.
pub function emit_module_ir_unit_prepared(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (string) => physicalbody.Lowered, recs: usize, sw: asmcore.Switches, retain: boolean): ssaprepare.Output {
  // Infer return types for unannotated functions so the IR path's
  // ret-type-keyed call tagging matches what module_with_builtins supplies.
  // (#4394 lever 3: `cache`, when non-empty, is the caller's pre-lowered
  // per-function LowerResult set — indexed by mod.funcs position — reused by
  // emit_module_funcs instead of re-lowering. The caller must have inferred
  // ret types before lowering; infer_ret_types_module is idempotent, so this
  // re-infer is a no-op there and the cache indices stay aligned.)
  strbuf_reset();
  let s: asmcore.EmitState = asmcore.new_state();
  s = asmcore.EmitState { ...s, retain_prepared: retain };
  // struct_decls and funcs are the WHOLE-PROGRAM sets, so an imported struct's
  // layout resolves and a `dyn` dispatch has an arm for every impl (#10891).
  s = asmcore.with_funcs(asmcore.with_switches(asmcore.EmitState { ...s, struct_decls: all_structs, str_ns: str_ns, rt_lower: rt, recs: recs }, sw), all_funcs);
  // A unit never passes emit_module_or_error_sub's check, so the Display gate
  // runs here: a `print(xs)` nothing gives a `to_string` would otherwise hand
  // the string-only runtime helper a raw pointer (#9945).
  let derrs: util.Diag[] = asmcore.display_errs_module(mod, s);
  if (derrs.len() > 0) {
    eprint(util.format_diags(derrs));
    exit(1);
    return ssaprepare.Output { text: "", bodies: [] };
  }
  // A unit cannot see the syscalls its sibling units issue, so only the
  // whole-program emit can derive the sandbox's allowlist.
  if (globl_defs && asmcore.sandbox_on()) {
    eprint("fern: FERN_SANDBOX=1 needs the whole-program emit; a per-module unit cannot see its siblings' syscalls");
    exit(1);
    return ssaprepare.Output { text: "", bodies: [] };
  }
  if (is_entry) {
    s = s.write("    .globl _start\n");
  }
  s = s.write("    .text\n");
  // Per-module: the entry exports its shared runtime entry points so sibling
  // library modules can link their `call __fern_*` externs against them.
  if (is_entry && globl_defs) {
    s = asmcore.emit_runtime_globls(s);
    // The frameless leaves' bounds traps, x86-64's alone.
    let n: i32 = 0;
    while (n <= ssa_nsaved()) {
      s = s.write(".globl " + oob_leaf_trap(n) + "\n");
      n = n + 1;
    }
  }
  // The side-table bases arrive as INDIVIDUAL params (b_*), threaded straight to
  // emit_module_funcs.
  s = emit_module_funcs(mod, all_funcs, s, globl_defs, lo, hi, cache, physical, true);
  // Fold the whole-program extra_needs (sibling modules' needs, for the entry's
  // single shared runtime) into the need set BEFORE _start, so _start's
  // need-gated argc/argv save below fires even when only a LIBRARY module
  // (not the entry itself) calls args(). For the single-unit path extra_needs
  // is empty, so this is inert there.
  let en: i32 = 0;
  while (en < extra_needs.len()) {
    s = s.need(extra_needs[en]);
    en = en + 1;
  }
  // _start belongs only to the entry module (one program entry point). A
  // non-entry library module exposes its `__fn_*` definitions and nothing else.
  if (is_entry) {
    s = s.write("_start:\n");
    // The sandbox is installed before anything else runs, so the filter
    // covers the whole program, the arena mmap included.
    if (asmcore.sandbox_on()) {
      s = s.write("    call __fern_seccomp_install\n");
    }
    // args() reads __fern_argc / __fern_argv; save them from the initial stack
    // (the kernel puts argc at the top of the stack on entry) BEFORE any push.
    // Matches asm.fern's _start. Gated on the args need so a non-args program
    // is byte-identical.
    if (s.has_need("args")) {
      s = s.write("    movq (%rsp), %rax\n");
      s = s.write("    movq %rax, __fern_argc(%rip)\n");
      s = s.write("    leaq 8(%rsp), %rax\n");
      s = s.write("    movq %rax, __fern_argv(%rip)\n");
    }
    // env() reads __fern_envp; save it from the initial stack BEFORE any push.
    // envp follows argv's NULL terminator: envp = rsp + 16 + argc*8 (argc at
    // [rsp], argv at rsp+8 with argc+1 slots incl. the NULL). Gated on the env /
    // subprocess needs (not heap, unlike asm.fern) so other programs stay
    // byte-identical. Both __fern_env and __fern_subprocess (execve) read it.
    if (s.any_need(["env", "subprocess", "environ", "raw_environ"])) {
      s = s.write("    movq (%rsp), %rax\n");
      s = s.write("    leaq 16(%rsp,%rax,8), %rax\n");
      s = s.write("    movq %rax, __fern_envp(%rip)\n");
    }
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    // A MAIN-LESS module (a library compiled standalone — util.fern et al.
    // under the bootstrap self-compile) has no __fn_main to call, so `_start`
    // exits 0 directly. Mirrors the retired x86 AST emitter's own no-main branch, minus the
    // top-level statements: a script-shaped source has already been rewritten
    // into `function main()` by asmcore.synth_script_main upstream, so
    // anything still main-less here is a library with functions only.
    //
    // Emitting the call unconditionally is what forced the gate to refuse such
    // a module (`require_main`), which is why the bootstrap smoke test — it
    // pipes each compiler SOURCE through this driver, and 7 of 9 are
    // main-less — depended on the AST emitter.
    if (asmcore.has_main(mod)) {
      s = s.write("    call __fn_main\n");
      // Leak summary before the exit syscall (#6068). main's return value
      // is the exit code and is still in %rax, so it is held on the stack
      // across the call rather than relying on a register contract.
      if (s.leak_check) {
        s = s.write("    pushq %rax\n");
        s = s.write("    call __fern_lc_report\n");
        s = ssa_pop_r(s, "%rax");
      }
      s = s.write("    movq %rax, %rdi\n");
    } else {
      if (s.leak_check) {
        s = s.write("    call __fern_lc_report\n");
      }
      s = s.write("    movq $0, %rdi\n");
    }
    s = s.write("    movq $60, %rax\n");
    s = s.syscall(60);
  }
  // Pre-intern "FileStat" so the __fern_stat runtime helper (emitted after this
  // literal pool, inside the heap/stat block) can reference its shape label. The
  // helper's own shape_ref dedups to this slot; without the early intern the label
  // would be undefined (the runtime emits AFTER the pool). Mirrors the
  // retired AST emitters' FileStat pre-intern. Gated on the stat need.
  if (s.has_need("stat") || s.has_need("lstat") || s.has_need("access") || s.has_need("fd_stat")) {
    let fsPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "FileStat");
    s = fsPre.state;
  }
  // Pre-intern "FsStat" for __fern_statfs's shape label, same reasoning as
  // FileStat above. Its own gate: a stat-only program has no FsStat to build.
  if (s.has_need("statfs")) {
    let fvPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "FsStat");
    s = fvPre.state;
  }
  if (s.has_need("mounts")) {
    let mePre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "MountEntry");
    s = mePre.state;
  }
  // Pre-intern "DirEntry" for __fern_read_dir_ino's shape label, same
  // reasoning as FsStat above.
  if (s.has_need("read_dir_ino")) {
    let dePre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "DirEntry");
    s = dePre.state;
  }
  // Pre-intern "WinSize" for __fern_window_size's shape label, same
  // reasoning as FsStat above.
  if (s.has_need("window_size")) {
    let wsPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "WinSize");
    s = wsPre.state;
  }
  // Pre-intern "ProcessResult" for the __fern_subprocess runtime's shape label
  // (same reasoning as FileStat above). Gated on the subprocess need.
  if (s.has_need("subprocess")) {
    let prPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "ProcessResult");
    s = prPre.state;
  }
  // .rodata: each interned string literal as a labelled `.ascii` directive
  // (GAS interprets the escapes), matching asm.fern's emit_module so the box's
  // .S<idx> data pointer resolves. string_lits was populated by const_str.
  if (s.string_lits.len() > 0) {
    s = s.write("    .section .rodata\n");
    let li: i32 = 0;
    while (li < s.string_lits.len()) {
      s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
      li = li + 1;
    }
    s = asmcore.emit_str_box_data_from(s, 0);
  }
  // .data: one block per static aggregate constant (#6149). After the string
  // pool, because a block's first word is a shape POINTER into it.
  s = asmcore.emit_const_agg_data(s);
  // Per-module shape pointers: emit each distinct shape name once as a `.weak`
  // global symbol (shape_sym) carrying its name bytes. Every unit referencing the
  // same shape emits the same weak symbol, so the linker merges them to ONE
  // address — pointer-equality shape discrimination then holds across the module
  // boundary (a token constructed in the lexer unit matches in the parser unit).
  // Only populated on the per-module path (shape_ref interns shapes as ordinary
  // string literals when str_ns == "", so the whole-program emit is unchanged).
  s = asmcore.emit_shape_lits_from(s, 0);
  // The "heap" needs were marked per-function during the emit loop
  // above (off the ops each function's lowering already produced), so there is
  // no need to re-lower the module here. The whole-program extra_needs (sibling modules'
  // needs, for the entry's single shared runtime) were folded in above, BEFORE
  // _start (so its argc/argv save sees a sibling's args need) and hence before
  // close_needs, so their declared deps resolve too.
  s = s.close_needs();
  // The shared `__fern_*` runtime is emitted ONCE, by the entry module — a
  // non-entry library module references these helpers as externs (resolved at
  // link against the entry's copy), so emitting them again would duplicate-
  // define the symbols. (Until runtime needs are aggregated whole-program,
  // the entry only knows its OWN needs; a non-entry module that itself
  // allocates relies on the entry having pulled the heap runtime in.)
  if (is_entry) {
    s = emit_entry_runtime_settled(s);
    // Last: the allowlist is complete only once every other emitter has run.
    if (asmcore.sandbox_on()) {
      s = emit_seccomp_install(s);
    }
  }
  return ssaprepare.Output { text: strbuf_take(), bodies: s.prepared };
}

// emit_seccomp_install writes `__fern_seccomp_install` and the seccomp-bpf
// program it loads (#6071), as the native x86-64 backend does. The program
// checks the audit arch, then allows each syscall `s` recorded and kills the
// process on any other; the prctl and seccomp calls that install it are not
// in the list, since they run before the filter applies. A failed seccomp(2)
// is ignored, so a kernel without seccomp runs the program unhardened.
//
// Each sock_filter is { u16 code; u8 jt; u8 jf; u32 k }, laid down as two
// `.long`s. The comparison for the i-th of n allowed numbers jumps n - i
// ahead to ALLOW, and jt is a u8, which caps the list at 255.
function emit_seccomp_install(s: asmcore.EmitState): asmcore.EmitState {
  if (s.raw_syscall != "") {
    eprint("fern: " + s.raw_syscall + " passes the syscall number at run time, which the seccomp sandbox cannot allowlist; FERN_SANDBOX=1 refuses the program");
    exit(1);
    return s;
  }
  let allowed: i32[] = s.syscalls;
  let n: i32 = allowed.len();
  if (n > 255) {
    eprint("internal error: the seccomp allowlist has " + util.i32_to_string(n) + " syscalls; the u8 jump offset caps it at 255");
    exit(3);
    return s;
  }
  // The runtime may have left the stream in a data section.
  s = s.write("    .section .text\n__fern_seccomp_install:\n");
  // prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0): what lets an unprivileged
  // process install a filter.
  s = s.write("    movq $38, %rdi\n    movq $1, %rsi\n    movq $0, %rdx\n    movq $0, %r10\n    movq $0, %r8\n    movq $157, %rax\n").syscall(157);
  // seccomp(SECCOMP_SET_MODE_FILTER, 0, &prog), the sock_fprog
  // { u16 len; struct sock_filter *filter } built on the stack so the
  // pointer needs no relocation.
  s = s.write("    subq $16, %rsp\n    movq $" + util.i32_to_string(n + 6) + ", %rax\n    movq %rax, (%rsp)\n");
  s = s.write("    leaq .Lseccomp_filter(%rip), %rax\n    movq %rax, 8(%rsp)\n");
  s = s.write("    movq $1, %rdi\n    movq $0, %rsi\n    movq %rsp, %rdx\n    movq $317, %rax\n").syscall(317);
  s = s.write("    addq $16, %rsp\n    ret\n");
  s = s.write("    .section .rodata\n    .align 8\n.Lseccomp_filter:\n");
  s = bpf_insn(s, 32, 0, "4");  // A = seccomp_data.arch
  s = bpf_insn(s, 21, 1, "0xC000003E");  // AUDIT_ARCH_X86_64: skip the kill
  s = bpf_insn(s, 6, 0, "0x80000000");  // any other arch: kill
  s = bpf_insn(s, 32, 0, "0");  // A = seccomp_data.nr
  let i: i32 = 0;
  while (i < n) {
    s = bpf_insn(s, 21, n - i, util.i32_to_string(allowed[i]));
    i = i + 1;
  }
  s = bpf_insn(s, 6, 0, "0x80000000");  // unmatched: kill
  s = bpf_insn(s, 6, 0, "0x7FFF0000");  // allow
  return s.write("    .section .text\n");
}

// bpf_insn writes one sock_filter with `jf` 0: `code` (BPF_LD|W|ABS 32,
// BPF_JMP|JEQ|K 21, BPF_RET|K 6), the true-branch offset `jt` and `k`.
function bpf_insn(s: asmcore.EmitState, code: i32, jt: i32, k: string): asmcore.EmitState {
  return s.write("    .long " + util.i32_to_string(code + jt * 65536) + ", " + k + "\n");
}

// A typed runtime body can call a need-gated runtime block emitted before it,
// so the runtime is emitted into a capture and emitted again, from the state
// before it, with the needs it added, until they stop growing.
function emit_entry_runtime_settled(s0: asmcore.EmitState): asmcore.EmitState {
  let s: asmcore.EmitState = s0;
  let settled: boolean = false;
  let out: asmcore.EmitState = s0;
  while (!settled) {
    s = s.close_needs();
    let h: usize = buf_new(65536);
    let t: asmcore.EmitState = emit_entry_runtime(asmcore.EmitState { ...s, capture: h });
    let text: string = buf_take(h);
    buf_free(h);
    if (t.needed.len() == s.needed.len()) {
      settled = true;
      let back: asmcore.EmitState = asmcore.EmitState { ...t, capture: s0.capture };
      out = back.write(text);
    } else {
      s = asmcore.EmitState { ...s0, needed: t.needed };
    }
  }
  return out;
}

// The shared `__fern_*` runtime the entry module emits.
function emit_entry_runtime(s: asmcore.EmitState): asmcore.EmitState {
  // __fern_str_cmp (#2649): string-ordering helper, hosted on the IR path
  // as a Fern function. Self-contained (two borrowed strings, byte compare, no
  // alloc / no other helper call), so emit_ir_runtime_fern_fn's singleton
  // side-tables are complete. Same .text + need-gated, entry-only emission.
  if (s.has_need("str_cmp")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_cmp(), s);
  }
  // The freestanding allocator + RC runtime, only when the program allocates.
  // i32.to_string() allocates its box even in an otherwise heap-free program,
  // so its emit-time need pulls the runtime in too (its body calls __fern_alloc).
  if (needs_heap_runtime(s)) {
    s = emit_ir_runtime(s);
  }
  // The f64 transcendental bundle (sin/cos/exp/log/pow). Deliberately NOT
  // inside the heap gate above: a program that only does float maths
  // allocates nothing, and would otherwise `call __fern_sin_f64` with no
  // definition anywhere in the link.
  if (s.has_need("float_transcendentals")) {
    s = emit_rt_float_transcendentals(s);
  }
  // The CRC fold. Its own gate rather than the heap one: a program that
  // hashes a borrowed string allocates nothing, and would otherwise
  // `call __fern_crc32_cksum` with no definition anywhere in the link.
  if (s.has_need("crc32_cksum")) {
    s = emit_rt_crc32_cksum(s);
  }
  if (s.has_need("aes_gcm")) {
    s = emit_rt_aes_gcm(s);
  }
  if (s.has_need("sum_bytes")) {
    s = emit_rt_sum_bytes(s);
  }
  // Heap-event diagnostics (#6068): the __fern_hev_* hooks the runtime above
  // calls, plus the leakcheck counters and exit-time report. Deliberately NOT
  // inside the heap gate — a heap-free program still lowers `exit`, which
  // calls __fern_lc_report, and it must resolve. When neither flag is set
  // this emits nothing at all.
  if (hev_on(s)) {
    s = s.write("    .text\n");
    s = emit_hev_runtime(s);
  }
  // The abort reporter (#11405): with the heap runtime, whose traps jump to
  // it, and under either sanitizer flag, whose reports end in its walk even
  // when the program allocates nothing. A build that has neither carries no
  // reporter.
  if (needs_heap_runtime(s) || s.rc_free_debug || s.sanitize) {
    s = s.write("    .text\n");
    s = emit_report(s);
  }
  // The UAF quarantine's fatal report. Self-contained — its own write(2) +
  // exit(124) rather than the hev writer — so FERN_RC_FREE_DEBUG works
  // standalone, without leakcheck. Entry-only, like the hev block above.
  if (s.rc_free_debug) {
    s = s.write("    .text\n");
    s = emit_san_uaf_abort(s);
  }
  // FFI __c_call<n> shims (#4375): allocation-free register-marshal + `call
  // *fn`, so independent of the heap runtime above. Emitted in .text when the
  // module referenced any variant (emit_ir_runtime, when it ran, left .bss).
  if (any_ccall_need(s)) {
    s = s.write("    .text\n");
    s = emit_ccall_shims(s);
  }
  // __fern_str_eq (#2649): string equality, also called by the arr_str
  // helpers. Hand-written rather than a Fern body — see rt_x86_str_eq for
  // why. Gated on str_eq.
  if (s.has_need("str_eq")) {
    s = s.write("    .text\n");
    s = s.write(rt_x86_str_eq());
  }
  // ASCII case transforms (to_upper / to_lower) — heap-dependent, so the heap
  // runtime is already present; emitted on their own str_case need.
  // str_to_upper / _lower — now Fern runtime functions (#2649), lowered through
  // the IR pipeline: copy each byte case-flipped if alpha. Heap-dependent.
  if (s.has_need("str_case")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_upper(), s);
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_lower(), s);
  }
  // String repeat — now a Fern runtime function (#2649), lowered through the
  // IR pipeline: n copies of `s` in a fresh buffer via the raw-memory
  // intrinsics. Heap-dependent (present above).
  if (s.has_need("str_repeat")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_repeat(), s);
  }
  // String trim — now a Fern runtime function (#2649), lowered through the IR
  // pipeline (zero-copy slice; the slice box allocates, so the heap runtime
  // above is present). .text since the heap runtime left us in .bss.
  if (s.has_need("str_trim")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_trim(), s);
  }
  // String replace — now a Fern runtime function (#2649), lowered through the
  // IR pipeline: two-pass count + build via the raw-memory intrinsics.
  // Heap-dependent (present above).
  if (s.has_need("str_replace")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_replace(), s);
  }
  // string_from_bytes_unchecked — now a Fern runtime function (#2649), lowered through the
  // IR pipeline: pack each array element's low byte into a fresh string box via
  // the raw-memory intrinsics. Heap-dependent (present above).
  if (s.has_need("str_from_bytes")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_string_from_bytes(), s);
  }
  // The packed-byte twins (asmcore.packed_suffix), for a typed program's u8[].
  if (s.has_need("str_from_bytes_u8")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_string_from_bytes_u8(), s);
  }
  if (s.has_need("str_from_bytes_range_u8")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_string_from_bytes_range_u8(), s);
  }
  if (s.has_need("str_bytes_u8")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_bytes_u8(), s);
  }
  if (s.has_need("arr_slice_u8")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_slice_u8(), s);
  }
  if (s.has_need("random_bytes_u8")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_random_bytes_u8("x86_64"), s);
  }
  if (s.has_need("tcp_recv_u8")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_tcp_recv_u8("x86_64"), s);
  }
  if (s.has_need("tcp_recv_into_u8")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_tcp_recv_into_u8("x86_64"), s);
  }
  // random_bytes — now a Fern runtime function (#2649), lowered through the IR
  // pipeline: fill n scratch bytes from getrandom via the __syscall3 sub-floor,
  // spread them into a fresh u8[] box (__raw_arr_box). Heap-dependent (present
  // above). The source is shared with arm64 (asm_arm64_ir passes its own
  // target); asmcore.sysno picks 318.
  if (s.has_need("random_bytes")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_random_bytes("x86_64"), s);
  }
  // a[start:end] — a Fern runtime function (#2649) over the __raw_arr_box +
  // __raw_array pair: allocate the fresh box, copy the 8-byte slots, hand it
  // back. Heap-dependent (present above). It takes a target, because its
  // bounds trap is exit(134) through __syscall3 and the exit number is
  // per-target (asmcore.sysno picks 60 here).
  if (s.has_need("arr_slice")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_slice(), s);
  }
  // str_split — now a Fern runtime function (#2649), lowered through the IR
  // pipeline: scan for `sep`, append each segment slice (.append() ->
  // arr_push_owned, present via its str_split need deps). Heap-dependent (above).
  if (s.has_need("str_split")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_split(), s);
  }
  // String lines — now a Fern runtime function (#2649), lowered through the IR
  // pipeline: splits on '\n' (str_split) + drops the trailing empty via an array
  // slice (arr_slice); both deps are present (heap runtime above + their own
  // need-gated blocks). .text since the heap runtime left us in .bss.
  if (s.has_need("str_lines")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_lines(), s);
  }
  // String bytes — now a Fern runtime function (#2649), lowered through the IR
  // pipeline: builds the byte i32[] by appending each byte (arr_push, present via
  // its own need-gated block + the heap runtime above). .text since the heap
  // runtime left us in .bss.
  if (s.has_need("str_bytes")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_bytes(), s);
  }
  // str_concat — backs `+` on strings, now Tier-2 via the intrinsics (#2649):
  // alloc lenA+lenB, copy A then B byte-by-byte, box it. Heap-dependent (present
  // above). .text since the heap runtime left us in .bss.
  if (s.has_need("str_concat")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_concat(), s);
  }
  // arr.join(sep) — a Fern runtime function (#5328) lowered through the IR
  // pipeline: two passes over an exact-size block, summing the lengths and
  // then memcpy'ing each piece in. Heap-dependent (present above). .text
  // since the heap runtime left us in .bss.
  if (s.has_need("arr_str_join")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_str_join(), s);
  }
  // i32_to_string — backs (n).to_string(), Tier-2 via the intrinsics (#2649):
  // digit-buffer build. Heap-dependent (present above).
  if (s.has_need("i32_to_string")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_i32_to_string(), s);
  }
  // u32_to_string — UNSIGNED sibling for (u32).to_string() (#2649). Heap-dep.
  if (s.has_need("u32_to_string")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_u32_to_string(), s);
  }
  // i64_to_string / u64_to_string — the WIDE siblings (#5826). Heap-dep. The
  // unsigned one is not optional: __fern_i64_to_string renders a u64 with bit
  // 63 set as negative.
  if (s.has_need("i64_to_string")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_i64_to_string(), s);
  }
  if (s.has_need("u64_to_string")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_u64_to_string(), s);
  }
  // random_i32 allocates nothing, so its helper is emitted independently of
  // the heap runtime (a random_i32-only program is heap-free).
  if (s.has_need("random_i32")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_random_i32("x86_64"), s);
  }
  if (s.has_need("map_hash_seed")) {
    s = emit_ir_map_hash_seed(s);
  }
  // fork / wait4 allocate nothing either — same heap-independent gating.
  if (s.has_need("proc_fork")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_fork("x86_64"), s);
  }
  if (s.has_need("proc_waitpid")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_waitpid("x86_64"), s);
  }
  if (s.has_need("proc_waitpid_nohang")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_waitpid_nohang("x86_64"), s);
  }
  if (s.has_need("proc_waitpid_status")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_waitpid_status("x86_64"), s);
  }
  if (s.has_need("proc_exec")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_exec("x86_64"), s);
  }
  if (s.has_need("proc_exec_as")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_exec_as("x86_64"), s);
  }
  // subprocess (#2649) — the composite: pipes + fork + exec + drain + reap in
  // one bundle with its two local helpers. Heap-dependent (it allocates the
  // argv, the stream buffers and the result), and the "ProcessResult" shape
  // label it builds through is pre-interned in the entry block on the same need.
  if (s.has_need("subprocess")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_subprocess("x86_64"), s);
  }
  // The fixed static __fern_scratch buffer (#2649): the buffer the syscall-leaf
  // helpers hand the kernel to write structs into (timespec for the clocks,
  // struct stat for `stat` and for the readers' size probe), reused/never-freed
  // so no per-call leak. Emitted once in .bss when ANY scratch user is needed,
  // then the helpers in .text.
  // Allocation-free, so independent of the heap runtime.
  //
  // `poll` is in the list for arm64's sake: only ppoll needs a timespec, and
  // x86-64's poll(2) takes the timeout as a plain argument. The two gates are
  // kept identical anyway — the cost is one unused .bss buffer in an x86-only
  // poll program, and a divergence here is a link failure, which is how this
  // list grew the last three entries.
  if (s.any_need([
    "monotonic_ns", "now_unix_ms", "now_ns", "stat", "lstat", "dir_stat",
    "read_file", "read_file_bytes", "read_file_bytes_u8", "random_i32", "sleep_ms",
    "sleep_ns", "set_file_times", "statfs", "poll", "proc_waitpid",
    "proc_waitpid_nohang", "proc_waitpid_status", "disable_core_dumps",
    "timer_fd", "tcp_listen", "tcp_local_port", "tcp_connect", "putchar",
    "udp_send_bytes", "udp_send_bytes_u8", "udp_sendto_bytes", "udp_sendto_bytes_u8",
    "eprint", "udp_send", "tcp_listen_with", "tcp_socket_ctl", "udp_bind", "udp_connect", "udp_sendto", "udp_recvfrom", "tcp_connect_with", "unix_listen", "unix_connect", "reactor_new", "reactor_ctl", "reactor_wait", "tcp_recv_into", "tcp_sendfile",
    "tcp_listen_with_u8", "udp_bind_u8", "udp_connect_u8", "udp_sendto_u8", "udp_recvfrom_u8", "tcp_connect_with_u8",
    "isatty", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc", "pipe",
    "rlimit_nofile", "signal_ignore", "signal_default", "signal_catch", "signal_mask",
    "signal_disposition", "access",
    "geteuid", "getegid", "getuid", "getgid", "getgroups", "environ",
    "fd_stat", "raw_scratch",
    "clock_resolution", "clock_set", "ct_mark",
  ])) {
    s = s.write("    .section .bss\n    .align 8\n__fern_scratch: .skip " + asmcore.scratch_size("x86_64", s.has_need("statfs")) + "\n    .text\n");
  }
  if (s.any_need(["reader_splice", "raw_splice_pipe"])) {
    s = s.write("    .section .bss\n    .align 8\n__fern_splice_pipe: .quad 0, 0\n    .text\n");
  }
  if (s.has_need("raw_cover")) {
    s = s.write("    .section .bss\n    .align 8\n__fern_cov_counters: .quad 0\n    .text\n");
  }
  if (s.has_need("task")) {
    s = s.write("    .section .bss\n    .align 8\n__fern_task_state: .quad 0, 0, 0, 0\n    .text\n");
  }
  // The stdout/stderr leaves (#2649) — plain write(2) calls, allocation-free, so
  // they sit with the clocks rather than in the heap runtime: a program that only
  // prints must still link.
  if (s.has_need("str_read_line")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_read_line("x86_64"), s);
  }
  if (s.has_need("str_print")) {
    s = s.write("    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_print_str("x86_64"), s);
  }
