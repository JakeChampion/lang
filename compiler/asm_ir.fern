  // words*8) to the large freelist instead of leaking it.
  s = s.write(".Larrdec_large:\n");
  s = s.write("    leaq -16(%rax), %r8\n");  // base = arr-16
  s = s.write("    leaq 0(,%rcx,8), %rsi\n");  // bytes = words*8
  s = s.write("    call __fern_large_push\n");
