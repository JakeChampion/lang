// This kernel updates the raw reflected IEEE CRC-32 register. The caller inverts the register.
// Four lanes fold 64 bytes at a time, then one lane folds 16 bytes at a time.
// A Barrett reduction gives the register. A byte table then takes the last 15 bytes or fewer.
function emit_rt_crc32_ieee(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .rodata\n");
  s = s.write("    .align 16\n");
  s = s.write(".Lcrc32_ieee_k12:\n");
  s = s.write("    .quad 0x0000000154442bd4\n");
  s = s.write("    .quad 0x00000001c6e41596\n");
  s = s.write(".Lcrc32_ieee_k34:\n");
  s = s.write("    .quad 0x00000001751997d0\n");
  s = s.write("    .quad 0x00000000ccaa009e\n");
  s = s.write(".Lcrc32_ieee_k5:\n");
  s = s.write("    .quad 0x0000000163cd6124\n");
  s = s.write("    .quad 0x0000000000000000\n");
  s = s.write(".Lcrc32_ieee_pmu:\n");
  s = s.write("    .quad 0x00000001db710641\n");
  s = s.write("    .quad 0x00000001f7011641\n");
  s = s.write(".Lcrc32_ieee_table:\n");
  s = s.write(crc32_ieee_table_rows());
  s = s.write("    .section .text\n");
  s = s.write("    .globl __fern_crc32_ieee\n");
  s = s.write("    .globl __fern_crc32_ieee_data\n");
  s = s.write("    .type __fern_crc32_ieee, @function\n");
  s = s.write("__fern_crc32_ieee:\n");
  s = s.write("    movq 8(%rsi), %rdx\n");
  s = s.write("    movq (%rsi), %rsi\n");
  s = s.write("__fern_crc32_ieee_data:\n");
  s = s.write("    movl %edi, %eax\n");
  s = s.write("    cmpq $16, %rdx\n");
  s = s.write("    jb .Lcrc32_ieee_tail\n");
  s = s.write("    movd %eax, %xmm1\n");
  s = s.write("    movdqu (%rsi), %xmm0\n");
  s = s.write("    pxor %xmm1, %xmm0\n");
  s = s.write("    movdqa .Lcrc32_ieee_k34(%rip), %xmm4\n");
  s = s.write("    cmpq $64, %rdx\n");
  s = s.write("    jae .Lcrc32_ieee_wide\n");
  s = s.write("    addq $16, %rsi\n");
  s = s.write("    subq $16, %rdx\n");
  s = s.write("    jmp .Lcrc32_ieee_fold1\n");
  s = s.write(".Lcrc32_ieee_wide:\n");
  s = s.write("    movdqu 16(%rsi), %xmm1\n");
  s = s.write("    movdqu 32(%rsi), %xmm2\n");
  s = s.write("    movdqu 48(%rsi), %xmm3\n");
  s = s.write("    movdqa .Lcrc32_ieee_k12(%rip), %xmm5\n");
  s = s.write("    addq $64, %rsi\n");
  s = s.write("    subq $64, %rdx\n");
  s = s.write("    cmpq $64, %rdx\n");
  s = s.write("    jb .Lcrc32_ieee_combine\n");
  s = s.write(".Lcrc32_ieee_fold4:\n");
  s = s.write("    movdqa %xmm0, %xmm6\n");
  s = s.write("    pclmulqdq $0x00, %xmm5, %xmm0\n");
  s = s.write("    pclmulqdq $0x11, %xmm5, %xmm6\n");
  s = s.write("    movdqu (%rsi), %xmm10\n");
  s = s.write("    pxor %xmm6, %xmm0\n");
  s = s.write("    pxor %xmm10, %xmm0\n");
  s = s.write("    movdqa %xmm1, %xmm7\n");
  s = s.write("    pclmulqdq $0x00, %xmm5, %xmm1\n");
  s = s.write("    pclmulqdq $0x11, %xmm5, %xmm7\n");
  s = s.write("    movdqu 16(%rsi), %xmm11\n");
  s = s.write("    pxor %xmm7, %xmm1\n");
  s = s.write("    pxor %xmm11, %xmm1\n");
  s = s.write("    movdqa %xmm2, %xmm8\n");
  s = s.write("    pclmulqdq $0x00, %xmm5, %xmm2\n");
  s = s.write("    pclmulqdq $0x11, %xmm5, %xmm8\n");
  s = s.write("    movdqu 32(%rsi), %xmm12\n");
  s = s.write("    pxor %xmm8, %xmm2\n");
  s = s.write("    pxor %xmm12, %xmm2\n");
  s = s.write("    movdqa %xmm3, %xmm9\n");
  s = s.write("    pclmulqdq $0x00, %xmm5, %xmm3\n");
  s = s.write("    pclmulqdq $0x11, %xmm5, %xmm9\n");
  s = s.write("    movdqu 48(%rsi), %xmm13\n");
  s = s.write("    pxor %xmm9, %xmm3\n");
  s = s.write("    pxor %xmm13, %xmm3\n");
  s = s.write("    addq $64, %rsi\n");
  s = s.write("    subq $64, %rdx\n");
  s = s.write("    cmpq $64, %rdx\n");
  s = s.write("    jae .Lcrc32_ieee_fold4\n");
  s = s.write(".Lcrc32_ieee_combine:\n");
  s = s.write("    movdqa %xmm0, %xmm6\n");
  s = s.write("    pclmulqdq $0x00, %xmm4, %xmm0\n");
  s = s.write("    pclmulqdq $0x11, %xmm4, %xmm6\n");
  s = s.write("    pxor %xmm6, %xmm0\n");
  s = s.write("    pxor %xmm1, %xmm0\n");
  s = s.write("    movdqa %xmm0, %xmm6\n");
  s = s.write("    pclmulqdq $0x00, %xmm4, %xmm0\n");
  s = s.write("    pclmulqdq $0x11, %xmm4, %xmm6\n");
  s = s.write("    pxor %xmm6, %xmm0\n");
  s = s.write("    pxor %xmm2, %xmm0\n");
  s = s.write("    movdqa %xmm0, %xmm6\n");
  s = s.write("    pclmulqdq $0x00, %xmm4, %xmm0\n");
  s = s.write("    pclmulqdq $0x11, %xmm4, %xmm6\n");
  s = s.write("    pxor %xmm6, %xmm0\n");
  s = s.write("    pxor %xmm3, %xmm0\n");
  s = s.write(".Lcrc32_ieee_fold1:\n");
  s = s.write("    cmpq $16, %rdx\n");
  s = s.write("    jb .Lcrc32_ieee_reduce\n");
  s = s.write("    movdqa %xmm0, %xmm6\n");
  s = s.write("    pclmulqdq $0x00, %xmm4, %xmm0\n");
  s = s.write("    pclmulqdq $0x11, %xmm4, %xmm6\n");
  s = s.write("    movdqu (%rsi), %xmm1\n");
  s = s.write("    pxor %xmm6, %xmm0\n");
  s = s.write("    pxor %xmm1, %xmm0\n");
  s = s.write("    addq $16, %rsi\n");
  s = s.write("    subq $16, %rdx\n");
  s = s.write("    jmp .Lcrc32_ieee_fold1\n");
  s = s.write(".Lcrc32_ieee_reduce:\n");
  s = s.write("    movdqa %xmm0, %xmm1\n");
  s = s.write("    pclmulqdq $0x10, %xmm4, %xmm1\n");
  s = s.write("    psrldq $8, %xmm0\n");
  s = s.write("    pxor %xmm1, %xmm0\n");
  s = s.write("    movd %xmm0, %ecx\n");
  s = s.write("    movd %ecx, %xmm1\n");
  s = s.write("    movdqa .Lcrc32_ieee_k5(%rip), %xmm2\n");
  s = s.write("    pclmulqdq $0x00, %xmm2, %xmm1\n");
  s = s.write("    psrldq $4, %xmm0\n");
  s = s.write("    pxor %xmm1, %xmm0\n");
  s = s.write("    movd %xmm0, %ecx\n");
  s = s.write("    movd %ecx, %xmm1\n");
  s = s.write("    movdqa .Lcrc32_ieee_pmu(%rip), %xmm2\n");
  s = s.write("    pclmulqdq $0x10, %xmm2, %xmm1\n");
  s = s.write("    movd %xmm1, %ecx\n");
  s = s.write("    movd %ecx, %xmm1\n");
  s = s.write("    pclmulqdq $0x00, %xmm2, %xmm1\n");
  s = s.write("    pxor %xmm1, %xmm0\n");
  s = s.write("    psrldq $4, %xmm0\n");
  s = s.write("    movd %xmm0, %eax\n");
  s = s.write(".Lcrc32_ieee_tail:\n");
  s = s.write("    testq %rdx, %rdx\n");
  s = s.write("    jz .Lcrc32_ieee_ret\n");
  s = s.write("    leaq .Lcrc32_ieee_table(%rip), %r8\n");
  s = s.write(".Lcrc32_ieee_byte:\n");
  s = s.write("    movzbl (%rsi), %ecx\n");
  s = s.write("    xorl %eax, %ecx\n");
  s = s.write("    movzbl %cl, %ecx\n");
  s = s.write("    shrl $8, %eax\n");
  s = s.write("    xorl (%r8,%rcx,4), %eax\n");
  s = s.write("    addq $1, %rsi\n");
  s = s.write("    subq $1, %rdx\n");
  s = s.write("    jnz .Lcrc32_ieee_byte\n");
  s = s.write(".Lcrc32_ieee_ret:\n");
  s = s.write("    ret\n");
  s = s.write("    .size __fern_crc32_ieee, .-__fern_crc32_ieee\n");
  return s;
}

function crc32_ieee_table_rows(): string {
  let out = "";
  for i in 0..256 {
    let c = i as u32;
    for k in 0..8 {
      if ((c & 1) != 0) {
        c = c >> 1 ^ 0xedb88320;
      } else {
        c = c >> 1;
      }
    }
    if (i % 8 == 0) {
      out += "    .long ";
    } else {
      out += ",";
    }
    out += util.i32_to_string(c as i32);
    if (i % 8 == 7) {
      out += "\n";
    }
  }
  return out;
}

function needs_fs_runtime(s: asmcore.EmitState): boolean {
  return s.any_need([
    "hostname", "uname_field",
    "stat", "lstat", "statfs", "mounts", "sysctl", "access", "read_file",
    "read_file_bytes", "read_file_bytes_u8", "remove_file", "create_dir_all", "create_dir",
    "remove_dir", "create_link", "clone_file", "create_symlink", "rename", "rename_noreplace", "rename_exchange", "getxattr", "getxattr_bytes", "getxattr_bytes_u8", "lgetxattr", "lgetxattr_bytes", "lgetxattr_bytes_u8", "setxattr", "setxattr_bytes", "setxattr_bytes_u8", "lsetxattr", "lsetxattr_bytes", "lsetxattr_bytes_u8", "chmod", "chmod_at",
    "truncate", "mknod", "chown_at", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc", "pipe", "set_file_times", "writer_set_times",
    "read_link", "getcwd", "chdir", "chroot", "setuid", "setgid", "setgroups", "fd_fsync", "fd_fdatasync", "fd_syncfs", "fd_drop_cache", "sync",
    "umask", "write_file", "write_file_bytes", "write_file_bytes_u8", "write_file_exec", "temp_dir", "read_dir", "read_dir_bytes", "read_dir_all", "read_dir_ino", "read_dir_ino_all",
    "remove_dir_all", "open_file", "open_with", "writer_write", "write_some", "splice_forever",
    "reader", "read_chunk_bytes", "read_chunk_bytes_u8", "write_bytes", "write_bytes_u8", "write_some_bytes", "write_some_bytes_u8", "signal_send", "set_process_group", "set_priority", "clock_set",
    "open_dir", "dir_open", "dir_entries", "dir_stat", "dir_access", "dir_unlink", "dir_chmod", "dir_chown", "dir_open_file",
  ]);
}

function needs_heap_runtime(s: asmcore.EmitState): boolean {
  return s.any_need([
    "heap", "i32_to_string", "u32_to_string",
    "buf", "reader",
    "write_file", "write_file_bytes", "write_file_bytes_u8", "write_file_exec", "remove_dir_all", "temp_dir",
    "read_dir", "read_dir_bytes", "read_dir_all", "read_dir_ino", "read_dir_ino_all", "remove_file", "create_dir_all", "create_dir",
    "remove_dir", "create_link", "clone_file", "create_symlink", "rename", "rename_noreplace", "rename_exchange", "getxattr", "getxattr_bytes", "getxattr_bytes_u8", "lgetxattr", "lgetxattr_bytes", "lgetxattr_bytes_u8", "setxattr", "setxattr_bytes", "setxattr_bytes_u8", "lsetxattr", "lsetxattr_bytes", "lsetxattr_bytes_u8", "chmod", "chmod_at",
    "truncate", "mknod", "chown_at", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc", "pipe", "set_file_times", "writer_set_times",
    "read_link", "getcwd", "chdir", "chroot", "setuid", "setgid", "setgroups",
    "umask", "env", "environ", "raw_environ", "getgroups", "stat", "lstat", "statfs", "mounts", "sysctl",
    "access", "fd_fsync", "fd_fdatasync", "fd_syncfs", "fd_drop_cache", "subprocess",
    "signal_send", "set_process_group", "set_priority", "clock_set",
    "open_dir", "dir_open", "dir_entries", "dir_stat", "dir_access", "dir_unlink", "dir_chmod", "dir_chown", "dir_open_file",
  ]);
}

// Copies rcx bytes, at least one, from rsi to rdi and returns. A count of up
// to 16 is two overlapping loads and stores in r8 and r9, as __fern_memcpy
// does after its size tests.
function buf_copy_tail(s: asmcore.EmitState, label: string): asmcore.EmitState {
  s = s.write("    cmpq $8, %rcx\n    jae " + label + "_c8\n    cmpq $4, %rcx\n    jae " + label + "_c4\n    cmpq $2, %rcx\n    jae " + label + "_c2\n");
  s = s.write("    movzbl (%rsi), %r8d\n    movb %r8b, (%rdi)\n    ret\n");
  s = s.write(label + "_c2:\n    movzwl (%rsi), %r8d\n    movzwl -2(%rsi,%rcx), %r9d\n    movw %r8w, (%rdi)\n    movw %r9w, -2(%rdi,%rcx)\n    ret\n");
  s = s.write(label + "_c4:\n    movl (%rsi), %r8d\n    movl -4(%rsi,%rcx), %r9d\n    movl %r8d, (%rdi)\n    movl %r9d, -4(%rdi,%rcx)\n    ret\n");
  s = s.write(label + "_c8:\n    cmpq $16, %rcx\n    ja " + label + "_long\n    movq (%rsi), %r8\n    movq -8(%rsi,%rcx), %r9\n    movq %r8, (%rdi)\n    movq %r9, -8(%rdi,%rcx)\n    ret\n");
  return s.write(label + "_long:\n    movq %rcx, %rdx\n    jmp __fern_memcpy\n");
}

function emit_buf_push_bytes_range(s: asmcore.EmitState, packed: boolean): asmcore.EmitState {
  let suffix = asmcore.packed_suffix(packed);
  let sym = "__fern_buf_push_bytes_range" + suffix;
  let label = ".Lbufbyterange" + suffix;
  s = s.write(".globl " + sym + "\n.type " + sym + ", @function\n" + sym + ":\n");
  if (packed) {
    return emit_buf_push_bytes_range_packed(s, sym, label);
  }
  s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n");
  s = s.write("    movq %rdi, %rbx\n    movq %rsi, %r14\n    movslq %edx, %r12\n    movslq %ecx, %r13\n");
  s = s.write("    xorq %rax, %rax\n    testq %r12, %r12\n    cmovsq %rax, %r12\n    cmpq (%r14), %r13\n    cmovgq (%r14), %r13\n");
  s = s.write("    subq %r12, %r13\n    jle " + label + "_done\n    movq 8(%rbx), %rsi\n    addq %r13, %rsi\n    cmpq 16(%rbx), %rsi\n    jbe " + label + "_fits\n    call __fern_buf_reserve\n" + label + "_fits:\n");
  s = s.write("    movq (%rbx), %rdi\n    addq 8(%rbx), %rdi\n");
  s = s.write("    leaq 8(%r14,%r12,8), %rsi\n    movq %r13, %rcx\n" + label + "_copy:\n    movb (%rsi), %al\n    movb %al, (%rdi)\n    addq $8, %rsi\n    incq %rdi\n    decq %rcx\n    jne " + label + "_copy\n");
  s = s.write("    addq %r13, 8(%rbx)\n" + label + "_done:\n    xorl %eax, %eax\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    popq %rbp\n    ret\n.size " + sym + ", .-" + sym + "\n");
  return s;
}

function emit_buf_push_bytes_range_packed(s: asmcore.EmitState, sym: string, label: string): asmcore.EmitState {
  s = s.write("    movslq %edx, %rdx\n    movslq %ecx, %rcx\n    xorl %eax, %eax\n    testq %rdx, %rdx\n    cmovsq %rax, %rdx\n");
  s = s.write("    movq (%rsi), %rax\n    cmpq %rax, %rcx\n    cmovgq %rax, %rcx\n    subq %rdx, %rcx\n    jle " + label + "_done\n");
  s = s.write("    movq 8(%rdi), %rax\n    leaq (%rax,%rcx), %r8\n    cmpq 16(%rdi), %r8\n    ja " + label + "_grow\n");
  s = s.write(label + "_copy:\n    movq %r8, 8(%rdi)\n    leaq 8(%rsi,%rdx), %rsi\n    movq (%rdi), %rdi\n    addq %rax, %rdi\n");
  s = buf_copy_tail(s, label);
  s = s.write(label + "_grow:\n    pushq %rdi\n    pushq %rsi\n    pushq %rdx\n    pushq %rcx\n    subq $8, %rsp\n    movq %r8, %rsi\n    call __fern_buf_reserve\n");
  s = s.write("    addq $8, %rsp\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %rdi\n    movq 8(%rdi), %rax\n    leaq (%rax,%rcx), %r8\n    jmp " + label + "_copy\n");
  return s.write(label + "_done:\n    ret\n.size " + sym + ", .-" + sym + "\n");
}

function emit_buf_take_bytes(s: asmcore.EmitState, packed: boolean): asmcore.EmitState {
  let suffix = asmcore.packed_suffix(packed);
  let sym = "__fern_buf_take_bytes" + suffix;
  let done = ".Lbufbytes_done" + suffix;
  let copy_loop = ".Lbufbytes_loop" + suffix;
  s = s.write(".globl " + sym + "\n.type " + sym + ", @function\n" + sym + ":\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %rbx\n");
  s = s.write("    pushq %r12\n");
  s = s.write("    pushq %r13\n");
  s = s.write("    pushq %r14\n");
  s = s.write("    movq %rdi, %rbx\n");
  s = s.write("    movq 8(%rbx), %r12\n");
  s = s.write("    movq %r12, %rdi\n");
  if (packed) {
    s = s.write("    addq $7, %rdi\n    shrq $3, %rdi\n");
  }
  s = s.write("    call __fern_arr_box\n    movq %rax, %r13\n    movq %r12, (%r13)\n    movq (%rbx), %rsi\n");
  if (packed) {
    s = s.write("    leaq 8(%r13), %rdi\n    movq %r12, %rdx\n    call __fern_memcpy\n");
  } else {
    s = s.write("    xorq %rcx, %rcx\n" + copy_loop + ":\n    cmpq %r12, %rcx\n    jae " + done + "\n");
    s = s.write("    movzbl (%rsi,%rcx), %eax\n    movq %rax, 8(%r13,%rcx,8)\n    incq %rcx\n    jmp " + copy_loop + "\n" + done + ":\n");
  }
  s = s.write("    movq $0, 8(%rbx)\n    movq %r13, %rax\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    popq %rbp\n    ret\n.size " + sym + ", .-" + sym + "\n");
  return s;
}

function emit_buf_mapped_avx2(s: asmcore.EmitState, lm: string): asmcore.EmitState {
  s = s.write("    leaq -32(%r13), %r8\n");
  s = s.write("    cmpq %r8, %rcx\n");
  s = s.write("    jg " + lm + "_full\n");
  s = s.write("    movl $16, %eax\n    movd %eax, %xmm4\n    vpbroadcastb %xmm4, %ymm4\n");
  s = s.write("    movl $112, %eax\n    movd %eax, %xmm5\n    vpbroadcastb %xmm5, %ymm5\n");
  s = s.write(lm + "_vec:\n");
  s = s.write("    vmovdqu (%rsi,%rcx), %ymm0\n");
  s = s.write("    vbroadcasti128 8(%r14), %ymm2\n");
  s = s.write("    vpaddusb %ymm5, %ymm0, %ymm3\n");
  s = s.write("    vpshufb %ymm3, %ymm2, %ymm1\n");
  for h in 1..16 {
    s = s.write("    vpsubb %ymm4, %ymm0, %ymm0\n");
    s = s.write("    vbroadcasti128 " + util.i32_to_string(8 + h * 16) + "(%r14), %ymm2\n");
    s = s.write("    vpaddusb %ymm5, %ymm0, %ymm3\n");
    s = s.write("    vpshufb %ymm3, %ymm2, %ymm2\n");
    s = s.write("    vpor %ymm2, %ymm1, %ymm1\n");
  }
  s = s.write("    vmovdqu %ymm1, (%rdx,%rcx)\n");
  s = s.write("    addq $32, %rcx\n");
  s = s.write("    cmpq %r8, %rcx\n");
  s = s.write("    jle " + lm + "_vec\n");
  s = s.write("    vzeroupper\n");
  s = s.write("    cmpq %r13, %rcx\n");
  return s.write("    jae " + lm + "_len\n");
}

// __fern_buf_push_base64(h, src, lo, hi, alpha) appends four characters of
// the 64-byte alphabet for each whole group of three bytes in src[lo..hi). A
// round loads 32 bytes at src - 4, so 24 input bytes sit in the two lanes as
// the shuffle expects, and the multiplies take the 6-bit fields apart. Four
// table lookups map the fields to the alphabet. A tail encodes one group at
// a time.
function emit_buf_push_base64(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_buf_push_base64:\n");
  s = s.write("    movslq %edx, %rdx\n    movslq %ecx, %rcx\n    xorl %eax, %eax\n    testq %rdx, %rdx\n    cmovsq %rax, %rdx\n");
  s = s.write("    movq (%rsi), %rax\n    cmpq %rax, %rcx\n    cmovgq %rax, %rcx\n    subq %rdx, %rcx\n    jle .Lb64_done\n");
  s = s.write("    movl %ecx, %eax\n    movl $2863311531, %r9d\n    imulq %r9, %rax\n    shrq $33, %rax\n    testq %rax, %rax\n    jz .Lb64_done\n");
  s = s.write("    cmpq $64, (%r8)\n    jb __fern_oob_abort\n");
  s = s.write("    leaq (%rax,%rax,2), %r10\n    shlq $2, %rax\n    movq 8(%rdi), %r11\n    leaq (%r11,%rax), %r9\n    cmpq 16(%rdi), %r9\n    ja .Lb64_grow\n");
  s = s.write(".Lb64_fits:\n    movq %r9, 8(%rdi)\n    movq (%rdi), %rdi\n    addq %r11, %rdi\n    leaq 8(%rsi,%rdx), %rsi\n");
  s = s.write("    cmpq $28, %r10\n    jb .Lb64_tail\n");
  s = s.write("    vbroadcasti128 8(%r8), %ymm8\n    vbroadcasti128 24(%r8), %ymm9\n    vbroadcasti128 40(%r8), %ymm10\n    vbroadcasti128 56(%r8), %ymm11\n");
  s = s.write("    vmovdqu .Lb64_shuffle(%rip), %ymm12\n");
  s = s.write("    movl $264305664, %eax\n    movd %eax, %xmm13\n    vpbroadcastd %xmm13, %ymm13\n");
  s = s.write("    movl $67108928, %eax\n    movd %eax, %xmm14\n    vpbroadcastd %xmm14, %ymm14\n");
  s = s.write("    movl $4129776, %eax\n    movd %eax, %xmm15\n    vpbroadcastd %xmm15, %ymm15\n");
  s = s.write("    movl $16777232, %eax\n    movd %eax, %xmm7\n    vpbroadcastd %xmm7, %ymm7\n");
  s = s.write("    movl $16, %eax\n    movd %eax, %xmm6\n    vpbroadcastb %xmm6, %ymm6\n");
  s = s.write("    movl $112, %eax\n    movd %eax, %xmm5\n    vpbroadcastb %xmm5, %ymm5\n");
  s = s.write(".Lb64_vec:\n    vmovdqu -4(%rsi), %ymm0\n    vpshufb %ymm12, %ymm0, %ymm0\n");
  s = s.write("    vpand %ymm13, %ymm0, %ymm1\n    vpmulhuw %ymm14, %ymm1, %ymm1\n    vpand %ymm15, %ymm0, %ymm2\n    vpmullw %ymm7, %ymm2, %ymm2\n    vpor %ymm2, %ymm1, %ymm0\n");
  s = s.write("    vpaddusb %ymm5, %ymm0, %ymm1\n    vpshufb %ymm1, %ymm8, %ymm3\n");
  s = s.write("    vpsubb %ymm6, %ymm0, %ymm0\n    vpaddusb %ymm5, %ymm0, %ymm1\n    vpshufb %ymm1, %ymm9, %ymm4\n    vpor %ymm4, %ymm3, %ymm3\n");
  s = s.write("    vpsubb %ymm6, %ymm0, %ymm0\n    vpaddusb %ymm5, %ymm0, %ymm1\n    vpshufb %ymm1, %ymm10, %ymm4\n    vpor %ymm4, %ymm3, %ymm3\n");
  s = s.write("    vpsubb %ymm6, %ymm0, %ymm0\n    vpaddusb %ymm5, %ymm0, %ymm1\n    vpshufb %ymm1, %ymm11, %ymm4\n    vpor %ymm4, %ymm3, %ymm3\n");
  s = s.write("    vmovdqu %ymm3, (%rdi)\n    addq $24, %rsi\n    addq $32, %rdi\n    subq $24, %r10\n    cmpq $28, %r10\n    jae .Lb64_vec\n    vzeroupper\n");
  s = s.write(".Lb64_tail:\n    testq %r10, %r10\n    jz .Lb64_done\n");
  s = s.write(".Lb64_one:\n    movzbl (%rsi), %eax\n    movzbl 1(%rsi), %ecx\n    movzbl 2(%rsi), %edx\n    shll $16, %eax\n    shll $8, %ecx\n    orl %ecx, %eax\n    orl %edx, %eax\n");
  s = s.write("    movl %eax, %ecx\n    shrl $18, %ecx\n    movzbl 8(%r8,%rcx), %ecx\n    movb %cl, (%rdi)\n");
  s = s.write("    movl %eax, %ecx\n    shrl $12, %ecx\n    andl $63, %ecx\n    movzbl 8(%r8,%rcx), %ecx\n    movb %cl, 1(%rdi)\n");
  s = s.write("    movl %eax, %ecx\n    shrl $6, %ecx\n    andl $63, %ecx\n    movzbl 8(%r8,%rcx), %ecx\n    movb %cl, 2(%rdi)\n");
  s = s.write("    andl $63, %eax\n    movzbl 8(%r8,%rax), %eax\n    movb %al, 3(%rdi)\n");
  s = s.write("    addq $3, %rsi\n    addq $4, %rdi\n    subq $3, %r10\n    jnz .Lb64_one\n");
  s = s.write(".Lb64_done:\n    xorl %eax, %eax\n    ret\n");
  s = s.write(".Lb64_grow:\n    pushq %rdi\n    pushq %rsi\n    pushq %rdx\n    pushq %r8\n    pushq %r10\n    pushq %rax\n    subq $8, %rsp\n    movq %r9, %rsi\n    call __fern_buf_reserve\n");
  s = s.write("    addq $8, %rsp\n    popq %rax\n    popq %r10\n    popq %r8\n    popq %rdx\n    popq %rsi\n    popq %rdi\n    movq 8(%rdi), %r11\n    leaq (%r11,%rax), %r9\n    jmp .Lb64_fits\n");
  s = s.write("    .section .rodata\n.Lb64_shuffle:\n");
  s = s.write("    .byte 5, 4, 6, 5, 8, 7, 9, 8, 11, 10, 12, 11, 14, 13, 15, 14\n");
  s = s.write("    .byte 1, 0, 2, 1, 4, 3, 5, 4, 7, 6, 8, 7, 10, 9, 11, 10\n");
  return s.write("    .section .text\n");
}

// Each pass reads four groups of five bytes as two 32-byte loads, so each
// 128-bit lane holds one group. A load may pass hi but not the array's end. vpshufb puts the two bytes under each 5-bit
// field in a word, and vpmulhuw shifts each word right by its own amount.
function emit_buf_push_base32(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_buf_push_base32:\n");
  s = s.write("    movslq %edx, %rdx\n    movslq %ecx, %rcx\n    xorl %eax, %eax\n    testq %rdx, %rdx\n    cmovsq %rax, %rdx\n");
  s = s.write("    movq (%rsi), %rax\n    cmpq %rax, %rcx\n    cmovgq %rax, %rcx\n    subq %rdx, %rcx\n    jle .Lb32_done\n");
  s = s.write("    movl %ecx, %eax\n    movl $3435973837, %r9d\n    imulq %r9, %rax\n    shrq $34, %rax\n    testq %rax, %rax\n    jz .Lb32_done\n");
  s = s.write("    cmpq $32, (%r8)\n    jb __fern_oob_abort\n");
  s = s.write("    leaq (%rax,%rax,4), %r10\n    shlq $3, %rax\n    movq 8(%rdi), %r11\n    leaq (%r11,%rax), %r9\n    cmpq 16(%rdi), %r9\n    ja .Lb32_grow\n");
  s = s.write(".Lb32_fits:\n    movq %r9, 8(%rdi)\n    movq (%rdi), %rdi\n    addq %r11, %rdi\n    movq (%rsi), %rcx\n    leaq -23(%rsi,%rcx), %rcx\n    leaq 8(%rsi,%rdx), %rsi\n");
  s = s.write("    cmpq $20, %r10\n    jb .Lb32_tail\n    cmpq %rcx, %rsi\n    ja .Lb32_tail\n");
  s = s.write("    vbroadcasti128 8(%r8), %ymm8\n    vbroadcasti128 24(%r8), %ymm9\n");
  s = s.write("    vmovdqu .Lb32_shuffle(%rip), %ymm12\n    vmovdqu .Lb32_shift(%rip), %ymm13\n");
  s = s.write("    movl $2031647, %eax\n    movd %eax, %xmm14\n    vpbroadcastd %xmm14, %ymm14\n");
  s = s.write("    movl $16, %eax\n    movd %eax, %xmm6\n    vpbroadcastb %xmm6, %ymm6\n");
  s = s.write("    movl $112, %eax\n    movd %eax, %xmm5\n    vpbroadcastb %xmm5, %ymm5\n");
  s = s.write(".Lb32_vec:\n    vmovdqu -6(%rsi), %ymm0\n    vmovdqu -1(%rsi), %ymm1\n");
  s = s.write("    vpshufb %ymm12, %ymm0, %ymm0\n    vpshufb %ymm12, %ymm1, %ymm1\n");
  s = s.write("    vpmulhuw %ymm13, %ymm0, %ymm0\n    vpmulhuw %ymm13, %ymm1, %ymm1\n");
  s = s.write("    vpand %ymm14, %ymm0, %ymm0\n    vpand %ymm14, %ymm1, %ymm1\n    vpackuswb %ymm1, %ymm0, %ymm0\n");
  s = s.write("    vpaddusb %ymm5, %ymm0, %ymm1\n    vpshufb %ymm1, %ymm8, %ymm3\n");
  s = s.write("    vpsubb %ymm6, %ymm0, %ymm0\n    vpaddusb %ymm5, %ymm0, %ymm1\n    vpshufb %ymm1, %ymm9, %ymm4\n    vpor %ymm4, %ymm3, %ymm3\n");
  s = s.write("    vmovdqu %ymm3, (%rdi)\n    addq $20, %rsi\n    addq $32, %rdi\n    subq $20, %r10\n    cmpq $20, %r10\n    jb .Lb32_vec_end\n    cmpq %rcx, %rsi\n    jbe .Lb32_vec\n.Lb32_vec_end:\n    vzeroupper\n");
  s = s.write(".Lb32_tail:\n    testq %r10, %r10\n    jz .Lb32_done\n");
  s = s.write(".Lb32_one:\n    movzbl (%rsi), %eax\n    shlq $32, %rax\n    movzbl 1(%rsi), %ecx\n    shll $24, %ecx\n    orq %rcx, %rax\n");
  s = s.write("    movzbl 2(%rsi), %ecx\n    shll $16, %ecx\n    orq %rcx, %rax\n    movzbl 3(%rsi), %ecx\n    shll $8, %ecx\n    orq %rcx, %rax\n    movzbl 4(%rsi), %ecx\n    orq %rcx, %rax\n");
  for k in 0..8 {
    let shift = 35 - k * 5;
    s = s.write("    movq %rax, %rcx\n    shrq $" + util.i32_to_string(shift) + ", %rcx\n    andl $31, %ecx\n    movzbl 8(%r8,%rcx), %ecx\n    movb %cl, " + util.i32_to_string(k) + "(%rdi)\n");
  }
  s = s.write("    addq $5, %rsi\n    addq $8, %rdi\n    subq $5, %r10\n    jnz .Lb32_one\n");
  s = s.write(".Lb32_done:\n    xorl %eax, %eax\n    ret\n");
  s = s.write(".Lb32_grow:\n    pushq %rdi\n    pushq %rsi\n    pushq %rdx\n    pushq %r8\n    pushq %r10\n    pushq %rax\n    subq $8, %rsp\n    movq %r9, %rsi\n    call __fern_buf_reserve\n");
  s = s.write("    addq $8, %rsp\n    popq %rax\n    popq %r10\n    popq %r8\n    popq %rdx\n    popq %rsi\n    popq %rdi\n    movq 8(%rdi), %r11\n    leaq (%r11,%rax), %r9\n    jmp .Lb32_fits\n");
  s = s.write("    .section .rodata\n.Lb32_shuffle:\n");
  s = s.write("    .byte 7, 6, 7, 6, 8, 7, 8, 7, 9, 8, 10, 9, 10, 9, 128, 10\n");
  s = s.write("    .byte 1, 0, 1, 0, 2, 1, 2, 1, 3, 2, 4, 3, 4, 3, 128, 4\n");
  s = s.write(".Lb32_shift:\n");
  s = s.write("    .byte 32, 0, 0, 4, 128, 0, 0, 16, 0, 2, 64, 0, 0, 8, 0, 1\n");
  s = s.write("    .byte 32, 0, 0, 4, 128, 0, 0, 16, 0, 2, 64, 0, 0, 8, 0, 1\n");
  return s.write("    .section .text\n");
}

// Each pass checks 16 characters against the two ranges and packs them to 10
// bytes: vpmaddubsw and vpmaddwd join 5-bit values into 20-bit dwords, and two
// shifts join each pair of those. A store writes 16 bytes, so the reserve
// keeps 16 bytes past the decoded length.
function emit_buf_decode_base32(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_buf_decode_base32:\n");
  s = s.write("    movslq %edx, %rdx\n    movslq %ecx, %rcx\n    xorl %eax, %eax\n    testq %rdx, %rdx\n    cmovsq %rax, %rdx\n");
  s = s.write("    movq (%rsi), %rax\n    cmpq %rax, %rcx\n    cmovgq %rax, %rcx\n    movq %rcx, %r10\n    subq %rdx, %r10\n    cmpq $8, %r10\n    jl .Ld32_none\n");
  s = s.write("    cmpq $4, (%r8)\n    jb __fern_oob_abort\n");
  s = s.write("    movq %r10, %rax\n    shrq $3, %rax\n    leaq 16(%rax,%rax,4), %rax\n    movq 8(%rdi), %r11\n    leaq (%r11,%rax), %r9\n    cmpq 16(%rdi), %r9\n    ja .Ld32_grow\n");
  s = s.write(".Ld32_fits:\n    pushq %rdi\n    movq (%rdi), %rdi\n    addq %r11, %rdi\n    leaq 8(%rsi), %rax\n    leaq (%rax,%rdx), %rsi\n    movq %rax, %rdx\n    andq $-8, %r10\n");
  s = s.write("    cmpq $16, %r10\n    jb .Ld32_group\n");
  s = s.write("    movzbl 8(%r8), %eax\n    movd %eax, %xmm8\n    vpbroadcastb %xmm8, %xmm8\n");
  s = s.write("    movzbl 9(%r8), %eax\n    subl $1, %eax\n    movd %eax, %xmm9\n    vpbroadcastb %xmm9, %xmm9\n");
  s = s.write("    movzbl 10(%r8), %eax\n    movd %eax, %xmm10\n    vpbroadcastb %xmm10, %xmm10\n");
  s = s.write("    movzbl 11(%r8), %eax\n    subl $1, %eax\n    movd %eax, %xmm11\n    vpbroadcastb %xmm11, %xmm11\n");
  s = s.write("    movzbl 9(%r8), %ecx\n    xorl %eax, %eax\n    subl %ecx, %eax\n    movd %eax, %xmm12\n    vpbroadcastb %xmm12, %xmm12\n");
  s = s.write("    vmovdqu .Ld32_join(%rip), %xmm13\n    vmovdqu .Ld32_join2(%rip), %xmm14\n    vmovdqu .Ld32_order(%rip), %xmm15\n");
  s = s.write(".Ld32_vec:\n    vmovdqu (%rsi), %xmm0\n");
  s = s.write("    vpsubb %xmm8, %xmm0, %xmm1\n    vpminub %xmm9, %xmm1, %xmm2\n    vpcmpeqb %xmm2, %xmm1, %xmm2\n");
  s = s.write("    vpsubb %xmm10, %xmm0, %xmm3\n    vpminub %xmm11, %xmm3, %xmm4\n    vpcmpeqb %xmm4, %xmm3, %xmm4\n    vpsubb %xmm12, %xmm3, %xmm3\n");
  s = s.write("    vpand %xmm2, %xmm1, %xmm1\n    vpand %xmm4, %xmm3, %xmm3\n    vpor %xmm3, %xmm1, %xmm1\n    vpor %xmm4, %xmm2, %xmm2\n");
  s = s.write("    vpmovmskb %xmm2, %eax\n    cmpl $65535, %eax\n    jne .Ld32_group\n");
  s = s.write("    vpmaddubsw %xmm13, %xmm1, %xmm1\n    vpmaddwd %xmm14, %xmm1, %xmm1\n");
  s = s.write("    vpsllq $44, %xmm1, %xmm2\n    vpsrlq $24, %xmm2, %xmm2\n    vpsrlq $32, %xmm1, %xmm1\n    vpor %xmm2, %xmm1, %xmm1\n");
  s = s.write("    vpshufb %xmm15, %xmm1, %xmm1\n    vmovdqu %xmm1, (%rdi)\n");
  s = s.write("    addq $16, %rsi\n    addq $10, %rdi\n    subq $16, %r10\n    cmpq $16, %r10\n    jae .Ld32_vec\n");
  s = s.write(".Ld32_group:\n    cmpq $8, %r10\n    jb .Ld32_stop\n    xorl %eax, %eax\n    xorl %ecx, %ecx\n");
  s = s.write(".Ld32_char:\n    movzbl (%rsi,%rcx), %r9d\n    movzbl 8(%r8), %r11d\n    subl %r11d, %r9d\n    movzbl 9(%r8), %r11d\n    cmpl %r11d, %r9d\n    jb .Ld32_val\n");
  s = s.write("    movzbl (%rsi,%rcx), %r9d\n    movzbl 10(%r8), %r11d\n    subl %r11d, %r9d\n    movzbl 11(%r8), %r11d\n    cmpl %r11d, %r9d\n    jae .Ld32_stop\n    movzbl 9(%r8), %r11d\n    addl %r11d, %r9d\n");
  s = s.write(".Ld32_val:\n    shlq $5, %rax\n    orq %r9, %rax\n    addq $1, %rcx\n    cmpq $8, %rcx\n    jb .Ld32_char\n");
  s = s.write("    shlq $24, %rax\n    bswapq %rax\n    movq %rax, (%rdi)\n    addq $5, %rdi\n    addq $8, %rsi\n    subq $8, %r10\n    jmp .Ld32_group\n");
  s = s.write(".Ld32_stop:\n    popq %rcx\n    subq (%rcx), %rdi\n    movq %rdi, 8(%rcx)\n    movq %rsi, %rax\n    subq %rdx, %rax\n    ret\n");
  s = s.write(".Ld32_none:\n    movq %rdx, %rax\n    ret\n");
  s = s.write(".Ld32_grow:\n    pushq %rdi\n    pushq %rsi\n    pushq %rdx\n    pushq %r8\n    pushq %r10\n    movq %r9, %rsi\n    call __fern_buf_reserve\n");
  s = s.write("    popq %r10\n    popq %r8\n    popq %rdx\n    popq %rsi\n    popq %rdi\n    movq 8(%rdi), %r11\n    jmp .Ld32_fits\n");
  s = s.write("    .section .rodata\n.Ld32_join:\n    .byte 32, 1, 32, 1, 32, 1, 32, 1, 32, 1, 32, 1, 32, 1, 32, 1\n");
  s = s.write(".Ld32_join2:\n    .byte 0, 4, 1, 0, 0, 4, 1, 0, 0, 4, 1, 0, 0, 4, 1, 0\n");
  s = s.write(".Ld32_order:\n    .byte 4, 3, 2, 1, 0, 12, 11, 10, 9, 8, 128, 128, 128, 128, 128, 128\n");
  return s.write("    .section .text\n");
}

// __fern_buf_push_decimal(h, n) appends the decimal digits of the u64 n. It
// writes them back to front into a stack scratch, two at a time from a table
// of digit pairs, and divides by 100 with a multiply.
function emit_buf_push_decimal(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_buf_push_decimal:\n");
  s = s.write("    subq $40, %rsp\n");
  s = s.write("    leaq 32(%rsp), %r8\n");
  s = s.write("    movq %rsi, %rax\n");
  s = s.write("    leaq .Ldecimal_pairs(%rip), %r11\n");
  s = s.write("    movabsq $2951479051793528259, %r10\n");
  s = s.write(".Ldecimal_loop:\n");
  s = s.write("    cmpq $100, %rax\n");
  s = s.write("    jb .Ldecimal_tail\n");
  s = s.write("    movq %rax, %r9\n");
  s = s.write("    shrq $2, %rax\n");
  s = s.write("    mulq %r10\n");
  s = s.write("    shrq $2, %rdx\n");
  s = s.write("    imulq $100, %rdx, %rax\n");
  s = s.write("    subq %rax, %r9\n");
  s = s.write("    movzwl (%r11,%r9,2), %eax\n");
  s = s.write("    subq $2, %r8\n");
  s = s.write("    movw %ax, (%r8)\n");
  s = s.write("    movq %rdx, %rax\n");
  s = s.write("    jmp .Ldecimal_loop\n");
  s = s.write(".Ldecimal_tail:\n");
  s = s.write("    cmpq $10, %rax\n");
  s = s.write("    jb .Ldecimal_one\n");
  s = s.write("    movzwl (%r11,%rax,2), %eax\n");
  s = s.write("    subq $2, %r8\n");
  s = s.write("    movw %ax, (%r8)\n");
  s = s.write("    jmp .Ldecimal_copy\n");
  s = s.write(".Ldecimal_one:\n");
  s = s.write("    addl $48, %eax\n");
  s = s.write("    subq $1, %r8\n");
  s = s.write("    movb %al, (%r8)\n");
  s = s.write(".Ldecimal_copy:\n");
  s = s.write("    leaq 32(%rsp), %rcx\n");
  s = s.write("    subq %r8, %rcx\n");
  s = s.write("    movq 8(%rdi), %rax\n");
  s = s.write("    leaq (%rax,%rcx), %r9\n");
  s = s.write("    cmpq 16(%rdi), %r9\n");
  s = s.write("    ja .Ldecimal_grow\n");
  s = s.write(".Ldecimal_fits:\n");
  s = s.write("    movq %r9, 8(%rdi)\n");
  s = s.write("    movq (%rdi), %rdx\n");
  s = s.write("    addq %rax, %rdx\n");
  s = s.write("    cmpq $8, %rcx\n");
  s = s.write("    jae .Ldecimal_c8\n");
  s = s.write("    cmpq $4, %rcx\n");
  s = s.write("    jae .Ldecimal_c4\n");
  s = s.write("    cmpq $2, %rcx\n");
  s = s.write("    jae .Ldecimal_c2\n");
  s = s.write("    movzbl (%r8), %eax\n");
  s = s.write("    movb %al, (%rdx)\n");
  s = s.write("    addq $40, %rsp\n");
  s = s.write("    ret\n");
  s = s.write(".Ldecimal_c2:\n");
  s = s.write("    movzwl (%r8), %eax\n");
  s = s.write("    movzwl -2(%r8,%rcx), %r9d\n");
  s = s.write("    movw %ax, (%rdx)\n");
  s = s.write("    movw %r9w, -2(%rdx,%rcx)\n");
  s = s.write("    addq $40, %rsp\n");
  s = s.write("    ret\n");
  s = s.write(".Ldecimal_c4:\n");
  s = s.write("    movl (%r8), %eax\n");
  s = s.write("    movl -4(%r8,%rcx), %r9d\n");
  s = s.write("    movl %eax, (%rdx)\n");
  s = s.write("    movl %r9d, -4(%rdx,%rcx)\n");
  s = s.write("    addq $40, %rsp\n");
  s = s.write("    ret\n");
  s = s.write(".Ldecimal_c8:\n");
  s = s.write("    movq (%r8), %rax\n");
  s = s.write("    movq 8(%r8), %r10\n");
  s = s.write("    movq -8(%r8,%rcx), %r9\n");
  s = s.write("    movq %rax, (%rdx)\n");
  s = s.write("    cmpq $16, %rcx\n");
  s = s.write("    jbe .Ldecimal_c8_tail\n");
  s = s.write("    movq %r10, 8(%rdx)\n");
  s = s.write(".Ldecimal_c8_tail:\n");
  s = s.write("    movq %r9, -8(%rdx,%rcx)\n");
  s = s.write("    addq $40, %rsp\n");
  s = s.write("    ret\n");
  s = s.write(".Ldecimal_grow:\n");
  s = s.write("    pushq %rdi\n");
  s = s.write("    pushq %rcx\n");
  s = s.write("    pushq %r8\n");
  s = s.write("    subq $8, %rsp\n");
  s = s.write("    movq %r9, %rsi\n");
  s = s.write("    call __fern_buf_reserve\n");
  s = s.write("    addq $8, %rsp\n");
  s = s.write("    popq %r8\n");
  s = s.write("    popq %rcx\n");
  s = s.write("    popq %rdi\n");
  s = s.write("    movq 8(%rdi), %rax\n");
  s = s.write("    leaq (%rax,%rcx), %r9\n");
  s = s.write("    jmp .Ldecimal_fits\n");
  s = s.write("    .section .rodata\n");
  s = s.write(".Ldecimal_pairs:\n");
  s = s.write("    .ascii \"" + asmcore.decimal_pairs() + "\"\n");
  return s.write("    .section .text\n");
}

function emit_buf_table_helpers(s: asmcore.EmitState, raw: boolean): asmcore.EmitState {
  let prefix = "__fern_buf_push_";
  let label = "";
  if (raw) {
    prefix += "bytes_";
    label = "_bytes";
  }
  let source_len = "    movq 8(%r12), %r13\n";
  let source_data = "    movq (%r12), %rsi\n";
  if (raw) {
    source_len = "    movq (%r12), %r13\n";
    source_data = "    leaq 8(%r12), %rsi\n";
  }
  let lm = ".Lbufmap" + label;
  let lf = ".Lbuffilt" + label;
  let le = ".Lbufexp" + label;
  s = s.write(prefix + "mapped:\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %rbx\n");
  s = s.write("    pushq %r12\n");
  s = s.write("    pushq %r13\n");
  s = s.write("    pushq %r14\n");
  s = s.write("    movq %rdi, %rbx\n");
  s = s.write("    movq %rsi, %r12\n");
  s = s.write("    movq %rdx, %r14\n");
  s = s.write(source_len);
  s = s.write("    testq %r13, %r13\n");
  s = s.write("    jz " + lm + "_done\n");
  s = s.write("    movq 8(%rbx), %rax\n");
  s = s.write("    addq %r13, %rax\n");
  s = s.write("    movq 16(%rbx), %rcx\n");
  s = s.write("    cmpq %rcx, %rax\n");
  s = s.write("    jbe " + lm + "_fits\n");
  s = s.write("    movq %rbx, %rdi\n");
  s = s.write("    movq %rax, %rsi\n");
  s = s.write("    call __fern_buf_reserve\n");
  s = s.write(lm + "_fits:\n");
  s = s.write(source_data);
  s = s.write("    movq (%rbx), %rdx\n");
  s = s.write("    addq 8(%rbx), %rdx\n");
  s = s.write("    movq (%r14), %r9\n");
  s = s.write("    xorq %rcx, %rcx\n");
  s = s.write("    cmpq $256, %r9\n");
  s = s.write("    jb " + lm + "_short\n");
  s = emit_buf_mapped_avx2(s, lm);
  s = s.write(lm + "_full:\n");
  s = s.write("    movzbq (%rsi,%rcx), %rax\n");
  s = s.write("    movzbq 8(%r14,%rax), %rax\n");
  s = s.write("    movb %al, (%rdx,%rcx)\n");
  s = s.write("    incq %rcx\n");
  s = s.write("    cmpq %r13, %rcx\n");
  s = s.write("    jb " + lm + "_full\n");
  s = s.write("    jmp " + lm + "_len\n");
  s = s.write(lm + "_short:\n");
  s = s.write("    movzbq (%rsi,%rcx), %rax\n");
  s = s.write("    cmpq %r9, %rax\n");
  s = s.write("    jae " + lm + "_keep\n");
  s = s.write("    movzbq 8(%r14,%rax), %rax\n");
  s = s.write(lm + "_keep:\n");
  s = s.write("    movb %al, (%rdx,%rcx)\n");
  s = s.write("    incq %rcx\n");
  s = s.write("    cmpq %r13, %rcx\n");
  s = s.write("    jb " + lm + "_short\n");
  s = s.write(lm + "_len:\n");
  s = s.write("    addq %r13, 8(%rbx)\n");
  s = s.write(lm + "_done:\n");
  s = s.write("    popq %r14\n");
  s = s.write("    popq %r13\n");
  s = s.write("    popq %r12\n");
  s = s.write("    popq %rbx\n");
  s = s.write("    popq %rbp\n");
  s = s.write("    ret\n");
  s = s.write(prefix + "filtered:\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %rbx\n");
  s = s.write("    pushq %r12\n");
  s = s.write("    pushq %r13\n");
  s = s.write("    pushq %r14\n");
  s = s.write("    movq %rdi, %rbx\n");
  s = s.write("    movq %rsi, %r12\n");
  s = s.write("    movq %rdx, %r14\n");
  s = s.write(source_len);
  s = s.write("    testq %r13, %r13\n");
  s = s.write("    jz " + lf + "_done\n");
  s = s.write("    movq 8(%rbx), %rax\n");
  s = s.write("    addq %r13, %rax\n");
  s = s.write("    movq 16(%rbx), %rcx\n");
  s = s.write("    cmpq %rcx, %rax\n");
  s = s.write("    jbe " + lf + "_fits\n");
  s = s.write("    movq %rbx, %rdi\n");
  s = s.write("    movq %rax, %rsi\n");
  s = s.write("    call __fern_buf_reserve\n");
  s = s.write(lf + "_fits:\n");
  s = s.write(source_data);
  s = s.write("    movq (%rbx), %rdx\n");
  s = s.write("    addq 8(%rbx), %rdx\n");
  s = s.write("    movq (%r14), %r9\n");
  s = s.write("    xorq %rcx, %rcx\n");
  s = s.write("    xorq %r8, %r8\n");
  s = s.write("    cmpq $256, %r9\n");
  s = s.write("    jb " + lf + "_short\n");
  s = s.write(lf + "_full:\n");
  s = s.write("    movzbq (%rsi,%rcx), %rax\n");
  s = s.write("    movzbq 8(%r14,%rax), %r10\n");
  s = s.write("    movb %al, (%rdx,%r8)\n");
  s = s.write("    cmpq $1, %r10\n");
  s = s.write("    adcq $0, %r8\n");
  s = s.write("    incq %rcx\n");
  s = s.write("    cmpq %r13, %rcx\n");
  s = s.write("    jb " + lf + "_full\n");
  s = s.write("    jmp " + lf + "_len\n");
  s = s.write(lf + "_short:\n");
  s = s.write("    movzbq (%rsi,%rcx), %rax\n");
  s = s.write("    cmpq %r9, %rax\n");
  s = s.write("    jae " + lf + "_keep\n");
  s = s.write("    cmpb $0, 8(%r14,%rax)\n");
  s = s.write("    jne " + lf + "_next\n");
  s = s.write(lf + "_keep:\n");
  s = s.write("    movb %al, (%rdx,%r8)\n");
  s = s.write("    incq %r8\n");
  s = s.write(lf + "_next:\n");
  s = s.write("    incq %rcx\n");
  s = s.write("    cmpq %r13, %rcx\n");
  s = s.write("    jb " + lf + "_short\n");
  s = s.write(lf + "_len:\n");
  s = s.write("    addq %r8, 8(%rbx)\n");
  s = s.write(lf + "_done:\n");
  s = s.write("    popq %r14\n");
  s = s.write("    popq %r13\n");
  s = s.write("    popq %r12\n");
  s = s.write("    popq %rbx\n");
  s = s.write("    popq %rbp\n");
  s = s.write("    ret\n");
  s = s.write(prefix + "expanded:\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %rbx\n");
  s = s.write("    pushq %r12\n");
  s = s.write("    pushq %r13\n");
  s = s.write("    pushq %r14\n");
  s = s.write("    movq %rdi, %rbx\n");
  s = s.write("    movq %rsi, %r12\n");
  s = s.write("    movq %rdx, %r14\n");
  s = s.write(source_len);
  s = s.write("    testq %r13, %r13\n");
  s = s.write("    jz " + le + "_done\n");
  s = s.write("    leaq 8(,%r13,8), %rax\n");
  s = s.write("    addq 8(%rbx), %rax\n");
  s = s.write("    movq 16(%rbx), %rcx\n");
  s = s.write("    cmpq %rcx, %rax\n");
  s = s.write("    jbe " + le + "_fits\n");
  s = s.write("    movq %rbx, %rdi\n");
  s = s.write("    movq %rax, %rsi\n");
  s = s.write("    call __fern_buf_reserve\n");
  s = s.write(le + "_fits:\n");
  s = s.write(source_data);
  s = s.write("    movq (%rbx), %rdx\n");
  s = s.write("    addq 8(%rbx), %rdx\n");
  s = s.write("    movq (%r14), %r9\n");
  s = s.write("    shrq $3, %r9\n");
  s = s.write("    xorq %rcx, %rcx\n");
  s = s.write("    cmpq $256, %r9\n    jb " + le + "_loop\n");
  s = s.write("    cmpq $256, %r13\n    jb " + le + "_loop\n");
  s = s.write("    subq $2048, %rsp\n");
  s = s.write(le + "_pack:\n");
  // A row is stored as one u64, so the 8-byte row load in the fast loop takes it from the store buffer.
  s = s.write("    movq 8(%r14,%rcx,8), %rax\n    movq %rax, (%rsp,%rcx,8)\n    incq %rcx\n    cmpq $256, %rcx\n    jb " + le + "_pack\n");
  s = s.write("    xorq %rcx, %rcx\n    movq $7, %r10\n");
  s = s.write(le + "_fast:\n");
  s = s.write("    movzbq (%rsi,%rcx), %rax\n    movq (%rsp,%rax,8), %r8\n");
  s = s.write("    movzbq %r8b, %r9\n    cmpq %r10, %r9\n    cmovaq %r10, %r9\n");
  s = s.write("    shrq $8, %r8\n    movq %r8, (%rdx)\n    addq %r9, %rdx\n");
  s = s.write("    incq %rcx\n    cmpq %r13, %rcx\n    jb " + le + "_fast\n");
  s = s.write("    addq $2048, %rsp\n    jmp " + le + "_len\n");
  s = s.write(le + "_loop:\n");
  s = s.write("    cmpq %r13, %rcx\n");
  s = s.write("    jae " + le + "_len\n");
  s = s.write("    movzbq (%rsi,%rcx), %rax\n");
  s = s.write("    cmpq %r9, %rax\n");
  s = s.write("    jae " + le + "_keep\n");
  s = s.write("    movq %rax, %r10\n");
  s = s.write("    shlq $3, %r10\n");
  s = s.write("    addq %r14, %r10\n");
  s = s.write("    movzbq 8(%r10), %r11\n");
  s = s.write("    cmpq $7, %r11\n");
  s = s.write("    jbe " + le + "_room\n");
  s = s.write("    movq $7, %r11\n");
  s = s.write(le + "_room:\n");
  s = s.write("    xorq %r8, %r8\n");
  s = s.write(le + "_byte:\n");
  s = s.write("    cmpq %r11, %r8\n");
  s = s.write("    jae " + le + "_next\n");
  s = s.write("    movzbq 9(%r10,%r8), %rax\n");
  s = s.write("    movb %al, (%rdx)\n");
  s = s.write("    incq %rdx\n");
  s = s.write("    incq %r8\n");
  s = s.write("    jmp " + le + "_byte\n");
  s = s.write(le + "_keep:\n");
  s = s.write("    movb %al, (%rdx)\n");
  s = s.write("    incq %rdx\n");
  s = s.write(le + "_next:\n");
  s = s.write("    incq %rcx\n");
  s = s.write("    jmp " + le + "_loop\n");
  s = s.write(le + "_len:\n");
  s = s.write("    subq (%rbx), %rdx\n");
  s = s.write("    movq %rdx, 8(%rbx)\n");
  s = s.write(le + "_done:\n");
  s = s.write("    popq %r14\n");
  s = s.write("    popq %r13\n");
  s = s.write("    popq %r12\n");
  s = s.write("    popq %rbx\n");
  s = s.write("    popq %rbp\n");
  s = s.write("    ret\n");
  return s;
}

function emit_runtime_memcpy(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_memcpy:\n");
  s = s.write("    movq %rdi, %rax\n");
  s = s.write("    cmpq $8, %rdx\n");
  s = s.write("    jb .Lmcp_lt8\n");
  s = s.write("    cmpq $16, %rdx\n");
  s = s.write("    jb .Lmcp_8_15\n");
  s = s.write("    cmpq $32, %rdx\n");
  s = s.write("    jbe .Lmcp_16_32\n");
  s = s.write("    leaq -32(%rdi,%rdx), %r8\n");
  s = s.write("    leaq -32(%rsi,%rdx), %r9\n");
  s = s.write(".Lmcp_bulk:\n");
  s = s.write("    movdqu (%rsi), %xmm0\n");
  s = s.write("    movdqu 16(%rsi), %xmm1\n");
  s = s.write("    movdqu %xmm0, (%rdi)\n");
  s = s.write("    movdqu %xmm1, 16(%rdi)\n");
  s = s.write("    addq $32, %rsi\n");
  s = s.write("    addq $32, %rdi\n");
  s = s.write("    cmpq %r8, %rdi\n");
  s = s.write("    jb .Lmcp_bulk\n");
  s = s.write("    movdqu (%r9), %xmm0\n");
  s = s.write("    movdqu 16(%r9), %xmm1\n");
  s = s.write("    movdqu %xmm0, (%r8)\n");
  s = s.write("    movdqu %xmm1, 16(%r8)\n");
  s = s.write("    ret\n");
  s = s.write(".Lmcp_16_32:\n");
  s = s.write("    movdqu (%rsi), %xmm0\n");
  s = s.write("    movdqu -16(%rsi,%rdx), %xmm1\n");
  s = s.write("    movdqu %xmm0, (%rdi)\n");
  s = s.write("    movdqu %xmm1, -16(%rdi,%rdx)\n");
  s = s.write("    ret\n");
  s = s.write(".Lmcp_8_15:\n");
  s = s.write("    movq (%rsi), %r8\n");
  s = s.write("    movq -8(%rsi,%rdx), %r9\n");
  s = s.write("    movq %r8, (%rdi)\n");
  s = s.write("    movq %r9, -8(%rdi,%rdx)\n");
  s = s.write("    ret\n");
  s = s.write(".Lmcp_lt8:\n");
  s = s.write("    cmpq $4, %rdx\n");
  s = s.write("    jb .Lmcp_lt4\n");
  s = s.write("    movl (%rsi), %r8d\n");
  s = s.write("    movl -4(%rsi,%rdx), %r9d\n");
  s = s.write("    movl %r8d, (%rdi)\n");
  s = s.write("    movl %r9d, -4(%rdi,%rdx)\n");
  s = s.write("    ret\n");
  s = s.write(".Lmcp_lt4:\n");
  s = s.write("    testq %rdx, %rdx\n");
  s = s.write("    je .Lmcp_done\n");
  s = s.write("    movzbq (%rsi), %r8\n");
  s = s.write("    movzbq -1(%rsi,%rdx), %r9\n");
  s = s.write("    movb %r8b, (%rdi)\n");
  s = s.write("    movb %r9b, -1(%rdi,%rdx)\n");
  s = s.write("    cmpq $3, %rdx\n");
  s = s.write("    jb .Lmcp_done\n");
  s = s.write("    movzbq 1(%rsi), %r8\n");
  s = s.write("    movb %r8b, 1(%rdi)\n");
  s = s.write(".Lmcp_done:\n");
  return s.write("    ret\n");
}

function ssa_trap(s: asmcore.EmitState, trap: string): string {
  return trap + s.ssa_trap_suffix;
}

function ssa_trap_need(s: asmcore.EmitState, trap: string): asmcore.EmitState {
  if (s.ssa_trap_suffix == "") {
    return s;
  }
  return s.need(ssa_trap(s, trap));
}

function ssa_trap_jump(s: asmcore.EmitState, mnem: string, trap: string): asmcore.EmitState {
  return ssa_jump_sym(ssa_trap_need(s, trap), mnem, ssa_trap(s, trap));
}

function ssa_jumped_traps(): string[] {
  return ["__fern_oob_abort", "__fern_str_oob_abort", "__fern_alloc_size_abort"];
}

function ssa_called_traps(): string[] {
  return ["__fern_oob_abort", "__fern_slice_abort", "__fern_alloc_size_abort"];
}

function leaf_trap(n: i32): string {
  return ".l" + util.i32_to_string(n);
}

function emit_trap_stubs(s: asmcore.EmitState): asmcore.EmitState {
  for trap in ssa_jumped_traps() {
    for n in 0..=ssa_nsaved() + 1 {
      if (trap_stub_needed(s, trap + leaf_trap(n))) {
        s = s.write(trap + leaf_trap(n) + ":\n");
        s = s.write("    pushq " + util.i32_to_string(8 * n) + "(%rsp)\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    jmp " + trap + "\n");
      }
    }
  }
  for trap in ssa_called_traps() {
    if (trap_stub_needed(s, trap + ".c")) {
      s = s.write(trap + ".c:\n    pushq %rbp\n    movq %rsp, %rbp\n    jmp " + trap + "\n");
    }
  }
  return s;
}

function trap_stub_needed(s: asmcore.EmitState, stub: string): boolean {
  return s.has_need("trap_stubs") || s.has_need(stub);
}

function emit_trap_stub_globls(s: asmcore.EmitState): asmcore.EmitState {
  for trap in ssa_jumped_traps() {
    for n in 0..=ssa_nsaved() + 1 {
      if (trap_stub_needed(s, trap + leaf_trap(n))) {
        s = s.write(".globl " + trap + leaf_trap(n) + "\n");
      }
    }
  }
  for trap in ssa_called_traps() {
    if (trap_stub_needed(s, trap + ".c")) {
      s = s.write(".globl " + trap + ".c\n");
    }
  }
  return s;
}

function abort_trap(s: asmcore.EmitState, label: string, msg: string, text: string, status: i32): asmcore.EmitState {
  s = s.write("    .section .rodata\n");
  s = s.write(msg + ":\n    .ascii \"" + text + "\\n\"\n");
  s = s.write("    .section .text\n");
  if (label == "__fern_double_free_abort" || label == "__fern_free_range_abort") {
    let stub: string = if (label == "__fern_double_free_abort") { ".Lrawfree_double" } else { ".Lrawfree_bad" };
    s = s.write(stub + ":\n    pushq (%rsp)\n    pushq %rbp\n    movq %rsp, %rbp\n");
  }
  s = s.write(label + ":\n");
  s = ssa_lea_sym(s, msg, "%rsi");
  s = s.write("    movq $" + util.i32_to_string(text.len() + 1) + ", %rdx\n");
  if (status == 134) {
    return s.need("abort_134").write("    jmp __fern_abort_134\n");
  }
  s = s.write("    movq $" + util.i32_to_string(status) + ", %rdi\n");
  s = s.write("    jmp __fern_report\n");
  return s;
}

// The first allocation maps the arena.
function emit_arena_map(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    pushq %rdi\n");
  s = s.write("    pushq %rsi\n");
  s = s.write("    pushq %rcx\n");
  s = s.write("    pushq %rdx\n");
  s = s.write("    pushq %r8\n");
  s = s.write("    pushq %r9\n");
  s = s.write("    pushq %r10\n");
  s = s.write("    pushq %r11\n");
  s = s.write("    movl $0x10000000, %edi\n");
  s = s.write("    movabs $" + s.heap_limit.to_string() + ", %rsi\n");
  s = s.write("    movl $3, %edx\n");
  s = s.write("    movl $0x4022, %r10d\n");
  s = s.write("    movq $-1, %r8\n");
  s = s.write("    xorl %r9d, %r9d\n");
  s = s.write("    movl $9, %eax\n");
  s = s.syscall(9);
  s = s.write("    cmpq $0, %rax\n");
  s = s.write("    jl .Lalloc_map_fail\n");
  s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
  s = s.write("    movq %rax, __fern_heap_base(%rip)\n");
  s = s.write("    movabs $" + s.heap_limit.to_string() + ", %rcx\n");
  s = s.write("    addq %rax, %rcx\n");
  s = s.write("    movq %rcx, __fern_heap_end(%rip)\n");
  s = s.write("    popq %r11\n");
  s = s.write("    popq %r10\n");
  s = s.write("    popq %r9\n");
  s = s.write("    popq %r8\n");
  s = s.write("    popq %rdx\n");
  s = s.write("    popq %rcx\n");
  s = s.write("    popq %rsi\n");
  s = s.write("    popq %rdi\n");
  return s;
}

// A target with no host gets its heap from the embedder, which calls
// __fern_heap_init(base, len) once before anything allocates. The base is
// 16-byte aligned.
function emit_heap_init(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .text\n    .globl __fern_heap_init\n    .type __fern_heap_init, @function\n__fern_heap_init:\n");
  if (s.has_need("heap")) {
    s = s.write("    movq %rdi, __fern_heap_ptr(%rip)\n    movq %rdi, __fern_heap_base(%rip)\n    addq %rdi, %rsi\n    movq %rsi, __fern_heap_end(%rip)\n");
  }
  return s.write("    ret\n.size __fern_heap_init, .-__fern_heap_init\n");
}

function emit_map_fail_trap(s: asmcore.EmitState): asmcore.EmitState {
  let text = aborts.map_fail();
  s = s.write("    .section .rodata\n");
  s = s.write(".Lmsg_map_fail:\n    .ascii \"" + text + "\"\n");
  s = s.write("    .section .text\n");
  s = s.write(".Lalloc_map_fail:\n");
  s = s.write("    negq %rax\n");
  s = s.write("    subq $96, %rsp\n");
  s = s.write("    leaq 96(%rsp), %rdi\n");
  s = s.write("    movl $10, %edx\n");
  s = s.write("    decq %rdi\n");
  s = s.write("    movb %dl, (%rdi)\n");
  s = s.write("    movl $41, %edx\n");
  s = s.write("    decq %rdi\n");
  s = s.write("    movb %dl, (%rdi)\n");
  s = s.write("    movl $10, %ecx\n");
  s = s.write(".Lmap_fail_digit:\n");
  s = s.write("    xorl %edx, %edx\n");
  s = s.write("    divq %rcx\n");
  s = s.write("    addl $48, %edx\n");
  s = s.write("    decq %rdi\n");
  s = s.write("    movb %dl, (%rdi)\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jne .Lmap_fail_digit\n");
  s = ssa_lea_sym(s, ".Lmsg_map_fail", "%rsi");
  s = s.write("    addq $" + util.i32_to_string(text.len()) + ", %rsi\n");
  s = s.write("    movl $" + util.i32_to_string(text.len()) + ", %ecx\n");
  s = s.write(".Lmap_fail_copy:\n");
  s = s.write("    decq %rsi\n");
  s = s.write("    movb (%rsi), %dl\n");
  s = s.write("    decq %rdi\n");
  s = s.write("    movb %dl, (%rdi)\n");
  s = s.write("    decq %rcx\n");
  s = s.write("    jne .Lmap_fail_copy\n");
  s = s.write("    movq %rdi, %rsi\n");
  s = s.write("    leaq 96(%rsp), %rdx\n");
  s = s.write("    subq %rsi, %rdx\n");
  s = s.write("    movq $123, %rdi\n");
  return s.write("    jmp __fern_report\n");
}

function emit_report(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .bss\n    .align 8\n    .globl __fern_stack_top\n__fern_stack_top: .quad 0\n    .globl __fern_bt_floor\n__fern_bt_floor: .quad 0\n");
  if (s.harden) {
    s = s.write("    .globl __fern_canary\n__fern_canary: .quad 0\n__fern_rng_state: .quad 0\n");
  }
  s = s.write("    .section .text\n");
  if (s.has_need("abort_134")) {
    s = s.write("__fern_abort_134:\n    movq $134, %rdi\n");
  }
  if (!asmcore.process_entry(s)) {
    return s.write("__fern_report:\n    ud2\n");
  }
  s = s.write("__fern_report:\n");
  s = s.write("    movq %rdi, %r15\n");
  s = s.write("    movq $2, %rdi\n");
  s = s.write("    movq $1, %rax\n");
  s = s.syscall(1);
  if (asmcore.is_android(s.build_target)) {
    s = s.write("    pushq %r15\n    pushq %rdx\n    pushq %rsi\n    pushq $7\n    call __fn___fern_logcat\n");
    s = s.write("    addq $24, %rsp\n    popq %r15\n");
  }
  if (s.backtrace) {
    s = s.write("    jmp __fern_bt_exit\n");
    return emit_bt_exit(s);
  }
  s = emit_signal_resume_check(s);
  s = s.write("    movq %r15, %rdi\n");
  s = s.write("    movq $231, %rax\n");
  return s.syscall(231);
}

// A negative status is a fatal signal's report: the handler resumes, takes
// the default action again, and the process ends by the signal.
function emit_signal_resume_check(own s: asmcore.EmitState): asmcore.EmitState {
  if (s.shared) {
    return s;
  }
  return s.write("    testq %r15, %r15\n    js .Lfern_signal_resume\n");
}

function emit_quarantine_data(s: asmcore.EmitState): asmcore.EmitState {
  if (s.rc_free_debug) {
    s = s.write("__fern_quar_head: .quad 0\n    .align 8\n__fern_quar_tail: .quad 0\n    .align 8\n__fern_quar_bytes: .quad 0\n    .align 8\n");
    if (s.has_need("worker_regions")) {
      s = s.write("__fern_forget_lo: .quad 0\n    .align 8\n__fern_forget_hi: .quad 0\n    .align 8\n");
    }
  }
  return s;
}

function emit_ir_runtime(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .bss\n");
  s = s.write("    .align 8\n");
  s = s.write("    .globl __fern_heap_ptr\n");
  s = s.write("__fern_heap_ptr: .quad 0\n");
  s = s.write("    .align 8\n");
  s = s.write("    .globl __fern_heap_end\n");
  s = s.write("__fern_heap_end: .quad 0\n");
  s = s.write("    .align 8\n");
  s = s.write("    .globl __fern_heap_base\n__fern_heap_base: .quad 0\n");
  if (s.has_need("heap_adopt")) {
    s = s.write("__fern_image_lo: .quad 0\n");
    s = s.write("__fern_image_hi: .quad 0\n");
  }
  s = s.write("    .align 8\n");
  if (s.has_need("alloc_count")) {
    s = s.write("    .globl __fern_alloc_count\n");
    s = s.write("__fern_alloc_count: .quad 0\n");
    s = s.write("    .align 8\n");
  }
  s = s.write("__fern_rc_underflow: .quad 0\n");
  s = s.write("    .align 8\n");
  s = s.write("__fern_map_seed: .quad 0\n");
  s = s.write("    .align 8\n");
  s = s.write("    .globl __fern_arr_push_shared\n");
  s = s.write("__fern_arr_push_shared: .quad 0\n");
  s = s.write("    .align 8\n");
  s = s.write("    .globl __fern_arr_push_copied\n");
  s = s.write("__fern_arr_push_copied: .quad 0\n");
  s = s.write("    .align 8\n");
  s = emit_quarantine_data(s);
  if (s.harden) {
    s = s.write("__fern_guard_count: .quad 0\n    .align 8\n");
  }
  s = s.write("__fern_freelist: .skip 524288\n");
  s = s.write("    .align 8\n");
  s = s.write("__fern_large_freelist: .skip 20480\n");
  s = s.write("    .align 8\n");
  s = s.write("__fern_freelist_shadow: .skip 524288\n");
  s = s.write("    .align 8\n");
  s = s.write("__fern_large_freelist_shadow: .skip 20480\n");
  s = s.write("    .section .text\n");
  if (hev_on(s)) {
    s = s.write("__fern_alloc:\n");
    if (s.has_need("alloc_count")) {
      s = s.write("    incq __fern_alloc_count(%rip)\n");
    }
    s = s.write("    pushq %rdi\n");
    s = s.write("    call __fern_alloc_inner\n");
    s = s.write("    popq %rdi\n");
    s = s.write("    pushq %rsi\n");
    s = s.write("    movq 8(%rsp), %rsi\n");
    s = s.write("    addq $7, %rdi\n");
    s = s.write("    shrq $3, %rdi\n");
    s = s.write("    pushq %rdi\n");
    s = s.write("    pushq %rax\n");
    s = s.write("    pushq %rsi\n");
    s = s.write("    call __fern_hev_a\n");
    s = s.write("    addq $24, %rsp\n");
    s = s.write("    popq %rsi\n");
    s = s.write("    ret\n");
    s = s.write("__fern_alloc_inner:\n");
  } else {
    s = s.write("__fern_alloc:\n");
    if (s.has_need("alloc_count")) {
      s = s.write("    incq __fern_alloc_count(%rip)\n");
    }
  }
  s = s.write("    addq $7, %rdi\n");
  s = s.write("    andq $-8, %rdi\n");
  s = s.write("    cmpq $2048, %rdi\n");
  s = s.write("    ja .Lalloc_full\n");
  s = s.write("    leaq __fern_freelist(%rip), %rax\n");
  s = s.write("    addq %rax, %rdi\n");
  s = freelist_take_head(s, ".Lalloc_fast_miss");
  s = s.write("    ret\n");
  s = s.write(".Lalloc_fast_miss:\n");
  s = s.write("    leaq __fern_freelist(%rip), %rax\n");
  s = s.write("    subq %rax, %rdi\n");
  s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jz .Lalloc_full\n");
  s = s.write("    addq %rax, %rdi\n");
  s = s.write("    cmpq __fern_heap_end(%rip), %rdi\n");
  s = s.write("    ja .Lalloc_oom\n");
  s = s.write("    movq %rdi, __fern_heap_ptr(%rip)\n");
  s = s.write("    ret\n");
  s = s.write(".Lalloc_full:\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %rcx\n");
  s = s.write("    pushq %rdx\n");
  s = s.write("    movq %rdi, %rcx\n");
  s = s.write("    shrq $3, %rcx\n");
  s = s.write("    cmpq $65536, %rcx\n");
  s = s.write("    jae .Lalloc_large\n");
