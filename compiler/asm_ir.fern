    s = s.write("    movq (%rdx,%rax,8), %rcx\n");  // old head
    s = s.write("    movq %rcx, (%r8)\n");  // *base = old head
    s = s.write("    movq %r8, (%rdx,%rax,8)\n");  // heads[class] = base
