  s = s.write("    addq $7, %rdx\n");  // words = ceil(len/8) + 3
  s = s.write("    shrq $3, %rdx\n");
  s = s.write("    addq $3, %rdx\n");
  s = s.write("    leaq -8(%rax), %rcx\n");  // base = box-8
  s = s.write(".Lstrfree_block:\n");
  s = s.write(quarantine_rc("-8(%rax)", s.rc_free_debug));
