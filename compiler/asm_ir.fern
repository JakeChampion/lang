    // from the reserve, when a take left the builder unarmed), and carry
    // the live bytes across. Internal — no Fern builtin reaches it.
    s = s.write("__fern_buf_reserve:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r14\n");
    s = s.write("    movq %rdi, %rbx\n");  // H
    s = s.write("    movq %rsi, %r12\n");  // need
