  s = s.write("    jmp .Lcrc32_red\n");
  s = s.write(".Lcrc32_tail:\n");
  s = s.write("    testl %edx, %edx\n");
  s = s.write("    jz .Lcrc32_ret\n");
  s = s.write("    movzbl (%rsi), %r8d\n");
  s = s.write("    shll $24, %r8d\n");
  s = s.write("    xorl %r8d, %eax\n");
  s = s.write("    movl $8, %r9d\n");
  s = s.write(".Lcrc32_tailbit:\n");
  s = s.write("    movl %eax, %r10d\n");
  s = s.write("    sarl $31, %r10d\n");
  s = s.write("    andl $0x04c11db7, %r10d\n");
  s = s.write("    addl %eax, %eax\n");
  s = s.write("    xorl %r10d, %eax\n");
