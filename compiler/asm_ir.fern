function san_underflow_abort(s: asmcore.EmitState): string {
  if (s.sanitize) {
    return "    call __fern_san_abort\n";
  }
  return "";
}

function emit_san_uaf_abort(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .rodata\n");
  s = s.write(".Lsan_uaf:\n    .ascii \"fern-sanitizer: use-after-free (touched a quarantined block)\\n\"\n");
  s = s.write("    .section .text\n");
  s = s.write("    .globl __fern_san_abort_uaf\n");
  s = s.write("__fern_san_abort_uaf:\n");
  s = s.write("    leaq .Lsan_uaf(%rip), %rsi\n");
  s = s.write("    movq $61, %rdx\n");
  s = s.write("    movq $2, %rdi\n");
  s = s.write("    movq $1, %rax\n");
  s = s.syscall(1);
  return san_report_exit(s);
}

function san_report_exit(s: asmcore.EmitState): asmcore.EmitState {
  if (s.backtrace) {
    return s.write("    movq $124, %r15\n    jmp __fern_bt_exit\n");
  }
  return s.write("    movq $124, %rdi\n    movq $231, %rax\n").syscall(231);
}

