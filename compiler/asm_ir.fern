  s = s.write("    .quad 0x3fe934c67f9b2ce6\n    .quad 0x3fce8c0252aa6000\n    .quad 0xbd26805b80e8e6ff\n");
  s = s.write("    .quad 0x3fe90d4f120190d5\n    .quad 0x3fcf550a564b8000\n    .quad 0xbd2323e3a09202fe\n");
  s = s.write("    .quad 0x3fe8e6527af1373f\n    .quad 0x3fd00e6c45ad5000\n    .quad 0x3cdcc68d52e01203\n");
