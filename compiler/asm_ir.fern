    s = s.write("    jnz .Lbufres_dbl\n");
    s = s.write("    movq $64, %r13\n");
    s = s.write(".Lbufres_dbl:\n");
    s = s.write("    cmpq %r12, %r13\n");
    s = s.write("    jae .Lbufres_alloc\n");
    s = s.write("    addq %r13, %r13\n");
    s = s.write("    jmp .Lbufres_dbl\n");
    s = s.write(".Lbufres_alloc:\n");
    s = s.write("    movq %r13, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq %rax, %r14\n");  // new buffer
    s = s.write("    movq 8(%rbx), %rcx\n");  // live bytes
    s = s.write("    testq %rcx, %rcx\n");
    s = s.write("    jz .Lbufres_nocopy\n");
    s = s.write("    movq (%rbx), %rsi\n");  // old buffer
