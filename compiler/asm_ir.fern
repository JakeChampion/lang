  // trap could not be told apart from the kernel OOM-killer. Opposite causes,
  // opposite fixes. Lockstep with the native backends' ExitArenaExhausted.
  s = abort_trap(s, ".Lalloc_oom", ".Lmsg_oom", aborts.oom(), 125);
  s = emit_map_fail_trap(s);
