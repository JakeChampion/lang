    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".Lfern_alloc_u8_empty:\n    leaq .Lfern_empty_u8(%rip), %rax\n    ret\n");
    s = s.write(".size __fern_alloc_u8, .-__fern_alloc_u8\n");
  }

  // __fern_arr_push — `a = a.append(v)`.
  if (s.has_need("arr_push")) {
    s = s.write("__fern_arr_push:\n");
    s = s.write(arr_push_fast(".Larr_push_slow", s.rc_free_debug));
    s = s.write(".Larr_push_slow:\n");
    // An empty receiver with no capacity, the common first append, grows to
    // four slots with nothing to copy, so it needs no frame. A static
    // literal can hold elements at cap 0, hence the length test too. The
    // debug build keeps the frame path, whose rc read checks for poison, and
    // so does a traced one, which names allocation sites by the frame chain.
    if (!s.rc_free_debug && !hev_on(s)) {
      s = s.write("    cmpq $0, (%rdi)\n");
      s = s.write("    jne .Larr_push_frame\n");
      s = s.write("    cmpq $0, -16(%rdi)\n");
      s = s.write("    jne .Larr_push_frame\n");
      if (!s.has_need("alloc_count")) {
        // Four slots are a 56-byte block, class 7: a freed one is popped
        // here, written as the box shim would, and only an empty class
        // calls the shim. The counter's build keeps the call, which counts.
        s = s.write("    leaq __fern_freelist(%rip), %rcx\n");
        s = s.write("    movq 56(%rcx), %rax\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jz .Larr_push_fresh\n");
        s = s.write("    movq (%rax), %rdx\n");
        s = s.write("    movq %rdx, 56(%rcx)\n");
        s = s.write("    movq $4, (%rax)\n");
        s = s.write("    movq $1, 8(%rax)\n");
        s = s.write("    movq $1, 16(%rax)\n");
        s = s.write("    movq %rsi, 24(%rax)\n");
        s = s.write("    addq $16, %rax\n");
        s = s.write("    ret\n");
        s = s.write(".Larr_push_fresh:\n");
      }
      s = s.write("    pushq %rsi\n");  // the value, and 16-byte alignment for the call
      s = s.write("    movl $4, %edi\n");
      s = s.write("    call __fern_arr_box\n");
      s = s.write("    popq %rsi\n");
      s = s.write("    movq $1, (%rax)\n");
      s = s.write("    movq %rsi, 8(%rax)\n");
      s = s.write("    ret\n");
    }
    s = s.write(".Larr_push_frame:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r14\n");
    s = s.write("    pushq %r15\n");
    s = s.write("    movq %rdi, %r12\n");  // arr ptr
    s = s.write("    movq %rsi, %r13\n");  // value
    s = s.write("    movq (%r12), %r14\n");  // len
    s = s.write("    movq -16(%r12), %r15\n");  // cap (hidden at -16; rc at -8)
    // Past the fast path, the receiver is shared or full: both grow.
    if (!s.rc_free_debug) {
      s = s.write("    jmp .Larr_push_grow\n");
    }
    // #4873 containment gate: an rc >= 2 receiver is SHARED (the caller-side
    // grow bracket inc'd it, or a counted alias exists) — never mutate it in
    // place even when capacity fits; take the grow path's fresh-box copy,
    // which leaves the old buffer untouched (and, per the load-bearing-leak
    // note below, never freed). rc == 1 (sole owner) and the bit-31
    // static/immortal sentinel keep today's in-place fast path.
    s = s.write("    movl -8(%r12), %ecx\n");  // rc word
    s = s.write(san_poison_check("%ecx", s.rc_free_debug));
    s = s.write("    cmpl $1, %ecx\n");
    s = s.write("    je .Larr_push_rc_ok\n");
    s = s.write("    testl %ecx, %ecx\n");
    s = s.write("    js .Larr_push_rc_ok\n");
    s = s.write("    jmp .Larr_push_grow\n");  // shared → copy (#4873)
    s = s.write(".Larr_push_rc_ok:\n");
    s = s.write("    cmpq %r15, %r14\n");
    s = s.write("    jge .Larr_push_grow\n");  // len >= cap → grow
    s = s.write("    movq %r14, %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    movq %r13, (%r12,%rcx,8)\n");
    s = s.write("    incq %r14\n");
    s = s.write("    movq %r14, (%r12)\n");
    s = s.write("    movq %r12, %rax\n");
    s = s.write("    jmp .Larr_push_ret\n");
    // LOAD-BEARING LEAK — do NOT add a free of the old buffer (%r12) here.
    // The grow path doubles into a fresh box and abandons the previous buffer,
    // so every grow leaks it; under emit_module_ir's op-array churn this is what
    // OOMs (exit 137) the per-module self-compile of the big modules (#3425,
    // #3452 — the self-host-emitted twin of the native large-tier leak). It is
    // tempting to push %r12 onto the freelist when its rc==1, but that DOUBLE-
    // FREEs: today's lowering deliberately depends on __fern_arr_push never
    // freeing, because borrow-form appends can hand it an ALIASED (rc>1) buffer
    // the struct/owner still references. Adding the free turns the OOM
    // into a SIGSEGV. Reclaim-on-grow is sound only AFTER the lowering routes
    // every non-consume append through the clone form (lower_arr_append_value),
    // leaving op_arr_push for true consumes, and drops the self-consume
    // (`a = a.append(v)`) reassign-dec — the reuse-analysis slice of goal #2.
    s = s.write(".Larr_push_grow:\n");
    s = s.write("    movq %r15, %rcx\n");
    // #4873: a SHARED receiver with spare capacity (len < cap) lands here for
    // an UN-SHARE copy, not a growth — keep the same cap instead of doubling,
    // halving the copy's arena footprint (the leak-mode self-compile is
    // arena-bound, #3425). True growth (len >= cap) still doubles.
    s = s.write("    cmpq %r15, %r14\n");
    s = s.write("    jl .Larr_push_shared_cliff\n");
    s = s.write("    cmpq $0, %rcx\n");
    s = s.write("    jne .Larr_push_dbl\n");
    s = s.write("    movq $4, %rcx\n");
    s = s.write("    jmp .Larr_push_cap\n");
    // len < cap at .Larr_push_grow is only reachable from the rc-shared jump
    // above (the rc-ok path gets here only on len >= cap), so this branch IS the
    // cliff: a copy bought by an extra reference, not by a full buffer. Count it
    // — the same diagnostic the native backends keep — then fall through to
    // .Larr_push_cap with the cap UNDOUBLED, as the un-share copy needs no
    // growth. Off the fast path: this costs one add on a run already about to
    // copy the whole buffer.
    s = s.write(".Larr_push_shared_cliff:\n");
    s = s.write("    incq __fern_arr_push_shared(%rip)\n");
    // Weight the crossing by what it costs: the len * 8 bytes the copy below
    // is about to move. %rax is free here (it only takes the result at
    // .Larr_push_ret) and %r14 holds len.
    s = s.write("    movq %r14, %rax\n");
    s = s.write("    shlq $3, %rax\n");
    s = s.write("    addq %rax, __fern_arr_push_copied(%rip)\n");
    s = s.write("    jmp .Larr_push_cap\n");
    s = s.write(".Larr_push_dbl:\n");
    s = s.write("    shlq $1, %rcx\n");
    s = s.write(".Larr_push_cap:\n");
    s = s.write("    movq %rcx, %r15\n");  // r15 = newcap
    s = s.write("    movq %r15, %rdi\n");  // cap = newcap
    s = s.write("    call __fern_arr_box\n");  // -> data ptr in %rax (cap + len=cap written)
    s = s.write("    movq %r14, %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    movq %rcx, (%rax)\n");  // new len = old+1 (overwrite helper's len)
    s = s.write(arr_copy_elems(".Larr_push"));
    s = s.write("    movq %r14, %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    movq %r13, (%rax,%rcx,8)\n");
    s = s.write(".Larr_push_ret:\n");
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
  }

  // __fern_arr_push_owned — the sole-owner self-append (an !aliased
  // `a = a.append(v)`): __fern_arr_push that also reclaims the old buffer
  // when the push grew, pushing it onto its size class (the arr_dec free
  // path). Sound only because the emitting site proved the slot unaliased
  // (sole owner), so the superseded old buffer has no surviving reference.
  // This is the safe, gated form of the free the shared __fern_arr_push must
  // NOT do (see .Larr_push_grow). Depends on __fern_arr_push, so it shares
  // arr_push's emit gate — the op handler marks the arr_push need alongside
  // arr_push_owned, so the two are always co-present, and the per-module
  // entry (which emits __fern_arr_push) gets this one too without threading
  // a separate need through the union.
  //
  // A full sole-owned receiver, the common case past the inline fast path,
  // grows here in one frame: the new block is popped from its class as the
  // box shim would, the elements copied, and the old block pushed onto its
  // class with nothing re-read, since the rc check at entry already proved
  // the receiver ours. A static literal and a shared receiver go to the
  // shared slow path, which copies and frees nothing. The diagnostic builds
  // keep the wrapper shape: the old pointer saved, the shared slow path
  // called, and the old block freed through the hooks iff the result moved.
  if (s.has_need("arr_push")) {
    s = s.write("__fern_arr_push_owned:\n");
    s = s.write(arr_push_fast(".Lapo_slow", s.rc_free_debug));
    s = s.write(".Lapo_slow:\n");
    if (!s.rc_free_debug && !hev_on(s) && !s.has_need("alloc_count")) {
      s = apo_grow(s);
    } else {
      s = apo_wrapped(s);
    }
    s = apo_large(s);
  }

  if (s.has_need("arr_push_u8")) {
    s = emit_arr_push_u8(s);
  }
  if (s.has_need("alloc_bytes")) {
    s = emit_alloc_bytes(s);
  }

  // __fern_i32_to_string is now a Fern runtime function (#2649): emitted
  // entry-only via emit_ir_runtime_fern_fn (lowered through the IR pipeline as
  // __fn___fern_i32_to_string, using the raw-memory intrinsics), not a
  // hand-written body here. See the emit_ir_runtime_fern_fn call in
  // emit_module_ir_unit_flat's entry block.
  // No static `.bss` heap reservation: the arena is mmap'd lazily on the
  // first __fern_alloc call (see the .bss block + __fern_alloc above), so
  // the binary is linker-agnostic (issue #4081). Mirrors what the retired x86 AST emitter did.
  return s;
}

// ir_bin_asm renders the asm for one IR binary op (lhs in %rax, rhs in %rcx,
// result in %rax) — mirroring asm.fern's own ExprBinary sequences (64-bit,
// signed i32 div/cmp) so the two paths agree exactly.
// `d` holds the left operand and takes the result; `r` holds the right and
// must be %rcx for the shifts, which read their count from %cl. The stack
// machine passes %rax and %rcx; the register path passes its own working
// register, since %rax is a value home there.
function ir_bin_asm(tag: i32, width: i32, d: string, r: string): string {
  // mulq takes the left operand in %rax (ssa_bin_work) and leaves the high
  // half in %rdx.
  if (tag == 430) {
    return "    mulq " + r + "\n    movq %rdx, " + d + "\n";
  }
  if (tag == 21) {
    return "    addq " + r + ", " + d + "\n";
  }
  if (tag == 22) {
    return "    subq " + r + ", " + d + "\n";
  }
  if (tag == 23) {
    // The in-process assembler encodes imul with an immediate only in its
    // three-operand form.
    if (r[0] == 36) {
      return "    imulq " + r + ", " + d + ", " + d + "\n";
    }
    return "    imulq " + r + ", " + d + "\n";
  }
  // div_s / rem_s / div_u / rem_u are NOT handled here — the op loop routes
  // them through ir_div_guarded (below) so a divide-by-zero / INT_MIN/-1 does
  // not raise #DE. The language contract is total, never-trapping (#4329).
  if (tag == 28) {
    return "    andq " + r + ", " + d + "\n";
  }
  if (tag == 29) {
    return "    orq " + r + ", " + d + "\n";
  }
  if (tag == 30) {
    return "    xorq " + r + ", " + d + "\n";
  }
  // Shift counts mask to the operand width: mod 64 for i64 (the q-form masks
  // %cl to 6 bits in hardware), mod 32 for i32/u32. A 32-bit i32 shift used
  // to emit the q-form, so a count >= 32 wrapped mod 64 instead of mod 32
  // (#4330). Fix by masking the count to 5 bits BUT keeping the 64-bit shift
  // instruction, so the operand's slot extension is preserved: a u32 value is
  // zero-extended (bit 63 = 0) and an i32 value sign-extended (bit 63 = bit
  // 31), and `sarq`/`shrq`/`shlq` on the full register does the right thing for
  // both. (A 32-bit `sarl` would fill from bit 31, corrupting a u32 `>>` —
  // which lowers through shr_s — whose bit 31 is a data bit, not a sign bit.)
  if (width == 64) {
    if (tag == 31) {
      return "    shlq %cl, " + d + "\n";
    }
    if (tag == 32) {
      return "    sarq %cl, " + d + "\n";
    }
    if (tag == 33) {
      return "    shrq %cl, " + d + "\n";
    }
  }
  if (tag == 31) {
    return "    andl $31, %ecx\n    shlq %cl, " + d + "\n";
  }
  if (tag == 32) {
    return "    andl $31, %ecx\n    sarq %cl, " + d + "\n";
  }
  if (tag == 33) {
    return "    andl $31, %ecx\n    shrq %cl, " + d + "\n";
  }
  if (tag == 35) {
    return "    cmpq " + r + ", " + d + "\n    sete " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n";
  }
  if (tag == 36) {
    return "    cmpq " + r + ", " + d + "\n    setne " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n";
  }
  if (tag == 37) {
    return "    cmpq " + r + ", " + d + "\n    setl " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n";
  }
  if (tag == 38) {
    return "    cmpq " + r + ", " + d + "\n    setle " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n";
  }
  if (tag == 39) {
    return "    cmpq " + r + ", " + d + "\n    setg " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n";
  }
  if (tag == 40) {
    return "    cmpq " + r + ", " + d + "\n    setge " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n";
  }
  // Unsigned 64-bit compares (u64, #2904): same cmpq, but the below/above
  // setcc family reads CF instead of SF/OF — correct once bit 63 is set.
  if (tag == 41) {
    return "    cmpq " + r + ", " + d + "\n    setb " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n";
  }
  if (tag == 42) {
    return "    cmpq " + r + ", " + d + "\n    setbe " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n";
  }
  if (tag == 43) {
    return "    cmpq " + r + ", " + d + "\n    seta " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n";
  }
  if (tag == 44) {
    return "    cmpq " + r + ", " + d + "\n    setae " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n";
  }
  return ircore.unsupported_op_refuse(tag, "x86-64");
}

// ir_cmp_jcc is the conditional jump an integer comparison feeds when its
// result goes straight to a branch: the one that fires when the comparison
// holds (when_true) or its inverse. `cmpq %rcx, %rax` has already set the flags,
// so the signed/unsigned split is the same one ir_bin_asm's setcc family makes.
function ir_cmp_jcc(tag: i32, when_true: boolean): i32 {
  let direct: i32 = J_JAE;  // ge_u
  let neg: i32 = J_JB;
  if (tag == 35) {
    direct = J_JE;
    neg = J_JNE;
  } else if (tag == 36) {
    direct = J_JNE;
    neg = J_JE;
  } else if (tag == 37) {
    direct = J_JL;
    neg = J_JGE;
  } else if (tag == 38) {
    direct = J_JLE;
    neg = J_JG;
  } else if (tag == 39) {
    direct = J_JG;
    neg = J_JLE;
  } else if (tag == 40) {
    direct = J_JGE;
    neg = J_JL;
  } else if (tag == 41) {
    direct = J_JB;
    neg = J_JAE;
  } else if (tag == 42) {
    direct = J_JBE;
    neg = J_JA;
  } else if (tag == 43) {
    direct = J_JA;
    neg = J_JBE;
  }
  if (when_true) {
    return direct;
  }
  return neg;
}

// shift_imm_asm is one shift by a known count into `d`, the mask folded into
// the immediate at the operand's width; the count comes from the allocator's
// immediate table.
function shift_imm_asm(tag: i32, width: i32, count: i64, d: string): string {
  let k: i32 = count as i32 & 31;
  if (width == 64) {
    k = count as i32 & 63;
  }
  let imm: string = " $" + util.i32_to_string(k) + ", " + d + "\n";
  if (tag == 31) {
    return "    shlq" + imm;
  }
  if (tag == 32) {
    return "    sarq" + imm;
  }
  return "    shrq" + imm;
}

// DivRegs names the accumulator, scratch and high registers, and the size
// suffix, at a divide's width. i32 uses the l-forms on the low halves — dirty
// upper bits cannot reach a 32-bit divide, so nothing has to be widened first.
struct DivRegs {
  a: string,
  c: string,
  d: string,
  sfx: string,
  bits: i32,
}

function div_regs(w64: boolean): DivRegs {
  if (w64) {
    return DivRegs { a: "%rax", c: "%rcx", d: "%rdx", sfx: "q", bits: 64 };
  }
  return DivRegs { a: "%eax", c: "%ecx", d: "%edx", sfx: "l", bits: 32 };
}

// ir_div_guarded renders a non-trapping div or rem by a divisor only known at
// run time (dividend in %rax, divisor in %rcx, result in %rax). x86 idiv/div
// raise #DE (SIGFPE) on a zero divisor and on INT_MIN/-1 overflow, but the
// language contract (docs/INTEGER-SEMANTICS.md) is total: x/0 = 0, x%0 = x,
// INT_MIN/-1 = INT_MIN, INT_MIN%-1 = 0. Guard both faults inline, mirroring
// native emitIntDivRem. `lb` is a per-op-unique label base (loop prefix + op
// index). (#4329)
function ir_div_guarded(tag: i32, width: i32, lb: string): string {
  let r: DivRegs = div_regs(width == 64);
  let s: string = "    test" + r.sfx + " " + r.c + ", " + r.c + "\n";
  if (tag == 25 || tag == 27) {
    // Unsigned (u32/u64, #2904): only the divide-by-zero fault to guard —
    // unsigned division has no overflow case.
    let divide: string = "    xorl %edx, %edx\n    div" + r.sfx + " " + r.c + "\n";
    if (tag == 25) {
      s = s + "    jz " + lb + "_dz\n" + divide;
      s = s + "    jmp " + lb + "_dn\n";
      s = s + lb + "_dz:\n    xorl %eax, %eax\n";
    } else {
      s = s + "    jz " + lb + "_dn\n" + divide;  // divisor 0 -> rem = dividend (rax)
      s = s + "    mov" + r.sfx + " " + r.d + ", " + r.a + "\n";
    }
    return s + lb + "_dn:\n";
  }
  let idivide: string = "    cqto\n    idivq %rcx\n";
  if (width != 64) {
    idivide = "    cltd\n    idivl %ecx\n";
  }
  let cmp_neg1: string = "    cmp" + r.sfx + " $-1, " + r.c + "\n";
  if (tag == 24) {
    s = s + "    jz " + lb + "_dz\n";  // /0 -> 0
    s = s + cmp_neg1 + "    je " + lb + "_ng\n" + idivide;  // /-1 -> -dividend (wraps at INT_MIN)
    s = s + "    jmp " + lb + "_dn\n";
    s = s + lb + "_ng:\n    neg" + r.sfx + " " + r.a + "\n    jmp " + lb + "_dn\n";
    s = s + lb + "_dz:\n    xorl %eax, %eax\n";
  } else {
    s = s + "    jz " + lb + "_dn\n";  // %0 -> dividend (rax)
    s = s + cmp_neg1 + "    je " + lb + "_z0\n" + idivide;  // %-1 -> 0
    s = s + "    mov" + r.sfx + " " + r.d + ", " + r.a + "\n    jmp " + lb + "_dn\n";
    s = s + lb + "_z0:\n    xorl %eax, %eax\n";
  }
  s = s + lb + "_dn:\n";
  // An i32 result is stored sign-extended in its 64-bit slot.
  if (width != 64) {
    s = s + "    cltq\n";
  }
  return s;
}

// ---- division by a literal divisor (native emitConstDivRem) --------------
//
// A divide whose right operand is an integer constant (ssa.Imms.konst) knows
// its divisor, which collapses most of what ir_div_guarded spends its
// instructions on: both guards branch on a value that is now a compile-time
// constant, a power of two needs no divide at all, and any other divisor
// takes the multiply-high reciprocal.

// pow2_shift_i64 gives sh when `mag`, read as an unsigned 64-bit bit pattern,
// is 2^sh, and -1 otherwise.
function pow2_shift_i64(mag: i64): i32 {
  if (mag == 0i64 || (mag & mag - 1i64) != 0i64) {
    return 0 - 1;
  }
  let sh: i32 = 0;
  while (1i64 << sh != mag) {
    sh = sh + 1;
  }
  return sh;
}

// ir_div_const renders `dividend / k` or `dividend % k` for the literal k
// (dividend in %rax, result in %rax); tag is div_s / div_u / rem_s / rem_u.
function ir_div_const(tag: i32, width: i32, k: i64): string {
  let w64: boolean = width == 64;
  let uns: boolean = tag == 25 || tag == 27;
  let body: string = ir_div_const_body(w64, uns, tag == 26 || tag == 27, k);
  // An i32 result is stored sign-extended in its 64-bit slot; the l-forms
  // zero-extend, which is already the u32 convention.
  if (!w64 && !uns) {
    body = body + "    cltq\n";
  }
  return body;
}

function ir_div_const_body(w64: boolean, uns: boolean, is_rem: boolean, k: i64): string {
  let r: DivRegs = div_regs(w64);
  // Normalise the divisor's magnitude. Unsigned reads the literal's bit
  // pattern at the operand width; signed keeps the sign for the negation a
  // negative divisor's quotient needs at the end.
  let mag: i64 = k;
  let neg: boolean = false;
  if (uns) {
    if (!w64) {
      mag = (k as i32) as i64 & 4294967295i64;
    }
  } else {
    let v: i64 = k;
    if (!w64) {
      v = (k as i32) as i64;
    }
    let min: i64 = -2147483648i64;
    if (w64) {
      min = -9223372036854775808i64;
    }
    // The most negative divisor has no positive magnitude, so it takes the
    // divide rather than a negation that wraps.
    if (v == min) {
      return ir_div_const_generic(r, uns, is_rem, k);
    }
    if (v < 0i64) {
      neg = true;
      mag = 0i64 - v;
    } else {
      mag = v;
    }
  }
  if (mag == 0i64) {
    // x / 0 = 0, x % 0 = x: the guarded sequence's zero arm, with no branch to reach it.
    if (is_rem) {
      return "";
    }
    return "    xorl %eax, %eax\n";
  }
  if (mag == 1i64) {
    // x % ±1 = 0. x / 1 = x. x / -1 = -x, and INT_MIN / -1 keeps the
    // contract's answer because `neg` wraps to INT_MIN itself.
    if (is_rem) {
      return "    xorl %eax, %eax\n";
    }
    if (neg) {
      return "    neg" + r.sfx + " " + r.a + "\n";
    }
    return "";
  }
  let sh: i32 = pow2_shift_i64(mag);
  // Signed stops one short of the sign bit: the bias needs 2^sh to be a
  // positive value at the operand width.
  let max_sh: i32 = r.bits - 2;
  if (uns) {
    max_sh = r.bits - 1;
  }
  if (sh >= 0 && sh <= max_sh) {
    return ir_div_const_pow2(r, uns, is_rem, neg, sh);
  }
  return ir_div_const_magic(r, uns, is_rem, k);
}

// ir_div_const_pow2 is division or remainder by 2^sh. Signed division by a
// power of two is NOT an arithmetic shift: `sar` rounds toward negative
// infinity and the language rounds toward zero, so -1/2 would be -1 rather
// than 0. Biasing the dividend by 2^sh-1 when it is negative — what the
// sar/shr pair computes branchlessly — makes the shift round the right way.
function ir_div_const_pow2(r: DivRegs, uns: boolean, is_rem: boolean, neg: boolean, sh: i32): string {
  let shs: string = util.i32_to_string(sh);
  if (uns) {
    if (is_rem) {
      return mask_low_bits(r, r.a, sh, true);
    }
    return "    shr" + r.sfx + " $" + shs + ", " + r.a + "\n";
  }
  let s: string = "    mov" + r.sfx + " " + r.a + ", " + r.c + "\n";
  s = s + "    sar" + r.sfx + " $" + util.i32_to_string(r.bits - 1) + ", " + r.c + "\n";  // all ones iff negative
  s = s + "    shr" + r.sfx + " $" + util.i32_to_string(r.bits - sh) + ", " + r.c + "\n";  // 2^sh-1 iff negative
  s = s + "    add" + r.sfx + " " + r.a + ", " + r.c + "\n";  // biased dividend
  if (is_rem) {
    // r = x - (x/2^sh)*2^sh, and the multiply is a mask.
    s = s + mask_low_bits(r, r.c, sh, false);
    return s + "    sub" + r.sfx + " " + r.c + ", " + r.a + "\n";
  }
  s = s + "    mov" + r.sfx + " " + r.c + ", " + r.a + "\n";
  s = s + "    sar" + r.sfx + " $" + shs + ", " + r.a + "\n";
  if (neg) {
    s = s + "    neg" + r.sfx + " " + r.a + "\n";
  }
  return s;
}

// mask_low_bits keeps (keep) or clears the low sh bits of reg. `and` takes an
// imm32, so a mask past bit 31 is a shift pair instead.
function mask_low_bits(r: DivRegs, reg: string, sh: i32, keep: boolean): string {
  if (keep && sh <= 31) {
    return "    and" + r.sfx + " $" + util.i64_to_string((1i64 << sh) - 1i64) + ", " + reg + "\n";
  }
  if (keep) {
    let back: string = util.i32_to_string(r.bits - sh);
    return "    shl" + r.sfx + " $" + back + ", " + reg + "\n    shr" + r.sfx + " $" + back + ", " + reg + "\n";
  }
  if (sh <= 31) {
    return "    and" + r.sfx + " $" + util.i64_to_string(0i64 - (1i64 << sh)) + ", " + reg + "\n";
  }
  let shs: string = util.i32_to_string(sh);
  return "    shr" + r.sfx + " $" + shs + ", " + reg + "\n    shl" + r.sfx + " $" + shs + ", " + reg + "\n";
}

// ir_div_const_magic is division or remainder by a divisor that is neither
// 0, ±1 nor a power of two: the reciprocal from ir.derive_magic_*. A divide
// is 20-40 cycles at 32 bits and up to 90 at 64, where the multiply and shift
// are about five.
//
// The one-operand imul / mul multiply the accumulator by their operand and
// leave the high half in %edx / %rdx, so the DIVIDEND goes in %ecx and the
// MAGIC in %eax — the product is the same either way, and that ordering leaves
// the dividend intact in %ecx for the fixup and for a remainder's
// multiply-back.
function ir_div_const_magic(r: DivRegs, uns: boolean, is_rem: boolean, k: i64): string {
  let x: string = r.sfx;
  let s: string = "    mov" + x + " " + r.a + ", " + r.c + "\n";
  let load: string = "    movl $";
  if (r.bits == 64) {
    load = "    movabsq $";
  }
  let d: i64 = k;
  if (r.bits == 32) {
    d = (k as i32) as i64;
  }
  if (uns) {
    let du: u64 = k as u64 & 0u64 - 1u64 >> (64 - r.bits) as u64;
    let mu: ir.MagicU = ir.derive_magic_u(du, r.bits);
    // An even divisor whose magic needs the extra bit divides the dividend
    // shifted right by its trailing zeros by what is left, which never does.
    let pre: i32 = 0;
    if (mu.add && (du & 1u64) == 0u64) {
      while ((du >> pre as u64 & 1u64) == 0u64) {
        pre = pre + 1;
      }
      mu = ir.derive_magic_u_below(du >> pre as u64, r.bits, pre);
    }
    let m: i64 = mu.m as i64;
    if (r.bits == 32) {
      m = ((mu.m as u32) as i32) as i64;
    }
    if (pre > 0) {
      s = s + "    mov" + x + " " + r.c + ", " + r.d + "\n    shr" + x + " $" + util.i32_to_string(pre) + ", " + r.d + "\n";
      s = s + load + util.i64_to_string(m) + ", " + r.a + "\n    mul" + x + " " + r.d + "\n";
    } else {
      s = s + load + util.i64_to_string(m) + ", " + r.a + "\n    mul" + x + " " + r.c + "\n";
    }
    if (!mu.add) {
      s = s + "    shr" + x + " $" + util.i32_to_string(mu.s) + ", " + r.d + "\n    mov" + x + " " + r.d + ", " + r.a + "\n";
    } else {
      // A magic one bit wider than the word. Averaging the dividend and
      // the high half by shifting keeps the carry a plain add would drop
      // off the top.
      s = s + "    mov" + x + " " + r.c + ", " + r.a + "\n    sub" + x + " " + r.d + ", " + r.a + "\n";
      s = s + "    shr" + x + " $1, " + r.a + "\n    add" + x + " " + r.d + ", " + r.a + "\n";
      s = s + "    shr" + x + " $" + util.i32_to_string(mu.s - 1) + ", " + r.a + "\n";
    }
  } else {
    let ms: ir.MagicS = ir.derive_magic_s(d, r.bits);
    s = s + load + util.i64_to_string(ms.m) + ", " + r.a + "\n    imul" + x + " " + r.c + "\n";
    if (ms.add) {
      s = s + "    add" + x + " " + r.c + ", " + r.d + "\n";
    }
    if (ms.sub) {
      s = s + "    sub" + x + " " + r.c + ", " + r.d + "\n";
    }
    if (ms.s != 0) {
      s = s + "    sar" + x + " $" + util.i32_to_string(ms.s) + ", " + r.d + "\n";
    }
    // The shift floors, so a negative quotient is one too low.
    s = s + "    mov" + x + " " + r.d + ", " + r.a + "\n    shr" + x + " $" + util.i32_to_string(r.bits - 1) + ", " + r.d + "\n";
    s = s + "    add" + x + " " + r.d + ", " + r.a + "\n";
  }
  if (is_rem) {
    // r = x - (x / d) * d, with the dividend still in %ecx. imul takes at
    // most a 32-bit immediate.
    if (d == (d as i32) as i64) {
      s = s + "    imul" + x + " $" + util.i64_to_string(d) + ", " + r.a + ", " + r.a + "\n";
    } else {
      s = s + "    movabsq $" + util.i64_to_string(d) + ", %rdx\n    imulq %rdx, %rax\n";
    }
    s = s + "    sub" + x + " " + r.a + ", " + r.c + "\n    mov" + x + " " + r.c + ", " + r.a + "\n";
  }
  return s;
}

// ir_div_const_generic is the divide itself, for the most negative divisor,
// which has no positive magnitude to take a reciprocal of: the guarded
// sequence with both guards and all four labels gone, since the divisor is
// neither zero nor -1.
function ir_div_const_generic(r: DivRegs, uns: boolean, is_rem: boolean, k: i64): string {
  let s: string = "    movl $" + util.i64_to_string(k) + ", %ecx\n";
  if (r.bits == 64) {
    s = "    movabsq $" + util.i64_to_string(k) + ", %rcx\n";
  }
  if (uns) {
    s = s + "    xorl %edx, %edx\n    div" + r.sfx + " " + r.c + "\n";
  } else if (r.bits == 64) {
    s = s + "    cqto\n    idivq %rcx\n";
  } else {
    s = s + "    cltd\n    idivl %ecx\n";
  }
  if (is_rem) {
    s = s + "    mov" + r.sfx + " " + r.d + ", " + r.a + "\n";
  }
  return s;
}

// ir_fround renders __round_f64 — round-half-AWAY-from-zero (Go's math.Round).
// roundsd only offers ties-to-even / floor / ceil / trunc, so the answer is
// built from trunc plus an exact fractional-part test, mirroring native
// emitF64UnaryIntrinsic:
//
//     t = trunc(x); if (|x - t| >= 0.5) { t = t + copysign(1.0, x); }
//
// x - t is exact by construction, which the shorter trunc(x + copysign(0.5, x))
// identity is not: the addition rounds first, so it answered 1 for
// 0.5 - 2^-54 and shifted EVERY integral double at or above 2^52 by one (#7880).
// The ucomisd/jb pair also carries NaN and the infinities through untouched —
// their |x - t| is NaN, which leaves CF set, so the bump is skipped.
// `lb` is a per-op-unique label base.
function ir_fround_rax(lb: string, d: string): string {
  let s: string = "    movq " + d + ", %xmm0\n";  // x
  s = s + "    roundsd $3, %xmm0, %xmm1\n";  // t = trunc(x)
  s = s + "    subsd %xmm1, %xmm0\n";  // frac = x - t
  s = s + "    movq %xmm0, %rcx\n    movabsq $0x7fffffffffffffff, %rdx\n    andq %rdx, %rcx\n";
  s = s + "    movq %rcx, %xmm0\n";  // |frac|
  s = s + "    movabsq $0x3fe0000000000000, %rcx\n    movq %rcx, %xmm2\n";  // 0.5
  s = s + "    ucomisd %xmm2, %xmm0\n    jb " + lb + "_rdone\n";
  s = s + "    movq " + d + ", %rcx\n    movabsq $0x8000000000000000, %rdx\n    andq %rdx, %rcx\n";
  s = s + "    movabsq $0x3ff0000000000000, %rdx\n    orq %rdx, %rcx\n";  // copysign(1.0, x)
  s = s + "    movq %rcx, %xmm0\n    addsd %xmm0, %xmm1\n";
  s = s + lb + "_rdone:\n    movq %xmm1, " + d + "\n";
  return s;
}

// ir_f2i_sat renders a saturating f64 -> signed integer truncation (operand
// bits on the rt-stack, result on the rt-stack). x86 cvttsd2si is NOT
// saturating — it returns the 0x8000.. "integer indefinite" on NaN/overflow
// and otherwise wraps — but the contract (docs/FLOAT-SEMANTICS.md) is total:
// NaN -> 0, +overflow -> INT_MAX, -overflow -> INT_MIN. Mirror native
// emitFloatToIntSat. `lb` is a per-op-unique label base. width is 32 or 64. (#4332)
function ir_f2i_sat_rax(width: i32, lb: string, d: string): string {
  if (width != 64) {
    // i32: clamp the DOUBLE into [INT32_MIN, INT32_MAX] (as f64 bit
    // patterns) so cvttsd2si never hits its sentinel, after an explicit
    // NaN -> 0. minsd/maxsd here are safe because NaN is already handled.
    let s: string = "    movq " + d + ", %xmm0\n";
    s = s + "    ucomisd %xmm0, %xmm0\n    jp " + lb + "_nan\n";
    s = s + "    movabsq $0x41dfffffffc00000, %rcx\n    movq %rcx, %xmm1\n    minsd %xmm1, %xmm0\n";  // INT32_MAX as f64
    s = s + "    movabsq $0xc1e0000000000000, %rcx\n    movq %rcx, %xmm1\n    maxsd %xmm1, %xmm0\n";  // INT32_MIN as f64
    s = s + "    cvttsd2si %xmm0, " + ssa_r32(d) + "\n    movslq " + ssa_r32(d) + ", " + d + "\n    jmp " + lb + "_done\n";
    s = s + lb + "_nan:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n";
    s = s + lb + "_done:\n";
    return s;
  }
  // i64: cvttsd2si is exact for in-range values; only NaN and |x| >= 2^63
  // yield the INT64_MIN sentinel. On the sentinel, disambiguate via x:
  // NaN -> 0, x > 0 -> INT64_MAX, else keep INT64_MIN (also the correct
  // answer for the exact -2^63 input).
  let s64: string = "    movq " + d + ", %xmm0\n    cvttsd2si %xmm0, " + d + "\n";
  s64 = s64 + "    movabsq $0x8000000000000000, %rcx\n    cmpq %rcx, " + d + "\n    jne " + lb + "_done\n";
  s64 = s64 + "    ucomisd %xmm0, %xmm0\n    jp " + lb + "_nan\n";
  s64 = s64 + "    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm0\n    jbe " + lb + "_done\n";
  s64 = s64 + "    movabsq $0x7fffffffffffffff, " + d + "\n    jmp " + lb + "_done\n";
  s64 = s64 + lb + "_nan:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n";
  s64 = s64 + lb + "_done:\n";
  return s64;
}

// ir_f2u_sat renders a saturating f64 -> UNSIGNED integer truncation (#4332)
// — the unsigned sibling of ir_f2i_sat, mirroring native emitFloatToIntSat's
// unsigned shapes: NaN / x < 0 -> 0, x >= 2^width -> all-ones. `lb` is a
// per-op-unique label base. width is 32 or 64.
function ir_f2u_sat_rax(width: i32, lb: string, d: string): string {
  if (width != 64) {
    // u32: convert with 64-bit headroom (rax covers the whole u32 range
    // exactly), then clamp against the ORIGINAL float: x < 0 / NaN -> 0
    // (ucomisd sets CF on less-than AND on unordered, so one jb catches
    // both), x >= 2^32 -> u32::MAX.
    let s: string = "    movq " + d + ", %xmm0\n    cvttsd2si %xmm0, " + d + "\n";
    s = s + "    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm0\n    jb " + lb + "_zero\n";
    s = s + "    movabsq $0x41f0000000000000, %rcx\n    movq %rcx, %xmm1\n";  // 2^32 as f64
    s = s + "    ucomisd %xmm1, %xmm0\n    jae " + lb + "_max\n    jmp " + lb + "_done\n";
    s = s + lb + "_zero:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n    jmp " + lb + "_done\n";
    s = s + lb + "_max:\n    movl $0xffffffff, " + ssa_r32(d) + "\n";  // zero-extends into rax
    s = s + lb + "_done:\n";
    return s;
  }
  // u64: cvttsd2si only covers [0, 2^63); for x >= 2^63 convert x - 2^63 and
  // set bit 63 back. The original x is saved in xmm2 (the subtraction
  // mutates xmm0) and the edge clamps compare against it: x < 0 / NaN -> 0,
  // x >= 2^64 -> u64::MAX.
  let u: string = "    movq " + d + ", %xmm0\n    movaps %xmm0, %xmm2\n";
  u = u + "    movabsq $0x43e0000000000000, %rcx\n    movq %rcx, %xmm1\n";  // 2^63 as f64
  u = u + "    ucomisd %xmm1, %xmm0\n    jae " + lb + "_big\n";
  u = u + "    cvttsd2si %xmm0, " + d + "\n    jmp " + lb + "_sat\n";
  u = u + lb + "_big:\n    subsd %xmm1, %xmm0\n    cvttsd2si %xmm0, " + d + "\n";
  u = u + "    movabsq $0x8000000000000000, %rcx\n    xorq %rcx, " + d + "\n";
  u = u + lb + "_sat:\n    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm2\n    jb " + lb + "_zero\n";
  u = u + "    movabsq $0x43f0000000000000, %rcx\n    movq %rcx, %xmm1\n";  // 2^64 as f64
  u = u + "    ucomisd %xmm1, %xmm2\n    jae " + lb + "_umax\n    jmp " + lb + "_done\n";
  u = u + lb + "_zero:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n    jmp " + lb + "_done\n";
  u = u + lb + "_umax:\n    movq $-1, " + d + "\n";
  u = u + lb + "_done:\n";
  return u;
}

// emit_scan_set_blocks is scan_set over a constant set, 32 bytes a turn with
// AVX2 and then one 16-byte turn (asmcore.scan_set_tables for the layout). A
// byte x is a member when bit (x >> 4) & 7 of its row is set, the row being the
// low-nibble table for x < 0x80 and the high one otherwise: vpshufb zeroes a
// lane whose index has bit 7 set, so `x & 0x8f` reads the first table only for
// a low byte and `(x ^ 0x80) & 0x8f` the second only for a high one, and or-ing
// the two rows gives the right row everywhere. vpshufb looks up within each
// 128-bit lane, so every table is broadcast to both. The set operand is popped
// and not read. %r11 holds the tables, %r9 the block cursor against %r10, the
// last address a 16-byte block can start at. A set that is a range or a few
// bytes skips the tables for a cheaper test (asmcore.scan_set_shape).
function emit_scan_set_blocks(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let names: string[] = [];
  while (names.len() < 9) {
    let lo: asmcore.LabelOut = asmcore.fresh_label(s);
    names = names.append(lo.name);
    s = lo.state;
  }
  let lit: asmcore.StringLitOut = asmcore.add_string_lit(asmcore.EmitState { ...s }, asmcore.scan_set_tables(o.str));
  s = lit.state;
  let tables: string = asmcore.str_lit_label(s, lit.idx);
  let l_from_ok: string = names[0];
  let l_loop: string = names[1];
  let l_hit16: string = names[2];
  let l_tail: string = names[3];
  let l_hit: string = names[4];
  let l_end: string = names[5];
  let l_done: string = names[6];
  let l_half: string = names[7];
  let l_rest: string = names[8];
  s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n");
  if (o.kind_tag == 361) {
    s = s.write("    movq (%rax), %r8\n    addq $8, %rax\n");
  } else {
    s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
  }
  s = s.write("    testq %rcx, %rcx\n    jns " + l_from_ok + "\n    xorq %rcx, %rcx\n");
  s = s.write(l_from_ok + ":\n    leaq " + tables + "(%rip), %r11\n");
  s = s.write("    leaq (%rax,%rcx), %r9\n    leaq -16(%rax,%r8), %r10\n");
  s = s.write("    cmpq %r10, %r9\n    jg " + l_tail + "\n");
  let shape: asmcore.ScanShape = asmcore.scan_set_shape(o.str);
  s = s.write(scan_set_setup(shape));
  s = s.write(l_loop + ":\n    leaq 16(%r9), %rdx\n    cmpq %r10, %rdx\n    jg " + l_half + "\n");
  s = s.write("    vmovdqu (%r9), %ymm0\n" + scan_set_classify(shape, "ymm") + "    vpmovmskb %ymm1, %edx\n");
  if (shape.invert) {
    s = s.write("    notl %edx\n");
  }
  s = s.write("    testl %edx, %edx\n    jnz " + l_hit16 + "\n");
  s = s.write("    addq $32, %r9\n    jmp " + l_loop + "\n");
  s = s.write(l_half + ":\n    cmpq %r10, %r9\n    jg " + l_rest + "\n");
  s = s.write("    vmovdqu (%r9), %xmm0\n" + scan_set_classify(shape, "xmm") + "    vpmovmskb %xmm1, %edx\n");
  if (shape.invert) {
    s = s.write("    xorl $65535, %edx\n");
  }
  s = s.write("    testl %edx, %edx\n    jnz " + l_hit16 + "\n    addq $16, %r9\n");
  s = s.write(l_rest + ":\n    vzeroupper\n    movq %r9, %rcx\n    subq %rax, %rcx\n    jmp " + l_tail + "\n");
  s = s.write(l_hit16 + ":\n    vzeroupper\n    bsfl %edx, %edx\n    subq %rax, %r9\n    addq %rdx, %r9\n");
  s = s.write("    pushq %r9\n    jmp " + l_done + "\n");
  // Under sixteen bytes left: the membership bytes at 96, one at a time.
  s = s.write(l_tail + ":\n    cmpq %r8, %rcx\n    jge " + l_end + "\n");
  s = s.write("    movzbq (%rax,%rcx), %r9\n    cmpb $0, 96(%r11,%r9)\n    jne " + l_hit + "\n");
  s = s.write("    addq $1, %rcx\n    jmp " + l_tail + "\n");
  s = s.write(l_hit + ":\n    pushq %rcx\n    jmp " + l_done + "\n");
  s = s.write(l_end + ":\n    pushq %r8\n");
  return s.write(l_done + ":\n");
}

// scan_set_setup loads what scan_set_classify reads for `shape` into
// %ymm2 onwards: the six nibble tables, or each of the shape's bytes broadcast.
function scan_set_setup(shape: asmcore.ScanShape): string {
  if (shape.nibble) {
    return "    vbroadcasti128 (%r11), %ymm2\n    vbroadcasti128 16(%r11), %ymm3\n    vbroadcasti128 32(%r11), %ymm4\n"
      + "    vbroadcasti128 48(%r11), %ymm5\n    vbroadcasti128 64(%r11), %ymm6\n    vbroadcasti128 80(%r11), %ymm7\n";
  }
  let r: string = "";
  let j: i32 = 0;
  while (j < shape.bytes.len()) {
    r = r + "    vpbroadcastb " + util.i32_to_string(352 + j) + "(%r11), %ymm" + util.i32_to_string(2 + j) + "\n";
    j = j + 1;
  }
  return r;
}

// scan_set_classify sets each byte lane of %<w>1 to all-ones where the lane of
// %<w>0 passes the shape's test, from what scan_set_setup loaded into %<w>2
// onwards; an inverted shape's members are the lanes left zero.
function scan_set_classify(shape: asmcore.ScanShape, w: string): string {
  if (shape.nibble) {
    return scan_set_classify_nibble(w);
  }
  let r: string = "";
  let j: i32 = 0;
  if (shape.range) {
    r = "    vpsubb %" + w + "2, %" + w + "0, %" + w + "1\n    vpminub %" + w + "3, %" + w + "1, %" + w + "8\n"
      + "    vpcmpeqb %" + w + "8, %" + w + "1, %" + w + "1\n";
    j = 2;
  } else {
    r = "    vpcmpeqb %" + w + "2, %" + w + "0, %" + w + "1\n";
    j = 1;
  }
  while (j < shape.bytes.len()) {
    r = r + "    vpcmpeqb %" + w + util.i32_to_string(2 + j) + ", %" + w + "0, %" + w + "8\n    vpor %" + w + "8, %" + w + "1, %" + w + "1\n";
    j = j + 1;
  }
  return r;
}

// scan_set_classify_nibble is the nibble-table test (asmcore.scan_set_tables).
function scan_set_classify_nibble(w: string): string {
  let r: string = "    vpand %" + w + "5, %" + w + "0, %" + w + "1\n";
  r = r + "    vpxor %" + w + "6, %" + w + "0, %" + w + "8\n    vpand %" + w + "5, %" + w + "8, %" + w + "8\n";
  r = r + "    vpshufb %" + w + "1, %" + w + "2, %" + w + "9\n";
  r = r + "    vpshufb %" + w + "8, %" + w + "3, %" + w + "1\n    vpor %" + w + "9, %" + w + "1, %" + w + "1\n";
  r = r + "    vpsrlw $4, %" + w + "0, %" + w + "0\n    vpand %" + w + "7, %" + w + "0, %" + w + "0\n";
  r = r + "    vpshufb %" + w + "0, %" + w + "4, %" + w + "8\n";
  return r + "    vpand %" + w + "8, %" + w + "1, %" + w + "1\n    vpcmpeqb %" + w + "8, %" + w + "1, %" + w + "1\n";
}

// set_entry_test tests entry `idx` of the set on %rdx for zero: the low byte
// of the 8-byte slot 8 + idx*8, or byte 8 + idx of a packed u8[] (ir.packed).
function set_entry_test(o: ir.Op, idx: string): string {
  if (ir.is_packed(o)) {
    return "cmpb $0, 8(%rdx," + idx + ")";
  }
  return "cmpq $0, 8(%rdx," + idx + ",8)";
}

// emit_str_op emits one string operand-stack op (the bodies factored out of
// emit_stack_op's dispatch — see ir.is_str_op_kind). Each pops its box
// operand(s), calls the matching __fern_str_* runtime, and pushes the result;
// the registered needs pull in the helper bodies (emit_ir_runtime).
// emit_mismatch_x86 emits the __mismatch kernel (#8791): operand stack
// [a box, ao, b box, bo, n] (n on top) -> the offset of the first byte where
// a[ao..ao+n) and b[bo..bo+n) differ, or the clamped n when they are equal.
//
// SSE2, 16 bytes of each operand an iteration: movdqu / pcmpeqb / pmovmskb,
// where the mask means EQUAL rather than memchr's FOUND, so the loop runs
// while it is all-ones and `not` precedes the bsf.
//
// Sub-16 ranges take memcmp's OVERLAPPING WINDOWS rather than the scalar
// remainder — the leading and trailing 8 (or 4) bytes, which overlap, so two
// loads per operand cover the whole band. A line-oriented caller compares
// SHORT ranges, and walking those a byte at a time is the cost this kernel
// exists to remove.
//
// The clamps are the op's contract, not defensive tidying: the value returned
// on equality is the clamped n, so a caller asking for more than either range
// holds gets the shorter answer and its `== n` test fails.
//
// %rsi and %rcx become the two range base POINTERS and %rdx the shared cursor
// index, which keeps every memory operand on a low register; %r8 holds the
// clamped n (also the answer on equality) and %rdi is the window offset.
// This is a leaf body — no call, so every register it touches is free.
function emit_mismatch_x86(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let mlo: asmcore.LabelOut = asmcore.fresh_label(s);
  let lb: string = mlo.name;
  s = mlo.state;
  s = s.write("    popq %r8\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %rax\n");
  // A packed array holds its length at 0 and its bytes from 8; a string box
  // holds its data pointer at 0 and its length at 8. mismatch_bytes_str
  // takes an array as `a` and a string as `b`.
  if (o.kind_tag == 378 || o.kind_tag == 446) {
    s = s.write("    movq (%rax), %r9\n    addq $8, %rax\n");
  } else {
    s = s.write("    movq 8(%rax), %r9\n    movq (%rax), %rax\n");
  }
  if (o.kind_tag == 378) {
    s = s.write("    movq (%rdx), %r10\n    addq $8, %rdx\n");
  } else {
    s = s.write("    movq 8(%rdx), %r10\n    movq (%rdx), %rdx\n");
  }
  // Each offset clamps into [0, len] of its own string.
  s = s.write("    cmpq $0, %rsi\n    jge " + lb + "_aop\n    xorq %rsi, %rsi\n");
  s = s.write(lb + "_aop:\n    cmpq %r9, %rsi\n    jle " + lb + "_aok\n    movq %r9, %rsi\n");
  s = s.write(lb + "_aok:\n    cmpq $0, %rcx\n    jge " + lb + "_bop\n    xorq %rcx, %rcx\n");
  s = s.write(lb + "_bop:\n    cmpq %r10, %rcx\n    jle " + lb + "_bok\n    movq %r10, %rcx\n");
  // n = min(n, len(a) - ao, len(b) - bo), floored at 0.
  s = s.write(lb + "_bok:\n    subq %rsi, %r9\n    subq %rcx, %r10\n");
  s = s.write("    cmpq %r9, %r8\n    jle " + lb + "_na\n    movq %r9, %r8\n");
  s = s.write(lb + "_na:\n    cmpq %r10, %r8\n    jle " + lb + "_nb\n    movq %r10, %r8\n");
  s = s.write(lb + "_nb:\n    cmpq $0, %r8\n    jge " + lb + "_nok\n    xorq %r8, %r8\n");
  s = s.write(lb + "_nok:\n");
  if (o.kind_tag == 378 && !ir.is_packed(o)) {
    s = s.write("    leaq (%rax,%rsi,8), %rsi\n    leaq (%rdx,%rcx,8), %rcx\n    xorq %rdx, %rdx\n");
    s = s.write(lb + "_slots:\n    cmpq %r8, %rdx\n    jge " + lb + "_slots_done\n");
    s = s.write("    movzbq (%rsi,%rdx,8), %rax\n    movzbq (%rcx,%rdx,8), %rdi\n    cmpq %rdi, %rax\n    jne " + lb + "_slots_done\n");
    s = s.write("    addq $1, %rdx\n    jmp " + lb + "_slots\n");
    return s.write(lb + "_slots_done:\n    pushq %rdx\n");
  }
  s = s.write("    addq %rax, %rsi\n    addq %rdx, %rcx\n    xorq %rdx, %rdx\n");
  // Length dispatch: the sub-16 band never reaches the vector loop, so it
  // gets its own windows rather than a byte walk.
  s = s.write("    cmpq $16, %r8\n    jge " + lb + "_vec\n");
  s = s.write("    cmpq $8, %r8\n    jge " + lb + "_w8\n");
  s = s.write("    cmpq $4, %r8\n    jge " + lb + "_w4\n    jmp " + lb + "_tail\n");
  // 8..15 bytes: the leading 8 and the trailing 8, which overlap.
  s = s.write(lb + "_w8:\n    movq (%rsi), %rax\n    xorq (%rcx), %rax\n    jnz " + lb + "_w8l\n");
  s = s.write("    movq %r8, %rdi\n    subq $8, %rdi\n");
  s = s.write("    movq (%rsi,%rdi), %rax\n    xorq (%rcx,%rdi), %rax\n    jz " + lb + "_eq\n");
  // The leading window proved [0, 8) equal, so a difference the trailing
  // window reports cannot land below 8 — its offset is the first one.
  s = s.write("    bsfq %rax, %rax\n    shrq $3, %rax\n    addq %rdi, %rax\n    jmp " + lb + "_done\n");
  // bsf finds the lowest set BIT of the xor; >> 3 turns it into the byte,
  // little-endian, so byte 0 is the low one.
  s = s.write(lb + "_w8l:\n    bsfq %rax, %rax\n    shrq $3, %rax\n    jmp " + lb + "_done\n");
  // 4..7 bytes: the same pair of windows, four bytes wide.
  s = s.write(lb + "_w4:\n    movl (%rsi), %eax\n    xorl (%rcx), %eax\n    jnz " + lb + "_w4l\n");
  s = s.write("    movq %r8, %rdi\n    subq $4, %rdi\n");
  s = s.write("    movl (%rsi,%rdi), %eax\n    xorl (%rcx,%rdi), %eax\n    jz " + lb + "_eq\n");
  s = s.write("    bsfl %eax, %eax\n    shrl $3, %eax\n    addq %rdi, %rax\n    jmp " + lb + "_done\n");
  s = s.write(lb + "_w4l:\n    bsfl %eax, %eax\n    shrl $3, %eax\n    jmp " + lb + "_done\n");
  // SSE2 loop, 16 bytes of each operand per iteration. The load runs only
  // with a full block left in both ranges, so it never reads past either.
  s = s.write(lb + "_vec:\n    movq %r8, %rax\n    subq %rdx, %rax\n    cmpq $16, %rax\n    jl " + lb + "_tail\n");
  s = s.write("    movdqu (%rsi,%rdx), %xmm0\n    movdqu (%rcx,%rdx), %xmm1\n");
  s = s.write("    pcmpeqb %xmm1, %xmm0\n    pmovmskb %xmm0, %eax\n");
  s = s.write("    cmpl $65535, %eax\n    jne " + lb + "_hit\n");
  s = s.write("    addq $16, %rdx\n    jmp " + lb + "_vec\n");
  // pmovmskb writes only the low 16 bits, so `not` sets the top half; the
  // branch above guarantees a clear bit below 16, which is the one bsf
  // finds first.
  s = s.write(lb + "_hit:\n    notl %eax\n    bsfl %eax, %eax\n    addq %rdx, %rax\n    jmp " + lb + "_done\n");
  // Scalar remainder: fewer than 16 bytes left after the vector loop, or
  // fewer than 4 from the dispatch above.
  s = s.write(lb + "_tail:\n    cmpq %r8, %rdx\n    jge " + lb + "_eq\n");
  s = s.write("    movzbq (%rsi,%rdx), %rax\n    movzbq (%rcx,%rdx), %rdi\n");
  s = s.write("    cmpq %rdi, %rax\n    jne " + lb + "_th\n");
  s = s.write("    addq $1, %rdx\n    jmp " + lb + "_tail\n");
  s = s.write(lb + "_th:\n    movq %rdx, %rax\n    jmp " + lb + "_done\n");
  s = s.write(lb + "_eq:\n    movq %r8, %rax\n");
  s = s.write(lb + "_done:\n    pushq %rax\n");
  return s;
}

function emit_outer_mul_f64(s: asmcore.EmitState): asmcore.EmitState {
  let a: asmcore.LabelOut = asmcore.fresh_label(s);
  let b: asmcore.LabelOut = asmcore.fresh_label(a.state);
  let c: asmcore.LabelOut = asmcore.fresh_label(b.state);
  let d: asmcore.LabelOut = asmcore.fresh_label(c.state);
  s = d.state;
  // Allocate before any vector becomes live. Source lengths are at most i32,
  // so their 64-bit product cannot overflow before the bounds comparison.
  s = s.write("    popq %rsi\n    popq %rdx\n    movq (%rdx), %rdi\n    imulq (%rsi), %rdi\n    cmpq $2147483647, %rdi\n    ja __fern_oob_abort\n");
  s = s.write("    pushq %rdx\n    pushq %rsi\n    call __fern_arr_box\n    popq %rsi\n    popq %rdx\n");
  s = s.write("    leaq 8(%rax), %r11\n    xorq %r8, %r8\n    movq (%rsi), %r10\n    testq %r10, %r10\n    jz " + d.name + "\n    andq $-2, %r10\n");
  s = s.write(a.name + ":\n    cmpq (%rdx), %r8\n    jge " + d.name + "\n");
  s = s.write("    movsd 8(%rdx,%r8,8), %xmm1\n    unpcklpd %xmm1, %xmm1\n    xorq %rcx, %rcx\n");
  s = s.write(b.name + ":\n    cmpq %r10, %rcx\n    jge " + c.name + "\n");
  // The left operand stays left, including for NaN payload selection.
  s = s.write("    movupd 8(%rsi,%rcx,8), %xmm0\n    movapd %xmm1, %xmm2\n    mulpd %xmm0, %xmm2\n    movupd %xmm2, (%r11)\n    addq $16, %r11\n    addq $2, %rcx\n    jmp " + b.name + "\n");
  s = s.write(c.name + ":\n    cmpq (%rsi), %rcx\n    jge " + c.name + "_next\n");
  s = s.write("    movsd 8(%rsi,%rcx,8), %xmm0\n    movapd %xmm1, %xmm2\n    mulsd %xmm0, %xmm2\n    movsd %xmm2, (%r11)\n    addq $8, %r11\n");
  s = s.write(c.name + "_next:\n    addq $1, %r8\n    jmp " + a.name + "\n");
  s = s.write(d.name + ":\n    pushq %rax\n");
  return s.need("heap");
}

function emit_inner_mul_add_f64(s: asmcore.EmitState): asmcore.EmitState {
  let label: asmcore.LabelOut = asmcore.fresh_label(s);
  s = label.state;
  let lb: string = label.name;
  s = s.write("    popq %r9\n    popq %r8\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %r10\n");
  s = s.write("    testl %edx, %edx\n    js __fern_oob_abort\n    testl %ecx, %ecx\n    js __fern_oob_abort\n    testl %r8d, %r8d\n    js __fern_oob_abort\n    movl %edx, %edx\n    movl %ecx, %ecx\n    movl %r8d, %r8d\n");
  s = s.write("    movq %rdx, %rdi\n    imulq %rcx, %rdi\n    cmpq (%r10), %rdi\n    jne __fern_oob_abort\n    movq %rcx, %rdi\n    imulq %r8, %rdi\n    cmpq (%rsi), %rdi\n    jne __fern_oob_abort\n    movq %rdx, %rdi\n    imulq %r8, %rdi\n    cmpq $2147483647, %rdi\n    ja __fern_oob_abort\n");
  // No vector is live over allocation. Save only the six scalar inputs.
  s = s.write("    pushq %r10\n    pushq %rsi\n    pushq %rdx\n    pushq %rcx\n    pushq %r8\n    pushq %r9\n    call __fern_arr_box\n    popq %r9\n    popq %r8\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %r10\n    pushq %rax\n");
  s = s.write("    testq %rdx, %rdx\n    jz " + lb + "_done\n    testq %r8, %r8\n    jz " + lb + "_done\n    leaq 8(%rax), %r11\n    leaq 8(%r10), %rdi\n    addq $8, %rsi\n    movq %r9, %xmm3\n    unpcklpd %xmm3, %xmm3\n");
  s = s.write(lb + "_row:\n    xorq %r10, %r10\n" + lb + "_pair:\n    leaq 1(%r10), %rax\n    cmpq %r8, %rax\n    jge " + lb + "_tail\n    leaq (%rsi,%r10,8), %rax\n    movapd %xmm3, %xmm2\n    xorq %r9, %r9\n");
  s = s.write(lb + "_k:\n    cmpq %rcx, %r9\n    jge " + lb + "_store\n    movsd (%rdi,%r9,8), %xmm1\n    unpcklpd %xmm1, %xmm1\n    movupd (%rax), %xmm0\n    mulpd %xmm0, %xmm1\n    addpd %xmm1, %xmm2\n    leaq (%rax,%r8,8), %rax\n    addq $1, %r9\n    jmp " + lb + "_k\n");
  s = s.write(lb + "_store:\n    movupd %xmm2, (%r11)\n    addq $16, %r11\n    addq $2, %r10\n    jmp " + lb + "_pair\n");
  s = s.write(lb + "_tail:\n    cmpq %r8, %r10\n    jge " + lb + "_next\n    leaq (%rsi,%r10,8), %rax\n    movapd %xmm3, %xmm2\n    xorq %r9, %r9\n");
  s = s.write(lb + "_scalar:\n    cmpq %rcx, %r9\n    jge " + lb + "_scalar_store\n    movsd (%rdi,%r9,8), %xmm1\n    mulsd (%rax), %xmm1\n    addsd %xmm1, %xmm2\n    leaq (%rax,%r8,8), %rax\n    addq $1, %r9\n    jmp " + lb + "_scalar\n");
  s = s.write(lb + "_scalar_store:\n    movsd %xmm2, (%r11)\n    addq $8, %r11\n" + lb + "_next:\n    leaq (%rdi,%rcx,8), %rdi\n    subq $1, %rdx\n    jnz " + lb + "_row\n" + lb + "_done:\n");
  // The saved result is already the single operand-stack output.
  return s.need("heap");
}

function emit_str_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  if (o.kind_tag == 384 || o.kind_tag == 385) {
    let reg: string = "rdx";
    if (o.width == 64) {
      reg = ["rdx", "rcx", "r11"][o.i32_imm];
    }
    if (o.kind_tag == 384) {
      return s.write("    popq %" + reg + "\n    pushq %" + reg + "\n");
    }
    return s.write("    pushq %" + reg + "\n");
  }
  if (o.kind_tag == 383) {
    s = s.write("    popq %rdi\n    testl %edi, %edi\n    js __fern_oob_abort\n    movl %edi, %edi\n");
    if (o.width == 8) {
      s = s.write("    addq $7, %rdi\n    shrq $3, %rdi\n");
    }
    s = s.write("    call __fern_arr_box\n    movq $0, (%rax)\n    pushq %rax\n");
    return s.need("heap");
  }
  if (o.kind_tag == 382) {
    return emit_inner_mul_add_f64(s);
  }
  if (ir.is_aes_gcm_op(o.kind_tag)) {
    return emit_aes_gcm_op(o, s);
  }
  if (o.kind_tag == 410) {  // sha256_hw_blocks
    s = s.need("sha256").need("heap");
    return s.write("    popq %rsi\n    popq %rdi\n    call __fern_sha256_hw_blocks\n    pushq %rax\n");
  }
  if (o.kind_tag == 381) {
    return emit_outer_mul_f64(s);
  }
  if (o.kind_tag == 225 || o.kind_tag == 358) {  // memchr / memchr_bytes
    // operand stack [box, byte, from] (from on top) -> i32 index or -1.
    //
    // The needle is splat across xmm1 and broadcast to ymm1; then 32
    // bytes an iteration with AVX2 while at least 32 remain, 16 with
    // SSE2 while at least 16 remain, and a scalar tail — the same three
    // tiers as native's __fern_memchr. Each vector load runs only with a
    // whole block left, so it never reads past the string and needs no
    // alignment prologue; the tail is the whole algorithm for anything
    // shorter than one block. vzeroupper on every way out of the AVX
    // loop, since the SSE loop and the caller are legacy-SSE code.
    //
    // Between tiers the cursor is an INDEX in %rdx (%rax data, %rcx byte,
    // %r8 len, %r9 scratch), so the SSE2 loop and the tail need no index
    // reconstructed on a hit.
    //
    // No feature detection: AVX2 and popcnt are inside the x86-64-v3
    // baseline, hard requirements rather than a fast path.
    let mlo: asmcore.LabelOut = asmcore.fresh_label(s);
    let l_clamped: string = mlo.name;
    let mlo2: asmcore.LabelOut = asmcore.fresh_label(mlo.state);
    let l_vec: string = mlo2.name;
    let mlo3: asmcore.LabelOut = asmcore.fresh_label(mlo2.state);
    let l_hit: string = mlo3.name;
    let mlo4: asmcore.LabelOut = asmcore.fresh_label(mlo3.state);
    let l_tail: string = mlo4.name;
    let mlo5: asmcore.LabelOut = asmcore.fresh_label(mlo4.state);
    let l_none: string = mlo5.name;
    let mlo6: asmcore.LabelOut = asmcore.fresh_label(mlo5.state);
    let l_done: string = mlo6.name;
    let mlo7: asmcore.LabelOut = asmcore.fresh_label(mlo6.state);
    let l_avx: string = mlo7.name;
    let mlo8: asmcore.LabelOut = asmcore.fresh_label(mlo7.state);
    let l_hit32: string = mlo8.name;
    let mlo9: asmcore.LabelOut = asmcore.fresh_label(mlo8.state);
    let l_avx_done: string = mlo9.name;
    s = mlo9.state;
    s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n");
    if (o.kind_tag == 358) {
      s = s.write("    movq (%rax), %r8\n    addq $8, %rax\n");
    } else {
      s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
    }
    // from clamps at 0.
    s = s.write("    cmpq $0, %rdx\n    jge " + l_clamped + "\n    xorq %rdx, %rdx\n");
    s = s.write(l_clamped + ":\n");
    // A byte outside 0..255 can never match. One UNSIGNED compare covers
    // both ends: a negative arrives as a huge unsigned and fails it too.
    // Checked once here, so neither loop needs a per-iteration guard.
    s = s.write("    cmpq $255, %rcx\n    ja " + l_none + "\n");
    if (o.kind_tag == 358 && !ir.is_packed(o)) {
