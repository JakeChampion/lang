  s = s.write("    movl $1, (%rax)\n");  // rc = 1 @ base
  s = s.write("    movl $" + util.i32_to_string(fused_marker()) + ", 4(%rax)\n");  // fused marker @ base+4
  s = s.write("    movq %rdi, 8(%rax)\n");  // data @ base+8
  s = s.write("    movq %rsi, 16(%rax)\n");  // len  @ base+16
  s = s.write("    addq $8, %rax\n");  // box = base+8 = data-16
  s = s.write("    ret\n");
