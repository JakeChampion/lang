function emit_ir_map_hash_seed(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_map_hash_seed:\n");
  s = s.write("    movl __fern_map_seed(%rip), %eax\n");
  s = s.write("    testl %eax, %eax\n");
  s = s.write("    jne .Lmapseed_ret\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    call __fn___fern_random_i32\n");
  s = s.write("    orl $1, %eax\n");
  s = s.write("    movl %eax, __fern_map_seed(%rip)\n");
  s = s.write("    leave\n");
  s = s.write(".Lmapseed_ret:\n");
  s = s.write("    ret\n");
  return s;
}

function emit_ccall_shim1(s: asmcore.EmitState, variant: string, n: i32): asmcore.EmitState {
  s = s.write("\n__fn_" + variant + ":\n");
  s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n");
  s = s.write("    movq 16(%rbp), %r11\n");
  let regs: string[] = ["%rdi", "%rsi", "%rdx", "%rcx", "%r8", "%r9"];
  for i in 0..n {
    s = s.write("    movq " + util.i32_to_string(24 + 8 * i) + "(%rbp), " + regs[i] + "\n");
  }
  s = s.write("    andq $-16, %rsp\n");
  if (s.shared) {
    s = s.write(busy_give_x86());
  }
  s = s.write("    xorl %eax, %eax\n");
  s = s.write("    call *%r11\n");
  if (s.shared) {
    s = s.write(busy_take_x86());
  }
  if (variant.ends_with("_f32")) {
    s = s.write("    cvtss2sd %xmm0, %xmm0\n");
  }
  if (variant.ends_with("_f32") || variant.ends_with("_f64")) {
    s = s.write("    movq %xmm0, %rax\n");
  }
  s = s.write("    movq %rbp, %rsp\n    popq %rbp\n    ret\n");
  return s;
}

// The shim of a C call with float arguments: __c_callv(fn, ints, floats,
// kind) loads the eight integer argument registers from `ints` and the eight
// vector argument registers from `floats`, as the System V ABI assigns them,
// and calls fn. Unused registers get values the callee ignores. `kind` says
// which register holds the result: 0 rax, 1 the f32 in xmm0, 2 the f64. Kind
// 3 is a struct: rax, rdx, xmm0 and xmm1 go to words 0 to 3 of `floats`.
function emit_ccallv_shim(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("\n__fn___c_callv:\n    pushq %rbp\n    movq %rsp, %rbp\n");
  s = s.write("    movq 16(%rbp), %r11\n    movq 24(%rbp), %rax\n    movq 32(%rbp), %r10\n");
  for i in 0..8 {
    s = s.write("    movq " + util.i32_to_string(8 * i) + "(%r10), %xmm" + util.i32_to_string(i) + "\n");
  }
  // Integers 6 to 13 go on the stack, in the order of the arguments.
  s = s.write("    andq $-16, %rsp\n    subq $64, %rsp\n");
  for i in 0..8 {
    s = s.write("    movq " + util.i32_to_string(48 + 8 * i) + "(%rax), %r10\n    movq %r10, " + util.i32_to_string(8 * i) + "(%rsp)\n");
  }
  let regs: string[] = ["%rdi", "%rsi", "%rdx", "%rcx", "%r8", "%r9"];
  for i in 0..6 {
    s = s.write("    movq " + util.i32_to_string(8 * i) + "(%rax), " + regs[i] + "\n");
  }
  if (s.shared) {
    s = s.write(busy_give_x86());
  }
  s = s.write("    movl $8, %eax\n    call *%r11\n");
  if (s.shared) {
    s = s.write(busy_take_x86());
  }
  s = s.write("    movl 40(%rbp), %ecx\n    cmpl $1, %ecx\n    jne .Lfern_ccallv_f64\n    movd %xmm0, %eax\n    jmp .Lfern_ccallv_done\n");
  s = s.write(".Lfern_ccallv_f64:\n    cmpl $2, %ecx\n    jne .Lfern_ccallv_struct\n    movq %xmm0, %rax\n    jmp .Lfern_ccallv_done\n");
  s = s.write(".Lfern_ccallv_struct:\n    cmpl $3, %ecx\n    jne .Lfern_ccallv_done\n    movq 32(%rbp), %r10\n");
  s = s.write("    movq %rax, (%r10)\n    movq %rdx, 8(%r10)\n    movq %xmm0, 16(%r10)\n    movq %xmm1, 24(%r10)\n");
  return s.write(".Lfern_ccallv_done:\n    movq %rbp, %rsp\n    popq %rbp\n    ret\n");
}

function envp_wanted(s: asmcore.EmitState): boolean {
  return s.any_need(["env", "subprocess", "environ", "raw_environ", "temp_dir"]);
}

// A shared object has no _start. The loader calls each entry of
// .init_array with argc, argv and envp, so this entry keeps them.
function emit_shared_init_x86(s: asmcore.EmitState): asmcore.EmitState {
  let args: boolean = s.has_need("args");
  let env: boolean = envp_wanted(s);
  if (!args && !env) {
    return s;
  }
  s = s.write("__fern_shared_init:\n");
  if (args) {
    s = s.write("    movslq %edi, %rdi\n    movq %rdi, __fern_argc(%rip)\n    movq %rsi, __fern_argv(%rip)\n");
  }
  if (env) {
    s = s.write("    movq %rdx, __fern_envp(%rip)\n");
  }
  return s.write("    ret\n    .section .data\n    .align 8\n__fern_init_array:\n    .quad __fern_shared_init\n    .text\n");
}

pub function busy_take_x86(): string {
  return "    call __fern_busy_take\n";
}

pub function busy_give_x86(): string {
  return "    call __fern_busy_give\n";
}

// __fern_busy holds 0 when no thread runs Fern code, 1 when one does, and 2
// when one does and others wait. A waiter sleeps on the futex. The word
// after it is 1 from the time a give wakes a waiter until that waiter has
// the turn: a thread that asks for the turn in that time waits for at most
// 1 ms first, so the thread that gave the turn does not take it back
// before the waiter runs. Both routines keep every register except r11 and
// the flags, and __fern_busy_give keeps r11 too.
function emit_busy_lock_x86(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .bss\n    .align 8\n__fern_busy: .skip 8\n    .text\n");
  s = s.write("__fern_busy_take:\n    cmpl $0, __fern_busy+4(%rip)\n    jne .Lfern_busy_defer\n");
  s = s.write(".Lfern_busy_try:\n    movl $1, %r11d\n    xchgl %r11d, __fern_busy(%rip)\n    testl %r11d, %r11d\n    jnz .Lfern_busy_wait\n    ret\n");
  s = s.write(".Lfern_busy_defer:\n    pushq %rax\n    pushq %rcx\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    pushq %r10\n");
  s = s.write("    pushq $1000000\n    pushq $0\n");
  s = s.write("    movl $202, %eax\n    leaq __fern_busy+4(%rip), %rdi\n    movl $128, %esi\n    movl $1, %edx\n    movq %rsp, %r10\n").syscall(202);
  s = s.write("    addq $16, %rsp\n    popq %r10\n    popq %rdi\n    popq %rsi\n    popq %rdx\n    popq %rcx\n    popq %rax\n    jmp .Lfern_busy_try\n");
  s = s.write(".Lfern_busy_wait:\n    pushq %rax\n    pushq %rcx\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    pushq %r10\n");
  s = s.write(".Lfern_busy_retry:\n    movl $2, %eax\n    xchgl %eax, __fern_busy(%rip)\n    testl %eax, %eax\n    jz .Lfern_busy_won\n");
  s = s.write("    movl $202, %eax\n    leaq __fern_busy(%rip), %rdi\n    movl $128, %esi\n    movl $2, %edx\n    xorl %r10d, %r10d\n").syscall(202);
  s = s.write("    jmp .Lfern_busy_retry\n");
  // The waiter has the turn: it lets the threads that wait for it go on.
  s = s.write(".Lfern_busy_won:\n    xorl %eax, %eax\n    xchgl %eax, __fern_busy+4(%rip)\n    testl %eax, %eax\n    jz .Lfern_busy_out\n");
  s = s.write("    movl $202, %eax\n    leaq __fern_busy+4(%rip), %rdi\n    movl $129, %esi\n    movl $2147483647, %edx\n").syscall(202);
  s = s.write(".Lfern_busy_out:\n    popq %r10\n    popq %rdi\n    popq %rsi\n    popq %rdx\n    popq %rcx\n    popq %rax\n    ret\n");
  s = s.write("__fern_busy_give:\n    pushq %r11\n    xorl %r11d, %r11d\n    xchgl %r11d, __fern_busy(%rip)\n    cmpl $2, %r11d\n    je .Lfern_busy_wake\n    popq %r11\n    ret\n");
  s = s.write(".Lfern_busy_wake:\n    pushq %rax\n    pushq %rcx\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n");
  s = s.write("    movl $1, __fern_busy+4(%rip)\n");
  s = s.write("    movl $202, %eax\n    leaq __fern_busy(%rip), %rdi\n    movl $129, %esi\n    movl $1, %edx\n").syscall(202);
  // No thread woke, so no thread has the next turn.
  s = s.write("    testl %eax, %eax\n    jnz .Lfern_busy_woke\n    movl $0, __fern_busy+4(%rip)\n.Lfern_busy_woke:\n");
  return s.write("    popq %rdi\n    popq %rsi\n    popq %rdx\n    popq %rcx\n    popq %rax\n    popq %r11\n    ret\n");
}

function emit_ccall_shims(s: asmcore.EmitState): asmcore.EmitState {
  for arity in 0..=6 {
    let base = "__c_call" + util.i32_to_string(arity);
    if (s.has_need("ccall:" + base)) {
      s = emit_ccall_shim1(s, base, arity);
    }
    if (s.has_need("ccall:" + base + "_f32")) {
      s = emit_ccall_shim1(s, base + "_f32", arity);
    }
    if (s.has_need("ccall:" + base + "_f64")) {
      s = emit_ccall_shim1(s, base + "_f64", arity);
    }
  }
  if (s.has_need("ccall:__c_callv")) {
    s = emit_ccallv_shim(s);
  }
  return s;
}

function any_ccall_need(s: asmcore.EmitState): boolean {
  for arity in 0..=6 {
    let base = "__c_call" + util.i32_to_string(arity);
    if (s.has_need("ccall:" + base)) {
      return true;
    }
    if (s.has_need("ccall:" + base + "_f32")) {
      return true;
    }
    if (s.has_need("ccall:" + base + "_f64")) {
      return true;
    }
  }
  return s.has_need("ccall:__c_callv");
}

function rc_trace_on(): boolean {
  return envflag.on("FERN_RC_TRACE");
}

function rc_trace_deep_on(): boolean {
  return envflag.on("FERN_RC_TRACE_DEEP");
}

function fused_marker(): i32 {
  return 1934589965;
}

function borrowed_marker(): i32 {
  return 1112494674;
}

function grown_marker(): i32 {
  return 1196576599;
}

function rc_poison(): string {
  return "2129525454";
}

// The poison word twice, which fills the payload of a quarantined block.
function rc_poison64(): string {
  return "9146242183059077838";
}

function quarantine_rc(addr: string, on: boolean): string {
  if (on) {
    return "    movl $" + rc_poison() + ", " + addr + "\n";
  }
  return "    movl $0, " + addr + "\n";
}

// A release under -sanitize hands its block to the quarantine instead of a
// free list: `ptr` is the block base, `words` its size, and `poison_at` the
// byte offset of its count word (0 or 8), or 16 for a block with no count.
function quar_push(s: asmcore.EmitState, ptr: string, words: string, poison_at: i32): asmcore.EmitState {
  if (words != "%rsi") {
    s = s.write("    movq " + words + ", %rsi\n");
  }
  if (ptr != "%rdi") {
    s = s.write("    movq " + ptr + ", %rdi\n");
  }
  s = s.write("    movq $" + util.i32_to_string(poison_at) + ", %rdx\n");
  return s.write("    call __fern_quar_push\n");
}

// The -sanitize quarantine: a FIFO threaded through the released blocks.
// Word 2 of a block links the next, the count word keeps its poison, and
// the other of words 0 and 1 holds the size. A release past the budget
// evicts the oldest block to its free list after its poison is checked.
function emit_quarantine(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_quar_push:\n");
  s = s.write("    cmpq $3, %rsi\n");
  s = s.write("    jb .Lquar_ret\n");
  // A block of a worker region the parent is forgetting does not enter the
  // quarantine: the region goes back to the kernel at the join.
  if (s.has_need("worker_regions")) {
    s = s.write("    cmpq __fern_forget_lo(%rip), %rdi\n");
    s = s.write("    jb .Lquar_keep\n");
    s = s.write("    cmpq __fern_forget_hi(%rip), %rdi\n");
    s = s.write("    jb .Lquar_ret\n");
    s = s.write(".Lquar_keep:\n");
  }
  s = s.write("    pushq %rax\n");
  s = s.write("    pushq %rcx\n");
  s = s.write("    pushq %r8\n");
  s = s.write("    cmpq $8, %rdx\n");
  s = s.write("    je .Lquar_meta0\n");
  s = s.write("    movl $" + rc_poison() + ", (%rdi)\n");
  s = s.write("    movq %rsi, 8(%rdi)\n");
  s = s.write("    jmp .Lquar_link\n");
  s = s.write(".Lquar_meta0:\n");
  s = s.write("    movq %rsi, (%rdi)\n");
  s = s.write(".Lquar_link:\n");
  s = s.write("    movq $0, 16(%rdi)\n");
  s = s.write("    movq __fern_quar_tail(%rip), %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jz .Lquar_first\n");
  s = s.write("    movq %rdi, 16(%rax)\n");
  s = s.write("    jmp .Lquar_tail\n");
  s = s.write(".Lquar_first:\n");
  s = s.write("    movq %rdi, __fern_quar_head(%rip)\n");
  s = s.write(".Lquar_tail:\n");
  s = s.write("    movq %rdi, __fern_quar_tail(%rip)\n");
  s = s.write("    leaq 0(,%rsi,8), %rax\n");
  s = s.write("    addq %rax, __fern_quar_bytes(%rip)\n");
  s = quar_payload(s, "fill", "    movq %rax, (%r8)\n");
  if (s.quarantine > 0i64) {
    s = s.write(".Lquar_evict:\n");
    s = s.write("    movabs $" + util.i64_to_string(s.quarantine) + ", %rax\n");
    s = s.write("    cmpq %rax, __fern_quar_bytes(%rip)\n");
    s = s.write("    jbe .Lquar_done\n");
    s = s.write("    movq __fern_quar_head(%rip), %rdi\n");
    s = s.write("    movq 16(%rdi), %rax\n");
    s = s.write("    movq %rax, __fern_quar_head(%rip)\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lquar_unlinked\n");
    s = s.write("    movq $0, __fern_quar_tail(%rip)\n");
    s = s.write(".Lquar_unlinked:\n");
    s = s.write("    cmpl $" + rc_poison() + ", (%rdi)\n");
    s = s.write("    jne .Lquar_size0\n");
    s = s.write("    movq 8(%rdi), %rsi\n");
    s = s.write("    movl $0, (%rdi)\n");
    s = s.write("    jmp .Lquar_recycle\n");
    s = s.write(".Lquar_size0:\n");
    s = s.write("    cmpl $" + rc_poison() + ", 8(%rdi)\n");
    s = s.write("    jne __fern_san_abort_waf\n");
    s = s.write("    movq (%rdi), %rsi\n");
    s = s.write("    movl $0, 8(%rdi)\n");
    s = s.write(".Lquar_recycle:\n");
    s = quar_payload(s, "scan", "    cmpq %rax, (%r8)\n    jne __fern_san_abort_waf\n");
    s = s.write("    leaq 0(,%rsi,8), %rax\n");
    s = s.write("    subq %rax, __fern_quar_bytes(%rip)\n");
    s = s.write("    cmpq $65536, %rsi\n");
    s = s.write("    jae .Lquar_large\n");
    s = s.write("    movq %rsi, %rcx\n");
    s = freelist_push(s, "%rdi", "%rcx", "%rax");
    s = s.write("    jmp .Lquar_evict\n");
    s = s.write(".Lquar_large:\n");
    s = s.write("    movq %rdi, %r8\n");
    s = s.write("    leaq 0(,%rsi,8), %rsi\n");
    s = s.write("    call __fern_large_push_now\n");
    s = s.write("    jmp .Lquar_evict\n");
    s = s.write(".Lquar_done:\n");
  }
  s = s.write("    popq %r8\n");
  s = s.write("    popq %rcx\n");
  s = s.write("    popq %rax\n");
  s = s.write(".Lquar_ret:\n");
  return s.write("    ret\n");
}

// Under -sanitize a raw block carries a redzone: the two words after its
// size rounded to 8 hold the poison pattern from `__alloc` to `__free`.
// The allocation takes 16 bytes more, and the free checks the two words.
// The census counts the block without its redzone, so a release through
// the typed runtime, which does not know the redzone, balances it.
function emit_raw_alloc_san(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_raw_alloc_san:\n");
  s = s.write("    pushq %rdi\n    pushq %rdi\n    addq $16, %rdi\n    call __fern_alloc\n    popq %rdi\n    popq %rdi\n");
  if (s.leak_check) {
    s = s.write("    subq $16, __fern_lc_alloc_bytes(%rip)\n");
  }
  s = s.write("    addq $7, %rdi\n    andq $-8, %rdi\n    movabs $" + rc_poison64() + ", %rdx\n");
  return s.write("    movq %rdx, (%rax,%rdi)\n    movq %rdx, 8(%rax,%rdi)\n    ret\n");
}

// The free side of the redzone: %rdi is the block and %rsi its size rounded
// to 8. A word that lost the pattern was written past the end of the block.
function san_redzone_check(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movabs $" + rc_poison64() + ", %r8\n");
  return s.write("    cmpq %r8, (%rdi,%rsi)\n    jne __fern_san_abort_hbo\n    cmpq %r8, 8(%rdi,%rsi)\n    jne __fern_san_abort_hbo\n");
}

// Under -sanitize a raw free of a block that is in the quarantine aborts as a
// double free. The poison word selects the candidates, and a walk of the
// quarantine decides, so a live block that holds the poison value is freed.
function san_raw_twice_check(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    cmpl $" + rc_poison() + ", (%rdi)\n    jne .Lrawfree_fresh\n");
  s = s.write("    movq __fern_quar_head(%rip), %rcx\n.Lrawfree_qscan:\n    testq %rcx, %rcx\n    jz .Lrawfree_fresh\n");
  s = s.write("    cmpq %rdi, %rcx\n    je .Lrawfree_double\n    movq 16(%rcx), %rcx\n    jmp .Lrawfree_qscan\n");
  return s.write(".Lrawfree_fresh:\n");
}

// Runs `body` on each payload word of the block at %rdi, words 3 to %rsi - 1,
// with the word's address in %r8 and the poison pattern in %rax.
function quar_payload(s: asmcore.EmitState, name: string, body: string): asmcore.EmitState {
  s = s.write("    leaq 24(%rdi), %r8\n    leaq -3(%rsi), %rcx\n    movabs $" + rc_poison64() + ", %rax\n");
  s = s.write("    testq %rcx, %rcx\n    jz .Lquar_" + name + "_done\n.Lquar_" + name + ":\n" + body);
  return s.write("    addq $8, %r8\n    subq $1, %rcx\n    jnz .Lquar_" + name + "\n.Lquar_" + name + "_done:\n");
}

// At exit every block still in the quarantine gets the eviction's check, so
// a write after free is reported whether or not the budget evicted it.
function quar_scan_at_exit(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.rc_free_debug || !needs_heap_runtime(s)) {
    return s;
  }
  s = s.write("    movq __fern_quar_head(%rip), %rdi\n.Lquar_end_loop:\n    testq %rdi, %rdi\n    jz .Lquar_end_done\n");
  s = s.write("    cmpl $" + rc_poison() + ", (%rdi)\n    jne .Lquar_end_size0\n    movq 8(%rdi), %rsi\n    jmp .Lquar_end_scan\n");
  s = s.write(".Lquar_end_size0:\n    cmpl $" + rc_poison() + ", 8(%rdi)\n    jne __fern_san_abort_waf\n    movq (%rdi), %rsi\n.Lquar_end_scan:\n");
  s = quar_payload(s, "atexit", "    cmpq %rax, (%r8)\n    jne __fern_san_abort_waf\n");
  return s.write("    movq 16(%rdi), %rdi\n    jmp .Lquar_end_loop\n.Lquar_end_done:\n");
}

function emit_san_hbo_abort(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .rodata\n");
  s = s.write(".Lsan_hbo:\n    .ascii \"fern-sanitizer: heap-buffer-overflow (a raw block was written past its end)\\n\"\n");
  s = s.write("    .section .text\n");
  s = s.write("    .globl __fern_san_abort_hbo\n");
  s = s.write("__fern_san_abort_hbo:\n");
  s = s.write("    leaq .Lsan_hbo(%rip), %rsi\n");
  s = s.write("    movq $76, %rdx\n");
  s = s.write("    movq $2, %rdi\n");
  s = s.write("    movq $1, %rax\n");
  s = s.syscall(1);
  return san_report_exit(s);
}

function emit_san_waf_abort(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .rodata\n");
  s = s.write(".Lsan_waf:\n    .ascii \"fern-sanitizer: write-after-free (a quarantined block was written)\\n\"\n");
  s = s.write("    .section .text\n");
  s = s.write("    .globl __fern_san_abort_waf\n");
  s = s.write("__fern_san_abort_waf:\n");
  s = s.write("    leaq .Lsan_waf(%rip), %rsi\n");
  s = s.write("    movq $67, %rdx\n");
  s = s.write("    movq $2, %rdi\n");
  s = s.write("    movq $1, %rax\n");
  s = s.syscall(1);
  return san_report_exit(s);
}

// Under -harden a free list hands out one of its first eight blocks, chosen
// by a xorshift step over the seed read at startup: %rdi is the address of
// the list head, %rax the block taken, or zero when the list is empty. The
// link inside a free block is encoded with the block's key (freelist_key),
// and a decoded link must be aligned and inside the arena.
function emit_freelist_take(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_freelist_take:\n");
  s = s.write("    pushq %rcx\n");
  s = s.write("    pushq %rdx\n");
  s = s.write("    pushq %rsi\n");
  s = s.write("    pushq %r8\n");
  s = s.write("    movq __fern_rng_state(%rip), %rcx\n");
  s = s.write("    movq %rcx, %rdx\n    shlq $13, %rdx\n    xorq %rdx, %rcx\n");
  s = s.write("    movq %rcx, %rdx\n    shrq $7, %rdx\n    xorq %rdx, %rcx\n");
  s = s.write("    movq %rcx, %rdx\n    shlq $17, %rdx\n    xorq %rdx, %rcx\n");
  s = s.write("    movq %rcx, __fern_rng_state(%rip)\n");
  s = s.write("    andl $7, %ecx\n");
  s = s.write("    movq %rdi, %rsi\n");
  s = s.write("    movq (%rsi), %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jz .Lfltake_done\n");
  s = s.write(".Lfltake_walk:\n");
  s = s.write("    testl %ecx, %ecx\n");
  s = s.write("    jz .Lfltake_unlink\n");
  s = s.write("    call .Lfltake_next\n");
  s = s.write("    testq %r8, %r8\n");
  s = s.write("    jz .Lfltake_unlink\n");
  s = s.write("    movq %rax, %rsi\n");
  s = s.write("    movq %r8, %rax\n");
  s = s.write("    decl %ecx\n");
  s = s.write("    jmp .Lfltake_walk\n");
  s = s.write(".Lfltake_unlink:\n");
  s = s.write("    call .Lfltake_next\n");
  s = s.write("    cmpq %rdi, %rsi\n");
  s = s.write("    je .Lfltake_store\n");
  s = s.write(freelist_key("%rsi", "%rdx"));
  s = s.write("    xorq %rdx, %r8\n");
  s = s.write(".Lfltake_store:\n");
  s = s.write("    movq %r8, (%rsi)\n");
  s = s.write("    movq $0, (%rax)\n");
  s = s.write(".Lfltake_done:\n");
  s = s.write("    popq %r8\n");
  s = s.write("    popq %rsi\n");
  s = s.write("    popq %rdx\n");
  s = s.write("    popq %rcx\n");
  s = s.write("    ret\n");
  s = s.write(".Lfltake_next:\n");
  s = s.write(freelist_key("%rax", "%r8"));
  s = s.write("    xorq (%rax), %r8\n");
  s = s.write("    testq %r8, %r8\n");
  s = s.write("    jz .Lfltake_next_ok\n");
  s = s.write("    testb $7, %r8b\n");
  s = s.write("    jnz __fern_free_link_abort\n");
  s = s.write("    cmpq __fern_heap_base(%rip), %r8\n");
  s = s.write("    jb __fern_free_link_abort\n");
  s = s.write("    cmpq __fern_heap_end(%rip), %r8\n");
  s = s.write("    jae __fern_free_link_abort\n");
  s = s.write(".Lfltake_next_ok:\n");
  s = s.write("    ret\n");
  return emit_scrub(s);
}

// __fern_scrub zeroes words 1 to words - 1 of a block. It takes the block and
// then its size in words on the stack, and keeps every register.
function emit_scrub(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_scrub:\n    pushq %rdi\n    pushq %rcx\n    pushq %rax\n");
  s = s.write("    movq 40(%rsp), %rcx\n    subq $1, %rcx\n    jbe .Lscrub_done\n");
  s = s.write("    movq 32(%rsp), %rdi\n    addq $8, %rdi\n    xorl %eax, %eax\n    rep stosq\n");
  return s.write(".Lscrub_done:\n    popq %rax\n    popq %rcx\n    popq %rdi\n    ret\n");
}

// The key of a free block's link under -harden: the process canary mixed
// with the block's page, so a link copied from another block fails too.
// The key lands in `into`.
function freelist_key(block: string, into: string): string {
  return "    movq " + block + ", " + into + "\n    shrq $12, " + into + "\n    xorq __fern_canary(%rip), " + into + "\n";
}

// Takes the head of the free list whose slot address is in %rdi into %rax,
// or the random one of its first eight under -harden; zero when empty.
function freelist_take_head(s: asmcore.EmitState, miss: string): asmcore.EmitState {
  if (s.harden) {
    s = s.write("    call __fern_freelist_take\n");
    s = s.write("    testq %rax, %rax\n");
    return s.write("    jz " + miss + "\n");
  }
  s = s.write("    movq (%rdi), %rax\n");
  s = s.write("    testq %rax, %rax\n");
  s = s.write("    jz " + miss + "\n");
  s = s.write("    pushq (%rax)\n");
  return s.write("    popq (%rdi)\n");
}

function san_poison_check(reg: string, on: boolean): string {
  if (on) {
    return "    cmpl $" + rc_poison() + ", " + reg + "\n    je __fern_san_abort_uaf\n";
  }
  return "";
}

function hev_on(s: asmcore.EmitState): boolean {
  return rc_trace_on() || s.leak_check || rtprofile.allocation(s.profile);
}

function str_grow_census(s: asmcore.EmitState): asmcore.EmitState {
  if (rc_trace_on()) {
    s = s.write("    movq %r9, %rax\n");
    s = s.write("    shlq $3, %rax\n");
    s = s.write("    subq %rax, __fern_lc_free_bytes(%rip)\n");
    s = s.write("    subq %rax, __fern_lc_alloc_bytes(%rip)\n");
    s = s.write("    subq $1, __fern_lc_free_count(%rip)\n");
    s = s.write("    subq $1, __fern_lc_alloc_count(%rip)\n");
    return s;
  }
  s = s.write("    movq %r10, %rax\n");
  s = s.write("    subq %r9, %rax\n");
  s = s.write("    shlq $3, %rax\n");
  s = s.write("    addq %rax, __fern_lc_alloc_bytes(%rip)\n");
  return s;
}

function freelist_push(s: asmcore.EmitState, ptr: string, words: string, tmp: string): asmcore.EmitState {
  return freelist_push_classed(capw_class(s, words), ptr, words, tmp, "");
}

// Pushes ptr on the free list of its class. With `twice` set, a block that is
// already the head of the list jumps to that label instead.
function freelist_push_classed(s: asmcore.EmitState, ptr: string, words: string, tmp: string, twice: string): asmcore.EmitState {
  return freelist_push_slot(s, ptr, words, "(%r8," + words + ",8)", tmp, twice);
}

// Pushes ptr, a block of `words` words, on the free list whose head is
// `slot`, an operand over the list table in %r8.
function freelist_push_slot(s: asmcore.EmitState, ptr: string, words: string, slot: string, tmp: string, twice: string): asmcore.EmitState {
  s = freelist_scrub(s, ptr, words);
  s = s.write("    leaq __fern_freelist(%rip), %r8\n");
  s = s.write("    movq " + slot + ", " + tmp + "\n");
  if (twice != "") {
    s = freelist_twice_check(s, tmp, ptr, twice);
  }
  s = freelist_encode(s, ptr, tmp, "%r9");
  s = s.write("    movq " + tmp + ", (" + ptr + ")\n");
  return s.write("    movq " + ptr + ", " + slot + "\n");
}

// Under -harden, zeroes words 1 to words - 1 of the block at ptr before its
// push, so a released block keeps no bytes of its owner.
function freelist_scrub(s: asmcore.EmitState, ptr: string, words: string): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  return s.write("    pushq " + words + "\n    pushq " + ptr + "\n    call __fern_scrub\n    leaq 16(%rsp), %rsp\n");
}

// Jumps to `twice` when `ptr` is already on the free list whose head is in
// `head`. The release build compares the head alone. -harden walks the first
// 64 blocks through .Lfltake_next, so a second free with other frees of the
// class between the two aborts too.
function freelist_twice_check(s: asmcore.EmitState, head: string, ptr: string, twice: string): asmcore.EmitState {
  if (!s.harden) {
    return s.write("    cmpq " + ptr + ", " + head + "\n    je " + twice + "\n");
  }
  let l = asmcore.fresh_label(s);
  let n = l.name;
  let restore = "    popq %r11\n    popq %r10\n    popq %r8\n    popq %rax\n";
  s = l.state.write("    pushq %rax\n    pushq %r8\n    pushq %r10\n    pushq %r11\n    movq " + ptr + ", %r10\n    movq " + head + ", %rax\n    movl $64, %r11d\n");
  s = s.write(n + "_loop:\n    testq %rax, %rax\n    jz " + n + "_done\n    cmpq %r10, %rax\n    je " + n + "_hit\n");
  s = s.write("    call .Lfltake_next\n    movq %r8, %rax\n    decl %r11d\n    jnz " + n + "_loop\n");
  s = s.write(n + "_done:\n" + restore + "    jmp " + n + "_out\n" + n + "_hit:\n" + restore + "    jmp " + twice + "\n");
  return s.write(n + "_out:\n");
}

// The abort a corrupt free list link takes, which only -harden checks.
function free_link_trap(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  return abort_trap(s, "__fern_free_link_abort", ".Lmsg_free_link", aborts.free_link(), 134);
}

// Under -harden, XORs the key of `block` into the link in `link`, with
// `scratch` saved around the key.
function freelist_encode(s: asmcore.EmitState, block: string, link: string, scratch: string): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  return s.write("    pushq " + scratch + "\n" + freelist_key(block, scratch) + "    xorq " + scratch + ", " + link + "\n    popq " + scratch + "\n");
}

function capw_class(s: asmcore.EmitState, words: string): asmcore.EmitState {
  let l = asmcore.fresh_label(s);
  s = l.state.write("    cmpq $256, " + words + "\n");
  s = s.write("    jbe " + l.name + "\n");
  s = s.write("    pushq " + words + "\n");
  s = s.write("    call __fern_capw\n");
  s = s.write("    popq " + words + "\n");
  return s.write(l.name + ":\n");
}

function large_class(s: asmcore.EmitState): asmcore.EmitState {
  let l = asmcore.fresh_label(s);
  s = l.state.write("    cmpq $524288, %rax\n");
  s = s.write("    jae " + l.name + "\n");
  s = s.write("    movl $524288, %eax\n");
  s = s.write(l.name + ":\n");
  s = s.write("    bsrq %rax, %rcx\n");
  s = s.write("    subl $2, %ecx\n");
  s = s.write("    movl $1, %edx\n");
  s = s.write("    shlq %cl, %rdx\n");
  s = s.write("    leaq -1(%rax,%rdx), %rax\n");
  s = s.write("    negq %rdx\n");
  s = s.write("    andq %rdx, %rax\n");
  s = s.write("    bsrq %rax, %rcx\n");
  s = s.write("    subl $2, %ecx\n");
  s = s.write("    movq %rax, %rdx\n");
  s = s.write("    shrq %cl, %rdx\n");
  s = s.write("    shlq $2, %rcx\n");
  s = s.write("    addq %rcx, %rdx\n");
  return s.write("    subq $72, %rdx\n");
}

function buf_block_free(s: asmcore.EmitState, ptr: string, words: string, lbl: string): asmcore.EmitState {
  s = s.write("    cmpq $65536, " + words + "\n");
  s = s.write("    jae ." + lbl + "_large\n");
  s = hev_free(s, ptr, words);
  if (!s.rc_free_debug) {
    s = freelist_push(s, ptr, words, "%rsi");
  } else {
    s = quar_push(s, ptr, words, 16);
  }
  s = s.write("    jmp ." + lbl + "_done\n");
  s = s.write("." + lbl + "_large:\n");
  if (s.rc_free_debug) {
    s = hev_free(s, ptr, words);
    s = quar_push(s, ptr, words, 16);
  } else {
    s = s.write("    movq " + ptr + ", %r8\n");
    s = s.write("    leaq 0(," + words + ",8), %rsi\n");
    s = s.write("    call __fern_large_push\n");
  }
  s = s.write("." + lbl + "_done:\n");
  return s;
}

// Under -harden every 64th large block the bump hands out ends on a page
// boundary and is followed by a page the process cannot touch. A failed
// mprotect leaves the block without its guard.
function emit_guard_bump(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    cmpq $524288, %rdi\n");
  s = s.write("    jb .Lalloc_bump\n");
  s = s.write("    incq __fern_guard_count(%rip)\n");
  s = s.write("    testq $63, __fern_guard_count(%rip)\n");
  s = s.write("    jnz .Lalloc_bump\n");
  s = s.write("    pushq %rcx\n");
  s = s.write("    pushq %rdx\n");
  s = s.write("    pushq %rsi\n");
  s = s.write("    pushq %r11\n");
  s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
  s = s.write("    addq $4095, %rax\n");
  s = s.write("    andq $-4096, %rax\n");
  s = s.write("    addq %rax, %rdi\n");
  s = s.write("    jc .Lalloc_guard_abort\n");
  s = s.write("    movq %rdi, %rcx\n");
  s = s.write("    addq $4096, %rcx\n");
  s = s.write("    jc .Lalloc_guard_abort\n");
  s = s.write("    cmpq __fern_heap_end(%rip), %rcx\n");
  s = s.write("    ja .Lalloc_guard_oom\n");
  s = s.write("    movq %rcx, __fern_heap_ptr(%rip)\n");
  s = s.write("    pushq %rax\n");
  s = s.write("    movq $4096, %rsi\n");
  s = s.write("    xorl %edx, %edx\n");
  s = s.write("    movl $10, %eax\n");
  s = s.syscall(10);
  s = s.write("    popq %rax\n");
  s = s.write("    popq %r11\n");
  s = s.write("    popq %rsi\n");
  s = s.write("    popq %rdx\n");
  s = s.write("    popq %rcx\n");
  s = s.write("    popq %rbp\n");
  s = s.write("    ret\n");
  s = s.write(".Lalloc_guard_oom:\n");
  s = s.write("    popq %r11\n    popq %rsi\n    popq %rdx\n    popq %rcx\n");
  s = s.write("    jmp .Lalloc_oom\n");
  s = s.write(".Lalloc_guard_abort:\n");
  s = s.write("    popq %r11\n    popq %rsi\n    popq %rdx\n    popq %rcx\n");
  s = s.write("    jmp __fern_alloc_size_abort\n");
  return s.write(".Lalloc_bump:\n");
}

function emit_alloc_bytes(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(empty_array_block(s, ".Lfern_empty_bytes"));
  s = s.write("__fern_alloc_bytes:\n");
  s = s.write("    testl %edi, %edi\n    js __fern_alloc_size_abort.c\n    jz .Lfern_alloc_bytes_empty\n");
  s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n    pushq %r12\n    pushq %r13\n");
  s = s.write("    movq %rdi, %r12\n    leaq 7(%rdi), %rdi\n    shrq $3, %rdi\n    movq %rdi, %r13\n");
  s = s.write("    call __fern_arr_box\n");
  s = s.write("    movq %r12, (%rax)\n    movq %rax, %rdx\n    leaq 8(%rax), %rdi\n    movq %r13, %rcx\n");
  s = s.write("    xorl %eax, %eax\n    rep stosq\n    movq %rdx, %rax\n");
  s = s.write("    popq %r13\n    popq %r12\n    popq %rbp\n    ret\n");
  s = s.write(".Lfern_alloc_bytes_empty:\n    leaq .Lfern_empty_bytes(%rip), %rax\n    ret\n");
  if (s.has_need("alloc_bytes_uninit")) {
    s = s.write("__fern_alloc_bytes_uninit:\n    testl %edi, %edi\n    js __fern_alloc_size_abort.c\n    jz .Lfern_alloc_bytes_empty\n");
    s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n    pushq %r12\n    pushq %r13\n    movq %rdi, %r12\n    leaq 7(%rdi), %rdi\n    shrq $3, %rdi\n    call __fern_arr_box\n    movq %r12, (%rax)\n    popq %r13\n    popq %r12\n    popq %rbp\n    ret\n");
  }
  return s;
}

// The shared empty array is a constant box: a length setter skips it.
function empty_array_block(s: asmcore.EmitState, label: string): string {
  return asmcore.const_data_section(s) + "    .balign 8\n    .quad 0\n    .quad -1\n" + label + ":\n    .quad 0\n    .section .text\n";
}

function apo_grow(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    movl -8(%rdi), %ecx\n");
  s = s.write("    testl %ecx, %ecx\n");
  s = s.write("    js .Larr_push_slow\n");
  s = s.write("    cmpl $1, %ecx\n");
  s = s.write("    jne .Larr_push_slow\n");
  s = s.write("    pushq %rbp\n");
  s = s.write("    movq %rsp, %rbp\n");
  s = s.write("    pushq %r12\n");
  s = s.write("    pushq %r13\n");
  s = s.write("    pushq %r14\n");
  s = s.write("    pushq %r15\n");
  s = s.write("    movq %rdi, %r12\n");
  s = s.write("    movq %rsi, %r13\n");
  s = s.write("    movq (%r12), %r14\n");
  s = s.write("    movq -16(%r12), %r15\n");
  s = s.write("    leaq (%r15,%r15), %rcx\n");
  s = s.write("    testq %rcx, %rcx\n");
  s = s.write("    jnz .Lapo_cap\n");
  s = s.write("    movq $4, %rcx\n");
  s = s.write(".Lapo_cap:\n");
  s = s.write("    leaq 1(%r14), %rax\n    cmpq %rax, %rcx\n    cmovbq %rax, %rcx\n");
  s = s.write("    cmpq $268435455, %rcx\n    ja __fern_alloc_size_abort\n");
  s = s.write("    leaq 24(,%rcx,8), %rdi\n");
  s = s.write("    cmpq $2048, %rdi\n");
  s = s.write("    ja .Lapo_alloc\n");
  s = s.write("    leaq __fern_freelist(%rip), %rax\n");
  s = s.write("    addq %rax, %rdi\n");
  s = freelist_take_head(s, ".Lapo_miss");
  s = s.write(".Lapo_box:\n");
  s = s.write("    movq %rcx, (%rax)\n");
  s = s.write("    movq $1, 8(%rax)\n");
  s = s.write("    addq $16, %rax\n");
  s = s.write("    leaq 1(%r14), %rcx\n");
  s = s.write("    movq %rcx, (%rax)\n");
  s = s.write(arr_copy_elems(".Lapo"));
  s = s.write("    movq %r13, 8(%rax,%r14,8)\n");
  s = s.write("    leaq 3(%r15), %rcx\n");
  s = s.write("    cmpq $65536, %rcx\n");
  s = s.write("    jae .Lapo_large\n");
  s = s.write(quarantine_rc("-8(%r12)", false));
  s = s.write("    leaq -16(%r12), %rdx\n");
  s = freelist_push(s, "%rdx", "%rcx", "%rdi");
  s = s.write(".Lapo_ret:\n");
  s = s.write("    popq %r15\n");
  s = s.write("    popq %r14\n");
  s = s.write("    popq %r13\n");
  s = s.write("    popq %r12\n");
  s = s.write("    leave\n");
  s = s.write("    ret\n");
  s = s.write(".Lapo_miss:\n");
  s = s.write("    leaq __fern_freelist(%rip), %rax\n");
  s = s.write("    subq %rax, %rdi\n");
  s = s.write(".Lapo_alloc:\n");
  s = s.write("    call __fern_alloc\n");
  s = s.write("    jmp .Lapo_box\n");
  return s;
}

function apo_wrapped(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.rc_free_debug) {
    s = s.write("    cmpq $0, (%rdi)\n");
    s = s.write("    jne .Lapo_grow\n");
    s = s.write("    cmpq $0, -16(%rdi)\n");
    s = s.write("    jne .Lapo_grow\n");
    s = s.write("    cmpl $0, -8(%rdi)\n");
    s = s.write("    js .Larr_push_slow\n");
