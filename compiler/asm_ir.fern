  s = s.write("    movapd %xmm1, %xmm2\n    mulsd %xmm0, %xmm2\n");  // v = z*r
  s = s.write(fc_ld("%xmm3", ".Lfc_s6"));
  s = s.write(fc_horner("%xmm3", "%xmm1", "%xmm4", ".Lfc_s5"));
  s = s.write(fc_horner("%xmm3", "%xmm1", "%xmm4", ".Lfc_s4"));
  s = s.write(fc_horner("%xmm3", "%xmm1", "%xmm4", ".Lfc_s3"));
  s = s.write(fc_horner("%xmm3", "%xmm1", "%xmm4", ".Lfc_s2"));
  s = s.write(fc_horner("%xmm3", "%xmm1", "%xmm4", ".Lfc_s1"));
