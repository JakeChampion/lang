  s = s.write("    andq $-3, %rax\n");
  s = s.write("    movl -8(%rax), %ecx\n");
  s = s.write(san_poison_check("%ecx", s.rc_free_debug));
  s = s.write("    testl %ecx, %ecx\n");
  s = s.write("    js .Lshrcinc_ret\n");
  s = s.write("    addl $1, %ecx\n");
  s = s.write("    movl %ecx, -8(%rax)\n");
  s = s.write(".Lshrcinc_ret:\n");
  s = s.write("    movq 8(%rsp), %rax\n");
  s = s.write("    ret\n");
  s = s.write("__fn___fern_rc_underflow_count:\n");
  s = s.write("    movl __fern_rc_underflow(%rip), %eax\n");
  s = s.write("    ret\n");
