    s = s.write(a_clamped + ":\n");
    s = s.write(a_avx + ":\n");
    s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
    s = s.write("    cmpq $32, %r9\n    jl " + a_avx_done + "\n");
    s = s.write("    vmovdqu (%rax,%rdx), %ymm0\n");
    s = s.write("    vpmovmskb %ymm0, %r9d\n    testl %r9d, %r9d\n    jnz " + a_hit32 + "\n");
    s = s.write("    addq $32, %rdx\n    jmp " + a_avx + "\n");
    s = s.write(a_hit32 + ":\n    vzeroupper\n    bsfl %r9d, %r9d\n    addq %r9, %rdx\n    jmp " + a_done + "\n");
    s = s.write(a_avx_done + ":\n    vzeroupper\n");
    s = s.write(a_vec + ":\n");
    s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
    s = s.write("    cmpq $16, %r9\n    jl " + a_tail + "\n");
    s = s.write("    movdqu (%rax,%rdx), %xmm0\n");
    s = s.write("    pmovmskb %xmm0, %r9d\n    testl %r9d, %r9d\n    jnz " + a_hit + "\n");
    s = s.write("    addq $16, %rdx\n    jmp " + a_vec + "\n");
    s = s.write(a_hit + ":\n    bsfl %r9d, %r9d\n    addq %r9, %rdx\n    jmp " + a_done + "\n");
    // Scalar tail: the final 0..15 bytes, and the whole algorithm for a
    // string shorter than one block.
    s = s.write(a_tail + ":\n");
    s = s.write("    cmpq %r8, %rdx\n    jge " + a_none + "\n");
    s = s.write("    movzbq (%rax,%rdx), %r9\n");
    // Zero-extended, so bit 7 is the high bit.
    s = s.write("    testq $128, %r9\n    jnz " + a_done + "\n");
    s = s.write("    addq $1, %rdx\n    jmp " + a_tail + "\n");
    // The miss value is the LENGTH, not -1 — the branch-free-skip
    // contract this op keeps everywhere.
    s = s.write(a_none + ":\n    movq %r8, %rdx\n");
    s = s.write(a_done + ":\n    pushq %rdx\n");
    return s;
  }
  if (o.kind_tag == 245 || o.kind_tag == 378) {  // mismatch / mismatch_bytes
    return emit_mismatch_x86(o, s);
  }
  if (o.kind_tag == 104) {  // str_bytes
    // operand stack [str box]; __fern_str_bytes is a Fern runtime function now
    // (#2649): the box on the stack IS param[0] (at +16 after the call), so call
    // directly, pop the arg, push the result i32[]. mark_str_bytes pulls in
    // heap for the helper's pre-sized box.
    if (ir.is_packed(o)) {
      s = s.write("    call __fn___fern_str_bytes_u8\n    addq $8, %rsp\n    pushq %rax\n");
      return s.need("heap").need("str_bytes_u8");
    }
    s = s.write("    call __fn___fern_str_bytes\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.mark_str_bytes();
    return s;
  }
  if (o.kind_tag == 105) {  // str_split
    // operand stack [haystack box, sep box] (sep on top). Call the
    // Fern-compiled __fn___fern_str_split via the stack ABI: param[0]=haystack
    // on top (+16), param[1]=sep (+24). -> fresh string[] in %rax.
    s = s.write("    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_split\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.mark_str_split();
    return s;
  }
  if (o.kind_tag == 106 || o.kind_tag == 107) {  // str_to_upper, str_to_lower
    // operand stack [s box]; __fern_str_to_upper/_lower are Fern runtime
    // functions now (#2649): __fn_ stack convention — s already on the stack IS
    // param[0] (at +16), so call directly, pop the arg, push the result.
    let cfn: string = "__fn___fern_str_to_upper";
    if (o.kind_tag == 107) {  // str_to_lower
      cfn = "__fn___fern_str_to_lower";
    }
    s = s.write("    call " + cfn + "\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.mark_str_case();
    return s;
  }
  if (o.kind_tag == 108) {  // str_repeat
    // operand stack [s box, n] (n on top). Call the Fern-compiled
    // __fn___fern_str_repeat via the stack ABI: param[0]=s on top (+16),
    // param[1]=n below (+24). -> fresh string box in %rax.
    s = s.write("    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_repeat\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.mark_str_repeat();
    return s;
  }
  if (o.kind_tag == 109) {  // str_trim
    // operand stack [s box]; __fern_str_trim is a Fern runtime function now
    // (#2649): the s box already on the operand stack IS param[0] (at +16
    // after the call), so call directly, pop the arg, push the result.
    s = s.write("    call __fn___fern_str_trim\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.mark_str_trim();
    return s;
  }
  if (o.kind_tag == 111) {  // str_replace
    // operand stack [haystack, old, new] (new on top). Call the Fern-compiled
    // __fn___fern_str_replace via the stack ABI: param[0]=haystack on top
    // (+16), param[1]=old (+24), param[2]=new (+32). -> fresh string box in %rax.
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_replace\n    addq $24, %rsp\n    pushq %rax\n");
    s = s.mark_str_replace();
    return s;
  }
  if (o.kind_tag == 113) {  // str_lines
    // operand stack [s box]; __fern_str_lines is a Fern runtime function now
    // (#2649): the s box already on the stack IS param[0] (at +16 after the
    // call), so call directly, pop the arg, push the result string[].
    // mark_str_lines pulls in its arr_push + heap deps.
    s = s.write("    call __fn___fern_str_lines\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.mark_str_lines();
    return s;
  }
  // Guarded, so this tail is unreachable rather than a catch-all (#6917).
  // str_cmp used to sit here unguarded, which meant a tag added to
  // ir.is_str_op_kind without a branch here emitted a __fern_str_cmp call for
  // it — wrong code that looks plausible, the same failure class as the
  // comment fallback in ir_bin_asm.
  ircore.unsupported_op_refuse(o.kind_tag, "x86-64");
  return s;
}

// ---- The SSA backend: one function at a time, on the stack ABI -----------
//
// `-backend ssa` (docs/SELFHOST-SSA-BACKEND.md), the x86-64 twin of the emitter
// in asm_arm64_ir.fern and the only emitter on this ISA. Every lowered function
// is lifted by ssa_lift.lift_from_ir_prod and emitted from SSA form, its
// values in the linear-scan allocator's registers or in frame slots. The rbp
// frame, the caller-stack argument convention (param i at 16 + 8*i(%rbp),
// result in %rax) and every runtime symbol are the ones the stack machine
// this replaced used, so the runtime helpers and the flat-op arms it still
// runs are unchanged.
//
// Registers: %rax, %rsi, %rdi, %r8, %r9 and %r10 are the caller-saved pool;
// %rbx and %r12-%r15 are the callee-saved pool a value live across a call
// takes, saved once per function. %r11, %rcx and %rdx are scratch. A spilled
// value lives below the save area by its allocator slot (ssa_slot).

// Pool index 0 is %rax, the register the ABI returns a call's result in, so a
// call result allocated there needs no move.
function ssa_reg(k: i32): string {
  if (k == 0) {
    return "%rax";
  }
  if (k == 1) {
    return "%rsi";
  }
  if (k == 2) {
    return "%rdi";
  }
  if (k == 3) {
    return "%r8";
  }
  if (k == 4) {
    return "%r9";
  }
  if (k == 5) {
    return "%r10";
  }
  if (k == 6) {
    return "%rbx";
  }
  if (k == 7) {
    return "%r12";
  }
  if (k == 8) {
    return "%r13";
  }
  if (k == 9) {
    return "%r14";
  }
  return "%r15";
}

function ssa_nregs(): i32 {
  return 6;
}

function ssa_nsaved(): i32 {
  return 5;
}

// A slot sits below the callee-saved registers' save area of `save` bytes.
function ssa_slot(v: i32, save: i32): string {
  return util.i32_to_string(ssa_slot_disp(v, save)) + "(%rbp)";
}

// ssa_slot_disp is a frame slot's displacement off %rbp.
function ssa_slot_disp(v: i32, save: i32): i32 {
  return 0 - 8 * (v + 1) - save;
}

// ssa_saved_regs is the callee-saved registers a function's allocation uses,
// lowest first; each takes one 8-byte push.
function ssa_saved_regs(reg_of: i32[]): i32[] {
  let used: i32[] = [];
  let k: i32 = ssa_nregs();
  while (k < ssa_nregs() + ssa_nsaved()) {
    let found: boolean = false;
    for h in reg_of {
      if (h == k) {
        found = true;
      }
    }
    if (found) {
      used = used.append(k);
    }
    k = k + 1;
  }
  return used;
}

function ssa_save_asm(saved: i32[]): string {
  let out: string = "";
  for k in saved {
    out = out + "    pushq " + ssa_reg(k) + "\n";
  }
  return out;
}

// ssa_epilogue_for cuts %rsp back to the save area, pops the saved registers
// in reverse, and returns as the stack machine does.
function ssa_epilogue_for(saved: i32[]): string {
  if (saved.len() == 0) {
    return ssa_epilogue();
  }
  let out: string = "    .cfi_remember_state\n    leaq -" + util.i32_to_string(8 * saved.len()) + "(%rbp), %rsp\n";
  let i: i32 = saved.len() - 1;
  while (i >= 0) {
    out = out + "    popq " + ssa_reg(saved[i]) + "\n";
    i = i - 1;
  }
  return out + "    popq %rbp\n    .cfi_def_cfa %rsp, 8\n    ret\n    .cfi_restore_state\n";
}

// ssa_emit_epilogue writes a function's return: the frame's epilogue as
// records, or as its text for a buffered leaf body, whose mark its frame
// replaces once chosen.
function ssa_emit_epilogue(fr: SsaFrame, s: asmcore.EmitState): asmcore.EmitState {
  if (fr.leaf || !s.records()) {
    return s.write(fr.epilogue);
  }
  s = ssa_cfi(s, 7, "", 0);
  if (fr.saved.len() == 0) {
    s = ssa_leave(s);
  } else {
    s = ssa_lea_rm(s, "%rsp", "%rbp", 0 - 8 * fr.saved.len());
    let i: i32 = fr.saved.len() - 1;
    while (i >= 0) {
      s = ssa_pop_r(s, ssa_reg(fr.saved[i]));
      i = i - 1;
    }
    s = ssa_pop_r(s, "%rbp");
  }
  return ssa_cfi(ssa_ret(ssa_cfi(s, 5, "%rsp", 8)), 8, "", 0);
}

// ssa_load puts value v in `reg`; ssa_store writes `reg` to value v's home.
function ssa_load(reg_of: i32[], v: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
  if (reg == "%r11") {
    if (s.ssa_x0 == v) {
      return s;
    }
    s = asmcore.EmitState { ...s, ssa_x0: v };
  }
  if (reg_of[v] < 0) {
    return ssa_mov_slot(s, true, reg, ssa_slot_disp(ssa.spill_slot(reg_of[v]), s.ssa_save));
  }
  let home: string = ssa_reg(reg_of[v]);
  if (home == reg) {
    return s;
  }
  return ssa_mov_rr(s, reg, home);
}

// The jumps the SSA emitter writes. The low five bits are the kind a branch
// record carries, the condition code or 16 for jmp; bit 5 picks the jz/jnz
// spelling of je/jne in the text.
const J_JB: i32 = 2;

const J_JAE: i32 = 3;

const J_JE: i32 = 4;

const J_JNE: i32 = 5;

const J_JBE: i32 = 6;

const J_JA: i32 = 7;

const J_JS: i32 = 8;

const J_JNS: i32 = 9;

const J_JL: i32 = 12;

const J_JGE: i32 = 13;

const J_JLE: i32 = 14;

const J_JG: i32 = 15;

const J_JMP: i32 = 16;

const J_JZ: i32 = 36;

const J_JNZ: i32 = 37;

// ssa_jump_text is jump `j`'s mnemonic.
function ssa_jump_text(j: i32): string {
  if (j == J_JMP) {
    return "jmp";
  } else if (j == J_JE) {
    return "je";
  } else if (j == J_JNE) {
    return "jne";
  } else if (j == J_JZ) {
    return "jz";
  } else if (j == J_JNZ) {
    return "jnz";
  } else if (j == J_JB) {
    return "jb";
  } else if (j == J_JAE) {
    return "jae";
  } else if (j == J_JBE) {
    return "jbe";
  } else if (j == J_JA) {
    return "ja";
  } else if (j == J_JS) {
    return "js";
  } else if (j == J_JNS) {
    return "jns";
  } else if (j == J_JL) {
    return "jl";
  } else if (j == J_JGE) {
    return "jge";
  } else if (j == J_JLE) {
    return "jle";
  } else if (j == J_JG) {
    return "jg";
  }
  // Not a J_* id: a mnemonic the assembler refuses, not a wrong branch.
  return "j?" + util.i32_to_string(j);
}

// ssa_branch jumps to one of the emitter's own labels: by id when records
// are on (asmcore.Lab), by name in the text.
function ssa_branch(s: asmcore.EmitState, j: i32, l: asmcore.Lab): asmcore.EmitState {
  if (s.records()) {
    return s.lab_ref((j & 31) as i64, l);
  }
  return s.write("    " + ssa_jump_text(j) + " " + l.name + "\n");
}

// ssa_call_sym calls a function symbol, which keeps its name: the record
// line skips the text path's memo lookup and comment and label scans.
function ssa_call_sym(s: asmcore.EmitState, name: string): asmcore.EmitState {
  if (s.records()) {
    return s.named(x86_native.x86_rec_call(), name);
  }
  return s.write("    call " + name + "\n");
}

// ssa_lea_sym loads the address of `label` into `dst`.
function ssa_lea_sym(s: asmcore.EmitState, label: string, dst: string): asmcore.EmitState {
  if (s.records()) {
    let d: i32 = ssa_xreg(dst);
    if (d >= 0) {
      return s.named(x86_native.x86_rec_lea_rip(d), label);
    }
  }
  return s.write("    leaq " + label + "(%rip), " + dst + "\n");
}

// ssa_sext32 reports the width ops that are `movslq src32, dst`.
function ssa_sext32(what: string, unsigned: boolean): boolean {
  return what == "int_cast:i32" || (what == "int_extend" || what == "int_wrap") && !unsigned;
}

// ssa_blab is block `id`'s label: its id from the function's base, its name
// from the prefix.
function ssa_blab(fr: SsaFrame, lp: string, id: i32): asmcore.Lab {
  return asmcore.Lab { id: fr.lbase + id, name: lp + util.i32_to_string(id) };
}

// The instruction helpers below hand the assembler the encoded bytes when it
// takes records, from the register numbers the names spell, and write the
// text otherwise. ssa_xreg is a 64-bit register's number, -1 for a name it
// does not know, which keeps that instruction text.
function ssa_xreg(name: string): i32 {
  if (name.len() >= 3 && name[1] == b'r' && name[2] >= b'0' && name[2] <= b'9') {
    let n: i32 = name[2] as i32 - 48;
    if (name.len() == 4) {
      n = n * 10 + (name[3] as i32 - 48);
    }
    return n;
  }
  if (name.len() != 4 || name[0] != b'%' || name[1] != b'r') {
    return 0 - 1;
  }
  // The eight named registers, told apart by their last two bytes.
  let c: i32 = name[2] as i32;
  let d: i32 = name[3] as i32;
  if (d == 120) {
    if (c == 97) {
      return 0;
    }
    if (c == 99) {
      return 1;
    }
    if (c == 100) {
      return 2;
    }
    if (c == 98) {
      return 3;
    }
    return 0 - 1;
  }
  if (d == 112) {
    if (c == 115) {
      return 4;
    }
    if (c == 98) {
      return 5;
    }
    return 0 - 1;
  }
  if (d == 105) {
    if (c == 115) {
      return 6;
    }
    if (c == 100) {
      return 7;
    }
  }
  return 0 - 1;
}

// ssa_alu_text is the mnemonic of group-1 op `ext` at `size` bits.
function ssa_alu_text(ext: i32, size: i32): string {
  let base: string = "cmp";
  if (ext == 0) {
    base = "add";
  } else if (ext == 1) {
    base = "or";
  } else if (ext == 4) {
    base = "and";
  } else if (ext == 5) {
    base = "sub";
  } else if (ext == 6) {
    base = "xor";
  }
  if (size == 8) {
    return base + "b";
  }
  if (size == 32) {
    return base + "l";
  }
  return base + "q";
}

// ssa_mov_rr writes `movq src, dst`.
function ssa_mov_rr(s: asmcore.EmitState, dst: string, src: string): asmcore.EmitState {
  if (s.records()) {
    let d: i32 = ssa_xreg(dst);
    let r: i32 = ssa_xreg(src);
    if (d >= 0 && r >= 0) {
      return s.bytes(x86_native.x86_rec_mov_rr(64, d, r));
    }
  }
  return s.write("    movq " + src + ", " + dst + "\n");
}

// ssa_mov_slot writes the load `movq disp(%rbp), reg` or the store `movq
// reg, disp(%rbp)`.
function ssa_mov_slot(s: asmcore.EmitState, load: boolean, reg: string, disp: i32): asmcore.EmitState {
  return ssa_mov_rm(s, 64, load, reg, "%rbp", disp);
}

// ssa_mov_rm writes the load `mov disp(base), reg` or the store `mov reg,
// disp(base)` at `size` bits, `reg` named as a 64-bit register; ssa_mov_rm0
// is its form at `(base)`.
function ssa_mov_rm(s: asmcore.EmitState, size: i32, load: boolean, reg: string, base: string, disp: i32): asmcore.EmitState {
  return ssa_mov_rm_at(s, size, load, reg, base, disp, false);
}

function ssa_mov_rm0(s: asmcore.EmitState, size: i32, load: boolean, reg: string, base: string): asmcore.EmitState {
  return ssa_mov_rm_at(s, size, load, reg, base, 0, true);
}

function ssa_mov_rm_at(s: asmcore.EmitState, size: i32, load: boolean, reg: string, base: string, disp: i32, bare: boolean): asmcore.EmitState {
  if (s.records()) {
    let r: i32 = ssa_xreg(reg);
    let b: i32 = ssa_xreg(base);
    if (r >= 0 && b >= 0) {
      return s.bytes(x86_native.x86_rec_mov_rm(size, load, r, b, disp));
    }
  }
  let mem: string = ssa_mem(base, disp, bare);
  if (load) {
    return s.write("    " + ssa_mov_text(size) + " " + mem + ", " + ssa_wreg(size, reg) + "\n");
  }
  return s.write("    " + ssa_mov_text(size) + " " + ssa_wreg(size, reg) + ", " + mem + "\n");
}

// ssa_mov_rmi is the load or store of `reg` at `disp(base,index,scale)`.
function ssa_mov_rmi(s: asmcore.EmitState, size: i32, load: boolean, reg: string, base: string, index: string, scale: i32, disp: i32): asmcore.EmitState {
  if (s.records()) {
    let r: i32 = ssa_xreg(reg);
    let b: i32 = ssa_xreg(base);
    let x: i32 = ssa_xreg(index);
    if (r >= 0 && b >= 0 && x >= 0) {
      return s.bytes(x86_native.x86_rec_mov_rmi(size, load, r, b, x, scale, disp));
    }
  }
  let mem: string = ssa_mem_i(base, index, scale, disp);
  if (load) {
    return s.write("    " + ssa_mov_text(size) + " " + mem + ", " + ssa_wreg(size, reg) + "\n");
  }
  return s.write("    " + ssa_mov_text(size) + " " + ssa_wreg(size, reg) + ", " + mem + "\n");
}

// ssa_movzb_mi writes `movzbl disp(base,index), dst` (`w` 0) or its movzbq
// form (`w` 1).
function ssa_movzb_mi(s: asmcore.EmitState, w: i32, dst: string, base: string, index: string, disp: i32): asmcore.EmitState {
  if (s.records()) {
    let d: i32 = ssa_xreg(dst);
    let b: i32 = ssa_xreg(base);
    let x: i32 = ssa_xreg(index);
    if (d >= 0 && b >= 0 && x >= 0) {
      return s.bytes(x86_native.x86_rec_movzb_mi(w, d, b, x, disp));
    }
  }
  if (w == 1) {
    return s.write("    movzbq " + ssa_mem_i(base, index, 1, disp) + ", " + dst + "\n");
  }
  return s.write("    movzbl " + ssa_mem_i(base, index, 1, disp) + ", " + ssa_r32(dst) + "\n");
}

// ssa_mov_text is the mov mnemonic at `size` bits.
function ssa_mov_text(size: i32): string {
  if (size == 8) {
    return "movb";
  }
  if (size == 32) {
    return "movl";
  }
  return "movq";
}

// ssa_mov_ir writes `mov $imm, dst`: movl for a value in [0, 2^32), which
// zero-extends, movq for one a sign-extended 32-bit immediate carries.
// `text` is the literal as the text spells it.
function ssa_mov_ir(s: asmcore.EmitState, size: i32, imm: i64, text: string, dst: string): asmcore.EmitState {
  if (s.records()) {
    let d: i32 = ssa_xreg(dst);
    if (d >= 0 && (size == 32 || imm >= -2147483648i64 && imm <= 2147483647i64)) {
      return s.bytes(x86_native.x86_rec_mov_ir(size, imm as i32, d));
    }
  }
  if (size == 32) {
    return s.write("    movl $" + text + ", " + ssa_r32(dst) + "\n");
  }
  return s.write("    movq $" + text + ", " + dst + "\n");
}

// ssa_mov_im writes `movq $imm, disp(base)` for an immediate a sign-extended
// 32-bit field carries.
function ssa_mov_im(s: asmcore.EmitState, imm: i64, base: string, disp: i32): asmcore.EmitState {
  if (s.records() && imm >= -2147483648i64 && imm <= 2147483647i64) {
    let b: i32 = ssa_xreg(base);
    if (b >= 0) {
      return s.bytes(x86_native.x86_rec_mov_im(64, imm as i32, b, disp));
    }
  }
  return s.write("    movq $" + util.i64_to_string(imm) + ", " + ssa_mem(base, disp, false) + "\n");
}

// ssa_zero writes the zeroing `xorl` of `d`.
function ssa_zero(s: asmcore.EmitState, d: string): asmcore.EmitState {
  return ssa_alu_rr(s, 6, 32, d, d);
}

// ssa_push_r, ssa_pop_r and ssa_push_slot write `pushq reg`, `popq reg` and
// the push of a frame slot.
function ssa_push_r(s: asmcore.EmitState, reg: string): asmcore.EmitState {
  if (s.records()) {
    let r: i32 = ssa_xreg(reg);
    if (r >= 0) {
      return s.bytes(x86_native.x86_rec_push_r(r));
    }
  }
  return s.write("    pushq " + reg + "\n");
}

function ssa_pop_r(s: asmcore.EmitState, reg: string): asmcore.EmitState {
  if (s.records()) {
    let r: i32 = ssa_xreg(reg);
    if (r >= 0) {
      return s.bytes(x86_native.x86_rec_pop_r(r));
    }
  }
  return s.write("    popq " + reg + "\n");
}

function ssa_push_slot(s: asmcore.EmitState, disp: i32): asmcore.EmitState {
  if (s.records()) {
    return s.bytes(x86_native.x86_rec_push_m(5, disp));
  }
  return s.write("    pushq " + util.i32_to_string(disp) + "(%rbp)\n");
}

// ssa_ret and ssa_leave write `ret` and `leave`.
function ssa_ret(s: asmcore.EmitState): asmcore.EmitState {
  if (s.records()) {
    return s.bytes(x86_native.x86_rec_ret());
  }
  return s.write("    ret\n");
}

function ssa_leave(s: asmcore.EmitState): asmcore.EmitState {
  if (s.records()) {
    return s.bytes(x86_native.x86_rec_leave());
  }
  return s.write("    leave\n");
}

// ssa_lea_rm writes `leaq disp(base), dst`.
function ssa_lea_rm(s: asmcore.EmitState, dst: string, base: string, disp: i32): asmcore.EmitState {
  if (s.records()) {
    let d: i32 = ssa_xreg(dst);
    let b: i32 = ssa_xreg(base);
    if (d >= 0 && b >= 0) {
      return s.bytes(x86_native.x86_rec_lea_rm(d, b, disp));
    }
  }
  return s.write("    leaq " + util.i32_to_string(disp) + "(" + base + "), " + dst + "\n");
}

// ssa_inc writes `incq dst`.
function ssa_inc(s: asmcore.EmitState, dst: string): asmcore.EmitState {
  if (s.records()) {
    let d: i32 = ssa_xreg(dst);
    if (d >= 0) {
      return s.bytes(x86_native.x86_rec_inc_r(d));
    }
  }
  return s.write("    incq " + dst + "\n");
}

// ssa_cfi writes a .cfi_* directive: as a record when records are on, else
// as its text. `kind` is cfi_record's: 1 startproc, 2 endproc, 3
// def_cfa_offset n, 4 def_cfa_register reg, 5 def_cfa reg, n, 6 offset reg, n,
// 7 remember_state, 8 restore_state.
function ssa_cfi(s: asmcore.EmitState, kind: i32, reg: string, n: i32): asmcore.EmitState {
  if (s.records()) {
    return s.cfi(kind, ssa_dwarf(reg), n);
  }
  if (kind == 1) {
    return s.write("    .cfi_startproc\n");
  }
  if (kind == 2) {
    return s.write("    .cfi_endproc\n");
  }
  if (kind == 3) {
    return s.write("    .cfi_def_cfa_offset " + util.i32_to_string(n) + "\n");
  }
  if (kind == 4) {
    return s.write("    .cfi_def_cfa_register " + reg + "\n");
  }
  if (kind == 5) {
    return s.write("    .cfi_def_cfa " + reg + ", " + util.i32_to_string(n) + "\n");
  }
  if (kind == 6) {
    return s.write("    .cfi_offset " + reg + ", " + util.i32_to_string(n) + "\n");
  }
  if (kind == 7) {
    return s.write("    .cfi_remember_state\n");
  }
  return s.write("    .cfi_restore_state\n");
}

// ssa_dwarf is a register's DWARF column, which orders rcx, rdx, rsi, rdi,
// rbp and rsp differently from their encoding; 0 for a name ssa_xreg does not
// know, which no directive here names.
function ssa_dwarf(reg: string): i32 {
  let m: i32 = ssa_xreg(reg);
  if (m < 0) {
    return 0;
  }
  return [0, 2, 1, 3, 7, 6, 4, 5, 8, 9, 10, 11, 12, 13, 14, 15][m];
}

// ssa_jump_sym branches to a symbol, which keeps its name: the record line
// skips the text path's memo lookup and comment and label scans.
function ssa_jump_sym(s: asmcore.EmitState, mnem: string, name: string): asmcore.EmitState {
  if (s.records()) {
    return s.mark("\x03", mnem + " " + name);
  }
  return s.write("    " + mnem + " " + name + "\n");
}

// ssa_alu_rr writes the group-1 op `ext` between two registers.
function ssa_alu_rr(s: asmcore.EmitState, ext: i32, size: i32, src: string, dst: string): asmcore.EmitState {
  if (s.records()) {
    let r: i32 = ssa_xreg(src);
    let d: i32 = ssa_xreg(dst);
    if (r >= 0 && d >= 0) {
      return s.bytes(x86_native.x86_rec_alu_rr(ext, size, r, d));
    }
  }
  return s.write("    " + ssa_alu_text(ext, size) + " " + ssa_wreg(size, src) + ", " + ssa_wreg(size, dst) + "\n");
}

// ssa_alu_ir writes the group-1 op `ext` from an immediate into a register.
function ssa_alu_ir(s: asmcore.EmitState, ext: i32, size: i32, imm: i64, dst: string): asmcore.EmitState {
  if (s.records() && imm >= -2147483648i64 && imm <= 2147483647i64) {
    let d: i32 = ssa_xreg(dst);
    if (d >= 0) {
      return s.bytes(x86_native.x86_rec_alu_ir(ext, size, imm as i32, d));
    }
  }
  return s.write("    " + ssa_alu_text(ext, size) + " $" + util.i64_to_string(imm) + ", " + ssa_wreg(size, dst) + "\n");
}

// ssa_alu_im writes the group-1 op `ext` from an immediate into memory at
// `disp` off `base`; ssa_alu_im0 at `(base)`, spelt without a displacement.
function ssa_alu_im(s: asmcore.EmitState, ext: i32, size: i32, imm: i32, base: string, disp: i32): asmcore.EmitState {
  return ssa_alu_im_at(s, ext, size, imm, base, disp, false);
}

function ssa_alu_im0(s: asmcore.EmitState, ext: i32, size: i32, imm: i32, base: string): asmcore.EmitState {
  return ssa_alu_im_at(s, ext, size, imm, base, 0, true);
}

function ssa_alu_im_at(s: asmcore.EmitState, ext: i32, size: i32, imm: i32, base: string, disp: i32, bare: boolean): asmcore.EmitState {
  if (s.records()) {
    let b: i32 = ssa_xreg(base);
    if (b >= 0) {
      return s.bytes(x86_native.x86_rec_alu_im(ext, size, imm, b, disp));
    }
  }
  return s.write("    " + ssa_alu_text(ext, size) + " $" + util.i32_to_string(imm) + ", " + ssa_mem(base, disp, bare) + "\n");
}

// ssa_alu_rm writes the group-1 op `ext` between a register and memory at
// `disp` off `base`; `load` reads the memory and writes the register.
// ssa_alu_rm0 is its form at `(base)`.
function ssa_alu_rm(s: asmcore.EmitState, ext: i32, size: i32, load: boolean, reg: string, base: string, disp: i32): asmcore.EmitState {
  return ssa_alu_rm_at(s, ext, size, load, reg, base, disp, false);
}

function ssa_alu_rm0(s: asmcore.EmitState, ext: i32, size: i32, load: boolean, reg: string, base: string): asmcore.EmitState {
  return ssa_alu_rm_at(s, ext, size, load, reg, base, 0, true);
}

function ssa_alu_rm_at(s: asmcore.EmitState, ext: i32, size: i32, load: boolean, reg: string, base: string, disp: i32, bare: boolean): asmcore.EmitState {
  if (s.records()) {
    let r: i32 = ssa_xreg(reg);
    let b: i32 = ssa_xreg(base);
    if (r >= 0 && b >= 0) {
      return s.bytes(x86_native.x86_rec_alu_rm(ext, size, load, r, b, disp));
    }
  }
  let mem: string = ssa_mem(base, disp, bare);
  if (load) {
    return s.write("    " + ssa_alu_text(ext, size) + " " + mem + ", " + ssa_wreg(size, reg) + "\n");
  }
  return s.write("    " + ssa_alu_text(ext, size) + " " + ssa_wreg(size, reg) + ", " + mem + "\n");
}

// ssa_wreg is `reg`, a 64-bit register name, spelt at `size` bits.
function ssa_wreg(size: i32, reg: string): string {
  if (size == 32) {
    return ssa_r32(reg);
  }
  if (size == 8) {
    return ssa_r8(reg);
  }
  return reg;
}

// ssa_mem is the text of `disp(base)`: a bare `(base)` when `bare` and the
// displacement is zero.
function ssa_mem(base: string, disp: i32, bare: boolean): string {
  if (bare && disp == 0) {
    return "(" + base + ")";
  }
  return util.i32_to_string(disp) + "(" + base + ")";
}

// ssa_mem_i is the text of `disp(base,index,scale)`, with no displacement
// when it is zero and no scale when it is one.
function ssa_mem_i(base: string, index: string, scale: i32, disp: i32): string {
  let out: string = "";
  if (disp != 0) {
    out = util.i32_to_string(disp);
  }
  out = out + "(" + base + "," + index;
  if (scale != 1) {
    out = out + "," + util.i32_to_string(scale);
  }
  return out + ")";
}

// ssa_alu_rhs writes the group-1 op `ext` from value v, read as ssa_rhs
// reads it, into the register `dst`.
function ssa_alu_rhs(s: asmcore.EmitState, ext: i32, size: i32, fr: SsaFrame, reg_of: i32[], v: i32, dst: string): asmcore.EmitState {
  if (fr.imm.is_imm[v]) {
    return ssa_alu_ir(s, ext, size, fr.imm.value[v], dst);
  }
  if (reg_of[v] >= 0) {
    return ssa_alu_rr(s, ext, size, ssa_reg(reg_of[v]), dst);
  }
  return ssa_alu_rm(s, ext, size, true, dst, "%rbp", ssa_slot_disp(ssa.spill_slot(reg_of[v]), s.ssa_save));
}

// ssa_cmp_floor compares a 64-bit register with the heap floor, 0x10000.
function ssa_cmp_floor(s: asmcore.EmitState, reg: string): asmcore.EmitState {
  if (s.records()) {
    let r: i32 = ssa_xreg(reg);
    if (r >= 0) {
      return s.bytes(x86_native.x86_rec_alu_ir(7, 64, 65536, r));
    }
  }
  return s.write("    cmpq $0x10000, " + reg + "\n");
}

// ssa_test_rr writes `test a, b` at `size` bits.
function ssa_test_rr(s: asmcore.EmitState, size: i32, a: string, b: string): asmcore.EmitState {
  if (s.records()) {
    let ra: i32 = ssa_xreg(a);
    let rb: i32 = ssa_xreg(b);
    if (ra >= 0 && rb >= 0) {
      return s.bytes(x86_native.x86_rec_test_rr(size, ra, rb));
    }
  }
  if (size == 32) {
    return s.write("    testl " + ssa_r32(a) + ", " + ssa_r32(b) + "\n");
  }
  return s.write("    testq " + a + ", " + b + "\n");
}

// ssa_test_bit writes `testb $imm, <reg's low byte>`.
function ssa_test_bit(s: asmcore.EmitState, imm: i32, reg: string): asmcore.EmitState {
  if (s.records()) {
    let r: i32 = ssa_xreg(reg);
    if (r >= 0) {
      return s.bytes(x86_native.x86_rec_test_ir(8, imm, r));
    }
  }
  return s.write("    testb $" + util.i32_to_string(imm) + ", " + ssa_r8(reg) + "\n");
}

// ssa_x0_forget marks %r11 as holding no tracked value: at a label, and
// before a sequence that writes %r11 on its own.
function ssa_x0_forget(s: asmcore.EmitState): asmcore.EmitState {
  return asmcore.EmitState { ...s, ssa_x0: 0 - 1 };
}

function ssa_store(reg_of: i32[], v: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
  if (reg == "%r11") {
    s = asmcore.EmitState { ...s, ssa_x0: v };
  }
  if (reg_of[v] == 0 - 1) {
    return s;
  }
  if (reg_of[v] < 0) {
    return ssa_mov_slot(s, false, reg, ssa_slot_disp(ssa.spill_slot(reg_of[v]), s.ssa_save));
  }
  let home: string = ssa_reg(reg_of[v]);
  if (home == reg) {
    return s;
  }
  return ssa_mov_rr(s, home, reg);
}

// ssa_dst is where an instruction this emitter selects itself writes its
// result: the value's register home, or %r11 for a value in a frame slot,
// which ssa_store then spills. ssa_src is where an operand is read from: its
// register home, or `scratch` once ssa_load has filled it. An instruction's
// result shares a register with an operand only when it is a phi or one of
// the two-operand integer ops, whose operand is read before the result is
// written; the allocator frees any other operand's register only after the
// instruction that last reads it.
function ssa_dst(reg_of: i32[], v: i32): string {
  if (reg_of[v] >= 0) {
    return ssa_reg(reg_of[v]);
  }
  return "%r11";
}

function ssa_src(reg_of: i32[], v: i32, scratch: string): string {
  if (reg_of[v] >= 0) {
    return ssa_reg(reg_of[v]);
  }
  return scratch;
}

// ssa_read brings a spilled operand into `scratch`, so ssa_src names where it
// is; a register-homed operand is read from its home and needs nothing.
function ssa_read(reg_of: i32[], v: i32, scratch: string, s: asmcore.EmitState): asmcore.EmitState {
  if (reg_of[v] >= 0) {
    return s;
  }
  return ssa_load(reg_of, v, scratch, s);
}

// The integer ops with a two-operand form `op src, dst`: they compute into the
// result's home with the left operand moved there first. Division works in
// %rdx:%rax and a shift's count in %cl, so those keep the scratch path.
function ssa_direct_bin(tag: i32): boolean {
  return tag == 21 || tag == 22 || tag == 23 || tag == 28 || tag == 29 || tag == 30 || ircore.is_int_cmp_kind(tag);
}

// A shift computes in the destination too, but only with the count known: the
// variable-count form reads %cl, which is not where an operand lives.
function ssa_shift_tag(tag: i32): boolean {
  return tag == 31 || tag == 32 || tag == 33;
}

function ssa_commutative(tag: i32): boolean {
  return tag == 21 || tag == 23 || tag == 28 || tag == 29 || tag == 30 || tag == 35 || tag == 36;
}

// The ops whose right operand, or whose left operand when it can be turned
// round, may be an imm32 rather than a register: the two-operand forms and
// the compares. A shift count is %cl and a division's divisor a register.
function ssa_imm_right(): string[] {
  return ["add", "sub", "mul", "and", "or", "xor", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u", "shl", "shr_s", "shr_u", "div_s", "div_u", "rem_s", "rem_u"];
}

function ssa_imm_left(): string[] {
  return ["add", "mul", "and", "or", "xor", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u"];
}

// ssa_rhs is a right operand as an ALU op or compare reads it: the immediate
// for a constant that has none, the register home, or a spilled value's frame
// slot, read in place.
function ssa_rhs(fr: SsaFrame, reg_of: i32[], v: i32, save: i32): string {
  if (fr.imm.is_imm[v]) {
    return "$" + util.i64_to_string(fr.imm.value[v]);
  }
  if (reg_of[v] >= 0) {
    return ssa_reg(reg_of[v]);
  }
  return ssa_slot(ssa.spill_slot(reg_of[v]), save);
}

// ssa_bin_in_place emits a two-operand integer op into the result's home,
// each operand read from its own. A multiply by a constant reads its operand
// where it lives, through imul's three-operand form; any other op moves the
// left operand into the destination and reads the right one where it lives,
// or as an immediate. A right operand that lives in the destination would be
// overwritten by that move, so the operands swap for a commutative op or a
// flipped comparison; a subtraction in that shape computes in the scratch
// and is stored after. A constant on the left is only ever one the op can
// take on the right, so it swaps the same way.
function ssa_bin_in_place(ins: ssa.SInst, reg_of: i32[], fr: SsaFrame, s: asmcore.EmitState): asmcore.EmitState {
  let tag: i32 = ir.kind_id(ins.str);
  let a: i32 = ins.args[0];
  let b: i32 = ins.args[1];
  let dh: string = ssa_dst(reg_of, ins.result);
  let swap: boolean = fr.imm.is_imm[a] && !ssa_shift_tag(tag);
  if (!swap && !fr.imm.is_imm[b] && ssa_src(reg_of, b, "%rcx") == dh) {
    if (ssa_commutative(tag) || ircore.flip_int_cmp_kind(tag) != tag) {
      swap = true;
    } else {
      dh = "%r11";
    }
  }
  if (swap) {
    tag = ircore.flip_int_cmp_kind(tag);
    let t: i32 = a;
    a = b;
    b = t;
  }
  if (tag == 23 && fr.imm.is_imm[b] && reg_of[a] >= 0) {
    s = s.write("    imulq $" + util.i64_to_string(fr.imm.value[b]) + ", " + ssa_reg(reg_of[a]) + ", " + dh + "\n");
    return ssa_store(reg_of, ins.result, dh, s);
  }
  let lea: string = ssa_lea_operand(tag, a, b, dh, reg_of, fr);
  if (lea != "") {
    s = s.write("    leaq " + lea + ", " + dh + "\n");
    return ssa_store(reg_of, ins.result, dh, s);
  }
  s = ssa_load(reg_of, a, dh, s);
  if (ssa_shift_tag(tag)) {
    s = s.write(shift_imm_asm(tag, ins.imm, fr.imm.value[b], dh));
  } else if (ssa_alu_ext(tag) >= 0) {
    s = ssa_alu_rhs(s, ssa_alu_ext(tag), 64, fr, reg_of, b, dh);
  } else {
    s = s.write(ir_bin_asm(tag, ins.imm, dh, ssa_rhs(fr, reg_of, b, s.ssa_save)));
  }
  return ssa_store(reg_of, ins.result, dh, s);
}

// ssa_alu_ext is the group-1 /digit of a two-operand integer op, -1 for the
// rest.
function ssa_alu_ext(tag: i32): i32 {
  if (tag == 21) {
    return 0;
  }
  if (tag == 22) {
    return 5;
  }
  if (tag == 28) {
    return 4;
  }
  if (tag == 29) {
    return 1;
  }
  if (tag == 30) {
    return 6;
  }
  return 0 - 1;
}

// ssa_lea_operand is the address an add, or a subtract of a constant, computes
// when its result lands in a register the left operand does not hold: one lea
// in place of a copy and the two-address op. Nothing reads the flags an add
// leaves. It is "" when the op takes the two-address form.
function ssa_lea_operand(tag: i32, a: i32, b: i32, dh: string, reg_of: i32[], fr: SsaFrame): string {
  if (tag != 21 && tag != 22 || reg_of[a] < 0) {
    return "";
  }
  let ra: string = ssa_reg(reg_of[a]);
  if (ra == dh) {
    return "";
  }
  if (fr.imm.is_imm[b]) {
    // An immediate is a signed 32-bit value, so only the least one has no
    // negation for the displacement.
    let v: i64 = fr.imm.value[b];
    if (tag == 22 && v == -2147483648i64) {
      return "";
    }
    if (tag == 22) {
      v = 0i64 - v;
    }
    return util.i64_to_string(v) + "(" + ra + ")";
  }
  if (tag == 21 && reg_of[b] >= 0) {
    return "(" + ra + "," + ssa_reg(reg_of[b]) + ")";
  }
  return "";
}

// ssa_r32 and ssa_r8 are the 32-bit and 8-bit names of a 64-bit register.
function ssa_r32(r: string): string {
  if (r == "%rbx") {
    return "%ebx";
  }
  if (r == "%rax") {
    return "%eax";
  }
  if (r == "%rcx") {
    return "%ecx";
  }
  if (r == "%rdx") {
    return "%edx";
  }
  if (r == "%rsi") {
    return "%esi";
  }
  if (r == "%rdi") {
    return "%edi";
  }
  return r + "d";
}

function ssa_r8(r: string): string {
  if (r == "%rbx") {
    return "%bl";
  }
  if (r == "%rax") {
    return "%al";
  }
  if (r == "%rcx") {
    return "%cl";
  }
  if (r == "%rdx") {
    return "%dl";
  }
  if (r == "%rsi") {
    return "%sil";
  }
  if (r == "%rdi") {
    return "%dil";
  }
  return r + "b";
}

// ssa_const_reg materialises an integer literal in `d`: the zeroing xor, the
// narrow movl for a value in [0, 2^32) (five bytes, zero-extending), the
// imm32 movq for a negative one, movabsq for an i64 literal past 32 bits.
function ssa_const_reg(text: string, wide64: boolean, d: string, s: asmcore.EmitState): asmcore.EmitState {
  if (!const_text_u32(text)) {
    if (wide64) {
      return s.write("    movabsq $" + text + ", " + d + "\n");
    }
    return ssa_mov_ir(s, 64, util.lit_to_i64(text), text, d);
  }
  let v: i64 = util.lit_to_i64(text);
  if (v == 0i64) {
    return ssa_zero(s, d);
  }
  return ssa_mov_ir(s, 32, v, text, d);
}

// ssa_unary_known is the unary vocabulary lift_from_ir_prod produces.
function ssa_unary_known(what: string): boolean {
  if (what == "!" || what == "int_extend" || what == "int_wrap" || what == "u32_wrap" || what == "load_i32") {
    return true;
  }
  return util.str_has_prefix(what, "int_cast:") || util.str_has_prefix(what, "rotr:") || ssa_funary_known(what) || ssa_bits_asm(what, "%rax") != "";
}

// ssa_funary_known is the f64 unary vocabulary lift_float_prod produces.
function ssa_funary_known(what: string): boolean {
  let un: string[] = ["fsqrt", "ffloor", "fceil", "ftrunc", "fabs", "fround", "fneg", "f64_to_i32", "f64_to_i64", "f32_bits", "f32_from_bits"];
  for x in un {
    if (x == what) {
      return true;
    }
  }
  return util.str_has_prefix(what, "i32_to_f64:");
}

function ssa_inst_known(ins: ssa.SInst): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 10) {
    return ssa_unary_known(ins.str);
  }
  if (k >= 40 && k <= 60) {
    return true;
  }
  return k == 1 || k == 3 || k == 4 || k == 6 || k == 7 || k == 8 || k == 9 || k == 11 || k == 35;
}

// ssa_unsupported names the first instruction this emitter has no selection
// for, "" when it can emit the whole function.
function ssa_unsupported(f: ssa.SFunc): string {
  for blk in f.blocks {
    for ins in blk.insts {
      if (!ssa_inst_known(ins)) {
        return "ssa " + ssa.kind_name(ins.kind_tag) + " " + ins.str;
      }
    }
    if (blk.term.kind_tag > 3) {
      return "ssa terminator " + ssa.term_name(blk.term.kind_tag);
    }
  }
  return "";
}

function ssa_block_at(fr: SsaFrame, id: i32): i32 {
  if (id < 0 || id >= fr.blk_pos.len()) {
    return 0 - 1;
  }
  return fr.blk_pos[id];
}

function ssa_has_phis(f: ssa.SFunc, fr: SsaFrame, id: i32): boolean {
  let ti: i32 = ssa_block_at(fr, id);
  if (ti < 0) {
    return false;
  }
  for ins in f.blocks[ti].insts {
    if (ins.kind_tag == 8) {
      return true;
    }
  }
  return false;
}

// ssa_unary_asm is the stack machine's selection for the width ops, `not`
// and the f64 unaries, on %rax. A cast to a type none of the arms name moves
// nothing there either. `lb` is a per-op-unique label base for the saturating
// conversions and fround.
function ssa_unary_asm(what: string, unsigned: boolean, lb: string, d: string): string {
  let f: string = ssa_fmath_asm(what, d);
  if (f == "") {
    f = ssa_fconv_asm(what, unsigned, lb, d);
  }
  if (f == "") {
    f = ssa_bits_asm(what, d);
  }
  if (f != "") {
    return f;
  }
  if (what == "load_i32") {
    return "    movslq (" + d + "), " + d + "\n";
  }
  if (what == "!") {
    return "    testq " + d + ", " + d + "\n    setz " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n";
  }
  if (util.str_has_prefix(what, "rotr:")) {
    let n: string = util.i32_to_string(ssa.rotr_count(what));
    if (ssa.rotr_width(what) == 64) {
      return "    rorq $" + n + ", " + d + "\n";
    }
    return "    rorl $" + n + ", " + ssa_r32(d) + "\n";
  }
  if (what == "u32_wrap" || what == "int_cast:u32") {
    return "    movl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n";
  }
  if (what == "int_cast:u8") {
    return "    andq $255, " + d + "\n";
  }
  if (what == "int_cast:i32") {
    return "    movslq " + ssa_r32(d) + ", " + d + "\n";
  }
  if (what == "int_extend" || what == "int_wrap") {
    if (unsigned) {
      return "    movl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n";
    }
    return "    movslq " + ssa_r32(d) + ", " + d + "\n";
  }
  return "";
}

// ssa_unary_from selects a width op or bit count that reads its operand from
// register `src` and writes `d`, so an operand outside `d` needs no copy into
// it first; "" for an op whose only form works in place.
function ssa_unary_from(what: string, unsigned: boolean, src: string, d: string): string {
  if (what == "load_i32") {
    return "    movslq (" + src + "), " + d + "\n";
  }
  if (what == "int_cast:i32" || (what == "int_extend" || what == "int_wrap") && !unsigned) {
    return "    movslq " + ssa_r32(src) + ", " + d + "\n";
  }
  if (what == "u32_wrap" || what == "int_cast:u32" || what == "int_extend" || what == "int_wrap") {
    return "    movl " + ssa_r32(src) + ", " + ssa_r32(d) + "\n";
  }
  if (what == "clz:64") {
    return "    lzcntq " + src + ", " + d + "\n";
  }
  if (what == "clz:32") {
    return "    lzcntl " + ssa_r32(src) + ", " + ssa_r32(d) + "\n";
  }
  if (what == "ctz:64") {
    return "    tzcntq " + src + ", " + d + "\n";
  }
  if (what == "ctz:32") {
    return "    tzcntl " + ssa_r32(src) + ", " + ssa_r32(d) + "\n";
  }
  if (what == "popcount:64") {
    return "    popcntq " + src + ", " + d + "\n";
  }
  if (what == "popcount:32") {
    return "    popcntl " + ssa_r32(src) + ", " + ssa_r32(d) + "\n";
  }
  return "";
}

// ssa_bits_asm is the bit counts on %rax at the width the name carries, as
// the stack machine's arms select them; "" for any other op.
function ssa_bits_asm(what: string, d: string): string {
  if (what == "clz:64") {
    return "    lzcntq " + d + ", " + d + "\n";
  }
  if (what == "clz:32") {
    return "    lzcntl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n";
  }
  if (what == "ctz:64") {
    return "    tzcntq " + d + ", " + d + "\n";
  }
  if (what == "ctz:32") {
    return "    tzcntl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n";
  }
  if (what == "popcount:64") {
    return "    popcntq " + d + ", " + d + "\n";
  }
  if (what == "popcount:32") {
    return "    popcntl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n";
  }
  if (what == "bswap:64") {
    return "    bswap " + d + "\n";
  }
  if (what == "bswap:32") {
    return "    bswap " + ssa_r32(d) + "\n";
  }
  return "";
}

// ssa_fmath_asm is the single-instruction f64 math on the pattern in %rax,
// as the stack machine's arms select it; "" for any other op.
function ssa_fmath_asm(what: string, d: string): string {
  let xmm: string = "";
  if (what == "fsqrt") {
    xmm = "    sqrtsd %xmm0, %xmm0\n";
  } else if (what == "ffloor") {
    xmm = "    roundsd $1, %xmm0, %xmm0\n";
  } else if (what == "fceil") {
    xmm = "    roundsd $2, %xmm0, %xmm0\n";
  } else if (what == "ftrunc") {
    xmm = "    roundsd $3, %xmm0, %xmm0\n";
  }
  if (xmm != "") {
    return "    movq " + d + ", %xmm0\n" + xmm + "    movq %xmm0, " + d + "\n";
  }
  if (what == "fabs") {
    return "    movabsq $0x7fffffffffffffff, %rcx\n    andq %rcx, " + d + "\n";
  }
  if (what == "fneg") {
    return "    movabsq $0x8000000000000000, %rcx\n    xorq %rcx, " + d + "\n";
  }
  return "";
}

// ssa_fconv_asm is the f64 conversions and reinterprets on %rax, the
// saturating and rounding ones through the same cores the stack machine's
// arms wrap; "" for any other op.
function ssa_fconv_asm(what: string, unsigned: boolean, lb: string, d: string): string {
  if (what == "fround") {
    return ir_fround_rax(lb, d);
  }
  if (what == "f64_to_i32" || what == "f64_to_i64") {
    let w: i32 = 32;
    if (what == "f64_to_i64") {
      w = 64;
    }
    if (unsigned) {
      return ir_f2u_sat_rax(w, lb, d);
    }
    return ir_f2i_sat_rax(w, lb, d);
  }
  if (what == "i32_to_f64:64") {
    return ir_i2f_rax(64, unsigned, lb, d);
  }
  if (what == "i32_to_f64:32") {
    return ir_i2f_rax(32, unsigned, lb, d);
  }
  if (what == "f32_bits") {
    return "    movq " + d + ", %xmm0\n    cvtsd2ss %xmm0, %xmm0\n    movd %xmm0, " + ssa_r32(d) + "\n    movsxd " + ssa_r32(d) + ", " + d + "\n";
  }
  if (what == "f32_from_bits") {
    return "    movd " + ssa_r32(d) + ", %xmm0\n    cvtss2sd %xmm0, %xmm0\n    movq %xmm0, " + d + "\n";
  }
  return "";
}

// ssa_fbin_asm is one f64 binary with the patterns in %rax (lhs) and %rcx
// (rhs), the result pattern or 0/1 in %rax; "" for an integer op. The
// compares are the stack machine's NaN-correct ucomisd forms.
function ssa_fbin_asm(what: string, d: string): string {
  let ld: string = "    movq " + d + ", %xmm0\n    movq %rcx, %xmm1\n";
  let arith: string = "";
  if (what == "fadd") {
    arith = "addsd";
  } else if (what == "fsub") {
    arith = "subsd";
  } else if (what == "fmul") {
    arith = "mulsd";
  } else if (what == "fdiv") {
    arith = "divsd";
  }
  if (arith != "") {
    return ld + "    " + arith + " %xmm1, %xmm0\n    movq %xmm0, " + d + "\n";
  }
  let cc: string = "";
  if (what == "flt") {
    cc = "    setb " + ssa_r8(d) + "\n    setnp %dl\n    andb %dl, " + ssa_r8(d) + "\n";
  } else if (what == "fle") {
    cc = "    setbe " + ssa_r8(d) + "\n    setnp %dl\n    andb %dl, " + ssa_r8(d) + "\n";
  } else if (what == "fgt") {
    cc = "    seta " + ssa_r8(d) + "\n";
  } else if (what == "fge") {
    cc = "    setae " + ssa_r8(d) + "\n";
  } else if (what == "feq") {
    cc = "    sete " + ssa_r8(d) + "\n    setnp %dl\n    andb %dl, " + ssa_r8(d) + "\n";
  } else if (what == "fne") {
    cc = "    setne " + ssa_r8(d) + "\n    setp %dl\n    orb %dl, " + ssa_r8(d) + "\n";
  }
  if (cc == "") {
    return "";
  }
  return ld + "    ucomisd %xmm1, %xmm0\n    movq $0, " + d + "\n" + cc + "    movzbq " + ssa_r8(d) + ", " + d + "\n";
}

// ssa_fcall_sym is the runtime helper for a transcendental, "" otherwise.
function ssa_fcall_sym(what: string): string {
  if (what == "fsin") {
    return "__fern_sin_f64";
  }
  if (what == "fcos") {
    return "__fern_cos_f64";
  }
  if (what == "fexp") {
    return "__fern_exp_f64";
  }
  if (what == "flog") {
    return "__fern_log_f64";
  }
  if (what == "fpow") {
    return "__fern_pow_f64";
  }
  return "";
}

// ssa_fcall calls a transcendental helper: the operand patterns in %xmm0 (and
// %xmm1 for fpow), the result pattern back from %xmm0.
function ssa_fcall(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  s = s.need("float_transcendentals");
  s = ssa_load(reg_of, ins.args[0], "%r11", s);
  if (ins.args.len() > 1) {
    s = ssa_load(reg_of, ins.args[1], "%rcx", s);
    s = s.write("    movq %rcx, %xmm1\n");
  }
  s = s.write("    movq %r11, %xmm0\n    call " + ssa_fcall_sym(ins.str) + "\n    movq %xmm0, %rax\n");
  return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// ssa_bin_work is the register a binary computes in: %rax for the four
// guarded divisions, which idiv fixes there, and the register path's own
// scratch for everything else.
function ssa_bin_work(op: string): string {
  let tag: i32 = ir.kind_id(op);
  if (tag == 24 || tag == 25 || tag == 26 || tag == 27) {
    return "%rax";
  }
  return "%r11";
}

// ssa_binary is one binary op with the operands in %rax and %rcx: for the
// four div/rem kinds the literal-divisor forms when the divisor is a constant
// (ir_div_const, which reads nothing but %rax) and the guarded division
// otherwise (a per-op-unique label base), the f64 forms, ir_bin_asm for the
// rest.
function ssa_binary(ins: ssa.SInst, fr: SsaFrame, lp: string, d: string, s: asmcore.EmitState): asmcore.EmitState {
  let fb: string = ssa_fbin_asm(ins.str, d);
  if (fb != "") {
    return s.write(fb);
  }
  let tag: i32 = ir.kind_id(ins.str);
  if (tag == 24 || tag == 25 || tag == 26 || tag == 27) {
    let b: i32 = ins.args[1];
    if (fr.imm.konst[b]) {
      return s.write(ir_div_const(tag, ins.imm, fr.imm.value[b]));
    }
    return s.write(ir_div_guarded(tag, ins.imm, lp + "d" + util.i32_to_string(ins.result)));
  }
  return s.write(ir_bin_asm(tag, ins.imm, d, "%rcx"));
}

// With %rax an allocatable home, an arm that fills the ABI's argument
// registers in order can destroy a later argument. ssa_load_abi_args loads
// the argument homed in %rax first, into its own target, so nothing is read
// after it is written.
function ssa_load_abi_args(reg_of: i32[], args: i32[], regs: string[], s: asmcore.EmitState): asmcore.EmitState {
  let first: i32 = 0 - 1;
  let i: i32 = 1;
  while (i < args.len() && i < regs.len()) {
    if (reg_of[args[i]] == 0) {
      first = i;
    }
    i = i + 1;
  }
  if (first >= 0) {
    s = ssa_load(reg_of, args[first], regs[first], s);
  }
  i = 0;
  while (i < args.len() && i < regs.len()) {
    if (i != first) {
      s = ssa_load(reg_of, args[i], regs[i], s);
    }
    i = i + 1;
  }
  return s;
}

// ssa_push_operand stages one call argument: a push of the value's home,
// which is what the stack machine emits too. A spilled value pushes its slot
// directly, since the frame addresses from %rbp and the pushes do not move it,
// so an argument costs one instruction rather than a load and a push.
function ssa_push_operand(reg_of: i32[], v: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (reg_of[v] < 0) {
    return ssa_push_slot(s, ssa_slot_disp(ssa.spill_slot(reg_of[v]), s.ssa_save));
  }
  return ssa_push_r(s, ssa_reg(reg_of[v]));
}

// ssa_rc_prim renders one rc primitive inline, in the instructions its stub
// uses. Both skip a tagged pointer and anything below the heap floor, which
// is also every null. is_unique needs no test for a static sentinel's
// negative count, since a negative count never compares equal to one; rc_inc
// needs one, because it would otherwise increment it.
//
// The count is compared in memory, or read into %rdx first when the sanitizer
// checks it; the 0/1 is built in %rcx. Neither register is ever a home, so both
// survive a destination that IS the operand's register —
// the usual case once a result and its operand share one — and the
// destination is written after the last read of the operand.
//
// Every read of the count carries the sanitizer's poison check, as its stub's
// does — the uniqueness test no less than the retain. A stale reference that
// lands on the test rather than the retain would otherwise answer "not
// unique" and go unreported (#9889).
function ssa_rc_prim(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
  if (!s.retain_sites || ins.str != "__fern_rc_is_unique") {
    return ssa_rc_prim_emit(ins, reg_of, lp, s);
  }
  let h = buf_new(512);
  let site = ssaprepare.UniqueSite { input: ins.args[0], result: ins.result, input_home: reg_of[ins.args[0]], result_home: reg_of[ins.result], cached: s.ssa_x0, flags: false, aligned: ins.imm == 4, inverted: false, join: lp + "rcuniq" + util.i32_to_string(ins.result), text: "" };
  let out = ssa_rc_prim_emit(ins, reg_of, lp, asmcore.EmitState { ...s, capture: h });
  return asmcore.finish_unique_site(out, h, s.capture, site);
}

function ssa_rc_prim_emit(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
  s = helper_call_needs(ins.str, s);
  s = ssa_read(reg_of, ins.args[0], "%r11", s);
  let p: string = ssa_src(reg_of, ins.args[0], "%r11");
  let dname: string = lp + "rcinc" + util.i32_to_string(ins.result);
  if (ins.str == "__fern_rc_is_unique") {
    dname = lp + "rcuniq" + util.i32_to_string(ins.result);
  }
  let dn: asmcore.LabNew = asmcore.lab_new(s, dname);
  s = dn.state;
  let done: asmcore.Lab = dn.lab;
  let rb: string = p;
  if (ins.imm != 4) {
    rb = "%rdx";
  }
  if (ins.str == "__fern_rc_is_unique") {
    let d: string = ssa_dst(reg_of, ins.result);
    s = ssa_zero(s, "%rcx");
    s = ssa_rc_guard(s, p, done, ins.imm != 4);
    s = ssa_rc_is_one(s, rb);
    s = ssa_branch(s, J_JNE, done);
    s = ssa_mov_ir(s, 32, 1i64, "1", "%rcx");
    s = s.lab_def(done);
    s = ssa_mov_rr(s, d, "%rcx");
    return ssa_store(reg_of, ins.result, d, s);
  }
  s = ssa_rc_guard(s, p, done, ins.imm != 4);
  if (s.rc_free_debug) {
    s = ssa_mov_rm(s, 32, true, "%rcx", rb, 0 - 8).write(san_poison_check("%ecx", s.rc_free_debug));
    s = ssa_branch(ssa_test_rr(s, 32, "%rcx", "%rcx"), J_JS, done);
    s = ssa_mov_rm(ssa_alu_ir(s, 0, 32, 1i64, "%rcx"), 32, false, "%rcx", rb, 0 - 8);
  } else {
    s = ssa_branch(ssa_alu_im(s, 7, 32, 0, rb, 0 - 8), J_JS, done);
    s = ssa_alu_im(s, 0, 32, 1, rb, 0 - 8);
  }
  s = s.lab_def(done);
  // rc_inc hands the pointer back; a result with no home stores nothing.
  return ssa_store(reg_of, ins.result, p, s);
}

// ssa_rc_guard jumps to `done` for a pointer with no count to touch: an inline
// string's tag bit, or below the heap floor (every null). `strip` clears the
// view bit into %rdx, the base the count is read through.
function ssa_rc_guard(s: asmcore.EmitState, p: string, done: asmcore.Lab, strip: boolean): asmcore.EmitState {
  s = ssa_branch(ssa_test_bit(s, 1, p), J_JNZ, done);
  s = ssa_branch(ssa_cmp_floor(s, p), J_JB, done);
  if (strip) {
    s = ssa_mov_rr(s, "%rdx", p);
    s = ssa_alu_ir(s, 4, 64, -3i64, "%rdx");
  }
  return s;
}

// ssa_helper_call calls a runtime helper through its register entry.
function ssa_helper_call(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = helper_call_needs(ins.str, s);
  let hsrc: i32[] = [];
  let hdst: i32[] = [];
  let ha: i32 = 0;
  while (ha < ins.args.len()) {
    hsrc = hsrc.append(reg_of[ins.args[ha]]);
    hdst = hdst.append(ha);
    ha = ha + 1;
  }
  s = ssa_parallel_moves(hsrc, hdst, s);
  s = ssa_call_sym(s, ircore.ir_helper_symbol(ins.str) + ".r");
  return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// ssa_rc_dec renders an array or string release inline where the count
// survives it: below the heap floor (every null), an inline string's tag bit,
// a static box's negative count, and a count above one, which is decremented
// in memory. A count of one (the free) or zero (the underflow the helper
// reports) calls the helper. Either way the pointer is the result, as the
// helper leaves it in %rax.
function ssa_rc_dec(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
  s = helper_call_needs(ins.str, s);
  s = ssa_read(reg_of, ins.args[0], "%r11", s);
  let p: string = ssa_src(reg_of, ins.args[0], "%r11");
  let id: string = util.i32_to_string(ins.result);
  let dn: asmcore.LabNew = asmcore.lab_new(s, lp + "rcdecd" + id);
  let kn: asmcore.LabNew = asmcore.lab_new(dn.state, lp + "rcdeck" + id);
  let en: asmcore.LabNew = asmcore.lab_new(kn.state, lp + "rcdece" + id);
  s = en.state;
  let dec: asmcore.Lab = dn.lab;
  let kept: asmcore.Lab = kn.lab;
  let done: asmcore.Lab = en.lab;
  if (ins.str == "__fern_str_free") {
    s = ssa_branch(ssa_test_bit(s, 1, p), J_JNZ, kept);
  }
  s = ssa_branch(ssa_cmp_floor(s, p), J_JB, kept);
  s = ssa_branch(ssa_alu_im(s, 7, 32, 1, p, 0 - 8), J_JG, dec);
  s = ssa_branch(ssa_alu_im(s, 7, 32, 0, p, 0 - 8), J_JS, kept);
  s = ssa_helper_call(ins, reg_of, s);
  s = ssa_branch(s, J_JMP, done).lab_def(dec);
  s = ssa_alu_im(s, 5, 32, 1, p, 0 - 8).lab_def(kept);
  s = ssa_store(reg_of, ins.result, p, s);
  return s.lab_def(done);
}

// ssa_call emits one call as the stack machine leaves it: the arguments pushed
// in IR order for a runtime helper and reversed for a user function (arg0 on
// top), the callee, the caller-side pop, and %rax stored.
function ssa_call(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
  if (ssa.rc_inlined(ins)) {
    return ssa_rc_prim(ins, reg_of, lp, s);
  }
  s = ssa_x0_forget(s);
  if ((ins.str == "__fern_rc_dec" || ins.str == "__fern_str_free") && ins.args.len() == 1 && !s.rc_free_debug) {
    return ssa_rc_dec(ins, reg_of, lp, s);
  }
  if (ircore.is_fern_helper(ins.str) && ssa_reg_helper(ircore.ir_helper_symbol(ins.str), ins.args.len())) {
    return ssa_helper_call(ins, reg_of, s);
  }
  if (ssa_reg_call(ins, s)) {
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(ssa_reg_call_emit(ins, reg_of, s)));
  }
  let argc: i32 = ins.args.len();
  let helper: boolean = ircore.is_fern_helper(ins.str);
  if (helper) {
    s = helper_call_needs(ins.str, s);
  } else if (ircore.is_c_call(ins.str)) {
    s = s.need("ccall:" + ins.str);
  } else if (ircore.is_task_runtime_fn(ins.str)) {
    s = s.need("task");
  }
  let i: i32 = 0;
  while (i < argc) {
    let a: i32 = i;
    if (!helper) {
      a = argc - 1 - i;
    }
    s = ssa_push_operand(reg_of, ins.args[a], s);
    i = i + 1;
  }
  if (helper) {
    s = ssa_call_sym(s, ircore.ir_helper_symbol(ins.str));
  } else {
    s = ssa_call_sym(s, "__fn_" + asmcore.sanitize_label(ins.str));
  }
  if (argc > 0) {
    s = ssa_alu_ir(s, 0, 64, (argc * 8) as i64, "%rsp");
  }
  return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// ssa_reg_call_emit calls a function through its register entry. Only this
// call's own arguments can be in the pool's registers here: anything live
// across it is callee-saved or in a slot.
function ssa_reg_call_emit(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  let a: i32 = 0;
  while (a < ins.args.len()) {
    srcs = srcs.append(reg_of[ins.args[a]]);
    dsts = dsts.append(a);
    a = a + 1;
  }
  s = ssa_parallel_moves(srcs, dsts, s);
  return ssa_call_sym(s, "__fn_" + asmcore.sanitize_label(ins.str) + ".r");
}

// Shared and static releases finish before allocating a frame. Keeping the
// guard at the helper entry avoids repeating it at every call site; unique
// and zero counts continue through the existing destructor/underflow path.
function ssa_release_entry(entry: ssaprepare.ReleaseEntry, lp: string, s: asmcore.EmitState): asmcore.EmitState {
  if (!entry.counted) {
    return s;
  }
  let dn: asmcore.LabNew = asmcore.lab_new(s, lp + "release_dec");
  let kn: asmcore.LabNew = asmcore.lab_new(dn.state, lp + "release_kept");
  let sn: asmcore.LabNew = asmcore.lab_new(kn.state, lp + "release_slow");
  s = sn.state;
  s = ssa_branch(ssa_cmp_floor(s, "%rax"), J_JB, kn.lab);
  s = ssa_branch(ssa_alu_im(s, 7, 32, 1, "%rax", 0 - 8), J_JG, dn.lab);
  s = ssa_branch(ssa_alu_im(s, 7, 32, 0, "%rax", 0 - 8), J_JNS, sn.lab);
  s = ssa_ret(ssa_zero(s.lab_def(kn.lab), "%rax"));
  s = ssa_ret(ssa_zero(ssa_alu_im(s.lab_def(dn.lab), 5, 32, 1, "%rax", 0 - 8), "%rax"));
  s = s.lab_def(sn.lab);
  // A named type's sole owner runs its drop and frees the box with the box
  // held on the stack, which also aligns both calls; a count of zero takes
  // the body, whose helper reports the underflow.
  let drop: string = entry.unique_drop;
  if (drop == "") {
    return s;
  }
  let bn: asmcore.LabNew = asmcore.lab_new(s, lp + "release_body");
  s = helper_call_needs("__fern_rc_dec", bn.state);
  s = ssa_branch(ssa_alu_im(s, 7, 32, 1, "%rax", 0 - 8), J_JNE, bn.lab);
  s = ssa_call_sym(ssa_push_r(s, "%rax"), "__fn_" + asmcore.sanitize_label(drop) + ".r");
  s = ssa_call_sym(ssa_mov_rm0(s, 64, true, "%rax", "%rsp"), ircore.ir_helper_symbol("__fern_rc_dec") + ".r");
  s = ssa_ret(ssa_zero(ssa_pop_r(s, "%rax"), "%rax"));
  return s.lab_def(bn.lab);
}

// ssa_mem_inst selects the production lift's memory kinds (ssa.fern 40..44)
// with the instructions the stack machine's own arms use, operands in
// %rax/%rcx/%rdx.
function ssa_mem_inst(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let k: i32 = ins.kind_tag;
  let a: string = ssa_src(reg_of, ins.args[0], "%r11");
  s = ssa_load(reg_of, ins.args[0], a, s);
  let d: string = ssa_dst(reg_of, ins.result);
  if (k == 40) {
    s = ssa_mov_rm(s, 64, true, d, a, ins.imm);
    return ssa_store(reg_of, ins.result, d, s);
  }
  let b: string = ssa_src(reg_of, ins.args[1], "%rcx");
  s = ssa_load(reg_of, ins.args[1], b, s);
  if (k == 41 && ins.str == "i32") {
    return ssa_mov_rm0(s, 32, false, b, a);
  }
  if (k == 41 && ins.str == "u8") {
    return ssa_mov_rm(s, 8, false, b, a, ins.imm);
  }
  if (k == 41) {
    return ssa_mov_rm(s, 64, false, b, a, ins.imm);
  }
  if (k == 42) {
    s = s.need("heap");
    if (ins.imm != 1) {
      s = ssa_jump_sym(ssa_alu_rm0(s, 7, 64, true, b, a), "jae", "__fern_oob_abort");
    }
    if (ins.str == "u8") {
      s = ssa_movzb_mi(s, 0, d, a, b, 8);
    } else {
      s = ssa_mov_rmi(s, 64, true, d, a, b, 8, 8);
    }
    return ssa_store(reg_of, ins.result, d, s);
  }
  if (k == 44) {
    s = s.need("heap");
    if (ins.imm != 1) {
      s = ssa_jump_sym(ssa_alu_rm(s, 7, 64, true, b, a, 8), "jae", "__fern_oob_abort");
    }
    s = ssa_movzb_mi(ssa_mov_rm0(s, 64, true, "%rdx", a), 0, d, "%rdx", b, 0);
    return ssa_store(reg_of, ins.result, d, s);
  }
  let c: string = ssa_src(reg_of, ins.args[2], "%rdx");
  s = ssa_load(reg_of, ins.args[2], c, s);
  s = s.need("heap");
  if (ins.imm != 1) {
    s = ssa_jump_sym(ssa_alu_rm0(s, 7, 64, true, b, a), "jae", "__fern_oob_abort");
  }
  if (ins.str == "u8") {
    return ssa_mov_rmi(s, 8, false, c, a, b, 1, 8);
  }
  return ssa_mov_rmi(s, 64, false, c, a, b, 8, 8);
}

// ssa_str_call is the stack machine's call of a Fern-compiled runtime helper
// for a string or slice op: arguments pushed with the first on top, the
// helper's need marked as the flat arm marks it.
function ssa_str_call(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  s = ssa_str_marks(ins.str, s);
  let argc: i32 = ins.args.len();
  let i: i32 = argc - 1;
  while (i >= 0) {
    s = ssa_push_operand(reg_of, ins.args[i], s);
    i = i - 1;
  }
  s = ssa_call_sym(s, "__fn___fern_" + ssa_str_target(ins.str));
  if (argc > 0) {
    s = ssa_alu_ir(s, 0, 64, (argc * 8) as i64, "%rsp");
  }
  return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// ssa_str_eq answers unequal lengths inline, the answer to almost every
// comparison a compiler makes, and calls the helper's register entry only for
// equal ones.
// The lengths are compared inline, and against a literal operand so is the
// first byte: a chain of same-length literals (a mnemonic table, a keyword
// list) then rejects most arms without the call.
function ssa_str_eq(ins: ssa.SInst, reg_of: i32[], lp: string, fr: SsaFrame, s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  s = s.mark_str_eq();
  s = ssa_read(reg_of, ins.args[0], "%r11", s);
  let a: string = ssa_src(reg_of, ins.args[0], "%r11");
  s = ssa_read(reg_of, ins.args[1], "%rcx", s);
  let b: string = ssa_src(reg_of, ins.args[1], "%rcx");
  let n: string = util.i32_to_string(ins.result);
  let nn: asmcore.LabNew = asmcore.lab_new(s, lp + "streqn" + n);
  let dn: asmcore.LabNew = asmcore.lab_new(nn.state, lp + "streqd" + n);
  s = dn.state;
  s = ssa_branch(ssa_alu_rm(ssa_mov_rm(s, 64, true, "%rdx", a, 8), 7, 64, true, "%rdx", b, 8), J_JNE, nn.lab);
  let lit_a: i32 = fr.lit0[ins.args[0]];
  let lit_b: i32 = fr.lit0[ins.args[1]];
  if (lit_b >= 0) {
    s = ssa_branch(ssa_alu_im0(ssa_mov_rm0(s, 64, true, "%rdx", a), 7, 8, lit_b, "%rdx"), J_JNE, nn.lab);
  } else if (lit_a >= 0) {
    s = ssa_branch(ssa_alu_im0(ssa_mov_rm0(s, 64, true, "%rdx", b), 7, 8, lit_a, "%rdx"), J_JNE, nn.lab);
  }
  // Equality is symmetric, so the operands may land in %rax and %rsi either
  // way round: whichever is already in one stays, and nothing is overwritten
  // before it is read.
  let x: string = a;
  let y: string = b;
  if (y == "%rax" || x == "%rsi") {
    x = b;
    y = a;
  }
  if (x != "%rax") {
    s = ssa_mov_rr(s, "%rax", x);
  }
  if (y != "%rsi") {
    s = ssa_mov_rr(s, "%rsi", y);
  }
  s = ssa_branch(ssa_call_sym(s, "__fn___fern_str_eq.r"), J_JMP, dn.lab);
  s = ssa_zero(s.lab_def(nn.lab), "%rax").lab_def(dn.lab);
  return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

function ssa_str_target(op: string): string {
  if (op == "str_from_bytes") {
    return "string_from_bytes";
  }
  if (op == "str_from_bytes_u8") {
    return "string_from_bytes_u8";
  }
  if (op == "str_from_bytes_range_u8") {
    return "string_from_bytes_range_u8";
  }
  if (op == "read_chunk") {
    return "reader_read_chunk";
  }
  if (op == "write_bytes") {
    return "writer_write_bytes";
  }
  if (op == "write_bytes_u8") {
    return "writer_write_bytes_u8";
  }
  if (op == "write_some_bytes") {
    return "writer_write_some_bytes";
  }
  if (op == "write_some_bytes_u8") {
    return "writer_write_some_bytes_u8";
  }
  if (op == "read_chunk_bytes") {
    return "reader_read_chunk_bytes";
  }
  if (op == "read_chunk_bytes_u8") {
    return "reader_read_chunk_bytes_u8";
  }
  return op;
}

// ssa_host_need is the need a host helper on the stack ABI carries besides
// the heap, "" for an op that is not one; the three that need no heap are
// named by ssa_host_bare.
function ssa_host_need(op: string): string {
  if (op == "read_chunk_bytes" || op == "read_chunk_bytes_u8" || op == "write_bytes" || op == "write_bytes_u8" || op == "write_some_bytes" || op == "write_some_bytes_u8") {
    return op;
  }
  let fs: string[] = [
    "read_file", "read_file_bytes", "read_file_bytes_u8", "write_file", "write_file_bytes", "write_file_bytes_u8", "write_file_exec", "remove_dir_all", "remove_file",
    "create_dir_all", "read_dir", "read_dir_all", "read_dir_ino", "env", "stat", "lstat", "subprocess", "writer_write",
  ];
  for x in fs {
    if (x == op) {
      return op;
    }
  }
  if (op == "read_line") {
    return "str_read_line";
  }
  if (op == "read_chunk" || op == "reader_close") {
    return "reader";
  }
  return "";
}

function ssa_host_bare(op: string): boolean {
  return op == "putchar" || op == "monotonic_ns" || op == "now_unix_ms";
}

function ssa_str_marks(op: string, s: asmcore.EmitState): asmcore.EmitState {
  if (op == "temp_dir") {
    return s.need("heap").need("monotonic_ns").need("temp_dir");
  }
  if (ssa_host_need(op) != "") {
    return s.need("heap").need(ssa_host_need(op));
  }
  if (ssa_host_bare(op)) {
    return s.need(op);
  }
  if (op == "str_concat") {
    return s.mark_str_concat();
  }
  if (op == "str_eq") {
    return s.mark_str_eq();
  }
  if (op == "str_cmp") {
    return s.mark_str_cmp();
  }
  if (op == "arr_slice") {
    return s.mark_arr_slice();
  }
  if (op == "arr_slice_u8") {
    return s.need("heap").need("arr_slice_u8");
  }
  if (op == "str_from_bytes_u8") {
    return s.need("heap").need("str_from_bytes_u8");
  }
  if (op == "str_from_bytes_range_u8") {
    return s.need("heap").need("str_from_bytes_range_u8");
  }
  if (op == "print_str") {
    return s.need("str_print");
  }
  if (op == "eprint_str") {
    return s.need("eprint");
  }
  s = s.need("heap");
  return s.need("str_from_bytes");
}

// ssa_host_kind names the register-ABI ops ssa_host_call selects: the raw
// syscalls, exit, the string box stamp and the string builder.
function ssa_host_kind(op: string): boolean {
  return util.str_has_prefix(op, "syscall") || op == "exit" || op == "raw_string" || util.str_has_prefix(op, "strbuf_");
}

// ssa_host_call emits the host-floor ops as the stack machine's arms do. A
// syscall pushes its operands and then runs the flat arm's pop sequence, so
// no allocatable register is written before every operand has been read; its
// number is recorded for the sandbox when `imm` knows it as a constant.
function ssa_host_call(ins: ssa.SInst, reg_of: i32[], imm: ssa.Imms, s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  if (util.str_has_prefix(ins.str, "syscall")) {
    let i: i32 = 0;
    while (i < ins.args.len()) {
      s = ssa_push_operand(reg_of, ins.args[i], s);
      i = i + 1;
    }
    let regs: string[] = ["%rdi", "%rsi", "%rdx", "%r10", "%r8", "%r9"];
    let a: i32 = ins.args.len() - 2;
    while (a >= 0) {
      s = ssa_pop_r(s, regs[a]);
      a = a - 1;
    }
    s = ssa_pop_r(s, "%rax");
    let nr: i32 = ins.args[0];
    if (imm.konst[nr]) {
      s = s.syscall(imm.value[nr] as i32);
    } else {
      s = s.raw_syscall("__" + ins.str);
    }
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
  }
  if (ins.str == "exit") {
    s = ssa_load(reg_of, ins.args[0], "%r11", s);
    if (s.leak_check) {
      s = s.write("    pushq %r11\n    call __fern_lc_report\n    popq %r11\n");
    }
    s = s.write("    movq %r11, %rdi\n    movq $60, %rax\n").syscall(60).write("    xorl %eax, %eax\n");
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
  }
  s = s.need("heap");
  if (ins.str == "raw_string") {
    s = ssa_load(reg_of, ins.args[0], "%r11", s);
    s = ssa_load(reg_of, ins.args[1], "%rcx", s);
    s = s.write("    movq %r11, %rdi\n    movq %rcx, %rsi\n    call __fern_str_box_hdr\n");
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
  }
  s = s.need("strbuf");
  if (ins.args.len() > 0) {
    s = ssa_load(reg_of, ins.args[0], "%r11", s);
    s = s.write("    movq %r11, %rdi\n");
  }
  s = ssa_call_sym(s, "__fern_" + ins.str);
  return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

function ir_memcpy_asm(): string {
  return "    popq %rcx\n    popq %rsi\n    popq %rdi\n    rep movsb\n    pushq $0\n";
}

function ir_memset_asm(): string {
  return "    popq %rcx\n    popq %rax\n    popq %rdi\n    cld\n    rep stosb\n    pushq $0\n";
}

// ssa_dyn_dispatch runs the dyn dispatch chain on the register path, each
// argument read from its home. %rax is the chain's own scratch, so a value
// living there moves to %r11 first; the allocator counts the instruction
// as a call, so nothing live across it is in a caller-saved register.
function ssa_dyn_dispatch(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  let args: asmcore.DynArg[] = [];
  let moved: boolean = false;
  for v in ins.args {
    if (reg_of[v] >= 0) {
      let home: string = ssa_reg(reg_of[v]);
      if (home == "%rax") {
        if (!moved) {
          s = s.write("    movq %rax, %r11\n");
          moved = true;
        }
        home = "%r11";
      }
      args = args.append(asmcore.DynArg { reg: home, off: 0 });
    } else {
      args = args.append(asmcore.DynArg { reg: "", off: 0 - 8 * (ssa.spill_slot(reg_of[v]) + 1) - s.ssa_save });
    }
  }
  s = emit_dyn_dispatch_chain(ins.str, args, ins.imm, lp, s);
  return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// ssa_flat_op runs the stack machine's own arm for the op at index `ins.imm`
// between a push of the operands and a pop of the result. The allocator
// treats the op as a call, so the registers the arm writes hold nothing live;
// its labels take the op's index under the SSA function's prefix.
function ssa_flat_op(ins: ssa.SInst, reg_of: i32[], lp: string, r: irtables.LowerResult, s: asmcore.EmitState): asmcore.EmitState {
  if (asmcore.buf_helper(r.ops[ins.imm].kind_tag) != "") {
    return ssa_buf_call(ins, reg_of, asmcore.buf_table_helper(r.ops[ins.imm].kind_tag, ir.is_packed(r.ops[ins.imm])), s);
  }
  s = ssa_x0_forget(s);
  let outer: usize = s.capture;
  let h: usize = buf_new(256);
  s = emit_stack_op(r.ops[ins.imm], ins.imm, lp, r, asmcore.EmitState { ...s, capture: h });
  let arm: string = buf_take(h);
  buf_free(h);
  s = asmcore.EmitState { ...s, capture: outer };
  let pops: string[] = ssa_leading_pops(arm, ins.args.len());
  let moves: SsaArgMoves = ssa_arg_moves(ins, reg_of, pops, s);
  if (!moves.ok) {
    pops = [];
    moves = ssa_arg_moves(ins, reg_of, pops, s);
  }
  let i: i32 = 0;
  while (i < ins.args.len() - pops.len()) {
    s = ssa_push_operand(reg_of, ins.args[i], s);
    i = i + 1;
  }
  for m in moves.text {
    s = s.write(m);
  }
  let body: string = slice_unchecked(arm, ssa_pops_len(pops), arm.len()) + "";
  let result: string = ssa_trailing_push(body);
  if (result != "") {
    s = s.write(slice_unchecked(body, 0, body.len() - ssa_push_line(result).len()) + "");
    return ssa_store(reg_of, ins.result, result, ssa_x0_forget(s));
  }
  s = s.write(body + "    popq %rax\n");
  return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// An arm starts by popping its operands, the last operand first. The register
// path loads those operands into the registers the pops name instead, and
// runs the rest of the arm; operands the arm does not pop that way are pushed
// as before, beneath where the pops would have read.
function ssa_pop_line(reg: string): string {
  return "    popq " + reg + "\n";
}

function ssa_push_line(reg: string): string {
  return "    pushq " + reg + "\n";
}

function ssa_pops_len(pops: string[]): i32 {
  let n: i32 = 0;
  for p in pops {
    n = n + ssa_pop_line(p).len();
  }
  return n;
}

// ssa_leading_pops lists the registers the arm's first lines pop into, at
// most `limit` of them.
function ssa_leading_pops(arm: string, limit: i32): string[] {
  let out: string[] = [];
  let at: i32 = 0;
  while (out.len() < limit) {
    let reg: string = ssa_line_reg(arm, at, "    popq %");
    if (reg == "") {
      return out;
    }
    out = out.append(reg);
    at = at + ssa_pop_line(reg).len();
  }
  return out;
}

// ssa_trailing_push is the register a body's last line pushes, "" when its
// last line is anything else.
function ssa_trailing_push(body: string): string {
  let at: i32 = body.len() - 1;
  if (at < 0 || body[at] != 10) {
    return "";
  }
  at = at - 1;
  while (at >= 0 && body[at] != 10) {
    at = at - 1;
  }
  let reg: string = ssa_line_reg(body, at + 1, "    pushq %");
  if (reg == "" || at + 1 + ssa_push_line(reg).len() != body.len()) {
    return "";
  }
  return reg;
}

// ssa_line_reg reads `%reg` from a line at `at` that is `prefix` then one
// register name and a newline, or "".
function ssa_line_reg(text: string, at: i32, prefix: string): string {
  if (at + prefix.len() > text.len()) {
    return "";
  }
  if (slice_unchecked(text, at, at + prefix.len()) != prefix) {
    return "";
  }
  let end: i32 = at + prefix.len();
  while (end < text.len() && text[end] != 10) {
    let c: i32 = text[end] as i32;
    if (!(c >= 97 && c <= 122 || c >= 48 && c <= 57)) {
      return "";
    }
    end = end + 1;
  }
  if (end >= text.len() || end == at + prefix.len()) {
    return "";
  }
  return slice_unchecked(text, at + prefix.len() - 1, end) + "";
}

struct SsaArgMoves { ok: boolean, text: string[] }

// ssa_arg_moves loads the popped operands into their registers as one
// parallel move: a load goes once no pending load still reads its register.
// A cycle is refused, and the arm then takes every operand from the stack.
function ssa_arg_moves(ins: ssa.SInst, reg_of: i32[], pops: string[], s: asmcore.EmitState): SsaArgMoves {
  let srcs: string[] = [];
  let dsts: string[] = [];
  let k: i32 = 0;
  while (k < pops.len()) {
    let v: i32 = ins.args[ins.args.len() - 1 - k];
    let src: string = ssa_home_name(reg_of, v);
    if (src == "") {
      src = ssa_slot(ssa.spill_slot(reg_of[v]), s.ssa_save);
    }
    if (src != pops[k]) {
      srcs = srcs.append(src);
      dsts = dsts.append(pops[k]);
    }
    k = k + 1;
  }
  let done: boolean[] = __alloc_bool(dsts.len());
  let out: string[] = [];
  let left: i32 = dsts.len();
  while (left > 0) {
    let progressed: boolean = false;
    let i: i32 = 0;
    while (i < dsts.len()) {
      if (!done[i] && !ssa_still_read(srcs, done, dsts[i], i)) {
        out = out.append("    movq " + srcs[i] + ", " + dsts[i] + "\n");
        done = done.with(i, true);
        left = left - 1;
        progressed = true;
      }
      i = i + 1;
    }
    if (!progressed) {
      return SsaArgMoves { ok: false, text: [] };
    }
  }
  return SsaArgMoves { ok: true, text: out };
}

function ssa_still_read(srcs: string[], done: boolean[], reg: string, self: i32): boolean {
  let j: i32 = 0;
  while (j < srcs.len()) {
    if (j != self && !done[j] && srcs[j] == reg) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

function ssa_arg_regs(): string[] {
  return ["%rdi", "%rsi", "%rdx", "%rcx"];
}

// ssa_buf_call calls a builder helper with its operands loaded straight into
// the argument registers. %rdx and %rcx are never a home, so they load first;
// the %rdi / %rsi pair then goes in whichever order reads each source before
// it is written, or swaps.
function ssa_buf_call(ins: ssa.SInst, reg_of: i32[], sym: string, s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  let i: i32 = 2;
  while (i < ins.args.len()) {
    s = ssa_load(reg_of, ins.args[i], ssa_arg_regs()[i], s);
    i = i + 1;
  }
  if (ins.args.len() == 1) {
    s = ssa_load(reg_of, ins.args[0], "%rdi", s);
  }
  if (ins.args.len() >= 2) {
    let h0: string = ssa_home_name(reg_of, ins.args[0]);
    let h1: string = ssa_home_name(reg_of, ins.args[1]);
    if (h0 == "%rsi" && h1 == "%rdi") {
      s = s.write("    xchgq %rdi, %rsi\n");
    } else if (h1 == "%rdi") {
      s = ssa_load(reg_of, ins.args[1], "%rsi", s);
      s = ssa_load(reg_of, ins.args[0], "%rdi", s);
    } else {
      s = ssa_load(reg_of, ins.args[0], "%rdi", s);
      s = ssa_load(reg_of, ins.args[1], "%rsi", s);
    }
  }
  s = ssa_call_sym(s, sym);
  s = s.need("heap");
  s = s.need("buf");
  if (sym == "__fern_buf_take") {
    s = s.need("buf_text");
  } else if (sym == "__fern_buf_take_bytes") {
    s = s.need("buf_take_bytes");
  } else if (sym == "__fern_buf_take_bytes_u8") {
    s = s.need("buf_take_bytes_u8");
  } else if (sym == "__fern_buf_push_bytes_range") {
    s = s.need("buf_push_bytes_range");
  } else if (sym == "__fern_buf_push_bytes_range_u8") {
    s = s.need("buf_push_bytes_range_u8");
  } else if (util.str_has_prefix(sym, "__fern_buf_push_bytes_")) {
    if (util.str_has_suffix(sym, "_u8")) {
      s = s.need("buf_bytes_u8");
    } else {
      s = s.need("buf_bytes");
    }
  } else if (util.str_has_suffix(sym, "_u8")) {
    s = s.need("buf_u8");
  }
  return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// ssa_home_name is a value's register, or "" for a frame slot.
function ssa_home_name(reg_of: i32[], v: i32): string {
  if (reg_of[v] < 0) {
    return "";
  }
  return ssa_reg(reg_of[v]);
}

// The need whose gate defines a floor symbol, so an address taken outside the
// helpers that already mark it still links.
function sym_addr_need(sym: string): string {
  if (sym == "__fern_scratch") {
    return "raw_scratch";
  }
  if (sym == "__fern_envp") {
    return "raw_environ";
  }
  if (sym == "__fern_splice_pipe") {
    return "raw_splice_pipe";
  }
  if (sym == "__fern_cov_counters") {
    return "raw_cover";
  }
  if (sym == "__fern_task_state") {
    return "task";
  }
  return "";
}

// ssa_sym_addr is a static symbol's address, or the word at it (imm 1).
function ssa_sym_addr(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  if (util.str_has_prefix(ins.str, "__fern_arr_push_")) {
    s = s.need("heap");
  }
  if (sym_addr_need(ins.str) != "") {
    s = s.need(sym_addr_need(ins.str));
  }
  let d: string = ssa_dst(reg_of, ins.result);
  if (ins.imm == 1) {
    s = s.write("    movq " + ins.str + "(%rip), " + d + "\n");
  } else {
    s = ssa_lea_sym(s, ins.str, d);
  }
  return ssa_store(reg_of, ins.result, d, s);
}

// ssa_rt_call is the stack machine's call of a runtime routine on the register
// ABI: the arguments in %rdi, %rsi, the result in %rax.
function ssa_rt_call(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  s = s.need("heap");
  let sym: string = "__fern_alloc";
  if (ins.str == "alloc_u8") {
    s = s.need("alloc_u8");
    sym = "__fern_alloc_u8";
  } else if (ins.str == "alloc_u8_u8") {
    s = s.need("alloc_bytes");
    sym = "__fern_alloc_bytes";
  } else if (ins.str == "arr_push_owned_u8") {
    s = s.mark_arr_push().need("arr_push_u8");
    sym = "__fern_arr_push_owned_u8";
  } else if (ins.str == "arr_push_u8") {
    s = s.mark_arr_push().need("arr_push_u8");
    sym = "__fern_arr_push_u8";
  } else if (ins.str == "struct_copy") {
    sym = "__fn___fern_struct_copy";
  } else if (ins.str == "raw_arr_box") {
    sym = "__fern_arr_box";
  } else if (ins.str == "args") {
    s = s.need("args");
    sym = "__fern_args";
  } else if (ins.str == "map_hash_seed") {
    s = s.need("random_i32").need("map_hash_seed");
    sym = "__fern_map_hash_seed";
  } else if (util.str_has_prefix(ins.str, "arr_push_owned")) {
    s = s.mark_arr_push();
    s = s.need("arr_push_owned");
    sym = "__fern_arr_push_owned";
  } else if (util.str_has_prefix(ins.str, "arr_push")) {
    s = s.mark_arr_push();
    sym = "__fern_arr_push";
  }
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  let a: i32 = 0;
  while (a < ins.args.len() && a < 2) {
    srcs = srcs.append(reg_of[ins.args[a]]);
    dsts = dsts.append(ssa_rt_arg_reg(a));
    a = a + 1;
  }
  s = ssa_parallel_moves(srcs, dsts, s);
  // raw_alloc asks for 24 bytes more and hands back the pointer past them,
  // the string box header a buffer may later grow (#7351).
  if (ins.str == "raw_alloc") {
    s = s.write("    testl %edi, %edi\n    js __fern_alloc_size_abort\n");
    s = s.write("    addq $24, %rdi\n");
  }
  if (ins.str == "alloc" && s.leak_check && s.rt_owned_allocs) {
    s = s.write("    movq %rdi, __fern_lc_rt_req(%rip)\n");
  }
  if (util.str_has_suffix(ins.str, "_u8") && util.str_has_prefix(ins.str, "arr_push") && ins.result >= 0 && !s.rc_free_debug) {
    s = arr_push_inline_u8(sym, lp + "apush" + util.i32_to_string(ins.result), ins.imm == 1, s);
  } else if (util.str_has_prefix(ins.str, "arr_push") && ins.result >= 0 && !s.rc_free_debug) {
    s = arr_push_inline(sym, lp + "apush" + util.i32_to_string(ins.result), ins.imm == 1, s);
  } else {
    s = ssa_call_sym(s, sym);
  }
  if (ins.str == "raw_alloc") {
    s = s.write("    addq $24, %rax\n");
  }
  if (ins.str == "alloc" && s.leak_check && s.rt_owned_allocs) {
    // A runtime-owned block (#11386): take the one the hook just counted
    // back out, at the allocator's 8-byte rounding of the request.
    s = lc_rt_uncount(s, "__fern_lc_alloc_bytes", "__fern_lc_alloc_count");
  }
  return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// lc_rt_uncount takes one block of the size __fern_lc_rt_req holds, at the
// allocator's 8-byte rounding, back out of the census counters `bytes` and
// `count`. Clobbers %rcx.
function lc_rt_uncount(s: asmcore.EmitState, bytes: string, count: string): asmcore.EmitState {
  s = s.write("    movq __fern_lc_rt_req(%rip), %rcx\n");
  s = s.write("    addq $7, %rcx\n");
  s = s.write("    shrq $3, %rcx\n");
  s = s.write("    shlq $3, %rcx\n");
  s = s.write("    subq %rcx, " + bytes + "(%rip)\n");
  s = s.write("    subq $1, " + count + "(%rip)\n");
  return s;
}

// arr_push_inline is arr_push_fast at the call site, calling `sym` only when
// the receiver has no free slot or is shared.
// `unique` drops the count test: the receiver was just tested unique.
function arr_push_inline(sym: string, l: string, unique: boolean, s: asmcore.EmitState): asmcore.EmitState {
  let ls: ArrPushLabs = arr_push_labs(l, s);
  s = ssa_mov_rm0(ls.state, 64, true, "%rdx", "%rdi");
  s = ssa_branch(ssa_alu_rm(s, 7, 64, true, "%rdx", "%rdi", 0 - 16), J_JGE, ls.slow);
  return arr_push_tail(sym, false, ls, unique, s);
}

// arr_push_inline_u8 is arr_push_inline for a packed byte array: its
// capacity is in 8-byte words, so the room test is against cap * 8.
function arr_push_inline_u8(sym: string, l: string, unique: boolean, s: asmcore.EmitState): asmcore.EmitState {
  let ls: ArrPushLabs = arr_push_labs(l, s);
  s = ssa_mov_rm0(ls.state, 64, true, "%rdx", "%rdi");
  s = ssa_mov_rm(s, 64, true, "%rcx", "%rdi", 0 - 16).write("    shlq $3, %rcx\n");
  s = ssa_branch(ssa_alu_rr(s, 7, 64, "%rcx", "%rdx"), J_JGE, ls.slow);
  return arr_push_tail(sym, true, ls, unique, s);
}

// ArrPushLabs is an inline push's three labels: the store (`o`), the call of
// the helper (`s`) and the join after both (`e`).
struct ArrPushLabs { state: asmcore.EmitState, store: asmcore.Lab, slow: asmcore.Lab, end: asmcore.Lab }

function arr_push_labs(l: string, s: asmcore.EmitState): ArrPushLabs {
  let on: asmcore.LabNew = asmcore.lab_new(s, l + "o");
  let sn: asmcore.LabNew = asmcore.lab_new(on.state, l + "s");
  let en: asmcore.LabNew = asmcore.lab_new(sn.state, l + "e");
  return ArrPushLabs { state: en.state, store: on.lab, slow: sn.lab, end: en.lab };
}

// arr_push_tail is the inline push after its room test: the count test, the
// store of the element (a byte for a packed array), the bump of the length,
// and the call of `sym` on the slow path.
function arr_push_tail(sym: string, packed: boolean, ls: ArrPushLabs, unique: boolean, s: asmcore.EmitState): asmcore.EmitState {
  s = push_count_test(unique, ls, s).lab_def(ls.store);
  if (packed) {
    s = ssa_mov_rmi(s, 8, false, "%rsi", "%rdi", "%rdx", 1, 8);
  } else {
    s = ssa_mov_rmi(s, 64, false, "%rsi", "%rdi", "%rdx", 8, 8);
  }
  s = ssa_mov_rm0(ssa_inc(s, "%rdx"), 64, false, "%rdx", "%rdi");
  s = ssa_branch(ssa_mov_rr(s, "%rax", "%rdi"), J_JMP, ls.end);
  return ssa_call_sym(s.lab_def(ls.slow), sym).lab_def(ls.end);
}

// push_count_test sends a shared receiver (count above 1, not immortal) to the
// slow path; a receiver already tested unique needs no test.
function push_count_test(unique: boolean, ls: ArrPushLabs, s: asmcore.EmitState): asmcore.EmitState {
  if (unique) {
    return s;
  }
  s = ssa_branch(ssa_alu_ir(ssa_mov_rm(s, 32, true, "%rcx", "%rdi", 0 - 8), 7, 32, 1i64, "%rcx"), J_JE, ls.store);
  return ssa_branch(ssa_test_rr(s, 32, "%rcx", "%rcx"), J_JNS, ls.slow);
}

// ssa_is_rt_call is a kind-50 call that ssa_rt_call emits: neither a
// transcendental nor a host call, which stage their own arguments.
function ssa_is_rt_call(ins: ssa.SInst): boolean {
  return ins.kind_tag == 50 && ssa_fcall_sym(ins.str) == "" && !ssa_host_kind(ins.str);
}

// ssa_rt_arg_reg is the allocator index of argument `a`'s register.
function ssa_rt_arg_reg(a: i32): i32 {
  if (a == 0) {
    return 2;
  }
  return 1;
}

// ssa_view_slots gives each frame-resident string view (kind 51, imm 1) the
// index of its three frame words, in instruction order, and -1 to every other
// value; ssa_view_count is how many there are. The words sit after the spill
// slots.
function ssa_view_slots(f: ssa.SFunc): i32[] {
  let out: i32[] = util.minus_ones(f.nvals);
  let n: i32 = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 51 && ins.imm == 1) {
        out = out.with(ins.result, n);
        n = n + 1;
      }
    }
  }
  return out;
}

function ssa_view_count(views: i32[]): i32 {
  let n: i32 = 0;
  for v in views {
    if (v >= 0) {
      n = n + 1;
    }
  }
  return n;
}

// ssa_str_view is the string slice kernel of emit_ir_str_op with register
// operands: the two bounds checks, then the {header, data + lo, hi - lo} box
// either immortal in this frame or counted with borrowed data on the heap. The operands
// are read before the allocation and carried across it on the machine stack,
// since the call clobbers every register they could live in.
function ssa_str_view(ins: ssa.SInst, reg_of: i32[], base_off: i32, s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  s = s.need("heap");
  s = ssa_load(reg_of, ins.args[0], "%rdx", s);
  s = ssa_load(reg_of, ins.args[1], "%rcx", s);
  s = ssa_load(reg_of, ins.args[2], "%rax", s);
  s = s.write("    cmpq 8(%rdx), %rax\n    ja __fern_str_oob_abort\n    cmpq %rax, %rcx\n    ja __fern_str_oob_abort\n");
  s = s.write("    subq %rcx, %rax\n    addq (%rdx), %rcx\n");
  if (ins.imm == 1) {
    s = s.write("    leaq " + util.i32_to_string(base_off) + "(%rbp), %rdx\n");
    s = s.write("    movq $-1, (%rdx)\n");
  } else {
    s = s.write("    pushq %rcx\n    pushq %rax\n    movq $24, %rdi\n    call __fern_alloc\n    movq %rax, %rdx\n    popq %rax\n    popq %rcx\n");
    s = s.write("    movl $1, (%rdx)\n");
    s = s.write("    movl $" + util.i32_to_string(borrowed_marker()) + ", 4(%rdx)\n");
  }
  s = s.write("    movq %rcx, 8(%rdx)\n    movq %rax, 16(%rdx)\n    addq $8, %rdx\n");
  // The result leaves in %rdx, so the store does not re-assert what %rax
  // holds, and the bound loaded into it above has been overwritten.
  return ssa_store(reg_of, ins.result, "%rdx", ssa_x0_forget(s));
}

// SsaFrame is the frame below the values: three words per frame-resident
// string view after the values. ssa_view_off is the offset of a view's lowest
// word, the base the view kernel writes at.
struct SsaFrame { nspill: i32, views: i32[], blk_pos: i32[], uses: i32[], nsave: i32, saved: i32[], leaf: boolean, epilogue: string, imm: ssa.Imms, lit0: i32[], lbase: i32 }

// SsaFuse is a block's compare consumed as flags by its branch: `n` trailing
// instructions (the compare, and the `not` between it and the branch when
// `inverted`) are not materialised; the branch tests the condition of
// compare `tag` on operands `a` and `b` instead. A `not` of a plain boolean
// fuses too: `tag` is 0, the branch tests `a` for zero and takes the true
// edge when it is. An inline uniqueness test of `a` fuses as `unique`: its
// guards leave the flags an equality compare would. n is 0 when the block
// ends some other way.
struct SsaFuse { n: i32, tag: i32, inverted: boolean, a: i32, b: i32, unique: boolean, aligned: boolean }

function ssa_no_fuse(): SsaFuse {
  return SsaFuse { n: 0, tag: 0, inverted: false, a: 0, b: 0, unique: false, aligned: false };
}

function ssa_retain_fusion(rows: ssaprepare.Fusion[], fu: SsaFuse, retain: boolean): ssaprepare.Fusion[] {
  if (!retain) {
    return rows;
  }
  return rows.append(ssaprepare.Fusion { n: fu.n, tag: fu.tag, inverted: fu.inverted, a: fu.a, b: fu.b, unique: fu.unique, aligned: fu.aligned });
}

// ssa_fuse finds the compare a block's brif can read as flags: the block's
// last instruction is an integer compare read only by the branch, or a `not`
// read only by the branch whose operand is such a compare read only by it. A
// `not` over anything else is the value test with the edges swapped.
function ssa_fuse(fr: SsaFrame, blk: ssa.SBlock): SsaFuse {
  let t: ssa.STerm = blk.term;
  if (t.kind_tag != 3 || t.t == t.f || blk.insts.len() == 0) {
    return ssa_no_fuse();
  }
  let last: ssa.SInst = blk.insts[blk.insts.len() - 1];
  if (last.result != t.cond || fr.uses[last.result] != 1) {
    return ssa_no_fuse();
  }
  let cmp: ssa.SInst = last;
  let n: i32 = 1;
  let inverted: boolean = false;
  if (last.kind_tag == 10 && last.str == "!") {
    let value_test: SsaFuse = SsaFuse { n: 1, tag: 0, inverted: true, a: last.args[0], b: 0, unique: false, aligned: false };
    if (blk.insts.len() < 2) {
      return value_test;
    }
    cmp = blk.insts[blk.insts.len() - 2];
    if (cmp.result != last.args[0] || fr.uses[cmp.result] != 1) {
      return value_test;
    }
    if (!ssa_unique_test(cmp) && (cmp.kind_tag != 9 || !ircore.is_int_cmp_kind(ir.kind_id(cmp.str)))) {
      return value_test;
    }
    n = 2;
    inverted = true;
  }
  if (ssa_unique_test(cmp)) {
    return SsaFuse { n: n, tag: ir.kind_id("eq"), inverted: inverted, a: cmp.args[0], b: 0, unique: true, aligned: cmp.imm == 4 };
  }
  if (cmp.kind_tag != 9 || !ircore.is_int_cmp_kind(ir.kind_id(cmp.str))) {
    return ssa_no_fuse();
  }
  if (fr.imm.is_imm[cmp.args[0]]) {
    return SsaFuse { n: n, tag: ircore.flip_int_cmp_kind(ir.kind_id(cmp.str)), inverted: inverted, a: cmp.args[1], b: cmp.args[0], unique: false, aligned: false };
  }
  return SsaFuse { n: n, tag: ir.kind_id(cmp.str), inverted: inverted, a: cmp.args[0], b: cmp.args[1], unique: false, aligned: false };
}

// ssa_join is the label a block's fused test joins at; a rotated latch
// re-runs its header's test under its own.
function ssa_join(lp: string, blk: i32): string {
  return lp + "uq" + util.i32_to_string(blk);
}

function ssa_unique_test(ins: ssa.SInst): boolean {
  return ssa.rc_inlined(ins) && ins.str == "__fern_rc_is_unique";
}

function ssa_view_off(fr: SsaFrame, v: i32): i32 {
  let first: i32 = fr.nspill + 3 * fr.views[v];
  return 0 - 8 * (first + 3) - fr.nsave;
}

// ssa_raw_inst selects the raw memory floor (52..55): unchecked 8-byte and
// byte loads and stores at base + idx.
function ssa_raw_inst(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let k: i32 = ins.kind_tag;
  let a: string = ssa_src(reg_of, ins.args[0], "%r11");
  s = ssa_load(reg_of, ins.args[0], a, s);
  let b: string = ssa_src(reg_of, ins.args[1], "%rcx");
  s = ssa_load(reg_of, ins.args[1], b, s);
  let d: string = ssa_dst(reg_of, ins.result);
  if (k == 52) {
    s = s.write("    movq (" + a + "," + b + ",8), " + d + "\n");
    return ssa_store(reg_of, ins.result, d, s);
  }
  if (k == 54) {
    s = s.write("    movzbl (" + a + "," + b + "), " + ssa_r32(d) + "\n");
    return ssa_store(reg_of, ins.result, d, s);
  }
  let c: string = ssa_src(reg_of, ins.args[2], "%rdx");
  s = ssa_load(reg_of, ins.args[2], c, s);
  if (k == 53) {
    return s.write("    movq " + c + ", (" + a + "," + b + ",8)\n");
  }
  return s.write("    movb " + ssa_r8(c) + ", (" + a + "," + b + ")\n");
}

// ssa_call_ind is the stack machine's call through a function value: the
// arguments pushed with the first on top, the target in %r11, which nothing
// live can occupy at a call.
function ssa_call_ind(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  let argc: i32 = ins.args.len() - 1;
  let i: i32 = argc;
  while (i >= 1) {
    s = ssa_push_operand(reg_of, ins.args[i], s);
    i = i - 1;
  }
  s = ssa_load(reg_of, ins.args[0], "%r11", s);
  s = s.write("    call *%r11\n");
  if (argc > 0) {
    s = ssa_alu_ir(s, 0, 64, (argc * 8) as i64, "%rsp");
  }
  return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// ssa_agg_lit is the address of a static record, variant or capture-free
// function-value box the lowering folded whole (ir.const_struct_* /
// ir.const_closure), interned as the flat arm interns it.
function ssa_agg_lit(ins: ssa.SInst, reg_of: i32[], own s: asmcore.EmitState): asmcore.EmitState {
  let pk: asmcore.ConstAggPack = asmcore.const_agg_pack(s, ins.str);
  s = pk.state;
  let kout: asmcore.ConstAggOut = asmcore.add_const_agg(s, pk.text);
  s = kout.state;
  let d: string = ssa_dst(reg_of, ins.result);
  s = ssa_lea_sym(s, asmcore.const_agg_label(s, kout.idx), d);
  return ssa_store(reg_of, ins.result, d, s);
}

// ssa_addr_inst selects the label addresses and the box allocation (45..48).
function ssa_addr_inst(ins: ssa.SInst, reg_of: i32[], own s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  let k: i32 = ins.kind_tag;
  let label: string = "";
  if (k == 45) {
    label = "__fn_" + asmcore.sanitize_label(ins.str);
  } else if (k == 46) {
    let sh: asmcore.ShapeRefOut = asmcore.shape_ref(s, ins.str);
    s = sh.state;
    label = sh.label;
  } else if (k == 47) {
    let lo: asmcore.StringLitOut = asmcore.add_string_lit(s, ins.str);
    s = lo.state;
    label = asmcore.str_box_label(s, lo.idx);
  } else {
    s = s.need("heap");
    s = ssa_call_sym(ssa_mov_ir(s, 64, ins.imm as i64, util.i32_to_string(ins.imm), "%rdi"), "__fern_arr_box");
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
  }
  let d: string = ssa_dst(reg_of, ins.result);
  s = ssa_lea_sym(s, label, d);
  return ssa_store(reg_of, ins.result, d, s);
}

// ssa_line_loc renders a source-position marker (ir.op_line, ssa kind 35) as
// a `.loc` row: the file number the CLI's `.file` table gives the marker's
// module (util.pos_file_index + 1), its line and its column, and
// prologue_end on a function's first, which is where a breakpoint on the
// function belongs. GNU as and the in-process assembler alike turn the rows
// into .debug_line.
function ssa_line_loc(ins: ssa.SInst, s: asmcore.EmitState): asmcore.EmitState {
  let row: string = "    .loc " + util.i32_to_string(util.pos_file_index(ins.imm) + 1) + " " + util.i32_to_string(util.pos_line(ins.imm)) + " " + ins.str;
  if (s.dw_first) {
    row = row + " prologue_end";
    s = asmcore.EmitState { ...s, dw_first: false };
  }
  return s.write(row + "\n");
}

function ssa_inst(ins: ssa.SInst, reg_of: i32[], lp: string, fr: SsaFrame, r: irtables.LowerResult, own s: asmcore.EmitState): asmcore.EmitState {
  let k: i32 = ins.kind_tag;
  if (k == 11) {
    return ssa_call(ins, reg_of, lp, s);
  }
  if (k == 59) {
    return ssa_flat_op(ins, reg_of, lp, r, s);
  }
  if (k == 60) {
    return ssa_dyn_dispatch(ins, reg_of, lp, s);
  }
  if (k == 51) {
    return ssa_str_view(ins, reg_of, ssa_view_off(fr, ins.result), s);
  }
  if (k >= 40 && k <= 44) {
    return ssa_mem_inst(ins, reg_of, s);
  }
  if (k >= 45 && k <= 48) {
    return ssa_addr_inst(ins, reg_of, s);
  }
  if (k == 49 && ins.str == "str_eq") {
    return ssa_str_eq(ins, reg_of, lp, fr, s);
  }
  if (k == 49) {
    return ssa_str_call(ins, reg_of, s);
  }
  if (k == 50 && ssa_fcall_sym(ins.str) != "") {
    return ssa_fcall(ins, reg_of, s);
  }
  if (k == 50 && ssa_host_kind(ins.str)) {
    return ssa_host_call(ins, reg_of, fr.imm, s);
  }
  if (ssa_is_rt_call(ins)) {
    return ssa_rt_call(ins, reg_of, lp, s);
  }
  if (k == 58) {
    return ssa_sym_addr(ins, reg_of, s);
  }
  if (k >= 52 && k <= 55) {
    return ssa_raw_inst(ins, reg_of, s);
  }
  if (k == 56) {
    return ssa_call_ind(ins, reg_of, s);
  }
  if (k == 57) {
    return ssa_agg_lit(ins, reg_of, s);
  }
  if (k == 35) {
    return ssa_line_loc(ins, s);
  }
  if ((k == 1 || k == 3) && fr.imm.is_imm[ins.result]) {
    return s;
  }
  let d: string = ssa_dst(reg_of, ins.result);
  if (k == 1) {
    s = ssa_const_reg(util.i32_to_string(ins.imm), false, d, s);
  } else if (k == 3) {
    s = ssa_const_reg(ins.str, ins.imm == 64, d, s);
  } else if (k == 4) {
    s = s.write("    movabsq $" + ins.str + ", " + d + "\n");
  } else if (k == 7) {
    s = ssa_load(reg_of, ins.args[0], d, s);
  } else if (k == 9 && ssa_direct_bin(ir.kind_id(ins.str))) {
    return ssa_bin_in_place(ins, reg_of, fr, s);
  } else if (k == 9 && ssa_shift_tag(ir.kind_id(ins.str)) && fr.imm.is_imm[ins.args[1]]) {
    return ssa_bin_in_place(ins, reg_of, fr, s);
  } else if (k == 9) {
    // idiv is hardwired to %rdx:%rax, so the guarded divisions work there
    // and the allocator is told they clobber it; everything else works in
    // the register path's own scratch.
    d = ssa_bin_work(ins.str);
    // The right operand goes first: a division works in %rax, which is an
    // allocatable home, so loading the left operand there would overwrite
    // a right operand that lives in it. %rcx is never a home, so the
    // reverse cannot happen. A constant divisor read as an immediate has
    // no home to load; ir_div_const takes its value from the table.
    if (!fr.imm.is_imm[ins.args[1]]) {
      s = ssa_load(reg_of, ins.args[1], "%rcx", s);
    }
    s = ssa_load(reg_of, ins.args[0], d, s);
    s = ssa_binary(ins, fr, lp, d, s);
  } else {
    let src: string = "";
    if (reg_of[ins.args[0]] >= 0 && ssa_reg(reg_of[ins.args[0]]) != d) {
      src = ssa_reg(reg_of[ins.args[0]]);
    }
    let from: string = "";
    if (src != "") {
      from = ssa_unary_from(ins.str, ins.imm == 1, src, d);
    }
    if (s.records() && ssa_sext32(ins.str, ins.imm == 1) && ssa_xreg(d) >= 0 && (src == "" || ssa_xreg(src) >= 0)) {
      if (src == "") {
        s = ssa_load(reg_of, ins.args[0], d, s);
        src = d;
      }
      s = s.bytes(x86_native.x86_rec_movslq_rr(ssa_xreg(d), ssa_xreg(src)));
    } else if (from != "") {
      s = s.write(from);
    } else {
      s = ssa_load(reg_of, ins.args[0], d, s);
      s = s.write(ssa_unary_asm(ins.str, ins.imm == 1, lp + "u" + util.i32_to_string(ins.result), d));
    }
  }
  return ssa_store(reg_of, ins.result, d, s);
}

// ssa_phi_moves emits the copies of the edge from block `pred` into block
// `succ`: each of succ's phis takes its operand for pred. A phi whose operand
// already sits in its home, or which nothing reads, moves nothing. An
// immediate operand has no location to copy, so it is loaded after the copies,
// once nothing still reads the phi's home.
function ssa_phi_moves(f: ssa.SFunc, fr: SsaFrame, reg_of: i32[], pred: i32, succ: i32, s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  let ti: i32 = ssa_block_at(fr, succ);
  if (ti < 0) {
    return s;
  }
  let tb: ssa.SBlock = f.blocks[ti];
  let sl: i32 = ssa.pred_slot(tb, pred);
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  let imm_dsts: i32[] = [];
  let imm_vals: i64[] = [];
  for ins in tb.insts {
    if (ins.kind_tag != 8 || reg_of[ins.result] == 0 - 1) {
      continue;
    }
    if (fr.imm.is_imm[ins.args[sl]]) {
      imm_dsts = imm_dsts.append(reg_of[ins.result]);
      imm_vals = imm_vals.append(fr.imm.value[ins.args[sl]]);
    } else if (reg_of[ins.args[sl]] != reg_of[ins.result]) {
      srcs = srcs.append(reg_of[ins.args[sl]]);
      dsts = dsts.append(reg_of[ins.result]);
    }
  }
  s = ssa_parallel_moves(srcs, dsts, s);
  let i: i32 = 0;
  while (i < imm_dsts.len()) {
    s = ssa_imm_to(imm_vals[i], imm_dsts[i], s);
    i = i + 1;
  }
  return s;
}

// ssa_imm_to loads an immediate into a location: a register, or a frame slot,
// which takes a sign-extended 32-bit immediate directly.
function ssa_imm_to(c: i64, loc: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (loc >= 0) {
    return ssa_const_reg(util.i64_to_string(c), false, ssa_reg(loc), s);
  }
  return ssa_mov_im(s, c, "%rbp", ssa_slot_disp(ssa.spill_slot(loc), s.ssa_save));
}

// ssa_parallel_moves emits moves between locations (a register index or a
// spill code, as reg_of holds them) that happen at once: every source is read
// before any destination it names is written. They are a phi edge's copies, a
// register call's arguments and a register entry's parameters. A move whose
// destination no pending move still reads goes first, in one instruction when
// either side is a register, or two through %rcx between two slots. When
// every pending destination is still read, the moves form a cycle: one source
// is parked in %r11 and every move reading it takes it from there, which
// frees that location to be written.
function ssa_parallel_moves(srcs: i32[], dsts: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let done: boolean[] = __alloc_bool(srcs.len());
  let parking: boolean = false;
  let parked: i32 = 0;
  let left: i32 = srcs.len();
  while (left > 0) {
    let progressed: boolean = false;
    let i: i32 = 0;
    while (i < srcs.len()) {
      if (!done[i] && !ssa_move_blocked(srcs, dsts, done, i, parking, parked)) {
        if (parking && srcs[i] == parked) {
          s = s.write("    movq %r11, " + ssa_loc(dsts[i], s) + "\n");
        } else {
          s = ssa_move(srcs[i], dsts[i], s);
        }
        done = done.with(i, true);
        left = left - 1;
        progressed = true;
      }
      i = i + 1;
    }
    if (!progressed) {
      let j: i32 = 0;
      while (done[j]) {
        j = j + 1;
      }
      s = s.write("    movq " + ssa_loc(srcs[j], s) + ", %r11\n");
      parking = true;
      parked = srcs[j];
    }
  }
  return ssa_x0_forget(s);
}

// A move is blocked while another pending move still reads its destination
// from that location rather than from the parked copy.
function ssa_move_blocked(srcs: i32[], dsts: i32[], done: boolean[], i: i32, parking: boolean, parked: i32): boolean {
  let k: i32 = 0;
  while (k < srcs.len()) {
    if (k != i && !done[k] && srcs[k] == dsts[i] && !(parking && srcs[k] == parked)) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function ssa_move(src: i32, dst: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (src == dst) {
    return s;
  }
  if (src >= 0 && dst >= 0) {
    return ssa_mov_rr(s, ssa_reg(dst), ssa_reg(src));
  }
  if (src >= 0) {
    return ssa_mov_slot(s, false, ssa_reg(src), ssa_slot_disp(ssa.spill_slot(dst), s.ssa_save));
  }
  if (dst >= 0) {
    return ssa_mov_slot(s, true, ssa_reg(dst), ssa_slot_disp(ssa.spill_slot(src), s.ssa_save));
  }
  s = ssa_mov_slot(s, true, "%rcx", ssa_slot_disp(ssa.spill_slot(src), s.ssa_save));
  return ssa_mov_slot(s, false, "%rcx", ssa_slot_disp(ssa.spill_slot(dst), s.ssa_save));
}

// ssa_loc spells a location: its register, or its frame slot.
function ssa_loc(loc: i32, s: asmcore.EmitState): string {
  if (loc >= 0) {
    return ssa_reg(loc);
  }
  return ssa_slot(ssa.spill_slot(loc), s.ssa_save);
}

function ssa_epilogue(): string {
  return "    .cfi_remember_state\n    leave\n    .cfi_def_cfa %rsp, 8\n    ret\n    .cfi_restore_state\n";
}

// ssa_jump is the branch to block `to`, or nothing when `to` is the block
// emitted next and control falls into it.
function ssa_jump(fr: SsaFrame, lp: string, to: i32, next: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (to == next) {
    return s;
  }
  return ssa_branch(s, J_JMP, ssa_blab(fr, lp, to));
}

// ssa_brif branches on a value, or on the flags a fused compare left (fu.n
// above 0), in which case the false edge is the compare's inverse; a fused
// `not` (fu.tag 0) is the value test with the edges swapped. An edge
// whose target has phis lands on a stub carrying that edge's moves, since
// the moves of the two edges differ.
function ssa_brif(f: ssa.SFunc, fr: SsaFrame, blk: ssa.SBlock, reg_of: i32[], lp: string, next: i32, fu: SsaFuse, s: asmcore.EmitState): asmcore.EmitState {
  let t: ssa.STerm = blk.term;
  // A value test reads the value where it lives, through %r11 only when spilled.
  let tv: i32 = t.cond;
  if (fu.n > 0) {
    tv = fu.a;
  }
  if (fu.n == 0) {
    s = ssa_read(reg_of, t.cond, "%r11", s);
  }
  let tr: string = ssa_src(reg_of, tv, "%r11");
  if (t.t == t.f) {
    s = ssa_phi_moves(f, fr, reg_of, blk.id, t.t, s);
    return ssa_jump(fr, lp, t.t, next, s);
  }
  let fl: asmcore.Lab = ssa_blab(fr, lp, t.f);
  let stub: boolean = ssa_has_phis(f, fr, t.f);
  if (stub) {
    let sn: asmcore.LabNew = asmcore.lab_new(s, lp + "e" + util.i32_to_string(blk.id) + "_" + util.i32_to_string(t.f));
    s = sn.state;
    fl = sn.lab;
  }
  // When the false target is the next block and neither edge carries phi
  // moves, branch on the condition itself and fall through.
  if (!stub && t.f == next && !ssa_has_phis(f, fr, t.t)) {
    let tl: asmcore.Lab = ssa_blab(fr, lp, t.t);
    if (fu.n > 0 && fu.tag == 0) {
      return ssa_branch(ssa_test_rr(s, 64, tr, tr), J_JZ, tl);
    }
    if (fu.n > 0) {
      return ssa_branch(s, ir_cmp_jcc(fu.tag, !fu.inverted), tl);
    }
    return ssa_branch(ssa_test_rr(s, 64, tr, tr), J_JNZ, tl);
  }
  if (fu.n > 0 && fu.tag == 0) {
    s = ssa_branch(ssa_test_rr(s, 64, tr, tr), J_JNZ, fl);
  } else if (fu.n > 0) {
    s = ssa_branch(s, ir_cmp_jcc(fu.tag, fu.inverted), fl);
  } else {
    s = ssa_branch(ssa_test_rr(s, 64, tr, tr), J_JZ, fl);
  }
  s = ssa_phi_moves(f, fr, reg_of, blk.id, t.t, s);
  if (stub) {
    s = ssa_branch(s, J_JMP, ssa_blab(fr, lp, t.t));
    s = ssa_x0_forget(s);
    s = s.lab_def(fl);
    s = ssa_phi_moves(f, fr, reg_of, blk.id, t.f, s);
    return ssa_jump(fr, lp, t.f, next, s);
  }
  return ssa_jump(fr, lp, t.t, next, s);
}

// ssa_fused_test sets the flags a block's fused compare leaves for its branch
// (or brings a fused `not`'s operand into a register, for the value test).
// `join` names the label a fused uniqueness test's guards meet at.
function ssa_fused_test(fr: SsaFrame, reg_of: i32[], fu: SsaFuse, join: string, s: asmcore.EmitState): asmcore.EmitState {
  if (!s.retain_sites || !fu.unique) {
    return ssa_fused_test_emit(fr, reg_of, fu, join, s);
  }
  let h = buf_new(512);
  let site = ssaprepare.UniqueSite { input: fu.a, result: -1, input_home: reg_of[fu.a], result_home: -1, cached: s.ssa_x0, flags: true, aligned: fu.aligned, inverted: fu.inverted, join: join, text: "" };
  let out = ssa_fused_test_emit(fr, reg_of, fu, join, asmcore.EmitState { ...s, capture: h });
  return asmcore.finish_unique_site(out, h, s.capture, site);
}

function ssa_fused_test_emit(fr: SsaFrame, reg_of: i32[], fu: SsaFuse, join: string, s: asmcore.EmitState): asmcore.EmitState {
  if (fu.n > 0 && fu.tag == 0) {
    return ssa_read(reg_of, fu.a, "%r11", s);
  }
  if (fu.n == 0) {
    return s;
  }
  if (fu.unique) {
    return ssa_unique_flags(reg_of, fu.a, fu.aligned, join, s);
  }
  let b_in_slot: boolean = !fr.imm.is_imm[fu.b] && reg_of[fu.b] < 0;
  if (reg_of[fu.a] < 0 && s.ssa_x0 != fu.a && !b_in_slot) {
    let disp: i32 = ssa_slot_disp(ssa.spill_slot(reg_of[fu.a]), s.ssa_save);
    if (fr.imm.is_imm[fu.b]) {
      let v: i64 = fr.imm.value[fu.b];
      if (v >= -2147483648i64 && v <= 2147483647i64) {
        return ssa_alu_im(s, 7, 64, v as i32, "%rbp", disp);
      }
      return s.write("    cmpq $" + util.i64_to_string(v) + ", " + ssa_slot(ssa.spill_slot(reg_of[fu.a]), s.ssa_save) + "\n");
    }
    return ssa_alu_rm(s, 7, 64, false, ssa_reg(reg_of[fu.b]), "%rbp", disp);
  }
  s = ssa_read(reg_of, fu.a, "%r11", s);
  return ssa_alu_rhs(s, 7, 64, fr, reg_of, fu.b, ssa_src(reg_of, fu.a, "%r11"));
}

// ssa_unique_flags is ssa_rc_prim's uniqueness test as flags: ZF is set only
// when the count is exactly one. Each guard's early exit already leaves ZF
// clear (a set tag bit; a pointer below, so unequal to, the floor).
function ssa_unique_flags(reg_of: i32[], v: i32, aligned: boolean, join: string, s: asmcore.EmitState): asmcore.EmitState {
  s = helper_call_needs("__fern_rc_is_unique", s);
  s = ssa_read(reg_of, v, "%r11", s);
  let p: string = ssa_src(reg_of, v, "%r11");
  let jn: asmcore.LabNew = asmcore.lab_new(s, join);
  s = jn.state;
  s = ssa_branch(ssa_test_bit(s, 1, p), J_JNZ, jn.lab);
  s = ssa_branch(ssa_cmp_floor(s, p), J_JB, jn.lab);
  let rb: string = p;
  if (!aligned) {
    s = ssa_alu_ir(ssa_mov_rr(s, "%rdx", p), 4, 64, -3i64, "%rdx");
    rb = "%rdx";
  }
  return ssa_rc_is_one(s, rb).lab_def(jn.lab);
}

// ssa_rc_is_one compares the count of the box at `rb` with one, through %edx
// when the sanitizer must see the loaded value first.
function ssa_rc_is_one(s: asmcore.EmitState, rb: string): asmcore.EmitState {
  if (s.rc_free_debug) {
    s = ssa_mov_rm(s, 32, true, "%rdx", rb, 0 - 8).write(san_poison_check("%edx", s.rc_free_debug));
    return ssa_alu_ir(s, 7, 32, 1i64, "%rdx");
  }
  return ssa_alu_im(s, 7, 32, 1, rb, 0 - 8);
}

// ssa_rotates reports whether a branch from the block at position `from` to
// block `to` can re-run `to`'s test in place of jumping to it: `to` is at or
// before `from` (a back edge), holds nothing but phis and the test (and the
// immediates it reads), and
// neither of its successors has phis, so its branch carries no moves of its
// own. A loop then costs one branch per iteration rather than two.
function ssa_rotates(f: ssa.SFunc, fr: SsaFrame, from: i32, to: i32): boolean {
  let ti: i32 = ssa_block_at(fr, to);
  if (ti < 0 || ti > from) {
    return false;
  }
  let h: ssa.SBlock = f.blocks[ti];
  if (h.term.kind_tag != 3 || h.term.t == h.term.f) {
    return false;
  }
  if (ssa_has_phis(f, fr, h.term.t) || ssa_has_phis(f, fr, h.term.f)) {
    return false;
  }
  let n: i32 = 0;
  for ins in h.insts {
    // A constant the test reads as an immediate is never materialised.
    let imm: boolean = (ins.kind_tag == 1 || ins.kind_tag == 3) && fr.imm.is_imm[ins.result];
    if (ins.kind_tag != 8 && !imm) {
      n = n + 1;
    }
  }
  return n == ssa_fuse(fr, h).n;
}

function ssa_term(f: ssa.SFunc, fr: SsaFrame, blk: ssa.SBlock, reg_of: i32[], lp: string, next: i32, fu: SsaFuse, s: asmcore.EmitState): asmcore.EmitState {
  let t: ssa.STerm = blk.term;
  if (t.kind_tag == 1) {
    if (t.value >= 0 && fr.imm.is_imm[t.value]) {
      s = ssa_const_reg(util.i64_to_string(fr.imm.value[t.value]), false, "%rax", s);
    } else {
      s = ssa_load(reg_of, t.value, "%rax", s);
    }
    return ssa_emit_epilogue(fr, s);
  }
  if (t.kind_tag == 2) {
    s = ssa_phi_moves(f, fr, reg_of, blk.id, t.target, s);
    if (ssa_rotates(f, fr, ssa_block_at(fr, blk.id), t.target)) {
      let h: ssa.SBlock = f.blocks[ssa_block_at(fr, t.target)];
      let hfu: SsaFuse = ssa_fuse(fr, h);
      return ssa_brif(f, fr, h, reg_of, lp, next, hfu, ssa_fused_test(fr, reg_of, hfu, ssa_join(lp, blk.id), s));
    }
    return ssa_jump(fr, lp, t.target, next, s);
  }
  if (t.kind_tag == 3) {
    return ssa_brif(f, fr, blk, reg_of, lp, next, fu, s);
  }
  // A block the lift left unterminated is one nothing reaches; the stack
  // machine's fallback return keeps the text well formed here too.
  return ssa_emit_epilogue(fr, ssa_zero(s, "%rax"));
}

// ssa_load_params moves each parameter to its home; value p is parameter p.
// The first ssa_nregs() arrive in the pool's registers, in order (a stack
// caller's are loaded there by the entry shim); the rest stay in the caller's
// slots. The register moves go first, since a later parameter's home may be a
// register still holding an earlier one.
function ssa_load_params(f: ssa.SFunc, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let k: i32 = ssa_reg_params(f);
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  let p: i32 = 0;
  while (p < k) {
    if (reg_of[p] != 0 - 1) {
      srcs = srcs.append(p);
      dsts = dsts.append(reg_of[p]);
    }
    p = p + 1;
  }
  s = ssa_parallel_moves(srcs, dsts, s);
  while (p < f.nparams) {
    // Straight into the home: %rax is an allocatable home now, so staging
    // every parameter through it overwrote whichever parameter had it.
    let d: string = ssa_dst(reg_of, p);
    s = s.write("    movq " + util.i32_to_string(16 + p * 8) + "(%rbp), " + d + "\n");
    s = ssa_store(reg_of, p, d, s);
    p = p + 1;
  }
  return s;
}

// ssa_reg_params is how many of f's parameters arrive in registers.
function ssa_reg_params(f: ssa.SFunc): i32 {
  if (f.nparams < ssa_nregs()) {
    return f.nparams;
  }
  return ssa_nregs();
}

// ssa_entry_shim is a function's two entries. `__fn_<name>`, the stack-ABI
// entry every caller outside this unit's direct calls uses, loads the first
// ssa_reg_params() arguments from the caller's stack into the pool registers
// and falls through into `__fn_<name>.r`, where a register-ABI caller enters
// with them already there. A function with no parameters has one entry.
function ssa_entry_shim(f: ssa.SFunc, name: string, s: asmcore.EmitState): asmcore.EmitState {
  let k: i32 = ssa_reg_params(f);
  if (k == 0) {
    return s;
  }
  let p: i32 = 0;
  while (p < k) {
    s = ssa_mov_rm(s, 64, true, ssa_reg(p), "%rsp", 8 + 8 * p);
    p = p + 1;
  }
  return s.write("__fn_" + name + ".r:\n");
}

// ssa_reg_helper names the hand-written runtime helpers with a register
// entry, by argument count: their stack entry loads the arguments into the
// pool's first registers, which is where the `.r` entry reads them.
function ssa_reg_helper(sym: string, argc: i32): boolean {
  if (argc == 2) {
    return sym == "__fn___fern_str_eq" || sym == "__fn___fern_alloc_reuse";
  }
  return argc == 1 && (sym == "__fn___fern_arr_dec" || sym == "__fn___fern_str_free" || sym == "__fn___fern_arr_inc_elems");
}

// ssa_reg_call reports whether a direct call passes its arguments in
// registers: the callee has a register entry in this unit and takes between
// one and ssa_nregs() arguments.
function ssa_reg_call(ins: ssa.SInst, s: asmcore.EmitState): boolean {
  let argc: i32 = ins.args.len();
  if (ins.kind_tag != 11 || argc == 0 || argc > ssa_nregs() || ssa.rc_inlined(ins)) {
    return false;
  }
  if (ircore.is_fern_helper(ins.str) || ircore.is_c_call(ins.str)) {
    return false;
  }
  return irtables.sig_reg_has_exact(s.reg_entries, asmcore.sanitize_label(ins.str));
}

// ssa_arg_prefs asks the allocator for the register each parameter arrives in
// and each register call's argument leaves in, so neither needs a move when
// the value has nowhere better to be.
function ssa_arg_prefs(f: ssa.SFunc, s: asmcore.EmitState): i32[] {
  let pref: i32[] = util.minus_ones(f.nvals);
  let p: i32 = 0;
  while (p < ssa_reg_params(f)) {
    pref = pref.with(p, p);
    p = p + 1;
  }
  for blk in f.blocks {
    for ins in blk.insts {
      let rt: boolean = ssa_is_rt_call(ins);
      if (!rt && !ssa_reg_call(ins, s)) {
        continue;
      }
      let a: i32 = 0;
      while (a < ins.args.len() && (!rt || a < 2)) {
        let v: i32 = ins.args[a];
        let r: i32 = a;
        if (rt) {
          r = ssa_rt_arg_reg(a);
        }
        if (v >= 0 && v < pref.len() && pref[v] < 0) {
          pref = pref.with(v, r);
        }
        a = a + 1;
      }
    }
  }
  return pref;
}

// Allocate and emit the prepared register form, retaining its original lowering
// for target entry paths and its lift mappings for debug locations.
function emit_ssa_function_x86(prepared: ssaprepare.Body, label_name: string, entry: ssaprepare.ReleaseEntry, context: Option[ssaprepare.Context], s: asmcore.EmitState): asmcore.EmitState {
  if (!s.retain_prepared || s.records()) {
    return emit_ssa_allocated_x86(prepared, label_name, entry, context, s);
  }
  let h = buf_new(4096);
  let out = emit_ssa_allocated_x86(prepared, label_name, entry, context, asmcore.EmitState { ...s, capture: h, native_sites: [], retain_sites: true });
  return asmcore.finish_native_text(out, h, s.capture, s.native_sites, s.retain_sites);
}

function emit_ssa_allocated_x86(prepared: ssaprepare.Body, label_name: string, entry: ssaprepare.ReleaseEntry, context: Option[ssaprepare.Context], s: asmcore.EmitState): asmcore.EmitState {
  let r = prepared.lowered;
  let seen_vals = prepared.seen_vals;
  let seen_slots = prepared.seen_slots;
  s = asmcore.EmitState { ...s, dw_first: true };
  let formed: ssa.Formed = prepared.formed;
  let f: ssa.SFunc = formed.f;
  let imm: ssa.Imms = ssa.imm_operands(f, 0i64 - 2147483648i64, 2147483647i64, ssa_imm_right(), ssa_imm_left());
  let alloc: ssa.Alloc = ssa.regalloc_linear(f, ssa_nregs(), ssa_nsaved(), 0, true, imm.is_imm, ssa_arg_prefs(f, s));
  let reg_of: i32[] = alloc.reg_of;
  let lp: string = ".Lssa_" + asmcore.sanitize_label(label_name) + "_";
  s = ssa_cfi(s.write("__fn_" + asmcore.sanitize_label(label_name) + ":\n"), 1, "", 0);
  s = ssa_entry_shim(f, asmcore.sanitize_label(label_name), s);
  s = ssa_release_entry(entry, lp, s);
  let saved: i32[] = ssa_saved_regs(reg_of);
  let save: i32 = 8 * saved.len();
  let fn_label: string = "__fn_" + asmcore.sanitize_label(label_name);
  let dbg_out: asmcore.DbgOut = asmcore.dbg_shaped_vars(s, fn_label, alloc, r, formed.repl, seen_vals, seen_slots, ssa_dbg_locs(reg_of, save, seen_vals.len() > 0), ssa.position_count(f));
  s = dbg_out.state;
  let dbg: asmcore.DbgVars = dbg_out.dbg;
  let views: i32[] = ssa_view_slots(f);
  let nspill: i32 = ssa.spill_count(reg_of);
  // A function with no frame slots that might make no call is emitted into a
  // buffer first, behind a placeholder for its epilogue; its text decides
  // whether it needs %rbp at all.
  let leaf: boolean = nspill == 0 && ssa_view_count(views) == 0 && !hev_on(s) && !ssa.calls_out(f);
  let epilogue: string = ssa_epilogue_for(saved);
  if (leaf) {
    epilogue = ssa_epilogue_mark();
  }
  // The blocks' labels take one id each, from lbase.
  let bp: i32[] = ssa.block_positions(f);
  let lbase: i32 = s.nlab;
  s = s.lab_take(bp.len());
  let fr: SsaFrame = SsaFrame { nspill: nspill, views: views, blk_pos: bp, uses: ssa.use_counts(f), nsave: save, saved: saved, leaf: leaf, epilogue: epilogue, imm: imm, lit0: ssa.literal_first_bytes(f), lbase: lbase };
  let fusions: ssaprepare.Fusion[] = [];
  let framed = !leaf;
  let frame: i32 = (fr.nspill + 3 * ssa_view_count(views)) * 8;
  // %rsp is 16-byte aligned at a call when the pushes and the frame together
  // are a multiple of 16.
  if ((frame + save) % 16 != 0) {
    frame = frame + 8;
  }
  let outer: usize = s.capture;
  let body: usize = 0 as usize;
  if (leaf) {
    body = buf_new(4096);
    s = asmcore.EmitState { ...s, capture: body };
  } else {
    s = ssa_frame(s, saved, frame);
  }
  s = asmcore.EmitState { ...s, ssa_save: save };
  s = ssa_load_params(f, reg_of, s);
  // `pos` numbers the instructions and terminators as the allocator does, so
  // a `-g` variable range's labels land where its home takes and drops it.
  let pos: i32 = 0;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: ssa.SBlock = f.blocks[bi];
    let next: i32 = 0 - 1;
    if (bi + 1 < f.blocks.len()) {
      next = f.blocks[bi + 1].id;
    }
    s = ssa_x0_forget(s);
    s = s.lab_def(ssa_blab(fr, lp, blk.id));
    let fu: SsaFuse = ssa_fuse(fr, blk);
    fusions = ssa_retain_fusion(fusions, fu, s.retain_prepared);
    let ii: i32 = 0;
    while (ii < blk.insts.len() - fu.n) {
      s = asmcore.dbg_label(s, dbg, fn_label, pos + ii);
      let ins: ssa.SInst = blk.insts[ii];
      if (ins.kind_tag != 6 && ins.kind_tag != 8) {
        s = ssa_inst(ins, reg_of, lp, fr, r, s);
      }
      ii = ii + 1;
    }
    s = asmcore.dbg_labels(s, dbg, fn_label, pos + ii, pos + blk.insts.len());
    s = ssa_fused_test(fr, reg_of, fu, ssa_join(lp, blk.id), s);
    s = asmcore.dbg_label(s, dbg, fn_label, pos + blk.insts.len());
    s = ssa_term(f, fr, blk, reg_of, lp, next, fu, s);
    pos = pos + blk.insts.len() + 1;
    bi = bi + 1;
  }
  s = asmcore.dbg_label(s, dbg, fn_label, pos);
  if (leaf) {
    let text: string = buf_take(body);
    buf_free(body);
    s = asmcore.EmitState { ...s, capture: outer };
    if (ssa_needs_frame(text)) {
      framed = true;
      s = ssa_frame(s, saved, frame);
      s = s.write(ssa_replace_all(text, ssa_epilogue_mark(), ssa_epilogue_for(saved)));
    } else {
      s = ssa_leaf_save(s, saved);
      let leaf_text: string = ssa_replace_all(text, " __fern_oob_abort\n", " __fern_oob_abort.l" + util.i32_to_string(saved.len()) + "\n");
      s = s.write(ssa_replace_all(leaf_text, ssa_epilogue_mark(), ssa_leaf_epilogue(saved)));
    }
  }
  s = asmcore.EmitState { ...s, ssa_save: 0 };
  s = asmcore.dbg_rows(ssa_cfi(s, 2, "", 0), dbg);
  return ssa_retain_allocation(s, prepared, label_name, context, entry, alloc, fr, frame, framed, fusions);
}

function ssa_retain_allocation(s: asmcore.EmitState, prepared: ssaprepare.Body, label_name: string, context: Option[ssaprepare.Context], entry: ssaprepare.ReleaseEntry, alloc: ssa.Alloc, fr: SsaFrame, frame: i32, framed: boolean, fusions: ssaprepare.Fusion[]): asmcore.EmitState {
  if (s.retain_prepared) {
    let allocation = ssaprepare.Allocation { alloc: alloc, imm: fr.imm, saved: fr.saved, save_bytes: fr.nsave, frame_bytes: if (framed) { frame } else { 0 }, framed: framed, views: fr.views, block_positions: fr.blk_pos, block_label_base: fr.lbase, fusions: fusions };
    s = asmcore.retain_body(s, prepared, label_name, context, entry, allocation);
  }
  return s;
}

// ssa_dbg_locs is each value's home as DWARF location bytes: DW_OP_reg<n> for
// a register, DW_OP_breg6 (%rbp) at its offset for a spill slot, "" for no
// home. A function with spills always has the %rbp frame.
function ssa_dbg_locs(reg_of: i32[], save: i32, want: boolean): string[] {
  let out: string[] = [];
  if (!want) {
    return out;
  }
  for h in reg_of {
    if (h >= 0) {
      out = out.append(asmcore.dbg_hex([80 + ssa_dwarf(ssa_reg(h))]));
    } else if (h < 0 - 1) {
      out = out.append(asmcore.dbg_hex(asmcore.dbg_sleb([118], ssa_slot_disp(ssa.spill_slot(h), save))));
    } else {
      out = out.append("");
    }
  }
  return out;
}

// ssa_frame writes the %rbp frame: the saved registers pushed under it and
// `frame` bytes of slots below them. The `.cfi_*` directives between the
// pushes stay text; ssa_frame_asm is the whole of it as text.
function ssa_frame(s: asmcore.EmitState, saved: i32[], frame: i32): asmcore.EmitState {
  if (!s.records()) {
    return s.write(ssa_frame_asm(saved, frame));
  }
  s = ssa_cfi(ssa_cfi(ssa_push_r(s, "%rbp"), 3, "", 16), 6, "%rbp", 0 - 16);
  s = ssa_cfi(ssa_mov_rr(s, "%rbp", "%rsp"), 4, "%rbp", 0);
  for k in saved {
    s = ssa_push_r(s, ssa_reg(k));
  }
  if (frame > 0) {
    s = ssa_alu_ir(s, 5, 64, frame as i64, "%rsp");
  }
  return s;
}

function ssa_frame_asm(saved: i32[], frame: i32): string {
  let out: string = "    pushq %rbp\n    .cfi_def_cfa_offset 16\n    .cfi_offset %rbp, -16\n    movq %rsp, %rbp\n    .cfi_def_cfa_register %rbp\n";
  out = out + ssa_save_asm(saved);
  if (frame > 0) {
    out = out + "    subq $" + util.i32_to_string(frame) + ", %rsp\n";
  }
  return out;
}

// ssa_epilogue_mark stands for a buffered function's epilogue until its
// frame is chosen.
function ssa_epilogue_mark(): string {
  return "    .ssa_epilogue\n";
}

// ssa_needs_frame reports a buffered body with an instruction that calls,
// pushes, pops or names either frame register. One with none of these runs
// with no frame: it has no slots, and makes no call that would need %rsp
// aligned. Labels are skipped, since each carries the function's name.
function ssa_needs_frame(text: string): boolean {
  let start: i32 = 0;
  while (start < text.len()) {
    let end: i32 = start;
    while (end < text.len() && text[end] != 10) {
      end = end + 1;
    }
    let line: string = slice_unchecked(text, start, end) + "";
    if (util.str_has_prefix(line, "    ") && ssa_line_needs_frame(line)) {
      return true;
    }
    start = end + 1;
  }
  return false;
}

function ssa_line_needs_frame(line: string): boolean {
  for m in ["    call", "    push", "    pop"] {
    if (util.str_has_prefix(line, m)) {
      return true;
    }
  }
  return util.index_of_sub(line, "%rbp") >= 0 || util.index_of_sub(line, "%rsp") >= 0;
}

// ssa_leaf_save pushes the saved registers of a function with no frame, with
// the canonical frame address following %rsp; ssa_leaf_save_asm is its text.
function ssa_leaf_save(s: asmcore.EmitState, saved: i32[]): asmcore.EmitState {
  if (!s.records()) {
    return s.write(ssa_leaf_save_asm(saved));
  }
  let i: i32 = 0;
  while (i < saved.len()) {
    s = ssa_cfi(ssa_cfi(ssa_push_r(s, ssa_reg(saved[i])), 3, "", 16 + 8 * i), 6, ssa_reg(saved[i]), 0 - (16 + 8 * i));
    i = i + 1;
  }
  return s;
}

function ssa_leaf_save_asm(saved: i32[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < saved.len()) {
    let off: string = util.i32_to_string(16 + 8 * i);
    out = out + "    pushq " + ssa_reg(saved[i]) + "\n    .cfi_def_cfa_offset " + off + "\n    .cfi_offset " + ssa_reg(saved[i]) + ", -" + off + "\n";
    i = i + 1;
  }
  return out;
}

// ssa_leaf_epilogue pops what ssa_leaf_save_asm pushed and returns.
function ssa_leaf_epilogue(saved: i32[]): string {
  if (saved.len() == 0) {
    return "    ret\n";
  }
  let out: string = "    .cfi_remember_state\n";
  let i: i32 = saved.len() - 1;
  while (i >= 0) {
    out = out + "    popq " + ssa_reg(saved[i]) + "\n    .cfi_def_cfa_offset " + util.i32_to_string(8 + 8 * i) + "\n";
    i = i - 1;
  }
  return out + "    ret\n    .cfi_restore_state\n";
}

// ssa_replace_all is text with every occurrence of mark replaced by with.
function ssa_replace_all(text: string, mark: string, with: string): string {
  let out: string = "";
  let rest: string = text;
  let at: i32 = util.index_of_sub(rest, mark);
  while (at >= 0) {
    out = out + slice_unchecked(rest, 0, at) + with;
    rest = slice_unchecked(rest, at + mark.len(), rest.len()) + "";
    at = util.index_of_sub(rest, mark);
  }
  return out + rest;
}

// emit_ssa_function emits one lowered function through the register path,
// which is the only emitter: a function the lift or the emitter cannot take
// is refused naming the op (ircore.ssa_refuse). Every op the lowering
// produces has an arm, so a refusal here is a compiler bug, not a program
// the backend does not cover.
function emit_ssa_function(r: irtables.LowerResult, selected: physicalbody.Selected, label_name: string, s: asmcore.EmitState): asmcore.EmitState {
  let t_lift: i64 = monotonic_ns();
  let lifted: ssa_lift.LResult = ssa_lift.lift_from_ir_prod(s.kinds, label_name, r.n_params, r.n_locals, r.ops, r.dbg_slots.len() > 0 && s.records());
  let why: string = lifted.bail;
  if (lifted.ok) {
    let collision: i32 = ssa.repeated_block_id(lifted.func);
    if (collision >= 0) {
      ircore.ssa_block_id_collision(label_name, collision);
    }
    why = ssa_unsupported(lifted.func);
  }
  if (why != "") {
    ircore.ssa_refuse(label_name, why);
  }
  let lift_ms: i64 = (monotonic_ns() - t_lift) / 1000000i64;
  let t_emit: i64 = monotonic_ns();
  let prepared: ssaprepare.Body = ssaprepare.finish(r, selected, lifted, s.leaves);
  let context = asmcore.preparation_context(s, "x86-64");
  let entry = ircore.release_entry(r, "x86-64", s.rc_free_debug, s.reg_entries);
  s = emit_ssa_function_x86(prepared, label_name, entry, context, s);
  // Under the report, a function whose lift or emit took over 200 ms is
  // named with both times: the whole-compiler build is where a phase's
  // cost shows, and this is how a slow one is found.
  let emit_ms: i64 = (monotonic_ns() - t_emit) / 1000000i64;
  if (ircore.ssa_report_on() && lift_ms + emit_ms > 200i64) {
    eprint("FERN_SSA: time " + label_name + ": lift " + util.i32_to_string(lift_ms as i32) + " ms, emit " + util.i32_to_string(emit_ms as i32) + " ms, " + util.i32_to_string(r.ops.len()) + " ops, " + util.i32_to_string(r.n_locals) + " slots");
  }
  return s;
}

// emit_function_via_ir_pre emits declaration `fd`'s lowered body `r` through
// the register path, writing through the global strbuf.
function emit_function_via_ir_pre(r: irtables.LowerResult, selected: physicalbody.Selected, fd: parser.FuncDecl, s: asmcore.EmitState, vgate: irverifygate.Gate): asmcore.EmitState {
  // Methods get the receiver-type-qualified label `__fn_<Type>.<name>` (matching
  // the lowering's dispatch); free functions stay `__fn_<name>`.
  let label_name: string = fd.name;
  if (fd.receiver_type.len() > 0) {
    label_name = util.base_type_name(fd.receiver_type) + "." + fd.name;
  }
  return emit_function_via_ir_named(r, selected, label_name, false, s, vgate);
}

// emit_function_via_ir_named is the body of emit_function_via_ir_pre with the
// label supplied rather than read from a declaration, so a lowering that has no
// FuncDecl — a body the semantic pipeline produced, which carries its own name —
// emits through exactly the same path. `weak` marks the definition co-linkable:
// several per-module units may each emit an identical copy and the linker keeps
// one.
function emit_function_via_ir_named(r: irtables.LowerResult, selected: physicalbody.Selected, label_name: string, weak: boolean, s: asmcore.EmitState, vgate: irverifygate.Gate): asmcore.EmitState {
  if (weak) {
    s = s.write(".weak __fn_" + asmcore.sanitize_label(label_name) + "\n");
  }
  ircore.lower_failed_refuse(label_name, r);
  // Runtime-need detection is marked off the ops of this one lowering; the
  // runtime tail reads the accumulated needs (has_need) rather than lowering
  // the module again to inspect it.
  //
  // Read `.kind` off the bound Op struct INLINE rather than via a `let dk:
  // string = ...kind` local: a named string local aliasing a struct field and
  // dec'd at each loop-iteration boundary takes arm64's deferred native heap-
  // string reclamation path (RC-PERCEUS slice 5g), which over-releases under
  // allocation pressure and crashed the arm64-compiled driver. The inline read
  // (matching the op-emission loop below, which never binds `.kind` to its own
  // local) keeps the string a transient the comparison consumes immediately.
  // Once the heap is needed, no later op can add to that.
  let heap: boolean = s.has_need("heap");
  let dop: i32 = 0;
  while (dop < r.ops.len()) {
    let dopop: ir.Op = r.ops[dop];
    if (!heap && ir.op_needs_heap(dopop)) {
      s = s.need("heap");
      heap = true;
    }
    dop = dop + 1;
  }

  irverifygate.verify_or_refuse(label_name, r.ops, r.n_params, r.n_locals, vgate);
  return emit_ssa_function(r, selected, label_name, s);
}

// emit_dir_op calls a Dir op's runtime leaf, __fern_<kind name>, on the stack
// ABI: the operands re-pushed with param[0] on top, and the immediate, where
// the op carries one (dir_stat's follow, dir_unlink's dir), passed last.
function emit_dir_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let name: string = ir.kind_name(o.kind_tag);
  let regs: string[] = ["%rdi", "%rsi", "%rdx", "%rcx", "%r8"];
  let n: i32 = ir.op_pops(o);
  let k: i32 = n - 1;
  while (k >= 0) {
    s = s.write("    popq " + regs[k] + "\n");
    k = k - 1;
  }
  if (o.kind_tag == 423 || o.kind_tag == 425) {
    s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", " + regs[n] + "\n");
    n = n + 1;
  }
  k = n - 1;
  while (k >= 0) {
    s = s.write("    pushq " + regs[k] + "\n");
    k = k - 1;
  }
  s = s.write("    call __fn___fern_" + name + "\n    addq $" + util.i32_to_string(8 * n) + ", %rsp\n    pushq %rax\n");
  return s.need("heap").need(name);
}

// emit_stack_op emits one op on the machine stack: it pops the op's operands
// and pushes its result. The register path runs it, between a push of the
// operands and a pop of the result (ssa_flat_op), for every op the lift has
// no instruction of its own — the OS floor, the map ops, the byte kernels,
// the byte-buffer builder. An op the lift lowers itself has no arm here.
// fern-lint: allow cyclomatic-complexity
// One guard per IR op and no multi-line body left to move: the op table itself.
function emit_stack_op(o: ir.Op, i: i32, lp: string, r: irtables.LowerResult, s: asmcore.EmitState): asmcore.EmitState {
  if (o.kind_tag == 79) {  // ptr_width
    // () -> heap-pointer width in bytes. 8 on x86-64.
    s = s.write("    pushq $8\n");
  } else if (o.kind_tag == 409) {  // sha256_hw
    // () -> 0: x86-64-v3 has no SHA-256 instructions.
    s = s.write("    pushq $0\n");
  } else if (o.kind_tag == 74) {  // memcpy
    // [dst, src, n] -> copy n bytes src->dst (rep movsb), push dummy 0.
    // n is on top, then src, then dst (the lowering order). Mirrors the
    // AST __memcpy emitter in asm.fern.
    s = s.write(ir_memcpy_asm());
  } else if (o.kind_tag == 75) {  // memset
    // [dst, byte, n] -> fill n bytes at dst with byte's low byte (rep
    // stosb, AL), push dummy 0. n on top, then byte, then dst.
    s = s.write(ir_memset_asm());
  } else if (o.kind_tag == 78) {  // free
    // [ptr, size] -> return the raw block to its size class; push dummy 0.
    s = s.write("    popq %rsi\n    popq %rdi\n");
    let owned: boolean = s.leak_check && s.rt_owned_allocs;
    if (owned) {
      s = s.write("    movq %rsi, __fern_lc_rt_req(%rip)\n");
    }
    s = s.write("    call __fern_raw_free\n");
    if (owned) {
      // A runtime-owned block (#11386) whose alloc the census never counted:
      // take its free back out. The task runtime frees only non-null blocks
      // of a word or more, each of which __fern_raw_free counts.
      s = lc_rt_uncount(s, "__fern_lc_free_bytes", "__fern_lc_free_count");
    }
    s = s.write("    pushq $0\n");
    s = s.need("heap");
  } else if (o.kind_tag == 91) {  // arr_rc
    // pop base; 32-bit refcount field at data-8.
    s = s.write("    popq %rax\n    movl -8(%rax), %eax\n    pushq %rax\n");
  } else if (ir.is_str_op_kind(o.kind_tag)) {
    // All string operand-stack ops (len/index/slice/bytes/split/
    // predicates/concat/eq/cmp) are emitted by emit_str_op — factored out
    // to keep this dispatch under the oversized-function threshold (#2720).
    s = emit_str_op(o, s);
  } else if (o.kind_tag == 185) {  // random_bytes
    // [n] IS param[0] (+16); call the Fern-compiled __fn___fern_random_bytes
    // (asmcore.rt_src_random_bytes, #2649) via the stack ABI. Mirrors the
    // str_from_bytes / str_split handlers.
    let rb: string = "random_bytes" + asmcore.packed_suffix(ir.is_packed(o));
    s = s.write("    call __fn___fern_" + rb + "\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need(rb);
  } else if (o.kind_tag == 186) {  // random_i32
    // no operands; the Fern-compiled __fn___fern_random_i32() -> i32 in
    // %rax. Zero args, so the stack ABI needs no push and no cleanup.
    s = s.write("    call __fn___fern_random_i32\n    pushq %rax\n");
    s = s.need("random_i32");
  } else if (o.kind_tag == 211) {  // proc_fork
    // no operands; __fern_proc_fork() -> i32 in %rax (0 child / pid
    // parent / -errno).
    s = s.write("    call __fn___fern_proc_fork\n    pushq %rax\n");
    s = s.need("proc_fork");
  } else if (o.kind_tag == 212) {  // proc_waitpid
    // [pid] -> __fern_proc_waitpid(%rdi = pid) -> decoded status in %rax.
    // [pid] IS param[0] already; the stack ABI needs no marshalling.
    s = s.write("    call __fn___fern_proc_waitpid\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("proc_waitpid");
  } else if (o.kind_tag == 286) {  // proc_waitpid_nohang
    // [pid] -> __fern_proc_waitpid_nohang(%rdi = pid) -> the
    // decoded status, -1 when the child is still running, or
    // -errno.
    s = s.write("    call __fn___fern_proc_waitpid_nohang\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("proc_waitpid_nohang");
  } else if (o.kind_tag == 397) {  // proc_waitpid_status
    // [pid] -> __fern_proc_waitpid_status(%rdi = pid) -> the raw wait
    // status or -errno.
    s = s.write("    call __fn___fern_proc_waitpid_status\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("proc_waitpid_status");
  } else if (o.kind_tag == 213) {  // proc_exec
    // Only returns on failure (-errno), so the push is the failure value.
    // [pathbox, argsbox] with args on top; the stack ABI wants param[0]
    // (path) lowest, so pop and re-push swapped. `env` stays marked: the
    // helper reads __raw_environ(), whose .bss slot and _start save are
    // gated on it.
    s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
    s = s.write("    call __fn___fern_proc_exec\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("env");
    s = s.need("proc_exec");
  } else if (o.kind_tag == 280) {  // proc_exec_as
    // [pathbox, argvbox, envpbox] with envp on top; the stack ABI wants
    // param[0] (path) lowest, so pop all three and re-push reversed.
    // No `env` need: the environment is an operand, not __raw_environ().
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n");
    s = s.write("    call __fn___fern_proc_exec_as\n    addq $24, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("proc_exec_as");
  } else if (o.kind_tag == 183) {  // now_ns
    // no operands; Fern-compiled __fn___fern_now_ns() -> i64 in %rax (#2649).
    s = s.write("    call __fn___fern_now_ns\n    pushq %rax\n");
    s = s.need("now_ns");
  } else if (o.kind_tag == 187) {  // poll
    // operand stack [fds, timeout] with timeout ON TOP, but the stack
    // ABI wants param[0] (fds) at the lowest address — so the two are
    // popped and re-pushed swapped rather than called in place.
    s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
    s = s.write("    call __fn___fern_poll\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("poll");
  } else if (o.kind_tag == 188) {  // timer_fd
    // [ms]; __fern_timer_fd(%rdi=ms) -> a CLOCK_MONOTONIC timerfd fd
    // (readable after ms), or -errno, in %rax.
    // [ms] IS param[0] already; the stack ABI needs no marshalling.
    s = s.write("    call __fn___fern_timer_fd\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("timer_fd");
  } else if (o.kind_tag == 312) {  // termios_get
    // [fd]; __fern_termios_get(fd) -> Result[i64[], IoError].
    // [fd] IS param[0] already; the stack ABI needs no marshalling.
    s = s.write("    call __fn___fern_termios_get\n    addq $8, %rsp\n    pushq %rax\n");
    // The runtime body builds its answer with `out.append(...)` on an
    // i64[], so the array push it lowers to has to be emitted too.
    s = s.need("heap");
    s = s.need("termios_get");
    s = s.need("arr_push_owned");
  } else if (o.kind_tag == 313) {  // termios_set
    // [fd][when][words] with the words on top; the stack ABI wants
    // param[0] (fd) LOWEST, so pop all three and re-push reversed, as
    // proc_exec_as does. Without it the fd arrives where the array
    // belongs and reading its length faults.
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n");
    s = s.write("    call __fn___fern_termios_set\n    addq $24, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("termios_set");
  } else if (o.kind_tag == 406) {  // set_extproc
    // [fd][on] (on on top) -> Result[void, IoError].
    s = s.write("    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_set_extproc\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("set_extproc");
  } else if (o.kind_tag == 314) {  // set_window_size
    // [fd][rows][cols] with cols on top; the same three-operand
    // marshalling termios_set needs — param[0] (fd) LOWEST.
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n");
    s = s.write("    call __fn___fern_set_window_size\n    addq $24, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("set_window_size");
  } else if (o.kind_tag == 408) {  // pipe
    // no operands; __fern_pipe() -> Result[Pipe, IoError].
    s = s.write("    call __fn___fern_pipe\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("pipe");
  } else if (o.kind_tag >= 420 && o.kind_tag <= 427) {  // the Dir family
    s = emit_dir_op(o, s);
  } else if (o.kind_tag == 276) {  // window_size
    // [fd]; __fern_window_size(fd) -> Result[WinSize, IoError].
    // [fd] IS param[0] already; the stack ABI needs no marshalling.
    s = s.write("    call __fn___fern_window_size\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("window_size");
  } else if (o.kind_tag == 232) {  // isatty
    // [fd]; __fern_isatty(%rdi=fd) -> 1 when fd is a terminal, else 0.
    // [fd] IS param[0] already; the stack ABI needs no marshalling.
    s = s.write("    call __fn___fern_isatty\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("isatty");
  } else if (o.kind_tag == 271) {  // process_alive
    // [pid]; __fern_process_alive(pid) -> 1 when a process with that
    // pid exists, else 0. [pid] IS param[0] already; the stack ABI
    // needs no marshalling.
    s = s.write("    call __fn___fern_process_alive\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("process_alive");
  } else if (o.kind_tag == 285) {  // signal_send
    // [pid][sig] (sig on top) -> Result[void, IoError]. Two operands
    // in param order but on the wrong end of the stack, so pop both
    // and re-push with param[0] (pid) on top.
    s = s.write("    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_signal_send\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("signal_send");
  } else if (o.kind_tag == 284) {  // set_process_group
    // [pid][pgid] (pgid on top) -> Result[void, IoError]. The same
    // two-operand marshalling signal_send needs: pop both and
    // re-push with param[0] (pid) on top.
    s = s.write("    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_set_process_group\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("set_process_group");
  } else if (o.kind_tag == 282) {  // priority
    // no args -> __fern_priority() -> this process's nice value in
    // %rax. Nothing is boxed, so no heap need.
    s = s.write("    call __fn___fern_priority\n    pushq %rax\n");
    s = s.need("priority");
  } else if (o.kind_tag == 283) {  // set_priority
    // [nice] IS param[0] (+16) -> Result[void, IoError].
    s = s.write("    call __fn___fern_set_priority\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("set_priority");
  } else if (o.kind_tag == 388) {  // clock_set
    // [sec][nsec] (nsec on top) -> Result[void, IoError], re-pushed with
    // param[0] (sec) on top the way signal_send's pair is.
    s = s.write("    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_clock_set\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("clock_set");
  } else if (o.kind_tag == 389) {  // clock_resolution
    // no args -> the clock's tick in nanoseconds in %rax. Nothing is
    // boxed, so no heap need.
    s = s.write("    call __fn___fern_clock_resolution\n    pushq %rax\n");
    s = s.need("clock_resolution");
  } else if (o.kind_tag == 272) {  // rlimit_nofile
    // no args -> __fern_rlimit_nofile() -> the soft RLIMIT_NOFILE as a
    // full-width i64 in %rax.
    s = s.write("    call __fn___fern_rlimit_nofile\n    pushq %rax\n");
    s = s.need("rlimit_nofile");
  } else if (o.kind_tag == 396) {  // disable_core_dumps
    // no args -> __fern_disable_core_dumps() -> 1 once it cannot dump core.
    s = s.write("    call __fn___fern_disable_core_dumps\n    pushq %rax\n");
    s = s.need("disable_core_dumps");
  } else if (o.kind_tag == 399) {  // ct_mark
    // [bytes] -> __fern_ct_secret / __fern_ct_public(%rdi = bytes).
    s = s.write("    call __fn___fern_" + asmcore.ct_mark_helper(o.i32_imm) + "\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("ct_mark");
  } else if (o.kind_tag == 400) {  // vg_request
    // [args] -> valgrind's client request: %rax the block, %rdx the
    // default and then the result; the rotations leave %rdi as it was.
    s = s.write("    popq %rax\n    xorl %edx, %edx\n    rolq $3, %rdi\n    rolq $13, %rdi\n    rolq $61, %rdi\n    rolq $51, %rdi\n    xchgq %rbx, %rbx\n    pushq %rdx\n");
  } else if (o.kind_tag == 243 || o.kind_tag == 244) {  // signal_ignore / signal_default
    // [sig]; __fern_signal_{ignore,default}(%rdi=sig) -> the sigaction
    // return, pushed so the statement-level drop balances. [sig] IS
    // param[0] already; the stack ABI needs no marshalling.
    let sig_fn: string = "signal_ignore";
    if (o.kind_tag == 244) {
      sig_fn = "signal_default";
    }
    s = s.write("    call __fn___fern_" + sig_fn + "\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need(sig_fn);
  } else if (o.kind_tag == 392 || o.kind_tag == 394) {  // signal_catch / signal_catch_interrupting
    // [sig] -> __fern_signal_catch(sig, catcher, restorer, restart): the
    // runtime floor cannot name a label, so the two code addresses go in
    // as operands, param[0] on top. Only signal_catch restarts.
    let restart: string = "1";
    if (o.kind_tag == 394) {
      restart = "0";
    }
    s = s.write("    popq %rdi\n    pushq $" + restart + "\n    leaq __fern_sig_return(%rip), %rax\n    pushq %rax\n    leaq __fern_sig_catcher(%rip), %rax\n    pushq %rax\n    pushq %rdi\n");
    s = s.write("    call __fn___fern_signal_catch\n    addq $32, %rsp\n    pushq %rax\n");
    s = s.need("signal_catch");
  } else if (o.kind_tag == 395) {  // signal_raise
    // [sig] -> __fern_signal_raise(sig) -> kill(2)'s return. [sig] IS
    // param[0] already, as for signal_ignore.
    s = s.write("    call __fn___fern_signal_raise\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("signal_raise");
  } else if (o.kind_tag == 393) {  // signal_taken
    // [sig] -> __fern_signal_taken(%rdi=sig): the flag, cleared by the
    // same exchange that reads it.
    s = s.write("    popq %rdi\n    call __fern_signal_taken\n    pushq %rax\n");
    s = s.need("signal_taken");
  } else if (o.kind_tag == 237) {  // access
    // [pathbox][mode] (mode on top) -> Result[void, IoError]. Same
    // two-operand shuffle write_file does: the stack ABI wants
    // param[0] on top, so re-push the popped pair in reverse.
    s = s.write("    popq %rsi\n    popq %rdi\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_access\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("access");
  } else if (o.kind_tag == 240) {  // hostname
    // no args -> the Fern-compiled __fn___fern_hostname: the node name
    // in ONE fresh rc-headered string box, pushed in %rax.
    s = s.write("    call __fn___fern_hostname\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("hostname");
  } else if (o.kind_tag == 250) {  // uname_field
    // [index] -> __fn___fern_uname_field: one utsname field in ONE
    // fresh rc-headered string box, pushed in %rax.
    s = s.write("    call __fn___fern_uname_field\n    addq $8, %rsp\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("uname_field");
  } else if (o.kind_tag == 251) {  // getcwd
    // -> a fresh Result[string, IoError] in %rax.
    s = s.write("    call __fn___fern_getcwd\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("getcwd");
  } else if (o.kind_tag == 252) {  // cpu_count
    s = s.write("    call __fn___fern_cpu_count\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("cpu_count");
  } else if (o.kind_tag == 238) {  // geteuid
    s = s.write("    call __fn___fern_geteuid\n    pushq %rax\n");
    s = s.need("geteuid");
  } else if (o.kind_tag == 239) {  // getegid
    s = s.write("    call __fn___fern_getegid\n    pushq %rax\n");
    s = s.need("getegid");
  } else if (o.kind_tag == 246) {  // getuid
    s = s.write("    call __fn___fern_getuid\n    pushq %rax\n");
    s = s.need("getuid");
  } else if (o.kind_tag == 247) {  // getgid
    s = s.write("    call __fn___fern_getgid\n    pushq %rax\n");
    s = s.need("getgid");
  } else if (o.kind_tag == 248) {  // getgroups
    // no args -> the Fern-compiled __fn___fern_getgroups: a fresh i64[]
    // of the supplementary group set, pushed in %rax.
    s = s.write("    call __fn___fern_getgroups\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("getgroups");
  } else if (o.kind_tag == 249) {  // environ
    // no args -> the Fern-compiled __fn___fern_environ: a fresh string[]
    // of the whole environment. Reads the same __fern_envp global env
    // does, which is why the envp need below covers this op too.
    s = s.write("    call __fn___fern_environ\n    pushq %rax\n");
    s = s.need("heap");
    s = s.need("environ");
  } else if (o.kind_tag == 148) {  // wasm_timer_pollable
    // [ns]; __fern_wasm_timer_pollable(%rdi=ns) -> -1 on native (no
    // pollable; the deadline comes from poll(2)'s timeout). Portability
