  s = s.write("    movl -16(%rax), %ecx\n");
  s = s.write("    addq $3, %rcx\n");
  s = s.write("    leaq -16(%rax), %rdx\n");
  s = s.write("    cmpq $256, %rcx\n");
  s = s.write("    ja .Larrdec_big\n");
  s = hev_free(s, "%rdx", "%rcx");
  if (!s.rc_free_debug) {
    s = s.write(".Larrdec_push:\n");
    s = freelist_push_classed(s, "%rdx", "%rcx", "%rdi");
  }
  s = s.write(".Larrdec_ret:\n");
  s = s.write("    ret\n");
  s = s.write(".Larrdec_shared:\n");
  s = s.write("    testl %ecx, %ecx\n");
  s = s.write("    js .Larrdec_ret\n");
  s = s.write("    jg .Larrdec_dec\n");
  s = s.write("    incl __fern_rc_underflow(%rip)\n");
  s = s.write(san_underflow_abort(s));
  s = s.write("    jmp .Larrdec_ret\n");
  s = s.write(".Larrdec_dec:\n");
  s = s.write("    subl $1, %ecx\n");
  s = s.write("    movl %ecx, -8(%rax)\n");
  s = s.write("    ret\n");
  s = s.write(".Larrdec_big:\n");
  s = s.write("    cmpq $65536, %rcx\n");
  s = s.write("    jae .Larrdec_large\n");
  s = hev_free(s, "%rdx", "%rcx");
  if (!s.rc_free_debug) {
    s = s.write("    pushq %rcx\n");
    s = s.write("    call __fern_capw\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    jmp .Larrdec_push\n");
