  s = s.write("    shlq %cl, %rdx\n");  // granule = 1 << (msb - 2)
  s = s.write("    leaq -1(%rax,%rdx), %rax\n");
  s = s.write("    negq %rdx\n");
  s = s.write("    andq %rdx, %rax\n");  // round up to the granule
  s = s.write("    cmpq $65536, %rax\n");
