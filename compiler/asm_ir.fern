function arr_push_fast_u8(slow: string, on: boolean): string {
  if (on) {
    return "";
  }
  let ok = slow + "_ok";
  return "    movq (%rdi), %rdx\n    movq -16(%rdi), %rcx\n    shlq $3, %rcx\n    cmpq %rcx, %rdx\n    jge " + slow + "\n"
    + "    movl -8(%rdi), %ecx\n    cmpl $1, %ecx\n    je " + ok + "\n"
    + "    testl %ecx, %ecx\n    jns " + slow + "\n"
    + ok + ":\n    movb %sil, 8(%rdi,%rdx)\n    incq %rdx\n    movq %rdx, (%rdi)\n"
    + "    movq %rdi, %rax\n    ret\n";
}

function arr_copy_elems(l: string): string {
  return "    leaq 8(%r12), %rsi\n    leaq 8(%rax), %rdi\n    movq %r14, %rcx\n    subq $8, %rcx\n    jl " + l + "_copy_lt8\n"
    + l + "_copy8:\n    vmovdqu (%rsi), %ymm0\n    vmovdqu 32(%rsi), %ymm1\n    vmovdqu %ymm0, (%rdi)\n    vmovdqu %ymm1, 32(%rdi)\n"
    + "    addq $64, %rsi\n    addq $64, %rdi\n    subq $8, %rcx\n    jge " + l + "_copy8\n    vzeroupper\n"
    + l + "_copy_lt8:\n    addq $8, %rcx\n    cmpq $4, %rcx\n    jl " + l + "_copy1\n"
    + "    movdqu (%rsi), %xmm0\n    movdqu 16(%rsi), %xmm1\n    movdqu %xmm0, (%rdi)\n    movdqu %xmm1, 16(%rdi)\n"
    + "    addq $32, %rsi\n    addq $32, %rdi\n    subq $4, %rcx\n"
    + l + "_copy1:\n    testq %rcx, %rcx\n    jz " + l + "_copy_done\n"
    + l + "_copy1_loop:\n    movq (%rsi), %rdx\n    movq %rdx, (%rdi)\n    addq $8, %rsi\n    addq $8, %rdi\n    decq %rcx\n    jnz " + l + "_copy1_loop\n"
    + l + "_copy_done:\n";
}

function arr_push_fast(slow: string, on: boolean): string {
  if (on) {
    return "";
  }
  let ok = slow + "_ok";
  return "    movq (%rdi), %rdx\n    cmpq -16(%rdi), %rdx\n    jge " + slow + "\n"
    + "    movl -8(%rdi), %ecx\n    cmpl $1, %ecx\n    je " + ok + "\n"
    + "    testl %ecx, %ecx\n    jns " + slow + "\n"
    + ok + ":\n    movq %rsi, 8(%rdi,%rdx,8)\n    incq %rdx\n    movq %rdx, (%rdi)\n"
    + "    movq %rdi, %rax\n    ret\n";
}

function hev_free(s: asmcore.EmitState, ptr: string, words: string): asmcore.EmitState {
  if (!hev_on(s)) {
    return s;
  }
  s = s.write("    pushq " + words + "\n");
  s = s.write("    pushq " + ptr + "\n");
  s = s.write("    call __fern_hev_f\n");
  s = s.write("    addq $16, %rsp\n");
  return s;
}

// .Lhev_w writes the %rdx bytes at %rsi to stderr, or to the `log` provider on
// a target without a host.
function emit_hev_write(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(".Lhev_w:\n");
  if (s.log_provider.len() == 0) {
    s = s.write("    movq $2, %rdi\n");
    s = s.write("    movq $1, %rax\n");
    s = s.syscall(1);
    return s.write("    ret\n");
  }
  return s.write("    pushq %rdx\n    pushq %rdx\n    pushq %rsi\n    call " + s.log_provider + "\n    addq $24, %rsp\n    ret\n");
}

