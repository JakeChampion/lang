  // __fern_arr_own_elems(dst@16(%rsp), src@8(%rsp)) -> dst: dst's first
  // len(src) elements alias src's, and each is replaced by the unit
  // __fern_str_own answers for it. %rbx/%r12/%r13 hold dst/len/i.
  if (s.has_need("arr_own_elems")) {
    s = s.write("__fn___fern_arr_own_elems:\n");
    s = s.write("    movq 16(%rsp), %rax\n");  // dst (also the result)
    s = s.write("    movq 8(%rsp), %rcx\n");  // src
    s = s.write("    cmpq $0x10000, %rax\n");
    s = s.write("    jb .Laoe_ret\n");
    s = s.write("    cmpq $0x10000, %rcx\n");
    s = s.write("    jb .Laoe_ret\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    movq %rax, %rbx\n");
    s = s.write("    movq (%rcx), %r12\n");  // len(src)
    s = s.write("    movq $0, %r13\n");
    s = s.write(".Laoe_loop:\n");
    s = s.write("    cmpq %r12, %r13\n");
    s = s.write("    jge .Laoe_done\n");
    s = s.write("    pushq 8(%rbx,%r13,8)\n");  // element i
    s = s.write("    call __fn___fern_str_own\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    movq %rax, 8(%rbx,%r13,8)\n");
    s = s.write("    incq %r13\n");
    s = s.write("    jmp .Laoe_loop\n");
    s = s.write(".Laoe_done:\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write(".Laoe_ret:\n");
    s = s.write("    ret\n");
