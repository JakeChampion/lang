  // place, else 0 with nothing written. In place needs a FUSED box at rc 1,
  // whose block __fern_str_free will return to the class it came from: the
  // grown block's words, ceil(len/8) + 3, still fit the capacity __fern_capw
  // or large_class gave the original, in the same tier. The heap trace sees
  // the growth as a free of the old size and an alloc of the new, so its
  // lines still pair by size; the leak census sees one block that grew, as
  // native's does: its live bytes move and its counts do not.
  // __fern_str_grow_range(a@32, s@24, lo@16, hi@8) appends s's bytes
  // [lo, hi) the same way, and answers 0 for a range outside s so the
  // caller's slice raises the bounds abort. Both entries hand the body the
  // source bytes in %rdx and their count in %rsi.
  if (s.has_need("str_grow")) {
    s = s.write("__fn___fern_str_grow:\n");
    s = s.write("    movq 16(%rsp), %r8\n");  // a
    s = s.write("    movq 8(%rsp), %rdx\n");  // b
    s = s.write("    movq 8(%rdx), %rsi\n");  // lb
    s = s.write("    movq (%rdx), %rdx\n");  // b's data
    s = s.write("    jmp .Lsg_body\n");
    s = s.write("__fn___fern_str_grow_range:\n");
    s = s.write("    movq 32(%rsp), %r8\n");  // a
    s = s.write("    movslq 16(%rsp), %rax\n");  // lo
    s = s.write("    movslq 8(%rsp), %rsi\n");  // hi
    s = s.write("    movq 24(%rsp), %rdx\n");  // s
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    js .Lsg_out\n");
    s = s.write("    cmpq 8(%rdx), %rsi\n");
    s = s.write("    jg .Lsg_out\n");
    s = s.write("    subq %rax, %rsi\n");  // lb
    s = s.write("    js .Lsg_out\n");
    s = s.write("    movq (%rdx), %rdx\n");
    s = s.write("    addq %rax, %rdx\n");  // s's data + lo
    s = s.write("    jmp .Lsg_body\n");
    s = s.write(".Lsg_out:\n");
    s = s.write("    xorl %eax, %eax\n");
    s = s.write("    ret\n");
    s = s.write(".Lsg_body:\n");
    s = s.write("    xorl %eax, %eax\n");
    s = s.write("    testb $1, %r8b\n");
    s = s.write("    jnz .Lsg_ret\n");
    s = s.write("    cmpq $0x10000, %r8\n");
    s = s.write("    jb .Lsg_ret\n");
    s = s.write("    movl -8(%r8), %ecx\n");  // rc
    s = s.write(san_poison_check("%ecx", s.rc_free_debug));
    s = s.write("    cmpl $1, %ecx\n");
    s = s.write("    jne .Lsg_ret\n");
    s = s.write("    movq 8(%r8), %rcx\n");  // la
    s = s.write("    leaq (%rcx,%rsi), %rdi\n");  // grown length
    s = s.write("    cmpq $0x7fffffff, %rdi\n");
    s = s.write("    ja .Lsg_ret\n");
    // A grown box takes the bytes while its capacity holds them; its block
    // does not move, so neither the trace nor the census sees anything.
    s = s.write("    cmpl $" + util.i32_to_string(grown_marker()) + ", -4(%r8)\n");
    s = s.write("    jne .Lsg_fused\n");
    s = s.write("    leaq 39(%rdi), %r10\n");
    s = s.write("    shrq $3, %r10\n");  // words grown, under the 32-byte header
    s = s.write("    cmpq -16(%r8), %r10\n");
    s = s.write("    ja .Lsg_ret\n");
    s = s.write("    jmp .Lsg_copy\n");
    s = s.write(".Lsg_fused:\n");
    s = s.write("    cmpl $" + util.i32_to_string(fused_marker()) + ", -4(%r8)\n");
    s = s.write("    jne .Lsg_ret\n");
    s = s.write("    leaq 31(%rcx), %r9\n");
    s = s.write("    shrq $3, %r9\n");  // words now
    s = s.write("    leaq 31(%rdi), %r10\n");
    s = s.write("    shrq $3, %r10\n");  // words grown
    s = s.write("    cmpq %r9, %r10\n");
    s = s.write("    je .Lsg_copy\n");
    s = s.write("    cmpq $65536, %r9\n");
    s = s.write("    jae .Lsg_large\n");
    s = s.write("    pushq %r9\n");
    s = s.write("    call __fern_capw\n");
    s = s.write("    popq %r11\n");  // capacity, in words
    s = s.write("    cmpq %r11, %r10\n");
    s = s.write("    ja .Lsg_ret\n");
    s = s.write("    jmp .Lsg_fits\n");
    s = s.write(".Lsg_large:\n");
    s = s.write("    cmpq $0x8000000, %r10\n");  // past 1 GiB the block is exact
    s = s.write("    ja .Lsg_ret\n");
    s = s.write("    leaq 0(,%r9,8), %rax\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    pushq %rdx\n");
    s = large_class(s);
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    shrq $3, %rax\n");  // capacity, in words
    s = s.write("    cmpq %rax, %r10\n");
    s = s.write("    movl $0, %eax\n");
    s = s.write("    ja .Lsg_ret\n");
    s = s.write(".Lsg_fits:\n");
