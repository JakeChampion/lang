    // string shorter than one block.
    s = s.write(l_tail + ":\n");
    s = s.write("    cmpq %r8, %rdx\n    jge " + l_none + "\n");
    s = s.write("    movzbq (%rax,%rdx), %r9\n");
    s = s.write("    cmpq %rcx, %r9\n    je " + l_done + "\n");
    s = s.write("    addq $1, %rdx\n    jmp " + l_tail + "\n");
