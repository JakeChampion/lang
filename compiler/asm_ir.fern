    s = s.write(r_avx + ":\n");
    s = s.write("    vpcmpeqb (%r9), %ymm1, %ymm0\n");
    s = s.write("    vpmovmskb %ymm0, %r11d\n    testl %r11d, %r11d\n    jnz " + r_hit32 + "\n");
