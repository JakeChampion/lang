// Symbolic register words shared by the allocation and constructor proof machines.
pub struct Half { kind: i32, identity: i64, high: boolean }

pub struct Word { low: Half, high: Half }

pub function half(kind: i32, identity: i64, high: boolean): Half {
  return Half { kind: kind, identity: identity, high: high };
}

pub function token(kind: i32, identity: i64): Word {
  return Word { low: half(kind, identity, false), high: half(kind, identity, true) };
}

pub function number(n: i64): Word {
  let low = n % 4294967296;
  return Word { low: half(0, if (low < 0) { low + 4294967296 } else { low }, false), high: half(0, if (n < 0) { 4294967295 } else { n / 4294967296 }, false) };
}

pub function same(a: Half, b: Half): boolean {
  return a.kind == b.kind && a.identity == b.identity && a.high == b.high;
}

pub function equal(a: Word, b: Word): boolean {
  return same(a.low, b.low) && same(a.high, b.high);
}

pub function narrowed(w: Word, width: i32): Word {
  return if (width == 32) { Word { ...w, high: number(0).high } } else { w };
}

pub function unsigned(w: Word): boolean {
  return w.low.kind == 0 && same(w.high, number(0).high);
}

// choice is 1 after the test for a block that crosses a 64 KiB line and 2
// after the test of the coloured pointer against the end of the heap. The
// branch on such a test can go each way, and each way must finish.
pub struct State { regs: Word[], memory: Half[], writes: i32[], zero: i32, carry: i32, sign: i32, overflow: i32, bounded: boolean, choice: i32, mappings: i32, advised: boolean, calls: i32, successor: i32, ok: boolean }

pub function initial_state(regs: Word[], memory: Half[], writes: i32[]): State {
  return State { regs: regs, memory: memory, writes: writes, zero: -1, carry: -1, sign: -1, overflow: -1, bounded: false, choice: 0, mappings: 0, advised: false, calls: 0, successor: -1, ok: true };
}

pub function write(s: State, reg: i32, value: Word): State {
  return State { ...s, regs: s.regs.with(reg, value) };
}

pub function load(s: State, at: i32, width: i32): Word {
  return Word { low: s.memory[at], high: if (width == 64) { s.memory[at + 1] } else { number(0).high } };
}
