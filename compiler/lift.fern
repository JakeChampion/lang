// compiler/lift.fern — the AST-to-AST lambda lift (lift_lambdas,
// lift_lambdas_typed, lift_lambdas_view), which the typed path runs first: it
// hoists lambdas, closures and value IIFEs into module functions and boxes the
// captures they need.

import "./ast";
import "./parser";
import "./util";
import "./astwalk";
import "./decltypes";
import "./lexical";
import "./checker";
import "./typeinfo";
import "./callsubst";
import "./capturebox";
import "./irtables";

// RECLAIM CREDITS ARE KEYED ON THE BINDING SITE, NOT THE NAME (#7253).
//
// There used to be a `reclaim_slot_name` here: a slot's source name with any
// "!retired!" prefix stripped, so a credit collected from the AST could be
// looked up per slot. Every family now resolves `reclaim_site_key` instead
// (`slot_credit_at`), the key being "name@line:col" recorded on the slot by
// whichever path bound it, so it survives retire_locals' rename by itself and
// two same-named bindings never share a verdict. The function is gone because
// nothing reads it.
//
// Why the name key had to go, since the answer is not tidiness. It handed a
// credited local's verdict to any same-named sibling — and, because a lookup
// only compares spellings, to any BINDER that shared the spelling without being
// a declaration at all (a for-in element, a match payload, a destructure key).
// The severity of that is not a property of the class: it depends on whether the
// aliased source has another owner. Where the class also LEAKS, the stray
// release lands on a box nothing else claimed, no counter reports it, and the
// census reads better than the correct program's — so the class looks benign
// and becomes a double free the moment someone fixes the leak. Where the source
// is released elsewhere it faults immediately. Both halves were measured across
// the struct (#7349) and Option (#7356) families.
//
// What that history is worth keeping. Each class was admitted to the sweep on
// its own probe rather than by a blanket flip, because switching one on turns on
// an exit-sweep release that had never run for those slots; the byte counts each
// flip closed were ARRARR / ARRARRS 7200, OPTAARR 12000, TUPRC / TUPRCS 8000,
// SARR 4800, STRUCTARR(A) 9600. "TUPRC:" needed BOTH its credits switched —
// "TUPRC:" drives the rebind and "TUPRCS:" (#6251) the exit sweep — and flipping
// only the first left the shape at exactly its unfixed 8000.
//
// Three disjointness rules outlived the migration and are enforced at the
// predicates rather than here:
//
//   - "OPTARR:"'s consuming-match analysis is per-block (#4357) and frees the
//     value before the block ends, so a sweep claim on that half would be a
//     second release. The no-match half is what carries the sweep credit.
//   - "RCENUM:" is the same case one type over: the match-consumed half must
//     not be swept, so #6606 credited the no-match half separately as
//     "RCENUMS:" instead of widening "RCENUM:". The two are appended against ONE
//     entry, so they cannot end up keyed differently; the exact-vs-retired
//     distinction between them is written out in slot_is_reclaimable_rcenum.
//   - "SCENUMS:" is held disjoint from the dyn credit at the predicate, because
//     `let d: dyn Show = Add(41)` satisfies both classifiers and letting both
//     claim it was an over-release rather than a leak.
//
// One warning survives in full. The bare-name struct credit
// (slot_is_reclaimable_struct) feeds the deep field drop, the precise drop and
// the reuse-donor paths, not just the exit sweep, and granting it for
// block-scoped slots SEGFAULTS the gen1 self-compile — a failure
// `internal/testing/e2ecompiler` cannot reach and the per-module fixpoint can. That is
// why its retirement refusal is spelled out explicitly rather than inherited
// from a lookup that happened to miss.

// split_type_list splits a comma-separated list of type spellings at DEPTH-ZERO
// commas only, so a tuple or generic argument list keeps its own — `(i32,i32),T`
// is two types, not three. split_commas next door is the flat version and would
// count a tuple parameter twice, which for a funcref signature means emitting
// one type char too many and dispatching through a type of the wrong arity.
function split_type_list(csv: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i <= csv.len()) {
    if (i == csv.len() || csv[i] == b',' && depth == 0) {
      out = out.append(slice_unchecked(csv, start, i) + "");
      start = i + 1;
    } else if (csv[i] == b'(' || csv[i] == b'[') {
      depth = depth + 1;
    } else if (csv[i] == b')' || csv[i] == b']') {
      depth = depth - 1;
    }
    i = i + 1;
  }
  return out;
}

// Shared declaration metadata for source signatures and checked binding types.
function fn_param_decl(name: string, tys: string[], ret: string): ast.ParamDecl {
  return decltypes.fn_param_decl(name, tys, ret);
}

// fn_param_from_func recovers a fn value's signature from the FuncDecl it
// targets, skipping `skip` leading params — 1 for a hoisted closure body, whose
// first param is the env box.
// A consuming parameter spells its `own`, so the signature keeps the slots the
// body consumes.
pub function fn_param_from_func(name: string, f: parser.FuncDecl, skip: i32): ast.ParamDecl {
  let tys: string[] = [];
  let i: i32 = skip;
  while (i < f.params.len()) {
    let ty: string = nested_fn_spelling(f.params[i].type_name, f.params[i].fn_ret, f.params[i].fn_param_types);
    if (f.params[i].own) {
      ty = "own " + ty;
    }
    tys = tys.append(ty);
    i = i + 1;
  }
  return fn_param_decl(name, tys, nested_fn_spelling(f.ret_type, f.ret_fn_ret, f.ret_fn_param_types));
}

// nested_fn_spelling spells a coarse `fn` tag out from its sidecars, grouped so
// it can stand as a parameter or result of another function type.
function nested_fn_spelling(tag: string, fn_ret: string, fn_ptys: string): string {
  if (tag != "fn" || fn_ret.len() == 0) {
    return tag;
  }
  return "(" + parser.fn_tag_spelling(tag, fn_ret, fn_ptys) + ")";
}

// fn_spelling_of renders a fn-typed ParamDecl's signature as the source
// spelling `(P0,P1) => R` — the inverse of fn_param_from_spelling, and the form
// a fn-typed LOCAL carries in its `type_name` (the flat "fn" tag is a PARAM
// spelling only, with the signature held in the sidecars).
pub function fn_spelling_of(p: ast.ParamDecl): string {
  return "(" + p.fn_param_types + ") => " + p.fn_ret;
}

// fn_local_spelling_for names the `(P) => R` type of a fn-valued local whose
// initialiser the lift has replaced with a `__mkclo$<target>` env-box
// constructor. The box carries no signature, so an UNANNOTATED binding — which
// is what a nested `function lf(x: i64): boolean { … }` declaration desugars to
// — would otherwise lose it, leaving the lowering no signature to read
// (#6862). "" when the binding is not that shape or already spells its type out.
//
// The hoisted target's params are `__env` followed by the lambda's own, so its
// signature after that first param is the fn value's.
function fn_local_spelling_for(v: ast.StmtVar, funcs: parser.FuncDecl[]): string {
  if (fn_param_from_spelling("", v.type_name).type_name == "fn") {
    return "";
  }
  match (v.init) {
    ast.ExprCall(mk) => {
      match (mk.callee) {
        ast.ExprIdent(mkid) => {
          if (mkid.name.len() <= 8 || slice_unchecked(mkid.name, 0, 8) != "__mkclo$") {
            return "";
          }
          let tgt: string = slice_unchecked(mkid.name, 8, mkid.name.len()) + "";
          for fn in funcs {
            if (fn.name == tgt) {
              let p: ast.ParamDecl = fn_param_from_func(v.name, fn, 1);
              if (p.type_name != "fn") {
                return "";
              }
              return fn_spelling_of(p);
            }
          }
          return "";
        },
        _ => {
          return "";
        }
      }
      return "";
    },
    _ => {
      return "";
    }
  }
  return "";
}

// stamp_fn_local_types writes that spelling onto every such binding across the
// lifted module.
//
// It runs after lifting so every env-box marker can resolve its hoisted
// target. Capture types themselves come from the checked lambda contract.
function stamp_fn_local_types(funcs: parser.FuncDecl[]): parser.FuncDecl[] {
  let out: parser.FuncDecl[] = [];
  for fn in funcs {
    out = out.append(parser.FuncDecl { ...fn, body: stamp_fn_local_types_stmts(fn.body, funcs) });
  }
  return out;
}

function stamp_fn_local_types_stmts(body: ast.Stmt[], funcs: parser.FuncDecl[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < body.len()) {
    match (body[i]) {
      ast.StmtVar(v) => {
        let sp: string = fn_local_spelling_for(v, funcs);
        if (sp.len() > 0) {
          out = out.append(ast.StmtVar { ...v, type_name: sp });
        } else {
          out = out.append(body[i]);
        }
      },
      ast.StmtIf(f) => {
        out = out.append(ast.StmtIf { ...f, then_body: stamp_fn_local_types_stmts(f.then_body, funcs), else_body: stamp_fn_local_types_stmts(f.else_body, funcs) });
      },
      ast.StmtWhile(w) => {
        out = out.append(ast.StmtWhile { ...w, body: stamp_fn_local_types_stmts(w.body, funcs) });
      },
      ast.StmtFor(fr) => {
        out = out.append(ast.StmtFor { ...fr, body: stamp_fn_local_types_stmts(fr.body, funcs) });
      },
      ast.StmtMatch(m) => {
        let na: ast.MatchArm[] = [];
        for arm in m.arms {
          na = na.append(ast.MatchArm { ...arm, body: stamp_fn_local_types_stmts(arm.body, funcs) });
        }
        out = out.append(ast.StmtMatch { ...m, arms: na });
      },
      _ => {
        out = out.append(body[i]);
      }
    }
    i = i + 1;
  }
  return out;
}

pub function fn_param_from_spelling(name: string, sp: string): ast.ParamDecl {
  return decltypes.fn_param_from_spelling(name, sp);
}

// --- Lambda lifting (closures slice 2a: no-capture lambdas as call arguments) ---
//
// lift_lambdas rewrites a module so that a no-capture lambda passed directly as
// a call argument is hoisted to a fresh top-level function (__lam_<k>) and the
// argument becomes a bare reference to it. That bare reference, at a "fn"-typed
// param position, is exactly the function VALUE that closures slice 1 lowers via
// const_func — so capture-free lambdas-as-callbacks use the slice-1 machinery
// with no new IR ops. Capturing lambdas (and lambdas in positions this bounded
// walk doesn't reach) are left as ExprLambda, so the module bails. A module
// with no lifted lambda is returned UNCHANGED (so the
// lambda-free fixpoint is byte-identical).

pub struct LiftAcc { funcs: parser.FuncDecl[], counter: i32 }

struct LiftExpr { expr: ast.Expr, acc: LiftAcc }

struct LiftStmts { stmts: ast.Stmt[], acc: LiftAcc }

// lift_call_arg lifts one call argument: a no-capture lambda becomes __lam_<k>
// and the argument a bare reference to it; any other argument recurses (so a
// lambda nested inside a call argument is still reached).
function lift_call_arg(e: ast.Expr, acc: LiftAcc, gfns: string[]): LiftExpr {
  match (e) {
    ast.ExprLambda(lam) => {
      if (irtables.lambda_has_no_captures(lam, gfns)) {
        let nm: string = "__lam_" + util.i32_to_string(acc.counter);
        let tp: string[] = [];
        let nf: parser.FuncDecl = parser.FuncDecl { stdlib: "", no_inline: false, name: nm, receiver_name: "", receiver_type: "", receiver_own: false, type_params: tp, params: lam.params, ret_type: lam.ret_type, body: lam.body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: lam.ret_fn_ret, ret_fn_param_types: lam.ret_fn_param_types, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] };
        let nacc: LiftAcc = LiftAcc { funcs: acc.funcs.append(nf), counter: acc.counter + 1 };
        return LiftExpr { expr: ast.ExprIdent { name: nm, line: 0, col: 0, ty: "" }, acc: nacc };
      }
      // Capturing: keep the lambda, but walk its body so nested lambdas
      // are still lifted.
      return lift_lambda_body_only(lam, acc, gfns);
    },
    _ => {
      return lift_expr_walk(e, acc, gfns);
    }
  }
  return LiftExpr { expr: e, acc: acc };
}

// lift_call_callee lifts a call's CALLEE, hoisting it as lift_call_arg does
// except for a value-position desugar's IIFE, which the lowering inlines: its
// statements run in the enclosing function, so a `return` in one leaves that
// function, and hoisting it would make the `return` leave the hoisted body
// instead (#10818). Its body is still walked, so a user lambda nested in the
// desugar is lifted either way.
function lift_call_callee(c: ast.ExprCall, acc: LiftAcc, gfns: string[]): LiftExpr {
  if (parser.is_value_block(c)) {
    match (c.callee) {
      ast.ExprLambda(lam) => {
        return lift_lambda_body_only(lam, acc, gfns);
      },
      _ => {
        return LiftExpr { expr: c.callee, acc: acc };
      }
    }
  }
  return lift_call_arg(c.callee, acc, gfns);
}

// lift_capturing_iife hoists a hand-written, immediately called capturing lambda
// to `__lam_N(params…, captures…)` and calls it with the written arguments and
// then the captured names, the direct-call lift try_lift_binding gives a bound
// lambda that is only called. A hand-written IIFE is a call with a scope of its
// own (parser.is_value_block_origin), so its `return` leaves the lambda, not the
// enclosing function. Declines, with the counter unchanged, when a capture's
// type is not in hand.
function lift_capturing_iife(c: ast.ExprCall, lam: ast.ExprLambda, acc: LiftAcc, gfns: string[]): LiftExpr {
  let declined: LiftExpr = LiftExpr { expr: ast.ExprCall { ...c }, acc: acc };
  if (lam.captures.len() == 0) {
    return declined;
  }
  let params: ast.ParamDecl[] = [];
  for lp in lam.params {
    params = params.append(lp);
  }
  let capargs: ast.Expr[] = [];
  for cap in lam.captures {
    let cp: ast.ParamDecl = lambda_capture_param(lam, cap.name);
    if (cp.type_name.len() == 0) {
      return declined;
    }
    params = params.append(ast.ParamDecl { ...cp, own: false, has_default: false, default_value: parser.e_unknown("") });
    capargs = capargs.append(ast.ExprIdent { name: cap.name, line: 0, col: 0, ty: "" });
  }
  let nm: string = "__lam_" + util.i32_to_string(acc.counter);
  let nf: parser.FuncDecl = parser.FuncDecl { stdlib: "", no_inline: false, name: nm, receiver_name: "", receiver_type: "", receiver_own: false, type_params: [], params: params, ret_type: lam.ret_type, body: lam.body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: lam.ret_fn_ret, ret_fn_param_types: lam.ret_fn_param_types, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] };
  let a: LiftAcc = LiftAcc { funcs: acc.funcs.append(nf), counter: acc.counter + 1 };
  let nargs: ast.Expr[] = [];
  for arg in c.args {
    let r: LiftExpr = lift_call_arg(arg, a, gfns);
    a = r.acc;
    nargs = nargs.append(r.expr);
  }
  for ca in capargs {
    nargs = nargs.append(ca);
  }
  return LiftExpr { expr: ast.ExprCall { callee: ast.ExprIdent { name: nm, line: c.line, col: c.col, ty: "" }, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, acc: a };
}

// lift_lambda_body_only walks a lambda's body for lifts and returns the lambda
// itself unchanged in shape — never hoisted to a top-level `__lam_N`.
function lift_lambda_body_only(lam: ast.ExprLambda, acc: LiftAcc, gfns: string[]): LiftExpr {
  let ba: LiftAcc = acc;
  let nb: ast.Stmt[] = [];
  let bi: i32 = 0;
  while (bi < lam.body.len()) {
    let br: LiftStmts = lift_stmt(lam.body[bi], ba, gfns);
    ba = br.acc;
    let bj: i32 = 0;
    while (bj < br.stmts.len()) {
      nb = nb.append(br.stmts[bj]);
      bj = bj + 1;
    }
    bi = bi + 1;
  }
  return LiftExpr { expr: ast.ExprLambda { ...lam, body: nb }, acc: ba };
}

// lift_expr_walk recurses through the expression forms that commonly hold calls,
// rewriting lambda arguments. Unhandled forms pass through unchanged.
function lift_expr_walk(e: ast.Expr, acc: LiftAcc, gfns: string[]): LiftExpr {
  match (e) {
    ast.ExprCall(c) => {
      let a: LiftAcc = acc;
      // Lift the CALLEE too: a no-capture lambda in call position — an IIFE
      // `((b) => {...})(args)` — hoists to a bare `__lam_N` fn-name, so
      // the call becomes a direct `__lam_N(args)`. lift_call_arg recurses for
      // a non-lambda callee (ident / `mk()` / etc.), leaving it unchanged, so
      // a normal call's numbering is untouched (an ident callee consumes no
      // counter). A capturing hand-written one hoists with its captures
      // as trailing parameters (lift_capturing_iife).
      if let ast.ExprLambda(clam) = c.callee {
        if (!parser.is_value_block_origin(clam.origin) && !irtables.lambda_has_no_captures(clam, gfns)) {
          let hoisted: LiftExpr = lift_capturing_iife(c, clam, a, gfns);
          if (hoisted.acc.counter > a.counter) {
            return hoisted;
          }
        }
      }
      let ce: LiftExpr = lift_call_callee(c, a, gfns);
      a = ce.acc;
      let nargs: ast.Expr[] = [];
      for arg in c.args {
        let r: LiftExpr = lift_call_arg(arg, a, gfns);
        a = r.acc;
        nargs = nargs.append(r.expr);
      }
      return LiftExpr { expr: ast.ExprCall { callee: ce.expr, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, acc: a };
    },
    ast.ExprTuple(tu) => {
      // A no-capture lambda in a TUPLE-element position (`((x) => {...}, 10)`)
      // hoists the same way — lift_call_arg turns it into a bare `__lam_N` fn-name
      // (which lowers to a fn pointer), so `t.0(t.1)` uses the existing
      // tuple-element fn-value call_indirect path. A capturing lambda element is
      // left in place (stays on AST).
      let ta: LiftAcc = acc;
      let nte: ast.Expr[] = [];
      let ti: i32 = 0;
      while (ti < tu.elements.len()) {
        let ter: LiftExpr = lift_call_arg(tu.elements[ti], ta, gfns);
        ta = ter.acc;
        nte = nte.append(ter.expr);
        ti = ti + 1;
      }
      return LiftExpr { expr: ast.ExprTuple { elements: nte, line: tu.line, col: tu.col }, acc: ta };
    },
    ast.ExprArray(arr) => {
      // An array literal: each element goes through lift_call_arg, which
      // hoists a no-capture lambda and recurses into anything else. A
      // function array's elements are already boxes by now, since
      // lift_inline_closures runs first.
      let aa: LiftAcc = acc;
      let nelems: ast.Expr[] = [];
      let ei: i32 = 0;
      while (ei < arr.elements.len()) {
        let er: LiftExpr = lift_call_arg(arr.elements[ei], aa, gfns);
        aa = er.acc;
        nelems = nelems.append(er.expr);
        ei = ei + 1;
      }
      return LiftExpr { expr: ast.ExprArray { ...arr, elements: nelems }, acc: aa };
    },
    ast.ExprStructLit(sl) => {
      // A no-capture lambda in a STRUCT-FIELD value position (`Box { f:
      // (x) => {...} }`) hoists the same way — lift_call_arg turns it into
      // a bare `__lam_N` fn-name (which lowers to const_func, like `Box { f:
      // inc }`). A capturing lambda field is left in place (stays on AST).
      let sa: LiftAcc = acc;
      let nvals: ast.Expr[] = [];
      for fv in sl.field_values {
        let vr: LiftExpr = lift_call_arg(fv, sa, gfns);
        sa = vr.acc;
        nvals = nvals.append(vr.expr);
      }
      let nbase: ast.Expr = sl.base;
      if (sl.has_base) {
        let br: LiftExpr = lift_expr_walk(sl.base, sa, gfns);
        sa = br.acc;
        nbase = br.expr;
      }
      return LiftExpr { expr: ast.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nvals, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col, written: sl.written }, acc: sa };
    },
    ast.ExprBinary(b) => {
      // Recurse into the compound expression forms so a no-capture lambda CALL
      // nested inside them is still hoisted: `((x) => {...})(5) + 1` (binary),
      // `0 - (() => {...})()` (unary), `a[(() => {...})()]` (index). The
      // operands rarely hold a BARE lambda (that wouldn't type-check), so these
      // recurse via lift_expr_walk (which lifts an IIFE callee / a lambda call
      // argument inside), not lift_call_arg. An operand with nothing to lift is
      // rebuilt identically (the counter is untouched), so existing programs are
      // unchanged.
      let blr: LiftExpr = lift_expr_walk(b.left, acc, gfns);
      let brr: LiftExpr = lift_expr_walk(b.right, blr.acc, gfns);
      return LiftExpr { expr: ast.ExprBinary { op: b.op, left: blr.expr, right: brr.expr, line: b.line, col: b.col, ty: b.ty }, acc: brr.acc };
    },
    ast.ExprUnary(u) => {
      let uor: LiftExpr = lift_expr_walk(u.operand, acc, gfns);
      return LiftExpr { expr: ast.ExprUnary { op: u.op, operand: uor.expr, line: u.line, col: u.col, ty: u.ty }, acc: uor.acc };
    },
    ast.ExprIndex(ix) => {
      let ixar: LiftExpr = lift_expr_walk(ix.array, acc, gfns);
      let ixir: LiftExpr = lift_expr_walk(ix.index, ixar.acc, gfns);
      return LiftExpr { expr: ast.ExprIndex { array: ixar.expr, index: ixir.expr, unchecked: ix.unchecked, ty: ix.ty, line: ix.line, col: ix.col }, acc: ixir.acc };
    },
    ast.ExprSlice(sl) => {
      // Slice bounds + the field-access object can also hold a nested lambda CALL
      // (`a[(iife)(0) : 3]`, `arr[(iife)(0)].v`); recurse so it is hoisted too.
      let slar: LiftExpr = lift_expr_walk(sl.array, acc, gfns);
      let slsr: LiftExpr = lift_expr_walk(sl.start, slar.acc, gfns);
      let sler: LiftExpr = lift_expr_walk(sl.end, slsr.acc, gfns);
      return LiftExpr { expr: ast.ExprSlice { ...sl, array: slar.expr, start: slsr.expr, end: sler.expr }, acc: sler.acc };
    },
    ast.ExprFieldAccess(fa) => {
      let faor: LiftExpr = lift_expr_walk(fa.obj, acc, gfns);
      return LiftExpr { expr: ast.ExprFieldAccess { obj: faor.expr, field: fa.field, line: fa.line, col: fa.col, ty: fa.ty }, acc: faor.acc };
    },
    _ => {
      return LiftExpr { expr: e, acc: acc };
    }
  }
  return LiftExpr { expr: e, acc: acc };
}

// desugar_lambda_returns rewrites every `return <lambda>` in `body` (capturing OR
// not, at any depth — inside if/while/for blocks and match arms) to a two-statement
// `let $lamret$N = <lambda>; return $lamret$N;`. Run as a per-function PRE-pass
// (before every closure/lift pass), so the returned lambda is treated exactly like a
// hand-written closure local: box_mutated_scalar_captures + lift_inline_closures give
// it a UNIQUE `<fd>$cloN` name and the env-first make_closure box, and the caller's
// `let g = f()` binds g a closure local so `g()`
// dispatches env-first. This replaces the old inline-return handling — no-capture
// returns hoisted to a bare `__lam_N` fn-value the caller called env-first (SIGSEGV),
// and capturing returns hoisted to a bare `<fd>$clo` that COLLIDED across multiple
// returns (the wrong closure body ran) or bailed the whole module (#5266). `$lamret$N` names are function-local slots (the `$` prefix can't collide
// with user idents); the counter is function-local. The self-host sources contain no
// bare lambda returns, so this fires on none of them and leaves the self-compile
// byte-identical.
struct DesugarRet { body: ast.Stmt[], counter: i32 }

// RetSig is a declaration's return signature as the parser spells it: the
// coarse tag plus the sidecars a callable result carries. It is what the
// `$lamret$N` slot is declared as, so the checker types the slot the way it
// types a `let f: (P) => R` local, and the lambda bound to it gets the
// result type the signature names when it spells none of its own.
struct RetSig { tag: string, fn_ret: string, fn_ptys: string }

function ret_sig_of(tag: string, fn_ret: string, fn_ptys: string): RetSig {
  if (!parser.is_coarse_fn_tag(tag) || fn_ret.len() == 0) {
    return RetSig { tag: "", fn_ret: "", fn_ptys: "" };
  }
  return RetSig { tag: tag, fn_ret: fn_ret, fn_ptys: fn_ptys };
}

function lamret_slot(rn: string, value: ast.Expr, sig: RetSig, line: i32, col: i32): ast.Stmt {
  let init: ast.Expr = value;
  if let ast.ExprLambda(lm) = value {
    if (lm.ret_type.len() == 0 && sig.fn_ret.len() > 0 && !parser.is_coarse_fn_tag(sig.fn_ret)) {
      init = ast.ExprLambda { ...lm, ret_type: sig.fn_ret };
    }
  }
  return ast.StmtVar { name: rn, type_name: sig.tag, init: init, line: line, col: col, fn_ret: sig.fn_ret, fn_param_types: sig.fn_ptys };
}

// contract_spelling is how returned_fn_contract names one type. It goes
// through fn_tag_spelling because a parameter or result that is ITSELF callable
// carries the same coarse tag with its own sidecars beside it. Recording the
// bare tag rebuilds `(fn) => R` — a contract that LIES, which is worse than one
// that is missing, so a tag left coarse yields no contract at all.
function contract_spelling(tag: string, fn_ret: string, fn_ptys: string): string {
  if (tag.len() == 0) {
    return "";
  }
  let spelled: string = parser.fn_tag_spelling(tag, fn_ret, fn_ptys);
  if (parser.is_coarse_fn_tag(spelled)) {
    return "";
  }
  return spelled;
}

// returned_fn_contract reads the #5986 sidecar pair off the first function
// value a body RETURNS, walking the same branch shapes desugar_lambda_returns
// rewrites: an inline lambda, a bare module function name (read off its
// declaration unless `shadowed` names a local of that spelling), or a nested
// value-position if/match whose own arms answer.
//
// hoist_value_iife declares its hoisted function with the coarse "fn" tag and
// needs the pair that tag drops. A lambda the source wrote INSIDE an
// if/match-expression arm never had one to give: e_lambda_origin builds the
// IIFE and writes the pair empty, so the declaration reached semsource with a
// tag and no contract and was refused for an unresolved result type.
function returned_fn_contract(body: ast.Stmt[], shadowed: string[], mfuncs: MFuncs): (string, string) {
  let i: i32 = 0;
  while (i < body.len()) {
    match (body[i]) {
      ast.StmtReturn(r) => {
        let (vr, vp, found) = value_fn_contract(r.value, shadowed, mfuncs);
        if (found) {
          return (vr, vp);
        }
      },
      ast.StmtIf(f) => {
        let (tr, tp) = returned_fn_contract(f.then_body, shadowed, mfuncs);
        if (tr.len() > 0) {
          return (tr, tp);
        }
        let (er, ep) = returned_fn_contract(f.else_body, shadowed, mfuncs);
        if (er.len() > 0) {
          return (er, ep);
        }
      },
      ast.StmtMatch(m) => {
        let a: i32 = 0;
        while (a < m.arms.len()) {
          let (mr, mp) = returned_fn_contract(m.arms[a].body, shadowed, mfuncs);
          if (mr.len() > 0) {
            return (mr, mp);
          }
          a = a + 1;
        }
      },
      ast.StmtWhile(w) => {
        let (wr, wp) = returned_fn_contract(w.body, shadowed, mfuncs);
        if (wr.len() > 0) {
          return (wr, wp);
        }
      },
      ast.StmtFor(fo) => {
        let (fr, fp) = returned_fn_contract(fo.body, shadowed, mfuncs);
        if (fr.len() > 0) {
          return (fr, fp);
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return ("", "");
}

// value_fn_contract is returned_fn_contract for one returned value. `found` is
// false for a value that names no contract, so the walk moves on to the next
// arm; a function value whose contract does not spell ends the walk empty.
function value_fn_contract(v: ast.Expr, shadowed: string[], mfuncs: MFuncs): (string, string, boolean) {
  match (v) {
    ast.ExprLambda(lm) => {
      let (lr, lp) = params_fn_contract(lm.params, contract_spelling(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types));
      return (lr, lp, true);
    },
    ast.ExprIdent(id) => {
      if (util.index_of_str(shadowed, id.name) >= 0) {
        return ("", "", false);
      }
      for d in mfuncs.decls {
        if (d.name == id.name && d.receiver_type.len() == 0 && !d.is_const) {
          let (dr, dp) = params_fn_contract(d.params, contract_spelling(d.ret_type, d.ret_fn_ret, d.ret_fn_param_types));
          return (dr, dp, true);
        }
      }
    },
    ast.ExprCall(c) => {
      if let ast.ExprLambda(il) = c.callee {
        if (c.args.len() == 0 && il.params.len() == 0) {
          let (nr, np) = returned_fn_contract(il.body, shadowed, mfuncs);
          return (nr, np, nr.len() > 0);
        }
      }
    },
    _ => {}
  }
  return ("", "", false);
}

// A consuming parameter spells `own`, as the `$wrap` trampoline mirrors it.
function params_fn_contract(params: ast.ParamDecl[], res: string): (string, string) {
  if (res.len() == 0) {
    return ("", "");
  }
  let ptys: string = "";
  let k: i32 = 0;
  while (k < params.len()) {
    let pt: string = contract_spelling(params[k].type_name, params[k].fn_ret, params[k].fn_param_types);
    if (pt.len() == 0) {
      return ("", "");
    }
    if (params[k].own && !parser.spelling_is_own(pt)) {
      pt = "own " + pt;
    }
    if (k > 0) {
      ptys = ptys + ",";
    }
    ptys = ptys + pt;
    k = k + 1;
  }
  return (res, ptys);
}

function desugar_lambda_returns(body: ast.Stmt[], counter: i32, sig: RetSig): DesugarRet {
  let out: ast.Stmt[] = [];
  let c: i32 = counter;
  let i: i32 = 0;
  while (i < body.len()) {
    match (body[i]) {
      ast.StmtReturn(r) => {
        let islam: boolean = false;
        match (r.value) {
          ast.ExprLambda(_) => {
            islam = true;
          },
          _ => {}
        }
        if (islam) {
          let rn: string = "$lamret$" + util.i32_to_string(c);
          c = c + 1;
          out = out.append(lamret_slot(rn, r.value, sig, r.line, r.col));
          out = out.append(ast.StmtReturn { value: ast.ExprIdent { name: rn, line: r.line, col: r.col, ty: "" }, line: r.line, col: r.col });
        } else {
          out = out.append(body[i]);
        }
      },
      ast.StmtIf(f) => {
        let td: DesugarRet = desugar_lambda_returns(f.then_body, c, sig);
        c = td.counter;
        let ed: DesugarRet = desugar_lambda_returns(f.else_body, c, sig);
        c = ed.counter;
        out = out.append(ast.StmtIf { ...f, cond: f.cond, then_body: td.body, else_body: ed.body });
      },
      ast.StmtWhile(w) => {
        let wd: DesugarRet = desugar_lambda_returns(w.body, c, sig);
        c = wd.counter;
        out = out.append(ast.StmtWhile { cond: w.cond, body: wd.body, label: w.label, line: 0, is_loop: w.is_loop });
      },
      ast.StmtFor(fo) => {
        let fod: DesugarRet = desugar_lambda_returns(fo.body, c, sig);
        c = fod.counter;
        out = out.append(ast.StmtFor { var_name: fo.var_name, iter: fo.iter, body: fod.body, label: fo.label, line: 0 });
      },
      ast.StmtMatch(m) => {
        let narms: ast.MatchArm[] = [];
        for arm in m.arms {
          let ad: DesugarRet = desugar_lambda_returns(arm.body, c, sig);
          c = ad.counter;
          narms = narms.append(ast.MatchArm { pattern: arm.pattern, body: ad.body, line: arm.line, col: arm.col, guard: arm.guard, has_guard: arm.has_guard, alt_cont: false });
        }
        out = out.append(ast.StmtMatch { ...m, scrutinee: m.scrutinee, arms: narms });
      },
      _ => {
        out = out.append(body[i]);
      }
    }
    i = i + 1;
  }
  return DesugarRet { body: out, counter: c };
}

function desugar_lifted_lambda_returns(fd: parser.FuncDecl): parser.FuncDecl {
  let sig: RetSig = ret_sig_of(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types);
  let ldr: DesugarRet = desugar_lambda_returns(fd.body, 0, sig);
  if (ldr.counter == 0) {
    return fd;
  }
  return parser.FuncDecl { ...fd, body: ldr.body };
}

// lift_stmt rewrites a single statement, recursing into nested bodies + the
// call-bearing expression positions (return / var-init / expr-stmt / control
// conditions). Other statements pass through.
//
// NOTE: each rebuilt statement is bound to a `let ns: ast.Stmt` before being
// placed in the returned `[ns]` array. Constructing the variant INLINE in the
// array literal (`stmts: [ast.StmtReturn { … }]`) used to read back corrupt:
// the checker did not propagate the Stmt-union element type into an array
// literal in a struct-field position, so the inline variant lowered WITHOUT its
// discriminant tag and the whole lifted module silently bailed IR eligibility to
// AST. That checker bug is now fixed (internal/check/checker StructLit field
// setElemHintFor; e2e TestInlineEnumVariantInStructArrayField); the typed `let`
// binding is retained as a robust, self-documenting way to express the move.
function lift_stmt(st: ast.Stmt, acc: LiftAcc, gfns: string[]): LiftStmts {
  match (st) {
    ast.StmtReturn(r) => {
      // `return (x) => {...}` of a NO-CAPTURE lambda hoists to a
      // top-level `__lam_N` (via lift_call_arg, the same lift a no-capture
      // lambda argument / array element / struct-field value gets), so the
      // return becomes a bare fn-name -> const_func, using the existing
      // "return a named function value" path. A capturing lambda is left in
      // place (so the module bails); a non-lambda value recurses
      // through lift_expr_walk unchanged. (Inline `return <lambda>` returns are
      // pre-desugared to a `let $lamret$N = <lambda>; return $lamret$N;` local
      // binding before this pass runs — see desugar_lambda_returns — so a bare
      // ExprLambda no longer reaches here in practice.)
      let e: LiftExpr = lift_call_arg(r.value, acc, gfns);
      let ns: ast.Stmt = ast.StmtReturn { value: e.expr, line: r.line, col: r.col };
      return LiftStmts { stmts: [ns], acc: e.acc };
    },
    ast.StmtVar(v) => {
      let e: LiftExpr = lift_expr_walk(v.init, acc, gfns);
      let ns: ast.Stmt = ast.StmtVar { name: v.name, type_name: v.type_name, init: e.expr, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types };
      return LiftStmts { stmts: [ns], acc: e.acc };
    },
    ast.StmtExpr(s) => {
      let e: LiftExpr = lift_expr_walk(s.value, acc, gfns);
      let ns: ast.Stmt = ast.StmtExpr { value: e.expr, line: 0 };
      return LiftStmts { stmts: [ns], acc: e.acc };
    },
    ast.StmtAssign(asg) => {
      // `f = (x) => {...}` of a NO-CAPTURE lambda hoists to `f = __lam_N`
      // (via lift_call_arg, like the StmtReturn case) — a bare fn-name the assign
      // lowers as a fn-pointer store. A capturing lambda RHS is left in place
      // (stays on AST); a non-lambda RHS recurses through lift_expr_walk.
      let e: LiftExpr = lift_call_arg(asg.value, acc, gfns);
      let ns: ast.Stmt = ast.StmtAssign { target: asg.target, value: e.expr, line: asg.line, col: asg.col, target_line: asg.target_line, target_col: asg.target_col };
      return LiftStmts { stmts: [ns], acc: e.acc };
    },
    ast.StmtIf(f) => {
      let ce: LiftExpr = lift_expr_walk(f.cond, acc, gfns);
      let tb: LiftStmts = lift_stmts(f.then_body, ce.acc, gfns);
      let eb: LiftStmts = lift_stmts(f.else_body, tb.acc, gfns);
      let ns: ast.Stmt = ast.StmtIf { cond: ce.expr, then_body: tb.stmts, else_body: eb.stmts, line: 0, else_chained: false, sugar: parser.no_match_sugar(), origin: "" };
      return LiftStmts { stmts: [ns], acc: eb.acc };
    },
    ast.StmtMatch(m) => {
      // A match's ARM BODIES need the same walk StmtIf's branches get. Without
      // it a `return <lambda>` inside an arm never reached lift_call_arg, so no
      // `__lam_N` was hoisted and the lambda reached the lowering unlifted. The
      // module bailed off the IR path (#6256).
      //
      // The if-expression sibling worked precisely because StmtIf was here, so
      // this is restoring symmetry rather than adding a rule.
      let se: LiftExpr = lift_expr_walk(m.scrutinee, acc, gfns);
      let ma: LiftAcc = se.acc;
      let narms: ast.MatchArm[] = [];
      for arm in m.arms {
        let ge: LiftExpr = lift_expr_walk(arm.guard, ma, gfns);
        let ab: LiftStmts = lift_stmts(arm.body, ge.acc, gfns);
        ma = ab.acc;
        narms = narms.append(ast.MatchArm { pattern: arm.pattern, body: ab.stmts, line: arm.line, col: arm.col, guard: ge.expr, has_guard: arm.has_guard, alt_cont: false });
      }
      let nm: ast.Stmt = ast.StmtMatch { ...m, scrutinee: se.expr, arms: narms };
      return LiftStmts { stmts: [nm], acc: ma };
    },
    ast.StmtWhile(w) => {
      let ce: LiftExpr = lift_expr_walk(w.cond, acc, gfns);
      let b: LiftStmts = lift_stmts(w.body, ce.acc, gfns);
      let ns: ast.Stmt = ast.StmtWhile { cond: ce.expr, body: b.stmts, label: w.label, line: w.line, is_loop: w.is_loop };
      return LiftStmts { stmts: [ns], acc: b.acc };
    },
    ast.StmtFor(fo) => {
      let ie: LiftExpr = lift_expr_walk(fo.iter, acc, gfns);
      let b: LiftStmts = lift_stmts(fo.body, ie.acc, gfns);
      let ns: ast.Stmt = ast.StmtFor { var_name: fo.var_name, iter: ie.expr, body: b.stmts, label: fo.label, line: fo.line };
      return LiftStmts { stmts: [ns], acc: b.acc };
    },
    _ => {
      return LiftStmts { stmts: [st], acc: acc };
    }
  }
  return LiftStmts { stmts: [st], acc: acc };
}

function lift_stmts(stmts: ast.Stmt[], acc: LiftAcc, gfns: string[]): LiftStmts {
  let a: LiftAcc = acc;
  let out: ast.Stmt[] = [];
  for stmt in stmts {
    let r: LiftStmts = lift_stmt(stmt, a, gfns);
    a = r.acc;
    let j: i32 = 0;
    while (j < r.stmts.len()) {
      out = out.append(r.stmts[j]);
      j = j + 1;
    }
  }
  return LiftStmts { stmts: out, acc: a };
}

// --- Capturing lambdas via classic lambda-lifting (closures slice 2c) ---
//
// A capturing lambda bound to a local and used ONLY as a direct call —
// `let f = (x) => { … base … }; … f(a) … f(b) …` — needs no closure box:
// hoist it to __lam_<k>(origparams…, captures…) and rewrite each `f(args)` to
// `__lam_<k>(args…, captures…)`, threading the captured values as ordinary
// arguments. Pure AST rewrite: the lifted body is unchanged (its free vars are
// now same-named params), and the existing direct-call IR path lowers the
// result on every backend. Declines (leaving ExprLambda → AST) when a capture's
// type can't be resolved, a capture (or f) is reassigned, or f escapes as a
// value — first-class capturing closures (box + env) are a later slice.

// lambda_captures returns the lambda's free variables (its captures): every used
// identifier that is not a param, a local it binds, a global function, or a
// literal keyword. Deduped, first-seen order.
function lambda_captures(lam: ast.ExprLambda, fd: parser.FuncDecl): string[] {
  let names: string[] = [];
  for cap in lam.captures {
    names = names.append(cap.name);
  }
  return names;
}

// capture_tvar spells a capture type built from an erased type variable — the
// variable, or the cell box_wide_captures puts it in — and is "" otherwise.
function capture_tvar(t: typeinfo.Type): string {
  if let typeinfo.TypeUnknown(u) = t {
    let tv: string = checker.typevar_reason_name(u.reason);
    if (parser.looks_type_var(tv)) {
      return tv;
    }
  }
  if let typeinfo.TypeArray(a) = t {
    let elem: string = capture_tvar(a.elem);
    if (elem.len() > 0) {
      return elem + "[]";
    }
  }
  return "";
}

function lambda_capture_param(lam: ast.ExprLambda, name: string): ast.ParamDecl {
  for cap in lam.captures {
    if (cap.name == name) {
      let tv: string = capture_tvar(cap.ty);
      if (tv.len() > 0) {
        return ast.ParamDecl { ...decltypes.param_from_type(name, cap.ty), type_name: tv };
      }
      return decltypes.param_from_type(name, cap.ty);
    }
  }
  return decltypes.param_from_type(name, typeinfo.unchecked());
}

function lambda_capture_type(lam: ast.ExprLambda, name: string): string {
  for cap in lam.captures {
    if (cap.name == name) {
      if let typeinfo.TypeFunc(f) = cap.ty {
        return "fn";
      }
      if let typeinfo.TypeString(s) = cap.ty {
        return "string";
      }
      let tv: string = capture_tvar(cap.ty);
      if (tv.len() > 0) {
        return tv;
      }
      return decltypes.capture_spelling(cap.ty);
    }
  }
  return "";
}

struct ClosureLift { body: ast.Stmt[], acc: LiftAcc, changed: boolean }

// try_lift_binding attempts to lift the capturing lambda bound at body[idx] to
// fname. Returns changed=true with the rewritten body + appended lifted fn when
// every guard holds, else the inputs unchanged.
function try_lift_binding(body: ast.Stmt[], idx: i32, fname: string, lam: ast.ExprLambda, fd: parser.FuncDecl, acc: LiftAcc, gfns: string[], assigns: string[], structs: irtables.StructTab, mfuncs: MFuncs): ClosureLift {
  let caps: string[] = lambda_captures(lam, fd);
  // A capture-FREE lambda binding (`let f = (x) => {…}; f(a)`) is lifted
  // the same way, with no capture args — `f(a)` becomes a direct call to the
  // hoisted `__lam_N(a)`. (Previously declined here, so it fell through to the
  // first-class-closure lowering, which emits const_func(<fn>$clo) with no
  // such hoisted body and bailed the module.) The
  // fname-not-used-as-a-value guard below still applies, so a lambda that
  // escapes (passed/returned/reassigned) declines and keeps the box path.
  if (util.index_of_str(assigns, fname) >= 0) {
    return ClosureLift { body: body, acc: acc, changed: false };
  }
  // The name must denote ONE binding in this body (#7253). subst_fcall_stmts
  // rewrites every `fname(…)` callee it walks past, and it recurses into
  // nested if / while / for / match bodies with no notion of scope — so a
  // nested `let fname = <another lambda>` has its OWN calls rewritten to THIS
  // lambda's hoisted body. Witnessed: two sibling `g`s, the inner one called
  // once, and all three call sites emitted `call __fn___lam_0` while
  // `__fn___lam_1` was emitted and never reached; the answer moved by exactly
  // the difference between the two lambdas. Renaming the inner binding, and
  // nothing else, made it correct.
  //
  // Declining is the fix rather than a scope-aware walk: the substitution's
  // precondition is that the name resolves the same way everywhere it looks,
  // and when it does not, both bindings lower as ordinary closures with their
  // own slots — which is correct, just not lifted.
  if (irtables.local_decl_count(body, fname) != 1) {
    return ClosureLift { body: body, acc: acc, changed: false };
  }
  let lparams: ast.ParamDecl[] = [];
  let pj: i32 = 0;
  while (pj < lam.params.len()) {
    lparams = lparams.append(lam.params[pj]);
    pj = pj + 1;
  }
  let cj: i32 = 0;
  while (cj < caps.len()) {
    // Preserve the callable contract, not just its coarse storage type.
    let lcp: ast.ParamDecl = lambda_capture_param(lam, caps[cj]);
    if (lcp.type_name.len() == 0) {
      return ClosureLift { body: body, acc: acc, changed: false };
    }
    lparams = lparams.append(ast.ParamDecl { ...lcp, own: false, has_default: false, default_value: parser.e_unknown("") });
    cj = cj + 1;
  }
  let lname: string = "__lam_" + util.i32_to_string(acc.counter);
  let notp: string[] = [];
  let lbody: ast.Stmt[] = lam.body;
  if (lam.origin == ast.ORIGIN_NESTED_FN) {
    lbody = desugar_lambda_returns(lbody, 0, ret_sig_of(lam.ret_type, lam.ret_fn_ret, lam.ret_fn_param_types)).body;
  }
  let newfn: parser.FuncDecl = parser.FuncDecl { stdlib: "", no_inline: false, name: lname, receiver_name: "", receiver_type: "", receiver_own: false, type_params: notp, params: lparams, ret_type: lam.ret_type, body: lbody, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: lam.ret_fn_ret, ret_fn_param_types: lam.ret_fn_param_types, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] };
  let capargs: ast.Expr[] = [];
  let ca: i32 = 0;
  while (ca < caps.len()) {
    capargs = capargs.append(ast.ExprIdent { name: caps[ca], line: 0, col: 0, ty: "" });
    ca = ca + 1;
  }
  let rest: ast.Stmt[] = [];
  let ri: i32 = idx + 1;
  while (ri < body.len()) {
    rest = rest.append(body[ri]);
    ri = ri + 1;
  }
  let subst_rest: ast.Stmt[] = callsubst.subst_fcall_stmts(rest, fname, lname, capargs, lam.captures);
  let newbody: ast.Stmt[] = [];
  let ki: i32 = 0;
  while (ki < idx) {
    newbody = newbody.append(body[ki]);
    ki = ki + 1;
  }
  let sj: i32 = 0;
  while (sj < subst_rest.len()) {
    newbody = newbody.append(subst_rest[sj]);
    sj = sj + 1;
  }
  let allids: string[] = [];
  let aj: i32 = 0;
  while (aj < newbody.len()) {
    allids = astwalk.collect_idents_stmt(newbody[aj], allids);
    aj = aj + 1;
  }
  if (util.index_of_str(allids, fname) >= 0) {
    return ClosureLift { body: body, acc: acc, changed: false };
  }
  let nacc: LiftAcc = LiftAcc { funcs: acc.funcs.append(newfn), counter: acc.counter + 1 };
  return ClosureLift { body: newbody, acc: nacc, changed: true };
}

// cl_replace_at returns `body` with the statement at `at` replaced by `ns`.
// Used by closure_lift_one to splice a rewritten control-flow statement (whose
// nested body had a lambda lifted) back into its enclosing body.
function cl_replace_at(body: ast.Stmt[], at: i32, ns: ast.Stmt): ast.Stmt[] {
  let nb: ast.Stmt[] = [];
  let k: i32 = 0;
  while (k < body.len()) {
    if (k == at) {
      nb = nb.append(ns);
    } else {
      nb = nb.append(body[k]);
    }
    k = k + 1;
  }
  return nb;
}

// closure_lift_one lifts the FIRST liftable capturing-lambda binding in body,
// recursing into nested loop / if / match bodies. The caller loops until no
// change. A `let f = <capturing lambda>` that is only CALLED (not escaping)
// is param-lifted to a hoisted `__lam_N` + direct call sites — whether it sits
// at the top level OR inside a `while` / `for` / `if` / `match` body. Before
// the nested recursion only top-level bindings lifted, so a loop-local
// capturing closure (`while (…) { let f = (n) => { return n + base; }; …
// f(i) … }`) was never lifted, taking the whole module off the IR path (the
// loop-local capturing-closure IR gap).
function closure_lift_one(body: ast.Stmt[], fd: parser.FuncDecl, acc: LiftAcc, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs): ClosureLift {
  // Only a lambda BINDING consults the block's reassign set, and most blocks
  // hold none — the walk recurses into every one of them.
  let assigns: string[] = [];
  let assigns_done: boolean = false;
  let i: i32 = 0;
  while (i < body.len()) {
    match (body[i]) {
      ast.StmtVar(v) => {
        match (v.init) {
          ast.ExprLambda(lam) => {
            // Both capturing and capture-free lambda bindings lift to
            // a hoisted top-level function + direct call sites (the
            // capture-free case carries no capture args). try_lift_
            // binding declines (keeping the closure-box path) if
            // the binding escapes — used as a value, returned, or
            // reassigned — rather than only called.
            if (!assigns_done) {
              assigns = irtables.body_assign_targets(body);
              assigns_done = true;
            }
            let lifted: ClosureLift = try_lift_binding(body, i, v.name, lam, fd, acc, gfns, assigns, structs, mfuncs);
            if (lifted.changed) {
              return lifted;
            }
          },
          _ => {}
        }
      },
      ast.StmtWhile(w) => {
        // A lambda binding lives in the loop body, not `body`: recurse.
        // Captures resolve against the whole `fd`, so a capture declared
        // outside the loop (`base` / `c.base`) types fine; the escape
        // check runs on the loop-local scope (the binding isn't visible
        // outside it).
        let sw: ClosureLift = closure_lift_one(w.body, fd, acc, gfns, structs, mfuncs);
        if (sw.changed) {
          return ClosureLift { body: cl_replace_at(body, i, ast.StmtWhile { cond: w.cond, body: sw.body, label: w.label, line: 0, is_loop: w.is_loop }), acc: sw.acc, changed: true };
        }
      },
      ast.StmtFor(fr) => {
        let sf: ClosureLift = closure_lift_one(fr.body, fd, acc, gfns, structs, mfuncs);
        if (sf.changed) {
          return ClosureLift { body: cl_replace_at(body, i, ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: sf.body, label: fr.label, line: 0 }), acc: sf.acc, changed: true };
        }
      },
      ast.StmtIf(f) => {
        let st: ClosureLift = closure_lift_one(f.then_body, fd, acc, gfns, structs, mfuncs);
        if (st.changed) {
          return ClosureLift { body: cl_replace_at(body, i, ast.StmtIf { ...f, cond: f.cond, then_body: st.body, else_body: f.else_body }), acc: st.acc, changed: true };
        }
        let se: ClosureLift = closure_lift_one(f.else_body, fd, acc, gfns, structs, mfuncs);
        if (se.changed) {
          return ClosureLift { body: cl_replace_at(body, i, ast.StmtIf { ...f, cond: f.cond, then_body: f.then_body, else_body: se.body }), acc: se.acc, changed: true };
        }
      },
      ast.StmtMatch(mm) => {
        let ami: i32 = 0;
        while (ami < mm.arms.len()) {
          let sm: ClosureLift = closure_lift_one(mm.arms[ami].body, fd, acc, gfns, structs, mfuncs);
          if (sm.changed) {
            let narms: ast.MatchArm[] = [];
            let q: i32 = 0;
            while (q < mm.arms.len()) {
              if (q == ami) {
                narms = narms.append(ast.MatchArm { pattern: mm.arms[q].pattern, body: sm.body, line: mm.arms[q].line, col: mm.arms[q].col, guard: mm.arms[q].guard, has_guard: mm.arms[q].has_guard, alt_cont: false });
              } else {
                narms = narms.append(mm.arms[q]);
              }
              q = q + 1;
            }
            return ClosureLift { body: cl_replace_at(body, i, ast.StmtMatch { ...mm, scrutinee: mm.scrutinee, arms: narms }), acc: sm.acc, changed: true };
          }
          ami = ami + 1;
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return ClosureLift { body: body, acc: acc, changed: false };
}

struct HoistResult { func: parser.FuncDecl, ok: boolean }

// cap_slot_ok reports whether a capture of type `t` fits the env box's single
// (32-bit-op / 8-byte) slot. In the self-host's `-no-pie -static` binary every
// heap / code address fits in 32 bits, so a pointer-shaped capture (string,
// array, struct, enum, Option/Result, tuple, map — and a fn value) occupies the
// same 32-bit slot as an i32, exactly like a `string[]` element (which also uses
// the 32-bit arr_get path). An 8-byte SCALAR (i64 / u64 / f64), or a type
// variable an instance may bind to one, needs a wide slot the box doesn't carry,
// so those (and an unresolved "") decline; box_wide_captures cells them first.
function cap_slot_ok(t: string): boolean {
  return t.len() > 0 && !is_wide_cap_type(t);
}

// make_clo_func builds the hoisted body of an escaping/inline closure: a top-
// level `<cloname>(__env: i32[], origparams…)` whose body reads each capture
// from the env box (`let cap_i: <T> = __env[1+i]`; box slot 0 is the funcval,
// caps follow) and then runs the lambda body. Each capture must fit the box's
// 32-bit slot (cap_slot_ok: i32 or any pointer-shaped type — string, array,
// struct, enum, …; an 8-byte scalar declines); otherwise it returns ok:false so
// the closure stays an ExprLambda and the module bails. The capture var
// is declared with its REAL type so downstream uses (e.g. a captured string's
// `.len()`) dispatch correctly even though the box is typed i32[] (the 32-bit
// load yields the pointer, which fits). The array-element / struct-field
// inline lifts (`lift_inline_closures`) build every such box through it.
//
// A fn-VALUE capture is read back under its full `(P) => R` spelling rather than
// the flat "fn" tag, which carries no signature: a wasm funcref type is
// structural, so the call inside the hoisted body needs the widths to pick its
// type and to push its arguments (#6862). A fn capture whose signature
// the checked contract cannot describe declines rather than guessing an ABI.
function make_clo_func(lam: ast.ExprLambda, cloname: string, fd: parser.FuncDecl, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs): HoistResult {
  let none: parser.FuncDecl = fd;
  let caps: string[] = lambda_captures(lam, fd);
  if (caps.len() == 0) {
    return HoistResult { func: none, ok: false };
  }
  let ctys: string[] = [];
  let ci: i32 = 0;
  while (ci < caps.len()) {
    let cty: string = lambda_capture_type(lam, caps[ci]);
    if (!cap_slot_ok(cty)) {
      return HoistResult { func: none, ok: false };
    }
    if (cty == "fn") {
      let cfp: ast.ParamDecl = lambda_capture_param(lam, caps[ci]);
      if (cfp.type_name != "fn") {
        return HoistResult { func: none, ok: false };
      }
      cty = fn_spelling_of(cfp);
    }
    ctys = ctys.append(cty);
    ci = ci + 1;
  }
  // params = __env first, then the lambda's declared params.
  let ps: ast.ParamDecl[] = [ast.ParamDecl { name: "__env", type_name: "i32[]", own: false, has_default: false, default_value: parser.e_unknown(""), fn_ret: "", fn_param_types: "" }];
  let pj: i32 = 0;
  while (pj < lam.params.len()) {
    ps = ps.append(lam.params[pj]);
    pj = pj + 1;
  }
  // body = capture reads (let cap: <T> = __env[1+i]) then the lambda body. The
  // read is typed by the capture's checked type so a pointer-shaped
  // capture is a typed slot downstream; the i32[] 32-bit load still yields the
  // (32-bit-fitting) pointer value.
  let bd: ast.Stmt[] = [];
  let cj: i32 = 0;
  while (cj < caps.len()) {
    let idx: ast.Expr = ast.ExprIndex { array: ast.ExprIdent { name: "__env", line: 0, col: 0, ty: "" }, index: ast.ExprNumber { text: util.i32_to_string(1 + cj), suffix: "", raw: "", is_float: false, line: 0, col: 0 }, unchecked: false, ty: "", line: 0, col: 0 };
    bd = bd.append(ast.StmtVar { name: caps[cj], type_name: ctys[cj], init: idx, line: 0, col: 0, fn_ret: "", fn_param_types: "" });
    cj = cj + 1;
  }
  let bk: i32 = 0;
  while (bk < lam.body.len()) {
    bd = bd.append(lam.body[bk]);
    bk = bk + 1;
  }
  let notp: string[] = [];
  let clo: parser.FuncDecl = parser.FuncDecl { stdlib: "", no_inline: false, name: cloname, receiver_name: "", receiver_type: "", receiver_own: false, type_params: notp, params: ps, ret_type: lam.ret_type, body: bd, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: lam.ret_fn_ret, ret_fn_param_types: lam.ret_fn_param_types, is_package: false, module: fd.module, impl_trait: "", dyn_traits: [], streams: [] };
  return HoistResult { func: clo, ok: true };
}

// clo_owner_name is the name a function's hoisted closures / wrappers / iife
// temps are keyed under: receiver-qualified (`OrdSet__i32.filter`), the same
// spelling lower_module registers the method by, so two methods sharing a bare
// name (`OrdSet.filter` / `PSet.filter`) never mint the same `$clo0` symbol.
function clo_owner_name(fd: parser.FuncDecl): string {
  if (fd.receiver_type.len() > 0) {
    return util.base_type_name(fd.receiver_type) + "." + fd.name;
  }
  return fd.name;
}

// ---- inline capturing closures in aggregate position (#2994) -----------
//
// A CAPTURING inline lambda in an array-element (`[(x) => { x+n }]`) or a
// struct-field value (`Box { f: (x) => { x+n } }`) is a first-class closure
// that does NOT come from a `return <lambda>` or a `mk()` call, so neither the
// param-lift (call-only bindings) nor the `$lamret$N` return slot reaches it —
// it stayed an ExprLambda and bailed the module to AST. This pass
// hoists each such lambda to a UNIQUELY-named `<fd>$cloN` (so a function may host
// several distinct inline closures) via make_clo_func, and replaces the inline
// lambda with a `__mkclo$<fd>$cloN(caps…)` marker that the lowering turns into the
// env box [funcval, caps…] — the same box the call side already unpacks for
// closure arrays / struct "fn" fields. Captures must all be i32 (make_clo_func
// declines otherwise), in which case the lambda is left in place (module bails to
// AST — correctness preserved). The marker's capture args are bare idents in
// lambda_captures order, matching make_clo_func's env-box slot order (cap[i] →
// box slot 1+i). The counter persists across all aggregate positions in fd so
// every hoisted closure gets a distinct name.

struct InlineCloRes { expr: ast.Expr, funcs: parser.FuncDecl[], counter: i32 }

// InlineCloAcc is the lift's accumulator on astwalk's rewrite spine: the
// functions hoisted so far and the counter that names the next one. Counter
// order is name order, so the spine's child-order contract is what keeps the
// hoisted `$cloN` / `$wrapN` / `$iifeN` names — and the fixpoint's
// byte-identity — stable.
struct InlineCloAcc { funcs: parser.FuncDecl[], counter: i32 }

// try_inline_closure attempts to hoist one capturing inline lambda `lam` found in
// aggregate position. On success returns the `__mkclo$<name>(caps…)` marker plus
// the hoisted function appended; on decline returns the lambda unchanged.
function try_inline_closure(lam: ast.ExprLambda, fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs): InlineCloRes {
  let caps: string[] = lambda_captures(lam, fd);
  if (caps.len() == 0) {
    return InlineCloRes { expr: ast.ExprLambda { ...lam, body: lam.body }, funcs: funcs, counter: counter };
  }
  let cloname: string = clo_owner_name(fd) + "$clo" + util.i32_to_string(counter);
  let hr: HoistResult = make_clo_func(lam, cloname, fd, gfns, structs, mfuncs);
  if (!hr.ok) {
    return InlineCloRes { expr: ast.ExprLambda { ...lam, body: lam.body }, funcs: funcs, counter: counter };
  }
  let capargs: ast.Expr[] = [];
  let ci: i32 = 0;
  while (ci < caps.len()) {
    capargs = capargs.append(ast.ExprIdent { name: caps[ci], line: 0, col: 0, ty: "" });
    ci = ci + 1;
  }
  let marker: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "__mkclo$" + cloname, line: 0, col: 0, ty: "" }, args: capargs, line: 0, col: 0, type_args: [], ty: "" };
  return InlineCloRes { expr: marker, funcs: funcs.append(hr.func), counter: counter + 1 };
}

// ---- uniform env-box fn-typed STRUCT FIELDS (slice #3445 / #3435 follow-up) --
//
// A fn-typed struct field (`struct Box { f: (i32) => i32 }`) must store a value
// the field-call path can invoke UNIFORMLY. The capturing inline lambda case
// needs an env box `[funcval, caps…]` whose funcval (`<fd>$cloN`) takes an
// `__env` first param; but a no-capture lambda / bare fn-name field stores a
// plain fn pointer that takes NO `__env`. To make `h.f(args)` dispatch the SAME
// way for every fn-field, EVERY fn-typed field value is wrapped into an env box:
//   * capturing inline lambda  → `__mkclo$<fd>$cloN(caps…)` (try_inline_closure)
//     → box [const_func(<fd>$cloN), caps…], the $cloN reads caps from __env.
//   * no-capture lambda / bare  → a `<fd>$wrapN(__env: i32[], origparams…)`
//     fn-name field                TRAMPOLINE that ignores __env and runs the
//                                  real work, wrapped as `__mkclo$<fd>$wrapN()`
//                                  → box [const_func(<fd>$wrapN)] (slot 0 only).
// The call side (`decl_field_type(...) == "fn"`) then always pushes the box as
// __env, the args, then box[0], and call_indirect(arity+1). Captures must be
// i32 (make_clo_func declines otherwise); a fn-name whose FuncDecl isn't found,
// or any other field-value shape, declines (ok:false) so the field stays as-is
// and the module bails (correctness preserved).

// make_wrap_lambda_func builds the env-taking trampoline for a NO-CAPTURE inline
// lambda field value: `<wrapname>(__env: i32[], origparams…) { <lambda body> }`
// (the lambda body inlined verbatim; __env is unused). Always succeeds — a
// no-capture lambda needs no env reads.
function make_wrap_lambda_func(lam: ast.ExprLambda, wrapname: string): parser.FuncDecl {
  let ps: ast.ParamDecl[] = [ast.ParamDecl { name: "__env", type_name: "i32[]", own: false, has_default: false, default_value: parser.e_unknown(""), fn_ret: "", fn_param_types: "" }];
  let pj: i32 = 0;
  while (pj < lam.params.len()) {
    ps = ps.append(lam.params[pj]);
    pj = pj + 1;
  }
  let notp: string[] = [];
  return parser.FuncDecl { stdlib: "", no_inline: false, name: wrapname, receiver_name: "", receiver_type: "", receiver_own: false, type_params: notp, params: ps, ret_type: lam.ret_type, body: lam.body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: lam.ret_fn_ret, ret_fn_param_types: lam.ret_fn_param_types, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] };
}

// make_wrap_named_func builds the env-taking trampoline for a BARE FN-NAME field
// value (`Box { f: dbl }`): `<wrapname>(__env: i32[], p0, p1…) { return dbl(p0,
// p1…); }` (`dbl(p0, p1…);` for a void target), reusing the target function's
// parameter list / return type (looked
// up by name in `mfuncs`). Declines (ok:false) if no receiver-less function of
// that name is found — the field then stays as-is and the module bails.
function make_wrap_named_func(fnname: string, wrapname: string, mfuncs: MFuncs): HoistResult {
  let none: parser.FuncDecl = parser.FuncDecl { stdlib: "", no_inline: false, name: "", receiver_name: "", receiver_type: "", receiver_own: false, type_params: [], params: [], ret_type: "", body: [], line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] };
  let fi: i32 = 0;
  while (fi < mfuncs.decls.len()) {
    if (mfuncs.decls[fi].name == fnname && mfuncs.decls[fi].receiver_type.len() == 0) {
      let tgt: parser.FuncDecl = mfuncs.decls[fi];
      let ps: ast.ParamDecl[] = [ast.ParamDecl { name: "__env", type_name: "i32[]", own: false, has_default: false, default_value: parser.e_unknown(""), fn_ret: "", fn_param_types: "" }];
      let args: ast.Expr[] = [];
      let pj: i32 = 0;
      while (pj < tgt.params.len()) {
        // The trampoline mirrors the target's modes exactly, so the
        // function TYPE its box hands out spells `own` at the slots the
        // target consumes and the caller's unit passes STRAIGHT
        // THROUGH. It used to un-`own` a counted array parameter and
        // re-acquire at its own direct call, which made a consuming
        // target reachable through a lending type; a function type
        // spells its consuming slots now, so that adapter would
        // describe a call nothing can write.
        ps = ps.append(tgt.params[pj]);
        args = args.append(ast.ExprIdent { name: tgt.params[pj].name, line: 0, col: 0, ty: "" });
        pj = pj + 1;
      }
      let call: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: fnname, line: 0, col: 0, ty: "" }, args: args, line: 0, col: 0, type_args: [], ty: "" };
      // A void target is called as a statement, the way the source would
      // write it: the checker refuses `return f()` of a void `f` (E002).
      let body: ast.Stmt = ast.StmtReturn { value: call, line: 0, col: 0 };
      if (tgt.ret_type == "void") {
        body = ast.StmtExpr { value: call, line: 0 };
      }
      let bd: ast.Stmt[] = [body];
      let notp: string[] = [];
      return HoistResult { func: parser.FuncDecl { stdlib: "", no_inline: false, name: wrapname, receiver_name: "", receiver_type: "", receiver_own: false, type_params: notp, params: ps, ret_type: tgt.ret_type, body: bd, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: tgt.ret_fn_ret, ret_fn_param_types: tgt.ret_fn_param_types, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, ok: true };
    }
    fi = fi + 1;
  }
  return HoistResult { func: none, ok: false };
}

// try_fn_field_value lifts ONE fn-typed struct-field value into a `__mkclo$…`
// env-box marker. Capturing inline lambda → try_inline_closure (box [funcval,
// caps…]). No-capture inline lambda → a `$wrapN` trampoline, marker with no cap
// args (box [funcval]). Bare fn-name → a `$wrapN` trampoline calling the named
// fn, marker with no cap args. Any other value shape (or an unresolvable fn-name
// / non-i32-capture lambda) declines: the value is returned unchanged so the
// module bails (correctness preserved). The marker arg list is empty for
// the wrap cases, so __mkclo$ lowering emits a 1-slot box [const_func($wrapN)].
function try_fn_field_value(e: ast.Expr, fd: parser.FuncDecl, vars: VarDecls, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: irtables.StructTab): InlineCloRes {
  match (e) {
    ast.ExprLambda(lam) => {
      let caps: string[] = lambda_captures(lam, fd);
      if (caps.len() > 0) {
        return try_inline_closure(lam, fd, funcs, counter, gfns, structs, mfuncs);
      }
      // No-capture lambda → wrap trampoline (body inlined, __env ignored).
      let wn: string = clo_owner_name(fd) + "$wrap" + util.i32_to_string(counter);
      let wf: parser.FuncDecl = make_wrap_lambda_func(lam, wn);
      let marker: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "__mkclo$" + wn, line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_args: [], ty: "" };
      return InlineCloRes { expr: marker, funcs: funcs.append(wf), counter: counter + 1 };
    },
    ast.ExprIdent(id) => {
      // A PARAMETER of the enclosing function is not a module fn-name, even
      // when a module function happens to share its name — the parameter
      // shadows it. The value is already an env box in a slot, so decline
      // and leave the ident alone; that is exactly the path taken when the
      // names do not collide.
      //
      // Without this guard the trampoline below was built against the
      // MODULE function, so `f(target)` where `target` is a fn-typed
      // parameter emitted `call __fn_target` — a hardcoded call to an
      // unrelated top-level function of the same name. No diagnostic, no
      // crash: a running binary that invokes the wrong function (#6191).
      // std/fuzz hit it because its parameter is literally named `target`
      // and fuzz programs conventionally name their target function the
      // same thing.
      if (lift_ident_is_param(fd, id.name)) {
        return InlineCloRes { expr: e, funcs: funcs, counter: counter };
      }
      // Bare fn-name field (`Box { f: dbl }`): build a trampoline calling it.
      let wn2: string = clo_owner_name(fd) + "$wrap" + util.i32_to_string(counter);
      let hr: HoistResult = make_wrap_named_func(id.name, wn2, mfuncs);
      if (!hr.ok) {
        return InlineCloRes { expr: e, funcs: funcs, counter: counter };
      }
      let marker2: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "__mkclo$" + wn2, line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_args: [], ty: "" };
      return InlineCloRes { expr: marker2, funcs: funcs.append(hr.func), counter: counter + 1 };
    },
    ast.ExprCall(c) => {
      // A value-position `if`/`match` in a fn-value position parses as an
      // IIFE, and its arms are STATEMENTS inside an expression, so the
      // expression walk stopped here and an arm lambda reached lower_expr
      // asking for a `<fd>$clo` nothing built (#6256). Box the arm values
      // instead — the whole IIFE then yields a box, exactly like the
      // lambda case above, in every position that routes through here
      // (array element, tuple element, struct field, fn-typed argument).
      match (c.callee) {
        ast.ExprLambda(il) => {
          if (c.args.len() != 0 || il.params.len() != 0) {
            return InlineCloRes { expr: e, funcs: funcs, counter: counter };
          }
          // The body apart from the arm values is walked first and
          // unconditionally (#6571) — it is independent of whether the
          // arm VALUES are boxable, so an IIFE with a capturing lambda
          // in its condition and plain scalar arms (the shape that
          // bailed) is rewritten even though the boxing below declines.
          let (cnds, cnda) = lift_iife_body(il.body, fd, vars, funcs, counter, gfns, mfuncs, structs);
          let walked: InlineCloRes = InlineCloRes { expr: e, funcs: funcs, counter: counter };
          if (cnda.counter > counter) {
            let cl2: ast.Expr = ast.ExprLambda { ...il, body: cnds };
            walked = InlineCloRes { expr: ast.ExprCall { callee: cl2, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, funcs: cnda.funcs, counter: cnda.counter };
          }
          if (!iife_arms_all_boxable(cnds, iife_scope_fd(fd, cnds), mfuncs)) {
            return walked;
          }
          // The arms are lowered INLINE in the enclosing function, so a
          // name the IIFE itself binds — a match arm's payload, an
          // arm-body local — is an ordinary local slot there. Boxing an
          // arm lambda against `fd` alone left such a name out of
          // lambda_captures' enclosing set, so the lambda read as
          // capture-free and its `$wrap` trampoline resolved the name
          // against the module instead. Widening the scope makes it a
          // capture like any other.
          let fdx: parser.FuncDecl = iife_scope_fd(fd, cnds);
          let (brs, bra) = box_iife_arm_values(cnds, fdx, iife_scope_vars(vars, cnds), cnda.funcs, cnda.counter, gfns, mfuncs, structs);
          if (bra.counter == cnda.counter || !iife_arms_all_marked(brs, mfuncs)) {
            return walked;
          }
          let nlam: ast.Expr = ast.ExprLambda { ...il, body: brs };
          let niife: ast.Expr = ast.ExprCall { callee: nlam, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
          return InlineCloRes { expr: niife, funcs: bra.funcs, counter: bra.counter };
        },
        ast.ExprIdent(cid) => {
          // A generic passthrough (`id(<lambda>)`) hands its argument
          // straight back, so boxing the argument boxes the call. The
          // aggregate positions call this directly rather than through
          // the expression walk, so every other argument goes through
          // that walk here, and a call with nothing to pass through goes
          // through it whole, or a lambda inside it would stay raw.
          if (!passthrough_call_has_fn_arg(c, cid.name, mfuncs)) {
            return lift_inline_closures_expr(e, fd, vars, funcs, counter, gfns, structs, mfuncs);
          }
          let pfs: parser.FuncDecl[] = funcs;
          let pct: i32 = counter;
          let pargs: ast.Expr[] = [];
          let pi2: i32 = 0;
          while (pi2 < c.args.len()) {
            if (passthrough_slot_holds_fn(c, cid.name, pi2, mfuncs)) {
              let pr: InlineCloRes = try_fn_field_value(c.args[pi2], fd, vars, pfs, pct, gfns, mfuncs, structs);
              pfs = pr.funcs;
              pct = pr.counter;
              pargs = pargs.append(pr.expr);
            } else {
              let wr: InlineCloRes = lift_inline_closures_expr(c.args[pi2], fd, vars, pfs, pct, gfns, structs, mfuncs);
              pfs = wr.funcs;
              pct = wr.counter;
              pargs = pargs.append(wr.expr);
            }
            pi2 = pi2 + 1;
          }
          if (pct == counter) {
            return InlineCloRes { expr: e, funcs: funcs, counter: counter };
          }
          return InlineCloRes { expr: ast.ExprCall { callee: c.callee, args: pargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, funcs: pfs, counter: pct };
        },
        _ => {
          return lift_inline_closures_expr(e, fd, vars, funcs, counter, gfns, structs, mfuncs);
        }
      }
    },
    _ => {
      return InlineCloRes { expr: e, funcs: funcs, counter: counter };
    }
  }
  return InlineCloRes { expr: e, funcs: funcs, counter: counter };
}

// iife_arms_all_boxable reports whether EVERY arm of a value-position if/match
// yields something try_fn_field_value turns into an env box — an inline lambda,
// a bare module function name, or a nested value-position if/match that is
// itself all-boxable — and that at least one arm does. Both halves matter:
// below "every arm" the destination would carry two dispatch ABIs (#5071 one
// container out), and without such an arm there is nothing to box.
function iife_arms_all_boxable(stmts: ast.Stmt[], fd: parser.FuncDecl, mfuncs: MFuncs): boolean {
  return iife_arm_values_boxable(stmts, 0, fd, mfuncs) > 0;
}

// iife_scope_fd returns `fd` with the IIFE's own statements appended to its
// body, so lambda_captures counts a name the IIFE binds as an enclosing local.
// Only the body is read by the capture walk, so nothing else needs adjusting.
function iife_scope_fd(fd: parser.FuncDecl, body: ast.Stmt[]): parser.FuncDecl {
  let nb: ast.Stmt[] = fd.body;
  let i: i32 = 0;
  while (i < body.len()) {
    nb = nb.append(body[i]);
    i = i + 1;
  }
  return parser.FuncDecl { ...fd, body: nb };
}

// Returns the number of boxable arms found, or -1 as soon as an arm yields
// something that is not boxable.
function iife_arm_values_boxable(stmts: ast.Stmt[], seen: i32, fd: parser.FuncDecl, mfuncs: MFuncs): i32 {
  let n: i32 = seen;
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        match (r.value) {
          ast.ExprLambda(_) => {
            n = n + 1;
          },
          ast.ExprIdent(rid) => {
            if (!arm_names_module_fn(rid.name, fd, mfuncs) && !names_local_fn_value(rid, mfuncs)) {
              return 0 - 1;
            }
            n = n + 1;
          },
          ast.ExprCall(rc) => {
            match (rc.callee) {
              ast.ExprLambda(ril) => {
                if (rc.args.len() != 0 || ril.params.len() != 0) {
                  return 0 - 1;
                }
                let deep: i32 = iife_arm_values_boxable(ril.body, n, fd, mfuncs);
                if (deep < 0) {
                  return 0 - 1;
                }
                n = deep;
              },
              ast.ExprIdent(cid) => {
                if (!passthrough_call_boxable(rc, cid.name, fd, mfuncs)) {
                  return 0 - 1;
                }
                n = n + 1;
              },
              _ => {
                return 0 - 1;
              }
            }
          },
          _ => {
            return 0 - 1;
          }
        }
      },
      ast.StmtIf(iff) => {
        n = iife_arm_values_boxable(iff.then_body, n, fd, mfuncs);
        if (n < 0) {
          return 0 - 1;
        }
        n = iife_arm_values_boxable(iff.else_body, n, fd, mfuncs);
        if (n < 0) {
          return 0 - 1;
        }
      },
      ast.StmtMatch(mm) => {
        let a: i32 = 0;
        while (a < mm.arms.len()) {
          n = iife_arm_values_boxable(mm.arms[a].body, n, fd, mfuncs);
          if (n < 0) {
            return 0 - 1;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return n;
}

// A generic passthrough call (`pick(c, <lambda>, <lambda>)`) yields the fn
// value it is handed, so an arm returning one is boxable when every fn value
// it passes through is: try_fn_field_value's ident-callee case boxes exactly
// those arguments, and boxing the argument boxes the call.
function passthrough_call_boxable(rc: ast.ExprCall, callee: string, fd: parser.FuncDecl, mfuncs: MFuncs): boolean {
  let found: boolean = false;
  let i: i32 = 0;
  while (i < rc.args.len()) {
    if (lift_callee_is_typevar_passthrough(mfuncs, callee, i)) {
      if let ast.ExprCall(ic) = rc.args[i] {
        if let ast.ExprLambda(il) = ic.callee {
          if (ic.args.len() != 0 || il.params.len() != 0 || !iife_arms_all_boxable(il.body, iife_scope_fd(fd, il.body), mfuncs)) {
            return false;
          }
          found = true;
        }
      }
      if (lift_arg_is_passthrough_fn_value(rc.args[i], mfuncs) || arg_names_local_fn_value(rc.args[i], mfuncs)) {
        if (!passthrough_arg_boxable(rc.args[i], fd, mfuncs)) {
          return false;
        }
        found = true;
      }
    }
    i = i + 1;
  }
  return found;
}

// An argument try_fn_field_value boxes in place of the passthrough call that
// hands it back.
function passthrough_slot_holds_fn(c: ast.ExprCall, callee: string, i: i32, mfuncs: MFuncs): boolean {
  return lift_callee_is_typevar_passthrough(mfuncs, callee, i)
    && (lift_arg_is_passthrough_fn_value(c.args[i], mfuncs) || passthrough_arg_is_iife(c.args[i]));
}

function passthrough_call_has_fn_arg(c: ast.ExprCall, callee: string, mfuncs: MFuncs): boolean {
  let i: i32 = 0;
  while (i < c.args.len()) {
    if (passthrough_slot_holds_fn(c, callee, i, mfuncs)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function passthrough_arg_is_iife(arg: ast.Expr): boolean {
  if let ast.ExprCall(c) = arg {
    return irtables.is_iife_callee(c);
  }
  return false;
}

function arg_names_local_fn_value(arg: ast.Expr, mfuncs: MFuncs): boolean {
  if let ast.ExprIdent(id) = arg {
    return names_local_fn_value(id, mfuncs);
  }
  return false;
}

function passthrough_arg_boxable(arg: ast.Expr, fd: parser.FuncDecl, mfuncs: MFuncs): boolean {
  match (arg) {
    ast.ExprLambda(_) => {
      return true;
    },
    ast.ExprIdent(id) => {
      return arm_names_module_fn(id.name, fd, mfuncs) || names_local_fn_value(id, mfuncs);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return passthrough_call_boxable(c, cid.name, fd, mfuncs);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// A local (or parameter) holding a fn value is already an env box, so an arm
// yielding one needs no boxing and is marked as it stands. A module function
// name is not: that one takes a `$wrap` trampoline.
function names_local_fn_value(id: ast.ExprIdent, mfuncs: MFuncs): boolean {
  return id.ty == "fn" && !lift_names_fn_value(mfuncs, id.name);
}

// The boxed shape of a passthrough call: no fn value is still passed through
// raw, and at least one argument is an env-box marker, so the call yields a
// box.
function passthrough_call_marked(rc: ast.ExprCall, callee: string, mfuncs: MFuncs): boolean {
  let boxed: boolean = false;
  let i: i32 = 0;
  while (i < rc.args.len()) {
    if (lift_callee_is_typevar_passthrough(mfuncs, callee, i)) {
      if (lift_arg_is_passthrough_fn_value(rc.args[i], mfuncs)) {
        return false;
      }
      if (expr_is_marked(rc.args[i], mfuncs) || arg_names_local_fn_value(rc.args[i], mfuncs)) {
        boxed = true;
      } else if (passthrough_arg_is_iife(rc.args[i])) {
        return false;
      }
    }
    i = i + 1;
  }
  return boxed;
}

function expr_is_marked(e: ast.Expr, mfuncs: MFuncs): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(il) = c.callee {
      return irtables.is_iife_callee(c) && iife_arms_all_marked(il.body, mfuncs);
    }
    if let ast.ExprIdent(cid) = c.callee {
      if (cid.name.len() > 8 && slice_unchecked(cid.name, 0, 8) == "__mkclo$") {
        return true;
      }
      return passthrough_call_marked(c, cid.name, mfuncs);
    }
  }
  return false;
}

// iife_arms_all_marked is the POST-condition on the rewrite: every arm now
// returns a `__mkclo$…` env-box marker (or a nested IIFE whose arms all do).
// try_fn_field_value declines silently — a capture whose slot it cannot build
// comes back unchanged — and a PARTLY boxed IIFE is worse than an unboxed one:
// the destination reads as a box from one arm and dispatches every arm that
// way. Checked rather than assumed, so a decline anywhere abandons the rewrite.
function iife_arms_all_marked(stmts: ast.Stmt[], mfuncs: MFuncs): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        match (r.value) {
          ast.ExprCall(rc) => {
            match (rc.callee) {
              ast.ExprIdent(_) => {
                if (!expr_is_marked(r.value, mfuncs)) {
                  return false;
                }
              },
              ast.ExprLambda(ril) => {
                if (!iife_arms_all_marked(ril.body, mfuncs)) {
                  return false;
                }
              },
              _ => {
                return false;
              }
            }
          },
          ast.ExprIdent(rid) => {
            if (!names_local_fn_value(rid, mfuncs)) {
              return false;
            }
          },
          _ => {
            return false;
          }
        }
      },
      ast.StmtIf(iff) => {
        if (!iife_arms_all_marked(iff.then_body, mfuncs)) {
          return false;
        }
        if (!iife_arms_all_marked(iff.else_body, mfuncs)) {
          return false;
        }
      },
      ast.StmtMatch(mm) => {
        let a: i32 = 0;
        while (a < mm.arms.len()) {
          if (!iife_arms_all_marked(mm.arms[a].body, mfuncs)) {
            return false;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return true;
}

// lift_iife_body lifts the lambdas in an IIFE's body except its arms' returned
// values (#6571).
//
// A value-position `if`/`match` or `{ … }` is an IIFE, and its body is
// STATEMENTS inside an expression, so the expression walk stops at it. The
// returned values belong to the #6256 arm-value boxing and
// box_iife_arm_array_elems, and running two lifts over one node would box it
// twice. Everything else goes through the ordinary expression lift: a
// condition, a scrutinee, a declaration's initialiser, an assignment, an
// expression statement. A capturing lambda left there reached lower_expr bare
// and asked for a `$clo` nothing built, bailing the module.
//
// On the spine: a statement that declines hands its expressions to the full
// lift visitor and recurses its bodies through this one. StmtMatch is claimed
// and rebuilt by hand so its arm bodies recurse through this walk; its
// scrutinee and guards go through the full lift like any other condition.
function lift_iife_body(stmts: ast.Stmt[], fd: parser.FuncDecl, vars: VarDecls, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: irtables.StructTab): (ast.Stmt[], InlineCloAcc) {
  function ve(x: ast.Expr, a: InlineCloAcc): (ast.Expr, InlineCloAcc, boolean) {
    return ilc_expr_at(x, a, fd, vars, gfns, structs, mfuncs);
  }
  function vs(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) {
    match (s) {
      ast.StmtIf(_) => {
        return (s, a, false);
      },
      ast.StmtMatch(mm) => {
        let sr: InlineCloRes = lift_inline_closures_expr(mm.scrutinee, fd, vars, a.funcs, a.counter, gfns, structs, mfuncs);
        let fs: parser.FuncDecl[] = sr.funcs;
        let ct: i32 = sr.counter;
        let narms: ast.MatchArm[] = [];
        for arm in mm.arms {
          let ng: ast.Expr = arm.guard;
          if (arm.has_guard) {
            let gr: InlineCloRes = lift_inline_closures_expr(arm.guard, fd, vars, fs, ct, gfns, structs, mfuncs);
            ng = gr.expr;
            fs = gr.funcs;
            ct = gr.counter;
          }
          let (abs, aba) = lift_iife_body(arm.body, fd, vars, fs, ct, gfns, mfuncs, structs);
          fs = aba.funcs;
          ct = aba.counter;
          narms = narms.append(ast.MatchArm { ...arm, guard: ng, body: abs });
        }
        return (ast.StmtMatch { ...mm, scrutinee: sr.expr, arms: narms }, InlineCloAcc { funcs: fs, counter: ct }, true);
      },
      ast.StmtVar(_) => {
        return (s, a, false);
      },
      ast.StmtReturn(_) => {
        return (s, a, true);
      },
      ast.StmtExpr(_) => {
        return (s, a, false);
      },
      ast.StmtAssign(_) => {
        return (s, a, false);
      },
      ast.StmtWhile(_) => {
        return (s, a, true);
      },
      ast.StmtFor(_) => {
        return (s, a, true);
      },
      ast.StmtDefer(_) => {
        return (s, a, true);
      },
      ast.StmtBreak(_) => {
        return (s, a, false);
      },
      ast.StmtContinue(_) => {
        return (s, a, false);
      },
      ast.StmtUnknown(_) => {
        return (s, a, false);
      }
    }
    return (s, a, true);
  }
  return astwalk.map_stmts_acc(stmts, InlineCloAcc { funcs: funcs, counter: counter }, vs, ve);
}

// ilc_keep_expr claims every expression unchanged — the expression visitor for
// the arm-boxing walks, whose statement visitors own all the rewriting and
// whose condition / scrutinee / guard slots must stay unwalked.
function ilc_keep_expr(x: ast.Expr, a: InlineCloAcc): (ast.Expr, InlineCloAcc, boolean) {
  return (x, a, true);
}

// lift_iife_arm_values puts the VALUES an inline IIFE's arms return through the
// ORDINARY expression lift — the walk every other expression position gets.
//
// hoist_value_iife and box_iife_arm_array_elems own those returns when the arms
// yield a fn value or an array of them. An arm yielding anything else — an
// ordinary call, say — is owned by nobody, and the arms are STATEMENTS inside an
// expression, so the expression walk stops at the IIFE and never reaches it. A
// fn-typed ARGUMENT of a call in such an arm therefore stayed raw while every
// other call site of the same callee boxed its own: the callee's fn parameter
// dispatches env-first and got a bare code address (#8090, seed 15035).
//
// Returns only, and the caller gates it on the fn-value paths not having claimed
// the arms — running two of these over one node would box a value twice. The
// condition and the arm guards are lift_iife_body's, which runs first.
function lift_iife_arm_values(stmts: ast.Stmt[], fd: parser.FuncDecl, vars: VarDecls, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: irtables.StructTab): (ast.Stmt[], InlineCloAcc) {
  function vs(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) {
    match (s) {
      ast.StmtReturn(r) => {
        // An arm returning an array of fn VALUES is box_iife_arm_array_elems'
        // to claim, and it claims every arm's elements or none of them.
        // Walking one here boxed a capturing lambda in THIS arm while a
        // sibling arm kept raw fn pointers, so the binding carried two
        // dispatch ABIs and `xs[i](…)` called a box pointer as code
        // (#8163). Left unwalked, the capturing lambda stays raw and the
        // module bails at it — what the uniformity gate promises when it
        // declines.
        if let ast.ExprArray(ra) = r.value {
          if (array_holds_fn_value(ra, mfuncs)) {
            return (s, a, true);
          }
        }
        let vr: InlineCloRes = lift_inline_closures_expr(r.value, fd, vars, a.funcs, a.counter, gfns, structs, mfuncs);
        return (ast.StmtReturn { value: vr.expr, line: r.line, col: r.col }, InlineCloAcc { funcs: vr.funcs, counter: vr.counter }, true);
      },
      ast.StmtIf(_) => {
        return (s, a, false);
      },
      ast.StmtMatch(mm) => {
        let fs: parser.FuncDecl[] = a.funcs;
        let ct: i32 = a.counter;
        let narms: ast.MatchArm[] = [];
        for arm in mm.arms {
          let (abs, aba) = lift_iife_arm_values(arm.body, fd, vars, fs, ct, gfns, mfuncs, structs);
          fs = aba.funcs;
          ct = aba.counter;
          narms = narms.append(ast.MatchArm { ...arm, body: abs });
        }
        return (ast.StmtMatch { ...mm, arms: narms }, InlineCloAcc { funcs: fs, counter: ct }, true);
      },
      ast.StmtVar(_) => {
        return (s, a, true);
      },
      ast.StmtExpr(_) => {
        return (s, a, true);
      },
      ast.StmtAssign(_) => {
        return (s, a, true);
      },
      ast.StmtWhile(_) => {
        return (s, a, true);
      },
      ast.StmtFor(_) => {
        return (s, a, true);
      },
      ast.StmtDefer(_) => {
        return (s, a, true);
      },
      ast.StmtBreak(_) => {
        return (s, a, false);
      },
      ast.StmtContinue(_) => {
        return (s, a, false);
      },
      ast.StmtUnknown(_) => {
        return (s, a, false);
      }
    }
    return (s, a, true);
  }
  return astwalk.map_stmts_acc(stmts, InlineCloAcc { funcs: funcs, counter: counter }, vs, ilc_keep_expr);
}

// box_iife_arm_values rewrites each arm's returned VALUE through
// try_fn_field_value — box_iife_arm_array_elems one container in, for an IIFE
// whose arms yield the fn value itself rather than an array of them. A nested
// IIFE arm recurses through try_fn_field_value's own IIFE case.
function box_iife_arm_values(stmts: ast.Stmt[], fd: parser.FuncDecl, vars: VarDecls, funcs: parser.FuncDecl[], counter: i32, gfns: string[], mfuncs: MFuncs, structs: irtables.StructTab): (ast.Stmt[], InlineCloAcc) {
  function vs(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) {
    match (s) {
      ast.StmtReturn(r) => {
        let vr: InlineCloRes = try_fn_field_value(r.value, fd, vars, a.funcs, a.counter, gfns, mfuncs, structs);
        return (ast.StmtReturn { value: vr.expr, line: r.line, col: r.col }, InlineCloAcc { funcs: vr.funcs, counter: vr.counter }, true);
      },
      ast.StmtIf(_) => {
        return (s, a, false);
      },
      ast.StmtMatch(_) => {
        return (s, a, false);
      },
      ast.StmtVar(_) => {
        return (s, a, true);
      },
      ast.StmtExpr(_) => {
        return (s, a, true);
      },
      ast.StmtAssign(_) => {
        return (s, a, true);
      },
      ast.StmtWhile(_) => {
        return (s, a, true);
      },
      ast.StmtFor(_) => {
        return (s, a, true);
      },
      ast.StmtDefer(_) => {
        return (s, a, true);
      },
      ast.StmtBreak(_) => {
        return (s, a, false);
      },
      ast.StmtContinue(_) => {
        return (s, a, false);
      },
      ast.StmtUnknown(_) => {
        return (s, a, false);
      }
    }
    return (s, a, true);
  }
  return astwalk.map_stmts_acc(stmts, InlineCloAcc { funcs: funcs, counter: counter }, vs, ilc_keep_expr);
}

// passthrough_array_arg returns the index of the erased-generic argument a
// passthrough call forwards when that argument leads to an ARRAY literal, or
// -1. The call yields exactly that literal, so an arm spelled `id([…])` carries
// the same elements an arm spelled `[…]` does.
//
// A forwarded argument may be a passthrough itself — `id(pick(c, […], […]))`,
// which fernsmith does not happen to emit but ordinary source does — so the
// walk follows the chain rather than demanding the literal one level in.
// passthrough_array_literal resolves the far end for the callers that need the
// elements themselves.
function passthrough_array_arg(c: ast.ExprCall, mfuncs: MFuncs): i32 {
  match (c.callee) {
    ast.ExprIdent(cid) => {
      let i: i32 = 0;
      while (i < c.args.len()) {
        if (lift_callee_is_typevar_passthrough(mfuncs, cid.name, i)
          && passthrough_leads_to_array(c.args[i], mfuncs)) {
          return i;
        }
        i = i + 1;
      }
    },
    _ => {}
  }
  return 0 - 1;
}

// passthrough_leads_to_array reports whether `e` is an array literal or a
// value-position if/match (whose arms hold the literals), or a chain of
// passthrough calls ending in one.
function passthrough_leads_to_array(e: ast.Expr, mfuncs: MFuncs): boolean {
  match (e) {
    ast.ExprArray(_) => {
      return true;
    },
    ast.ExprCall(c) => {
      return is_value_iife(c) || passthrough_array_arg(c, mfuncs) >= 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// A value-position if/match: the zero-parameter IIFE the desugar builds,
// called with nothing.
function is_value_iife(c: ast.ExprCall): boolean {
  if let ast.ExprLambda(il) = c.callee {
    return c.args.len() == 0 && il.params.len() == 0;
  }
  return false;
}

// passthrough_array_literal returns the array literal or value-position
// if/match at the far end of such a chain as a one-element list, or an empty
// one when there is none — the shape a caller can `match` without a second
// walk.
function passthrough_array_literal(e: ast.Expr, mfuncs: MFuncs): ast.Expr[] {
  match (e) {
    ast.ExprArray(_) => {
      return [e];
    },
    ast.ExprCall(c) => {
      if (is_value_iife(c)) {
        return [e];
      }
      let i: i32 = passthrough_array_arg(c, mfuncs);
      if (i < 0) {
        return [];
      }
      return passthrough_array_literal(c.args[i], mfuncs);
    },
    _ => {
      return [];
    }
  }
  return [];
}

// passthrough_rebuilt_with replaces the array literal at the far end of the
// chain with `repl`, keeping every call in between — so boxing the elements
// leaves `id(pick(c, [box…], […]))` shaped exactly as it was found.
function passthrough_rebuilt_with(e: ast.Expr, repl: ast.Expr, mfuncs: MFuncs): ast.Expr {
  match (e) {
    ast.ExprArray(_) => {
      return repl;
    },
    ast.ExprCall(c) => {
      if (is_value_iife(c)) {
        return repl;
      }
      let i: i32 = passthrough_array_arg(c, mfuncs);
      if (i < 0) {
        return e;
      }
      let na: ast.Expr[] = [];
      let k: i32 = 0;
      while (k < c.args.len()) {
        if (k == i) {
          na = na.append(passthrough_rebuilt_with(c.args[k], repl, mfuncs));
        } else {
          na = na.append(c.args[k]);
        }
        k = k + 1;
      }
      return ast.ExprCall { callee: c.callee, args: na, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    _ => {
      return e;
    }
  }
  return e;
}

// array_literal_boxes reports whether an array literal is a function array, and
// so has its elements lifted into env boxes.
function array_literal_boxes(arr: ast.ExprArray, fd: parser.FuncDecl, structs: irtables.StructTab, mfuncs: MFuncs): boolean {
  if (array_holds_fn_value(arr, mfuncs)) {
    return true;
  }
  for el in arr.elements {
    if (array_elem_is_env_boxed(el, fd, structs, mfuncs)) {
      return true;
    }
  }
  return false;
}

// array_holds_fn_value reports whether the literal has any fn-VALUED element, so
// the uniformity rule above applies to it at all (an i32[] never does).
function array_holds_fn_value(arr: ast.ExprArray, mfuncs: MFuncs): boolean {
  let i: i32 = 0;
  while (i < arr.elements.len()) {
    match (arr.elements[i]) {
      ast.ExprLambda(_) => {
        return true;
      },
      ast.ExprIdent(aid) => {
        if (lift_names_fn_value(mfuncs, aid.name)) {
          return true;
        }
      },
      ast.ExprCall(ac) => {
        match (ac.callee) {
          ast.ExprIdent(acid) => {
            let a: i32 = 0;
            while (a < ac.args.len()) {
              if (lift_callee_is_typevar_passthrough(mfuncs, acid.name, a)
                && lift_arg_is_fn_value(ac.args[a], mfuncs)) {
                return true;
              }
              a = a + 1;
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return false;
}

// fd_bound_names is fd's params plus every name its body binds — the shadowing
// set a bare ident must MISS to read as an unshadowed module function.
function fd_bound_names(fd: parser.FuncDecl): string[] {
  let acc: string[] = [];
  let p: i32 = 0;
  while (p < fd.params.len()) {
    acc = acc.append(fd.params[p].name);
    p = p + 1;
  }
  return astwalk.collect_bound_stmts(fd.body, acc);
}

// lift_callee_param_is_fn reports whether free function / method `callee`'s
// param `idx` is fn-typed (coarse type_name "fn"), reading the module funcs.
// lift_binding_param_is_fn is lift_callee_param_is_fn for a callee that is a
// BINDING of this function rather than a module function: a nested local
// function (`let helper = <lambda>`, #6341), a fn-typed parameter, a local
// annotated with a fn type, or a local initialised from a module function or
// another such binding (`let withRes = taker;`). The signature is read from
// wherever the binding declares it — the lambda's own params, the sidecars, or
// the function the initialiser names — never from a module function that only
// shares the binding's name: a fn-value argument the callee dispatches env-first
// has to arrive boxed, and a bare code address there is a segfault with no
// diagnostic.
function lift_binding_param_is_fn(fd: parser.FuncDecl, vars: VarDecls, callee: string, idx: i32, mfuncs: MFuncs): boolean {
  return binding_param_is_fn(fd, vars, callee, idx, mfuncs, 0);
}

function binding_param_is_fn(fd: parser.FuncDecl, vars: VarDecls, callee: string, idx: i32, mfuncs: MFuncs, depth: i32): boolean {
  for p in fd.params {
    if (p.name == callee) {
      return p.type_name == "fn" && spelled_param_is_fn(p.fn_param_types, idx);
    }
  }
  let d: i32 = first_var_decl(vars, callee);
  if (d < 0) {
    return false;
  }
  return var_param_is_fn(vars.decls[d], fd, vars, idx, mfuncs, depth);
}

// var_param_is_fn answers for one `let` binding: its annotation when it has
// one, else the lambda or the function its initialiser names. A chain of
// aliases is followed a bounded number of steps.
function var_param_is_fn(v: ast.StmtVar, fd: parser.FuncDecl, vars: VarDecls, idx: i32, mfuncs: MFuncs, depth: i32): boolean {
  let ann: ast.ParamDecl = decltypes.fn_param_from_var(v);
  if (ann.type_name != "fn") {
    ann = fn_param_from_spelling(v.name, v.type_name);
  }
  if (ann.type_name == "fn") {
    return spelled_param_is_fn(ann.fn_param_types, idx);
  }
  match (v.init) {
    ast.ExprLambda(lm) => {
      return idx < lm.params.len() && lm.params[idx].type_name == "fn";
    },
    ast.ExprIdent(src) => {
      if (util.index_of_str(fd_bound_names(fd), src.name) >= 0) {
        return depth < 8 && binding_param_is_fn(fd, vars, src.name, idx, mfuncs, depth + 1);
      }
      return lift_callee_param_is_fn(mfuncs, src.name, idx);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// spelled_param_is_fn: the idx-th spelling of a comma-separated parameter list
// is itself a fn type.
function spelled_param_is_fn(csv: string, idx: i32): boolean {
  let parts: string[] = split_type_list(csv);
  return idx < parts.len() && fn_param_from_spelling("", parts[idx]).type_name == "fn";
}

// VarDecls is every `var` of a function body, at any nesting depth, in
// spine order, with a name index over the bound names: the binding probes
// above ask it once per call argument, where they folded the body each time.
struct VarDecls { decls: ast.StmtVar[], names: util.NameIndex }

struct VarCollect { decls: ast.StmtVar[], names: string[] }

function var_decl_at(st: ast.Stmt, own acc: VarCollect): VarCollect {
  if let ast.StmtVar(v) = st {
    return VarCollect { decls: acc.decls.append(v), names: acc.names.append(v.name) };
  }
  return acc;
}

function var_decls_in(body: ast.Stmt[], own acc: VarCollect): VarCollect {
  for st in body {
    acc = astwalk.fold_stmt_spine(st, acc, var_decl_at);
  }
  return acc;
}

function var_decls_of(body: ast.Stmt[]): VarDecls {
  let c: VarCollect = var_decls_in(body, VarCollect { decls: [], names: [] });
  return VarDecls { decls: c.decls, names: util.name_index(c.names) };
}

// iife_scope_vars is var_decls_of for the declaration iife_scope_fd builds:
// the enclosing body's declarations, then the iife's.
function iife_scope_vars(vars: VarDecls, body: ast.Stmt[]): VarDecls {
  let c: VarCollect = var_decls_in(body, VarCollect { decls: vars.decls, names: vars.names.names });
  return VarDecls { decls: c.decls, names: util.name_index(c.names) };
}

// first_var_decl is the index of `name`'s first declaration in spine order,
// -1 for none.
function first_var_decl(vars: VarDecls, name: string): i32 {
  let i: i32 = vars.names.chain(name);
  while (i >= 0) {
    if (vars.names.names[i] == name) {
      return i;
    }
    i = vars.names.next[i];
  }
  return 0 - 1;
}

// MFuncs is the module function table plus a name index over it. The
// lift_callee_* predicates below answer "what does this callee look like?" once
// per call ARGUMENT, and they used to scan the whole table — ~4,600 entries on a
// whole-compiler module, with a string compare each — for a callee name that is
// constant across the argument loop. That was 74 of 400 profile samples, 18.5%
// of a self-compile, all under lift_inline_closures_expr
// (docs/PERFORMANCE-AUDIT-2026-08.md §4d.3).
//
// The index is a chain and not a single slot deliberately: a predicate keeps
// looking past a name match and answers true if ANY same-named decl satisfies
// its remaining conditions, so collapsing a name to one entry would change the
// verdict wherever two decls share a name.
pub struct MFuncs {
  decls: parser.FuncDecl[],
  // head[b] is the first decls index in bucket b (-1 when empty); next[i]
  // chains to the next index in the same bucket, ascending. head.len() IS the
  // bucket count, so the lookups cannot hash against a different modulus than
  // the build did.
  head: i32[],
  next: i32[],
}

// mfuncs_buckets is the bucket count of the name index. Prime, so unrelated
// hash strides do not alias onto one bucket, and sized so a whole-compiler
// module's ~4,600 functions sit at roughly one per bucket.
function mfuncs_buckets(): i32 {
  return 4093;
}

// mfuncs_table indexes `decls` by name. Built by walking BACKWARD and pushing
// each entry onto the front of its bucket, which leaves every chain in
// ascending index order without a per-bucket tail — the same order the linear
// scan visited, so a chain walk and a full scan agree on which same-named decl
// answers first. Mirrors checker.sig_table.
pub function mfuncs_table(decls: parser.FuncDecl[]): MFuncs {
  let head: i32[] = [];
  let b: i32 = 0;
  let nb: i32 = mfuncs_buckets();
  while (b < nb) {
    head = head.append(0 - 1);
    b = b + 1;
  }
  let next: i32[] = [];
  let j: i32 = 0;
  while (j < decls.len()) {
    next = next.append(0 - 1);
    j = j + 1;
  }
  let k: i32 = decls.len() - 1;
  while (k >= 0) {
    let bk: i32 = util.hash_bucket(decls[k].name, nb);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    k = k - 1;
  }
  return MFuncs { decls: decls, head: head, next: next };
}

// mfuncs_extend appends `extra` to an existing table and indexes only those, so
// growing the signature list for one worklist entry costs O(extra) instead of
// re-seeding all mfuncs_buckets() heads — which, done per entry, would be more
// work than the scan this index replaces.
//
// The appended entries land at the FRONT of their buckets, so an extended chain
// is not globally ascending. The two indexed predicates answer a BOOLEAN over
// "any same-named decl", so visit order cannot change their verdict; nothing
// else reads the chains.
pub function mfuncs_extend(base: MFuncs, extra: parser.FuncDecl[]): MFuncs {
  let decls: parser.FuncDecl[] = base.decls;
  let head: i32[] = base.head;
  let next: i32[] = base.next;
  let i: i32 = 0;
  while (i < extra.len()) {
    let k: i32 = decls.len();
    decls = decls.append(extra[i]);
    next = next.append(0 - 1);
    let bk: i32 = util.hash_bucket(extra[i].name, head.len());
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    i = i + 1;
  }
  return MFuncs { decls: decls, head: head, next: next };
}

// lift_callee_is_typevar_passthrough reports whether free function `callee`
// takes an ERASED type-var parameter at `idx` and returns that same type var —
// the `id[T](x: T): T` shape. An unbounded type param is erased rather than
// monomorphised, so the parameter keeps the spelling `T` and
// lift_callee_param_is_fn, which tests for the literal "fn", never matches it.
// A fn-value argument therefore reached lowering unlifted and asked for a
// `<fn>$clo` nothing built (#6466).
//
// The passthrough shape is what makes boxing safe here: the callee returns its
// argument unchanged, so whatever representation the argument has is the
// representation the result has. A generic that CONSUMES the value would need
// the env box to mean something to it.
function lift_callee_is_typevar_passthrough(mfuncs: MFuncs, callee: string, idx: i32): boolean {
  let i: i32 = mfuncs.head[util.hash_bucket(callee, mfuncs.head.len())];
  while (i >= 0) {
    if (mfuncs.decls[i].name == callee && mfuncs.decls[i].all_type_params.len() > 0
      && idx < mfuncs.decls[i].params.len()
      && mfuncs.decls[i].params[idx].type_name.len() > 0
      && mfuncs.decls[i].params[idx].type_name == mfuncs.decls[i].ret_type) {
      return true;
    }
    i = mfuncs.next[i];
  }
  return false;
}

function lift_callee_param_is_fn(mfuncs: MFuncs, callee: string, idx: i32): boolean {
  let i: i32 = mfuncs.head[util.hash_bucket(callee, mfuncs.head.len())];
  while (i >= 0) {
    if (mfuncs.decls[i].name == callee && idx < mfuncs.decls[i].params.len() && mfuncs.decls[i].params[idx].type_name == "fn") {
      return true;
    }
    i = mfuncs.next[i];
  }
  return false;
}

// lift_ident_is_param reports whether `name` is bound LOCALLY in `fd` — as its
// receiver, one of its parameters, or a `let` in its body. Any of those SHADOWS
// a module function of the same name, so a lift-pass path that would otherwise
// resolve a bare ident against the module function table has to check this
// first (#6191, see try_fn_field_value).
//
// The body scan is not redundant: it is what covers CAPTURES. A lambda
// lifted to a `$clo` function reads each captured value through a synthesized
// `let <cap> = __env[1+i]` at the top of its body, so inside the lifted
// function a capture is a local `let`, not a parameter. `std/fuzz`'s receiver
// method — `r.it(name, () => fuzz_run(seeds, iterations, target))` — captures
// `target` exactly that way, and it is the DOCUMENTED entry point, so a
// param-only guard would have left the real API broken while making the
// direct-call form look fixed.
function lift_ident_is_param(fd: parser.FuncDecl, name: string): boolean {
  if (fd.receiver_name == name && fd.receiver_name.len() > 0) {
    return true;
  }
  let i: i32 = 0;
  while (i < fd.params.len()) {
    if (fd.params[i].name == name) {
      return true;
    }
    i = i + 1;
  }
  let bound: string[] = [];
  let b: i32 = 0;
  while (b < fd.body.len()) {
    bound = astwalk.collect_bound_stmt(fd.body[b], bound);
    b = b + 1;
  }
  return util.index_of_str(bound, name) >= 0;
}

// lift_names_fn_value reports whether `name` is a receiver-less module function
// that a bare reference makes a function VALUE: any but a `const`, which reads as
// its value.
function lift_names_fn_value(mfuncs: MFuncs, name: string): boolean {
  for d in mfuncs.decls {
    if (d.name == name && d.receiver_type.len() == 0) {
      return !d.is_const;
    }
  }
  return false;
}

// lift_arg_is_fn_value reports whether `arg` is a fn-VALUE worth env-boxing at a
// variant-constructor payload position (`Some(f)` / `Ok(f)` / `Err(f)`): an
// inline lambda (capturing or not), or a bare module-fn-name ident naming a
// receiver-less function that is not a `const`. Anything else (a call returning an already-boxed value, a
// boxed fn-value local, a non-fn payload) is left alone — try_fn_field_value
// also declines those, but checking here keeps the Some/Ok/Err detection from
// firing on ordinary non-fn payloads.
function lift_arg_is_fn_value(arg: ast.Expr, mfuncs: MFuncs): boolean {
  match (arg) {
    ast.ExprLambda(_) => {
      return true;
    },
    ast.ExprIdent(id) => {
      return lift_names_fn_value(mfuncs, id.name);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// lift_arg_is_passthrough_fn_value is lift_arg_is_fn_value through any number of
// generic passthrough calls: `id(<lambda>)` hands the lambda straight back, so a
// position holding that call holds a fn value just as much as one holding the
// lambda. The read side (arr_elem_is_closure_box) already recurses this way, so
// without it the two sides disagreed about a nested passthrough — the boxing
// pass left the inner lambda raw and it reached lower_expr asking for a
// `<fd>$clo` nothing built (#6256).
function lift_arg_is_passthrough_fn_value(arg: ast.Expr, mfuncs: MFuncs): boolean {
  if (lift_arg_is_fn_value(arg, mfuncs)) {
    return true;
  }
  match (arg) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          let i: i32 = 0;
          while (i < c.args.len()) {
            if (lift_callee_is_typevar_passthrough(mfuncs, cid.name, i)
              && lift_arg_is_passthrough_fn_value(c.args[i], mfuncs)) {
              return true;
            }
            i = i + 1;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return false;
}

// array_elem_is_env_boxed reports whether an ARRAY-literal element already
// arrives as an env box, which puts the whole literal on the env-first dispatch
// ABI (#5071): any lambda (a capturing one boxes as [funcval, caps…], a
// non-capturing one as a `$wrap` trampoline, since a bare fn pointer is not a
// value the semantic source can produce); a value-position `if`/`match`,
// whose hoist yields a box for either kind of arm lambda (#6256); and a
// generic passthrough call handing either straight back (`id(<lambda>)`,
// `pick(c, <iife>, …)`), whose boxing at the erased-generic parameter is
// unconditional.
//
// This is the one place that answers the question, and `ilc_expr_at`'s
// ExprArray arm boxes exactly what it says.
function array_elem_is_env_boxed(e: ast.Expr, fd: parser.FuncDecl, structs: irtables.StructTab, mfuncs: MFuncs): boolean {
  match (e) {
    ast.ExprLambda(_) => {
      return true;
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprLambda(il) => {
          return c.args.len() == 0 && il.params.len() == 0
            && iife_arms_have_unboxed_fn(il.body, iife_scope_fd(fd, il.body), mfuncs)
            && iife_arms_hold_fn_value(il.body, fd, structs, mfuncs);
        },
        ast.ExprIdent(cid) => {
          let i: i32 = 0;
          while (i < c.args.len()) {
            if (lift_callee_is_typevar_passthrough(mfuncs, cid.name, i)
              && (lift_arg_is_passthrough_fn_value(c.args[i], mfuncs)
              || array_elem_is_env_boxed(c.args[i], fd, structs, mfuncs))) {
              return true;
            }
            i = i + 1;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return false;
}

// lift_method_arg_is_fn decides whether a METHOD-call argument (`recv.m(arg)`)
// should be wrapped into an env box. Scoped to the map-value slice (#3445): an
// inline lambda whose method param is NOT a declared user fn-param. The negation
// is the key discriminator —
//   * a Map value slot `Map[K, () => V]` lowers `.set`/`.insert` to the builtin
//     op_map_set, and the method's value parameter is the GENERIC `V` (coarse
//     type, not literally "fn"), so lift_callee_param_is_fn is FALSE → wrap the
//     lambda into a box to STORE; the retrieval-side match-binding (#3466)
//     dispatches it env-first.
//   * a USER method with a DECLARED fn-param (`r.bench(name, iter, fn: () => void)`)
//     has lift_callee_param_is_fn TRUE → NOT wrapped here, so it keeps its
//     existing path (bare dispatch / AST-bail). Converting those to the env-box
//     ABI destabilises the byte-identical self-host fixpoint, so the full
//     uniform-ABI unification for user-method fn-args stays a deferred slice.
// Only an inline lambda qualifies. A bare fn-NAME reaching a builtin value slot
// is a shape the array stores do have, and lift_arr_store_arg_is_fn_name answers
// it for `.with`/`.append`; the map-value slot has no such shape. #3445.
function lift_method_arg_is_fn(arg: ast.Expr, mfield: string, idx: i32, mfuncs: MFuncs): boolean {
  match (arg) {
    ast.ExprLambda(_) => {
      return !lift_callee_param_is_fn(mfuncs, mfield, idx);
    },
    _ => {}
  }
  return false;
}

// lift_arr_store_arg_is_fn_name reports whether a `.with(i, v)` / `.append(v)`
// VALUE argument is a bare UNSHADOWED module-function name. The store deposits
// one element into a clone of the receiver, and fd_stores_fn_value_array has
// already put that receiver's literal on the env-box ABI, so the name has to be
// wrapped into a `$wrapN` trampoline box exactly as a fn-name array ELEMENT is —
// otherwise the clone holds a bare code pointer among boxes and the read side
// dereferences it. A zero-arg receiver-less fn is a `const` desugar whose VALUE
// must flow, so arity 1+ is required (mirrors the array/tuple ident rule).
function lift_arr_store_arg_is_fn_name(arg: ast.Expr, mfield: string, idx: i32, fd: parser.FuncDecl, mfuncs: MFuncs): boolean {
  if (!(mfield == "with" && idx == 1 || mfield == "append" && idx == 0)) {
    return false;
  }
  match (arg) {
    ast.ExprIdent(aid) => {
      if (!lift_names_fn_value(mfuncs, aid.name)) {
        return false;
      }
      return util.index_of_str(fd_bound_names(fd), aid.name) < 0;
    },
    _ => {}
  }
  return false;
}

// ---- fn-valued arms of a value-position if / match (#6256, #7438) ----------
//
// A value-position `if` / `match` parses as an IIFE — `ExprCall{callee:
// ExprLambda{params: [], body: [StmtIf|StmtMatch]}}`. Left alone, its arms are
// STATEMENTS inside an expression, so no closure-lift pass reaches them: a
// fn-valued arm reached lower_expr as a bare ExprLambda and asked for a
// `<cur_fn>$clo` nothing had built (a module bail), and a no-capture one was
// worse — lift_call_arg hoisted it to a bare `__lam_N` fn POINTER while the
// destination dispatched the result env-first as a box, so the call loaded a
// "box slot 0" out of a function's first code bytes and jumped through it.
//
// So the IIFE is hoisted to a real top-level function taking its captures as
// ORDINARY PARAMETERS. An IIFE is applied immediately, so its captures need no
// env box — by-value params carry them, which also lifts the i64/u64/f64
// restriction the env box imposes (cap_slot_ok rejects a wide scalar; a param
// does not). The call site becomes `<fd>$iifeN(caps…)`, an ordinary direct call
// returning a fn value — the shape a local binding and a `return` already
// dispatch env-first, which is what makes the RESULT usable and not just the
// arms well-formed. Boxing the arms alone left the destination unmarked and
// turned a bail into a SIGSEGV.
//
// The hoist runs whether or not the IIFE captures. A no-capture one becoming a
// `__lam_N` FuncDecl is NOT equivalent: the worklist drain deliberately withholds
// the `return <lambda>` desugar from lifted bodies (#5281, the curry shape), which
// is the very rewrite that turns an arm lambda into a boxed closure local — so the
// arm stayed a bare pointer (#7438). hoist_value_iife applies that desugar itself.
//
// Gated on the IIFE holding a fn-VALUED arm; everything else keeps its path.
// iife_arms_have_unboxed_fn reports whether any arm of a value-position
// if/match yields a function value nothing has boxed yet: an inline LAMBDA —
// directly, or through a generic passthrough call that hands it back unchanged
// — or a bare module function name. Those are the only things the hoist is
// needed for.
//
// The two halves of #6256 must not both fire on the same IIFE. An IIFE whose
// arms are all already-boxed fn values (closure locals) needs no hoist at all:
// #6323's clo_init marking recognises the IIFE init directly and binds the
// destination as a closure local. Hoisting it would REPLACE the IIFE with an
// ordinary call, so that marking no longer matches — measured, it turned three
// green shapes back into SIGSEGVs. A lambda or function-name arm is different:
// nothing has boxed it yet, so it needs to become a FuncDecl for the ordinary
// passes to reach.
//
// So the hoist takes the unboxed-arm case and #6323 takes the boxed-arm case,
// and a MIXED IIFE (Repro D — one closure-local arm, one lambda) hoists,
// because the lambda is the binding constraint.
function iife_arms_have_unboxed_fn(stmts: ast.Stmt[], fd: parser.FuncDecl, mfuncs: MFuncs): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        if (arm_value_is_unboxed_fn(r.value, fd, mfuncs)) {
          return true;
        }
      },
      ast.StmtAssign(a) => {
        if (is_arm_value_store(a) && arm_value_is_unboxed_fn(a.value, fd, mfuncs)) {
          return true;
        }
      },
      ast.StmtIf(iff) => {
        if (iife_arms_have_unboxed_fn(iff.then_body, fd, mfuncs)) {
          return true;
        }
        if (iife_arms_have_unboxed_fn(iff.else_body, fd, mfuncs)) {
          return true;
        }
      },
      ast.StmtMatch(mm) => {
        let a: i32 = 0;
        while (a < mm.arms.len()) {
          if (iife_arms_have_unboxed_fn(mm.arms[a].body, fd, mfuncs)) {
            return true;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

function arm_value_is_unboxed_fn(e: ast.Expr, fd: parser.FuncDecl, mfuncs: MFuncs): boolean {
  if let ast.ExprIdent(id) = e {
    return arm_names_module_fn(id.name, fd, mfuncs);
  }
  return passthrough_arg_has_lambda(e, fd, mfuncs);
}

// arm_names_module_fn: a bare name in an arm is a module function's address,
// not a local or parameter that shadows one (#6191).
function arm_names_module_fn(name: string, fd: parser.FuncDecl, mfuncs: MFuncs): boolean {
  return !lift_ident_is_param(fd, name) && lift_names_fn_value(mfuncs, name);
}

// passthrough_arg_has_lambda reports whether `e` is a raw lambda, directly or at
// the erased-generic parameter of a passthrough call that hands it straight back
// (`pick(c, v0, <lambda>)`). Nothing has boxed such a lambda, and the expression
// walk stops at the IIFE that holds it, so only the hoist puts it where the
// ordinary passes can reach it.
//
// An arm that is ITSELF a value-position if/match holds its lambdas one level
// in, and the walk stops at that nested IIFE for the same reason it stops at the
// outer one, so the question recurses through it.
function passthrough_arg_has_lambda(e: ast.Expr, fd: parser.FuncDecl, mfuncs: MFuncs): boolean {
  match (e) {
    ast.ExprLambda(_) => {
      return true;
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          let i: i32 = 0;
          while (i < c.args.len()) {
            if (lift_callee_is_typevar_passthrough(mfuncs, cid.name, i)
              && passthrough_arg_has_lambda(c.args[i], fd, mfuncs)) {
              return true;
            }
            i = i + 1;
          }
        },
        ast.ExprLambda(il) => {
          if (c.args.len() == 0 && il.params.len() == 0) {
            return iife_arms_have_unboxed_fn(il.body, fd, mfuncs);
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return false;
}

// is_arm_value_store reports whether `a` is an arm yielding its value the way
// the tuple / struct / nested-pattern match desugars do: by storing it into the
// expression's value local (IfChain.value_local) rather than returning it.
function is_arm_value_store(a: ast.StmtAssign): boolean {
  return parser.is_value_local_name(lexical.source_name(a.target));
}

// iife_return_holds_fn_value: does an arm's returned value yield a fn? A
// fn-typed LOCAL or PARAM arm (`(if (c) { v0 } else { … })`) is a fn value
// too, though lift_arg_is_fn_value declines it — that predicate answers "is
// this worth env-boxing?", and an already-boxed local is not — so the
// declared type answers it. A nested value-position if/match arm yields
// whatever its own arms yield, so the question descends into it.
function iife_return_holds_fn_value(v: ast.Expr, fd: parser.FuncDecl, structs: irtables.StructTab, mfuncs: MFuncs): boolean {
  if (lift_arg_is_fn_value(v, mfuncs)) {
    return true;
  }
  match (v) {
    ast.ExprIdent(aid) => {
      return aid.ty == "fn";
    },
    ast.ExprCall(rc) => {
      if let ast.ExprLambda(ril) = rc.callee {
        return rc.args.len() == 0 && ril.params.len() == 0 && iife_arms_hold_fn_value(ril.body, fd, structs, mfuncs);
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function iife_arms_hold_fn_value(stmts: ast.Stmt[], fd: parser.FuncDecl, structs: irtables.StructTab, mfuncs: MFuncs): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(a) => {
        if (is_arm_value_store(a) && lift_arg_is_fn_value(a.value, mfuncs)) {
          return true;
        }
      },
      ast.StmtReturn(r) => {
        if (iife_return_holds_fn_value(r.value, fd, structs, mfuncs)) {
          return true;
        }
      },
      ast.StmtIf(iff) => {
        if (iife_arms_hold_fn_value(iff.then_body, fd, structs, mfuncs)) {
          return true;
        }
        if (iife_arms_hold_fn_value(iff.else_body, fd, structs, mfuncs)) {
          return true;
        }
      },
      ast.StmtMatch(mm) => {
        let a: i32 = 0;
        while (a < mm.arms.len()) {
          if (iife_arms_hold_fn_value(mm.arms[a].body, fd, structs, mfuncs)) {
            return true;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

// iife_arms_return_fn_array_literal reports whether any arm of a
// value-position if/match returns a function-array literal — directly, through
// a generic passthrough, or one nested if/match in — which
// box_iife_arm_array_elems then boxes. An arm yielding any other function
// array (a parameter, a local, a call's result) needs nothing: every function
// array is built on the env-box ABI (#10076).
//
// The literal question is array_literal_boxes, the same one the
// single-literal rule asks, so the two cannot disagree about a literal
// (#8151, #8795). Captures read against iife_scope_fd, so a name the IIFE itself
// binds (a match arm's payload) counts; `fd` arrives scoped.
function iife_arms_return_fn_array_literal(stmts: ast.Stmt[], fd: parser.FuncDecl, structs: irtables.StructTab, mfuncs: MFuncs): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        let lit: ast.Expr[] = passthrough_array_literal(r.value, mfuncs);
        if (lit.len() == 0) {
          continue;
        }
        match (lit[0]) {
          ast.ExprArray(arr) => {
            if (array_literal_boxes(arr, fd, structs, mfuncs)) {
              return true;
            }
          },
          ast.ExprCall(ic) => {
            if let ast.ExprLambda(il) = ic.callee {
              if (iife_arms_return_fn_array_literal(il.body, iife_scope_fd(fd, il.body), structs, mfuncs)) {
                return true;
              }
            }
          },
          _ => {}
        }
      },
      ast.StmtIf(iff) => {
        if (iife_arms_return_fn_array_literal(iff.then_body, fd, structs, mfuncs)) {
          return true;
        }
        if (iife_arms_return_fn_array_literal(iff.else_body, fd, structs, mfuncs)) {
          return true;
        }
      },
      ast.StmtMatch(mm) => {
        for arm in mm.arms {
          if (iife_arms_return_fn_array_literal(arm.body, fd, structs, mfuncs)) {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  return false;
}

// box_iife_arm_array_elems rewrites every element of every arm's array literal
// through try_fn_field_value — a capturing lambda becomes a `__mkclo$<fd>$cloN`
// env box, a no-capture lambda / bare fn name a `$wrapN` trampoline box, an
// already-boxed value flows through. Same uniform-box treatment #5071 gives one
// mixed array literal; any other arm value takes the ordinary expression lift.
function box_iife_arm_array_elems(stmts: ast.Stmt[], fd: parser.FuncDecl, vars: VarDecls, funcs: parser.FuncDecl[], counter: i32, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs): (ast.Stmt[], InlineCloAcc) {
  function vs(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) {
    match (s) {
      ast.StmtReturn(r) => {
        let fs: parser.FuncDecl[] = a.funcs;
        let ct: i32 = a.counter;
        let nv: ast.Expr = r.value;
        match (r.value) {
          ast.ExprArray(arr) => {
            let nelems: ast.Expr[] = [];
            let e: i32 = 0;
            while (e < arr.elements.len()) {
              let er: InlineCloRes = try_fn_field_value(arr.elements[e], fd, vars, fs, ct, gfns, mfuncs, structs);
              fs = er.funcs;
              ct = er.counter;
              nelems = nelems.append(er.expr);
              e = e + 1;
            }
            nv = ast.ExprArray { ...arr, elements: nelems };
          },
          ast.ExprCall(rc) => {
            // A nested value-position if/match arm: box the arrays its own
            // arms return, matching the gate's recursion through the same
            // shape (iife_arms_return_fn_array_literal).
            match (rc.callee) {
              ast.ExprLambda(ril) => {
                if (rc.args.len() == 0 && ril.params.len() == 0) {
                  let (nbs, nba) = box_iife_arm_array_elems(ril.body, iife_scope_fd(fd, ril.body), iife_scope_vars(vars, ril.body), fs, ct, gfns, structs, mfuncs);
                  fs = nba.funcs;
                  ct = nba.counter;
                  let nlam: ast.Expr = ast.ExprLambda { ...ril, body: nbs };
                  nv = ast.ExprCall { callee: nlam, args: rc.args, line: rc.line, col: rc.col, type_args: rc.type_args, ty: rc.ty };
                }
              },
              ast.ExprIdent(_) => {
                // The array a passthrough forwards: box its elements
                // where they sit, so the call still hands back the same
                // literal and the arms stay uniform.
                let pl2: ast.Expr[] = passthrough_array_literal(r.value, mfuncs);
                if (pl2.len() > 0) {
                  match (pl2[0]) {
                    ast.ExprArray(parr2) => {
                      let pnel: ast.Expr[] = [];
                      let pj: i32 = 0;
                      while (pj < parr2.elements.len()) {
                        let per: InlineCloRes = try_fn_field_value(parr2.elements[pj], fd, vars, fs, ct, gfns, mfuncs, structs);
                        fs = per.funcs;
                        ct = per.counter;
                        pnel = pnel.append(per.expr);
                        pj = pj + 1;
                      }
                      nv = passthrough_rebuilt_with(r.value, ast.ExprArray { ...parr2, elements: pnel }, mfuncs);
                    },
                    ast.ExprCall(pc2) => {
                      if let ast.ExprLambda(pil2) = pc2.callee {
                        let (pbs, pba) = box_iife_arm_array_elems(pil2.body, iife_scope_fd(fd, pil2.body), iife_scope_vars(vars, pil2.body), fs, ct, gfns, structs, mfuncs);
                        fs = pba.funcs;
                        ct = pba.counter;
                        let plam: ast.Expr = ast.ExprLambda { ...pil2, body: pbs };
                        nv = passthrough_rebuilt_with(r.value, ast.ExprCall { callee: plam, args: pc2.args, line: pc2.line, col: pc2.col, type_args: pc2.type_args, ty: pc2.ty }, mfuncs);
                      }
                    },
                    _ => {}
                  }
                } else {
                  let ocr: InlineCloRes = lift_inline_closures_expr(r.value, fd, vars, fs, ct, gfns, structs, mfuncs);
                  fs = ocr.funcs;
                  ct = ocr.counter;
                  nv = ocr.expr;
                }
              },
              _ => {}
            }
          },
          _ => {
            // Any other function array is already on the env-box ABI;
            // what it is built from still takes the ordinary lift.
            let oer: InlineCloRes = lift_inline_closures_expr(r.value, fd, vars, fs, ct, gfns, structs, mfuncs);
            fs = oer.funcs;
            ct = oer.counter;
            nv = oer.expr;
          }
        }
        return (ast.StmtReturn { value: nv, line: r.line, col: r.col }, InlineCloAcc { funcs: fs, counter: ct }, true);
      },
      ast.StmtIf(_) => {
        return (s, a, false);
      },
      ast.StmtMatch(_) => {
        return (s, a, false);
      },
      ast.StmtVar(_) => {
        return (s, a, true);
      },
      ast.StmtExpr(_) => {
        return (s, a, true);
      },
      ast.StmtAssign(_) => {
        return (s, a, true);
      },
      ast.StmtWhile(_) => {
        return (s, a, true);
      },
      ast.StmtFor(_) => {
        return (s, a, true);
      },
      ast.StmtDefer(_) => {
        return (s, a, true);
      },
      ast.StmtBreak(_) => {
        return (s, a, false);
      },
      ast.StmtContinue(_) => {
        return (s, a, false);
      },
      ast.StmtUnknown(_) => {
        return (s, a, false);
      }
    }
    return (s, a, true);
  }
  return astwalk.map_stmts_acc(stmts, InlineCloAcc { funcs: funcs, counter: counter }, vs, ilc_keep_expr);
}

// hoist_value_iife builds `<fd>$iifeN(caps…)` from the IIFE lambda and
// returns the direct call that replaces it. Declines — signalled by returning
// the counter unchanged — when any capture's type does not resolve, leaving the
// IIFE exactly as it was so the module bails as before. A capture-free IIFE
// hoists to a zero-parameter `<fd>$iifeN()`.
function hoist_value_iife(lam: ast.ExprLambda, fd: parser.FuncDecl, funcs: parser.FuncDecl[], counter: i32, structs: irtables.StructTab, mfuncs: MFuncs): InlineCloRes {
  let caps: string[] = lambda_captures(lam, fd);
  let ps: ast.ParamDecl[] = [];
  let args: ast.Expr[] = [];
  let ci: i32 = 0;
  while (ci < caps.len()) {
    // The declaration adapter preserves the exact checked callable ABI.
    let cp: ast.ParamDecl = lambda_capture_param(lam, caps[ci]);
    if (cp.type_name.len() == 0) {
      return InlineCloRes { expr: ast.ExprLambda { ...lam, body: lam.body }, funcs: funcs, counter: counter };
    }
    ps = ps.append(cp);
    args = args.append(ast.ExprIdent { name: caps[ci], line: 0, col: 0, ty: "" });
    ci = ci + 1;
  }
  let nm: string = clo_owner_name(fd) + "$iife" + util.i32_to_string(counter);
  let notp: string[] = [];
  // Declared `fn` return, not the IIFE lambda's own ret_type. The hoist only
  // fires when the arms yield a fn value, so this function IS a higher-order
  // factory, and closure_ret_fns_of's "return <ident bound to a closure>" form
  // is gated on exactly that declaration. Without it a MIXED IIFE (one closure-
  // local arm, one lambda) hoisted to a call the caller then bound as a plain
  // scalar — `w(3)` bare-dispatched the box and SIGSEGV'd, turning a bail into
  // a crash. The coarse "fn" tag is what a hand-written fn-returning function
  // carries, so this is the same declaration, not a special case.
  // The arms are USER code, so they get the same `return <lambda>` desugar the
  // worklist gives a source function (`let $lamret$N = <lambda>; return
  // $lamret$N;`), so each arm's lambda lifts through the local binding to a
  // uniquely-named `<nm>$cloN` box, one per arm. The hoisted body is built
  // here rather than drained onto the worklist, so it is desugared here.
  // e_lambda_origin gives a synthesised IIFE an empty sidecar pair, so for an
  // if/match-expression arm the contract has to come from the arm itself,
  // and the `$lamret$N` slot the desugar binds each arm's lambda to is
  // declared with that contract, the way a source function's is with its own.
  let fnret: string = lam.ret_fn_ret;
  let fnptys: string = lam.ret_fn_param_types;
  if (fnret.len() == 0) {
    let (armret, armptys) = returned_fn_contract(lam.body, caps, mfuncs);
    fnret = armret;
    fnptys = armptys;
  }
  let dlr: DesugarRet = desugar_lambda_returns(lam.body, 0, ret_sig_of("fn", fnret, fnptys));
  let nf: parser.FuncDecl = parser.FuncDecl { stdlib: "", no_inline: false, name: nm, receiver_name: "", receiver_type: "", receiver_own: false, type_params: notp, params: ps, ret_type: "fn", body: dlr.body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: fnret, ret_fn_param_types: fnptys, is_package: false, module: fd.module, impl_trait: "", dyn_traits: [], streams: [] };
  let ncall: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: nm, line: 0, col: 0, ty: "" }, args: args, line: 0, col: 0, type_args: [], ty: "" };
  return InlineCloRes { expr: ncall, funcs: funcs.append(nf), counter: counter + 1 };
}

// lift_inline_closures_expr walks an expression, hoisting capturing inline
// lambdas in array-element and struct-field-value positions, AND wrapping
// fn-typed CALL ARGUMENTS into uniform env boxes (slice #3445 follow-up). A call
// `g(a0, a1, …)` whose callee `g` has a fn-typed param at position i has its
// argument ai routed through try_fn_field_value — the SAME env-box wrapper the
// struct-field path uses: a capturing inline lambda → `__mkclo$<fd>$cloN(caps…)`
// box [funcval, caps…]; a no-capture lambda / bare module-fn-name → a `$wrapN`
// env-ignoring trampoline → box [funcval]; an already-boxed value (a boxed
// fn-value local ident, a closure param/local, a `mk()` call returning a
// closure) flows UNWRAPPED. This makes EVERY fn-value argument an env box so the
// callee's fn-typed param (marked a closure local by the lowering) dispatches it
// env-first. Running BEFORE the no-capture __lam_N lift means a no-capture
// lambda / fn-name arg becomes a `__mkclo$…` marker the later lift leaves alone,
// so the two arg representations never disagree — there is one fn-arg shape, the box.
// Non-aggregate forms recurse so an array/struct nested inside them is still
// reached; a bare lambda in any other position is left untouched (handled by the
// other lift passes or kept on AST).
//
// ilc_expr_at is that walk's visitor on astwalk's rewrite spine
// (lift_inline_closures_expr wraps it): parent-directed dispatch is
// irreducible policy, so the aggregate arms (call / array / tuple / struct
// literal) claim their whole subtree and rebuild the child slots themselves,
// in the hand order, re-entering the walk through lift_inline_closures_expr
// for exactly the slots the walk owns. ExprLambda / ExprSlice / ExprMapLit /
// ExprFString are claimed UNCHANGED: this pass has never descended into them,
// and a wider walk would box lambdas in positions the lift has never reached.
// Everything else declines and the spine carries the recursion.
function ilc_expr_at(e: ast.Expr, acc: InlineCloAcc, fd: parser.FuncDecl, vars: VarDecls, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs): (ast.Expr, InlineCloAcc, boolean) {
  match (e) {
    ast.ExprCall(call) => {
      // Wrap each fn-typed-param argument into an env box; recurse the rest
      // (so a nested aggregate / fn-arg call inside a non-fn argument is
      // still reached). A bare-ident callee names the function whose param
      // types we consult; a `__mkclo$…` marker callee (this pass's own
      // output) has no fn-typed-param signature, so its args just recurse.
      let cnm: string = "";
      // A METHOD callee `recv.m(args)` (FieldAccess, non-numeric field):
      // wrap an inline-lambda argument stored into a Map value slot
      // (`m.set(1, <lambda>)`) into the env box, so a `Map[K, () => V]`
      // closure value is stored as a box the retrieval-side match-binding
      // (#3466) dispatches env-first (slice #3445 map-values). The wrap
      // decision (lift_method_arg_is_fn) fires only for a lambda whose method
      // param is NOT a declared user fn-param — a map value lowers to the
      // builtin op_map_set with a generic `V` param, whereas a user method's
      // declared fn-param keeps its existing bare-dispatch / AST-bail path
      // (env-box-unifying those would break the byte-identical fixpoint). A
      // numeric field (`t.0(args)`, a fn-valued tuple element call) is left
      // to its own path. #3445.
      let mfield: string = "";
      match (call.callee) {
        ast.ExprIdent(cid) => {
          cnm = cid.name;
        },
        ast.ExprFieldAccess(cfa) => {
          if (!util.is_all_digits(cfa.field)) {
            mfield = cfa.field;
          }
        },
        _ => {}
      }
      let is_mkclo: boolean = cnm.len() > 8 && slice_unchecked(cnm, 0, 8) == "__mkclo$";
      // A single-arg Option/Result variant constructor `Some(f)` / `Ok(f)`
      // / `Err(f)` whose payload is a fn-VALUE (slice #3445 match-fn): wrap
      // that payload into the uniform env box the SAME way a fn-typed
      // struct-field / call-arg is wrapped, so when the match arm binds the
      // payload (`Some(f) => f()`) it dispatches env-first against a real
      // box. A non-fn-value payload is left untouched (lift_arg_is_fn_value
      // declines it). The wrap only fires for exactly one argument; multi-
      // arg shapes (none of Some/Ok/Err take >1) fall through.
      let is_optvar: boolean = (cnm == "Some" || cnm == "Ok" || cnm == "Err") && call.args.len() == 1;
      let fs: parser.FuncDecl[] = acc.funcs;
      let ct: i32 = acc.counter;
      let nargs: ast.Expr[] = [];
      let ai: i32 = 0;
      while (ai < call.args.len()) {
        if (is_optvar && lift_arg_is_fn_value(call.args[ai], mfuncs)) {
          let ofr: InlineCloRes = try_fn_field_value(call.args[ai], fd, vars, fs, ct, gfns, mfuncs, structs);
          fs = ofr.funcs;
          ct = ofr.counter;
          nargs = nargs.append(ofr.expr);
        } else if (!is_mkclo && cnm.len() > 0 && irtables.decl_is_struct(structs, cnm)
          && irtables.decl_field_type_at(structs, cnm, ai) == "fn"
          && lift_arg_is_fn_value(call.args[ai], mfuncs)) {
          // A USER-ENUM variant constructor (`Wrap(f)`, `Pending(n, k)`)
          // whose field at position ai is fn-typed: wrap the fn-value
          // payload into the uniform env box — exactly like the
          // Option/Result is_optvar path above — so a capturing
          // closure becomes a real box the slice-5 match-arm bind
          // (mark_closure_local) dispatches env-first against. Without
          // this, a capturing-lambda payload stayed raw and bailed the
          // module to AST (slice 5b; bare/non-capturing already worked).
          let vfr: InlineCloRes = try_fn_field_value(call.args[ai], fd, vars, fs, ct, gfns, mfuncs, structs);
          fs = vfr.funcs;
          ct = vfr.counter;
          nargs = nargs.append(vfr.expr);
        } else if (!is_mkclo && cnm.len() > 0 && (lift_callee_param_is_fn(mfuncs, cnm, ai) || lift_binding_param_is_fn(fd, vars, cnm, ai, mfuncs))) {
          let fr: InlineCloRes = try_fn_field_value(call.args[ai], fd, vars, fs, ct, gfns, mfuncs, structs);
          fs = fr.funcs;
          ct = fr.counter;
          nargs = nargs.append(fr.expr);
        } else if (!is_mkclo && cnm.len() > 0 && lift_callee_is_typevar_passthrough(mfuncs, cnm, ai)
          && lift_arg_is_fn_value(call.args[ai], mfuncs)) {
          // A fn value at an ERASED-GENERIC parameter (`id(<lambda>)`).
          // The declared parameter reads `T`, so the fn-typed gate above
          // cannot see it; box it here like every other fn-value argument
          // position. The binding the result lands in is marked a closure
          // local by lower_stmt_var's `__mkclo$`-argument rule, so the
          // box the passthrough returns is dispatched as one rather than
          // bare-called (#6466 records what that costs when it is not).
          let gr: InlineCloRes = try_fn_field_value(call.args[ai], fd, vars, fs, ct, gfns, mfuncs, structs);
          fs = gr.funcs;
          ct = gr.counter;
          nargs = nargs.append(gr.expr);
        } else if (mfield.len() > 0 && (lift_callee_param_is_fn(mfuncs, mfield, ai)
          || lift_method_arg_is_fn(call.args[ai], mfield, ai, mfuncs)
          || lift_arr_store_arg_is_fn_name(call.args[ai], mfield, ai, fd, mfuncs))) {
          // Method-call fn-value argument (`m.set(1, <lambda>)`): wrap into
          // the env box so the stored / called value is a uniform box. #3445.
          let mr: InlineCloRes = try_fn_field_value(call.args[ai], fd, vars, fs, ct, gfns, mfuncs, structs);
          fs = mr.funcs;
          ct = mr.counter;
          nargs = nargs.append(mr.expr);
        } else {
          let er: InlineCloRes = lift_inline_closures_expr(call.args[ai], fd, vars, fs, ct, gfns, structs, mfuncs);
          fs = er.funcs;
          ct = er.counter;
          nargs = nargs.append(er.expr);
        }
        ai = ai + 1;
      }
      // Recurse into a NON-IDENT callee — a method callee `recv.m(args)`
      // whose receiver `recv` is itself an expression. Without this, a
      // fn-arg-taking call in RECEIVER position (`take_while(c, lt5).len()`)
      // was never reached: its fn-typed argument stayed a raw const_func
      // while the callee's fn param (marked a closure local in lower_func)
      // dispatched it env-first — loading a "box slot 0" from a bare code
      // pointer and jumping to garbage (SIGSEGV, #4767). Binding the call
      // to a var first dodged it only because a var-init IS walked. An
      // ident callee is left alone: a bare callee NAME is a call target,
      // not a fn VALUE use (mirrors value_use_idents_expr).
      let ncallee: ast.Expr = call.callee;
      match (call.callee) {
        ast.ExprIdent(_) => {},
        ast.ExprLambda(ielam) => {
          // An IIFE holding a fn-valued arm — the value-position
          // if/match desugar — leaves its arms where no lift walks them
          // and its destination unmarked (#6256). Hoist it into a real
          // function taking its captures as params; the call that
          // replaces it is an ordinary fn-value-returning call both a
          // binding and a return already handle.
          if (call.args.len() == 0 && ielam.params.len() == 0
            && iife_arms_have_unboxed_fn(ielam.body, iife_scope_fd(fd, ielam.body), mfuncs)
            && iife_arms_hold_fn_value(ielam.body, fd, structs, mfuncs)) {
            let iar: InlineCloRes = hoist_value_iife(ielam, fd, fs, ct, structs, mfuncs);
            if (iar.counter > ct) {
              fs = iar.funcs;
              ct = iar.counter;
              return (iar.expr, InlineCloAcc { funcs: fs, counter: ct }, true);
            }
          }
          // An IIFE the hoist does not claim keeps its arms inline, and
          // this is the only place they are reachable: the arms are
          // STATEMENTS inside an expression, so the expression walk
          // stops here. A capturing lambda in an arm's ARRAY literal
          // would otherwise never get its `__mkclo$<fd>$cloN` marker.
          if (call.args.len() == 0 && ielam.params.len() == 0
            && iife_arms_return_fn_array_literal(ielam.body, iife_scope_fd(fd, ielam.body), structs, mfuncs)) {
            let (ibrs, ibra) = box_iife_arm_array_elems(ielam.body, iife_scope_fd(fd, ielam.body), iife_scope_vars(vars, ielam.body), fs, ct, gfns, structs, mfuncs);
            if (ibra.counter > ct) {
              fs = ibra.funcs;
              ct = ibra.counter;
              ncallee = ast.ExprLambda { ...ielam, body: ibrs };
            }
          }
          // The arms' own CONDITION is the one part of an inline IIFE
          // nothing above reaches (#6571): both paths walk what the arms
          // RETURN, neither walks what selects them. Runs on whichever
          // body the boxing above settled on, so the two compose rather
          // than racing for the same node.
          if (call.args.len() == 0 && ielam.params.len() == 0) {
            let iebody: ast.Stmt[] = ielam.body;
            if let ast.ExprLambda(nl) = ncallee {
              iebody = nl.body;
            }
            let (icrs, icra) = lift_iife_body(iebody, fd, vars, fs, ct, gfns, mfuncs, structs);
            if (icra.counter > ct) {
              fs = icra.funcs;
              ct = icra.counter;
              ncallee = ast.ExprLambda { ...ielam, body: icrs };
            }
          }
          // An arm whose value is an ORDINARY expression is claimed by
          // none of the paths above, so nothing ever put it through the
          // expression lift at all — see lift_iife_arm_values. Gated on
          // the fn-value paths NOT owning the arms, so no value is
          // walked twice.
          if (call.args.len() == 0 && ielam.params.len() == 0
            && !iife_arms_hold_fn_value(ielam.body, fd, structs, mfuncs)) {
            let avbody: ast.Stmt[] = ielam.body;
            if let ast.ExprLambda(nl2) = ncallee {
              avbody = nl2.body;
            }
            let (avs, ava) = lift_iife_arm_values(avbody, fd, vars, fs, ct, gfns, mfuncs, structs);
            if (ava.counter > ct) {
              fs = ava.funcs;
              ct = ava.counter;
              ncallee = ast.ExprLambda { ...ielam, body: avs };
            }
          }
        },
        _ => {
          let cr: InlineCloRes = lift_inline_closures_expr(call.callee, fd, vars, fs, ct, gfns, structs, mfuncs);
          fs = cr.funcs;
          ct = cr.counter;
          ncallee = cr.expr;
        }
      }
      return (ast.ExprCall { callee: ncallee, args: nargs, line: call.line, col: call.col, type_args: call.type_args, ty: call.ty }, InlineCloAcc { funcs: fs, counter: ct }, true);
    },
    ast.ExprArray(arr) => {
      let fs: parser.FuncDecl[] = acc.funcs;
      let ct: i32 = acc.counter;
      let nelems: ast.Expr[] = [];
      // Every function value in an array is an env box, so a function
      // array has one dispatch ABI however it was built (#5071, #10076): a
      // lambda boxes (a `$wrap` trampoline when it captures nothing), a
      // named function boxes through its `$wrap`, and a value-position
      // if/match element whose arms all box becomes a call yielding one
      // (#6256, #7438).
      let boxes: boolean = array_literal_boxes(arr, fd, structs, mfuncs);
      // A bare fn-name element is a module function only when it names no
      // local or param of this function.
      let abound: string[] = [];
      if (boxes) {
        abound = fd_bound_names(fd);
      }
      let i: i32 = 0;
      while (i < arr.elements.len()) {
        let awrapped: boolean = false;
        if (boxes) {
          match (arr.elements[i]) {
            ast.ExprLambda(_) => {
              let trw: InlineCloRes = try_fn_field_value(arr.elements[i], fd, vars, fs, ct, gfns, mfuncs, structs);
              fs = trw.funcs;
              ct = trw.counter;
              nelems = nelems.append(trw.expr);
              awrapped = true;
            },
            ast.ExprCall(acall) => {
              // Declines (leaving the module to bail) unless every arm boxes.
              if let ast.ExprLambda(_) = acall.callee {
                let aiw: InlineCloRes = try_fn_field_value(arr.elements[i], fd, vars, fs, ct, gfns, mfuncs, structs);
                if (aiw.counter > ct) {
                  fs = aiw.funcs;
                  ct = aiw.counter;
                  nelems = nelems.append(aiw.expr);
                  awrapped = true;
                }
              }
            },
            ast.ExprIdent(aid) => {
              if (util.index_of_str(abound, aid.name) < 0 && lift_names_fn_value(mfuncs, aid.name)) {
                let aw: InlineCloRes = try_fn_field_value(arr.elements[i], fd, vars, fs, ct, gfns, mfuncs, structs);
                fs = aw.funcs;
                ct = aw.counter;
                nelems = nelems.append(aw.expr);
                awrapped = true;
              }
            },
            _ => {}
          }
        }
        if (!awrapped) {
          let er: InlineCloRes = lift_inline_closures_expr(arr.elements[i], fd, vars, fs, ct, gfns, structs, mfuncs);
          fs = er.funcs;
          ct = er.counter;
          nelems = nelems.append(er.expr);
        }
        i = i + 1;
      }
      return (ast.ExprArray { ...arr, elements: nelems }, InlineCloAcc { funcs: fs, counter: ct }, true);
    },
    ast.ExprTuple(tl) => {
      // Every fn-VALUED tuple element is lifted to a `__mkclo$…` env-box
      // marker, mirroring the struct-field slice below: a capturing lambda
      // → `[funcval, caps…]` (try_inline_closure via try_fn_field_value),
      // a no-capture lambda or a bare fn-name → a `$wrapN` env-taking
      // trampoline → `[funcval]`. This makes `t.N(args)` dispatch
      // uniformly env-first (the "clo" element tag) for every fn-element
      // shape — matching the DECLARED-type tag a factory-returned tuple
      // carries. A bare
      // ident element is wrapped only when it is an UNSHADOWED module
      // function with params (a zero-arg receiver-less fn is a `const`
      // desugar whose VALUE must flow, and a body/param binding wins over
      // the module fn) — anything else recurses / passes through.
      let tfs: parser.FuncDecl[] = acc.funcs;
      let tct: i32 = acc.counter;
      let tnelems: ast.Expr[] = [];
      let tbound: string[] = fd_bound_names(fd);
      let tei: i32 = 0;
      while (tei < tl.elements.len()) {
        let twrapped: boolean = false;
        match (tl.elements[tei]) {
          ast.ExprLambda(_) => {
            let ttr: InlineCloRes = try_fn_field_value(tl.elements[tei], fd, vars, tfs, tct, gfns, mfuncs, structs);
            tfs = ttr.funcs;
            tct = ttr.counter;
            tnelems = tnelems.append(ttr.expr);
            twrapped = true;
          },
          ast.ExprIdent(ttid) => {
            if (util.index_of_str(tbound, ttid.name) < 0) {
              let tfnok: boolean = false;
              let tmi: i32 = 0;
              while (tmi < mfuncs.decls.len()) {
                if (mfuncs.decls[tmi].name == ttid.name && mfuncs.decls[tmi].receiver_type.len() == 0 && !mfuncs.decls[tmi].is_const) {
                  tfnok = true;
                }
                tmi = tmi + 1;
              }
              if (tfnok) {
                let ttw: InlineCloRes = try_fn_field_value(tl.elements[tei], fd, vars, tfs, tct, gfns, mfuncs, structs);
                tfs = ttw.funcs;
                tct = ttw.counter;
                tnelems = tnelems.append(ttw.expr);
                twrapped = true;
              }
            }
          },
          _ => {}
        }
        if (!twrapped) {
          let ter: InlineCloRes = lift_inline_closures_expr(tl.elements[tei], fd, vars, tfs, tct, gfns, structs, mfuncs);
          tfs = ter.funcs;
          tct = ter.counter;
          tnelems = tnelems.append(ter.expr);
        }
        tei = tei + 1;
      }
      return (ast.ExprTuple { elements: tnelems, line: tl.line, col: tl.col }, InlineCloAcc { funcs: tfs, counter: tct }, true);
    },
    ast.ExprStructLit(sl) => {
      // Every fn-typed struct FIELD value is lifted to a `__mkclo$…` env-box
      // marker (slice #3445): a capturing inline lambda → `[funcval, caps…]`
      // (try_inline_closure), a no-capture lambda / bare fn-name → a `$wrapN`
      // env-taking trampoline → `[funcval]` (try_fn_field_value). This makes
      // `h.f(args)` dispatch uniformly env-first for EVERY fn-field shape.
      // A field whose declared type isn't `fn`, or whose value can't be
      // wrapped (e.g. an unresolvable fn-name, a non-i32-capture lambda),
      // recurses / is left unchanged so a nested array INSIDE a field value
      // is still reached and the module bails when it must.
      let fs: parser.FuncDecl[] = acc.funcs;
      let ct: i32 = acc.counter;
      let nvals: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < sl.field_values.len()) {
        let is_fn_field: boolean = sl.type_name.len() > 0 && i < sl.field_names.len()
          && irtables.decl_field_type(structs, sl.type_name, sl.field_names[i]) == "fn";
        if (is_fn_field) {
          let fr: InlineCloRes = try_fn_field_value(sl.field_values[i], fd, vars, fs, ct, gfns, mfuncs, structs);
          fs = fr.funcs;
          ct = fr.counter;
          nvals = nvals.append(fr.expr);
        } else {
          let er: InlineCloRes = lift_inline_closures_expr(sl.field_values[i], fd, vars, fs, ct, gfns, structs, mfuncs);
          fs = er.funcs;
          ct = er.counter;
          nvals = nvals.append(er.expr);
        }
        i = i + 1;
      }
      let nbase: ast.Expr = sl.base;
      if (sl.has_base) {
        let br: InlineCloRes = lift_inline_closures_expr(sl.base, fd, vars, fs, ct, gfns, structs, mfuncs);
        fs = br.funcs;
        ct = br.counter;
        nbase = br.expr;
      }
      return (ast.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nvals, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col, written: sl.written }, InlineCloAcc { funcs: fs, counter: ct }, true);
    },
    ast.ExprLambda(_) => {
      return (e, acc, true);
    },
    ast.ExprSlice(_) => {
      return (e, acc, true);
    },
    ast.ExprMapLit(_) => {
      return (e, acc, true);
    },
    ast.ExprFString(_) => {
      return (e, acc, true);
    },
    ast.ExprFieldAccess(_) => {
      return (e, acc, false);
    },
    ast.ExprBinary(_) => {
      return (e, acc, false);
    },
    ast.ExprUnary(_) => {
      return (e, acc, false);
    },
    ast.ExprIndex(_) => {
      return (e, acc, false);
    },
    ast.ExprIdent(_) => {
      return (e, acc, false);
    },
    ast.ExprNumber(_) => {
      return (e, acc, false);
    },
    ast.ExprString(_) => {
      return (e, acc, false);
    },
    ast.ExprBool(_) => {
      return (e, acc, false);
    },
    ast.ExprUnknown(_) => {
      return (e, acc, false);
    },
    ast.ExprZero(_) => {
      return (e, acc, false);
    }
  }
  return (e, acc, false);
}

// lift_inline_closures_expr runs the env-box lift over one expression: the
// spine carries the recursion, ilc_expr_at / ilc_stmt_at carry the policy.
function lift_inline_closures_expr(e: ast.Expr, fd: parser.FuncDecl, vars: VarDecls, funcs: parser.FuncDecl[], counter: i32, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs): InlineCloRes {
  function ve(x: ast.Expr, a: InlineCloAcc): (ast.Expr, InlineCloAcc, boolean) {
    return ilc_expr_at(x, a, fd, vars, gfns, structs, mfuncs);
  }
  function vst(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) {
    return ilc_stmt_at(s, a, fd, vars, gfns, structs, mfuncs);
  }
  let (ne, na, nh) = astwalk.map_expr_acc(e, InlineCloAcc { funcs: funcs, counter: counter }, vst, ve);
  return InlineCloRes { expr: ne, funcs: na.funcs, counter: na.counter };
}

// value_use_idents_expr collects every ident referenced in a VALUE position —
// i.e. all idents EXCEPT the direct bare-name callee of a call `g(...)`. A
// nested lambda's free vars all count (they go in the env box as values). Used to
// decide whether a fn-value `let` binding must be env-boxed: a let that is only
// ever CALLED is left to closure_lift_one's cheaper direct-call lift; one used
// as a value (passed, returned, stored, captured) is boxed into a uniform box.
function value_use_idents_expr(e: ast.Expr, own acc: string[]): string[] {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(_) => {},
        ast.ExprLambda(il) => {
          // A value-position if/match is an immediately-invoked 0-param
          // lambda whose body lowers INLINE in the enclosing frame, so it
          // captures nothing and a name it only calls is still only
          // called. The closure rule below would box such a name.
          if (c.args.len() == 0 && il.params.len() == 0) {
            acc = iife_body_value_use_idents(il, acc);
          } else {
            acc = value_use_idents_expr(c.callee, acc);
          }
        },
        _ => {
          acc = value_use_idents_expr(c.callee, acc);
        }
      }
      for arg in c.args {
        acc = value_use_idents_expr(arg, acc);
      }
      return acc;
    },
    ast.ExprIdent(id) => {
      return acc.append(id.name);
    },
    ast.ExprNumber(_) => {
      return acc;
    },
    ast.ExprString(_) => {
      return acc;
    },
    ast.ExprBool(_) => {
      return acc;
    },
    ast.ExprBinary(b) => {
      acc = value_use_idents_expr(b.left, acc);
      return value_use_idents_expr(b.right, acc);
    },
    ast.ExprUnary(u) => {
      return value_use_idents_expr(u.operand, acc);
    },
    ast.ExprArray(a) => {
      let i: i32 = 0;
      while (i < a.elements.len()) {
        acc = value_use_idents_expr(a.elements[i], acc);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        acc = value_use_idents_expr(el, acc);
      }
      return acc;
    },
    ast.ExprIndex(x) => {
      acc = value_use_idents_expr(x.array, acc);
      return value_use_idents_expr(x.index, acc);
    },
    ast.ExprSlice(sl) => {
      acc = value_use_idents_expr(sl.array, acc);
      acc = value_use_idents_expr(sl.start, acc);
      return value_use_idents_expr(sl.end, acc);
    },
    ast.ExprStructLit(sl) => {
      if (sl.has_base) {
        acc = value_use_idents_expr(sl.base, acc);
      }
      for fv in sl.field_values {
        acc = value_use_idents_expr(fv, acc);
      }
      return acc;
    },
    ast.ExprFieldAccess(fa) => {
      return value_use_idents_expr(fa.obj, acc);
    },
    ast.ExprLambda(_) => {
      // Every free var of a real (non-inlined) lambda is a value-use,
      // INCLUDING one it only calls: each capture is copied into the
      // closure's env box (make_clo_func) or passed as the lifted call's
      // extra argument (closure_lift_one), and both read a fn value with
      // the uniform env-box ABI. collect_idents_expr's own ExprLambda arm
      // computes exactly that free set.
      return astwalk.collect_idents_expr(e, acc);
    },
    ast.ExprMapLit(ml) => {
      let mi: i32 = 0;
      while (mi < ml.keys.len()) {
        acc = value_use_idents_expr(ml.keys[mi], acc);
        acc = value_use_idents_expr(ml.vals[mi], acc);
        mi = mi + 1;
      }
      return acc;
    },
    ast.ExprFString(fs) => {
      let fi: i32 = 0;
      while (fi < fs.exprs.len()) {
        if (fs.is_expr[fi]) {
          acc = value_use_idents_expr(fs.exprs[fi], acc);
        }
        fi = fi + 1;
      }
      return acc;
    },
    ast.ExprUnknown(_) => {
      return acc;
    },
    ast.ExprZero(_) => {
      return acc;
    }
  }
  return acc;
}

// iife_body_value_use_idents collects the enclosing-scope names a value-position
// if/match's inlined body uses as VALUES: its body walked with the ordinary
// statement rule, minus the names the body itself binds.
function iife_body_value_use_idents(lm: ast.ExprLambda, own acc: string[]): string[] {
  let inner: string[] = [];
  let iu: i32 = 0;
  while (iu < lm.body.len()) {
    inner = value_use_idents_stmt(lm.body[iu], inner);
    iu = iu + 1;
  }
  let bound: string[] = [];
  let ib: i32 = 0;
  while (ib < lm.body.len()) {
    bound = astwalk.collect_bound_stmt(lm.body[ib], bound);
    ib = ib + 1;
  }
  let ik: i32 = 0;
  while (ik < inner.len()) {
    if (util.index_of_str(bound, inner[ik]) < 0) {
      acc = acc.append(inner[ik]);
    }
    ik = ik + 1;
  }
  return acc;
}

function value_use_idents_stmt(st: ast.Stmt, own acc: string[]): string[] {
  match (st) {
    ast.StmtDefer(d) => {
      return value_use_idents_stmt(d.action, acc);
    },
    ast.StmtVar(v) => {
      return value_use_idents_expr(v.init, acc);
    },
    ast.StmtReturn(r) => {
      return value_use_idents_expr(r.value, acc);
    },
    ast.StmtExpr(e) => {
      return value_use_idents_expr(e.value, acc);
    },
    ast.StmtIf(i) => {
      acc = value_use_idents_expr(i.cond, acc);
      let ti: i32 = 0;
      while (ti < i.then_body.len()) {
        acc = value_use_idents_stmt(i.then_body[ti], acc);
        ti = ti + 1;
      }
      let ei: i32 = 0;
      while (ei < i.else_body.len()) {
        acc = value_use_idents_stmt(i.else_body[ei], acc);
        ei = ei + 1;
      }
      return acc;
    },
    ast.StmtWhile(w) => {
      acc = value_use_idents_expr(w.cond, acc);
      let i: i32 = 0;
      while (i < w.body.len()) {
        acc = value_use_idents_stmt(w.body[i], acc);
        i = i + 1;
      }
      return acc;
    },
    ast.StmtAssign(a) => {
      acc = value_use_idents_expr(a.value, acc);
      return acc.append(a.target);
    },
    ast.StmtMatch(m) => {
      acc = value_use_idents_expr(m.scrutinee, acc);
      for arm in m.arms {
        // A `when` guard is executable code — a value-use inside it counts
        // (mirrors ident_used_as_value_stmt, which already checks it).
        if (arm.has_guard) {
          acc = value_use_idents_expr(arm.guard, acc);
        }
        let bi: i32 = 0;
        while (bi < arm.body.len()) {
          acc = value_use_idents_stmt(arm.body[bi], acc);
          bi = bi + 1;
        }
      }
      return acc;
    },
    ast.StmtFor(f) => {
      acc = value_use_idents_expr(f.iter, acc);
      let i: i32 = 0;
      while (i < f.body.len()) {
        acc = value_use_idents_stmt(f.body[i], acc);
        i = i + 1;
      }
      return acc;
    },
    ast.StmtBreak(_) => {
      return acc;
    },
    ast.StmtContinue(_) => {
      return acc;
    },
    ast.StmtUnknown(_) => {
      return acc;
    }
  }
  return acc;
}

// hoisted_iife_captures reports whether a value-position if/match that
// ilc_expr_at hoists to `<fd>$iifeN(caps…)` refers to `name`. The hoist passes
// every name the arms read as an argument, a callee included, so a local
// function only called there is still a value once hoisted, and the direct-call
// lift that would otherwise claim it declines.
function hoisted_iife_captures(stmts: ast.Stmt[], name: string, fd: parser.FuncDecl, structs: irtables.StructTab, mfuncs: MFuncs): boolean {
  function visit(e: ast.Expr, own found: boolean): boolean {
    if (found) {
      return true;
    }
    if let ast.ExprCall(c) = e {
      if let ast.ExprLambda(il) = c.callee {
        if (irtables.is_iife_callee(c)
          && iife_arms_have_unboxed_fn(il.body, iife_scope_fd(fd, il.body), mfuncs)
          && iife_arms_hold_fn_value(il.body, fd, structs, mfuncs)) {
          return util.has_str(astwalk.collect_lambda_idents(il, []), name);
        }
      }
    }
    return false;
  }
  let found: boolean = false;
  for st in stmts {
    found = astwalk.fold_stmt(st, found, visit);
  }
  return found;
}

// stmts_value_use returns true iff `name` is referenced as a value (not merely
// as a call callee) anywhere in `stmts`.
function stmts_value_use(stmts: ast.Stmt[], name: string): boolean {
  let used: string[] = [];
  for stmt in stmts {
    used = value_use_idents_stmt(stmt, used);
  }
  return util.index_of_str(used, name) >= 0;
}

// ilc_stmt_at is the env-box lift's statement visitor: the statements that OWN
// a fn-value position (var / return / expr / assign) are claimed and rebuilt
// by the hand policy — annotation-directed boxing included — and the compound
// statements decline, the spine carrying what their arms used to spell out:
// condition / iterable / scrutinee / guard through ilc_expr_at, bodies through
// this visitor. StmtDefer is claimed unchanged: this pass has never entered a
// defer's action, and raw-parse drivers can carry a defer into the lift.
function ilc_stmt_at(st: ast.Stmt, acc: InlineCloAcc, fd: parser.FuncDecl, vars: VarDecls, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs): (ast.Stmt, InlineCloAcc, boolean) {
  let fs: parser.FuncDecl[] = acc.funcs;
  let ct: i32 = acc.counter;
  match (st) {
    ast.StmtVar(v) => {
      // A fn-VALUE local binding `let g = dbl` (the init a bare module
      // fn-name with >= 1 param — a function value, not a zero-arg
      // const) is env-boxed into a `__mkclo$<fd>$wrapN()` trampoline box
      // so the slot holds the SAME uniform env box every fn-value carries
      // (slice #3445 follow-up). Then `g(args)` / passing `g` as a
      // fn-arg both use the env-first call path (the slot is marked a
      // closure local at lowering, recognising the `__mkclo$` init). A
      // non-fn-value init falls through to the ordinary aggregate walk.
      match (v.init) {
        ast.ExprIdent(vid) => {
          // A local binding of the same name SHADOWS the module
          // function, so the init is an ordinary value copy — see
          // lift_ident_is_param (#6191, and #6854 for this site).
          if (!lift_ident_is_param(fd, vid.name) && lift_names_fn_value(mfuncs, vid.name)) {
            let wn: string = clo_owner_name(fd) + "$wrap" + util.i32_to_string(ct);
            let hr: HoistResult = make_wrap_named_func(vid.name, wn, mfuncs);
            if (hr.ok) {
              let marker: ast.Expr = ast.ExprCall { callee: ast.ExprIdent { name: "__mkclo$" + wn, line: 0, col: 0, ty: "" }, args: [], line: 0, col: 0, type_args: [], ty: "" };
              return (ast.StmtVar { ...v, init: marker }, InlineCloAcc { funcs: fs.append(hr.func), counter: ct + 1 }, true);
            }
          }
        },
        ast.ExprLambda(_) => {
          // A var-bound lambda USED AS A VALUE (passed, returned,
          // stored, captured) — not merely called — is env-boxed so
          // its slot holds the uniform env box every fn-value carries;
          // `g(args)` then uses the env-first call path. A var only
          // ever CALLED is left to closure_lift_one's cheaper
          // direct-call lift (boxing it would pre-empt that and
          // regress closure-calls-closure). try_fn_field_value boxes a
          // capturing (i32-only) / no-capture lambda into a `__mkclo$`
          // marker (ExprCall) and DECLINES (returns the lambda
          // unchanged) for non-i32 captures — only the ExprCall result
          // counts as boxed; a decline falls through to the walk so the
          // module bails (correctness preserved).
          if (stmts_value_use(fd.body, v.name) || hoisted_iife_captures(fd.body, v.name, fd, structs, mfuncs)) {
            let lr: InlineCloRes = try_fn_field_value(v.init, fd, vars, fs, ct, gfns, mfuncs, structs);
            match (lr.expr) {
              ast.ExprCall(_) => {
                return (ast.StmtVar { ...v, init: lr.expr }, InlineCloAcc { funcs: lr.funcs, counter: lr.counter }, true);
              },
              _ => {}
            }
          }
        },
        _ => {}
      }
      let er: InlineCloRes = lift_inline_closures_expr(v.init, fd, vars, fs, ct, gfns, structs, mfuncs);
      return (ast.StmtVar { name: v.name, type_name: v.type_name, init: er.expr, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types }, InlineCloAcc { funcs: er.funcs, counter: er.counter }, true);
    },
    ast.StmtReturn(r) => {
      // A callable result uses the same env-box ABI as callable
      // parameters and fields, regardless of the function's arity.
      let rpre: ast.Expr = r.value;
      if (fd.ret_type == "fn" || util.contains(fd.ret_type, "=>")) {
        match (rpre) {
          ast.ExprIdent(rid) => {
            let rbound: string[] = [];
            let rbp: i32 = 0;
            while (rbp < fd.params.len()) {
              rbound = rbound.append(fd.params[rbp].name);
              rbp = rbp + 1;
            }
            let rbs: i32 = 0;
            while (rbs < fd.body.len()) {
              rbound = astwalk.collect_bound_stmt(fd.body[rbs], rbound);
              rbs = rbs + 1;
            }
            if (util.index_of_str(rbound, rid.name) < 0 && lift_names_fn_value(mfuncs, rid.name)) {
              let rwr: InlineCloRes = try_fn_field_value(rpre, fd, vars, fs, ct, gfns, mfuncs, structs);
              match (rwr.expr) {
                ast.ExprCall(_) => {
                  fs = rwr.funcs;
                  ct = rwr.counter;
                  rpre = rwr.expr;
                },
                _ => {}
              }
            }
          },
          _ => {}
        }
      }
      let er: InlineCloRes = lift_inline_closures_expr(rpre, fd, vars, fs, ct, gfns, structs, mfuncs);
      return (ast.StmtReturn { value: er.expr, line: r.line, col: r.col }, InlineCloAcc { funcs: er.funcs, counter: er.counter }, true);
    },
    ast.StmtExpr(es) => {
      let er: InlineCloRes = lift_inline_closures_expr(es.value, fd, vars, fs, ct, gfns, structs, mfuncs);
      return (ast.StmtExpr { value: er.expr, line: 0 }, InlineCloAcc { funcs: er.funcs, counter: er.counter }, true);
    },
    ast.StmtAssign(a) => {
      // A fn-value REASSIGNMENT `f = <lambda>` / `f = dbl` must be
      // env-boxed the SAME way the fn-value BINDING `let f = …` is
      // (#3445 follow-up): `f` was marked a closure local at its boxed
      // binding, so `f(args)` / passing `f` dispatch env-first — an
      // UNBOXED reassigned value (a bare lambda / fn pointer) in that
      // slot would env-first-dispatch a non-box and crash. A capturing
      // lambda → __mkclo box; a no-capture lambda / bare module-fn-name
      // → a $wrapN trampoline box (try_fn_field_value); any other RHS
      // (a call returning a box, an already-boxed local, a non-fn value)
      // recurses through the ordinary walk. The RHS being a fn-value
      // implies a fn-typed target (type-checked), so this never boxes a
      // non-fn assignment.
      match (a.value) {
        ast.ExprLambda(_) => {
          let asgr: InlineCloRes = try_fn_field_value(a.value, fd, vars, fs, ct, gfns, mfuncs, structs);
          return (ast.StmtAssign { target: a.target, value: asgr.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, InlineCloAcc { funcs: asgr.funcs, counter: asgr.counter }, true);
        },
        ast.ExprIdent(avid) => {
          if (lift_names_fn_value(mfuncs, avid.name)) {
            let asgr2: InlineCloRes = try_fn_field_value(a.value, fd, vars, fs, ct, gfns, mfuncs, structs);
            return (ast.StmtAssign { target: a.target, value: asgr2.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, InlineCloAcc { funcs: asgr2.funcs, counter: asgr2.counter }, true);
          }
        },
        _ => {}
      }
      let er: InlineCloRes = lift_inline_closures_expr(a.value, fd, vars, fs, ct, gfns, structs, mfuncs);
      return (ast.StmtAssign { target: a.target, value: er.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, InlineCloAcc { funcs: er.funcs, counter: er.counter }, true);
    },
    ast.StmtDefer(_) => {
      return (st, acc, true);
    },
    ast.StmtIf(_) => {
      return (st, acc, false);
    },
    ast.StmtWhile(_) => {
      return (st, acc, false);
    },
    ast.StmtFor(_) => {
      return (st, acc, false);
    },
    ast.StmtMatch(_) => {
      return (st, acc, false);
    },
    ast.StmtBreak(_) => {
      return (st, acc, false);
    },
    ast.StmtContinue(_) => {
      return (st, acc, false);
    },
    ast.StmtUnknown(_) => {
      return (st, acc, false);
    }
  }
  return (st, acc, false);
}

// lift_inline_closures rewrites fd, hoisting capturing inline lambdas in
// aggregate position to `<fd>$cloN` funcs (returned alongside the body). When
// nothing is hoisted, fd.body is returned UNCHANGED with no funcs so
// lambda-free / unaffected functions serialize byte-identically
// (fixpoint-safe).
function lift_inline_closures(fd: parser.FuncDecl, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs): (ast.Stmt[], parser.FuncDecl[]) {
  let vars: VarDecls = var_decls_of(fd.body);
  function ve(x: ast.Expr, a: InlineCloAcc): (ast.Expr, InlineCloAcc, boolean) {
    return ilc_expr_at(x, a, fd, vars, gfns, structs, mfuncs);
  }
  function vst(s: ast.Stmt, a: InlineCloAcc): (ast.Stmt, InlineCloAcc, boolean) {
    return ilc_stmt_at(s, a, fd, vars, gfns, structs, mfuncs);
  }
  let (ns, na) = astwalk.map_stmts_acc(fd.body, InlineCloAcc { funcs: [], counter: 0 }, vst, ve);
  if (na.funcs.len() == 0) {
    return (fd.body, []);
  }
  return (ns, na.funcs);
}

// ---- mutable captures (boxing, #2850 / #5394) --------------------------
//
// A closure that WRITES a captured outer scalar (`let x = 0; f = fn(){ x = x+1 }`)
// must share the write with the enclosing scope (scalar captures are mutable
// by-reference — the closures-as-counters feature). The IR path captures by
// VALUE (the env box holds the capture's value), so the write is lost. Fix:
// before lifting, rewrite each captured-AND-mutated local into a `Cell[T]`,
// so the capture is the shared box's pointer and by-reference on both sides:
//   let x = E         ->  let $cell$x: Cell[T] = cell_new(E)
//   <read x>          ->  $cell$x.get()
//   x = v             ->  $cell$x.set(v)
// The lambda then captures the cell (its contract records `Cell[T]`,
// try_lift_binding passes the pointer); `set` stores into the shared box in
// place. Two rules select what boxes:
//   1. #2850: a capture the CLOSURE body writes, itself or through a lambda
//      nested in it. A captured parameter's cell is built on entry.
//   2. #5394: a capture of an ESCAPING binding (returned / used as a value —
//      the make_closure env-box path, which snapshots at creation) that the
//      ENCLOSING body reassigns — any capturable type. The env
//      then snapshots the cell POINTER, so a later outer reassignment stores
//      through the shared cell and the escaped closure reads the live value,
//      matching the interpreter (the oracle per #2896). Directly-called
//      bindings don't need this: the param-lift passes captures at each call
//      site (#5301), which is already by-reference for reads.

// body_var_decl_names collects every `let`-declared name in `stmts`, recursing
// into nested control-flow bodies (NOT into lambda inits — a lambda's own local
// is its own binding, never the enclosing function's). Gates #5394's boxing to
// locals the StmtVar rewrite can actually turn into a cell — never a parameter.
function body_var_decl_names(stmts: ast.Stmt[]): string[] {
  let out: string[] = [];
  for stmt in stmts {
    out = astwalk.fold_stmt_spine(stmt, out, var_decl_name_into);
  }
  return out;
}

function var_decl_name_into(st: ast.Stmt, own acc: string[]): string[] {
  match (st) {
    ast.StmtVar(v) => {
      return acc.append(v.name);
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

// ident_used_as_value_expr: does `name` occur in `e` as a VALUE — any ident
// occurrence other than a direct-call callee (`name(args)` is a call, not an
// escape)? A use inside a nested lambda body counts (the closure would capture
// the binding). Drives #5394's escape test for `let f = <lambda>` bindings.
function ident_used_as_value_expr(e: ast.Expr, name: string): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == name;
    },
    ast.ExprBinary(b) => {
      return ident_used_as_value_expr(b.left, name) || ident_used_as_value_expr(b.right, name);
    },
    ast.ExprUnary(u) => {
      return ident_used_as_value_expr(u.operand, name);
    },
    ast.ExprCall(c) => {
      for arg in c.args {
        if (ident_used_as_value_expr(arg, name)) {
          return true;
        }
      }
      match (c.callee) {
        ast.ExprIdent(cid) => {
          if (cid.name == name) {
            return false;
          }
        },
        _ => {}
      }
      return ident_used_as_value_expr(c.callee, name);
    },
    ast.ExprArray(a) => {
      let i: i32 = 0;
      while (i < a.elements.len()) {
        if (ident_used_as_value_expr(a.elements[i], name)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        if (ident_used_as_value_expr(el, name)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprIndex(x) => {
      return ident_used_as_value_expr(x.array, name) || ident_used_as_value_expr(x.index, name);
    },
    ast.ExprSlice(sl) => {
      return ident_used_as_value_expr(sl.array, name) || ident_used_as_value_expr(sl.start, name) || ident_used_as_value_expr(sl.end, name);
    },
    ast.ExprStructLit(sl) => {
      if (sl.has_base && ident_used_as_value_expr(sl.base, name)) {
        return true;
      }
      for fv in sl.field_values {
        if (ident_used_as_value_expr(fv, name)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprFieldAccess(fa) => {
      return ident_used_as_value_expr(fa.obj, name);
    },
    ast.ExprLambda(lm) => {
      return ident_used_as_value_stmts(lm.body, name);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function ident_used_as_value_stmt(st: ast.Stmt, name: string): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return ident_used_as_value_expr(v.init, name);
    },
    ast.StmtAssign(a) => {
      // A reassignment TARGET counts too: `f = other` declines the param-
      // lift (try_lift_binding's fname-in-assigns guard), so the binding
      // keeps the env-box path and needs the cell.
      return a.target == name || ident_used_as_value_expr(a.value, name);
    },
    ast.StmtReturn(r) => {
      return ident_used_as_value_expr(r.value, name);
    },
    ast.StmtExpr(e) => {
      return ident_used_as_value_expr(e.value, name);
    },
    ast.StmtIf(f) => {
      return ident_used_as_value_expr(f.cond, name) || ident_used_as_value_stmts(f.then_body, name) || ident_used_as_value_stmts(f.else_body, name);
    },
    ast.StmtWhile(w) => {
      return ident_used_as_value_expr(w.cond, name) || ident_used_as_value_stmts(w.body, name);
    },
    ast.StmtFor(fr) => {
      return ident_used_as_value_expr(fr.iter, name) || ident_used_as_value_stmts(fr.body, name);
    },
    ast.StmtMatch(m) => {
      if (ident_used_as_value_expr(m.scrutinee, name)) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard && ident_used_as_value_expr(arm.guard, name)) {
          return true;
        }
        if (ident_used_as_value_stmts(arm.body, name)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function ident_used_as_value_stmts(stmts: ast.Stmt[], name: string): boolean {
  for stmt in stmts {
    if (ident_used_as_value_stmt(stmt, name)) {
      return true;
    }
  }
  return false;
}

// ---- wide (8-byte scalar) captures (#6046) ----------------------------
//
// The closure env box is an i32[] (arr_make …, 32), so a capture has to fit a
// 32-bit slot — cap_slot_ok's rule. Pointer-shaped captures do (every heap and
// code address in the -no-pie -static binary is 32-bit), but an i64 / u64 / f64
// does not, so make_clo_func declined and the module bailed. Since the AST
// emitters were deleted (#3457) that bail is a hard compile error, which made a
// closure over a duration, a file size or a timestamp simply not compile.
//
// box_wide_captures fixes it WITHOUT widening the box: it snapshots each wide
// capture into a 1-element cell (`let $wc$b: i64[] = [b];`) immediately before
// the statement that builds the closure, and re-binds the original name from
// that cell at the top of the lambda body (`let b: i64 = $wc$b[0];`). After the
// rewrite `b` is bound INSIDE the lambda, so it is no longer free: the capture
// the lift passes see is `$wc$b`, an `i64[]` — pointer-shaped, so cap_slot_ok
// accepts it as-is and make_clo_func, the env box and all three backends are
// untouched.
//
// The 1-element cell is the SAME representation box_mutated_scalar_captures
// uses (box_rewrite_stmt builds `let x: T[] = [init]` and reads `x[0]`), reused
// rather than duplicated; only the reason differs — slot width here, write
// sharing there.
//
// A capture the enclosing function REASSIGNS, or the lambda itself writes, is
// skipped — not declined. box_mutated_scalar_captures already boxes those into
// a SHARED cell (#5394 and #2850 respectively), and a shared
// cell is what they need: the closure must see the live value, which this
// creation-time snapshot could not give. Skipping is therefore deferring to the
// right mechanism. Both paths land on the same `T[]` shape, so either way the
// capture reaching cap_slot_ok is pointer-shaped.
//
// A function with no wide capture is returned unchanged, so every other
// function stays byte-identical — including all of the self-host's own, which
// contain no wide capture (they could not compile today if they did).
// An f32 counts as wide too: a float is not an i32-shaped word to the RC
// layer's box stores (ssarc's narrow_slot), whatever its size.
// A type variable counts as wide: the lift runs once over the template, and an
// instance may bind it to an 8-byte scalar. Its cell, spelled `0_T[]`, is
// pointer-shaped and does not count: looks_type_var refuses the brackets.
function is_wide_cap_type(t: string): boolean {
  return t == "i64" || t == "u64" || t == "f64" || t == "f32" || parser.looks_type_var(t);
}

// wcap_cell_name is the cell local for a wide capture. The `$` prefix cannot
// collide with a user ident (the guarantee `$lamret$` already relies on).
function wcap_cell_name(c: string): string {
  return "$wc$" + c;
}

struct WCaps { names: string[], types: string[] }

struct WCapExpr { expr: ast.Expr, caps: WCaps, changed: boolean }

struct WCapStmt { stmt: ast.Stmt, caps: WCaps, changed: boolean }

struct WCapBody { stmts: ast.Stmt[], changed: boolean }

// wcap_shared_targets is what box_mutated_scalar_captures puts in a shared cell
// for `lm` instead: the names the enclosing function reassigns and the names
// `lm` itself writes (#2850). Snapshotting either would drop the write.
function wcap_shared_targets(lm: ast.ExprLambda, atargets: string[]): string[] {
  let out: string[] = atargets;
  for t in irtables.lambda_write_targets(lm.body) {
    out = out.append(t);
  }
  return out;
}

// wcaps_add records one capture name + type when it is wide, not already
// recorded, and not in `atargets` (wcap_shared_targets).
function wcaps_add(acc: WCaps, name: string, ty: string, atargets: string[]): WCaps {
  if (!is_wide_cap_type(ty)) {
    return acc;
  }
  if (util.index_of_str(acc.names, name) >= 0) {
    return acc;
  }
  if (util.index_of_str(atargets, name) >= 0) {
    return acc;
  }
  return WCaps { names: acc.names.append(name), types: acc.types.append(ty) };
}

function wcaps_join(a: WCaps, b: WCaps): WCaps {
  let out: WCaps = a;
  let i: i32 = 0;
  while (i < b.names.len()) {
    if (util.index_of_str(out.names, b.names[i]) < 0) {
      out = WCaps { names: out.names.append(b.names[i]), types: out.types.append(b.types[i]) };
    }
    i = i + 1;
  }
  return out;
}

// wcap_cell_decl builds `let $wc$c: T[] = [c];` — the snapshot cell.
function wcap_cell_decl(c: string, ty: string): ast.Stmt {
  let src: ast.Expr = ast.ExprIdent { name: c, line: 0, col: 0, ty: "" };
  return ast.StmtVar { name: wcap_cell_name(c), type_name: ty + "[]", init: ast.ExprArray { elements: [src], elem_ty: ty, line: 0, col: 0 }, line: 0, col: 0, fn_ret: "", fn_param_types: "" };
}

// wcap_cell_read builds `let c: T = $wc$c[0];` — the lambda-body re-bind.
function wcap_cell_read(c: string, ty: string): ast.Stmt {
  let cell: ast.Expr = ast.ExprIdent { name: wcap_cell_name(c), line: 0, col: 0, ty: "" };
  let idx: ast.Expr = ast.ExprIndex { array: cell, index: ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 }, unchecked: false, ty: "", line: 0, col: 0 };
  return ast.StmtVar { name: c, type_name: ty, init: idx, line: 0, col: 0, fn_ret: "", fn_param_types: "" };
}

// wcap_expr walks one expression, rewriting every lambda in it (prepending the
// cell reads for ITS wide captures) and accumulating the wide captures seen, so
// the caller can emit their cell decls before the enclosing statement. Mirrors
// box_rewrite_expr's recursion set — the proven list of forms a lambda can hide
// in. Collection and rewriting are fused so the tree is walked once.
function wcap_expr(e: ast.Expr, fd: parser.FuncDecl, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs, acc: WCaps, atargets: string[]): WCapExpr {
  match (e) {
    ast.ExprLambda(lm) => {
      // This lambda's own wide captures, in lambda_captures order.
      let mine: WCaps = WCaps { names: [], types: [] };
      let caps: string[] = lambda_captures(lm, fd);
      let shared: string[] = wcap_shared_targets(lm, atargets);
      let ci: i32 = 0;
      while (ci < caps.len()) {
        mine = wcaps_add(mine, caps[ci], lambda_capture_type(lm, caps[ci]), shared);
        ci = ci + 1;
      }
      // Rewrite the body first (a nested lambda's own cells are emitted
      // by the recursive statement walk), then re-bind this lambda's wide
      // captures from their cells at the top of the body.
      let inner: WCaps = acc;
      let nb: ast.Stmt[] = [];
      let bchanged: boolean = false;
      let bi: i32 = 0;
      while (bi < lm.body.len()) {
        let rs: WCapStmt = wcap_stmt(lm.body[bi], fd, gfns, structs, mfuncs, inner, atargets);
        inner = rs.caps;
        if (rs.changed) {
          bchanged = true;
        }
        nb = nb.append(rs.stmt);
        bi = bi + 1;
      }
      let pre: ast.Stmt[] = [];
      let mi: i32 = 0;
      while (mi < mine.names.len()) {
        pre = pre.append(wcap_cell_read(mine.names[mi], mine.types[mi]));
        mi = mi + 1;
      }
      let full: ast.Stmt[] = pre;
      let fi: i32 = 0;
      while (fi < nb.len()) {
        full = full.append(nb[fi]);
        fi = fi + 1;
      }
      let typed_caps: ast.TypedBinding[] = [];
      for cap in lm.captures {
        if (util.has_str(mine.names, cap.name)) {
          typed_caps = typed_caps.append(ast.TypedBinding { name: wcap_cell_name(cap.name), ty: typeinfo.TypeArray { elem: cap.ty, view: false } });
        } else {
          typed_caps = typed_caps.append(cap);
        }
      }
      return WCapExpr { expr: ast.ExprLambda { ...lm, body: full, captures: typed_caps }, caps: wcaps_join(inner, mine), changed: bchanged || mine.names.len() > 0 };
    },
    ast.ExprBinary(b) => {
      let l: WCapExpr = wcap_expr(b.left, fd, gfns, structs, mfuncs, acc, atargets);
      let r: WCapExpr = wcap_expr(b.right, fd, gfns, structs, mfuncs, l.caps, atargets);
      return WCapExpr { expr: ast.ExprBinary { op: b.op, left: l.expr, right: r.expr, line: b.line, col: b.col, ty: b.ty }, caps: r.caps, changed: l.changed || r.changed };
    },
    ast.ExprUnary(u) => {
      let o: WCapExpr = wcap_expr(u.operand, fd, gfns, structs, mfuncs, acc, atargets);
      return WCapExpr { expr: ast.ExprUnary { op: u.op, operand: o.expr, line: u.line, col: u.col, ty: u.ty }, caps: o.caps, changed: o.changed };
    },
    ast.ExprCall(c) => {
      // An IMMEDIATELY-INVOKED lambda never reaches the env box, so its
      // wide captures need no cell — the same argument
      // wcap_stmt_needs_env_box already makes for a `let f = <lambda>`
      // that is only ever direct-called, applied to the other shape that
      // cannot escape: a value block is inlined, and a hand-written one
      // becomes a direct call taking its captures as arguments
      // (lift_capturing_iife), with parameters or without (#6278).
      // Recurse into the body and the arguments (a lambda nested THERE
      // may still escape) but leave this lambda's own captures alone.
      if let ast.ExprLambda(ilm) = c.callee {
        let iacc: WCaps = acc;
        let ib: ast.Stmt[] = [];
        let ichanged: boolean = false;
        let ii: i32 = 0;
        while (ii < ilm.body.len()) {
          let irs: WCapStmt = wcap_stmt(ilm.body[ii], fd, gfns, structs, mfuncs, iacc, atargets);
          iacc = irs.caps;
          if (irs.changed) {
            ichanged = true;
          }
          ib = ib.append(irs.stmt);
          ii = ii + 1;
        }
        let iargs: ast.Expr[] = [];
        for iarg in c.args {
          let iar: WCapExpr = wcap_expr(iarg, fd, gfns, structs, mfuncs, iacc, atargets);
          iacc = iar.caps;
          if (iar.changed) {
            ichanged = true;
          }
          iargs = iargs.append(iar.expr);
        }
        let ilam: ast.Expr = ast.ExprLambda { ...ilm, body: ib };
        return WCapExpr { expr: ast.ExprCall { callee: ilam, args: iargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, caps: iacc, changed: ichanged };
      }
      let cal: WCapExpr = wcap_expr(c.callee, fd, gfns, structs, mfuncs, acc, atargets);
      let a: WCaps = cal.caps;
      let cchanged: boolean = cal.changed;
      let na: ast.Expr[] = [];
      for arg in c.args {
        let ar: WCapExpr = wcap_expr(arg, fd, gfns, structs, mfuncs, a, atargets);
        a = ar.caps;
        if (ar.changed) {
          cchanged = true;
        }
        na = na.append(ar.expr);
      }
      return WCapExpr { expr: ast.ExprCall { callee: cal.expr, args: na, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, caps: a, changed: cchanged };
    },
    ast.ExprArray(ar) => {
      let a: WCaps = acc;
      let ne: ast.Expr[] = [];
      let achanged: boolean = false;
      let i: i32 = 0;
      while (i < ar.elements.len()) {
        let er: WCapExpr = wcap_expr(ar.elements[i], fd, gfns, structs, mfuncs, a, atargets);
        a = er.caps;
        if (er.changed) {
          achanged = true;
        }
        ne = ne.append(er.expr);
        i = i + 1;
      }
      return WCapExpr { expr: ast.ExprArray { ...ar, elements: ne }, caps: a, changed: achanged };
    },
    ast.ExprTuple(t) => {
      let a: WCaps = acc;
      let ne: ast.Expr[] = [];
      let tchanged: boolean = false;
      for el in t.elements {
        let er: WCapExpr = wcap_expr(el, fd, gfns, structs, mfuncs, a, atargets);
        a = er.caps;
        if (er.changed) {
          tchanged = true;
        }
        ne = ne.append(er.expr);
      }
      return WCapExpr { expr: ast.ExprTuple { elements: ne, line: t.line, col: t.col }, caps: a, changed: tchanged };
    },
    ast.ExprIndex(x) => {
      let ax: WCapExpr = wcap_expr(x.array, fd, gfns, structs, mfuncs, acc, atargets);
      let ix: WCapExpr = wcap_expr(x.index, fd, gfns, structs, mfuncs, ax.caps, atargets);
      return WCapExpr { expr: ast.ExprIndex { array: ax.expr, index: ix.expr, unchecked: x.unchecked, ty: x.ty, line: x.line, col: x.col }, caps: ix.caps, changed: ax.changed || ix.changed };
    },
    ast.ExprSlice(sl) => {
      let sa: WCapExpr = wcap_expr(sl.array, fd, gfns, structs, mfuncs, acc, atargets);
      let ss: WCapExpr = wcap_expr(sl.start, fd, gfns, structs, mfuncs, sa.caps, atargets);
      let se: WCapExpr = wcap_expr(sl.end, fd, gfns, structs, mfuncs, ss.caps, atargets);
      return WCapExpr { expr: ast.ExprSlice { ...sl, array: sa.expr, start: ss.expr, end: se.expr }, caps: se.caps, changed: sa.changed || ss.changed || se.changed };
    },
    ast.ExprStructLit(sl) => {
      let a: WCaps = acc;
      let nv: ast.Expr[] = [];
      let schanged: boolean = false;
      for fv in sl.field_values {
        let fr: WCapExpr = wcap_expr(fv, fd, gfns, structs, mfuncs, a, atargets);
        a = fr.caps;
        if (fr.changed) {
          schanged = true;
        }
        nv = nv.append(fr.expr);
      }
      let nbase: ast.Expr = sl.base;
      if (sl.has_base) {
        let br: WCapExpr = wcap_expr(sl.base, fd, gfns, structs, mfuncs, a, atargets);
        a = br.caps;
        if (br.changed) {
          schanged = true;
        }
        nbase = br.expr;
      }
      return WCapExpr { expr: ast.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nv, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col, written: sl.written }, caps: a, changed: schanged };
    },
    ast.ExprFieldAccess(fa) => {
      let o: WCapExpr = wcap_expr(fa.obj, fd, gfns, structs, mfuncs, acc, atargets);
      return WCapExpr { expr: ast.ExprFieldAccess { obj: o.expr, field: fa.field, line: fa.line, col: fa.col, ty: fa.ty }, caps: o.caps, changed: o.changed };
    },
    _ => {
      return WCapExpr { expr: e, caps: acc, changed: false };
    }
  }
  return WCapExpr { expr: e, caps: acc, changed: false };
}

// wcap_stmt rewrites the lambdas in one statement's OWN expressions, returning
// the caps whose cell decls the caller must emit before it. A statement with a
// nested block (if / while / for / match / defer) has that block rewritten by
// box_wide_captures_stmts, which places its cells INSIDE the block — a capture
// declared in the block must not have its cell hoisted out of scope.
function wcap_stmt(st: ast.Stmt, fd: parser.FuncDecl, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs, acc: WCaps, atargets: string[]): WCapStmt {
  match (st) {
    ast.StmtVar(v) => {
      let r: WCapExpr = wcap_expr(v.init, fd, gfns, structs, mfuncs, acc, atargets);
      return WCapStmt { stmt: ast.StmtVar { name: v.name, type_name: v.type_name, init: r.expr, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types }, caps: r.caps, changed: r.changed };
    },
    ast.StmtAssign(a) => {
      let r: WCapExpr = wcap_expr(a.value, fd, gfns, structs, mfuncs, acc, atargets);
      return WCapStmt { stmt: ast.StmtAssign { target: a.target, value: r.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, caps: r.caps, changed: r.changed };
    },
    ast.StmtReturn(r) => {
      let rr: WCapExpr = wcap_expr(r.value, fd, gfns, structs, mfuncs, acc, atargets);
      return WCapStmt { stmt: ast.StmtReturn { value: rr.expr, line: r.line, col: r.col }, caps: rr.caps, changed: rr.changed };
    },
    ast.StmtExpr(e) => {
      let er: WCapExpr = wcap_expr(e.value, fd, gfns, structs, mfuncs, acc, atargets);
      return WCapStmt { stmt: ast.StmtExpr { value: er.expr, line: 0 }, caps: er.caps, changed: er.changed };
    },
    ast.StmtIf(f) => {
      let cr: WCapExpr = wcap_expr(f.cond, fd, gfns, structs, mfuncs, acc, atargets);
      let tb: WCapBody = box_wide_captures_stmts(f.then_body, fd, gfns, structs, mfuncs, atargets);
      let eb: WCapBody = box_wide_captures_stmts(f.else_body, fd, gfns, structs, mfuncs, atargets);
      return WCapStmt { stmt: ast.StmtIf { cond: cr.expr, then_body: tb.stmts, else_body: eb.stmts, line: 0, else_chained: false, sugar: parser.no_match_sugar(), origin: "" }, caps: cr.caps, changed: cr.changed || tb.changed || eb.changed };
    },
    ast.StmtWhile(w) => {
      let cr: WCapExpr = wcap_expr(w.cond, fd, gfns, structs, mfuncs, acc, atargets);
      let wb: WCapBody = box_wide_captures_stmts(w.body, fd, gfns, structs, mfuncs, atargets);
      return WCapStmt { stmt: ast.StmtWhile { cond: cr.expr, body: wb.stmts, label: w.label, line: w.line, is_loop: w.is_loop }, caps: cr.caps, changed: cr.changed || wb.changed };
    },
    ast.StmtFor(fr) => {
      let itr: WCapExpr = wcap_expr(fr.iter, fd, gfns, structs, mfuncs, acc, atargets);
      let fb: WCapBody = box_wide_captures_stmts(fr.body, fd, gfns, structs, mfuncs, atargets);
      return WCapStmt { stmt: ast.StmtFor { var_name: fr.var_name, iter: itr.expr, body: fb.stmts, label: fr.label, line: fr.line }, caps: itr.caps, changed: itr.changed || fb.changed };
    },
    ast.StmtMatch(m) => {
      let sr: WCapExpr = wcap_expr(m.scrutinee, fd, gfns, structs, mfuncs, acc, atargets);
      let a: WCaps = sr.caps;
      let mchanged: boolean = sr.changed;
      let na: ast.MatchArm[] = [];
      for arm in m.arms {
        let ng: ast.Expr = arm.guard;
        if (arm.has_guard) {
          let gr: WCapExpr = wcap_expr(arm.guard, fd, gfns, structs, mfuncs, a, atargets);
          a = gr.caps;
          if (gr.changed) {
            mchanged = true;
          }
          ng = gr.expr;
        }
        let ab: WCapBody = box_wide_captures_stmts(arm.body, fd, gfns, structs, mfuncs, atargets);
        if (ab.changed) {
          mchanged = true;
        }
        na = na.append(ast.MatchArm { ...arm, body: ab.stmts, guard: ng });
      }
      return WCapStmt { stmt: ast.StmtMatch { ...m, scrutinee: sr.expr, arms: na }, caps: a, changed: mchanged };
    },
    _ => {
      return WCapStmt { stmt: st, caps: acc, changed: false };
    }
  }
  return WCapStmt { stmt: st, caps: acc, changed: false };
}

// wcap_stmt_needs_env_box reports whether the lambda(s) in `stmts[i]` can reach
// the closure env box, i.e. whether a wide capture there needs a cell at all.
// The one shape that cannot is `let f = <lambda>` where `f` is only direct-
// called afterwards: the param-lift passes its captures as call arguments, no
// box involved, and a wide scalar passes as an argument fine. Every other shape —
// a returned lambda, a lambda in call-argument / array-element / struct-field
// position, or a binding used as a value — goes through the box.
function wcap_stmt_needs_env_box(stmts: ast.Stmt[], i: i32): boolean {
  let bname: string = "";
  match (stmts[i]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprLambda(_) => {
          bname = v.name;
        },
        _ => {}
      }
    },
    _ => {}
  }
  if (bname.len() == 0) {
    return true;
  }
  let j: i32 = i + 1;
  while (j < stmts.len()) {
    if (ident_used_as_value_stmt(stmts[j], bname)) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

// box_wide_captures_stmts rewrites a statement list, emitting each statement's
// wide-capture cell decls immediately before it — so the cell is created after
// everything it reads is in scope, and inside whatever block that is.
function box_wide_captures_stmts(stmts: ast.Stmt[], fd: parser.FuncDecl, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs, atargets: string[]): WCapBody {
  let out: ast.Stmt[] = [];
  let changed: boolean = false;
  let i: i32 = 0;
  while (i < stmts.len()) {
    // A `let f = <lambda>` whose `f` is only ever DIRECTLY CALLED never
    // builds an env box: the param-lift hoists it to __lam_<k>(origparams…,
    // captures…) and threads the captures as call ARGUMENTS (#5301), which
    // carries a wide scalar natively. Cellaring those would only do harm —
    // it broke `let f = () => base + 2000000000` over an i64 base, which had
    // always lowered. Same escape test box_mutated_scalar_captures uses.
    if (!wcap_stmt_needs_env_box(stmts, i)) {
      out = out.append(stmts[i]);
      i = i + 1;
      continue;
    }
    let empty: WCaps = WCaps { names: [], types: [] };
    let r: WCapStmt = wcap_stmt(stmts[i], fd, gfns, structs, mfuncs, empty, atargets);
    if (r.changed) {
      changed = true;
    }
    let ci: i32 = 0;
    while (ci < r.caps.names.len()) {
      out = out.append(wcap_cell_decl(r.caps.names[ci], r.caps.types[ci]));
      changed = true;
      ci = ci + 1;
    }
    out = out.append(r.stmt);
    i = i + 1;
  }
  return WCapBody { stmts: out, changed: changed };
}

// has_wide_cap_expr / _stmt / _stmts are the READ-ONLY detector: the same walk
// wcap_expr does, but answering "is there a wide capture here?" without building
// a single node. It exists because the rewriting walk rebuilds every statement
// and expression it visits, so running it speculatively on every function copied
// the whole compiler AST once per function and exhausted the 16 GiB arena
// (exit 125) long before it reached a function that needed rewriting. Detect
// first, rebuild only where it pays.
function has_wide_cap_expr(e: ast.Expr, fd: parser.FuncDecl, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs, atargets: string[]): boolean {
  match (e) {
    ast.ExprLambda(lm) => {
      let caps: string[] = lambda_captures(lm, fd);
      let shared: string[] = wcap_shared_targets(lm, atargets);
      let ci: i32 = 0;
      while (ci < caps.len()) {
        let cn: string = caps[ci];
        if (util.index_of_str(shared, cn) < 0 && is_wide_cap_type(lambda_capture_type(lm, cn))) {
          return true;
        }
        ci = ci + 1;
      }
      let si: i32 = 0;
      while (si < lm.body.len()) {
        if (has_wide_cap_stmt(lm.body[si], fd, gfns, structs, mfuncs, atargets)) {
          return true;
        }
        si = si + 1;
      }
      return false;
    },
    ast.ExprBinary(b) => {
      return has_wide_cap_expr(b.left, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_expr(b.right, fd, gfns, structs, mfuncs, atargets);
    },
    ast.ExprUnary(u) => {
      return has_wide_cap_expr(u.operand, fd, gfns, structs, mfuncs, atargets);
    },
    ast.ExprCall(c) => {
      // Mirrors wcap_expr's IIFE exemption: an immediately-invoked
      // lambda's OWN wide captures need no cell, so looking at them here
      // would report work the rewriter declines to do — and
      // box_wide_captures would rebuild a body it did not change.
      if let ast.ExprLambda(ilm) = c.callee {
        let isi: i32 = 0;
        while (isi < ilm.body.len()) {
          if (has_wide_cap_stmt(ilm.body[isi], fd, gfns, structs, mfuncs, atargets)) {
            return true;
          }
          isi = isi + 1;
        }
        for iarg in c.args {
          if (has_wide_cap_expr(iarg, fd, gfns, structs, mfuncs, atargets)) {
            return true;
          }
        }
        return false;
      }
      if (has_wide_cap_expr(c.callee, fd, gfns, structs, mfuncs, atargets)) {
        return true;
      }
      for arg in c.args {
        if (has_wide_cap_expr(arg, fd, gfns, structs, mfuncs, atargets)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprArray(ar) => {
      let i: i32 = 0;
      while (i < ar.elements.len()) {
        if (has_wide_cap_expr(ar.elements[i], fd, gfns, structs, mfuncs, atargets)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        if (has_wide_cap_expr(el, fd, gfns, structs, mfuncs, atargets)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprIndex(x) => {
      return has_wide_cap_expr(x.array, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_expr(x.index, fd, gfns, structs, mfuncs, atargets);
    },
    ast.ExprSlice(sl) => {
      return has_wide_cap_expr(sl.array, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_expr(sl.start, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_expr(sl.end, fd, gfns, structs, mfuncs, atargets);
    },
    ast.ExprStructLit(sl) => {
      for fv in sl.field_values {
        if (has_wide_cap_expr(fv, fd, gfns, structs, mfuncs, atargets)) {
          return true;
        }
      }
      if (sl.has_base) {
        return has_wide_cap_expr(sl.base, fd, gfns, structs, mfuncs, atargets);
      }
      return false;
    },
    ast.ExprFieldAccess(fa) => {
      return has_wide_cap_expr(fa.obj, fd, gfns, structs, mfuncs, atargets);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function has_wide_cap_stmt(st: ast.Stmt, fd: parser.FuncDecl, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs, atargets: string[]): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return has_wide_cap_expr(v.init, fd, gfns, structs, mfuncs, atargets);
    },
    ast.StmtAssign(a) => {
      return has_wide_cap_expr(a.value, fd, gfns, structs, mfuncs, atargets);
    },
    ast.StmtReturn(r) => {
      return has_wide_cap_expr(r.value, fd, gfns, structs, mfuncs, atargets);
    },
    ast.StmtExpr(e) => {
      return has_wide_cap_expr(e.value, fd, gfns, structs, mfuncs, atargets);
    },
    ast.StmtIf(f) => {
      return has_wide_cap_expr(f.cond, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_stmts(f.then_body, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_stmts(f.else_body, fd, gfns, structs, mfuncs, atargets);
    },
    ast.StmtWhile(w) => {
      return has_wide_cap_expr(w.cond, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_stmts(w.body, fd, gfns, structs, mfuncs, atargets);
    },
    ast.StmtFor(fr) => {
      return has_wide_cap_expr(fr.iter, fd, gfns, structs, mfuncs, atargets) || has_wide_cap_stmts(fr.body, fd, gfns, structs, mfuncs, atargets);
    },
    ast.StmtMatch(m) => {
      if (has_wide_cap_expr(m.scrutinee, fd, gfns, structs, mfuncs, atargets)) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard && has_wide_cap_expr(arm.guard, fd, gfns, structs, mfuncs, atargets)) {
          return true;
        }
        if (has_wide_cap_stmts(arm.body, fd, gfns, structs, mfuncs, atargets)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function has_wide_cap_stmts(stmts: ast.Stmt[], fd: parser.FuncDecl, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs, atargets: string[]): boolean {
  for stmt in stmts {
    if (has_wide_cap_stmt(stmt, fd, gfns, structs, mfuncs, atargets)) {
      return true;
    }
  }
  return false;
}

// box_wide_captures is the per-function entry point (step 0-pre of the lift
// pipeline). The read-only detector runs first: the rewriting walk rebuilds
// every node it visits, so it must only run on a function that actually has a
// wide capture — otherwise it copies the entire compiler AST function by
// function and exhausts the arena.
function box_wide_captures(fd: parser.FuncDecl, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs): parser.FuncDecl {
  let atargets: string[] = irtables.body_assign_targets(fd.body);
  if (!has_wide_cap_stmts(fd.body, fd, gfns, structs, mfuncs, atargets)) {
    return fd;
  }
  let b: WCapBody = box_wide_captures_stmts(fd.body, fd, gfns, structs, mfuncs, atargets);
  if (!b.changed) {
    return fd;
  }
  return parser.FuncDecl { ...fd, body: b.stmts };
}

// box_mutated_scalar_captures finds `fd`'s locals to box into shared cells
// (see the block comment above): i32/boolean captures a lambda body writes
// (#2850), and — for ESCAPING bindings — captures of any type that the outer
// body reassigns (#5394). Returns `fd` unchanged when none qualify (lambda-free
// and read-only-capture functions stay byte-identical).
function box_mutated_scalar_captures(fd: parser.FuncDecl, gfns: string[], structs: irtables.StructTab, mfuncs: MFuncs): parser.FuncDecl {
  let otargets: string[] = irtables.body_assign_targets(fd.body);
  let dvars: string[] = body_var_decl_names(fd.body);
  let acc: BoxScan = box_scan_stmts(fd.body, fd, structs, mfuncs, otargets, dvars, BoxScan { names: [], types: [] });
  let boxed: string[] = acc.names;
  let btypes: string[] = acc.types;
  if (boxed.len() == 0) {
    return fd;
  }
  // The DECLARATION SITE of each boxed name, so the rewrite can tell the `let`
  // the cell is built from apart from a re-declaration of the same spelling
  // (#7253). Lexical resolution has already made each declaration distinct.
  let bsites: string[] = [];
  let si: i32 = 0;
  while (si < boxed.len()) {
    bsites = bsites.append(first_var_site(fd.body, boxed[si]));
    si = si + 1;
  }
  let bound: string[] = [];
  let body: ast.Stmt[] = capturebox.box_rewrite_stmts(fd.body, boxed, btypes, bsites, bound);
  // A boxed parameter has no `let` to turn into its cell, so the cell is built
  // from the parameter on entry.
  let pcells: ast.Stmt[] = [];
  let pi: i32 = 0;
  while (pi < boxed.len()) {
    if (bsites[pi].len() == 0 && is_param_name(fd.params, boxed[pi])) {
      let pref: ast.Expr = ast.ExprIdent { name: boxed[pi], line: fd.line, col: fd.col, ty: "" };
      pcells = pcells.append(capturebox.cell_decl(boxed[pi], btypes[pi], pref, fd.line, fd.col));
    }
    pi = pi + 1;
  }
  for st in body {
    pcells = pcells.append(st);
  }
  return parser.FuncDecl { ...fd, body: pcells };
}

function is_param_name(params: ast.ParamDecl[], name: string): boolean {
  for p in params {
    if (p.name == name) {
      return true;
    }
  }
  return false;
}

// first_var_site: the binding-site key of the FIRST `let <name>` in `stmts`,
// pre-order, or "" when the name is a parameter or is never `let`-declared.
function first_var_site(stmts: ast.Stmt[], name: string): string {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          return irtables.reclaim_site_key_of(v.name, v.line, v.col);
        }
      },
      ast.StmtIf(f) => {
        let t: string = first_var_site(f.then_body, name);
        if (t.len() > 0) {
          return t;
        }
        let e2: string = first_var_site(f.else_body, name);
        if (e2.len() > 0) {
          return e2;
        }
      },
      ast.StmtWhile(w) => {
        let t: string = first_var_site(w.body, name);
        if (t.len() > 0) {
          return t;
        }
      },
      ast.StmtFor(fo) => {
        let t: string = first_var_site(fo.body, name);
        if (t.len() > 0) {
          return t;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          let t: string = first_var_site(arm.body, name);
          if (t.len() > 0) {
            return t;
          }
        }
      },
      ast.StmtDefer(d) => {
        let t: string = first_var_site([d.action], name);
        if (t.len() > 0) {
          return t;
        }
      },
      _ => {}
    }
  }
  return "";
}

// BoxScan: box_scan_stmts' paired accumulator — boxed capture NAMES and the
// cell TYPE each is rewritten to.
struct BoxScan { names: string[], types: string[] }

// box_scan_stmts walks one statement LIST for the two lambda-binding shapes
// box_mutated_scalar_captures recognises, and recurses into nested blocks
// (#6539). The scan used to run over `fd.body` alone, so a `let g = <lambda>`
// one block deeper — the overwhelmingly common spelling, inside a loop — was
// never seen and its mutated capture kept the construction-time snapshot.
// Measured: the identical binding returned the reference answer at top level
// and the stale one inside a `while`.
//
// The escape test scans the REMAINDER OF THE SAME BLOCK, which is the scope
// that can still use the binding as a value. `esc` only ever widens what is
// boxed, and boxing an already-correct read-only capture is a representation
// change rather than a behaviour one, so a block-local answer is the
// conservative direction here.
function box_scan_stmts(stmts: ast.Stmt[], fd: parser.FuncDecl, structs: irtables.StructTab, mfuncs: MFuncs, otargets: string[], dvars: string[], acc: BoxScan): BoxScan {
  let boxed: string[] = acc.names;
  let btypes: string[] = acc.types;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let lam_ok: boolean = false;
    let bname: string = "";
    let lam: ast.ExprLambda = ast.ExprLambda { params: [], ret_type: "", body: [], use_infer: false, origin: "", line: 0, col: 0, captures: [], captures_known: false, ret_fn_ret: "", ret_fn_param_types: "" };
    let nested: ast.ExprLambda[] = [];
    match (stmts[i]) {
      ast.StmtVar(v) => {
        match (v.init) {
          ast.ExprLambda(l) => {
            lam = l;
            lam_ok = true;
            bname = v.name;
          },
          _ => {
            nested = box_nested_lambdas(v.init, nested);
          }
        }
      },
      ast.StmtReturn(r) => {
        match (r.value) {
          ast.ExprLambda(l) => {
            lam = l;
            lam_ok = true;
          },
          _ => {
            nested = box_nested_lambdas(r.value, nested);
          }
        }
      },
      ast.StmtAssign(a2) => {
        nested = box_nested_lambdas(a2.value, nested);
      },
      ast.StmtExpr(e2) => {
        nested = box_nested_lambdas(e2.value, nested);
      },
      ast.StmtIf(f) => {
        let a1: BoxScan = box_scan_stmts(f.then_body, fd, structs, mfuncs, otargets, dvars, BoxScan { names: boxed, types: btypes });
        let a2: BoxScan = box_scan_stmts(f.else_body, fd, structs, mfuncs, otargets, dvars, a1);
        boxed = a2.names;
        btypes = a2.types;
      },
      ast.StmtWhile(w) => {
        let aw: BoxScan = box_scan_stmts(w.body, fd, structs, mfuncs, otargets, dvars, BoxScan { names: boxed, types: btypes });
        boxed = aw.names;
        btypes = aw.types;
      },
      ast.StmtFor(fo) => {
        let af: BoxScan = box_scan_stmts(fo.body, fd, structs, mfuncs, otargets, dvars, BoxScan { names: boxed, types: btypes });
        boxed = af.names;
        btypes = af.types;
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          let am: BoxScan = box_scan_stmts(arm.body, fd, structs, mfuncs, otargets, dvars, BoxScan { names: boxed, types: btypes });
          boxed = am.names;
          btypes = am.types;
        }
      },
      _ => {}
    }
    // A lambda in an OPERAND position — a struct-literal field, a call
    // argument, an array element (#6539). The `let f = <lambda>` /
    // `return <lambda>` shapes above match only when the value IS a
    // lambda, so these were invisible at any depth: the capture kept its
    // construction-time snapshot even at top level. Such a lambda is
    // ESCAPING by construction — it is being stored into or passed to
    // something, which is the make_closure env-box path whose snapshot the
    // cell has to bypass — so it needs no `esc` test of its own.
    let ni: i32 = 0;
    while (ni < nested.len()) {
      let nacc: BoxScan = box_apply_lambda(nested[ni], true, fd, structs, mfuncs, otargets, dvars, BoxScan { names: boxed, types: btypes });
      boxed = nacc.names;
      btypes = nacc.types;
      ni = ni + 1;
    }
    if (lam_ok) {
      let caps: string[] = lambda_captures(lam, fd);
      let wtargets: string[] = irtables.lambda_write_targets(lam.body);
      // Escape test (#5394): a returned inline lambda (bname == "")
      // escapes by definition; a `let f = <lambda>` binding escapes when
      // `f` is later used as a VALUE (returned / passed / stored /
      // captured), not only direct-called. Only escaping bindings take
      // the make_closure env-box path whose creation-time snapshot the
      // cell must bypass; directly-called bindings get call-site capture
      // passing from the param-lift instead (#5301).
      let esc: boolean = true;
      if (bname.len() > 0) {
        esc = false;
        let esci: i32 = i + 1;
        while (esci < stmts.len()) {
          if (ident_used_as_value_stmt(stmts[esci], bname)) {
            esc = true;
          }
          esci = esci + 1;
        }
      }
      let ci: i32 = 0;
      while (ci < caps.len()) {
        let cn: string = caps[ci];
        let ct: string = lambda_capture_type(lam, cn);
        if (ct.len() > 0 && util.index_of_str(wtargets, cn) >= 0 && util.index_of_str(boxed, cn) < 0) {
          boxed = boxed.append(cn);
          btypes = btypes.append(ct);
        } else if (esc && ct.len() > 0 && util.index_of_str(otargets, cn) >= 0
          && util.index_of_str(dvars, cn) >= 0 && util.index_of_str(boxed, cn) < 0) {
          boxed = boxed.append(cn);
          btypes = btypes.append(ct);
        }
        ci = ci + 1;
      }
    }
    i = i + 1;
  }
  return BoxScan { names: boxed, types: btypes };
}

// box_apply_lambda applies the two boxing clauses to one lambda's captures:
// #2850 (a capture the LAMBDA body writes, itself or through a lambda nested in
// it) and #5394 (any type the OUTER body reassigns, for an escaping binding).
// Shared by the statement-shape path and the operand-position path so the two
// cannot drift.
function box_apply_lambda(lam: ast.ExprLambda, esc: boolean, fd: parser.FuncDecl, structs: irtables.StructTab, mfuncs: MFuncs, otargets: string[], dvars: string[], acc: BoxScan): BoxScan {
  let boxed: string[] = acc.names;
  let btypes: string[] = acc.types;
  let caps: string[] = lambda_captures(lam, fd);
  let wtargets: string[] = irtables.lambda_write_targets(lam.body);
  let ci: i32 = 0;
  while (ci < caps.len()) {
    let cn: string = caps[ci];
    let ct: string = lambda_capture_type(lam, cn);
    if (ct.len() > 0 && util.index_of_str(wtargets, cn) >= 0 && util.index_of_str(boxed, cn) < 0) {
      boxed = boxed.append(cn);
      btypes = btypes.append(ct);
    } else if (esc && ct.len() > 0 && util.index_of_str(otargets, cn) >= 0
      && util.index_of_str(dvars, cn) >= 0 && util.index_of_str(boxed, cn) < 0) {
      boxed = boxed.append(cn);
      btypes = btypes.append(ct);
    }
    ci = ci + 1;
  }
  return BoxScan { names: boxed, types: btypes };
}

// box_nested_lambdas collects lambdas sitting in OPERAND positions of `e` —
// struct-literal field, call argument or callee, array / tuple element, and the
// arithmetic operands. It deliberately does NOT descend into a collected
// lambda's own BODY: that is a different scope, whose captures belong to that
// lambda's own frame and are handled when it is itself lifted.
function box_nested_lambdas(e: ast.Expr, acc: ast.ExprLambda[]): ast.ExprLambda[] {
  let out: ast.ExprLambda[] = acc;
  match (e) {
    ast.ExprLambda(l) => {
      // A value block (an if- / match-expression, a block expression, a
      // comprehension) is inlined into this function and reads its slots
      // directly, so it is no capture of anything: only the lambdas INSIDE it
      // are collected.
      if (parser.is_value_block_origin(l.origin)) {
        return box_nested_lambdas_stmts(l.body, out);
      }
      return out.append(l);
    },
    ast.ExprStructLit(sl) => {
      for fv in sl.field_values {
        out = box_nested_lambdas(fv, out);
      }
      if (sl.has_base) {
        out = box_nested_lambdas(sl.base, out);
      }
      return out;
    },
    ast.ExprCall(c) => {
      out = box_nested_lambdas(c.callee, out);
      for arg in c.args {
        out = box_nested_lambdas(arg, out);
      }
      return out;
    },
    ast.ExprArray(ar) => {
      let i: i32 = 0;
      while (i < ar.elements.len()) {
        out = box_nested_lambdas(ar.elements[i], out);
        i = i + 1;
      }
      return out;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        out = box_nested_lambdas(el, out);
      }
      return out;
    },
    ast.ExprBinary(b) => {
      return box_nested_lambdas(b.right, box_nested_lambdas(b.left, out));
    },
    ast.ExprUnary(u) => {
      return box_nested_lambdas(u.operand, out);
    },
    ast.ExprIndex(ix) => {
      return box_nested_lambdas(ix.index, box_nested_lambdas(ix.array, out));
    },
    ast.ExprFieldAccess(fa) => {
      return box_nested_lambdas(fa.obj, out);
    },
    _ => {
      return out;
    }
  }
  return out;
}

// box_nested_lambdas_stmts collects the operand-position lambdas of every
// statement in an inlined value block, nested blocks included.
function box_nested_lambdas_stmts(stmts: ast.Stmt[], acc: ast.ExprLambda[]): ast.ExprLambda[] {
  let out: ast.ExprLambda[] = acc;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        out = box_nested_lambdas(v.init, out);
      },
      ast.StmtAssign(a) => {
        out = box_nested_lambdas(a.value, out);
      },
      ast.StmtReturn(r) => {
        out = box_nested_lambdas(r.value, out);
      },
      ast.StmtExpr(e) => {
        out = box_nested_lambdas(e.value, out);
      },
      ast.StmtIf(f) => {
        out = box_nested_lambdas_stmts(f.else_body, box_nested_lambdas_stmts(f.then_body, box_nested_lambdas(f.cond, out)));
      },
      ast.StmtWhile(w) => {
        out = box_nested_lambdas_stmts(w.body, box_nested_lambdas(w.cond, out));
      },
      ast.StmtFor(fo) => {
        out = box_nested_lambdas_stmts(fo.body, box_nested_lambdas(fo.iter, out));
      },
      ast.StmtMatch(m) => {
        out = box_nested_lambdas(m.scrutinee, out);
        for arm in m.arms {
          out = box_nested_lambdas_stmts(arm.body, out);
        }
      },
      ast.StmtDefer(d) => {
        out = box_nested_lambdas_stmts([d.action], out);
      },
      _ => {}
    }
  }
  return out;
}

// lift_lambdas is the module pre-pass. Returns the module unchanged when no
// lambda was lifted (keeping lambda-free modules byte-identical), else a module
// whose bodies reference the hoisted __lam_<k> functions, with those functions
// appended.
// unwrap_sole_iife_return beta-reduces a function whose ENTIRE body is
// `return (() => { … })()` — a 0-arg immediately-invoked lambda — to just that
// lambda's body. A block-body arrow lambda `() => { STMTS; value }` is
// represented as exactly this IIFE-return, so once such a lambda is lifted to a
// `__lam_N`, its body is `[return (IIFE)()]` and any lambda NESTED in the block
// stays buried inside the IIFE where closure_lift_one never descends → the inner
// lambda doesn't lift and the module bails. Inlining the
// IIFE (rather than hoisting it — which breaks enclosing-loop break/continue and
// match-expression payloads) is semantically neutral: no function boundary is
// added, so control flow and captures resolve exactly as before, and the block's
// nested lambdas become ordinary top-level statements the next closure_lift_one
// round lifts. Only the exact sole-`return`-0-arg-IIFE-0-args shape is touched.
function unwrap_sole_iife_return(fd: parser.FuncDecl): parser.FuncDecl {
  if (fd.body.len() != 1) {
    return fd;
  }
  match (fd.body[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprCall(c) => {
          if (c.args.len() != 0) {
            return fd;
          }
          match (c.callee) {
            ast.ExprLambda(lam) => {
              if (lam.params.len() != 0) {
                return fd;
              }
              // The spliced body carries the IIFE's arm returns
              // into a function, past the pre-worklist `return
              // <lambda>` desugar, so run it here. Without it an
              // arm lambda reached the lowering unlifted.
              return parser.FuncDecl { ...fd, body: desugar_lambda_returns(lam.body, 0, ret_sig_of(lam.ret_type, lam.ret_fn_ret, lam.ret_fn_param_types)).body };
            },
            _ => {
              return fd;
            }
          }
        },
        _ => {
          return fd;
        }
      }
    },
    _ => {
      return fd;
    }
  }
  return fd;
}

pub function lift_lambdas(raw_mod: parser.Module): parser.Module {
  // Empty view = "this module is the whole program", the historical behaviour
  // every caller but the per-module concat wants.
  return lift_lambdas_view(raw_mod, []);
}

// module_sig_view is the whole-program signature view a PER-MODULE lift has to
// be given: the union of every part's declarations, collected BEFORE any of them
// is lifted. Collecting pre-lift is sound because lifting only ADDS `$wrap` /
// `__lam_` / `$clo` functions — it never changes a signature already there.
pub function module_sig_view(mods: parser.Module[]): parser.FuncDecl[] {
  let view: parser.FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mods.len()) {
    let f: i32 = 0;
    while (f < mods[i].funcs.len()) {
      view = view.append(mods[i].funcs[f]);
      f = f + 1;
    }
    i = i + 1;
  }
  return view;
}

pub function prepare_lambda_parts(mods: parser.Module[]): parser.Module[] {
  let prepared: parser.Module[] = [];
  for mod in mods {
    prepared = prepared.append(parser.fill_default_args_module(mod));
  }
  return checker.ensure_annotated_parts(prepared);
}

// lift_lambdas_view is lift_lambdas with an explicit whole-program SIGNATURE
// view: `view` supplies the function declarations the pass consults to answer
// "is this callee's parameter fn-typed?" (lift_callee_param_is_fn), "is this
// name a function value or a const?" (lift_names_fn_value) and "what is this
// wrap trampoline's target signature?" (make_wrap_named_func), while the
// functions actually LIFTED remain the module's own.
//
// Those questions decide whether a fn-VALUE argument gets env-boxed at the call
// site. Answering them from the module's own functions is correct only when the
// callee lives in the module. In a per-module build it does not: the caller saw
// no declaration for `srv.apply(f, n)`, so it passed `f` as a raw code address
// while the callee — which always dereferences a box — read slot 1 of that
// address and jumped through garbage (#5698).
//
// An empty `view` means "use the module's own functions", so every caller that
// does not thread a view is byte-identical to before.
//
// The lift is on every production route into the lowering, including the
// per-module and stdin drivers that never reach module_with_builtins, so its
// result has each `str` erased.
pub function lift_lambdas_view(raw_mod: parser.Module, view: parser.FuncDecl[]): parser.Module {
  return parser.erase_view_module(lift_lambdas_view_typed(raw_mod, view));
}

// lift_lambdas_typed is lift_lambdas for the typed lowering, which keeps each
// `str` as a view.
pub function lift_lambdas_typed(raw_mod: parser.Module): parser.Module {
  return lift_lambdas_view_typed(raw_mod, []);
}

pub function lift_lambdas_view_typed(raw_mod: parser.Module, view: parser.FuncDecl[]): parser.Module {
  // Fill omitted trailing arguments from default parameter values before the
  // IR path inspects the module, so `f(5)` to `f(a, b = 128)` reaches the IR
  // as `f(5, 128)`. No-op for default-free modules.
  let mod: parser.Module = checker.ensure_annotated(parser.fill_default_args_module(raw_mod));
  // sigs is the signature table every "what does this callee look like?" query
  // below reads. It is the whole-program view when one was threaded in, else
  // the module's own functions (identical to the pre-view behaviour).
  let sigs: parser.FuncDecl[] = mod.funcs;
  if (view.len() > 0) {
    sigs = view;
  }
  // Indexed once here: sigs is settled before the drain and never changes
  // across its rounds, so every lift_callee_* lookup below shares one index.
  let mf: MFuncs = mfuncs_table(sigs);
  let mstab: irtables.StructTab = irtables.struct_tab(mod.structs);
  let gfns: string[] = [];
  let gi: i32 = 0;
  while (gi < sigs.len()) {
    if (sigs[gi].receiver_type.len() == 0) {
      gfns = gfns.append(sigs[gi].name);
    }
    gi = gi + 1;
  }
  // Indexed once for the whole lift (see gfns_visible_in).
  let gset: irtables.SigReg = irtables.sig_reg_of(gfns);
  let acc: LiftAcc = LiftAcc { funcs: [], counter: 0 };
  let newfuncs: parser.FuncDecl[] = [];
  // Worklist: the module's functions PLUS every function lifted out of a
  // lambda body. Re-processing the lifted `__lam_N` / `$clo` functions is what
  // lets a NESTED lambda (a lambda defined inside another lambda's body) lift:
  // the outer lift produces a top-level function whose body still holds the
  // inner lambda, which a later worklist round then lifts in turn. A two-level
  // capture resolves because the outer lift turns the captured outer var into a
  // PARAM of the lifted function, which the inner lift sees as an ordinary
  // param. Each round strips one nesting level, so the worklist terminates.
  // COPY mod.funcs into a fresh worklist rather than aliasing it: the drain
  // below (`worklist = worklist.append(...)`) must not mutate the caller's
  // `mod.funcs`. The Go backend's append reallocates (so mod is untouched),
  // but the self-host backend appends into the shared backing array in place,
  // so aliasing here leaks lifted `$wrap`/`$clo` trampolines back into the
  // input module — which the AST emit path (`emit_module` loops `mod.funcs`)
  // then emits, diverging the byte-identical self-host fixpoint. (#3445)
  // Desugar every inline `return <lambda>` in the ORIGINAL module functions to
  // `let $lamret$N = <lambda>; return $lamret$N;` (recursing into if/while/for/
  // match arms) as they enter the worklist, so the closure-lift pipeline treats a
  // returned lambda as an ordinary closure local — unique `$cloN` naming +
  // env-first dispatch — fixing the mis-dispatched / colliding / AST-bailing inline
  // lambda returns (#5266). Applied ONLY to source functions, not to the lifted
  // `__lam_N` / `$cloN` bodies drained onto the worklist later: a lifted body's own
  // `return <lambda>` is a lambda-returning-lambda (#5281), which the existing hoist
  // handles and this desugar must not perturb (it regressed the `curry` shape).
  let worklist: parser.FuncDecl[] = [];
  let wlcp: i32 = 0;
  while (wlcp < mod.funcs.len()) {
    let wf: parser.FuncDecl = mod.funcs[wlcp];
    let resolved = lexical.resolve_func(wf);
    // Resolve each deferred read at its registration site before cleanup
    // expansion moves it across lexical scopes and shadowing declarations.
    wf = parser.lower_defers_func(resolved.func);
    let wdlr: DesugarRet = desugar_lambda_returns(wf.body, 0, ret_sig_of(wf.ret_type, wf.ret_fn_ret, wf.ret_fn_param_types));
    if (wdlr.counter != 0) {
      wf = parser.FuncDecl { ...wf, body: wdlr.body };
    }
    worklist = worklist.append(wf);
    wlcp = wlcp + 1;
  }
  let wi: i32 = 0;
  while (wi < worklist.len()) {
    let fd: parser.FuncDecl = worklist[wi];
    // A lifted body is a declaration of its own now, so its `return
    // <lambda>` takes the `$lamret$N` slot the pre-worklist pass gave a
    // source function's; a body that pass already rewrote has none left.
    fd = desugar_lifted_lambda_returns(fd);
    // 0-pre. Beta-reduce a `return (() => {…})()` sole body (a lifted
    // block-body arrow lambda) so nested lambdas in the block become ordinary
    // statements the lifts below can reach (#nested-capture). Inline, not
    // hoist — control flow + captures stay in scope.
    fd = unwrap_sole_iife_return(fd);
    // 0-pre. Snapshot 8-byte scalar captures (i64 / u64 / f64) into 1-element
    // cells so they fit the env box's 32-bit slot (#6046). Must run BEFORE
    // the lifts so they see the `i64[]` cell — pointer-shaped, which
    // cap_slot_ok already accepts — instead of a wide scalar it declines.
    fd = box_wide_captures(fd, gfns, mstab, mf);
    // 0. Box captured-and-mutated scalar locals into 1-element array cells so
    // a closure's write to a captured outer scalar is shared by reference
    // (#2850). Must run BEFORE the closure lifts so they see the boxed cell
    // (an `i32[]` capture passed by pointer) instead of a by-value scalar.
    fd = box_mutated_scalar_captures(fd, gfns, mstab, mf);
    let before: i32 = acc.funcs.len();
    // 0b. Capturing inline lambdas in array-element / struct-field-value
    // position (#2994): hoist each to a unique `<fd>$cloN` and rewrite the
    // lambda to a `__mkclo$<fd>$cloN(caps…)` env-box marker. Runs BEFORE the
    // other lifts so they see the marker (an ordinary call they leave alone),
    // not a bare ExprLambda they'd skip. The hoisted funcs join `acc` so the
    // drain below re-processes them (their own nested lambdas lift in a later
    // round); a body with no such closure is returned unchanged (fixpoint-safe).
    let (ic_stmts, ic_funcs) = lift_inline_closures(fd, gfns, mstab, mf);
    if (ic_funcs.len() > 0) {
      fd = parser.FuncDecl { ...fd, body: ic_stmts };
      let ici: i32 = 0;
      while (ici < ic_funcs.len()) {
        acc = LiftAcc { funcs: acc.funcs.append(ic_funcs[ici]), counter: acc.counter + 1 };
        ici = ici + 1;
      }
    }
    // 1. Capturing lambdas bound to a local + only directly called: param-lift.
    // Each round extends the global-fn set with the lambdas hoisted so far
    // (their `__lam_N` names), so a sibling lambda that CALLS an already-
    // hoisted capture-free lambda sees it as a global — not a capture it
    // can't type — and lifts too (closure-calls-closure).
    let cbody: ast.Stmt[] = fd.body;
    let more: boolean = true;
    while (more) {
      let lgfns: string[] = gfns;
      let gj: i32 = 0;
      while (gj < acc.funcs.len()) {
        lgfns = lgfns.append(acc.funcs[gj].name);
        gj = gj + 1;
      }
      let lsigs: MFuncs = mf;
      if (acc.funcs.len() > 0) {
        lsigs = mfuncs_extend(mf, acc.funcs);
      }
      let cl: ClosureLift = closure_lift_one(cbody, fd, acc, lgfns, mstab, lsigs);
      cbody = cl.body;
      acc = cl.acc;
      more = cl.changed;
    }
    // 2. No-capture lambdas passed as call arguments: hoist to function values.
    // The module-fn list is filtered to what is still VISIBLE here: a name
    // this function also binds is a local, not a call target (#7253).
    let r: LiftStmts = lift_stmts(cbody, acc, irtables.gfns_visible_in(fd, gfns, gset));
    acc = r.acc;
    let nb: ast.Stmt[] = r.stmts;
    newfuncs = newfuncs.append(parser.FuncDecl { ...fd, body: nb });
    // Drain the functions lifted by THIS iteration onto the worklist so their
    // OWN nested lambdas lift in a later round, then clear them (the counter
    // persists across iterations for unique `__lam_N` naming).
    // A function lifted out of a body is in the module that wrote the body.
    let k: i32 = before;
    while (k < acc.funcs.len()) {
      worklist = worklist.append(parser.FuncDecl { ...acc.funcs[k], module: fd.module });
      k = k + 1;
    }
    acc = LiftAcc { funcs: [], counter: acc.counter };
    wi = wi + 1;
  }
  // Keep resolved bindings and expanded cleanup even when no lambda lifted.
  // Keep explicit fields until #8989 is fixed: a spread here crashes stage1 bootstrap.
  let result: parser.Module = parser.Module { funcs: stamp_fn_local_types(newfuncs), structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs, trait_decls: mod.trait_decls, inferred_consts: mod.inferred_consts, todo_sites: mod.todo_sites };
  // Infer return types on the FINAL lifted module so a lifted lambda with an
  // inferred (empty) ret_type that returns i64/u64 is typed BEFORE eligibility
  // lowers it. Without this, eligibility ran on the un-inferred module and
  // `lower` bailed on the wide return (ret_is_i64 unknown) → the lambda took
  // the whole module out of the IR subset, even though EMIT (which runs on the
  // separately-inferred module) would have handled it.
  // infer_ret_types_module only fills EMPTY ret_types (annotated fns untouched)
  // and is idempotent with the drivers' own downstream infer pass.
  return parser.infer_ret_types_module(parser.lower_defers_module(result));
}
