import "./ir";
import "./util";
import "./irverify";
import "./irverifyrc";
import "./irverifystack";
import "./ssa";
import "./ssa_lift";
import "./rcsigs";
import "./rccertify";
import "./rcmemo";
import "std/envflag";

pub struct Gate { sigs: irverify.NameIndex, seen: usize, modelled: usize, abis: rccertify.Abis, rc: rcsigs.Table, rcops: rcsigs.OpTable, kinds: ssa_lift.KindTable, census: usize, memo: rcmemo.Memo, verify: boolean, certify: i32 }

pub function gate(sigs: irverify.NameIndex, kinds: ssa_lift.KindTable, abis: rccertify.Abis): Gate {
  let g: Gate = gate_unreported(sigs, kinds, abis);
  if (!report_on()) {
    return g;
  }
  return Gate { ...g, seen: buf_new(64), modelled: buf_new(64) };
}

pub function gate_unreported(sigs: irverify.NameIndex, kinds: ssa_lift.KindTable, abis: rccertify.Abis): Gate {
  let certify: i32 = util.certify_mode();
  let census: usize = 0 as usize;
  if (certify == 1) {
    census = buf_new(256);
  }
  return Gate { sigs: physical_signatures(sigs, abis), seen: 0 as usize, modelled: 0 as usize, abis: abis, rc: rcsigs.table(), rcops: rcsigs.op_table(), kinds: kinds, census: census, memo: rcmemo.off(), verify: util.verify_on(), certify: certify };
}

// External declarations keep their source arity when a unit has no lowered body.
function physical_signatures(sigs: irverify.NameIndex, abis: rccertify.Abis): irverify.NameIndex {
  let params: i32[] = sigs.params;
  for i in 0..sigs.names.len() {
    let at: i32 = abis.names.find(sigs.names[i]);
    if (at >= 0 && params[i] != abis.modes[at].len()) {
      params = params.with(i, abis.modes[at].len());
    }
  }
  return irverify.NameIndex { ...sigs, params: params };
}

pub function with_memo(g: Gate, m: rcmemo.Memo): Gate {
  if (g.certify != 2) {
    return g;
  }
  return Gate { ...g, memo: m };
}

pub function open_memo(target: string): rcmemo.Memo {
  if (util.certify_mode() != 2) {
    return rcmemo.off();
  }
  return rcmemo.open(target);
}

pub function close_memo(m: rcmemo.Memo): void {
  let line: string = rcmemo.close(m);
  if (line != "" && report_on()) {
    eprint("FERN_RC_CERTIFY: memo " + line);
  }
}

pub function report_on(): boolean {
  match (env("FERN_IR_VERIFY")) {
    Some(v) => {
      return envflag.value_on(v) && v != "quiet";
    },
    None => {
      return false;
    }
  }
}

pub function report(g: Gate): void {
  if (g.census != 0 as usize) {
    let lines: string = buf_take(g.census);
    buf_free(g.census);
    if (lines.len() > 0) {
      eprint(lines);
    }
  }
  if (!report_on()) {
    return;
  }
  let seen: i32 = buf_len(g.seen);
  let modelled: i32 = buf_len(g.modelled);
  eprint("FERN_IR_VERIFY: " + util.i32_to_string(seen) + " functions verified, " + util.i32_to_string(modelled)
    + " modelled by the stack verifier, " + util.i32_to_string(seen - modelled) + " skipped");
  buf_free(g.seen);
  buf_free(g.modelled);
}

pub struct Verdict { problems: irverify.Problem[], modelled: boolean }

pub function verify_problems(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): irverify.Problem[] {
  return verdict(fn_name, ops, n_params, n_locals, g).problems;
}

pub function verdict(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): Verdict {
  let out: irverify.Problem[] = irverify.verify_fn(fn_name, ops, n_params, n_locals, g.sigs);
  let sr: irverifystack.StackResult = irverifystack.verify_stack_fn(fn_name, ops, g.kinds.pops);
  let i: i32 = 0;
  while (i < sr.problems.len()) {
    out = out.append(sr.problems[i]);
    i = i + 1;
  }
  let rr: irverifyrc.RcResult = irverifyrc.verify_rc_fn(fn_name, ops);
  let j: i32 = 0;
  while (j < rr.problems.len()) {
    out = out.append(rr.problems[j]);
    j = j + 1;
  }
  return Verdict { problems: out, modelled: sr.bail.len() == 0 };
}

pub function verify_or_refuse(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): i32 {
  if (!g.verify) {
    return 0;
  }
  let v: Verdict = verdict(fn_name, ops, n_params, n_locals, g);
  if (g.seen != 0 as usize) {
    buf_push_byte(g.seen, 1);
    if (v.modelled) {
      buf_push_byte(g.modelled, 1);
    }
  }
  let ps: irverify.Problem[] = v.problems;
  if (ps.len() == 0) {
    return 0;
  }
  eprint("FERN_IR_VERIFY: " + fn_name + " lowered to malformed IR (#6639):"
    + irverify.format_problems(ps, 20));
  exit(4);
  return 0;
}

pub function certify_or_refuse(fn_name: string, lifted: ssa.SFunc, ops: ir.Op[], g: Gate): i32 {
  let mode: i32 = g.certify;
  if (mode == 0) {
    return 0;
  }
  let f: ssa.SFunc = decided(lifted);
  let k: string = "";
  if (mode == 2 && g.memo.on) {
    k = rcmemo.key(g.memo, fn_name, f, ops, g.abis);
    if (rcmemo.hit(g.memo, k)) {
      return 0;
    }
  }
  let r: rccertify.Report = rccertify.certify(f, ops, g.abis.lookup(fn_name), g.abis, g.rc, g.rcops);
  if (mode == 1) {
    report_one(fn_name, f, r, g);
    return 0;
  }
  if (r.findings.len() == 0) {
    if (k != "") {
      rcmemo.add(g.memo, k);
    }
    return 0;
  }
  dump_if_asked(fn_name, f);
  let out: string = "FERN_RC_CERTIFY: " + fn_name + " emits unbalanced reference counting (#11908):";
  let i: i32 = 0;
  while (i < r.findings.len() && i < 20) {
    out = out + "\n    " + rccertify.render(fn_name, r.findings[i]);
    i = i + 1;
  }
  eprint(out);
  exit(5);
  return 0;
}

function report_one(fn_name: string, f: ssa.SFunc, r: rccertify.Report, g: Gate): void {
  for x in r.findings {
    eprint("FERN_RC_CERTIFY: finding " + rccertify.render(fn_name, x));
  }
  census_line(fn_name, r, g);
  dump_if_asked(fn_name, f);
}

pub function certify_ops_or_refuse(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): i32 {
  if (g.certify == 0) {
    return 0;
  }
  match (ssa_lift.lift_from_ir_prod(g.kinds, fn_name, n_params, n_locals, ops, false)) {
    Ok(lifted) => {
      return certify_or_refuse(fn_name, ssa.register_form(lifted.func).f, ops, g);
    },
    Err(message) => {
      if (g.census != 0 as usize) {
        buf_push(g.census, "FERN_RC_CERTIFY: census " + fn_name + " skipped=lift:" + message + "\n");
      }
      return 0;
    }
  }
}

// The graph with each branch on a comparison of two constants sent to the
// side it takes, so the certifier walks no edge the program cannot take.
function decided(f: ssa.SFunc): ssa.SFunc {
  let defs: ssa.SInst[] = [];
  for v in 0..f.nvals {
    defs = defs.append(ssa.SInst { kind_tag: 0, result: v, args: [], imm: 0, str: "" });
  }
  for b in f.blocks {
    for ins in b.insts {
      if (ins.result >= 0 && ins.result < f.nvals) {
        defs = defs.with(ins.result, ins);
      }
    }
  }
  let blocks: ssa.SBlock[] = [];
  let changed: boolean = false;
  for b in f.blocks {
    let taken: i32 = branch_taken(defs, b.term);
    if (taken >= 0) {
      blocks = blocks.append(ssa.SBlock { ...b, term: ssa.STerm { kind_tag: 2, cond: 0, target: taken, t: 0, f: 0, value: 0 } });
      changed = true;
    } else {
      blocks = blocks.append(b);
    }
  }
  if (!changed) {
    return f;
  }
  let out: ssa.SFunc = ssa.SFunc { ...f, blocks: blocks };
  return ssa.SFunc { ...out, blocks: ssa.refreshed_preds(out) };
}

// The block a branch takes when its condition compares two constants, or -1.
function branch_taken(defs: ssa.SInst[], t: ssa.STerm): i32 {
  if (t.kind_tag != 3 || t.cond < 0 || t.cond >= defs.len()) {
    return 0 - 1;
  }
  let c: ssa.SInst = defs[t.cond];
  if (c.kind_tag != 9 || c.args.len() != 2 || c.str != "eq" && c.str != "ne") {
    return 0 - 1;
  }
  let a: ssa.SInst = defs[c.args[0]];
  let b: ssa.SInst = defs[c.args[1]];
  if (a.kind_tag != 1 || b.kind_tag != 1 || a.str != "" || b.str != "") {
    return 0 - 1;
  }
  let same: boolean = a.imm == b.imm;
  if (same == (c.str == "eq")) {
    return t.t;
  }
  return t.f;
}

function census_line(fn_name: string, r: rccertify.Report, g: Gate): void {
  if (g.census == 0 as usize) {
    return;
  }
  let line: string = "FERN_RC_CERTIFY: census " + fn_name + " tracked=" + util.i32_to_string(r.tracked)
    + " unproved=" + util.i32_to_string(r.unproved) + " findings=" + util.i32_to_string(r.findings.len());
  if (r.skipped != "") {
    line = line + " skipped=" + r.skipped;
  }
  let own: rccertify.Abi = g.abis.lookup(fn_name);
  if (!own.known) {
    line = line + " abi=unknown";
  } else {
    line = line + " abi=";
    for m in own.modes {
      line = line + util.i32_to_string(m);
    }
    if (own.result_unit) {
      line = line + ">unit";
    }
  }
  for name in r.opaque {
    line = line + " opaque=" + name;
  }
  buf_push(g.census, line + "\n");
}

function dump_if_asked(fn_name: string, f: ssa.SFunc): void {
  match (env("FERN_RC_CERTIFY_DUMP")) {
    Some(want) => {
      if (want == fn_name || util.str_has_suffix(want, "*") && util.str_has_prefix(fn_name, slice_unchecked(want, 0, want.len() - 1))) {
        eprint("FERN_RC_CERTIFY: lifted " + fn_name + "\n" + ssa.print_func(f));
      }
    },
    None => {}
  }
}
