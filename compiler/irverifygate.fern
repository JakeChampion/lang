import "./ir";
import "./irtables";
import "./util";
import "./irverify";
import "./irverifyrc";
import "./irverifystack";
import "./ssa";
import "./ssadeps";
import "./ssa_lift";
import "./rcsigs";
import "./rccertify";
import "./rcmemo";
import "std/envflag";
import "std/string";

pub struct Gate { sigs: irverify.NameIndex, seen: usize, modelled: usize, abis: rccertify.Abis, rc: rcsigs.Table, rcops: rcsigs.OpTable, kinds: ssa_lift.KindTable, census: usize, memo: rcmemo.Memo, verify: boolean, certify: i32 }

pub function gate(sigs: irverify.NameIndex, kinds: ssa_lift.KindTable, abis: rccertify.Abis): Gate {
  let g = gate_unreported(sigs, kinds, abis);
  if (!report_on()) {
    return g;
  }
  return Gate { ...g, seen: buf_new(64), modelled: buf_new(64) };
}

pub function gate_unreported(sigs: irverify.NameIndex, kinds: ssa_lift.KindTable, abis: rccertify.Abis): Gate {
  let certify = util.certify_mode();
  let census = 0 as usize;
  if (certify == 1 || certify == 3) {
    census = buf_new(256);
  }
  return Gate { sigs: physical_signatures(sigs, abis), seen: 0 as usize, modelled: 0 as usize, abis: abis, rc: rcsigs.table(), rcops: rcsigs.op_table(), kinds: kinds, census: census, memo: rcmemo.off(), verify: util.verify_on(), certify: certify };
}

// External declarations keep their source arity when a unit has no lowered body.
function physical_signatures(sigs: irverify.NameIndex, abis: rccertify.Abis): irverify.NameIndex {
  let params = sigs.params;
  for i in 0..sigs.names.len() {
    let at = abis.names.find(sigs.names[i]);
    if (at >= 0 && params[i] != abis.modes[at].len()) {
      params = params.with(i, abis.modes[at].len());
    }
  }
  return irverify.NameIndex { ...sigs, params: params };
}

pub function with_memo(g: Gate, m: rcmemo.Memo): Gate {
  if (g.certify != 2) {
    return g;
  }
  return Gate { ...g, memo: m };
}

pub function open_memo(target: string): rcmemo.Memo {
  if (util.certify_mode() != 2) {
    return rcmemo.off();
  }
  return rcmemo.open(target);
}

pub function close_memo(m: rcmemo.Memo): void {
  let line = rcmemo.close(m);
  if (line != "" && report_on()) {
    eprint("FERN_RC_CERTIFY: memo " + line);
  }
}

// The census lines of a gate. A unit's gate prints these and no summary.
pub function report_census(g: Gate): void {
  if (g.census != 0 as usize) {
    let lines = buf_take(g.census);
    buf_free(g.census);
    if (lines.len() > 0) {
      eprint(lines);
    }
  }
}

pub function report_on(): boolean {
  match (util.debug_env("FERN_DEBUG_IR_VERIFY", "FERN_IR_VERIFY")) {
    Some(v) => {
      return envflag.value_on(v) && v != "quiet";
    },
    None => {
      return false;
    }
  }
}

pub function report(g: Gate): void {
  report_census(g);
  if (!report_on()) {
    return;
  }
  let seen = buf_len(g.seen);
  let modelled = buf_len(g.modelled);
  eprint("FERN_IR_VERIFY: " + util.i32_to_string(seen) + " functions verified, " + util.i32_to_string(modelled)
    + " modelled by the stack verifier, " + util.i32_to_string(seen - modelled) + " skipped");
  buf_free(g.seen);
  buf_free(g.modelled);
}

pub struct Verdict { problems: irverify.Problem[], modelled: boolean }

pub function verify_problems(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): irverify.Problem[] {
  return verdict(fn_name, ops, n_params, n_locals, g).problems;
}

pub function verdict(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): Verdict {
  let out = irverify.verify_fn(fn_name, ops, n_params, n_locals, g.sigs);
  let sr = irverifystack.verify_stack_fn(fn_name, ops, g.kinds.pops);
  for i in 0..sr.problems.len() {
    out = out.append(sr.problems[i]);
  }
  let rr = irverifyrc.verify_rc_fn(fn_name, ops);
  for j in 0..rr.problems.len() {
    out = out.append(rr.problems[j]);
  }
  return Verdict { problems: out, modelled: sr.bail.len() == 0 };
}

pub function verify_or_refuse(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): i32 {
  if (!g.verify) {
    return 0;
  }
  let v = verdict(fn_name, ops, n_params, n_locals, g);
  if (g.seen != 0 as usize) {
    buf_push_byte(g.seen, 1);
    if (v.modelled) {
      buf_push_byte(g.modelled, 1);
    }
  }
  let ps = v.problems;
  if (ps.len() == 0) {
    return 0;
  }
  eprint("FERN_IR_VERIFY: " + fn_name + " lowered to malformed IR (#6639):"
    + irverify.format_problems(ps, 20));
  exit(4);
  return 0;
}

pub function certify_or_refuse(fn_name: string, lifted: ssa.SFunc, ops: ir.Op[], g: Gate): i32 {
  let mode = g.certify;
  if (mode == 0) {
    return 0;
  }
  let f = decided(lifted);
  let k = "";
  if (mode == 2 && g.memo.on) {
    k = rcmemo.key(g.memo, fn_name, f, ops, g.abis);
    if (rcmemo.hit(g.memo, k)) {
      return 0;
    }
  }
  let r = rccertify.certify(f, ops, g.abis.lookup(fn_name), g.abis, g.rc, g.rcops);
  if (mode == 1 || mode == 3) {
    report_one(fn_name, f, r, g);
    if (mode == 3 && r.findings.len() == 0 && r.failed == "") {
      mutants(fn_name, f, ops, g, r);
    }
    return 0;
  }
  if (r.failed != "") {
    dump_if_asked(fn_name, f);
    refuse_uncertified(fn_name, r.failed);
  }
  if (r.findings.len() == 0) {
    if (k != "") {
      rcmemo.add(g.memo, k);
    }
    return 0;
  }
  dump_if_asked(fn_name, f);
  let out = "FERN_RC_CERTIFY: " + fn_name + " emits unbalanced reference counting (#11908):";
  let i = 0;
  while (i < r.findings.len() && i < 20) {
    out = out + "\n    " + rccertify.render(fn_name, r.findings[i]);
    i += 1;
  }
  eprint(out);
  exit(5);
  return 0;
}

function refuse_uncertified(fn_name: string, why: string): void {
  eprint("FERN_RC_CERTIFY: " + fn_name + " cannot be certified (#14570): " + why);
  exit(5);
}

function report_one(fn_name: string, f: ssa.SFunc, r: rccertify.Report, g: Gate): void {
  for x in r.findings {
    eprint("FERN_RC_CERTIFY: finding " + rccertify.render(fn_name, x));
  }
  census_line(fn_name, r, g);
  dump_if_asked(fn_name, f);
}

// A function with a task frame is certified as it was before the frame was
// added: the path that resumes restores words that the certifier does not
// model, and the counting of the body is the same.
pub function certify_body_or_refuse(fn_name: string, formed: ssa.SFunc, r: irtables.Lowered, g: Gate): i32 {
  if (r.unsuspended.ops.len() > 0) {
    return certify_ops_or_refuse(fn_name, r.unsuspended.ops, r.n_params, r.unsuspended.n_locals, g);
  }
  return certify_or_refuse(fn_name, formed, r.ops, g);
}

pub function certify_lowered_or_refuse(fn_name: string, r: irtables.Lowered, g: Gate): i32 {
  if (r.unsuspended.ops.len() > 0) {
    return certify_ops_or_refuse(fn_name, r.unsuspended.ops, r.n_params, r.unsuspended.n_locals, g);
  }
  return certify_ops_or_refuse(fn_name, r.ops, r.n_params, r.n_locals, g);
}

pub function certify_ops_or_refuse(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): i32 {
  if (g.certify == 0) {
    return 0;
  }
  match (ssa_lift.lift_from_ir_prod(g.kinds, fn_name, n_params, n_locals, ops, false)) {
    Ok(lifted) => {
      return certify_or_refuse(fn_name, ssa.form(lifted.func).f, ops, g);
    },
    Err(message) => {
      if (g.census != 0 as usize) {
        buf_push(g.census, "FERN_RC_CERTIFY: census " + fn_name + " failed=lift:" + message + "\n");
        return 0;
      }
      refuse_uncertified(fn_name, "lift: " + message);
      return 0;
    }
  }
}

// The graph with each branch on a comparison of two constants, or of a value
// with itself, sent to the side it takes, so the certifier walks no edge the
// program cannot take. A phi that a decided branch leaves with one input can
// make the two operands of a later comparison one value.
pub function decided(f: ssa.SFunc): ssa.SFunc {
  let next = decided_once(f);
  for _ in 0..f.blocks.len() {
    if (!next.changed) {
      break;
    }
    next = decided_once(next.f);
  }
  return next.f;
}

struct Decided { f: ssa.SFunc, changed: boolean }

function decided_once(f: ssa.SFunc): Decided {
  let defs = ssa.inst_defs(f);
  let blocks: ssa.SBlock[] = [];
  let changed = false;
  for b in f.blocks {
    let taken = branch_taken(defs, b.term);
    if (taken >= 0) {
      blocks = blocks.append(ssa.SBlock { ...b, term: ssa.STerm { kind_tag: ssa.TERM_BR, cond: 0, target: taken, t: 0, f: 0, value: 0 } });
      changed = true;
    } else {
      blocks = blocks.append(b);
    }
  }
  if (!changed) {
    return Decided { f: f, changed: false };
  }
  let folded = ssa.SFunc { ...f, blocks: blocks };
  // A block no branch reaches now drops out, with its inputs to the phis it fed.
  let live = ssadeps.reachable_blocks(folded);
  let kept: ssa.SBlock[] = [];
  for i in 0..folded.blocks.len() {
    if (live[i]) {
      kept = kept.append(folded.blocks[i]);
    }
  }
  let out = ssa.SFunc { ...folded, blocks: kept };
  return Decided { f: ssa.prune_trivial_phis(ssa.SFunc { ...out, blocks: ssa.refreshed_preds(out) }).f, changed: true };
}

// The block a branch takes when its condition compares two constants or one
// value with itself, or -1.
function branch_taken(defs: ssa.SInst[], t: ssa.STerm): i32 {
  if (t.kind_tag != ssa.TERM_BRIF || t.cond < 0 || t.cond >= defs.len()) {
    return -1;
  }
  let c = defs[t.cond];
  if (c.kind_tag != ssa.BINARY || c.args.len() != 2) {
    return -1;
  }
  let holds = -1;
  if (c.args[0] == c.args[1]) {
    holds = compared_with_itself(c.str);
  } else {
    let a = defs[c.args[0]];
    let b = defs[c.args[1]];
    if (a.kind_tag != ssa.CONST_INT || b.kind_tag != ssa.CONST_INT || a.str != "" || b.str != "") {
      return -1;
    }
    holds = compared(c.str, c.imm, a.imm, b.imm);
  }
  if (holds < 0) {
    return -1;
  }
  if (holds == 1) {
    return t.t;
  }
  return t.f;
}

// 1 when the comparison `op` holds of a value and itself, 0 when it fails,
// -1 when `op` is not a comparison.
function compared_with_itself(op: string): i32 {
  if (op == "eq" || op == "le_s" || op == "le_u" || op == "ge_s" || op == "ge_u") {
    return 1;
  }
  if (op == "ne" || op == "lt_s" || op == "lt_u" || op == "gt_s" || op == "gt_u") {
    return 0;
  }
  return -1;
}

// 1 when the comparison `op` of `width` bits holds of the constants `a` and
// `b`, 0 when it fails, -1 when it is not a comparison of 32 or 64 bits.
function compared(op: string, width: i32, a: i32, b: i32): i32 {
  if (op == "eq") {
    return if (a == b) { 1 } else { 0 };
  }
  if (op == "ne") {
    return if (a != b) { 1 } else { 0 };
  }
  if (width != 32 && width != 64) {
    return -1;
  }
  let x = a as i64;
  let y = b as i64;
  if (op.ends_with("_u")) {
    if (width == 32) {
      x = x & 4294967295i64;
      y = y & 4294967295i64;
    } else {
      // The sign bit flipped orders the words as unsigned under a signed compare.
      let sign = 0 - 9223372036854775807i64 - 1i64;
      x = x ^ sign;
      y = y ^ sign;
    }
  } else if (!op.ends_with("_s")) {
    return -1;
  }
  let base = slice_unchecked(op, 0, op.len() - 2);
  let holds = false;
  if (base == "lt") {
    holds = x < y;
  } else if (base == "le") {
    holds = x <= y;
  } else if (base == "gt") {
    holds = x > y;
  } else if (base == "ge") {
    holds = x >= y;
  } else {
    return -1;
  }
  return if (holds) { 1 } else { 0 };
}

// FERN_RC_CERTIFY=mutate: three mutants of a function the certifier passes.
// The first loses its middle release, the second its middle retain, and the
// third does its middle release twice. A mutant is refuted when the certifier
// has a finding on it, weakened when it leaves more values unproved or cannot
// decide it, and missed when it passes as the function did.
function mutants(fn_name: string, f: ssa.SFunc, ops: ir.Op[], g: Gate, r: rccertify.Report): void {
  let outcomes: string[] = [];
  for kind in 0..3 {
    let m = mutant(f, g, kind);
    if (m.blocks.len() > 0) {
      let mr = rccertify.certify(m, ops, g.abis.lookup(fn_name), g.abis, g.rc, g.rcops);
      if (mr.findings.len() > 0) {
        outcomes = outcomes.append("refuted");
      } else if (mr.failed != "" || mr.unproved > r.unproved) {
        outcomes = outcomes.append("weakened");
      } else {
        outcomes = outcomes.append("missed");
      }
    }
  }
  if (outcomes.len() > 0) {
    buf_push(g.census, "FERN_RC_CERTIFY: mutants " + fn_name + " refuted=" + util.i32_to_string(util.count_str(outcomes, "refuted"))
      + " weakened=" + util.i32_to_string(util.count_str(outcomes, "weakened")) + " missed=" + util.i32_to_string(util.count_str(outcomes, "missed")) + "\n");
  }
}

// Kind 0 deletes the middle release, 1 the middle retain, and 2 doubles the
// middle release. A function with no such call gives no blocks.
function mutant(f: ssa.SFunc, g: Gate, kind: i32): ssa.SFunc {
  let want = rcsigs.effect_release();
  if (kind == 1) {
    want = rcsigs.effect_retain();
  }
  let at_block: i32[] = [];
  let at_inst: i32[] = [];
  for bi in 0..f.blocks.len() {
    let insts = f.blocks[bi].insts;
    for ii in 0..insts.len() {
      if (counting(insts[ii], g, want)) {
        at_block = at_block.append(bi);
        at_inst = at_inst.append(ii);
      }
    }
  }
  if (at_block.len() == 0) {
    return ssa.SFunc { ...f, blocks: [] };
  }
  let bi = at_block[at_block.len() / 2];
  let ii = at_inst[at_block.len() / 2];
  let b = f.blocks[bi];
  let ins = b.insts[ii];
  let insts: ssa.SInst[] = [];
  for j in 0..b.insts.len() {
    if (j != ii) {
      insts = insts.append(b.insts[j]);
    } else if (kind == 1 && ins.result >= 0) {
      // A retain's result names its operand, so the copy keeps each later read.
      insts = insts.append(ssa.SInst { kind_tag: ssa.COPY, result: ins.result, args: [ins.args[0]], imm: 0, str: "" });
    } else if (kind == 2) {
      insts = insts.append(ins);
      insts = insts.append(ssa.SInst { ...ins, result: -1 });
    }
  }
  return ssa.SFunc { ...f, blocks: f.blocks.with(bi, ssa.SBlock { ...b, insts: insts }) };
}

function counting(ins: ssa.SInst, g: Gate, effect: i32): boolean {
  if (ins.kind_tag != ssa.CALL || ins.args.len() == 0) {
    return false;
  }
  let s = g.rc.lookup(ins.str);
  return s.known && s.arg == 0 && s.effect == effect;
}

function census_line(fn_name: string, r: rccertify.Report, g: Gate): void {
  if (g.census == 0 as usize) {
    return;
  }
  let line: string = "FERN_RC_CERTIFY: census " + fn_name + " tracked=" + util.i32_to_string(r.tracked)
    + " unproved=" + util.i32_to_string(r.unproved) + " findings=" + util.i32_to_string(r.findings.len())
    + " rounds=" + util.i32_to_string(r.rounds);
  if (r.failed != "") {
    line = line + " failed=" + r.failed;
  }
  for v in r.unproved_at {
    line = line + " at=v" + util.i32_to_string(v);
  }
  for name in r.opaque {
    line = line + " opaque=" + name;
  }
  let own = g.abis.lookup(fn_name);
  if (!own.known) {
    line += " abi=unknown";
  } else {
    line += " abi=";
    for m in own.modes {
      line += util.i32_to_string(m);
    }
    if (own.result_unit) {
      line += ">unit";
    }
  }
  buf_push(g.census, line + "\n");
}

function dump_if_asked(fn_name: string, f: ssa.SFunc): void {
  match (util.debug_env("FERN_DEBUG_RC_CERTIFY_DUMP", "FERN_RC_CERTIFY_DUMP")) {
    Some(want) => {
      if (want == fn_name || want.ends_with("*") && fn_name.starts_with(slice_unchecked(want, 0, want.len() - 1))) {
        eprint("FERN_RC_CERTIFY: lifted " + fn_name + "\n" + ssa.print_func(f));
      }
    },
    None => {}
  }
}
