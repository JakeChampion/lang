// compiler/irverifygate.fern — the compile-path gate for the IR
// verifiers (#6639).
//
// irverify.fern and irverifystack.fern were written and then only ever run
// from test drivers, neither of them the compiler. So the module with the most
// lowering in it — the self-host compiler's own sources, ~1000 functions of
// the hardest code the lowerer sees — went through every build unchecked, and
// a malformed op stream still reached the backend the way it always did: as a
// SIGSEGV on the register backends, or a module wasmtime refuses to validate.
//
// This file closes that. Every backend calls verify_or_refuse once per
// function it is about to emit, so ANY compile — a fixture, a driver, the
// bootstrap self-compile — can be run under FERN_IR_VERIFY=1 and get the
// malformed op named at the point it was produced.
//
// It is deliberately small and depends only on the verifiers and the op type.
// Taking the scalars rather than an irtables.LowerResult is what keeps it that
// way: it does not pull the lowering in, so the driver that tests it does not
// either. The callee index is built by irtables.fn_sig_index on the backend
// side for the same reason — it is an AST question, and answering it here
// would drag the parser into the gate's closure.
//
// # On by default
//
// The plan was a flag first and on-by-default once the self-compile is clean
// under it, and it now is on all four corpora: the whole compiler verifies
// clean on all three backends, all 475 conformance fixtures compile clean
// through the real CLI on x86-64 and wasm, and the WASM-HOSTED compiler emits
// clean WAT with the gate running inside it.
//
// That fourth one is what held this back. Running the gate inside the
// wasm-hosted compiler corrupted the WAT it emitted — one 4-byte word of an
// emitted string literal came out incremented by one, which wasm-tools then
// refused to parse. It was never the gate's fault: the gate was allocating
// enough inside a wasm-hosted compile to reach a latent premature free, and
// #6994 fixed that by rc-heading the strings the wasm WASI helpers hand back.
//
// FERN_IR_VERIFY=0 opts out, which is what a bisect wants when the gate itself
// is the suspect.
//
// # What it does NOT check, and why
//
// A function the stack pass cannot model is skipped rather than reported: that
// pass is fail-soft by design (its header says why), and turning an unmodelled
// op into a hard error here would make a widened op vocabulary look like a
// lowering bug. The ownership half (irverifyrc.fern) skips per SITE for the
// same reason, and checks only that a reuse site names ONE donor — not that
// the counts around it balance, which needs callee ownership signatures. Callee RESOLUTION — a name nothing declares and no backend
// provides — is irverifyprovided.fern, which needs the whole import closure and
// so runs from the modload driver rather than from a per-module emit.

import "./ir";
import "./util";
import "./irverify";
import "./irverifyrc";
import "./irverifystack";
import "./ssa";
import "./ssa_lift";
import "./rcsigs";
import "./rccertify";
import "./rcmemo";
import "std/cli";

// Gate is what the verifiers read beside the function: `sigs`, the
// callee-arity index for the whole program being emitted, built once per emit
// loop by irtables.fn_sig_index, and `pops`, ir.pops_by_kind. A callee `sigs`
// does not carry is left alone — a runtime helper, a lifted lambda, another
// unit's function — so the check reports a genuine arity mismatch and never a
// missing entry.
//
// `seen` and `modelled` count the functions the gate looked at and the ones
// the stack pass modelled, one byte each in a buffer, so one gate shared by
// an emit loop's calls can say at the end how much was verified (report).
// Both are 0 unless FERN_IR_VERIFY=1 asks for the line.
//
// The emitted-RC certifier (rccertify.fern, #11908) reads the Gate too:
// `abis` is the module's contracts, `rc` and `rcops` the runtime signature
// tables, `kinds` the lift's kind table for a backend that does not lift on
// its own. `census` counts what it certified, one line per function with
// something to say, under FERN_RC_CERTIFY=report; 0 otherwise.
// `memo` is the certifier's memo (rcmemo): off until a backend opens it with
// `with_memo`, the drivers' gates never do.
pub struct Gate { sigs: irverify.NameIndex, pops: i32[], seen: usize, modelled: usize, abis: rccertify.Abis, rc: rcsigs.Table, rcops: rcsigs.OpTable, kinds: ssa_lift.KindTable, census: usize, memo: rcmemo.Memo }

// gate builds the Gate a program's emit loop hands to every
// verify_or_refuse and reports at its end.
pub function gate(sigs: irverify.NameIndex, pops: i32[], abis: rccertify.Abis): Gate {
  let g: Gate = gate_unreported(sigs, pops, abis);
  if (!report_on()) {
    return g;
  }
  return Gate { ...g, seen: buf_new(64), modelled: buf_new(64) };
}

// gate_unreported is the Gate for the runtime helpers' bodies, which the
// line does not count: native's counts the program's functions.
pub function gate_unreported(sigs: irverify.NameIndex, pops: i32[], abis: rccertify.Abis): Gate {
  let census: usize = 0 as usize;
  if (util.certify_mode() == 1) {
    census = buf_new(256);
  }
  return Gate { sigs: sigs, pops: pops, seen: 0 as usize, modelled: 0 as usize, abis: abis, rc: rcsigs.table(), rcops: rcsigs.op_table(), kinds: ssa_lift.kind_table(), census: census, memo: rcmemo.off() };
}

// with_memo hands a gate the compile's memo (rcmemo): a function the memo
// knows is not certified again. Only a gate that refuses reads it; a report
// compile reads no memo, so every function's census is in the report.
pub function with_memo(g: Gate, m: rcmemo.Memo): Gate {
  if (util.certify_mode() != 2) {
    return g;
  }
  return Gate { ...g, memo: m };
}

// open_memo opens the memo of `target` for one compile; close_memo writes
// it back when the compile's last gate is done and, under FERN_IR_VERIFY=1,
// says how many functions it answered for.
pub function open_memo(target: string): rcmemo.Memo {
  if (util.certify_mode() != 2) {
    return rcmemo.off();
  }
  return rcmemo.open(target);
}

pub function close_memo(m: rcmemo.Memo): void {
  let line: string = rcmemo.close(m);
  if (line != "" && report_on()) {
    eprint("FERN_RC_CERTIFY: memo " + line);
  }
}

// report_on reports whether the coverage line is wanted: FERN_IR_VERIFY on,
// as native prints it; FERN_IR_VERIFY=quiet runs the gate without it.
pub function report_on(): boolean {
  match (env("FERN_IR_VERIFY")) {
    Some(v) => {
      return cli.flag_on(v) && v != "quiet";
    },
    None => {
      return false;
    }
  }
}

// report prints the coverage line native prints (#8798, #11412) — a verifier
// that reports nothing for a function it could not model is silent, not
// clean, so the line is what says how much was looked at — and releases the
// counters. Silent unless report_on.
pub function report(g: Gate): void {
  if (g.census != 0 as usize) {
    let lines: string = buf_take(g.census);
    buf_free(g.census);
    if (lines.len() > 0) {
      eprint(lines);
    }
  }
  if (!report_on()) {
    return;
  }
  let seen: i32 = buf_len(g.seen);
  let modelled: i32 = buf_len(g.modelled);
  eprint("FERN_IR_VERIFY: " + util.i32_to_string(seen) + " functions verified, " + util.i32_to_string(modelled)
    + " modelled by the stack verifier, " + util.i32_to_string(seen - modelled) + " skipped");
  buf_free(g.seen);
  buf_free(g.modelled);
}

// Verdict is one function's result: what the verifiers found, and whether
// the stack pass modelled it rather than bailing.
pub struct Verdict { problems: irverify.Problem[], modelled: boolean }

// verify_problems runs both verifiers over one lowered function and returns
// everything they found, structure problems first.
//
// Pure, and separate from the refusal below so the gate's verdict can be
// asserted without the exit that acting on it entails.
pub function verify_problems(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): irverify.Problem[] {
  return verdict(fn_name, ops, n_params, n_locals, g).problems;
}

// verdict is verify_problems with the stack pass's coverage beside the
// problems.
pub function verdict(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): Verdict {
  let out: irverify.Problem[] = irverify.verify_fn(fn_name, ops, n_params, n_locals, g.sigs);
  let sr: irverifystack.StackResult = irverifystack.verify_stack_fn(fn_name, ops, g.pops);
  let i: i32 = 0;
  while (i < sr.problems.len()) {
    out = out.append(sr.problems[i]);
    i = i + 1;
  }
  // The ownership half models one reuse site at a time, so it runs even for
  // a function the stack pass had to abandon.
  let rr: irverifyrc.RcResult = irverifyrc.verify_rc_fn(fn_name, ops);
  let j: i32 = 0;
  while (j < rr.problems.len()) {
    out = out.append(rr.problems[j]);
    j = j + 1;
  }
  return Verdict { problems: out, modelled: sr.bail.len() == 0 };
}

// verify_or_refuse is what the backends call: a hard exit naming what the
// verifiers found, and a no-op under FERN_IR_VERIFY=0.
//
// Exiting rather than returning a diagnostic is the point. The alternative is
// emitting the malformed stream anyway, which is exactly the behaviour the
// flag exists to replace.
pub function verify_or_refuse(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): i32 {
  if (!util.verify_on()) {
    return 0;
  }
  let v: Verdict = verdict(fn_name, ops, n_params, n_locals, g);
  if (g.seen != 0 as usize) {
    buf_push_byte(g.seen, 1);
    if (v.modelled) {
      buf_push_byte(g.modelled, 1);
    }
  }
  let ps: irverify.Problem[] = v.problems;
  if (ps.len() == 0) {
    return 0;
  }
  eprint("FERN_IR_VERIFY: " + fn_name + " lowered to malformed IR (#6639):"
    + irverify.format_problems(ps, 20));
  exit(4);
  return 0;
}

// ---- the emitted-RC certifier ----------------------------------------------

// certify_or_refuse runs rccertify over one lifted function, under
// FERN_RC_CERTIFY: a finding is a lowering refusal, naming the function and
// the value, under `1`; under `report` every finding is printed and the
// function's census appended to the gate's, and the compile continues.
// Refusal is on findings alone: a value the paths disagree on and a body
// the certifier does not read (an async frame) are counted in the report
// census, never refused, since neither is a shown imbalance.
pub function certify_or_refuse(fn_name: string, f: ssa.SFunc, ops: ir.Op[], g: Gate): i32 {
  let mode: i32 = util.certify_mode();
  if (mode == 0) {
    return 0;
  }
  let k: string = "";
  if (mode == 2 && g.memo.on) {
    k = rcmemo.key(g.memo, fn_name, f, ops, g.abis);
    if (rcmemo.hit(g.memo, k)) {
      return 0;
    }
  }
  let r: rccertify.Report = rccertify.certify(f, ops, g.abis.lookup(fn_name), g.abis, g.rc, g.rcops);
  if (mode == 1) {
    report_one(fn_name, f, r, g);
    return 0;
  }
  if (r.findings.len() == 0) {
    if (k != "") {
      rcmemo.add(g.memo, k);
    }
    return 0;
  }
  dump_if_asked(fn_name, f);
  let out: string = "FERN_RC_CERTIFY: " + fn_name + " emits unbalanced reference counting (#11908):";
  let i: i32 = 0;
  while (i < r.findings.len() && i < 20) {
    out = out + "\n    " + rccertify.render(fn_name, r.findings[i]);
    i = i + 1;
  }
  eprint(out);
  exit(5);
  return 0;
}

// report_one is the report mode's answer for one function. A finding goes
// out at once: the census rides a buffer not every gate flushes, and a
// finding is what the mode exists to show.
function report_one(fn_name: string, f: ssa.SFunc, r: rccertify.Report, g: Gate): void {
  for x in r.findings {
    eprint("FERN_RC_CERTIFY: finding " + rccertify.render(fn_name, x));
  }
  census_line(fn_name, r, g);
  dump_if_asked(fn_name, f);
}

// certify_ops_or_refuse is certify_or_refuse for a backend that does not
// lift: the stack machine's. A stream the lift cannot take is not certified
// and says so in the census; the backend's own refusal names the op.
pub function certify_ops_or_refuse(fn_name: string, ops: ir.Op[], n_params: i32, n_locals: i32, g: Gate): i32 {
  if (util.certify_mode() == 0) {
    return 0;
  }
  let lifted: ssa_lift.LResult = ssa_lift.lift_from_ir_prod(g.kinds, fn_name, n_params, n_locals, ops, false);
  if (!lifted.ok) {
    if (g.census != 0 as usize) {
      buf_push(g.census, "FERN_RC_CERTIFY: census " + fn_name + " skipped=lift:" + lifted.bail + "\n");
    }
    return 0;
  }
  return certify_or_refuse(fn_name, ssa.register_form(lifted.func).f, ops, g);
}

// census_line records one function's report: every finding on its own
// line, and a census line when the function was skipped, left something
// unproved, or met a callee or op the tables do not know.
function census_line(fn_name: string, r: rccertify.Report, g: Gate): void {
  if (g.census == 0 as usize) {
    return;
  }
  let line: string = "FERN_RC_CERTIFY: census " + fn_name + " tracked=" + util.i32_to_string(r.tracked)
    + " unproved=" + util.i32_to_string(r.unproved) + " findings=" + util.i32_to_string(r.findings.len());
  if (r.skipped != "") {
    line = line + " skipped=" + r.skipped;
  }
  let own: rccertify.Abi = g.abis.lookup(fn_name);
  if (!own.known) {
    line = line + " abi=unknown";
  } else {
    line = line + " abi=";
    for m in own.modes {
      line = line + util.i32_to_string(m);
    }
    if (own.result_unit) {
      line = line + ">unit";
    }
  }
  for name in r.opaque {
    line = line + " opaque=" + name;
  }
  buf_push(g.census, line + "\n");
}

// dump_if_asked prints the lifted SSA of the function FERN_RC_CERTIFY_DUMP
// names, under the report mode and with a refusal: what the certifier read
// when it found what it found.
function dump_if_asked(fn_name: string, f: ssa.SFunc): void {
  match (env("FERN_RC_CERTIFY_DUMP")) {
    Some(want) => {
      if (want == fn_name || util.str_has_suffix(want, "*") && util.str_has_prefix(fn_name, slice_unchecked(want, 0, want.len() - 1))) {
        eprint("FERN_RC_CERTIFY: lifted " + fn_name + "\n" + ssa.print_func(f));
      }
    },
    None => {}
  }
}
