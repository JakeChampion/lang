// Canonical decimal words for a packed constant byte array.
pub function words(bs: u8[]): string {
  let size: i64 = 0;
  for b in bs {
    let n: i32 = b as i32;
    size = size + 1i64;
    if (n >= 10) {
      size = size + 1i64;
    }
    if (n >= 100) {
      size = size + 1i64;
    }
  }
  if (bs.len() > 0) {
    size = size + (bs.len() - 1) as i64;
  }
  if (size > 2147483647i64) {
    return "";
  }
  let out: u8[] = __alloc_u8(size as i32);
  let at: i32 = 0;
  let i: i32 = 0;
  while (i < bs.len()) {
    if (i > 0) {
      out = out.with(at, 44 as u8);
      at = at + 1;
    }
    let n: i32 = bs[i] as i32;
    if (n >= 100) {
      out = out.with(at, (48 + n / 100) as u8);
      at = at + 1;
    }
    if (n >= 10) {
      out = out.with(at, (48 + n / 10 % 10) as u8);
      at = at + 1;
    }
    out = out.with(at, (48 + n % 10) as u8);
    at = at + 1;
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

pub function valid(text: string, count: i32): boolean {
  if (count < 0) {
    return false;
  }
  if (count == 0) {
    return text.len() == 0;
  }
  let words: i32 = 0;
  let digits: i32 = 0;
  let value: i32 = 0;
  for b in text.as_bytes() {
    if (b == 44 as u8) {
      if (digits == 0 || value > 255) {
        return false;
      }
      words = words + 1;
      digits = 0;
      value = 0;
    } else {
      if (b < 48 as u8 || b > 57 as u8 || digits == 3 || digits > 0 && value == 0) {
        return false;
      }
      value = value * 10 + (b as i32 - 48);
      digits = digits + 1;
    }
  }
  return digits > 0 && value <= 255 && words + 1 == count;
}
