// Recover source match branches for ownership control flow.

import "./ast";
import "./astwalk";
import "./parser";

function tuple_pattern(a: ast.TupArm): ast.Pattern {
  if (a.is_wild) {
    return ast.PatWildcard { tag: 0 };
  }
  return ast.PatVariant {
    type_name: "", binding: "", extra_bindings: [], nested: [], at_binding: a.at_binding,
    field_names: [], lit_cond: parser.e_bool(true), has_lit_cond: false,
    tup_kinds: a.elem_kinds, tup_binds: a.binds, tup_lits: a.lits, tup_pats: a.elem_pats,
    bare_name: false, scalar_binding: false, scalar_cells: [], rest_written: false,
  };
}

function match_source(scrut: ast.Expr, arms: ast.MatchArm[], line: i32, col: i32, origin: string): ast.Stmt {
  let normalized: ast.MatchArm[] = [];
  for arm in arms {
    normalized = normalized.append(ast.MatchArm { ...arm, body: source(arm.body), guard: expression(arm.guard) });
  }
  return ast.StmtMatch { scrutinee: expression(scrut), arms: normalized, sugar: [], line: line, col: col, origin: origin, else_chained: false, arms_open: 0 };
}

function expression(value: ast.Expr): ast.Expr {
  let (result, _, _) = astwalk.map_expr_where(value, 0, visit, keep, astwalk.descend_all);
  return result;
}

function visit(st: ast.Stmt, count: i32): (ast.Stmt, i32, boolean) {
  if let ast.StmtMatch(m) = st {
    if (m.sugar.len() > 0) {
      return (match_source(m.scrutinee, m.sugar, m.line, m.col, m.origin), count, true);
    }
  }
  if let ast.StmtIf(f) = st {
    let sg = f.sugar;
    if (sg.arms.len() > 0) {
      return (match_source(sg.scrut, sg.arms, sg.line, sg.col, sg.origin), count, true);
    }
    if (sg.tup.len() > 0) {
      let arms: ast.MatchArm[] = [];
      for a in sg.tup {
        arms = arms.append(ast.MatchArm { pattern: tuple_pattern(a), body: a.body, guard: a.guard, has_guard: a.has_guard, line: a.line, col: a.col, alt_cont: a.alt_cont });
      }
      return (match_source(sg.scrut, arms, sg.line, sg.col, sg.origin), count, true);
    }
  }
  return (st, count, false);
}

// A value match with a nested pattern is a block of three statements: a
// local for the value, the match, and a return of the local. Its lowered
// arms assign to the local. The arms as written end in their value, so the
// block of the source form is the match alone.
function value_block(e: ast.Expr): Option[ast.Expr] {
  let ast.ExprCall(c) = e else {
    return None;
  };
  let ast.ExprLambda(lm) = c.callee else {
    return None;
  };
  if (!parser.is_value_block(c) || lm.body.len() != 3) {
    return None;
  }
  let ast.StmtVar(v) = lm.body[0] else {
    return None;
  };
  let ast.StmtMatch(m) = lm.body[1] else {
    return None;
  };
  let ast.StmtReturn(r) = lm.body[2] else {
    return None;
  };
  let ast.ExprIdent(id) = r.value else {
    return None;
  };
  if (id.name != v.name || !parser.is_value_local_name(v.name) || m.sugar.len() == 0) {
    return None;
  }
  let body: ast.Stmt[] = [match_source(m.scrutinee, m.sugar, m.line, m.col, m.origin)];
  return Some(ast.ExprCall { ...c, callee: ast.ExprLambda { ...lm, body: body } });
}

function keep(e: ast.Expr, count: i32): (ast.Expr, i32, boolean) {
  if let Some(block) = value_block(e) {
    return (block, count, true);
  }
  return (e, count, false);
}

pub function source(body: ast.Stmt[]): ast.Stmt[] {
  if (!sugared(body)) {
    return body;
  }
  let (result, _) = astwalk.map_stmts_where(body, 0, visit, keep, astwalk.descend_all);
  return result;
}

// Some statement in body still holds the match it was written as.
function sugared(body: ast.Stmt[]): boolean {
  for st in body {
    if (astwalk.fold_stmt_nodes(st, false, sugared_stmt, no_sugar, astwalk.descend_all)) {
      return true;
    }
  }
  return false;
}

function sugared_stmt(st: ast.Stmt, own found: boolean): boolean {
  if (found) {
    return true;
  }
  if let ast.StmtMatch(m) = st {
    return m.sugar.len() > 0;
  }
  if let ast.StmtIf(f) = st {
    return f.sugar.arms.len() > 0 || f.sugar.tup.len() > 0;
  }
  return false;
}

function no_sugar(e: ast.Expr, own found: boolean): boolean {
  return found;
}
