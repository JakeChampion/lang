  if (s.has_need("tcp_send_bytes")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_tcp_send_bytes(tgt, false), s);
  }
  if (s.has_need("tcp_send_bytes_u8")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_tcp_send_bytes(tgt, true), s);
  }
  if (s.has_need("udp_sendto_bytes")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_udp_sendto_bytes(tgt, false), s);
  }
  if (s.has_need("udp_sendto_bytes_u8")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_udp_sendto_bytes(tgt, true), s);
  }
  if (s.has_need("proc_exec")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_exec(tgt), s);
  }
  if (s.has_need("proc_exec_as")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_exec_as(tgt), s);
  }
  if (s.has_need("map_hash_seed")) {
    s = s.write(".globl __fern_map_hash_seed\n");
    s = s.write(".type __fern_map_hash_seed, %function\n");
    s = s.write("__fern_map_hash_seed:\n");
    s = s.write("    adrp x1, __fern_map_seed\n");
    s = s.write("    add x1, x1, :lo12:__fern_map_seed\n");
    s = s.write("    ldr w0, [x1]\n");
    s = s.write("    cbnz w0, .Lmapseed_ret\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_random_i32\n");
    s = s.write("    orr w0, w0, #1\n");
    s = s.write("    adrp x1, __fern_map_seed\n");
    s = s.write("    add x1, x1, :lo12:__fern_map_seed\n");
    s = s.write("    str w0, [x1]\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write(".Lmapseed_ret:\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_hash_seed, .-__fern_map_hash_seed\n");
  }
  if (s.has_need("proc_fork")) {
    if (darwin) {
      s = s.write(".globl __fn___fern_proc_fork\n");
      s = s.write(".type __fn___fern_proc_fork, %function\n");
      s = s.write("__fn___fern_proc_fork:\n");
      s = s.write("    stp x29, x30, [sp, #-16]!\n");
      s = s.write("    mov x29, sp\n");
      s = s.write("    mov x16, #2\n");
      s = s.write("    svc #0x80\n");
      s = s.write("    b.cc .Lpf_ok\n");
      s = s.write("    neg x0, x0\n");
      s = s.write("    b .Lpf_done\n");
      s = s.write(".Lpf_ok:\n");
      s = s.write("    cbz x1, .Lpf_done\n");
      s = s.write("    mov x0, #0\n");
      s = s.write(".Lpf_done:\n");
      s = s.write("    ldp x29, x30, [sp], #16\n");
      s = s.write("    ret\n");
      s = s.write(".size __fn___fern_proc_fork, .-__fn___fern_proc_fork\n");
    } else {
      s = emit_ir_runtime_fern_fn(asmcore.rt_src_proc_fork(tgt), s);
    }
  }
  if (darwin && s.has_need("pipe")) {
    s = s.write(".globl __fn___fern_pipe\n");
    s = s.write("__fn___fern_pipe:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    mov x16, #42\n");
    s = s.write("    svc #0x80\n");
    s = s.write("    mov x9, #0\n");
    s = s.write("    mov x10, x0\n");
    s = s.write("    mov x11, x1\n");
    s = s.write("    b.cc .Lpp_call\n");
    s = s.write("    neg x9, x0\n");
    s = s.write(".Lpp_call:\n");
    s = s.write("    sub sp, sp, #48\n");
    s = s.write("    str x9, [sp]\n");
    s = s.write("    str x10, [sp, #16]\n");
    s = s.write("    str x11, [sp, #32]\n");
    s = s.write("    bl __fn___fern_pipe_from\n");
    s = s.write("    add sp, sp, #48\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
  }
  return s;
}

function emit_rt_signal_flags(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  if (!s.any_need(["signal_catch", "signal_taken"])) {
    return s;
  }
  s = s.write("    .section .bss\n    .align 3\n__fern_sig_flags: .skip 65\n    .text\n");
  if (s.has_need("signal_catch")) {
    s = ssa_landing_pad(s.write("    .global __fern_sig_catcher\n    .global __fern_sig_return\n__fern_sig_catcher:\n"));
    s = s.write("    adrp x1, __fern_sig_flags\n    add x1, x1, :lo12:__fern_sig_flags\n    sxtw x0, w0\n    add x1, x1, x0\n    mov w2, #1\n    strb w2, [x1]\n    ret\n");
    s = s.write("__fern_sig_return:\n");
    if (darwin) {
      s = s.write("    mov x19, x1\n    mov x20, x4\n    mov x21, x5\n    mov x16, x0\n    mov x0, x2\n    mov x1, x3\n    mov x2, x4\n    blr x16\n");
      s = s.write("    mov x0, x20\n    mov x1, x19\n    mov x2, x21\n    mov x16, #184\n    svc #0x80\n    brk #1\n");
    } else {
      s = s.write("    mov x8, #139\n    svc #0\n");
    }
  }
  if (s.has_need("signal_taken")) {
    s = s.write("    .arch_extension lse\n    .global __fern_signal_taken\n    .type __fern_signal_taken, %function\n__fern_signal_taken:\n");
    s = s.write("    sub w1, w0, #1\n    cmp w1, #63\n    b.hi .Lsig_taken_none\n    adrp x1, __fern_sig_flags\n    add x1, x1, :lo12:__fern_sig_flags\n    sxtw x0, w0\n    add x1, x1, x0\n");
    s = s.write("    mov w2, #0\n    swpalb w2, w0, [x1]\n    ret\n.Lsig_taken_none:\n    mov w0, #0\n    ret\n");
  }
  return s;
}

function emit_rt_utf8_blocks(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(asmcore.utf8_tables("__fern_utf8_tables"));
  s = s.write("    .text\n    .global __fern_utf8_blocks\n    .type __fern_utf8_blocks, %function\n__fern_utf8_blocks:\n");
  s = s.write("    adrp x9, __fern_utf8_tables\n    add x9, x9, :lo12:__fern_utf8_tables\n");
  s = s.write("    ldp q16, q17, [x9]\n    ldp q18, q19, [x9, #32]\n");
  s = s.write("    movi v20.16b, #224\n    movi v21.16b, #240\n    movi v22.16b, #128\n    movi v23.16b, #0\n");
  s = s.write("    mov x3, x1\n    sub x4, x2, #16\n");
  s = s.write(".Lutf8_loop:\n    cmp x3, x4\n    b.gt .Lutf8_done\n    add x5, x0, x3\n");
  s = s.write("    ldr q0, [x5]\n    ldur q3, [x5, #-3]\n    orr v4.16b, v0.16b, v3.16b\n");
  s = s.write("    umaxv b4, v4.16b\n    umov w6, v4.b[0]\n    cmp w6, #128\n    b.lo .Lutf8_next\n");
  s = s.write("    ldur q1, [x5, #-1]\n    ldur q2, [x5, #-2]\n");
  s = s.write("    ushr v4.16b, v1.16b, #4\n    tbl v4.16b, {v16.16b}, v4.16b\n");
  s = s.write("    and v5.16b, v1.16b, v19.16b\n    tbl v5.16b, {v17.16b}, v5.16b\n    and v4.16b, v4.16b, v5.16b\n");
  s = s.write("    ushr v5.16b, v0.16b, #4\n    tbl v5.16b, {v18.16b}, v5.16b\n    and v4.16b, v4.16b, v5.16b\n");
  s = s.write("    cmhs v5.16b, v2.16b, v20.16b\n    cmhs v6.16b, v3.16b, v21.16b\n    orr v5.16b, v5.16b, v6.16b\n");
  s = s.write("    and v5.16b, v5.16b, v22.16b\n    eor v4.16b, v4.16b, v5.16b\n    orr v23.16b, v23.16b, v4.16b\n");
  s = s.write(".Lutf8_next:\n    add x3, x3, #16\n    b .Lutf8_loop\n");
  s = s.write(".Lutf8_done:\n    umaxv b23, v23.16b\n    umov w6, v23.b[0]\n    cbnz w6, .Lutf8_bad\n");
  s = s.write(".Lutf8_back:\n    cmp x3, x1\n    b.le .Lutf8_ret\n    add x5, x0, x3\n    ldurb w6, [x5, #-1]\n");
  s = s.write("    cmp w6, #128\n    b.lo .Lutf8_ret\n    sub x3, x3, #1\n    cmp w6, #192\n    b.hs .Lutf8_ret\n    b .Lutf8_back\n");
  s = s.write(".Lutf8_bad:\n    mov x3, #-1\n.Lutf8_ret:\n    mov x0, x3\n    ret\n    .size __fern_utf8_blocks, .-__fern_utf8_blocks\n");
  return s;
}

function emit_rt_sum_bytes(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .global __fern_sum_bytes\n");
  s = s.write("    .type __fern_sum_bytes, %function\n");
  s = s.write("__fern_sum_bytes:\n");
  s = s.write("    ldr x6, [x0, #8]\n");
  s = s.write("    ldr x8, [x0]\n");
  s = s.write("__fern_sum_bytes_data:\n");
  s = s.write("    add x9, x8, x6\n");
  s = s.write("    mov w0, #0\n");
  s = s.write("    movi v2.4s, #0\n");
  s = s.write(".Lsum_bytes_vec:\n");
  s = s.write("    sub x10, x9, x8\n");
  s = s.write("    cmp x10, #16\n");
  s = s.write("    b.lt .Lsum_bytes_fold\n");
  s = s.write("    ld1 {v0.16b}, [x8]\n");
  s = s.write("    uaddlp v1.8h, v0.16b\n");
  s = s.write("    uadalp v2.4s, v1.8h\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    b .Lsum_bytes_vec\n");
  s = s.write(".Lsum_bytes_fold:\n");
  s = s.write("    addv s0, v2.4s\n");
  s = s.write("    fmov w0, s0\n");
  s = s.write(".Lsum_bytes_tail:\n");
  s = s.write("    cmp x8, x9\n");
  s = s.write("    b.hs .Lsum_bytes_ret\n");
  s = s.write("    ldrb w10, [x8]\n");
  s = s.write("    add w0, w0, w10\n");
  s = s.write("    add x8, x8, #1\n");
  s = s.write("    b .Lsum_bytes_tail\n");
  s = s.write(".Lsum_bytes_ret:\n");
  s = s.write("    ret\n");
  s = s.write("    .size __fern_sum_bytes, .-__fern_sum_bytes\n");
  return s;
}

function a64_aes_view(arg: string, data: string, len: string, tag: string): string {
  return "    tst " + arg + ", #2\n    b.eq " + tag + "_arr\n    sub " + data + ", " + arg + ", #2\n"
    + "    ldr " + len + ", [" + data + ", #8]\n    ldr " + data + ", [" + data + "]\n    b " + tag + "_ok\n"
    + tag + "_arr:\n    ldr " + len + ", [" + arg + "]\n    add " + data + ", " + arg + ", #8\n" + tag + "_ok:\n";
}

function a64_aes_alloc(slot: string): string {
  return "    str x0, [x29, #" + slot + "]\n    add x0, x0, #7\n    lsr x0, x0, #3\n    bl __fern_arr_box\n"
    + "    ldr x1, [x29, #" + slot + "]\n    str x1, [x0]\n    str x0, [x29, #" + slot + "]\n";
}

function a64_aes_subword(src: string, dst: string): string {
  return "    dup v16.4s, " + src + "\n    aese v16.16b, v17.16b\n    umov " + dst + ", v16.s[0]\n";
}

function a64_aes_fold4(t: string, w: string[], off: i32): string {
  return "    eor " + w[0] + ", " + w[0] + ", " + t + "\n    eor " + w[1] + ", " + w[1] + ", " + w[0] + "\n"
    + "    eor " + w[2] + ", " + w[2] + ", " + w[1] + "\n    eor " + w[3] + ", " + w[3] + ", " + w[2] + "\n"
    + "    stp " + w[0] + ", " + w[1] + ", [x3, #" + util.i32_to_string(off) + "]\n    stp " + w[2] + ", " + w[3] + ", [x3, #" + util.i32_to_string(off + 8) + "]\n";
}

function a64_aes_rot_step(src: string, w: string[], rcon: i32, off: i32): string {
  return a64_aes_subword(src, "w12") + "    ror w12, w12, #8\n    mov w13, #" + util.i32_to_string(rcon) + "\n    eor w12, w12, w13\n" + a64_aes_fold4("w12", w, off);
}

function a64_aes_schedule128(): string {
  let o: string = ".Laesk_128:\n    ldp w4, w5, [x1]\n    ldp w6, w7, [x1, #8]\n    stp w4, w5, [x3]\n    stp w6, w7, [x3, #8]\n";
  let rcon: i32[] = [1, 2, 4, 8, 16, 32, 64, 128, 27, 54];
  let i: i32 = 0;
  while (i < 10) {
    o = o + a64_aes_rot_step("w7", ["w4", "w5", "w6", "w7"], rcon[i], 16 * (i + 1));
    i = i + 1;
  }
  return o + "    b .Laesk_ret\n";
}

function a64_aes_schedule256(): string {
  let o: string = ".Laesk_256:\n    ldp w4, w5, [x1]\n    ldp w6, w7, [x1, #8]\n    ldp w8, w9, [x1, #16]\n    ldp w10, w11, [x1, #24]\n"
    + "    stp w4, w5, [x3]\n    stp w6, w7, [x3, #8]\n    stp w8, w9, [x3, #16]\n    stp w10, w11, [x3, #24]\n";
  let rcon: i32[] = [1, 2, 4, 8, 16, 32, 64];
  let i: i32 = 1;
  while (i <= 7) {
    o = o + a64_aes_rot_step("w11", ["w4", "w5", "w6", "w7"], rcon[i - 1], 32 * i);
    if (i < 7) {
      o = o + a64_aes_subword("w7", "w12") + a64_aes_fold4("w12", ["w8", "w9", "w10", "w11"], 32 * i + 16);
    }
    i = i + 1;
  }
  return o + "    b .Laesk_ret\n";
}

function a64_aes_expand_key(): string {
  return "    .global __fern_aes_expand_key\n    .type __fern_aes_expand_key, %function\n__fern_aes_expand_key:\n"
    + "    stp x29, x30, [sp, #-48]!\n    mov x29, sp\n" + a64_aes_view("x0", "x3", "x4", ".Laesk_key")
    + "    str x3, [x29, #16]\n    mov x0, #0\n    cmp x4, #16\n    b.ne .Laesk_n32\n    mov x0, #176\n.Laesk_n32:\n"
    + "    cmp x4, #32\n    b.ne .Laesk_box\n    mov x0, #240\n.Laesk_box:\n" + a64_aes_alloc("32")
    + "    ldr x5, [x0]\n    ldr x1, [x29, #16]\n    add x3, x0, #8\n    movi v17.2d, #0\n"
    + "    cmp x5, #176\n    b.eq .Laesk_128\n    cmp x5, #240\n    b.eq .Laesk_256\n    b .Laesk_ret\n"
    + a64_aes_schedule128() + a64_aes_schedule256()
    + ".Laesk_ret:\n    ldr x0, [x29, #32]\n    ldp x29, x30, [sp], #48\n    ret\n    .size __fern_aes_expand_key, .-__fern_aes_expand_key\n";
}

function a64_aes_rounds(label: string, n: i32): string {
  let o: string = label + ":\n";
  let r: i32 = 0;
  while (r < 13) {
    if (r == 9) {
      o = o + "    cmp x7, #14\n    b.eq " + label + "_256\n" + a64_aes_last(n, 25) + "    ret\n" + label + "_256:\n";
    }
    let j: i32 = 0;
    while (j < n) {
      let v: string = "v" + util.i32_to_string(j) + ".16b";
      o = o + "    aese " + v + ", v" + util.i32_to_string(16 + r) + ".16b\n    aesmc " + v + ", " + v + "\n";
      j = j + 1;
    }
    r = r + 1;
  }
  return o + a64_aes_last(n, 29) + "    ret\n";
}

function a64_aes_last(n: i32, k: i32): string {
  let o: string = "";
  let j: i32 = 0;
  while (j < n) {
    let v: string = "v" + util.i32_to_string(j) + ".16b";
    o = o + "    aese " + v + ", v" + util.i32_to_string(k) + ".16b\n    eor " + v + ", " + v + ", v" + util.i32_to_string(k + 1) + ".16b\n";
    j = j + 1;
  }
  return o;
}

function a64_aes_counter(j: i32): string {
  return "    rev32 v" + util.i32_to_string(j) + ".16b, v6.16b\n    add v6.4s, v6.4s, v7.4s\n";
}

function a64_aes_xor_out(j: i32): string {
  let v: string = "v" + util.i32_to_string(j) + ".16b";
  return "    ld1 {v4.16b}, [x1]\n    eor " + v + ", " + v + ", v4.16b\n    st1 {" + v + "}, [x2]\n    add x1, x1, #16\n    add x2, x2, #16\n";
}

function a64_aes_ctr_blocks(): string {
  return a64_aes_ctr_blocks_at(".Lctr", ".Lctr_ret", 80);
}

function a64_aes_ctr_blocks_at(p: string, done: string, tail: i32): string {
  let o: string = p + "_loop4:\n    cmp x4, #64\n    b.lo " + p + "_loop1\n";
  let j: i32 = 0;
  while (j < 4) {
    o = o + a64_aes_counter(j);
    j = j + 1;
  }
  o = o + "    bl .Lctr_enc4\n";
  j = 0;
  while (j < 4) {
    o = o + a64_aes_xor_out(j);
    j = j + 1;
  }
  o = o + "    sub x4, x4, #64\n    b " + p + "_loop4\n" + p + "_loop1:\n    cmp x4, #16\n    b.lo " + p + "_tail\n" + a64_aes_counter(0) + "    bl .Lctr_enc1\n"
    + a64_aes_xor_out(0) + "    sub x4, x4, #16\n    b " + p + "_loop1\n";
  return o + p + "_tail:\n    cbz x4, " + done + "\n" + a64_aes_counter(0) + "    bl .Lctr_enc1\n    add x5, x29, #" + util.i32_to_string(tail) + "\n    st1 {v0.16b}, [x5]\n    mov x6, #0\n"
    + p + "_tailb:\n    ldrb w9, [x1, x6]\n    ldrb w10, [x5, x6]\n    eor w9, w9, w10\n    strb w9, [x2, x6]\n    add x6, x6, #1\n    cmp x6, x4\n    b.lo " + p + "_tailb\n    b " + done + "\n";
}

function a64_aes_load_keys(): string {
  return a64_aes_load_keys_at(".Lctr_keys");
}

function a64_aes_load_keys_at(label: string): string {
  let o: string = "";
  let r: i32 = 0;
  while (r < 15) {
    if (r == 11) {
      o = o + "    cmp x7, #14\n    b.ne " + label + "\n";
    }
    o = o + "    ld1 {v" + util.i32_to_string(16 + r) + ".16b}, [x8]\n    add x8, x8, #16\n";
    r = r + 1;
  }
  return o + label + ":\n";
}

function a64_aes_ctr32(): string {
  let o: string = "    .global __fern_aes_ctr32\n    .type __fern_aes_ctr32, %function\n__fern_aes_ctr32:\n"
    + "    stp x29, x30, [sp, #-112]!\n    mov x29, sp\n"
    + a64_aes_view("x2", "x3", "x4", ".Lctr_data") + "    str x3, [x29, #16]\n    str x4, [x29, #24]\n"
    + a64_aes_view("x1", "x3", "x5", ".Lctr_ctr") + "    str x3, [x29, #32]\n"
    + a64_aes_view("x0", "x3", "x6", ".Lctr_rk") + "    str x3, [x29, #40]\n";
  o = o + "    mov x7, #0\n    cmp x6, #176\n    b.lo .Lctr_rounds\n    mov x7, #10\n    cmp x6, #240\n    b.lo .Lctr_rounds\n    mov x7, #14\n.Lctr_rounds:\n"
    + "    cmp x5, #16\n    b.hs .Lctr_ctrok\n    mov x7, #0\n.Lctr_ctrok:\n    str x7, [x29, #48]\n    ldr x0, [x29, #24]\n    cbnz x7, .Lctr_box\n    mov x0, #0\n.Lctr_box:\n"
    + a64_aes_alloc("64") + "    ldr x4, [x0]\n    cbz x4, .Lctr_ret\n    add x2, x0, #8\n    ldr x1, [x29, #16]\n    ldr x8, [x29, #40]\n    ldr x7, [x29, #48]\n    ldr x3, [x29, #32]\n"
    + a64_aes_load_keys() + "    ld1 {v6.16b}, [x3]\n    rev32 v6.16b, v6.16b\n    movi v7.2d, #0\n    mov w9, #1\n    ins v7.s[3], w9\n";
  return o + a64_aes_ctr_blocks() + a64_aes_rounds(".Lctr_enc4", 4) + a64_aes_rounds(".Lctr_enc1", 1)
    + ".Lctr_ret:\n    ldr x0, [x29, #64]\n    ldp x29, x30, [sp], #112\n    ret\n    .size __fern_aes_ctr32, .-__fern_aes_ctr32\n";
}

function a64_ghash_rev(v: string): string {
  return "    rev64 " + v + ".16b, " + v + ".16b\n    ext " + v + ".16b, " + v + ".16b, " + v + ".16b, #8\n";
}

function a64_ghash_mul(): string {
  return ".Lgh_mul:\n    ext v20.16b, v1.16b, v1.16b, #8\n    pmull v3.1q, v0.1d, v1.1d\n    pmull v4.1q, v0.1d, v20.1d\n"
    + "    pmull2 v5.1q, v0.2d, v20.2d\n    pmull2 v6.1q, v0.2d, v1.2d\n    eor v4.16b, v4.16b, v5.16b\n" + a64_ghash_reduce() + "    ret\n";
}

function a64_ghash_reduce(): string {
  return "    ext v5.16b, v31.16b, v4.16b, #8\n    ext v4.16b, v4.16b, v31.16b, #8\n    eor v3.16b, v3.16b, v5.16b\n    eor v6.16b, v6.16b, v4.16b\n"
    + "    ushr v7.4s, v3.4s, #31\n    ushr v16.4s, v6.4s, #31\n    shl v3.4s, v3.4s, #1\n    shl v6.4s, v6.4s, #1\n"
    + "    ext v17.16b, v7.16b, v31.16b, #12\n    ext v16.16b, v31.16b, v16.16b, #12\n    ext v7.16b, v31.16b, v7.16b, #12\n"
    + "    orr v3.16b, v3.16b, v7.16b\n    orr v6.16b, v6.16b, v16.16b\n    orr v6.16b, v6.16b, v17.16b\n"
    + "    shl v7.4s, v3.4s, #31\n    shl v16.4s, v3.4s, #30\n    shl v17.4s, v3.4s, #25\n    eor v7.16b, v7.16b, v16.16b\n    eor v7.16b, v7.16b, v17.16b\n"
    + "    ext v16.16b, v7.16b, v31.16b, #4\n    ext v7.16b, v31.16b, v7.16b, #4\n    eor v3.16b, v3.16b, v7.16b\n"
    + "    ushr v2.4s, v3.4s, #1\n    ushr v4.4s, v3.4s, #2\n    ushr v5.4s, v3.4s, #7\n    eor v2.16b, v2.16b, v4.16b\n    eor v2.16b, v2.16b, v5.16b\n"
    + "    eor v2.16b, v2.16b, v16.16b\n    eor v3.16b, v3.16b, v2.16b\n    eor v0.16b, v6.16b, v3.16b\n";
}

function a64_ghash_prod(x: string, hk: string, first: boolean): string {
  let o: string = "    pmull v2.1q, " + x + ".1d, " + hk + ".1d\n    pmull2 v5.1q, " + x + ".2d, " + hk + ".2d\n    ext v20.16b, " + hk + ".16b, " + hk + ".16b, #8\n"
    + "    pmull v7.1q, " + x + ".1d, v20.1d\n    pmull2 v16.1q, " + x + ".2d, v20.2d\n";
  if (first) {
    return o + "    mov v3.16b, v2.16b\n    mov v6.16b, v5.16b\n    eor v4.16b, v7.16b, v16.16b\n";
  }
  return o + "    eor v3.16b, v3.16b, v2.16b\n    eor v6.16b, v6.16b, v5.16b\n    eor v4.16b, v4.16b, v7.16b\n    eor v4.16b, v4.16b, v16.16b\n";
}

function a64_ghash_blocks4_at(p: string): string {
  let o: string = "    cmp x4, #64\n    b.lo " + p + "_loop\n    mov v19.16b, v0.16b\n    mov v0.16b, v1.16b\n"
    + "    bl .Lgh_mul\n    mov v21.16b, v0.16b\n    bl .Lgh_mul\n    mov v22.16b, v0.16b\n    bl .Lgh_mul\n    mov v23.16b, v0.16b\n    mov v0.16b, v19.16b\n"
    + p + "_loop4:\n    cmp x4, #64\n    b.lo " + p + "_loop\n    ldp q24, q25, [x1]\n    ldp q26, q27, [x1, #32]\n    add x1, x1, #64\n    sub x4, x4, #64\n"
    + a64_ghash_rev("v24") + a64_ghash_rev("v25") + a64_ghash_rev("v26") + a64_ghash_rev("v27") + "    eor v24.16b, v24.16b, v0.16b\n";
  return o + a64_ghash_prod("v24", "v23", true) + a64_ghash_prod("v25", "v22", false) + a64_ghash_prod("v26", "v21", false) + a64_ghash_prod("v27", "v1", false)
    + a64_ghash_reduce() + "    b " + p + "_loop4\n";
}

function a64_ghash_blocks_at(p: string, done: string, pad: i32): string {
  let o: string = a64_ghash_blocks4_at(p) + p + "_loop:\n    cmp x4, #16\n    b.lo " + p + "_tail\n    ld1 {v2.16b}, [x1]\n" + a64_ghash_rev("v2") + "    eor v0.16b, v0.16b, v2.16b\n    bl .Lgh_mul\n"
    + "    add x1, x1, #16\n    sub x4, x4, #16\n    b " + p + "_loop\n";
  return o + p + "_tail:\n    cbz x4, " + done + "\n    add x5, x29, #" + util.i32_to_string(pad) + "\n    st1 {v31.16b}, [x5]\n    mov x6, #0\n"
    + p + "_tailb:\n    ldrb w9, [x1, x6]\n    strb w9, [x5, x6]\n    add x6, x6, #1\n    cmp x6, x4\n    b.lo " + p + "_tailb\n"
    + "    ld1 {v2.16b}, [x5]\n" + a64_ghash_rev("v2") + "    eor v0.16b, v0.16b, v2.16b\n    bl .Lgh_mul\n";
}

function a64_aes_gcm(seal: boolean): string {
  let name: string = if (seal) { "__fern_aes_gcm_seal" } else { "__fern_aes_gcm_open" };
  let p: string = if (seal) { ".Lgcs" } else { ".Lgco" };
  let o: string = "    .global " + name + "\n    .type " + name + ", %function\n" + name + ":\n    stp x29, x30, [sp, #-192]!\n    mov x29, sp\n"
    + a64_aes_view("x4", "x5", "x6", p + "_d") + "    str x5, [x29, #16]\n    str x6, [x29, #24]\n"
    + a64_aes_view("x3", "x5", "x6", p + "_a") + "    str x5, [x29, #64]\n    str x6, [x29, #72]\n"
    + a64_aes_view("x2", "x5", "x6", p + "_n") + "    str x5, [x29, #56]\n    str x6, [x29, #176]\n"
    + a64_aes_view("x1", "x5", "x6", p + "_h") + "    str x5, [x29, #48]\n    str x6, [x29, #184]\n"
    + a64_aes_view("x0", "x5", "x6", p + "_k") + "    str x5, [x29, #32]\n";
  o = o + "    mov x7, #0\n    cmp x6, #176\n    b.lo " + p + "_r\n    mov x7, #10\n    cmp x6, #240\n    b.lo " + p + "_r\n    mov x7, #14\n" + p + "_r:\n"
    + "    ldr x9, [x29, #176]\n    cmp x9, #12\n    b.eq " + p + "_nok\n    mov x7, #0\n" + p + "_nok:\n"
    + "    ldr x9, [x29, #184]\n    cmp x9, #16\n    b.hs " + p + "_hok\n    mov x7, #0\n" + p + "_hok:\n    str x7, [x29, #40]\n"
    + "    ldr x0, [x29, #24]\n    add x0, x0, #16\n    cbnz x7, " + p + "_box\n    mov x0, #0\n" + p + "_box:\n"
    + a64_aes_alloc("96") + "    ldr x9, [x0]\n    cbz x9, " + p + "_ret\n";
  o = o + "    ldr x5, [x29, #56]\n    ldr x9, [x5]\n    ldr w10, [x5, #8]\n    str x9, [x29, #112]\n    str w10, [x29, #120]\n"
    + "    mov w11, #33554432\n    str w11, [x29, #124]\n";
  if (seal) {
    o = o + a64_aes_gcm_ctr(p) + a64_aes_gcm_hash(p, "    ldr x1, [x29, #96]\n    add x1, x1, #8\n");
  } else {
    o = o + a64_aes_gcm_hash(p, "    ldr x1, [x29, #16]\n") + a64_aes_gcm_ctr(p);
  }
  o = o + "    mov w11, #16777216\n    str w11, [x29, #124]\n    ldr x8, [x29, #32]\n    ldr x7, [x29, #40]\n" + a64_aes_load_keys_at(p + "_k2")
    + "    add x5, x29, #112\n    ld1 {v0.16b}, [x5]\n    bl .Lctr_enc1\n    add x5, x29, #160\n    ld1 {v1.16b}, [x5]\n    eor v0.16b, v0.16b, v1.16b\n"
    + "    ldr x3, [x29, #96]\n    add x3, x3, #8\n    ldr x9, [x29, #24]\n    add x3, x3, x9\n    st1 {v0.16b}, [x3]\n";
  return o + p + "_ret:\n    ldr x0, [x29, #96]\n    ldp x29, x30, [sp], #192\n    ret\n    .size " + name + ", .-" + name + "\n";
}

function a64_aes_gcm_ctr(p: string): string {
  return "    add x5, x29, #112\n    ld1 {v6.16b}, [x5]\n    rev32 v6.16b, v6.16b\n    movi v7.2d, #0\n    mov w9, #1\n    ins v7.s[3], w9\n"
    + "    ldr x8, [x29, #32]\n    ldr x7, [x29, #40]\n" + a64_aes_load_keys_at(p + "_k1")
    + "    ldr x1, [x29, #16]\n    ldr x4, [x29, #24]\n    ldr x2, [x29, #96]\n    add x2, x2, #8\n"
    + a64_aes_ctr_blocks_at(p + "_c", p + "_cdone", 80) + p + "_cdone:\n";
}

function a64_aes_gcm_hash(p: string, ct: string): string {
  return "    movi v31.2d, #0\n    ldr x5, [x29, #48]\n    ld1 {v1.16b}, [x5]\n" + a64_ghash_rev("v1") + "    movi v0.2d, #0\n"
    + "    ldr x1, [x29, #64]\n    ldr x4, [x29, #72]\n" + a64_ghash_blocks_at(p + "_ga", p + "_gadone", 128) + p + "_gadone:\n"
    + ct + "    ldr x4, [x29, #24]\n" + a64_ghash_blocks_at(p + "_gc", p + "_gcdone", 128) + p + "_gcdone:\n"
    + "    ldr x9, [x29, #72]\n    lsl x9, x9, #3\n    rev x9, x9\n    str x9, [x29, #144]\n"
    + "    ldr x9, [x29, #24]\n    lsl x9, x9, #3\n    rev x9, x9\n    str x9, [x29, #152]\n"
    + "    add x5, x29, #144\n    ld1 {v2.16b}, [x5]\n" + a64_ghash_rev("v2") + "    eor v0.16b, v0.16b, v2.16b\n    bl .Lgh_mul\n"
    + a64_ghash_rev("v0") + "    add x5, x29, #160\n    st1 {v0.16b}, [x5]\n";
}

function a64_ghash(): string {
  let o: string = "    .global __fern_ghash\n    .type __fern_ghash, %function\n__fern_ghash:\n    stp x29, x30, [sp, #-80]!\n    mov x29, sp\n"
    + a64_aes_view("x2", "x3", "x4", ".Lgh_data") + "    str x3, [x29, #16]\n    str x4, [x29, #24]\n"
    + a64_aes_view("x1", "x3", "x5", ".Lgh_y") + "    str x3, [x29, #32]\n"
    + a64_aes_view("x0", "x3", "x6", ".Lgh_h") + "    str x3, [x29, #40]\n"
    + "    mov x0, #16\n    cmp x6, #16\n    b.hs .Lgh_hok\n    mov x0, #0\n.Lgh_hok:\n    cmp x5, #16\n    b.hs .Lgh_yok\n    mov x0, #0\n.Lgh_yok:\n"
    + a64_aes_alloc("48") + "    ldr x4, [x0]\n    cbz x4, .Lgh_ret\n    movi v31.2d, #0\n"
    + "    ldr x3, [x29, #40]\n    ld1 {v1.16b}, [x3]\n" + a64_ghash_rev("v1") + "    ldr x3, [x29, #32]\n    ld1 {v0.16b}, [x3]\n" + a64_ghash_rev("v0")
    + "    ldr x1, [x29, #16]\n    ldr x4, [x29, #24]\n";
  o = o + a64_ghash_blocks_at(".Lgh", ".Lgh_out", 64);
  return o + ".Lgh_out:\n" + a64_ghash_rev("v0") + "    ldr x0, [x29, #48]\n    add x3, x0, #8\n    st1 {v0.16b}, [x3]\n"
    + ".Lgh_ret:\n    ldr x0, [x29, #48]\n    ldp x29, x30, [sp], #80\n    ret\n" + a64_ghash_mul() + "    .size __fern_ghash, .-__fern_ghash\n";
}

function emit_aes_gcm_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("aes_gcm").need("heap");
  if (o.kind_tag == 402) {
    return s.write("    ldr x0, [sp], #16\n    bl __fern_aes_expand_key\n    str x0, [sp, #-16]!\n");
  }
  if (o.kind_tag == 444 || o.kind_tag == 445) {
    let fused: string = if (o.kind_tag == 444) { "__fern_aes_gcm_seal" } else { "__fern_aes_gcm_open" };
    return s.write("    ldr x4, [sp], #16\n    ldr x3, [sp], #16\n    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    bl " + fused + "\n    str x0, [sp, #-16]!\n");
  }
  let callee: string = "__fern_aes_ctr32";
  if (o.kind_tag == 404) {
    callee = "__fern_ghash";
  }
  return s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    bl " + callee + "\n    str x0, [sp, #-16]!\n");
}

function emit_rt_aes_gcm(s: asmcore.EmitState): asmcore.EmitState {
  return s.write("    .arch_extension aes\n" + a64_aes_expand_key() + a64_aes_ctr32() + a64_ghash() + a64_aes_gcm(true) + a64_aes_gcm(false));
}

function a64_sha256_blocks(): string {
  let o: string = "    .global __fern_sha256_hw_blocks\n    .type __fern_sha256_hw_blocks, %function\n__fern_sha256_hw_blocks:\n"
    + "    stp x29, x30, [sp, #-96]!\n    mov x29, sp\n"
    + a64_aes_view("x1", "x3", "x4", ".Lsha_data") + "    str x3, [x29, #16]\n    str x4, [x29, #24]\n"
    + a64_aes_view("x0", "x3", "x5", ".Lsha_st") + "    str x3, [x29, #32]\n"
    + "    mov x0, #32\n    cmp x5, #32\n    b.hs .Lsha_stok\n    mov x0, #0\n.Lsha_stok:\n"
    + a64_aes_alloc("40") + "    ldr x4, [x0]\n    cbz x4, .Lsha_ret\n"
    + "    ldr x3, [x29, #32]\n    ld1 {v0.16b}, [x3]\n    add x3, x3, #16\n    ld1 {v1.16b}, [x3]\n"
    + a64_sha256_load_k() + "    ldr x1, [x29, #16]\n    ldr x4, [x29, #24]\n    add x10, x29, #48\n    add x11, x29, #64\n";
  o = o + ".Lsha_loop:\n    cmp x4, #64\n    b.lo .Lsha_done\n";
  let j: i32 = 4;
  while (j < 8) {
    let v: string = "v" + util.i32_to_string(j);
    o = o + "    ld1 {" + v + ".16b}, [x1]\n    add x1, x1, #16\n    rev32 " + v + ".16b, " + v + ".16b\n";
    j = j + 1;
  }
  o = o + "    st1 {v0.16b}, [x10]\n    st1 {v1.16b}, [x11]\n" + a64_sha256_rounds()
    + "    ld1 {v2.16b}, [x10]\n    ld1 {v3.16b}, [x11]\n    add v0.4s, v0.4s, v2.4s\n    add v1.4s, v1.4s, v3.4s\n"
    + "    sub x4, x4, #64\n    b .Lsha_loop\n";
  return o + ".Lsha_done:\n    ldr x0, [x29, #40]\n    add x3, x0, #8\n    st1 {v0.16b}, [x3]\n    add x3, x3, #16\n    st1 {v1.16b}, [x3]\n"
    + ".Lsha_ret:\n    ldr x0, [x29, #40]\n    ldp x29, x30, [sp], #96\n    ret\n    .size __fern_sha256_hw_blocks, .-__fern_sha256_hw_blocks\n";
}

function a64_sha1_blocks(): string {
  let o: string = "    .global __fern_sha1_hw_blocks\n    .type __fern_sha1_hw_blocks, %function\n__fern_sha1_hw_blocks:\n"
    + "    stp x29, x30, [sp, #-48]!\n    mov x29, sp\n"
    + a64_aes_view("x1", "x3", "x4", ".Lsha1_data") + "    str x3, [x29, #16]\n    str x4, [x29, #24]\n"
    + a64_aes_view("x0", "x3", "x5", ".Lsha1_st") + "    str x3, [x29, #32]\n"
    + "    mov x0, #20\n    cmp x5, #20\n    b.hs .Lsha1_stok\n    mov x0, #0\n.Lsha1_stok:\n"
    + a64_aes_alloc("40") + "    ldr x4, [x0]\n    cbz x4, .Lsha1_ret\n"
    + "    ldr x3, [x29, #32]\n    ld1 {v0.16b}, [x3]\n    ldr w9, [x3, #16]\n    ins v1.s[0], w9\n";
  let k: u32[] = [0x5a827999, 0x6ed9eba1, 0x8f1bbcdc, 0xca62c1d6];
  let i: i32 = 0;
  while (i < 4) {
    o = o + "    movz w8, #" + util.i32_to_string((k[i] & 0xffff) as i32) + "\n    movk w8, #" + util.i32_to_string((k[i] >> 16) as i32)
      + ", lsl #16\n    dup v" + util.i32_to_string(16 + i) + ".4s, w8\n";
    i = i + 1;
  }
  o = o + "    ldr x1, [x29, #16]\n    ldr x4, [x29, #24]\n.Lsha1_loop:\n    cmp x4, #64\n    b.lo .Lsha1_done\n";
  let j: i32 = 4;
  while (j < 8) {
    let v: string = "v" + util.i32_to_string(j);
    o = o + "    ld1 {" + v + ".16b}, [x1]\n    add x1, x1, #16\n    rev32 " + v + ".16b, " + v + ".16b\n";
    j = j + 1;
  }
  o = o + "    orr v20.16b, v0.16b, v0.16b\n    orr v21.16b, v1.16b, v1.16b\n" + a64_sha1_rounds()
    + "    add v0.4s, v0.4s, v20.4s\n    add v1.4s, v1.4s, v21.4s\n    sub x4, x4, #64\n    b .Lsha1_loop\n";
  return o + ".Lsha1_done:\n    ldr x0, [x29, #40]\n    add x3, x0, #8\n    st1 {v0.16b}, [x3]\n    umov w9, v1.s[0]\n    str w9, [x3, #16]\n"
    + ".Lsha1_ret:\n    ldr x0, [x29, #40]\n    ldp x29, x30, [sp], #48\n    ret\n    .size __fern_sha1_hw_blocks, .-__fern_sha1_hw_blocks\n";
}

function emit_rt_sha(s: asmcore.EmitState): asmcore.EmitState {
  if (s.has_need("sha256") || s.has_need("sha1")) {
    s = s.write("    .arch_extension sha2\n");
  }
  if (s.has_need("sha256")) {
    s = s.write(a64_sha256_blocks());
  }
  if (s.has_need("sha1")) {
    s = s.write(a64_sha1_blocks());
  }
  return s;
}

function a64_sha1_rounds(): string {
  let ops: string[] = ["sha1c", "sha1p", "sha1m", "sha1p"];
  let o: string = "";
  let i: i32 = 0;
  while (i < 20) {
    let w: string = "v" + util.i32_to_string(4 + i % 4);
    let e: string = "s1";
    let next: string = "s3";
    if (i % 2 == 1) {
      e = "s3";
      next = "s1";
    }
    o = o + "    add v2.4s, " + w + ".4s, v" + util.i32_to_string(16 + i / 5) + ".4s\n    sha1h " + next + ", s0\n    "
      + ops[i / 5] + " q0, " + e + ", v2.4s\n";
    if (i < 16) {
      o = o + "    sha1su0 " + w + ".4s, v" + util.i32_to_string(4 + (i + 1) % 4) + ".4s, v" + util.i32_to_string(4 + (i + 2) % 4) + ".4s\n"
        + "    sha1su1 " + w + ".4s, v" + util.i32_to_string(4 + (i + 3) % 4) + ".4s\n";
    }
    i = i + 1;
  }
  return o;
}

function a64_sha256_pair(x: string, k: u32[], at: i32): string {
  let o: string = "";
  let h: i32 = 0;
  while (h < 4) {
    let word: u32 = k[at + h / 2];
    let half: i32 = (word >> (16 * (h % 2)) as u32 & 0xffff) as i32;
    if (h == 0) {
      o = o + "    movz " + x + ", #" + util.i32_to_string(half) + "\n";
    } else {
      o = o + "    movk " + x + ", #" + util.i32_to_string(half) + ", lsl #" + util.i32_to_string(16 * h) + "\n";
    }
    h = h + 1;
  }
  return o;
}

function a64_sha256_load_k(): string {
  let k: u32[] = asmcore.sha256_k();
  let o: string = "";
  let i: i32 = 0;
  while (i < 16) {
    let v: string = "v" + util.i32_to_string(16 + i);
    o = o + a64_sha256_pair("x8", k, 4 * i) + a64_sha256_pair("x9", k, 4 * i + 2)
      + "    ins " + v + ".d[0], x8\n    ins " + v + ".d[1], x9\n";
    i = i + 1;
  }
  return o;
}

function a64_sha256_rounds(): string {
  let o: string = "";
  let i: i32 = 0;
  while (i < 16) {
    let w: string = "v" + util.i32_to_string(4 + i % 4);
    o = o + "    add v2.4s, " + w + ".4s, v" + util.i32_to_string(16 + i) + ".4s\n";
    if (i < 12) {
      o = o + "    sha256su0 " + w + ".4s, v" + util.i32_to_string(4 + (i + 1) % 4) + ".4s\n";
    }
    o = o + "    orr v3.16b, v0.16b, v0.16b\n    sha256h q0, q1, v2.4s\n    sha256h2 q1, q3, v2.4s\n";
    if (i < 12) {
      o = o + "    sha256su1 " + w + ".4s, v" + util.i32_to_string(4 + (i + 2) % 4) + ".4s, v" + util.i32_to_string(4 + (i + 3) % 4) + ".4s\n";
    }
    i = i + 1;
  }
  return o;
}

function emit_rt_crc32_cksum(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .arch_extension aes\n");
  s = s.write("    .global __fern_crc32_cksum\n");
  s = s.write("    .global __fern_crc32_cksum_data\n");
  s = s.write("    .type __fern_crc32_cksum, %function\n");
  s = s.write("__fern_crc32_cksum:\n");
  s = s.write("    ldr x6, [x1, #8]\n");
  s = s.write("    ldr x7, [x1]\n");
  s = s.write("__fern_crc32_cksum_data:\n");
  s = s.write("    stp x29, x30, [sp, #-64]!\n");
  s = s.write("    mov x29, sp\n");
  s = s.write("    mov w10, w0\n");
  s = s.write("    mov x8, x7\n");
  s = s.write("    add x9, x7, w6, uxtw\n");
  s = s.write("    mov w0, w10\n");
  s = s.write("    sub x11, x9, x8\n");
  s = s.write("    cmp x11, #16\n");
  s = s.write("    b.lo .Lcrc32_tail\n");
  s = s.write("    movz w12, #0x5605\n");
  s = s.write("    movk w12, #0xe8a4, lsl #16\n");
  s = s.write("    movz w13, #0xcd4c\n");
  s = s.write("    movk w13, #0xc5b9, lsl #16\n");
  s = s.write("    movi v2.2d, #0\n");
  s = s.write("    ins v2.d[0], x12\n");
  s = s.write("    ins v2.d[1], x13\n");
  s = s.write("    ld1 {v0.16b}, [x8]\n");
  s = s.write("    rev64 v0.16b, v0.16b\n");
  s = s.write("    ext v0.16b, v0.16b, v0.16b, #8\n");
  s = s.write("    lsl x14, x10, #32\n");
  s = s.write("    movi v1.2d, #0\n");
  s = s.write("    ins v1.d[1], x14\n");
  s = s.write("    eor v0.16b, v0.16b, v1.16b\n");
  s = s.write("    mov w0, wzr\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    sub x11, x9, x8\n");
  s = s.write("    cmp x11, #112\n");
  s = s.write("    b.lo .Lcrc32_fold1\n");
  s = s.write("    ld1 {v6.16b}, [x8]\n");
  s = s.write("    rev64 v6.16b, v6.16b\n");
  s = s.write("    ext v6.16b, v6.16b, v6.16b, #8\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    ld1 {v7.16b}, [x8]\n");
  s = s.write("    rev64 v7.16b, v7.16b\n");
  s = s.write("    ext v7.16b, v7.16b, v7.16b, #8\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    ld1 {v16.16b}, [x8]\n");
  s = s.write("    rev64 v16.16b, v16.16b\n");
  s = s.write("    ext v16.16b, v16.16b, v16.16b, #8\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    movz w12, #0x8b11\n");
  s = s.write("    movk w12, #0xe622, lsl #16\n");
  s = s.write("    movz w13, #0x794c\n");
  s = s.write("    movk w13, #0x8833, lsl #16\n");
  s = s.write("    movi v17.2d, #0\n");
  s = s.write("    ins v17.d[0], x12\n");
  s = s.write("    ins v17.d[1], x13\n");
  s = s.write(".Lcrc32_fold4:\n");
  s = s.write("    sub x11, x9, x8\n");
  s = s.write("    cmp x11, #64\n");
  s = s.write("    b.lo .Lcrc32_combine\n");
  s = s.write("    pmull2 v3.1q, v0.2d, v17.2d\n");
  s = s.write("    pmull v4.1q, v0.1d, v17.1d\n");
  s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
  s = s.write("    ld1 {v5.16b}, [x8]\n");
  s = s.write("    rev64 v5.16b, v5.16b\n");
  s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
  s = s.write("    eor v0.16b, v0.16b, v5.16b\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    pmull2 v3.1q, v6.2d, v17.2d\n");
  s = s.write("    pmull v4.1q, v6.1d, v17.1d\n");
  s = s.write("    eor v6.16b, v3.16b, v4.16b\n");
  s = s.write("    ld1 {v5.16b}, [x8]\n");
  s = s.write("    rev64 v5.16b, v5.16b\n");
  s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
  s = s.write("    eor v6.16b, v6.16b, v5.16b\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    pmull2 v3.1q, v7.2d, v17.2d\n");
  s = s.write("    pmull v4.1q, v7.1d, v17.1d\n");
  s = s.write("    eor v7.16b, v3.16b, v4.16b\n");
  s = s.write("    ld1 {v5.16b}, [x8]\n");
  s = s.write("    rev64 v5.16b, v5.16b\n");
  s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
  s = s.write("    eor v7.16b, v7.16b, v5.16b\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    pmull2 v3.1q, v16.2d, v17.2d\n");
  s = s.write("    pmull v4.1q, v16.1d, v17.1d\n");
  s = s.write("    eor v16.16b, v3.16b, v4.16b\n");
  s = s.write("    ld1 {v5.16b}, [x8]\n");
  s = s.write("    rev64 v5.16b, v5.16b\n");
  s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
  s = s.write("    eor v16.16b, v16.16b, v5.16b\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    b .Lcrc32_fold4\n");
  s = s.write(".Lcrc32_combine:\n");
  s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
  s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
  s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
  s = s.write("    eor v0.16b, v0.16b, v6.16b\n");
  s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
  s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
  s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
  s = s.write("    eor v0.16b, v0.16b, v7.16b\n");
  s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
  s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
  s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
  s = s.write("    eor v0.16b, v0.16b, v16.16b\n");
  s = s.write(".Lcrc32_fold1:\n");
  s = s.write("    sub x11, x9, x8\n");
  s = s.write("    cmp x11, #16\n");
  s = s.write("    b.lo .Lcrc32_reduce\n");
  s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
  s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
  s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
  s = s.write("    ld1 {v5.16b}, [x8]\n");
  s = s.write("    rev64 v5.16b, v5.16b\n");
  s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
  s = s.write("    eor v0.16b, v0.16b, v5.16b\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    b .Lcrc32_fold1\n");
  s = s.write(".Lcrc32_reduce:\n");
  s = s.write("    rev64 v0.16b, v0.16b\n");
  s = s.write("    ext v0.16b, v0.16b, v0.16b, #8\n");
  s = s.write("    add x15, x29, #48\n");
  s = s.write("    st1 {v0.16b}, [x15]\n");
  s = s.write("    mov x16, xzr\n");
  s = s.write(".Lcrc32_red:\n");
  s = s.write("    cmp x16, #16\n");
  s = s.write("    b.hs .Lcrc32_tail\n");
  s = s.write("    ldrb w17, [x15, x16]\n");
  s = s.write("    lsl w17, w17, #24\n");
  s = s.write("    eor w0, w0, w17\n");
  s = s.write("    mov w12, #8\n");
  s = s.write("    movz w13, #0x1db7\n");
  s = s.write("    movk w13, #0x04c1, lsl #16\n");
  s = s.write(".Lcrc32_redbit:\n");
  s = s.write("    asr w14, w0, #31\n");
  s = s.write("    and w14, w14, w13\n");
