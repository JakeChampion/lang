function fr_sub_imm(s: asmcore.EmitState, dst: string, base: string, imm: i32): asmcore.EmitState {
  if (imm <= 4095) {
    return ssa_addsub_imm(s, true, dst, base, imm);
  }
  s = s.write("    movz x17, #" + util.i32_to_string(imm & 65535) + "\n");
  if (imm > 65535) {
    s = s.write("    movk x17, #" + util.i32_to_string(imm >> 16 & 65535) + ", lsl #16\n");
  }
  s = s.write("    sub " + dst + ", " + base + ", x17\n");
  return s;
}

function arm64_copy_words(s: asmcore.EmitState, src: string, dst: string, n: i32): asmcore.EmitState {
  let lo = asmcore.fresh_label(s);
  let lbl = lo.name;
  s = lo.state;
  s = s.write("    adrp x9, " + src + "\n    add x9, x9, :lo12:" + src + "\n");
  s = s.write("    adrp x10, " + dst + "\n    add x10, x10, :lo12:" + dst + "\n");
  s = s.write("    mov x11, #" + util.i32_to_string(n) + "\n");
  s = s.write(lbl + ":\n");
  s = s.write("    ldr x12, [x9], #8\n");
  s = s.write("    str x12, [x10], #8\n");
  s = s.write("    sub x11, x11, #1\n");
  s = s.write("    cbnz x11, " + lbl + "\n");
  return s;
}

// A division or remainder by a constant k, on the dividend in x4: the result
// is left in x4, and x5 and x6 are scratch. A 32-bit dividend is held sign- or
// zero-extended, so it divides as a 64-bit value. The sdiv/udiv semantics stay:
// k == 0 gives 0 for a quotient and the dividend for a remainder.
function ssa_div_const(tag: i32, width: i32, k: i64, s: asmcore.EmitState): asmcore.EmitState {
  let uns = tag == ir.K_DIV_U || tag == ir.K_REM_U;
  let is_rem = tag == ir.K_REM_S || tag == ir.K_REM_U;
  if (width == 64) {
    return ssa_div_const_body(uns, is_rem, k, 0, s);
  }
  if (uns) {
    return ssa_div_const_body(true, is_rem, (k as i32) as i64 & 4294967295i64, 32, s);
  }
  let d = (k as i32) as i64;
  if (d == -1i64 && !is_rem) {
    return s.write("    neg w4, w4\n    sxtw x4, w4\n");
  }
  return ssa_div_const_body(false, is_rem, d, 32, s);
}

// ext is the count of high bits that only extend the dividend: zeros when it
// is unsigned, copies of the sign bit when it is signed.
function ssa_div_const_body(uns: boolean, is_rem: boolean, d: i64, ext: i32, s: asmcore.EmitState): asmcore.EmitState {
  let mag = d;
  let neg = false;
  if (!uns && d == -9223372036854775808i64) {
    s = ssa_const_reg(util.i64_to_string(d), "x6", s);
    return s.write(ssa_div_by(is_rem));
  }
  if (!uns && d < 0i64) {
    neg = true;
    mag = 0i64 - d;
  }
  if (mag == 0i64) {
    if (is_rem) {
      return s;
    }
    return s.write("    mov x4, #0\n");
  }
  if (mag == 1i64) {
    if (is_rem) {
      return s.write("    mov x4, #0\n");
    }
    if (neg) {
      return s.write("    neg x4, x4\n");
    }
    return s;
  }
  let sh = ir.pow2_shift_i64(mag);
  let max_sh = 62;
  if (uns) {
    max_sh = 63;
  }
  if (sh >= 0 && sh <= max_sh) {
    return s.write(ssa_div_const_pow2(uns, is_rem, neg, sh));
  }
  if (uns) {
    s = ssa_div_magic_u(mag as u64, ext, s);
  } else if (ext == 32) {
    s = ssa_div_magic_s32(d, s);
  } else {
    s = ssa_div_magic_s(d, s);
  }
  if (!is_rem) {
    return s.write("    mov x4, x5\n");
  }
  s = ssa_const_reg(util.i64_to_string(d), "x6", s);
  return s.write("    msub x4, x5, x6, x4\n");
}

function ssa_div_by(is_rem: boolean): string {
  if (is_rem) {
    return "    sdiv x5, x4, x6\n    msub x4, x5, x6, x4\n";
  }
  return "    sdiv x4, x4, x6\n";
}

function ssa_div_const_pow2(uns: boolean, is_rem: boolean, neg: boolean, sh: i32): string {
  let shs = util.i32_to_string(sh);
  let back = util.i32_to_string(64 - sh);
  if (uns && is_rem) {
    return "    lsl x4, x4, #" + back + "\n    lsr x4, x4, #" + back + "\n";
  }
  if (uns) {
    return "    lsr x4, x4, #" + shs + "\n";
  }
  let s = "    asr x5, x4, #63\n    add x5, x4, x5, lsr #" + back + "\n";
  if (is_rem) {
    return s + "    asr x5, x5, #" + shs + "\n    sub x4, x4, x5, lsl #" + shs + "\n";
  }
  s = s + "    asr x4, x5, #" + shs + "\n";
  if (neg) {
    s += "    neg x4, x4\n";
  }
  return s;
}

// The quotient of x4 by a signed divisor that is not a power of two, left in x5.
function ssa_div_magic_s(d: i64, s: asmcore.EmitState): asmcore.EmitState {
  let ms = ir.derive_magic_s(d);
  s = ssa_const_reg(util.i64_to_string(ms.m), "x5", s);
  s = s.write("    smulh x5, x4, x5\n");
  if (ms.add) {
    s = s.write("    add x5, x5, x4\n");
  }
  if (ms.sub) {
    s = s.write("    sub x5, x5, x4\n");
  }
  if (ms.s != 0) {
    s = s.write("    asr x5, x5, #" + util.i32_to_string(ms.s) + "\n");
  }
  return s.write("    add x5, x5, x5, lsr #63\n");
}

// The quotient of the sign-extended i32 in x4 by a signed divisor that is not
// a power of two, left in x5. The product cannot overflow 64 bits.
function ssa_div_magic_s32(d: i64, s: asmcore.EmitState): asmcore.EmitState {
  let mg = ir.derive_magic_s32(d);
  s = ssa_const_reg(util.i64_to_string(mg.m), "x5", s);
  s = s.write("    mul x5, x4, x5\n    asr x5, x5, #" + util.i32_to_string(mg.s) + "\n");
  return s.write("    add x5, x5, x5, lsr #63\n");
}

// The quotient of x4 by an unsigned divisor that is not a power of two, left in x5.
function ssa_div_magic_u(d: u64, lz: i32, s: asmcore.EmitState): asmcore.EmitState {
  let mu = ir.derive_magic_u_below(d, 64, lz);
  let pre = 0;
  if (mu.add && (d & 1u64) == 0u64) {
    while ((d >> pre as u64 & 1u64) == 0u64) {
      pre += 1;
    }
    mu = ir.derive_magic_u_below(d >> pre as u64, 64, lz + pre);
  }
  s = ssa_const_reg(util.i64_to_string(mu.m as i64), "x5", s);
  let src = "x4";
  if (pre > 0) {
    s = s.write("    lsr x6, x4, #" + util.i32_to_string(pre) + "\n");
    src = "x6";
  }
  s = s.write("    umulh x5, " + src + ", x5\n");
  if (!mu.add) {
    if (mu.s > 0) {
      s = s.write("    lsr x5, x5, #" + util.i32_to_string(mu.s) + "\n");
    }
    return s;
  }
  s = s.write("    sub x6, x4, x5\n    add x5, x5, x6, lsr #1\n");
  if (mu.s > 1) {
    s = s.write("    lsr x5, x5, #" + util.i32_to_string(mu.s - 1) + "\n");
  }
  return s;
}

function fr_ldr(s: asmcore.EmitState, reg: string, off: i32): asmcore.EmitState {
  if (off >= -256) {
    return ssa_ldst(s, true, reg, "x29", off);
  }
  s = fr_sub_imm(s, "x16", "x29", -off);
  s = s.write("    ldr " + reg + ", [x16]\n");
  return s;
}

function fr_str(s: asmcore.EmitState, reg: string, off: i32): asmcore.EmitState {
  if (off >= -256) {
    return ssa_ldst(s, false, reg, "x29", off);
  }
  s = fr_sub_imm(s, "x16", "x29", -off);
  s = s.write("    str " + reg + ", [x16]\n");
  return s;
}

function ir_bin_asm(tag: i32, width: i32, d: string, r: string, t: string): string {
  if (tag == ir.K_ADD) {
    return "    add " + d + ", " + d + ", " + r + "\n";
  }
  if (tag == ir.K_SUB) {
    return "    sub " + d + ", " + d + ", " + r + "\n";
  }
  if (tag == ir.K_MUL) {
    return "    mul " + d + ", " + d + ", " + r + "\n";
  }
  if (tag == ir.K_DIV_S && width != 64) {
    return "    sdiv " + d + ", " + d + ", " + r + "\n    sxtw " + d + ", " + ssa_wreg(d) + "\n";
  }
  if (tag == ir.K_DIV_S) {
    return "    sdiv " + d + ", " + d + ", " + r + "\n";
  }
  if (tag == ir.K_REM_S) {
    return "    sdiv " + t + ", " + d + ", " + r + "\n    msub " + d + ", " + t + ", " + r + ", " + d + "\n";
  }
  if (tag == ir.K_DIV_U) {
    return "    udiv " + d + ", " + d + ", " + r + "\n";
  }
  if (tag == ir.K_REM_U) {
    return "    udiv " + t + ", " + d + ", " + r + "\n    msub " + d + ", " + t + ", " + r + ", " + d + "\n";
  }
  if (tag == ir.K_AND) {
    return "    and " + d + ", " + d + ", " + r + "\n";
  }
  if (tag == ir.K_OR) {
    return "    orr " + d + ", " + d + ", " + r + "\n";
  }
  if (tag == ir.K_XOR) {
    return "    eor " + d + ", " + d + ", " + r + "\n";
  }
  if (width == 64) {
    if (tag == ir.K_SHL) {
      return "    lsl " + d + ", " + d + ", " + r + "\n";
    }
    if (tag == ir.K_SHR_S) {
      return "    asr " + d + ", " + d + ", " + r + "\n";
    }
    if (tag == ir.K_SHR_U) {
      return "    lsr " + d + ", " + d + ", " + r + "\n";
    }
  }
  if (tag == ir.K_SHL) {
    return "    and " + r + ", " + r + ", #31\n    lsl " + d + ", " + d + ", " + r + "\n";
  }
  if (tag == ir.K_SHR_S) {
    return "    and " + r + ", " + r + ", #31\n    asr " + d + ", " + d + ", " + r + "\n";
  }
  if (tag == ir.K_SHR_U) {
    return "    and " + r + ", " + r + ", #31\n    lsr " + d + ", " + d + ", " + r + "\n";
  }
  if (tag == ir.K_EQ) {
    return "    cmp " + d + ", " + r + "\n    cset " + d + ", eq\n";
  }
  if (tag == ir.K_NE) {
    return "    cmp " + d + ", " + r + "\n    cset " + d + ", ne\n";
  }
  if (tag == ir.K_LT_S) {
    return "    cmp " + d + ", " + r + "\n    cset " + d + ", lt\n";
  }
  if (tag == ir.K_LE_S) {
    return "    cmp " + d + ", " + r + "\n    cset " + d + ", le\n";
  }
  if (tag == ir.K_GT_S) {
    return "    cmp " + d + ", " + r + "\n    cset " + d + ", gt\n";
  }
  if (tag == ir.K_GE_S) {
    return "    cmp " + d + ", " + r + "\n    cset " + d + ", ge\n";
  }
  if (tag == ir.K_LT_U) {
    return "    cmp " + d + ", " + r + "\n    cset " + d + ", lo\n";
  }
  if (tag == ir.K_LE_U) {
    return "    cmp " + d + ", " + r + "\n    cset " + d + ", ls\n";
  }
  if (tag == ir.K_GT_U) {
    return "    cmp " + d + ", " + r + "\n    cset " + d + ", hi\n";
  }
  if (tag == ir.K_GE_U) {
    return "    cmp " + d + ", " + r + "\n    cset " + d + ", hs\n";
  }
  return ircore.unsupported_op_refuse(tag, "arm64");
}

function ir_cmp_cond(tag: i32, when_true: boolean): string {
  return arm64_native.arm64_cond_name(ir_cmp_cc(tag, when_true));
}

function ir_cmp_cc(tag: i32, when_true: boolean): i32 {
  let direct: i32[] = [CC_EQ, CC_NE, CC_LT, CC_LE, CC_GT, CC_GE, CC_LO, CC_LS, CC_HI, CC_HS];
  let at = tag - 35;
  if (at < 0 || at > 9) {
    at = 9;
  }
  if (when_true) {
    return direct[at];
  }
  return direct[at] ^ 1;
}

const CC_EQ: i32 = 0;

const CC_NE: i32 = 1;

const CC_HS: i32 = 2;

const CC_LO: i32 = 3;

const CC_HI: i32 = 8;

const CC_LS: i32 = 9;

const CC_GE: i32 = 10;

const CC_LT: i32 = 11;

const CC_GT: i32 = 12;

const CC_LE: i32 = 13;

function shift_imm_asm(tag: i32, width: i32, count: i64, d: string, a: string): string {
  let k = count as i32 & 31;
  if (width == 64) {
    k = count as i32 & 63;
  }
  let imm = " " + d + ", " + a + ", #" + util.i32_to_string(k) + "\n";
  if (tag == 31) {
    return "    lsl" + imm;
  }
  if (tag == 32) {
    return "    asr" + imm;
  }
  return "    lsr" + imm;
}

function set_entry_load(o: ir.Op, set: string, idx: string): string {
  if (ir.is_packed(o)) {
    return "    add x5, " + set + ", " + idx + "\n    ldrb w7, [x5, #8]\n";
  }
  return "    add x5, " + set + ", " + idx + ", lsl #3\n    ldr x7, [x5, #8]\n";
}

function emit_scan_set_blocks(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let names: string[] = [];
  while (names.len() < 8) {
    let lo = asmcore.fresh_label(s);
    names = names.append(lo.name);
    s = lo.state;
  }
  let lit = asmcore.add_string_lit(asmcore.EmitState { ...s }, asmcore.scan_set_tables(o.str));
  s = lit.state;
  let tables = asmcore.str_lit_label(s, lit.idx);
  let l_from_ok = names[0];
  let l_loop = names[1];
  let l_hit16 = names[2];
  let l_tail = names[3];
  let l_hit = names[4];
  let l_end = names[5];
  let l_done = names[6];
  let l_byte = names[7];
  s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
  if (o.kind_tag == ir.K_SCAN_SET_BYTES) {
    s = s.write("    ldr x3, [x0]\n    add x0, x0, #8\n");
  } else {
    s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
  }
  s = s.write("    cmp x1, #0\n    b.ge " + l_from_ok + "\n    mov x1, #0\n");
  s = s.write(l_from_ok + ":\n    adrp x9, " + tables + "\n    add x9, x9, :lo12:" + tables + "\n");
  s = s.write("    add x5, x0, x1\n    add x6, x0, x3\n    sub x8, x6, #16\n");
  s = s.write("    cmp x5, x8\n    b.hi " + l_tail + "\n");
  let shape = asmcore.scan_set_shape(o.str);
  s = s.write(scan_set_setup(shape));
  s = s.write(l_loop + ":\n    ldr q0, [x5]\n" + scan_set_classify(shape));
  s = s.write("    shrn v1.8b, v1.8h, #4\n    fmov x7, d1\n    cbnz x7, " + l_hit16 + "\n");
  s = s.write("    add x5, x5, #16\n    cmp x5, x8\n    b.ls " + l_loop + "\n");
  s = s.write("    sub x1, x5, x0\n    b " + l_tail + "\n");
  s = s.write(l_hit16 + ":\n    rbit x7, x7\n    clz x7, x7\n    lsr x7, x7, #2\n");
  s = s.write("    sub x1, x5, x0\n    add x1, x1, x7\n    b " + l_hit + "\n");
  s = s.write(l_tail + ":\n    add x10, x9, #96\n");
  s = s.write(l_byte + ":\n    cmp x1, x3\n    b.ge " + l_end + "\n");
  s = s.write("    ldrb w6, [x0, x1]\n    ldrb w7, [x10, x6]\n    cbnz w7, " + l_hit + "\n");
  s = s.write("    add x1, x1, #1\n    b " + l_byte + "\n");
  s = s.write(l_hit + ":\n    str x1, [sp, #-16]!\n    b " + l_done + "\n");
  s = s.write(l_end + ":\n    str x3, [sp, #-16]!\n");
  return s.write(l_done + ":\n");
}

function scan_set_setup(shape: asmcore.ScanShape): string {
  if (shape.nibble) {
    return "    ldp q20, q21, [x9]\n    ldr q22, [x9, #32]\n    movi v26.16b, #128\n    movi v27.16b, #143\n";
  }
  let r = "";
  let j = 0;
  while (j < shape.bytes.len()) {
    r = r + "    add x10, x9, #" + util.i32_to_string(352 + j) + "\n    ld1r {v" + util.i32_to_string(20 + j) + ".16b}, [x10]\n";
    j += 1;
  }
  return r;
}

function scan_set_classify(shape: asmcore.ScanShape): string {
  let r = "";
  if (shape.nibble) {
    r = "    and v1.16b, v0.16b, v27.16b\n    eor v2.16b, v0.16b, v26.16b\n    and v2.16b, v2.16b, v27.16b\n"
      + "    tbl v1.16b, {v20.16b}, v1.16b\n    tbl v2.16b, {v21.16b}, v2.16b\n    orr v1.16b, v1.16b, v2.16b\n"
      + "    ushr v2.16b, v0.16b, #4\n    tbl v2.16b, {v22.16b}, v2.16b\n    cmtst v1.16b, v1.16b, v2.16b\n";
    return r;
  }
  let j = 1;
  if (shape.range) {
    r = "    sub v1.16b, v0.16b, v20.16b\n    cmhs v1.16b, v21.16b, v1.16b\n";
    j = 2;
  } else {
    r = "    cmeq v1.16b, v0.16b, v20.16b\n";
  }
  while (j < shape.bytes.len()) {
    r = r + "    cmeq v2.16b, v0.16b, v" + util.i32_to_string(20 + j) + ".16b\n    orr v1.16b, v1.16b, v2.16b\n";
    j += 1;
  }
  if (shape.invert) {
    r += "    mvn v1.16b, v1.16b\n";
  }
  return r;
}

function set_entry_indexed(o: ir.Op): string {
  if (ir.is_packed(o)) {
    return "ldrb w7, [x10, x6]";
  }
  return "ldr x7, [x10, x6, lsl #3]";
}

function emit_mismatch_arm64(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let mlo = asmcore.fresh_label(s);
  let lb = mlo.name;
  s = mlo.state;
  s = s.write("    ldr x4, [sp], #16\n    ldr x3, [sp], #16\n    ldr x2, [sp], #16\n");
  s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
  if (o.kind_tag == ir.K_MISMATCH_BYTES || o.kind_tag == ir.K_MISMATCH_BYTES_STR) {
    s = s.write("    ldr x5, [x0]\n    add x0, x0, #8\n");
  } else {
    s = s.write("    ldr x5, [x0, #8]\n    ldr x0, [x0]\n");
  }
  if (o.kind_tag == ir.K_MISMATCH_BYTES) {
    s = s.write("    ldr x6, [x2]\n    add x2, x2, #8\n");
  } else {
    s = s.write("    ldr x6, [x2, #8]\n    ldr x2, [x2]\n");
  }
  s = s.write("    cmp x1, #0\n    b.ge " + lb + "_aop\n    mov x1, #0\n");
  s = s.write(lb + "_aop:\n    cmp x1, x5\n    csel x1, x5, x1, gt\n");
  s = s.write("    cmp x3, #0\n    b.ge " + lb + "_bop\n    mov x3, #0\n");
  s = s.write(lb + "_bop:\n    cmp x3, x6\n    csel x3, x6, x3, gt\n");
  s = s.write("    sub x5, x5, x1\n    sub x6, x6, x3\n");
  s = s.write("    cmp x4, x5\n    csel x4, x5, x4, gt\n");
  s = s.write("    cmp x4, x6\n    csel x4, x6, x4, gt\n");
  s = s.write("    cmp x4, #0\n    b.ge " + lb + "_nok\n    mov x4, #0\n");
  s = s.write(lb + "_nok:\n");
  if (o.kind_tag == ir.K_MISMATCH_BYTES && !ir.is_packed(o)) {
    s = s.write("    add x8, x0, x1, lsl #3\n    add x9, x2, x3, lsl #3\n    mov x10, #0\n");
    s = s.write(lb + "_slots:\n    cmp x10, x4\n    b.ge " + lb + "_slots_done\n");
    s = s.write("    add x11, x8, x10, lsl #3\n    ldrb w11, [x11]\n    add x14, x9, x10, lsl #3\n    ldrb w14, [x14]\n");
    s = s.write("    cmp w11, w14\n    b.ne " + lb + "_slots_done\n    add x10, x10, #1\n    b " + lb + "_slots\n");
    return s.write(lb + "_slots_done:\n    str x10, [sp, #-16]!\n");
  }
  s = s.write("    add x8, x0, x1\n    add x9, x2, x3\n");
  s = s.write("    mov x12, x8\n    add x13, x8, x4\n");
  s = s.write(lb + "_vec:\n    sub x10, x13, x8\n    cmp x10, #16\n    b.lt " + lb + "_short\n");
  s = s.write("    ld1 {v0.16b}, [x8]\n    ld1 {v1.16b}, [x9]\n");
  s = s.write("    eor v0.16b, v0.16b, v1.16b\n    cmtst v0.16b, v0.16b, v0.16b\n");
  s = s.write("    shrn v0.8b, v0.8h, #4\n    fmov x11, d0\n");
  s = s.write("    cbz x11, " + lb + "_next\n");
  s = s.write("    rbit x11, x11\n    clz x11, x11\n    lsr x11, x11, #2\n");
  s = s.write("    add x8, x8, x11\n    sub x2, x8, x12\n    b " + lb + "_done\n");
  s = s.write(lb + "_next:\n    add x8, x8, #16\n    add x9, x9, #16\n    b " + lb + "_vec\n");
  s = s.write(lb + "_short:\n    cmp x10, #8\n    b.lt " + lb + "_w4\n");
  s = s.write("    ldr x11, [x8]\n    ldr x14, [x9]\n    eor x11, x11, x14\n");
  s = s.write("    cbnz x11, " + lb + "_w8l\n");
  s = s.write("    sub x14, x10, #8\n    ldr x11, [x8, x14]\n    ldr x15, [x9, x14]\n");
  s = s.write("    eor x11, x11, x15\n    cbz x11, " + lb + "_eq\n");
  s = s.write("    add x8, x8, x14\n");
  s = s.write(lb + "_w8l:\n    rbit x11, x11\n    clz x11, x11\n    lsr x11, x11, #3\n");
  s = s.write("    add x8, x8, x11\n    sub x2, x8, x12\n    b " + lb + "_done\n");
  s = s.write(lb + "_w4:\n    cmp x10, #4\n    b.lt " + lb + "_w2\n");
  s = s.write("    ldr w11, [x8]\n    ldr w14, [x9]\n    eor w11, w11, w14\n");
  s = s.write("    cbnz w11, " + lb + "_w4l\n");
  s = s.write("    sub x14, x10, #4\n    ldr w11, [x8, x14]\n    ldr w15, [x9, x14]\n");
  s = s.write("    eor w11, w11, w15\n    cbz w11, " + lb + "_eq\n");
  s = s.write("    add x8, x8, x14\n");
  s = s.write(lb + "_w4l:\n    rbit w11, w11\n    clz w11, w11\n    lsr w11, w11, #3\n");
  s = s.write("    add x8, x8, x11\n    sub x2, x8, x12\n    b " + lb + "_done\n");
  s = s.write(lb + "_w2:\n    cmp x10, #2\n    b.lt " + lb + "_tail\n");
  s = s.write("    ldrh w11, [x8]\n    ldrh w14, [x9]\n    eor w11, w11, w14\n");
  s = s.write("    cbnz w11, " + lb + "_w2l\n");
  s = s.write("    sub x14, x10, #2\n    ldrh w11, [x8, x14]\n    ldrh w15, [x9, x14]\n");
  s = s.write("    eor w11, w11, w15\n    cbz w11, " + lb + "_eq\n");
  s = s.write("    add x8, x8, x14\n");
  s = s.write(lb + "_w2l:\n    rbit w11, w11\n    clz w11, w11\n    lsr w11, w11, #3\n");
  s = s.write("    add x8, x8, x11\n    sub x2, x8, x12\n    b " + lb + "_done\n");
  s = s.write(lb + "_tail:\n    cmp x8, x13\n    b.ge " + lb + "_eq\n");
  s = s.write("    ldrb w11, [x8]\n    ldrb w14, [x9]\n    cmp w11, w14\n");
  s = s.write("    b.ne " + lb + "_th\n");
  s = s.write("    add x8, x8, #1\n    add x9, x9, #1\n    b " + lb + "_tail\n");
  s = s.write(lb + "_th:\n    sub x2, x8, x12\n    b " + lb + "_done\n");
  s = s.write(lb + "_eq:\n    mov x2, x4\n");
  s = s.write(lb + "_done:\n    str x2, [sp, #-16]!\n");
  return s;
}

function emit_outer_mul_f64(s: asmcore.EmitState): asmcore.EmitState {
  let a = asmcore.fresh_label(s);
  let b = asmcore.fresh_label(a.state);
  let c = asmcore.fresh_label(b.state);
  let d = asmcore.fresh_label(c.state);
  s = d.state;
  s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    stp x1, x2, [sp, #-16]!\n");
  s = s.write("    ldr x3, [x1]\n    ldr x4, [x2]\n    mul x0, x3, x4\n    mov x5, #1\n    lsl x5, x5, #31\n    sub x5, x5, #1\n    cmp x0, x5\n");
  s = ssa_trap_guard(s, CC_LS, "__fern_oob_abort");
  s = s.write("    bl __fern_arr_box\n    ldp x1, x2, [sp], #16\n    ldr x4, [x1]\n    ldr x5, [x2]\n    add x7, x0, #8\n    mov x3, #0\n    cmp x5, #0\n    b.eq " + d.name + "\n    and x8, x5, #-2\n");
  s = s.write(a.name + ":\n    cmp x3, x4\n    b.ge " + d.name + "\n");
  s = s.write("    add x9, x1, x3, lsl #3\n    ldr x10, [x9, #8]\n    dup v1.2d, x10\n    mov x6, #0\n");
  s = s.write(b.name + ":\n    cmp x6, x8\n    b.ge " + c.name + "\n");
  s = s.write("    add x9, x2, x6, lsl #3\n    add x9, x9, #8\n    ld1 {v0.2d}, [x9]\n    fmul v2.2d, v1.2d, v0.2d\n    st1 {v2.2d}, [x7]\n    add x7, x7, #16\n    add x6, x6, #2\n    b " + b.name + "\n");
  s = s.write(c.name + ":\n    cmp x6, x5\n    b.ge " + c.name + "_next\n");
  s = s.write("    add x9, x2, x6, lsl #3\n    add x9, x9, #8\n    ldr d0, [x9]\n    fmul d2, d1, d0\n    str d2, [x7]\n    add x7, x7, #8\n");
  s = s.write(c.name + "_next:\n    add x3, x3, #1\n    b " + a.name + "\n");
  s = s.write(d.name + ":\n    str x0, [sp, #-16]!\n");
  return s.need("heap");
}

function emit_inner_mul_add_f64(s: asmcore.EmitState): asmcore.EmitState {
  let label = asmcore.fresh_label(s);
  s = label.state;
  let lb = label.name;
  s = s.write("    ldr x6, [sp], #16\n    ldr x5, [sp], #16\n    ldr x4, [sp], #16\n    ldr x3, [sp], #16\n    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n");
  s = s.write("    cmp w3, #0\n");
  s = ssa_trap_guard(s, CC_GE, "__fern_oob_abort");
  s = s.write("    cmp w4, #0\n");
  s = ssa_trap_guard(s, CC_GE, "__fern_oob_abort");
  s = s.write("    cmp w5, #0\n");
  s = ssa_trap_guard(s, CC_GE, "__fern_oob_abort");
  s = s.write("    mov w3, w3\n    mov w4, w4\n    mov w5, w5\n");
  s = s.write("    mul x7, x3, x4\n    ldr x8, [x1]\n    cmp x7, x8\n");
  s = ssa_trap_guard(s, CC_EQ, "__fern_oob_abort");
  s = s.write("    mul x7, x4, x5\n    ldr x8, [x2]\n    cmp x7, x8\n");
  s = ssa_trap_guard(s, CC_EQ, "__fern_oob_abort");
  s = s.write("    mul x0, x3, x5\n    mov x8, #1\n    lsl x8, x8, #31\n    sub x8, x8, #1\n    cmp x0, x8\n");
  s = ssa_trap_guard(s, CC_LS, "__fern_oob_abort");
  s = s.write("    stp x1, x2, [sp, #-16]!\n    stp x3, x4, [sp, #-16]!\n    stp x5, x6, [sp, #-16]!\n    bl __fern_arr_box\n    ldp x5, x6, [sp], #16\n    ldp x3, x4, [sp], #16\n    ldp x1, x2, [sp], #16\n");
  s = s.write("    cmp x3, #0\n    b.eq " + lb + "_done\n    cmp x5, #0\n    b.eq " + lb + "_done\n    add x7, x1, #8\n    add x8, x0, #8\n    add x2, x2, #8\n    dup v3.2d, x6\n");
  s = s.write(lb + "_row:\n    mov x9, #0\n" + lb + "_pair:\n    add x10, x9, #1\n    cmp x10, x5\n    b.ge " + lb + "_tail\n    add x11, x2, x9, lsl #3\n    dup v2.2d, x6\n    mov x10, #0\n");
  s = s.write(lb + "_k:\n    cmp x10, x4\n    b.ge " + lb + "_store\n    ldr x12, [x7, x10, lsl #3]\n    dup v1.2d, x12\n    ld1 {v0.2d}, [x11]\n    fmul v1.2d, v1.2d, v0.2d\n    fadd v2.2d, v2.2d, v1.2d\n    add x11, x11, x5, lsl #3\n    add x10, x10, #1\n    b " + lb + "_k\n");
  s = s.write(lb + "_store:\n    st1 {v2.2d}, [x8]\n    add x8, x8, #16\n    add x9, x9, #2\n    b " + lb + "_pair\n");
  s = s.write(lb + "_tail:\n    cmp x9, x5\n    b.ge " + lb + "_next\n    add x11, x2, x9, lsl #3\n    fmov d2, d3\n    mov x10, #0\n");
  s = s.write(lb + "_scalar:\n    cmp x10, x4\n    b.ge " + lb + "_scalar_store\n    add x12, x7, x10, lsl #3\n    ldr d1, [x12]\n    ldr d0, [x11]\n    fmul d1, d1, d0\n    fadd d2, d2, d1\n    add x11, x11, x5, lsl #3\n    add x10, x10, #1\n    b " + lb + "_scalar\n");
  s = s.write(lb + "_scalar_store:\n    str d2, [x8]\n    add x8, x8, #8\n" + lb + "_next:\n    add x7, x7, x4, lsl #3\n    sub x3, x3, #1\n    cmp x3, #0\n    b.ne " + lb + "_row\n" + lb + "_done:\n    str x0, [sp, #-16]!\n");
  return s.need("heap");
}

// cmhi compares two words at a time as unsigned, and each lane of the mask it
// gives is -1 or 0, so subtracting the masks counts the words below.
function emit_count_below_u64_arm64(s: asmcore.EmitState): asmcore.EmitState {
  let lo1 = asmcore.fresh_label(s);
  let c_vec = lo1.name;
  let lo2 = asmcore.fresh_label(lo1.state);
  let c_tail = lo2.name;
  let lo3 = asmcore.fresh_label(lo2.state);
  let c_done = lo3.name;
  s = lo3.state;
  s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
  s = s.write("    ldr x3, [x0]\n    add x0, x0, #8\n    mov x2, #0\n");
  s = s.write("    dup v1.2d, x1\n    eor v3.16b, v3.16b, v3.16b\n");
  s = s.write(c_vec + ":\n    sub x4, x3, x2\n    cmp x4, #2\n    b.lt " + c_tail + "\n");
  s = s.write("    add x5, x0, x2, lsl #3\n    ld1 {v0.2d}, [x5]\n");
  s = s.write("    cmhi v0.2d, v1.2d, v0.2d\n    sub v3.2d, v3.2d, v0.2d\n");
  s = s.write("    add x2, x2, #2\n    b " + c_vec + "\n");
  s = s.write(c_tail + ":\n    umov x7, v3.d[0]\n    umov x4, v3.d[1]\n    add x7, x7, x4\n");
  s = s.write("    cmp x2, x3\n    b.ge " + c_done + "\n");
  s = s.write("    add x5, x0, x2, lsl #3\n    ldr x4, [x5]\n    cmp x4, x1\n    cinc x7, x7, lo\n");
  return s.write(c_done + ":\n    str x7, [sp, #-16]!\n");
}

function emit_str_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  if (o.kind_tag == ir.K_RET_WORD || o.kind_tag == ir.K_CALL_WORD) {
    let reg = "x" + util.i32_to_string(o.i32_imm + 1);
    if (o.kind_tag == ir.K_RET_WORD) {
      return s.write("    ldr " + reg + ", [sp], #16\n    str " + reg + ", [sp, #-16]!\n");
    }
    return s.write("    str " + reg + ", [sp, #-16]!\n");
  }
  if (o.kind_tag == ir.K_ARR_RESERVE) {
    s = s.write("    ldr x0, [sp], #16\n    cmp w0, #0\n");
    s = ssa_trap_guard(s, CC_GE, "__fern_oob_abort");
    s = s.write("    mov w0, w0\n");
    if (o.width == 8) {
      s = s.write("    add x0, x0, #7\n    lsr x0, x0, #3\n");
    }
    s = s.write("    bl __fern_arr_box\n    str xzr, [x0]\n    str x0, [sp, #-16]!\n");
    return s.need("heap");
  }
  if (o.kind_tag == ir.K_INNER_MUL_ADD_F64) {
    return emit_inner_mul_add_f64(s);
  }
  if (ir.is_aes_gcm_op(o.kind_tag)) {
    return emit_aes_gcm_op(o, s);
  }
  if (o.kind_tag == ir.K_SHA256_HW_BLOCKS) {
    s = s.need("sha256").need("heap");
    return s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    bl __fern_sha256_hw_blocks\n    str x0, [sp, #-16]!\n");
  }
  if (o.kind_tag == ir.K_OUTER_MUL_F64) {
    return emit_outer_mul_f64(s);
  }
  if (o.kind_tag == ir.K_MEMCHR || o.kind_tag == ir.K_MEMCHR_BYTES) {
    let mlo = asmcore.fresh_label(s);
    let l_clamped = mlo.name;
    let mlo2 = asmcore.fresh_label(mlo.state);
    let l_vec = mlo2.name;
    let mlo3 = asmcore.fresh_label(mlo2.state);
    let l_v16 = mlo3.name;
    let mlo4 = asmcore.fresh_label(mlo3.state);
    let l_tail = mlo4.name;
    let mlo5 = asmcore.fresh_label(mlo4.state);
    let l_hit = mlo5.name;
    let mlo6 = asmcore.fresh_label(mlo5.state);
    let l_none = mlo6.name;
    let mlo7 = asmcore.fresh_label(mlo6.state);
    let l_done = mlo7.name;
    let mlo8 = asmcore.fresh_label(mlo7.state);
    let l_hit32 = mlo8.name;
    let mlo9 = asmcore.fresh_label(mlo8.state);
    let l_lane = mlo9.name;
    let mlo10 = asmcore.fresh_label(mlo9.state);
    let l_bytes = mlo10.name;
    s = mlo10.state;
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    if (o.kind_tag == ir.K_MEMCHR_BYTES) {
      s = s.write("    ldr x3, [x0]\n    add x0, x0, #8\n");
    } else {
      s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
    }
    s = s.write("    cmp x2, #0\n    b.ge " + l_clamped + "\n    mov x2, #0\n");
    s = s.write(l_clamped + ":\n");
    s = s.write("    cmp x1, #255\n    b.hi " + l_none + "\n");
    if (o.kind_tag == ir.K_MEMCHR_BYTES && !ir.is_packed(o)) {
      s = s.write(l_tail + ":\n    cmp x2, x3\n    b.ge " + l_none + "\n");
      s = s.write("    add x5, x0, x2, lsl #3\n    ldrb w4, [x5]\n    cmp x4, x1\n    b.eq " + l_done + "\n");
      s = s.write("    add x2, x2, #1\n    b " + l_tail + "\n");
      s = s.write(l_none + ":\n    mov x2, #-1\n");
      return s.write(l_done + ":\n    str x2, [sp, #-16]!\n");
    }
    s = s.write("    cmp x2, x3\n    b.ge " + l_none + "\n");
    s = s.write("    add x5, x0, x2\n    add x6, x0, x3\n    sub x8, x6, #32\n");
    s = s.write("    dup v1.16b, w1\n");
    s = s.write("    cmp x5, x8\n    b.hi " + l_v16 + "\n");
    s = s.write(l_vec + ":\n");
    s = s.write("    ldp q0, q2, [x5], #32\n");
    s = s.write("    cmeq v0.16b, v0.16b, v1.16b\n    cmeq v2.16b, v2.16b, v1.16b\n");
    s = s.write("    orr v3.16b, v0.16b, v2.16b\n    shrn v3.8b, v3.8h, #4\n    fmov x7, d3\n");
    s = s.write("    cbnz x7, " + l_hit32 + "\n");
    s = s.write("    cmp x5, x8\n    b.ls " + l_vec + "\n");
    s = s.write(l_v16 + ":\n    sub x7, x6, x5\n    cmp x7, #16\n    b.lt " + l_tail + "\n");
    s = s.write("    ldr q0, [x5], #16\n    cmeq v0.16b, v0.16b, v1.16b\n");
    s = s.write("    shrn v0.8b, v0.8h, #4\n    fmov x7, d0\n");
    s = s.write("    cbz x7, " + l_tail + "\n    sub x5, x5, #16\n    b " + l_lane + "\n");
    s = s.write(l_hit32 + ":\n    sub x5, x5, #32\n    shrn v0.8b, v0.8h, #4\n    fmov x7, d0\n");
    s = s.write("    cbnz x7, " + l_lane + "\n");
    s = s.write("    shrn v2.8b, v2.8h, #4\n    fmov x7, d2\n    add x5, x5, #16\n");
    s = s.write(l_lane + ":\n    rbit x4, x7\n    clz x4, x4\n    lsr x4, x4, #2\n");
    s = s.write("    add x5, x5, x4\n    sub x2, x5, x0\n    b " + l_done + "\n");
    s = s.write(l_tail + ":\n");
    s = s.write("    cmp x5, x6\n    b.ge " + l_none + "\n");
    // Fewer than 16 bytes remain. One 16-byte load that stays in its page
    // covers them; a first match at or past the end is no match.
    s = s.write("    and x7, x5, #4095\n    cmp x7, #4080\n    b.hi " + l_bytes + "\n");
    s = s.write("    ld1 {v0.16b}, [x5]\n    cmeq v0.16b, v0.16b, v1.16b\n");
    s = s.write("    shrn v0.8b, v0.8h, #4\n    fmov x7, d0\n    cbz x7, " + l_none + "\n");
    s = s.write("    rbit x4, x7\n    clz x4, x4\n    lsr x4, x4, #2\n");
    s = s.write("    sub x8, x6, x5\n    cmp x4, x8\n    b.hs " + l_none + "\n");
    s = s.write("    add x5, x5, x4\n    b " + l_hit + "\n");
    s = s.write(l_bytes + ":\n");
    s = s.write("    cmp x5, x6\n    b.ge " + l_none + "\n");
    s = s.write("    ldrb w4, [x5]\n");
    s = s.write("    cmp x4, x1\n    b.eq " + l_hit + "\n");
    s = s.write("    add x5, x5, #1\n    b " + l_bytes + "\n");
    s = s.write(l_hit + ":\n    sub x2, x5, x0\n    b " + l_done + "\n");
    s = s.write(l_none + ":\n    mov x2, #-1\n");
    s = s.write(l_done + ":\n    str x2, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == ir.K_MISMATCH || o.kind_tag == ir.K_MISMATCH_BYTES || o.kind_tag == ir.K_MISMATCH_BYTES_STR) {
    return emit_mismatch_arm64(o, s);
  }
  if (o.kind_tag == ir.K_RMEMCHR || o.kind_tag == ir.K_RMEMCHR_BYTES) {
    let rlo = asmcore.fresh_label(s);
    let r_ok = rlo.name;
    let rlo2 = asmcore.fresh_label(rlo.state);
    let r_vec = rlo2.name;
    let rlo3 = asmcore.fresh_label(rlo2.state);
    let r_v16 = rlo3.name;
    let rlo4 = asmcore.fresh_label(rlo3.state);
    let r_hit32 = rlo4.name;
    let rlo5 = asmcore.fresh_label(rlo4.state);
    let r_tail = rlo5.name;
    let rlo6 = asmcore.fresh_label(rlo5.state);
    let r_loop = rlo6.name;
    let rlo7 = asmcore.fresh_label(rlo6.state);
    let r_none = rlo7.name;
    let rlo8 = asmcore.fresh_label(rlo7.state);
    let r_done = rlo8.name;
    let rlo9 = asmcore.fresh_label(rlo8.state);
    let r_lane = rlo9.name;
    s = rlo9.state;
