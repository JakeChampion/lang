function emit_rt_net(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  s = s.write(empty_array_block(".Lfern_empty_u8"));
  s = s.write(".globl __fern_alloc_u8\n");
  s = s.write(".type __fern_alloc_u8, %function\n");
  s = s.write("__fern_alloc_u8:\n");
  s = s.write("    tbz w0, #31, .Lfern_alloc_u8_sized\n    b __fern_alloc_size_abort_leaf\n.Lfern_alloc_u8_sized:\n");
  s = s.write("    cbz w0, .Lfern_alloc_u8_empty\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n");
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    mov x0, x19\n");
  s = s.write("    bl __fern_arr_box\n");
  s = s.write("    add x2, x0, #8\n");
  s = s.write("    mov w1, w19\n");
  s = s.write(".Lfern_alloc_u8_zero:\n");
  s = s.write("    cbz x1, .Lfern_alloc_u8_done\n");
  s = s.write("    str xzr, [x2], #8\n");
  s = s.write("    sub x1, x1, #1\n");
  s = s.write("    b .Lfern_alloc_u8_zero\n");
  s = s.write(".Lfern_alloc_u8_done:\n");
  s = s.write("    ldp x19, x20, [sp], #16\n");
  s = s.write("    ldp x29, x30, [sp], #16\n");
  s = s.write("    ret\n");
  s = s.write(".Lfern_alloc_u8_empty:\n    adrp x0, .Lfern_empty_u8\n    add x0, x0, :lo12:.Lfern_empty_u8\n    ret\n");
  s = s.write(".size __fern_alloc_u8, .-__fern_alloc_u8\n");

  return s;
}

function emit_rt_heap(own s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  if (s.has_need("heap")) {
    s = emit_rt_arena_and_alloc(s, darwin);
    s = emit_rt_large_tier_and_rc(s);
    s = emit_rt_fs(s, darwin);
    if (s.has_need("subprocess")) {
      if (darwin) {
        s = emit_rt_subprocess(s);
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_sp_exec_failed("arm64-darwin"), s);
      } else {
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_subprocess("arm64-linux"), s);
      }
    }
    s = emit_rt_net(s, darwin);
  }
  s = emit_lc_report(s);
  if (!s.shared) {
    s = emit_stack_overflow_runtime(s, darwin);
  }
  s = emit_rt_report(s);
  if (s.shared) {
    s = s.write("    .section .bss\n    .align 3\n__fern_busy: .skip 8\n    .text\n");
    s = abort_trap(s, "__fern_busy_abort", ".Lmsg_busy", aborts.busy(), 134);
  }
  s = emit_san_uaf_abort(s);
  s = emit_san_abort(s);
  return s;
}

