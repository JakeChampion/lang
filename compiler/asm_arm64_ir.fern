    s = emit_runtime("__fern_unix_connect", s);
  }
  if (s.has_need("reactor_new")) {
    s = emit_runtime("__fern_reactor_new", s);
  }
  if (s.has_need("reactor_ctl")) {
    s = emit_runtime("__fern_reactor_ctl", s);
  }
  if (s.has_need("reactor_wait")) {
    s = emit_runtime("__fern_reactor_wait", s);
  }
  if (s.any_need(["ring_new", "ring_ctl", "ring_wait", "ring_recv_u8", "ring_send_zc_u8"])) {
    s = emit_runtime("__fern_ring_queued __fern_ring_flush __fern_ring_push __fern_ring_entry __fern_ring_ready_at __fern_ring_zc_at __fern_ring_send_zc_u8 __fern_ring_zc_done __fern_ring_u16 __fern_ring_set16 __fern_ring_give __fern_ring_list __fern_ring_pend __fern_ring_ud __fern_ring_arm __fern_ring_unarm __fern_ring_rud __fern_ring_recv_arm __fern_ring_recv_stop __fern_ring_drop __fern_ring_enqueue __fern_ring_fall_back __fern_ring_resume __fern_ring_set __fern_ring_set_ctl __fern_ring_watch __fern_ring_new __fern_ring_ctl __fern_ring_wait __fern_ring_reap __fern_ring_recv_done __fern_ring_emit __fern_ring_emit_one __fern_ring_recv_u8 __fern_ring_set_wait", s);
  }
  if (s.has_need("tcp_ktls_u8")) {
    s = emit_runtime("__fern_tcp_ktls_u8", s);
  }
  if (s.has_need("task")) {
    s = emit_runtime(asmcore.task_runtime_roots(), asmcore.EmitState { ...s, rt_owned_allocs: true });
    s = asmcore.EmitState { ...s, rt_owned_allocs: false };
  }
  if (s.has_need("tcp_recv_into")) {
    s = emit_runtime("__fern_tcp_recv_into", s);
  }
  if (s.has_need("tcp_send_bytes")) {
    s = emit_runtime("__fern_tcp_send_bytes", s);
  }
  if (s.has_need("tcp_send_bytes_u8")) {
    s = emit_runtime("__fern_tcp_send_bytes_u8", s);
  }
  if (s.has_need("udp_sendto_bytes")) {
    s = emit_runtime("__fern_udp_sendto_bytes", s);
  }
  if (s.has_need("udp_sendto_bytes_u8")) {
    s = emit_runtime("__fern_udp_sendto_bytes_u8", s);
  }
  if (s.has_need("udp_sendmmsg")) {
    s = emit_runtime("__fern_udp_sendmmsg", s);
  }
  if (s.has_need("udp_sendmmsg_u8")) {
    s = emit_runtime("__fern_udp_sendmmsg_u8", s);
  }
  if (s.has_need("udp_recvmmsg")) {
    s = emit_runtime("__fern_udp_recvmmsg", s);
  }
  if (s.has_need("udp_recvmmsg_u8")) {
    s = emit_runtime("__fern_udp_recvmmsg_u8", s);
  }
  if (s.has_need("proc_exec")) {
    s = emit_runtime("__fern_proc_exec", s);
  }
  if (s.has_need("proc_exec_as")) {
    s = emit_runtime("__fern_proc_exec_as", s);
  }
  if (s.has_need("map_hash_seed")) {
    s = s.write(".globl __fern_map_hash_seed\n");
    s = s.write(".type __fern_map_hash_seed, %function\n");
    s = s.write("__fern_map_hash_seed:\n");
    s = s.write("    adrp x1, __fern_map_seed\n");
    s = s.write("    add x1, x1, :lo12:__fern_map_seed\n");
    s = s.write("    ldr w0, [x1]\n");
    s = s.write("    cbnz w0, .Lmapseed_ret\n");
    s = s.write(rt_frame(s));
    s = s.write("    bl __fn___fern_random_i32\n");
    s = s.write("    orr w0, w0, #1\n");
    s = s.write("    adrp x1, __fern_map_seed\n");
    s = s.write("    add x1, x1, :lo12:__fern_map_seed\n");
    s = s.write("    str w0, [x1]\n");
    s = s.write(rt_unframe(s));
    s = s.write(".Lmapseed_ret:\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_hash_seed, .-__fern_map_hash_seed\n");
  }
  if (s.has_need("proc_fork")) {
    if (darwin) {
      s = s.write(".globl __fn___fern_proc_fork\n");
      s = s.write(".type __fn___fern_proc_fork, %function\n");
      s = s.write("__fn___fern_proc_fork:\n");
      s = s.write(rt_frame(s));
      s = s.write("    mov x29, sp\n");
      s = s.write("    mov x16, #2\n");
      s = s.write("    svc #0x80\n");
      s = s.write("    b.cc .Lpf_ok\n");
      s = s.write("    neg x0, x0\n");
      s = s.write("    b .Lpf_done\n");
      s = s.write(".Lpf_ok:\n");
      s = s.write("    cbz x1, .Lpf_done\n");
      s = s.write("    mov x0, #0\n");
      s = s.write(".Lpf_done:\n");
      s = s.write(rt_unframe(s));
      s = s.write("    ret\n");
      s = s.write(".size __fn___fern_proc_fork, .-__fn___fern_proc_fork\n");
    } else {
      s = emit_runtime("__fern_proc_fork", s);
    }
  }
  if (darwin && s.has_need("pipe")) {
    s = s.write(".globl __fn___fern_pipe\n");
    s = s.write("__fn___fern_pipe:\n");
    s = s.write(rt_frame(s));
    s = s.write("    mov x29, sp\n");
    s = s.write("    mov x16, #42\n");
    s = s.write("    svc #0x80\n");
    s = s.write("    mov x9, #0\n");
    s = s.write("    mov x10, x0\n");
    s = s.write("    mov x11, x1\n");
    s = s.write("    b.cc .Lpp_call\n");
    s = s.write("    neg x9, x0\n");
    s = s.write(".Lpp_call:\n");
    s = s.write("    sub sp, sp, #48\n");
    s = s.write("    str x9, [sp]\n");
    s = s.write("    str x10, [sp, #16]\n");
    s = s.write("    str x11, [sp, #32]\n");
    s = s.write("    bl __fn___fern_pipe_from\n");
    s = s.write("    add sp, sp, #48\n");
    s = s.write(rt_unframe(s));
    s = s.write("    ret\n");
  }
  return s;
}

function emit_rt_signal_flags(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  if (!s.any_need(["signal_catch", "signal_taken"])) {
    return s;
  }
  s = s.write("    .section .bss\n    .align 3\n__fern_sig_flags: .skip 65\n    .text\n");
  if (s.has_need("signal_catch")) {
    s = s.write("    .global __fern_sig_catcher\n    .global __fern_sig_return\n__fern_sig_catcher:\n" + landing_pad(s));
    s = s.write("    adrp x1, __fern_sig_flags\n    add x1, x1, :lo12:__fern_sig_flags\n    sxtw x0, w0\n    add x1, x1, x0\n    mov w2, #1\n    strb w2, [x1]\n    ret\n");
    s = s.write("__fern_sig_return:\n");
    if (darwin) {
      s = s.write("    mov x19, x1\n    mov x20, x4\n    mov x21, x5\n    mov x16, x0\n    mov x0, x2\n    mov x1, x3\n    mov x2, x4\n    blr x16\n");
      s = s.write("    mov x0, x20\n    mov x1, x19\n    mov x2, x21\n    mov x16, #184\n    svc #0x80\n    brk #1\n");
    } else {
      s = s.write("    mov x8, #139\n").svc(139);
    }
  }
  if (s.has_need("signal_taken")) {
    s = s.write("    .arch_extension lse\n    .global __fern_signal_taken\n    .type __fern_signal_taken, %function\n__fern_signal_taken:\n");
    s = s.write("    sub w1, w0, #1\n    cmp w1, #63\n    b.hi .Lsig_taken_none\n    adrp x1, __fern_sig_flags\n    add x1, x1, :lo12:__fern_sig_flags\n    sxtw x0, w0\n    add x1, x1, x0\n");
    s = s.write("    mov w2, #0\n    swpalb w2, w0, [x1]\n    ret\n.Lsig_taken_none:\n    mov w0, #0\n    ret\n");
  }
  return s;
}

function emit_rt_utf8_blocks(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(asmcore.utf8_tables("__fern_utf8_tables"));
  s = s.write("    .text\n    .global __fern_utf8_blocks\n    .type __fern_utf8_blocks, %function\n__fern_utf8_blocks:\n");
  s = s.write("    adrp x9, __fern_utf8_tables\n    add x9, x9, :lo12:__fern_utf8_tables\n");
  s = s.write("    ldp q16, q17, [x9]\n    ldp q18, q19, [x9, #32]\n");
  s = s.write("    movi v20.16b, #224\n    movi v21.16b, #240\n    movi v22.16b, #128\n    movi v23.16b, #0\n");
  s = s.write("    mov x3, x1\n    sub x4, x2, #16\n");
  s = s.write(".Lutf8_loop:\n    cmp x3, x4\n    b.gt .Lutf8_done\n    add x5, x0, x3\n");
  s = s.write("    ldr q0, [x5]\n    ldur q3, [x5, #-3]\n    orr v4.16b, v0.16b, v3.16b\n");
  s = s.write("    umaxv b4, v4.16b\n    umov w6, v4.b[0]\n    cmp w6, #128\n    b.lo .Lutf8_next\n");
  s = s.write("    ldur q1, [x5, #-1]\n    ldur q2, [x5, #-2]\n");
  s = s.write("    ushr v4.16b, v1.16b, #4\n    tbl v4.16b, {v16.16b}, v4.16b\n");
  s = s.write("    and v5.16b, v1.16b, v19.16b\n    tbl v5.16b, {v17.16b}, v5.16b\n    and v4.16b, v4.16b, v5.16b\n");
  s = s.write("    ushr v5.16b, v0.16b, #4\n    tbl v5.16b, {v18.16b}, v5.16b\n    and v4.16b, v4.16b, v5.16b\n");
  s = s.write("    cmhs v5.16b, v2.16b, v20.16b\n    cmhs v6.16b, v3.16b, v21.16b\n    orr v5.16b, v5.16b, v6.16b\n");
  s = s.write("    and v5.16b, v5.16b, v22.16b\n    eor v4.16b, v4.16b, v5.16b\n    orr v23.16b, v23.16b, v4.16b\n");
  s = s.write(".Lutf8_next:\n    add x3, x3, #16\n    b .Lutf8_loop\n");
  s = s.write(".Lutf8_done:\n    umaxv b23, v23.16b\n    umov w6, v23.b[0]\n    cbnz w6, .Lutf8_bad\n");
  s = s.write(".Lutf8_back:\n    cmp x3, x1\n    b.le .Lutf8_ret\n    add x5, x0, x3\n    ldurb w6, [x5, #-1]\n");
  s = s.write("    cmp w6, #128\n    b.lo .Lutf8_ret\n    sub x3, x3, #1\n    cmp w6, #192\n    b.hs .Lutf8_ret\n    b .Lutf8_back\n");
  s = s.write(".Lutf8_bad:\n    mov x3, #-1\n.Lutf8_ret:\n    mov x0, x3\n    ret\n    .size __fern_utf8_blocks, .-__fern_utf8_blocks\n");
  return s;
}

function emit_rt_sum_bytes(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .global __fern_sum_bytes\n");
  s = s.write("    .type __fern_sum_bytes, %function\n");
  s = s.write("__fern_sum_bytes:\n");
  s = s.write("    ldr x6, [x0, #8]\n");
  s = s.write("    ldr x8, [x0]\n");
  s = s.write("__fern_sum_bytes_data:\n");
  s = s.write("    add x9, x8, x6\n");
  s = s.write("    mov w0, #0\n");
  s = s.write("    movi v2.4s, #0\n");
  s = s.write(".Lsum_bytes_vec:\n");
  s = s.write("    sub x10, x9, x8\n");
  s = s.write("    cmp x10, #16\n");
  s = s.write("    b.lt .Lsum_bytes_fold\n");
  s = s.write("    ld1 {v0.16b}, [x8]\n");
  s = s.write("    uaddlp v1.8h, v0.16b\n");
  s = s.write("    uadalp v2.4s, v1.8h\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    b .Lsum_bytes_vec\n");
  s = s.write(".Lsum_bytes_fold:\n");
  s = s.write("    addv s0, v2.4s\n");
  s = s.write("    fmov w0, s0\n");
  s = s.write(".Lsum_bytes_tail:\n");
  s = s.write("    cmp x8, x9\n");
  s = s.write("    b.hs .Lsum_bytes_ret\n");
  s = s.write("    ldrb w10, [x8]\n");
  s = s.write("    add w0, w0, w10\n");
  s = s.write("    add x8, x8, #1\n");
  s = s.write("    b .Lsum_bytes_tail\n");
  s = s.write(".Lsum_bytes_ret:\n");
  s = s.write("    ret\n");
  s = s.write("    .size __fern_sum_bytes, .-__fern_sum_bytes\n");
  return s;
}

function a64_aes_view(arg: string, data: string, len: string, tag: string): string {
  return "    tst " + arg + ", #2\n    b.eq " + tag + "_arr\n    sub " + data + ", " + arg + ", #2\n"
    + "    ldr " + len + ", [" + data + ", #8]\n    ldr " + data + ", [" + data + "]\n    b " + tag + "_ok\n"
    + tag + "_arr:\n    ldr " + len + ", [" + arg + "]\n    add " + data + ", " + arg + ", #8\n" + tag + "_ok:\n";
}

function a64_aes_alloc(slot: string): string {
  return "    str x0, [x29, #" + slot + "]\n    add x0, x0, #7\n    lsr x0, x0, #3\n    bl __fern_arr_box\n"
    + "    ldr x1, [x29, #" + slot + "]\n    str x1, [x0]\n    str x0, [x29, #" + slot + "]\n";
}

function a64_aes_subword(src: string, dst: string): string {
  return "    dup v16.4s, " + src + "\n    aese v16.16b, v17.16b\n    umov " + dst + ", v16.s[0]\n";
}

function a64_aes_fold4(t: string, w: string[], off: i32): string {
  return "    eor " + w[0] + ", " + w[0] + ", " + t + "\n    eor " + w[1] + ", " + w[1] + ", " + w[0] + "\n"
    + "    eor " + w[2] + ", " + w[2] + ", " + w[1] + "\n    eor " + w[3] + ", " + w[3] + ", " + w[2] + "\n"
    + "    stp " + w[0] + ", " + w[1] + ", [x3, #" + util.i32_to_string(off) + "]\n    stp " + w[2] + ", " + w[3] + ", [x3, #" + util.i32_to_string(off + 8) + "]\n";
}

function a64_aes_rot_step(src: string, w: string[], rcon: i32, off: i32): string {
  return a64_aes_subword(src, "w12") + "    ror w12, w12, #8\n    mov w13, #" + util.i32_to_string(rcon) + "\n    eor w12, w12, w13\n" + a64_aes_fold4("w12", w, off);
}

function a64_aes_schedule128(): string {
  let o = ".Laesk_128:\n    ldp w4, w5, [x1]\n    ldp w6, w7, [x1, #8]\n    stp w4, w5, [x3]\n    stp w6, w7, [x3, #8]\n";
  let rcon: i32[] = [1, 2, 4, 8, 16, 32, 64, 128, 27, 54];
  let i = 0;
  while (i < 10) {
    o += a64_aes_rot_step("w7", ["w4", "w5", "w6", "w7"], rcon[i], 16 * (i + 1));
    i += 1;
  }
  return o + "    b .Laesk_ret\n";
}

function a64_aes_schedule256(): string {
  let o: string = ".Laesk_256:\n    ldp w4, w5, [x1]\n    ldp w6, w7, [x1, #8]\n    ldp w8, w9, [x1, #16]\n    ldp w10, w11, [x1, #24]\n"
    + "    stp w4, w5, [x3]\n    stp w6, w7, [x3, #8]\n    stp w8, w9, [x3, #16]\n    stp w10, w11, [x3, #24]\n";
  let rcon: i32[] = [1, 2, 4, 8, 16, 32, 64];
  let i = 1;
  while (i <= 7) {
    o += a64_aes_rot_step("w11", ["w4", "w5", "w6", "w7"], rcon[i - 1], 32 * i);
    if (i < 7) {
      o = o + a64_aes_subword("w7", "w12") + a64_aes_fold4("w12", ["w8", "w9", "w10", "w11"], 32 * i + 16);
    }
    i += 1;
  }
  return o + "    b .Laesk_ret\n";
}

function a64_aes_expand_key(s: asmcore.EmitState): string {
  return "    .global __fern_aes_expand_key\n    .type __fern_aes_expand_key, %function\n__fern_aes_expand_key:\n"
    + rt_frame_of(s, 48) + "    mov x29, sp\n" + a64_aes_view("x0", "x3", "x4", ".Laesk_key")
    + "    str x3, [x29, #16]\n    mov x0, #0\n    cmp x4, #16\n    b.ne .Laesk_n32\n    mov x0, #176\n.Laesk_n32:\n"
    + "    cmp x4, #32\n    b.ne .Laesk_box\n    mov x0, #240\n.Laesk_box:\n" + a64_aes_alloc("32")
    + "    ldr x5, [x0]\n    ldr x1, [x29, #16]\n    add x3, x0, #8\n    movi v17.2d, #0\n"
    + "    cmp x5, #176\n    b.eq .Laesk_128\n    cmp x5, #240\n    b.eq .Laesk_256\n    b .Laesk_ret\n"
    + a64_aes_schedule128() + a64_aes_schedule256()
    + ".Laesk_ret:\n    ldr x0, [x29, #32]\n" + rt_unframe_of(s, 48) + "    ret\n    .size __fern_aes_expand_key, .-__fern_aes_expand_key\n";
}

function a64_aes_rounds(label: string, n: i32): string {
  let o = label + ":\n";
  let r = 0;
  while (r < 13) {
    if (r == 9) {
      o = o + "    cmp x7, #14\n    b.eq " + label + "_256\n" + a64_aes_last(n, 25) + "    ret\n" + label + "_256:\n";
    }
    let j = 0;
    while (j < n) {
      let v = "v" + util.i32_to_string(j) + ".16b";
      o = o + "    aese " + v + ", v" + util.i32_to_string(16 + r) + ".16b\n    aesmc " + v + ", " + v + "\n";
      j += 1;
    }
    r += 1;
  }
  return o + a64_aes_last(n, 29) + "    ret\n";
}

function a64_aes_last(n: i32, k: i32): string {
  let o = "";
  let j = 0;
  while (j < n) {
    let v = "v" + util.i32_to_string(j) + ".16b";
    o = o + "    aese " + v + ", v" + util.i32_to_string(k) + ".16b\n    eor " + v + ", " + v + ", v" + util.i32_to_string(k + 1) + ".16b\n";
    j += 1;
  }
  return o;
}

function a64_aes_counter(j: i32): string {
  return "    rev32 v" + util.i32_to_string(j) + ".16b, v6.16b\n    add v6.4s, v6.4s, v7.4s\n";
}

function a64_aes_xor_out(j: i32): string {
  let v = "v" + util.i32_to_string(j) + ".16b";
  return "    ld1 {v4.16b}, [x1]\n    eor " + v + ", " + v + ", v4.16b\n    st1 {" + v + "}, [x2]\n    add x1, x1, #16\n    add x2, x2, #16\n";
}

function a64_aes_ctr_blocks(): string {
  return a64_aes_ctr_blocks_at(".Lctr", ".Lctr_ret", 80);
}

function a64_aes_ctr_blocks_at(p: string, done: string, tail: i32): string {
  let o = p + "_loop4:\n    cmp x4, #64\n    b.lo " + p + "_loop1\n";
  let j = 0;
  while (j < 4) {
    o += a64_aes_counter(j);
    j += 1;
  }
  o += "    bl .Lctr_enc4\n";
  j = 0;
  while (j < 4) {
    o += a64_aes_xor_out(j);
    j += 1;
  }
  o = o + "    sub x4, x4, #64\n    b " + p + "_loop4\n" + p + "_loop1:\n    cmp x4, #16\n    b.lo " + p + "_tail\n" + a64_aes_counter(0) + "    bl .Lctr_enc1\n"
    + a64_aes_xor_out(0) + "    sub x4, x4, #16\n    b " + p + "_loop1\n";
  return o + p + "_tail:\n    cbz x4, " + done + "\n" + a64_aes_counter(0) + "    bl .Lctr_enc1\n    add x5, x29, #" + util.i32_to_string(tail) + "\n    st1 {v0.16b}, [x5]\n    mov x6, #0\n"
    + p + "_tailb:\n    ldrb w9, [x1, x6]\n    ldrb w10, [x5, x6]\n    eor w9, w9, w10\n    strb w9, [x2, x6]\n    add x6, x6, #1\n    cmp x6, x4\n    b.lo " + p + "_tailb\n    b " + done + "\n";
}

function a64_aes_load_keys(): string {
  return a64_aes_load_keys_at(".Lctr_keys");
}

function a64_aes_load_keys_at(label: string): string {
  let o = "";
  let r = 0;
  while (r < 15) {
    if (r == 11) {
      o = o + "    cmp x7, #14\n    b.ne " + label + "\n";
    }
    o = o + "    ld1 {v" + util.i32_to_string(16 + r) + ".16b}, [x8]\n    add x8, x8, #16\n";
    r += 1;
  }
  return o + label + ":\n";
}

function a64_aes_ctr32(s: asmcore.EmitState): string {
  let o: string = "    .global __fern_aes_ctr32\n    .type __fern_aes_ctr32, %function\n__fern_aes_ctr32:\n"
    + rt_frame_of(s, 112) + "    mov x29, sp\n"
    + a64_aes_view("x2", "x3", "x4", ".Lctr_data") + "    str x3, [x29, #16]\n    str x4, [x29, #24]\n"
    + a64_aes_view("x1", "x3", "x5", ".Lctr_ctr") + "    str x3, [x29, #32]\n"
    + a64_aes_view("x0", "x3", "x6", ".Lctr_rk") + "    str x3, [x29, #40]\n";
  o = o + "    mov x7, #0\n    cmp x6, #176\n    b.lo .Lctr_rounds\n    mov x7, #10\n    cmp x6, #240\n    b.lo .Lctr_rounds\n    mov x7, #14\n.Lctr_rounds:\n"
    + "    cmp x5, #16\n    b.hs .Lctr_ctrok\n    mov x7, #0\n.Lctr_ctrok:\n    str x7, [x29, #48]\n    ldr x0, [x29, #24]\n    cbnz x7, .Lctr_box\n    mov x0, #0\n.Lctr_box:\n"
    + a64_aes_alloc("64") + "    ldr x4, [x0]\n    cbz x4, .Lctr_ret\n    add x2, x0, #8\n    ldr x1, [x29, #16]\n    ldr x8, [x29, #40]\n    ldr x7, [x29, #48]\n    ldr x3, [x29, #32]\n"
    + a64_aes_load_keys() + "    ld1 {v6.16b}, [x3]\n    rev32 v6.16b, v6.16b\n    movi v7.2d, #0\n    mov w9, #1\n    ins v7.s[3], w9\n";
  return o + a64_aes_ctr_blocks() + a64_aes_rounds(".Lctr_enc4", 4) + a64_aes_rounds(".Lctr_enc1", 1)
    + ".Lctr_ret:\n    ldr x0, [x29, #64]\n" + rt_unframe_of(s, 112) + "    ret\n    .size __fern_aes_ctr32, .-__fern_aes_ctr32\n";
}

function a64_ghash_rev(v: string): string {
  return "    rev64 " + v + ".16b, " + v + ".16b\n    ext " + v + ".16b, " + v + ".16b, " + v + ".16b, #8\n";
}

function a64_ghash_mul(): string {
  return ".Lgh_mul:\n    ext v20.16b, v1.16b, v1.16b, #8\n    pmull v3.1q, v0.1d, v1.1d\n    pmull v4.1q, v0.1d, v20.1d\n"
    + "    pmull2 v5.1q, v0.2d, v20.2d\n    pmull2 v6.1q, v0.2d, v1.2d\n    eor v4.16b, v4.16b, v5.16b\n" + a64_ghash_reduce() + "    ret\n";
}

function a64_ghash_reduce(): string {
  return "    ext v5.16b, v31.16b, v4.16b, #8\n    ext v4.16b, v4.16b, v31.16b, #8\n    eor v3.16b, v3.16b, v5.16b\n    eor v6.16b, v6.16b, v4.16b\n"
    + "    ushr v7.4s, v3.4s, #31\n    ushr v16.4s, v6.4s, #31\n    shl v3.4s, v3.4s, #1\n    shl v6.4s, v6.4s, #1\n"
    + "    ext v17.16b, v7.16b, v31.16b, #12\n    ext v16.16b, v31.16b, v16.16b, #12\n    ext v7.16b, v31.16b, v7.16b, #12\n"
    + "    orr v3.16b, v3.16b, v7.16b\n    orr v6.16b, v6.16b, v16.16b\n    orr v6.16b, v6.16b, v17.16b\n"
    + "    shl v7.4s, v3.4s, #31\n    shl v16.4s, v3.4s, #30\n    shl v17.4s, v3.4s, #25\n    eor v7.16b, v7.16b, v16.16b\n    eor v7.16b, v7.16b, v17.16b\n"
    + "    ext v16.16b, v7.16b, v31.16b, #4\n    ext v7.16b, v31.16b, v7.16b, #4\n    eor v3.16b, v3.16b, v7.16b\n"
    + "    ushr v2.4s, v3.4s, #1\n    ushr v4.4s, v3.4s, #2\n    ushr v5.4s, v3.4s, #7\n    eor v2.16b, v2.16b, v4.16b\n    eor v2.16b, v2.16b, v5.16b\n"
    + "    eor v2.16b, v2.16b, v16.16b\n    eor v3.16b, v3.16b, v2.16b\n    eor v0.16b, v6.16b, v3.16b\n";
}

function a64_ghash_prod(x: string, hk: string, first: boolean): string {
  let o: string = "    pmull v2.1q, " + x + ".1d, " + hk + ".1d\n    pmull2 v5.1q, " + x + ".2d, " + hk + ".2d\n    ext v20.16b, " + hk + ".16b, " + hk + ".16b, #8\n"
    + "    pmull v7.1q, " + x + ".1d, v20.1d\n    pmull2 v16.1q, " + x + ".2d, v20.2d\n";
  if (first) {
    return o + "    mov v3.16b, v2.16b\n    mov v6.16b, v5.16b\n    eor v4.16b, v7.16b, v16.16b\n";
  }
  return o + "    eor v3.16b, v3.16b, v2.16b\n    eor v6.16b, v6.16b, v5.16b\n    eor v4.16b, v4.16b, v7.16b\n    eor v4.16b, v4.16b, v16.16b\n";
}

function a64_ghash_blocks4_at(p: string): string {
  let o: string = "    cmp x4, #64\n    b.lo " + p + "_loop\n    mov v19.16b, v0.16b\n    mov v0.16b, v1.16b\n"
    + "    bl .Lgh_mul\n    mov v21.16b, v0.16b\n    bl .Lgh_mul\n    mov v22.16b, v0.16b\n    bl .Lgh_mul\n    mov v23.16b, v0.16b\n    mov v0.16b, v19.16b\n"
    + p + "_loop4:\n    cmp x4, #64\n    b.lo " + p + "_loop\n    ldp q24, q25, [x1]\n    ldp q26, q27, [x1, #32]\n    add x1, x1, #64\n    sub x4, x4, #64\n"
    + a64_ghash_rev("v24") + a64_ghash_rev("v25") + a64_ghash_rev("v26") + a64_ghash_rev("v27") + "    eor v24.16b, v24.16b, v0.16b\n";
  return o + a64_ghash_prod("v24", "v23", true) + a64_ghash_prod("v25", "v22", false) + a64_ghash_prod("v26", "v21", false) + a64_ghash_prod("v27", "v1", false)
    + a64_ghash_reduce() + "    b " + p + "_loop4\n";
}

function a64_ghash_blocks_at(p: string, done: string, pad: i32): string {
  let o: string = a64_ghash_blocks4_at(p) + p + "_loop:\n    cmp x4, #16\n    b.lo " + p + "_tail\n    ld1 {v2.16b}, [x1]\n" + a64_ghash_rev("v2") + "    eor v0.16b, v0.16b, v2.16b\n    bl .Lgh_mul\n"
    + "    add x1, x1, #16\n    sub x4, x4, #16\n    b " + p + "_loop\n";
  return o + p + "_tail:\n    cbz x4, " + done + "\n    add x5, x29, #" + util.i32_to_string(pad) + "\n    st1 {v31.16b}, [x5]\n    mov x6, #0\n"
    + p + "_tailb:\n    ldrb w9, [x1, x6]\n    strb w9, [x5, x6]\n    add x6, x6, #1\n    cmp x6, x4\n    b.lo " + p + "_tailb\n"
    + "    ld1 {v2.16b}, [x5]\n" + a64_ghash_rev("v2") + "    eor v0.16b, v0.16b, v2.16b\n    bl .Lgh_mul\n";
}

// The in-place pair, as on x86-64: x0 rk, x1 h, x2 iv (views), x3 seq, x4 buf, x5 aad_at, x6 aad_n, x7 at, x8 n.
function a64_aes_gcm(s: asmcore.EmitState, seal: boolean): string {
  let name: string = if (seal) { "__fern_aes_gcm_seal_into" } else { "__fern_aes_gcm_open_into" };
  let p: string = if (seal) { ".Lgcs" } else { ".Lgco" };
  let o: string = "    .global " + name + "\n    .type " + name + ", %function\n" + name + ":\n" + rt_frame_of(s, 224) + "    mov x29, sp\n"
    + "    str x3, [x29, #192]\n    str x4, [x29, #96]\n    sxtw x5, w5\n    str x5, [x29, #208]\n    sxtw x6, w6\n    str x6, [x29, #72]\n"
    + "    sxtw x7, w7\n    str x7, [x29, #200]\n    sxtw x8, w8\n    str x8, [x29, #24]\n"
    + a64_aes_view("x2", "x9", "x10", p + "_n") + "    str x9, [x29, #56]\n    str x10, [x29, #176]\n"
    + a64_aes_view("x1", "x9", "x10", p + "_h") + "    str x9, [x29, #48]\n    str x10, [x29, #184]\n"
    + a64_aes_view("x0", "x9", "x10", p + "_k") + "    str x9, [x29, #32]\n";
  o = o + a64_aes_gcm_checks(p) + a64_aes_gcm_own(p)
    + "    ldr x5, [x29, #56]\n    ldr x9, [x5]\n    ldr w10, [x5, #8]\n    str x9, [x29, #112]\n    str w10, [x29, #120]\n"
    + "    ldr x9, [x29, #192]\n    rev x9, x9\n    ldur x10, [x29, #116]\n    eor x10, x10, x9\n    stur x10, [x29, #116]\n"
    + "    mov w11, #33554432\n    str w11, [x29, #124]\n"
    + "    ldr x9, [x29, #96]\n    add x9, x9, #8\n    ldr x10, [x29, #200]\n    add x10, x9, x10\n    str x10, [x29, #16]\n"
    + "    ldr x10, [x29, #208]\n    add x9, x9, x10\n    str x9, [x29, #64]\n";
  if (seal) {
    o = o + a64_aes_gcm_ctr(p) + a64_aes_gcm_hash(p);
  } else {
    o = o + a64_aes_gcm_hash(p) + a64_aes_gcm_ctr(p);
  }
  o = o + "    mov w11, #16777216\n    str w11, [x29, #124]\n    ldr x8, [x29, #32]\n    ldr x7, [x29, #40]\n" + a64_aes_load_keys_at(p + "_k2")
    + "    add x5, x29, #112\n    ld1 {v0.16b}, [x5]\n    bl .Lctr_enc1\n    add x5, x29, #160\n    ld1 {v1.16b}, [x5]\n    eor v0.16b, v0.16b, v1.16b\n"
    + "    ldr x3, [x29, #16]\n    ldr x9, [x29, #24]\n    add x3, x3, x9\n";
  if (seal) {
    o += "    st1 {v0.16b}, [x3]\n";
  } else {
    o += "    ld1 {v1.16b}, [x3]\n    eor v0.16b, v0.16b, v1.16b\n    umaxv b0, v0.16b\n    umov w9, v0.b[0]\n    cmp w9, #0\n    cset w9, ne\n    strb w9, [x3]\n";
  }
  return o + "    ldr x0, [x29, #96]\n" + rt_unframe_of(s, 224) + "    ret\n" + p + "_bad:\n    b __fern_slice_abort\n    .size " + name + ", .-" + name + "\n";
}

function a64_aes_gcm_checks(p: string): string {
  return "    mov x11, #10\n    cmp x10, #176\n    b.lo " + p + "_bad\n    cmp x10, #240\n    b.lo " + p + "_r\n    mov x11, #14\n" + p + "_r:\n    str x11, [x29, #40]\n"
    + "    ldr x9, [x29, #176]\n    cmp x9, #12\n    b.ne " + p + "_bad\n    ldr x9, [x29, #184]\n    cmp x9, #16\n    b.lo " + p + "_bad\n"
    + "    ldr x9, [x29, #208]\n    ldr x10, [x29, #72]\n    ldr x11, [x29, #200]\n    ldr x12, [x29, #24]\n"
    + "    orr x13, x9, x10\n    orr x13, x13, x11\n    orr x13, x13, x12\n    tbnz x13, #63, " + p + "_bad\n"
    + "    ldr x14, [x29, #96]\n    ldr x15, [x14]\n    add x13, x11, x12\n    add x13, x13, #16\n    cmp x13, x15\n    b.hi " + p + "_bad\n"
    + "    add x13, x9, x10\n    cmp x13, x15\n    b.hi " + p + "_bad\n";
}

// x14 is the box and x15 its length; a box with another holder is copied first.
function a64_aes_gcm_own(p: string): string {
  return "    ldur w9, [x14, #-8]\n    cmp w9, #1\n    b.eq " + p + "_own\n    str x14, [x29, #216]\n    mov x0, x15\n" + a64_aes_alloc("96")
    + "    ldr x1, [x29, #216]\n    add x1, x1, #8\n    add x2, x0, #8\n    ldr x3, [x0]\n    mov x4, #0\n"
    + p + "_cp:\n    cmp x4, x3\n    b.hs " + p + "_cpd\n    ldrb w5, [x1, x4]\n    strb w5, [x2, x4]\n    add x4, x4, #1\n    b " + p + "_cp\n" + p + "_cpd:\n"
    + "    ldr x0, [x29, #216]\n    str x0, [sp, #-16]!\n    bl __fn___fern_arr_dec\n    add sp, sp, #16\n" + p + "_own:\n";
}

function a64_aes_gcm_ctr(p: string): string {
  return "    add x5, x29, #112\n    ld1 {v6.16b}, [x5]\n    rev32 v6.16b, v6.16b\n    movi v7.2d, #0\n    mov w9, #1\n    ins v7.s[3], w9\n"
    + "    ldr x8, [x29, #32]\n    ldr x7, [x29, #40]\n" + a64_aes_load_keys_at(p + "_k1")
    + "    ldr x1, [x29, #16]\n    ldr x4, [x29, #24]\n    mov x2, x1\n"
    + a64_aes_ctr_blocks_at(p + "_c", p + "_cdone", 80) + p + "_cdone:\n";
}

function a64_aes_gcm_hash(p: string): string {
  return "    movi v31.2d, #0\n    ldr x5, [x29, #48]\n    ld1 {v1.16b}, [x5]\n" + a64_ghash_rev("v1") + "    movi v0.2d, #0\n"
    + "    ldr x1, [x29, #64]\n    ldr x4, [x29, #72]\n" + a64_ghash_blocks_at(p + "_ga", p + "_gadone", 128) + p + "_gadone:\n"
    + "    ldr x1, [x29, #16]\n    ldr x4, [x29, #24]\n" + a64_ghash_blocks_at(p + "_gc", p + "_gcdone", 128) + p + "_gcdone:\n"
    + "    ldr x9, [x29, #72]\n    lsl x9, x9, #3\n    rev x9, x9\n    str x9, [x29, #144]\n"
    + "    ldr x9, [x29, #24]\n    lsl x9, x9, #3\n    rev x9, x9\n    str x9, [x29, #152]\n"
    + "    add x5, x29, #144\n    ld1 {v2.16b}, [x5]\n" + a64_ghash_rev("v2") + "    eor v0.16b, v0.16b, v2.16b\n    bl .Lgh_mul\n"
    + a64_ghash_rev("v0") + "    add x5, x29, #160\n    st1 {v0.16b}, [x5]\n";
}

function a64_ghash(s: asmcore.EmitState): string {
  let o: string = "    .global __fern_ghash\n    .type __fern_ghash, %function\n__fern_ghash:\n" + rt_frame_of(s, 80) + "    mov x29, sp\n"
    + a64_aes_view("x2", "x3", "x4", ".Lgh_data") + "    str x3, [x29, #16]\n    str x4, [x29, #24]\n"
    + a64_aes_view("x1", "x3", "x5", ".Lgh_y") + "    str x3, [x29, #32]\n"
    + a64_aes_view("x0", "x3", "x6", ".Lgh_h") + "    str x3, [x29, #40]\n"
    + "    mov x0, #16\n    cmp x6, #16\n    b.hs .Lgh_hok\n    mov x0, #0\n.Lgh_hok:\n    cmp x5, #16\n    b.hs .Lgh_yok\n    mov x0, #0\n.Lgh_yok:\n"
    + a64_aes_alloc("48") + "    ldr x4, [x0]\n    cbz x4, .Lgh_ret\n    movi v31.2d, #0\n"
    + "    ldr x3, [x29, #40]\n    ld1 {v1.16b}, [x3]\n" + a64_ghash_rev("v1") + "    ldr x3, [x29, #32]\n    ld1 {v0.16b}, [x3]\n" + a64_ghash_rev("v0")
    + "    ldr x1, [x29, #16]\n    ldr x4, [x29, #24]\n";
  o += a64_ghash_blocks_at(".Lgh", ".Lgh_out", 64);
  return o + ".Lgh_out:\n" + a64_ghash_rev("v0") + "    ldr x0, [x29, #48]\n    add x3, x0, #8\n    st1 {v0.16b}, [x3]\n"
    + ".Lgh_ret:\n    ldr x0, [x29, #48]\n" + rt_unframe_of(s, 80) + "    ret\n" + a64_ghash_mul() + "    .size __fern_ghash, .-__fern_ghash\n";
}

function emit_aes_gcm_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("aes_gcm").need("heap");
  if (o.kind_tag == ir.K_AES_EXPAND_KEY) {
    return s.write("    ldr x0, [sp], #16\n    bl __fern_aes_expand_key\n    str x0, [sp, #-16]!\n");
  }
  if (o.kind_tag == ir.K_AES_GCM_SEAL_INTO || o.kind_tag == ir.K_AES_GCM_OPEN_INTO) {
    let fused: string = if (o.kind_tag == ir.K_AES_GCM_SEAL_INTO) { "__fern_aes_gcm_seal_into" } else { "__fern_aes_gcm_open_into" };
    let pops = "";
    for i in 0..9 {
      pops = pops + "    ldr x" + util.i32_to_string(8 - i) + ", [sp], #16\n";
    }
    return s.write(pops + "    bl " + fused + "\n    str x0, [sp, #-16]!\n");
  }
  let callee = "__fern_aes_ctr32";
  if (o.kind_tag == ir.K_GHASH) {
    callee = "__fern_ghash";
  }
  return s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    bl " + callee + "\n    str x0, [sp, #-16]!\n");
}

function emit_rt_aes_gcm(s: asmcore.EmitState): asmcore.EmitState {
  let kernels = a64_aes_expand_key(s) + a64_aes_ctr32(s) + a64_ghash(s) + a64_aes_gcm(s, true) + a64_aes_gcm(s, false);
  return s.write("    .arch_extension aes\n" + kernels);
}

function a64_sha256_blocks(s: asmcore.EmitState): string {
  let o: string = "    .global __fern_sha256_hw_blocks\n    .type __fern_sha256_hw_blocks, %function\n__fern_sha256_hw_blocks:\n"
    + rt_frame_of(s, 96) + "    mov x29, sp\n"
    + a64_aes_view("x1", "x3", "x4", ".Lsha_data") + "    str x3, [x29, #16]\n    str x4, [x29, #24]\n"
    + a64_aes_view("x0", "x3", "x5", ".Lsha_st") + "    str x3, [x29, #32]\n"
    + "    mov x0, #32\n    cmp x5, #32\n    b.hs .Lsha_stok\n    mov x0, #0\n.Lsha_stok:\n"
    + a64_aes_alloc("40") + "    ldr x4, [x0]\n    cbz x4, .Lsha_ret\n"
    + "    ldr x3, [x29, #32]\n    ld1 {v0.16b}, [x3]\n    add x3, x3, #16\n    ld1 {v1.16b}, [x3]\n"
    + a64_sha256_load_k() + "    ldr x1, [x29, #16]\n    ldr x4, [x29, #24]\n    add x10, x29, #48\n    add x11, x29, #64\n";
  o += ".Lsha_loop:\n    cmp x4, #64\n    b.lo .Lsha_done\n";
  let j = 4;
  while (j < 8) {
    let v = "v" + util.i32_to_string(j);
    o = o + "    ld1 {" + v + ".16b}, [x1]\n    add x1, x1, #16\n    rev32 " + v + ".16b, " + v + ".16b\n";
    j += 1;
  }
  o = o + "    st1 {v0.16b}, [x10]\n    st1 {v1.16b}, [x11]\n" + a64_sha256_rounds()
    + "    ld1 {v2.16b}, [x10]\n    ld1 {v3.16b}, [x11]\n    add v0.4s, v0.4s, v2.4s\n    add v1.4s, v1.4s, v3.4s\n"
    + "    sub x4, x4, #64\n    b .Lsha_loop\n";
  return o + ".Lsha_done:\n    ldr x0, [x29, #40]\n    add x3, x0, #8\n    st1 {v0.16b}, [x3]\n    add x3, x3, #16\n    st1 {v1.16b}, [x3]\n"
    + ".Lsha_ret:\n    ldr x0, [x29, #40]\n" + rt_unframe_of(s, 96) + "    ret\n    .size __fern_sha256_hw_blocks, .-__fern_sha256_hw_blocks\n";
}

function a64_sha1_blocks(s: asmcore.EmitState): string {
  let o: string = "    .global __fern_sha1_hw_blocks\n    .type __fern_sha1_hw_blocks, %function\n__fern_sha1_hw_blocks:\n"
    + rt_frame_of(s, 48) + "    mov x29, sp\n"
    + a64_aes_view("x1", "x3", "x4", ".Lsha1_data") + "    str x3, [x29, #16]\n    str x4, [x29, #24]\n"
    + a64_aes_view("x0", "x3", "x5", ".Lsha1_st") + "    str x3, [x29, #32]\n"
    + "    mov x0, #20\n    cmp x5, #20\n    b.hs .Lsha1_stok\n    mov x0, #0\n.Lsha1_stok:\n"
    + a64_aes_alloc("40") + "    ldr x4, [x0]\n    cbz x4, .Lsha1_ret\n"
    + "    ldr x3, [x29, #32]\n    ld1 {v0.16b}, [x3]\n    ldr w9, [x3, #16]\n    ins v1.s[0], w9\n";
  let k: u32[] = [0x5a827999, 0x6ed9eba1, 0x8f1bbcdc, 0xca62c1d6];
  let i = 0;
  while (i < 4) {
    o = o + "    movz w8, #" + util.i32_to_string((k[i] & 0xffff) as i32) + "\n    movk w8, #" + util.i32_to_string((k[i] >> 16) as i32)
      + ", lsl #16\n    dup v" + util.i32_to_string(16 + i) + ".4s, w8\n";
    i += 1;
  }
  o += "    ldr x1, [x29, #16]\n    ldr x4, [x29, #24]\n.Lsha1_loop:\n    cmp x4, #64\n    b.lo .Lsha1_done\n";
  let j = 4;
  while (j < 8) {
    let v = "v" + util.i32_to_string(j);
    o = o + "    ld1 {" + v + ".16b}, [x1]\n    add x1, x1, #16\n    rev32 " + v + ".16b, " + v + ".16b\n";
    j += 1;
  }
  o = o + "    orr v20.16b, v0.16b, v0.16b\n    orr v21.16b, v1.16b, v1.16b\n" + a64_sha1_rounds()
    + "    add v0.4s, v0.4s, v20.4s\n    add v1.4s, v1.4s, v21.4s\n    sub x4, x4, #64\n    b .Lsha1_loop\n";
  return o + ".Lsha1_done:\n    ldr x0, [x29, #40]\n    add x3, x0, #8\n    st1 {v0.16b}, [x3]\n    umov w9, v1.s[0]\n    str w9, [x3, #16]\n"
    + ".Lsha1_ret:\n    ldr x0, [x29, #40]\n" + rt_unframe_of(s, 48) + "    ret\n    .size __fern_sha1_hw_blocks, .-__fern_sha1_hw_blocks\n";
}

function emit_rt_sha(s: asmcore.EmitState): asmcore.EmitState {
  if (s.has_need("sha256") || s.has_need("sha1")) {
    s = s.write("    .arch_extension sha2\n");
  }
  if (s.has_need("sha256")) {
    let sha256 = a64_sha256_blocks(s);
    s = s.write(sha256);
  }
  if (s.has_need("sha1")) {
    let sha1 = a64_sha1_blocks(s);
    s = s.write(sha1);
  }
  return s;
}

function a64_sha1_rounds(): string {
  let ops: string[] = ["sha1c", "sha1p", "sha1m", "sha1p"];
  let o = "";
  let i = 0;
  while (i < 20) {
    let w = "v" + util.i32_to_string(4 + i % 4);
    let e = "s1";
    let next = "s3";
    if (i % 2 == 1) {
      e = "s3";
      next = "s1";
    }
    o = o + "    add v2.4s, " + w + ".4s, v" + util.i32_to_string(16 + i / 5) + ".4s\n    sha1h " + next + ", s0\n    "
      + ops[i / 5] + " q0, " + e + ", v2.4s\n";
    if (i < 16) {
      o = o + "    sha1su0 " + w + ".4s, v" + util.i32_to_string(4 + (i + 1) % 4) + ".4s, v" + util.i32_to_string(4 + (i + 2) % 4) + ".4s\n"
        + "    sha1su1 " + w + ".4s, v" + util.i32_to_string(4 + (i + 3) % 4) + ".4s\n";
    }
    i += 1;
  }
  return o;
}

function a64_sha256_pair(x: string, k: u32[], at: i32): string {
  let o = "";
  let h = 0;
  while (h < 4) {
    let word = k[at + h / 2];
    let half = (word >> (16 * (h % 2)) as u32 & 0xffff) as i32;
    if (h == 0) {
      o = o + "    movz " + x + ", #" + util.i32_to_string(half) + "\n";
    } else {
      o = o + "    movk " + x + ", #" + util.i32_to_string(half) + ", lsl #" + util.i32_to_string(16 * h) + "\n";
    }
    h += 1;
  }
  return o;
}

function a64_sha256_load_k(): string {
  let k = asmcore.sha256_k();
  let o = "";
  let i = 0;
  while (i < 16) {
    let v = "v" + util.i32_to_string(16 + i);
    o = o + a64_sha256_pair("x8", k, 4 * i) + a64_sha256_pair("x9", k, 4 * i + 2)
      + "    ins " + v + ".d[0], x8\n    ins " + v + ".d[1], x9\n";
    i += 1;
  }
  return o;
}

function a64_sha256_rounds(): string {
  let o = "";
  let i = 0;
  while (i < 16) {
    let w = "v" + util.i32_to_string(4 + i % 4);
    o = o + "    add v2.4s, " + w + ".4s, v" + util.i32_to_string(16 + i) + ".4s\n";
    if (i < 12) {
      o = o + "    sha256su0 " + w + ".4s, v" + util.i32_to_string(4 + (i + 1) % 4) + ".4s\n";
    }
    o += "    orr v3.16b, v0.16b, v0.16b\n    sha256h q0, q1, v2.4s\n    sha256h2 q1, q3, v2.4s\n";
    if (i < 12) {
      o = o + "    sha256su1 " + w + ".4s, v" + util.i32_to_string(4 + (i + 2) % 4) + ".4s, v" + util.i32_to_string(4 + (i + 3) % 4) + ".4s\n";
    }
    i += 1;
  }
  return o;
}

function emit_rt_crc32_cksum(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .arch_extension aes\n");
  s = s.write("    .global __fern_crc32_cksum\n");
  s = s.write("    .global __fern_crc32_cksum_data\n");
  s = s.write("    .type __fern_crc32_cksum, %function\n");
  s = s.write("__fern_crc32_cksum:\n");
  s = s.write("    ldr x6, [x1, #8]\n");
  s = s.write("    ldr x7, [x1]\n");
  s = s.write("__fern_crc32_cksum_data:\n");
  s = s.write(rt_frame_of(s, 64));
  s = s.write("    mov x29, sp\n");
  s = s.write("    mov w10, w0\n");
  s = s.write("    mov x8, x7\n");
  s = s.write("    add x9, x7, w6, uxtw\n");
  s = s.write("    mov w0, w10\n");
  s = s.write("    sub x11, x9, x8\n");
  s = s.write("    cmp x11, #16\n");
  s = s.write("    b.lo .Lcrc32_tail\n");
  s = s.write("    movz w12, #0x5605\n");
  s = s.write("    movk w12, #0xe8a4, lsl #16\n");
  s = s.write("    movz w13, #0xcd4c\n");
  s = s.write("    movk w13, #0xc5b9, lsl #16\n");
  s = s.write("    movi v2.2d, #0\n");
  s = s.write("    ins v2.d[0], x12\n");
  s = s.write("    ins v2.d[1], x13\n");
  s = s.write("    ld1 {v0.16b}, [x8]\n");
  s = s.write("    rev64 v0.16b, v0.16b\n");
  s = s.write("    ext v0.16b, v0.16b, v0.16b, #8\n");
  s = s.write("    lsl x14, x10, #32\n");
  s = s.write("    movi v1.2d, #0\n");
  s = s.write("    ins v1.d[1], x14\n");
  s = s.write("    eor v0.16b, v0.16b, v1.16b\n");
  s = s.write("    mov w0, wzr\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    sub x11, x9, x8\n");
  s = s.write("    cmp x11, #112\n");
  s = s.write("    b.lo .Lcrc32_fold1\n");
  s = s.write("    ld1 {v6.16b}, [x8]\n");
  s = s.write("    rev64 v6.16b, v6.16b\n");
  s = s.write("    ext v6.16b, v6.16b, v6.16b, #8\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    ld1 {v7.16b}, [x8]\n");
  s = s.write("    rev64 v7.16b, v7.16b\n");
  s = s.write("    ext v7.16b, v7.16b, v7.16b, #8\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    ld1 {v16.16b}, [x8]\n");
  s = s.write("    rev64 v16.16b, v16.16b\n");
  s = s.write("    ext v16.16b, v16.16b, v16.16b, #8\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    movz w12, #0x8b11\n");
  s = s.write("    movk w12, #0xe622, lsl #16\n");
  s = s.write("    movz w13, #0x794c\n");
  s = s.write("    movk w13, #0x8833, lsl #16\n");
  s = s.write("    movi v17.2d, #0\n");
  s = s.write("    ins v17.d[0], x12\n");
  s = s.write("    ins v17.d[1], x13\n");
  s = s.write(".Lcrc32_fold4:\n");
  s = s.write("    sub x11, x9, x8\n");
  s = s.write("    cmp x11, #64\n");
  s = s.write("    b.lo .Lcrc32_combine\n");
  s = s.write("    pmull2 v3.1q, v0.2d, v17.2d\n");
  s = s.write("    pmull v4.1q, v0.1d, v17.1d\n");
  s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
  s = s.write("    ld1 {v5.16b}, [x8]\n");
  s = s.write("    rev64 v5.16b, v5.16b\n");
  s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
  s = s.write("    eor v0.16b, v0.16b, v5.16b\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    pmull2 v3.1q, v6.2d, v17.2d\n");
  s = s.write("    pmull v4.1q, v6.1d, v17.1d\n");
  s = s.write("    eor v6.16b, v3.16b, v4.16b\n");
  s = s.write("    ld1 {v5.16b}, [x8]\n");
  s = s.write("    rev64 v5.16b, v5.16b\n");
  s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
  s = s.write("    eor v6.16b, v6.16b, v5.16b\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    pmull2 v3.1q, v7.2d, v17.2d\n");
  s = s.write("    pmull v4.1q, v7.1d, v17.1d\n");
  s = s.write("    eor v7.16b, v3.16b, v4.16b\n");
  s = s.write("    ld1 {v5.16b}, [x8]\n");
  s = s.write("    rev64 v5.16b, v5.16b\n");
  s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
  s = s.write("    eor v7.16b, v7.16b, v5.16b\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    pmull2 v3.1q, v16.2d, v17.2d\n");
  s = s.write("    pmull v4.1q, v16.1d, v17.1d\n");
  s = s.write("    eor v16.16b, v3.16b, v4.16b\n");
  s = s.write("    ld1 {v5.16b}, [x8]\n");
  s = s.write("    rev64 v5.16b, v5.16b\n");
  s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
  s = s.write("    eor v16.16b, v16.16b, v5.16b\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    b .Lcrc32_fold4\n");
  s = s.write(".Lcrc32_combine:\n");
  s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
  s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
  s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
  s = s.write("    eor v0.16b, v0.16b, v6.16b\n");
  s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
  s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
  s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
  s = s.write("    eor v0.16b, v0.16b, v7.16b\n");
  s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
  s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
  s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
  s = s.write("    eor v0.16b, v0.16b, v16.16b\n");
  s = s.write(".Lcrc32_fold1:\n");
  s = s.write("    sub x11, x9, x8\n");
  s = s.write("    cmp x11, #16\n");
  s = s.write("    b.lo .Lcrc32_reduce\n");
  s = s.write("    pmull2 v3.1q, v0.2d, v2.2d\n");
  s = s.write("    pmull v4.1q, v0.1d, v2.1d\n");
  s = s.write("    eor v0.16b, v3.16b, v4.16b\n");
  s = s.write("    ld1 {v5.16b}, [x8]\n");
  s = s.write("    rev64 v5.16b, v5.16b\n");
  s = s.write("    ext v5.16b, v5.16b, v5.16b, #8\n");
  s = s.write("    eor v0.16b, v0.16b, v5.16b\n");
  s = s.write("    add x8, x8, #16\n");
  s = s.write("    b .Lcrc32_fold1\n");
  s = s.write(".Lcrc32_reduce:\n");
  s = s.write("    rev64 v0.16b, v0.16b\n");
  s = s.write("    ext v0.16b, v0.16b, v0.16b, #8\n");
  s = s.write("    add x15, x29, #48\n");
  s = s.write("    st1 {v0.16b}, [x15]\n");
  s = s.write("    mov x16, xzr\n");
  s = s.write(".Lcrc32_red:\n");
  s = s.write("    cmp x16, #16\n");
  s = s.write("    b.hs .Lcrc32_tail\n");
  s = s.write("    ldrb w17, [x15, x16]\n");
  s = s.write("    lsl w17, w17, #24\n");
  s = s.write("    eor w0, w0, w17\n");
  s = s.write("    mov w12, #8\n");
  s = s.write("    movz w13, #0x1db7\n");
  s = s.write("    movk w13, #0x04c1, lsl #16\n");
  s = s.write(".Lcrc32_redbit:\n");
  s = s.write("    asr w14, w0, #31\n");
  s = s.write("    and w14, w14, w13\n");
  s = s.write("    lsl w0, w0, #1\n");
  s = s.write("    eor w0, w0, w14\n");
  s = s.write("    sub w12, w12, #1\n");
  s = s.write("    cbnz w12, .Lcrc32_redbit\n");
  s = s.write("    add x16, x16, #1\n");
  s = s.write("    b .Lcrc32_red\n");
  s = s.write(".Lcrc32_tail:\n");
  s = s.write("    cmp x8, x9\n");
  s = s.write("    b.hs .Lcrc32_ret\n");
  s = s.write("    ldrb w17, [x8]\n");
  s = s.write("    lsl w17, w17, #24\n");
  s = s.write("    eor w0, w0, w17\n");
  s = s.write("    mov w12, #8\n");
  s = s.write("    movz w13, #0x1db7\n");
  s = s.write("    movk w13, #0x04c1, lsl #16\n");
  s = s.write(".Lcrc32_tailbit:\n");
  s = s.write("    asr w14, w0, #31\n");
  s = s.write("    and w14, w14, w13\n");
  s = s.write("    lsl w0, w0, #1\n");
  s = s.write("    eor w0, w0, w14\n");
  s = s.write("    sub w12, w12, #1\n");
  s = s.write("    cbnz w12, .Lcrc32_tailbit\n");
  s = s.write("    add x8, x8, #1\n");
  s = s.write("    b .Lcrc32_tail\n");
  s = s.write(".Lcrc32_ret:\n");
  s = s.write(rt_unframe_of(s, 64));
  s = s.write("    ret\n");
  s = s.write("    .size __fern_crc32_cksum, .-__fern_crc32_cksum\n");
  return s;
}

// The reflected IEEE CRC-32 register update: w0 is the register, x7 the data and x6 the length.
function emit_rt_crc32_ieee(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .arch_extension crc\n");
  s = s.write("    .global __fern_crc32_ieee\n");
  s = s.write("    .global __fern_crc32_ieee_data\n");
  s = s.write("    .type __fern_crc32_ieee, %function\n");
  s = s.write("__fern_crc32_ieee:\n");
  s = s.write("    ldr x6, [x1, #8]\n");
  s = s.write("    ldr x7, [x1]\n");
  s = s.write("__fern_crc32_ieee_data:\n");
  s = s.write(".Lcrc32_ieee_32:\n");
  s = s.write("    subs x6, x6, #32\n");
  s = s.write("    b.lo .Lcrc32_ieee_8in\n");
  s = s.write("    ldp x2, x3, [x7], #16\n");
  s = s.write("    ldp x4, x5, [x7], #16\n");
  s = s.write("    crc32x w0, w0, x2\n");
  s = s.write("    crc32x w0, w0, x3\n");
  s = s.write("    crc32x w0, w0, x4\n");
  s = s.write("    crc32x w0, w0, x5\n");
  s = s.write("    b .Lcrc32_ieee_32\n");
  s = s.write(".Lcrc32_ieee_8in:\n");
  s = s.write("    add x6, x6, #32\n");
  s = s.write(".Lcrc32_ieee_8:\n");
  s = s.write("    subs x6, x6, #8\n");
  s = s.write("    b.lo .Lcrc32_ieee_1in\n");
  s = s.write("    ldr x2, [x7], #8\n");
  s = s.write("    crc32x w0, w0, x2\n");
  s = s.write("    b .Lcrc32_ieee_8\n");
  s = s.write(".Lcrc32_ieee_1in:\n");
  s = s.write("    adds x6, x6, #8\n");
  s = s.write("    b.eq .Lcrc32_ieee_ret\n");
  s = s.write(".Lcrc32_ieee_1:\n");
  s = s.write("    ldrb w2, [x7], #1\n");
  s = s.write("    crc32b w0, w0, w2\n");
  s = s.write("    subs x6, x6, #1\n");
  s = s.write("    b.ne .Lcrc32_ieee_1\n");
  s = s.write(".Lcrc32_ieee_ret:\n");
  s = s.write("    ret\n");
  s = s.write("    .size __fern_crc32_ieee, .-__fern_crc32_ieee\n");
  return s;
}

function needs_fs_runtime(s: asmcore.EmitState): boolean {
  return s.any_need([
    "hostname", "uname_field",
    "read_file", "read_file_bytes", "read_file_bytes_u8", "write_file", "write_file_bytes", "write_file_bytes_u8", "write_file_exec",
    "remove_file", "create_dir_all", "create_dir", "remove_dir",
    "create_link", "clone_file", "create_symlink", "rename", "rename_noreplace", "rename_exchange", "getxattr", "getxattr_bytes", "getxattr_bytes_u8", "lgetxattr", "lgetxattr_bytes", "lgetxattr_bytes_u8", "setxattr", "setxattr_bytes", "setxattr_bytes_u8", "lsetxattr", "lsetxattr_bytes", "lsetxattr_bytes_u8", "chmod", "chmod_at", "truncate",
    "mknod", "chown_at", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc", "pipe", "set_file_times", "writer_set_times", "read_link",
    "getcwd", "chdir", "chroot", "setuid", "setgid", "setgroups", "umask", "fd_fsync", "fd_fdatasync", "fd_syncfs", "fd_drop_cache", "sync",
    "temp_dir", "stat", "lstat", "statfs", "mounts", "sysctl", "access", "read_dir", "read_dir_bytes", "read_dir_all", "read_dir_ino", "read_dir_ino_all",
    "remove_dir_all", "open_file", "open_with", "writer_write", "write_some", "splice_forever",
    "reader", "read_chunk_bytes", "read_chunk_bytes_u8", "write_bytes", "write_bytes_u8", "write_some_bytes", "write_some_bytes_u8", "signal_send", "set_process_group", "set_priority", "clock_set",
    "open_dir", "dir_open", "dir_entries", "dir_stat", "dir_access", "dir_unlink", "dir_chmod", "dir_chown", "dir_open_file",
  ]);
}

function profile_exit_asm(s: asmcore.EmitState): string {
  if (s.profile <= 0) {
    return "";
  }
  return rt_save_lr(s, "x0") + "    bl __fern_profile_flush\n" + rt_restore_lr(s, "x0");
}

// A hand-written runtime frame signs its return address under -harden and
// authenticates it on the way out, as a compiled frame does. The stack
// pointer is the same at both instructions, so the signature matches.
function rt_frame(s: asmcore.EmitState): string {
  return rt_frame_of(s, 16);
}

function rt_unframe(s: asmcore.EmitState): string {
  return rt_unframe_of(s, 16);
}

function rt_frame_of(s: asmcore.EmitState, bytes: i32): string {
  return rt_pac(s, "paciasp") + "    stp x29, x30, [sp, #-" + util.i32_to_string(bytes) + "]!\n";
}

function rt_unframe_of(s: asmcore.EmitState, bytes: i32): string {
  return "    ldp x29, x30, [sp], #" + util.i32_to_string(bytes) + "\n" + rt_pac(s, "autiasp");
}

// Saves x30 alone or beside `pair` around a call, signed under -harden. Inside
// a signed frame x30 is signed already, so xpaclri strips it before paciasp.
function rt_save_lr(s: asmcore.EmitState, pair: string): string {
  let sign = rt_pac(s, "xpaclri") + rt_pac(s, "paciasp");
  if (pair == "") {
    return sign + "    str x30, [sp, #-16]!\n";
  }
  return sign + "    stp " + pair + ", x30, [sp, #-16]!\n";
}

function rt_restore_lr(s: asmcore.EmitState, pair: string): string {
  if (pair == "") {
    return "    ldr x30, [sp], #16\n" + rt_pac(s, "autiasp");
  }
  return "    ldp " + pair + ", x30, [sp], #16\n" + rt_pac(s, "autiasp");
}

function rt_pac(s: asmcore.EmitState, op: string): string {
  if (s.harden) {
    return "    " + op + "\n";
  }
  return "";
}

function profile_frame(s: asmcore.EmitState, name: string): asmcore.EmitState {
  s = s.write(name + ":\n");
  if (s.harden) {
    s = s.write("    bti c\n");
  }
  return s.write(rt_frame(s) + "    mov x29, sp\n");
}

function profile_return(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(rt_unframe(s));
  return s.write("    ret\n");
}

function profile_alloc_fast(s: asmcore.EmitState): boolean {
  return !s.leak_check && !s.has_need("alloc_count") && !rtprofile.allocation(s.profile);
}

function emit_profile_alloc_hook(s: asmcore.EmitState): asmcore.EmitState {
  if (!rtprofile.allocation(s.profile)) {
    return s;
  }
  return s.write("    bl __fern_profile_alloc\n");
}

function emit_profile_alloc_runtime(s: asmcore.EmitState): asmcore.EmitState {
  if (!rtprofile.allocation(s.profile)) {
    return s;
  }
  s = profile_frame(s, "__fern_profile_alloc");
  s = s.write("    stp x0, x1, [sp, #-16]!\n    stp x2, x3, [sp, #-16]!\n    stp x4, x5, [sp, #-16]!\n    stp x6, x7, [sp, #-16]!\n    stp x8, x9, [sp, #-16]!\n    stp x10, x11, [sp, #-16]!\n    stp x12, x13, [sp, #-16]!\n    stp x14, x15, [sp, #-16]!\n    stp x16, x17, [sp, #-16]!\n    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    ldr x13, [x12, #24]\n    cbz x13, .Lprofile_alloc_return\n    add x15, x12, #144\n    mov x13, #1\n    ldaddal x13, x13, [x15]\n    add x13, x13, #1\n    and x13, x13, #63\n    cbnz x13, .Lprofile_alloc_return\n    mov x8, #172\n").svc(172).write("    ldr x13, [x12, #128]\n    cmp x0, x13\n    b.ne .Lprofile_alloc_return\n    mov x8, #178\n").svc(178).write("    mov x14, x0\n    add x15, x12, #40\n    mov x13, xzr\n    casal x13, x14, [x15]\n    cbnz x13, .Lprofile_alloc_drop\n    ldr x13, [x29]\n    ldr x0, [x13, #8]\n    sub x0, x0, #1\n    ldr x9, [x13]\n    add x10, x29, #16\n    mov x11, x12\n    ldr x12, [sp, #128]\n    lsl x12, x12, #6\n    bl __fn___fern_profile_sample.r\n    cbz x0, .Lprofile_alloc_unlock\n    bl .Lprofile_drop\n.Lprofile_alloc_unlock:\n    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    add x15, x12, #40\n    stlr xzr, [x15]\n    b .Lprofile_alloc_return\n.Lprofile_alloc_drop:\n    bl .Lprofile_drop\n.Lprofile_alloc_return:\n    ldp x16, x17, [sp], #16\n    ldp x14, x15, [sp], #16\n    ldp x12, x13, [sp], #16\n    ldp x10, x11, [sp], #16\n    ldp x8, x9, [sp], #16\n    ldp x6, x7, [sp], #16\n    ldp x4, x5, [sp], #16\n    ldp x2, x3, [sp], #16\n    ldp x0, x1, [sp], #16\n");
  return profile_return(s);
}

function emit_profile_runtime(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  s = s.write("    .arch_extension lse\n");
  s = s.write("    .bss\n    .p2align 3\n.Lprofile_ring: .zero 4337824\n    .data\n    .p2align 3\n");
  let target = rt_key(darwin);
  if (darwin) {
    s = s.write(".Lprofile_action: .quad __fern_profile_signal, __fern_profile_trampoline\n    .long 0, 66\n");
  } else {
    s = s.write(".Lprofile_action: .quad __fern_profile_signal, 268435460, 0, 0\n");
  }
  s = s.write(".Lprofile_timer: .quad 0, 10000, 0, 10000\n    .text\n");
  s = emit_runtime("__fern_profile_start __fern_profile_sample __fern_profile_finish", s);
  s = profile_frame(s, "__fern_profile_signal");
  s = s.write("    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    ldr x13, [x12, #24]\n    cbz x13, .Lprofile_signal_return\n    mov x8, #172\n").svc(172).write("    ldr x13, [x12, #128]\n    cmp x0, x13\n    b.ne .Lprofile_signal_return\n    mov x8, #178\n").svc(178).write("    mov x14, x0\n    add x15, x12, #40\n    mov x13, xzr\n    casal x13, x14, [x15]\n    cbnz x13, .Lprofile_busy\n" + profile_interrupted_state(darwin) + "    mov x11, x12\n    mov x12, #1\n    bl __fn___fern_profile_sample.r\n    cbz x0, .Lprofile_signal_unlock\n    bl .Lprofile_drop\n.Lprofile_signal_unlock:\n    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    add x15, x12, #40\n    stlr xzr, [x15]\n    b .Lprofile_signal_return\n.Lprofile_busy:\n    bl .Lprofile_drop\n.Lprofile_signal_return:\n");
  s = profile_return(s);
  s = s.write(".Lprofile_drop:\n    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    add x15, x12, #8\n    mov x13, #1\n    ldaddal x13, x13, [x15]\n    ret\n");
  s = profile_frame(s, "__fern_profile_flush");
  s = s.write("    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    ldr x13, [x12, #32]\n    cmp x13, #2\n    b.eq .Lprofile_flush_return\n    mov x8, #172\n").svc(172).write("    ldr x13, [x12, #128]\n    cmp x0, x13\n    b.ne .Lprofile_flush_return\n    mov x8, #178\n").svc(178).write("    mov x14, x0\n    add x15, x12, #40\n.Lprofile_flush_lock:\n    mov x13, xzr\n    casal x13, x14, [x15]\n    cbz x13, .Lprofile_flush_owned\n    cmp x13, x14\n    b.eq .Lprofile_flush_reentrant\n    yield\n    b .Lprofile_flush_lock\n.Lprofile_flush_reentrant:\n    ldr x13, [x12, #32]\n    cmp x13, #1\n    b.eq .Lprofile_flush_return\n.Lprofile_flush_owned:\n    ldr x13, [x12, #32]\n    cmp x13, #2\n    b.eq .Lprofile_flush_unlock\n    str xzr, [x12, #24]\n    mov x13, #1\n    str x13, [x12, #32]\n    mov x0, x12\n    bl __fn___fern_profile_finish.r\n    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    mov x13, #2\n    str x13, [x12, #32]\n.Lprofile_flush_unlock:\n    add x15, x12, #40\n    stlr xzr, [x15]\n.Lprofile_flush_return:\n");
  s = profile_return(s);
  if (darwin) {
    s = emit_profile_trampoline(s);
  }
  return emit_profile_alloc_runtime(s);
}

function profile_interrupted_state(darwin: boolean): string {
  if (darwin) {
    return "    ldr x13, [x2, #48]\n    ldr x0, [x13, #272]\n    ldr x9, [x13, #248]\n    ldr x10, [x13, #264]\n    and x9, x9, #0x0000ffffffffffff\n    and x10, x10, #0x0000ffffffffffff\n";
  }
  return "    ldr x0, [x2, #440]\n    ldr x9, [x2, #416]\n    ldr x10, [x2, #432]\n";
}

function emit_profile_trampoline(s: asmcore.EmitState): asmcore.EmitState {
  s = profile_frame(s, "__fern_profile_trampoline");
  return s.write("    stp x1, x4, [sp, #-16]!\n    stp x5, xzr, [sp, #-16]!\n    mov x16, x0\n    mov x0, x2\n    mov x1, x3\n    mov x2, x4\n    blr x16\n    ldp x2, xzr, [sp], #16\n    ldp x1, x0, [sp], #16\n" + rt_unframe(s) + "    mov x16, #184\n    svc #0x80\n    mov x0, #2\n    mov x16, #1\n    svc #0x80\n    brk #0\n");
}

function emit_ir_runtime_settled(s0: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  let s = s0;
  let settled = false;
  let out = s0;
  while (!settled) {
    let h = buf_new(65536);
    let m = buf_new(256);
    let t = emit_ir_runtime(asmcore.EmitState { ...s, capture: h, missed: m }, darwin);
    let text = buf_take(h);
    buf_free(h);
    if (asmcore.settles(t, s.needed.len(), m)) {
      settled = true;
      let back = asmcore.EmitState { ...t, capture: s0.capture, missed: s0.missed };
      out = back.write(text);
    } else {
      s = asmcore.EmitState { ...s0, needed: t.needed, runtime_units: t.runtime_units };
    }
  }
  return out;
}

pub function emit_ir_runtime(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  if (s.profile > 0) {
    s = emit_profile_runtime(s, darwin);
  }
  s = emit_rt_clock_and_print(s, darwin);
  s = emit_rt_io_and_string(s);
  s = emit_rt_heap(s, darwin);
  s = emit_rt_collections_and_proc(s, darwin);
  return emit_rodata_pools_arm64(s, darwin);
}

pub function emit_module_or_error_sub(mod: parser.Module, darwin: boolean, sub: ircore.Sub, recs: usize): string {
  if (!sub.checked) {
    let parse_errs = asmcore.parse_unknown_errors_module(mod);
    if (parse_errs.len() > 0) {
      eprint(util.format_diags(parse_errs));
      exit(1);
      return "";
    }
  }
  let tm = checker.ensure_annotated(mod);
  if (!sub.checked) {
    let check_errs = asmcore.entry_check_errors(tm);
    if (check_errs.len() > 0) {
      eprint(util.format_diags(check_errs));
      exit(1);
      return "";
    }
  }
  ircore.refuse_claims(sub.refused);
  let g = emit_module_ir_gated_sub(ircore.sub_lifted(sub, tm), darwin, sub, recs);
  if (g != "") {
    return g;
  }
  ircore.eprint_ir_ineligible();
  exit(1);
  return "";
}

pub function emit_module_ir_gated_sub(mod: parser.Module, darwin: boolean, sub: ircore.Sub, recs: usize): string {
  let g = match (ircore.gate_program(mod, sub)) { Some(g) => g, None => { return ""; } };
  return emit_module_ir_flat(g.im, g.stab, darwin, ircore.inline_tiny_leaves(g.im, g.cache), g.physical, sub.rt_lower, recs, sub.switches);
}

function emit_module_ir_flat(mod: parser.Module, stab: irtables.StructTab, darwin: boolean, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (parser.Module) => physicalbody.Lowered, recs: usize, sw: asmcore.Switches): string {
  if (darwin && sw.sandbox) {
    eprint("fern: FERN_SANDBOX=1 has no sandbox on arm64-darwin; the seccomp filter is a Linux kernel feature");
    exit(1);
    return "";
  }
  let s = asmcore.new_state();
  s = asmcore.with_funcs(asmcore.with_providers(asmcore.with_switches(asmcore.EmitState { ...s, runtime_target: rt_key(darwin), struct_decls: stab, rt_lower: rt, recs: recs, memo: irverifygate.open_memo("arm64") }, sw), mod), mod.funcs);
  s = emit_body(mod, s, darwin, cache, physical);
  s = emit_ir_runtime_settled(s, darwin);
  if (s.sandbox) {
    s = emit_seccomp_install(s);
  }
  if (asmcore.reset_entry(s)) {
    s = s.write("    .section .data\n    .p2align 4\n    .section .bss\n    .p2align 4\n__fern_bss_end:\n    .text\n");
  }
  irverifygate.close_memo(s.memo);
  let leak = asmcore.hostless_syscall_refusal(s);
  if (leak.len() > 0) {
    eprint(leak);
    exit(2);
    return "";
  }
  return s.take_text();
}

// The filter admits the numbers the emitted program contains. The installer
// itself is not on the list: after it runs the program needs neither call.
function emit_seccomp_install(s: asmcore.EmitState): asmcore.EmitState {
  let allowed = asmcore.seccomp_allowlist(s);
  s = s.write("    .text\n__fern_seccomp_install:\n");
  s = s.write("    mov x0, #38\n    mov x1, #1\n    mov x2, #0\n    mov x3, #0\n    mov x4, #0\n    mov x8, #167\n").svc(167);
  s = s.write("    sub sp, sp, #16\n    mov x0, #" + util.i32_to_string(asmcore.seccomp_filter_len(s, allowed)) + "\n    str x0, [sp]\n");
  s = s.write("    adrp x0, .Lseccomp_filter\n    add x0, x0, :lo12:.Lseccomp_filter\n    str x0, [sp, #8]\n");
  s = s.write("    mov x0, #1\n    mov x1, #0\n    mov x2, sp\n    mov x8, #277\n").svc(277);
  s = s.write("    add sp, sp, #16\n    ret\n");
  s = asmcore.emit_seccomp_filter(s, "0xC00000B7", allowed);
  return s.write("    .text\n");
}

pub function emit_module_ir_unit_arm64_flat(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (parser.Module) => physicalbody.Lowered, sw: asmcore.Switches): string {
  return emit_module_ir_unit_arm64_prepared(mod, is_entry, globl_defs, str_ns, extra_needs, all_funcs, all_structs, lo, hi, cache, physical, rt, sw, false).text;
}

pub function emit_module_ir_unit_arm64_prepared(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (parser.Module) => physicalbody.Lowered, sw: asmcore.Switches, retain: boolean): ssaprepare.Output {
  mod = parser.infer_ret_types_module(mod);
  let s = asmcore.new_state();
  s = asmcore.EmitState { ...s, retain_prepared: retain, memo: irverifygate.open_memo("arm64") };
  s = asmcore.with_funcs(asmcore.with_providers(asmcore.with_switches(asmcore.EmitState { ...s, struct_decls: all_structs, str_ns: str_ns, rt_lower: rt }, sw), mod), all_funcs);
  let derrs = asmcore.display_errs_module(mod, s);
  if (derrs.len() > 0) {
    eprint(util.format_diags(derrs));
    exit(1);
    return ssaprepare.Output { text: "", bodies: [] };
  }
  if (globl_defs && s.sandbox) {
    eprint("fern: FERN_SANDBOX=1 needs the whole-program emit; a per-module unit cannot see its siblings' syscalls");
    exit(1);
    return ssaprepare.Output { text: "", bodies: [] };
  }
  if (is_entry) {
    s = s.write("    .globl _start\n");
  }
  s = s.write("    .text\n");
  if (is_entry && globl_defs) {
    s = asmcore.emit_runtime_globls(s);
    for name in leaf_aborts() {
      s = s.write(".globl " + name + "_leaf\n");
    }
  }
  let vgate = irverifygate.with_memo(irverifygate.gate(irtables.fn_sig_index(all_funcs, mod.funcs, cache), s.kinds, physicalbody.abis(physical)), s.memo);
  let hh = hi;
  if (hh < 0 || hh > mod.funcs.len()) {
    hh = mod.funcs.len();
  }
  let unit = asmcore.unit_leaves(mod, lo, hh, cache, s.kinds);
  s = asmcore.EmitState { ...s, reg_entries: irtables.sig_reg_of(asmcore.unit_labels(mod, lo, hh, cache)), leaves: unit.leaves };
  let fabi = asmcore.unit_float_abi(mod, lo, hh, cache);
  s = asmcore.EmitState { ...s, float_abi: fabi.names, float_abi_masks: fabi.masks };
  let fi = lo;
  while (fi < hh) {
    let r = ircore.produced(cache, fi, mod.funcs[fi]);
    if (r.superseded) {
      fi += 1;
      continue;
    }
    if (globl_defs) {
      let gname = parser.decl_key(mod.funcs[fi]);
      s = s.write(".globl __fn_" + asmcore.sanitize_label(gname) + "\n.globl __fn_" + asmcore.sanitize_label(gname) + ".k\n");
    }
    s = emit_function_via_ir_pre(r, physicalbody.select(physical, fi), s.prelift(unit.pre, fi, r), mod.funcs[fi], s, vgate);
    fi += 1;
  }
  s = emit_named_bodies(cache, physical, unit.pre, mod.funcs.len(), s, vgate);
  s = emit_cfi_stubs_from(s, 0);
  irverifygate.report(vgate);
  let en = 0;
  while (en < extra_needs.len()) {
    s = s.need(extra_needs[en]);
    en += 1;
  }
  if (is_entry) {
    s = emit_ir_start(s, false);
  }
  if (is_entry) {
    s = emit_ir_runtime_settled(s, false);
    if (s.sandbox) {
      s = emit_seccomp_install(s);
    }
  } else {
    s = emit_rodata_pools_arm64(s, false);
  }
  irverifygate.close_memo(s.memo);
  return ssaprepare.Output { text: s.take_text(), bodies: s.prepared };
}

function darwin_lstrip(s: string): string {
  let i = 0;
  while (i < s.len() && s[i] == 32) {
    i += 1;
  }
  return slice_unchecked(s, i, s.len()) + "";
}

function darwin_skip_quoted(s: string, i: i32): i32 {
  let n = s.len();
  let j = i + 1;
  while (j < n) {
    let c = s[j];
    if (c == 92 && j + 1 < n) {
      j += 1;
    } else if (c == 34) {
      return j + 1;
    }
    j += 1;
  }
  return n;
}

function darwin_index_of_unquoted(s: string, sub: string): i32 {
  let n = s.len();
  let m = sub.len();
  let i = 0;
  while (i < n) {
    if (s[i] == 34) {
      i = darwin_skip_quoted(s, i);
    } else if (i + m <= n && slice_unchecked(s, i, i + m) == sub) {
      return i;
    } else {
      i += 1;
    }
  }
  return -1;
}

function darwin_sysno(n: i32): i32 {
  if (n == 63) {
    return 3;
  }
  if (n == 64) {
    return 4;
  }
  if (n == 57) {
    return 6;
  }
  if (n == 56) {
    return 463;
  }
  if (n == 61) {
    return 344;
  }
  if (n == 62) {
    return 199;
  }
  if (n == 79) {
    return 470;
  }
  if (n == 35) {
    return 472;
  }
  if (n == 34) {
    return 475;
  }
  if (n == 24) {
    return 90;
  }
  if (n == 221) {
    return 59;
  }
  if (n == 260) {
    return 7;
  }
  if (n == 198) {
    return 97;
  }
  if (n == 200) {
    return 104;
  }
  if (n == 201) {
    return 106;
  }
  if (n == 202) {
    return 30;
  }
  if (n == 206) {
    return 133;
  }
  if (n == 93) {
    return 1;
  }
  if (n == 94) {
    return 1;
  }
  if (n == 222) {
    return 197;
  }
  if (n == 226) {
    return 74;
  }
  return darwin_profile_process_sysno(n);
}

function darwin_profile_process_sysno(n: i32): i32 {
  if (n == 172) {
    return 20;
  }
  if (n == 178) {
    return 372;
  }
  return darwin_profile_signal_sysno(n);
}

function darwin_profile_signal_sysno(n: i32): i32 {
  if (n == 103) {
    return 83;
  }
  if (n == 134) {
    return 46;
  }
  if (n == 132) {
    return 53;
  }
  if (n == 135) {
    return 48;
  }
  return -1;
}

function darwin_retarget_locals(line: string): string {
  let n = line.len();
  let i = 0;
  let out = "";
  let run = 0;
  while (i < n) {
    let c = line[i];
    if (c == 34) {
      i = darwin_skip_quoted(line, i);
      continue;
    } else if (c == 46 && i + 1 < n && line[i + 1] == 76
      && (i == 0 || !darwin_is_sym_byte(line[i - 1]))) {
      out += slice_unchecked(line, run, i);
      run = i + 1;
      i += 1;
      continue;
    }
    if (c == 95 && (i == 0 || !darwin_is_sym_byte(line[i - 1])) && darwin_is_reg_entry(line, i)) {
      out = out + slice_unchecked(line, run, i) + "L";
      run = i;
    }
    i += 1;
  }
  if (run == 0 && out.len() == 0) {
    return line;
  }
  return out + slice_unchecked(line, run, n);
}

function darwin_is_reg_entry(line: string, i: i32): boolean {
  if (!slice_unchecked(line, i, line.len()).starts_with("__fn_")) {
    return false;
  }
  let j = i;
  while (j < line.len() && darwin_is_sym_byte(line[j])) {
    j += 1;
  }
  return j - i > 7 && line[j - 2] == 46 && (line[j - 1] == 114 || line[j - 1] == 107);
}

function darwin_is_sym_byte(b: u8): boolean {
  if (b == 95 || b == 36 || b == 46) {
    return true;
  }
  if (b >= 48 && b <= 57) {
    return true;
  }
  if (b >= 97 && b <= 122) {
    return true;
  }
  return b >= 65 && b <= 90;
}

function darwin_feeds_svc(asm: string, from: i32): boolean {
  let n = asm.len();
  let start = from;
  let i = from;
  while (i <= n) {
    if (i == n || asm[i] == 10) {
      let body = darwin_lstrip(slice_unchecked(asm, start, i));
      if (body == "svc #0") {
        return true;
      }
      if (darwin_ends_flow(body) || body.starts_with("mov x8,") || body.starts_with("ldr x8,") || darwin_writes_x8(body)) {
        return false;
      }
      start = i + 1;
    }
    i += 1;
  }
  return false;
}

function darwin_ends_flow(body: string): boolean {
  if (body.len() > 0 && body[body.len() - 1] == 58) {
    return true;
  }
  if (body.starts_with("b.") || body.starts_with("b ") || body.starts_with("bl ") || body.starts_with("br ") || body.starts_with("blr ") || body == "ret") {
    return true;
  }
  return body.starts_with("cbz ") || body.starts_with("cbnz ") || body.starts_with("tbz ") || body.starts_with("tbnz ");
}

function darwin_writes_x8(body: string): boolean {
  let sp = darwin_index_of_unquoted(body, " ");
  if (sp < 0) {
    return false;
  }
  let op = slice_unchecked(body, 0, sp);
  if (op.starts_with("st") || op == "cmp" || op == "cmn" || op == "tst") {
    return false;
  }
  let rest = slice_unchecked(body, sp + 1, body.len());
  return rest.starts_with("x8,") || rest.starts_with("w8,");
}

pub function darwinize(asm: string): string {
  let h = buf_new(asm.len() + asm.len() / 8);
  let n = asm.len();
  let start = 0;
  let i = 0;
  let pend_sys: i32 = -1;
  let norm_n = 0;
  while (i <= n) {
    if (i == n || asm[i] == 10) {
      let line = slice_unchecked(asm, start, i);
      let has_nl = i < n;
      let body = darwin_lstrip(line);
      let keep = true;
      let out_line = line + "";

      if (body.starts_with(".type ") || body.starts_with(".size ")) {
        keep = false;
      } else if ((body.starts_with(".globl ") || body.starts_with(".weak ")) && darwin_is_reg_entry(body, darwin_index_of_unquoted(body, " ") + 1)) {
        keep = false;
      } else if (body.starts_with(".note.GNU-stack")) {
        keep = false;
      } else if (body == ".section .rodata") {
        out_line = "    .section __TEXT,__const";
      } else if (body == ".data" || body == ".section .data") {
        out_line = "    .section __DATA,__data";
      } else if (body == ".bss" || body == ".section .bss") {
        out_line = "    .section __DATA,__bss";
      } else if (body == ".section .text") {
        out_line = "    .text";
      } else if (body == ".globl _start" || body == ".global _start") {
        out_line = "    .globl _main";
      } else if (line == "_start:") {
        out_line = "_main:";
      } else if (body.starts_with("adrp ")) {
        out_line = line + "@PAGE";
      } else if (darwin_index_of_unquoted(line, ":lo12:") >= 0) {
        let idx = darwin_index_of_unquoted(line, ":lo12:");
        out_line = slice_unchecked(line, 0, idx) + slice_unchecked(line, idx + 6, line.len()) + "@PAGEOFF";
      } else if (body == "ldr x8, [sp], #16" && darwin_feeds_svc(asm, i + 1)) {
        out_line = "    ldr x16, [sp], #16";
        pend_sys = 0;
      } else if (body.starts_with("mov x8, #") && darwin_feeds_svc(asm, i + 1)) {
        let num = util.digits_to_i32(slice_unchecked(body, 9, body.len()));
        let m = darwin_sysno(num);
        pend_sys = m;
        if (m >= 0) {
          out_line = "    mov x16, #" + util.i32_to_string(m);
        }
      } else if (body == "svc #0") {
        if (pend_sys == 1) {
          out_line = "    svc #0x80";
        } else if (pend_sys >= 0) {
          let lbl = ".Ldwsc_" + util.i32_to_string(norm_n);
          norm_n += 1;
          out_line = "    svc #0x80\n    b.cc " + lbl + "\n    neg x0, x0\n" + lbl + ":";
        }
        pend_sys = -1;
      }

      if (keep) {
        buf_push(h, darwin_retarget_locals(out_line));
        if (has_nl) {
          buf_push(h, "\n");
        }
      }
      start = i + 1;
    }
    i += 1;
  }
  let text = buf_take(h);
  buf_free(h);
  return text;
}

function ssa_vstore_shuffle(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_read(reg_of, ins.args[0], "x4", s);
  let at = ssa_src(reg_of, ins.args[0], "x4");
  s = ssa_fread(reg_of, ins.args[1], "d1", s);
  s = ssa_fread(reg_of, ins.args[2], "d2", s);
  s = s.write("    mov v0.16b, " + ssa_vbytes(ssa_fsrc(reg_of, ins.args[1], "d1")) + "\n");
  s = s.write("    mov v2.16b, " + ssa_vbytes(ssa_fsrc(reg_of, ins.args[2], "d2")) + "\n    mov v1.16b, v0.16b\n");
  let pool = asmcore.shuffle_mask(s, slice_unchecked(ins.str, 15, ins.str.len()) + "");
  let label = asmcore.shuffle_mask_label(pool.state, pool.idx);
  s = pool.state.write("    adrp x16, " + label + "\n    add x16, x16, :lo12:" + label + "\n    ldr q0, [x16]\n    tbl v0.16b, {v1.16b-v2.16b}, v0.16b\n");
  if (ins.imm == 16) {
    return s.write("    str q0, [" + at + "]\n");
  }
  if (ins.imm == 4) {
    return s.write("    str s0, [" + at + "]\n");
  }
  s = s.write("    str d0, [" + at + "]\n");
  if (ins.imm == 12) {
    s = s.write("    umov w16, v0.s[2]\n    str w16, [" + at + ", #8]\n");
  }
  return s;
}
