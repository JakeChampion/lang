    s = s.write("    ldr x2, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
    s = s.write("    cmp x2, #0\n    b.ge " + a_clamped + "\n    mov x2, #0\n");
    s = s.write(a_clamped + ":\n");
    s = s.write("    cmp x2, x3\n    b.ge " + a_none + "\n");
    s = s.write("    add x5, x0, x2\n    add x6, x0, x3\n");
    s = s.write(a_vec + ":\n");
    s = s.write("    sub x7, x6, x5\n    cmp x7, #16\n    b.lt " + a_tail + "\n");
    s = s.write("    ld1 {v0.16b}, [x5]\n    cmlt v0.16b, v0.16b, #0\n");
    s = s.write("    shrn v0.8b, v0.8h, #4\n    fmov x7, d0\n");
    s = s.write("    cbz x7, " + a_next + "\n");
    s = s.write("    rbit x4, x7\n    clz x4, x4\n    lsr x4, x4, #2\n");
    s = s.write("    add x5, x5, x4\n    sub x2, x5, x0\n    b " + a_done + "\n");
    s = s.write(a_next + ":\n    add x5, x5, #16\n    b " + a_vec + "\n");
    s = s.write(a_tail + ":\n");
    s = s.write("    cmp x5, x6\n    b.ge " + a_none + "\n");
    s = s.write("    ldrb w4, [x5]\n");
    s = s.write("    tbnz w4, #7, " + a_hit + "\n");
    s = s.write("    add x5, x5, #1\n    b " + a_tail + "\n");
    s = s.write(a_hit + ":\n    sub x2, x5, x0\n    b " + a_done + "\n");
    s = s.write(a_none + ":\n    mov x2, x3\n");
    s = s.write(a_done + ":\n    str x2, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == ir.K_STR_BYTES) {
    if (ir.is_packed(o)) {
      s = s.need("str_bytes_u8");
      return s.write("    bl __fn___fern_str_bytes_u8\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    }
    s = s.need("str_bytes");
    s = s.write("    bl __fn___fern_str_bytes\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == ir.K_STR_SPLIT) {
    s = s.need("str_split");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_split\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == ir.K_STR_TO_UPPER || o.kind_tag == ir.K_STR_TO_LOWER) {
    let cfn = "__fn___fern_str_to_upper";
    if (o.kind_tag == ir.K_STR_TO_LOWER) {
      cfn = "__fn___fern_str_to_lower";
    }
    s = s.need("str_case");
    s = s.write("    bl " + cfn + "\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == ir.K_STR_REPEAT) {
    s = s.need("str_repeat");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_repeat\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == ir.K_STR_TRIM) {
    s = s.need("str_trim");
    s = s.write("    bl __fn___fern_str_trim\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == ir.K_STR_REPLACE) {
    s = s.need("str_replace");
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_replace\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == ir.K_STR_LINES) {
    s = s.need("str_lines");
    s = s.write("    bl __fn___fern_str_lines\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    return s;
  }
  ircore.unsupported_op_refuse(o.kind_tag, "arm64");
  return s;
}

function emit_scan_set(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  if (ir.is_block_scan_set(o)) {
    return emit_scan_set_blocks(o, s);
  }
  let slo = asmcore.fresh_label(s);
  let s_loop = slo.name;
  let slo2 = asmcore.fresh_label(slo.state);
  let s_short = slo2.name;
  let slo3 = asmcore.fresh_label(slo2.state);
  let s_short_next = slo3.name;
  let slo4 = asmcore.fresh_label(slo3.state);
  let s_hit = slo4.name;
  let slo5 = asmcore.fresh_label(slo4.state);
  let s_end = slo5.name;
  let slo6 = asmcore.fresh_label(slo5.state);
  let s_done = slo6.name;
  let slo7 = asmcore.fresh_label(slo6.state);
  let s_from_ok = slo7.name;
  let slo8 = asmcore.fresh_label(slo7.state);
  let s_one = slo8.name;
  let hits: string[] = [];
  s = slo8.state;
  while (hits.len() < 4) {
    let hl = asmcore.fresh_label(s);
    hits = hits.append(hl.name);
    s = hl.state;
  }
  s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
  if (o.kind_tag == ir.K_SCAN_SET_BYTES) {
    s = s.write("    ldr x3, [x0]\n    add x0, x0, #8\n");
  } else {
    s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
  }
  s = s.write("    cmp x1, #0\n    b.ge " + s_from_ok + "\n    mov x1, #0\n");
  s = s.write(s_from_ok + ":\n    ldr x4, [x2]\n");
  if (o.kind_tag != ir.K_SCAN_SET_BYTES || ir.is_packed(o)) {
    s = s.write("    cmp x4, #256\n    b.lo " + s_short + "\n");
    s = s.write("    cmp x1, x3\n    b.ge " + s_end + "\n");
    s = s.write("    add x5, x0, x1\n    add x8, x0, x3\n    sub x9, x8, #4\n    add x10, x2, #8\n");
    s = s.write(s_loop + ":\n    cmp x5, x9\n    b.hi " + s_one + "\n");
    let k = 0;
    while (k < 4) {
      s = s.write("    ldrb w6, [x5, #" + util.i32_to_string(k) + "]\n    " + set_entry_indexed(o) + "\n");
      s = s.write("    cbnz x7, " + hits[k] + "\n");
      k += 1;
    }
    s = s.write("    add x5, x5, #4\n    b " + s_loop + "\n");
    s = s.write(s_one + ":\n    cmp x5, x8\n    b.hs " + s_end + "\n");
    s = s.write("    ldrb w6, [x5]\n    " + set_entry_indexed(o) + "\n    cbnz x7, " + hits[0] + "\n");
    s = s.write("    add x5, x5, #1\n    b " + s_one + "\n");
    s = s.write(hits[3] + ":\n    add x5, x5, #1\n");
    s = s.write(hits[2] + ":\n    add x5, x5, #1\n");
    s = s.write(hits[1] + ":\n    add x5, x5, #1\n");
    s = s.write(hits[0] + ":\n    sub x1, x5, x0\n    b " + s_hit + "\n");
  }
  s = s.write(s_short + ":\n");
  s = s.write("    cmp x1, x3\n    b.ge " + s_end + "\n");
  if (o.kind_tag == ir.K_SCAN_SET_BYTES && !ir.is_packed(o)) {
    s = s.write("    add x5, x0, x1, lsl #3\n    ldrb w6, [x5]\n");
  } else {
    s = s.write("    add x5, x0, x1\n    ldrb w6, [x5]\n");
  }
  s = s.write("    cmp x6, x4\n    b.hs " + s_short_next + "\n");
  s = s.write(set_entry_load(o, "x2", "x6"));
  s = s.write("    cmp x7, #0\n    b.ne " + s_hit + "\n");
  s = s.write(s_short_next + ":\n    add x1, x1, #1\n    b " + s_short + "\n");
  s = s.write(s_hit + ":\n    str x1, [sp, #-16]!\n    b " + s_done + "\n");
  s = s.write(s_end + ":\n    str x3, [sp, #-16]!\n");
  s = s.write(s_done + ":\n");
  return s;
}

function movz_text_ok(text: string): boolean {
  let v = util.digits_to_i32(text);
  if (v < 0 || v > 65535) {
    return false;
  }
  return util.i32_to_string(v) == text;
}

function movn_text_ok(text: string): boolean {
  if (text.len() < 2 || text[0] != 45) {
    return false;
  }
  let rest = slice_unchecked(text, 1, text.len());
  return rest != "0" && movz_text_ok(rest);
}

function ssa_reg(k: i32): string {
  if (k >= ssa_fbase()) {
    return ssa_freg(k);
  }
  if (k < ssa_nregs()) {
    return ssa_caller_reg(k);
  }
  return ssa_saved_reg(k - ssa_nregs());
}

function ssa_caller_reg(k: i32): string {
  if (k == 0) {
    return "x0";
  }
  if (k == 1) {
    return "x9";
  }
  if (k == 2) {
    return "x10";
  }
  if (k == 3) {
    return "x11";
  }
  if (k == 4) {
    return "x12";
  }
  if (k == 5) {
    return "x13";
  }
  if (k == 6) {
    return "x14";
  }
  if (k == 7) {
    return "x15";
  }
  if (k == 8) {
    return "x1";
  }
  if (k == 9) {
    return "x2";
  }
  if (k == 10) {
    return "x3";
  }
  if (k == 11) {
    return "x8";
  }
  return "x30";
}

function ssa_saved_reg(k: i32): string {
  if (k == 0) {
    return "x19";
  }
  if (k == 1) {
    return "x20";
  }
  if (k == 2) {
    return "x21";
  }
  if (k == 3) {
    return "x22";
  }
  if (k == 4) {
    return "x23";
  }
  if (k == 5) {
    return "x24";
  }
  if (k == 6) {
    return "x25";
  }
  if (k == 7) {
    return "x26";
  }
  if (k == 8) {
    return "x27";
  }
  return "x28";
}

function ssa_nregs(): i32 {
  return 13;
}

function ssa_nargs(): i32 {
  return 8;
}

function ssa_nsaved(): i32 {
  return 10;
}

function ssa_fbase(): i32 {
  return ssa_nregs() + ssa_nsaved();
}

function ssa_nfregs(): i32 {
  return 16;
}

function ssa_nfsaved(): i32 {
  return 8;
}

function ssa_freg(k: i32): string {
  let i = k - ssa_fbase();
  if (i < ssa_nfregs()) {
    return "d" + util.i32_to_string(16 + i);
  }
  if (i < ssa_nfregs() + ssa_nfsaved()) {
    return "d" + util.i32_to_string(8 + i - ssa_nfregs());
  }
  return "d" + util.i32_to_string(i - ssa_nfregs() - ssa_nfsaved());
}

function ssa_farg(p: i32): i32 {
  return ssa_fbase() + ssa_nfregs() + ssa_nfsaved() + p;
}

function ssa_arg_loc(mask: string, p: i32): i32 {
  if (asmcore.float_param(mask, p) || asmcore.lane_param(mask, p)) {
    return ssa_farg(p);
  }
  return p;
}

function ssa_lane_refuse(what: string): void {
  eprint("error: " + what + ": a lane value crosses a call only as one of the first " + util.i32_to_string(ssa_nargs()) + " arguments of a direct call, or as its result");
  exit(3);
}

function ssa_lane_ret(fr: SsaFrame, reg_of: i32[], v: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (!asmcore.lane_result(fr.fmask) || v < 0) {
    return s;
  }
  return ssa_move(reg_of[v], ssa_farg(0), s);
}

function ssa_call_result(ins: ssa.SInst, reg_of: i32[], rr: string, s: asmcore.EmitState): asmcore.EmitState {
  if (!ssa.lane_result(ins)) {
    return ssa_store(reg_of, ins.result, rr, s);
  }
  if (ins.result >= 0 && reg_of[ins.result] != -1) {
    return ssa_move(ssa_farg(0), reg_of[ins.result], s);
  }
  return s;
}

function ssa_is_d(r: string): boolean {
  return r.len() > 1 && r[0] == b'd';
}

function ssa_fhome(reg_of: i32[], v: i32): string {
  if (reg_of[v] >= ssa_fbase()) {
    return ssa_freg(reg_of[v]);
  }
  return "";
}

function ssa_saved_regs(reg_of: i32[]): i32[] {
  let used = ssa_used_in(reg_of, ssa_nregs(), ssa_nregs() + ssa_nsaved());
  let fs = ssa_fbase() + ssa_nfregs();
  for k in ssa_used_in(reg_of, fs, fs + ssa_nfsaved()) {
    used = used.append(k);
  }
  return used;
}

function ssa_used_in(reg_of: i32[], from: i32, to: i32): i32[] {
  let used: i32[] = [];
  let k = from;
  while (k < to) {
    let found = false;
    for h in reg_of {
      if (h == k) {
        found = true;
      }
    }
    if (found) {
      used = used.append(k);
    }
    k += 1;
  }
  return used;
}

function ssa_save_bytes(saved: i32[]): i32 {
  let nf = ssa_count_f(saved);
  return (saved.len() - nf + 1) / 2 * 16 + nf * 16;
}

function ssa_count_f(saved: i32[]): i32 {
  let n = 0;
  for k in saved {
    if (k >= ssa_fbase()) {
      n += 1;
    }
  }
  return n;
}

function ssa_save_runs(saved: i32[]): i32[][] {
  let ints: i32[] = [];
  let fls: i32[] = [];
  for k in saved {
    if (k >= ssa_fbase()) {
      fls = fls.append(k);
    } else {
      ints = ints.append(k);
    }
  }
  return [ints, fls];
}

function ssa_save(saved: i32[], s: asmcore.EmitState): asmcore.EmitState {
  for run in ssa_save_runs(saved) {
    let i = 0;
    while (i + 1 < run.len() && run[i] < ssa_fbase()) {
      s = ssa_pair(s, false, 3, ssa_reg(run[i]), ssa_reg(run[i + 1]), -16);
      i += 2;
    }
    while (i < run.len()) {
      s = ssa_ldst_wb(s, false, true, ssa_reg(run[i]), -16);
      i += 1;
    }
  }
  return s;
}

function ssa_cfi(s: asmcore.EmitState, kind: i32, reg: string, n: i32): asmcore.EmitState {
  if (s.records()) {
    return s.cfi(kind, ssa_dwarf(reg), n);
  }
  if (kind == 1) {
    return s.write("    .cfi_startproc\n");
  }
  if (kind == 2) {
    return s.write("    .cfi_endproc\n");
  }
  if (kind == 3) {
    return s.write("    .cfi_def_cfa_offset " + util.i32_to_string(n) + "\n");
  }
  if (kind == 4) {
    return s.write("    .cfi_def_cfa_register " + reg + "\n");
  }
  if (kind == 5) {
    return s.write("    .cfi_def_cfa " + reg + ", " + util.i32_to_string(n) + "\n");
  }
  if (kind == 6) {
    return s.write("    .cfi_offset " + reg + ", " + util.i32_to_string(n) + "\n");
  }
  if (kind == 7) {
    return s.write("    .cfi_remember_state\n");
  }
  if (kind == 8) {
    return s.write("    .cfi_restore_state\n");
  }
  return s.write("    .cfi_negate_ra_state\n");
}

function ssa_dwarf(reg: string): i32 {
  if (reg == "sp") {
    return 31;
  }
  if (reg.len() < 2) {
    return 0;
  }
  let n = util.digits_to_i32(slice_unchecked(reg, 1, reg.len()) + "");
  if (ssa_is_d(reg)) {
    return 64 + n;
  }
  return n;
}

function ssa_emit_unwind(saved: i32[], canary: i32, s: asmcore.EmitState, tail: string): asmcore.EmitState {
  if (canary > 0) {
    s = fr_ldr(s, "x17", -canary);
    let ok = asmcore.fresh_label(s);
    s = ok.state;
    s = s.write("    adrp x16, __fern_canary\n    ldr x16, [x16, :lo12:__fern_canary]\n    cmp x16, x17\n    b.eq " + ok.name + "\n    b __fern_canary_fail\n" + ok.name + ":\n");
  }
  s = ssa_cfi(s, 7, "", 0);
  if (saved.len() == 0) {
    s = ssa_mov_rr(s, "sp", "x29");
  } else {
    s = ssa_addsub_imm(s, true, "sp", "x29", ssa_save_bytes(saved));
    let runs = ssa_save_runs(saved);
    let ri = runs.len();
    while (ri > 0) {
      ri -= 1;
      let run = runs[ri];
      let i = run.len();
      while (i > 0 && run[0] >= ssa_fbase()) {
        i -= 1;
        s = ssa_ldst_wb(s, true, false, ssa_reg(run[i]), 16);
      }
      if (i % 2 == 1) {
        i -= 1;
        s = ssa_ldst_wb(s, true, false, ssa_reg(run[i]), 16);
      }
      while (i >= 2) {
        i -= 2;
        s = ssa_pair(s, true, 1, ssa_reg(run[i]), ssa_reg(run[i + 1]), 16);
      }
    }
  }
  s = ssa_pair(s, true, 1, "x29", "x30", 16);
  s = ssa_cfi(s, 5, "sp", 0);
  s = ssa_sign_ra(s, "autiasp");
  if (tail == "") {
    s = ssa_ret(s);
  } else {
    s = ssa_b_sym(s, tail);
  }
  return ssa_cfi(s, 8, "", 0);
}

function ssa_exit(fr: SsaFrame, s: asmcore.EmitState, tail: string): asmcore.EmitState {
  if (fr.leaf) {
    return s.write(ssa_exit_mark() + tail + "\n");
  }
  return ssa_emit_unwind(fr.saved, fr.canary, s, tail);
}

function ssa_exit_mark(): string {
  return "    .ssa_exit ";
}

function ssa_needs_frame(text: string): boolean {
  let start = 0;
  while (start < text.len()) {
    let end = start;
    while (end < text.len() && text[end] != 10) {
      end += 1;
    }
    let line = slice_unchecked(text, start, end) + "";
    if (line.starts_with("    ") && !line.starts_with(ssa_exit_mark()) && ssa_line_needs_frame(line)) {
      return true;
    }
    start = end + 1;
  }
  return false;
}

function ssa_line_needs_frame(line: string): boolean {
  let from = 0;
  let i = 0;
  while (i <= line.len()) {
    if (i == line.len() || ssa_operand_sep(line[i])) {
      let tok = slice_unchecked(line, from, i) + "";
      if (tok == "bl" || tok == "blr" || tok == "sp" || tok == "wsp" || tok == "x29" || tok == "x30" || tok == "w29" || tok == "w30") {
        return true;
      }
      from = i + 1;
    }
    i += 1;
  }
  return false;
}

function ssa_operand_sep(c: u8): boolean {
  return c == b' ' || c == b',' || c == b'[' || c == b']' || c == b'!' || c == b'\t';
}

function leaf_aborts(): string[] {
  return ["__fern_oob_abort", "__fern_str_oob_abort", "__fern_slice_abort", "__fern_alloc_size_abort", "__fern_double_free_abort", "__fern_free_link_abort"];
}

function ssa_resolve_exits(text: string, framed: boolean, saved: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let start = 0;
  while (start < text.len()) {
    let end = start;
    while (end < text.len() && text[end] != 10) {
      end += 1;
    }
    let line = slice_unchecked(text, start, end) + "";
    if (line.starts_with(ssa_exit_mark())) {
      let tail = slice_unchecked(line, ssa_exit_mark().len(), line.len()) + "";
      if (framed) {
        s = ssa_emit_unwind(saved, 0, s, tail);
      } else if (tail == "") {
        s = s.write("    ret\n");
      } else {
        s = s.write("    b " + tail + "\n");
      }
    } else if (!framed && line.starts_with("    b ") && util.has_str(leaf_aborts(), slice_unchecked(line, 6, line.len()) + "")) {
      s = s.write(line + "_leaf\n");
    } else {
      s = s.write(line + "\n");
    }
    start = end + 1;
  }
  return s;
}

function ssa_tail_call(blk: ssa.SBlock, ins: ssa.SInst, s: asmcore.EmitState, tails: boolean): boolean {
  return tails && blk.insts.len() > 0 && ssa.returns_call(blk, blk.insts.len() - 1) && blk.insts[blk.insts.len() - 1].result == ins.result && (ssa_reg_call(ins, s) || asmcore.tail_allocator(ins) != "");
}

function ssa_calls_besides_tails(f: ssa.SFunc, s: asmcore.EmitState, tails: boolean): boolean {
  for blk in f.blocks {
    let k = 0;
    while (k < blk.insts.len()) {
      let ins = blk.insts[k];
      if (ssa.calls(ins) && !(k == blk.insts.len() - 1 && ssa_tail_call(blk, ins, s, tails))) {
        return true;
      }
      k += 1;
    }
  }
  return false;
}

function ssa_emit_tail_call(ins: ssa.SInst, reg_of: i32[], fr: SsaFrame, pos: sourcepos.SourcePos, s: asmcore.EmitState): asmcore.EmitState {
  let target = asmcore.tail_allocator(ins);
  let allocator = target != "";
  let mask = "";
  if (!allocator) {
    let name = asmcore.sanitize_label(ins.str);
    target = "__fn_" + name + ".r";
    mask = s.float_mask(name);
  } else {
    s = s.need("heap");
  }
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  if (allocator) {
    srcs = [reg_of[ins.args[0]]];
    dsts = [0];
  } else {
    let a = 0;
    while (a < ins.args.len()) {
      srcs = srcs.append(reg_of[ins.args[a]]);
      dsts = dsts.append(ssa_arg_loc(mask, a));
      a += 1;
    }
  }
  s = ssa_parallel_moves(srcs, dsts, asmcore.ssa_x0_forget(s));
  if (pos.line > 0) {
    s = asmcore.ssa_line_loc(ssa.SInst { kind_tag: ssa.LINE, result: -1, args: [], imm: pos.line, str: pos.col }, s);
  }
  return ssa_exit(fr, s, target);
}

function ssa_pair(s: asmcore.EmitState, load: boolean, mode: i32, a: string, b: string, off: i32): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_pair(load, mode, a, b, "sp", off);
    if (w >= 0) {
      return s.word(w);
    }
  }
  let m = "    stp ";
  if (load) {
    m = "    ldp ";
  }
  if (mode == 3) {
    return s.write(m + a + ", " + b + ", [sp, #" + util.i32_to_string(off) + "]!\n");
  }
  return s.write(m + a + ", " + b + ", [sp], #" + util.i32_to_string(off) + "\n");
}

function ssa_ldst_wb(s: asmcore.EmitState, load: boolean, pre: boolean, reg: string, off: i32): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_ldst_wb(load, pre, reg, "sp", off);
    if (w >= 0) {
      return s.word(w);
    }
  }
  let m = "    str ";
  if (load) {
    m = "    ldr ";
  }
  if (pre) {
    return s.write(m + reg + ", [sp, #" + util.i32_to_string(off) + "]!\n");
  }
  return s.write(m + reg + ", [sp], #" + util.i32_to_string(off) + "\n");
}

function ssa_sign_ra(s: asmcore.EmitState, op: string): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  if (s.records()) {
    s = s.word(arm64_native.arm64_fixed_word(op));
  } else {
    s = s.write("    " + op + "\n");
  }
  return ssa_cfi(s, 9, "", 0);
}

function ssa_landing_pad(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  if (s.records()) {
    return s.word(arm64_native.arm64_bti_word(["c"]));
  }
  return s.write("    bti c\n");
}

function ssa_ret(s: asmcore.EmitState): asmcore.EmitState {
  if (s.records()) {
    return s.word(arm64_native.arm64_rec_ret());
  }
  return s.write("    ret\n");
}

function ssa_ldst0(s: asmcore.EmitState, load: boolean, reg: string, base: string): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_ldst(load, reg, base, 0);
    if (w >= 0) {
      return s.word(w);
    }
  }
  let m = "    str ";
  if (load) {
    m = "    ldr ";
  }
  return s.write(m + reg + ", [" + base + "]\n");
}

function ssa_ldst_reg(s: asmcore.EmitState, load: boolean, reg: string, base: string, idx: string): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_ldst_reg(load, reg, base, idx);
    if (w >= 0) {
      return s.word(w);
    }
  }
  let m = "    str ";
  if (load) {
    m = "    ldr ";
  }
  return s.write(m + reg + ", [" + base + ", " + idx + ", lsl #3]\n");
}

function ssa_ldrb(s: asmcore.EmitState, reg: string, base: string, off: i32): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_ldrb(reg, base, off);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    ldrb " + reg + ", [" + base + ", #" + util.i32_to_string(off) + "]\n");
}

function ssa_ldrb0(s: asmcore.EmitState, reg: string, base: string): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_ldrb(reg, base, 0);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    ldrb " + reg + ", [" + base + "]\n");
}

function ssa_strb(s: asmcore.EmitState, reg: string, base: string, off: i32): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_strb(reg, base, off);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    strb " + reg + ", [" + base + ", #" + util.i32_to_string(off) + "]\n");
}

function ssa_ldrb_reg(s: asmcore.EmitState, reg: string, base: string, idx: string): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_ldrb_reg(reg, base, idx);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    ldrb " + reg + ", [" + base + ", " + idx + "]\n");
}

function ssa_lsl(s: asmcore.EmitState, d: string, n: string, sh: i32): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_lsl_imm(d, n, sh);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    lsl " + d + ", " + n + ", #" + util.i32_to_string(sh) + "\n");
}

function ssa_cmp_rr(s: asmcore.EmitState, a: string, b: string): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_addsub_reg(true, true, "", a, b);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    cmp " + a + ", " + b + "\n");
}

function ssa_addsub_rr(s: asmcore.EmitState, is_sub: boolean, d: string, a: string, b: string): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_addsub_reg(is_sub, false, d, a, b);
    if (w >= 0) {
      return s.word(w);
    }
  }
  let m = "    add ";
  if (is_sub) {
    m = "    sub ";
  }
  return s.write(m + d + ", " + a + ", " + b + "\n");
}

function ssa_tst_imm(s: asmcore.EmitState, n: string, imm: i64, text: string): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_tst_imm(n, imm);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    tst " + n + ", #" + text + "\n");
}

function ssa_and_imm(s: asmcore.EmitState, d: string, n: string, imm: i64, text: string): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_and_imm(d, n, imm);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    and " + d + ", " + n + ", #" + text + "\n");
}

function ssa_trap_guard(s: asmcore.EmitState, cond: i32, abort: string): asmcore.EmitState {
  if (s.records() && arm64_native.arm64_rec_label(abort)) {
    let ln = asmcore.lab_new(s, "1");
    s = ssa_bcond(ln.state, cond, ln.lab);
    s = s.branch(arm64_native.arm64_rec_b(false), abort);
    return s.lab_def(ln.lab);
  }
  return s.write("    b." + arm64_native.arm64_cond_name(cond) + " 1f\n    b " + abort + "\n1:\n");
}

function ssa_slot_off(v: i32): i32 {
  return 0 - 8 * (v + 1);
}

function ssa_fr_pos(s: asmcore.EmitState, off: i32, pushed: i32): i32 {
  if (s.ssa_frame <= 0) {
    return -1;
  }
  let pos = s.ssa_frame + off + pushed;
  if (pos < 0 || pos > 32760) {
    return -1;
  }
  return pos;
}

function ssa_fr_ldr(s: asmcore.EmitState, reg: string, off: i32, pushed: i32): asmcore.EmitState {
  if (ssa_lane_off(off, s)) {
    return ssa_fr_q(s, true, ssa_vq(ssa_lane_reg(reg)), off, pushed);
  }
  let pos = ssa_fr_pos(s, off - s.ssa_save, pushed);
  if (pos >= 0) {
    return ssa_ldst(s, true, reg, "sp", pos);
  }
  return fr_ldr(s, reg, off - s.ssa_save);
}

function ssa_fr_str(s: asmcore.EmitState, reg: string, off: i32, pushed: i32): asmcore.EmitState {
  if (ssa_lane_off(off, s)) {
    return ssa_fr_q(s, false, ssa_vq(ssa_lane_reg(reg)), off, pushed);
  }
  let pos = ssa_fr_pos(s, off - s.ssa_save, pushed);
  if (pos >= 0) {
    return ssa_ldst(s, false, reg, "sp", pos);
  }
  return fr_str(s, reg, off - s.ssa_save);
}

function ssa_load(reg_of: i32[], v: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
  return ssa_load_pushed(reg_of, v, reg, 0, s);
}

function ssa_load_pushed(reg_of: i32[], v: i32, reg: string, pushed: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (reg == "x4") {
    if (s.ssa_x0 == v) {
      return s;
    }
    s = asmcore.EmitState { ...s, ssa_x0: v };
  }
  if (reg_of[v] < 0) {
    return ssa_fr_ldr(s, reg, ssa_slot_off(ssa.spill_slot(reg_of[v])), pushed);
  }
  let home = ssa_reg(reg_of[v]);
  if (home == reg) {
    return s;
  }
  return ssa_mov_rr(s, reg, home);
}

function ssa_store(reg_of: i32[], v: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
  if (reg == "x4") {
    s = asmcore.EmitState { ...s, ssa_x0: v };
  }
  if (reg_of[v] == -1) {
    return s;
  }
  if (reg_of[v] < 0) {
    return ssa_fr_str(s, reg, ssa_slot_off(ssa.spill_slot(reg_of[v])), 0);
  }
  let home = ssa_reg(reg_of[v]);
  if (home == reg) {
    return s;
  }
  return ssa_mov_rr(s, home, reg);
}

function ssa_mov_rr(s: asmcore.EmitState, dst: string, src: string): asmcore.EmitState {
  if (ssa_is_d(dst) && ssa_is_d(src)) {
    return s.write("    mov " + ssa_vbytes(dst) + ", " + ssa_vbytes(src) + "\n");
  }
  if (ssa_is_d(dst) || ssa_is_d(src)) {
    return s.write("    fmov " + dst + ", " + src + "\n");
  }
  if (s.records()) {
    let w = arm64_native.arm64_rec_mov(dst, src);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    mov " + dst + ", " + src + "\n");
}

function ssa_ldst(s: asmcore.EmitState, load: boolean, reg: string, base: string, off: i32): asmcore.EmitState {
  let size = if (reg[0] == b'w') { 4 } else { 8 };
  if ((off < -256 || off > 255) && (off < 0 || off % size != 0 || off / size > 4095)) {
    return ssa_ldst_wide(s, load, reg, base, off);
  }
  if (s.records()) {
    let w = arm64_native.arm64_rec_ldst(load, reg, base, off);
    if (w >= 0) {
      return s.word(w);
    }
  }
  let m = "    str ";
  if (load) {
    m = "    ldr ";
  }
  return s.write(m + reg + ", [" + base + ", #" + util.i32_to_string(off) + "]\n");
}

// The scalar allocator reserves x16 and x17 for address calculations.
function ssa_ldst_wide(s: asmcore.EmitState, load: boolean, reg: string, base: string, off: i32): asmcore.EmitState {
  let scratch = if (reg == "x17" || reg == "w17" || base == "x17") { "w16" } else { "w17" };
  s = s.write("    movz " + scratch + ", #" + util.i32_to_string(off & 65535) + "\n");
  if (off >> 16 != 0) {
    s = s.write("    movk " + scratch + ", #" + util.i32_to_string(off >> 16 & 65535) + ", lsl #16\n");
  }
  let mnemonic = if (load) { "    ldr " } else { "    str " };
  return s.write(mnemonic + reg + ", [" + base + ", " + scratch + ", sxtw]\n");
}

function ssa_unscaled(s: asmcore.EmitState, load: boolean, reg: string, base: string, off: i32): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_unscaled(load, reg, base, off);
    if (w >= 0) {
      return s.word(w);
    }
  }
  let m = "    stur ";
  if (load) {
    m = "    ldur ";
  }
  return s.write(m + reg + ", [" + base + ", #" + util.i32_to_string(off) + "]\n");
}

function ssa_addsub_imm(s: asmcore.EmitState, is_sub: boolean, d: string, n: string, imm: i32): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_addsub_imm(is_sub, false, d, n, imm as i64);
    if (w >= 0) {
      return s.word(w);
    }
  }
  let m = "    add ";
  if (is_sub) {
    m = "    sub ";
  }
  return s.write(m + d + ", " + n + ", #" + util.i32_to_string(imm) + "\n");
}

function ssa_cmp_imm(s: asmcore.EmitState, n: string, imm: i32): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_addsub_imm(true, true, "", n, imm as i64);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    cmp " + n + ", #" + util.i32_to_string(imm) + "\n");
}

function ssa_cmp_floor(s: asmcore.EmitState, n: string): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_cmp_shifted(n, 16);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    cmp " + n + ", #16, lsl #12\n");
}

function ssa_b_sym(s: asmcore.EmitState, name: string): asmcore.EmitState {
  if (s.records() && arm64_native.arm64_rec_label(name)) {
    return s.branch(arm64_native.arm64_rec_b(false), name);
  }
  return s.write("    b " + name + "\n");
}

function ssa_bl_sym(s: asmcore.EmitState, name: string): asmcore.EmitState {
  if (s.records() && arm64_native.arm64_rec_label(name)) {
    return s.branch(arm64_native.arm64_rec_b(true), name);
  }
  return s.write("    bl " + name + "\n");
}

const COLD_CLOBBERS: i32 = 1 | 1 << 8 | 1 << 9 | 1 << 10 | 1 << 12;

const COLD_SLOTS: i32 = 8;

function ssa_cold_fixed(f: ssa.SFunc, r: irtables.Lowered, cold: i32[]): ssafixed.Table {
  let masks: i32[] = [];
  for kind in cold {
    let mask = 0;
    if (kind == ssa.COLD_SLOW || kind == ssa.COLD_BRANCH) {
      mask = COLD_CLOBBERS;
    }
    masks = masks.append(mask);
  }
  return ssafixed.with_clobbers(ssafixed.table(0, ssa_nregs(), ssa_ret_word_masks(f, r)), 0, ssa_nregs(), masks);
}

// A ret_word writes word n of the result to x(n+1) at once, so from there to
// the end of its block no other value may live in that register.
function ssa_ret_word_masks(f: ssa.SFunc, r: irtables.Lowered): i32[] {
  let masks: i32[] = [];
  for blk in f.blocks {
    let held = 0;
    for ins in blk.insts {
      masks = masks.append(held);
      if (ins.kind_tag == ssa.FLAT_OP && r.ops[ins.imm].kind_tag == ir.K_RET_WORD) {
        held = held | ssa_ret_word_mask(r.ops[ins.imm].i32_imm);
      }
    }
    masks = masks.append(held);
  }
  return masks;
}

// The allocator holds x1 to x3 at indices 8 to 10. Word n returns in x(n+1),
// and a word past x3 is in no register the allocator hands out.
function ssa_ret_word_mask(n: i32): i32 {
  if (n < 0 || n > 2) {
    return 0;
  }
  return 1 << 8 + n;
}

struct ColdSaves { by_pos: i32[], by_val: i32[], any: boolean }

function ssa_cold_saves(f: ssa.SFunc, alloc: ssa.Alloc): ColdSaves {
  let by_pos = __alloc_i32(alloc.cold.len());
  let by_val = __alloc_i32(f.nvals);
  let at: i32[] = [];
  let results: i32[] = [];
  let pos = 0;
  for b in f.blocks {
    for ins in b.insts {
      if (pos < alloc.cold.len() && (alloc.cold[pos] == ssa.COLD_SLOW || alloc.cold[pos] == ssa.COLD_BRANCH)) {
        at = at.append(pos);
        results = results.append(ins.result);
      }
      pos += 1;
    }
    pos += 1;
  }
  let live = ssa.live_masks(alloc, ssa_nregs(), at, results);
  let any = false;
  let j = 0;
  while (j < at.len()) {
    let mask = live[j] - (live[j] & COLD_CLOBBERS);
    any = any || mask != 0;
    if (alloc.cold[at[j]] == ssa.COLD_SLOW) {
      by_val = by_val.with(results[j], mask);
    } else {
      by_pos = by_pos.with(at[j], mask);
    }
    j += 1;
  }
  return ColdSaves { by_pos: by_pos, by_val: by_val, any: any };
}

function ssa_cold_mask(fr: SsaFrame, ins: ssa.SInst): i32 {
  if (ins.result < 0 || ins.result >= fr.cold.by_val.len()) {
    return 0;
  }
  return fr.cold.by_val[ins.result];
}

function ssa_cold_save(s: asmcore.EmitState, mask: i32, base: i32, load: boolean): asmcore.EmitState {
  let k = 0;
  let j = 0;
  while (k < ssa_nregs()) {
    if ((mask & 1 << k) != 0) {
      if (load) {
        s = ssa_fr_ldr(s, ssa_caller_reg(k), ssa_slot_off(base + j), 0);
      } else {
        s = ssa_fr_str(s, ssa_caller_reg(k), ssa_slot_off(base + j), 0);
      }
      j += 1;
    }
    k += 1;
  }
  return s;
}

function ssa_bl_saving(s: asmcore.EmitState, name: string, saves: SlowSaves): asmcore.EmitState {
  s = ssa_cold_save(s, saves.mask, saves.base, false);
  s = ssa_bl_sym(s, name);
  return ssa_cold_save(s, saves.mask, saves.base, true);
}

struct SlowSaves { mask: i32, base: i32 }

function ssa_b(s: asmcore.EmitState, l: asmcore.Lab): asmcore.EmitState {
  if (s.records()) {
    return s.lab_ref(arm64_native.arm64_rec_b(false), l);
  }
  return s.write("    b " + l.text() + "\n");
}

function ssa_bcond(s: asmcore.EmitState, cond: i32, l: asmcore.Lab): asmcore.EmitState {
  if (s.records()) {
    return s.lab_ref(arm64_native.arm64_rec_bcond(cond), l);
  }
  return s.write("    b." + arm64_native.arm64_cond_name(cond) + " " + l.text() + "\n");
}

function ssa_cbz(s: asmcore.EmitState, nonzero: boolean, reg: string, l: asmcore.Lab): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_cbz(nonzero, reg);
    if (w >= 0) {
      return s.lab_ref(w, l);
    }
  }
  if (nonzero) {
    return s.write("    cbnz " + reg + ", " + l.text() + "\n");
  }
  return s.write("    cbz " + reg + ", " + l.text() + "\n");
}

function ssa_tbz(s: asmcore.EmitState, nonzero: boolean, reg: string, bit: i32, l: asmcore.Lab): asmcore.EmitState {
  if (s.records()) {
    let w = arm64_native.arm64_rec_tbz(nonzero, reg, bit);
    if (w >= 0) {
      return s.lab_ref(w, l);
    }
  }
  let m = "    tbz ";
  if (nonzero) {
    m = "    tbnz ";
  }
  return s.write(m + reg + ", #" + util.i32_to_string(bit) + ", " + l.text() + "\n");
}

function ssa_blab(fr: SsaFrame, lp: string, id: i32): asmcore.Lab {
  return asmcore.Lab { id: fr.lbase + id, pre: lp, n: id };
}

function ssa_dst(reg_of: i32[], v: i32): string {
  if (ssa_in_x(reg_of, v)) {
    return ssa_reg(reg_of[v]);
  }
  return "x4";
}

function ssa_src(reg_of: i32[], v: i32, scratch: string): string {
  if (ssa_in_x(reg_of, v)) {
    return ssa_reg(reg_of[v]);
  }
  return scratch;
}

function ssa_in_x(reg_of: i32[], v: i32): boolean {
  return reg_of[v] >= 0 && reg_of[v] < ssa_fbase();
}

function ssa_read(reg_of: i32[], v: i32, scratch: string, s: asmcore.EmitState): asmcore.EmitState {
  if (ssa_in_x(reg_of, v)) {
    return s;
  }
  return ssa_load(reg_of, v, scratch, s);
}

function ssa_direct_bin(tag: i32): boolean {
  return tag == ir.K_ADD || tag == ir.K_SUB || tag == ir.K_MUL || tag == ir.K_AND || tag == ir.K_OR || tag == ir.K_XOR || tag == ir.K_MULHI_U || tag == ir.K_MULHI_S || ircore.is_int_cmp_kind(tag);
}

function ssa_div_tag(tag: i32): boolean {
  return tag == ir.K_DIV_S || tag == ir.K_DIV_U || tag == ir.K_REM_S || tag == ir.K_REM_U;
}

function ssa_bin3_asm(tag: i32, d: string, a: string, b: string): string {
  if (tag == 21) {
    return "    add " + d + ", " + a + ", " + b + "\n";
  }
  if (tag == 22) {
    return "    sub " + d + ", " + a + ", " + b + "\n";
  }
  if (tag == 23) {
    return "    mul " + d + ", " + a + ", " + b + "\n";
  }
  if (tag == 28) {
    return "    and " + d + ", " + a + ", " + b + "\n";
  }
  if (tag == 29) {
    return "    orr " + d + ", " + a + ", " + b + "\n";
  }
  if (tag == 30) {
    return "    eor " + d + ", " + a + ", " + b + "\n";
  }
  if (tag == 430) {
    return "    umulh " + d + ", " + a + ", " + b + "\n";
  }
  if (tag == 484) {
    return "    smulh " + d + ", " + a + ", " + b + "\n";
  }
  if (tag == 31) {
    return "    lsl " + d + ", " + a + ", " + b + "\n";
  }
  if (tag == 32) {
    return "    asr " + d + ", " + a + ", " + b + "\n";
  }
  if (tag == 33) {
    return "    lsr " + d + ", " + a + ", " + b + "\n";
  }
  return "    cmp " + a + ", " + b + "\n    cset " + d + ", " + ir_cmp_cond(tag, true) + "\n";
}

function ssa_imm_right(): string[] {
  return ["add", "sub", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u", "shl", "shr_s", "shr_u", "div_s", "div_u", "rem_s", "rem_u"];
}

function ssa_imm_left(): string[] {
  return ["add", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u"];
}

function ssa_rhs(fr: SsaFrame, reg_of: i32[], v: i32, scratch: string): string {
  if (fr.imm.is_imm[v]) {
    return "#" + util.i64_to_string(fr.imm.value[v]);
  }
  return ssa_src(reg_of, v, scratch);
}

function ssa_read_rhs(fr: SsaFrame, reg_of: i32[], v: i32, scratch: string, s: asmcore.EmitState): asmcore.EmitState {
  if (fr.imm.is_imm[v]) {
    return s;
  }
  return ssa_read(reg_of, v, scratch, s);
}

function ssa_rhs_scratch(reg_of: i32[], v: i32, s: asmcore.EmitState): string {
  if (!ssa_in_x(reg_of, v) && s.ssa_x0 == v) {
    return "x4";
  }
  return "x5";
}

function ssa_bin_in_place(ins: ssa.SInst, reg_of: i32[], fr: SsaFrame, s: asmcore.EmitState): asmcore.EmitState {
  return ssa_bin_sized(ins, ins.result, 64, reg_of, fr, s);
}

// A 32-bit operation writes `v` zero-extended.
function ssa_bin_sized(ins: ssa.SInst, v: i32, size: i32, reg_of: i32[], fr: SsaFrame, s: asmcore.EmitState): asmcore.EmitState {
  let tag = ir.kind_id(ins.str);
  let a = ins.args[0];
  let b = ins.args[1];
  if (fr.imm.is_imm[a] && !asmcore.ssa_shift_tag(tag)) {
    tag = ircore.flip_int_cmp_kind(tag);
    a = ins.args[1];
    b = ins.args[0];
  }
  let dh = ssa_dst(reg_of, v);
  s = ssa_read(reg_of, a, "x4", s);
  let bx = ssa_rhs_scratch(reg_of, b, s);
  s = ssa_read_rhs(fr, reg_of, b, bx, s);
  if (size == 32) {
    s = s.write(ssa_bin3_asm(tag, ssa_wreg(dh), ssa_wreg(ssa_src(reg_of, a, "x4")), ssa_rhs32(ssa_rhs(fr, reg_of, b, bx))));
    return ssa_store(reg_of, v, dh, s);
  }
  if (asmcore.ssa_shift_tag(tag) && fr.imm.is_imm[b]) {
    s = s.write(shift_imm_asm(tag, ins.imm, fr.imm.value[b], dh, ssa_src(reg_of, a, "x4")));
    return ssa_store(reg_of, v, dh, s);
  }
  if (s.records() && (tag == 21 || tag == 22)) {
    let w = ssa_addsub_word(tag == 22, dh, ssa_src(reg_of, a, "x4"), fr, reg_of, b, bx);
    if (w >= 0) {
      return ssa_store(reg_of, v, dh, s.word(w));
    }
  }
  s = s.write(ssa_bin3_asm(tag, dh, ssa_src(reg_of, a, "x4"), ssa_rhs(fr, reg_of, b, bx)));
  return ssa_store(reg_of, v, dh, s);
}

function ssa_rhs32(r: string): string {
  if (r[0] == b'x') {
    return ssa_wreg(r);
  }
  return r;
}

function ssa_addsub_word(is_sub: boolean, d: string, a: string, fr: SsaFrame, reg_of: i32[], b: i32, bx: string): i64 {
  if (fr.imm.is_imm[b]) {
    return arm64_native.arm64_rec_addsub_imm(is_sub, d == "", d, a, fr.imm.value[b]);
  }
  return arm64_native.arm64_rec_addsub_reg(is_sub, d == "", d, a, ssa_src(reg_of, b, bx));
}

function ssa_wreg(x: string): string {
  match (x[1:]) {
    Some(n) => {
      return "w" + n;
    },
    None => {
      return "w0";
    }
  }
}

function ssa_const_reg(text: string, d: string, s: asmcore.EmitState): asmcore.EmitState {
  if (movz_text_ok(text) || movn_text_ok(text)) {
    return ssa_mov_imm(s, d, text);
  }
  if (lit_text_exact(text)) {
    let w = movwide_text(util.lit_to_i64(text), d);
    if (w != "") {
      return s.write(w);
    }
  }
  return s.write("    ldr " + d + ", =" + text + "\n");
}

function movwide_text(v: i64, d: string): string {
  let ones: i64 = 0i64 - 1i64;
  let inv = v ^ ones;
  let sh = 0;
  while (sh < 64) {
    let rest = 65535i64 << sh as i64 ^ ones;
    if ((v & rest) == 0i64) {
      return "    movz " + d + ", #" + util.i64_to_string(v >> sh as i64 & 65535i64) + ", lsl #" + util.i32_to_string(sh) + "\n";
    }
    if ((inv & rest) == 0i64) {
      return "    movn " + d + ", #" + util.i64_to_string(inv >> sh as i64 & 65535i64) + ", lsl #" + util.i32_to_string(sh) + "\n";
    }
    sh += 16;
  }
  if (v >> 32i64 != 0i64) {
    return "";
  }
  let low = inv & 4294967295i64;
  if (low >> 16i64 == 0i64) {
    return "    movn " + ssa_wreg(d) + ", #" + util.i64_to_string(low) + "\n";
  }
  if ((low & 65535i64) == 0i64) {
    return "    movn " + ssa_wreg(d) + ", #" + util.i64_to_string(low >> 16i64) + ", lsl #16\n";
  }
  return "";
}

function lit_text_exact(text: string): boolean {
  if (text.len() > 2 && text[0] == b'0' && (text[1] == b'x' || text[1] == b'X')) {
    if (text.len() > 18) {
      return false;
    }
    let i = 2;
    while (i < text.len()) {
      let c = text[i];
      if (!(c >= b'0' && c <= b'9' || c >= b'a' && c <= b'f' || c >= b'A' && c <= b'F')) {
        return false;
      }
      i += 1;
    }
    return true;
  }
  return util.i64_to_string(util.lit_to_i64(text)) == text;
}

function ssa_mov_imm(s: asmcore.EmitState, d: string, text: string): asmcore.EmitState {
  if (s.records() && (movz_text_ok(text) || movn_text_ok(text))) {
    let w = arm64_native.arm64_rec_mov_imm(d, util.digits_to_i32(text) as i64);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    mov " + d + ", #" + text + "\n");
}

function ssa_adrp_add(s: asmcore.EmitState, d: string, label: string): asmcore.EmitState {
  if (s.records() && arm64_native.arm64_rec_label(label)) {
    let hi = arm64_native.arm64_rec_adrp(d);
    let lo = arm64_native.arm64_rec_add_lo12(d, d);
    if (hi >= 0 && lo >= 0) {
      return s.branch(hi, label).branch(lo, label);
    }
  }
  return s.write("    adrp " + d + ", " + label + "\n    add " + d + ", " + d + ", :lo12:" + label + "\n");
}

function ssa_unary_known(what: string): boolean {
  if (what == "!" || what == "int_extend" || what == "int_wrap" || what == "u32_wrap" || what == "load_i32") {
    return true;
  }
  if (what == "int_cast:u8" || what == "int_cast:u32" || what == "int_cast:i32") {
    return true;
  }
  return what.starts_with("rotr:") || asmcore.ssa_funary_known(what) || ssa_bits_asm(what, "x4") != "";
}

function ssa_inst_known(ins: ssa.SInst): boolean {
  let k = ins.kind_tag;
  if (ssa.lane_inst(ins)) {
    return true;
  }
  if (k == ssa.UNARY) {
    return ssa_unary_known(ins.str);
  }
  if (k >= ssa.LD_AT && k <= ssa.DYN_DISPATCH) {
    return true;
  }
  return k == ssa.CONST_INT || k == ssa.CONST_I64 || k == ssa.CONST_FLOAT || k == ssa.PARAM || k == ssa.COPY || k == ssa.PHI || k == ssa.BINARY || k == ssa.CALL || k == ssa.LINE;
}

function ssa_unsupported(f: ssa.SFunc): string {
  for blk in f.blocks {
    for ins in blk.insts {
      if (!ssa_inst_known(ins)) {
        return "ssa " + ssa.kind_name(ins.kind_tag) + " " + ins.str;
      }
    }
    if (blk.term.kind_tag > ssa.TERM_BRIF) {
      return "ssa terminator " + ssa.term_name(blk.term.kind_tag);
    }
  }
  return "";
}

function ssa_jump_on(f: ssa.SFunc, fr: SsaFrame, reg_of: i32[], lp: string, to: i32, next: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (ssa.same_fallthrough(f, fr.blk_pos, fr.imm, reg_of, to, next)) {
    return s;
  }
  return ssa_jump(fr, lp, ssa.forward_target(f, fr.blk_pos, fr.imm, reg_of, to), next, s);
}

function ssa_unary_asm(what: string, unsigned: boolean, d: string): string {
  let w = ssa_wreg(d);
  let f = ssa_fconv_asm(what, d);
  if (f == "") {
    f = ssa_bits_asm(what, d);
  }
  if (f != "") {
    return f;
  }
  if (what == "load_i32") {
    return "    ldrsw " + d + ", [" + d + "]\n";
  }
  if (what == "!") {
    return "    cmp " + d + ", #0\n    cset " + d + ", eq\n";
  }
  if (what.starts_with("rotr:")) {
    let n = util.i32_to_string(ssa.rotr_count(what));
    if (ssa.rotr_width(what) == 64) {
      return "    ror " + d + ", " + d + ", #" + n + "\n";
    }
    return "    ror " + w + ", " + w + ", #" + n + "\n";
  }
  if (what == "u32_wrap" || what == "int_cast:u32") {
    return "    mov " + w + ", " + w + "\n";
  }
  if (what == "int_cast:u8") {
    return "    and " + d + ", " + d + ", #255\n";
  }
  if (what == "int_cast:i32") {
    return "    sxtw " + d + ", " + w + "\n";
  }
  if (what == "int_extend" || what == "int_wrap") {
    if (unsigned) {
      return "    mov " + w + ", " + w + "\n";
    }
    return "    sxtw " + d + ", " + w + "\n";
  }
  return "";
}

function ssa_unary_from(what: string, unsigned: boolean, src: string, d: string): string {
  let w = ssa_wreg(d);
  let ws = ssa_wreg(src);
  if (what == "load_i32") {
    return "    ldrsw " + d + ", [" + src + "]\n";
  }
  if (what == "!") {
    return "    cmp " + src + ", #0\n    cset " + d + ", eq\n";
  }
  if (what == "int_cast:i32" || (what == "int_extend" || what == "int_wrap") && !unsigned) {
    return "    sxtw " + d + ", " + ws + "\n";
  }
  if (what == "u32_wrap" || what == "int_cast:u32" || what == "int_extend" || what == "int_wrap") {
    return "    mov " + w + ", " + ws + "\n";
  }
  if (what == "int_cast:u8") {
    return "    and " + d + ", " + src + ", #255\n";
  }
  if (what.starts_with("rotr:")) {
    let n = util.i32_to_string(ssa.rotr_count(what));
    if (ssa.rotr_width(what) == 64) {
      return "    ror " + d + ", " + src + ", #" + n + "\n";
    }
    return "    ror " + w + ", " + ws + ", #" + n + "\n";
  }
  if (what == "clz:64") {
    return "    clz " + d + ", " + src + "\n";
  }
  if (what == "bswap:64") {
    return "    rev " + d + ", " + src + "\n";
  }
  if (what == "bswap:32") {
    return "    rev " + w + ", " + ws + "\n    sxtw " + d + ", " + w + "\n";
  }
  if (what == "clz:32") {
    return "    clz " + w + ", " + ws + "\n";
  }
  if (what == "ctz:64") {
    return "    rbit " + d + ", " + src + "\n    clz " + d + ", " + d + "\n";
  }
  if (what == "ctz:32") {
    return "    rbit " + w + ", " + ws + "\n    clz " + w + ", " + w + "\n";
  }
  return "";
}

function ssa_bits_asm(what: string, d: string): string {
  let w = ssa_wreg(d);
  if (what == "clz:64") {
    return "    clz " + d + ", " + d + "\n";
  }
  if (what == "clz:32") {
    return "    clz " + w + ", " + w + "\n";
  }
  if (what == "ctz:64") {
    return "    rbit " + d + ", " + d + "\n    clz " + d + ", " + d + "\n";
  }
  if (what == "ctz:32") {
    return "    rbit " + w + ", " + w + "\n    clz " + w + ", " + w + "\n";
  }
  if (what == "popcount:64") {
    return "    fmov d0, " + d + "\n    cnt v0.8b, v0.8b\n    addv b0, v0.8b\n    fmov " + w + ", s0\n";
  }
  if (what == "popcount:32") {
    return "    fmov s0, " + w + "\n    cnt v0.8b, v0.8b\n    addv b0, v0.8b\n    fmov " + w + ", s0\n";
  }
  if (what == "bswap:64") {
    return "    rev " + d + ", " + d + "\n";
  }
  if (what == "bswap:32") {
    return "    rev " + w + ", " + w + "\n    sxtw " + d + ", " + w + "\n";
  }
  return "";
}

function ssa_fconv_asm(what: string, d: string): string {
  let w = ssa_wreg(d);
  if (what == "f32_bits") {
    return "    fmov d0, " + d + "\n    fcvt s0, d0\n    fmov " + w + ", s0\n    sxtw " + d + ", " + w + "\n";
  }
  if (what == "f32_from_bits") {
    return "    fmov s0, " + w + "\n    fcvt d0, s0\n    fmov " + d + ", d0\n";
  }
  return "";
}

function ssa_fsrc(reg_of: i32[], v: i32, scratch: string): string {
  let h = ssa_fhome(reg_of, v);
  if (h != "") {
    return h;
  }
  return scratch;
}

function ssa_fread(reg_of: i32[], v: i32, scratch: string, s: asmcore.EmitState): asmcore.EmitState {
  if (ssa_fhome(reg_of, v) != "") {
    return s;
  }
  return ssa_load(reg_of, v, scratch, s);
}

function ssa_fdst(reg_of: i32[], v: i32): string {
  return ssa_fsrc(reg_of, v, "d0");
}

function ssa_fput(reg_of: i32[], v: i32, d: string, s: asmcore.EmitState): asmcore.EmitState {
  if (d == "d0") {
    return ssa_store(reg_of, v, "d0", s);
  }
  return s;
}

function ssa_fbin(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_fread(reg_of, ins.args[0], "d0", s);
  s = ssa_fread(reg_of, ins.args[1], "d1", s);
  let a = ssa_fsrc(reg_of, ins.args[0], "d0");
  let b = ssa_fsrc(reg_of, ins.args[1], "d1");
  if (ssa.float_arith(ins.str)) {
    let d = ssa_fdst(reg_of, ins.result);
    s = s.write("    " + ins.str + " " + d + ", " + a + ", " + b + "\n");
    return ssa_fput(reg_of, ins.result, d, s);
  }
  let d = ssa_dst(reg_of, ins.result);
  s = s.write("    fcmp " + a + ", " + b + "\n    cset " + ssa_wreg(d) + ", " + ssa_fcc(ins.str) + "\n");
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_lane_off(off: i32, s: asmcore.EmitState): boolean {
  if (s.ssa_lane_slots.len() == 0) {
    return false;
  }
  let u: i32 = -off / 8 - 1;
  return u >= 0 && u < s.ssa_lane_slots.len() && s.ssa_lane_slots[u];
}

function ssa_vq(d: string): string {
  return "q" + slice_unchecked(d, 1, d.len());
}

function ssa_varr(d: string, width: i32): string {
  if (width == 32) {
    return "v" + slice_unchecked(d, 1, d.len()) + ".4s";
  }
  return "v" + slice_unchecked(d, 1, d.len()) + ".2d";
}

function ssa_vbytes(d: string): string {
  return "v" + slice_unchecked(d, 1, d.len()) + ".16b";
}

function ssa_fr_q(s: asmcore.EmitState, load: boolean, q: string, first: i32, pushed: i32): asmcore.EmitState {
  let off = first - 8;
  let m = "    str ";
  if (load) {
    m = "    ldr ";
  }
  let pos = ssa_fr_pos(s, off - s.ssa_save, pushed);
  if (pos >= 0 && pos % 16 == 0 && pos <= 65520) {
    return s.write(m + q + ", [sp, #" + util.i32_to_string(pos) + "]\n");
  }
  if (pos >= 0) {
    s = ssa_addsub_imm(s, false, "x16", "sp", pos);
  } else {
    s = fr_sub_imm(s, "x16", "x29", 0 - (off - s.ssa_save));
  }
  return s.write(m + q + ", [x16]\n");
}

function ssa_lane_inst(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let b = ssa.lane_base(ins.str);
  if (b == "vpermute") {
    return ssa_vpermute(ins, reg_of, s);
  }
  if (b == "vextract_bits") {
    s = ssa_fread(reg_of, ins.args[0], "d1", s);
    let ar = ssa_fsrc(reg_of, ins.args[0], "d1");
    let a = "v" + slice_unchecked(ar, 1, ar.len());
    let d = ssa_dst(reg_of, ins.result);
    let target = if (ins.imm == 32) { ssa_wreg(d) } else { d };
    let lane = if (ins.imm == 32) { ".s[" } else { ".d[" };
    s = s.write("    umov " + target + ", " + a + lane + util.i32_to_string(asmcore.ssa_lane_index(ins.str)) + "]\n");
    return ssa_store(reg_of, ins.result, d, s);
  }
  if (b == "vbitmask") {
    return ssa_vbitmask(ins, reg_of, s);
  }
  if (b == "vpack") {
    s = ssa_fread(reg_of, ins.args[0], "d1", s);
    s = ssa_fread(reg_of, ins.args[1], "d2", s);
    let a = slice_unchecked(ssa_fsrc(reg_of, ins.args[0], "d1"), 1, ssa_fsrc(reg_of, ins.args[0], "d1").len());
    let b = slice_unchecked(ssa_fsrc(reg_of, ins.args[1], "d2"), 1, ssa_fsrc(reg_of, ins.args[1], "d2").len());
    s = s.write("    fcvtn v0.2s, v" + a + ".2d\n    fcvtn2 v0.4s, v" + b + ".2d\n");
    let d = ssa_fdst(reg_of, ins.result);
    s = s.write("    mov v" + slice_unchecked(d, 1, d.len()) + ".16b, v0.16b\n");
    return ssa_fput(reg_of, ins.result, d, s);
  }
  if (b == "vsplat") {
    return ssa_vsplat(ins, reg_of, s);
  }
  if (b == "vextract") {
    return ssa_vextract(ins, reg_of, s);
  }
  if (b == "vreplace") {
    return ssa_vreplace(ins, reg_of, s);
  }
  if (b == "vfma" || b == "vselect") {
    return ssa_vternary(ins, reg_of, s);
  }
  if (ssa.lane_memory(b)) {
    return ssa_lane_memory(ins, reg_of, b, s);
  }
  if (ins.args.len() == 2) {
    return ssa_vbin(ins, reg_of, s);
  }
  return ssa_vunary(ins, reg_of, s);
}

function ssa_vbitmask(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_fread(reg_of, ins.args[0], "d1", s);
  let a = ssa_fsrc(reg_of, ins.args[0], "d1");
  let d = ssa_dst(reg_of, ins.result);
  let n = 128 / ins.imm;
  let k = 0;
  s = s.write("    mov " + d + ", #0\n");
  while (k < n) {
    let r = "x16";
    if (ins.imm == 32) {
      r = "w16";
    }
    s = s.write("    umov " + r + ", " + ssa_vq_lane(a, ins.imm, k) + "\n");
    s = s.write("    lsr " + r + ", " + r + ", #" + util.i32_to_string(ins.imm - 1) + "\n");
    s = s.write("    orr " + d + ", " + d + ", x16, lsl #" + util.i32_to_string(k) + "\n");
    k += 1;
  }
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_vsplat(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_fread(reg_of, ins.args[0], "d1", s);
  let a = ssa_fsrc(reg_of, ins.args[0], "d1");
  let d = ssa_fdst(reg_of, ins.result);
  if (ins.imm == 32) {
    s = s.write("    fcvt s0, " + a + "\n    dup " + ssa_varr(d, 32) + ", v0.s[0]\n");
  } else {
    s = s.write("    dup " + ssa_varr(d, 64) + ", " + ssa_vq_lane(a, 64, 0) + "\n");
  }
  return ssa_fput(reg_of, ins.result, d, s);
}

function ssa_vq_lane(d: string, width: i32, lane: i32): string {
  let t = ".d[";
  if (width == 32) {
    t = ".s[";
  }
  return "v" + slice_unchecked(d, 1, d.len()) + t + util.i32_to_string(lane) + "]";
}

function ssa_vpermute(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_fread(reg_of, ins.args[0], "d1", s);
  let ar = ssa_fsrc(reg_of, ins.args[0], "d1");
  let a = "v" + slice_unchecked(ar, 1, ar.len());
  let mode = asmcore.ssa_lane_index(ins.str);
  if (mode == 0 || mode == 3) {
    s = s.write("    mov v0.16b, " + a + ".16b\n");
    if (ins.imm == 32 && mode == 0) {
      s = s.write("    rev64 v0.4s, v0.4s\n");
    }
    s = s.write("    ext v0.16b, v0.16b, v0.16b, #8\n");
  } else {
    s = ssa_fread(reg_of, ins.args[1], "d2", s);
    let br = ssa_fsrc(reg_of, ins.args[1], "d2");
    let b = "v" + slice_unchecked(br, 1, br.len());
    let shape = if (ins.imm == 32) { ".4s" } else { ".2d" };
    s = s.write("    zip" + util.i32_to_string(mode) + " v0" + shape + ", " + a + shape + ", " + b + shape + "\n");
  }
  let d = ssa_fdst(reg_of, ins.result);
  s = s.write("    mov v" + slice_unchecked(d, 1, d.len()) + ".16b, v0.16b\n");
  return ssa_fput(reg_of, ins.result, d, s);
}

function ssa_vextract(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let lane = asmcore.ssa_lane_index(ins.str);
  s = ssa_fread(reg_of, ins.args[0], "d1", s);
  let v = ssa_fsrc(reg_of, ins.args[0], "d1");
  let d = ssa_fdst(reg_of, ins.result);
  if (ins.imm == 32) {
    s = s.write("    umov w16, " + ssa_vq_lane(v, 32, lane) + "\n    fmov s0, w16\n    fcvt " + d + ", s0\n");
  } else {
    s = s.write("    umov x16, " + ssa_vq_lane(v, 64, lane) + "\n    fmov " + d + ", x16\n");
  }
  return ssa_fput(reg_of, ins.result, d, s);
}

function ssa_vreplace(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let lane = asmcore.ssa_lane_index(ins.str);
  s = ssa_fread(reg_of, ins.args[0], "d1", s);
  s = ssa_fread(reg_of, ins.args[1], "d2", s);
  let v = ssa_fsrc(reg_of, ins.args[0], "d1");
  let x = ssa_fsrc(reg_of, ins.args[1], "d2");
  let d = ssa_fdst(reg_of, ins.result);
  let width = 64;
  let g = "x16";
  if (ins.imm == 32) {
    width = 32;
    g = "w16";
    s = s.write("    fcvt s0, " + x + "\n    fmov w16, s0\n");
  } else {
    s = s.write("    fmov x16, " + x + "\n");
  }
  if (v != d) {
    s = s.write("    mov " + ssa_vbytes(d) + ", " + ssa_vbytes(v) + "\n");
  }
  s = s.write("    ins " + ssa_vq_lane(d, width, lane) + ", " + g + "\n");
  return ssa_fput(reg_of, ins.result, d, s);
}

function ssa_vbin(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let b = ssa.lane_base(ins.str);
  s = ssa_fread(reg_of, ins.args[0], "d1", s);
  s = ssa_fread(reg_of, ins.args[1], "d2", s);
  let d = ssa_fdst(reg_of, ins.result);
  let vd = ssa_varr(d, ins.imm);
  let va = ssa_varr(ssa_fsrc(reg_of, ins.args[0], "d1"), ins.imm);
  let vb = ssa_varr(ssa_fsrc(reg_of, ins.args[1], "d2"), ins.imm);
  if (b == "vmin" || b == "vmax") {
    if (b == "vmin") {
      s = s.write("    fcmgt " + vd + ", " + va + ", " + vb + "\n");
    } else {
      s = s.write("    fcmgt " + vd + ", " + vb + ", " + va + "\n");
    }
    s = s.write("    bsl " + ssa_vbytes(d) + ", " + ssa_vbytes(ssa_fsrc(reg_of, ins.args[1], "d2")) + ", " + ssa_vbytes(ssa_fsrc(reg_of, ins.args[0], "d1")) + "\n");
  } else if (b == "vand" || b == "vor" || b == "vxor" || b == "vandnot") {
    let names: string[] = ["vand", "vor", "vxor", "vandnot"];
    let mnems: string[] = ["and", "orr", "eor", "bic"];
    s = s.write("    " + mnems[util.index_of_str(names, b)] + " " + ssa_vbytes(d) + ", " + ssa_vbytes(ssa_fsrc(reg_of, ins.args[0], "d1")) + ", " + ssa_vbytes(ssa_fsrc(reg_of, ins.args[1], "d2")) + "\n");
  } else {
    s = s.write(ssa_vbin_asm(b, vd, va, vb) + "\n");
    if (b == "vne") {
      s = s.write("    not " + ssa_vbytes(d) + ", " + ssa_vbytes(d) + "\n");
    }
  }
  return ssa_fput(reg_of, ins.result, d, s);
}

function ssa_vbin_asm(b: string, vd: string, va: string, vb: string): string {
  let names: string[] = ["vadd", "vsub", "vmul", "vdiv", "veq", "vne", "vlt", "vle", "vgt", "vge"];
  let mnems: string[] = ["fadd", "fsub", "fmul", "fdiv", "fcmeq", "fcmeq", "fcmgt", "fcmge", "fcmgt", "fcmge"];
  let swapped: boolean[] = [false, false, false, false, false, false, true, true, false, false];
  let i = util.index_of_str(names, b);
  if (swapped[i]) {
    return "    " + mnems[i] + " " + vd + ", " + vb + ", " + va;
  }
  return "    " + mnems[i] + " " + vd + ", " + va + ", " + vb;
}

function ssa_vunary(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let names: string[] = ["vsqrt", "vabs", "vneg", "vfloor", "vceil", "vtrunc", "vround"];
  let mnems: string[] = ["fsqrt", "fabs", "fneg", "frintm", "frintp", "frintz", "frinta"];
  s = ssa_fread(reg_of, ins.args[0], "d1", s);
  let d = ssa_fdst(reg_of, ins.result);
  let m = mnems[util.index_of_str(names, ssa.lane_base(ins.str))];
  s = s.write("    " + m + " " + ssa_varr(d, ins.imm) + ", " + ssa_varr(ssa_fsrc(reg_of, ins.args[0], "d1"), ins.imm) + "\n");
  return ssa_fput(reg_of, ins.result, d, s);
}

function ssa_lane_arm_at(ins: ssa.SInst, fr: SsaFrame): boolean {
  return ssa.lane_inst(ins) || ins.kind_tag == ssa.COPY && ins.result < fr.lanes.len() && fr.lanes[ins.result];
}

function ssa_lane_arm(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  if (ssa.lane_inst(ins)) {
    return ssa_lane_inst(ins, reg_of, s);
  }
  return ssa_vcopy(ins, reg_of, s);
}

function ssa_vcopy(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_fread(reg_of, ins.args[0], "d1", s);
  let a = ssa_fsrc(reg_of, ins.args[0], "d1");
  let d = ssa_fdst(reg_of, ins.result);
  if (a != d) {
    s = s.write("    mov " + ssa_vbytes(d) + ", " + ssa_vbytes(a) + "\n");
  }
  return ssa_fput(reg_of, ins.result, d, s);
}

function ssa_vternary(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_fread(reg_of, ins.args[0], "d1", s);
  s = ssa_fread(reg_of, ins.args[1], "d2", s);
  s = ssa_fread(reg_of, ins.args[2], "d3", s);
  let a = ssa_fsrc(reg_of, ins.args[0], "d1");
  let b = ssa_fsrc(reg_of, ins.args[1], "d2");
  let c = ssa_fsrc(reg_of, ins.args[2], "d3");
  let d = ssa_fdst(reg_of, ins.result);
  if (c != d) {
    s = s.write("    mov " + ssa_vbytes(d) + ", " + ssa_vbytes(c) + "\n");
  }
  if (ssa.lane_base(ins.str) == "vfma") {
    s = s.write("    fmla " + ssa_varr(d, ins.imm) + ", " + ssa_varr(a, ins.imm) + ", " + ssa_varr(b, ins.imm) + "\n");
  } else {
    s = s.write("    bsl " + ssa_vbytes(d) + ", " + ssa_vbytes(a) + ", " + ssa_vbytes(b) + "\n");
  }
  return ssa_fput(reg_of, ins.result, d, s);
}

function ssa_lane_memory(ins: ssa.SInst, reg_of: i32[], b: string, s: asmcore.EmitState): asmcore.EmitState {
  if (b == "vload" || b == "vload_f32") {
    return ssa_vload(ins, reg_of, s);
  }
  if (b == "vstore") {
    return ssa_vstore(ins, reg_of, s);
  }
  return ssa_vgroup(ins, reg_of, b == "vset", s);
}

function ssa_vload(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_read(reg_of, ins.args[0], "x4", s);
  let d = ssa_fdst(reg_of, ins.result);
  if (ins.str == "vload_f32") {
    s = s.write("    ldr d1, [" + ssa_src(reg_of, ins.args[0], "x4") + "]\n    fcvtl v0.2d, v1.2s\n    mov " + ssa_vbytes(d) + ", v0.16b\n");
  } else {
    s = s.write("    ldr " + ssa_vq(d) + ", [" + ssa_src(reg_of, ins.args[0], "x4") + "]\n");
  }
  return ssa_fput(reg_of, ins.result, d, s);
}

function ssa_vstore(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  if (ins.str.starts_with("vstore:shuffle:")) {
    return ssa_vstore_shuffle(ins, reg_of, s);
  }
  s = ssa_read(reg_of, ins.args[0], "x4", s);
  s = ssa_fread(reg_of, ins.args[1], "d1", s);
  return s.write("    str " + ssa_vq(ssa_fsrc(reg_of, ins.args[1], "d1")) + ", [" + ssa_src(reg_of, ins.args[0], "x4") + "]\n");
}

function ssa_vgroup(ins: ssa.SInst, reg_of: i32[], set: boolean, s: asmcore.EmitState): asmcore.EmitState {
  let a = ssa_src(reg_of, ins.args[0], "x4");
  s = ssa_load(reg_of, ins.args[0], a, s);
  let b = ssa_src(reg_of, ins.args[1], "x5");
  s = ssa_load(reg_of, ins.args[1], b, s);
  if (ins.str.ends_with(":bytes")) {
    if (!ins.str.ends_with(":unchecked:bytes")) {
      s = s.need("heap");
      s = ssa_ldst0(s, true, "x6", a);
      s = ssa_cmp_rr(s, b, "x6");
      s = ssa_trap_guard(s, CC_LO, "__fern_oob_abort");
      s = s.write("    sub x16, x6, " + b + "\n    cmp x16, #16\n");
      s = ssa_trap_guard(s, CC_HS, "__fern_oob_abort");
    }
    s = s.write("    add x17, " + a + ", " + b + "\n");
    if (set) {
      s = ssa_fread(reg_of, ins.args[2], "d1", s);
      return s.write("    str " + ssa_vq(ssa_fsrc(reg_of, ins.args[2], "d1")) + ", [x17, #8]\n");
    }
    let d = ssa_fdst(reg_of, ins.result);
    s = s.write("    ldr " + ssa_vq(d) + ", [x17, #8]\n");
    return ssa_fput(reg_of, ins.result, d, s);
  }
  s = s.need("heap");
  s = ssa_ldst0(s, true, "x6", a);
  s = ssa_cmp_rr(s, b, "x6");
  s = ssa_trap_guard(s, CC_LO, "__fern_oob_abort");
  s = s.write("    add x16, " + b + ", #" + util.i32_to_string(128 / ins.imm - 1) + "\n");
  s = ssa_cmp_rr(s, "x16", "x6");
  s = ssa_trap_guard(s, CC_LO, "__fern_oob_abort");
  s = s.write("    add x17, " + a + ", " + b + ", lsl #3\n");
  if (set) {
    s = ssa_fread(reg_of, ins.args[2], "d1", s);
    let v = ssa_fsrc(reg_of, ins.args[2], "d1");
    if (ins.imm == 64) {
      return s.write("    str " + ssa_vq(v) + ", [x17, #8]\n");
    }
    let n = slice_unchecked(v, 1, v.len());
    return s.write("    fcvtl v2.2d, v" + n + ".2s\n    str q2, [x17, #8]\n    fcvtl2 v2.2d, v" + n + ".4s\n    str q2, [x17, #24]\n");
  }
  let d = ssa_fdst(reg_of, ins.result);
  if (ins.imm == 64) {
    s = s.write("    ldr " + ssa_vq(d) + ", [x17, #8]\n");
  } else {
    let n = slice_unchecked(d, 1, d.len());
    s = s.write("    ldr q1, [x17, #8]\n    fcvtn v" + n + ".2s, v1.2d\n    ldr q1, [x17, #24]\n    fcvtn2 v" + n + ".4s, v1.2d\n");
  }
  return ssa_fput(reg_of, ins.result, d, s);
}

function ssa_fcc(what: string): string {
  if (what == "flt") {
    return "mi";
  }
  if (what == "fle") {
    return "ls";
  }
  if (what == "fgt") {
    return "gt";
  }
  if (what == "fge") {
    return "ge";
  }
  if (what == "feq") {
    return "eq";
  }
  return "ne";
}

function ssa_fmath_op(what: string): string {
  if (what == "fsqrt") {
    return "fsqrt";
  }
  if (what == "ffloor") {
    return "frintm";
  }
  if (what == "fceil") {
    return "frintp";
  }
  if (what == "ftrunc") {
    return "frintz";
  }
  if (what == "fround") {
    return "frinta";
  }
  if (what == "fneg") {
    return "fneg";
  }
  if (what == "fabs") {
    return "fabs";
  }
  return "";
}

function ssa_funary(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let what = ins.str;
  let unsigned = ins.imm == 1;
  let v = ins.args[0];
  if (ssa_fmath_op(what) != "") {
    s = ssa_fread(reg_of, v, "d0", s);
    let d = ssa_fdst(reg_of, ins.result);
    s = s.write("    " + ssa_fmath_op(what) + " " + d + ", " + ssa_fsrc(reg_of, v, "d0") + "\n");
    return ssa_fput(reg_of, ins.result, d, s);
  }
  if (what == "i32_to_f64:64" || what == "i32_to_f64:32") {
    s = ssa_read(reg_of, v, "x4", s);
    let src = ssa_src(reg_of, v, "x4");
    let op = "scvtf";
    if (unsigned) {
      op = "ucvtf";
      if (what == "i32_to_f64:32") {
        src = ssa_wreg(src);
      }
    }
    let d = ssa_fdst(reg_of, ins.result);
    s = s.write("    " + op + " " + d + ", " + src + "\n");
    return ssa_fput(reg_of, ins.result, d, s);
  }
  s = ssa_fread(reg_of, v, "d0", s);
  let f = ssa_fsrc(reg_of, v, "d0");
  let d = ssa_dst(reg_of, ins.result);
  if (what == "f64_to_i64" && unsigned) {
    s = s.write("    fcvtzu " + d + ", " + f + "\n");
  } else if (what == "f64_to_i64") {
    s = s.write("    fcvtzs " + d + ", " + f + "\n");
  } else if (unsigned) {
    s = s.write("    fcvtzu " + ssa_wreg(d) + ", " + f + "\n");
  } else {
    s = s.write("    fcvtzs " + ssa_wreg(d) + ", " + f + "\n    sxtw " + d + ", " + ssa_wreg(d) + "\n");
  }
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_funary_direct(what: string): boolean {
  return ssa_fmath_op(what) != "" || what == "i32_to_f64:64" || what == "i32_to_f64:32" || what == "f64_to_i32" || what == "f64_to_i64";
}

function ssa_load_abi_args(reg_of: i32[], args: i32[], count: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (count == 0 || args.len() == 0) {
    return s;
  }
  if (count == 1 || args.len() == 1) {
    return ssa_load(reg_of, args[0], "x0", s);
  }
  if (count == 2 || args.len() == 2) {
    return ssa_load_abi_pair(reg_of, args, s);
  }
  return ssa_parallel_moves([reg_of[args[0]], reg_of[args[1]], reg_of[args[2]]], [0, 8, 9], s);
}

function ssa_load_abi_pair(reg_of: i32[], args: i32[], s: asmcore.EmitState): asmcore.EmitState {
  if (reg_of[args[1]] == 0) {
    if (reg_of[args[0]] == 8) {
      return ssa_parallel_moves([8, 0], [0, 8], s);
    }
    return ssa_load(reg_of, args[0], "x0", ssa_load(reg_of, args[1], "x1", s));
  }
  return ssa_load(reg_of, args[1], "x1", ssa_load(reg_of, args[0], "x0", s));
}

function ssa_push_operand(reg_of: i32[], v: i32, pushed: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (reg_of[v] >= 0) {
    return ssa_ldst_wb(s, false, true, ssa_reg(reg_of[v]), -16);
  }
  s = ssa_load_pushed(reg_of, v, "x4", pushed, s);
  return ssa_ldst_wb(s, false, true, "x4", -16);
}

function ssa_rc_prim(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
  if (!s.retain_sites || ins.str != "__fern_rc_is_unique") {
    return ssa_rc_prim_emit(ins, reg_of, lp, s);
  }
  let h = buf_new(512);
  let site = ssaprepare.UniqueSite { input: ins.args[0], result: ins.result, input_home: reg_of[ins.args[0]], result_home: reg_of[ins.result], cached: s.ssa_x0, flags: false, aligned: ins.imm == 4, inverted: false, join: lp + "rcuniq" + util.i32_to_string(ins.result), text: "" };
  let out = ssa_rc_prim_emit(ins, reg_of, lp, asmcore.EmitState { ...s, capture: h });
  return asmcore.finish_unique_site(out, h, s.capture, site);
}

function ssa_rc_prim_emit(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
  s = helper_call_needs(ins.str, s);
  s = ssa_read(reg_of, ins.args[0], "x4", s);
  let p = ssa_src(reg_of, ins.args[0], "x4");
  let dname = lp + "rcinc" + util.i32_to_string(ins.result);
  if (ins.str == "__fern_rc_is_unique") {
    dname = lp + "rcuniq" + util.i32_to_string(ins.result);
  }
  let dn = asmcore.lab_new(s, dname);
  s = dn.state;
  let done = dn.lab;
  let base = p;
  if (ins.imm != 4) {
    base = "x7";
  }
  if (ins.str == "__fern_rc_is_unique") {
    let d = ssa_dst(reg_of, ins.result);
    s = ssa_mov_imm(s, "x6", "0");
    s = ssa_rc_guard(s, p, done, ins.imm != 4);
    s = ssa_unscaled(s, true, "w5", base, -8);
    s = s.write(san_poison_check("w5", "w7", done.text() + "us", s.rc_free_debug));
    s = ssa_cmp_imm(s, "w5", 1);
    s = ssa_bcond(s, CC_NE, done);
    s = ssa_mov_imm(s, "x6", "1");
    s = s.lab_def(done);
    s = ssa_mov_rr(s, d, "x6");
    return ssa_store(reg_of, ins.result, d, s);
  }
  s = ssa_rc_guard(s, p, done, ins.imm != 4);
  s = ssa_unscaled(s, true, "w5", base, -8);
  s = s.write(san_poison_check("w5", "w6", done.text() + "sl", s.rc_free_debug));
  s = ssa_tbz(s, true, "w5", 31, done);
  s = ssa_addsub_imm(s, false, "w5", "w5", 1);
  s = ssa_unscaled(s, false, "w5", base, -8);
  s = s.lab_def(done);
  return ssa_store(reg_of, ins.result, p, s);
}

function ssa_rc_guard(s: asmcore.EmitState, p: string, done: asmcore.Lab, strip: boolean): asmcore.EmitState {
  s = ssa_tbz(s, true, p, 0, done);
  s = ssa_cmp_floor(s, p);
  s = ssa_bcond(s, CC_LO, done);
  if (strip) {
    s = ssa_and_imm(s, "x7", p, 0 - 3i64, "0xfffffffffffffffd");
  }
  return s;
}

function ssa_helper_call(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  return ssa_helper_entry(ins, reg_of, ".r", s);
}

function ssa_helper_entry(ins: ssa.SInst, reg_of: i32[], suffix: string, s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_bl_sym(helper_arg_moves(ins, reg_of, s), ircore.ir_helper_symbol(ins.str) + suffix);
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

function helper_arg_moves(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = helper_call_needs(ins.str, s);
  let hsrc: i32[] = [];
  let hdst: i32[] = [];
  for ha in 0..ins.args.len() {
    hsrc = hsrc.append(reg_of[ins.args[ha]]);
    hdst = hdst.append(ircore.helper_arg_index(ins.str, ins.args.len(), ha));
  }
  return ssa_parallel_moves(hsrc, hdst, s);
}

// A back-reference copy runs inline when the array is unique, has room and
// dist is 8 or more. It uses only the registers a cold call clobbers: the
// array in x0, dist in x1 and n in x2. The slow call takes dist and n in x9
// and x10.
function ssa_back_copy(ins: ssa.SInst, reg_of: i32[], lp: string, saves: SlowSaves, s: asmcore.EmitState): asmcore.EmitState {
  let id = util.i32_to_string(ins.result);
  let hsrc: i32[] = [];
  let hdst: i32[] = [];
  for ha in 0..ins.args.len() {
    hsrc = hsrc.append(reg_of[ins.args[ha]]);
    hdst = hdst.append([0, 8, 9][ircore.helper_arg_index(ins.str, ins.args.len(), ha)]);
  }
  let sn = asmcore.lab_new(ssa_parallel_moves(hsrc, hdst, helper_call_needs(ins.str, s)), lp + "bcs" + id);
  let fx = asmcore.lab_new(sn.state, lp + "bcf" + id);
  let wn = asmcore.lab_new(fx.state, lp + "bcw" + id);
  let en = asmcore.lab_new(wn.state, lp + "bce" + id);
  s = ssa_ldst0(en.state, true, "x3", "x0");
  s = ssa_bcond(ssa_cmp_imm(s, "x2", 0), CC_LE, sn.lab);
  s = ssa_bcond(ssa_cmp_imm(s, "x1", 8), CC_LT, sn.lab);
  s = ssa_bcond(ssa_cmp_rr(s, "x1", "x3"), CC_GT, sn.lab);
  s = ssa_bcond(ssa_cmp_imm(ssa_unscaled(s, true, "w30", "x0", -8), "w30", 1), CC_NE, sn.lab);
  s = ssa_tbz(ssa_addsub_rr(s.write("    sxtw x30, w2\n"), false, "x2", "x3", "x30"), true, "x2", 31, fx.lab);
  s = ssa_addsub_imm(ssa_lsl(ssa_unscaled(s, true, "x30", "x0", -16), "x30", "x30", 3), true, "x30", "x30", 8);
  s = ssa_ldst0(ssa_bcond(ssa_cmp_rr(s, "x2", "x30"), CC_GT, fx.lab), false, "x2", "x0");
  s = ssa_addsub_imm(ssa_addsub_rr(s, false, "x3", "x0", "x3"), false, "x3", "x3", 8);
  s = ssa_addsub_imm(ssa_addsub_rr(s, false, "x2", "x0", "x2"), false, "x2", "x2", 8);
  s = ssa_addsub_rr(s.write("    sxtw x1, w1\n"), true, "x1", "x3", "x1").lab_def(wn.lab);
  s = ssa_ldst0(ssa_ldst0(s, true, "x30", "x1"), false, "x30", "x3");
  s = ssa_addsub_imm(ssa_addsub_imm(s, false, "x3", "x3", 8), false, "x1", "x1", 8);
  s = ssa_b(ssa_bcond(ssa_cmp_rr(s, "x3", "x2"), CC_LO, wn.lab), en.lab);
  s = ssa_addsub_rr(s.lab_def(fx.lab), true, "x2", "x2", "x3").lab_def(sn.lab);
  s = ssa_cold_save(s, saves.mask, saves.base, false);
  s = ssa_bl_sym(ssa_mov_rr(ssa_mov_rr(s, "x9", "x1"), "x10", "x2"), ircore.ir_helper_symbol(ins.str) + "_slow.r");
  s = ssa_cold_save(s, saves.mask, saves.base, true);
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s.lab_def(en.lab)));
}

// An instruction whose caller registers are saved around its call.
function ssa_saved_inst(blk: ssa.SBlock, ii: i32, reg_of: i32[], lp: string, fr: SsaFrame, r: irtables.Lowered, around: i32, own s: asmcore.EmitState): asmcore.EmitState {
  if (around != 0 && asmcore.ssa_inline_rc_dec(blk.insts[ii], s)) {
    return ssa_rc_dec(blk.insts[ii], reg_of, lp, around, fr.cold_base, asmcore.ssa_x0_forget(s));
  }
  s = ssa_cold_save(s, around, fr.cold_base, false);
  s = ssa_block_inst(blk, ii, reg_of, lp, fr, r, s);
  return ssa_cold_save(s, around, fr.cold_base, true);
}

function ssa_rc_dec(ins: ssa.SInst, reg_of: i32[], lp: string, around: i32, base: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (ins.imm == 5) {
    return ssa_helper_entry(ins, reg_of, ".u", s);
  }
  s = helper_call_needs(ins.str, s);
  s = ssa_read(reg_of, ins.args[0], "x4", s);
  let p = ssa_src(reg_of, ins.args[0], "x4");
  let id = util.i32_to_string(ins.result);
  let dn = asmcore.lab_new(s, lp + "rcdecd" + id);
  let kn = asmcore.lab_new(dn.state, lp + "rcdeck" + id);
  let en = asmcore.lab_new(kn.state, lp + "rcdece" + id);
  s = en.state;
  let dec = dn.lab;
  let kept = kn.lab;
  let done = en.lab;
  if (ins.str == "__fern_str_free") {
    s = ssa_tbz(s, true, p, 0, kept);
  }
  s = ssa_cmp_floor(s, p);
  s = ssa_bcond(s, CC_LO, kept);
  s = ssa_unscaled(s, true, "w5", p, -8);
  s = ssa_cmp_imm(s, "w5", 1);
  s = ssa_bcond(s, CC_GT, dec);
  s = ssa_tbz(s, true, "w5", 31, kept);
  s = ssa_cold_save(s, around, base, false);
  s = ssa_helper_entry(ins, reg_of, ".u", s);
  s = ssa_cold_save(s, around, base, true);
  s = ssa_b(s, done);
  s = s.lab_def(dec);
  s = ssa_addsub_imm(s, true, "w5", "w5", 1);
  s = ssa_unscaled(s, false, "w5", p, -8);
  s = s.lab_def(kept);
  s = ssa_store(reg_of, ins.result, p, s);
  return s.lab_def(done);
}

function ssa_call(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
  if (ssa.rc_inlined(ins) && !s.size) {
    return ssa_rc_prim(ins, reg_of, lp, s);
  }
  s = asmcore.ssa_x0_forget(s);
  if ((ins.str == "__fern_rc_dec" || ins.str == "__fern_str_free") && ins.args.len() == 1 && !s.rc_free_debug && !s.size) {
    return ssa_rc_dec(ins, reg_of, lp, 0, 0, s);
  }
  if (ircore.is_runtime_helper_call(ins.str, s) && (ssa_reg_helper(ircore.ir_helper_symbol(ins.str), ins.args.len()) || rtbytecopy.is_helper(ins.str))) {
    return ssa_helper_call(ins, reg_of, s);
  }
  let rr = "x0";
  if (ssa_f64_call(ins, s) && ssa_fhome(reg_of, ins.result) != "") {
    rr = "d0";
  }
  if (ssa_reg_call(ins, s)) {
    return ssa_call_result(ins, reg_of, rr, asmcore.ssa_x0_forget(ssa_reg_call_emit(ins, reg_of, s)));
  }
  let argc = ins.args.len();
  if (asmcore.has_lane_param(s.float_mask(asmcore.sanitize_label(ins.str)))) {
    ssa_lane_refuse("call of " + ins.str);
  }
  let helper = ircore.is_runtime_helper_call(ins.str, s);
  if (helper) {
    s = helper_call_needs(ins.str, s);
  } else if (ircore.is_c_call(ins.str)) {
    s = s.need("ccall:" + ins.str);
  } else if (ircore.is_task_runtime_fn(ins.str)) {
    s = s.need("task");
  }
  let i = 0;
  while (i < argc) {
    let a = i;
    if (!helper) {
      a = argc - 1 - i;
    }
    s = ssa_push_operand(reg_of, ins.args[a], i * 16, s);
    i += 1;
  }
  if (helper) {
    s = ssa_bl_sym(s, ircore.ir_helper_symbol(ins.str));
  } else {
    s = ssa_bl_sym(s, "__fn_" + asmcore.sanitize_label(ins.str));
  }
  if (argc > 0) {
    s = ssa_addsub_imm(s, false, "sp", "sp", argc * 16);
  }
  return ssa_call_result(ins, reg_of, rr, asmcore.ssa_x0_forget(s));
}

function ssa_reg_call_emit(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let mask = s.float_mask(asmcore.sanitize_label(ins.str));
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  let a = 0;
  while (a < ins.args.len()) {
    srcs = srcs.append(reg_of[ins.args[a]]);
    dsts = dsts.append(ssa_arg_loc(mask, a));
    a += 1;
  }
  s = ssa_parallel_moves(srcs, dsts, s);
  return ssa_bl_sym(s, "__fn_" + asmcore.sanitize_label(ins.str) + ".r");
}

function ssa_release_entry(entry: ssaprepare.ReleaseEntry, lp: string, s: asmcore.EmitState): asmcore.EmitState {
  if (!entry.counted) {
    return s;
  }
  let dn = asmcore.lab_new(s, lp + "release_dec");
  let kn = asmcore.lab_new(dn.state, lp + "release_kept");
  let sn = asmcore.lab_new(kn.state, lp + "release_slow");
  s = sn.state;
  let dec = dn.lab;
  let kept = kn.lab;
  let slow = sn.lab;
  s = ssa_cmp_floor(s, "x0");
  s = ssa_bcond(s, CC_LO, kept);
  s = ssa_unscaled(s, true, "w5", "x0", -8);
  s = ssa_cmp_imm(s, "w5", 1);
  s = ssa_bcond(s, CC_GT, dec);
  s = ssa_tbz(s, false, "w5", 31, slow);
  s = s.lab_def(kept);
  s = ssa_ret(ssa_mov_imm(s, "x0", "0"));
  s = s.lab_def(dec);
  s = ssa_addsub_imm(s, true, "w5", "w5", 1);
  s = ssa_unscaled(s, false, "w5", "x0", -8);
  s = ssa_ret(ssa_mov_imm(s, "x0", "0"));
  return s.lab_def(slow);
}

function ssa_mem_inst(ins: ssa.SInst, reg_of: i32[], imm: ssa.Imms, s: asmcore.EmitState): asmcore.EmitState {
  let k = ins.kind_tag;
  let a = ssa_src(reg_of, ins.args[0], "x4");
  s = ssa_load(reg_of, ins.args[0], a, s);
  let d = ssa_dst(reg_of, ins.result);
  if (ins.result >= 0 && ssa_fhome(reg_of, ins.result) != "") {
    d = ssa_fhome(reg_of, ins.result);
  }
  if (k == ssa.LD_AT) {
    s = ssa_ldst(s, true, d, a, ins.imm);
    return ssa_store(reg_of, ins.result, d, s);
  }
  if (k >= ssa.ARR_AT && imm.is_imm[ins.args[1]]) {
    return ssa_mem_at(ins, reg_of, imm.value[ins.args[1]] as i32, a, d, s);
  }
  let b = ssa_src(reg_of, ins.args[1], "x5");
  s = ssa_load(reg_of, ins.args[1], b, s);
  if (k == ssa.ST_AT && ins.str == "i32") {
    return ssa_ldst0(s, false, ssa_wreg(b), a);
  }
  if (k == ssa.ST_AT && ins.str == "u8") {
    if (ins.imm <= 4095) {
      return ssa_strb(s, ssa_wreg(b), a, ins.imm);
    }
    s = s.write("    movz x17, #" + util.i32_to_string(ins.imm & 65535) + "\n");
    if (ins.imm > 65535) {
      s = s.write("    movk x17, #" + util.i32_to_string(ins.imm >> 16 & 65535) + ", lsl #16\n");
    }
    return s.write("    strb " + ssa_wreg(b) + ", [" + a + ", x17]\n");
  }
  if (k == ssa.ST_AT) {
    return ssa_ldst(s, false, b, a, ins.imm);
  }
  if (k == ssa.ARR_AT) {
    if (ins.imm != 1) {
      s = s.need("heap");
      s = ssa_ldst0(s, true, "x6", a);
      s = ssa_cmp_rr(s, b, "x6");
      s = ssa_trap_guard(s, CC_LO, "__fern_oob_abort");
    }
    if (ins.imm == 2) {
      return s;
    }
    if (ins.str == "u8") {
      s = ssa_addsub_rr(s, false, "x5", a, b);
      s = ssa_ldrb(s, ssa_wreg(d), "x5", 8);
    } else if (ssa_is_d(d)) {
      s = s.write("    add x5, " + a + ", " + b + ", lsl #3\n");
      s = ssa_ldst(s, true, d, "x5", 8);
    } else {
      s = ssa_addsub_imm(s, false, "x5", b, 1);
      s = ssa_ldst_reg(s, true, d, a, "x5");
    }
    return ssa_store(reg_of, ins.result, d, s);
  }
  if (k == ssa.STR_AT) {
    s = s.need("heap");
    if (ins.imm != 1) {
      s = ssa_ldst(s, true, "x6", a, 8);
      s = ssa_cmp_rr(s, b, "x6");
      s = ssa_trap_guard(s, CC_LO, "__fern_str_oob_abort");
    }
    if (ins.imm == 2) {
      return s;
    }
    s = ssa_ldst0(s, true, "x6", a);
    s = ssa_ldrb_reg(s, ssa_wreg(d), "x6", b);
    return ssa_store(reg_of, ins.result, d, s);
  }
  let c = ssa_src(reg_of, ins.args[2], "x6");
  s = ssa_load(reg_of, ins.args[2], c, s);
  s = s.need("heap");
  if (ins.imm != 1) {
    s = ssa_ldst0(s, true, "x7", a);
    s = ssa_cmp_rr(s, b, "x7");
    s = ssa_trap_guard(s, CC_LO, "__fern_oob_abort");
  }
  if (ins.str == "u8") {
    s = ssa_addsub_rr(s, false, "x5", a, b);
    return ssa_strb(s, ssa_wreg(c), "x5", 8);
  }
  s = ssa_addsub_imm(s, false, "x5", b, 1);
  return ssa_ldst_reg(s, false, c, a, "x5");
}

function ssa_mem_at(ins: ssa.SInst, reg_of: i32[], c: i32, a: string, d: string, s: asmcore.EmitState): asmcore.EmitState {
  let k = ins.kind_tag;
  if (k != ssa.ARR_AT || ins.imm != 1) {
    s = s.need("heap");
  }
  if (ins.imm != 1) {
    let len_at = 0;
    let trap = "__fern_oob_abort";
    if (k == ssa.STR_AT) {
      len_at = 8;
      trap = "__fern_str_oob_abort";
    }
    s = ssa_cmp_imm(ssa_ldst(s, true, "x6", a, len_at), "x6", c);
    s = ssa_trap_guard(s, CC_HI, trap);
  }
  if (k != ssa.ARR_ST && ins.imm == 2) {
    return s;
  }
  if (k == ssa.STR_AT) {
    s = ssa_ldst0(s, true, "x6", a);
    s = ssa_ldrb(s, ssa_wreg(d), "x6", c);
    return ssa_store(reg_of, ins.result, d, s);
  }
  if (k == ssa.ARR_AT) {
    if (ins.str == "u8") {
      s = ssa_ldrb(s, ssa_wreg(d), a, 8 + c);
    } else {
      s = ssa_ldst(s, true, d, a, 8 + 8 * c);
    }
    return ssa_store(reg_of, ins.result, d, s);
  }
  let v = ssa_src(reg_of, ins.args[2], "x6");
  s = ssa_load(reg_of, ins.args[2], v, s);
  if (ins.str == "u8") {
    return ssa_strb(s, ssa_wreg(v), a, 8 + c);
  }
  return ssa_ldst(s, false, v, a, 8 + 8 * c);
}

// A runtime function compiled from Fern has a `.r` entry that takes its
// arguments in registers. Darwin replaces the bundled monotonic clock with
// an assembly body that has only the stack entry.
function ssa_register_runtime(ins: ssa.SInst, reg_of: i32[], target: string, s: asmcore.EmitState): boolean {
  if (s.runtime_target == "arm64-darwin" && target == "__fern_monotonic_ns") {
    return false;
  }
  if (ins.args.len() > ssa_nargs()) {
    return false;
  }
  for a in ins.args {
    if (reg_of[a] == -1) {
      return false;
    }
  }
  return util.has_str(rtmodule.names(asmcore.runtime_files(s, s.runtime_target)), target);
}

function ssa_str_call(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = asmcore.ssa_x0_forget(s);
  s = ssa_str_marks(ins.str, s);
  let target = "__fern_" + ssa.runtime_helper_name(ins.str);
  if (ssa_register_runtime(ins, reg_of, target, s)) {
    let srcs: i32[] = [];
    let dsts: i32[] = [];
    for a in 0..ins.args.len() {
      srcs = srcs.append(reg_of[ins.args[a]]);
      dsts = dsts.append(ssa_arg_loc("", a));
    }
    s = ssa_bl_sym(ssa_parallel_moves(srcs, dsts, s), "__fn_" + target + ".r");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  let argc = ins.args.len();
  let i = argc - 1;
  while (i >= 0) {
    s = ssa_push_operand(reg_of, ins.args[i], (argc - 1 - i) * 16, s);
    i -= 1;
  }
  s = ssa_bl_sym(s, "__fn___fern_" + ssa.runtime_helper_name(ins.str));
  if (argc > 0) {
    s = ssa_addsub_imm(s, false, "sp", "sp", argc * 16);
  }
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

function ssa_str_eq(ins: ssa.SInst, reg_of: i32[], lp: string, fr: SsaFrame, s: asmcore.EmitState): asmcore.EmitState {
  s = asmcore.ssa_x0_forget(s);
  s = s.need("str_eq");
  s = ssa_read(reg_of, ins.args[0], "x4", s);
  let a = ssa_src(reg_of, ins.args[0], "x4");
  s = ssa_read(reg_of, ins.args[1], "x5", s);
  let b = ssa_src(reg_of, ins.args[1], "x5");
  let n = util.i32_to_string(ins.result);
  let nn = asmcore.lab_new(s, lp + "streqn" + n);
  let dn = asmcore.lab_new(nn.state, lp + "streqd" + n);
  s = dn.state;
  let neq = nn.lab;
  let done = dn.lab;
  s = ssa_ldst(s, true, "x6", a, 8);
  s = ssa_ldst(s, true, "x7", b, 8);
  s = ssa_cmp_rr(s, "x6", "x7");
  s = ssa_bcond(s, CC_NE, neq);
  let lit_a = fr.lit0[ins.args[0]];
  let lit_b = fr.lit0[ins.args[1]];
  if (lit_b >= 0 || lit_a >= 0) {
    let other = a;
    let lit = lit_b;
    if (lit_b < 0) {
      other = b;
      lit = lit_a;
    }
    s = ssa_ldst0(s, true, "x6", other);
    s = ssa_ldrb0(s, "w6", "x6");
    s = ssa_cmp_imm(s, "w6", lit);
    s = ssa_bcond(s, CC_NE, neq);
  }
  s = ssa_parallel_moves([reg_of[ins.args[0]], reg_of[ins.args[1]]], [0, 1], s);
  s = ssa_bl_sym(s, "__fn___fern_str_eq.r");
  s = ssa_b(s, done);
  s = s.lab_def(neq);
  s = ssa_mov_imm(s, "x0", "0");
  s = s.lab_def(done);
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

function ssa_str_marks(op: string, s: asmcore.EmitState): asmcore.EmitState {
  if (op == "temp_dir") {
    return s.need("heap").need("monotonic_ns").need("temp_dir");
  }
  if (asmcore.ssa_host_need(op) != "") {
    return s.need("heap").need(asmcore.ssa_host_need(op));
  }
  if (asmcore.ssa_host_bare(op)) {
    return s.need(op);
  }
  if (op == "str_concat") {
    return s.need("str_concat");
  }
  if (op == "str_eq") {
    return s.need("str_eq");
  }
  if (op == "str_cmp") {
    return s.need("str_cmp");
  }
  if (op == "arr_slice") {
    return s.need("arr_slice");
  }
  if (op == "arr_slice_u8") {
    return s.need("arr_slice_u8");
  }
  if (op == "str_from_bytes_u8") {
    return s.need("str_from_bytes_u8");
  }
  if (op == "str_from_bytes_range_u8") {
    return s.need("str_from_bytes_range_u8");
  }
  if (op == "print_str") {
    return s.need("str_print");
  }
  if (op == "eprint_str") {
    return s.need("eprint");
  }
  return s.need("str_from_bytes");
}

// A system-register op. An isb after msr makes the write take effect before the
// next instruction, as a write to a control register does on x86-64.
function ssa_sysreg(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let name = slice_unchecked(ins.str, util.index_of_sub(ins.str, ":") + 1, ins.str.len()) + "";
  if (ins.str.starts_with("dev_sysreg_read")) {
    if (sysreg.arm64_encoding(name, sysreg.READ) < 0) {
      ircore.sysreg_refuse(name, "arm64");
    }
    s = s.write("    mrs x0, " + name + "\n");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  if (sysreg.arm64_encoding(name, sysreg.WRITE) < 0) {
    ircore.sysreg_refuse(name, "arm64");
  }
  s = ssa_load(reg_of, ins.args[0], "x9", s);
  s = s.write("    msr " + name + ", x9\n    isb\n    mov x0, #0\n");
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

// An atomic access of the word at x9: ldar is an acquire load and stlr a
// release store. ldaddal and casal are LSE atomics with acquire and release
// order, so each is sequentially consistent. casal compares x0 and writes
// x10, and gives the old word in x0. The operands go through the stack, as for
// an MMIO store, because x9 and x10 can hold one of them.
function ssa_atomic(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  if (ins.str == "dev_atomic_load_acquire") {
    s = ssa_load(reg_of, ins.args[0], "x9", s);
    s = s.write("    ldar x0, [x9]\n");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  let i = 0;
  while (i < ins.args.len()) {
    s = ssa_push_operand(reg_of, ins.args[i], 16 * i, s);
    i += 1;
  }
  if (ins.str == "dev_atomic_cas") {
    s = s.write("    ldr x10, [sp], #16\n    ldr x0, [sp], #16\n    ldr x9, [sp], #16\n    casal x0, x10, [x9]\n");
  } else if (ins.str == "dev_atomic_fetch_add") {
    s = s.write("    ldr x10, [sp], #16\n    ldr x9, [sp], #16\n    ldaddal x10, x0, [x9]\n");
  } else {
    s = s.write("    ldr x10, [sp], #16\n    ldr x9, [sp], #16\n    stlr x10, [x9]\n    mov x0, #0\n");
  }
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

// A cache or TLB op. A TLB op orders the table writes before it with dsb ishst,
// and waits for the invalidation on every core of the inner-shareable domain.
// tlbi vaae1is takes the page number, for every ASID. cache_sync_code cleans
// the data line to the point of unification and then drops the instruction
// line, so that a fetch on any core reads the new code.
function ssa_maintenance(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  if (ins.str == "dev_tlb_flush_all") {
    s = s.write("    dsb ishst\n    tlbi vmalle1is\n    dsb ish\n    isb\n");
  } else {
    s = ssa_load(reg_of, ins.args[0], "x9", s);
    s = s.write(arm64_maintenance_text(ins.str));
  }
  s = s.write("    mov x0, #0\n");
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

function arm64_maintenance_text(op: string): string {
  if (op == "dev_tlb_flush") {
    return "    dsb ishst\n    lsr x9, x9, #12\n    tlbi vaae1is, x9\n    dsb ish\n    isb\n";
  }
  if (op == "dev_cache_clean") {
    return "    dc cvac, x9\n";
  }
  if (op == "dev_cache_sync_code") {
    return "    dc cvau, x9\n    dsb ish\n    ic ivau, x9\n    dsb ish\n    isb\n";
  }
  return "    dc civac, x9\n";
}

// brk takes the sync exception with the class 0x3c, and elr_el1 holds its
// address. The IRQ ops set and clear the I bit of PSTATE. irq_wait runs with
// IRQs masked: a pending IRQ wakes wfi also when PSTATE masks it, so no wakeup
// is lost, and the unmask then lets its handler run before the mask returns.
function arm64_no_operand_op(op: string): string {
  if (op == "dev_breakpoint") {
    return "    brk #0\n";
  }
  if (op == "dev_irq_mask") {
    return "    msr daifset, #2\n";
  }
  if (op == "dev_irq_unmask") {
    return "    msr daifclr, #2\n";
  }
  if (op == "dev_irq_wait") {
    return "    wfi\n    msr daifclr, #2\n    msr daifset, #2\n";
  }
  return "    wfi\n";
}

function arm64_no_operand(op: string): boolean {
  return op == "dev_wfi" || op == "dev_breakpoint" || op == "dev_irq_mask" || op == "dev_irq_unmask" || op == "dev_irq_wait";
}

// A privileged op. hvc and smc take x0 to x3 and return x0, in the SMC calling
// convention. boot_info reads the x0 that the reset entry saved.
function ssa_privileged(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  if (ins.str.starts_with("dev_sysreg_")) {
    return ssa_sysreg(ins, reg_of, s);
  }
  if (ins.str.starts_with("dev_atomic_")) {
    return ssa_atomic(ins, reg_of, s);
  }
  if (ircore.maintenance_op(ins.str)) {
    return ssa_maintenance(ins, reg_of, s);
  }
  if (arm64_no_operand(ins.str)) {
    s = s.write(arm64_no_operand_op(ins.str) + "    mov x0, #0\n");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  if (ins.str == "dev_boot_info") {
    s = s.write("    adrp x0, __fern_boot_info\n    ldr x0, [x0, :lo12:__fern_boot_info]\n");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  if (ins.str == "dev_secondary_entry") {
    // The core that the entry starts takes the translation that is active now.
    s = s.need("secondary_start").write("    mrs x9, ttbr0_el1\n    adrp x10, __fern_secondary_ttbr0\n    str x9, [x10, :lo12:__fern_secondary_ttbr0]\n");
    s = s.write("    adrp x0, __fern_secondary_start\n    add x0, x0, :lo12:__fern_secondary_start\n");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  if (ins.str == "dev_irq_pending") {
    s = s.write("    adrp x0, __fern_irq_pending\n    add x0, x0, :lo12:__fern_irq_pending\n");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  if (ins.str == "dev_user_run") {
    s = ssa_load(reg_of, ins.args[0], "x0", s);
    s = s.write("    bl __fern_user_run\n");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  for i in 0..ins.args.len() {
    s = ssa_push_operand(reg_of, ins.args[i], i * 16, s);
  }
  let a = ins.args.len() - 1;
  while (a >= 0) {
    s = s.write("    ldr x" + util.i32_to_string(a) + ", [sp], #16\n");
    a -= 1;
  }
  s = s.write("    " + slice_unchecked(ins.str, 4, ins.str.len()) + " #0\n");
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

// A device op: a fence, a privileged op, or one device register access at the
// width after the colon. It is a host call to the allocator, so x0 and x9 are
// free here.
function ssa_device(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  if (ins.str == "dev_fence") {
    s = s.write("    dsb sy\n    mov x0, #0\n");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  if (ins.str.starts_with("dev_port_")) {
    ircore.unsupported_op_refuse(ir.kind_id(slice_unchecked(ins.str, 4, util.index_of_sub(ins.str, ":")) + ""), "arm64");
  }
  if (!ins.str.starts_with("dev_mmio_")) {
    return ssa_privileged(ins, reg_of, s);
  }
  let w = util.digits_to_i32(slice_unchecked(ins.str, util.index_of_sub(ins.str, ":") + 1, ins.str.len()) + "");
  if (ins.str.starts_with("dev_mmio_load")) {
    s = ssa_load(reg_of, ins.args[0], "x9", s);
    let ld = "ldr x0";
    if (w == 8) {
      ld = "ldrb w0";
    } else if (w == 16) {
      ld = "ldrh w0";
    } else if (w == 32) {
      ld = "ldrsw x0";
    }
    s = s.write("    " + ld + ", [x9]\n");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  s = ssa_push_operand(reg_of, ins.args[0], 0, s);
  s = ssa_push_operand(reg_of, ins.args[1], 16, s);
  s = s.write("    ldr x0, [sp], #16\n    ldr x9, [sp], #16\n");
  let st = "str x0";
  if (w == 8) {
    st = "strb w0";
  } else if (w == 16) {
    st = "strh w0";
  } else if (w == 32) {
    st = "str w0";
  }
  s = s.write("    " + st + ", [x9]\n    mov x0, #0\n");
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

function ssa_host_call(ins: ssa.SInst, reg_of: i32[], imm: ssa.Imms, s: asmcore.EmitState): asmcore.EmitState {
  s = asmcore.ssa_x0_forget(s);
  if (ins.str.starts_with("dev_")) {
    return ssa_device(ins, reg_of, s);
  }
  if (ins.str.starts_with("syscall")) {
    let i = 0;
    while (i < ins.args.len()) {
      s = ssa_push_operand(reg_of, ins.args[i], i * 16, s);
      i += 1;
    }
    let a = ins.args.len() - 2;
    while (a >= 0) {
      s = s.write("    ldr x" + util.i32_to_string(a) + ", [sp], #16\n");
      a -= 1;
    }
    s = s.write("    ldr x8, [sp], #16\n");
    let nr = ins.args[0];
    if (s.profile > 0 && imm.konst[nr] && imm.value[nr] == 94i64) {
      s = s.write(profile_exit_asm(s));
      s = s.write("    mov x8, #94\n");
    }
    if (imm.konst[nr]) {
      s = s.svc(imm.value[nr] as i32);
    } else {
      s = s.raw_svc("__" + ins.str);
    }
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  if (ins.str == "exit") {
    s = ssa_load(reg_of, ins.args[0], "x0", s);
    if (s.leak_check) {
      s = s.write("    mov x19, x0\n    bl __fern_lc_report_exit\n    mov x0, x19\n");
    }
    if (asmcore.process_entry(s)) {
      s = s.write(profile_exit_asm(s));
      s = s.write("    mov x8, #94\n").svc(94);
    } else {
      s = s.write(exit_provider_call(s, "x0") + "    brk #1\n");
    }
    s = s.write("    mov x0, #0\n");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  s = s.need("heap");
  s = ssa_load_abi_args(reg_of, ins.args, 2, s);
  s = s.write("    bl __fern_str_box_hdr\n");
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

function sym_addr_need(sym: string): string {
  if (sym == "__fern_scratch") {
    return "raw_scratch";
  }
  if (sym == "__fern_envp") {
    return "heap";
  }
  if (sym == "__fern_splice_pipe") {
    return "raw_splice_pipe";
  }
  if (sym == "__fern_cov_counters") {
    return "raw_cover";
  }
  if (sym == "__fern_task_state") {
    return "task";
  }
  if (sym == "__fern_vdso") {
    return "vdso";
  }
  return "";
}

function ssa_sym_addr(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  if (s.shared && ins.str == "__fern_envp" && ins.imm == 1) {
    return ssa_shared_environ(ins, reg_of, s);
  }
  if (ins.str.starts_with("__fern_arr_push_")) {
    s = s.need("heap");
  }
  if (sym_addr_need(ins.str) != "") {
    s = s.need(sym_addr_need(ins.str));
  }
  let d = ssa_dst(reg_of, ins.result);
  s = s.write("    adrp " + d + ", " + ins.str + "\n    add " + d + ", " + d + ", :lo12:" + ins.str + "\n");
  if (ins.imm == 1) {
    s = s.write("    ldr " + d + ", [" + d + "]\n");
  }
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_shared_environ(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("shared_environ");
  let d = ssa_dst(reg_of, ins.result);
  s = s.write("    adrp " + d + ", __fern_environ_slot\n    add " + d + ", " + d + ", :lo12:__fern_environ_slot\n    ldr " + d + ", [" + d + "]\n    ldr " + d + ", [" + d + "]\n");
  return ssa_store(reg_of, ins.result, d, s);
}

// The owned-allocation census takes the request of a user `__alloc` in x0.
function lc_rt_req_alloc(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.leak_check || !s.rt_owned_allocs) {
    return s;
  }
  s = s.write("    adrp x1, __fern_lc_rt_req\n    add x1, x1, :lo12:__fern_lc_rt_req\n");
  return s.write("    str x0, [x1]\n");
}

// The census takes the size of a user `__free` in x1.
function lc_rt_req_free(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    adrp x2, __fern_lc_rt_req\n    add x2, x2, :lo12:__fern_lc_rt_req\n");
  return s.write("    str x1, [x2]\n");
}

function ssa_rt_call(ins: ssa.SInst, reg_of: i32[], lp: string, saves: SlowSaves, s: asmcore.EmitState): asmcore.EmitState {
  s = asmcore.ssa_x0_forget(s);
  s = s.need("heap");
  let sym = "__fern_alloc";
  if (ins.str == "alloc_u8") {
    sym = "__fern_alloc_u8";
  } else if (ins.str == "alloc_u8_u8") {
    s = s.need("alloc_bytes");
    sym = "__fern_alloc_bytes";
  } else if (ins.str == "alloc_uninit_u8" || ins.str == "alloc_uninit") {
    s = s.need("alloc_bytes_uninit");
    sym = "__fern_alloc_bytes_uninit";
  } else if (ins.str == "arr_push_owned_u8") {
    s = s.need("arr_push_u8");
    sym = "__fern_arr_push_owned_u8";
  } else if (ins.str == "arr_push_u8") {
    s = s.need("arr_push_u8");
    sym = "__fern_arr_push_u8";
  } else if (ins.str == "raw_arr_box") {
    sym = "__fern_arr_box";
  } else if (ins.str == "args") {
    s = s.need("args");
    sym = "__fern_args";
  } else if (ins.str == "map_hash_seed") {
    s = s.need("random_i32").need("map_hash_seed");
    sym = "__fern_map_hash_seed";
  } else if (ins.str.starts_with("arr_push_owned")) {
    s = s.need("arr_push");
    sym = "__fern_arr_push_owned";
  } else if (ins.str.starts_with("arr_push")) {
    s = s.need("arr_push");
    sym = "__fern_arr_push";
  }
  s = ssa_load_abi_args(reg_of, ins.args, 2, s);
  if (ins.str == "raw_alloc") {
    s = s.write("    tbz w0, #31, 1f\n    b __fern_alloc_size_abort\n1:\n");
    s = s.write("    add x0, x0, #24\n");
  }
  if (ins.str == "alloc") {
    sym = asmcore.raw_alloc_sym(s);
    s = lc_rt_req_alloc(s);
  }
  if (ins.str.ends_with("_u8") && ins.str.starts_with("arr_push") && ins.result >= 0 && !s.rc_free_debug) {
    s = arr_push_inline_u8(sym, lp + "apush" + util.i32_to_string(ins.result), (ins.imm & 1) == 1, saves, s);
  } else if (ins.str.starts_with("arr_push") && ins.result >= 0 && !s.rc_free_debug) {
    s = arr_push_inline(sym, lp + "apush" + util.i32_to_string(ins.result), (ins.imm & 1) == 1, saves, s);
  } else {
    s = ssa_bl_saving(s, sym, saves);
  }
  if (ins.str == "raw_alloc") {
    s = s.write("    add x0, x0, #24\n");
  }
  if (ins.str == "alloc" && s.leak_check && s.rt_owned_allocs) {
    s = lc_rt_uncount(s, "__fern_lc_alloc_bytes", "__fern_lc_alloc_count");
  }
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

function lc_rt_uncount(s: asmcore.EmitState, bytes: string, count: string): asmcore.EmitState {
  s = s.write("    adrp x1, __fern_lc_rt_req\n");
  s = s.write("    add x1, x1, :lo12:__fern_lc_rt_req\n");
  s = s.write("    ldr x2, [x1]\n");
  s = s.write("    add x2, x2, #7\n");
  s = s.write("    lsr x2, x2, #3\n");
  s = s.write("    lsl x2, x2, #3\n");
  s = s.write("    adrp x1, " + bytes + "\n");
  s = s.write("    add x1, x1, :lo12:" + bytes + "\n");
  s = s.write("    ldr x3, [x1]\n");
  s = s.write("    sub x3, x3, x2\n");
  s = s.write("    str x3, [x1]\n");
  s = s.write("    adrp x1, " + count + "\n");
  s = s.write("    add x1, x1, :lo12:" + count + "\n");
  s = s.write("    ldr x2, [x1]\n");
  s = s.write("    sub x2, x2, #1\n");
  s = s.write("    str x2, [x1]\n");
  return s;
}

function arr_push_inline(sym: string, l: string, unique: boolean, saves: SlowSaves, s: asmcore.EmitState): asmcore.EmitState {
  let sn = asmcore.lab_new(s, l + "s");
  let on = asmcore.lab_new(sn.state, l + "o");
  let en = asmcore.lab_new(on.state, l + "e");
  s = en.state;
  s = ssa_ldst0(s, true, "x2", "x0");
  s = ssa_unscaled(s, true, "x3", "x0", -16);
  s = ssa_cmp_rr(s, "x2", "x3");
  s = ssa_bcond(s, CC_GE, sn.lab);
  s = push_count_test(unique, sn.lab, on.lab, s);
  s = s.lab_def(on.lab);
  s = ssa_addsub_imm(s, false, "x2", "x2", 1);
  s = ssa_ldst_reg(s, false, "x1", "x0", "x2");
  s = ssa_ldst0(s, false, "x2", "x0");
  s = ssa_b(s, en.lab);
  s = s.lab_def(sn.lab);
  s = ssa_bl_saving(s, sym, saves);
  return s.lab_def(en.lab);
}

function arr_push_inline_u8(sym: string, l: string, unique: boolean, saves: SlowSaves, s: asmcore.EmitState): asmcore.EmitState {
  let sn = asmcore.lab_new(s, l + "s");
  let on = asmcore.lab_new(sn.state, l + "o");
  let en = asmcore.lab_new(on.state, l + "e");
  s = en.state;
  s = ssa_ldst0(s, true, "x2", "x0");
  s = ssa_unscaled(s, true, "x3", "x0", -16);
  s = ssa_lsl(s, "x3", "x3", 3);
  s = ssa_cmp_rr(s, "x2", "x3");
  s = ssa_bcond(s, CC_GE, sn.lab);
  s = push_count_test(unique, sn.lab, on.lab, s);
  s = s.lab_def(on.lab);
  s = ssa_addsub_rr(s, false, "x3", "x0", "x2");
  s = ssa_strb(s, "w1", "x3", 8);
  s = ssa_addsub_imm(s, false, "x2", "x2", 1);
  s = ssa_ldst0(s, false, "x2", "x0");
  s = ssa_b(s, en.lab);
  s = s.lab_def(sn.lab);
  s = ssa_bl_saving(s, sym, saves);
  return s.lab_def(en.lab);
}

function push_count_test(unique: boolean, slow: asmcore.Lab, ok: asmcore.Lab, s: asmcore.EmitState): asmcore.EmitState {
  if (unique) {
    return s;
  }
  s = ssa_unscaled(s, true, "w3", "x0", -8);
  s = ssa_cmp_imm(s, "w3", 1);
  s = ssa_bcond(s, CC_EQ, ok);
  return ssa_tbz(s, false, "w3", 31, slow);
}

function ssa_str_view(ins: ssa.SInst, reg_of: i32[], base_off: i32, s: asmcore.EmitState): asmcore.EmitState {
  s = asmcore.ssa_x0_forget(s);
  if (ins.imm == 2) {
    return ssa_frame_box(ins, reg_of, base_off, s);
  }
  s = s.need("heap");
  s = ssa_load_abi_args(reg_of, ins.args, 3, s);
  s = ssa_ldst(s, true, "x3", "x0", 8);
  s = ssa_cmp_rr(s, "x2", "x3");
  s = ssa_trap_guard(s, CC_LS, "__fern_str_oob_abort");
  s = ssa_cmp_rr(s, "x1", "x2");
  s = ssa_trap_guard(s, CC_LS, "__fern_str_oob_abort");
  s = ssa_addsub_rr(s, true, "x2", "x2", "x1");
  s = ssa_ldst0(s, true, "x3", "x0");
  s = ssa_addsub_rr(s, false, "x1", "x3", "x1");
  if (ins.imm == 1) {
    s = fr_sub_imm(s, "x0", "x29", -base_off);
    s = ssa_mov_imm(s, "x3", "-1");
    s = ssa_ldst0(s, false, "x3", "x0");
  } else {
    s = ssa_pair(s, false, 3, "x1", "x2", -16);
    s = ssa_mov_imm(s, "x0", "24");
    s = ssa_bl_sym(s, "__fern_alloc");
    s = ssa_pair(s, true, 1, "x1", "x2", 16);
    s = ssa_mov_imm(s, "w3", "1");
    s = ssa_ldst0(s, false, "w3", "x0");
    s = mov_borrowed_marker(s, "w3");
    s = ssa_ldst(s, false, "w3", "x0", 4);
  }
  s = ssa_ldst(s, false, "x1", "x0", 8);
  s = ssa_ldst(s, false, "x2", "x0", 16);
  s = ssa_addsub_imm(s, false, "x0", "x0", 8);
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

function ssa_frame_box(ins: ssa.SInst, reg_of: i32[], base_off: i32, s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_load_abi_args(reg_of, ins.args, 2, s);
  s = fr_sub_imm(s, "x2", "x29", -base_off);
  s = ssa_mov_imm(s, "x3", "-1");
  s = ssa_ldst0(s, false, "x3", "x2");
  s = ssa_ldst(s, false, "x0", "x2", 8);
  s = ssa_ldst(s, false, "x1", "x2", 16);
  s = ssa_addsub_imm(s, false, "x0", "x2", 8);
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

struct SsaFrame { nspill: i32, views: i32[], blk_pos: i32[], uses: i32[], nsave: i32, saved: i32[], imm: ssa.Imms, lit0: i32[], lbase: i32, leaf: boolean, fmask: string, lanes: boolean[], cold: ColdSaves, cold_base: i32, canary: i32 }

struct SsaFuse { n: i32, tag: i32, inverted: boolean, a: i32, b: i32, unique: boolean, aligned: boolean }

// What deciding a fusion reads: the use counts and the immediates. The
// allocator decides with it before a frame exists.
struct FuseView { uses: i32[], imm: ssa.Imms }

function ssa_fuse_view(fr: SsaFrame): FuseView {
  return FuseView { uses: fr.uses, imm: fr.imm };
}

function ssa_no_fuse(): SsaFuse {
  return SsaFuse { n: 0, tag: 0, inverted: false, a: 0, b: 0, unique: false, aligned: false };
}

function ssa_retain_fusion(rows: ssaprepare.Fusion[], fu: SsaFuse, retain: boolean): ssaprepare.Fusion[] {
  if (!retain) {
    return rows;
  }
  return rows.append(ssaprepare.Fusion { n: fu.n, tag: fu.tag, inverted: fu.inverted, a: fu.a, b: fu.b, unique: fu.unique, aligned: fu.aligned, test: false });
}

function ssa_fuse(fv: FuseView, blk: ssa.SBlock): SsaFuse {
  let t = blk.term;
  if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f || blk.insts.len() == 0) {
    return ssa_no_fuse();
  }
  let last = blk.insts[blk.insts.len() - 1];
  if (last.result != t.cond || fv.uses[last.result] != 1) {
    return ssa_no_fuse();
  }
  let cmp = last;
  let n = 1;
  let inverted = false;
  if (last.kind_tag == ssa.UNARY && last.str == "!") {
    let value_test = SsaFuse { n: 1, tag: 0, inverted: true, a: last.args[0], b: 0, unique: false, aligned: false };
    if (blk.insts.len() < 2) {
      return value_test;
    }
    cmp = blk.insts[blk.insts.len() - 2];
    if (cmp.result != last.args[0] || fv.uses[cmp.result] != 1) {
      return value_test;
    }
    if (!ssa.unique_test(cmp) && !ssa_fusable_cmp(cmp)) {
      return value_test;
    }
    n = 2;
    inverted = true;
  }
  if (ssa.unique_test(cmp)) {
    return SsaFuse { n: n, tag: ir.K_EQ, inverted: inverted, a: cmp.args[0], b: 0, unique: true, aligned: cmp.imm == 4 };
  }
  if (!ssa_fusable_cmp(cmp)) {
    return ssa_no_fuse();
  }
  if (ssa.float_cmp(cmp.str)) {
    return SsaFuse { n: n, tag: ir.kind_id(cmp.str), inverted: inverted, a: cmp.args[0], b: cmp.args[1], unique: false, aligned: false };
  }
  if (fv.imm.is_imm[cmp.args[0]]) {
    return SsaFuse { n: n, tag: ircore.flip_int_cmp_kind(ir.kind_id(cmp.str)), inverted: inverted, a: cmp.args[1], b: cmp.args[0], unique: false, aligned: false };
  }
  return SsaFuse { n: n, tag: ir.kind_id(cmp.str), inverted: inverted, a: cmp.args[0], b: cmp.args[1], unique: false, aligned: false };
}

function ssa_fusable_cmp(cmp: ssa.SInst): boolean {
  return cmp.kind_tag == ssa.BINARY && (ircore.is_int_cmp_kind(ir.kind_id(cmp.str)) || ssa.float_cmp(cmp.str));
}

function ssa_block_inst(blk: ssa.SBlock, ii: i32, reg_of: i32[], lp: string, fr: SsaFrame, r: irtables.Lowered, own s: asmcore.EmitState): asmcore.EmitState {
  let ins = blk.insts[ii];
  if (ins.kind_tag == ssa.SELECT) {
    return ssa_select(ins, reg_of, fr, ssa_select_fuse(ssa_fuse_view(fr), blk, ii), s);
  }
  if (ins.kind_tag == ssa.BINARY && ins.str == "and_not") {
    return ssa_and_not(ins, reg_of, s);
  }
  if (ssa.carry_triple(blk, ii, fr.uses)) {
    return ssa_carried_sum(ins, reg_of, s);
  }
  if (ssa.carry_triple(blk, ii - 1, fr.uses)) {
    return s;
  }
  if (ssa.carry_triple(blk, ii - 2, fr.uses)) {
    return ssa_carry_reader(ins, blk.insts[ii - 1].result, reg_of, s);
  }
  if (ins.kind_tag == ssa.CARRY) {
    return ssa_carry(ins, reg_of, s);
  }
  if (ssa.low_word_pair(blk, ii, fr.uses)) {
    return s;
  }
  if (ssa.low_word_pair(blk, ii - 1, fr.uses)) {
    return ssa_bin_sized(blk.insts[ii - 1], ins.result, 32, reg_of, fr, s);
  }
  if (ins.kind_tag == ssa.PARAM || ins.kind_tag == ssa.PHI || ssa_feeds_select(fr, blk, ii + 1)) {
    return s;
  }
  return ssa_inst(ins, reg_of, fr, lp, r, s);
}

struct SelectCond { fu: SsaFuse, first: boolean }

// Whether the instruction at ii is a select that takes the flags of the compare
// before it, so that the compare emits nothing of its own.
function ssa_feeds_select(fr: SsaFrame, blk: ssa.SBlock, ii: i32): boolean {
  return ssa.select_at(blk, ii) && ssa_select_fuse(ssa_fuse_view(fr), blk, ii).fu.n > 0;
}

function ssa_select_fuse(fv: FuseView, blk: ssa.SBlock, ii: i32): SelectCond {
  let none = SelectCond { fu: ssa_no_fuse(), first: false };
  if (!ssa.select_at(blk, ii)) {
    return none;
  }
  let c = blk.insts[ii].args[0];
  let run = ssa.select_run(blk, ii);
  if (run[0] < 1 || fv.uses[c] != run[1] - run[0]) {
    return none;
  }
  let cmp = blk.insts[run[0] - 1];
  if (cmp.result != c || !ssa_fusable_cmp(cmp)) {
    return none;
  }
  return SelectCond { fu: ssa_cmp_flags(fv, cmp), first: ii == run[0] };
}

function ssa_cmp_flags(fv: FuseView, cmp: ssa.SInst): SsaFuse {
  if (!ssa.float_cmp(cmp.str) && fv.imm.is_imm[cmp.args[0]]) {
    return SsaFuse { n: 1, tag: ircore.flip_int_cmp_kind(ir.kind_id(cmp.str)), inverted: false, a: cmp.args[1], b: cmp.args[0], unique: false, aligned: false };
  }
  return SsaFuse { n: 1, tag: ir.kind_id(cmp.str), inverted: false, a: cmp.args[0], b: cmp.args[1], unique: false, aligned: false };
}

function ssa_select(ins: ssa.SInst, reg_of: i32[], fr: SsaFrame, sc: SelectCond, s: asmcore.EmitState): asmcore.EmitState {
  let cc = CC_NE;
  if (sc.fu.n > 0) {
    if (sc.first) {
      s = ssa_fused_test_emit(fr, reg_of, sc.fu, "", s);
    }
    cc = ssa_fuse_cc(sc.fu, true);
  } else {
    s = ssa_read(reg_of, ins.args[0], "x4", s);
    s = s.write("    cmp " + ssa_src(reg_of, ins.args[0], "x4") + ", #0\n");
  }
  if (reg_of[ins.result] == -1) {
    return s;
  }
  let a = ssa_select_operand(reg_of, ins.args[1], "x5", s);
  s = ssa_select_load(reg_of, ins.args[1], a, s);
  let b = ssa_select_operand(reg_of, ins.args[2], "x6", s);
  s = ssa_select_load(reg_of, ins.args[2], b, s);
  let d = ssa_dst(reg_of, ins.result);
  s = s.write("    csel " + d + ", " + a + ", " + b + ", " + arm64_native.arm64_cond_name(cc) + "\n");
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_and_not(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let a = ssa_src(reg_of, ins.args[0], "x5");
  s = ssa_load(reg_of, ins.args[0], a, s);
  let b = ssa_src(reg_of, ins.args[1], "x6");
  s = ssa_load(reg_of, ins.args[1], b, s);
  let d = ssa_dst(reg_of, ins.result);
  s = s.write("    bic " + d + ", " + a + ", " + b + "\n");
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_carried_sum(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let x = ssa_src(reg_of, ins.args[0], "x5");
  s = ssa_load(reg_of, ins.args[0], x, s);
  let y = ssa_src(reg_of, ins.args[1], "x6");
  s = ssa_load(reg_of, ins.args[1], y, s);
  let d = ssa_dst(reg_of, ins.result);
  let op: string = if (ins.str == "sub") { "subs" } else { "adds" };
  s = s.write("    " + op + " " + d + ", " + x + ", " + y + "\n");
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_carry_reader(ins: ssa.SInst, carry: i32, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let other = ins.args[0];
  if (other == carry) {
    other = ins.args[1];
  }
  let h = ssa_src(reg_of, other, "x5");
  s = ssa_load(reg_of, other, h, s);
  let d = ssa_dst(reg_of, ins.result);
  let op: string = if (ins.str == "sub") { "sbc" } else { "adc" };
  s = s.write("    " + op + " " + d + ", " + h + ", xzr\n");
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_carry(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  if (reg_of[ins.result] == -1) {
    return s;
  }
  let sub = ins.imm == 1;
  if (ins.args.len() == 3) {
    let c = ssa_src(reg_of, ins.args[2], "x4");
    s = ssa_load(reg_of, ins.args[2], c, s);
    if (sub) {
      s = s.write("    negs xzr, " + c + "\n");
    } else {
      s = s.write("    cmp " + c + ", #1\n");
    }
  }
  let x = ssa_src(reg_of, ins.args[0], "x5");
  s = ssa_load(reg_of, ins.args[0], x, s);
  let y = ssa_src(reg_of, ins.args[1], "x6");
  s = ssa_load(reg_of, ins.args[1], y, s);
  if (ins.args.len() == 3) {
    let op: string = if (sub) { "sbcs" } else { "adcs" };
    s = s.write("    " + op + " xzr, " + x + ", " + y + "\n");
  } else if (sub) {
    s = s.write("    cmp " + x + ", " + y + "\n");
  } else {
    s = s.write("    cmn " + x + ", " + y + "\n");
  }
  let d = ssa_dst(reg_of, ins.result);
  let cc: string = if (sub) { "lo" } else { "hs" };
  s = s.write("    cset " + d + ", " + cc + "\n");
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_select_operand(reg_of: i32[], v: i32, scratch: string, s: asmcore.EmitState): string {
  if (ssa_in_x(reg_of, v)) {
    return ssa_reg(reg_of[v]);
  }
  if (s.ssa_x0 == v) {
    return "x4";
  }
  return scratch;
}

function ssa_select_load(reg_of: i32[], v: i32, at: string, s: asmcore.EmitState): asmcore.EmitState {
  if (at == "x5" || at == "x6") {
    return ssa_load(reg_of, v, at, s);
  }
  return s;
}

function ssa_view_off(fr: SsaFrame, v: i32): i32 {
  let first = fr.nspill + 3 * fr.views[v];
  return 0 - 8 * (first + 3) - fr.nsave;
}

function ssa_raw_inst(ins: ssa.SInst, reg_of: i32[], imm: ssa.Imms, s: asmcore.EmitState): asmcore.EmitState {
  let k = ins.kind_tag;
  let a = ssa_src(reg_of, ins.args[0], "x4");
  s = ssa_load(reg_of, ins.args[0], a, s);
  let offset = imm.value[ins.args[1]];
  if (k == ssa.LD_IDX || k == ssa.ST_IDX) {
    offset *= 8i64;
  }
  let at = "[" + a + ", #" + util.i64_to_string(offset) + "]";
  if (!imm.is_imm[ins.args[1]]) {
    let b = ssa_src(reg_of, ins.args[1], "x5");
    s = ssa_load(reg_of, ins.args[1], b, s);
    at = "[" + a + ", " + b + "]";
    if (k == ssa.LD_IDX || k == ssa.ST_IDX) {
      at = "[" + a + ", " + b + ", lsl #3]";
    }
  }
  let d = ssa_dst(reg_of, ins.result);
  if (k == ssa.LD_IDX) {
    s = s.write("    ldr " + d + ", " + at + "\n");
    return ssa_store(reg_of, ins.result, d, s);
  }
  if (k == ssa.LD_BYTE) {
    s = s.write("    ldrb " + ssa_wreg(d) + ", " + at + "\n");
    return ssa_store(reg_of, ins.result, d, s);
  }
  let c = ssa_src(reg_of, ins.args[2], "x6");
  s = ssa_load(reg_of, ins.args[2], c, s);
  if (k == ssa.ST_IDX) {
    return s.write("    str " + c + ", " + at + "\n");
  }
  return s.write("    strb " + ssa_wreg(c) + ", " + at + "\n");
}

function ssa_call_ind(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
  s = asmcore.ssa_x0_forget(s);
  let argc = ins.args.len() - 1;
  if (!ssa.slot_call(ins)) {
    s = ssa_load(reg_of, ins.args[0], "x6", s);
  }
  if (argc > ssa_nargs()) {
    let i = argc;
    while (i >= 1) {
      s = ssa_push_operand(reg_of, ins.args[i], (argc - i) * 16, s);
      i -= 1;
    }
    let p = 0;
    while (p < ssa_nargs()) {
      s = ssa_ldst(s, true, ssa_reg(p), "sp", 16 * p);
      p += 1;
    }
  } else {
    let srcs: i32[] = [];
    let dsts: i32[] = [];
    let a = 0;
    while (a < argc) {
      srcs = srcs.append(reg_of[ins.args[a + 1]]);
      dsts = dsts.append(a);
      a += 1;
    }
    s = ssa_parallel_moves(srcs, dsts, s);
  }
  if (ssa.slot_call(ins)) {
    s = ssa_ldst(s, true, "x6", "x0", 8);
  }
  if (s.harden) {
    s = cfi_check_arm64(s, "x6", ins.imm);
  }
  s = s.write("    blr x6\n");
  if (argc > ssa_nargs()) {
    s = ssa_addsub_imm(s, false, "sp", "sp", argc * 16);
  }
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

function ssa_agg_lit(ins: ssa.SInst, reg_of: i32[], own s: asmcore.EmitState): asmcore.EmitState {
  let pk = asmcore.const_agg_pack(s, ins.str, ".k");
  s = pk.state;
  let kout = asmcore.add_const_agg(s, pk.text);
  s = kout.state;
  let klbl = asmcore.const_agg_label(s, kout.idx);
  let d = ssa_dst(reg_of, ins.result);
  s = ssa_adrp_add(s, d, klbl);
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_addr_inst(ins: ssa.SInst, reg_of: i32[], own s: asmcore.EmitState): asmcore.EmitState {
  s = asmcore.ssa_x0_forget(s);
  let k = ins.kind_tag;
  let label = "";
  if (k == ssa.FN_ADDR) {
    label = "__fn_" + asmcore.sanitize_label(ins.str) + ".k";
    if (s.harden) {
      s = asmcore.with_cfi_stub(s, label, ins.imm);
      label = asmcore.cfi_stub_label(s, label);
    }
  } else if (k == ssa.SHAPE_ADDR) {
    let sh = asmcore.shape_ref(s, ins.str);
    s = sh.state;
    label = sh.label;
  } else if (k == ssa.STR_LIT) {
    s = s.need("heap");
    let lo = asmcore.add_string_lit(s, ins.str);
    s = lo.state;
    label = asmcore.str_box_label(s, lo.idx);
  } else {
    s = s.need("heap");
    s = ssa_bl_sym(ssa_mov_imm(s, "x0", util.i32_to_string(ins.imm)), "__fern_arr_box");
    return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
  }
  let d = ssa_dst(reg_of, ins.result);
  s = ssa_adrp_add(s, d, label);
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_inst(ins: ssa.SInst, reg_of: i32[], fr: SsaFrame, lp: string, r: irtables.Lowered, own s: asmcore.EmitState): asmcore.EmitState {
  let k = ins.kind_tag;
  if (ssa.back_copy_call(ins) && asmcore.ssa_inline_back(s)) {
    return ssa_back_copy(ins, reg_of, lp, SlowSaves { mask: ssa_cold_mask(fr, ins), base: fr.cold_base }, s);
  }
  if (k == ssa.CALL) {
    return ssa_call(ins, reg_of, lp, s);
  }
  if (k == ssa.FLAT_OP) {
    return ssa_flat_op(ins, reg_of, lp, r, s);
  }
  if (k == ssa.DYN_DISPATCH) {
    return ssa_dyn_dispatch(ins, reg_of, lp, s);
  }
  if (k == ssa.STR_VIEW) {
    return ssa_str_view(ins, reg_of, ssa_view_off(fr, ins.result), s);
  }
  if (k >= ssa.LD_AT && k <= ssa.STR_AT) {
    return ssa_mem_inst(ins, reg_of, fr.imm, s);
  }
  if (k >= ssa.FN_ADDR && k <= ssa.ARR_BOX) {
    return ssa_addr_inst(ins, reg_of, s);
  }
  if (k == ssa.STR_CALL && ins.str == "str_eq") {
    return ssa_str_eq(ins, reg_of, lp, fr, s);
  }
  if (k == ssa.STR_CALL) {
    return ssa_str_call(ins, reg_of, s);
  }
  if (k == ssa.RT_CALL && asmcore.ssa_host_kind(ins.str)) {
    return ssa_host_call(ins, reg_of, fr.imm, s);
  }
  if (k == ssa.RT_CALL) {
    return ssa_rt_call(ins, reg_of, lp, SlowSaves { mask: ssa_cold_mask(fr, ins), base: fr.cold_base }, s);
  }
  if (k == ssa.SYM_ADDR) {
    return ssa_sym_addr(ins, reg_of, s);
  }
  if (k >= ssa.LD_IDX && k <= ssa.ST_BYTE) {
    return ssa_raw_inst(ins, reg_of, fr.imm, s);
  }
  if (k == ssa.CALL_IND) {
    return ssa_call_ind(ins, reg_of, s);
  }
  if (k == ssa.AGG_LIT) {
    return ssa_agg_lit(ins, reg_of, s);
  }
  if (k == ssa.LINE) {
    return asmcore.ssa_line_loc(ins, s);
  }
  if (ssa_lane_arm_at(ins, fr)) {
    return ssa_lane_arm(ins, reg_of, s);
  }
  if ((k == ssa.CONST_INT || k == ssa.CONST_I64) && fr.imm.is_imm[ins.result]) {
    return s;
  }
  if (k == ssa.BINARY && (ssa.float_arith(ins.str) || ssa.float_cmp(ins.str))) {
    return ssa_fbin(ins, reg_of, s);
  }
  if (k == ssa.UNARY && ssa_funary_direct(ins.str)) {
    return ssa_funary(ins, reg_of, s);
  }
  if (k == ssa.UNARY && (ins.str == "f64_bits" || ins.str == "f64_from_bits")) {
    let rd = ssa_fhome(reg_of, ins.result);
    if (rd == "") {
      rd = ssa_dst(reg_of, ins.result);
    }
    return ssa_store(reg_of, ins.result, rd, ssa_load(reg_of, ins.args[0], rd, s));
  }
  if (k == ssa.CONST_FLOAT && ssa_fhome(reg_of, ins.result) != "") {
    return s.write("    ldr " + ssa_fhome(reg_of, ins.result) + ", =" + ins.str + "\n");
  }
  let d = ssa_dst(reg_of, ins.result);
  if (k == ssa.CONST_INT) {
    s = ssa_const_reg(util.i32_to_string(ins.imm), d, s);
  } else if (k == ssa.CONST_I64) {
    s = ssa_const_reg(ins.str, d, s);
  } else if (k == ssa.CONST_FLOAT) {
    s = s.write("    ldr " + d + ", =" + ins.str + "\n");
  } else if (k == ssa.COPY) {
    s = ssa_load(reg_of, ins.args[0], d, s);
  } else if (k == ssa.BINARY && ssa_direct_bin(ir.kind_id(ins.str))) {
    return ssa_bin_in_place(ins, reg_of, fr, s);
  } else if (k == ssa.BINARY && asmcore.ssa_shift_tag(ir.kind_id(ins.str)) && (fr.imm.is_imm[ins.args[1]] || ins.imm == 64)) {
    return ssa_bin_in_place(ins, reg_of, fr, s);
  } else if (k == ssa.BINARY && ssa_div_tag(ir.kind_id(ins.str)) && fr.imm.konst[ins.args[1]]) {
    d = "x4";
    s = ssa_load(reg_of, ins.args[0], "x4", s);
    s = ssa_div_const(ir.kind_id(ins.str), ins.imm, fr.imm.value[ins.args[1]], s);
  } else if (k == ssa.BINARY) {
    d = "x4";
    s = ssa_load(reg_of, ins.args[0], "x4", s);
    s = ssa_load(reg_of, ins.args[1], "x5", s);
    s = s.write(ir_bin_asm(ir.kind_id(ins.str), ins.imm, "x4", "x5", "x6"));
  } else {
    let src = "";
    if (reg_of[ins.args[0]] >= 0 && ssa_reg(reg_of[ins.args[0]]) != d) {
      src = ssa_reg(reg_of[ins.args[0]]);
    }
    let sx: i64 = -1;
    if (s.records() && asmcore.ssa_sext32(ins.str, ins.imm == 1)) {
      let from_reg = src;
      if (from_reg == "") {
        from_reg = d;
      }
      sx = arm64_native.arm64_rec_sxtw(d, ssa_wreg(from_reg));
    }
    let from = "";
    if (sx < 0 && src != "") {
      from = ssa_unary_from(ins.str, ins.imm == 1, src, d);
    }
    if (sx >= 0) {
      if (src == "") {
        s = ssa_load(reg_of, ins.args[0], d, s);
      }
      s = s.word(sx);
    } else if (from != "") {
      s = s.write(from);
    } else {
      s = ssa_load(reg_of, ins.args[0], d, s);
      s = s.write(ssa_unary_asm(ins.str, ins.imm == 1, d));
    }
  }
  return ssa_store(reg_of, ins.result, d, s);
}

function ssa_phi_moves(f: ssa.SFunc, fr: SsaFrame, reg_of: i32[], pred: i32, succ: i32, s: asmcore.EmitState): asmcore.EmitState {
  s = asmcore.ssa_x0_forget(s);
  let ti = ssa.block_index(fr.blk_pos, succ);
  if (ti < 0) {
    return s;
  }
  let tb = f.blocks[ti];
  let sl = ssa.pred_slot(tb, pred);
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  let imm_dsts: i32[] = [];
  let imm_vals: i64[] = [];
  for ins in tb.insts {
    if (ins.kind_tag != ssa.PHI || reg_of[ins.result] == -1) {
      continue;
    }
    if (fr.imm.is_imm[ins.args[sl]]) {
      imm_dsts = imm_dsts.append(reg_of[ins.result]);
      imm_vals = imm_vals.append(fr.imm.value[ins.args[sl]]);
    } else if (reg_of[ins.args[sl]] != reg_of[ins.result]) {
      srcs = srcs.append(reg_of[ins.args[sl]]);
      dsts = dsts.append(reg_of[ins.result]);
    }
  }
  s = ssa_parallel_moves(srcs, dsts, s);
  let zeroed: i32[] = [];
  for i in 0..imm_dsts.len() {
    if (imm_vals[i] == 0 as i64 && imm_dsts[i] < 0 && !ssa_lane_off(ssa_slot_off(ssa.spill_slot(imm_dsts[i])), s)) {
      zeroed = zeroed.append(ssa.spill_slot(imm_dsts[i]));
    } else {
      s = ssa_imm_to(imm_vals[i], imm_dsts[i], s);
    }
  }
  return ssa_zero_slots(zeroed, s);
}

// ssa_zero_slots stores xzr to spill slots, with one stp for each two
// adjacent slots in its reach. Slot v+1 is the one below slot v.
function ssa_zero_slots(slots: i32[], s: asmcore.EmitState): asmcore.EmitState {
  if (slots.len() < 2) {
    for v in slots {
      s = ssa_fr_str(s, "xzr", ssa_slot_off(v), 0);
    }
    return s;
  }
  let top = 0;
  for v in slots {
    if (v > top) {
      top = v;
    }
  }
  let want = __alloc_bool(top + 2);
  for v in slots {
    want = want.with(v, true);
  }
  let v = 0;
  while (v <= top) {
    let step = 1;
    let pos = ssa_fr_pos(s, ssa_slot_off(v + 1) - s.ssa_save, 0);
    if (want[v] && want[v + 1] && pos >= 0 && pos <= 504) {
      s = s.write("    stp xzr, xzr, [sp, #" + util.i32_to_string(pos) + "]\n");
      step = 2;
    } else if (want[v]) {
      s = ssa_fr_str(s, "xzr", ssa_slot_off(v), 0);
    }
    v += step;
  }
  return s;
}

function ssa_imm_to(c: i64, loc: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (loc >= 0 && loc < ssa_fbase()) {
    return ssa_const_reg(util.i64_to_string(c), ssa_reg(loc), s);
  }
  if (loc >= 0) {
    s = ssa_const_reg(util.i64_to_string(c), "x5", s);
    return ssa_mov_rr(s, ssa_reg(loc), "x5");
  }
  s = ssa_const_reg(util.i64_to_string(c), "x5", s);
  return ssa_loc_str(loc, "x5", s);
}

function ssa_parallel_moves(srcs: i32[], dsts: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let done = __alloc_bool(srcs.len());
  let parking = false;
  let parked = 0;
  let left = srcs.len();
  while (left > 0) {
    let progressed = false;
    let i = 0;
    while (i < srcs.len()) {
      if (!done[i] && !asmcore.ssa_move_blocked(srcs, dsts, done, i, parking, parked)) {
        if (parking && srcs[i] == parked) {
          s = ssa_loc_str(dsts[i], ssa_park_reg(parked, s), s);
        } else {
          s = ssa_move(srcs[i], dsts[i], s);
        }
        done = done.with(i, true);
        left -= 1;
        progressed = true;
      }
      i += 1;
    }
    if (!progressed) {
      let j = 0;
      while (done[j]) {
        j += 1;
      }
      s = ssa_loc_ldr(srcs[j], ssa_park_reg(srcs[j], s), s);
      parking = true;
      parked = srcs[j];
    }
  }
  return asmcore.ssa_x0_forget(s);
}

function ssa_park_reg(loc: i32, s: asmcore.EmitState): string {
  if (loc >= ssa_fbase() || loc < -1 && ssa_lane_off(ssa_slot_off(ssa.spill_slot(loc)), s)) {
    return "d1";
  }
  return "x4";
}

function ssa_lane_reg(reg: string): string {
  if (ssa_is_d(reg)) {
    return reg;
  }
  return "d1";
}

function ssa_move(src: i32, dst: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (src == dst) {
    return s;
  }
  if (src >= 0) {
    return ssa_loc_str(dst, ssa_reg(src), s);
  }
  if (dst >= 0) {
    return ssa_loc_ldr(src, ssa_reg(dst), s);
  }
  s = ssa_loc_ldr(src, "x5", s);
  return ssa_loc_str(dst, "x5", s);
}

function ssa_loc_ldr(loc: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
  if (loc >= 0) {
    return ssa_mov_rr(s, reg, ssa_reg(loc));
  }
  return ssa_fr_ldr(s, reg, ssa_slot_off(ssa.spill_slot(loc)), 0);
}

function ssa_loc_str(loc: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
  if (loc >= 0) {
    return ssa_mov_rr(s, ssa_reg(loc), reg);
  }
  return ssa_fr_str(s, reg, ssa_slot_off(ssa.spill_slot(loc)), 0);
}

function ssa_jump(fr: SsaFrame, lp: string, to: i32, next: i32, s: asmcore.EmitState): asmcore.EmitState {
  if (to == next) {
    return s;
  }
  return ssa_b(s, ssa_blab(fr, lp, to));
}

function ssa_brif(f: ssa.SFunc, fr: SsaFrame, blk: ssa.SBlock, reg_of: i32[], lp: string, next: i32, fu: SsaFuse, s: asmcore.EmitState): asmcore.EmitState {
  let t = blk.term;
  let tv = t.cond;
  if (fu.n > 0) {
    tv = fu.a;
  }
  if (fu.n == 0) {
    s = ssa_read(reg_of, t.cond, "x4", s);
  }
  let tr = ssa_src(reg_of, tv, "x4");
  if (t.t == t.f) {
    s = ssa_phi_moves(f, fr, reg_of, blk.id, t.t, s);
    return ssa_jump_on(f, fr, reg_of, lp, t.t, next, s);
  }
  let fl = ssa_blab(fr, lp, ssa.forward_target(f, fr.blk_pos, fr.imm, reg_of, t.f));
  let stub = ssa.edge_moves(f, fr.blk_pos, fr.imm, reg_of, blk.id, t.f);
  if (stub) {
    let sn = asmcore.lab_new(s, lp + "e" + util.i32_to_string(blk.id) + "_" + util.i32_to_string(t.f));
    s = sn.state;
    fl = sn.lab;
  }
  if (!stub && ssa.same_fallthrough(f, fr.blk_pos, fr.imm, reg_of, t.f, next) && !ssa.edge_moves(f, fr.blk_pos, fr.imm, reg_of, blk.id, t.t)) {
    let tl = ssa_blab(fr, lp, ssa.forward_target(f, fr.blk_pos, fr.imm, reg_of, t.t));
    if (fu.n > 0 && fu.tag == 0) {
      return ssa_cbz(s, false, tr, tl);
    }
    if (fu.n > 0) {
      return ssa_bcond(s, ssa_fuse_cc(fu, !fu.inverted), tl);
    }
    return ssa_cbz(s, true, tr, tl);
  }
  if (fu.n > 0 && fu.tag == 0) {
    s = ssa_cbz(s, true, tr, fl);
  } else if (fu.n > 0) {
    s = ssa_bcond(s, ssa_fuse_cc(fu, fu.inverted), fl);
  } else {
    s = ssa_cbz(s, false, tr, fl);
  }
  s = ssa_phi_moves(f, fr, reg_of, blk.id, t.t, s);
  if (stub) {
    s = ssa_b(s, ssa_blab(fr, lp, t.t));
    s = asmcore.ssa_x0_forget(s);
    s = s.lab_def(fl);
    s = ssa_phi_moves(f, fr, reg_of, blk.id, t.f, s);
    return ssa_jump_on(f, fr, reg_of, lp, t.f, next, s);
  }
  return ssa_jump_on(f, fr, reg_of, lp, t.t, next, s);
}

function ssa_fused_test(fr: SsaFrame, reg_of: i32[], fu: SsaFuse, join: string, s: asmcore.EmitState): asmcore.EmitState {
  if (!s.retain_sites || !fu.unique) {
    return ssa_fused_test_emit(fr, reg_of, fu, join, s);
  }
  let h = buf_new(512);
  let site = ssaprepare.UniqueSite { input: fu.a, result: -1, input_home: reg_of[fu.a], result_home: -1, cached: s.ssa_x0, flags: true, aligned: fu.aligned, inverted: fu.inverted, join: join, text: "" };
  let out = ssa_fused_test_emit(fr, reg_of, fu, join, asmcore.EmitState { ...s, capture: h });
  return asmcore.finish_unique_site(out, h, s.capture, site);
}

function ssa_fuse_cc(fu: SsaFuse, when_true: boolean): i32 {
  let k = ir.kind_name(fu.tag);
  if (!ssa.float_cmp(k)) {
    return ir_cmp_cc(fu.tag, when_true);
  }
  let cc = CC_NE;
  if (k == "flt") {
    cc = 4;
  } else if (k == "fle") {
    cc = CC_LS;
  } else if (k == "fgt") {
    cc = CC_GT;
  } else if (k == "fge") {
    cc = CC_GE;
  } else if (k == "feq") {
    cc = CC_EQ;
  }
  if (when_true) {
    return cc;
  }
  return cc ^ 1;
}

function ssa_fused_test_emit(fr: SsaFrame, reg_of: i32[], fu: SsaFuse, join: string, s: asmcore.EmitState): asmcore.EmitState {
  if (fu.n > 0 && fu.tag == 0) {
    return ssa_read(reg_of, fu.a, "x4", s);
  }
  if (fu.n == 0) {
    return s;
  }
  if (fu.unique) {
    return ssa_unique_flags(reg_of, fu.a, fu.aligned, join, s);
  }
  if (ssa.float_cmp(ir.kind_name(fu.tag))) {
    s = ssa_fread(reg_of, fu.a, "d0", s);
    s = ssa_fread(reg_of, fu.b, "d1", s);
    return s.write("    fcmp " + ssa_fsrc(reg_of, fu.a, "d0") + ", " + ssa_fsrc(reg_of, fu.b, "d1") + "\n");
  }
  s = ssa_read(reg_of, fu.a, "x4", s);
  let bx = ssa_rhs_scratch(reg_of, fu.b, s);
  s = ssa_read_rhs(fr, reg_of, fu.b, bx, s);
  if (s.records()) {
    let w = ssa_addsub_word(true, "", ssa_src(reg_of, fu.a, "x4"), fr, reg_of, fu.b, bx);
    if (w >= 0) {
      return s.word(w);
    }
  }
  return s.write("    cmp " + ssa_src(reg_of, fu.a, "x4") + ", " + ssa_rhs(fr, reg_of, fu.b, bx) + "\n");
}

function ssa_unique_flags(reg_of: i32[], v: i32, aligned: boolean, join: string, s: asmcore.EmitState): asmcore.EmitState {
  s = helper_call_needs("__fern_rc_is_unique", s);
  s = ssa_read(reg_of, v, "x4", s);
  let p = ssa_src(reg_of, v, "x4");
  let jn = asmcore.lab_new(s, join);
  s = jn.state;
  s = ssa_tst_imm(s, p, 1i64, "1");
  s = ssa_bcond(s, CC_NE, jn.lab);
  s = ssa_cmp_floor(s, p);
  s = ssa_bcond(s, CC_LO, jn.lab);
  let base = p;
  if (!aligned) {
    s = ssa_and_imm(s, "x7", p, 0 - 3i64, "0xfffffffffffffffd");
    base = "x7";
  }
  s = ssa_unscaled(s, true, "w5", base, -8);
  s = s.write(san_poison_check("w5", "w7", join + "us", s.rc_free_debug));
  s = ssa_cmp_imm(s, "w5", 1);
  return s.lab_def(jn.lab);
}

function ssa_rotates(f: ssa.SFunc, fr: SsaFrame, from: i32, to: i32): boolean {
  let ti = ssa.block_index(fr.blk_pos, to);
  if (ti < 0 || ti > from) {
    return false;
  }
  let h = f.blocks[ti];
  if (h.term.kind_tag != ssa.TERM_BRIF || h.term.t == h.term.f) {
    return false;
  }
  if (ssa.has_phis(f, fr.blk_pos, h.term.t) || ssa.has_phis(f, fr.blk_pos, h.term.f)) {
    return false;
  }
  let n = 0;
  for ins in h.insts {
    let imm = (ins.kind_tag == ssa.CONST_INT || ins.kind_tag == ssa.CONST_I64) && fr.imm.is_imm[ins.result];
    if (ins.kind_tag != ssa.PHI && !imm) {
      n += 1;
    }
  }
  return n == ssa_fuse(ssa_fuse_view(fr), h).n;
}

function ssa_term(f: ssa.SFunc, fr: SsaFrame, blk: ssa.SBlock, reg_of: i32[], lp: string, next: i32, fu: SsaFuse, s: asmcore.EmitState): asmcore.EmitState {
  let t = blk.term;
  if (t.kind_tag == ssa.TERM_RET) {
    if (t.value >= 0 && fr.imm.is_imm[t.value]) {
      s = ssa_const_reg(util.i64_to_string(fr.imm.value[t.value]), "x0", s);
    } else {
      s = ssa_load(reg_of, t.value, "x0", s);
    }
    s = ssa_lane_ret(fr, reg_of, t.value, s);
    if (asmcore.float_result(fr.fmask)) {
      let h = "x0";
      if (t.value >= 0 && ssa_fhome(reg_of, t.value) != "") {
        h = ssa_fhome(reg_of, t.value);
      }
      s = s.write("    fmov d0, " + h + "\n");
    }
    return ssa_exit(fr, s, "");
  }
  if (t.kind_tag == ssa.TERM_BR) {
    s = ssa_phi_moves(f, fr, reg_of, blk.id, t.target, s);
    if (ssa_rotates(f, fr, ssa.block_index(fr.blk_pos, blk.id), t.target)) {
      let h = f.blocks[ssa.block_index(fr.blk_pos, t.target)];
      let hfu = ssa_fuse(ssa_fuse_view(fr), h);
      return ssa_brif(f, fr, h, reg_of, lp, next, hfu, ssa_fused_test(fr, reg_of, hfu, asmcore.ssa_join(lp, blk.id), s));
    }
    return ssa_jump_on(f, fr, reg_of, lp, t.target, next, s);
  }
  if (t.kind_tag == ssa.TERM_BRIF) {
    return ssa_brif(f, fr, blk, reg_of, lp, next, fu, s);
  }
  return ssa_exit(fr, ssa_mov_imm(s, "x0", "0"), "");
}

function ssa_load_params(f: ssa.SFunc, reg_of: i32[], mask: string, s: asmcore.EmitState): asmcore.EmitState {
  let k = ssa_reg_params(f);
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  let p = 0;
  while (p < k) {
    if (reg_of[p] != -1) {
      srcs = srcs.append(ssa_arg_loc(mask, p));
      dsts = dsts.append(reg_of[p]);
    }
    p += 1;
  }
  s = ssa_parallel_moves(srcs, dsts, s);
  while (p < f.nparams) {
    if (ssa.lane_param(f, p)) {
      ssa_lane_refuse(f.name + ": parameter " + util.i32_to_string(p));
    }
    let d = ssa_dst(reg_of, p);
    s = s.write("    ldr " + d + ", [x29, #" + util.i32_to_string(16 + p * 16) + "]\n");
    s = ssa_store(reg_of, p, d, s);
    p += 1;
  }
  return s;
}

function ssa_reg_params(f: ssa.SFunc): i32 {
  if (f.nparams < ssa_nargs()) {
    return f.nparams;
  }
  return ssa_nargs();
}

function ssa_entry_shim(f: ssa.SFunc, name: string, s: asmcore.EmitState): asmcore.EmitState {
  let k = ssa_reg_params(f);
  let mask = s.float_mask(name);
  let p = 0;
  while (p < k) {
    s = ssa_ldst(s, true, ssa_reg(p), "sp", 16 * p);
    p += 1;
  }
  s = s.write("__fn_" + name + ".k:\n");
  p = 0;
  while (p < k) {
    if (asmcore.float_param(mask, p)) {
      s = ssa_mov_rr(s, ssa_reg(ssa_farg(p)), ssa_reg(p));
    }
    p += 1;
  }
  return s.write("__fn_" + name + ".r:\n");
}

function ssa_reg_helper(sym: string, argc: i32): boolean {
  if (argc == 2) {
    return sym == "__fn___fern_str_eq";
  }
  return argc == 1 && (sym == "__fn___fern_arr_dec" || sym == "__fn___fern_str_free" || sym == "__fn___fern_arr_inc_elems");
}

function ssa_reg_call(ins: ssa.SInst, s: asmcore.EmitState): boolean {
  let argc = ins.args.len();
  if (ins.kind_tag != ssa.CALL || argc == 0 || argc > ssa_nargs() || ssa.rc_inlined(ins)) {
    return false;
  }
  if (ircore.is_runtime_helper_call(ins.str, s) || ircore.is_c_call(ins.str)) {
    return false;
  }
  return irtables.sig_reg_has_exact(s.reg_entries, asmcore.sanitize_label(ins.str));
}

function ssa_float_calls(f: ssa.SFunc, s: asmcore.EmitState): boolean[] {
  let out = __alloc_bool(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ssa_f64_call(ins, s)) {
        out = out.with(ins.result, true);
      }
    }
  }
  return out;
}

function ssa_f64_call(ins: ssa.SInst, s: asmcore.EmitState): boolean {
  if (ins.kind_tag != ssa.CALL || ins.result < 0 || ssa.rc_inlined(ins) || ircore.is_runtime_helper_call(ins.str, s) || ircore.is_c_call(ins.str)) {
    return false;
  }
  return asmcore.float_result(s.float_mask(asmcore.sanitize_label(ins.str)));
}

function ssa_arg_prefs(f: ssa.SFunc, s: asmcore.EmitState): i32[] {
  let pref = util.minus_ones(f.nvals);
  let p = 0;
  while (p < ssa_reg_params(f)) {
    if (!ssa.lane_param(f, p)) {
      pref = pref.with(p, p);
    }
    p += 1;
  }
  for blk in f.blocks {
    for ins in blk.insts {
      if (!ssa_reg_call(ins, s)) {
        continue;
      }
      let mask = s.float_mask(asmcore.sanitize_label(ins.str));
      let a = 0;
      while (a < ins.args.len()) {
        let v = ins.args[a];
        if (v >= 0 && v < pref.len() && pref[v] < 0 && !asmcore.lane_param(mask, a)) {
          pref = pref.with(v, a);
        }
        a += 1;
      }
    }
  }
  return pref;
}

// Whether the select at `ii` starts a run that reads the flags of the compare
// just before it.
function ssa_select_head(fv: FuseView, blk: ssa.SBlock, ii: i32): boolean {
  if (!ssa.select_at(blk, ii)) {
    return false;
  }
  let sc = ssa_select_fuse(fv, blk, ii);
  return sc.fu.n > 0 && sc.first;
}

// The immediates, and the compares a branch or a select fuses: the emitter
// writes none of them, so none needs a register.
function ssa_homeless(f: ssa.SFunc, imm: ssa.Imms): boolean[] {
  let out = imm.is_imm;
  let fv = FuseView { uses: ssa.use_counts(f), imm: imm };
  for blk in f.blocks {
    let n = blk.insts.len();
    let fu = ssa_fuse(fv, blk);
    for k in 0..n {
      let r = blk.insts[k].result;
      if (r >= 0 && (k >= n - fu.n || ssa_select_head(fv, blk, k + 1))) {
        out = out.with(r, true);
      }
    }
  }
  return out;
}

function emit_ssa_function_arm64(prepared: ssaprepare.Body, label_name: string, entry: ssaprepare.ReleaseEntry, context: Option[ssaprepare.Context], s: asmcore.EmitState): asmcore.EmitState {
  if (!s.retain_prepared || s.records()) {
    return emit_ssa_allocated_arm64(prepared, label_name, entry, context, s);
  }
  let h = buf_new(4096);
  let out = emit_ssa_allocated_arm64(prepared, label_name, entry, context, asmcore.EmitState { ...s, capture: h, native_sites: [], retain_sites: true });
  return asmcore.finish_native_text(out, h, s.capture, s.native_sites, s.retain_sites);
}

function emit_ssa_allocated_arm64(prepared: ssaprepare.Body, label_name: string, entry: ssaprepare.ReleaseEntry, context: Option[ssaprepare.Context], s: asmcore.EmitState): asmcore.EmitState {
  let r = prepared.lowered;
  let seen_vals = prepared.seen_vals;
  let seen_slots = prepared.seen_slots;
  s = asmcore.EmitState { ...s, dw_first: true, dw_pos: 0 };
  let formed = prepared.formed;
  let f = formed.f;
  let imm = ssa.imm_operands(f, 0i64, 4095i64, ssa_imm_right(), ssa_imm_left());
  let call_kinds = ssa.cold_positions(f, s.size, asmcore.ssa_inline_back(s));
  let alloc = ssa.regalloc_linear_fixed(f, ssa_nregs(), ssa_nsaved(), 0, false, ssa_homeless(f, imm), ssa_arg_prefs(f, s), ssa.float_values(f, ssa_float_calls(f, s), true), ssa_nfregs(), ssa_nfsaved(), ssa_cold_fixed(f, r, call_kinds), call_kinds, ssalive.call_crossers(f, ssa.hard_call_positions(f, call_kinds)));
  let reg_of = alloc.reg_of;
  let lp = ".Lssa_" + asmcore.sanitize_label(label_name) + "_";
  s = ssa_cfi(s.write("__fn_" + asmcore.sanitize_label(label_name) + ":\n"), 1, "", 0);
  s = ssa_entry_shim(f, asmcore.sanitize_label(label_name), s);
  s = ssa_release_entry(entry, lp, s);
  let saved = ssa_saved_regs(reg_of);
  let views = ssa.view_slots(f);
  let tails = s.profile == 0;
  let leaf = s.profile == 0 && ssa.spill_count(reg_of) == 0 && ssa.view_count(views) == 0 && saved.len() == 0 && !ssa_calls_besides_tails(f, s, tails) && util.index_of_i32(reg_of, 12) < 0;
  let canary = 0;
  if (s.harden && !leaf) {
    canary = ssa_save_bytes(saved) + 8;
  }
  let save = ssa_save_bytes(saved);
  if (canary > 0) {
    save += 16;
  }
  let outer = s.capture;
  let body = 0 as usize;
  if (leaf) {
    body = buf_new(4096);
    s = asmcore.EmitState { ...s, capture: body };
  } else {
    s = ssa_frame_record(s);
    s = ssa_save(saved, s);
  }
  let fn_label = "__fn_" + asmcore.sanitize_label(label_name);
  let dbg = asmcore.dbg_vars(fn_label, alloc, r, formed.repl, if (s.var_rows) { seen_vals } else { [] }, seen_slots, ssa_dbg_locs(reg_of, save, seen_vals.len() > 0), ssa.position_count(f));
  let bp = ssa.block_positions(f);
  let lbase = s.nlab;
  s = s.lab_take(bp.len());
  let lanes = ssa.lane_values(f);
  let cold = ssa_cold_saves(f, alloc);
  let fr = SsaFrame { nspill: asmcore.ssa_lane_spill(f, ssa.spill_count(reg_of)), views: views, blk_pos: bp, uses: ssa.use_counts(f), nsave: save, saved: saved, imm: imm, lit0: ssa.literal_first_bytes(f), lbase: lbase, leaf: leaf, fmask: s.float_mask(asmcore.sanitize_label(label_name)), lanes: lanes, cold: cold, cold_base: asmcore.ssa_lane_spill(f, ssa.spill_count(reg_of)) + 3 * ssa.view_count(views), canary: canary };
  let fusions: ssaprepare.Fusion[] = [];
  let frame: i32 = (fr.nspill + 3 * ssa.view_count(views)) * 8;
  if (cold.any) {
    frame = frame + COLD_SLOTS * 8;
  }
  if (frame % 16 != 0) {
    frame += 8;
  }
  let drop = frame;
  if (canary > 0) {
    drop = frame + 16;
  }
  if (drop > 0) {
    s = ssa_frame_drop(s, drop);
  }
  if (canary > 0) {
    s = s.write("    adrp x17, __fern_canary\n    ldr x17, [x17, :lo12:__fern_canary]\n");
    s = fr_str(s, "x17", -canary);
  }
  s = asmcore.EmitState { ...s, ssa_frame: frame + save, ssa_save: save, ssa_lane_slots: asmcore.ssa_lane_slot_table(reg_of, lanes) };
  s = ssa_load_params(f, reg_of, fr.fmask, s);
  let pos = 0;
  let pool_insts = 0;
  let bi = 0;
  while (bi < f.blocks.len()) {
    let blk = f.blocks[bi];
    let next: i32 = -1;
    if (bi + 1 < f.blocks.len()) {
      next = f.blocks[bi + 1].id;
    }
    s = asmcore.ssa_x0_forget(s);
    s = s.lab_def(ssa_blab(fr, lp, blk.id));
    let fu = ssa_fuse(ssa_fuse_view(fr), blk);
    fusions = ssa_retain_fusion(fusions, fu, s.retain_prepared);
    let ii = 0;
    let tailed = false;
    while (ii < blk.insts.len() - fu.n) {
      s = asmcore.dbg_label(s, dbg, fn_label, pos + ii);
      let ins = blk.insts[ii];
      if (ii == blk.insts.len() - 1 && ssa_tail_call(blk, ins, s, tails)) {
        s = asmcore.ssa_prepared_loc(prepared.source.values, ins.result, s);
        s = ssa_emit_tail_call(ins, reg_of, fr, sourcepos.at(prepared.source.terms, blk.id), s);
        tailed = true;
      } else {
        s = asmcore.ssa_prepared_loc(prepared.source.values, ins.result, s);
        s = ssa_saved_inst(blk, ii, reg_of, lp, fr, r, cold.by_pos[pos + ii], s);
      }
      ii += 1;
      pool_insts += 1;
      if (pool_insts == 256) {
        let after_pool = asmcore.lab_new(s, lp + "pool_" + util.i32_to_string(pos + ii));
        s = ssa_b(after_pool.state, after_pool.lab).write("    .ltorg\n");
        s = s.lab_def(after_pool.lab);
        pool_insts = 0;
      }
    }
    s = asmcore.dbg_labels(s, dbg, fn_label, pos + ii, pos + blk.insts.len());
    s = asmcore.ssa_fused_loc(prepared.source, blk, ii, tailed, s);
    s = ssa_fused_test(fr, reg_of, fu, asmcore.ssa_join(lp, blk.id), s);
    s = asmcore.dbg_label(s, dbg, fn_label, pos + blk.insts.len());
    if (!tailed) {
      s = ssa_term(f, fr, blk, reg_of, lp, next, fu, s);
    }
    pos = pos + blk.insts.len() + 1;
    bi += 1;
  }
  s = asmcore.dbg_label(s, dbg, fn_label, pos);
  let framed = !leaf;
  if (leaf) {
    let text = buf_take(body);
    buf_free(body);
    s = asmcore.EmitState { ...s, capture: outer };
    framed = ssa_needs_frame(text);
    if (framed) {
      s = ssa_frame_record(s);
    }
    s = ssa_resolve_exits(text, framed, saved, s);
  }
  s = asmcore.EmitState { ...s, ssa_frame: 0, ssa_save: 0, ssa_lane_slots: [] };
  s = asmcore.dbg_rows(ssa_cfi(s, 2, "", 0), dbg).write("    .ltorg\n");
  return ssa_retain_allocation(s, prepared, label_name, context, entry, alloc, fr, frame, framed, fusions);
}

// A frame above one page touches every page it crosses, so it cannot step
// over the guard below the stack.
function ssa_frame_drop(s: asmcore.EmitState, frame: i32): asmcore.EmitState {
  if (frame <= 4096) {
    return fr_sub_imm(s, "sp", "sp", frame);
  }
  let lo = asmcore.fresh_label(s);
  s = lo.state;
  s = s.write("    movz x16, #" + util.i32_to_string(frame & 65535) + "\n");
  if (frame > 65535) {
    s = s.write("    movk x16, #" + util.i32_to_string(frame >> 16 & 65535) + ", lsl #16\n");
  }
  s = s.write(lo.name + ":\n    sub sp, sp, #4096\n    str xzr, [sp, #0]\n    sub x16, x16, #4096\n    cmp x16, #4095\n    b.hi " + lo.name + "\n");
  return s.write("    sub sp, sp, x16\n");
}

function ssa_frame_record(s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_sign_ra(s, "paciasp");
  s = ssa_pair(s, false, 3, "x29", "x30", -16);
  s = ssa_cfi(ssa_cfi(ssa_cfi(s, 3, "", 16), 6, "x29", -16), 6, "x30", -8);
  s = ssa_mov_rr(s, "x29", "sp");
  return ssa_cfi(s, 4, "x29", 0);
}

function ssa_retain_allocation(s: asmcore.EmitState, prepared: ssaprepare.Body, label_name: string, context: Option[ssaprepare.Context], entry: ssaprepare.ReleaseEntry, alloc: ssa.Alloc, fr: SsaFrame, frame: i32, framed: boolean, fusions: ssaprepare.Fusion[]): asmcore.EmitState {
  if (s.retain_prepared) {
    let allocation = ssaprepare.Allocation { alloc: alloc, imm: fr.imm, saved: fr.saved, save_bytes: fr.nsave, frame_bytes: frame, framed: framed, views: fr.views, block_positions: fr.blk_pos, block_label_base: fr.lbase, fusions: fusions };
    s = asmcore.retain_body(s, prepared, label_name, context, entry, allocation);
  }
  return s;
}

function ssa_dbg_locs(reg_of: i32[], save: i32, want: boolean): string[] {
  let out: string[] = [];
  if (!want) {
    return out;
  }
  for h in reg_of {
    if (h >= 0) {
      out = out.append(asmcore.dbg_hex([80 + ssa_dwarf(ssa_reg(h))]));
    } else if (h < -1) {
      out = out.append(asmcore.dbg_hex(asmcore.dbg_sleb([141], ssa_slot_off(ssa.spill_slot(h)) - save)));
    } else {
      out = out.append("");
    }
  }
  return out;
}

function emit_ssa_function(r: irtables.Lowered, selected: physicalbody.Selected, pre: asmcore.Prelift, label_name: string, s: asmcore.EmitState, vgate: irverifygate.Gate): asmcore.EmitState {
  let timed = ircore.ssa_report_on();
  let t_lift = ircore.report_clock(timed);
  let lifted: ssa_lift.Lifted = match (s.lift(pre, label_name, r)) { Ok(l) => l, Err(message) => { ircore.ssa_refuse(label_name, message); return s; } };
  let collision = ssa.repeated_block_id(lifted.func);
  if (collision >= 0) {
    ircore.ssa_block_id_collision(label_name, collision);
  }
  let why = ssa_unsupported(lifted.func);
  if (why != "") {
    ircore.ssa_refuse(label_name, why);
  }
  let lift_ms: i64 = (ircore.report_clock(timed) - t_lift) / 1000000i64;
  let t_emit = ircore.report_clock(timed);
  let certified = s.finish(pre, r, selected, lifted);
  irverifygate.certify_or_refuse(label_name, certified.formed.f, r.ops, vgate);
  let prepared = ssaprepare.with_selects(certified);
  let context = asmcore.preparation_context(s, "arm64");
  let entry = ircore.release_entry(r, "arm64", s.rc_free_debug, s.reg_entries);
  s = emit_ssa_function_arm64(prepared, label_name, entry, context, s);
  let emit_ms: i64 = (ircore.report_clock(timed) - t_emit) / 1000000i64;
  if (timed && lift_ms + emit_ms > 200i64) {
    eprint("FERN_SSA: time " + label_name + ": lift " + util.i32_to_string(lift_ms as i32) + " ms, emit " + util.i32_to_string(emit_ms as i32) + " ms, " + util.i32_to_string(r.ops.len()) + " ops, " + util.i32_to_string(r.n_locals) + " slots");
  }
  return s;
}

pub function emit_function_via_ir_pre(r: irtables.LowerResult, selected: physicalbody.Selected, pre: asmcore.Prelift, fd: parser.FuncDecl, s: asmcore.EmitState, vgate: irverifygate.Gate): asmcore.EmitState {
  return emit_function_via_ir_named(r, selected, pre, parser.decl_key(fd), false, s, vgate);
}

pub function emit_function_via_ir_named(r: irtables.LowerResult, selected: physicalbody.Selected, pre: asmcore.Prelift, label_name: string, weak: boolean, s: asmcore.EmitState, vgate: irverifygate.Gate): asmcore.EmitState {
  let body = ircore.body_for_emit(label_name, r);
  if (weak) {
    s = s.write(".weak __fn_" + asmcore.sanitize_label(label_name) + "\n.weak __fn_" + asmcore.sanitize_label(label_name) + ".k\n");
  }
  irverifygate.verify_or_refuse(label_name, body.ops, body.n_params, body.n_locals, vgate);
  return emit_ssa_function(body, selected, pre, label_name, s, vgate);
}

function emit_dir_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let name = ir.kind_name(o.kind_tag);
  if (o.kind_tag == ir.K_DIR_ENTRIES && o.i32_imm != 0) {
    name = "dir_entries_bytes";
    s = s.need("dir_entries");
  }
  let n = ir.op_pops(o);
  let k = n - 1;
  while (k >= 0) {
    s = s.write("    ldr x" + util.i32_to_string(k) + ", [sp], #16\n");
    k -= 1;
  }
  if (o.kind_tag == ir.K_DIR_STAT || o.kind_tag == ir.K_DIR_UNLINK || o.kind_tag == ir.K_DIR_OPEN_FILE) {
    s = s.write("    mov x" + util.i32_to_string(n) + ", #" + util.i32_to_string(o.i32_imm) + "\n");
    n += 1;
  }
  k = n - 1;
  while (k >= 0) {
    s = s.write("    str x" + util.i32_to_string(k) + ", [sp, #-16]!\n");
    k -= 1;
  }
  s = s.write("    bl __fn___fern_" + name + "\n    add sp, sp, #" + util.i32_to_string(16 * n) + "\n    str x0, [sp, #-16]!\n");
  return s.need("heap").need(name);
}

// fern-lint: allow cyclomatic-complexity
function emit_stack_op(o: ir.Op, i: i32, lp: string, r: irtables.Lowered, s: asmcore.EmitState): asmcore.EmitState {
  if (o.kind_tag == ir.K_TCP_POLLABLE || o.kind_tag == ir.K_SEND_ADOPT || o.kind_tag == ir.K_SEND_ROOT) {
    return s;
  }

  if (o.kind_tag == ir.K_PTR_WIDTH) {
    s = s.write("    mov x0, #8\n    str x0, [sp, #-16]!\n");
  } else if (ir.is_sha_hw_op(o.kind_tag)) {
    s = s.write("    mov x0, #1\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_SHA1_HW_BLOCKS) {
    s = s.need("sha1").need("heap");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    bl __fern_sha1_hw_blocks\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_MEMCPY) {
    s = emit_arm64_op_memcpy(o, i, lp, s);
  } else if (o.kind_tag == ir.K_MEMSET) {
    s = emit_arm64_op_memset(i, lp, s);
  } else if (o.kind_tag == ir.K_FREE) {
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    let owned = s.leak_check && s.rt_owned_allocs;
    if (owned) {
      s = lc_rt_req_free(s);
    }
    s = s.write("    bl __fern_raw_free\n");
    if (owned) {
      s = lc_rt_uncount(s, "__fern_lc_free_bytes", "__fern_lc_free_count");
    }
    s = s.write("    mov x0, #0\n    str x0, [sp, #-16]!\n");
    s = s.need("heap");
  } else if (o.kind_tag == ir.K_ARR_RC) {
    s = s.write("    ldr x0, [sp], #16\n    ldursw x0, [x0, #-8]\n    str x0, [sp, #-16]!\n");
  } else if (ir.is_str_op_kind(o.kind_tag)) {
    s = emit_str_op(o, s);
  } else if (o.kind_tag == ir.K_RANDOM_BYTES) {
    let rb = "random_bytes" + asmcore.packed_suffix(ir.is_packed(o));
    s = s.need("heap");
    s = s.need(rb);
    s = s.write("    bl __fn___fern_" + rb + "\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_RANDOM_I32) {
    s = s.need("random_i32");
    s = s.write("    bl __fn___fern_random_i32\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_PROC_FORK) {
    s = s.need("proc_fork");
    s = s.write("    bl __fn___fern_proc_fork\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_PROC_WAITPID) {
    s = s.need("proc_waitpid");
    s = s.write("    bl __fn___fern_proc_waitpid\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_PROC_WAITPID_NOHANG) {
    s = s.need("proc_waitpid_nohang");
    s = s.write("    bl __fn___fern_proc_waitpid_nohang\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_PROC_WAITPID_STATUS) {
    s = s.need("proc_waitpid_status");
    s = s.write("    bl __fn___fern_proc_waitpid_status\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_WORKER_REGION) {
    s = s.need("worker_region");
    s = s.write("    bl __fn___fern_worker_region\n    ldr x1, [sp], #16\n");
    s = arm64_worker_region_size(s);
    s = arm64_worker_region_census(s);
    s = s.write("    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_WORKER_EXIT) {
    s = s.need("worker_exit");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [x0]\n");
    s = arm64_worker_exit_census(s);
    s = s.write("    bl __fn___fern_worker_exit\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_WORKER_REAP) {
    s = s.need("worker_regions");
    s = s.write("    ldr x0, [sp], #16\n");
    s = arm64_worker_reap_census(s);
    if (s.rc_free_debug) {
      s = s.write(quar_addr("x1", "__fern_forget_lo") + "    str x0, [x1]\n    ldr x2, [x0, #40]\n    add x2, x2, x0\n" + quar_addr("x1", "__fern_forget_hi") + "    str x2, [x1]\n");
    }
    s = s.write("    ldr x0, [x0]\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_WORKER_UNMAP) {
    s = emit_arm64_worker_unmap(s);
  } else if (o.kind_tag == ir.K_PROC_EXEC) {
    s = s.need("heap");
    s = s.need("proc_exec");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
