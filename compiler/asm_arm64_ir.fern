      s = s.write("    ldr x3, [x2, #56]\n");
      s = s.write("    cbz x3, .Larr_push_fresh\n");
      s = s.write("    ldr x4, [x3]\n");
      s = s.write("    str x4, [x2, #56]\n");
      s = s.write("    mov x2, #4\n");
      s = s.write("    str x2, [x3]\n");
