  } else if (o.kind_tag == 248) {
    s = s.write("    bl __fn___fern_getgroups\n    str x0, [sp, #-16]!\n");
    s = s.need("heap");
    s = s.need("getgroups");
  } else if (o.kind_tag == 249) {
    s = s.write("    bl __fn___fern_environ\n    str x0, [sp, #-16]!\n");
    s = s.need("heap");
    s = s.need("environ");
  } else if (o.kind_tag == 333) {
    s = s.need("tcp_socket_ctl");
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_tcp_socket_ctl\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == 332 || o.kind_tag >= 334 && o.kind_tag <= 344 || o.kind_tag == 346 || o.kind_tag == 353 || o.kind_tag == 355 || o.kind_tag == 387 || o.kind_tag >= 434 && o.kind_tag <= 439 || o.kind_tag == 442) {
    let udp_name: string = ir.kind_name(o.kind_tag) + asmcore.packed_suffix(ir.is_packed(o));
    let udp_argc: i32 = ir.op_pops(o);
    let udp_regs: string[] = ["x0", "x1", "x2", "x3"];
    let k: i32 = udp_argc - 1;
    while (k >= 0) {
      s = s.write("    ldr " + udp_regs[k] + ", [sp], #16\n");
      k = k - 1;
    }
    k = udp_argc - 1;
    while (k >= 0) {
      s = s.write("    str " + udp_regs[k] + ", [sp, #-16]!\n");
      k = k - 1;
    }
    s = s.write("    bl __fn___fern_" + udp_name + "\n    add sp, sp, #" + util.i32_to_string(16 * udp_argc) + "\n    str x0, [sp, #-16]!\n");
    if (o.kind_tag == 337 || o.kind_tag == 343 || o.kind_tag == 344 || o.kind_tag == 353 || o.kind_tag == 355 || o.kind_tag >= 436 && o.kind_tag <= 438) {
      s = s.need("heap");
    }
    s = s.need(udp_name);
  } else if (o.kind_tag == 116) {
    s = s.need("heap");
    s = s.need("tcp_close");
    s = s.write("    bl __fn___fern_tcp_close\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == 200) {
    s = s.need("heap");
    s = s.need("tcp_listen");
    s = s.write("    bl __fn___fern_tcp_listen\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == 201) {
    s = s.need("heap");
    s = s.need("tcp_accept");
    s = s.write("    bl __fn___fern_tcp_accept\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == 320) {
    s = s.need("tcp_local_port");
    s = s.write("    bl __fn___fern_tcp_local_port\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == 308) {
    s = s.need("heap");
