  }
  if (o.kind_tag == 380 && !ir.is_packed(o)) {
    let loop_label = asmcore.fresh_label(s);
    let done_label = asmcore.fresh_label(loop_label.state);
    s = done_label.state;
    s = s.write("    ldr x0, [sp], #16\n    ldr x3, [x0]\n    add x0, x0, #8\n    mov x2, #0\n    mov w1, #0\n");
    s = s.write(loop_label.name + ":\n    cmp x2, x3\n    b.ge " + done_label.name + "\n");
    s = s.write("    add x5, x0, x2, lsl #3\n    ldrb w6, [x5]\n    add w1, w1, w6\n    add x2, x2, #1\n    b " + loop_label.name + "\n");
