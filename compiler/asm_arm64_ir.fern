}

function needs_fs_runtime(s: asmcore.EmitState): boolean {
  return s.any_need([
    "hostname", "uname_field",
    "read_file", "read_file_bytes", "read_file_bytes_u8", "write_file", "write_file_bytes", "write_file_bytes_u8", "write_file_exec",
    "remove_file", "create_dir_all", "create_dir", "remove_dir",
    "create_link", "clone_file", "create_symlink", "rename", "rename_noreplace", "rename_exchange", "getxattr", "getxattr_bytes", "getxattr_bytes_u8", "lgetxattr", "lgetxattr_bytes", "lgetxattr_bytes_u8", "setxattr", "setxattr_bytes", "setxattr_bytes_u8", "lsetxattr", "lsetxattr_bytes", "lsetxattr_bytes_u8", "chmod", "chmod_at", "truncate",
    "mknod", "chown_at", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc", "pipe", "set_file_times", "read_link",
    "getcwd", "chdir", "chroot", "setuid", "setgid", "setgroups", "umask", "fd_fsync", "fd_fdatasync", "fd_syncfs", "fd_drop_cache", "sync",
    "temp_dir", "stat", "lstat", "statfs", "mounts", "sysctl", "access", "read_dir", "read_dir_bytes", "read_dir_all", "read_dir_ino", "read_dir_ino_all",
    "remove_dir_all", "open_file", "open_with", "writer_write", "write_some", "splice_forever",
    "reader", "read_chunk_bytes", "read_chunk_bytes_u8", "write_bytes", "write_bytes_u8", "write_some_bytes", "write_some_bytes_u8", "signal_send", "set_process_group", "set_priority", "clock_set",
    "open_dir", "dir_open", "dir_entries", "dir_stat", "dir_access", "dir_unlink", "dir_chmod", "dir_chown",
  ]);
}

function profile_exit_asm(mode: i32): string {
  if (mode <= 0) {
    return "";
  }
  return "    stp x0, x30, [sp, #-16]!\n    bl __fern_profile_flush\n    ldp x0, x30, [sp], #16\n";
}

function profile_frame(s: asmcore.EmitState, name: string): asmcore.EmitState {
  s = s.write(name + ":\n");
  if (s.harden) {
    s = s.write("    bti c\n    paciasp\n");
  }
  return s.write("    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n");
}

function profile_return(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    ldp x29, x30, [sp], #16\n");
  if (s.harden) {
    s = s.write("    autiasp\n");
  }
  return s.write("    ret\n");
}

function profile_alloc_fast(s: asmcore.EmitState): boolean {
  return !s.leak_check && !s.has_need("alloc_count") && !rtprofile.allocation(s.profile);
}

function emit_profile_alloc_hook(s: asmcore.EmitState): asmcore.EmitState {
  if (!rtprofile.allocation(s.profile)) {
    return s;
  }
  return s.write("    bl __fern_profile_alloc\n");
}

function emit_profile_alloc_runtime(s: asmcore.EmitState): asmcore.EmitState {
  if (!rtprofile.allocation(s.profile)) {
    return s;
  }
  s = profile_frame(s, "__fern_profile_alloc");
  s = s.write("    stp x0, x1, [sp, #-16]!\n    stp x2, x3, [sp, #-16]!\n    stp x4, x5, [sp, #-16]!\n    stp x6, x7, [sp, #-16]!\n    stp x8, x9, [sp, #-16]!\n    stp x10, x11, [sp, #-16]!\n    stp x12, x13, [sp, #-16]!\n    stp x14, x15, [sp, #-16]!\n    stp x16, x17, [sp, #-16]!\n    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    ldr x13, [x12, #24]\n    cbz x13, .Lprofile_alloc_return\n    add x15, x12, #144\n    mov x13, #1\n    ldaddal x13, x13, [x15]\n    add x13, x13, #1\n    and x13, x13, #63\n    cbnz x13, .Lprofile_alloc_return\n    mov x8, #172\n    svc #0\n    ldr x13, [x12, #128]\n    cmp x0, x13\n    b.ne .Lprofile_alloc_return\n    mov x8, #178\n    svc #0\n    mov x14, x0\n    add x15, x12, #40\n    mov x13, xzr\n    casal x13, x14, [x15]\n    cbnz x13, .Lprofile_alloc_drop\n    ldr x13, [x29]\n    ldr x0, [x13, #8]\n    sub x0, x0, #1\n    ldr x9, [x13]\n    add x10, x29, #16\n    mov x11, x12\n    ldr x12, [sp, #128]\n    lsl x12, x12, #6\n    bl __fn___fern_profile_sample.r\n    cbz x0, .Lprofile_alloc_unlock\n    bl .Lprofile_drop\n.Lprofile_alloc_unlock:\n    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    add x15, x12, #40\n    stlr xzr, [x15]\n    b .Lprofile_alloc_return\n.Lprofile_alloc_drop:\n    bl .Lprofile_drop\n.Lprofile_alloc_return:\n    ldp x16, x17, [sp], #16\n    ldp x14, x15, [sp], #16\n    ldp x12, x13, [sp], #16\n    ldp x10, x11, [sp], #16\n    ldp x8, x9, [sp], #16\n    ldp x6, x7, [sp], #16\n    ldp x4, x5, [sp], #16\n    ldp x2, x3, [sp], #16\n    ldp x0, x1, [sp], #16\n");
  return profile_return(s);
}

function emit_profile_runtime(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  s = s.write("    .arch_extension lse\n");
  s = s.write("    .bss\n    .p2align 3\n.Lprofile_ring: .zero 4337824\n    .data\n    .p2align 3\n");
  let target: string = rt_key(darwin);
  if (darwin) {
    s = s.write(".Lprofile_action: .quad __fern_profile_signal, __fern_profile_trampoline\n    .long 0, 66\n");
  } else {
    s = s.write(".Lprofile_action: .quad __fern_profile_signal, 268435460, 0, 0\n");
  }
  s = s.write(".Lprofile_timer: .quad 0, 10000, 0, 10000\n    .text\n");
  s = emit_ir_runtime_fern_fn(rtprofile.source(target, s.profile), s);
  s = profile_frame(s, "__fern_profile_signal");
  s = s.write("    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    ldr x13, [x12, #24]\n    cbz x13, .Lprofile_signal_return\n    mov x8, #172\n    svc #0\n    ldr x13, [x12, #128]\n    cmp x0, x13\n    b.ne .Lprofile_signal_return\n    mov x8, #178\n    svc #0\n    mov x14, x0\n    add x15, x12, #40\n    mov x13, xzr\n    casal x13, x14, [x15]\n    cbnz x13, .Lprofile_busy\n" + profile_interrupted_state(darwin) + "    mov x11, x12\n    mov x12, #1\n    bl __fn___fern_profile_sample.r\n    cbz x0, .Lprofile_signal_unlock\n    bl .Lprofile_drop\n.Lprofile_signal_unlock:\n    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    add x15, x12, #40\n    stlr xzr, [x15]\n    b .Lprofile_signal_return\n.Lprofile_busy:\n    bl .Lprofile_drop\n.Lprofile_signal_return:\n");
  s = profile_return(s);
  s = s.write(".Lprofile_drop:\n    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    add x15, x12, #8\n    mov x13, #1\n    ldaddal x13, x13, [x15]\n    ret\n");
  s = profile_frame(s, "__fern_profile_flush");
  s = s.write("    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    ldr x13, [x12, #32]\n    cmp x13, #2\n    b.eq .Lprofile_flush_return\n    mov x8, #172\n    svc #0\n    ldr x13, [x12, #128]\n    cmp x0, x13\n    b.ne .Lprofile_flush_return\n    mov x8, #178\n    svc #0\n    mov x14, x0\n    add x15, x12, #40\n.Lprofile_flush_lock:\n    mov x13, xzr\n    casal x13, x14, [x15]\n    cbz x13, .Lprofile_flush_owned\n    cmp x13, x14\n    b.eq .Lprofile_flush_reentrant\n    yield\n    b .Lprofile_flush_lock\n.Lprofile_flush_reentrant:\n    ldr x13, [x12, #32]\n    cmp x13, #1\n    b.eq .Lprofile_flush_return\n.Lprofile_flush_owned:\n    ldr x13, [x12, #32]\n    cmp x13, #2\n    b.eq .Lprofile_flush_unlock\n    str xzr, [x12, #24]\n    mov x13, #1\n    str x13, [x12, #32]\n    mov x0, x12\n    bl __fn___fern_profile_finish.r\n    adrp x12, .Lprofile_ring\n    add x12, x12, :lo12:.Lprofile_ring\n    mov x13, #2\n    str x13, [x12, #32]\n.Lprofile_flush_unlock:\n    add x15, x12, #40\n    stlr xzr, [x15]\n.Lprofile_flush_return:\n");
  s = profile_return(s);
  if (darwin) {
    s = emit_profile_trampoline(s);
  }
  return emit_profile_alloc_runtime(s);
}

function profile_interrupted_state(darwin: boolean): string {
  if (darwin) {
    return "    ldr x13, [x2, #48]\n    ldr x0, [x13, #272]\n    ldr x9, [x13, #248]\n    ldr x10, [x13, #264]\n    and x9, x9, #0x0000ffffffffffff\n    and x10, x10, #0x0000ffffffffffff\n";
  }
  return "    ldr x0, [x2, #440]\n    ldr x9, [x2, #416]\n    ldr x10, [x2, #432]\n";
}

function emit_profile_trampoline(s: asmcore.EmitState): asmcore.EmitState {
  s = profile_frame(s, "__fern_profile_trampoline");
  return s.write("    stp x1, x4, [sp, #-16]!\n    stp x5, xzr, [sp, #-16]!\n    mov x16, x0\n    mov x0, x2\n    mov x1, x3\n    mov x2, x4\n    blr x16\n    ldp x2, xzr, [sp], #16\n    ldp x1, x0, [sp], #16\n    ldp x29, x30, [sp], #16\n    mov x16, #184\n    svc #0x80\n    mov x0, #2\n    mov x16, #1\n    svc #0x80\n    brk #0\n");
}

function emit_ir_runtime_settled(s0: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  let s: asmcore.EmitState = s0;
  let settled: boolean = false;
  let out: asmcore.EmitState = s0;
  while (!settled) {
    let h: usize = buf_new(65536);
    let t: asmcore.EmitState = emit_ir_runtime(asmcore.EmitState { ...s, capture: h }, darwin);
    let text: string = buf_take(h);
    buf_free(h);
    if (t.needed.len() == s.needed.len()) {
      settled = true;
      let back: asmcore.EmitState = asmcore.EmitState { ...t, capture: s0.capture };
      out = back.write(text);
    } else {
      s = asmcore.EmitState { ...s0, needed: t.needed };
    }
  }
  return out;
}

pub function emit_ir_runtime(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  if (s.profile > 0) {
    s = emit_profile_runtime(s, darwin);
  }
  s = emit_rt_clock_and_print(s, darwin);
  s = emit_rt_io_and_string(s);
  s = emit_rt_heap(s, darwin);
  s = emit_rt_collections_and_proc(s, darwin);
  return emit_rodata_pools_arm64(s, darwin);
}

pub function emit_module_or_error_sub(mod: parser.Module, darwin: boolean, sub: ircore.Sub, recs: usize): string {
  if (!sub.checked) {
    let parse_errs: util.Diag[] = asmcore.parse_unknown_errors_module(mod);
    if (parse_errs.len() > 0) {
      eprint(util.format_diags(parse_errs));
      exit(1);
      return "";
    }
  }
  let tm: parser.Module = checker.ensure_annotated(mod);
  if (!sub.checked) {
    let check_errs: util.Diag[] = asmcore.entry_check_errors(tm);
    if (check_errs.len() > 0) {
      eprint(util.format_diags(check_errs));
      exit(1);
      return "";
    }
  }
  let g: string = emit_module_ir_gated_sub(ircore.sub_lifted(sub, tm), darwin, sub, recs);
  if (g != "") {
    return g;
  }
  ircore.eprint_ir_ineligible();
  exit(1);
  return "";
}

pub function emit_module_ir_gated_sub(mod: parser.Module, darwin: boolean, sub: ircore.Sub, recs: usize): string {
  let g: ircore.Gated = ircore.gate_program(mod, sub);
  if (!g.ok) {
    return "";
  }
  return emit_module_ir_flat(g.im, g.stab, darwin, ircore.inline_tiny_leaves(g.im, g.cache), g.physical, sub.rt_lower, recs, sub.switches);
}

function emit_module_ir_flat(mod: parser.Module, stab: irtables.StructTab, darwin: boolean, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (string) => physicalbody.Lowered, recs: usize, sw: asmcore.Switches): string {
  let s: asmcore.EmitState = asmcore.new_state();
  s = asmcore.with_funcs(asmcore.with_switches(asmcore.EmitState { ...s, struct_decls: stab, rt_lower: rt, recs: recs, memo: irverifygate.open_memo("arm64") }, sw), mod.funcs);
  s = emit_body(mod, s, darwin, cache, physical);
  s = emit_ir_runtime_settled(s, darwin);
  irverifygate.close_memo(s.memo);
  return s.take_text();
}

pub function emit_module_ir_unit_arm64_flat(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (string) => physicalbody.Lowered, sw: asmcore.Switches): string {
  return emit_module_ir_unit_arm64_prepared(mod, is_entry, globl_defs, str_ns, extra_needs, all_funcs, all_structs, lo, hi, cache, physical, rt, sw, false).text;
}

pub function emit_module_ir_unit_arm64_prepared(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irtables.StructTab, lo: i32, hi: i32, cache: irtables.LowerResult[], physical: physicalbody.Collection, rt: (string) => physicalbody.Lowered, sw: asmcore.Switches, retain: boolean): ssaprepare.Output {
  mod = parser.infer_ret_types_module(mod);
  let s: asmcore.EmitState = asmcore.new_state();
  s = asmcore.EmitState { ...s, retain_prepared: retain, memo: irverifygate.open_memo("arm64") };
  s = asmcore.with_funcs(asmcore.with_switches(asmcore.EmitState { ...s, struct_decls: all_structs, str_ns: str_ns, rt_lower: rt }, sw), all_funcs);
  let derrs: util.Diag[] = asmcore.display_errs_module(mod, s);
  if (derrs.len() > 0) {
    eprint(util.format_diags(derrs));
    exit(1);
    return ssaprepare.Output { text: "", bodies: [] };
  }
  if (is_entry) {
    s = s.write("    .globl _start\n");
  }
  s = s.write("    .text\n");
  if (is_entry && globl_defs) {
    s = asmcore.emit_runtime_globls(s);
    for name in leaf_aborts() {
      s = s.write(".globl " + name + "_leaf\n");
    }
  }
  let vgate: irverifygate.Gate = irverifygate.with_memo(irverifygate.gate(irtables.fn_sig_index(all_funcs), s.kinds.pops, physicalbody.abis(physical)), s.memo);
  let hh: i32 = hi;
  if (hh < 0 || hh > mod.funcs.len()) {
    hh = mod.funcs.len();
  }
  ircore.check_fip_claims(mod.funcs, lo, hh, cache);
  let unit: asmcore.UnitLeaves = asmcore.unit_leaves(mod, lo, hh, cache);
  s = asmcore.EmitState { ...s, reg_entries: irtables.sig_reg_of(asmcore.unit_labels(mod, lo, hh, cache)), leaves: unit.leaves };
  let fabi: asmcore.FloatAbi = asmcore.unit_float_abi(mod, lo, hh, cache);
  s = asmcore.EmitState { ...s, float_abi: fabi.names, float_abi_masks: fabi.masks };
  let fi: i32 = lo;
  while (fi < hh) {
    let r: irtables.LowerResult = ircore.produced(cache, fi, mod.funcs[fi]);
    if (r.superseded) {
      fi = fi + 1;
      continue;
    }
    if (globl_defs) {
      let gname: string = mod.funcs[fi].name;
      if (mod.funcs[fi].receiver_type.len() > 0) {
        gname = util.base_type_name(mod.funcs[fi].receiver_type) + "." + mod.funcs[fi].name;
      }
      s = s.write(".globl __fn_" + asmcore.sanitize_label(gname) + "\n.globl __fn_" + asmcore.sanitize_label(gname) + ".k\n");
    }
    s = emit_function_via_ir_pre(r, physicalbody.select(physical, fi), s.prelift(unit.pre, fi, r), mod.funcs[fi], s, vgate);
    fi = fi + 1;
  }
  s = emit_named_bodies(cache, physical, unit.pre, mod.funcs.len(), s, vgate);
  irverifygate.report(vgate);
  let en: i32 = 0;
  while (en < extra_needs.len()) {
    s = s.need(extra_needs[en]);
    en = en + 1;
  }
  if (is_entry) {
    s = emit_ir_start(s, false);
  }
  if (is_entry) {
    s = emit_ir_runtime_settled(s, false);
  } else {
    s = emit_rodata_pools_arm64(s, false);
  }
  irverifygate.close_memo(s.memo);
  return ssaprepare.Output { text: s.take_text(), bodies: s.prepared };
}

function darwin_lstrip(s: string): string {
  let i: i32 = 0;
  while (i < s.len() && s[i] == 32) {
    i = i + 1;
  }
  return slice_unchecked(s, i, s.len()) + "";
}

function darwin_skip_quoted(s: string, i: i32): i32 {
  let n: i32 = s.len();
  let j: i32 = i + 1;
  while (j < n) {
    let c: u8 = s[j];
    if (c == 92 && j + 1 < n) {
      j = j + 1;
    } else if (c == 34) {
      return j + 1;
    }
    j = j + 1;
  }
  return n;
}

function darwin_index_of_unquoted(s: string, sub: string): i32 {
  let n: i32 = s.len();
  let m: i32 = sub.len();
  let i: i32 = 0;
  while (i < n) {
    if (s[i] == 34) {
      i = darwin_skip_quoted(s, i);
    } else if (i + m <= n && slice_unchecked(s, i, i + m) == sub) {
      return i;
    } else {
      i = i + 1;
    }
  }
  return 0 - 1;
}

function darwin_sysno(n: i32): i32 {
  if (n == 63) {
    return 3;
  }
  if (n == 64) {
    return 4;
  }
  if (n == 57) {
    return 6;
  }
  if (n == 56) {
    return 463;
  }
  if (n == 61) {
    return 344;
  }
  if (n == 62) {
    return 199;
  }
  if (n == 79) {
    return 470;
  }
  if (n == 35) {
    return 472;
  }
  if (n == 34) {
    return 475;
  }
  if (n == 24) {
    return 90;
  }
  if (n == 221) {
    return 59;
  }
  if (n == 260) {
    return 7;
  }
  if (n == 198) {
    return 97;
  }
  if (n == 200) {
    return 104;
  }
  if (n == 201) {
    return 106;
  }
  if (n == 202) {
    return 30;
  }
  if (n == 206) {
    return 133;
  }
  if (n == 93) {
    return 1;
  }
  if (n == 94) {
    return 1;
  }
  if (n == 222) {
    return 197;
  }
  if (n == 226) {
    return 74;
  }
  return darwin_profile_process_sysno(n);
}

function darwin_profile_process_sysno(n: i32): i32 {
  if (n == 172) {
    return 20;
  }
  if (n == 178) {
    return 372;
  }
  return darwin_profile_signal_sysno(n);
}

function darwin_profile_signal_sysno(n: i32): i32 {
  if (n == 103) {
    return 83;
  }
  if (n == 134) {
    return 46;
  }
  if (n == 132) {
    return 53;
  }
  if (n == 135) {
    return 48;
  }
  return 0 - 1;
}

function darwin_retarget_locals(line: string): string {
  let n: i32 = line.len();
  let i: i32 = 0;
  let out: string = "";
  let run: i32 = 0;
  while (i < n) {
    let c: u8 = line[i];
    if (c == 34) {
      i = darwin_skip_quoted(line, i);
      continue;
    } else if (c == 46 && i + 1 < n && line[i + 1] == 76
      && (i == 0 || !darwin_is_sym_byte(line[i - 1]))) {
      out = out + slice_unchecked(line, run, i);
      run = i + 1;
      i = i + 1;
      continue;
    }
    if (c == 95 && (i == 0 || !darwin_is_sym_byte(line[i - 1])) && darwin_is_reg_entry(line, i)) {
      out = out + slice_unchecked(line, run, i) + "L";
      run = i;
    }
    i = i + 1;
  }
  if (run == 0 && out.len() == 0) {
    return line;
  }
  return out + slice_unchecked(line, run, n);
}

function darwin_is_reg_entry(line: string, i: i32): boolean {
  if (!util.str_has_prefix(slice_unchecked(line, i, line.len()), "__fn_")) {
    return false;
  }
  let j: i32 = i;
  while (j < line.len() && darwin_is_sym_byte(line[j])) {
    j = j + 1;
  }
  return j - i > 7 && line[j - 2] == 46 && (line[j - 1] == 114 || line[j - 1] == 107);
}

function darwin_is_sym_byte(b: u8): boolean {
  if (b == 95 || b == 36 || b == 46) {
    return true;
  }
  if (b >= 48 && b <= 57) {
    return true;
  }
  if (b >= 97 && b <= 122) {
    return true;
  }
  return b >= 65 && b <= 90;
}

function darwin_feeds_svc(asm: string, from: i32): boolean {
  let n: i32 = asm.len();
  let start: i32 = from;
  let i: i32 = from;
  while (i <= n) {
    if (i == n || asm[i] == 10) {
      let body: string = darwin_lstrip(slice_unchecked(asm, start, i));
      if (body == "svc #0") {
        return true;
      }
      if (darwin_ends_flow(body) || util.str_has_prefix(body, "mov x8,") || util.str_has_prefix(body, "ldr x8,") || darwin_writes_x8(body)) {
        return false;
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return false;
}

function darwin_ends_flow(body: string): boolean {
  if (body.len() > 0 && body[body.len() - 1] == 58) {
    return true;
  }
  if (util.str_has_prefix(body, "b.") || util.str_has_prefix(body, "b ") || util.str_has_prefix(body, "bl ") || util.str_has_prefix(body, "br ") || util.str_has_prefix(body, "blr ") || body == "ret") {
    return true;
  }
  return util.str_has_prefix(body, "cbz ") || util.str_has_prefix(body, "cbnz ") || util.str_has_prefix(body, "tbz ") || util.str_has_prefix(body, "tbnz ");
}

function darwin_writes_x8(body: string): boolean {
  let sp: i32 = darwin_index_of_unquoted(body, " ");
  if (sp < 0) {
    return false;
  }
  let op: str = slice_unchecked(body, 0, sp);
  if (util.str_has_prefix(op, "st") || op == "cmp" || op == "cmn" || op == "tst") {
    return false;
  }
  let rest: str = slice_unchecked(body, sp + 1, body.len());
  return util.str_has_prefix(rest, "x8,") || util.str_has_prefix(rest, "w8,");
}

pub function darwinize(asm: string): string {
  let h: usize = buf_new(asm.len() + asm.len() / 8);
  let n: i32 = asm.len();
  let start: i32 = 0;
  let i: i32 = 0;
  let pend_sys: i32 = 0 - 1;
  let norm_n: i32 = 0;
  while (i <= n) {
    if (i == n || asm[i] == 10) {
      let line: str = slice_unchecked(asm, start, i);
      let has_nl: boolean = i < n;
      let body: string = darwin_lstrip(line);
      let keep: boolean = true;
      let out_line: string = line + "";

      if (util.str_has_prefix(body, ".type ") || util.str_has_prefix(body, ".size ")) {
        keep = false;
      } else if ((util.str_has_prefix(body, ".globl ") || util.str_has_prefix(body, ".weak ")) && darwin_is_reg_entry(body, darwin_index_of_unquoted(body, " ") + 1)) {
        keep = false;
      } else if (util.str_has_prefix(body, ".note.GNU-stack")) {
        keep = false;
      } else if (body == ".section .rodata") {
        out_line = "    .section __TEXT,__const";
      } else if (body == ".data" || body == ".section .data") {
        out_line = "    .section __DATA,__data";
      } else if (body == ".bss" || body == ".section .bss") {
        out_line = "    .section __DATA,__bss";
      } else if (body == ".section .text") {
        out_line = "    .text";
      } else if (body == ".globl _start" || body == ".global _start") {
        out_line = "    .globl _main";
      } else if (line == "_start:") {
        out_line = "_main:";
      } else if (util.str_has_prefix(body, "adrp ")) {
        out_line = line + "@PAGE";
      } else if (darwin_index_of_unquoted(line, ":lo12:") >= 0) {
        let idx: i32 = darwin_index_of_unquoted(line, ":lo12:");
        out_line = slice_unchecked(line, 0, idx) + slice_unchecked(line, idx + 6, line.len()) + "@PAGEOFF";
      } else if (body == "ldr x8, [sp], #16" && darwin_feeds_svc(asm, i + 1)) {
        out_line = "    ldr x16, [sp], #16";
        pend_sys = 0;
      } else if (util.str_has_prefix(body, "mov x8, #") && darwin_feeds_svc(asm, i + 1)) {
        let num: i32 = util.digits_to_i32(slice_unchecked(body, 9, body.len()));
        let m: i32 = darwin_sysno(num);
        pend_sys = m;
        if (m >= 0) {
          out_line = "    mov x16, #" + util.i32_to_string(m);
        }
      } else if (body == "svc #0") {
        if (pend_sys == 1) {
          out_line = "    svc #0x80";
        } else if (pend_sys >= 0) {
          let lbl: string = ".Ldwsc_" + util.i32_to_string(norm_n);
          norm_n = norm_n + 1;
          out_line = "    svc #0x80\n    b.cc " + lbl + "\n    neg x0, x0\n" + lbl + ":";
        }
        pend_sys = 0 - 1;
      }

      if (keep) {
        buf_push(h, darwin_retarget_locals(out_line));
        if (has_nl) {
          buf_push(h, "\n");
        }
      }
      start = i + 1;
    }
    i = i + 1;
  }
  let text: string = buf_take(h);
  buf_free(h);
  return text;
}

function ssa_fused_loc(source: ssaprepare.SourceLines, blk: ssa.SBlock, begin: i32, tailed: boolean, s: asmcore.EmitState): asmcore.EmitState {
  let mi: i32 = begin;
  while (mi < blk.insts.len()) {
    s = ssa_prepared_loc(source.values, blk.insts[mi].result, s);
    mi = mi + 1;
  }
  if (!tailed) {
    s = ssa_prepared_loc(source.terms, blk.id, s);
  }
  return s;
}
