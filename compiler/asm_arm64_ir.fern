function emit_arm64_op_memset(i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
  s = s.write(lp + "ms" + util.i32_to_string(i) + ":\n");
  s = s.write("    cbz x2, " + lp + "msd" + util.i32_to_string(i) + "\n");
  s = s.write("    strb w1, [x0], #1\n    sub x2, x2, #1\n");
  s = s.write("    b " + lp + "ms" + util.i32_to_string(i) + "\n");
  s = s.write(lp + "msd" + util.i32_to_string(i) + ":\n");
  return s.write("    mov x0, #0\n    str x0, [sp, #-16]!\n");
}

function ssa_dyn_dispatch(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  let args: asmcore.DynArg[] = [];
  let moved: boolean = false;
  for v in ins.args {
    if (reg_of[v] >= 0) {
      let home: string = ssa_reg(reg_of[v]);
      if (home == "x0") {
        if (!moved) {
          s = s.write("    mov x4, x0\n");
          moved = true;
        }
        home = "x4";
      }
      args = args.append(asmcore.DynArg { reg: home, off: 0 });
    } else {
      args = args.append(asmcore.DynArg { reg: "", off: ssa_slot_off(ssa.spill_slot(reg_of[v])) - s.ssa_save });
    }
  }
  s = emit_dyn_dispatch_chain(ins.str, args, ins.imm, lp, s);
  return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

function ssa_flat_op(ins: ssa.SInst, reg_of: i32[], lp: string, r: irtables.LowerResult, s: asmcore.EmitState): asmcore.EmitState {
  let kind: i32 = r.ops[ins.imm].kind_tag;
  if (kind == 112) {
    s = ssa_x0_forget(s);
    let d: string = ssa_dst(reg_of, ins.result);
    s = ssa_load(reg_of, ins.args[0], d, s);
    return ssa_store(reg_of, ins.result, d, s);
  }

  if (asmcore.buf_helper(r.ops[ins.imm].kind_tag) != "") {
    return ssa_buf_call(ins, reg_of, asmcore.buf_table_helper(r.ops[ins.imm].kind_tag, ir.is_packed(r.ops[ins.imm])), s);
  }
  s = ssa_x0_forget(s);
  let outer: usize = s.capture;
  let h: usize = buf_new(256);
  s = emit_stack_op(r.ops[ins.imm], ins.imm, lp, r, asmcore.EmitState { ...s, capture: h });
  let arm: string = buf_take(h);
  buf_free(h);
  s = asmcore.EmitState { ...s, capture: outer };
  let pops: string[] = ssa_leading_pops(arm, ins.args.len());
  if (!ssa_pops_ordered(ins, reg_of, pops)) {
    pops = [];
  }
  let stacked: i32 = ins.args.len() - pops.len();
  let i: i32 = 0;
  while (i < stacked) {
    s = ssa_push_operand(reg_of, ins.args[i], i * 16, s);
    i = i + 1;
  }
  for k in ssa_pop_order(ins, reg_of, pops) {
    s = ssa_load_pushed(reg_of, ins.args[ins.args.len() - 1 - k], pops[k], stacked * 16, s);
  }
  let body: string = slice_unchecked(arm, ssa_pops_len(pops), arm.len()) + "";
  let result: string = ssa_trailing_push(body);
  if (result != "") {
    s = s.write(slice_unchecked(body, 0, body.len() - ssa_push_line(result).len()) + "");
    return ssa_store(reg_of, ins.result, result, ssa_x0_forget(s));
  }
  s = s.write(body + "    ldr x0, [sp], #16\n");
  return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

function ssa_pop_line(reg: string): string {
  return "    ldr " + reg + ", [sp], #16\n";
}

function ssa_push_line(reg: string): string {
  return "    str " + reg + ", [sp, #-16]!\n";
}

function ssa_pops_len(pops: string[]): i32 {
  let n: i32 = 0;
  for p in pops {
    n = n + ssa_pop_line(p).len();
  }
  return n;
}

function ssa_leading_pops(arm: string, limit: i32): string[] {
  let out: string[] = [];
  let at: i32 = 0;
  while (out.len() < limit) {
    let reg: string = ssa_line_reg(arm, at, "    ldr x", ", [sp], #16\n");
    if (reg == "") {
      return out;
    }
    out = out.append(reg);
    at = at + ssa_pop_line(reg).len();
  }
  return out;
}

function ssa_trailing_push(body: string): string {
  let at: i32 = body.len() - 1;
  if (at < 0 || body[at] != 10) {
    return "";
  }
  at = at - 1;
  while (at >= 0 && body[at] != 10) {
    at = at - 1;
  }
  let reg: string = ssa_line_reg(body, at + 1, "    str x", ", [sp, #-16]!\n");
  if (reg == "" || at + 1 + ssa_push_line(reg).len() != body.len()) {
    return "";
  }
  return reg;
}

function ssa_line_reg(text: string, at: i32, prefix: string, suffix: string): string {
  if (at + prefix.len() > text.len()) {
    return "";
  }
  if (slice_unchecked(text, at, at + prefix.len()) != prefix) {
    return "";
  }
  let end: i32 = at + prefix.len();
  while (end < text.len() && text[end] >= 48 && text[end] <= 57) {
    end = end + 1;
  }
  if (end == at + prefix.len() || end + suffix.len() > text.len()) {
    return "";
  }
  if (slice_unchecked(text, end, end + suffix.len()) != suffix) {
    return "";
  }
  return "x" + slice_unchecked(text, at + prefix.len(), end);
}

function ssa_pops_ordered(ins: ssa.SInst, reg_of: i32[], pops: string[]): boolean {
  return ssa_pop_order(ins, reg_of, pops).len() == pops.len();
}

function ssa_pop_order(ins: ssa.SInst, reg_of: i32[], pops: string[]): i32[] {
  let srcs: string[] = [];
  let k: i32 = 0;
  while (k < pops.len()) {
    let v: i32 = ins.args[ins.args.len() - 1 - k];
    let src: string = "";
    if (reg_of[v] >= 0) {
      src = ssa_reg(reg_of[v]);
    }
    srcs = srcs.append(src);
    k = k + 1;
  }
  let done: boolean[] = __alloc_bool(pops.len());
  let order: i32[] = [];
  let progressed: boolean = true;
  while (progressed && order.len() < pops.len()) {
    progressed = false;
    let i: i32 = 0;
    while (i < pops.len()) {
      if (!done[i] && !ssa_still_read(srcs, done, pops[i], i)) {
        order = order.append(i);
        done = done.with(i, true);
        progressed = true;
      }
      i = i + 1;
    }
  }
  return order;
}

function ssa_still_read(srcs: string[], done: boolean[], reg: string, self: i32): boolean {
  let j: i32 = 0;
  while (j < srcs.len()) {
    if (j != self && !done[j] && srcs[j] == reg) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

function ssa_buf_call(ins: ssa.SInst, reg_of: i32[], sym: string, s: asmcore.EmitState): asmcore.EmitState {
  s = ssa_x0_forget(s);
  s = s.need("heap");
  s = s.need("buf");
  if (sym == "__fern_buf_take") {
    s = s.need("buf_text");
  } else if (sym == "__fern_buf_take_bytes") {
    s = s.need("buf_take_bytes");
  } else if (sym == "__fern_buf_take_bytes_u8") {
    s = s.need("buf_take_bytes_u8");
  } else if (sym == "__fern_buf_push_bytes_range") {
    s = s.need("buf_push_bytes_range");
  } else if (sym == "__fern_buf_push_bytes_range_u8") {
    s = s.need("buf_push_bytes_range_u8");
  } else if (util.str_has_prefix(sym, "__fern_buf_push_bytes_")) {
    if (util.str_has_suffix(sym, "_u8")) {
      s = s.need("buf_bytes_u8");
    } else {
      s = s.need("buf_bytes");
    }
  } else if (util.str_has_suffix(sym, "_u8")) {
    s = s.need("buf_u8");
  }
  s = ssa_load_helper_args(reg_of, ins.args, s);
  s = ssa_bl_sym(s, sym);
  return ssa_store(reg_of, ins.result, "x0", ssa_x0_forget(s));
}

function ssa_load_helper_args(reg_of: i32[], args: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let homes: i32[] = [0, 8, 9, 10];
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  let i: i32 = 0;
  while (i < args.len() && i < homes.len()) {
    srcs = srcs.append(reg_of[args[i]]);
    dsts = dsts.append(homes[i]);
    i = i + 1;
  }
  s = ssa_parallel_moves(srcs, dsts, s);
  while (i < args.len()) {
    s = ssa_load(reg_of, args[i], "x" + util.i32_to_string(i), s);
    i = i + 1;
  }
  return s;
}

function emit_arm64_op_memcpy(o: ir.Op, i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
  let mi: string = util.i32_to_string(i);
  s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
  s = arm64_copy_bytes(s, CopyRegs { dst: "x0", src: "x1", n: "x2", tmp: "x4", src_end: "x9", dst_end: "x10" }, lp + "mc" + mi, lp + "mct" + mi, lp + "mcb" + mi, lp + "mcd" + mi);
  s = s.write("    mov x0, #0\n    str x0, [sp, #-16]!\n");

  return s;
}

struct CopyRegs { dst: string, src: string, n: string, tmp: string, src_end: string, dst_end: string }

function arm64_copy_bytes(s: asmcore.EmitState, r: CopyRegs, words: string, tail: string, bytes: string, done: string): asmcore.EmitState {
  let tb: string = "w" + slice_unchecked(r.tmp, 1, r.tmp.len());
  s = s.write("    cbz " + r.n + ", " + done + "\n");
  s = s.write("    cmp " + r.n + ", #8\n    b.lo " + bytes + "\n");
  s = s.write("    add " + r.src_end + ", " + r.src + ", " + r.n + "\n    sub " + r.src_end + ", " + r.src_end + ", #8\n");
  s = s.write("    add " + r.dst_end + ", " + r.dst + ", " + r.n + "\n    sub " + r.dst_end + ", " + r.dst_end + ", #8\n");
  s = s.write(words + ":\n");
  s = s.write("    cmp " + r.dst + ", " + r.dst_end + "\n    b.hs " + tail + "\n");
  s = s.write("    ldr " + r.tmp + ", [" + r.src + "], #8\n    str " + r.tmp + ", [" + r.dst + "], #8\n");
  s = s.write("    b " + words + "\n");
  s = s.write(tail + ":\n");
  s = s.write("    ldr " + r.tmp + ", [" + r.src_end + "]\n    str " + r.tmp + ", [" + r.dst_end + "]\n");
  s = s.write("    b " + done + "\n");
  s = s.write(bytes + ":\n");
  s = s.write("    ldrb " + tb + ", [" + r.src + "], #1\n    strb " + tb + ", [" + r.dst + "], #1\n    sub " + r.n + ", " + r.n + ", #1\n");
  s = s.write("    cbnz " + r.n + ", " + bytes + "\n");
  return s.write(done + ":\n");
}

function emit_arm64_op_heap_bump_bytes(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("heap");
  s = s.write("    adrp x0, __fern_heap_ptr\n    add x0, x0, :lo12:__fern_heap_ptr\n    ldr x0, [x0]\n");
  s = s.write("    adrp x1, __fern_heap_end\n    add x1, x1, :lo12:__fern_heap_end\n    ldr x1, [x1]\n");
  s = s.write("    sub x2, x0, x1\n");
  s = s.write("    mov x3, #1\n    lsl x3, x3, #34\n");
  s = s.write("    add x2, x2, x3\n");
  s = s.write("    cmp x0, #0\n");
  s = s.write("    csel x2, x2, xzr, ne\n");
  s = s.write("    str x2, [sp, #-16]!\n");

  return s;
}

function emit_arm64_op_heap_alloc_count(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("heap");
  s = s.need("alloc_count");
  s = s.write("    adrp x0, __fern_alloc_count\n    add x0, x0, :lo12:__fern_alloc_count\n    ldr x0, [x0]\n");
  s = s.write("    str x0, [sp, #-16]!\n");

  return s;
}

function emit_arm64_op_heap_release_to(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let hro: asmcore.LabelOut = asmcore.fresh_label(s);
  let hr_done: string = hro.name;
  s = hro.state;
  s = s.need("heap");
  s = s.write("    ldr x0, [sp], #16\n");
  s = s.write("    cbz x0, " + hr_done + "\n");
  s = s.write("    adrp x1, __fern_heap_ptr\n    add x1, x1, :lo12:__fern_heap_ptr\n    str x0, [x1]\n");
  s = arm64_copy_words(s, "__fern_freelist_shadow", "__fern_freelist", 65536);
  s = arm64_copy_words(s, "__fern_large_freelist_shadow", "__fern_large_freelist", 2560);
  s = s.write(hr_done + ":\n");
  s = s.write("    str x0, [sp, #-16]!\n");

  return s;
}

function emit_arm64_op_buf(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  if (o.kind_tag == 296) {
    s = s.need("buf_text");
  }
  if (o.kind_tag == 347) {
    s = s.need("buf_take_bytes" + asmcore.packed_suffix(ir.is_packed(o)));
  }
  if (o.kind_tag == 351) {
    s = s.need("buf_push_bytes_range" + asmcore.packed_suffix(ir.is_packed(o)));
  }
  s = s.need("heap");
  s = s.need("buf");
  let k: i32 = asmcore.buf_arity(o.kind_tag);
  while (k > 0) {
    k = k - 1;
    s = s.write("    ldr x" + util.i32_to_string(k) + ", [sp], #16\n");
  }
  let sym: string = asmcore.buf_table_helper(o.kind_tag, ir.is_packed(o));
  if (o.kind_tag >= 370 && o.kind_tag <= 372) {
    if (sym != asmcore.buf_helper(o.kind_tag)) {
      s = s.need("buf_bytes_u8");
    } else {
      s = s.need("buf_bytes");
    }
  } else if (o.kind_tag != 347 && o.kind_tag != 351 && sym != asmcore.buf_helper(o.kind_tag)) {
    s = s.need("buf_u8");
  }
  return s.write("    bl " + sym + "\n    str x0, [sp, #-16]!\n");
}

function helper_call_needs(name: string, s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("heap");
  if (name == "__fern_i32_to_string") {
    s = s.need("i32_to_string");
  }
  if (name == "__fern_u32_to_string") {
    s = s.need("u32_to_string");
  }
  if (name == "__fern_i64_to_string") {
    s = s.need("i64_to_string");
  }
  if (name == "__fern_u64_to_string") {
    s = s.need("u64_to_string");
  }
  if (name == "__fern_slice_abort") {
    s = s.need("heap");
  }
  s = s.need_array_helper(name);
  if (name == "__fern_arr_inc_elems") {
    s = s.need("arr_inc_elems");
  }
  if (name == "__fern_arr_own_elems") {
    s = s.need("arr_own_elems");
  }
  if (name == "__fern_str_own") {
    s = s.need("str_own");
  }
  if (name == "__fern_str_borrow") {
    s = s.need("str_borrow");
  }
  if (name == "__fern_str_grow" || name == "__fern_str_grow_range" || name == "__fern_str_grow_fresh" || name == "__fern_str_grow_fresh_range") {
    s = s.need("str_grow");
  }
  if (name == "__fern_account_entry") {
    s = s.need("account");
  }
  if (name == "__fern_set_args") {
    s = s.need("set_args");
  }
  return s;
}

function dyn_arg_load(s: asmcore.EmitState, reg: string, a: asmcore.DynArg): asmcore.EmitState {
  if (a.reg.len() > 0) {
    if (a.reg == reg) {
      return s;
    }
    return s.write("    mov " + reg + ", " + a.reg + "\n");
  }
  return fr_ldr(s, reg, a.off);
}

function emit_dyn_dispatch_chain(arms: string, args: asmcore.DynArg[], i: i32, lp: string, own s: asmcore.EmitState): asmcore.EmitState {
  let dargc: i32 = args.len();
  s = dyn_arg_load(s, "x0", args[0]);
  s = s.write("    ldr x1, [x0]\n");
  let dend: string = lp + "dynend" + util.i32_to_string(i);
  let dfi: i32 = 0;
  let darmn: i32 = 0;
  while (dfi < s.funcs.len()) {
    let dfd: parser.FuncDecl = s.funcs[dfi];
    let ddbn: string = util.base_type_name(dfd.receiver_type);
    let dprim: boolean = dfd.receiver_type.len() > 0 && asmcore.is_prim_recv_name(ddbn, s);
    if (irtables.dyn_arm_matches(dfd, arms) && dfd.receiver_type.len() > 0
      && (asmcore.is_struct_decl_name(ddbn, s) || dprim)) {
      let dbn: string = ddbn;
      let dlit: asmcore.ShapeRefOut = asmcore.shape_ref(s, dbn);
      s = dlit.state;
      let dnext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      s = s.write("    adrp x2, " + dlit.label + "\n");
      s = s.write("    add x2, x2, :lo12:" + dlit.label + "\n");
      s = s.write("    cmp x1, x2\n    b.ne " + dnext + "\n");
      let dk: i32 = dargc - 1;
      while (dk >= 0) {
        if (dk == 0 && dprim) {
          s = dyn_arg_load(s, "x0", args[0]);
          s = s.write("    ldr x0, [x0, #8]\n");
          s = s.write("    str x0, [sp, #-16]!\n");
        } else {
          s = dyn_arg_load(s, "x0", args[dk]);
          s = s.write("    str x0, [sp, #-16]!\n");
        }
        dk = dk - 1;
      }
      s = s.write("    bl __fn_" + asmcore.sanitize_label(dbn + "." + dfd.name) + "\n");
      s = s.write("    add sp, sp, #" + util.i32_to_string(dargc * 16) + "\n");
      s = s.write("    b " + dend + "\n");
      s = s.write(dnext + ":\n");
      darmn = darmn + 1;
    }
    if (irtables.dyn_arm_matches(dfd, arms) && dfd.receiver_type.len() > 0
      && !asmcore.recv_is_array(dfd.receiver_type)
      && irtables.decl_is_enum(s.struct_decls, ddbn)) {
      let dehit: string = lp + "dynehit" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      let denext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      let dvi: i32 = 0;
      while (dvi < s.struct_decls.decls.len()) {
        if (s.struct_decls.decls[dvi].enum_owner == ddbn) {
          let vlit_name: string = irtables.decl_shape(s.struct_decls.decls[dvi]);
          let vlit: asmcore.ShapeRefOut = asmcore.shape_ref(s, vlit_name);
          s = vlit.state;
          s = s.write("    adrp x2, " + vlit.label + "\n");
          s = s.write("    add x2, x2, :lo12:" + vlit.label + "\n");
          s = s.write("    cmp x1, x2\n    b.eq " + dehit + "\n");
        }
        dvi = dvi + 1;
      }
      s = s.write("    b " + denext + "\n");
      s = s.write(dehit + ":\n");
      let dek: i32 = dargc - 1;
      while (dek >= 0) {
        s = dyn_arg_load(s, "x0", args[dek]);
        s = s.write("    str x0, [sp, #-16]!\n");
        dek = dek - 1;
      }
      s = s.write("    bl __fn_" + asmcore.sanitize_label(ddbn + "." + dfd.name) + "\n");
      s = s.write("    add sp, sp, #" + util.i32_to_string(dargc * 16) + "\n");
      s = s.write("    b " + dend + "\n");
      s = s.write(denext + ":\n");
      darmn = darmn + 1;
    }
    dfi = dfi + 1;
  }
  s = s.write(profile_exit_asm(s.profile));
  s = s.write("    mov x8, #94\n    mov x0, #134\n    svc #0\n");
  s = s.write(dend + ":\n");
  return s;
}

function emit_arm64_op_dyn_box(o: ir.Op, own s: asmcore.EmitState): asmcore.EmitState {
  let dbl: asmcore.ShapeRefOut = asmcore.shape_ref(s, o.str);
  s = dbl.state;
  s = s.need("heap");
  s = s.write("    mov x0, #2\n    bl __fern_arr_box\n");
  s = s.write("    adrp x2, " + dbl.label + "\n");
  s = s.write("    add x2, x2, :lo12:" + dbl.label + "\n");
  s = s.write("    str x2, [x0]\n");
  s = s.write("    ldr x1, [sp], #16\n    str x1, [x0, #8]\n");
  s = s.write("    str x0, [sp, #-16]!\n");

  return s;
}

pub function reloc_wanted(s: asmcore.EmitState, darwin: boolean): boolean {
  return !darwin && s.str_ns.len() == 0;
}

function emit_ir_reloc(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  if (!reloc_wanted(s, darwin)) {
    return s;
  }
  s = s.write("    adrp x9, .Lfern_relanchor\n");
  s = s.write("    add x9, x9, :lo12:.Lfern_relanchor\n");
  s = s.write("    ldr x10, [x9]\n");
  s = s.write("    sub x9, x9, x10\n");
  s = s.write("    cbz x9, .Lfern_reloc_done\n");
  s = s.write("    adrp x11, .Lfern_sbox_begin\n");
  s = s.write("    add x11, x11, :lo12:.Lfern_sbox_begin\n");
  s = s.write("    adrp x12, .Lfern_sbox_end\n");
  s = s.write("    add x12, x12, :lo12:.Lfern_sbox_end\n");
  s = s.write(".Lfern_sbox_loop:\n");
  s = s.write("    cmp x11, x12\n");
  s = s.write("    b.hs .Lfern_sbox_done\n");
  s = s.write("    ldr x13, [x11, #8]\n");
  s = s.write("    add x13, x13, x9\n");
  s = s.write("    str x13, [x11, #8]\n");
  s = s.write("    add x11, x11, #24\n");
  s = s.write("    b .Lfern_sbox_loop\n");
  s = s.write(".Lfern_sbox_done:\n");
  s = s.write("    adrp x11, .Lfern_cagg_begin\n");
  s = s.write("    add x11, x11, :lo12:.Lfern_cagg_begin\n");
  s = s.write("    adrp x12, .Lfern_cagg_end\n");
  s = s.write("    add x12, x12, :lo12:.Lfern_cagg_end\n");
  s = s.write(".Lfern_cagg_loop:\n");
  s = s.write("    cmp x11, x12\n");
  s = s.write("    b.hs .Lfern_cagg_done\n");
  s = s.write("    ldr x13, [x11, #16]\n");
  s = s.write("    add x13, x13, x9\n");
  s = s.write("    str x13, [x11, #16]\n");
  s = s.write("    ldr x14, [x11]\n");
  s = s.write("    add x11, x11, #16\n");
  s = s.write("    add x11, x11, x14, lsl #3\n");
  s = s.write("    b .Lfern_cagg_loop\n");
  s = s.write(".Lfern_cagg_done:\n");
  s = s.write("    adrp x11, .Lfern_cfn_begin\n");
  s = s.write("    add x11, x11, :lo12:.Lfern_cfn_begin\n");
  s = s.write("    adrp x12, .Lfern_cfn_end\n");
  s = s.write("    add x12, x12, :lo12:.Lfern_cfn_end\n");
  s = s.write(".Lfern_cfn_loop:\n");
  s = s.write("    cmp x11, x12\n");
  s = s.write("    b.hs .Lfern_cfn_done\n");
  s = s.write("    ldr x13, [x11, #24]\n");
  s = s.write("    add x13, x13, x9\n");
  s = s.write("    str x13, [x11, #24]\n");
  s = s.write("    add x11, x11, #32\n");
  s = s.write("    b .Lfern_cfn_loop\n");
  s = s.write(".Lfern_cfn_done:\n");
  s = s.write("    adrp x11, .Lfern_cref_begin\n");
  s = s.write("    add x11, x11, :lo12:.Lfern_cref_begin\n");
  s = s.write("    adrp x12, .Lfern_cref_end\n");
  s = s.write("    add x12, x12, :lo12:.Lfern_cref_end\n");
  s = s.write(".Lfern_cref_loop:\n");
  s = s.write("    cmp x11, x12\n");
  s = s.write("    b.hs .Lfern_reloc_done\n");
  s = s.write("    ldr x13, [x11]\n");
  s = s.write("    add x13, x13, x9\n");
  s = s.write("    ldr x14, [x13]\n");
  s = s.write("    add x14, x14, x9\n");
  s = s.write("    str x14, [x13]\n");
  s = s.write("    add x11, x11, #8\n");
  s = s.write("    b .Lfern_cref_loop\n");
  s = s.write(".Lfern_reloc_done:\n");
  return s;
}

function emit_vdso_scan(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    ldr x0, [sp]\n");
  s = s.write("    lsl x0, x0, #3\n");
  s = s.write("    add x0, x0, #16\n");
  s = s.write("    add x0, sp, x0\n");
  s = s.write(".Lfern_auxv_env:\n");
  s = s.write("    ldr x1, [x0], #8\n");
  s = s.write("    cbnz x1, .Lfern_auxv_env\n");
  s = s.write(".Lfern_auxv_scan:\n");
  s = s.write("    ldp x1, x2, [x0], #16\n");
  s = s.write("    cbz x1, .Lfern_auxv_done\n");
  s = s.write("    cmp x1, #33\n");
  s = s.write("    b.ne .Lfern_auxv_scan\n");
  s = s.write("    adrp x1, __fern_vdso\n");
  s = s.write("    add x1, x1, :lo12:__fern_vdso\n");
  s = s.write("    str x2, [x1]\n");
  s = s.write(".Lfern_auxv_done:\n");
  return s;
}

function emit_ir_start(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  s = s.write("_start:\n");
  s = emit_ir_reloc(s, darwin);
  if (darwin) {
    if (s.has_need("args")) {
      s = s.write("    adrp x3, __fern_argc\n");
      s = s.write("    add x3, x3, :lo12:__fern_argc\n");
      s = s.write("    str x0, [x3]\n");
      s = s.write("    adrp x3, __fern_argv\n");
      s = s.write("    add x3, x3, :lo12:__fern_argv\n");
      s = s.write("    str x1, [x3]\n");
    }
    if (s.has_need("heap")) {
      s = s.write("    adrp x3, __fern_envp\n");
      s = s.write("    add x3, x3, :lo12:__fern_envp\n");
      s = s.write("    str x2, [x3]\n");
    }
  } else {
    if (s.has_need("args")) {
      s = s.write("    ldr x0, [sp]\n");
      s = s.write("    adrp x1, __fern_argc\n");
      s = s.write("    add x1, x1, :lo12:__fern_argc\n");
      s = s.write("    str x0, [x1]\n");
      s = s.write("    add x0, sp, #8\n");
      s = s.write("    adrp x1, __fern_argv\n");
      s = s.write("    add x1, x1, :lo12:__fern_argv\n");
      s = s.write("    str x0, [x1]\n");
    }
    if (s.has_need("heap")) {
      s = s.write("    ldr x0, [sp]\n");
      s = s.write("    lsl x0, x0, #3\n");
      s = s.write("    add x0, x0, #16\n");
      s = s.write("    add x0, sp, x0\n");
      s = s.write("    adrp x1, __fern_envp\n");
      s = s.write("    add x1, x1, :lo12:__fern_envp\n");
      s = s.write("    str x0, [x1]\n");
    }
    if (asmcore.vdso_wanted(s, "arm64-linux")) {
      s = emit_vdso_scan(s);
    }
  }
  if (!s.shared) {
    s = emit_stack_switch(s, darwin);
  }
  if (s.profile > 0) {
    s = s.write("    adrp x0, .Lprofile_ring\n    add x0, x0, :lo12:.Lprofile_ring\n");
    if (darwin) {
      s = s.write("    adrp x13, __mh_execute_header\n    add x13, x13, :lo12:__mh_execute_header\n    str x13, [x0, #56]\n");
    }
    s = s.write("    mov x9, sp\n    adrp x10, .Lprofile_action\n    add x10, x10, :lo12:.Lprofile_action\n    adrp x11, .Lprofile_timer\n    add x11, x11, :lo12:.Lprofile_timer\n    bl __fn___fern_profile_start.r\n    mov x29, xzr\n    mov x30, xzr\n");
  }
  s = s.write("    stp x29, x30, [sp, #-16]!\n");
  s = s.write("    mov x29, sp\n");
  if (asmcore.declares_main(s.funcs)) {
    s = s.write("    bl __fn_main\n");
    if (s.leak_check) {
      s = s.write("    mov x19, x0\n");
      s = s.write("    bl __fern_lc_report\n");
      s = s.write("    mov x0, x19\n");
    }
  } else {
    if (s.leak_check) {
      s = s.write("    bl __fern_lc_report\n");
    }
    s = s.write("    mov x0, #0\n");
  }
  s = s.write(profile_exit_asm(s.profile));
  s = s.write("    mov x8, #94\n");
  s = s.write("    svc #0\n");
  return s;
}

function emit_stack_switch(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  s = emit_stack_map(s, "    mov x1, #1\n    lsl x1, x1, #30\n", darwin);
  s = s.write("    tbnz x0, #63, .Lfern_stack_kept\n    mov x19, x0\n    mov x1, #1\n    lsl x1, x1, #20\n    mov x2, #0\n    mov x8, #226\n    svc #0\n");
  s = s.write("    mov x9, #1\n    lsl x9, x9, #30\n    add x9, x19, x9\n    sub sp, x9, #16\n.Lfern_stack_kept:\n");
  s = emit_stack_map(s, "    mov x1, #1\n    lsl x1, x1, #16\n", darwin);
  s = s.write("    tbnz x0, #63, .Lfern_segv_skip\n    mov x9, #1\n    lsl x9, x9, #16\n    sub sp, sp, #32\n");
  if (darwin) {
    s = s.write("    stp x0, x9, [sp]\n    str xzr, [sp, #16]\n");
  } else {
    s = s.write("    stp x0, xzr, [sp]\n    str x9, [sp, #16]\n");
  }
  s = s.write("    mov x0, sp\n    mov x1, #0\n    mov x8, #132\n    svc #0\n    adrp x9, __fern_segv\n    add x9, x9, :lo12:__fern_segv\n");
  if (darwin) {
    s = s.write("    adrp x10, __fern_segv_trampoline\n    add x10, x10, :lo12:__fern_segv_trampoline\n    mov x11, #0x41\n    lsl x11, x11, #32\n");
  } else {
    s = s.write("    mov x10, #4\n    movk x10, #0x800, lsl #16\n    mov x11, #0\n");
  }
  s = emit_segv_install(s.write("    stp x9, x10, [sp]\n    stp x11, xzr, [sp, #16]\n"), darwin);
  return s.write("    add sp, sp, #32\n.Lfern_segv_skip:\n");
}

function emit_stack_map(s: asmcore.EmitState, size: string, darwin: boolean): asmcore.EmitState {
  let flags: string = "    mov x3, #0x4022\n    orr x3, x3, #0x20000\n";
  if (darwin) {
    flags = "    mov x3, #0x1002\n";
  }
  return s.write("    mov x0, #0\n" + size + "    mov x2, #3\n" + flags + "    mov x4, #0\n    sub x4, x4, #1\n    mov x5, #0\n    mov x8, #222\n    svc #0\n");
}

function landing_pad(s: asmcore.EmitState): string {
  if (s.harden) {
    return "    bti c\n";
  }
  return "";
}

function emit_segv_install(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  let install: string = "    mov x1, sp\n    mov x2, #0\n    mov x3, #8\n    mov x8, #134\n    svc #0\n";
  s = s.write("    mov x0, #11\n" + install);
  if (darwin) {
    s = s.write("    mov x0, #10\n" + install);
  }
  return s;
}

function emit_stack_overflow_runtime(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  let msg: string = aborts.stack_overflow();
  let addr: string = "    ldr x9, [x1, #16]\n";
  let ctx: string = "    ldr x10, [x2, #432]\n";
  let frame: string = "    ldr x11, [x2, #440]\n    ldr x12, [x2, #416]\n";
  if (darwin) {
    addr = "    ldr x9, [x1, #24]\n";
    ctx = "    ldr x13, [x2, #48]\n    ldr x10, [x13, #264]\n    and x10, x10, #0x0000ffffffffffff\n";
    frame = "    ldr x11, [x13, #272]\n    ldr x12, [x13, #248]\n    and x11, x11, #0x0000ffffffffffff\n    and x12, x12, #0x0000ffffffffffff\n";
  }
  s = s.write("    .section .rodata\n.Lmsg_stack_overflow:\n    .ascii \"" + msg + "\\n\"\n    .text\n");
  s = s.write("__fern_segv:\n" + landing_pad(s) + addr + ctx + "    sub x9, x9, x10\n    mov x10, #1\n    lsl x10, x10, #20\n    add x9, x9, x10\n    lsl x10, x10, #1\n    cmp x9, x10\n    b.hs .Lfern_segv_other\n" + frame);
  s = s.write("    stp x12, x11, [sp, #-16]!\n    mov x29, sp\n    adrp x1, .Lmsg_stack_overflow\n    add x1, x1, :lo12:.Lmsg_stack_overflow\n    mov x2, #" + util.i32_to_string(msg.len() + 1) + "\n    mov x0, #134\n    b __fern_report\n");
  let tramp: string = "xzr";
  if (darwin) {
    s = s.write(".Lfern_segv_other:\n    adrp x10, __fern_segv_trampoline\n    add x10, x10, :lo12:__fern_segv_trampoline\n");
    tramp = "x10";
  } else {
    s = s.write(".Lfern_segv_other:\n");
  }
  s = emit_segv_install(s.write("    stp x29, x30, [sp, #-16]!\n    sub sp, sp, #32\n    stp xzr, " + tramp + ", [sp]\n    stp xzr, xzr, [sp, #16]\n"), darwin);
  s = s.write("    add sp, sp, #32\n    ldp x29, x30, [sp], #16\n    ret\n");
  if (darwin) {
    s = s.write("__fern_segv_trampoline:\n" + landing_pad(s) + "    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n    stp x1, x4, [sp, #-16]!\n    stp x5, xzr, [sp, #-16]!\n    mov x16, x0\n    mov x0, x2\n    mov x1, x3\n    mov x2, x4\n    blr x16\n    ldp x2, xzr, [sp], #16\n    ldp x1, x0, [sp], #16\n    ldp x29, x30, [sp], #16\n    mov x16, #184\n    svc #0x80\n    brk #0\n");
  }
  return s;
}

pub function emit_body(mod: parser.Module, s: asmcore.EmitState, darwin: boolean, cache: irtables.LowerResult[], physical: physicalbody.Collection): asmcore.EmitState {
  s = asmcore.with_funcs(s, mod.funcs);
  s = s.write("    .globl _start\n");
  s = s.write("    .text\n");
  let vgate: irverifygate.Gate = irverifygate.with_memo(irverifygate.gate(irtables.fn_sig_index(mod.funcs), s.kinds.pops, physicalbody.abis(physical)), s.memo);
  ircore.check_fip_claims(mod.funcs, 0, mod.funcs.len(), cache);
  let unit: asmcore.UnitLeaves = asmcore.unit_leaves(mod, 0, mod.funcs.len(), cache);
  s = asmcore.EmitState { ...s, reg_entries: irtables.sig_reg_of(asmcore.unit_labels(mod, 0, mod.funcs.len(), cache)), leaves: unit.leaves };
  let fabi: asmcore.FloatAbi = asmcore.unit_float_abi(mod, 0, mod.funcs.len(), cache);
  s = asmcore.EmitState { ...s, float_abi: fabi.names, float_abi_masks: fabi.masks };
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let r: irtables.LowerResult = ircore.produced(cache, fi, mod.funcs[fi]);
    if (!r.superseded) {
      s = emit_function_via_ir_pre(r, physicalbody.select(physical, fi), s.prelift(unit.pre, fi, r), mod.funcs[fi], s, vgate);
    }
    fi = fi + 1;
  }
  s = emit_named_bodies(cache, physical, unit.pre, mod.funcs.len(), s, vgate);
  irverifygate.report(vgate);
  return emit_ir_start(s, darwin);
}

function rt_arm64_str_eq(): string {
  let s: string = "__fn___fern_str_eq:\n";
  s = s + "    ldr x0, [sp]\n    ldr x9, [sp, #16]\n";
  s = s + "__fn___fern_str_eq.r:\n";
  s = s + "    cmp x0, x9\n    b.eq .Lseq_yes\n";
  s = s + "    ldr x4, [x0, #8]\n    ldr x5, [x9, #8]\n    cmp x4, x5\n    b.ne .Lseq_no\n";
  s = s + "    ldr x2, [x0]\n    ldr x3, [x9]\n";
  s = s + "    cmp x2, x3\n    b.eq .Lseq_yes\n";
  s = s + "    add x6, x2, x4\n    add x7, x3, x4\n";
  s = s + "    cmp x4, #8\n    b.lo .Lseq_short\n";
  s = s + "    sub x6, x6, #8\n    sub x7, x7, #8\n";
  s = s + ".Lseq_word:\n";
  s = s + "    ldr x0, [x2]\n    ldr x1, [x3]\n    cmp x0, x1\n    b.ne .Lseq_no\n";
  s = s + "    add x2, x2, #8\n    add x3, x3, #8\n";
  s = s + "    cmp x2, x6\n    b.lo .Lseq_word\n";
  s = s + "    ldr x0, [x6]\n    ldr x1, [x7]\n    cmp x0, x1\n    b.ne .Lseq_no\n";
  s = s + "    b .Lseq_yes\n";
  s = s + ".Lseq_short:\n";
  s = s + "    cbz x4, .Lseq_yes\n";
  s = s + "    cmp x4, #4\n    b.lo .Lseq_byte\n";
  s = s + "    ldr w0, [x2]\n    ldr w1, [x3]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
  s = s + "    sub x6, x6, #4\n    sub x7, x7, #4\n";
  s = s + "    ldr w0, [x6]\n    ldr w1, [x7]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
  s = s + "    b .Lseq_yes\n";
  s = s + ".Lseq_byte:\n";
  s = s + "    ldrb w0, [x2]\n    ldrb w1, [x3]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
  s = s + "    sub x6, x6, #1\n    sub x7, x7, #1\n";
  s = s + "    ldrb w0, [x6]\n    ldrb w1, [x7]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
  s = s + "    cmp x4, #3\n    b.lo .Lseq_yes\n";
  s = s + "    ldrb w0, [x2, #1]\n    ldrb w1, [x3, #1]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
  s = s + ".Lseq_yes:\n    mov x0, #1\n    ret\n";
  s = s + ".Lseq_no:\n    mov x0, #0\n    ret\n";
  s = s + ".size __fn___fern_str_eq, .-__fn___fern_str_eq\n";
  return s;
}

function emit_named_bodies(cache: irtables.LowerResult[], physical: physicalbody.Collection, pre: asmcore.Prelift[], from: i32, s: asmcore.EmitState, vgate: irverifygate.Gate): asmcore.EmitState {
  let xi: i32 = from;
  while (xi < cache.len()) {
    if (!s.has_named(cache[xi].name)) {
      s = emit_function_via_ir_named(cache[xi], physicalbody.select(physical, xi), s.prelift(pre, xi, cache[xi]), cache[xi].name, true, s, vgate).with_named(cache[xi].name);
    }
    xi = xi + 1;
  }
  return s;
}

function emit_array_helpers(s: asmcore.EmitState): asmcore.EmitState {
  let byte_copy = s.byte_copy_runtime();
  if (byte_copy != "") {
    s = emit_ir_runtime_fern_fn(byte_copy, s);
  }
  if (s.has_need("arr_str_join")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_str_join(), s);
  }
  if (s.has_need("arr_concat")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_concat(), s);
  }
  if (s.has_need("bytes_owned")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_bytes_owned(), s);
  }
  if (s.has_need("bytes_range")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_bytes_range(), s);
  }
  if (s.has_need("bytes_into")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_bytes_into(), s);
  }
  return s;
}

pub function emit_ir_runtime_fern_fn(src: string, s: asmcore.EmitState): asmcore.EmitState {
  let m: parser.Module = parser.infer_ret_types_module(parser.parse_module(lexer.tokenize(src)));
  let fns: parser.FuncDecl[] = m.funcs;
  let lowered: physicalbody.Lowered = s.rt_lower(src);
  let bodies: irtables.LowerResult[] = lowered.bodies;
  let physical = physicalbody.collection(lowered);
  let previous_regs: irtables.SigReg = s.reg_entries;
  let previous_leaves: ssa.Leaves = s.leaves;
  let previous_float: asmcore.FloatAbi = asmcore.FloatAbi { names: s.float_abi, masks: s.float_abi_masks };
  let unit: asmcore.UnitLeaves = asmcore.unit_leaves(m, 0, fns.len(), bodies);
  let fabi: asmcore.FloatAbi = asmcore.unit_float_abi(m, 0, fns.len(), bodies);
  s = asmcore.EmitState { ...s, reg_entries: irtables.sig_reg_of(asmcore.unit_labels(m, 0, fns.len(), bodies)), leaves: unit.leaves, float_abi: fabi.names, float_abi_masks: fabi.masks };
  let vgate: irverifygate.Gate = irverifygate.with_memo(irverifygate.gate_unreported(irtables.fn_sig_index(fns), s.kinds.pops, physicalbody.abis(physical)), s.memo);
  s = asmcore.export_runtime_fns(s, fns);
  let i: i32 = 0;
  while (i < fns.len()) {
    s = emit_function_via_ir_pre(bodies[i], physicalbody.select(physical, i), s.prelift(unit.pre, i, bodies[i]), fns[i], s, vgate);
    i = i + 1;
  }
  s = emit_named_bodies(bodies, physical, unit.pre, fns.len(), s, vgate);
  return asmcore.EmitState { ...s, reg_entries: previous_regs, leaves: previous_leaves, float_abi: previous_float.names, float_abi_masks: previous_float.masks };
}

function emit_ccall_shim1_arm64(s: asmcore.EmitState, variant: string, n: i32): asmcore.EmitState {
  s = s.write("\n__fn_" + variant + ":\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n");
  s = s.write("    ldr x9, [x29, #16]\n");
  if (n >= 1) {
    s = s.write("    ldr x0, [x29, #32]\n");
  }
  if (n >= 2) {
    s = s.write("    ldr x1, [x29, #48]\n");
  }
  if (n >= 3) {
    s = s.write("    ldr x2, [x29, #64]\n");
  }
  if (n >= 4) {
    s = s.write("    ldr x3, [x29, #80]\n");
  }
  if (s.shared) {
    s = s.write(busy_release_arm64());
  }
  s = s.write("    blr x9\n");
  if (s.shared) {
    s = s.write(busy_take_arm64());
  }
  if (util.str_has_suffix(variant, "_f32")) {
    s = s.write("    fcvt d0, s0\n");
  }
  if (util.str_has_suffix(variant, "_f32") || util.str_has_suffix(variant, "_f64")) {
    s = s.write("    fmov x0, d0\n");
  }
  s = s.write("    ldp x29, x30, [sp], #16\n    ret\n");
  return s;
}

pub function busy_take_arm64(): string {
  return "    adrp x16, __fern_busy\n    add x16, x16, :lo12:__fern_busy\n    mov w17, #1\n    swpal w17, w17, [x16]\n    cbnz w17, __fern_busy_abort\n";
}

pub function busy_release_arm64(): string {
  return "    adrp x16, __fern_busy\n    add x16, x16, :lo12:__fern_busy\n    stlr wzr, [x16]\n";
}

function emit_ccall_shims_arm64(s: asmcore.EmitState): asmcore.EmitState {
  let ca: i32 = 0;
  while (ca <= 4) {
    let cbase: string = "__c_call" + util.i32_to_string(ca);
    if (s.has_need("ccall:" + cbase)) {
      s = emit_ccall_shim1_arm64(s, cbase, ca);
    }
    if (s.has_need("ccall:" + cbase + "_f32")) {
      s = emit_ccall_shim1_arm64(s, cbase + "_f32", ca);
    }
    if (s.has_need("ccall:" + cbase + "_f64")) {
      s = emit_ccall_shim1_arm64(s, cbase + "_f64", ca);
    }
    ca = ca + 1;
  }
  return s;
}

pub function emit_rodata_pools_arm64(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  s = asmcore.emit_debug_rows(s);
  if (s.string_lits.len() > 0) {
    s = s.write("    .section .rodata\n");
    let li: i32 = 0;
    while (li < s.string_lits.len()) {
      s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
      li = li + 1;
    }
  }
  let reloc: boolean = reloc_wanted(s, darwin);
  if (reloc) {
    s = s.write("    .section .data\n    .align 8\n");
    s = s.write(".Lfern_relanchor:\n    .quad .Lfern_relanchor\n");
  }
  if (reloc) {
    s = s.write("    .align 8\n.Lfern_sbox_begin:\n");
  }
  if (s.string_lits.len() > 0) {
    s = asmcore.emit_str_box_data_from(s, 0);
  }
  if (reloc) {
    s = s.write("    .section .data\n.Lfern_sbox_end:\n");
  }
  if (reloc) {
    s = asmcore.emit_const_agg_blocks(s, 0, 1);
    s = s.write("    .align 8\n.Lfern_cagg_begin:\n");
    s = asmcore.emit_const_agg_blocks(s, 0, 2);
    s = s.write("    .section .data\n.Lfern_cagg_end:\n");
    s = s.write("    .align 8\n.Lfern_cfn_begin:\n");
    s = asmcore.emit_const_agg_blocks(s, 0, 3);
    s = s.write("    .section .data\n.Lfern_cfn_end:\n");
    s = s.write("    .align 8\n.Lfern_cref_begin:\n");
    s = asmcore.emit_const_agg_refs(s);
    s = s.write(".Lfern_cref_end:\n");
  } else {
    s = asmcore.emit_const_agg_data(s);
  }
  s = asmcore.emit_shape_lits_from(s, 0);
  s = s.write("    .text\n");
  return s;
}

function emit_rt_clock_and_print(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  if (!darwin && asmcore.vdso_wanted(s, "arm64-linux")) {
    s = s.need("ccall:__c_call2").need("vdso");
  }
  s = emit_ccall_shims_arm64(s);
  let ctgt: string = rt_key(darwin);
  if (s.any_need([
    "monotonic_ns", "now_unix_ms", "now_ns", "stat", "lstat", "dir_stat",
    "read_file", "read_file_bytes", "read_file_bytes_u8", "random_i32", "sleep_ms",
    "sleep_ns", "set_file_times", "statfs", "poll", "proc_waitpid",
    "proc_waitpid_nohang", "proc_waitpid_status", "disable_core_dumps",
    "timer_fd", "tcp_listen", "tcp_local_port", "putchar",
    "udp_sendto_bytes", "udp_sendto_bytes_u8",
    "eprint", "tcp_listen_with", "tcp_socket_ctl", "udp_bind", "udp_bind_with", "udp_connect", "udp_sendto", "udp_recvfrom", "tcp_connect_with", "unix_listen", "unix_connect", "reactor_new", "reactor_ctl", "reactor_wait", "ring_new", "ring_ctl", "ring_wait", "ring_recv_u8", "ring_send_zc_u8", "tcp_recv_into", "tcp_ktls_u8", "tcp_sendfile",
    "tcp_listen_with_u8", "udp_bind_u8", "udp_bind_with_u8", "udp_connect_u8", "udp_sendto_u8", "udp_recvfrom_u8", "tcp_connect_with_u8",
    "isatty", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc", "pipe",
    "rlimit_nofile", "signal_ignore", "signal_default", "signal_catch", "signal_mask",
    "signal_disposition", "access",
    "geteuid", "getegid", "getuid", "getgid", "getgroups", "environ",
    "fd_stat", "raw_scratch", "fd_fsync", "fd_fdatasync", "fd_syncfs", "fd_drop_cache", "sync",
    "clock_resolution", "clock_set", "ct_mark",
  ])) {
    let minimum: i32 = 256;
    if (darwin && s.any_need(["hostname", "uname_field"])) {
      minimum = 400;
    }
    s = s.write("    .section .bss\n    .align 8\n__fern_scratch: .skip " + asmcore.scratch_size(ctgt, s.has_need("statfs"), minimum) + "\n    .section .text\n");
  }
  if (!darwin && s.any_need(["reader_splice", "raw_splice_pipe"])) {
    s = s.write("    .section .bss\n    .p2align 3\n__fern_splice_pipe: .quad 0, 0\n    .text\n");
  }
  if (s.has_need("raw_cover")) {
    s = s.write("    .section .bss\n    .p2align 3\n__fern_cov_counters: .quad 0\n    .text\n");
  }
  if (s.has_need("task")) {
    s = s.write("    .section .bss\n    .p2align 3\n__fern_task_state: .quad 0, 0, 0, 0\n    .text\n");
  }
  if (s.has_need("str_print")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_print_str(ctgt), s);
  }
  if (s.has_need("putchar")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_putchar(ctgt), s);
  }
  if (s.has_need("eprint")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_eprint_str(ctgt), s);
  }
  return emit_rt_clocks(s, darwin, ctgt);
}

function emit_rt_clocks(s: asmcore.EmitState, darwin: boolean, ctgt: string): asmcore.EmitState {
  if (s.has_need("now_unix_ms")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_clock("now_unix_ms", ctgt), s);
  }
  if (s.has_need("now_ns")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_clock("now_ns", ctgt), s);
  }
  if (s.has_need("monotonic_ns")) {
    if (darwin) {
      s = s.write("__fn___fern_monotonic_ns:\n");
      s = s.write("    stp x29, x30, [sp, #-16]!\n");
      s = s.write("    mov x29, sp\n");
      s = s.write("    mrs x9, cntvct_el0\n");
      s = s.write("    mrs x10, cntfrq_el0\n");
      s = s.write("    udiv x11, x9, x10\n");
      s = s.write("    msub x12, x11, x10, x9\n");
      s = s.write("    ldr x13, =1000000000\n");
      s = s.write("    mul x11, x11, x13\n");
      s = s.write("    mul x12, x12, x13\n");
      s = s.write("    udiv x12, x12, x10\n");
      s = s.write("    add x0, x11, x12\n");
      s = s.write("    ldp x29, x30, [sp], #16\n");
      s = s.write("    ret\n");
    } else {
      s = emit_ir_runtime_fern_fn(asmcore.rt_src_clock("monotonic_ns", ctgt), s);
    }
  }
  if (!darwin && s.has_need("vdso")) {
    s = s.write("    .section .bss\n    .p2align 3\n__fern_vdso: .quad 0, 0\n    .text\n");
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_vdso(ctgt), s);
  }
  return s;
}

function emit_rt_io_and_string(s: asmcore.EmitState): asmcore.EmitState {
  if (s.has_need("str_concat")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_concat(), s);
  }
  if (s.has_need("str_eq")) {
    s = s.write(rt_arm64_str_eq());
  }
  if (s.has_need("str_cmp")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_cmp(), s);
  }
  if (s.has_need("i32_to_string")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_i32_to_string(), s);
  }
  if (s.has_need("u32_to_string")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_u32_to_string(), s);
  }
  if (s.has_need("i64_to_string")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_i64_to_string(), s);
  }
  if (s.has_need("u64_to_string")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_u64_to_string(), s);
  }
  if (s.has_need("str_case")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_upper(), s);
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_lower(), s);
  }
  if (s.has_need("str_repeat")) {
    s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_repeat(), s);
  }
  return s;
}

function emit_lc_report(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  s = s.write("    .bss\n");
  s = s.write("    .align 3\n");
  s = s.write("__fern_lc_alloc_count: .quad 0\n");
  s = s.write("__fern_lc_alloc_bytes: .quad 0\n");
  s = s.write("__fern_lc_rt_req: .quad 0\n");
  s = s.write("__fern_lc_free_count: .quad 0\n");
  s = s.write("__fern_lc_free_bytes: .quad 0\n");
  s = s.write("__fern_lc_exited: .quad 0\n");
  s = s.write("    .section .rodata\n");
  s = s.write(".Llc_a:\n    .ascii \"leakcheck: allocs=\"\n");
  s = s.write(".Llc_f:\n    .ascii \" frees=\"\n");
  s = s.write(".Llc_l:\n    .ascii \" live_bytes=\"\n");
  s = s.write(".Llc_x:\n    .ascii \" from=exit\"\n");
  s = s.write(".Llc_nl:\n    .ascii \"\\n\"\n");
  if (s.sanitize) {
    s = s.write(".Lsan_leak:\n    .ascii \"fern-sanitizer: leak \"\n");
    s = s.write(".Lsan_bytesin:\n    .ascii \" bytes in \"\n");
    s = s.write(".Lsan_blocks:\n    .ascii \" blocks\"\n");
  }
  s = s.write("    .text\n");
  s = s.write("    .globl __fern_lc_report_exit\n");
  s = s.write("__fern_lc_report_exit:\n");
  s = s.write("    adrp x9, __fern_lc_exited\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_exited\n");
  s = s.write("    mov x10, #1\n");
  s = s.write("    str x10, [x9]\n");
  s = s.write("    .globl __fern_lc_report\n");
  s = s.write("__fern_lc_report:\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n");
  s = s.write("    mov x29, sp\n");
  if (s.has_need("set_args")) {
    s = s.write("    adrp x9, __fern_args_set\n");
    s = s.write("    add x9, x9, :lo12:__fern_args_set\n");
    s = s.write("    ldr x0, [x9]\n");
    s = s.write("    cbz x0, .Llc_args_done\n");
    s = s.write("    str xzr, [x9]\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_str_arr_free\n");
    s = s.write("    add sp, sp, #16\n");
    s = s.write(".Llc_args_done:\n");
  }
  s = s.write("    adrp x1, .Llc_a\n");
  s = s.write("    add x1, x1, :lo12:.Llc_a\n");
  s = s.write("    mov x2, #18\n");
  s = s.write("    bl .Llc_write\n");
  s = s.write("    adrp x9, __fern_lc_alloc_count\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_count\n");
  s = s.write("    ldr x0, [x9]\n");
  s = s.write("    bl .Llc_wrnum\n");
  s = s.write("    adrp x1, .Llc_f\n");
  s = s.write("    add x1, x1, :lo12:.Llc_f\n");
  s = s.write("    mov x2, #7\n");
  s = s.write("    bl .Llc_write\n");
  s = s.write("    adrp x9, __fern_lc_free_count\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_free_count\n");
  s = s.write("    ldr x0, [x9]\n");
  s = s.write("    bl .Llc_wrnum\n");
  s = s.write("    adrp x1, .Llc_l\n");
  s = s.write("    add x1, x1, :lo12:.Llc_l\n");
  s = s.write("    mov x2, #12\n");
  s = s.write("    bl .Llc_write\n");
  s = s.write("    adrp x9, __fern_lc_alloc_bytes\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_bytes\n");
  s = s.write("    ldr x0, [x9]\n");
  s = s.write("    adrp x9, __fern_lc_free_bytes\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_free_bytes\n");
  s = s.write("    ldr x1, [x9]\n");
  s = s.write("    sub x0, x0, x1\n");
  s = s.write("    bl .Llc_wrnum\n");
  s = s.write("    adrp x9, __fern_lc_exited\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_exited\n");
  s = s.write("    ldr x0, [x9]\n");
  s = s.write("    cbz x0, .Llc_from_done\n");
  s = s.write("    adrp x1, .Llc_x\n");
  s = s.write("    add x1, x1, :lo12:.Llc_x\n");
  s = s.write("    mov x2, #10\n");
  s = s.write("    bl .Llc_write\n");
  s = s.write(".Llc_from_done:\n");
  s = s.write("    adrp x1, .Llc_nl\n");
  s = s.write("    add x1, x1, :lo12:.Llc_nl\n");
  s = s.write("    mov x2, #1\n");
  s = s.write("    bl .Llc_write\n");
  if (s.sanitize) {
    s = s.write("    adrp x9, __fern_lc_alloc_bytes\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_bytes\n");
    s = s.write("    ldr x10, [x9]\n");
    s = s.write("    adrp x9, __fern_lc_free_bytes\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_free_bytes\n");
    s = s.write("    ldr x9, [x9]\n");
    s = s.write("    subs x10, x10, x9\n");
    s = s.write("    b.le .Lsan_leak_done\n");
    s = s.write("    adrp x1, .Lsan_leak\n");
    s = s.write("    add x1, x1, :lo12:.Lsan_leak\n");
    s = s.write("    mov x2, #21\n");
    s = s.write("    bl .Llc_write\n");
    s = s.write("    mov x0, x10\n");
    s = s.write("    bl .Llc_wrnum\n");
    s = s.write("    adrp x1, .Lsan_bytesin\n");
    s = s.write("    add x1, x1, :lo12:.Lsan_bytesin\n");
    s = s.write("    mov x2, #10\n");
    s = s.write("    bl .Llc_write\n");
    s = s.write("    adrp x9, __fern_lc_alloc_count\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_count\n");
    s = s.write("    ldr x0, [x9]\n");
    s = s.write("    adrp x9, __fern_lc_free_count\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_free_count\n");
    s = s.write("    ldr x9, [x9]\n");
    s = s.write("    sub x0, x0, x9\n");
    s = s.write("    bl .Llc_wrnum\n");
    s = s.write("    adrp x1, .Lsan_blocks\n");
    s = s.write("    add x1, x1, :lo12:.Lsan_blocks\n");
    s = s.write("    mov x2, #7\n");
    s = s.write("    bl .Llc_write\n");
    s = s.write("    adrp x1, .Llc_nl\n");
    s = s.write("    add x1, x1, :lo12:.Llc_nl\n");
    s = s.write("    mov x2, #1\n");
    s = s.write("    bl .Llc_write\n");
    s = s.write(".Lsan_leak_done:\n");
  }
  s = s.write("    ldp x29, x30, [sp], #16\n");
  s = s.write("    ret\n");
  s = s.write(".Llc_write:\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.write("    svc #0\n");
  s = s.write("    ret\n");
  s = s.write(".Llc_wrnum:\n");
  s = s.write("    sub sp, sp, #48\n");
  s = s.write("    add x3, sp, #32\n");
  s = s.write("    mov x4, #10\n");
  s = s.write("    mov x5, #0\n");
  s = s.write("    cmp x0, #0\n");
  s = s.write("    b.ge .Llc_wrnum_loop\n");
  s = s.write("    neg x0, x0\n");
  s = s.write("    mov x5, #1\n");
  s = s.write(".Llc_wrnum_loop:\n");
  s = s.write("    udiv x6, x0, x4\n");
  s = s.write("    msub x7, x6, x4, x0\n");
  s = s.write("    add x7, x7, #48\n");
  s = s.write("    sub x3, x3, #1\n");
  s = s.write("    strb w7, [x3]\n");
  s = s.write("    mov x0, x6\n");
  s = s.write("    cbnz x0, .Llc_wrnum_loop\n");
  s = s.write("    cbz x5, .Llc_wrnum_emit\n");
  s = s.write("    mov x7, #45\n");
  s = s.write("    sub x3, x3, #1\n");
  s = s.write("    strb w7, [x3]\n");
  s = s.write(".Llc_wrnum_emit:\n");
  s = s.write("    add x2, sp, #32\n");
  s = s.write("    sub x2, x2, x3\n");
  s = s.write("    mov x1, x3\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.write("    svc #0\n");
  s = s.write("    add sp, sp, #48\n");
  s = s.write("    ret\n");
  return s;
}

function rc_poison(): i32 {
  return 2129525454;
}

function rc_poison_into(w: string): string {
  let v: i32 = rc_poison();
  return "    movz " + w + ", #" + util.i32_to_string(v & 65535) + "\n"
    + "    movk " + w + ", #" + util.i32_to_string(v >> 16 & 65535) + ", lsl #16\n";
}

function quarantine_rc(addr: string, w: string, on: boolean): string {
  if (on) {
    return rc_poison_into(w) + "    stur " + w + ", " + addr + "\n";
  }
  return "    stur wzr, " + addr + "\n";
}

function arr_copy_elems(l: string): string {
  return "    add x2, x19, #8\n    add x3, x0, #8\n    mov x4, x21\n"
    + l + "_copy4:\n    cmp x4, #4\n    b.lt " + l + "_copy1\n"
    + "    ldp x5, x6, [x2], #16\n    ldp x7, x8, [x2], #16\n    stp x5, x6, [x3], #16\n    stp x7, x8, [x3], #16\n"
    + "    sub x4, x4, #4\n    b " + l + "_copy4\n"
    + l + "_copy1:\n    cbz x4, " + l + "_copy_done\n"
    + l + "_copy1_loop:\n    ldr x5, [x2], #8\n    str x5, [x3], #8\n    subs x4, x4, #1\n    b.ne " + l + "_copy1_loop\n"
    + l + "_copy_done:\n";
}

function apo_grow(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    ldur w2, [x0, #-8]\n");
  s = s.write("    cmp w2, #1\n");
  s = s.write("    b.eq .Lapo_own\n");
  s = s.write("    b .Larr_push_slow\n");
  s = s.write(".Lapo_own:\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n");
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    mov x20, x1\n");
  s = s.write("    ldr x21, [x19]\n");
  s = s.write("    ldur x22, [x19, #-16]\n");
  s = s.write("    lsl x8, x22, #1\n");
  s = s.write("    cbnz x8, .Lapo_cap\n");
  s = s.write("    mov x8, #4\n");
  s = s.write(".Lapo_cap:\n");
  s = s.write("    add x9, x21, #1\n    cmp x8, x9\n    csel x8, x8, x9, hs\n");
  s = s.write("    add x1, x8, #3\n");
  s = s.write("    lsl x1, x1, #3\n");
  s = s.write("    cmp x1, #2048\n");
  s = s.write("    b.hi .Lapo_alloc\n");
  s = s.write("    adrp x3, __fern_freelist\n");
  s = s.write("    add x3, x3, :lo12:__fern_freelist\n");
  s = s.write("    add x1, x3, x1\n");
  s = s.write("    ldr x3, [x1]\n");
  s = s.write("    cbz x3, .Lapo_miss\n");
  s = s.write("    ldr x4, [x3]\n");
  s = s.write("    str x4, [x1]\n");
  s = s.write(".Lapo_box:\n");
  s = s.write("    str x8, [x3]\n");
  s = s.write("    mov w4, #1\n");
  s = s.write("    str w4, [x3, #8]\n");
  s = s.write("    add x0, x3, #16\n");
  s = s.write("    add x1, x21, #1\n");
  s = s.write("    str x1, [x0]\n");
  s = s.write(arr_copy_elems(".Lapo"));
  s = s.write("    add x1, x21, #1\n");
  s = s.write("    str x20, [x0, x1, lsl #3]\n");
  s = s.write("    add x1, x22, #3\n");
  s = s.write("    mov x9, #0x10000\n");
  s = s.write("    cmp x1, x9\n");
  s = s.write("    b.hs .Lapo_large\n");
  s = s.write(quarantine_rc("[x19, #-8]", "w10", false));
  s = s.write("    sub x2, x19, #16\n");
  s = freelist_push(s, "x2", "x1", "x3", "x9");
  s = s.write(".Lapo_ret:\n");
  s = s.write("    ldp x21, x22, [sp], #16\n");
  s = s.write("    ldp x19, x20, [sp], #16\n");
  s = s.write("    ldp x29, x30, [sp], #16\n");
  s = s.write("    ret\n");
  s = s.write(".Lapo_miss:\n");
  s = s.write("    add x1, x8, #3\n");
  s = s.write("    lsl x1, x1, #3\n");
  s = s.write(".Lapo_alloc:\n");
  s = s.write("    mov x0, x1\n");
  s = s.write("    bl __fern_alloc\n");
  s = s.write("    mov x3, x0\n");
  s = s.write("    b .Lapo_box\n");
  return s;
}

function apo_wrapped(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.rc_free_debug) {
    s = s.write("    ldr x2, [x0]\n");
    s = s.write("    cbnz x2, .Lapo_grow\n");
    s = s.write("    ldur x2, [x0, #-16]\n");
    s = s.write("    cbnz x2, .Lapo_grow\n");
    s = s.write("    ldur w2, [x0, #-8]\n");
    s = s.write("    tbz w2, #31, .Lapo_grow\n");
    s = s.write("    b .Larr_push_slow\n");
    s = s.write(".Lapo_grow:\n");
  }
  s = s.write("    stp x29, x30, [sp, #-16]!\n");
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  if (s.rc_free_debug) {
    s = s.write("    bl __fern_arr_push\n");
  } else {
    s = s.write("    bl .Larr_push_slow\n");
  }
  s = s.write("    cmp x0, x19\n");
  s = s.write("    beq .Lapo_ret\n");
  s = s.write("    mov x9, #0x10000\n");
  s = s.write("    cmp x19, x9\n");
  s = s.write("    blo .Lapo_ret\n");
  s = s.write("    ldur w1, [x19, #-8]\n");
  s = s.write(san_poison_check("w1", "w10", ".Lapo_live", s.rc_free_debug));
  s = s.write("    tbnz w1, #31, .Lapo_ret\n");
  s = s.write("    cmp w1, #1\n");
  s = s.write("    bne .Lapo_ret\n");
  s = s.write("    ldur x1, [x19, #-16]\n");
  s = s.write("    add x1, x1, #3\n");
  s = s.write("    mov x9, #0x10000\n");
  s = s.write("    cmp x1, x9\n");
  s = s.write("    bhs .Lapo_large\n");
  s = s.write(quarantine_rc("[x19, #-8]", "w10", s.rc_free_debug));
  s = s.write("    sub x2, x19, #16\n");
  s = lc_bump_free_words(s, "x1", "x3", "x9");
  if (!s.rc_free_debug) {
    s = freelist_push(s, "x2", "x1", "x3", "x9");
  }
  s = s.write(".Lapo_ret:\n");
  s = s.write("    ldp x19, x20, [sp], #16\n");
  s = s.write("    ldp x29, x30, [sp], #16\n");
  s = s.write("    ret\n");
  return s;
}

function arr_push_fast(slow: string, on: boolean): string {
  if (on) {
    return "";
  }
  let ok: string = slow + "_ok";
  return "    ldr x2, [x0]\n    ldur x3, [x0, #-16]\n    cmp x2, x3\n    b.ge " + slow + "\n"
    + "    ldur w3, [x0, #-8]\n    cmp w3, #1\n    b.eq " + ok + "\n"
    + "    tbz w3, #31, " + slow + "\n"
    + ok + ":\n    add x2, x2, #1\n    str x1, [x0, x2, lsl #3]\n    str x2, [x0]\n    ret\n";
}

function arr_push_fast_u8(slow: string, on: boolean): string {
  if (on) {
    return "";
  }
  let ok: string = slow + "_ok";
  return "    ldr x2, [x0]\n    ldur x3, [x0, #-16]\n    lsl x3, x3, #3\n    cmp x2, x3\n    b.ge " + slow + "\n"
    + "    ldur w3, [x0, #-8]\n    cmp w3, #1\n    b.eq " + ok + "\n"
    + "    tbz w3, #31, " + slow + "\n"
    + ok + ":\n    add x3, x0, x2\n    strb w1, [x3, #8]\n    add x2, x2, #1\n    str x2, [x0]\n    ret\n";
}

function emit_alloc_bytes(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(empty_array_block(".Lfern_empty_bytes"));
  s = s.write("__fern_alloc_bytes:\n");
  s = s.write("    tbz w0, #31, .Lfern_alloc_bytes_sized\n    b __fern_alloc_size_abort_leaf\n.Lfern_alloc_bytes_sized:\n");
  s = s.write("    cbz w0, .Lfern_alloc_bytes_empty\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    sxtw x19, w0\n    add x0, x19, #7\n    lsr x0, x0, #3\n    mov x20, x0\n");
  s = s.write("    bl __fern_arr_box\n");
  s = s.write("    str x19, [x0]\n    add x2, x0, #8\n");
  s = s.write(".Lfern_alloc_bytes_zero:\n    cbz x20, .Lfern_alloc_bytes_done\n    str xzr, [x2], #8\n    sub x20, x20, #1\n    b .Lfern_alloc_bytes_zero\n");
  s = s.write(".Lfern_alloc_bytes_done:\n");
  s = s.write("    ldp x19, x20, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n");
  s = s.write(".Lfern_alloc_bytes_empty:\n    adrp x0, .Lfern_empty_bytes\n    add x0, x0, :lo12:.Lfern_empty_bytes\n    ret\n");
  return s;
}

function empty_array_block(label: string): string {
  return "    .data\n    .balign 8\n    .quad 0\n    .quad -1\n" + label + ":\n    .quad 0\n    .text\n";
}

function emit_arr_push_u8(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_arr_push_u8:\n");
  s = s.write(arr_push_fast_u8(".Larr_push_u8_slow", s.rc_free_debug));
  s = s.write(".Larr_push_u8_slow:\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n    stp x19, x20, [sp, #-16]!\n    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n    mov x20, x1\n    ldr x21, [x19]\n    ldur x22, [x19, #-16]\n");
  if (!s.rc_free_debug) {
    s = s.write("    b .Larr_push_u8_grow\n");
  }
  s = s.write("    ldur w2, [x19, #-8]\n");
  s = s.write(san_poison_check("w2", "w10", ".Larr_push_u8_sanlive", s.rc_free_debug));
  s = s.write("    cmp w2, #1\n    b.eq .Larr_push_u8_rc_ok\n    tbnz w2, #31, .Larr_push_u8_rc_ok\n    b .Larr_push_u8_grow\n");
  s = s.write(".Larr_push_u8_rc_ok:\n");
  s = s.write("    lsl x2, x22, #3\n    cmp x21, x2\n    b.ge .Larr_push_u8_grow\n");
  s = s.write("    add x2, x19, x21\n    strb w20, [x2, #8]\n    add x21, x21, #1\n    str x21, [x19]\n    mov x0, x19\n    b .Larr_push_u8_ret\n");
  s = s.write(".Larr_push_u8_grow:\n");
  s = s.write("    mov x2, x22\n    lsl x3, x22, #3\n    cmp x21, x3\n    b.lt .Larr_push_u8_cliff\n");
  s = s.write("    cbnz x22, .Larr_push_u8_dbl\n    mov x2, #4\n    b .Larr_push_u8_cap\n");
  s = s.write(".Larr_push_u8_cliff:\n");
  s = s.write("    adrp x3, __fern_arr_push_shared\n    add x3, x3, :lo12:__fern_arr_push_shared\n    ldr x4, [x3]\n    add x4, x4, #1\n    str x4, [x3]\n");
  s = s.write("    adrp x3, __fern_arr_push_copied\n    add x3, x3, :lo12:__fern_arr_push_copied\n    ldr x4, [x3]\n    add x4, x4, x21\n    str x4, [x3]\n");
  s = s.write("    b .Larr_push_u8_cap\n");
  s = s.write(".Larr_push_u8_dbl:\n    lsl x2, x22, #1\n");
  s = s.write(".Larr_push_u8_cap:\n    add x3, x21, #8\n    lsr x3, x3, #3\n    cmp x2, x3\n    csel x2, x2, x3, hs\n    mov x0, x2\n    bl __fern_arr_box\n");
  s = s.write("    add x1, x21, #1\n    str x1, [x0]\n");
  s = s.write("    add x2, x19, #8\n    add x3, x0, #8\n    add x4, x21, #7\n    lsr x4, x4, #3\n");
  s = s.write(".Larr_push_u8_copy:\n    cbz x4, .Larr_push_u8_copied\n    ldr x5, [x2], #8\n    str x5, [x3], #8\n    sub x4, x4, #1\n    b .Larr_push_u8_copy\n");
  s = s.write(".Larr_push_u8_copied:\n    add x2, x0, x21\n    strb w20, [x2, #8]\n");
  s = s.write(".Larr_push_u8_ret:\n    ldp x21, x22, [sp], #16\n    ldp x19, x20, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n");
  s = s.write("__fern_arr_push_owned_u8:\n");
  s = s.write(arr_push_fast_u8(".Lapou_slow", s.rc_free_debug));
  s = s.write(".Lapou_slow:\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n    stp x19, x20, [sp, #-16]!\n    mov x19, x0\n");
  if (s.rc_free_debug) {
    s = s.write("    bl __fern_arr_push_u8\n");
  } else {
    s = s.write("    bl .Larr_push_u8_slow\n");
  }
  s = s.write("    cmp x0, x19\n    beq .Lapou_ret\n    mov x9, #0x10000\n    cmp x19, x9\n    blo .Lapou_ret\n");
  s = s.write("    ldur w1, [x19, #-8]\n");
  s = s.write(san_poison_check("w1", "w10", ".Lapou_live", s.rc_free_debug));
  s = s.write("    tbnz w1, #31, .Lapou_ret\n    cmp w1, #1\n    bne .Lapou_ret\n");
  s = s.write("    ldur x1, [x19, #-16]\n    add x1, x1, #3\n    mov x9, #0x10000\n    cmp x1, x9\n    bhs .Lapou_large\n");
  s = s.write(quarantine_rc("[x19, #-8]", "w10", s.rc_free_debug));
  s = s.write("    sub x2, x19, #16\n");
  s = lc_bump_free_words(s, "x1", "x3", "x9");
  if (!s.rc_free_debug) {
    s = freelist_push(s, "x2", "x1", "x3", "x9");
  }
  s = s.write(".Lapou_ret:\n    ldp x19, x20, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n");
  s = s.write(".Lapou_large:\n");
  s = s.write(quarantine_rc("[x19, #-8]", "w10", s.rc_free_debug));
  s = s.write("    lsl x2, x1, #3\n    sub x1, x19, #16\n    bl __fern_large_push\n    b .Lapou_ret\n");
  return s;
}

function san_poison_check(rc: string, w: string, live: string, debug: boolean): string {
  if (!debug) {
    return "";
  }
  return rc_poison_into(w)
    + "    cmp " + rc + ", " + w + "\n"
    + "    b.ne " + live + "\n"
    + "    bl __fern_san_abort_uaf\n"
    + live + ":\n";
}

function san_underflow_abort(s: asmcore.EmitState): string {
  if (s.sanitize) {
    return "    bl __fern_san_abort\n";
  }
  return "";
}

function emit_san_abort(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.sanitize) {
    return s;
  }
  s = s.write("    .section .rodata\n");
  s = s.write(".Lsan_df:\n    .ascii \"fern-sanitizer: rc over-release (double free)\\n\"\n");
  s = s.write("    .text\n");
  s = s.write("    .globl __fern_san_abort\n");
  s = s.write("__fern_san_abort:\n");
  s = s.write("    adrp x1, .Lsan_df\n");
  s = s.write("    add x1, x1, :lo12:.Lsan_df\n");
  s = s.write("    mov x2, #46\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.write("    svc #0\n");
  s = s.write(san_report_exit(s));
  return s;
}

function san_report_exit(s: asmcore.EmitState): string {
  if (s.backtrace) {
    return "    mov x19, #124\n    b __fern_bt_exit\n";
  }
  return profile_exit_asm(s.profile) + "    mov x0, #124\n    mov x8, #94\n    svc #0\n";
}

function bt_strip_signature(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  return s.write("    mov x30, x1\n    xpaclri\n    mov x1, x30\n");
}

function emit_bt_exit(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .rodata\n");
  s = s.write(".Lmsg_bt:\n    .ascii \"backtrace:\\n\"\n");
  s = s.write("    .text\n");
  s = s.write("    .globl __fern_bt_exit\n");
  s = s.write("__fern_bt_exit:\n");
  s = s.write("    adrp x1, .Lmsg_bt\n");
  s = s.write("    add x1, x1, :lo12:.Lmsg_bt\n");
  s = s.write("    mov x2, #11\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.write("    svc #0\n");
  s = s.write("    mov x20, x29\n");
  s = s.write("    mov x21, #64\n");
  s = s.write("    mov x22, sp\n");
  s = s.write(".Lbt_loop:\n");
  s = s.write("    cbz x21, .Lbt_done\n");
  s = s.write("    cmp x20, x22\n");
  s = s.write("    b.lo .Lbt_done\n");
  s = s.write("    and x23, x20, #7\n");
  s = s.write("    cbnz x23, .Lbt_done\n");
  s = s.write("    ldr x1, [x20, #8]\n");
  s = bt_strip_signature(s);
  s = s.write("    cmp x1, #16, lsl #12\n");
  s = s.write("    b.lo .Lbt_done\n");
  s = s.write("    bl .Lbt_hex\n");
  s = s.write("    mov x22, x20\n");
  s = s.write("    ldr x20, [x20]\n");
  s = s.write("    sub x21, x21, #1\n");
  s = s.write("    b .Lbt_loop\n");
  s = s.write(".Lbt_done:\n");
  s = s.write("    mov x0, x19\n");
  s = s.write(profile_exit_asm(s.profile));
  s = s.write("    mov x8, #94\n");
  s = s.write("    svc #0\n");
  s = s.write(".Lbt_hex:\n");
  s = s.write("    sub sp, sp, #32\n");
  s = s.write("    mov w2, #32\n");
  s = s.write("    strb w2, [sp]\n");
  s = s.write("    strb w2, [sp, #1]\n");
  s = s.write("    mov w2, #48\n");
  s = s.write("    strb w2, [sp, #2]\n");
  s = s.write("    mov w2, #120\n");
  s = s.write("    strb w2, [sp, #3]\n");
  s = s.write("    mov w2, #10\n");
  s = s.write("    strb w2, [sp, #20]\n");
  s = s.write("    mov x3, #16\n");
  s = s.write("    add x4, sp, #19\n");
  s = s.write(".Lbt_hloop:\n");
  s = s.write("    and x2, x1, #15\n");
  s = s.write("    cmp x2, #10\n");
  s = s.write("    b.lo .Lbt_hdec\n");
  s = s.write("    add x2, x2, #87\n");
  s = s.write("    b .Lbt_hput\n");
  s = s.write(".Lbt_hdec:\n");
  s = s.write("    add x2, x2, #48\n");
  s = s.write(".Lbt_hput:\n");
  s = s.write("    strb w2, [x4]\n");
  s = s.write("    sub x4, x4, #1\n");
  s = s.write("    lsr x1, x1, #4\n");
  s = s.write("    subs x3, x3, #1\n");
  s = s.write("    b.ne .Lbt_hloop\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x1, sp\n");
  s = s.write("    mov x2, #21\n");
  s = s.write("    mov x8, #64\n");
  s = s.write("    svc #0\n");
  s = s.write("    add sp, sp, #32\n");
  s = s.write("    ret\n");
  return s;
}

function emit_san_uaf_abort(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.rc_free_debug) {
    return s;
  }
  s = s.write("    .section .rodata\n");
  s = s.write(".Lsan_uaf:\n    .ascii \"fern-sanitizer: use-after-free (touched a quarantined block)\\n\"\n");
  s = s.write("    .text\n");
  s = s.write("    .globl __fern_san_abort_uaf\n");
  s = s.write("__fern_san_abort_uaf:\n");
  s = s.write("    adrp x1, .Lsan_uaf\n");
  s = s.write("    add x1, x1, :lo12:.Lsan_uaf\n");
  s = s.write("    mov x2, #61\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.write("    svc #0\n");
  return s.write(san_report_exit(s));
}

function high_heap_probe_on(): boolean {
  return envflag.on("FERN_HIGH_HEAP");
}

function alloc_count_bump(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.has_need("alloc_count")) {
    return s;
  }
  s = s.write("    adrp x1, __fern_alloc_count\n");
  s = s.write("    add x1, x1, :lo12:__fern_alloc_count\n");
  s = s.write("    ldr x2, [x1]\n");
  s = s.write("    add x2, x2, #1\n");
  s = s.write("    str x2, [x1]\n");
  return s;
}

function lc_bump_alloc(s: asmcore.EmitState): asmcore.EmitState {
  return lc_bump_alloc_add(s, "x0", "x1", "x2");
}

function lc_bump_alloc_add(s: asmcore.EmitState, addend: string, t1: string, t2: string): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  s = s.write("    adrp " + t1 + ", __fern_lc_alloc_count\n");
  s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_alloc_count\n");
  s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
  s = s.write("    add " + t2 + ", " + t2 + ", #1\n");
  s = s.write("    str " + t2 + ", [" + t1 + "]\n");
  s = s.write("    adrp " + t1 + ", __fern_lc_alloc_bytes\n");
  s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_alloc_bytes\n");
  s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
  s = s.write("    add " + t2 + ", " + t2 + ", " + addend + "\n");
  s = s.write("    str " + t2 + ", [" + t1 + "]\n");
  return s;
}

struct RegTriple { a: string, b: string, c: string }

function lc_grow_bytes(s: asmcore.EmitState, old: string, grown: string, t: RegTriple): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  s = s.write("    sub " + t.a + ", " + grown + ", " + old + "\n");
  s = s.write("    adrp " + t.b + ", __fern_lc_alloc_bytes\n");
  s = s.write("    add " + t.b + ", " + t.b + ", :lo12:__fern_lc_alloc_bytes\n");
  s = s.write("    ldr " + t.c + ", [" + t.b + "]\n");
  s = s.write("    add " + t.c + ", " + t.c + ", " + t.a + ", lsl #3\n");
  s = s.write("    str " + t.c + ", [" + t.b + "]\n");
  return s;
}

function lc_bump_free_add(s: asmcore.EmitState, addend: string, t1: string, t2: string): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  s = s.write("    adrp " + t1 + ", __fern_lc_free_count\n");
  s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_free_count\n");
  s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
  s = s.write("    add " + t2 + ", " + t2 + ", #1\n");
  s = s.write("    str " + t2 + ", [" + t1 + "]\n");
  s = s.write("    adrp " + t1 + ", __fern_lc_free_bytes\n");
  s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_free_bytes\n");
  s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
  s = s.write("    add " + t2 + ", " + t2 + ", " + addend + "\n");
  s = s.write("    str " + t2 + ", [" + t1 + "]\n");
  return s;
}

function lc_bump_free_words(s: asmcore.EmitState, words: string, t1: string, t2: string): asmcore.EmitState {
  return lc_bump_free_add(s, words + ", lsl #3", t1, t2);
}

function freelist_push(s: asmcore.EmitState, ptr: string, words: string, base: string, tmp: string): asmcore.EmitState {
  let l: asmcore.LabelOut = asmcore.fresh_label(s);
  s = l.state.write("    cmp " + words + ", #256\n");
  s = s.write("    b.ls " + l.name + "\n");
  s = s.write("    stp " + words + ", x30, [sp, #-16]!\n");
  s = s.write("    bl __fern_capw\n");
  s = s.write("    ldp " + words + ", x30, [sp], #16\n");
  s = s.write(l.name + ":\n");
  return freelist_push_classed(s, ptr, words, base, tmp);
}

function freelist_push_classed(s: asmcore.EmitState, ptr: string, words: string, base: string, tmp: string): asmcore.EmitState {
  s = s.write("    adrp " + base + ", __fern_freelist\n");
  s = s.write("    add " + base + ", " + base + ", :lo12:__fern_freelist\n");
  s = s.write("    ldr " + tmp + ", [" + base + ", " + words + ", lsl #3]\n");
  s = s.write("    str " + tmp + ", [" + ptr + "]\n");
  s = s.write("    str " + ptr + ", [" + base + ", " + words + ", lsl #3]\n");
  return s;
}

function buf_block_free(s: asmcore.EmitState, ptr: string, words: string, lbl: string): asmcore.EmitState {
  s = s.write("    mov x9, #0x10000\n");
  s = s.write("    cmp " + words + ", x9\n");
  s = s.write("    b.hs ." + lbl + "_large\n");
  s = lc_bump_free_words(s, words, "x3", "x10");
  if (!s.rc_free_debug) {
    s = freelist_push(s, ptr, words, "x3", "x10");
  }
  s = s.write("    b ." + lbl + "_done\n");
  s = s.write("." + lbl + "_large:\n");
  s = s.write("    mov x1, " + ptr + "\n");
  s = s.write("    lsl x2, " + words + ", #3\n");
  s = s.write("    bl __fern_large_push\n");
  s = s.write("." + lbl + "_done:\n");
  return s;
}

function emit_buf_push_bytes_range(s: asmcore.EmitState, packed: boolean): asmcore.EmitState {
  let suffix: string = asmcore.packed_suffix(packed);
  let sym: string = "__fern_buf_push_bytes_range" + suffix;
  let label: string = ".Lbufbyterange" + suffix;
  s = s.write(".globl " + sym + "\n.type " + sym + ", %function\n" + sym + ":\n");
  s = s.write("    stp x29, x30, [sp, #-48]!\n    mov x29, sp\n    stp x19, x20, [sp, #16]\n    stp x21, x22, [sp, #32]\n");
  s = s.write("    mov x19, x0\n    mov x20, x1\n    sxtw x21, w2\n    sxtw x22, w3\n    cmp x21, #0\n    csel x21, x21, xzr, ge\n    ldr x9, [x20]\n    cmp x22, x9\n    csel x22, x22, x9, le\n");
  s = s.write("    sub x22, x22, x21\n    cmp x22, #0\n    b.le " + label + "_done\n    ldr x1, [x19, #8]\n    add x1, x1, x22\n    ldr x9, [x19, #16]\n    cmp x1, x9\n    b.ls " + label + "_fits\n    bl __fern_buf_reserve\n" + label + "_fits:\n");
  s = s.write("    ldr x3, [x19]\n    ldr x9, [x19, #8]\n    add x3, x3, x9\n    add x9, x9, x22\n    str x9, [x19, #8]\n    add x1, x20, #8\n    mov x2, x22\n");
  if (packed) {
    s = s.write("    add x1, x1, x21\n");
    s = arm64_copy_bytes(s, CopyRegs { dst: "x3", src: "x1", n: "x2", tmp: "x9", src_end: "x10", dst_end: "x11" }, label + "_words", label + "_tail", label + "_bytes", label + "_done");
  } else {
    s = s.write("    add x1, x1, x21, lsl #3\n" + label + "_copy:\n    ldrb w9, [x1], #8\n    strb w9, [x3], #1\n    subs x2, x2, #1\n    b.ne " + label + "_copy\n" + label + "_done:\n");
  }
  s = s.write("    mov x0, #0\n    ldp x21, x22, [sp, #32]\n    ldp x19, x20, [sp, #16]\n    ldp x29, x30, [sp], #48\n    ret\n.size " + sym + ", .-" + sym + "\n");
  return s;
}

function emit_buf_take_bytes(s: asmcore.EmitState, packed: boolean): asmcore.EmitState {
  let suffix: string = asmcore.packed_suffix(packed);
  let sym: string = "__fern_buf_take_bytes" + suffix;
  let done: string = ".Lbufbytes_done" + suffix;
  let copy_loop: string = ".Lbufbytes_loop" + suffix;
  s = s.write(".globl " + sym + "\n.type " + sym + ", %function\n" + sym + ":\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n");
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    ldr x20, [x19, #8]\n");
  s = s.write("    mov x0, x20\n");
  if (packed) {
    s = s.write("    add x0, x0, #7\n    lsr x0, x0, #3\n");
  }
  s = s.write("    bl __fern_arr_box\n    mov x21, x0\n    str x20, [x21]\n    ldr x1, [x19]\n");
  if (packed) {
    s = s.write("    add x3, x21, #8\n    mov x2, x20\n");
    s = arm64_copy_bytes(s, CopyRegs { dst: "x3", src: "x1", n: "x2", tmp: "x9", src_end: "x10", dst_end: "x11" }, copy_loop + "_w", copy_loop + "_t", copy_loop + "_b", done);
  } else {
    s = s.write("    mov x2, #0\n    add x3, x21, #8\n" + copy_loop + ":\n    cmp x2, x20\n    b.hs " + done + "\n");
    s = s.write("    ldrb w9, [x1, x2]\n    str x9, [x3, x2, lsl #3]\n    add x2, x2, #1\n    b " + copy_loop + "\n" + done + ":\n");
  }
  s = s.write("    str xzr, [x19, #8]\n    mov x0, x21\n    ldp x21, x22, [sp], #16\n    ldp x19, x20, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n.size " + sym + ", .-" + sym + "\n");
  return s;
}

function emit_buf_mapped_neon(s: asmcore.EmitState, lm: string): asmcore.EmitState {
  s = s.write("    cmp x2, #16\n");
  s = s.write("    b.lo " + lm + "_full\n");
  s = s.write("    add x6, x21, #8\n");
  let r: i32 = 0;
  while (r < 8) {
    s = s.write("    ldp q" + util.i32_to_string(16 + 2 * r) + ", q" + util.i32_to_string(17 + 2 * r) + ", [x6, #" + util.i32_to_string(32 * r) + "]\n");
    r = r + 1;
  }
  s = s.write("    movi v7.16b, #64\n");
  s = s.write(lm + "_vec:\n");
  s = s.write("    ldr q0, [x1], #16\n");
  s = s.write("    tbl v1.16b, {v16.16b-v19.16b}, v0.16b\n");
  s = s.write("    sub v0.16b, v0.16b, v7.16b\n");
  s = s.write("    tbx v1.16b, {v20.16b-v23.16b}, v0.16b\n");
  s = s.write("    sub v0.16b, v0.16b, v7.16b\n");
  s = s.write("    tbx v1.16b, {v24.16b-v27.16b}, v0.16b\n");
  s = s.write("    sub v0.16b, v0.16b, v7.16b\n");
  s = s.write("    tbx v1.16b, {v28.16b-v31.16b}, v0.16b\n");
  s = s.write("    str q1, [x3], #16\n");
  s = s.write("    sub x2, x2, #16\n");
  s = s.write("    cmp x2, #16\n");
  s = s.write("    b.hs " + lm + "_vec\n");
  return s.write("    cbz x2, " + lm + "_len\n");
}

function emit_buf_table_helpers(s: asmcore.EmitState, packed: boolean, raw: boolean): asmcore.EmitState {
  let sfx: string = asmcore.packed_suffix(packed);
  let prefix: string = "__fern_buf_push_";
  let label: string = "";
  if (raw) {
    prefix = prefix + "bytes_";
    label = "_bytes";
  }
  let source_len: string = "    ldr x22, [x20, #8]\n";
  let source_data: string = "    ldr x1, [x20]\n";
  if (raw) {
    source_len = "    ldr x22, [x20]\n";
    source_data = "    add x1, x20, #8\n";
  }
  let lm: string = ".Lbufmap" + label + sfx;
  let lf: string = ".Lbuffilt" + label + sfx;
  let le: string = ".Lbufexp" + label + sfx;
  let srcstep: string = "1";
  if (raw && !packed) {
    srcstep = "8";
  }
  let tsh: string = ", lsl #3";
  let pk: string = "ldr x8, [x6, x7, lsl #3]";
  let rsh: string = "6";
  let rlen: string = "ldr x7, [x6, #8]";
  let rstart: string = "16";
  let rbyte: string = "ldr x8, [x6], #8";
  if (packed) {
    tsh = "";
    pk = "ldrb w8, [x6, x7]";
    rsh = "3";
    rlen = "ldrb w7, [x6, #8]";
    rstart = "9";
    rbyte = "ldrb w8, [x6], #1";
  }
  s = s.write(".globl " + prefix + "mapped" + sfx + "\n");
  s = s.write(".type " + prefix + "mapped" + sfx + ", %function\n");
  s = s.write(prefix + "mapped" + sfx + ":\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n");
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    mov x20, x1\n");
  s = s.write("    mov x21, x2\n");
  s = s.write(source_len);
  s = s.write("    cbz x22, " + lm + "_done\n");
  s = s.write("    ldr x0, [x19, #8]\n");
  s = s.write("    add x0, x0, x22\n");
  s = s.write("    ldr x1, [x19, #16]\n");
  s = s.write("    cmp x0, x1\n");
  s = s.write("    b.ls " + lm + "_fits\n");
  s = s.write("    mov x1, x0\n");
  s = s.write("    mov x0, x19\n");
  s = s.write("    bl __fern_buf_reserve\n");
  s = s.write(lm + "_fits:\n");
  s = s.write(source_data);
  s = s.write("    ldr x3, [x19]\n");
  s = s.write("    ldr x4, [x19, #8]\n");
  s = s.write("    add x3, x3, x4\n");
  s = s.write("    ldr x4, [x21]\n");
  s = s.write("    mov x2, x22\n");
  s = s.write("    cmp x4, #256\n");
  s = s.write("    b.lo " + lm + "_short\n");
  if (packed) {
    s = emit_buf_mapped_neon(s, lm);
  }
  s = s.write(lm + "_full:\n");
  s = s.write("    ldrb w5, [x1], #" + srcstep + "\n");
  s = s.write("    add x6, x21, x5" + tsh + "\n");
  s = s.write("    ldrb w5, [x6, #8]\n");
  s = s.write("    strb w5, [x3], #1\n");
  s = s.write("    sub x2, x2, #1\n");
  s = s.write("    cbnz x2, " + lm + "_full\n");
  s = s.write("    b " + lm + "_len\n");
  s = s.write(lm + "_short:\n");
  s = s.write("    ldrb w5, [x1], #" + srcstep + "\n");
  s = s.write("    cmp x5, x4\n");
  s = s.write("    b.hs " + lm + "_keep\n");
  s = s.write("    add x6, x21, x5" + tsh + "\n");
  s = s.write("    ldrb w5, [x6, #8]\n");
  s = s.write(lm + "_keep:\n");
  s = s.write("    strb w5, [x3], #1\n");
  s = s.write("    sub x2, x2, #1\n");
  s = s.write("    cbnz x2, " + lm + "_short\n");
  s = s.write(lm + "_len:\n");
  s = s.write("    ldr x0, [x19, #8]\n");
  s = s.write("    add x0, x0, x22\n");
  s = s.write("    str x0, [x19, #8]\n");
  s = s.write(lm + "_done:\n");
  s = s.write("    ldp x21, x22, [sp], #16\n");
  s = s.write("    ldp x19, x20, [sp], #16\n");
  s = s.write("    ldp x29, x30, [sp], #16\n");
  s = s.write("    ret\n");
  s = s.write(".size " + prefix + "mapped" + sfx + ", .-" + prefix + "mapped" + sfx + "\n");
  s = s.write(".globl " + prefix + "filtered" + sfx + "\n");
  s = s.write(".type " + prefix + "filtered" + sfx + ", %function\n");
  s = s.write(prefix + "filtered" + sfx + ":\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n");
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    mov x20, x1\n");
  s = s.write("    mov x21, x2\n");
  s = s.write(source_len);
  s = s.write("    cbz x22, " + lf + "_done\n");
  s = s.write("    ldr x0, [x19, #8]\n");
  s = s.write("    add x0, x0, x22\n");
  s = s.write("    ldr x1, [x19, #16]\n");
  s = s.write("    cmp x0, x1\n");
  s = s.write("    b.ls " + lf + "_fits\n");
  s = s.write("    mov x1, x0\n");
  s = s.write("    mov x0, x19\n");
  s = s.write("    bl __fern_buf_reserve\n");
  s = s.write(lf + "_fits:\n");
  s = s.write(source_data);
  s = s.write("    ldr x3, [x19]\n");
  s = s.write("    ldr x4, [x19, #8]\n");
  s = s.write("    add x3, x3, x4\n");
  s = s.write("    ldr x4, [x21]\n");
  s = s.write("    mov x2, x22\n");
  s = s.write("    mov x7, #0\n");
  s = s.write("    cmp x4, #256\n");
  s = s.write("    b.lo " + lf + "_loop\n");
  s = s.write(lf + "_full:\n");
  s = s.write("    ldrb w5, [x1], #1\n");
  s = s.write("    add x6, x21, x5" + tsh + "\n");
  s = s.write("    ldrb w6, [x6, #8]\n");
  s = s.write("    strb w5, [x3, x7]\n");
  s = s.write("    cmp w6, #0\n");
  s = s.write("    cinc x7, x7, eq\n");
  s = s.write("    sub x2, x2, #1\n");
  s = s.write("    cbnz x2, " + lf + "_full\n");
  s = s.write("    b " + lf + "_len\n");
  s = s.write(lf + "_loop:\n");
  s = s.write("    ldrb w5, [x1], #" + srcstep + "\n");
  s = s.write("    cmp x5, x4\n");
  s = s.write("    b.hs " + lf + "_keep\n");
  s = s.write("    add x6, x21, x5" + tsh + "\n");
  s = s.write("    ldrb w6, [x6, #8]\n");
  s = s.write("    cbnz w6, " + lf + "_next\n");
  s = s.write(lf + "_keep:\n");
  s = s.write("    strb w5, [x3], #1\n");
  s = s.write("    add x7, x7, #1\n");
  s = s.write(lf + "_next:\n");
  s = s.write("    sub x2, x2, #1\n");
  s = s.write("    cbnz x2, " + lf + "_loop\n");
  s = s.write(lf + "_len:\n");
  s = s.write("    ldr x0, [x19, #8]\n");
  s = s.write("    add x0, x0, x7\n");
  s = s.write("    str x0, [x19, #8]\n");
  s = s.write(lf + "_done:\n");
  s = s.write("    ldp x21, x22, [sp], #16\n");
  s = s.write("    ldp x19, x20, [sp], #16\n");
  s = s.write("    ldp x29, x30, [sp], #16\n");
  s = s.write("    ret\n");
  s = s.write(".size " + prefix + "filtered" + sfx + ", .-" + prefix + "filtered" + sfx + "\n");
  s = s.write(".globl " + prefix + "expanded" + sfx + "\n");
  s = s.write(".type " + prefix + "expanded" + sfx + ", %function\n");
  s = s.write(prefix + "expanded" + sfx + ":\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n");
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    mov x20, x1\n");
  s = s.write("    mov x21, x2\n");
  s = s.write(source_len);
  s = s.write("    cbz x22, " + le + "_done\n");
  s = s.write("    lsl x0, x22, #3\n");
  s = s.write("    add x0, x0, #8\n");
  s = s.write("    ldr x1, [x19, #8]\n");
  s = s.write("    add x0, x0, x1\n");
  s = s.write("    ldr x1, [x19, #16]\n");
  s = s.write("    cmp x0, x1\n");
  s = s.write("    b.ls " + le + "_fits\n");
  s = s.write("    mov x1, x0\n");
  s = s.write("    mov x0, x19\n");
  s = s.write("    bl __fern_buf_reserve\n");
  s = s.write(le + "_fits:\n");
  s = s.write(source_data);
  s = s.write("    ldr x3, [x19]\n");
  s = s.write("    ldr x4, [x19, #8]\n");
  s = s.write("    add x3, x3, x4\n");
  s = s.write("    ldr x4, [x21]\n");
  s = s.write("    lsr x4, x4, #3\n");
  s = s.write("    mov x2, x22\n");
  s = s.write("    cmp x4, #256\n    b.lo " + le + "_loop\n");
  s = s.write("    cmp x2, #256\n    b.lo " + le + "_loop\n");
  s = s.write("    sub sp, sp, #2048\n    add x6, x21, #8\n    mov x7, #0\n");
  s = s.write(le + "_pack:\n");
  s = s.write("    " + pk + "\n    strb w8, [sp, x7]\n");
  s = s.write("    add x7, x7, #1\n    cmp x7, #2048\n    b.lo " + le + "_pack\n");
  s = s.write("    mov x9, #7\n");
  s = s.write(le + "_fast:\n");
  s = s.write("    ldrb w5, [x1], #" + srcstep + "\n    ldr x8, [sp, x5, lsl #3]\n");
  s = s.write("    and x7, x8, #255\n    cmp x7, x9\n    csel x7, x7, x9, ls\n");
  s = s.write("    lsr x8, x8, #8\n    str x8, [x3]\n    add x3, x3, x7\n");
  s = s.write("    subs x2, x2, #1\n    b.ne " + le + "_fast\n");
  s = s.write("    add sp, sp, #2048\n    b " + le + "_len\n");
  s = s.write(le + "_loop:\n");
  s = s.write("    cbz x2, " + le + "_len\n");
  s = s.write("    ldrb w5, [x1], #" + srcstep + "\n");
  s = s.write("    cmp x5, x4\n");
  s = s.write("    b.hs " + le + "_keep\n");
  s = s.write("    add x6, x21, x5, lsl #" + rsh + "\n");
  s = s.write("    " + rlen + "\n");
  s = s.write("    cmp x7, #7\n");
  s = s.write("    b.ls " + le + "_room\n");
  s = s.write("    mov x7, #7\n");
  s = s.write(le + "_room:\n");
  s = s.write("    add x6, x6, #" + rstart + "\n");
  s = s.write(le + "_byte:\n");
  s = s.write("    cbz x7, " + le + "_next\n");
  s = s.write("    " + rbyte + "\n");
  s = s.write("    strb w8, [x3], #1\n");
  s = s.write("    sub x7, x7, #1\n");
  s = s.write("    b " + le + "_byte\n");
  s = s.write(le + "_keep:\n");
  s = s.write("    strb w5, [x3], #1\n");
  s = s.write(le + "_next:\n");
  s = s.write("    sub x2, x2, #1\n");
  s = s.write("    b " + le + "_loop\n");
  s = s.write(le + "_len:\n");
  s = s.write("    ldr x0, [x19]\n");
  s = s.write("    sub x3, x3, x0\n");
  s = s.write("    str x3, [x19, #8]\n");
  s = s.write(le + "_done:\n");
  s = s.write("    ldp x21, x22, [sp], #16\n");
  s = s.write("    ldp x19, x20, [sp], #16\n");
  s = s.write("    ldp x29, x30, [sp], #16\n");
  s = s.write("    ret\n");
  s = s.write(".size " + prefix + "expanded" + sfx + ", .-" + prefix + "expanded" + sfx + "\n");
  return s;
}

function mov_fused_marker(s: asmcore.EmitState, reg: string): asmcore.EmitState {
  s = s.write("    mov " + reg + ", #32781\n");
  return s.write("    movk " + reg + ", #29519, lsl #16\n");
}

function mov_borrowed_marker(s: asmcore.EmitState, reg: string): asmcore.EmitState {
  s = s.write("    mov " + reg + ", #0x5252\n");
  return s.write("    movk " + reg + ", #0x424F, lsl #16\n");
}

function mov_grown_marker(s: asmcore.EmitState, reg: string): asmcore.EmitState {
  s = s.write("    mov " + reg + ", #0x4F57\n");
  return s.write("    movk " + reg + ", #0x4752, lsl #16\n");
}

function abort_trap(s: asmcore.EmitState, label: string, msg: string, text: string, status: i32): asmcore.EmitState {
  s = s.write("    .section .rodata\n");
  s = s.write(msg + ":\n    .ascii \"" + text + "\\n\"\n");
  s = s.write("    .text\n");
  let sym: boolean = !util.str_has_prefix(label, ".L");
  if (sym) {
    s = s.write(".globl " + label + "\n");
    s = s.write(".type " + label + ", %function\n");
  }
  s = s.write(label + ":\n");
  s = s.write("    adrp x1, " + msg + "\n");
  s = s.write("    add x1, x1, :lo12:" + msg + "\n");
  s = s.write("    mov x2, #" + util.i32_to_string(text.len() + 1) + "\n");
  s = s.write("    mov x0, #" + util.i32_to_string(status) + "\n");
  s = s.write("    b __fern_report\n");
  if (sym) {
    s = s.write(".size " + label + ", .-" + label + "\n");
  }
  return s;
}

function emit_rt_report(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .text\n");
  s = s.write(".globl __fern_report\n");
  s = s.write(".type __fern_report, %function\n");
  s = s.write("__fern_report:\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.write("    svc #0\n");
  if (s.backtrace) {
    s = s.write("    b __fern_bt_exit\n");
    s = s.write(".size __fern_report, .-__fern_report\n");
    return emit_bt_exit(s);
  }
  s = s.write("    mov x0, x19\n");
