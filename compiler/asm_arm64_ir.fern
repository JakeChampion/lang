    s = s.need("heap");
    s = s.need("rename");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_rename\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_RENAME_NOREPLACE || o.kind_tag == ir.K_RENAME_EXCHANGE || o.kind_tag == ir.K_GETXATTR || o.kind_tag == ir.K_LGETXATTR || o.kind_tag == ir.K_GETXATTR_BYTES || o.kind_tag == ir.K_LGETXATTR_BYTES) {
    let op = ir.kind_name(o.kind_tag);
    if (o.kind_tag >= ir.K_GETXATTR_BYTES && ir.is_packed(o)) {
      op += "_u8";
    }
    s = s.need("heap");
    s = s.need(op);
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_" + op + "\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_SETXATTR || o.kind_tag == ir.K_LSETXATTR || o.kind_tag == ir.K_SETXATTR_BYTES || o.kind_tag == ir.K_LSETXATTR_BYTES) {
    let op = ir.kind_name(o.kind_tag);
    if (o.kind_tag >= ir.K_GETXATTR_BYTES && ir.is_packed(o)) {
      op += "_u8";
    }
    s = s.need("heap");
    s = s.need(op);
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_" + op + "\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_CREATE_SYMLINK) {
    s = s.need("heap");
    s = s.need("create_symlink");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_create_symlink\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_READ_LINK) {
    s = s.need("heap");
    s = s.need("read_link");
    let helper = "read_link";
    if (o.i32_imm != 0) {
      helper = "read_link_bytes";
      s = s.need("read_link_bytes");
    }
    s = s.write("    bl __fn___fern_" + helper + "\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_CHMOD) {
    s = s.need("heap");
    s = s.need("chmod");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_chmod\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_MKNOD) {
    s = s.need("heap");
    s = s.need("mknod");
    s = s.write("    ldr x3, [sp], #16\n    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x3, [sp, #-16]!\n    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_mknod\n    add sp, sp, #64\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_CHOWN_AT) {
    s = s.need("heap");
    s = s.need("chown_at");
    s = s.write("    ldr x3, [sp], #16\n    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x3, [sp, #-16]!\n    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_chown_at\n    add sp, sp, #64\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_CHMOD_AT) {
    s = s.need("heap");
    s = s.need("chmod_at");
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_chmod_at\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_TRUNCATE) {
    s = s.need("heap");
    s = s.need("truncate");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_truncate\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_SET_FILE_TIMES || o.kind_tag == ir.K_WRITER_SET_TIMES) {
    let helper: string = if (o.kind_tag == ir.K_WRITER_SET_TIMES) { "writer_set_times" } else { "set_file_times" };
    s = s.need("heap");
    s = s.need(helper);
    s = s.write("    ldr x5, [sp], #16\n    ldr x4, [sp], #16\n    ldr x3, [sp], #16\n    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x5, [sp, #-16]!\n    str x4, [sp, #-16]!\n    str x3, [sp, #-16]!\n    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_" + helper + "\n    add sp, sp, #96\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_UMASK) {
    s = s.need("umask");
    s = s.write("    bl __fn___fern_umask\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_STATFS) {
    s = s.need("heap");
    s = s.need("statfs");
    s = s.write("    bl __fn___fern_statfs\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_MOUNTS) {
    s = s.need("heap");
    s = s.need("mounts");
    s = s.write("    bl __fn___fern_mounts\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_SYSCTL) {
    s = s.need("heap");
    s = s.need("sysctl");
    s = s.write("    bl __fn___fern_sysctl\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_FD_FSYNC) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("fd_fsync");
    s = s.write("    bl __fn___fern_fd_fsync\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_FD_FDATASYNC) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("fd_fdatasync");
    s = s.write("    bl __fn___fern_fd_fdatasync\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_FD_SYNCFS) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("fd_syncfs");
    s = s.write("    bl __fn___fern_fd_syncfs\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_FD_DROP_CACHE) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("fd_drop_cache");
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_fd_drop_cache\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_SYNC) {
    s = s.need("sync");
    s = s.write("    bl __fn___fern_sync\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_FD_STAT) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("fd_stat");
    s = s.write("    bl __fn___fern_fd_stat\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_FD_DUP_ONTO) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("fd_dup_onto");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_fd_dup_onto\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_FD_FLAGS) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("fd_flags");
    s = s.write("    bl __fn___fern_fd_flags\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_READER_SEEK) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("reader_seek");
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_reader_seek\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_READER_SPLICE) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("reader_splice");
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_reader_splice\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_READER_COPY_RANGE) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("reader_copy_range");
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_reader_copy_range\n    add sp, sp, #48\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_WRITER_TRUNCATE) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("writer_truncate");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_writer_truncate\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_WRITER_NONBLOCKING) {
    s = s.need("heap");
    s = s.need("reader");
    s = s.need("writer_nonblocking");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_writer_nonblocking\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_SLEEP_MS) {
    s = s.need("sleep_ms");
    s = s.write("    bl __fn___fern_sleep_ms\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_SLEEP_NS) {
    s = s.need("sleep_ns");
    s = s.write("    bl __fn___fern_sleep_ns\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
  } else if (o.kind_tag == ir.K_DYN_BOX) {
    s = emit_arm64_op_dyn_box(o, s);
  } else {
    ircore.flat_arm_missing(o);
  }
  return s;
}

function emit_arm64_op_memset(i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
  s = s.write(lp + "ms" + util.i32_to_string(i) + ":\n");
  s = s.write("    cbz x2, " + lp + "msd" + util.i32_to_string(i) + "\n");
  s = s.write("    strb w1, [x0], #1\n    sub x2, x2, #1\n");
  s = s.write("    b " + lp + "ms" + util.i32_to_string(i) + "\n");
  s = s.write(lp + "msd" + util.i32_to_string(i) + ":\n");
  return s.write("    mov x0, #0\n    str x0, [sp, #-16]!\n");
}

function ssa_dyn_dispatch(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
  s = asmcore.ssa_x0_forget(s);
  let args: asmcore.DynArg[] = [];
  let moved = false;
  for v in ins.args {
    if (reg_of[v] >= 0) {
      let home = ssa_reg(reg_of[v]);
      if (home == "x0") {
        if (!moved) {
          s = s.write("    mov x4, x0\n");
          moved = true;
        }
        home = "x4";
      }
      args = args.append(asmcore.DynArg { reg: home, off: 0 });
    } else {
      args = args.append(asmcore.DynArg { reg: "", off: ssa_slot_off(ssa.spill_slot(reg_of[v])) - s.ssa_save });
    }
  }
  s = emit_dyn_dispatch_chain(ins.str, args, ins.imm, lp, s);
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

function ssa_flat_op(ins: ssa.SInst, reg_of: i32[], lp: string, r: irtables.Lowered, s: asmcore.EmitState): asmcore.EmitState {
  let kind = r.ops[ins.imm].kind_tag;
  if (kind == ir.K_TCP_POLLABLE) {
    s = asmcore.ssa_x0_forget(s);
    let d = ssa_dst(reg_of, ins.result);
    s = ssa_load(reg_of, ins.args[0], d, s);
    return ssa_store(reg_of, ins.result, d, s);
  }

  if (asmcore.buf_helper(r.ops[ins.imm].kind_tag) != "") {
    return ssa_buf_call(ins, reg_of, asmcore.buf_table_helper(r.ops[ins.imm].kind_tag, ir.is_packed(r.ops[ins.imm])), s);
  }
  s = asmcore.ssa_x0_forget(s);
  let outer = s.capture;
  let h = buf_new(256);
  s = emit_stack_op(r.ops[ins.imm], ins.imm, lp, r, asmcore.EmitState { ...s, capture: h });
  let arm = buf_take(h);
  buf_free(h);
  s = asmcore.EmitState { ...s, capture: outer };
  let pops = ssa_leading_pops(arm, ins.args.len());
  if (!ssa_pops_ordered(ins, reg_of, pops)) {
    pops = [];
  }
  let stacked = ins.args.len() - pops.len();
  let i = 0;
  while (i < stacked) {
    s = ssa_push_operand(reg_of, ins.args[i], i * 16, s);
    i += 1;
  }
  for k in ssa_pop_order(ins, reg_of, pops) {
    s = ssa_load_pushed(reg_of, ins.args[ins.args.len() - 1 - k], pops[k], stacked * 16, s);
  }
  let body = slice_unchecked(arm, ssa_pops_len(pops), arm.len()) + "";
  let result = ssa_trailing_push(body);
  if (result != "") {
    s = s.write(slice_unchecked(body, 0, body.len() - ssa_push_line(result).len()) + "");
    return ssa_store(reg_of, ins.result, result, asmcore.ssa_x0_forget(s));
  }
  s = s.write(body + "    ldr x0, [sp], #16\n");
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

function ssa_pop_line(reg: string): string {
  return "    ldr " + reg + ", [sp], #16\n";
}

function ssa_push_line(reg: string): string {
  return "    str " + reg + ", [sp, #-16]!\n";
}

function ssa_pops_len(pops: string[]): i32 {
  let n = 0;
  for p in pops {
    n += ssa_pop_line(p).len();
  }
  return n;
}

function ssa_leading_pops(arm: string, limit: i32): string[] {
  let out: string[] = [];
  let at = 0;
  while (out.len() < limit) {
    let reg = ssa_line_reg(arm, at, "    ldr x", ", [sp], #16\n");
    if (reg == "") {
      return out;
    }
    out = out.append(reg);
    at += ssa_pop_line(reg).len();
  }
  return out;
}

function ssa_trailing_push(body: string): string {
  let at = body.len() - 1;
  if (at < 0 || body[at] != 10) {
    return "";
  }
  at -= 1;
  while (at >= 0 && body[at] != 10) {
    at -= 1;
  }
  let reg = ssa_line_reg(body, at + 1, "    str x", ", [sp, #-16]!\n");
  if (reg == "" || at + 1 + ssa_push_line(reg).len() != body.len()) {
    return "";
  }
  return reg;
}

function ssa_line_reg(text: string, at: i32, prefix: string, suffix: string): string {
  if (at + prefix.len() > text.len()) {
    return "";
  }
  if (slice_unchecked(text, at, at + prefix.len()) != prefix) {
    return "";
  }
  let end = at + prefix.len();
  while (end < text.len() && text[end] >= 48 && text[end] <= 57) {
    end += 1;
  }
  if (end == at + prefix.len() || end + suffix.len() > text.len()) {
    return "";
  }
  if (slice_unchecked(text, end, end + suffix.len()) != suffix) {
    return "";
  }
  return "x" + slice_unchecked(text, at + prefix.len(), end);
}

function ssa_pops_ordered(ins: ssa.SInst, reg_of: i32[], pops: string[]): boolean {
  return ssa_pop_order(ins, reg_of, pops).len() == pops.len();
}

function ssa_pop_order(ins: ssa.SInst, reg_of: i32[], pops: string[]): i32[] {
  let srcs: string[] = [];
  let k = 0;
  while (k < pops.len()) {
    let v = ins.args[ins.args.len() - 1 - k];
    let src = "";
    if (reg_of[v] >= 0) {
      src = ssa_reg(reg_of[v]);
    }
    srcs = srcs.append(src);
    k += 1;
  }
  let done = __alloc_bool(pops.len());
  let order: i32[] = [];
  let progressed = true;
  while (progressed && order.len() < pops.len()) {
    progressed = false;
    let i = 0;
    while (i < pops.len()) {
      if (!done[i] && !asmcore.ssa_still_read(srcs, done, pops[i], i)) {
        order = order.append(i);
        done = done.with(i, true);
        progressed = true;
      }
      i += 1;
    }
  }
  return order;
}

function ssa_buf_call(ins: ssa.SInst, reg_of: i32[], sym: string, s: asmcore.EmitState): asmcore.EmitState {
  s = asmcore.ssa_x0_forget(s).buf_needs(sym);
  s = ssa_load_helper_args(reg_of, ins.args, s);
  s = ssa_bl_sym(s, sym);
  return ssa_store(reg_of, ins.result, "x0", asmcore.ssa_x0_forget(s));
}

// x4 and up hold no value, so those arguments load first, before the moves
// into x0 to x3 can overwrite their sources.
function ssa_load_helper_args(reg_of: i32[], args: i32[], s: asmcore.EmitState): asmcore.EmitState {
  let homes: i32[] = [0, 8, 9, 10];
  for k in homes.len()..args.len() {
    s = ssa_load(reg_of, args[k], "x" + util.i32_to_string(k), s);
  }
  let srcs: i32[] = [];
  let dsts: i32[] = [];
  let i = 0;
  while (i < args.len() && i < homes.len()) {
    srcs = srcs.append(reg_of[args[i]]);
    dsts = dsts.append(homes[i]);
    i += 1;
  }
  return ssa_parallel_moves(srcs, dsts, s);
}

function emit_arm64_op_memcpy(o: ir.Op, i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
  let mi = util.i32_to_string(i);
  s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
  s = arm64_copy_bytes(s, CopyRegs { dst: "x0", src: "x1", n: "x2", tmp: "x4", src_end: "x9", dst_end: "x10" }, lp + "mc" + mi, lp + "mct" + mi, lp + "mcb" + mi, lp + "mcd" + mi);
  s = s.write("    mov x0, #0\n    str x0, [sp, #-16]!\n");

  return s;
}

struct CopyRegs { dst: string, src: string, n: string, tmp: string, src_end: string, dst_end: string }

function arm64_copy_bytes(s: asmcore.EmitState, r: CopyRegs, words: string, tail: string, bytes: string, done: string): asmcore.EmitState {
  let tb = "w" + slice_unchecked(r.tmp, 1, r.tmp.len());
  s = s.write("    cbz " + r.n + ", " + done + "\n");
  s = s.write("    cmp " + r.n + ", #8\n    b.lo " + bytes + "\n");
  s = s.write("    add " + r.src_end + ", " + r.src + ", " + r.n + "\n    sub " + r.src_end + ", " + r.src_end + ", #8\n");
  s = s.write("    add " + r.dst_end + ", " + r.dst + ", " + r.n + "\n    sub " + r.dst_end + ", " + r.dst_end + ", #8\n");
  s = s.write(words + ":\n");
  s = s.write("    cmp " + r.dst + ", " + r.dst_end + "\n    b.hs " + tail + "\n");
  s = s.write("    ldr " + r.tmp + ", [" + r.src + "], #8\n    str " + r.tmp + ", [" + r.dst + "], #8\n");
  s = s.write("    b " + words + "\n");
  s = s.write(tail + ":\n");
  s = s.write("    ldr " + r.tmp + ", [" + r.src_end + "]\n    str " + r.tmp + ", [" + r.dst_end + "]\n");
  s = s.write("    b " + done + "\n");
  s = s.write(bytes + ":\n");
  s = s.write("    ldrb " + tb + ", [" + r.src + "], #1\n    strb " + tb + ", [" + r.dst + "], #1\n    sub " + r.n + ", " + r.n + ", #1\n");
  s = s.write("    cbnz " + r.n + ", " + bytes + "\n");
  return s.write(done + ":\n");
}

// A 64-bit immediate as one movz and a movk per nonzero upper half-word.
function mov_imm64(reg: string, value: i64): string {
  let out = "    movz " + reg + ", #" + (value & 65535i64).to_string() + "\n";
  let shift: i32 = 16;
  while (shift < 64) {
    let part = value >> shift & 65535i64;
    if (part != 0i64) {
      out = out + "    movk " + reg + ", #" + part.to_string() + ", lsl #" + shift.to_string() + "\n";
    }
    shift += 16;
  }
  return out;
}

function emit_arm64_op_heap_bump_bytes(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("heap");
  s = s.write("    adrp x0, __fern_heap_ptr\n    add x0, x0, :lo12:__fern_heap_ptr\n    ldr x0, [x0]\n");
  s = s.write("    adrp x1, __fern_heap_base\n    add x1, x1, :lo12:__fern_heap_base\n    ldr x1, [x1]\n");
  s = s.write("    sub x2, x0, x1\n");
  s = s.write("    cmp x0, #0\n");
  s = s.write("    csel x2, x2, xzr, ne\n");
  s = s.write("    str x2, [sp, #-16]!\n");

  return s;
}

function emit_arm64_op_heap_alloc_count(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("heap");
  s = s.need("alloc_count");
  s = s.write("    adrp x0, __fern_alloc_count\n    add x0, x0, :lo12:__fern_alloc_count\n    ldr x0, [x0]\n");
  s = s.write("    str x0, [sp, #-16]!\n");

  return s;
}

function arm64_zero_words(s: asmcore.EmitState, dst: string, n: i32): asmcore.EmitState {
  let lo = asmcore.fresh_label(s);
  let lbl = lo.name;
  s = lo.state;
  s = s.write("    adrp x10, " + dst + "\n    add x10, x10, :lo12:" + dst + "\n");
  s = s.write("    mov x11, #" + util.i32_to_string(n) + "\n");
  s = s.write(lbl + ":\n");
  s = s.write("    str xzr, [x10], #8\n");
  s = s.write("    sub x11, x11, #1\n");
  s = s.write("    cbnz x11, " + lbl + "\n");
  return s;
}

// The cursor and the end move into [start, end), and both free lists are
// zeroed so no block outside the region is handed out again.
function emit_arm64_op_heap_adopt(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("heap");
  s = s.need("heap_adopt");
  s = s.write("    ldr x1, [sp], #16\n");
  s = s.write("    ldr x0, [sp], #16\n");
  let move = asmcore.fresh_label(s);
  let keep = asmcore.fresh_label(move.state);
  s = keep.state;
  s = s.write("    adrp x2, __fern_heap_base\n    add x2, x2, :lo12:__fern_heap_base\n    ldr x3, [x2]\n    cmp x0, x3\n    b.lo " + move.name + "\n");
  s = s.write("    adrp x2, __fern_heap_end\n    add x2, x2, :lo12:__fern_heap_end\n    ldr x3, [x2]\n    cmp x0, x3\n    b.lo " + keep.name + "\n");
  s = s.write(move.name + ":\n");
  s = s.write("    adrp x2, __fern_heap_base\n    add x2, x2, :lo12:__fern_heap_base\n    ldr x3, [x2]\n");
  s = s.write("    adrp x2, __fern_image_lo\n    add x2, x2, :lo12:__fern_image_lo\n    str x3, [x2]\n");
  s = s.write("    adrp x2, __fern_heap_end\n    add x2, x2, :lo12:__fern_heap_end\n    ldr x3, [x2]\n");
  s = s.write("    adrp x2, __fern_image_hi\n    add x2, x2, :lo12:__fern_image_hi\n    str x3, [x2]\n");
  s = s.write("    adrp x2, __fern_heap_base\n    add x2, x2, :lo12:__fern_heap_base\n    str x0, [x2]\n");
  if (s.leak_check) {
    s = s.write("    adrp x2, __fern_lc_adopt_lo\n    add x2, x2, :lo12:__fern_lc_adopt_lo\n    str x0, [x2]\n");
    s = s.write("    adrp x2, __fern_lc_adopt_hi\n    add x2, x2, :lo12:__fern_lc_adopt_hi\n    str x1, [x2]\n");
  }
  s = s.write(keep.name + ":\n");
  s = s.write("    adrp x2, __fern_heap_ptr\n    add x2, x2, :lo12:__fern_heap_ptr\n    str x0, [x2]\n");
  s = s.write("    adrp x2, __fern_heap_end\n    add x2, x2, :lo12:__fern_heap_end\n    str x1, [x2]\n");
  s = arm64_zero_words(s, "__fern_freelist", 65536);
  s = arm64_zero_words(s, "__fern_large_freelist", 2560);
  s = s.write("    str xzr, [sp, #-16]!\n");
  return s;
}

// The leak-check counters a worker region carries, at words 1 to 4 of its
// header. x0 holds the region. The snapshot runs only when the mapping
// succeeded.
function arm64_lc_counters(): string[] {
  return ["__fern_lc_alloc_count", "__fern_lc_alloc_bytes", "__fern_lc_free_count", "__fern_lc_free_bytes"];
}

function arm64_lc_counter_addr(s: asmcore.EmitState, k: i32): asmcore.EmitState {
  let sym = arm64_lc_counters()[k];
  return s.write("    adrp x1, " + sym + "\n    add x1, x1, :lo12:" + sym + "\n");
}

// Word 5 of a region's header is its size, which the reap reads back.
// x0 holds the region and x1 the size.
function arm64_worker_region_size(s: asmcore.EmitState): asmcore.EmitState {
  let l = asmcore.fresh_label(s);
  s = l.state.write("    cmp x0, #0\n    b.le " + l.name + "\n    str x1, [x0, #40]\n");
  return s.write(l.name + ":\n");
}

function arm64_worker_region_census(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  let l = asmcore.fresh_label(s);
  s = l.state.write("    cmp x0, #0\n    b.le " + l.name + "\n");
  for k in 0..4 {
    s = arm64_lc_counter_addr(s, k);
    s = s.write("    ldr x2, [x1]\n    str x2, [x0, #" + util.i32_to_string(8 + 8 * k) + "]\n");
  }
  return s.write(l.name + ":\n");
}

function arm64_worker_exit_census(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  for k in 0..4 {
    let off = util.i32_to_string(8 + 8 * k);
    s = arm64_lc_counter_addr(s, k);
    s = s.write("    ldr x2, [x1]\n    ldr x3, [x0, #" + off + "]\n    sub x2, x2, x3\n    str x2, [x0, #" + off + "]\n");
  }
  return s;
}

function arm64_worker_reap_census(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  let done = asmcore.fresh_label(s);
  s = done.state.write("    ldr x2, [x0]\n    cbz x2, " + done.name + "\n");
  for k in 0..4 {
    s = arm64_lc_counter_addr(s, k);
    s = s.write("    ldr x2, [x1]\n    ldr x3, [x0, #" + util.i32_to_string(8 + 8 * k) + "]\n    add x2, x2, x3\n    str x2, [x1]\n");
  }
  return s.write(done.name + ":\n");
}

// Snapshot live child allocations before munmap. Only a successful syscall
// records their reclamation. No unmapped box enters a parent free list.
function emit_arm64_worker_unmap(s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("worker_unmap");
  s = s.need("worker_regions");
  s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
  if (s.rc_free_debug) {
    s = s.write(quar_addr("x5", "__fern_forget_lo") + "    str xzr, [x5]\n" + quar_addr("x5", "__fern_forget_hi") + "    str xzr, [x5]\n");
  }
  let ready = asmcore.fresh_label(s);
  let bad = asmcore.fresh_label(ready.state);
  let done = asmcore.fresh_label(bad.state);
  s = done.state;
  if (s.leak_check) {
    s = s.write("    mov x3, #0\n    mov x4, #0\n    cbz x2, " + ready.name + "\n");
    s = s.write("    ldr x3, [x0, #8]\n    ldr x5, [x0, #24]\n    subs x3, x3, x5\n    b.lo " + bad.name + "\n");
    s = s.write("    ldr x4, [x0, #16]\n    ldr x5, [x0, #32]\n    subs x4, x4, x5\n    b.lo " + bad.name + "\n");
    s = s.write(ready.name + ":\n    stp x3, x4, [sp, #-16]!\n");
  }
  s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_worker_unmap\n    add sp, sp, #48\n");
  if (s.leak_check) {
    s = s.write("    ldp x3, x4, [sp], #16\n    cbnz w0, " + done.name + "\n");
    s = arm64_lc_counter_addr(s, 2);
    s = s.write("    ldr x2, [x1]\n    add x2, x2, x3\n    str x2, [x1]\n");
    s = arm64_lc_counter_addr(s, 3);
    s = s.write("    ldr x2, [x1]\n    add x2, x2, x4\n    str x2, [x1]\n");
    s = s.write("    b " + done.name + "\n" + bad.name + ":\n    mov x0, #-22\n" + done.name + ":\n");
  }
  return s.write("    str x0, [sp, #-16]!\n");
}

function emit_arm64_op_heap_release_to(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
  let hro = asmcore.fresh_label(s);
  let hr_done = hro.name;
  s = hro.state;
  s = s.need("heap");
  s = s.write("    ldr x0, [sp], #16\n");
  s = s.write("    cbz x0, " + hr_done + "\n");
  s = s.write("    adrp x1, __fern_heap_ptr\n    add x1, x1, :lo12:__fern_heap_ptr\n");
  if (s.harden) {
    s = s.write("    ldr x9, [x1]\n    mov x10, x0\n" + hr_done + "_zero:\n    cmp x10, x9\n    b.hs " + hr_done + "_kept\n");
    s = s.write("    strb wzr, [x10], #1\n    b " + hr_done + "_zero\n" + hr_done + "_kept:\n");
  }
  s = s.write("    str x0, [x1]\n");
  s = arm64_copy_words(s, "__fern_freelist_shadow", "__fern_freelist", 65536);
  s = arm64_copy_words(s, "__fern_large_freelist_shadow", "__fern_large_freelist", 2560);
  s = s.write(hr_done + ":\n");
  s = s.write("    str x0, [sp, #-16]!\n");

  return s;
}

function helper_call_needs(name: string, s: asmcore.EmitState): asmcore.EmitState {
  s = s.need("heap");
  if (name == "__fern_i32_to_string") {
    s = s.need("i32_to_string");
  }
  if (name == "__fern_u32_to_string") {
    s = s.need("u32_to_string");
  }
  if (name == "__fern_i64_to_string") {
    s = s.need("i64_to_string");
  }
  if (name == "__fern_u64_to_string") {
    s = s.need("u64_to_string");
  }
  if (name == "__fern_slice_abort") {
    s = s.need("heap");
  }
  s = s.need_array_helper(name);
  if (name == "__fern_arr_inc_elems") {
    s = s.need("arr_inc_elems");
  }
  if (name == "__fern_arr_own_elems") {
    s = s.need("arr_own_elems");
  }
  if (name == "__fern_str_own") {
    s = s.need("str_own");
  }
  if (name == "__fern_str_borrow") {
    s = s.need("str_borrow");
  }
  if (name == "__fern_str_grow" || name == "__fern_str_grow_range" || name == "__fern_str_grow_fresh" || name == "__fern_str_grow_fresh_range") {
    s = s.need("str_grow");
  }
  if (name == "__fern_account_entry") {
    s = s.need("account");
  }
  if (name == "__fern_set_args") {
    s = s.need("set_args");
  }
  return s;
}

function dyn_arg_load(s: asmcore.EmitState, reg: string, a: asmcore.DynArg): asmcore.EmitState {
  if (a.reg.len() > 0) {
    if (a.reg == reg) {
      return s;
    }
    return s.write("    mov " + reg + ", " + a.reg + "\n");
  }
  return fr_ldr(s, reg, a.off);
}

function emit_dyn_dispatch_chain(arms: string, args: asmcore.DynArg[], i: i32, lp: string, own s: asmcore.EmitState): asmcore.EmitState {
  let dargc = args.len();
  s = dyn_arg_load(s, "x0", args[0]);
  s = s.write("    ldr x1, [x0]\n");
  let dend = lp + "dynend" + util.i32_to_string(i);
  let dfi = 0;
  let darmn = 0;
  while (dfi < s.funcs.len()) {
    let dfd = s.funcs[dfi];
    let ddbn = util.base_type_name(dfd.receiver_type);
    let dprim = dfd.receiver_type.len() > 0 && asmcore.is_prim_recv_name(ddbn, s);
    if (irtables.dyn_arm_matches(dfd, arms) && dfd.receiver_type.len() > 0
      && (asmcore.is_struct_decl_name(ddbn, s) || dprim)) {
      let dbn = ddbn;
      let dlit = asmcore.shape_ref(s, dbn);
      s = dlit.state;
      let dnext = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      s = s.write("    adrp x2, " + dlit.label + "\n");
      s = s.write("    add x2, x2, :lo12:" + dlit.label + "\n");
      s = s.write("    cmp x1, x2\n    b.ne " + dnext + "\n");
      let dk = dargc - 1;
      while (dk >= 0) {
        if (dk == 0 && dprim) {
          s = dyn_arg_load(s, "x0", args[0]);
          s = s.write("    ldr x0, [x0, #8]\n");
          s = s.write("    str x0, [sp, #-16]!\n");
        } else {
          s = dyn_arg_load(s, "x0", args[dk]);
          s = s.write("    str x0, [sp, #-16]!\n");
        }
        dk -= 1;
      }
      s = s.write("    bl __fn_" + asmcore.sanitize_label(dbn + "." + dfd.name) + "\n");
      s = s.write("    add sp, sp, #" + util.i32_to_string(dargc * 16) + "\n");
      s = s.write("    b " + dend + "\n");
      s = s.write(dnext + ":\n");
      darmn += 1;
    }
    if (irtables.dyn_arm_matches(dfd, arms) && dfd.receiver_type.len() > 0
      && !asmcore.recv_is_array(dfd.receiver_type)
      && irtables.decl_is_enum(s.struct_decls, ddbn)) {
      let dehit = lp + "dynehit" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      let denext = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
      let dvi = 0;
      while (dvi < s.struct_decls.decls.len()) {
        if (s.struct_decls.decls[dvi].enum_owner == ddbn) {
          let vlit_name = irtables.decl_shape(s.struct_decls.decls[dvi]);
          let vlit = asmcore.shape_ref(s, vlit_name);
          s = vlit.state;
          s = s.write("    adrp x2, " + vlit.label + "\n");
          s = s.write("    add x2, x2, :lo12:" + vlit.label + "\n");
          s = s.write("    cmp x1, x2\n    b.eq " + dehit + "\n");
        }
        dvi += 1;
      }
      s = s.write("    b " + denext + "\n");
      s = s.write(dehit + ":\n");
      let dek = dargc - 1;
      while (dek >= 0) {
        s = dyn_arg_load(s, "x0", args[dek]);
        s = s.write("    str x0, [sp, #-16]!\n");
        dek -= 1;
      }
      s = s.write("    bl __fn_" + asmcore.sanitize_label(ddbn + "." + dfd.name) + "\n");
      s = s.write("    add sp, sp, #" + util.i32_to_string(dargc * 16) + "\n");
      s = s.write("    b " + dend + "\n");
      s = s.write(denext + ":\n");
      darmn += 1;
    }
    dfi += 1;
  }
  if (asmcore.process_entry(s)) {
    s = s.write(profile_exit_asm(s));
    s = s.write("    mov x0, #134\n    mov x8, #94\n").svc(94);
  } else {
    s = s.write("    brk #1\n");
  }
  s = s.write(dend + ":\n");
  return s;
}

function emit_arm64_op_dyn_box(o: ir.Op, own s: asmcore.EmitState): asmcore.EmitState {
  let dbl = asmcore.shape_ref(s, o.str);
  s = dbl.state;
  s = s.need("heap");
  s = s.write("    mov x0, #2\n    bl __fern_arr_box\n");
  s = s.write("    adrp x2, " + dbl.label + "\n");
  s = s.write("    add x2, x2, :lo12:" + dbl.label + "\n");
  s = s.write("    str x2, [x0]\n");
  s = s.write("    ldr x1, [sp], #16\n    str x1, [x0, #8]\n");
  s = s.write("    str x0, [sp, #-16]!\n");

  return s;
}

pub function reloc_wanted(s: asmcore.EmitState, darwin: boolean): boolean {
  return !darwin && s.str_ns.len() == 0;
}

function emit_ir_reloc(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  if (!reloc_wanted(s, darwin)) {
    return s;
  }
  s = s.write("    adrp x9, .Lfern_relanchor\n");
  s = s.write("    add x9, x9, :lo12:.Lfern_relanchor\n");
  s = s.write("    ldr x10, [x9]\n");
  s = s.write("    sub x9, x9, x10\n");
  s = s.write("    cbz x9, .Lfern_reloc_done\n");
  s = s.write("    adrp x11, .Lfern_sbox_begin\n");
  s = s.write("    add x11, x11, :lo12:.Lfern_sbox_begin\n");
  s = s.write("    adrp x12, .Lfern_sbox_end\n");
  s = s.write("    add x12, x12, :lo12:.Lfern_sbox_end\n");
  s = s.write(".Lfern_sbox_loop:\n");
  s = s.write("    cmp x11, x12\n");
  s = s.write("    b.hs .Lfern_sbox_done\n");
  s = s.write("    ldr x13, [x11, #8]\n");
  s = s.write("    add x13, x13, x9\n");
  s = s.write("    str x13, [x11, #8]\n");
  s = s.write("    add x11, x11, #24\n");
  s = s.write("    b .Lfern_sbox_loop\n");
  s = s.write(".Lfern_sbox_done:\n");
  s = s.write("    adrp x11, .Lfern_cagg_begin\n");
  s = s.write("    add x11, x11, :lo12:.Lfern_cagg_begin\n");
  s = s.write("    adrp x12, .Lfern_cagg_end\n");
  s = s.write("    add x12, x12, :lo12:.Lfern_cagg_end\n");
  s = s.write(".Lfern_cagg_loop:\n");
  s = s.write("    cmp x11, x12\n");
  s = s.write("    b.hs .Lfern_cagg_done\n");
  s = s.write("    ldr x13, [x11, #16]\n");
  s = s.write("    add x13, x13, x9\n");
  s = s.write("    str x13, [x11, #16]\n");
  s = s.write("    ldr x14, [x11]\n");
  s = s.write("    add x11, x11, #16\n");
  s = s.write("    add x11, x11, x14, lsl #3\n");
  s = s.write("    b .Lfern_cagg_loop\n");
  s = s.write(".Lfern_cagg_done:\n");
  s = s.write("    adrp x11, .Lfern_cfn_begin\n");
  s = s.write("    add x11, x11, :lo12:.Lfern_cfn_begin\n");
  s = s.write("    adrp x12, .Lfern_cfn_end\n");
  s = s.write("    add x12, x12, :lo12:.Lfern_cfn_end\n");
  s = s.write(".Lfern_cfn_loop:\n");
  s = s.write("    cmp x11, x12\n");
  s = s.write("    b.hs .Lfern_cfn_done\n");
  s = s.write("    ldr x13, [x11, #24]\n");
  s = s.write("    add x13, x13, x9\n");
  s = s.write("    str x13, [x11, #24]\n");
  s = s.write("    add x11, x11, #32\n");
  s = s.write("    b .Lfern_cfn_loop\n");
  s = s.write(".Lfern_cfn_done:\n");
  s = s.write("    adrp x11, .Lfern_cref_begin\n");
  s = s.write("    add x11, x11, :lo12:.Lfern_cref_begin\n");
  s = s.write("    adrp x12, .Lfern_cref_end\n");
  s = s.write("    add x12, x12, :lo12:.Lfern_cref_end\n");
  s = s.write(".Lfern_cref_loop:\n");
  s = s.write("    cmp x11, x12\n");
  s = s.write("    b.hs .Lfern_reloc_done\n");
  s = s.write("    ldr x13, [x11]\n");
  s = s.write("    add x13, x13, x9\n");
  s = s.write("    ldr x14, [x13]\n");
  s = s.write("    add x14, x14, x9\n");
  s = s.write("    str x14, [x13]\n");
  s = s.write("    add x11, x11, #8\n");
  s = s.write("    b .Lfern_cref_loop\n");
  s = s.write(".Lfern_reloc_done:\n");
  return s;
}

function emit_vdso_scan(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    ldr x0, [sp]\n");
  s = s.write("    lsl x0, x0, #3\n");
  s = s.write("    add x0, x0, #16\n");
  s = s.write("    add x0, sp, x0\n");
  s = s.write(".Lfern_auxv_env:\n");
  s = s.write("    ldr x1, [x0], #8\n");
  s = s.write("    cbnz x1, .Lfern_auxv_env\n");
  s = s.write(".Lfern_auxv_scan:\n");
  s = s.write("    ldp x1, x2, [x0], #16\n");
  s = s.write("    cbz x1, .Lfern_auxv_done\n");
  s = s.write("    cmp x1, #33\n");
  s = s.write("    b.ne .Lfern_auxv_scan\n");
  s = s.write("    adrp x1, __fern_vdso\n");
  s = s.write("    add x1, x1, :lo12:__fern_vdso\n");
  s = s.write("    str x2, [x1]\n");
  s = s.write(".Lfern_auxv_done:\n");
  return s;
}

// The two slots hold the link-time address and the length of the read-only
// region. The relocation loop leaves the load delta in x9. The start is
// rounded down and the end is rounded down to the page size the kernel
// reports in AT_PAGESZ, so no writable word is ever covered.
function emit_relro_protect(s: asmcore.EmitState, reloc: boolean): asmcore.EmitState {
  if (!asmcore.relro_protection_needed(s)) {
    return s;
  }
  s = s.need("relro_protect");
  s = s.write("    .section .data\n    .align 3\n__fern_relro_begin:\n    .quad 0\n__fern_relro_len:\n    .quad 0\n    .text\n");
  if (!reloc) {
    s = s.write("    mov x9, xzr\n");
  }
  s = s.write("    adrp x10, __fern_relro_len\n");
  s = s.write("    add x10, x10, :lo12:__fern_relro_len\n");
  s = s.write("    ldr x1, [x10]\n");
  s = s.write("    cbz x1, .Lfern_relro_done\n");
  s = s.write("    adrp x10, __fern_relro_begin\n");
  s = s.write("    add x10, x10, :lo12:__fern_relro_begin\n");
  s = s.write("    ldr x0, [x10]\n");
  s = s.write("    add x0, x0, x9\n");
  s = s.write("    ldr x2, [sp]\n");
  s = s.write("    lsl x2, x2, #3\n");
  s = s.write("    add x2, x2, #16\n");
  s = s.write("    add x2, sp, x2\n");
  s = s.write(".Lfern_relro_env:\n");
  s = s.write("    ldr x3, [x2], #8\n");
  s = s.write("    cbnz x3, .Lfern_relro_env\n");
  s = s.write("    mov x4, #4096\n");
  s = s.write(".Lfern_relro_scan:\n");
  s = s.write("    ldp x3, x5, [x2], #16\n");
  s = s.write("    cbz x3, .Lfern_relro_pagesz\n");
  s = s.write("    cmp x3, #6\n");
  s = s.write("    b.ne .Lfern_relro_scan\n");
  s = s.write("    mov x4, x5\n");
  s = s.write(".Lfern_relro_pagesz:\n");
  s = s.write("    neg x4, x4\n");
  s = s.write("    add x1, x0, x1\n");
  s = s.write("    and x1, x1, x4\n");
  s = s.write("    and x0, x0, x4\n");
  s = s.write("    sub x1, x1, x0\n");
  s = s.write("    cmp x1, #0\n");
  s = s.write("    b.le .Lfern_relro_done\n");
  s = s.write("    mov x2, #1\n");
  s = s.write("    mov x8, #226\n");
  s = s.svc(226);
  s = s.write("    cbnz x0, .Lfern_relro_failed\n");
  return s.write(".Lfern_relro_done:\n");
}

function emit_ir_start(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  s = s.write("_start:\n");
  s = emit_ir_reloc(s, darwin);
  s = emit_relro_protect(s, reloc_wanted(s, darwin));
  if (!darwin && s.sandbox) {
    s = s.write("    bl __fern_seccomp_install\n");
  }
  if (darwin) {
    if (s.has_need("args")) {
      s = s.write("    adrp x3, __fern_argc\n");
      s = s.write("    add x3, x3, :lo12:__fern_argc\n");
      s = s.write("    str x0, [x3]\n");
      s = s.write("    adrp x3, __fern_argv\n");
      s = s.write("    add x3, x3, :lo12:__fern_argv\n");
      s = s.write("    str x1, [x3]\n");
    }
    if (s.has_need("heap")) {
      s = s.write("    adrp x3, __fern_envp\n");
      s = s.write("    add x3, x3, :lo12:__fern_envp\n");
      s = s.write("    str x2, [x3]\n");
    }
  } else {
    if (s.has_need("args")) {
      s = s.write("    ldr x0, [sp]\n");
      s = s.write("    adrp x1, __fern_argc\n");
      s = s.write("    add x1, x1, :lo12:__fern_argc\n");
      s = s.write("    str x0, [x1]\n");
      s = s.write("    add x0, sp, #8\n");
      s = s.write("    adrp x1, __fern_argv\n");
      s = s.write("    add x1, x1, :lo12:__fern_argv\n");
      s = s.write("    str x0, [x1]\n");
    }
    if (s.has_need("heap")) {
      s = s.write("    ldr x0, [sp]\n");
      s = s.write("    lsl x0, x0, #3\n");
      s = s.write("    add x0, x0, #16\n");
      s = s.write("    add x0, sp, x0\n");
      s = s.write("    adrp x1, __fern_envp\n");
      s = s.write("    add x1, x1, :lo12:__fern_envp\n");
      s = s.write("    str x0, [x1]\n");
    }
    if (asmcore.vdso_wanted(s, "arm64-linux")) {
      s = emit_vdso_scan(s);
    }
  }
  if (!s.shared) {
    s = emit_stack_switch(s, darwin);
    if (s.harden) {
      s = emit_canary_init(s);
    }
  }
  if (s.profile > 0) {
    s = s.write("    adrp x0, .Lprofile_ring\n    add x0, x0, :lo12:.Lprofile_ring\n");
    if (darwin) {
      s = s.write("    adrp x13, __mh_execute_header\n    add x13, x13, :lo12:__mh_execute_header\n    str x13, [x0, #56]\n");
    }
    s = s.write("    mov x9, sp\n    adrp x10, .Lprofile_action\n    add x10, x10, :lo12:.Lprofile_action\n    adrp x11, .Lprofile_timer\n    add x11, x11, :lo12:.Lprofile_timer\n    bl __fn___fern_profile_start.r\n    mov x29, xzr\n    mov x30, xzr\n");
  }
  // The startup frame never returns, so it carries no signature.
  s = s.write("    stp x29, x30, [sp, #-16]!\n");
  s = s.write("    mov x29, sp\n");
  if (asmcore.declares_main(s.funcs)) {
    s = s.write("    bl __fn_main\n");
    if (s.leak_check) {
      s = s.write("    mov x19, x0\n");
      s = s.write("    bl __fern_lc_report\n");
      s = s.write("    mov x0, x19\n");
    }
  } else {
    if (s.leak_check) {
      s = s.write("    bl __fern_lc_report\n");
    }
    s = s.write("    mov x0, #0\n");
  }
  s = s.write(profile_exit_asm(s));
  s = s.write("    mov x8, #94\n");
  s = s.svc(94);
  return s;
}

function emit_stack_switch(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  s = emit_stack_map(s, "    mov x1, #1\n    lsl x1, x1, #30\n", darwin);
  s = s.write("    tbnz x0, #63, .Lfern_stack_map_failed\n    mov x19, x0\n    mov x1, #1\n    lsl x1, x1, #20\n    mov x2, #0\n    mov x8, #226\n").svc(226).write("    cbnz x0, .Lfern_stack_guard_failed\n");
  s = s.write("    mov x9, #1\n    lsl x9, x9, #30\n    add x9, x19, x9\n    sub sp, x9, #16\n    mov x10, sp\n    adrp x11, __fern_stack_top\n    add x11, x11, :lo12:__fern_stack_top\n    str x10, [x11]\n");
  s = emit_stack_map(s, "    mov x1, #1\n    lsl x1, x1, #16\n", darwin);
  if (darwin) {
    s = s.write("    tbnz x0, #63, .Lfern_segv_skip\n");
  } else {
    s = s.write("    tbnz x0, #63, .Lfern_signal_stack_map_failed\n");
  }
  s = s.write("    mov x9, #1\n    lsl x9, x9, #16\n    sub sp, sp, #32\n");
  if (darwin) {
    s = s.write("    stp x0, x9, [sp]\n    str xzr, [sp, #16]\n");
  } else {
    s = s.write("    stp x0, xzr, [sp]\n    str x9, [sp, #16]\n");
  }
  s = s.write("    mov x0, sp\n    mov x1, #0\n    mov x8, #132\n").svc(132);
  if (!darwin) {
    s = s.write("    cbnz x0, .Lfern_signal_stack_failed\n");
  }
  s = s.write("    adrp x9, __fern_segv\n    add x9, x9, :lo12:__fern_segv\n");
  // The handler runs with every signal it handles blocked: SIGSEGV and SIGBUS
  // on Darwin (mask 0x600), SIGSEGV, SIGILL and SIGBUS on Linux (mask 0x448).
  if (darwin) {
    s = s.write("    adrp x10, __fern_segv_trampoline\n    add x10, x10, :lo12:__fern_segv_trampoline\n    mov x11, #0x41\n    lsl x11, x11, #32\n    orr x11, x11, #0x600\n    stp x9, x10, [sp]\n    stp x11, xzr, [sp, #16]\n");
  } else {
    s = s.write("    mov x10, #4\n    movk x10, #0x800, lsl #16\n    mov x11, #0x448\n    stp x9, x10, [sp]\n    stp xzr, x11, [sp, #16]\n");
  }
  s = s.write("    bl .Lfern_fault_install\n");
  if (darwin) {
    return s.write("    add sp, sp, #32\n.Lfern_segv_skip:\n");
  }
  return s.write("    cbnz x0, .Lfern_fault_handler_failed\n    add sp, sp, #32\n");
}

function emit_stack_map(s: asmcore.EmitState, size: string, darwin: boolean): asmcore.EmitState {
  let flags = "    mov x3, #0x4022\n    orr x3, x3, #0x20000\n";
  if (darwin) {
    flags = "    mov x3, #0x1002\n";
  }
  return s.write("    mov x0, #0\n" + size + "    mov x2, #3\n" + flags + "    mov x4, #0\n    sub x4, x4, #1\n    mov x5, #0\n    mov x8, #222\n").svc(222);
}

// A runtime entry point the kernel or a trampoline reaches. It is not a
// function value, so it carries the pad an indirect call does not check for.
function landing_pad(s: asmcore.EmitState): string {
  if (s.harden) {
    return "    bti jc\n";
  }
  return "";
}

// The word at a valid target is bti c (0xd503245f), and the word ahead of
// it is the signature hash when the call has one.
function cfi_check_arm64(s: asmcore.EmitState, reg: string, sig: i32): asmcore.EmitState {
  let ok = asmcore.fresh_label(s);
  s = ok.state;
  s = s.write("    ldr w16, [" + reg + "]\n    movz w17, #9311\n    movk w17, #54531, lsl #16\n    cmp w16, w17\n    b.eq " + ok.name + "\n    b __fern_cfi_fail\n" + ok.name + ":\n");
  if (sig == 0) {
    return s;
  }
  let same = asmcore.fresh_label(s);
  s = same.state;
  let lo = util.i32_to_string(sig & 65535);
  let hi = util.i32_to_string(sig >> 16 & 65535);
  return s.write("    ldur w16, [" + reg + ", #-4]\n    movz w17, #" + lo + "\n    movk w17, #" + hi + ", lsl #16\n    cmp w16, w17\n    b.eq " + same.name + "\n    b __fern_cfi_sig_fail\n" + same.name + ":\n");
}

function emit_cfi_stubs_from(s: asmcore.EmitState, first: i32): asmcore.EmitState {
  if (s.cfi_stubs.len() <= first) {
    return s;
  }
  s = s.write("    .text\n");
  let i = first;
  while (i < s.cfi_stubs.len()) {
    let target = s.cfi_stubs[i];
    s = ssa_landing_pad(s.write("    .word " + util.i32_to_string(s.cfi_sigs[i]) + "\n" + asmcore.cfi_stub_label(s, target) + ":\n"));
    s = s.write("    b " + target + "\n");
    i += 1;
  }
  return s;
}

// Installs the action the caller built at its sp for SIGSEGV, and for SIGBUS
// on Darwin, where a wild read raises it. Linux adds SIGILL and SIGBUS. It
// returns the first refusal in x0, or 0.
function emit_fault_install(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  let signals = [11, 4, 7];
  let args = "    mov x1, sp\n    mov x2, #0\n    mov x3, #8\n";
  let each = "";
  // A Darwin system call returns a second value in x1, so each call there
  // sets its arguments again.
  if (darwin) {
    signals = [11, 10];
    each = args;
    args = "";
  }
  s = s.write(".Lfern_fault_install:\n" + args);
  for signo in signals {
    s = s.write(each + "    mov x0, #" + util.i32_to_string(signo) + "\n    mov x8, #134\n").svc(134);
    s = s.write("    cbnz x0, .Lfern_fault_install_done\n");
  }
  return s.write(".Lfern_fault_install_done:\n    ret\n");
}

function emit_stack_overflow_runtime(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  let msg = aborts.stack_overflow();
  let addr = "    ldr x9, [x1, #16]\n";
  let ctx = "    ldr x10, [x2, #432]\n";
  let frame = "    ldr x11, [x2, #440]\n    ldr x12, [x2, #416]\n";
  if (darwin) {
    addr = "    ldr x9, [x1, #24]\n    ldr x13, [x2, #48]\n";
    ctx = "    ldr x10, [x13, #264]\n    and x10, x10, #0x0000ffffffffffff\n";
    frame = "    ldr x11, [x13, #272]\n    ldr x12, [x13, #248]\n    and x11, x11, #0x0000ffffffffffff\n    and x12, x12, #0x0000ffffffffffff\n";
  }
  let ill = aborts.illegal_instruction();
  let bus = aborts.bus_error();
  let dispatch = "    cmp x0, #11\n    b.ne .Lfern_fatal_signal\n";
  if (darwin) {
    s = s.write("    .section .bss\n    .align 8\n__fern_sig_sp: .quad 0, 0\n    .section .rodata\n.Lmsg_stack_overflow:\n    .ascii \"" + msg + "\\n\"\n    .text\n");
    dispatch = "";
  } else {
    s = s.write("    .section .bss\n    .align 8\n__fern_sig_sp: .quad 0, 0\n    .section .rodata\n.Lmsg_stack_overflow:\n    .ascii \"" + msg + "\\n\"\n.Lmsg_illegal_instruction:\n    .ascii \"" + ill + "\\n\"\n.Lmsg_bus_error:\n    .ascii \"" + bus + "\\n\"\n    .text\n");
  }
  // A fault inside the guard of the runtime's own stack is an overflow.
  let guard = "    adrp x14, __fern_stack_top\n    add x14, x14, :lo12:__fern_stack_top\n    ldr x14, [x14]\n    mov x15, #1\n    lsl x15, x15, #30\n    sub x14, x14, x15\n    add x14, x14, #16\n    sub x15, x9, x14\n    mov x16, #1\n    lsl x16, x16, #20\n    cmp x15, x16\n    b.hs .Lfern_segv_other\n";
  s = s.write("__fern_segv:\n" + landing_pad(s) + dispatch + addr + guard + ".Lfern_segv_overflow:\n" + frame);
  s = s.write("    stp x12, x11, [sp, #-16]!\n    mov x29, sp\n" + ctx + "    adrp x9, __fern_bt_floor\n    add x9, x9, :lo12:__fern_bt_floor\n    str x10, [x9]\n    adrp x1, .Lmsg_stack_overflow\n    add x1, x1, :lo12:.Lmsg_stack_overflow\n    mov x2, #" + util.i32_to_string(msg.len() + 1) + "\n    mov x0, #134\n    b __fern_report\n");
  let tramp = "xzr";
  if (darwin) {
    s = s.write(".Lfern_segv_other:\n    adrp x10, __fern_segv_trampoline\n    add x10, x10, :lo12:__fern_segv_trampoline\n");
    tramp = "x10";
  } else {
    s = s.write(".Lfern_segv_other:\n");
  }
  s = s.write(rt_frame(s) + "    sub sp, sp, #32\n    stp xzr, " + tramp + ", [sp]\n    stp xzr, xzr, [sp, #16]\n    bl .Lfern_fault_install\n");
  s = emit_fault_install(s.write("    add sp, sp, #32\n" + rt_unframe(s) + "    ret\n"), darwin);
  if (!darwin) {
    // A SIGILL or SIGBUS the kernel raised writes its cause and takes the
    // default action again: the return repeats the fault. A sent one exits.
    s = s.write(".Lfern_fatal_signal:\n    ldrsw x9, [x1, #8]\n    cmp x9, #0\n    b.le .Lfern_signal_sent\n    mov x15, x0\n    adrp x10, __fern_sig_sp\n    add x10, x10, :lo12:__fern_sig_sp\n    mov x9, sp\n    str x9, [x10]\n    str x30, [x10, #8]\n" + frame + "    stp x12, x11, [sp, #-16]!\n    mov x29, sp\n" + ctx + "    adrp x9, __fern_bt_floor\n    add x9, x9, :lo12:__fern_bt_floor\n    str x10, [x9]\n");
    s = s.write("    adrp x1, .Lmsg_illegal_instruction\n    add x1, x1, :lo12:.Lmsg_illegal_instruction\n    mov x2, #" + util.i32_to_string(ill.len() + 1) + "\n    cmp x15, #4\n    b.eq .Lfern_fatal_report\n    adrp x1, .Lmsg_bus_error\n    add x1, x1, :lo12:.Lmsg_bus_error\n    mov x2, #" + util.i32_to_string(bus.len() + 1) + "\n.Lfern_fatal_report:\n    mov x0, #-1\n    b __fern_report\n");
    s = s.write(".Lfern_signal_sent:\n    add x0, x0, #128\n    mov x8, #94\n").svc(94);
  }
  if (darwin) {
    s = s.write("__fern_segv_trampoline:\n" + landing_pad(s) + rt_frame(s) + "    mov x29, sp\n    stp x1, x4, [sp, #-16]!\n    stp x5, xzr, [sp, #-16]!\n    mov x16, x0\n    mov x0, x2\n    mov x1, x3\n    mov x2, x4\n    blr x16\n    ldp x2, xzr, [sp], #16\n    ldp x1, x0, [sp], #16\n" + rt_unframe(s) + "    mov x16, #184\n    svc #0x80\n    brk #0\n");
  }
  return s.write(".Lfern_signal_resume:\n    adrp x10, __fern_sig_sp\n    add x10, x10, :lo12:__fern_sig_sp\n    ldr x9, [x10]\n    ldr x30, [x10, #8]\n    mov sp, x9\n    b .Lfern_segv_other\n");
}

function emit_startup_failures(s: asmcore.EmitState): asmcore.EmitState {
  if (s.has_need("relro_protect")) {
    s = emit_startup_failure(s, ".Lfern_relro_failed", aborts.relro());
  }
  s = emit_startup_failure(s, ".Lfern_stack_map_failed", aborts.stack_map());
  s = emit_startup_failure(s, ".Lfern_stack_guard_failed", aborts.stack_guard());
  s = emit_startup_failure(s, ".Lfern_signal_stack_map_failed", aborts.signal_stack_map());
  s = emit_startup_failure(s, ".Lfern_signal_stack_failed", aborts.signal_stack());
  s = emit_startup_failure(s, ".Lfern_fault_handler_failed", aborts.fault_handler());
  return emit_harden_failures(s);
}

function emit_harden_failures(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  s = emit_startup_failure(s, ".Lfern_canary_read_failed", aborts.canary_read());
  s = emit_startup_failure(s, "__fern_canary_fail", aborts.canary());
  s = emit_startup_failure(s, "__fern_cfi_fail", aborts.cfi());
  return emit_startup_failure(s, "__fern_cfi_sig_fail", aborts.cfi_sig());
}

// A shared object has no startup, so its first export call reads the
// canary. The export entry calls it with the arguments still in registers.
function emit_harden_start(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  s = s.write("__fern_harden_start:\n    stp x0, x1, [sp, #-16]!\n    stp x2, x8, [sp, #-16]!\n");
  s = emit_canary_init(s);
  s = s.write("    ldp x2, x8, [sp], #16\n    ldp x0, x1, [sp], #16\n    ret\n");
  return emit_harden_failures(s);
}

function emit_canary_init(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    adrp x0, __fern_canary\n    add x0, x0, :lo12:__fern_canary\n    mov x1, #16\n    mov x2, #0\n    mov x8, #278\n").svc(278);
  s = s.write("    cmp x0, #16\n    b.ne .Lfern_canary_read_failed\n");
  s = s.write(quar_addr("x0", "__fern_rng_state"));
  return s.write("    ldr x1, [x0]\n    orr x1, x1, #1\n    str x1, [x0]\n");
}

function emit_startup_failure(s: asmcore.EmitState, label: string, msg: string): asmcore.EmitState {
  s = s.write("    .section .rodata\n" + label + "_msg:\n    .ascii \"" + msg + "\\n\"\n    .text\n" + label + ":\n");
  s = s.write("    adrp x1, " + label + "_msg\n    add x1, x1, :lo12:" + label + "_msg\n    mov x2, #" + util.i32_to_string(msg.len() + 1) + "\n    mov x0, #2\n    mov x8, #64\n").svc(64);
  return s.write("    mov x0, #134\n    mov x8, #94\n").svc(94);
}

pub function emit_body(mod: parser.Module, s: asmcore.EmitState, darwin: boolean, cache: irtables.LowerResult[], physical: physicalbody.Collection): asmcore.EmitState {
  s = asmcore.with_funcs(s, mod.funcs);
  if (asmcore.process_entry(s)) {
    s = s.write("    .globl _start\n");
  }
  if (asmcore.reset_entry(s)) {
    s = s.write("    .globl _start\n    .section .bss\n__fern_bss_start:\n");
  }
  s = s.write("    .text\n");
  let vgate = irverifygate.with_memo(irverifygate.gate(irtables.fn_sig_index(mod.funcs, mod.funcs, cache), s.kinds, physicalbody.abis(physical)), s.memo);
  let unit = asmcore.unit_leaves(mod, 0, mod.funcs.len(), cache, s.kinds);
  s = asmcore.EmitState { ...s, reg_entries: irtables.sig_reg_of(asmcore.unit_labels(mod, 0, mod.funcs.len(), cache)), leaves: unit.leaves };
  let fabi = asmcore.unit_float_abi(mod, 0, mod.funcs.len(), cache);
  s = asmcore.EmitState { ...s, float_abi: fabi.names, float_abi_masks: fabi.masks };
  let fi = 0;
  while (fi < mod.funcs.len()) {
    let r = ircore.produced(cache, fi, mod.funcs[fi]);
    if (!r.superseded) {
      s = emit_function_via_ir_pre(r, physicalbody.select(physical, fi), s.prelift(unit.pre, fi, r), mod.funcs[fi], s, vgate);
    }
    fi += 1;
  }
  s = emit_named_bodies(cache, physical, unit.pre, mod.funcs.len(), s, vgate);
  s = emit_cfi_stubs_from(s, 0);
  irverifygate.report(vgate);
  if (asmcore.reset_entry(s)) {
    return emit_reset_start(s);
  }
  if (!asmcore.process_entry(s)) {
    return s;
  }
  return emit_ir_start(s, darwin);
}

// The IRQ region: one pending word for each 32 IRQ lines, 1024 lines in all.
// A top half sets a bit, and the reactor clears it with IRQs masked.
function irq_region(): string {
  return "    .section .bss\n    .p2align 2\n__fern_irq_pending:\n    .skip " + util.i32_to_string(asmcore.irq_region_bytes()) + "\n";
}

// The loader enters EL1 with the MMU and data cache off, and with its boot
// argument in x0.
function emit_reset_start(s: asmcore.EmitState): asmcore.EmitState {
  let top = s.ram_base + s.ram_size;
  s = s.write("    .section .data\n    .p2align 3\n__fern_boot_info:\n    .quad 0\n" + irq_region() + "    .text\n");
  s = s.write("_start:\n    mrs x9, mpidr_el1\n    and x9, x9, #255\n    cbnz x9, .Lreset_park\n");
  s = s.write("    adrp x10, __fern_boot_info\n    str x0, [x10, :lo12:__fern_boot_info]\n");
  s = s.write(mov_imm64("x9", top) + "    mov sp, x9\n");
  s = s.write("    movz x9, #48, lsl #16\n    msr cpacr_el1, x9\n    isb\n");
  if (s.interrupts.len() > 0 || s.user_mode) {
    s = s.write("    adrp x9, __fern_vectors\n    add x9, x9, :lo12:__fern_vectors\n    msr vbar_el1, x9\n    isb\n");
  }
  s = s.write("    adrp x0, __fern_bss_start\n    add x0, x0, :lo12:__fern_bss_start\n");
  s = s.write("    adrp x1, __fern_bss_end\n    add x1, x1, :lo12:__fern_bss_end\n");
  s = s.write(".Lreset_clear:\n    cmp x0, x1\n    b.hs .Lreset_cleared\n    str xzr, [x0], #8\n    b .Lreset_clear\n.Lreset_cleared:\n");
  s = emit_reset_mmu(s);
  if (s.early.len() > 0) {
    // The hook runs on the stack and the identity map, before the heap starts.
    s = s.write("    bl " + s.early + "\n    adrp x1, __fern_bss_end\n    add x1, x1, :lo12:__fern_bss_end\n");
  }
  s = s.write("    add x0, x1, #15\n    and x0, x0, #-16\n");
  s = s.write(mov_imm64("x1", top - asmcore.reset_stack_bytes()) + "    sub x1, x1, x0\n    bl __fern_heap_init\n");
  s = s.write("    bl __fn_main\n    mov x19, x0\n");
  if (s.leak_check) {
    s = s.write("    bl __fern_lc_report\n");
  }
  s = s.write(exit_provider_call(s, "x19") + ".Lreset_park:\n    wfe\n    b .Lreset_park\n");
  if (s.secondary.len() > 0 || s.has_need("secondary_start")) {
    s = emit_secondary_start(s);
  }
  return emit_vectors(s);
}

// A call of the `exit` provider with the code in `reg`, or nothing without one.
function exit_provider_call(s: asmcore.EmitState, reg: string): string {
  if (s.exit_provider.len() == 0) {
    return "";
  }
  return "    sub sp, sp, #16\n    str " + reg + ", [sp]\n    bl " + s.exit_provider + "\n    add sp, sp, #16\n";
}

// The VBAR_EL1 table has 16 slots of 128 bytes. Slots 4 to 7 take an exception
// at the current level with SP_ELx, and go to the trampoline of their handler.
// Every other slot parks the core.
function emit_vectors(s: asmcore.EmitState): asmcore.EmitState {
  if (s.interrupts.len() == 0 && !s.user_mode) {
    return s;
  }
  s = s.write("    .p2align 11\n__fern_vectors:\n");
  for i in 0..16 {
    s = s.write("    .p2align 7\n    b " + vector_target(s.interrupts, s.user_mode, i) + "\n");
  }
  s = s.write(".Lvector_park:\n    wfe\n    b .Lvector_park\n");
  for entry in s.interrupts {
    let parts = util.split_char(entry, b' ');
    s = emit_vector_trampoline(s, parts[0], parts[1]);
  }
  if (s.user_mode) {
    s = emit_user_run(s);
  }
  return s;
}

// Slots 4 to 7 take an exception of the current level with SP_ELx, and slots
// 8 to 11 one from EL0 in AArch64, which returns from __user_run.
function vector_target(interrupts: string[], user_mode: boolean, slot: i32): string {
  if (user_mode && slot >= 8 && slot < 12) {
    return "__fern_user_trap_" + util.i32_to_string(slot - 8);
  }
  for entry in interrupts {
    let parts = util.split_char(entry, b' ');
    if (4 + util.index_of_str(norc.arm64_slots(), parts[0]) == slot) {
      return "__fern_vector_" + parts[0];
    }
  }
  return ".Lvector_park";
}

// The trampoline saves the registers that a call can change: x0 to x18, x29,
// x30, FPSR, and q0 to q7 and q16 to q31. Then it calls the handler, restores
// them and returns with eret.
function emit_vector_trampoline(s: asmcore.EmitState, slot: string, handler: string): asmcore.EmitState {
  s = s.write("__fern_vector_" + slot + ":\n    sub sp, sp, #576\n");
  s = s.write(vector_pairs("stp") + "    str x30, [sp, #160]\n    mrs x9, fpsr\n    str x9, [sp, #168]\n");
  s = s.write("    bl " + handler + "\n");
  s = s.write("    ldr x9, [sp, #168]\n    msr fpsr, x9\n    ldr x30, [sp, #160]\n" + vector_pairs("ldp"));
  return s.write("    add sp, sp, #576\n    eret\n");
}

// The trap frame of __user_run: x0 to x30 at 0, SP_EL0 at 248, the PC at 256,
// PSTATE at 264, TPIDR_EL0 at 272, FPSR at 280, FPCR at 288, and q0 to q31
// at 304, 816 bytes in all. __fern_user_ctx has a slot of 32 bytes for each
// core, at Aff0 of MPIDR_EL1. A slot holds the frame of the running process,
// the stack pointer of the kernel and its DAIF.
function emit_user_run(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .bss\n    .p2align 3\n__fern_user_ctx:\n    .skip 256\n    .text\n");
  // __user_run(frame): save what the kernel's caller expects kept, and the
  // kernel's TPIDR_EL0, FPCR and FPSR, which the frame replaces. Mask the
  // exceptions so that none overwrites ELR_EL1 or SPSR_EL1, and enter EL0.
  s = s.write("__fern_user_run:\n    sub sp, sp, #192\n");
  s = s.write(user_callee_pairs("stp"));
  s = s.write("    mrs x10, tpidr_el0\n    mrs x11, fpcr\n    stp x10, x11, [sp, #160]\n    mrs x10, fpsr\n    str x10, [sp, #176]\n");
  s = s.write(user_ctx_slot("x9", "x10") + "    mrs x10, daif\n    str x10, [x9, #16]\n    msr daifset, #15\n");
  s = s.write("    str x0, [x9]\n    mov x10, sp\n    str x10, [x9, #8]\n");
  s = s.write(user_sysregs("ldr"));
  s = s.write(user_frame_pairs("ldp") + "    ldp x0, x1, [x0, #0]\n    eret\n");
  for k in 0..4 {
    // The exception came from EL0 on SP_EL1, which is the kernel stack below
    // the saved registers. x0 and x1 park there while x0 takes the frame.
    s = s.write("__fern_user_trap_" + util.i32_to_string(k) + ":\n    stp x0, x1, [sp, #-16]!\n");
    s = s.write(user_ctx_slot("x0", "x1") + "    ldr x0, [x0]\n");
    s = s.write(user_frame_pairs("stp") + "    ldp x2, x3, [sp], #16\n    stp x2, x3, [x0, #0]\n");
    s = s.write(user_sysregs("str"));
    s = s.write("    mov x0, #" + util.i32_to_string(k) + "\n    b .Luser_return\n");
  }
  s = s.write(".Luser_return:\n" + user_ctx_slot("x9", "x10") + "    ldr x10, [x9, #8]\n    mov sp, x10\n");
  s = s.write(user_callee_pairs("ldp"));
  s = s.write("    ldp x10, x11, [sp, #160]\n    msr tpidr_el0, x10\n    msr fpcr, x11\n    ldr x10, [sp, #176]\n    msr fpsr, x10\n");
  return s.write("    add sp, sp, #192\n    ldr x10, [x9, #16]\n    msr daif, x10\n    ret\n");
}

// The address of the __fern_user_ctx slot of this core in reg, through tmp.
function user_ctx_slot(reg: string, tmp: string): string {
  let out = "    adrp " + reg + ", __fern_user_ctx\n    add " + reg + ", " + reg + ", :lo12:__fern_user_ctx\n";
  return out + "    mrs " + tmp + ", mpidr_el1\n    and " + tmp + ", " + tmp + ", #7\n    add " + reg + ", " + reg + ", " + tmp + ", lsl #5\n";
}

// The registers that a call keeps: x19 to x30 and d8 to d15.
function user_callee_pairs(op: string): string {
  let out = "";
  for i in 0..6 {
    out = out + "    " + op + " x" + util.i32_to_string(19 + 2 * i) + ", x" + util.i32_to_string(20 + 2 * i) + ", [sp, #" + util.i32_to_string(16 * i) + "]\n";
  }
  for i in 0..4 {
    out = out + "    " + op + " d" + util.i32_to_string(8 + 2 * i) + ", d" + util.i32_to_string(9 + 2 * i) + ", [sp, #" + util.i32_to_string(96 + 16 * i) + "]\n";
  }
  return out;
}

// x2 to x30 and q0 to q31 of the frame in x0. x0 and x1 move on their own.
function user_frame_pairs(op: string): string {
  let out = "";
  for i in 1..15 {
    out = out + "    " + op + " x" + util.i32_to_string(2 * i) + ", x" + util.i32_to_string(2 * i + 1) + ", [x0, #" + util.i32_to_string(16 * i) + "]\n";
  }
  if (op == "ldp") {
    out = out + "    ldr x30, [x0, #240]\n";
  } else {
    out = out + "    str x30, [x0, #240]\n";
  }
  for k in 0..16 {
    out = out + "    " + op + " q" + util.i32_to_string(2 * k) + ", q" + util.i32_to_string(2 * k + 1) + ", [x0, #" + util.i32_to_string(304 + 32 * k) + "]\n";
  }
  return out;
}

// The user system registers of the frame in x0, through x1. A load writes
// each register from the frame; a store reads it into the frame.
function user_sysregs(op: string): string {
  let regs = ["sp_el0", "elr_el1", "spsr_el1", "tpidr_el0", "fpsr", "fpcr"];
  let out = "";
  for i in 0..regs.len() {
    let at = util.i32_to_string(248 + 8 * i);
    if (op == "ldr") {
      out = out + "    ldr x1, [x0, #" + at + "]\n    msr " + regs[i] + ", x1\n";
    } else {
      out = out + "    mrs x1, " + regs[i] + "\n    str x1, [x0, #" + at + "]\n";
    }
  }
  return out;
}

function vector_pairs(op: string): string {
  let out = "";
  for i in 0..9 {
    out = out + "    " + op + " x" + util.i32_to_string(2 * i) + ", x" + util.i32_to_string(2 * i + 1) + ", [sp, #" + util.i32_to_string(16 * i) + "]\n";
  }
  out = out + "    " + op + " x18, x29, [sp, #144]\n";
  let q = [0, 2, 4, 6, 16, 18, 20, 22, 24, 26, 28, 30];
  for k in 0..q.len() {
    out = out + "    " + op + " q" + util.i32_to_string(q[k]) + ", q" + util.i32_to_string(q[k] + 1) + ", [sp, #" + util.i32_to_string(176 + 32 * k) + "]\n";
  }
  return out;
}

function reset_table_name(level: i32, address: i64): string {
  return "__fern_reset_table_" + util.i32_to_string(level) + "_" + util.i64_to_string(address);
}

// Only the two RAM boundaries need finer tables. L0 plus two L1 tables and
// at most two tables at each lower level occupy at most seven pages.
function emit_reset_table(s: asmcore.EmitState, level: i32, address: i64, span: i64): asmcore.EmitState {
  let ram_end = s.ram_base + s.ram_size;
  s = s.write("    .p2align 12\n" + reset_table_name(level, address) + ":\n");
  for i in 0..512 {
    let start = address + i as i64 * span;
    let end = start + span;
    if (start >= 1099511627776i64) {
      s = s.write("    .quad 0\n");
    } else if (level == 0 || level < 3 && start < ram_end && end > s.ram_base && (start < s.ram_base || end > ram_end)) {
      s = s.write("    .quad " + reset_table_name(level + 1, start) + " + 3\n");
    } else {
      // AF, privileged RW, Normal-NC inner-shareable or Device-nGnRnE XN.
      let flags = 0x60000000000401i64;
      if (start >= s.ram_base && end <= ram_end) {
        flags = 0x40000000000705i64;
      }
      if (level == 3) {
        flags |= 2i64;
      }
      s = s.write("    .quad " + util.i64_to_string(start | flags) + "\n");
    }
  }
  if (level < 3) {
    for i in 0..512 {
      let start = address + i as i64 * span;
      let end = start + span;
      if (start < 1099511627776i64 && (level == 0 || start < ram_end && end > s.ram_base && (start < s.ram_base || end > ram_end))) {
        s = emit_reset_table(s, level + 1, start, span / 512i64);
      }
    }
  }
  return s;
}

function emit_reset_mmu(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .data\n");
  s = emit_reset_table(s, 0, 0i64, 549755813888i64);
  s = s.write("    .text\n");
  let root = reset_table_name(0, 0i64);
  return s.write(mmu_on("    adrp x9, " + root + "\n    add x9, x9, :lo12:" + root + "\n"));
}

// Turns on the translation of the root table that load_root puts in x9.
// MAIR: index 0 Device-nGnRnE, index 1 Normal-NC. TCR: 40-bit VA/PA, 4K
// granule, inner-shareable NC walks, TTBR1 disabled.
function mmu_on(load_root: string): string {
  let out = "    mov x9, #17408\n    msr mair_el1, x9\n";
  out += mov_imm64("x9", 0x280983018i64) + "    msr tcr_el1, x9\n";
  out += load_root + "    msr ttbr0_el1, x9\n    dsb sy\n    tlbi vmalle1\n    dsb sy\n    isb\n";
  return out + "    mrs x9, sctlr_el1\n    and x9, x9, #-3\n    and x9, x9, #-5\n    and x9, x9, #-524289\n    orr x9, x9, #1\n    msr sctlr_el1, x9\n    isb\n";
}

// The entry where PSCI CPU_ON starts another core, at EL1 with the MMU off and
// the context id in x0. Each core takes a stack of 64 KiB by the Aff0 of its
// MPIDR_EL1, of 1 to 7. It turns on the translation that __secondary_entry
// recorded, and calls the `@secondary` entry with the context id.
function emit_secondary_start(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .bss\n    .p2align 4\n__fern_secondary_stacks:\n    .skip 524288\n    .data\n    .p2align 3\n__fern_secondary_ttbr0:\n    .quad 0\n    .text\n");
  s = s.write("__fern_secondary_start:\n    msr daifset, #15\n    mov x19, x0\n    mrs x9, mpidr_el1\n    and x9, x9, #7\n    lsl x9, x9, #16\n");
  s = s.write("    adrp x10, __fern_secondary_stacks\n    add x10, x10, :lo12:__fern_secondary_stacks\n    add x10, x10, x9\n    mov sp, x10\n");
  s = s.write("    movz x9, #48, lsl #16\n    msr cpacr_el1, x9\n    isb\n");
  if (s.interrupts.len() > 0 || s.user_mode) {
    s = s.write("    adrp x9, __fern_vectors\n    add x9, x9, :lo12:__fern_vectors\n    msr vbar_el1, x9\n    isb\n");
  }
  s = s.write(mmu_on("    adrp x9, __fern_secondary_ttbr0\n    ldr x9, [x9, :lo12:__fern_secondary_ttbr0]\n"));
  if (s.secondary.len() > 0) {
    s = s.write("    sub sp, sp, #16\n    str x19, [sp]\n    bl " + s.secondary + "\n    add sp, sp, #16\n");
  }
  return s.write(".Lsecondary_park:\n    wfe\n    b .Lsecondary_park\n");
}

function rt_arm64_str_eq(): string {
  let s = "__fn___fern_str_eq:\n";
  s += "    ldr x0, [sp]\n    ldr x9, [sp, #16]\n";
  s += "__fn___fern_str_eq.r:\n";
  s += "    cmp x0, x9\n    b.eq .Lseq_yes\n";
  s += "    ldr x4, [x0, #8]\n    ldr x5, [x9, #8]\n    cmp x4, x5\n    b.ne .Lseq_no\n";
  s += "    ldr x2, [x0]\n    ldr x3, [x9]\n";
  s += "    cmp x2, x3\n    b.eq .Lseq_yes\n";
  s += "    add x6, x2, x4\n    add x7, x3, x4\n";
  s += "    cmp x4, #8\n    b.lo .Lseq_short\n";
  s += "    sub x6, x6, #8\n    sub x7, x7, #8\n";
  s += ".Lseq_word:\n";
  s += "    ldr x0, [x2]\n    ldr x1, [x3]\n    cmp x0, x1\n    b.ne .Lseq_no\n";
  s += "    add x2, x2, #8\n    add x3, x3, #8\n";
  s += "    cmp x2, x6\n    b.lo .Lseq_word\n";
  s += "    ldr x0, [x6]\n    ldr x1, [x7]\n    cmp x0, x1\n    b.ne .Lseq_no\n";
  s += "    b .Lseq_yes\n";
  s += ".Lseq_short:\n";
  s += "    cbz x4, .Lseq_yes\n";
  s += "    cmp x4, #4\n    b.lo .Lseq_byte\n";
  s += "    ldr w0, [x2]\n    ldr w1, [x3]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
  s += "    sub x6, x6, #4\n    sub x7, x7, #4\n";
  s += "    ldr w0, [x6]\n    ldr w1, [x7]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
  s += "    b .Lseq_yes\n";
  s += ".Lseq_byte:\n";
  s += "    ldrb w0, [x2]\n    ldrb w1, [x3]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
  s += "    sub x6, x6, #1\n    sub x7, x7, #1\n";
  s += "    ldrb w0, [x6]\n    ldrb w1, [x7]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
  s += "    cmp x4, #3\n    b.lo .Lseq_yes\n";
  s += "    ldrb w0, [x2, #1]\n    ldrb w1, [x3, #1]\n    cmp w0, w1\n    b.ne .Lseq_no\n";
  s += ".Lseq_yes:\n    mov x0, #1\n    ret\n";
  s += ".Lseq_no:\n    mov x0, #0\n    ret\n";
  s += ".size __fn___fern_str_eq, .-__fn___fern_str_eq\n";
  return s;
}

function emit_named_bodies(cache: irtables.LowerResult[], physical: physicalbody.Collection, pre: asmcore.Prelift[], from: i32, s: asmcore.EmitState, vgate: irverifygate.Gate): asmcore.EmitState {
  let xi = from;
  while (xi < cache.len()) {
    if (!s.has_named(cache[xi].name)) {
      s = emit_function_via_ir_named(cache[xi], physicalbody.select(physical, xi), s.prelift(pre, xi, cache[xi]), cache[xi].name, true, s, vgate).with_named(cache[xi].name);
    }
    xi += 1;
  }
  return s;
}

function emit_array_helpers(s: asmcore.EmitState): asmcore.EmitState {
  let byte_copy = s.byte_copy_roots();
  if (byte_copy != "") {
    s = emit_runtime(byte_copy, s);
  }
  if (s.has_need("arr_str_join")) {
    s = emit_runtime("__fern_arr_str_join", s);
  }
  if (s.has_need("arr_concat")) {
    s = emit_runtime("__fern_arr_concat", s);
  }
  if (s.has_need("bytes_owned")) {
    s = emit_runtime("__fern_bytes_owned", s);
  }
  if (s.has_need("bytes_range")) {
    s = emit_runtime("__fern_bytes_range", s);
  }
  if (s.has_need("bytes_into")) {
    s = emit_runtime("__fern_bytes_into", s);
  }
  return s;
}

function emit_arm64_quarantine_data(s: asmcore.EmitState): asmcore.EmitState {
  if (s.rc_free_debug) {
    s = s.write("__fern_quar_head: .quad 0\n    .align 3\n__fern_quar_tail: .quad 0\n    .align 3\n__fern_quar_bytes: .quad 0\n    .align 3\n");
    if (s.has_need("worker_regions")) {
      s = s.write("__fern_forget_lo: .quad 0\n    .align 3\n__fern_forget_hi: .quad 0\n    .align 3\n");
    }
  }
  return s;
}

function emit_runtime(roots: string, s: asmcore.EmitState): asmcore.EmitState {
  let at = s.runtime_units.roots.find(roots);
  if (at >= 0) {
    return emit_runtime_module(s.runtime_units.mods[at], s.runtime_units.lowered[at], s);
  }
  let m = rtmodule.load(asmcore.runtime_files(s, s.runtime_target), roots);
  let lowered = s.rt_lower(m);
  return emit_runtime_module(m, lowered, asmcore.with_runtime_unit(s, roots, m, lowered));
}

pub function emit_runtime_module(m: parser.Module, lowered: physicalbody.Lowered, s: asmcore.EmitState): asmcore.EmitState {
  let fns = m.funcs;
  asmcore.refuse_runtime_name(s, fns);
  let bodies = irtables.lowered_results(lowered.bodies);
  let physical = physicalbody.collection(lowered);
  let previous_regs = s.reg_entries;
  let previous_leaves = s.leaves;
  let previous_float = asmcore.FloatAbi { names: s.float_abi, masks: s.float_abi_masks };
  let cf0 = s.cfi_stubs.len();
  let unit = asmcore.unit_leaves(m, 0, fns.len(), bodies, s.kinds);
  let fabi = asmcore.unit_float_abi(m, 0, fns.len(), bodies);
  s = asmcore.EmitState { ...s, reg_entries: irtables.sig_reg_of(asmcore.unit_labels(m, 0, fns.len(), bodies)), leaves: unit.leaves, float_abi: fabi.names, float_abi_masks: fabi.masks };
  let vgate = irverifygate.with_memo(irverifygate.gate_unreported(irtables.fn_sig_index(fns, m.funcs, bodies), s.kinds, physicalbody.abis(physical)), s.memo);
  s = asmcore.export_runtime_fns(s, fns);
  let i = 0;
  while (i < fns.len()) {
    if (!s.has_named(fns[i].name)) {
      s = emit_function_via_ir_pre(bodies[i], physicalbody.select(physical, i), s.prelift(unit.pre, i, bodies[i]), fns[i], s, vgate);
      s = s.with_named(fns[i].name);
    }
    i += 1;
  }
  s = emit_named_bodies(bodies, physical, unit.pre, fns.len(), s, vgate);
  s = emit_cfi_stubs_from(s, cf0);
  return asmcore.EmitState { ...s, reg_entries: previous_regs, leaves: previous_leaves, float_abi: previous_float.names, float_abi_masks: previous_float.masks };
}

function emit_ccall_shim1_arm64(s: asmcore.EmitState, variant: string, n: i32): asmcore.EmitState {
  s = s.write("\n__fn_" + variant + ":\n");
  s = s.write(rt_frame(s) + "    mov x29, sp\n");
  s = s.write("    ldr x9, [x29, #16]\n");
  for i in 0..n {
    s = s.write("    ldr x" + util.i32_to_string(i) + ", [x29, #" + util.i32_to_string(32 + 16 * i) + "]\n");
  }
  if (s.shared) {
    s = s.write(busy_give_arm64());
  }
  s = s.write("    blr x9\n");
  if (s.shared) {
    s = s.write(busy_take_arm64());
  }
  if (variant.ends_with("_f32")) {
    s = s.write("    fcvt d0, s0\n");
  }
  if (variant.ends_with("_f32") || variant.ends_with("_f64")) {
    s = s.write("    fmov x0, d0\n");
  }
  s = s.write(rt_unframe(s) + "    ret\n");
  return s;
}

// The arm64 form of emit_ccallv_shim: the eight integer argument registers
// from `ints` and the eight vector argument registers from `floats`, as
// AAPCS64 assigns them.
function emit_ccallv_shim_arm64(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("\n__fn___c_callv:\n" + rt_frame(s) + "    mov x29, sp\n");
  s = s.write("    ldr x9, [x29, #16]\n    ldr x10, [x29, #32]\n    ldr x11, [x29, #48]\n");
  for i in 0..4 {
    let off = util.i32_to_string(16 * i);
    s = s.write("    ldp x" + util.i32_to_string(2 * i) + ", x" + util.i32_to_string(2 * i + 1) + ", [x10, #" + off + "]\n");
    s = s.write("    ldp d" + util.i32_to_string(2 * i) + ", d" + util.i32_to_string(2 * i + 1) + ", [x11, #" + off + "]\n");
  }
  // Integers 8 to 15 go on the stack, in the order of the arguments.
  s = s.write("    sub sp, sp, #64\n");
  for i in 0..4 {
    let off = util.i32_to_string(16 * i);
    s = s.write("    ldp x12, x13, [x10, #" + util.i32_to_string(64 + 16 * i) + "]\n    stp x12, x13, [sp, #" + off + "]\n");
  }
  if (s.shared) {
    s = s.write(busy_give_arm64());
  }
  s = s.write("    blr x9\n");
  if (s.shared) {
    s = s.write(busy_take_arm64());
  }
  s = s.write("    ldr x10, [x29, #64]\n    cmp w10, #1\n    b.ne .Lfern_ccallv_f64\n    fmov w0, s0\n    b .Lfern_ccallv_done\n");
  s = s.write(".Lfern_ccallv_f64:\n    cmp w10, #2\n    b.ne .Lfern_ccallv_done\n    fmov x0, d0\n");
  return s.write(".Lfern_ccallv_done:\n    mov sp, x29\n" + rt_unframe(s) + "    ret\n");
}

pub function busy_take_arm64(): string {
  return "    bl __fern_busy_take\n";
}

pub function busy_give_arm64(): string {
  return "    bl __fern_busy_give\n";
}

// The arm64 form of emit_busy_lock_x86. Both routines keep every register
// except x16, x17 and the flags.
// A shared object has no _start. The loader calls each entry of
// .init_array with argc, argv and envp, so this entry keeps them.
function emit_shared_init_arm64(s: asmcore.EmitState): asmcore.EmitState {
  let args: boolean = s.has_need("args");
  let env: boolean = s.has_need("heap");
  if (!args && !env) {
    return s;
  }
  s = s.write("__fern_shared_init:\n");
  s = ssa_landing_pad(s);
  if (args) {
    s = s.write("    sxtw x0, w0\n    adrp x3, __fern_argc\n    add x3, x3, :lo12:__fern_argc\n    str x0, [x3]\n");
    s = s.write("    adrp x3, __fern_argv\n    add x3, x3, :lo12:__fern_argv\n    str x1, [x3]\n");
  }
  if (env) {
    s = s.write("    adrp x3, __fern_envp\n    add x3, x3, :lo12:__fern_envp\n    str x2, [x3]\n");
  }
  return s.write("    ret\n    .section .data\n    .align 3\n__fern_init_array:\n    .quad __fern_shared_init\n    .text\n");
}

function emit_busy_lock_arm64(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .bss\n    .align 3\n__fern_busy: .skip 8\n    .text\n");
  s = s.write("__fern_busy_take:\n    adrp x16, __fern_busy\n    add x16, x16, :lo12:__fern_busy\n    mov w17, #1\n    swpal w17, w17, [x16]\n    cbnz w17, .Lfern_busy_wait\n    ret\n");
  s = s.write(".Lfern_busy_wait:\n    stp x0, x1, [sp, #-16]!\n    stp x2, x3, [sp, #-16]!\n    str x8, [sp, #-16]!\n");
  s = s.write(".Lfern_busy_retry:\n    mov w17, #2\n    swpal w17, w17, [x16]\n    cbz w17, .Lfern_busy_won\n");
  s = s.write("    mov x0, x16\n    mov x1, #128\n    mov x2, #2\n    mov x3, #0\n    mov x8, #98\n").svc(98);
  s = s.write("    b .Lfern_busy_retry\n");
  s = s.write(".Lfern_busy_won:\n    ldr x8, [sp], #16\n    ldp x2, x3, [sp], #16\n    ldp x0, x1, [sp], #16\n    ret\n");
  s = s.write("__fern_busy_give:\n    adrp x16, __fern_busy\n    add x16, x16, :lo12:__fern_busy\n    swpal wzr, w17, [x16]\n    cmp w17, #2\n    b.eq .Lfern_busy_wake\n    ret\n");
  s = s.write(".Lfern_busy_wake:\n    stp x0, x1, [sp, #-16]!\n    stp x2, x8, [sp, #-16]!\n");
  s = s.write("    mov x0, x16\n    mov x1, #129\n    mov x2, #1\n    mov x8, #98\n").svc(98);
  return s.write("    ldp x2, x8, [sp], #16\n    ldp x0, x1, [sp], #16\n    ret\n");
}

function emit_ccall_shims_arm64(s: asmcore.EmitState): asmcore.EmitState {
  let ca = 0;
  while (ca <= 6) {
    let cbase = "__c_call" + util.i32_to_string(ca);
    if (s.has_need("ccall:" + cbase)) {
      s = emit_ccall_shim1_arm64(s, cbase, ca);
    }
    if (s.has_need("ccall:" + cbase + "_f32")) {
      s = emit_ccall_shim1_arm64(s, cbase + "_f32", ca);
    }
    if (s.has_need("ccall:" + cbase + "_f64")) {
      s = emit_ccall_shim1_arm64(s, cbase + "_f64", ca);
    }
    ca += 1;
  }
  if (s.has_need("ccall:__c_callv")) {
    s = emit_ccallv_shim_arm64(s);
  }
  return s;
}

pub function emit_rodata_pools_arm64(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  s = asmcore.emit_debug_rows(s);
  if (s.string_lits.len() > 0) {
    s = s.write("    .section .rodata\n");
    let li = 0;
    while (li < s.string_lits.len()) {
      s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
      li += 1;
    }
  }
  let reloc = reloc_wanted(s, darwin);
  if (reloc) {
    s = s.write("    .section .data\n    .balign 8\n");
    s = s.write(".Lfern_relanchor:\n    .quad .Lfern_relanchor\n");
  }
  let cds = asmcore.const_data_section(s);
  if (reloc) {
    s = s.write(cds + "    .balign 8\n.Lfern_sbox_begin:\n");
  }
  if (s.string_lits.len() > 0) {
    s = asmcore.emit_str_box_data_from(s, 0);
  }
  if (reloc) {
    s = s.write(".Lfern_sbox_end:\n");
  }
  if (reloc) {
    s = asmcore.emit_const_agg_blocks(s, 0, 1);
    s = s.write(cds + "    .balign 8\n.Lfern_cagg_begin:\n");
    s = asmcore.emit_const_agg_blocks(s, 0, 2);
    s = s.write(".Lfern_cagg_end:\n");
    s = s.write("    .balign 8\n.Lfern_cfn_begin:\n");
    s = asmcore.emit_const_agg_blocks(s, 0, 3);
    s = s.write(".Lfern_cfn_end:\n");
    s = s.write("    .balign 8\n.Lfern_cref_begin:\n");
    s = asmcore.emit_const_agg_refs(s);
    s = s.write(".Lfern_cref_end:\n");
  } else {
    s = asmcore.emit_const_agg_data(s);
  }
  s = asmcore.emit_shape_lits_from(s, 0);
  s = asmcore.emit_shuffle_masks(s);
  s = s.write("    .text\n");
  return s;
}

function emit_rt_clock_and_print(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  if (!darwin && asmcore.vdso_wanted(s, "arm64-linux")) {
    s = s.need("ccall:__c_call2").need("vdso");
  }
  s = emit_ccall_shims_arm64(s);
  let ctgt = rt_key(darwin);
  if (s.any_need([
    "monotonic_ns", "now_unix_ms", "now_ns", "stat", "lstat", "dir_stat",
    "read_file", "read_file_bytes", "read_file_bytes_u8", "random_i32", "sleep_ms",
    "sleep_ns", "set_file_times", "writer_set_times", "statfs", "poll", "proc_waitpid",
    "proc_waitpid_nohang", "proc_waitpid_status", "disable_core_dumps", "worker_region", "worker_exit", "worker_unmap",
    "timer_fd", "tcp_listen", "tcp_local_port", "putchar",
    "udp_sendto_bytes", "udp_sendto_bytes_u8", "udp_sendmmsg", "udp_sendmmsg_u8", "udp_recvmmsg", "udp_recvmmsg_u8",
    "eprint", "tcp_listen_with", "tcp_socket_ctl", "udp_bind", "udp_bind_with", "udp_connect", "udp_sendto", "udp_recvfrom", "tcp_connect_with", "unix_listen", "unix_connect", "reactor_new", "reactor_ctl", "reactor_wait", "ring_new", "ring_ctl", "ring_wait", "ring_recv_u8", "ring_send_zc_u8", "tcp_recv_into", "tcp_ktls_u8", "tcp_sendfile",
    "tcp_listen_with_u8", "udp_bind_u8", "udp_bind_with_u8", "udp_connect_u8", "udp_sendto_u8", "udp_recvfrom_u8", "tcp_connect_with_u8", "tcp_addr_into_u8",
    "isatty", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc", "pipe",
    "rlimit_nofile", "signal_ignore", "signal_default", "signal_catch", "signal_mask",
    "signal_disposition", "access",
    "geteuid", "getegid", "getuid", "getgid", "getgroups", "environ",
    "fd_stat", "raw_scratch", "fd_fsync", "fd_fdatasync", "fd_syncfs", "fd_drop_cache", "sync",
    "clock_resolution", "clock_set", "ct_mark",
  ])) {
    let minimum = 256;
    if (darwin && s.any_need(["hostname", "uname_field"])) {
      minimum = 400;
    }
    s = s.write("    .section .bss\n    .align 8\n__fern_scratch: .skip " + asmcore.scratch_size(ctgt, s.has_need("statfs"), minimum) + "\n    .section .text\n");
  }
  if (!darwin && s.any_need(["reader_splice", "raw_splice_pipe"])) {
    s = s.write("    .section .bss\n    .p2align 3\n__fern_splice_pipe: .quad 0, 0\n    .text\n");
  }
  if (s.has_need("raw_cover")) {
    s = s.write("    .section .bss\n    .p2align 3\n__fern_cov_counters: .quad 0\n    .text\n");
  }
  if (s.has_need("task")) {
    s = s.write("    .section .bss\n    .p2align 3\n__fern_task_state: .quad 0, 0, 0, 0, 0, 0, 0\n    .text\n");
  }
  if (s.has_need("str_print")) {
    s = emit_log_write("__fern_print_str", s);
  }
  if (s.has_need("putchar")) {
    s = emit_runtime("__fern_putchar", s);
  }
  if (s.has_need("eprint")) {
    s = emit_log_write("__fern_eprint_str", s);
  }
  return emit_rt_clocks(s, darwin, ctgt);
}

// A string write for print or eprint. With a `log` provider it passes the bytes
// and the length to the provider, and returns the length.
function emit_log_write(name: string, s: asmcore.EmitState): asmcore.EmitState {
  if (s.log_provider.len() == 0) {
    return emit_runtime(name, s);
  }
  s = s.write("\n__fn_" + name + ":\n    ldr x0, [sp, #0]\n__fn_" + name + ".r:\n" + rt_frame_of(s, 32) + "    mov x29, sp\n");
  s = s.write("    ldr x9, [x0, #0]\n    ldr x10, [x0, #8]\n    sxtw x10, w10\n    str x10, [x29, #16]\n");
  s = s.write("    sub sp, sp, #32\n    str x9, [sp, #0]\n    str x10, [sp, #16]\n    bl " + s.log_provider + "\n    add sp, sp, #32\n");
  return s.write("    ldr x0, [x29, #16]\n" + rt_unframe_of(s, 32) + "    ret\n");
}

function emit_rt_clocks(s: asmcore.EmitState, darwin: boolean, ctgt: string): asmcore.EmitState {
  if (s.has_need("now_unix_ms")) {
    s = emit_runtime("__fern_now_unix_ms", s);
  }
  if (s.has_need("now_ns")) {
    s = emit_runtime("__fern_now_ns", s);
  }
  if (s.has_need("monotonic_ns")) {
    if (darwin) {
      s = s.write("__fn___fern_monotonic_ns:\n");
      s = s.write(rt_frame(s));
      s = s.write("    mov x29, sp\n");
      s = s.write("    mrs x9, cntvct_el0\n");
      s = s.write("    mrs x10, cntfrq_el0\n");
      s = s.write("    udiv x11, x9, x10\n");
      s = s.write("    msub x12, x11, x10, x9\n");
      s = s.write("    ldr x13, =1000000000\n");
      s = s.write("    mul x11, x11, x13\n");
      s = s.write("    mul x12, x12, x13\n");
      s = s.write("    udiv x12, x12, x10\n");
      s = s.write("    add x0, x11, x12\n");
      s = s.write(rt_unframe(s));
      s = s.write("    ret\n");
    } else {
      s = emit_runtime("__fern_monotonic_ns", s);
    }
  }
  if (!darwin && s.has_need("vdso")) {
    s = s.write("    .section .bss\n    .p2align 3\n__fern_vdso: .quad 0, 0\n    .text\n");
    s = emit_runtime("__fern_vdso_clock __fern_vdso_find", s);
  }
  return s;
}

function emit_rt_io_and_string(s: asmcore.EmitState): asmcore.EmitState {
  if (s.has_need("str_concat")) {
    s = emit_runtime("__fern_str_concat", s);
  }
  if (s.has_need("str_eq")) {
    s = s.write(rt_arm64_str_eq());
  }
  if (s.has_need("str_cmp")) {
    s = emit_runtime("__fern_str_cmp", s);
  }
  if (s.has_need("i32_to_string")) {
    s = emit_runtime("__fern_i32_to_string", s);
  }
  if (s.has_need("u32_to_string")) {
    s = emit_runtime("__fern_u32_to_string", s);
  }
  if (s.has_need("i64_to_string")) {
    s = emit_runtime("__fern_i64_to_string", s);
  }
  if (s.has_need("u64_to_string")) {
    s = emit_runtime("__fern_u64_to_string", s);
  }
  if (s.has_need("str_case")) {
    s = emit_runtime("__fern_str_to_upper", s);
    s = emit_runtime("__fern_str_to_lower", s);
  }
  if (s.has_need("str_repeat")) {
    s = emit_runtime("__fern_str_repeat", s);
  }
  return s;
}

function emit_lc_report(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  s = s.write("    .bss\n");
  s = s.write("    .align 3\n");
  s = s.write("__fern_lc_alloc_count: .quad 0\n");
  s = s.write("__fern_lc_alloc_bytes: .quad 0\n");
  s = s.write("__fern_lc_rt_req: .quad 0\n");
  s = s.write("__fern_lc_free_count: .quad 0\n");
  s = s.write("__fern_lc_free_bytes: .quad 0\n");
  s = s.write("__fern_lc_exited: .quad 0\n");
  if (s.has_need("heap_adopt")) {
    s = s.write("__fern_lc_adopt_lo: .quad 0\n");
    s = s.write("__fern_lc_adopt_hi: .quad 0\n");
  }
  s = s.write("    .section .rodata\n");
  s = s.write(".Llc_a:\n    .ascii \"leakcheck: allocs=\"\n");
  s = s.write(".Llc_f:\n    .ascii \" frees=\"\n");
  s = s.write(".Llc_l:\n    .ascii \" live_bytes=\"\n");
  s = s.write(".Llc_x:\n    .ascii \" from=exit\"\n");
  s = s.write(".Llc_nl:\n    .ascii \"\\n\"\n");
  if (s.sanitize) {
    s = s.write(".Lsan_leak:\n    .ascii \"fern-sanitizer: leak \"\n");
    s = s.write(".Lsan_bytesin:\n    .ascii \" bytes in \"\n");
    s = s.write(".Lsan_blocks:\n    .ascii \" blocks\"\n");
  }
  s = s.write("    .text\n");
  s = s.write("    .globl __fern_lc_report_exit\n");
  s = s.write("__fern_lc_report_exit:\n");
  s = s.write("    adrp x9, __fern_lc_exited\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_exited\n");
  s = s.write("    mov x10, #1\n");
  s = s.write("    str x10, [x9]\n");
  s = s.write("    .globl __fern_lc_report\n");
  s = s.write("__fern_lc_report:\n");
  s = s.write(rt_frame(s));
  s = s.write("    mov x29, sp\n");
  if (s.has_need("set_args")) {
    s = s.write("    adrp x9, __fern_args_set\n");
    s = s.write("    add x9, x9, :lo12:__fern_args_set\n");
    s = s.write("    ldr x0, [x9]\n");
    s = s.write("    cbz x0, .Llc_args_done\n");
    s = s.write("    str xzr, [x9]\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_str_arr_free\n");
    s = s.write("    add sp, sp, #16\n");
    s = s.write(".Llc_args_done:\n");
  }
  s = quar_scan_at_exit(s);
  s = s.write("    adrp x1, .Llc_a\n");
  s = s.write("    add x1, x1, :lo12:.Llc_a\n");
  s = s.write("    mov x2, #18\n");
  s = s.write("    bl .Llc_write\n");
  s = s.write("    adrp x9, __fern_lc_alloc_count\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_count\n");
  s = s.write("    ldr x0, [x9]\n");
  s = s.write("    bl .Llc_wrnum\n");
  s = s.write("    adrp x1, .Llc_f\n");
  s = s.write("    add x1, x1, :lo12:.Llc_f\n");
  s = s.write("    mov x2, #7\n");
  s = s.write("    bl .Llc_write\n");
  s = s.write("    adrp x9, __fern_lc_free_count\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_free_count\n");
  s = s.write("    ldr x0, [x9]\n");
  s = s.write("    bl .Llc_wrnum\n");
  s = s.write("    adrp x1, .Llc_l\n");
  s = s.write("    add x1, x1, :lo12:.Llc_l\n");
  s = s.write("    mov x2, #12\n");
  s = s.write("    bl .Llc_write\n");
  s = s.write("    adrp x9, __fern_lc_alloc_bytes\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_bytes\n");
  s = s.write("    ldr x0, [x9]\n");
  s = s.write("    adrp x9, __fern_lc_free_bytes\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_free_bytes\n");
  s = s.write("    ldr x1, [x9]\n");
  s = s.write("    sub x0, x0, x1\n");
  s = s.write("    bl .Llc_wrnum\n");
  s = s.write("    adrp x9, __fern_lc_exited\n");
  s = s.write("    add x9, x9, :lo12:__fern_lc_exited\n");
  s = s.write("    ldr x0, [x9]\n");
  s = s.write("    cbz x0, .Llc_from_done\n");
  s = s.write("    adrp x1, .Llc_x\n");
  s = s.write("    add x1, x1, :lo12:.Llc_x\n");
  s = s.write("    mov x2, #10\n");
  s = s.write("    bl .Llc_write\n");
  s = s.write(".Llc_from_done:\n");
  s = s.write("    adrp x1, .Llc_nl\n");
  s = s.write("    add x1, x1, :lo12:.Llc_nl\n");
  s = s.write("    mov x2, #1\n");
  s = s.write("    bl .Llc_write\n");
  if (s.sanitize) {
    s = s.write("    adrp x9, __fern_lc_alloc_bytes\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_bytes\n");
    s = s.write("    ldr x10, [x9]\n");
    s = s.write("    adrp x9, __fern_lc_free_bytes\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_free_bytes\n");
    s = s.write("    ldr x9, [x9]\n");
    s = s.write("    subs x10, x10, x9\n");
    s = s.write("    b.le .Lsan_leak_done\n");
    s = s.write("    adrp x1, .Lsan_leak\n");
    s = s.write("    add x1, x1, :lo12:.Lsan_leak\n");
    s = s.write("    mov x2, #21\n");
    s = s.write("    bl .Llc_write\n");
    s = s.write("    mov x0, x10\n");
    s = s.write("    bl .Llc_wrnum\n");
    s = s.write("    adrp x1, .Lsan_bytesin\n");
    s = s.write("    add x1, x1, :lo12:.Lsan_bytesin\n");
    s = s.write("    mov x2, #10\n");
    s = s.write("    bl .Llc_write\n");
    s = s.write("    adrp x9, __fern_lc_alloc_count\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_alloc_count\n");
    s = s.write("    ldr x0, [x9]\n");
    s = s.write("    adrp x9, __fern_lc_free_count\n");
    s = s.write("    add x9, x9, :lo12:__fern_lc_free_count\n");
    s = s.write("    ldr x9, [x9]\n");
    s = s.write("    sub x0, x0, x9\n");
    s = s.write("    bl .Llc_wrnum\n");
    s = s.write("    adrp x1, .Lsan_blocks\n");
    s = s.write("    add x1, x1, :lo12:.Lsan_blocks\n");
    s = s.write("    mov x2, #7\n");
    s = s.write("    bl .Llc_write\n");
    s = s.write("    adrp x1, .Llc_nl\n");
    s = s.write("    add x1, x1, :lo12:.Llc_nl\n");
    s = s.write("    mov x2, #1\n");
    s = s.write("    bl .Llc_write\n");
    s = s.write(".Lsan_leak_done:\n");
  }
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  s = emit_lc_write(s);
  s = s.write(".Llc_wrnum:\n");
  s = s.write("    sub sp, sp, #48\n");
  s = s.write("    str x30, [sp]\n");
  s = s.write("    add x3, sp, #32\n");
  s = s.write("    mov x4, #10\n");
  s = s.write("    mov x5, #0\n");
  s = s.write("    cmp x0, #0\n");
  s = s.write("    b.ge .Llc_wrnum_loop\n");
  s = s.write("    neg x0, x0\n");
  s = s.write("    mov x5, #1\n");
  s = s.write(".Llc_wrnum_loop:\n");
  s = s.write("    udiv x6, x0, x4\n");
  s = s.write("    msub x7, x6, x4, x0\n");
  s = s.write("    add x7, x7, #48\n");
  s = s.write("    sub x3, x3, #1\n");
  s = s.write("    strb w7, [x3]\n");
  s = s.write("    mov x0, x6\n");
  s = s.write("    cbnz x0, .Llc_wrnum_loop\n");
  s = s.write("    cbz x5, .Llc_wrnum_emit\n");
  s = s.write("    mov x7, #45\n");
  s = s.write("    sub x3, x3, #1\n");
  s = s.write("    strb w7, [x3]\n");
  s = s.write(".Llc_wrnum_emit:\n");
  s = s.write("    add x2, sp, #32\n");
  s = s.write("    sub x2, x2, x3\n");
  s = s.write("    mov x1, x3\n");
  s = s.write("    bl .Llc_write\n");
  s = s.write("    ldr x30, [sp]\n");
  s = s.write("    add sp, sp, #48\n");
  s = s.write("    ret\n");
  return s;
}

// .Llc_write writes the x2 bytes at x1 to stderr, or to the `log` provider on
// a target without a host. The provider is a Fern function, so the stub keeps
// x10, which the sanitizer's leak line holds across a write.
function emit_lc_write(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(".Llc_write:\n");
  if (s.log_provider.len() == 0) {
    s = s.write("    mov x0, #2\n");
    s = s.write("    mov x8, #64\n");
    s = s.svc(64);
    return s.write("    ret\n");
  }
  s = s.write("    stp x29, x30, [sp, #-16]!\n    stp x10, x11, [sp, #-16]!\n    mov x29, sp\n");
  s = s.write("    sub sp, sp, #32\n    str x1, [sp, #0]\n    str x2, [sp, #16]\n    bl " + s.log_provider + "\n    add sp, sp, #32\n");
  return s.write("    ldp x10, x11, [sp], #16\n    ldp x29, x30, [sp], #16\n    ret\n");
}

function rc_poison(): i32 {
  return 2129525454;
}

// Runs `body` on each payload word of the block at x0, words 3 to x1 - 1,
// with the address in x10, which `body` advances, and the poison pattern,
// the poison word twice, in x9.
function quar_payload(s: asmcore.EmitState, name: string, body: string): asmcore.EmitState {
  s = s.write(rc_poison_into("w9") + "    orr x9, x9, x9, lsl #32\n    add x10, x0, #24\n    sub x11, x1, #3\n");
  s = s.write("    cbz x11, .Lquar_" + name + "_done\n.Lquar_" + name + ":\n" + body);
  return s.write("    subs x11, x11, #1\n    b.ne .Lquar_" + name + "\n.Lquar_" + name + "_done:\n");
}

// At exit every block still in the quarantine gets the eviction's check, so
// a write after free is reported whether or not the budget evicted it.
function quar_scan_at_exit(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.rc_free_debug || !s.has_need("heap")) {
    return s;
  }
  s = s.write(quar_addr("x12", "__fern_quar_head") + "    ldr x0, [x12]\n.Lquar_end_loop:\n    cbz x0, .Lquar_end_done\n");
  s = s.write(rc_poison_into("w9") + "    ldr w11, [x0]\n    cmp w11, w9\n    b.ne .Lquar_end_size0\n    ldr x1, [x0, #8]\n    b .Lquar_end_scan\n");
  s = s.write(".Lquar_end_size0:\n    ldr w11, [x0, #8]\n    cmp w11, w9\n    b.ne __fern_san_abort_waf\n    ldr x1, [x0]\n.Lquar_end_scan:\n");
  s = quar_payload(s, "atexit", "    ldr x12, [x10], #8\n    cmp x12, x9\n    b.ne __fern_san_abort_waf\n");
  return s.write("    ldr x0, [x0, #16]\n    b .Lquar_end_loop\n.Lquar_end_done:\n");
}

function rc_poison_into(w: string): string {
  let v = rc_poison();
  return "    movz " + w + ", #" + util.i32_to_string(v & 65535) + "\n"
    + "    movk " + w + ", #" + util.i32_to_string(v >> 16 & 65535) + ", lsl #16\n";
}

function quarantine_rc(addr: string, w: string, on: boolean): string {
  if (on) {
    return rc_poison_into(w) + "    stur " + w + ", " + addr + "\n";
  }
  return "    stur wzr, " + addr + "\n";
}

// A release under -sanitize hands its block to the quarantine instead of a
// free list: `ptr` is the block base, `words` its size (a register or an
// immediate), and `poison_at` the byte offset of its count word (0 or 8),
// or 16 for a block with no count. The link register is kept.
// The caller keeps x0 to x2 across the push: a free path can read the
// box through x0 after its data block is quarantined.
function quar_push(s: asmcore.EmitState, ptr: string, words: string, poison_at: i32): asmcore.EmitState {
  s = s.write(rt_save_lr(s, "x0"));
  s = s.write("    stp x1, x2, [sp, #-16]!\n");
  s = s.write("    mov x10, " + words + "\n");
  if (ptr != "x0") {
    s = s.write("    mov x0, " + ptr + "\n");
  }
  s = s.write("    mov x1, x10\n");
  s = s.write("    mov x2, #" + util.i32_to_string(poison_at) + "\n");
  s = s.write("    bl __fern_quar_push\n");
  s = s.write("    ldp x1, x2, [sp], #16\n");
  return s.write(rt_restore_lr(s, "x0"));
}

// Under -sanitize a raw free of a block that is in the quarantine aborts as a
// double free. The poison word selects the candidates, and a walk of the
// quarantine decides, so a live block that holds the poison value is freed.
function san_raw_twice_check(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    ldr w9, [x0]\n" + rc_poison_into("w10") + "    cmp w9, w10\n    b.ne .Lrawfree_fresh\n");
  s = s.write(quar_addr("x10", "__fern_quar_head") + "    ldr x10, [x10]\n.Lrawfree_qscan:\n    cbz x10, .Lrawfree_fresh\n");
  s = s.write("    cmp x10, x0\n    b.eq __fern_double_free_abort\n    ldr x10, [x10, #16]\n    b .Lrawfree_qscan\n");
  return s.write(".Lrawfree_fresh:\n");
}

function quar_addr(reg: string, symbol: string): string {
  return "    adrp " + reg + ", " + symbol + "\n    add " + reg + ", " + reg + ", :lo12:" + symbol + "\n";
}

// The -sanitize quarantine: a FIFO threaded through the released blocks.
// Word 2 of a block links the next, the count word keeps its poison, and
// the other of words 0 and 1 holds the size. A release past the budget
// evicts the oldest block to its free list after its poison is checked.
function emit_quarantine(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_quar_push:\n");
  s = s.write("    cmp x1, #3\n");
  s = s.write("    b.lo .Lquar_ret\n");
  // A block of a worker region the parent is forgetting does not enter the
  // quarantine: the region goes back to the kernel at the join.
  if (s.has_need("worker_regions")) {
    s = s.write(quar_addr("x9", "__fern_forget_lo") + "    ldr x9, [x9]\n    cmp x0, x9\n    b.lo .Lquar_keep\n");
    s = s.write(quar_addr("x9", "__fern_forget_hi") + "    ldr x9, [x9]\n    cmp x0, x9\n    b.lo .Lquar_ret\n");
    s = s.write(".Lquar_keep:\n");
  }
  s = s.write(rt_frame(s));
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x0, x1, [sp, #-16]!\n");
  s = s.write("    stp x2, x3, [sp, #-16]!\n");
  s = s.write("    stp x4, x5, [sp, #-16]!\n");
  s = s.write("    stp x6, x7, [sp, #-16]!\n");
  s = s.write("    str x8, [sp, #-16]!\n");
  s = s.write("    cmp x2, #8\n");
  s = s.write("    b.eq .Lquar_meta0\n");
  s = s.write(rc_poison_into("w9"));
  s = s.write("    str w9, [x0]\n");
  s = s.write("    str x1, [x0, #8]\n");
  s = s.write("    b .Lquar_link\n");
  s = s.write(".Lquar_meta0:\n");
  s = s.write("    str x1, [x0]\n");
  s = s.write(".Lquar_link:\n");
  s = s.write("    str xzr, [x0, #16]\n");
  s = s.write(quar_addr("x10", "__fern_quar_tail"));
  s = s.write("    ldr x11, [x10]\n");
  s = s.write("    cbz x11, .Lquar_first\n");
  s = s.write("    str x0, [x11, #16]\n");
  s = s.write("    b .Lquar_tail\n");
  s = s.write(".Lquar_first:\n");
  s = s.write(quar_addr("x12", "__fern_quar_head"));
  s = s.write("    str x0, [x12]\n");
  s = s.write(".Lquar_tail:\n");
  s = s.write("    str x0, [x10]\n");
  s = s.write(quar_addr("x12", "__fern_quar_bytes"));
  s = s.write("    ldr x13, [x12]\n");
  s = s.write("    add x13, x13, x1, lsl #3\n");
  s = s.write("    str x13, [x12]\n");
  s = quar_payload(s, "fill", "    str x9, [x10], #8\n");
  if (s.quarantine > 0i64) {
    s = s.write(".Lquar_evict:\n");
    s = s.write(mov_imm64("x14", s.quarantine));
    s = s.write(quar_addr("x12", "__fern_quar_bytes"));
    s = s.write("    ldr x13, [x12]\n");
    s = s.write("    cmp x13, x14\n");
    s = s.write("    b.ls .Lquar_done\n");
    s = s.write(quar_addr("x12", "__fern_quar_head"));
    s = s.write("    ldr x0, [x12]\n");
    s = s.write("    ldr x11, [x0, #16]\n");
    s = s.write("    str x11, [x12]\n");
    s = s.write("    cbnz x11, .Lquar_unlinked\n");
    s = s.write(quar_addr("x10", "__fern_quar_tail"));
    s = s.write("    str xzr, [x10]\n");
    s = s.write(".Lquar_unlinked:\n");
    s = s.write(rc_poison_into("w9"));
    s = s.write("    ldr w11, [x0]\n");
    s = s.write("    cmp w11, w9\n");
    s = s.write("    b.ne .Lquar_size0\n");
    s = s.write("    ldr x1, [x0, #8]\n");
    s = s.write("    str wzr, [x0]\n");
    s = s.write("    b .Lquar_recycle\n");
    s = s.write(".Lquar_size0:\n");
    s = s.write("    ldr w11, [x0, #8]\n");
    s = s.write("    cmp w11, w9\n");
    s = s.write("    b.ne .Lquar_waf\n");
    s = s.write("    ldr x1, [x0]\n");
    s = s.write("    str wzr, [x0, #8]\n");
    s = s.write(".Lquar_recycle:\n");
    s = quar_payload(s, "scan", "    ldr x12, [x10], #8\n    cmp x12, x9\n    b.ne .Lquar_waf\n");
    s = s.write(quar_addr("x12", "__fern_quar_bytes"));
    s = s.write("    ldr x13, [x12]\n");
    s = s.write("    sub x13, x13, x1, lsl #3\n");
    s = s.write("    str x13, [x12]\n");
    s = s.write("    mov x9, #0x10000\n");
    s = s.write("    cmp x1, x9\n");
    s = s.write("    b.hs .Lquar_large\n");
    s = freelist_push(s, "x0", "x1", "x3", "x4");
    s = s.write("    b .Lquar_evict\n");
    s = s.write(".Lquar_large:\n");
    s = s.write("    lsl x2, x1, #3\n");
    s = s.write("    mov x1, x0\n");
    s = s.write("    bl __fern_large_push_now\n");
    s = s.write("    b .Lquar_evict\n");
    s = s.write(".Lquar_waf:\n");
    s = s.write("    b __fern_san_abort_waf\n");
    s = s.write(".Lquar_done:\n");
  }
  s = s.write("    ldr x8, [sp], #16\n");
  s = s.write("    ldp x6, x7, [sp], #16\n");
  s = s.write("    ldp x4, x5, [sp], #16\n");
  s = s.write("    ldp x2, x3, [sp], #16\n");
  s = s.write("    ldp x0, x1, [sp], #16\n");
  s = s.write(rt_unframe(s));
  s = s.write(".Lquar_ret:\n");
  return s.write("    ret\n");
}

// Under -sanitize a raw block carries a redzone: the two words after its
// size rounded to 8 hold the poison pattern from `__alloc` to `__free`.
// The allocation takes 16 bytes more, and the free checks the two words.
// The census counts the block without its redzone, so a release through
// the typed runtime, which does not know the redzone, balances it.
function emit_raw_alloc_san(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_raw_alloc_san:\n");
  s = s.write(rt_frame_of(s, 32) + "    mov x29, sp\n    str x0, [sp, #16]\n    add x0, x0, #16\n    bl __fern_alloc\n");
  if (s.leak_check) {
    s = s.write("    adrp x9, __fern_lc_alloc_bytes\n    add x9, x9, :lo12:__fern_lc_alloc_bytes\n    ldr x10, [x9]\n    sub x10, x10, #16\n    str x10, [x9]\n");
  }
  s = s.write("    ldr x1, [sp, #16]\n");
  s = s.write("    add x1, x1, #7\n    lsr x1, x1, #3\n    add x9, x0, x1, lsl #3\n" + rc_poison_into("w10") + "    orr x10, x10, x10, lsl #32\n");
  return s.write("    str x10, [x9]\n    str x10, [x9, #8]\n" + rt_unframe_of(s, 32) + "    ret\n");
}

// The free side of the redzone: x0 is the block and x5 its size in words.
// A word that lost the pattern was written past the end of the block.
function san_redzone_check(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    add x9, x0, x5, lsl #3\n" + rc_poison_into("w10") + "    orr x10, x10, x10, lsl #32\n");
  return s.write("    ldr x11, [x9]\n    cmp x11, x10\n    b.ne __fern_san_abort_hbo\n    ldr x11, [x9, #8]\n    cmp x11, x10\n    b.ne __fern_san_abort_hbo\n");
}

function emit_san_hbo_abort(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.rc_free_debug) {
    return s;
  }
  s = s.write("    .section .rodata\n");
  s = s.write(".Lsan_hbo:\n    .ascii \"fern-sanitizer: heap-buffer-overflow (a raw block was written past its end)\\n\"\n");
  s = s.write("    .text\n");
  s = s.write("    .globl __fern_san_abort_hbo\n");
  s = s.write("__fern_san_abort_hbo:\n");
  s = s.write("    adrp x1, .Lsan_hbo\n");
  s = s.write("    add x1, x1, :lo12:.Lsan_hbo\n");
  s = s.write("    mov x2, #76\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.svc(64);
  return san_report_exit(s);
}

function emit_san_waf_abort(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.rc_free_debug) {
    return s;
  }
  s = s.write("    .section .rodata\n");
  s = s.write(".Lsan_waf:\n    .ascii \"fern-sanitizer: write-after-free (a quarantined block was written)\\n\"\n");
  s = s.write("    .text\n");
  s = s.write("    .globl __fern_san_abort_waf\n");
  s = s.write("__fern_san_abort_waf:\n");
  s = s.write("    adrp x1, .Lsan_waf\n");
  s = s.write("    add x1, x1, :lo12:.Lsan_waf\n");
  s = s.write("    mov x2, #67\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.svc(64);
  return san_report_exit(s);
}

// Under -harden a free list hands out one of its first eight blocks, chosen
// by a xorshift step over the seed read at startup: x0 is the address of
// the list head on entry and the block taken on exit, or zero when the
// list is empty. x1 to x8 are kept.
// The link inside a free block is encoded with the block's key
// (freelist_key), and a decoded link must be aligned and inside the arena.
function emit_freelist_take(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_freelist_take:\n");
  s = s.write("    str x13, [sp, #-16]!\n");
  s = s.write(quar_addr("x9", "__fern_rng_state"));
  s = s.write("    ldr x10, [x9]\n");
  s = s.write("    eor x10, x10, x10, lsl #13\n");
  s = s.write("    eor x10, x10, x10, lsr #7\n");
  s = s.write("    eor x10, x10, x10, lsl #17\n");
  s = s.write("    str x10, [x9]\n");
  s = s.write("    and x10, x10, #7\n");
  s = s.write("    mov x11, x0\n");
  s = s.write("    mov x13, x0\n");
  s = s.write("    ldr x0, [x11]\n");
  s = s.write("    cbz x0, .Lfltake_done\n");
  s = s.write(".Lfltake_walk:\n");
  s = s.write("    cbz x10, .Lfltake_unlink\n");
  s = freelist_next(s, "x0", "x12");
  s = s.write("    cbz x12, .Lfltake_unlink\n");
  s = s.write("    mov x11, x0\n");
  s = s.write("    mov x0, x12\n");
  s = s.write("    sub x10, x10, #1\n");
  s = s.write("    b .Lfltake_walk\n");
  s = s.write(".Lfltake_unlink:\n");
  s = freelist_next(s, "x0", "x12");
  s = s.write("    cmp x11, x13\n");
  s = s.write("    b.eq .Lfltake_store\n");
  s = s.write(freelist_key("x11", "x16"));
  s = s.write("    eor x12, x12, x16\n");
  s = s.write(".Lfltake_store:\n");
  s = s.write("    str x12, [x11]\n");
  s = s.write("    str xzr, [x0]\n");
  s = s.write(".Lfltake_done:\n");
  s = s.write("    ldr x13, [sp], #16\n");
  return s.write("    ret\n");
}

// The key of a free block's link under -harden: the process canary mixed
// with the block's page, so a link copied from another block fails too.
// The key lands in `into`.
// Under -harden, XORs the key of `block` into the link in `link`, with x16
// as scratch.
function freelist_encode(s: asmcore.EmitState, block: string, link: string): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  return s.write(freelist_key(block, "x16") + "    eor " + link + ", " + link + ", x16\n");
}

function freelist_key(block: string, into: string): string {
  return quar_addr(into, "__fern_canary") + "    ldr " + into + ", [" + into + "]\n    eor " + into + ", " + into + ", " + block + ", lsr #12\n";
}

// Decodes the link of the free block in `block` into `out` and checks it: zero
// ends the list, and a next block is 8-byte aligned and inside the arena.
function freelist_next(s: asmcore.EmitState, block: string, out: string): asmcore.EmitState {
  let ok = asmcore.fresh_label(s);
  s = ok.state;
  s = s.write(freelist_key(block, "x16"));
  s = s.write("    ldr " + out + ", [" + block + "]\n");
  s = s.write("    eor " + out + ", " + out + ", x16\n");
  s = s.write("    cbz " + out + ", " + ok.name + "\n");
  s = s.write("    tst " + out + ", #7\n");
  s = s.write("    b.ne __fern_free_link_abort_leaf\n");
  s = s.write(quar_addr("x16", "__fern_heap_base"));
  s = s.write("    ldr x16, [x16]\n    cmp " + out + ", x16\n    b.lo __fern_free_link_abort_leaf\n");
  s = s.write(quar_addr("x16", "__fern_heap_end"));
  s = s.write("    ldr x16, [x16]\n    cmp " + out + ", x16\n    b.hs __fern_free_link_abort_leaf\n");
  return s.write(ok.name + ":\n");
}

// Under -harden every 64th large block the bump hands out ends on a page
// boundary and is followed by a page the process cannot touch. A failed
// mprotect leaves the block without its guard. x0 is the byte count and
// x1 the address of the heap pointer.
function emit_guard_bump(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    mov x9, #0x80000\n");
  s = s.write("    cmp x0, x9\n");
  s = s.write("    b.lo .Lalloc_bump\n");
  s = s.write(quar_addr("x9", "__fern_guard_count"));
  s = s.write("    ldr x10, [x9]\n");
  s = s.write("    add x10, x10, #1\n");
  s = s.write("    str x10, [x9]\n");
  s = s.write("    tst x10, #63\n");
  s = s.write("    b.ne .Lalloc_bump\n");
  s = s.write("    ldr x2, [x1]\n");
  s = s.write("    add x2, x2, #4095\n");
  s = s.write("    and x2, x2, #-4096\n");
  s = s.write("    adds x3, x2, x0\n");
  s = s.write("    b.cs __fern_alloc_size_abort\n");
  s = s.write("    adds x10, x3, #4096\n");
  s = s.write("    b.cs __fern_alloc_size_abort\n");
  s = s.write("    str x4, [sp, #-16]!\n");
  s = s.write(quar_addr("x4", "__fern_heap_end"));
  s = s.write("    ldr x4, [x4]\n");
  s = s.write("    cmp x10, x4\n");
  s = s.write("    ldr x4, [sp], #16\n");
  s = s.write("    b.hi .Lalloc_oom\n");
  s = s.write("    str x10, [x1]\n");
  s = s.write("    stp x1, x2, [sp, #-16]!\n");
  s = s.write("    stp x8, x9, [sp, #-16]!\n");
  s = s.write("    mov x0, x3\n");
  s = s.write("    mov x1, #4096\n");
  s = s.write("    mov x2, #0\n");
  s = s.write("    mov x8, #226\n");
  s = s.svc(226);
  s = s.write("    ldp x8, x9, [sp], #16\n");
  s = s.write("    ldp x1, x2, [sp], #16\n");
  s = s.write("    mov x0, x2\n");
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  return s.write(".Lalloc_bump:\n");
}

function arr_copy_elems(l: string): string {
  return "    add x2, x19, #8\n    add x3, x0, #8\n    mov x4, x21\n"
    + l + "_copy4:\n    cmp x4, #4\n    b.lt " + l + "_copy1\n"
    + "    ldp x5, x6, [x2], #16\n    ldp x7, x8, [x2], #16\n    stp x5, x6, [x3], #16\n    stp x7, x8, [x3], #16\n"
    + "    sub x4, x4, #4\n    b " + l + "_copy4\n"
    + l + "_copy1:\n    cbz x4, " + l + "_copy_done\n"
    + l + "_copy1_loop:\n    ldr x5, [x2], #8\n    str x5, [x3], #8\n    subs x4, x4, #1\n    b.ne " + l + "_copy1_loop\n"
    + l + "_copy_done:\n";
}

function apo_grow(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    ldur w2, [x0, #-8]\n");
  s = s.write("    cmp w2, #1\n");
  s = s.write("    b.eq .Lapo_own\n");
  s = s.write("    b .Larr_push_slow\n");
  s = s.write(".Lapo_own:\n");
  s = s.write(rt_frame(s));
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    mov x20, x1\n");
  s = s.write("    ldr x21, [x19]\n");
  s = s.write("    ldur x22, [x19, #-16]\n");
  s = s.write("    lsl x8, x22, #1\n");
  s = s.write("    cbnz x8, .Lapo_cap\n");
  s = s.write("    mov x8, #4\n");
  s = s.write(".Lapo_cap:\n");
  s = s.write("    add x9, x21, #1\n    cmp x8, x9\n    csel x8, x8, x9, hs\n");
  s = s.write("    movz x9, #65535\n    movk x9, #4095, lsl #16\n    cmp x8, x9\n    b.ls .Lapo_sized\n    b __fern_alloc_size_abort\n.Lapo_sized:\n");
  s = s.write("    add x1, x8, #3\n");
  s = s.write("    lsl x1, x1, #3\n");
  s = s.write("    cmp x1, #2048\n");
  s = s.write("    b.hi .Lapo_alloc\n");
  s = s.write("    adrp x3, __fern_freelist\n");
  s = s.write("    add x3, x3, :lo12:__fern_freelist\n");
  s = s.write("    add x1, x3, x1\n");
  if (s.harden) {
    s = s.write("    mov x0, x1\n");
    s = s.write("    bl __fern_freelist_take\n");
    s = s.write("    mov x3, x0\n");
    s = s.write("    cbz x3, .Lapo_miss\n");
  } else {
    s = s.write("    ldr x3, [x1]\n");
    s = s.write("    cbz x3, .Lapo_miss\n");
    s = s.write("    ldr x4, [x3]\n");
    s = s.write("    str x4, [x1]\n");
  }
  s = s.write(".Lapo_box:\n");
  s = s.write("    str x8, [x3]\n");
  s = s.write("    mov w4, #1\n");
  s = s.write("    str w4, [x3, #8]\n");
  s = s.write("    add x0, x3, #16\n");
  s = s.write("    add x1, x21, #1\n");
  s = s.write("    str x1, [x0]\n");
  s = s.write(arr_copy_elems(".Lapo"));
  s = s.write("    add x1, x21, #1\n");
  s = s.write("    str x20, [x0, x1, lsl #3]\n");
  s = s.write("    add x1, x22, #3\n");
  s = s.write("    mov x9, #0x10000\n");
  s = s.write("    cmp x1, x9\n");
  s = s.write("    b.hs .Lapo_large\n");
  s = s.write(quarantine_rc("[x19, #-8]", "w10", false));
  s = s.write("    sub x2, x19, #16\n");
  s = freelist_push(s, "x2", "x1", "x3", "x9");
  s = s.write(".Lapo_ret:\n");
  s = s.write("    ldp x21, x22, [sp], #16\n");
  s = s.write("    ldp x19, x20, [sp], #16\n");
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  s = s.write(".Lapo_miss:\n");
  s = s.write("    add x1, x8, #3\n");
  s = s.write("    lsl x1, x1, #3\n");
  s = s.write(".Lapo_alloc:\n");
  s = s.write("    mov x0, x1\n");
  s = s.write("    bl __fern_alloc\n");
  s = s.write("    mov x3, x0\n");
  s = s.write("    b .Lapo_box\n");
  return s;
}

function apo_wrapped(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.rc_free_debug) {
    s = s.write("    ldr x2, [x0]\n");
    s = s.write("    cbnz x2, .Lapo_grow\n");
    s = s.write("    ldur x2, [x0, #-16]\n");
    s = s.write("    cbnz x2, .Lapo_grow\n");
    s = s.write("    ldur w2, [x0, #-8]\n");
    s = s.write("    tbz w2, #31, .Lapo_grow\n");
    s = s.write("    b .Larr_push_slow\n");
    s = s.write(".Lapo_grow:\n");
  }
  s = s.write(rt_frame(s));
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  if (s.rc_free_debug) {
    s = s.write("    bl __fern_arr_push\n");
  } else {
    s = s.write("    bl .Larr_push_slow\n");
  }
  s = s.write("    cmp x0, x19\n");
  s = s.write("    beq .Lapo_ret\n");
  s = s.write("    mov x9, #0x10000\n");
  s = s.write("    cmp x19, x9\n");
  s = s.write("    blo .Lapo_ret\n");
  s = s.write("    ldur w1, [x19, #-8]\n");
  s = s.write(san_poison_check("w1", "w10", ".Lapo_live", s.rc_free_debug));
  s = s.write("    tbnz w1, #31, .Lapo_ret\n");
  s = s.write("    cmp w1, #1\n");
  s = s.write("    bne .Lapo_ret\n");
  s = s.write("    ldur x1, [x19, #-16]\n");
  s = s.write("    add x1, x1, #3\n");
  s = s.write("    mov x9, #0x10000\n");
  s = s.write("    cmp x1, x9\n");
  s = s.write("    bhs .Lapo_large\n");
  s = s.write(quarantine_rc("[x19, #-8]", "w10", s.rc_free_debug));
  s = s.write("    sub x2, x19, #16\n");
  s = lc_bump_free_words(s, "x1", "x3", "x9", "x2");
  if (!s.rc_free_debug) {
    s = freelist_push(s, "x2", "x1", "x3", "x9");
  } else {
    s = quar_push(s, "x2", "x1", 8);
  }
  s = s.write(".Lapo_ret:\n");
  s = s.write("    ldp x19, x20, [sp], #16\n");
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  return s;
}

function arr_push_fast(slow: string, on: boolean): string {
  if (on) {
    return "";
  }
  let ok = slow + "_ok";
  return "    ldr x2, [x0]\n    ldur x3, [x0, #-16]\n    cmp x2, x3\n    b.ge " + slow + "\n"
    + "    ldur w3, [x0, #-8]\n    cmp w3, #1\n    b.eq " + ok + "\n"
    + "    tbz w3, #31, " + slow + "\n"
    + ok + ":\n    add x2, x2, #1\n    str x1, [x0, x2, lsl #3]\n    str x2, [x0]\n    ret\n";
}

function arr_push_fast_u8(slow: string, on: boolean): string {
  if (on) {
    return "";
  }
  let ok = slow + "_ok";
  return "    ldr x2, [x0]\n    ldur x3, [x0, #-16]\n    lsl x3, x3, #3\n    cmp x2, x3\n    b.ge " + slow + "\n"
    + "    ldur w3, [x0, #-8]\n    cmp w3, #1\n    b.eq " + ok + "\n"
    + "    tbz w3, #31, " + slow + "\n"
    + ok + ":\n    add x3, x0, x2\n    strb w1, [x3, #8]\n    add x2, x2, #1\n    str x2, [x0]\n    ret\n";
}

function emit_alloc_bytes(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(empty_array_block(s, ".Lfern_empty_bytes"));
  s = s.write("__fern_alloc_bytes:\n");
  s = s.write("    tbz w0, #31, .Lfern_alloc_bytes_sized\n    b __fern_alloc_size_abort_leaf\n.Lfern_alloc_bytes_sized:\n");
  s = s.write("    cbz w0, .Lfern_alloc_bytes_empty\n");
  s = s.write(rt_frame(s) + "    mov x29, sp\n    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    sxtw x19, w0\n    add x0, x19, #7\n    lsr x0, x0, #3\n    mov x20, x0\n");
  s = s.write("    bl __fern_arr_box\n");
  s = s.write("    str x19, [x0]\n    add x2, x0, #8\n");
  s = s.write(".Lfern_alloc_bytes_zero:\n    cbz x20, .Lfern_alloc_bytes_done\n    str xzr, [x2], #8\n    sub x20, x20, #1\n    b .Lfern_alloc_bytes_zero\n");
  s = s.write(".Lfern_alloc_bytes_done:\n");
  s = s.write("    ldp x19, x20, [sp], #16\n" + rt_unframe(s) + "    ret\n");
  s = s.write(".Lfern_alloc_bytes_empty:\n    adrp x0, .Lfern_empty_bytes\n    add x0, x0, :lo12:.Lfern_empty_bytes\n    ret\n");
  if (s.has_need("alloc_bytes_uninit")) {
    s = s.write("__fern_alloc_bytes_uninit:\n    tbz w0, #31, .Lfern_uninit_sized\n    b __fern_alloc_size_abort_leaf\n.Lfern_uninit_sized:\n    cbz w0, .Lfern_alloc_bytes_empty\n");
    s = s.write(rt_frame(s) + "    mov x29, sp\n    stp x19, x20, [sp, #-16]!\n    sxtw x19, w0\n    add x0, x19, #7\n    lsr x0, x0, #3\n    bl __fern_arr_box\n    str x19, [x0]\n    ldp x19, x20, [sp], #16\n" + rt_unframe(s) + "    ret\n");
  }
  return s;
}

// The shared empty array is a constant box: a length setter skips it.
function empty_array_block(s: asmcore.EmitState, label: string): string {
  return asmcore.const_data_section(s) + "    .balign 8\n    .quad 0\n    .quad -1\n" + label + ":\n    .quad 0\n    .text\n";
}

function emit_arr_push_u8(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_arr_push_u8:\n");
  s = s.write(arr_push_fast_u8(".Larr_push_u8_slow", s.rc_free_debug));
  s = s.write(".Larr_push_u8_slow:\n");
  s = s.write(rt_frame(s) + "    mov x29, sp\n    stp x19, x20, [sp, #-16]!\n    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n    mov x20, x1\n    ldr x21, [x19]\n    ldur x22, [x19, #-16]\n");
  if (!s.rc_free_debug) {
    s = s.write("    b .Larr_push_u8_grow\n");
  }
  s = s.write("    ldur w2, [x19, #-8]\n");
  s = s.write(san_poison_check("w2", "w10", ".Larr_push_u8_sanlive", s.rc_free_debug));
  s = s.write("    cmp w2, #1\n    b.eq .Larr_push_u8_rc_ok\n    tbnz w2, #31, .Larr_push_u8_rc_ok\n    b .Larr_push_u8_grow\n");
  s = s.write(".Larr_push_u8_rc_ok:\n");
  s = s.write("    lsl x2, x22, #3\n    cmp x21, x2\n    b.ge .Larr_push_u8_grow\n");
  s = s.write("    add x2, x19, x21\n    strb w20, [x2, #8]\n    add x21, x21, #1\n    str x21, [x19]\n    mov x0, x19\n    b .Larr_push_u8_ret\n");
  s = s.write(".Larr_push_u8_grow:\n");
  s = s.write("    mov x2, x22\n    lsl x3, x22, #3\n    cmp x21, x3\n    b.lt .Larr_push_u8_cliff\n");
  s = s.write("    cbnz x22, .Larr_push_u8_dbl\n    mov x2, #4\n    b .Larr_push_u8_cap\n");
  s = s.write(".Larr_push_u8_cliff:\n");
  s = s.write("    adrp x3, __fern_arr_push_shared\n    add x3, x3, :lo12:__fern_arr_push_shared\n    ldr x4, [x3]\n    add x4, x4, #1\n    str x4, [x3]\n");
  s = s.write("    adrp x3, __fern_arr_push_copied\n    add x3, x3, :lo12:__fern_arr_push_copied\n    ldr x4, [x3]\n    add x4, x4, x21\n    str x4, [x3]\n");
  s = s.write("    b .Larr_push_u8_cap\n");
  s = s.write(".Larr_push_u8_dbl:\n    lsl x2, x22, #1\n");
  s = s.write(".Larr_push_u8_cap:\n    add x3, x21, #8\n    lsr x3, x3, #3\n    cmp x2, x3\n    csel x2, x2, x3, hs\n    mov x0, x2\n    bl __fern_arr_box\n");
  s = s.write("    add x1, x21, #1\n    str x1, [x0]\n");
  s = s.write("    add x2, x19, #8\n    add x3, x0, #8\n    add x4, x21, #7\n    lsr x4, x4, #3\n");
  s = s.write(".Larr_push_u8_copy:\n    cbz x4, .Larr_push_u8_copied\n    ldr x5, [x2], #8\n    str x5, [x3], #8\n    sub x4, x4, #1\n    b .Larr_push_u8_copy\n");
  s = s.write(".Larr_push_u8_copied:\n    add x2, x0, x21\n    strb w20, [x2, #8]\n");
  s = s.write(".Larr_push_u8_ret:\n    ldp x21, x22, [sp], #16\n    ldp x19, x20, [sp], #16\n" + rt_unframe(s) + "    ret\n");
  s = s.write("__fern_arr_push_owned_u8:\n");
  s = s.write(arr_push_fast_u8(".Lapou_slow", s.rc_free_debug));
  s = s.write(".Lapou_slow:\n");
  s = s.write(rt_frame(s) + "    mov x29, sp\n    stp x19, x20, [sp, #-16]!\n    mov x19, x0\n");
  if (s.rc_free_debug) {
    s = s.write("    bl __fern_arr_push_u8\n");
  } else {
    s = s.write("    bl .Larr_push_u8_slow\n");
  }
  s = s.write("    cmp x0, x19\n    beq .Lapou_ret\n    mov x9, #0x10000\n    cmp x19, x9\n    blo .Lapou_ret\n");
  s = s.write("    ldur w1, [x19, #-8]\n");
  s = s.write(san_poison_check("w1", "w10", ".Lapou_live", s.rc_free_debug));
  s = s.write("    tbnz w1, #31, .Lapou_ret\n    cmp w1, #1\n    bne .Lapou_ret\n");
  s = s.write("    ldur x1, [x19, #-16]\n    add x1, x1, #3\n    mov x9, #0x10000\n    cmp x1, x9\n    bhs .Lapou_large\n");
  s = s.write(quarantine_rc("[x19, #-8]", "w10", s.rc_free_debug));
  s = s.write("    sub x2, x19, #16\n");
  s = lc_bump_free_words(s, "x1", "x3", "x9", "x2");
  if (!s.rc_free_debug) {
    s = freelist_push(s, "x2", "x1", "x3", "x9");
  } else {
    s = quar_push(s, "x2", "x1", 8);
  }
  s = s.write(".Lapou_ret:\n    ldp x19, x20, [sp], #16\n" + rt_unframe(s) + "    ret\n");
  s = s.write(".Lapou_large:\n");
  s = s.write(quarantine_rc("[x19, #-8]", "w10", s.rc_free_debug));
  if (s.rc_free_debug) {
    s = lc_bump_free_words(s, "x1", "x3", "x9", "x19");
    s = s.write("    sub x2, x19, #16\n");
    s = quar_push(s, "x2", "x1", 8);
    s = s.write("    b .Lapou_ret\n");
  } else {
    s = s.write("    lsl x2, x1, #3\n    sub x1, x19, #16\n    bl __fern_large_push\n    b .Lapou_ret\n");
  }
  return s;
}

function san_poison_check(rc: string, w: string, live: string, debug: boolean): string {
  if (!debug) {
    return "";
  }
  return rc_poison_into(w)
    + "    cmp " + rc + ", " + w + "\n"
    + "    b.ne " + live + "\n"
    + "    bl __fern_san_abort_uaf\n"
    + live + ":\n";
}

function san_underflow_abort(s: asmcore.EmitState): string {
  if (s.sanitize) {
    return "    bl __fern_san_abort\n";
  }
  return "";
}

function emit_san_abort(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.sanitize) {
    return s;
  }
  s = s.write("    .section .rodata\n");
  s = s.write(".Lsan_df:\n    .ascii \"fern-sanitizer: rc over-release (double free)\\n\"\n");
  s = s.write("    .text\n");
  s = s.write("    .globl __fern_san_abort\n");
  s = s.write("__fern_san_abort:\n");
  s = s.write("    adrp x1, .Lsan_df\n");
  s = s.write("    add x1, x1, :lo12:.Lsan_df\n");
  s = s.write("    mov x2, #46\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.svc(64);
  s = san_report_exit(s);
  return s;
}

function san_report_exit(s: asmcore.EmitState): asmcore.EmitState {
  if (s.backtrace) {
    return s.write("    mov x19, #124\n    b __fern_bt_exit\n");
  }
  return s.write(profile_exit_asm(s) + "    mov x0, #124\n    mov x8, #94\n").svc(94);
}

function bt_strip_signature(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  return s.write("    mov x30, x1\n    xpaclri\n    mov x1, x30\n");
}

function emit_bt_exit(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .section .rodata\n");
  s = s.write(".Lmsg_bt:\n    .ascii \"backtrace:\\n\"\n");
  s = s.write("    .text\n");
  s = s.write("    .globl __fern_bt_exit\n");
  s = s.write("__fern_bt_exit:\n");
  s = s.write("    adrp x1, .Lmsg_bt\n");
  s = s.write("    add x1, x1, :lo12:.Lmsg_bt\n");
  s = s.write("    mov x2, #11\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.svc(64);
  s = s.write("    mov x20, x29\n");
  s = s.write("    mov x21, #64\n");
  s = s.write("    mov x22, sp\n");
  s = s.write(".Lbt_loop:\n");
  s = s.write("    cmp x20, x22\n");
  s = s.write("    b.lo .Lbt_done\n");
  s = s.write("    and x23, x20, #7\n");
  s = s.write("    cbnz x23, .Lbt_done\n");
  s = s.write("    ldr x1, [x20, #8]\n");
  s = bt_strip_signature(s);
  s = s.write("    cmp x1, #16, lsl #12\n");
  s = s.write("    b.lo .Lbt_done\n");
  s = s.write("    bl .Lbt_hex\n");
  s = s.write("    adrp x24, __fern_bt_floor\n");
  s = s.write("    add x24, x24, :lo12:__fern_bt_floor\n");
  s = s.write("    ldr x22, [x24]\n");
  s = s.write("    str xzr, [x24]\n");
  s = s.write("    add x23, x20, #8\n");
  s = s.write("    cmp x22, #0\n");
  s = s.write("    csel x22, x23, x22, eq\n");
  s = s.write("    ldr x20, [x20]\n");
  s = s.write("    adrp x24, __fern_stack_top\n");
  s = s.write("    add x24, x24, :lo12:__fern_stack_top\n");
  s = s.write("    ldr x24, [x24]\n");
  s = s.write("    cbz x24, .Lbt_next\n");
  s = s.write("    cmp x20, x24\n");
  s = s.write("    b.hs .Lbt_done\n");
  s = s.write(".Lbt_next:\n");
  s = s.write("    subs x21, x21, #1\n");
  s = s.write("    b.ne .Lbt_loop\n");
  s = s.write(".Lbt_done:\n");
  s = s.write(signal_resume_check(s));
  s = s.write("    mov x0, x19\n");
  s = s.write(profile_exit_asm(s));
  s = s.write("    mov x8, #94\n");
  s = s.svc(94);
  s = s.write(".Lbt_hex:\n");
  s = s.write("    sub sp, sp, #32\n");
  s = s.write("    mov w2, #0x2020\n");
  s = s.write("    movk w2, #0x7830, lsl #16\n");
  s = s.write("    str w2, [sp]\n");
  s = s.write("    mov w2, #10\n");
  s = s.write("    strb w2, [sp, #20]\n");
  s = s.write("    mov x3, #16\n");
  s = s.write("    add x4, sp, #3\n");
  s = s.write(".Lbt_hloop:\n");
  s = s.write("    and x2, x1, #15\n");
  s = s.write("    cmp x2, #10\n");
  s = s.write("    add x5, x2, #87\n");
  s = s.write("    add x2, x2, #48\n");
  s = s.write("    csel x2, x5, x2, hs\n");
  s = s.write("    strb w2, [x4, x3]\n");
  s = s.write("    lsr x1, x1, #4\n");
  s = s.write("    subs x3, x3, #1\n");
  s = s.write("    b.ne .Lbt_hloop\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x1, sp\n");
  s = s.write("    mov x2, #21\n");
  s = s.write("    mov x8, #64\n");
  s = s.svc(64);
  s = s.write("    add sp, sp, #32\n");
  s = s.write("    ret\n");
  return s;
}

function emit_san_uaf_abort(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.rc_free_debug) {
    return s;
  }
  s = s.write("    .section .rodata\n");
  s = s.write(".Lsan_uaf:\n    .ascii \"fern-sanitizer: use-after-free (touched a quarantined block)\\n\"\n");
  s = s.write("    .text\n");
  s = s.write("    .globl __fern_san_abort_uaf\n");
  s = s.write("__fern_san_abort_uaf:\n");
  s = s.write("    adrp x1, .Lsan_uaf\n");
  s = s.write("    add x1, x1, :lo12:.Lsan_uaf\n");
  s = s.write("    mov x2, #61\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.svc(64);
  return san_report_exit(s);
}

function high_heap_probe_on(): boolean {
  return envflag.on("FERN_HIGH_HEAP");
}

function alloc_count_bump(s: asmcore.EmitState): asmcore.EmitState {
  if (!s.has_need("alloc_count")) {
    return s;
  }
  s = s.write("    adrp x1, __fern_alloc_count\n");
  s = s.write("    add x1, x1, :lo12:__fern_alloc_count\n");
  s = s.write("    ldr x2, [x1]\n");
  s = s.write("    add x2, x2, #1\n");
  s = s.write("    str x2, [x1]\n");
  return s;
}

function lc_bump_alloc(s: asmcore.EmitState): asmcore.EmitState {
  return lc_bump_alloc_add(s, "x0", "x1", "x2");
}

function lc_bump_alloc_add(s: asmcore.EmitState, addend: string, t1: string, t2: string): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  s = s.write("    adrp " + t1 + ", __fern_lc_alloc_count\n");
  s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_alloc_count\n");
  s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
  s = s.write("    add " + t2 + ", " + t2 + ", #1\n");
  s = s.write("    str " + t2 + ", [" + t1 + "]\n");
  s = s.write("    adrp " + t1 + ", __fern_lc_alloc_bytes\n");
  s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_alloc_bytes\n");
  s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
  s = s.write("    add " + t2 + ", " + t2 + ", " + addend + "\n");
  s = s.write("    str " + t2 + ", [" + t1 + "]\n");
  return s;
}

struct RegTriple { a: string, b: string, c: string }

function lc_grow_bytes(s: asmcore.EmitState, old: string, grown: string, t: RegTriple): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  s = s.write("    sub " + t.a + ", " + grown + ", " + old + "\n");
  s = s.write("    adrp " + t.b + ", __fern_lc_alloc_bytes\n");
  s = s.write("    add " + t.b + ", " + t.b + ", :lo12:__fern_lc_alloc_bytes\n");
  s = s.write("    ldr " + t.c + ", [" + t.b + "]\n");
  s = s.write("    add " + t.c + ", " + t.c + ", " + t.a + ", lsl #3\n");
  s = s.write("    str " + t.c + ", [" + t.b + "]\n");
  return s;
}

// A free counts only inside the census bounds, once heap_adopt has set
// them: a worker's child frees boxes of the parent's image, and those are
// the parent's to count. `box` holds the block. A program with no
// heap_adopt never sets the bounds, so it counts every free.
function lc_bump_free_add(s: asmcore.EmitState, addend: string, t1: string, t2: string, box: string): asmcore.EmitState {
  if (!s.leak_check) {
    return s;
  }
  if (!s.has_need("heap_adopt")) {
    return lc_bump_free_counted(s, addend, t1, t2);
  }
  let skip = asmcore.fresh_label(s);
  let count = asmcore.fresh_label(skip.state);
  s = count.state;
  s = s.write("    adrp " + t1 + ", __fern_lc_adopt_lo\n");
  s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_adopt_lo\n");
  s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
  s = s.write("    cbz " + t2 + ", " + count.name + "\n");
  s = s.write("    cmp " + box + ", " + t2 + "\n");
  s = s.write("    b.lo " + skip.name + "\n");
  s = s.write("    adrp " + t1 + ", __fern_lc_adopt_hi\n");
  s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_adopt_hi\n");
  s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
  s = s.write("    cmp " + box + ", " + t2 + "\n");
  s = s.write("    b.hs " + skip.name + "\n");
  s = s.write(count.name + ":\n");
  s = lc_bump_free_counted(s, addend, t1, t2);
  return s.write(skip.name + ":\n");
}

function lc_bump_free_counted(s: asmcore.EmitState, addend: string, t1: string, t2: string): asmcore.EmitState {
  s = s.write("    adrp " + t1 + ", __fern_lc_free_count\n");
  s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_free_count\n");
  s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
  s = s.write("    add " + t2 + ", " + t2 + ", #1\n");
  s = s.write("    str " + t2 + ", [" + t1 + "]\n");
  s = s.write("    adrp " + t1 + ", __fern_lc_free_bytes\n");
  s = s.write("    add " + t1 + ", " + t1 + ", :lo12:__fern_lc_free_bytes\n");
  s = s.write("    ldr " + t2 + ", [" + t1 + "]\n");
  s = s.write("    add " + t2 + ", " + t2 + ", " + addend + "\n");
  s = s.write("    str " + t2 + ", [" + t1 + "]\n");
  return s;
}

function lc_bump_free_words(s: asmcore.EmitState, words: string, t1: string, t2: string, box: string): asmcore.EmitState {
  return lc_bump_free_add(s, words + ", lsl #3", t1, t2, box);
}

function freelist_push(s: asmcore.EmitState, ptr: string, words: string, base: string, tmp: string): asmcore.EmitState {
  return freelist_push_classed(capw_class(s, words), ptr, words, base, tmp, "");
}

function capw_class(s: asmcore.EmitState, words: string): asmcore.EmitState {
  let l = asmcore.fresh_label(s);
  s = l.state.write("    cmp " + words + ", #256\n");
  s = s.write("    b.ls " + l.name + "\n");
  s = s.write(rt_save_lr(s, words));
  s = s.write("    bl __fern_capw\n");
  s = s.write(rt_restore_lr(s, words));
  return s.write(l.name + ":\n");
}

// Pushes ptr on the free list of its class. With `twice` set, a block that is
// already the head of the list branches to that label instead.
function freelist_push_classed(s: asmcore.EmitState, ptr: string, words: string, base: string, tmp: string, twice: string): asmcore.EmitState {
  return freelist_push_slot(s, ptr, words + ", lsl #3", base, base + ", " + words + ", lsl #3", tmp, twice);
}

// Pushes ptr on the free list whose head is at `slot`, an address over the
// list table in `base`. `size` is the block's byte size as an add operand.
function freelist_push_slot(s: asmcore.EmitState, ptr: string, size: string, base: string, slot: string, tmp: string, twice: string): asmcore.EmitState {
  s = freelist_scrub(s, ptr, size, base, tmp);
  s = s.write("    adrp " + base + ", __fern_freelist\n");
  s = s.write("    add " + base + ", " + base + ", :lo12:__fern_freelist\n");
  s = s.write("    ldr " + tmp + ", [" + slot + "]\n");
  if (twice != "") {
    s = freelist_twice_check(s, tmp, ptr, twice);
  }
  s = freelist_encode(s, ptr, tmp);
  s = s.write("    str " + tmp + ", [" + ptr + "]\n");
  return s.write("    str " + ptr + ", [" + slot + "]\n");
}

// Under -harden, zeroes the block at ptr from its second word to `size` bytes
// before its push, so a released block keeps no bytes of its owner. `cur`
// and `end` are scratch.
function freelist_scrub(s: asmcore.EmitState, ptr: string, size: string, cur: string, end: string): asmcore.EmitState {
  if (!s.harden) {
    return s;
  }
  let l = asmcore.fresh_label(s);
  s = l.state.write("    add " + cur + ", " + ptr + ", #8\n    add " + end + ", " + ptr + ", " + size + "\n");
  s = s.write(l.name + ":\n    cmp " + cur + ", " + end + "\n    b.hs " + l.name + "_done\n");
  return s.write("    str xzr, [" + cur + "], #8\n    b " + l.name + "\n" + l.name + "_done:\n");
}

// Branches to `twice` when `ptr` is already on the free list whose head is in
// `head`. The release build compares the head alone. -harden walks the first
// 64 blocks through freelist_next, so a second free with other frees of the
// class between the two aborts too. x11 to x13 are kept, and x16 is scratch.
function freelist_twice_check(s: asmcore.EmitState, head: string, ptr: string, twice: string): asmcore.EmitState {
  if (!s.harden) {
    return s.write("    cmp " + head + ", " + ptr + "\n    b.eq " + twice + "\n");
  }
  let l = asmcore.fresh_label(s);
  let n = l.name;
  let restore = "    ldr x13, [sp, #16]\n    ldp x11, x12, [sp], #32\n";
  s = l.state.write("    stp x11, x12, [sp, #-32]!\n    str x13, [sp, #16]\n    mov x11, " + head + "\n    mov x13, #64\n");
  s = s.write(n + "_loop:\n    cbz x11, " + n + "_done\n    cmp x11, " + ptr + "\n    b.eq " + n + "_hit\n");
  s = freelist_next(s, "x11", "x12");
  s = s.write("    mov x11, x12\n    subs x13, x13, #1\n    b.ne " + n + "_loop\n");
  s = s.write(n + "_done:\n" + restore + "    b " + n + "_out\n" + n + "_hit:\n" + restore + "    b " + twice + "\n");
  return s.write(n + "_out:\n");
}

// Frees the block at ptr of words words. With `raw` the block is a raw release,
// and a block that is already the head of its list aborts as a double free.
function buf_block_free(s: asmcore.EmitState, ptr: string, words: string, lbl: string, raw: boolean): asmcore.EmitState {
  s = s.write("    mov x9, #0x10000\n");
  s = s.write("    cmp " + words + ", x9\n");
  s = s.write("    b.hs ." + lbl + "_large\n");
  s = lc_bump_free_words(s, words, "x3", "x10", ptr);
  if (!s.rc_free_debug && raw) {
    s = freelist_push_classed(capw_class(s, words), ptr, words, "x3", "x10", "__fern_double_free_abort");
  } else if (!s.rc_free_debug) {
    s = freelist_push(s, ptr, words, "x3", "x10");
  } else {
    s = quar_push(s, ptr, words, 16);
  }
  s = s.write("    b ." + lbl + "_done\n");
  s = s.write("." + lbl + "_large:\n");
  if (s.rc_free_debug) {
    s = lc_bump_free_words(s, words, "x3", "x10", ptr);
    s = quar_push(s, ptr, words, 16);
  } else {
    s = s.write("    mov x1, " + ptr + "\n");
    s = s.write("    lsl x2, " + words + ", #3\n");
    s = s.write("    bl __fern_large_push\n");
  }
  s = s.write("." + lbl + "_done:\n");
  return s;
}

function emit_buf_push_bytes_range(s: asmcore.EmitState, packed: boolean): asmcore.EmitState {
  let suffix = asmcore.packed_suffix(packed);
  let sym = "__fern_buf_push_bytes_range" + suffix;
  let label = ".Lbufbyterange" + suffix;
  s = s.write(".globl " + sym + "\n.type " + sym + ", %function\n" + sym + ":\n");
  s = s.write(rt_frame_of(s, 48) + "    mov x29, sp\n    stp x19, x20, [sp, #16]\n    stp x21, x22, [sp, #32]\n");
  s = s.write("    mov x19, x0\n    mov x20, x1\n    sxtw x21, w2\n    sxtw x22, w3\n    cmp x21, #0\n    csel x21, x21, xzr, ge\n    ldr x9, [x20]\n    cmp x22, x9\n    csel x22, x22, x9, le\n");
  s = s.write("    sub x22, x22, x21\n    cmp x22, #0\n    b.le " + label + "_done\n    ldr x1, [x19, #8]\n    add x1, x1, x22\n    ldr x9, [x19, #16]\n    cmp x1, x9\n    b.ls " + label + "_fits\n    bl __fern_buf_reserve\n" + label + "_fits:\n");
  s = s.write("    ldr x3, [x19]\n    ldr x9, [x19, #8]\n    add x3, x3, x9\n    add x9, x9, x22\n    str x9, [x19, #8]\n    add x1, x20, #8\n    mov x2, x22\n");
  if (packed) {
    s = s.write("    add x1, x1, x21\n");
    s = arm64_copy_bytes(s, CopyRegs { dst: "x3", src: "x1", n: "x2", tmp: "x9", src_end: "x10", dst_end: "x11" }, label + "_words", label + "_tail", label + "_bytes", label + "_done");
  } else {
    s = s.write("    add x1, x1, x21, lsl #3\n" + label + "_copy:\n    ldrb w9, [x1], #8\n    strb w9, [x3], #1\n    subs x2, x2, #1\n    b.ne " + label + "_copy\n" + label + "_done:\n");
  }
  s = s.write("    mov x0, #0\n    ldp x21, x22, [sp, #32]\n    ldp x19, x20, [sp, #16]\n" + rt_unframe_of(s, 48) + "    ret\n.size " + sym + ", .-" + sym + "\n");
  return s;
}

function emit_buf_take_bytes(s: asmcore.EmitState, packed: boolean): asmcore.EmitState {
  let suffix = asmcore.packed_suffix(packed);
  let sym = "__fern_buf_take_bytes" + suffix;
  let done = ".Lbufbytes_done" + suffix;
  let copy_loop = ".Lbufbytes_loop" + suffix;
  s = s.write(".globl " + sym + "\n.type " + sym + ", %function\n" + sym + ":\n");
  s = s.write(rt_frame(s));
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    ldr x20, [x19, #8]\n");
  s = s.write("    mov x0, x20\n");
  if (packed) {
    s = s.write("    add x0, x0, #7\n    lsr x0, x0, #3\n");
  }
  s = s.write("    bl __fern_arr_box\n    mov x21, x0\n    str x20, [x21]\n    ldr x1, [x19]\n");
  if (packed) {
    s = s.write("    add x3, x21, #8\n    mov x2, x20\n");
    s = arm64_copy_bytes(s, CopyRegs { dst: "x3", src: "x1", n: "x2", tmp: "x9", src_end: "x10", dst_end: "x11" }, copy_loop + "_w", copy_loop + "_t", copy_loop + "_b", done);
  } else {
    s = s.write("    mov x2, #0\n    add x3, x21, #8\n" + copy_loop + ":\n    cmp x2, x20\n    b.hs " + done + "\n");
    s = s.write("    ldrb w9, [x1, x2]\n    str x9, [x3, x2, lsl #3]\n    add x2, x2, #1\n    b " + copy_loop + "\n" + done + ":\n");
  }
  s = s.write("    str xzr, [x19, #8]\n    mov x0, x21\n    ldp x21, x22, [sp], #16\n    ldp x19, x20, [sp], #16\n" + rt_unframe(s) + "    ret\n.size " + sym + ", .-" + sym + "\n");
  return s;
}

function emit_buf_mapped_neon(s: asmcore.EmitState, lm: string): asmcore.EmitState {
  s = s.write("    cmp x2, #16\n");
  s = s.write("    b.lo " + lm + "_full\n");
  s = s.write("    add x6, x21, #8\n");
  let r = 0;
  while (r < 8) {
    s = s.write("    ldp q" + util.i32_to_string(16 + 2 * r) + ", q" + util.i32_to_string(17 + 2 * r) + ", [x6, #" + util.i32_to_string(32 * r) + "]\n");
    r += 1;
  }
  s = s.write("    movi v7.16b, #64\n");
  s = s.write(lm + "_vec:\n");
  s = s.write("    ldr q0, [x1], #16\n");
  s = s.write("    tbl v1.16b, {v16.16b-v19.16b}, v0.16b\n");
  s = s.write("    sub v0.16b, v0.16b, v7.16b\n");
  s = s.write("    tbx v1.16b, {v20.16b-v23.16b}, v0.16b\n");
  s = s.write("    sub v0.16b, v0.16b, v7.16b\n");
  s = s.write("    tbx v1.16b, {v24.16b-v27.16b}, v0.16b\n");
  s = s.write("    sub v0.16b, v0.16b, v7.16b\n");
  s = s.write("    tbx v1.16b, {v28.16b-v31.16b}, v0.16b\n");
  s = s.write("    str q1, [x3], #16\n");
  s = s.write("    sub x2, x2, #16\n");
  s = s.write("    cmp x2, #16\n");
  s = s.write("    b.hs " + lm + "_vec\n");
  return s.write("    cbz x2, " + lm + "_len\n");
}

// __fern_buf_push_base64(h, src, lo, hi, alpha) appends four characters of
// the 64-byte alphabet for each whole group of three bytes in src[lo..hi).
// ld3 splits 48 bytes into their three byte streams, shifts form the four
// 6-bit fields, one tbl over the four alphabet registers maps each field, and
// st4 interleaves the 64 characters. A tail encodes one group at a time.
function emit_buf_push_base64(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(".globl __fern_buf_push_base64\n.type __fern_buf_push_base64, %function\n__fern_buf_push_base64:\n");
  s = s.write("    sxtw x2, w2\n    sxtw x3, w3\n    cmp x2, #0\n    csel x2, xzr, x2, lt\n    ldr x5, [x1]\n    cmp x3, x5\n    csel x3, x5, x3, gt\n    subs x3, x3, x2\n    b.le .Lb64_done\n");
  s = s.write("    mov w6, #0xaaab\n    movk w6, #0xaaaa, lsl #16\n    umull x6, w3, w6\n    lsr x6, x6, #33\n    cbz x6, .Lb64_done\n");
  s = s.write("    ldr x5, [x4]\n    cmp x5, #64\n    b.lo __fern_oob_abort\n");
  s = s.write("    add x7, x6, x6, lsl #1\n    lsl x6, x6, #2\n    ldr x9, [x0, #8]\n    add x10, x9, x6\n    ldr x11, [x0, #16]\n    cmp x10, x11\n    b.hi .Lb64_grow\n");
  s = s.write(".Lb64_fits:\n    str x10, [x0, #8]\n    ldr x12, [x0]\n    add x12, x12, x9\n    add x13, x1, #8\n    add x13, x13, x2\n    add x14, x4, #8\n");
  s = s.write("    ld1 {v16.16b-v19.16b}, [x14]\n    cmp x7, #48\n    b.lo .Lb64_tail\n");
  s = s.write("    movi v20.16b, #0x3f\n    movi v21.16b, #0x03\n    movi v22.16b, #0x0f\n");
  s = s.write(".Lb64_vec:\n    ld3 {v0.16b-v2.16b}, [x13], #48\n    ushr v3.16b, v0.16b, #2\n");
  s = s.write("    and v4.16b, v0.16b, v21.16b\n    shl v4.16b, v4.16b, #4\n    ushr v5.16b, v1.16b, #4\n    orr v4.16b, v4.16b, v5.16b\n");
  s = s.write("    and v5.16b, v1.16b, v22.16b\n    shl v5.16b, v5.16b, #2\n    ushr v6.16b, v2.16b, #6\n    orr v5.16b, v5.16b, v6.16b\n");
  s = s.write("    and v6.16b, v2.16b, v20.16b\n");
  s = s.write("    tbl v24.16b, {v16.16b-v19.16b}, v3.16b\n    tbl v25.16b, {v16.16b-v19.16b}, v4.16b\n");
  s = s.write("    tbl v26.16b, {v16.16b-v19.16b}, v5.16b\n    tbl v27.16b, {v16.16b-v19.16b}, v6.16b\n");
  s = s.write("    st4 {v24.16b-v27.16b}, [x12], #64\n    sub x7, x7, #48\n    cmp x7, #48\n    b.hs .Lb64_vec\n");
  s = s.write(".Lb64_tail:\n    cbz x7, .Lb64_done\n");
  s = s.write(".Lb64_one:\n    ldrb w5, [x13]\n    ldrb w8, [x13, #1]\n    ldrb w15, [x13, #2]\n    lsl w5, w5, #16\n    orr w5, w5, w8, lsl #8\n    orr w5, w5, w15\n");
  s = s.write("    lsr w8, w5, #18\n    ldrb w8, [x14, x8]\n    strb w8, [x12]\n");
  s = s.write("    ubfx w8, w5, #12, #6\n    ldrb w8, [x14, x8]\n    strb w8, [x12, #1]\n");
  s = s.write("    ubfx w8, w5, #6, #6\n    ldrb w8, [x14, x8]\n    strb w8, [x12, #2]\n");
  s = s.write("    and w8, w5, #63\n    ldrb w8, [x14, x8]\n    strb w8, [x12, #3]\n");
  s = s.write("    add x13, x13, #3\n    add x12, x12, #4\n    subs x7, x7, #3\n    b.ne .Lb64_one\n");
  s = s.write(".Lb64_done:\n    mov x0, #0\n    ret\n");
  s = s.write(".Lb64_grow:\n" + rt_frame_of(s, 64) + "    mov x29, sp\n    stp x0, x1, [sp, #16]\n    stp x2, x4, [sp, #32]\n    stp x6, x7, [sp, #48]\n");
  s = s.write("    mov x1, x10\n    bl __fern_buf_reserve\n    ldp x0, x1, [sp, #16]\n    ldp x2, x4, [sp, #32]\n    ldp x6, x7, [sp, #48]\n" + rt_unframe_of(s, 64));
  s = s.write("    ldr x9, [x0, #8]\n    add x10, x9, x6\n    b .Lb64_fits\n");
  return s.write(".size __fern_buf_push_base64, .-__fern_buf_push_base64\n");
}

// Each pass loads 32 bytes and takes four groups of five from them. A load may
// pass hi but not the array's end. tbl puts
// the two bytes under each 5-bit field in a halfword, and ushl shifts each
// halfword right by its own amount.
function emit_buf_push_base32(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(".globl __fern_buf_push_base32\n.type __fern_buf_push_base32, %function\n__fern_buf_push_base32:\n");
  s = s.write("    sxtw x2, w2\n    sxtw x3, w3\n    cmp x2, #0\n    csel x2, xzr, x2, lt\n    ldr x5, [x1]\n    cmp x3, x5\n    csel x3, x5, x3, gt\n    subs x3, x3, x2\n    b.le .Lb32_done\n");
  s = s.write("    mov w6, #0xcccd\n    movk w6, #0xcccc, lsl #16\n    umull x6, w3, w6\n    lsr x6, x6, #34\n    cbz x6, .Lb32_done\n");
  s = s.write("    ldr x5, [x4]\n    cmp x5, #32\n    b.lo __fern_oob_abort\n");
  s = s.write("    add x7, x6, x6, lsl #2\n    lsl x6, x6, #3\n    ldr x9, [x0, #8]\n    add x10, x9, x6\n    ldr x11, [x0, #16]\n    cmp x10, x11\n    b.hi .Lb32_grow\n");
  s = s.write(".Lb32_fits:\n    str x10, [x0, #8]\n    ldr x12, [x0]\n    add x12, x12, x9\n    add x13, x1, #8\n    add x13, x13, x2\n    add x14, x4, #8\n");
  s = s.write("    ld1 {v16.16b-v17.16b}, [x14]\n    ldr x16, [x1]\n    add x16, x1, x16\n    sub x16, x16, #24\n    cmp x7, #20\n    b.lo .Lb32_tail\n    cmp x13, x16\n    b.hi .Lb32_tail\n");
  s = s.write("    adrp x15, .Lb32_consts\n    add x15, x15, :lo12:.Lb32_consts\n    ld1 {v20.16b-v23.16b}, [x15], #64\n    ld1 {v24.16b-v25.16b}, [x15]\n");
  s = s.write(".Lb32_vec:\n    ld1 {v0.16b-v1.16b}, [x13]\n");
  s = s.write("    tbl v2.16b, {v0.16b-v1.16b}, v20.16b\n    tbl v3.16b, {v0.16b-v1.16b}, v21.16b\n    tbl v4.16b, {v0.16b-v1.16b}, v22.16b\n    tbl v5.16b, {v0.16b-v1.16b}, v23.16b\n");
  s = s.write("    ushl v2.8h, v2.8h, v24.8h\n    ushl v3.8h, v3.8h, v24.8h\n    ushl v4.8h, v4.8h, v24.8h\n    ushl v5.8h, v5.8h, v24.8h\n");
  s = s.write("    and v2.16b, v2.16b, v25.16b\n    and v3.16b, v3.16b, v25.16b\n    and v4.16b, v4.16b, v25.16b\n    and v5.16b, v5.16b, v25.16b\n");
  s = s.write("    uzp1 v6.16b, v2.16b, v3.16b\n    uzp1 v7.16b, v4.16b, v5.16b\n");
  s = s.write("    tbl v26.16b, {v16.16b-v17.16b}, v6.16b\n    tbl v27.16b, {v16.16b-v17.16b}, v7.16b\n");
  s = s.write("    st1 {v26.16b-v27.16b}, [x12], #32\n    add x13, x13, #20\n    sub x7, x7, #20\n    cmp x7, #20\n    b.lo .Lb32_tail\n    cmp x13, x16\n    b.ls .Lb32_vec\n");
  s = s.write(".Lb32_tail:\n    cbz x7, .Lb32_done\n");
  s = s.write(".Lb32_one:\n    ldrb w5, [x13]\n");
  for k in 1..5 {
    s = s.write("    ldrb w8, [x13, #" + util.i32_to_string(k) + "]\n    orr x5, x8, x5, lsl #8\n");
  }
  for k in 0..8 {
    s = s.write("    ubfx x8, x5, #" + util.i32_to_string(35 - k * 5) + ", #5\n    ldrb w8, [x14, x8]\n    strb w8, [x12, #" + util.i32_to_string(k) + "]\n");
  }
  s = s.write("    add x13, x13, #5\n    add x12, x12, #8\n    subs x7, x7, #5\n    b.ne .Lb32_one\n");
  s = s.write(".Lb32_done:\n    mov x0, #0\n    ret\n");
  s = s.write(".Lb32_grow:\n" + rt_frame_of(s, 64) + "    mov x29, sp\n    stp x0, x1, [sp, #16]\n    stp x2, x4, [sp, #32]\n    stp x6, x7, [sp, #48]\n");
  s = s.write("    mov x1, x10\n    bl __fern_buf_reserve\n    ldp x0, x1, [sp, #16]\n    ldp x2, x4, [sp, #32]\n    ldp x6, x7, [sp, #48]\n" + rt_unframe_of(s, 64));
  s = s.write("    ldr x9, [x0, #8]\n    add x10, x9, x6\n    b .Lb32_fits\n");
  s = s.write(".size __fern_buf_push_base32, .-__fern_buf_push_base32\n");
  s = s.write("    .section .rodata\n.Lb32_consts:\n");
  for o in [0, 5, 10, 15] {
    s = s.write("    .byte " + base32_spread(o) + "\n");
  }
  s = s.write("    .byte 245, 255, 250, 255, 247, 255, 252, 255, 249, 255, 246, 255, 251, 255, 248, 255\n");
  s = s.write("    .byte 31, 0, 31, 0, 31, 0, 31, 0, 31, 0, 31, 0, 31, 0, 31, 0\n");
  return s.write("    .text\n");
}

// The tbl indices that put the two bytes under each field of the group at
// `at` in one halfword, high byte first. 255 reads as zero.
function base32_spread(at: i32): string {
  let lows: i32[] = [1, 1, 2, 2, 3, 4, 4, 255];
  let highs: i32[] = [0, 0, 1, 1, 2, 3, 3, 4];
  let out = "";
  for k in 0..8 {
    let low: i32 = if (lows[k] == 255) { 255 } else { lows[k] + at };
    if (k > 0) {
      out += ", ";
    }
    out = out + util.i32_to_string(low) + ", " + util.i32_to_string(highs[k] + at);
  }
  return out;
}

// Each pass checks 16 characters against the two ranges and packs them to 10
// bytes with shifts at halfword, word and doubleword width. A store writes 16
// bytes, so the reserve keeps 16 bytes past the decoded length.
function emit_buf_decode_base32(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(".globl __fern_buf_decode_base32\n.type __fern_buf_decode_base32, %function\n__fern_buf_decode_base32:\n");
  s = s.write("    sxtw x2, w2\n    sxtw x3, w3\n    cmp x2, #0\n    csel x2, xzr, x2, lt\n    ldr x5, [x1]\n    cmp x3, x5\n    csel x3, x5, x3, gt\n    sub x7, x3, x2\n    cmp x7, #8\n    b.lt .Ld32_none\n");
  s = s.write("    ldr x5, [x4]\n    cmp x5, #4\n    b.lo __fern_oob_abort\n");
  s = s.write("    lsr x6, x7, #3\n    add x6, x6, x6, lsl #2\n    add x6, x6, #16\n    ldr x9, [x0, #8]\n    add x10, x9, x6\n    ldr x11, [x0, #16]\n    cmp x10, x11\n    b.hi .Ld32_grow\n");
  s = s.write(".Ld32_fits:\n    ldr x12, [x0]\n    add x12, x12, x9\n    add x14, x1, #8\n    add x13, x14, x2\n    lsr x7, x7, #3\n    lsl x7, x7, #3\n");
  s = s.write("    ldrb w9, [x4, #8]\n    ldrb w10, [x4, #9]\n    ldrb w11, [x4, #10]\n    ldrb w15, [x4, #11]\n    cmp x7, #16\n    b.lo .Ld32_group\n");
  s = s.write("    dup v20.16b, w9\n    dup v21.16b, w10\n    dup v22.16b, w11\n    dup v23.16b, w15\n");
  s = s.write("    adrp x16, .Ld32_order\n    add x16, x16, :lo12:.Ld32_order\n    ld1 {v24.16b}, [x16]\n");
  s = s.write(".Ld32_vec:\n    ld1 {v0.16b}, [x13]\n    sub v1.16b, v0.16b, v20.16b\n    cmhi v2.16b, v21.16b, v1.16b\n");
  s = s.write("    sub v3.16b, v0.16b, v22.16b\n    cmhi v4.16b, v23.16b, v3.16b\n    add v3.16b, v3.16b, v21.16b\n");
  s = s.write("    and v1.16b, v1.16b, v2.16b\n    and v3.16b, v3.16b, v4.16b\n    orr v1.16b, v1.16b, v3.16b\n    orr v2.16b, v2.16b, v4.16b\n");
  s = s.write("    uminv b5, v2.16b\n    umov w5, v5.b[0]\n    cbz w5, .Ld32_group\n");
  s = s.write("    ushr v2.8h, v1.8h, #8\n    shl v1.8h, v1.8h, #8\n    ushr v1.8h, v1.8h, #3\n    orr v1.16b, v1.16b, v2.16b\n");
  s = s.write("    ushr v2.4s, v1.4s, #16\n    shl v1.4s, v1.4s, #16\n    ushr v1.4s, v1.4s, #6\n    orr v1.16b, v1.16b, v2.16b\n");
  s = s.write("    ushr v2.2d, v1.2d, #32\n    shl v1.2d, v1.2d, #32\n    ushr v1.2d, v1.2d, #12\n    orr v1.16b, v1.16b, v2.16b\n");
  s = s.write("    tbl v1.16b, {v1.16b}, v24.16b\n    st1 {v1.16b}, [x12]\n");
  s = s.write("    add x12, x12, #10\n    add x13, x13, #16\n    sub x7, x7, #16\n    cmp x7, #16\n    b.hs .Ld32_vec\n");
  s = s.write(".Ld32_group:\n    cmp x7, #8\n    b.lo .Ld32_stop\n    mov x5, #0\n    mov x6, #0\n");
  s = s.write(".Ld32_char:\n    ldrb w8, [x13, x6]\n    sub w16, w8, w9\n    cmp w16, w10\n    b.lo .Ld32_val\n");
  s = s.write("    sub w16, w8, w11\n    cmp w16, w15\n    b.hs .Ld32_stop\n    add w16, w16, w10\n");
  s = s.write(".Ld32_val:\n    orr x5, x16, x5, lsl #5\n    add x6, x6, #1\n    cmp x6, #8\n    b.lo .Ld32_char\n");
  s = s.write("    lsl x5, x5, #24\n    rev x5, x5\n    str x5, [x12]\n    add x12, x12, #5\n    add x13, x13, #8\n    sub x7, x7, #8\n    b .Ld32_group\n");
  s = s.write(".Ld32_stop:\n    ldr x9, [x0]\n    sub x9, x12, x9\n    str x9, [x0, #8]\n    sub x0, x13, x14\n    ret\n");
  s = s.write(".Ld32_none:\n    mov x0, x2\n    ret\n");
  s = s.write(".Ld32_grow:\n" + rt_frame_of(s, 64) + "    mov x29, sp\n    stp x0, x1, [sp, #16]\n    stp x2, x4, [sp, #32]\n    str x7, [sp, #48]\n");
  s = s.write("    mov x1, x10\n    bl __fern_buf_reserve\n    ldp x0, x1, [sp, #16]\n    ldp x2, x4, [sp, #32]\n    ldr x7, [sp, #48]\n" + rt_unframe_of(s, 64));
  s = s.write("    ldr x9, [x0, #8]\n    b .Ld32_fits\n");
  s = s.write(".size __fern_buf_decode_base32, .-__fern_buf_decode_base32\n");
  s = s.write("    .section .rodata\n.Ld32_order:\n    .byte 4, 3, 2, 1, 0, 12, 11, 10, 9, 8, 255, 255, 255, 255, 255, 255\n");
  return s.write("    .text\n");
}

// __fern_buf_push_decimal(h, n) appends the decimal digits of the u64 n. It
// writes them back to front into a stack scratch, two at a time from a table
// of digit pairs, and divides by 100 with a multiply.
function emit_buf_push_decimal(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write(".globl __fern_buf_push_decimal\n");
  s = s.write(".type __fern_buf_push_decimal, %function\n");
  s = s.write("__fern_buf_push_decimal:\n");
  s = s.write(rt_frame_of(s, 64));
  s = s.write("    mov x29, sp\n");
  s = s.write("    add x8, sp, #40\n");
  s = s.write("    adrp x11, .Ldecimal_pairs\n");
  s = s.write("    add x11, x11, :lo12:.Ldecimal_pairs\n");
  s = s.write("    mov x9, #0xf5c3\n");
  s = s.write("    movk x9, #0x5c28, lsl #16\n");
  s = s.write("    movk x9, #0xc28f, lsl #32\n");
  s = s.write("    movk x9, #0x28f5, lsl #48\n");
  s = s.write("    mov x12, #100\n");
  s = s.write(".Ldecimal_loop:\n");
  s = s.write("    cmp x1, #100\n");
  s = s.write("    b.lo .Ldecimal_tail\n");
  s = s.write("    lsr x10, x1, #2\n");
  s = s.write("    umulh x10, x10, x9\n");
  s = s.write("    lsr x10, x10, #2\n");
  s = s.write("    msub x13, x10, x12, x1\n");
  s = s.write("    ldrh w13, [x11, x13, lsl #1]\n");
  s = s.write("    sub x8, x8, #2\n");
  s = s.write("    strh w13, [x8]\n");
  s = s.write("    mov x1, x10\n");
  s = s.write("    b .Ldecimal_loop\n");
  s = s.write(".Ldecimal_tail:\n");
  s = s.write("    cmp x1, #10\n");
  s = s.write("    b.lo .Ldecimal_one\n");
  s = s.write("    ldrh w13, [x11, x1, lsl #1]\n");
  s = s.write("    sub x8, x8, #2\n");
  s = s.write("    strh w13, [x8]\n");
  s = s.write("    b .Ldecimal_copy\n");
  s = s.write(".Ldecimal_one:\n");
  s = s.write("    add w13, w1, #48\n");
  s = s.write("    sub x8, x8, #1\n");
  s = s.write("    strb w13, [x8]\n");
  s = s.write(".Ldecimal_copy:\n");
  s = s.write("    add x2, sp, #40\n");
  s = s.write("    sub x2, x2, x8\n");
  s = s.write("    ldr x3, [x0, #8]\n");
  s = s.write("    add x4, x3, x2\n");
  s = s.write("    ldr x5, [x0, #16]\n");
  s = s.write("    cmp x4, x5\n");
  s = s.write("    b.hi .Ldecimal_grow\n");
  s = s.write(".Ldecimal_fits:\n");
  s = s.write("    str x4, [x0, #8]\n");
  s = s.write("    ldr x5, [x0]\n");
  s = s.write("    add x5, x5, x3\n");
  s = s.write(".Ldecimal_byte:\n");
  s = s.write("    ldrb w6, [x8], #1\n");
  s = s.write("    strb w6, [x5], #1\n");
  s = s.write("    subs x2, x2, #1\n");
  s = s.write("    b.ne .Ldecimal_byte\n");
  s = s.write(rt_unframe_of(s, 64));
  s = s.write("    ret\n");
  s = s.write(".Ldecimal_grow:\n");
  s = s.write("    str x0, [sp, #40]\n");
  s = s.write("    stp x2, x8, [sp, #48]\n");
  s = s.write("    mov x1, x4\n");
  s = s.write("    bl __fern_buf_reserve\n");
  s = s.write("    ldr x0, [sp, #40]\n");
  s = s.write("    ldp x2, x8, [sp, #48]\n");
  s = s.write("    ldr x3, [x0, #8]\n");
  s = s.write("    add x4, x3, x2\n");
  s = s.write("    b .Ldecimal_fits\n");
  s = s.write(".size __fern_buf_push_decimal, .-__fern_buf_push_decimal\n");
  s = s.write("    .section .rodata\n");
  s = s.write(".Ldecimal_pairs:\n");
  s = s.write("    .ascii \"" + asmcore.decimal_pairs() + "\"\n");
  return s.write("    .text\n");
}

function emit_buf_table_helpers(s: asmcore.EmitState, raw: boolean): asmcore.EmitState {
  let prefix = "__fern_buf_push_";
  let label = "";
  if (raw) {
    prefix += "bytes_";
    label = "_bytes";
  }
  let source_len = "    ldr x22, [x20, #8]\n";
  let source_data = "    ldr x1, [x20]\n";
  if (raw) {
    source_len = "    ldr x22, [x20]\n";
    source_data = "    add x1, x20, #8\n";
  }
  let lm = ".Lbufmap" + label;
  let lf = ".Lbuffilt" + label;
  let le = ".Lbufexp" + label;
  s = s.write(".globl " + prefix + "mapped\n");
  s = s.write(".type " + prefix + "mapped, %function\n");
  s = s.write(prefix + "mapped:\n");
  s = s.write(rt_frame(s));
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    mov x20, x1\n");
  s = s.write("    mov x21, x2\n");
  s = s.write(source_len);
  s = s.write("    cbz x22, " + lm + "_done\n");
  s = s.write("    ldr x0, [x19, #8]\n");
  s = s.write("    add x0, x0, x22\n");
  s = s.write("    ldr x1, [x19, #16]\n");
  s = s.write("    cmp x0, x1\n");
  s = s.write("    b.ls " + lm + "_fits\n");
  s = s.write("    mov x1, x0\n");
  s = s.write("    mov x0, x19\n");
  s = s.write("    bl __fern_buf_reserve\n");
  s = s.write(lm + "_fits:\n");
  s = s.write(source_data);
  s = s.write("    ldr x3, [x19]\n");
  s = s.write("    ldr x4, [x19, #8]\n");
  s = s.write("    add x3, x3, x4\n");
  s = s.write("    ldr x4, [x21]\n");
  s = s.write("    mov x2, x22\n");
  s = s.write("    cmp x4, #256\n");
  s = s.write("    b.lo " + lm + "_short\n");
  s = emit_buf_mapped_neon(s, lm);
  s = s.write(lm + "_full:\n");
  s = s.write("    ldrb w5, [x1], #1\n");
  s = s.write("    add x6, x21, x5\n");
  s = s.write("    ldrb w5, [x6, #8]\n");
  s = s.write("    strb w5, [x3], #1\n");
  s = s.write("    sub x2, x2, #1\n");
  s = s.write("    cbnz x2, " + lm + "_full\n");
  s = s.write("    b " + lm + "_len\n");
  s = s.write(lm + "_short:\n");
  s = s.write("    ldrb w5, [x1], #1\n");
  s = s.write("    cmp x5, x4\n");
  s = s.write("    b.hs " + lm + "_keep\n");
  s = s.write("    add x6, x21, x5\n");
  s = s.write("    ldrb w5, [x6, #8]\n");
  s = s.write(lm + "_keep:\n");
  s = s.write("    strb w5, [x3], #1\n");
  s = s.write("    sub x2, x2, #1\n");
  s = s.write("    cbnz x2, " + lm + "_short\n");
  s = s.write(lm + "_len:\n");
  s = s.write("    ldr x0, [x19, #8]\n");
  s = s.write("    add x0, x0, x22\n");
  s = s.write("    str x0, [x19, #8]\n");
  s = s.write(lm + "_done:\n");
  s = s.write("    ldp x21, x22, [sp], #16\n");
  s = s.write("    ldp x19, x20, [sp], #16\n");
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  s = s.write(".size " + prefix + "mapped, .-" + prefix + "mapped\n");
  s = s.write(".globl " + prefix + "filtered\n");
  s = s.write(".type " + prefix + "filtered, %function\n");
  s = s.write(prefix + "filtered:\n");
  s = s.write(rt_frame(s));
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    mov x20, x1\n");
  s = s.write("    mov x21, x2\n");
  s = s.write(source_len);
  s = s.write("    cbz x22, " + lf + "_done\n");
  s = s.write("    ldr x0, [x19, #8]\n");
  s = s.write("    add x0, x0, x22\n");
  s = s.write("    ldr x1, [x19, #16]\n");
  s = s.write("    cmp x0, x1\n");
  s = s.write("    b.ls " + lf + "_fits\n");
  s = s.write("    mov x1, x0\n");
  s = s.write("    mov x0, x19\n");
  s = s.write("    bl __fern_buf_reserve\n");
  s = s.write(lf + "_fits:\n");
  s = s.write(source_data);
  s = s.write("    ldr x3, [x19]\n");
  s = s.write("    ldr x4, [x19, #8]\n");
  s = s.write("    add x3, x3, x4\n");
  s = s.write("    ldr x4, [x21]\n");
  s = s.write("    mov x2, x22\n");
  s = s.write("    mov x7, #0\n");
  s = s.write("    cmp x4, #256\n");
  s = s.write("    b.lo " + lf + "_loop\n");
  s = s.write(lf + "_full:\n");
  s = s.write("    ldrb w5, [x1], #1\n");
  s = s.write("    add x6, x21, x5\n");
  s = s.write("    ldrb w6, [x6, #8]\n");
  s = s.write("    strb w5, [x3, x7]\n");
  s = s.write("    cmp w6, #0\n");
  s = s.write("    cinc x7, x7, eq\n");
  s = s.write("    sub x2, x2, #1\n");
  s = s.write("    cbnz x2, " + lf + "_full\n");
  s = s.write("    b " + lf + "_len\n");
  s = s.write(lf + "_loop:\n");
  s = s.write("    ldrb w5, [x1], #1\n");
  s = s.write("    cmp x5, x4\n");
  s = s.write("    b.hs " + lf + "_keep\n");
  s = s.write("    add x6, x21, x5\n");
  s = s.write("    ldrb w6, [x6, #8]\n");
  s = s.write("    cbnz w6, " + lf + "_next\n");
  s = s.write(lf + "_keep:\n");
  s = s.write("    strb w5, [x3], #1\n");
  s = s.write("    add x7, x7, #1\n");
  s = s.write(lf + "_next:\n");
  s = s.write("    sub x2, x2, #1\n");
  s = s.write("    cbnz x2, " + lf + "_loop\n");
  s = s.write(lf + "_len:\n");
  s = s.write("    ldr x0, [x19, #8]\n");
  s = s.write("    add x0, x0, x7\n");
  s = s.write("    str x0, [x19, #8]\n");
  s = s.write(lf + "_done:\n");
  s = s.write("    ldp x21, x22, [sp], #16\n");
  s = s.write("    ldp x19, x20, [sp], #16\n");
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  s = s.write(".size " + prefix + "filtered, .-" + prefix + "filtered\n");
  s = s.write(".globl " + prefix + "expanded\n");
  s = s.write(".type " + prefix + "expanded, %function\n");
  s = s.write(prefix + "expanded:\n");
  s = s.write(rt_frame(s));
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x19, x20, [sp, #-16]!\n");
  s = s.write("    stp x21, x22, [sp, #-16]!\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    mov x20, x1\n");
  s = s.write("    mov x21, x2\n");
  s = s.write(source_len);
  s = s.write("    cbz x22, " + le + "_done\n");
  s = s.write("    lsl x0, x22, #3\n");
  s = s.write("    add x0, x0, #8\n");
  s = s.write("    ldr x1, [x19, #8]\n");
  s = s.write("    add x0, x0, x1\n");
  s = s.write("    ldr x1, [x19, #16]\n");
  s = s.write("    cmp x0, x1\n");
  s = s.write("    b.ls " + le + "_fits\n");
  s = s.write("    mov x1, x0\n");
  s = s.write("    mov x0, x19\n");
  s = s.write("    bl __fern_buf_reserve\n");
  s = s.write(le + "_fits:\n");
  s = s.write(source_data);
  s = s.write("    ldr x3, [x19]\n");
  s = s.write("    ldr x4, [x19, #8]\n");
  s = s.write("    add x3, x3, x4\n");
  s = s.write("    ldr x4, [x21]\n");
  s = s.write("    lsr x4, x4, #3\n");
  s = s.write("    mov x2, x22\n");
  s = s.write("    cmp x4, #256\n    b.lo " + le + "_loop\n");
  s = s.write("    cmp x2, #256\n    b.lo " + le + "_loop\n");
  s = s.write("    sub sp, sp, #2048\n    add x6, x21, #8\n    mov x7, #0\n");
  s = s.write(le + "_pack:\n");
  s = s.write("    ldrb w8, [x6, x7]\n    strb w8, [sp, x7]\n");
  s = s.write("    add x7, x7, #1\n    cmp x7, #2048\n    b.lo " + le + "_pack\n");
  s = s.write("    mov x9, #7\n");
  s = s.write(le + "_fast:\n");
  s = s.write("    ldrb w5, [x1], #1\n    ldr x8, [sp, x5, lsl #3]\n");
  s = s.write("    and x7, x8, #255\n    cmp x7, x9\n    csel x7, x7, x9, ls\n");
  s = s.write("    lsr x8, x8, #8\n    str x8, [x3]\n    add x3, x3, x7\n");
  s = s.write("    subs x2, x2, #1\n    b.ne " + le + "_fast\n");
  s = s.write("    add sp, sp, #2048\n    b " + le + "_len\n");
  s = s.write(le + "_loop:\n");
  s = s.write("    cbz x2, " + le + "_len\n");
  s = s.write("    ldrb w5, [x1], #1\n");
  s = s.write("    cmp x5, x4\n");
  s = s.write("    b.hs " + le + "_keep\n");
  s = s.write("    add x6, x21, x5, lsl #3\n");
  s = s.write("    ldrb w7, [x6, #8]\n");
  s = s.write("    cmp x7, #7\n");
  s = s.write("    b.ls " + le + "_room\n");
  s = s.write("    mov x7, #7\n");
  s = s.write(le + "_room:\n");
  s = s.write("    add x6, x6, #9\n");
  s = s.write(le + "_byte:\n");
  s = s.write("    cbz x7, " + le + "_next\n");
  s = s.write("    ldrb w8, [x6], #1\n");
  s = s.write("    strb w8, [x3], #1\n");
  s = s.write("    sub x7, x7, #1\n");
  s = s.write("    b " + le + "_byte\n");
  s = s.write(le + "_keep:\n");
  s = s.write("    strb w5, [x3], #1\n");
  s = s.write(le + "_next:\n");
  s = s.write("    sub x2, x2, #1\n");
  s = s.write("    b " + le + "_loop\n");
  s = s.write(le + "_len:\n");
  s = s.write("    ldr x0, [x19]\n");
  s = s.write("    sub x3, x3, x0\n");
  s = s.write("    str x3, [x19, #8]\n");
  s = s.write(le + "_done:\n");
  s = s.write("    ldp x21, x22, [sp], #16\n");
  s = s.write("    ldp x19, x20, [sp], #16\n");
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  s = s.write(".size " + prefix + "expanded, .-" + prefix + "expanded\n");
  return s;
}

function mov_fused_marker(s: asmcore.EmitState, reg: string): asmcore.EmitState {
  s = s.write("    mov " + reg + ", #32781\n");
  return s.write("    movk " + reg + ", #29519, lsl #16\n");
}

function mov_borrowed_marker(s: asmcore.EmitState, reg: string): asmcore.EmitState {
  s = s.write("    mov " + reg + ", #0x5252\n");
  return s.write("    movk " + reg + ", #0x424F, lsl #16\n");
}

function mov_grown_marker(s: asmcore.EmitState, reg: string): asmcore.EmitState {
  s = s.write("    mov " + reg + ", #0x4F57\n");
  return s.write("    movk " + reg + ", #0x4752, lsl #16\n");
}

function abort_trap(s: asmcore.EmitState, label: string, msg: string, text: string, status: i32): asmcore.EmitState {
  s = s.write("    .section .rodata\n");
  s = s.write(msg + ":\n    .ascii \"" + text + "\\n\"\n");
  s = s.write("    .text\n");
  if (util.has_str(leaf_aborts(), label)) {
    s = s.write(label + "_leaf:\n" + rt_frame(s) + "    mov x29, sp\n");
  }
  let sym = !label.starts_with(".L");
  if (sym) {
    s = s.write(".globl " + label + "\n");
    s = s.write(".type " + label + ", %function\n");
  }
  s = s.write(label + ":\n");
  s = s.write("    adrp x1, " + msg + "\n");
  s = s.write("    add x1, x1, :lo12:" + msg + "\n");
  s = s.write("    mov x2, #" + util.i32_to_string(text.len() + 1) + "\n");
  if (status == 134) {
    s = s.need("abort_134").write("    b __fern_abort_134\n");
  } else {
    s = s.write("    mov x0, #" + util.i32_to_string(status) + "\n");
    s = s.write("    b __fern_report\n");
  }
  if (sym) {
    s = s.write(".size " + label + ", .-" + label + "\n");
  }
  return s;
}

function emit_rt_report(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .bss\n");
  s = s.write("    .align 3\n");
  s = s.write("    .globl __fern_stack_top\n");
  s = s.write("__fern_stack_top: .quad 0\n");
  s = s.write("    .align 3\n");
  s = s.write("__fern_bt_floor: .quad 0\n");
  if (s.harden) {
    s = s.write("    .globl __fern_canary\n");
    s = s.write("__fern_canary: .quad 0\n");
    s = s.write("__fern_rng_state: .quad 0\n");
  }
  s = s.write("    .text\n");
  s = s.write(".globl __fern_report\n");
  s = s.write(".type __fern_report, %function\n");
  if (s.has_need("abort_134")) {
    s = s.write("__fern_abort_134:\n    mov x0, #134\n");
  }
  if (!asmcore.process_entry(s)) {
    return s.write("__fern_report:\n    brk #1\n.size __fern_report, .-__fern_report\n");
  }
  s = s.write("__fern_report:\n");
  s = s.write("    mov x19, x0\n");
  s = s.write("    mov x0, #2\n");
  s = s.write("    mov x8, #64\n");
  s = s.svc(64);
  if (asmcore.is_android(s.build_target)) {
    s = s.write("    str x19, [sp, #-16]!\n    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n");
    s = s.write("    mov x9, #7\n    str x9, [sp, #-16]!\n    bl __fn___fern_logcat\n");
    s = s.write("    add sp, sp, #48\n    ldr x19, [sp], #16\n");
  }
  if (s.backtrace) {
    s = s.write("    b __fern_bt_exit\n");
    s = s.write(".size __fern_report, .-__fern_report\n");
    return emit_bt_exit(s);
  }
  s = s.write(signal_resume_check(s));
  s = s.write("    mov x0, x19\n");
  s = s.write(profile_exit_asm(s));
  s = s.write("    mov x8, #94\n");
  s = s.svc(94);
  return s.write(".size __fern_report, .-__fern_report\n");
}

// A negative status is a fatal signal's report: the handler resumes,
// takes the default action again, and the process ends by the signal.
function signal_resume_check(s: asmcore.EmitState): string {
  if (s.shared) {
    return "";
  }
  return "    tbnz x19, #63, .Lfern_signal_resume\n";
}

function emit_map_fail_trap(s: asmcore.EmitState): asmcore.EmitState {
  let text = aborts.map_fail();
  let n = util.i32_to_string(text.len());
  s = s.write("    .section .rodata\n");
  s = s.write(".Lmsg_map_fail:\n    .ascii \"" + text + "\"\n");
  s = s.write("    .text\n");
  s = s.write(".Lalloc_map_fail:\n");
  s = s.write("    neg x9, x0\n");
  s = s.write("    sub sp, sp, #96\n");
  s = s.write("    add x10, sp, #96\n");
  s = s.write("    mov x12, #10\n");
  s = s.write("    sub x10, x10, #1\n");
  s = s.write("    strb w12, [x10]\n");
  s = s.write("    mov x11, #41\n");
  s = s.write("    sub x10, x10, #1\n");
  s = s.write("    strb w11, [x10]\n");
  s = s.write(".Lmap_fail_digit:\n");
  s = s.write("    udiv x13, x9, x12\n");
  s = s.write("    msub x14, x13, x12, x9\n");
  s = s.write("    add x14, x14, #48\n");
  s = s.write("    sub x10, x10, #1\n");
  s = s.write("    strb w14, [x10]\n");
  s = s.write("    mov x9, x13\n");
  s = s.write("    cbnz x9, .Lmap_fail_digit\n");
  s = s.write("    adrp x15, .Lmsg_map_fail\n");
  s = s.write("    add x15, x15, :lo12:.Lmsg_map_fail\n");
  s = s.write("    add x15, x15, #" + n + "\n");
  s = s.write("    mov x11, #" + n + "\n");
  s = s.write(".Lmap_fail_copy:\n");
  s = s.write("    sub x15, x15, #1\n");
  s = s.write("    ldrb w14, [x15]\n");
  s = s.write("    sub x10, x10, #1\n");
  s = s.write("    strb w14, [x10]\n");
  s = s.write("    subs x11, x11, #1\n");
  s = s.write("    b.ne .Lmap_fail_copy\n");
  s = s.write("    mov x1, x10\n");
  s = s.write("    add x2, sp, #96\n");
  s = s.write("    sub x2, x2, x10\n");
  s = s.write("    mov x0, #123\n");
  return s.write("    b __fern_report\n");
}

// The first allocation maps the arena, and leaves x1 at __fern_heap_ptr.
function emit_arena_map(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  s = s.write("    stp x4, x5, [sp, #-16]!\n");
  s = s.write("    stp x8, x9, [sp, #-16]!\n");
  s = s.write("    mov x9, x0\n");
  if (high_heap_probe_on()) {
    s = s.write("    mov x0, #32\n");
  } else {
    s = s.write("    mov x0, #1\n");
  }
  s = s.write("    lsl x0, x0, #28\n");
  s = s.write(mov_imm64("x1", s.heap_limit));
  s = s.write("    mov x2, #3\n");
  if (darwin) {
    s = s.write("    mov x3, #0x1002\n");
  } else {
    s = s.write("    mov x3, #0x4022\n");
  }
  s = s.write("    mov x4, #0\n");
  s = s.write("    sub x4, x4, #1\n");
  s = s.write("    mov x5, #0\n");
  s = s.write("    mov x8, #222\n");
  s = s.svc(222);
  s = s.write("    cmn x0, #0\n");
  s = s.write("    b.mi .Lalloc_map_fail\n");
  s = s.write("    adrp x1, __fern_heap_ptr\n");
  s = s.write("    add x1, x1, :lo12:__fern_heap_ptr\n");
  s = s.write("    str x0, [x1]\n");
  s = s.write("    adrp x1, __fern_heap_base\n");
  s = s.write("    add x1, x1, :lo12:__fern_heap_base\n");
  s = s.write("    str x0, [x1]\n");
  s = s.write(mov_imm64("x2", s.heap_limit));
  s = s.write("    add x2, x0, x2\n");
  s = s.write("    adrp x3, __fern_heap_end\n");
  s = s.write("    add x3, x3, :lo12:__fern_heap_end\n");
  s = s.write("    str x2, [x3]\n");
  s = s.write("    mov x0, x9\n");
  s = s.write("    ldp x8, x9, [sp], #16\n");
  s = s.write("    ldp x4, x5, [sp], #16\n");
  s = s.write("    adrp x1, __fern_heap_ptr\n");
  s = s.write("    add x1, x1, :lo12:__fern_heap_ptr\n");
  return s;
}

// A target with no host gets its heap from the embedder, which calls
// __fern_heap_init(base, len) once before anything allocates. The base is
// 16-byte aligned.
function emit_heap_init(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("    .text\n    .globl __fern_heap_init\n    .type __fern_heap_init, %function\n__fern_heap_init:\n");
  if (s.has_need("heap")) {
    s = s.write("    adrp x2, __fern_heap_ptr\n    add x2, x2, :lo12:__fern_heap_ptr\n    str x0, [x2]\n");
    s = s.write("    adrp x2, __fern_heap_base\n    add x2, x2, :lo12:__fern_heap_base\n    str x0, [x2]\n");
    s = s.write("    add x1, x0, x1\n    adrp x2, __fern_heap_end\n    add x2, x2, :lo12:__fern_heap_end\n    str x1, [x2]\n");
  }
  return s.write("    ret\n.size __fern_heap_init, .-__fern_heap_init\n");
}

function emit_rt_arena_and_alloc(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
  s = s.write("    .bss\n");
  s = s.write("    .align 3\n");
  s = s.write("    .globl __fern_heap_ptr\n");
  s = s.write("__fern_heap_ptr: .quad 0\n");
  if (s.has_need("alloc_count")) {
    s = s.write("    .align 3\n");
    s = s.write("    .globl __fern_alloc_count\n");
    s = s.write("__fern_alloc_count: .quad 0\n");
  }
  s = s.write("    .align 3\n");
  s = s.write("    .globl __fern_heap_end\n");
  s = s.write("__fern_heap_end: .quad 0\n");
  s = s.write("    .align 3\n");
  s = s.write("    .globl __fern_heap_base\n__fern_heap_base: .quad 0\n");
  if (s.has_need("heap_adopt")) {
    s = s.write("__fern_image_lo: .quad 0\n");
    s = s.write("__fern_image_hi: .quad 0\n");
  }
  s = s.write("    .align 3\n");
  s = s.write("__fern_rc_underflow: .quad 0\n");
  s = s.write("    .align 3\n");
  s = s.write("__fern_map_seed: .quad 0\n");
  s = s.write("    .align 3\n");
  s = s.write("    .globl __fern_arr_push_shared\n");
  s = s.write("__fern_arr_push_shared: .quad 0\n");
  s = s.write("    .align 8\n");
  s = s.write("    .globl __fern_arr_push_copied\n");
  s = s.write("__fern_arr_push_copied: .quad 0\n");
  s = s.write("    .align 3\n");
  s = emit_arm64_quarantine_data(s);
  if (s.harden) {
    s = s.write("__fern_guard_count: .quad 0\n    .align 3\n");
  }
  s = s.write("__fern_freelist: .skip 524288\n");
  s = s.write("    .align 8\n");
  s = s.write("__fern_large_freelist: .skip 20480\n");
  s = s.write("    .align 3\n");
  s = s.write("__fern_freelist_shadow: .skip 524288\n");
  s = s.write("    .align 3\n");
  s = s.write("__fern_large_freelist_shadow: .skip 20480\n");
  s = s.write("    .text\n");
  s = s.write(".globl __fern_capw\n");
  s = s.write("__fern_capw:\n");
  s = s.write("    stp x9, x10, [sp, #-32]!\n");
  s = s.write("    str x11, [sp, #16]\n");
  s = s.write("    ldr x9, [sp, #32]\n");
  s = s.write("    cmp x9, #256\n");
  s = s.write("    b.ls .Lcapw_ret\n");
  s = s.write("    clz x10, x9\n");
  s = s.write("    mov x11, #61\n");
  s = s.write("    sub x10, x11, x10\n");
  s = s.write("    mov x11, #1\n");
  s = s.write("    lsl x11, x11, x10\n");
  s = s.write("    add x9, x9, x11\n");
  s = s.write("    sub x9, x9, #1\n");
  s = s.write("    neg x11, x11\n");
  s = s.write("    and x9, x9, x11\n");
  s = s.write("    mov x10, #0x10000\n");
  s = s.write("    cmp x9, x10\n");
  s = s.write("    b.lo .Lcapw_store\n");
  s = s.write("    mov x9, #65535\n");
  s = s.write(".Lcapw_store:\n");
  s = s.write("    str x9, [sp, #32]\n");
  s = s.write(".Lcapw_ret:\n");
  s = s.write("    ldr x11, [sp, #16]\n");
  s = s.write("    ldp x9, x10, [sp], #32\n");
  s = s.write("    ret\n");
  s = s.write(".globl __fern_alloc\n");
  s = s.write(".type __fern_alloc, %function\n");
  s = s.write("__fern_alloc:\n");
  s = s.write(rt_frame(s));
  s = s.write("    mov x29, sp\n");
  s = s.write("    add x0, x0, #7\n");
  s = s.write("    lsr x3, x0, #3\n");
  s = s.write("    lsl x0, x3, #3\n");
  s = emit_profile_alloc_hook(s);
  s = lc_bump_alloc(s);
  s = alloc_count_bump(s);
  s = s.write("    mov x2, #0x10000\n");
  s = s.write("    cmp x3, x2\n");
  s = s.write("    b.hs .Lalloc_large\n");
  let l = asmcore.fresh_label(s);
  s = l.state.write("    cmp x3, #256\n");
  s = s.write("    b.ls " + l.name + "\n");
  s = s.write("    str x3, [sp, #-16]!\n");
  s = s.write("    bl __fern_capw\n");
  s = s.write("    ldr x3, [sp], #16\n");
  s = s.write(l.name + ":\n");
  s = s.write("    lsl x0, x3, #3\n");
  s = s.write("    adrp x1, __fern_freelist\n");
  s = s.write("    add x1, x1, :lo12:__fern_freelist\n");
  s = alloc_take(s, "x3");
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  s = s.write(".Lalloc_large:\n");
  s = s.write("    mov x1, #1\n");
  s = s.write("    lsl x1, x1, #34\n");
  s = s.write("    cmp x0, x1\n");
  s = s.write("    b.hi .Lalloc_nofl\n");
  s = arm64_large_class(s, "x0", "x3", "x1");
  s = s.write("    adrp x1, __fern_large_freelist\n");
  s = s.write("    add x1, x1, :lo12:__fern_large_freelist\n");
  s = alloc_take(s, "x3");
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  s = s.write(".Lalloc_nofl:\n");
  s = s.write("    adrp x1, __fern_heap_ptr\n");
  s = s.write("    add x1, x1, :lo12:__fern_heap_ptr\n");
  s = s.write("    ldr x2, [x1]\n");
  s = s.write("    cbnz x2, .Lalloc_inited\n");
  if (asmcore.process_entry(s)) {
    s = emit_arena_map(s, darwin);
  } else {
    s = s.write("    brk #1\n");
  }
  s = s.write(".Lalloc_inited:\n");
  if (s.harden && !darwin) {
    s = emit_guard_bump(s);
  }
  s = s.write("    ldr x2, [x1]\n");
  s = s.write("    adds x3, x2, x0\n");
  s = s.write("    b.cs __fern_alloc_size_abort\n");
  s = s.write("    str x4, [sp, #-16]!\n");
  s = s.write("    adrp x4, __fern_heap_end\n");
  s = s.write("    add x4, x4, :lo12:__fern_heap_end\n");
  s = s.write("    ldr x4, [x4]\n");
  s = s.write("    cmp x3, x4\n");
  s = s.write("    ldr x4, [sp], #16\n");
  s = s.write("    b.hi .Lalloc_oom\n");
  s = s.write("    str x3, [x1]\n");
  s = s.write("    mov x0, x2\n");
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  s = abort_trap(s, ".Lalloc_oom", ".Lmsg_oom", aborts.oom(), 125);
  if (asmcore.process_entry(s)) {
    s = emit_map_fail_trap(s);
  }
  s = s.write(".size __fern_alloc, .-__fern_alloc\n");

  s = abort_trap(s, "__fern_oob_abort", ".Lmsg_arr_oob", aborts.arr_oob(), 134);
  s = abort_trap(s, "__fern_str_oob_abort", ".Lmsg_str_oob", aborts.str_oob(), 134);
  s = abort_trap(s, "__fern_slice_abort", ".Lmsg_slice", aborts.slice_range(), 134);
  s = abort_trap(s, "__fern_alloc_size_abort", ".Lmsg_alloc_size", aborts.alloc_size(), 134);
  s = abort_trap(s, "__fern_free_range_abort", ".Lmsg_free_range", aborts.free_range(), 134);
  s = abort_trap(s, "__fern_double_free_abort", ".Lmsg_double_free", aborts.double_free(), 134);
  if (s.harden) {
    s = abort_trap(s, "__fern_free_link_abort", ".Lmsg_free_link", aborts.free_link(), 134);
  }

  s = s.write("__fern_arr_box:\n");
  s = s.write("    movz x1, #65535\n    movk x1, #4095, lsl #16\n    cmp x0, x1\n    b.ls .Larrbox_sized\n    b __fern_alloc_size_abort_leaf\n.Larrbox_sized:\n");
  if (profile_alloc_fast(s)) {
    s = s.write("    add x1, x0, #3\n");
    s = s.write("    lsl x1, x1, #3\n");
    s = s.write("    cmp x1, #2048\n");
    s = s.write("    b.hi .Larrbox_alloc\n");
    s = s.write("    adrp x2, __fern_freelist\n");
    s = s.write("    add x2, x2, :lo12:__fern_freelist\n");
    s = s.write("    add x1, x2, x1\n");
    if (s.harden) {
      s = s.write(rt_save_lr(s, "x0"));
      s = s.write("    mov x0, x1\n");
      s = s.write("    bl __fern_freelist_take\n");
      s = s.write("    mov x2, x0\n");
      s = s.write(rt_restore_lr(s, "x0"));
      s = s.write("    cbz x2, .Larrbox_miss\n");
    } else {
      s = s.write("    ldr x2, [x1]\n");
      s = s.write("    cbz x2, .Larrbox_miss\n");
      s = s.write("    ldr x3, [x2]\n");
      s = s.write("    str x3, [x1]\n");
    }
    s = s.write("    str x0, [x2]\n");
    s = s.write("    mov w3, #1\n");
    s = s.write("    str w3, [x2, #8]\n");
    s = s.write("    str x0, [x2, #16]\n");
    s = s.write("    add x0, x2, #16\n");
    s = s.write("    ret\n");
    s = s.write(".Larrbox_miss:\n");
    s = s.write("    add x1, x0, #3\n");
    s = s.write("    lsl x1, x1, #3\n");
    s = s.write(".Larrbox_alloc:\n");
    s = s.write(rt_frame(s));
    s = s.write("    mov x29, sp\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    mov x0, x1\n");
  } else {
    s = s.write(rt_frame(s));
    s = s.write("    mov x29, sp\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    add x0, x0, #3\n");
    s = s.write("    lsl x0, x0, #3\n");
  }
  s = s.write("    bl __fern_alloc\n");
  s = s.write("    ldr x1, [sp]\n");
  s = s.write("    str x1, [x0]\n");
  s = s.write("    mov w2, #1\n");
  s = s.write("    str w2, [x0, #8]\n");
  s = s.write("    str x1, [x0, #16]\n");
  s = s.write("    add x0, x0, #16\n");
  s = s.write("    add sp, sp, #16\n");
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  s = s.write("__fern_str_box:\n");
  s = s.write(rt_frame(s));
  s = s.write("    mov x29, sp\n");
  s = s.write("    stp x0, x1, [sp, #-16]!\n");
  s = s.write("    mov x0, #24\n");
  s = s.write("    bl __fern_alloc\n");
  s = s.write("    mov x2, #1\n");
  s = s.write("    str x2, [x0]\n");
  s = s.write("    ldp x2, x3, [sp], #16\n");
  s = s.write("    str x2, [x0, #8]\n");
  s = s.write("    str x3, [x0, #16]\n");
  s = s.write("    add x0, x0, #8\n");
  s = s.write(rt_unframe(s));
  s = s.write("    ret\n");
  s = s.write("__fern_str_box_hdr:\n");
  s = s.write("    sub x2, x0, #24\n");
  s = s.write("    mov w3, #1\n");
  s = s.write("    str w3, [x2]\n");
  s = mov_fused_marker(s, "w4");
  s = s.write("    stur w4, [x2, #4]\n");
  s = s.write("    str x0, [x2, #8]\n");
  s = s.write("    str x1, [x2, #16]\n");
  s = s.write("    add x0, x2, #8\n");
  s = s.write("    ret\n");

  if (s.has_need("buf")) {
    if (s.has_need("buf_push_bytes_range")) {
      s = emit_buf_push_bytes_range(s, false);
    }
    if (s.has_need("buf_push_bytes_range_u8")) {
      s = emit_buf_push_bytes_range(s, true);
    }
    if (s.has_need("buf_take_bytes")) {
      s = emit_buf_take_bytes(s, false);
    }
    if (s.has_need("buf_take_bytes_u8")) {
      s = emit_buf_take_bytes(s, true);
    }
    s = s.write(".globl __fern_buf_new\n");
    s = s.write(".type __fern_buf_new, %function\n");
    s = s.write("__fern_buf_new:\n");
    s = s.write(rt_frame(s));
    s = s.write("    mov x29, sp\n");
    s = s.write("    stp x19, x20, [sp, #-16]!\n");
    s = s.write("    mov x19, x0\n");
    s = s.write("    cmp x19, #16\n");
    s = s.write("    b.hs .Lbufnew_cap\n");
    s = s.write("    mov x19, #16\n");
    s = s.write(".Lbufnew_cap:\n");
    s = s.write("    mov x0, #32\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    mov x20, x0\n");
    s = s.write("    mov x0, x19\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    str x0, [x20]\n");
    s = s.write("    str xzr, [x20, #8]\n");
    s = s.write("    str x19, [x20, #16]\n");
    s = s.write("    str x19, [x20, #24]\n");
    s = s.write("    mov x0, x20\n");
    s = s.write("    ldp x19, x20, [sp], #16\n");
    s = s.write(rt_unframe(s));
    s = s.write("    ret\n");
    s = s.write(".size __fern_buf_new, .-__fern_buf_new\n");
    s = s.write(".globl __fern_buf_reserve\n");
    s = s.write(".type __fern_buf_reserve, %function\n");
    s = s.write("__fern_buf_reserve:\n");
    s = s.write(rt_frame(s));
    s = s.write("    mov x29, sp\n");
    s = s.write("    stp x19, x20, [sp, #-16]!\n");
    s = s.write("    stp x21, x22, [sp, #-16]!\n");
    s = s.write("    mov x19, x0\n");
    s = s.write("    mov x20, x1\n");
    s = s.write("    ldr x21, [x19, #16]\n");
    s = s.write("    cbnz x21, .Lbufres_dbl\n");
    s = s.write("    ldr x21, [x19, #24]\n");
    s = s.write("    cbnz x21, .Lbufres_dbl\n");
    s = s.write("    mov x21, #64\n");
    s = s.write(".Lbufres_dbl:\n");
    s = s.write("    cmp x21, x20\n");
    s = s.write("    b.hs .Lbufres_alloc\n");
    s = s.write("    lsl x21, x21, #1\n");
    s = s.write("    b .Lbufres_dbl\n");
    s = s.write(".Lbufres_alloc:\n");
    s = s.write("    mov x0, x21\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.write("    mov x22, x0\n");
    s = s.write("    ldr x2, [x19, #8]\n");
    s = s.write("    cbz x2, .Lbufres_nocopy\n");
    s = s.write("    ldr x1, [x19]\n");
    s = s.write("    mov x3, x22\n");
    s = arm64_copy_bytes(s, CopyRegs { dst: "x3", src: "x1", n: "x2", tmp: "x9", src_end: "x10", dst_end: "x11" }, ".Lbufres_copy_w", ".Lbufres_copy_t", ".Lbufres_copy_b", ".Lbufres_copy_d");
    s = s.write(".Lbufres_nocopy:\n");
    s = s.write("    ldr x5, [x19]\n");
    s = s.write("    cbz x5, .Lbufres_store\n");
    s = s.write("    ldr x6, [x19, #16]\n");
    s = s.write("    add x6, x6, #7\n");
    s = s.write("    lsr x6, x6, #3\n");
    s = buf_block_free(s, "x5", "x6", "Lbufres_old", false);
    s = s.write(".Lbufres_store:\n");
    s = s.write("    str x22, [x19]\n");
    s = s.write("    str x21, [x19, #16]\n");
    s = s.write("    ldp x21, x22, [sp], #16\n");
    s = s.write("    ldp x19, x20, [sp], #16\n");
    s = s.write(rt_unframe(s));
    s = s.write("    ret\n");
    s = s.write(".size __fern_buf_reserve, .-__fern_buf_reserve\n");
    s = s.write(".globl __fern_buf_push\n");
    s = s.write(".type __fern_buf_push, %function\n");
    s = s.write("__fern_buf_push:\n");
    s = s.write("    ldrsw x3, [x1, #8]\n");
    s = s.write("    cbz x3, .Lbufrange_done\n");
