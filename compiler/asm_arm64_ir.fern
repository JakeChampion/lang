    s = s.write(".Larr_push_slow:\n");
    if (!s.rc_free_debug && profile_alloc_fast(s)) {
      s = s.write("    ldr x2, [x0]\n");
      s = s.write("    cbnz x2, .Larr_push_frame\n");
