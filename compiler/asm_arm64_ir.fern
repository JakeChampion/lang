function arm64_large_class(s: asmcore.EmitState, n: string, cls: string, t: string): asmcore.EmitState {
  s = s.write("    mov " + t + ", #1\n");
  s = s.write("    lsl " + t + ", " + t + ", #19\n");
  s = s.write("    cmp " + n + ", " + t + "\n");
  s = s.write("    csel " + n + ", " + t + ", " + n + ", lo\n");
  s = s.write("    clz " + t + ", " + n + "\n");
  s = s.write("    mov " + cls + ", #61\n");
  s = s.write("    sub " + cls + ", " + cls + ", " + t + "\n");
  s = s.write("    mov " + t + ", #1\n");
  s = s.write("    lsl " + t + ", " + t + ", " + cls + "\n");
  s = s.write("    sub " + t + ", " + t + ", #1\n");
  s = s.write("    add " + n + ", " + n + ", " + t + "\n");
  s = s.write("    bic " + n + ", " + n + ", " + t + "\n");
  s = s.write("    clz " + t + ", " + n + "\n");
  s = s.write("    mov " + cls + ", #61\n");
  s = s.write("    sub " + t + ", " + cls + ", " + t + "\n");
  s = s.write("    lsr " + cls + ", " + n + ", " + t + "\n");
  s = s.write("    add " + cls + ", " + cls + ", " + t + ", lsl #2\n");
  return s.write("    sub " + cls + ", " + cls + ", #72\n");
}

// Takes a block of the class in `cls` from the list at x1 into x0, leaving
// to .Lalloc_nofl when the list is empty; x0 holds the byte count on entry
// and keeps it on that exit. Under -harden the block is one of the first
// eight, otherwise the head.
function alloc_take(s: asmcore.EmitState, cls: string): asmcore.EmitState {
  if (s.harden) {
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    add x0, x1, " + cls + ", lsl #3\n");
    s = s.write("    bl __fern_freelist_take\n");
    s = s.write("    mov x2, x0\n");
    s = s.write("    ldr x0, [sp], #16\n");
    s = s.write("    cbz x2, .Lalloc_nofl\n");
    return s.write("    mov x0, x2\n");
  }
  s = s.write("    ldr x2, [x1, " + cls + ", lsl #3]\n");
  s = s.write("    cbz x2, .Lalloc_nofl\n");
  s = s.write("    ldr x0, [x2]\n");
  s = s.write("    str x0, [x1, " + cls + ", lsl #3]\n");
  return s.write("    mov x0, x2\n");
}

function emit_rt_large_tier_and_rc(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_large_push:\n");
  s = s.write("    mov x3, #1\n");
  s = s.write("    lsl x3, x3, #34\n");
  s = s.write("    cmp x2, x3\n");
  s = s.write("    b.hi .Llpush_ret\n");
  s = lc_bump_free_add(s, "x2", "x3", "x4", "x1");
  if (s.rc_free_debug) {
    s = s.write("    ret\n");
    s = s.write("__fern_large_push_now:\n");
  }
  s = freelist_scrub(s, "x1", "x2", "x3", "x4");
  s = arm64_large_class(s, "x2", "x4", "x3");
  s = s.write("    mov x2, x4\n");
  s = s.write("    adrp x3, __fern_large_freelist\n");
  s = s.write("    add x3, x3, :lo12:__fern_large_freelist\n");
  s = s.write("    ldr x4, [x3, x2, lsl #3]\n");
  s = freelist_twice_check(s, "x4", "x1", "__fern_double_free_abort_leaf");
  s = freelist_encode(s, "x1", "x4");
  s = s.write("    str x4, [x1]\n");
  s = s.write("    str x1, [x3, x2, lsl #3]\n");
  s = s.write(".Llpush_ret:\n");
  s = s.write("    ret\n");
  if (s.rc_free_debug) {
    s = emit_quarantine(s);
    s = emit_raw_alloc_san(s);
  }
  if (s.harden) {
    s = emit_freelist_take(s);
  }
  s = s.write("__fern_raw_free:\n");
  s = s.write(rt_frame(s));
  s = s.write("    mov x29, sp\n");
  s = s.write("    cbz x0, .Lrawfree_done\n");
  if (s.has_need("heap_adopt")) {
    s = s.write("    adrp x9, __fern_image_lo\n    add x9, x9, :lo12:__fern_image_lo\n    ldr x9, [x9]\n    cmp x0, x9\n    b.lo .Lrawfree_own\n");
    s = s.write("    adrp x9, __fern_image_hi\n    add x9, x9, :lo12:__fern_image_hi\n    ldr x9, [x9]\n    cmp x0, x9\n    b.lo .Lrawfree_done\n");
    s = s.write(".Lrawfree_own:\n");
  }
  s = s.write("    adrp x9, __fern_heap_base\n    add x9, x9, :lo12:__fern_heap_base\n    ldr x9, [x9]\n    cmp x0, x9\n    b.lo .Lrawfree_bad\n");
  s = s.write("    adrp x9, __fern_heap_end\n    add x9, x9, :lo12:__fern_heap_end\n    ldr x9, [x9]\n    cmp x0, x9\n    b.hs .Lrawfree_bad\n");
  s = s.write("    add x1, x1, #7\n");
  s = s.write("    lsr x5, x1, #3\n");
  if (s.rc_free_debug) {
    s = san_redzone_check(s);
  }
  s = s.write("    cbz x5, .Lrawfree_done\n");
  if (s.rc_free_debug) {
    // The census counts the block, and the quarantine takes the redzone too.
