    s = s.write("    mov x5, #0\n");
    s = s.write("    cmp x3, #8\n    b.lo " + h_short + "\n");
    s = s.write("    sub x6, x3, #8\n");
    s = s.write(h_loop + ":\n");
    s = s.write("    cmp x5, x6\n    b.hi " + h_tail + "\n");
    s = s.write("    ldr x7, [x0, x5]\n    eor x2, x2, x7\n    mul x2, x2, x4\n");
    s = s.write("    add x5, x5, #8\n    b " + h_loop + "\n");
    s = s.write(h_tail + ":\n");
    s = s.write("    cmp x5, x3\n    b.eq " + h_fin + "\n");
    s = s.write("    ldr x7, [x0, x6]\n    eor x2, x2, x7\n    mul x2, x2, x4\n    b " + h_fin + "\n");
    s = s.write(h_short + ":\n");
    s = s.write("    cbz x3, " + h_fin + "\n");
    s = s.write("    cmp x3, #4\n    b.lo " + h_tiny + "\n");
    s = s.write("    ldr w1, [x0]\n    sub x5, x3, #4\n    ldr w7, [x0, x5]\n");
    s = s.write("    lsl x5, x5, #3\n    lsl x7, x7, x5\n    orr x1, x1, x7\n    b " + h_mix + "\n");
    s = s.write(h_tiny + ":\n");
    s = s.write("    ldrb w1, [x0]\n    sub x5, x3, #1\n    ldrb w7, [x0, x5]\n");
    s = s.write("    lsl x5, x5, #3\n    lsl x7, x7, x5\n    orr x1, x1, x7\n");
    s = s.write("    lsr x5, x3, #1\n    ldrb w7, [x0, x5]\n");
    s = s.write("    lsl x5, x5, #3\n    lsl x7, x7, x5\n    orr x1, x1, x7\n");
    s = s.write(h_mix + ":\n");
    s = s.write("    eor x2, x2, x1\n    mul x2, x2, x4\n");
    s = s.write(h_fin + ":\n");
    s = s.write("    lsr x7, x2, #32\n    eor x2, x2, x7\n");
    s = s.write("    sxtw x2, w2\n    str x2, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == 329 || o.kind_tag == 369) {
    let blo: asmcore.LabelOut = asmcore.fresh_label(s);
    let b_loop: string = blo.name;
    let blo2: asmcore.LabelOut = asmcore.fresh_label(blo.state);
    let b_done: string = blo2.name;
    s = blo2.state;
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    if (o.kind_tag == 369) {
      s = s.write("    ldr x3, [x0]\n    add x0, x0, #8\n");
    } else {
      s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
    }
    s = s.write("    and x1, x1, #0xffff\n    mov x2, #0\n");
    s = s.write(b_loop + ":\n");
    s = s.write("    cmp x2, x3\n    b.ge " + b_done + "\n");
    if (o.kind_tag == 369 && !ir.is_packed(o)) {
      s = s.write("    add x5, x0, x2, lsl #3\n    ldrb w6, [x5]\n");
    } else {
      s = s.write("    add x5, x0, x2\n    ldrb w6, [x5]\n");
    }
    s = s.write("    lsr x9, x1, #1\n    orr x1, x9, x1, lsl #15\n");
    s = s.write("    add x1, x1, x6\n    and x1, x1, #0xffff\n");
    s = s.write("    add x2, x2, #1\n    b " + b_loop + "\n");
    s = s.write(b_done + ":\n    str x1, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == 327 || o.kind_tag == 379) {
    let clo: asmcore.LabelOut = asmcore.fresh_label(s);
    let c_loop: string = clo.name;
    let clo2: asmcore.LabelOut = asmcore.fresh_label(clo.state);
    let c_flag: string = clo2.name;
    let clo3: asmcore.LabelOut = asmcore.fresh_label(clo2.state);
    let c_done: string = clo3.name;
    s = clo3.state;
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    if (o.kind_tag == 379) {
      s = s.write("    ldr x3, [x0]\n    add x0, x0, #8\n");
    } else {
      s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
    }
    s = s.write("    cmp x1, #0\n    cset x9, eq\n");
    s = s.write("    mov x1, #0\n    mov x8, #0\n    ldr x4, [x2]\n");
    s = s.write(c_loop + ":\n");
    s = s.write("    cmp x1, x3\n    b.ge " + c_done + "\n");
    if (o.kind_tag == 379 && !ir.is_packed(o)) {
      s = s.write("    add x5, x0, x1, lsl #3\n    ldrb w6, [x5]\n");
    } else {
      s = s.write("    add x5, x0, x1\n    ldrb w6, [x5]\n");
    }
    s = s.write("    mov x7, #1\n");
    s = s.write("    cmp x6, x4\n    b.hs " + c_flag + "\n");
    s = s.write(set_entry_load(o, "x2", "x6"));
    s = s.write("    cmp x7, #0\n    cset x7, eq\n");
    s = s.write(c_flag + ":\n");
    s = s.write("    bic x10, x9, x7\n    add x8, x8, x10\n    mov x9, x7\n");
    s = s.write("    add x1, x1, #1\n    b " + c_loop + "\n");
    s = s.write(c_done + ":\n    str x8, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == 324 || o.kind_tag == 361) {
