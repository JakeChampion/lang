function arm64_large_class(s: asmcore.EmitState, n: string, cls: string, t: string): asmcore.EmitState {
  s = s.write("    mov " + t + ", #1\n");
  s = s.write("    lsl " + t + ", " + t + ", #19\n");
  s = s.write("    cmp " + n + ", " + t + "\n");
  s = s.write("    csel " + n + ", " + t + ", " + n + ", lo\n");
  s = s.write("    clz " + t + ", " + n + "\n");
  s = s.write("    mov " + cls + ", #61\n");
  s = s.write("    sub " + cls + ", " + cls + ", " + t + "\n");
  s = s.write("    mov " + t + ", #1\n");
  s = s.write("    lsl " + t + ", " + t + ", " + cls + "\n");
  s = s.write("    sub " + t + ", " + t + ", #1\n");
  s = s.write("    add " + n + ", " + n + ", " + t + "\n");
  s = s.write("    bic " + n + ", " + n + ", " + t + "\n");
  s = s.write("    clz " + t + ", " + n + "\n");
  s = s.write("    mov " + cls + ", #61\n");
  s = s.write("    sub " + t + ", " + cls + ", " + t + "\n");
  s = s.write("    lsr " + cls + ", " + n + ", " + t + "\n");
  s = s.write("    add " + cls + ", " + cls + ", " + t + ", lsl #2\n");
  return s.write("    sub " + cls + ", " + cls + ", #72\n");
}

function emit_rt_large_tier_and_rc(s: asmcore.EmitState): asmcore.EmitState {
  s = s.write("__fern_large_push:\n");
  s = s.write("    mov x3, #1\n");
  s = s.write("    lsl x3, x3, #30\n");
  s = s.write("    cmp x2, x3\n");
  s = s.write("    b.hi .Llpush_ret\n");
  s = lc_bump_free_add(s, "x2", "x3", "x4");
  if (!s.rc_free_debug) {
    s = arm64_large_class(s, "x2", "x4", "x3");
    s = s.write("    mov x2, x4\n");
    s = s.write("    adrp x3, __fern_large_freelist\n");
    s = s.write("    add x3, x3, :lo12:__fern_large_freelist\n");
    s = s.write("    ldr x4, [x3, x2, lsl #3]\n");
    s = s.write("    str x4, [x1]\n");
    s = s.write("    str x1, [x3, x2, lsl #3]\n");
  }
  s = s.write(".Llpush_ret:\n");
  s = s.write("    ret\n");
  s = s.write("__fern_raw_free:\n");
  s = s.write("    stp x29, x30, [sp, #-16]!\n");
  s = s.write("    mov x29, sp\n");
  s = s.write("    cbz x0, .Lrawfree_done\n");
  s = s.write("    add x1, x1, #7\n");
  s = s.write("    lsr x5, x1, #3\n");
  s = s.write("    cbz x5, .Lrawfree_done\n");
  if (s.rc_free_debug) {
    s = s.write(quarantine_rc("[x0]", "w9", s.rc_free_debug));
  }
  s = buf_block_free(s, "x0", "x5", "Lrawfree_b");
  s = s.write(".Lrawfree_done:\n");
  s = s.write("    ldp x29, x30, [sp], #16\n");
  s = s.write("    ret\n");
  s = s.write("__fn___fern_arr_dec:\n");
  s = s.write("    ldr x0, [sp]\n");
  s = s.write("__fn___fern_arr_dec.r:\n");
  s = s.write("    cmp x0, #16, lsl #12\n");
  s = s.write("    blo .Larrdec_ret\n");
  s = s.write("__fn___fern_arr_dec.u:\n");
  s = s.write("    ldur w1, [x0, #-8]\n");
  s = s.write(san_poison_check("w1", "w9", ".Larrdec_live", s.rc_free_debug));
  s = s.write("    cmp w1, #1\n");
  s = s.write("    bne .Larrdec_shared\n");
  s = s.write(quarantine_rc("[x0, #-8]", "w9", s.rc_free_debug));
  s = s.write("    ldur x1, [x0, #-16]\n");
  s = s.write("    add x1, x1, #3\n");
  s = s.write("    sub x2, x0, #16\n");
  s = s.write("    cmp x1, #256\n");
  s = s.write("    b.hi .Larrdec_big\n");
  s = lc_bump_free_words(s, "x1", "x3", "x9");
  if (!s.rc_free_debug) {
    s = s.write(".Larrdec_push:\n");
    s = freelist_push_classed(s, "x2", "x1", "x3", "x9");
  }
  s = s.write(".Larrdec_ret:\n");
  s = s.write("    ret\n");
  s = s.write(".Larrdec_shared:\n");
  s = s.write("    tbnz w1, #31, .Larrdec_ret\n");
  s = s.write("    bgt .Larrdec_dec\n");
  s = s.write("    adrp x2, __fern_rc_underflow\n");
  s = s.write("    add x2, x2, :lo12:__fern_rc_underflow\n");
  s = s.write("    ldr w3, [x2]\n");
  s = s.write("    add w3, w3, #1\n");
  s = s.write("    str w3, [x2]\n");
  s = s.write(san_underflow_abort(s));
  s = s.write("    ret\n");
  s = s.write(".Larrdec_dec:\n");
  s = s.write("    sub w1, w1, #1\n");
  s = s.write("    stur w1, [x0, #-8]\n");
