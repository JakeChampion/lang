  if (o.kind_tag == 433) {
    s = s.need("utf8_blocks");
    s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    bl __fern_utf8_blocks\n");
    return s.write("    str x0, [sp, #-16]!\n");
  }
  if (o.kind_tag == 253 || o.kind_tag == 368) {
    s = s.need("sum_bytes");
    s = s.write("    ldr x0, [sp], #16\n");
    if (o.kind_tag == 368) {
      s = s.write("    ldr x6, [x0]\n    add x8, x0, #8\n    bl __fern_sum_bytes_data\n");
    } else {
      s = s.write("    bl __fern_sum_bytes\n");
    }
    s = s.write("    sxtw x0, w0\n    str x0, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == 373 && !ir.is_packed(o)) {
    let loop_label = asmcore.fresh_label(s);
    let done_label = asmcore.fresh_label(loop_label.state);
    s = done_label.state;
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    ldr x6, [x1]\n    add x1, x1, #8\n    mov x2, #0\n");
    s = s.write("    movz w5, #0x1db7\n    movk w5, #0x04c1, lsl #16\n");
    s = s.write(loop_label.name + ":\n    cmp x2, x6\n    b.ge " + done_label.name + "\n");
    s = s.write("    add x3, x1, x2, lsl #3\n    ldrb w3, [x3]\n    eor w0, w0, w3, lsl #24\n");
    let k: i32 = 0;
    while (k < 8) {
      s = s.write("    asr w4, w0, #31\n    and w4, w4, w5\n    lsl w0, w0, #1\n    eor w0, w0, w4\n");
      k = k + 1;
    }
    s = s.write("    add x2, x2, #1\n    b " + loop_label.name + "\n");
    return s.write(done_label.name + ":\n    sxtw x0, w0\n    str x0, [sp, #-16]!\n");
  }
  if (o.kind_tag == 309 || o.kind_tag == 373) {
    s = s.need("crc32_cksum");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    if (o.kind_tag == 373) {
      s = s.write("    ldr x6, [x1]\n    add x7, x1, #8\n    bl __fern_crc32_cksum_data\n");
    } else {
      s = s.write("    bl __fern_crc32_cksum\n");
    }
    s = s.write("    sxtw x0, w0\n    str x0, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == 227) {
    let alo: asmcore.LabelOut = asmcore.fresh_label(s);
    let a_clamped: string = alo.name;
    let alo2: asmcore.LabelOut = asmcore.fresh_label(alo.state);
    let a_vec: string = alo2.name;
    let alo3: asmcore.LabelOut = asmcore.fresh_label(alo2.state);
    let a_next: string = alo3.name;
    let alo4: asmcore.LabelOut = asmcore.fresh_label(alo3.state);
    let a_tail: string = alo4.name;
    let alo5: asmcore.LabelOut = asmcore.fresh_label(alo4.state);
    let a_hit: string = alo5.name;
    let alo6: asmcore.LabelOut = asmcore.fresh_label(alo5.state);
    let a_none: string = alo6.name;
    let alo7: asmcore.LabelOut = asmcore.fresh_label(alo6.state);
    let a_done: string = alo7.name;
    s = alo7.state;
    s = s.write("    ldr x2, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    ldr x3, [x0, #8]\n    ldr x0, [x0]\n");
    s = s.write("    cmp x2, #0\n    b.ge " + a_clamped + "\n    mov x2, #0\n");
    s = s.write(a_clamped + ":\n");
    s = s.write("    cmp x2, x3\n    b.ge " + a_none + "\n");
    s = s.write("    add x5, x0, x2\n    add x6, x0, x3\n");
    s = s.write(a_vec + ":\n");
    s = s.write("    sub x7, x6, x5\n    cmp x7, #16\n    b.lt " + a_tail + "\n");
    s = s.write("    ld1 {v0.16b}, [x5]\n    cmlt v0.16b, v0.16b, #0\n");
    s = s.write("    shrn v0.8b, v0.8h, #4\n    fmov x7, d0\n");
    s = s.write("    cbz x7, " + a_next + "\n");
    s = s.write("    rbit x4, x7\n    clz x4, x4\n    lsr x4, x4, #2\n");
    s = s.write("    add x5, x5, x4\n    sub x2, x5, x0\n    b " + a_done + "\n");
    s = s.write(a_next + ":\n    add x5, x5, #16\n    b " + a_vec + "\n");
    s = s.write(a_tail + ":\n");
    s = s.write("    cmp x5, x6\n    b.ge " + a_none + "\n");
    s = s.write("    ldrb w4, [x5]\n");
    s = s.write("    tbnz w4, #7, " + a_hit + "\n");
    s = s.write("    add x5, x5, #1\n    b " + a_tail + "\n");
    s = s.write(a_hit + ":\n    sub x2, x5, x0\n    b " + a_done + "\n");
    s = s.write(a_none + ":\n    mov x2, x3\n");
    s = s.write(a_done + ":\n    str x2, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == 104) {
    if (ir.is_packed(o)) {
      s = s.need("str_bytes_u8");
      return s.write("    bl __fn___fern_str_bytes_u8\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    }
    s = s.need("str_bytes");
    s = s.write("    bl __fn___fern_str_bytes\n    add sp, sp, #16\n    str x0, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == 105) {
    s = s.need("str_split");
    s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n");
    s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_split\n    add sp, sp, #32\n    str x0, [sp, #-16]!\n");
    return s;
  }
  if (o.kind_tag == 106 || o.kind_tag == 107) {
