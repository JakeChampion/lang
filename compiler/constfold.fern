import "./ast";
import "./lexer";
import "./parser";
import "./util";
import "./astwalk";

function lit_int(v: i64, suffix: string): ast.Expr {
  let s: string = util.i64_to_string(v);
  if (v >= 0) {
    return num_lit(s, suffix);
  }
  return ast.ExprUnary { op: "-", operand: num_lit(slice_unchecked(s, 1, s.len()), suffix), line: 0, col: 0, ty: "" };
}

function num_lit(text: string, suffix: string): ast.Expr {
  return ast.ExprNumber { text: text, suffix: suffix, raw: "", is_float: false, line: 0, col: 0 };
}

function fits(v: i64, suffix: string, peak: i64): boolean {
  if (suffix == "") {
    return v >= 0 && (v <= 255i64 || peak > 255i64 && v <= 2147483647i64);
  }
  if (suffix == "i32") {
    return v >= 0 - 2147483648i64 && v <= 2147483647i64;
  }
  if (suffix == "u32") {
    return v >= 0 && v <= 4294967295i64;
  }
  if (suffix == "u8") {
    return v >= 0 && v <= 255i64;
  }
  return false;
}

function lit_bool(b: boolean): ast.Expr {
  return ast.ExprBool { value: b, line: 0, col: 0 };
}

function lit_string(s: string): ast.Expr {
  return ast.ExprString { value: s, line: 0, col: 0 };
}

struct OptInt { ok: boolean, v: i64, suffix: string }

function as_int_lit(e: ast.Expr): OptInt {
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return OptInt { ok: false, v: 0, suffix: "" };
      }
      return OptInt { ok: true, v: util.lit_to_i64(n.text), suffix: n.suffix };
    },
    ast.ExprUnary(u) => {
      if (u.op == "-") {
        let inner: OptInt = as_int_lit(u.operand);
        if (inner.ok) {
          return OptInt { ok: true, v: 0 - inner.v, suffix: inner.suffix };
        }
      }
      return OptInt { ok: false, v: 0, suffix: "" };
    },
    _ => {
      return OptInt { ok: false, v: 0, suffix: "" };
    }
  }
  return OptInt { ok: false, v: 0, suffix: "" };
}

struct OptBool { ok: boolean, v: boolean }

function as_bool_lit(e: ast.Expr): OptBool {
  match (e) {
    ast.ExprBool(b) => {
      return OptBool { ok: true, v: b.value };
    },
    _ => {
      return OptBool { ok: false, v: false };
    }
  }
  return OptBool { ok: false, v: false };
}

struct OptString { ok: boolean, v: string }

function as_string_lit(e: ast.Expr): OptString {
  match (e) {
    ast.ExprString(s) => {
      return OptString { ok: true, v: s.value };
    },
    _ => {
      return OptString { ok: false, v: "" };
    }
  }
  return OptString { ok: false, v: "" };
}

pub function fold_expr(e: ast.Expr): ast.Expr {
  return astwalk.map_expr(e, fold_node);
}

function fold_node(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return fold_binary(b.op, b.left, b.right, e);
    },
    ast.ExprUnary(u) => {
      return fold_unary(u.op, u.operand, e);
    },
    _ => {
      return e;
    }
  }
  return e;
}

function fold_binary(op: string, lhs: ast.Expr, rhs: ast.Expr, unfolded: ast.Expr): ast.Expr {
  let li: OptInt = as_int_lit(lhs);
  let ri: OptInt = as_int_lit(rhs);
  if (li.ok && ri.ok && li.suffix == ri.suffix && fits(li.v, li.suffix, li.v) && fits(ri.v, ri.suffix, ri.v)) {
    let sfx: string = li.suffix;
    let peak: i64 = li.v;
    if (ri.v > peak) {
      peak = ri.v;
    }
    if (op == "+") {
      return fold_arith(li.v + ri.v, sfx, peak, unfolded);
    }
    if (op == "-") {
      return fold_arith(li.v - ri.v, sfx, peak, unfolded);
    }
    if (op == "*") {
      return fold_arith(li.v * ri.v, sfx, peak, unfolded);
    }
    if (op == "/") {
      if (ri.v == 0) {
        return unfolded;
      }
      return fold_arith(li.v / ri.v, sfx, peak, unfolded);
    }
    if (op == "%") {
      if (ri.v == 0) {
        return unfolded;
      }
      return fold_arith(li.v % ri.v, sfx, peak, unfolded);
    }
    if (op == "<") {
      return lit_bool(li.v < ri.v);
    }
    if (op == "<=") {
      return lit_bool(li.v <= ri.v);
    }
    if (op == ">") {
      return lit_bool(li.v > ri.v);
    }
    if (op == ">=") {
      return lit_bool(li.v >= ri.v);
    }
    if (op == "==") {
      return lit_bool(li.v == ri.v);
    }
    if (op == "!=") {
      return lit_bool(li.v != ri.v);
    }
  }
  let lb: OptBool = as_bool_lit(lhs);
  let rb: OptBool = as_bool_lit(rhs);
  if (lb.ok && rb.ok) {
    if (op == "&&") {
      return lit_bool(lb.v && rb.v);
    }
    if (op == "||") {
      return lit_bool(lb.v || rb.v);
    }
    if (op == "==") {
      return lit_bool(lb.v == rb.v);
    }
    if (op == "!=") {
      return lit_bool(lb.v != rb.v);
    }
  }
  let ls: OptString = as_string_lit(lhs);
  let rs: OptString = as_string_lit(rhs);
  if (ls.ok && rs.ok) {
    if (op == "+") {
      return lit_string(ls.v + rs.v);
    }
    if (op == "==") {
      return lit_bool(ls.v == rs.v);
    }
    if (op == "!=") {
      return lit_bool(ls.v != rs.v);
    }
  }
  return unfolded;
}

function fold_arith(v: i64, suffix: string, peak: i64, unfolded: ast.Expr): ast.Expr {
  if (!fits(v, suffix, peak)) {
    return unfolded;
  }
  return lit_int(v, suffix);
}

function fold_unary(op: string, operand: ast.Expr, unfolded: ast.Expr): ast.Expr {
  if (op == "-") {
    let oi: OptInt = as_int_lit(operand);
    if (oi.ok && fits(0 - oi.v, oi.suffix, oi.v)) {
      return lit_int(0 - oi.v, oi.suffix);
    }
  }
  if (op == "!") {
    let ob: OptBool = as_bool_lit(operand);
    if (ob.ok) {
      return lit_bool(!ob.v);
    }
  }
  return unfolded;
}

function fold_stmt(st: ast.Stmt): ast.Stmt {
  return astwalk.map_stmt(st, fold_node);
}

function fold_block(body: ast.Stmt[]): ast.Stmt[] {
  return astwalk.map_stmts(body, fold_node);
}

pub function fold_module(mod: parser.Module): parser.Module {
  let funcs: parser.FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    funcs = funcs.append(parser.FuncDecl { ...mod.funcs[i], body: fold_block(mod.funcs[i].body) });
    i = i + 1;
  }
  return parser.Module { ...mod, funcs: funcs, top_stmts: fold_block(mod.top_stmts) };
}

pub function prune_literal_branches(mod: parser.Module): parser.Module {
  let funcs: parser.FuncDecl[] = [];
  for fd in mod.funcs {
    funcs = funcs.append(parser.FuncDecl { ...fd, body: prune_block(fd.body) });
  }
  return parser.Module { ...mod, funcs: funcs, top_stmts: prune_block(mod.top_stmts) };
}

function prune_block(body: ast.Stmt[]): ast.Stmt[] {
  let (out, a) = astwalk.map_stmts_acc(body, 0, prune_stmt, keep_expr);
  return out;
}

function keep_expr(e: ast.Expr, a: i32): (ast.Expr, i32, boolean) {
  match (e) {
    ast.ExprLambda(lm) => {
      if (lm.origin == parser.ORIGIN_IF_EXPR) {
        return (ast.ExprLambda { ...lm, body: prune_arm(lm.body) }, a, true);
      }
      return (e, a, false);
    },
    _ => {
      return (e, a, false);
    }
  }
  return (e, a, false);
}

function prune_arm(body: ast.Stmt[]): ast.Stmt[] {
  if (body.len() == 0) {
    return body;
  }
  let leading: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < body.len() - 1) {
    leading = leading.append(body[i]);
    i = i + 1;
  }
  let out: ast.Stmt[] = prune_block(leading);
  let last: ast.Stmt = body[body.len() - 1];
  match (last) {
    ast.StmtIf(f) => {
      return out.append(ast.StmtIf { ...f, cond: fold_expr(f.cond), then_body: prune_arm(f.then_body), else_body: prune_arm(f.else_body) });
    },
    _ => {
      for st in prune_block([last]) {
        out = out.append(st);
      }
      return out;
    }
  }
  return out;
}

function prune_stmt(s: ast.Stmt, a: i32): (ast.Stmt, i32, boolean) {
  match (s) {
    ast.StmtIf(f) => {
      return (pruned_if(f), a, true);
    },
    _ => {
      return (s, a, false);
    }
  }
  return (s, a, false);
}

function pruned_if(f: ast.StmtIf): ast.Stmt {
  let cond: ast.Expr = fold_expr(f.cond);
  let lit: OptBool = as_bool_lit(cond);
  let none: ast.Stmt[] = [];
  if (!lit.ok) {
    return ast.StmtIf { ...f, cond: cond, then_body: prune_block(f.then_body), else_body: prune_block(f.else_body) };
  }
  if (lit.v) {
    return ast.StmtIf { ...f, cond: cond, then_body: prune_block(f.then_body), else_body: none, else_chained: false };
  }
  return ast.StmtIf { ...f, cond: lit_bool(true), then_body: prune_block(f.else_body), else_body: none, else_chained: false };
}

const TARGET_OS_BUILTIN: string = "target_os";

const TARGET_ARCH_BUILTIN: string = "target_arch";

struct TargetAcc { env: string, arch: string }

pub function fold_target_name(mod: parser.Module, env: string, arch: string): parser.Module {
  if (env.len() == 0) {
    return mod;
  }
  let acc: TargetAcc = TargetAcc { env: env, arch: arch };
  let funcs: parser.FuncDecl[] = [];
  for fd in mod.funcs {
    let (body, a2) = astwalk.map_stmts_acc(fd.body, acc, to_keep_stmt, to_expr);
    acc = a2;
    funcs = funcs.append(parser.FuncDecl { ...fd, body: body });
  }
  let (tops, a3) = astwalk.map_stmts_acc(mod.top_stmts, acc, to_keep_stmt, to_expr);
  return parser.Module { ...mod, funcs: funcs, top_stmts: tops };
}

function to_keep_stmt(s: ast.Stmt, a: TargetAcc): (ast.Stmt, TargetAcc, boolean) {
  return (s, a, false);
}

function to_expr(e: ast.Expr, a: TargetAcc): (ast.Expr, TargetAcc, boolean) {
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() != 0) {
        return (e, a, false);
      }
      match (c.callee) {
        ast.ExprIdent(id) => {
          if (id.name == TARGET_OS_BUILTIN) {
            return (ast.ExprString { value: a.env, line: c.line, col: c.col }, a, true);
          }
          if (id.name == TARGET_ARCH_BUILTIN) {
            return (ast.ExprString { value: a.arch, line: c.line, col: c.col }, a, true);
          }
        },
        _ => {}
      }
      return (e, a, false);
    },
    _ => {
      return (e, a, false);
    }
  }
  return (e, a, false);
}

pub function elide_asserts(mod: parser.Module): parser.Module {
  let funcs: parser.FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    funcs = funcs.append(parser.FuncDecl { ...mod.funcs[i], body: astwalk.splice_stmts_with_lambda(mod.funcs[i].body, drop_assert, elided_lambda_captures) });
    i = i + 1;
  }
  return parser.Module { ...mod, funcs: funcs, top_stmts: astwalk.splice_stmts_with_lambda(mod.top_stmts, drop_assert, elided_lambda_captures) };
}

function elided_lambda_captures(lm: ast.ExprLambda): ast.ExprLambda {
  if (!lm.captures_known || lm.captures.len() == 0) {
    return lm;
  }
  let captures: ast.TypedBinding[] = [];
  let seen: string[] = [];
  for name in astwalk.collect_lambda_idents(lm, []) {
    if (!util.has_str(seen, name)) {
      seen = seen.append(name);
      for cap in lm.captures {
        if (cap.name == name) {
          captures = captures.append(cap);
        }
      }
    }
  }
  return ast.ExprLambda { ...lm, captures: captures };
}

function drop_assert(st: ast.Stmt): ast.Stmt[] {
  let keep: ast.Stmt[] = [st];
  match (st) {
    ast.StmtIf(f) => {
      if (f.origin == parser.ORIGIN_ASSERT) {
        let gone: ast.Stmt[] = [];
        return gone;
      }
      return keep;
    },
    _ => {
      return keep;
    }
  }
  return keep;
}

function is_binary_init(mod: parser.Module, op: string): boolean {
  if let ast.StmtVar(v) = mod.top_stmts[0] {
    if let ast.ExprBinary(b) = v.init {
      return b.op == op;
    }
  }
  return false;
}

function fold_source(src: string): parser.Module {
  return fold_module(parser.parse_module(lexer.tokenize(src)));
}

function main(): i32 {
  let mod1: parser.Module = fold_source("let a = 1 + 2 * 3; return a;");
  match (mod1.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprNumber(n) => {
          if (n.text != "7") {
            return 10;
          }
        },
        _ => {
          return 11;
        }
      }
    },
    _ => {
      return 12;
    }
  }

  let mod2: parser.Module = fold_source("let a = (1 + 2) * 3; return a;");
  match (mod2.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprNumber(n) => {
          if (n.text != "9") {
            return 20;
          }
        },
        _ => {
          return 21;
        }
      }
    },
    _ => {
      return 22;
    }
  }

  let mod3: parser.Module = fold_source("let b = 5 < 10; return 0;");
  match (mod3.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprBool(b) => {
          if (!b.value) {
            return 30;
          }
        },
        _ => {
          return 31;
        }
      }
    },
    _ => {
      return 32;
    }
  }

  let mod4: parser.Module = fold_source("let a = true && false; let b = !true; return 0;");
  match (mod4.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprBool(b) => {
          if (b.value) {
            return 40;
          }
        },
        _ => {
          return 41;
        }
      }
    },
    _ => {
      return 42;
    }
  }
  match (mod4.top_stmts[1]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprBool(b) => {
          if (b.value) {
            return 43;
          }
        },
        _ => {
          return 44;
        }
      }
    },
    _ => {
      return 45;
    }
  }

  let mod5: parser.Module = fold_source("let s = \"hi \" + \"there\"; return 0;");
  match (mod5.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprString(s) => {
          if (s.value != "hi there") {
            return 50;
          }
        },
        _ => {
          return 51;
        }
      }
    },
    _ => {
      return 52;
    }
  }

  let mod6: parser.Module = fold_source("let a = 1 + x; return 0;");
  match (mod6.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 60;
          }
        },
        _ => {
          return 61;
        }
      }
    },
    _ => {
      return 62;
    }
  }

  let mod7: parser.Module = fold_source("let a = 1 / 0; return 0;");
  match (mod7.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprBinary(b) => {
          if (b.op != "/") {
            return 70;
          }
        },
        _ => {
          return 71;
        }
      }
    },
    _ => {
      return 72;
    }
  }

  let mod8: parser.Module = fold_source("let a = (2 + 3) * (4 + 5); return 0;");
  match (mod8.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprNumber(n) => {
          if (n.text != "45") {
            return 80;
          }
        },
        _ => {
          return 81;
        }
      }
    },
    _ => {
      return 82;
    }
  }

  let mod9: parser.Module = fold_source("function add(): i32 { return 1 + 2; } function main(): i32 { return add(); }");
  if (mod9.funcs.len() != 2) {
    return 90;
  }
  match (mod9.funcs[0].body[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprNumber(n) => {
          if (n.text != "3") {
            return 91;
          }
        },
        _ => {
          return 92;
        }
      }
    },
    _ => {
      return 93;
    }
  }

  let mod10: parser.Module = fold_source("let a = 2147484527u32 % 861u32; return 0;");
  match (mod10.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprNumber(n) => {
          if (n.text != "713") {
            return 100;
          }
          if (n.suffix != "u32") {
            return 101;
          }
        },
        _ => {
          return 102;
        }
      }
    },
    _ => {
      return 103;
    }
  }

  let mod11: parser.Module = fold_source("let a = 5u32 - 10u32; return 0;");
  match (mod11.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprBinary(b) => {
          if (b.op != "-") {
            return 110;
          }
        },
        _ => {
          return 111;
        }
      }
    },
    _ => {
      return 112;
    }
  }

  let mod12: parser.Module = fold_source("let a = 2000000000 + 2000000000; return 0;");
  match (mod12.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 120;
          }
        },
        _ => {
          return 121;
        }
      }
    },
    _ => {
      return 122;
    }
  }

  let mod13: parser.Module = fold_source("let a = 5u32 + 5; return 0;");
  match (mod13.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 130;
          }
        },
        _ => {
          return 131;
        }
      }
    },
    _ => {
      return 132;
    }
  }

  let mod14: parser.Module = fold_source("let a = 0i32 - 2147483647i32 - 1i32; return 0;");
  match (mod14.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprUnary(u) => {
          if (u.op != "-") {
            return 140;
          }
          match (u.operand) {
            ast.ExprNumber(n) => {
              if (n.text != "2147483648") {
                return 141;
              }
            },
            _ => {
              return 142;
            }
          }
        },
        _ => {
          return 143;
        }
      }
    },
    _ => {
      return 144;
    }
  }

  if (!is_binary_init(fold_source("let a = 0 - 2147483647 - 1; return 0;"), "-")) {
    return 145;
  }
  if (!is_binary_init(fold_source("let a = 0 - 1; return 0;"), "-")) {
    return 146;
  }
  if (!is_binary_init(fold_source("let a = (255 + 1) / 2; return 0;"), "/")) {
    return 147;
  }
  if (!is_binary_init(fold_source("let a = 16 * 16; return 0;"), "*")) {
    return 148;
  }
  match (fold_source("let a = 1024 * 1024; return 0;").top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprNumber(n) => {
          if (n.text != "1048576") {
            return 149;
          }
        },
        _ => {
          return 133;
        }
      }
    },
    _ => {
      return 134;
    }
  }

  let mod15: parser.Module = elide_asserts(fold_source(
    "function main(): i32 { assert(1 > 2); return 0; }",
  ));
  if (mod15.funcs[0].body.len() != 1) {
    return 150;
  }
  match (mod15.funcs[0].body[0]) {
    ast.StmtReturn(_) => {},
    _ => {
      return 151;
    }
  }

  let mod16: parser.Module = elide_asserts(fold_source(
    "function main(): i32 { if (1 > 2) { return 3; } return 0; }",
  ));
  if (mod16.funcs[0].body.len() != 2) {
    return 152;
  }

  let mod17: parser.Module = elide_asserts(fold_source(
    "function main(): i32 { while (false) { assert(1 > 2); } return 0; }",
  ));
  match (mod17.funcs[0].body[0]) {
    ast.StmtWhile(w) => {
      if (w.body.len() != 0) {
        return 160;
      }
    },
    _ => {
      return 161;
    }
  }

  let mod18: parser.Module = elide_asserts(fold_source(
    "function main(): i32 { let f = (): i32 => { assert(1 > 2); return 1; }; return 0; }",
  ));
  match (mod18.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprLambda(lm) => {
          if (lm.body.len() != 1) {
            return 170;
          }
        },
        _ => {
          return 171;
        }
      }
    },
    _ => {
      return 172;
    }
  }

  let mod19: parser.Module = elide_asserts(fold_source(
    "enum E { A(i32) } function main(): i32 { let e: E = E.A(1); match (e) { E.A(v) => { assert(v > 2); }, _ => { return 9; } } return 0; }",
  ));
  match (mod19.funcs[0].body[1]) {
