// Index reads a dominating guard proves in range: an `array_get` or
// `str_index` whose index the branches into its block show to be at least zero
// and below the length of what it reads is marked unchecked (`imm` 1), the flag
// the parser's len-bounded loop pass already sets and every backend honours.
// It runs on the typed semantic graphs every backend lowers from.
// `grouped_reads` then checks a run of reads at one index plus constants once
// at each end instead of at every read.
//
// A block learns a compare when its only predecessor ends in a two-way `brif`
// on it: true on the `t` edge, false on the `f` edge. Every block it dominates
// learns it too. Only compares of two i32 values count, each as `lo < hi` or
// `lo <= hi`.
//
// An index `x` is below `length(b)` when
//   - a fact says `x < y` and `y` is `length(b)`, or `y` is below it;
//   - a fact says `x <= y` and `y` is below `length(b)`;
//   - `x` is `length(b) - c` for a constant `c >= 1`;
//   - `x` is `y - c` for a constant `c >= 0`, with `y` below `length(b)` and at
//     least zero where `x` is computed, so the subtraction cannot wrap;
//   - `x` is a phi whose operands are all below `length(b)`, the phi itself
//     assumed to be: induction over the loop's trips.
// An index `x` is at least zero when
//   - it is a constant at least zero, or a `length`;
//   - a fact says `c <= x` or `c < x` for a constant `c` that settles it, or
//     `y <= x` or `y < x` with `y` at least zero;
//   - `x` is `y + 1` with `y` at least zero and, where `x` is computed, below a
//     length, so the addition cannot wrap;
//   - `x` is `length(b) - c` with a fact putting `length(b)` at `c` or more;
//   - `x` is a phi whose operands are all at least zero, assuming the phi is.
import "./ssa";
import "./ssadeps";
import "./ssasem";
import "./typeinfo";
import "./util";

struct Rel { lo: i32, hi: i32, strict: boolean }

// One function indexed for the proofs. `defs[v]` is value v's defining
// instruction and `home[v]` the position of its block. The facts block b
// learns from its own edge are `rels[first[b] .. first[b] + count[b]]`. `up[b]`
// is b when it learns any, else its nearest dominator that does, and -1 when
// none does; `above[b]` is the nearest strict dominator that does.
struct Graph { defs: ssa.SInst[], home: i32[], i32s: boolean[], rels: Rel[], first: i32[], count: i32[], up: i32[], above: i32[] }

pub function proven_indices(f: ssasem.Func): ssasem.Func {
  if (!any_checked_index(f)) {
    return f;
  }
  let g: Graph = graph_of(f);
  if (g.rels.len() == 0) {
    return f;
  }
  let blocks: ssa.SBlock[] = [];
  let changed: boolean = false;
  let b: i32 = 0;
  while (b < f.graph.blocks.len()) {
    let blk: ssa.SBlock = f.graph.blocks[b];
    let insts: ssa.SInst[] = [];
    let marked: boolean = false;
    for ins in blk.insts {
      if (checked_index(ins) && g.i32s[ins.args[1]] && proven(g, b, ins.args[1], ins.args[0])) {
        insts = insts.append(ssa.SInst { ...ins, imm: 1 });
        marked = true;
      } else {
        insts = insts.append(ins);
      }
    }
    if (marked) {
      blk = ssa.SBlock { ...blk, insts: insts };
      changed = true;
    }
    blocks = blocks.append(blk);
    b = b + 1;
  }
  if (!changed) {
    return f;
  }
  return ssasem.Func { ...f, graph: ssa.SFunc { ...f.graph, blocks: blocks } };
}

function checked_index(ins: ssa.SInst): boolean {
  return (ins.kind_tag == ssasem.array_get() || ins.kind_tag == ssasem.str_index()) && ins.imm == 0 && ins.args.len() == 2;
}

function any_checked_index(f: ssasem.Func): boolean {
  for blk in f.graph.blocks {
    for ins in blk.insts {
      if (checked_index(ins)) {
        return true;
      }
    }
  }
  return false;
}

function proven(g: Graph, b: i32, idx: i32, base: i32): boolean {
  return nonneg(g, b, idx, [], depth()) && below(g, b, idx, base, [], depth());
}

// How many steps a proof may take: guard chains in real code are short, and
// the bound keeps a proof's cost independent of the graph's size.
function depth(): i32 {
  return 6;
}

function graph_of(f: ssasem.Func): Graph {
  let n: i32 = f.values.len();
  let none: ssa.SInst = ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  let defs: ssa.SInst[] = [];
  let home: i32[] = [];
  let i32s: boolean[] = [];
  let v: i32 = 0;
  while (v < n) {
    defs = defs.append(none);
    home = home.append(0 - 1);
    i32s = i32s.append(ssasem.is_i32(f.values[v]));
    v = v + 1;
  }
  let nb: i32 = f.graph.blocks.len();
  let b: i32 = 0;
  while (b < nb) {
    for ins in f.graph.blocks[b].insts {
      if (ins.result >= 0 && ins.result < n) {
        defs = defs.with(ins.result, ins);
        home = home.with(ins.result, b);
      }
    }
    b = b + 1;
  }
  let g: Graph = Graph { defs: defs, home: home, i32s: i32s, rels: [], first: [], count: [], up: [], above: [] };
  let at: i32[] = ssadeps.position_of(f.graph);
  b = 0;
  while (b < nb) {
    let blk: ssa.SBlock = f.graph.blocks[b];
    let before: i32 = g.rels.len();
    if (blk.preds.len() == 1) {
      let p: i32 = at[blk.preds[0]];
      if (p >= 0) {
        let term: ssa.STerm = f.graph.blocks[p].term;
        if (term.kind_tag == 3 && term.t != term.f) {
          g = learn(g, term.cond, term.t == blk.id, 2);
        }
      }
    }
    g = Graph { ...g, first: g.first.append(before), count: g.count.append(g.rels.len() - before) };
    b = b + 1;
  }
  return with_dominators(g, ssadeps.dominates(f.graph), nb);
}

// learn adds what knowing `cond` is `truth` says, when `cond` compares two i32
// values: directly, or through `!`.
function learn(g: Graph, cond: i32, truth: boolean, hops: i32): Graph {
  if (cond < 0 || cond >= g.defs.len() || hops <= 0) {
    return g;
  }
  let c: ssa.SInst = g.defs[cond];
  if (c.kind_tag == 10 && c.str == "!" && c.args.len() == 1) {
    return learn(g, c.args[0], !truth, hops - 1);
  }
  if (c.kind_tag != 9 || c.args.len() != 2) {
    return g;
  }
  let x: i32 = c.args[0];
  let y: i32 = c.args[1];
  if (!g.i32s[x] || !g.i32s[y]) {
    return g;
  }
  if (c.str == "<") {
    return fact(g, x, y, truth, true);
  }
  if (c.str == ">=") {
    return fact(g, x, y, !truth, true);
  }
  if (c.str == ">") {
    return fact(g, y, x, truth, true);
  }
  if (c.str == "<=") {
    return fact(g, y, x, !truth, true);
  }
  if (c.str == "==" && truth || c.str == "!=" && !truth) {
    return fact(fact(g, x, y, true, false), y, x, true, false);
  }
  return g;
}

// fact records `lo < hi` (`strict`) or `lo <= hi` when `held`, else the
// converse: `hi <= lo` for a strict relation that failed, `hi < lo` for a weak
// one.
function fact(g: Graph, lo: i32, hi: i32, held: boolean, strict: boolean): Graph {
  if (held) {
    return Graph { ...g, rels: g.rels.append(Rel { lo: lo, hi: hi, strict: strict }) };
  }
  return Graph { ...g, rels: g.rels.append(Rel { lo: hi, hi: lo, strict: !strict }) };
}

// with_dominators fills `up` and `above` from a walk of the dominator tree in
// preorder: an ancestor stays on the stack while its interval holds the block.
function with_dominators(g: Graph, d: ssadeps.Dom, nb: i32): Graph {
  let up: i32[] = [];
  let above: i32[] = [];
  let b: i32 = 0;
  while (b < nb) {
    up = up.append(0 - 1);
    above = above.append(0 - 1);
    b = b + 1;
  }
  // `pre` and `post` share one clock, so a preorder number is below 2 * nb.
  let order: i32[] = [];
  while (order.len() < 2 * nb) {
    order = order.append(0 - 1);
  }
  b = 0;
  while (b < nb) {
    if (d.pre[b] >= 0 && d.pre[b] < 2 * nb) {
      order = order.with(d.pre[b], b);
    }
    b = b + 1;
  }
  let stack: i32[] = [];
  let sp: i32 = 0;
  for k in order {
    if (k < 0) {
      continue;
    }
    while (sp > 0 && !ssadeps.dom_holds(d, k, stack[sp - 1])) {
      sp = sp - 1;
    }
    let inherited: i32 = 0 - 1;
    if (sp > 0) {
      inherited = up[stack[sp - 1]];
    }
    above = above.with(k, inherited);
    if (g.count[k] > 0) {
      up = up.with(k, k);
    } else {
      up = up.with(k, inherited);
    }
    if (sp < stack.len()) {
      stack = stack.with(sp, k);
    } else {
      stack = stack.append(k);
    }
    sp = sp + 1;
  }
  return Graph { ...g, up: up, above: above };
}

// root sees through copies, which name the value they copy.
function root(g: Graph, v: i32): i32 {
  let hops: i32 = 0;
  while (v >= 0 && v < g.defs.len() && g.defs[v].kind_tag == 7 && g.defs[v].args.len() == 1 && hops < 8) {
    v = g.defs[v].args[0];
    hops = hops + 1;
  }
  return v;
}

// same reports whether two values are one quantity: the same value, or the
// same projection of the same values. A field, tuple element, element or
// length read twice from one value reads the same thing, since every one of
// them is immutable.
function same(g: Graph, a: i32, b: i32): boolean {
  return equal(g, a, b, 4);
}

function equal(g: Graph, a: i32, b: i32, steps: i32): boolean {
  a = root(g, a);
  b = root(g, b);
  if (a == b) {
    return true;
  }
  if (steps <= 0 || a < 0 || b < 0) {
    return false;
  }
  let da: ssa.SInst = g.defs[a];
  let db: ssa.SInst = g.defs[b];
  if (da.kind_tag != db.kind_tag || !projection(da.kind_tag) || da.imm != db.imm || da.str != db.str || da.args.len() != db.args.len()) {
    return false;
  }
  let k: i32 = 0;
  while (k < da.args.len()) {
    if (!equal(g, da.args[k], db.args[k], steps - 1)) {
      return false;
    }
    k = k + 1;
  }
  return da.args.len() > 0;
}

function projection(kind: i32): boolean {
  return kind == ssasem.record_get() || kind == ssasem.tuple_get() || kind == ssasem.length() || kind == ssasem.array_get();
}

function def_of(g: Graph, v: i32): ssa.SInst {
  return g.defs[root(g, v)];
}

function is_const(g: Graph, v: i32): boolean {
  let r: i32 = root(g, v);
  return g.defs[r].kind_tag == 1 && g.i32s[r];
}

function const_value(g: Graph, v: i32): i32 {
  return def_of(g, v).imm;
}

function is_length(g: Graph, v: i32): boolean {
  return def_of(g, v).kind_tag == ssasem.length();
}

function is_length_of(g: Graph, v: i32, base: i32): boolean {
  let d: ssa.SInst = def_of(g, v);
  return d.kind_tag == ssasem.length() && d.args.len() == 1 && same(g, d.args[0], base);
}

function binary(d: ssa.SInst, op: string): boolean {
  return d.kind_tag == 9 && d.str == op && d.args.len() == 2;
}

function assumed(assume: i32[], v: i32): boolean {
  for a in assume {
    if (a == v) {
      return true;
    }
  }
  return false;
}

// below reports whether `x` is less than `length(base)` wherever block b runs.
function below(g: Graph, b: i32, x: i32, base: i32, assume: i32[], steps: i32): boolean {
  if (steps <= 0) {
    return false;
  }
  x = root(g, x);
  let d: ssa.SInst = g.defs[x];
  if (binary(d, "-") && is_const(g, d.args[1])) {
    let c: i32 = const_value(g, d.args[1]);
    if (c >= 1 && is_length_of(g, d.args[0], base)) {
      return true;
    }
    let at: i32 = g.home[x];
    if (c >= 0 && below(g, at, d.args[0], base, assume, steps - 1) && nonneg(g, at, d.args[0], [], steps - 1)) {
      return true;
    }
  }
  if (d.kind_tag == 8 && g.i32s[x]) {
    if (assumed(assume, x)) {
      return true;
    }
    let inner: i32[] = assume.append(x);
    let all: boolean = d.args.len() > 0;
    for o in d.args {
      if (all && !below(g, g.home[root(g, o)], o, base, inner, steps - 1)) {
        all = false;
      }
    }
    if (all) {
      return true;
    }
  }
  if (b < 0) {
    return false;
  }
  let c: i32 = g.up[b];
  while (c >= 0) {
    let k: i32 = g.first[c];
    while (k < g.first[c] + g.count[c]) {
      let r: Rel = g.rels[k];
      if (same(g, r.lo, x)) {
        if (r.strict && is_length_of(g, r.hi, base)) {
          return true;
        }
        if (below(g, b, r.hi, base, assume, steps - 1)) {
          return true;
        }
      }
      k = k + 1;
    }
    c = g.above[c];
  }
  return false;
}

// nonneg reports whether `x` is at least zero wherever block b runs.
function nonneg(g: Graph, b: i32, x: i32, assume: i32[], steps: i32): boolean {
  if (steps <= 0) {
    return false;
  }
  x = root(g, x);
  if (is_const(g, x)) {
    return const_value(g, x) >= 0;
  }
  if (is_length(g, x)) {
    return true;
  }
  let d: ssa.SInst = g.defs[x];
  let at: i32 = g.home[x];
  if (binary(d, "+")) {
    let y: i32 = 0 - 1;
    if (is_const(g, d.args[1]) && const_value(g, d.args[1]) == 1) {
      y = d.args[0];
    } else if (is_const(g, d.args[0]) && const_value(g, d.args[0]) == 1) {
      y = d.args[1];
    }
    if (y >= 0 && nonneg(g, at, y, assume, steps - 1) && below_a_length(g, at, y)) {
      return true;
    }
  }
  if (binary(d, "-") && is_const(g, d.args[1]) && is_length(g, d.args[0])) {
    if (at_least(g, at, d.args[0], const_value(g, d.args[1]))) {
      return true;
    }
  }
  if (d.kind_tag == 8 && g.i32s[x]) {
    if (assumed(assume, x)) {
      return true;
    }
    let inner: i32[] = assume.append(x);
    let all: boolean = d.args.len() > 0;
    for o in d.args {
      if (all && !nonneg(g, g.home[root(g, o)], o, inner, steps - 1)) {
        all = false;
      }
    }
    if (all) {
      return true;
    }
  }
  if (b < 0) {
    return false;
  }
  let c: i32 = g.up[b];
  while (c >= 0) {
    let k: i32 = g.first[c];
    while (k < g.first[c] + g.count[c]) {
      let r: Rel = g.rels[k];
      if (same(g, r.hi, x)) {
        if (is_const(g, r.lo)) {
          let low: i32 = const_value(g, r.lo);
          if (low >= 0 || r.strict && low == 0 - 1) {
            return true;
          }
        } else if (nonneg(g, b, r.lo, assume, steps - 1)) {
          return true;
        }
      }
      k = k + 1;
    }
    c = g.above[c];
  }
  return false;
}

// below_a_length reports whether a fact at block b puts `y` strictly below
// some length, which caps `y + 1` at the largest i32.
function below_a_length(g: Graph, b: i32, y: i32): boolean {
  if (b < 0) {
    return false;
  }
  y = root(g, y);
  let c: i32 = g.up[b];
  while (c >= 0) {
    let k: i32 = g.first[c];
    while (k < g.first[c] + g.count[c]) {
      let r: Rel = g.rels[k];
      if (r.strict && same(g, r.lo, y) && is_length(g, r.hi)) {
        return true;
      }
      k = k + 1;
    }
    c = g.above[c];
  }
  return false;
}

// at_least reports whether a fact at block b puts `y` at `n` or more.
function at_least(g: Graph, b: i32, y: i32, n: i32): boolean {
  if (n <= 0 && is_length(g, y)) {
    return true;
  }
  if (b < 0) {
    return false;
  }
  y = root(g, y);
  let c: i32 = g.up[b];
  while (c >= 0) {
    let k: i32 = g.first[c];
    while (k < g.first[c] + g.count[c]) {
      let r: Rel = g.rels[k];
      if (same(g, r.hi, y) && is_const(g, r.lo)) {
        let low: i32 = const_value(g, r.lo);
        if (low >= n || r.strict && low >= n - 1) {
          return true;
        }
      }
      k = k + 1;
    }
    c = g.above[c];
  }
  return false;
}

// grouped_reads checks a run of reads of one array at one index plus
// constants, `bs[off]` then `bs[off + 1]` ... `bs[off + 63]`, at its two ends
// rather than at every read. The run's first read keeps its check and must
// have the smallest offset, at least zero; a probe read of the largest offset,
// placed before it, checks the other end; the reads between are unchecked.
// Between the first read and the last, nothing may abort another way or be
// observed (`silent`), so aborting at the probe instead of at the read that
// would have failed cannot be told apart: the abort names no index.
pub function grouped_reads(f: ssasem.Func): ssasem.Func {
  if (!any_checked_index(f)) {
    return f;
  }
  let defs: ssa.SInst[] = definitions(f);
  let values: typeinfo.Type[] = f.values;
  let blocks: ssa.SBlock[] = [];
  let changed: boolean = false;
  for blk in f.graph.blocks {
    let plan: Probes = probes_of(f, defs, blk.insts);
    if (plan.at.len() == 0) {
      blocks = blocks.append(blk);
      continue;
    }
    let insts: ssa.SInst[] = [];
    let p: i32 = 0;
    let pos: i32 = 0;
    while (pos < blk.insts.len()) {
      let ins: ssa.SInst = blk.insts[pos];
      if (p < plan.at.len() && plan.at[p] == pos) {
        let v: i32 = values.len();
        let x: i32 = plan.x[p];
        insts = insts.append(ssa.SInst { kind_tag: 1, result: v, args: [], imm: plan.c[p], str: "" });
        insts = insts.append(ssa.SInst { kind_tag: 9, result: v + 1, args: [x, v], imm: 0, str: "+" });
        insts = insts.append(ssa.SInst { ...ins, result: v + 2, args: [ins.args[0], v + 1], imm: 0 });
        values = values.append(f.values[x]).append(f.values[x]).append(f.values[ins.result]);
        p = p + 1;
      }
      if (plan.unchecked[pos]) {
        ins = ssa.SInst { ...ins, imm: 1 };
      }
      insts = insts.append(ins);
      pos = pos + 1;
    }
    blocks = blocks.append(ssa.SBlock { ...blk, insts: insts });
    changed = true;
  }
  if (!changed) {
    return f;
  }
  return ssasem.Func { ...f, values: values, graph: ssa.SFunc { ...f.graph, blocks: blocks, nvals: values.len() } };
}

// Where a block's probes go: before the instruction at `at[i]`, a read of the
// same array at `x[i] + c[i]`; `unchecked` marks the reads they cover.
struct Probes { at: i32[], x: i32[], c: i32[], unchecked: boolean[] }

function definitions(f: ssasem.Func): ssa.SInst[] {
  let none: ssa.SInst = ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  let defs: ssa.SInst[] = [];
  let v: i32 = 0;
  while (v < f.values.len()) {
    defs = defs.append(none);
    v = v + 1;
  }
  for blk in f.graph.blocks {
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < defs.len()) {
        defs = defs.with(ins.result, ins);
      }
    }
  }
  return defs;
}

function probes_of(f: ssasem.Func, defs: ssa.SInst[], insts: ssa.SInst[]): Probes {
  let out: Probes = Probes { at: [], x: [], c: [], unchecked: __alloc_bool(insts.len()) };
  let start: i32 = 0;
  let pos: i32 = 0;
  while (pos <= insts.len()) {
    if (pos == insts.len() || !silent(f, insts[pos])) {
      out = probes_in_run(f, defs, insts, start, pos, out);
      start = pos + 1;
    }
    pos = pos + 1;
  }
  return out;
}

// The groups among the reads of insts[start .. end), a run of silent
// instructions, each probed before its first read.
function probes_in_run(f: ssasem.Func, defs: ssa.SInst[], insts: ssa.SInst[], start: i32, end: i32, own out: Probes): Probes {
  let reads: i32[] = [];
  let k: i32 = start;
  while (k < end) {
    let ins: ssa.SInst = insts[k];
    if (ins.kind_tag == ssasem.array_get() && checked_index(ins) && ssasem.is_i32(f.values[ins.args[1]]) && scalar(f, ins.result)) {
      reads = reads.append(k);
    }
    k = k + 1;
  }
  let done: boolean[] = __alloc_bool(reads.len());
  let i: i32 = 0;
  while (i < reads.len()) {
    if (done[i]) {
      i = i + 1;
      continue;
    }
    let first: ssa.SInst = insts[reads[i]];
    let x: i32 = offset_base(f, defs, first.args[1]);
    let low: i32 = offset_of(f, defs, first.args[1]);
    let high: i32 = low;
    let members: i32[] = [];
    let j: i32 = i + 1;
    while (j < reads.len()) {
      let r: ssa.SInst = insts[reads[j]];
      if (!done[j] && r.args[0] == first.args[0] && offset_base(f, defs, r.args[1]) == x) {
        done = done.with(j, true);
        let c: i32 = offset_of(f, defs, r.args[1]);
        if (c < low) {
          low = c;
        }
        if (c > high) {
          high = c;
        }
        members = members.append(reads[j]);
      }
      j = j + 1;
    }
    if (members.len() >= 2 && low == offset_of(f, defs, first.args[1]) && low >= 0 && high > low) {
      out = Probes { ...out, at: out.at.append(reads[i]), x: out.x.append(x), c: out.c.append(high) };
      for m in members {
        out = Probes { ...out, unchecked: out.unchecked.with(m, true) };
      }
    }
    i = i + 1;
  }
  return out;
}

// offset_base is the `x` of an index `x + c` with `c` a constant, or the index
// itself; offset_of is that `c`, or 0.
function offset_base(f: ssasem.Func, defs: ssa.SInst[], v: i32): i32 {
  let c: i32 = constant_operand(f, defs, v);
  if (c < 0) {
    return v;
  }
  return defs[v].args[1 - c];
}

function offset_of(f: ssasem.Func, defs: ssa.SInst[], v: i32): i32 {
  let c: i32 = constant_operand(f, defs, v);
  if (c < 0) {
    return 0;
  }
  return defs[defs[v].args[c]].imm;
}

// constant_operand is which operand of an i32 `+` defining v is a constant,
// or -1.
function constant_operand(f: ssasem.Func, defs: ssa.SInst[], v: i32): i32 {
  let d: ssa.SInst = defs[v];
  if (d.kind_tag != 9 || d.str != "+" || d.args.len() != 2 || !ssasem.is_i32(f.values[v])) {
    return 0 - 1;
  }
  let k: i32 = 0;
  while (k < 2) {
    let a: ssa.SInst = defs[d.args[k]];
    if (a.kind_tag == 1 && ssasem.is_i32(f.values[d.args[k]])) {
      return k;
    }
    k = k + 1;
  }
  return 0 - 1;
}

// A probe's result is never used, so only a read of a scalar, which owns
// nothing, may be probed.
function scalar(f: ssasem.Func, v: i32): boolean {
  return ssasem.is_integer(f.values[v]) || ssasem.is_bool(f.values[v]);
}

// silent reports whether an instruction can neither abort nor be observed:
// integer and boolean arithmetic other than division, an integer conversion, a
// constant, a phi, a length or an array read, whose own abort says the same as
// the probe's.
function silent(f: ssasem.Func, ins: ssa.SInst): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 1 || k == 2 || k == 3 || k == 7 || k == 8 || k == ssasem.param()) {
    return true;
  }
  if (k == ssasem.array_get() || k == ssasem.length()) {
    return true;
  }
  if (ins.result < 0 || ins.result >= f.values.len()) {
    return false;
  }
  let t: typeinfo.Type = f.values[ins.result];
  if (k == 9) {
    return ins.str != "/" && ins.str != "%" && scalar(f, ins.result);
  }
  if (k == 10) {
    return scalar(f, ins.result);
  }
  if (k == ssasem.cast()) {
    return ins.args.len() == 1 && ssasem.is_integer(t) && ssasem.is_integer(f.values[ins.args[0]]);
  }
  return false;
}

// word_loads rewrites a word assembled from a byte array —
// `b[x] as u32 | b[x + 1] as u32 << 8 | … | b[x + 3] as u32 << 24`, or the
// eight-byte u64 form — into one load of the word, which every target reads
// unaligned and stores little-endian (#8782). A big-endian word, the bytes'
// places mirrored, is that load byte swapped (#10615). Only the `or` that
// completes the word is replaced. The reads stay: the checked ones are the
// run's bounds check, and the unchecked ones the word no longer uses are dead.
// `contracts` are the calls the load is made of, which the function gains when
// it fuses; `view_words` names the four- and eight-byte word reads of a `[u8]`
// view, which reaches its bytes through a decoded data pointer rather than its
// box, and `swaps` the four- and eight-byte byte swaps.
pub function word_loads(f: ssasem.Func, contracts: ssasem.Contract[], view_words: string[], swaps: string[]): ssasem.Func {
  if (!any_checked_index(f)) {
    return f;
  }
  let defs: ssa.SInst[] = definitions(f);
  let values: typeinfo.Type[] = f.values;
  let blocks: ssa.SBlock[] = [];
  let changed: boolean = false;
  let parts: i32[] = [];
  for blk in f.graph.blocks {
    let insts: ssa.SInst[] = [];
    let fused: boolean = false;
    for ins in blk.insts {
      let w: Word = word_of(f, defs, ins);
      if (w.bytes == 0) {
        insts = insts.append(ins);
        continue;
      }
      parts = word_parts(defs, ins.args, w, parts);
      let v: i32 = values.len();
      let wide: typeinfo.Type = typeinfo.TypeI32 { width: w.bytes * 8, unsigned: false, is_char: false, polymorphic: false };
      let addr_t: typeinfo.Type = typeinfo.TypeI32 { width: typeinfo.width_ptr(), unsigned: true, is_char: false, polymorphic: false };
      let i32_t: typeinfo.Type = typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: false };
      // v + 1 is the word's first index: the base plus the lowest offset, or
      // that offset alone.
      insts = insts.append(ssa.SInst { kind_tag: 1, result: v, args: [], imm: w.off, str: "" });
      if (w.x < 0) {
        insts = insts.append(ssa.SInst { kind_tag: 1, result: v + 1, args: [], imm: w.off, str: "" });
      } else {
        insts = insts.append(ssa.SInst { kind_tag: 9, result: v + 1, args: [w.x, v], imm: 0, str: "+" });
      }
      values = values.append(i32_t).append(i32_t);
      fused = true;
      if (is_byte_view(f.values[w.arr])) {
        let name: string = view_words[0];
        if (w.bytes == 8) {
          name = view_words[1];
        }
        insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: v + 2, args: [w.arr, v + 1], imm: 0, str: name });
        values = values.append(wide);
        insts = in_order(insts, w, swaps, v + 2, ins.result);
        if (w.big) {
          values = values.append(wide);
        }
        continue;
      }
      let load: string = "__load_i32";
      if (w.bytes == 8) {
        load = "__load_i64";
      }
      // An array's bytes start eight bytes into its box on every target. The
      // eight is added to the address, not the i32 index, so it cannot wrap.
      insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: v + 2, args: [w.arr], imm: 0, str: "__raw_arr_ptr" });
      insts = insts.append(ssa.SInst { kind_tag: 1, result: v + 3, args: [], imm: 8, str: "" });
      insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: v + 4, args: [v + 2, v + 3], imm: 0, str: "__raw_addr" });
      insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: v + 5, args: [v + 4, v + 1], imm: 0, str: "__raw_addr" });
      insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: v + 6, args: [v + 5], imm: 0, str: load });
      values = values.append(addr_t).append(i32_t).append(addr_t).append(addr_t).append(wide);
      insts = in_order(insts, w, swaps, v + 6, ins.result);
      if (w.big) {
        values = values.append(wide);
      }
    }
    if (fused) {
      blk = ssa.SBlock { ...blk, insts: insts };
      changed = true;
    }
    blocks = blocks.append(blk);
  }
  if (!changed) {
    return f;
  }
  blocks = without_unused(blocks, parts, values.len());
  let calls: ssasem.Contract[] = f.calls;
  for c in contracts {
    if (!has_contract(calls, c.name)) {
      calls = calls.append(c);
    }
  }
  return ssasem.Func { ...f, values: values, calls: calls, graph: ssa.SFunc { ...f.graph, blocks: blocks, nvals: values.len() } };
}

// in_order appends the cast that gives the word `loaded` its unsigned type as
// `result`, byte swapping it first, as value loaded + 1, when it is
// big-endian.
function in_order(own insts: ssa.SInst[], w: Word, swaps: string[], loaded: i32, result: i32): ssa.SInst[] {
  let v: i32 = loaded;
  if (w.big) {
    let name: string = swaps[0];
    if (w.bytes == 8) {
      name = swaps[1];
    }
    v = loaded + 1;
    insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: v, args: [loaded], imm: 0, str: name });
  }
  return insts.append(ssa.SInst { kind_tag: ssasem.cast(), result: result, args: [v], imm: 0, str: "" });
}

// word_parts adds to `acc` the values a fused word was assembled from: its
// `or`s, shifts and casts, the unchecked byte reads and their index arithmetic.
// The array, the base index and a checked read are never among them.
function word_parts(defs: ssa.SInst[], args: i32[], w: Word, acc: i32[]): i32[] {
  for v in args {
    if (v == w.arr || v == w.x || v < 0 || v >= defs.len() || has_value(acc, v)) {
      continue;
    }
    let d: ssa.SInst = defs[v];
    let part: boolean = d.kind_tag == 1 || d.kind_tag == ssasem.cast() || d.kind_tag == 9 && (d.str == "|" || d.str == "<<" || d.str == "+")
      || d.kind_tag == ssasem.array_get() && d.imm == 1;
    if (part) {
      acc = word_parts(defs, d.args, w, acc.append(v));
    }
  }
  return acc;
}

function has_value(xs: i32[], v: i32): boolean {
  for x in xs {
    if (x == v) {
      return true;
    }
  }
  return false;
}

// without_unused drops the instructions defining `parts` that nothing reads,
// until none is left to drop. `n` bounds the value numbers.
function without_unused(blocks: ssa.SBlock[], parts: i32[], n: i32): ssa.SBlock[] {
  let part: boolean[] = falses(n);
  for v in parts {
    part = part.with(v, true);
  }
  let dropped: boolean = true;
  while (dropped) {
    dropped = false;
    let used: boolean[] = falses(n);
    for blk in blocks {
      for ins in blk.insts {
        for a in ins.args {
          if (a >= 0 && a < n) {
            used = used.with(a, true);
          }
        }
      }
      for a in [blk.term.cond, blk.term.value] {
        if (a >= 0 && a < n) {
          used = used.with(a, true);
        }
      }
    }
    let out: ssa.SBlock[] = [];
    for blk in blocks {
      let insts: ssa.SInst[] = [];
      for ins in blk.insts {
        if (ins.result >= 0 && ins.result < n && part[ins.result] && !used[ins.result]) {
          dropped = true;
        } else {
          insts = insts.append(ins);
        }
      }
      out = out.append(ssa.SBlock { ...blk, insts: insts });
    }
    blocks = out;
  }
  return blocks;
}

function falses(n: i32): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(false);
    i = i + 1;
  }
  return out;
}

function is_byte_view(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return a.view && ssasem.is_u8(a.elem);
  }
  return false;
}

function has_contract(calls: ssasem.Contract[], name: string): boolean {
  for c in calls {
    if (c.name == name) {
      return true;
    }
  }
  return false;
}

// A word `ins` completes: `bytes` of a u8 array `arr` read at `x + off` up,
// each shifted to its little-endian place, or each to its big-endian one when
// `big`; `bytes` 0 when `ins` is not one.
struct Word { bytes: i32, arr: i32, x: i32, off: i32, big: boolean }

// One byte of a word: array `arr` read at `x + off`, shifted left `shift`.
struct WordByte { ok: boolean, arr: i32, x: i32, off: i32, shift: i32 }

function word_of(f: ssasem.Func, defs: ssa.SInst[], ins: ssa.SInst): Word {
  let none: Word = Word { bytes: 0, arr: 0, x: 0, off: 0, big: false };
  if (ins.kind_tag != 9 || ins.str != "|" || ins.result < 0) {
    return none;
  }
  let t: typeinfo.Type = f.values[ins.result];
  let n: i32 = 0;
  if (ssasem.is_u32(t)) {
    n = 4;
  } else if (ssasem.is_u64(t)) {
    n = 8;
  } else {
    return none;
  }
  let terms: i32[] = or_terms(defs, f.values, ins.result, t, []);
  if (terms.len() != n) {
    return none;
  }
  let parts: WordByte[] = [];
  for v in terms {
    let p: WordByte = word_byte(f, defs, v, t);
    if (!p.ok) {
      return none;
    }
    parts = parts.append(p);
  }
  let lo: i32 = parts[0].off;
  for p in parts {
    if (p.arr != parts[0].arr || p.x != parts[0].x) {
      return none;
    }
    if (p.off < lo) {
      lo = p.off;
    }
  }
  // Each byte sits at its own place, so n distinct places are the whole word.
  let seen: boolean[] = falses(n);
  let le: boolean = true;
  let be: boolean = true;
  for p in parts {
    let at: i32 = p.off - lo;
    if (at >= n || seen[at]) {
      return none;
    }
    le = le && p.shift == at * 8;
    be = be && p.shift == (n - 1 - at) * 8;
    seen = seen.with(at, true);
  }
  if (!le && !be) {
    return none;
  }
  return Word { bytes: n, arr: parts[0].arr, x: parts[0].x, off: lo, big: !le };
}

// or_terms flattens the `|` tree of type `t` rooted at `v` into its leaves.
function or_terms(defs: ssa.SInst[], values: typeinfo.Type[], v: i32, t: typeinfo.Type, acc: i32[]): i32[] {
  let d: ssa.SInst = defs[v];
  if (d.kind_tag == 9 && d.str == "|" && typeinfo.spelling(values[v]) == typeinfo.spelling(t) && acc.len() < 8) {
    return or_terms(defs, values, d.args[1], t, or_terms(defs, values, d.args[0], t, acc));
  }
  return acc.append(v);
}

// word_byte reads one leaf: `b[i] as T`, or that shifted left by a constant.
function word_byte(f: ssasem.Func, defs: ssa.SInst[], v: i32, t: typeinfo.Type): WordByte {
  let no: WordByte = WordByte { ok: false, arr: 0, x: 0, off: 0, shift: 0 };
  let d: ssa.SInst = defs[v];
  let shift: i32 = 0;
  if (d.kind_tag == 9 && d.str == "<<") {
    shift = const_through_cast(defs, d.args[1]);
    if (shift <= 0) {
      return no;
    }
    d = defs[d.args[0]];
  }
  if (d.kind_tag != ssasem.cast() || d.args.len() != 1 || typeinfo.spelling(f.values[d.result]) != typeinfo.spelling(t)) {
    return no;
  }
  let g: ssa.SInst = defs[d.args[0]];
  if (g.kind_tag != ssasem.array_get() || g.args.len() != 2 || !ssasem.is_u8(f.values[g.result])) {
    return no;
  }
  let x: i32 = g.args[1];
  let off: i32 = 0;
  let a: ssa.SInst = defs[x];
  // A constant index is an offset from no base, which `x` -1 stands for.
  if (a.kind_tag == 1) {
    return WordByte { ok: true, arr: g.args[0], x: 0 - 1, off: a.imm, shift: shift };
  }
  if (a.kind_tag == 9 && a.str == "+") {
    let c: ssa.SInst = defs[a.args[1]];
    if (c.kind_tag == 1) {
      x = a.args[0];
      off = c.imm;
    }
  }
  return WordByte { ok: true, arr: g.args[0], x: x, off: off, shift: shift };
}

// const_through_cast is an integer constant, read through one cast, or -1.
function const_through_cast(defs: ssa.SInst[], v: i32): i32 {
  let d: ssa.SInst = defs[v];
  if (d.kind_tag == ssasem.cast() && d.args.len() == 1) {
    d = defs[d.args[0]];
  }
  // A constant of an unsigned or wide type carries its value as its spelling.
  if (d.kind_tag == 1 && d.str.len() > 0) {
    let n: i64 = util.lit_to_i64(d.str);
    if (n > 0i64 && n < 64i64) {
      return n as i32;
    }
    return 0 - 1;
  }
  if (d.kind_tag == 1) {
    return d.imm;
  }
  return 0 - 1;
}
