import "./ssa";
import "./ssadeps";
import "./ssasem";
import "./typeinfo";
import "./util";

struct Rel { lo: i32, hi: i32, strict: boolean }

struct Graph { defs: ssa.SInst[], home: i32[], i32s: boolean[], i64s: boolean[], widens: i32[], rels: Rel[], first: i32[], count: i32[], up: i32[], above: i32[], preds: i32[][] }

pub function proven_indices(f: ssasem.Func): ssasem.Func {
  if (!any_checked_index(f)) {
    return f;
  }
  let g: Graph = graph_of(f);
  let blocks: ssa.SBlock[] = [];
  let changed: boolean = false;
  let b: i32 = 0;
  while (b < f.graph.blocks.len()) {
    let blk: ssa.SBlock = f.graph.blocks[b];
    let insts: ssa.SInst[] = [];
    let marked: boolean = false;
    for ins in blk.insts {
      let proof: i32 = proof_of(g, b, ins);
      if (proof == PROOF_UNCHECKED) {
        insts = insts.append(ssa.SInst { ...ins, imm: 1 });
      } else if (proof == PROOF_NONE) {
        insts = insts.append(ins);
      }
      marked = marked || proof != PROOF_NONE;
    }
    if (marked) {
      blk = ssa.SBlock { ...blk, insts: insts };
      changed = true;
    }
    blocks = blocks.append(blk);
    b = b + 1;
  }
  if (!changed) {
    return f;
  }
  return ssasem.Func { ...f, graph: ssa.SFunc { ...f.graph, blocks: blocks } };
}

const PROOF_NONE: i32 = 0;

const PROOF_UNCHECKED: i32 = 1;

const PROOF_DROPPED: i32 = 2;

// A checked access the facts prove becomes unchecked, and a proven group check goes.
function proof_of(g: Graph, b: i32, ins: ssa.SInst): i32 {
  if ((checked_index(ins) || checked_write(ins)) && g.i32s[ins.args[1]] && proven(g, b, ins.args[1], ins.args[0])) {
    return PROOF_UNCHECKED;
  }
  if (group_check(ins) && group_proven(g, b, ins.args[1], ins.args[0])) {
    return PROOF_DROPPED;
  }
  return PROOF_NONE;
}

function index_read(ins: ssa.SInst): boolean {
  return (ins.kind_tag == ssasem.array_get() || ins.kind_tag == ssasem.str_index()) && ins.args.len() == 2;
}

function checked_index(ins: ssa.SInst): boolean {
  return index_read(ins) && ins.imm == 0;
}

function checked_write(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssasem.with() && ins.args.len() == 3 && ins.imm == 0;
}

function any_checked_index(f: ssasem.Func): boolean {
  for blk in f.graph.blocks {
    for ins in blk.insts {
      if (checked_index(ins) || checked_write(ins) || group_check(ins)) {
        return true;
      }
    }
  }
  return false;
}

// The check grouped_reads places before a run of unchecked reads.
function group_check(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssasem.array_get() && ins.args.len() == 2 && ins.imm == ssasem.check_only();
}

// A group's index is a constant, or `(lo + span) | (lo >> 31)`: every read is in range when
// lo is not negative and lo + span is below the length.
function group_proven(g: Graph, b: i32, idx: i32, base: i32): boolean {
  if (is_const(g, idx)) {
    return const_value(g, idx) >= 0 && below(g, b, idx, base, [], depth());
  }
  let d: ssa.SInst = def_of(g, idx);
  if (!binary(d, "|") || !g.i32s[root(g, idx)]) {
    return false;
  }
  let top: i32 = d.args[0];
  let sign: ssa.SInst = def_of(g, d.args[1]);
  if (!binary(sign, ">>") || !is_const(g, sign.args[1]) || const_value(g, sign.args[1]) != 31) {
    return false;
  }
  return nonneg(g, b, sign.args[0], [], depth()) && below(g, b, top, base, [], depth()) && plus_of(g, top, sign.args[0]);
}

// Whether `top` is `lo + c` for a constant c, or lo itself.
function plus_of(g: Graph, top: i32, lo: i32): boolean {
  if (same(g, top, lo)) {
    return true;
  }
  let d: ssa.SInst = def_of(g, top);
  return binary(d, "+") && same(g, d.args[0], lo) && is_const(g, d.args[1]) && const_value(g, d.args[1]) >= 0;
}

function any_index_read(f: ssasem.Func): boolean {
  for blk in f.graph.blocks {
    for ins in blk.insts {
      if (index_read(ins)) {
        return true;
      }
    }
  }
  return false;
}

function proven(g: Graph, b: i32, idx: i32, base: i32): boolean {
  return nonneg(g, b, idx, [], depth()) && below(g, b, idx, base, [], depth());
}

function depth(): i32 {
  return 6;
}

function graph_of(f: ssasem.Func): Graph {
  let n: i32 = f.values.len();
  let none: ssa.SInst = ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  let defs: ssa.SInst[] = [];
  let home: i32[] = [];
  let i32s: boolean[] = [];
  let i64s: boolean[] = [];
  let v: i32 = 0;
  while (v < n) {
    defs = defs.append(none);
    home = home.append(0 - 1);
    i32s = i32s.append(ssasem.is_i32(f.values[v]));
    i64s = i64s.append(ssasem.is_i64(f.values[v]));
    v = v + 1;
  }
  let widens: i32[] = __alloc_i32(n);
  let nb: i32 = f.graph.blocks.len();
  let b: i32 = 0;
  while (b < nb) {
    for ins in f.graph.blocks[b].insts {
      if (ins.result >= 0 && ins.result < n) {
        defs = defs.with(ins.result, ins);
        home = home.with(ins.result, b);
        widens = widens.with(ins.result, widening(f, ins));
      }
    }
    b = b + 1;
  }
  let at: i32[] = ssadeps.position_of(f.graph);
  let g: Graph = Graph { defs: defs, home: home, i32s: i32s, i64s: i64s, widens: widens, rels: [], first: [], count: [], up: [], above: [], preds: pred_positions(f.graph, at) };
  b = 0;
  while (b < nb) {
    let blk: ssa.SBlock = f.graph.blocks[b];
    let before: i32 = g.rels.len();
    if (blk.preds.len() == 1) {
      let p: i32 = at[blk.preds[0]];
      if (p >= 0) {
        let term: ssa.STerm = f.graph.blocks[p].term;
        if (term.kind_tag == 3 && term.t != term.f) {
          g = learn(g, term.cond, term.t == blk.id, 2);
        }
      }
    }
    g = Graph { ...g, first: g.first.append(before), count: g.count.append(g.rels.len() - before) };
    b = b + 1;
  }
  return with_dominators(g, ssadeps.dominates(f.graph), nb);
}

function pred_positions(graph: ssa.SFunc, at: i32[]): i32[][] {
  let preds: i32[][] = [];
  for blk in graph.blocks {
    let ps: i32[] = [];
    for p in blk.preds {
      ps = ps.append(at[p]);
    }
    preds = preds.append(ps);
  }
  return preds;
}

function learn(g: Graph, cond: i32, truth: boolean, hops: i32): Graph {
  if (cond < 0 || cond >= g.defs.len() || hops <= 0) {
    return g;
  }
  let c: ssa.SInst = g.defs[cond];
  if (c.kind_tag == 10 && c.str == "!" && c.args.len() == 1) {
    return learn(g, c.args[0], !truth, hops - 1);
  }
  if (c.kind_tag != 9 || c.args.len() != 2) {
    return g;
  }
  let x: i32 = c.args[0];
  let y: i32 = c.args[1];
  if (!g.i32s[x] || !g.i32s[y]) {
    return g;
  }
  if (c.str == "<") {
    return fact(g, x, y, truth, true);
  }
  if (c.str == ">=") {
    return fact(g, x, y, !truth, true);
  }
  if (c.str == ">") {
    return fact(g, y, x, truth, true);
  }
  if (c.str == "<=") {
    return fact(g, y, x, !truth, true);
  }
  if (c.str == "==" && truth || c.str == "!=" && !truth) {
    return fact(fact(g, x, y, true, false), y, x, true, false);
  }
  return g;
}

function fact(g: Graph, lo: i32, hi: i32, held: boolean, strict: boolean): Graph {
  if (held) {
    return Graph { ...g, rels: g.rels.append(Rel { lo: lo, hi: hi, strict: strict }) };
  }
  return Graph { ...g, rels: g.rels.append(Rel { lo: hi, hi: lo, strict: !strict }) };
}

function with_dominators(g: Graph, d: ssadeps.Dom, nb: i32): Graph {
  let up: i32[] = [];
  let above: i32[] = [];
  let b: i32 = 0;
  while (b < nb) {
    up = up.append(0 - 1);
    above = above.append(0 - 1);
    b = b + 1;
  }
  let order: i32[] = [];
  while (order.len() < 2 * nb) {
    order = order.append(0 - 1);
  }
  b = 0;
  while (b < nb) {
    if (d.pre[b] >= 0 && d.pre[b] < 2 * nb) {
      order = order.with(d.pre[b], b);
    }
    b = b + 1;
  }
  let stack: i32[] = [];
  let sp: i32 = 0;
  for k in order {
    if (k < 0) {
      continue;
    }
    while (sp > 0 && !ssadeps.dom_holds(d, k, stack[sp - 1])) {
      sp = sp - 1;
    }
    let inherited: i32 = 0 - 1;
    if (sp > 0) {
      inherited = up[stack[sp - 1]];
    }
    above = above.with(k, inherited);
    if (g.count[k] > 0) {
      up = up.with(k, k);
    } else {
      up = up.with(k, inherited);
    }
    if (sp < stack.len()) {
      stack = stack.with(sp, k);
    } else {
      stack = stack.append(k);
    }
    sp = sp + 1;
  }
  return Graph { ...g, up: up, above: above };
}

function root(g: Graph, v: i32): i32 {
  let hops: i32 = 0;
  while (v >= 0 && v < g.defs.len() && g.defs[v].kind_tag == 7 && g.defs[v].args.len() == 1 && hops < 8) {
    v = g.defs[v].args[0];
    hops = hops + 1;
  }
  return v;
}

function same(g: Graph, a: i32, b: i32): boolean {
  return equal(g, a, b, 4);
}

function equal(g: Graph, a: i32, b: i32, steps: i32): boolean {
  a = root(g, a);
  b = root(g, b);
  if (a == b) {
    return true;
  }
  if (steps <= 0 || a < 0 || b < 0) {
    return false;
  }
  let da: ssa.SInst = g.defs[a];
  let db: ssa.SInst = g.defs[b];
  if (da.kind_tag != db.kind_tag || !projection(da.kind_tag) || da.imm != db.imm || da.str != db.str || da.args.len() != db.args.len()) {
    return false;
  }
  let k: i32 = 0;
  while (k < da.args.len()) {
    if (!equal(g, da.args[k], db.args[k], steps - 1)) {
      return false;
    }
    k = k + 1;
  }
  return da.args.len() > 0;
}

function projection(kind: i32): boolean {
  return kind == ssasem.record_get() || kind == ssasem.variant_get() || kind == ssasem.tuple_get() || kind == ssasem.length() || kind == ssasem.array_get();
}

function def_of(g: Graph, v: i32): ssa.SInst {
  return g.defs[root(g, v)];
}

function is_const(g: Graph, v: i32): boolean {
  let r: i32 = root(g, v);
  return g.defs[r].kind_tag == 1 && g.i32s[r];
}

function const_value(g: Graph, v: i32): i32 {
  return def_of(g, v).imm;
}

function is_length(g: Graph, v: i32): boolean {
  return def_of(g, v).kind_tag == ssasem.length();
}

function is_length_of(g: Graph, v: i32, base: i32): boolean {
  let d: ssa.SInst = def_of(g, v);
  if (d.kind_tag == ssasem.length() && d.args.len() == 1 && same(g, d.args[0], base)) {
    return true;
  }
  let n: i32 = built_len(g, base, [], 24);
  return n >= 0 && same(g, v, n);
}

function built_len(g: Graph, base: i32, assume: i32[], steps: i32): i32 {
  if (steps <= 0) {
    return 0 - 1;
  }
  base = root(g, base);
  if (base < 0 || base >= g.defs.len()) {
    return 0 - 1;
  }
  let d: ssa.SInst = g.defs[base];
  if (d.kind_tag == ssasem.call() && d.args.len() == 1 && sized_alloc(d.str)) {
    return d.args[0];
  }
  if (d.kind_tag == ssasem.with() && d.args.len() == 3) {
    return built_len(g, d.args[0], assume, steps - 1);
  }
  if (d.kind_tag != 8 || d.args.len() == 0) {
    return 0 - 1;
  }
  if (assumed(assume, base)) {
    return 0 - 2;
  }
  let inner: i32[] = assume.append(base);
  let n: i32 = 0 - 1;
  let back: boolean = false;
  for o in d.args {
    let m: i32 = built_len(g, o, inner, steps - 1);
    if (m == 0 - 2) {
      back = true;
    } else if (m < 0) {
      return 0 - 1;
    } else if (n < 0) {
      n = m;
    } else if (!same(g, n, m)) {
      return 0 - 1;
    }
  }
  if (n < 0 && back && assume.len() > 0) {
    return 0 - 2;
  }
  return n;
}

function sized_alloc(name: string): boolean {
  return name == "__alloc_u8" || name == "__alloc_i32" || name == "__alloc_i64" || name == "__alloc_bool";
}

function binary(d: ssa.SInst, op: string): boolean {
  return d.kind_tag == 9 && d.str == op && d.args.len() == 2;
}

function assumed(assume: i32[], v: i32): boolean {
  for a in assume {
    if (a == v) {
      return true;
    }
  }
  return false;
}

// The largest value of `y & K` for a constant K of any width that fits an
// i32, read through a cast to i32, or -1.
function masked(g: Graph, x: i32): i32 {
  let d: ssa.SInst = g.defs[x];
  if (d.kind_tag == ssasem.cast() && d.args.len() == 1 && g.i32s[x]) {
    return masked(g, root(g, d.args[0]));
  }
  if (!binary(d, "&")) {
    return 0 - 1;
  }
  let k: i32 = mask_const(g, d.args[1]);
  if (k < 0) {
    k = mask_const(g, d.args[0]);
  }
  return k;
}

function mask_const(g: Graph, v: i32): i32 {
  let d: ssa.SInst = def_of(g, v);
  if (d.kind_tag != 1) {
    let n: i64 = folded(g, v, 4);
    if (n == NOT_FOLDED || n < 0i64) {
      return 0 - 1;
    }
    return n as i32;
  }
  if (d.str.len() > 0) {
    let n: i64 = util.lit_to_i64(d.str);
    if (n >= 0i64 && n <= 2147483647i64) {
      return n as i32;
    }
    return 0 - 1;
  }
  if (d.imm >= 0) {
    return d.imm;
  }
  return 0 - 1;
}

function literal_len(g: Graph, base: i32): i32 {
  let d: ssa.SInst = def_of(g, base);
  if (d.kind_tag == ssasem.bytes_new()) {
    return d.imm;
  }
  if (d.kind_tag == ssasem.array_new()) {
    return d.args.len();
  }
  return 0 - 1;
}

function below(g: Graph, b: i32, x: i32, base: i32, assume: i32[], steps: i32): boolean {
  if (steps <= 0) {
    return false;
  }
  x = root(g, x);
  let d: ssa.SInst = g.defs[x];
  if (small_below(g, b, x, base)) {
    return true;
  }
  if (binary(d, "+") && plus_fits(g, b, d, base)) {
    return true;
  }
  if (binary(d, "-") && is_const(g, d.args[1])) {
    let c: i32 = const_value(g, d.args[1]);
    if (c >= 1 && is_length_of(g, d.args[0], base)) {
      return true;
    }
    let at: i32 = g.home[x];
    if (c >= 0 && below(g, at, d.args[0], base, assume, steps - 1) && nonneg(g, at, d.args[0], [], steps - 1)) {
      return true;
    }
  }
  if (d.kind_tag == 8 && g.i32s[x]) {
    if (assumed(assume, x)) {
      return true;
    }
    let inner: i32[] = assume.append(x);
    let all: boolean = d.args.len() > 0;
    for k in 0..d.args.len() {
      if (!below(g, edge_block(g, x, k, d.args[k]), d.args[k], base, inner, steps - 1)) {
        all = false;
        break;
      }
    }
    if (all) {
      return true;
    }
  }
  if (b < 0) {
    return false;
  }
  let c: i32 = g.up[b];
  while (c >= 0) {
    let k: i32 = g.first[c];
    while (k < g.first[c] + g.count[c]) {
      let r: Rel = g.rels[k];
      if (same(g, r.lo, x)) {
        if (r.strict && is_length_of(g, r.hi, base)) {
          return true;
        }
        if (below(g, b, r.hi, base, assume, steps - 1)) {
          return true;
        }
      }
      k = k + 1;
    }
    c = g.above[c];
  }
  return false;
}

function nonneg(g: Graph, b: i32, x: i32, assume: i32[], steps: i32): boolean {
  if (steps <= 0) {
    return false;
  }
  x = root(g, x);
  if (is_const(g, x)) {
    return const_value(g, x) >= 0;
  }
  if (is_length(g, x) || masked(g, x) >= 0) {
    return true;
  }
  let d: ssa.SInst = g.defs[x];
  if (d.kind_tag == ssasem.call() && nonneg_call(d.str) || g.widens[x] == 1) {
    return true;
  }
  let at: i32 = g.home[x];
  if (g.widens[x] == 2 && nonneg(g, at, d.args[0], assume, steps - 1)) {
    return true;
  }
  if (binary(d, "+")) {
    let y: i32 = 0 - 1;
    if (is_const(g, d.args[1]) && const_value(g, d.args[1]) == 1) {
      y = d.args[0];
    } else if (is_const(g, d.args[0]) && const_value(g, d.args[0]) == 1) {
      y = d.args[1];
    }
    if (y >= 0 && nonneg(g, at, y, assume, steps - 1) && below_a_length(g, at, y)) {
      return true;
    }
    if (plus_fits(g, b, d, 0 - 1) && nonneg(g, b, plus_base(g, d), assume, steps - 1)) {
      return true;
    }
  }
  if (binary(d, "-") && is_const(g, d.args[1]) && is_length(g, d.args[0])) {
    if (at_least(g, at, d.args[0], const_value(g, d.args[1]))) {
      return true;
    }
  }
  if (d.kind_tag == 8 && g.i32s[x]) {
    if (assumed(assume, x)) {
      return true;
    }
    let inner: i32[] = assume.append(x);
    let all: boolean = d.args.len() > 0;
    for k in 0..d.args.len() {
      if (!nonneg(g, edge_block(g, x, k, d.args[k]), d.args[k], inner, steps - 1)) {
        all = false;
        break;
      }
    }
    if (all) {
      return true;
    }
  }
  if (b < 0) {
    return false;
  }
  let c: i32 = g.up[b];
  while (c >= 0) {
    let k: i32 = g.first[c];
    while (k < g.first[c] + g.count[c]) {
      let r: Rel = g.rels[k];
      if (same(g, r.hi, x)) {
        if (is_const(g, r.lo)) {
          let low: i32 = const_value(g, r.lo);
          if (low >= 0 || r.strict && low == 0 - 1) {
            return true;
          }
        } else if (nonneg(g, b, r.lo, assume, steps - 1)) {
          return true;
        }
      }
      k = k + 1;
    }
    c = g.above[c];
  }
  return false;
}

function nonneg_call(name: string): boolean {
  return name == "__scan_set" || name == "__scan_set_bytes" || name == "__clz32" || name == "__ctz32" || name == "__popcount32"
    || name == "__clz64" || name == "__ctz64" || name == "__popcount64";
}

// The block whose dominating facts hold for a phi's operand `k`: its predecessor on that edge.
function edge_block(g: Graph, phi: i32, k: i32, operand: i32): i32 {
  let ps: i32[] = g.preds[g.home[phi]];
  if (k < ps.len() && ps[k] >= 0) {
    return ps[k];
  }
  return g.home[root(g, operand)];
}

// The largest value of a constant or a mask, or -1.
function small_max(g: Graph, v: i32): i32 {
  v = root(g, v);
  if (is_const(g, v)) {
    return if (const_value(g, v) >= 0) { const_value(g, v) } else { 0 - 1 };
  }
  return masked(g, v);
}

// The operand of `a + k` that is not the small one, or -1.
function plus_base(g: Graph, d: ssa.SInst): i32 {
  if (small_max(g, d.args[1]) >= 0) {
    return d.args[0];
  }
  if (small_max(g, d.args[0]) >= 0) {
    return d.args[1];
  }
  return 0 - 1;
}

// `a + k`, with k a small constant or mask, is below a length (of `base`, or
// any when `base` is -1) when a dominating fact bounds `a` by that length
// minus more than k. The same fact keeps the sum from overflowing.
function plus_fits(g: Graph, b: i32, d: ssa.SInst, base: i32): boolean {
  let a: i32 = plus_base(g, d);
  if (a < 0 || b < 0) {
    return false;
  }
  let k: i32 = small_max(g, d.args[1]);
  if (a == d.args[1]) {
    k = small_max(g, d.args[0]);
  }
  let c: i32 = g.up[b];
  while (c >= 0) {
    for i in g.first[c]..g.first[c] + g.count[c] {
      let r: Rel = g.rels[i];
      if (same(g, r.lo, a) && length_minus(g, r.hi, base) - (if (r.strict) { 0 } else { 1 }) >= k) {
        return true;
      }
    }
    c = g.above[c];
  }
  return false;
}

// n for a value `len - n` of a length (of `base`, or any when `base` is -1), or -1.
function length_minus(g: Graph, v: i32, base: i32): i32 {
  let d: ssa.SInst = def_of(g, v);
  if (!binary(d, "-") || !is_const(g, d.args[1]) || const_value(g, d.args[1]) < 0) {
    return 0 - 1;
  }
  if (base < 0 && is_length(g, d.args[0]) || base >= 0 && is_length_of(g, d.args[0], base)) {
    return const_value(g, d.args[1]);
  }
  return 0 - 1;
}

function below_a_length(g: Graph, b: i32, y: i32): boolean {
  if (b < 0) {
    return false;
  }
  y = root(g, y);
  let c: i32 = g.up[b];
  while (c >= 0) {
    let k: i32 = g.first[c];
    while (k < g.first[c] + g.count[c]) {
      let r: Rel = g.rels[k];
      if (r.strict && same(g, r.lo, y)) {
        return true;
      }
      k = k + 1;
    }
    c = g.above[c];
  }
  return false;
}

const NOT_FOLDED: i64 = 0i64 - 9223372036854775807i64;

// The value of an i32 constant, or of a shift, sum, difference, product or
// mask of them, while it stays within 32 bits.
function folded(g: Graph, v: i32, steps: i32): i64 {
  v = root(g, v);
  if (is_const(g, v)) {
    return const_value(g, v) as i64;
  }
  let d: ssa.SInst = g.defs[v];
  if (steps <= 0 || d.kind_tag != 9 || d.args.len() != 2 || !g.i32s[v]) {
    return NOT_FOLDED;
  }
  let a: i64 = folded(g, d.args[0], steps - 1);
  let b: i64 = folded(g, d.args[1], steps - 1);
  if (a == NOT_FOLDED || b == NOT_FOLDED) {
    return NOT_FOLDED;
  }
  let out: i64 = fold_op(d.str, a, b);
  if (out < -2147483648i64 || out > 2147483647i64) {
    return NOT_FOLDED;
  }
  return out;
}

function fold_op(op: string, a: i64, b: i64): i64 {
  if (op == "<<" && b >= 0i64 && b < 31i64) {
    return a << b;
  }
  if (op == "+") {
    return a + b;
  }
  if (op == "-") {
    return a - b;
  }
  if (op == "*") {
    return a * b;
  }
  if (op == "&") {
    return a & b;
  }
  if (op == "|") {
    return a | b;
  }
  return NOT_FOLDED;
}

// A constant or a mask below a literal's length or a length a fact bounds.
function small_below(g: Graph, b: i32, x: i32, base: i32): boolean {
  let m: i32 = small_max(g, x);
  return m >= 0 && (m < literal_len(g, base) || length_at_least(g, b, base, m + 1));
}

// Whether a dominating fact holds `base.len() >= n`.
function length_at_least(g: Graph, b: i32, base: i32, n: i32): boolean {
  if (b < 0) {
    return false;
  }
  let c: i32 = g.up[b];
  while (c >= 0) {
    for k in g.first[c]..g.first[c] + g.count[c] {
      let r: Rel = g.rels[k];
      let low: i64 = folded(g, r.lo, 4);
      if (low != NOT_FOLDED && is_length_of(g, r.hi, base)) {
        if (low >= n as i64 || r.strict && low >= (n - 1) as i64) {
          return true;
        }
      }
    }
    c = g.above[c];
  }
  return false;
}

function at_least(g: Graph, b: i32, y: i32, n: i32): boolean {
  if (n <= 0 && is_length(g, y)) {
    return true;
  }
  if (b < 0) {
    return false;
  }
  y = root(g, y);
  let c: i32 = g.up[b];
  while (c >= 0) {
    let k: i32 = g.first[c];
    while (k < g.first[c] + g.count[c]) {
      let r: Rel = g.rels[k];
      if (same(g, r.hi, y) && is_const(g, r.lo)) {
        let low: i32 = const_value(g, r.lo);
        if (low >= n || r.strict && low >= n - 1) {
          return true;
        }
      }
      k = k + 1;
    }
    c = g.above[c];
  }
  return false;
}

pub function nonneg_quotients(f: ssasem.Func): ssasem.Func {
  if (!any_pow2_quotient(f)) {
    return f;
  }
  let g: Graph = graph_of(f);
  let values: typeinfo.Type[] = f.values;
  let blocks: ssa.SBlock[] = [];
  let changed: boolean = false;
  let b: i32 = 0;
  while (b < f.graph.blocks.len()) {
    let blk: ssa.SBlock = f.graph.blocks[b];
    let insts: ssa.SInst[] = [];
    let marked: boolean = false;
    for ins in blk.insts {
      let k: i32 = pow2_divisor(g, ins);
      if (k > 0 && (g.i32s[ins.result] || g.i64s[ins.result]) && nonneg(g, b, ins.args[0], [], depth())) {
        let c: i32 = values.len();
        values = values.append(f.values[ins.result]);
        let op: string = "&";
        let operand: i32 = (1 << k) - 1;
        if (ins.str == "/") {
          op = ">>";
          operand = k;
        }
        insts = insts.append(int_const(f.values[ins.result], c, operand));
        insts = insts.append(ssa.SInst { ...ins, args: [ins.args[0], c], str: op });
        marked = true;
      } else {
        insts = insts.append(ins);
      }
    }
    if (marked) {
      blk = ssa.SBlock { ...blk, insts: insts };
      changed = true;
    }
    blocks = blocks.append(blk);
    b = b + 1;
  }
  if (!changed) {
    return f;
  }
  return ssasem.Func { ...f, values: values, graph: ssa.SFunc { ...f.graph, blocks: blocks, nvals: values.len() } };
}

function any_pow2_quotient(f: ssasem.Func): boolean {
  for blk in f.graph.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 9 && (ins.str == "/" || ins.str == "%") && ins.args.len() == 2) {
        return true;
      }
    }
  }
  return false;
}

function small_const(g: Graph, v: i32): i32 {
  let r: i32 = root(g, v);
  let d: ssa.SInst = g.defs[r];
  if (g.widens[r] != 0) {
    return small_const(g, d.args[0]);
  }
  if (is_const(g, r) && const_value(g, r) >= 0) {
    return const_value(g, r);
  }
  if (d.kind_tag == 1 && g.i64s[r] && d.str.len() > 0 && d.str.len() < 10 && util.is_all_digits(d.str)) {
    return util.digits_to_i32(d.str);
  }
  return 0 - 1;
}

function int_const(t: typeinfo.Type, result: i32, n: i32): ssa.SInst {
  if (ssasem.text_constant(t)) {
    return ssa.SInst { kind_tag: 1, result: result, args: [], imm: 0, str: util.i32_to_string(n) };
  }
  return ssa.SInst { kind_tag: 1, result: result, args: [], imm: n, str: "" };
}

function widening(f: ssasem.Func, ins: ssa.SInst): i32 {
  if (ins.kind_tag != ssasem.cast() || ins.args.len() != 1) {
    return 0;
  }
  if let typeinfo.TypeI32(from) = f.values[ins.args[0]] {
    if let typeinfo.TypeI32(to) = f.values[ins.result] {
      if (from.is_char || to.is_char || to.unsigned || from.width >= to.width) {
        return 0;
      }
      if (from.unsigned) {
        return 1;
      }
      return 2;
    }
  }
  return 0;
}

function pow2_divisor(g: Graph, ins: ssa.SInst): i32 {
  if (!binary(ins, "/") && !binary(ins, "%")) {
    return 0;
  }
  let d: i32 = small_const(g, ins.args[1]);
  if (d < 2 || (d & d - 1) != 0) {
    return 0;
  }
  let k: i32 = 0;
  while (d > 1) {
    d = d >> 1;
    k = k + 1;
  }
  return k;
}

pub function grouped_reads(f: ssasem.Func): ssasem.Func {
  if (!any_checked_index(f)) {
    return f;
  }
  let defs: ssa.SInst[] = definitions(f);
  let values: typeinfo.Type[] = f.values;
  let blocks: ssa.SBlock[] = [];
  let changed: boolean = false;
  for blk in f.graph.blocks {
    let plan: Probes = probes_of(f, defs, blk.insts);
    if (!plan.any) {
      blocks = blocks.append(blk);
      continue;
    }
    let insts: ssa.SInst[] = [];
    let p: i32 = 0;
    let pos: i32 = 0;
    while (pos < blk.insts.len()) {
      let ins: ssa.SInst = blk.insts[pos];
      if (p < plan.at.len() && plan.at[p] == pos) {
        let t: typeinfo.Type = f.values[ins.args[1]];
        let v: i32 = values.len();
        let idx: i32 = v;
        if (plan.x[p] < 0) {
          let c: i32 = plan.lo[p] + plan.span[p];
          if (plan.lo[p] < 0) {
            c = 0 - 1;
          }
          insts = insts.append(ssa.SInst { kind_tag: 1, result: v, args: [], imm: c, str: "" });
          values = values.append(t);
        } else {
          let lo: i32 = plan.x[p];
          if (plan.lo[p] != 0) {
            insts = insts.append(ssa.SInst { kind_tag: 1, result: v, args: [], imm: plan.lo[p], str: "" });
            insts = insts.append(ssa.SInst { kind_tag: 9, result: v + 1, args: [lo, v], imm: 0, str: "+" });
            values = values.append(t).append(t);
            lo = v + 1;
            v = v + 2;
          }
          insts = insts.append(ssa.SInst { kind_tag: 1, result: v, args: [], imm: plan.span[p], str: "" });
          insts = insts.append(ssa.SInst { kind_tag: 9, result: v + 1, args: [lo, v], imm: 0, str: "+" });
          insts = insts.append(ssa.SInst { kind_tag: 1, result: v + 2, args: [], imm: 31, str: "" });
          insts = insts.append(ssa.SInst { kind_tag: 9, result: v + 3, args: [lo, v + 2], imm: 0, str: ">>" });
          insts = insts.append(ssa.SInst { kind_tag: 9, result: v + 4, args: [v + 1, v + 3], imm: 0, str: "|" });
          values = values.append(t).append(t).append(t).append(t).append(t);
          idx = v + 4;
        }
        insts = insts.append(ssa.SInst { ...ins, result: values.len(), args: [ins.args[0], idx], imm: ssasem.check_only() });
        values = values.append(f.values[ins.result]);
        p = p + 1;
      }
      if (plan.unchecked[pos]) {
        ins = ssa.SInst { ...ins, imm: 1 };
      }
      insts = insts.append(ins);
      pos = pos + 1;
    }
    blocks = blocks.append(ssa.SBlock { ...blk, insts: insts });
    changed = true;
  }
  if (!changed) {
    return f;
  }
  return ssasem.Func { ...f, values: values, graph: ssa.SFunc { ...f.graph, blocks: blocks, nvals: values.len() } };
}

struct Probes { at: i32[], x: i32[], lo: i32[], span: i32[], unchecked: boolean[], any: boolean }

function definitions(f: ssasem.Func): ssa.SInst[] {
  let none: ssa.SInst = ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  let defs: ssa.SInst[] = [];
  let v: i32 = 0;
  while (v < f.values.len()) {
    defs = defs.append(none);
    v = v + 1;
  }
  for blk in f.graph.blocks {
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < defs.len()) {
        defs = defs.with(ins.result, ins);
      }
    }
  }
  return defs;
}

function probes_of(f: ssasem.Func, defs: ssa.SInst[], insts: ssa.SInst[]): Probes {
  let out: Probes = Probes { at: [], x: [], lo: [], span: [], unchecked: __alloc_bool(insts.len()), any: false };
  let start: i32 = 0;
  let pos: i32 = 0;
  while (pos <= insts.len()) {
    if (pos == insts.len() || !silent(f, insts[pos])) {
      out = probes_in_run(f, defs, insts, start, pos, out);
      start = pos + 1;
    }
    pos = pos + 1;
  }
  return out;
}

function probes_in_run(f: ssasem.Func, defs: ssa.SInst[], insts: ssa.SInst[], start: i32, end: i32, own out: Probes): Probes {
  let reads: i32[] = [];
  let k: i32 = start;
  while (k < end) {
    let ins: ssa.SInst = insts[k];
    if (checked_index(ins) && ssasem.is_i32(f.values[ins.args[1]]) && scalar(f, ins.result)) {
      reads = reads.append(k);
    }
    k = k + 1;
  }
  let done: boolean[] = __alloc_bool(reads.len());
  let i: i32 = 0;
  while (i < reads.len()) {
    if (done[i]) {
      i = i + 1;
      continue;
    }
    let first: ssa.SInst = insts[reads[i]];
    let x: i32 = offset_base(f, defs, first.args[1]);
    let low: i32 = offset_of(f, defs, first.args[1]);
    let high: i32 = low;
    let members: i32[] = [reads[i]];
    let j: i32 = i + 1;
    while (j < reads.len()) {
      let r: ssa.SInst = insts[reads[j]];
      if (!done[j] && r.args[0] == first.args[0] && offset_base(f, defs, r.args[1]) == x) {
        done = done.with(j, true);
        let c: i32 = offset_of(f, defs, r.args[1]);
        if (c < low) {
          low = c;
        }
        if (c > high) {
          high = c;
        }
        members = members.append(reads[j]);
      }
      j = j + 1;
    }
    if (members.len() >= 2) {
      let m: i32 = 1;
      if (high > low) {
        out = Probes { ...out, at: out.at.append(reads[i]), x: out.x.append(x), lo: out.lo.append(low), span: out.span.append(high - low) };
        m = 0;
      }
      while (m < members.len()) {
        out = Probes { ...out, unchecked: out.unchecked.with(members[m], true), any: true };
        m = m + 1;
      }
    }
    i = i + 1;
  }
  return out;
}

function offset_base(f: ssasem.Func, defs: ssa.SInst[], v: i32): i32 {
  if (constant_index(f, defs, v)) {
    return 0 - 1;
  }
  let c: i32 = constant_operand(f, defs, v);
  if (c < 0) {
    return v;
  }
  return defs[v].args[1 - c];
}

function offset_of(f: ssasem.Func, defs: ssa.SInst[], v: i32): i32 {
  if (constant_index(f, defs, v)) {
    return defs[v].imm;
  }
  let c: i32 = constant_operand(f, defs, v);
  if (c < 0) {
    return 0;
  }
  return defs[defs[v].args[c]].imm;
}

function constant_index(f: ssasem.Func, defs: ssa.SInst[], v: i32): boolean {
  return defs[v].kind_tag == 1 && ssasem.is_i32(f.values[v]);
}

function constant_operand(f: ssasem.Func, defs: ssa.SInst[], v: i32): i32 {
  let d: ssa.SInst = defs[v];
  if (d.kind_tag != 9 || d.str != "+" || d.args.len() != 2 || !ssasem.is_i32(f.values[v])) {
    return 0 - 1;
  }
  let k: i32 = 0;
  while (k < 2) {
    let a: ssa.SInst = defs[d.args[k]];
    if (a.kind_tag == 1 && ssasem.is_i32(f.values[d.args[k]])) {
      return k;
    }
    k = k + 1;
  }
  return 0 - 1;
}

function scalar(f: ssasem.Func, v: i32): boolean {
  return ssasem.is_integer(f.values[v]) || ssasem.is_bool(f.values[v]);
}

function silent(f: ssasem.Func, ins: ssa.SInst): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 1 || k == 2 || k == 3 || k == 7 || k == 8 || k == 35 || k == ssasem.param()) {
    return true;
  }
  if (k == ssasem.array_get() || k == ssasem.str_index() || k == ssasem.length()) {
    return true;
  }
  if (ins.result < 0 || ins.result >= f.values.len()) {
    return false;
  }
  let t: typeinfo.Type = f.values[ins.result];
  if (k == 9) {
    return ins.str != "/" && ins.str != "%" && scalar(f, ins.result);
  }
  if (k == 10) {
    return scalar(f, ins.result);
  }
  if (k == ssasem.cast()) {
    return ins.args.len() == 1 && ssasem.is_integer(t) && ssasem.is_integer(f.values[ins.args[0]]);
  }
  return false;
}

pub function word_loads(f: ssasem.Func, contracts: ssasem.Contract[], view_words: string[], swaps: string[]): ssasem.Func {
  if (!any_index_read(f)) {
    return f;
  }
  let defs: ssa.SInst[] = definitions(f);
  let values: typeinfo.Type[] = f.values;
  let blocks: ssa.SBlock[] = [];
  let changed: boolean = false;
  let parts: i32[] = [];
  for blk in f.graph.blocks {
    let insts: ssa.SInst[] = [];
    let fused: boolean = false;
    for ins in blk.insts {
      let w: Word = word_of(f, defs, ins);
      if (w.bytes == 0) {
        insts = insts.append(ins);
        continue;
      }
      parts = word_parts(defs, ins.args, w, parts);
      let v: i32 = values.len();
      let i32_t: typeinfo.Type = typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: false };
      insts = insts.append(ssa.SInst { kind_tag: 1, result: v, args: [], imm: w.off, str: "" });
      if (w.x < 0) {
        insts = insts.append(ssa.SInst { kind_tag: 1, result: v + 1, args: [], imm: w.off, str: "" });
      } else {
        insts = insts.append(ssa.SInst { kind_tag: 9, result: v + 1, args: [w.x, v], imm: 0, str: "+" });
      }
      values = values.append(i32_t).append(i32_t);
      fused = true;
      let l: Load = load_word(Load { insts: insts, values: values }, f.values[w.arr], w, v + 1, ins.result, view_words, swaps);
      insts = l.insts;
      values = l.values;
    }
    if (fused) {
      blk = ssa.SBlock { ...blk, insts: insts };
      changed = true;
    }
    blocks = blocks.append(blk);
  }
  if (!changed) {
    return f;
  }
  blocks = without_unused(blocks, parts, values.len());
  let calls: ssasem.Contract[] = f.calls;
  for c in contracts {
    if (!has_contract(calls, c.name)) {
      calls = calls.append(c);
    }
  }
  return ssasem.Func { ...f, values: values, calls: calls, graph: ssa.SFunc { ...f.graph, blocks: blocks, nvals: values.len() } };
}

struct Load { insts: ssa.SInst[], values: typeinfo.Type[] }

function load_word(own l: Load, t: typeinfo.Type, w: Word, first: i32, result: i32, view_words: string[], swaps: string[]): Load {
  let wide: typeinfo.Type = typeinfo.TypeI32 { width: w.bytes * 8, unsigned: false, is_char: false, polymorphic: false };
  let addr_t: typeinfo.Type = typeinfo.TypeI32 { width: typeinfo.width_ptr(), unsigned: true, is_char: false, polymorphic: false };
  let insts: ssa.SInst[] = l.insts;
  let values: typeinfo.Type[] = l.values;
  let v: i32 = values.len();
  let word: i32 = v;
  if (is_byte_view(t)) {
    insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: v, args: [w.arr, first], imm: 0, str: view_words[w.bytes / 8] });
  } else {
    let base: i32 = v;
    if (ssasem.is_text(t)) {
      let d: Load = text_data(Load { insts: insts, values: values }, t, w.arr, addr_t);
      insts = d.insts;
      values = d.values;
      base = values.len() - 1;
    } else {
      insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: v, args: [w.arr], imm: 0, str: "__raw_arr_ptr" });
      insts = insts.append(ssa.SInst { kind_tag: 1, result: v + 1, args: [], imm: 8, str: "" });
      insts = insts.append(ssa.SInst { kind_tag: 9, result: v + 2, args: [v, v + 1], imm: 0, str: "+" });
      values = values.append(addr_t).append(addr_t).append(addr_t);
      base = v + 2;
    }
    let at: i32 = values.len();
    insts = insts.append(ssa.SInst { kind_tag: ssasem.cast(), result: at, args: [first], imm: 0, str: "" });
    insts = insts.append(ssa.SInst { kind_tag: 9, result: at + 1, args: [base, at], imm: 0, str: "+" });
    insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: at + 2, args: [at + 1], imm: 0, str: ["__load_i32", "__load_i64"][w.bytes / 8] });
    values = values.append(addr_t).append(addr_t);
    word = at + 2;
  }
  values = values.append(wide);
  insts = in_order(insts, w, swaps, word, result);
  if (w.big) {
    values = values.append(wide);
  }
  return Load { insts: insts, values: values };
}

function text_data(own l: Load, t: typeinfo.Type, arr: i32, addr_t: typeinfo.Type): Load {
  let insts: ssa.SInst[] = l.insts;
  let values: typeinfo.Type[] = l.values;
  let s: i32 = arr;
  if (ssasem.is_view(t)) {
    s = values.len();
    insts = insts.append(ssa.SInst { kind_tag: ssasem.str_as(), result: s, args: [arr], imm: 0, str: "" });
    values = values.append(typeinfo.TypeString { tag: 0 });
  }
  insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: values.len(), args: [s], imm: 0, str: "__raw_data" });
  return Load { insts: insts, values: values.append(addr_t) };
}

function in_order(own insts: ssa.SInst[], w: Word, swaps: string[], loaded: i32, result: i32): ssa.SInst[] {
  let v: i32 = loaded;
  if (w.big) {
    let name: string = swaps[0];
    if (w.bytes == 8) {
      name = swaps[1];
    }
    v = loaded + 1;
    insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: v, args: [loaded], imm: 0, str: name });
  }
  return insts.append(ssa.SInst { kind_tag: ssasem.cast(), result: result, args: [v], imm: 0, str: "" });
}

function word_parts(defs: ssa.SInst[], args: i32[], w: Word, acc: i32[]): i32[] {
  for v in args {
    if (v == w.arr || v == w.x || v < 0 || v >= defs.len() || has_value(acc, v)) {
      continue;
    }
    let d: ssa.SInst = defs[v];
    let part: boolean = d.kind_tag == 1 || d.kind_tag == ssasem.cast() || d.kind_tag == 9 && (d.str == "|" || d.str == "<<" || d.str == "+")
      || d.kind_tag == ssasem.array_get() && d.imm == 1;
    if (part) {
      acc = word_parts(defs, d.args, w, acc.append(v));
    }
  }
  return acc;
}

function has_value(xs: i32[], v: i32): boolean {
  for x in xs {
    if (x == v) {
      return true;
    }
  }
  return false;
}

function without_unused(blocks: ssa.SBlock[], parts: i32[], n: i32): ssa.SBlock[] {
  let part: boolean[] = falses(n);
  for v in parts {
    part = part.with(v, true);
  }
  let dropped: boolean = true;
  while (dropped) {
    dropped = false;
    let used: boolean[] = falses(n);
    for blk in blocks {
      for ins in blk.insts {
        for a in ins.args {
          if (a >= 0 && a < n) {
            used = used.with(a, true);
          }
        }
      }
      for a in [blk.term.cond, blk.term.value] {
        if (a >= 0 && a < n) {
          used = used.with(a, true);
        }
      }
    }
    let out: ssa.SBlock[] = [];
    for blk in blocks {
      let insts: ssa.SInst[] = [];
      for ins in blk.insts {
        if (ins.result >= 0 && ins.result < n && part[ins.result] && !used[ins.result]) {
          dropped = true;
        } else {
          insts = insts.append(ins);
        }
      }
      out = out.append(ssa.SBlock { ...blk, insts: insts });
    }
    blocks = out;
  }
  return blocks;
}

function falses(n: i32): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(false);
    i = i + 1;
  }
  return out;
}

function is_byte_view(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return a.view && ssasem.is_u8(a.elem);
  }
  return false;
}

function has_contract(calls: ssasem.Contract[], name: string): boolean {
  for c in calls {
    if (c.name == name) {
      return true;
    }
  }
  return false;
}

struct Word { bytes: i32, arr: i32, x: i32, off: i32, big: boolean }

struct WordByte { ok: boolean, arr: i32, x: i32, off: i32, shift: i32 }

function word_of(f: ssasem.Func, defs: ssa.SInst[], ins: ssa.SInst): Word {
  let none: Word = Word { bytes: 0, arr: 0, x: 0, off: 0, big: false };
  if (ins.kind_tag != 9 || ins.str != "|" || ins.result < 0) {
    return none;
  }
  let t: typeinfo.Type = f.values[ins.result];
  let n: i32 = word_width(t);
  if (n == 0) {
    return none;
  }
  let terms: i32[] = or_terms(defs, f.values, ins.result, t, []);
  if (terms.len() != n) {
    return none;
  }
  let parts: WordByte[] = [];
  for v in terms {
    let p: WordByte = word_byte(f, defs, v, t);
    if (!p.ok) {
      return none;
    }
    parts = parts.append(p);
  }
  let lo: i32 = parts[0].off;
  for p in parts {
    if (p.arr != parts[0].arr || p.x != parts[0].x) {
      return none;
    }
    if (p.off < lo) {
      lo = p.off;
    }
  }
  let seen: boolean[] = falses(n);
  let le: boolean = true;
  let be: boolean = true;
  for p in parts {
    let at: i32 = p.off - lo;
    if (at >= n || seen[at]) {
      return none;
    }
    le = le && p.shift == at * 8;
    be = be && p.shift == (n - 1 - at) * 8;
    seen = seen.with(at, true);
  }
  if (!le && !be) {
    return none;
  }
  return Word { bytes: n, arr: parts[0].arr, x: parts[0].x, off: lo, big: !le };
}

// The bytes in a word an OR of byte reads can build, or 0.
function word_width(t: typeinfo.Type): i32 {
  if (ssasem.is_u32(t) || ssasem.is_i32(t)) {
    return 4;
  }
  if (ssasem.is_wide(t)) {
    return 8;
  }
  return 0;
}

function or_terms(defs: ssa.SInst[], values: typeinfo.Type[], v: i32, t: typeinfo.Type, acc: i32[]): i32[] {
  let d: ssa.SInst = defs[v];
  if (d.kind_tag == 9 && d.str == "|" && typeinfo.spelling(values[v]) == typeinfo.spelling(t) && acc.len() < 8) {
    return or_terms(defs, values, d.args[1], t, or_terms(defs, values, d.args[0], t, acc));
  }
  return acc.append(v);
}

function word_byte(f: ssasem.Func, defs: ssa.SInst[], v: i32, t: typeinfo.Type): WordByte {
  let no: WordByte = WordByte { ok: false, arr: 0, x: 0, off: 0, shift: 0 };
  let d: ssa.SInst = defs[v];
  let shift: i32 = 0;
  if (d.kind_tag == 9 && d.str == "<<") {
    shift = const_through_cast(defs, d.args[1]);
    if (shift <= 0) {
      return no;
    }
    d = defs[d.args[0]];
  }
  if (d.kind_tag != ssasem.cast() || d.args.len() != 1 || typeinfo.spelling(f.values[d.result]) != typeinfo.spelling(t)) {
    return no;
  }
  let g: ssa.SInst = defs[d.args[0]];
  if (!index_read(g) || !ssasem.is_u8(f.values[g.result])) {
    return no;
  }
  let x: i32 = g.args[1];
  let off: i32 = 0;
  let a: ssa.SInst = defs[x];
  if (a.kind_tag == 1) {
    return WordByte { ok: true, arr: g.args[0], x: 0 - 1, off: a.imm, shift: shift };
  }
  if (a.kind_tag == 9 && a.str == "+") {
    let c: ssa.SInst = defs[a.args[1]];
    if (c.kind_tag == 1) {
      x = a.args[0];
      off = c.imm;
    }
  }
  return WordByte { ok: true, arr: g.args[0], x: x, off: off, shift: shift };
}

function const_through_cast(defs: ssa.SInst[], v: i32): i32 {
  let d: ssa.SInst = defs[v];
  if (d.kind_tag == ssasem.cast() && d.args.len() == 1) {
    d = defs[d.args[0]];
  }
  if (d.kind_tag == 1 && d.str.len() > 0) {
    let n: i64 = util.lit_to_i64(d.str);
    if (n > 0i64 && n < 64i64) {
      return n as i32;
    }
    return 0 - 1;
  }
  if (d.kind_tag == 1) {
    return d.imm;
  }
  return 0 - 1;
}
