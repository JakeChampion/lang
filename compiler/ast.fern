    },
    ExprUnknown(uk) => {
      return uk.col;
    },
    ExprZero(z) => {
      return z.col;
    }
  }
}

// The pattern of a destructuring binding. A plain binding has no binds. A
// record pattern names the field of each bind in `fields`.
pub struct Destr { binds: DestrBind[], fields: string[], record: string, at: string, rest_written: boolean, struct_match: boolean, prelude: boolean }

// One bind of a pattern: a name, or a nested tuple pattern in `nested`.
pub struct DestrBind { name: string, nested: Destr[] }

pub function no_destr(): Destr {
  return Destr { binds: [], fields: [], record: "", at: "", rest_written: false, struct_match: false, prelude: false };
}

// A tuple pattern of plain names.
pub function tuple_destr(names: string[]): Destr {
  let binds: DestrBind[] = [];
  for n in names {
    binds = binds.append(DestrBind { name: n, nested: [] });
  }
  return Destr { ...no_destr(), binds: binds };
}

// The plain names that a pattern binds, nested ones included, in order.
pub function destr_names(d: Destr): string[] {
  let out: string[] = [];
  for b in d.binds {
    if (b.nested.len() > 0) {
      for n in destr_names(b.nested[0]) {
        out = out.append(n);
      }
    } else {
      out = out.append(b.name);
    }
  }
  return out;
}

pub struct StmtVar { name: string, type_name: string, init: Expr, line: i32, col: i32, fn_ret: string, fn_param_types: string, destr: Destr }

pub function destructures(v: StmtVar): boolean {
  return v.destr.binds.len() > 0;
}

// A record pattern names a field for each bind. A tuple pattern names none.
pub function record_destr(d: Destr): boolean {
  return d.fields.len() > 0;
}

// acc with each name that `v` binds, the names of its pattern included. A
// `_` binds nothing.
pub function append_var_names(own acc: string[], v: StmtVar): string[] {
  if (destructures(v)) {
    return append_destr_names(acc, v.destr);
  }
  return append_bound(acc, v.name);
}

// acc with each name that the loop variable of `f` binds.
pub function append_for_names(own acc: string[], f: StmtFor): string[] {
  if (f.destr.binds.len() > 0) {
    return append_destr_names(acc, f.destr);
  }
  return append_bound(acc, f.var_name);
}

function append_destr_names(own acc: string[], d: Destr): string[] {
  for b in d.binds {
    if (b.nested.len() > 0) {
      acc = append_destr_names(acc, b.nested[0]);
    } else {
      acc = append_bound(acc, b.name);
    }
  }
  return acc;
}

function append_bound(own acc: string[], name: string): string[] {
  if (name.len() > 0 && name != "_") {
    return acc.append(name);
  }
  return acc;
}

// The names of d as the source spells them, `a,(b,c)`, for a message.
pub function destr_text(d: Destr): string {
  let out = "";
  for i in 0..d.binds.len() {
    if (i > 0) {
      out += ",";
    }
    if (d.binds[i].nested.len() > 0) {
      out += "(" + destr_text(d.binds[i].nested[0]) + ")";
    } else {
      out += d.binds[i].name;
    }
  }
  return out;
}

// d with each name replaced by rename(name).
pub function rename_destr(d: Destr, rename: (string) => string): Destr {
  let binds: DestrBind[] = [];
  for b in d.binds {
    if (b.nested.len() > 0) {
      binds = binds.append(DestrBind { name: b.name, nested: [rename_destr(b.nested[0], rename)] });
    } else {
      binds = binds.append(DestrBind { name: rename(b.name), nested: [] });
    }
  }
  return Destr { ...d, binds: binds };
}

pub struct StmtReturn { value: Expr, line: i32, col: i32 }

// `op` is the operator of a compound assignment to an index or a field, written `a[i] += e`, and empty otherwise.
pub struct StmtExpr { value: Expr, line: i32, op: string }

// arms_open is the line of the brace that opens the arms of a value match.
pub struct MatchSugar { scrut: Expr, tup: TupArm[], strct: StructArm[], lits: LitArm[], arms: MatchArm[], line: i32, col: i32, origin: string, else_chained: boolean, arms_open: i32 }

pub struct StmtIf { cond: Expr, then_body: Stmt[], else_body: Stmt[], line: i32, else_chained: boolean, sugar: MatchSugar, origin: string }

pub struct StmtWhile { cond: Expr, body: Stmt[], label: string, line: i32, is_loop: boolean }

// `op` is the operator of a compound assignment as written, `+` for `x += e`, and empty for `=`.
pub struct StmtAssign { target: string, value: Expr, line: i32, col: i32, target_line: i32, target_col: i32, op: string }

pub struct PatVariant { type_name: string, binding: string, extra_bindings: string[], nested: Pattern[], at_binding: string, field_names: string[], lit_cond: Expr, has_lit_cond: boolean, tup_kinds: i32[], tup_binds: string[], tup_lits: Expr[], tup_pats: Pattern[], rest_written: boolean, bare_name: boolean, scalar_binding: boolean, scalar_cells: string[] }

pub struct PatLiteral { lit: Expr, range_hi: Expr, has_range: boolean, range_inclusive: boolean, at_binding: string, scalar_cells: string[] }

pub struct PatWildcard { tag: i32 }

pub type Pattern = PatVariant | PatWildcard | PatLiteral;

pub struct MatchArm { pattern: Pattern, body: Stmt[], line: i32, col: i32, guard: Expr, has_guard: boolean, alt_cont: boolean }

// arms_open is the line of the brace that opens the arms of a value match.
pub struct StmtMatch { scrutinee: Expr, arms: MatchArm[], line: i32, col: i32, origin: string, sugar: MatchArm[], else_chained: boolean, arms_open: i32 }

pub struct StmtFor { var_name: string, iter: Expr, body: Stmt[], label: string, line: i32, col: i32, destr: Destr }

pub struct StmtBreak { tag: i32, line: i32, col: i32, label: string }

pub struct StmtContinue { tag: i32, line: i32, col: i32, label: string }

pub struct StmtUnknown { fault: Fault, line: i32, col: i32 }

pub struct StmtDefer { action: Stmt, on_error: i32, line: i32 }

pub type Stmt = StmtVar | StmtReturn | StmtExpr | StmtIf | StmtWhile | StmtAssign | StmtMatch
  | StmtFor | StmtBreak | StmtContinue | StmtUnknown | StmtDefer;

pub struct ParamDecl { name: string, type_name: string, own: boolean, send: boolean, has_default: boolean, default_value: Expr, fn_ret: string, fn_param_types: string, line: i32, col: i32 }

pub struct LitArm { is_wild: boolean, lit: Expr, guard: Expr, has_guard: boolean, body: Stmt[], line: i32, col: i32, range_hi: Expr, has_range: boolean, range_inclusive: boolean, alt_cont: boolean, at_binding: string }

pub struct TupArm { is_wild: boolean, elem_kinds: i32[], binds: string[], lits: Expr[], elem_pats: Pattern[], at_binding: string, guard: Expr, has_guard: boolean, body: Stmt[], line: i32, col: i32, alt_cont: boolean }

pub struct StructArm { is_wild: boolean, type_name: string, binds: string[], fields: string[], field_kinds: i32[], field_lits: Expr[], field_pats: Pattern[], at_binding: string, rest_written: boolean, guard: Expr, has_guard: boolean, body: Stmt[], line: i32, col: i32 }

pub function operator_method(op: string): string {
  return match (op) {
    "+" => "add",
    "-" => "sub",
    "*" => "mul",
    "/" => "div",
    "%" => "rem",
    "&" => "bitand",
    "|" => "bitor",
    "^" => "bitxor",
    "<<" => "shl",
    ">>" => "shr",
    _ => "",
  };
}

// operator_trait names the core/ops trait that an operator method binds through.
pub function operator_trait(method: string): string {
  let methods: string[] = ["add", "sub", "mul", "div", "rem", "neg", "bitand", "bitor", "bitxor", "shl", "shr"];
  let traits: string[] = ["Add", "Sub", "Mul", "Div", "Rem", "Neg", "BitAnd", "BitOr", "BitXor", "Shl", "Shr"];
  for i in 0..methods.len() {
    if (methods[i] == method) {
      return traits[i];
    }
  }
  return "";
}

pub function is_operator_method(name: string): boolean {
  return name == "add" || name == "sub" || name == "mul" || name == "div" || name == "rem"
    || name == "bitand" || name == "bitor" || name == "bitxor" || name == "shl" || name == "shr";
}
