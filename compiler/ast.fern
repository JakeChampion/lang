pub struct StmtVar { name: string, type_name: string, init: Expr, line: i32, col: i32, fn_ret: string, fn_param_types: string }

pub struct StmtReturn { value: Expr, line: i32, col: i32 }

pub struct StmtExpr { value: Expr, line: i32 }

pub struct MatchSugar { scrut: Expr, tup: TupArm[], strct: StructArm[], lits: LitArm[], arms: MatchArm[], line: i32, col: i32, origin: string, else_chained: boolean }

pub struct StmtIf { cond: Expr, then_body: Stmt[], else_body: Stmt[], line: i32, else_chained: boolean, sugar: MatchSugar, origin: string }

pub struct StmtWhile { cond: Expr, body: Stmt[], label: string, line: i32, is_loop: boolean }

pub struct StmtAssign { target: string, value: Expr, line: i32, col: i32, target_line: i32, target_col: i32 }

pub struct PatVariant { type_name: string, binding: string, extra_bindings: string[], nested: Pattern[], at_binding: string, field_names: string[], lit_cond: Expr, has_lit_cond: boolean, tup_kinds: i32[], tup_binds: string[], tup_lits: Expr[], tup_pats: Pattern[], rest_written: boolean }

pub struct PatWildcard { tag: i32 }

pub type Pattern = PatVariant | PatWildcard;

pub struct MatchArm { pattern: Pattern, body: Stmt[], line: i32, col: i32, guard: Expr, has_guard: boolean, alt_cont: boolean }

pub struct StmtMatch { scrutinee: Expr, arms: MatchArm[], line: i32, col: i32, origin: string, sugar: MatchArm[], else_chained: boolean }

pub struct StmtFor { var_name: string, iter: Expr, body: Stmt[], label: string, line: i32, col: i32 }

pub struct StmtBreak { tag: i32, line: i32, col: i32, label: string }

pub struct StmtContinue { tag: i32, line: i32, col: i32, label: string }

pub struct StmtUnknown { kind: string, line: i32, col: i32 }

pub struct StmtDefer { action: Stmt, on_error: i32, line: i32 }

pub type Stmt = StmtVar | StmtReturn | StmtExpr | StmtIf | StmtWhile | StmtAssign | StmtMatch
  | StmtFor | StmtBreak | StmtContinue | StmtUnknown | StmtDefer;

pub struct ParamDecl { name: string, type_name: string, own: boolean, has_default: boolean, default_value: Expr, fn_ret: string, fn_param_types: string }

pub struct LitArm { is_wild: boolean, lit: Expr, guard: Expr, has_guard: boolean, body: Stmt[], line: i32, col: i32, range_hi: Expr, has_range: boolean, range_inclusive: boolean, alt_cont: boolean, at_binding: string }

pub struct TupArm { is_wild: boolean, elem_kinds: i32[], binds: string[], lits: Expr[], elem_pats: Pattern[], at_binding: string, guard: Expr, has_guard: boolean, body: Stmt[], line: i32, col: i32, alt_cont: boolean }

pub struct StructArm { is_wild: boolean, type_name: string, binds: string[], fields: string[], field_kinds: i32[], field_lits: Expr[], field_pats: Pattern[], at_binding: string, rest_written: boolean, guard: Expr, has_guard: boolean, body: Stmt[], line: i32, col: i32 }

pub function operator_method(op: string): string {
  if (op == "+") {
    return "add";
  }
  if (op == "-") {
    return "sub";
  }
  if (op == "*") {
    return "mul";
  }
  if (op == "/") {
    return "div";
  }
  if (op == "%") {
    return "rem";
  }
  if (op == "&") {
    return "bitand";
  }
  if (op == "|") {
    return "bitor";
  }
  if (op == "^") {
    return "bitxor";
  }
  if (op == "<<") {
    return "shl";
  }
  if (op == ">>") {
    return "shr";
  }
  return "";
}

pub function is_operator_method(name: string): boolean {
  return name == "add" || name == "sub" || name == "mul" || name == "div" || name == "rem"
    || name == "bitand" || name == "bitor" || name == "bitxor" || name == "shl" || name == "shr";
}
