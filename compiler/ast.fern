import "./typeinfo";

pub struct ExprNumber { text: string, suffix: string, raw: string, is_float: boolean, line: i32, col: i32 }

pub struct ExprIdent { name: string, line: i32, col: i32, ty: string }

pub struct ExprString { value: string, line: i32, col: i32 }

pub struct ExprBool { value: boolean, line: i32, col: i32 }

pub struct ExprBinary { op: string, left: Expr, right: Expr, line: i32, col: i32, ty: string }

pub struct ExprUnary { op: string, operand: Expr, line: i32, col: i32, ty: string }

pub struct ExprCall { callee: Expr, args: Expr[], line: i32, col: i32, type_args: string[], ty: string }

pub struct ExprArray { elements: Expr[], elem_ty: string, line: i32, col: i32 }

pub struct ExprBytes { value: u8[], line: i32, col: i32 }

pub struct TypedBinding { name: string, ty: typeinfo.Type }

pub struct ExprLambda { params: ParamDecl[], ret_type: string, body: Stmt[], use_infer: boolean, origin: string, line: i32, col: i32, captures: TypedBinding[], captures_known: boolean, ret_fn_ret: string, ret_fn_param_types: string }

pub struct ExprTuple { elements: Expr[], line: i32, col: i32 }

pub struct ExprIndex { array: Expr, index: Expr, unchecked: boolean, ty: string, line: i32, col: i32 }

pub struct ExprSlice { array: Expr, start: Expr, end: Expr, ty: string, open_end: boolean, open_start: boolean, line: i32, col: i32 }

pub struct ExprStructLit { type_name: string, field_names: string[], field_lines: i32[], field_cols: i32[], field_values: Expr[], has_base: boolean, base: Expr, line: i32, col: i32, written: string }

pub struct ExprFieldAccess { obj: Expr, field: string, line: i32, col: i32, ty: string, const_read: boolean }

pub struct ExprUnknown { kind: string, line: i32, col: i32 }

pub struct ExprMapLit { keys: Expr[], vals: Expr[], line: i32, col: i32 }

pub struct ExprFString { lits: string[], exprs: Expr[], is_expr: boolean[], line: i32, col: i32 }

pub struct ExprZero { type_name: string, line: i32, col: i32 }

pub type Expr = ExprNumber | ExprIdent | ExprString | ExprBool | ExprBinary | ExprUnary | ExprCall
  | ExprArray | ExprTuple | ExprIndex | ExprSlice | ExprStructLit | ExprFieldAccess | ExprLambda
  | ExprMapLit | ExprFString | ExprUnknown | ExprZero | ExprBytes;

pub const ORIGIN_NESTED_FN: string = "nested_fn";

pub function var_binds_itself(v: StmtVar): boolean {
  if let ExprLambda(lm) = v.init {
    return lm.origin == ORIGIN_NESTED_FN;
  }
  return false;
}

pub function stmt_line(st: Stmt): i32 {
  match (st) {
    StmtVar(v) => {
      return v.line;
    },
    StmtReturn(r) => {
      return r.line;
    },
    StmtAssign(a) => {
      return a.line;
    },
    StmtExpr(x) => {
      return x.line;
    },
    StmtIf(f) => {
      return f.line;
    },
    StmtWhile(w) => {
      return w.line;
    },
    StmtFor(fo) => {
      return fo.line;
    },
    StmtMatch(m) => {
      return m.line;
    },
    StmtDefer(d) => {
      return d.line;
    },
    StmtBreak(b) => {
      return b.line;
    },
    StmtContinue(c) => {
      return c.line;
    },
    _ => {
      return 0;
    }
  }
  return 0;
}

pub function stmt_col(st: Stmt): i32 {
  match (st) {
    StmtVar(v) => {
      return v.col;
    },
    StmtReturn(r) => {
      return r.col;
    },
    StmtAssign(a) => {
      return a.col;
    },
    StmtMatch(m) => {
      return m.col;
    },
    StmtBreak(b) => {
      return b.col;
    },
    StmtContinue(c) => {
      return c.col;
    },
    _ => {
      return 0;
    }
  }
}

pub function expr_line(e: Expr): i32 {
  match (e) {
    ExprNumber(n) => {
      return n.line;
    },
    ExprIdent(id) => {
      return id.line;
    },
    ExprString(st) => {
      return st.line;
    },
    ExprBool(b) => {
      return b.line;
    },
    ExprBinary(b) => {
      return b.line;
    },
    ExprUnary(u) => {
      return u.line;
    },
    ExprCall(c) => {
      return c.line;
    },
    ExprArray(al) => {
      return al.line;
    },
    ExprBytes(bs) => {
      return bs.line;
    },
    ExprTuple(tl) => {
      return tl.line;
    },
    ExprIndex(ix) => {
      return ix.line;
    },
    ExprSlice(sl) => {
      return sl.line;
    },
    ExprStructLit(st) => {
      return st.line;
    },
    ExprFieldAccess(fa) => {
      return fa.line;
    },
    ExprLambda(lm) => {
      return lm.line;
    },
    ExprMapLit(ml) => {
      return ml.line;
    },
    ExprFString(fs) => {
      return fs.line;
    },
    ExprUnknown(uk) => {
      return uk.line;
    },
    ExprZero(z) => {
      return z.line;
    }
  }
  return 0;
}

pub function expr_ty(e: Expr): string {
  match (e) {
    ExprNumber(n) => {
      return "";
    },
    ExprIdent(id) => {
      return id.ty;
    },
    ExprString(st) => {
      return "";
    },
    ExprBool(b) => {
      return "";
    },
    ExprBinary(b) => {
      return b.ty;
    },
    ExprUnary(u) => {
      return u.ty;
    },
    ExprCall(c) => {
      return c.ty;
    },
    ExprArray(al) => {
      return "";
    },
    ExprBytes(_) => {
      return "u8[]";
    },
    ExprTuple(tl) => {
      return "";
    },
    ExprIndex(ix) => {
      return ix.ty;
    },
    ExprSlice(sl) => {
      return sl.ty;
    },
    ExprStructLit(st) => {
      return "";
    },
    ExprFieldAccess(fa) => {
      return fa.ty;
    },
    ExprLambda(lm) => {
      return "";
    },
    ExprMapLit(ml) => {
      return "";
    },
    ExprFString(fs) => {
      return "";
    },
    ExprUnknown(uk) => {
      return "";
    },
    ExprZero(z) => {
      return "";
    }
  }
  return "";
}

