import "./typeinfo";
import "std/string";

// bits is parsed once from text: the f64 bit pattern of a float literal, and
// the value of an integer literal.
pub struct ExprNumber { text: string, suffix: string, raw: string, is_float: boolean, bits: i64, line: i32, col: i32 }

// builtin: names the builtin itself, which no binding in scope can capture.
pub struct ExprIdent { name: string, line: i32, col: i32, ty: string, builtin: boolean }

pub struct ExprString { value: string, line: i32, col: i32 }

pub struct ExprBool { value: boolean, line: i32, col: i32 }

// lit is the literal class of the node. `binary` and `unary` calculate it, so
// each node comes from one of them.
pub struct ExprBinary { op: string, left: Expr, right: Expr, line: i32, col: i32, ty: string, lit: i32 }

// A cast has the op CAST or CHECKED_CAST, and `cast` holds its target type.
pub struct ExprUnary { op: string, operand: Expr, line: i32, col: i32, ty: string, lit: i32, cast: string }

pub struct ExprCall { callee: Expr, args: Expr[], line: i32, col: i32, type_args: string[], ty: string }

pub struct ExprArray { elements: Expr[], elem_ty: string, line: i32, col: i32 }

pub struct ExprBytes { value: u8[], line: i32, col: i32 }

pub struct TypedBinding { name: string, ty: typeinfo.Type }

pub struct ExprLambda { params: ParamDecl[], ret_own: boolean, ret_type: string, body: Stmt[], use_infer: boolean, origin: string, line: i32, col: i32, captures: TypedBinding[], captures_known: boolean, ret_fn_ret: string, ret_fn_param_types: string, once: boolean }

pub struct ExprTuple { elements: Expr[], line: i32, col: i32 }

pub struct ExprIndex { array: Expr, index: Expr, unchecked: boolean, ty: string, line: i32, col: i32 }

pub struct ExprSlice { array: Expr, start: Expr, end: Expr, ty: string, open_end: boolean, open_start: boolean, line: i32, col: i32 }

pub struct ExprStructLit { type_name: string, field_names: string[], field_lines: i32[], field_cols: i32[], field_values: Expr[], has_base: boolean, base: Expr, line: i32, col: i32, written: string }

// display marks a `to_string` callee that binds through `cmp.Display`: an
// f-string part, or the argument of `print`, `write` or `eprint`.
pub struct ExprFieldAccess { obj: Expr, field: string, line: i32, col: i32, ty: string, const_read: boolean, display: boolean }

// A parse error, or a mark where the parser has no node. A mark has no
// code. A scoped error names the function it is in.
pub struct Fault { mark: string, code: string, message: string, scoped: boolean }

pub function fault_mark(name: string): Fault {
  return Fault { mark: name, code: "", message: "", scoped: false };
}

// The message of an error, or the name of a mark.
pub function fault_text(f: Fault): string {
  if (f.code.len() > 0) {
    return f.message;
  }
  return f.mark;
}

pub struct ExprUnknown { fault: Fault, line: i32, col: i32 }

pub struct ExprMapLit { keys: Expr[], vals: Expr[], line: i32, col: i32 }

pub struct ExprFString { lits: string[], exprs: Expr[], is_expr: boolean[], line: i32, col: i32 }

pub struct ExprZero { type_name: string, line: i32, col: i32 }

pub type Expr = ExprNumber | ExprIdent | ExprString | ExprBool | ExprBinary | ExprUnary | ExprCall
  | ExprArray | ExprTuple | ExprIndex | ExprSlice | ExprStructLit | ExprFieldAccess | ExprLambda
  | ExprMapLit | ExprFString | ExprUnknown | ExprZero | ExprBytes;

pub const ORIGIN_NESTED_FN: string = "nested_fn";

// A literal class is a set of these bits. Each bit is a shape of literal tree.

// Integers with no suffix below the integer operators.
const LIT_INT: i32 = 1;

// Integers with no suffix that fit i32, below `-`, `+`, `*` and `/`.
const LIT_I32: i32 = 2;

// Integers with no suffix below `-`, `+`, `*` and `/`.
const LIT_ARITH: i32 = 4;

// Floats with no suffix below `-`, `+`, `*` and `/`.
const LIT_FLOAT: i32 = 8;

// Integers with any suffix below a negation, a cast, `+`, `-` and `*`.
const LIT_OPERAND: i32 = 16;

pub function binary(op: string, left: Expr, right: Expr, line: i32, col: i32, ty: string): ExprBinary {
  return ExprBinary { op: op, left: left, right: right, line: line, col: col, ty: ty, lit: binary_class(op, lit_class(left) & lit_class(right)) };
}

pub const CAST: string = "as";

pub const CHECKED_CAST: string = "as?";

pub function unary(op: string, operand: Expr, line: i32, col: i32, ty: string): ExprUnary {
  return ExprUnary { op: op, operand: operand, line: line, col: col, ty: ty, lit: unary_class(op, operand), cast: "" };
}

// `operand as target`, or `operand as? target` when checked.
pub function cast(operand: Expr, target: string, checked: boolean, line: i32, col: i32, ty: string): ExprUnary {
  let op = CAST;
  if (checked) {
    op = CHECKED_CAST;
  }
  return ExprUnary { op: op, operand: operand, line: line, col: col, ty: ty, lit: unary_class(op, operand), cast: target };
}

// u with a new operand, position and type. The op and the cast stay.
pub function rebuild_unary(u: ExprUnary, operand: Expr, line: i32, col: i32, ty: string): ExprUnary {
  return ExprUnary { ...u, operand: operand, line: line, col: col, ty: ty, lit: unary_class(u.op, operand) };
}

// u with the cast target `target`. The literal class does not depend on it.
pub function with_cast(u: ExprUnary, target: string): ExprUnary {
  return ExprUnary { ...u, cast: target };
}

function lit_class(e: Expr): i32 {
  match (e) {
    ExprNumber(n) => {
      return number_class(n);
    },
    ExprUnary(u) => {
      return u.lit;
    },
    ExprBinary(b) => {
      return b.lit;
    },
    _ => {
      return 0;
    }
  }
}

function number_class(n: ExprNumber): i32 {
  if (n.is_float) {
    if (n.suffix.len() == 0) {
      return LIT_FLOAT;
    }
    return 0;
  }
  if (n.suffix.len() > 0 || is_unit_literal(n)) {
    return LIT_OPERAND;
  }
  if (literal_is_i64(n.text)) {
    return LIT_OPERAND | LIT_INT | LIT_ARITH;
  }
  return LIT_OPERAND | LIT_INT | LIT_ARITH | LIT_I32;
}

function unary_class(op: string, operand: Expr): i32 {
  let inner = lit_class(operand);
  if (op == "-") {
    if let ExprNumber(n) = operand {
      if (!n.is_float && n.suffix.len() == 0 && n.text == "2147483648") {
        inner = inner | LIT_I32;
      }
    }
    return inner;
  }
  if (op == "+") {
    return inner & (LIT_INT | LIT_ARITH | LIT_FLOAT);
  }
  if (op == CAST) {
    return inner & LIT_OPERAND;
  }
  return 0;
}

// both holds the bits that the two operands share.
function binary_class(op: string, both: i32): i32 {
  if (both == 0) {
    return 0;
  }
  if (op == "+" || op == "-" || op == "*") {
    return both;
  }
  if (op == "/") {
    return both & (LIT_INT | LIT_I32 | LIT_ARITH | LIT_FLOAT);
  }
  if (int_literal_op(op)) {
    return both & LIT_INT;
  }
  return 0;
}

pub function int_literal_op(op: string): boolean {
  return op == "+" || op == "-" || op == "*" || op == "/" || op == "%"
    || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>"
    || op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}

pub function int_literal_tree(e: Expr): boolean {
  return (lit_class(e) & LIT_INT) != 0;
}

pub function i32_literal_tree(e: Expr): boolean {
  return (lit_class(e) & LIT_I32) != 0;
}

pub function is_unsettled_int_literal(e: Expr): boolean {
  return (lit_class(e) & LIT_ARITH) != 0;
}

pub function float_literal_tree(e: Expr): boolean {
  return (lit_class(e) & LIT_FLOAT) != 0;
}

pub function literal_operand(e: Expr): boolean {
  return (lit_class(e) & LIT_OPERAND) != 0;
}

pub function is_unit_literal(n: ExprNumber): boolean {
  return n.raw == "()";
}

pub function is_hex_lit(text: string): boolean {
  return text.len() > 2 && text[0] as i32 == 48
    && (text[1] as i32 == 120 || text[1] as i32 == 88);
}

function lower_hex_byte(b: i32): i32 {
  if (b >= 65 && b <= 70) {
    return b + 32;
  }
  return b;
}

pub function magnitude_fits(text: string, start: i32, max: string): boolean {
  let i = start;
  while (i < text.len() && text[i] as i32 == 48) {
    i += 1;
  }
  let n = text.len() - i;
  if (n != max.len()) {
    return n < max.len();
  }
  for k in 0..n {
    let tc = lower_hex_byte(text[i + k] as i32);
    let mc = max[k] as i32;
    if (tc != mc) {
      return tc < mc;
    }
  }
  return true;
}

pub function literal_is_i64(text: string): boolean {
  let hex = is_hex_lit(text);
  let start = 0;
  if (hex) {
    start = 2;
  }
  let m = "2147483647";
  if (hex) {
    m = "7fffffff";
  }
  return !magnitude_fits(text, start, m);
}

pub function var_binds_itself(v: StmtVar): boolean {
  if let ExprLambda(lm) = v.init {
    return lm.origin == ORIGIN_NESTED_FN;
  }
  return false;
}

pub function stmt_line(st: Stmt): i32 {
  match (st) {
    StmtVar(v) => {
      return v.line;
    },
    StmtReturn(r) => {
      return r.line;
    },
    StmtAssign(a) => {
      return a.line;
    },
    StmtExpr(x) => {
      return x.line;
    },
    StmtIf(f) => {
      return f.line;
    },
    StmtWhile(w) => {
      return w.line;
    },
    StmtFor(fo) => {
      return fo.line;
    },
    StmtMatch(m) => {
      return m.line;
    },
    StmtDefer(d) => {
      return d.line;
    },
    StmtBreak(b) => {
      return b.line;
    },
    StmtContinue(c) => {
      return c.line;
    },
    _ => {
      return 0;
    }
  }
}

pub function stmt_col(st: Stmt): i32 {
  match (st) {
    StmtVar(v) => {
      return v.col;
    },
    StmtReturn(r) => {
      return r.col;
    },
    StmtAssign(a) => {
      return a.col;
    },
    StmtMatch(m) => {
      return m.col;
    },
    StmtBreak(b) => {
      return b.col;
    },
    StmtContinue(c) => {
      return c.col;
    },
    StmtExpr(x) => {
      return start_col(x.value);
    },
    StmtFor(fo) => {
      return fo.col;
    },
    _ => {
      return 0;
    }
  }
}

// The column of the leftmost token of `e`.
function start_col(e: Expr): i32 {
  match (e) {
    ExprCall(c) => {
      return start_col(c.callee);
    },
    ExprFieldAccess(fa) => {
      return start_col(fa.obj);
    },
    ExprIndex(ix) => {
      return start_col(ix.array);
    },
    ExprBinary(b) => {
      return start_col(b.left);
    },
    _ => {
      return expr_col(e);
    }
  }
}

pub function expr_line(e: Expr): i32 {
  match (e) {
    ExprNumber(n) => {
      return n.line;
    },
    ExprIdent(id) => {
      return id.line;
    },
    ExprString(st) => {
      return st.line;
    },
    ExprBool(b) => {
      return b.line;
    },
    ExprBinary(b) => {
      return b.line;
    },
    ExprUnary(u) => {
      return u.line;
    },
    ExprCall(c) => {
      return c.line;
    },
    ExprArray(al) => {
      return al.line;
    },
    ExprBytes(bs) => {
      return bs.line;
    },
    ExprTuple(tl) => {
      return tl.line;
    },
    ExprIndex(ix) => {
      return ix.line;
    },
    ExprSlice(sl) => {
      return sl.line;
    },
    ExprStructLit(st) => {
      return st.line;
    },
    ExprFieldAccess(fa) => {
      return fa.line;
    },
    ExprLambda(lm) => {
      return lm.line;
    },
    ExprMapLit(ml) => {
      return ml.line;
    },
    ExprFString(fs) => {
      return fs.line;
    },
    ExprUnknown(uk) => {
      return uk.line;
    },
    ExprZero(z) => {
      return z.line;
    }
  }
}

pub function expr_ty(e: Expr): string {
  match (e) {
    ExprNumber(n) => {
      return "";
    },
    ExprIdent(id) => {
      return id.ty;
    },
    ExprString(st) => {
      return "";
    },
    ExprBool(b) => {
      return "";
    },
    ExprBinary(b) => {
      return b.ty;
    },
    ExprUnary(u) => {
      return u.ty;
    },
    ExprCall(c) => {
      return c.ty;
    },
    ExprArray(al) => {
      return "";
    },
    ExprBytes(_) => {
      return "u8[]";
    },
    ExprTuple(tl) => {
      return "";
    },
    ExprIndex(ix) => {
      return ix.ty;
    },
    ExprSlice(sl) => {
      return sl.ty;
    },
    ExprStructLit(st) => {
      return "";
    },
    ExprFieldAccess(fa) => {
      return fa.ty;
    },
    ExprLambda(lm) => {
      return "";
    },
    ExprMapLit(ml) => {
      return "";
    },
    ExprFString(fs) => {
      return "";
    },
    ExprUnknown(uk) => {
      return "";
    },
    ExprZero(z) => {
      return "";
    }
  }
}

// receiver_tag is the type name of a struct literal, or the inferred type of any other expression.
pub function receiver_tag(e: Expr): string {
  if let ExprStructLit(lit) = e {
    return lit.type_name;
  }
  return expr_ty(e);
}

pub function is_call(e: Expr): boolean {
  if let ExprCall(_) = e {
    return true;
  }
  return false;
}

pub function is_unknown(e: Expr): boolean {
  if let ExprUnknown(_) = e {
    return true;
  }
  return false;
}

pub function is_true_literal(e: Expr): boolean {
  if let ExprBool(b) = e {
    return b.value;
  }
  return false;
}

pub function expr_col(e: Expr): i32 {
  match (e) {
    ExprNumber(n) => {
      return n.col;
    },
    ExprIdent(id) => {
      return id.col;
    },
    ExprString(st) => {
      return st.col;
    },
    ExprBool(b) => {
      return b.col;
    },
    ExprBinary(b) => {
      return b.col;
    },
    ExprUnary(u) => {
      return u.col;
    },
    ExprCall(c) => {
      return c.col;
    },
    ExprArray(al) => {
      return al.col;
    },
    ExprBytes(bs) => {
      return bs.col;
    },
    ExprTuple(tl) => {
      return tl.col;
    },
    ExprIndex(ix) => {
      return ix.col;
    },
    ExprSlice(sl) => {
      return sl.col;
    },
    ExprStructLit(st) => {
      return st.col;
    },
    ExprFieldAccess(fa) => {
      return fa.col;
    },
    ExprLambda(lm) => {
      return lm.col;
    },
    ExprMapLit(ml) => {
