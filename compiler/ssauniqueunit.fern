// Independent final-text binding for a uniqueness leaf library collection.
// This scope excludes exports, inter-function calls, runtime code and nonempty
// pools. It inherits check_body's explicit pointer/header and stack ABI.
// No retained body text, site spans, allocation or emitter imports are used.
import "./ssa";
import "./ssauniquecaller" as caller;
import "./ssacredithelper" as helper;
import "./util";
import "std/string";

struct Unit { lines: string[], ok: boolean }

// Built privately from this unit's exact names. Sorting changes only the
// position index; function and text order remain untouched.
struct Names { names: string[], order: i32[], duplicate: i32 }

function before(a: string, b: string): boolean {
  let i = 0;
  while (i < a.len() && i < b.len()) {
    if (a[i] != b[i]) {
      return a[i] < b[i];
    }
    i = i + 1;
  }
  return a.len() < b.len();
}

function merge_names(names: string[], order: i32[], left: i32, mid: i32, end: i32, output: i32[]): i32[] {
  let out = output;
  let a = left;
  let b = mid;
  let at = left;
  while (at < end) {
    if (b >= end || a < mid && !before(names[order[b]], names[order[a]])) {
      out = out.with(at, order[a]);
      a = a + 1;
    } else {
      out = out.with(at, order[b]);
      b = b + 1;
    }
    at = at + 1;
  }
  return out;
}

function names_pass(names: string[], order: i32[], width: i32): i32[] {
  let out = order;
  let left = 0;
  while (left < names.len()) {
    let mid = left + (if (width < names.len() - left) { width } else { names.len() - left });
    let end = mid + (if (width < names.len() - mid) { width } else { names.len() - mid });
    out = merge_names(names, order, left, mid, end, out);
    left = end;
  }
  return out;
}

function duplicate_name(names: string[], order: i32[]): i32 {
  let duplicate = -1;
  let i = 1;
  while (i < order.len()) {
    let at = order[i];
    if (names[at] == names[order[i - 1]] && (duplicate < 0 || at < duplicate)) {
      duplicate = at;
    }
    i = i + 1;
  }
  return duplicate;
}

function name_index(names: string[]): Names {
  let order: i32[] = [];
  let i = 0;
  while (i < names.len()) {
    order = order.append(i);
    i = i + 1;
  }
  let width = 1;
  while (width < names.len()) {
    order = names_pass(names, order, width);
    width = if (width > names.len() / 2) { names.len() } else { width * 2 };
  }
  return Names { names: names, order: order, duplicate: duplicate_name(names, order) };
}

function position(ix: Names, name: string): i32 {
  let lo = 0;
  let hi = ix.order.len();
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2;
    let at = ix.order[mid];
    if (ix.names[at] == name) {
      return at;
    }
    if (before(ix.names[at], name)) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return -1;
}

function refuse(name: string): helper.Proof {
  return helper.Proof { ok: false, function_name: name, message: "unproved uniqueness final unit" };
}

// These sections contain only a self-address anchor and empty table bounds.
// Accepting a precise grammar prevents a data directive from changing the
// section or assembler interpretation of the executable body.
function empty_pools(): string {
  return ".section .data\n.align 8\n.Lfern_relanchor:\n.quad .Lfern_relanchor\n.align 8\n.Lfern_sbox_begin:\n.section .data\n.Lfern_sbox_end:\n.align 8\n.Lfern_cagg_begin:\n.section .data\n.Lfern_cagg_end:\n.align 8\n.Lfern_cfn_begin:\n.section .data\n.Lfern_cfn_end:\n.align 8\n.Lfern_cref_begin:\n.Lfern_cref_end:\n.text\n";
}

function pools_match(tail: string[], architecture: string): boolean {
  let expected = if (architecture == "arm64") { empty_pools().split("\n") } else { [""] };
  if (tail.len() != expected.len() - 1) {
    return false;
  }
  let i = 0;
  while (i < tail.len()) {
    if (tail[i] != expected[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function text_unit(output: string, architecture: string): Unit {
  let lines: string[] = [];
  let labels: string[] = [];
  for raw in output.split("\n") {
    let line = util.trim(raw);
    if (line != "") {
      // Body and pool labels share one assembler namespace.
      if (line.ends_with(":")) {
        labels = labels.append(line);
      }
      lines = lines.append(line);
    }
  }
  if (name_index(labels).duplicate >= 0 || lines.len() < 2 || lines[0] != ".text") {
    return Unit { lines: [], ok: false };
  }
  let body: string[] = [];
  let tail: string[] = [];
  let in_pools = false;
  let i = 1;
  while (i < lines.len()) {
    let line = lines[i];
    if (line == ".section .data") {
      in_pools = true;
    }
    if (in_pools) {
      tail = tail.append(line);
    } else {
      body = body.append(line);
    }
    i = i + 1;
  }
  if (!pools_match(tail, architecture)) {
    return Unit { lines: [], ok: false };
  }
  return Unit { lines: body, ok: true };
}

// Resolve by the supplied final graph's exact symbol, never by retained body
// text or collection position. Every supplied function must occur once.
pub function check_collection(output: string, architecture: string, functions: ssa.SFunc[]): helper.Proof {
  let unit = text_unit(output, architecture);
  if (!unit.ok || functions.len() == 0) {
    return refuse("");
  }
  let entries: string[] = [];
  let seen: boolean[] = [];
  for f in functions {
    let entry = "__fn_" + f.name + ":";
    entries = entries.append(entry);
    seen = seen.append(false);
  }
  let names = name_index(entries);
  if (names.duplicate >= 0) {
    return refuse(functions[names.duplicate].name);
  }
  let count = 0;
  let current = -1;
  let body: string[] = [];
  for line in unit.lines {
    let at = position(names, line);
    if (at >= 0) {
      if (seen[at]) {
        return refuse(functions[at].name);
      }
      if (current >= 0) {
        let proof = caller.check_lines(body, architecture, functions[current]);
        if (!proof.ok) {
          return proof;
        }
      }
      seen = seen.with(at, true);
      count = count + 1;
      current = at;
      body = [];
    }
    if (current < 0) {
      return refuse("");
    }
    body = body.append(line);
  }
  if (current < 0 || count != functions.len()) {
    return refuse("");
  }
  let proof = caller.check_lines(body, architecture, functions[current]);
  if (!proof.ok) {
    return proof;
  }
  return helper.Proof { ok: true, function_name: "", message: "" };
}

pub function check_unit(output: string, architecture: string, f: ssa.SFunc): helper.Proof {
  let proof = check_collection(output, architecture, [f]);
  return helper.Proof { ...proof, function_name: f.name };
}
