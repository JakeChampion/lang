import "./ast";
import "./astwalk";
import "./parser";
import "./platforms";
import "./treeshake";
import "./util";

pub struct Violation {
  handler: string,
  bag: string,
  builtin: string,
  capability: string,
  chain: string[],
  line: i32,
  col: i32,
  fn_module: string,
}

pub function is_bag_method(fd: parser.FuncDecl): boolean {
  return parser.trait_simple_name(fd.impl_trait) == "Platform";
}

pub function bag_param(fd: parser.FuncDecl): string {
  if (is_bag_method(fd)) {
    return "";
  }
  let i = 0;
  while (i < fd.params.len()) {
    if (parser.is_platform_param(fd, i, "")) {
      return fd.params[i].name;
    }
    i += 1;
  }
  return "";
}

function gated_calls(fd: parser.FuncDecl, wanted: util.NameIndex): string[] {
  let calls: astwalk.CallSite[] = [];
  let bi = 0;
  while (bi < fd.body.len()) {
    calls = astwalk.collect_calls_stmt(fd.body[bi], wanted, calls);
    bi += 1;
  }
  let out: string[] = [];
  let ci = 0;
  while (ci < calls.len()) {
    if (!calls[ci].method && !util.has_str(out, calls[ci].name)) {
      out = out.append(calls[ci].name);
    }
    ci += 1;
  }
  return out;
}

function chain_of(mod: parser.Module, parent: i32[], at: i32): string[] {
  let rev: string[] = [];
  let n = at;
  while (n >= 0) {
    rev = rev.append(mod.funcs[n].name);
    n = parent[n];
  }
  let out: string[] = [];
  let i = rev.len() - 1;
  while (i >= 0) {
    out = out.append(rev[i]);
    i -= 1;
  }
  return out;
}

// The functions each function reaches. Every handler's search shares it.
struct Reach { known: boolean[], edges: i32[][] }

struct Found { out: Violation[], reach: Reach }

function no_reach(n: i32): Reach {
  let known: boolean[] = [];
  let edges: i32[][] = [];
  while (known.len() < n) {
    known = known.append(false);
    edges = edges.append([]);
  }
  return Reach { known: known, edges: edges };
}

function with_edges(mod: parser.Module, cur: i32, own r: Reach): Reach {
  if (r.known[cur]) {
    return r;
  }
  let fd = mod.funcs[cur];
  let rs = treeshake.body_refs(fd);
  let out: i32[] = [];
  let fi = 0;
  while (fi < mod.funcs.len()) {
    if (!is_bag_method(mod.funcs[fi]) && treeshake.refs_name(rs, mod.funcs[fi]) && method_edge(fd, mod.funcs[fi])) {
      out = out.append(fi);
    }
    fi += 1;
  }
  return Reach { known: r.known.with(cur, true), edges: r.edges.with(cur, out) };
}

function handler_violations(mod: parser.Module, hi: i32, bag: string, wanted: util.NameIndex, own out: Violation[], own reach: Reach): Found {
  let parent: i32[] = [];
  let pi = 0;
  while (pi < mod.funcs.len()) {
    parent = parent.append(-2);
    pi += 1;
  }
  parent = parent.with(hi, -1);
  let queue: i32[] = [hi];
  let seen_caps: string[] = [];
  let qi = 0;
  while (qi < queue.len()) {
    let cur = queue[qi];
    qi += 1;
    let fd = mod.funcs[cur];
    let calls = gated_calls(fd, wanted);
    let ci = 0;
    while (ci < calls.len()) {
      let cap = platforms.gated_capability(calls[ci]);
      if (!util.has_str(seen_caps, cap)) {
        seen_caps = seen_caps.append(cap);
        out = out.append(Violation {
          handler: mod.funcs[hi].name,
          bag: bag,
          builtin: calls[ci],
          capability: cap,
          chain: chain_of(mod, parent, cur).append(calls[ci]),
          line: mod.funcs[hi].line,
          col: mod.funcs[hi].col,
          fn_module: util.mangled_module(mod.funcs[hi].name),
        });
      }
      ci += 1;
    }
    reach = with_edges(mod, cur, reach);
    for fi in reach.edges[cur] {
      if (parent[fi] == -2) {
        parent = parent.with(fi, cur);
        queue = queue.append(fi);
      }
    }
  }
  return Found { out: out, reach: reach };
}

// A method on a named type is reached only by a call whose receiver has
// that type, or whose receiver type the annotation did not settle. The
// reference sets name an array or primitive receiver's method by its bare
// name, which a method of the same name on an unrelated type also matches.
function method_edge(fd: parser.FuncDecl, callee: parser.FuncDecl): boolean {
  if (callee.receiver_type.len() == 0 || callee.impl_trait.len() > 0) {
    return true;
  }
  // Array and view methods can be rewritten as direct calls. Keep their
  // existing reference edges when no method call remains in the body.
  if (parser.array_method_element(callee.receiver_type).len() > 0) {
    return true;
  }
  let want = canonical_tag(util.base_type_name(callee.receiver_type));
  if (want.len() == 0 || util.has_str(callee.type_params, want) || util.has_str(callee.all_type_params, want)) {
    return true;
  }
  let edge = MethodEdge { name: method_base_name(callee.name), receiver: want, hit: false };
  for st in fd.body {
    edge = astwalk.fold_stmt(st, edge, method_edge_call);
  }
  return edge.hit;
}

struct MethodEdge { name: string, receiver: string, hit: boolean }

function method_edge_call(e: ast.Expr, own edge: MethodEdge): MethodEdge {
  if (edge.hit) {
    return edge;
  }
  let ast.ExprCall(c) = e else {
    return edge;
  };
  let ast.ExprFieldAccess(fa) = c.callee else {
    return edge;
  };
  if (fa.field != edge.name) {
    return edge;
  }
  if let ast.ExprArray(_) = fa.obj {
    return edge;
  }
  let tag = canonical_tag(util.base_type_name(receiver_tag(fa.obj)));
  return MethodEdge { ...edge, hit: tag.len() == 0 || tag == edge.receiver };
}

function receiver_tag(e: ast.Expr): string {
  if let ast.ExprStructLit(lit) = e {
    return lit.type_name;
  }
  return ast.expr_ty(e);
}

function canonical_tag(tag: string): string {
  if (tag == "str") {
    return "string";
  }
  if (tag == "bool") {
    return "boolean";
  }
  return tag;
}

// A trait method of an impl is declared as `Trait.method`.
function method_base_name(name: string): string {
  let last_dot: i32 = -1;
  for i in 0..name.len() {
    if (name[i] == b'.') {
      last_dot = i;
    }
  }
  if (last_dot < 0) {
    return name;
  }
  return slice_unchecked(name, last_dot + 1, name.len()) + "";
}

function by_capability(vs: Violation[]): Violation[] {
  let order: i32[] = [];
  let i = 0;
  while (i < vs.len()) {
    let at = order.len();
    while (at > 0 && util.str_less(vs[i].capability, vs[order[at - 1]].capability)) {
      at -= 1;
    }
    let shifted: i32[] = [];
    let j = 0;
    while (j < at) {
      shifted = shifted.append(order[j]);
      j += 1;
    }
    shifted = shifted.append(i);
    while (j < order.len()) {
      shifted = shifted.append(order[j]);
      j += 1;
    }
    order = shifted;
    i += 1;
  }
  let out: Violation[] = [];
  let k = 0;
  while (k < order.len()) {
    out = out.append(vs[order[k]]);
    k += 1;
  }
  return out;
}

pub function enforce(mod: parser.Module): Violation[] {
  let gates = platforms.gated_builtins();
  let names: string[] = [];
  let gi = 0;
  while (gi < gates.len()) {
    names = names.append(gates[gi].builtin);
    gi += 1;
  }
  let wanted = util.name_index(names);
  let out: Violation[] = [];
  let reach = no_reach(mod.funcs.len());
  let hi = 0;
  while (hi < mod.funcs.len()) {
    let bag = bag_param(mod.funcs[hi]);
    if (bag.len() > 0 && mod.funcs[hi].body.len() > 0) {
      let found = handler_violations(mod, hi, bag, wanted, [], reach);
      reach = found.reach;
      let mine = by_capability(found.out);
      let vi = 0;
      while (vi < mine.len()) {
        out = out.append(mine[vi]);
        vi += 1;
      }
    }
    hi += 1;
  }
  return out;
}

pub function bag_method(builtin: string): string {
  if (builtin == "eprint") {
    return "log";
  }
  if (builtin == "now_unix_ms") {
    return "now";
  }
  if (builtin == "monotonic_ns") {
    return "instant";
  }
  if (builtin == "env") {
    return "env";
  }
  if (builtin == "config_get") {
    return "config";
  }
  if (builtin == "random_i32") {
    return "random_i32";
  }
  if (builtin == "sleep_ms" || builtin == "sleep_ns") {
    return "sleep";
  }
  if (builtin == "stat") {
    return "stat";
  }
  return "";
}

pub function violation_message(v: Violation): string {
  let where = "";
  if (v.fn_module.len() > 0) {
    where = " (declared in module \"" + v.fn_module + "\")";
  }
  let fix = "nothing on the bag stands in for it";
  let m = bag_method(v.builtin);
  if (m.len() > 0) {
    fix = "call `" + v.bag + "." + m + "(…)` (`import \"std/platform\";`) so the effect comes from the platform the handler was handed";
  }
  let chain = "";
  let i = 0;
  while (i < v.chain.len()) {
    if (i > 0) {
      chain += " -> ";
    }
    chain += v.chain[i];
    i += 1;
  }
  return "handler `" + v.handler + "`" + where + " reaches `" + v.builtin + "` (`" + v.capability + "`) around its platform `" + v.bag + "`: " + chain + "; " + fix;
}
