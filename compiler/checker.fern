  }

  let src5 = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
  let mod5 = parser.parse_module(lexer.tokenize(src5));
  let mt5 = check_module(mod5);
  if (!mt5.all_well_typed) {
