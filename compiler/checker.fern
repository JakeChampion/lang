import "./ast";
import "./util";
import "./lexer";
import "./parser";
import "./astwalk";
import "./lexical";
import "./builtinsigs";
import "./typeinfo";
import "./decltypes";
import "./semtypes";
import "./stdlib_methods";
import "./consteval";
import "std/option";

function t_i32(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 32, unsigned: false, polymorphic: false };
}

function t_i64(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 64, unsigned: false, polymorphic: false };
}

function t_u32(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 32, unsigned: true, polymorphic: false };
}

function t_u64(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 64, unsigned: true, polymorphic: false };
}

function t_usize(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: typeinfo.width_ptr(), unsigned: true, polymorphic: false };
}

function is_usize(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(i) => {
      return i.width == typeinfo.width_ptr() && !i.is_char;
    },
    _ => {
      return false;
    }
  }
}

function t_u8(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 8, unsigned: true, polymorphic: false };
}

function t_char(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: true, width: 32, unsigned: false, polymorphic: false };
}

function lit_is_scalar_value(text: string): boolean {
  let off = 0;
  if (text.len() > 0 && text[0] == b'-') {
    off = 1;
  }
  let digits = text.len() - off;
  let is_hex = digits > 1 && text[off] == b'0' && (text[off + 1] == b'x' || text[off + 1] == b'X');
  if (is_hex) {
    if (digits - 2 > 6) {
      return false;
    }
  } else {
    if (digits > 7) {
      return false;
    }
  }
  let v = util.lit_to_i32(text);
  if (v < 0 || v > 1114111) {
    return false;
  }
  if (v >= 55296 && v <= 57343) {
    return false;
  }
  return true;
}

function lit_scalar_msg(text: string): string {
  let v = util.lit_to_i32(text);
  let hint = "";
  if (v >= 55296 && v <= 57343) {
    hint = " (this is a surrogate)";
  }
  return util.i32_to_string(v) + " is not a Unicode scalar value, so it cannot be cast to `char`: the range is 0..0x10FFFF excluding the surrogates 0xD800..0xDFFF" + hint + " — use `utf8.char_from_i32` for a value that is only known at run time";
}

function int_label(t: typeinfo.TypeI32): string {
  if (t.is_char) {
    return "char";
  }
  if (t.unsigned) {
    if (t.width == 64) {
      return "u64";
    }
    if (t.width == 8) {
      return "u8";
    }
    if (t.width == typeinfo.width_ptr()) {
      return "usize";
    }
    return "u32";
  }
  if (t.width == 64) {
    return "i64";
  }
  return "i32";
}

function t_bool(): typeinfo.Type {
  return typeinfo.TypeBool { tag: 0 };
}

function t_string(): typeinfo.Type {
  return typeinfo.TypeString { tag: 0 };
}

function t_str(): typeinfo.Type {
  return typeinfo.TypeString { tag: 1 };
}

function is_str_view(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeString(st) => {
      return st.tag == 1;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_owned_string(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeString(st) => {
      return st.tag == 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function str_copy_hint(from: typeinfo.Type, to: typeinfo.Type): string {
  if (is_str_view(from) && is_owned_string(to)) {
    return " — `str` is a borrowed view of a string; add `.to_owned()` to copy it into an owned string";
  }
  return "";
}

function view_arg_borrow(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if (is_str_view(from) && is_owned_string(to)) {
    return true;
  }
  if let typeinfo.TypeArray(fa) = from {
    if let typeinfo.TypeArray(ta) = to {
      return !fa.view && ta.view && (type_eq(fa.elem, ta.elem) || is_unknown(ta.elem));
    }
  }
  return false;
}

function t_float(): typeinfo.Type {
  return typeinfo.TypeFloat { width: 64, polymorphic: false };
}

function t_f32(): typeinfo.Type {
  return typeinfo.TypeFloat { width: 32, polymorphic: false };
}

function t_lanes(width: i32): typeinfo.Type {
  return typeinfo.TypeLanes { width: width };
}

function is_lanes(t: typeinfo.Type): boolean {
  if let typeinfo.TypeLanes(_) = t {
    return true;
  }
  return false;
}

function is_float(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFloat(f) = t {
    return true;
  }
  return false;
}

function is_poly_float(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFloat(f) = t {
    return f.polymorphic;
  }
  return false;
}

function float_label(t: typeinfo.TypeFloat): string {
  if (t.width == 32) {
    return "f32";
  }
  return "f64";
}

function float_operands_agree(a: typeinfo.Type, b: typeinfo.Type): boolean {
  return is_float(a) && is_float(b);
}

function settled_operands(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): (typeinfo.Type, typeinfo.Type) {
  if (is_float(lt) && !is_poly_float(lt) && unsettled_int_literal(b.right)) {
    return (lt, lt);
  }
  if (is_float(rt) && !is_poly_float(rt) && unsettled_int_literal(b.left)) {
    return (rt, rt);
  }
  return (lt, rt);
}

function float_result(a: typeinfo.Type, b: typeinfo.Type): typeinfo.Type {
  if (!float_operands_agree(a, b)) {
    return t_unknown("float operands have incompatible widths");
  }
  if (is_poly_float(a) || typeinfo.lossless_widen(a, b)) {
    return b;
  }
  return a;
}

function is_poly_int(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return i.polymorphic && !i.is_char;
  }
  return false;
}

function join_result_types(a: typeinfo.Type, b: typeinfo.Type): typeinfo.Type {
  if (unbound_enum_argument(a)) {
    return b;
  }
  if (unbound_enum_argument(b)) {
    return a;
  }
  if (integer_literal_widens(a, b) || is_poly_int(a) && is_float(b)) {
    return b;
  }
  if (integer_literal_widens(b, a) || is_poly_int(b) && is_float(a)) {
    return a;
  }
  if let typeinfo.TypeI32(ai) = a {
    if let typeinfo.TypeI32(bi) = b {
      if (type_eq(a, b)) {
        return typeinfo.TypeI32 { ...ai, polymorphic: ai.polymorphic && bi.polymorphic };
      }
    }
  }
  if let typeinfo.TypeUnion(au) = a {
    if let typeinfo.TypeUnion(bu) = b {
      return join_enum_arguments(au, bu);
    }
  }
  if (is_float(a) && is_float(b) && (type_eq(a, b) || is_poly_float(a) || is_poly_float(b))) {
    return float_result(a, b);
  }
  if let typeinfo.TypeTuple(at) = a {
    if let typeinfo.TypeTuple(bt) = b {
      if (at.elements.len() != bt.elements.len()) {
        return t_unknown("result tuple arities differ");
      }
      let elems: typeinfo.Type[] = [];
      let i = 0;
      while (i < at.elements.len()) {
        let elem = join_result_types(at.elements[i], bt.elements[i]);
        if (is_unknown(elem)) {
          return elem;
        }
        elems = elems.append(elem);
        i += 1;
      }
      return t_tuple(elems);
    }
  }
  if (type_eq(a, b)) {
    return a;
  }
  return t_unknown("result types disagree");
}

pub function unbound_enum_argument(t: typeinfo.Type): boolean {
  if let typeinfo.TypeUnknown(u) = t {
    return util.str_has_prefix(u.reason, "unbound ");
  }
  return false;
}

function join_enum_arguments(a: typeinfo.TypeUnion, b: typeinfo.TypeUnion): typeinfo.Type {
  if (a.name != b.name) {
    return t_unknown("result enum names disagree");
  }
  if (a.args.len() == 0) {
    return b;
  }
  if (b.args.len() == 0) {
    return a;
  }
  if (a.args.len() != b.args.len()) {
    return t_unknown("result enum arities differ");
  }
  let args: typeinfo.Type[] = [];
  let i = 0;
  while (i < a.args.len()) {
    let joined = a.args[i];
    if (unbound_enum_argument(joined)) {
      joined = b.args[i];
    } else if (!unbound_enum_argument(b.args[i])) {
      joined = join_result_types(joined, b.args[i]);
      if (is_unknown(joined)) {
        return joined;
      }
    }
    args = args.append(joined);
    i += 1;
  }
  return typeinfo.TypeUnion { name: a.name, args: args };
}

function t_array(elem: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeArray { elem: elem, view: false };
}

function is_sha_hw_builtin(name: string): boolean {
  return name == "__sha256_hw" || name == "__sha1_hw";
}

function byte_kernel_arity(name: string): i32 {
  if (name == "__aes_expand_key") {
    return 1;
  }
  if (name == "__sha256_hw_blocks" || name == "__sha1_hw_blocks") {
    return 2;
  }
  if (name == "__aes_ctr32" || name == "__ghash") {
    return 3;
  }
  return -1;
}

function is_aes_gcm_into(name: string): boolean {
  return name == "__aes_gcm_seal_into" || name == "__aes_gcm_open_into";
}

function t_view(elem: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeArray { elem: elem, view: true };
}

function as_view(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeArray(a) = t {
    return t_view(a.elem);
  }
  return t;
}

function is_arr_view(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return a.view;
  }
  return false;
}

function is_owned_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return !a.view;
  }
  return false;
}

function one_arg_intrinsic_result(name: string): typeinfo.Type {
  if (name == "__socket_from_fd") {
    return t_socket();
  }
  return t_i32();
}

function t_socket(): typeinfo.Type {
  return t_struct("Socket");
}

function t_struct(name: string): typeinfo.Type {
  let noargs: typeinfo.Type[] = [];
  return typeinfo.TypeStruct { name: name, args: noargs };
}

function t_struct_g(name: string, args: typeinfo.Type[]): typeinfo.Type {
  return typeinfo.TypeStruct { name: name, args: args };
}

function t_tuple(elements: typeinfo.Type[]): typeinfo.Type {
  return typeinfo.TypeTuple { elements: elements };
}

function no_diags(): util.Diag[] {
  return [];
}

function t_func(param_types: typeinfo.Type[], ret_type: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeFunc { param_types: param_types, param_own: [], ret_type: ret_type, params_known: true };
}

function t_func_own(param_types: typeinfo.Type[], param_own: boolean[], ret_type: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeFunc { param_types: param_types, param_own: callable_own_flags(param_own, param_types.len()), ret_type: ret_type, params_known: true };
}

function callable_own_flags(flags: boolean[], count: i32): boolean[] {
  let out: boolean[] = [];
  let any = false;
  let i = 0;
  while (i < count) {
    let on = i < flags.len() && flags[i];
    out = out.append(on);
    any = any || on;
    i += 1;
  }
  return if (any) { out } else { [] };
}

function lambda_owns(lm: ast.ExprLambda): boolean[] {
  let owns: boolean[] = [];
  for param in lm.params {
    owns = owns.append(param.own);
  }
  return owns;
}

function t_func_opaque(ret_type: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeFunc { param_types: [], param_own: [], ret_type: ret_type, params_known: false };
}

function t_map(key: typeinfo.Type, value: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeMap { key: key, value: value };
}

function digit_string_to_i32(s: string): i32 {
  let n = s.len();
  if (n == 0) {
    return -1;
  }
  let acc = 0;
  let i = 0;
  while (i < n) {
    let b = s[i] as i32;
    if (b < 48 || b > 57) {
      return -1;
    }
    if (acc > (2147483647 - (b - 48)) / 10) {
      return -1;
    }
    acc = acc * 10 + (b - 48);
    i += 1;
  }
  return acc;
}

function t_union(name: string): typeinfo.Type {
  let noargs: typeinfo.Type[] = [];
  return typeinfo.TypeUnion { name: name, args: noargs };
}

function t_union_g(name: string, args: typeinfo.Type[]): typeinfo.Type {
  return typeinfo.TypeUnion { name: name, args: args };
}

function canon_trait_set(traits: string): string {
  let names: string[] = [];
  for n in parser.dyn_trait_set("dyn " + traits) {
    names = push_str_unique_sorted(names, n);
  }
  let out = "";
  let i = 0;
  while (i < names.len()) {
    if (i > 0) {
      out += " + ";
    }
    out += names[i];
    i += 1;
  }
  return out;
}

function names_resource_handle(name: string, tn: TypeNames): boolean {
  return tn.resources.names.len() > 0 && tn.resources.has(handle_resource(name));
}

function handle_resource(name: string): string {
  if (name.len() > 4 && slice_unchecked(name, 0, 4) == "own ") {
    return slice_unchecked(name, 4, name.len()) + "";
  }
  if (name.len() > 7 && slice_unchecked(name, 0, 7) == "borrow ") {
    return slice_unchecked(name, 7, name.len()) + "";
  }
  return name;
}

function resource_handle(name: string): typeinfo.Type {
  let borrowed = name.len() > 7 && slice_unchecked(name, 0, 7) == "borrow ";
  return typeinfo.TypeHandle { resource: handle_resource(name), borrowed: borrowed };
}

function t_dyn(traits: string): typeinfo.Type {
  return typeinfo.TypeDyn { traits: canon_trait_set(traits) };
}

function t_void(): typeinfo.Type {
  return typeinfo.TypeVoid { tag: 0 };
}

function t_unknown(reason: string): typeinfo.Type {
  return typeinfo.TypeUnknown { reason: reason };
}

function is_cell_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(s) = t {
    return s.name == "Cell";
  }
  return false;
}

function cell_elem_type(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeStruct(s) = t {
    if (s.args.len() == 1) {
      return s.args[0];
    }
  }
  return t_unknown("cell element");
}

function is_cell_ref(r: parser.TypeRef): boolean {
  return r.base == "Cell" && r.args.len() == 1;
}

function is_map_ref(r: parser.TypeRef): boolean {
  return r.base == "Map" && r.args.len() == 2;
}

function is_wide_map_ref(r: parser.TypeRef): boolean {
  return r.base == "Map" && r.args.len() > 2;
}

function cell_method_type(recv: typeinfo.Type, name: string, argc: i32): typeinfo.Type {
  if (!is_cell_type(recv)) {
    return t_unknown("not a cell method call");
  }
  if (name == "get" && argc == 0) {
    return cell_elem_type(recv);
  }
  if (name == "set" && argc == 1) {
    return t_void();
  }
  return t_unknown("not a cell method");
}

function is_f64_primitive(name: string): boolean {
  let names: string[] = [
    "__sqrt_f64", "__floor_f64", "__ceil_f64", "__round_f64", "__trunc_f64",
    "__abs_f64",
  ];
  for n in names {
    if (n == name) {
      return true;
    }
  }
  return false;
}

function is_lane_builtin(name: string): boolean {
  let names: string[] = [
    "__f64x2_splat", "__f64x2_of", "__f64x2_lane", "__f64x2_bitmask", "__f64x2_mul_add", "__f64x2_sqrt",
    "__f64x2_abs", "__f64x2_floor", "__f64x2_round", "__f64x2_min", "__f64x2_max",
    "__f64x2_lt", "__f64x2_ne", "__f64x2_select", "__f64x2_load", "__f64x2_with",
    "__f32x4_splat", "__f32x4_of", "__f32x4_lane", "__f32x4_bitmask", "__f32x4_mul_add", "__f32x4_sqrt",
    "__f32x4_abs", "__f32x4_floor", "__f32x4_round", "__f32x4_min", "__f32x4_max",
    "__f32x4_lt", "__f32x4_ne", "__f32x4_select", "__f32x4_load", "__f32x4_with",
  ];
  return typeinfo.lane_builtin_width(name) > 0 && util.has_str(names, name);
}

function is_bit_count(name: string): boolean {
  let names: string[] = ["__clz32", "__ctz32", "__popcount32", "__clz64", "__ctz64", "__popcount64"];
  for n in names {
    if (n == name) {
      return true;
    }
  }
  return false;
}

function internal_name(name: string): boolean {
  return name.len() > 2 && name[0] == b'_' && name[1] == b'_';
}

function intrinsic_result(name: string, argc: i32, t: SigTable): typeinfo.Type {
  if (!internal_name(name)) {
    return t_unknown("not a runtime intrinsic");
  }
  let at = raw_floor_at(t, name);
  if (at >= 0 && raw_floor_allowed(t, name) && t.raw[at].params.len() == argc) {
    return t.raw[at].result;
  }
  if (argc == 1 && is_f64_primitive(name)) {
    return t_float();
  }
  if (is_lane_builtin(name) && argc == typeinfo.lane_builtin_params(name).len()) {
    return typeinfo.lane_builtin_result(name);
  }
  if (argc == 1 && is_bit_count(name)) {
    return t_i32();
  }
  if (argc == 2 && name == "__mulhi_u64") {
    return t_u64();
  }
  if (argc == 1 && name == "__alloc") {
    return t_usize();
  }
  if (argc == 1 && name == "__alloc_u8") {
    return typeinfo.TypeArray { elem: t_u8(), view: false };
  }
  if (argc == 1 && name == "__alloc_i32") {
    return typeinfo.TypeArray { elem: t_i32(), view: false };
  }
  if (argc == 1 && name == "__alloc_i64") {
    return typeinfo.TypeArray { elem: t_i64(), view: false };
  }
  if (argc == 1 && name == "__alloc_bool") {
    return typeinfo.TypeArray { elem: t_bool(), view: false };
  }
  if (argc == 2 && name == "__free") {
    return t_void();
  }
  if (argc == 2 && name == "__fern_box_free") {
    return t_usize();
  }
  if (argc == 0 && name == "__ptr_width") {
    return t_i32();
  }
  if (argc == 0 && name == "__map_hash_seed") {
    return t_i32();
  }
  if (argc == 0 && name == "__heap_bump_bytes") {
    return t_i64();
  }
  if (argc == 0 && name == "__heap_alloc_count") {
    return t_i64();
  }
  if (argc == 1 && (name == "__ct_secret" || name == "__ct_public")) {
    return t_void();
  }
  if (argc == 1 && name == "__bytes_owned" || argc == 3 && name == "__bytes_range" || argc == 5 && name == "__bytes_into") {
    return t_array(t_u8());
  }
  if (argc == byte_kernel_arity(name) || argc == 9 && is_aes_gcm_into(name)) {
    return t_array(t_u8());
  }
  if (argc == 0 && is_sha_hw_builtin(name)) {
    return t_bool();
  }
  if (argc == 0 && name == "__task_new") {
    return t_i32();
  }
  if (argc == 1 && name == "__task_free") {
    return t_void();
  }
  if (argc == 0 && name == "__task_cur") {
    return t_i32();
  }
  return intrinsic_result_task(name, argc);
}

// The runtime builtins behind a process worker: region allocation, heap
// adoption, child exit, result transfer, and region reclamation.
function is_worker_builtin(name: string): boolean {
  return name == "__heap_adopt" || name == "__worker_region" || name == "__worker_exit" || name == "__worker_reap" || name == "__worker_unmap";
}

function worker_params(name: string): typeinfo.Type[] {
  if (name == "__worker_unmap") {
    return [t_i64(), t_i64(), t_bool()];
  }
  if (name == "__heap_adopt") {
    return [t_i64(), t_i64()];
  }
  if (name == "__worker_exit") {
    return [t_i64(), t_usize()];
  }
  return [t_i64()];
}

function worker_result(name: string): typeinfo.Type {
  if (name == "__worker_unmap") {
    return t_i32();
  }
  if (name == "__worker_region") {
    return t_i64();
  }
  if (name == "__worker_reap") {
    return t_usize();
  }
  return t_void();
}

function intrinsic_result_task(name: string, argc: i32): typeinfo.Type {
  if (argc == 2 && name == "__task_enter") {
    return t_void();
  }
  if (argc == 0 && name == "__task_leave") {
    return t_i32();
  }
  if (argc == 2 && (name == "__task_park" || name == "__task_park_until")) {
    return t_i32();
  }
  if (argc == 1 && name == "__task_wait") {
    return t_array(t_i32());
  }
  if (argc == 1 && name == "__task_timeout") {
    return t_i32();
  }
  if (argc == 1 && name == "__task_until") {
    return t_i64();
  }
  if (argc == 2 && name == "__task_set_ready") {
    return t_void();
  }
  if (argc == 1 && name == "__task_set_cancelled") {
    return t_void();
  }
  if (argc == 0 && name == "__task_cancelled") {
    return t_i32();
  }
  if (argc == 0 && name == "__heap_mark") {
    return t_i64();
  }
  if (argc == 1 && name == "__heap_release_to") {
    return t_void();
  }
  if (is_worker_builtin(name) && argc == worker_params(name).len()) {
    return worker_result(name);
  }
  if (argc == 0 && name == "__rc_underflow_count") {
    return t_i32();
  }
  if (argc == 0 && name == "__arr_push_shared_count") {
    return t_i32();
  }
  if (argc == 0 && name == "__arr_push_shared_bytes") {
    return t_i64();
  }
  if (argc == 1 && name == "__rc_inc") {
    return typeinfo.TypeArray { elem: t_u8(), view: false };
  }
  if (argc == 1 && name == "__rc_dec") {
    return t_void();
  }
  if (argc == 1 && name == "__rc_get") {
    return t_i32();
  }
  if (argc == 3 && name == "__alloc_reuse") {
    return t_usize();
  }
  if (argc == 3 && name == "__memcpy") {
    return t_void();
  }
  if (argc == 3 && name == "__memset") {
    return t_void();
  }
  if (argc == 1 && name == "__load_u8") {
    return t_i32();
  }
  if (argc == 2 && name == "__account_entry") {
    return t_usize();
  }
  if (argc == 1 && name == "__load_i32") {
    return t_i32();
  }
  if (argc == 1 && name == "__load_i64") {
    return t_i64();
  }
  if (argc == 1 && name == "__load_ptr") {
    return t_usize();
  }
  return intrinsic_result_memory(name, argc);
}

function intrinsic_result_memory(name: string, argc: i32): typeinfo.Type {
  if (argc == 2 && util.has_str(["__store_u8", "__arr_set_len", "__store_i32", "__store_i64", "__store_ptr"], name)) {
    return t_void();
  }
  if (argc == 2 && name == "__str_bytes") {
    return t_usize();
  }
  if (device_intrinsic(name)) {
    return mmio_result(name);
  }
  if (argc == 5 && (name == "__mismatch" || name == "__mismatch_bytes" || name == "__mismatch_bytes_str")) {
    return t_i32();
  }
  if (argc == 1 && util.has_str(["__sum_bytes", "__fd_close", "__tcp_close_unchecked", "__socket_from_fd"], name)) {
    return one_arg_intrinsic_result(name);
  }
  if (argc == 2 && (name == "__scale_f64" || name == "__outer_mul_f64")) {
    return t_array(t_float());
  }
  if (argc == 6 && name == "__inner_mul_add_f64") {
    return t_array(t_float());
  }
  if (argc == 2 && util.has_str(["__ascii_run", "__bsd_sum", "__str_hash", "__count_byte", "__crc32_cksum", "__crc32_cksum_array", "__crc32_ieee_array", "__count_byte_bytes", "__count_below_u64", "__bsd_sum_bytes"], name)) {
    return t_i32();
  }
  if (argc == 3 && util.has_str(["__scan_set", "__scan_set_bytes", "__count_runs", "__count_runs_bytes", "__memchr", "__memchr_bytes", "__rmemchr_bytes", "__rmemchr"], name)) {
    return t_i32();
  }
  if (argc == 1 && name == "__sum_bytes_array") {
    return t_i32();
  }
  if (argc == 1 && (name == "__fern_rc_inc" || name == "__fern_str_dec")) {
    return t_usize();
  }
  if (argc == 2 && (name == "__fern_arr_dec" || name == "__fern_drop_arr_ptr")) {
    return t_usize();
  }
  return t_unknown("not a runtime intrinsic");
}

function builtin_result_type(recv: typeinfo.Type, name: string, is_method: boolean, argc: i32, s: Scope): typeinfo.Type {
  if (is_method) {
    return cell_method_type(recv, name, argc);
  }
  if ((util.str_has_prefix(name, "__raw_") || util.str_has_prefix(name, "__syscall"))
    && (s.defines(name) || s.has_sig(name))) {
    return t_unknown("a declared callable shadows the raw floor");
  }
  return intrinsic_result(name, argc, s.sigs);
}

function intrinsic_params(name: string, t: SigTable): (typeinfo.Type[], boolean) {
  if (!internal_name(name)) {
    return ([], false);
  }
  let at = raw_floor_at(t, name);
  if (at >= 0 && raw_floor_allowed(t, name)) {
    return (t.raw[at].params, true);
  }
  if (is_f64_primitive(name)) {
    return ([t_float()], true);
  }
  if (is_lane_builtin(name)) {
    return (typeinfo.lane_builtin_params(name), true);
  }
  if (name == "__clz32" || name == "__ctz32" || name == "__popcount32") {
    return ([t_u32()], true);
  }
  if (name == "__clz64" || name == "__ctz64" || name == "__popcount64") {
    return ([t_u64()], true);
  }
  if (name == "__mulhi_u64") {
    return ([t_u64(), t_u64()], true);
  }
  if (util.has_str(["__alloc", "__fd_close", "__socket_from_fd"], name)) {
    return ([t_i32()], true);
  }
  if (name == "__alloc_u8" || name == "__alloc_i32" || name == "__alloc_i64" || name == "__alloc_bool") {
    return ([t_i32()], true);
  }
  if (name == "__free") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__fern_box_free") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__ptr_width") {
    return ([], true);
  }
  if (name == "__map_hash_seed") {
    return ([], true);
  }
  if (name == "__heap_bump_bytes") {
    return ([], true);
  }
  if (name == "__heap_alloc_count") {
    return ([], true);
  }
  if (name == "__ct_secret" || name == "__ct_public" || name == "__bytes_owned") {
    return ([t_view(t_u8())], true);
  }
  if (name == "__bytes_range") {
    return ([t_view(t_u8()), t_i32(), t_i32()], true);
  }
  if (name == "__bytes_into") {
    return ([t_array(t_u8()), t_i32(), t_view(t_u8()), t_i32(), t_i32()], true);
  }
  if (is_sha_hw_builtin(name)) {
    return ([], true);
  }
  if (is_aes_gcm_into(name)) {
    return ([t_view(t_u8()), t_view(t_u8()), t_view(t_u8()), t_u64(), t_array(t_u8()), t_i32(), t_i32(), t_i32(), t_i32()], true);
  }
  if (byte_kernel_arity(name) > 0) {
    let views: typeinfo.Type[] = [];
    while (views.len() < byte_kernel_arity(name)) {
      views = views.append(t_view(t_u8()));
    }
    return (views, true);
  }
  if (name == "__task_new") {
    return ([], true);
  }
  if (name == "__task_free") {
    return ([t_i32()], true);
  }
  if (name == "__task_cur") {
    return ([], true);
  }
  if (name == "__task_enter") {
    return ([t_i32(), t_i32()], true);
  }
  if (name == "__task_leave") {
    return ([], true);
  }
  if (name == "__task_park") {
    return ([t_array(t_i32()), t_i32()], true);
  }
  if (name == "__task_park_until") {
    return ([t_array(t_i32()), t_i64()], true);
  }
  if (name == "__task_wait") {
    return ([t_i32()], true);
  }
  if (name == "__task_timeout" || name == "__task_until") {
    return ([t_i32()], true);
  }
  if (name == "__task_set_ready") {
    return ([t_i32(), t_i32()], true);
  }
  if (name == "__task_set_cancelled") {
    return ([t_i32()], true);
  }
  if (name == "__task_cancelled") {
    return ([], true);
  }
  if (name == "__heap_mark") {
    return ([], true);
  }
  if (name == "__heap_release_to") {
    return ([t_i64()], true);
  }
  if (is_worker_builtin(name)) {
    return (worker_params(name), true);
  }
  if (name == "__rc_underflow_count" || name == "__arr_push_shared_count" || name == "__arr_push_shared_bytes") {
    return ([], true);
  }
  if (name == "__rc_inc" || name == "__rc_dec" || name == "__rc_get") {
    return ([t_array(t_u8())], true);
  }
  if (name == "__alloc_reuse") {
    return ([t_usize(), t_i32(), t_i32()], true);
  }
  if (name == "__memcpy") {
    return ([t_usize(), t_usize(), t_i32()], true);
  }
  if (name == "__memset") {
    return ([t_usize(), t_i32(), t_i32()], true);
  }
  if (name == "__load_u8" || name == "__load_i32" || name == "__load_i64" || name == "__load_ptr") {
    return ([t_usize()], true);
  }
  if (device_intrinsic(name)) {
    return (mmio_params(name), true);
  }
  if (name == "__store_u8") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__account_entry") {
    return ([t_i32(), t_usize()], true);
  }
  if (name == "__str_bytes") {
    return ([t_string(), t_usize()], true);
  }
  if (name == "__arr_set_len") {
    return ([t_array(t_u8()), t_i32()], true);
  }
  if (name == "__store_i32") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__store_i64") {
    return ([t_usize(), t_i64()], true);
  }
  if (name == "__store_ptr") {
    return ([t_usize(), t_usize()], true);
  }
  if (name == "__mismatch") {
    return ([t_string(), t_i32(), t_string(), t_i32(), t_i32()], true);
  }
  if (name == "__mismatch_bytes") {
    return ([t_view(t_u8()), t_i32(), t_view(t_u8()), t_i32(), t_i32()], true);
  }
  if (name == "__mismatch_bytes_str") {
    return ([t_array(t_u8()), t_i32(), t_string(), t_i32(), t_i32()], true);
  }
  if (name == "__sum_bytes") {
    return ([t_string()], true);
  }
  if (name == "__scale_f64") {
    return ([t_array(t_float()), t_float()], true);
  }
  if (name == "__outer_mul_f64") {
    return ([t_array(t_float()), t_array(t_float())], true);
  }
  if (name == "__inner_mul_add_f64") {
    return ([t_array(t_float()), t_array(t_float()), t_i32(), t_i32(), t_i32(), t_float()], true);
  }
  if (name == "__ascii_run") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__scan_set") {
    return ([t_string(), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__scan_set_bytes") {
    return ([t_array(t_u8()), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__count_runs") {
    return ([t_string(), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__count_runs_bytes") {
    return ([t_array(t_u8()), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__bsd_sum") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__str_hash") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__tcp_close_unchecked") {
    return ([t_socket()], true);
  }
  if (name == "__count_byte") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__crc32_cksum") {
    return ([t_i32(), t_string()], true);
  }
  if (name == "__crc32_cksum_array" || name == "__crc32_ieee_array") {
    return ([t_i32(), t_view(t_u8())], true);
  }
  if (name == "__memchr" || name == "__rmemchr") {
    return ([t_string(), t_i32(), t_i32()], true);
  }
  if (name == "__count_byte_bytes") {
    return ([t_array(t_u8()), t_i32()], true);
  }
  if (name == "__count_below_u64") {
    return ([t_array(t_u64()), t_u64()], true);
  }
  if (name == "__sum_bytes_array") {
    return ([t_view(t_u8())], true);
  }
  if (name == "__bsd_sum_bytes") {
    return ([t_view(t_u8()), t_i32()], true);
  }
  if (name == "__memchr_bytes" || name == "__rmemchr_bytes") {
    return ([t_array(t_u8()), t_i32(), t_i32()], true);
  }
  if (name == "__fern_rc_inc") {
    return ([t_usize()], true);
  }
  if (name == "__fern_str_dec") {
    return ([t_string()], true);
  }
  if (name == "__fern_arr_dec") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__fern_drop_arr_ptr") {
    return ([t_usize(), t_i32()], true);
  }
  return ([], false);
}

// An intrinsic that reaches a device: an MMIO or port access, __fence, or a
// privileged op. No pass removes, merges or moves one.
pub function device_intrinsic(name: string): boolean {
  return mmio_width(name) > 0 || port_intrinsic(name) || name == "__fence" || privileged_intrinsic(name);
}

// A port access: __port_in8 to __port_in32 read a port, and __port_out8 to
// __port_out32 write one. Only x86-64 has an I/O port space.
pub function port_intrinsic(name: string): boolean {
  return util.has_str(["__port_in8", "__port_in16", "__port_in32", "__port_out8", "__port_out16", "__port_out32"], name);
}

// A privileged op that only a kernel environment grants. __hvc and __smc call
// the hypervisor and the secure monitor in the SMC calling convention.
// __boot_info gives the address that the loader passed to the reset entry.
pub function privileged_intrinsic(name: string): boolean {
  return name == "__wfi" || name == "__hvc" || name == "__smc" || name == "__boot_info";
}

// The bit width of an MMIO intrinsic, such as 32 for __mmio_load32, or 0 for any
// other name.
pub function mmio_width(name: string): i32 {
  if (!util.str_has_prefix(name, "__mmio_")) {
    return 0;
  }
  if (name == "__mmio_load8" || name == "__mmio_store8") {
    return 8;
  }
  if (name == "__mmio_load16" || name == "__mmio_store16") {
    return 16;
  }
  if (name == "__mmio_load32" || name == "__mmio_store32") {
    return 32;
  }
  if (name == "__mmio_load64" || name == "__mmio_store64") {
    return 64;
  }
  return 0;
}

function mmio_result(name: string): typeinfo.Type {
  if (util.str_has_prefix(name, "__mmio_store") || util.str_has_prefix(name, "__port_out") || name == "__fence" || name == "__wfi") {
    return t_void();
  }
  if (name == "__boot_info") {
    return t_usize();
  }
  if (mmio_width(name) == 64 || privileged_intrinsic(name)) {
    return t_i64();
  }
  return t_i32();
}

function mmio_params(name: string): typeinfo.Type[] {
  if (name == "__fence" || name == "__wfi" || name == "__boot_info") {
    return [];
  }
  if (privileged_intrinsic(name)) {
    return [t_i64(), t_i64(), t_i64(), t_i64()];
  }
  if (util.str_has_prefix(name, "__port_out")) {
    return [t_i32(), t_i32()];
  }
  if (util.str_has_prefix(name, "__port_in")) {
    return [t_i32()];
  }
  let value = t_i32();
  if (mmio_width(name) == 64) {
    value = t_i64();
  }
  if (util.str_has_prefix(name, "__mmio_store")) {
    return [t_usize(), value];
  }
  return [t_usize()];
}

pub struct RawFloorSig { name: string, params: typeinfo.Type[], result: typeinfo.Type }

pub function raw_floor_sigs(): RawFloorSig[] {
  let p = t_usize();
  let n = t_i32();
  let w = t_i64();
  return [
    RawFloorSig { name: "__raw_alloc", params: [n], result: p },
    RawFloorSig { name: "__raw_store8", params: [p, n, n], result: t_void() },
    RawFloorSig { name: "__raw_load8", params: [p, n], result: n },
    RawFloorSig { name: "__raw_store_ptr", params: [p, n, p], result: t_void() },
    RawFloorSig { name: "__raw_load_ptr", params: [p, n], result: p },
    RawFloorSig { name: "__raw_string", params: [p, n], result: t_string() },
    RawFloorSig { name: "__raw_array", params: [p], result: typeinfo.TypeArray { elem: n, view: false } },
    RawFloorSig { name: "__raw_arr_ptr", params: [typeinfo.TypeArray { elem: n, view: false }], result: p },
    RawFloorSig { name: "__raw_data", params: [t_string()], result: p },
    RawFloorSig { name: "__raw_arr_box", params: [n], result: p },
    RawFloorSig { name: "__raw_scratch", params: [n], result: p },
    RawFloorSig { name: "__raw_environ", params: [], result: p },
    RawFloorSig { name: "__raw_splice_pipe", params: [], result: p },
    RawFloorSig { name: "__raw_cover", params: [], result: p },
    RawFloorSig { name: "__raw_task_state", params: [], result: p },
    RawFloorSig { name: "__raw_vdso", params: [], result: p },
    RawFloorSig { name: "__raw_call1", params: [p, p], result: n },
    RawFloorSig { name: "__raw_call2", params: [p, p, p], result: n },
    RawFloorSig { name: "__fern_str_eq", params: [p, p], result: t_bool() },
    RawFloorSig { name: "__fern_str_free", params: [p], result: t_void() },
    RawFloorSig { name: "__fern_str_arr_free", params: [p], result: t_void() },
    RawFloorSig { name: "__fern_rc_dec", params: [p], result: t_void() },
    RawFloorSig { name: "__fern_slice_abort", params: [], result: t_void() },
    RawFloorSig { name: "__fern_oob_abort", params: [], result: t_void() },
    RawFloorSig { name: "__fern_str_oob_abort", params: [], result: t_void() },
    RawFloorSig { name: "__fern_vdso_clock", params: [], result: p },
    RawFloorSig { name: "__syscall3", params: [n, w, w, w], result: w },
    RawFloorSig { name: "__syscall4", params: [n, w, w, w, w], result: w },
    RawFloorSig { name: "__syscall5", params: [n, w, w, w, w, w], result: w },
    RawFloorSig { name: "__syscall6", params: [n, w, w, w, w, w, w], result: w },
    RawFloorSig { name: "__raw_vg_request", params: [p], result: w },
    RawFloorSig { name: "__raw_utf8_blocks", params: [p, n, n], result: n },
  ];
}

function raw_floor_allowed(t: SigTable, name: string): boolean {
  return t.raw_allowed || name == "__fern_rc_dec";
}

function raw_floor_at(t: SigTable, name: string): i32 {
  if (!util.str_has_prefix(name, "__raw_") && !util.str_has_prefix(name, "__syscall") && !util.str_has_prefix(name, "__fern_")) {
    return -1;
  }
  let i = 0;
  while (i < t.raw.len()) {
    if (t.raw[i].name == name) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function lane_index_diags(name: string, c: ast.ExprCall): util.Diag[] {
  if (c.args.len() != 2 || !is_lane_builtin(name) || typeinfo.lane_builtin_verb(name) != "lane") {
    return [];
  }
  let lanes = 128 / typeinfo.lane_builtin_width(name);
  if let ast.ExprNumber(n) = c.args[1] {
    let start = 0;
    if (parser.is_hex_lit(n.text)) {
      start = 2;
    }
    if (!n.is_float && !parser.is_quoted_literal(n) && parser.magnitude_fits(n.text, start, util.i32_to_string(lanes - 1))) {
      return [];
    }
  }
  return [dg_at("E038", "argument 2 to \"" + name + "\": the lane index is an integer literal from 0 to " + util.i32_to_string(lanes - 1), expr_line(c.args[1]), expr_col(c.args[1]))];
}

function free_builtin_sig(name: string, s: Scope): typeinfo.Type {
  let (params, known) = intrinsic_params(name, s.sigs);
  if (known) {
    return t_func(params, intrinsic_result(name, params.len(), s.sigs));
  }
  if (is_display_builtin(name)) {
    return t_unknown("a Display builtin");
  }
  return builtin_sig(name);
}

pub function type_debug(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(x) => {
      return int_label(x);
    },
    typeinfo.TypeBool(_) => {
      return "bool";
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    typeinfo.TypeArray(a) => {
      return "array<" + type_debug(a.elem) + ">";
    },
    typeinfo.TypeStruct(st) => {
      return "struct:" + st.name;
    },
    typeinfo.TypeTuple(tp) => {
      let out = "tuple<";
      let i = 0;
      while (i < tp.elements.len()) {
        if (i > 0) {
          out += ", ";
        }
        out += type_debug(tp.elements[i]);
        i += 1;
      }
      return out + ">";
    },
    typeinfo.TypeFunc(f) => {
      return "fn";
    },
    typeinfo.TypeMap(m) => {
      return "map<" + type_debug(m.key) + ", " + type_debug(m.value) + ">";
    },
    typeinfo.TypeUnion(u) => {
      return "union:" + u.name;
    },
    typeinfo.TypeDyn(d) => {
      return "dyn:" + d.traits;
    },
    typeinfo.TypeHandle(h) => {
      return "handle:" + typeinfo.handle_spelling(h);
    },
    typeinfo.TypeVoid(_) => {
      return "void";
    },
    typeinfo.TypeNever(_) => {
      return "never";
    },
    typeinfo.TypeConst(c) => {
      return c.value;
    },
    typeinfo.TypeUnknown(uk) => {
      return "unknown(" + uk.reason + ")";
    },
    typeinfo.TypeErased(e) => {
      return "erased(" + e.name + ")";
    }
  }
  return "?";
}

function is_integer(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(i) => {
      return !i.is_char;
    },
    _ => {
      return false;
    }
  }
}

function int_operands_agree(lt: typeinfo.Type, rt: typeinfo.Type, le: ast.Expr, re: ast.Expr): boolean {
  if (int_literal_tree(le) || int_literal_tree(re)) {
    return true;
  }
  if (is_usize(lt) || is_usize(rt)) {
    return true;
  }
  return int_is_unsigned(lt) == int_is_unsigned(rt) || !is_unknown(typeinfo.mixed_integer_join(lt, rt));
}

function int_is_unsigned(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(i) => {
      return i.unsigned;
    },
    _ => {
      return false;
    }
  }
}

function mixed_int_diag(op: string, lt: typeinfo.Type, rt: typeinfo.Type, line: i32, col: i32): util.Diag {
  return dg_at(
    "E009", "operator \"" + op + "\" requires both operands to share an integer type; got "
      + type_label(lt) + " and " + type_label(rt) + " — use `as` for explicit conversion",
    line, col,
  );
}

function numeric_operand_diags(op: string, lt: typeinfo.Type, rt: typeinfo.Type, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let want_float = op != "%" && (is_float(lt) || is_float(rt));
  if (want_float && is_float(lt) && is_float(rt)) {
    return [dg_at("E009", "operator \"" + op + "\" requires both operands to share a float type; got " + type_label(lt) + " and " + type_label(rt) + " — use `as` for explicit conversion", line, col)];
  }
  for operand in [lt, rt] {
    let msg = "";
    if (want_float && !is_float(operand)) {
      msg = "operator \"" + op + "\" requires float, got " + type_label(operand);
    } else if (!want_float && !is_integer(operand)) {
      msg = "operator \"" + op + "\" requires an integer type, got " + type_label(operand);
    }
    if (msg.len() > 0 && (out.len() == 0 || out[0].message != msg)) {
      out = out.append(dg_at("E009", msg, line, col));
    }
  }
  return out;
}

function int_result(lt: typeinfo.Type, rt: typeinfo.Type, le: ast.Expr, re: ast.Expr): typeinfo.Type {
  if (int_literal_tree(le) && !int_literal_tree(re)) {
    return rt;
  }
  if (int_literal_tree(re) && !int_literal_tree(le)) {
    return lt;
  }
  if (unsettled_int_literal(le)) {
    return rt;
  }
  return wider_int(lt, rt);
}

function wider_int(lt: typeinfo.Type, rt: typeinfo.Type): typeinfo.Type {
  let mixed = typeinfo.mixed_integer_join(lt, rt);
  if (!is_unknown(mixed)) {
    return mixed;
  }
  if (is_usize(lt)) {
    return lt;
  }
  if (is_usize(rt)) {
    return rt;
  }
  match (lt) {
    typeinfo.TypeI32(li) => {
      match (rt) {
        typeinfo.TypeI32(ri) => {
          if (ri.width > li.width) {
            return rt;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return lt;
}

function type_eq(a: typeinfo.Type, b: typeinfo.Type): boolean {
  match (a) {
    typeinfo.TypeI32(ai) => {
      match (b) {
        typeinfo.TypeI32(bi) => {
          return ai.is_char == bi.is_char && ai.width == bi.width && ai.unsigned == bi.unsigned;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeBool(_) => {
      match (b) {
        typeinfo.TypeBool(_) => {
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeString(_) => {
      match (b) {
        typeinfo.TypeString(_) => {
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeFloat(af) => {
      match (b) {
        typeinfo.TypeFloat(bf) => {
          return af.width == bf.width;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeLanes(al) => {
      match (b) {
        typeinfo.TypeLanes(bl) => {
          return al.width == bl.width;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeArray(ae) => {
      match (b) {
        typeinfo.TypeArray(be) => {
          return type_eq(ae.elem, be.elem);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeStruct(an) => {
      match (b) {
        typeinfo.TypeStruct(bn) => {
          return an.name == bn.name;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeTuple(at) => {
      match (b) {
        typeinfo.TypeTuple(bt) => {
          if (at.elements.len() != bt.elements.len()) {
            return false;
          }
          let i = 0;
          while (i < at.elements.len()) {
            if (!type_eq(at.elements[i], bt.elements[i])) {
              return false;
            }
            i += 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeFunc(af) => {
      match (b) {
        typeinfo.TypeFunc(bf) => {
          if (af.param_types.len() != bf.param_types.len()) {
            return false;
          }
          if (!type_eq(af.ret_type, bf.ret_type)) {
            return false;
          }
          let fi = 0;
          while (fi < af.param_types.len()) {
            if (!type_eq(af.param_types[fi], bf.param_types[fi])) {
              return false;
            }
            fi += 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeMap(am) => {
      match (b) {
        typeinfo.TypeMap(bm) => {
          return type_eq(am.key, bm.key) && type_eq(am.value, bm.value);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeUnion(an) => {
      match (b) {
        typeinfo.TypeUnion(bn) => {
          return an.name == bn.name;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeDyn(ad) => {
      match (b) {
        typeinfo.TypeDyn(bd) => {
          return ad.traits == bd.traits;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeHandle(ah) => {
      if let typeinfo.TypeHandle(bh) = b {
        return ah.resource == bh.resource && ah.borrowed == bh.borrowed;
      }
      return false;
    },
    typeinfo.TypeVoid(_) => {
      match (b) {
        typeinfo.TypeVoid(_) => {
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeUnknown(_) => {
      return false;
    },
    typeinfo.TypeNever(_) => {
      if let typeinfo.TypeNever(_) = b {
        return true;
      }
      return false;
    },
    typeinfo.TypeConst(ac) => {
      if let typeinfo.TypeConst(bc) = b {
        return ac.value == bc.value;
      }
      return false;
    },
    typeinfo.TypeErased(ae) => {
      if let typeinfo.TypeErased(be) = b {
        return ae.name == be.name;
      }
      return false;
    }
  }
  return false;
}

function is_unknown(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_void(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeVoid(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_func_type(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeFunc(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_tuple_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  return false;
}

function type_contains_unknown(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return !unbound_enum_argument(t);
    },
    typeinfo.TypeArray(ae) => {
      return type_contains_unknown(ae.elem);
    },
    typeinfo.TypeTuple(tt) => {
      for element in tt.elements {
        if (type_contains_unknown(element)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeMap(m) => {
      return type_contains_unknown(m.key) || type_contains_unknown(m.value);
    },
    typeinfo.TypeStruct(sn) => {
      for arg in sn.args {
        if (type_contains_unknown(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        if (type_contains_unknown(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeFunc(f) => {
      if (type_contains_unknown(f.ret_type)) {
        return true;
      }
      for param_type in f.param_types {
        if (type_contains_unknown(param_type)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_composite_type(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeStruct(_) => {
      return true;
    },
    typeinfo.TypeUnion(_) => {
      return true;
    },
    typeinfo.TypeArray(_) => {
      return true;
    },
    typeinfo.TypeTuple(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function cmp_method_receiver(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeStruct(st) => {
      return st.name;
    },
    typeinfo.TypeUnion(u) => {
      return u.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// cmp_parts gives the parts of a type that core/cmp compares structurally.
function cmp_parts(t: typeinfo.Type): Option[typeinfo.Type[]] {
  match (t) {
    typeinfo.TypeUnion(u) => {
      if (u.name == "Option" || u.name == "Result") {
        return Some(u.args);
      }
    },
    typeinfo.TypeArray(a) => {
      if (!a.view) {
        return Some([a.elem]);
      }
    },
    typeinfo.TypeTuple(tup) => {
      return Some(tup.elements);
    },
    _ => {}
  }
  return None;
}

// True when `a` and `b` are arrays at the same depths, each of them owned or
// a view on both sides. The rest of the type `type_eq` decides.
function same_views(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(x) = a {
    if let typeinfo.TypeArray(y) = b {
      return x.view == y.view && same_views(x.elem, y.elem);
    }
  }
  return true;
}

// cmp_hint says where a cmp trait for t can come from. core/cmp implements Eq,
// Ord and Hash for Option, Result, owned arrays and tuples when their parts
// do, so the hint moves to the first part that is not a scalar, or else asks
// for the import. A type that no module can implement the trait for gets
// advice on its parts, not an impl that the orphan rule refuses.
function cmp_hint(t: typeinfo.Type, trait_name: string): string {
  let short = slice_unchecked(trait_name, 4, trait_name.len()) + "";
  let label = util.demangle(type_label(t));
  let parts = cmp_parts(t);
  if (trait_name != "cmp.Display") {
    if let Some(ps) = parts {
      for a in ps {
        if (cmp_method_receiver(a) != "" || cmp_parts(a).is_some()) {
          return label + " implements `" + short + "` when its parts do: " + cmp_hint(a, trait_name);
        }
      }
      return label + " implements `" + short + "` in core/cmp: add `import \"core/cmp\";`";
    }
  }
  let recv = cmp_method_receiver(t);
  if ((recv == "" || parts.is_some()) && trait_name != "cmp.Display") {
    return label + " cannot implement `" + short + "`: compare its parts instead";
  }
  if (recv == "" || parts.is_some()) {
    return label + " cannot implement `" + short + "`: convert its parts to strings first";
  }
  return util.derive_hint(recv, trait_name, trait_name);
}

// has_cmp_method says whether t has the `eq` or the `cmp` method that `==` or
// an order calls.
function (s: Scope) has_cmp_method(verb: string, t: typeinfo.Type): boolean {
  let found: Option[MethodSig] = None;
  if let typeinfo.TypeArray(a) = t {
    found = s.array_recv_method(verb, a.view);
  } else if (receiver_key(t) != "") {
    found = s.lookup_method(verb, receiver_key(t));
  }
  if let Some(m) = found {
    return impl_of_holds(s, t, m.impl_trait);
  }
  return false;
}

function (s: Scope) binop_overload_ret(op: string, lt: typeinfo.Type): typeinfo.Type {
  return s.overload_ret(ast.operator_method(op), lt);
}

function (s: Scope) unop_overload_ret(op: string, ot: typeinfo.Type): typeinfo.Type {
  if (op != "-") {
    return t_unknown("operator has no overload form");
  }
  return s.overload_ret("neg", ot);
}

function (s: Scope) overload_ret(method: string, t: typeinfo.Type): typeinfo.Type {
  if (method == "") {
    return t_unknown("operator has no overload form");
  }
  let recv = cmp_method_receiver(t);
  if (recv == "") {
    return t_unknown("operand is not a nominal type");
  }
  let Some(ms) = s.lookup_method(method, recv) else {
    return t_unknown("no such method");
  };
  let no_type_args: string[] = [];
  return generic_method_ret(ms, receiver_binding(ms, no_type_args, t, s), s);
}

function downcast_operand_ok(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeDyn(_) => {
      return true;
    },
    typeinfo.TypeUnknown(_) => {
      return true;
    },
    typeinfo.TypeNever(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function is_primitive_type(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(_) => {
      return true;
    },
    typeinfo.TypeBool(_) => {
      return true;
    },
    typeinfo.TypeString(_) => {
      return true;
    },
    typeinfo.TypeFloat(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function literal_match_type(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return false;
    },
    typeinfo.TypeErased(_) => {
      return false;
    },
    typeinfo.TypeUnion(_) => {
      return false;
    },
    typeinfo.TypeStruct(_) => {
      return false;
    },
    typeinfo.TypeTuple(_) => {
      return false;
    },
    _ => {
      return true;
    }
  }
  return false;
}

function as_cast_allowed(src: typeinfo.Type, tgt: typeinfo.Type): boolean {
  if (type_eq(src, tgt)) {
    return true;
  }
  let src_num = is_integer(src) || type_eq(src, t_char()) || is_float(src);
  let tgt_num = is_integer(tgt) || type_eq(tgt, t_char()) || is_float(tgt);
  if (src_num && tgt_num) {
    return true;
  }
  if (type_eq(src, t_string()) && cast_pointer_int(tgt)) {
    return true;
  }
  if (cast_pointer_int(src) && type_eq(tgt, t_string())) {
    return true;
  }
  return false;
}

function cast_pointer_int(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return !i.is_char && (i.width == 32 || i.width == typeinfo.width_ptr());
  }
  return false;
}

function cast_pointer_shaped(t: typeinfo.Type, source: boolean): boolean {
  match (t) {
    typeinfo.TypeArray(a) => {
      return source || !a.view;
    },
    typeinfo.TypeStruct(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub struct FuncSig { name: string, param_types: typeinfo.Type[], param_own: boolean[], ret_type: typeinfo.Type, all_type_params: string[], type_params: string[], type_bounds: string[], ret_type_name: string, param_type_names: string[], param_names: string[], is_const: boolean, receiver: string, typevars: string[], module: string, refs: parser.TypeRef[], is_unsafe: boolean, is_pub: boolean }

function sig_param_ref(sig: FuncSig, i: i32): parser.TypeRef {
  if (sig.refs.len() > 0) {
    return sig.refs[i];
  }
  return parser.parse_type_ref(sig.param_type_names[i]);
}

function sig_ret_ref(sig: FuncSig): parser.TypeRef {
  if (sig.refs.len() > 0) {
    return sig.refs[sig.param_type_names.len()];
  }
  return parser.parse_type_ref(sig.ret_type_name);
}

function generic_sig_refs(all_type_params: string[], param_type_names: string[], ret_type_name: string): parser.TypeRef[] {
  let out: parser.TypeRef[] = [];
  if (all_type_params.len() == 0) {
    return out;
  }
  for sp in param_type_names {
    out = out.append(parser.parse_type_ref(sp));
  }
  return out.append(parser.parse_type_ref(ret_type_name));
}

pub struct StructSig { name: string, field_names: string[], field_types: typeinfo.Type[], type_params: string[], const_params: string[], field_type_names: string[], variant_field_names: string[], derives: string[], enum_owner: string, opaque: boolean, module: string, must_consume: boolean }

pub struct MethodSig { name: string, receiver_type: string, param_types: typeinfo.Type[], ret_type: typeinfo.Type, ret_type_name: string, param_type_names: string[], all_type_params: string[], type_params: string[], type_bounds: string[], module: string, impl_trait: string, line: i32, col: i32, file: string, is_unsafe: boolean, is_pub: boolean, is_package: boolean }

pub struct UnionSig { name: string, variants: string[], is_try: boolean, is_enum: boolean, module: string, type_params: string[], const_params: string[], instance: string, visible_from: string[], must_consume: boolean }

pub struct Scope {
  names: string[],
  types: typeinfo.Type[],
  sigs: SigTable,
  structs: StructTable,
  unions: UnionTable,
  names_of_types: TypeNames,
  methods: MethodTable,
  imports: Imports,
  loop_depth: i32,
  ret_type: typeinfo.Type,
  try_ret: typeinfo.Type,
  impls: parser.ImplInfo[],
  trait_reqs: parser.TraitReq[],
  fn_module: string,
  fn_stdlib: boolean,
  default_trait: string,
  default_recv: string,
  tparams: string[],
  tbounds: string[],
  lit_locals: string[],
  in_unsafe: boolean,
}

pub struct ViewMemo { names: util.NameIndex, holds: boolean[] }

function new_view_memo(): Cell[ViewMemo] {
  let names: string[] = [];
  return cell_new(ViewMemo { names: util.name_index(names), holds: [] });
}

pub struct SigTable {
  sigs: FuncSig[],
  index: util.NameIndex,
  raw: RawFloorSig[],
  raw_allowed: boolean,
}

function sig_buckets(): i32 {
  return 4093;
}

function sig_name_bucket(name: string): i32 {
  return (__str_hash(name, 0) & 1073741823) % 4093;
}

function sig_table(sigs: FuncSig[]): SigTable {
  let names: string[] = [];
  for sig in sigs {
    names = names.append(sig.name);
  }
  return SigTable { sigs: sigs, index: util.name_index(names), raw: raw_floor_sigs(), raw_allowed: true };
}

pub struct StructTable {
  structs: StructSig[],
  index: util.NameIndex,
  heads: util.NameIndex,
  resources: util.NameIndex,
  spellings: SpellMemo,
}

pub struct SpellMemo { names: util.NameIndex, types: typeinfo.Type[] }

function no_spellings(): SpellMemo {
  let none: string[] = [];
  return SpellMemo { names: util.name_index(none), types: [] };
}

pub struct TypeNames {
  structs: util.NameIndex,
  unions: util.NameIndex,
  resources: util.NameIndex,
  spellings: SpellMemo,
  // unloaded is the qualifiers of the module's imports that were not loaded,
  // so their types are not known here: `json` for an unloaded "std/json".
  unloaded: util.NameIndex,
}

function type_names(struct_names: string[], union_names: string[], resource_names: string[]): TypeNames {
  return TypeNames { structs: util.name_index(struct_names), unions: util.name_index(union_names), resources: util.name_index(resource_names), spellings: no_spellings(), unloaded: util.name_index([]) };
}

function with_spellings(tn: TypeNames, mod: parser.Module): TypeNames {
  let names = tn.spellings.names;
  let types: typeinfo.Type[] = [];
  for sp in module_spellings(mod) {
    if (sp.len() == 0 || names.has(sp)) {
      continue;
    }
    names = names.added(sp);
    types = types.append(type_from_spelling(sp, tn));
  }
  return TypeNames { ...tn, spellings: SpellMemo { names: names, types: types } };
}

function module_spellings(mod: parser.Module): string[] {
  let out: string[] = [];
  for fd in mod.funcs {
    for p in fd.params {
      out = out.append(p.type_name);
    }
    out = out.append(fd.ret_type);
    for st in fd.body {
      out = astwalk.fold_stmt_spine(st, out, spelling_of_stmt);
    }
  }
  for sd in mod.structs {
    for f in sd.fields {
      out = out.append(f.type_name);
    }
  }
  for st in mod.top_stmts {
    out = astwalk.fold_stmt_spine(st, out, spelling_of_stmt);
  }
  return out;
}

function spelling_of_stmt(st: ast.Stmt, own acc: string[]): string[] {
  match (st) {
    ast.StmtVar(v) => {
      return acc.append(v.type_name);
    },
    _ => {
      return acc;
    }
  }
}

function struct_table(structs: StructSig[], union_names: string[], resources: string[], spellings: SpellMemo): StructTable {
  let names: string[] = [];
  for sd in structs {
    names = names.append(sd.name);
  }
  return StructTable { structs: structs, index: util.name_index(names), heads: util.name_index(type_head_names(structs, union_names)), resources: util.name_index(resources), spellings: spellings };
}

function type_head_names(structs: StructSig[], union_names: string[]): string[] {
  let unions = util.name_index(union_names);
  let out: string[] = [];
  for sd in structs {
    if (sd.enum_owner.len() == 0 || !unions.has(sd.name)) {
      out = out.append(sd.name);
    }
  }
  return out;
}

function resource_names(mod: parser.Module): string[] {
  let out: string[] = [];
  for r in parser.registered_resources(mod) {
    out = out.append(r.name);
  }
  return out;
}

pub struct UnionTable {
  unions: UnionSig[],
  vnames: string[],
  vowner: i32[],
  index: util.NameIndex,
  head: i32[],
  next: i32[],
  lib_head: i32[],
  lib_next: i32[],
  from_import: boolean,
  bnames: string[],
  bhead: i32[],
  bnext: i32[],
  view_memo: Cell[ViewMemo],
}

function enum_union_sig(ed: parser.EnumDecl): UnionSig {
  return UnionSig { name: ed.name, variants: ed.variant_names, is_try: ed.try_marker, is_enum: true, module: ed.module, type_params: ed.type_params, const_params: ed.const_params, instance: ed.instance, visible_from: ed.visible_from, must_consume: ed.must_consume };
}

function union_table(unions: UnionSig[]): UnionTable {
  let head = util.minus_ones(sig_buckets());
  let vnames: string[] = [];
  let vowner: i32[] = [];
  let u = 0;
  while (u < unions.len()) {
    let vs = unions[u].variants;
    let v = 0;
    while (v < vs.len()) {
      vnames = vnames.append(vs[v]);
      vowner = vowner.append(u);
      v += 1;
    }
    u += 1;
  }
  let next = util.minus_ones(vnames.len());
  let lib_head = head;
  let lib_next = next;
  let bnames: string[] = [];
  let b = 0;
  while (b < vnames.len()) {
    bnames = bnames.append(unprefixed_variant(vnames[b], unions[vowner[b]].module));
    b += 1;
  }
  let bhead = head;
  let bnext = next;
  let k = vnames.len() - 1;
  while (k >= 0) {
    let bk = sig_name_bucket(vnames[k]);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    if (!declared_by_entry(unions[vowner[k]])) {
      lib_next = lib_next.with(k, lib_head[bk]);
      lib_head = lib_head.with(bk, k);
    }
    let bb = sig_name_bucket(bnames[k]);
    bnext = bnext.with(k, bhead[bb]);
    bhead = bhead.with(bb, k);
    k -= 1;
  }
  let names: string[] = [];
  let m = 0;
  while (m < unions.len()) {
    names = names.append(unions[m].name);
    m += 1;
  }
  return UnionTable { unions: unions, vnames: vnames, vowner: vowner, index: util.name_index(names), head: head, next: next, lib_head: lib_head, lib_next: lib_next, from_import: false, bnames: bnames, bhead: bhead, bnext: bnext, view_memo: new_view_memo() };
}

function declared_by_entry(u: UnionSig): boolean {
  return u.module.len() == 0;
}

function unprefixed_variant(name: string, module: string): string {
  let m = module.len();
  if (m > 0 && name.len() > m + 2 && name[m] == b'_' && name[m + 1] == b'_' && slice_unchecked(name, 0, m) == module) {
    return slice_unchecked(name, m + 2, name.len()) + "";
  }
  return name;
}

function enum_visible_from(u: UnionSig, from: string): boolean {
  return u.module == from || util.has_str(u.visible_from, from);
}

function enum_access_diags(found: Option[UnionSig], s: Scope, line: i32, col: i32): util.Diag[] {
  if let Some(u) = found {
    if (u.is_enum && !parser.is_reserved_enum_name(u.name) && !enum_visible_from(u, s.fn_module)) {
      return [dg_at("E087", "enum " + util.demangle(u.name) + " is not visible from this package", line, col)];
    }
  }
  return [];
}

function (ut: UnionTable) seen_from(fd: parser.FuncDecl): UnionTable {
  return UnionTable { ...ut, from_import: fd.module.len() > 0 };
}

function (ut: UnionTable) variant_chain_head(name: string): i32 {
  if (ut.from_import) {
    return ut.lib_head[sig_name_bucket(name)];
  }
  return ut.head[sig_name_bucket(name)];
}

function (ut: UnionTable) variant_chain_next(e: i32): i32 {
  if (ut.from_import) {
    return ut.lib_next[e];
  }
  return ut.next[e];
}

// names indexes the full method names, simple the names without their receiver.
// bases holds the base of each receiver spelling.
pub struct MethodTable {
  methods: MethodSig[],
  names: util.NameIndex,
  simple: util.NameIndex,
  bases: string[],
}

function method_table(methods: MethodSig[]): MethodTable {
  let names: string[] = [];
  let simple: string[] = [];
  let bases: string[] = [];
  for m in methods {
    names = names.append(m.name);
    simple = simple.append(method_simple_name(m.name));
    bases = bases.append(method_base(m.receiver_type));
  }
  return MethodTable { methods: methods, names: util.name_index(names), simple: util.name_index(simple), bases: bases };
}

function method_base(receiver: string): string {
  let tuple = parser.tuple_namespace(receiver);
  if (tuple.len() > 0) {
    return tuple;
  }
  return parser.parse_type_ref(receiver).base;
}

function (s: Scope) trait_providers(name: string, recv_type: string): MethodSig[] {
  let out: MethodSig[] = [];
  let i = s.methods.simple.chain(name);
  while (i >= 0) {
    let m = s.methods.methods[i];
    if (m.impl_trait.len() > 0 && method_simple_name(m.name) == name && (m.receiver_type == recv_type || s.methods.bases[i] == recv_type)) {
      out = out.append(m);
    }
    i = s.methods.simple.next[i];
  }
  return out;
}

function trait_visible_from(s: Scope, tname: string, from: string): boolean {
  for tr in s.trait_reqs {
    if (tr.trait_name == tname || method_simple_name(tr.trait_name) == method_simple_name(tname)) {
      return trait_req_visible(tr, from);
    }
  }
  return true;
}

// A trait is visible from a module that declares it or imports its module.
function trait_req_visible(tr: parser.TraitReq, from: string): boolean {
  return tr.module.len() == 0 || tr.module == from || util.has_str(tr.visible_from, from);
}

function ambiguous_call_diags(fa: ast.ExprFieldAccess, recv_type: string, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (util.index_of_sub(fa.field, ".") >= 0) {
    return out;
  }
  let cands = s.trait_providers(fa.field, recv_type);
  if (cands.len() < 2) {
    return out;
  }
  if (s.default_trait.len() > 0 && recv_type == s.default_recv) {
    for m in cands {
      if (method_simple_name(m.impl_trait) == s.default_trait) {
        return out;
      }
    }
  }
  let best: MethodSig[] = [];
  for m in cands {
    if (trait_visible_from(s, m.impl_trait, s.fn_module)) {
      best = best.append(m);
    }
  }
  if (best.len() == 0) {
    best = cands;
  }
  if (best.len() < 2) {
    return out;
  }
  best = util.sorted_by(best, method_provider_after);
  let providers = "";
  for m in best {
    if (providers.len() > 0) {
      providers += " and ";
    }
    providers += sig_provider(m);
  }
  let msg = "ambiguous method \"" + fa.field + "\" on " + util.demangle(recv_type) + ": provided by " + providers;
  return out.append(dg_at("E074", msg, fa.line, fa.col));
}

function finalizer_call_diags(fa: ast.ExprFieldAccess, recv_type: string, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (fa.field != "drop") {
    return out;
  }
  for m in s.trait_providers("drop", recv_type) {
    if (method_simple_name(m.impl_trait) == "Drop") {
      let msg = "`drop` is a finalizer, not a method to call: the runtime runs " + util.demangle(recv_type) + "'s `drop` when the value's last reference goes away, so calling it here runs the body a second time on a value that will still be finalized";
      return out.append(dg_at("E073", msg, fa.line, fa.col + 1));
    }
  }
  return out;
}

function method_provider_after(a: MethodSig, b: MethodSig): boolean {
  return a.impl_trait > b.impl_trait;
}

function sig_provider(m: MethodSig): string {
  return "trait " + util.demangle(m.impl_trait) + " (declared at " + m.file + util.i32_to_string(util.pos_line(m.line)) + ":" + util.i32_to_string(m.col) + ")";
}

function decl_file_label(fd: parser.FuncDecl): string {
  if (fd.stdlib.len() > 0) {
    return fd.stdlib + ".fern:";
  }
  if (fd.module.len() > 0) {
    return fd.module + ".fern:";
  }
  return "";
}

function new_scope(): Scope {
  let ns: string[] = [];
  let ts: typeinfo.Type[] = [];
  let fs: FuncSig[] = [];
  let ss: StructSig[] = [];
  let us: UnionSig[] = [];
  let ms: MethodSig[] = [];
  let structs = struct_table(ss, [], [], no_spellings());
  let unions = union_table(us);
  return Scope { names: ns, types: ts, sigs: sig_table(fs), structs: structs, unions: unions, names_of_types: type_names_of(structs, unions, []), methods: method_table(ms), imports: Imports { paths: [], unloaded: [], sights: [] }, loop_depth: 0, ret_type: t_unknown("no enclosing function"), try_ret: t_unknown("no enclosing function"), impls: [], trait_reqs: [], fn_module: "", fn_stdlib: false, default_trait: "", default_recv: "", tparams: [], tbounds: [], lit_locals: [], in_unsafe: false };
}

function new_scope_full(st: SigTable, structs: StructTable, unions: UnionTable, methods: MethodTable, imports: Imports, impls: parser.ImplInfo[], trait_reqs: parser.TraitReq[]): Scope {
  let ns: string[] = [];
  let ts: typeinfo.Type[] = [];
  return Scope { names: ns, types: ts, sigs: st, structs: structs, unions: unions, names_of_types: type_names_of(structs, unions, imports.unloaded), methods: methods, imports: imports, loop_depth: 0, ret_type: t_unknown("no enclosing function"), try_ret: t_unknown("no enclosing function"), impls: impls, trait_reqs: trait_reqs, fn_module: "", fn_stdlib: false, default_trait: "", default_recv: "", tparams: [], tbounds: [], lit_locals: [], in_unsafe: false };
}

function (s: Scope) bind(name: string, t: typeinfo.Type): Scope {
  let ns = s.names.append(name);
  let ts = s.types.append(t);
  if (!util.has_str(s.lit_locals, name)) {
    return Scope { ...s, names: ns, types: ts };
  }
  let lits: string[] = [];
  for lit in s.lit_locals {
    if (lit != name) {
      lits = lits.append(lit);
    }
  }
  return Scope { ...s, names: ns, types: ts, lit_locals: lits };
}

function (s: Scope) bind_inferred(v: ast.StmtVar, t: typeinfo.Type): Scope {
  // Read s before the bind, so that the bind is the last use of s and grows
  // its arrays in place.
  let unsettled = is_integer(t) && unsettled_tree(v.init, s.lit_locals);
  let b = s.bind(v.name, t);
  if (unsettled) {
    return Scope { ...b, lit_locals: b.lit_locals.append(v.name) };
  }
  return b;
}

function (s: Scope) with_tparams(tparams: string[], tbounds: string[]): Scope {
  return Scope { ...s, tparams: tparams, tbounds: tbounds };
}

function (s: Scope) is_const_param(name: string): boolean {
  let i = util.index_of_str(s.tparams, name);
  if (i < 0 || i >= s.tbounds.len() || !parser.is_const_bound(s.tbounds[i])) {
    return false;
  }
  return util.index_of_str(s.names, name) == s.binding_index(name);
}

function (s: Scope) type_names(): TypeNames {
  return s.names_of_types;
}

function type_names_of(structs: StructTable, unions: UnionTable, unloaded: string[]): TypeNames {
  return TypeNames { structs: structs.heads, unions: unions.index, resources: structs.resources, spellings: structs.spellings, unloaded: util.name_index(unloaded) };
}

pub function (s: Scope) resolve_type(name: string): typeinfo.Type {
  return type_from_name_subst(name, s.tparams, rigid_tparams(s.tparams), s.type_names());
}

function (s: Scope) defines(name: string): boolean {
  let i = s.names.len() - 1;
  while (i >= 0) {
    if (s.names[i] == name) {
      return true;
    }
    i -= 1;
  }
  return false;
}

function name_has_comma(name: string): boolean {
  for ch in name {
    if (ch == b',') {
      return true;
    }
  }
  return false;
}

function bind_destructure_names(s: Scope, v: ast.StmtVar): Scope {
  if (!name_has_comma(v.name) && !parser.is_destr_marker(v.type_name)) {
    return s;
  }
  let at = parser.destr_marker_split(v.type_name).at;
  let whole = check_expr(v.init, s);
  let out = s;
  if (at.len() > 0) {
    out = out.bind(at, whole);
  }
  if (parser.is_struct_destr_marker(v.type_name)) {
    return bind_struct_destr_fields(out, v, s);
  }
  return bind_tuple_destr_names(out, split_pattern_names(v.name), whole);
}

function bind_struct_destr_fields(out: Scope, v: ast.StmtVar, s: Scope): Scope {
  let (fields, ok) = struct_destr_fields(v.type_name);
  if (!ok) {
    return bind_names(out, v.name);
  }
  let names = split_pattern_names(v.name);
  let i = 0;
  while (i < names.len()) {
    let ft = t_unknown("binding");
    if (i < fields.len()) {
      ft = check_expr(ast.ExprFieldAccess { obj: v.init, field: fields[i], line: v.line, col: v.col, ty: "", const_read: false }, s);
    }
    out = out.bind(names[i], ft);
    i += 1;
  }
  return out;
}

function struct_destr_fields(type_name: string): (string[], boolean) {
  let marker = parser.destr_marker_split(type_name).tag;
  let rest = slice_unchecked(marker, 4, marker.len()) + "";
  let colon = util.index_of_sub(rest, ":");
  if (colon < 0) {
    return ([], false);
  }
  return (split_pattern_names(slice_unchecked(rest, colon + 1, rest.len()) + ""), true);
}

function struct_destr_name(type_name: string): string {
  let marker = parser.destr_marker_split(type_name).tag;
  let rest = slice_unchecked(marker, 4, marker.len()) + "";
  let colon = util.index_of_sub(rest, ":");
  if (colon < 0) {
    return "";
  }
  return slice_unchecked(rest, 0, colon) + "";
}

function opaque_access_diags(sig: StructSig, s: Scope, what: string, line: i32, col: i32): util.Diag[] {
  if (!sig.opaque || sig.module == s.fn_module) {
    return [];
  }
  return [dg_at("E021", "cannot " + what + " opaque type " + util.demangle(sig.name) + " outside the module that defines it", line, col)];
}

function struct_destr_diags(v: ast.StmtVar, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (!parser.is_struct_destr_marker(v.type_name)) {
    return out;
  }
  let (fields, _) = struct_destr_fields(v.type_name);
  let it = check_expr(v.init, s);
  match (it) {
    typeinfo.TypeStruct(st) => {
      let named = struct_destr_name(v.type_name);
      if (named.len() > 0 && named != st.name) {
        return out.append(dg_at("E024", "struct destructure pattern names " + named + ", but the expression is " + st.name, v.line, v.col));
      }
      let Some(sig) = s.lookup_struct(st.name) else {
        return out;
      };
      let access = "destructure a field of";
      if (parser.destr_marker_split(v.type_name).struct_match) {
        access = "destructure";
      }
      out = util.append_diags(out, opaque_access_diags(sig, s, access, v.line, v.col));
      for f in fields {
        if (!util.has_str(sig.field_names, f)) {
          let d = dg_at("E043", "struct " + util.demangle(st.name) + " has no field \"" + f + "\"", v.line, v.col);
          out = out.append(with_fix(d, f, v.line, v.col, util.suggest(f, sig.field_names), ""));
        }
      }
    },
    typeinfo.TypeUnknown(_) => {},
    _ => {
      out = out.append(dg_at("E024", "struct destructure needs a struct expression, got " + type_label(it), v.line, v.col));
    }
  }
  return out;
}

function bind_tuple_destr_names(out: Scope, names: string[], whole: typeinfo.Type): Scope {
  let elems: typeinfo.Type[] = [];
  match (whole) {
    typeinfo.TypeTuple(tt) => {
      elems = tt.elements;
    },
    _ => {}
  }
  let i = 0;
  while (i < names.len()) {
    let nm = names[i];
    let et = t_unknown("binding");
    if (i < elems.len()) {
      et = elems[i];
    }
    if (util.is_tuple_type_name(nm)) {
      out = bind_tuple_destr_names(out, split_pattern_names(slice_unchecked(nm, 1, nm.len() - 1) + ""), et);
    } else if (nm.len() > 0) {
      out = out.bind(nm, et);
    }
    i += 1;
  }
  return out;
}

pub function split_pattern_names(encoded: string): string[] {
  let out: string[] = [];
  let start = 0;
  let depth = 0;
  let i = 0;
  while (i <= encoded.len()) {
    if (i == encoded.len() || encoded[i] == b',' && depth == 0) {
      if (i > start) {
        out = out.append(slice_unchecked(encoded, start, i) + "");
      }
      start = i + 1;
    } else if (encoded[i] == b'(') {
      depth += 1;
    } else if (encoded[i] == b')') {
      depth -= 1;
    }
    i += 1;
  }
  return out;
}

function bind_names(s: Scope, name: string): Scope {
  let out = s;
  for nm in split_pattern_names(name) {
    if (util.is_tuple_type_name(nm)) {
      out = bind_names(out, slice_unchecked(nm, 1, nm.len() - 1) + "");
    } else if (nm.len() > 0) {
      out = out.bind(nm, t_unknown("binding"));
    }
  }
  return out;
}

function is_builtin_variant(name: string): boolean {
  return parser.builtin_enum_of(name).len() > 0;
}

function variant_in_unions(name: string, unions: UnionTable): boolean {
  let e = unions.variant_chain_head(name);
  while (e >= 0) {
    if (unions.vnames[e] == name) {
      return true;
    }
    e = unions.variant_chain_next(e);
  }
  return false;
}

function is_nopayload_builtin_variant(name: string): boolean {
  if (name == "None") {
    return true;
  }
  if (name == "JNull") {
    return true;
  }
  if (name == "Interrupted" || name == "Unsupported") {
    return true;
  }
  return parser.builtin_enum_of(name) == "StreamFault";
}

function union_sig_of_variant(name: string, unions: UnionTable): Option[UnionSig] {
  let e = unions.variant_chain_head(name);
  while (e >= 0) {
    if (unions.vnames[e] == name) {
      return Some(unions.unions[unions.vowner[e]]);
    }
    e = unions.variant_chain_next(e);
  }
  return None;
}

function union_of_variant(name: string, unions: UnionTable): string {
  if let Some(u) = union_sig_of_variant(name, unions) {
    return u.name;
  }
  return "";
}

// Prefer visible variants when hidden enums share a constructor name.
// Retain a hidden candidate so the diagnostic can identify its enum.
function scope_variant_sig(name: string, s: Scope): Option[UnionSig] {
  let first = union_sig_of_variant(name, s.unions);
  let e = s.unions.variant_chain_head(name);
  while (e >= 0) {
    if (s.unions.vnames[e] == name) {
      let u = s.unions.unions[s.unions.vowner[e]];
      if (!u.is_enum || parser.is_reserved_enum_name(u.name) || enum_visible_from(u, s.fn_module)) {
        return Some(u);
      }
    }
    e = s.unions.variant_chain_next(e);
  }
  if (parser.builtin_enum_of(name).len() > 0) {
    return s.lookup_union(parser.builtin_enum_of(name));
  }
  return first;
}

function scope_variant_owner(name: string, s: Scope): string {
  if let Some(u) = scope_variant_sig(name, s) {
    return u.name;
  }
  return "";
}

function variant_value_payloads(s: Scope, en: string, name: string): i32 {
  let found = scope_variant_sig(name, s);
  if (en.len() > 0) {
    found = s.lookup_union(en);
  }
  if let Some(owner) = found {
    if (owner.is_enum) {
      if let Some(vs) = s.lookup_owned_struct(name, owner.name) {
        if (vs.enum_owner == owner.name) {
          return vs.field_names.len();
        }
      }
      return 0;
    }
    if (struct_field_names(s, name).len() > 0) {
      return 1;
    }
    return 0;
  }
  return builtin_variant_payloads(s, en, name);
}

function builtin_variant_payloads(s: Scope, en: string, name: string): i32 {
  let builtin = parser.builtin_enum_of(name);
  if (builtin.len() == 0 || en.len() > 0 && en != builtin) {
    return 0;
  }
  if (builtin == "Option" || builtin == "Result") {
    if (name == "None") {
      return 0;
    }
    return 1;
  }
  if let Some(injected) = s.lookup_owned_struct(name, builtin) {
    if (injected.enum_owner == builtin) {
      return injected.field_names.len();
    }
  }
  return 0;
}

function payload_variant_value_diag(shown: string, payloads: i32, line: i32, col: i32): util.Diag {
  return dg_at("E036", "variant " + shown + " expects " + util.i32_to_string(payloads) + " payload argument(s); call it as " + shown + "(...)", line, col);
}

function no_variant_diag(s: Scope, en: string, field: string, line: i32, col: i32): util.Diag {
  return dg_at("E036", "enum " + shown_enum(s, en) + " has no variant \"" + unprefixed_variant(field, union_module(s, en)) + "\"", line, col);
}

function shown_variant(s: Scope, name: string): string {
  let bare = variant_pattern_name(name);
  let owner = union_sig_of_variant(bare, s.unions);
  if (variant_pattern_owner(name).len() > 0) {
    owner = s.lookup_union(variant_pattern_owner(name));
  }
  let module: string = match (owner) { Some(u) => u.module, None => "" };
  return unprefixed_variant(bare, module);
}

function shown_variant_in(structs: StructTable, name: string): string {
  let module: string = match (find_variant_sig(structs, name)) { Some(sig) => sig.module, None => "" };
  return unprefixed_variant(variant_pattern_name(name), module);
}

function shown_enum(s: Scope, name: string): string {
  let m = union_module(s, name);
  let bare = unprefixed_variant(name, m);
  if (bare == name || m == s.fn_module) {
    return bare;
  }
  return m + "." + bare;
}

function unknown_variant_diag(s: Scope, name: string, u: UnionSig, line: i32, col: i32): util.Diag {
  let shown = unprefixed_variant(name, u.module);
  let hint = " — a bare name in arm position is a VARIANT, not a binding; for a catch-all use `_`, binding the scrutinee to a variable first if you need its value";
  let best = "";
  let best_d = 0;
  for v in u.variants {
    let d = util.levenshtein(shown, unprefixed_variant(v, u.module));
    if (d <= shown.len() / 3 + 1 && (best.len() == 0 || d < best_d)) {
      best = unprefixed_variant(v, u.module);
      best_d = d;
    }
  }
  if (best.len() > 0) {
    hint = " (did you mean \"" + best + "\"?)";
  }
  return dg_at("E014", "variant \"" + shown + "\" is not part of enum " + shown_enum(s, u.name) + hint, line, col);
}

function is_resolvable_value(name: string, s: Scope): boolean {
  if (s.defines(name)) {
    return true;
  }
  if (s.has_sig(name)) {
    return true;
  }
  if (variant_in_unions(name, s.unions) || s.variant_ambiguous(name)) {
    return true;
  }
  if (is_builtin_variant(name)) {
    return true;
  }
  let floor = raw_floor_at(s.sigs, name);
  if (floor >= 0 || util.str_has_prefix(name, "__raw_") || util.str_has_prefix(name, "__syscall")) {
    return floor >= 0 && raw_floor_allowed(s.sigs, name);
  }
  return is_resolvable_raw_name(name) || parser.is_builtin_function(name);
}

// The parser's desugar names, the runtime's own entry points, and the
// registered intrinsics are the only names outside the source that resolve.
function is_resolvable_raw_name(name: string): boolean {
  if (name == "__range" || name == "__range_incl" || name == "__set_field" || name == "__set_index") {
    return true;
  }
  if (util.str_has_prefix(name, "__fern_")) {
    return true;
  }
  return util.str_has_prefix(name, "__") && util.has_str(registered_intrinsics(), name);
}

function for_iter_is_range(iter: ast.Expr): boolean {
  match (iter) {
    ast.ExprCall(c) => {
      if (c.args.len() != 2) {
        return false;
      }
      match (c.callee) {
        ast.ExprIdent(id) => {
          return id.name == "__range" || id.name == "__range_incl";
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

function (s: Scope) enter_loop(): Scope {
  return Scope { ...s, loop_depth: s.loop_depth + 1 };
}

function (s: Scope) with_ret_type(rt: typeinfo.Type): Scope {
  return Scope { ...s, ret_type: rt, try_ret: rt };
}

function (s: Scope) with_block_ret(rt: typeinfo.Type): Scope {
  return Scope { ...s, ret_type: rt };
}

// The local an identifier names: none for one that names a builtin.
function (s: Scope) ident_binding(id: ast.ExprIdent): i32 {
  if (id.builtin) {
    return -1;
  }
  return s.binding_index(id.name);
}

function (s: Scope) binding_index(name: string): i32 {
  let i = s.names.len() - 1;
  while (i >= 0) {
    if (s.names[i] == name) {
      return i;
    }
    i -= 1;
  }
  return -1;
}

function (s: Scope) lookup(name: string): typeinfo.Type {
  let i = s.binding_index(name);
  if (i >= 0) {
    return s.types[i];
  }
  return t_unknown("undefined identifier:" + name);
}

function (s: Scope) known(name: string): boolean {
  let i = s.binding_index(name);
  return i >= 0 && !is_unknown(s.types[i]);
}

function (s: Scope) is_bound(name: string): boolean {
  return s.binding_index(name) >= 0;
}

pub function (s: Scope) lookup_assoc_sig(tyname: string, field: string): Option[FuncSig] {
  for sig in s.sigs.sigs {
    if (sig.name == field && sig.receiver.len() > 0 && util.base_type_name(sig.receiver) == tyname) {
      return Some(sig);
    }
  }
  return None;
}

function (s: Scope) sig_at(name: string): i32 {
  let first: i32 = -1;
  let i = s.sigs.index.chain(name);
  while (i >= 0) {
    if (s.sigs.index.names[i] == name) {
      if (s.sigs.sigs[i].receiver.len() == 0) {
        return i;
      }
      if (first < 0) {
        first = i;
      }
    }
    i = s.sigs.index.next[i];
  }
  return first;
}

pub function (s: Scope) lookup_sig(name: string): Option[FuncSig] {
  let i = s.sig_at(name);
  if (i >= 0) {
    return Some(s.sigs.sigs[i]);
  }
  return None;
}

function (s: Scope) sig_is_const(name: string): boolean {
  return match (s.lookup_sig(name)) { Some(sig) => sig.is_const, None => false };
}

function tp_bound_for(ptype: string, type_params: string[], bound_traits: string[]): string {
  let k = 0;
  while (k < type_params.len()) {
    if (type_params[k] == ptype) {
      if (k < bound_traits.len()) {
        return bound_traits[k];
      }
      return "";
    }
    k += 1;
  }
  return "";
}

function e021_trait_idx(tr: string, trait_reqs: parser.TraitReq[]): i32 {
  let i = 0;
  while (i < trait_reqs.len()) {
    if (trait_reqs[i].trait_name == tr) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function e021_scope_has_impl(impls: parser.ImplInfo[], trait_name: string, impl_type: string): boolean {
  let base = util.base_type_name(impl_type);
  for imp in impls {
    if (imp.trait_name == trait_name && util.base_type_name(imp.impl_type) == base) {
      return true;
    }
  }
  return false;
}

function conforms_by_impl_or_derive(s: Scope, tyname: string, tr: string): boolean {
  return e021_scope_has_impl(s.impls, tr, tyname) || derives_trait(s, tyname, tr);
}

function derives_trait(s: Scope, tyname: string, tr: string): boolean {
  for sd in s.structs.structs {
    if (sd.name == tyname || sd.enum_owner == tyname) {
      for derive in sd.derives {
        if (parser.derive_simple_name(derive) == tr) {
          return true;
        }
      }
    }
  }
  return false;
}

function conforms_to_dyn_trait(s: Scope, tyname: string, tr: string): boolean {
  let key = util.base_type_name(tr);
  for imp in s.impls {
    if (parser.impl_trait_key(imp) == key && parser.receiver_base(imp.impl_type) == parser.receiver_base(tyname)) {
      return true;
    }
  }
  return derives_trait(s, tyname, parser.derive_simple_name(key));
}

function map_key_type_error(s: Scope, kt: typeinfo.Type): string {
  if (is_unknown(kt) || is_type_variable(kt) || is_integer(kt) || type_eq(kt, t_char()) || type_eq(kt, t_string()) || type_eq(kt, t_str())) {
    return "";
  }
  if (is_tuple_or_array(kt)) {
    if (structural_map_key(kt)) {
      return "";
    }
    return "map key type " + type_label(kt) + " is not supported — a tuple or array used as a key may hold only integers, booleans, chars, strings, and such tuples and arrays";
  }
  if let typeinfo.TypeBool(_) = kt {
    return "";
  }
  let kn = "";
  let kw = "";
  match (kt) {
    typeinfo.TypeStruct(st) => {
      kn = st.name;
      kw = "a struct";
    },
    typeinfo.TypeUnion(u) => {
      if (u.name != "Option" && u.name != "Result") {
        kn = u.name;
        kw = "an enum";
      }
    },
    _ => {}
  }
  if (kn != "") {
    if (conforms_by_impl_or_derive(s, kn, "Eq") && conforms_by_impl_or_derive(s, kn, "Hash")) {
      return "";
    }
    return "map key type " + type_label(kt) + " is not supported — " + kw + " used as a key must derive Eq and Hash: add `@derive(cmp.Eq, cmp.Hash)`, which requires `import \"core/cmp\";`";
  }
  return "map key type " + type_label(kt) + " is not yet supported — use i32, string, or a struct/enum with `@derive(cmp.Eq, cmp.Hash)`, which requires `import \"core/cmp\";`";
}

function is_tuple_or_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  return false;
}

function structural_map_key(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      if (!structural_key_element(e)) {
        return false;
      }
    }
    return tup.elements.len() > 0;
  }
  if let typeinfo.TypeArray(a) = t {
    return structural_key_element(a.elem);
  }
  return false;
}

function structural_key_element(t: typeinfo.Type): boolean {
  if (type_eq(t, t_string()) || structural_map_key(t)) {
    return true;
  }
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  if let typeinfo.TypeI32(_) = t {
    return true;
  }
  return false;
}

function mlit_entries_settle(e: ast.Expr, want: typeinfo.TypeMap, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprFieldAccess(fa) = c.callee {
      if (fa.field != "insert" || c.args.len() != 2) {
        return false;
      }
      if (!settles_or_assignable(c.args[0], want.key, s) || !settles_or_assignable(c.args[1], want.value, s)) {
        return false;
      }
      return mlit_is_base(fa.obj) || mlit_entries_settle(fa.obj, want, s);
    }
  }
  return false;
}

function mlit_is_desugared(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (c.line != 0 || c.col != 0) {
        return false;
      }
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "insert") {
            return false;
          }
          if (mlit_is_base(fa.obj)) {
            return true;
          }
          return mlit_is_desugared(fa.obj);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

function literal_insert(c: ast.ExprCall): boolean {
  return c.line == 0 && c.col == 0 && mlit_is_desugared(c);
}

function e045_map_key_msgs(t: typeinfo.Type, s: Scope): string[] {
  let out: string[] = [];
  match (t) {
    typeinfo.TypeMap(mt) => {
      out = util.append_all(out, map_shape_msgs(s, mt));
      out = util.append_all(out, e045_map_key_msgs(mt.key, s));
      out = util.append_all(out, e045_map_key_msgs(mt.value, s));
    },
    typeinfo.TypeArray(a) => {
      out = util.append_all(out, e045_map_key_msgs(a.elem, s));
    },
    typeinfo.TypeTuple(tup) => {
      for elem in tup.elements {
        out = util.append_all(out, e045_map_key_msgs(elem, s));
      }
    },
    typeinfo.TypeStruct(st) => {
      for arg in st.args {
        out = util.append_all(out, e045_map_key_msgs(arg, s));
      }
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        out = util.append_all(out, e045_map_key_msgs(arg, s));
      }
    },
    typeinfo.TypeFunc(f) => {
      for pt in f.param_types {
        out = util.append_all(out, e045_map_key_msgs(pt, s));
      }
      out = util.append_all(out, e045_map_key_msgs(f.ret_type, s));
    },
    _ => {}
  }
  return out;
}

function map_shape_msgs(s: Scope, mt: typeinfo.TypeMap): string[] {
  let out: string[] = [];
  let msg = map_key_type_error(s, mt.key);
  if (msg != "") {
    out = out.append(msg);
  }
  if (is_void(mt.value)) {
    out = out.append("map value type void is not supported — a set of keys is std/pset's `PSet`");
  }
  return out;
}

function e045_annot_diags(type_name: string, line: i32, col: i32, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (type_name.len() == 0) {
    return out;
  }
  for msg in e045_map_key_msgs(s.resolve_type(type_name), s) {
    out = out.append(dg_at("E045", msg, line, col));
  }
  return out;
}

function call_bound_diags(tparams: string[], bounds: string[], module: string, site: string, bn: string[], bt: typeinfo.Type[], s: Scope, ln: i32, cl: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let i = 0;
  while (i < tparams.len() && i < bounds.len()) {
    let bi = util.index_of_str(bn, tparams[i]);
    if (bi >= 0 && !is_unknown(bt[bi]) && !is_type_variable(bt[bi])) {
      out = util.append_diags(out, tp_bound_diags(tparams[i], bounds[i], module, site, bt[bi], s, ln, cl));
    }
    i += 1;
  }
  return out;
}

function tp_bound_diags(tp: string, bound: string, module: string, site: string, at: typeinfo.Type, s: Scope, ln: i32, cl: i32): util.Diag[] {
  let out: util.Diag[] = [];
  for entry in parser.split_plus_bounds(bound) {
    let base = util.base_type_name(entry);
    if (!bound_import_unloaded(base, s.imports.paths, s.trait_reqs) && !type_implements(s, at, base, module)) {
      out = out.append(dg_at("E021", "type argument " + tp + " = " + util.demangle(type_label(at)) + " does not implement trait " + bound_trait_display(base, module, s.trait_reqs) + " required by " + site, ln, cl));
    }
  }
  return out;
}

function type_implements(s: Scope, t: typeinfo.Type, base: string, module: string): boolean {
  if (is_send_trait(s, base)) {
    return send_unsafe_reason(t, s, []).len() == 0;
  }
  if let typeinfo.TypeDyn(d) = t {
    let want = parser.derive_simple_name(base);
    for tr in parser.dyn_trait_set("dyn " + d.traits) {
      if (parser.derive_simple_name(util.base_type_name(tr)) == want) {
        return true;
      }
    }
    return false;
  }
  if (is_type_variable(t)) {
    return true;
  }
  let tn = impl_type_name(t);
  if (tn.len() == 0) {
    return false;
  }
  for imp in s.impls {
    if (impl_receiver(imp) == tn && bound_names_trait(base, module, imp.trait_name, imp.trait_module)) {
      return impl_bounds_hold(s, imp, t);
    }
  }
  return derives_bound(s, tn, base, module);
}

// impl_bounds_hold says whether the parts of t meet the bounds of the
// parametric impl imp: impl[T: Eq] Eq for T[] covers i32[][] but not S[] for
// an S without Eq.
function impl_bounds_hold(s: Scope, imp: parser.ImplInfo, t: typeinfo.Type): boolean {
  let pattern = parser.parse_type_ref(imp.impl_type);
  let names = pattern.args;
  if (pattern.array_depth > 0) {
    names = [parser.elem_type_ref(pattern)];
  }
  let parts = impl_parts(t);
  for i in 0..names.len() {
    let at = util.index_of_str(imp.type_params, names[i].base);
    let leaf = names[i].args.len() == 0 && names[i].array_depth == 0 && !names[i].is_tuple;
    if (i < parts.len() && leaf && at >= 0 && at < imp.bounds.len()) {
      for entry in parser.split_plus_bounds(imp.bounds[at]) {
        if (!type_implements(s, parts[i], util.base_type_name(entry), imp.module)) {
          return false;
        }
      }
    }
  }
  return true;
}

// impl_parts gives the parts of t that an impl's type parameters bind: the
// element of an array, the elements of a tuple, the arguments of a named type.
function impl_parts(t: typeinfo.Type): typeinfo.Type[] {
  match (t) {
    typeinfo.TypeArray(a) => {
      return [a.elem];
    },
    typeinfo.TypeTuple(tup) => {
      return tup.elements;
    },
    typeinfo.TypeUnion(u) => {
      return u.args;
    },
    typeinfo.TypeStruct(st) => {
      return st.args;
    },
    _ => {
      return [];
    }
  }
  return [];
}

// impl_of_holds says whether the impl of trait_name that t takes its method
// from has its bounds met by the parts of t.
function impl_of_holds(s: Scope, t: typeinfo.Type, trait_name: string): boolean {
  let tn = impl_type_name(t);
  for imp in s.impls {
    if (impl_receiver(imp) == tn && imp.trait_name == trait_name) {
      return impl_bounds_hold(s, imp, t);
    }
  }
  return true;
}

function impl_receiver(imp: parser.ImplInfo): string {
  return receiver_namespace(parser.receiver_namespace(imp.impl_type));
}

function impl_type_name(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(_) => {},
    typeinfo.TypeBool(_) => {},
    typeinfo.TypeString(_) => {},
    typeinfo.TypeFloat(_) => {},
    typeinfo.TypeLanes(_) => {},
    typeinfo.TypeStruct(_) => {},
    typeinfo.TypeUnion(_) => {},
    typeinfo.TypeMap(_) => {},
    typeinfo.TypeArray(a) => {
      return if (a.view) { "slice" } else { "Array" };
    },
    typeinfo.TypeTuple(tup) => {
      return parser.tuple_arity_namespace(tup.elements.len());
    },
    _ => {
      return "";
    }
  }
  return receiver_namespace(util.base_type_name(type_label(t)));
}

function derives_bound(s: Scope, tyname: string, base: string, module: string): boolean {
  for sd in s.structs.structs {
    if (sd.name == tyname || sd.enum_owner == tyname) {
      for derive in sd.derives {
        let name = parser.derive_simple_name(derive);
        if (bound_names_trait(base, module, name, spelling_qualifier(derive, name))) {
          return true;
        }
      }
    }
  }
  return false;
}

function spelling_qualifier(spelling: string, name: string): string {
  if (spelling.len() <= name.len()) {
    return "";
  }
  return slice_unchecked(spelling, 0, spelling.len() - name.len() - 1) + "";
}

function bound_trait_display(base: string, module: string, reqs: parser.TraitReq[]): string {
  let name = parser.derive_simple_name(base);
  if (util.index_of_sub(base, ".") < 0) {
    if (module.len() == 0) {
      return name;
    }
    return module + "." + name;
  }
  let idx = bound_trait_req(base, module, reqs);
  if (idx >= 0) {
    return reqs[idx].module + "." + name;
  }
  return base;
}

function bound_trait_req(base: string, module: string, reqs: parser.TraitReq[]): i32 {
  let name = parser.derive_simple_name(base);
  let q = spelling_qualifier(base, name);
  let want = module;
  if (q.len() > 0) {
    want = q;
  }
  let found: i32 = -1;
  let i = 0;
  while (i < reqs.len()) {
    if (reqs[i].trait_name == name && reqs[i].module == want) {
      return i;
    }
    if (found < 0 && reqs[i].trait_name == name && q.len() > 0 && reqs[i].module.len() > 0) {
      found = i;
    }
    i += 1;
  }
  return found;
}

function declared_bound_trait_req(mod: parser.Module, base: string, module: string): i32 {
  let name = parser.derive_simple_name(base);
  let q = spelling_qualifier(base, name);
  if (q.len() > 0) {
    for sight in mod.sights {
      if (sight.module == module) {
        let qi = util.index_of_str(sight.qualifiers, q);
        if (qi >= 0 && qi < sight.direct.len()) {
          let canonical = decltypes.canonical_imported_trait(sight.direct[qi], name, sight.reexport_keys, sight.reexport_targets);
          return derive_trait_idx(canonical, mod.trait_reqs);
        }
      }
    }
  }
  return bound_trait_req(base, module, mod.trait_reqs);
}

function bound_import_unloaded(base: string, imports: string[], reqs: parser.TraitReq[]): boolean {
  let q = spelling_qualifier(base, parser.derive_simple_name(base));
  if (q.len() == 0) {
    return false;
  }
  for r in reqs {
    if (r.module == q) {
      return false;
    }
  }
  for path in imports {
    if (path == q || util.str_has_suffix(path, "/" + q)) {
      return true;
    }
  }
  return false;
}

function bound_decl_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let imports = import_paths_of(mod);
  for fd in mod.funcs {
    let i = 0;
    while (i < fd.type_params.len() && i < fd.bound_traits.len()) {
      let module = fd.module;
      if (i < fd.bound_modules.len()) {
        module = fd.bound_modules[i];
      }
      for entry in parser.split_plus_bounds(fd.bound_traits[i]) {
        out = util.append_diags(out, bound_entry_decl_diags(mod, entry, fd, module, fd.type_params[i], imports, mod.trait_reqs));
      }
      i += 1;
    }
  }
  return out;
}

function bound_entry_decl_diags(mod: parser.Module, entry: string, fd: parser.FuncDecl, module: string, tp: string, imports: string[], reqs: parser.TraitReq[]): util.Diag[] {
  let none: util.Diag[] = [];
  let bref = parser.parse_type_ref(entry);
  if (!e021_source_qualifier_visible(mod, module, bref.base)) {
    return [dg_at("E021", "unknown trait \"" + bref.base + "\" in bound on type parameter " + tp, fd.line, fd.col)];
  }
  if (bound_import_unloaded(bref.base, imports, reqs)) {
    return none;
  }
  let display = bound_trait_display(bref.base, module, reqs);
  if (spelling_qualifier(bref.base, parser.derive_simple_name(bref.base)).len() > 0) {
    display = bref.base;
  }
  let idx = declared_bound_trait_req(mod, bref.base, module);
  if (idx < 0) {
    return [dg_at("E021", "unknown trait \"" + util.demangle(display) + "\" in bound on type parameter " + tp, fd.line, fd.col)];
  }
  let want = reqs[idx].type_params.len();
  if (bref.args.len() != want) {
    return [dg_at("E021", "trait " + util.demangle(display) + " takes " + util.i32_to_string(want) + " type argument(s), " + util.i32_to_string(bref.args.len()) + " supplied in bound on type parameter " + tp, fd.line, fd.col)];
  }
  return none;
}

function array_receiver_matches(rt: string, view: boolean): boolean {
  if (view) {
    return parser.spelling_is_view(rt);
  }
  return rt.len() > 2 && slice_unchecked(rt, 0, 1) != "[" && slice_unchecked(rt, rt.len() - 2, rt.len()) == "[]";
}

function (s: Scope) array_recv_method(field: string, view: boolean): Option[MethodSig] {
  let vk = 0;
  if (view) {
    vk = 1;
  }
  let near = s.nearest_inherent(field, "", vk);
  if (near.len() > 0) {
    return Some(near[0]);
  }
  let i = s.methods.names.chain(field);
  while (i >= 0) {
    let method = s.methods.methods[i];
    let rt = method.receiver_type;
    if (method.name == field && array_receiver_matches(rt, view) && s.method_visible(method)) {
      return Some(method);
    }
    i = s.methods.names.next[i];
  }
  return None;
}

function (s: Scope) array_method_ret_type(c: ast.ExprCall, recv_ty: typeinfo.Type, field: string): typeinfo.Type {
  match (recv_ty) {
    typeinfo.TypeArray(array) => {
      if (!array.view && (field == "append" || field == "with" || field == "truncate")) {
        return recv_ty;
      }
      if (field == "len") {
        return t_i32();
      }
      if let Some(arm) = s.array_recv_method(field, array.view) {
        return generic_method_ret(arm, method_binding(c, arm, recv_ty, s), s);
      }
      if (array.view) {
        return t_unknown("no such array method");
      }
      return t_unknown("no array method `" + field + "`");
    },
    _ => {
      return t_unknown("array_method_ret_type: receiver isn't an array");
    }
  }
}

pub function array_method_sig(s: Scope, field: string, view: boolean): Option[MethodSig] {
  return s.array_recv_method(field, view);
}

pub function (s: Scope) has_struct(name: string): boolean {
  let i = s.structs.index.chain(name);
  while (i >= 0) {
    if (s.structs.structs[i].name == name) {
      return true;
    }
    i = s.structs.index.next[i];
  }
  return false;
}

function (s: Scope) lookup_struct(name: string): Option[StructSig] {
  return find_struct_sig(s.structs, name);
}

function (s: Scope) lookup_variant(name: string): Option[StructSig] {
  let i = s.structs.index.chain(name);
  while (i >= 0) {
    if (s.structs.structs[i].name == name && s.structs.structs[i].enum_owner.len() > 0 && !s.variant_hidden(s.structs.structs[i])) {
      return Some(s.structs.structs[i]);
    }
    i = s.structs.index.next[i];
  }
  return s.lookup_struct(name);
}

function (s: Scope) variant_hidden(v: StructSig): boolean {
  let owner = s.unions.index.find(v.enum_owner);
  if (owner >= 0) {
    let u = s.unions.unions[owner];
    if (u.is_enum && !parser.is_reserved_enum_name(u.name) && !enum_visible_from(u, s.fn_module)) {
      return true;
    }
  }
  if (!s.unions.from_import) {
    return false;
  }
  let e = s.unions.head[sig_name_bucket(v.name)];
  while (e >= 0) {
    let u = s.unions.unions[s.unions.vowner[e]];
    if (s.unions.vnames[e] == v.name && u.name == v.enum_owner) {
      return declared_by_entry(u);
    }
    e = s.unions.next[e];
  }
  return false;
}

function (s: Scope) variant_ambiguous(name: string): boolean {
  let bare = unprefixed_variant(name, s.fn_module);
  let n = 0;
  if (parser.builtin_enum_of(bare).len() > 0) {
    n = 1;
  }
  let last: i32 = -1;
  let e = s.unions.bhead[sig_name_bucket(bare)];
  while (e >= 0) {
    let o = s.unions.vowner[e];
    let u = s.unions.unions[o];
    if (s.unions.bnames[e] == bare && u.is_enum && o != last && enum_visible_from(u, s.fn_module)) {
      n += 1;
      last = o;
    }
    e = s.unions.bnext[e];
  }
  return n >= 2;
}

function (s: Scope) lookup_owned_struct(name: string, owner: string): Option[StructSig] {
  let i = s.structs.index.chain(name);
  while (i >= 0) {
    if (s.structs.structs[i].name == name && s.structs.structs[i].enum_owner == owner) {
      return Some(s.structs.structs[i]);
    }
    i = s.structs.index.next[i];
  }
  return s.lookup_struct(name);
}

function variant_payload_struct(s: Scope, type_name: string): Option[StructSig] {
  if (dot_index(type_name) < 0) {
    return s.lookup_variant(type_name);
  }
  return s.lookup_owned_struct(variant_pattern_name(type_name), variant_pattern_owner(type_name));
}

function field_index(ssig: StructSig, name: string): i32 {
  let i = 0;
  while (i < ssig.field_names.len()) {
    if (ssig.field_names[i] == name) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function variant_payload_type_at(s: Scope, type_name: string, idx: i32): typeinfo.Type {
  let Some(ss) = variant_payload_struct(s, type_name) else {
    return t_unknown("built-in variant payload `" + type_name + "`");
  };
  let want = "__ev";
  if (idx > 0) {
    want = "__ev" + util.i32_to_string(idx);
  }
  let i = 0;
  while (i < ss.field_names.len()) {
    if (ss.field_names[i] == want) {
      return ss.field_types[i];
    }
    i += 1;
  }
  return t_struct(ss.name);
}

function variant_pattern_qualified(type_name: string): boolean {
  let i = 0;
  while (i < type_name.len()) {
    if (type_name[i] == b'.') {
      return true;
    }
    i += 1;
  }
  return false;
}

function variant_pattern_payload_type(s: Scope, name: string, whole: typeinfo.Type, index: i32): typeinfo.Type {
  if let typeinfo.TypeUnion(u) = whole {
    let bare = variant_pattern_name(name);
    if ((u.name == "Option" || u.name == "Result") && parser.builtin_enum_of(bare) == u.name) {
      let arg = 0;
      if (bare == "Err") {
        arg = 1;
      }
      if (index == 0 && bare != "None" && arg < u.args.len()) {
        return u.args[arg];
      }
      if (index == 0 && bare == "Some" && u.args.len() == 0) {
        return t_unknown("unbound T");
      }
      return t_unknown("unresolved generic pattern payload");
    }
  }
  let g = generic_variant_payload_type(s, name, whole, index);
  if (!is_unknown(g) || lit_id(g) >= 0 || unbound_enum_argument(g)) {
    return g;
  }
  return variant_payload_type_at(s, name, index);
}

function generic_variant_payload_type(s: Scope, name: string, whole: typeinfo.Type, index: i32): typeinfo.Type {
  let u = typeinfo.TypeUnion { name: "", args: [] };
  if let typeinfo.TypeUnion(wu) = whole {
    u = wu;
  } else {
    return t_unknown("not a union");
  }
  let us: UnionSig = match (s.lookup_union(u.name)) { Some(sig) => sig, None => { return t_unknown("not a generic enum instance"); } };
  let args = u.args;
  if (args.len() == 0) {
    for tp in us.type_params {
      args = args.append(t_unknown("unbound " + tp));
    }
  }
  if (us.type_params.len() == 0 || us.type_params.len() != args.len()) {
    return t_unknown("not a generic enum instance");
  }
  let want = "__ev";
  if (index > 0) {
    want = "__ev" + util.i32_to_string(index);
  }
  let Some(ss) = s.lookup_owned_struct(variant_pattern_name(name), u.name) else {
    return t_unknown("no payload " + want);
  };
  let i = 0;
  while (i < ss.field_names.len() && i < ss.field_type_names.len()) {
    if (ss.field_names[i] == want) {
      return type_from_ref_subst(parser.parse_type_ref(ss.field_type_names[i]), us.type_params, args, s.type_names());
    }
    i += 1;
  }
  return t_unknown("no payload " + want);
}

function variant_ctor_type(s: Scope, union_name: string, name: string, c: ast.ExprCall): typeinfo.Type {
  let us: UnionSig = match (s.lookup_union(union_name)) {
    Some(sig) => sig, None => {
      if (union_name == "Result" || union_name == "Option") {
        return builtin_ctor_type(union_name, name, c, s);
      }
      return t_union(union_name);
    },
  };
  if (us.type_params.len() == 0) {
    return t_union(union_name);
  }
  let args: typeinfo.Type[] = [];
  for tp in us.type_params {
    args = args.append(t_unknown("unbound " + tp));
  }
  let k = 0;
  while (k < c.args.len()) {
    let ti = payload_type_param(s, us, name, k);
    if (ti >= 0) {
      let payload = inferred_payload(c.args[k], s);
      if (!unbound_enum_argument(args[ti])) {
        payload = join_result_types(args[ti], payload);
      }
      args = args.with(ti, payload);
    } else {
      args = nested_payload_args(s, us, payload_spelling(s, us, name, k), inferred_payload(c.args[k], s), args);
    }
    k += 1;
  }
  return typeinfo.TypeUnion { name: union_name, args: args };
}

function nested_payload_args(s: Scope, us: UnionSig, spelling: string, at: typeinfo.Type, args: typeinfo.Type[]): typeinfo.Type[] {
  if (spelling.len() == 0) {
    return args;
  }
  let none_n: string[] = [];
  let none_t: typeinfo.Type[] = [];
  let (bn, bt) = gc_bind_param(parser.parse_type_ref(spelling), at, us.type_params, s.type_names(), none_n, none_t);
  let out = args;
  let i = 0;
  while (i < bn.len()) {
    let ti = util.index_of_str(us.type_params, bn[i]);
    if (ti >= 0 && unbound_enum_argument(out[ti]) && !is_unknown(bt[i])) {
      out = out.with(ti, bt[i]);
    }
    i += 1;
  }
  return out;
}

function scalar_binding_name(pattern: ast.PatVariant, whole: typeinfo.Type, s: Scope): string {
  if (pattern.scalar_binding) {
    return pattern.type_name;
  }
  if (!pattern.bare_name || !is_primitive_type(whole) || s.has_struct(pattern.type_name) || s.has_union(pattern.type_name) || parser.builtin_enum_of(pattern.type_name).len() > 0) {
    return "";
  }
  if let Some(_) = s.lookup_variant(pattern.type_name) {
    return "";
  }
  return pattern.type_name;
}

function bind_variant_payloads(arm: Scope, look: Scope, pvin0: ast.PatVariant, whole: typeinfo.Type): Scope {
  let scalar_name = scalar_binding_name(pvin0, whole, look);
  if (scalar_name.len() > 0) {
    arm = arm.bind(scalar_name, whole);
    if (pvin0.at_binding.len() > 0) {
      arm = arm.bind(pvin0.at_binding, whole);
    }
    return arm;
  }
  let scrut_enum = "";
  if let typeinfo.TypeUnion(u) = whole {
    scrut_enum = u.name;
  }
  let pvin = pvin0;
  if (scrut_enum.len() > 0 && !variant_pattern_qualified(pvin0.type_name)) {
    pvin = ast.PatVariant { ...pvin0, type_name: scrut_enum + "." + pvin0.type_name };
  }
  let pv = pvin;
  if (parser.is_record_pattern(pv)) {
    if let Some(rss) = variant_payload_struct(look, pv.type_name) {
      if (rss.variant_field_names.len() > 0) {
        pv = parser.rebind_record_positional(pv, rss.variant_field_names);
      }
    }
  }
  let sc = arm;
  if (pv.at_binding.len() > 0 && pv.at_binding != "_") {
    sc = sc.bind(pv.at_binding, whole);
  }
  if (pv.binding.len() > 0 && pv.binding != "_") {
    sc = sc.bind(pv.binding, variant_pattern_payload_type(look, pv.type_name, whole, 0));
  }
  let k = 0;
  while (k < pv.extra_bindings.len()) {
    let nm = pv.extra_bindings[k];
    if (nm.len() > 0 && nm != "_") {
      sc = sc.bind(nm, variant_pattern_payload_type(look, pv.type_name, whole, k + 1));
    }
    k += 1;
  }
  return sc;
}

function (s: Scope) receives(i: i32, recv_type: string): boolean {
  let ms = s.methods.methods[i];
  return ms.receiver_type == recv_type || s.methods.bases[i] == recv_type || is_variant_of(recv_type, ms.receiver_type, s.unions.unions);
}

function (s: Scope) lookup_method(name: string, recv_type: string): Option[MethodSig] {
  if (name == "iter" && recv_type == "Map") {
    if let Some(provider) = s.lookup_method("__iterator", recv_type) {
      return Some(provider);
    }
  }
  let near = s.nearest_inherent(name, recv_type, -1);
  if (near.len() > 0) {
    return Some(near[0]);
  }
  let i = s.methods.names.chain(name);
  while (i >= 0) {
    if (s.methods.methods[i].name != name) {
      i = s.methods.names.next[i];
      continue;
    }
    if (s.receives(i, recv_type)) {
      return Some(s.methods.methods[i]);
    }
    i = s.methods.names.next[i];
  }
  let at = s.trait_spelled_method(name, recv_type);
  if (at >= 0) {
    return Some(s.methods.methods[at]);
  }
  return None;
}

// The inherent declarations of method `field` for a receiver when more than
// one module declares it, narrowed to those nearest the current module: its
// own, then a direct import, then the rest of its import closure. Empty when
// at most one module declares it. view is -1 for a non-array receiver, else
// 0 for an array and 1 for a view.
function (s: Scope) nearest_inherent(field: string, recv_type: string, view: i32): MethodSig[] {
  let none: MethodSig[] = [];
  if (util.index_of_sub(field, ".") >= 0) {
    return none;
  }
  let cands: MethodSig[] = [];
  let i = s.methods.simple.chain(field);
  while (i >= 0) {
    let m = s.methods.methods[i];
    if (m.impl_trait.len() == 0 && method_simple_name(m.name) == field && s.inherent_receives(i, recv_type, view)) {
      cands = cands.append(m);
    }
    i = s.methods.simple.next[i];
  }
  if (cands.len() < 2) {
    return none;
  }
  let best = 3;
  let out: MethodSig[] = [];
  for m in cands {
    let rank = parser.module_rank(s.imports.sights, s.fn_module, m.module);
    if (rank < best) {
      best = rank;
      out = none;
    }
    if (rank == best && rank < 3) {
      out = out.append(m);
    }
  }
  return util.sorted_by(out, sig_declared_after);
}

// The declaration name a call of member reaches when modules clash on it.
function (s: Scope) resolved_member(member: string, recv: typeinfo.Type): string {
  let near: MethodSig[] = [];
  if let typeinfo.TypeArray(a) = recv {
    let vk = 0;
    if (a.view) {
      vk = 1;
    }
    near = s.nearest_inherent(member, "", vk);
  } else {
    let key = receiver_key(recv);
    if (key.len() > 0) {
      near = s.nearest_inherent(member, key, -1);
    }
  }
  if (near.len() > 0) {
    return near[0].name;
  }
  return member;
}

function (s: Scope) inherent_receives(i: i32, recv_type: string, view: i32): boolean {
  if (view >= 0) {
    return array_receiver_matches(s.methods.methods[i].receiver_type, view == 1);
  }
  return s.receives(i, recv_type);
}

function sig_declared_after(a: MethodSig, b: MethodSig): boolean {
  if (a.file != b.file) {
    return a.file > b.file;
  }
  return a.line > b.line;
}

// E074 when two modules at the same distance from the caller both declare the
// called inherent method.
function inherent_tie_diags(fa: ast.ExprFieldAccess, recv_type: string, view: i32, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let near = s.nearest_inherent(fa.field, recv_type, view);
  if (near.len() < 2) {
    return out;
  }
  let providers = "";
  for m in near {
    if (providers.len() > 0) {
      providers += " and ";
    }
    providers = providers + "an inherent method (declared at " + m.file + util.i32_to_string(util.pos_line(m.line)) + ":" + util.i32_to_string(m.col) + ")";
  }
  let on = util.demangle(recv_type);
  if (view == 0) {
    on = "Array";
  } else if (view == 1) {
    on = "slice";
  }
  let msg = "ambiguous method \"" + fa.field + "\" on " + on + ": provided by " + providers;
  return out.append(dg_at("E074", msg, fa.line, fa.col + 1));
}

function (s: Scope) trait_spelled_method(name: string, recv_type: string): i32 {
  let dot = name.len() - 1;
  while (dot >= 0 && name[dot] != b'.') {
    dot -= 1;
  }
  if (dot <= 0) {
    return -1;
  }
  let tname = method_simple_name(slice_unchecked(name, 0, dot) + "");
  let simple = slice_unchecked(name, dot + 1, name.len()) + "";
  let i = s.methods.simple.chain(simple);
  while (i >= 0) {
    let m = s.methods.methods[i];
    if (method_simple_name(m.impl_trait) == tname && method_simple_name(m.name) == simple && (m.receiver_type == recv_type || s.methods.bases[i] == recv_type)) {
      return i;
    }
    i = s.methods.simple.next[i];
  }
  return -1;
}

function (s: Scope) has_method(name: string, recv_type: string): boolean {
  let i = s.methods.names.chain(name);
  while (i >= 0) {
    if (s.methods.methods[i].name != name) {
      i = s.methods.names.next[i];
      continue;
    }
    if (s.methods.methods[i].receiver_type == recv_type) {
      return true;
    }
    if (s.methods.bases[i] == recv_type) {
      return true;
    }
    if (is_variant_of(recv_type, s.methods.methods[i].receiver_type, s.unions.unions)) {
      return true;
    }
    i = s.methods.names.next[i];
  }
  return s.trait_spelled_method(name, recv_type) >= 0;
}

function (s: Scope) has_sig(name: string): boolean {
  return s.sig_at(name) >= 0;
}

function retired_collection_spelling(ns: string, method: string): string {
  if (ns == "Array" && method == "push") {
    return "append";
  }
  if (ns == "Array" && method == "set") {
    return "with";
  }
  if (ns == "Map" && method == "set") {
    return "insert";
  }
  if (ns == "Map" && method == "has") {
    return "contains";
  }
  if (ns == "Map" && (method == "delete" || method == "without")) {
    return "remove";
  }
  if (ns == "Map" && method == "clear") {
    return "cleared";
  }
  return "";
}

function scalar_integer_module(lb: string): string {
  if (lb == "u64" || lb == "usize") {
    return "std/u64";
  }
  if (lb == "u8") {
    return "std/i32";
  }
  if (lb == "u32" || lb == "u16") {
    return "std/u32";
  }
  if (lb == "i64") {
    return "std/i64";
  }
  if (lb == "char") {
    return "";
  }
  return "std/i32";
}

// scalar_module_for: the stdlib module carrying a scalar type's method surface,
// "" for a type whose methods are not in one. u8 uses std/i32, not std/u32 —
// every `pub function (b: u8) …` in the stdlib is declared there, so naming
// std/u32 made the hint unfollowable.
function scalar_module_for(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(it) => {
      return scalar_integer_module(int_label(it));
    },
    typeinfo.TypeFloat(_) => {
      return "std/f64";
    },
    typeinfo.TypeString(_) => {
      return "std/string";
    },
    _ => {
      return "";
    }
  }
  return "";
}

function scalar_method_available(recv: string, method: string): boolean {
  if (recv == "i32" && (method == "to_string_radix" || method == "to_string_padded" || method == "to_string_with_sep")
    || recv == "i64" && method == "to_string_radix"
    || (recv == "f32" || recv == "f64") && method == "to_string_prec") {
    return true;
  }
  return false;
}

// scalar_method_module: scalar_module_for narrowed to the names that module
// actually defines for every scalar. to_string is the f-string desugar target
// and the case that motivates this; keeping the set tight is what stops the
// hint naming a module that would not help.
function scalar_method_module(t: typeinfo.Type, method: string): string {
  let mod = scalar_module_for(t);
  if (mod.len() == 0) {
    return "";
  }
  if (scalar_method_available(display_dispatch_name(t), method)) {
    return mod;
  }
  return "";
}

// module_imported: `path` is in the program's import list. For a single module
// that is its own imports; for a bundle it is the closure flatten.bundle keeps.
pub function (s: Scope) module_imported(path: string): boolean {
  return util.index_of_str(s.imports.paths, path) >= 0;
}

function (s: Scope) imports_directly(path: string): boolean {
  for sg in s.imports.sights {
    if (sg.module == s.fn_module) {
      return util.has_str(sg.imports, path);
    }
  }
  return s.module_imported(path);
}

function (s: Scope) method_visible(m: MethodSig): boolean {
  if (m.impl_trait.len() > 0) {
    return true;
  }
  return s.imports.sees(s.fn_module, m.module) && s.method_scope_admits(m);
}

// A method declared without `pub` is visible only in its own module, and a
// `pub(package)` one only in modules of the same package.
function (s: Scope) method_scope_admits(m: MethodSig): boolean {
  if (m.module == s.fn_module || m.is_pub) {
    return true;
  }
  return m.is_package && s.imports.same_package(s.fn_module, m.module);
}

// A struct's method resolves by its declaration's scope alone: a generic
// body instantiated with a struct of another module calls its methods
// without importing that module.
function (s: Scope) scoped_method(name: string, recv_type: string): Option[MethodSig] {
  if let Some(m) = s.lookup_method(name, recv_type) {
    if (m.impl_trait.len() > 0 || s.method_scope_admits(m)) {
      return Some(m);
    }
  }
  return None;
}

pub function (s: Scope) visible_method(name: string, recv_type: string): Option[MethodSig] {
  if let Some(m) = s.lookup_method(name, recv_type) {
    if (s.method_visible(m)) {
      return Some(m);
    }
  }
  return None;
}

function (s: Scope) methods_in_namespace(ns: string): string[] {
  let out = preregistered_methods(ns);
  for method in s.methods.methods {
    if (method.receiver_type == ns || ns == "Map" && map_receiver_type(method.receiver_type)) {
      out = push_str_unique_sorted(out, method.name);
    }
  }
  return out;
}

function preregistered_methods(ns: string): string[] {
  if (ns == "Array") {
    return ["append", "len", "truncate", "with"];
  }
  if (ns == "slice") {
    return ["len"];
  }
  if (ns == "string") {
    return ["as_bytes", "len"];
  }
  if (ns == "Map") {
    return ["cleared", "contains", "get", "get_or", "insert", "keys", "len", "remove", "values"];
  }
  if (ns == "Cell") {
    return ["get", "set"];
  }
  return [];
}

function map_receiver_type(rt: string): boolean {
  if (rt == "Map") {
    return true;
  }
  return rt.len() > 4 && slice_unchecked(rt, 0, 4) == "Map[";
}

function (s: Scope) namespace_is_exact(ns: string): boolean {
  if (ns != "Array") {
    return true;
  }
  for method in s.methods.methods {
    let rt = method.receiver_type;
    if (rt.len() > 2 && slice_unchecked(rt, rt.len() - 2, rt.len()) == "[]" && s.method_visible(method)) {
      return false;
    }
  }
  return true;
}

function push_str_unique_sorted(xs: string[], v: string): string[] {
  let out: string[] = [];
  let placed = false;
  for x in xs {
    if (x == v) {
      return xs;
    }
    if (!placed && v < x) {
      out = out.append(v);
      placed = true;
    }
    out = out.append(x);
  }
  if (!placed) {
    out = out.append(v);
  }
  return out;
}

function (s: Scope) stdlib_receiver_matches(ns: string, method: string, recv: typeinfo.Type): boolean {
  let written = stdlib_methods.receiver_of(ns, method);
  if (written.len() == 0) {
    return true;
  }
  let ref = parser.parse_type_ref(written);
  let params = stdlib_methods.receiver_params(ns, method);
  let (names, types) = gc_bind_param(ref, recv, params, s.type_names(), [], []);
  if (names.len() != params.len()) {
    return false;
  }
  let expected = type_from_ref_subst(ref, names, types, s.type_names());
  return type_label(expected) == type_label(recv);
}

function (s: Scope) unknown_method_message(ns: string, method: string, label: string, recv: typeinfo.Type): string {
  let base = "no method \"" + method + "\" on " + label;
  let hidden = s.private_method_note(ns, method);
  if (hidden.len() > 0) {
    return base + hidden;
  }
  let repl = retired_collection_spelling(ns, method);
  let view = false;
  if let typeinfo.TypeArray(a) = recv {
    view = a.view;
  }
  if (view) {
    repl = "";
  }
  if (ns == "Map" && (method == "has" || method == "without")) {
    return base + " — it was renamed; use \"" + repl + "\"";
  }
  if (repl.len() > 0) {
    return base + " — the in-place spelling was removed; use \"" + repl
      + "\", which returns the updated " + ns + " (assign the result back)";
  }
  let declared_receiver = stdlib_methods.receiver_of(ns, method);
  if (declared_receiver.len() > 0 && !s.stdlib_receiver_matches(ns, method, recv)) {
    return base + " — \"" + method + "\" is declared for " + declared_receiver + " in \"" + stdlib_methods.module_of(ns, method) + "\"";
  }
  let import_advice = s.stdlib_import_advice(ns, method);
  if (import_advice.len() > 0) {
    return base + import_advice;
  }
  let free = s.free_function_advice(method, recv);
  if (free.len() > 0) {
    return base + free;
  }
  let names = s.method_fix_candidates(ns, recv);
  let did = util.suggest(method, names);
  if (did.len() > 0) {
    return base + " — did you mean \"" + did + "\"?";
  }
  let near_advice = s.stdlib_near_advice(ns, method, recv);
  if (near_advice.len() > 0) {
    return base + near_advice;
  }
  if (stdlib_methods.methods_on(ns).len() > 0) {
    base += ", and no stdlib module declares one";
  }
  return base + method_list(names);
}

function method_list(names: string[]): string {
  if (names.len() == 0) {
    return "";
  }
  let listed = "";
  for n in names {
    if (listed.len() > 0) {
      listed += ", ";
    }
    listed += n;
  }
  return " (it has: " + listed + ")";
}

function (s: Scope) stdlib_import_advice(ns: string, method: string): string {
  let mod = stdlib_methods.module_of(ns, method);
  if (mod.len() == 0 || s.imports_directly(mod)) {
    return "";
  }
  let note = "";
  if (method == "to_string") {
    note = " (an f-string like `f\"{x}\"` desugars to `x.to_string()`)";
  }
  return " — add `import \"" + mod + "\"`" + note;
}

function (s: Scope) stdlib_near_advice(ns: string, method: string, recv: typeinfo.Type): string {
  let near = util.suggest(method, stdlib_methods.methods_on(ns));
  if (near.len() == 0 || !s.stdlib_receiver_matches(ns, near, recv)) {
    return "";
  }
  let mod = stdlib_methods.module_of(ns, near);
  if (s.imports_directly(mod)) {
    return "";
  }
  return " — did you mean \"" + near + "\", which needs `import \"" + mod + "\"`?";
}

function (s: Scope) method_fix_candidates(ns: string, recv: typeinfo.Type): string[] {
  if let typeinfo.TypeArray(a) = recv {
    if (a.view) {
      let names: string[] = ["len"];
      for candidate in s.methods.methods {
        if (parser.spelling_is_view(candidate.receiver_type)) {
          names = push_str_unique_sorted(names, candidate.name);
        }
      }
      return names;
    }
  }
  if (!s.namespace_is_exact(ns)) {
    return s.array_method_candidates(recv);
  }
  let out = preregistered_methods(ns);
  for method in s.methods.methods {
    if ((method.receiver_type == ns || ns == "Map" && map_receiver_type(method.receiver_type)) && s.method_visible(method)) {
      out = push_str_unique_sorted(out, method.name);
    }
  }
  return out;
}

// The methods of modules this module sees whose array receiver can take
// `recv`: the receiver is generic in its element, or names it exactly.
function (s: Scope) array_method_candidates(recv: typeinfo.Type): string[] {
  let out = preregistered_methods("Array");
  let label = type_label(recv);
  for method in s.methods.methods {
    let rt = method.receiver_type;
    if (array_receiver_matches(rt, false) && s.imports.sees(s.fn_module, method.module) && (rt == label || array_element_is_generic(rt) && s.element_meets_bounds(method, rt, recv))) {
      out = push_str_unique_sorted(out, method.name);
    }
  }
  return out;
}

// Whether the element of `recv` meets the bounds that `method` puts on the
// type parameter of its receiver `rt`.
function (s: Scope) element_meets_bounds(method: MethodSig, rt: string, recv: typeinfo.Type): boolean {
  let tp = slice_unchecked(rt, 0, rt.len() - 2) + "";
  let at = util.index_of_str(method.type_params, tp);
  if (at < 0 || at >= method.type_bounds.len()) {
    return true;
  }
  if let typeinfo.TypeArray(a) = recv {
    for entry in parser.split_plus_bounds(method.type_bounds[at]) {
      let base = util.base_type_name(entry);
      if (!bound_import_unloaded(base, s.imports.paths, s.trait_reqs) && !type_implements(s, a.elem, base, method.module)) {
        return false;
      }
    }
  }
  return true;
}

// A receiver `T[]` is generic in its element. The parser spells a type
// parameter that a receiver introduces with a leading digit, `0_T`.
function array_element_is_generic(rt: string): boolean {
  return rt.len() > 2 && rt[0] >= b'0' && rt[0] <= b'9';
}

// The note for a method of this name that its missing `pub` hides here.
function (s: Scope) private_method_note(ns: string, method: string): string {
  for m in s.methods.methods {
    let on_ns = m.receiver_type == ns || ns == "Array" && array_receiver_matches(m.receiver_type, false);
    if (m.name == method && on_ns && m.impl_trait.len() == 0 && s.imports.sees(s.fn_module, m.module) && !s.method_scope_admits(m)) {
      return " — \"" + method + "\" is declared without `pub` in module \"" + s.module_label(m.module) + "\", so only that module can call it";
    }
  }
  return "";
}

// The base name of the module with mangle prefix `prefix`, as the current
// module imports it.
function (s: Scope) module_label(prefix: string): string {
  for sg in s.imports.sights {
    if (sg.module != s.fn_module) {
      continue;
    }
    let i = 0;
    while (i < sg.direct.len() && i < sg.imports.len()) {
      if (sg.direct[i] == prefix) {
        return util.module_name(sg.imports[i]);
      }
      i += 1;
    }
  }
  return prefix;
}

// The advice for a method call that names a public free function of an
// imported module, whose first parameter takes the receiver.
function (s: Scope) free_function_advice(method: string, recv: typeinfo.Type): string {
  for sg in s.imports.sights {
    if (sg.module != s.fn_module) {
      continue;
    }
    let i = 0;
    while (i < sg.imports.len() && i < sg.direct.len()) {
      if let Some(sig) = s.lookup_sig(sg.direct[i] + "__" + method) {
        if (sig.is_pub && sig.receiver.len() == 0 && sig.param_types.len() > 0 && first_param_takes(sig.param_types[0], recv)) {
          return free_function_note(method, sg.imports[i]);
        }
      }
      i += 1;
    }
  }
  return "";
}

function free_function_note(method: string, path: string): string {
  return " — \"" + method + "\" is a function of module \"" + util.module_name(path) + "\", not a method: pass the value as its first argument";
}

function first_param_takes(param: typeinfo.Type, recv: typeinfo.Type): boolean {
  let ns = method_namespace_of(recv);
  return ns.len() > 0 && method_namespace_of(param) == ns;
}

function (s: Scope) unknown_method_advice(ns: string, method: string, recv: typeinfo.Type): string {
  let label = type_label(recv);
  let surface = ns;
  if let typeinfo.TypeUnion(u) = recv {
    surface = u.name;
  }
  if (s.methods_in_namespace(surface).len() > 0 || stdlib_methods.methods_on(surface).len() > 0) {
    return s.unknown_method_message(surface, method, label, recv);
  }
  return "field access on non-struct value of type " + label;
}

function method_namespace_of(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeArray(_) => {
      return "Array";
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function (s: Scope) has_array_recv_method(field: string, view: boolean): boolean {
  if let Some(_) = s.array_recv_method(field, view) {
    return true;
  }
  return false;
}

pub function (s: Scope) has_union(name: string): boolean {
  return s.unions.index.find(name) >= 0;
}

function (s: Scope) lookup_union(name: string): Option[UnionSig] {
  let at = s.unions.index.find(name);
  if (at >= 0) {
    return Some(s.unions.unions[at]);
  }
  return None;
}

function try_able_union(s: Scope, name: string): boolean {
  if (name == "Option" || name == "Result") {
    return true;
  }
  if let Some(us) = s.lookup_union(name) {
    return us.is_try;
  }
  return false;
}

function try_success_type(s: Scope, ot: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(tu) = ot {
    let same_ret = false;
    if let typeinfo.TypeUnion(ru) = s.try_ret {
      same_ret = ru.name == tu.name;
    }
    if let typeinfo.TypeUnknown(ru) = s.try_ret {
      same_ret = ru.reason == INFERRED_RESULT;
    }
    if (!same_ret) {
      return t_unknown("`?` outside a function returning " + tu.name);
    }
    if ((tu.name == "Option" || tu.name == "Result") && tu.args.len() > 0) {
      return tu.args[0];
    }
    if let Some(us) = s.lookup_union(tu.name) {
      if (us.is_try && us.variants.len() == 2) {
        return variant_pattern_payload_type(s, tu.name + "." + us.variants[0], ot, 0);
      }
    }
  }
  return t_unknown("`?` operand is not a resolved `?`-able enum");
}

function is_variant_of(struct_name: string, union_name: string, unions: UnionSig[]): boolean {
  for union in unions {
    if (union.name == union_name) {
      for variant in union.variants {
        if (variant == struct_name) {
          return true;
        }
      }
      return false;
    }
  }
  return false;
}

function nested_assignable(from: typeinfo.Type, to: typeinfo.Type, unions: UnionSig[]): boolean {
  if let typeinfo.TypeDyn(_) = to {
    return type_eq(from, to);
  }
  return type_assignable(from, to, unions);
}

function coercible(from: typeinfo.Type, to: typeinfo.Type, s: Scope): boolean {
  return type_assignable(from, to, s.unions.unions) && dyn_conforms(from, to, s);
}

function dyn_conforms(from: typeinfo.Type, to: typeinfo.Type, s: Scope): boolean {
  if let typeinfo.TypeNever(_) = from {
    return true;
  }
  let traits = "";
  if let typeinfo.TypeDyn(d) = to {
    traits = d.traits;
  } else {
    return true;
  }
  if let typeinfo.TypeDyn(_) = from {
    return type_eq(from, to);
  }
  if (is_unknown(from)) {
    return true;
  }
  if let typeinfo.TypeErased(_) = from {
    return true;
  }
  if (is_owned_array(from) || is_arr_view(from)) {
    return false;
  }
  let tn = util.base_type_name(type_label(from));
  if (tn.len() == 0) {
    return true;
  }
  for tr in parser.dyn_trait_set("dyn " + traits) {
    if (!conforms_to_dyn_trait(s, tn, tr)) {
      return false;
    }
  }
  return true;
}

function ctor_payload_diags(e: ast.Expr, to: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let args: typeinfo.Type[] = [];
  let owner = "";
  if let typeinfo.TypeUnion(u) = to {
    args = u.args;
    owner = u.name;
  } else {
    return out;
  }
  if let ast.ExprCall(c) = e {
    if (!constructor_destination(c, to, s)) {
      return out;
    }
    let vname = ctor_variant_name(c);
    let k = 0;
    while (k < c.args.len()) {
      let slot = ctor_payload_slot(s, owner, vname, k);
      if (slot >= 0 && slot < args.len()) {
        let pt = args[slot];
        out = util.append_diags(out, int_dest_range_diags(c.args[k], pt));
        out = util.append_diags(out, ctor_payload_diags(c.args[k], pt, s));
        if let typeinfo.TypeDyn(_) = pt {
          let at = check_expr(c.args[k], s);
          if (!is_unknown(at) && !dyn_conforms(at, pt, s)) {
            out = out.append(dg_at("E033", "cannot cast " + type_label(at) + " to " + type_label(pt) + ": `as` converts only between numeric types", expr_line(c.args[k]), expr_col(c.args[k])));
          }
        }
      }
      k += 1;
    }
  }
  return out;
}

function ctor_name_taken(c: ast.ExprCall, s: Scope): boolean {
  if let ast.ExprIdent(id) = c.callee {
    return s.known(id.name) || s.has_sig(id.name);
  }
  return false;
}

function ctor_variant_name(c: ast.ExprCall): string {
  if let ast.ExprIdent(id) = c.callee {
    return id.name;
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    return fa.field;
  }
  return "";
}

function ctor_payload_slot(s: Scope, owner: string, vname: string, k: i32): i32 {
  if (owner == "Option" || owner == "Result") {
    if (k != 0) {
      return -1;
    }
    if (owner == "Option" && vname == "Some" || owner == "Result" && vname == "Ok") {
      return 0;
    }
    if (owner == "Result" && vname == "Err") {
      return 1;
    }
    return -1;
  }
  if (scope_variant_owner(vname, s) != owner) {
    return -1;
  }
  if let Some(us) = s.lookup_union(owner) {
    return payload_type_param(s, us, vname, k);
  }
  return -1;
}

function payload_type_param(s: Scope, us: UnionSig, vname: string, k: i32): i32 {
  return util.index_of_str(us.type_params, payload_spelling(s, us, vname, k));
}

function payload_spelling(s: Scope, us: UnionSig, vname: string, k: i32): string {
  let Some(ss) = s.lookup_owned_struct(variant_pattern_name(vname), us.name) else {
    return "";
  };
  let want = "__ev";
  if (k > 0) {
    want = "__ev" + util.i32_to_string(k);
  }
  let fi = util.index_of_str(ss.field_names, want);
  if (fi < 0 || fi >= ss.field_type_names.len()) {
    return "";
  }
  return ss.field_type_names[fi];
}

function promotes_view(from: typeinfo.Type, to: typeinfo.Type): boolean {
  return shifts_view(from, to, true);
}

function lends_array_view(from: typeinfo.Type, to: typeinfo.Type): boolean {
  return shifts_view(to, from, false);
}

function shifts_view(from: typeinfo.Type, to: typeinfo.Type, strings: boolean): boolean {
  if (strings && is_str_view(from) && is_owned_string(to)) {
    return true;
  }
  match (from) {
    typeinfo.TypeArray(fa) => {
      if let typeinfo.TypeArray(ta) = to {
        return fa.view && !ta.view || shifts_view(fa.elem, ta.elem, strings);
      }
    },
    typeinfo.TypeTuple(ft) => {
      if let typeinfo.TypeTuple(tt) = to {
        return any_shifts_view(ft.elements, tt.elements, strings);
      }
    },
    typeinfo.TypeMap(fm) => {
      if let typeinfo.TypeMap(tm) = to {
        return shifts_view(fm.key, tm.key, strings) || shifts_view(fm.value, tm.value, strings);
      }
    },
    typeinfo.TypeUnion(fu) => {
      if let typeinfo.TypeUnion(tu) = to {
        return any_shifts_view(fu.args, tu.args, strings);
      }
    },
    typeinfo.TypeStruct(fs) => {
      if let typeinfo.TypeStruct(ts) = to {
        return any_shifts_view(fs.args, ts.args, strings);
      }
    },
    _ => {}
  }
  return false;
}

function same_element_type(a: typeinfo.Type, b: typeinfo.Type): boolean {
  return type_eq(a, b) && !promotes_view(a, b) && !promotes_view(b, a);
}

function any_shifts_view(from: typeinfo.Type[], to: typeinfo.Type[], strings: boolean): boolean {
  if (from.len() != to.len()) {
    return false;
  }
  let i = 0;
  while (i < from.len()) {
    if (shifts_view(from[i], to[i], strings)) {
      return true;
    }
    i += 1;
  }
  return false;
}

function type_assignable(from: typeinfo.Type, to: typeinfo.Type, unions: UnionSig[]): boolean {
  if let typeinfo.TypeNever(_) = from {
    return true;
  }
  if (integer_literal_widens(from, to)) {
    return true;
  }
  if let typeinfo.TypeFunc(tf) = to {
    if let typeinfo.TypeFunc(ff) = from {
      return callable_assignable(ff, tf, unions);
    }
    return is_unknown(from);
  }
  if (promotes_view(from, to) || lends_array_view(from, to)) {
    return false;
  }
  if (nominal_args_clash(from, to, unions)) {
    return false;
  }
  // type_eq ignores nominal arguments, so an aggregate checks its components below.
  if (type_eq(from, to) && !is_tuple_or_array(to)) {
    return true;
  }
  match (to) {
    typeinfo.TypeArray(te) => {
      match (from) {
        typeinfo.TypeArray(fe) => {
          if (is_unknown(fe.elem) || is_unknown(te.elem)) {
            return true;
          }
          return nested_assignable(fe.elem, te.elem, unions);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeTuple(te) => {
      match (from) {
        typeinfo.TypeTuple(fe) => {
          if (fe.elements.len() != te.elements.len()) {
            return false;
          }
          let i = 0;
          while (i < te.elements.len()) {
            if (!is_unknown(fe.elements[i]) && !is_unknown(te.elements[i]) && !nested_assignable(fe.elements[i], te.elements[i], unions)) {
              return false;
            }
            i += 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeUnion(un) => {
      match (from) {
        typeinfo.TypeStruct(sn) => {
          return is_variant_of(sn.name, un.name, unions);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeMap(tm) => {
      match (from) {
        typeinfo.TypeMap(fm) => {
          let kok = is_unknown(fm.key) || is_unknown(tm.key) || nested_assignable(fm.key, tm.key, unions);
          let vok = is_unknown(fm.value) || is_unknown(tm.value) || nested_assignable(fm.value, tm.value, unions);
          return kok && vok;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeHandle(th) => {
      if let typeinfo.TypeHandle(fh) = from {
        return th.borrowed && !fh.borrowed && th.resource == fh.resource;
      }
      return false;
    },
    typeinfo.TypeDyn(_) => {
      return !is_str_view(from) && !is_arr_view(from);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function callable_assignable(from: typeinfo.TypeFunc, to: typeinfo.TypeFunc, unions: UnionSig[]): boolean {
  if (!from.params_known || !to.params_known) {
    return true;
  }
  if (from.param_types.len() != to.param_types.len() || !callable_slot_matches(from.ret_type, to.ret_type, unions)) {
    return false;
  }
  let i = 0;
  while (i < from.param_types.len()) {
    let fp = from.param_types[i];
    let tp = to.param_types[i];
    if (callable_slot_open(fp) || callable_slot_open(tp)) {
      i += 1;
      continue;
    }
    if (typeinfo.fn_own_at(from, i) != typeinfo.fn_own_at(to, i) || !callable_slot_matches(fp, tp, unions)) {
      return false;
    }
    i += 1;
  }
  return true;
}

function callable_slot_open(t: typeinfo.Type): boolean {
  if let typeinfo.TypeUnknown(u) = t {
    return !util.str_has_prefix(u.reason, TPARAM_MARK) && !util.str_has_prefix(u.reason, UNRESOLVED_MARK);
  }
  return false;
}

function callable_slot_matches(a: typeinfo.Type, b: typeinfo.Type, unions: UnionSig[]): boolean {
  if (callable_slot_open(a) || callable_slot_open(b)) {
    return true;
  }
  if (is_type_variable(a) || is_type_variable(b)) {
    return is_type_variable(a) && is_type_variable(b) && callable_typevar_name(a) == callable_typevar_name(b);
  }
  return type_assignable(a, b, unions) && type_assignable(b, a, unions);
}

function callable_typevar_name(t: typeinfo.Type): string {
  if let typeinfo.TypeErased(e) = t {
    return e.name;
  }
  return tvar_name(t);
}

function type_from_name(name: string): typeinfo.Type {
  return type_from_spelling(name, type_names([], [], []));
}

function call_through_fn_value(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (desugared_lambda(c.callee)) {
    return t_unknown("immediately-invoked lambda: typed from its branches, not its value");
  }
  let ct = check_expr(c.callee, s);
  match (ct) {
    typeinfo.TypeFunc(tf) => {
      if (!tf.params_known) {
        return tf.ret_type;
      }
      if (c.args.len() != tf.param_types.len()) {
        return t_unknown("arity mismatch calling function value");
      }
      return tf.ret_type;
    },
    _ => {}
  }
  return t_unknown("call target is not a function value");
}

function desugared_lambda(e: ast.Expr): boolean {
  if let ast.ExprLambda(lm) = e {
    return !parser.is_written_lambda_origin(lm.origin);
  }
  return false;
}

function ret_typevar_arg_type(sig: FuncSig, c: ast.ExprCall, s: Scope): (typeinfo.Type, boolean) {
  let (wn, wt) = written_type_bindings(sig, c, s);
  let wi = util.index_of_str(wn, sig.ret_type_name);
  if (wi >= 0) {
    return (wt[wi], true);
  }
  let rt = t_unknown("no parameter names " + sig.ret_type_name);
  let bound = false;
  let empty = rt;
  let has_empty = false;
  let k = 0;
  while (k < sig.param_type_names.len()) {
    if (sig.param_type_names[k] == sig.ret_type_name && k < c.args.len()) {
      let kt = check_expr(c.args[k], s);
      if (elemless_array(kt)) {
        if (!has_empty) {
          empty = kt;
          has_empty = true;
        }
      } else if (bound) {
        rt = joined_return_argument(rt, kt);
      } else {
        rt = kt;
        bound = true;
      }
    }
    k += 1;
  }
  if (!bound && has_empty && !call_binds_elsewhere(sig, c, s)) {
    return (empty, true);
  }
  return (rt, bound);
}

function joined_return_argument(a: typeinfo.Type, b: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(au) = a {
    if let typeinfo.TypeUnion(bu) = b {
      return join_enum_arguments(au, bu);
    }
  }
  return wider_int(a, b);
}

function call_binds_elsewhere(sig: FuncSig, c: ast.ExprCall, s: Scope): boolean {
  let (bn, _) = arg_bindings(sig, c, s);
  return util.index_of_str(bn, sig.ret_type_name) >= 0;
}

function shared_literal_typevar_width(sig: FuncSig, c: ast.ExprCall, tp: string, s: Scope): (typeinfo.Type, boolean) {
  let wt = t_unknown("no literal argument binds " + tp);
  if (c.type_args.len() > 0) {
    return (wt, false);
  }
  let n = 0;
  let k = 0;
  while (k < sig.param_type_names.len() && k < c.args.len()) {
    if (sig.param_type_names[k] == tp) {
      if (!int_literal_tree(c.args[k])) {
        return (wt, false);
      }
      let kt = check_expr(c.args[k], s);
      if (n == 0) {
        wt = kt;
      } else {
        wt = wider_int(wt, kt);
      }
      n += 1;
    }
    k += 1;
  }
  return (wt, n >= 2 && is_integer(wt));
}

function settle_shared_literal_typevars(c: ast.ExprCall, nargs: ast.Expr[], s: Scope): ast.Expr[] {
  let name = "";
  if let ast.ExprIdent(cid) = c.callee {
    name = cid.name;
  }
  let at: i32 = -1;
  if (name.len() > 0) {
    at = s.sig_at(name);
  }
  if (at < 0) {
    return nargs;
  }
  let sig = s.sigs.sigs[at];
  let out = nargs;
  for tp in sig.typevars {
    let (wty, wok) = shared_literal_typevar_width(sig, c, tp, s);
    if (wok) {
      let tag = type_to_irtag(wty);
      let k = 0;
      while (k < sig.param_type_names.len() && k < out.len()) {
        if (sig.param_type_names[k] == tp) {
          out = out.with(k, settle_int_tree(out[k], tag));
        }
        k += 1;
      }
    }
  }
  return out;
}

pub function builtin_sig(name: string): typeinfo.Type {
  let row = builtinsigs.builtin_row(name);
  if (row.len() == 0) {
    return t_unknown("not a builtin: " + name);
  }
  let close = util.index_of_sub(row, "): ");
  let inner = slice_unchecked(row, name.len() + 1, close) + "";
  let params: typeinfo.Type[] = [];
  if (inner.len() > 0) {
    for p in parser.split_top_commas(inner) {
      params = params.append(type_from_name(p));
    }
  }
  return t_func(params, type_from_name(slice_unchecked(row, close + 3, row.len()) + ""));
}

// Primitive display signatures are completed by private runtime source bodies.
function is_primitive_display_builtin(name: string): boolean {
  return util.str_has_prefix(name, "__primitive_") && builtinsigs.builtin_row(name).len() > 0;
}

// builtin_method_sig is a builtin method's callable without its receiver, or
// unknown when `recv_name` has no builtin method `name`.
pub function builtin_method_sig(recv_name: string, name: string): typeinfo.Type {
  let builtin_name = "__method_" + recv_name + "_" + name;
  if (name == "to_string" && recv_name != "boolean") {
    builtin_name = "__primitive_" + recv_name + "_to_string";
  }
  if let typeinfo.TypeFunc(bm) = builtin_sig(builtin_name) {
    let params: typeinfo.Type[] = [];
    let i = 1;
    while (i < bm.param_types.len()) {
      params = params.append(bm.param_types[i]);
      i += 1;
    }
    return t_func(params, bm.ret_type);
  }
  return t_unknown("not a builtin method: " + recv_name + "." + name);
}

function undeclared_call_type(name: string, s: Scope, args: ast.Expr[]): typeinfo.Type {
  if let typeinfo.TypeFunc(bf) = builtin_sig(name) {
    if (bf.param_types.len() == args.len()) {
      return bf.ret_type;
    }
  }
  let body = parser.mkclo_body(name);
  let at: i32 = -1;
  if (body.len() > 0) {
    at = s.sig_at(body);
  }
  if (at < 0) {
    return t_unknown("undefined function: " + name);
  }
  let sig = s.sigs.sigs[at];
  if (!closure_env_param(sig)) {
    return t_unknown("undefined function: " + name);
  }
  return t_func_after_env(sig);
}

function closure_env_param(sig: FuncSig): boolean {
  if (sig.param_types.len() == 0) {
    return false;
  }
  if let typeinfo.TypeArray(a) = sig.param_types[0] {
    if let typeinfo.TypeI32(_) = a.elem {
      return true;
    }
  }
  return false;
}

function t_func_after_env(sig: FuncSig): typeinfo.Type {
  let params: typeinfo.Type[] = [];
  let owns: boolean[] = [];
  let i = 1;
  while (i < sig.param_types.len()) {
    params = params.append(sig.param_types[i]);
    owns = owns.append(i < sig.param_own.len() && sig.param_own[i]);
    i += 1;
  }
  return t_func_own(params, owns, sig.ret_type);
}

function inferred_payload(e: ast.Expr, s: Scope): typeinfo.Type {
  return unsettled_marked(check_expr(e, s), e, s.lit_locals, true);
}

function integer_literal_widens(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(a) = from {
    if let typeinfo.TypeI32(b) = to {
      return a.polymorphic && !a.is_char && !b.is_char && a.unsigned == b.unsigned
        && a.width > 0 && a.width < b.width;
    }
  }
  return false;
}

function builtin_ctor_type(en: string, name: string, c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (name == "Some" && c.args.len() == 1) {
    return t_union_g(en, [inferred_payload(c.args[0], s)]);
  }
  if (name == "Ok" && c.args.len() == 1) {
    return t_union_g(en, [inferred_payload(c.args[0], s), t_unknown("unbound E")]);
  }
  if (name == "Err" && c.args.len() == 1) {
    return t_union_g(en, [t_unknown("unbound T"), inferred_payload(c.args[0], s)]);
  }
  return t_union(en);
}

function literal_insert_columns(c: ast.ExprCall, mt: typeinfo.TypeMap, recv_ty: typeinfo.Type, s: Scope): typeinfo.Type {
  if (!literal_insert(c) || !is_unknown(mt.key) && !is_unknown(mt.value)) {
    return recv_ty;
  }
  let ik = mt.key;
  let iv = mt.value;
  if (is_unknown(ik)) {
    ik = check_expr(c.args[0], s);
  }
  if (is_unknown(iv)) {
    iv = check_expr(c.args[1], s);
  }
  return t_map(ik, iv);
}

pub function receiver_key(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeStruct(sn) => {
      return sn.name;
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeMap(_) => {
      return "Map";
    },
    typeinfo.TypeUnion(un) => {
      return un.name;
    },
    typeinfo.TypeLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    typeinfo.TypeTuple(tup) => {
      return parser.tuple_arity_namespace(tup.elements.len());
    },
    _ => {
      return "";
    }
  }
  return "";
}

// `__send_copy` has its argument's type, `__send_adopt` the type of its
// binding, and `__send_root` is an address.
function send_builtin_type(name: string, c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (name == "__send_copy") {
    return check_expr(c.args[0], s);
  }
  if (name == "__send_adopt") {
    return t_unknown("__send_adopt takes the declared type of its binding");
  }
  if (name == "__send_release") {
    return t_void();
  }
  return t_usize();
}

function check_call_expr(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (c.args.len() == 0) {
    match (c.callee) {
      ast.ExprLambda(lm) => {
        if (lm.params.len() == 0 && lm.body.len() == 1) {
          let bts: typeinfo.Type[] = [];
          match (lm.body[0]) {
            ast.StmtIf(f) => {
              bts = mx_if_branch_types(f, s);
            },
            ast.StmtMatch(m) => {
              bts = mx_match_arm_types(m, s);
            },
            _ => {}
          }
          if (bts.len() > 0) {
            let result = vb_arms_unified(bts, mx_body_result_exprs(lm.body));
            if (!is_unknown(result)) {
              return result;
            }
            if (parser.is_value_block_origin(lm.origin)) {
              let arms = mx_body_result_exprs(lm.body);
              let fold = vb_arms_fold(bts, arms, s);
              if (is_unknown(fold.acc.t)) {
                return t_unknown("value block arms disagree");
              }
              if (!fold.ok) {
                return fold.acc.t;
              }
              let tag = lambda_ret_type(lm, s);
              let bi = 0;
              while (bi < bts.len() && bi < arms.len()) {
                if (!arm_int_literal(arms[bi]) && !is_unknown(bts[bi]) && !type_eq(bts[bi], tag)) {
                  return bts[bi];
                }
                bi += 1;
              }
            }
          }
        }
        let vlocal = vb_local_name(lm.body);
        if (lm.params.len() == 0 && vlocal.len() > 0) {
          return vb_store_type(lm.body, vlocal, s);
        }
        // A computed scrutinee adds a temporary before the inner value expression.
        if (lm.params.len() == 0 && (lm.origin == parser.ORIGIN_BLOCK
          || lm.origin == parser.ORIGIN_MATCH_EXPR || lm.origin == parser.ORIGIN_IF_EXPR)) {
          return value_block_tail_type(lm.body, s);
        }
      },
      _ => {}
    }
  }
  let name = "";
  let is_method = false;
  let recv_type_name = "";
  let recv_ty = t_unknown("");
  match (c.callee) {
    ast.ExprIdent(id) => {
      name = id.name;
    },
    ast.ExprFieldAccess(fa) => {
      let qhandled = false;
      match (fa.obj) {
        ast.ExprIdent(ns_id) => {
          let qname = ns_id.name + "." + fa.field;
          if (s.has_sig(qname)) {
            name = qname;
            qhandled = true;
          }
        },
        _ => {}
      }
      if (!qhandled) {
        let cqu = qual_variant_union(fa, s);
        if (cqu.len() > 0) {
          return variant_ctor_type(s, cqu, fa.field, c);
        }
      }
      if (!qhandled) {
        let ah = assoc_call_req(fa.obj, fa.field, s, fa.const_read);
        if (ah.found) {
          if (ah.ret.len() == 0) {
            if let ast.ExprIdent(aoid) = fa.obj {
              if let Some(asig) = s.lookup_assoc_sig(aoid.name, fa.field) {
                return sig_call_type(asig, fa.field, c, s);
              }
            }
          }
          return assoc_hit_type(ah, fa.obj, s);
        }
      }
      if (!qhandled) {
        name = fa.field;
        is_method = true;
        recv_ty = check_expr(fa.obj, s);
        let arr_mt = s.array_method_ret_type(c, recv_ty, name);
        if (!is_unknown(arr_mt)) {
          return arr_mt;
        }
        recv_type_name = receiver_key(recv_ty);
        if (tuple_element_field(recv_ty, name)) {
          recv_type_name = "";
        }
        if (recv_type_name.len() == 0) {
          if let typeinfo.TypeDyn(d) = recv_ty {
            return dyn_method_type(d.traits, name, s);
          }
          match (bound_method(s, tp_receiver(recv_ty, s), name)) {
            Some(msig) => {
              return generic_method_ret(msig, method_binding(c, msig, recv_ty, s), s);
            },
            None => {}
          }
          let tvr = call_through_fn_value(c, s);
          if (!is_unknown(tvr)) {
            return tvr;
          }
          return t_unknown("method call: receiver isn't a typed value");
        }
      }
    },
    _ => {
      return call_through_fn_value(c, s);
    }
  }
  if (!is_method && is_map_new_name(name)) {
    return t_map(t_unknown(MAP_NEW_KEY), t_unknown(MAP_NEW_VALUE));
  }
  if (!is_method && name == "cell_new") {
    return cell_new_type(c, s);
  }
  if (!is_method && parser.is_send_builtin(name) && c.args.len() == 1) {
    return send_builtin_type(name, c, s);
  }
  if (!is_method && (name == "print" || name == "eprint") && c.args.len() == 1) {
    return t_void();
  }
  if (!is_method && (name == "target_os" || name == "target_arch") && c.args.len() == 0) {
    return t_string();
  }
  if (!is_method && name == "slice_unchecked") {
    return slice_unchecked_type(c, s);
  }
  let builtin_typed = builtin_result_type(recv_ty, name, is_method, c.args.len(), s);
  if (!is_unknown(builtin_typed)) {
    return builtin_typed;
  }
  if (is_method && name == "len" && c.args.len() == 0) {
    match (recv_ty) {
      typeinfo.TypeString(_) => {
        return t_i32();
      },
      _ => {}
    }
  }
  if (is_method && name == "as_bytes" && c.args.len() == 0) {
    match (recv_ty) {
      typeinfo.TypeString(_) => {
        return t_view(t_u8());
      },
      _ => {}
    }
  }
  if (is_method) {
    let source_recv_ty = recv_ty;
    recv_ty = map_method_receiver(c, recv_ty);
    match (recv_ty) {
      typeinfo.TypeMap(mt) => {
        if (name == "insert") {
          if (c.args.len() != 2) {
            return t_unknown("map.insert: 2 args");
          }
          return literal_insert_columns(c, mt, recv_ty, s);
        }
        if (name == "get_or") {
          if (c.args.len() != 2) {
            return t_unknown("map.get_or: 2 args");
          }
          return mt.value;
        }
        if (name == "get" && c.args.len() == 1) {
          return t_union_g("Option", [mt.value]);
        }
        if (name == "contains") {
          if (c.args.len() != 1) {
            return t_unknown("map.contains: 1 arg");
          }
          return t_bool();
        }
        if (name == "remove") {
          if (c.args.len() != 1) {
            return t_unknown("map.remove: 1 arg");
          }
          return recv_ty;
        }
        if (name == "len") {
          if (c.args.len() != 0) {
            return t_unknown("map.len: 0 args");
          }
          return t_i32();
        }
        if (name == "keys") {
          return t_array(mt.key);
        }
        if (name == "values") {
          return t_array(mt.value);
        }
        if (name == "cleared") {
          if (c.args.len() != 0) {
            return t_unknown("map.cleared: 0 args");
          }
          return recv_ty;
        }
      },
      _ => {}
    }
    if let Some(msig) = s.lookup_method(name, recv_type_name) {
      if (map_source_receiver_missing(source_recv_ty, msig)) {
        return t_unknown("method receiver lacks map columns");
      }
      if (c.args.len() != msig.param_types.len()) {
        return t_unknown("arity mismatch calling method `" + name + "`");
      }
      return generic_method_ret(msig, method_binding(c, msig, recv_ty, s), s);
    } else {
      if let typeinfo.TypeFunc(bm) = builtin_method_sig(recv_type_name, name) {
        if (bm.param_types.len() == c.args.len()) {
          return bm.ret_type;
        }
      }
      if let typeinfo.TypeStruct(cfsn) = recv_ty {
        if let typeinfo.TypeFunc(cff) = struct_field_type(cfsn, name, s) {
          return cff.ret_type;
        }
      }
      return t_unknown("undefined method `" + name + "` on `" + recv_type_name + "`");
    }
  }
  let bound_at = s.binding_index(name);
  if let ast.ExprIdent(cid) = c.callee {
    bound_at = s.ident_binding(cid);
  }
  if (bound_at >= 0) {
    if let typeinfo.TypeFunc(tf) = s.types[bound_at] {
      if (!tf.params_known) {
        return tf.ret_type;
      }
      if (c.args.len() != tf.param_types.len()) {
        return t_unknown("arity mismatch calling closure `" + name + "`");
      }
      return tf.ret_type;
    }
  }
  let ctor_shadowed = ctor_name_taken(c, s);
  if (!ctor_shadowed && s.variant_ambiguous(name)) {
    return t_unknown("ambiguous variant `" + name + "`");
  }
  let ctor_user = "";
  if (!ctor_shadowed) {
    ctor_user = scope_variant_owner(name, s);
  }
  if (ctor_user.len() > 0) {
    return variant_ctor_type(s, ctor_user, name, c);
  }
  let ctor_enum = "";
  if (!ctor_shadowed) {
    ctor_enum = parser.builtin_enum_of(name);
  }
  if (ctor_enum.len() > 0) {
    return builtin_ctor_type(ctor_enum, name, c, s);
  }
  let at = s.sig_at(name);
  if (at < 0) {
    return undeclared_call_type(name, s, c.args);
  }
  return sig_call_type(s.sigs.sigs[at], name, c, s);
}

function sig_call_type(sig: FuncSig, name: string, c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (c.args.len() != sig.param_types.len()) {
    return t_unknown("arity mismatch calling `" + name + "`");
  }
  let bn: string[] = [];
  let bt: typeinfo.Type[] = [];
  if (sig.all_type_params.len() > 0) {
    let (names, types) = call_type_bindings(sig, c, s);
    bn = names;
    bt = types;
  }
  if (sig.all_type_params.len() > 0 && is_unknown(sig.ret_type) && sig.ret_type_name.len() > 0) {
    let (rtv, rtv_bound) = ret_typevar_arg_type(sig, c, s);
    if (rtv_bound) {
      return rtv;
    }
  }
  return inferred_sig_ret(sig, c, s, bn, bt);
}

function inferred_sig_ret(sig: FuncSig, c: ast.ExprCall, s: Scope, names: string[], types: typeinfo.Type[]): typeinfo.Type {
  let bn = names;
  let bt = types;
  if (type_contains_unknown(sig.ret_type) && sig.ret_type_name.len() > 0) {
    if (sig.all_type_params.len() == 0) {
      let (names, types) = call_type_bindings(sig, c, s);
      bn = names;
      bt = types;
    }
    for tp in sig.type_params {
      if (util.index_of_str(bn, tp) < 0) {
        bn = bn.append(tp);
        bt = bt.append(t_unknown(TPARAM_MARK + tp));
      }
    }
    if (bn.len() > 0 && util.contains(sig.ret_type_name, "::")) {
      let pty = projected_ret(sig.ret_type_name, bn, bt, s);
      if (!type_contains_unknown(pty)) {
        return pty;
      }
    }
    if (bn.len() > 0) {
      let gsubst = type_from_ref_subst(sig_ret_ref(sig), bn, bt, s.type_names());
      if (!type_contains_unknown(gsubst)) {
        return gsubst;
      }
    }
  }
  return sig.ret_type;
}

function arg_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let (wn, wt) = written_type_bindings(sig, c, s);
  let (tn, tt) = bind_from_args(sig, c, s, false, wn, wt);
  return bind_from_args(sig, c, s, true, tn, tt);
}

function bind_from_args(sig: FuncSig, c: ast.ExprCall, s: Scope, literals: boolean, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  let bn = names;
  let bt = types;
  let i = 0;
  while (i < sig.param_type_names.len() && i < c.args.len()) {
    if (int_literal_tree(c.args[i]) == literals && !binds_nothing(c.args[i], s)) {
      let (bn2, bt2) = gc_bind_param(sig_param_ref(sig, i), check_expr(c.args[i], s), sig.type_params, s.type_names(), bn, bt);
      bn = bn2;
      bt = bt2;
    }
    i += 1;
  }
  return (bn, bt);
}

function call_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let (wn, wt) = written_type_bindings(sig, c, s);
  let (tn, tt) = bind_from_args(sig, c, s, false, wn, wt);
  let (bn, bt) = bound_bindings(sig, s, tn, tt);
  let (ln, lt) = bind_from_args(sig, c, s, true, tn, tt);
  let i = tn.len();
  while (i < ln.len()) {
    let bi = util.index_of_str(bn, ln[i]);
    if (bi >= 0 && is_integer(lt[i]) && is_integer(bt[bi])) {
      lt = lt.with(i, bt[bi]);
    }
    i += 1;
  }
  return bound_bindings(sig, s, ln, lt);
}

function written_type_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let bn: string[] = [];
  let bt: typeinfo.Type[] = [];
  if (c.type_args.len() != sig.all_type_params.len()) {
    return (bn, bt);
  }
  let i = 0;
  while (i < c.type_args.len()) {
    if (c.type_args[i].len() > 0) {
      let wt = type_from_spelling(c.type_args[i], s.type_names());
      // An integer for a type parameter is E090, and the arguments still
      // infer that parameter.
      let int_for_type: boolean = match (wt) { typeinfo.TypeConst(_) => !sig_tparam_is_const(sig, sig.all_type_params[i]), _ => false };
      if (!type_contains_unknown(wt) && !int_for_type) {
        bn = bn.append(sig.all_type_params[i]);
        bt = bt.append(wt);
      }
    }
    i += 1;
  }
  return (bn, bt);
}

function bound_type_arg_diags(sig: FuncSig, c: ast.ExprCall, ai: i32, at: typeinfo.Type, s: Scope, wn: string[], wt: typeinfo.Type[]): util.Diag[] {
  let none: util.Diag[] = [];
  if (ai >= sig.param_type_names.len() || !type_contains_unknown(sig.param_types[ai])) {
    return none;
  }
  let pref = sig_param_ref(sig, ai);
  if (wn.len() == 0 || !type_ref_names_any(pref, wn)) {
    return none;
  }
  let want = type_from_ref_subst(pref, wn, wt, s.type_names());
  if (type_contains_unknown(want)) {
    return none;
  }
  let out = int_dest_range_diags(c.args[ai], want);
  if (out.len() == 0 && !bound_arg_accepts(c.args[ai], at, want, s) && !generic_scalar_own_callback(at, want, pref, wn, s)) {
    out = out.append(dg_at("E038", arg_subject(c, ai + 1) + ": expected " + type_label(want) + ", got " + type_label(at), expr_line(c.args[ai]), expr_col(c.args[ai])));
  }
  return out;
}

// vec_arg_diags is the E038 for an argument that is none of the lane types a
// generic `Vec[N, T]` parameter can stand for.
function vec_arg_diags(sig: FuncSig, c: ast.ExprCall, ai: i32, at: typeinfo.Type, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  if (ai >= sig.param_type_names.len() || is_unknown(at) || is_type_variable(at) || !type_contains_unknown(sig.param_types[ai])) {
    return none;
  }
  let pref = sig_param_ref(sig, ai);
  if (!builtin_vec(pref, s.type_names()) || util.has_str(vec_lane_types(pref, sig.all_type_params), typeinfo.spelling(at))) {
    return none;
  }
  return [dg_at("E038", arg_subject(c, ai + 1) + ": expected " + parser.render_type_ref(pref) + ", got " + type_label(at), expr_line(c.args[ai]), expr_col(c.args[ai]))];
}

function param_has_bindings(sig: FuncSig, ai: i32, names: string[]): boolean {
  return names.len() > 0 && type_contains_unknown(sig.param_types[ai]) && type_ref_names_any(sig_param_ref(sig, ai), names);
}

function bound_arg_accepts(e: ast.Expr, actual: typeinfo.Type, want: typeinfo.Type, s: Scope): boolean {
  return is_unknown(actual) || settles_to(e, want, s) || view_arg_borrow(actual, want) || coercible(actual, want, s);
}

function generic_own_callback_accepts(actual: typeinfo.Type, want: typeinfo.Type, names: string[], spelling: string, s: Scope): boolean {
  return names.len() > 0 && generic_scalar_own_callback(actual, want, parser.parse_type_ref(spelling), names, s);
}

function generic_scalar_own_callback(actual: typeinfo.Type, want: typeinfo.Type, ref: parser.TypeRef, names: string[], s: Scope): boolean {
  if (names.len() == 0 || !parser.ref_is_fn_value(ref)) {
    return false;
  }
  if let typeinfo.TypeFunc(a) = actual {
    if let typeinfo.TypeFunc(w) = want {
      let owns = scalar_own_callback_flags(a, w, parser.ref_ungroup(ref), names);
      return callable_assignable(a, typeinfo.TypeFunc { ...w, param_own: owns }, s.unions.unions);
    }
  }
  return false;
}

function scalar_own_callback_flags(a: typeinfo.TypeFunc, w: typeinfo.TypeFunc, r: parser.TypeRef, names: string[]): boolean[] {
  let owns: boolean[] = [];
  let i = 0;
  while (i < w.param_types.len() && i + 1 < r.args.len()) {
    let on = typeinfo.fn_own_at(w, i);
    if (parser.ref_is_own(r.args[i]) && type_ref_names_any(parser.ref_without_own(r.args[i]), names) && !type_contains_unknown(w.param_types[i]) && !typeinfo.ownable(w.param_types[i])) {
      on = typeinfo.fn_own_at(a, i);
    }
    owns = owns.append(on);
    i += 1;
  }
  return owns;
}

function call_type_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let (bn, bt) = call_bindings(sig, c, s);
  let wbi = 0;
  while (wbi < bn.len()) {
    let (wty, wok) = shared_literal_typevar_width(sig, c, bn[wbi], s);
    if (wok) {
      bt = bt.with(wbi, wty);
    }
    wbi += 1;
  }
  return (bn, bt);
}

function elemless_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return is_unknown(a.elem);
  }
  return false;
}

function uninferred_call_diags(sig: FuncSig, c: ast.ExprCall, bn: string[], name: string, s: Scope, dest: typeinfo.Type): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() > 0) {
    return out;
  }
  let ret = sig_ret_ref(sig);
  let bound = bn;
  if (!is_unknown(dest)) {
    let no_types: typeinfo.Type[] = [];
    let (dn, dt) = gc_bind_param(ret, dest, sig.type_params, s.type_names(), [], no_types);
    bound = util.append_all(bound, dn);
  }
  for tp in sig.all_type_params {
    let (named, all_empty) = empty_array_positions(sig.param_type_names, c.args, tp, s);
    if (util.index_of_str(bound, tp) < 0 && !bound_names_tp(sig.type_bounds, tp) && all_empty) {
      out = out.append(dg_at("E040", "could not infer type parameter " + tp + " for " + name + " — supply it explicitly at the call site (e.g. " + name + "[i32](...)) or annotate the binding", c.line, c.col));
    }
  }
  return out;
}

function uninferred_method_diags(c: ast.ExprCall, recv: string, method: string, msig: MethodSig, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() > 0 || c.args.len() != msig.param_type_names.len()) {
    return out;
  }
  let rref = parser.parse_type_ref(msig.receiver_type);
  let ret = parser.parse_type_ref(msig.ret_type_name);
  for tp in msig.all_type_params {
    let (named, all_empty) = empty_array_positions(msig.param_type_names, c.args, tp, s);
    if (!type_ref_names_any(rref, [tp]) && !type_ref_names_any(ret, [tp]) && !bound_names_tp(msig.type_bounds, tp) && all_empty) {
      out = out.append(dg_at("E040", "could not infer type parameter " + tp + " for " + recv + "." + method + " — supply it explicitly at the call site (e.g. ." + method + "[i32](...)) or annotate the binding", c.line, c.col));
    }
  }
  return out;
}

function declared_method_diags(c: ast.ExprCall, recv_ty: typeinfo.Type, recv: string, method: string, s: Scope): util.Diag[] {
  if let Some(msig) = s.lookup_method(method, recv) {
    if (c.args.len() != msig.param_types.len()) {
      return [dg_at("E004", util.arity_message("method \"" + method + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col)];
    }
    let out = method_arg_diags(c, method, msig, recv_ty, s);
    out = util.append_diags(out, method_type_arg_diags(c, method, msig, recv_ty, s));
    return util.append_diags(out, uninferred_method_diags(c, recv, method, msig, s));
  } else {
    let builtin = builtin_method_sig(recv, method);
    if let typeinfo.TypeFunc(f) = builtin {
      if (c.args.len() != f.param_types.len()) {
        return [dg_at("E004", util.arity_message("method \"" + method + "\"", f.param_types.len(), c.args.len(), "argument"), c.line, c.col)];
      }
      return callable_arg_diags(c, builtin, s);
    }
    return [];
  }
}

function map_method_arg_diags(c: ast.ExprCall, recv_ty: typeinfo.Type, method: string, s: Scope): util.Diag[] {
  if let Some(msig) = s.lookup_method(method, "Map") {
    if (c.args.len() != msig.param_types.len()) {
      return [dg_at("E004", util.arity_message("method \"" + method + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col)];
    }
    let out = method_arg_diags(c, method, msig, recv_ty, s);
    return util.append_diags(out, method_type_arg_diags(c, method, msig, recv_ty, s));
  }
  return [];
}

function uninferred_recv_diags(c: ast.ExprCall, recv: string, method: string, msig: MethodSig, args: typeinfo.Type[], s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() > 0 || c.args.len() != msig.param_type_names.len()) {
    return out;
  }
  let rref = parser.parse_type_ref(msig.receiver_type);
  let ret = parser.parse_type_ref(msig.ret_type_name);
  let k = 0;
  while (k < rref.args.len()) {
    let ar = rref.args[k];
    let tp = ar.base;
    let bare = ar.args.len() == 0 && ar.array_depth == 0 && !ar.is_tuple && !ar.is_fn;
    let bound = k < args.len();
    if (bare && !bound && !type_ref_names_any(ret, [tp]) && !bound_names_tp(msig.type_bounds, tp)) {
      let (_, all_empty) = empty_array_positions(msig.param_type_names, c.args, tp, s);
      if (all_empty) {
        out = out.append(dg_at("E040", "could not infer type parameter " + tp + " for " + recv + "." + method + " — supply it explicitly at the call site (e.g. ." + method + "[i32](...)) or annotate the binding", c.line, c.col));
      }
    }
    k += 1;
  }
  return out;
}

function empty_array_positions(spellings: string[], values: ast.Expr[], tp: string, s: Scope): (boolean, boolean) {
  let named = false;
  let all_empty = true;
  let k = 0;
  while (k < spellings.len() && k < values.len()) {
    if (spellings[k].len() > 0 && type_ref_names_any(parser.parse_type_ref(spellings[k]), [tp])) {
      named = true;
      if (!binds_nothing(values[k], s)) {
        all_empty = false;
      }
    }
    k += 1;
  }
  return (named, all_empty);
}

function binds_nothing(e: ast.Expr, s: Scope): boolean {
  match (e) {
    ast.ExprArray(arr) => {
      return arr.elements.len() == 0;
    },
    ast.ExprIdent(id) => {
      return !s.is_bound(id.name) && generic_unit_variant(id.name, s);
    },
    ast.ExprLambda(lm) => {
      return lm.use_infer && lm.params.len() > 0 && lm.params[0].type_name.len() == 0;
    },
    ast.ExprCall(c) => {
      return ctor_pins_nothing(c, s);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function ctor_pins_nothing(c: ast.ExprCall, s: Scope): boolean {
  if (ctor_name_taken(c, s) || union_of_variant(ctor_variant_name(c), s.unions).len() == 0) {
    return false;
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (qual_variant_union(fa, s).len() == 0) {
      return false;
    }
  }
  if let typeinfo.TypeUnion(u) = check_expr(c, s) {
    return u.args.len() > 0 && !settles_any_argument(u.args);
  }
  return false;
}

function use_untyped_call(e: ast.Expr): boolean {
  if let ast.ExprCall(c) = e {
    return use_untyped(c);
  }
  return false;
}

function generic_unit_variant(name: string, s: Scope): boolean {
  if let Some(owner) = union_sig_of_variant(name, s.unions) {
    return owner.is_enum && owner.type_params.len() > 0 && variant_value_payloads(s, "", name) == 0;
  }
  return false;
}

function bound_names_tp(bounds: string[], tp: string): boolean {
  for b in bounds {
    for entry in parser.split_plus_bounds(b) {
      if (type_ref_names_any(parser.parse_type_ref(entry), [tp])) {
        return true;
      }
    }
  }
  return false;
}

function bound_arg_diags(sig: FuncSig, c: ast.ExprCall, bn: string[], bt: typeinfo.Type[], s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let i = 0;
  while (i < sig.type_params.len() && i < sig.type_bounds.len()) {
    let bi = util.index_of_str(bn, sig.type_params[i]);
    if (sig.type_bounds[i].len() > 0 && bi >= 0) {
      for entry in parser.split_plus_bounds(sig.type_bounds[i]) {
        out = util.append_diags(out, bound_entry_diag(sig, sig.type_params[i], bt[bi], parser.parse_type_ref(entry), bn, bt, c, s));
      }
    }
    i += 1;
  }
  return out;
}

function bound_entry_diag(sig: FuncSig, tp: string, at: typeinfo.Type, bref: parser.TypeRef, bn: string[], bt: typeinfo.Type[], c: ast.ExprCall, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  let iargs = impl_trait_args(bref, sig.module, at, s);
  if (iargs.len() == 0 || iargs.len() != bref.args.len()) {
    return none;
  }
  let want: typeinfo.Type[] = [];
  let clash = false;
  let k = 0;
  while (k < iargs.len()) {
    let w = type_from_ref_subst(bref.args[k], bn, bt, s.type_names());
    if (type_contains_unknown(w)) {
      return none;
    }
    if (!type_eq(w, iargs[k])) {
      clash = true;
    }
    want = want.append(w);
    k += 1;
  }
  if (!clash) {
    return none;
  }
  let tr = bound_trait_display(bref.base, sig.module, s.trait_reqs);
  return [dg_at("E021", "type argument " + tp + " = " + util.demangle(type_label(at)) + " implements " + tr + trait_args_label(iargs) + " but the bound requires " + tr + trait_args_label(want) + " (in " + util.demangle(sig.name) + ")", c.line, c.col)];
}

function trait_args_label(args: typeinfo.Type[]): string {
  let out = "";
  for a in args {
    if (out.len() > 0) {
      out += ", ";
    }
    out += util.demangle(type_label(a));
  }
  return "[" + out + "]";
}

function dest_bound_diags(e: ast.Expr, dest: typeinfo.Type, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  let arms = value_if_results(e);
  if (arms.len() > 0) {
    let out: util.Diag[] = [];
    for arm in arms {
      out = util.append_diags(out, dest_bound_diags(arm, dest, s));
    }
    return out;
  }
  if let ast.ExprArray(arr) = e {
    let elem = array_elem_type_of(dest);
    let eout: util.Diag[] = [];
    if (is_unknown(elem)) {
      return eout;
    }
    for element in arr.elements {
      eout = util.append_diags(eout, dest_bound_diags(element, elem, s));
    }
    return eout;
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (s.defines(id.name)) {
        return none;
      }
      let Some(sig) = s.lookup_sig(id.name) else {
        return none;
      };
      if (sig.all_type_params.len() == 0 || sig.ret_type_name.len() == 0 || c.args.len() != sig.param_types.len()) {
        return none;
      }
      let (cn, ct) = call_bindings(sig, c, s);
      if (bound_arg_diags(sig, c, cn, ct, s).len() > 0) {
        return none;
      }
      let (bn, bt) = arg_bindings(sig, c, s);
      let (dn, dt) = gc_bind_param(sig_ret_ref(sig), dest, sig.type_params, s.type_names(), bn, bt);
      if (dn.len() == bn.len()) {
        return none;
      }
      let (fn_, ft) = bound_bindings(sig, s, dn, dt);
      return util.append_diags(dest_bound_e021(sig, c, dn, dt, bn.len(), s), bound_arg_diags(sig, c, fn_, ft, s));
    }
  }
  return none;
}

function dest_bound_e021(sig: FuncSig, c: ast.ExprCall, dn: string[], dt: typeinfo.Type[], from: i32, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let di = from;
  while (di < dn.len()) {
    let ti = util.index_of_str(sig.type_params, dn[di]);
    if (ti >= 0 && ti < sig.type_bounds.len() && !is_unknown(dt[di]) && !is_type_variable(dt[di])) {
      out = util.append_diags(out, tp_bound_diags(dn[di], sig.type_bounds[ti], sig.module, util.demangle(sig.name), dt[di], s, c.line, c.col));
    }
    di += 1;
  }
  return out;
}

function dest_bound_result(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (s.defines(id.name)) {
        return false;
      }
      let Some(sig) = s.lookup_sig(id.name) else {
        return false;
      };
      if (sig.all_type_params.len() == 0 || c.args.len() != sig.param_types.len()) {
        return false;
      }
      let ret = sig_ret_ref(sig);
      if (ret.args.len() > 0 || ret.array_depth > 0 || !util.has_str(sig.all_type_params, ret.base)) {
        return false;
      }
      let (bn, _) = call_type_bindings(sig, c, s);
      return util.index_of_str(bn, ret.base) < 0 && is_type_variable(check_expr(e, s));
    }
  }
  return false;
}

function value_if_results(e: ast.Expr): ast.Expr[] {
  let none: ast.Expr[] = [];
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lam) = c.callee {
      if (c.args.len() != 0 || lam.origin != parser.ORIGIN_IF_EXPR && lam.origin != parser.ORIGIN_MATCH_EXPR) {
        return none;
      }
      let out: ast.Expr[] = [];
      for st in lam.body {
        out = astwalk.fold_stmt_spine(st, out, collect_arm_result);
      }
      return out;
    }
  }
  return none;
}

function collect_arm_result(st: ast.Stmt, own acc: ast.Expr[]): ast.Expr[] {
  if let ast.StmtReturn(r) = st {
    return acc.append(r.value);
  }
  if let ast.StmtAssign(a) = st {
    if (parser.is_value_local_name(a.target)) {
      return acc.append(a.value);
    }
  }
  return acc;
}

function bound_bindings(sig: FuncSig, s: Scope, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  return bounds_bindings(sig.type_params, sig.type_bounds, sig.module, s, names, types);
}

function bounds_bindings(tparams: string[], bounds: string[], module: string, s: Scope, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  let ns = names;
  let ts = types;
  let before: i32 = -1;
  while (ns.len() > before) {
    before = ns.len();
    let i = 0;
    while (i < tparams.len() && i < bounds.len()) {
      let bi = util.index_of_str(ns, tparams[i]);
      if (bounds[i].len() > 0 && bi >= 0) {
        for entry in parser.split_plus_bounds(bounds[i]) {
          let bref = parser.parse_type_ref(entry);
          let iargs = impl_trait_args(bref, module, ts[bi], s);
          if (iargs.len() == bref.args.len()) {
            let k = 0;
            while (k < iargs.len()) {
              let (n2, t2) = gc_bind_param(bref.args[k], iargs[k], tparams, s.type_names(), ns, ts);
              ns = n2;
              ts = t2;
              k += 1;
            }
          }
        }
      }
      i += 1;
    }
  }
  return (ns, ts);
}

function impl_trait_args(bound: parser.TypeRef, module: string, at: typeinfo.Type, s: Scope): typeinfo.Type[] {
  let none: typeinfo.Type[] = [];
  if (bound.args.len() == 0 || type_contains_unknown(at)) {
    return none;
  }
  if let typeinfo.TypeDyn(d) = at {
    return dyn_trait_args(bound, d.traits, s);
  }
  let base = receiver_namespace(util.base_type_name(type_label(at)));
  for imp in s.impls {
    if (bound_names_trait(bound.base, module, imp.trait_name, imp.trait_module) && impl_receiver(imp) == base) {
      let (in_, it_) = gc_bind_param(parser.parse_type_ref(imp.impl_type), at, imp.all_type_params, s.type_names(), [], []);
      let out: typeinfo.Type[] = [];
      for targ in parser.parse_type_ref(imp.trait_ref).args {
        let ty = type_from_ref_subst(targ, in_, it_, s.type_names());
        if (type_contains_unknown(ty)) {
          return none;
        }
        out = out.append(ty);
      }
      return out;
    }
  }
  return none;
}

function dyn_trait_args(bound: parser.TypeRef, traits: string, s: Scope): typeinfo.Type[] {
  let none: typeinfo.Type[] = [];
  let want = parser.derive_simple_name(bound.base);
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let ref = parser.parse_type_ref(tr);
    if (parser.derive_simple_name(ref.base) == want) {
      let out: typeinfo.Type[] = [];
      for targ in ref.args {
        let ty = type_from_ref_subst(targ, [], [], s.type_names());
        if (type_contains_unknown(ty)) {
          return none;
        }
        out = out.append(ty);
      }
      return out;
    }
  }
  return none;
}

function bound_names_trait(base: string, module: string, name: string, trait_module: string): boolean {
  if (parser.derive_simple_name(base) != name) {
    return false;
  }
  if (util.index_of_sub(base, ".") >= 0) {
    return trait_module.len() > 0;
  }
  return trait_module == module;
}

function struct_lit_args(sl: ast.ExprStructLit, ssig: StructSig, s: Scope): typeinfo.Type[] {
  let written = written_struct_args(sl, ssig, s);
  if (written.len() > 0) {
    return written;
  }
  let bn: string[] = [];
  let bt: typeinfo.Type[] = [];
  let pass = 0;
  while (pass < 2) {
    let i = 0;
    while (i < sl.field_names.len()) {
      let fi = field_index(ssig, sl.field_names[i]);
      let binds = fi >= 0 && fi < ssig.field_type_names.len() && typed_int_field(sl.field_values[i], s) == (pass == 0);
      if let ast.ExprArray(ea) = sl.field_values[i] {
        if (ea.elements.len() == 0) {
          binds = false;
        }
      }
      if (binds) {
        let (bn2, bt2) = gc_bind_param(parser.parse_type_ref(ssig.field_type_names[fi]), check_expr(sl.field_values[i], s), ssig.type_params, s.type_names(), bn, bt);
        bn = bn2;
        bt = bt2;
      }
      i += 1;
    }
    pass += 1;
  }
  let args: typeinfo.Type[] = [];
  for tp in ssig.type_params {
    let bi = util.index_of_str(bn, tp);
    if (bi >= 0) {
      args = args.append(literal_bound_width(sl, ssig, tp, bt[bi], s));
    } else {
      args = args.append(t_unknown("unbound " + tp));
    }
  }
  return args;
}

function typed_int_field(e: ast.Expr, s: Scope): boolean {
  return !int_literal_tree(e) && is_integer(check_expr(e, s));
}

function written_struct_args(sl: ast.ExprStructLit, ssig: StructSig, s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  if (sl.written.len() == 0) {
    return out;
  }
  let wref = parser.parse_type_ref(sl.written);
  if (wref.args.len() != ssig.type_params.len()) {
    return out;
  }
  for a in wref.args {
    out = out.append(type_from_ref_subst(a, [], [], s.type_names()));
  }
  return out;
}

function literal_bound_width(sl: ast.ExprStructLit, ssig: StructSig, tp: string, bound: typeinfo.Type, s: Scope): typeinfo.Type {
  let lit: ast.Expr[] = [sl];
  let es = struct_param_exprs(ssig, tp, lit, s);
  if (es.len() == 0) {
    return bound;
  }
  for e in es {
    if (!int_literal_tree(e)) {
      return bound;
    }
  }
  for e in es {
    if (wide_int_tree(e)) {
      return t_i64();
    }
  }
  return bound;
}

function struct_param_exprs(ssig: StructSig, tp: string, es: ast.Expr[], s: Scope): ast.Expr[] {
  let out: ast.Expr[] = [];
  let fi = 0;
  while (fi < ssig.field_names.len() && fi < ssig.field_type_names.len()) {
    let vals: ast.Expr[] = [];
    for e in es {
      if let ast.ExprStructLit(sl) = e {
        if (sl.type_name == ssig.name && sl.written.len() == 0) {
          let i = 0;
          while (i < sl.field_names.len()) {
            if (sl.field_names[i] == ssig.field_names[fi]) {
              vals = vals.append(sl.field_values[i]);
            }
            i += 1;
          }
        }
      }
    }
    out = util.append_all(out, param_exprs(parser.parse_type_ref(ssig.field_type_names[fi]), tp, vals, s));
    fi += 1;
  }
  return out;
}

function param_exprs(tr: parser.TypeRef, tp: string, es: ast.Expr[], s: Scope): ast.Expr[] {
  let out: ast.Expr[] = [];
  if (es.len() == 0) {
    return out;
  }
  if (tr.array_depth > 0 || tr.is_view) {
    let elems: ast.Expr[] = [];
    for e in es {
      if let ast.ExprArray(ea) = e {
        elems = util.append_all(elems, ea.elements);
      }
    }
    if (tr.is_view) {
      return param_exprs(tr.args[0], tp, elems, s);
    }
    return param_exprs(parser.elem_type_ref(tr), tp, elems, s);
  }
  if (tr.is_tuple) {
    let ti = 0;
    while (ti < tr.args.len()) {
      let elems: ast.Expr[] = [];
      for e in es {
        if let ast.ExprTuple(et) = e {
          if (ti < et.elements.len()) {
            elems = elems.append(et.elements[ti]);
          }
        }
      }
      out = util.append_all(out, param_exprs(tr.args[ti], tp, elems, s));
      ti += 1;
    }
    return out;
  }
  if (tr.is_fn) {
    return out;
  }
  if (tr.args.len() == 0) {
    if (tr.base == tp) {
      return es;
    }
    return out;
  }
  let Some(inner) = s.lookup_struct(tr.base) else {
    return out;
  };
  if (inner.type_params.len() != tr.args.len()) {
    return out;
  }
  let k = 0;
  while (k < inner.type_params.len()) {
    out = util.append_all(out, param_exprs(tr.args[k], tp, struct_param_exprs(inner, inner.type_params[k], es, s), s));
    k += 1;
  }
  return out;
}

function widened_field_type(sig: StructSig, j: i32, largs: typeinfo.Type[], s: Scope): typeinfo.Type {
  let want = type_from_ref_subst(parser.parse_type_ref(sig.field_type_names[j]), sig.type_params, largs, s.type_names());
  if (reads_i64(want)) {
    return want;
  }
  return t_unknown("no field");
}

function reads_i64(t: typeinfo.Type): boolean {
  if (type_to_irtag(t) == "i64") {
    return true;
  }
  if let typeinfo.TypeArray(at) = t {
    return reads_i64(at.elem);
  }
  let parts: typeinfo.Type[] = [];
  if let typeinfo.TypeStruct(st) = t {
    parts = st.args;
  }
  if let typeinfo.TypeTuple(tt) = t {
    parts = tt.elements;
  }
  for p in parts {
    if (reads_i64(p)) {
      return true;
    }
  }
  return false;
}

// spellings_name reports whether any of the type spellings names tp.
function spellings_name(spellings: string[], tp: string): boolean {
  for sp in spellings {
    if (sp.len() > 0 && type_ref_names_any(parser.parse_type_ref(sp), [tp])) {
      return true;
    }
  }
  return false;
}

function lit_uninferable_param(sl: ast.ExprStructLit, ssig: StructSig, args: typeinfo.Type[], s: Scope): string {
  if (sl.has_base) {
    return "";
  }
  let i = 0;
  while (i < ssig.type_params.len() && i < args.len()) {
    if (is_unknown(args[i])) {
      let tp = ssig.type_params[i];
      let spellings: string[] = [];
      for fname in sl.field_names {
        let fi = field_index(ssig, fname);
        if (fi >= 0 && fi < ssig.field_type_names.len()) {
          spellings = spellings.append(ssig.field_type_names[fi]);
        } else {
          spellings = spellings.append("");
        }
      }
      if (!spellings_name(spellings, tp)) {
        return tp;
      }
      let (named, all_empty) = empty_array_positions(spellings, sl.field_values, tp, s);
      if (named && all_empty) {
        return tp;
      }
    }
    i += 1;
  }
  return "";
}

function lit_field_clash(sl: ast.ExprStructLit, ssig: StructSig, args: typeinfo.Type[], s: Scope): i32 {
  let i = 0;
  while (i < sl.field_names.len()) {
    let fi = field_index(ssig, sl.field_names[i]);
    if (fi >= 0) {
      let ft = lit_field_type(ssig, fi, args, s);
      let vt = check_expr(sl.field_values[i], s);
      if (!type_contains_unknown(ft) && !is_unknown(vt) && !settles_to(sl.field_values[i], ft, s) && !coercible(vt, ft, s)) {
        return i;
      }
    }
    i += 1;
  }
  return -1;
}

function projected_ret(ret_name: string, bn: string[], bt: typeinfo.Type[], s: Scope): typeinfo.Type {
  let names: string[] = [];
  let spells: string[] = [];
  let i = 0;
  while (i < bn.len()) {
    if (!type_contains_unknown(bt[i])) {
      names = names.append(bn[i]);
      spells = spells.append(typeinfo.spelling(bt[i]));
    }
    i += 1;
  }
  let resolved = parser.resolve_proj_in_type(parser.subst_ty(ret_name, names, spells), s.impls);
  if (util.contains(resolved, "::")) {
    return t_unknown("unresolved projection " + resolved);
  }
  return s.resolve_type(resolved);
}

function check_expr(e: ast.Expr, s: Scope): typeinfo.Type {
  match (e) {
    ast.ExprNumber(n) => {
      return check_number_expr(n, s);
    },
    ast.ExprBool(_) => {
      return t_bool();
    },
    ast.ExprString(_) => {
      return t_string();
    },
    ast.ExprIdent(id) => {
      return check_ident_expr(id, s);
    },
    ast.ExprBinary(b) => {
      return check_binary_expr(b, s);
    },
    ast.ExprUnary(u) => {
      return check_unary_expr(u, s);
    },
    ast.ExprCall(c) => {
      return check_call_expr(c, s);
    },
    ast.ExprTuple(t) => {
      let elems: typeinfo.Type[] = [];
      for element in t.elements {
        elems = elems.append(check_expr(element, s));
      }
      return t_tuple(elems);
    },
    ast.ExprArray(a) => {
      return check_array_expr(a, s);
    },
    ast.ExprBytes(_) => {
      return t_array(t_u8());
    },
    ast.ExprIndex(x) => {
      return check_index_expr(x, s);
    },
    ast.ExprSlice(sl) => {
      return check_slice_expr(sl, s);
    },
    ast.ExprStructLit(sl) => {
      return check_struct_lit_expr(sl, s);
    },
    ast.ExprFieldAccess(fa) => {
      return check_field_access_expr(fa, s);
    },
    ast.ExprLambda(lm) => {
      return check_lambda_expr(lm, s);
    },
    ast.ExprMapLit(_) => {
      return t_unknown("Map literal: formatter-only node");
    },
    ast.ExprFString(_) => {
      return t_unknown("f-string: formatter-only node");
    },
    ast.ExprUnknown(u) => {
      return t_unknown("parser-side unknown:" + u.kind);
    },
    ast.ExprZero(z) => {
      return s.resolve_type(z.type_name);
    }
  }
  return t_unknown("unhandled Expr variant");
}

function check_number_expr(n: ast.ExprNumber, s: Scope): typeinfo.Type {
  if (parser.is_unit_literal(n)) {
    return t_void();
  }
  if (n.is_float && n.suffix == "f32") {
    return t_f32();
  }
  if (n.is_float && n.suffix == "f64") {
    return typeinfo.TypeFloat { width: 64, polymorphic: false };
  }
  if (n.is_float) {
    return typeinfo.TypeFloat { width: 64, polymorphic: true };
  }
  if (n.suffix == "i64") {
    return t_i64();
  }
  if (n.suffix == "u64") {
    return t_u64();
  }
  if (n.suffix == "u32") {
    return t_u32();
  }
  if (n.suffix == "u8") {
    return t_u8();
  }
  if (n.suffix == "usize") {
    return t_usize();
  }
  if (n.suffix == "i32") {
    return t_i32();
  }
  if (n.suffix == "char") {
    return t_char();
  }
  if (parser.literal_is_i64(n.text)) {
    return t_i64();
  }
  return t_i32();
}

function check_ident_expr(id: ast.ExprIdent, s: Scope): typeinfo.Type {
  let bi = s.ident_binding(id);
  if (bi >= 0 && !is_unknown(s.types[bi])) {
    return s.types[bi];
  }
  if (!s.has_sig(id.name) && s.variant_ambiguous(id.name)) {
    return t_unknown("ambiguous variant `" + id.name + "`");
  }
  let un = scope_variant_owner(id.name, s);
  if (un.len() > 0 && !s.has_sig(id.name) && variant_value_payloads(s, "", id.name) == 0) {
    return t_union(un);
  }
  if (is_nopayload_builtin_variant(id.name) && !s.has_sig(id.name)) {
    return t_union(parser.builtin_enum_of(id.name));
  }
  if let Some(csig) = s.lookup_sig(id.name) {
    if (csig.is_const) {
      return csig.ret_type;
    }
    if (bi < 0) {
      return t_func_own(csig.param_types, csig.param_own, csig.ret_type);
    }
  }
  if (bi >= 0) {
    return s.types[bi];
  }
  return t_unknown("undefined identifier:" + id.name);
}

function check_binary_expr(b: ast.ExprBinary, s: Scope): typeinfo.Type {
  if (b.op == "__named_arg") {
    return check_expr(b.right, s);
  }
  return binary_result_type(b, check_expr(b.left, s), check_expr(b.right, s), s);
}

function binary_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): typeinfo.Type {
  let (sl, sr) = settled_operands(b, lt, rt);
  return operator_result_type(b, sl, sr, s);
}

function lanes_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): typeinfo.Type {
  if (util.has_str(["==", "!=", "<", ">", "<=", ">="], b.op)) {
    return t_bool();
  }
  if (util.has_str(["+", "-", "*", "/"], b.op) && type_eq(lt, rt)) {
    return lt;
  }
  return t_unknown("lane operands need one lane type and an arithmetic operator");
}

function operator_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): typeinfo.Type {
  if (is_lanes(lt) || is_lanes(rt)) {
    return lanes_result_type(b, lt, rt);
  }
  if (b.op == "+") {
    if (type_eq(lt, t_string()) && type_eq(rt, t_string())) {
      return t_string();
    }
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    if (float_operands_agree(lt, rt)) {
      return float_result(lt, rt);
    }
    let povt = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(povt)) {
      return povt;
    }
    return t_unknown("`+` operands type mismatch");
  }
  if (b.op == "+|" || b.op == "-|" || b.op == "*|" || b.op == "<<|") {
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    return t_unknown("`" + b.op + "` operands must both be integers");
  }
  if (b.op == "+?" || b.op == "-?" || b.op == "*?" || b.op == "/?" || b.op == "%?" || b.op == "<<?" || b.op == ">>?") {
    if (is_integer(lt) && is_integer(rt)) {
      let chkoa: typeinfo.Type[] = [int_result(lt, rt, b.left, b.right)];
      return t_union_g("Option", chkoa);
    }
    return t_unknown("`" + b.op + "` operands must both be integers");
  }
  if (b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%") {
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    if (b.op != "%" && float_operands_agree(lt, rt)) {
      return float_result(lt, rt);
    }
    let aovt = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(aovt)) {
      return aovt;
    }
    return t_unknown("arithmetic op `" + b.op + "` requires matching i32 or f64 operands");
  }
  return bitwise_result_type(b, lt, rt, s);
}

function bitwise_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): typeinfo.Type {
  if (b.op == "&" || b.op == "|" || b.op == "^") {
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    let bovt = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(bovt)) {
      return bovt;
    }
    return t_unknown("bitwise operands must both be integers");
  }
  if (b.op == "<<" || b.op == ">>") {
    if (is_integer(lt) && is_integer(rt)) {
      if (int_literal_tree(b.left) && !int_literal_tree(b.right) || unsettled_int_literal(b.left)) {
        return rt;
      }
      return lt;
    }
    let sovt = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(sovt)) {
      return sovt;
    }
    return t_unknown("shift operands must both be integers");
  }
  if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
    return t_bool();
  }
  if (b.op == "==" || b.op == "!=") {
    if (float_operands_agree(lt, rt)) {
      return t_bool();
    }
    if (type_eq(lt, rt) && !is_unknown(lt)) {
      return t_bool();
    }
    if (is_integer(lt) && is_integer(rt)
      && (int_literal_tree(b.left) || int_literal_tree(b.right) || !is_unknown(scalar_numeric_join(lt, rt)))) {
      return t_bool();
    }
    return t_unknown("equality op `" + b.op + "` requires same-typed operands");
  }
  if (b.op == "&&" || b.op == "||") {
    if (type_eq(lt, t_bool()) && type_eq(rt, t_bool())) {
      return t_bool();
    }
    return t_unknown("logical op `" + b.op + "` requires bool operands");
  }
  return t_unknown("unknown binary op:" + b.op);
}

function check_unary_expr(u: ast.ExprUnary, s: Scope): typeinfo.Type {
  return unary_result_type(u, check_expr(u.operand, s), s);
}

function unary_result_type(u: ast.ExprUnary, ot: typeinfo.Type, s: Scope): typeinfo.Type {
  if (u.op == "-" && unsettled_int_literal(ast.ExprUnary { ...u })) {
    if let ast.ExprNumber(_) = u.operand {
      return t_i32();
    }
  }
  if (u.op == "-") {
    if (is_integer(ot)) {
      return ot;
    }
    if (is_float(ot) || is_lanes(ot)) {
      return ot;
    }
    let novt = s.unop_overload_ret(u.op, ot);
    if (!is_unknown(novt)) {
      return novt;
    }
    return t_unknown("unary `-` requires i32 or f64 operand");
  }
  if (u.op == "!") {
    if (type_eq(ot, t_bool())) {
      return t_bool();
    }
    return t_unknown("unary `!` requires bool operand");
  }
  if (u.op == "~") {
    return bitwise_not_type(ot);
  }
  if (u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as_") {
    return s.resolve_type(slice_unchecked(u.op, 3, u.op.len()) + "");
  }
  if (u.op == "try_") {
    return try_success_type(s, ot);
  }
  if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
    return typeinfo.TypeUnion { name: "Option", args: [s.resolve_type(slice_unchecked(u.op, 4, u.op.len()) + "")] };
  }
  return t_unknown("unknown unary op:" + u.op);
}

function vaguer_than(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if (type_contains_unknown(a) && !type_contains_unknown(b)) {
    return true;
  }
  if let typeinfo.TypeUnion(ua) = a {
    if let typeinfo.TypeUnion(ub) = b {
      return ua.name == ub.name && ua.args.len() == 0 && ub.args.len() > 0;
    }
  }
  if let typeinfo.TypeArray(xa) = a {
    if let typeinfo.TypeArray(xb) = b {
      return vaguer_than(xa.elem, xb.elem);
    }
  }
  return false;
}

const ARRAY_TUPLE_UNRESOLVED: string = "array tuple elements disagree";

function check_array_expr(a: ast.ExprArray, s: Scope): typeinfo.Type {
  if (a.elements.len() == 0) {
    if (a.elem_ty.len() > 0) {
      return t_array(s.resolve_type(a.elem_ty));
    }
    return t_array(t_unknown("empty array literal"));
  }
  let first = check_expr(a.elements[0], s);
  let first_lit = numeric_literal_kind(a.elements[0]);
  let first_expr = a.elements[0];
  for i in 1..a.elements.len() {
    let et = check_expr(a.elements[i], s);
    if (unbound_enum_argument(et)) {
      continue;
    }
    if (unbound_enum_argument(first)) {
      first = et;
      first_lit = numeric_literal_kind(a.elements[i]);
      first_expr = a.elements[i];
      continue;
    }
    if (is_tuple_type(first) && is_tuple_type(et) && (type_contains_unknown(first) || type_contains_unknown(et))) {
      let joined = vb_join(VbStore { t: first, e: first_expr }, VbStore { t: et, e: a.elements[i] });
      if (is_unknown(joined.t) || !array_mix_settles(first_expr, first, joined.t, s) || !array_mix_settles(a.elements[i], et, joined.t, s)) {
        return t_unknown(ARRAY_TUPLE_UNRESOLVED);
      }
      first = joined.t;
      first_lit = 0;
      first_expr = joined.e;
      continue;
    }
    if (bare_map(first) && !bare_map(et)) {
      if let typeinfo.TypeMap(_) = et {
        first = et;
        first_lit = 0;
        first_expr = a.elements[i];
        continue;
      }
    }
    let scalar = scalar_numeric_join(first, et);
    if (!is_unknown(scalar) && !int_literal_tree(first_expr) && !int_literal_tree(a.elements[i])) {
      first = scalar;
      first_lit = 0;
      first_expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
      continue;
    }
    let lit = numeric_literal_kind(a.elements[i]);
    if (array_element_preferred(a.elements[i], et, lit, first_expr, first, first_lit, s)) {
      first = et;
      first_lit = lit;
      first_expr = a.elements[i];
    }
  }
  return t_array(first);
}

function struct_lit_gives_way(e: ast.Expr, from: typeinfo.Type, to: typeinfo.Type, s: Scope): boolean {
  return struct_lit_yields(e, from, to, s, false);
}

function struct_lit_yields(e: ast.Expr, from: typeinfo.Type, to: typeinfo.Type, s: Scope, to_float: boolean): boolean {
  if let ast.ExprStructLit(sl) = e {
    if let typeinfo.TypeStruct(fs) = from {
      if let typeinfo.TypeStruct(ts) = to {
        let Some(sig) = s.lookup_struct(sl.type_name) else {
          return false;
        };
        if (sl.written.len() > 0 || fs.name != ts.name || fs.args.len() != ts.args.len() || sig.type_params.len() != fs.args.len()) {
          return false;
        }
        let lit: ast.Expr[] = [sl];
        let differs = false;
        let k = 0;
        while (k < fs.args.len()) {
          if (typeinfo.spelling(fs.args[k]) != typeinfo.spelling(ts.args[k])) {
            let es = struct_param_exprs(sig, sig.type_params[k], lit, s);
            if (es.len() == 0 || !is_integer(ts.args[k]) && !(to_float && is_float(ts.args[k]))) {
              return false;
            }
            for pe in es {
              if (!int_literal_tree(pe)) {
                return false;
              }
            }
            differs = true;
          }
          k += 1;
        }
        return differs;
      }
    }
  }
  return false;
}

function check_index_expr(x: ast.ExprIndex, s: Scope): typeinfo.Type {
  return index_result_type(check_expr(x.array, s), check_expr(x.index, s));
}

// The literal pre-pass gives an integer literal local a marker type until it
// settles, and the marker is an integer index too.
function index_result_type(at: typeinfo.Type, it: typeinfo.Type): typeinfo.Type {
  if (!is_integer(it) && lit_id(it) < 0) {
    return t_unknown("array index must be an integer");
  }
  match (at) {
    typeinfo.TypeArray(ta) => {
      return ta.elem;
    },
    typeinfo.TypeString(_) => {
      return t_u8();
    },
    _ => {
      return t_unknown("can only index into an array or string");
    }
  }
  return t_unknown("unreachable index arm");
}

function check_slice_expr(sl: ast.ExprSlice, s: Scope): typeinfo.Type {
  let at = check_expr(sl.array, s);
  let st = check_expr(sl.start, s);
  let et = check_expr(sl.end, s);
  if (!is_integer(st)) {
    return t_unknown("slice start must be i32");
  }
  if (!is_integer(et)) {
    return t_unknown("slice end must be i32");
  }
  match (at) {
    typeinfo.TypeArray(_) => {
      return as_view(at);
    },
    typeinfo.TypeString(_) => {
      let slcoa: typeinfo.Type[] = [t_str()];
      return t_union_g("Option", slcoa);
    },
    _ => {
      return t_unknown("can only slice array or string");
    }
  }
  return t_unknown("unreachable slice arm");
}

function check_struct_lit_expr(sl: ast.ExprStructLit, s: Scope): typeinfo.Type {
  let Some(ssig) = s.lookup_struct(sl.type_name) else {
    return t_unknown("undefined struct: " + sl.type_name);
  };
  if (sl.has_base) {
    let bt = check_expr(sl.base, s);
    if (!type_eq(bt, t_struct(sl.type_name))) {
      return t_unknown("struct " + sl.type_name + " update base type mismatch");
    }
    let ui = 0;
    while (ui < sl.field_names.len()) {
      let uname = sl.field_names[ui];
      let found = false;
      let ufi = 0;
      while (ufi < ssig.field_names.len()) {
        if (ssig.field_names[ufi] == uname) {
          found = true;
          let uft = check_expr(sl.field_values[ui], s);
          if (!type_contains_unknown(ssig.field_types[ufi])
            && !settles_to(sl.field_values[ui], ssig.field_types[ufi], s)
            && !coercible(uft, ssig.field_types[ufi], s)) {
            return t_unknown("struct " + sl.type_name + " field `" + uname + "` type mismatch");
          }
        }
        ufi += 1;
      }
      if (!found) {
        return t_unknown("struct " + sl.type_name + " has no field `" + uname + "`");
      }
      ui += 1;
    }
    return bt;
  }
  if (sl.field_names.len() != ssig.field_names.len()) {
    return t_unknown("struct " + sl.type_name + " field count mismatch");
  }
  let swritten = __alloc_bool(ssig.field_names.len());
  let sli = 0;
  while (sli < sl.field_names.len()) {
    let sfi = field_index(ssig, sl.field_names[sli]);
    if (sfi < 0) {
      return t_unknown("struct " + sl.type_name + " has no field `" + sl.field_names[sli] + "`");
    }
    if (swritten[sfi]) {
      return t_unknown("struct " + sl.type_name + " field `" + sl.field_names[sli] + "` written twice");
    }
    swritten = swritten.with(sfi, true);
    let ft = check_expr(sl.field_values[sli], s);
    if (!type_contains_unknown(ssig.field_types[sfi])
      && !settles_to(sl.field_values[sli], ssig.field_types[sfi], s)
      && !coercible(ft, ssig.field_types[sfi], s)) {
      return t_unknown("struct " + sl.type_name + " field `" + sl.field_names[sli] + "` type mismatch");
    }
    sli += 1;
  }
  if (ssig.type_params.len() == 0) {
    return t_struct(sl.type_name);
  }
  let largs = struct_lit_args(sl, ssig, s);
  if (lit_uninferable_param(sl, ssig, largs, s).len() > 0) {
    return t_unknown("struct " + sl.type_name + " has a type argument nothing binds");
  }
  if (lit_field_clash(sl, ssig, largs, s) >= 0) {
    return t_unknown("struct " + sl.type_name + " fields disagree on a type argument");
  }
  return typeinfo.TypeStruct { name: sl.type_name, args: largs };
}

function check_field_access_expr(fa: ast.ExprFieldAccess, s: Scope): typeinfo.Type {
  let vqu = qual_variant_union(fa, s);
  if (vqu.len() > 0) {
    return t_union(vqu);
  }
  return field_access_result_type(fa, check_expr(fa.obj, s), s);
}

function field_access_result_type(fa: ast.ExprFieldAccess, ot: typeinfo.Type, s: Scope): typeinfo.Type {
  if (fa.field == "fd" && semtypes.is_fd_handle(ot)) {
    return t_i32();
  }
  match (ot) {
    typeinfo.TypeStruct(sn) => {
      return struct_field_type(sn, fa.field, s);
    },
    typeinfo.TypeTuple(tt) => {
      let idx = digit_string_to_i32(fa.field);
      if (idx < 0 || idx >= tt.elements.len()) {
        return t_unknown("tuple index `" + fa.field + "` out of range");
      }
      return tt.elements[idx];
    },
    _ => {
      return t_unknown("can only field-access a struct or tuple");
    }
  }
  return t_unknown("unreachable field-access arm");
}

function struct_field_type(sn: typeinfo.TypeStruct, field: string, s: Scope): typeinfo.Type {
  let Some(fsig) = s.lookup_struct(sn.name) else {
    return t_unknown("undefined struct: " + sn.name);
  };
  let fai = field_index(fsig, field);
  if (fai < 0) {
    return t_unknown("struct " + sn.name + " has no field `" + field + "`");
  }
  if (fai < fsig.field_type_names.len() && fsig.type_params.len() > 0 && sn.args.len() > 0) {
    let fref = parser.parse_type_ref(fsig.field_type_names[fai]);
    if (sn.args.len() != fsig.type_params.len()) {
      return type_from_ref_subst(fref, fsig.type_params, rigid_tparams(fsig.type_params), s.type_names());
    }
    return type_from_ref_subst(fref, fsig.type_params, sn.args, s.type_names());
  }
  return fsig.field_types[fai];
}

function check_lambda_expr(lm: ast.ExprLambda, s: Scope): typeinfo.Type {
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(s.resolve_param(param));
  }
  let rt = lambda_ret_type(lm, s);
  let body_scope = lambda_body_scope(lm, s);
  check_block(lm.body, body_scope);
  if (lm.ret_type.len() == 0 && is_unknown(rt)) {
    let (returned, at) = first_returned(lm.body, body_scope);
    if (!parser.bare_return(returned)) {
      let inferred = check_expr(returned, at);
      if (!is_unknown(inferred)) {
        rt = inferred;
      }
    } else if (!parser.is_value_block_origin(lm.origin)) {
      rt = t_void();
    }
  }
  return t_func_own(pts, lambda_owns(lm), rt);
}

pub struct CheckResult { scope: Scope, ty: typeinfo.Type }

pub function check_stmt(st: ast.Stmt, s: Scope): CheckResult {
  match (st) {
    ast.StmtDefer(d) => {
      return check_stmt(d.action, s);
    },
    ast.StmtVar(v) => {
      let init_scope = rec_local_scope(v, s);
      let t = check_expr(v.init, init_scope);
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return CheckResult { scope: bind_destructure_names(s, v), ty: t };
      }
      if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name)) {
        let declared = var_declared_type(v, s);
        if (is_unknown(declared)) {
          return CheckResult { scope: s.bind(v.name, declared), ty: declared };
        }
        if (!init_fits(v.init, t, declared, init_scope)) {
          let err = t_unknown("var `" + v.name + "`: init type doesn't match annotation `" + v.type_name + "`");
          return CheckResult { scope: s.bind(v.name, declared), ty: err };
        }
        return CheckResult { scope: s.bind(v.name, declared), ty: declared };
      }
      return CheckResult { scope: s.bind_inferred(v, t), ty: t };
    },
    ast.StmtReturn(r) => {
      let bare_ret = false;
      match (r.value) {
        ast.ExprUnknown(bu) => {
          if (bu.kind == parser.BARE_RETURN) {
            bare_ret = true;
          }
        },
        _ => {}
      }
      if (bare_ret) {
        return CheckResult { scope: s, ty: t_void() };
      }
      let t = check_expr(r.value, s);
      match (s.ret_type) {
        typeinfo.TypeUnknown(_) => {
          return CheckResult { scope: s, ty: t };
        },
        _ => {}
      }
      if (is_unknown(t)) {
        let (ret_block, is_block) = value_block_body(r.value);
        if (is_block && vb_settles(ret_block, s.ret_type, s) || (generic_fn_value_arg(r.value, s) || dest_bound_result(r.value, s)) && settles_to(r.value, s.ret_type, s)) {
          return CheckResult { scope: s, ty: s.ret_type };
        }
        return CheckResult { scope: s, ty: t };
      }
      if (!settles_to(r.value, s.ret_type, s) && !coercible(t, s.ret_type, s)) {
        return CheckResult { scope: s, ty: t_unknown("return type doesn't match declaration") };
      }
      return CheckResult { scope: s, ty: t };
    },
    ast.StmtExpr(x) => {
      let t = check_expr(x.value, s);
      return CheckResult { scope: s, ty: t };
    },
    ast.StmtIf(ifs) => {
      let ct = check_expr(ifs.cond, s);
      if (!type_eq(ct, t_bool())) {
        check_block(ifs.then_body, s);
        check_block(ifs.else_body, s);
        return CheckResult { scope: s, ty: t_unknown("if cond not bool") };
      }
      let thenOk = check_block(ifs.then_body, s);
      let elseOk = check_block(ifs.else_body, s);
      if (!thenOk || !elseOk) {
        return CheckResult { scope: s, ty: t_unknown("if: ill-typed branch") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtWhile(w) => {
      let wt = check_expr(w.cond, s);
      let body_scope = s.enter_loop();
      if (!type_eq(wt, t_bool())) {
        check_block(w.body, body_scope);
        return CheckResult { scope: s, ty: t_unknown("while cond not bool") };
      }
      let bodyOk = check_block(w.body, body_scope);
      if (!bodyOk) {
        return CheckResult { scope: s, ty: t_unknown("while: ill-typed body") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtAssign(a) => {
      let existing = s.lookup(a.target);
      if (is_unknown(existing)) {
        return CheckResult { scope: s, ty: t_unknown("assign to undefined `" + a.target + "`") };
      }
      let vt = check_expr(a.value, s);
      if (is_unknown(vt)) {
        return CheckResult { scope: s, ty: vt };
      }
      if (!settles_to(a.value, existing, s) && !coercible(vt, existing, s)) {
        return CheckResult { scope: s, ty: t_unknown("type mismatch in assign to `" + a.target + "`") };
      }
      return CheckResult { scope: s, ty: vt };
    },
    ast.StmtMatch(m) => {
      let sct = check_expr(m.scrutinee, s);
      let ok = !is_unknown(sct);
      let union_name = "";
      let struct_name = "";
      match (sct) {
        typeinfo.TypeUnion(u) => {
          union_name = u.name;
        },
        typeinfo.TypeStruct(sn) => {
          struct_name = sn.name;
        },
        _ => {}
      }
      for arm in m.arms {
        let armScope = s;
        match (arm.pattern) {
          ast.PatLiteral(literal) => {
            if (!is_primitive_type(sct)) {
              ok = false;
            }
            armScope = annotate_arm_scope(arm, s, sct);
          },
          ast.PatWildcard(_) => {},
          ast.PatVariant(pv) => {
            let pvn = variant_pattern_name(pv.type_name);
            let found: boolean = match (s.lookup_variant(pvn)) { Some(_) => true, None => false };
            let builtin_arm = union_name.len() > 0 && parser.builtin_enum_of(pvn) == union_name;
            if (scalar_binding_name(pv, sct, s).len() > 0) {
              armScope = bind_variant_payloads(armScope, s, pv, sct);
            } else if (!found && !builtin_arm) {
              ok = false;
            } else {
              if (union_name.len() > 0) {
                if (!builtin_arm && !is_variant_of(pvn, union_name, s.unions.unions)) {
                  ok = false;
                }
              } else if (struct_name.len() > 0) {
                if (struct_name != pvn) {
                  ok = false;
                }
              }
              armScope = bind_variant_payloads(armScope, s, pv, sct);
            }
          }
        }
        if (!check_block(arm.body, armScope)) {
          ok = false;
        }
      }
      if (!ok) {
        return CheckResult { scope: s, ty: t_unknown("match: ill-typed arm or scrutinee") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtBreak(_) => {
      if (s.loop_depth == 0) {
        return CheckResult { scope: s, ty: t_unknown("break outside loop") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtContinue(_) => {
      if (s.loop_depth == 0) {
        return CheckResult { scope: s, ty: t_unknown("continue outside loop") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtFor(f) => {
      let binding = for_binding(f, s);
      let fOk = check_block(f.body, binding.scope);
      if (!binding.valid) {
        return CheckResult { scope: s, ty: t_unknown("for-in: invalid iterator binding") };
      }
      if (!fOk) {
        return CheckResult { scope: s, ty: t_unknown("for-in: ill-typed body") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtUnknown(u) => {
      return CheckResult { scope: s, ty: t_unknown("parser-side unknown stmt:" + u.kind) };
    }
  }
  return CheckResult { scope: s, ty: t_unknown("unhandled Stmt variant") };
}

pub function bind_stmt(st: ast.Stmt, s: Scope): Scope {
  match (st) {
    ast.StmtDefer(d) => {
      return bind_stmt(d.action, s);
    },
    ast.StmtVar(v) => {
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return bind_destructure_names(s, v);
      }
      return bind_var(v, s, var_bind_type(v, s));
    },
    _ => {}
  }
  return s;
}

// var_bind_type is the type that bind_stmt gives the local of v.
function var_bind_type(v: ast.StmtVar, s: Scope): typeinfo.Type {
  if (v.type_name.len() > 0) {
    return var_declared_type(v, s);
  }
  let inferred = check_expr(v.init, rec_local_scope(v, s));
  if (bare_map(inferred)) {
    return t_unknown("map without types");
  }
  return inferred;
}

function bind_var(v: ast.StmtVar, s: Scope, t: typeinfo.Type): Scope {
  if (v.type_name.len() > 0) {
    return s.bind(v.name, t);
  }
  return s.bind_inferred(v, t);
}

// bare_map is a map type whose key or value type no expression gave, as the
// type of an unannotated `let m = Map { };`.
function bare_map(t: typeinfo.Type): boolean {
  if let typeinfo.TypeMap(m) = t {
    return map_new_column(m.key) || map_new_column(m.value);
  }
  return false;
}

function map_new_column(t: typeinfo.Type): boolean {
  let reason = unknown_reason(t);
  return reason == MAP_NEW_KEY || reason == MAP_NEW_VALUE;
}

function check_block(body: ast.Stmt[], s: Scope): boolean {
  let cur = s;
  let ok = true;
  for stmt in body {
    let r = check_stmt(stmt, cur);
    cur = r.scope;
    if (is_unknown(r.ty)) {
      ok = false;
    }
  }
  return ok;
}

pub struct ProgramTypes { tys: typeinfo.Type[] }

function check_program(prog: ast.Stmt[]): ProgramTypes {
  let s = new_scope();
  let tys: typeinfo.Type[] = [];
  for stmt in prog {
    let r = check_stmt(stmt, s);
    s = r.scope;
    tys = tys.append(r.ty);
  }
  return ProgramTypes { tys: tys };
}

function func_ret_type(fd: parser.FuncDecl, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  if (fd.ret_fn_ret.len() > 0 && parser.is_fn_contract_tag(fd.ret_type)) {
    return declared_callable_type(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types, tparams, subst, tn);
  }
  return type_from_name_subst(fd.ret_type, tparams, subst, tn);
}

function lambda_fn_type(lm: ast.ExprLambda, s: Scope): typeinfo.Type {
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(s.resolve_param(param));
  }
  return t_func_own(pts, lambda_owns(lm), lambda_ret_type(lm, s));
}

function rec_local_name(v: ast.StmtVar): string {
  if (ast.var_binds_itself(v)) {
    return v.name;
  }
  return "";
}

function rec_local_scope(v: ast.StmtVar, s: Scope): Scope {
  if let ast.ExprLambda(lm) = v.init {
    if (ast.var_binds_itself(v)) {
      return s.bind(v.name, lambda_fn_type(lm, s));
    }
  }
  return s;
}

function bind_mutual_siblings(stmts: ast.Stmt[], s: Scope): Scope {
  let fns = parser.nested_fns(stmts);
  let out = s;
  for f in fns {
    if (parser.nested_fn_cycle(fns, f.name).len() > 1) {
      out = out.bind(f.name, lambda_fn_type(f.lam, s));
    }
  }
  return out;
}

const INFERRED_RESULT: string = "inferred lambda result";

function lambda_ret_type(lm: ast.ExprLambda, s: Scope): typeinfo.Type {
  if (lm.ret_type.len() == 0) {
    if (lm.origin == parser.ORIGIN_USE && !is_unknown(s.ret_type)) {
      return s.ret_type;
    }
    return t_unknown(INFERRED_RESULT);
  }
  if (lm.ret_fn_ret.len() > 0 && parser.is_fn_contract_tag(lm.ret_type)) {
    return declared_callable_type(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types, s.tparams, rigid_tparams(s.tparams), s.type_names());
  }
  return s.resolve_type(lm.ret_type);
}

function var_declared_type(v: ast.StmtVar, s: Scope): typeinfo.Type {
  if (v.fn_ret.len() > 0 && parser.is_fn_contract_tag(v.type_name)) {
    return declared_callable_type(v.type_name, v.fn_ret, v.fn_param_types, s.tparams, rigid_tparams(s.tparams), s.type_names());
  }
  return s.resolve_type(v.type_name);
}

function collect_func_sigs(funcs: parser.FuncDecl[], tn: TypeNames): FuncSig[] {
  let out: FuncSig[] = [];
  let i = 0;
  while (i < funcs.len()) {
    let fd = funcs[i];
    if (fd.receiver_name.len() > 0) {
      i += 1;
      continue;
    }
    let pts: typeinfo.Type[] = [];
    let powns: boolean[] = [];
    let ptn: string[] = [];
    for param in fd.params {
      pts = pts.append(param_decl_type(param, fd.type_params, erased_tparams(fd.type_params), tn));
      powns = powns.append(param.own);
      ptn = ptn.append(parser.fn_tag_spelling(param.type_name, param.fn_ret, param.fn_param_types));
    }
    let tvs: string[] = [];
    for spelling in ptn {
      if (util.index_of_str(tvs, spelling) < 0 && gc_is_typevar_name(spelling, fd.type_params, tn)) {
        tvs = tvs.append(spelling);
      }
    }
    let rtn = parser.fn_tag_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types);
    out = out.append(FuncSig { receiver: fd.receiver_type, name: fd.name, param_types: pts, param_own: callable_own_flags(powns, pts.len()), ret_type: func_ret_type(fd, fd.type_params, erased_tparams(fd.type_params), tn), all_type_params: fd.all_type_params, type_params: fd.type_params, type_bounds: fd.bound_traits, ret_type_name: rtn, param_type_names: ptn, param_names: param_decl_names(fd.params), is_const: fd.is_const, typevars: tvs, module: fd.module, refs: generic_sig_refs(fd.all_type_params, ptn, rtn), is_unsafe: fd.is_unsafe, is_pub: fd.is_pub || fd.is_package });
    i += 1;
  }
  return out;
}

struct MethodBinding { names: string[], types: typeinfo.Type[], full: string[] }

function method_binding(c: ast.ExprCall, msig: MethodSig, recv: typeinfo.Type, s: Scope): MethodBinding {
  let rb = receiver_binding(msig, c.type_args, recv, s);
  let full = rb.full;
  if (full.len() == 0) {
    return rb;
  }
  let n2 = rb.names;
  let t2 = rb.types;
  let mi = 0;
  while (mi < c.args.len() && mi < msig.param_type_names.len()) {
    let ref = parser.parse_type_ref(msig.param_type_names[mi]);
    let dest = type_from_ref_subst(ref, n2, t2, s.type_names());
    let actual = fn_value_at(c.args[mi], dest, s);
    let (n3, t3) = gc_bind_param(ref, actual, full, s.type_names(), n2, t2);
    n2 = n3;
    t2 = t3;
    mi += 1;
  }
  return MethodBinding { names: n2, types: t2, full: full };
}

// receiver_binding binds the type variables of msig from the written type
// arguments and the receiver type alone.
function receiver_binding(msig: MethodSig, type_args: string[], recv: typeinfo.Type, s: Scope): MethodBinding {
  let rref = parser.parse_type_ref(msig.receiver_type);
  let full = ref_type_vars(rref, msig.all_type_params, s, []);
  for tp in msig.all_type_params {
    if (!util.has_str(full, tp)) {
      full = full.append(tp);
    }
  }
  let names: string[] = [];
  let types: typeinfo.Type[] = [];
  let offset = full.len() - type_args.len();
  if (offset < 0) {
    offset = 0;
  }
  let wi = 0;
  while (wi < type_args.len() && offset + wi < full.len()) {
    if (type_args[wi].len() > 0) {
      names = names.append(full[offset + wi]);
      types = types.append(type_from_spelling(type_args[wi], s.type_names()));
    }
    wi += 1;
  }
  let (n2, t2) = gc_bind_param(rref, recv, full, s.type_names(), names, types);
  return MethodBinding { names: n2, types: t2, full: full };
}

function ref_type_vars(r: parser.TypeRef, tparams: string[], s: Scope, acc: string[]): string[] {
  let out = acc;
  if (r.args.len() == 0) {
    if (gc_is_typevar_name(r.base, tparams, s.type_names()) && (util.has_str(tparams, r.base) || !util.has_str(s.tparams, r.base)) && !util.has_str(out, r.base)) {
      out = out.append(r.base);
    }
    return out;
  }
  for a in r.args {
    out = ref_type_vars(a, tparams, s, out);
  }
  return out;
}

function method_arg_diags(c: ast.ExprCall, method: string, msig: MethodSig, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let rmb = method_binding(c, msig, recv, s);
  let mi = 0;
  while (mi < c.args.len() && mi < msig.param_types.len()) {
    let mat = check_expr(c.args[mi], s);
    let want = receiver_bound(msig.param_types[mi], param_type_name_at(msig, mi), rmb, s);
    out = util.append_diags(out, int_dest_range_diags(c.args[mi], want));
    let unresolved_value = false;
    if (generic_fn_value_arg(c.args[mi], s)) {
      if let ast.ExprIdent(id) = c.args[mi] {
        if let typeinfo.TypeFunc(wf) = want {
          if let Some(sig) = s.lookup_sig(id.name) {
            let (bn, bt) = fn_value_binds(sig, wf, s);
            unresolved_value = bn.len() != sig.all_type_params.len();
          }
        }
      }
    }
    if (!unresolved_value && !is_unknown(want) && !elem_checked_literal(c.args[mi], msig.param_types[mi]) && !bound_arg_accepts(c.args[mi], mat, want, s) && !generic_own_callback_accepts(mat, want, rmb.names, param_type_name_at(msig, mi), s)) {
      out = out.append(dg_at("E038", "argument " + util.i32_to_string(mi + 1) + " to \"" + method + "\": expected " + type_label(want) + ", got " + type_label(mat), expr_line(c.args[mi]), expr_col(c.args[mi])));
    }
    out = util.append_diags(out, array_elem_check(array_elem_type_of(msig.param_types[mi]), c.args[mi], s));
    mi += 1;
  }
  let (bn, bt) = bounds_bindings(msig.type_params, msig.type_bounds, msig.module, s, rmb.names, rmb.types);
  return util.append_diags(out, call_bound_diags(msig.type_params, msig.type_bounds, msig.module, method_site(recv, msig.receiver_type, method), bn, bt, s, c.line, c.col));
}

function method_site(recv: typeinfo.Type, owner: string, method: string): string {
  if (is_unknown(recv) || is_type_variable(recv)) {
    return method;
  }
  return util.demangle(method_count_subject(recv, owner, method));
}

function method_type_arg_diags(c: ast.ExprCall, method: string, msig: MethodSig, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() == 0) {
    return out;
  }
  let full = method_binding(c, msig, recv, s).full.len();
  if (c.type_args.len() > full) {
    out = out.append(dg_at("E040", util.arity_message(method_count_subject(recv, msig.receiver_type, method), full, c.type_args.len(), "type argument"), c.line, c.col));
  }
  return out;
}

function method_count_subject(recv: typeinfo.Type, owner: string, method: string): string {
  if let typeinfo.TypeArray(a) = recv {
    return (if (a.view) { "slice" } else { "Array" }) + "." + method;
  }
  return util.base_type_name(owner) + "." + method;
}

function generic_method_ret(msig: MethodSig, mb: MethodBinding, s: Scope): typeinfo.Type {
  if (!type_contains_unknown(msig.ret_type) || msig.ret_type_name.len() == 0) {
    return msig.ret_type;
  }
  let bn = mb.names;
  let bt = mb.types;
  let (bn3, bt3) = bounds_bindings(msig.type_params, msig.type_bounds, msig.module, s, bn, bt);
  bn = bn3;
  bt = bt3;
  for tp in mb.full {
    if (util.index_of_str(bn, tp) < 0) {
      bn = bn.append(tp);
      bt = bt.append(t_unknown(TPARAM_MARK + tp));
    }
  }
  if (bn.len() == 0) {
    return msig.ret_type;
  }
  return type_from_ref_subst(parser.parse_type_ref(msig.ret_type_name), bn, bt, s.type_names());
}

function receiver_bound(t: typeinfo.Type, spelling: string, mb: MethodBinding, s: Scope): typeinfo.Type {
  if (!type_contains_unknown(t) || spelling.len() == 0 || mb.names.len() == 0) {
    return t;
  }
  return type_from_ref_subst(parser.parse_type_ref(spelling), mb.names, mb.types, s.type_names());
}

function param_type_name_at(msig: MethodSig, i: i32): string {
  if (i < msig.param_type_names.len()) {
    return msig.param_type_names[i];
  }
  return "";
}

function same_nominal(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(au) = a {
    if let typeinfo.TypeUnion(bu) = b {
      return au.name == bu.name;
    }
  }
  if let typeinfo.TypeStruct(ast_) = a {
    if let typeinfo.TypeStruct(bs) = b {
      return ast_.name == bs.name;
    }
  }
  return false;
}

function nominal_args(t: typeinfo.Type): typeinfo.Type[] {
  if let typeinfo.TypeStruct(st) = t {
    return st.args;
  }
  if let typeinfo.TypeUnion(u) = t {
    return u.args;
  }
  if let typeinfo.TypeMap(m) = t {
    return [m.key, m.value];
  }
  return [];
}

function is_dyn_slot(t: typeinfo.Type): boolean {
  if let typeinfo.TypeDyn(_) = t {
    return true;
  }
  return false;
}

function fills_unsettled_argument(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(fu) = from {
    if let typeinfo.TypeUnion(tu) = to {
      if (fu.name != tu.name || tu.args.len() == 0) {
        return false;
      }
      let i = 0;
      while (i < fu.args.len() && i < tu.args.len()) {
        if (unbound_enum_argument(tu.args[i]) && !is_unknown(fu.args[i])) {
          return true;
        }
        i += 1;
      }
    }
  }
  return false;
}

function nominal_args_clash(from: typeinfo.Type, to: typeinfo.Type, unions: UnionSig[]): boolean {
  if (!same_nominal(from, to)) {
    return false;
  }
  let fa = nominal_args(from);
  let ta = nominal_args(to);
  if (fa.len() != ta.len()) {
    if (ta.len() == 0) {
      return settles_any_argument(fa);
    }
    return fa.len() > 0;
  }
  let i = 0;
  while (i < fa.len()) {
    if (!is_unknown(fa[i]) && !is_unknown(ta[i]) && !nested_assignable(fa[i], ta[i], unions)) {
      return true;
    }
    i += 1;
  }
  return false;
}

// A generic type named without arguments binds every parameter to never, so
// it holds no value whose construction settled one.
function settles_any_argument(args: typeinfo.Type[]): boolean {
  for a in args {
    if (!is_unknown(a)) {
      return true;
    }
  }
  return false;
}

function type_ref_names_any(r: parser.TypeRef, vars: string[]): boolean {
  if (util.has_str(vars, r.base)) {
    return true;
  }
  for a in r.args {
    if (type_ref_names_any(a, vars)) {
      return true;
    }
  }
  return false;
}

function collect_method_sigs(funcs: parser.FuncDecl[], tn: TypeNames): MethodSig[] {
  let out: MethodSig[] = [];
  for fd in funcs {
    if (fd.receiver_name.len() > 0) {
      let pts: typeinfo.Type[] = [];
      let ptn: string[] = [];
      for param in fd.params {
        pts = pts.append(param_decl_type(param, fd.type_params, erased_tparams(fd.type_params), tn));
        ptn = ptn.append(parser.fn_tag_spelling(param.type_name, param.fn_ret, param.fn_param_types));
      }
      let rtn = parser.fn_tag_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types);
      out = out.append(MethodSig { name: fd.name, receiver_type: receiver_namespace(fd.receiver_type), param_types: pts, ret_type: func_ret_type(fd, fd.type_params, erased_tparams(fd.type_params), tn), ret_type_name: rtn, param_type_names: ptn, all_type_params: fd.all_type_params, type_params: fd.type_params, type_bounds: fd.bound_traits, module: fd.module, impl_trait: fd.impl_trait, line: fd.line, col: fd.col, file: decl_file_label(fd), is_unsafe: fd.is_unsafe, is_pub: fd.is_pub, is_package: fd.is_package });
    }
  }
  return out;
}

function collect_struct_sigs(structs: parser.StructDecl[], union_names: string[], resources: string[]): StructSig[] {
  let out: StructSig[] = [];
  let unions = util.name_index(union_names);
  let names: string[] = [];
  for sd in structs {
    if (sd.enum_owner.len() == 0 || !unions.has(sd.name)) {
      names = names.append(sd.name);
    }
  }
  let tn = type_names(names, union_names, resources);
  for sd in structs {
    let fnames: string[] = [];
    let ftypes: typeinfo.Type[] = [];
    let ftnames: string[] = [];
    for elem in sd.fields {
      fnames = fnames.append(elem.name);
      if (elem.fn_ret.len() > 0 && parser.is_fn_contract_tag(elem.type_name)) {
        ftypes = ftypes.append(declared_callable_type(elem.type_name, elem.fn_ret, elem.fn_param_types, sd.type_params, erased_tparams(sd.type_params), tn));
      } else {
        ftypes = ftypes.append(type_from_spelling(elem.type_name, tn));
      }
      ftnames = ftnames.append(parser.fn_tag_spelling(elem.type_name, elem.fn_ret, elem.fn_param_types));
    }
    out = out.append(StructSig { name: sd.name, field_names: fnames, field_types: ftypes, type_params: sd.type_params, const_params: sd.const_params, field_type_names: ftnames, variant_field_names: sd.variant_field_names, derives: sd.derives, enum_owner: sd.enum_owner, opaque: sd.opaque, module: sd.module, must_consume: sd.must_consume });
  }
  return out;
}

pub function type_from_name_with_structs(name: string, structs: StructSig[]): typeinfo.Type {
  return type_from_spelling(name, type_names(struct_sig_names(structs), [], []));
}

pub function type_from_name_with_struct_names(name: string, struct_names: string[]): typeinfo.Type {
  return type_from_spelling(name, type_names(struct_names, [], []));
}

pub function type_from_name_with_structs_unions(name: string, structs: StructSig[], unions: UnionSig[]): typeinfo.Type {
  let union_names = union_sig_names(unions);
  return type_from_spelling(name, type_names(type_head_names(structs, union_names), union_names, []));
}

pub function type_from_name_with_names_and_unions(name: string, struct_names: string[], union_names: string[]): typeinfo.Type {
  return type_from_spelling(name, type_names(struct_names, union_names, []));
}

function struct_sig_names(structs: StructSig[]): string[] {
  let out: string[] = [];
  for sd in structs {
    out = out.append(sd.name);
  }
  return out;
}

function union_sig_names(unions: UnionSig[]): string[] {
  let out: string[] = [];
  for u in unions {
    out = out.append(u.name);
  }
  return out;
}

function type_from_spelling(name: string, tn: TypeNames): typeinfo.Type {
  let memo = tn.spellings;
  let at = memo.names.find(name);
  if (at >= 0) {
    return memo.types[at];
  }
  return type_from_ref_names(parser.parse_type_ref(name), tn);
}

function enum_argument_from_ref(r: parser.TypeRef, tn: TypeNames): typeinfo.Type {
  if (parser.render_type_ref(r) == "$unbound") {
    return t_unknown("unbound lifted enum argument");
  }
  return type_from_ref_names(r, tn);
}

function type_from_ref_names(r: parser.TypeRef, tn: TypeNames): typeinfo.Type {
  if (r.array_depth > 0) {
    let elem = parser.elem_type_ref(r);
    return t_array(type_from_ref_names(elem, tn));
  }
  if (r.is_view) {
    return t_view(type_from_ref_names(r.args[0], tn));
  }
  if (builtin_vec(r, tn)) {
    return vec_type(r, [], [], tn);
  }
  let name = parser.render_type_ref(r);
  if (name.len() >= 5 && slice_unchecked(name, 0, 4) == "dyn ") {
    return t_dyn(slice_unchecked(name, 4, name.len()) + "");
  }
  if (names_resource_handle(name, tn)) {
    return resource_handle(name);
  }
  if (name == "i32") {
    return t_i32();
  }
  if (name == "char") {
    return t_char();
  }
  if (name == "i64") {
    return t_i64();
  }
  if (name == "u8") {
    return t_u8();
  }
  if (name == "u32") {
    return t_u32();
  }
  if (name == "u64") {
    return t_u64();
  }
  if (name == "usize") {
    return t_usize();
  }
  if (name == "boolean") {
    return t_bool();
  }
  if (name == "string") {
    return t_string();
  }
  if (name == "str") {
    return t_str();
  }
  if (name == "f32") {
    return t_f32();
  }
  if (name == "f64") {
    return t_float();
  }
  if (typeinfo.lanes_width(name) > 0) {
    return t_lanes(typeinfo.lanes_width(name));
  }
  if (name == "void") {
    return t_void();
  }
  if (parser.is_const_arg(name)) {
    return typeinfo.TypeConst { value: name };
  }
  if (parser.ref_is_fn_value(r)) {
    return callable_from_ref_names(r, tn);
  }
  if (name == "fn") {
    return t_func_opaque(t_unknown("fn result (the coarse tag records none)"));
  }
  if (r.is_tuple) {
    if (r.args.len() >= 2) {
      let elems: typeinfo.Type[] = [];
      for arg in r.args {
        elems = elems.append(type_from_ref_names(arg, tn));
      }
      return t_tuple(elems);
    }
  } else if (is_map_ref(r)) {
    return t_map(type_from_ref_names(r.args[0], tn), type_from_ref_names(r.args[1], tn));
  } else if (is_cell_ref(r)) {
    return t_struct_g("Cell", [type_from_ref_names(r.args[0], tn)]);
  } else if (is_wide_map_ref(r)) {
    let v_name = parser.render_type_ref(r.args[1]);
    let vk = 2;
    while (vk < r.args.len()) {
      v_name = v_name + ", " + parser.render_type_ref(r.args[vk]);
      vk += 1;
    }
    return t_map(type_from_ref_names(r.args[0], tn), type_from_spelling(v_name, tn));
  }
  if (parser.is_reserved_enum_name(r.base)) {
    let uargs: typeinfo.Type[] = [];
    for arg in r.args {
      uargs = uargs.append(enum_argument_from_ref(arg, tn));
    }
    return t_union_g(r.base, uargs);
  }
  if (r.args.len() > 0) {
    if (tn.structs.has(r.base)) {
      let gargs: typeinfo.Type[] = [];
      for arg in r.args {
        gargs = gargs.append(type_from_ref_names(arg, tn));
      }
      return t_struct_g(r.base, gargs);
    }
    if (tn.unions.has(r.base)) {
      let uinst: typeinfo.Type[] = [];
      for arg in r.args {
        uinst = uinst.append(enum_argument_from_ref(arg, tn));
      }
      return t_union_g(r.base, uinst);
    }
  }
  if (tn.structs.has(name)) {
    return t_struct(name);
  }
  if (tn.unions.has(name)) {
    return t_union(name);
  }
  if (parser.is_reserved_struct_name(name) && name != "Map" && name != "Cell") {
    return t_struct(name);
  }
  if (!r.is_tuple && r.args.len() > 0 && r.base != "Map" && r.base != "Cell") {
    if (!tn.structs.has(r.base) && !tn.unions.has(r.base)) {
      return t_union(r.base);
    }
  }
  return t_unknown(UNRESOLVED_MARK + name);
}

function callable_from_ref_names(r: parser.TypeRef, tn: TypeNames): typeinfo.Type {
  let f = parser.ref_ungroup(r);
  let params: typeinfo.Type[] = [];
  let owns: boolean[] = [];
  let i = 0;
  while (i + 1 < f.args.len()) {
    owns = owns.append(parser.ref_is_own(f.args[i]));
    params = params.append(type_from_ref_names(parser.ref_without_own(f.args[i]), tn));
    i += 1;
  }
  return t_func_own(params, owns, type_from_ref_names(parser.ref_fn_result(r), tn));
}

function type_from_ref_subst(r: parser.TypeRef, tparams: string[], targs: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  if (r.array_depth > 0) {
    let elem = parser.elem_type_ref(r);
    return t_array(type_from_ref_subst(elem, tparams, targs, tn));
  }
  if (r.is_view) {
    return t_view(type_from_ref_subst(r.args[0], tparams, targs, tn));
  }
  if (!r.is_tuple && r.args.len() == 0) {
    let tpi = util.index_of_str(tparams, r.base);
    if (tpi >= 0 && tpi < targs.len()) {
      return targs[tpi];
    }
    let sep = util.index_of_sub(r.base, "::");
    if (sep > 0) {
      let opi = util.index_of_str(tparams, slice_unchecked(r.base, 0, sep) + "");
      if (opi >= 0 && opi < targs.len() && is_type_variable(targs[opi]) && !is_unknown(targs[opi])) {
        return typeinfo.TypeErased { name: r.base };
      }
    }
  }
  if (parser.ref_is_fn_value(r)) {
    let f = parser.ref_ungroup(r);
    let pts: typeinfo.Type[] = [];
    let owns: boolean[] = [];
    let i = 0;
    while (i + 1 < f.args.len()) {
      let ref = parser.ref_without_own(f.args[i]);
      let param = type_from_ref_subst(ref, tparams, targs, tn);
      let on = parser.ref_is_own(f.args[i]);
      if (type_ref_names_any(ref, tparams) && !typeinfo.ownable(param)) {
        on = false;
      }
      owns = owns.append(on);
      pts = pts.append(param);
      i += 1;
    }
    return t_func_own(pts, owns, type_from_ref_subst(parser.ref_fn_result(r), tparams, targs, tn));
  }
  if (r.is_tuple && r.args.len() >= 2) {
    let elems: typeinfo.Type[] = [];
    for arg in r.args {
      elems = elems.append(type_from_ref_subst(arg, tparams, targs, tn));
    }
    return t_tuple(elems);
  }
  if (r.base == "Map" && r.args.len() == 2) {
    return t_map(type_from_ref_subst(r.args[0], tparams, targs, tn), type_from_ref_subst(r.args[1], tparams, targs, tn));
  }
  if (builtin_vec(r, tn)) {
    return vec_type(r, tparams, targs, tn);
  }
  let whole = type_from_ref_names(r, tn);
  if (r.is_tuple || r.args.len() == 0) {
    return whole;
  }
  let sargs: typeinfo.Type[] = [];
  let decoded = nominal_args(whole);
  let ai = 0;
  while (ai < r.args.len()) {
    if (ai < decoded.len() && unbound_enum_argument(decoded[ai])) {
      sargs = sargs.append(decoded[ai]);
    } else {
      sargs = sargs.append(type_from_ref_subst(r.args[ai], tparams, targs, tn));
    }
    ai += 1;
  }
  return with_nominal_args(whole, sargs);
}

// builtin_vec is a `Vec[N, T]` spelling where no declared type is named Vec.
function builtin_vec(r: parser.TypeRef, tn: TypeNames): boolean {
  return r.base == "Vec" && r.args.len() == 2 && r.array_depth == 0 && !r.is_tuple && !r.is_view && e064_unknown_bare("Vec", tn);
}

// vec_type is a lane type once N and T are a pair of the portable tier. A
// `Vec[N, T]` that the enclosing function names is its own type parameter.
function vec_type(r: parser.TypeRef, tparams: string[], targs: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  let at = util.index_of_str(tparams, parser.render_type_ref(r));
  if (at >= 0 && at < targs.len()) {
    return targs[at];
  }
  let n = type_from_ref_subst(r.args[0], tparams, targs, tn);
  let elem = type_from_ref_subst(r.args[1], tparams, targs, tn);
  if (is_unknown(n) && is_type_variable(n) || is_unknown(elem) && is_type_variable(elem)) {
    return t_unknown(TPARAM_MARK + parser.render_type_ref(r));
  }
  if (is_type_variable(n) || is_type_variable(elem)) {
    return typeinfo.TypeErased { name: parser.render_type_ref(r) };
  }
  let ns = "";
  if let typeinfo.TypeConst(c) = n {
    ns = c.value;
  }
  let lanes = typeinfo.vec_lanes(ns, typeinfo.spelling(elem));
  if (lanes.len() > 0) {
    return t_lanes(typeinfo.lanes_width(lanes));
  }
  return t_unknown(parser.render_type_ref(r) + " names no lane type");
}

function with_nominal_args(t: typeinfo.Type, args: typeinfo.Type[]): typeinfo.Type {
  if (nominal_args(t).len() != args.len()) {
    return t;
  }
  if let typeinfo.TypeStruct(st) = t {
    return typeinfo.TypeStruct { name: st.name, args: args };
  }
  if let typeinfo.TypeUnion(u) = t {
    return typeinfo.TypeUnion { name: u.name, args: args };
  }
  if let typeinfo.TypeMap(_) = t {
    return t_map(args[0], args[1]);
  }
  return t;
}

const TPARAM_MARK: string = "type parameter ";

const UNRESOLVED_MARK: string = "unrecognised type name: ";

pub function typevar_reason_name(reason: string): string {
  if (reason.len() > TPARAM_MARK.len() && util.str_has_prefix(reason, TPARAM_MARK)) {
    return slice_unchecked(reason, TPARAM_MARK.len(), reason.len()) + "";
  }
  if (reason.len() > UNRESOLVED_MARK.len() && util.str_has_prefix(reason, UNRESOLVED_MARK)) {
    return slice_unchecked(reason, UNRESOLVED_MARK.len(), reason.len()) + "";
  }
  return "";
}

function tvar_name(t: typeinfo.Type): string {
  if let typeinfo.TypeUnknown(u) = t {
    let name = typevar_reason_name(u.reason);
    if (parser.looks_type_var(name)) {
      return name;
    }
  }
  return "";
}

function is_type_variable(t: typeinfo.Type): boolean {
  if let typeinfo.TypeErased(_) = t {
    return true;
  }
  return tvar_name(t).len() > 0;
}

function unknown_beyond_tvars(t: typeinfo.Type): boolean {
  if (is_type_variable(t)) {
    return false;
  }
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return !unbound_enum_argument(t);
    },
    typeinfo.TypeArray(ae) => {
      return unknown_beyond_tvars(ae.elem);
    },
    typeinfo.TypeTuple(tt) => {
      for element in tt.elements {
        if (unknown_beyond_tvars(element)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeMap(m) => {
      return unknown_beyond_tvars(m.key) || unknown_beyond_tvars(m.value);
    },
    typeinfo.TypeStruct(sn) => {
      for arg in sn.args {
        if (unknown_beyond_tvars(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        if (unknown_beyond_tvars(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeFunc(f) => {
      if (unknown_beyond_tvars(f.ret_type)) {
        return true;
      }
      for param_type in f.param_types {
        if (unknown_beyond_tvars(param_type)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function type_from_name_erasing_tparams(name: string, tparams: string[], tn: TypeNames): typeinfo.Type {
  return type_from_name_subst(name, tparams, erased_tparams(tparams), tn);
}

function type_from_name_subst(name: string, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  if (tparams.len() == 0 || name.len() == 0 || name.len() >= 5 && slice_unchecked(name, 0, 4) == "dyn ") {
    return type_from_spelling(name, tn);
  }
  return type_from_ref_subst(parser.parse_type_ref(name), tparams, subst, tn);
}

function erased_tparams(tparams: string[]): typeinfo.Type[] {
  let erased: typeinfo.Type[] = [];
  for tp in tparams {
    erased = erased.append(t_unknown(TPARAM_MARK + tp));
  }
  return erased;
}

// generic_vecs are the `Vec[N, T]` spellings in a signature that name a type
// parameter. The body sees each one as a type parameter of its own.
function generic_vecs(fd: parser.FuncDecl, tps: string[], tn: TypeNames): string[] {
  let out: string[] = [];
  let spellings: string[] = [fd.ret_type];
  for p in fd.params {
    spellings = spellings.append(p.type_name);
  }
  for sp in spellings {
    out = vecs_in_ref(parser.parse_type_ref(sp), tps, tn, out);
  }
  return out;
}

function vecs_in_ref(r: parser.TypeRef, tps: string[], tn: TypeNames, out: string[]): string[] {
  if (builtin_vec(r, tn) && type_ref_names_any(r, tps) && vec_lane_types(r, tps).len() > 0) {
    let v = parser.render_type_ref(r);
    if (!util.has_str(out, v)) {
      out = out.append(v);
    }
    return out;
  }
  for a in r.args {
    out = vecs_in_ref(parser.ref_without_own(a), tps, tn, out);
  }
  return out;
}

// vec_bounds are the traits that every lane type a generic `Vec[N, T]` can
// stand for implements.
function vec_bounds(r: parser.TypeRef, tps: string[], s: Scope): string {
  let common: string[] = [];
  let first = true;
  for lanes in vec_lane_types(r, tps) {
    let have: string[] = [];
    for im in s.impls {
      if (im.impl_type == lanes && im.type_params.len() == 0) {
        have = have.append(parser.impl_trait_key(im));
      }
    }
    if (first) {
      common = have;
      first = false;
    } else {
      let kept: string[] = [];
      for t in common {
        if (util.has_str(have, t)) {
          kept = kept.append(t);
        }
      }
      common = kept;
    }
  }
  return common.join(" + ");
}

// vec_lane_types are the lane types a `Vec[N, T]` can stand for.
function vec_lane_types(r: parser.TypeRef, tps: string[]): string[] {
  let out: string[] = [];
  for lanes in typeinfo.lane_types() {
    let fit = typeinfo.lane_vec_spellings(lanes);
    if (vec_arg_fits(r.args[0], fit[0], tps) && vec_arg_fits(r.args[1], fit[1], tps)) {
      out = out.append(lanes);
    }
  }
  return out;
}

function vec_arg_fits(a: parser.TypeRef, want: string, tps: string[]): boolean {
  return a.args.len() == 0 && (a.base == want || util.has_str(tps, a.base));
}

function rigid_tparams(tparams: string[]): typeinfo.Type[] {
  let rigid: typeinfo.Type[] = [];
  for tp in tparams {
    rigid = rigid.append(typeinfo.TypeErased { name: tp });
  }
  return rigid;
}

function gc_is_typevar_name(n: string, tparams: string[], tn: TypeNames): boolean {
  if (n.len() == 0) {
    return false;
  }
  if (util.index_of_str(tparams, n) >= 0) {
    return true;
  }
  return type_contains_unknown(type_from_spelling(n, tn));
}

function gc_bind_param(r: parser.TypeRef, at: typeinfo.Type, tparams: string[], tn: TypeNames, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  let ns = names;
  let ts = types;
  if (r.array_depth > 0 || r.is_view) {
    match (at) {
      typeinfo.TypeArray(a) => {
        if (r.array_depth > 0) {
          return gc_bind_param(parser.elem_type_ref(r), a.elem, tparams, tn, ns, ts);
        }
        return gc_bind_param(r.args[0], a.elem, tparams, tn, ns, ts);
      },
      _ => {
        return (ns, ts);
      }
    }
  }
  if (parser.ref_is_fn_value(r)) {
    if let typeinfo.TypeFunc(f) = at {
      let fr = parser.ref_ungroup(r);
      if (f.params_known && f.param_types.len() + 1 == fr.args.len()) {
        let fi = 0;
        while (fi < f.param_types.len()) {
          let (fn2, ft2) = gc_bind_param(parser.ref_without_own(fr.args[fi]), f.param_types[fi], tparams, tn, ns, ts);
          ns = fn2;
          ts = ft2;
          fi += 1;
        }
        let (rn2, rt2) = gc_bind_param(parser.ref_fn_result(r), f.ret_type, tparams, tn, ns, ts);
        ns = rn2;
        ts = rt2;
      }
    }
    return (ns, ts);
  }
  if (r.is_tuple && r.args.len() >= 2) {
    match (at) {
      typeinfo.TypeTuple(tp) => {
        if (tp.elements.len() == r.args.len()) {
          let ti = 0;
          while (ti < r.args.len()) {
            let (tn2, tt2) = gc_bind_param(r.args[ti], tp.elements[ti], tparams, tn, ns, ts);
            ns = tn2;
            ts = tt2;
            ti += 1;
          }
        }
      },
      _ => {}
    }
    return (ns, ts);
  }
  let nargs = nominal_args(at);
  if (builtin_vec(r, tn)) {
    nargs = typeinfo.lane_vec_args(at);
  }
  if (r.args.len() > 0 && nargs.len() == r.args.len()) {
    let ni = 0;
    while (ni < r.args.len()) {
      let (nn2, nt2) = gc_bind_param(r.args[ni], nargs[ni], tparams, tn, ns, ts);
      ns = nn2;
      ts = nt2;
      ni += 1;
    }
    return (ns, ts);
  }
  if (r.args.len() == 0 && (!is_unknown(at) || is_type_variable(at)) && !elemless_array(at) && gc_is_typevar_name(r.base, tparams, tn)) {
    let index = util.index_of_str(ns, r.base);
    if (index < 0) {
      ns = ns.append(r.base);
      ts = ts.append(at);
    } else if (is_type_variable(ts[index]) && !is_unknown(at)) {
      ts = ts.with(index, at);
    } else if let typeinfo.TypeUnion(prior) = ts[index] {
      if let typeinfo.TypeUnion(actual) = at {
        let joined = join_enum_arguments(prior, actual);
        if (!is_unknown(joined)) {
          ts = ts.with(index, joined);
        }
      }
    }
  }
  return (ns, ts);
}

function declared_union_names(mod: parser.Module): string[] {
  let out: string[] = [];
  for alias in mod.aliases {
    out = out.append(alias.name);
  }
  for ed in mod.enums {
    out = out.append(ed.name);
  }
  return out;
}

function collect_union_sigs(mod: parser.Module): UnionSig[] {
  let out: UnionSig[] = [];
  let i = 0;
  while (i < mod.aliases.len()) {
    let a = mod.aliases[i];
    if (parser.alias_registers(mod, i)) {
      out = out.append(UnionSig { name: a.name, variants: a.variants, is_try: false, is_enum: false, module: a.module, type_params: [], const_params: [], instance: "", visible_from: [], must_consume: false });
    }
    i += 1;
  }
  return out;
}

function validate_union_sigs(unions: UnionSig[], struct_names: string[]): boolean {
  for u in unions {
    for variant in u.variants {
      let name = variant;
      let k = 0;
      let found = false;
      while (k < struct_names.len()) {
        if (struct_names[k] == name) {
          found = true;
          break;
        }
        k += 1;
      }
      if (!found) {
        return false;
      }
    }
  }
  return true;
}

// sig_tparam_is_const reports whether tp is a const parameter of sig.
function sig_tparam_is_const(sig: FuncSig, tp: string): boolean {
  let k = util.index_of_str(sig.type_params, tp);
  return k >= 0 && k < sig.type_bounds.len() && parser.is_const_bound(sig.type_bounds[k]);
}

function const_arg_diags(sig: FuncSig, c: ast.ExprCall, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let i = 0;
  while (i < sig.all_type_params.len() && i < c.type_args.len()) {
    let tp = sig.all_type_params[i];
    let arg = c.type_args[i];
    let is_const = sig_tparam_is_const(sig, tp);
    if (is_const && parser.is_const_arg(arg) && !parser.const_arg_fits(arg)) {
      out = out.append(dg_at("E089", "the const argument for " + tp + " must fit in i32", c.line, c.col));
    } else if (is_const && !parser.is_const_arg(arg) && !s.is_const_param(arg)) {
      if (arg.len() == 0 || s.defines(arg)) {
        out = out.append(dg_at("E089", "the const argument for " + tp + " must be an integer literal or a const parameter", c.line, c.col));
      } else {
        out = out.append(dg_at("E090", "const parameter " + tp + " takes an integer, not the type " + arg, c.line, c.col));
      }
    } else if (!is_const && parser.is_const_arg(arg)) {
      out = out.append(dg_at("E090", "type parameter " + tp + " takes a type, not the integer " + arg, c.line, c.col));
    }
    i += 1;
  }
  return out;
}

function const_tparams(fd: parser.FuncDecl): string[] {
  let out: string[] = [];
  let i = 0;
  while (i < fd.type_params.len() && i < fd.bound_traits.len()) {
    if (parser.is_const_bound(fd.bound_traits[i])) {
      out = out.append(fd.type_params[i]);
    }
    i += 1;
  }
  return out;
}

function build_func_scope(fd: parser.FuncDecl, st: SigTable, structs: StructTable, unions: UnionTable, methods: MethodTable, imports: Imports, impls: parser.ImplInfo[], trait_reqs: parser.TraitReq[]): Scope {
  let s = Scope { ...new_scope_full(st, structs, unions.seen_from(fd), methods, imports, impls, trait_reqs), fn_module: fd.module, fn_stdlib: fd.stdlib.len() > 0 };
  if (fd.impl_trait.len() > 0 && parser.is_inherited_default(impls, trait_reqs, fd)) {
    s = Scope { ...s, default_trait: fd.impl_trait, default_recv: util.base_type_name(fd.receiver_type) };
  }
  let tps = func_scope_tparams(fd);
  let declared_from = tps.len();
  if (fd.receiver_type.len() > 0) {
    let rbase = util.base_type_name(fd.receiver_type);
    let rtvs = struct_type_params(s, rbase);
    if (rtvs.len() == 0) {
      rtvs = union_type_params(s, rbase);
    }
    for rtv in rtvs {
      if (util.index_of_str(tps, rtv) < 0) {
        tps = tps.append(rtv);
      }
    }
  }
  let tbs: string[] = [];
  for b in fd.bound_traits {
    tbs = tbs.append(bounds_in_module(b, fd.module));
  }
  while (tbs.len() < tps.len()) {
    tbs = tbs.append("");
  }
  let k = declared_from;
  while (k < tps.len()) {
    if (tbs[k].len() == 0) {
      tbs = tbs.with(k, fd.impl_trait);
    }
    k += 1;
  }
  for tv in fd.all_type_params {
    if (!util.has_str(tps, tv)) {
      tps = tps.append(tv);
      tbs = tbs.append("");
    }
  }
  let rcv = receiver_const_vars(s, fd.receiver_type);
  for ri in 0..tps.len() {
    if (util.has_str(rcv, tps[ri])) {
      tbs = tbs.with(ri, parser.CONST_BOUND);
    }
  }
  for v in generic_vecs(fd, tps, s.type_names()) {
    tps = tps.append(v);
    tbs = tbs.append(vec_bounds(parser.parse_type_ref(v), tps, s));
  }
  s = s.with_tparams(tps, tbs);
  if (fd.ret_type.len() > 0) {
    s = s.with_ret_type(func_ret_type(fd, tps, rigid_tparams(tps), s.type_names()));
  }
  if (fd.receiver_name.len() > 0) {
    s = s.bind(fd.receiver_name, type_from_name_subst(fd.receiver_type, tps, rigid_tparams(tps), s.type_names()));
  }
  for param in fd.params {
    s = s.bind(param.name, param_decl_type(param, tps, rigid_tparams(tps), s.type_names()));
  }
  for name in const_tparams(fd) {
    s = s.bind(name, t_i32());
  }
  for name in rcv {
    s = s.bind(name, t_i32());
  }
  return s;
}

// receiver_const_vars is the names a receiver spelling gives to the const
// parameters of its struct or enum: N in `function (r: Ring[N, T]) cap()`.
function receiver_const_vars(s: Scope, receiver_type: string): string[] {
  let out: string[] = [];
  if (receiver_type.len() == 0) {
    return out;
  }
  let r = parser.parse_type_ref(receiver_type);
  match (s.lookup_struct(r.base)) {
    Some(sig) => {
      return parser.const_arg_names(r, sig.type_params, sig.const_params);
    },
    None => {}
  }
  return match (s.lookup_union(r.base)) { Some(u) => parser.const_arg_names(r, u.type_params, u.const_params), None => out };
}

function func_scope_tparams(fd: parser.FuncDecl): string[] {
  if (fd.receiver_type.len() == 0) {
    return fd.type_params;
  }
  return parser.type_str_vars(fd.receiver_type, fd.type_params);
}

function split_fn_param_spellings(csv: string): string[] {
  let out: string[] = [];
  let start = 0;
  let depth = 0;
  let i = 0;
  while (i <= csv.len()) {
    if (i == csv.len() || csv[i] == b',' && depth == 0) {
      out = out.append(slice_unchecked(csv, start, i) + "");
      start = i + 1;
    } else if (csv[i] == b'(' || csv[i] == b'[') {
      depth += 1;
    } else if (csv[i] == b')' || csv[i] == b']') {
      depth -= 1;
    }
    i += 1;
  }
  return out;
}

function param_decl_type(p: ast.ParamDecl, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  let t = fn_param_decl_type(p, tparams, subst, tn);
  if (is_unknown(t)) {
    t = type_from_name_subst(p.type_name, tparams, subst, tn);
  }
  return t;
}

function fn_param_decl_type(p: ast.ParamDecl, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  if (!parser.is_fn_contract_tag(p.type_name) || p.fn_ret.len() == 0) {
    return t_unknown("opaque fn param");
  }
  return declared_callable_type(p.type_name, p.fn_ret, p.fn_param_types, tparams, subst, tn);
}

function (s: Scope) resolve_param(p: ast.ParamDecl): typeinfo.Type {
  let ty = fn_param_decl_type(p, s.tparams, rigid_tparams(s.tparams), s.type_names());
  if (!is_unknown(ty)) {
    return ty;
  }
  return s.resolve_type(p.type_name);
}

function declared_callable_type(name: string, ret: string, params: string, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  let pts: typeinfo.Type[] = [];
  let powns: boolean[] = [];
  if (params.len() > 0) {
    for seg in split_fn_param_spellings(params) {
      powns = powns.append(parser.spelling_is_own(seg));
      pts = pts.append(type_from_name_subst(parser.spelling_without_own(seg), tparams, subst, tn));
    }
  }
  let ft = t_func_own(pts, powns, type_from_name_subst(ret, tparams, subst, tn));
  if (name == "fn[]") {
    return t_array(ft);
  }
  if (name == "[fn]") {
    return t_view(ft);
  }
  return ft;
}

function check_func_body(fd: parser.FuncDecl, s: Scope): boolean {
  let generic = s.tparams.len() > 0 || fd.all_type_params.len() > 0;
  if (!generic && fd.receiver_type.len() > 0) {
    if (type_contains_unknown(s.resolve_type(fd.receiver_type))) {
      generic = true;
    }
  }
  let ok = true;
  for stmt in fd.body {
    let r = check_stmt(stmt, s);
    s = r.scope;
    if (!generic && is_unknown(r.ty)) {
      ok = false;
    }
  }
  return ok;
}

function name_with_args_label(name: string, args: typeinfo.Type[]): string {
  if (args.len() == 0) {
    return name;
  }
  let out = name + "[";
  let i = 0;
  while (i < args.len()) {
    if (i > 0) {
      out += ", ";
    }
    if (unbound_enum_argument(args[i])) {
      out += "_";
    } else {
      out += type_label(args[i]);
    }
    i += 1;
  }
  return out + "]";
}

pub function type_label(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeString(st) => {
      if (st.tag == 1) {
        return "str";
      }
      return "string";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    typeinfo.TypeArray(a) => {
      return array_label(a);
    },
    typeinfo.TypeStruct(sd) => {
      return name_with_args_label(sd.name, sd.args);
    },
    typeinfo.TypeTuple(tp) => {
      return "(" + labels_joined(tp.elements) + ")";
    },
    typeinfo.TypeFunc(f) => {
      return func_label(f);
    },
    typeinfo.TypeMap(m) => {
      return "Map[" + type_label(m.key) + ", " + type_label(m.value) + "]";
    },
    typeinfo.TypeUnion(u) => {
      return name_with_args_label(u.name, u.args);
    },
    typeinfo.TypeDyn(d) => {
      return "dyn " + d.traits;
    },
    typeinfo.TypeHandle(h) => {
      return typeinfo.handle_spelling(h);
    },
    typeinfo.TypeVoid(_) => {
      return "void";
    },
    typeinfo.TypeNever(_) => {
      return "never";
    },
    typeinfo.TypeConst(c) => {
      return c.value;
    },
    typeinfo.TypeUnknown(_) => {
      return "unknown";
    },
    typeinfo.TypeErased(e) => {
      return e.name;
    }
  }
  return "unknown";
}

function array_label(a: typeinfo.TypeArray): string {
  if (a.view) {
    return "[" + type_label(a.elem) + "]";
  }
  if let typeinfo.TypeFunc(ef) = a.elem {
    if (ef.params_known) {
      return "(" + type_label(a.elem) + ")[]";
    }
  }
  return type_label(a.elem) + "[]";
}

function labels_joined(ts: typeinfo.Type[]): string {
  let out = "";
  let i = 0;
  while (i < ts.len()) {
    if (i > 0) {
      out += ", ";
    }
    out += type_label(ts[i]);
    i += 1;
  }
  return out;
}

function func_label(f: typeinfo.TypeFunc): string {
  if (!f.params_known) {
    return "fn";
  }
  let out = "(";
  let i = 0;
  while (i < f.param_types.len()) {
    if (i > 0) {
      out += ", ";
    }
    if (typeinfo.fn_own_at(f, i)) {
      out += "own ";
    }
    out += type_label(f.param_types[i]);
    i += 1;
  }
  return out + ") => " + type_label(f.ret_type);
}

function keep_code(diags: util.Diag[], code: string): util.Diag[] {
  let out: util.Diag[] = [];
  for diag in diags {
    if (diag.code == code) {
      out = out.append(diag);
    }
  }
  return out;
}

// The diagnostics for `value` flowing into a slot of type `ty`; `what` names
// the slot in the E002 for a mismatch.
function value_dest_diags(value: ast.Expr, cur: Scope, ty: typeinfo.Type, unions: UnionSig[], what: string, line: i32, col: i32): util.Diag[] {
  let t = check_expr(value, cur);
  let out = int_dest_range_diags(value, ty);
  out = util.append_diags(out, ctor_payload_diags(value, ty, cur));
  let bound = dest_bound_diags(value, ty, cur);
  out = util.append_diags(out, bound);
  if (!use_untyped_call(value) && bound.len() == 0 && !is_unknown(t) && !settles_to_dest(value, ty, cur) && !(type_assignable(t, ty, unions) && dyn_conforms(t, ty, cur))) {
    out = out.append(dg_at("E002", what + ": expected " + type_label(ty) + ", got " + type_label(t) + str_copy_hint(t, ty), line, col));
  }
  return out;
}

function const_value_diags(fd: parser.FuncDecl, s: Scope, ty: typeinfo.Type, unions: UnionSig[]): util.Diag[] {
  if (is_unknown(ty)) {
    return [];
  }
  for st in fd.body {
    if let ast.StmtReturn(r) = st {
      return value_dest_diags(r.value, s, ty, unions, "const " + fd.name, fd.line, fd.col);
    }
  }
  return [];
}

function ret_diags(stmts: ast.Stmt[], s: Scope, ret_ty: typeinfo.Type, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  if (is_unknown(ret_ty)) {
    return out;
  }
  let cur = s;
  for st in stmts {
    out = util.append_diags(out, ret_diags_in_exprs(st, cur, ret_ty, unions, false));
    match (st) {
      ast.StmtReturn(r) => {
        let bare = false;
        match (r.value) {
          ast.ExprUnknown(u) => {
            if (u.kind == parser.BARE_RETURN) {
              bare = true;
            }
          },
          _ => {}
        }
        if (bare) {
          out = out.append(dg_at("E012", "return without value in function returning " + type_label(ret_ty), r.line, r.col));
        } else {
          out = util.append_diags(out, value_dest_diags(r.value, cur, ret_ty, unions, "return value", r.line, r.col));
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, ret_diags(f.then_body, cur, ret_ty, unions));
        out = util.append_diags(out, ret_diags(f.else_body, cur, ret_ty, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, ret_diags(w.body, cur, ret_ty, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, ret_diags(fr.body, for_body_scope(fr, cur), ret_ty, unions));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, ret_diags(arm.body, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), ret_ty, unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, ret_diags(one, cur, ret_ty, unions));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function ret_diags_in_exprs(st: ast.Stmt, cur: Scope, ret_ty: typeinfo.Type, unions: UnionSig[], is_void: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  for e in stmt_exprs(st) {
    out = astwalk.fold_expr_pruned(
      e, out, (x: ast.Expr, own a: util.Diag[]): util.Diag[] => {
        match (x) {
          ast.ExprCall(c) => {
            if (parser.is_value_block(c)) {
              return util.append_diags(a, vb_ret_diags(parser.vb_body(c), cur, ret_ty, unions, is_void));
            }
            return a;
          },
          _ => {
            return a;
          }
        }
        return a;
      },
      not_a_scope_root,
    );
  }
  return out;
}

function stmt_exprs(st: ast.Stmt): ast.Expr[] {
  let out: ast.Expr[] = [];
  match (st) {
    ast.StmtVar(v) => {
      return out.append(v.init);
    },
    ast.StmtReturn(r) => {
      return out.append(r.value);
    },
    ast.StmtExpr(e) => {
      return out.append(e.value);
    },
    ast.StmtAssign(a) => {
      return out.append(a.value);
    },
    ast.StmtIf(i) => {
      return out.append(i.cond);
    },
    ast.StmtWhile(w) => {
      return out.append(w.cond);
    },
    ast.StmtFor(f) => {
      return out.append(f.iter);
    },
    ast.StmtMatch(m) => {
      out = out.append(m.scrutinee);
      for arm in m.arms {
        if (arm.has_guard) {
          out = out.append(arm.guard);
        }
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

function vb_ret_diags(body: ast.Stmt[], s: Scope, ret_ty: typeinfo.Type, unions: UnionSig[], is_void: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  if (body.len() == 0) {
    return out;
  }
  let cur = s;
  let i = 0;
  while (i + 1 < body.len()) {
    out = util.append_diags(out, stmt_ret_diags(body[i], cur, ret_ty, unions, is_void));
    cur = bind_stmt(body[i], cur);
    i += 1;
  }
  match (body[i]) {
    ast.StmtReturn(_) => {
      return util.append_diags(out, ret_diags_in_exprs(body[i], cur, ret_ty, unions, is_void));
    },
    ast.StmtIf(f) => {
      out = util.append_diags(out, ret_diags_in_exprs(body[i], cur, ret_ty, unions, is_void));
      out = util.append_diags(out, vb_ret_diags(f.then_body, cur, ret_ty, unions, is_void));
      return util.append_diags(out, vb_ret_diags(f.else_body, cur, ret_ty, unions, is_void));
    },
    ast.StmtMatch(m) => {
      out = util.append_diags(out, ret_diags_in_exprs(body[i], cur, ret_ty, unions, is_void));
      for arm in m.arms {
        out = util.append_diags(out, vb_ret_diags(arm.body, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), ret_ty, unions, is_void));
      }
      return out;
    },
    _ => {
      return util.append_diags(out, stmt_ret_diags(body[i], cur, ret_ty, unions, is_void));
    }
  }
  return out;
}

function stmt_ret_diags(st: ast.Stmt, s: Scope, ret_ty: typeinfo.Type, unions: UnionSig[], is_void: boolean): util.Diag[] {
  let one: ast.Stmt[] = [st];
  if (is_void) {
    return void_ret_diags(one, s, unions);
  }
  return ret_diags(one, s, ret_ty, unions);
}

function void_return_diag(r: ast.StmtReturn, cur: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  match (r.value) {
    ast.ExprUnknown(u) => {
      if (u.kind == parser.BARE_RETURN) {
        return out;
      }
    },
    _ => {}
  }
  let t = check_expr(r.value, cur);
  if (!is_void(t)) {
    out = out.append(dg_at("E002", "return value: expected void, got " + type_label(t), r.line, r.col));
  }
  return out;
}

function void_ret_diags(stmts: ast.Stmt[], s: Scope, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur = s;
  for st in stmts {
    out = util.append_diags(out, ret_diags_in_exprs(st, cur, t_void(), unions, true));
    match (st) {
      ast.StmtReturn(r) => {
        out = util.append_diags(out, void_return_diag(r, cur));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, void_ret_diags(f.then_body, cur, unions));
        out = util.append_diags(out, void_ret_diags(f.else_body, cur, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, void_ret_diags(w.body, cur, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, void_ret_diags(fr.body, for_body_scope(fr, cur), unions));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, void_ret_diags(arm.body, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, void_ret_diags(one, cur, unions));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function name_in(name: string, list: string[]): boolean {
  for entry in list {
    if (entry == name) {
      return true;
    }
  }
  return false;
}

pub struct ViewSum { key: string, flags: boolean[], fresh: boolean }

pub struct ViewIndex { head: i32[], next: i32[] }

function view_index(sums: ViewSum[]): ViewIndex {
  let head = util.minus_ones(sig_buckets());
  let next = util.minus_ones(sums.len());
  let k = sums.len() - 1;
  while (k >= 0) {
    let bk = sig_name_bucket(sums[k].key);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    k -= 1;
  }
  return ViewIndex { head: head, next: next };
}

function view_sum_pos(sums: ViewSum[], vix: ViewIndex, key: string): i32 {
  let i = vix.head[sig_name_bucket(key)];
  while (i >= 0) {
    if (sums[i].key == key) {
      return i;
    }
    i = vix.next[i];
  }
  return -1;
}

pub struct ViewRoots { local: boolean, params: string[] }

pub struct ViewCallee { key: string, args: ast.Expr[] }

function view_sum_key(fn: parser.FuncDecl): string {
  return parser.decl_key(fn);
}

function view_positions(fn: parser.FuncDecl): string[] {
  let out: string[] = [];
  for param in fn.params {
    out = out.append(param.name);
  }
  if (fn.receiver_name.len() > 0) {
    out = out.append(fn.receiver_name);
  }
  return out;
}

function view_sum_flags(sums: ViewSum[], vix: ViewIndex, key: string): boolean[] {
  let at = view_sum_pos(sums, vix, key);
  if (at >= 0) {
    return sums[at].flags;
  }
  let none: boolean[] = [];
  return none;
}

function view_sum_known(sums: ViewSum[], vix: ViewIndex, key: string): boolean {
  return view_sum_pos(sums, vix, key) >= 0;
}

function view_sum_fresh(sums: ViewSum[], vix: ViewIndex, key: string): boolean {
  let at = view_sum_pos(sums, vix, key);
  if (at >= 0) {
    return sums[at].fresh;
  }
  return false;
}

function view_recv_key(obj: ast.Expr, s: Scope): string {
  match (check_expr(obj, s)) {
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeStruct(sd) => {
      return util.base_type_name(sd.name);
    },
    typeinfo.TypeUnion(u) => {
      return util.base_type_name(u.name);
    },
    _ => {}
  }
  return "";
}

function view_callee(c: ast.ExprCall, s: Scope): ViewCallee {
  let none: ast.Expr[] = [];
  match (c.callee) {
    ast.ExprIdent(cid) => {
      return ViewCallee { key: cid.name, args: c.args };
    },
    ast.ExprFieldAccess(cfa) => {
      let recv = view_recv_key(cfa.obj, s);
      if (recv.len() == 0) {
        return ViewCallee { key: "", args: none };
      }
      let xs = c.args;
      return ViewCallee { key: recv + "." + cfa.field, args: xs.append(cfa.obj) };
    },
    _ => {}
  }
  return ViewCallee { key: "", args: none };
}

function no_view_roots(): ViewRoots {
  let none: string[] = [];
  return ViewRoots { local: false, params: none };
}

function merge_view_roots(a: ViewRoots, b: ViewRoots): ViewRoots {
  let ps = a.params;
  for n in b.params {
    if (!e065_ident_in(n, ps)) {
      ps = ps.append(n);
    }
  }
  return ViewRoots { local: a.local || b.local, params: ps };
}

function merge_view_names(a: string[], b: string[]): string[] {
  let out = a;
  for n in b {
    if (!e065_ident_in(n, out)) {
      out = out.append(n);
    }
  }
  return out;
}

// slc_views_string holds for `s.as_bytes()` on a `string`: its bytes live as
// long as that string does.
function slc_views_string(c: ast.ExprCall, cur: Scope): boolean {
  if let ast.ExprFieldAccess(fa) = c.callee {
    return fa.field == "as_bytes" && c.args.len() == 0 && is_owned_string(check_expr(fa.obj, cur));
  }
  return false;
}

function call_receiver(c: ast.ExprCall): ast.Expr {
  if let ast.ExprFieldAccess(fa) = c.callee {
    return fa.obj;
  }
  return c.callee;
}

// slc_string_roots is the storage a `string` value lends to a view of its bytes.
function slc_string_roots(e: ast.Expr, cur: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  match (e) {
    ast.ExprString(_) => {
      return no_view_roots();
    },
    ast.ExprIdent(id) => {
      if (name_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      let none: string[] = [];
      return ViewRoots { local: name_in(id.name, tainted), params: none };
    },
    ast.ExprCall(c) => {
      let callee = view_callee(c, cur);
      if (view_sum_known(sums, vix, callee.key)) {
        return slc_call_roots(c, cur, params, localarr, tainted, sums, vix);
      }
    },
    _ => {}
  }
  let none: string[] = [];
  return ViewRoots { local: true, params: none };
}

function slc_src_roots(e: ast.Expr, cur: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  match (e) {
    ast.ExprBytes(_) => {
      return ViewRoots { local: true, params: [] };
    },
    ast.ExprArray(_) => {
      let none: string[] = [];
      return ViewRoots { local: true, params: none };
    },
    ast.ExprSlice(s2) => {
      return slc_src_roots(s2.array, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprCall(c2) => {
      if (slc_views_string(c2, cur)) {
        return slc_string_roots(call_receiver(c2), cur, params, localarr, tainted, sums, vix);
      }
      return slc_call_roots(c2, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprIdent(id) => {
      if (name_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (name_in(id.name, localarr) || name_in(id.name, tainted)) {
        let no: string[] = [];
        return ViewRoots { local: true, params: no };
      }
    },
    _ => {}
  }
  return no_view_roots();
}

function slc_call_roots(c: ast.ExprCall, cur: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  let out = no_view_roots();
  let callee = view_callee(c, cur);
  if (callee.key.len() == 0) {
    return out;
  }
  if (view_sum_fresh(sums, vix, callee.key)) {
    out = ViewRoots { local: true, params: out.params };
  }
  let flags = view_sum_flags(sums, vix, callee.key);
  let i = 0;
  while (i < flags.len() && i < callee.args.len()) {
    if (flags[i] && is_owned_string(check_expr(callee.args[i], cur))) {
      out = merge_view_roots(out, slc_string_roots(callee.args[i], cur, params, localarr, tainted, sums, vix));
    } else if (flags[i]) {
      out = merge_view_roots(out, slc_src_roots(callee.args[i], cur, params, localarr, tainted, sums, vix));
    }
    i += 1;
  }
  return out;
}

function slc_expr_roots(e: ast.Expr, cur: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  match (e) {
    ast.ExprArray(_) => {
      let none: string[] = [];
      return ViewRoots { local: true, params: none };
    },
    ast.ExprSlice(sl) => {
      match (check_expr(sl.array, cur)) {
        typeinfo.TypeString(_) => {
          return no_view_roots();
        },
        _ => {}
      }
      return slc_src_roots(sl.array, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprCall(c) => {
      if (slc_views_string(c, cur)) {
        return slc_string_roots(call_receiver(c), cur, params, localarr, tainted, sums, vix);
      }
      return slc_call_roots(c, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprIdent(id) => {
      if (name_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (name_in(id.name, tainted)) {
        let no: string[] = [];
        return ViewRoots { local: true, params: no };
      }
    },
    _ => {}
  }
  return no_view_roots();
}

pub struct SlcWalk { diags: util.Diag[], viewed: string[], owns: boolean }

function slc_walk(stmts: ast.Stmt[], fname: string, s: Scope, params: string[], localarr: string[], tainted: string[], held: string[], sums: ViewSum[], vix: ViewIndex, ret_is_view: boolean): SlcWalk {
  let out: util.Diag[] = [];
  let viewed: string[] = [];
  let owns = false;
  let cur = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (is_arr_view(var_declared_type(v, cur)) && is_owned_array(check_expr(v.init, cur))) {
          if (slc_src_roots(v.init, cur, params, localarr, tainted, sums, vix).local) {
            tainted = tainted.append(v.name);
          }
        }
        held = slc_held_after(v, cur, params, localarr, tainted, held, sums, vix);
        match (v.init) {
          ast.ExprBytes(_) => {
            localarr = localarr.append(v.name);
          },
          ast.ExprArray(_) => {
            localarr = localarr.append(v.name);
          },
          _ => {
            if (slc_expr_roots(v.init, cur, params, localarr, tainted, sums, vix).local) {
              tainted = tainted.append(v.name);
            }
          }
        }
      },
      ast.StmtReturn(r) => {
        if (ret_is_view) {
          let roots = slc_expr_roots(r.value, cur, params, localarr, tainted, sums, vix);
          viewed = merge_view_names(viewed, roots.params);
          if (roots.local) {
            out = out.append(slc_escape_diag(fname, r.line, r.col));
          }
        } else {
          let sroots = slc_src_roots(r.value, cur, params, localarr, tainted, sums, vix);
          viewed = merge_view_names(viewed, sroots.params);
          if (sroots.local) {
            owns = true;
          }
          let aroots = slc_agg_roots(r.value, cur.ret_type, cur, params, localarr, tainted, held, sums, vix);
          viewed = merge_view_names(viewed, aroots.params);
          out = util.append_diags(out, slc_escape_diags_if(aroots.local, fname, r.line, r.col));
        }
      },
      ast.StmtIf(f) => {
        let wt = slc_walk(f.then_body, fname, cur, params, localarr, tainted, held, sums, vix, ret_is_view);
        out = util.append_diags(out, wt.diags);
        viewed = merge_view_names(viewed, wt.viewed);
        owns = owns || wt.owns;
        let we = slc_walk(f.else_body, fname, cur, params, localarr, tainted, held, sums, vix, ret_is_view);
        out = util.append_diags(out, we.diags);
        viewed = merge_view_names(viewed, we.viewed);
        owns = owns || we.owns;
      },
      ast.StmtWhile(w) => {
        let ww = slc_walk(w.body, fname, cur, params, localarr, tainted, held, sums, vix, ret_is_view);
        out = util.append_diags(out, ww.diags);
        viewed = merge_view_names(viewed, ww.viewed);
        owns = owns || ww.owns;
      },
      ast.StmtFor(fr) => {
        let wf = slc_walk(fr.body, fname, for_body_scope(fr, cur), params, localarr, tainted, held, sums, vix, ret_is_view);
        out = util.append_diags(out, wf.diags);
        viewed = merge_view_names(viewed, wf.viewed);
        owns = owns || wf.owns;
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          let wa = slc_walk(arm.body, fname, cur, params, localarr, tainted, held, sums, vix, ret_is_view);
          out = util.append_diags(out, wa.diags);
          viewed = merge_view_names(viewed, wa.viewed);
          owns = owns || wa.owns;
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        let wd = slc_walk(one, fname, cur, params, localarr, tainted, held, sums, vix, ret_is_view);
        out = util.append_diags(out, wd.diags);
        viewed = merge_view_names(viewed, wd.viewed);
        owns = owns || wd.owns;
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return SlcWalk { diags: out, viewed: viewed, owns: owns };
}

function slc_call_names(fn: parser.FuncDecl): string[] {
  let out: string[] = [];
  for st in fn.body {
    out = astwalk.fold_stmt(st, out, slc_call_name_at);
  }
  return out;
}

function slc_call_name_at(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprCall(c) = e {
    match (c.callee) {
      ast.ExprIdent(cid) => {
        return acc.append(cid.name);
      },
      ast.ExprFieldAccess(cfa) => {
        return acc.append(cfa.field);
      },
      _ => {
        return acc;
      }
    }
  }
  return acc;
}

function slc_callees(calls: util.NameIndex, names: util.NameIndex): i32[] {
  let out: i32[] = [];
  for name in calls.names {
    let k = names.chain(name);
    while (k >= 0) {
      if (names.names[k] == name) {
        out = out.append(k);
      }
      k = names.next[k];
    }
  }
  return out;
}

// slc_callee_order puts each function after the functions its call names reach, except in a cycle.
function slc_callee_order(calls: util.NameIndex[], names: util.NameIndex): i32[] {
  let edges: i32[][] = [];
  for c in calls {
    edges = edges.append(slc_callees(c, names));
  }
  let order: i32[] = [];
  let seen = __alloc_bool(calls.len());
  let stack = __alloc_i32(calls.len());
  let next = __alloc_i32(calls.len());
  let r = 0;
  while (r < calls.len()) {
    if (!seen[r]) {
      seen = seen.with(r, true);
      stack = stack.with(0, r);
      next = next.with(0, 0);
      let depth = 1;
      while (depth > 0) {
        let v = stack[depth - 1];
        let e = next[depth - 1];
        if (e < edges[v].len()) {
          next = next.with(depth - 1, e + 1);
          let w = edges[v][e];
          if (!seen[w]) {
            seen = seen.with(w, true);
            stack = stack.with(depth, w);
            next = next.with(depth, 0);
            depth += 1;
          }
        } else {
          order = order.append(v);
          depth -= 1;
        }
      }
    }
    r += 1;
  }
  return order;
}

// slc_stale says a callee name changed its summary after the walk at stamp `walked`.
function slc_stale(calls: util.NameIndex, names: util.NameIndex, changed: i32[], walked: i32): boolean {
  for name in calls.names {
    let at = names.find(name);
    if (at >= 0 && changed[at] > walked) {
      return true;
    }
  }
  return false;
}

pub struct ViewPart { value: ast.Expr, to: typeinfo.Type }

// A type that is not itself a view but may carry one: a view inside it, or a type variable that a view can instantiate.
function holds_view_aggregate(t: typeinfo.Type, s: Scope): boolean {
  if (is_arr_view(t) || is_str_view(t)) {
    return false;
  }
  if (mentions_type_variable(t)) {
    return true;
  }
  let kind = match (t) { typeinfo.TypeStruct(_) => "struct:", typeinfo.TypeUnion(_) => "union:", typeinfo.TypeArray(_) => "array:", typeinfo.TypeTuple(_) => "tuple:", typeinfo.TypeMap(_) => "map:", _ => { return false; } };
  let spelling = typeinfo.spelling(t);
  if (spelling.len() == 0) {
    let (holds, _) = type_holds_view(t, s, []);
    return holds;
  }
  let key = kind + spelling;
  // Cache only complete root queries. A recursive visit can skip an ancestor that carries a view.
  let memo = s.unions.view_memo.get();
  let at = memo.names.find(key);
  if (at >= 0) {
    return memo.holds[at];
  }
  let (holds, _) = type_holds_view(t, s, []);
  s.unions.view_memo.set(ViewMemo { names: memo.names.added(key), holds: memo.holds.append(holds) });
  return holds;
}

function mentions_type_variable(t: typeinfo.Type): boolean {
  if (is_type_variable(t)) {
    return true;
  }
  match (t) {
    typeinfo.TypeArray(a) => {
      return mentions_type_variable(a.elem);
    },
    typeinfo.TypeTuple(tt) => {
      return any_mentions_type_variable(tt.elements);
    },
    typeinfo.TypeStruct(st) => {
      return any_mentions_type_variable(st.args);
    },
    typeinfo.TypeUnion(u) => {
      return any_mentions_type_variable(u.args);
    },
    _ => {}
  }
  return false;
}

function any_mentions_type_variable(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (mentions_type_variable(t)) {
      return true;
    }
  }
  return false;
}

// The fields, elements and payloads an aggregate literal of type `to` builds, each with its slot type.
function view_parts(e: ast.Expr, to: typeinfo.Type, s: Scope): ViewPart[] {
  let out: ViewPart[] = [];
  match (e) {
    ast.ExprStructLit(sl) => {
      return struct_view_parts(sl, to, s);
    },
    ast.ExprTuple(tl) => {
      return tuple_view_parts(tl, to);
    },
    ast.ExprArray(arr) => {
      if let typeinfo.TypeArray(ta) = to {
        for el in arr.elements {
          out = out.append(ViewPart { value: el, to: ta.elem });
        }
      }
    },
    ast.ExprCall(c) => {
      for k in 0..c.args.len() {
        out = out.append(ViewPart { value: c.args[k], to: variant_pattern_payload_type(s, ctor_variant_name(c), to, k) });
      }
    },
    _ => {}
  }
  return out;
}

function tuple_view_parts(tl: ast.ExprTuple, to: typeinfo.Type): ViewPart[] {
  let out: ViewPart[] = [];
  if let typeinfo.TypeTuple(tt) = to {
    if (tl.elements.len() == tt.elements.len()) {
      for i in 0..tl.elements.len() {
        out = out.append(ViewPart { value: tl.elements[i], to: tt.elements[i] });
      }
    }
  }
  return out;
}

function struct_view_parts(sl: ast.ExprStructLit, to: typeinfo.Type, s: Scope): ViewPart[] {
  let out: ViewPart[] = [];
  if let Some(ssig) = s.lookup_struct(sl.type_name) {
    let args = nominal_args(to);
    for i in 0..sl.field_values.len() {
      let fidx = field_index(ssig, sl.field_names[i]);
      if (fidx >= 0) {
        out = out.append(ViewPart { value: sl.field_values[i], to: lit_field_type(ssig, fidx, args, s) });
      }
    }
  }
  if (sl.has_base) {
    out = out.append(ViewPart { value: sl.base, to: to });
  }
  return out;
}

// A slot typed by a type variable holds a view only through what the caller passed, never local storage.
function param_roots_only(r: ViewRoots): ViewRoots {
  return ViewRoots { local: false, params: r.params };
}

function held_roots(name: string, params: string[], held: string[]): ViewRoots {
  if (name_in(name, params)) {
    return ViewRoots { local: false, params: [name] };
  }
  return ViewRoots { local: name_in(name, held), params: [] };
}

function returns_view_or_holder(fd: parser.FuncDecl, s: Scope): boolean {
  return parser.spelling_is_view(fd.ret_type) || holds_view_aggregate(s.ret_type, s);
}

function e065_summarised(fd: parser.FuncDecl, s: Scope): boolean {
  return fd.ret_type == "string" || e065_checked(fd, s);
}

function e065_checked(fd: parser.FuncDecl, s: Scope): boolean {
  return fd.ret_type == "str" || holds_view_aggregate(s.ret_type, s);
}

function is_view_ctor(e: ast.Expr, to: typeinfo.Type, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    return constructor_destination(c, to, s);
  }
  return false;
}

function bound_type(v: ast.StmtVar, s: Scope): typeinfo.Type {
  if (v.type_name.len() > 0) {
    return var_declared_type(v, s);
  }
  return check_expr(v.init, s);
}

function slc_escape_diags_if(local: boolean, fname: string, line: i32, col: i32): util.Diag[] {
  if (local) {
    return [slc_escape_diag(fname, line, col)];
  }
  return [];
}

function slc_held_after(v: ast.StmtVar, cur: Scope, params: string[], localarr: string[], tainted: string[], held: string[], sums: ViewSum[], vix: ViewIndex): string[] {
  let vty = bound_type(v, cur);
  if (holds_view_aggregate(vty, cur) && slc_agg_roots(v.init, vty, cur, params, localarr, tainted, held, sums, vix).local) {
    return held.append(v.name);
  }
  return held;
}

function slc_escape_diag(fname: string, line: i32, col: i32): util.Diag {
  return dg_at("E063", "returning a `[T]` slice that views function-local storage: the backing array is reclaimed when \"" + fname + "\" returns, leaving a dangling view — return an owned array (`T[]`) or slice a parameter instead", line, col);
}

// The roots of every `[T]` view a value of type `to` carries, directly or inside an aggregate.
function slc_agg_roots(e: ast.Expr, to: typeinfo.Type, cur: Scope, params: string[], localarr: string[], tainted: string[], held: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  if (is_arr_view(to)) {
    return slc_expr_roots(e, cur, params, localarr, tainted, sums, vix);
  }
  if (is_type_variable(to)) {
    return param_roots_only(slc_expr_roots(e, cur, params, localarr, tainted, sums, vix));
  }
  if (!holds_view_aggregate(to, cur)) {
    return no_view_roots();
  }
  if let ast.ExprIdent(id) = e {
    return held_roots(id.name, params, held);
  }
  if let ast.ExprCall(c) = e {
    if (!is_view_ctor(e, to, cur)) {
      return slc_agg_call_roots(c, cur, params, localarr, tainted, held, sums, vix);
    }
  }
  let out = no_view_roots();
  for p in view_parts(e, to, cur) {
    out = merge_view_roots(out, slc_agg_roots(p.value, p.to, cur, params, localarr, tainted, held, sums, vix));
  }
  return out;
}

function slc_agg_call_roots(c: ast.ExprCall, cur: Scope, params: string[], localarr: string[], tainted: string[], held: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  let out = no_view_roots();
  let callee = view_callee(c, cur);
  let flags = view_sum_flags(sums, vix, callee.key);
  for i in 0..flags.len() {
    if (flags[i] && i < callee.args.len()) {
      let at = check_expr(callee.args[i], cur);
      if (holds_view_aggregate(at, cur)) {
        out = merge_view_roots(out, slc_agg_roots(callee.args[i], at, cur, params, localarr, tainted, held, sums, vix));
      } else {
        out = merge_view_roots(out, slc_src_roots(callee.args[i], cur, params, localarr, tainted, sums, vix));
      }
    }
  }
  return out;
}

// These facts depend on the function and scope, not the call summaries.
struct SlcFunction { scope: Scope, params: string[], fixed_strings: string[] }

function slice_escape_diags(fn: parser.FuncDecl, prepared: SlcFunction, sums: ViewSum[], vix: ViewIndex): SlcWalk {
  let localarr: string[] = [];
  let held: string[] = [];
  return slc_walk(fn.body, fn.name, prepared.scope, prepared.params, localarr, prepared.fixed_strings, held, sums, vix, parser.spelling_is_view(fn.ret_type));
}

// fixed_string_locals is each `string` local that the body never reassigns: its
// bytes are storage the function owns. A reassigned one may hold another string
// by the time it is viewed, so it is left to the flow analysis in semsource.
function fixed_string_locals(body: ast.Stmt[], s: Scope): string[] {
  let declared: string[] = [];
  for st in body {
    declared = astwalk.fold_stmt_spine(st, declared, (vs: ast.Stmt, own acc: string[]): string[] => string_local_name(vs, acc, s));
  }
  if (declared.len() == 0) {
    return declared;
  }
  let assigned: string[] = [];
  for st in body {
    assigned = astwalk.fold_stmt_spine(st, assigned, assigned_name);
  }
  let out: string[] = [];
  for name in declared {
    if (!name_in(name, assigned)) {
      out = out.append(name);
    }
  }
  return out;
}

function string_local_name(st: ast.Stmt, own acc: string[], s: Scope): string[] {
  if let ast.StmtVar(v) = st {
    if (v.type_name == "string" || v.type_name.len() == 0 && is_owned_string(check_expr(v.init, s))) {
      return acc.append(v.name);
    }
  }
  return acc;
}

function assigned_name(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtAssign(a) = st {
    return acc.append(a.target);
  }
  return acc;
}

function mc_any_marked(structs: parser.StructDecl[], enums: parser.EnumDecl[]): boolean {
  for sd in structs {
    if (sd.must_consume) {
      return true;
    }
  }
  for ed in enums {
    if (ed.must_consume) {
      return true;
    }
  }
  return false;
}

function mc_struct_marked(name: string, structs: parser.StructDecl[]): boolean {
  for sd in structs {
    if (sd.name == name) {
      return sd.must_consume;
    }
  }
  return false;
}

function mc_enum_marked(name: string, enums: parser.EnumDecl[]): boolean {
  for ed in enums {
    if (ed.name == name) {
      return ed.must_consume;
    }
  }
  return false;
}

function mc_marked_type_name(tn: string, structs: parser.StructDecl[], enums: parser.EnumDecl[]): string {
  if (tn.len() == 0) {
    return "";
  }
  if (mc_struct_marked(tn, structs)) {
    return tn;
  }
  if (mc_enum_marked(tn, enums)) {
    return tn;
  }
  return "";
}

function mc_is_binding(e: ast.Expr, name: string): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == name;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function mc_mentions_stmts(stmts: ast.Stmt[], name: string): boolean {
  function see_expr(n: ast.Expr, own acc: boolean): boolean {
    match (n) {
      ast.ExprIdent(id) => {
        return acc || id.name == name;
      },
      _ => {
        return acc;
      }
    }
  }
  function see_stmt(st: ast.Stmt, own acc: boolean): boolean {
    match (st) {
      ast.StmtAssign(a) => {
        return acc || a.target == name;
      },
      _ => {
        return acc;
      }
    }
  }
  let found = false;
  for stmt in stmts {
    found = astwalk.fold_stmt_nodes(stmt, found, see_stmt, see_expr, astwalk.descend_all);
  }
  return found;
}

function mc_list_consumes(list: ast.Expr[], name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let out: util.Diag[] = [];
  for entry in list {
    let (c2, d2) = mc_expr_consumes(entry, name, tname, report, structs, enums);
    out = util.append_diags(out, d2);
    if (c2) {
      return (true, out);
    }
  }
  return (false, out);
}

function mc_call_enum_owner(callee: ast.Expr, enums: parser.EnumDecl[]): string {
  let owner = "";
  match (callee) {
    ast.ExprIdent(cid) => {
      owner = mx_enum_of(cid.name, enums);
      if (owner.len() == 0) {
        owner = parser.builtin_enum_of(cid.name);
      }
    },
    _ => {}
  }
  return owner;
}

function mc_call_consumes(c: ast.ExprCall, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  let owner = mc_call_enum_owner(c.callee, enums);
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (mc_is_binding(fa.obj, name)) {
      return (true, none);
    }
  }
  for arg in c.args {
    if (mc_is_binding(arg, name)) {
      if (owner.len() == 0 || mc_enum_marked(owner, enums)) {
        return (true, none);
      }
      let d: util.Diag[] = [];
      if (report) {
        d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into unmarked enum \"" + owner + "\" — the consumption obligation is lost; mark \"" + owner + "\" @must_consume or consume the value directly", c.line, c.col));
      }
      return (true, d);
    }
  }
  match (c.callee) {
    ast.ExprLambda(ilm) => {
      let (bc, bdv, bd) = mc_seq(ilm.body, 0, name, tname, structs, enums);
      if (report) {
        return (bc, bd);
      }
      return (bc, none);
    },
    _ => {}
  }
  let (kc, kd) = mc_expr_consumes(c.callee, name, tname, report, structs, enums);
  if (kc) {
    return (true, kd);
  }
  return mc_list_consumes(c.args, name, tname, report, structs, enums);
}

function mc_structlit_consumes(sl: ast.ExprStructLit, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  for field_value in sl.field_values {
    if (mc_is_binding(field_value, name)) {
      if (mc_struct_marked(sl.type_name, structs)) {
        return (true, none);
      }
      let d: util.Diag[] = [];
      if (report) {
        d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into unmarked struct \"" + sl.type_name + "\" — the consumption obligation is lost; mark \"" + sl.type_name + "\" @must_consume or consume the value directly", sl.line, sl.col));
      }
      return (true, d);
    }
  }
  if (sl.has_base) {
    let (bc, bd) = mc_expr_consumes(sl.base, name, tname, report, structs, enums);
    if (bc) {
      return (true, bd);
    }
  }
  return mc_list_consumes(sl.field_values, name, tname, report, structs, enums);
}

function mc_expr_consumes(e: ast.Expr, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      return mc_call_consumes(c, name, tname, report, structs, enums);
    },
    ast.ExprStructLit(sl) => {
      return mc_structlit_consumes(sl, name, tname, report, structs, enums);
    },
    ast.ExprArray(ar) => {
      for element in ar.elements {
        if (mc_is_binding(element, name)) {
          let d: util.Diag[] = [];
          if (report) {
            d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into an array literal — arrays cannot carry consumption obligations; consume the value directly", expr_line(element), expr_col(element)));
          }
          return (true, d);
        }
      }
      return mc_list_consumes(ar.elements, name, tname, report, structs, enums);
    },
    ast.ExprTuple(tp) => {
      for element in tp.elements {
        if (mc_is_binding(element, name)) {
          let d2: util.Diag[] = [];
          if (report) {
            d2 = d2.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into a tuple — tuples cannot carry consumption obligations; consume the value directly", tp.line, tp.col));
          }
          return (true, d2);
        }
      }
      return mc_list_consumes(tp.elements, name, tname, report, structs, enums);
    },
    ast.ExprLambda(lm) => {
      if (mc_mentions_stmts(lm.body, name)) {
        let d3: util.Diag[] = [];
        if (report) {
          d3 = d3.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" captured by a closure — obligations cannot flow into closures; consume the value directly", 0, 0));
        }
        return (true, d3);
      }
      return (false, none);
    },
    ast.ExprBinary(b) => {
      let (lc, ld) = mc_expr_consumes(b.left, name, tname, report, structs, enums);
      if (lc) {
        return (true, ld);
      }
      let (rc, rd) = mc_expr_consumes(b.right, name, tname, report, structs, enums);
      return (rc, util.append_diags(ld, rd));
    },
    ast.ExprUnary(u) => {
      return mc_expr_consumes(u.operand, name, tname, report, structs, enums);
    },
    ast.ExprIndex(ix) => {
      let (ac, ad) = mc_expr_consumes(ix.array, name, tname, report, structs, enums);
      if (ac) {
        return (true, ad);
      }
      return mc_expr_consumes(ix.index, name, tname, report, structs, enums);
    },
    ast.ExprSlice(sl2) => {
      let (sc, sd) = mc_expr_consumes(sl2.array, name, tname, report, structs, enums);
      if (sc) {
        return (true, sd);
      }
      let (stc, std) = mc_expr_consumes(sl2.start, name, tname, report, structs, enums);
      if (stc) {
        return (true, std);
      }
      return mc_expr_consumes(sl2.end, name, tname, report, structs, enums);
    },
    ast.ExprFieldAccess(fa) => {
      return mc_expr_consumes(fa.obj, name, tname, report, structs, enums);
    },
    _ => {
      return (false, none);
    }
  }
  return (false, none);
}

function mc_stmt_consumes(st: ast.Stmt, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  match (st) {
    ast.StmtExpr(es) => {
      return mc_expr_consumes(es.value, name, tname, report, structs, enums);
    },
    ast.StmtVar(v) => {
      if (mc_is_binding(v.init, name)) {
        return (true, none);
      }
      return mc_expr_consumes(v.init, name, tname, report, structs, enums);
    },
    ast.StmtReturn(r) => {
      if (mc_is_binding(r.value, name)) {
        return (true, none);
      }
      return mc_expr_consumes(r.value, name, tname, report, structs, enums);
    },
    ast.StmtAssign(a) => {
      if (mc_is_binding(a.value, name)) {
        return (true, none);
      }
      return mc_expr_consumes(a.value, name, tname, report, structs, enums);
    },
    ast.StmtMatch(m) => {
      if (mc_is_binding(m.scrutinee, name)) {
        return (true, none);
      }
      return mc_expr_consumes(m.scrutinee, name, tname, report, structs, enums);
    },
    ast.StmtIf(f) => {
      return mc_expr_consumes(f.cond, name, tname, report, structs, enums);
    },
    _ => {
      return (false, none);
    }
  }
  return (false, none);
}

// A literal match lowers to `if (true) { let tmp = scrutinee; ... }`, so
// that wrapper is one block and not a branch.
function mc_if_is_block(f: ast.StmtIf): boolean {
  if (f.else_body.len() > 0) {
    return false;
  }
  if let ast.ExprBool(b) = f.cond {
    return b.value;
  }
  return false;
}

function mc_seq(stmts: ast.Stmt[], from: i32, name: string, tname: string, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, boolean, util.Diag[]) {
  let out: util.Diag[] = [];
  let i = from;
  while (i < stmts.len()) {
    let st = stmts[i];
    let (con, cd) = mc_stmt_consumes(st, name, tname, true, structs, enums);
    out = util.append_diags(out, cd);
    if (con) {
      return (true, false, out);
    }
    match (st) {
      ast.StmtReturn(_) => {
        return (false, true, out);
      },
      ast.StmtBreak(_) => {
        return (false, true, out);
      },
      ast.StmtContinue(_) => {
        return (false, true, out);
      },
      ast.StmtIf(f) => {
        let (tc, tv, td) = mc_seq(f.then_body, 0, name, tname, structs, enums);
        out = util.append_diags(out, td);
        let ec = false;
        let ev = false;
        if (f.else_body.len() > 0) {
          let (ec2, ev2, ed) = mc_seq(f.else_body, 0, name, tname, structs, enums);
          out = util.append_diags(out, ed);
          ec = ec2;
          ev = ev2;
        }
        if (tv || ev) {
          return (false, true, out);
        }
        if (tc && (f.else_body.len() > 0 && ec || mc_if_is_block(f))) {
          return (true, false, out);
        }
      },
      ast.StmtMatch(m) => {
        if (ordinary_match_origin(m.origin)) {
          let all = m.arms.len() > 0;
          for arm in m.arms {
            let (ac, av, ad) = mc_seq(arm.body, 0, name, tname, structs, enums);
            out = util.append_diags(out, ad);
            if (av) {
              return (false, true, out);
            }
            if (!ac) {
              all = false;
            }
          }
          if (all) {
            return (true, false, out);
          }
        }
      },
      _ => {}
    }
    i += 1;
  }
  return (false, false, out);
}

function mc_check_binding(stmts: ast.Stmt[], from: i32, name: string, tname: string, bline: i32, bcol: i32, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let (con, div, out) = mc_seq(stmts, from, name, tname, structs, enums);
  if (!con || div) {
    out = out.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" bound to \"" + name + "\" may go out of scope without being consumed — pass it, return it, match on it, or store it into another @must_consume type on every path", bline, bcol));
    return out;
  }
  let i = from;
  while (i < stmts.len()) {
    let (q, qd) = mc_stmt_consumes(stmts[i], name, tname, false, structs, enums);
    if (q) {
      return out;
    }
    match (stmts[i]) {
      ast.StmtAssign(a) => {
        if (a.target == name) {
          out = out.append(dg_at("E067", "overwriting \"" + name + "\" while it still holds an unconsumed @must_consume \"" + tname + "\" value — consume the old value first", a.line, a.col));
          return out;
        }
      },
      _ => {}
    }
    i += 1;
  }
  return out;
}

function mc_var_type_name(v: ast.StmtVar, cur: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): string {
  let tn = v.type_name;
  if (tn.len() == 0) {
    match (check_expr(v.init, cur)) {
      typeinfo.TypeStruct(ts) => {
        tn = ts.name;
      },
      typeinfo.TypeUnion(tu) => {
        tn = tu.name;
      },
      _ => {
        return "";
      }
    }
  }
  return mc_marked_type_name(tn, structs, enums);
}

function mc_walk_body(stmts: ast.Stmt[], s: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur = s;
  let i = 0;
  while (i < stmts.len()) {
    let st = stmts[i];
    match (st) {
      ast.StmtVar(v) => {
        let tn = mc_var_type_name(v, cur, structs, enums);
        if (tn.len() > 0) {
          out = util.append_diags(out, mc_check_binding(stmts, i + 1, v.name, tn, v.line, v.col, structs, enums));
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, mc_walk_body(f.then_body, cur, structs, enums));
        out = util.append_diags(out, mc_walk_body(f.else_body, cur, structs, enums));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, mc_walk_body(w.body, cur, structs, enums));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, mc_walk_body(fr.body, for_body_scope(fr, cur), structs, enums));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, mc_walk_body(arm.body, cur, structs, enums));
        }
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
    i += 1;
  }
  return out;
}

function must_consume_diags(fn: parser.FuncDecl, s: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  for p in fn.params {
    if (!p.own) {
      let tn = mc_marked_type_name(p.type_name, structs, enums);
      if (tn.len() > 0) {
        out = util.append_diags(out, mc_check_binding(fn.body, 0, p.name, tn, fn.line, fn.col, structs, enums));
      }
    }
  }
  out = util.append_diags(out, mc_walk_body(fn.body, s, structs, enums));
  return out;
}

struct LambdaExits { types: typeinfo.Type[], bare: boolean }

struct ExitFold { ty: typeinfo.Type, have: boolean, clash_with: typeinfo.Type[], clash: typeinfo.Type[] }

function fold_exits(types: typeinfo.Type[]): ExitFold {
  let out = ExitFold { ty: t_unknown("no value exit"), have: false, clash_with: [], clash: [] };
  for t in types {
    if (!exit_type_known(t)) {
      continue;
    }
    if (!out.have) {
      out = ExitFold { ...out, ty: t, have: true };
    } else if (!exits_unify(out.ty, t)) {
      out = ExitFold { ...out, clash_with: out.clash_with.append(out.ty), clash: out.clash.append(t) };
    } else {
      if let typeinfo.TypeUnion(u) = out.ty {
        if let typeinfo.TypeUnion(v) = t {
          out = ExitFold { ...out, ty: join_enum_arguments(u, v) };
        }
      }
    }
  }
  return out;
}

pub function exit_result(body: ast.Stmt[], scope: Scope): typeinfo.Type {
  return fold_exits(lambda_exits(body, scope, LambdaExits { types: [], bare: false }).types).ty;
}

function lambda_exit_diags(lm: ast.ExprLambda, lsc: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let exits = lambda_exits(lm.body, lsc.with_ret_type(lambda_ret_type(lm, lsc)), LambdaExits { types: [], bare: false });
  let fold = fold_exits(exits.types);
  let i = 0;
  while (i < fold.clash.len()) {
    out = out.append(dg_at("E002", "cannot infer return type for \"\": conflicting return types " + type_label(fold.clash_with[i]) + " and " + type_label(fold.clash[i]) + "; add an explicit return type", lm.line, lm.col));
    i += 1;
  }
  if (fold.have && exits.bare) {
    out = out.append(dg_at("E012", "function \"\" returns a value on some paths but not others; add an explicit return type", lm.line, lm.col));
  }
  return out;
}

function lambda_exits(body: ast.Stmt[], scope: Scope, own acc: LambdaExits): LambdaExits {
  let cur = scope;
  for st in body {
    if (!is_defer_stmt(st)) {
      acc = lambda_try_exits(st, cur, acc);
    }
    match (st) {
      ast.StmtReturn(r) => {
        acc = lambda_return_exit(r, cur, acc);
      },
      ast.StmtIf(f) => {
        acc = lambda_exits(f.then_body, cur, acc);
        acc = lambda_exits(f.else_body, cur, acc);
      },
      ast.StmtWhile(w) => {
        acc = lambda_exits(w.body, cur, acc);
      },
      ast.StmtFor(fo) => {
        acc = lambda_exits(fo.body, for_body_scope(fo, cur), acc);
      },
      ast.StmtMatch(m) => {
        let whole = expr_type(m.scrutinee, cur);
        for a in m.arms {
          acc = lambda_exits(a.body, arm_scope(a, cur, whole), acc);
        }
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return acc;
}

function lambda_return_exit(r: ast.StmtReturn, cur: Scope, own acc: LambdaExits): LambdaExits {
  if (parser.bare_return(r.value)) {
    return LambdaExits { ...acc, bare: true };
  }
  if (int_literal_tree(r.value)) {
    return acc;
  }
  return LambdaExits { ...acc, types: acc.types.append(check_expr(r.value, cur)) };
}

function is_defer_stmt(st: ast.Stmt): boolean {
  if let ast.StmtDefer(_) = st {
    return true;
  }
  return false;
}

function lambda_try_exits(st: ast.Stmt, cur: Scope, own acc: LambdaExits): LambdaExits {
  for e in stmt_exprs(st) {
    acc = astwalk.fold_expr_pruned(
      e, acc, (x: ast.Expr, own a: LambdaExits): LambdaExits => {
        if let ast.ExprUnary(u) = x {
          if (u.op == "try_") {
            return LambdaExits { ...a, types: a.types.append(check_expr(u.operand, cur)) };
          }
        }
        return a;
      },
      e079_not_lambda,
    );
  }
  return acc;
}

function exit_type_known(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnion(u) => {
      for a in u.args {
        if (!unbound_enum_argument(a) && !exit_type_known(a)) {
          return false;
        }
      }
      return true;
    },
    typeinfo.TypeFloat(f) => {
      return !f.polymorphic;
    },
    typeinfo.TypeVoid(_) => {
      return false;
    },
    _ => {
      return !type_contains_unknown(t);
    }
  }
  return true;
}

function exits_unify(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(ua) = a {
    if let typeinfo.TypeUnion(ub) = b {
      return !is_unknown(join_enum_arguments(ua, ub));
    }
  }
  return type_eq(a, b);
}

function lambda_body_diags(lm: ast.ExprLambda, lsc: Scope, rt: typeinfo.Type, unions: UnionSig[]): util.Diag[] {
  if (lm.ret_type.len() > 0 && is_void(rt)) {
    return void_ret_diags(lm.body, lsc, unions);
  }
  if (lm.ret_type.len() > 0 || lm.origin == parser.ORIGIN_USE && !is_unknown(rt)) {
    return ret_diags(lm.body, lsc, rt, unions);
  }
  return lambda_exit_diags(lm, lsc);
}

function lret_lambda(lm: ast.ExprLambda, cur: Scope, unions: UnionSig[], self_name: string): util.Diag[] {
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(cur.resolve_param(param));
  }
  let rt = lambda_ret_type(lm, cur);
  let lsc = cur;
  if (self_name.len() > 0) {
    lsc = lsc.bind(self_name, t_func_own(pts, lambda_owns(lm), rt));
  }
  let bi = 0;
  while (bi < lm.params.len()) {
    lsc = lsc.bind(lm.params[bi].name, pts[bi]);
    bi += 1;
  }
  return util.append_diags(lambda_body_diags(lm, lsc, rt, unions), lret_stmts(lm.body, lsc, unions));
}

function lret_expr(e: ast.Expr, cur: Scope, unions: UnionSig[], self_name: string): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprLambda(lm) => {
      out = util.append_diags(out, lret_lambda(lm, cur, unions, self_name));
    },
    ast.ExprBinary(b) => {
      out = util.append_diags(lret_expr(b.left, cur, unions, ""), lret_expr(b.right, cur, unions, ""));
    },
    ast.ExprUnary(u) => {
      out = lret_expr(u.operand, cur, unions, "");
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprLambda(lm) => {
          let lsc = cur;
          for param in lm.params {
            lsc = lsc.bind(param.name, cur.resolve_param(param));
          }
          out = util.append_diags(out, lret_stmts(lm.body, lsc, unions));
        },
        _ => {
          out = util.append_diags(out, lret_expr(c.callee, cur, unions, ""));
        }
      }
      for arg in c.args {
        out = util.append_diags(out, lret_expr(arg, cur, unions, ""));
      }
    },
    ast.ExprArray(a) => {
      for element in a.elements {
        out = util.append_diags(out, lret_expr(element, cur, unions, ""));
      }
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, lret_expr(element, cur, unions, ""));
      }
    },
    ast.ExprIndex(ix) => {
      out = util.append_diags(lret_expr(ix.array, cur, unions, ""), lret_expr(ix.index, cur, unions, ""));
    },
    ast.ExprSlice(s2) => {
      out = util.append_diags(lret_expr(s2.array, cur, unions, ""), util.append_diags(lret_expr(s2.start, cur, unions, ""), lret_expr(s2.end, cur, unions, "")));
    },
    ast.ExprFieldAccess(fa) => {
      out = lret_expr(fa.obj, cur, unions, "");
    },
    ast.ExprStructLit(sl) => {
      for field_value in sl.field_values {
        out = util.append_diags(out, lret_expr(field_value, cur, unions, ""));
      }
      if (sl.has_base) {
        out = util.append_diags(out, lret_expr(sl.base, cur, unions, ""));
      }
    },
    _ => {}
  }
  return out;
}

// The unsafe boundary: an unsafe declaration states caller obligations, and only an
// unsafe block accepts them. A function value cannot carry the obligation, so an
// unsafe function never becomes a value. docs/SAFETY-CONTRACT.md has the contract.
struct UnsafeWalk { scope: Scope, inside: boolean, diags: util.Diag[] }

function module_declares_unsafe(mod: parser.Module): boolean {
  for fd in mod.funcs {
    if (fd.is_unsafe) {
      return true;
    }
  }
  for req in mod.trait_reqs {
    for m in util.append_all(util.append_all(req.req_sigs, req.default_sigs), req.assoc_sigs) {
      if (m.is_unsafe) {
        return true;
      }
    }
  }
  return false;
}

function unsafe_call_diag(name: string, line: i32, col: i32): util.Diag {
  return dg_at("E095", "unsafe function \"" + name + "\" is called outside an unsafe block", line, col);
}

function raw_call_diag(name: string, line: i32, col: i32): util.Diag {
  return dg_at("E095", "raw builtin \"" + name + "\" is called outside an unsafe block", line, col);
}

// The builtins only the standard library may name, each with the std
// function a program calls instead. internal/check/checker's
// StdlibOnlyBuiltins holds the same pairs.
function stdlib_only_wrapper(name: string): string {
  if (name == "random_i32") {
    return "rand.next_i32 from \"std/rand\"";
  }
  if (name == "random_bytes") {
    return "rand.bytes from \"std/rand\"";
  }
  return "";
}

// A program's use of a builtin reserved for the standard library. The
// runtime helpers below the stdlib check with the raw floor allowed.
function stdlib_only_note(acc: UnsafeWalk, name: string, line: i32, col: i32): UnsafeWalk {
  let wrapper = stdlib_only_wrapper(name);
  if (wrapper.len() == 0 || acc.scope.fn_stdlib || acc.scope.sigs.raw_allowed || acc.scope.defines(name)) {
    return acc;
  }
  return unsafe_note(acc, dg_at("E097", "builtin \"" + name + "\" is reserved for the standard library; call " + wrapper + " instead", line, col));
}

// The unsafe built-in methods. Each close_unchecked closes a handle through a
// borrow, and lowers as close. internal/check/checker's UnsafeBuiltinMethods
// holds the same set.
pub function unsafe_builtin_methods(): string[] {
  return ["__method_Reader_close_unchecked", "__method_Writer_close_unchecked", "__method_Dir_close_unchecked"];
}

function is_unsafe_builtin_method(key: string, field: string): boolean {
  return util.has_str(unsafe_builtin_methods(), "__method_" + key + "_" + field);
}

// The raw builtins that forge an address, change a count or a length, or call
// foreign code. docs/security/UNSAFE-INVENTORY.md lists each obligation, and
// internal/check/checker's UnsafeIntrinsics holds the same set.
pub function unsafe_intrinsics(): string[] {
  return [
    "__alloc", "__alloc_reuse", "__free",
    "__load_u8", "__load_i32", "__load_i64", "__load_ptr",
    "__store_u8", "__store_i32", "__store_i64", "__store_ptr",
    "__mmio_load8", "__mmio_load16", "__mmio_load32", "__mmio_load64",
    "__mmio_store8", "__mmio_store16", "__mmio_store32", "__mmio_store64", "__hvc", "__smc",
    "__port_in8", "__port_in16", "__port_in32", "__port_out8", "__port_out16", "__port_out32",
    "__memcpy", "__memset", "__str_bytes", "__account_entry",
    "__fern_rc_inc", "__fern_arr_dec", "__fern_box_free", "__fern_drop_arr_ptr", "__fern_str_dec",
    "__rc_inc", "__rc_dec", "__rc_get", "__fern_rc_dec",
    "__arr_set_len", "__heap_mark", "__heap_release_to", "__heap_adopt", "__send_adopt", "__send_root", "__send_release", "__worker_region", "__worker_exit", "__worker_reap", "__worker_unmap",
    "__c_call0", "__c_call0_f32", "__c_call0_f64",
    "__c_call1", "__c_call1_f32", "__c_call1_f64",
    "__c_call2", "__c_call2_f32", "__c_call2_f64",
    "__c_call3", "__c_call3_f32", "__c_call3_f64",
    "__c_call4", "__c_call4_f32", "__c_call4_f64",
    "__c_call5", "__c_call5_f32", "__c_call5_f64",
    "__c_call6", "__c_call6_f32", "__c_call6_f64",
    "__task_new", "__task_free", "__task_enter", "__task_leave",
    "__task_park", "__task_park_until", "__task_wait", "__task_set_ready", "__task_set_cancelled",
    "__task_cancelled", "__task_timeout", "__task_until", "__task_cur",
    "__syscall3", "__syscall4", "__syscall5", "__syscall6",
    "__fd_close", "__tcp_close_unchecked", "__socket_from_fd",
  ];
}

function is_unsafe_intrinsic(name: string): boolean {
  return util.has_str(unsafe_intrinsics(), name);
}

// A builtin a program names without calling it; a local or a declared
// function of the same name is the program's own value.
function builtin_value_named(name: string, s: Scope): boolean {
  return builtinsigs.builtin_row(name).len() > 0 && !s.defines(name) && !s.has_sig(name);
}

function unsafe_value_diag(name: string, line: i32, col: i32): util.Diag {
  return dg_at("E095", "unsafe function \"" + name + "\" cannot be used as a value; a function value carries no unsafe obligation", line, col);
}

function unsafe_impl_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for fd in mod.funcs {
    if (!fd.is_unsafe || fd.impl_trait.len() == 0) {
      continue;
    }
    let idx = trait_req_idx(fd.impl_trait, mod.trait_reqs);
    if (idx < 0) {
      continue;
    }
    let req = mod.trait_reqs[idx];
    for m in util.append_all(util.append_all(req.req_sigs, req.default_sigs), req.assoc_sigs) {
      if (m.name == fd.name && !m.is_unsafe) {
        out = out.append(dg_at("E095", "method \"" + fd.name + "\" of trait \"" + req.trait_name + "\" is declared safe, so its implementation cannot be unsafe", fd.line, fd.col));
      }
    }
  }
  return out;
}

function unsafe_sig_named(name: string, s: Scope): boolean {
  if (s.is_bound(name)) {
    return false;
  }
  if let Some(sig) = s.lookup_sig(name) {
    return sig.is_unsafe;
  }
  return false;
}

function qualified_sig_name(fa: ast.ExprFieldAccess, s: Scope): string {
  if let ast.ExprIdent(ns) = fa.obj {
    if (s.is_bound(ns.name)) {
      return "";
    }
    let qname = ns.name + "." + fa.field;
    if (s.has_sig(qname)) {
      return qname;
    }
  }
  return "";
}

function dyn_method_unsafe(traits: string, name: string, s: Scope): boolean {
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let idx = trait_req_idx(util.base_type_name(tr), s.trait_reqs);
    if (idx >= 0) {
      if let Some(m) = trait_req_sig(s.trait_reqs[idx], name) {
        return m.is_unsafe;
      }
    }
  }
  return false;
}

function unsafe_method_named(fa: ast.ExprFieldAccess, s: Scope): boolean {
  if let ast.ExprIdent(ns) = fa.obj {
    if (!s.is_bound(ns.name)) {
      if let Some(asig) = s.lookup_assoc_sig(ns.name, fa.field) {
        return asig.is_unsafe;
      }
    }
  }
  let recv = check_expr(fa.obj, s);
  let key = receiver_key(recv);
  if (key.len() > 0) {
    if (is_unsafe_builtin_method(key, fa.field)) {
      return true;
    }
    if let Some(m) = s.lookup_method(fa.field, key) {
      return m.is_unsafe;
    }
    return false;
  }
  if let typeinfo.TypeDyn(d) = recv {
    return dyn_method_unsafe(d.traits, fa.field, s);
  }
  if let Some(bm) = bound_method(s, tp_receiver(recv, s), fa.field) {
    return bm.is_unsafe;
  }
  return false;
}

function unsafe_note(acc: UnsafeWalk, d: util.Diag): UnsafeWalk {
  return UnsafeWalk { scope: acc.scope, inside: acc.inside, diags: acc.diags.append(d) };
}

function unsafe_descend(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(_) => {
      return false;
    },
    ast.ExprLambda(_) => {
      return false;
    },
    _ => {
      return true;
    }
  }
  return true;
}

function unsafe_call(c: ast.ExprCall, own acc: UnsafeWalk): UnsafeWalk {
  match (c.callee) {
    ast.ExprIdent(id) => {
      acc = stdlib_only_note(acc, id.name, id.line, id.col);
      if (!acc.inside && !acc.scope.defines(id.name) && is_unsafe_intrinsic(id.name)) {
        acc = unsafe_note(acc, raw_call_diag(id.name, c.line, c.col));
      } else if (!acc.inside && unsafe_sig_named(id.name, acc.scope)) {
        acc = unsafe_note(acc, unsafe_call_diag(id.name, c.line, c.col));
      }
    },
    ast.ExprFieldAccess(fa) => {
      let qname = qualified_sig_name(fa, acc.scope);
      if (qname.len() > 0) {
        if (!acc.inside && unsafe_sig_named(qname, acc.scope)) {
          acc = unsafe_note(acc, unsafe_call_diag(qname, c.line, c.col));
        }
      } else {
        if (!acc.inside && unsafe_method_named(fa, acc.scope)) {
          acc = unsafe_note(acc, unsafe_call_diag(fa.field, c.line, c.col));
        }
        acc = astwalk.fold_expr_pruned(fa.obj, acc, unsafe_visit, unsafe_descend);
      }
    },
    _ => {
      acc = astwalk.fold_expr_pruned(c.callee, acc, unsafe_visit, unsafe_descend);
    }
  }
  for arg in c.args {
    acc = astwalk.fold_expr_pruned(arg, acc, unsafe_visit, unsafe_descend);
  }
  return acc;
}

function unsafe_visit(e: ast.Expr, own acc: UnsafeWalk): UnsafeWalk {
  match (e) {
    ast.ExprCall(c) => {
      return unsafe_call(c, acc);
    },
    ast.ExprLambda(lm) => {
      let body = unsafe_stmts(lm.body, lambda_body_scope(lm, acc.scope), acc.inside);
      return UnsafeWalk { scope: acc.scope, inside: acc.inside, diags: util.append_diags(acc.diags, body) };
    },
    ast.ExprIdent(id) => {
      let reported = acc.diags.len();
      acc = stdlib_only_note(acc, id.name, id.line, id.col);
      if (acc.diags.len() == reported && builtin_value_named(id.name, acc.scope)) {
        return unsafe_note(acc, dg_at("E098", "builtin \"" + id.name + "\" can only be called, not used as a value", id.line, id.col));
      }
      if (unsafe_sig_named(id.name, acc.scope)) {
        return unsafe_note(acc, unsafe_value_diag(id.name, id.line, id.col));
      }
    },
    ast.ExprFieldAccess(fa) => {
      let qname = qualified_sig_name(fa, acc.scope);
      if (qname.len() > 0 && unsafe_sig_named(qname, acc.scope)) {
        return unsafe_note(acc, unsafe_value_diag(qname, fa.line, fa.col));
      }
    },
    _ => {}
  }
  return acc;
}

function unsafe_expr(e: ast.Expr, s: Scope, inside: boolean): util.Diag[] {
  let start = UnsafeWalk { scope: s, inside: inside, diags: [] };
  return astwalk.fold_expr_pruned(e, start, unsafe_visit, unsafe_descend).diags;
}

function unsafe_stmts(stmts: ast.Stmt[], s: Scope, inside: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  let cur = bind_mutual_siblings(stmts, s);
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, unsafe_expr(v.init, rec_local_scope(v, cur), inside));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, unsafe_expr(r.value, cur, inside));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, unsafe_expr(x.value, cur, inside));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, unsafe_expr(a.value, cur, inside));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, unsafe_expr(f.cond, cur, inside));
        out = util.append_diags(out, unsafe_stmts(f.then_body, cur, inside || f.origin == "unsafe"));
        out = util.append_diags(out, unsafe_stmts(f.else_body, cur, inside));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, unsafe_expr(w.cond, cur, inside));
        out = util.append_diags(out, unsafe_stmts(w.body, cur, inside));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, unsafe_expr(fr.iter, cur, inside));
        out = util.append_diags(out, unsafe_stmts(fr.body, for_body_scope(fr, cur), inside));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, unsafe_expr(m.scrutinee, cur, inside));
        let whole = check_expr(m.scrutinee, cur);
        for arm in m.arms {
          let asc = annotate_arm_scope(arm, cur, whole);
          if (arm.has_guard) {
            out = util.append_diags(out, unsafe_expr(arm.guard, asc, inside));
          }
          out = util.append_diags(out, unsafe_stmts(arm.body, asc, inside));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, unsafe_stmts(one, cur, inside));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function lret_stmts(stmts: ast.Stmt[], s: Scope, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, lret_expr(v.init, cur, unions, rec_local_name(v)));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, lret_expr(r.value, cur, unions, ""));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, lret_expr(x.value, cur, unions, ""));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, lret_expr(a.value, cur, unions, ""));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, lret_expr(f.cond, cur, unions, ""));
        out = util.append_diags(out, lret_stmts(f.then_body, cur, unions));
        out = util.append_diags(out, lret_stmts(f.else_body, cur, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, lret_expr(w.cond, cur, unions, ""));
        out = util.append_diags(out, lret_stmts(w.body, cur, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, lret_expr(fr.iter, cur, unions, ""));
        out = util.append_diags(out, lret_stmts(fr.body, for_body_scope(fr, cur), unions));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, lret_expr(m.scrutinee, cur, unions, ""));
        for arm in m.arms {
          out = util.append_diags(out, lret_stmts(arm.body, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, lret_stmts(one, cur, unions));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function arm_int_literal(e: ast.Expr): boolean {
  let no_locals: string[] = [];
  return unsettled_tree(e, no_locals);
}

function unsettled_tree(e: ast.Expr, lits: string[]): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return int_literal_tree(e) || parser.float_settled_int(n);
    },
    ast.ExprIdent(id) => {
      return util.has_str(lits, id.name);
    },
    ast.ExprUnary(u) => {
      return (u.op == "-" || u.op == "+") && unsettled_tree(u.operand, lits);
    },
    ast.ExprBinary(b) => {
      return parser.int_literal_op(b.op) && unsettled_tree(b.left, lits) && unsettled_tree(b.right, lits);
    },
    ast.ExprCall(c) => {
      return unsettled_value_block(c, [], 0, lits);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function unsettled_part(e: ast.Expr, path: i32[], at: i32, lits: string[]): boolean {
  if (at >= path.len()) {
    return unsettled_tree(e, lits);
  }
  if let ast.ExprTuple(t) = e {
    return path[at] < t.elements.len() && unsettled_part(t.elements[path[at]], path, at + 1, lits);
  }
  if let ast.ExprCall(c) = e {
    return unsettled_value_block(c, path, at, lits);
  }
  return false;
}

function unsettled_value_block(c: ast.ExprCall, path: i32[], at: i32, lits: string[]): boolean {
  if (c.args.len() > 0) {
    return false;
  }
  if let ast.ExprLambda(lm) = c.callee {
    let branches = lm.body.len() == 1 && (lm.origin == parser.ORIGIN_IF_EXPR || lm.origin == parser.ORIGIN_MATCH_EXPR);
    if (lm.params.len() > 0 || !branches && lm.origin != parser.ORIGIN_BLOCK) {
      return false;
    }
    return unsettled_arms(lm.body, path, at, lits) > 0;
  }
  return false;
}

function unsettled_arms(body: ast.Stmt[], path: i32[], at: i32, outer: string[]): i32 {
  if (!mx_branch_yields(body)) {
    return 0;
  }
  let lits = outer;
  let i = 0;
  while (i + 1 < body.len()) {
    lits = lit_locals_after(body[i], lits);
    i += 1;
  }
  match (body[i]) {
    ast.StmtReturn(r) => {
      if (unsettled_part(r.value, path, at, lits)) {
        return 1;
      }
      return -1;
    },
    ast.StmtIf(f) => {
      return unsettled_arm_sum(unsettled_arms(f.then_body, path, at, lits), unsettled_arms(f.else_body, path, at, lits));
    },
    ast.StmtMatch(m) => {
      let n = 0;
      for arm in m.arms {
        n = unsettled_arm_sum(n, unsettled_arms(arm.body, path, at, drop_lit_locals(lits, astwalk.pattern_binders(arm.pattern, []))));
      }
      return n;
    },
    _ => {}
  }
  return 0;
}

function unsettled_arm_sum(a: i32, b: i32): i32 {
  if (a < 0 || b < 0) {
    return -1;
  }
  return a + b;
}

function lit_locals_after(st: ast.Stmt, lits: string[]): string[] {
  if let ast.StmtVar(v) = st {
    let out = drop_lit_locals(lits, astwalk.binders_of(st, []));
    if (v.type_name.len() == 0 && !name_has_comma(v.name) && unsettled_tree(v.init, lits)) {
      return out.append(v.name);
    }
    return out;
  }
  return lits;
}

function drop_lit_locals(lits: string[], names: string[]): string[] {
  let out: string[] = [];
  for lit in lits {
    if (!util.has_str(names, lit)) {
      out = out.append(lit);
    }
  }
  return out;
}

function builtin_union_sig(name: string): Option[UnionSig] {
  if (name == "Option") {
    return Some(UnionSig { name: name, variants: ["Some", "None"], is_try: false, is_enum: true, module: "", type_params: ["T"], const_params: [], instance: "", visible_from: [], must_consume: false });
  }
  if (name == "Result") {
    return Some(UnionSig { name: name, variants: ["Ok", "Err"], is_try: false, is_enum: true, module: "", type_params: ["T", "E"], const_params: [], instance: "", visible_from: [], must_consume: false });
  }
  return None;
}

function mx_enum_of(name: string, enums: parser.EnumDecl[]): string {
  for ed in enums {
    if (util.has_str(ed.variant_names, name)) {
      return ed.name;
    }
  }
  return "";
}

function mx_same_enum_family(an: string, bn: string, enums: parser.EnumDecl[]): boolean {
  if (an == bn) {
    return true;
  }
  let ab = parser.builtin_enum_of(an);
  if (ab.len() > 0 && ab == parser.builtin_enum_of(bn)) {
    return true;
  }
  let au = mx_enum_of(an, enums);
  if (au.len() > 0 && au == mx_enum_of(bn, enums)) {
    return true;
  }
  return false;
}

function mx_arm_compatible(a: VbStore, b: VbStore, elem: boolean, assigns: boolean, unions: UnionSig[], enums: parser.EnumDecl[]): boolean {
  if (owned_beside_view(a.t, b.t)) {
    return false;
  }
  if (elem && !assigns && (arm_unsettled(a) || arm_unsettled(b))) {
    return mx_arm_compatible(mx_default_width(a), mx_default_width(b), elem, assigns, unions, enums);
  }
  if (mx_int_literal_settles(a, b.t, elem) || mx_int_literal_settles(b, a.t, elem)) {
    return true;
  }
  if (is_float(a.t) && is_float(b.t) && (!elem || assigns)) {
    return type_eq(a.t, b.t) || is_poly_float(a.t) || is_poly_float(b.t);
  }
  if let typeinfo.TypeUnion(ua) = a.t {
    if let typeinfo.TypeUnion(ub) = b.t {
      if (ua.name == ub.name) {
        return mx_args_compatible(ua, ub, elem, assigns, unions, enums);
      }
    }
  }
  if (type_eq(a.t, b.t) || type_assignable(a.t, b.t, unions) || type_assignable(b.t, a.t, unions)) {
    return true;
  }
  return mx_parts_compatible(a, b, elem, assigns, unions, enums);
}

function owned_beside_view(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(aa) = a {
    if let typeinfo.TypeArray(ba) = b {
      return aa.view != ba.view;
    }
  }
  if let typeinfo.TypeString(aa) = a {
    if let typeinfo.TypeString(ba) = b {
      return aa.tag != ba.tag;
    }
  }
  return false;
}

function mx_args_compatible(a: typeinfo.TypeUnion, b: typeinfo.TypeUnion, elem: boolean, assigns: boolean, unions: UnionSig[], enums: parser.EnumDecl[]): boolean {
  if (a.args.len() == 0 || b.args.len() == 0) {
    return true;
  }
  if (a.args.len() != b.args.len()) {
    return false;
  }
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let i = 0;
  while (i < a.args.len()) {
    let x = a.args[i];
    let y = b.args[i];
    if (!is_unknown(x) && !is_unknown(y) && !mx_arm_compatible(VbStore { t: x, e: none }, VbStore { t: y, e: none }, elem, assigns, unions, enums)) {
      return false;
    }
    i += 1;
  }
  return true;
}

function mx_parts_compatible(a: VbStore, b: VbStore, elem: boolean, assigns: boolean, unions: UnionSig[], enums: parser.EnumDecl[]): boolean {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  match (a.t) {
    typeinfo.TypeTuple(ta) => {
      match (b.t) {
        typeinfo.TypeTuple(tb) => {
          let n = ta.elements.len();
          if (tb.elements.len() != n) {
            return false;
          }
          let aes = vb_tuple_elems(a.e, n);
          let bes = vb_tuple_elems(b.e, n);
          let i = 0;
          while (i < n) {
            if (!mx_arm_compatible(VbStore { t: ta.elements[i], e: aes[i] }, VbStore { t: tb.elements[i], e: bes[i] }, elem, assigns, unions, enums)) {
              return false;
            }
            i += 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeArray(aa) => {
      match (b.t) {
        typeinfo.TypeArray(ba) => {
          return mx_arm_compatible(mx_elem_store(a.e, aa.elem), mx_elem_store(b.e, ba.elem), false, assigns, unions, enums);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeMap(ma) => {
      match (b.t) {
        typeinfo.TypeMap(mb) => {
          return mx_arm_compatible(VbStore { t: ma.key, e: none }, VbStore { t: mb.key, e: none }, true, assigns, unions, enums)
            && mx_arm_compatible(mx_map_value_store(a.e, ma.value), mx_map_value_store(b.e, mb.value), false, assigns, unions, enums);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeStruct(sa) => {
      match (b.t) {
        typeinfo.TypeStruct(sb) => {
          return mx_same_enum_family(sa.name, sb.name, enums);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

function mx_elem_store(e: ast.Expr, elem: typeinfo.Type): VbStore {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  if let ast.ExprArray(ea) = e {
    if (ea.elements.len() > 0 && mx_unsettled_elements(ea.elements)) {
      return VbStore { t: elem, e: ea.elements[0] };
    }
  }
  return VbStore { t: elem, e: none };
}

function mx_map_value_store(e: ast.Expr, value: typeinfo.Type): VbStore {
  let vs = mlit_values(e);
  if (vs.len() > 0 && mlit_is_desugared(e) && mx_unsettled_elements(vs)) {
    return VbStore { t: value, e: vs[0] };
  }
  return VbStore { t: value, e: ast.ExprUnknown { kind: "", line: 0, col: 0 } };
}

function mlit_values(e: ast.Expr): ast.Expr[] {
  if let ast.ExprCall(c) = e {
    if let ast.ExprFieldAccess(fa) = c.callee {
      if (fa.field == "insert" && c.args.len() == 2) {
        return mlit_values(fa.obj).append(c.args[1]);
      }
    }
  }
  let none: ast.Expr[] = [];
  return none;
}

function mx_unsettled_elements(es: ast.Expr[]): boolean {
  for x in es {
    if let ast.ExprArray(inner) = x {
      if (inner.elements.len() == 0 || !mx_unsettled_elements(inner.elements)) {
        return false;
      }
      continue;
    }
    if (!arm_int_literal(x)) {
      return false;
    }
  }
  return true;
}

function mx_default_width(a: VbStore): VbStore {
  if (arm_unsettled(a)) {
    return VbStore { t: t_i32(), e: ast.ExprUnknown { kind: "", line: 0, col: 0 } };
  }
  return a;
}

function mx_int_literal_settles(a: VbStore, t: typeinfo.Type, elem: boolean): boolean {
  return arm_unsettled(a) && (is_integer(t) || !elem && is_float(t));
}

function arm_unsettled(a: VbStore): boolean {
  return arm_int_literal(a.e) || is_poly_int(a.t);
}

function mx_arm_join(a: VbStore, b: VbStore): VbStore {
  if let typeinfo.TypeTuple(at) = a.t {
    if let typeinfo.TypeTuple(bt) = b.t {
      let n = at.elements.len();
      if (bt.elements.len() == n) {
        let aes = vb_tuple_elems(a.e, n);
        let bes = vb_tuple_elems(b.e, n);
        let elems: typeinfo.Type[] = [];
        let es: ast.Expr[] = [];
        let i = 0;
        while (i < n) {
          let j = mx_arm_join(VbStore { t: at.elements[i], e: aes[i] }, VbStore { t: bt.elements[i], e: bes[i] });
          elems = elems.append(j.t);
          es = es.append(j.e);
          i += 1;
        }
        return VbStore { t: t_tuple(elems), e: ast.ExprTuple { elements: es, line: 0, col: 0 } };
      }
    }
  }
  if let typeinfo.TypeArray(aa) = a.t {
    if let typeinfo.TypeArray(ba) = b.t {
      if (aa.view == ba.view) {
        let el = mx_arm_join(mx_elem_store(a.e, aa.elem), mx_elem_store(b.e, ba.elem));
        return VbStore { t: typeinfo.TypeArray { ...aa, elem: el.t }, e: mx_joined_literal(el, a.e) };
      }
    }
  }
  if let typeinfo.TypeMap(am) = a.t {
    if let typeinfo.TypeMap(bm) = b.t {
      if (bare_map(a.t)) {
        return b;
      }
      if (bare_map(b.t)) {
        return a;
      }
      let v = mx_arm_join(mx_map_value_store(a.e, am.value), mx_map_value_store(b.e, bm.value));
      return VbStore { t: t_map(am.key, v.t), e: mx_joined_literal(v, a.e) };
    }
  }
  if (arm_unsettled(b)) {
    return a;
  }
  if (arm_unsettled(a)) {
    return b;
  }
  let t = join_result_types(a.t, b.t);
  if (is_unknown(t)) {
    return a;
  }
  return VbStore { t: t, e: a.e };
}

function mx_joined_literal(el: VbStore, e: ast.Expr): ast.Expr {
  if (arm_unsettled(el)) {
    return e;
  }
  return ast.ExprUnknown { kind: "", line: 0, col: 0 };
}

struct MxFold { ok: boolean, acc: VbStore, bad: typeinfo.Type, bad_index: i32 }

function mx_fold_arms(types: typeinfo.Type[], exprs: ast.Expr[], unions: UnionSig[], enums: parser.EnumDecl[], if_form: boolean, assigns: boolean): MxFold {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let unjudged = MxFold { ok: true, acc: VbStore { t: t_unknown("value block arms unjudged"), e: none }, bad: t_unknown(""), bad_index: 0 };
  if (types.len() == 0 || types.len() != exprs.len()) {
    return unjudged;
  }
  for ty in types {
    if (is_unknown(ty)) {
      return unjudged;
    }
  }
  let acc = VbStore { t: types[0], e: exprs[0] };
  let j = 1;
  while (j < types.len()) {
    let arm = VbStore { t: types[j], e: exprs[j] };
    let scalar = scalar_numeric_join(acc.t, arm.t);
    if (!is_unknown(scalar) && scalar_arms_settled(acc, arm)) {
      acc = VbStore { t: scalar, e: none };
      j += 1;
      continue;
    }
    if (!mx_arm_compatible(acc, arm, false, assigns, unions, enums) || if_form && is_dyn_slot(acc.t) != is_dyn_slot(arm.t)) {
      return MxFold { ok: false, acc: acc, bad: arm.t, bad_index: j };
    }
    acc = mx_arm_join(acc, arm);
    j += 1;
  }
  return MxFold { ok: true, acc: acc, bad: acc.t, bad_index: 0 };
}

function vb_arms_fold(types: typeinfo.Type[], exprs: ast.Expr[], s: Scope): MxFold {
  let no_enums: parser.EnumDecl[] = [];
  return mx_fold_arms(types, exprs, s.unions.unions, no_enums, false, true);
}

function mx_e031(types: typeinfo.Type[], exprs: ast.Expr[], unions: UnionSig[], enums: parser.EnumDecl[], if_form: boolean, assigns: boolean, line: i32, col: i32): util.Diag[] {
  let f = mx_fold_arms(types, exprs, unions, enums, if_form, assigns);
  return mx_fold_diags(f, line, col, if_form);
}

// mx_widen_to gives each arm that is a member of the expected union alias the alias's type.
function mx_widen_to(types: typeinfo.Type[], want: typeinfo.Type, s: Scope): typeinfo.Type[] {
  if let typeinfo.TypeUnion(un) = want {
    if (parser.is_reserved_enum_name(un.name)) {
      return types;
    }
    if let Some(owner) = s.lookup_union(un.name) {
      if (owner.is_enum) {
        return types;
      }
    }
    let out: typeinfo.Type[] = [];
    for ty in types {
      if (!is_unknown(ty) && type_assignable(ty, want, s.unions.unions)) {
        out = out.append(want);
      } else {
        out = out.append(ty);
      }
    }
    return out;
  }
  return types;
}

function mx_fold_diags(f: MxFold, line: i32, col: i32, if_form: boolean): util.Diag[] {
  let kind: string = if (if_form) { "if-expression branches differ: " } else { "match-expression arms differ: " };
  return mx_named_fold_diags(f, line, col, kind);
}

function mx_named_fold_diags(f: MxFold, line: i32, col: i32, kind: string): util.Diag[] {
  if (!f.ok) {
    return [dg_at("E031", kind + type_label(f.acc.t) + " vs " + type_label(f.bad), line, col)];
  }
  return [];
}

function mx_if_diags(f: ast.StmtIf, types: typeinfo.Type[], exprs: ast.Expr[], unions: UnionSig[], enums: parser.EnumDecl[], origin: string, origin_line: i32, origin_col: i32): util.Diag[] {
  let fold = mx_fold_arms(types, exprs, unions, enums, origin == parser.ORIGIN_IF_EXPR, origin == parser.ORIGIN_MATCH_EXPR);
  let kind = "if-expression branches differ: ";
  if (origin == parser.ORIGIN_MATCH_EXPR) {
    kind = "match arms have incompatible types: ";
  }
  let line = expr_line(f.cond);
  let col = expr_col(f.cond);
  if (origin == parser.ORIGIN_IF_EXPR) {
    line = origin_line;
    col = origin_col;
  }
  if (!fold.ok && f.sugar.lits.len() > 0) {
    let at = 0;
    for arm in f.sugar.lits {
      if (!arm.alt_cont && mx_branch_yields(arm.body)) {
        if (at == fold.bad_index) {
          return mx_named_fold_diags(fold, arm.line, arm.col, kind);
        }
        at += 1;
      }
    }
    line = f.sugar.line;
    col = f.sugar.col;
  }
  return mx_named_fold_diags(fold, line, col, kind);
}

function mx_branch_yields(body: ast.Stmt[]): boolean {
  if (body.len() == 0) {
    return false;
  }
  let leading: ast.Stmt[] = [];
  let li = 0;
  while (li + 1 < body.len()) {
    leading = leading.append(body[li]);
    li += 1;
  }
  return leading.len() == 0 || !parser.branch_stmts_diverge(leading);
}

function mx_arm_result_type(e: ast.Expr, s: Scope): typeinfo.Type {
  let t = check_expr(e, s);
  let (block, is_block) = value_block_body(e);
  if (is_unknown(t) && is_block) {
    return block_tail_arm_type(block, s);
  }
  if (is_integer(t) && gcall_open(e, s)) {
    if let typeinfo.TypeI32(n) = t {
      return typeinfo.TypeI32 { ...n, polymorphic: true };
    }
  }
  return unsettled_marked(t, e, s.lit_locals, false);
}

function unsettled_marked(t: typeinfo.Type, e: ast.Expr, lits: string[], literals: boolean): typeinfo.Type {
  return unsettled_marked_at(t, e, [], lits, literals);
}

function unsettled_marked_at(t: typeinfo.Type, e: ast.Expr, path: i32[], lits: string[], literals: boolean): typeinfo.Type {
  if let typeinfo.TypeTuple(tt) = t {
    let elems: typeinfo.Type[] = [];
    let k = 0;
    while (k < tt.elements.len()) {
      elems = elems.append(unsettled_marked_at(tt.elements[k], e, path.append(k), lits, literals));
      k += 1;
    }
    return t_tuple(elems);
  }
  if let typeinfo.TypeI32(i) = t {
    if (!i.is_char && (literals || path.len() > 0 || !arm_int_literal(e)) && unsettled_part(e, path, 0, lits)) {
      return typeinfo.TypeI32 { ...i, polymorphic: true };
    }
  }
  if let typeinfo.TypeArray(a) = t {
    return unsettled_array_marked(a, e, path, lits);
  }
  return t;
}

function unsettled_array_marked(a: typeinfo.TypeArray, e: ast.Expr, path: i32[], lits: string[]): typeinfo.Type {
  if let typeinfo.TypeI32(ei) = a.elem {
    if (!a.view && !ei.is_char && unsettled_array_part(e, path, 0, lits)) {
      return typeinfo.TypeArray { ...a, elem: typeinfo.TypeI32 { ...ei, polymorphic: true } };
    }
  }
  return a;
}

function unsettled_array_part(e: ast.Expr, path: i32[], at: i32, lits: string[]): boolean {
  if (at < path.len()) {
    if let ast.ExprTuple(t) = e {
      return path[at] < t.elements.len() && unsettled_array_part(t.elements[path[at]], path, at + 1, lits);
    }
    return false;
  }
  if let ast.ExprArray(al) = e {
    if (al.elem_ty.len() > 0 || al.elements.len() == 0) {
      return false;
    }
    for el in al.elements {
      if (!unsettled_tree(el, lits)) {
        return false;
      }
    }
    return true;
  }
  return false;
}

function value_block_body(e: ast.Expr): (ast.Stmt[], boolean) {
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lm) = c.callee {
      if (c.args.len() == 0 && lm.params.len() == 0 && lm.origin == parser.ORIGIN_BLOCK) {
        return (lm.body, true);
      }
    }
  }
  let none: ast.Stmt[] = [];
  return (none, false);
}

function block_tail_arm_type(body: ast.Stmt[], s: Scope): typeinfo.Type {
  if (body.len() == 0) {
    return t_unknown("empty value block");
  }
  if let ast.StmtReturn(r) = body[body.len() - 1] {
    if (parser.bare_return(r.value)) {
      return t_unknown("value block tail");
    }
    let bs = s;
    let i = 0;
    while (i < body.len() - 1) {
      bs = bind_stmt(body[i], bs);
      i += 1;
    }
    return mx_arm_result_type(r.value, bs);
  }
  return t_unknown("value block tail");
}

function mx_body_result_types(body: ast.Stmt[], s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  if (!mx_branch_yields(body)) {
    return out;
  }
  let cur = s;
  let i = 0;
  while (i + 1 < body.len()) {
    cur = bind_stmt(body[i], cur);
    i += 1;
  }
  match (body[i]) {
    ast.StmtReturn(r) => {
      return out.append(mx_arm_result_type(r.value, cur));
    },
    ast.StmtIf(f) => {
      return mx_if_branch_types(f, cur);
    },
    ast.StmtMatch(m) => {
      return mx_match_arm_types(m, cur);
    },
    _ => {
      return out;
    }
  }
  return out;
}

function mx_body_result_exprs(body: ast.Stmt[]): ast.Expr[] {
  let out: ast.Expr[] = [];
  if (!mx_branch_yields(body)) {
    return out;
  }
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      return out.append(r.value);
    },
    ast.StmtIf(f) => {
      out = mx_body_result_exprs(f.then_body);
      for e in mx_body_result_exprs(f.else_body) {
        out = out.append(e);
      }
      return out;
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        for e in mx_body_result_exprs(arm.body) {
          out = out.append(e);
        }
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

function mx_match_arm_types(m: ast.StmtMatch, s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for arm in m.arms {
    let armScope = annotate_arm_scope(arm, s, check_expr(m.scrutinee, s));
    for ty in mx_body_result_types(arm.body, armScope) {
      out = out.append(ty);
    }
  }
  return out;
}

function mx_if_branch_types(f: ast.StmtIf, s: Scope): typeinfo.Type[] {
  let out = mx_body_result_types(f.then_body, s);
  for ty in mx_body_result_types(f.else_body, s) {
    out = out.append(ty);
  }
  return out;
}

function mx_call(c: ast.ExprCall, want: typeinfo.Type, s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  if let ast.ExprLambda(lm) = c.callee {
    if (parser.is_value_block(c) && !is_unknown(want)) {
      out = mx_iife_arms(c, lm, want, s, unions, enums);
      return util.append_diags(out, mx_stmts(lm.body, lambda_body_scope(lm, s).with_block_ret(want), unions, enums));
    }
    if (c.args.len() == 0) {
      out = mx_iife_arms(c, lm, t_unknown("no expected type"), s, unions, enums);
    }
  }
  out = util.append_diags(out, mx_expr(c.callee, s, unions, enums));
  let pts: typeinfo.Type[] = [];
  if (any_value_block(c.args)) {
    pts = s.call_param_types(c);
  }
  let k = 0;
  while (k < c.args.len()) {
    out = util.append_diags(out, mx_expr_at(c.args[k], dest_slot(pts, k), s, unions, enums));
    k += 1;
  }
  return out;
}

function any_value_block(es: ast.Expr[]): boolean {
  for e in es {
    if let ast.ExprCall(c) = e {
      if (parser.is_value_block(c)) {
        return true;
      }
    }
  }
  return false;
}

// mx_iife_arms checks that the arms of an immediately called lambda agree,
// after each arm that is a member of the expected union widens to it.
function mx_iife_arms(c: ast.ExprCall, lm: ast.ExprLambda, want: typeinfo.Type, s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  let local = vb_local_name(lm.body);
  if (lm.params.len() == 0 && parser.is_value_local_name(local)) {
    out = mx_value_local_arms(lm.body, local, want, s, unions, enums);
  }
  if (lm.params.len() == 0 && lm.body.len() == 1) {
    let arms = mx_body_result_exprs(lm.body);
    match (lm.body[0]) {
      ast.StmtMatch(m) => {
        let mts = mx_match_arm_types(m, s);
        let enum_match = false;
        if let typeinfo.TypeUnion(_) = check_expr(m.scrutinee, s) {
          enum_match = true;
        }
        out = util.append_diags(out, mx_e031(mx_widen_to(mts, want, s), arms, unions, enums, false, !enum_match, expr_line(m.scrutinee), expr_col(m.scrutinee)));
        out = util.append_diags(out, vb_pinned_ranges(mts, arms));
      },
      ast.StmtIf(f) => {
        let fts = mx_if_branch_types(f, s);
        out = util.append_diags(out, mx_if_diags(f, mx_widen_to(fts, want, s), arms, unions, enums, lm.origin, c.line, c.col));
        out = util.append_diags(out, vb_pinned_ranges(fts, arms));
      },
      _ => {}
    }
  }
  return out;
}

// mx_value_local_arms checks that the values each arm stores into the value local agree.
function mx_value_local_arms(body: ast.Stmt[], local: string, want: typeinfo.Type, s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): util.Diag[] {
  let types: typeinfo.Type[] = [];
  let exprs: ast.Expr[] = [];
  for store in vb_value_stores(body, local, s) {
    types = types.append(store.t);
    exprs = exprs.append(store.e);
  }
  let fold = mx_fold_arms(mx_widen_to(types, want, s), exprs, unions, enums, false, true);
  if (fold.ok) {
    return [];
  }
  let bad = exprs[fold.bad_index];
  return mx_named_fold_diags(fold, expr_line(bad), expr_col(bad), mx_value_local_kind(local));
}

// mx_value_local_kind gives the E031 wording the Go checker uses for the match form that owns local.
function mx_value_local_kind(local: string): string {
  if (local.starts_with("__tm") || local.starts_with("__sm")) {
    return "match arms have incompatible types: ";
  }
  return "match-expression arms differ: ";
}

function mx_expr(e: ast.Expr, s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): util.Diag[] {
  return mx_expr_at(e, t_unknown("no expected type"), s, unions, enums);
}

// mx_expr_at checks e where a value of type want is expected.
function mx_expr_at(e: ast.Expr, want: typeinfo.Type, s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      out = mx_call(c, want, s, unions, enums);
    },
    ast.ExprLambda(lm) => {
      out = mx_stmts(lm.body, lambda_body_scope(lm, s), unions, enums);
    },
    ast.ExprBinary(b) => {
      out = util.append_diags(mx_expr(b.left, s, unions, enums), mx_expr(b.right, s, unions, enums));
    },
    ast.ExprUnary(u) => {
      out = mx_expr(u.operand, s, unions, enums);
    },
    ast.ExprArray(a) => {
      for element in a.elements {
        out = util.append_diags(out, mx_expr(element, s, unions, enums));
      }
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, mx_expr(element, s, unions, enums));
      }
    },
    ast.ExprIndex(ix) => {
      out = util.append_diags(mx_expr(ix.array, s, unions, enums), mx_expr(ix.index, s, unions, enums));
    },
    ast.ExprSlice(s2) => {
      out = util.append_diags(mx_expr(s2.array, s, unions, enums), util.append_diags(mx_expr(s2.start, s, unions, enums), mx_expr(s2.end, s, unions, enums)));
    },
    ast.ExprFieldAccess(fa) => {
      out = mx_expr(fa.obj, s, unions, enums);
    },
    ast.ExprStructLit(sl) => {
      for field_value in sl.field_values {
        out = util.append_diags(out, mx_expr(field_value, s, unions, enums));
      }
      if (sl.has_base) {
        out = util.append_diags(out, mx_expr(sl.base, s, unions, enums));
      }
    },
    ast.ExprUnknown(u) => {
      if (util.is_f64_range_kind(u.kind)) {
        out = out.append(dg_at("P002", util.f64_range_message(u.kind), u.line, u.col));
      }
    },
    _ => {}
  }
  return out;
}

function mx_stmts(stmts: ast.Stmt[], s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, mx_expr_at(v.init, var_dest_type(v, cur), cur, unions, enums));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, mx_expr_at(r.value, cur.ret_type, cur, unions, enums));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, mx_expr(x.value, cur, unions, enums));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, mx_expr_at(a.value, assign_dest_type(a, cur), cur, unions, enums));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, mx_expr(f.cond, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(f.then_body, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(f.else_body, cur, unions, enums));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, mx_expr(w.cond, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(w.body, cur, unions, enums));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, mx_expr(fr.iter, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(fr.body, for_body_scope(fr, cur), unions, enums));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, mx_expr(m.scrutinee, cur, unions, enums));
        for arm in m.arms {
          let armScope = cur;
          match (arm.pattern) {
            ast.PatVariant(pv) => {
              armScope = bind_variant_payloads(armScope, cur, pv, check_expr(m.scrutinee, cur));
            },
            _ => {}
          }
          out = util.append_diags(out, mx_stmts(arm.body, armScope, unions, enums));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, mx_stmts(one, cur, unions, enums));
      },
      ast.StmtUnknown(u) => {
        if (u.kind == "value branch has no trailing expression") {
          out = out.append(dg_at("E061", parser.BLOCK_VALUE_REQUIRED_MESSAGE, u.line, u.col));
        }
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function find_struct_sig(structs: StructTable, name: string): Option[StructSig] {
  let first: i32 = -1;
  let k = structs.index.chain(name);
  while (k >= 0) {
    if (structs.structs[k].name == name) {
      if (structs.structs[k].enum_owner.len() == 0) {
        return Some(structs.structs[k]);
      }
      if (first < 0) {
        first = k;
      }
    }
    k = structs.index.next[k];
  }
  if (first >= 0) {
    return Some(structs.structs[first]);
  }
  return None;
}

function find_variant_sig(structs: StructTable, name: string): Option[StructSig] {
  let bare = variant_pattern_name(name);
  let owner = variant_pattern_owner(name);
  if (owner.len() > 0) {
    let k = structs.index.chain(bare);
    while (k >= 0) {
      if (structs.structs[k].name == bare && structs.structs[k].enum_owner == owner) {
        return Some(structs.structs[k]);
      }
      k = structs.index.next[k];
    }
    // Option.Some, Result.Ok and Result.Err are the builtin's even when a user enum declares the same name.
    if (parser.builtin_enum_of(bare) == owner) {
      return None;
    }
  }
  let k2 = structs.index.chain(bare);
  while (k2 >= 0) {
    if (structs.structs[k2].name == bare && structs.structs[k2].enum_owner.len() > 0) {
      return Some(structs.structs[k2]);
    }
    k2 = structs.index.next[k2];
  }
  return find_struct_sig(structs, bare);
}

function slit_names_no_struct(structs: StructTable, type_name: string): boolean {
  let base = util.base_type_name(type_name);
  if let Some(_) = find_struct_sig(structs, base) {
    return false;
  }
  return !parser.is_reserved_struct_name(base);
}

function slit_diags(e: ast.Expr, structs: StructTable): util.Diag[] {
  function visit(node: ast.Expr, own out: util.Diag[]): util.Diag[] {
    match (node) {
      ast.ExprStructLit(sl) => {
        return util.append_diags(out, slit_literal_diags(sl, structs));
      },
      ast.ExprLambda(lm) => {
        return util.append_diags(out, stmts_slit_diags(lm.body, structs));
      },
      _ => {
        return out;
      }
    }
    return out;
  }
  return astwalk.fold_expr_pruned(e, no_diags(), visit, slit_descend);
}

function slit_descend(e: ast.Expr): boolean {
  match (e) {
    ast.ExprStructLit(_) => {
      return false;
    },
    ast.ExprLambda(_) => {
      return false;
    },
    _ => {
      return true;
    }
  }
  return true;
}

// A built-in handle comes from the call that opens it. A struct the
// program declares with the same name is its own type.
function slit_forges_handle(sl: ast.ExprStructLit, structs: StructTable): boolean {
  if let Some(_) = find_struct_sig(structs, sl.type_name) {
    return false;
  }
  return util.has_str(semtypes.fd_handle_names(), sl.type_name);
}

function slit_literal_diags(sl: ast.ExprStructLit, structs: StructTable): util.Diag[] {
  let out: util.Diag[] = [];
  for field_value in sl.field_values {
    out = util.append_diags(out, slit_diags(field_value, structs));
  }
  if (lit_names_no_struct(sl.type_name, structs)) {
    out = out.append(dg_at("E043", "cannot find struct \"" + util.demangle(sl.type_name) + "\" in this scope", sl.line, sl.col));
  }
  if (slit_forges_handle(sl, structs)) {
    out = out.append(dg_at("E099", "a " + sl.type_name + " cannot be built from a literal: only the call that opens it makes one", sl.line, sl.col));
  }
  if let Some(usig) = find_struct_sig(structs, sl.type_name) {
    let fi = 0;
    while (fi < sl.field_names.len()) {
      if (!util.has_str(usig.field_names, sl.field_names[fi])) {
        let d = dg_at("E043", "struct " + util.demangle(sl.type_name) + " has no field \"" + sl.field_names[fi] + "\"", sl.line, sl.col);
        out = out.append(literal_field_fix(d, sl, fi, usig.field_names));
      }
      fi += 1;
    }
  } else if (slit_names_no_struct(structs, sl.type_name)) {
    out = out.append(dg_at("E043", "cannot find struct \"" + util.demangle(sl.type_name) + "\" in this scope", sl.line, sl.col));
  }
  if (sl.has_base) {
    out = util.append_diags(out, slit_diags(sl.base, structs));
  } else {
    if let Some(ssig) = find_struct_sig(structs, sl.type_name) {
      for field_name in ssig.field_names {
        if (!util.has_str(sl.field_names, field_name)) {
          out = out.append(dg_at("E005", "missing field \"" + field_name + "\" in this " + util.demangle(sl.type_name) + " literal", sl.line, sl.col));
        }
      }
    }
  }
  return out;
}

function lit_names_no_struct(name: string, structs: StructTable): boolean {
  if (name == "Self" || parser.is_reserved_struct_name(name) || !plain_ident(name)) {
    return false;
  }
  return match (find_variant_sig(structs, name)) { Some(_) => false, None => true };
}

function stmts_slit_diags(stmts: ast.Stmt[], structs: StructTable): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, slit_diags(v.init, structs));
        out = util.append_diags(out, destructure_covers_diags(v, structs));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, slit_diags(r.value, structs));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, slit_diags(x.value, structs));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, slit_diags(a.value, structs));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, slit_diags(f.cond, structs));
        out = util.append_diags(out, struct_arms_cover_diags(f.sugar.strct, structs));
        out = util.append_diags(out, stmts_slit_diags(f.then_body, structs));
        out = util.append_diags(out, stmts_slit_diags(f.else_body, structs));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, slit_diags(w.cond, structs));
        out = util.append_diags(out, stmts_slit_diags(w.body, structs));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, slit_diags(fr.iter, structs));
        out = util.append_diags(out, stmts_slit_diags(fr.body, structs));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, slit_diags(m.scrutinee, structs));
        for arm in m.arms {
          if (arm.has_guard) {
            out = util.append_diags(out, slit_diags(arm.guard, structs));
          }
          out = util.append_diags(out, stmts_slit_diags(arm.body, structs));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, stmts_slit_diags(one, structs));
      },
      _ => {}
    }
  }
  return out;
}

function sugar_arm_bodies(sugar: ast.MatchSugar): ast.Stmt[][] {
  let out: ast.Stmt[][] = [];
  for arm in sugar.tup {
    out = out.append(arm.body);
  }
  for arm in sugar.strct {
    out = out.append(arm.body);
  }
  for arm in sugar.lits {
    out = out.append(arm.body);
  }
  for arm in sugar.arms {
    out = out.append(arm.body);
  }
  return out;
}

// exit_bound: a local named `exit` is in scope, so a call to `exit` is not the builtin.
function block_exits(stmts: ast.Stmt[], exit_bound: boolean): boolean {
  return block_leaves(stmts, false, exit_bound, util.name_index([]));
}

function block_diverges(stmts: ast.Stmt[], exit_bound: boolean): boolean {
  return block_leaves(stmts, true, exit_bound, util.name_index([]));
}

// ow_block_diverges is block_diverges where a call to a function noret names
// also leaves.
function ow_block_diverges(stmts: ast.Stmt[], exit_bound: boolean, noret: util.NameIndex): boolean {
  return block_leaves(stmts, true, exit_bound, noret);
}

function block_leaves(stmts: ast.Stmt[], jumps: boolean, exit_bound: boolean, noret: util.NameIndex): boolean {
  if (stmts.len() == 0) {
    return false;
  }
  let last = stmts[stmts.len() - 1];
  let bound = exit_bound || lets_bind_exit(stmts);
  match (last) {
    ast.StmtExpr(x) => {
      return parser.calls_exit(x.value, bound) || lu_call_never_returns(x.value, noret, true);
    },
    ast.StmtBreak(_) => {
      return jumps;
    },
    ast.StmtContinue(_) => {
      return jumps;
    },
    ast.StmtReturn(_) => {
      return true;
    },
    ast.StmtIf(f) => {
      return if_leaves(f, jumps, bound, noret);
    },
    ast.StmtWhile(w) => {
      match (w.cond) {
        ast.ExprBool(b) => {
          return b.value && !loop_can_break(w.body, w.label, false);
        },
        _ => {
          return false;
        }
      }
    },
    ast.StmtMatch(m) => {
      return match_leaves(m, jumps, bound, noret);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function if_leaves(f: ast.StmtIf, jumps: boolean, bound: boolean, noret: util.NameIndex): boolean {
  let bodies = sugar_arm_bodies(f.sugar);
  if (bodies.len() > 0) {
    return sugar_leaves(f.sugar, bodies, jumps, bound || util.has_str(sugar_binders(f.sugar), "exit"), noret);
  }
  match (f.cond) {
    ast.ExprBool(b) => {
      if (b.value) {
        return block_leaves(f.then_body, jumps, bound, noret);
      }
      return block_leaves(f.else_body, jumps, bound, noret);
    },
    _ => {}
  }
  return block_leaves(f.then_body, jumps, bound, noret) && block_leaves(f.else_body, jumps, bound, noret);
}

function sugar_leaves(sugar: ast.MatchSugar, bodies: ast.Stmt[][], jumps: boolean, bound: boolean, noret: util.NameIndex): boolean {
  if (sugar.origin == "let_else") {
    return block_leaves(bodies[0], jumps, bound, noret);
  }
  for body in bodies {
    if (!block_leaves(body, jumps, bound, noret)) {
      return false;
    }
  }
  return true;
}

function match_leaves(m: ast.StmtMatch, jumps: boolean, bound: boolean, noret: util.NameIndex): boolean {
  if (m.arms.len() == 0) {
    return false;
  }
  if (m.origin == "let_else") {
    return block_leaves(m.arms[0].body, jumps, bound || pattern_binds_exit(m.arms[0].pattern), noret);
  }
  for arm in m.arms {
    if (!block_leaves(arm.body, jumps, bound || pattern_binds_exit(arm.pattern), noret)) {
      return false;
    }
  }
  return true;
}

function lets_bind_exit(stmts: ast.Stmt[]): boolean {
  for st in stmts {
    if let ast.StmtVar(v) = st {
      if (util.has_str(astwalk.append_bound_name([], v.name), "exit")) {
        return true;
      }
    }
  }
  return false;
}

function pattern_binds_exit(p: ast.Pattern): boolean {
  return util.has_str(astwalk.pattern_binders(p, []), "exit");
}

function sugar_binders(sugar: ast.MatchSugar): string[] {
  let out: string[] = [];
  for arm in sugar.tup {
    for b in arm.binds {
      out = out.append(b);
    }
    out = out.append(arm.at_binding);
    for p in arm.elem_pats {
      out = astwalk.pattern_binders(p, out);
    }
  }
  for arm in sugar.strct {
    for b in arm.binds {
      out = out.append(b);
    }
    out = out.append(arm.at_binding);
    for p in arm.field_pats {
      out = astwalk.pattern_binders(p, out);
    }
  }
  for arm in sugar.lits {
    out = out.append(arm.at_binding);
  }
  for arm in sugar.arms {
    out = astwalk.pattern_binders(arm.pattern, out);
  }
  return out;
}

function loop_can_break(stmts: ast.Stmt[], label: string, nested: boolean): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtBreak(bk) => {
        if (bk.label.len() == 0) {
          if (!nested) {
            return true;
          }
        } else if (bk.label == label) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (expr_can_break(w.cond, label, nested) || loop_can_break(w.body, label, true)) {
          return true;
        }
      },
      ast.StmtFor(fr) => {
        if (expr_can_break(fr.iter, label, nested) || loop_can_break(fr.body, label, true)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (expr_can_break(f.cond, label, nested) || loop_can_break(f.then_body, label, nested) || loop_can_break(f.else_body, label, nested)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        if (expr_can_break(m.scrutinee, label, nested)) {
          return true;
        }
        for arm in m.arms {
          if (arm.has_guard && expr_can_break(arm.guard, label, nested) || loop_can_break(arm.body, label, nested)) {
            return true;
          }
        }
      },
      ast.StmtDefer(_) => {},
      _ => {
        if (astwalk.fold_stmt_pruned(
          stmt, false, (e: ast.Expr, own a: boolean): boolean => a || value_block_can_break(e, label, nested),
          not_a_scope_root,
        )) {
          return true;
        }
      }
    }
  }
  return false;
}

function expr_can_break(e: ast.Expr, label: string, nested: boolean): boolean {
  return astwalk.fold_expr_pruned(
    e, false, (x: ast.Expr, own a: boolean): boolean => a || value_block_can_break(x, label, nested),
    not_a_scope_root,
  );
}

function value_block_can_break(e: ast.Expr, label: string, nested: boolean): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (parser.is_value_block(c)) {
        return loop_can_break(parser.vb_body(c), label, nested);
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function label_in_scope(labels: string[], name: string): boolean {
  for label in labels {
    if (label == name) {
      return true;
    }
  }
  return false;
}

function loop_diags_in_exprs(st: ast.Stmt, in_loop: boolean, labels: string[]): util.Diag[] {
  return astwalk.fold_stmt_pruned(
    st, no_diags(), (e: ast.Expr, own a: util.Diag[]): util.Diag[] => {
      match (e) {
        ast.ExprCall(c) => {
          if (parser.is_value_block(c)) {
            return util.append_diags(a, loop_diags(parser.vb_body(c), in_loop, labels));
          }
          return a;
        },
        ast.ExprLambda(lm) => {
          let nolabels: string[] = [];
          return util.append_diags(a, loop_diags(lm.body, false, nolabels));
        },
        _ => {
          return a;
        }
      }
      return a;
    },
    not_a_scope_root,
  );
}

function not_a_scope_root(e: ast.Expr): boolean {
  match (e) {
    ast.ExprLambda(_) => {
      return false;
    },
    ast.ExprCall(c) => {
      return !parser.is_value_block(c);
    },
    _ => {
      return true;
    }
  }
  return true;
}

function loop_diags(stmts: ast.Stmt[], in_loop: boolean, labels: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtBreak(bk) => {
        if (!in_loop) {
          out = out.append(dg_at("E011", "break outside of a loop", bk.line, bk.col));
        } else if (bk.label.len() > 0 && !label_in_scope(labels, bk.label)) {
          out = out.append(dg_at("E058", "break label \"" + bk.label + "\" does not match any enclosing loop", bk.line, bk.col));
        }
      },
      ast.StmtContinue(ck) => {
        if (!in_loop) {
          out = out.append(dg_at("E011", "continue outside of a loop", ck.line, ck.col));
        } else if (ck.label.len() > 0 && !label_in_scope(labels, ck.label)) {
          out = out.append(dg_at("E058", "continue label \"" + ck.label + "\" does not match any enclosing loop", ck.line, ck.col));
        }
      },
      ast.StmtWhile(w) => {
        let wl = labels;
        if (w.label.len() > 0) {
          wl = labels.append(w.label);
        }
        out = util.append_diags(out, loop_diags(w.body, true, wl));
      },
      ast.StmtFor(fr) => {
        let fl = labels;
        if (fr.label.len() > 0) {
          fl = labels.append(fr.label);
        }
        out = util.append_diags(out, loop_diags(fr.body, true, fl));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, loop_diags(f.then_body, in_loop, labels));
        out = util.append_diags(out, loop_diags(f.else_body, in_loop, labels));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, loop_diags(arm.body, in_loop, labels));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, loop_diags(one, in_loop, labels));
      },
      _ => {
        out = util.append_diags(out, loop_diags_in_exprs(stmt, in_loop, labels));
      }
    }
  }
  return out;
}

pub function count_type_args(t: string): i32 {
  let r = parser.parse_type_ref(t);
  if (r.is_tuple || r.is_view || r.array_depth > 0 || r.args.len() == 0) {
    return -1;
  }
  return r.args.len();
}

function struct_type_param_count(structs: parser.StructDecl[], name: string): i32 {
  for sd in structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return sd.type_params.len();
    }
  }
  return -1;
}

function struct_decl_line(structs: parser.StructDecl[], name: string): i32 {
  for sd in structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return sd.line;
    }
  }
  return 0;
}

function struct_decl_col(structs: parser.StructDecl[], name: string): i32 {
  for sd in structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return sd.col;
    }
  }
  return 0;
}

function dot_index(s: string): i32 {
  let i = 0;
  while (i < s.len()) {
    if (s[i] == b'.') {
      return i;
    }
    i += 1;
  }
  return -1;
}

function variant_pattern_name(name: string): string {
  let d = dot_index(name);
  if (d < 0) {
    return name;
  }
  return slice_unchecked(name, d + 1, name.len()) + "";
}

function variant_pattern_owner(name: string): string {
  let d = dot_index(name);
  if (d < 0) {
    return "";
  }
  return slice_unchecked(name, 0, d) + "";
}

function type_arity_diag(t: string, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  while (t.len() > 2 && slice_unchecked(t, t.len() - 2, t.len()) == "[]") {
    t = slice_unchecked(t, 0, t.len() - 2) + "";
  }
  let nargs = count_type_args(t);
  if (nargs < 0) {
    return out;
  }
  let base = util.base_type_name(t);
  let shadows = parser.is_reserved_struct_name(base) || parser.is_reserved_enum_name(base);
  let tpc = struct_type_param_count(structs, base);
  if (tpc >= 0) {
    if (nargs != tpc && !shadows) {
      out = out.append(dg_at("E019", util.arity_message("struct " + base, tpc, nargs, "type argument"), struct_decl_line(structs, base), struct_decl_col(structs, base)));
    }
    return out;
  }
  if (parser.is_reserved_struct_name(base)) {
    let stp = parser.reserved_struct_tparams(base).len();
    if (nargs != stp) {
      out = out.append(dg_at("E019", util.arity_message("struct " + base, stp, nargs, "type argument"), 0, 0));
    }
    return out;
  }
  if (parser.is_reserved_enum_name(base)) {
    let etp = parser.reserved_enum_tparams(base).len();
    if (nargs != etp) {
      out = out.append(dg_at("E019", util.arity_message("enum " + base, etp, nargs, "type argument"), 0, 0));
    }
    return out;
  }
  for ed in enums {
    if (ed.name == base && ed.type_params.len() != nargs && !shadows) {
      return out.append(dg_at("E019", util.arity_message("enum " + base, ed.type_params.len(), nargs, "type argument"), ed.line, ed.col));
    }
  }
  return out;
}

function variant_payload_count(name: string, structs: StructTable): i32 {
  let Some(sd) = find_variant_sig(structs, name) else {
    return -1;
  };
  if (!util.has_str(sd.field_names, "__ev")) {
    return -1;
  }
  let c = 0;
  for field_name in sd.field_names {
    let fn = field_name;
    if (fn.len() >= 4 && slice_unchecked(fn, 0, 4) == "__ev") {
      c += 1;
    }
  }
  return c;
}

function payload_arity_diags(pv: ast.PatVariant, variant: string, structs: StructTable, unions: UnionTable, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let pc = variant_payload_count(variant, structs);
  if (pc < 0) {
    if let Some(owner) = union_sig_of_variant(variant_pattern_name(variant), unions) {
      if (!owner.is_enum) {
        pc = 1;
      }
    }
  }
  if (pc >= 0) {
    let nb = pv.extra_bindings.len();
    if (pv.binding.len() > 0) {
      nb += 1;
    }
    if (nb != pc) {
      out = out.append(dg_at("E015", payload_count_message(shown_variant_in(structs, pv.type_name), pc, nb), line, col));
    }
  }
  return out;
}

function variant_owner_count(name: string, structs: StructTable): i32 {
  let owners: string[] = [];
  let k = structs.index.chain(name);
  while (k >= 0) {
    let sd = structs.structs[k];
    if (sd.name == name && sd.enum_owner.len() > 0 && !util.has_str(owners, sd.enum_owner)) {
      owners = owners.append(sd.enum_owner);
    }
    k = structs.index.next[k];
  }
  return owners.len();
}

function record_pattern_diags(pvin: ast.PatVariant, structs: StructTable, line: i32, col: i32): util.Diag[] {
  let pv = ast.PatVariant { ...pvin, type_name: shown_variant_in(structs, pvin.type_name) };
  let out: util.Diag[] = [];
  let Some(ss) = find_variant_sig(structs, pvin.type_name) else {
    return out;
  };
  let decl = ss.variant_field_names;
  if (decl.len() == 0) {
    return out.append(dg_at("E015", "variant " + pv.type_name + " has positional payloads; match it as " + pv.type_name + "(...), not " + pv.type_name + " { ... }", line, col));
  }
  let bound: string[] = [];
  for field_name in pv.field_names {
    let nm = field_name;
    if (!util.has_str(decl, nm)) {
      out = out.append(dg_at("E015", "variant " + pv.type_name + " has no field \"" + nm + "\"", line, col));
    } else if (util.has_str(bound, nm)) {
      out = out.append(dg_at("E015", "field \"" + nm + "\" bound more than once in pattern for " + pv.type_name, line, col));
    } else {
      bound = bound.append(nm);
    }
  }
  if (bound.len() != decl.len() && !pv.rest_written) {
    out = out.append(missing_pattern_fields_diag(pv.type_name, decl, line, col));
  }
  return out;
}

function missing_pattern_fields_diag(name: string, decl: string[], line: i32, col: i32): util.Diag {
  let listed = "";
  let d = 0;
  while (d < decl.len()) {
    if (d > 0) {
      listed += ", ";
    }
    listed += decl[d];
    d += 1;
  }
  return dg_at("E015", "named-field pattern for " + util.demangle(name) + " must bind all " + util.i32_to_string(decl.len()) + " field(s) (" + listed + "), or end in `..` to leave the rest out", line, col);
}

function destructure_covers_diags(v: ast.StmtVar, structs: StructTable): util.Diag[] {
  if (!parser.is_struct_destr_marker(v.type_name)) {
    return [];
  }
  let (fields, _) = struct_destr_fields(v.type_name);
  return struct_pattern_covers_diags(struct_destr_name(v.type_name), fields, parser.destr_marker_split(v.type_name).rest_written, structs, v.line, v.col);
}

function struct_arms_cover_diags(arms: ast.StructArm[], structs: StructTable): util.Diag[] {
  let out: util.Diag[] = [];
  for sa in arms {
    if (!sa.is_wild) {
      out = util.append_diags(out, struct_pattern_covers_diags(sa.type_name, sa.fields, sa.rest_written, structs, sa.line, sa.col));
    }
  }
  return out;
}

function struct_pattern_covers_diags(name: string, fields: string[], rest: boolean, structs: StructTable, line: i32, col: i32): util.Diag[] {
  let Some(sig) = find_struct_sig(structs, name) else {
    return [];
  };
  if (rest) {
    return [];
  }
  for f in fields {
    if (!util.has_str(sig.field_names, f)) {
      return [];
    }
  }
  for f in sig.field_names {
    if (!util.has_str(fields, f)) {
      return [missing_pattern_fields_diag(name, sig.field_names, line, col)];
    }
  }
  return [];
}

function payload_slot_type_name(ss: StructSig, idx: i32): string {
  let want = "__ev";
  if (idx > 0) {
    want = "__ev" + util.i32_to_string(idx);
  }
  let i = 0;
  while (i < ss.field_names.len()) {
    if (ss.field_names[i] == want && i < ss.field_type_names.len()) {
      return util.base_type_name(ss.field_type_names[i]);
    }
    i += 1;
  }
  return "";
}

function payloadless_binder_diags(pv: ast.PatVariant, structs: StructTable, unions: UnionTable, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let Some(ss) = find_variant_sig(structs, pv.type_name) else {
    return out;
  };
  let slot = 0;
  while (slot < pv.extra_bindings.len() + 1) {
    let nm = pv.binding;
    if (slot > 0) {
      nm = pv.extra_bindings[slot - 1];
    }
    if (nm.len() > 0 && nm != "_") {
      let pt = payload_slot_type_name(ss, slot);
      if (pt.len() > 0 && union_of_variant(nm, unions) == pt && variant_payload_count(nm, structs) < 0) {
        out = out.append(dg_at("E015", nm + " is a payload-less variant of enum " + pt + ", but a bare name in a payload slot is a binder that matches every value — write `" + nm + "()` to match the variant, or rename the binder", line, col));
      }
    }
    slot += 1;
  }
  return out;
}

function generic_binder_diags(pv: ast.PatVariant, s: Scope, whole: typeinfo.Type, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let found = find_variant_sig(s.structs, pv.type_name);
  let slot = 0;
  while (slot < pv.extra_bindings.len() + 1) {
    let nm = pv.binding;
    if (slot > 0) {
      nm = pv.extra_bindings[slot - 1];
    }
    if let typeinfo.TypeUnion(u) = variant_pattern_payload_type(s, pv.type_name, whole, slot) {
      let declared = "";
      if let Some(ss) = found {
        declared = payload_slot_type_name(ss, slot);
      }
      let owner = scope_variant_owner(nm, s);
      if (owner.len() == 0) {
        owner = parser.builtin_enum_of(nm);
      }
      if (nm.len() > 0 && nm != "_" && declared != u.name && owner == u.name && variant_payload_count(nm, s.structs) < 0) {
        out = out.append(dg_at("E015", nm + " is a payload-less variant of enum " + u.name + ", but a bare name in a payload slot is a binder that matches every value — write `" + nm + "()` to match the variant, or rename the binder", line, col));
      }
    }
    slot += 1;
  }
  return out;
}

function match_stmt_own_lambdas(st: ast.Stmt, structs: StructTable, unions: UnionTable): util.Diag[] {
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, match_diags(lm.body, structs, unions));
      },
      _ => {
        return acc;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, ow_outside_lambda);
}

function sugar_unreachable_diags(sg: ast.MatchSugar, t: typeinfo.Type, s: Scope): util.Diag[] {
  if (sg.origin != "") {
    return [];
  }
  let out = util.append_diags(tuple_unreachable_diags(sg.tup), struct_unreachable_diags(sg.strct));
  return util.append_diags(out, variant_unreachable_diags(sg.arms, t, s));
}

function variant_unreachable_diags(arms: ast.MatchArm[], t: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (literal_match_type(t)) {
    return scalar_unreachable_diags(arms, t, s);
  }
  if let typeinfo.TypeUnion(_) = t {
    let covered: string[] = [];
    let all = false;
    for arm in arms {
      if (all) {
        out = out.append(dg_at("E026", "arm is unreachable — a preceding arm matches every value", arm.line, arm.col));
        continue;
      }
      match (arm.pattern) {
        ast.PatLiteral(_) => {},
        ast.PatWildcard(_) => {
          if (!arm.has_guard) {
            all = true;
          }
        },
        ast.PatVariant(pv) => {
          let p = typed_pattern_cover(arm.pattern, t, s);
          if (util.has_str(covered, p.ctor)) {
            out = out.append(dg_at("E028", "variant \"" + shown_variant_in(s.structs, pv.type_name) + "\" already covered earlier in this match", arm.line, arm.col));
          } else if (!arm.has_guard && cover_binders_only(p.args)) {
            covered = covered.append(p.ctor);
          }
        }
      }
    }
  }
  return out;
}

function cover_binders_only(args: CoverPat[]): boolean {
  for p in args {
    if (p.opaque || p.ctor.len() > 0 && p.ctor != "()" && p.ctor != "{}") {
      return false;
    }
    if (!cover_binders_only(p.args)) {
      return false;
    }
  }
  return true;
}

function scalar_unreachable_diags(arms: ast.MatchArm[], t: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  for i in 0..arms.len() {
    let arm = arms[i];
    if let ast.PatVariant(pv) = arm.pattern {
      let name = scalar_binding_name(pv, t, s);
      if (name.len() > 0 && !arm.has_guard && i < arms.len() - 1) {
        out = out.append(dg_at("E026", "binding arm `" + name + "` matches every value and must be last in the match", arm.line, arm.col));
      }
    }
  }
  return out;
}

function tuple_unreachable_diags(arms: ast.TupArm[]): util.Diag[] {
  let out: util.Diag[] = [];
  let covered = false;
  for a in arms {
    if (covered) {
      out = out.append(dg_at("E026", "arm is unreachable — a preceding arm matches every value", a.line, a.col));
    }
    if (!a.has_guard && (a.is_wild || tuple_binders_only(a.elem_kinds, a.elem_pats))) {
      covered = true;
    }
  }
  return out;
}

function struct_unreachable_diags(arms: ast.StructArm[]): util.Diag[] {
  let out: util.Diag[] = [];
  let covered = false;
  for a in arms {
    if (covered) {
      out = out.append(dg_at("E026", "arm is unreachable — a preceding arm matches every value", a.line, a.col));
    }
    if (!a.has_guard && (a.is_wild || binds_only(a.field_kinds))) {
      covered = true;
    }
  }
  return out;
}

function tuple_binders_only(kinds: i32[], pats: ast.Pattern[]): boolean {
  let i = 0;
  while (i < kinds.len()) {
    if (kinds[i] == 4 && i < pats.len()) {
      if let ast.PatVariant(p) = pats[i] {
        if (!tuple_binders_only(p.tup_kinds, p.tup_pats)) {
          return false;
        }
      } else {
        return false;
      }
    } else if (kinds[i] != 0 && kinds[i] != 1) {
      return false;
    }
    i += 1;
  }
  return true;
}

function is_variant_pattern(pv: ast.PatVariant, structs: StructTable): boolean {
  return !pv.bare_name || structs.index.has(pv.type_name) || variant_owner_count(pv.type_name, structs) > 0 || parser.builtin_enum_of(pv.type_name).len() > 0;
}

function match_diags(stmts: ast.Stmt[], structs: StructTable, unions: UnionTable): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtMatch(m) => {
        let seen: string[] = [];
        let a = 0;
        while (a < m.arms.len()) {
          match (m.arms[a].pattern) {
            ast.PatLiteral(_) => {},
            ast.PatWildcard(_) => {
              if (a < m.arms.len() - 1 && !m.arms[a].has_guard) {
                out = out.append(dg_at("E026", "wildcard `_` arm must be last in the match", m.arms[a].line, m.arms[a].col));
              }
            },
            ast.PatVariant(pv) => {
              out = util.append_diags(out, payloadless_binder_diags(pv, structs, unions, m.arms[a].line, m.arms[a].col));
              if (pv.type_name.len() > 0) {
                let variant_name = is_variant_pattern(pv, structs);
                if (variant_name && util.has_str(seen, pv.type_name)) {
                  out = out.append(dg_at("E028", "variant \"" + shown_variant_in(structs, pv.type_name) + "\" already covered earlier in this match", m.arms[a].line, m.arms[a].col));
                } else if (variant_name && !m.arms[a].has_guard) {
                  seen = seen.append(pv.type_name);
                }
                if (parser.is_record_pattern(pv)) {
                  out = util.append_diags(out, record_pattern_diags(pv, structs, m.arms[a].line, m.arms[a].col));
                } else if (dot_index(pv.type_name) >= 0 || variant_owner_count(pv.type_name, structs) < 2) {
                  out = util.append_diags(out, payload_arity_diags(pv, pv.type_name, structs, unions, m.arms[a].line, m.arms[a].col));
                }
              }
            }
          }
          out = util.append_diags(out, match_diags(m.arms[a].body, structs, unions));
          a += 1;
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, match_diags(f.then_body, structs, unions));
        out = util.append_diags(out, match_diags(f.else_body, structs, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, match_diags(w.body, structs, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, match_diags(fr.body, structs, unions));
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, match_diags(one, structs, unions));
      },
      _ => {}
    }
    out = util.append_diags(out, match_stmt_own_lambdas(stmt, structs, unions));
  }
  return out;
}

function magnitude_is_zero(text: string, start: i32): boolean {
  let i = start;
  while (i < text.len() && text[i] as i32 == 48) {
    i += 1;
  }
  return i == text.len();
}

function main_result_ty(ty: string): boolean {
  return ty == "void" || ty == "boolean" || ty == "i32" || ty == "i64" || is_unsigned_int_ty(ty);
}

function is_unsigned_int_ty(ty: string): boolean {
  return ty == "u8" || ty == "u32" || ty == "u64" || ty == "usize";
}

function int_ty_max_dec(ty: string, negated: boolean): string {
  if (ty == "i32") {
    if (negated) {
      return "2147483648";
    }
    return "2147483647";
  }
  if (ty == "i64") {
    if (negated) {
      return "9223372036854775808";
    }
    return "9223372036854775807";
  }
  if (ty == "u8") {
    return "255";
  }
  if (ty == "u32") {
    return "4294967295";
  }
  if (ty == "u64" || ty == "usize") {
    return "18446744073709551615";
  }
  return "";
}

function int_ty_max_hex(ty: string, negated: boolean): string {
  if (ty == "i32") {
    if (negated) {
      return "80000000";
    }
    return "7fffffff";
  }
  if (ty == "i64") {
    if (negated) {
      return "8000000000000000";
    }
    return "7fffffffffffffff";
  }
  if (ty == "u8") {
    return "ff";
  }
  if (ty == "u32") {
    return "ffffffff";
  }
  if (ty == "u64" || ty == "usize") {
    return "ffffffffffffffff";
  }
  return "";
}

function int_lit_fits(text: string, ty: string, negated: boolean): boolean {
  let hex = parser.is_hex_lit(text);
  let start = 0;
  if (hex) {
    start = 2;
  }
  let neg = negated && !magnitude_is_zero(text, start);
  if (neg && is_unsigned_int_ty(ty)) {
    return false;
  }
  let max = int_ty_max_dec(ty, neg);
  if (hex) {
    max = int_ty_max_hex(ty, neg);
  }
  if (max.len() == 0) {
    return true;
  }
  return parser.magnitude_fits(text, start, max);
}

function int_lit_as_written(text: string, negated: boolean): string {
  let prefixed: boolean = parser.is_hex_lit(text)
    || text.len() > 2 && text[0] == b'0' && (text[1] == b'o' || text[1] == b'O' || text[1] == b'b' || text[1] == b'B');
  let start = 0;
  let out = text;
  if (prefixed) {
    start = 2;
  } else {
    let i = 0;
    while (i + 1 < text.len() && text[i] as i32 == 48) {
      i += 1;
    }
    out = slice_unchecked(text, i, text.len()) + "";
  }
  if (negated && !magnitude_is_zero(text, start)) {
    return "-" + out;
  }
  return out;
}

function dupvar_stmt_own_lambdas(st: ast.Stmt): util.Diag[] {
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, dupvar_diags(lm.body));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, not_into_lambda);
}

function duplicate_var_diag(stmts: ast.Stmt[], v: ast.StmtVar): util.Diag {
  let d = dg_at("E013", "variable \"" + v.name + "\" already declared in this scope", v.line, v.col);
  for stmt in stmts {
    if let ast.StmtVar(prior) = stmt {
      if (prior.line == v.line && prior.col == v.col) {
        return d;
      }
      if (prior.name == v.name && prior.line > 0) {
        d = util.Diag { ...d, related: [util.Related { line: prior.line, col: prior.col, length: 0, message: "previous declaration is here" }] };
      }
    }
  }
  return d;
}

function dupvar_diags(stmts: ast.Stmt[]): util.Diag[] {
  let out: util.Diag[] = [];
  let declared: string[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (util.has_str(declared, v.name)) {
          if (!ast.var_binds_itself(v)) {
            out = out.append(duplicate_var_diag(stmts, v));
          }
        } else {
          declared = declared.append(v.name);
        }
        if (v.type_name.len() == 0) {
          match (v.init) {
            ast.ExprArray(arr) => {
              if (arr.elements.len() == 0) {
                out = out.append(dg_at("E020", "empty array literal needs a type annotation", v.line, v.col));
              }
            },
            _ => {}
          }
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, dupvar_diags(f.then_body));
        out = util.append_diags(out, dupvar_diags(f.else_body));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, dupvar_diags(w.body));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, dupvar_diags(fr.body));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, dupvar_diags(arm.body));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, dupvar_diags(one));
      },
      _ => {}
    }
    out = util.append_diags(out, dupvar_stmt_own_lambdas(stmt));
  }
  return out;
}

struct LitSign { line: i32, col: i32, minuses: i32 }

function lit_sign_chain(e: ast.Expr, minuses: i32, own acc: LitSign[]): LitSign[] {
  match (e) {
    ast.ExprUnary(u) => {
      if (u.op == "-") {
        return lit_sign_chain(u.operand, minuses + 1, acc);
      }
      if (u.op == "+") {
        return lit_sign_chain(u.operand, minuses, acc);
      }
      return acc;
    },
    ast.ExprNumber(n) => {
      if (minuses == 0) {
        return acc;
      }
      return acc.append(LitSign { line: n.line, col: n.col, minuses: minuses });
    },
    _ => {
      return acc;
    }
  }
}

function lit_signs_stmts(stmts: ast.Stmt[]): LitSign[] {
  function at_unary(n: ast.Expr, own acc: LitSign[]): LitSign[] {
    match (n) {
      ast.ExprUnary(_) => {
        return lit_sign_chain(n, 0, acc);
      },
      _ => {
        return acc;
      }
    }
  }
  let signs: LitSign[] = [];
  for st in stmts {
    signs = astwalk.fold_stmt(st, signs, at_unary);
  }
  return signs;
}

function lit_negated(signs: LitSign[], line: i32, col: i32): boolean {
  let deepest = 0;
  for s in signs {
    if (s.line == line && s.col == col && s.minuses > deepest) {
      deepest = s.minuses;
    }
  }
  return deepest % 2 == 1;
}

function numeral_spelling(n: ast.ExprNumber): string {
  if (n.raw.len() == 0) {
    return n.text;
  }
  return slice_unchecked(n.raw, 0, n.raw.len() - n.suffix.len()) + "";
}

function suffix_range_diag(num: ast.ExprNumber, negated: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  if ((!num.is_float && num.suffix.len() == 0 || parser.float_settled_int(num)) && !parser.is_quoted_literal(num) && !parser.is_unit_literal(num) && !int_lit_fits(num.text, "u64", false)) {
    return out.append(dg_at("E047", "literal " + num.text + " does not fit in any integer type; write it as a float for f64", num.line, num.col));
  }
  if (num.is_float || parser.is_quoted_literal(num) || num.suffix.len() == 0) {
    return out;
  }
  if (int_lit_fits(num.text, num.suffix, negated)) {
    return out;
  }
  let msg = "literal " + int_lit_as_written(numeral_spelling(num), negated) + " does not fit in " + num.suffix;
  if (negated && is_unsigned_int_ty(num.suffix)) {
    msg += ": unsigned types have no negative values";
  }
  return out.append(dg_at("E047", msg, num.line, num.col));
}

function suffix_range_stmts(stmts: ast.Stmt[]): util.Diag[] {
  let signs = lit_signs_stmts(stmts);
  function at_number(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprNumber(num) => {
        return util.append_diags(acc, suffix_range_diag(num, lit_negated(signs, num.line, num.col)));
      },
      _ => {
        return acc;
      }
    }
  }
  let out: util.Diag[] = [];
  for st in stmts {
    out = astwalk.fold_stmt(st, out, at_number);
  }
  return out;
}

function mlit_is_base(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(bc) => {
      match (bc.callee) {
        ast.ExprIdent(bid) => {
          return is_map_new_name(bid.name);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_map_new_name(name: string): boolean {
  return name == "map_new" || name == "__map_new_i32";
}

function unsettled_int_literal(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return !n.is_float && n.suffix.len() == 0 && !parser.is_unit_literal(n)
        && !parser.literal_is_i64(n.text);
    },
    ast.ExprUnary(u) => {
      if (u.op == "-") {
        match (u.operand) {
          ast.ExprNumber(un) => {
            if (!un.is_float && un.suffix.len() == 0 && un.text == "2147483648") {
              return true;
            }
          },
          _ => {}
        }
        return unsettled_int_literal(u.operand);
      }
      return false;
    },
    ast.ExprBinary(b) => {
      if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
        return unsettled_int_literal(b.left) && unsettled_int_literal(b.right);
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// A number, or a number under one or more unary minuses: `5`, `-5`, `-(-5)`.
function bare_numeric_literal(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(_) => {
      return true;
    },
    ast.ExprUnary(u) => {
      return u.op == "-" && bare_numeric_literal(u.operand);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function int_literal_tree(e: ast.Expr): boolean {
  return parser.int_literal_tree(e);
}

function numeric_literal_kind(e: ast.Expr): i32 {
  if (int_literal_tree(e)) {
    return 1;
  }
  if (float_literal_tree(e)) {
    return 2;
  }
  return 0;
}

function float_literal_tree(e: ast.Expr): boolean {
  return parser.float_literal_tree(e);
}

function literal_gives_way(kind: i32, t: typeinfo.Type): boolean {
  if (kind == 1) {
    return is_integer(t) || is_float(t);
  }
  if (kind == 2) {
    return is_float(t);
  }
  return false;
}

function int_operand_op(op: string): boolean {
  if (op == "+" || op == "-" || op == "*" || op == "/" || op == "%") {
    return true;
  }
  if (op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>") {
    return true;
  }
  return op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}

function const_refused_op(op: string): boolean {
  if (op == "+|" || op == "-|" || op == "*|" || op == "<<|") {
    return true;
  }
  if (op == "+?" || op == "-?" || op == "*?") {
    return true;
  }
  if (op == "/?" || op == "%?") {
    return true;
  }
  return op == "<<?" || op == ">>?";
}

function int_range_diags(e: ast.Expr, ty: string, negated: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float || parser.is_quoted_literal(n) || n.suffix.len() > 0 || parser.is_unit_literal(n)) {
        return out;
      }
      if (int_lit_fits(n.text, ty, negated)) {
        return out;
      }
      let msg = "literal " + int_lit_as_written(numeral_spelling(n), negated) + " does not fit in " + ty;
      if (negated && is_unsigned_int_ty(ty)) {
        msg += ": unsigned types have no negative values";
      }
      return out.append(dg_at("E047", msg, n.line, n.col));
    },
    ast.ExprUnary(u) => {
      if (u.op == "-") {
        return int_range_diags(u.operand, ty, !negated);
      }
      if (u.op == "+") {
        return int_range_diags(u.operand, ty, negated);
      }
      return out;
    },
    ast.ExprBinary(b) => {
      if (int_operand_op(b.op)) {
        out = util.append_diags(int_range_diags(b.left, ty, false), int_range_diags(b.right, ty, false));
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

function int_dest_range_diags(e: ast.Expr, want: typeinfo.Type): util.Diag[] {
  let out: util.Diag[] = [];
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      for value in mx_body_result_exprs(parser.vb_body(c)) {
        out = util.append_diags(out, int_dest_range_diags(value, want));
      }
      return out;
    }
  }
  if let ast.ExprUnary(tu) = e {
    if let ast.ExprCall(tc) = tu.operand {
      if (tu.op == "try_" && ctor_variant_name(tc) == "Some" && tc.args.len() == 1) {
        return int_dest_range_diags(tc.args[0], want);
      }
    }
  }
  match (want) {
    typeinfo.TypeI32(wi) => {
      if (wi.is_char || !int_literal_tree(e)) {
        return out;
      }
      return int_range_diags(e, int_label(wi), false);
    },
    typeinfo.TypeArray(wa) => {
      match (e) {
        ast.ExprArray(arr) => {
          for element in arr.elements {
            out = util.append_diags(out, int_dest_range_diags(element, wa.elem));
          }
          return out;
        },
        _ => {
          return out;
        }
      }
    },
    typeinfo.TypeTuple(wt) => {
      match (e) {
        ast.ExprTuple(tl) => {
          if (tl.elements.len() != wt.elements.len()) {
            return out;
          }
          let i = 0;
          while (i < wt.elements.len()) {
            out = util.append_diags(out, int_dest_range_diags(tl.elements[i], wt.elements[i]));
            i += 1;
          }
          return out;
        },
        _ => {
          return out;
        }
      }
    },
    _ => {
      return out;
    }
  }
  return out;
}

function settles_to(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if (scalar_value_widens(e, want, s)) {
    return true;
  }
  if (cell_new_settles(e, want, s)) {
    return true;
  }
  if let ast.ExprCall(vc) = e {
    if (parser.is_value_block(vc)) {
      let body = parser.vb_body(vc);
      if (vb_numeric_recovery(body, want, s)) {
        return true;
      }
      return vb_settles(body, want, s);
    }
  }
  if let ast.ExprUnary(tu) = e {
    if (tu.op == "try_") {
      if let ast.ExprCall(tc) = tu.operand {
        if (ctor_variant_name(tc) == "Some" && tc.args.len() == 1 && !ctor_name_taken(tc, s)) {
          return settles_to(tc.args[0], want, s);
        }
      }
      return false;
    }
  }
  if (dest_bound_result(e, s)) {
    return true;
  }
  if let typeinfo.TypeFunc(wf) = want {
    if (generic_fn_value_arg(e, s)) {
      return fn_value_settles(e, wf, s);
    }
  }
  match (want) {
    typeinfo.TypeMap(wm) => {
      return mlit_is_desugared(e) && mlit_entries_settle(e, wm, s);
    },
    typeinfo.TypeFloat(_) => {
      return unsettled_int_literal(e) || is_poly_float(check_expr(e, s));
    },
    typeinfo.TypeI32(wi) => {
      if (wi.is_char) {
        return false;
      }
      return int_literal_tree(e);
    },
    typeinfo.TypeArray(wa) => {
      return array_literal_settles(e, wa.elem, s) || mixed_literal_settles(e, wa.elem, s);
    },
    typeinfo.TypeTuple(wt) => {
      return tuple_literal_settles(e, wt.elements, s);
    },
    typeinfo.TypeUnion(_) => {
      return ctor_boxes_into(e, want, s) || ctor_payload_settles(e, want, s) || member_lit_settles(e, want, s);
    },
    typeinfo.TypeStruct(ws) => {
      return struct_lit_settles(e, ws, s);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function array_literal_settles(e: ast.Expr, elem: typeinfo.Type, s: Scope): boolean {
  match (e) {
    ast.ExprArray(arr) => {
      for element in arr.elements {
        if (!array_element_settles(element, elem, s) || !dyn_conforms(check_expr(element, s), elem, s)) {
          return false;
        }
      }
      return true;
    },
    ast.ExprBytes(_) => {
      return type_eq(elem, t_u8());
    },
    _ => {
      return false;
    }
  }
}

// A mixed literal already has its E034, so it takes no destination error when its first element could settle there.
function mixed_literal_settles(e: ast.Expr, elem: typeinfo.Type, s: Scope): boolean {
  if let ast.ExprArray(a) = e {
    let none: util.Diag[] = [];
    return array_mix_diags(a, s, none).len() > 0 && elem_settleable(check_expr(a.elements[0], s), elem, s);
  }
  return false;
}

function elem_settleable(have: typeinfo.Type, want: typeinfo.Type, s: Scope): boolean {
  if (type_contains_unknown(have) || type_contains_unknown(want) || poly_numeric_settles(have, want)) {
    return true;
  }
  if (same_settle_shape(have, want)) {
    return parts_settleable(have, want, s);
  }
  return typeinfo.lossless_widen(have, want) || coercible(have, want, s);
}

function same_settle_shape(have: typeinfo.Type, want: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(ha) = have {
    if let typeinfo.TypeArray(wa) = want {
      return ha.view == wa.view;
    }
  }
  if let typeinfo.TypeStruct(hs) = have {
    if let typeinfo.TypeStruct(ws) = want {
      return hs.name == ws.name && hs.args.len() == ws.args.len() && hs.args.len() > 0;
    }
  }
  return false;
}

function parts_settleable(have: typeinfo.Type, want: typeinfo.Type, s: Scope): boolean {
  if let typeinfo.TypeArray(ha) = have {
    if let typeinfo.TypeArray(wa) = want {
      return elem_settleable(ha.elem, wa.elem, s);
    }
  }
  if let typeinfo.TypeStruct(hs) = have {
    if let typeinfo.TypeStruct(ws) = want {
      return args_settleable(hs.args, ws.args, s);
    }
  }
  return false;
}

function args_settleable(have: typeinfo.Type[], want: typeinfo.Type[], s: Scope): boolean {
  let i = 0;
  while (i < have.len()) {
    if (!elem_settleable(have[i], want[i], s)) {
      return false;
    }
    i += 1;
  }
  return true;
}

function poly_numeric_settles(have: typeinfo.Type, want: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(hi) = have {
    return hi.polymorphic && (is_integer(want) || is_float(want));
  }
  if let typeinfo.TypeFloat(hf) = have {
    return hf.polymorphic && is_float(want);
  }
  return false;
}

function tuple_literal_settles(e: ast.Expr, elements: typeinfo.Type[], s: Scope): boolean {
  if let ast.ExprTuple(tl) = e {
    if (tl.elements.len() != elements.len()) {
      return false;
    }
    let i = 0;
    while (i < elements.len()) {
      if (!view_free_settle(tl.elements[i], elements[i], s) || !settles_or_nested(tl.elements[i], elements[i], s)) {
        return false;
      }
      i += 1;
    }
    return true;
  }
  return false;
}

function array_element_settles(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if let typeinfo.TypeTuple(_) = want {
    if let ast.ExprCall(c) = e {
      if (parser.is_value_block(c)) {
        return nested_assignable(check_expr(e, s), want, s.unions.unions);
      }
    }
  }
  return view_free_settle(e, want, s) && settles_or_assignable(e, want, s);
}

// Inside a destination, a view slot takes only a value that is already a view:
// a literal settles into a view only at the top of a destination.
function view_free_settle(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if (!is_arr_view(want)) {
    return true;
  }
  let t = check_expr(e, s);
  return is_unknown(t) || type_assignable(t, want, s.unions.unions);
}

function ctor_boxes_into(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    let vname = ctor_variant_name(c);
    if (scope_variant_owner(vname, s).len() == 0 && parser.builtin_enum_of(vname).len() == 0) {
      return false;
    }
    let got = check_expr(e, s);
    if (!same_nominal(got, want)) {
      return false;
    }
    let ga = nominal_args(got);
    let wa = nominal_args(want);
    if (ga.len() != wa.len()) {
      return false;
    }
    let boxed = false;
    let i = 0;
    while (i < ga.len()) {
      if (is_dyn_slot(wa[i]) && !is_unknown(ga[i]) && !is_dyn_slot(ga[i])) {
        boxed = true;
      } else if (!is_unknown(ga[i]) && !is_unknown(wa[i]) && !nested_assignable(ga[i], wa[i], s.unions.unions)) {
        return false;
      }
      i += 1;
    }
    return boxed;
  }
  return false;
}

function vb_numeric_recovery(body: ast.Stmt[], want: typeinfo.Type, s: Scope): boolean {
  if (!is_integer(want) && !is_float(want)) {
    return false;
  }
  let arms = mx_body_result_exprs(body);
  let types: typeinfo.Type[] = [];
  for arm in arms {
    types = types.append(check_expr(arm, s));
  }
  let fold = vb_arms_fold(types, arms, s);
  return !fold.ok && arm_unsettled(fold.acc) && settles_to(fold.acc.e, want, s);
}

function vb_settles(body: ast.Stmt[], want: typeinfo.Type, s: Scope): boolean {
  if (body.len() == 0) {
    return false;
  }
  let cur = s;
  let i = 0;
  while (i + 1 < body.len()) {
    cur = bind_stmt(body[i], cur);
    i += 1;
  }
  match (body[i]) {
    ast.StmtReturn(r) => {
      return settles_or_assignable(r.value, want, cur);
    },
    ast.StmtIf(f) => {
      return vb_settles(f.then_body, want, cur) && vb_settles(f.else_body, want, cur);
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        if (!vb_settles(arm.body, want, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)))) {
          return false;
        }
      }
      return m.arms.len() > 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function ctor_payload_settles(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    if (c.args.len() == 0 || !constructor_destination(c, want, s)) {
      return false;
    }
    let wa = nominal_args(want);
    let at = builtin_payload_index(ctor_variant_name(c), want);
    if (at < 0) {
      return declared_payloads_settle(c, want, s);
    }
    if (c.args.len() != 1 || at >= wa.len()) {
      return false;
    }
    return view_free_settle(c.args[0], wa[at], s) && settles_to(c.args[0], wa[at], s);
  }
  return false;
}

function declared_payloads_settle(c: ast.ExprCall, want: typeinfo.Type, s: Scope): boolean {
  let vname = ctor_variant_name(c);
  let whole = bare_at_never(want, s);
  let i = 0;
  while (i < c.args.len()) {
    let field = generic_variant_payload_type(s, vname, whole, i);
    if (is_unknown(field) || !view_free_settle(c.args[i], field, s) || !settles_or_assignable(c.args[i], field, s)) {
      return false;
    }
    i += 1;
  }
  return true;
}

function constructor_destination(c: ast.ExprCall, want: typeinfo.Type, s: Scope): boolean {
  if (ctor_name_taken(c, s) || !same_nominal(check_expr(c, s), want)) {
    return false;
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (qual_variant_union(fa, s).len() == 0) {
      return false;
    }
    if let ast.ExprIdent(ns) = fa.obj {
      if (s.has_sig(ns.name + "." + fa.field)) {
        return false;
      }
    }
  }
  return true;
}

function builtin_payload_index(variant: string, want: typeinfo.Type): i32 {
  if let typeinfo.TypeUnion(u) = want {
    if (u.name == "Option" && variant == "Some") {
      return 0;
    }
    if (u.name == "Result" && variant == "Ok") {
      return 0;
    }
    if (u.name == "Result" && variant == "Err") {
      return 1;
    }
  }
  return -1;
}

function member_lit_settles(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if let ast.ExprStructLit(sl) = e {
    if let typeinfo.TypeStruct(ds) = member_dest(sl.type_name, want, s) {
      return struct_lit_settles(e, ds, s);
    }
  }
  return false;
}

function struct_lit_settles(e: ast.Expr, want: typeinfo.TypeStruct, s: Scope): boolean {
  if (want.args.len() == 0) {
    return false;
  }
  if let ast.ExprStructLit(sl) = e {
    if (sl.has_base || sl.type_name != want.name) {
      return false;
    }
    return struct_type_params(s, sl.type_name).len() == want.args.len();
  }
  return false;
}

function bare_at_never(t: typeinfo.Type, s: Scope): typeinfo.Type {
  if let typeinfo.TypeUnion(u) = t {
    if (u.args.len() == 0) {
      let args: typeinfo.Type[] = [];
      let arity = union_type_params(s, u.name).len();
      while (args.len() < arity) {
        args = args.append(typeinfo.TypeNever { tag: 0 });
      }
      return typeinfo.TypeUnion { name: u.name, args: args };
    }
  }
  return t;
}

function settles_or_assignable(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if (settles_to(e, want, s)) {
    return true;
  }
  let t = check_expr(e, s);
  return is_unknown(t) || type_assignable(t, want, s.unions.unions);
}

function settles_or_nested(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if (settles_to(e, want, s)) {
    return true;
  }
  let t = check_expr(e, s);
  return is_unknown(t) || nested_assignable(t, want, s.unions.unions);
}

function variant_ctor_diags(qname: string, c: ast.ExprCall, s: Scope): util.Diag[] {
  let vname = variant_pattern_name(qname);
  let out: util.Diag[] = [];
  let owner = scope_variant_sig(vname, s);
  if (dot_index(qname) >= 0) {
    owner = s.lookup_union(variant_pattern_owner(qname));
  }
  out = util.append_diags(out, enum_access_diags(owner, s, c.line, c.col));

  let declared_owner: string = match (find_variant_sig(s.structs, qname)) { Some(sig) => sig.enum_owner, None => "" };
  if (scope_variant_owner(vname, s).len() == 0 && declared_owner.len() == 0) {
    let builtin_owner: string = match (owner) { Some(u) => u.name, None => "" };
    if (dot_index(qname) >= 0) {
      builtin_owner = variant_pattern_owner(qname);
    }
    let builtin_want = builtin_variant_payloads(s, builtin_owner, vname);
    if (builtin_want > 0 && c.args.len() != builtin_want) {
      out = out.append(dg_at("E036", util.arity_message("variant " + shown_variant(s, qname), builtin_want, c.args.len(), "argument"), c.line, c.col));
    }
    return out;
  }
  if (dot_index(qname) < 0 && s.variant_ambiguous(vname)) {
    return out;
  }
  let want = variant_payload_count(qname, s.structs);
  if (want < 0 && dot_index(qname) >= 0) {
    if let Some(u) = owner {
      if (u.is_enum && util.has_str(u.variants, vname)) {
        want = variant_value_payloads(s, u.name, vname);
      }
    }
  }
  if (want < 0) {
    return out;
  }
  if (c.args.len() != want) {
    out = out.append(dg_at("E036", util.arity_message("variant " + shown_variant(s, qname), want, c.args.len(), "argument"), c.line, c.col));
  }
  let payload_owner: string = match (variant_payload_struct(s, qname)) { Some(sig) => sig.enum_owner, None => "" };
  let whole = variant_ctor_type(s, payload_owner, qname, c);
  let i = 0;
  while (i < c.args.len() && i < want) {
    let at = check_expr(c.args[i], s);
    let pt = variant_pattern_payload_type(s, qname, whole, i);
    out = util.append_diags(out, int_dest_range_diags(c.args[i], pt));
    if (!is_unknown(at) && !is_unknown(pt) && !(view_free_settle(c.args[i], pt, s) && settles_to(c.args[i], pt, s)) && !coercible(at, pt, s)) {
      out = out.append(dg_at("E036", "variant " + shown_variant(s, qname) + " payload " + util.i32_to_string(i) + " type " + type_label(at) + ", expected " + type_label(pt), expr_line(c.args[i]), expr_col(c.args[i])));
    }
    i += 1;
  }
  return out;
}

function qual_enum_name(obj: ast.Expr, s: Scope): string {
  match (obj) {
    ast.ExprIdent(oid) => {
      if (s.known(oid.name)) {
        return "";
      }
      if (s.has_union(oid.name)) {
        return oid.name;
      }
      if (parser.is_reserved_enum_name(oid.name)) {
        return oid.name;
      }
      return "";
    },
    _ => {
      return "";
    }
  }
  return "";
}

function qual_variant_exists(en: string, field: string, s: Scope): boolean {
  if let Some(ou) = s.lookup_union(en) {
    return util.has_str(ou.variants, field);
  }
  return parser.builtin_enum_of(field) == en;
}

function qual_variant_union(fa: ast.ExprFieldAccess, s: Scope): string {
  let en = qual_enum_name(fa.obj, s);
  if (en.len() == 0 || !qual_variant_exists(en, fa.field, s)) {
    return "";
  }
  return en;
}

struct AssocHit { found: boolean, ret: string, owner: string, params: string[], is_const: boolean }

function assoc_miss(): AssocHit {
  return AssocHit { found: false, ret: "", owner: "", params: [], is_const: false };
}

function trait_req_idx(tr: string, reqs: parser.TraitReq[]): i32 {
  let exact = derive_trait_idx(util.base_type_name(tr), reqs);
  if (exact >= 0) {
    return exact;
  }
  let i = e021_trait_idx(tr, reqs);
  if (i >= 0) {
    return i;
  }
  let simple = parser.derive_simple_name(tr);
  if (simple == tr) {
    return -1;
  }
  return e021_trait_idx(simple, reqs);
}

function bounds_in_module(b: string, module: string): string {
  if (module.len() == 0 || parser.is_const_bound(b)) {
    return b;
  }
  let out = "";
  for part in parser.split_plus_bounds(b) {
    if (out.len() > 0) {
      out += " + ";
    }
    if (util.index_of_sub(util.base_type_name(part), ".") < 0) {
      out = out + module + "." + part;
    } else {
      out += part;
    }
  }
  return out;
}

function trait_assoc_req(reqs: parser.TraitReq[], tr: string, field: string, seen: string[]): AssocHit {
  let idx = trait_req_idx(util.base_type_name(tr), reqs);
  if (idx < 0) {
    return assoc_miss();
  }
  let req = reqs[idx];
  if (util.has_str(seen, req.trait_name)) {
    return assoc_miss();
  }
  let path = seen.append(req.trait_name);
  let args: string[] = [];
  for arg in parser.parse_type_ref(tr).args {
    args = args.append(parser.render_type_ref(arg));
  }
  for rs in req.assoc_sigs {
    if (rs.name == field) {
      let params: string[] = [];
      for p in rs.params {
        params = params.append(parser.subst_ty(parser.fn_tag_spelling(p.type_name, p.fn_ret, p.fn_param_types), req.type_params, args));
      }
      return AssocHit { found: true, ret: parser.subst_ty(rs.ret_type, req.type_params, args), owner: req.trait_name, params: params, is_const: rs.is_const };
    }
  }
  for supertrait in req.supertraits {
    let sh = trait_assoc_req(reqs, parser.subst_ty(supertrait, req.type_params, args), field, path);
    if (sh.found) {
      return sh;
    }
  }
  return assoc_miss();
}

function dyn_method(traits: string, name: string, s: Scope): Option[parser.FuncDecl] {
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let idx = trait_req_idx(util.base_type_name(tr), s.trait_reqs);
    if (idx >= 0) {
      match (trait_req_sig(s.trait_reqs[idx], name)) {
        Some(m) => {
          return Some(m);
        },
        None => {}
      }
    }
  }
  return None;
}

function trait_req_sig(req: parser.TraitReq, name: string): Option[parser.FuncDecl] {
  for m in req.req_sigs {
    if (m.name == name) {
      return Some(m);
    }
  }
  for m in req.default_sigs {
    if (m.name == name) {
      return Some(m);
    }
  }
  return None;
}

function dyn_method_type(traits: string, name: string, s: Scope): typeinfo.Type {
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let idx = trait_req_idx(util.base_type_name(tr), s.trait_reqs);
    if (idx >= 0) {
      match (trait_req_sig(s.trait_reqs[idx], name)) {
        Some(m) => {
          let ret = dyn_ret_at_spelling(m.ret_type, tr, s.trait_reqs[idx].type_params);
          if (ret.len() == 0 || parser.subst_self(ret, "__dyn") != ret) {
            return t_unknown("dyn method result spells Self");
          }
          return s.resolve_type(ret);
        },
        None => {}
      }
    }
  }
  return t_unknown("no method `" + name + "` on `dyn " + traits + "`");
}

function dyn_param_type(traits: string, name: string, k: i32, s: Scope): typeinfo.Type {
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let idx = trait_req_idx(util.base_type_name(tr), s.trait_reqs);
    if (idx >= 0) {
      match (trait_req_sig(s.trait_reqs[idx], name)) {
        Some(m) => {
          if (k >= m.params.len()) {
            return t_unknown("no such parameter");
          }
          let p = m.params[k];
          let pt = dyn_ret_at_spelling(parser.fn_tag_spelling(p.type_name, p.fn_ret, p.fn_param_types), tr, s.trait_reqs[idx].type_params);
          if (pt.len() == 0 || parser.subst_self(pt, "__dyn") != pt) {
            return t_unknown("dyn method parameter spells Self");
          }
          return s.resolve_type(pt);
        },
        None => {}
      }
    }
  }
  return t_unknown("no method `" + name + "` on `dyn " + traits + "`");
}

function dyn_ret_at_spelling(ret: string, spelling: string, tparams: string[]): string {
  let open = e021_bracket_open(spelling);
  if (open < 0) {
    return ret;
  }
  let args: string[] = [];
  let out = ret;
  for raw in parser.split_top_commas(slice_unchecked(spelling, open + 1, spelling.len() - 1) + "") {
    let entry = util.trim(raw);
    let eq = pin_eq(entry);
    if (eq > 0) {
      out = subst_self_proj(out, util.trim(slice_unchecked(entry, 0, eq) + ""), util.trim(slice_unchecked(entry, eq + 1, entry.len()) + ""));
    } else {
      args = args.append(entry);
    }
  }
  if (args.len() == tparams.len()) {
    out = parser.subst_ty(out, tparams, args);
  }
  return out;
}

function pin_eq(entry: string): i32 {
  let depth = 0;
  let i = 0;
  while (i < entry.len()) {
    let c = entry[i];
    if (c == b'(' || c == b'[') {
      depth += 1;
    } else if (c == b')' || c == b']') {
      depth -= 1;
    } else if (c == b'=' && depth == 0 && !(i + 1 < entry.len() && entry[i + 1] == b'>')) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function subst_self_proj(t: string, name: string, val: string): string {
  let pat = "Self::" + name;
  let out = "";
  let i = 0;
  while (i < t.len()) {
    let end = i + pat.len();
    if (end <= t.len() && slice_unchecked(t, i, end) == pat && (end == t.len() || !parser.ident_byte(t[end] as i32)) && (i == 0 || !parser.ident_byte(t[i - 1] as i32))) {
      out += val;
      i = end;
    } else {
      out += slice_unchecked(t, i, i + 1);
      i += 1;
    }
  }
  return out;
}

function dyn_call_diags(c: ast.ExprCall, mfa: ast.ExprFieldAccess, traits: string, s: Scope): util.Diag[] {
  match (dyn_method(traits, mfa.field, s)) {
    Some(m) => {
      if (m.params.len() == 0 || m.params[0].name != "self") {
        return [];
      }
      let want = m.params.len() - 1;
      if (c.args.len() != want) {
        return [dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", want, c.args.len(), "argument"), c.line, c.col)];
      }
      let out: util.Diag[] = [];
      let k = 0;
      while (k < c.args.len()) {
        let pt = dyn_param_type(traits, mfa.field, k + 1, s);
        if (!is_unknown(pt) && !settles_or_assignable(c.args[k], pt, s)) {
          out = out.append(dg_at("E038", "argument " + util.i32_to_string(k + 1) + " to \"" + mfa.field + "\": expected " + type_label(pt) + ", got " + type_label(check_expr(c.args[k], s)), expr_line(c.args[k]), expr_col(c.args[k])));
        }
        k += 1;
      }
      return out;
    },
    None => {}
  }
  return [dg_at("E021", "no method \"" + mfa.field + "\" on `dyn " + traits + "`", mfa.line, mfa.col)];
}

function tp_assoc_req(s: Scope, tname: string, field: string): AssocHit {
  let k = util.index_of_str(s.tparams, tname);
  if (k < 0 || k >= s.tbounds.len()) {
    return assoc_miss();
  }
  for tr in parser.split_plus_bounds(s.tbounds[k]) {
    let h = trait_assoc_req(s.trait_reqs, tr, field, []);
    if (h.found) {
      return h;
    }
  }
  return assoc_miss();
}

function tp_bound_traits(s: Scope, tname: string): string[] {
  let out: string[] = [];
  let k = util.index_of_str(s.tparams, tname);
  if (k < 0 || k >= s.tbounds.len()) {
    return out;
  }
  for entry in parser.split_plus_bounds(s.tbounds[k]) {
    out = out.append(util.base_type_name(entry));
  }
  return out;
}

function tp_bound_provides(s: Scope, tname: string, field: string): boolean {
  for tr in tp_bound_traits(s, tname) {
    if (trait_provides(s.trait_reqs, tr, field, [])) {
      return true;
    }
  }
  return false;
}

function bound_method(s: Scope, tname: string, field: string): Option[MethodSig] {
  let k = util.index_of_str(s.tparams, tname);
  if (tname.len() == 0 || k < 0 || k >= s.tbounds.len()) {
    return None;
  }
  for bound in parser.split_plus_bounds(s.tbounds[k]) {
    match (trait_bound_method(s, bound, tname, field, [])) {
      Some(sig) => {
        return Some(sig);
      },
      None => {}
    }
  }
  return None;
}

function trait_bound_method(s: Scope, bound: string, self: string, field: string, seen: string[]): Option[MethodSig] {
  let ref = parser.parse_type_ref(bound);
  let idx = trait_req_idx(ref.base, s.trait_reqs);
  if (idx < 0) {
    return None;
  }
  let req = s.trait_reqs[idx];
  let key = req.module + "." + req.trait_name;
  if (util.has_str(seen, key)) {
    return None;
  }
  let args: string[] = [];
  for arg in ref.args {
    args = args.append(parser.render_type_ref(arg));
  }
  for m in util.append_all(req.req_sigs, req.default_sigs) {
    if (m.name == field && m.params.len() > 0 && m.params[0].name == "self") {
      let pts: typeinfo.Type[] = [];
      let ptn: string[] = [];
      let tps = util.append_all(s.tparams, m.all_type_params);
      let subst = util.append_all(rigid_tparams(s.tparams), erased_tparams(m.all_type_params));
      let i = 1;
      while (i < m.params.len()) {
        let p = m.params[i];
        let spelling = parser.subst_ty(parser.subst_self(parser.fn_tag_spelling(p.type_name, p.fn_ret, p.fn_param_types), self), req.type_params, args);
        ptn = ptn.append(spelling);
        pts = pts.append(type_from_name_subst(spelling, tps, subst, s.type_names()));
        i += 1;
      }
      let rt = parser.subst_ty(parser.subst_self(parser.fn_tag_spelling(m.ret_type, m.ret_fn_ret, m.ret_fn_param_types), self), req.type_params, args);
      return Some(MethodSig { name: m.name, receiver_type: self, param_types: pts, ret_type: type_from_name_subst(rt, tps, subst, s.type_names()), ret_type_name: rt, param_type_names: ptn, all_type_params: m.all_type_params, type_params: m.type_params, type_bounds: m.bound_traits, module: m.module, impl_trait: req.trait_name, line: m.line, col: m.col, file: decl_file_label(m), is_unsafe: m.is_unsafe, is_pub: true, is_package: false });
    }
  }
  for parent in req.supertraits {
    match (trait_bound_method(s, parser.subst_ty(parent, req.type_params, args), self, field, seen.append(key))) {
      Some(sig) => {
        return Some(sig);
      },
      None => {}
    }
  }
  return None;
}

function trait_provides(reqs: parser.TraitReq[], tr: string, field: string, seen: string[]): boolean {
  let idx = trait_req_idx(tr, reqs);
  if (idx < 0) {
    return true;
  }
  let req = reqs[idx];
  if (util.has_str(seen, req.trait_name)) {
    return false;
  }
  if (util.has_str(req.provided, field)) {
    return true;
  }
  let path = seen.append(req.trait_name);
  for supertrait in req.supertraits {
    if (trait_provides(reqs, supertrait, field, path)) {
      return true;
    }
  }
  return false;
}

function tp_receiver(recv: typeinfo.Type, s: Scope): string {
  if let typeinfo.TypeErased(e) = recv {
    if (util.index_of_str(s.tparams, e.name) >= 0) {
      return e.name;
    }
  }
  return "";
}

function type_assoc_req(s: Scope, tyname: string, field: string): AssocHit {
  let base = util.base_type_name(tyname);
  for imp in s.impls {
    if (imp.impl_type == base && util.has_str(imp.method_names, field)) {
      if let None = s.lookup_method(field, base) {
        let spelling = imp.trait_ref;
        if (spelling.len() == 0) {
          spelling = imp.trait_name;
        }
        let h = trait_assoc_req(s.trait_reqs, spelling, field, []);
        if (h.found) {
          return h;
        }
        let is_const: boolean = match (s.lookup_assoc_sig(base, field)) { Some(sig) => sig.is_const, None => false };
        return AssocHit { found: true, ret: "", owner: "", params: [], is_const: is_const };
      }
    }
  }
  return assoc_miss();
}

function assoc_func_impls(impls: parser.ImplInfo[], funcs: parser.FuncDecl[]): parser.ImplInfo[] {
  let out = impls;
  for fd in funcs {
    if (fd.receiver_name.len() == 0 && fd.receiver_type.len() > 0) {
      let noargs: string[] = [];
      out = out.append(parser.ImplInfo { trait_name: "", impl_type: util.base_type_name(fd.receiver_type), type_params: noargs, all_type_params: noargs, bounds: noargs, method_names: [fd.name], trait_spelling: "", trait_ref: "", assoc_names: noargs, assoc_values: noargs, trait_module: "", module: "", line: fd.line, col: fd.col });
    }
  }
  return out;
}

function assoc_call_req(obj: ast.Expr, field: string, s: Scope, const_read: boolean): AssocHit {
  match (obj) {
    ast.ExprIdent(oid) => {
      if (s.known(oid.name)) {
        return assoc_miss();
      }
      let h = tp_assoc_req(s, oid.name, field);
      if (h.found) {
        return h;
      }
      let ht = type_assoc_req(s, oid.name, field);
      if (ht.found) {
        return ht;
      }
      return assoc_miss();
    },
    _ => {
      return assoc_miss();
    }
  }
  return assoc_miss();
}

function tparam_assoc_diag(tid: ast.ExprIdent, field: string, s: Scope): util.Diag {
  let why = tid.name + " has no bound; bound it by a trait that declares " + field + "()";
  let k = util.index_of_str(s.tparams, tid.name);
  if (k < s.tbounds.len() && s.tbounds[k].len() > 0) {
    why = "its bound " + util.demangle(s.tbounds[k]) + " declares none";
  }
  let d = dg_at("E001", "type parameter " + tid.name + " has no associated function \"" + field + "\": " + why, tid.line, tid.col);
  return util.Diag { ...d, length: util.show_type_vars(tid.name).len() };
}

function assoc_hit_type(h: AssocHit, obj: ast.Expr, s: Scope): typeinfo.Type {
  if (h.ret.len() == 0) {
    return t_unknown("associated call: return type not recoverable");
  }
  let self_name = "";
  match (obj) {
    ast.ExprIdent(oid) => {
      self_name = oid.name;
    },
    _ => {}
  }
  return s.resolve_type(parser.subst_self(h.ret, self_name));
}

function assoc_base_name(obj: ast.Expr): string {
  if let ast.ExprIdent(oid) = obj {
    return oid.name;
  }
  return "";
}

function assoc_const_read_diags(h: AssocHit, c: ast.ExprCall, mfa: ast.ExprFieldAccess): util.Diag[] {
  if (mfa.const_read == h.is_const) {
    return [];
  }
  let base = util.demangle(assoc_base_name(mfa.obj));
  if (mfa.const_read) {
    return [dg_at("E043", base + "." + mfa.field + " is an associated function, not a constant; call it as " + base + "." + mfa.field + "(...)", c.line, c.col)];
  }
  return [dg_at("E043", base + "." + mfa.field + " is an associated constant; read it as " + base + "." + mfa.field + " without an argument list", c.line, c.col)];
}

function assoc_arg_diags(h: AssocHit, c: ast.ExprCall, mfa: ast.ExprFieldAccess, s: Scope): util.Diag[] {
  let self_name = "";
  if let ast.ExprIdent(oid) = mfa.obj {
    self_name = oid.name;
  }
  let pts: typeinfo.Type[] = [];
  if (h.owner.len() > 0) {
    for ps in h.params {
      pts = pts.append(s.resolve_type(parser.subst_self(ps, self_name)));
    }
  } else {
    let Some(asig) = s.lookup_assoc_sig(self_name, mfa.field) else {
      return [];
    };
    pts = asig.param_types;
  }
  if (c.args.len() != pts.len()) {
    return [dg_at("E004", util.arity_message("associated function \"" + mfa.field + "\"", pts.len(), c.args.len(), "argument"), c.line, c.col)];
  }
  let out: util.Diag[] = [];
  let k = 0;
  while (k < c.args.len()) {
    if (!is_unknown(pts[k]) && !settles_or_assignable(c.args[k], pts[k], s)) {
      out = out.append(dg_at("E038", "argument " + util.i32_to_string(k + 1) + " to \"" + mfa.field + "\": expected " + type_label(pts[k]) + ", got " + type_label(check_expr(c.args[k], s)), expr_line(c.args[k]), expr_col(c.args[k])));
    }
    k += 1;
  }
  return out;
}

function operand_open(t: typeinfo.Type): boolean {
  if let typeinfo.TypeErased(_) = t {
    return true;
  }
  return is_unknown(t);
}

function lanes_inside(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeArray(a) => {
      return holds_lanes(a.elem);
    },
    typeinfo.TypeTuple(tp) => {
      return any_holds_lanes(tp.elements);
    },
    typeinfo.TypeMap(m) => {
      return holds_lanes(m.key) || holds_lanes(m.value);
    },
    typeinfo.TypeFunc(f) => {
      return any_holds_lanes(f.param_types) || holds_lanes(f.ret_type);
    },
    typeinfo.TypeStruct(st) => {
      return any_holds_lanes(st.args);
    },
    typeinfo.TypeUnion(u) => {
      return any_holds_lanes(u.args);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function holds_lanes(t: typeinfo.Type): boolean {
  return is_lanes(t) || lanes_inside(t);
}

function any_holds_lanes(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (holds_lanes(t)) {
      return true;
    }
  }
  return false;
}

function lanes_inside_diags(t: typeinfo.Type, line: i32, col: i32): util.Diag[] {
  if (!lanes_inside(t)) {
    return [];
  }
  return [dg_at("E085", type_label(t) + " holds a lane value inside another type; a lane value lives only in a local, a parameter or a result", line, col)];
}

function e085_decl_diags(mod: parser.Module, focus: util.NameIndex, tn: TypeNames): util.Diag[] {
  let out: util.Diag[] = [];
  for efn in mod.funcs {
    if (in_focus(focus, efn)) {
      for param in efn.params {
        let (pl, pc) = param_pos(param, efn.line, efn.col);
        out = util.append_diags(out, lanes_inside_diags(type_from_spelling(e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), tn), pl, pc));
      }
      out = util.append_diags(out, lanes_inside_diags(type_from_spelling(e064_decl_spelling(efn.ret_type, efn.ret_fn_ret, efn.ret_fn_param_types), tn), efn.line, efn.col));
      for an in collect_annots(efn.body) {
        out = util.append_diags(out, lanes_inside_diags(type_from_spelling(an.type_name, tn), an.line, an.col));
      }
    }
  }
  for esd in mod.structs {
    for field in esd.fields {
      let ft = type_from_spelling(e064_decl_spelling(field.type_name, field.fn_ret, field.fn_param_types), tn);
      if (holds_lanes(ft)) {
        let (fl, fc) = field_pos(field, esd.line, esd.col);
        out = out.append(dg_at("E085", "a field or payload of type " + type_label(ft) + " holds a lane value; a lane value lives only in a local, a parameter or a result", fl, fc));
      }
    }
  }
  return out;
}

function call_diags(e: ast.Expr, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      out = call_diags_call(c, s, out, t_unknown("no destination"));
    },
    ast.ExprBinary(b) => {
      out = call_diags_binary(b, s, out);
    },
    ast.ExprUnary(u) => {
      out = call_diags_unary(u, s, out);
    },
    ast.ExprArray(a) => {
      out = call_diags_array(a, s, out);
      out = util.append_diags(out, lanes_inside_diags(check_expr(e, s), a.line, a.col));
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, call_diags(element, s));
      }
      out = util.append_diags(out, lanes_inside_diags(check_expr(e, s), t.line, t.col));
    },
    ast.ExprIndex(ix) => {
      out = call_diags_index(ix, s, out);
    },
    ast.ExprSlice(s2) => {
      out = call_diags_slice(s2, s, out);
    },
    ast.ExprFieldAccess(fa) => {
      out = call_diags_field_access(fa, s, out);
    },
    ast.ExprStructLit(sl) => {
      out = call_diags_struct_lit(sl, [], s, out);
    },
    ast.ExprLambda(lm) => {
      out = call_diags_lambda(lm, s, out);
    },
    ast.ExprIdent(id) => {
      out = call_diags_ident(id, s, out);
    },
    _ => {}
  }
  return out;
}

function payload_count_message(variant: string, want: i32, got: i32): string {
  let values = "values";
  if (want == 1) {
    values = "value";
  }
  return "variant " + variant + " carries " + util.i32_to_string(want) + " " + values + ", but the pattern binds " + util.i32_to_string(got);
}

function arg_subject(c: ast.ExprCall, n: i32): string {
  let arg = "argument " + util.i32_to_string(n);
  if let ast.ExprIdent(id) = c.callee {
    if (!util.str_has_prefix(id.name, "__") || util.str_has_prefix(id.name, util.ENTRY_SHADOW_PREFIX)) {
      return arg + " to \"" + util.demangle(id.name) + "\"";
    }
  }
  return arg;
}

function call_subject(c: ast.ExprCall): string {
  match (c.callee) {
    ast.ExprIdent(id) => {
      return "function \"" + util.demangle(id.name) + "\"";
    },
    _ => {
      return "this function";
    }
  }
}

function cell_call_diags(c: ast.ExprCall, mfa: ast.ExprFieldAccess, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let want: i32 = -1;
  if (mfa.field == "get") {
    want = 0;
  }
  if (mfa.field == "set") {
    want = 1;
  }
  if (want < 0) {
    return [access_fix(dg_at("E043", "struct Cell has no field or method \"" + mfa.field + "\"", mfa.line, mfa.col), mfa, ["get", "set"])];
  }
  if (c.args.len() != want) {
    return [dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", want, c.args.len(), "argument"), c.line, c.col)];
  }
  if (want == 1) {
    let pt = cell_elem_type(recv);
    let at = check_expr(c.args[0], s);
    out = util.append_diags(out, int_dest_range_diags(c.args[0], pt));
    if (!is_unknown(at) && !is_unknown(pt) && !settles_to_dest(c.args[0], pt, s) && !coercible(at, pt, s)) {
      out = out.append(dg_at("E038", "argument 1 to \"" + mfa.field + "\": expected " + type_label(pt) + ", got " + type_label(at) + str_copy_hint(at, pt), expr_line(c.args[0]), expr_col(c.args[0])));
    }
    out = util.append_diags(out, array_elem_check(array_elem_type_of(pt), c.args[0], s));
  }
  return out;
}

function callable_arg_diags(c: ast.ExprCall, ft: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  match (ft) {
    typeinfo.TypeFunc(f) => {
      if (!f.params_known) {
        return out;
      }
      if (c.args.len() != f.param_types.len()) {
        return [dg_at("E004", util.arity_message(call_subject(c), f.param_types.len(), c.args.len(), "argument"), c.line, c.col)];
      }
      let i = 0;
      while (i < c.args.len()) {
        let pt = f.param_types[i];
        let at = check_expr(c.args[i], s);
        out = util.append_diags(out, int_dest_range_diags(c.args[i], pt));
        if (!is_unknown(at) && !is_unknown(pt) && !settles_to_dest(c.args[i], pt, s) && !view_arg_borrow(at, pt) && !coercible(at, pt, s)) {
          out = out.append(dg_at("E038", arg_subject(c, i + 1) + ": expected " + type_label(pt) + ", got " + argument_type_label(c.args[i], at, s), expr_line(c.args[i]), expr_col(c.args[i])));
        }
        out = util.append_diags(out, array_elem_check(array_elem_type_of(pt), c.args[i], s));
        i += 1;
      }
    },
    _ => {}
  }
  return out;
}

function scalar_receiver_name(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function display_dispatch_name(t: typeinfo.Type): string {
  let scalar = scalar_receiver_name(t);
  if (scalar.len() > 0) {
    return scalar;
  }
  match (t) {
    typeinfo.TypeStruct(sd) => {
      return sd.name;
    },
    typeinfo.TypeUnion(u) => {
      return u.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function display_resolves(t: typeinfo.Type, s: Scope): boolean {
  let tn = display_dispatch_name(t);
  if (tn.len() == 0) {
    return false;
  }
  return s.has_method("to_string", tn) || conforms_by_impl_or_derive(s, tn, "Display") || !is_unknown(builtin_method_sig(tn, "to_string"));
}

function display_unjudged(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeString(_) => {
      return true;
    },
    typeinfo.TypeUnknown(_) => {
      return true;
    },
    typeinfo.TypeErased(_) => {
      return true;
    },
    typeinfo.TypeDyn(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_display_builtin(name: string): boolean {
  return name == "print" || name == "write" || name == "eprint";
}

function display_call_name(c: ast.ExprCall, s: Scope): string {
  if (c.args.len() != 1) {
    return "";
  }
  if let ast.ExprIdent(id) = c.callee {
    if (!is_display_builtin(id.name)) {
      return "";
    }
    if (s.has_sig(id.name)) {
      return "";
    }
    return id.name;
  }
  return "";
}

function display_rewrite(c: ast.ExprCall, nargs: ast.Expr[], s: Scope): ast.Expr[] {
  if (display_call_name(c, s).len() == 0) {
    return nargs;
  }
  let at = check_expr(c.args[0], s);
  if (display_unjudged(at) || !display_resolves(at, s)) {
    return nargs;
  }
  let ln = expr_line(c.args[0]);
  let cl = expr_col(c.args[0]);
  let callee: ast.Expr = ast.ExprFieldAccess { obj: nargs[0], field: "to_string", line: ln, col: cl, ty: "", const_read: false };
  return [ast.ExprCall { callee: callee, args: [], line: ln, col: cl, type_args: [], ty: "string" }];
}

function display_arg_diags(c: ast.ExprCall, s: Scope): util.Diag[] {
  let name = display_call_name(c, s);
  if (name.len() == 0) {
    return [];
  }
  let at = check_expr(c.args[0], s);
  if (display_unjudged(at) || display_resolves(at, s)) {
    return [];
  }
  let label = type_label(at);
  let advice = "give " + label + " a `to_string(): string` method, or " + util.derive_hint(display_dispatch_name(at), "cmp.Display", "cmp.Display");
  if (cmp_method_receiver(at) == "" || cmp_parts(at).is_some()) {
    advice = cmp_hint(at, "cmp.Display");
  }
  return [dg_at(
    "E038", "argument 1 to \"" + name + "\": " + label + " does not implement `Display` (no `to_string(): string` in scope) — " + advice,
    expr_line(c.args[0]), expr_col(c.args[0]),
  )];
}

const MAP_NEW_KEY: string = "map_new key";

const MAP_NEW_VALUE: string = "map_new value";

function unbound_column(t: typeinfo.Type, reason: string): boolean {
  if let typeinfo.TypeUnknown(u) = t {
    return u.reason == reason;
  }
  return false;
}

function map_method_column(t: typeinfo.Type, reason: string, name: string): typeinfo.Type {
  if (unbound_column(t, reason)) {
    return typeinfo.TypeErased { name: name };
  }
  return t;
}

function map_method_receiver(c: ast.ExprCall, recv_ty: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeMap(mr) = recv_ty {
    if ((unbound_column(mr.key, MAP_NEW_KEY) || unbound_column(mr.value, MAP_NEW_VALUE)) && !literal_insert(c)) {
      return t_map(map_method_column(mr.key, MAP_NEW_KEY, "K"), map_method_column(mr.value, MAP_NEW_VALUE, "V"));
    }
  }
  return recv_ty;
}

function map_source_receiver_missing(recv: typeinfo.Type, msig: MethodSig): boolean {
  if (parser.parse_type_ref(msig.receiver_type).args.len() == 0) {
    return false;
  }
  if let typeinfo.TypeMap(mt) = recv {
    return unbound_column(mt.key, MAP_NEW_KEY) || unbound_column(mt.value, MAP_NEW_VALUE);
  }
  return false;
}

function map_method_takes_key(method: string): boolean {
  return method == "insert" || method == "get_or" || method == "get" || method == "contains" || method == "remove";
}

function unbound_map_arg_diags(c: ast.ExprCall, method: string, mt: typeinfo.TypeMap, s: Scope, out: util.Diag[]): util.Diag[] {
  if (literal_insert(c) || c.args.len() == 0) {
    return out;
  }
  if (map_method_takes_key(method) && unbound_column(mt.key, MAP_NEW_KEY)) {
    out = out.append(dg_at("E038", "argument 1 to \"" + method + "\": expected K, got " + type_label(check_expr(c.args[0], s)), expr_line(c.args[0]), expr_col(c.args[0])));
  }
  let takes_value = (method == "insert" || method == "get_or") && c.args.len() == 2;
  if (takes_value && unbound_column(mt.value, MAP_NEW_VALUE)) {
    out = out.append(dg_at("E038", "argument 2 to \"" + method + "\": expected V, got " + type_label(check_expr(c.args[1], s)), expr_line(c.args[1]), expr_col(c.args[1])));
  }
  return out;
}

function map_arg_diags(c: ast.ExprCall, method: string, mt: typeinfo.TypeMap, s: Scope, out: util.Diag[]): util.Diag[] {
  let want = map_builtin_arity(method);
  if (want < 0) {
    if let Some(msig) = s.lookup_method(method, "Map") {
      let recv: typeinfo.Type = mt;
      if (map_source_receiver_missing(recv, msig)) {
        return out.append(dg_at("E043", "no method \"" + method + "\" on Map — \"" + method + "\" is declared for " + msig.receiver_type, c.line, c.col));
      }
      if (c.args.len() != msig.param_types.len()) {
        return out.append(dg_at("E004", util.arity_message("method \"" + method + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
      }
      out = util.append_diags(out, method_arg_diags(c, method, msig, recv, s));
      out = util.append_diags(out, method_type_arg_diags(c, method, msig, recv, s));
      return util.append_diags(out, uninferred_method_diags(c, "Map", method, msig, s));
    }
    return out;
  }
  if (want >= 0 && c.args.len() != want) {
    return out.append(dg_at("E004", util.arity_message("method \"" + method + "\"", want, c.args.len(), "argument"), c.line, c.col));
  }
  let slots = map_arg_slots(method, mt);
  if (slots.len() == 0 || c.args.len() != slots.len()) {
    return out;
  }
  let ii = 0;
  while (ii < slots.len()) {
    out = map_arg_diag(c, ii, method, slots[ii], s, out);
    ii += 1;
  }
  return out;
}

function map_arg_slots(method: string, mt: typeinfo.TypeMap): typeinfo.Type[] {
  if (method == "insert" || method == "get_or") {
    return [mt.key, mt.value];
  }
  if (method == "get" || method == "contains" || method == "remove") {
    return [mt.key];
  }
  return [];
}

function map_builtin_arity(method: string): i32 {
  if (method == "insert" || method == "get_or") {
    return 2;
  }
  if (method == "get" || method == "contains" || method == "remove") {
    return 1;
  }
  if (method == "len" || method == "cleared" || method == "keys" || method == "values") {
    return 0;
  }
  return -1;
}

function map_arg_diag(c: ast.ExprCall, ii: i32, method: string, slot: typeinfo.Type, s: Scope, out: util.Diag[]): util.Diag[] {
  let arg = c.args[ii];
  let it = check_expr(arg, s);
  let stores = method == "insert";
  let lent = !stores && view_arg_borrow(it, slot);
  let mismatch = stores && is_str_view(it) && is_owned_string(slot);
  if (!literal_insert(c) && !is_unknown(slot) && !is_unknown(it)) {
    out = util.append_diags(out, int_dest_range_diags(arg, slot));
    mismatch = !lent && !settles_to(arg, slot, s) && !coercible(it, slot, s);
  }
  if (mismatch) {
    out = out.append(dg_at("E038", "argument " + util.i32_to_string(ii + 1) + " to \"" + method + "\": expected " + type_label(slot) + ", got " + type_label(it) + str_copy_hint(it, slot), expr_line(arg), expr_col(arg)));
  }
  return out;
}

// variant_payload_dests is the payload types of a variant constructor whose
// expected type is an instance of its enum: `P[string]` for the argument of
// `Some(...)` where an `Option[P[string]]` is expected.
function variant_payload_dests(c: ast.ExprCall, dest: typeinfo.Type, s: Scope, dests: typeinfo.Type[]): typeinfo.Type[] {
  let ast.ExprIdent(id) = c.callee else {
    return dests;
  };
  let typeinfo.TypeUnion(du) = dest else {
    return dests;
  };
  if (s.ident_binding(id) >= 0) {
    return dests;
  }
  if (du.name == "Option" || du.name == "Result") {
    let slot = ctor_payload_slot(s, du.name, id.name, 0);
    if (slot < 0 || slot >= du.args.len() || parser.builtin_enum_of(id.name) != du.name) {
      return dests;
    }
    return [du.args[slot]];
  }
  let Some(u) = s.lookup_union(du.name) else {
    return dests;
  };
  if (u.type_params.len() == 0 || u.type_params.len() != du.args.len()) {
    return dests;
  }
  let Some(vs) = s.lookup_owned_struct(id.name, u.name) else {
    return dests;
  };
  if (vs.enum_owner != u.name) {
    return dests;
  }
  let out: typeinfo.Type[] = [];
  for n in vs.field_type_names {
    out = out.append(type_from_ref_subst(parser.parse_type_ref(n), u.type_params, du.args, s.type_names()));
  }
  return out;
}

function array_builtin_arity(method: string, view: boolean): i32 {
  if (method == "len") {
    return 0;
  }
  if (view) {
    return -1;
  }
  if (method == "with") {
    return 2;
  }
  if (method == "append" || method == "truncate") {
    return 1;
  }
  return -1;
}

function call_diags_call(c: ast.ExprCall, s: Scope, out: util.Diag[], dest: typeinfo.Type): util.Diag[] {
  out = util.append_diags(out, e032_call_check(c, s));
  match (c.callee) {
    ast.ExprFieldAccess(mfa) => {
      let cqen = qual_enum_name(mfa.obj, s);
      if (cqen.len() > 0 && !assoc_call_req(mfa.obj, mfa.field, s, mfa.const_read).found) {
        if (!qual_variant_exists(cqen, mfa.field, s)) {
          out = out.append(no_variant_diag(s, cqen, mfa.field, mfa.line, mfa.col));
        } else {
          out = util.append_diags(out, variant_ctor_diags(cqen + "." + mfa.field, c, s));
        }
        for arg in c.args {
          out = util.append_diags(out, call_diags(arg, s));
        }
        return out;
      }
      let ah = assoc_call_req(mfa.obj, mfa.field, s, mfa.const_read);
      if (ah.found) {
        let acr = assoc_const_read_diags(ah, c, mfa);
        if (acr.len() > 0) {
          return util.append_diags(out, acr);
        }
        for arg in c.args {
          out = util.append_diags(out, call_diags(arg, s));
        }
        return util.append_diags(out, assoc_arg_diags(ah, c, mfa, s));
      }
      if (mfa.const_read) {
        return out.append(dg_at("E043", util.demangle(assoc_base_name(mfa.obj)) + " has no associated constant \"" + mfa.field + "\"", c.line, c.col));
      }
      if let ast.ExprIdent(tid) = mfa.obj {
        if (!s.known(tid.name) && util.has_str(s.tparams, tid.name)) {
          out = out.append(tparam_assoc_diag(tid, mfa.field, s));
          for arg in c.args {
            out = util.append_diags(out, call_diags(arg, s));
          }
          return out;
        }
      }
      out = call_diags(mfa.obj, s);
      match (check_expr(mfa.obj, s)) {
        typeinfo.TypeTuple(mtt) => {
          let tdg = tuple_field_diags(mfa.field, mtt, mfa.line, mfa.col);
          if (s.lookup_method(mfa.field, parser.tuple_arity_namespace(mtt.elements.len())).is_some()) {
            tdg = [];
          }
          if (tdg.len() > 0) {
            return util.append_diags(out, tdg);
          }
        },
        _ => {}
      }
      if (mfa.field == "insert" && mlit_is_base(mfa.obj) && c.args.len() >= 1) {
        let kt = check_expr(c.args[0], s);
        let kmsg = map_key_type_error(s, kt);
        if (kmsg != "") {
          out = out.append(dg_at("E045", kmsg, expr_line(c.args[0]), expr_col(c.args[0])));
        }
      }
    },
    ast.ExprIdent(cid) => {
      if (!is_resolvable_value(cid.name, s)) {
        out = out.append(undefined_name(cid.name, s, cid.line, cid.col));
      }
      if (is_map_new_name(cid.name) && !s.module_imported("core/map")) {
        out = out.append(dg_at("E001", map_import_msg(), c.line, c.col));
      }
    },
    _ => {
      out = call_diags(c.callee, s);
    }
  }
  let dests = variant_payload_dests(c, dest, s, s.call_param_types(c));
  let di = 0;
  if (!s.callee_resolves(c)) {
    di = c.args.len();
  }
  while (di < c.args.len()) {
    let dest = t_unknown("no declared parameter");
    if (di < dests.len()) {
      dest = dests[di];
    }
    if (generic_fn_value_arg(c.args[di], s)) {
      dest = bound_param_dest(c, di, dest, s);
    }
    out = util.append_diags(out, dest_call_diags(c.args[di], dest, s));
    di += 1;
  }
  match (c.callee) {
    ast.ExprFieldAccess(_) => {},
    _ => {
      let calleet = check_expr(c.callee, s);
      let callee_is_fn = is_func_type(calleet);
      if (!is_unknown(calleet) && !callee_is_fn) {
        out = out.append(dg_at("E038", "calling non-function value of type " + type_label(calleet), c.line, c.col));
      }
    }
  }
  match (c.callee) {
    ast.ExprIdent(id) => {
      if ((id.name == "__set_field" || id.name == "__set_index") && c.args.len() == 2) {
        out = util.append_diags(out, place_assign_diags(c.args[0], c.args[1], c.line, c.col, s));
      }
      if (id.name == "cell_new" && c.args.len() == 1) {
        let cnat = check_expr(c.args[0], s);
        out = util.append_diags(out, e057_diag(type_label(named_tparams(cnat)), cnat, s, expr_line(c.args[0]), expr_col(c.args[0])));
      }

      if (scope_variant_owner(id.name, s).len() > 0 || parser.builtin_enum_of(id.name).len() > 0) {
        for arg in c.args {
          let unit_binding = false;
          if let ast.ExprIdent(_) = arg {
            unit_binding = true;
          }
          if (is_void(check_expr(arg, s)) && !parser.is_unit_expr(arg) && !unit_binding) {
            out = out.append(dg_at("E072", "a void expression is not a value here; call it as a statement, and write `()` if you meant the unit value", expr_line(arg), expr_col(arg)));
          }
        }
      }
      if (s.ident_binding(id) < 0) {
        if let Some(sig) = s.lookup_sig(id.name) {
          if (sig.all_type_params.len() > 0 && c.type_args.len() > 0 && c.type_args.len() != sig.all_type_params.len()) {
            out = out.append(dg_at("E040", util.arity_message(id.name, sig.all_type_params.len(), c.type_args.len(), "type argument"), c.line, c.col));
          } else if (c.type_args.len() > 0) {
            out = util.append_diags(out, const_arg_diags(sig, c, s));
          }
          if (c.args.len() != sig.param_types.len()) {
            out = out.append(dg_at("E004", util.arity_message(call_subject(c), sig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
          } else {
            let cbn: string[] = [];
            let cbt: typeinfo.Type[] = [];
            if (sig.all_type_params.len() > 0) {
              let (bn0, bt0) = call_type_bindings(sig, c, s);
              cbn = bn0;
              cbt = bt0;
            }
            let ai = 0;
            while (ai < c.args.len()) {
              let at = check_expr(c.args[ai], s);
              out = util.append_diags(out, int_dest_range_diags(c.args[ai], sig.param_types[ai]));
              out = util.append_diags(out, bound_type_arg_diags(sig, c, ai, at, s, cbn, cbt));
              out = util.append_diags(out, vec_arg_diags(sig, c, ai, at, s));
              out = util.append_diags(out, ctor_payload_diags(c.args[ai], sig.param_types[ai], s));
              let bound_checked = param_has_bindings(sig, ai, cbn);
              if (!bound_checked && !(sig.all_type_params.len() > 0 && type_contains_unknown(sig.param_types[ai]) && binds_nothing(c.args[ai], s)) && !is_unknown(at) && !is_unknown(sig.param_types[ai]) && !settles_to_dest(c.args[ai], sig.param_types[ai], s) && !view_arg_borrow(at, sig.param_types[ai]) && !coercible(at, sig.param_types[ai], s)) {
                out = out.append(dg_at("E038", arg_subject(c, ai + 1) + ": expected " + type_label(sig.param_types[ai]) + ", got " + argument_type_label(c.args[ai], at, s), expr_line(c.args[ai]), expr_col(c.args[ai])));
              }
              out = util.append_diags(out, array_elem_check(array_elem_type_of(sig.param_types[ai]), c.args[ai], s));
              ai += 1;
            }
            if (sig.all_type_params.len() > 0) {
              out = util.append_diags(out, call_bound_diags(sig.type_params, sig.type_bounds, sig.module, util.demangle(sig.name), cbn, cbt, s, c.line, c.col));
              let (fbn, fbt) = call_bindings(sig, c, s);
              out = util.append_diags(out, bound_arg_diags(sig, c, fbn, fbt, s));
              out = util.append_diags(out, uninferred_call_diags(sig, c, fbn, id.name, s, dest));
            }
          }
        } else {
          out = util.append_diags(out, callable_arg_diags(c, free_builtin_sig(id.name, s), s));
          out = util.append_diags(out, lane_index_diags(id.name, c));
          out = util.append_diags(out, display_arg_diags(c, s));
          if (is_display_builtin(id.name) && c.args.len() != 1) {
            out = out.append(dg_at("E004", util.arity_message(call_subject(c), 1, c.args.len(), "argument"), c.line, c.col));
          }
          out = util.append_diags(out, variant_ctor_diags(id.name, c, s));
        }
      } else {
        out = util.append_diags(out, callable_arg_diags(c, s.lookup(id.name), s));
      }
    },
    ast.ExprFieldAccess(mfa) => {
      let recv = check_expr(mfa.obj, s);
      match (recv) {
        typeinfo.TypeTuple(tup) => {
          if (tuple_element_field(recv, mfa.field)) {
            out = util.append_diags(out, callable_arg_diags(c, check_expr(c.callee, s), s));
          } else if let Some(tmsig) = s.lookup_method(mfa.field, parser.tuple_arity_namespace(tup.elements.len())) {
            if (c.args.len() != tmsig.param_types.len()) {
              out = out.append(dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", tmsig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
            } else {
              out = util.append_diags(out, method_arg_diags(c, mfa.field, tmsig, recv, s));
              out = util.append_diags(out, method_type_arg_diags(c, mfa.field, tmsig, recv, s));
            }
          }
        },
        typeinfo.TypeI32(it) => {
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice(int_label(it), mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, int_label(it), mfa.field, s));
        },
        typeinfo.TypeFloat(f) => {
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice(float_label(f), mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, float_label(f), mfa.field, s));
        },
        typeinfo.TypeBool(_) => {
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("boolean", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, "boolean", mfa.field, s));
        },
        typeinfo.TypeLanes(l) => {
          let lanes = typeinfo.lanes_spelling(l.width);
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice(lanes, mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, lanes, mfa.field, s));
        },
        typeinfo.TypeString(_) => {
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("string", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, "string", mfa.field, s));
        },
        typeinfo.TypeArray(ar) => {
          if (!ar.view && mfa.field == "append" && c.args.len() == 1 && !is_unknown(ar.elem)) {
            let aat = check_expr(c.args[0], s);
            out = util.append_diags(out, int_dest_range_diags(c.args[0], ar.elem));
            if (!is_unknown(aat) && !settles_to_dest(c.args[0], ar.elem, s) && !coercible(aat, ar.elem, s)) {
              out = out.append(dg_at("E038", "argument 1 to \"append\": expected " + type_label(ar.elem) + ", got " + type_label(aat) + str_copy_hint(aat, ar.elem), expr_line(c.args[0]), expr_col(c.args[0])));
            }
            out = util.append_diags(out, array_elem_check(array_elem_type_of(ar.elem), c.args[0], s));
          }
          if (!ar.view && mfa.field == "with" && c.args.len() == 2 && !is_unknown(ar.elem)) {
            let wit = check_expr(c.args[0], s);
            if (!is_unknown(wit) && !settles_to_dest(c.args[0], t_i32(), s) && !coercible(wit, t_i32(), s)) {
              out = out.append(dg_at("E038", "argument 1 to \"with\": expected i32, got " + type_label(wit), expr_line(c.args[0]), expr_col(c.args[0])));
            }
            let wvt = check_expr(c.args[1], s);
            out = util.append_diags(out, int_dest_range_diags(c.args[1], ar.elem));
            if (!is_unknown(wvt) && !settles_to_dest(c.args[1], ar.elem, s) && !coercible(wvt, ar.elem, s)) {
              out = out.append(dg_at("E038", "argument 2 to \"with\": expected " + type_label(ar.elem) + ", got " + type_label(wvt) + str_copy_hint(wvt, ar.elem), expr_line(c.args[1]), expr_col(c.args[1])));
            }
            out = util.append_diags(out, array_elem_check(array_elem_type_of(ar.elem), c.args[1], s));
          }
          if (!ar.view && mfa.field == "truncate" && c.args.len() == 1) {
            let tnt = check_expr(c.args[0], s);
            if (!is_unknown(tnt) && !settles_to_dest(c.args[0], t_i32(), s) && !coercible(tnt, t_i32(), s)) {
              out = out.append(dg_at("E038", "argument 1 to \"truncate\": expected i32, got " + type_label(tnt), expr_line(c.args[0]), expr_col(c.args[0])));
            }
          }
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("Array", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          let arr_label = "Array";
          if (ar.view) {
            arr_label = "slice";
          }
          let avk = 0;
          if (ar.view) {
            avk = 1;
          }
          out = util.append_diags(out, inherent_tie_diags(mfa, "", avk, s));
          if let Some(asig) = s.array_recv_method(mfa.field, ar.view) {
            out = util.append_diags(out, uninferred_method_diags(c, arr_label, mfa.field, asig, s));
            if (c.args.len() == asig.param_types.len()) {
              out = util.append_diags(out, method_arg_diags(c, mfa.field, asig, recv, s));
              out = util.append_diags(out, method_type_arg_diags(c, mfa.field, asig, recv, s));
            }
          }
          let abw = array_builtin_arity(mfa.field, ar.view);
          if (abw >= 0 && c.args.len() != abw) {
            out = out.append(dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", abw, c.args.len(), "argument"), c.line, c.col));
          }
        },
        typeinfo.TypeMap(mt) => {
          out = map_arg_diags(c, mfa.field, mt, s, out);
          out = unbound_map_arg_diags(c, mfa.field, mt, s, out);
          out = util.append_diags(out, map_method_arg_diags(c, recv, mfa.field, s));
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_message("Map", mfa.field, "Map", recv), mfa.line, mfa.col), mfa, recv));
          }
        },
        typeinfo.TypeDyn(d) => {
          out = util.append_diags(out, dyn_call_diags(c, mfa, d.traits, s));
        },
        typeinfo.TypeStruct(sn) => {
          if (is_cell_type(recv)) {
            out = util.append_diags(out, cell_call_diags(c, mfa, recv, s));
          } else {
            out = util.append_diags(out, ambiguous_call_diags(mfa, sn.name, s));
            out = util.append_diags(out, inherent_tie_diags(mfa, sn.name, -1, s));
            out = util.append_diags(out, finalizer_call_diags(mfa, sn.name, s));
            if let Some(msig) = s.scoped_method(mfa.field, sn.name) {
              if (c.args.len() != msig.param_types.len()) {
                out = out.append(dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
              } else {
                out = util.append_diags(out, method_arg_diags(c, mfa.field, msig, recv, s));
                out = util.append_diags(out, method_type_arg_diags(c, mfa.field, msig, recv, s));
                out = util.append_diags(out, uninferred_method_diags(c, sn.name, mfa.field, msig, s));
                out = util.append_diags(out, uninferred_recv_diags(c, sn.name, mfa.field, msig, sn.args, s));
              }
            } else {
              let bms = builtin_method_sig(sn.name, mfa.field);
              if (!is_unknown(bms)) {
                out = util.append_diags(out, callable_arg_diags(c, bms, s));
              } else if let Some(fsig) = s.lookup_struct(sn.name) {
                let fldi = field_index(fsig, mfa.field);
                if (fldi < 0) {
                  out = out.append(s.member_fix(dg_at("E043", "struct " + util.demangle(sn.name) + " has no field or method \"" + mfa.field + "\"" + s.private_method_note(sn.name, mfa.field), mfa.line, mfa.col), mfa, fsig));
                } else {
                  let fldt = field_access_result_type(mfa, sn, s);
                  let fld_is_fn = false;
                  match (fldt) {
                    typeinfo.TypeFunc(_) => {
                      fld_is_fn = true;
                    },
                    _ => {}
                  }
                  if (!fld_is_fn) {
                    out = out.append(dg_at("E038", "calling non-function value of type " + type_label(fldt), mfa.line, mfa.col));
                  } else {
                    out = util.append_diags(out, callable_arg_diags(c, check_expr(c.callee, s), s));
                  }
                }
              }
            }
          }
        },
        typeinfo.TypeUnion(un) => {
          out = util.append_diags(out, ambiguous_call_diags(mfa, un.name, s));
          out = util.append_diags(out, inherent_tie_diags(mfa, un.name, -1, s));
          out = util.append_diags(out, finalizer_call_diags(mfa, un.name, s));
          if let Some(umsig) = s.lookup_method(mfa.field, un.name) {
            if (c.args.len() == umsig.param_types.len()) {
              out = util.append_diags(out, method_arg_diags(c, mfa.field, umsig, recv, s));
              out = util.append_diags(out, method_type_arg_diags(c, mfa.field, umsig, recv, s));
              out = util.append_diags(out, uninferred_method_diags(c, un.name, mfa.field, umsig, s));
              out = util.append_diags(out, uninferred_recv_diags(c, un.name, mfa.field, umsig, un.args, s));
            }
          }
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
        },
        _ => {
          // A rejected initializer does not retain an array receiver for later calls.
          if (unbound_column(recv, ARRAY_TUPLE_UNRESOLVED)) {
            out = out.append(dg_at("E043", "no method \"" + mfa.field + "\" on unresolved array", mfa.line, mfa.col));
          }
          out = util.append_diags(out, type_param_method_diags(c, mfa, recv, s));
        }
      }
    },
    _ => {
      out = util.append_diags(out, callable_arg_diags(c, check_expr(c.callee, s), s));
    }
  }

  return out;
}

function type_param_method_diags(c: ast.ExprCall, mfa: ast.ExprFieldAccess, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let tpn = tp_receiver(recv, s);
  if (tpn.len() > 0) {
    let tph = tp_assoc_req(s, tpn, mfa.field);
    if (tph.found) {
      out = out.append(dg_at("E021", "\"" + mfa.field + "\" is an associated function of trait " + tph.owner + ", not a method; call it as " + tpn + "." + mfa.field + "(...)", c.line, c.col));
    } else if (!tp_bound_provides(s, tpn, mfa.field) && util.str_has_prefix(tpn, "Vec[")) {
      out = out.append(dg_at("E021", "no method \"" + mfa.field + "\" on " + tpn + ": no trait that every lane type it can be implements provides it", c.line, c.col));
    } else if (!tp_bound_provides(s, tpn, mfa.field)) {
      out = out.append(dg_at("E021", "no method \"" + mfa.field + "\" on type parameter " + tpn + "; add a trait bound such as [" + tpn + ": SomeTrait] that provides it", c.line, c.col));
    } else {
      match (bound_method(s, tpn, mfa.field)) {
        Some(msig) => {
          if (c.args.len() != msig.param_types.len()) {
            out = out.append(dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
          } else {
            out = util.append_diags(out, method_arg_diags(c, mfa.field, msig, recv, s));
            out = util.append_diags(out, method_type_arg_diags(c, mfa.field, msig, recv, s));
          }
        },
        None => {}
      }
    }
  }
  return out;
}

function binop_lit_range_diags(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): util.Diag[] {
  let out: util.Diag[] = [];
  if (!is_integer(lt) || !is_integer(rt)) {
    return out;
  }
  if (int_literal_tree(b.left) && !int_literal_tree(b.right)) {
    return int_dest_range_diags(b.left, rt);
  }
  if (int_literal_tree(b.right) && !int_literal_tree(b.left)) {
    return int_dest_range_diags(b.right, lt);
  }
  return out;
}

function tvar_operator_diags(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): util.Diag[] {
  let method = tvar_operator_method(b.op);
  if (method == "-") {
    return [];
  }
  for side in [lt, rt] {
    let name = unmet_tvar(side, method, s);
    if (name != "") {
      return [dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + name, b.line, b.col)];
    }
  }
  let ln = unmet_tvar(lt, "", s);
  let rn = unmet_tvar(rt, "", s);
  if (ln != rn && !is_unknown(lt) && !is_unknown(rt)) {
    let name = ln;
    if (name == "") {
      name = rn;
    }
    return [dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + name, b.line, b.col)];
  }
  return [];
}

function tvar_operator_method(op: string): string {
  if (op == "<" || op == "<=" || op == ">" || op == ">=") {
    return "cmp";
  }
  let method = ast.operator_method(op);
  if (method != "" || util.has_str(["+|", "-|", "*|", "<<|", "+?", "-?", "*?", "/?", "%?", "<<?", ">>?"], op)) {
    return method;
  }
  return "-";
}

function unmet_tvar(t: typeinfo.Type, method: string, s: Scope): string {
  let name = "";
  if let typeinfo.TypeErased(e) = t {
    name = e.name;
  }
  if (name == "" || !util.has_str(s.tparams, name)) {
    return "";
  }
  if (method != "" && tp_bound_provides(s, name, method)) {
    return "";
  }
  return name;
}

function tvar_neg_diags(u: ast.ExprUnary, s: Scope): util.Diag[] {
  if (u.op != "-") {
    return [];
  }
  let name = unmet_tvar(check_expr(u.operand, s), "neg", s);
  if (name == "") {
    return [];
  }
  return [dg_at("E009", "operator \"-\" requires an integer type, got " + name, u.line, u.col)];
}

function call_diags_binary(b: ast.ExprBinary, s: Scope, out: util.Diag[]): util.Diag[] {
  if (b.op == "__named_arg") {
    return util.append_diags(out, call_diags(b.right, s));
  }
  let (diags, bt) = binary_diags_typed(b, s);
  return diags;
}

function operand_diags_typed(e: ast.Expr, s: Scope): (util.Diag[], typeinfo.Type) {
  if let ast.ExprBinary(b) = e {
    if (b.op != "__named_arg") {
      return binary_diags_typed(b, s);
    }
  }
  return (call_diags(e, s), check_expr(e, s));
}

function lanes_operator_diags(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): util.Diag[] {
  if (util.has_str(["==", "!=", "<", ">", "<=", ">="], b.op)) {
    let lanes = type_label(lt);
    if (!is_lanes(lt)) {
      lanes = type_label(rt);
    }
    return [dg_at("E041", "cannot compare values of type " + lanes + " with \"" + b.op + "\": a lane value compares lane by lane, through __" + lanes + "_lt and __" + lanes + "_ne", b.line, b.col)];
  }
  if (util.has_str(["+", "-", "*", "/"], b.op) && type_eq(lt, rt)) {
    return [];
  }
  if (operand_open(lt) || operand_open(rt)) {
    return [];
  }
  let what = "numeric";
  if (b.op == "+") {
    what = "numeric or string";
  }
  return [dg_at("E009", "operator \"" + b.op + "\" requires matching " + what + " operands, got " + type_label(lt) + " and " + type_label(rt), b.line, b.col)];
}

function binary_diags_typed(b: ast.ExprBinary, s: Scope): (util.Diag[], typeinfo.Type) {
  let (ldiags, blt) = operand_diags_typed(b.left, s);
  let (rdiags, brt) = operand_diags_typed(b.right, s);
  let out = util.append_diags(ldiags, rdiags);
  out = util.append_diags(out, binop_lit_range_diags(b, blt, brt));
  out = util.append_diags(out, tvar_operator_diags(b, blt, brt, s));
  if (is_lanes(blt) || is_lanes(brt)) {
    return (util.append_diags(out, lanes_operator_diags(b, blt, brt)), binary_result_type(b, blt, brt, s));
  }
  if (b.op == "&&" || b.op == "||") {
    if (!is_unknown(blt) && !type_eq(blt, t_bool())) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires boolean, got " + type_label(blt), b.line, b.col));
    }
    if (!is_unknown(brt) && !type_eq(brt, t_bool())) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires boolean, got " + type_label(brt), b.line, b.col));
    }
  }
  if (b.op == "==" || b.op == "!=") {
    let eq_widths: boolean = (type_eq(blt, brt) || !is_unknown(scalar_numeric_join(blt, brt))
      || settles_to(b.left, brt, s) || settles_to(b.right, blt, s)) && same_views(blt, brt);
    if (!is_unknown(blt) && !is_unknown(brt) && !eq_widths) {
      out = out.append(dg_at("E041", "cannot compare " + type_label(blt) + " with " + type_label(brt) + ": both sides of \"" + b.op + "\" must have the same type", b.line, b.col));
    } else if (!is_unknown(blt) && eq_widths && is_composite_type(blt) && !s.has_cmp_method("eq", blt)) {
      out = out.append(dg_at("E041", "cannot compare values of type " + util.demangle(type_label(blt)) + " with \"" + b.op + "\": type does not implement `Eq` — " + cmp_hint(blt, "cmp.Eq") + ", so `==` can use structural equality", b.line, b.col));
    }
  }
  if (b.op == "+") {
    let (pl, pr) = settled_operands(b, blt, brt);
    if (!operand_open(pl) && !operand_open(pr)) {
      let oks = type_eq(pl, t_string()) && type_eq(pr, t_string());
      let both_int = is_integer(pl) && is_integer(pr);
      let oki2 = both_int && int_operands_agree(pl, pr, b.left, b.right);
      let okf2 = float_operands_agree(pl, pr);
      let okov2 = !is_unknown(s.binop_overload_ret(b.op, pl));
      if (!oks && !oki2 && !okf2 && !okov2) {
        if (both_int) {
          out = out.append(mixed_int_diag(b.op, pl, pr, b.line, b.col));
        } else {
          out = util.append_diags(out, numeric_operand_diags(b.op, pl, pr, b.line, b.col));
        }
      }
    }
  }
  if (b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%") {
    let (alt, art) = settled_operands(b, blt, brt);
    if (!operand_open(alt) && !operand_open(art)) {
      let a_both_int = is_integer(alt) && is_integer(art);
      let oki = a_both_int && int_operands_agree(alt, art, b.left, b.right);
      let okf = b.op != "%" && float_operands_agree(alt, art);
      let okov = !is_unknown(s.binop_overload_ret(b.op, alt));
      if (!oki && !okf && !okov) {
        if (a_both_int) {
          out = out.append(mixed_int_diag(b.op, alt, art, b.line, b.col));
        } else {
          out = util.append_diags(out, numeric_operand_diags(b.op, alt, art, b.line, b.col));
        }
      }
    }
  }
  if (b.op == "+|" || b.op == "-|" || b.op == "*|" || b.op == "<<|") {
    if (!operand_open(blt) && !operand_open(brt)) {
      if (!is_integer(blt) || !is_integer(brt)) {
        out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires matching integer operands, got " + type_label(blt) + " and " + type_label(brt), b.line, b.col));
      } else if (is_usize(blt) || is_usize(brt)) {
        out = out.append(dg_at("E009", "saturating operator \"" + b.op + "\" is not supported on `usize` — its clamp bounds are target-width-dependent; cast to a fixed-width integer (`as u64`) first", b.line, b.col));
      } else if (!int_operands_agree(blt, brt, b.left, b.right)) {
        out = out.append(mixed_int_diag(b.op, blt, brt, b.line, b.col));
      }
    }
  }
  if (b.op == "+?" || b.op == "-?" || b.op == "*?" || b.op == "/?" || b.op == "%?" || b.op == "<<?" || b.op == ">>?") {
    if (!operand_open(blt) && !operand_open(brt)) {
      if (!is_integer(blt) || !is_integer(brt)) {
        out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires matching integer operands, got " + type_label(blt) + " and " + type_label(brt), b.line, b.col));
      } else if (is_usize(blt) || is_usize(brt)) {
        out = out.append(dg_at("E009", "checked operator \"" + b.op + "\" is not supported on `usize` — its overflow bound is target-width-dependent; cast to a fixed-width integer (`as u64`) first", b.line, b.col));
      } else if (!int_operands_agree(blt, brt, b.left, b.right)) {
        out = out.append(mixed_int_diag(b.op, blt, brt, b.line, b.col));
      }
    }
  }
  if (b.op == "<<" || b.op == ">>" || b.op == "&" || b.op == "|" || b.op == "^") {
    let sov = !is_unknown(s.binop_overload_ret(b.op, blt));
    if (!sov && !operand_open(blt) && !is_integer(blt)) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + type_label(blt), b.line, b.col));
    } else if (!sov && !operand_open(brt) && !is_integer(brt)) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + type_label(brt), b.line, b.col));
    } else if (!sov && !operand_open(blt) && !operand_open(brt) && !int_operands_agree(blt, brt, b.left, b.right)) {
      out = out.append(mixed_int_diag(b.op, blt, brt, b.line, b.col));
    }
  }
  if (b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") {
    let (olt, ort) = settled_operands(b, blt, brt);
    if (!operand_open(olt) && !operand_open(ort)) {
      let o_both_int = is_integer(olt) && is_integer(ort);
      let oki_o = o_both_int && int_operands_agree(olt, ort, b.left, b.right);
      let okf_o = float_operands_agree(olt, ort);
      let oks_o = type_eq(olt, t_string()) && type_eq(ort, t_string());
      let okc_o = type_eq(olt, t_char()) && type_eq(ort, t_char());
      if (!oki_o && !okf_o && !oks_o && !okc_o) {
        if (type_eq(olt, ort) && is_composite_type(olt)) {
          if (!s.has_cmp_method("cmp", olt)) {
            out = out.append(dg_at("E041", "cannot order values of type " + util.demangle(type_label(olt)) + " with \"" + b.op + "\": type does not implement `Ord` — " + cmp_hint(olt, "cmp.Ord") + ", so ordering can use structural comparison", b.line, b.col));
          }
        } else if (o_both_int) {
          out = out.append(mixed_int_diag(b.op, olt, ort, b.line, b.col));
        } else {
          out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires matching numeric or string operands, got " + type_label(olt) + " and " + type_label(ort), b.line, b.col));
        }
      }
    }
  }

  return (out, binary_result_type(b, blt, brt, s));
}

function bitwise_not_type(ot: typeinfo.Type): typeinfo.Type {
  if (is_integer(ot)) {
    return ot;
  }
  return t_unknown("unary `~` requires an integer operand");
}

// `~` takes an integer operand.
function bitwise_not_diags(u: ast.ExprUnary, s: Scope, own out: util.Diag[]): util.Diag[] {
  if (u.op != "~") {
    return out;
  }
  let bt = check_expr(u.operand, s);
  if (!operand_open(bt) && !is_integer(bt)) {
    return out.append(dg_at("E009", "operator \"~\" requires an integer type, got " + type_label(bt), u.line, u.col));
  }
  return out;
}

function call_diags_unary(u: ast.ExprUnary, s: Scope, out: util.Diag[]): util.Diag[] {
  out = call_diags(u.operand, s);
  if (u.op == "!") {
    let ot = check_expr(u.operand, s);
    if (!is_unknown(ot) && !type_eq(ot, t_bool())) {
      out = out.append(dg_at("E009", "operator \"!\" requires boolean, got " + type_label(ot), u.line, u.col));
    }
  }
  out = util.append_diags(out, tvar_neg_diags(u, s));
  out = bitwise_not_diags(u, s, out);
  if (u.op == "-") {
    let nt = check_expr(u.operand, s);
    let nok = !is_unknown(s.unop_overload_ret(u.op, nt));
    if (!operand_open(nt) && !is_integer(nt) && !is_float(nt) && !is_lanes(nt) && !nok) {
      out = out.append(dg_at("E009", "operator \"-\" requires an integer type, got " + type_label(nt), u.line, u.col));
    }
  }
  if (u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as_") {
    if (u.op == "as_char") {
      match (u.operand) {
        ast.ExprNumber(cn) => {
          if (!cn.is_float && !lit_is_scalar_value(cn.text)) {
            out = out.append(dg_at("E071", lit_scalar_msg(cn.text), u.line, u.col));
          }
        },
        _ => {}
      }
    }
    let target_errors = cast_target_diags(slice_unchecked(u.op, 3, u.op.len()) + "", u, s);
    if (target_errors.len() > 0) {
      return util.append_diags(out, target_errors);
    }
    let tgt = s.resolve_type(slice_unchecked(u.op, 3, u.op.len()) + "");
    if (bare_numeric_literal(u.operand)) {
      out = util.append_diags(out, int_dest_range_diags(u.operand, tgt));
    }
    out = util.append_diags(out, cast_diags(u, tgt, check_expr(u.operand, s), s));
  }
  if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
    let aot = check_expr(u.operand, s);
    let target = slice_unchecked(u.op, 4, u.op.len()) + "";
    let target_errors = cast_target_diags(target, u, s);
    if (target_errors.len() > 0) {
      return util.append_diags(out, target_errors);
    }
    if (is_integer(aot)) {
      if (!is_integer(s.resolve_type(target))) {
        out = out.append(dg_at("E060", "'as?' from " + type_label(aot) + " converts only to an integer type, got " + target, u.line, u.col));
      }
    } else if (!downcast_operand_ok(aot)) {
      out = out.append(dg_at("E059", "'as?' requires a 'dyn Trait' value or an integer on the left, got " + type_label(aot), u.line, u.col));
    }
  }
  if (u.op == "try_") {
    let trt = check_expr(u.operand, s);
    if (is_primitive_type(trt)) {
      out = out.append(dg_at("E042", "`?` operator requires an Option, a Result, or an `@try` enum, got " + type_label(trt), u.line, u.col));
    } else {
      match (trt) {
        typeinfo.TypeUnion(tu) => {
          if (try_able_union(s, tu.name)) {
            if (try_ret_other_type(s.try_ret, tu.name)) {
              out = out.append(dg_at("E042", "`?` on " + tu.name + " requires the surrounding function to return " + tu.name + ", got " + try_ret_label(s.try_ret), u.line, u.col));
            } else {
              out = util.append_diags(out, try_residual_diags(s, trt, u));
            }
          } else {
            if (s.has_union(tu.name)) {
              out = out.append(dg_at("E042", "`?` operator requires an Option, a Result, or an `@try` enum, got " + tu.name + " — mark it `@try` to make it one", u.line, u.col));
            }
          }
        },
        _ => {}
      }
    }
  }

  return out;
}

function cast_target_diags(target: string, u: ast.ExprUnary, s: Scope): util.Diag[] {
  let traits: string[] = [];
  for req in s.trait_reqs {
    traits = traits.append(req.trait_name);
    if (req.module.len() > 0) {
      traits = traits.append(req.module + "__" + req.trait_name);
    }
  }
  let missing = e064_unknown_name(target, s.type_names(), traits, s.tparams);
  if (missing.len() > 0) {
    return [unknown_type_diag(missing, traits, u.line, u.col)];
  }
  return [];
}

function cast_diags(u: ast.ExprUnary, tgt: typeinfo.Type, cot: typeinfo.Type, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  if (is_primitive_type(tgt) && is_primitive_type(cot)) {
    return primitive_cast_diags(u, tgt, cot, s);
  }
  let unresolved = unresolved_cast_diags(u, tgt, cot, s);
  if (unresolved.len() > 0) {
    return unresolved;
  }
  if (type_contains_unknown(tgt) || type_contains_unknown(cot)) {
    return none;
  }
  if (heap_pointer_cast(cot, tgt)) {
    if (cast_pointer_int(cot) && !is_usize(cot)) {
      return [e069_cast(u, cot, tgt)];
    }
    return pointer_cast_diags(u, cot, tgt, s);
  }
  if (!coercible(cot, tgt, s)) {
    return [e033_cast(u, cot, tgt)];
  }
  return none;
}

function primitive_cast_diags(u: ast.ExprUnary, tgt: typeinfo.Type, cot: typeinfo.Type, s: Scope): util.Diag[] {
  if (type_eq(tgt, t_string()) && cast_pointer_int(cot) && !is_usize(cot)) {
    return [e069_cast(u, cot, tgt)];
  }
  if (!as_cast_allowed(cot, tgt)) {
    return [e033_cast(u, cot, tgt)];
  }
  if (type_eq(tgt, t_string()) && cast_pointer_int(cot) || type_eq(cot, t_string()) && cast_pointer_int(tgt)) {
    return pointer_cast_diags(u, cot, tgt, s);
  }
  return [];
}

function heap_pointer_cast(cot: typeinfo.Type, tgt: typeinfo.Type): boolean {
  return cast_pointer_int(cot) && cast_pointer_shaped(tgt, false) || cast_pointer_int(tgt) && cast_pointer_shaped(cot, true);
}

// A cast between an integer and a heap value reads or forges an address.
function pointer_cast_diags(u: ast.ExprUnary, cot: typeinfo.Type, tgt: typeinfo.Type, s: Scope): util.Diag[] {
  if (s.in_unsafe || s.sigs.raw_allowed) {
    return [];
  }
  return [dg_at("E095", "the cast from " + type_label(cot) + " to " + type_label(tgt) + " reinterprets a pointer outside an unsafe block", u.line, u.col)];
}

function unresolved_cast_diags(u: ast.ExprUnary, tgt: typeinfo.Type, cot: typeinfo.Type, s: Scope): util.Diag[] {
  if let typeinfo.TypeUnknown(tu) = tgt {
    let name = typevar_reason_name(tu.reason);
    if (util.str_has_prefix(tu.reason, UNRESOLVED_MARK) && !util.has_str(s.tparams, name) && cast_pointer_int(cot) && !is_usize(cot)) {
      return [e069_cast(u, cot, t_struct(name))];
    }
  }
  return [];
}

function e069_cast(u: ast.ExprUnary, cot: typeinfo.Type, tgt: typeinfo.Type): util.Diag {
  return dg_at("E069", "reinterpreting a 32-bit " + type_label(cot) + " value as the pointer-shaped type " + type_label(tgt) + " via `as` truncates the address; carry pointer-shaped values in a usize local/param instead", u.line, u.col);
}

function e033_cast(u: ast.ExprUnary, cot: typeinfo.Type, tgt: typeinfo.Type): util.Diag {
  return dg_at("E033", "cannot cast " + type_label(cot) + " to " + type_label(tgt) + ": `as` converts only between numeric types", u.line, u.col);
}

function try_ret_other_type(ret: typeinfo.Type, name: string): boolean {
  if (is_type_variable(ret)) {
    return true;
  }
  match (ret) {
    typeinfo.TypeUnion(ru) => {
      return ru.name != name;
    },
    typeinfo.TypeVoid(_) => {
      return true;
    },
    _ => {
      return spellable(ret);
    }
  }
  return false;
}

function try_ret_label(ret: typeinfo.Type): string {
  if (is_type_variable(ret)) {
    return callable_typevar_name(ret);
  }
  return type_label(ret);
}

function try_residual_diags(s: Scope, src: typeinfo.Type, u: ast.ExprUnary): util.Diag[] {
  let out: util.Diag[] = [];
  let sr = result_residual(src);
  let rr = result_residual(s.try_ret);
  if (!spellable(sr) || !spellable(rr) || type_eq(sr, rr)) {
    return out;
  }
  let sl = type_label(sr);
  let rl = type_label(rr);
  if let typeinfo.TypeDyn(d) = rr {
    if (dyn_conforms(sr, rr, s)) {
      return out;
    }
    return out.append(dg_at("E042", "`?` cannot box " + sl + " into " + rl + ": " + sl + " does not implement " + unimplemented_traits(s, sr, d.traits), u.line, u.col));
  }
  if (from_converts(s, sr, rr)) {
    return out;
  }
  return out.append(dg_at("E042", "`?` on Result carrying " + sl + " but the surrounding function carries " + rl + ", and " + rl + " has no `from(" + sl + ")` constructor to convert it (core/convert's `impl From[" + sl + "] for " + rl + "`)", u.line, u.col));
}

function unimplemented_traits(s: Scope, src: typeinfo.Type, traits: string): string {
  let set = parser.dyn_trait_set("dyn " + traits);
  if (is_owned_array(src) || is_arr_view(src) || is_dyn_slot(src)) {
    return set[0];
  }
  let tn = util.base_type_name(type_label(src));
  let missing = "";
  for tr in set {
    if (!conforms_to_dyn_trait(s, tn, tr)) {
      if (missing.len() > 0) {
        missing += " + ";
      }
      missing += tr;
    }
  }
  if (missing.len() == 0) {
    return set[0];
  }
  return missing;
}

function result_residual(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(tu) = t {
    if (tu.name == "Result" && tu.args.len() == 2) {
      return tu.args[1];
    }
  }
  return t_unknown("not a Result");
}

function from_converts(s: Scope, from_t: typeinfo.Type, to: typeinfo.Type): boolean {
  let owner = struct_name_of(to);
  if let typeinfo.TypeUnion(tu) = to {
    owner = tu.name;
  }
  if (owner.len() == 0) {
    return false;
  }
  let Some(sig) = s.lookup_assoc_sig(owner, "from") else {
    return false;
  };
  if (sig.param_types.len() != 1) {
    return false;
  }
  return !spellable(sig.param_types[0]) || type_eq(sig.param_types[0], from_t);
}

function call_diags_array(a: ast.ExprArray, s: Scope, out: util.Diag[]): util.Diag[] {
  for element in a.elements {
    out = util.append_diags(out, call_diags(element, s));
  }
  return array_mix_diags(a, s, out);
}

function array_mix_diags(a: ast.ExprArray, s: Scope, out: util.Diag[]): util.Diag[] {
  if (a.elements.len() >= 2) {
    let anchor = check_expr(a.elements[0], s);
    if (type_contains_unknown(anchor)) {
      for index in 1..a.elements.len() {
        let candidate = check_expr(a.elements[index], s);
        if (!type_contains_unknown(candidate)) {
          if (!array_mix_settles(a.elements[0], anchor, candidate, s)) {
            return out.append(dg_at("E034", "array element: expected " + type_label(anchor) + ", got " + type_label(candidate), expr_line(a.elements[index]), expr_col(a.elements[index])));
          }
          let anchored: ast.Expr[] = [a.elements[index]];
          for other in 0..a.elements.len() {
            if (other != index) {
              anchored = anchored.append(a.elements[other]);
            }
          }
          return array_mix_diags(ast.ExprArray { ...a, elements: anchored }, s, out);
        }
      }
      return out;
    }
    if (is_primitive_type(anchor) || is_func_type(anchor) || is_tuple_type(anchor)) {
      out = scalar_array_mix(a, anchor, s, out);
    } else if (concrete_instance(anchor)) {
      out = struct_instance_mix(a, anchor, s, out);
    } else if (is_owned_array(anchor) || is_arr_view(anchor) || struct_name_of(anchor).len() > 0) {
      out = element_mix(a, anchor, s, out);
    }
  }

  return out;
}

function scalar_array_mix(a: ast.ExprArray, anchor: typeinfo.Type, s: Scope, out: util.Diag[]): util.Diag[] {
  let anchor_lit = numeric_literal_kind(a.elements[0]);
  let k = 1;
  while (k < a.elements.len()) {
    let etk = check_expr(a.elements[k], s);
    let scalar = scalar_numeric_join(anchor, etk);
    if (!is_unknown(scalar) && anchor_lit == 0 && lit_kind_settled(a.elements[k])) {
      anchor = scalar;
      anchor_lit = 0;
      k += 1;
      continue;
    }
    let lit = numeric_literal_kind(a.elements[k]);
    if (!type_contains_unknown(etk) && !literal_gives_way(lit, anchor)) {
      if (same_element_type(etk, anchor) && (!is_tuple_type(anchor) || type_assignable(etk, anchor, s.unions.unions)) || literal_gives_way(anchor_lit, etk)) {
        anchor = etk;
        anchor_lit = lit;
      } else {
        return out.append(dg_at("E034", "array element: expected " + type_label(anchor) + ", got " + type_label(etk), expr_line(a.elements[k]), expr_col(a.elements[k])));
      }
    }
    k += 1;
  }
  return out;
}

function element_mix(a: ast.ExprArray, anchor: typeinfo.Type, s: Scope, out: util.Diag[]): util.Diag[] {
  let first = a.elements[0];
  let k = 1;
  while (k < a.elements.len()) {
    let element = a.elements[k];
    let ty = check_expr(element, s);
    if (!type_contains_unknown(ty) && (!same_element_type(ty, anchor) || !type_assignable(ty, anchor, s.unions.unions)) && !array_mix_settles(element, ty, anchor, s)) {
      if (!array_mix_settles(first, check_expr(first, s), ty, s)) {
        return out.append(dg_at("E034", "array element: expected " + type_label(anchor) + ", got " + type_label(ty), expr_line(element), expr_col(element)));
      }
      anchor = ty;
      first = element;
    }
    k += 1;
  }
  return out;
}

function array_mix_settles(e: ast.Expr, have: typeinfo.Type, want: typeinfo.Type, s: Scope): boolean {
  if (!view_free_settle(e, want, s)) {
    return false;
  }
  if let ast.ExprArray(a) = e {
    if let typeinfo.TypeArray(w) = want {
      for child in a.elements {
        if (!array_mix_settles(child, check_expr(child, s), w.elem, s)) {
          return false;
        }
      }
      return true;
    }
  }
  if (nominal_args_clash(have, want, s.unions.unions)) {
    return struct_lit_yields(e, have, want, s, true);
  }
  return array_element_settles(e, want, s);
}

function struct_instance_mix(a: ast.ExprArray, first: typeinfo.Type, s: Scope, out: util.Diag[]): util.Diag[] {
  let anchor = first;
  let anchor_expr = a.elements[0];
  let k = 1;
  while (k < a.elements.len()) {
    let etk = check_expr(a.elements[k], s);
    if (concrete_instance(etk) && struct_name_of(etk) == struct_name_of(anchor) && typeinfo.spelling(etk) != typeinfo.spelling(anchor)) {
      if (struct_lit_yields(anchor_expr, anchor, etk, s, true)) {
        anchor = etk;
        anchor_expr = a.elements[k];
      } else if (!struct_lit_yields(a.elements[k], etk, anchor, s, true)) {
        return out.append(dg_at("E034", "array element: expected " + type_label(anchor) + ", got " + type_label(etk), expr_line(a.elements[k]), expr_col(a.elements[k])));
      }
    }
    k += 1;
  }
  return out;
}

function concrete_instance(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(st) = t {
    return st.args.len() > 0 && !type_contains_unknown(t);
  }
  return false;
}

function struct_name_of(t: typeinfo.Type): string {
  if let typeinfo.TypeStruct(st) = t {
    return st.name;
  }
  return "";
}

function call_diags_index(ix: ast.ExprIndex, s: Scope, out: util.Diag[]): util.Diag[] {
  out = util.append_diags(call_diags(ix.array, s), call_diags(ix.index, s));
  let ixt = check_expr(ix.index, s);
  if (!is_unknown(ixt) && !is_integer(ixt)) {
    out = out.append(dg_at("E034", "index must be an integer, got " + type_label(ixt), expr_line(ix.index), expr_col(ix.index)));
  }
  let iarrt = check_expr(ix.array, s);
  let idxable = false;
  match (iarrt) {
    typeinfo.TypeArray(_) => {
      idxable = true;
    },
    typeinfo.TypeString(_) => {
      idxable = true;
    },
    _ => {}
  }
  if (!is_unknown(iarrt) && !idxable && !generic_fn_value_arg(ix.array, s)) {
    out = out.append(dg_at("E034", "indexing non-array value of type " + type_label(iarrt), ix.line, ix.col));
  }

  return out;
}

function call_diags_slice(s2: ast.ExprSlice, s: Scope, out: util.Diag[]): util.Diag[] {
  out = util.append_diags(call_diags(s2.array, s), call_diags(s2.start, s));
  let sbt = check_expr(s2.start, s);
  if (!is_unknown(sbt) && !type_eq(sbt, t_i32())) {
    out = out.append(dg_at("E037", "slice low bound must be i32, got " + type_label(sbt), expr_line(s2.start), expr_col(s2.start)));
  }
  if (!s2.open_end) {
    out = util.append_diags(out, call_diags(s2.end, s));
    let ebt = check_expr(s2.end, s);
    if (!is_unknown(ebt) && !type_eq(ebt, t_i32())) {
      out = out.append(dg_at("E037", "slice high bound must be i32, got " + type_label(ebt), expr_line(s2.end), expr_col(s2.end)));
    }
  }
  let sarrt = check_expr(s2.array, s);
  let sliceable = false;
  match (sarrt) {
    typeinfo.TypeArray(_) => {
      sliceable = true;
    },
    typeinfo.TypeString(_) => {
      sliceable = true;
    },
    _ => {}
  }
  if (!is_unknown(sarrt) && !sliceable) {
    out = out.append(dg_at("E037", "cannot slice value of type " + type_label(sarrt), expr_line(s2.array), expr_col(s2.array)));
  }

  return out;
}

function call_diags_field_access(fa: ast.ExprFieldAccess, s: Scope, out: util.Diag[]): util.Diag[] {
  let qen = qual_enum_name(fa.obj, s);
  if (qen.len() > 0) {
    out = util.append_diags(out, enum_access_diags(s.lookup_union(qen), s, fa.line, fa.col));
    if (!qual_variant_exists(qen, fa.field, s)) {
      out = out.append(no_variant_diag(s, qen, fa.field, fa.line, fa.col));
    } else {
      let payloads = variant_value_payloads(s, qen, fa.field);
      if (payloads > 0) {
        out = out.append(payload_variant_value_diag(shown_enum(s, qen) + "." + shown_variant(s, qen + "." + fa.field), payloads, fa.line, fa.col));
      }
    }
    return out;
  }
  out = call_diags(fa.obj, s);
  let ot = check_expr(fa.obj, s);
  match (ot) {
    typeinfo.TypeStruct(sn) => {
      if let Some(fsig) = s.lookup_struct(sn.name) {
        out = util.append_diags(out, opaque_access_diags(fsig, s, "access a field of", fa.line, fa.col));
        if (!util.has_str(fsig.field_names, fa.field)) {
          out = out.append(s.member_fix(dg_at("E043", "struct " + util.demangle(sn.name) + " has no field or method \"" + fa.field + "\"", fa.line, fa.col), fa, fsig));
        }
      }
    },
    typeinfo.TypeTuple(tt) => {
      out = util.append_diags(out, tuple_field_diags(fa.field, tt, fa.line, fa.col));
    },
    _ => {
      if (!is_unknown(ot)) {
        out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice(method_namespace_of(ot), fa.field, ot), fa.line, fa.col), fa, ot));
      }
    }
  }

  return out;
}

function tuple_element_field(t: typeinfo.Type, field: string): boolean {
  if let typeinfo.TypeTuple(_) = t {
    return util.is_all_digits(field);
  }
  return false;
}

function tuple_field_diags(field: string, tt: typeinfo.TypeTuple, line: i32, col: i32): util.Diag[] {
  let idx = digit_string_to_i32(field);
  if (idx < 0 && !util.is_all_digits(field)) {
    return [dg_at("E046", "tuple field access requires a numeric index, got \"" + field + "\"", line, col)];
  }
  if (idx < 0 || idx >= tt.elements.len()) {
    let shown = field;
    if (idx >= 0) {
      shown = util.i32_to_string(idx);
    }
    return [dg_at("E046", "tuple has " + util.i32_to_string(tt.elements.len()) + " elements; index " + shown + " is out of range", line, col)];
  }
  return [];
}

function call_diags_struct_lit(sl: ast.ExprStructLit, dest_args: typeinfo.Type[], s: Scope, out: util.Diag[]): util.Diag[] {
  let found = s.lookup_struct(sl.type_name);
  let args = dest_args;
  if let Some(fsig) = found {
    out = util.append_diags(out, opaque_access_diags(fsig, s, "construct", sl.line, sl.col));
    if (sl.written.len() > 0) {
      let wn = parser.parse_type_ref(sl.written).args.len();
      if (wn != fsig.type_params.len()) {
        out = out.append(dg_at("E040", util.arity_message(fsig.name, fsig.type_params.len(), wn, "type argument"), sl.line, sl.col));
      } else {
        args = written_struct_args(sl, fsig, s);
      }
    }
    if (sl.has_base && fsig.type_params.len() > 0) {
      if let typeinfo.TypeStruct(bst) = check_expr(sl.base, s) {
        if (bst.args.len() == fsig.type_params.len()) {
          args = bst.args;
        }
      }
    }
    if (args.len() == 0 && fsig.type_params.len() > 0) {
      args = struct_lit_args(sl, fsig, s);
      let utp = lit_uninferable_param(sl, fsig, args, s);
      if (utp.len() > 0) {
        out = out.append(dg_at("E040", "could not infer type parameter " + utp + " for struct " + sl.type_name + " — supply it explicitly at the construction site (e.g. " + sl.type_name + "[i32] { ... }) or annotate the binding (e.g. let x: " + sl.type_name + "[i32] = ...)", sl.line, sl.col));
      }
    }
  }
  let vi = 0;
  while (vi < sl.field_values.len()) {
    let fdest = t_unknown("no declared field");
    if let Some(fsig) = found {
      if (vi < sl.field_names.len() && field_index(fsig, sl.field_names[vi]) >= 0) {
        fdest = lit_field_type(fsig, field_index(fsig, sl.field_names[vi]), args, s);
      }
    }
    out = util.append_diags(out, dest_call_diags(sl.field_values[vi], fdest, s));
    vi += 1;
  }
  if (sl.has_base) {
    out = util.append_diags(out, call_diags(sl.base, s));
    let bt = check_expr(sl.base, s);
    if (!is_unknown(bt) && !type_eq(bt, t_struct(sl.type_name))) {
      out = out.append(dg_at("E003", "struct-update base must be " + sl.type_name + ", got " + type_label(bt), expr_line(sl.base), expr_col(sl.base)));
    }
  }
  let seen_fields: string[] = [];
  for fname in sl.field_names {
    if (util.index_of_str(seen_fields, fname) >= 0) {
      out = out.append(dg_at("E007", "duplicate field \"" + fname + "\" in struct literal", sl.line, sl.col));
    } else {
      seen_fields = seen_fields.append(fname);
    }
  }
  if let Some(ssig) = found {
    let fi = 0;
    while (fi < sl.field_names.len()) {
      let fidx = field_index(ssig, sl.field_names[fi]);
      if (fidx >= 0) {
        let ft = lit_field_type(ssig, fidx, args, s);
        let vt = check_expr(sl.field_values[fi], s);
        out = util.append_diags(out, int_dest_range_diags(sl.field_values[fi], ft));
        out = util.append_diags(out, ctor_payload_diags(sl.field_values[fi], ft, s));
        if (!is_unknown(ft) && !is_unknown(vt) && !settles_to_dest(sl.field_values[fi], ft, s) && !coercible(vt, ft, s)) {
          out = out.append(dg_at("E043", "field \"" + sl.field_names[fi] + "\": expected " + type_label(ft) + ", got " + type_label(vt) + str_copy_hint(vt, ft), expr_line(sl.field_values[fi]), expr_col(sl.field_values[fi])));
        }
        out = util.append_diags(out, array_elem_check(array_elem_type_of(ft), sl.field_values[fi], s));
      }
      fi += 1;
    }
  }

  return out;
}

pub function lambda_body_scope(lm: ast.ExprLambda, s: Scope): Scope {
  let lsc = s;
  for param in lm.params {
    lsc = lsc.bind(param.name, s.resolve_param(param));
  }
  if (parser.is_value_block_origin(lm.origin)) {
    return lsc.with_block_ret(lambda_ret_type(lm, s));
  }
  return lsc.with_ret_type(lambda_ret_type(lm, s));
}

function call_diags_lambda(lm: ast.ExprLambda, s: Scope, out: util.Diag[]): util.Diag[] {
  if (parser.is_written_lambda_origin(lm.origin)) {
    out = util.append_diags(out, capture_view_diags(lm, s));
    out = util.append_diags(out, lambda_lane_diags(lm, s));
  }
  return util.append_diags(out, stmts_call_diags(lm.body, lambda_body_scope(lm, s)));
}

function lambda_lane_diags(lm: ast.ExprLambda, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (lanes_inside(check_lambda_expr(lm, s))) {
    out = out.append(dg_at("E085", "a lambda cannot take or return a lane value; a lane value crosses only a direct call", lm.line, lm.col));
  }
  let seen: string[] = [];
  for name in astwalk.collect_lambda_idents(lm, []) {
    if (!util.has_str(seen, name) && s.is_bound(name) && is_lanes(s.lookup(name))) {
      out = out.append(dg_at("E085", "a lambda cannot capture \"" + name + "\" of type " + type_label(s.lookup(name)) + "; a lane value lives only in a local, a parameter or a result", lm.line, lm.col));
    }
    seen = seen.append(name);
  }
  return out;
}

function capture_view_diags(lm: ast.ExprLambda, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let seen: string[] = [];
  for name in astwalk.collect_lambda_idents(lm, []) {
    if (util.has_str(seen, name)) {
      continue;
    }
    seen = seen.append(name);
    if (!s.is_bound(name)) {
      continue;
    }
    let (holds, _) = type_holds_view(s.lookup(name), s, []);
    if (holds) {
      out = out.append(dg_at("E082", "closure captures \"" + name + "\", which holds a borrowed view: a function value's environment cannot carry a view — copy it into an owned value before the closure (`.to_owned()` on a `str`)", lm.line, lm.col));
    }
  }
  return out;
}

function type_holds_view(t: typeinfo.Type, s: Scope, seen: string[]): (boolean, string[]) {
  if (is_str_view(t) || is_arr_view(t)) {
    return (true, seen);
  }
  if let typeinfo.TypeArray(a) = t {
    return type_holds_view(a.elem, s, seen);
  }
  if let typeinfo.TypeTuple(tup) = t {
    return any_holds_view(tup.elements, s, seen);
  }
  if let typeinfo.TypeMap(m) = t {
    return any_holds_view([m.key, m.value], s, seen);
  }
  if let typeinfo.TypeStruct(st) = t {
    if (util.has_str(seen, st.name)) {
      return (false, seen);
    }
    let (in_args, after) = any_holds_view(st.args, s, seen.append(st.name));
    if (in_args) {
      return (true, after);
    }
    let fields: typeinfo.Type[] = match (s.lookup_struct(st.name)) { Some(sig) => sig.field_types, None => [] };
    return any_holds_view(fields, s, after);
  }
  if let typeinfo.TypeUnion(u) = t {
    if (util.has_str(seen, u.name)) {
      return (false, seen);
    }
    let (in_args, after) = any_holds_view(u.args, s, seen.append(u.name));
    if (in_args) {
      return (true, after);
    }
    if let Some(us) = s.lookup_union(u.name) {
      for v in us.variants {
        let fields: typeinfo.Type[] = match (variant_shape_sig(s, v, u.name)) { Some(sig) => sig.field_types, None => [] };
        let (in_payload, next) = any_holds_view(fields, s, after);
        if (in_payload) {
          return (true, next);
        }
        after = next;
      }
    }
    return (false, after);
  }
  return (false, seen);
}

function any_holds_view(ts: typeinfo.Type[], s: Scope, seen: string[]): (boolean, string[]) {
  let at = seen;
  for t in ts {
    let (found, next) = type_holds_view(t, s, at);
    if (found) {
      return (true, next);
    }
    at = next;
  }
  return (false, at);
}

function call_diags_ident(id: ast.ExprIdent, s: Scope, out: util.Diag[]): util.Diag[] {
  if (!s.known(id.name) && !s.has_sig(id.name)) {
    out = util.append_diags(out, enum_access_diags(scope_variant_sig(id.name, s), s, id.line, id.col));
  }

  let payloads = 0;
  if (!s.known(id.name) && !s.has_sig(id.name) && !s.variant_ambiguous(id.name)) {
    payloads = variant_value_payloads(s, "", id.name);
  }
  if (payloads > 0) {
    out = out.append(payload_variant_value_diag(shown_variant(s, id.name), payloads, id.line, id.col));
  } else if (!s.known(id.name) && !s.is_bound(id.name) && generic_fn_value(s.lookup_sig(id.name))) {
    if let Some(sig) = s.lookup_sig(id.name) {
      out = out.append(generic_fn_value_diag(id, sig));
    }
  } else if (lane_fn_value(id, s)) {
    out = out.append(dg_at("E085", "function " + id.name + " takes or returns a lane value and cannot be used as a value; a lane value crosses only a direct call", id.line, id.col));
  } else if (!is_resolvable_value(id.name, s)) {
    out = out.append(undefined_name(id.name, s, id.line, id.col));
  }

  return out;
}

function fn_value_binds(sig: FuncSig, dest: typeinfo.TypeFunc, s: Scope): (string[], typeinfo.Type[]) {
  let ns: string[] = [];
  let ts: typeinfo.Type[] = [];
  if (!dest.params_known || dest.param_types.len() != sig.param_type_names.len()) {
    return (ns, ts);
  }
  let i = 0;
  while (i < dest.param_types.len()) {
    let (pn, pt) = gc_bind_param(sig_param_ref(sig, i), dest.param_types[i], sig.all_type_params, s.type_names(), ns, ts);
    ns = pn;
    ts = pt;
    i += 1;
  }
  let (rn, rt) = gc_bind_param(sig_ret_ref(sig), dest.ret_type, sig.all_type_params, s.type_names(), ns, ts);
  return (rn, rt);
}

function fn_value_instance(sig: FuncSig, bn: string[], bt: typeinfo.Type[], s: Scope): typeinfo.TypeFunc {
  let params: typeinfo.Type[] = [];
  let i = 0;
  while (i < sig.param_type_names.len()) {
    params = params.append(type_from_ref_subst(sig_param_ref(sig, i), bn, bt, s.type_names()));
    i += 1;
  }
  let result = type_from_ref_subst(sig_ret_ref(sig), bn, bt, s.type_names());
  return typeinfo.TypeFunc { param_types: params, param_own: callable_own_flags(sig.param_own, params.len()), ret_type: result, params_known: true };
}

function fn_value_settles(e: ast.Expr, want: typeinfo.TypeFunc, s: Scope): boolean {
  if let ast.ExprIdent(id) = e {
    let Some(sig) = s.lookup_sig(id.name) else {
      return false;
    };
    let (bn, bt) = fn_value_binds(sig, want, s);
    for tp in sig.all_type_params {
      let at = util.index_of_str(bn, tp);
      if (at < 0 || unknown_beyond_tvars(bt[at])) {
        return false;
      }
    }
    let inst = fn_value_instance(sig, bn, bt, s);
    let result = inst.ret_type;
    if (is_unknown(want.ret_type)) {
      result = want.ret_type;
    }
    let actual = t_func_own(inst.param_types, sig.param_own, result);
    if (is_unknown(want.ret_type) && !util.has_str(s.tparams, callable_typevar_name(want.ret_type))) {
      return type_assignable(actual, typeinfo.TypeFunc { ...want, ret_type: result }, s.unions.unions);
    }
    return type_assignable(actual, want, s.unions.unions);
  }
  return false;
}

function fn_value_at(e: ast.Expr, dest: typeinfo.Type, s: Scope): typeinfo.Type {
  if (generic_fn_value_arg(e, s)) {
    if let ast.ExprIdent(id) = e {
      if let typeinfo.TypeFunc(want) = dest {
        let Some(sig) = s.lookup_sig(id.name) else {
          return check_expr(e, s);
        };
        let (names, types) = fn_value_binds(sig, want, s);
        return fn_value_instance(sig, names, types, s);
      }
    }
  }
  return check_expr(e, s);
}

function generic_fn_value_arg(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprIdent(id) = e {
    return !s.known(id.name) && !s.is_bound(id.name) && generic_fn_value(s.lookup_sig(id.name));
  }
  return false;
}

function bound_param_dest(c: ast.ExprCall, di: i32, dest: typeinfo.Type, s: Scope): typeinfo.Type {
  if let ast.ExprIdent(cid) = c.callee {
    let Some(sig) = s.lookup_sig(cid.name) else {
      return dest;
    };
    if (s.defines(cid.name) || sig.all_type_params.len() == 0 || di >= sig.param_type_names.len()) {
      return dest;
    }
    let (bn, bt) = call_type_bindings(sig, c, s);
    return type_from_ref_subst(sig_param_ref(sig, di), bn, bt, s.type_names());
  }
  return dest;
}

function generic_fn_value(found: Option[FuncSig]): boolean {
  return match (found) { Some(sig) => !sig.is_const && sig.all_type_params.len() > 0, None => false };
}

function lane_fn_value(id: ast.ExprIdent, s: Scope): boolean {
  if (s.known(id.name) || s.is_bound(id.name)) {
    return false;
  }
  let Some(sig) = s.lookup_sig(id.name) else {
    return false;
  };
  return !sig.is_const && (any_holds_lanes(sig.param_types) || holds_lanes(sig.ret_type));
}

function generic_fn_value_diag(id: ast.ExprIdent, sig: FuncSig): util.Diag {
  let tps = comma_list(sig.all_type_params);
  let plural = "";
  if (sig.all_type_params.len() > 1) {
    plural = "s";
  }
  let params: string[] = [];
  let i = 0;
  while (i < sig.param_names.len()) {
    let pt = "";
    if (i < sig.param_type_names.len()) {
      pt = sig.param_type_names[i];
    }
    params = params.append(sig.param_names[i] + ": " + pt);
    i += 1;
  }
  return dg_at("E040", "generic function " + id.name + " cannot be used as a value — nothing here determines its type parameter" + plural + " " + tps + ". Wrap it in a lambda, which does: (" + comma_list(params) + ") => " + id.name + "(" + comma_list(sig.param_names) + ")", id.line, id.col);
}

function comma_list(xs: string[]): string {
  let out = "";
  for x in xs {
    if (out.len() > 0) {
      out += ", ";
    }
    out += x;
  }
  return out;
}

function param_decl_names(params: ast.ParamDecl[]): string[] {
  let out: string[] = [];
  for pd in params {
    out = out.append(pd.name);
  }
  return out;
}

function is_collection_mutator(field: string): boolean {
  return field == "insert" || field == "remove" || field == "cleared" || field == "with" || field == "append" || field == "truncate";
}

function e055_diag(e: ast.Expr, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if (!is_collection_mutator(fa.field)) {
            return none;
          }
          let is_coll = false;
          match (check_expr(fa.obj, s)) {
            typeinfo.TypeMap(_) => {
              is_coll = true;
            },
            typeinfo.TypeArray(array) => {
              is_coll = !array.view;
            },
            _ => {}
          }
          if (!is_coll) {
            return none;
          }
          let d: util.Diag[] = [dg_at("E055", "result of `." + fa.field + "(...)` is unused; assign it back (e.g. `x = x." + fa.field + "(...)`) — collection operations return a new value, they do not mutate in place (use `let _ = …` to discard intentionally)", fa.line, fa.col)];
          return d;
        },
        _ => {
          return none;
        }
      }
    },
    _ => {
      return none;
    }
  }
  return none;
}

function array_elem_type_of(t: typeinfo.Type): typeinfo.Type {
  match (t) {
    typeinfo.TypeArray(ad) => {
      return ad.elem;
    },
    _ => {
      return t_unknown("not an array");
    }
  }
  return t_unknown("not an array");
}

function array_elem_check(elem_ty: typeinfo.Type, init: ast.Expr, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (!checks_array_element(elem_ty)) {
    return out;
  }
  match (init) {
    ast.ExprArray(arr) => {
      for element in arr.elements {
        let ekt = check_expr(element, s);
        if (!is_unknown(ekt) && !settles_to(element, elem_ty, s) && !coercible(ekt, elem_ty, s) && dest_bound_diags(element, elem_ty, s).len() == 0) {
          out = out.append(dg_at("E034", "array element: expected " + type_label(elem_ty) + ", got " + type_label(ekt), expr_line(element), expr_col(element)));
        }
      }
    },
    _ => {}
  }
  return out;
}

function checks_array_element(ty: typeinfo.Type): boolean {
  match (ty) {
    typeinfo.TypeUnion(_) => {
      return true;
    },
    _ => {
      return is_dyn_slot(ty) || is_str_view(ty);
    }
  }
  return false;
}

function slice_unchecked_type(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (c.args.len() != 3) {
    return t_unknown("slice_unchecked takes 3 arguments");
  }
  let sut: typeinfo.Type = check_expr(c.args[0], s);
  if (!is_integer(check_expr(c.args[1], s)) || !is_integer(check_expr(c.args[2], s))) {
    return t_unknown("slice_unchecked bounds must be i32");
  }
  match (sut) {
    typeinfo.TypeString(_) => {
      return t_str();
    },
    _ => {}
  }
  return t_unknown("slice_unchecked: first argument must be a string");
}

function cell_new_type(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (c.args.len() != 1) {
    return t_struct("Cell");
  }
  let et: typeinfo.Type = check_expr(c.args[0], s);
  if (is_unknown(et)) {
    return t_struct("Cell");
  }
  return t_struct_g("Cell", [et]);
}

// An array literal written straight into a destination whose elements
// array_elem_check compares is reported element by element, not as a whole.
// `cell_new(x)` settles to `Cell[W]` when x settles to W: the literal in
// `let c: Cell[i64] = cell_new(2)` takes the width of the destination.
function cell_new_settles(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if (!is_cell_type(want) || is_unknown(cell_elem_type(want))) {
    return false;
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (id.name == "cell_new" && c.args.len() == 1 && !s.known(id.name)) {
        return settles_to(c.args[0], cell_elem_type(want), s);
      }
    }
  }
  return false;
}

function elem_checked_literal(e: ast.Expr, dest: typeinfo.Type): boolean {
  if let ast.ExprArray(_) = e {
    return checks_array_element(array_elem_type_of(dest));
  }
  return false;
}

// settles_to for a value in a destination slot that array_elem_check also covers.
function settles_to_dest(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  return elem_checked_literal(e, want) || settles_to(e, want, s);
}

function lit_field_type(ssig: StructSig, fi: i32, args: typeinfo.Type[], s: Scope): typeinfo.Type {
  if (args.len() == 0 || args.len() != ssig.type_params.len() || fi >= ssig.field_type_names.len()) {
    return ssig.field_types[fi];
  }
  return type_from_ref_subst(parser.parse_type_ref(ssig.field_type_names[fi]), ssig.type_params, args, s.type_names());
}

// member_dest is the type a struct literal of `name` takes from an expected
// union instance that has `name` as a member: `P[string]` for `P { ... }`
// where a `U[string]` is expected and `type U[T] = P[T] | Q`.
function member_dest(name: string, dest: typeinfo.Type, s: Scope): typeinfo.Type {
  let typeinfo.TypeUnion(du) = dest else {
    return dest;
  };
  let Some(u) = s.lookup_union(du.name) else {
    return dest;
  };
  let Some(vs) = s.lookup_owned_struct(name, u.name) else {
    return dest;
  };
  if (u.type_params.len() != du.args.len() || vs.enum_owner != u.name || vs.field_type_names.len() != 1) {
    return dest;
  }
  let member = parser.parse_type_ref(vs.field_type_names[0]);
  if (member.base != name) {
    return dest;
  }
  return type_from_ref_subst(member, u.type_params, du.args, s.type_names());
}

function dest_call_diags(e: ast.Expr, dest: typeinfo.Type, s: Scope): util.Diag[] {
  if let ast.ExprCall(c) = e {
    return call_diags_call(c, s, [], dest);
  }
  if let ast.ExprIdent(id) = e {
    if let typeinfo.TypeFunc(df) = dest {
      if (!s.known(id.name) && !s.is_bound(id.name) && generic_fn_value(s.lookup_sig(id.name))) {
        let Some(sig) = s.lookup_sig(id.name) else {
          return call_diags(e, s);
        };
        let (bn, bt) = fn_value_binds(sig, df, s);
        if (bn.len() == sig.all_type_params.len()) {
          return call_bound_diags(sig.type_params, sig.type_bounds, sig.module, util.demangle(sig.name), bn, bt, s, id.line, id.col);
        }
      }
    }
  }
  if let ast.ExprStructLit(sl) = e {
    if let typeinfo.TypeStruct(ds) = member_dest(sl.type_name, dest, s) {
      if (ds.name == sl.type_name) {
        return call_diags_struct_lit(sl, ds.args, s, []);
      }
    }
  }
  let elem = array_elem_type_of(dest);
  if (is_str_view(elem)) {
    if let ast.ExprArray(sa) = e {
      let out: util.Diag[] = [];
      for element in sa.elements {
        out = util.append_diags(out, call_diags(element, s));
        let et = check_expr(element, s);
        if (!is_unknown(et) && !coercible(et, elem, s)) {
          out = out.append(dg_at("E034", "array element: expected " + type_label(elem) + ", got " + type_label(et), expr_line(element), expr_col(element)));
        }
      }
      return out;
    }
  }
  if (!is_unknown(elem) && !is_primitive_type(elem)) {
    if let ast.ExprArray(a) = e {
      let out: util.Diag[] = [];
      if (!checks_array_element(elem)) {
        out = array_mix_diags(a, s, out);
      }
      for element in a.elements {
        out = util.append_diags(out, dest_call_diags(element, elem, s));
      }
      return out;
    }
  }
  return call_diags(e, s);
}

function (s: Scope) has_visible_method(field: string, recv: string): boolean {
  if let Some(_) = s.visible_method(field, recv) {
    return true;
  }
  return false;
}

function (s: Scope) method_missing(recv: typeinfo.Type, field: string): boolean {
  let scalar = scalar_receiver_name(recv);
  if (scalar.len() > 0) {
    return !s.has_visible_method(field, scalar) && is_unknown(builtin_method_sig(scalar, field));
  }
  match (recv) {
    typeinfo.TypeLanes(l) => {
      let lanes = typeinfo.lanes_spelling(l.width);
      return !s.has_visible_method(field, lanes) && is_unknown(builtin_method_sig(lanes, field));
    },
    typeinfo.TypeArray(array) => {
      let builtin = field == "len" || !array.view && (field == "append" || field == "with" || field == "truncate");
      return !builtin && !s.has_array_recv_method(field, array.view);
    },
    typeinfo.TypeMap(_) => {
      return !util.has_str(preregistered_methods("Map"), field) && !s.has_visible_method(field, "Map");
    },
    typeinfo.TypeStruct(sn) => {
      if (is_cell_type(recv) || s.has_visible_method(field, sn.name) || !is_unknown(builtin_method_sig(sn.name, field))) {
        return false;
      }
      let Some(fsig) = s.lookup_struct(sn.name) else {
        return false;
      };
      let fi = field_index(fsig, field);
      if (fi < 0) {
        return true;
      }
      if let typeinfo.TypeFunc(_) = fsig.field_types[fi] {
        return false;
      }
      return true;
    },
    typeinfo.TypeUnion(un) => {
      let declared = un.name == "Option" || un.name == "Result" || un.name == "IoError" || un.name == "Body" || un.name == "StreamFault" || s.has_union(un.name);
      return declared && !s.has_visible_method(field, un.name) && is_unknown(builtin_method_sig(un.name, field));
    },
    _ => {
      return false;
    }
  }
  return false;
}

function (s: Scope) callee_resolves(c: ast.ExprCall): boolean {
  if let ast.ExprIdent(cid) = c.callee {
    return is_resolvable_value(cid.name, s);
  }
  if let ast.ExprFieldAccess(mfa) = c.callee {
    return !s.method_missing(check_expr(mfa.obj, s), mfa.field);
  }
  return true;
}

function (s: Scope) call_param_types(c: ast.ExprCall): typeinfo.Type[] {
  match (c.callee) {
    ast.ExprIdent(id) => {
      if (s.ident_binding(id) < 0) {
        return match (s.lookup_sig(id.name)) { Some(sig) => sig.param_types, None => [] };
      }
      if let typeinfo.TypeFunc(f) = s.lookup(id.name) {
        if (f.params_known) {
          return f.param_types;
        }
      }
    },
    ast.ExprFieldAccess(mfa) => {
      let rt = check_expr(mfa.obj, s);
      if let typeinfo.TypeStruct(sn) = rt {
        if let Some(msig) = s.lookup_method(mfa.field, sn.name) {
          return s.bound_method_param_types(c, msig, rt);
        }
        if let typeinfo.TypeFunc(ff) = check_expr(c.callee, s) {
          if (ff.params_known) {
            return ff.param_types;
          }
        }
      }
      if let typeinfo.TypeUnion(un) = rt {
        if let Some(msig) = s.lookup_method(mfa.field, un.name) {
          return s.bound_method_param_types(c, msig, rt);
        }
      }
      if let typeinfo.TypeTuple(tup) = rt {
        if let Some(msig) = s.lookup_method(mfa.field, parser.tuple_arity_namespace(tup.elements.len())) {
          return s.bound_method_param_types(c, msig, rt);
        }
      }
      if let typeinfo.TypeMap(mt) = rt {
        if (mfa.field == "insert") {
          return [mt.key, mt.value];
        }
      }
      if let typeinfo.TypeArray(at) = rt {
        if (mfa.field == "append") {
          return [at.elem];
        }
        if (mfa.field == "with") {
          return [t_i32(), at.elem];
        }
        if (mfa.field == "truncate") {
          return [t_i32()];
        }
        return s.array_method_param_types(c, rt, mfa.field, at.view);
      }
    },
    _ => {}
  }
  return [];
}

function (s: Scope) array_method_param_types(c: ast.ExprCall, recv: typeinfo.Type, field: string, view: boolean): typeinfo.Type[] {
  if let Some(asig) = s.array_recv_method(field, view) {
    return s.bound_method_param_types(c, asig, recv);
  }
  return [];
}

function (s: Scope) bound_method_param_types(c: ast.ExprCall, asig: MethodSig, recv: typeinfo.Type): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let mb = method_binding(c, asig, recv, s);
  let i = 0;
  while (i < asig.param_types.len()) {
    out = out.append(receiver_bound(asig.param_types[i], param_type_name_at(asig, i), mb, s));
    i += 1;
  }
  return out;
}

function for_iter_diags(fr: ast.StmtFor, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  if (for_iter_is_range(fr.iter)) {
    return none;
  }
  let it = check_expr(fr.iter, s);
  if (builtin_iterable(it) || is_unknown(it) && tvar_name(it).len() == 0 || iter_subject(it, s).ok) {
    return none;
  }
  return [dg_at("E083", "cannot iterate over a value of type " + util.show_type_vars(type_label_or_tvar(it)) + ": `for` walks an array, a string, a Map, a range, an iter.Iterator, or a value whose iter() returns one", expr_line(fr.iter), expr_col(fr.iter))];
}

function tuple_destr_diags(t: typeinfo.Type, n: i32, line: i32, col: i32): util.Diag[] {
  match (t) {
    typeinfo.TypeTuple(tt) => {
      if (tt.elements.len() != n) {
        return [dg_at("E024", "tuple has " + util.i32_to_string(tt.elements.len()) + " elements, but " + util.i32_to_string(n) + " names given", line, col)];
      }
    },
    typeinfo.TypeUnknown(_) => {},
    _ => {
      return [dg_at("E024", "tuple destructure needs a tuple expression, got " + type_label(t), line, col)];
    }
  }
  return [];
}

function for_pattern_diags(fr: ast.StmtFor, s: Scope): util.Diag[] {
  if (!name_has_comma(fr.var_name)) {
    return [];
  }
  let n = split_pattern_names(fr.var_name).len();
  if (for_iter_is_range(fr.iter)) {
    return tuple_destr_diags(range_var_type(fr.iter, s), n, fr.line, fr.col);
  }
  let it = check_expr(fr.iter, s);
  match (it) {
    typeinfo.TypeString(_) => {
      return tuple_destr_diags(t_u8(), n, fr.line, fr.col);
    },
    typeinfo.TypeArray(ta) => {
      return tuple_destr_diags(ta.elem, n, fr.line, fr.col);
    },
    typeinfo.TypeMap(_) => {
      if (n != 2) {
        return [dg_at("E024", "iterating a Map binds a (key, value) pair, but this pattern binds " + util.i32_to_string(n), fr.line, fr.col)];
      }
      return [];
    },
    _ => {}
  }
  let sub = iter_subject(it, s);
  if (sub.ok) {
    return tuple_destr_diags(sub.elem, n, fr.line, fr.col);
  }
  return [];
}

function builtin_iterable(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeArray(_) => {
      return true;
    },
    typeinfo.TypeString(_) => {
      return true;
    },
    typeinfo.TypeMap(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function type_label_or_tvar(t: typeinfo.Type): string {
  let tv = tvar_name(t);
  if (tv.len() > 0) {
    return tv;
  }
  return type_label(t);
}

struct IterSubject { ok: boolean, elem: typeinfo.Type, via_iter: boolean }

function iter_subject(t: typeinfo.Type, s: Scope): IterSubject {
  let direct = iterator_elem(t, s);
  if (!is_unknown(direct) || tvar_name(direct).len() > 0) {
    return IterSubject { ok: true, elem: direct, via_iter: false };
  }
  if (is_unknown(t) || is_type_variable(t)) {
    return IterSubject { ok: false, elem: direct, via_iter: false };
  }
  let via = iterator_elem(probe_method(t, "iter", s), s);
  if (!is_unknown(via) || tvar_name(via).len() > 0) {
    return IterSubject { ok: true, elem: via, via_iter: true };
  }
  return IterSubject { ok: false, elem: via, via_iter: false };
}

function iterator_elem(t: typeinfo.Type, s: Scope): typeinfo.Type {
  if (!implements_iterator(t, s)) {
    return t_unknown("not an Iterator");
  }
  if let typeinfo.TypeUnion(u) = probe_method(t, "next", s) {
    if (u.name == "Option" && u.args.len() == 1) {
      if let typeinfo.TypeTuple(tp) = u.args[0] {
        if (tp.elements.len() == 2) {
          return tp.elements[0];
        }
      }
    }
  }
  return t_unknown("not an Iterator");
}

function implements_iterator(t: typeinfo.Type, s: Scope): boolean {
  let tv = tp_receiver(t, s);
  if (tv.len() == 0) {
    tv = tvar_name(t);
  }
  if (tv.len() > 0) {
    for tr in tp_bound_traits(s, tv) {
      if (tr == CORE_ITERATOR) {
        return true;
      }
    }
    return false;
  }
  if (is_unknown(t)) {
    return false;
  }
  let base = util.base_type_name(type_label(t));
  for imp in s.impls {
    if (parser.impl_trait_key(imp) == CORE_ITERATOR && util.base_type_name(imp.impl_type) == base) {
      return true;
    }
  }
  return false;
}

const CORE_ITERATOR: string = "iter.Iterator";

function iterator_lowering(fr: ast.StmtFor, s: Scope): Option[ast.Stmt] {
  if (for_iter_is_range(fr.iter)) {
    return None;
  }
  let it = check_expr(fr.iter, s);
  if (builtin_iterable(it)) {
    return None;
  }
  let sub = iter_subject(it, s);
  if (!sub.ok) {
    return None;
  }
  let line = expr_line(fr.iter);
  let col = expr_col(fr.iter);
  let subject = fr.iter;
  if (sub.via_iter) {
    subject = ast.ExprCall { callee: ast.ExprFieldAccess { obj: fr.iter, field: "iter", line: line, col: col, ty: "", const_read: false }, args: [], line: line, col: col, type_args: [], ty: "" };
  }
  return Some(parser.iterator_loop(fr, subject, col));
}

function probe_method(t: typeinfo.Type, name: string, s: Scope): typeinfo.Type {
  let recv: ast.Expr = ast.ExprIdent { name: "__for_iter", line: 0, col: 0, ty: "", builtin: false };
  let call: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: recv, field: name, line: 0, col: 0, ty: "", const_read: false }, args: [], line: 0, col: 0, type_args: [], ty: "" };
  return check_expr(call, s.bind("__for_iter", t));
}

struct CoverPat { ctor: string, opaque: boolean, args: CoverPat[] }

function cover_any(): CoverPat {
  return CoverPat { ctor: "", opaque: false, args: [] };
}

function cover_opaque(): CoverPat {
  return CoverPat { ctor: "", opaque: true, args: [] };
}

function cover_shape_diags(p: CoverPat, t: typeinfo.Type, s: Scope, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  if (p.ctor == "()") {
    match (t) {
      typeinfo.TypeTuple(tuple) => {
        if (p.args.len() != tuple.elements.len()) {
          return [dg_at("E035", "tuple pattern has " + util.i32_to_string(p.args.len()) + " elements, but scrutinee tuple has " + util.i32_to_string(tuple.elements.len()), line, col)];
        }
      },
      typeinfo.TypeUnknown(_) => {},
      _ => {
        return [dg_at("E035", "tuple pattern needs a tuple value, got " + type_label(t), line, col)];
      }
    }
  }
  if (p.args.len() == 0) {
    return out;
  }
  let types = cover_arg_types(t, p.ctor, p.args.len(), s);
  for i in 0..p.args.len() {
    if (i >= types.len()) {
      break;
    }
    out = util.append_diags(out, cover_shape_diags(p.args[i], types[i], s, line, col));
  }
  return out;
}

function sugar_shape_diags(sg: ast.MatchSugar, t: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  for arm in sg.arms {
    out = util.append_diags(out, cover_shape_diags(typed_pattern_cover(arm.pattern, t, s), t, s, arm.line, arm.col));
  }
  for arm in sg.tup {
    if (!arm.is_wild) {
      out = util.append_diags(out, cover_shape_diags(tuple_cover(arm.elem_kinds, arm.lits, arm.elem_pats), t, s, arm.line, arm.col));
    }
  }
  for arm in sg.strct {
    if (!arm.is_wild) {
      out = util.append_diags(out, cover_shape_diags(struct_cover(arm, t, s), t, s, arm.line, arm.col));
    }
  }
  return out;
}

function sugar_exhaustive_diags(sg: ast.MatchSugar, s: Scope): util.Diag[] {
  if (sg.origin != "" || sg.tup.len() + sg.strct.len() + sg.arms.len() == 0) {
    return [];
  }
  let out: util.Diag[] = [];
  let t = check_expr(sg.scrut, s);
  let valid = sg;
  if let typeinfo.TypeTuple(tuple) = t {
    let arms: ast.TupArm[] = [];
    for arm in sg.tup {
      if (!arm.is_wild && arm.elem_kinds.len() != tuple.elements.len()) {
        out = out.append(dg_at("E035", "tuple pattern has " + util.i32_to_string(arm.elem_kinds.len()) + " elements, but scrutinee tuple has " + util.i32_to_string(tuple.elements.len()), arm.line, arm.col));
      } else {
        arms = arms.append(arm);
      }
    }
    valid = ast.MatchSugar { ...sg, tup: arms };
  }
  out = util.append_diags(out, sugar_shape_diags(valid, t, s));
  if (out.len() > 0) {
    return out;
  }
  out = util.append_diags(out, sugar_unreachable_diags(valid, t, s));
  if (is_unknown(t)) {
    return out;
  }
  if (has_catch_all(valid)) {
    return out;
  }
  let rows = sugar_rows(valid, t, s);
  if (sg.arms.len() > 0) {
    return util.append_diags(out, variant_cover_diags(rows, t, valid, s));
  }
  if (!cover_useful(rows, [t], s)) {
    return out;
  }
  if (sg.tup.len() > 0) {
    return out.append(dg_at("E030", "match on tuple is not exhaustive — add an unguarded `_` or all-binder arm", sg.line, sg.col));
  }
  return out.append(dg_at("E030", "match on struct is not exhaustive — add an unguarded struct-pattern or `_` arm", sg.line, sg.col));
}

function variant_cover_diags(rows: CoverPat[][], t: typeinfo.Type, sg: ast.MatchSugar, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if let typeinfo.TypeUnion(u) = t {
    for v in cover_ctor_names(t, s) {
      let arity = cover_arity(rows, v);
      if (cover_useful(cover_split(rows, v, arity), cover_arg_types(t, v, arity, s), s)) {
        out = out.append(dg_at("E030", "match does not cover variant " + unprefixed_variant(v, union_module(s, u.name)) + " of enum " + shown_enum(s, u.name) + " — add an arm for it, or a `_` arm", sg.line, sg.col));
      }
    }
  }
  return out;
}

function has_catch_all(sg: ast.MatchSugar): boolean {
  for a in sg.tup {
    if (!a.has_guard && (a.is_wild || binds_only(a.elem_kinds))) {
      return true;
    }
  }
  for a in sg.strct {
    if (!a.has_guard && a.is_wild) {
      return true;
    }
  }
  for a in sg.arms {
    if let ast.PatWildcard(_) = a.pattern {
      if (!a.has_guard) {
        return true;
      }
    }
  }
  return false;
}

function binds_only(kinds: i32[]): boolean {
  for k in kinds {
    if (k != 0 && k != 1) {
      return false;
    }
  }
  return true;
}

function sugar_rows(sg: ast.MatchSugar, t: typeinfo.Type, s: Scope): CoverPat[][] {
  let rows: CoverPat[][] = [];
  for a in sg.tup {
    if (!a.has_guard) {
      let p = cover_any();
      if (!a.is_wild) {
        p = tuple_cover(a.elem_kinds, a.lits, a.elem_pats);
      }
      rows = rows.append([p]);
    }
  }
  for a in sg.strct {
    if (!a.has_guard) {
      let p = cover_any();
      if (!a.is_wild) {
        p = struct_cover(a, t, s);
      }
      rows = rows.append([p]);
    }
  }
  for a in sg.arms {
    if (!a.has_guard) {
      rows = rows.append([typed_pattern_cover(a.pattern, t, s)]);
    }
  }
  return rows;
}

function literal_cover(e: ast.Expr): CoverPat {
  if let ast.ExprBool(b) = e {
    if (b.value) {
      return CoverPat { ctor: "true", opaque: false, args: [] };
    }
    return CoverPat { ctor: "false", opaque: false, args: [] };
  }
  return cover_opaque();
}

function tuple_cover(kinds: i32[], lits: ast.Expr[], pats: ast.Pattern[]): CoverPat {
  let args: CoverPat[] = [];
  let k = 0;
  while (k < kinds.len()) {
    let a = cover_any();
    if (kinds[k] == 2 && k < lits.len()) {
      a = literal_cover(lits[k]);
    } else if (kinds[k] == 3 && k < pats.len()) {
      a = pattern_cover(pats[k]);
    } else if (kinds[k] == 4 && k < pats.len()) {
      if let ast.PatVariant(np) = pats[k] {
        a = tuple_cover(np.tup_kinds, np.tup_lits, np.tup_pats);
      }
    }
    args = args.append(a);
    k += 1;
  }
  return CoverPat { ctor: "()", opaque: false, args: args };
}

function struct_cover(a: ast.StructArm, t: typeinfo.Type, s: Scope): CoverPat {
  let args: CoverPat[] = [];
  if let typeinfo.TypeStruct(st) = t {
    for name in struct_field_names(s, st.name) {
      let p = cover_any();
      let j = util.index_of_str(a.fields, name);
      if (j >= 0 && j < a.field_kinds.len() && a.field_kinds[j] == 2) {
        p = literal_cover(a.field_lits[j]);
      } else if (j >= 0 && j < a.field_kinds.len() && a.field_kinds[j] == 3) {
        p = typed_pattern_cover(a.field_pats[j], struct_field_type(st, name, s), s);
      }
      args = args.append(p);
    }
  }
  return CoverPat { ctor: "{}", opaque: false, args: args };
}

function pattern_cover(p: ast.Pattern): CoverPat {
  match (p) {
    ast.PatLiteral(literal) => {
      if (literal.has_range) {
        return CoverPat { ctor: "", opaque: true, args: [] };
      }
      return literal_cover(literal.lit);
    },
    ast.PatWildcard(_) => {
      return cover_any();
    },
    ast.PatVariant(pv) => {
      if (pv.type_name.len() == 0) {
        if (pv.tup_kinds.len() > 0) {
          return tuple_cover(pv.tup_kinds, pv.tup_lits, pv.tup_pats);
        }
        return cover_any();
      }
      let slots: string[] = [];
      if (pv.binding.len() > 0 || pv.extra_bindings.len() > 0) {
        slots = [pv.binding];
        for b in pv.extra_bindings {
          slots = slots.append(b);
        }
      }
      let args: CoverPat[] = [];
      let i = 0;
      while (i < slots.len() || i < pv.nested.len()) {
        let a = cover_any();
        let named = "";
        if (i < slots.len()) {
          named = slots[i];
        }
        if (i < pv.nested.len() && nested_tests(pv.nested[i])) {
          a = pattern_cover(pv.nested[i]);
        } else if (named == "__tupslot") {
          a = tuple_cover(pv.tup_kinds, pv.tup_lits, pv.tup_pats);
        } else if (util.str_has_prefix(named, "__pl")) {
          a = slot_literal_cover(pv.lit_cond, named);
        }
        args = args.append(a);
        i += 1;
      }
      return CoverPat { ctor: variant_pattern_name(pv.type_name), opaque: false, args: args };
    }
  }
}

// Coverage follows each payload type, with support for structs inside enum slots.
function typed_pattern_cover(p: ast.Pattern, t: typeinfo.Type, s: Scope): CoverPat {
  if let ast.PatVariant(pv) = p {
    if let typeinfo.TypeStruct(st) = t {
      if (parser.is_record_pattern(pv) && pv.type_name == st.name) {
        return record_pattern_cover(pv, st, s);
      }
    }
    let base = pattern_cover(p);
    if (pv.nested.len() == 0) {
      return base;
    }
    let args = base.args;
    let types = cover_arg_types(t, base.ctor, args.len(), s);
    let i = 0;
    while (i < args.len() && i < pv.nested.len() && i < types.len()) {
      if (nested_tests(pv.nested[i])) {
        args = args.with(i, typed_pattern_cover(pv.nested[i], types[i], s));
      }
      i += 1;
    }
    return CoverPat { ...base, args: args };
  }
  return cover_any();
}

function record_pattern_cover(pv: ast.PatVariant, st: typeinfo.TypeStruct, s: Scope): CoverPat {
  let args: CoverPat[] = [];
  for field in struct_field_names(s, st.name) {
    let p = cover_any();
    let i = util.index_of_str(pv.field_names, field);
    if (i >= 0) {
      p = slot_literal_cover(pv.lit_cond, parser.payload_binder(pv, i));
      if (i < pv.nested.len() && nested_tests(pv.nested[i])) {
        p = typed_pattern_cover(pv.nested[i], struct_field_type(st, field, s), s);
      }
    }
    args = args.append(p);
  }
  return CoverPat { ctor: "{}", opaque: false, args: args };
}

function nested_tests(p: ast.Pattern): boolean {
  if let ast.PatVariant(np) = p {
    return np.type_name.len() > 0 || np.tup_kinds.len() > 0;
  }
  return false;
}

function slot_literal_cover(cond: ast.Expr, slot: string): CoverPat {
  if let ast.ExprBinary(b) = cond {
    if (b.op == "&&") {
      let l = slot_literal_cover(b.left, slot);
      if (l.ctor.len() > 0 || l.opaque) {
        return l;
      }
      return slot_literal_cover(b.right, slot);
    }
    if let ast.ExprIdent(id) = b.left {
      if (id.name == slot) {
        if (b.op == "==") {
          return literal_cover(b.right);
        }
        return cover_opaque();
      }
    }
    if (expr_mentions(b.left, slot) || expr_mentions(b.right, slot)) {
      return cover_opaque();
    }
  }
  return cover_any();
}

function expr_mentions(e: ast.Expr, name: string): boolean {
  if let ast.ExprIdent(id) = e {
    return id.name == name;
  }
  if let ast.ExprBinary(b) = e {
    return expr_mentions(b.left, name) || expr_mentions(b.right, name);
  }
  return false;
}

function cover_ctor_names(t: typeinfo.Type, s: Scope): string[] {
  match (t) {
    typeinfo.TypeUnion(u) => {
      if let Some(us) = enum_sig(s, u.name) {
        return us.variants;
      }
      return [];
    },
    typeinfo.TypeTuple(_) => {
      return ["()"];
    },
    typeinfo.TypeStruct(_) => {
      return ["{}"];
    },
    typeinfo.TypeBool(_) => {
      return ["false", "true"];
    },
    _ => {
      let none: string[] = [];
      return none;
    }
  }
}

function cover_arg_types(t: typeinfo.Type, ctor: string, arity: i32, s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  match (t) {
    typeinfo.TypeTuple(tt) => {
      return tt.elements;
    },
    typeinfo.TypeStruct(st) => {
      for field in struct_field_names(s, st.name) {
        out = out.append(struct_field_type(st, field, s));
      }
    },
    typeinfo.TypeUnion(u) => {
      let i = 0;
      while (i < arity) {
        out = out.append(variant_pattern_payload_type(s, u.name + "." + ctor, t, i));
        i += 1;
      }
    },
    _ => {}
  }
  return out;
}

function literal_payload_rows(arms: ast.MatchArm[]): CoverPat[][] {
  let rows: CoverPat[][] = [];
  for a in arms {
    if (!a.has_guard || !slot_tests_only(a.guard)) {
      continue;
    }
    if let ast.PatVariant(pv) = a.pattern {
      rows = rows.append([pattern_cover(ast.PatVariant { ...pv, lit_cond: a.guard, has_lit_cond: true })]);
    }
  }
  return rows;
}

function slot_tests_only(e: ast.Expr): boolean {
  if let ast.ExprBinary(b) = e {
    if (b.op == "&&") {
      return slot_tests_only(b.left) && slot_tests_only(b.right);
    }
    if let ast.ExprIdent(id) = b.left {
      return util.str_has_prefix(id.name, "__pl");
    }
  }
  return false;
}

function rows_cover(rows: CoverPat[][], t: typeinfo.Type, ctor: string, s: Scope): boolean {
  if (rows.len() == 0) {
    return false;
  }
  let arity = cover_arity(rows, ctor);
  return !cover_useful(cover_split(rows, ctor, arity), cover_arg_types(t, ctor, arity, s), s);
}

function names_ctor(written: string, ctor: string): boolean {
  return written == ctor || written.len() > 0 && util.str_has_suffix(ctor, "__" + written);
}

function cover_arity(rows: CoverPat[][], ctor: string): i32 {
  let n = 0;
  for r in rows {
    if (!r[0].opaque && names_ctor(r[0].ctor, ctor) && r[0].args.len() > n) {
      n = r[0].args.len();
    }
  }
  return n;
}

function cover_split(rows: CoverPat[][], ctor: string, arity: i32): CoverPat[][] {
  let out: CoverPat[][] = [];
  for r in rows {
    let head = r[0];
    if (head.opaque || head.ctor.len() > 0 && !names_ctor(head.ctor, ctor)) {
      continue;
    }
    let row: CoverPat[] = [];
    let i = 0;
    while (i < arity) {
      if (i < head.args.len()) {
        row = row.append(head.args[i]);
      } else {
        row = row.append(cover_any());
      }
      i += 1;
    }
    let j = 1;
    while (j < r.len()) {
      row = row.append(r[j]);
      j += 1;
    }
    out = out.append(row);
  }
  return out;
}

function cover_useful(rows: CoverPat[][], types: typeinfo.Type[], s: Scope): boolean {
  if (types.len() == 0) {
    return rows.len() == 0;
  }
  let rest_types: typeinfo.Type[] = [];
  let k = 1;
  while (k < types.len()) {
    rest_types = rest_types.append(types[k]);
    k += 1;
  }
  let names = cover_ctor_names(types[0], s);
  let complete = names.len() > 0;
  for n in names {
    if (!cover_names(rows, n)) {
      complete = false;
    }
  }
  if (!complete) {
    let rest: CoverPat[][] = [];
    for r in rows {
      let matches_all = r[0].ctor.len() == 0 && !r[0].opaque;
      if (matches_all || is_unknown(types[0]) && !r[0].opaque) {
        rest = rest.append(cover_tail(r));
      }
    }
    return cover_useful(rest, rest_types, s);
  }
  for n in names {
    let arity = cover_arity(rows, n);
    let arg_types = cover_arg_types(types[0], n, arity, s);
    for rt in rest_types {
      arg_types = arg_types.append(rt);
    }
    if (cover_useful(cover_split(rows, n, arity), arg_types, s)) {
      return true;
    }
  }
  return false;
}

function cover_names(rows: CoverPat[][], ctor: string): boolean {
  for r in rows {
    if (!r[0].opaque && names_ctor(r[0].ctor, ctor)) {
      return true;
    }
  }
  return false;
}

function cover_tail(r: CoverPat[]): CoverPat[] {
  let out: CoverPat[] = [];
  let j = 1;
  while (j < r.len()) {
    out = out.append(r[j]);
    j += 1;
  }
  return out;
}

function ordinary_match_origin(origin: string): boolean {
  return origin == "" || origin == parser.ORIGIN_PATTERN_PROBE;
}

function literal_bound_diags(value: ast.Expr, scrut: typeinfo.Type, scope: Scope, subject: string, line: i32, col: i32): util.Diag[] {
  let ty = check_expr(value, scope);
  if (!is_unknown(ty) && !is_unknown(scrut) && !settles_to(value, scrut, scope) && !coercible(ty, scrut, scope)) {
    return [dg_at("E035", subject + " of type " + type_label(ty) + " does not match scrutinee type " + type_label(scrut), line, col)];
  }
  return [];
}

function scalar_literal_diags(pattern: ast.PatLiteral, scrut: typeinfo.Type, scope: Scope, line: i32, col: i32): util.Diag[] {
  let out = literal_bound_diags(pattern.lit, scrut, scope, "literal pattern", line, col);
  if (pattern.has_range) {
    if (!is_integer(scrut) && !is_float(scrut)) {
      out = out.append(dg_at("E035", "range patterns require a numeric scrutinee, got " + type_label(scrut), line, col));
    } else if (int_is_unsigned(scrut)) {
      out = out.append(dg_at("E035", "range patterns are not yet supported on an unsigned scrutinee (" + type_label(scrut) + ")", line, col));
    }
    out = util.append_diags(out, literal_bound_diags(pattern.range_hi, scrut, scope, "range pattern bound", line, col));
  }
  return out;
}

function literal_comparison_diags(cond: ast.Expr, arm: ast.LitArm, scope: Scope): util.Diag[] {
  if let ast.ExprBinary(compare) = cond {
    let scrut = check_expr(compare.left, scope);
    let subject = "literal pattern";
    if (arm.has_range && compare.op != ">=") {
      subject = "range pattern bound";
    }
    return literal_bound_diags(compare.right, scrut, scope, subject, expr_line(arm.lit), expr_col(arm.lit));
  }
  return [];
}

// literal_arm_diags checks the condition of one chain link. The link tests the
// alternatives of one written arm, from arms[at], joined with `||`.
function literal_arm_diags(cond: ast.Expr, arms: ast.LitArm[], at: i32, last: i32, scope: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let pattern = cond;
  let arm = arms[last];
  if (arm.has_guard) {
    if (arm.is_wild) {
      return call_diags(cond, scope);
    }
    if let ast.ExprBinary(both) = cond {
      pattern = both.left;
      out = call_diags(both.right, scope);
    }
  }
  let later: ast.Expr[] = [];
  while (later.len() < last - at) {
    if let ast.ExprBinary(either) = pattern {
      if (either.op != "||") {
        break;
      }
      later = later.append(either.right);
      pattern = either.left;
    } else {
      break;
    }
  }
  out = util.append_diags(out, literal_test_diags(pattern, arms[at], scope));
  let k = later.len() - 1;
  while (k >= 0) {
    out = util.append_diags(out, literal_test_diags(later[k], arms[at + later.len() - k], scope));
    k -= 1;
  }
  return out;
}

function literal_test_diags(pattern: ast.Expr, arm: ast.LitArm, scope: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (arm.has_range) {
    if let ast.ExprBinary(bounds) = pattern {
      out = util.append_diags(out, literal_comparison_diags(bounds.left, arm, scope));
      return util.append_diags(out, literal_comparison_diags(bounds.right, arm, scope));
    }
  }
  return util.append_diags(out, literal_comparison_diags(pattern, arm, scope));
}

function literal_match_diags(chain: ast.StmtIf, scope: Scope): util.Diag[] {
  if let ast.ExprBool(wrapper) = chain.cond {
    if (wrapper.value) {
      let out: util.Diag[] = [];
      let local = scope;
      let i = 0;
      for stmt in chain.then_body {
        if (i + 1 == chain.then_body.len()) {
          if let ast.StmtIf(tail) = stmt {
            return util.append_diags(out, literal_chain_diags(tail, chain.sugar.lits, 0, local));
          }
        }
        out = util.append_diags(out, stmts_call_diags([stmt], local));
        local = bind_stmt(stmt, local);
        i += 1;
      }
      return out;
    }
  }
  return literal_chain_diags(chain, chain.sugar.lits, 0, scope);
}

function literal_chain_diags(chain: ast.StmtIf, arms: ast.LitArm[], at: i32, scope: Scope): util.Diag[] {
  let next = at + 1;
  while (next < arms.len() && arms[next].alt_cont) {
    next += 1;
  }
  let out = literal_arm_diags(chain.cond, arms, at, next - 1, scope);
  out = util.append_diags(out, stmts_call_diags(chain.then_body, scope));
  if (next < arms.len() && !(arms[next].is_wild && !arms[next].has_guard) && chain.else_body.len() == 1) {
    if let ast.StmtIf(tail) = chain.else_body[0] {
      return util.append_diags(out, literal_chain_diags(tail, arms, next, scope));
    }
  }
  return util.append_diags(out, stmts_call_diags(chain.else_body, scope));
}

function scalar_pattern_diags(m: ast.StmtMatch, mst: typeinfo.Type, cur: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (literal_match_type(mst) && ordinary_match_origin(m.origin)) {
    out = util.append_diags(out, scalar_unreachable_diags(m.arms, mst, cur));
    for arm in m.arms {
      match (arm.pattern) {
        ast.PatLiteral(literal) => {
          out = util.append_diags(out, scalar_literal_diags(literal, mst, cur, arm.line, arm.col));
        },
        ast.PatVariant(epv) => {
          if (epv.type_name.len() > 0 && scalar_binding_name(epv, mst, cur).len() == 0) {
            let expected: string = if (is_primitive_type(mst)) { "literal patterns, a binding name, or `_`" } else { "literal patterns or `_`" };
            out = out.append(dg_at("E035", "match on non-enum value `" + type_label(mst) + "` only accepts " + expected, arm.line, arm.col));
          }
        },
        _ => {}
      }
    }
  }
  return out;
}

// The then body of an unsafe block is an unsafe context.
function then_scope(f: ast.StmtIf, s: Scope): Scope {
  if (f.origin == "unsafe") {
    return Scope { ...s, in_unsafe: true };
  }
  return s;
}

function stmts_call_diags(stmts: ast.Stmt[], s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let cur = bind_mutual_siblings(stmts, s);
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        let vsc = cur;
        match (v.init) {
          ast.ExprLambda(lm) => {
            vsc = rec_local_scope(v, cur);
            cur = cur.bind(v.name, lambda_fn_type(lm, cur));
          },
          _ => {
            let ivt = check_expr(v.init, cur);
            if (is_func_type(ivt)) {
              vsc = cur.bind(v.name, ivt);
              cur = vsc;
            }
          }
        }
        let vdest = t_unknown("no declared type");
        if (v.type_name.len() > 0) {
          vdest = var_declared_type(v, vsc);
        }
        out = util.append_diags(out, dest_call_diags(v.init, vdest, vsc));
        out = util.append_diags(out, array_elem_check(array_elem_type_of(vdest), v.init, vsc));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, dest_call_diags(r.value, cur.ret_type, cur));
        out = util.append_diags(out, array_elem_check(array_elem_type_of(cur.ret_type), r.value, cur));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, call_diags(x.value, cur));
        out = util.append_diags(out, e055_diag(x.value, cur));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, dest_call_diags(a.value, cur.lookup(a.target), cur));
        out = util.append_diags(out, array_elem_check(array_elem_type_of(cur.lookup(a.target)), a.value, cur));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, sugar_exhaustive_diags(f.sugar, cur));
        if (f.sugar.lits.len() > 0) {
          out = util.append_diags(out, literal_match_diags(f, cur));
        } else {
          out = util.append_diags(out, call_diags(f.cond, cur));
          out = util.append_diags(out, stmts_call_diags(f.then_body, then_scope(f, cur)));
          out = util.append_diags(out, stmts_call_diags(f.else_body, cur));
        }
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, call_diags(w.cond, cur));
        out = util.append_diags(out, stmts_call_diags(w.body, cur));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, call_diags(fr.iter, cur));
        out = util.append_diags(out, for_iter_diags(fr, cur));
        out = util.append_diags(out, for_pattern_diags(fr, cur));
        out = util.append_diags(out, stmts_call_diags(fr.body, for_body_scope(fr, cur)));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, call_diags(m.scrutinee, cur));
        let mst = check_expr(m.scrutinee, cur);
        if (m.sugar.len() > 0) {
          let written = ast.MatchSugar { ...parser.no_match_sugar(), scrut: m.scrutinee, arms: m.sugar, line: m.line, col: m.col, origin: m.origin };
          out = util.append_diags(out, sugar_exhaustive_diags(written, cur));
        }
        if (m.origin == "if_let" || m.origin == "let_else") {
          let src_is_enum = false;
          let src_unknown_enum = false;
          match (mst) {
            typeinfo.TypeUnion(su) => {
              src_is_enum = true;
              if (!cur.has_union(su.name) && !parser.is_reserved_enum_name(su.name)) {
                src_unknown_enum = true;
                out = out.append(dg_at("E023", "unknown enum \"" + su.name + "\"", expr_line(m.scrutinee), expr_col(m.scrutinee)));
              }
            },
            _ => {}
          }
          let kind_label = "if-let";
          if (m.origin == "let_else") {
            kind_label = "let-else";
          }
          if (!src_is_enum && !is_unknown(mst)) {
            out = out.append(dg_at("E022", kind_label + " source must be an enum value, got " + type_label(mst), expr_line(m.scrutinee), expr_col(m.scrutinee)));
          } else if (m.origin == "let_else" && src_is_enum && !src_unknown_enum) {
            let le_last = m.arms.len() - 1;
            if (le_last >= 0 && !block_diverges(m.arms[le_last].body, cur.defines("exit"))) {
              out = out.append(dg_at("E022", "let-else: else branch must diverge (return / break / continue / exit)", m.line, m.col));
            }
          }
        }
        if let typeinfo.TypeStruct(msts) = mst {
          if let Some(msig) = cur.lookup_struct(msts.name) {
            if (ordinary_match_origin(m.origin) && msig.name == msts.name && msig.enum_owner.len() == 0) {
              for sarm in m.arms {
                if let ast.PatVariant(spv) = sarm.pattern {
                  if (spv.type_name.len() > 0) {
                    out = out.append(dg_at("E035", "match on struct `" + msts.name + "` only accepts struct patterns `" + msts.name + " { … }` or `_`", sarm.line, sarm.col));
                  }
                }
              }
            }
          }
        }
        out = util.append_diags(out, scalar_pattern_diags(m, mst, cur));
        match (mst) {
          typeinfo.TypeUnion(mun) => {
            if let Some(usig) = enum_sig(cur, mun.name) {
              let saw_wild = false;
              let covered: string[] = [];
              for elem in m.arms {
                match (elem.pattern) {
                  ast.PatLiteral(_) => {
                    out = out.append(dg_at("E035", "literal pattern requires a scalar scrutinee", elem.line, elem.col));
                  },
                  ast.PatWildcard(_) => {
                    if (!elem.has_guard) {
                      saw_wild = true;
                    }
                  },
                  ast.PatVariant(cpv) => {
                    if (cpv.type_name.len() > 0) {
                      out = util.append_diags(out, enum_access_diags(Some(usig), cur, elem.line, elem.col));
                      let cdp = dot_index(cpv.type_name);
                      if (cdp >= 0) {
                        let cqual = slice_unchecked(cpv.type_name, 0, cdp);
                        let cbare = slice_unchecked(cpv.type_name, cdp + 1, cpv.type_name.len());
                        if (cqual == mun.name) {
                          if (!elem.has_guard) {
                            covered = covered.append(cbare + "");
                          }
                          if (!util.has_str(usig.variants, cbare)) {
                            out = out.append(unknown_variant_diag(cur, cbare, usig, elem.line, elem.col));
                          }
                        } else if (cur.has_union(cqual)) {
                          out = out.append(dg_at("E029", "variant pattern qualifier \"" + shown_enum(cur, cqual) + "\" does not match scrutinee enum " + shown_enum(cur, mun.name), elem.line, elem.col));
                        } else {
                          out = out.append(dg_at("E087", "unknown module \"" + cqual + "\" in variant pattern", elem.line, elem.col));
                        }
                      } else {
                        if (!elem.has_guard) {
                          covered = covered.append(cpv.type_name);
                        }
                        if (!util.has_str(usig.variants, cpv.type_name)) {
                          out = out.append(unknown_variant_diag(cur, cpv.type_name, usig, elem.line, elem.col));
                        } else if (!parser.is_record_pattern(cpv) && variant_owner_count(cpv.type_name, cur.structs) >= 2) {
                          out = util.append_diags(out, payload_arity_diags(cpv, mun.name + "." + cpv.type_name, cur.structs, cur.unions, elem.line, elem.col));
                        }
                      }
                    }
                  }
                }
              }
              if (!saw_wild && m.sugar.len() == 0) {
                let lit_rows = literal_payload_rows(m.arms);
                for variant in usig.variants {
                  if (!util.has_str(covered, variant) && !rows_cover(lit_rows, mst, variant, cur)) {
                    out = out.append(dg_at("E030", "match does not cover variant " + unprefixed_variant(variant, usig.module) + " of enum " + shown_enum(cur, mun.name) + " — add an arm for it, or a `_` arm", m.line, m.col));
                  }
                }
              }
            } else if (!parser.is_reserved_enum_name(mun.name) && ordinary_match_origin(m.origin)) {
              out = out.append(dg_at("E023", "unknown enum \"" + mun.name + "\"", expr_line(m.scrutinee), expr_col(m.scrutinee)));
            }
          },
          typeinfo.TypeBool(_) => {
            out = scalar_match_exhaustive_diags(m, out, mst, cur);
          },
          typeinfo.TypeI32(_) => {
            out = scalar_match_exhaustive_diags(m, out, mst, cur);
          },
          typeinfo.TypeString(_) => {
            out = scalar_match_exhaustive_diags(m, out, mst, cur);
          },
          typeinfo.TypeFloat(_) => {
            out = scalar_match_exhaustive_diags(m, out, mst, cur);
          },
          _ => {
            if (literal_match_type(mst)) {
              out = scalar_match_exhaustive_diags(m, out, mst, cur);
            }
          }
        }
        for elem in m.arms {
          let armScope = cur;
          match (elem.pattern) {
            ast.PatLiteral(_) => {
              armScope = annotate_arm_scope(elem, cur, mst);
            },
            ast.PatVariant(apv) => {
              let foreign = false;
              match (mst) {
                typeinfo.TypeUnion(amu) => {
                  if let Some(ausig) = cur.lookup_union(amu.name) {
                    if (!util.has_str(ausig.variants, variant_pattern_name(apv.type_name))) {
                      foreign = true;
                    }
                  }
                },
                _ => {}
              }
              if (!foreign) {
                armScope = bind_variant_payloads(armScope, cur, apv, check_expr(m.scrutinee, cur));
                out = util.append_diags(out, generic_binder_diags(apv, cur, mst, elem.line, elem.col));
              }
            },
            _ => {}
          }
          if (elem.has_guard) {
            let gt = check_expr(elem.guard, armScope);
            if (!is_unknown(gt) && !type_eq(gt, t_bool())) {
              out = out.append(dg_at("E027", "match guard must be boolean, got " + type_label(gt), expr_line(elem.guard), expr_col(elem.guard)));
            }
            out = util.append_diags(out, call_diags(elem.guard, armScope));
          }
          out = util.append_diags(out, stmts_call_diags(elem.body, armScope));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, stmts_call_diags(one, cur));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function ambiguous_variants(ut: UnionTable): string[] {
  let out: string[] = [];
  let e = 0;
  while (e < ut.bnames.len()) {
    let name = ut.bnames[e];
    if (ut.unions[ut.vowner[e]].is_enum && !util.has_str(out, name) && (parser.builtin_enum_of(name).len() > 0 || second_enum_declares(ut, e))) {
      out = out.append(name);
    }
    e += 1;
  }
  return out;
}

function second_enum_declares(ut: UnionTable, e: i32): boolean {
  let k = ut.bhead[sig_name_bucket(ut.bnames[e])];
  while (k >= 0) {
    if (ut.bnames[k] == ut.bnames[e] && ut.vowner[k] != ut.vowner[e] && ut.unions[ut.vowner[k]].is_enum) {
      return true;
    }
    k = ut.bnext[k];
  }
  return false;
}

function vref_expr(e: ast.Expr, s: Scope, ambig: string[]): util.Diag[] {
  function at(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprIdent(id) => {
        let bare = unprefixed_variant(id.name, s.fn_module);
        if (util.has_str(ambig, bare) && !s.known(id.name) && !s.has_sig(id.name) && s.variant_ambiguous(id.name)) {
          return acc.append(dg_at("E036", "variant \"" + bare + "\" is declared in multiple enums — qualify the reference", id.line, id.col));
        }
        return acc;
      },
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, vref_stmts(lm.body, s, ambig));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_type_or_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      ast.ExprFieldAccess(fa) => {
        return qual_enum_name(fa.obj, s).len() == 0;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_expr_pruned(e, no_diags(), at, not_into_type_or_lambda);
}

function vref_stmts(stmts: ast.Stmt[], s: Scope, ambig: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, vref_expr(v.init, cur, ambig));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, vref_expr(r.value, cur, ambig));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, vref_expr(x.value, cur, ambig));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, vref_expr(a.value, cur, ambig));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, vref_expr(f.cond, cur, ambig));
        out = util.append_diags(out, vref_stmts(f.then_body, cur, ambig));
        out = util.append_diags(out, vref_stmts(f.else_body, cur, ambig));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, vref_expr(w.cond, cur, ambig));
        out = util.append_diags(out, vref_stmts(w.body, cur, ambig));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, vref_expr(fr.iter, cur, ambig));
        out = util.append_diags(out, vref_stmts(fr.body, for_body_scope(fr, cur), ambig));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, vref_expr(m.scrutinee, cur, ambig));
        for arm in m.arms {
          out = util.append_diags(out, vref_stmts(arm.body, cur, ambig));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, vref_stmts(one, cur, ambig));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function assign_diags(a: ast.StmtAssign, cur: Scope, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  if (!cur.defines(a.target) && cur.sig_is_const(a.target)) {
    out = out.append(dg_at("E091", "cannot assign to const " + a.target, a.target_line, a.target_col));
  } else if (!cur.defines(a.target)) {
    out = out.append(undefined_name(a.target, cur, a.target_line, a.target_col));
  } else if (cur.is_const_param(a.target)) {
    out = out.append(dg_at("E091", "cannot assign to const parameter " + a.target + ": it is the constant its instance is made for", a.target_line, a.target_col));
  } else {
    out = assign_value_diags(a.value, cur.lookup(a.target), "variable \"" + a.target + "\"", !parser.is_value_local_name(a.target), a.line, a.col, cur, unions);
  }
  return out;
}

// assign_value_diags checks an assigned value against its destination type tt; what names the destination in E003.
function assign_value_diags(value: ast.Expr, tt: typeinfo.Type, what: string, report_misfit: boolean, line: i32, col: i32, cur: Scope, unions: UnionSig[]): util.Diag[] {
  let vt = check_expr(value, cur);
  let out = int_dest_range_diags(value, tt);
  out = util.append_diags(out, ctor_payload_diags(value, tt, cur));
  let abound = dest_bound_diags(value, tt, cur);
  out = util.append_diags(out, abound);
  let misfit = !settles_to_dest(value, tt, cur) && !(type_assignable(vt, tt, unions) && dyn_conforms(vt, tt, cur));
  if (report_misfit && abound.len() == 0 && !is_unknown(tt) && !is_unknown(vt) && (misfit || fills_unsettled_argument(vt, tt))) {
    out = out.append(dg_at("E003", what + ": expected " + type_label(tt) + ", got " + type_label(vt) + str_copy_hint(vt, tt), line, col));
  }
  return out;
}

// place_assign_diags checks `place = value` for a field or element place, which the parser desugars to __set_field / __set_index.
function place_assign_diags(place: ast.Expr, value: ast.Expr, line: i32, col: i32, s: Scope): util.Diag[] {
  let pt = check_expr(place, s);
  let out = util.append_diags(assign_value_diags(value, pt, "assignment", true, line, col, s, s.unions.unions), array_elem_check(array_elem_type_of(pt), value, s));
  match (place) {
    ast.ExprFieldAccess(fa) => {
      return out.append(dg_at("E048", "cannot assign to field \"" + fa.field + "\": fields are immutable after construction; rebuild with `T { ...old, " + fa.field + ": value }`", fa.line, fa.col));
    },
    _ => {
      return out.append(dg_at("E056", "cannot assign to an array element: subscripts are read-only after construction; use `arr = arr.with(i, value)`", expr_line(place), expr_col(place)));
    }
  }
}

function assign_stmt_own_lambdas(st: ast.Stmt, cur: Scope, unions: UnionSig[]): util.Diag[] {
  if let ast.StmtMatch(m) = st {
    let subject: ast.Stmt = ast.StmtExpr { value: m.scrutinee, line: m.line, op: "" };
    let out = assign_stmt_own_lambdas(subject, cur, unions);
    let whole = check_expr(m.scrutinee, cur);
    for arm in m.arms {
      if (arm.has_guard) {
        let guard: ast.Stmt = ast.StmtExpr { value: arm.guard, line: arm.line, op: "" };
        out = util.append_diags(out, assign_stmt_own_lambdas(guard, annotate_arm_scope(arm, cur, whole), unions));
      }
    }
    return out;
  }
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, stmts_assign_diags(lm.body, lambda_body_scope(lm, cur), unions));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, not_into_lambda);
}

function init_fits(init: ast.Expr, t: typeinfo.Type, declared: typeinfo.Type, s: Scope): boolean {
  return settles_to_dest(init, declared, s) || semtypes.lends_array(t, declared) || coercible(t, declared, s);
}

function stmts_assign_diags(stmts: ast.Stmt[], s: Scope, unions: UnionSig[]): util.Diag[] {
  return stmts_assign_diags_mode(stmts, s, unions, false);
}

function var_pattern_diags(v: ast.StmtVar, s: Scope, tuple_pattern: boolean): util.Diag[] {
  let out = struct_destr_diags(v, s);
  let positions = split_pattern_names(v.name);
  if (!tuple_pattern && positions.len() > 1 && !parser.is_struct_destr_marker(v.type_name)) {
    out = util.append_diags(out, tuple_destr_diags(check_expr(v.init, s), positions.len(), v.line, v.col));
  }
  return out;
}

// An unannotated map local that settle_literal_locals could not give a type.
function open_map_diags(v: ast.StmtVar, s: Scope): util.Diag[] {
  if (v.type_name.len() > 0 || !bare_map(check_expr(v.init, s))) {
    return [];
  }
  return [dg_at("E020", "map \"" + v.name + "\" needs a type annotation: no use gives the types of its keys and values", v.line, v.col)];
}

function stmts_assign_diags_mode(stmts: ast.Stmt[], s: Scope, unions: UnionSig[], tuple_pattern: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  let cur = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name) && !vb_placeholder_decl(v)) {
          let declared = var_declared_type(v, cur);
          let initt = check_expr(v.init, cur);
          if (!mlit_is_desugared(v.init)) {
            out = util.append_diags(out, e045_annot_diags(v.type_name, expr_line(v.init), expr_col(v.init), cur));
          }
          out = util.append_diags(out, int_dest_range_diags(v.init, declared));
          out = util.append_diags(out, ctor_payload_diags(v.init, declared, cur));
          let vbound = dest_bound_diags(v.init, declared, cur);
          out = util.append_diags(out, vbound);
          if (vbound.len() == 0 && !is_unknown(declared) && !is_unknown(initt) && !init_fits(v.init, initt, declared, cur)) {
            out = out.append(dg_at("E003", "variable \"" + v.name + "\": expected " + type_label(declared) + ", got " + type_label(initt) + str_copy_hint(initt, declared), v.line, v.col));
          }
          if (vbound.len() == 0 && is_unknown(declared) && !is_unknown(initt) && util.index_of_str(cur.tparams, v.type_name) < 0 && e064_unknown_bare(v.type_name, cur.type_names())) {
            out = out.append(dg_at("E003", "variable \"" + v.name + "\": expected " + v.type_name + ", got " + type_label(initt), v.line, v.col));
          }
        }
        if (v.type_name.len() == 0 && int_literal_tree(v.init)) {
          out = util.append_diags(out, int_range_diags(v.init, "i64", false));
        }
        out = util.append_diags(out, open_map_diags(v, cur));
        out = util.append_diags(out, var_pattern_diags(v, cur, tuple_pattern));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, assign_diags(a, cur, unions));
      },
      ast.StmtIf(f) => {
        let ic = check_expr(f.cond, cur);
        if (!is_unknown(ic) && !type_eq(ic, t_bool())) {
          out = out.append(dg_at("E008", "if condition must be boolean, got " + type_label(ic), expr_line(f.cond), expr_col(f.cond)));
        }
        out = util.append_diags(out, stmts_assign_diags_mode(f.then_body, cur, unions, f.sugar.tup.len() > 0));
        out = util.append_diags(out, stmts_assign_diags(f.else_body, cur, unions));
      },
      ast.StmtWhile(w) => {
        let wc = check_expr(w.cond, cur);
        if (!is_unknown(wc) && !type_eq(wc, t_bool())) {
          out = out.append(dg_at("E008", "while condition must be boolean, got " + type_label(wc), expr_line(w.cond), expr_col(w.cond)));
        }
        out = util.append_diags(out, stmts_assign_diags(w.body, cur, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, stmts_assign_diags(fr.body, for_body_scope(fr, cur), unions));
      },
      ast.StmtMatch(m) => {
        for elem in m.arms {
          let asc = annotate_arm_scope(elem, cur, check_expr(m.scrutinee, cur));
          out = util.append_diags(out, stmts_assign_diags(elem.body, asc, unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, stmts_assign_diags(one, cur, unions));
      },
      _ => {}
    }
    out = util.append_diags(out, assign_stmt_own_lambdas(st, cur, unions));
    cur = bind_stmt(st, cur);
  }
  return out;
}

pub struct ModuleTypes { sigs: FuncSig[], top_tys: typeinfo.Type[], all_well_typed: boolean, diags: util.Diag[] }

pub function is_build_gate_code(code: string): boolean {
  return util.is_diagnostic_code(code);
}

pub function build_gate_diags(mod: parser.Module): util.Diag[] {
  return build_gate_diags_with_file(mod, "");
}

pub function build_gate_diags_with_file(mod: parser.Module, entry_file: string): util.Diag[] {
  let cgd = const_init_diags(mod);
  if (cgd.len() > 0) {
    return cgd;
  }
  return filter_build_gate(check_module_with_file(mod, entry_file).diags);
}

pub function build_runtime_gate_diags(mod: parser.Module): util.Diag[] {
  return build_runtime_gate_diags_with_file(mod, "");
}

pub function build_runtime_gate_diags_with_file(mod: parser.Module, entry_file: string): util.Diag[] {
  let cgd = const_init_diags(mod);
  if (cgd.len() > 0) {
    return cgd;
  }
  return filter_build_gate(check_module_raw_floor(mod, entry_file, true).diags);
}

pub function filter_build_gate(diags: util.Diag[]): util.Diag[] {
  let out: util.Diag[] = [];
  for diag in diags {
    if (is_build_gate_code(diag.code)) {
      out = out.append(diag);
    }
  }
  return out;
}

function dg(code: string, message: string): util.Diag {
  return dg_at(code, message, 0, 0);
}

function dg_at(code: string, message: string, line: i32, col: i32): util.Diag {
  return util.Diag { related: [], length: 0, code: code, message: util.show_type_vars(message), line: line, col: col, fix: None };
}

function with_fix(d: util.Diag, old: string, line: i32, col: i32, to: string, note: string): util.Diag {
  if (to.len() == 0 || line <= 0) {
    return d;
  }
  return util.Diag { ...d, fix: Some(util.Fix { line: line, col: col, old: old, new_text: to, title: "replace `" + old + "` with `" + to + "`" + note }) };
}

function literal_field_fix(d: util.Diag, sl: ast.ExprStructLit, i: i32, fields: string[]): util.Diag {
  if (i >= sl.field_lines.len()) {
    return d;
  }
  return with_fix(d, sl.field_names[i], sl.field_lines[i], sl.field_cols[i], util.suggest(sl.field_names[i], fields), "");
}

function (s: Scope) member_fix(d: util.Diag, fa: ast.ExprFieldAccess, st: StructSig): util.Diag {
  return access_fix(d, fa, util.append_all(st.field_names, s.methods_in_namespace(st.name)));
}

function access_fix(d: util.Diag, fa: ast.ExprFieldAccess, members: string[]): util.Diag {
  return with_fix(d, fa.field, fa.line, fa.col + 1, util.suggest(fa.field, members), "");
}

function (s: Scope) method_fix(d: util.Diag, fa: ast.ExprFieldAccess, recv: typeinfo.Type): util.Diag {
  let ns = method_namespace_of(recv);
  if (retired_collection_spelling(ns, fa.field).len() > 0) {
    return d;
  }
  return access_fix(d, fa, s.method_fix_candidates(ns, recv));
}

function undefined_name(name: string, s: Scope, line: i32, col: i32): util.Diag {
  if (name == parser.RANGE_MODULE) {
    return dg_at("E001", range_import_msg(), line, col);
  }
  let d = util.Diag { ...dg_at("E001", "cannot find \"" + name + "\" in this scope", line, col), length: util.show_type_vars(name).len() };
  if (name == "string_from_bytes") {
    return with_fix(d, name, line, col, "string_from_bytes_unchecked", " (or `std/utf8.from_bytes`, which validates and returns `Result[string, Utf8Error]`)");
  }
  return with_fix(d, name, line, col, util.suggest(name, s.visible_names()), "");
}

function (s: Scope) visible_names(): string[] {
  let out: string[] = [];
  let i = s.names.len() - 1;
  while (i >= 0) {
    out = astwalk.append_bound_name(out, s.names[i]);
    i -= 1;
  }
  let funcs = parser.builtin_function_names();
  for sig in s.sigs.sigs {
    if (sig.receiver.len() == 0) {
      funcs = funcs.append(sig.name);
    }
  }
  return util.append_all(out, util.sorted_by(funcs, name_after));
}

function name_after(a: string, b: string): boolean {
  return a > b;
}

struct ScalarCoverage { all: boolean, yes: boolean, no: boolean }

function scalar_arm_coverage(arm: ast.MatchArm, whole: typeinfo.Type, scope: Scope, covered: ScalarCoverage): ScalarCoverage {
  if (arm.has_guard) {
    return covered;
  }
  match (arm.pattern) {
    ast.PatVariant(pv) => {
      return ScalarCoverage { ...covered, all: covered.all || scalar_binding_name(pv, whole, scope).len() > 0 };
    },
    ast.PatLiteral(literal) => {
      if (!literal.has_range) {
        if let ast.ExprBool(value) = literal.lit {
          return ScalarCoverage { ...covered, yes: covered.yes || value.value, no: covered.no || !value.value };
        }
      }
    },
    ast.PatWildcard(_) => {
      return ScalarCoverage { ...covered, all: true };
    }
  }
  return covered;
}

function scalar_match_exhaustive_diags(m: ast.StmtMatch, acc: util.Diag[], whole: typeinfo.Type, scope: Scope): util.Diag[] {
  if (m.origin.len() > 0) {
    return acc;
  }
  let boolean_tag: boolean = match (whole) { typeinfo.TypeBool(_) => true, _ => false };
  let covered = ScalarCoverage { all: false, yes: false, no: false };
  for arm in m.arms {
    covered = scalar_arm_coverage(arm, whole, scope, covered);
  }
  if (covered.all || boolean_tag && covered.yes && covered.no) {
    return acc;
  }
  if (boolean_tag) {
    return acc.append(dg_at("E030", "match on boolean is not exhaustive — add the missing `true` or `false` arm, or an unguarded `_`", m.line, m.col));
  }
  return acc.append(dg_at("E030", "match on non-enum value is not exhaustive — add an unguarded `_` arm", m.line, m.col));
}

function expr_line(e: ast.Expr): i32 {
  return ast.expr_line(e);
}

function expr_col(e: ast.Expr): i32 {
  return ast.expr_col(e);
}

function dup_name_before(names: string[], idx: i32): boolean {
  let j = 0;
  while (j < idx) {
    if (names[j] == names[idx]) {
      return true;
    }
    j += 1;
  }
  return false;
}

function receiver_namespace(rt: string): string {
  if (rt == "str") {
    return "string";
  }
  return rt;
}

function receiver_type_ok(rt: string, mod: parser.Module): boolean {
  if (rt.len() == 0) {
    return true;
  }
  if (rt == "i32" || rt == "i64" || rt == "u8" || rt == "u32" || rt == "u64" || rt == "usize" || rt == "boolean" || rt == "string" || rt == "str" || rt == "f64" || rt == "f32" || rt == "char" || typeinfo.lanes_width(rt) > 0) {
    return true;
  }
  for ch in rt {
    if (ch == b'[') {
      return true;
    }
  }
  if (rt.len() >= 4 && slice_unchecked(rt, 0, 4) == "dyn " || parser.tuple_namespace(rt).len() > 0) {
    return true;
  }
  let base = util.base_type_name(rt);
  if (parser.is_reserved_struct_name(base) || parser.is_reserved_enum_name(base)) {
    return true;
  }
  for sd in mod.structs {
    if (sd.name == base) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == base) {
      return true;
    }
  }
  for alias in mod.aliases {
    if (alias.name == base) {
      return true;
    }
  }
  return false;
}

function const_literal(e: ast.Expr): boolean {
  match (e) {
    ast.ExprBytes(_) => {
      return true;
    },
    ast.ExprNumber(_) => {
      return true;
    },
    ast.ExprString(_) => {
      return true;
    },
    ast.ExprBool(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function const_unary_err(u: ast.ExprUnary, earlier: string[]): string {
  if (util.str_has_prefix(u.op, "as_")) {
    return "expression is not a constant (only literals, earlier consts, and arithmetic / comparison / logical operations on them are allowed)";
  }
  return const_expr_err(u.operand, earlier);
}

function const_struct_err(st: ast.ExprStructLit, earlier: string[]): string {
  if (st.has_base) {
    return "expression is not a constant (only literals, earlier consts, and arithmetic / comparison / logical operations on them are allowed)";
  }
  return const_elems_err(st.field_values, earlier);
}

function const_binary_err(b: ast.ExprBinary, earlier: string[]): string {
  if (const_refused_op(b.op)) {
    return "operator `" + b.op + "` not allowed in integer constant expressions";
  }
  let le = const_expr_err(b.left, earlier);
  if (le.len() > 0) {
    return le;
  }
  return const_expr_err(b.right, earlier);
}

function const_expr_err(e: ast.Expr, earlier: string[]): string {
  if (const_literal(e)) {
    return "";
  }
  match (e) {
    ast.ExprIdent(id) => {
      if (util.has_str(earlier, id.name)) {
        return "";
      }
      return "\"" + id.name + "\" is not a constant (must reference an earlier `const` declaration)";
    },
    ast.ExprUnary(u) => {
      return const_unary_err(u, earlier);
    },
    ast.ExprArray(a) => {
      return const_elems_err(a.elements, earlier);
    },
    ast.ExprTuple(t) => {
      return const_elems_err(t.elements, earlier);
    },
    ast.ExprStructLit(st) => {
      return const_struct_err(st, earlier);
    },
    ast.ExprBinary(b) => {
      return const_binary_err(b, earlier);
    },
    _ => {}
  }
  return "expression is not a constant (only literals, earlier consts, and arithmetic / comparison / logical operations on them are allowed)";
}

function const_elems_err(elems: ast.Expr[], earlier: string[]): string {
  for el in elems {
    let ee = const_expr_err(el, earlier);
    if (ee.len() > 0) {
      return ee;
    }
  }
  return "";
}

// The E093s to report at once, and for each const that waits for the type
// check, the E093 to report when its initializer is well-typed.
struct ConstInit { diags: util.Diag[], deferred: string[], messages: string[] }

function const_init_diags(mod: parser.Module): util.Diag[] {
  return const_init(mod).diags;
}

// The consts of `mod` in the order to fold them. A const comes after each
// const of another module that its initializer reads, so a module can use
// the consts of a module it imports whatever the merge order is. Within a
// module the source order stays, so a forward reference stays an error.
// Consts on a cycle keep their order and get the diagnostic they had.
function const_fold_order(mod: parser.Module): parser.FuncDecl[] {
  let pending: parser.FuncDecl[] = [];
  let names: string[] = [];
  let modules: string[] = [];
  for fd in mod.funcs {
    if (fd.is_const && fd.receiver_type.len() == 0) {
      pending = pending.append(fd);
      names = names.append(fd.name);
      modules = modules.append(fd.module);
    }
  }
  let done: string[] = [];
  let out: parser.FuncDecl[] = [];
  while (pending.len() > 0) {
    let next: parser.FuncDecl[] = [];
    let blocked: string[] = [];
    for fd in pending {
      if (util.has_str(blocked, fd.module) || !const_ready(fd, names, modules, done)) {
        blocked = blocked.append(fd.module);
        next = next.append(fd);
      } else {
        out = out.append(fd);
        done = done.append(fd.name);
      }
    }
    if (next.len() == pending.len()) {
      return out.concat(next);
    }
    pending = next;
  }
  return out;
}

// True when each const of another module that `fd` reads is in `done`.
function const_ready(fd: parser.FuncDecl, names: string[], modules: string[], done: string[]): boolean {
  for stmt in fd.body {
    if let ast.StmtReturn(r) = stmt {
      for id in astwalk.collect_idents_expr(r.value, []) {
        let k = util.index_of_str(names, id);
        if (k >= 0 && modules[k] != fd.module && !util.has_str(done, id)) {
          return false;
        }
      }
    }
  }
  return true;
}

function const_init(mod: parser.Module): ConstInit {
  let out = ConstInit { diags: [], deferred: [], messages: [] };
  let earlier: string[] = [];
  let evaluated_names: string[] = [];
  let values: consteval.Value[] = [];
  for fd in const_fold_order(mod) {
    if (fd.is_const && fd.receiver_type.len() == 0) {
      for stmt in fd.body {
        if let ast.StmtReturn(r) = stmt {
          let pre = const_pre_diags(fd, r.value, earlier);
          if (pre.len() > 0) {
            out = ConstInit { ...out, diags: util.append_diags(out.diags, pre) };
            continue;
          }
          let value = consteval.settle(consteval.evaluate(r.value, parser.parse_type_ref(fd.ret_type), evaluated_names, values), fd.ret_type);
          if (value.definite) {
            out = ConstInit { ...out, diags: out.diags.append(dg_at("E093", "const " + fd.name + ": " + value.error, fd.line, fd.col)) };
            continue;
          }
          evaluated_names = evaluated_names.append(fd.name);
          values = values.append(consteval.held(value));
          if (value.error.len() > 0 && !consteval.reads_deferred(value)) {
            out = ConstInit { ...out, deferred: out.deferred.append(fd.name), messages: out.messages.append("const " + fd.name + ": " + value.error) };
          }
        }
      }
      earlier = earlier.append(fd.name);
    }
  }
  return out;
}

function const_pre_diags(fd: parser.FuncDecl, value: ast.Expr, earlier: string[]): util.Diag[] {
  let msg = const_expr_err(value, earlier);
  if (msg.len() > 0) {
    return [dg_at("E093", "const " + fd.name + ": " + msg, fd.line, fd.col)];
  }
  return util.append_diags(suffix_range_stmts(fd.body), int_range_diags(value, fd.ret_type, false));
}

// A deferred const's E093 is reported only when its initializer type-checks.
function deferred_const_diags(fd: parser.FuncDecl, init: ConstInit, found: util.Diag[]): util.Diag[] {
  let k = util.index_of_str(init.deferred, fd.name);
  if (k < 0 || found.len() > 0) {
    return [];
  }
  return [dg_at("E093", init.messages[k], fd.line, fd.col)];
}

function is_script(mod: parser.Module): boolean {
  for fd in mod.funcs {
    if (fd.name == "main" && fd.receiver_type.len() == 0) {
      return false;
    }
  }
  return mod.top_stmts.len() > 0;
}

function handler_state_diags(mod: parser.Module): util.Diag[] {
  let init_idx = -1;
  let handle_idx = -1;
  let i = 0;
  for fd in mod.funcs {
    if (fd.name == "main") {
      return [];
    }
    if (fd.receiver_type.len() == 0) {
      if (fd.name == "init" && init_idx < 0) {
        init_idx = i;
      }
      if (fd.name == "handle" && handle_idx < 0) {
        handle_idx = i;
      }
    }
    i += 1;
  }
  if (handle_idx < 0) {
    return [];
  }
  let returns_state = false;
  if (init_idx >= 0) {
    let init_fd = mod.funcs[init_idx];
    if (init_fd.params.len() > 1 || init_fd.params.len() == 1 && !parser.is_platform_param(init_fd, 0, parser.std_qualifier(mod, "platform"))) {
      return [dg_at("E075", "`init` takes " + util.i32_to_string(init_fd.params.len()) + " parameters; it takes none, or the platform alone", init_fd.line, init_fd.col)];
    }
    let kind = parser.init_return_kind(init_fd.ret_type, parser.std_qualifier(mod, "serve"));
    returns_state = kind == 1 || kind == 3;
  }
  let handle = mod.funcs[handle_idx];
  let takes_state = handle.params.len() == 3;
  if (takes_state && !returns_state) {
    return [dg_at("E075", "handler takes a state parameter, but no `init` produces the state to thread through it", handle.line, handle.col)];
  }
  if (returns_state && !takes_state) {
    let init = mod.funcs[init_idx];
    return [dg_at("E075", "`init` returns a value, but the handler takes no state parameter to thread it through", init.line, init.col)];
  }
  let j = 0;
  for fd in mod.funcs {
    if (fd.name == "shutdown" && fd.receiver_type.len() == 0) {
      if (fd.params.len() == 2 && !takes_state) {
        return [dg_at("E075", "`shutdown` takes a state parameter, but no `init` produces the state to hand it", fd.line, fd.col)];
      }
      if (fd.params.len() == 1 && takes_state) {
        return [dg_at("E075", "`shutdown` takes no state parameter, but the handler threads a state it would drop", fd.line, fd.col)];
      }
      return [];
    }
    j += 1;
  }
  return [];
}

function e078_payload_count(structs: parser.StructDecl[], ename: string, vname: string): i32 {
  for sd in structs {
    if (sd.enum_owner == ename && sd.name == vname) {
      return sd.fields.len();
    }
  }
  return -1;
}

function e078_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for ed in mod.enums {
    if (ed.try_marker) {
      if (ed.variant_names.len() != 2) {
        out = out.append(dg_at("E078", "@try enum " + ed.name + " must have exactly two variants — a success variant then a failure variant — but has " + util.i32_to_string(ed.variant_names.len()), ed.line, ed.col));
      } else {
        let ok_n = e078_payload_count(mod.structs, ed.name, ed.variant_names[0]);
        let fail_n = e078_payload_count(mod.structs, ed.name, ed.variant_names[1]);
        if (ok_n >= 0 && ok_n != 1) {
          out = out.append(dg_at("E078", "@try enum " + ed.name + ": the success variant \"" + ed.variant_names[0] + "\" must carry exactly one payload, but carries " + util.i32_to_string(ok_n), ed.line, ed.col));
        } else {
          if (fail_n > 1) {
            out = out.append(dg_at("E078", "@try enum " + ed.name + ": the failure variant \"" + ed.variant_names[1] + "\" must carry at most one payload, but carries " + util.i32_to_string(fail_n), ed.line, ed.col));
          }
        }
      }
    }
  }
  return out;
}

struct E079Probe { found: boolean, line: i32, col: i32 }

function e079_note_try(e: ast.Expr, own acc: E079Probe): E079Probe {
  if (acc.found) {
    return acc;
  }
  if let ast.ExprUnary(u) = e {
    if (u.op == "try_") {
      return E079Probe { found: true, line: u.line, col: u.col };
    }
  }
  return acc;
}

function e079_not_lambda(e: ast.Expr): boolean {
  if let ast.ExprLambda(lam) = e {
    return parser.is_value_block_origin(lam.origin);
  }
  return true;
}

function e079_no_expr(e: ast.Expr, own acc: util.Diag[]): util.Diag[] {
  return acc;
}

function e079_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for fd in mod.funcs {
    for stmt in fd.body {
      out = astwalk.fold_stmt_nodes(stmt, out, e079_visit_stmt, e079_no_expr, astwalk.descend_all);
    }
  }
  return out;
}

function e079_visit_stmt(st: ast.Stmt, own acc: util.Diag[]): util.Diag[] {
  if let ast.StmtDefer(d) = st {
    let probe: E079Probe = astwalk.fold_stmt_pruned(
      d.action,
      E079Probe { found: false, line: 0, col: 0 }, e079_note_try, e079_not_lambda,
    );
    if (probe.found) {
      let kind = "a `defer`";
      if (d.on_error != 0) {
        kind = "an `errdefer`";
      }
      return acc.append(dg_at("E079", "`?` is not allowed inside " + kind + " action: it propagates a failure to the caller, and a deferred action has no caller to propagate to", probe.line, probe.col));
    }
  }
  return acc;
}

function registered_intrinsics(): string[] {
  return [
    "__primitive_char_to_string", "__primitive_f32_to_string", "__primitive_f64_to_string", "__primitive_i32_to_string", "__primitive_i64_to_string", "__primitive_string_to_string", "__primitive_u32_to_string", "__primitive_u64_to_string", "__primitive_u8_to_string", "__primitive_usize_to_string",
    "__task_cancelled", "__task_cur", "__task_enter", "__task_free", "__task_leave", "__task_new", "__task_park", "__task_park_until", "__task_set_cancelled", "__task_set_ready", "__task_timeout", "__task_until", "__task_wait",
    "__send_copy", "__send_adopt", "__send_root", "__send_release", "__heap_adopt", "__worker_region", "__worker_exit", "__worker_reap", "__worker_unmap",
    "__abs_f64", "__aes_ctr32", "__aes_expand_key", "__aes_gcm_open_into", "__aes_gcm_seal_into", "__ghash", "__sha256_hw", "__sha256_hw_blocks", "__sha1_hw", "__sha1_hw_blocks", "__alloc", "__alloc_bool", "__alloc_i32", "__alloc_i64", "__alloc_reuse", "__alloc_u8", "__arr_push_shared_bytes", "__arr_push_shared_count", "__arr_set_len",
    "__ascii_run", "__bsd_sum", "__c_call0", "__c_call0_f32", "__c_call0_f64", "__c_call1", "__c_call1_f32",
    "__c_call1_f64", "__c_call2", "__c_call2_f32", "__c_call2_f64", "__c_call3", "__c_call3_f32", "__c_call3_f64",
    "__c_call4", "__c_call4_f32", "__c_call4_f64", "__c_call5", "__c_call5_f32", "__c_call5_f64",
    "__c_call6", "__c_call6_f32", "__c_call6_f64", "__ceil_f64", "__clz32", "__clz64", "__count_byte",
    "__bytes_into", "__bytes_owned", "__bytes_range", "__count_runs", "__count_runs_bytes", "__crc32_cksum", "__ct_public", "__ct_secret", "__ctz32", "__ctz64", "__fern_arr_dec", "__fern_box_free", "__fern_drop_arr_ptr",
    "__fern_rc_dec", "__fern_rc_inc", "__fern_str_dec", "__floor_f64", "__free", "__heap_alloc_count", "__heap_bump_bytes",
    "__account_entry", "__heap_mark", "__heap_release_to", "__load_i32", "__load_i64", "__load_ptr", "__load_u8",
    "__mmio_load8", "__mmio_load16", "__mmio_load32", "__mmio_load64", "__mmio_store8", "__mmio_store16", "__mmio_store32", "__mmio_store64", "__fence", "__wfi", "__hvc", "__smc", "__boot_info",
    "__port_in8", "__port_in16", "__port_in32", "__port_out8", "__port_out16", "__port_out32",
    "__map_hash_seed", "__memchr", "__mulhi_u64", "__count_byte_bytes", "__count_below_u64", "__crc32_cksum_array", "__crc32_ieee_array", "__sum_bytes_array", "__bsd_sum_bytes", "__memchr_bytes", "__mismatch_bytes", "__mismatch_bytes_str", "__rmemchr_bytes", "__memcpy", "__memset", "__mismatch", "__popcount32", "__popcount64",
    "__ptr_width", "__rc_dec", "__rc_get", "__rc_inc", "__rc_underflow_count", "__rmemchr",
    "__round_f64", "__scale_f64", "__outer_mul_f64", "__inner_mul_add_f64", "__scan_set", "__scan_set_bytes", "__sqrt_f64", "__store_i32", "__store_i64",
    "__store_ptr", "__store_u8", "__str_bytes", "__str_hash", "__sum_bytes", "__syscall3", "__syscall4", "__syscall5", "__syscall6", "__trunc_f64",
    "__fd_close", "__tcp_close_unchecked", "__socket_from_fd",
    "__f64x2_splat", "__f64x2_of", "__f64x2_lane", "__f64x2_bitmask", "__f64x2_mul_add", "__f64x2_sqrt", "__f64x2_abs", "__f64x2_floor", "__f64x2_round", "__f64x2_min", "__f64x2_max", "__f64x2_lt", "__f64x2_ne", "__f64x2_select", "__f64x2_load", "__f64x2_with",
    "__f32x4_splat", "__f32x4_of", "__f32x4_lane", "__f32x4_bitmask", "__f32x4_mul_add", "__f32x4_sqrt", "__f32x4_abs", "__f32x4_floor", "__f32x4_round", "__f32x4_min", "__f32x4_max", "__f32x4_lt", "__f32x4_ne", "__f32x4_select", "__f32x4_load", "__f32x4_with",
  ];
}

function redeclares(funcs: parser.FuncDecl[], names: util.NameIndex, di: i32): boolean {
  let f2 = funcs[di];
  let earlier = redeclares_preregistered(f2);
  let ej = names.chain(decl_key(f2));
  while (ej >= 0 && ej < di) {
    let pe = funcs[ej];
    if (f2.receiver_type.len() == 0 && pe.receiver_type.len() == 0 && pe.name == f2.name) {
      earlier = true;
    }
    if (same_method_decl(pe, f2)) {
      earlier = true;
    }
    ej = names.next[ej];
  }
  // A free function named like a builtin or an intrinsic redeclares it, as
  // native's pre-registered signature makes it there.
  if (f2.receiver_type.len() == 0 && !is_primitive_display_builtin(f2.name) && (builtinsigs.builtin_row(f2.name).len() > 0 || util.has_str(registered_intrinsics(), f2.name))) {
    earlier = true;
  }
  return earlier;
}

function redeclares_preregistered(f2: parser.FuncDecl): boolean {
  if (f2.receiver_type.len() == 0) {
    return false;
  }
  return util.has_str(preregistered_methods(parser.receiver_namespace(f2.receiver_type)), f2.name);
}

function decl_key(fd: parser.FuncDecl): string {
  if (parser.receiver_namespace(fd.receiver_type) == "Map" && fd.name == "__iterator") {
    return "iter";
  }
  if (fd.receiver_type.len() == 0) {
    return fd.name;
  }
  return method_simple_name(fd.name);
}

function same_method_decl(pe: parser.FuncDecl, f2: parser.FuncDecl): boolean {
  if (f2.receiver_type.len() == 0 || pe.receiver_type.len() == 0 || decl_key(pe) != decl_key(f2)) {
    return false;
  }
  if (pe.impl_trait.len() == 0 && f2.impl_trait.len() == 0 && pe.module != f2.module && !iteration_protocol(pe) && !iteration_protocol(f2)) {
    return false;
  }
  return pe.impl_trait == f2.impl_trait && parser.receiver_namespace(pe.receiver_type) == parser.receiver_namespace(f2.receiver_type);
}

// Map's iteration protocol method stays one per program, like a built-in method.
function iteration_protocol(fd: parser.FuncDecl): boolean {
  return parser.receiver_namespace(fd.receiver_type) == "Map" && method_simple_name(fd.name) == "__iterator";
}

function method_ambiguity_diags(mod: parser.Module): util.Diag[] {
  let order: i32[] = [];
  for entry in [true, false] {
    let i = 0;
    while (i < mod.funcs.len()) {
      let in_entry = mod.funcs[i].module.len() == 0;
      if (in_entry == entry && mod.funcs[i].receiver_type.len() > 0) {
        order = order.append(i);
      }
      i += 1;
    }
  }
  let keys: string[] = [];
  let inherent: i32[] = [];
  let traited: i32[] = [];
  let out: util.Diag[] = [];
  for fi in order {
    let fd = mod.funcs[fi];
    let key = parser.receiver_namespace(fd.receiver_type) + "." + method_simple_name(fd.name);
    let k = util.index_of_str(keys, key);
    if (k < 0) {
      k = keys.len();
      keys = keys.append(key);
      inherent = inherent.append(-1);
      traited = traited.append(-1);
    }
    let other = inherent[k];
    if (fd.impl_trait.len() == 0) {
      other = traited[k];
    }
    if (other >= 0) {
      out = out.append(ambiguous_method_diag(mod, fd, mod.funcs[other]));
    } else if (fd.impl_trait.len() == 0) {
      inherent = inherent.with(k, fi);
    } else if (traited[k] < 0) {
      traited = traited.with(k, fi);
    }
  }
  return out;
}

function method_simple_name(name: string): string {
  let i = name.len() - 1;
  while (i >= 0 && name[i] != b'.') {
    i -= 1;
  }
  return slice_unchecked(name, i + 1, name.len()) + "";
}

function ambiguous_method_diag(mod: parser.Module, pending: parser.FuncDecl, other: parser.FuncDecl): util.Diag {
  let at = pending;
  if (pending.stdlib.len() > 0 && other.stdlib.len() == 0) {
    at = other;
  }
  let typ = util.demangle(parser.receiver_namespace(pending.receiver_type));
  let msg = "ambiguous method \"" + method_simple_name(pending.name) + "\" on " + typ + ": provided by " + method_provider(mod, pending) + " and " + method_provider(mod, other);
  return dg_at("E074", msg, at.line, at.col);
}

function method_provider(mod: parser.Module, fd: parser.FuncDecl): string {
  let what = "an inherent method";
  if (fd.impl_trait.len() > 0) {
    what = "trait " + impl_trait_spelling(mod, fd);
  }
  let file = "";
  if (fd.stdlib.len() > 0) {
    file = fd.stdlib + ".fern:";
  } else if (fd.module.len() > 0) {
    file = fd.module + ".fern:";
  }
  return what + " (declared at " + file + util.i32_to_string(util.pos_line(fd.line)) + ":" + util.i32_to_string(fd.col) + ")";
}

function impl_trait_spelling(mod: parser.Module, fd: parser.FuncDecl): string {
  let base = parser.receiver_namespace(fd.receiver_type);
  for im in mod.impls {
    if (im.trait_name == fd.impl_trait && im.trait_module.len() > 0 && parser.receiver_namespace(im.impl_type) == base) {
      return im.trait_module + "." + fd.impl_trait;
    }
  }
  return fd.impl_trait;
}

function orphan_impl_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for im in mod.impls {
    if (im.trait_name.len() == 0 || im.trait_module == im.module || impl_type_is_local(mod, im)) {
      continue;
    }
    let tr = im.trait_name;
    if (im.trait_module.len() > 0) {
      tr = im.trait_module + "." + tr;
    }
    out = out.append(dg_at("E021", "orphan impl: `impl " + tr + " for " + util.demangle(util.base_type_name(im.impl_type)) + "` must be declared in the module that defines the trait or the type", im.line, im.col));
  }
  return out;
}

function impl_type_is_local(mod: parser.Module, im: parser.ImplInfo): boolean {
  let base = util.base_type_name(im.impl_type);
  if (parser.is_reserved_struct_name(base) || parser.is_reserved_enum_name(base) || !declares_nominal(mod, base)) {
    return false;
  }
  if (im.module.len() == 0) {
    return !util.contains(base, "__");
  }
  return util.str_has_prefix(base, im.module + "__");
}

function declares_nominal(mod: parser.Module, name: string): boolean {
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == name) {
      return true;
    }
  }
  return false;
}

function main_signature_diags(fd: parser.FuncDecl, out: util.Diag[]): util.Diag[] {
  if (fd.params.len() > 0) {
    out = out.append(dg_at("E084", "main takes no parameters; read the command line with args()", fd.line, fd.col));
  }
  if (fd.ret_type != "" && !main_result_ty(fd.ret_type)) {
    out = out.append(dg_at("E084", "main returns an integer, a boolean or void, not " + fd.ret_type, fd.line, fd.col));
  }
  return out;
}

function resource_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let rn = 0;
  while (rn < mod.resources.len()) {
    let rclash = parser.resource_collision(mod, rn);
    let rdecl = mod.resources[rn];
    if (rclash == "resource") {
      out = out.append(dg_at("E006", "resource \"" + rdecl.name + "\" redeclared", rdecl.line, rdecl.col));
    } else if (rclash.len() > 0) {
      let article = "a ";
      if (rclash == "enum") {
        article = "an ";
      }
      out = out.append(dg_at("E006", "resource \"" + rdecl.name + "\" conflicts with " + article + rclash + " of the same name", rdecl.line, rdecl.col));
    }
    rn += 1;
  }
  return out;
}

function return_type_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for func in mod.funcs {
    if (func.ret_type == "" && func.body.len() > 0 && func.is_const) {
      out = out.append(dg_at("E081", "cannot infer the type of const \"" + func.name + "\"; declare it explicitly", func.line, func.col));
    } else if (func.ret_type == "" && func.import_iface == "" && !func.is_const) {
      out = out.append(dg_at("E081", "missing return type on function \"" + func.name + "\"; declare it explicitly (use `: void` if it returns nothing)", func.line, func.col));
    }
  }
  for func in mod.funcs {
    if (is_main_decl(func) && func.receiver_type == "" && func.import_iface == "") {
      out = main_signature_diags(func, out);
    }
  }
  return out;
}

// A function named main in any module, also an imported one, whose name has
// the prefix of its module.
function is_main_decl(func: parser.FuncDecl): boolean {
  return func.name == "main" || func.module.len() > 0 && func.name == func.module + "__main";
}

function alias_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let ak = 0;
  while (ak < mod.aliases.len()) {
    let alias = mod.aliases[ak];
    for msg in parser.union_alias_errors(mod, alias) {
      out = out.append(dg_at("E016", msg, alias.line, alias.col));
    }
    if (parser.alias_redeclares_enum(mod, ak)) {
      out = out.append(dg_at("E006", "enum \"" + alias.name + "\" redeclared", alias.line, alias.col));
    }
    ak += 1;
  }
  return out;
}

function export_shape_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for export in mod.exports {
    let ename = export.func_name;
    for xfd in mod.funcs {
      if (xfd.name == ename && xfd.receiver_name.len() > 0 == export.method) {
        if (xfd.all_type_params.len() > 0) {
          out = out.append(dg_at("E054", "@export function \"" + xfd.name + "\" cannot be generic (a world export has a single concrete ABI)", xfd.line, xfd.col));
        }
        if (xfd.receiver_name.len() > 0) {
          out = out.append(dg_at("E054", "@export cannot be applied to a method (\"" + xfd.name + "\"); use a top-level function", xfd.line, xfd.col));
        }
      }
    }
  }
  return out;
}

// reserved_name_diags reports each declaration under a built-in type's name.
// Such a name takes the built-in's place for every module in the bundle, so no
// later diagnostic can be trusted.
function reserved_name_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for ed in mod.enums {
    if (parser.is_reserved_enum_name(ed.name) || parser.is_reserved_struct_name(ed.name)) {
      out = out.append(dg_at("E010", "enum \"" + ed.name + "\" is a reserved built-in name and cannot be redeclared", ed.line, ed.col));
    }
  }
  for sd in mod.structs {
    let user_struct = sd.enum_owner.len() == 0 && !util.str_has_prefix(sd.name, "__");
    if (user_struct && sd.line > 0 && (parser.is_reserved_struct_name(sd.name) || parser.is_reserved_enum_name(sd.name))) {
      out = out.append(dg_at("E010", "struct \"" + sd.name + "\" is a reserved built-in name and cannot be redeclared", sd.line, sd.col));
    }
  }
  return out;
}

function collect_decl_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  out = util.append_diags(out, handler_state_diags(mod));
  out = util.append_diags(out, e078_diags(mod));
  out = util.append_diags(out, e079_diags(mod));
  for sd in mod.structs {
    let fnames: string[] = [];
    for field in sd.fields {
      fnames = fnames.append(field.name);
    }
    let fk = 0;
    while (fk < fnames.len()) {
      if (dup_name_before(fnames, fk)) {
        out = out.append(dg_at("E007", "duplicate field \"" + fnames[fk] + "\" in struct " + sd.name, sd.line, sd.col));
      }
      fk += 1;
    }
  }
  for fd in mod.funcs {
    let pnames: string[] = [];
    for param in fd.params {
      pnames = pnames.append(param.name);
    }
    for cp in const_tparams(fd) {
      pnames = pnames.append(cp);
    }
    let pk = 0;
    while (pk < pnames.len()) {
      if (dup_name_before(pnames, pk)) {
        out = out.append(dg_at("E018", "duplicate parameter \"" + pnames[pk] + "\"", fd.line, fd.col));
      }
      pk += 1;
    }
  }
  let decl_names: string[] = [];
  for fd in mod.funcs {
    decl_names = decl_names.append(decl_key(fd));
  }
  out = util.append_diags(out, method_ambiguity_diags(mod));
  let decl_index = util.name_index(decl_names);
  let di = 0;
  while (di < mod.funcs.len()) {
    let f2 = mod.funcs[di];
    if (redeclares(mod.funcs, decl_index, di)) {
      if (f2.is_const) {
        out = out.append(dg_at("E006", "const \"" + f2.name + "\" redeclared", f2.line, f2.col));
      } else if (f2.receiver_type.len() == 0) {
        out = out.append(dg_at("E006", "function \"" + f2.name + "\" redeclared", f2.line, f2.col));
      } else {
        out = out.append(dg_at("E006", "method \"" + decl_key(f2) + "\" on " + parser.receiver_namespace(f2.receiver_type) + " redeclared", f2.line, f2.col));
      }
    }
    if (f2.receiver_name.len() > 0 && !receiver_type_ok(f2.receiver_type, mod)) {
      out = out.append(dg_at("E021", "method receiver type must be a struct, enum, array, slice, tuple, or built-in type, got " + util.base_type_name(f2.receiver_type), f2.line, f2.col));
    }
    di += 1;
  }
  let sn2 = 0;
  while (sn2 < mod.structs.len()) {
    let s2 = mod.structs[sn2];
    let user_struct = s2.enum_owner.len() == 0 && !(s2.name.len() >= 2 && slice_unchecked(s2.name, 0, 2) == "__");
    if (user_struct) {
      let sdup = false;
      let sj2 = 0;
      while (sj2 < sn2) {
        if (mod.structs[sj2].enum_owner.len() == 0 && mod.structs[sj2].name == s2.name) {
          sdup = true;
        }
        sj2 += 1;
      }
      if (sdup) {
        out = out.append(dg_at("E006", "struct \"" + s2.name + "\" redeclared", s2.line, s2.col));
      }
    }
    sn2 += 1;
  }
  let en = 0;
  while (en < mod.enums.len()) {
    let edup = false;
    let ej2 = 0;
    while (ej2 < en) {
      if (mod.enums[ej2].name == mod.enums[en].name) {
        edup = true;
      }
      ej2 += 1;
    }
    if (edup) {
      out = out.append(dg_at("E006", "enum \"" + mod.enums[en].name + "\" redeclared", mod.enums[en].line, mod.enums[en].col));
    }
    let vn = mod.enums[en].variant_names;
    let vk = 0;
    while (vk < vn.len()) {
      if (dup_name_before(vn, vk)) {
        out = out.append(dg_at("E017", "duplicate variant \"" + vn[vk] + "\" in enum " + mod.enums[en].name, mod.enums[en].line, mod.enums[en].col));
      }
      vk += 1;
    }
    en += 1;
  }
  out = util.append_diags(out, resource_diags(mod));
  out = util.append_diags(out, return_type_diags(mod));
  out = util.append_diags(out, alias_diags(mod));
  out = util.append_diags(out, export_shape_diags(mod));
  return out;
}

pub struct OwnFunc { name: string, flags: boolean[], send: boolean[] }

pub struct OwnFuncs { rows: OwnFunc[], names: util.NameIndex, structs: util.NameIndex, decls: util.NameIndex, ctors: util.NameIndex, methods: util.NameIndex, funcs: util.NameIndex, all_methods: util.NameIndex }

struct MovedEntry { mname: string, mline: i32, mcol: i32 }

struct OwnWalk { moved: MovedEntry[], diags: util.Diag[] }

struct OwnReturns { synthetic: boolean, moved: MovedEntry[] }

struct OwnCtx { owned: string[], borrowed: string[], ofuncs: OwnFuncs, structs: parser.StructDecl[], enums: parser.EnumDecl[], snames: util.NameIndex, decls: OwnDecls, admit: string, admit_fields: string[], fresh: string[], fresh_methods: string[], fresh_scrut: string[], bound: string[], scope: Scope, last_use: string[], returns: Cell[OwnReturns], deferred: Cell[MovedEntry[]], in_loop: boolean, noret: util.NameIndex }

function ow_expr_is_scalar(e: ast.Expr, ctx: OwnCtx): boolean {
  if (ow_scalar_literal(e)) {
    return true;
  }
  match (check_expr(e, ctx.scope)) {
    typeinfo.TypeI32(_) => {
      return true;
    },
    typeinfo.TypeBool(_) => {
      return true;
    },
    typeinfo.TypeFloat(_) => {
      return true;
    },
    typeinfo.TypeVoid(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function ow_is_string_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeString(_) = t {
    return true;
  }
  return false;
}

function ow_moved_has(m: MovedEntry[], name: string): boolean {
  for elem in m {
    if (elem.mname == name) {
      return true;
    }
  }
  return false;
}

function ow_moved_line(m: MovedEntry[], name: string): i32 {
  for elem in m {
    if (elem.mname == name) {
      return elem.mline;
    }
  }
  return 0;
}

function ow_moved_col(m: MovedEntry[], name: string): i32 {
  for elem in m {
    if (elem.mname == name) {
      return elem.mcol;
    }
  }
  return 0;
}

function ow_moved_add(m: MovedEntry[], name: string, line: i32, col: i32): MovedEntry[] {
  if (ow_moved_has(m, name)) {
    return m;
  }
  return m.append(MovedEntry { mname: name, mline: line, mcol: col });
}

function ow_fresh_deferred(): Cell[MovedEntry[]] {
  let none: MovedEntry[] = [];
  return cell_new(none);
}

// The moved entry whose name is a field path under name, or "" when none is.
function ow_moved_prefix(m: MovedEntry[], name: string): string {
  let head = name + ".";
  for elem in m {
    if (elem.mname.len() > head.len() && slice_unchecked(elem.mname, 0, head.len()) == head) {
      return elem.mname;
    }
  }
  return "";
}

function ow_path_field(path: string, name: string): string {
  return slice_unchecked(path, name.len() + 1, path.len()) + "";
}

function ow_moved_del_prefix(m: MovedEntry[], name: string): MovedEntry[] {
  let head = name + ".";
  let out: MovedEntry[] = [];
  for elem in m {
    if (!(elem.mname.len() > head.len() && slice_unchecked(elem.mname, 0, head.len()) == head)) {
      out = out.append(elem);
    }
  }
  return out;
}

function ow_line_text(line: i32): string {
  return util.i32_to_string(util.pos_line(line));
}

// The E050 for a bare use of an owned name: the whole was consumed, or one of
// its fields was.
function ow_bare_use_diags(moved: MovedEntry[], id: ast.ExprIdent): util.Diag[] {
  let d: util.Diag[] = [];
  if (ow_moved_has(moved, id.name)) {
    return d.append(dg_at("E050", "use of owned parameter \"" + id.name + "\" after it was consumed (moved at line " + ow_line_text(ow_moved_line(moved, id.name)) + ")", id.line, id.col));
  }
  let path = ow_moved_prefix(moved, id.name);
  if (path.len() > 0) {
    return d.append(dg_at("E050", "use of owned parameter \"" + id.name + "\" after its field \"" + ow_path_field(path, id.name) + "\" was consumed (moved at line " + ow_line_text(ow_moved_line(moved, path)) + ")", id.line, id.col));
  }
  return d;
}

// A consuming use of an owned name that a deferred call already consumes.
function ow_deferred_use_diags(ctx: OwnCtx, id: ast.ExprIdent): util.Diag[] {
  let d: util.Diag[] = [];
  let seen = ctx.deferred.get();
  if (ow_moved_has(seen, id.name)) {
    return d.append(dg_at("E050", "owned parameter \"" + id.name + "\" is consumed twice: a deferred call at line " + ow_line_text(ow_moved_line(seen, id.name)) + " consumes it", id.line, id.col));
  }
  let path = ow_moved_prefix(seen, id.name);
  if (path.len() > 0) {
    return d.append(dg_at("E050", "owned parameter \"" + id.name + "\" is consumed twice: a deferred call at line " + ow_line_text(ow_moved_line(seen, path)) + " consumes its field \"" + ow_path_field(path, id.name) + "\"", id.line, id.col));
  }
  return d;
}

// The target of a field read is a borrow of the whole: a consumed whole is
// refused, a consumed sibling field is not.
function ru_field_target(e: ast.Expr, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  if let ast.ExprIdent(id) = e {
    let d: util.Diag[] = [];
    if (!id.builtin && ow_is_owned(ctx, id.name) && ow_moved_has(moved, id.name)) {
      d = d.append(dg_at("E050", "use of owned parameter \"" + id.name + "\" after it was consumed (moved at line " + ow_line_text(ow_moved_line(moved, id.name)) + ")", id.line, id.col));
    }
    return OwnWalk { moved: moved, diags: d };
  }
  return ru_expr(e, moved, ctx);
}

// `p.f` handed to an own parameter: the path moves out of the own parameter p.
function ru_consume_field(fa: ast.ExprFieldAccess, oid: ast.ExprIdent, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  let path = oid.name + "." + fa.field;
  let d: util.Diag[] = [];
  if (ow_moved_has(moved, path)) {
    d = d.append(dg_at("E050", "use of owned parameter \"" + oid.name + "\" after its field \"" + fa.field + "\" was consumed (moved at line " + ow_line_text(ow_moved_line(moved, path)) + ")", fa.line, fa.col));
    return OwnWalk { moved: moved, diags: d };
  }
  let rt = ru_field_target(fa.obj, moved, ctx);
  if (rt.diags.len() > 0) {
    return rt;
  }
  let seen = ctx.deferred.get();
  if (ow_moved_has(seen, path)) {
    d = d.append(dg_at("E050", "field \"" + fa.field + "\" of owned parameter \"" + oid.name + "\" is consumed twice: a deferred call at line " + ow_line_text(ow_moved_line(seen, path)) + " consumes it", fa.line, fa.col));
    return OwnWalk { moved: moved, diags: d };
  }
  if (ow_moved_has(seen, oid.name)) {
    d = d.append(dg_at("E050", "owned parameter \"" + oid.name + "\" is consumed twice: a deferred call at line " + ow_line_text(ow_moved_line(seen, oid.name)) + " consumes it", fa.line, fa.col));
    return OwnWalk { moved: moved, diags: d };
  }
  return OwnWalk { moved: ow_moved_add(moved, path, fa.line, fa.col), diags: d };
}

function ow_moved_join(dst: MovedEntry[], branch: MovedEntry[], diverges: boolean): MovedEntry[] {
  if (diverges) {
    return dst;
  }
  let out = dst;
  for elem in branch {
    out = ow_moved_add(out, elem.mname, elem.mline, elem.mcol);
  }
  return out;
}

// The moved set after a statement with branches: the union of the branches
// that run on to the next statement, so a branch that gives a name a new value
// clears its move. When no branch runs on, the set before the branches stays.
function ow_settle(before: MovedEntry[], branches: MovedEntry[][], runs_on: boolean[]): MovedEntry[] {
  let out = before;
  let any = false;
  let i = 0;
  while (i < branches.len()) {
    if (runs_on[i]) {
      if (any) {
        out = ow_moved_join(out, branches[i], false);
      } else {
        out = branches[i];
        any = true;
      }
    }
    i += 1;
  }
  return out;
}

// An arm that binds nothing sees the scrutinee as it was before the match:
// the pattern did not take its payload.
function ow_restore_tag(after: MovedEntry[], whole: MovedEntry[], tag: ast.Expr): MovedEntry[] {
  let key = "";
  match (tag) {
    ast.ExprIdent(id) => {
      key = id.name;
    },
    ast.ExprFieldAccess(fa) => {
      if let ast.ExprIdent(q) = fa.obj {
        key = q.name + "." + fa.field;
      }
    },
    _ => {}
  }
  if (key.len() == 0) {
    return after;
  }
  let out = ow_moved_del(after, key);
  for elem in whole {
    if (elem.mname == key) {
      out = out.append(elem);
    }
  }
  return out;
}

function ow_is_owned(ctx: OwnCtx, name: string): boolean {
  return util.has_str(ctx.owned, name);
}

function ow_ownable_type(type_name: string): boolean {
  let scalars: string[] = ["boolean", "i32", "i64", "u8", "u32", "u64", "f64", "f32", "char", "usize", "void"];
  return !util.has_str(scalars, type_name);
}

function ow_nested_ctx(ctx: OwnCtx, lm: ast.ExprLambda): OwnCtx {
  let params = lm.params;
  let names = ctx.owned;
  let borrowed = ctx.borrowed;
  for param in params {
    if (param.own && ow_ownable_type(param.type_name)) {
      if (!util.has_str(names, param.name)) {
        names = names.append(param.name);
      }
      borrowed = ow_names_del(borrowed, param.name);
    } else {
      names = ow_names_del(names, param.name);
      if (!util.has_str(borrowed, param.name)) {
        borrowed = borrowed.append(param.name);
      }
    }
  }
  let bound = ctx.bound;
  for p in params {
    if (!util.has_str(bound, p.name)) {
      bound = bound.append(p.name);
    }
  }
  let nested = OwnCtx { owned: names, borrowed: borrowed, ofuncs: ctx.ofuncs, structs: ctx.structs, enums: ctx.enums, snames: ctx.snames, decls: ctx.decls, admit: ctx.admit, admit_fields: [], fresh: ctx.fresh, fresh_methods: ctx.fresh_methods, fresh_scrut: ctx.fresh_scrut, bound: bound, scope: lambda_body_scope(lm, ctx.scope), last_use: ctx.last_use, returns: cell_new(OwnReturns { synthetic: false, moved: [] }), deferred: ow_fresh_deferred(), in_loop: ctx.in_loop, noret: ctx.noret };
  return nested;
}

function ow_names_del(names: string[], name: string): string[] {
  let out: string[] = [];
  for nm in names {
    if (nm != name) {
      out = out.append(nm);
    }
  }
  return out;
}

function ow_nested_moved(m: MovedEntry[], params: ast.ParamDecl[]): MovedEntry[] {
  let out = m;
  for param in params {
    out = ow_moved_del(out, param.name);
  }
  return out;
}

// A closure body consumes the captured owned names of its enclosing function.
// Its own parameters shadow the outer names only inside the body.
function ow_lambda_moved_out(outer: MovedEntry[], inner: MovedEntry[], params: ast.ParamDecl[]): MovedEntry[] {
  let out = ow_nested_moved(inner, params);
  for param in params {
    if (ow_moved_has(outer, param.name)) {
      out = ow_moved_add(out, param.name, ow_moved_line(outer, param.name), ow_moved_col(outer, param.name));
    }
  }
  return out;
}

function ow_func_flags(ofuncs: OwnFuncs, name: string): boolean[] {
  let i = ofuncs.names.find(name);
  if (i >= 0) {
    return ofuncs.rows[i].flags;
  }
  let empty: boolean[] = [];
  return empty;
}

function ow_send_flags(ofuncs: OwnFuncs, name: string): boolean[] {
  let i = ofuncs.names.find(name);
  if (i >= 0) {
    return ofuncs.rows[i].send;
  }
  let empty: boolean[] = [];
  return empty;
}

function ow_is_own_func(ofuncs: OwnFuncs, name: string): boolean {
  return ofuncs.names.has(name);
}

function ow_variant_known(ctx: OwnCtx, name: string, owner: string): boolean {
  let i = ctx.snames.chain(name);
  while (i >= 0) {
    let sd = ctx.structs[i];
    if (sd.name == name && sd.enum_owner != "" && (owner == "" || sd.enum_owner == owner)) {
      return true;
    }
    i = ctx.snames.next[i];
  }
  return false;
}

// Option's and Result's variants are not among the module's declarations.
function ow_builtin_variant(ctx: OwnCtx, name: string): boolean {
  return is_builtin_variant(name) && !ctx.ofuncs.funcs.has(name) && !util.has_str(ctx.bound, name);
}

function ow_struct_names(structs: parser.StructDecl[]): string[] {
  let names: string[] = [];
  for sd in structs {
    names = names.append(sd.name);
  }
  return names;
}

function ow_scalar_literal(e: ast.Expr): boolean {
  if let ast.ExprNumber(_) = e {
    return true;
  }
  if let ast.ExprBool(_) = e {
    return true;
  }
  return false;
}

// A scrutinee that is a local or a field path at its last use: its payloads
// leave it.
function ow_takes_scrutinee(e: ast.Expr, ctx: OwnCtx): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return util.has_str(ctx.last_use, lu_key(id.line, id.col)) && !ow_is_owned(ctx, id.name);
    },
    ast.ExprFieldAccess(fa) => {
      if let ast.ExprIdent(oid) = fa.obj {
        return util.has_str(ctx.last_use, lu_field_key(fa, oid));
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// A for-each takes an owned name only at its last use; any other iterator
// the loop owns is a fresh value.
function ow_iter_at_last_use(e: ast.Expr, ctx: OwnCtx): boolean {
  if let ast.ExprIdent(id) = e {
    return util.has_str(ctx.last_use, lu_key(id.line, id.col));
  }
  return true;
}

function ow_is_owned_scrutinee(e: ast.Expr, ctx: OwnCtx): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(cid) = c.callee {
      if (ctx.ofuncs.ctors.has(cid.name) || ow_builtin_variant(ctx, cid.name)) {
        return true;
      }
      return util.has_str(ctx.fresh_scrut, cid.name) || util.has_str(ctx.fresh, cid.name) && !ow_expr_holds_no_handle(e, ctx);
    }
    return ow_qualified_ctor(c.callee, ctx) || ow_fresh_method_result(c, ctx);
  }
  return ow_is_owned_expr(e, ctx);
}

// A method call whose result is a kernel descriptor: a directory or a file
// opened under another directory.
function ow_fresh_method_result(c: ast.ExprCall, ctx: OwnCtx): boolean {
  if let ast.ExprFieldAccess(mfa) = c.callee {
    for ns in ow_type_namespaces(check_expr(mfa.obj, ctx.scope)) {
      if (util.has_str(ow_fresh_builtin_methods(), ns + "." + mfa.field)) {
        return true;
      }
    }
  }
  return false;
}

function ow_fresh_builtin_methods(): string[] {
  return ["Dir.open_dir", "Dir.open_reader", "Dir.open_writer", "Dir.open_reader_with", "Dir.open_writer_with"];
}

function ow_qualified_ctor(callee: ast.Expr, ctx: OwnCtx): boolean {
  if let ast.ExprFieldAccess(fa) = callee {
    let owner = ow_ident_name(fa.obj);
    return owner.len() > 0 && !util.has_str(ctx.bound, owner) && !ctx.scope.is_bound(owner)
      && ow_variant_known(ctx, fa.field, owner);
  }
  return false;
}

function ow_is_fresh_literal(e: ast.Expr): boolean {
  match (e) {
    ast.ExprStructLit(_) => {
      return true;
    },
    ast.ExprLambda(_) => {
      return true;
    },
    ast.ExprArray(_) => {
      return true;
    },
    ast.ExprTuple(_) => {
      return true;
    },
    ast.ExprMapLit(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function ow_is_owned_expr(e: ast.Expr, ctx: OwnCtx): boolean {
  if (ow_expr_is_scalar(e, ctx)) {
    return true;
  }
  if (ow_is_fresh_literal(e)) {
    return true;
  }
  match (e) {
    ast.ExprBinary(b) => {
      return b.op == "+" && ow_is_string_type(check_expr(b.left, ctx.scope)) && ow_is_string_type(check_expr(b.right, ctx.scope));
    },
    ast.ExprUnary(u) => {
      return u.op == "try_" && ow_is_owned_expr(u.operand, ctx);
    },
    ast.ExprIdent(id) => {
      if (ctx.admit.len() > 0 && ctx.admit == id.name) {
        return true;
      }
      if (ow_local_last_use(id, ctx)) {
        return true;
      }
      if (ow_variant_known(ctx, id.name, "") || ow_builtin_variant(ctx, id.name)) {
        return true;
      }
      if (!util.has_str(ctx.bound, id.name) && !ctx.scope.is_bound(id.name) && ctx.scope.sig_is_const(id.name)) {
        return true;
      }
      return ow_is_owned(ctx, id.name);
    },
    ast.ExprFieldAccess(fa) => {
      if (ow_variant_known(ctx, fa.field, ow_ident_name(fa.obj))) {
        return true;
      }
      if let ast.ExprIdent(oid) = fa.obj {
        if (util.has_str(ctx.last_use, lu_field_key(fa, oid)) && !util.has_str(ctx.borrowed, oid.name)) {
          return true;
        }
      }
      return util.has_str(ctx.admit_fields, ow_ident_name(fa.obj) + "." + fa.field);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return ctx.ofuncs.ctors.has(cid.name) || ow_builtin_variant(ctx, cid.name) || util.has_str(ctx.fresh, cid.name);
        },
        ast.ExprFieldAccess(mfa) => {
          if (ow_qualified_ctor(c.callee, ctx)) {
            return true;
          }
          for ns in ow_type_namespaces(check_expr(mfa.obj, ctx.scope)) {
            if (util.has_str(ctx.fresh_methods, ns + "." + mfa.field)) {
              return true;
            }
          }
          return false;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

struct LuOcc { name: string, line: i32, col: i32 }

struct LuVar { name: string, init: ast.Expr }

struct LuSel { obj: string, field: string, line: i32, col: i32 }

// updates holds, for the base of each update literal `S { ...q, f: v }`, one
// entry per field the literal replaces.
struct LuFacts { occ: LuOcc[], vars: LuVar[], assigns: LuVar[], escaping: string[], sels: LuSel[], captured: string[], defer_bare: string[], defer_fields: string[], updates: LuSel[], unpacked: LuVar[], matched: LuVar[] }

// fresh names the fresh locals once lu_fresh_names has decided them; until
// then fresh_known is false and lu_fresh_init_in decides from the facts.
struct LuFn { facts: LuFacts, params: string[], owned: string[], ofuncs: OwnFuncs, borrows: util.NameIndex, lenders: OwnLenders, builtins: util.NameIndex, noret: util.NameIndex, looped: string[], fresh: string[], fresh_known: boolean }

// A frame is one block on the path from the function body to a statement:
// the block, the index of the statement on the path, and the loop statement
// whose body the block is, when it is one.
struct LuFrame { stmts: ast.Stmt[], idx: i32, head: ast.Stmt, is_loop: boolean, label: string }

// A binding ends at scope. It is new on each iteration of the loops that
// surround its declaration, but not of loops nested inside it.
struct LuLife { name: string, scope: i32, loop_depth: i32, fresh: boolean }

struct LuSite { stmts: ast.Stmt[], idx: i32, frames: LuFrame[], binders: string[], bindings: LuLife[], loop_depth: i32, in_loop: boolean, in_iife: boolean, in_defer: boolean }

// The scope a block is walked in: the frames above it, the frame it adds
// when framed, the names match arms and for-each loops bound on the way
// (binders), their lexical lifetimes (bindings), and the flags of the
// statement that holds it.
struct LuScope { frames: LuFrame[], head: LuFrame, framed: boolean, binders: string[], bindings: LuLife[], loop_depth: i32, in_loop: boolean, in_iife: boolean, in_defer: boolean }

struct LuJumps { breaks: string[], continues: string[] }

function lu_key(line: i32, col: i32): string {
  return util.i32_to_string(line) + ":" + util.i32_to_string(col);
}

function lu_name_stmt(s: ast.Stmt, own a: string[]): string[] {
  if let ast.StmtAssign(asg) = s {
    return a.append(asg.target);
  }
  return a;
}

function lu_name_expr(e: ast.Expr, own a: string[]): string[] {
  if let ast.ExprIdent(id) = e {
    return a.append(id.name);
  }
  return a;
}

function lu_all_names(st: ast.Stmt, own acc: string[]): string[] {
  return astwalk.fold_stmt_nodes(st, acc, lu_name_stmt, lu_name_expr, astwalk.descend_all);
}

function lu_fact_stmt(st: ast.Stmt, own f: LuFacts): LuFacts {
  match (st) {
    ast.StmtAssign(a) => {
      return LuFacts { ...f, occ: f.occ.append(LuOcc { name: a.target, line: a.target_line, col: a.target_col }), assigns: f.assigns.append(LuVar { name: a.target, init: a.value }) };
    },
    ast.StmtVar(v) => {
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return LuFacts { ...f, vars: lu_destr_vars(v, f.vars), unpacked: lu_destr_unpacked(v, f.unpacked) };
      }
      return LuFacts { ...f, vars: f.vars.append(LuVar { name: v.name, init: v.init }) };
    },
    ast.StmtDefer(d) => {
      let names = lu_all_names(d.action, []);
      return lu_defer_facts(d.action, LuFacts { ...f, escaping: util.append_all(f.escaping, names) });
    },
    ast.StmtMatch(m) => {
      let matched = f.matched;
      for arm in m.arms {
        for name in astwalk.pattern_binders(arm.pattern, []) {
          matched = matched.append(LuVar { name: name, init: m.scrutinee });
        }
      }
      return LuFacts { ...f, matched: matched };
    },
    _ => {
      return f;
    }
  }
  return f;
}

// A deferred action runs at the exit, so a path it mentions is live until
// then: a bare mention of q holds every field, and `q.g` holds g alone.
function lu_defer_facts(action: ast.Stmt, own f: LuFacts): LuFacts {
  let inner = astwalk.fold_stmt_nodes(action, lu_empty_facts(), lu_skip_facts, lu_fact_expr, astwalk.descend_all);
  let bare = f.defer_bare;
  let fields = f.defer_fields;
  for o in inner.occ {
    let sel = lu_sel_at(inner, o.line, o.col);
    if (sel.len() == 0) {
      bare = bare.append(o.name);
    } else {
      fields = fields.append(o.name + "." + sel);
    }
  }
  return LuFacts { ...f, defer_bare: bare, defer_fields: fields };
}

function lu_skip_facts(st: ast.Stmt, own f: LuFacts): LuFacts {
  return f;
}

function lu_sel_at(f: LuFacts, line: i32, col: i32): string {
  for sel in f.sels {
    if (sel.line == line && sel.col == col) {
      return sel.field;
    }
  }
  return "";
}

function lu_destr_vars(v: ast.StmtVar, own vars: LuVar[]): LuVar[] {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let init: ast.Expr = none;
  if (lu_fresh_expr(v.init) && parser.destr_marker_split(v.type_name).at.len() == 0) {
    init = v.init;
  }
  for nm in split_pattern_names(v.name) {
    if (util.is_tuple_type_name(nm)) {
      vars = lu_nested_vars(nm, vars);
    } else {
      vars = vars.append(LuVar { name: nm, init: init });
    }
  }
  return vars;
}

// The names a destructure of a plain name binds, each with that name as its
// source. Nested groups are not unpacks of the name itself.
function lu_destr_unpacked(v: ast.StmtVar, own acc: LuVar[]): LuVar[] {
  if let ast.ExprIdent(_) = v.init {
    if (parser.destr_marker_split(v.type_name).at.len() > 0) {
      return acc;
    }
    for nm in split_pattern_names(v.name) {
      if (!util.is_tuple_type_name(nm)) {
        acc = acc.append(LuVar { name: nm, init: v.init });
      }
    }
  }
  return acc;
}

function lu_nested_vars(group: string, own vars: LuVar[]): LuVar[] {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  for nm in split_pattern_names(slice_unchecked(group, 1, group.len() - 1) + "") {
    if (util.is_tuple_type_name(nm)) {
      vars = lu_nested_vars(nm, vars);
    } else {
      vars = vars.append(LuVar { name: nm, init: none });
    }
  }
  return vars;
}

function lu_fact_expr(e: ast.Expr, own f: LuFacts): LuFacts {
  match (e) {
    ast.ExprIdent(id) => {
      return LuFacts { ...f, occ: f.occ.append(LuOcc { name: id.name, line: id.line, col: id.col }) };
    },
    ast.ExprLambda(lm) => {
      if (lm.origin.len() > 0) {
        return f;
      }
      let esc = f.escaping;
      for st in lm.body {
        esc = lu_all_names(st, esc);
      }
      let cap = f.captured;
      for st in lm.body {
        cap = lu_all_names(st, cap);
      }
      return LuFacts { ...f, escaping: esc, captured: cap };
    },
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(oid) => {
          return LuFacts { ...f, sels: f.sels.append(LuSel { obj: oid.name, field: fa.field, line: oid.line, col: oid.col }) };
        },
        _ => {
          return f;
        }
      }
    },
    ast.ExprStructLit(sl) => {
      if (!sl.has_base) {
        return f;
      }
      if let ast.ExprIdent(bid) = sl.base {
        let ups = f.updates;
        for fname in sl.field_names {
          ups = ups.append(LuSel { obj: bid.name, field: fname, line: bid.line, col: bid.col });
        }
        return LuFacts { ...f, updates: ups };
      }
      return f;
    },
    _ => {
      return f;
    }
  }
  return f;
}

function lu_occ_count(fx: LuFn, name: string): i32 {
  let n = 0;
  for o in fx.facts.occ {
    if (o.name == name) {
      n += 1;
    }
  }
  return n;
}

function lu_decl_count(fx: LuFn, name: string): i32 {
  let n = 0;
  for v in fx.facts.vars {
    if (v.name == name) {
      n += 1;
    }
  }
  return n;
}

function lu_init_of(fx: LuFn, name: string): Option[ast.Expr] {
  let init: Option[ast.Expr] = None;
  for v in fx.facts.vars {
    if (v.name == name) {
      if let Some(_) = init {
        return None;
      }
      init = Some(v.init);
    }
  }
  return init;
}

function lu_is_local(fx: LuFn, name: string): boolean {
  return !util.has_str(fx.params, name) && lu_decl_count(fx, name) > 0;
}

// A name is a fresh local when each of its declarations is fresh and each
// assignment to it stores an owned value.
function lu_fresh_init(fx: LuFn, name: string): boolean {
  if (fx.fresh_known) {
    return util.has_str(fx.fresh, name);
  }
  return lu_fresh_init_in(fx, name, []);
}

// The fresh locals of the function, decided once.
function lu_fresh_names(fx: LuFn): string[] {
  let out: string[] = [];
  let done: string[] = [];
  for v in fx.facts.vars {
    if (!util.has_str(done, v.name)) {
      done = done.append(v.name);
      if (lu_fresh_init_in(fx, v.name, [])) {
        out = out.append(v.name);
      }
    }
  }
  return out;
}

// A name in `seen` is on the path, so a cycle of assignments between fresh
// locals is decided by its other values.
function lu_fresh_init_in(fx: LuFn, name: string, seen: string[]): boolean {
  if (fx.fresh_known) {
    return util.has_str(fx.fresh, name);
  }
  let found = false;
  for v in fx.facts.vars {
    if (v.name == name) {
      if (!lu_fresh_value(fx, v.init)) {
        return false;
      }
      found = true;
    }
  }
  return found && lu_only_fresh_assigns(fx, name, seen);
}

function lu_fresh_value(fx: LuFn, e: ast.Expr): boolean {
  return lu_fresh_expr(e) && !lu_init_borrows(fx, e) || lu_fresh_match_value(fx, e);
}

// A match expression on a fresh value whose each arm yields a payload it
// binds, a fresh value, or leaves.
function lu_fresh_match_value(fx: LuFn, e: ast.Expr): boolean {
  let ast.ExprCall(c) = e else {
    return false;
  };
  let ast.ExprLambda(lm) = c.callee else {
    return false;
  };
  if (!parser.is_value_block(c) || lm.origin != parser.ORIGIN_MATCH_EXPR || lm.body.len() != 1) {
    return false;
  }
  let ast.StmtMatch(m) = lm.body[0] else {
    return false;
  };
  if let ast.ExprIdent(_) = m.scrutinee {
    return false;
  }
  if (m.arms.len() == 0 || !lu_fresh_value(fx, m.scrutinee)) {
    return false;
  }
  for arm in m.arms {
    if (!lu_arm_yields_fresh(fx, arm)) {
      return false;
    }
  }
  return true;
}

function lu_arm_yields_fresh(fx: LuFn, arm: ast.MatchArm): boolean {
  let n = arm.body.len();
  if (n == 0) {
    return false;
  }
  let ast.StmtReturn(r) = arm.body[n - 1] else {
    return false;
  };
  if (n > 1 && parser.branch_stmts_diverge([arm.body[n - 2]])) {
    return true;
  }
  if let ast.ExprIdent(id) = r.value {
    if (util.has_str(astwalk.pattern_binders(arm.pattern, []), id.name) || lu_stmts_declare(arm.body, id.name)) {
      return lu_arm_payload_fresh(fx, arm.body, id.name);
    }
  }
  return lu_fresh_value(fx, r.value);
}

function lu_stmts_declare(body: ast.Stmt[], name: string): boolean {
  for st in body {
    if (lu_stmt_declares(st, name)) {
      return true;
    }
  }
  return false;
}

// Use the final declaration in this block, of the payload or of a local the
// arm declares. A declaration in a nested block does not replace the value
// that this block returns.
function lu_arm_payload_fresh(fx: LuFn, body: ast.Stmt[], name: string): boolean {
  let start = 0;
  let fresh = true;
  for i in 0..body.len() {
    if (lu_stmt_declares(body[i], name)) {
      let ast.StmtVar(v) = body[i] else {
        return false;
      };
      fresh = v.name == name && lu_fresh_value(fx, v.init);
      start = i + 1;
    }
  }
  return fresh && lu_payload_assigns_fresh(fx, body, name, start);
}

// Stop at a new declaration: assignments after it belong to that binding.
function lu_payload_assigns_fresh(fx: LuFn, body: ast.Stmt[], name: string, start: i32): boolean {
  return lu_payload_scan_fresh(fx, body, name, start, body);
}

function lu_payload_scan_fresh(fx: LuFn, body: ast.Stmt[], name: string, start: i32, root: ast.Stmt[]): boolean {
  for i in start..body.len() {
    if (lu_stmt_declares(body[i], name)) {
      return true;
    }
    if (!lu_payload_stmt_fresh(fx, body[i], name, root)) {
      return false;
    }
  }
  return true;
}

function lu_payload_stmt_fresh(fx: LuFn, st: ast.Stmt, name: string, root: ast.Stmt[]): boolean {
  match (st) {
    ast.StmtIf(f) => {
      return lu_payload_expr_fresh(fx, f.cond, name, root) && lu_payload_scan_fresh(fx, f.then_body, name, 0, root) && lu_payload_scan_fresh(fx, f.else_body, name, 0, root);
    },
    ast.StmtWhile(w) => {
      return lu_payload_expr_fresh(fx, w.cond, name, root) && lu_payload_scan_fresh(fx, w.body, name, 0, root);
    },
    ast.StmtFor(f) => {
      return lu_payload_expr_fresh(fx, f.iter, name, root) && (f.var_name == name || lu_payload_scan_fresh(fx, f.body, name, 0, root));
    },
    ast.StmtMatch(m) => {
      return lu_payload_match_fresh(fx, m, name, root);
    },
    _ => {
      let facts = astwalk.fold_stmt_nodes(st, lu_empty_facts(), lu_fact_stmt, lu_fact_expr, astwalk.descend_all);
      return lu_payload_facts_fresh(fx, facts, name, root);
    }
  }
  return false;
}

// The scrutinee of `m`, and each arm that does not bind `name` again.
function lu_payload_match_fresh(fx: LuFn, m: ast.StmtMatch, name: string, root: ast.Stmt[]): boolean {
  if (!lu_payload_expr_fresh(fx, m.scrutinee, name, root)) {
    return false;
  }
  for arm in m.arms {
    if (!util.has_str(astwalk.pattern_binders(arm.pattern, []), name)) {
      if (arm.has_guard && !lu_payload_expr_fresh(fx, arm.guard, name, root) || !lu_payload_scan_fresh(fx, arm.body, name, 0, root)) {
        return false;
      }
    }
  }
  return true;
}

function lu_payload_expr_fresh(fx: LuFn, e: ast.Expr, name: string, root: ast.Stmt[]): boolean {
  let facts = astwalk.fold_expr_nodes(e, lu_empty_facts(), lu_fact_stmt, lu_fact_expr, astwalk.descend_all);
  return lu_payload_facts_fresh(fx, facts, name, root);
}

function lu_payload_facts_fresh(fx: LuFn, facts: LuFacts, name: string, root: ast.Stmt[]): boolean {
  for a in facts.assigns {
    if (a.name == name && !lu_fresh_value(fx, a.init) && !lu_fresh_payload_value(fx, a.init) && !lu_fresh_local_replacement(fx, a.init, root)) {
      return false;
    }
  }
  return true;
}

struct LuReplacement { value: ast.Expr, name: string, repeats: boolean }

function lu_replacement_keep(e: ast.Expr, own state: LuReplacement): LuReplacement {
  return state;
}

function lu_replacement_loop(st: ast.Stmt, own state: LuReplacement): LuReplacement {
  if (!state.repeats && lu_is_loop_stmt(st) && lu_loop_holds_call(st, state.value)) {
    let facts = astwalk.fold_stmt_nodes(st, lu_empty_facts(), lu_fact_stmt, lu_fact_expr, astwalk.descend_all);
    for v in facts.vars {
      if (v.name == state.name) {
        return state;
      }
    }
    return LuReplacement { ...state, repeats: true };
  }
  return state;
}

// The local is fresh, unmodified and declared in this lexical body.
// An inner loop must also declare it afresh on each round.
function lu_fresh_local_replacement(fx: LuFn, e: ast.Expr, body: ast.Stmt[]): boolean {
  let ast.ExprIdent(id) = e else {
    return false;
  };
  if (!lu_fresh_init(fx, id.name) || !lu_sole_last_read(fx, id, 1) || !lu_body_declares(body, id.name)) {
    return false;
  }
  let state = LuReplacement { value: e, name: id.name, repeats: false };
  for st in body {
    state = astwalk.fold_stmt_nodes(st, state, lu_replacement_loop, lu_replacement_keep, astwalk.descend_all);
  }
  return !state.repeats;
}

// A local declared once, and read only at `id`.
function lu_one_read(fx: LuFn, id: ast.ExprIdent): boolean {
  return lu_occ_count(fx, id.name) == 1 && lu_sole_last_read(fx, id, 1);
}

// `id` is not a parameter, has `decls` declarations, is at its last read,
// is not captured and does not escape, and nothing assigns it.
function lu_sole_last_read(fx: LuFn, id: ast.ExprIdent, decls: i32): boolean {
  if (util.has_str(fx.params, id.name) || lu_decl_count(fx, id.name) != decls || !lu_is_last(fx, id)
    || util.has_str(fx.facts.captured, id.name) || util.has_str(fx.facts.escaping, id.name)) {
    return false;
  }
  for a in fx.facts.assigns {
    if (a.name == id.name) {
      return false;
    }
  }
  return true;
}

// `body` declares the local `name`.
function lu_body_declares(body: ast.Stmt[], name: string): boolean {
  let facts = lu_empty_facts();
  for st in body {
    facts = astwalk.fold_stmt_nodes(st, facts, lu_fact_stmt, lu_fact_expr, astwalk.descend_all);
  }
  for v in facts.vars {
    if (v.name == name) {
      return true;
    }
  }
  return false;
}

// A payload from a fresh call can replace an owned value at its last read.
// Any assignment or other declaration of its name prevents this proof.
function lu_fresh_payload_value(fx: LuFn, e: ast.Expr): boolean {
  let ast.ExprIdent(id) = e else {
    return false;
  };
  if (!lu_sole_last_read(fx, id, 0)) {
    return false;
  }
  let found = false;
  for m in fx.facts.matched {
    if (m.name == id.name) {
      if (!lu_fresh_value(fx, m.init)) {
        return false;
      }
      found = true;
    }
  }
  return found;
}

// An own parameter, a payload that a match took, or a fresh local declared
// once outside a loop.
function lu_unpack_source_owned(fx: LuFn, name: string): boolean {
  if (lu_own_param(fx, name)) {
    return lu_decl_count(fx, name) == 0;
  }
  if (lu_fresh_bound(fx, name)) {
    return true;
  }
  return lu_decl_count(fx, name) == 1 && !util.has_str(fx.looped, name) && lu_fresh_init(fx, name);
}

// Each value assigned to the name after its declaration is owned.
function lu_only_fresh_assigns(fx: LuFn, name: string, seen: string[]): boolean {
  for a in fx.facts.assigns {
    if (a.name == name && !lu_assigned_owned(fx, name, a.init, seen)) {
      return false;
    }
  }
  return true;
}

// A value an assignment to the name stores that no other name holds: a fresh
// value, a self-update `T { ...name, f: v }`, a call whose result borrows
// from no argument but the name itself, a payload a match took, a fresh
// local, or an unpack.
function lu_assigned_owned(fx: LuFn, name: string, e: ast.Expr, seen: string[]): boolean {
  if (lu_fresh_value(fx, e)) {
    return true;
  }
  if let ast.ExprStructLit(sl) = e {
    return sl.has_base && ow_ident_name(sl.base) == name;
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(_) = c.callee {
      return !lu_call_borrows_beside(fx, c, name);
    }
    return false;
  }
  if let ast.ExprUnary(u) = e {
    return u.op == "try_" && lu_assigned_owned(fx, name, u.operand, seen);
  }
  if (util.has_str(seen, name)) {
    return true;
  }
  let inner: string[] = seen.append(name);
  if let ast.ExprIdent(src) = e {
    return lu_assigned_name_owned(fx, src, inner);
  }
  return lu_unpack_expr_in(fx, e, inner);
}

function lu_assigned_name_owned(fx: LuFn, src: ast.ExprIdent, seen: string[]): boolean {
  return lu_fresh_bound(fx, src.name) || lu_fresh_init_in(fx, src.name, seen) || lu_payload_elem_local(fx, src);
}

// A local that the tuple pattern of a match arm binds, as `d1` in
// `Ok((d1, v))`, read once here. The parser lowers the pattern to
// `let d1 = p_e0` after an unpack of the payload p. The local and its element
// each have one read, and the match took p from a fresh call, so the arm
// declares each afresh on each round of a loop.
function lu_payload_elem_local(fx: LuFn, id: ast.ExprIdent): boolean {
  if (!lu_one_read(fx, id)) {
    return false;
  }
  let Some(init) = lu_init_of(fx, id.name) else {
    return false;
  };
  let ast.ExprIdent(elem) = init else {
    return false;
  };
  if (!lu_one_read(fx, elem)) {
    return false;
  }
  for u in fx.facts.unpacked {
    if (u.name == elem.name) {
      let ast.ExprIdent(src) = u.init else {
        return false;
      };
      return lu_occ_count(fx, src.name) == 1 && lu_fresh_bound(fx, src.name);
    }
  }
  return false;
}

// A local declared once, outside a loop, from an own parameter at its last
// use, and given only owned values after that.
function lu_owned_alias(fx: LuFn, name: string): boolean {
  if (lu_decl_count(fx, name) != 1 || util.has_str(fx.looped, name) || !lu_only_fresh_assigns(fx, name, [])) {
    return false;
  }
  // The fields that a destructure takes from an own parameter or a fresh
  // local at its last use are owned, as the source is.
  for u in fx.facts.unpacked {
    if (u.name == name) {
      if let ast.ExprIdent(src) = u.init {
        return lu_unpack_source_owned(fx, src.name) && lu_is_last(fx, src);
      }
    }
  }
  let Some(init) = lu_init_of(fx, name) else {
    return false;
  };
  if let ast.ExprIdent(src) = init {
    return lu_own_param(fx, src.name) && lu_is_last(fx, src);
  }
  return false;
}

// The names a let declares inside a loop body.
function lu_looped_decls(stmts: ast.Stmt[], in_loop: boolean, own acc: string[]): string[] {
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (in_loop) {
          acc = lu_var_names(st, acc);
        }
      },
      ast.StmtIf(f) => {
        acc = lu_looped_decls(f.then_body, in_loop, acc);
        acc = lu_looped_decls(f.else_body, in_loop, acc);
      },
      ast.StmtWhile(w) => {
        acc = lu_looped_decls(w.body, true, acc);
      },
      ast.StmtFor(fo) => {
        acc = lu_looped_decls(fo.body, true, acc);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          acc = lu_looped_decls(arm.body, in_loop, acc);
        }
      },
      _ => {}
    }
  }
  return acc;
}

// A plain named call whose result can borrow from one of its arguments.
function lu_init_borrows(fx: LuFn, e: ast.Expr): boolean {
  if let ast.ExprUnary(u) = e {
    return u.op == "try_" && lu_init_borrows(fx, u.operand);
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(_) = c.callee {
      return lu_call_site_borrows(fx, c);
    }
  }
  return false;
}

function lu_call_site_borrows(fx: LuFn, c: ast.ExprCall): boolean {
  return lu_call_borrows_beside(fx, c, "");
}

// The call's result can borrow from an argument that is not the plain name
// `except`: `x = f(x)` leaves x the one holder of what the result took from
// it. Only a parameter that can lend a handle counts, when the callee is
// declared.
function lu_call_borrows_beside(fx: LuFn, c: ast.ExprCall, except: string): boolean {
  if (!ow_call_may_borrow(c, fx.ofuncs, fx.borrows, fx.builtins)) {
    return false;
  }
  let callee: string = ow_ident_name(c.callee);
  let row: i32 = fx.lenders.names.find(callee);
  for i in 0..c.args.len() {
    let a = c.args[i];
    let skipped: boolean = except.len() > 0 && ow_ident_name(a) == except;
    if (!skipped && lu_arg_may_borrow(fx, a) && (row < 0 || lu_lends(fx.lenders.rows[row], i))) {
      return true;
    }
  }
  return false;
}

function lu_lends(row: OwnLend, i: i32): boolean {
  return i < row.lend.len() && row.lend[i];
}

function lu_arg_may_borrow(fx: LuFn, e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(_) => {
      return false;
    },
    ast.ExprString(_) => {
      return false;
    },
    ast.ExprBool(_) => {
      return false;
    },
    ast.ExprBytes(_) => {
      return false;
    },
    ast.ExprFString(_) => {
      return false;
    },
    ast.ExprZero(_) => {
      return false;
    },
    ast.ExprStructLit(_) => {
      return false;
    },
    ast.ExprArray(_) => {
      return false;
    },
    ast.ExprTuple(_) => {
      return false;
    },
    ast.ExprMapLit(_) => {
      return false;
    },
    ast.ExprBinary(_) => {
      return false;
    },
    ast.ExprUnary(u) => {
      return u.op == "try_";
    },
    ast.ExprCall(c) => {
      if let ast.ExprIdent(_) = c.callee {
        return lu_call_site_borrows(fx, c);
      }
      return true;
    },
    _ => {
      return true;
    }
  }
  return true;
}

// An own parameter holds its fields as a fresh local does, so a field unpacked from it is owned the same way.
function lu_own_param(fx: LuFn, name: string): boolean {
  return util.has_str(fx.owned, name) && lu_decl_count(fx, name) == 0;
}

function lu_fresh_expr(e: ast.Expr): boolean {
  if let ast.ExprUnary(u) = e {
    return u.op == "try_" && lu_fresh_expr(u.operand);
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(_) = c.callee {
      return true;
    }
    if let ast.ExprFieldAccess(_) = c.callee {
      return true;
    }
  }
  if let ast.ExprArray(_) = e {
    return true;
  }
  if let ast.ExprString(_) = e {
    return true;
  }
  if let ast.ExprStructLit(sl) = e {
    return !sl.has_base;
  }
  return false;
}

function lu_unpack_init(fx: LuFn, name: string): boolean {
  let Some(init) = lu_init_of(fx, name) else {
    return false;
  };
  return lu_unpack_expr(fx, init);
}

// An unpack reads the one field of a fresh local or an own parameter that
// nothing else reads, from a holder that each mention selects a field of.
function lu_unpack_expr(fx: LuFn, init: ast.Expr): boolean {
  return lu_unpack_expr_in(fx, init, []);
}

function lu_unpack_expr_in(fx: LuFn, init: ast.Expr, seen: string[]): boolean {
  if let ast.ExprFieldAccess(fa) = init {
    let h = ow_ident_name(fa.obj);
    if (h.len() == 0 || !(lu_fresh_init_in(fx, h, seen) && lu_decl_count(fx, h) == 1) && !lu_own_param(fx, h)) {
      return false;
    }
    let reads = 0;
    let selections = 0;
    for sel in fx.facts.sels {
      if (sel.obj == h) {
        selections += 1;
        if (sel.field == fa.field) {
          reads += 1;
        }
      }
    }
    return reads == 1 && selections == lu_occ_count(fx, h);
  }
  return false;
}

function lu_rename_source(fx: LuFn, name: string): string {
  let Some(init) = lu_init_of(fx, name) else {
    return "";
  };
  let src = ow_ident_name(init);
  if (src.len() == 0 || lu_occ_count(fx, src) != 1) {
    return "";
  }
  return src;
}

// A local that can move into an own parameter: an admitted local, or an
// alias `let a = b`, declared once outside a loop, that takes an owned b at
// its last use and is given only owned values after that. An owned value is
// a fresh value, an unpack, an owned name, or a self-update
// `T { ...a, f: v }`. A name in `seen` is on the path, so a cycle of aliases
// is decided by its other values.
function lu_admitted(fx: LuFn, name: string): boolean {
  return lu_move_admitted(fx, name, []);
}

function lu_move_admitted(fx: LuFn, name: string, seen: string[]): boolean {
  if (lu_base_admitted(fx, name)) {
    return true;
  }
  if (util.has_str(seen, name)) {
    return true;
  }
  let inner = seen.append(name);
  if (!lu_alias_admitted(fx, name, inner)) {
    return false;
  }
  for a in fx.facts.assigns {
    if (a.name == name && !lu_value_owned(fx, name, a.init, inner)) {
      return false;
    }
  }
  return true;
}

function lu_owned_name(fx: LuFn, name: string, seen: string[]): boolean {
  return lu_own_param(fx, name) || lu_fresh_bound(fx, name) || lu_is_local(fx, name) && lu_move_admitted(fx, name, seen);
}

// A name that only matches on a fresh call bind: the match takes the result,
// so the payload is owned.
function lu_fresh_bound(fx: LuFn, name: string): boolean {
  if (util.has_str(fx.params, name) || lu_decl_count(fx, name) != 0) {
    return false;
  }
  let found = false;
  for b in fx.facts.matched {
    if (b.name == name) {
      if (!lu_iter_owned(fx, b.init)) {
        return false;
      }
      found = true;
    }
  }
  return found;
}

function lu_alias_admitted(fx: LuFn, name: string, seen: string[]): boolean {
  if (lu_decl_count(fx, name) != 1 || util.has_str(fx.looped, name)) {
    return false;
  }
  let Some(init) = lu_init_of(fx, name) else {
    return false;
  };
  if let ast.ExprIdent(src) = init {
    return lu_is_last(fx, src) && lu_owned_name(fx, src.name, seen);
  }
  if let Some(src) = lu_spread_source(init) {
    return lu_is_last(fx, src) && lu_owned_name(fx, src.name, seen);
  }
  return false;
}

// The base of a struct literal `T { ...src, f: v }` whose field values do
// not name `src`. The literal takes the rest of `src`, as an alias does.
function lu_spread_source(e: ast.Expr): Option[ast.ExprIdent] {
  let ast.ExprStructLit(sl) = e else {
    return None;
  };
  let ast.ExprIdent(src) = sl.base else {
    return None;
  };
  if (!sl.has_base) {
    return None;
  }
  for v in sl.field_values {
    if (util.has_str(astwalk.fold_expr_nodes(v, [], lu_name_stmt, lu_name_expr, astwalk.descend_all), src.name)) {
      return None;
    }
  }
  return Some(src);
}

function lu_value_owned(fx: LuFn, target: string, e: ast.Expr, seen: string[]): boolean {
  if (lu_fresh_value(fx, e) || lu_unpack_expr(fx, e)) {
    return true;
  }
  if let ast.ExprIdent(src) = e {
    return lu_owned_name(fx, src.name, seen);
  }
  if let ast.ExprStructLit(sl) = e {
    return sl.has_base && ow_ident_name(sl.base) == target;
  }
  return false;
}

function lu_base_admitted(fx: LuFn, name: string): boolean {
  if (lu_fresh_init(fx, name) || lu_unpack_init(fx, name) || lu_owned_alias(fx, name)) {
    return true;
  }
  let root = lu_rename_source(fx, name);
  if (root.len() == 0) {
    return false;
  }
  let seen: string[] = [name, root];
  let next = lu_rename_source(fx, root);
  while (next.len() > 0 && !util.has_str(seen, next)) {
    root = next;
    seen = seen.append(next);
    next = lu_rename_source(fx, root);
  }
  return lu_own_param(fx, root) || lu_fresh_init(fx, root) || lu_unpack_init(fx, root);
}

function lu_is_last(fx: LuFn, id: ast.ExprIdent): boolean {
  for o in fx.facts.occ {
    if (o.name == id.name && (o.line > id.line || o.line == id.line && o.col > id.col)) {
      return false;
    }
  }
  return true;
}

function lu_mentions(st: ast.Stmt, name: string): i32 {
  let n = 0;
  for nm in lu_all_names(st, []) {
    if (nm == name) {
      n += 1;
    }
  }
  return n;
}

function lu_no_stmt(): ast.Stmt {
  return ast.StmtUnknown { kind: "", line: 0, col: 0 };
}

function lu_plain_frame(stmts: ast.Stmt[]): LuFrame {
  return LuFrame { stmts: stmts, idx: 0, head: lu_no_stmt(), is_loop: false, label: "" };
}

function lu_loop_frame(stmts: ast.Stmt[], head: ast.Stmt, label: string): LuFrame {
  return LuFrame { stmts: stmts, idx: 0, head: head, is_loop: true, label: label };
}

function lu_site_frames(sc: LuScope, stmts: ast.Stmt[], i: i32): LuFrame[] {
  if (!sc.framed) {
    return sc.frames;
  }
  return sc.frames.append(LuFrame { ...sc.head, stmts: stmts, idx: i });
}

function lu_stmt_holds(st: ast.Stmt, line: i32, col: i32): boolean {
  let h = astwalk.fold_stmt_nodes(st, LuHold { line: line, col: col, found: false }, lu_hold_stmt, lu_hold_expr, astwalk.descend_all);
  return h.found;
}

function lu_hold_keep(e: ast.Expr, own h: LuHold): LuHold {
  return h;
}

// A `for` header runs once, so only its body runs the call again.
function lu_loop_hold_stmt(st: ast.Stmt, own h: LuHold): LuHold {
  if (h.found) {
    return h;
  }
  if let ast.StmtFor(fo) = st {
    for b in fo.body {
      if (lu_stmt_holds(b, h.line, h.col)) {
        return LuHold { ...h, found: true };
      }
    }
    return h;
  }
  if (!lu_is_loop_stmt(st)) {
    return h;
  }
  return LuHold { ...h, found: lu_stmt_holds(st, h.line, h.col) };
}

// A loop inside the statement runs the call again each round: the call sits
// in a loop's head, or in a loop inside an expression-level block.
function lu_loop_holds_call(st: ast.Stmt, call: ast.Expr): boolean {
  let h = astwalk.fold_stmt_nodes(st, lu_hold_at(call), lu_loop_hold_stmt, lu_hold_keep, astwalk.descend_all);
  return h.found;
}

function lu_is_loop_stmt(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtWhile(_) => {
      return true;
    },
    ast.StmtFor(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function lu_empty_facts(): LuFacts {
  return LuFacts { occ: [], vars: [], assigns: [], escaping: [], sels: [], captured: [], defer_bare: [], defer_fields: [], updates: [], unpacked: [], matched: [] };
}

// A search for an occurrence of a name, the same occurrences that LuFacts.occ
// records: a read or an assignment target. When later is true, the search
// finds an occurrence after the position. Otherwise it finds the one at it.
struct LuMention { name: string, line: i32, col: i32, later: boolean, found: boolean }

function lu_mention_matches(m: LuMention, name: string, line: i32, col: i32): boolean {
  if (name != m.name) {
    return false;
  }
  if (m.later) {
    return line > m.line || line == m.line && col > m.col;
  }
  return line == m.line && col == m.col;
}

function lu_mention_stmt(st: ast.Stmt, own m: LuMention): LuMention {
  if (m.found) {
    return m;
  }
  if let ast.StmtAssign(a) = st {
    if (lu_mention_matches(m, a.target, a.target_line, a.target_col)) {
      return LuMention { ...m, found: true };
    }
  }
  return m;
}

function lu_mention_expr(e: ast.Expr, own m: LuMention): LuMention {
  if (m.found) {
    return m;
  }
  if let ast.ExprIdent(id) = e {
    if (lu_mention_matches(m, id.name, id.line, id.col)) {
      return LuMention { ...m, found: true };
    }
  }
  return m;
}

function lu_mention_search(aid: ast.ExprIdent, later: boolean): LuMention {
  return LuMention { name: aid.name, line: aid.line, col: aid.col, later: later, found: false };
}

// A later mention of the name inside the statement.
function lu_later_in(st: ast.Stmt, aid: ast.ExprIdent): boolean {
  return astwalk.fold_stmt_nodes(st, lu_mention_search(aid, true), lu_mention_stmt, lu_mention_expr, astwalk.descend_all).found;
}

function lu_expr_mentions(e: ast.Expr, aid: ast.ExprIdent, later: boolean): boolean {
  return astwalk.fold_expr_nodes(e, lu_mention_search(aid, later), lu_mention_stmt, lu_mention_expr, astwalk.descend_all).found;
}

// The names a let declares, as LuFacts.vars records them.
function lu_var_names(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtVar(v) = st {
    if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
      for d in lu_destr_vars(v, []) {
        acc = acc.append(d.name);
      }
      return acc;
    }
    return acc.append(v.name);
  }
  return acc;
}

function lu_declares(st: ast.Stmt, name: string): boolean {
  if (util.has_str(astwalk.fold_stmt_nodes(st, [], lu_var_names, lu_no_binders, astwalk.not_lambda), name)) {
    return true;
  }
  return util.has_str(astwalk.fold_stmt_nodes(st, [], lu_arm_binders, lu_no_binders, astwalk.not_lambda), name);
}

function lu_arm_binders(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtMatch(m) = st {
    for arm in m.arms {
      acc = astwalk.pattern_binders(arm.pattern, acc);
    }
  }
  return acc;
}

function lu_no_binders(e: ast.Expr, own acc: string[]): string[] {
  return acc;
}

function lu_loop_labels(st: ast.Stmt, own acc: string[]): string[] {
  match (st) {
    ast.StmtWhile(w) => {
      acc = acc.append(w.label);
      return lu_loop_labels_all(w.body, acc);
    },
    ast.StmtFor(fo) => {
      acc = acc.append(fo.label);
      return lu_loop_labels_all(fo.body, acc);
    },
    ast.StmtIf(f) => {
      acc = lu_loop_labels_all(f.then_body, acc);
      return lu_loop_labels_all(f.else_body, acc);
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        acc = lu_loop_labels_all(arm.body, acc);
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function lu_loop_labels_all(stmts: ast.Stmt[], own acc: string[]): string[] {
  for st in stmts {
    acc = lu_loop_labels(st, acc);
  }
  return acc;
}

function lu_jump_escapes(label: string, nested: boolean, inner: string[]): boolean {
  if (label.len() == 0) {
    return !nested;
  }
  return !util.has_str(inner, label);
}

// The breaks and continues that leave the statement, each with the label it
// names. A jump to a loop inside the statement stays inside it.
function lu_jumps(st: ast.Stmt): LuJumps {
  let inner = lu_loop_labels(st, []);
  return lu_jump_walk(st, false, inner, LuJumps { breaks: [], continues: [] });
}

function lu_jump_walk(st: ast.Stmt, nested: boolean, inner: string[], own j: LuJumps): LuJumps {
  match (st) {
    ast.StmtBreak(b) => {
      if (lu_jump_escapes(b.label, nested, inner)) {
        return LuJumps { ...j, breaks: j.breaks.append(b.label) };
      }
      return j;
    },
    ast.StmtContinue(c) => {
      if (lu_jump_escapes(c.label, nested, inner)) {
        return LuJumps { ...j, continues: j.continues.append(c.label) };
      }
      return j;
    },
    ast.StmtIf(f) => {
      j = lu_jump_walk_all(f.then_body, nested, inner, j);
      return lu_jump_walk_all(f.else_body, nested, inner, j);
    },
    ast.StmtWhile(w) => {
      return lu_jump_walk_all(w.body, true, inner, j);
    },
    ast.StmtFor(fo) => {
      return lu_jump_walk_all(fo.body, true, inner, j);
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        j = lu_jump_walk_all(arm.body, nested, inner, j);
      }
      return j;
    },
    _ => {
      return j;
    }
  }
  return j;
}

function lu_jump_walk_all(stmts: ast.Stmt[], nested: boolean, inner: string[], own j: LuJumps): LuJumps {
  for st in stmts {
    j = lu_jump_walk(st, nested, inner, j);
  }
  return j;
}

// The level of the body frame of the loop a jump names: the innermost loop
// for "", else the loop that carries the label. -1 when there is none.
function lu_loop_level(frames: LuFrame[], level: i32, label: string): i32 {
  let l = level;
  while (l >= 0) {
    if (frames[l].is_loop && (label.len() == 0 || frames[l].label == label)) {
      return l;
    }
    l -= 1;
  }
  return -1;
}

// The loop whose body is frames[l] reads the name on its next round when the
// loop mentions it and the body does not declare it afresh each time.
function lu_loop_head_live(frames: LuFrame[], l: i32, name: string): boolean {
  if let ast.StmtFor(fo) = frames[l].head {
    if (fo.var_name == name) {
      return false;
    }
  }
  if (lu_declares(frames[l].head, name)) {
    return false;
  }
  return lu_mentions(frames[l].head, name) > 0;
}

function lu_call_repeats_binding(st: ast.Stmt, call: ast.Expr, site: LuSite, life: LuLife): boolean {
  return lu_loop_holds_call(st, call) && !(life.scope >= 0 && life.loop_depth == site.loop_depth);
}

// Whether the name can be read again on some path after the statement that
// holds the call. A path that reaches the end of a loop body, or continues,
// comes back to every use in that loop.
function lu_live_after(fx: LuFn, site: LuSite, call: ast.Expr, aid: ast.ExprIdent): boolean {
  if (site.frames.len() == 0) {
    return true;
  }
  let inner = site.frames[site.frames.len() - 1];
  let st = inner.stmts[inner.idx];
  if (lu_never_returns(fx.noret, st)) {
    return false;
  }
  let life = lu_binding_life(site, aid.name);
  let bound = life.scope >= 0;
  if (lu_call_repeats_binding(st, call, site, life)) {
    return true;
  }
  let scope = lu_binding_level(site.frames, aid.name);
  if (bound) {
    scope = life.scope;
  }
  if let ast.StmtMatch(m) = st {
    let r = LU_CONTINUES;
    let reach = LuReach { noret: fx.noret, frames: site.frames, level: site.frames.len() - 1, scope: scope };
    if (lu_same_ident(m.scrutinee, aid)) {
      r = lu_match_tag_live(reach, m, aid.name);
    } else if (lu_mentions_at(m.scrutinee, aid)) {
      r = lu_call_tag_settles(reach, m, aid);
    } else {
      r = LU_NOT_TAG;
    }
    if (r != LU_NOT_TAG) {
      return r == LU_LIVE || r == LU_CONTINUES && lu_live_from(fx.noret, site.frames, site.frames.len() - 1, aid.name, scope);
    }
  }
  if (lu_later_in(st, aid)) {
    return true;
  }
  return lu_live_from(fx.noret, site.frames, site.frames.len() - 1, aid.name, scope);
}

const LU_CONTINUES: i32 = 0;

const LU_LIVE: i32 = 1;

const LU_SETTLED: i32 = 2;

const LU_NOT_TAG: i32 = 3;

// The argument at aid is in the expression, so a call in a match tag takes it.
function lu_mentions_at(e: ast.Expr, aid: ast.ExprIdent): boolean {
  return lu_expr_mentions(e, aid, false);
}

// A local that a call in a match tag takes. LU_LIVE: a later read in the
// tag, or a read in a guard or an arm before a whole assignment. LU_SETTLED:
// every arm assigns the local whole or leaves the statement.
function lu_call_tag_settles(reach: LuReach, m: ast.StmtMatch, aid: ast.ExprIdent): i32 {
  if (lu_expr_mentions(m.scrutinee, aid, true)) {
    return LU_LIVE;
  }
  let settled = m.arms.len() > 0;
  for arm in m.arms {
    if (arm.has_guard && astwalk.count_ident_expr(arm.guard, aid.name) > 0) {
      return LU_LIVE;
    }
    let r = lu_stmts_settle(reach, arm.body, aid.name);
    if (r == LU_LIVE) {
      return LU_LIVE;
    }
    if (r != LU_SETTLED) {
      settled = false;
    }
  }
  if (settled) {
    return LU_SETTLED;
  }
  return LU_CONTINUES;
}

function lu_same_ident(e: ast.Expr, aid: ast.ExprIdent): boolean {
  if let ast.ExprIdent(id) = e {
    return id.name == aid.name && id.line == aid.line && id.col == aid.col;
  }
  return false;
}

// The value a match takes from the local name, as seen from inside the match.
// An arm that binds nothing leaves the local whole, so its reads are not reads
// of the taken value. LU_LIVE: an arm that binds a payload reads the taken
// value. LU_SETTLED: every such arm gives the local a new value or leaves the
// statement, so the statements after the match do not read the taken value.
function lu_match_tag_live(reach: LuReach, m: ast.StmtMatch, name: string): i32 {
  let settled = true;
  for arm in m.arms {
    if (astwalk.pattern_binders(arm.pattern, []).len() == 0) {
      continue;
    }
    if (arm.has_guard && astwalk.count_ident_expr(arm.guard, name) > 0) {
      return LU_LIVE;
    }
    let r = lu_stmts_settle(reach, arm.body, name);
    if (r == LU_LIVE) {
      return LU_LIVE;
    }
    if (r != LU_SETTLED) {
      settled = false;
    }
  }
  if (settled) {
    return LU_SETTLED;
  }
  return LU_CONTINUES;
}

// Where a statement list sits: a break or a continue in it leaves to a loop
// of frames, seen from level, for a binding at scope.
struct LuReach { noret: util.NameIndex, frames: LuFrame[], level: i32, scope: i32 }

// A statement list that follows a take of name. LU_LIVE: a read of name
// before a whole assignment to it, also after a break or a continue.
// LU_SETTLED: every path assigns name whole or leaves the list early.
// LU_CONTINUES: a path reaches the end with the taken value still in name.
function lu_stmts_settle(reach: LuReach, stmts: ast.Stmt[], name: string): i32 {
  let chain = LuChain { flag: "", settles: true, result: LU_NOT_ARM };
  for st in stmts {
    if (lu_assigns_whole(st, name)) {
      return LU_SETTLED;
    }
    chain = lu_chain_next(reach, st, name, chain);
    let r = lu_settle_step(reach, st, name, chain);
    if (r == LU_LIVE || r == LU_SETTLED) {
      return r;
    }
    if (r == LU_CONTINUES) {
      continue;
    }
    if (lu_mentions(st, name) > 0) {
      return LU_LIVE;
    }
    if (lu_jumps_live(reach.noret, reach.frames, reach.level, lu_jumps(st), name, reach.scope)) {
      return LU_LIVE;
    }
    let one: ast.Stmt[] = [st];
    if (block_diverges(one, false) || lu_never_returns(reach.noret, st)) {
      return LU_SETTLED;
    }
  }
  return LU_CONTINUES;
}

const LU_NOT_BRANCH: i32 = 3;

const LU_NOT_ARM: i32 = LU_NOT_BRANCH;

// The statement as an arm of the chain, else as a branch.
function lu_settle_step(reach: LuReach, st: ast.Stmt, name: string, chain: LuChain): i32 {
  if (chain.result != LU_NOT_ARM) {
    return chain.result;
  }
  return lu_branch_settle(reach, st, name);
}

const LU_ARM_GUARDED: i32 = 1;

const LU_ARM_ALWAYS: i32 = 2;

// A chain of arms on a flag, as the parser lowers a tuple pattern:
// `let flag = false;` and then `if (!flag && ...) { ...; flag = true; ... }`
// for each arm. A path that does not set the flag goes on to the next arm.
// `settles`: each path of the arms so far that sets the flag settles.
// `result`: LU_NOT_ARM when the statement is not an arm, else as
// lu_stmts_settle.
struct LuChain { flag: string, settles: boolean, result: i32 }

// The chain after `st`. An arm that sets the flag on each path that enters
// it ends the chain: when each arm settles, so does the chain.
function lu_chain_next(reach: LuReach, st: ast.Stmt, name: string, chain: LuChain): LuChain {
  let kind = lu_flag_arm_kind(st, chain.flag);
  let ast.StmtIf(f) = st else {
    return lu_chain_after(st, chain);
  };
  if (kind == LU_NOT_ARM) {
    return lu_chain_after(st, chain);
  }
  if (astwalk.count_ident_expr(f.cond, name) > 0) {
    return LuChain { ...chain, result: LU_LIVE };
  }
  let r = lu_flag_arm_settle(reach, f.then_body, name, chain.flag);
  if (r == LU_LIVE) {
    return LuChain { ...chain, result: LU_LIVE };
  }
  let settles = chain.settles && r == LU_SETTLED;
  if (kind == LU_ARM_ALWAYS && settles) {
    return LuChain { ...chain, result: LU_SETTLED };
  }
  return LuChain { flag: chain.flag, settles: settles, result: LU_CONTINUES };
}

// `let flag = false` starts a chain. Any other mention of the flag ends it.
function lu_chain_after(st: ast.Stmt, chain: LuChain): LuChain {
  if let ast.StmtVar(v) = st {
    if let ast.ExprBool(b) = v.init {
      if (!b.value && !name_has_comma(v.name)) {
        return LuChain { flag: v.name, settles: true, result: LU_NOT_ARM };
      }
    }
  }
  if (chain.flag.len() > 0 && lu_mentions(st, chain.flag) > 0) {
    return LuChain { flag: "", settles: true, result: LU_NOT_ARM };
  }
  return LuChain { ...chain, result: LU_NOT_ARM };
}

// LU_ARM_ALWAYS: `if (true)` or `if (!flag)` that sets the flag first.
// LU_ARM_GUARDED: another `if (!flag && ...)` with no else.
function lu_flag_arm_kind(st: ast.Stmt, flag: string): i32 {
  let ast.StmtIf(f) = st else {
    return LU_NOT_ARM;
  };
  if (flag.len() == 0 || f.else_body.len() > 0 || f.then_body.len() == 0 || !lu_flag_gated(f.cond, flag)) {
    return LU_NOT_ARM;
  }
  if (lu_sets_flag(f.then_body[0], flag) && lu_flag_test(f.cond, flag)) {
    return LU_ARM_ALWAYS;
  }
  return LU_ARM_GUARDED;
}

// `true`, `!flag`, or one of them followed by `&& e` where e does not
// mention the flag.
function lu_flag_gated(e: ast.Expr, flag: string): boolean {
  if let ast.ExprBinary(b) = e {
    return b.op == "&&" && lu_flag_gated(b.left, flag) && astwalk.count_ident_expr(b.right, flag) == 0;
  }
  return lu_flag_test(e, flag);
}

function lu_flag_test(e: ast.Expr, flag: string): boolean {
  if let ast.ExprBool(b) = e {
    return b.value;
  }
  if let ast.ExprUnary(u) = e {
    if let ast.ExprIdent(id) = u.operand {
      return u.op == "!" && id.name == flag;
    }
  }
  return false;
}

function lu_sets_flag(st: ast.Stmt, flag: string): boolean {
  if let ast.StmtAssign(a) = st {
    if let ast.ExprBool(b) = a.value {
      return a.target == flag && a.op.len() == 0 && b.value;
    }
  }
  return false;
}

// The paths of an arm body that set the flag. The body binds names first,
// and then sets the flag, or ends in `if (guard) { flag = true; ... }`.
// A body of another shape is settled on each of its paths.
function lu_flag_arm_settle(reach: LuReach, body: ast.Stmt[], name: string, flag: string): i32 {
  let k = lu_first_nonbinding(body, name, flag);
  if (k < body.len() && lu_sets_flag(body[k], flag)) {
    return lu_stmts_settle(reach, lu_stmts_from(body, k), name);
  }
  if (k == body.len() - 1 && lu_guard_commits(body[k], name, flag)) {
    if let ast.StmtIf(g) = body[k] {
      return lu_stmts_settle(reach, g.then_body, name);
    }
  }
  return lu_stmts_settle(reach, body, name);
}

function lu_first_nonbinding(body: ast.Stmt[], name: string, flag: string): i32 {
  for i in 0..body.len() {
    if (!lu_binds_only(body[i], name, flag)) {
      return i;
    }
  }
  return body.len();
}

// `if (guard) { flag = true; ... }`, where the guard does not read name.
function lu_guard_commits(st: ast.Stmt, name: string, flag: string): boolean {
  let ast.StmtIf(g) = st else {
    return false;
  };
  return g.else_body.len() == 0 && g.then_body.len() > 0 && lu_sets_flag(g.then_body[0], flag) && astwalk.count_ident_expr(g.cond, name) == 0;
}

function lu_binds_only(st: ast.Stmt, name: string, flag: string): boolean {
  if let ast.StmtVar(_) = st {
    return lu_mentions(st, name) == 0 && lu_mentions(st, flag) == 0;
  }
  return false;
}

function lu_stmts_from(stmts: ast.Stmt[], k: i32): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for i in k..stmts.len() {
    out = out.append(stmts[i]);
  }
  return out;
}

// A match or an if statement settles when each of its paths settles, and is
// live when one path reads name. Any other statement is LU_NOT_BRANCH.
function lu_branch_settle(reach: LuReach, st: ast.Stmt, name: string): i32 {
  match (st) {
    ast.StmtMatch(m) => {
      if (astwalk.count_ident_expr(m.scrutinee, name) > 0) {
        return LU_LIVE;
      }
      let settled = m.arms.len() > 0;
      for arm in m.arms {
        if (arm.has_guard && astwalk.count_ident_expr(arm.guard, name) > 0) {
          return LU_LIVE;
        }
        let r = lu_stmts_settle(reach, arm.body, name);
        if (r == LU_LIVE) {
          return LU_LIVE;
        }
        if (r != LU_SETTLED) {
          settled = false;
        }
      }
      if (settled) {
        return LU_SETTLED;
      }
      return LU_CONTINUES;
    },
    ast.StmtIf(f) => {
      if (astwalk.count_ident_expr(f.cond, name) > 0) {
        return LU_LIVE;
      }
      let rt = lu_stmts_settle(reach, f.then_body, name);
      if (rt == LU_LIVE) {
        return LU_LIVE;
      }
      if (lu_if_always_runs(f)) {
        return rt;
      }
      if (f.else_body.len() == 0) {
        return LU_CONTINUES;
      }
      let re = lu_stmts_settle(reach, f.else_body, name);
      if (re == LU_LIVE) {
        return LU_LIVE;
      }
      if (rt == LU_SETTLED && re == LU_SETTLED) {
        return LU_SETTLED;
      }
      return LU_CONTINUES;
    },
    _ => {
      return LU_NOT_BRANCH;
    }
  }
  return LU_NOT_BRANCH;
}

// A block, an unsafe block, or an `if (true)`: the then body always runs.
function lu_if_always_runs(f: ast.StmtIf): boolean {
  if let ast.ExprBool(b) = f.cond {
    return b.value;
  }
  return f.origin == "block" || f.origin == "unsafe";
}

// A statement that calls a function which never returns.
function lu_never_returns(noret: util.NameIndex, st: ast.Stmt): boolean {
  if let ast.StmtExpr(x) = st {
    return lu_call_never_returns(x.value, noret, true);
  }
  return false;
}

// The plain functions whose body never returns: on every path it ends in a
// call to exit, in a call to another such function, or in a loop that never
// breaks.
function lu_no_return_funcs(mod: parser.Module): util.NameIndex {
  let out: string[] = [];
  let changed = true;
  while (changed) {
    changed = false;
    let idx = util.name_index(out);
    for fn in mod.funcs {
      if (fn.receiver_name.len() > 0 || idx.has(fn.name) || util.has_str(out, fn.name)) {
        continue;
      }
      if (lu_stmts_exit(fn.body, idx, util.has_str(ow_param_names(fn), "exit"))) {
        out = out.append(fn.name);
        changed = true;
      }
    }
  }
  return util.name_index(out);
}

function lu_stmts_exit(stmts: ast.Stmt[], noret: util.NameIndex, bound: boolean): boolean {
  return stmts.len() > 0 && lu_stmt_exits(stmts[stmts.len() - 1], noret, bound);
}

function lu_stmt_exits(st: ast.Stmt, noret: util.NameIndex, bound: boolean): boolean {
  match (st) {
    ast.StmtExpr(x) => {
      return lu_call_never_returns(x.value, noret, bound);
    },
    ast.StmtIf(f) => {
      if (f.origin == "block" || f.origin == "unsafe") {
        return lu_stmts_exit(f.then_body, noret, bound);
      }
      return f.else_body.len() > 0 && lu_stmts_exit(f.then_body, noret, bound) && lu_stmts_exit(f.else_body, noret, bound);
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        if (!lu_stmts_exit(arm.body, noret, bound)) {
          return false;
        }
      }
      return m.arms.len() > 0;
    },
    ast.StmtWhile(w) => {
      if let ast.ExprBool(b) = w.cond {
        return b.value && !loop_can_break(w.body, w.label, false);
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// bound: a parameter named exit hides the builtin, so the check names only
// the functions noret holds.
function lu_call_never_returns(e: ast.Expr, noret: util.NameIndex, bound: boolean): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (id.name == "exit" && !bound) {
        return true;
      }
      return noret.has(id.name);
    }
  }
  return false;
}

function lu_assigns_whole(st: ast.Stmt, name: string): boolean {
  if let ast.StmtAssign(a) = st {
    return a.target == name && astwalk.count_ident_expr(a.value, name) == 0;
  }
  return false;
}

function lu_live_from(noret: util.NameIndex, frames: LuFrame[], level: i32, name: string, scope: i32): boolean {
  if (level < 0) {
    return false;
  }
  let f = frames[level];
  let reach = LuReach { noret: noret, frames: frames, level: level, scope: scope };
  for j in f.idx + 1..f.stmts.len() {
    // A new value on every path replaces the local before any read of the
    // old one.
    let r = lu_stmts_settle(reach, [f.stmts[j]], name);
    if (r == LU_LIVE) {
      return true;
    }
    if (r == LU_SETTLED) {
      return false;
    }
  }
  if (level <= scope) {
    // The binding ends with the block that declares it.
    return false;
  }
  if (f.is_loop && (scope >= 0 || lu_loop_head_live(frames, level, name))) {
    return true;
  }
  if (level == 0) {
    return false;
  }
  return lu_live_from(noret, frames, level - 1, name, scope);
}

// Whether a continue or a break of the statement reaches a read of the name.
// A jump to a loop at or outside the block of the binding leaves the binding.
function lu_jumps_live(noret: util.NameIndex, frames: LuFrame[], level: i32, jumps: LuJumps, name: string, scope: i32): boolean {
  for label in jumps.continues {
    let l = lu_loop_level(frames, level, label);
    if (l < 0 || l > scope && (scope >= 0 || lu_loop_head_live(frames, l, name) || lu_live_from(noret, frames, l - 1, name, scope))) {
      return true;
    }
  }
  for label in jumps.breaks {
    let l = lu_loop_level(frames, level, label);
    if (l < 0 || l > scope && lu_live_from(noret, frames, l - 1, name, scope)) {
      return true;
    }
  }
  return false;
}

// The level of the innermost frame that binds `name` before the statement that
// the frame holds: the block that the read binding belongs to. A match arm
// binds its names for its body. It is -1 when no frame binds `name`, as for a
// parameter.
function lu_binding_level(frames: LuFrame[], name: string): i32 {
  let l = frames.len() - 1;
  while (l >= 0) {
    if (lu_frame_binds(frames, l, name)) {
      return l;
    }
    l -= 1;
  }
  return -1;
}

function lu_dies(fx: LuFn, call: ast.Expr, aid: ast.ExprIdent, outer: ast.Expr, has_outer: boolean, site: LuSite): boolean {
  let name = aid.name;
  let elem = lu_elem_fresh(fx, site, name);
  if (!lu_is_local(fx, name) && !elem) {
    return false;
  }
  let once = astwalk.count_ident_expr(call, name) == 1;
  if (site.in_defer) {
    return !site.in_loop && once && !util.has_str(fx.facts.captured, name) && lu_decl_count(fx, name) == 1 && (lu_fresh_init(fx, name) || lu_unpack_init(fx, name));
  }
  if (util.has_str(fx.facts.escaping, name)) {
    return false;
  }
  if (lu_rebind_site(site, name) || lu_returns_after_reads(site, call, aid)) {
    return true;
  }
  if (!once && !lu_reads_before(call, aid)) {
    return false;
  }
  if (has_outer && astwalk.count_ident_expr(outer, name) > 1) {
    return false;
  }
  return !lu_live_after(fx, site, call, aid);
}

// The other mentions of `aid` in the call are reads of one of its fields, in
// arguments before it. The ownership walk decides whether each read gives a
// copy: its key carries "~".
function lu_reads_before(call: ast.Expr, aid: ast.ExprIdent): boolean {
  let ast.ExprCall(c) = call else {
    return false;
  };
  let before = 0;
  for a in c.args {
    if let ast.ExprIdent(x) = a {
      if (x.line == aid.line && x.col == aid.col) {
        return before + 1 == astwalk.count_ident_expr(call, aid.name);
      }
    }
    let n = astwalk.count_ident_expr(a, aid.name);
    if (n > 0) {
      if (n != 1 || !lu_reads_field_of(a, aid.name)) {
        return false;
      }
      before += 1;
    }
  }
  return false;
}

function lu_reads_field_of(e: ast.Expr, name: string): boolean {
  if let ast.ExprFieldAccess(fa) = e {
    if let ast.ExprIdent(o) = fa.obj {
      return o.name == name;
    }
  }
  return false;
}

// A return of the call, which mentions the name only in it, and there only
// in field reads before the argument.
function lu_returns_after_reads(site: LuSite, call: ast.Expr, aid: ast.ExprIdent): boolean {
  if let ast.StmtReturn(r) = site.stmts[site.idx] {
    return !site.in_iife && astwalk.count_ident_expr(r.value, aid.name) == astwalk.count_ident_expr(call, aid.name) && lu_reads_before(call, aid);
  }
  return false;
}

// "~" when the call mentions the name more than once.
function lu_copy_tag(call: ast.Expr, name: string): string {
  if (astwalk.count_ident_expr(call, name) > 1) {
    return "~";
  }
  return "";
}

// A local that is not admitted can be a read out of a borrowed structure.
// Its key carries "^", and only a type that cannot hold a handle moves.
function lu_loose_tag(fx: LuFn, site: LuSite, name: string): string {
  if (lu_admitted(fx, name) || lu_elem_fresh(fx, site, name)) {
    return "";
  }
  return "^";
}

// `q.f` passed to an own parameter moves the field out of q when q is a
// fresh local or an own parameter, nothing later reads the path or the
// whole, and no deferred action holds it. Inside a struct literal based on
// q the superseded-field rule decides instead.
function lu_field_dies(fx: LuFn, call: ast.Expr, fa: ast.ExprFieldAccess, q: ast.ExprIdent, site: LuSite): boolean {
  if (util.has_str(fx.facts.captured, q.name) || lu_repeats(site.frames, q.name)) {
    return false;
  }
  let fresh_local = lu_is_local(fx, q.name) && lu_decl_count(fx, q.name) == 1 && (lu_fresh_init(fx, q.name) || lu_unpack_init(fx, q.name));
  let bound = !util.has_str(fx.params, q.name) && lu_decl_count(fx, q.name) == 0 && util.has_str(site.binders, q.name);
  if (!fresh_local && !lu_own_param(fx, q.name) && !bound && !lu_elem_fresh(fx, site, q.name)) {
    return false;
  }
  if (astwalk.count_ident_expr(call, q.name) - lu_other_field_reads(call, q.name, fa.field) != 1) {
    return false;
  }
  if (site.in_defer) {
    return true;
  }
  if (util.has_str(fx.facts.defer_bare, q.name) || util.has_str(fx.facts.defer_fields, q.name + "." + fa.field)) {
    return false;
  }
  if (lu_within_literal_base(site.stmts[site.idx], q.name, call)) {
    return false;
  }
  return lu_path_is_last(fx, q, fa.field) || lu_field_base_dead(fx, site, q, fa.field);
}

// No path after the statement that holds the call reads q, and the statement
// reads only other fields of q after q.field. A later mention in a branch
// that the call does not reach is not a read.
function lu_field_base_dead(fx: LuFn, site: LuSite, q: ast.ExprIdent, field: string): boolean {
  if (site.frames.len() == 0) {
    return false;
  }
  let inner = site.frames[site.frames.len() - 1];
  let facts = astwalk.fold_stmt_nodes(inner.stmts[inner.idx], lu_empty_facts(), lu_fact_stmt, lu_fact_expr, astwalk.descend_all);
  for o in facts.occ {
    if (o.name == q.name && (o.line > q.line || o.line == q.line && o.col > q.col)) {
      let sel = lu_sel_at(facts, o.line, o.col);
      if (sel.len() == 0 || sel == field) {
        return false;
      }
    }
  }
  return !lu_live_from(fx.noret, site.frames, site.frames.len() - 1, q.name, lu_binding_level(site.frames, q.name));
}

struct LuFieldReads { name: string, field: string, n: i32 }

// The reads in call of a field of name other than field. A move of
// name.field leaves those fields to the caller.
function lu_other_field_reads(call: ast.Expr, name: string, field: string): i32 {
  return astwalk.fold_expr_pruned(call, LuFieldReads { name: name, field: field, n: 0 }, lu_count_other_field, astwalk.not_lambda).n;
}

function lu_count_other_field(e: ast.Expr, own r: LuFieldReads): LuFieldReads {
  if let ast.ExprFieldAccess(fa) = e {
    if let ast.ExprIdent(id) = fa.obj {
      if (id.name == r.name && fa.field != r.field) {
        return LuFieldReads { ...r, n: r.n + 1 };
      }
    }
  }
  return r;
}

// A loop deeper than the frame that binds the owner runs the call again on
// the same value. A let at a frame, the for-each whose body it is, or the
// match whose arm it is binds the name afresh each time that frame runs.
function lu_repeats(frames: LuFrame[], name: string): boolean {
  let decl: i32 = -1;
  for l in 0..frames.len() {
    if (lu_frame_binds(frames, l, name)) {
      decl = l;
    }
  }
  for l in decl + 1..frames.len() {
    if (frames[l].is_loop) {
      return true;
    }
  }
  return false;
}

function lu_frame_binds(frames: LuFrame[], l: i32, name: string): boolean {
  let f = frames[l];
  if let ast.StmtFor(fo) = f.head {
    if (fo.var_name == name) {
      return true;
    }
  }
  for j in 0..f.idx {
    if (lu_stmt_declares(f.stmts[j], name)) {
      return true;
    }
  }
  // The head of an arm's frame is its match with that arm alone.
  if let ast.StmtMatch(m) = f.head {
    return util.has_str(astwalk.pattern_binders(m.arms[0].pattern, []), name);
  }
  return false;
}

function lu_stmt_declares(st: ast.Stmt, name: string): boolean {
  if let ast.StmtVar(v) = st {
    if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
      return util.has_str(lu_var_names(st, []), name);
    }
    return v.name == name;
  }
  return false;
}

function lu_scrutinee_is_param(fx: LuFn, e: ast.Expr): boolean {
  if let ast.ExprIdent(id) = e {
    return util.has_str(fx.params, id.name);
  }
  return false;
}

// A for-each variable bound from an owned array is a fresh local each round.
// A scrutinee the match takes without a move site: a fresh value, or an own
// parameter declared nowhere else.
function lu_scrutinee_owned(fx: LuFn, e: ast.Expr): boolean {
  if let ast.ExprIdent(id) = e {
    return lu_own_param(fx, id.name) && lu_decl_count(fx, id.name) == 0;
  }
  return lu_iter_owned(fx, e);
}

function lu_elem_fresh(fx: LuFn, site: LuSite, name: string): boolean {
  return lu_binding_life(site, name).fresh && !util.has_str(fx.params, name) && lu_decl_count(fx, name) == 0;
}

function lu_binding_life(site: LuSite, name: string): LuLife {
  let i = site.bindings.len();
  while (i > 0) {
    i -= 1;
    if (site.bindings[i].name == name) {
      return site.bindings[i];
    }
  }
  return LuLife { name: "", scope: -1, loop_depth: -1, fresh: false };
}

function lu_bind_lifetimes(sc: LuScope, frames: LuFrame[], names: string[], loop_depth: i32, fresh_value: boolean, body: ast.Stmt[], fx: LuFn): LuLife[] {
  let level = frames.len() - 1;
  // A generated value block shares the frame of its enclosing statement.
  if (sc.framed) {
    level = frames.len();
  }
  let lives = sc.bindings;
  for name in names {
    lives = lives.append(LuLife { name: name, scope: level, loop_depth: loop_depth, fresh: fresh_value && lu_payload_assigns_fresh(fx, body, name, 0) });
  }
  return lives;
}

function lu_value_local_lives(st: ast.Stmt, site: LuSite, sc: LuScope): LuLife[] {
  let lives = sc.bindings;
  for local in lu_var_names(st, []) {
    lives = lives.append(LuLife { name: local, scope: site.frames.len() - 1, loop_depth: sc.loop_depth, fresh: false });
  }
  return lives;
}

// A for-each takes its array when the array is a fresh call; a local or an
// own parameter at its last use is a move site and is decided there.
function lu_iter_owned(fx: LuFn, iter: ast.Expr): boolean {
  if let ast.ExprIdent(_) = iter {
    return false;
  }
  return lu_fresh_expr(iter) && !lu_init_borrows(fx, iter);
}

// A match scrutinee or a for-each iterator that is a local, or a field path
// of one, at its last use: the match or the loop takes the payloads.
function lu_move_site(fx: LuFn, e: ast.Expr, site: LuSite, own acc: string[]): string[] {
  match (e) {
    ast.ExprIdent(aid) => {
      if (lu_dies(fx, e, aid, e, false, site) && lu_loose_tag(fx, site, aid.name).len() == 0) {
        return acc.append(lu_key(aid.line, aid.col));
      }
      if (lu_own_param(fx, aid.name) && !util.has_str(fx.facts.escaping, aid.name) && !lu_live_after(fx, site, e, aid)) {
        return acc.append(lu_key(aid.line, aid.col));
      }
      return acc;
    },
    ast.ExprFieldAccess(fa) => {
      if let ast.ExprIdent(q) = fa.obj {
        if (lu_field_dies(fx, e, fa, q, site)) {
          return acc.append(lu_field_key(fa, q));
        }
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

// A later update `S { ...q, field: v }` replaces the path, so it does not
// read it.
function lu_path_is_last(fx: LuFn, q: ast.ExprIdent, field: string): boolean {
  for o in fx.facts.occ {
    if (o.name == q.name && (o.line > q.line || o.line == q.line && o.col > q.col)) {
      let sel = lu_sel_at(fx.facts, o.line, o.col);
      if (sel.len() == 0 && !lu_replaces(fx.facts, o.line, o.col, field) || sel == field) {
        return false;
      }
    }
  }
  return true;
}

function lu_replaces(f: LuFacts, line: i32, col: i32, field: string): boolean {
  for u in f.updates {
    if (u.line == line && u.col == col && u.field == field) {
      return true;
    }
  }
  return false;
}

struct LuLitBase { name: string, call: ast.Expr, found: boolean }

function lu_lit_base_stmt(st: ast.Stmt, own a: LuLitBase): LuLitBase {
  return a;
}

function lu_lit_base_expr(e: ast.Expr, own a: LuLitBase): LuLitBase {
  if (a.found) {
    return a;
  }
  if let ast.ExprStructLit(sl) = e {
    if (sl.has_base && ow_ident_name(sl.base) == a.name) {
      return LuLitBase { ...a, found: lu_holds_call(e, a.call) };
    }
  }
  return a;
}

function lu_within_literal_base(st: ast.Stmt, name: string, call: ast.Expr): boolean {
  let a = astwalk.fold_stmt_nodes(st, LuLitBase { name: name, call: call, found: false }, lu_lit_base_stmt, lu_lit_base_expr, astwalk.descend_all);
  return a.found;
}

// The call a search looks for, by its position, and whether it was found.
struct LuHold { line: i32, col: i32, found: boolean }

function lu_hold_at(call: ast.Expr): LuHold {
  return LuHold { line: ast.expr_line(call), col: ast.expr_col(call), found: false };
}

function lu_hold_stmt(st: ast.Stmt, own h: LuHold): LuHold {
  return h;
}

function lu_hold_expr(e: ast.Expr, own h: LuHold): LuHold {
  if (h.found) {
    return h;
  }
  if let ast.ExprCall(c) = e {
    if (c.line == h.line && c.col == h.col) {
      return LuHold { ...h, found: true };
    }
  }
  return h;
}

function lu_holds_call(scope: ast.Expr, call: ast.Expr): boolean {
  let h = astwalk.fold_expr(scope, lu_hold_at(call), lu_hold_expr);
  return h.found;
}

function lu_field_key(fa: ast.ExprFieldAccess, q: ast.ExprIdent): string {
  return lu_key(q.line, q.col) + "." + fa.field;
}

function lu_rebind_site(site: LuSite, name: string): boolean {
  match (site.stmts[site.idx]) {
    ast.StmtAssign(a) => {
      if let ast.ExprCall(_) = a.value {
        if (a.target == name && astwalk.count_ident_expr(a.value, name) == 1) {
          return true;
        }
      }
    },
    ast.StmtReturn(r) => {
      if (!site.in_iife && astwalk.count_ident_expr(r.value, name) == 1) {
        return true;
      }
    },
    ast.StmtVar(v) => {
      if let ast.ExprCall(_) = v.init {
        if (astwalk.count_ident_expr(v.init, name) == 1) {
          return lu_rebound_after(site, name);
        }
      }
    },
    _ => {}
  }
  return false;
}

function lu_rebound_after(site: LuSite, name: string): boolean {
  let j = site.idx + 1;
  while (j < site.stmts.len()) {
    if let ast.StmtAssign(a) = site.stmts[j] {
      if (a.target == name) {
        if (astwalk.count_ident_expr(a.value, name) != 0) {
          return false;
        }
        let k = site.idx + 1;
        while (k < j) {
          if (!lu_straight(site.stmts[k]) || lu_mentions(site.stmts[k], name) != 0) {
            return false;
          }
          k += 1;
        }
        return true;
      }
    }
    j += 1;
  }
  return false;
}

function lu_straight(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return !lu_has_try(v.init);
    },
    ast.StmtAssign(a) => {
      return !lu_has_try(a.value);
    },
    ast.StmtExpr(x) => {
      return !lu_has_try(x.value);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function lu_has_try(e: ast.Expr): boolean {
  return astwalk.fold_expr_pruned(e, false, lu_try_at, astwalk.not_lambda);
}

function lu_try_at(x: ast.Expr, own found: boolean): boolean {
  if let ast.ExprUnary(u) = x {
    if (u.op == "try_") {
      return true;
    }
  }
  return found;
}

function lu_call(c: ast.ExprCall, e: ast.Expr, outer: ast.Expr, has_outer: boolean, site: LuSite, fx: LuFn, own acc: string[]): string[] {
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (!fx.ofuncs.methods.has(fa.field)) {
      for a in c.args {
        acc = lu_method_arg(a, e, outer, has_outer, site, fx, acc);
      }
      return acc;
    }
    acc = lu_method_arg(fa.obj, e, outer, has_outer, site, fx, acc);
    for a in c.args {
      acc = lu_method_arg(a, e, outer, has_outer, site, fx, acc);
    }
    return acc;
  }
  let cname = ow_ident_name(c.callee);
  if (cname.len() == 0 || util.has_str(fx.params, cname) || !ow_is_own_func(fx.ofuncs, cname)) {
    for a in c.args {
      acc = lu_method_arg(a, e, outer, has_outer, site, fx, acc);
    }
    return acc;
  }
  let flags = ow_func_flags(fx.ofuncs, cname);
  let i = 0;
  while (i < c.args.len() && i < flags.len()) {
    if (flags[i]) {
      match (c.args[i]) {
        ast.ExprIdent(aid) => {
          if (lu_dies(fx, e, aid, outer, has_outer, site)) {
            acc = acc.append(lu_key(aid.line, aid.col) + lu_loose_tag(fx, site, aid.name) + lu_copy_tag(e, aid.name));
          }
        },
        ast.ExprFieldAccess(fa) => {
          if let ast.ExprIdent(q) = fa.obj {
            if (lu_field_dies(fx, e, fa, q, site)) {
              acc = acc.append(lu_field_key(fa, q));
            }
          }
        },
        _ => {}
      }
    }
    i += 1;
  }
  return acc;
}

function lu_method_arg(a: ast.Expr, e: ast.Expr, outer: ast.Expr, has_outer: boolean, site: LuSite, fx: LuFn, own acc: string[]): string[] {
  if let ast.ExprIdent(id) = a {
    if (lu_dies(fx, e, id, outer, has_outer, site)) {
      return acc.append(lu_key(id.line, id.col) + lu_loose_tag(fx, site, id.name));
    }
  }
  if let ast.ExprFieldAccess(fa) = a {
    if let ast.ExprIdent(q) = fa.obj {
      if (lu_field_dies(fx, e, fa, q, site)) {
        return acc.append(lu_field_key(fa, q));
      }
    }
  }
  return acc;
}

function lu_map_lit_children(ml: ast.ExprMapLit, own out: ast.Expr[]): ast.Expr[] {
  let k = 0;
  while (k < ml.keys.len()) {
    out = out.append(ml.keys[k]);
    out = out.append(ml.vals[k]);
    k += 1;
  }
  return out;
}

function lu_fstring_children(fs: ast.ExprFString, own out: ast.Expr[]): ast.Expr[] {
  let k = 0;
  while (k < fs.exprs.len()) {
    if (fs.is_expr[k]) {
      out = out.append(fs.exprs[k]);
    }
    k += 1;
  }
  return out;
}

function lu_children(e: ast.Expr): ast.Expr[] {
  let out: ast.Expr[] = [];
  match (e) {
    ast.ExprBinary(b) => {
      out = out.append(b.left);
      out = out.append(b.right);
    },
    ast.ExprUnary(u) => {
      out = out.append(u.operand);
    },
    ast.ExprCall(c) => {
      out = out.append(c.callee);
      for a in c.args {
        out = out.append(a);
      }
    },
    ast.ExprArray(a) => {
      for el in a.elements {
        out = out.append(el);
      }
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        out = out.append(el);
      }
    },
    ast.ExprMapLit(ml) => {
      out = lu_map_lit_children(ml, out);
    },
    ast.ExprFString(fs) => {
      out = lu_fstring_children(fs, out);
    },
    ast.ExprIndex(x) => {
      out = out.append(x.array);
      out = out.append(x.index);
    },
    ast.ExprSlice(sl) => {
      out = out.append(sl.array);
      out = out.append(sl.start);
      out = out.append(sl.end);
    },
    ast.ExprStructLit(sl) => {
      if (sl.has_base) {
        out = out.append(sl.base);
      }
      for fv in sl.field_values {
        out = out.append(fv);
      }
    },
    ast.ExprFieldAccess(fa) => {
      out = out.append(fa.obj);
    },
    _ => {}
  }
  return out;
}

function lu_expr(e: ast.Expr, outer: ast.Expr, has_outer: boolean, site: LuSite, fx: LuFn, own acc: string[]): string[] {
  let o = outer;
  let ho = has_outer;
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lm) = c.callee {
      if (lm.origin.len() == 0 || lm.origin == ast.ORIGIN_NESTED_FN || c.args.len() > 0) {
        return acc;
      }
      let sc = LuScope { frames: site.frames, head: lu_plain_frame(lm.body), framed: false, binders: site.binders, bindings: site.bindings, loop_depth: site.loop_depth, in_loop: site.in_loop, in_iife: true, in_defer: site.in_defer };
      return lu_stmts(lm.body, sc, outer, has_outer, fx, acc);
    }
    acc = lu_call(c, e, outer, has_outer, site, fx, acc);
    if (!ho) {
      o = e;
      ho = true;
    }
  }
  for child in lu_children(e) {
    acc = lu_expr(child, o, ho, site, fx, acc);
  }
  return acc;
}

function lu_root(e: ast.Expr, site: LuSite, outer: ast.Expr, has_outer: boolean, fx: LuFn, own acc: string[]): string[] {
  if (has_outer) {
    return lu_expr(e, outer, true, site, fx, acc);
  }
  return lu_expr(e, e, false, site, fx, acc);
}

// An IIFE body and a deferred action count as their enclosing statement, so
// they and the blocks inside them add no frame of their own.
function lu_stmts(stmts: ast.Stmt[], sc: LuScope, outer: ast.Expr, has_outer: boolean, fx: LuFn, own acc: string[]): string[] {
  let i = 0;
  while (i < stmts.len()) {
    let site = LuSite { stmts: stmts, idx: i, frames: lu_site_frames(sc, stmts, i), binders: sc.binders, bindings: sc.bindings, loop_depth: sc.loop_depth, in_loop: sc.in_loop, in_iife: sc.in_iife, in_defer: sc.in_defer };
    match (stmts[i]) {
      ast.StmtVar(v) => {
        acc = lu_root(v.init, site, outer, has_outer, fx, acc);
        if (!sc.framed) {
          sc = LuScope { ...sc, bindings: lu_value_local_lives(stmts[i], site, sc) };
        }
      },
      ast.StmtAssign(a) => {
        acc = lu_root(a.value, site, outer, has_outer, fx, acc);
      },
      ast.StmtReturn(r) => {
        acc = lu_root(r.value, site, outer, has_outer, fx, acc);
      },
      ast.StmtExpr(x) => {
        acc = lu_root(x.value, site, outer, has_outer, fx, acc);
      },
      ast.StmtIf(f) => {
        acc = lu_root(f.cond, site, outer, has_outer, fx, acc);
        acc = lu_stmts(f.then_body, LuScope { ...sc, frames: site.frames, head: lu_plain_frame(f.then_body) }, outer, has_outer, fx, acc);
        acc = lu_stmts(f.else_body, LuScope { ...sc, frames: site.frames, head: lu_plain_frame(f.else_body) }, outer, has_outer, fx, acc);
      },
      ast.StmtWhile(w) => {
        // A while condition repeats with its body. A for iterator does not.
        acc = lu_root(w.cond, LuSite { ...site, loop_depth: sc.loop_depth + 1 }, outer, has_outer, fx, acc);
        acc = lu_stmts(w.body, LuScope { ...sc, frames: site.frames, head: lu_loop_frame(w.body, stmts[i], w.label), loop_depth: sc.loop_depth + 1, in_loop: true }, outer, has_outer, fx, acc);
      },
      ast.StmtFor(fo) => {
        acc = lu_root(fo.iter, site, outer, has_outer, fx, acc);
        let taken = lu_move_site(fx, fo.iter, site, []);
        acc = util.append_all(acc, taken);
        let bound = sc.binders.append(fo.var_name);
        let fresh = lu_bind_lifetimes(sc, site.frames, [fo.var_name], sc.loop_depth + 1, taken.len() > 0 || lu_iter_owned(fx, fo.iter), fo.body, fx);
        acc = lu_stmts(fo.body, LuScope { ...sc, frames: site.frames, head: lu_loop_frame(fo.body, stmts[i], fo.label), binders: bound, bindings: fresh, loop_depth: sc.loop_depth + 1, in_loop: true }, outer, has_outer, fx, acc);
      },
      ast.StmtMatch(m) => {
        acc = lu_root(m.scrutinee, site, outer, has_outer, fx, acc);
        let taken = lu_move_site(fx, m.scrutinee, site, []);
        acc = util.append_all(acc, taken);
        for arm in m.arms {
          if (arm.has_guard) {
            acc = lu_root(arm.guard, site, outer, has_outer, fx, acc);
          }
          let names = astwalk.pattern_binders(arm.pattern, []);
          let bound = util.append_all(sc.binders, names);
          // A match that takes its scrutinee, a fresh value or an own
          // parameter, binds each payload as a fresh local.
          let fresh = lu_bind_lifetimes(sc, site.frames, names, sc.loop_depth, taken.len() > 0 && !lu_scrutinee_is_param(fx, m.scrutinee) || lu_scrutinee_owned(fx, m.scrutinee), arm.body, fx);
          let head = LuFrame { ...lu_plain_frame(arm.body), head: ast.StmtMatch { ...m, arms: [arm] } };
          acc = lu_stmts(arm.body, LuScope { ...sc, frames: site.frames, head: head, binders: bound, bindings: fresh }, outer, has_outer, fx, acc);
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        acc = lu_stmts(one, LuScope { ...sc, frames: site.frames, head: lu_plain_frame(one), framed: false, in_defer: true }, outer, has_outer, fx, acc);
      },
      _ => {}
    }
    i += 1;
  }
  return acc;
}

// The receiver is a parameter to the last-use facts, own when declared so.
function lu_param_names(fn: parser.FuncDecl): string[] {
  let out = ow_param_names(fn);
  if (fn.receiver_name.len() > 0) {
    out = out.append(fn.receiver_name);
  }
  return out;
}

function lu_own_names(fn: parser.FuncDecl): string[] {
  let out = ow_own_param_names(fn);
  if (fn.receiver_name.len() > 0 && fn.receiver_own) {
    out = out.append(fn.receiver_name);
  }
  return out;
}

// Two bindings of one name, as in sibling scopes, get different names, so
// the pass can key each local by its name.
function lu_resolved(fn: parser.FuncDecl): parser.FuncDecl {
  if (!lexical.binds_a_name_twice(fn)) {
    return fn;
  }
  return lexical.resolve_func(fn).func;
}

// `fn` is resolved with lu_resolved.
function lu_last_use_args(fn: parser.FuncDecl, ofuncs: OwnFuncs, borrows: util.NameIndex, lenders: OwnLenders, builtins: util.NameIndex, noret: util.NameIndex): string[] {
  let facts = lu_empty_facts();
  let nested: ast.ExprLambda[] = [];
  for st in fn.body {
    facts = astwalk.fold_stmt_nodes(st, facts, lu_fact_stmt, lu_fact_expr, astwalk.descend_all);
    nested = astwalk.fold_stmt_nodes(st, nested, lu_skip_stmt, lu_lambda, lu_outside_lambda);
  }
  let fx0 = LuFn { facts: facts, params: lu_param_names(fn), owned: lu_own_names(fn), ofuncs: ofuncs, borrows: borrows, lenders: lenders, builtins: builtins, noret: noret, looped: lu_looped_decls(fn.body, false, []), fresh: [], fresh_known: false };
  let fx = LuFn { ...fx0, fresh: lu_fresh_names(fx0), fresh_known: true };
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let top = LuScope { frames: [], head: lu_plain_frame(fn.body), framed: true, binders: [], bindings: [], loop_depth: 0, in_loop: false, in_iife: false, in_defer: false };
  let out = lu_stmts(fn.body, top, none, false, fx, []);
  for lm in nested {
    out = util.append_all(out, lu_last_use_args(lu_resolved(parser.FuncDecl { ...fn, params: lm.params, body: lm.body }), ofuncs, borrows, lenders, builtins, noret));
  }
  return out;
}

function lu_skip_stmt(st: ast.Stmt, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  return acc;
}

// A lambda is decided as a function of its own, so a name it declares can
// move at its last use in the lambda's body.
function lu_lambda(e: ast.Expr, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  if let ast.ExprLambda(lm) = e {
    return acc.append(lm);
  }
  return acc;
}

function lu_outside_lambda(e: ast.Expr): boolean {
  if let ast.ExprLambda(_) = e {
    return false;
  }
  return true;
}

function ow_count_ident_list(list: ast.Expr[], name: string): i32 {
  let n = 0;
  for entry in list {
    n += ow_count_ident(entry, name);
  }
  return n;
}

function ow_count_ident(e: ast.Expr, name: string): i32 {
  function tally(n: ast.Expr, own acc: i32): i32 {
    match (n) {
      ast.ExprIdent(id) => {
        if (id.name == name) {
          return acc + 1;
        }
        return acc;
      },
      _ => {
        return acc;
      }
    }
  }
  return astwalk.fold_expr(e, 0, tally);
}

// `x = f(x)?` moves x as `x = f(x)` does: on the error path the function returns and x is not read again.
function ow_self_move_admits(target: string, value: ast.Expr, ctx: OwnCtx): boolean {
  if let ast.ExprUnary(u) = value {
    if (u.op == "try_") {
      return ow_self_move_admits(target, u.operand, ctx);
    }
  }
  if let ast.ExprCall(c) = value {
    let oc = ow_own_call(c, ctx);
    if (oc.flags.len() == 0 || ow_count_ident_list(oc.args, target) != 1) {
      return false;
    }
    let i = 0;
    while (i < oc.args.len() && i < oc.flags.len()) {
      if let ast.ExprIdent(aid) = oc.args[i] {
        if (aid.name == target) {
          return oc.flags[i];
        }
      }
      i += 1;
    }
  }
  return false;
}

function ow_ident_name(e: ast.Expr): string {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function ow_is_field_read(e: ast.Expr, target: string, field: string): boolean {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      return fa.field == field && ow_ident_name(fa.obj) == target;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function ow_count_field_reads(e: ast.Expr, target: string, field: string): i32 {
  function tally(n: ast.Expr, own acc: i32): i32 {
    match (n) {
      ast.ExprFieldAccess(fa) => {
        if (ow_ident_name(fa.obj) == target && (field.len() == 0 || fa.field == field)) {
          return acc + 1;
        }
        return acc;
      },
      _ => {
        return acc;
      }
    }
  }
  return astwalk.fold_expr(e, 0, tally);
}

struct OwFieldMove { target: string, field: string, ofuncs: OwnFuncs, found: boolean }

// A call in e, outside a lambda, takes target.field as an own argument. The
// call can be at any depth of e.
function ow_moves_field(e: ast.Expr, target: string, field: string, ofuncs: OwnFuncs): boolean {
  return astwalk.fold_expr_pruned(e, OwFieldMove { target: target, field: field, ofuncs: ofuncs, found: false }, ow_field_move_call, astwalk.not_lambda).found;
}

function ow_field_move_call(e: ast.Expr, own m: OwFieldMove): OwFieldMove {
  if (m.found) {
    return m;
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(cid) = c.callee {
      let flags = ow_func_flags(m.ofuncs, cid.name);
      for j in 0..c.args.len() {
        if (j < flags.len() && flags[j] && ow_is_field_read(c.args[j], m.target, m.field)) {
          return OwFieldMove { ...m, found: true };
        }
      }
    }
  }
  return m;
}

function ow_field_move_fields(target: string, value: ast.Expr, ctx: OwnCtx): string[] {
  let out: string[] = [];
  match (value) {
    ast.ExprStructLit(sl) => {
      if (!sl.has_base || ow_ident_name(sl.base) != target) {
        return out;
      }
      if (ow_count_ident(value, target) - ow_count_field_reads(value, target, "") != 1) {
        return out;
      }
      for i in 0..sl.field_values.len() {
        let fname = sl.field_names[i];
        if (ow_count_field_reads(value, target, fname) == 1 && ow_moves_field(sl.field_values[i], target, fname, ctx.ofuncs)) {
          out = out.append(target + "." + fname);
        }
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

struct OwnCall { args: ast.Expr[], flags: boolean[], recv: i32 }

const RECV_NONE: i32 = 0;

const RECV_METHOD: i32 = 1;

const RECV_DYN: i32 = 2;

function ow_own_call(c: ast.ExprCall, ctx: OwnCtx): OwnCall {
  let key = ow_method_key(c, ctx);
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (key.len() > 0) {
      let args: ast.Expr[] = [fa.obj];
      for a in c.args {
        args = args.append(a);
      }
      return OwnCall { args: args, flags: ow_func_flags(ctx.ofuncs, key), recv: ow_recv_kind(key) };
    }
  }
  return OwnCall { args: c.args, flags: ow_call_arg_flags(c.callee, ctx), recv: RECV_NONE };
}

function ow_recv_kind(key: string): i32 {
  if (key.len() >= 4 && slice_unchecked(key, 0, 4) == "dyn ") {
    return RECV_DYN;
  }
  return RECV_METHOD;
}

function ow_guard_call(c: ast.ExprCall, ctx: OwnCtx): util.Diag[] {
  let out: util.Diag[] = [];
  let oc = ow_own_call(c, ctx);
  let i = 0;
  while (i < oc.args.len() && i < oc.flags.len()) {
    if (oc.flags[i] && oc.recv != RECV_DYN && !ow_is_owned_expr(oc.args[i], ctx) && !ow_dies_after_copies(oc.args, i, ctx)) {
      let aline = ast.expr_line(oc.args[i]);
      let acol = ast.expr_col(oc.args[i]);
      if (aline <= 0) {
        aline = c.line;
        acol = c.col;
      }
      out = out.append(dg_at("E051", "argument to owned parameter must be an owned value (a fresh construction, another `own` parameter, or a local at its last use), not a borrowed one", aline, acol));
    }
    i += 1;
  }
  return util.append_diags(out, send_guard_call(c, ctx));
}

// A `send` parameter is a worker boundary: its argument is copied into
// another heap, so the argument's type, and a closure argument's captures
// and result, must be send-safe (E100).
// Which arguments of a call cross a worker boundary, with their names.
function send_call_flags(name: string, ctx: OwnCtx): (boolean[], string[]) {
  if (name == "__send_copy") {
    return ([true], ["value"]);
  }
  let names: string[] = match (ctx.scope.lookup_sig(name)) { Some(sig) => sig.param_names, None => [] };
  return (ow_send_flags(ctx.ofuncs, name), names);
}

function send_guard_call(c: ast.ExprCall, ctx: OwnCtx): util.Diag[] {
  let out: util.Diag[] = [];
  if let ast.ExprIdent(id) = c.callee {
    if (id.builtin || util.has_str(ctx.bound, id.name)) {
      return out;
    }
    let (flags, names) = send_call_flags(id.name, ctx);
    let i = 0;
    while (i < c.args.len() && i < flags.len()) {
      if (flags[i]) {
        let pname: string = if (i < names.len()) { names[i] } else { "" };
        out = util.append_diags(out, send_arg_diags(c.args[i], pname, c, ctx));
      }
      i += 1;
    }
  }
  return out;
}

function send_arg_diags(arg: ast.Expr, pname: string, c: ast.ExprCall, ctx: OwnCtx): util.Diag[] {
  let out: util.Diag[] = [];
  let s = ctx.scope;
  let aline = ast.expr_line(arg);
  let acol = ast.expr_col(arg);
  if (aline <= 0) {
    aline = c.line;
    acol = c.col;
  }
  let at = check_expr(arg, s);
  if let ast.ExprLambda(lm) = arg {
    let seen: string[] = [];
    for name in astwalk.collect_lambda_idents(lm, []) {
      if (s.is_bound(name) && !util.has_str(seen, name)) {
        seen = seen.append(name);
        let ct = s.lookup(name);
        let why = send_unsafe_reason(ct, s, []);
        if (why.len() > 0) {
          out = out.append(dg_at("E100", "closure passed to `send` parameter \"" + pname + "\" captures \"" + name + "\" of type " + type_label(ct) + ", which cannot cross a worker boundary: " + why, aline, acol));
        }
      }
    }
    if let typeinfo.TypeFunc(ft) = at {
      let rwhy = send_unsafe_reason(ft.ret_type, s, []);
      if (rwhy.len() > 0) {
        out = out.append(dg_at("E100", "closure passed to `send` parameter \"" + pname + "\" returns " + type_label(ft.ret_type) + ", which cannot cross a worker boundary: " + rwhy, aline, acol));
      }
    }
    return out;
  }
  let why = send_unsafe_reason(at, s, []);
  if (why.len() > 0) {
    out = out.append(dg_at("E100", "argument to `send` parameter \"" + pname + "\" has type " + type_label(at) + ", which cannot cross a worker boundary: " + why, aline, acol));
  }
  return out;
}

// The reason a value of type t cannot be copied into another worker's heap,
// or "" when every part of it can. A type already in seen is on the path
// above and holds nothing its parent did not refuse. A type parameter
// crosses when its bound names `worker.Send`.
function send_unsafe_reason(t: typeinfo.Type, s: Scope, seen: string[]): string {
  if (is_str_view(t) || is_arr_view(t)) {
    return "a view borrows another value's storage";
  }
  return send_unsafe_nonview_reason(t, s, seen);
}

function send_unsafe_nonview_reason(t: typeinfo.Type, s: Scope, seen: string[]): string {
  match (t) {
    typeinfo.TypeArray(a) => {
      return send_unsafe_reason(a.elem, s, seen);
    },
    typeinfo.TypeTuple(tup) => {
      return send_unsafe_reason_list(tup.elements, s, seen);
    },
    typeinfo.TypeMap(m) => {
      return send_unsafe_reason_list([m.key, m.value], s, seen);
    },
    typeinfo.TypeFunc(_) => {
      return "a function value carries its environment";
    },
    typeinfo.TypeDyn(_) => {
      return "a dyn value hides its concrete type";
    },
    typeinfo.TypeHandle(_) => {
      return "a resource handle is not copied";
    },
    typeinfo.TypeErased(e) => {
      return send_unsafe_erased_reason(e.name, s);
    },
    typeinfo.TypeStruct(st) => {
      return send_unsafe_struct_reason(st, s, seen);
    },
    typeinfo.TypeUnion(u) => {
      return send_unsafe_union_reason(u, s, seen);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function send_unsafe_erased_reason(name: string, s: Scope): string {
  if (tp_bound_send(s, name)) {
    return "";
  }
  return "type parameter " + name + " is not known to be send-safe";
}

function send_unsafe_struct_reason(st: typeinfo.TypeStruct, s: Scope, seen: string[]): string {
  if (st.name == "Cell") {
    return "a Cell is shared by aliasing";
  }
  if (util.has_str(["Reader", "Writer", "Dir", "Socket"], st.name)) {
    return "a built-in handle owns a descriptor";
  }
  if (util.has_str(seen, st.name)) {
    return "";
  }
  let below: string[] = seen.append(st.name);
  let Some(sig) = s.lookup_struct(st.name) else {
    return send_unsafe_reason_list(st.args, s, below);
  };
  if (sig.must_consume) {
    return "a @must_consume value carries an obligation that a copy would double";
  }
  let in_args = send_unsafe_reason_list(st.args, s, below);
  if (in_args.len() > 0) {
    return in_args;
  }
  return send_unsafe_reason_list(send_field_types(sig, st.args, s), s, below);
}

function send_unsafe_union_reason(u: typeinfo.TypeUnion, s: Scope, seen: string[]): string {
  if (util.has_str(seen, u.name)) {
    return "";
  }
  let below: string[] = seen.append(u.name);
  let Some(us) = s.lookup_union(u.name) else {
    return send_unsafe_reason_list(u.args, s, below);
  };
  if (us.must_consume) {
    return "a @must_consume value carries an obligation that a copy would double";
  }
  let in_args = send_unsafe_reason_list(u.args, s, below);
  if (in_args.len() > 0) {
    return in_args;
  }
  for v in us.variants {
    let Some(sig) = variant_shape_sig(s, v, u.name) else {
      continue;
    };
    let why = send_unsafe_reason_list(send_field_types(sig, u.args, s), s, below);
    if (why.len() > 0) {
      return why;
    }
  }
  return "";
}

// The field types of a struct or variant signature with its type
// parameters replaced by the arguments of this instance.
function send_field_types(sig: StructSig, args: typeinfo.Type[], s: Scope): typeinfo.Type[] {
  if (sig.type_params.len() == 0 || sig.type_params.len() != args.len() || sig.field_type_names.len() != sig.field_types.len()) {
    return sig.field_types;
  }
  let out: typeinfo.Type[] = [];
  for name in sig.field_type_names {
    out = out.append(type_from_name_subst(name, sig.type_params, args, s.type_names()));
  }
  return out;
}

// A type parameter crosses the worker boundary when one of its bounds is
// `worker.Send`.
function tp_bound_send(s: Scope, tname: string): boolean {
  for tr in tp_bound_traits(s, tname) {
    if (is_send_trait(s, tr)) {
      return true;
    }
  }
  return false;
}

// Whether the trait spelled tr is `std/worker`'s `Send`: the marker that
// every send-safe type satisfies and that no impl declares.
function is_send_trait(s: Scope, tr: string): boolean {
  let idx: i32 = trait_req_idx(util.base_type_name(tr), s.trait_reqs);
  if (idx < 0) {
    return false;
  }
  let req: parser.TraitReq = s.trait_reqs[idx];
  return req.trait_name == "Send" && req.module == "worker";
}

function send_unsafe_reason_list(ts: typeinfo.Type[], s: Scope, seen: string[]): string {
  for t in ts {
    let why = send_unsafe_reason(t, s, seen);
    if (why.len() > 0) {
      return why;
    }
  }
  return "";
}

function ow_walk_call(c: ast.ExprCall, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  let d = ow_guard_call(c, ctx);
  let oc = ow_own_call(c, ctx);
  let m = moved;
  if (oc.args.len() == c.args.len()) {
    let rc = ru_borrow(c.callee, m, ctx);
    m = rc.moved;
    d = util.append_diags(d, rc.diags);
  }
  let i = 0;
  while (i < oc.args.len()) {
    let ra = ru_borrow(oc.args[i], m, ctx);
    if (i < oc.flags.len() && oc.flags[i]) {
      ra = ow_consume_arg(oc.args[i], m, ctx);
    }
    m = ra.moved;
    d = util.append_diags(d, ra.diags);
    i += 1;
  }
  return OwnWalk { moved: m, diags: d };
}

function ow_consume_arg(a: ast.Expr, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  if let ast.ExprFieldAccess(fa) = a {
    if let ast.ExprIdent(oid) = fa.obj {
      if (!oid.builtin && ow_is_owned(ctx, oid.name) && ow_is_owned_expr(a, ctx)) {
        return ru_consume_field(fa, oid, moved, ctx);
      }
    }
  }
  return ru_expr(a, moved, ctx);
}

function ow_call_arg_flags(callee: ast.Expr, ctx: OwnCtx): boolean[] {
  match (callee) {
    ast.ExprIdent(id) => {
      if (!id.builtin && util.has_str(ctx.bound, id.name)) {
        if let typeinfo.TypeFunc(ft) = check_expr(callee, ctx.scope) {
          return ft.param_own;
        }
        return [];
      }
      if (ow_is_own_func(ctx.ofuncs, id.name)) {
        return ow_func_flags(ctx.ofuncs, id.name);
      }
      return [];
    },
    _ => {
      if let typeinfo.TypeFunc(ft) = check_expr(callee, ctx.scope) {
        return ft.param_own;
      }
      return [];
    }
  }
}

// An update literal reads the fields of its base that it does not replace.
function ru_update_base(s: ast.ExprStructLit, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  if let ast.ExprIdent(id) = s.base {
    let d: util.Diag[] = [];
    if (!id.builtin && ow_is_owned(ctx, id.name)) {
      let kept: MovedEntry[] = [];
      for elem in moved {
        if (!util.has_str(s.field_names, ow_path_field_or_empty(elem.mname, id.name))) {
          kept = kept.append(elem);
        }
      }
      d = ow_bare_use_diags(kept, id);
    }
    return OwnWalk { moved: moved, diags: d };
  }
  return ru_borrow(s.base, moved, ctx);
}

function ow_path_field_or_empty(path: string, name: string): string {
  let head = name + ".";
  if (path.len() > head.len() && slice_unchecked(path, 0, head.len()) == head) {
    return ow_path_field(path, name);
  }
  return "";
}

function ru_borrow(e: ast.Expr, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  match (e) {
    ast.ExprIdent(id) => {
      let d: util.Diag[] = [];
      if (!id.builtin && ow_is_owned(ctx, id.name)) {
        d = ow_bare_use_diags(moved, id);
      }
      return OwnWalk { moved: moved, diags: d };
    },
    _ => {
      return ru_expr(e, moved, ctx);
    }
  }
}

function ru_expr(e: ast.Expr, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  match (e) {
    ast.ExprIdent(id) => {
      let d: util.Diag[] = [];
      let m = moved;
      if (ow_is_owned(ctx, id.name)) {
        d = ow_bare_use_diags(moved, id);
        if (d.len() == 0) {
          d = ow_deferred_use_diags(ctx, id);
        }
        if (d.len() == 0) {
          m = ow_moved_add(moved, id.name, id.line, id.col);
        }
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprFieldAccess(fa) => {
      if let ast.ExprIdent(oid) = fa.obj {
        if (!oid.builtin && ow_is_owned(ctx, oid.name)) {
          let path = oid.name + "." + fa.field;
          if (ow_moved_has(moved, path)) {
            let d: util.Diag[] = [];
            d = d.append(dg_at("E050", "use of owned parameter \"" + oid.name + "\" after its field \"" + fa.field + "\" was consumed (moved at line " + ow_line_text(ow_moved_line(moved, path)) + ")", fa.line, fa.col));
            return OwnWalk { moved: moved, diags: d };
          }
          return ru_field_target(fa.obj, moved, ctx);
        }
      }
      return ru_borrow(fa.obj, moved, ctx);
    },
    ast.ExprIndex(ix) => {
      let r1 = ru_borrow(ix.array, moved, ctx);
      let r2 = ru_expr(ix.index, r1.moved, ctx);
      return OwnWalk { moved: r2.moved, diags: util.append_diags(r1.diags, r2.diags) };
    },
    ast.ExprSlice(sl) => {
      let r1 = ru_borrow(sl.array, moved, ctx);
      let r2 = ru_expr(sl.start, r1.moved, ctx);
      let r3 = ru_expr(sl.end, r2.moved, ctx);
      return OwnWalk { moved: r3.moved, diags: util.append_diags(util.append_diags(r1.diags, r2.diags), r3.diags) };
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() == 0 && c.args.len() == 0) {
            return ow_value_block_walk(lm, moved, ctx);
          }
        },
        _ => {}
      }
      return ow_walk_call(c, moved, ctx);
    },
    ast.ExprBinary(b) => {
      let r1 = ru_borrow(b.left, moved, ctx);
      let r2 = ru_borrow(b.right, r1.moved, ctx);
      return OwnWalk { moved: r2.moved, diags: util.append_diags(r1.diags, r2.diags) };
    },
    ast.ExprUnary(u) => {
      if (u.op == "try_") {
        return ru_expr(u.operand, moved, ctx);
      }
      return ru_borrow(u.operand, moved, ctx);
    },
    ast.ExprArray(a) => {
      let m = moved;
      let d: util.Diag[] = [];
      for element in a.elements {
        let r = ru_expr(element, m, ctx);
        m = r.moved;
        d = util.append_diags(d, r.diags);
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprTuple(t) => {
      let m = moved;
      let d: util.Diag[] = [];
      for element in t.elements {
        let r = ru_expr(element, m, ctx);
        m = r.moved;
        d = util.append_diags(d, r.diags);
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprStructLit(s) => {
      let m = moved;
      let d: util.Diag[] = [];
      if (s.has_base) {
        let rb = ru_update_base(s, m, ctx);
        m = rb.moved;
        d = util.append_diags(d, rb.diags);
      }
      for field_value in s.field_values {
        let r = ru_expr(field_value, m, ctx);
        m = r.moved;
        d = util.append_diags(d, r.diags);
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprLambda(lm) => {
      let lctx = ow_nested_ctx(ctx, lm);
      let inner = ow_stmts(lm.body, ow_nested_moved(moved, lm.params), lctx);
      return OwnWalk { moved: ow_lambda_moved_out(moved, inner.moved, lm.params), diags: inner.diags };
    },
    _ => {
      return OwnWalk { moved: moved, diags: [] };
    }
  }
}

function ow_value_block_walk(lm: ast.ExprLambda, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  let generated = lm.origin == parser.ORIGIN_BLOCK || ow_value_if_origin(lm.origin) || lm.origin == parser.ORIGIN_MATCH_EXPR;
  let returns = cell_new(OwnReturns { synthetic: generated, moved: [] });
  let result = ow_stmts(ow_value_block_stmts(lm), moved, OwnCtx { ...ctx, returns: returns });
  let resumed: MovedEntry[] = [];
  for entry in returns.get().moved {
    if (util.has_str(ctx.owned, entry.mname)) {
      resumed = resumed.append(entry);
    }
  }
  return OwnWalk { ...result, moved: ow_moved_join(result.moved, resumed, false) };
}

function ow_record_return(result: OwnWalk, line: i32, ctx: OwnCtx): OwnWalk {
  let returns = ctx.returns.get();
  // Line zero marks an implicit value result from the parser.
  if (!returns.synthetic || line == 0) {
    ctx.returns.set(OwnReturns { ...returns, moved: ow_moved_join(returns.moved, result.moved, false) });
  }
  return result;
}

function ow_value_block_stmts(lm: ast.ExprLambda): ast.Stmt[] {
  if (lm.origin == parser.ORIGIN_BLOCK) {
    return ow_branch_stmts(lm.body);
  }
  if (lm.origin != parser.ORIGIN_IF_EXPR && lm.origin != parser.ORIGIN_MATCH_EXPR) {
    return lm.body;
  }
  let out: ast.Stmt[] = [];
  for st in lm.body {
    out = out.append(ow_value_arms(st));
  }
  return out;
}

function ow_value_arms(st: ast.Stmt): ast.Stmt {
  match (st) {
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      for arm in m.arms {
        arms = arms.append(ast.MatchArm { ...arm, body: ow_branch_stmts(arm.body) });
      }
      return ast.StmtMatch { ...m, arms: arms };
    },
    ast.StmtIf(f) => {
      let els = ow_branch_stmts(f.else_body);
      if (f.else_body.len() == 1) {
        if let ast.StmtIf(_) = f.else_body[0] {
          els = [ow_value_arms(f.else_body[0])];
        }
      }
      return ast.StmtIf { ...f, then_body: ow_branch_stmts(f.then_body), else_body: els };
    },
    _ => {
      return st;
    }
  }
}

function ow_branch_stmts(body: ast.Stmt[]): ast.Stmt[] {
  if (mx_branch_yields(body)) {
    return body;
  }
  let out: ast.Stmt[] = [];
  let i = 0;
  while (i + 1 < body.len()) {
    out = out.append(body[i]);
    i += 1;
  }
  return out;
}

function ow_loop(body: ast.Stmt[], moved: MovedEntry[], ctx: OwnCtx): util.Diag[] {
  let r = ow_stmts(body, moved, OwnCtx { ...ctx, in_loop: true });
  let out = r.diags;
  for elem in r.moved {
    let nm = elem.mname;
    if (!ow_moved_has(moved, nm)) {
      out = out.append(dg_at("E050", "owned parameter \"" + nm + "\" is consumed inside a loop; a later iteration would use it after move", elem.mline, elem.mcol));
    }
  }
  return out;
}

// A literal based on q that replaces q.f moves q.f into an own parameter in
// the literal. A literal in a local's initializer, an expression statement or
// a returned value, outside a lambda, takes it from an owned q, whose later
// reads the walk refuses. A returned literal can take it from any q that is
// not borrowed.
function ow_superseded_ctx(value: ast.Expr, returned: boolean, ctx: OwnCtx): OwnCtx {
  function admit(e: ast.Expr, own acc: string[]): string[] {
    if let ast.ExprStructLit(sl) = e {
      if (sl.has_base) {
        let base = ow_ident_name(sl.base);
        if (base.len() > 0 && !util.has_str(ctx.borrowed, base) && ow_is_owned(ctx, base)) {
          for f in ow_field_move_fields(base, e, ctx) {
            acc = acc.append(f);
          }
        }
      }
    }
    return acc;
  }
  let fields = astwalk.fold_expr_pruned(value, [], admit, ow_outside_lambda);
  if (returned) {
    if let ast.ExprStructLit(sl) = value {
      let base = ow_ident_name(sl.base);
      if (sl.has_base && base.len() > 0 && !util.has_str(ctx.borrowed, base)) {
        for f in ow_field_move_fields(base, value, ctx) {
          fields = fields.append(f);
        }
      }
    }
  }
  return OwnCtx { ...ctx, admit_fields: fields };
}

function ow_outside_lambda(e: ast.Expr): boolean {
  if let ast.ExprLambda(_) = e {
    return false;
  }
  return true;
}

function ow_stmt(st: ast.Stmt, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  match (st) {
    ast.StmtVar(v) => {
      return ru_expr(v.init, moved, ow_superseded_ctx(v.init, false, ctx));
    },
    ast.StmtReturn(r) => {
      return ow_record_return(ru_expr(r.value, moved, ow_superseded_ctx(r.value, true, ctx)), r.line, ctx);
    },
    ast.StmtExpr(e) => {
      return ru_expr(e.value, moved, ow_superseded_ctx(e.value, false, ctx));
    },
    ast.StmtAssign(a) => {
      let actx = ctx;
      if (!ow_is_owned(ctx, a.target) && ow_self_move_admits(a.target, a.value, ctx)) {
        actx = OwnCtx { ...ctx, admit: a.target };
      }
      if (!util.has_str(ctx.borrowed, a.target)) {
        actx = OwnCtx { ...actx, admit_fields: ow_field_move_fields(a.target, a.value, ctx) };
      }
      let rv = ru_expr(a.value, moved, actx);
      if (ow_is_owned(ctx, a.target)) {
        return OwnWalk { moved: ow_moved_del_prefix(ow_moved_del(rv.moved, a.target), a.target), diags: rv.diags };
      }
      return rv;
    },
    ast.StmtIf(f) => {
      if (f.origin == "block" || f.origin == "unsafe") {
        return ow_stmts(f.then_body, moved, ctx);
      }
      let rc = ru_expr(f.cond, moved, ctx);
      let rt = ow_stmts(f.then_body, rc.moved, ctx);
      let re = ow_stmts(f.else_body, rc.moved, ctx);
      let then_on = !ow_block_diverges(f.then_body, util.has_str(ctx.bound, "exit"), ctx.noret);
      let else_on = f.else_body.len() == 0 || !ow_block_diverges(f.else_body, util.has_str(ctx.bound, "exit"), ctx.noret);
      let m = ow_settle(rc.moved, [rt.moved, re.moved], [then_on, else_on]);
      return OwnWalk { moved: m, diags: util.append_diags(util.append_diags(rc.diags, rt.diags), re.diags) };
    },
    ast.StmtWhile(w) => {
      let rc = ru_expr(w.cond, moved, ctx);
      let ld = ow_loop(w.body, rc.moved, ctx);
      return OwnWalk { moved: rc.moved, diags: util.append_diags(rc.diags, ld) };
    },
    ast.StmtFor(fr) => {
      let takes = !name_has_comma(fr.var_name) && ow_is_owned_scrutinee(fr.iter, ctx) && ow_iter_at_last_use(fr.iter, ctx);
      let ri = ru_borrow(fr.iter, moved, ctx);
      if (takes) {
        ri = ru_expr(fr.iter, moved, ctx);
      }
      let fctx = ow_bind_ctx(ctx, fr.var_name);
      if (!takes && !name_has_comma(fr.var_name)) {
        fctx = OwnCtx { ...fctx, borrowed: fctx.borrowed.append(fr.var_name) };
      }
      let ld = ow_loop(fr.body, ri.moved, OwnCtx { ...fctx, scope: for_body_scope(fr, ctx.scope) });
      return OwnWalk { moved: ri.moved, diags: util.append_diags(ri.diags, ld) };
    },
    ast.StmtMatch(m) => {
      return ow_match_stmt(m, moved, ctx);
    },
    ast.StmtDefer(dd) => {
      let one: ast.Stmt[] = [dd.action];
      if (ctx.in_loop) {
        return ow_stmts(one, moved, ctx);
      }
      // The action runs at the function's exit: a name it consumes is still
      // readable after the statement, and consumed nowhere else.
      let r = ow_stmts(one, moved, ctx);
      let d = r.diags;
      let seen = ctx.deferred.get();
      for elem in r.moved {
        if (!ow_moved_has(moved, elem.mname)) {
          if (ow_moved_has(seen, elem.mname)) {
            d = d.append(dg_at("E050", "owned parameter \"" + elem.mname + "\" is consumed twice: a deferred call at line " + ow_line_text(ow_moved_line(seen, elem.mname)) + " consumes it", elem.mline, 0));
          } else {
            seen = ow_moved_add(seen, elem.mname, elem.mline, elem.mcol);
          }
        }
      }
      ctx.deferred.set(seen);
      return OwnWalk { moved: moved, diags: d };
    },
    _ => {
      return OwnWalk { moved: moved, diags: [] };
    }
  }
}

function ow_stmts(stmts: ast.Stmt[], moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  let m = moved;
  let d: util.Diag[] = [];
  let c = ctx;
  for stmt in stmts {
    let r = ow_stmt(stmt, m, c);
    m = r.moved;
    d = util.append_diags(d, r.diags);
    if let ast.StmtVar(v) = stmt {
      c = ow_bind_ctx(c, v.name);
    }
    c = OwnCtx { ...c, scope: bind_stmt(stmt, c.scope) };
  }
  return OwnWalk { moved: m, diags: d };
}

function ow_match_stmt(m: ast.StmtMatch, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  let scrut_owned = ow_is_owned_scrutinee(m.scrutinee, ctx);
  let rs = ru_expr(m.scrutinee, moved, ctx);
  let whole = check_expr(m.scrutinee, ctx.scope);
  if let ast.ExprIdent(sid) = m.scrutinee {
    let takes = false;
    for arm in m.arms {
      takes = takes || ow_arm_takes_pointer(OwnCtx { ...ctx, scope: annotate_arm_scope(arm, ctx.scope, whole) }, arm.pattern, whole);
    }
    if (!takes) {
      rs = OwnWalk { ...rs, moved: ow_unmove(rs.moved, moved, sid.name) };
    }
  }
  let branches: MovedEntry[][] = [];
  let runs_on: boolean[] = [];
  let d = rs.diags;
  let taken = ow_takes_scrutinee(m.scrutinee, ctx);
  for arm in m.arms {
    let names = astwalk.pattern_binders(arm.pattern, []);
    let actx = ow_arm_bind_ctx(ctx, arm.pattern);
    actx = ow_arm_ctx(OwnCtx { ...actx, scope: annotate_arm_scope(arm, ctx.scope, whole) }, arm.pattern, whole, m.scrutinee, taken, scrut_owned);
    let start = ow_moves_without(rs.moved, names);
    if (names.len() == 0) {
      start = ow_restore_tag(rs.moved, moved, m.scrutinee);
    }
    let ra = ow_stmts(arm.body, start, actx);
    ow_arm_finish_ctx(actx, ctx, names);
    d = util.append_diags(d, ra.diags);
    branches = branches.append(ow_scope_moves(ra.moved, rs.moved, names));
    runs_on = runs_on.append(!ow_block_diverges(arm.body, ow_exit_bound(ctx, arm.pattern), ctx.noret));
  }
  return OwnWalk { moved: ow_settle(rs.moved, branches, runs_on), diags: d };
}

function ow_moved_del(m: MovedEntry[], name: string): MovedEntry[] {
  let out: MovedEntry[] = [];
  for elem in m {
    if (elem.mname != name) {
      out = out.append(elem);
    }
  }
  return out;
}

function ow_param_names(fn: parser.FuncDecl): string[] {
  let out: string[] = [];
  for p in fn.params {
    out = out.append(p.name);
  }
  return out;
}

function ow_own_param_names(fn: parser.FuncDecl): string[] {
  let out: string[] = [];
  for p in fn.params {
    if (p.own) {
      out = out.append(p.name);
    }
  }
  return out;
}

function ow_exit_bound(ctx: OwnCtx, pat: ast.Pattern): boolean {
  return util.has_str(ctx.bound, "exit") || pattern_binds_exit(pat);
}

function ow_arm_bind_ctx(ctx: OwnCtx, pat: ast.Pattern): OwnCtx {
  let names = astwalk.pattern_binders(pat, []);
  if (names.len() == 0) {
    return ctx;
  }
  let c = ctx;
  for name in names {
    c = ow_bind_ctx(c, name);
  }
  let returns = ctx.returns.get();
  return OwnCtx {
    ...c, owned: ow_names_without(ctx.owned, names), borrowed: ow_names_without(ctx.borrowed, names),
    deferred: cell_new(ow_moves_without(ctx.deferred.get(), names)),
    returns: cell_new(OwnReturns { ...returns, moved: ow_moves_without(returns.moved, names) }),
  };
}

function ow_names_without(names: string[], hidden: string[]): string[] {
  let out: string[] = [];
  for name in names {
    if (!util.has_str(hidden, name)) {
      out = out.append(name);
    }
  }
  return out;
}

function ow_binding_path(path: string, names: string[]): boolean {
  for name in names {
    if (path == name || ow_path_field_or_empty(path, name).len() > 0) {
      return true;
    }
  }
  return false;
}

function ow_moves_without(moves: MovedEntry[], names: string[]): MovedEntry[] {
  if (names.len() == 0) {
    return moves;
  }
  let out: MovedEntry[] = [];
  for entry in moves {
    if (!ow_binding_path(entry.mname, names)) {
      out = out.append(entry);
    }
  }
  return out;
}

function ow_scope_moves(after: MovedEntry[], before: MovedEntry[], names: string[]): MovedEntry[] {
  if (names.len() == 0) {
    return after;
  }
  let out = ow_moves_without(after, names);
  for entry in before {
    if (ow_binding_path(entry.mname, names)) {
      out = out.append(entry);
    }
  }
  return out;
}

function ow_arm_finish_ctx(arm: OwnCtx, parent: OwnCtx, names: string[]): void {
  if (names.len() == 0) {
    return;
  }
  parent.deferred.set(ow_scope_moves(arm.deferred.get(), parent.deferred.get(), names));
  let returns = parent.returns.get();
  parent.returns.set(OwnReturns { ...returns, moved: ow_scope_moves(arm.returns.get().moved, returns.moved, names) });
}

function ow_bind_ctx(ctx: OwnCtx, name: string): OwnCtx {
  if (name.len() == 0) {
    return ctx;
  }
  if (util.has_str(ctx.bound, name)) {
    return ctx;
  }
  return OwnCtx { ...ctx, bound: ctx.bound.append(name) };
}

function ow_arm_lent_ctx(ctx: OwnCtx, pat: ast.Pattern): OwnCtx {
  if let ast.PatVariant(pv) = pat {
    let borrowed = ctx.borrowed;
    if (pv.binding.len() > 0 && pv.binding != "_" && !util.has_str(borrowed, pv.binding)) {
      borrowed = borrowed.append(pv.binding);
    }
    for extra in pv.extra_bindings {
      if (extra.len() > 0 && extra != "_" && !util.has_str(borrowed, extra)) {
        borrowed = borrowed.append(extra);
      }
    }
    return OwnCtx { ...ctx, borrowed: borrowed };
  }
  return ctx;
}

// A taken scrutinee gives fresh locals, neither owned nor lent. An owned one
// gives owned bindings and any other gives lent ones. A call result is a
// temporary that the match takes, so a binding of it that can hold no handle
// is a fresh local, as a let local is.
function ow_arm_ctx(actx: OwnCtx, pat: ast.Pattern, whole: typeinfo.Type, scrut: ast.Expr, taken: boolean, scrut_owned: boolean): OwnCtx {
  if (taken) {
    return actx;
  }
  let bound = actx;
  if (scrut_owned) {
    bound = ow_arm_handle_ctx(actx, pat, whole);
  } else {
    bound = ow_arm_lent_ctx(actx, pat);
  }
  if let ast.ExprCall(_) = scrut {
    return OwnCtx { ...bound, owned: ow_handle_binders(bound.owned, actx.owned, bound), borrowed: ow_handle_binders(bound.borrowed, actx.borrowed, bound) };
  }
  return bound;
}

// The names in names that were in before, or that can hold a handle.
function ow_handle_binders(names: string[], before: string[], ctx: OwnCtx): string[] {
  let out: string[] = [];
  for n in names {
    if (util.has_str(before, n) || !ow_holds_no_handle(typeinfo.spelling(ctx.scope.lookup(n)), ctx.decls)) {
      out = out.append(n);
    }
  }
  return out;
}

function ow_unmove(after: MovedEntry[], before: MovedEntry[], name: string): MovedEntry[] {
  let out: MovedEntry[] = [];
  for e in after {
    let kept = e.mname != name;
    for b in before {
      kept = kept || b.mname == e.mname && b.mline == e.mline;
    }
    if (kept) {
      out = out.append(e);
    }
  }
  return out;
}

function ow_arm_takes_pointer(ctx: OwnCtx, pat: ast.Pattern, whole: typeinfo.Type): boolean {
  let bound = ow_arm_payload_ctx(OwnCtx { ...ctx, owned: [] }, pat, whole);
  for n in bound.owned {
    if (n != "_") {
      return true;
    }
  }
  return false;
}

// A payload taken from an owned scrutinee is an owned name that moves once
// when its type can hold a handle. A handle-free payload is a fresh local,
// like any other let: a copy of it keeps both names.
function ow_arm_handle_ctx(ctx: OwnCtx, pat: ast.Pattern, whole: typeinfo.Type): OwnCtx {
  let full = ow_arm_payload_ctx(ctx, pat, whole);
  let names = ctx.owned;
  for n in full.owned {
    if (!util.has_str(names, n) && !ow_holds_no_handle(typeinfo.spelling(ctx.scope.lookup(n)), ctx.decls)) {
      names = names.append(n);
    }
  }
  return OwnCtx { ...ctx, owned: names };
}

function ow_arm_payload_ctx(ctx: OwnCtx, pat: ast.Pattern, whole: typeinfo.Type): OwnCtx {
  if let ast.PatVariant(pv) = pat {
    let vname = ow_last_segment(util.base_type_name(pv.type_name));
    let binds: string[] = [];
    if (pv.binding.len() > 0) {
      binds = binds.append(pv.binding);
    }
    for extra in pv.extra_bindings {
      binds = binds.append(extra);
    }
    if (binds.len() == 0) {
      return ctx;
    }
    let names = ctx.owned;
    let owner = ow_scrutinee_enum(whole, vname, ctx.structs);
    let declared = false;
    for sd in ctx.structs {
      if (sd.name != vname || owner.len() > 0 && sd.enum_owner != owner) {
        continue;
      }
      declared = true;
      if (sd.enum_owner.len() == 0) {
        if (binds[0] != "_" && !util.has_str(names, binds[0])) {
          names = names.append(binds[0]);
        }
      } else {
        let i = 0;
        while (i < binds.len() && i < sd.fields.len()) {
          if (binds[i].len() > 0 && binds[i] != "_" && ow_type_is_pointer(sd.fields[i].type_name, ctx.ofuncs)
            && !util.has_str(names, binds[i])) {
            names = names.append(binds[i]);
          }
          i += 1;
        }
      }
    }
    if (!declared && ow_builtin_payload_variant(vname) && binds[0] != "_" && !util.has_str(names, binds[0])
      && ow_type_is_pointer(typeinfo.spelling(ctx.scope.lookup(binds[0])), ctx.ofuncs)) {
      names = names.append(binds[0]);
    }
    return OwnCtx { ...ctx, owned: names };
  }
  return ctx;
}

function ow_last_segment(name: string): string {
  let dot: i32 = -1;
  for i in 0..name.len() {
    if (name[i] == b'.') {
      dot = i;
    }
  }
  if (dot < 0) {
    return name;
  }
  return slice_unchecked(name, dot + 1, name.len()) + "";
}

// The enum the scrutinee's type names for the arm's variant, which a same-named variant elsewhere must not stand in for.
function ow_scrutinee_enum(whole: typeinfo.Type, vname: string, structs: parser.StructDecl[]): string {
  if let typeinfo.TypeUnion(u) = whole {
    if (parser.builtin_enum_of(vname) == u.name) {
      return u.name;
    }
    for sd in structs {
      if (sd.name == vname && sd.enum_owner == u.name) {
        return u.name;
      }
    }
  }
  return "";
}

// Some, Ok and Err have no struct declaration, so the arm scope gives the payload's type.
function ow_builtin_payload_variant(vname: string): boolean {
  return vname == "Some" || vname == "Ok" || vname == "Err";
}

function collect_own_funcs(mod: parser.Module): OwnFuncs {
  let out: OwnFunc[] = [];
  let names: string[] = [];
  let methods: string[] = [];
  let all_methods: string[] = [];
  let funcs: string[] = [];
  for func in mod.funcs {
    if (func.receiver_name.len() == 0) {
      funcs = funcs.append(func.name);
    } else {
      all_methods = all_methods.append(func.name);
    }
    let any_own = func.receiver_own;
    let flags: boolean[] = [];
    let send: boolean[] = [];
    if (func.receiver_name.len() > 0) {
      flags = flags.append(func.receiver_own);
      send = send.append(false);
    }
    for param in func.params {
      let o = param.own;
      flags = flags.append(o);
      send = send.append(param.send);
      if (o) {
        any_own = true;
      }
    }
    if (any_own && func.receiver_name.len() == 0) {
      out = out.append(OwnFunc { name: func.name, flags: flags, send: send });
      names = names.append(func.name);
    } else if (any_own) {
      let key = ow_receiver_ns(func.receiver_type) + "." + func.name;
      out = out.append(OwnFunc { name: key, flags: flags, send: send });
      names = names.append(key);
      methods = methods.append(func.name);
    }
  }
  // The built-in close consumes its handle: a descriptor closed once is
  // not a value the program reads again.
  for h in ["Reader", "Writer", "Dir"] {
    let key = h + ".close";
    out = out.append(OwnFunc { name: key, flags: [true], send: [] });
    names = names.append(key);
  }
  out = out.append(OwnFunc { name: "tcp_close", flags: [true], send: [] });
  names = names.append("tcp_close");
  methods = methods.append("close");
  for td in mod.trait_decls {
    for m in td.methods {
      if (ow_takes_own_self(m)) {
        let row = ow_trait_row(td.name, m);
        out = out.append(row);
        names = names.append(row.name);
        methods = methods.append(m.name);
      }
    }
  }
  let structs: string[] = [];
  let ctors: string[] = [];
  for sd in mod.structs {
    structs = structs.append(sd.name);
    ctors = ctors.append(sd.name);
    if (sd.enum_owner.len() > 0) {
      structs = structs.append(sd.enum_owner);
    }
  }
  let decls: string[] = [];
  for ed in mod.enums {
    decls = decls.append(ed.name);
  }
  for alias in mod.aliases {
    decls = decls.append(alias.name);
  }
  return OwnFuncs { rows: out, names: util.name_index(names), structs: util.name_index(structs), decls: util.name_index(decls), ctors: util.name_index(ctors), methods: util.name_index(methods), funcs: util.name_index(funcs), all_methods: util.name_index(all_methods) };
}

function ow_takes_own_self(m: parser.FuncDecl): boolean {
  return m.params.len() > 0 && m.params[0].name == "self" && m.params[0].own;
}

function ow_trait_row(tname: string, m: parser.FuncDecl): OwnFunc {
  let flags: boolean[] = [];
  for param in m.params {
    flags = flags.append(param.own);
  }
  return OwnFunc { name: "dyn " + tname + "." + m.name, flags: flags, send: [] };
}

function ow_receiver_ns(rt: string): string {
  if (parser.spelling_is_view(rt)) {
    return "[_]";
  }
  if (array_receiver_matches(rt, false)) {
    return "[]";
  }
  return util.base_type_name(receiver_namespace(rt));
}

function ow_method_key(c: ast.ExprCall, ctx: OwnCtx): string {
  if let ast.ExprFieldAccess(fa) = c.callee {
    for ns in ow_type_namespaces(check_expr(fa.obj, ctx.scope)) {
      let key = ns + "." + fa.field;
      if (ow_is_own_func(ctx.ofuncs, key)) {
        return key;
      }
    }
  }
  return "";
}

function ow_type_namespaces(t: typeinfo.Type): string[] {
  match (t) {
    typeinfo.TypeStruct(st) => {
      return [st.name];
    },
    typeinfo.TypeUnion(u) => {
      return [u.name];
    },
    typeinfo.TypeArray(a) => {
      if (a.view) {
        return ["[_]"];
      }
      return ["[]"];
    },
    typeinfo.TypeString(_) => {
      return ["string"];
    },
    typeinfo.TypeMap(_) => {
      return ["Map"];
    },
    typeinfo.TypeDyn(d) => {
      let out: string[] = [];
      for n in parser.dyn_trait_set("dyn " + d.traits) {
        out = out.append("dyn " + n);
      }
      return out;
    },
    _ => {
      if (!is_unknown(t)) {
        return [ow_receiver_ns(type_label(t))];
      }
      return [];
    }
  }
  let none: string[] = [];
  return none;
}

function ow_type_is_pointer_name(tn: string, ofuncs: OwnFuncs): boolean {
  if (tn.len() == 0 || tn == "void") {
    return false;
  }
  if (tn == "string" || tn == "str" || tn == "fn") {
    return true;
  }
  if (tn[tn.len() - 1] == b']') {
    return true;
  }
  if (tn[0] == b'(') {
    return true;
  }
  if (tn.len() >= 4 && slice_unchecked(tn, 0, 4) == "dyn ") {
    return true;
  }
  let base = util.base_type_name(tn);
  if (parser.is_reserved_struct_name(base) || parser.is_reserved_enum_name(base)) {
    return true;
  }
  return ofuncs.structs.has(base);
}

function ow_type_is_pointer(tn: string, ofuncs: OwnFuncs): boolean {
  if (ow_type_is_pointer_name(tn, ofuncs)) {
    return true;
  }
  return ofuncs.decls.has(util.base_type_name(tn));
}

function ow_collect_stmt(st: ast.Stmt, own acc: ast.Stmt[]): ast.Stmt[] {
  return acc.append(st);
}

function ow_spine_stmts(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for st in body {
    out = astwalk.fold_stmt_spine(st, out, ow_collect_stmt);
  }
  return out;
}

function ow_borrowed_params(fn: parser.FuncDecl, mod: parser.Module, ofuncs: OwnFuncs): string[] {
  let flags = ow_func_flags(ofuncs, fn.name);
  let out: string[] = [];
  let i = 0;
  while (i < fn.params.len()) {
    if (ow_decl_type_is_pointer(fn, fn.params[i].type_name, ofuncs)) {
      if (i >= flags.len() || !flags[i]) {
        out = out.append(fn.params[i].name);
      }
    }
    i += 1;
  }
  return out;
}

// The struct declarations a type name resolves against, and the types with
// a method that consumes its receiver.
// no_handle and handle hold the current declaration classification.
struct OwnDecls { structs: parser.StructDecl[], aliases: parser.TypeAlias[], snames: util.NameIndex, consuming: util.NameIndex, no_handle: util.NameIndex, handle: util.NameIndex }

function ow_decls(mod: parser.Module, snames: util.NameIndex): OwnDecls {
  let names: string[] = [];
  for fn in mod.funcs {
    if (fn.receiver_own) {
      let open = util.index_of_sub(fn.receiver_type, "[");
      if (open > 0) {
        names = names.append(slice_unchecked(fn.receiver_type, 0, open) + "");
      } else {
        names = names.append(fn.receiver_type);
      }
    }
  }
  let decl_names: string[] = [];
  for sd in mod.structs {
    if (sd.enum_owner.len() == 0) {
      decl_names = decl_names.append(sd.name);
    }
  }
  for ed in mod.enums {
    decl_names = decl_names.append(ed.name);
  }
  for al in mod.aliases {
    decl_names = decl_names.append(al.name);
  }
  let no: string[] = [];
  let dx: OwnDecls = OwnDecls { structs: mod.structs, aliases: mod.aliases, snames: snames, consuming: util.name_index(names), no_handle: util.name_index(decl_names), handle: util.name_index(no) };
  return ow_classify_decls(dx, decl_names);
}

function ow_classify_decls(dx: OwnDecls, yes: string[]): OwnDecls {
  let no: string[] = [];
  // Start with every declaration, then remove handle holders until stable.
  // Each field query uses the complete index instead of expanding a shared
  // child again. A recursive component stays handle-free only if all its
  // other fields and arguments stay handle-free.
  while (true) {
    let next: string[] = [];
    for name in yes {
      if (!dx.consuming.has(name) && !util.has_str(semtypes.fd_handle_names(), name) && ow_decl_holds_no_handle(name, dx, [name])) {
        next = next.append(name);
      } else {
        no = no.append(name);
      }
    }
    let stable: boolean = next.len() == yes.len();
    yes = next;
    dx = OwnDecls { ...dx, no_handle: util.name_index(yes), handle: util.name_index(no) };
    if (stable) {
      return dx;
    }
  }
}

// A type that cannot hold a handle: a number, a boolean, a char, a string,
// a function, or an array, option, result, tuple, struct or enum whose parts
// are all such types. Reader, Writer and Dir are handles, and so is a type
// with a method that consumes its receiver. A function cannot consume what
// it captures, so it cannot close a handle.
function ow_holds_no_handle(tn: string, dx: OwnDecls): boolean {
  return ow_no_handle_in(tn, dx, [], []);
}

// The type parameters in free stand for arguments that hold no handle. seen
// holds the declarations on the path, so a recursive type is decided by its
// other parts.
function ow_no_handle_in(tn: string, dx: OwnDecls, free: string[], seen: string[]): boolean {
  let n = tn.len();
  if (tn == "fn" || util.index_of_sub(tn, "=>") >= 0) {
    return true;
  }
  if (n > 2 && tn[n - 2] == b'[' && tn[n - 1] == b']') {
    return ow_no_handle_in(slice_unchecked(tn, 0, n - 2) + "", dx, free, seen);
  }
  if (n > 2 && tn[0] == b'[' && tn[n - 1] == b']') {
    return ow_no_handle_in(slice_unchecked(tn, 1, n - 1) + "", dx, free, seen);
  }
  if (n > 2 && tn[0] == b'(' && tn[n - 1] == b')') {
    return ow_all_no_handle_in(parser.split_top_commas(slice_unchecked(tn, 1, n - 1) + ""), dx, free, seen);
  }
  if (util.has_str(["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "usize", "isize", "f32", "f64", "boolean", "char", "string", "str", "void"], tn) || util.has_str(free, tn)) {
    return true;
  }
  let name = tn;
  let open = util.index_of_sub(tn, "[");
  if (open > 0 && tn[n - 1] == b']') {
    name = slice_unchecked(tn, 0, open) + "";
    if (!ow_all_no_handle_in(parser.split_top_commas(slice_unchecked(tn, open + 1, n - 1) + ""), dx, free, seen)) {
      return false;
    }
  }
  return ow_named_holds_no_handle(name, dx, seen);
}

function ow_named_holds_no_handle(name: string, dx: OwnDecls, seen: string[]): boolean {
  if (name == "Option" || name == "Result" || name == "Cell" || util.has_str(seen, name)) {
    return true;
  }
  if (dx.consuming.has(name) || util.has_str(semtypes.fd_handle_names(), name)) {
    return false;
  }
  if (dx.no_handle.has(name)) {
    return true;
  }
  if (dx.handle.has(name)) {
    return false;
  }
  return ow_decl_holds_no_handle(name, dx, seen.append(name));
}

// A declared struct, or every variant of a declared enum, whose fields hold
// no handle. A name with no declaration can hold one.
function ow_decl_holds_no_handle(name: string, dx: OwnDecls, seen: string[]): boolean {
  let i = dx.snames.chain(name);
  while (i >= 0) {
    let sd = dx.structs[i];
    if (sd.name == name && sd.enum_owner == "") {
      return ow_fields_hold_no_handle(sd, dx, seen);
    }
    i = dx.snames.next[i];
  }
  let found = false;
  for sd in dx.structs {
    if (sd.enum_owner == name) {
      if (!ow_fields_hold_no_handle(sd, dx, seen)) {
        return false;
      }
      found = true;
    }
  }
  if (found) {
    return true;
  }
  // A union `type U = A | B[T]` holds no handle when no member does.
  for al in dx.aliases {
    if (al.name == name && al.variants.len() > 0) {
      return ow_alias_holds_no_handle(al, dx, seen);
    }
  }
  return false;
}

function ow_alias_holds_no_handle(al: parser.TypeAlias, dx: OwnDecls, seen: string[]): boolean {
  for i in 0..al.variants.len() {
    let member = al.variants[i];
    if (i < al.variant_args.len() && al.variant_args[i].len() > 0) {
      member = member + "[" + al.variant_args[i] + "]";
    }
    if (!ow_no_handle_in(member, dx, al.type_params, seen)) {
      return false;
    }
  }
  return true;
}

function ow_fields_hold_no_handle(sd: parser.StructDecl, dx: OwnDecls, seen: string[]): boolean {
  for f in sd.fields {
    if (!ow_no_handle_in(util.trim(f.type_name), dx, sd.type_params, seen)) {
      return false;
    }
  }
  return true;
}

function ow_expr_holds_no_handle(e: ast.Expr, ctx: OwnCtx): boolean {
  return ow_holds_no_handle(typeinfo.spelling(check_expr(e, ctx.scope)), ctx.decls);
}

// The local at argument i dies there, and each argument before it that reads
// one of its fields gives a copy: a scalar.
function ow_dies_after_copies(args: ast.Expr[], i: i32, ctx: OwnCtx): boolean {
  let ast.ExprIdent(id) = args[i] else {
    return false;
  };
  let key = lu_key(id.line, id.col);
  let tagged = util.has_str(ctx.last_use, key + "~") || util.has_str(ctx.last_use, key + "^~") && ow_holds_no_handle(typeinfo.spelling(ctx.scope.lookup(id.name)), ctx.decls);
  if (!tagged || util.has_str(ctx.borrowed, id.name)) {
    return false;
  }
  for j in 0..i {
    if (astwalk.count_ident_expr(args[j], id.name) > 0 && !ow_expr_is_scalar(args[j], ctx)) {
      return false;
    }
  }
  return true;
}

function ow_local_last_use(id: ast.ExprIdent, ctx: OwnCtx): boolean {
  if (util.has_str(ctx.borrowed, id.name)) {
    return false;
  }
  let key = lu_key(id.line, id.col);
  return util.has_str(ctx.last_use, key) || util.has_str(ctx.last_use, key + "^") && ow_holds_no_handle(typeinfo.spelling(ctx.scope.lookup(id.name)), ctx.decls);
}

function ow_all_no_handle_in(ts: string[], dx: OwnDecls, free: string[], seen: string[]): boolean {
  for t in ts {
    if (!ow_no_handle_in(util.trim(t), dx, free, seen)) {
      return false;
    }
  }
  return true;
}

// The functions whose result can borrow and can hold a handle. A local set
// from a call to any other function is fresh.
function ow_handle_borrows(mod: parser.Module, borrows: util.NameIndex, dx: OwnDecls): util.NameIndex {
  let names: string[] = [];
  for fn in mod.funcs {
    if (borrows.has(fn.name) && !ow_holds_no_handle(fn.ret_type, dx)) {
      names = names.append(fn.name);
    }
  }
  return util.name_index(names);
}

// The parameters of each declared function that can lend a handle to its
// result: a borrowed pointer type that can hold a handle. A function the
// module does not declare has no row, and every argument of it can lend.
struct OwnLend { name: string, lend: boolean[] }

struct OwnLenders { rows: OwnLend[], names: util.NameIndex }

function ow_lenders(mod: parser.Module, ofuncs: OwnFuncs, dx: OwnDecls): OwnLenders {
  let rows: OwnLend[] = [];
  let names: string[] = [];
  for fn in mod.funcs {
    if (fn.receiver_name.len() > 0) {
      continue;
    }
    let flags: boolean[] = ow_func_flags(ofuncs, fn.name);
    let lend: boolean[] = [];
    for i in 0..fn.params.len() {
      let tn: string = fn.params[i].type_name;
      lend = lend.append((i >= flags.len() || !flags[i]) && ow_decl_type_is_pointer(fn, tn, ofuncs) && !ow_holds_no_handle(tn, dx));
    }
    rows = rows.append(OwnLend { name: fn.name, lend: lend });
    names = names.append(fn.name);
  }
  return OwnLenders { rows: rows, names: util.name_index(names) };
}

function ow_decl_type_is_pointer(fn: parser.FuncDecl, tn: string, ofuncs: OwnFuncs): boolean {
  return util.has_str(fn.all_type_params, tn) || ow_type_is_pointer(tn, ofuncs);
}

function ow_sig_type_is_pointer(fn: parser.FuncDecl, tn: string, ofuncs: OwnFuncs): boolean {
  return !util.has_str(fn.all_type_params, tn) && ow_type_is_pointer(tn, ofuncs);
}

function ow_elem_type_name(tn: string): string {
  let n = tn.len();
  if (n > 2 && tn[n - 2] == b'[' && tn[n - 1] == b']') {
    return slice_unchecked(tn, 0, n - 2) + "";
  }
  if (n > 2 && tn[0] == b'[' && tn[n - 1] == b']') {
    return slice_unchecked(tn, 1, n - 1) + "";
  }
  return "";
}

function ow_value_elem_params(fn: parser.FuncDecl, borrowed: string[], ofuncs: OwnFuncs): string[] {
  let out: string[] = [];
  for p in fn.params {
    let elem = ow_elem_type_name(p.type_name);
    if (util.has_str(borrowed, p.name) && elem.len() > 0 && !ow_type_is_pointer(elem, ofuncs)) {
      out = out.append(p.name);
    }
  }
  return out;
}

// A variant constructor carries its payload, so its result borrows what the
// payload borrows.
function ow_call_may_borrow(c: ast.ExprCall, ofuncs: OwnFuncs, borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if let ast.ExprIdent(cid) = c.callee {
    if (ofuncs.ctors.has(cid.name)) {
      return true;
    }
    if (builtins.has(cid.name)) {
      return false;
    }
    return borrows.has(cid.name) || !ofuncs.funcs.has(cid.name);
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    // A fresh built-in method, when no method of the module shares its name.
    return !(util.has_str(ow_fresh_builtin_method_names(), fa.field) && !ofuncs.all_methods.has(fa.field));
  }
  return true;
}

function ow_fresh_builtin_method_names(): string[] {
  return ["open_dir", "open_reader", "open_writer", "open_reader_with", "open_writer_with"];
}

function ow_value_block_call(c: ast.ExprCall, lm: ast.ExprLambda): boolean {
  if (c.args.len() > 0 || lm.params.len() > 0) {
    return false;
  }
  return lm.origin == parser.ORIGIN_IF_EXPR || lm.origin == parser.ORIGIN_MATCH_EXPR || lm.origin == parser.ORIGIN_BLOCK;
}

function ow_value_if_origin(origin: string): boolean {
  return origin == parser.ORIGIN_IF_EXPR || origin == parser.ORIGIN_IF_DEAD_THEN || origin == parser.ORIGIN_IF_DEAD_ELSE || origin == parser.ORIGIN_IF_DEAD_BOTH;
}

function ow_value_block_borrows(lm: ast.ExprLambda, ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if (lm.origin != parser.ORIGIN_IF_EXPR || lm.body.len() != 1) {
    return true;
  }
  return ow_value_arm_borrows(lm.body, ofuncs, borrowed, locals, values, borrows, builtins);
}

function ow_value_arm_borrows(arm: ast.Stmt[], ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if (arm.len() != 1) {
    return true;
  }
  match (arm[0]) {
    ast.StmtReturn(r) => {
      return ow_expr_borrows(r.value, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.StmtIf(f) => {
      if (!ow_value_if_origin(f.origin) || f.sugar.origin.len() > 0) {
        return true;
      }
      return ow_value_arm_borrows(f.then_body, ofuncs, borrowed, locals, values, borrows, builtins) || ow_value_arm_borrows(f.else_body, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    _ => {
      return true;
    }
  }
}

function ow_expr_borrows(e: ast.Expr, ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  match (e) {
    ast.ExprBytes(_) => {
      return false;
    },
    ast.ExprNumber(_) => {
      return false;
    },
    ast.ExprString(_) => {
      return false;
    },
    ast.ExprBool(_) => {
      return false;
    },
    ast.ExprFString(_) => {
      return false;
    },
    ast.ExprUnknown(_) => {
      return false;
    },
    ast.ExprZero(_) => {
      return false;
    },
    ast.ExprLambda(_) => {
      return false;
    },
    ast.ExprStructLit(_) => {
      return false;
    },
    ast.ExprArray(_) => {
      return false;
    },
    ast.ExprTuple(_) => {
      return false;
    },
    ast.ExprMapLit(_) => {
      return false;
    },
    ast.ExprBinary(_) => {
      return false;
    },
    ast.ExprUnary(_) => {
      return false;
    },
    ast.ExprIdent(id) => {
      return util.has_str(borrowed, id.name) || util.has_str(locals, id.name);
    },
    ast.ExprFieldAccess(fa) => {
      return ow_expr_borrows(fa.obj, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.ExprIndex(ix) => {
      if let ast.ExprIdent(aid) = ix.array {
        if (util.has_str(values, aid.name)) {
          return false;
        }
      }
      return ow_expr_borrows(ix.array, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.ExprSlice(sl) => {
      return ow_expr_borrows(sl.array, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.ExprCall(c) => {
      return ow_call_borrows(c, ofuncs, borrowed, locals, values, borrows, builtins);
    }
  }
}

function ow_call_borrows(c: ast.ExprCall, ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if let ast.ExprLambda(lm) = c.callee {
    if (ow_value_block_call(c, lm)) {
      return ow_value_block_borrows(lm, ofuncs, borrowed, locals, values, borrows, builtins);
    }
  }
  if (!ow_call_may_borrow(c, ofuncs, borrows, builtins)) {
    return false;
  }
  for a in c.args {
    if (ow_expr_borrows(a, ofuncs, borrowed, locals, values, borrows, builtins)) {
      return true;
    }
  }
  return false;
}

function ow_borrowed_locals(spine: ast.Stmt[], ofuncs: OwnFuncs, borrowed: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): string[] {
  let locals: string[] = [];
  let changed = true;
  while (changed) {
    changed = false;
    for st in spine {
      let name = "";
      let init: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
      if let ast.StmtVar(v) = st {
        name = v.name;
        init = v.init;
      }
      if let ast.StmtAssign(a) = st {
        name = a.target;
        init = a.value;
      }
      // The element a `for` binds borrows from what the loop walks. A range
      // and a pattern bind no such element.
      if let ast.StmtFor(f) = st {
        if (!util.contains(f.var_name, ",") && !for_iter_is_range(f.iter)) {
          name = f.var_name;
          init = f.iter;
        }
      }
      if (name.len() == 0 || util.has_str(locals, name)) {
        continue;
      }
      if (ow_expr_borrows(init, ofuncs, borrowed, locals, values, borrows, builtins)) {
        locals = locals.append(name);
        changed = true;
      }
    }
  }
  return locals;
}

function ow_func_result_borrows(fn: parser.FuncDecl, mod: parser.Module, ofuncs: OwnFuncs, borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  let borrowed = ow_borrowed_params(fn, mod, ofuncs);
  if (borrowed.len() == 0) {
    return false;
  }
  let values = ow_value_elem_params(fn, borrowed, ofuncs);
  let spine = ow_spine_stmts(fn.body);
  let locals = ow_borrowed_locals(spine, ofuncs, borrowed, values, borrows, builtins);
  for st in spine {
    if let ast.StmtReturn(r) = st {
      if (ow_expr_borrows(r.value, ofuncs, borrowed, locals, values, borrows, builtins)) {
        return true;
      }
    }
  }
  return false;
}

function ow_fresh_builtins(): string[] {
  let out: string[] = [
    "__primitive_char_to_string", "__primitive_f32_to_string", "__primitive_f64_to_string", "__primitive_i32_to_string", "__primitive_i64_to_string", "__primitive_u32_to_string", "__primitive_u64_to_string", "__primitive_u8_to_string", "__primitive_usize_to_string",
    "__alloc_bool", "__alloc_i32", "__alloc_i64", "__alloc_u8", "__task_wait", "args", "buf_take", "buf_take_bytes", "cell_new", "clock_set", "environ", "getcwd", "getgroups",
    "hostname", "map_new", "mounts", "pipe", "random_bytes", "set_priority",
    "open_reader", "open_writer", "open_appender", "open_exclusive", "open_reader_with", "open_writer_with", "open_dir",
    "setgid", "setuid",
    "signal_send", "set_extproc", "set_process_group", "set_window_size",
    "stderr", "stdin", "stdout", "target_arch", "target_os",
    "__socket_from_fd", "tcp_accept", "tcp_connect_with", "tcp_listen", "tcp_listen_with",
    "udp_bind", "udp_bind_with", "unix_connect", "unix_listen",
    "termios_get", "uname_field", "window_size",
    "__bytes_owned", "__bytes_range", "__bytes_into", "__aes_expand_key", "__aes_ctr32", "__ghash", "__aes_gcm_seal_into", "__aes_gcm_open_into", "__sha256_hw_blocks", "__sha1_hw_blocks",
  ];
  return out;
}

// The functions whose result is fresh by signature: no borrowed pointer
// parameter that can hold a handle.
function ow_signature_fresh_owners(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex, dx: OwnDecls): string[] {
  let out = builtins.names;
  for fn in mod.funcs {
    if (fn.receiver_name.len() > 0 || !ow_sig_type_is_pointer(fn, fn.ret_type, ofuncs)) {
      continue;
    }
    let flags = ow_func_flags(ofuncs, fn.name);
    let any_ptr = false;
    let all_own = true;
    let i = 0;
    while (i < fn.params.len()) {
      if (ow_sig_type_is_pointer(fn, fn.params[i].type_name, ofuncs)) {
        any_ptr = true;
        if ((i >= flags.len() || !flags[i]) && !ow_holds_no_handle(util.trim(fn.params[i].type_name), dx)) {
          all_own = false;
        }
      }
      i += 1;
    }
    if (!any_ptr || all_own) {
      out = out.append(fn.name);
    }
  }
  return out;
}

function ow_result_borrows(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex): util.NameIndex {
  let none: string[] = [];
  let borrows = util.name_index(none);
  let pending: parser.FuncDecl[] = [];
  let pnames: string[] = [];
  for fn in mod.funcs {
    if (fn.receiver_name.len() > 0) {
      continue;
    }
    if (ow_decl_type_is_pointer(fn, fn.ret_type, ofuncs)) {
      pending = pending.append(fn);
      pnames = pnames.append(fn.name);
    }
  }
  let pindex = util.name_index(pnames);
  let calls: string[][] = [];
  for fn in pending {
    calls = calls.append(ow_calls_to(fn, pindex));
  }
  let first = true;
  let marked = util.name_index(none);
  while (first || marked.names.len() > 0) {
    let now_marked: string[] = [];
    let unmarked: parser.FuncDecl[] = [];
    let unmarked_calls: string[][] = [];
    let i = 0;
    while (i < pending.len()) {
      let fn = pending[i];
      if ((first || ow_calls_any(calls[i], marked)) && ow_func_result_borrows(fn, mod, ofuncs, borrows, builtins)) {
        borrows = borrows.added(fn.name);
        now_marked = now_marked.append(fn.name);
      } else {
        unmarked = unmarked.append(fn);
        unmarked_calls = unmarked_calls.append(calls[i]);
      }
      i += 1;
    }
    first = false;
    marked = util.name_index(now_marked);
    pending = unmarked;
    calls = unmarked_calls;
  }
  return borrows;
}

function ow_calls_to(fn: parser.FuncDecl, names: util.NameIndex): string[] {
  let hits: astwalk.CallSite[] = [];
  for st in fn.body {
    hits = astwalk.collect_calls_stmt(st, names, hits);
  }
  let out: string[] = [];
  for h in hits {
    out = out.append(h.name);
  }
  return out;
}

function ow_calls_any(callees: string[], names: util.NameIndex): boolean {
  for n in callees {
    if (names.has(n)) {
      return true;
    }
  }
  return false;
}

function ow_fresh_owners(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex, borrows: util.NameIndex): string[] {
  let out = builtins.names;
  for fn in mod.funcs {
    if (fn.receiver_name.len() > 0 || !ow_sig_type_is_pointer(fn, fn.ret_type, ofuncs)) {
      continue;
    }
    if (borrows.has(fn.name)) {
      continue;
    }
    out = out.append(fn.name);
  }
  return out;
}

// The receiver namespace and method name identify a fresh method.
function ow_fresh_methods(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex, borrows: util.NameIndex): string[] {
  let out: string[] = [];
  let refused: string[] = [];
  for fn in mod.funcs {
    if (fn.receiver_name.len() == 0 || fn.type_params.len() > 0) {
      continue;
    }
    if (!ow_type_is_pointer(fn.ret_type, ofuncs)) {
      continue;
    }
    let key = ow_receiver_ns(fn.receiver_type) + "." + fn.name;
    if (borrows.has(key)) {
      refused = refused.append(key);
    } else {
      out = out.append(key);
    }
  }
  let kept: string[] = [];
  for name in out {
    if (!util.has_str(refused, name)) {
      kept = kept.append(name);
    }
  }
  return kept;
}

// Use the typed receiver when analysing method results. This temporary
// module is only for the result summaries; the checked program stays intact.
function ow_result_module(mod: parser.Module, env: ModuleEnv, dx: OwnDecls): parser.Module {
  let names: string[] = [];
  for fn in mod.funcs {
    if (fn.receiver_name.len() > 0) {
      names = names.append(ow_receiver_ns(fn.receiver_type) + "." + fn.name);
    }
  }
  let methods = util.name_index(names);
  let mapping = OwnResultMap { methods: methods, decls: dx };
  let funcs: parser.FuncDecl[] = [];
  let ofuncs = collect_own_funcs(mod);
  for raw in mod.funcs {
    let all = raw.all_type_params;
    for tv in func_scope_tparams(raw) {
      if (!util.has_str(all, tv)) {
        all = all.append(tv);
      }
    }
    let fn = parser.FuncDecl { ...raw, all_type_params: all };
    if (ow_decl_type_is_pointer(fn, fn.ret_type, ofuncs) && ow_result_has_methods(fn.body)) {
      fn = annotate_func(fn, env);
      let (body, _) = astwalk.map_stmts_where(fn.body, mapping, ow_result_map_stmt, ow_result_map_expr, ow_result_is_method);
      fn = parser.FuncDecl { ...fn, body: body };
    }
    if (fn.receiver_name.len() > 0) {
      let receiver = ast.ParamDecl { name: fn.receiver_name, type_name: fn.receiver_type, own: fn.receiver_own, send: false, has_default: false, default_value: ast.ExprUnknown { kind: "", line: 0, col: 0 }, fn_ret: "", fn_param_types: "", line: fn.line, col: fn.col };
      let params: ast.ParamDecl[] = [receiver];
      for p in fn.params {
        params = params.append(p);
      }
      fn = parser.FuncDecl { ...fn, name: ow_receiver_ns(fn.receiver_type) + "." + fn.name, receiver_name: "", receiver_type: "", receiver_own: false, params: params };
    }
    funcs = funcs.append(fn);
  }
  return parser.Module { ...mod, funcs: funcs };
}

struct OwnResultMap { methods: util.NameIndex, decls: OwnDecls }

function ow_result_map_stmt(st: ast.Stmt, ctx: OwnResultMap): (ast.Stmt, OwnResultMap, boolean) {
  return (st, ctx, false);
}

function ow_result_is_method(e: ast.Expr): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprFieldAccess(_) = c.callee {
      return true;
    }
  }
  return false;
}

// map_expr_where stops at a replaced node. Map the method's children first,
// so a chain or a method used as an argument keeps every receiver dependency.
function ow_result_map_expr(e: ast.Expr, ctx: OwnResultMap): (ast.Expr, OwnResultMap, boolean) {
  if let ast.ExprCall(c) = e {
    let args: ast.Expr[] = [];
    for a in c.args {
      let (value, _, _) = astwalk.map_expr_where(a, ctx, ow_result_map_stmt, ow_result_map_expr, ow_result_is_method);
      args = args.append(value);
    }
    let (callee, _, _) = astwalk.map_expr_where(c.callee, ctx, ow_result_map_stmt, ow_result_map_expr, ow_result_is_method);
    let mapped: ast.Expr = ast.ExprCall { ...c, callee: callee, args: args };
    return (ow_result_call(mapped, ctx.methods, ctx.decls), ctx, true);
  }
  return (e, ctx, false);
}

function ow_result_method_at(e: ast.Expr, own found: boolean): boolean {
  return found || ow_result_is_method(e);
}

function ow_result_has_methods(body: ast.Stmt[]): boolean {
  for st in body {
    if (astwalk.fold_stmt(st, false, ow_result_method_at)) {
      return true;
    }
  }
  return false;
}

function ow_result_receiver_tag(e: ast.Expr): string {
  if let ast.ExprStructLit(lit) = e {
    return lit.type_name;
  }
  return ast.expr_ty(e);
}

function ow_result_call(e: ast.Expr, methods: util.NameIndex, dx: OwnDecls): ast.Expr {
  if let ast.ExprCall(c) = e {
    if let ast.ExprFieldAccess(fa) = c.callee {
      let tag = ow_result_receiver_tag(fa.obj);
      let key = ow_receiver_ns(tag) + "." + fa.field;
      let cell_handle = tag == "Cell" && fa.field == "get" && !ow_holds_no_handle(c.ty, dx);
      if (tag.len() > 0 && !util.str_has_prefix(tag, "dyn ") && !methods.has(key) && !cell_handle) {
        return e;
      }
      let args: ast.Expr[] = [fa.obj];
      for a in c.args {
        args = args.append(a);
      }
      return ast.ExprCall { ...c, callee: ast.ExprIdent { name: key, line: fa.line, col: fa.col, ty: "", builtin: false }, args: args };
    }
  }
  return e;
}

pub function own_diags(mod: parser.Module, env: ModuleEnv, focus: util.NameIndex): util.Diag[] {
  let ofuncs = collect_own_funcs(mod);
  let builtins = util.name_index(ow_fresh_builtins());
  let snames = util.name_index(ow_struct_names(mod.structs));
  let decls = ow_decls(mod, snames);
  let result_mod = ow_result_module(mod, env, decls);
  let borrows = ow_result_borrows(result_mod, collect_own_funcs(result_mod), builtins);
  let fresh = ow_fresh_owners(mod, ofuncs, builtins, borrows);
  let fresh_methods = ow_fresh_methods(mod, ofuncs, builtins, borrows);
  let noret = lu_no_return_funcs(mod);
  let fresh_scrut = ow_signature_fresh_owners(mod, ofuncs, builtins, decls);
  let handle_borrows = ow_handle_borrows(mod, borrows, decls);
  let lenders = ow_lenders(mod, ofuncs, decls);
  let out: util.Diag[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    let owned: string[] = [];
    let borrowed: string[] = [];
    if (fn.receiver_own && ow_ownable_type(fn.receiver_type)) {
      owned = owned.append(fn.receiver_name);
    }
    for param in fn.params {
      if (param.own && ow_ownable_type(param.type_name)) {
        owned = owned.append(param.name);
      } else {
        borrowed = borrowed.append(param.name);
      }
    }
    let ctx = OwnCtx { owned: owned, borrowed: borrowed, ofuncs: ofuncs, structs: mod.structs, enums: mod.enums, snames: snames, decls: decls, admit: "", admit_fields: [], fresh: fresh, fresh_methods: fresh_methods, fresh_scrut: fresh_scrut, bound: ow_param_names(fn), scope: build_func_scope(fn, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs), last_use: lu_last_use_args(lu_resolved(fn), ofuncs, handle_borrows, lenders, builtins, noret), returns: cell_new(OwnReturns { synthetic: false, moved: [] }), deferred: ow_fresh_deferred(), in_loop: false, noret: noret };
    let nomoved: MovedEntry[] = [];
    let r = ow_stmts(fn.body, nomoved, ctx);
    out = util.append_diags(out, r.diags);
  }
  return out;
}

struct NameTy { nm: string, ty: string }

function e049_append_nt(a: NameTy[], b: NameTy[]): NameTy[] {
  let out = a;
  for elem in b {
    out = out.append(elem);
  }
  return out;
}

function e049_is_ref(tn: string): boolean {
  if (tn.len() == 0) {
    return false;
  }
  if (tn == "i32" || tn == "i64" || tn == "u8" || tn == "u32" || tn == "u64" || tn == "usize" || tn == "boolean" || tn == "f64" || tn == "f32" || tn == "char") {
    return false;
  }
  return true;
}

function e049_ref_capture(enclosing: NameTy[], name: string): boolean {
  for elem in enclosing {
    if (elem.nm == name) {
      return e049_is_ref(elem.ty);
    }
  }
  return false;
}

function e049_capture_label(enclosing: NameTy[], name: string): string {
  for elem in enclosing {
    if (elem.nm == name && elem.ty != "__e049_ref") {
      return util.demangle(elem.ty) + " ";
    }
  }
  return "";
}

function e049_init_ref_ty(init: ast.Expr): string {
  match (init) {
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprArray(_) => {
      return "__e049_ref";
    },
    ast.ExprStructLit(_) => {
      return "__e049_ref";
    },
    ast.ExprTuple(_) => {
      return "__e049_ref";
    },
    _ => {
      return "";
    }
  }
  return "";
}

function e049_scope(stmts: ast.Stmt[]): NameTy[] {
  let out: NameTy[] = [];
  for stmt in stmts {
    for vb in e049_value_blocks(stmt) {
      out = e049_append_nt(out, e049_scope(vb.body));
    }
    match (stmt) {
      ast.StmtVar(v) => {
        let vty = v.type_name;
        if (vty.len() == 0) {
          vty = e049_init_ref_ty(v.init);
        }
        out = out.append(NameTy { nm: v.name, ty: vty });
      },
      ast.StmtIf(f) => {
        out = e049_append_nt(out, e049_scope(f.then_body));
        out = e049_append_nt(out, e049_scope(f.else_body));
      },
      ast.StmtWhile(w) => {
        out = e049_append_nt(out, e049_scope(w.body));
      },
      ast.StmtFor(fr) => {
        out = e049_append_nt(out, e049_scope(fr.body));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = e049_append_nt(out, e049_scope(arm.body));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = e049_append_nt(out, e049_scope(one));
      },
      _ => {}
    }
  }
  return out;
}

function e049_value_blocks(st: ast.Stmt): ast.ExprLambda[] {
  let none: ast.ExprLambda[] = [];
  return astwalk.fold_stmt_own_pruned(st, none, e049_value_block_at, e049_into_no_lambda);
}

function e049_value_block_at(n: ast.Expr, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  if let ast.ExprLambda(lm) = n {
    if (parser.is_value_block_origin(lm.origin)) {
      return acc.append(lm);
    }
  }
  return acc;
}

function e049_into_no_lambda(n: ast.Expr): boolean {
  if let ast.ExprLambda(_) = n {
    return false;
  }
  return true;
}

function e049_lambda_locals_nt(lm: ast.ExprLambda): NameTy[] {
  let out: NameTy[] = [];
  for param in lm.params {
    out = out.append(NameTy { nm: param.name, ty: param.type_name });
  }
  return e049_append_nt(out, e049_scope(lm.body));
}

function e049_nt_names(nts: NameTy[]): string[] {
  let out: string[] = [];
  for elem in nts {
    out = out.append(elem.nm);
  }
  return out;
}

function e049_stmt_own_lambdas(st: ast.Stmt, enclosing: NameTy[], locals: NameTy[]): util.Diag[] {
  let nested_encl = e049_append_nt(enclosing, locals);
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        if (parser.is_value_block_origin(lm.origin)) {
          return util.append_diags(acc, e049_check_assigns(lm.body, enclosing, locals));
        }
        return util.append_diags(acc, e049_check_assigns(lm.body, nested_encl, e049_lambda_locals_nt(lm)));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, not_into_lambda);
}

function e049_check_assigns(stmts: ast.Stmt[], enclosing: NameTy[], locals: NameTy[]): util.Diag[] {
  let out: util.Diag[] = [];
  let local_names = e049_nt_names(locals);
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(a) => {
        if (!util.has_str(local_names, a.target) && e049_ref_capture(enclosing, a.target)) {
          out = out.append(dg_at("E049", "cannot assign to captured " + e049_capture_label(enclosing, a.target) + "\"" + a.target + "\": a reference-typed closure capture is read-only (it could close a reference cycle); return the new value from the closure instead", a.target_line, a.target_col));
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, e049_check_assigns(f.then_body, enclosing, locals));
        out = util.append_diags(out, e049_check_assigns(f.else_body, enclosing, locals));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e049_check_assigns(w.body, enclosing, locals));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e049_check_assigns(fr.body, enclosing, locals));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, e049_check_assigns(arm.body, enclosing, locals));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e049_check_assigns(one, enclosing, locals));
      },
      _ => {}
    }
    out = util.append_diags(out, e049_stmt_own_lambdas(stmt, enclosing, locals));
  }
  return out;
}

function e049_expr_lambdas(e: ast.Expr, enclosing: NameTy[]): util.Diag[] {
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        if (parser.is_value_block_origin(lm.origin)) {
          return util.append_diags(acc, e049_find(lm.body, enclosing));
        }
        return util.append_diags(acc, e049_check_assigns(lm.body, enclosing, e049_lambda_locals_nt(lm)));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_expr_pruned(e, no_diags(), at_lambda, not_into_lambda);
}

function e049_find(stmts: ast.Stmt[], enclosing: NameTy[]): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, e049_expr_lambdas(v.init, enclosing));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, e049_expr_lambdas(r.value, enclosing));
      },
      ast.StmtExpr(e) => {
        out = util.append_diags(out, e049_expr_lambdas(e.value, enclosing));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, e049_expr_lambdas(a.value, enclosing));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, e049_find(f.then_body, enclosing));
        out = util.append_diags(out, e049_find(f.else_body, enclosing));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e049_find(w.body, enclosing));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e049_find(fr.body, enclosing));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, e049_find(arm.body, enclosing));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e049_find(one, enclosing));
      },
      _ => {}
    }
  }
  return out;
}

pub function e049_diags(mod: parser.Module, env: ModuleEnv, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    let encl: NameTy[] = [];
    for param in fn.params {
      encl = encl.append(NameTy { nm: param.name, ty: param.type_name });
    }
    encl = e049_append_nt(encl, e049_scope(fn.body));
    out = util.append_diags(out, e049_find(fn.body, encl));
    out = util.append_diags(out, e049_cell_stores(fn, mod, env));
  }
  return out;
}

function e049_cell_stores(fn: parser.FuncDecl, mod: parser.Module, env: ModuleEnv): util.Diag[] {
  let out = e049_body_stores(fn, mod, env);
  let lams: ast.ExprLambda[] = [];
  for st in fn.body {
    lams = astwalk.fold_stmt_nodes(st, lams, e049_no_stmt_lambdas, e049_lambda_at, e049_into_all);
  }
  for lm in lams {
    out = util.append_diags(out, e049_body_stores(parser.FuncDecl { ...fn, params: lm.params, ret_type: lm.ret_type, body: lm.body }, mod, env));
  }
  return out;
}

function e049_body_stores(fn: parser.FuncDecl, mod: parser.Module, env: ModuleEnv): util.Diag[] {
  let captured: string[] = [];
  for st in fn.body {
    captured = astwalk.fold_stmt_own_pruned(st, captured, e049_lambda_captures, e049_not_into_lambda);
  }
  for st in fn.body {
    captured = e049_nested_stmt_captures(st, captured);
  }
  if (captured.len() == 0) {
    return [];
  }
  let vars = e049_lambda_var_types(fn.body, e049_scope(fn.body));
  let sc = build_func_scope(fn, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  return e049_store_walk(fn.body, sc, vars, captured, fn.type_params, mod, []);
}

function e049_lambda_at(n: ast.Expr, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  if let ast.ExprLambda(lm) = n {
    if (!parser.is_value_block_origin(lm.origin)) {
      return acc.append(lm);
    }
  }
  return acc;
}

function e049_no_stmt_lambdas(st: ast.Stmt, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  return acc;
}

function e049_into_all(n: ast.Expr): boolean {
  return true;
}

function e049_nested_stmt_captures(st: ast.Stmt, acc: string[]): string[] {
  let kids: ast.Stmt[] = [];
  match (st) {
    ast.StmtIf(f) => {
      kids = e049_cat_stmts(f.then_body, f.else_body);
    },
    ast.StmtWhile(w) => {
      kids = w.body;
    },
    ast.StmtFor(fr) => {
      kids = fr.body;
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        kids = e049_cat_stmts(kids, arm.body);
      }
    },
    ast.StmtDefer(d) => {
      kids = [d.action];
    },
    _ => {}
  }
  for k in kids {
    acc = astwalk.fold_stmt_own_pruned(k, acc, e049_lambda_captures, e049_not_into_lambda);
    acc = e049_nested_stmt_captures(k, acc);
  }
  return acc;
}

function e049_lambda_captures(n: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprLambda(lm) = n {
    if (!parser.is_value_block_origin(lm.origin)) {
      return astwalk.collect_lambda_idents(lm, acc);
    }
  }
  return acc;
}

function e049_not_into_lambda(n: ast.Expr): boolean {
  if let ast.ExprLambda(lm) = n {
    return parser.is_value_block_origin(lm.origin);
  }
  return true;
}

function e049_cat_stmts(a: ast.Stmt[], b: ast.Stmt[]): ast.Stmt[] {
  let out = a;
  for st in b {
    out = out.append(st);
  }
  return out;
}

function e049_lambda_var_types(stmts: ast.Stmt[], vars: NameTy[]): NameTy[] {
  let out: NameTy[] = [];
  let lambdas: string[] = [];
  let walked = false;
  for nt in vars {
    let ty = nt.ty;
    if (ty.len() == 0) {
      if (!walked) {
        lambdas = e049_lambda_init_names(stmts);
        walked = true;
      }
      if (util.has_str(lambdas, nt.nm)) {
        ty = "fn";
      }
    }
    out = out.append(NameTy { nm: nt.nm, ty: ty });
  }
  return out;
}

function e049_lambda_init_names(stmts: ast.Stmt[]): string[] {
  function at_var(st: ast.Stmt, own acc: string[]): string[] {
    if let ast.StmtVar(v) = st {
      if let ast.ExprLambda(_) = v.init {
        return acc.append(v.name);
      }
    }
    return acc;
  }
  let out: string[] = [];
  for st in stmts {
    out = astwalk.fold_stmt_spine(st, out, at_var);
  }
  return out;
}

function e049_store_walk(stmts: ast.Stmt[], sc: Scope, vars: NameTy[], captured: string[], tparams: string[], mod: parser.Module, own out: util.Diag[]): util.Diag[] {
  for st in stmts {
    for vb in e049_value_blocks(st) {
      out = e049_store_walk(vb.body, sc, vars, captured, tparams, mod, out);
    }
    match (st) {
      ast.StmtAssign(a) => {
        let ty = e049_var_type(vars, a.target);
        let vty = e049_value_type(a.value, sc, ty);
        if (util.has_str(captured, a.target) && e049_is_ref(ty) && e049_type_reaches_fn(vty, tparams, mod, [])
          && !e049_lambda_cannot_reach(a.value, a.target, vars, tparams, mod)) {
          out = out.append(dg_at("E049", "cannot assign a value of type " + vty + " to captured \"" + a.target + "\": a captured variable is shared by reference, so storing a value that can reach a closure would close a reference cycle the runtime cannot collect; keep the closure in a variable it does not capture", a.target_line, a.target_col));
        }
      },
      ast.StmtIf(f) => {
        out = e049_store_walk(f.then_body, sc, vars, captured, tparams, mod, out);
        out = e049_store_walk(f.else_body, sc, vars, captured, tparams, mod, out);
      },
      ast.StmtWhile(w) => {
        out = e049_store_walk(w.body, sc, vars, captured, tparams, mod, out);
      },
      ast.StmtFor(fr) => {
        out = e049_store_walk(fr.body, sc, vars, captured, tparams, mod, out);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = e049_store_walk(arm.body, sc, vars, captured, tparams, mod, out);
        }
      },
      _ => {}
    }
    sc = bind_stmt(st, sc);
  }
  return out;
}

function e049_value_type(v: ast.Expr, sc: Scope, declared: string): string {
  let vt = check_expr(v, sc);
  if (is_unknown(vt)) {
    return declared;
  }
  let sp = typeinfo.spelling(vt);
  if (sp.len() == 0) {
    return declared;
  }
  return sp;
}

function e049_var_type(vars: NameTy[], name: string): string {
  for nt in vars {
    if (nt.nm == name) {
      return nt.ty;
    }
  }
  return "";
}

function e049_lambda_cannot_reach(v: ast.Expr, target: string, vars: NameTy[], tparams: string[], mod: parser.Module): boolean {
  if let ast.ExprLambda(lm) = v {
    for name in astwalk.collect_lambda_idents(lm, []) {
      if (name == target) {
        return false;
      }
      let ty = e049_var_type(vars, name);
      if (e049_type_reaches_fn(ty, tparams, mod, [])) {
        return false;
      }
    }
    return true;
  }
  return false;
}

function e049_type_reaches_fn(ty: string, tparams: string[], mod: parser.Module, seen: string[]): boolean {
  if (ty.len() == 0) {
    return false;
  }
  if (util.contains(ty, "=>")) {
    return true;
  }
  let start: i32 = -1;
  let i = 0;
  while (i <= ty.len()) {
    let word = i < ty.len() && lexer.is_alphanumeric(ty[i] as i32);
    if (word && start < 0) {
      start = i;
    }
    if (!word && start >= 0) {
      let w = slice_unchecked(ty, start, i) + "";
      start = -1;
      if (w == "fn" || w == "dyn" || util.has_str(tparams, w)) {
        return true;
      }
      if (!util.has_str(seen, w)) {
        seen = seen.append(w);
        for sd in mod.structs {
          if (sd.name == w || sd.enum_owner == w) {
            for fld in sd.fields {
              if (fld.fn_ret.len() > 0 || e049_type_reaches_fn(fld.type_name, tparams, mod, seen)) {
                return true;
              }
            }
          }
        }
      }
    }
    i += 1;
  }
  return false;
}

function e064_unknown_bare(type_name: string, tn: TypeNames): boolean {
  if (type_name.len() == 0) {
    return false;
  }
  if (type_name == "void" || type_name == "Self") {
    return false;
  }
  if (type_name == "u8" || type_name == "usize" || type_name == "str" || type_name == "char") {
    return false;
  }
  if (type_name == "tuple") {
    return false;
  }
  if (type_name == "fn") {
    return true;
  }
  if (parser.is_reserved_struct_name(type_name) || parser.is_reserved_enum_name(type_name)) {
    return false;
  }
  if (parser.looks_type_var(type_name)) {
    return false;
  }
  if (!plain_ident(type_name)) {
    return unresolved_qualifier(type_name, tn);
  }
  return is_unknown(type_from_spelling(type_name, tn));
}

// Flattening mangles every imported qualifier, so a `q.T` that survives it
// names a module this one never imported, unless `q` is an enum or an import
// that was not loaded.
function unresolved_qualifier(type_name: string, tn: TypeNames): boolean {
  for i in 0..type_name.len() {
    if (type_name[i] == b'.') {
      let q = slice_unchecked(type_name, 0, i) + "";
      return plain_ident(q) && !tn.unions.has(q) && !tn.structs.has(q) && !tn.unloaded.has(q);
    }
  }
  return false;
}

function declared_struct_names(structs: parser.StructDecl[]): string[] {
  let out: string[] = [];
  for sd in structs {
    if (sd.enum_owner.len() == 0) {
      out = out.append(sd.name);
    }
  }
  return out;
}

function plain_ident(name: string): boolean {
  for byte in name {
    let ch = byte as i32;
    let alpha = ch >= 65 && ch <= 90 || ch >= 97 && ch <= 122;
    let digit = ch >= 48 && ch <= 57;
    if (!alpha && !digit && ch != 95) {
      return false;
    }
  }
  return name.len() > 0;
}

// unknown_type_diag reports a type spelling that names nothing: E096 for a
// `Vec[N, T]` with no lane type on the portable tier, E064 otherwise.
function unknown_type_diag(name: string, traits: string[], line: i32, col: i32): util.Diag {
  if (util.str_has_prefix(name, "Vec[")) {
    return dg_at("E096", name + " names no lane type: the portable tier has Vec[2, f64] and Vec[4, f32]", line, col);
  }
  return dg_at("E064", "cannot find type \"" + util.demangle(name) + "\" in this scope" + unknown_type_hint(name, traits), line, col);
}

function e064_unknown_name(type_name: string, tn: TypeNames, extra_known: string[], tparams: string[]): string {
  return e064_unknown_name_tref(parser.parse_type_ref(type_name), tn, extra_known, tparams);
}

function e064_decl_spelling(type_name: string, fn_ret: string, fn_params: string): string {
  return parser.fn_tag_spelling(type_name, fn_ret, fn_params);
}

function e064_unknown_name_tref(tr: parser.TypeRef, tn: TypeNames, extra_known: string[], tparams: string[]): string {
  if (tr.array_depth > 0) {
    let elem = parser.elem_type_ref(tr);
    return e064_unknown_name_tref(elem, tn, extra_known, tparams);
  }
  if (tr.is_view) {
    return e064_unknown_name_tref(tr.args[0], tn, extra_known, tparams);
  }
  if (tr.is_tuple || parser.ref_is_fn_value(tr)) {
    return e064_component_unknown(parser.ref_ungroup(tr).args, tn, extra_known, tparams);
  }
  if (builtin_vec(tr, tn)) {
    if (vec_lane_types(tr, tparams).len() == 0) {
      return parser.render_type_ref(tr);
    }
    return e064_component_unknown(tr.args, tn, extra_known, tparams);
  }
  if (tr.args.len() > 0) {
    if (!parser.is_reserved_struct_name(tr.base) && !parser.is_reserved_enum_name(tr.base)) {
      let kx = false;
      for elem in extra_known {
        if (elem == tr.base) {
          kx = true;
        }
      }
      if (!kx && e064_unknown_bare(tr.base, tn)) {
        return tr.base;
      }
    }
    return e064_component_unknown(tr.args, tn, extra_known, tparams);
  }
  if (util.has_str(tparams, tr.base)) {
    return "";
  }
  if (e064_unknown_bare(tr.base, tn)) {
    return tr.base;
  }
  return "";
}

function e064_component_unknown(args: parser.TypeRef[], tn: TypeNames, extra_known: string[], tparams: string[]): string {
  for arg in args {
    if (arg.args.len() == 0 && parser.is_const_arg(arg.base)) {
      continue;
    }
    let u = e064_unknown_name_tref(parser.ref_without_own(arg), tn, extra_known, tparams);
    if (u.len() > 0) {
      return u;
    }
  }
  return "";
}

struct Annot { type_name: string, line: i32, col: i32 }

function collect_annots(stmts: ast.Stmt[]): Annot[] {
  let acc: Annot[] = [];
  for stmt in stmts {
    acc = astwalk.fold_stmt_nodes(stmt, acc, annot_of_stmt, annot_of_expr, astwalk.descend_all);
  }
  return acc;
}

function annot_of_stmt(st: ast.Stmt, own acc: Annot[]): Annot[] {
  match (st) {
    ast.StmtVar(v) => {
      return acc.append(Annot { type_name: e064_decl_spelling(v.type_name, v.fn_ret, v.fn_param_types), line: v.line, col: v.col });
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function lambda_annots(stmts: ast.Stmt[]): Annot[] {
  let acc: Annot[] = [];
  for stmt in stmts {
    acc = astwalk.fold_stmt_nodes(stmt, acc, annot_keep_acc, annot_of_expr, astwalk.descend_all);
  }
  return acc;
}

function annot_keep_acc(st: ast.Stmt, own acc: Annot[]): Annot[] {
  return acc;
}

function annot_of_expr(e: ast.Expr, own acc: Annot[]): Annot[] {
  match (e) {
    ast.ExprLambda(lm) => {
      if (lm.line == 0) {
        return acc;
      }
      for param in lm.params {
        let (pl, pc) = param_pos(param, lm.line, lm.col);
        acc = acc.append(Annot { type_name: e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), line: pl, col: pc });
      }
      return acc.append(Annot { type_name: e064_decl_spelling(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types), line: lm.line, col: lm.col });
    },
    ast.ExprStructLit(sl) => {
      if (sl.written.len() > 0) {
        for a in parser.parse_type_ref(sl.written).args {
          acc = acc.append(Annot { type_name: parser.render_type_ref(a), line: sl.line, col: sl.col });
        }
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function unknown_type_hint(name: string, traits: string[]): string {
  if (util.has_str(traits, name)) {
    return " (`" + util.demangle(name) + "` is a trait: a parameter of trait type makes the function generic over it; anywhere else write `dyn " + util.demangle(name) + "`)";
  }
  if (name == "bool") {
    return " (did you mean `boolean`?)";
  }
  if (name == "int" || name == "long") {
    return " (did you mean `i32`?)";
  }
  if (name == "uint") {
    return " (did you mean `u32`?)";
  }
  if (name == "double") {
    return " (did you mean `f64`?)";
  }
  if (name == "String") {
    return " (did you mean `string`?)";
  }
  return "";
}

function e064_fn_tparams(fd: parser.FuncDecl): string[] {
  let out = fd.all_type_params;
  for tp in func_scope_tparams(fd) {
    if (!util.has_str(out, tp)) {
      out = out.append(tp);
    }
  }
  return out;
}

// const_kind_module_diags checks each written application of a struct, an
// enum or a trait that takes a const parameter. A const parameter takes an integer that
// fits in i32 (E089) or a const parameter in scope, and a type parameter takes
// a type (E090).
function const_kind_module_diags(mod: parser.Module, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  let owners = const_owners(mod);
  if (owners.len() == 0) {
    return out;
  }
  for sd in mod.structs {
    let consts = sd.const_params;
    if (sd.enum_owner.len() > 0) {
      consts = owner_consts(owners, sd.enum_owner);
    }
    for field in sd.fields {
      let (fl, fc) = field_pos(field, sd.line, sd.col);
      out = util.append_diags(out, const_kind_diags(field.type_name, owners, consts, fl, fc));
    }
  }
  for efn in mod.funcs {
    if (in_focus(focus, efn)) {
      let consts = fn_const_names(efn, owners);
      for param in efn.params {
        let (pl, pc) = param_pos(param, efn.line, efn.col);
        out = util.append_diags(out, const_kind_diags(param.type_name, owners, consts, pl, pc));
      }
      out = util.append_diags(out, const_kind_diags(efn.ret_type, owners, consts, efn.line, efn.col));
      for an in collect_annots(efn.body) {
        out = util.append_diags(out, const_kind_diags(an.type_name, owners, consts, an.line, an.col));
      }
      for bound in efn.bound_traits {
        for entry in parser.split_plus_bounds(bound) {
          out = util.append_diags(out, const_kind_diags(entry, owners, consts, efn.line, efn.col));
        }
      }
    }
  }
  for im in mod.impls {
    let consts = owner_arg_names(owners, parser.parse_type_ref(im.impl_type));
    out = util.append_diags(out, const_kind_diags(im.trait_ref, owners, consts, im.line, im.col));
  }
  return out;
}

// ConstOwner is a struct, an enum or a trait that declares a const parameter.
struct ConstOwner { name: string, type_params: string[], const_params: string[] }

function const_owners(mod: parser.Module): ConstOwner[] {
  let out: ConstOwner[] = [];
  for sd in mod.structs {
    if (sd.const_params.len() > 0) {
      out = out.append(ConstOwner { name: sd.name, type_params: sd.type_params, const_params: sd.const_params });
    }
  }
  for ed in mod.enums {
    if (ed.const_params.len() > 0) {
      out = out.append(ConstOwner { name: ed.name, type_params: ed.type_params, const_params: ed.const_params });
    }
  }
  for td in mod.trait_decls {
    if (td.const_params.len() > 0) {
      out = out.append(ConstOwner { name: td.name, type_params: td.type_params, const_params: td.const_params });
    }
  }
  return out;
}

function owner_consts(owners: ConstOwner[], name: string): string[] {
  for o in owners {
    if (o.name == name) {
      return o.const_params;
    }
  }
  return [];
}

// fn_const_names is the const parameters in scope in fd: its own, and those a
// receiver spelling names.
function fn_const_names(fd: parser.FuncDecl, owners: ConstOwner[]): string[] {
  let out = const_tparams(fd);
  if (fd.receiver_type.len() == 0) {
    return out;
  }
  for name in owner_arg_names(owners, parser.parse_type_ref(fd.receiver_type)) {
    out = out.append(name);
  }
  return out;
}

// owner_arg_names is the names r writes at the const parameters of its owner.
function owner_arg_names(owners: ConstOwner[], r: parser.TypeRef): string[] {
  for o in owners {
    if (o.name == r.base) {
      return parser.const_arg_names(r, o.type_params, o.const_params);
    }
  }
  return [];
}

function const_kind_diags(spelling: string, owners: ConstOwner[], consts: string[], line: i32, col: i32): util.Diag[] {
  if (spelling.len() == 0) {
    return [];
  }
  return const_kind_ref_diags(parser.parse_type_ref(spelling), owners, consts, line, col);
}

function const_kind_ref_diags(r: parser.TypeRef, owners: ConstOwner[], consts: string[], line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  for o in owners {
    if (o.name == r.base) {
      for i in 0..r.args.len() {
        if (i >= o.type_params.len()) {
          break;
        }
        let a = r.args[i];
        let tp = o.type_params[i];
        let leaf = a.args.len() == 0 && a.array_depth == 0 && !a.is_tuple;
        let integer = leaf && parser.is_const_arg(a.base);
        if (util.has_str(o.const_params, tp)) {
          if (integer && !parser.const_arg_fits(a.base)) {
            out = out.append(dg_at("E089", "the const argument for " + tp + " must fit in i32", line, col));
          } else if (!integer && !(leaf && util.has_str(consts, a.base))) {
            out = out.append(dg_at("E090", "const parameter " + tp + " takes an integer, not the type " + parser.render_type_ref(a), line, col));
          }
        } else if (integer) {
          out = out.append(dg_at("E090", "type parameter " + tp + " takes a type, not the integer " + a.base, line, col));
        }
      }
    }
  }
  for a in r.args {
    out = util.append_diags(out, const_kind_ref_diags(a, owners, consts, line, col));
  }
  return out;
}

function handle_type_diags(mod: parser.Module, focus: util.NameIndex, tn: TypeNames): util.Diag[] {
  let out: util.Diag[] = [];
  for fd in mod.funcs {
    if (in_focus(focus, fd)) {
      for param in fd.params {
        out = util.append_diags(out, handle_misuse_diags(e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), tn, fd.line, fd.col));
      }
      out = util.append_diags(out, handle_misuse_diags(e064_decl_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types), tn, fd.line, fd.col));
      for an in collect_annots(fd.body) {
        out = util.append_diags(out, handle_misuse_diags(an.type_name, tn, an.line, an.col));
      }
    }
  }
  for sd in mod.structs {
    let (line, col) = struct_decl_pos(mod, sd);
    for field in sd.fields {
      out = util.append_diags(out, handle_misuse_diags(e064_decl_spelling(field.type_name, field.fn_ret, field.fn_param_types), tn, line, col));
    }
  }
  return out;
}

function struct_decl_pos(mod: parser.Module, sd: parser.StructDecl): (i32, i32) {
  if (sd.enum_owner.len() > 0) {
    for ed in mod.enums {
      if (ed.name == sd.enum_owner) {
        return (ed.line, ed.col);
      }
    }
  }
  return (sd.line, sd.col);
}

function handle_misuse_diags(type_name: string, tn: TypeNames, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  for leaf in handle_leaves(parser.parse_type_ref(type_name), []) {
    if (!names_resource_handle(leaf, tn)) {
      out = out.append(dg_at("E021", handle_not_resource_message(leaf), line, col));
    }
  }
  return out;
}

function handle_leaves(tr: parser.TypeRef, own acc: string[]): string[] {
  if (tr.array_depth > 0) {
    return handle_leaves(parser.elem_type_ref(tr), acc);
  }
  if (tr.args.len() == 0 && handle_resource(tr.base) != tr.base) {
    return acc.append(tr.base);
  }
  let slots = 0;
  if (tr.is_fn) {
    slots = tr.args.len() - 1;
  }
  let i = 0;
  while (i < tr.args.len()) {
    if (i < slots) {
      acc = handle_leaves(without_slot_marker(tr.args[i]), acc);
    } else {
      acc = handle_leaves(tr.args[i], acc);
    }
    i += 1;
  }
  return acc;
}

function without_slot_marker(slot: parser.TypeRef): parser.TypeRef {
  if (util.str_has_prefix(slot.base, "own ")) {
    return parser.TypeRef { ...slot, base: slice_unchecked(slot.base, 4, slot.base.len()) + "" };
  }
  return slot;
}

function handle_not_resource_message(leaf: string): string {
  let name = util.demangle(handle_resource(leaf));
  if (util.str_has_prefix(leaf, "borrow ")) {
    return "`" + name + "` is not a resource, so `borrow " + name + "` is not a handle type; a parameter borrows by default, written `name: " + name + "`";
  }
  return "`" + name + "` is not a resource, so `own " + name + "` is not a handle type; a consuming parameter is written `own name: " + name + "`";
}

function e064_annot_diags(an: Annot[], tn: TypeNames, extra_known: string[], tparams: string[], traits: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  for elem in an {
    let vu = e064_unknown_name(elem.type_name, tn, extra_known, tparams);
    if (vu.len() > 0) {
      out = out.append(unknown_type_diag(vu, traits, elem.line, elem.col));
    }
  }
  return out;
}

function cell_payload_risk(t: typeinfo.Type, s: Scope, own: string[], seen: string[]): string {
  match (t) {
    typeinfo.TypeString(st) => {
      if (st.tag == 1) {
        return type_label(t);
      }
    },
    typeinfo.TypeArray(a) => {
      if (a.view) {
        return type_label(t);
      }
      return cell_payload_risk(a.elem, s, own, seen);
    },
    typeinfo.TypeTuple(tt) => {
      return cell_payload_risks(tt.elements, s, own, seen);
    },
    typeinfo.TypeMap(m) => {
      return cell_payload_risks([m.key, m.value], s, own, seen);
    },
    typeinfo.TypeStruct(st) => {
      if (st.name == "Cell") {
        return type_label(t);
      }
      let ar = cell_payload_risks(st.args, s, own, seen);
      if (ar.len() > 0 || util.has_str(seen, st.name)) {
        return ar;
      }
      let Some(sig) = s.lookup_struct(st.name) else {
        return "";
      };
      return cell_payload_risks(sig.field_types, s, sig.type_params, seen.append(st.name));
    },
    typeinfo.TypeUnion(u) => {
      let ar = cell_payload_risks(u.args, s, own, seen);
      let at = s.unions.index.find(u.name);
      if (ar.len() > 0 || at < 0 || util.has_str(seen, u.name)) {
        return ar;
      }
      return union_payload_risk(s.unions.unions[at], s, seen.append(u.name));
    },
    typeinfo.TypeUnknown(u) => {
      let n = TPARAM_MARK.len();
      if (u.reason.len() > n && slice_unchecked(u.reason, 0, n) == TPARAM_MARK) {
        let tp = slice_unchecked(u.reason, n, u.reason.len()) + "";
        if (!util.has_str(own, tp)) {
          return tp;
        }
      }
    },
    typeinfo.TypeErased(e) => {
      if (!util.has_str(own, e.name)) {
        return type_label(t);
      }
    },
    typeinfo.TypeFunc(_) => {
      return type_label(t);
    },
    typeinfo.TypeDyn(_) => {
      return type_label(t);
    },
    typeinfo.TypeHandle(_) => {
      return type_label(t);
    },
    _ => {}
  }
  return "";
}

function cell_payload_risks(ts: typeinfo.Type[], s: Scope, own: string[], seen: string[]): string {
  for t in ts {
    let r = cell_payload_risk(t, s, own, seen);
    if (r.len() > 0) {
      return r;
    }
  }
  return "";
}

function union_payload_risk(u: UnionSig, s: Scope, seen: string[]): string {
  for v in u.variants {
    let r = "";
    if (u.is_enum) {
      if let Some(sig) = s.lookup_owned_struct(v, u.name) {
        r = cell_payload_risks(sig.field_types, s, u.type_params, seen);
      }
    } else {
      r = cell_payload_risk(type_from_spelling(v, s.type_names()), s, u.type_params, seen);
    }
    if (r.len() > 0) {
      return r;
    }
  }
  return "";
}

function e057_diag(label: string, elem: typeinfo.Type, s: Scope, line: i32, col: i32): util.Diag[] {
  let risk = cell_payload_risk(elem, s, [], []);
  if (risk.len() == 0) {
    return [];
  }
  let why = ", and " + label + " contains " + risk;
  if (risk == type_label(named_tparams(elem))) {
    why = ", which " + label + " is not";
  }
  return [dg_at("E057", "Cell[" + label + "] is not allowed: a cell's element must be built from scalars, strings, arrays, tuples, maps, structs and enums" + why, line, col)];
}

function named_tparams(t: typeinfo.Type): typeinfo.Type {
  match (t) {
    typeinfo.TypeUnknown(u) => {
      let n = TPARAM_MARK.len();
      if (u.reason.len() > n && slice_unchecked(u.reason, 0, n) == TPARAM_MARK) {
        return t_struct(slice_unchecked(u.reason, n, u.reason.len()) + "");
      }
    },
    typeinfo.TypeArray(a) => {
      return typeinfo.TypeArray { elem: named_tparams(a.elem), view: a.view };
    },
    typeinfo.TypeTuple(tt) => {
      return t_tuple(named_tparams_all(tt.elements));
    },
    typeinfo.TypeMap(m) => {
      return t_map(named_tparams(m.key), named_tparams(m.value));
    },
    typeinfo.TypeStruct(st) => {
      return t_struct_g(st.name, named_tparams_all(st.args));
    },
    typeinfo.TypeUnion(u) => {
      return t_union_g(u.name, named_tparams_all(u.args));
    },
    _ => {}
  }
  return t;
}

function named_tparams_all(ts: typeinfo.Type[]): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for t in ts {
    out = out.append(named_tparams(t));
  }
  return out;
}

function e057_annot_diags_tref(tr: parser.TypeRef, tparams: string[], s: Scope, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  if (!tr.is_tuple && tr.base == "Cell" && tr.args.len() == 1) {
    let elem = type_from_ref_subst(tr.args[0], tparams, erased_tparams(tparams), s.type_names());
    out = util.append_diags(out, e057_diag(parser.render_type_ref(tr.args[0]), elem, s, line, col));
  }
  for arg in tr.args {
    out = util.append_diags(out, e057_annot_diags_tref(arg, tparams, s, line, col));
  }
  return out;
}

function e057_annot_diags(type_name: string, tparams: string[], s: Scope, line: i32, col: i32): util.Diag[] {
  if (type_name.len() == 0) {
    return [];
  }
  return e057_annot_diags_tref(parser.parse_type_ref(type_name), tparams, s, line, col);
}

function e057_struct_diags(sd: parser.StructDecl, enums: parser.EnumDecl[], s: Scope): util.Diag[] {
  let tps = sd.type_params;
  let line = sd.line;
  let col = sd.col;
  for ed in enums {
    if (sd.enum_owner.len() > 0 && ed.name == sd.enum_owner) {
      tps = ed.type_params;
      line = ed.line;
      col = ed.col;
    }
  }
  let out: util.Diag[] = [];
  for field in sd.fields {
    let (fl, fc) = field_pos(field, line, col);
    out = util.append_diags(out, e057_annot_diags(field.type_name, tps, s, fl, fc));
  }
  return out;
}

// field_pos and param_pos are where a field's or a parameter's own
// diagnostic points: its name, or `line:col` for one the source did not
// spell (a variant's payload, a receiver).
function field_pos(f: parser.StructFieldDecl, line: i32, col: i32): (i32, i32) {
  if (f.line > 0) {
    return (f.line, f.col);
  }
  return (line, col);
}

function param_pos(p: ast.ParamDecl, line: i32, col: i32): (i32, i32) {
  if (p.line > 0) {
    return (p.line, p.col);
  }
  return (line, col);
}

function e057_fn_diags(fd: parser.FuncDecl, s: Scope): util.Diag[] {
  let tps = e064_fn_tparams(fd);
  let out: util.Diag[] = [];
  for param in fd.params {
    let (pl, pc) = param_pos(param, fd.line, fd.col);
    out = util.append_diags(out, e057_annot_diags(param.type_name, tps, s, pl, pc));
  }
  out = util.append_diags(out, e057_annot_diags(fd.ret_type, tps, s, fd.line, fd.col));
  for elem in collect_annots(fd.body) {
    out = util.append_diags(out, e057_annot_diags(elem.type_name, tps, s, elem.line, elem.col));
  }
  return out;
}

struct E044Walk { void_fns: string[] }

function e044_lambda_check(lam: ast.ExprLambda, line: i32, col: i32, wk: E044Walk, suspects: string[], labels: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  if (suspects.len() == 0) {
    return out;
  }
  let free = astwalk.collect_lambda_idents(lam, []);
  let i = 0;
  while (i < suspects.len()) {
    if (util.has_str(free, suspects[i])) {
      out = out.append(dg_at("E044", "captured variable \"" + suspects[i] + "\" has unsupported type " + labels[i], line, col));
    }
    i += 1;
  }
  return out;
}

function e044_without(suspects: string[], labels: string[], bound: string[]): (string[], string[]) {
  let names: string[] = [];
  let types: string[] = [];
  let i = 0;
  while (i < suspects.len()) {
    if (!util.has_str(bound, suspects[i])) {
      names = names.append(suspects[i]);
      types = types.append(labels[i]);
    }
    i += 1;
  }
  return (names, types);
}

function e044_expr(e: ast.Expr, line: i32, col: i32, wk: E044Walk, suspects: string[], labels: string[]): util.Diag[] {
  function visit(node: ast.Expr, own out: util.Diag[]): util.Diag[] {
    if let ast.ExprLambda(lam) = node {
      if (parser.is_written_lambda_origin(lam.origin)) {
        out = util.append_diags(out, e044_lambda_check(lam, line, col, wk, suspects, labels));
      }
      let names = suspects;
      let types = labels;
      if (names.len() > 0 && lam.params.len() > 0) {
        let bound: string[] = [];
        for param in lam.params {
          bound = astwalk.append_bound_name(bound, param.name);
        }
        let (next_names, next_types) = e044_without(names, types, bound);
        names = next_names;
        types = next_types;
      }
      out = util.append_diags(out, e044_stmts(lam.body, wk, names, types));
    }
    return out;
  }
  let out: util.Diag[] = [];
  return astwalk.fold_expr_pruned(e, out, visit, astwalk.not_lambda);
}

function e044_stmts(stmts: ast.Stmt[], wk: E044Walk, suspects0: string[], labels0: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  let suspects = suspects0;
  let labels = labels0;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        let names = suspects;
        let types = labels;
        if (suspects.len() > 0 && ast.var_binds_itself(v) && util.has_str(suspects, v.name)) {
          let (next_names, next_types) = e044_without(suspects, labels, astwalk.append_bound_name([], v.name));
          names = next_names;
          types = next_types;
        }
        out = util.append_diags(out, e044_expr(v.init, v.line, v.col, wk, names, types));
        if (suspects.len() > 0 && (util.has_str(suspects, v.name) || name_has_comma(v.name))) {
          let (next_names, next_types) = e044_without(suspects, labels, astwalk.append_bound_name([], v.name));
          suspects = next_names;
          labels = next_types;
        }
        let is_void_init = false;
        match (v.init) {
          ast.ExprCall(c) => {
            match (c.callee) {
              ast.ExprIdent(id) => {
                for void_fn in wk.void_fns {
                  if (void_fn == id.name) {
                    is_void_init = true;
                  }
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
        if (is_void_init && v.type_name.len() == 0) {
          suspects = suspects.append(v.name);
          labels = labels.append("void");
        }
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, e044_expr(r.value, r.line, r.col, wk, suspects, labels));
      },
      ast.StmtExpr(e) => {
        out = util.append_diags(out, e044_expr(e.value, 0, 0, wk, suspects, labels));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, e044_expr(a.value, a.line, a.col, wk, suspects, labels));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, e044_expr(f.cond, 0, 0, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(f.then_body, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(f.else_body, wk, suspects, labels));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e044_expr(w.cond, 0, 0, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(w.body, wk, suspects, labels));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e044_expr(fr.iter, 0, 0, wk, suspects, labels));
        let names = suspects;
        let types = labels;
        if (names.len() > 0) {
          let (next_names, next_types) = e044_without(names, types, astwalk.append_bound_name([], fr.var_name));
          names = next_names;
          types = next_types;
        }
        out = util.append_diags(out, e044_stmts(fr.body, wk, names, types));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, e044_expr(m.scrutinee, m.line, m.col, wk, suspects, labels));
        for arm in m.arms {
          let names = suspects;
          let types = labels;
          if (names.len() > 0) {
            let (next_names, next_types) = e044_without(names, types, astwalk.pattern_binders(arm.pattern, []));
            names = next_names;
            types = next_types;
          }
          if (arm.has_guard) {
            out = util.append_diags(out, e044_expr(arm.guard, arm.line, arm.col, wk, names, types));
          }
          out = util.append_diags(out, e044_stmts(arm.body, wk, names, types));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e044_stmts(one, wk, suspects, labels));
      },
      _ => {}
    }
  }
  return out;
}

function e044_diags(efn: parser.FuncDecl, void_fns: string[]): util.Diag[] {
  return e044_stmts(efn.body, E044Walk { void_fns: void_fns }, [], []);
}

function e053_root_len(target: string): i32 {
  let i = 0;
  while (i < target.len()) {
    let ch = target[i] as i32;
    if (ch == 91 || ch == 46) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function e053_root_is_own(target: string, rl: i32, own: string[]): boolean {
  for elem in own {
    if (elem.len() == rl) {
      let eq = true;
      let k = 0;
      while (k < rl) {
        if (elem[k] != target[k]) {
          eq = false;
        }
        k += 1;
      }
      if (eq) {
        return true;
      }
    }
  }
  return false;
}

function e053_stringish(e: ast.Expr, cur: Scope): boolean {
  match (e) {
    ast.ExprString(_) => {
      return true;
    },
    _ => {}
  }
  match (check_expr(e, cur)) {
    typeinfo.TypeString(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

struct E053Ctx { fname: string, kw: string, callable: string[], variants: string[], own: string[] }

function fip_recv_root(e: ast.Expr): string {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    ast.ExprIndex(ix) => {
      return fip_recv_root(ix.array);
    },
    ast.ExprFieldAccess(fa) => {
      return fip_recv_root(fa.obj);
    },
    ast.ExprCall(c) => {
      if let ast.ExprFieldAccess(link) = c.callee {
        if (link.field == "with") {
          return fip_recv_root(link.obj);
        }
      }
      return "";
    },
    _ => {
      return "";
    }
  }
  return "";
}

function fip_with_in_place(c: ast.ExprCall, fa: ast.ExprFieldAccess, root_own: boolean, root: string): boolean {
  return root_own && !fip_link_reads_root(c, fa, root);
}

function fip_link_reads_root(c: ast.ExprCall, fa: ast.ExprFieldAccess, root: string): boolean {
  if let ast.ExprCall(inner) = fa.obj {
    if let ast.ExprFieldAccess(link) = inner.callee {
      if (link.field != "with") {
        return false;
      }
      for a in c.args {
        if (astwalk.count_ident_expr(a, root) > 0) {
          return true;
        }
      }
    }
  }
  return false;
}

function e053_at_node(n: ast.Expr, fx: E053Ctx, cur: Scope, own out: util.Diag[]): util.Diag[] {
  match (n) {
    ast.ExprArray(a) => {
      return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not allocate (array literal)", a.line, a.col));
    },
    ast.ExprTuple(_) => {
      return out;
    },
    ast.ExprStructLit(_) => {
      return out;
    },
    ast.ExprBinary(b) => {
      if (b.op == "+" && (e053_stringish(b.left, cur) || e053_stringish(b.right, cur))) {
        return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not allocate (string concatenation)", b.line, b.col));
      }
      return out;
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          let recv_root = fip_recv_root(fa.obj);
          let root_own = false;
          for elem in fx.own {
            if (elem == recv_root) {
              root_own = true;
            }
          }
          if (fa.field == "with" && fip_with_in_place(c, fa, root_own, recv_root)) {
            return out;
          }
          if (fa.field == "map" && root_own) {
            return out;
          }
          if (fa.field == "len") {
            return out;
          }
          return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not call method \"" + fa.field + "\" (not proven allocation-free)", fa.line, fa.col));
        },
        ast.ExprIdent(id) => {
          let is_variant = false;
          for variant in fx.variants {
            if (variant == id.name) {
              is_variant = true;
            }
          }
          if (is_variant) {
            return out;
          }
          let callable = false;
          for elem in fx.callable {
            if (elem == id.name) {
              callable = true;
            }
          }
          if (!callable) {
            let only = "may only call other `fip` functions, not \"";
            if (fx.kw == "fbip") {
              only = "may only call `fip` or `fbip` functions, not \"";
            }
            return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" " + only + id.name + "\"", c.line, c.col));
          }
          return out;
        },
        ast.ExprLambda(_) => {
          if (parser.is_value_block(c)) {
            return out;
          }
          return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not make an indirect call (not proven allocation-free)", c.line, c.col));
        },
        _ => {
          return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not make an indirect call (not proven allocation-free)", c.line, c.col));
        }
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

function e053_own_exprs(stmt: ast.Stmt, fx: E053Ctx, cur: Scope): util.Diag[] {
  function at_node(n: ast.Expr, own out: util.Diag[]): util.Diag[] {
    return e053_at_node(n, fx, cur, out);
  }
  let bounds = range_header_bounds(stmt);
  if (bounds.len() > 0) {
    let out = no_diags();
    for b in bounds {
      out = astwalk.fold_expr_pruned(b, out, at_node, outside_value_block);
    }
    return out;
  }
  return astwalk.fold_stmt_own_pruned(stmt, no_diags(), at_node, outside_value_block);
}

// A range `for` lowers to a counted loop, so its header calls nothing.
function range_header_bounds(stmt: ast.Stmt): ast.Expr[] {
  if let ast.StmtFor(fr) = stmt {
    if let ast.ExprCall(c) = fr.iter {
      if let ast.ExprIdent(id) = c.callee {
        if ((id.name == "__range" || id.name == "__range_incl") && c.args.len() == 2) {
          return c.args;
        }
      }
    }
  }
  return [];
}

function outside_value_block(e: ast.Expr): boolean {
  if let ast.ExprCall(c) = e {
    return !parser.is_value_block(c);
  }
  return true;
}

function value_block_at(e: ast.Expr, own acc: ast.ExprCall[]): ast.ExprCall[] {
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      return acc.append(c);
    }
  }
  return acc;
}

function e053_value_blocks(stmt: ast.Stmt, fx: E053Ctx, cur: Scope): util.Diag[] {
  let out = no_diags();
  let none: ast.ExprCall[] = [];
  let blocks = astwalk.fold_stmt_own_pruned(stmt, none, value_block_at, outside_value_block);
  for vb in blocks {
    out = util.append_diags(out, e053_stmts(parser.vb_body(vb), fx, cur));
  }
  return out;
}

function e053_stmts(stmts: ast.Stmt[], fx: E053Ctx, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let cur = s;
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(a) => {
        let trl = e053_root_len(a.target);
        if (trl >= 0 && !e053_root_is_own(a.target, trl, fx.own)) {
          out = out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not write to a non-`own` heap value (triggers a copy-on-write)", a.line, a.col));
        }
      },
      _ => {}
    }
    out = util.append_diags(out, e053_own_exprs(stmt, fx, cur));
    out = util.append_diags(out, e053_value_blocks(stmt, fx, cur));
    match (stmt) {
      ast.StmtIf(f) => {
        out = util.append_diags(out, e053_stmts(f.then_body, fx, cur));
        out = util.append_diags(out, e053_stmts(f.else_body, fx, cur));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e053_stmts(w.body, fx, cur));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e053_stmts(fr.body, fx, for_body_scope(fr, cur)));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, e053_stmts(arm.body, fx, cur));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e053_stmts(one, fx, cur));
      },
      _ => {}
    }
    cur = bind_stmt(stmt, cur);
  }
  return out;
}

function fip_builtin_callees(funcs: parser.FuncDecl[]): string[] {
  let out: string[] = [];
  for name in [
    "__memchr", "__mismatch_bytes", "__mismatch_bytes_str", "__count_byte_bytes", "__count_below_u64", "__crc32_cksum_array", "__crc32_ieee_array", "__sum_bytes_array", "__bsd_sum_bytes", "__memchr_bytes", "__rmemchr_bytes", "__rmemchr", "__ascii_run", "__count_byte", "__sum_bytes", "__scan_set", "__scan_set_bytes",
    "__bsd_sum", "__str_hash", "__count_runs", "__count_runs_bytes", "__crc32_cksum", "__clz32", "__ctz32", "__popcount32", "__clz64",
    "__ctz64", "__popcount64", "__mulhi_u64", "__ptr_width", "__heap_bump_bytes", "__heap_alloc_count", "monotonic_ns",
    "__f64x2_of", "__f64x2_splat", "__f64x2_lane",
    "__f64x2_lt", "__f64x2_ne", "__f64x2_bitmask", "__f32x4_bitmask",
  ] {
    let declared = false;
    for fd in funcs {
      if (fd.name == name && fd.receiver_type.len() == 0) {
        declared = true;
      }
    }
    if (!declared) {
      out = out.append(name);
    }
  }
  return out;
}

function e053_diags(efn: parser.FuncDecl, fips: string[], fbips: string[], variants: string[], s: Scope): util.Diag[] {
  let own: string[] = [];
  for param in efn.params {
    if (param.own) {
      own = own.append(param.name);
    }
  }
  let kw = "fip";
  let callable = fips;
  if (efn.fbip) {
    kw = "fbip";
    for fbip in fbips {
      callable = callable.append(fbip);
    }
  }
  let fx = E053Ctx { fname: efn.name, kw: kw, callable: callable, variants: variants, own: own };
  return e053_stmts(efn.body, fx, s);
}

pub struct E065Walk { diags: util.Diag[], viewed: string[], owns: boolean }

function e065_ident_in(name: string, xs: string[]): boolean {
  for elem in xs {
    if (elem == name) {
      return true;
    }
  }
  return false;
}

function e065_return_roots(e: ast.Expr, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): ViewRoots {
  match (e) {
    ast.ExprIdent(id) => {
      if (e065_ident_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (e065_ident_in(id.name, sbacked)) {
        let none: string[] = [];
        return ViewRoots { local: true, params: none };
      }
    },
    ast.ExprCall(c) => {
      return e065_call_roots(c, params, sbacked, sums, vix, s);
    },
    _ => {}
  }
  return no_view_roots();
}

function e065_string_src_roots(e: ast.Expr, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): ViewRoots {
  let none: string[] = [];
  match (e) {
    ast.ExprString(_) => {
      return no_view_roots();
    },
    ast.ExprIdent(id) => {
      if (e065_ident_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (e065_ident_in(id.name, sbacked)) {
        return ViewRoots { local: true, params: none };
      }
      return no_view_roots();
    },
    ast.ExprCall(c) => {
      let callee = view_callee(c, s);
      if (callee.key.len() == 0) {
        return ViewRoots { local: true, params: none };
      }
      let out = no_view_roots();
      if (!view_sum_known(sums, vix, callee.key) || view_sum_fresh(sums, vix, callee.key)) {
        out = ViewRoots { local: true, params: out.params };
      }
      let flags = view_sum_flags(sums, vix, callee.key);
      let i = 0;
      while (i < flags.len() && i < callee.args.len()) {
        if (flags[i]) {
          out = merge_view_roots(out, e065_string_src_roots(callee.args[i], params, sbacked, sums, vix, s));
        }
        i += 1;
      }
      return out;
    },
    _ => {}
  }
  return ViewRoots { local: true, params: none };
}

function e065_call_roots(c: ast.ExprCall, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): ViewRoots {
  let direct = "";
  match (c.callee) {
    ast.ExprIdent(cid) => {
      direct = cid.name;
    },
    _ => {}
  }
  if (direct == "slice_unchecked" && c.args.len() == 3) {
    return e065_string_src_roots(c.args[0], params, sbacked, sums, vix, s);
  }
  let out = no_view_roots();
  let callee = view_callee(c, s);
  if (callee.key.len() == 0) {
    return out;
  }
  let flags = view_sum_flags(sums, vix, callee.key);
  let i = 0;
  while (i < flags.len() && i < callee.args.len()) {
    if (flags[i]) {
      out = merge_view_roots(out, e065_return_roots(callee.args[i], params, sbacked, sums, vix, s));
    }
    i += 1;
  }
  return out;
}

function e065_escape_diag(fname: string, line: i32, col: i32): util.Diag {
  return dg_at("E065", "returning a `str` view of a function-local string: the backing string is reclaimed when \"" + fname + "\" returns, leaving a dangling view — return an owned `string` (materialise with .to_owned()) or view a parameter instead", line, col);
}

// The roots of every `str` view an aggregate of type `to` carries.
function e065_agg_roots(e: ast.Expr, to: typeinfo.Type, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): ViewRoots {
  if (is_str_view(to)) {
    return e065_return_roots(e, params, sbacked, sums, vix, s);
  }
  if (is_type_variable(to)) {
    return param_roots_only(e065_return_roots(e, params, sbacked, sums, vix, s));
  }
  if (!holds_view_aggregate(to, s)) {
    return no_view_roots();
  }
  if let ast.ExprIdent(id) = e {
    return e065_return_roots(e, params, sbacked, sums, vix, s);
  }
  if let ast.ExprCall(c) = e {
    if (!is_view_ctor(e, to, s)) {
      return e065_agg_call_roots(c, params, sbacked, sums, vix, s);
    }
  }
  let out = no_view_roots();
  for p in view_parts(e, to, s) {
    out = merge_view_roots(out, e065_agg_roots(p.value, p.to, params, sbacked, sums, vix, s));
  }
  return out;
}

function e065_agg_call_roots(c: ast.ExprCall, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): ViewRoots {
  let out = no_view_roots();
  let callee = view_callee(c, s);
  let flags = view_sum_flags(sums, vix, callee.key);
  for i in 0..flags.len() {
    if (flags[i] && i < callee.args.len()) {
      let at = check_expr(callee.args[i], s);
      if (holds_view_aggregate(at, s)) {
        out = merge_view_roots(out, e065_agg_roots(callee.args[i], at, params, sbacked, sums, vix, s));
      } else {
        out = merge_view_roots(out, e065_return_roots(callee.args[i], params, sbacked, sums, vix, s));
      }
    }
  }
  return out;
}

// A view-returning function already reports its escape through e065_return_roots.
function e065_agg_diags(ret_is_view: boolean, roots: ViewRoots, fname: string, line: i32, col: i32): util.Diag[] {
  if (!ret_is_view && roots.local) {
    return [e065_escape_diag(fname, line, col)];
  }
  return [];
}

function e065_agg_taint(v: ast.StmtVar, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): string[] {
  let vty = bound_type(v, s);
  if (holds_view_aggregate(vty, s) && e065_agg_roots(v.init, vty, params, sbacked, sums, vix, s).local) {
    return sbacked.append(v.name);
  }
  return sbacked;
}

function e065_view_source_name(e: ast.Expr): string {
  match (e) {
    ast.ExprSlice(sl) => {
      match (sl.array) {
        ast.ExprIdent(sid) => {
          return sid.name;
        },
        _ => {}
      }
    },
    ast.ExprCall(c) => {
      let callee_name = "";
      match (c.callee) {
        ast.ExprIdent(cid) => {
          callee_name = cid.name;
        },
        _ => {}
      }
      if (callee_name == "slice_unchecked" && c.args.len() == 3) {
        match (c.args[0]) {
          ast.ExprIdent(sid) => {
            return sid.name;
          },
          _ => {}
        }
      }
    },
    ast.ExprIdent(id) => {
      return id.name;
    },
    _ => {}
  }
  return "";
}

function e065_with_arm_bindings(sbacked: string[], arms: ast.MatchArm[]): string[] {
  let out = sbacked;
  for arm in arms {
    match (arm.pattern) {
      ast.PatVariant(pv) => {
        if (pv.binding.len() > 0) {
          out = out.append(pv.binding);
        }
        for extra in pv.extra_bindings {
          if (extra.len() > 0) {
            out = out.append(extra);
          }
        }
      },
      _ => {}
    }
  }
  return out;
}

function e065_stmts(stmts: ast.Stmt[], fname: string, params: string[], str_ret_names: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope, ret_is_view: boolean): E065Walk {
  let out: util.Diag[] = [];
  let viewed: string[] = [];
  let owns = false;
  let cur = s;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.type_name == "str") {
          match (v.init) {
            ast.ExprIdent(id) => {
              if (!e065_ident_in(id.name, params) && e065_ident_in(id.name, sbacked)) {
                sbacked = sbacked.append(v.name);
              }
            },
            ast.ExprCall(sc) => {
              if (e065_call_roots(sc, params, sbacked, sums, vix, cur).local) {
                sbacked = sbacked.append(v.name);
              }
            },
            _ => {}
          }
        } else if (v.type_name == "string") {
          sbacked = sbacked.append(v.name);
        } else if (v.type_name.len() == 0) {
          match (v.init) {
            ast.ExprString(_) => {
              sbacked = sbacked.append(v.name);
            },
            ast.ExprIdent(id) => {
              if (e065_ident_in(id.name, sbacked)) {
                sbacked = sbacked.append(v.name);
              }
            },
            ast.ExprSlice(osl) => {
              match (osl.array) {
                ast.ExprIdent(osid) => {
                  if (!e065_ident_in(osid.name, params) && e065_ident_in(osid.name, sbacked)) {
                    sbacked = sbacked.append(v.name);
                  }
                },
                _ => {}
              }
            },
            ast.ExprCall(c) => {
              if (e065_call_roots(c, params, sbacked, sums, vix, cur).local) {
                sbacked = sbacked.append(v.name);
              }
              let callee_name = "";
              match (c.callee) {
                ast.ExprIdent(cid) => {
                  callee_name = cid.name;
                },
                ast.ExprFieldAccess(cfa) => {
                  callee_name = cfa.field;
                },
                _ => {}
              }
              if (!e065_ident_in(callee_name, str_ret_names)) {
                match (check_expr(v.init, cur)) {
                  typeinfo.TypeString(_) => {
                    sbacked = sbacked.append(v.name);
                  },
                  _ => {}
                }
              }
            },
            _ => {}
          }
        }
        sbacked = e065_agg_taint(v, params, sbacked, sums, vix, cur);
      },
      ast.StmtReturn(r) => {
        if (!ret_is_view) {
          let sroots = e065_string_src_roots(r.value, params, sbacked, sums, vix, cur);
          viewed = merge_view_names(viewed, sroots.params);
          if (sroots.local) {
            owns = true;
          }
        }
        let roots = e065_return_roots(r.value, params, sbacked, sums, vix, cur);
        viewed = merge_view_names(viewed, roots.params);
        if (ret_is_view && roots.local) {
          out = out.append(e065_escape_diag(fname, r.line, r.col));
        }
        let aroots = e065_agg_roots(r.value, cur.ret_type, params, sbacked, sums, vix, cur);
        viewed = merge_view_names(viewed, aroots.params);
        out = util.append_diags(out, e065_agg_diags(ret_is_view, aroots, fname, r.line, r.col));
      },
      ast.StmtIf(f) => {
        let wt = e065_stmts(f.then_body, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, wt.diags);
        viewed = merge_view_names(viewed, wt.viewed);
        owns = owns || wt.owns;
        let we = e065_stmts(f.else_body, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, we.diags);
        viewed = merge_view_names(viewed, we.viewed);
        owns = owns || we.owns;
      },
      ast.StmtWhile(w) => {
        let ww = e065_stmts(w.body, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, ww.diags);
        viewed = merge_view_names(viewed, ww.viewed);
        owns = owns || ww.owns;
      },
      ast.StmtFor(fr) => {
        let wf = e065_stmts(fr.body, fname, params, str_ret_names, sbacked, sums, vix, for_body_scope(fr, cur), ret_is_view);
        out = util.append_diags(out, wf.diags);
        viewed = merge_view_names(viewed, wf.viewed);
        owns = owns || wf.owns;
      },
      ast.StmtMatch(m) => {
        let arm_sb = sbacked;
        let msrc = e065_view_source_name(m.scrutinee);
        if (msrc.len() > 0 && !e065_ident_in(msrc, params) && e065_ident_in(msrc, sbacked)) {
          arm_sb = e065_with_arm_bindings(arm_sb, m.arms);
        }
        for arm in m.arms {
          let wa = e065_stmts(arm.body, fname, params, str_ret_names, arm_sb, sums, vix, cur, ret_is_view);
          out = util.append_diags(out, wa.diags);
          viewed = merge_view_names(viewed, wa.viewed);
          owns = owns || wa.owns;
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        let wd = e065_stmts(one, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, wd.diags);
        viewed = merge_view_names(viewed, wd.viewed);
        owns = owns || wd.owns;
      },
      _ => {}
    }
    cur = bind_stmt(stmt, cur);
  }
  return E065Walk { diags: out, viewed: viewed, owns: owns };
}

function e065_diags(efn: parser.FuncDecl, str_ret_names: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): E065Walk {
  let params = view_positions(efn);
  let none: string[] = [];
  return e065_stmts(efn.body, efn.name, params, str_ret_names, none, sums, vix, s, efn.ret_type == "str");
}

function e032_call_check(c: ast.ExprCall, cur: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.args.len() == 0) {
    return out;
  }
  let infer = false;
  let line = c.line;
  let col = c.col;
  match (c.args[c.args.len() - 1]) {
    ast.ExprLambda(lm) => {
      if (lm.use_infer && lm.params.len() > 0 && lm.params[0].type_name.len() == 0) {
        infer = true;
        line = lm.line;
        col = lm.col;
      }
    },
    _ => {}
  }
  if (!infer) {
    return out;
  }
  let callee_name = "";
  match (c.callee) {
    ast.ExprIdent(id) => {
      callee_name = id.name;
    },
    _ => {
      out = out.append(dg_at("E032", "use: cannot infer binding type for non-identifier source — add an explicit `: TYPE` annotation", line, col));
      return out;
    }
  }
  if let Some(sig) = cur.lookup_sig(callee_name) {
    if (sig.param_types.len() == 0) {
      out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", line, col));
      return out;
    }
    let last = sig.param_types.len() - 1;
    let lf = is_func_type(sig.param_types[last]);
    if (!lf) {
      out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s last parameter isn't a function — add an explicit `: TYPE` annotation", line, col));
    } else if (use_callback_empty(sig)) {
      out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s callback takes no arguments — there's nothing to bind", line, col));
    } else if (sig.all_type_params.len() > 0 && is_unknown(use_binding_type(c, cur))) {
      out = out.append(dg_at("E032", "use: could not infer binding type for \"" + callee_name + "\" from its arguments — add an explicit `: TYPE` annotation", line, col));
      let expected = "fn";
      if (last < sig.param_type_names.len()) {
        expected = sig.param_type_names[last];
      }
      out = out.append(dg_at("E038", arg_subject(c, c.args.len()) + ": expected " + expected + ", got " + use_callback_label(c.args[c.args.len() - 1], cur), line, col));
    }
    return out;
  }
  let bound_at = cur.binding_index(callee_name);
  if (bound_at >= 0) {
    if let typeinfo.TypeFunc(ft) = cur.types[bound_at] {
      if (ft.param_types.len() == 0) {
        out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", line, col));
        return out;
      }
      match (ft.param_types[ft.param_types.len() - 1]) {
        typeinfo.TypeFunc(cb) => {
          if (cb.param_types.len() == 0) {
            out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s callback takes no arguments — there's nothing to bind", line, col));
          }
        },
        _ => {
          out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s last parameter isn't a function — add an explicit `: TYPE` annotation", line, col));
        }
      }
      return out;
    }
  }
  out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", line, col));
  return out;
}

function use_callback_empty(sig: FuncSig): boolean {
  if (sig.param_types.len() > 0) {
    if let typeinfo.TypeFunc(f) = sig.param_types[sig.param_types.len() - 1] {
      return f.params_known && f.param_types.len() == 0;
    }
  }
  return false;
}

function argument_type_label(e: ast.Expr, t: typeinfo.Type, s: Scope): string {
  if let ast.ExprLambda(lm) = e {
    if (lm.use_infer && lm.params.len() > 0 && lm.params[0].type_name.len() == 0) {
      return use_callback_label(e, s);
    }
  }
  return type_label(t);
}

function use_callback_label(e: ast.Expr, s: Scope): string {
  let params = "";
  if let ast.ExprLambda(lm) = e {
    let i = 0;
    while (i < lm.params.len()) {
      if (i > 0) {
        params += ", ";
      }
      params += "<unknown>";
      i += 1;
    }
  }
  let ret = "unknown";
  if let typeinfo.TypeFunc(ft) = check_expr(e, s) {
    ret = type_label(ft.ret_type);
  }
  return "(" + params + ") => " + ret;
}

function e021_const_kind_diags(req: parser.FuncDecl, impl_fn: parser.FuncDecl, im: parser.ImplInfo): util.Diag[] {
  if (req.is_const == impl_fn.is_const) {
    return [];
  }
  if (req.is_const) {
    return [dg_at("E021", im.impl_type + "." + req.name + " is an associated constant of trait " + im.trait_name + "; bind it with `const " + req.name + ": " + parser.subst_self(req.ret_type, im.impl_type) + " = …;`, not a function", im.line, im.col)];
  }
  return [dg_at("E021", im.impl_type + "." + req.name + " is an associated function of trait " + im.trait_name + "; provide it with `function`, not a const", im.line, im.col)];
}

function e021_recv_method_idx(mod: parser.Module, ty: string, m: string): i32 {
  let i = 0;
  while (i < mod.funcs.len()) {
    let f = mod.funcs[i];
    if (f.receiver_type.len() > 0 && f.name == m && util.base_type_name(f.receiver_type) == ty) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function e021_sig_matches(req: parser.FuncDecl, impl_fn: parser.FuncDecl, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): boolean {
  if (tparams.len() > 0 && parser.parse_type_ref(im.trait_ref).args.len() != tparams.len()) {
    return true;
  }
  if (req.type_params.len() > 0 || req.all_type_params.len() > 0) {
    return true;
  }
  if (impl_fn.type_params.len() > 0 || impl_fn.all_type_params.len() > 0) {
    return true;
  }
  if (!e021_self_matches(req, im, tparams, impls)) {
    return false;
  }
  let first = 0;
  if (req.params.len() > 0 && req.params[0].name == "self") {
    first = 1;
  }
  if (req.params.len() - first != impl_fn.params.len()) {
    return false;
  }
  let i = first;
  while (i < req.params.len()) {
    if (e021_req_spelling(req.params[i].type_name, im, tparams, impls) != impl_fn.params[i - first].type_name) {
      return false;
    }
    i += 1;
  }
  return e021_req_spelling(req.ret_type, im, tparams, impls) == impl_fn.ret_type;
}

function e021_wrong_sig(req: parser.FuncDecl, impl_fn: parser.FuncDecl, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): util.Diag {
  let want: string[] = [];
  let got: string[] = [];
  for p in req.params {
    if (p.name == "self" && p.type_name.len() == 0) {
      want = want.append(im.impl_type);
    } else {
      want = want.append(e021_req_spelling(p.type_name, im, tparams, impls));
    }
  }
  if (req.params.len() > 0 && req.params[0].name == "self") {
    got = got.append(impl_fn.receiver_type);
  }
  for p in impl_fn.params {
    got = got.append(p.type_name);
  }
  let expected = e021_sig_text(want, e021_req_spelling(req.ret_type, im, tparams, impls));
  return dg_at("E021", im.impl_type + "." + req.name + " has the wrong signature for trait " + im.trait_name + ": expected " + expected + ", got " + e021_sig_text(got, impl_fn.ret_type), im.line, im.col);
}

function e021_sig_text(params: string[], ret: string): string {
  let r = ret;
  if (r.len() == 0) {
    r = "void";
  }
  return "(" + comma_list(params) + ") => " + r;
}

function e021_self_matches(req: parser.FuncDecl, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): boolean {
  if (req.params.len() == 0 || req.params[0].name != "self" || req.params[0].type_name.len() == 0) {
    return true;
  }
  return e021_req_spelling(req.params[0].type_name, im, tparams, impls) == im.impl_type;
}

function e021_req_spelling(t: string, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): string {
  let spelled = parser.subst_self(t, im.impl_type);
  if (tparams.len() > 0) {
    spelled = dyn_ret_at_spelling(spelled, im.trait_ref, tparams);
  }
  return parser.resolve_proj_in_type(spelled, impls);
}

function e021_has_impl(mod: parser.Module, trait_name: string, impl_type: string): boolean {
  for imp in mod.impls {
    if (imp.trait_name == trait_name && imp.impl_type == impl_type) {
      return true;
    }
  }
  return false;
}

function e021_supertrait_impl(mod: parser.Module, spelling: string, self: string): boolean {
  let idx = trait_req_idx(util.base_type_name(spelling), mod.trait_reqs);
  if (idx < 0) {
    return false;
  }
  let req = mod.trait_reqs[idx];
  let want = parser.parse_type_ref(spelling);
  for imp in mod.impls {
    if (imp.trait_name != req.trait_name || imp.trait_module != req.module || imp.impl_type != self) {
      continue;
    }
    let got = parser.parse_type_ref(imp.trait_ref);
    if (got.args.len() != want.args.len()) {
      continue;
    }
    let same = true;
    let i = 0;
    while (i < want.args.len()) {
      if (parser.render_type_ref(got.args[i]) != parser.render_type_ref(want.args[i])) {
        same = false;
      }
      i += 1;
    }
    if (same) {
      return true;
    }
  }
  return false;
}

function e021_source_qualifier_visible(mod: parser.Module, module: string, spelling: string): boolean {
  let dot = util.index_of_sub(spelling, ".");
  if (dot < 0) {
    return true;
  }
  let qual = slice_unchecked(spelling, 0, dot) + "";
  if (mod.sights.len() > 0) {
    for sight in mod.sights {
      if (sight.module == module) {
        return util.has_str(sight.qualifiers, qual);
      }
    }
    return false;
  }
  for imported in mod.imports {
    if (parser.import_qualifier(imported) == qual) {
      return true;
    }
  }
  return false;
}

function e021_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for req in mod.trait_reqs {
    for parent in req.supertraits {
      let idx = trait_req_idx(util.base_type_name(parent), mod.trait_reqs);
      if (idx >= 0) {
        let want = mod.trait_reqs[idx].type_params.len();
        let got = parser.parse_type_ref(parent).args.len();
        if (want != got) {
          out = out.append(dg("E021", "supertrait " + util.base_type_name(parent) + " expects " + util.i32_to_string(want) + " type arguments, got " + util.i32_to_string(got)));
        }
      }
    }
  }
  let own_vec = parser.declares_vec(mod.structs, mod.enums, mod.aliases, mod.trait_decls);
  for im in mod.impls {
    if (!e021_source_qualifier_visible(mod, im.module, im.trait_spelling)) {
      out = out.append(dg_at("E021", "unknown trait \"" + im.trait_spelling + "\" in impl", im.line, im.col));
      continue;
    }
    let ir = parser.parse_type_ref(im.impl_type);
    if (ir.base == "Vec" && ir.args.len() == 2 && !own_vec) {
      out = out.append(dg_at("E096", im.impl_type + " names no lane type: the portable tier has Vec[2, f64] and Vec[4, f32]", im.line, im.col));
      continue;
    }
    if (im.trait_name == "Send" && im.trait_module == "worker") {
      out = out.append(dg_at("E021", "impl " + im.trait_spelling + " for " + im.impl_type + ": Send is not implemented by hand; every send-safe type satisfies it", im.line, im.col));
      continue;
    }
    let known = false;
    for trait_req in mod.trait_reqs {
      if (trait_req.trait_name == im.trait_name && trait_req.module == im.trait_module) {
        known = true;
        let sup = trait_req.supertraits;
        for parent in sup {
          let elem = e021_req_spelling(parent, im, trait_req.type_params, mod.impls);
          if (!e021_supertrait_impl(mod, elem, im.impl_type)) {
            out = out.append(dg_at("E021", "impl " + im.trait_name + " for " + im.impl_type + " also requires `impl " + elem + " for " + im.impl_type + "` (supertrait of " + im.trait_name + ")", im.line, im.col));
          }
        }
        let im_base = util.base_type_name(im.impl_type);
        for at_req in trait_req.assoc_types {
          if (!name_in(at_req, im.assoc_names)) {
            out = out.append(dg_at("E021", "impl of " + im.trait_name + " for " + im_base + " must bind associated type \"" + at_req + "\" (`type " + at_req + " = …;`)", im.line, im.col));
          }
        }
        for at_bound in im.assoc_names {
          if (!name_in(at_bound, trait_req.assoc_types)) {
            out = out.append(dg_at("E021", "impl of " + im.trait_name + " for " + im_base + " binds associated type \"" + at_bound + "\" which the trait does not declare", im.line, im.col));
          }
        }
        let reqs = trait_req.methods;
        let sigs = trait_req.req_sigs;
        let ri = 0;
        while (ri < reqs.len()) {
          let midx = e021_recv_method_idx(mod, im.impl_type, reqs[ri]);
          if (!name_in(reqs[ri], im.method_names) && midx < 0) {
            if (ri < sigs.len() && sigs[ri].is_const) {
              out = out.append(dg_at("E021", im.impl_type + " does not implement " + im.trait_name + ": missing associated constant \"" + reqs[ri] + "\"", im.line, im.col));
            } else {
              out = out.append(dg_at("E021", im.impl_type + " does not implement " + im.trait_name + ": missing method \"" + reqs[ri] + "\"", im.line, im.col));
            }
          } else if (midx >= 0 && ri < sigs.len()) {
            let kind_dg = e021_const_kind_diags(sigs[ri], mod.funcs[midx], im);
            if (kind_dg.len() > 0) {
              out = util.append_diags(out, kind_dg);
            } else if (!e021_sig_matches(sigs[ri], mod.funcs[midx], im, trait_req.type_params, mod.impls)) {
              out = out.append(e021_wrong_sig(sigs[ri], mod.funcs[midx], im, trait_req.type_params, mod.impls));
            }
          }
          ri += 1;
        }
        for ds in trait_req.default_sigs {
          let didx = e021_recv_method_idx(mod, im.impl_type, ds.name);
          let written = name_in(ds.name, im.method_names) && didx >= 0;
          if (written && e021_const_kind_diags(ds, mod.funcs[didx], im).len() > 0) {
            out = util.append_diags(out, e021_const_kind_diags(ds, mod.funcs[didx], im));
          } else if (written && !e021_sig_matches(ds, mod.funcs[didx], im, trait_req.type_params, mod.impls)) {
            out = out.append(e021_wrong_sig(ds, mod.funcs[didx], im, trait_req.type_params, mod.impls));
          } else if (!written && !e021_self_matches(ds, im, trait_req.type_params, mod.impls)) {
            out = out.append(dg_at("E021", im.impl_type + "." + ds.name + " has the wrong signature for trait " + im.trait_name, im.line, im.col));
          }
        }
      }
    }
    let written = util.base_type_name(im.trait_ref);
    if (!known && !derive_import_unloaded(mod, written)) {
      out = out.append(dg_at("E021", "unknown trait \"" + written + "\" in impl", im.line, im.col));
    }
  }
  return out;
}

function e021_derive_scalar(fty: string): boolean {
  return fty == "i32" || fty == "i64" || fty == "u8" || fty == "u32" || fty == "u64" || fty == "f32" || fty == "f64" || fty == "boolean" || fty == "char" || fty == "string";
}

function e021_derive_field_known(mod: parser.Module, fty: string): boolean {
  if (e021_derive_scalar(fty)) {
    return true;
  }
  for sd in mod.structs {
    if (sd.name == fty) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == fty) {
      return true;
    }
  }
  return false;
}

function e021_derive_conforms(mod: parser.Module, tr: string, treq_idx: i32, fty: string): boolean {
  if (e021_has_impl(mod, tr, fty)) {
    return true;
  }
  let reqs = mod.trait_reqs[treq_idx].methods;
  if (reqs.len() == 0) {
    return false;
  }
  for req in reqs {
    if (e021_recv_method_idx(mod, fty, req) < 0) {
      return false;
    }
  }
  return true;
}

function derive_trait_idx(tr: string, trait_reqs: parser.TraitReq[]): i32 {
  let dot = tr.len() - 1;
  while (dot >= 0 && tr[dot] != b'.') {
    dot -= 1;
  }
  let q = "";
  let name = tr;
  if (dot >= 0) {
    q = slice_unchecked(tr, 0, dot) + "";
    name = slice_unchecked(tr, dot + 1, tr.len()) + "";
  }
  let i = 0;
  while (i < trait_reqs.len()) {
    if (trait_reqs[i].trait_name == name && trait_reqs[i].module == q) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function derive_import_unloaded(mod: parser.Module, tr: string): boolean {
  let dot = tr.len() - 1;
  while (dot >= 0 && tr[dot] != b'.') {
    dot -= 1;
  }
  if (dot < 0) {
    return false;
  }
  let q = slice_unchecked(tr, 0, dot) + "";
  for r in mod.trait_reqs {
    if (r.module == q) {
      return false;
    }
  }
  for im in mod.imports {
    let qual = im.alias;
    if (qual.len() == 0) {
      let sl = im.path.len() - 1;
      while (sl >= 0 && im.path[sl] != b'/') {
        sl -= 1;
      }
      qual = slice_unchecked(im.path, sl + 1, im.path.len()) + "";
    }
    if (qual == q) {
      return true;
    }
  }
  return false;
}

function fromjson_field_shape(elem: string): boolean {
  if (elem.len() == 0 || parser.fromjson_container(elem) == "array") {
    return false;
  }
  if (elem[0] == b'(') {
    return false;
  }
  return !(elem.len() > 3 && slice_unchecked(elem, 0, 3) == "fn(");
}

function e021_derive_one_diag(mod: parser.Module, tr: string, tname: string, labels: string[], ftys: string[], tps: string[], ln: i32, cl: i32): util.Diag[] {
  let kind = parser.derive_simple_name(tr);
  let tidx = derive_trait_idx(tr, mod.trait_reqs);
  if (tidx < 0) {
    if (derive_import_unloaded(mod, tr)) {
      return [];
    }
    return [dg_at("E021", "@derive(" + tr + "): unknown trait", ln, cl)];
  }
  if (kind != "Eq" && kind != "Ord" && kind != "Hash" && kind != "Display" && kind != "Debug" && kind != "Json" && kind != "FromJson" && kind != "Default") {
    return [dg_at("E021", "cannot @derive(" + tr + "): only Eq, Display, Debug, Ord, Hash, Json, FromJson, and Default are derivable", ln, cl)];
  }
  let ctys = ftys;
  if (kind == "FromJson") {
    if (!module_imports_std_json(mod)) {
      return [dg_at("E021", "cannot @derive(" + tr + "): the decoder is std/json's; import \"std/json\"", ln, cl)];
    }
    ctys = [];
    let ei = 0;
    while (ei < ftys.len()) {
      let elem = parser.fromjson_elem(ftys[ei]);
      if (!fromjson_field_shape(elem)) {
        return [dg_at("E021", "cannot @derive(" + tr + ") for " + tname + ": " + labels[ei] + " has type " + ftys[ei] + "; FromJson decodes a field of a FromJson type, an array of one or an Option of one", ln, cl)];
      }
      ctys = ctys.append(elem);
      ei += 1;
    }
  }
  let fi = 0;
  while (fi < ctys.len()) {
    let fty = receiver_namespace(ctys[fi]);
    let checked = kind != "Default" || !e021_derive_scalar(fty);
    if (checked && !name_in(fty, tps) && e021_derive_field_known(mod, fty)) {
      if (!e021_derive_conforms(mod, tr, tidx, fty)) {
        return [dg_at("E021", "cannot @derive(" + tr + ") for " + tname + ": " + labels[fi] + " of type " + fty + " does not implement " + tr + " — add `impl " + tr + " for " + fty + "` (or remove the derive)", ln, cl)];
      }
    }
    fi += 1;
  }
  return [];
}

function module_imports_std_json(mod: parser.Module): boolean {
  for im in mod.imports {
    if (im.path == "std/json") {
      return true;
    }
  }
  return false;
}

function derive_method_name(kind: string): string {
  if (kind == "Display") {
    return "to_string";
  }
  if (kind == "Debug") {
    return "to_debug";
  }
  if (kind == "Json") {
    return "to_json";
  }
  if (kind == "FromJson") {
    return "from_json_value";
  }
  if (kind == "Eq") {
    return "eq";
  }
  if (kind == "Ord") {
    return "cmp";
  }
  if (kind == "Hash") {
    return "hash";
  }
  if (kind == "Default") {
    return "default";
  }
  return "";
}

function derive_body_suppressed(fn: parser.FuncDecl, keys: string[]): boolean {
  if (keys.len() == 0) {
    return false;
  }
  if (fn.line != 0 || fn.col != 0) {
    return false;
  }
  if (fn.receiver_type.len() == 0) {
    return false;
  }
  return name_in(fn.receiver_type + "." + fn.name, keys);
}

function e021_derive_field_diags(mod: parser.Module): (util.Diag[], string[]) {
  let out: util.Diag[] = [];
  let keys: string[] = [];
  for sd in mod.structs {
    if (sd.enum_owner.len() == 0 && sd.derives.len() > 0) {
      let labels: string[] = [];
      let ftys: string[] = [];
      for field in sd.fields {
        labels = labels.append("field " + field.name);
        ftys = ftys.append(field.type_name);
      }
      for derive in sd.derives {
        let sdd = e021_derive_one_diag(mod, derive, sd.name, labels, ftys, sd.type_params, sd.line, sd.col);
        if (sdd.len() > 0) {
          let smn = derive_method_name(parser.derive_simple_name(derive));
          if (smn.len() > 0) {
            keys = keys.append(sd.name + "." + smn);
          }
        }
        out = util.append_diags(out, sdd);
      }
    }
  }
  for ed in mod.enums {
    let elabels: string[] = [];
    let eftys: string[] = [];
    let ederives: string[] = [];
    for vs in mod.structs {
      if (vs.enum_owner == ed.name) {
        if (ederives.len() == 0) {
          ederives = vs.derives;
        }
        for field in vs.fields {
          elabels = elabels.append("variant " + vs.name + " payload");
          eftys = eftys.append(field.type_name);
        }
      }
    }
    for ederive in ederives {
      let edd = e021_derive_one_diag(mod, ederive, ed.name, elabels, eftys, ed.type_params, ed.line, ed.col);
      if (edd.len() > 0) {
        let emn = derive_method_name(parser.derive_simple_name(ederive));
        if (emn.len() > 0) {
          keys = keys.append(ed.name + "." + emn);
        }
      }
      out = util.append_diags(out, edd);
    }
  }
  return (out, keys);
}

function type_ref_mentions_self(t: parser.TypeRef): boolean {
  if (t.base == "Self") {
    return true;
  }
  for a in t.args {
    if (type_ref_mentions_self(a)) {
      return true;
    }
  }
  return false;
}

function type_mentions_self(type_name: string): boolean {
  return type_ref_mentions_self(parser.parse_type_ref(type_name));
}

function e021_object_unsafe_method(mod: parser.Module, trait_name: string): string {
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      let sigs = trait_req.req_sigs;
      for f in sigs {
        let i = 0;
        if (f.params.len() > 0 && f.params[0].name == "self") {
          i = 1;
        }
        while (i < f.params.len()) {
          if (type_mentions_self(f.params[i].type_name)) {
            return "method \"" + f.name + "\" takes Self as a non-receiver parameter";
          }
          i += 1;
        }
        if (type_mentions_self(f.ret_type)) {
          return "method \"" + f.name + "\" returns Self";
        }
      }
      return "";
    }
  }
  return "";
}

function e021_dyn_target(type_name: string): string {
  if (type_name.len() < 5 || slice_unchecked(type_name, 0, 4) != "dyn ") {
    return "";
  }
  let t = e021_dyn_element(type_name);
  let cut = e021_bracket_open(t);
  if (cut > 0) {
    return slice_unchecked(t, 0, cut) + "";
  }
  return t;
}

function e021_dyn_element(type_name: string): string {
  let t = slice_unchecked(type_name, 4, type_name.len());
  while (t.len() >= 2 && t[t.len() - 2] == b'[' && t[t.len() - 1] == b']') {
    t = slice_unchecked(t, 0, t.len() - 2);
  }
  return t + "";
}

function e021_bracket_open(t: string): i32 {
  if (t.len() < 2 || t[t.len() - 1] != b']') {
    return -1;
  }
  let bal = 0;
  let i = t.len() - 1;
  while (i >= 0) {
    if (t[i] == b']') {
      bal += 1;
    } else if (t[i] == b'[') {
      bal -= 1;
      if (bal == 0) {
        return i;
      }
    }
    i -= 1;
  }
  return -1;
}

function e021_dyn_pin_names(type_name: string): string[] {
  let out: string[] = [];
  if (type_name.len() < 5 || slice_unchecked(type_name, 0, 4) != "dyn ") {
    return out;
  }
  let t = e021_dyn_element(type_name);
  let open = e021_bracket_open(t);
  if (open < 0) {
    return out;
  }
  let inner = slice_unchecked(t, open + 1, t.len() - 1) + "";
  let start = 0;
  let depth = 0;
  let i = 0;
  while (i <= inner.len()) {
    let at_end = i == inner.len();
    let is_sep = at_end;
    if (!at_end) {
      let c = inner[i];
      if (c == b'[') {
        depth += 1;
      }
      if (c == b']') {
        depth -= 1;
      }
      if (c == b',' && depth == 0) {
        is_sep = true;
      }
    }
    if (is_sep) {
      let seg = slice_unchecked(inner, start, i) + "";
      let eq: i32 = -1;
      let j = 0;
      while (j < seg.len()) {
        if (seg[j] == b'=' && eq < 0) {
          eq = j;
        }
        j += 1;
      }
      if (eq > 0) {
        out = out.append(util.trim(slice_unchecked(seg, 0, eq) + ""));
      }
      start = i + 1;
    }
    i += 1;
  }
  return out;
}

function e021_object_unsafe_assoc(mod: parser.Module, trait_name: string, dyn_spelling: string): string {
  let pins = e021_dyn_pin_names(dyn_spelling);
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      for at in trait_req.assoc_types {
        if (!name_in(at, pins)) {
          return "associated type \"" + at + "\" is not pinned — write `dyn " + trait_name + "[" + at + " = ...]`";
        }
      }
      return "";
    }
  }
  return "";
}

function e021_object_safety_diags(mod: parser.Module, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  let seen: string[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    for site in e021_dyn_sites(fn) {
      if (e021_dyn_target(site.spelling).len() == 0) {
        continue;
      }
      for bound in parser.split_plus_bounds(e021_dyn_element(site.spelling)) {
        let spelling = util.trim(bound);
        let target_trait = parser.parse_type_ref(spelling).base;
        if (util.has_str(seen, target_trait)) {
          continue;
        }
        let reason = e021_object_unsafe_assoc(mod, target_trait, "dyn " + spelling);
        if (reason.len() == 0) {
          reason = e021_object_unsafe_method(mod, target_trait);
        }
        if (reason.len() > 0) {
          seen = seen.append(target_trait);
          let name = util.demangle(target_trait);
          out = out.append(dg_at("E021", "trait " + name + " is not object-safe: " + reason + ", so it cannot be used as `dyn " + name + "`", site.line, site.col));
        }
      }
    }
  }
  return out;
}

function e021_unknown_dyn_trait_diags(mod: parser.Module, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  let seen: string[] = [];
  let imports = import_paths_of(mod);
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    for site in e021_dyn_trait_sites(fn) {
      let base = site.spelling;
      if (!util.has_str(seen, base) && !bound_import_unloaded(base, imports, mod.trait_reqs) && bound_trait_req(base, fn.module, mod.trait_reqs) < 0) {
        seen = seen.append(base);
        out = out.append(dg_at("E021", "unknown trait \"" + util.demangle(bound_trait_display(base, fn.module, mod.trait_reqs)) + "\" in `dyn` type", site.line, site.col));
      }
    }
  }
  return out;
}

struct DynSite { spelling: string, line: i32, col: i32 }

function e021_dyn_sites(fn: parser.FuncDecl): DynSite[] {
  let sites: DynSite[] = [];
  for param in fn.params {
    sites = sites.append(DynSite { spelling: param.type_name, line: fn.line, col: fn.col });
  }
  sites = sites.append(DynSite { spelling: fn.ret_type, line: fn.line, col: fn.col });
  for stmt in fn.body {
    sites = astwalk.fold_stmt_nodes(stmt, sites, e021_dyn_site_at, e021_no_site, astwalk.descend_all);
  }
  return sites;
}

function e021_dyn_trait_sites(fn: parser.FuncDecl): DynSite[] {
  let out: DynSite[] = [];
  for site in e021_dyn_sites(fn) {
    if (e021_dyn_target(site.spelling).len() > 0) {
      for entry in parser.split_plus_bounds(e021_dyn_element(site.spelling)) {
        out = out.append(DynSite { spelling: parser.parse_type_ref(util.trim(entry)).base, line: site.line, col: site.col });
      }
    }
  }
  return out;
}

function e021_dyn_site_at(st: ast.Stmt, own a: DynSite[]): DynSite[] {
  match (st) {
    ast.StmtVar(v) => {
      if (e021_dyn_target(v.type_name).len() > 0) {
        return a.append(DynSite { spelling: v.type_name, line: v.line, col: v.col });
      }
      return a;
    },
    _ => {
      return a;
    }
  }
}

function e021_no_site(e: ast.Expr, own a: DynSite[]): DynSite[] {
  return a;
}

function e060_dyn_set_of(type_name: string): string {
  if (type_name.len() < 5 || slice_unchecked(type_name, 0, 4) != "dyn ") {
    return "";
  }
  let t = slice_unchecked(type_name, 4, type_name.len());
  if (t.len() >= 2 && t[t.len() - 2] == b'[' && t[t.len() - 1] == b']') {
    return "";
  }
  return t + "";
}

function e060_trait_known(mod: parser.Module, trait_name: string): boolean {
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      return true;
    }
  }
  return false;
}

function e060_trait_declares(mod: parser.Module, trait_name: string, m: string): boolean {
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      return name_in(m, trait_req.methods);
    }
  }
  return false;
}

function e060_collect_dyn_locals(stmts: ast.Stmt[], acc: string[]): string[] {
  function at_stmt(st: ast.Stmt, own a: string[]): string[] {
    match (st) {
      ast.StmtVar(v) => {
        let out = a;
        let seen = 0;
        let k = 0;
        while (k < out.len()) {
          let e = out[k];
          let bar = 0;
          while (bar < e.len() && e[bar] != b'|') {
            bar += 1;
          }
          if (slice_unchecked(e, 0, bar) == v.name) {
            out = out.with(k, v.name + "|");
            seen = 1;
          }
          k += 1;
        }
        if (seen == 0) {
          out = out.append(v.name + "|" + e060_dyn_set_of(v.type_name));
        }
        return out;
      },
      _ => {
        return a;
      }
    }
  }
  let res = acc;
  for stmt in stmts {
    res = astwalk.fold_stmt_nodes(stmt, res, at_stmt, (e: ast.Expr, own a: string[]) => a, astwalk.descend_all);
  }
  return res;
}

function e060_set_of_name(dyns: string[], name: string): string {
  for dy in dyns {
    let e = dy;
    let bar = 0;
    while (bar < e.len() && e[bar] != b'|') {
      bar += 1;
    }
    if (slice_unchecked(e, 0, bar) == name) {
      return slice_unchecked(e, bar + 1, e.len()) + "";
    }
  }
  return "";
}

function e060_is_primitive_name(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u8" || t == "u32" || t == "u64" || t == "f32" || t == "f64" || t == "boolean" || t == "string" || t == "str" || t == "usize" || t == "char";
}

function e060_e062_stmts(stmts: ast.Stmt[], dyns: string[], mod: parser.Module, acc: util.Diag[]): util.Diag[] {
  function at_node(n: ast.Expr, own out: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprUnary(u) => {
        if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
          match (u.operand) {
            ast.ExprIdent(id) => {
              let set = e060_set_of_name(dyns, id.name);
              if (set.len() > 0) {
                let tgt = slice_unchecked(u.op, 4, u.op.len());
                if (e060_is_primitive_name(tgt)) {
                  return out.append(dg_at("E060", "'as?' downcast target must be a concrete struct or enum type (slice 1), got " + tgt, u.line, u.col));
                }
                if (e060_decl_is_plain_struct(mod, tgt) || e060_decl_is_enum(mod, tgt)) {
                  let trs = parser.dyn_trait_set("dyn " + set);
                  let all_known = true;
                  let missing = "";
                  for tr in trs {
                    if (!e060_trait_known(mod, tr)) {
                      all_known = false;
                    } else if (!e021_has_impl(mod, tr, tgt)) {
                      if (missing.len() > 0) {
                        missing += " + ";
                      }
                      missing += tr;
                    }
                  }
                  if (all_known && missing.len() > 0) {
                    return out.append(dg_at("E060", tgt + " does not implement " + missing + ", so a 'dyn " + set + "' cannot downcast to it", u.line, u.col));
                  }
                }
              }
            },
            _ => {}
          }
        }
        return out;
      },
      ast.ExprCall(c) => {
        match (c.callee) {
          ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
              ast.ExprIdent(rid) => {
                let rset = e060_set_of_name(dyns, rid.name);
                if (rset.len() > 0) {
                  let rtrs = parser.dyn_trait_set("dyn " + rset);
                  let declaring = "";
                  let n_decl = 0;
                  for rtr in rtrs {
                    if (e060_trait_declares(mod, rtr, fa.field)) {
                      if (n_decl > 0) {
                        declaring += ", ";
                      }
                      declaring += rtr;
                      n_decl += 1;
                    }
                  }
                  if (rtrs.len() >= 2 && n_decl >= 2) {
                    return out.append(dg_at("E062", "ambiguous method \"" + fa.field + "\" on `dyn " + rset + "`: declared by traits " + declaring, fa.line, fa.col));
                  }
                  let assoc_owner = "";
                  for atr in rtrs {
                    if (assoc_owner.len() == 0) {
                      let ah = trait_assoc_req(mod.trait_reqs, atr, fa.field, []);
                      if (ah.found) {
                        assoc_owner = ah.owner;
                      }
                    }
                  }
                  if (assoc_owner.len() > 0) {
                    return out.append(dg_at("E021", "\"" + fa.field + "\" is an associated function of trait " + assoc_owner + ", not a method; it has no `self` receiver, so it cannot be called through a `dyn " + rset + "` value — call it on a concrete type", fa.line, fa.col));
                  }
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
        return out;
      },
      _ => {
        return out;
      }
    }
    return out;
  }
  let res = acc;
  for stmt in stmts {
    res = astwalk.fold_stmt(stmt, res, at_node);
  }
  return res;
}

function e060_decl_is_plain_struct(mod: parser.Module, name: string): boolean {
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return true;
    }
  }
  return false;
}

function e060_decl_is_enum(mod: parser.Module, name: string): boolean {
  if (name.len() == 0) {
    return false;
  }
  for sd in mod.structs {
    if (sd.enum_owner == name) {
      return true;
    }
  }
  return false;
}

function e060_e062_diags(mod: parser.Module, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    let dyns: string[] = [];
    for param in fn.params {
      dyns = dyns.append(param.name + "|" + e060_dyn_set_of(param.type_name));
    }
    dyns = e060_collect_dyn_locals(fn.body, dyns);
    out = e060_e062_stmts(fn.body, dyns, mod, out);
  }
  return out;
}

function range_import_msg(): string {
  return "a range `a..b` outside a `for` header requires `import \"core/iter\";`";
}

function map_import_msg(): string {
  return "Map operations require `import \"core/map\";`";
}

function thin_map_import_diags(ds: util.Diag[]): util.Diag[] {
  let msg = map_import_msg();
  let seen = false;
  let out: util.Diag[] = [];
  for d in ds {
    if (d.code == "E001" && d.message == msg) {
      if (seen) {
        continue;
      }
      seen = true;
    }
    out = out.append(d);
  }
  return out;
}

struct Inst { name: string, cts: string[], depth: i32 }

function max_inst_depth(): i32 {
  return 64;
}

function spellable(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return false;
    },
    typeinfo.TypeErased(_) => {
      return false;
    },
    typeinfo.TypeFunc(_) => {
      return false;
    },
    typeinfo.TypeVoid(_) => {
      return false;
    },
    typeinfo.TypeArray(a) => {
      return spellable(a.elem);
    },
    typeinfo.TypeMap(m) => {
      return spellable(m.key) && spellable(m.value);
    },
    typeinfo.TypeTuple(tp) => {
      for elem in tp.elements {
        if (!spellable(elem)) {
          return false;
        }
      }
      return true;
    },
    typeinfo.TypeStruct(sd) => {
      for arg in sd.args {
        if (!spellable(arg)) {
          return false;
        }
      }
      return true;
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        if (!spellable(arg)) {
          return false;
        }
      }
      return true;
    },
    _ => {
      return true;
    }
  }
  return true;
}

function template_index(gens: parser.FuncDecl[], name: string): i32 {
  let i = 0;
  while (i < gens.len()) {
    if (gens[i].name == name) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function call_inst(c: ast.ExprCall, s: Scope, gens: parser.FuncDecl[], depth: i32): Option[Inst] {
  if let ast.ExprIdent(id) = c.callee {
    if (s.defines(id.name)) {
      return None;
    }
    let Some(sig) = s.lookup_sig(id.name) else {
      return None;
    };
    if (sig.all_type_params.len() == 0) {
      return None;
    }
    let gi = template_index(gens, id.name);
    if (gi < 0) {
      return None;
    }
    let (bn, bt) = call_type_bindings(sig, c, s);
    let cts: string[] = [];
    for tp in gens[gi].all_type_params {
      let k = util.index_of_str(bn, tp);
      if (k < 0 || !spellable(bt[k])) {
        return None;
      }
      cts = cts.append(type_label(bt[k]));
    }
    return Some(Inst { name: id.name, cts: cts, depth: depth });
  }
  return None;
}

function fn_value_inst(e: ast.Expr, dest: typeinfo.Type, s: Scope, gens: parser.FuncDecl[], depth: i32): Option[Inst] {
  let ast.ExprIdent(id) = e else {
    return None;
  };
  let typeinfo.TypeFunc(df) = dest else {
    return None;
  };
  let gi = template_index(gens, id.name);
  if (gi < 0 || !generic_fn_value_arg(e, s)) {
    return None;
  }
  let Some(sig) = s.lookup_sig(id.name) else {
    return None;
  };
  let (bn, bt) = fn_value_binds(sig, df, s);
  let cts: string[] = [];
  for tp in gens[gi].all_type_params {
    let k = util.index_of_str(bn, tp);
    if (k < 0 || !spellable(bt[k])) {
      return None;
    }
    cts = cts.append(type_label(bt[k]));
  }
  return Some(Inst { name: id.name, cts: cts, depth: depth });
}

function arg_value_insts(c: ast.ExprCall, s: Scope, gens: parser.FuncDecl[], depth: i32, own acc: Inst[]): Inst[] {
  let needs_dest = false;
  for a in c.args {
    if (generic_fn_value_arg(a, s)) {
      needs_dest = true;
    }
  }
  if (!needs_dest) {
    return acc;
  }
  if let ast.ExprIdent(cid) = c.callee {
    if (s.defines(cid.name)) {
      return acc;
    }
  }
  let dests = s.call_param_types(c);
  let out = acc;
  let i = 0;
  while (i < c.args.len() && i < dests.len()) {
    if (generic_fn_value_arg(c.args[i], s)) {
      if let Some(inst) = fn_value_inst(c.args[i], bound_param_dest(c, i, dests[i], s), s, gens, depth) {
        out = out.append(inst);
      }
    }
    i += 1;
  }
  return out;
}

function calls_a_generic(stmts: ast.Stmt[], s: Scope): boolean {
  function at_call(n: ast.Expr, own hit: boolean): boolean {
    if (hit) {
      return true;
    }
    if let ast.ExprCall(c) = n {
      if let ast.ExprIdent(id) = c.callee {
        if let Some(sig) = s.lookup_sig(id.name) {
          if (sig.all_type_params.len() > 0) {
            return true;
          }
        }
      }
      for a in c.args {
        if (generic_fn_value_arg(a, s)) {
          return true;
        }
      }
    }
    return false;
  }
  let hit = false;
  for st in stmts {
    hit = astwalk.fold_stmt(st, hit, at_call);
  }
  return hit;
}

function inst_stmts(stmts: ast.Stmt[], s: Scope, gens: parser.FuncDecl[], depth: i32, own acc: Inst[]): Inst[] {
  let out = acc;
  let cur = s;
  for st in stmts {
    out = inst_stmt(st, cur, gens, depth, out);
    cur = bind_stmt(st, cur);
  }
  return out;
}

function inst_stmt(st: ast.Stmt, cur: Scope, gens: parser.FuncDecl[], depth: i32, own acc: Inst[]): Inst[] {
  function at_node(n: ast.Expr, own a: Inst[]): Inst[] {
    match (n) {
      ast.ExprCall(c) => {
        let found = call_inst(c, cur, gens, depth);
        let out = arg_value_insts(c, cur, gens, depth, a);
        if let Some(inst) = found {
          return out.append(inst);
        }
        return out;
      },
      ast.ExprLambda(lm) => {
        return inst_stmts(lm.body, lambda_body_scope(lm, cur), gens, depth, a);
      },
      _ => {
        return a;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    if let ast.ExprLambda(_) = n {
      return false;
    }
    return true;
  }
  let out = astwalk.fold_stmt_own_pruned(st, acc, at_node, not_into_lambda);
  match (st) {
    ast.StmtIf(f) => {
      out = inst_stmts(f.then_body, cur, gens, depth, out);
      out = inst_stmts(f.else_body, cur, gens, depth, out);
    },
    ast.StmtWhile(w) => {
      out = inst_stmts(w.body, cur, gens, depth, out);
    },
    ast.StmtFor(fr) => {
      out = inst_stmts(fr.body, for_body_scope(fr, cur), gens, depth, out);
    },
    ast.StmtMatch(m) => {
      let whole = check_expr(m.scrutinee, cur);
      for arm in m.arms {
        out = inst_stmts(arm.body, annotate_arm_scope(arm, cur, whole), gens, depth, out);
      }
    },
    ast.StmtDefer(d) => {
      let one: ast.Stmt[] = [d.action];
      out = inst_stmts(one, cur, gens, depth, out);
    },
    _ => {}
  }
  return out;
}

function instantiated_clones(mod: parser.Module, env: ModuleEnv): parser.FuncDecl[] {
  let clones: parser.FuncDecl[] = [];
  let gens: parser.FuncDecl[] = [];
  for fd in mod.funcs {
    if (fd.receiver_name.len() == 0 && fd.all_type_params.len() > 0) {
      gens = gens.append(fd);
    }
  }
  if (gens.len() == 0) {
    return clones;
  }
  let msc = new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  let mf = parser.mfns_of(mod.funcs, mod.structs, mod.enums, mod.impls);
  let pending: Inst[] = [];
  for fd in mod.funcs {
    if (fd.all_type_params.len() == 0) {
      pending = body_insts(fd, env, msc, gens, 0, pending);
    }
  }
  if (calls_a_generic(mod.top_stmts, msc)) {
    pending = inst_stmts(mod.top_stmts, msc, gens, 0, pending);
  }
  let keys: string[] = [];
  let wi = 0;
  while (wi < pending.len()) {
    let inst = pending[wi];
    wi += 1;
    let spelled = "";
    for ct in inst.cts {
      if (spelled.len() > 0) {
        spelled += ";";
      }
      spelled += ct;
    }
    let key = inst.name + "__" + parser.sanitize_key(spelled);
    if (inst.depth >= max_inst_depth() || util.has_str(keys, key)) {
      continue;
    }
    keys = keys.append(key);
    let g = gens[template_index(gens, inst.name)];
    let routed = parser.FuncDecl { ...g, body: parser.route_bound_calls(g, inst.cts, env.trait_reqs, mf) };
    let cl = parser.instantiate_func(routed, key, g.all_type_params, inst.cts, mod.impls);
    clones = clones.append(cl);
    pending = body_insts(cl, env, msc, gens, inst.depth + 1, pending);
  }
  return clones;
}

function body_insts(fd: parser.FuncDecl, env: ModuleEnv, msc: Scope, gens: parser.FuncDecl[], depth: i32, own acc: Inst[]): Inst[] {
  if (!calls_a_generic(fd.body, msc)) {
    return acc;
  }
  return inst_stmts(fd.body, build_func_scope(fd, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs), gens, depth, acc);
}

pub function check_module(raw_mod: parser.Module): ModuleTypes {
  return check_module_with_file(raw_mod, "");
}

pub function check_module_with_file(raw_mod: parser.Module, entry_file: string): ModuleTypes {
  return check_module_raw_floor(raw_mod, entry_file, false);
}

function admission_env(mod: parser.Module, entry_file: string, raw_floor: boolean): ModuleEnv {
  let env = module_env_with_file(mod, entry_file);
  if (raw_floor) {
    return env;
  }
  return ModuleEnv { ...env, sigs: SigTable { ...env.sigs, raw_allowed: false } };
}

function check_module_raw_floor(raw_mod: parser.Module, entry_file: string, raw_floor: boolean): ModuleTypes {
  let mt = checked_module(raw_mod, entry_file, raw_floor);
  if (mt.diags.len() == 0) {
    return mt;
  }
  let mangled = util.name_index(imported_decl_names(raw_mod));
  let named: util.Diag[] = [];
  for d in mt.diags {
    let nd = source_named_diag(d, mangled);
    if (!reported_before(named, nd)) {
      named = named.append(nd);
    }
  }
  return ModuleTypes { ...mt, diags: named };
}

// reported_before holds when ds already has d's code and message at d's position: a
// node checked twice (a compound assignment's place) reports once, as Go's checker does.
function reported_before(ds: util.Diag[], d: util.Diag): boolean {
  for e in ds {
    if (e.line == d.line && e.col == d.col && e.code == d.code && e.message == d.message) {
      return true;
    }
  }
  return false;
}

// source_named_diag spells each name an imported module declares as its
// source does, `iter.ArrayIter` for the bundle's `iter__ArrayIter`.
function source_named_diag(d: util.Diag, mangled: util.NameIndex): util.Diag {
  let related: util.Related[] = [];
  for r in d.related {
    related = related.append(util.Related { ...r, message: util.demangle_named(r.message, mangled) });
  }
  return util.Diag { ...d, message: util.demangle_named(d.message, mangled), related: related };
}

// imported_decl_names is every bundle name an imported module's declaration
// carries; an entry-module name is never mangled, whatever it contains.
function imported_decl_names(mod: parser.Module): string[] {
  let out: string[] = [];
  for fd in mod.funcs {
    out = with_mangled(out, fd.name, fd.module);
  }
  for sd in mod.structs {
    out = with_mangled(out, sd.name, sd.module);
  }
  for ed in mod.enums {
    out = with_mangled(out, ed.name, ed.module);
  }
  for a in mod.aliases {
    out = with_mangled(out, a.name, a.module);
  }
  for sight in mod.sights {
    for td in mod.trait_decls {
      out = with_mangled(out, td.name, sight.module);
    }
  }
  return out;
}

function with_mangled(out: string[], name: string, prefix: string): string[] {
  if (util.str_has_prefix(name, util.ENTRY_SHADOW_PREFIX)) {
    return out.append(name);
  }
  if (prefix.len() == 0 || !util.str_has_prefix(name, prefix + "__")) {
    return out;
  }
  return out.append(name);
}

function checked_module(raw_mod: parser.Module, entry_file: string, raw_floor: boolean): ModuleTypes {
  let (filled, fda_diags) = parser.fill_default_args_with_diags(raw_mod);
  let mod = prepared_module(filled);
  let reserved = reserved_name_diags(mod);
  if (reserved.len() > 0) {
    let no_sigs: FuncSig[] = [];
    let no_tys: typeinfo.Type[] = [];
    return ModuleTypes { sigs: no_sigs, top_tys: no_tys, all_well_typed: false, diags: reserved };
  }
  let env = admission_env(mod, entry_file, raw_floor);
  mod = qualify_variants_in(mod, env, whole_focus(mod));
  let mt = check_module_pass(mod, env, fda_diags, []);
  if (mt.diags.len() > 0) {
    return mt;
  }
  let clones = instantiated_clones(mod, env);
  if (clones.len() == 0) {
    return mt;
  }
  let funcs = mod.funcs;
  let names: string[] = [];
  for cl in clones {
    funcs = funcs.append(cl);
    names = names.append(cl.name);
  }
  let cmod = parser.Module { ...mod, funcs: funcs };
  let rt = check_module_pass(cmod, admission_env(cmod, entry_file, raw_floor), [], names);
  if (rt.diags.len() == 0) {
    return mt;
  }
  return ModuleTypes { ...mt, all_well_typed: false, diags: rt.diags };
}

function in_focus(focus: util.NameIndex, fd: parser.FuncDecl): boolean {
  return focus.names.len() == 0 || focus.find(fd.name) >= 0;
}

function prepared_module(filled: parser.Module): parser.Module {
  let revalued = pretype_module(settle_literal_locals(filled));
  return parser.Module { ...revalued, structs: parser.inject_builtin_enums(revalued.structs) };
}

function check_module_pass(mod: parser.Module, env: ModuleEnv, fda_diags: util.Diag[], focus_names: string[]): ModuleTypes {
  let focus = util.name_index(focus_names);
  let imports = env.imports;
  let rnames = env.structs.resources.names;
  let st = env.sigs;
  let stt = env.structs;
  let ut = env.unions;
  let methods = env.methods;
  let sigs = st.sigs;
  let structs = stt.structs;
  let unions = ut.unions;
  let union_names = ut.index.names;
  let well_typed = true;
  if (!validate_union_sigs(unions, stt.index.names)) {
    well_typed = false;
  }
  let body_diags: util.Diag[] = [];
  let ambig = ambiguous_variants(ut);
  let mc_on = mc_any_marked(mod.structs, mod.enums);
  let (derive_diags, derive_keys) = e021_derive_field_diags(mod);
  let call_impls = env.impls;
  let slc_functions: SlcFunction[] = [];
  let slc_sums: ViewSum[] = [];
  for cfn in mod.funcs {
    let cscope = build_func_scope(cfn, st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
    let cparams = view_positions(cfn);
    slc_functions = slc_functions.append(SlcFunction { scope: cscope, params: cparams, fixed_strings: fixed_string_locals(cfn.body, cscope) });
    slc_sums = slc_sums.append(ViewSum { key: view_sum_key(cfn), flags: __alloc_bool(cparams.len()), fresh: false });
  }
  let slc_ix = view_index(slc_sums);
  let slc_calls: util.NameIndex[] = [];
  for cfn in mod.funcs {
    slc_calls = slc_calls.append(util.name_index(slc_call_names(cfn)));
  }
  let slc_fn_names: string[] = [];
  for cfn in mod.funcs {
    slc_fn_names = slc_fn_names.append(cfn.name);
  }
  let slc_names = util.name_index(slc_fn_names);
  let slc_changed_at = util.minus_ones(mod.funcs.len());
  let slc_walked = util.minus_ones(mod.funcs.len());
  let slc_order = slc_callee_order(slc_calls, slc_names);
  let slc_clock = 0;
  let slc_again = true;
  while (slc_again) {
    slc_again = false;
    for sj in slc_order {
      if (slc_walked[sj] >= 0 && !slc_stale(slc_calls[sj], slc_names, slc_changed_at, slc_walked[sj])) {
        continue;
      }
      slc_clock += 1;
      slc_walked = slc_walked.with(sj, slc_clock);
      let sjw = slice_escape_diags(mod.funcs[sj], slc_functions[sj], slc_sums, slc_ix);
      let slc_positions = slc_functions[sj].params;
      let slc_cur = slc_sums[sj];
      let slc_next = slc_cur.flags;
      let slc_changed = false;
      let sp = 0;
      while (sp < slc_positions.len() && sp < slc_next.len()) {
        if (!slc_next[sp] && name_in(slc_positions[sp], sjw.viewed)) {
          slc_next = slc_next.with(sp, true);
          slc_changed = true;
        }
        sp += 1;
      }
      let slc_fresh = slc_cur.fresh;
      if (!slc_fresh && sjw.owns) {
        slc_fresh = true;
        slc_changed = true;
      }
      if (slc_changed) {
        slc_clock += 1;
        slc_changed_at = slc_changed_at.with(slc_names.find(mod.funcs[sj].name), slc_clock);
        slc_again = true;
      }
      slc_sums = slc_sums.with(sj, ViewSum { key: slc_cur.key, flags: slc_next, fresh: slc_fresh });
    }
  }
  let const_inits = const_init(mod);
  let i = 0;
  while (i < mod.funcs.len()) {
    if (!in_focus(focus, mod.funcs[i]) || derive_body_suppressed(mod.funcs[i], derive_keys)) {
      i += 1;
      continue;
    }
    let fsc = slc_functions[i].scope;
    if (!check_func_body(mod.funcs[i], fsc)) {
      well_typed = false;
    }
    let dbody = mod.funcs[i].body;
    let function_diags: util.Diag[] = [];
    if (mod.funcs[i].ret_type == "void") {
      function_diags = util.append_diags(function_diags, void_ret_diags(dbody, fsc, unions));
    } else if (mod.funcs[i].ret_type.len() > 0) {
      let rty = fsc.ret_type;
      let rname = mod.funcs[i].ret_type;
      if (is_unknown(rty) && util.index_of_str(fsc.tparams, rname) < 0 && e064_unknown_bare(rname, fsc.type_names())) {
        rty = typeinfo.TypeStruct { name: rname, args: [] };
      }
      if (mod.funcs[i].is_const && mod.funcs[i].receiver_type.len() == 0) {
        function_diags = util.append_diags(function_diags, const_value_diags(mod.funcs[i], fsc, rty, unions));
      } else {
        function_diags = util.append_diags(function_diags, ret_diags(dbody, fsc, rty, unions));
      }
      if (mod.funcs[i].import_iface.len() == 0 && !block_exits(mod.funcs[i].body, fsc.defines("exit"))) {
        function_diags = function_diags.append(dg_at("E052", "missing return: \"" + mod.funcs[i].name + "\" has return type " + mod.funcs[i].ret_type + " but can fall off the end without returning a value", mod.funcs[i].line, mod.funcs[i].col));
      }
    }
    if (mod.funcs[i].ret_type.len() == 0 && mod.funcs[i].receiver_type.len() == 0
      && mod.funcs[i].all_type_params.len() == 0 && !mod.funcs[i].is_const
      && mod.funcs[i].import_iface.len() == 0 && !block_exits(dbody, fsc.defines("exit"))) {
      let inferred = exit_result(dbody, fsc);
      if (!is_unknown(inferred) && !is_void(inferred)) {
        function_diags = function_diags.append(dg_at("E052", "missing return: \"" + mod.funcs[i].name + "\" has return type " + type_label(inferred) + " but can fall off the end without returning a value", mod.funcs[i].line, mod.funcs[i].col));
      }
    }
    if (returns_view_or_holder(mod.funcs[i], fsc)) {
      function_diags = util.append_diags(function_diags, slice_escape_diags(mod.funcs[i], slc_functions[i], slc_sums, slc_ix).diags);
    }
    if (mc_on) {
      function_diags = util.append_diags(function_diags, must_consume_diags(mod.funcs[i], fsc, mod.structs, mod.enums));
    }
    function_diags = util.append_diags(function_diags, lret_stmts(dbody, fsc, unions));
    function_diags = util.append_diags(function_diags, mx_stmts(dbody, fsc, unions, mod.enums));
    function_diags = util.append_diags(function_diags, stmts_slit_diags(dbody, stt));
    function_diags = util.append_diags(function_diags, stmts_call_diags(dbody, fsc));
    function_diags = util.append_diags(function_diags, unsafe_stmts(dbody, fsc, fsc.sigs.raw_allowed));
    function_diags = util.append_diags(function_diags, stmts_assign_diags(dbody, fsc, unions));
    function_diags = util.append_diags(function_diags, loop_diags(dbody, false, []));
    function_diags = util.append_diags(function_diags, dupvar_diags(dbody));
    function_diags = util.append_diags(function_diags, suffix_range_stmts(dbody));
    function_diags = util.append_diags(function_diags, match_diags(dbody, stt, ut));
    let pdi = 0;
    while (pdi < mod.funcs[i].params.len()) {
      if (mod.funcs[i].params[pdi].has_default) {
        function_diags = util.append_diags(function_diags, keep_code(mx_expr(mod.funcs[i].params[pdi].default_value, new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs), unions, mod.enums), "P002"));
      }
      pdi += 1;
    }
    let pai2 = 0;
    while (pai2 < mod.funcs[i].params.len()) {
      function_diags = util.append_diags(function_diags, type_arity_diag(mod.funcs[i].params[pai2].type_name, mod.structs, mod.enums));
      pai2 += 1;
    }
    function_diags = util.append_diags(function_diags, type_arity_diag(mod.funcs[i].ret_type, mod.structs, mod.enums));
    for annot in collect_annots(mod.funcs[i].body) {
      function_diags = util.append_diags(function_diags, type_arity_diag(annot.type_name, mod.structs, mod.enums));
    }
    if (ambig.len() > 0) {
      function_diags = util.append_diags(function_diags, vref_stmts(dbody, fsc, ambig));
    }
    function_diags = util.append_diags(function_diags, deferred_const_diags(mod.funcs[i], const_inits, function_diags));
    body_diags = util.append_diags(body_diags, body_source_order(function_diags));
    i += 1;
  }
  let s = new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
  let top_tys: typeinfo.Type[] = [];
  for top_stmt in mod.top_stmts {
    let r = check_stmt(top_stmt, s);
    s = r.scope;
    if (is_unknown(r.ty)) {
      well_typed = false;
    }
    top_tys = top_tys.append(r.ty);
  }
  let dtop = mod.top_stmts;
  let tsc = new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
  body_diags = util.append_diags(body_diags, lret_stmts(dtop, tsc, unions));
  body_diags = util.append_diags(body_diags, mx_stmts(dtop, tsc, unions, mod.enums));
  body_diags = util.append_diags(body_diags, stmts_slit_diags(dtop, stt));
  body_diags = util.append_diags(body_diags, stmts_call_diags(dtop, tsc));
  body_diags = util.append_diags(body_diags, unsafe_stmts(dtop, tsc, tsc.sigs.raw_allowed));
  body_diags = util.append_diags(body_diags, unsafe_impl_diags(mod));
  body_diags = util.append_diags(body_diags, stmts_assign_diags(dtop, tsc, unions));
  if (ambig.len() > 0) {
    body_diags = util.append_diags(body_diags, vref_stmts(dtop, tsc, ambig));
  }
  body_diags = util.append_diags(body_diags, loop_diags(dtop, false, []));
  body_diags = util.append_diags(body_diags, dupvar_diags(dtop));
  body_diags = util.append_diags(body_diags, suffix_range_stmts(dtop));
  body_diags = util.append_diags(body_diags, match_diags(dtop, stt, ut));
  if (is_script(mod)) {
    body_diags = util.append_diags(body_diags, ret_diags(dtop, tsc, t_i32(), unions));
  }
  for sd in mod.structs {
    for field in sd.fields {
      body_diags = util.append_diags(body_diags, type_arity_diag(field.type_name, mod.structs, mod.enums));
    }
  }
  let signature_diags: util.Diag[] = [];
  let e064_extra: string[] = [];
  let e064_traits: string[] = [];
  for trait_req in mod.trait_reqs {
    e064_extra = e064_extra.append(trait_req.trait_name);
    e064_traits = e064_traits.append(trait_req.trait_name);
    if (trait_req.module.len() > 0) {
      e064_traits = e064_traits.append(trait_req.module + "__" + trait_req.trait_name);
    }
  }
  for imp in mod.impls {
    e064_extra = e064_extra.append(imp.trait_name);
  }
  for resource in mod.resources {
    e064_extra = e064_extra.append(resource.name);
  }
  let e064_tn = TypeNames { ...with_spellings(type_names(declared_struct_names(mod.structs), union_names, rnames), mod), unloaded: util.name_index(unloaded_qualifiers(mod)) };
  for efn in mod.funcs {
    if (in_focus(focus, efn) && efn.receiver_name.len() == 0) {
      let efn_tps = e064_fn_tparams(efn);
      for param in efn.params {
        let pu = e064_unknown_name(e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), e064_tn, e064_extra, efn_tps);
        if (pu.len() > 0) {
          let (pl, pc) = param_pos(param, efn.line, efn.col);
          signature_diags = signature_diags.append(unknown_type_diag(pu, e064_traits, pl, pc));
        }
      }
      let ru = e064_unknown_name(e064_decl_spelling(efn.ret_type, efn.ret_fn_ret, efn.ret_fn_param_types), e064_tn, e064_extra, efn_tps);
      if (ru.len() > 0) {
        signature_diags = signature_diags.append(unknown_type_diag(ru, e064_traits, efn.line, efn.col));
      }
      let efn_annots = collect_annots(efn.body);
      signature_diags = util.append_diags(signature_diags, e064_annot_diags(efn_annots, e064_tn, e064_extra, efn_tps, e064_traits));
    }
    if (in_focus(focus, efn)) {
      signature_diags = util.append_diags(signature_diags, e057_fn_diags(efn, tsc));
    }
  }
  signature_diags = util.append_diags(signature_diags, handle_type_diags(mod, focus, e064_tn));
  signature_diags = util.append_diags(signature_diags, const_kind_module_diags(mod, focus));
  let e044_void_fns: string[] = [];
  for func in mod.funcs {
    if (func.receiver_name.len() == 0 && func.ret_type == "void") {
      e044_void_fns = e044_void_fns.append(func.name);
    }
  }
  for func in mod.funcs {
    if (in_focus(focus, func)) {
      body_diags = util.append_diags(body_diags, e044_diags(func, e044_void_fns));
    }
  }
  let fip_names: string[] = [];
  let fbip_names: string[] = [];
  let str_ret_names: string[] = [];
  for func in mod.funcs {
    if (func.fip) {
      fip_names = fip_names.append(func.name);
    }
    if (func.fbip) {
      fbip_names = fbip_names.append(func.name);
    }
    if (func.ret_type == "str") {
      str_ret_names = str_ret_names.append(func.name);
    }
  }
  let e053_variants: string[] = [];
  for union in unions {
    for variant in union.variants {
      e053_variants = e053_variants.append(variant);
    }
  }
  let e065_fns: parser.FuncDecl[] = [];
  let e065_scopes: Scope[] = [];
  let e065_sums: ViewSum[] = [];
  for sfi in 0..mod.funcs.len() {
    let sfn = mod.funcs[sfi];
    if (e065_summarised(sfn, slc_functions[sfi].scope)) {
      e065_fns = e065_fns.append(sfn);
      e065_scopes = e065_scopes.append(slc_functions[sfi].scope);
      e065_sums = e065_sums.append(ViewSum { key: view_sum_key(sfn), flags: __alloc_bool(view_positions(sfn).len()), fresh: false });
    }
  }
  let e065_ix = view_index(e065_sums);
  let e065_changed = true;
  while (e065_changed) {
    e065_changed = false;
    let si = 0;
    while (si < e065_fns.len()) {
      let sw = e065_diags(e065_fns[si], str_ret_names, e065_sums, e065_ix, e065_scopes[si]);
      let positions = view_positions(e065_fns[si]);
      let cur_sum = e065_sums[si];
      let next_flags = cur_sum.flags;
      let pi = 0;
      while (pi < positions.len() && pi < next_flags.len()) {
        if (!next_flags[pi] && e065_ident_in(positions[pi], sw.viewed)) {
          next_flags = next_flags.with(pi, true);
          e065_changed = true;
        }
        pi += 1;
      }
      let e065_fresh = cur_sum.fresh;
      if (!e065_fresh && sw.owns) {
        e065_fresh = true;
        e065_changed = true;
      }
      e065_sums = e065_sums.with(si, ViewSum { key: cur_sum.key, flags: next_flags, fresh: e065_fresh });
      si += 1;
    }
  }
  for xfn in mod.funcs {
    if (!in_focus(focus, xfn)) {
      continue;
    }
    let xsc = build_func_scope(xfn, st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
    for param in xfn.params {
      let (pl, pc) = param_pos(param, xfn.line, xfn.col);
      body_diags = util.append_diags(body_diags, e045_annot_diags(param.type_name, pl, pc, xsc));
    }
    body_diags = util.append_diags(body_diags, e045_annot_diags(xfn.ret_type, xfn.line, xfn.col, xsc));
    for an in lambda_annots(xfn.body) {
      body_diags = util.append_diags(body_diags, e045_annot_diags(an.type_name, an.line, an.col, xsc));
    }
    if (xfn.fip || xfn.fbip) {
      body_diags = util.append_diags(body_diags, e053_diags(xfn, util.append_all(fip_names, fip_builtin_callees(mod.funcs)), fbip_names, e053_variants, xsc));
    }
    if (e065_checked(xfn, xsc)) {
      body_diags = util.append_diags(body_diags, e065_diags(xfn, str_ret_names, e065_sums, e065_ix, xsc).diags);
    }
  }
  let fld_scope = new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
  for esd in mod.structs {
    for field in esd.fields {
      let (fl, fc) = field_pos(field, esd.line, esd.col);
      body_diags = util.append_diags(body_diags, e045_annot_diags(field.type_name, fl, fc, fld_scope));
    }
  }
  for esd in mod.structs {
    if (esd.type_params.len() == 0 && esd.enum_owner.len() == 0) {
      for field in esd.fields {
        let fu = e064_unknown_name(e064_decl_spelling(field.type_name, field.fn_ret, field.fn_param_types), e064_tn, e064_extra, esd.type_params);
        if (fu.len() > 0) {
          let (fl, fc) = field_pos(field, esd.line, esd.col);
          body_diags = body_diags.append(unknown_type_diag(fu, e064_traits, fl, fc));
        }
      }
    }
    body_diags = util.append_diags(body_diags, e057_struct_diags(esd, mod.enums, fld_scope));
  }
  body_diags = util.append_diags(body_diags, e085_decl_diags(mod, focus, e064_tn));
  let cgd = const_inits.diags;
  if (cgd.len() > 0) {
    return ModuleTypes { sigs: sigs, top_tys: top_tys, all_well_typed: false, diags: cgd };
  }
  let decl_diags: util.Diag[] = [];
  if (focus_names.len() == 0) {
    decl_diags = util.append_diags(util.append_diags(collect_decl_diags(mod), util.append_diags(orphan_impl_diags(mod), util.append_diags(e021_diags(mod), bound_decl_diags(mod)))), derive_diags);
  }
  let leading = util.append_diags(fda_diags, decl_diags);
  leading = util.append_diags(leading, signature_diags);
  leading = util.append_diags(leading, e021_object_safety_diags(mod, focus));
  leading = util.append_diags(leading, e021_unknown_dyn_trait_diags(mod, focus));
  let dd = thin_map_import_diags(util.append_diags(util.append_diags(util.append_diags(leading, body_diags), own_diags(mod, env, focus)), util.append_diags(e049_diags(mod, env, focus), e060_e062_diags(mod, focus))));
  if (dd.len() > 0) {
    well_typed = false;
  }
  return ModuleTypes { sigs: sigs, top_tys: top_tys, all_well_typed: well_typed, diags: dd };
}

function body_source_order(diags: util.Diag[]): util.Diag[] {
  let out: util.Diag[] = [];
  let exits: util.Diag[] = [];
  for d in diags {
    if (d.code == "E052") {
      exits = exits.append(d);
    } else {
      out = out.append(d);
      let i = out.len() - 1;
      while (i > 0 && (out[i].line < out[i - 1].line || out[i].line == out[i - 1].line && out[i].col < out[i - 1].col)) {
        let previous = out[i - 1];
        out = out.with(i - 1, out[i]).with(i, previous);
        i -= 1;
      }
    }
  }
  return util.append_diags(out, exits);
}

pub struct ModuleEnv { sigs: SigTable, structs: StructTable, unions: UnionTable, methods: MethodTable, imports: Imports, impls: parser.ImplInfo[], trait_reqs: parser.TraitReq[] }

function module_env(mod: parser.Module): ModuleEnv {
  return module_env_with_file(mod, "");
}

function module_env_with_file(mod: parser.Module, entry_file: string): ModuleEnv {
  let rnames = resource_names(mod);
  let structs = collect_struct_sigs(parser.inject_builtin_enums(mod.structs), declared_union_names(mod), rnames);
  let unions = collect_union_sigs(mod);
  for ed in mod.enums {
    unions = unions.append(enum_union_sig(ed));
  }
  let union_names = union_sig_names(unions);
  let tn = with_spellings(type_names(type_head_names(structs, union_names), union_names, rnames), mod);
  let sigs = collect_func_sigs(mod.funcs, tn);
  let methods = collect_method_sigs(mod.funcs, tn);
  if (entry_file.len() > 0) {
    let named: MethodSig[] = [];
    for m in methods {
      if (m.file.len() == 0 && m.line > 0) {
        named = named.append(MethodSig { ...m, file: entry_file + ":" });
      } else {
        named = named.append(m);
      }
    }
    methods = named;
  }
  return ModuleEnv {
    sigs: sig_table(sigs),
    structs: struct_table(structs, union_names, rnames, tn.spellings),
    unions: union_table(unions),
    methods: method_table(methods),
    imports: module_imports(mod),
    impls: assoc_func_impls(mod.impls, mod.funcs),
    trait_reqs: mod.trait_reqs,
  };
}

pub function expr_type(e: ast.Expr, s: Scope): typeinfo.Type {
  return check_expr(e, s);
}

pub function binary_types(b: ast.ExprBinary, s: Scope): (typeinfo.Type, typeinfo.Type, typeinfo.Type) {
  let lt = check_expr(b.left, s);
  let rt = check_expr(b.right, s);
  if (b.op == "__named_arg") {
    return (rt, lt, rt);
  }
  return (binary_result_type(b, lt, rt, s), lt, rt);
}

pub function scope_type(s: Scope, name: string): typeinfo.Type {
  return s.lookup(name);
}

pub function func_type_params(s: Scope, name: string): string[] {
  if let Some(sig) = s.lookup_sig(name) {
    return sig.all_type_params;
  }
  let dot = name.len() - 1;
  while (dot > 0 && name[dot] != b'.') {
    dot -= 1;
  }
  if (dot <= 0) {
    return [];
  }
  if let Some(msig) = s.lookup_method(slice_unchecked(name, dot + 1, name.len()) + "", slice_unchecked(name, 0, dot) + "") {
    return msig.all_type_params;
  }
  return [];
}

pub function spelled_type(s: Scope, spelling: string): typeinfo.Type {
  return s.resolve_type(spelling);
}

pub function signature_receiver(s: Scope, sig: FuncSig): typeinfo.Type {
  return type_from_name_erasing_tparams(sig.receiver, sig.all_type_params, s.type_names());
}

pub function struct_sig(s: Scope, name: string): Option[StructSig] {
  return s.lookup_struct(name);
}

pub function struct_type_params(s: Scope, name: string): string[] {
  return match (s.lookup_struct(name)) { Some(sig) => sig.type_params, None => [] };
}

pub function struct_field_names(s: Scope, name: string): string[] {
  return match (s.lookup_struct(name)) { Some(sig) => sig.field_names, None => [] };
}

pub function variant_owner_of(s: Scope, name: string): string {
  return scope_variant_owner(name, s);
}

pub function variant_sig(s: Scope, name: string, owner: string): Option[StructSig] {
  let Some(sig) = s.lookup_owned_struct(name, owner) else {
    return None;
  };
  if (sig.enum_owner != owner) {
    return None;
  }
  return Some(sig);
}

pub function instantiated_variant(sig: StructSig, s: Scope, whole: typeinfo.Type): StructSig {
  if let typeinfo.TypeUnion(u) = whole {
    let params = union_type_params(s, u.name);
    if (sig.enum_owner == u.name && params.len() > 0 && params.len() == u.args.len()) {
      let types: typeinfo.Type[] = [];
      for spelling in sig.field_type_names {
        types = types.append(type_from_ref_subst(parser.parse_type_ref(spelling), params, u.args, s.type_names()));
      }
      return StructSig { ...sig, field_types: types };
    }
  }
  return sig;
}

pub function union_sig(s: Scope, name: string): Option[UnionSig] {
  return s.lookup_union(name);
}

pub function union_module(s: Scope, name: string): string {
  if let Some(u) = s.lookup_union(name) {
    return u.module;
  }
  return "";
}

pub function union_type_params(s: Scope, name: string): string[] {
  if let Some(u) = s.lookup_union(name) {
    return u.type_params;
  }
  return [];
}

pub function owned_variant_names(s: Scope, owner: string): string[] {
  let out: string[] = [];
  if (owner.len() == 0) {
    return out;
  }
  for sig in s.structs.structs {
    if (sig.enum_owner == owner) {
      out = out.append(sig.name);
    }
  }
  return out;
}

pub function variant_shape_sig(s: Scope, name: string, owner: string): Option[StructSig] {
  if let Some(owned) = s.lookup_owned_struct(name, owner) {
    if (owned.enum_owner == owner) {
      return Some(owned);
    }
  }
  if let Some(plain) = s.lookup_struct(name) {
    if (plain.enum_owner.len() == 0 && is_variant_of(name, owner, s.unions.unions)) {
      return Some(plain);
    }
  }
  return None;
}

// An earlier return exits the function and does not determine the block type.
// Integer literal tails retain their polymorphic type for the receiver.
function value_block_tail_type(body: ast.Stmt[], s: Scope): typeinfo.Type {
  if (body.len() == 0) {
    return t_unknown("empty value block");
  }
  if let ast.StmtUnknown(u) = body[body.len() - 1] {
    if (u.kind == "value branch has no trailing expression") {
      return t_unknown("missing block value");
    }
  }
  if (parser.branch_exits_early(body)) {
    return typeinfo.TypeNever { tag: 0 };
  }
  if let ast.StmtReturn(r) = body[body.len() - 1] {
    if (parser.bare_return(r.value)) {
      return t_unknown("value block tail");
    }
    let bs = s;
    let i = 0;
    while (i < body.len() - 1) {
      bs = bind_stmt(body[i], bs);
      i += 1;
    }
    let t = check_expr(r.value, bs);
    if (int_literal_tree(r.value)) {
      return unsettled_marked(t, r.value, bs.lit_locals, true);
    }
    if (!names_whole_type(t, bs)) {
      return t_unknown("value block tail");
    }
    return t;
  }
  return t_unknown("value block tail");
}

pub function first_returned(body: ast.Stmt[], scope: Scope): (ast.Expr, Scope) {
  let none: ast.Expr = ast.ExprUnknown { kind: parser.BARE_RETURN, line: 0, col: 0 };
  for st in body {
    match (st) {
      ast.StmtReturn(r) => {
        if (!parser.bare_return(r.value)) {
          return (r.value, scope);
        }
      },
      ast.StmtIf(f) => {
        let (t, ts) = first_returned(f.then_body, scope);
        if (!parser.bare_return(t)) {
          return (t, ts);
        }
        let (e, es) = first_returned(f.else_body, scope);
        if (!parser.bare_return(e)) {
          return (e, es);
        }
      },
      ast.StmtWhile(w) => {
        let (v, vs) = first_returned(w.body, scope);
        if (!parser.bare_return(v)) {
          return (v, vs);
        }
      },
      ast.StmtFor(fo) => {
        let (v, vs) = first_returned(fo.body, for_body_scope(fo, scope));
        if (!parser.bare_return(v)) {
          return (v, vs);
        }
      },
      ast.StmtMatch(m) => {
        let whole = expr_type(m.scrutinee, scope);
        for a in m.arms {
          let (v, vs) = first_returned(a.body, arm_scope(a, scope, whole));
          if (!parser.bare_return(v)) {
            return (v, vs);
          }
        }
      },
      _ => {}
    }
    scope = bind_stmt(st, scope);
  }
  return (none, scope);
}

pub function arm_scope(arm: ast.MatchArm, s: Scope, whole: typeinfo.Type): Scope {
  return annotate_arm_scope(arm, s, whole);
}

pub function module_scopes(mod: parser.Module): Scope[] {
  let v = QueryView { mod: mod, env: module_env(mod) };
  let out: Scope[] = [];
  for fd in mod.funcs {
    out = out.append(func_scope(v, fd));
  }
  return out.append(module_scope(v));
}

pub struct QueryView { mod: parser.Module, env: ModuleEnv }

pub function query_view(raw_mod: parser.Module): QueryView {
  let (filled, _) = parser.fill_default_args_with_diags(raw_mod);
  let mod = prepared_module(filled);
  return QueryView { mod: mod, env: module_env(mod) };
}

pub function func_scope(v: QueryView, fd: parser.FuncDecl): Scope {
  return build_func_scope(fd, v.env.sigs, v.env.structs, v.env.unions, v.env.methods, v.env.imports, v.env.impls, v.env.trait_reqs);
}

pub function module_scope(v: QueryView): Scope {
  return new_scope_full(v.env.sigs, v.env.structs, v.env.unions, v.env.methods, v.env.imports, v.env.impls, v.env.trait_reqs);
}

pub function func_sig(s: Scope, name: string): Option[FuncSig] {
  return s.lookup_sig(name);
}

pub function method_sig(s: Scope, name: string, recv: string): Option[MethodSig] {
  return s.lookup_method(name, recv);
}

pub function methods_on(s: Scope, recv: string): MethodSig[] {
  let out: MethodSig[] = [];
  for i in 0..s.methods.methods.len() {
    if (s.receives(i, recv)) {
      out = out.append(s.methods.methods[i]);
    }
  }
  return out;
}

pub function builtin_method_names(recv: string): string[] {
  let head = "__method_" + recv + "_";
  let out: string[] = [];
  for row in builtinsigs.builtin_sigs() {
    let open = util.index_of_sub(row, "(");
    if (open > head.len() && util.str_has_prefix(row, head)) {
      out = out.append(slice_unchecked(row, head.len(), open) + "");
    }
  }
  return out;
}

pub function array_method_names(s: Scope, view: boolean): string[] {
  let out: string[] = [];
  for method in s.methods.methods {
    if (array_receiver_matches(method.receiver_type, view) && !util.has_str(out, method.name)) {
      out = out.append(method.name);
    }
  }
  return out;
}

pub function enum_sig(s: Scope, name: string): Option[UnionSig] {
  if let Some(u) = s.lookup_union(name) {
    return Some(u);
  }
  return builtin_union_sig(name);
}

pub function variant_enum(s: Scope, name: string): string {
  let owner = scope_variant_owner(name, s);
  if (owner.len() > 0) {
    return owner;
  }
  return parser.builtin_enum_of(name);
}

pub function payload_slot(s: Scope, owner: string, name: string, k: i32): i32 {
  return ctor_payload_slot(s, owner, name, k);
}

struct UnknownSite { found: boolean, line: i32, col: i32, reason: string }

function unknown_site(stmts: ast.Stmt[], s: Scope): UnknownSite {
  let cur = s;
  for st in stmts {
    let r = check_stmt(st, cur);
    if let typeinfo.TypeUnknown(u) = r.ty {
      let inner = unknown_site_within(st, cur);
      if (inner.found) {
        return inner;
      }
      return UnknownSite { found: true, line: ast.stmt_line(st), col: ast.stmt_col(st), reason: u.reason };
    }
    cur = r.scope;
  }
  return UnknownSite { found: false, line: 0, col: 0, reason: "" };
}

function unknown_site_within(st: ast.Stmt, s: Scope): UnknownSite {
  let none = UnknownSite { found: false, line: 0, col: 0, reason: "" };
  match (st) {
    ast.StmtIf(f) => {
      let t = unknown_site(f.then_body, s);
      if (t.found) {
        return t;
      }
      return unknown_site(f.else_body, s);
    },
    ast.StmtWhile(w) => {
      return unknown_site(w.body, s.enter_loop());
    },
    ast.StmtFor(fo) => {
      return unknown_site(fo.body, for_body_scope(fo, s));
    },
    ast.StmtMatch(m) => {
      let whole = check_expr(m.scrutinee, s);
      for arm in m.arms {
        let a = unknown_site(arm.body, annotate_arm_scope(arm, s, whole));
        if (a.found) {
          return a;
        }
      }
    },
    ast.StmtDefer(d) => {
      return unknown_site_within(d.action, s);
    },
    _ => {}
  }
  return none;
}

pub function ill_typed_hint(raw_mod: parser.Module): util.Diag[] {
  let (filled, _) = parser.fill_default_args_with_diags(raw_mod);
  let prepared = prepared_module(filled);
  let env = module_env(prepared);
  let mod = qualify_variants_in(prepared, env, whole_focus(prepared));
  for func in mod.funcs {
    let fs = build_func_scope(func, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
    if (!check_func_body(func, fs)) {
      let site = unknown_site(func.body, fs);
      if (site.found) {
        return [untyped_code(site.line, site.col, "this statement in \"" + func.name + "\" (" + site.reason + ")")];
      }
      return [untyped_code(func.line, func.col, "the body of \"" + func.name + "\"")];
    }
  }
  let s = new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  for top_stmt in mod.top_stmts {
    let r = check_stmt(top_stmt, s);
    s = r.scope;
    if let typeinfo.TypeUnknown(u) = r.ty {
      return [untyped_code(ast.stmt_line(top_stmt), ast.stmt_col(top_stmt), "this top-level statement (" + u.reason + ")")];
    }
  }
  return [dg_at("", "internal error: the checker rejected this module without a diagnostic; this is a compiler bug, please report it", 0, 0)];
}

function untyped_code(line: i32, col: i32, what: string): util.Diag {
  if (col <= 0) {
    col = 1;
  }
  return dg_at("", "internal: the checker could not type " + what + " and has no diagnostic for it; this is a compiler bug, please report it", line, col);
}

function main(): i32 {
  let src1 = "let a = 1 + 2 * 3; let b = \"hi\" + \" there\"; let c = a < 10; let d = !c; return a + 1;";
  let toks1 = lexer.tokenize(src1);
  let stmts1 = parser.parse_program(toks1);
  let pt1 = check_program(stmts1);
  if (pt1.tys.len() != 5) {
    return 1;
  }
  if (!type_eq(pt1.tys[0], t_i32())) {
    return 10;
  }
  if (!type_eq(pt1.tys[1], t_string())) {
    return 11;
  }
  if (!type_eq(pt1.tys[2], t_bool())) {
    return 12;
  }
  if (!type_eq(pt1.tys[3], t_bool())) {
