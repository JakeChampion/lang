// compiler/checker.fern — the type checker every `fern` command runs. It
// resolves a parsed module's declarations, types every expression and
// statement, reports the coded diagnostics (E0NN), and hands the types it
// settles to the typed lowering. internal/check/checker is the Go oracle the
// differential tests hold it to.
import "./ast";
import "./util";
import "./lexer";
import "./parser";
import "./astwalk";
import "./typeinfo";
import "./decltypes";
import "./semtypes";
import "./stdlib_methods";

// =================== TYPE SYSTEM ====================
// Semantic type definitions live in typeinfo, shared with typed consumers.

// Helper wraps: same pattern as elsewhere in the port — putting
// the struct literal in return-position lets the implicit
// struct→union wrap fire. Inline `let t: Type = TypeI32 { ... };`
// inside a non-return position doesn't always trigger the wrap.
function t_i32(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 32, unsigned: false, polymorphic: false };
}

function t_i64(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 64, unsigned: false, polymorphic: false };
}

function t_u32(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 32, unsigned: true, polymorphic: false };
}

function t_u64(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 64, unsigned: true, polymorphic: false };
}

// The pointer-width unsigned integer, an address: what native's WidthPtr
// spells, resolved by each backend.
function t_usize(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: typeinfo.width_ptr(), unsigned: true, polymorphic: false };
}

function is_usize(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(i) => {
      return i.width == typeinfo.width_ptr() && !i.is_char;
    },
    _ => {
      return false;
    }
  }
}

function t_u8(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 8, unsigned: true, polymorphic: false };
}

// `char` — a Unicode scalar value in an i32 slot (#5629). Width 32 because
// that is the slot it occupies; `is_char` is what distinguishes it.
function t_char(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: true, width: 32, unsigned: false, polymorphic: false };
}

// lit_is_scalar_value reports whether an integer literal's SOURCE TEXT names a
// Unicode scalar value — 0..0x10FFFF minus the UTF-16 surrogates D800..DFFF.
// Drives E071 on `<lit> as char` (#5629 slice 5).
//
// util.lit_to_i32 accumulates in i32, so a literal past 2^31 wraps and could
// land back inside the range. The digit-count guard runs FIRST for that
// reason: any decimal longer than 7 digits, or hex longer than 6, already
// exceeds 0x10FFFF, so it is rejected without trusting the wrapped value.
function lit_is_scalar_value(text: string): boolean {
  let off: i32 = 0;
  if (text.len() > 0 && text[0] == b'-') {
    off = 1;
  }
  let digits: i32 = text.len() - off;
  let is_hex: boolean = digits > 1 && text[off] == b'0' && (text[off + 1] == b'x' || text[off + 1] == b'X');
  if (is_hex) {
    if (digits - 2 > 6) {
      return false;
    }
  } else {
    if (digits > 7) {
      return false;
    }
  }
  let v: i32 = util.lit_to_i32(text);
  if (v < 0 || v > 1114111) {
    return false;
  }
  if (v >= 55296 && v <= 57343) {
    return false;
  }
  return true;
}

// lit_scalar_msg mirrors the Go checker's E071 wording, including the
// surrogate clause, so the differential compares equal on message as well as
// code.
function lit_scalar_msg(text: string): string {
  let v: i32 = util.lit_to_i32(text);
  let hint: string = "";
  if (v >= 55296 && v <= 57343) {
    hint = " (this is a surrogate)";
  }
  return util.i32_to_string(v) + " is not a Unicode scalar value, so it cannot be cast to `char`: the range is 0..0x10FFFF excluding the surrogates 0xD800..0xDFFF" + hint + " — use `utf8.char_from_i32` for a value that is only known at run time";
}

// int_label recovers the source spelling of an integer TypeI32 from its
// (width, unsigned) so method dispatch + diagnostics name the right type.
// int_label is this checker's methodTypeName: the width-aware name a
// method on an integer receiver is registered and looked up under. The
// width-8 arm must come before the u32 fallback — std/i32's 21 ascii
// classifiers are declared on `u8` (#5629), and labelling a byte "u32"
// registered them under one name while calls looked them up under
// another, so every classifier call reported a spurious E043.
function int_label(t: typeinfo.TypeI32): string {
  // `char` before the width ladder: it occupies a 32-bit slot but registers and
  // dispatches its methods under "char" (std/unicode's seven), so labelling
  // it "i32" would look up a key nothing declares (#5629) — the same
  // register-here / look-up-there skew that took std/string off the IR path
  // for `u8` in #5886.
  if (t.is_char) {
    return "char";
  }
  if (t.unsigned) {
    if (t.width == 64) {
      return "u64";
    }
    if (t.width == 8) {
      return "u8";
    }
    if (t.width == typeinfo.width_ptr()) {
      return "usize";
    }
    return "u32";
  }
  if (t.width == 64) {
    return "i64";
  }
  return "i32";
}

function t_bool(): typeinfo.Type {
  return typeinfo.TypeBool { tag: 0 };
}

function t_string(): typeinfo.Type {
  return typeinfo.TypeString { tag: 0 };
}

// `str` — the borrowed-string view (#4813). tag 1 marks the view. type_eq, type_to_irtag and method dispatch stay
// tag-blind — a view IS a string box everywhere but at an owning sink, which
// is the one place type_assignable reads the tag (#7293).
function t_str(): typeinfo.Type {
  return typeinfo.TypeString { tag: 1 };
}

function is_str_view(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeString(st) => {
      return st.tag == 1;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_owned_string(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeString(st) => {
      return st.tag == 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// str_copy_hint mirrors native strCopyHint: the remedy suffix when a borrowed
// `str` view reaches an owning `string` sink. Empty for any other pair, so it
// only fires where it applies.
function str_copy_hint(from: typeinfo.Type, to: typeinfo.Type): string {
  if (is_str_view(from) && is_owned_string(to)) {
    return " — `str` is a borrowed view of a string; add `.to_owned()` to copy it into an owned string";
  }
  return "";
}

// view_arg_borrow mirrors native argAssignable's carve-outs: params are
// borrowed by default, so a `str` view may flow into a `string` PARAMETER, and
// an owned `T[]` lends into a `[T]` parameter of the same element type, or
// of an erased type parameter's (isArrayViewLend) — and nowhere else.
function view_arg_borrow(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if (is_str_view(from) && is_owned_string(to)) {
    return true;
  }
  if let typeinfo.TypeArray(fa) = from {
    if let typeinfo.TypeArray(ta) = to {
      return !fa.view && ta.view && (type_eq(fa.elem, ta.elem) || is_unknown(ta.elem));
    }
  }
  return false;
}

function t_float(): typeinfo.Type {
  return typeinfo.TypeFloat { width: 64, polymorphic: false };
}

function t_f32(): typeinfo.Type {
  return typeinfo.TypeFloat { width: 32, polymorphic: false };
}

// t_lanes is the lane type of element width `width`, 64 for f64x2 and 32 for
// f32x4.
function t_lanes(width: i32): typeinfo.Type {
  return typeinfo.TypeLanes { width: width };
}

function is_lanes(t: typeinfo.Type): boolean {
  if let typeinfo.TypeLanes(_) = t {
    return true;
  }
  return false;
}

function is_float(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFloat(f) = t {
    return true;
  }
  return false;
}

function is_poly_float(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFloat(f) = t {
    return f.polymorphic;
  }
  return false;
}

function float_label(t: typeinfo.TypeFloat): string {
  if (t.width == 32) {
    return "f32";
  }
  return "f64";
}

// A literal can adopt the other operand's width; concrete floats cannot.
function float_operands_agree(a: typeinfo.Type, b: typeinfo.Type): boolean {
  return is_float(a) && is_float(b) && (type_eq(a, b) || is_poly_float(a) || is_poly_float(b));
}

// A binary's operand types, with an unsettled integer literal on one side read
// at a concrete float on the other — native's settleNumeric before
// requireFloat, so `r * 2` and `r <= 0` hold for an f32 / f64 `r`.
function settled_operands(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): (typeinfo.Type, typeinfo.Type) {
  if (is_float(lt) && !is_poly_float(lt) && unsettled_int_literal(b.right)) {
    return (lt, lt);
  }
  if (is_float(rt) && !is_poly_float(rt) && unsettled_int_literal(b.left)) {
    return (rt, rt);
  }
  return (lt, rt);
}

function float_result(a: typeinfo.Type, b: typeinfo.Type): typeinfo.Type {
  if (!float_operands_agree(a, b)) {
    return t_unknown("float operands have incompatible widths");
  }
  if (is_poly_float(a)) {
    return b;
  }
  return a;
}

// is_poly_int: is `t` an integer a literal leaves unsettled?
function is_poly_int(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return i.polymorphic && !i.is_char;
  }
  return false;
}

// Merge literal commitments before default-width equality, including tuples.
// An unsettled integer takes a float sibling's type, as in unifyIfArms.
function join_result_types(a: typeinfo.Type, b: typeinfo.Type): typeinfo.Type {
  if (unbound_enum_argument(a)) {
    return b;
  }
  if (unbound_enum_argument(b)) {
    return a;
  }
  if (integer_literal_widens(a, b) || is_poly_int(a) && is_float(b)) {
    return b;
  }
  if (integer_literal_widens(b, a) || is_poly_int(b) && is_float(a)) {
    return a;
  }
  if let typeinfo.TypeI32(ai) = a {
    if let typeinfo.TypeI32(bi) = b {
      if (type_eq(a, b)) {
        return typeinfo.TypeI32 { ...ai, polymorphic: ai.polymorphic && bi.polymorphic };
      }
    }
  }
  if let typeinfo.TypeUnion(au) = a {
    if let typeinfo.TypeUnion(bu) = b {
      return join_enum_arguments(au, bu);
    }
  }
  if (is_float(a) && is_float(b)) {
    return float_result(a, b);
  }
  if let typeinfo.TypeTuple(at) = a {
    if let typeinfo.TypeTuple(bt) = b {
      if (at.elements.len() != bt.elements.len()) {
        return t_unknown("result tuple arities differ");
      }
      let elems: typeinfo.Type[] = [];
      let i: i32 = 0;
      while (i < at.elements.len()) {
        let elem: typeinfo.Type = join_result_types(at.elements[i], bt.elements[i]);
        if (is_unknown(elem)) {
          return elem;
        }
        elems = elems.append(elem);
        i = i + 1;
      }
      return t_tuple(elems);
    }
  }
  if (type_eq(a, b)) {
    return a;
  }
  return t_unknown("result types disagree");
}

// An inference position absent from a constructor contributes no constraint.
// Other unknowns still mean a failed type check, not a wildcard for joins.
pub function unbound_enum_argument(t: typeinfo.Type): boolean {
  if let typeinfo.TypeUnknown(u) = t {
    return util.str_has_prefix(u.reason, "unbound ");
  }
  return false;
}

function join_enum_arguments(a: typeinfo.TypeUnion, b: typeinfo.TypeUnion): typeinfo.Type {
  if (a.name != b.name) {
    return t_unknown("result enum names disagree");
  }
  if (a.args.len() == 0) {
    return b;
  }
  if (b.args.len() == 0) {
    return a;
  }
  if (a.args.len() != b.args.len()) {
    return t_unknown("result enum arities differ");
  }
  let args: typeinfo.Type[] = [];
  let i: i32 = 0;
  while (i < a.args.len()) {
    let joined: typeinfo.Type = a.args[i];
    if (unbound_enum_argument(joined)) {
      joined = b.args[i];
    } else if (!unbound_enum_argument(b.args[i])) {
      joined = join_result_types(joined, b.args[i]);
      if (is_unknown(joined)) {
        return joined;
      }
    }
    args = args.append(joined);
    i = i + 1;
  }
  return typeinfo.TypeUnion { name: a.name, args: args };
}

function t_array(elem: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeArray { elem: elem, view: false };
}

// is_sha_hw_builtin is __sha256_hw or __sha1_hw, which take nothing and say
// whether the target has the kernel.
function is_sha_hw_builtin(name: string): boolean {
  return name == "__sha256_hw" || name == "__sha1_hw";
}

// byte_kernel_arity is how many [u8] views an AES-GCM or SHA kernel takes,
// or -1.
function byte_kernel_arity(name: string): i32 {
  if (name == "__aes_expand_key") {
    return 1;
  }
  if (name == "__sha256_hw_blocks" || name == "__sha1_hw_blocks") {
    return 2;
  }
  if (name == "__aes_ctr32" || name == "__ghash") {
    return 3;
  }
  if (name == "__aes_gcm_seal" || name == "__aes_gcm_open") {
    return 5;
  }
  return 0 - 1;
}

// `[T]` — the array view a slice yields (#9944). Like `str`, view-ness is a
// flag every stage but an owning sink ignores: type_eq is flag-blind and
// type_assignable refuses a view where an owned `T[]` is required.
function t_view(elem: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeArray { elem: elem, view: true };
}

function as_view(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeArray(a) = t {
    return t_view(a.elem);
  }
  return t;
}

function is_arr_view(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return a.view;
  }
  return false;
}

function is_owned_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return !a.view;
  }
  return false;
}

function t_struct(name: string): typeinfo.Type {
  let noargs: typeinfo.Type[] = [];
  return typeinfo.TypeStruct { name: name, args: noargs };
}

// t_struct_g builds a struct type carrying its generic instantiation args
// (`Box[i32]` → TypeStruct{"Box", [i32]}). The args are used ONLY to
// substitute a field's type parameter at field access (#4346 piece 2);
// type_eq / type_assignable compare structs by name and ignore args, so a
// name-only struct (args=[]) and an instantiated one stay interchangeable
// wherever assignability is checked.
function t_struct_g(name: string, args: typeinfo.Type[]): typeinfo.Type {
  return typeinfo.TypeStruct { name: name, args: args };
}

function t_tuple(elements: typeinfo.Type[]): typeinfo.Type {
  return typeinfo.TypeTuple { elements: elements };
}

// A fresh, empty diagnostic list. A fold's CONSUMING accumulator takes a value
// the caller owns; a local initialised from a literal is not provably one, and
// a call with no reference parameter is.
function no_diags(): util.Diag[] {
  return [];
}

function t_func(param_types: typeinfo.Type[], ret_type: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeFunc { param_types: param_types, param_own: [], ret_type: ret_type, params_known: true };
}

// t_func_own is t_func carrying the callable's CONSUMING slots — the `own`
// each parameter spelling wrote. A caller hands its unit over at one of those
// and does not release it.
function t_func_own(param_types: typeinfo.Type[], param_own: boolean[], ret_type: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeFunc { param_types: param_types, param_own: callable_own_flags(param_own, param_types.len()), ret_type: ret_type, params_known: true };
}

// Written consuming flags remain part of a callable's source type even at
// scalar slots. Semantic lowering separately drops flags with no RC unit.
function callable_own_flags(flags: boolean[], count: i32): boolean[] {
  let out: boolean[] = [];
  let any: boolean = false;
  let i: i32 = 0;
  while (i < count) {
    let on: boolean = i < flags.len() && flags[i];
    out = out.append(on);
    any = any || on;
    i = i + 1;
  }
  return if (any) { out } else { [] };
}

// A lambda's consuming slots are the `own` its parameters declare, the same
// way a named function's are: the value a lambda is bound to spells them.
function lambda_owns(lm: ast.ExprLambda): boolean[] {
  let owns: boolean[] = [];
  for param in lm.params {
    owns = owns.append(param.own);
  }
  return owns;
}

// t_func_opaque builds the callable whose parameter list was never recorded,
// so its emptiness carries no information and no caller may arity-check it.
function t_func_opaque(ret_type: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeFunc { param_types: [], param_own: [], ret_type: ret_type, params_known: false };
}

function t_map(key: typeinfo.Type, value: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeMap { key: key, value: value };
}

// digit_string_to_i32 parses a decimal-digit string. Returns
// -1 on the empty string or any non-digit byte. Used only for
// tuple-index field names like "0" / "1" / "42".
function digit_string_to_i32(s: string): i32 {
  let n: i32 = s.len();
  if (n == 0) {
    return 0 - 1;
  }
  let acc: i32 = 0;
  let i: i32 = 0;
  while (i < n) {
    let b: i32 = s[i] as i32;
    if (b < 48 || b > 57) {
      return 0 - 1;
    }
    acc = acc * 10 + (b - 48);
    i = i + 1;
  }
  return acc;
}

function t_union(name: string): typeinfo.Type {
  let noargs: typeinfo.Type[] = [];
  return typeinfo.TypeUnion { name: name, args: noargs };
}

function t_union_g(name: string, args: typeinfo.Type[]): typeinfo.Type {
  return typeinfo.TypeUnion { name: name, args: args };
}

// canon_trait_set sorts and dedupes a dyn trait set, so two spellings of one
// set are one type. Native normalises at construction (ast.NewDynTraitType)
// and type_eq compares the traits string exactly, so without this the SPELLING
// is the identity: `dyn B + A` would not match `dyn A + B`, nor `dyn A + A`
// match `dyn A` (#10147).
function canon_trait_set(traits: string): string {
  let names: string[] = [];
  for n in parser.dyn_trait_set("dyn " + traits) {
    names = push_str_unique_sorted(names, n);
  }
  let out: string = "";
  let i: i32 = 0;
  while (i < names.len()) {
    if (i > 0) {
      out = out + " + ";
    }
    out = out + names[i];
    i = i + 1;
  }
  return out;
}

// A handle names a declared resource: `own R`, `borrow R`, or the bare `R`,
// which is an owned handle. Only a declared resource makes `own R` a handle;
// elsewhere `own T` is a consuming parameter's spelling.
function names_resource_handle(name: string, tn: TypeNames): boolean {
  return tn.resources.names.len() > 0 && tn.resources.has(handle_resource(name));
}

function handle_resource(name: string): string {
  if (name.len() > 4 && slice_unchecked(name, 0, 4) == "own ") {
    return slice_unchecked(name, 4, name.len()) + "";
  }
  if (name.len() > 7 && slice_unchecked(name, 0, 7) == "borrow ") {
    return slice_unchecked(name, 7, name.len()) + "";
  }
  return name;
}

function resource_handle(name: string): typeinfo.Type {
  let borrowed: boolean = name.len() > 7 && slice_unchecked(name, 0, 7) == "borrow ";
  return typeinfo.TypeHandle { resource: handle_resource(name), borrowed: borrowed };
}

function t_dyn(traits: string): typeinfo.Type {
  return typeinfo.TypeDyn { traits: canon_trait_set(traits) };
}

function t_void(): typeinfo.Type {
  return typeinfo.TypeVoid { tag: 0 };
}

function t_unknown(reason: string): typeinfo.Type {
  return typeinfo.TypeUnknown { reason: reason };
}

// Cell[T] is the reserved builtin struct over one mutable slot; its single
// instantiation arg is the element. An argless `Cell` — what `cell_new(v)`
// yields, since the destination names T — has no element to give.
function is_cell_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(s) = t {
    return s.name == "Cell";
  }
  return false;
}

function cell_elem_type(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeStruct(s) = t {
    if (s.args.len() == 1) {
      return s.args[0];
    }
  }
  return t_unknown("cell element");
}

// `Cell[T]` resolves to the reserved builtin struct CARRYING its element, the
// shape native's builtinStructDecls registers. The element is what a cell-typed
// field's reclamation reads, so it survives rather than being erased the way a
// user generic's args are.
function is_cell_ref(r: parser.TypeRef): boolean {
  return r.base == "Cell" && r.args.len() == 1;
}

// `Map[K, V]`, and the never-emitted 3+ arg form whose value is everything
// after the first comma.
function is_map_ref(r: parser.TypeRef): boolean {
  return r.base == "Map" && r.args.len() == 2;
}

// `MapIter[K, V]` resolves CARRYING its key and value for the same reason
// `Cell[T]` carries its element: the cursor's `key()` and `value()` answer
// those two types, and an argless spelling names no columns to read. The
// argless form still resolves below, where every other reserved builtin does.
function is_map_iter_ref(r: parser.TypeRef): boolean {
  return r.base == "MapIter" && r.args.len() == 2;
}

function is_wide_map_ref(r: parser.TypeRef): boolean {
  return r.base == "Map" && r.args.len() > 2;
}

// Cell[T]'s two methods (docs/CELL-TYPE-PLAN.md): `get` reads the slot and
// `set` writes it in place, yielding nothing so `c.set(v);` is a statement
// rather than an E055 discard.
function cell_method_type(recv: typeinfo.Type, name: string, argc: i32): typeinfo.Type {
  if (!is_cell_type(recv)) {
    return t_unknown("not a cell method call");
  }
  if (name == "get" && argc == 0) {
    return cell_elem_type(recv);
  }
  if (name == "set" && argc == 1) {
    return t_void();
  }
  return t_unknown("not a cell method");
}

// The six f64 primitives `std/f64`'s methods dispatch to. Every backend
// implements all of them.
function is_f64_primitive(name: string): boolean {
  let names: string[] = [
    "__sqrt_f64", "__floor_f64", "__ceil_f64", "__round_f64", "__trunc_f64",
    "__abs_f64",
  ];
  for n in names {
    if (n == name) {
      return true;
    }
  }
  return false;
}

// The lane builtins, one set per lane type (docs/SIMD-GENERIC-KERNELS.md §6).
// typeinfo.lane_builtin_params and lane_builtin_result give their signatures.
function is_lane_builtin(name: string): boolean {
  let names: string[] = [
    "__f64x2_splat", "__f64x2_of", "__f64x2_lane", "__f64x2_bitmask", "__f64x2_mul_add", "__f64x2_sqrt",
    "__f64x2_abs", "__f64x2_floor", "__f64x2_round", "__f64x2_min", "__f64x2_max",
    "__f64x2_lt", "__f64x2_ne", "__f64x2_select", "__f64x2_load", "__f64x2_with",
    "__f32x4_splat", "__f32x4_of", "__f32x4_lane", "__f32x4_bitmask", "__f32x4_mul_add", "__f32x4_sqrt",
    "__f32x4_abs", "__f32x4_floor", "__f32x4_round", "__f32x4_min", "__f32x4_max",
    "__f32x4_lt", "__f32x4_ne", "__f32x4_select", "__f32x4_load", "__f32x4_with",
  ];
  return typeinfo.lane_builtin_width(name) > 0 && util.has_str(names, name);
}

// The bit-counting intrinsics, one name per operand width because the width is
// what the backend needs and the argument's static type is what fixes it. Each
// answers an i32 count.
function is_bit_count(name: string): boolean {
  let names: string[] = ["__clz32", "__ctz32", "__popcount32", "__clz64", "__ctz64", "__popcount64"];
  for n in names {
    if (n == name) {
      return true;
    }
  }
  return false;
}

// Every runtime intrinsic is named `__…`, so a name without the prefix is none.
function internal_name(name: string): boolean {
  return name.len() > 2 && name[0] == b'_' && name[1] == b'_';
}

// The runtime intrinsics: the float primitives, the bit counts, the raw-memory
// escape hatches, the byte scans over a borrowed string, and the C-ABI
// trampolines. `__alloc_u8` and its typed siblings are the ones whose result
// the caller OWNS — a fresh zeroed array — where every other answer here is a
// scalar.
function intrinsic_result(name: string, argc: i32, t: SigTable): typeinfo.Type {
  if (!internal_name(name)) {
    return t_unknown("not a runtime intrinsic");
  }
  let at: i32 = raw_floor_at(t, name);
  if (at >= 0 && raw_floor_allowed(t, name) && t.raw[at].params.len() == argc) {
    return t.raw[at].result;
  }
  if (argc == 1 && is_f64_primitive(name)) {
    return t_float();
  }
  if (is_lane_builtin(name) && argc == typeinfo.lane_builtin_params(name).len()) {
    return typeinfo.lane_builtin_result(name);
  }
  if (argc == 1 && is_bit_count(name)) {
    return t_i32();
  }
  if (argc == 2 && name == "__mulhi_u64") {
    return t_u64();
  }
  if (argc == 1 && name == "__alloc") {
    return t_usize();
  }
  if (argc == 1 && name == "__alloc_u8") {
    return typeinfo.TypeArray { elem: t_u8(), view: false };
  }
  if (argc == 1 && name == "__alloc_i32") {
    return typeinfo.TypeArray { elem: t_i32(), view: false };
  }
  if (argc == 1 && name == "__alloc_i64") {
    return typeinfo.TypeArray { elem: t_i64(), view: false };
  }
  if (argc == 1 && name == "__alloc_bool") {
    return typeinfo.TypeArray { elem: t_bool(), view: false };
  }
  if (argc == 2 && name == "__free") {
    return t_void();
  }
  if (argc == 2 && name == "__fern_box_free") {
    return t_usize();
  }
  if (argc == 0 && name == "__ptr_width") {
    return t_i32();
  }
  // core/map's per-process string-hash seed (#6194). Compiler-internal, so
  // it carries no capability or platform row — the `__` prefix is the
  // inventory's exemption. The lowering already handles it; only this entry was
  // missing, and without it `core/map.map_new_impl` does not type.
  if (argc == 0 && name == "__map_hash_seed") {
    return t_i32();
  }
  if (argc == 0 && name == "__heap_bump_bytes") {
    return t_i64();
  }
  if (argc == 0 && name == "__heap_alloc_count") {
    return t_i64();
  }
  // The constant-time gate's marks: valgrind's memcheck treats the bytes as
  // undefined after __ct_secret and defined again after __ct_public.
  if (argc == 1 && (name == "__ct_secret" || name == "__ct_public")) {
    return t_void();
  }
  // A byte view's bytes copied into a fresh u8[].
  if (argc == 1 && name == "__bytes_owned" || argc == 3 && name == "__bytes_range" || argc == 5 && name == "__bytes_into") {
    return t_array(t_u8());
  }
  // The AES-GCM and SHA kernels each answer a fresh u8[].
  if (argc == byte_kernel_arity(name)) {
    return t_array(t_u8());
  }
  if (argc == 0 && is_sha_hw_builtin(name)) {
    return t_bool();
  }
  // The task primitives (docs/NET-P3-SUSPENSION-PLAN.md §3.4): a record per
  // task, the current task, the park that unwinds it and the words the
  // scheduler reads back.
  if (argc == 0 && name == "__task_new") {
    return t_i32();
  }
  if (argc == 1 && name == "__task_free") {
    return t_void();
  }
  if (argc == 0 && name == "__task_cur") {
    return t_i32();
  }
  return intrinsic_result_task(name, argc);
}

// intrinsic_result_task continues intrinsic_result's table.
function intrinsic_result_task(name: string, argc: i32): typeinfo.Type {
  if (argc == 2 && name == "__task_enter") {
    return t_void();
  }
  if (argc == 0 && name == "__task_leave") {
    return t_i32();
  }
  if (argc == 2 && name == "__task_park") {
    return t_i32();
  }
  if (argc == 1 && name == "__task_wait") {
    return t_array(t_i32());
  }
  if (argc == 1 && name == "__task_timeout") {
    return t_i32();
  }
  if (argc == 2 && name == "__task_set_ready") {
    return t_void();
  }
  if (argc == 1 && name == "__task_set_cancelled") {
    return t_void();
  }
  if (argc == 0 && name == "__task_cancelled") {
    return t_i32();
  }
  if (argc == 0 && name == "__heap_mark") {
    return t_i64();
  }
  if (argc == 1 && name == "__heap_release_to") {
    return t_void();
  }
  // The rc detectors programs read to report on themselves: the underflow
  // count, the rc==1 append cliff (#6023) and the raw refcount pokes.
  if (argc == 0 && name == "__rc_underflow_count") {
    return t_i32();
  }
  if (argc == 0 && name == "__arr_push_shared_count") {
    return t_i32();
  }
  if (argc == 0 && name == "__arr_push_shared_bytes") {
    return t_i64();
  }
  if (argc == 1 && name == "__rc_inc") {
    return typeinfo.TypeArray { elem: t_u8(), view: false };
  }
  if (argc == 1 && name == "__rc_dec") {
    return t_void();
  }
  if (argc == 1 && name == "__rc_get") {
    return t_i32();
  }
  if (argc == 3 && name == "__alloc_reuse") {
    return t_usize();
  }
  if (argc == 3 && name == "__memcpy") {
    return t_void();
  }
  if (argc == 3 && name == "__memset") {
    return t_void();
  }
  if (argc == 1 && name == "__load_u8") {
    return t_i32();
  }
  if (argc == 2 && name == "__account_entry") {
    return t_usize();
  }
  if (argc == 1 && name == "__load_i32") {
    return t_i32();
  }
  if (argc == 1 && name == "__load_i64") {
    return t_i64();
  }
  if (argc == 1 && name == "__load_ptr") {
    return t_usize();
  }
  return intrinsic_result_memory(name, argc);
}

// intrinsic_result_memory continues intrinsic_result_task's table.
function intrinsic_result_memory(name: string, argc: i32): typeinfo.Type {
  if (argc == 2 && name == "__store_u8") {
    return t_void();
  }
  if (argc == 2 && name == "__str_bytes") {
    return t_usize();
  }
  if (argc == 2 && name == "__arr_set_len") {
    return t_void();
  }
  if (argc == 2 && name == "__store_i32") {
    return t_void();
  }
  if (argc == 2 && name == "__store_i64") {
    return t_void();
  }
  if (argc == 2 && name == "__store_ptr") {
    return t_void();
  }
  if (argc == 5 && (name == "__mismatch" || name == "__mismatch_bytes" || name == "__mismatch_bytes_str")) {
    return t_i32();
  }
  if (argc == 1 && name == "__sum_bytes") {
    return t_i32();
  }
  if (argc == 2 && (name == "__scale_f64" || name == "__outer_mul_f64")) {
    return t_array(t_float());
  }
  if (argc == 6 && name == "__inner_mul_add_f64") {
    return t_array(t_float());
  }
  if (argc == 2 && name == "__ascii_run") {
    return t_i32();
  }
  if (argc == 3 && (name == "__scan_set" || name == "__scan_set_bytes")) {
    return t_i32();
  }
  if (argc == 3 && (name == "__count_runs" || name == "__count_runs_bytes")) {
    return t_i32();
  }
  if (argc == 2 && name == "__bsd_sum") {
    return t_i32();
  }
  if (argc == 2 && name == "__str_hash") {
    return t_i32();
  }
  if (argc == 2 && name == "__count_byte") {
    return t_i32();
  }
  if (argc == 2 && (name == "__crc32_cksum" || name == "__crc32_cksum_array")) {
    return t_i32();
  }
  if (argc == 3 && name == "__memchr") {
    return t_i32();
  }
  if (argc == 2 && name == "__count_byte_bytes") {
    return t_i32();
  }
  if (argc == 1 && name == "__sum_bytes_array") {
    return t_i32();
  }
  if (argc == 2 && name == "__bsd_sum_bytes") {
    return t_i32();
  }
  if (argc == 3 && (name == "__memchr_bytes" || name == "__rmemchr_bytes")) {
    return t_i32();
  }
  // The rc helpers core/map calls by name to claim and release the cells it
  // copies, typed as native types them so the two checkers agree. What the
  // self-host EMITS is not uniform: only __fern_rc_inc is a real call that
  // answers its pointer. The 2-arg dec pair drops both arguments and
  // __fern_str_dec does not even lower its one — no-ops still, each pushing a
  // dummy 0 (ssarc, the __fern_arr_dec / __fern_str_dec arms), because the
  // element deep-drop their stride selects has no self-host equivalent.
  // core/map calls those three in statement position, so nothing may rely on
  // the usize they declare.
  if (argc == 1 && name == "__fern_rc_inc") {
    return t_usize();
  }
  if (argc == 1 && name == "__fern_str_dec") {
    return t_usize();
  }
  if (argc == 2 && name == "__fern_arr_dec") {
    return t_usize();
  }
  if (argc == 2 && name == "__fern_drop_arr_ptr") {
    return t_usize();
  }
  if (argc == 3 && name == "__rmemchr") {
    return t_i32();
  }
  return t_unknown("not a runtime intrinsic");
}

// The builtin results a call carries ahead of the user tables. Unknown for
// every other receiver or name, which is the caller's signal to keep resolving.
function builtin_result_type(recv: typeinfo.Type, name: string, is_method: boolean, argc: i32, s: Scope): typeinfo.Type {
  if (is_method) {
    return cell_method_type(recv, name, argc);
  }
  if ((util.str_has_prefix(name, "__raw_") || util.str_has_prefix(name, "__syscall"))
    && (s.defines(name) || s.lookup_sig(name).name.len() > 0)) {
    return t_unknown("a declared callable shadows the raw floor");
  }
  return intrinsic_result(name, argc, s.sigs);
}

// The intrinsics' parameters, mirroring intrinsic_result entry for entry. The
// bit counts split by operand width where the result table does not need to:
// the width is the whole reason there is one name per width, and it is the
// parameter that carries it. The second half reports whether `name` is one at
// all, since an empty list is a real signature (`__ptr_width()`).
function intrinsic_params(name: string, t: SigTable): (typeinfo.Type[], boolean) {
  if (!internal_name(name)) {
    return ([], false);
  }
  let at: i32 = raw_floor_at(t, name);
  if (at >= 0 && raw_floor_allowed(t, name)) {
    return (t.raw[at].params, true);
  }
  if (is_f64_primitive(name)) {
    return ([t_float()], true);
  }
  if (is_lane_builtin(name)) {
    return (typeinfo.lane_builtin_params(name), true);
  }
  if (name == "__clz32" || name == "__ctz32" || name == "__popcount32") {
    return ([t_u32()], true);
  }
  if (name == "__clz64" || name == "__ctz64" || name == "__popcount64") {
    return ([t_u64()], true);
  }
  if (name == "__mulhi_u64") {
    return ([t_u64(), t_u64()], true);
  }
  if (name == "__alloc") {
    return ([t_i32()], true);
  }
  if (name == "__alloc_u8" || name == "__alloc_i32" || name == "__alloc_i64" || name == "__alloc_bool") {
    return ([t_i32()], true);
  }
  if (name == "__free") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__fern_box_free") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__ptr_width") {
    return ([], true);
  }
  if (name == "__map_hash_seed") {
    return ([], true);
  }
  if (name == "__heap_bump_bytes") {
    return ([], true);
  }
  if (name == "__heap_alloc_count") {
    return ([], true);
  }
  if (name == "__ct_secret" || name == "__ct_public" || name == "__bytes_owned") {
    return ([t_view(t_u8())], true);
  }
  if (name == "__bytes_range") {
    return ([t_view(t_u8()), t_i32(), t_i32()], true);
  }
  if (name == "__bytes_into") {
    return ([t_array(t_u8()), t_i32(), t_view(t_u8()), t_i32(), t_i32()], true);
  }
  if (is_sha_hw_builtin(name)) {
    return ([], true);
  }
  if (byte_kernel_arity(name) > 0) {
    let views: typeinfo.Type[] = [];
    while (views.len() < byte_kernel_arity(name)) {
      views = views.append(t_view(t_u8()));
    }
    return (views, true);
  }
  if (name == "__task_new") {
    return ([], true);
  }
  if (name == "__task_free") {
    return ([t_i32()], true);
  }
  if (name == "__task_cur") {
    return ([], true);
  }
  if (name == "__task_enter") {
    return ([t_i32(), t_i32()], true);
  }
  if (name == "__task_leave") {
    return ([], true);
  }
  if (name == "__task_park") {
    return ([t_array(t_i32()), t_i32()], true);
  }
  if (name == "__task_wait") {
    return ([t_i32()], true);
  }
  if (name == "__task_timeout") {
    return ([t_i32()], true);
  }
  if (name == "__task_set_ready") {
    return ([t_i32(), t_i32()], true);
  }
  if (name == "__task_set_cancelled") {
    return ([t_i32()], true);
  }
  if (name == "__task_cancelled") {
    return ([], true);
  }
  if (name == "__heap_mark") {
    return ([], true);
  }
  if (name == "__heap_release_to") {
    return ([t_i64()], true);
  }
  if (name == "__rc_underflow_count" || name == "__arr_push_shared_count" || name == "__arr_push_shared_bytes") {
    return ([], true);
  }
  if (name == "__rc_inc" || name == "__rc_dec" || name == "__rc_get") {
    return ([t_array(t_u8())], true);
  }
  if (name == "__alloc_reuse") {
    return ([t_usize(), t_i32(), t_i32()], true);
  }
  if (name == "__memcpy") {
    return ([t_usize(), t_usize(), t_i32()], true);
  }
  if (name == "__memset") {
    return ([t_usize(), t_i32(), t_i32()], true);
  }
  if (name == "__load_u8" || name == "__load_i32" || name == "__load_i64" || name == "__load_ptr") {
    return ([t_usize()], true);
  }
  if (name == "__store_u8") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__account_entry") {
    return ([t_i32(), t_usize()], true);
  }
  if (name == "__str_bytes") {
    return ([t_string(), t_usize()], true);
  }
  if (name == "__arr_set_len") {
    return ([t_array(t_u8()), t_i32()], true);
  }
  if (name == "__store_i32") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__store_i64") {
    return ([t_usize(), t_i64()], true);
  }
  if (name == "__store_ptr") {
    return ([t_usize(), t_usize()], true);
  }
  if (name == "__mismatch") {
    return ([t_string(), t_i32(), t_string(), t_i32(), t_i32()], true);
  }
  if (name == "__mismatch_bytes") {
    return ([t_array(t_u8()), t_i32(), t_array(t_u8()), t_i32(), t_i32()], true);
  }
  if (name == "__mismatch_bytes_str") {
    return ([t_array(t_u8()), t_i32(), t_string(), t_i32(), t_i32()], true);
  }
  if (name == "__sum_bytes") {
    return ([t_string()], true);
  }
  if (name == "__scale_f64") {
    return ([t_array(t_float()), t_float()], true);
  }
  if (name == "__outer_mul_f64") {
    return ([t_array(t_float()), t_array(t_float())], true);
  }
  if (name == "__inner_mul_add_f64") {
    return ([t_array(t_float()), t_array(t_float()), t_i32(), t_i32(), t_i32(), t_float()], true);
  }
  if (name == "__ascii_run") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__scan_set") {
    return ([t_string(), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__scan_set_bytes") {
    return ([t_array(t_u8()), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__count_runs") {
    return ([t_string(), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__count_runs_bytes") {
    return ([t_array(t_u8()), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__bsd_sum") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__str_hash") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__count_byte") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__crc32_cksum") {
    return ([t_i32(), t_string()], true);
  }
  if (name == "__crc32_cksum_array") {
    return ([t_i32(), t_array(t_u8())], true);
  }
  if (name == "__memchr" || name == "__rmemchr") {
    return ([t_string(), t_i32(), t_i32()], true);
  }
  if (name == "__count_byte_bytes") {
    return ([t_array(t_u8()), t_i32()], true);
  }
  if (name == "__sum_bytes_array") {
    return ([t_array(t_u8())], true);
  }
  if (name == "__bsd_sum_bytes") {
    return ([t_array(t_u8()), t_i32()], true);
  }
  if (name == "__memchr_bytes" || name == "__rmemchr_bytes") {
    return ([t_array(t_u8()), t_i32(), t_i32()], true);
  }
  if (name == "__fern_rc_inc") {
    return ([t_usize()], true);
  }
  if (name == "__fern_str_dec") {
    return ([t_string()], true);
  }
  if (name == "__fern_arr_dec") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__fern_drop_arr_ptr") {
    return ([t_usize(), t_i32()], true);
  }
  return ([], false);
}

// The raw-memory floor the Fern-source runtime helpers are written on (#2649,
// docs/RUNTIME-INTRINSICS.md). The RC decrement also has a public signature.
// An address is a `usize`; an offset, a byte or a length is an `i32`. A
// syscall takes and answers machine words, signed so a negative errno reads
// as one. `__raw_string` and `__raw_array` hand a block to a fresh string or
// `i32[]` the caller owns, and `__raw_data` reads a string's data word.
// `__raw_call1` / `__raw_call2` call the code address in their last operand
// with the words before it, and answer the low half of its result. The
// `__fern_*` rows are the runtime helpers the map helpers call on raw words,
// where a key or value is a box address or a scalar in a pointer-sized slot.
pub struct RawFloorSig { name: string, params: typeinfo.Type[], result: typeinfo.Type }

pub function raw_floor_sigs(): RawFloorSig[] {
  let p: typeinfo.Type = t_usize();
  let n: typeinfo.Type = t_i32();
  let w: typeinfo.Type = t_i64();
  return [
    RawFloorSig { name: "__raw_alloc", params: [n], result: p },
    RawFloorSig { name: "__raw_store8", params: [p, n, n], result: t_void() },
    RawFloorSig { name: "__raw_load8", params: [p, n], result: n },
    RawFloorSig { name: "__raw_store_ptr", params: [p, n, p], result: t_void() },
    RawFloorSig { name: "__raw_load_ptr", params: [p, n], result: p },
    RawFloorSig { name: "__raw_string", params: [p, n], result: t_string() },
    RawFloorSig { name: "__raw_array", params: [p], result: typeinfo.TypeArray { elem: n, view: false } },
    RawFloorSig { name: "__raw_arr_ptr", params: [typeinfo.TypeArray { elem: n, view: false }], result: p },
    RawFloorSig { name: "__raw_data", params: [t_string()], result: p },
    RawFloorSig { name: "__raw_arr_box", params: [n], result: p },
    RawFloorSig { name: "__raw_scratch", params: [n], result: p },
    RawFloorSig { name: "__raw_environ", params: [], result: p },
    RawFloorSig { name: "__raw_splice_pipe", params: [], result: p },
    RawFloorSig { name: "__raw_cover", params: [], result: p },
    RawFloorSig { name: "__raw_task_state", params: [], result: p },
    RawFloorSig { name: "__raw_vdso", params: [], result: p },
    RawFloorSig { name: "__raw_call1", params: [p, p], result: n },
    RawFloorSig { name: "__raw_call2", params: [p, p, p], result: n },
    RawFloorSig { name: "__fern_str_eq", params: [p, p], result: t_bool() },
    RawFloorSig { name: "__fern_str_free", params: [p], result: t_void() },
    RawFloorSig { name: "__fern_str_arr_free", params: [p], result: t_void() },
    RawFloorSig { name: "__fern_rc_dec", params: [p], result: t_void() },
    // The slice-range abort the __fern_arr_slice bodies call (#11405): the
    // emitters' reporter, so it never returns.
    RawFloorSig { name: "__fern_slice_abort", params: [], result: t_void() },
    RawFloorSig { name: "__fern_oob_abort", params: [], result: t_void() },
    // The vDSO's clock_gettime the Linux clocks call, 1 when there is none.
    RawFloorSig { name: "__fern_vdso_clock", params: [], result: p },
    RawFloorSig { name: "__syscall3", params: [n, w, w, w], result: w },
    RawFloorSig { name: "__syscall4", params: [n, w, w, w, w], result: w },
    RawFloorSig { name: "__syscall5", params: [n, w, w, w, w, w], result: w },
    RawFloorSig { name: "__syscall6", params: [n, w, w, w, w, w, w], result: w },
    // valgrind's client request over the six-word block at the address,
    // answering its result word, 0 outside valgrind.
    RawFloorSig { name: "__raw_vg_request", params: [p], result: w },
    // The vector UTF-8 check read_file runs on buf[start..n) (ir.op_utf8_blocks).
    RawFloorSig { name: "__raw_utf8_blocks", params: [p, n, n], result: n },
  ];
}

// The RC decrement is also a public helper used by core/map.
function raw_floor_allowed(t: SigTable, name: string): boolean {
  return t.raw_allowed || name == "__fern_rc_dec";
}

// The index in `t.raw` of the raw-floor signature named `name`, or -1.
function raw_floor_at(t: SigTable, name: string): i32 {
  if (!util.str_has_prefix(name, "__raw_") && !util.str_has_prefix(name, "__syscall") && !util.str_has_prefix(name, "__fern_")) {
    return 0 - 1;
  }
  let i: i32 = 0;
  while (i < t.raw.len()) {
    if (t.raw[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// lane_index_diags is E038 for a `lane` builtin whose index is not an integer
// literal below the lane count. The instruction holds the index, so it is
// fixed when the program compiles.
function lane_index_diags(name: string, c: ast.ExprCall): util.Diag[] {
  if (c.args.len() != 2 || !is_lane_builtin(name) || typeinfo.lane_builtin_verb(name) != "lane") {
    return [];
  }
  let lanes: i32 = 128 / typeinfo.lane_builtin_width(name);
  if let ast.ExprNumber(n) = c.args[1] {
    let start: i32 = 0;
    if (parser.is_hex_lit(n.text)) {
      start = 2;
    }
    if (!n.is_float && !parser.is_quoted_literal(n) && parser.magnitude_fits(n.text, start, util.i32_to_string(lanes - 1))) {
      return [];
    }
  }
  return [dg_at("E038", "argument 2 to \"" + name + "\": the lane index is an integer literal from 0 to " + util.i32_to_string(lanes - 1), expr_line(c.args[1]), expr_col(c.args[1]))];
}

// free_builtin_sig is the callable a free builtin denotes, so a call to one is
// argument-checked by the same callable_arg_diags a call to a declared
// function goes through. Unknown for a name that is not a free builtin, and
// for the Display builtins, which display_arg_diags judges instead.
function free_builtin_sig(name: string, s: Scope): typeinfo.Type {
  let (params, known) = intrinsic_params(name, s.sigs);
  if (known) {
    return t_func(params, intrinsic_result(name, params.len(), s.sigs));
  }
  if (is_display_builtin(name)) {
    return t_unknown("a Display builtin");
  }
  return builtin_sig(name);
}

// type_debug renders a Type to a compact, unambiguous debug spelling — the Type
// analogue of asmcore's ty_tag. Recursive over the composite variants so the
// full decoded shape (array element, tuple elements, map key/value, and the
// carried names / unknown reasons) is visible. Used by the type-resolver golden
// (SH-021) to pin type_from_name* decode results across the byte-scan → TypeRef
// migration; a wrong sub-type shows as a differing rendering rather than a silent
// mis-resolution.
pub function type_debug(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(x) => {
      return int_label(x);
    },
    typeinfo.TypeBool(_) => {
      return "bool";
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    typeinfo.TypeArray(a) => {
      return "array<" + type_debug(a.elem) + ">";
    },
    typeinfo.TypeStruct(st) => {
      return "struct:" + st.name;
    },
    typeinfo.TypeTuple(tp) => {
      let out: string = "tuple<";
      let i: i32 = 0;
      while (i < tp.elements.len()) {
        if (i > 0) {
          out = out + ", ";
        }
        out = out + type_debug(tp.elements[i]);
        i = i + 1;
      }
      return out + ">";
    },
    typeinfo.TypeFunc(f) => {
      return "fn";
    },
    typeinfo.TypeMap(m) => {
      return "map<" + type_debug(m.key) + ", " + type_debug(m.value) + ">";
    },
    typeinfo.TypeUnion(u) => {
      return "union:" + u.name;
    },
    typeinfo.TypeDyn(d) => {
      return "dyn:" + d.traits;
    },
    typeinfo.TypeHandle(h) => {
      return "handle:" + typeinfo.handle_spelling(h);
    },
    typeinfo.TypeVoid(_) => {
      return "void";
    },
    typeinfo.TypeNever(_) => {
      return "never";
    },
    typeinfo.TypeUnknown(uk) => {
      return "unknown(" + uk.reason + ")";
    },
    typeinfo.TypeErased(e) => {
      return "erased(" + e.name + ")";
    }
  }
  return "?";
}

// is_integer reports whether `t` is an integer of ANY width or signedness.
// `char` occupies an i32 slot but is not an integer (#5629), so it is excluded.
//
// The numeric operator rules want this rather than type_eq: native unifies
// widths across `+`, `<`, `%` and friends (`c - n` with `c: i64`, `n: i32` is
// accepted) and only assignment cares which width it got.
function is_integer(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(i) => {
      return !i.is_char;
    },
    _ => {
      return false;
    }
  }
}

// int_operands_agree: native's commonIntegerWidth, reduced to the one condition
// that can fail in this checker's type model. Mixed SIGNEDNESS needs an explicit
// cast — reinterpreting a negative i32 against a small u32 has no well-defined
// result domain, and getting it silently wrong is worse than asking. Differing
// WIDTHS at the same signedness auto-widen and are fine.
//
// Native's two carve-outs are here too. A polymorphic literal is read at the
// other operand's width, which is what int_literal_tree says on the EXPR
// (`b + 1` over a u8 stays legal; a literal the width cannot hold is the RANGE
// rule's to report, not a signedness clash). And `usize`, native's
// pointer-width case, mixes with either signedness: an address is offset by
// whatever integer the source has.
function int_operands_agree(lt: typeinfo.Type, rt: typeinfo.Type, le: ast.Expr, re: ast.Expr): boolean {
  if (int_literal_tree(le) || int_literal_tree(re)) {
    return true;
  }
  if (is_usize(lt) || is_usize(rt)) {
    return true;
  }
  return int_is_unsigned(lt) == int_is_unsigned(rt);
}

function int_is_unsigned(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(i) => {
      return i.unsigned;
    },
    _ => {
      return false;
    }
  }
}

// mixed_int_diag: the message native emits when both operands ARE integers but
// cannot share a type. Kept separate from each arm's own "not a number at all"
// text because native splits them the same way — an `as` cannot help
// `true < false`, so suggesting one there sends the reader to write a
// conversion that does not exist.
function mixed_int_diag(op: string, lt: typeinfo.Type, rt: typeinfo.Type, line: i32, col: i32): util.Diag {
  return dg_at(
    "E009", "operator \"" + op + "\" requires both operands to share an integer type; got "
      + type_label(lt) + " and " + type_label(rt) + " — use `as` for explicit conversion",
    line, col,
  );
}

// Invalid arithmetic operands name the numeric type the operator requires.
function numeric_operand_diags(op: string, lt: typeinfo.Type, rt: typeinfo.Type, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let want_float: boolean = op != "%" && (is_float(lt) || is_float(rt));
  if (want_float && is_float(lt) && is_float(rt)) {
    return [dg_at("E009", "operator \"" + op + "\" requires both operands to share a float type; got " + type_label(lt) + " and " + type_label(rt) + " — use `as` for explicit conversion", line, col)];
  }
  for operand in [lt, rt] {
    if (want_float && !is_float(operand)) {
      out = out.append(dg_at("E009", "operator \"" + op + "\" requires float, got " + type_label(operand), line, col));
    } else if (!want_float && !is_integer(operand)) {
      out = out.append(dg_at("E009", "operator \"" + op + "\" requires an integer type, got " + type_label(operand), line, col));
    }
  }
  return out;
}

// int_result: the type an integer binop yields. An unsuffixed literal is read
// at the other operand's width, so `n + 1` stays i64 when `n` is; when both
// sides are settled the operator rules have already required them to share a
// signedness, and the narrower side widens to the wider one, as native's
// commonIntegerWidth does for `i32 + i64` in either order.
function int_result(lt: typeinfo.Type, rt: typeinfo.Type, le: ast.Expr, re: ast.Expr): typeinfo.Type {
  if (int_literal_tree(le) && !int_literal_tree(re)) {
    return rt;
  }
  // A literal tree on the right reads at the left's width too, wide or not:
  // the RANGE rule objects to what does not fit (#8722).
  if (int_literal_tree(re) && !int_literal_tree(le)) {
    return lt;
  }
  if (unsettled_int_literal(le)) {
    return rt;
  }
  return wider_int(lt, rt);
}

// wider_int: of two settled integer types, the one with the wider width; the
// left one when they agree or either is not an integer. The pointer width
// is the widest: `usize + i32` is address arithmetic and stays a usize, as
// native's commonIntegerWidth has it, whatever the sentinel's number.
function wider_int(lt: typeinfo.Type, rt: typeinfo.Type): typeinfo.Type {
  if (is_usize(lt)) {
    return lt;
  }
  if (is_usize(rt)) {
    return rt;
  }
  match (lt) {
    typeinfo.TypeI32(li) => {
      match (rt) {
        typeinfo.TypeI32(ri) => {
          if (ri.width > li.width) {
            return rt;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return lt;
}

// type_eq: structural equality on the type union. Returns true
// only for matching variants; mismatched variants and Unknown
// on either side return false (Unknown is a "couldn't resolve"
// marker, not a wildcard).
function type_eq(a: typeinfo.Type, b: typeinfo.Type): boolean {
  match (a) {
    typeinfo.TypeI32(ai) => {
      match (b) {
        typeinfo.TypeI32(bi) => {
          // `char` is NOT an integer, even though it occupies an i32 slot
          // (#5629). The Go checker rejects both directions without an
          // explicit cast — that distinctness is the type's whole point,
          // since a byte and a code point sharing i32 is what made
          // `s[i].to_upper()` and `to_upper_char(cp)` indistinguishable.
          // Width and signedness are part of the type: i64 is not i32, and
          // u32 is not i32. The Go checker rejects both without a cast.
          return ai.is_char == bi.is_char && ai.width == bi.width && ai.unsigned == bi.unsigned;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeBool(_) => {
      match (b) {
        typeinfo.TypeBool(_) => {
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeString(_) => {
      match (b) {
        typeinfo.TypeString(_) => {
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeFloat(af) => {
      match (b) {
        typeinfo.TypeFloat(bf) => {
          return af.width == bf.width;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeLanes(al) => {
      match (b) {
        typeinfo.TypeLanes(bl) => {
          return al.width == bl.width;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeArray(ae) => {
      match (b) {
        typeinfo.TypeArray(be) => {
          return type_eq(ae.elem, be.elem);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeStruct(an) => {
      match (b) {
        typeinfo.TypeStruct(bn) => {
          return an.name == bn.name;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeTuple(at) => {
      match (b) {
        typeinfo.TypeTuple(bt) => {
          if (at.elements.len() != bt.elements.len()) {
            return false;
          }
          let i: i32 = 0;
          while (i < at.elements.len()) {
            if (!type_eq(at.elements[i], bt.elements[i])) {
              return false;
            }
            i = i + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeFunc(af) => {
      match (b) {
        typeinfo.TypeFunc(bf) => {
          if (af.param_types.len() != bf.param_types.len()) {
            return false;
          }
          if (!type_eq(af.ret_type, bf.ret_type)) {
            return false;
          }
          let fi: i32 = 0;
          while (fi < af.param_types.len()) {
            if (!type_eq(af.param_types[fi], bf.param_types[fi])) {
              return false;
            }
            fi = fi + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeMap(am) => {
      match (b) {
        typeinfo.TypeMap(bm) => {
          return type_eq(am.key, bm.key) && type_eq(am.value, bm.value);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeUnion(an) => {
      match (b) {
        typeinfo.TypeUnion(bn) => {
          return an.name == bn.name;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeDyn(ad) => {
      match (b) {
        typeinfo.TypeDyn(bd) => {
          return ad.traits == bd.traits;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeHandle(ah) => {
      if let typeinfo.TypeHandle(bh) = b {
        return ah.resource == bh.resource && ah.borrowed == bh.borrowed;
      }
      return false;
    },
    typeinfo.TypeVoid(_) => {
      match (b) {
        typeinfo.TypeVoid(_) => {
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeUnknown(_) => {
      return false;
    },
    typeinfo.TypeNever(_) => {
      if let typeinfo.TypeNever(_) = b {
        return true;
      }
      return false;
    },
    typeinfo.TypeErased(ae) => {
      // The type variable of a generic, including a map method whose bare
      // constructor receiver left K and V unbound. Compare identity alone.
      if let typeinfo.TypeErased(be) = b {
        return ae.name == be.name;
      }
      return false;
    }
  }
  return false;
}

function is_unknown(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_void(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeVoid(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_func_type(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeFunc(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_tuple_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  return false;
}

// type_contains_unknown reports whether `t` is unknown or has any unknown
// component anywhere in its shape — an array whose element, a tuple whose
// member, a map whose key/value, a struct whose instantiation arg, or a
// function whose param/return is unknown. In this partial type system a
// generic struct's type parameters erase to unknown when its field types are
// collected, so a field spelled with a type parameter — bare (`v: T` →
// unknown) OR nested (`items: T[]` → array<unknown>, `kv: (K, V)` →
// tuple<unknown, unknown>) — leaves an unknown somewhere in the collected
// field type. Constructing such a field can't be verified (the arg's concrete
// type isn't tracked at collect time), so the struct-literal check skips it,
// exactly as the bare-`T` case did before this generalisation (#4346 piece 2).
function type_contains_unknown(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnknown(_) => {
      // An absent enum argument is fillable, not a failed inference. This
      // distinction also holds when the enum is nested inside a container.
      return !unbound_enum_argument(t);
    },
    typeinfo.TypeArray(ae) => {
      return type_contains_unknown(ae.elem);
    },
    typeinfo.TypeTuple(tt) => {
      for element in tt.elements {
        if (type_contains_unknown(element)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeMap(m) => {
      return type_contains_unknown(m.key) || type_contains_unknown(m.value);
    },
    typeinfo.TypeStruct(sn) => {
      for arg in sn.args {
        if (type_contains_unknown(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        if (type_contains_unknown(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeFunc(f) => {
      if (type_contains_unknown(f.ret_type)) {
        return true;
      }
      for param_type in f.param_types {
        if (type_contains_unknown(param_type)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// is_composite_type reports whether `t` is a struct / enum (union) /
// array / tuple — a heap value whose `==` would otherwise mean
// pointer identity. The native compiler routes composite `==` to the
// type's structural `Eq` impl; the self-host compiler has no trait /
// derive support yet, so it rejects composite `==` (matching the
// native E041 the way the scalar-mismatch case already does) rather
// than silently comparing heap pointers.
function is_composite_type(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeStruct(_) => {
      return true;
    },
    typeinfo.TypeUnion(_) => {
      return true;
    },
    typeinfo.TypeArray(_) => {
      return true;
    },
    typeinfo.TypeTuple(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// cmp_method_receiver names the type a structural `==` / `<` on `t` would
// dispatch its `eq` / `cmp` under — a struct's or a union's (enum's) own
// name. Arrays and tuples have no structural comparison to dispatch, so they
// report "" and the caller rejects them outright.
function cmp_method_receiver(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeStruct(st) => {
      return st.name;
    },
    typeinfo.TypeUnion(u) => {
      return u.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// has_ord_cmp reports whether `t` is a struct or enum with the `cmp` method a
// structural `<` on it dispatches through (`a.cmp(b) <op> 0`).
function (s: Scope) has_ord_cmp(t: typeinfo.Type): boolean {
  let recv: string = cmp_method_receiver(t);
  return recv != "" && s.lookup_method("cmp", recv).name.len() > 0;
}

// orders_alike: two values of one struct or enum that has `cmp`.
function (s: Scope) orders_alike(a: typeinfo.Type, b: typeinfo.Type): boolean {
  return type_eq(a, b) && s.has_ord_cmp(a);
}

// binop_overload_ret returns the DECLARED return type of the overload that `lt`
// dispatches `op` through — unknown when the operator has no overload form, the
// operand is not a nominal type, or that type does not define the method.
//
// It is the arithmetic sibling of the `Eq` / `Ord` resolution the comparison
// operators already do through cmp_method_receiver, and it is deliberately the
// SINGLE place both check_expr and the E009 walk ask the question: that walk's
// own comment promises it "fires only where check_expr already rejects the
// operands", which holds only while the two read one rule. Two copies of it is
// the drift this file has paid for elsewhere (#5986).
//
// The return type is the method's as declared, so a scalar-returning overload
// (a dot product `function (a: V) mul(b: V): f64`) types as f64 rather than
// falling through to "requires matching numeric operands".
function (s: Scope) binop_overload_ret(op: string, lt: typeinfo.Type): typeinfo.Type {
  return s.overload_ret(ast.operator_method(op), lt);
}

// unop_overload_ret is the unary sibling: `-a` on a composite is `a.neg()`.
// Written against the same helper so the two operators cannot resolve
// differently — they are siblings in the lowering too, and the last time
// sibling arms here were maintained separately only one of them got fixed.
function (s: Scope) unop_overload_ret(op: string, ot: typeinfo.Type): typeinfo.Type {
  if (op != "-") {
    return t_unknown("operator has no overload form");
  }
  return s.overload_ret("neg", ot);
}

// overload_ret resolves `<nominal>.<method>`'s declared return type, or unknown
// when there is no method name, the operand is not a nominal type, or the type
// does not define it.
function (s: Scope) overload_ret(method: string, t: typeinfo.Type): typeinfo.Type {
  if (method == "") {
    return t_unknown("operator has no overload form");
  }
  let recv: string = cmp_method_receiver(t);
  if (recv == "") {
    return t_unknown("operand is not a nominal type");
  }
  return s.lookup_method(method, recv).ret_type;
}

// downcast_operand_ok reports whether an `as?` operand may be a `dyn Trait`
// value: a dyn, or a type not known here.
function downcast_operand_ok(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeDyn(_) => {
      return true;
    },
    typeinfo.TypeUnknown(_) => {
      return true;
    },
    typeinfo.TypeNever(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

// is_primitive_type reports whether t is one of the scalar primitives
// (i32 / bool / string / f64). Used by the E034 array-element check to
// stay conservative — it only compares element types when both are
// primitives, leaving struct / enum / array / tuple unification (which
// the Go checker widens through unions) untouched.
function is_primitive_type(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(_) => {
      return true;
    },
    typeinfo.TypeBool(_) => {
      return true;
    },
    typeinfo.TypeString(_) => {
      return true;
    },
    typeinfo.TypeFloat(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// as_cast_allowed decides whether `src as tgt` is a legal cast for the
// scalar types the self-host models (i32 / char / f64 / bool / string),
// mirroring the Go checker's E033 rule over those types: identity,
// numeric↔numeric (i32 / char / f64), and the string data-pointer hop to or
// from a cast_pointer_int (either direction) are allowed; everything else (any
// bool↔non-bool, f64↔string, string↔i64) is rejected. Callers guard with
// `is_primitive_type` on both sides, so struct / array pointer hops are never
// reached here.
//
// `char` counts as numeric HERE even though type_eq now separates it from
// i32 (#5629): the cast is exactly the sanctioned way to cross between a
// scalar value and its integer, so `n as char` / `c as i32` must stay legal
// while the implicit conversion is rejected. Missing this made every
// `x as char` an E033 — including the ones inside std/string, which took
// every program importing it down with them.
function as_cast_allowed(src: typeinfo.Type, tgt: typeinfo.Type): boolean {
  if (type_eq(src, tgt)) {
    return true;
  }
  let src_num: boolean = is_integer(src) || type_eq(src, t_char()) || is_float(src);
  let tgt_num: boolean = is_integer(tgt) || type_eq(tgt, t_char()) || is_float(tgt);
  if (src_num && tgt_num) {
    return true;
  }
  if (type_eq(src, t_string()) && cast_pointer_int(tgt)) {
    return true;
  }
  if (cast_pointer_int(src) && type_eq(tgt, t_string())) {
    return true;
  }
  return false;
}

// cast_pointer_int: an integer wide enough to carry a handle's address through
// a pointer-hop cast — i32 / u32 (truncating, E069 on the way in) or usize.
function cast_pointer_int(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return !i.is_char && (i.width == 32 || i.width == typeinfo.width_ptr());
  }
  return false;
}

// cast_pointer_shaped: a non-scalar value that is one pointer at runtime, so a
// pointer-hop cast may take it to or from a cast_pointer_int. A view is one
// only as the source.
function cast_pointer_shaped(t: typeinfo.Type, source: boolean): boolean {
  match (t) {
    typeinfo.TypeArray(a) => {
      return source || !a.view;
    },
    typeinfo.TypeStruct(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// type_from_name accepts an optional `[]` suffix on the type
// name string (the parser currently only captures the first
// token, but a future extension that captures `i32[]` should
// flow through here cleanly). For now bare names only.
// =================== SCOPE ====================
// Function signature table entry — captured once per FuncDecl in
// the module, then read at every ExprCall site. ret_type is a
// Type (post type-name resolution); param_types parallels the
// FuncDecl's params in declaration order.
// `typevars` is every parameter spelling that is a type VARIABLE of the
// callee, each once in parameter order, as gc_is_typevar_name recognises
// them: what the call binding and the literal settling read.
// `refs` is a generic signature's parameter spellings parsed, then its return
// spelling's, which every call to it binds against; empty for any other
// (sig_param_ref, sig_ret_ref).
pub struct FuncSig { name: string, param_types: typeinfo.Type[], param_own: boolean[], ret_type: typeinfo.Type, all_type_params: string[], type_params: string[], type_bounds: string[], ret_type_name: string, param_type_names: string[], param_names: string[], is_const: boolean, receiver: string, typevars: string[], module: string, refs: parser.TypeRef[] }

function sig_param_ref(sig: FuncSig, i: i32): parser.TypeRef {
  if (sig.refs.len() > 0) {
    return sig.refs[i];
  }
  return parser.parse_type_ref(sig.param_type_names[i]);
}

function sig_ret_ref(sig: FuncSig): parser.TypeRef {
  if (sig.refs.len() > 0) {
    return sig.refs[sig.param_type_names.len()];
  }
  return parser.parse_type_ref(sig.ret_type_name);
}

// generic_sig_refs is FuncSig.refs for a signature with these spellings.
function generic_sig_refs(all_type_params: string[], param_type_names: string[], ret_type_name: string): parser.TypeRef[] {
  let out: parser.TypeRef[] = [];
  if (all_type_params.len() == 0) {
    return out;
  }
  for sp in param_type_names {
    out = out.append(parser.parse_type_ref(sp));
  }
  return out.append(parser.parse_type_ref(ret_type_name));
}

// StructSig: nominal handle for a declared struct. Parallel
// arrays describe the field list in declaration order: each
// index i holds (field_names[i], field_types[i]).
// `derives` carries the declaration's `@derive(...)` list so a conformance
// question can be answered from the Scope — the map-key Eq/Hash check needs it,
// and a derive does not synthesise an entry in the impl table.
// `module` is the declaring module's prefix ("" for the entry), which an
// `opaque` struct's fields are private to.
pub struct StructSig { name: string, field_names: string[], field_types: typeinfo.Type[], type_params: string[], field_type_names: string[], variant_field_names: string[], derives: string[], enum_owner: string, opaque: boolean, module: string }

// MethodSig: nominal handle for a declared receiver method
// `function (recv: RecvType) name(p1, p2): RT`. The receiver
// is implicit at the call site (`obj.name(a, b)`) so it's
// stored separately from param_types. Plain functions live
// in the FuncSig table; the two tables don't overlap.
// `impl_trait` is the trait an impl provided the method through ("" for an
// inherent one), and `line`, `col` and `file` where it was declared, as an
// ambiguity report names it (ambiguous_call_diag).
pub struct MethodSig { name: string, receiver_type: string, param_types: typeinfo.Type[], ret_type: typeinfo.Type, ret_type_name: string, param_type_names: string[], all_type_params: string[], type_params: string[], type_bounds: string[], module: string, impl_trait: string, line: i32, col: i32, file: string }

// UnionSig: nominal handle for a declared type alias —
// `pub type Shape = Circle | Square`. Variants are captured
// as bare type-name strings; variant resolution lives in
// type_assignable, which walks the variant list at use sites.
// is_try carries the decl's `@try` marker, which `?` needs and variant lookup
// does not. A `type X = A | B` alias is never marked, which is the right
// answer for it: native refuses `?` on one exactly as it refuses an unmarked
// enum.
// is_enum separates the two ways a union reaches this table, which decides
// where a variant's PAYLOAD lives: an `enum` owns a backing struct per
// payload-bearing variant (`StructSig.enum_owner` names the enum), while a
// `type U = P | Q` alias's variant IS a declared struct. The struct table is
// keyed by the bare name alone, so without this a plain struct sharing a
// payloadless variant's name is read as that variant's payload (#9900).
// module is the bundle prefix of the import that declared the enum or alias,
// "" for the entry module.
pub struct UnionSig { name: string, variants: string[], is_try: boolean, is_enum: boolean, module: string, type_params: string[], instance: string, visible_from: string[] }

// A flat name → type map plus the function signature table
// plus the struct-decl table plus the union-alias table.
// Parallel arrays keep the implementation trivial.
pub struct Scope {
  names: string[],
  types: typeinfo.Type[],
  // The module's function table, name-indexed. Every scope in a module
  // shares one SigTable by reference — bind / enter_loop / with_ret_type
  // carry it through unchanged — so the index is built once per module,
  // not once per scope.
  sigs: SigTable,
  // The module's struct table, name-indexed and shared by every scope in the
  // module exactly as `sigs` is.
  structs: StructTable,
  // The module's union/enum-alias table, variant-name-indexed and shared by
  // every scope in the module exactly as `sigs` is.
  unions: UnionTable,
  // The type-name tables of `structs` and `unions`, for resolving a spelling.
  names_of_types: TypeNames,
  // The module's receiver-method table, name-indexed and shared the same way.
  methods: MethodTable,
  // What the program imports, and what each of its modules can reach.
  // Shared by every scope in the module exactly as `sigs` and `structs` are.
  imports: Imports,
  // loop_depth tracks nesting depth for break / continue
  // validation. Incremented inside StmtWhile / StmtFor
  // bodies. break / continue at depth 0 surface t_unknown.
  loop_depth: i32,
  // ret_type is the declared return type of the enclosing
  // function body. Populated by check_func_body before walking
  // stmts; StmtReturn compares its value type against this
  // to catch return-type mismatches. TypeUnknown means
  // "no enclosing function" (top-level stmts) — returns there
  // skip the check.
  ret_type: typeinfo.Type,
  // try_ret is the return type a `?` propagates to: the enclosing function's
  // or lambda's. A value block takes a ret_type of its own for its value, but
  // a `?` inside it still returns from the function around it.
  try_ret: typeinfo.Type,
  // impls / trait_reqs carry the module's `impl … for …` table and its
  // trait requirement records, set on every module scope. They drive the E021 generic-bound conformance check at
  // call sites (#4842) and the traits a value coerced into a `dyn` slot
  // must implement.
  impls: parser.ImplInfo[],
  trait_reqs: parser.TraitReq[],
  // fn_module is the module the enclosing function was written in, by
  // prefix ("" for the entry): what a call site may name directly is read
  // against it (trait_visible_from).
  fn_module: string,
  // default_trait / default_recv name the trait and the impl type when the
  // enclosing body is a default the type inherited from that trait: inside
  // it the impl type is known only as the trait's, so the trait's own method
  // outranks another trait's of the same name on that type
  // (ambiguous_call_diags, #12282). Empty on every other scope.
  default_trait: string,
  default_recv: string,
  // tparams / tbounds are the enclosing function's type parameters, bounded,
  // unbounded and its receiver's, and their `+`-joined trait bounds ("" for
  // none), running parallel. Populated by build_func_scope. Each is a rigid
  // type variable in the body (rigid_tparams), and the bounds let an
  // associated call through one (`T.zero()`) resolve against the bound
  // rather than be read as a value (#6933). Empty on every other scope.
  tparams: string[],
  tbounds: string[],
  // lit_locals names the locals in scope an unsettled integer initialised
  // (`let q = 2`), which native types polymorphic until a use fixes a width;
  // settle_literal_locals has annotated every one a use fixed at another
  // width than i32. A value if's or match's arms read one as unsettled.
  lit_locals: string[],
}

// SigTable is the module's function signature table plus a bucket index over
// the signature NAMES. head[b] is the first sigs index in bucket b (-1 when
// empty) and next[i] chains to the next index in the same bucket, ascending —
// so a bucket walk visits candidates in declaration order and a duplicated
// name still resolves to its first declaration, as the linear scan did.
pub struct SigTable {
  sigs: FuncSig[],
  head: i32[],
  next: i32[],
  // The raw floor's signatures, which no module declares.
  raw: RawFloorSig[],
  raw_allowed: boolean,
}

// sig_buckets is the bucket count of the signature index. Prime, so unrelated
// hash strides do not alias onto one bucket. A whole-compiler module declares
// ~4,600 signatures, which this keeps at roughly one per bucket.
function sig_buckets(): i32 {
  return 4093;
}

// sig_name_bucket hashes a signature name to a bucket with the `__str_hash`
// kernel, masked so the `%` cannot return a negative index.
function sig_name_bucket(name: string): i32 {
  return (__str_hash(name, 0) & 1073741823) % 4093;
}

// sig_table indexes `sigs` by name. The chain is built by walking BACKWARD and
// pushing each entry onto the front of its bucket, which leaves every chain in
// ascending index order without needing a per-bucket tail.
function sig_table(sigs: FuncSig[]): SigTable {
  let head: i32[] = util.minus_ones(sig_buckets());
  let next: i32[] = util.minus_ones(sigs.len());
  let k: i32 = sigs.len() - 1;
  while (k >= 0) {
    let nm: string = sigs[k].name;
    let bk: i32 = sig_name_bucket(nm);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    k = k - 1;
  }
  return SigTable { sigs: sigs, head: head, next: next, raw: raw_floor_sigs(), raw_allowed: true };
}

// StructTable is `structs` with a name index over it, built once per module and
// carried by every scope in that module by reference — the SigTable idiom for
// the struct table, which lookup_struct scanned end to end per query.
pub struct StructTable {
  structs: StructSig[],
  // The declared names, in `structs` order.
  index: util.NameIndex,
  // The names a type spelling resolves to a struct by (TypeNames):
  // `type_head_names`.
  heads: util.NameIndex,
  // The module's declared `resource` names, which a handle type names.
  resources: util.NameIndex,
  // The module's spellings resolved once, carried here so a scope's
  // TypeNames reads them (Scope.type_names).
  spellings: SpellMemo,
}

// SpellMemo is the type spellings a module writes, each resolved once against
// its declarations: `types[i]` is what `names.names[i]` resolves to. A
// spelling resolves to the same type wherever the module writes it, since
// type_from_spelling reads only the declared names, so the resolution of the
// few hundred spellings a module repeats hundreds of thousands of times is
// read off this rather than parsed again.
pub struct SpellMemo { names: util.NameIndex, types: typeinfo.Type[] }

function no_spellings(): SpellMemo {
  let none: string[] = [];
  return SpellMemo { names: util.name_index(none), types: [] };
}

// TypeNames is the declared struct and union names a type spelling resolves
// against. A scope reads it off its tables (Scope.type_names); a caller holding
// bare name lists indexes them once with type_names. `spellings` is the
// module's memo, empty for a caller holding bare lists.
pub struct TypeNames {
  structs: util.NameIndex,
  unions: util.NameIndex,
  resources: util.NameIndex,
  spellings: SpellMemo,
}

function type_names(struct_names: string[], union_names: string[], resource_names: string[]): TypeNames {
  return TypeNames { structs: util.name_index(struct_names), unions: util.name_index(union_names), resources: util.name_index(resource_names), spellings: no_spellings() };
}

// with_spellings is `tn` with the module's spellings resolved against it.
function with_spellings(tn: TypeNames, mod: parser.Module): TypeNames {
  let names: util.NameIndex = tn.spellings.names;
  let types: typeinfo.Type[] = [];
  for sp in module_spellings(mod) {
    if (sp.len() == 0 || names.has(sp)) {
      continue;
    }
    names = names.added(sp);
    types = types.append(type_from_spelling(sp, tn));
  }
  return TypeNames { ...tn, spellings: SpellMemo { names: names, types: types } };
}

// module_spellings is the type spellings the module's declarations and the
// statements of its bodies write: parameters, returns, fields and `let`
// annotations. The walk stays on the statement spine, which is where nearly
// every spelling a body reads is written; a spelling it does not reach (a
// lambda's parameters, a `zero`) is parsed where it is read, as every
// spelling was.
function module_spellings(mod: parser.Module): string[] {
  let out: string[] = [];
  for fd in mod.funcs {
    for p in fd.params {
      out = out.append(p.type_name);
    }
    out = out.append(fd.ret_type);
    for st in fd.body {
      out = astwalk.fold_stmt_spine(st, out, spelling_of_stmt);
    }
  }
  for sd in mod.structs {
    for f in sd.fields {
      out = out.append(f.type_name);
    }
  }
  for st in mod.top_stmts {
    out = astwalk.fold_stmt_spine(st, out, spelling_of_stmt);
  }
  return out;
}

function spelling_of_stmt(st: ast.Stmt, own acc: string[]): string[] {
  match (st) {
    ast.StmtVar(v) => {
      return acc.append(v.type_name);
    },
    _ => {
      return acc;
    }
  }
}

// struct_table indexes `structs` by name.
function struct_table(structs: StructSig[], union_names: string[], resources: string[], spellings: SpellMemo): StructTable {
  let names: string[] = [];
  for sd in structs {
    names = names.append(sd.name);
  }
  return StructTable { structs: structs, index: util.name_index(names), heads: util.name_index(type_head_names(structs, union_names)), resources: util.name_index(resources), spellings: spellings };
}

// type_head_names is the struct names a type spelling may resolve to. An
// enum's variant is a StructDecl too, but it is not a type head, so one
// sharing its name with an enum (IoError's `Other` beside a program's own
// `enum Other`) does not claim that name from it.
function type_head_names(structs: StructSig[], union_names: string[]): string[] {
  let unions: util.NameIndex = util.name_index(union_names);
  let out: string[] = [];
  for sd in structs {
    if (sd.enum_owner.len() == 0 || !unions.has(sd.name)) {
      out = out.append(sd.name);
    }
  }
  return out;
}

function resource_names(mod: parser.Module): string[] {
  let out: string[] = [];
  for r in parser.registered_resources(mod) {
    out = out.append(r.name);
  }
  return out;
}

// UnionTable is the module's union/enum-alias table plus a bucket index over
// the VARIANT names — the SigTable idiom for the union table, which
// union_of_variant walked union by union, variant by variant, per query.
pub struct UnionTable {
  unions: UnionSig[],
  // One entry per (union, variant) pair, in declaration order: vnames[e] is the
  // variant spelling and vowner[e] the index into `unions` of the union that
  // declares it. head[b] is the first entry in bucket b (-1 when empty); next[e]
  // chains to the next entry in the same bucket, ascending — so a bucket walk
  // answers with the FIRST declared union naming the variant, as the scan did.
  vnames: string[],
  vowner: i32[],
  // The union/alias names themselves, in `unions` order, indexed for the type
  // resolvers (TypeNames).
  index: util.NameIndex,
  head: i32[],
  next: i32[],
  // lib_head / lib_next index the same entries minus the entry module's enums
  // and union aliases.
  // An import cannot name the entry, and the entry's variants are the only
  // ones the bundler leaves unmangled, so a bare `Ok` in std/json would
  // otherwise resolve to a program's `enum Reply { Ok, … }` (#10120).
  lib_head: i32[],
  lib_next: i32[],
  // from_import selects the lib_ index: the scope is a function an import
  // declared (build_func_scope).
  from_import: boolean,
  // bnames / bhead / bnext index the same entries by the variant's name as
  // its module writes it bare: `Go` for the bundle's `lib__Go`. A bare
  // reference is ambiguous by that name (variant_ambiguous).
  bnames: string[],
  bhead: i32[],
  bnext: i32[],
}

// enum_union_sig registers an enum as a union sig (variants = variant names),
// so an enum-typed scrutinee types to TypeUnion and exhaustiveness and
// union-variant assignability cover enums the way they cover aliases.
function enum_union_sig(ed: parser.EnumDecl): UnionSig {
  return UnionSig { name: ed.name, variants: ed.variant_names, is_try: ed.try_marker, is_enum: true, module: ed.module, type_params: ed.type_params, instance: ed.instance, visible_from: ed.visible_from };
}

// union_table indexes every union's variants by variant name. Built backward so
// each chain ends up in ascending entry order, which is declaration order: a
// variant named by two unions still answers with the first-declared one.
function union_table(unions: UnionSig[]): UnionTable {
  let head: i32[] = util.minus_ones(sig_buckets());
  let vnames: string[] = [];
  let vowner: i32[] = [];
  let u: i32 = 0;
  while (u < unions.len()) {
    let vs: string[] = unions[u].variants;
    let v: i32 = 0;
    while (v < vs.len()) {
      vnames = vnames.append(vs[v]);
      vowner = vowner.append(u);
      v = v + 1;
    }
    u = u + 1;
  }
  let next: i32[] = util.minus_ones(vnames.len());
  let lib_head: i32[] = head;
  let lib_next: i32[] = next;
  let bnames: string[] = [];
  let b: i32 = 0;
  while (b < vnames.len()) {
    bnames = bnames.append(unprefixed_variant(vnames[b], unions[vowner[b]].module));
    b = b + 1;
  }
  let bhead: i32[] = head;
  let bnext: i32[] = next;
  let k: i32 = vnames.len() - 1;
  while (k >= 0) {
    let bk: i32 = sig_name_bucket(vnames[k]);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    if (!declared_by_entry(unions[vowner[k]])) {
      lib_next = lib_next.with(k, lib_head[bk]);
      lib_head = lib_head.with(bk, k);
    }
    let bb: i32 = sig_name_bucket(bnames[k]);
    bnext = bnext.with(k, bhead[bb]);
    bhead = bhead.with(bb, k);
    k = k - 1;
  }
  let names: string[] = [];
  let m: i32 = 0;
  while (m < unions.len()) {
    names = names.append(unions[m].name);
    m = m + 1;
  }
  return UnionTable { unions: unions, vnames: vnames, vowner: vowner, index: util.name_index(names), head: head, next: next, lib_head: lib_head, lib_next: lib_next, from_import: false, bnames: bnames, bhead: bhead, bnext: bnext };
}

function declared_by_entry(u: UnionSig): boolean {
  return u.module.len() == 0;
}

// unprefixed_variant is `name` as module `module` (a bundle prefix, "" for the
// entry) writes it bare: its own mangle prefix taken off.
function unprefixed_variant(name: string, module: string): string {
  let m: i32 = module.len();
  if (m > 0 && name.len() > m + 2 && name[m] == b'_' && name[m + 1] == b'_' && slice_unchecked(name, 0, m) == module) {
    return slice_unchecked(name, m + 2, name.len()) + "";
  }
  return name;
}

// enum_visible_from reports whether a bare variant reference written in
// module `from` may resolve to enum `u`: the module's own enums and those of
// every module its import closure reaches (UnionSig.visible_from).
function enum_visible_from(u: UnionSig, from: string): boolean {
  return u.module == from || util.has_str(u.visible_from, from);
}

// seen_from is the table as the function `fd` reads the variant namespace.
function (ut: UnionTable) seen_from(fd: parser.FuncDecl): UnionTable {
  return UnionTable { ...ut, from_import: fd.module.len() > 0 };
}

// variant_chain_head / variant_chain_next walk the variant index this scope
// sees: every union, or, from an import, every union but the entry's.
function (ut: UnionTable) variant_chain_head(name: string): i32 {
  if (ut.from_import) {
    return ut.lib_head[sig_name_bucket(name)];
  }
  return ut.head[sig_name_bucket(name)];
}

function (ut: UnionTable) variant_chain_next(e: i32): i32 {
  if (ut.from_import) {
    return ut.lib_next[e];
  }
  return ut.next[e];
}

// MethodTable is the module's receiver-method table plus a bucket index over the
// method NAMES. Every method lookup here rejects a candidate on its name before
// testing the receiver, so the index answers exactly the candidates the scan
// reached, in the same order.
pub struct MethodTable {
  methods: MethodSig[],
  // head[b] is the first methods index in bucket b (-1 when empty); next[i]
  // chains to the next index in the same bucket, ascending.
  head: i32[],
  next: i32[],
  // The same chains over the method's SIMPLE name, so a trait's method
  // renamed `Trait.m` when another trait claimed `m` first still answers
  // for `m` (trait_providers).
  shead: i32[],
  snext: i32[],
}

// method_table indexes `methods` by name. Built backward so each chain ends up
// in ascending index order, which is the order the scan visited: two methods
// sharing a name still answer in declaration order.
function method_table(methods: MethodSig[]): MethodTable {
  let head: i32[] = util.minus_ones(sig_buckets());
  let next: i32[] = util.minus_ones(methods.len());
  let shead: i32[] = util.minus_ones(sig_buckets());
  let snext: i32[] = util.minus_ones(methods.len());
  let k: i32 = methods.len() - 1;
  while (k >= 0) {
    let bk: i32 = sig_name_bucket(methods[k].name);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    let sb: i32 = sig_name_bucket(method_simple_name(methods[k].name));
    snext = snext.with(k, shead[sb]);
    shead = shead.with(sb, k);
    k = k - 1;
  }
  return MethodTable { methods: methods, head: head, next: next, shead: shead, snext: snext };
}

// trait_providers is every trait-provided method `name` on receiver type
// `recv_type`, renamed or not, in declaration order: the candidates a call
// written at the concrete type ranks between (ambiguous_call_diags).
function (s: Scope) trait_providers(name: string, recv_type: string): MethodSig[] {
  let out: MethodSig[] = [];
  let i: i32 = s.methods.shead[sig_name_bucket(name)];
  while (i >= 0) {
    let m: MethodSig = s.methods.methods[i];
    if (m.impl_trait.len() > 0 && method_simple_name(m.name) == name && (m.receiver_type == recv_type || parser.parse_type_ref(m.receiver_type).base == recv_type)) {
      out = out.append(m);
    }
    i = s.methods.snext[i];
  }
  return out;
}

// trait_visible_from reports whether a call site in module `from` ("" for
// the entry) can name trait `trait` directly: the trait is the entry's, the
// module's own, or one the module imports (TraitReq.visible_from).
function trait_visible_from(s: Scope, tname: string, from: string): boolean {
  for tr in s.trait_reqs {
    if (tr.trait_name == tname || method_simple_name(tr.trait_name) == method_simple_name(tname)) {
      return tr.module.len() == 0 || tr.module == from || util.has_str(tr.visible_from, from);
    }
  }
  return true;
}

// ambiguous_call_diags is E074 for `recv.m(...)` written at a concrete type
// that takes `m` from two traits, when nothing separates them: a trait the
// call site is bound to answer (the inherited default's own trait on its
// impl type, as the Go checker's `prefer`) wins outright; otherwise the
// traits the call's module can name outrank the rest, and exactly one at
// the best rank resolves, as the Go checker's ResolveMethodFrom ranks them.
// A call already respelled to its provider (`Trait.m`, the bound rewrite
// and an inherited default's routing) names one trait and is never
// ambiguous.
function ambiguous_call_diags(fa: ast.ExprFieldAccess, recv_type: string, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (util.index_of_sub(fa.field, ".") >= 0) {
    return out;
  }
  let cands: MethodSig[] = s.trait_providers(fa.field, recv_type);
  if (cands.len() < 2) {
    return out;
  }
  if (s.default_trait.len() > 0 && recv_type == s.default_recv) {
    for m in cands {
      if (method_simple_name(m.impl_trait) == s.default_trait) {
        return out;
      }
    }
  }
  let best: MethodSig[] = [];
  for m in cands {
    if (trait_visible_from(s, m.impl_trait, s.fn_module)) {
      best = best.append(m);
    }
  }
  if (best.len() == 0) {
    best = cands;
  }
  if (best.len() < 2) {
    return out;
  }
  best = util.sorted_by(best, method_provider_after);
  let providers: string = "";
  for m in best {
    if (providers.len() > 0) {
      providers = providers + " and ";
    }
    providers = providers + sig_provider(m);
  }
  let msg: string = "ambiguous method \"" + fa.field + "\" on " + util.demangle(recv_type) + ": provided by " + providers;
  return out.append(dg_at("E074", msg, fa.line, fa.col));
}

// finalizer_call_diags is E073 for `recv.drop()` on a type with a
// `core/mem.Drop` impl: the drop glue already calls it when the value's last
// reference goes away, so an explicit call runs the finalizer twice.
function finalizer_call_diags(fa: ast.ExprFieldAccess, recv_type: string, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (fa.field != "drop") {
    return out;
  }
  for m in s.trait_providers("drop", recv_type) {
    if (method_simple_name(m.impl_trait) == "Drop") {
      let msg: string = "`drop` is a finalizer, not a method to call: the runtime runs " + util.demangle(recv_type) + "'s `drop` when the value's last reference goes away, so calling it here runs the body a second time on a value that will still be finalized";
      return out.append(dg_at("E073", msg, fa.line, fa.col + 1));
    }
  }
  return out;
}

// sig_provider names a candidate as native's E074 does: the trait and where
// its method was declared.
function method_provider_after(a: MethodSig, b: MethodSig): boolean {
  return a.impl_trait > b.impl_trait;
}

function sig_provider(m: MethodSig): string {
  return "trait " + util.demangle(m.impl_trait) + " (declared at " + m.file + util.i32_to_string(util.pos_line(m.line)) + ":" + util.i32_to_string(m.col) + ")";
}

// decl_file_label is the file a diagnostic names a declaration's position
// with: a stdlib module's file, a module's, or nothing for the entry, which
// the checker is not told the file name of.
function decl_file_label(fd: parser.FuncDecl): string {
  if (fd.stdlib.len() > 0) {
    return fd.stdlib + ".fern:";
  }
  if (fd.module.len() > 0) {
    return fd.module + ".fern:";
  }
  return "";
}

function new_scope(): Scope {
  let ns: string[] = [];
  let ts: typeinfo.Type[] = [];
  let fs: FuncSig[] = [];
  let ss: StructSig[] = [];
  let us: UnionSig[] = [];
  let ms: MethodSig[] = [];
  let structs: StructTable = struct_table(ss, [], [], no_spellings());
  let unions: UnionTable = union_table(us);
  return Scope { names: ns, types: ts, sigs: sig_table(fs), structs: structs, unions: unions, names_of_types: type_names_of(structs, unions), methods: method_table(ms), imports: Imports { paths: [], sights: [] }, loop_depth: 0, ret_type: t_unknown("no enclosing function"), try_ret: t_unknown("no enclosing function"), impls: [], trait_reqs: [], fn_module: "", default_trait: "", default_recv: "", tparams: [], tbounds: [], lit_locals: [] };
}

// new_scope_full is a module's scope. The impl table rides on every one:
// conformance reads it, and so does a generic call whose result is inferred
// through a bound, so two passes over one body must see the same table.
function new_scope_full(st: SigTable, structs: StructTable, unions: UnionTable, methods: MethodTable, imports: Imports, impls: parser.ImplInfo[], trait_reqs: parser.TraitReq[]): Scope {
  let ns: string[] = [];
  let ts: typeinfo.Type[] = [];
  return Scope { names: ns, types: ts, sigs: st, structs: structs, unions: unions, names_of_types: type_names_of(structs, unions), methods: methods, imports: imports, loop_depth: 0, ret_type: t_unknown("no enclosing function"), try_ret: t_unknown("no enclosing function"), impls: impls, trait_reqs: trait_reqs, fn_module: "", default_trait: "", default_recv: "", tparams: [], tbounds: [], lit_locals: [] };
}

function (s: Scope) bind(name: string, t: typeinfo.Type): Scope {
  let ns: string[] = s.names.append(name);
  let ts: typeinfo.Type[] = s.types.append(t);
  if (!util.has_str(s.lit_locals, name)) {
    return Scope { ...s, names: ns, types: ts };
  }
  let lits: string[] = [];
  for lit in s.lit_locals {
    if (lit != name) {
      lits = lits.append(lit);
    }
  }
  return Scope { ...s, names: ns, types: ts, lit_locals: lits };
}

// bind_inferred binds an unannotated local at its initialiser's type `t`, as a
// literal local where an unsettled integer initialises it.
function (s: Scope) bind_inferred(v: ast.StmtVar, t: typeinfo.Type): Scope {
  let b: Scope = s.bind(v.name, cell_new_settled(v.init, t, s));
  if (is_integer(t) && unsettled_tree(v.init, s.lit_locals)) {
    return Scope { ...b, lit_locals: b.lit_locals.append(v.name) };
  }
  return b;
}

// cell_new_settled is the type an unannotated `let c = cell_new(v);` binds:
// with no destination to name the element, `v`'s type does.
function cell_new_settled(init: ast.Expr, t: typeinfo.Type, s: Scope): typeinfo.Type {
  if (!is_cell_type(t) || !is_unknown(cell_elem_type(t))) {
    return t;
  }
  if let ast.ExprCall(c) = init {
    if let ast.ExprIdent(id) = c.callee {
      if (id.name == "cell_new" && c.args.len() == 1) {
        let et: typeinfo.Type = check_expr(c.args[0], s);
        if (!is_unknown(et)) {
          return t_struct_g("Cell", [et]);
        }
      }
    }
  }
  return t;
}

// with_tparams attaches the enclosing function's type parameters and their
// trait bounds. Read by assoc_call_req to resolve `T.zero()`.
function (s: Scope) with_tparams(tparams: string[], tbounds: string[]): Scope {
  return Scope { ...s, tparams: tparams, tbounds: tbounds };
}

// is_const_param reports whether `name` is a const parameter of the enclosing
// function (`const N: i32`).
function (s: Scope) is_const_param(name: string): boolean {
  let i: i32 = util.index_of_str(s.tparams, name);
  if (i < 0 || i >= s.tbounds.len() || !parser.is_const_bound(s.tbounds[i])) {
    return false;
  }
  // A later binding of the name is a local that shadows the parameter.
  return util.index_of_str(s.names, name) == s.binding_index(name);
}

// resolve_type resolves a type SPELLING as written in this scope: the enclosing
// function's type parameters are type VARIABLES, every other name resolves
// against the declared structs and unions. Every spelling read while checking a
// body goes through here — a `let` annotation, a lambda's parameter or return,
// a cast — so a type parameter cannot be captured by a same-named declared type
// at one of them.
function (s: Scope) type_names(): TypeNames {
  return s.names_of_types;
}

function type_names_of(structs: StructTable, unions: UnionTable): TypeNames {
  return TypeNames { structs: structs.heads, unions: unions.index, resources: structs.resources, spellings: structs.spellings };
}

function (s: Scope) resolve_type(name: string): typeinfo.Type {
  return type_from_name_subst(name, s.tparams, rigid_tparams(s.tparams), s.type_names());
}

// defines reports whether `name` is bound in scope (param, receiver,
// local var, loop variable, or match-payload binding) — distinct from
// `lookup`, which returns the bound type and can't tell "not in scope"
// apart from "in scope with an unknown type". E001 (undefined name) needs
// the membership test, not the type.
function (s: Scope) defines(name: string): boolean {
  let i: i32 = s.names.len() - 1;
  while (i >= 0) {
    if (s.names[i] == name) {
      return true;
    }
    i = i - 1;
  }
  return false;
}

// name_has_comma reports whether a binding name encodes multiple names
// (a `for (k, v)` loop variable or a `let (a, b)` destructure).
function name_has_comma(name: string): boolean {
  for ch in name {
    if (ch == b',') {
      return true;
    }
  }
  return false;
}

// bind_destructure_names binds the names a destructuring `let`
// declares. check_stmt binds them under the ONE comma-joined name they are
// encoded as, so without this a later read of `a` resolves to nothing and
// infers unknown — which marks the whole function ill-typed, with no
// diagnostic to say why (`let (a, b) = t; return a + b;` was rejected).
//
// Each binding takes its ELEMENT type, not a placeholder: a tuple position
// from the init's tuple type, a struct field by re-typing the field read the
// lowering will emit, and the `@` binding the whole value's type. Binding them
// as unknown would resolve the name and still fail the same strictness check.
//
// A plain `let` is left alone — rebinding it here would shadow the precise
// type check_stmt gave it (lookup is newest-first) and break type-dependent
// diagnostics downstream. A single-field struct destructure (`let P { x } = e;`)
// has no comma, so the marker rather than the comma is what says a statement
// is a destructure.
function bind_destructure_names(s: Scope, v: ast.StmtVar): Scope {
  if (!name_has_comma(v.name) && !parser.is_destr_marker(v.type_name)) {
    return s;
  }
  let at: string = parser.destr_marker_split(v.type_name).at;
  let whole: typeinfo.Type = check_expr(v.init, s);
  let out: Scope = s;
  if (at.len() > 0) {
    out = out.bind(at, whole);
  }
  if (parser.is_struct_destr_marker(v.type_name)) {
    return bind_struct_destr_fields(out, v, s);
  }
  return bind_tuple_destr_names(out, split_pattern_names(v.name), whole);
}

// bind_struct_destr_fields binds `let P { x, y: b } = e;`. The marker pairs
// each binding with the FIELD it reads, and the field read is re-typed through
// check_expr — the same expression the lowering emits — so a renamed binding,
// a generic struct and an opaque field all type exactly as they would there.
function bind_struct_destr_fields(out: Scope, v: ast.StmtVar, s: Scope): Scope {
  let (fields, ok) = struct_destr_fields(v.type_name);
  if (!ok) {
    return bind_names(out, v.name);
  }
  let names: string[] = split_pattern_names(v.name);
  let i: i32 = 0;
  while (i < names.len()) {
    let ft: typeinfo.Type = t_unknown("binding");
    if (i < fields.len()) {
      ft = check_expr(ast.ExprFieldAccess { obj: v.init, field: fields[i], line: v.line, col: v.col, ty: "", const_read: false }, s);
    }
    out = out.bind(names[i], ft);
    i = i + 1;
  }
  return out;
}

// struct_destr_fields is the fields a struct destructure's marker reads, in
// the order it binds them, and false when the marker names none.
function struct_destr_fields(type_name: string): (string[], boolean) {
  let marker: string = parser.destr_marker_split(type_name).tag;
  let rest: string = slice_unchecked(marker, 4, marker.len()) + "";
  let colon: i32 = util.index_of_sub(rest, ":");
  if (colon < 0) {
    return ([], false);
  }
  return (split_pattern_names(slice_unchecked(rest, colon + 1, rest.len()) + ""), true);
}

// struct_destr_name is the struct a struct destructure's marker names.
function struct_destr_name(type_name: string): string {
  let marker: string = parser.destr_marker_split(type_name).tag;
  let rest: string = slice_unchecked(marker, 4, marker.len()) + "";
  let colon: i32 = util.index_of_sub(rest, ":");
  if (colon < 0) {
    return "";
  }
  return slice_unchecked(rest, 0, colon) + "";
}

// opaque_access_diags is E021 for reaching into the fields of `sig` (`what`
// names the access) from a module other than the one that declared it opaque.
// The type's name and methods stay usable everywhere.
function opaque_access_diags(sig: StructSig, s: Scope, what: string, line: i32, col: i32): util.Diag[] {
  if (!sig.opaque || sig.module == s.fn_module) {
    return [];
  }
  return [dg_at("E021", "cannot " + what + " opaque type " + util.demangle(sig.name) + " outside the module that defines it", line, col)];
}

// struct_destr_diags is E043 for each field a struct destructure
// `let P { x, z } = e;` reads that the struct `e` is lacks, at the `let`, as
// native reports it. The field has no position of its own, so its fix stands
// at the `let` too and names the field written after it.
function struct_destr_diags(v: ast.StmtVar, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (!parser.is_struct_destr_marker(v.type_name)) {
    return out;
  }
  let (fields, _) = struct_destr_fields(v.type_name);
  let it: typeinfo.Type = check_expr(v.init, s);
  match (it) {
    typeinfo.TypeStruct(st) => {
      let named: string = struct_destr_name(v.type_name);
      if (named.len() > 0 && named != st.name) {
        return out.append(dg_at("E024", "struct destructure pattern names " + named + ", but the expression is " + st.name, v.line, v.col));
      }
      let sig: StructSig = s.lookup_struct(st.name);
      let access: string = "destructure a field of";
      if (parser.destr_marker_split(v.type_name).struct_match) {
        access = "destructure";
      }
      out = util.append_diags(out, opaque_access_diags(sig, s, access, v.line, v.col));
      for f in fields {
        if (sig.name.len() > 0 && !util.has_str(sig.field_names, f)) {
          let d: util.Diag = dg_at("E043", "struct " + util.demangle(st.name) + " has no field \"" + f + "\"", v.line, v.col);
          out = out.append(with_fix(d, f, v.line, v.col, util.suggest(f, sig.field_names), ""));
        }
      }
    },
    typeinfo.TypeUnknown(_) => {},
    _ => {
      out = out.append(dg_at("E024", "struct destructure needs a struct expression, got " + type_label(it), v.line, v.col));
    }
  }
  return out;
}

// bind_tuple_destr_names binds `let (a, (b, c)) = t;` against the init's tuple
// type, recursing into a parenthesised position — which the name encoding
// carries inline — so an inner binding is typed rather than left dangling.
function bind_tuple_destr_names(out: Scope, names: string[], whole: typeinfo.Type): Scope {
  let elems: typeinfo.Type[] = [];
  match (whole) {
    typeinfo.TypeTuple(tt) => {
      elems = tt.elements;
    },
    _ => {}
  }
  let i: i32 = 0;
  while (i < names.len()) {
    let nm: string = names[i];
    let et: typeinfo.Type = t_unknown("binding");
    if (i < elems.len()) {
      et = elems[i];
    }
    if (util.is_tuple_type_name(nm)) {
      out = bind_tuple_destr_names(out, split_pattern_names(slice_unchecked(nm, 1, nm.len() - 1) + ""), et);
    } else if (nm.len() > 0) {
      out = out.bind(nm, et);
    }
    i = i + 1;
  }
  return out;
}

// split_pattern_names splits a destructure's comma-joined encoding on
// TOP-LEVEL commas, so a nested position `(b,c)` stays one entry — the split
// bind_names does not make, which is why it mis-bound `(b` and `c)`.
pub function split_pattern_names(encoded: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i <= encoded.len()) {
    if (i == encoded.len() || encoded[i] == b',' && depth == 0) {
      if (i > start) {
        out = out.append(slice_unchecked(encoded, start, i) + "");
      }
      start = i + 1;
    } else if (encoded[i] == b'(') {
      depth = depth + 1;
    } else if (encoded[i] == b')') {
      depth = depth - 1;
    }
    i = i + 1;
  }
  return out;
}

// bind_names binds a `for (k, v) in m` loop's variables, encoded by the parser
// as a single comma-joined name ("k,v"): split on the comma and bind each.
// Types are unknown here — the E001 membership check only needs the names to
// be in scope. A destructuring `let` goes through
// bind_destructure_names instead, which types each binding.
//
// A nested position uses the same encoding as a parenthesised group
// ("(a,b),s" for `for ((a, b), s) in xs`), so the split is depth-aware and
// recurses: splitting on every comma bound "(a" and "b)" and left `a` and `b`
// undefined (#8461).
function bind_names(s: Scope, name: string): Scope {
  let out: Scope = s;
  for nm in split_pattern_names(name) {
    if (util.is_tuple_type_name(nm)) {
      out = bind_names(out, slice_unchecked(nm, 1, nm.len() - 1) + "");
    } else if (nm.len() > 0) {
      out = out.bind(nm, t_unknown("binding"));
    }
  }
  return out;
}

// is_builtin_variant reports whether `name` is a variant of an enum the
// front-end auto-injects (Option / Result, plus IoError / Body via
// parser.inject_builtin_enums) — these can be referenced bare (e.g.
// `return None;`) without a local declaration, so E001 must not flag them.
// Derived from the single variant→enum table in parser.builtin_enum_of so the
// builtin-variant list lives in exactly one place (SH-046).
function is_builtin_variant(name: string): boolean {
  return parser.builtin_enum_of(name).len() > 0;
}

// variant_in_unions reports whether `name` is a variant of ANY declared
// enum/union in scope.
function variant_in_unions(name: string, unions: UnionTable): boolean {
  let e: i32 = unions.variant_chain_head(name);
  while (e >= 0) {
    if (unions.vnames[e] == name) {
      return true;
    }
    e = unions.variant_chain_next(e);
  }
  return false;
}

// is_nopayload_builtin_variant reports whether `name` is a NO-payload variant
// of a front-end-injected builtin enum — the only builtin variants that appear
// bare as a value (`None`, `JNull`, and `IoError`'s two unit variants). The
// payload builtins (`Some` / `Ok` / `Err` / the `J*` data variants / the five
// `IoError` variants that carry a path) instead appear as constructor CALLS
// (`Some(3)`, `NotFound(path)`), handled in check_call_expr; resolving one
// bare would mistype the callee as a value and trip a "calling non-function
// value" E038 (#4346 piece 2, #9066).
function is_nopayload_builtin_variant(name: string): boolean {
  if (name == "None") {
    return true;
  }
  if (name == "JNull") {
    return true;
  }
  if (name == "Interrupted" || name == "Unsupported") {
    return true;
  }
  return false;
}

// union_sig_of_variant returns the first declared enum/union in scope that
// lists `name` as a variant, or the empty sig when none does.
function union_sig_of_variant(name: string, unions: UnionTable): UnionSig {
  let e: i32 = unions.variant_chain_head(name);
  while (e >= 0) {
    if (unions.vnames[e] == name) {
      return unions.unions[unions.vowner[e]];
    }
    e = unions.variant_chain_next(e);
  }
  let empty_v: string[] = [];
  return UnionSig { name: "", variants: empty_v, is_try: false, is_enum: false, module: "", type_params: [], instance: "", visible_from: [] };
}

// union_of_variant returns the NAME of that union, or "" when none declares
// `name`. Used by check_expr to type a bare no-payload enum variant used as a
// value (#4346 piece 2).
function union_of_variant(name: string, unions: UnionTable): string {
  return union_sig_of_variant(name, unions).name;
}

// variant_value_payloads is how many payloads variant `name` carries, so how
// many its constructor call takes: an enum variant's fields, one for a union's
// struct member, one for Some / Ok / Err. `en` is the enum a qualified
// reference names, or "" for a bare one. Zero means the variant stands as a
// value.
//
// Asking the struct table by name alone gets this wrong when a plain struct
// shares a payloadless variant's name (#9900): the table is keyed by the bare
// name, so the two share a bucket and the answer is whichever registered first
// — the struct, declared first, reading its own fields as the variant's
// payload. Scoping the enum case to the owner keeps the two namespaces apart
// the way native's `info.Structs` and `variantOf` are.
function variant_value_payloads(s: Scope, en: string, name: string): i32 {
  let owner: UnionSig = union_sig_of_variant(name, s.unions);
  if (en.len() > 0) {
    owner = s.lookup_union(en);
  }
  if (owner.is_enum) {
    let vs: StructSig = s.lookup_owned_struct(name, owner.name);
    if (vs.enum_owner == owner.name) {
      return vs.field_names.len();
    }
    return 0;
  }
  if (owner.name.len() > 0) {
    if (s.lookup_struct(name).field_names.len() > 0) {
      return 1;
    }
    return 0;
  }
  return builtin_variant_payloads(s, en, name);
}

// builtin_variant_payloads is variant_value_payloads for a variant no enum in
// scope declares: Option's and Result's, and the injected enums'.
function builtin_variant_payloads(s: Scope, en: string, name: string): i32 {
  let builtin: string = parser.builtin_enum_of(name);
  if (builtin.len() == 0 || en.len() > 0 && en != builtin) {
    return 0;
  }
  if (builtin == "Option" || builtin == "Result") {
    if (name == "None") {
      return 0;
    }
    return 1;
  }
  let injected: StructSig = s.lookup_owned_struct(name, builtin);
  if (injected.enum_owner == builtin) {
    return injected.field_names.len();
  }
  return 0;
}

// payload_variant_value_diag is E036 for a payload variant read as a value
// instead of called; `shown` is the reference as written.
function payload_variant_value_diag(shown: string, payloads: i32, line: i32, col: i32): util.Diag {
  return dg_at("E036", "variant " + shown + " expects " + util.i32_to_string(payloads) + " payload argument(s); call it as " + shown + "(...)", line, col);
}

// no_variant_diag is E036 for `Enum.Variant` naming a variant the enum lacks.
function no_variant_diag(s: Scope, en: string, field: string, line: i32, col: i32): util.Diag {
  return dg_at("E036", "enum " + shown_enum(s, en) + " has no variant \"" + unprefixed_variant(field, s.lookup_union(en).module) + "\"", line, col);
}

// shown_variant is how a diagnostic names variant `name`, bare or written
// `Enum.Variant`: bare, without the prefix of the module that declares it.
function shown_variant(s: Scope, name: string): string {
  let bare: string = variant_pattern_name(name);
  let owner: UnionSig = union_sig_of_variant(bare, s.unions);
  if (variant_pattern_owner(name).len() > 0) {
    owner = s.lookup_union(variant_pattern_owner(name));
  }
  return unprefixed_variant(bare, owner.module);
}

// shown_variant_in is shown_variant read off the variant's own payload
// struct, for a check that has only the struct table.
function shown_variant_in(structs: StructTable, name: string): string {
  return unprefixed_variant(variant_pattern_name(name), find_variant_sig(structs, name).module);
}

// shown_enum is how a diagnostic names enum `name`: `mod.Name` when another
// module declares it, as the program writes it.
function shown_enum(s: Scope, name: string): string {
  let m: string = s.lookup_union(name).module;
  let bare: string = unprefixed_variant(name, m);
  if (bare == name || m == s.fn_module) {
    return bare;
  }
  return m + "." + bare;
}

// unknown_variant_diag is E014 for a match arm naming a variant that the
// scrutinee's enum `u` does not declare.
function unknown_variant_diag(s: Scope, name: string, u: UnionSig, line: i32, col: i32): util.Diag {
  let shown: string = unprefixed_variant(name, u.module);
  let hint: string = " — a bare name in arm position is a VARIANT, not a binding; for a catch-all use `_`, binding the scrutinee to a variable first if you need its value";
  let best: string = "";
  let best_d: i32 = 0;
  for v in u.variants {
    let d: i32 = util.levenshtein(shown, unprefixed_variant(v, u.module));
    if (d <= shown.len() / 3 + 1 && (best.len() == 0 || d < best_d)) {
      best = unprefixed_variant(v, u.module);
      best_d = d;
    }
  }
  if (best.len() > 0) {
    hint = " (did you mean \"" + best + "\"?)";
  }
  return dg_at("E014", "variant \"" + shown + "\" is not part of enum " + shown_enum(s, u.name) + hint, line, col);
}

// is_resolvable_value reports whether a bare identifier in VALUE position
// resolves to something defined: a local / param / loop / match binding, a
// free function or 0-arg const (used as a value), an enum/union variant
// (declared or builtin; an ambiguous one is E036 instead), or a struct name.
// Anything else is E001. Builtin
// FUNCTIONS (print / read_file / …) are only ever called, never read as a
// bare value, so they don't need to be listed here — call callees are
// checked separately (and aren't flagged by this value-position pass).
function is_resolvable_value(name: string, s: Scope): boolean {
  if (s.defines(name)) {
    return true;
  }
  if (s.has_sig(name)) {
    return true;
  }
  if (variant_in_unions(name, s.unions) || s.variant_ambiguous(name)) {
    return true;
  }
  if (is_builtin_variant(name)) {
    return true;
  }
  // A bare STRUCT type name is NOT a value — `return P` / `let x = P` for a
  // standalone struct P is E001 in the Go checker (you construct with the
  // `P { … }` literal, an ExprStructLit, which never reaches here). Union
  // members and enum-variant constructors are caught above by
  // variant_in_unions / is_builtin_variant, so dropping the struct-name case
  // only rejects pure type names — matching Go, with no new false positive
  // (Go flags the same bare names). Struct CALLS (none exist — there's no
  // `P(...)` form) go through is_resolvable_callee, which never consulted
  // lookup_struct either.
  // A function — user or builtin — may also be referenced as a bare
  // value (e.g. `let w = write;` or passing a function by name).
  let floor: i32 = raw_floor_at(s.sigs, name);
  if (floor >= 0 || util.str_has_prefix(name, "__raw_") || util.str_has_prefix(name, "__syscall")) {
    return floor >= 0 && raw_floor_allowed(s.sigs, name);
  }
  if (name.len() >= 2 && slice_unchecked(name, 0, 2) == "__") {
    return true;
  }
  if (parser.is_builtin_function(name)) {
    return true;
  }
  return false;
}

// is_resolvable_callee reports whether a bare-identifier CALL target
// resolves: a local (closure value), a free function, a variant
// constructor (declared or builtin; an ambiguous one is E036 instead), a
// runtime intrinsic (`__`-prefixed), or a builtin function. Anything else is
// an undefined call → E001.
function is_resolvable_callee(name: string, s: Scope): boolean {
  if (s.defines(name)) {
    return true;
  }
  if (s.has_sig(name)) {
    return true;
  }
  if (variant_in_unions(name, s.unions) || s.variant_ambiguous(name)) {
    return true;
  }
  if (is_builtin_variant(name)) {
    return true;
  }
  let floor: i32 = raw_floor_at(s.sigs, name);
  if (floor >= 0 || util.str_has_prefix(name, "__raw_") || util.str_has_prefix(name, "__syscall")) {
    return floor >= 0 && raw_floor_allowed(s.sigs, name);
  }
  if (name.len() >= 2 && slice_unchecked(name, 0, 2) == "__") {
    return true;
  }
  if (parser.is_builtin_function(name)) {
    return true;
  }
  return false;
}

// for_iter_is_range reports whether a for-loop iter is the synthetic
// `__range(LOW, HIGH)` / `__range_incl(LOW, HIGH)` call the parser emits
// for `for i in LOW..HIGH` / `for i in LOW..=HIGH`. The checker binds the
// loop var from it (range_var_type).
function for_iter_is_range(iter: ast.Expr): boolean {
  match (iter) {
    ast.ExprCall(c) => {
      if (c.args.len() != 2) {
        return false;
      }
      match (c.callee) {
        ast.ExprIdent(id) => {
          return id.name == "__range" || id.name == "__range_incl";
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

function (s: Scope) enter_loop(): Scope {
  return Scope { ...s, loop_depth: s.loop_depth + 1 };
}

function (s: Scope) with_ret_type(rt: typeinfo.Type): Scope {
  return Scope { ...s, ret_type: rt, try_ret: rt };
}

// with_block_ret is with_ret_type for a value block: its ret_type is the
// block's value, and a `?` inside it still propagates to try_ret.
function (s: Scope) with_block_ret(rt: typeinfo.Type): Scope {
  return Scope { ...s, ret_type: rt };
}

// binding_index is the index of `name`'s newest binding, -1 for none: a
// linear scan from the end, so shadowing works naturally in a single flat
// scope.
function (s: Scope) binding_index(name: string): i32 {
  let i: i32 = s.names.len() - 1;
  while (i >= 0) {
    if (s.names[i] == name) {
      return i;
    }
    i = i - 1;
  }
  return 0 - 1;
}

function (s: Scope) lookup(name: string): typeinfo.Type {
  let i: i32 = s.binding_index(name);
  if (i >= 0) {
    return s.types[i];
  }
  return t_unknown("undefined identifier:" + name);
}

// known reports whether `name` is bound to a type the checker worked out:
// lookup's answer is not unknown. A miss builds nothing.
function (s: Scope) known(name: string): boolean {
  let i: i32 = s.binding_index(name);
  return i >= 0 && !is_unknown(s.types[i]);
}

// is_bound reports whether `name` has a binding in scope, however typed —
// lookup's unknown result conflates "bound opaquely" with "not bound", and
// the function-value shadowing question needs the difference.
function (s: Scope) is_bound(name: string): boolean {
  return s.binding_index(name) >= 0;
}

// lookup_assoc_sig finds the associated function `field` of the type `tyname`:
// a declaration with no receiver name whose receiver type is that type. The
// empty sig when there is none.
function (s: Scope) lookup_assoc_sig(tyname: string, field: string): FuncSig {
  for sig in s.sigs.sigs {
    if (sig.name == field && sig.receiver.len() > 0 && util.base_type_name(sig.receiver) == tyname) {
      return sig;
    }
  }
  return s.lookup_sig("");
}

// sig_at is the index of `name`'s signature in the scope's table, or -1. A
// free function wins over an associated function of the same name, which a
// bare call cannot name (#11844).
function (s: Scope) sig_at(name: string): i32 {
  let first: i32 = 0 - 1;
  let i: i32 = s.sigs.head[sig_name_bucket(name)];
  while (i >= 0) {
    if (s.sigs.sigs[i].name == name) {
      if (s.sigs.sigs[i].receiver.len() == 0) {
        return i;
      }
      if (first < 0) {
        first = i;
      }
    }
    i = s.sigs.next[i];
  }
  return first;
}

function (s: Scope) lookup_sig(name: string): FuncSig {
  let i: i32 = s.sig_at(name);
  if (i >= 0) {
    return s.sigs.sigs[i];
  }
  // Sentinel: empty name + empty param list + unknown ret_type tells callers
  // the name isn't a function. The reason carries no name because no caller
  // reads it — every one gates on `name.len()` (or `is_const`) first — and
  // building one per miss concatenated a string the miss then discarded.
  let empty: typeinfo.Type[] = [];
  let non: string[] = [];
  return FuncSig { receiver: "", name: "", param_types: empty, param_own: [], ret_type: t_unknown("undefined function"), all_type_params: [], type_params: [], type_bounds: [], ret_type_name: "", param_type_names: non, param_names: [], is_const: false, typevars: [], module: "", refs: [] };
}

// tp_bound_for returns the `+`-joined trait bound(s) on type parameter
// `ptype`, else "". type_params and bound_traits run parallel
// (parser.parse_func_decl); a promoted unbounded param has an empty
// bound_traits entry and yields "".
function tp_bound_for(ptype: string, type_params: string[], bound_traits: string[]): string {
  let k: i32 = 0;
  while (k < type_params.len()) {
    if (type_params[k] == ptype) {
      if (k < bound_traits.len()) {
        return bound_traits[k];
      }
      return "";
    }
    k = k + 1;
  }
  return "";
}

// e021_trait_idx returns the index of trait `tr`'s requirement record in
// trait_reqs, or -1 if `tr` names no trait declared in this module.
function e021_trait_idx(tr: string, trait_reqs: parser.TraitReq[]): i32 {
  let i: i32 = 0;
  while (i < trait_reqs.len()) {
    if (trait_reqs[i].trait_name == tr) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// e021_scope_has_impl is the scope-carried analogue of e021_has_impl: does
// the module contain `impl <trait_name> for <impl_type>`? Keyed on the base
// name, as native's impl table is, so `impl[T] Tr for W[T]` covers `W[i32]`.
function e021_scope_has_impl(impls: parser.ImplInfo[], trait_name: string, impl_type: string): boolean {
  let base: string = util.base_type_name(impl_type);
  for imp in impls {
    if (imp.trait_name == trait_name && util.base_type_name(imp.impl_type) == base) {
      return true;
    }
  }
  return false;
}

// conforms_by_impl_or_derive names whether `tyname` implements trait `tr`:
// an explicit `impl tr for tyname`, or a `@derive(cmp.tr)` on the declaration
// — for an enum, on any variant, which carries the owner's derives. Both
// sources, because a derive does not synthesise an impl-table entry.
//
// Written for map keys (E045) and now also the generic-bound check (E021),
// which are the same question asked twice.
function conforms_by_impl_or_derive(s: Scope, tyname: string, tr: string): boolean {
  return e021_scope_has_impl(s.impls, tr, tyname) || derives_trait(s, tyname, tr);
}

// derives_trait: a `@derive` of trait `tr` (by simple name) on `tyname`'s
// declaration, or for an enum on any variant, which carries the owner's derives.
function derives_trait(s: Scope, tyname: string, tr: string): boolean {
  for sd in s.structs.structs {
    if (sd.name == tyname || sd.enum_owner == tyname) {
      for derive in sd.derives {
        if (parser.derive_simple_name(derive) == tr) {
          return true;
        }
      }
    }
  }
  return false;
}

// conforms_to_dyn_trait: `tyname` implements the trait a dyn set spells as
// `tr`, which flatten spells by the module that declares it — an impl of that
// trait, not of another module's trait of the same name — or derives it.
function conforms_to_dyn_trait(s: Scope, tyname: string, tr: string): boolean {
  let key: string = util.base_type_name(tr);
  for imp in s.impls {
    if (parser.impl_trait_key(imp) == key && parser.receiver_base(imp.impl_type) == parser.receiver_base(tyname)) {
      return true;
    }
  }
  return derives_trait(s, tyname, parser.derive_simple_name(key));
}

// map_key_type_error returns the E045 message describing why `kt` cannot be a
// map key, or "" if it is usable. Usable keys are integers, chars, strings,
// struct / enum types deriving both Eq and Hash (#2671), and tuples and arrays
// of usable scalar keys (#10020) — the same set native accepts.
function map_key_type_error(s: Scope, kt: typeinfo.Type): string {
  // A type variable's key is checked where it is instantiated.
  if (is_unknown(kt) || is_type_variable(kt) || is_integer(kt) || type_eq(kt, t_char()) || type_eq(kt, t_string()) || type_eq(kt, t_str())) {
    return "";
  }
  if (is_tuple_or_array(kt)) {
    if (structural_map_key(kt)) {
      return "";
    }
    return "map key type " + type_label(kt) + " is not supported — a tuple or array used as a key may hold only integers, booleans, chars, strings, and such tuples and arrays";
  }
  if let typeinfo.TypeBool(_) = kt {
    return "";
  }
  let kn: string = "";
  let kw: string = "";
  match (kt) {
    typeinfo.TypeStruct(st) => {
      kn = st.name;
      kw = "a struct";
    },
    typeinfo.TypeUnion(u) => {
      if (u.name != "Option" && u.name != "Result") {
        kn = u.name;
        kw = "an enum";
      }
    },
    _ => {}
  }
  if (kn != "") {
    if (conforms_by_impl_or_derive(s, kn, "Eq") && conforms_by_impl_or_derive(s, kn, "Hash")) {
      return "";
    }
    return "map key type " + type_label(kt) + " is not supported — " + kw + " used as a key must derive Eq and Hash: add `@derive(cmp.Eq, cmp.Hash)`, which requires `import \"core/cmp\";`";
  }
  return "map key type " + type_label(kt) + " is not yet supported — use i32, string, or a struct/enum with `@derive(cmp.Eq, cmp.Hash)`, which requires `import \"core/cmp\";`";
}

function is_tuple_or_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  return false;
}

// A tuple or array key compared and hashed element by element: every element
// an integer, a boolean, a char, a string, or another such tuple or array.
// ssasem.structural_map_key is the lowering's copy of this rule.
function structural_map_key(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      if (!structural_key_element(e)) {
        return false;
      }
    }
    return tup.elements.len() > 0;
  }
  if let typeinfo.TypeArray(a) = t {
    return structural_key_element(a.elem);
  }
  return false;
}

function structural_key_element(t: typeinfo.Type): boolean {
  if (type_eq(t, t_string()) || structural_map_key(t)) {
    return true;
  }
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  if let typeinfo.TypeI32(_) = t {
    return true;
  }
  return false;
}

// mlit_entries_settle reports whether every entry of a desugared map literal
// settles to, or is assignable to, the destination's key and value types.
function mlit_entries_settle(e: ast.Expr, want: typeinfo.TypeMap, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprFieldAccess(fa) = c.callee {
      if (fa.field != "insert" || c.args.len() != 2) {
        return false;
      }
      if (!settles_or_assignable(c.args[0], want.key, s) || !settles_or_assignable(c.args[1], want.value, s)) {
        return false;
      }
      return mlit_is_base(fa.obj) || mlit_entries_settle(fa.obj, want, s);
    }
  }
  return false;
}

// mlit_is_desugared reports whether `e` is a map LITERAL as the parser leaves
// it: an `.insert(k, v)` chain bottoming out at the `map_new` / `__map_new_i32`
// base. The literal's own key check (the first insert, above) reports E045 for
// it already, so the destination check skips these and the two do not both
// fire — native skips its MapLit destinations for the same reason. A bare
// `map_new(n)` is NOT one: it is an ordinary call with no key to infer from,
// which is exactly the case the destination check exists for.
function mlit_is_desugared(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(c) => {
      // Written calls carry a source position. Only parser-generated
      // inserts may settle their entries against a destination's columns.
      if (c.line != 0 || c.col != 0) {
        return false;
      }
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "insert") {
            return false;
          }
          if (mlit_is_base(fa.obj)) {
            return true;
          }
          return mlit_is_desugared(fa.obj);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// literal_insert reports whether `c` is one of the `.insert(k, v)` calls a
// map literal desugars to. The parser builds those without a source position;
// a written call carries its own.
function literal_insert(c: ast.ExprCall): boolean {
  return c.line == 0 && c.col == 0 && mlit_is_desugared(c);
}

// e045_map_key_msgs collects the E045 message for every `Map[K, V]` inside one
// WRITTEN type, at any nesting depth — so a `Map[f64, i32][]` field or a
// `(string, Map[f64, i32])` parameter is reached as well as the bare form.
//
// The map-literal path checks the key it INFERS from the first `.insert`.
// A `Map[K, V]` written as an annotation has no literal to infer from, so
// without this nothing asked, and `let m: Map[f64, i32] = map_new(2)` reached
// codegen with a key no backend has a column for (#10009).
function e045_map_key_msgs(t: typeinfo.Type, s: Scope): string[] {
  let out: string[] = [];
  match (t) {
    typeinfo.TypeMap(mt) => {
      out = util.append_all(out, map_shape_msgs(s, mt));
      out = util.append_all(out, e045_map_key_msgs(mt.key, s));
      out = util.append_all(out, e045_map_key_msgs(mt.value, s));
    },
    typeinfo.TypeArray(a) => {
      out = util.append_all(out, e045_map_key_msgs(a.elem, s));
    },
    typeinfo.TypeTuple(tup) => {
      for elem in tup.elements {
        out = util.append_all(out, e045_map_key_msgs(elem, s));
      }
    },
    typeinfo.TypeStruct(st) => {
      for arg in st.args {
        out = util.append_all(out, e045_map_key_msgs(arg, s));
      }
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        out = util.append_all(out, e045_map_key_msgs(arg, s));
      }
    },
    typeinfo.TypeFunc(f) => {
      for pt in f.param_types {
        out = util.append_all(out, e045_map_key_msgs(pt, s));
      }
      out = util.append_all(out, e045_map_key_msgs(f.ret_type, s));
    },
    _ => {}
  }
  return out;
}

// map_shape_msgs is E045's messages for one map's own key and value: a value
// of void makes it a set of keys, which std/set holds and no column does.
function map_shape_msgs(s: Scope, mt: typeinfo.TypeMap): string[] {
  let out: string[] = [];
  let msg: string = map_key_type_error(s, mt.key);
  if (msg != "") {
    out = out.append(msg);
  }
  if (is_void(mt.value)) {
    out = out.append("map value type void is not supported — a set of keys is std/set's `Set`");
  }
  return out;
}

// e045_annot_diags reports the annotation-form E045 for one written spelling,
// anchored where the caller says. An empty / un-annotated spelling emits
// nothing, and a spelling naming no map emits nothing.
function e045_annot_diags(type_name: string, line: i32, col: i32, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (type_name.len() == 0) {
    return out;
  }
  for msg in e045_map_key_msgs(s.resolve_type(type_name), s) {
    out = out.append(dg_at("E045", msg, line, col));
  }
  return out;
}

// call_bound_diags is E021 for each trait bound that the type a generic call
// binds its type parameter to does not implement, at the call (`ln`:`cl`),
// naming the callee as `site` (native checkTypeArgBounds). `bounds` runs
// parallel to `tparams` and was written in `module`. A parameter left unbound,
// or bound to a type variable of the enclosing generic, is the instance's to
// check.
function call_bound_diags(tparams: string[], bounds: string[], module: string, site: string, bn: string[], bt: typeinfo.Type[], s: Scope, ln: i32, cl: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let i: i32 = 0;
  while (i < tparams.len() && i < bounds.len()) {
    let bi: i32 = util.index_of_str(bn, tparams[i]);
    if (bi >= 0 && !is_unknown(bt[bi]) && !is_type_variable(bt[bi])) {
      out = util.append_diags(out, tp_bound_diags(tparams[i], bounds[i], module, site, bt[bi], s, ln, cl));
    }
    i = i + 1;
  }
  return out;
}

// tp_bound_diags is call_bound_diags for type parameter `tp`, bound to `at`.
function tp_bound_diags(tp: string, bound: string, module: string, site: string, at: typeinfo.Type, s: Scope, ln: i32, cl: i32): util.Diag[] {
  let out: util.Diag[] = [];
  for entry in parser.split_plus_bounds(bound) {
    let base: string = util.base_type_name(entry);
    if (!bound_import_unloaded(base, s.imports.paths, s.trait_reqs) && !type_implements(s, at, base, module)) {
      out = out.append(dg_at("E021", "type argument " + tp + " = " + util.demangle(type_label(at)) + " does not implement trait " + bound_trait_display(base, module, s.trait_reqs) + " required by " + site, ln, cl));
    }
  }
  return out;
}

// type_implements reports whether `t` implements the trait that bound `base`,
// written in `module`, names: an impl for the name its methods register under,
// a derive on its declaration, or a `dyn` that spans the trait.
function type_implements(s: Scope, t: typeinfo.Type, base: string, module: string): boolean {
  if let typeinfo.TypeDyn(d) = t {
    let want: string = parser.derive_simple_name(base);
    for tr in parser.dyn_trait_set("dyn " + d.traits) {
      if (parser.derive_simple_name(util.base_type_name(tr)) == want) {
        return true;
      }
    }
    return false;
  }
  let tn: string = impl_type_name(t);
  if (tn.len() == 0) {
    return false;
  }
  for imp in s.impls {
    if (impl_receiver(imp) == tn && bound_names_trait(base, module, imp.trait_name, imp.trait_module)) {
      return true;
    }
  }
  return derives_bound(s, tn, base, module);
}

// impl_receiver is the name an impl's methods register under: `impl Tr for
// str` lands on `string`, as a `str` receiver method does.
function impl_receiver(imp: parser.ImplInfo): string {
  return receiver_namespace(util.base_type_name(imp.impl_type));
}

// impl_type_name is the name `t`'s impls register under (native
// ast.ReceiverTypeName), or "" for a type no impl can name: an array, a tuple,
// a callable, a handle, void.
function impl_type_name(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(_) => {},
    typeinfo.TypeBool(_) => {},
    typeinfo.TypeString(_) => {},
    typeinfo.TypeFloat(_) => {},
    typeinfo.TypeLanes(_) => {},
    typeinfo.TypeStruct(_) => {},
    typeinfo.TypeUnion(_) => {},
    typeinfo.TypeMap(_) => {},
    _ => {
      return "";
    }
  }
  return receiver_namespace(util.base_type_name(type_label(t)));
}

// derives_bound: a `@derive` on `tyname`'s declaration (for an enum, on any
// variant) of the trait that bound `base`, written in `module`, names. Flatten
// spells a derive by the module declaring its trait, bare for the entry's own.
function derives_bound(s: Scope, tyname: string, base: string, module: string): boolean {
  for sd in s.structs.structs {
    if (sd.name == tyname || sd.enum_owner == tyname) {
      for derive in sd.derives {
        let name: string = parser.derive_simple_name(derive);
        if (bound_names_trait(base, module, name, spelling_qualifier(derive, name))) {
          return true;
        }
      }
    }
  }
  return false;
}

// spelling_qualifier is what precedes `.name` in a trait spelling ending in
// `name`, "" for a bare one.
function spelling_qualifier(spelling: string, name: string): string {
  if (spelling.len() <= name.len()) {
    return "";
  }
  return slice_unchecked(spelling, 0, spelling.len() - name.len() - 1) + "";
}

// bound_trait_display names the trait that bound `base`, written in `module`,
// names as native prints it: qualified by the module that declares it, bare
// for the entry's own.
function bound_trait_display(base: string, module: string, reqs: parser.TraitReq[]): string {
  let name: string = parser.derive_simple_name(base);
  if (util.index_of_sub(base, ".") < 0) {
    if (module.len() == 0) {
      return name;
    }
    return module + "." + name;
  }
  let idx: i32 = bound_trait_req(base, module, reqs);
  if (idx >= 0) {
    return reqs[idx].module + "." + name;
  }
  return base;
}

// bound_trait_req is the index of the requirement record of the trait that
// bound `base`, written in `module`, names, or -1: the writing module's own
// for a bare name, an import's for a qualified one (bound_names_trait).
function bound_trait_req(base: string, module: string, reqs: parser.TraitReq[]): i32 {
  let name: string = parser.derive_simple_name(base);
  let q: string = spelling_qualifier(base, name);
  let want: string = module;
  if (q.len() > 0) {
    want = q;
  }
  let found: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < reqs.len()) {
    if (reqs[i].trait_name == name && reqs[i].module == want) {
      return i;
    }
    if (found < 0 && reqs[i].trait_name == name && q.len() > 0 && reqs[i].module.len() > 0) {
      found = i;
    }
    i = i + 1;
  }
  return found;
}

// bound_import_unloaded reports a qualified bound whose qualifier names one of
// the program's imports but whose module was never loaded — a single-module
// driver checks without its imports, so nothing can say what that module
// declares.
function bound_import_unloaded(base: string, imports: string[], reqs: parser.TraitReq[]): boolean {
  let q: string = spelling_qualifier(base, parser.derive_simple_name(base));
  if (q.len() == 0) {
    return false;
  }
  for r in reqs {
    if (r.module == q) {
      return false;
    }
  }
  for path in imports {
    if (path == q || util.str_has_suffix(path, "/" + q)) {
      return true;
    }
  }
  return false;
}

// bound_decl_diags is E021 for each trait a function's type-parameter bounds
// name that nothing declares, and for a bound supplying the wrong number of
// trait arguments, at the function (native's bound validation).
function bound_decl_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let imports: string[] = import_paths_of(mod);
  for fd in mod.funcs {
    let i: i32 = 0;
    while (i < fd.type_params.len() && i < fd.bound_traits.len()) {
      for entry in parser.split_plus_bounds(fd.bound_traits[i]) {
        out = util.append_diags(out, bound_entry_decl_diags(entry, fd, fd.type_params[i], imports, mod.trait_reqs));
      }
      i = i + 1;
    }
  }
  return out;
}

function bound_entry_decl_diags(entry: string, fd: parser.FuncDecl, tp: string, imports: string[], reqs: parser.TraitReq[]): util.Diag[] {
  let none: util.Diag[] = [];
  let bref: parser.TypeRef = parser.parse_type_ref(entry);
  if (bound_import_unloaded(bref.base, imports, reqs)) {
    return none;
  }
  let display: string = bound_trait_display(bref.base, fd.module, reqs);
  let idx: i32 = bound_trait_req(bref.base, fd.module, reqs);
  if (idx < 0) {
    return [dg_at("E021", "unknown trait \"" + util.demangle(display) + "\" in bound on type parameter " + tp, fd.line, fd.col)];
  }
  let want: i32 = reqs[idx].type_params.len();
  if (bref.args.len() != want) {
    return [dg_at("E021", "trait " + util.demangle(display) + " takes " + util.i32_to_string(want) + " type argument(s), " + util.i32_to_string(bref.args.len()) + " supplied in bound on type parameter " + tp, fd.line, fd.col)];
  }
  return none;
}

// array_recv_method resolves an ARRAY-RECEIVER method — one written
// `function (xs: T[]) <field>(…)`, element-polymorphic or pinned to one element
// type (`function (arr: string[]) join(…)`): an ordinary MethodSig whose
// receiver_type spelling ends in `[]`. The namespace is keyed on the method
// NAME and cannot distinguish element types, so any array-receiver method in
// scope applies to every array receiver — no element match to make, whether
// the element is a type variable or a concrete `i32[]` / `string[]`.
// A receiver whose element does not fit is caught against the method's own
// signature. A view receiver (`[T]`) has a separate namespace; the caller
// selects that namespace from the checked receiver type.
//
// Lowering folds concrete methods into free functions keyed by the receiver
// element and namespace before view erasure, retaining their own type params.
function array_receiver_matches(rt: string, view: boolean): boolean {
  if (view) {
    return parser.spelling_is_view(rt);
  }
  return rt.len() > 2 && slice_unchecked(rt, 0, 1) != "[" && slice_unchecked(rt, rt.len() - 2, rt.len()) == "[]";
}

function (s: Scope) array_recv_method(field: string, view: boolean): MethodSig {
  let i: i32 = s.methods.head[sig_name_bucket(field)];
  while (i >= 0) {
    let method: MethodSig = s.methods.methods[i];
    let rt: string = method.receiver_type;
    if (method.name == field && array_receiver_matches(rt, view) && s.method_visible(method)) {
      return method;
    }
    i = s.methods.next[i];
  }
  let empty_pt: typeinfo.Type[] = [];
  return MethodSig { name: "", receiver_type: "", param_types: empty_pt, ret_type: t_unknown("no such array method"), ret_type_name: "", param_type_names: [], all_type_params: [], type_params: [], type_bounds: [], module: "", impl_trait: "", line: 0, col: 0, file: "" };
}

// array_method_ret_type resolves the result type of an array method call
// `a.<field>(...)` where `a` is an array, through the array-receiver method
// array_recv_method finds. Returns the method's declared return type, or
// t_unknown when no such method is in scope — at which point check_call_expr falls through to its normal
// "receiver isn't a typed value" handling so a genuine unknown array
// method still surfaces as unknown rather than a wrong concrete type.
// `append` / `with` are the built-in array growers and return the array
// itself (the receiver type), short-circuited ahead of the sig scan.
function (s: Scope) array_method_ret_type(c: ast.ExprCall, recv_ty: typeinfo.Type, field: string): typeinfo.Type {
  match (recv_ty) {
    typeinfo.TypeArray(array) => {
      if (!array.view && (field == "append" || field == "with")) {
        return recv_ty;
      }
      // `xs.len()` — the method spelling of the `len(xs)` builtin.
      if (field == "len") {
        return t_i32();
      }
      if (array.view) {
        return s.arr_recv_ret_type(c, recv_ty, s.array_recv_method(field, true));
      }
      let arm: MethodSig = s.array_recv_method(field, false);
      if (arm.name.len() > 0) {
        return s.arr_recv_ret_type(c, recv_ty, arm);
      }
      return t_unknown("no array method `" + field + "`");
    },
    _ => {
      return t_unknown("array_method_ret_type: receiver isn't an array");
    }
  }
}

// array_method_sig is the method an array receiver (a view's, when `view`)
// declares under `field`, or the empty-named sentinel.
pub function array_method_sig(s: Scope, field: string, view: boolean): MethodSig {
  return s.array_recv_method(field, view);
}

// arr_recv_ret_type is an array-receiver method call's result, its type
// variables bound from the receiver's element and from the arguments, as a
// nominal receiver's are.
function (s: Scope) arr_recv_ret_type(c: ast.ExprCall, recv_ty: typeinfo.Type, arm: MethodSig): typeinfo.Type {
  if (arm.name.len() == 0) {
    return arm.ret_type;
  }
  return generic_method_ret(c, arm, method_binding(c, arm, recv_ty, s), s);
}

// has_struct is lookup_struct's predicate form, for the callers that only ask
// whether the name is a struct at all: the miss sentinel is five empty arrays
// they build and drop.
function (s: Scope) has_struct(name: string): boolean {
  let i: i32 = s.structs.index.chain(name);
  while (i >= 0) {
    if (s.structs.structs[i].name == name) {
      return true;
    }
    i = s.structs.index.next[i];
  }
  return false;
}

// lookup_struct answers for the STRUCT namespace: the plain struct named
// `name`, or, when only enum variants carry the name, the first of those. The
// table is keyed by the bare name and a plain struct may share one with a
// variant, so a literal or a field read that took whichever registered first
// resolved to the variant when the enum was declared above the struct
// (#9968). A pattern or a constructor call wants the other namespace and asks
// lookup_variant or lookup_owned_struct.
function (s: Scope) lookup_struct(name: string): StructSig {
  let first: i32 = 0 - 1;
  let i: i32 = s.structs.index.chain(name);
  while (i >= 0) {
    if (s.structs.structs[i].name == name) {
      if (s.structs.structs[i].enum_owner.len() == 0) {
        return s.structs.structs[i];
      }
      if (first < 0) {
        first = i;
      }
    }
    i = s.structs.index.next[i];
  }
  if (first >= 0) {
    return s.structs.structs[first];
  }
  // Sentinel: empty name signals "no such struct".
  let empty_n: string[] = [];
  let empty_t: typeinfo.Type[] = [];
  let empty_tp: string[] = [];
  let empty_ftn: string[] = [];
  return StructSig { name: "", field_names: empty_n, field_types: empty_t, type_params: empty_tp, field_type_names: empty_ftn, variant_field_names: empty_n, derives: [], enum_owner: "", opaque: false, module: "" };
}

// lookup_variant answers for the VARIANT namespace: the first enum variant
// named `name`, or, when no enum declares one, the plain struct of that name
// — a struct-union's member is a declared struct. An unqualified pattern or
// a constructor call is a variant first, as native reads it.
function (s: Scope) lookup_variant(name: string): StructSig {
  let i: i32 = s.structs.index.chain(name);
  while (i >= 0) {
    if (s.structs.structs[i].name == name && s.structs.structs[i].enum_owner.len() > 0 && !s.variant_hidden(s.structs.structs[i])) {
      return s.structs.structs[i];
    }
    i = s.structs.index.next[i];
  }
  return s.lookup_struct(name);
}

// variant_hidden reports whether the variant struct `v` belongs to an enum the
// scope's variant index leaves out (UnionTable.lib_head).
function (s: Scope) variant_hidden(v: StructSig): boolean {
  if (!s.unions.from_import) {
    return false;
  }
  let e: i32 = s.unions.head[sig_name_bucket(v.name)];
  while (e >= 0) {
    let u: UnionSig = s.unions.unions[s.unions.vowner[e]];
    if (s.unions.vnames[e] == v.name && u.name == v.enum_owner) {
      return declared_by_entry(u);
    }
    e = s.unions.next[e];
  }
  return false;
}

// variant_ambiguous reports whether a bare `name` is a variant of two or more
// enums the scope's module sees, a built-in enum counting as one — the E036
// case, where the reference has no type until it is qualified. A variant
// repeated within one enum is E017 and counts once. flatten leaves such a
// reference in its module's own spelling (`lib__Go`, bare `Go` in the entry),
// so the module's prefix comes off before the lookup.
function (s: Scope) variant_ambiguous(name: string): boolean {
  let bare: string = unprefixed_variant(name, s.fn_module);
  let n: i32 = 0;
  if (parser.builtin_enum_of(bare).len() > 0) {
    n = 1;
  }
  let last: i32 = 0 - 1;
  let e: i32 = s.unions.bhead[sig_name_bucket(bare)];
  while (e >= 0) {
    let o: i32 = s.unions.vowner[e];
    let u: UnionSig = s.unions.unions[o];
    if (s.unions.bnames[e] == bare && u.is_enum && o != last && enum_visible_from(u, s.fn_module)) {
      n = n + 1;
      last = o;
    }
    e = s.unions.bnext[e];
  }
  return n >= 2;
}

// lookup_owned_struct answers the variant struct `name` DECLARED BY enum
// `owner`. The table is keyed by the bare variant name alone, so `A.W` and
// `B.W` register two entries called `W` in one bucket and lookup_struct
// answers for whichever was registered first — the owner is the only thing
// that tells them apart (conformance/cases/shared_variant_payload). Falls
// back to the name-only answer when nothing in the bucket claims `owner`.
function (s: Scope) lookup_owned_struct(name: string, owner: string): StructSig {
  let i: i32 = s.structs.index.chain(name);
  while (i >= 0) {
    if (s.structs.structs[i].name == name && s.structs.structs[i].enum_owner == owner) {
      return s.structs.structs[i];
    }
    i = s.structs.index.next[i];
  }
  return s.lookup_struct(name);
}

// variant_payload_struct resolves the struct sig carrying a variant's payload
// types, from the possibly enum-QUALIFIED spelling a pattern or a qualified
// constructor call writes (`E.Wrap`). The qualifier is not part of the table's
// key — it names the enum the entry must be owned by — so resolution is
// scoped through the owner, the way native resolves it and the way the
// parser's variant_struct_index does.
function variant_payload_struct(s: Scope, type_name: string): StructSig {
  if (dot_index(type_name) < 0) {
    return s.lookup_variant(type_name);
  }
  return s.lookup_owned_struct(variant_pattern_name(type_name), variant_pattern_owner(type_name));
}

// field_index returns the index of `name` in a struct sig's field list,
// or -1 when absent. Used by the E043 field-value-type check to line a
// provided field up with its declared type.
function field_index(ssig: StructSig, name: string): i32 {
  let i: i32 = 0;
  while (i < ssig.field_names.len()) {
    if (ssig.field_names[i] == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// variant_payload_type_at returns the type to bind a variant pattern's
// idx-th payload name to. A payload-bearing ENUM variant `V(T, U)` is lowered
// (in the parser) to a struct `V` with marker fields `__ev: T`, `__ev1: U`,
// …, so the pattern binds the PAYLOAD value, read off the marker field, NOT
// the wrapper struct (binding it as `t_struct("V")` false-positived E038 and
// E003). A struct-union member `type U = A | B` is a genuine user struct with
// no marker, so its binding is the whole struct — `t_struct(name)`, matching
// the Go checker. Builtin and generic payloads need the scrutinee's
// instantiation arguments; variant_pattern_payload_type resolves those first.
function variant_payload_type_at(s: Scope, type_name: string, idx: i32): typeinfo.Type {
  let ss: StructSig = variant_payload_struct(s, type_name);
  if (ss.name.len() == 0) {
    return t_unknown("built-in variant payload `" + type_name + "`");
  }
  let want: string = "__ev";
  if (idx > 0) {
    want = "__ev" + util.i32_to_string(idx);
  }
  let i: i32 = 0;
  while (i < ss.field_names.len()) {
    if (ss.field_names[i] == want) {
      return ss.field_types[i];
    }
    i = i + 1;
  }
  return t_struct(ss.name);
}

// variant_pattern_qualified reports whether an arm pattern spells its owning
// enum (`B.W`) rather than the bare variant name.
function variant_pattern_qualified(type_name: string): boolean {
  let i: i32 = 0;
  while (i < type_name.len()) {
    if (type_name[i] == b'.') {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// Option/Result payloads are the resolved scrutinee arguments, not wrappers.
function variant_pattern_payload_type(s: Scope, name: string, whole: typeinfo.Type, index: i32): typeinfo.Type {
  if let typeinfo.TypeUnion(u) = whole {
    let bare: string = variant_pattern_name(name);
    if ((u.name == "Option" || u.name == "Result") && parser.builtin_enum_of(bare) == u.name) {
      let arg: i32 = 0;
      if (bare == "Err") {
        arg = 1;
      }
      if (index == 0 && bare != "None" && arg < u.args.len()) {
        return u.args[arg];
      }
      // An Option no construction settled (`let o = None;`) never holds Some.
      if (index == 0 && bare == "Some" && u.args.len() == 0) {
        return t_unknown("unbound T");
      }
      return t_unknown("unresolved generic pattern payload");
    }
  }
  let g: typeinfo.Type = generic_variant_payload_type(s, name, whole, index);
  if (!is_unknown(g) || lit_id(g) >= 0 || unbound_enum_argument(g)) {
    return g;
  }
  return variant_payload_type_at(s, name, index);
}

// A payload of a user generic enum, `Box[i32, string]`'s `Blank(s)`, is its
// spelling with the enum's type parameters replaced by the scrutinee's
// arguments, as a generic struct's field is. A scrutinee naming no arguments
// (`E.B`, or a parameter annotated `E`) settles none, so only a payload that
// spells a type parameter is the "unbound" one it never holds. Unknown when
// the enum is not generic.
function generic_variant_payload_type(s: Scope, name: string, whole: typeinfo.Type, index: i32): typeinfo.Type {
  let u: typeinfo.TypeUnion = typeinfo.TypeUnion { name: "", args: [] };
  if let typeinfo.TypeUnion(wu) = whole {
    u = wu;
  } else {
    return t_unknown("not a union");
  }
  let us: UnionSig = s.lookup_union(u.name);
  let args: typeinfo.Type[] = u.args;
  if (args.len() == 0) {
    for tp in us.type_params {
      args = args.append(t_unknown("unbound " + tp));
    }
  }
  if (us.type_params.len() == 0 || us.type_params.len() != args.len()) {
    return t_unknown("not a generic enum instance");
  }
  let ss: StructSig = s.lookup_owned_struct(variant_pattern_name(name), u.name);
  let want: string = "__ev";
  if (index > 0) {
    want = "__ev" + util.i32_to_string(index);
  }
  let i: i32 = 0;
  while (i < ss.field_names.len() && i < ss.field_type_names.len()) {
    if (ss.field_names[i] == want) {
      return type_from_ref_subst(parser.parse_type_ref(ss.field_type_names[i]), us.type_params, args, s.type_names());
    }
    i = i + 1;
  }
  return t_unknown("no payload " + want);
}

// variant_ctor_type is the type of a variant construction. A generic enum's
// carries the arguments its payload fixes (`Full(9)` is Box[i32, unknown]),
// and leaves the rest unknown for the destination to settle.
function variant_ctor_type(s: Scope, union_name: string, name: string, c: ast.ExprCall): typeinfo.Type {
  let us: UnionSig = s.lookup_union(union_name);
  // Builtin enums have no declaration schema in this scope. Qualified calls
  // must preserve their payload facts just as bare Ok/Err/Some calls do.
  if (us.name.len() == 0 && (union_name == "Result" || union_name == "Option")) {
    return builtin_ctor_type(union_name, name, c, s);
  }
  if (us.type_params.len() == 0) {
    return t_union(union_name);
  }
  let args: typeinfo.Type[] = [];
  for tp in us.type_params {
    args = args.append(t_unknown("unbound " + tp));
  }
  let k: i32 = 0;
  while (k < c.args.len()) {
    let ti: i32 = payload_type_param(s, us, name, k);
    if (ti >= 0) {
      let payload: typeinfo.Type = inferred_payload(c.args[k], s);
      if (!unbound_enum_argument(args[ti])) {
        payload = join_result_types(args[ti], payload);
      }
      args = args.with(ti, payload);
    }
    k = k + 1;
  }
  return typeinfo.TypeUnion { name: union_name, args: args };
}

// bind_variant_payloads brings EVERY payload binding of a matched variant into
// the arm scope `arm`: the first (pv.binding) typed as `__ev`, then each of
// pv.extra_bindings typed as `__ev1`, `__ev2`, … . `look` is the scope carrying
// the struct sigs (the outer/match scope). Bare `_` and empty names stay out of
// scope, each position independently (so `Rect(_, h)` binds only `h`). Before
// this only pv.binding was bound, so a multi-binding payload pattern
// (`Rect(w, h)`) rejected the 2nd+ name as an undefined E001 (#4345).
function bind_variant_payloads(arm: Scope, look: Scope, pvin0: ast.PatVariant, whole: typeinfo.Type): Scope {
  let scrut_enum: string = "";
  if let typeinfo.TypeUnion(u) = whole {
    scrut_enum = u.name;
  }
  // An UNQUALIFIED arm pattern means the variant of ITS scrutinee, and two
  // enums may declare the same variant name at different payload types — so
  // the scrutinee's enum is what tells `B.W(f64)` from `A.W(i32)`. Without it
  // the bare-keyed lookup below answers for whichever was declared first and
  // the binding takes the other enum's type (#8461).
  let pvin: ast.PatVariant = pvin0;
  if (scrut_enum.len() > 0 && !variant_pattern_qualified(pvin0.type_name)) {
    pvin = ast.PatVariant { ...pvin0, type_name: scrut_enum + "." + pvin0.type_name };
  }
  // The pattern keeps its enum qualifier, because the payload-TYPE lookups
  // below resolve THROUGH the owning enum: variant decls are keyed by the
  // bare name, so `A.W` and `C.W` leave two decls called `W` and a bare
  // lookup answers for whichever was declared first, while the qualifier
  // names the owner that tells them apart. Each lookup strips or scopes for
  // itself — a qualified name handed to a bare-keyed table misses and fails
  // open, which is how a qualified payload came to bind as unknown (#8783).
  let pv: ast.PatVariant = pvin;
  // A record pattern that did not settle (record_pattern_diags reports why)
  // still binds the locals of the fields it named correctly, so the body does
  // not cascade into undefined-name errors.
  if (parser.is_record_pattern(pv)) {
    // The struct table IS keyed bare, unlike the payload-type lookups below,
    // so this one strips: a qualified `E.Wrap` would miss it.
    let rss: StructSig = variant_payload_struct(look, pv.type_name);
    if (rss.variant_field_names.len() > 0) {
      pv = parser.rebind_record_positional(pv, rss.variant_field_names);
    }
  }
  let sc: Scope = arm;
  // An @ binding names the complete scrutinee, including its type arguments.
  if (pv.at_binding.len() > 0 && pv.at_binding != "_") {
    sc = sc.bind(pv.at_binding, whole);
  }
  if (pv.binding.len() > 0 && pv.binding != "_") {
    sc = sc.bind(pv.binding, variant_pattern_payload_type(look, pv.type_name, whole, 0));
  }
  let k: i32 = 0;
  while (k < pv.extra_bindings.len()) {
    let nm: string = pv.extra_bindings[k];
    if (nm.len() > 0 && nm != "_") {
      sc = sc.bind(nm, variant_pattern_payload_type(look, pv.type_name, whole, k + 1));
    }
    k = k + 1;
  }
  return sc;
}

// receives reports whether method `ms` is called on a receiver of type
// `recv_type`: declared on it, on its generic base — a generic receiver method
// stores its spelling with the type parameters (`Box[T]`) where the call site
// names the base (`Box`, the #4346-piece-2 companion to the generic-method
// return substitution) — or on a union it is a variant of.
function (s: Scope) receives(ms: MethodSig, recv_type: string): boolean {
  return ms.receiver_type == recv_type || parser.parse_type_ref(ms.receiver_type).base == recv_type || is_variant_of(recv_type, ms.receiver_type, s.unions.unions);
}

function (s: Scope) lookup_method(name: string, recv_type: string): MethodSig {
  let i: i32 = s.methods.head[sig_name_bucket(name)];
  while (i >= 0) {
    // A bucket holds every method whose name hashes to it, so the name still
    // has to be compared — and it is compared FIRST because the receiver tests
    // below parse the stored receiver spelling, which is a string parse per
    // candidate the name would have rejected for free.
    if (s.methods.methods[i].name != name) {
      i = s.methods.next[i];
      continue;
    }
    if (s.receives(s.methods.methods[i], recv_type)) {
      return s.methods.methods[i];
    }
    i = s.methods.next[i];
  }
  let at: i32 = s.trait_spelled_method(name, recv_type);
  if (at >= 0) {
    return s.methods.methods[at];
  }
  return no_method_sig();
}

function no_method_sig(): MethodSig {
  let empty_pt: typeinfo.Type[] = [];
  return MethodSig { name: "", receiver_type: "", param_types: empty_pt, ret_type: t_unknown("no such method"), ret_type_name: "", param_type_names: [], all_type_params: [], type_params: [], type_bounds: [], module: "", impl_trait: "", line: 0, col: 0, file: "" };
}

// trait_spelled_method is the method a call spelled `Trait.m` on `recv_type`
// names when no method bears that name: the trait's provider of `m` for the
// type, whatever that method was named (the bound routing spells a call so,
// parser.route_bound_calls). -1 when the spelling has no trait or no
// provider answers.
function (s: Scope) trait_spelled_method(name: string, recv_type: string): i32 {
  let dot: i32 = name.len() - 1;
  while (dot >= 0 && name[dot] != b'.') {
    dot = dot - 1;
  }
  if (dot <= 0) {
    return -1;
  }
  let tname: string = method_simple_name(slice_unchecked(name, 0, dot) + "");
  let simple: string = slice_unchecked(name, dot + 1, name.len()) + "";
  let i: i32 = s.methods.shead[sig_name_bucket(simple)];
  while (i >= 0) {
    let m: MethodSig = s.methods.methods[i];
    if (method_simple_name(m.impl_trait) == tname && method_simple_name(m.name) == simple && (m.receiver_type == recv_type || parser.parse_type_ref(m.receiver_type).base == recv_type)) {
      return i;
    }
    i = s.methods.snext[i];
  }
  return -1;
}

// has_method answers lookup_method's question without building the sentinel
// MethodSig — an empty Type[] plus a t_unknown box — that a miss otherwise
// allocates. The callers below only ever read `.name.len()`, so the whole
// sentinel was allocated to be thrown away.
//
// The matching rules are lookup_method's, kept deliberately in the same order
// so the two cannot answer differently.
function (s: Scope) has_method(name: string, recv_type: string): boolean {
  let i: i32 = s.methods.head[sig_name_bucket(name)];
  while (i >= 0) {
    if (s.methods.methods[i].name != name) {
      i = s.methods.next[i];
      continue;
    }
    if (s.methods.methods[i].receiver_type == recv_type) {
      return true;
    }
    if (parser.parse_type_ref(s.methods.methods[i].receiver_type).base == recv_type) {
      return true;
    }
    if (is_variant_of(recv_type, s.methods.methods[i].receiver_type, s.unions.unions)) {
      return true;
    }
    i = s.methods.next[i];
  }
  return s.trait_spelled_method(name, recv_type) >= 0;
}

// has_sig is lookup_sig's predicate form. lookup_sig's miss still builds a
// FuncSig with three empty arrays and an unknown ret_type; every caller here
// wants a boolean, and each is biased toward the miss — reached only after
// `defines` failed, or asking about a qualified spelling most calls do not
// have. Both probes walk the same bucket, so gating a value lookup on this
// costs a second chain walk on the HIT and saves the whole sentinel on the
// miss.
function (s: Scope) has_sig(name: string): boolean {
  return s.sig_at(name) >= 0;
}

// is_map_iter_method reports whether `name` is one of the MapIter cursor's
// builtin methods (native registerMapIterMethod).
function is_map_iter_method(name: string): boolean {
  return util.has_str(map_iter_methods(), name);
}

function map_iter_methods(): string[] {
  return ["advance", "has_next", "key", "value"];
}

// --- E043 unknown-method advice (the native unknownMethodMessage port) -------
//
// Native names the method set it checked against and the import that would
// supply it; this checker emitted the same code at the same position and said
// nothing at all (#7442). Three of native's four branches are reproduced
// exactly. The fourth — the "(it has: …)" list — is emitted only for a
// namespace whose methods all declare a CONCRETE receiver type, where the two
// checkers provably build the same set. Native filters an element-polymorphic
// namespace by the receiver's element type (`Array` holds `sum` for i32[] and
// `join` for string[] side by side) and this checker has no bound solver to do
// it with; the unfiltered list would advertise an API the receiver does not
// have, which native's own note calls worse than the bare typo.

// retired_collection_spelling: the value-returning name that replaced a
// mutable-looking collection method removed by the pure-collection API, or ""
// for a name that was never one. They resolve to nothing now, so the reader is
// left guessing at a rename they never saw.
function retired_collection_spelling(ns: string, method: string): string {
  if (ns == "Array" && method == "push") {
    return "append";
  }
  if (ns == "Array" && method == "set") {
    return "with";
  }
  if (ns == "Map" && method == "set") {
    return "insert";
  }
  if (ns == "Map" && method == "has") {
    return "contains";
  }
  if (ns == "Map" && (method == "delete" || method == "without")) {
    return "remove";
  }
  if (ns == "Map" && method == "clear") {
    return "cleared";
  }
  return "";
}

// module_imported: `path` is in the program's import list. For a single module
// that is its own imports; for a bundle it is the closure flatten.bundle keeps.
function (s: Scope) module_imported(path: string): boolean {
  return util.index_of_str(s.imports.paths, path) >= 0;
}

// imports_directly reports whether the enclosing function's own module
// imports `path`. A module checked alone answers for the program.
function (s: Scope) imports_directly(path: string): boolean {
  for sg in s.imports.sights {
    if (sg.module == s.fn_module) {
      return util.has_str(sg.imports, path);
    }
  }
  return s.module_imported(path);
}

// method_visible reports whether the enclosing function may call `m`: a
// method of its own module or of one its import closure reaches, or a trait
// impl's, which is callable wherever its type flows.
function (s: Scope) method_visible(m: MethodSig): boolean {
  return m.impl_trait.len() > 0 || s.imports.sees(s.fn_module, m.module);
}

// visible_method is lookup_method narrowed to what method_visible admits.
function (s: Scope) visible_method(name: string, recv_type: string): MethodSig {
  let m: MethodSig = s.lookup_method(name, recv_type);
  if (m.name.len() > 0 && !s.method_visible(m)) {
    return no_method_sig();
  }
  return m;
}

// methods_in_namespace: the method names registered on `ns`, sorted so a
// suggestion is deterministic when two candidates tie on edit distance. The
// unconditional builtins are named here rather than read out of a table: this
// checker resolves them at their use sites, where native keeps them in the same
// Info.Methods map it lists from.
function (s: Scope) methods_in_namespace(ns: string): string[] {
  let out: string[] = preregistered_methods(ns);
  for method in s.methods.methods {
    if (method.receiver_type == ns || ns == "Map" && map_receiver_type(method.receiver_type)) {
      out = push_str_unique_sorted(out, method.name);
    }
  }
  return out;
}

// preregistered_methods: the method names the checker registers on a builtin
// namespace before any declaration, sorted. Map's `set` / `delete` / `clear`
// are NOT among them: native registers them and then deletes them (the
// pure-collection API's hard removal), which is what leaves
// retired_collection_spelling naming the value-returning replacement.
// core/map's own receiver methods (entries, merge, extend, …) are declared.
function preregistered_methods(ns: string): string[] {
  if (ns == "Array") {
    return ["append", "len", "with"];
  }
  if (ns == "slice") {
    return ["len"];
  }
  if (ns == "string") {
    return ["as_bytes", "len"];
  }
  if (ns == "Map") {
    return ["cleared", "contains", "get", "get_or", "insert", "iter", "keys", "len", "remove", "values"];
  }
  if (ns == "MapIter") {
    return ["advance", "has_next", "key", "value"];
  }
  if (ns == "Cell") {
    return ["get", "set"];
  }
  return [];
}

// map_receiver_type: a receiver spelled `Map` or `Map[K, V]`. core/map declares
// its own methods (entries, merge, update, …) on the generic spelling, which a
// bare-namespace compare misses — the same mismatch has_array_recv_method
// exists for on `T[]`.
function map_receiver_type(rt: string): boolean {
  if (rt == "Map") {
    return true;
  }
  return rt.len() > 4 && slice_unchecked(rt, 0, 4) == "Map[";
}

// namespace_is_exact: every method on `ns` declares a concrete receiver, so
// this checker's set is the one native would list. An array namespace with any
// module-supplied method fails it: a pinned or element-polymorphic array
// receiver.
function (s: Scope) namespace_is_exact(ns: string): boolean {
  if (ns != "Array") {
    return true;
  }
  for method in s.methods.methods {
    let rt: string = method.receiver_type;
    if (rt.len() > 2 && slice_unchecked(rt, rt.len() - 2, rt.len()) == "[]" && s.method_visible(method)) {
      return false;
    }
  }
  return true;
}

// push_str_unique_sorted inserts `v` in sorted position, dropping a duplicate.
function push_str_unique_sorted(xs: string[], v: string): string[] {
  let out: string[] = [];
  let placed: boolean = false;
  for x in xs {
    if (x == v) {
      return xs;
    }
    if (!placed && v < x) {
      out = out.append(v);
      placed = true;
    }
    out = out.append(x);
  }
  if (!placed) {
    out = out.append(v);
  }
  return out;
}

// Match the declaration's receiver after its type parameters bind.
function (s: Scope) stdlib_receiver_matches(ns: string, method: string, recv: typeinfo.Type): boolean {
  let written: string = stdlib_methods.receiver_of(ns, method);
  if (written.len() == 0) {
    return true;
  }
  let ref: parser.TypeRef = parser.parse_type_ref(written);
  let params: string[] = stdlib_methods.receiver_params(ns, method);
  let (names, types) = gc_bind_param(ref, recv, params, s.type_names(), [], []);
  if (names.len() != params.len()) {
    return false;
  }
  // The ordinary type comparison ignores nominal arguments.
  // The resolved spelling retains nested arguments and callable ownership.
  let expected: typeinfo.Type = type_from_ref_subst(ref, names, types, s.type_names());
  return type_label(expected) == type_label(recv);
}

// unknown_method_message: the E043 text for a method call on a receiver whose
// namespace has no such method. `ns` is the namespace its methods register
// under ("Array", "string", "i32"), `label` the receiver as the reader spelled
// it.

function (s: Scope) unknown_method_message(ns: string, method: string, label: string, recv: typeinfo.Type): string {
  let base: string = "no method \"" + method + "\" on " + label;
  let repl: string = retired_collection_spelling(ns, method);
  let view: boolean = false;
  if let typeinfo.TypeArray(a) = recv {
    view = a.view;
  }
  if (view) {
    repl = "";
  }
  if (ns == "Map" && (method == "has" || method == "without")) {
    return base + " — it was renamed; use \"" + repl + "\"";
  }
  if (repl.len() > 0) {
    return base + " — the in-place spelling was removed; use \"" + repl
      + "\", which returns the updated " + ns + " (assign the result back)";
  }
  let declared_receiver: string = stdlib_methods.receiver_of(ns, method);
  if (declared_receiver.len() > 0 && !s.stdlib_receiver_matches(ns, method, recv)) {
    return base + " — \"" + method + "\" is declared for " + declared_receiver + " in \"" + stdlib_methods.module_of(ns, method) + "\"";
  }
  let import_advice: string = s.stdlib_import_advice(ns, method);
  if (import_advice.len() > 0) {
    return base + import_advice;
  }
  let names: string[] = s.method_fix_candidates(ns, recv);
  let did: string = util.suggest(method, names);
  if (did.len() > 0) {
    return base + " — did you mean \"" + did + "\"?";
  }
  let near_advice: string = s.stdlib_near_advice(ns, method, recv);
  if (near_advice.len() > 0) {
    return base + near_advice;
  }
  if (stdlib_methods.methods_on(ns).len() > 0) {
    base = base + ", and no stdlib module declares one";
  }
  return base + method_list(names);
}

// method_list: " (it has: a, b)" for the receiver's methods, "" for none.
function method_list(names: string[]): string {
  if (names.len() == 0) {
    return "";
  }
  let listed: string = "";
  for n in names {
    if (listed.len() > 0) {
      listed = listed + ", ";
    }
    listed = listed + n;
  }
  return " (it has: " + listed + ")";
}

// stdlib_import_advice: the import to add when a stdlib module the program does
// not import declares `method` on the `ns` surface, or "".
function (s: Scope) stdlib_import_advice(ns: string, method: string): string {
  let mod: string = stdlib_methods.module_of(ns, method);
  if (mod.len() == 0 || s.imports_directly(mod)) {
    return "";
  }
  // The f-string desugar is the one way to reach this without writing a
  // method call.
  let note: string = "";
  if (method == "to_string") {
    note = " (an f-string like `f\"{x}\"` desugars to `x.to_string()`)";
  }
  return " — add `import \"" + mod + "\"`" + note;
}

// stdlib_near_advice: a near miss among the methods stdlib modules declare on
// the `ns` surface, with the import it needs, or "".
function (s: Scope) stdlib_near_advice(ns: string, method: string, recv: typeinfo.Type): string {
  let near: string = util.suggest(method, stdlib_methods.methods_on(ns));
  if (near.len() == 0 || !s.stdlib_receiver_matches(ns, near, recv)) {
    return "";
  }
  let mod: string = stdlib_methods.module_of(ns, near);
  if (s.imports_directly(mod)) {
    return "";
  }
  return " — did you mean \"" + near + "\", which needs `import \"" + mod + "\"`?";
}

// A suggestion and an editor fix use the same receiver-specific candidates.
// Generic array methods need the receiver filter this checker cannot yet
// express, so they keep the existing conservative no-suggestion rule.
function (s: Scope) method_fix_candidates(ns: string, recv: typeinfo.Type): string[] {
  if let typeinfo.TypeArray(a) = recv {
    if (a.view) {
      let names: string[] = ["len"];
      for candidate in s.methods.methods {
        if (parser.spelling_is_view(candidate.receiver_type)) {
          names = push_str_unique_sorted(names, candidate.name);
        }
      }
      return names;
    }
  }
  if (!s.namespace_is_exact(ns)) {
    return [];
  }
  // Only what the caller can reach: naming a method it cannot see would
  // hide the import hint that repairs the call.
  let out: string[] = preregistered_methods(ns);
  for method in s.methods.methods {
    if ((method.receiver_type == ns || ns == "Map" && map_receiver_type(method.receiver_type)) && s.method_visible(method)) {
      out = push_str_unique_sorted(out, method.name);
    }
  }
  return out;
}

// unknown_method_advice: the E043 text for a method call on a non-struct
// receiver. A receiver with a method namespace of its own, or whose methods
// live in stdlib modules, gets the method advice; anything else the bare
// message.
function (s: Scope) unknown_method_advice(ns: string, method: string, recv: typeinfo.Type): string {
  let label: string = type_label(recv);
  let surface: string = ns;
  if let typeinfo.TypeUnion(u) = recv {
    surface = u.name;
  }
  if (s.methods_in_namespace(surface).len() > 0 || stdlib_methods.methods_on(surface).len() > 0) {
    return s.unknown_method_message(surface, method, label, recv);
  }
  return "field access on non-struct value of type " + label;
}

// method_namespace_of: the name a receiver's methods register under — "Array"
// for any array, the scalar's own label, "" for a type with no namespace of its
// own. A field READ on such a receiver is the same mistake as a method call on
// it, and native says the same thing at both.
function method_namespace_of(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeArray(_) => {
      return "Array";
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    _ => {
      return "";
    }
  }
  return "";
}

// has_array_recv_method reports whether array_recv_method finds a method.
function (s: Scope) has_array_recv_method(field: string, view: boolean): boolean {
  return s.array_recv_method(field, view).name.len() > 0;
}

function (s: Scope) lookup_union(name: string): UnionSig {
  let at: i32 = s.unions.index.find(name);
  if (at >= 0) {
    return s.unions.unions[at];
  }
  // Sentinel: empty name signals "no such union".
  let empty_v: string[] = [];
  return UnionSig { name: "", variants: empty_v, is_try: false, is_enum: false, module: "", type_params: [], instance: "", visible_from: [] };
}

// try_able_union answers whether `?` accepts an operand of this union type.
// Option and Result are accepted without a marker — they predate it and
// cannot be spelled with one — and any other enum needs `@try`. Mirrors
// native's registerTryShape membership; the SHAPE rule the marker also
// carries is E078's, checked at the declaration.
function try_able_union(s: Scope, name: string): boolean {
  if (name == "Option" || name == "Result") {
    return true;
  }
  let us: UnionSig = s.lookup_union(name);
  return us.name.len() != 0 && us.is_try;
}

// try_success_type is what `E?` yields: the success payload of a `?`-able
// enum. A `@try` enum's success variant is its first (docs/TRY.md). A `?` in a
// function that does not return the same enum is E042's, and like native it
// yields no type rather than a second diagnostic.
function try_success_type(s: Scope, ot: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(tu) = ot {
    let same_ret: boolean = false;
    if let typeinfo.TypeUnion(ru) = s.try_ret {
      same_ret = ru.name == tu.name;
    }
    // An inferred result takes the operand's enum from this `?` (#9515).
    if let typeinfo.TypeUnknown(ru) = s.try_ret {
      same_ret = ru.reason == INFERRED_RESULT;
    }
    if (!same_ret) {
      return t_unknown("`?` outside a function returning " + tu.name);
    }
    if ((tu.name == "Option" || tu.name == "Result") && tu.args.len() > 0) {
      return tu.args[0];
    }
    let us: UnionSig = s.lookup_union(tu.name);
    if (us.is_try && us.variants.len() == 2) {
      return variant_pattern_payload_type(s, tu.name + "." + us.variants[0], ot, 0);
    }
  }
  return t_unknown("`?` operand is not a resolved `?`-able enum");
}

// is_variant_of: is the named struct one of the variants of the
// named union? Used by type_assignable to allow a struct value
// to flow into a union-typed slot.
function is_variant_of(struct_name: string, union_name: string, unions: UnionSig[]): boolean {
  for union in unions {
    if (union.name == union_name) {
      for variant in union.variants {
        if (variant == struct_name) {
          return true;
        }
      }
      return false;
    }
  }
  return false;
}

// type_assignable: is `from` usable where `to` is expected?
// Same as type_eq for primitives + structs + arrays. The
// extra rule is the variant→union widening: a TypeStruct "C"
// is assignable to a TypeUnion "U" iff C appears in U's
// variant list.
// A container's element, field or column is not a coercion site: boxing a
// value into a trait object is a representation change, so a `dyn` slot
// inside a container takes only the same `dyn`.
function nested_assignable(from: typeinfo.Type, to: typeinfo.Type, unions: UnionSig[]): boolean {
  if let typeinfo.TypeDyn(_) = to {
    return type_eq(from, to);
  }
  return type_assignable(from, to, unions);
}

// coercible is type_assignable at a site that has a scope, where a value
// coerced into a `dyn` slot must implement every trait in its set, as
// native's implementsAllDynTraits requires.
function coercible(from: typeinfo.Type, to: typeinfo.Type, s: Scope): boolean {
  return type_assignable(from, to, s.unions.unions) && dyn_conforms(from, to, s);
}

function dyn_conforms(from: typeinfo.Type, to: typeinfo.Type, s: Scope): boolean {
  let traits: string = "";
  if let typeinfo.TypeDyn(d) = to {
    traits = d.traits;
  } else {
    return true;
  }
  // A dyn value's table was built for its own set, so only the same set takes it.
  if let typeinfo.TypeDyn(_) = from {
    return type_eq(from, to);
  }
  if (is_unknown(from)) {
    return true;
  }
  if let typeinfo.TypeErased(_) = from {
    return true;
  }
  // No array implements a trait (native refuses the impl, E021), and its base
  // name is its element's, which may.
  if (is_owned_array(from) || is_arr_view(from)) {
    return false;
  }
  let tn: string = util.base_type_name(type_label(from));
  if (tn.len() == 0) {
    return true;
  }
  for tr in parser.dyn_trait_set("dyn " + traits) {
    if (!conforms_to_dyn_trait(s, tn, tr)) {
      return false;
    }
  }
  return true;
}

// ctor_payload_diags: a variant construction coerced into an enum whose
// argument at a payload's slot is dyn casts that payload to it, so a payload
// that does not implement the traits is refused as that cast is (E033), as
// native's maybeWrapForUnion does.
function ctor_payload_diags(e: ast.Expr, to: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let args: typeinfo.Type[] = [];
  let owner: string = "";
  if let typeinfo.TypeUnion(u) = to {
    args = u.args;
    owner = u.name;
  } else {
    return out;
  }
  if let ast.ExprCall(c) = e {
    if (!constructor_destination(c, to, s)) {
      return out;
    }
    let vname: string = ctor_variant_name(c);
    let k: i32 = 0;
    while (k < c.args.len()) {
      let slot: i32 = ctor_payload_slot(s, owner, vname, k);
      if (slot >= 0 && slot < args.len()) {
        let pt: typeinfo.Type = args[slot];
        out = util.append_diags(out, int_dest_range_diags(c.args[k], pt));
        out = util.append_diags(out, ctor_payload_diags(c.args[k], pt, s));
        if let typeinfo.TypeDyn(_) = pt {
          let at: typeinfo.Type = check_expr(c.args[k], s);
          if (!is_unknown(at) && !dyn_conforms(at, pt, s)) {
            out = out.append(dg_at("E033", "cannot cast " + type_label(at) + " to " + type_label(pt) + ": `as` converts only between numeric types", expr_line(c.args[k]), expr_col(c.args[k])));
          }
        }
      }
      k = k + 1;
    }
  }
  return out;
}

// ctor_name_taken reports whether a bare constructor call's name is taken by a
// binding or a top-level function, which makes the call a call of that rather
// than a construction. A qualified `Option.Some(x)` is never shadowed.
function ctor_name_taken(c: ast.ExprCall, s: Scope): boolean {
  if let ast.ExprIdent(id) = c.callee {
    return s.known(id.name) || s.has_sig(id.name);
  }
  return false;
}

// ctor_variant_name is the variant a constructor call names, bare (`Some(x)`)
// or qualified (`Option.Some(x)`); "" for any other callee.
function ctor_variant_name(c: ast.ExprCall): string {
  if let ast.ExprIdent(id) = c.callee {
    return id.name;
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    return fa.field;
  }
  return "";
}

// ctor_payload_slot is which of `owner`'s type arguments payload `k` of variant
// `vname` fills, or -1 when it fills none or the variant is not `owner`'s.
function ctor_payload_slot(s: Scope, owner: string, vname: string, k: i32): i32 {
  if (owner == "Option" || owner == "Result") {
    if (k != 0) {
      return 0 - 1;
    }
    if (owner == "Option" && vname == "Some" || owner == "Result" && vname == "Ok") {
      return 0;
    }
    if (owner == "Result" && vname == "Err") {
      return 1;
    }
    return 0 - 1;
  }
  if (union_of_variant(vname, s.unions) != owner) {
    return 0 - 1;
  }
  return payload_type_param(s, s.lookup_union(owner), vname, k);
}

// payload_type_param is the index in `us`'s type parameters of the one payload
// `k` of variant `vname` is spelled as, or -1.
function payload_type_param(s: Scope, us: UnionSig, vname: string, k: i32): i32 {
  let ss: StructSig = s.lookup_owned_struct(variant_pattern_name(vname), us.name);
  let want: string = "__ev";
  if (k > 0) {
    want = "__ev" + util.i32_to_string(k);
  }
  let fi: i32 = util.index_of_str(ss.field_names, want);
  if (fi < 0 || fi >= ss.field_type_names.len()) {
    return 0 - 1;
  }
  return util.index_of_str(us.type_params, ss.field_type_names[fi]);
}

// promotes_view: `from` holds a `str` view where `to` holds an owned `string`,
// at the top or inside an array, tuple, map or type argument (`str[]` into
// `string[]`), which type_eq's tag-blind comparison would let through.
function promotes_view(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if (is_str_view(from) && is_owned_string(to)) {
    return true;
  }
  match (from) {
    typeinfo.TypeArray(fa) => {
      if let typeinfo.TypeArray(ta) = to {
        return promotes_view(fa.elem, ta.elem);
      }
    },
    typeinfo.TypeTuple(ft) => {
      if let typeinfo.TypeTuple(tt) = to {
        return any_promotes_view(ft.elements, tt.elements);
      }
    },
    typeinfo.TypeMap(fm) => {
      if let typeinfo.TypeMap(tm) = to {
        return promotes_view(fm.key, tm.key) || promotes_view(fm.value, tm.value);
      }
    },
    typeinfo.TypeUnion(fu) => {
      if let typeinfo.TypeUnion(tu) = to {
        return any_promotes_view(fu.args, tu.args);
      }
    },
    typeinfo.TypeStruct(fs) => {
      if let typeinfo.TypeStruct(ts) = to {
        return any_promotes_view(fs.args, ts.args);
      }
    },
    _ => {}
  }
  return false;
}

// same_element_type: two array-literal elements agree, which a `str` view and
// an owned `string` do not in either order, though type_eq calls them equal.
function same_element_type(a: typeinfo.Type, b: typeinfo.Type): boolean {
  return type_eq(a, b) && !promotes_view(a, b) && !promotes_view(b, a);
}

function any_promotes_view(from: typeinfo.Type[], to: typeinfo.Type[]): boolean {
  if (from.len() != to.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < from.len()) {
    if (promotes_view(from[i], to[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function type_assignable(from: typeinfo.Type, to: typeinfo.Type, unions: UnionSig[]): boolean {
  if (integer_literal_widens(from, to)) {
    return true;
  }
  // Ahead of type_eq, which compares callables blind to `own` and to views.
  if let typeinfo.TypeFunc(tf) = to {
    if let typeinfo.TypeFunc(ff) = from {
      return callable_assignable(ff, tf, unions);
    }
    return false;
  }
  // `str` (#4813): a borrowed view never silently promotes to an owned
  // `string` — an owning sink must materialise a copy via .to_owned().
  // Checked BEFORE type_eq, which is deliberately tag-blind. The reverse
  // direction (an owned string into a `str` slot) borrows freely and goes through
  // the type_eq below. Argument positions re-allow the lend via
  // view_arg_borrow at their call sites, mirroring native argAssignable.
  if (promotes_view(from, to)) {
    return false;
  }
  // Array loans need a direct conversion site. Argument checks and local
  // initializer checks admit the loan before this general assignment rule.
  if (is_arr_view(from) && is_owned_array(to) || is_owned_array(from) && is_arr_view(to)) {
    return false;
  }
  if (nominal_args_clash(from, to, unions)) {
    return false;
  }
  if (type_eq(from, to)) {
    return true;
  }
  match (to) {
    typeinfo.TypeArray(te) => {
      match (from) {
        typeinfo.TypeArray(fe) => {
          // An empty / uninferred array literal types to
          // `unknown[]`; it flows into any concrete `T[]` slot.
          // Symmetrically, a generic parameter `T[]` erases to
          // `unknown[]` on the TO side, so a concrete `string[]`
          // flows into it — this is what lets a concrete array
          // argument satisfy a generic array parameter, e.g.
          // `sort_by(arr, cmp)` with `arr: string[]` against
          // `sort_by[T](arr: T[], …)` (core/cmp's comparator sort; #4829).
          // (Scalar `unknown` is NOT treated as a wildcard — a
          // genuinely unresolved value should still surface its
          // assignment error, e.g. `let s: string = badcall()`.)
          if (is_unknown(fe.elem) || is_unknown(te.elem)) {
            return true;
          }
          return nested_assignable(fe.elem, te.elem, unions);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeTuple(te) => {
      match (from) {
        typeinfo.TypeTuple(fe) => {
          // Same arity, element-wise assignable. An unknown element on
          // EITHER side is a wildcard, as in the array arm above. A generic
          // tuple `(T, U)` — whose params erase to `unknown` — flows into any
          // concrete tuple slot, a literal whose element infers `unknown` doesn't false-positive,
          // and a DESTINATION element this resolver cannot name is not a
          // rejection. That last direction is what a spelling like
          // `Cell[i32]` needs: it resolves to unknown here, so a bare
          // `let c: Cell[i32] = …` skips the check entirely while the same
          // element inside a tuple used to fail it.
          if (fe.elements.len() != te.elements.len()) {
            return false;
          }
          let i: i32 = 0;
          while (i < te.elements.len()) {
            if (!is_unknown(fe.elements[i]) && !is_unknown(te.elements[i]) && !nested_assignable(fe.elements[i], te.elements[i], unions)) {
              return false;
            }
            i = i + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeUnion(un) => {
      match (from) {
        typeinfo.TypeStruct(sn) => {
          return is_variant_of(sn.name, un.name, unions);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeMap(tm) => {
      match (from) {
        typeinfo.TypeMap(fm) => {
          // `map_new[_i32](n)` (the desugar of a `Map { … }` literal,
          // including the empty `Map {}`) types to a map with
          // `unknown` key / value — the self-host doesn't infer
          // K / V from a literal's entries — so an unknown side is a
          // wildcard that flows into any concrete `Map[K, V]` slot
          // (mirroring the empty-array rule above). A concrete side
          // must be assignable. Unknown on the DESTINATION side is the
          // same wildcard for the same reason the array and tuple arms
          // give it: a generic parameter erases to unknown there, so
          // `assert_eq_map[K, V](Map[K, V], …)` takes a concrete
          // `Map[i32, i32]`.
          let kok: boolean = is_unknown(fm.key) || is_unknown(tm.key) || nested_assignable(fm.key, tm.key, unions);
          let vok: boolean = is_unknown(fm.value) || is_unknown(tm.value) || nested_assignable(fm.value, tm.value, unions);
          return kok && vok;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeHandle(th) => {
      // An owned handle may be lent where a borrow of the same resource is
      // taken. A borrow never becomes an owned handle, and no integer becomes
      // either.
      if let typeinfo.TypeHandle(fh) = from {
        return th.borrowed && !fh.borrowed && th.resource == fh.resource;
      }
      return false;
    },
    typeinfo.TypeDyn(_) => {
      // A direct coercion site accepts any value but a view, `str` or `[T]`,
      // which assigns only to a view: a box would hold it past its source.
      // Whether the concrete implements the traits needs the impl table,
      // which `coercible` asks. An `unknown` source (e.g. a not-yet-typed dyn
      // method call) is accepted so it can't false-positive.
      return !is_str_view(from) && !is_arr_view(from);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// callable_assignable: a function type assigns only to the same function type,
// as native's ast.Equal decides it — same arity, the same consuming slots, and
// every parameter and the result invariant. An opaque `fn` (params_known false)
// records no signature to compare, so it assigns either way.
function callable_assignable(from: typeinfo.TypeFunc, to: typeinfo.TypeFunc, unions: UnionSig[]): boolean {
  if (!from.params_known || !to.params_known) {
    return true;
  }
  if (from.param_types.len() != to.param_types.len() || !callable_slot_matches(from.ret_type, to.ret_type, unions)) {
    return false;
  }
  let i: i32 = 0;
  while (i < from.param_types.len()) {
    let fp: typeinfo.Type = from.param_types[i];
    let tp: typeinfo.Type = to.param_types[i];
    if (callable_slot_open(fp) || callable_slot_open(tp)) {
      i = i + 1;
      continue;
    }
    if (typeinfo.fn_own_at(from, i) != typeinfo.fn_own_at(to, i) || !callable_slot_matches(fp, tp, unions)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// An inferred lambda slot left open can acquire its expected type. Named
// type variables and unresolved written names are contracts, not wildcards.
function callable_slot_open(t: typeinfo.Type): boolean {
  if let typeinfo.TypeUnknown(u) = t {
    return !util.str_has_prefix(u.reason, TPARAM_MARK) && !util.str_has_prefix(u.reason, UNRESOLVED_MARK);
  }
  return false;
}

// callable_slot_matches: one parameter or result of two function types is the
// same type, assignable both ways.
function callable_slot_matches(a: typeinfo.Type, b: typeinfo.Type, unions: UnionSig[]): boolean {
  if (callable_slot_open(a) || callable_slot_open(b)) {
    return true;
  }
  if (is_type_variable(a) || is_type_variable(b)) {
    return is_type_variable(a) && is_type_variable(b) && callable_typevar_name(a) == callable_typevar_name(b);
  }
  return type_assignable(a, b, unions) && type_assignable(b, a, unions);
}

function callable_typevar_name(t: typeinfo.Type): string {
  if let typeinfo.TypeErased(e) = t {
    return e.name;
  }
  return tvar_name(t);
}

// type_from_name resolves a parser-side bare type-name string with NO name
// context — the builtin-signature resolver, whose spellings are primitives.
// Unrecognised names surface as TypeUnknown so the checker can flag bogus
// signatures without hard-failing the whole check. i32 / i64 / u32 / u64 all map
// to a width-tagged TypeI32 (see the struct comment), which is what lets a
// receiver method on one pass the E021 gate and a call site recover the width.
function type_from_name(name: string): typeinfo.Type {
  return type_from_spelling(name, type_names([], [], []));
}

// =================== CHECKER ====================
// check_expr returns the inferred type. Errors surface as
// TypeUnknown with a `reason` string so callers can inspect them
// without an exception channel.
// call_through_fn_value types a call whose CALLEE is a VALUE expression rather
// than a name — an array element (`fs[0]()`), a tuple element (`t.0()`), or a
// nested call's result (`mk()()`). check_expr already types those callees; the
// call's type is that function type's result, so the answer is read rather
// than re-derived (#5986). Unknown when the callee is not a function value, so
// each caller keeps its own diagnostic for the shape it was written for.
//
// An opaque fn type (params_known false — the coarse `fn` tag records no
// parameter spellings) skips the argument checks rather than rejecting the
// call: an empty param list is "unrecorded", not "zero parameters".
function call_through_fn_value(c: ast.ExprCall, s: Scope): typeinfo.Type {
  // A desugared LAMBDA callee is the value-if / value-match IIFE, and the arm
  // at the head of check_call_expr already types it — from the branches, and
  // deliberately declining when they disagree so E031 is the only diagnostic
  // the mixed-arm form draws. Reading the lambda's own return type here would
  // answer where that arm chose not to. A lambda the program wrote is typed by
  // what it declares, like any other function value.
  if (desugared_lambda(c.callee)) {
    return t_unknown("immediately-invoked lambda: typed from its branches, not its value");
  }
  let ct: typeinfo.Type = check_expr(c.callee, s);
  match (ct) {
    typeinfo.TypeFunc(tf) => {
      if (!tf.params_known) {
        return tf.ret_type;
      }
      if (c.args.len() != tf.param_types.len()) {
        return t_unknown("arity mismatch calling function value");
      }
      return tf.ret_type;
    },
    _ => {}
  }
  return t_unknown("call target is not a function value");
}

// desugared_lambda says whether `e` is a lambda the parser built rather than
// one the program wrote.
function desugared_lambda(e: ast.Expr): boolean {
  if let ast.ExprLambda(lm) = e {
    return !parser.is_written_lambda_origin(lm.origin);
  }
  return false;
}

// ret_typevar_arg_type: the concrete type a generic call's bare-typevar return
// takes from the arguments, and whether any parameter named that variable at
// all. Several parameters may share the one name — `both[T](a: T, b: T): T` —
// and the readings settle at the WIDER integer one, so `both(1, 2^62)` types
// the call i64 instead of pinning `T` at the i32 reading of whichever argument
// came first (#8722 part 4); native settles the same call at i64 through
// polymorphicIntDefault. Enum arguments also combine the positions fixed by
// different constructors. Other shapes keep the first reading. A written type
// argument settles the variable before any argument does.
function ret_typevar_arg_type(sig: FuncSig, c: ast.ExprCall, s: Scope): (typeinfo.Type, boolean) {
  let (wn, wt) = written_type_bindings(sig, c, s);
  let wi: i32 = util.index_of_str(wn, sig.ret_type_name);
  if (wi >= 0) {
    return (wt[wi], true);
  }
  let rt: typeinfo.Type = t_unknown("no parameter names " + sig.ret_type_name);
  let bound: boolean = false;
  // An empty literal binds nothing, as in gc_bind_param (#10499), so another
  // argument (a function value, say) still can; it answers only when no
  // other argument there does.
  let empty: typeinfo.Type = rt;
  let has_empty: boolean = false;
  let k: i32 = 0;
  while (k < sig.param_type_names.len()) {
    if (sig.param_type_names[k] == sig.ret_type_name && k < c.args.len()) {
      let kt: typeinfo.Type = check_expr(c.args[k], s);
      if (elemless_array(kt)) {
        if (!has_empty) {
          empty = kt;
          has_empty = true;
        }
      } else if (bound) {
        rt = joined_return_argument(rt, kt);
      } else {
        rt = kt;
        bound = true;
      }
    }
    k = k + 1;
  }
  if (!bound && has_empty && !call_binds_elsewhere(sig, c, s)) {
    return (empty, true);
  }
  return (rt, bound);
}

function joined_return_argument(a: typeinfo.Type, b: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(au) = a {
    if let typeinfo.TypeUnion(bu) = b {
      return join_enum_arguments(au, bu);
    }
  }
  return wider_int(a, b);
}

// call_binds_elsewhere: some argument binds the call's return type parameter
// through a parameter other than one spelled as that parameter alone — a
// function value's signature, an array's element.
function call_binds_elsewhere(sig: FuncSig, c: ast.ExprCall, s: Scope): boolean {
  let (bn, _) = arg_bindings(sig, c, s);
  return util.index_of_str(bn, sig.ret_type_name) >= 0;
}

// shared_literal_typevar_width: when type parameter `tp` of a generic call is
// the whole declared type of two or more parameters and every argument there
// is an unsuffixed integer literal tree, the widest of their readings — native
// settles such a `T` through polymorphicIntDefault, so `both(1, 2^62)` binds
// `T` = i64 rather than the i32 of the first argument (#8722 part 4). A single
// such parameter, any non-literal argument, or a call that wrote its type
// arguments answers false.
function shared_literal_typevar_width(sig: FuncSig, c: ast.ExprCall, tp: string, s: Scope): (typeinfo.Type, boolean) {
  let wt: typeinfo.Type = t_unknown("no literal argument binds " + tp);
  if (c.type_args.len() > 0) {
    return (wt, false);
  }
  let n: i32 = 0;
  let k: i32 = 0;
  while (k < sig.param_type_names.len() && k < c.args.len()) {
    if (sig.param_type_names[k] == tp) {
      if (!int_literal_tree(c.args[k])) {
        return (wt, false);
      }
      let kt: typeinfo.Type = check_expr(c.args[k], s);
      if (n == 0) {
        wt = kt;
      } else {
        wt = wider_int(wt, kt);
      }
      n = n + 1;
    }
    k = k + 1;
  }
  return (wt, n >= 2 && is_integer(wt));
}

// settle_shared_literal_typevars restamps the literal arguments of a generic
// call at their shared type parameter's widest reading, so the lowering, which
// reads a type parameter off the FIRST argument that declares it, sees the
// width the checker settled.
function settle_shared_literal_typevars(c: ast.ExprCall, nargs: ast.Expr[], s: Scope): ast.Expr[] {
  let name: string = "";
  if let ast.ExprIdent(cid) = c.callee {
    name = cid.name;
  }
  let at: i32 = 0 - 1;
  if (name.len() > 0) {
    at = s.sig_at(name);
  }
  if (at < 0) {
    return nargs;
  }
  let sig: FuncSig = s.sigs.sigs[at];
  let out: ast.Expr[] = nargs;
  for tp in sig.typevars {
    let (wty, wok) = shared_literal_typevar_width(sig, c, tp, s);
    if (wok) {
      let tag: string = type_to_irtag(wty);
      let k: i32 = 0;
      while (k < sig.param_type_names.len() && k < out.len()) {
        if (sig.param_type_names[k] == tp) {
          out = out.with(k, settle_int_tree(out[k], tag));
        }
        k = k + 1;
      }
    }
  }
  return out;
}

// A call of a name with no declaration of its own. `__mkclo$<body>(captures)`
// is the lambda lift's closure constructor: the environment box holds <body>'s
// address and the captures that body reads back out of its first parameter, so
// the box's type is what <body> promises MINUS that parameter. No source
// identifier may hold a `$`, so only a lifted tree reaches this — and without
// it the box types to unknown and collapses whatever expression holds it.
// builtin_sigs is the signature native registers for every surface builtin
// and every builtin method that names no type parameter (`__method_Reader_close`,
// receiver first), plus the `__c_callN` trampolines, spelled `name(params): result` as ast.Type renders it. The cases the call
// typing special-cases ahead of it (print's Display argument, map_new's
// element types, cell_new's T) are listed as native registers them all the
// same; TestSelfHostBuiltinSigsMatch pins the list entry for entry.
// The rows are in byte order, which builtin_row's binary search needs.
function builtin_sigs(): string[] {
  return [
    "__c_call0(usize): usize",
    "__c_call0_f32(usize): f32",
    "__c_call0_f64(usize): f64",
    "__c_call1(usize, usize): usize",
    "__c_call1_f32(usize, usize): f32",
    "__c_call1_f64(usize, usize): f64",
    "__c_call2(usize, usize, usize): usize",
    "__c_call2_f32(usize, usize, usize): f32",
    "__c_call2_f64(usize, usize, usize): f64",
    "__c_call3(usize, usize, usize, usize): usize",
    "__c_call3_f32(usize, usize, usize, usize): f32",
    "__c_call3_f64(usize, usize, usize, usize): f64",
    "__c_call4(usize, usize, usize, usize, usize): usize",
    "__c_call4_f32(usize, usize, usize, usize, usize): f32",
    "__c_call4_f64(usize, usize, usize, usize, usize): f64",
    "__method_Dir_access(Dir, string, i32): Result[void, IoError]",
    "__method_Dir_chmod(Dir, string, i32, boolean): Result[void, IoError]",
    "__method_Dir_chown(Dir, string, i32, i32, boolean): Result[void, IoError]",
    "__method_Dir_close(Dir): Result[void, IoError]",
    "__method_Dir_entries(Dir): Result[string[], IoError]",
