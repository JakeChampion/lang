function type_to_irtag(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeArray(a) => {
      let elem = type_to_irtag(a.elem);
      if (elem.len() == 0) {
        return "";
      }
      if (a.view) {
        return "[" + elem + "]";
      }
      return elem + "[]";
    },
    typeinfo.TypeFunc(_) => {
      return "fn";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeI32(x) => {
      return int_label(x);
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeStruct(st) => {
      return st.name;
    },
    typeinfo.TypeMap(m) => {
      let kt = type_to_irtag(m.key);
      let vt = type_to_irtag(m.value);
      if (kt == "" || vt == "") {
        return "";
      }
      return "Map[" + kt + ", " + vt + "]";
    },
    typeinfo.TypeUnion(u) => {
      if (u.name == "Option" && u.args.len() == 1) {
        let pt = type_to_irtag(u.args[0]);
        if (pt == "") {
          return "";
        }
        return "Option[" + pt + "]";
      }
      if (u.name == "Result" && u.args.len() == 2) {
        let ot = type_to_irtag(u.args[0]);
        let et = type_to_irtag(u.args[1]);
        if (ot == "" || et == "") {
          return "";
        }
        return "Result[" + ot + ", " + et + "]";
      }
      if (u.args.len() == 0) {
        return u.name;
      }
      return "";
    },
    typeinfo.TypeTuple(tp) => {
      if (tp.elements.len() < 2) {
        return "";
      }
      let out = "(";
      let i = 0;
      while (i < tp.elements.len()) {
        let et2 = type_to_irtag(tp.elements[i]);
        if (et2 == "") {
          return "";
        }
        if (i > 0) {
          out += ", ";
        }
        out += et2;
        i += 1;
      }
      return out + ")";
    },
    typeinfo.TypeDyn(_) => {
      return typeinfo.spelling(t);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function type_to_arrtag(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeArray(a) => {
      let et = type_to_irtag(a.elem);
      if (et == "") {
        return "";
      }
      if (a.view) {
        return "[" + et + "]";
      }
      return et + "[]";
    },
    _ => {
      return "";
    }
  }
  return "";
}

pub struct Imports { paths: string[], unloaded: string[], sights: parser.ModuleSight[] }

function module_imports(mod: parser.Module): Imports {
  return Imports { paths: import_paths_of(mod), unloaded: unloaded_qualifiers(mod), sights: mod.sights };
}

function unloaded_qualifiers(mod: parser.Module): string[] {
  let out: string[] = [];
  for im in mod.imports {
    if (im.resolved.len() == 0) {
      out = out.append(parser.import_qualifier(im));
    }
  }
  return out;
}

function (im: Imports) package_of(module: string): string {
  for sg in im.sights {
    if (sg.module == module) {
      return sg.package;
    }
  }
  return "";
}

function (im: Imports) same_package(a: string, b: string): boolean {
  let pa = im.package_of(a);
  return pa.len() > 0 && pa == im.package_of(b);
}

function (im: Imports) sees(from: string, decl: string): boolean {
  if (from == decl) {
    return true;
  }
  for sg in im.sights {
    if (sg.module == from) {
      return util.has_str(sg.reaches, decl);
    }
  }
  return true;
}

function import_paths_of(mod: parser.Module): string[] {
  let out: string[] = [];
  for im in mod.imports {
    out = out.append(im.path);
  }
  return out;
}

function settle_generic_lit_fields(sl: ast.ExprStructLit, fields: ast.Expr[], s: Scope): ast.Expr[] {
  let Some(sig) = s.lookup_struct(sl.type_name) else {
    return fields;
  };
  if (sig.type_params.len() == 0) {
    return fields;
  }
  let largs = struct_lit_args(sl, sig, s);
  let out: ast.Expr[] = [];
  let i = 0;
  while (i < fields.len()) {
    let v = fields[i];
    let fi = -1;
    if (i < sl.field_names.len()) {
      fi = field_index(sig, sl.field_names[i]);
    }
    if (fi >= 0 && fi < sig.field_type_names.len()) {
      v = settle_wide_literals(v, type_from_ref_subst(parser.parse_type_ref(sig.field_type_names[fi]), sig.type_params, largs, s.type_names()));
    }
    out = out.append(v);
    i += 1;
  }
  return out;
}

function settle_wide_literals(e: ast.Expr, t: typeinfo.Type): ast.Expr {
  if (lit_suffix_spelled(type_to_irtag(t)) && int_literal_tree(e)) {
    return settle_int_tree(e, type_to_irtag(t));
  }
  if let typeinfo.TypeArray(at) = t {
    if let ast.ExprArray(ea) = e {
      let ne: ast.Expr[] = [];
      for el in ea.elements {
        ne = ne.append(settle_wide_literals(el, at.elem));
      }
      return ast.ExprArray { ...ea, elements: ne };
    }
  }
  if let typeinfo.TypeTuple(tt) = t {
    if let ast.ExprTuple(et) = e {
      let ne: ast.Expr[] = [];
      let k = 0;
      while (k < et.elements.len()) {
        if (k < tt.elements.len()) {
          ne = ne.append(settle_wide_literals(et.elements[k], tt.elements[k]));
        } else {
          ne = ne.append(et.elements[k]);
        }
        k += 1;
      }
      return ast.ExprTuple { ...et, elements: ne };
    }
  }
  return e;
}

function settle_int_tree(e: ast.Expr, tag: string): ast.Expr {
  return parser.settle_int_tree(e, tag);
}

function settle_at(e: ast.Expr, t: typeinfo.Type): ast.Expr {
  if (is_integer(t) && int_literal_tree(e)) {
    return settle_int_tree(e, type_to_irtag(t));
  }
  return e;
}

function settle_args_at_params(args: ast.Expr[], params: typeinfo.Type[]): ast.Expr[] {
  if (params.len() != args.len()) {
    return args;
  }
  let out: ast.Expr[] = [];
  let i = 0;
  while (i < args.len()) {
    out = out.append(settle_at(args[i], params[i]));
    i += 1;
  }
  return out;
}

function call_param_types(c: ast.ExprCall, s: Scope): typeinfo.Type[] {
  if let typeinfo.TypeFunc(ft) = check_expr(c.callee, s) {
    if (ft.params_known) {
      return ft.param_types;
    }
    return [];
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    let recv = check_expr(fa.obj, s);
    let key = receiver_key(recv);
    let found: Option[MethodSig] = None;
    if (key.len() > 0) {
      found = s.lookup_method(fa.field, key);
    } else {
      found = bound_method(s, tp_receiver(recv, s), fa.field);
    }
    if let Some(msig) = found {
      let rmb = method_binding(c, msig, recv, s);
      let out: typeinfo.Type[] = [];
      let i = 0;
      while (i < msig.param_types.len()) {
        out = out.append(receiver_bound(msig.param_types[i], param_type_name_at(msig, i), rmb, s));
        i += 1;
      }
      return out;
    }
  }
  return [];
}

function settle_array_literals(a: ast.ExprArray, s: Scope): ast.Expr {
  if (a.elem_ty.len() > 0) {
    return a;
  }
  let tag = "";
  for element in a.elements {
    let et = check_expr(element, s);
    if (tag.len() == 0 && numeric_literal_kind(element) == 0 && (is_integer(et) || is_float(et))) {
      tag = type_to_irtag(et);
    }
  }
  if (tag.len() == 0) {
    return settle_array_struct_literals(a, s);
  }
  let els: ast.Expr[] = [];
  for element in a.elements {
    if (int_literal_tree(element) && !util.has_str(["f32", "f64"], tag)) {
      els = els.append(settle_int_tree(element, tag));
    } else {
      els = els.append(element);
    }
  }
  return parser.settle_to_name(ast.ExprArray { ...a, elements: els }, tag + "[]");
}

function settle_array_struct_literals(a: ast.ExprArray, s: Scope): ast.Expr {
  if let typeinfo.TypeArray(at) = check_expr(a, s) {
    if (!reads_i64(at.elem)) {
      return a;
    }
    let els: ast.Expr[] = [];
    for element in a.elements {
      els = els.append(settle_struct_lit_wide(element, at.elem, s));
    }
    return ast.ExprArray { ...a, elements: els };
  }
  return a;
}

function settle_struct_lit_wide(e: ast.Expr, t: typeinfo.Type, s: Scope): ast.Expr {
  if let ast.ExprArray(a) = e {
    if let typeinfo.TypeArray(at) = t {
      let elements: ast.Expr[] = [];
      for child in a.elements {
        elements = elements.append(settle_struct_lit_wide(child, at.elem, s));
      }
      return ast.ExprArray { ...a, elements: elements };
    }
  }
  if let ast.ExprStructLit(sl) = e {
    if let typeinfo.TypeStruct(ts) = t {
      let Some(sig) = s.lookup_struct(sl.type_name) else {
        return e;
      };
      if (ts.name != sl.type_name || sig.type_params.len() != ts.args.len() || sig.type_params.len() == 0) {
        return e;
      }
      let nv: ast.Expr[] = [];
      let i = 0;
      while (i < sl.field_values.len()) {
        let v = sl.field_values[i];
        let fi: i32 = -1;
        if (i < sl.field_names.len()) {
          fi = field_index(sig, sl.field_names[i]);
        }
        if (fi >= 0 && fi < sig.field_type_names.len()) {
          let ft = type_from_ref_subst(parser.parse_type_ref(sig.field_type_names[fi]), sig.type_params, ts.args, s.type_names());
          v = settle_struct_lit_wide(settle_wide_literals(v, ft), ft, s);
        }
        nv = nv.append(v);
        i += 1;
      }
      return ast.ExprStructLit { ...sl, field_values: nv };
    }
  }
  return e;
}

struct Typed { e: ast.Expr, ty: typeinfo.Type, known: boolean }

function typed_type(t: Typed, orig: ast.Expr, s: Scope): typeinfo.Type {
  if (t.known) {
    return t.ty;
  }
  return check_expr(orig, s);
}

function annotate_expr(e: ast.Expr, s: Scope): ast.Expr {
  return annotate_typed(e, s).e;
}

function annotate_typed(e: ast.Expr, s: Scope): Typed {
  match (e) {
    ast.ExprIdent(id) => {
      let it = check_ident_expr(id, s);
      return Typed { e: ast.ExprIdent { ...id, ty: type_to_irtag(it) }, ty: it, known: true };
    },
    ast.ExprBinary(b) => {
      let lta = annotate_typed(b.left, s);
      let rta = annotate_typed(b.right, s);
      let left = lta.e;
      let right = rta.e;
      let lt = typed_type(lta, b.left, s);
      let rt = typed_type(rta, b.right, s);
      if (is_integer(lt) && is_integer(rt)) {
        if (int_literal_tree(b.left) && !int_literal_tree(b.right)) {
          left = settle_int_tree(left, type_to_irtag(rt));
        }
        if (int_literal_tree(b.right) && !int_literal_tree(b.left)) {
          right = settle_int_tree(right, type_to_irtag(lt));
        }
      }
      let common = binary_numeric_join(b, lt, rt);
      left = widen_binary_operand(left, lt, common, b.line, b.col);
      right = widen_binary_operand(right, rt, common, b.line, b.col);
      let bt = rt;
      if (b.op != "__named_arg") {
        bt = binary_result_type(b, lt, rt, s);
      }
      return Typed { e: ast.ExprBinary { op: b.op, left: left, right: right, line: b.line, col: b.col, ty: type_to_irtag(bt) }, ty: bt, known: true };
    },
    ast.ExprUnary(u) => {
      let oa = annotate_typed(u.operand, s);
      let ut = unary_result_type(u, typed_type(oa, u.operand, s), s);
      return Typed { e: ast.ExprUnary { op: u.op, operand: oa.e, line: u.line, col: u.col, ty: type_to_irtag(ut) }, ty: ut, known: true };
    },
    ast.ExprCall(c) => {
      let nargs: ast.Expr[] = [];
      for arg in c.args {
        nargs = nargs.append(annotate_expr(arg, s));
      }
      nargs = settle_args_at_params(nargs, call_param_types(c, s));
      nargs = display_rewrite(c, nargs, s);
      nargs = settle_shared_literal_typevars(c, nargs, s);
      let ct = check_expr(e, s);
      return Typed { e: ast.ExprCall { callee: annotate_callee(c, ct, s), args: nargs, line: c.line, col: c.col, type_args: stamped_type_args(c, s), ty: type_to_irtag(ct) }, ty: ct, known: true };
    },
    ast.ExprFieldAccess(fa) => {
      let oa = annotate_typed(fa.obj, s);
      let vqu = qual_variant_union(fa, s);
      let ft = t_union(vqu);
      if (vqu.len() == 0) {
        ft = field_access_result_type(fa, typed_type(oa, fa.obj, s), s);
      }
      let member = fa.field;
      if (member == "iter" && s.has_method("__iterator", "Map")) {
        if let typeinfo.TypeMap(_) = typed_type(oa, fa.obj, s) {
          member = "__iterator";
        }
      }
      member = s.resolved_member(member, typed_type(oa, fa.obj, s));
      return Typed { e: ast.ExprFieldAccess { ...fa, obj: oa.e, field: member, ty: type_to_irtag(ft) }, ty: ft, known: true };
    },
    ast.ExprIndex(x) => {
      let aa = annotate_typed(x.array, s);
      let ia = annotate_typed(x.index, s);
      let xt = index_result_type(typed_type(aa, x.array, s), typed_type(ia, x.index, s));
      return Typed { e: ast.ExprIndex { array: aa.e, index: ia.e, unchecked: x.unchecked, ty: type_to_irtag(xt), line: x.line, col: x.col }, ty: xt, known: true };
    },
    ast.ExprSlice(sl) => {
      let aa = annotate_typed(sl.array, s);
      let at = typed_type(aa, sl.array, s);
      return Typed { e: ast.ExprSlice { ...sl, array: aa.e, start: annotate_expr(sl.start, s), end: annotate_expr(sl.end, s), ty: type_to_arrtag(at) }, ty: at, known: false };
    },
    ast.ExprArray(a) => {
      let na: ast.Expr[] = [];
      for element in a.elements {
        na = na.append(annotate_expr(element, s));
      }
      return unsettled(settle_array_literals(ast.ExprArray { ...a, elements: na }, s));
    },
    ast.ExprTuple(t) => {
      let nt: ast.Expr[] = [];
      for element in t.elements {
        nt = nt.append(annotate_expr(element, s));
      }
      return unsettled(ast.ExprTuple { elements: nt, line: t.line, col: t.col });
    },
    ast.ExprStructLit(sli) => {
      let nfv: ast.Expr[] = [];
      for field_value in sli.field_values {
        nfv = nfv.append(annotate_expr(field_value, s));
      }
      nfv = settle_generic_lit_fields(sli, nfv, s);
      let nbase = sli.base;
      if (sli.has_base) {
        nbase = annotate_expr(sli.base, s);
      }
      return unsettled(ast.ExprStructLit { ...sli, field_values: nfv, base: nbase });
    },
    ast.ExprLambda(lm) => {
      return unsettled(annotate_lambda_expr(lm, s, "", t_unknown("")));
    },
    _ => {
      return unsettled(e);
    }
  }
  return unsettled(e);
}

function stamped_type_args(c: ast.ExprCall, s: Scope): string[] {
  let Some(sig) = free_generic_sig(c, s) else {
    return c.type_args;
  };
  if (c.type_args.len() > 0 || sig.all_type_params.len() == 0 || c.args.len() != sig.param_types.len()) {
    return c.type_args;
  }
  let (bn, bt) = call_type_bindings(sig, c, s);
  let out: string[] = [];
  for tp in sig.all_type_params {
    let bi = util.index_of_str(bn, tp);
    if (bi < 0 || type_contains_unknown(bt[bi]) || width_open(bt[bi])) {
      return c.type_args;
    }
    let spelled = typeinfo.spelling(bt[bi]);
    if (spelled.len() == 0) {
      return c.type_args;
    }
    out = out.append(parser.canonicalise_type_args(spelled));
  }
  return out;
}

function free_generic_sig(c: ast.ExprCall, s: Scope): Option[FuncSig] {
  if let ast.ExprIdent(cid) = c.callee {
    let Some(sig) = s.lookup_sig(cid.name) else {
      return None;
    };
    if (!s.is_bound(cid.name) && sig.receiver.len() == 0) {
      return Some(sig);
    }
  }
  return None;
}

function width_open(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(_) => {
      return is_poly_int(t);
    },
    typeinfo.TypeFloat(_) => {
      return is_poly_float(t);
    },
    typeinfo.TypeArray(a) => {
      return width_open(a.elem);
    },
    typeinfo.TypeMap(m) => {
      return width_open(m.key) || width_open(m.value);
    },
    typeinfo.TypeTuple(tup) => {
      return any_width_open(tup.elements);
    },
    typeinfo.TypeStruct(r) => {
      return any_width_open(r.args);
    },
    typeinfo.TypeUnion(u) => {
      return any_width_open(u.args);
    },
    typeinfo.TypeFunc(f) => {
      return width_open(f.ret_type) || any_width_open(f.param_types);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function any_width_open(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (width_open(t)) {
      return true;
    }
  }
  return false;
}

function annotate_callee(c: ast.ExprCall, ct: typeinfo.Type, s: Scope): ast.Expr {
  if let ast.ExprIdent(id) = c.callee {
    if let typeinfo.TypeUnion(u) = ct {
      if (!s.is_bound(id.name) && !s.has_sig(id.name)) {
        return ast.ExprIdent { ...id, ty: u.name };
      }
    }
    return annotate_expr(c.callee, s);
  }
  if let ast.ExprLambda(lm) = c.callee {
    if (parser.is_value_block(c)) {
      return annotate_lambda_expr(lm, s, "", ct);
    }
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (is_unsafe_builtin_method(receiver_key(check_expr(fa.obj, s)), fa.field)) {
      return annotate_expr(ast.ExprFieldAccess { ...fa, field: "close" }, s);
    }
  }
  let typed = annotate_typed(c.callee, s);
  if let typeinfo.TypeFunc(_) = typed.ty {
    return annotate_callable_callee(typed.e, type_label(typed.ty));
  }
  return typed.e;
}

// The lift pass needs complete callback parameters on indirect callees.
function annotate_callable_callee(e: ast.Expr, signature: string): ast.Expr {
  if (signature.len() == 0) {
    return e;
  }
  match (e) {
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, ty: signature };
    },
    ast.ExprIndex(ix) => {
      return ast.ExprIndex { ...ix, ty: signature };
    },
    ast.ExprCall(c) => {
      return ast.ExprCall { ...c, ty: signature };
    },
    _ => {
      return e;
    }
  }
}

function unsettled(e: ast.Expr): Typed {
  return Typed { e: e, ty: t_unknown("unsettled"), known: false };
}

function annotate_lambda_expr(lm: ast.ExprLambda, s: Scope, self_name: string, block: typeinfo.Type): ast.Expr {
  let captures: ast.TypedBinding[] = [];
  let seen: string[] = [];
  for name in astwalk.collect_lambda_idents(lm, []) {
    if (name != self_name && s.is_bound(name) && !util.has_str(seen, name)) {
      captures = captures.append(ast.TypedBinding { name: name, ty: s.lookup(name) });
      seen = seen.append(name);
    }
  }
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(s.resolve_param(param));
  }
  let rt = lambda_ret_type(lm, s);
  let ls = Scope { ...s, loop_depth: 0, ret_type: rt, try_ret: rt };
  if (parser.is_value_block_origin(lm.origin)) {
    ls = Scope { ...s, loop_depth: 0, ret_type: rt };
  }
  if (self_name.len() > 0) {
    ls = ls.bind(self_name, t_func_own(pts, lambda_owns(lm), rt));
  }
  let i = 0;
  while (i < lm.params.len()) {
    ls = ls.bind(lm.params[i].name, pts[i]);
    i += 1;
  }
  let typed = lm;
  if (lm.ret_type.len() == 0 || parser.is_value_block_origin(lm.origin)) {
    typed = inferred_lambda_result(lm, ls, lm.ret_type.len() > 0, block);
  }
  let body = ls;
  if (lm.ret_type.len() == 0 || parser.is_value_block_origin(lm.origin)) {
    body = Scope { ...ls, ret_type: t_unknown("") };
  }
  return ast.ExprLambda { ...typed, body: annotate_block(lm.body, body), captures: captures, captures_known: true };
}

function names_whole_type(t: typeinfo.Type, s: Scope): boolean {
  if (type_contains_unknown(t)) {
    return false;
  }
  match (t) {
    typeinfo.TypeUnion(u) => {
      return u.args.len() >= union_arity(s, u.name) && all_names_whole(u.args, s);
    },
    typeinfo.TypeArray(a) => {
      return names_whole_type(a.elem, s);
    },
    typeinfo.TypeTuple(tt) => {
      return all_names_whole(tt.elements, s);
    },
    typeinfo.TypeMap(m) => {
      return names_whole_type(m.key, s) && names_whole_type(m.value, s);
    },
    typeinfo.TypeStruct(sd) => {
      return all_names_whole(sd.args, s);
    },
    _ => {
      return true;
    }
  }
  return true;
}

function all_names_whole(ts: typeinfo.Type[], s: Scope): boolean {
  for t in ts {
    if (!names_whole_type(t, s)) {
      return false;
    }
  }
  return true;
}

function union_arity(s: Scope, name: string): i32 {
  if (name == "Option") {
    return 1;
  }
  if (name == "Result") {
    return 2;
  }
  return union_type_params(s, name).len();
}

function inferred_lambda_result(lm: ast.ExprLambda, body_scope: Scope, need_whole: boolean, block: typeinfo.Type): ast.ExprLambda {
  let (returned, at) = first_returned(lm.body, body_scope);
  if (parser.bare_return(returned) || int_literal_tree(returned)) {
    return lm;
  }
  let t = block;
  if (is_unknown(t)) {
    t = check_expr(returned, at);
  }
  if (need_whole && !names_whole_type(t, at)) {
    return lm;
  }
  if let typeinfo.TypeFloat(f) = t {
    if (f.polymorphic) {
      return lm;
    }
  }
  if (is_unknown(t)) {
    return lm;
  }
  if let typeinfo.TypeFunc(_) = t {
    let callable = decltypes.fn_param_from_type("", t);
    if (callable.type_name != "fn") {
      return lm;
    }
    return ast.ExprLambda { ...lm, ret_type: "fn", ret_fn_ret: callable.fn_ret, ret_fn_param_types: callable.fn_param_types };
  }
  if (spells_function(t)) {
    return lm;
  }
  return ast.ExprLambda { ...lm, ret_type: typeinfo.spelling(t) };
}

function spells_function(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeFunc(_) => {
      return true;
    },
    typeinfo.TypeArray(a) => {
      return spells_function(a.elem);
    },
    typeinfo.TypeTuple(tup) => {
      for e in tup.elements {
        if (spells_function(e)) {
          return true;
        }
      }
    },
    typeinfo.TypeMap(m) => {
      return spells_function(m.key) || spells_function(m.value);
    },
    typeinfo.TypeStruct(st) => {
      for a in st.args {
        if (spells_function(a)) {
          return true;
        }
      }
    },
    typeinfo.TypeUnion(u) => {
      for a in u.args {
        if (spells_function(a)) {
          return true;
        }
      }
    },
    _ => {}
  }
  return false;
}

function annotate_block(body: ast.Stmt[], s: Scope): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let cur = s;
  for stmt in body {
    let (annotated, next) = annotate_bound(stmt, cur);
    out = out.append(annotated);
    cur = next;
  }
  return out;
}

// annotate_bound annotates stmt in s and binds what it declares. A plain local
// is annotated before the bind, so that the bind is the last use of s.
function annotate_bound(stmt: ast.Stmt, s: Scope): (ast.Stmt, Scope) {
  if let ast.StmtVar(v) = stmt {
    if (!name_has_comma(v.name) && !parser.is_destr_marker(v.type_name)) {
      let t = var_bind_type(v, s);
      let annotated = annotate_var(v, s, t);
      return (annotated, bind_var(v, s, t));
    }
  }
  let next = bind_stmt(stmt, s);
  return (annotate_stmt(stmt, s, next), next);
}

struct ForBinding { scope: Scope, valid: boolean }

function range_var_type(iter: ast.Expr, s: Scope): typeinfo.Type {
  if let ast.ExprCall(c) = iter {
    for bound in c.args {
      if (!int_literal_tree(bound)) {
        let t = check_expr(bound, s);
        if (is_integer(t)) {
          return t;
        }
      }
    }
  }
  return t_i32();
}

function for_binding(fr: ast.StmtFor, s: Scope): ForBinding {
  let body = s.enter_loop();
  if (for_iter_is_range(fr.iter)) {
    return ForBinding { scope: bind_for_element(body, fr.var_name, range_var_type(fr.iter, s)), valid: !name_has_comma(fr.var_name) };
  }
  let it = check_expr(fr.iter, s);
  match (it) {
    typeinfo.TypeString(_) => {
      return ForBinding { scope: bind_for_element(body, fr.var_name, t_u8()), valid: !name_has_comma(fr.var_name) };
    },
    typeinfo.TypeArray(ta) => {
      return ForBinding { scope: bind_for_element(body, fr.var_name, ta.elem), valid: true };
    },
    typeinfo.TypeMap(tm) => {
      let names = split_pattern_names(fr.var_name);
      return ForBinding { scope: bind_tuple_destr_names(body, names, t_tuple([tm.key, tm.value])), valid: names.len() == 2 };
    },
    _ => {
      let sub = iter_subject(it, s);
      return ForBinding { scope: bind_for_element(body, fr.var_name, sub.elem), valid: sub.ok };
    }
  }
  return ForBinding { scope: bind_for_element(body, fr.var_name, t_unknown("invalid iterator")), valid: false };
}

function bind_for_element(s: Scope, name: string, ty: typeinfo.Type): Scope {
  if (name_has_comma(name)) {
    return bind_tuple_destr_names(s, split_pattern_names(name), ty);
  }
  if (name == "_") {
    return s;
  }
  return s.bind(name, ty);
}

pub function for_body_scope(fr: ast.StmtFor, s: Scope): Scope {
  return for_binding(fr, s).scope;
}

function annotate_variant_struct(name: string, s: Scope): string {
  if (s.has_struct(name)) {
    return name;
  }
  let d = dot_index(name);
  if (d < 0) {
    return "";
  }
  let bare = variant_pattern_name(name);
  if (!is_variant_of(bare, slice_unchecked(name, 0, d) + "", s.unions.unions)) {
    return "";
  }
  if (s.has_struct(bare)) {
    return bare;
  }
  return "";
}

function annotate_arm_scope(arm: ast.MatchArm, s: Scope, whole: typeinfo.Type): Scope {
  match (arm.pattern) {
    ast.PatLiteral(literal) => {
      if (literal.at_binding.len() > 0) {
        return s.bind(literal.at_binding, whole);
      }
      return s;
    },
    ast.PatVariant(pv) => {
      let vn = annotate_variant_struct(pv.type_name, s);
      if (vn.len() == 0) {
        return bind_variant_payloads(s, s, pv, whole);
      }
      return bind_variant_payloads(s, s, ast.PatVariant { ...pv, type_name: vn }, whole);
    },
    ast.PatWildcard(_) => {
      return s;
    }
  }
  return s;
}

function annotate_match_stmt(m: ast.StmtMatch, s: Scope): ast.Stmt {
  let narms: ast.MatchArm[] = [];
  for arm in m.arms {
    let whole = check_expr(m.scrutinee, s);
    let pattern = arm.pattern;
    if let ast.PatVariant(pv) = pattern {
      pattern = ast.PatVariant { ...pv, bare_name: false, scalar_binding: scalar_binding_name(pv, whole, s).len() > 0 };
    }
    let asc = annotate_arm_scope(arm, s, whole);
    let g = arm.guard;
    if (arm.has_guard) {
      g = annotate_expr(arm.guard, asc);
    }
    narms = narms.append(ast.MatchArm { ...arm, pattern: pattern, body: annotate_block(arm.body, asc), guard: g });
  }
  return ast.StmtMatch { ...m, scrutinee: annotate_expr(m.scrutinee, s), arms: narms };
}

// annotate_var annotates v in s, where t is the type that the local gets.
function annotate_var(v: ast.StmtVar, s: Scope, t: typeinfo.Type): ast.Stmt {
  let init = v.init;
  if let ast.ExprLambda(lm) = v.init {
    init = annotate_lambda_expr(lm, s, rec_local_name(v), t_unknown(""));
  } else {
    init = annotate_expr(v.init, s);
  }
  if (v.type_name.len() > 0) {
    init = settle_at(init, t);
  }
  let callable = decltypes.fn_param_from_type(v.name, t);
  if (callable.type_name == "fn") {
    return ast.StmtVar {
      ...v, type_name: "fn", init: init,
      fn_ret: callable.fn_ret, fn_param_types: callable.fn_param_types,
    };
  }
  return ast.StmtVar { ...v, init: init };
}

function annotate_stmt(st: ast.Stmt, s: Scope, after: Scope): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return annotate_var(v, s, after.lookup(v.name));
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: settle_at(annotate_expr(r.value, s), s.ret_type), line: r.line, col: r.col };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: annotate_expr(x.value, s) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: annotate_expr(f.cond, s), then_body: annotate_block(f.then_body, s), else_body: annotate_block(f.else_body, s) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: annotate_expr(w.cond, s), body: annotate_block(w.body, s), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: settle_at(annotate_expr(a.value, s), s.lookup(a.target)) };
    },
    ast.StmtMatch(m) => {
      return annotate_match_stmt(m, s);
    },
    ast.StmtFor(fr) => {
      if let Some(lowered) = iterator_lowering(fr, s) {
        return annotate_stmt(lowered, s, after);
      }
      return ast.StmtFor { var_name: fr.var_name, iter: annotate_expr(fr.iter, s), body: annotate_block(fr.body, for_body_scope(fr, s)), label: fr.label, line: fr.line, col: fr.col };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: annotate_stmt(d.action, s, after), on_error: d.on_error, line: d.line };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function annotate_func(fd: parser.FuncDecl, env: ModuleEnv): parser.FuncDecl {
  let s = build_func_scope(fd, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  return parser.FuncDecl { ...fd, body: annotate_block(fd.body, s) };
}

pub function annotate_module(mod: parser.Module): parser.Module {
  return annotate_module_in(mod, module_env(mod), whole_focus(mod));
}

struct Focus { funcs: boolean[], top: boolean }

function whole_focus(mod: parser.Module): Focus {
  let funcs: boolean[] = [];
  for fd in mod.funcs {
    funcs = funcs.append(true);
  }
  return Focus { funcs: funcs, top: true };
}

function annotate_module_in(mod: parser.Module, env: ModuleEnv, focus: Focus): parser.Module {
  let rmod = pretype_module_in(settle_literal_locals_in(qualify_variants_in(mod, env, focus), env, focus), env, focus);
  let nfuncs: parser.FuncDecl[] = [];
  let i = 0;
  while (i < rmod.funcs.len()) {
    if (focus.funcs[i]) {
      nfuncs = nfuncs.append(annotate_func(rmod.funcs[i], env));
    } else {
      nfuncs = nfuncs.append(rmod.funcs[i]);
    }
    i += 1;
  }
  let ntop = rmod.top_stmts;
  if (focus.top) {
    ntop = annotate_block(rmod.top_stmts, new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs));
  }
  return parser.Module { funcs: nfuncs, structs: rmod.structs, aliases: rmod.aliases, imports: rmod.imports, top_stmts: ntop, enums: rmod.enums, resources: rmod.resources, exports: rmod.exports, marks: rmod.marks, impls: rmod.impls, trait_reqs: rmod.trait_reqs, trait_decls: rmod.trait_decls, inferred_consts: rmod.inferred_consts, todo_sites: rmod.todo_sites, sights: rmod.sights };
}

function unchecked_capture(e: ast.Expr, own found: boolean): boolean {
  if let ast.ExprLambda(lm) = e {
    return found || !lm.captures_known;
  }
  return found;
}

function display_unrewritten(e: ast.Expr, own found: boolean): boolean {
  if (found) {
    return true;
  }
  if let ast.ExprCall(c) = e {
    if (c.args.len() != 1) {
      return false;
    }
    if let ast.ExprIdent(id) = c.callee {
      if (id.name != "print" && id.name != "write" && id.name != "eprint") {
        return false;
      }
      if let ast.ExprString(_) = c.args[0] {
        return false;
      }
      if let ast.ExprFString(_) = c.args[0] {
        return false;
      }
      return ast.expr_ty(c.args[0]) != "string";
    }
  }
  return false;
}

function unannotated(stmts: ast.Stmt[]): boolean {
  let found = false;
  for st in stmts {
    found = astwalk.fold_stmt_nodes(st, found, unresolved_scalar_pattern, unchecked_or_unrewritten, astwalk.descend_all);
  }
  return found;
}

function unresolved_scalar_pattern(st: ast.Stmt, own found: boolean): boolean {
  if let ast.StmtMatch(m) = st {
    for arm in m.arms {
      if let ast.PatVariant(pv) = arm.pattern {
        if (pv.bare_name && !pv.scalar_binding) {
          return true;
        }
      }
    }
  }
  return found;
}

function unchecked_or_unrewritten(e: ast.Expr, own found: boolean): boolean {
  return display_unrewritten(e, unchecked_capture(e, found));
}

function unannotated_focus(mod: parser.Module): Focus {
  let funcs: boolean[] = [];
  for fd in mod.funcs {
    funcs = funcs.append(unannotated(fd.body));
  }
  return Focus { funcs: funcs, top: unannotated(mod.top_stmts) };
}

function any_focus(f: Focus): boolean {
  if (f.top) {
    return true;
  }
  for b in f.funcs {
    if (b) {
      return true;
    }
  }
  return false;
}

pub function ensure_annotated(mod: parser.Module): parser.Module {
  let focus = unannotated_focus(mod);
  if (any_focus(focus)) {
    return annotate_module_in(mod, module_env(mod), focus);
  }
  return mod;
}

pub function ensure_annotated_parts(mods: parser.Module[]): parser.Module[] {
  let needed = false;
  let focus: Focus[] = [];
  for mod in mods {
    let f = unannotated_focus(mod);
    if (any_focus(f)) {
      needed = true;
    }
    focus = focus.append(f);
  }
  if (!needed) {
    return mods;
  }
  let funcs: parser.FuncDecl[] = [];
  let structs: parser.StructDecl[] = [];
  let aliases: parser.TypeAlias[] = [];
  let enums: parser.EnumDecl[] = [];
  for mod in mods {
    for fd in mod.funcs {
      funcs = funcs.append(fd);
    }
    for sd in mod.structs {
      structs = structs.append(sd);
    }
    for ad in mod.aliases {
      aliases = aliases.append(ad);
    }
    for ed in mod.enums {
      enums = enums.append(ed);
    }
  }
  let view = parser.Module { ...mods[0], funcs: funcs, structs: structs, aliases: aliases, enums: enums };
  let env = module_env(view);
  let out: parser.Module[] = [];
  let k = 0;
  while (k < mods.len()) {
    if (any_focus(focus[k])) {
      out = out.append(annotate_module_in(mods[k], ModuleEnv { ...env, imports: module_imports(mods[k]) }, focus[k]));
    } else {
      out = out.append(mods[k]);
    }
    k += 1;
  }
  return out;
}

function vb_local_name(body: ast.Stmt[]): string {
  if (body.len() < 3) {
    return "";
  }
  let name = "";
  match (body[0]) {
    ast.StmtVar(v) => {
      if (v.type_name.len() > 0 && !parser.is_value_local_name(v.name) || name_has_comma(v.name)) {
        return "";
      }
      name = v.name;
    },
    _ => {
      return "";
    }
  }
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      if (ow_ident_name(r.value) == name) {
        return name;
      }
    },
    _ => {}
  }
  return "";
}

struct VbStore { t: typeinfo.Type, e: ast.Expr }

function vb_assigned_stores(stmts: ast.Stmt[], name: string, s: Scope, acc: VbStore[]): VbStore[] {
  let out = acc;
  let cur = s;
  for st in stmts {
    match (st) {
      ast.StmtAssign(a) => {
        if (a.target == name) {
          out = out.append(VbStore { t: check_expr(a.value, cur), e: a.value });
        }
      },
      ast.StmtIf(f) => {
        out = vb_assigned_stores(f.then_body, name, cur, out);
        out = vb_assigned_stores(f.else_body, name, cur, out);
      },
      ast.StmtWhile(w) => {
        out = vb_assigned_stores(w.body, name, cur, out);
      },
      ast.StmtFor(fr) => {
        out = vb_assigned_stores(fr.body, name, for_body_scope(fr, cur), out);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = vb_assigned_stores(arm.body, name, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), out);
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = vb_assigned_stores(one, name, cur, out);
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function vb_untyped_fits(e: ast.Expr, t: typeinfo.Type): boolean {
  if (!int_literal_tree(e)) {
    return false;
  }
  return is_float(t) || is_integer(t) && int_range_diags(e, type_to_irtag(t), false).len() == 0;
}

function vb_pinned_ranges(ts: typeinfo.Type[], es: ast.Expr[]): util.Diag[] {
  let out: util.Diag[] = [];
  if (ts.len() != es.len() || ts.len() == 0) {
    return out;
  }
  if let typeinfo.TypeTuple(t0) = ts[0] {
    let n = t0.elements.len();
    let cols: typeinfo.Type[][] = [];
    let ecols: ast.Expr[][] = [];
    let k = 0;
    while (k < n) {
      cols = cols.append([]);
      ecols = ecols.append([]);
      k += 1;
    }
    let i = 0;
    while (i < ts.len()) {
      if let typeinfo.TypeTuple(ti) = ts[i] {
        if (ti.elements.len() != n) {
          return out;
        }
        let ei = vb_tuple_elems(es[i], n);
        k = 0;
        while (k < n) {
          cols = cols.with(k, cols[k].append(ti.elements[k]));
          ecols = ecols.with(k, ecols[k].append(ei[k]));
          k += 1;
        }
      } else {
        return out;
      }
      i += 1;
    }
    k = 0;
    while (k < n) {
      out = util.append_diags(out, vb_pinned_ranges(cols[k], ecols[k]));
      k += 1;
    }
    return out;
  }
  let pin = "";
  let i = 0;
  while (i < ts.len() && pin.len() == 0) {
    if (is_integer(ts[i]) && !int_literal_tree(es[i])) {
      pin = type_to_irtag(ts[i]);
    }
    i += 1;
  }
  if (pin.len() == 0) {
    return out;
  }
  i = 0;
  while (i < es.len()) {
    if (int_literal_tree(es[i])) {
      out = util.append_diags(out, int_range_diags(es[i], pin, false));
    }
    i += 1;
  }
  return out;
}

function vb_empty_arrays_fit(e: ast.Expr, want: typeinfo.Type): boolean {
  if let ast.ExprArray(array) = e {
    if let typeinfo.TypeArray(target) = want {
      if (target.view) {
        return false;
      }
      for item in array.elements {
        if (!vb_empty_arrays_fit(item, target.elem)) {
          return false;
        }
      }
      return true;
    }
  }
  return false;
}

function vb_join(a: VbStore, b: VbStore): VbStore {
  let scalar = scalar_numeric_join(a.t, b.t);
  if (scalar_vb_joinable(a, b, scalar)) {
    return VbStore { t: scalar, e: ast.ExprUnknown { kind: "", line: 0, col: 0 } };
  }
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  if let typeinfo.TypeTuple(at) = a.t {
    if let typeinfo.TypeTuple(bt) = b.t {
      if (at.elements.len() != bt.elements.len()) {
        return VbStore { t: t_unknown("result tuple arities differ"), e: none };
      }
      let aes = vb_tuple_elems(a.e, at.elements.len());
      let bes = vb_tuple_elems(b.e, bt.elements.len());
      let elems: typeinfo.Type[] = [];
      let es: ast.Expr[] = [];
      let i = 0;
      while (i < at.elements.len()) {
        let j = vb_join(VbStore { t: at.elements[i], e: aes[i] }, VbStore { t: bt.elements[i], e: bes[i] });
        if (is_unknown(j.t)) {
          return j;
        }
        elems = elems.append(j.t);
        es = es.append(j.e);
        i += 1;
      }
      return VbStore { t: t_tuple(elems), e: ast.ExprTuple { elements: es, line: 0, col: 0 } };
    }
  }
  if let typeinfo.TypeArray(aa) = a.t {
    if let typeinfo.TypeArray(ba) = b.t {
      if (aa.view == ba.view) {
        if (vb_empty_arrays_fit(a.e, b.t)) {
          return b;
        }
        if (vb_empty_arrays_fit(b.e, a.t)) {
          return a;
        }
        let j = vb_join(mx_elem_store(a.e, aa.elem), mx_elem_store(b.e, ba.elem));
        let t: typeinfo.Type = typeinfo.TypeArray { ...aa, elem: j.t };
        if let ast.ExprUnknown(_) = j.e {
          return VbStore { t: t, e: none };
        }
        return VbStore { t: t, e: a.e };
      }
    }
  }
  if let typeinfo.TypeMap(_) = a.t {
    if let typeinfo.TypeMap(_) = b.t {
      if (bare_map(a.t)) {
        return b;
      }
      if (bare_map(b.t)) {
        return a;
      }
    }
  }
  let t = join_result_types(a.t, b.t);
  if (is_unknown(t) && vb_untyped_fits(b.e, a.t)) {
    t = a.t;
  } else if (is_unknown(t) && vb_untyped_fits(a.e, b.t)) {
    t = b.t;
  }
  if (!is_unknown(t) && vb_untyped_fits(a.e, t) && vb_untyped_fits(b.e, t)) {
    return VbStore { t: t, e: a.e };
  }
  return VbStore { t: t, e: none };
}

function vb_tuple_elems(e: ast.Expr, n: i32): ast.Expr[] {
  if let ast.ExprTuple(t) = e {
    if (t.elements.len() == n) {
      return t.elements;
    }
  }
  let out: ast.Expr[] = [];
  let i = 0;
  while (i < n) {
    out = out.append(ast.ExprUnknown { kind: "", line: 0, col: 0 });
    i += 1;
  }
  return out;
}

function vb_arms_unified(ts: typeinfo.Type[], es: ast.Expr[]): typeinfo.Type {
  if (ts.len() != es.len()) {
    return vb_unified(ts);
  }
  let ss: VbStore[] = [];
  let i = 0;
  while (i < ts.len()) {
    ss = ss.append(VbStore { t: ts[i], e: es[i] });
    i += 1;
  }
  return vb_stores_unified(ss);
}

function vb_stores_unified(ss0: VbStore[]): typeinfo.Type {
  if (ss0.len() == 0) {
    return t_unknown("value block stores nothing");
  }
  let ss: VbStore[] = [];
  for st in ss0 {
    if (!unbound_enum_argument(st.t)) {
      ss = ss.append(st);
    }
  }
  if (ss.len() == 0) {
    return ss0[0].t;
  }
  let acc = ss[0];
  let i = 1;
  while (i < ss.len() && !is_unknown(acc.t)) {
    acc = vb_join(acc, ss[i]);
    i += 1;
  }
  if (is_unknown(acc.t) && ss.len() > 1) {
    return t_unknown("value block arms disagree");
  }
  return acc.t;
}

function vb_unified(ts: typeinfo.Type[]): typeinfo.Type {
  if (ts.len() == 0) {
    return t_unknown("value block stores nothing");
  }
  let k = 0;
  while (k < ts.len() - 1 && unbound_enum_argument(ts[k])) {
    k += 1;
  }
  let first = ts[k];
  if (is_unknown(first)) {
    return first;
  }
  let i = k + 1;
  while (i < ts.len()) {
    first = join_result_types(first, ts[i]);
    if (is_unknown(first)) {
      return t_unknown("value block arms disagree");
    }
    i += 1;
  }
  return first;
}

function vb_store_type(body: ast.Stmt[], name: string, s: Scope): typeinfo.Type {
  let t = vb_stores_unified(vb_value_stores(body, name, s));
  if (is_unknown(t)) {
    if let ast.StmtVar(v) = body[0] {
      let u = vb_union_dest(body, name, v.type_name, s);
      if (!is_unknown(u)) {
        return u;
      }
    }
  }
  return t;
}

function vb_value_stores(body: ast.Stmt[], name: string, s: Scope): VbStore[] {
  let chain: ast.Stmt[] = [];
  let i = 1;
  while (i < body.len() - 1) {
    chain = chain.append(body[i]);
    i += 1;
  }
  let none: VbStore[] = [];
  return vb_assigned_stores(chain, name, bind_stmt(body[0], s), none);
}

function vb_local_tag(t: typeinfo.Type): string {
  if (type_label(t) == "str") {
    return "";
  }
  let tag = type_to_irtag(t);
  if (tag == "string" || tag == "boolean" || tag == "f64" || tag == "f32" || tag == "char"
    || tag == "i32" || tag == "i64" || tag == "u32" || tag == "u64" || tag == "u8") {
    return tag;
  }
  return "";
}

function vb_annotation_of(t: typeinfo.Type, s: Scope): string {
  match (t) {
    typeinfo.TypeStruct(_) => {
      return type_label(t);
    },
    typeinfo.TypeTuple(_) => {
      return type_label(t);
    },
    typeinfo.TypeFunc(_) => {
      return typeinfo.spelling(t);
    },
    typeinfo.TypeArray(a) => {
      if (type_label(a.elem) == "str") {
        return "";
      }
      return typeinfo.spelling(t);
    },
    typeinfo.TypeUnion(_) => {
      if (!names_whole_type(t, s)) {
        return "";
      }
      return type_label(t);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function vb_wants_annotation(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnion(_) => {
      return true;
    },
    typeinfo.TypeStruct(_) => {
      return true;
    },
    typeinfo.TypeArray(_) => {
      return true;
    },
    typeinfo.TypeTuple(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function vb_placeholder_decl(v: ast.StmtVar): boolean {
  if (!parser.is_value_local_name(v.name) || v.type_name.len() == 0) {
    return false;
  }
  match (v.init) {
    ast.ExprNumber(n) => {
      return n.text == "0" && n.suffix.len() == 0 && !n.is_float;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function vb_zero_of(tag: string): ast.Expr {
  if (tag == "string") {
    return ast.ExprString { value: "", line: 0, col: 0 };
  }
  if (tag == "boolean") {
    return ast.ExprBool { value: false, line: 0, col: 0 };
  }
  if (tag == "f64") {
    return ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: true, bits: 0, line: 0, col: 0 };
  }
  if (tag == "f32") {
    return ast.ExprUnary { op: "as_f32", operand: vb_zero_of("f64"), line: 0, col: 0, ty: "f32" };
  }
  if (tag == "i32") {
    return ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, bits: 0, line: 0, col: 0 };
  }
  return ast.ExprNumber { text: "0", suffix: tag, raw: "", is_float: false, bits: 0, line: 0, col: 0 };
}

function vb_retype(e: ast.Expr, s: Scope): ast.Expr {
  return vb_retype_dest(e, s, "");
}

// vb_union_dest is the union `dest` names when every value the local `name`
// takes is a member of it.
function vb_union_dest(body: ast.Stmt[], name: string, dest: string, s: Scope): typeinfo.Type {
  let none = t_unknown("no union destination");
  if (dest.len() == 0 || parser.is_destr_marker(dest)) {
    return none;
  }
  let want = s.resolve_type(dest);
  if let typeinfo.TypeUnion(_) = want {
    for st in vb_value_stores(body, name, s) {
      if (is_unknown(st.t) || !type_assignable(st.t, want, s.unions.unions)) {
        return none;
      }
    }
    return want;
  }
  return none;
}

// vb_retype_at retypes a value block where a value of type want is expected.
function vb_retype_at(e: ast.Expr, want: typeinfo.Type, s: Scope): ast.Expr {
  if (is_unknown(want)) {
    return e;
  }
  return vb_retype_dest(e, s, vb_annotation_of(want, s));
}

function vb_retype_dest(e: ast.Expr, s: Scope, dest: string): ast.Expr {
  match (e) {
    ast.ExprCall(c) => {
      if (!parser.is_value_block(c)) {
        return e;
      }
      let body = parser.vb_body(c);
      let name = vb_local_name(body);
      if (name.len() == 0) {
        return e;
      }
      let want = vb_store_type(body, name, s);
      if (is_unknown(want)) {
        want = vb_union_dest(body, name, dest, s);
      }
      if (is_unknown(want)) {
        return e;
      }
      let tag = vb_local_tag(want);
      let nbody: ast.Stmt[] = [];
      match (body[0]) {
        ast.StmtVar(v) => {
          if (type_eq(check_expr(v.init, s), want)) {
            return e;
          }
          if (tag.len() > 0) {
            nbody = nbody.append(ast.StmtVar { ...v, init: vb_zero_of(tag) });
          } else {
            tag = vb_annotation_of(want, s);
            if (tag.len() == 0 && dest.len() > 0 && !parser.is_destr_marker(dest) && vb_wants_annotation(want)) {
              tag = dest;
            }
            if (tag.len() == 0) {
              return e;
            }
            nbody = nbody.append(ast.StmtVar { ...v, type_name: tag });
          }
        },
        _ => {
          return e;
        }
      }
      let j = 1;
      while (j < body.len()) {
        nbody = nbody.append(body[j]);
        j += 1;
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          return ast.ExprCall { ...c, callee: ast.ExprLambda { ...lm, ret_type: tag, body: nbody } };
        },
        _ => {
          return e;
        }
      }
    },
    _ => {
      return e;
    }
  }
  return e;
}

function pretype_expr(e: ast.Expr, s: Scope): ast.Expr {
  let (ne, ns, nh) = astwalk.map_expr_where(e, s, pretype_at_stmt, pretype_at_expr, astwalk.every_expr);
  return ne;
}

function pretype_at_stmt(st: ast.Stmt, s: Scope): (ast.Stmt, Scope, boolean) {
  return (st, s, false);
}

function pretype_at_expr(x: ast.Expr, s: Scope): (ast.Expr, Scope, boolean) {
  match (x) {
    ast.ExprCall(c) => {
      if (use_untyped(c)) {
        let uc = use_typed(c, s);
        let nargs: ast.Expr[] = [];
        for arg in uc.args {
          nargs = nargs.append(pretype_expr(arg, s));
        }
        return (ast.ExprCall { ...uc, callee: pretype_expr(uc.callee, s), args: nargs }, s, true);
      }
      if (!parser.is_value_block(c)) {
        if (any_value_block(c.args)) {
          return (pretype_value_block_args(c, s), s, true);
        }
        return (x, s, false);
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          let body = struct_record_value_body(lm, s);
          let inner: ast.Expr = ast.ExprCall { ...c, callee: ast.ExprLambda { ...lm, body: pretype_stmts(body, lambda_body_scope(lm, s)) } };
          return (vb_retype(inner, s), s, true);
        },
        _ => {
          return (x, s, false);
        }
      }
    },
    ast.ExprLambda(lm) => {
      return (ast.ExprLambda { ...lm, body: pretype_stmts(lm.body, lambda_body_scope(lm, s)) }, s, true);
    },
    _ => {
      return (x, s, false);
    }
  }
  return (x, s, false);
}

function pretype_value_block_args(c: ast.ExprCall, s: Scope): ast.Expr {
  let pts = s.call_param_types(c);
  let args: ast.Expr[] = [];
  let k = 0;
  while (k < c.args.len()) {
    args = args.append(vb_retype_at(pretype_expr(c.args[k], s), dest_slot(pts, k), s));
    k += 1;
  }
  return ast.ExprCall { ...c, callee: pretype_expr(c.callee, s), args: args };
}

function pretype_tuple_if(f: ast.StmtIf, s: Scope): ast.StmtIf {
  let ready = f;
  if (f.sugar.origin == "" && f.sugar.tup.len() > 0) {
    if let typeinfo.TypeTuple(tuple) = check_expr(f.sugar.scrut, s) {
      let wrong = false;
      for arm in f.sugar.tup {
        if (!arm.is_wild && arm.elem_kinds.len() != tuple.elements.len()) {
          wrong = true;
        }
      }
      if (wrong) {
        if let ast.StmtIf(rebuilt) = parser.build_tuple_match_sized(f.sugar.scrut, f.sugar.tup, tuple.elements.len(), f.sugar.line, f.sugar.col) {
          ready = rebuilt;
        }
      }
    }
  }
  return ready;
}

function pretype_if(st: ast.Stmt, f: ast.StmtIf, s: Scope): ast.Stmt {
  if let Some(m) = parser.struct_record_source(st) {
    if (struct_record_match(m, s)) {
      return pretype_stmt(parser.lower_struct_record_match(m, ""), s);
    }
  }
  let ready = pretype_tuple_if(f, s);
  return ast.StmtIf { ...ready, cond: pretype_expr(ready.cond, s), then_body: pretype_stmts(ready.then_body, s), else_body: pretype_stmts(ready.else_body, s) };
}

function pretype_match(m: ast.StmtMatch, s: Scope): ast.Stmt {
  if (struct_record_match(m, s)) {
    return pretype_stmt(parser.lower_struct_record_match(m, ""), s);
  }
  let narms: ast.MatchArm[] = [];
  let whole = check_expr(m.scrutinee, s);
  for arm0 in m.arms {
    let arm = ast.MatchArm { ...arm0, pattern: rescope_pattern(arm0.pattern, whole, s) };
    let asc = annotate_arm_scope(arm, s, whole);
    let g = arm.guard;
    if (arm.has_guard) {
      g = pretype_expr(arm.guard, asc);
    }
    narms = narms.append(ast.MatchArm { ...arm, body: pretype_stmts(arm.body, asc), guard: g });
  }
  return ast.StmtMatch { ...m, scrutinee: pretype_expr(m.scrutinee, s), arms: narms };
}

function pretype_stmt(st: ast.Stmt, s: Scope): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      let init = pretype_expr(v.init, s);
      if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name)) {
        init = vb_retype_dest(init, s, v.type_name);
      }
      return ast.StmtVar { ...v, init: init };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: vb_retype_at(pretype_expr(r.value, s), s.ret_type, s) };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: pretype_expr(x.value, s) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: vb_retype_at(pretype_expr(a.value, s), assign_dest_type(a, s), s) };
    },
    ast.StmtIf(f) => {
      return pretype_if(st, f, s);
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, cond: pretype_expr(w.cond, s), body: pretype_stmts(w.body, s) };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { ...fr, iter: pretype_expr(fr.iter, s), body: pretype_stmts(fr.body, for_body_scope(fr, s)) };
    },
    ast.StmtMatch(m) => {
      return pretype_match(m, s);
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: pretype_stmt(d.action, s) };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function pretype_stmts(stmts: ast.Stmt[], s: Scope): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let cur = s;
  for stmt in stmts {
    out = out.append(pretype_stmt(stmt, cur));
    cur = bind_stmt(stmt, cur);
  }
  return out;
}

function pretype_at(x: ast.Expr, own acc: boolean): boolean {
  if (acc) {
    return true;
  }
  match (x) {
    ast.ExprCall(c) => {
      if (use_untyped(c)) {
        return true;
      }
      if (!parser.is_value_block(c)) {
        return false;
      }
      return vb_local_name(parser.vb_body(c)).len() > 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function colliding_variant_names(mod: parser.Module): string[] {
  let full: string[] = [];
  for ed in mod.enums {
    for vn in ed.variant_names {
      full = full.append(vn);
    }
  }
  for sd in parser.inject_builtin_enums([]) {
    if (sd.enum_owner.len() > 0) {
      full = full.append(sd.name);
    }
  }
  let seen: string[] = [];
  let seen_full: string[] = [];
  let out: string[] = [];
  let i = 0;
  while (i < full.len()) {
    let b = variant_bare_name(full[i]);
    let at = util.index_of_str(seen, b);
    if (at < 0) {
      seen = seen.append(b);
      seen_full = seen_full.append(full[i]);
    } else if (seen_full[at] != full[i] && !util.has_str(out, b)) {
      out = out.append(b);
    }
    i += 1;
  }
  return out;
}

function variant_bare_name(name: string): string {
  let i = name.len() - 2;
  while (i > 0) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      return slice_unchecked(name, i + 2, name.len()) + "";
    }
    i -= 1;
  }
  return name;
}

function rescope_pattern(p: ast.Pattern, whole: typeinfo.Type, s: Scope): ast.Pattern {
  if let ast.PatVariant(pv) = p {
    if (variant_pattern_qualified(pv.type_name)) {
      return p;
    }
    if let typeinfo.TypeUnion(u) = whole {
      let members = enum_members(s, u.name, pv.type_name);
      if (util.has_str(members, pv.type_name)) {
        return p;
      }
      let bare = variant_bare_name(pv.type_name);
      for v in members {
        if (variant_bare_name(v) == bare) {
          return ast.PatVariant { ...pv, type_name: v };
        }
      }
    }
  }
  return p;
}

function enum_members(s: Scope, name: string, variant: string): string[] {
  if let Some(us) = s.lookup_union(name) {
    return us.variants;
  }
  let out: string[] = [];
  if (variant_bare_name(variant).len() == variant.len()) {
    return out;
  }
  for sd in parser.inject_builtin_enums([]) {
    if (sd.enum_owner == name) {
      out = out.append(sd.name);
    }
  }
  return out;
}

struct RescopeScan { coll: string[], found: boolean }

function rescope_at_stmt(st: ast.Stmt, own a: RescopeScan): RescopeScan {
  if (a.found) {
    return a;
  }
  if (pretype_needed_stmt(st, false)) {
    return RescopeScan { ...a, found: true };
  }
  if let ast.StmtMatch(m) = st {
    for arm in m.arms {
      if let ast.PatVariant(pv) = arm.pattern {
        if (parser.is_record_pattern(pv) || util.has_str(a.coll, variant_bare_name(pv.type_name))) {
          return RescopeScan { ...a, found: true };
        }
      }
    }
  }
  return a;
}

function rescope_at_expr(e: ast.Expr, own a: RescopeScan): RescopeScan {
  if (!a.found && pretype_at(e, false)) {
    return RescopeScan { ...a, found: true };
  }
  return a;
}

function needs_pretype_or_rescope(stmts: ast.Stmt[], coll: string[]): boolean {
  let a = RescopeScan { coll: coll, found: false };
  for stmt in stmts {
    a = astwalk.fold_stmt_nodes(stmt, a, rescope_at_stmt, rescope_at_expr, astwalk.descend_all);
  }
  return a.found;
}

function struct_record_match(m: ast.StmtMatch, s: Scope): boolean {
  let head = parser.struct_record_head(m);
  if (head.len() == 0) {
    return false;
  }
  if let typeinfo.TypeStruct(st) = check_expr(m.scrutinee, s) {
    let Some(sig) = s.lookup_struct(st.name) else {
      return false;
    };
    return sig.name == st.name && sig.enum_owner.len() == 0 && head == st.name;
  }
  return false;
}

function struct_record_value_body(lm: ast.ExprLambda, s: Scope): ast.Stmt[] {
  if (lm.origin != parser.ORIGIN_MATCH_EXPR) {
    return lm.body;
  }
  if (lm.body.len() == 1) {
    if let Some(m) = parser.struct_record_source(lm.body[0]) {
      if (struct_record_match(m, s)) {
        return parser.struct_record_value_body(m, lm.ret_type);
      }
    }
  }
  let value = vb_local_name(lm.body);
  if (value.len() > 0) {
    if let Some(m) = parser.struct_record_source(lm.body[1]) {
      if (struct_record_match(m, s)) {
        return lm.body.with(1, parser.lower_struct_record_match(m, value));
      }
    }
  }
  return lm.body;
}

function pretype_needed_stmt(st: ast.Stmt, own found: boolean): boolean {
  if (found) {
    return true;
  }
  if let ast.StmtIf(f) = st {
    return f.sugar.origin == "" && f.sugar.tup.len() > 0;
  }
  return false;
}

function use_untyped(c: ast.ExprCall): boolean {
  if (c.args.len() == 0) {
    return false;
  }
  if let ast.ExprLambda(lm) = c.args[c.args.len() - 1] {
    if (lm.origin != parser.ORIGIN_USE || lm.params.len() == 0) {
      return false;
    }
    return lm.ret_type.len() == 0 || lm.use_infer && lm.params[0].type_name.len() == 0;
  }
  return false;
}

function use_callback_type(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if let ast.ExprIdent(id) = c.callee {
    let last = t_unknown("use: callee has no signature");
    if let typeinfo.TypeFunc(ft) = s.lookup(id.name) {
      if (ft.param_types.len() > 0) {
        last = ft.param_types[ft.param_types.len() - 1];
      }
    } else {
      if let Some(sig) = s.lookup_sig(id.name) {
        if (sig.param_types.len() > 0) {
          last = use_callback_slot(sig, c, s);
        }
      }
    }
    if let typeinfo.TypeFunc(cb) = last {
      if (cb.params_known && cb.param_types.len() > 0) {
        return last;
      }
    }
  }
  return t_unknown("use: callee has no signature");
}

function use_binding_type(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if let typeinfo.TypeFunc(cb) = use_callback_type(c, s) {
    return cb.param_types[0];
  }
  return t_unknown("use: callee has no signature");
}

function use_callback_slot(sig: FuncSig, c: ast.ExprCall, s: Scope): typeinfo.Type {
  let at = sig.param_types.len() - 1;
  if (sig.all_type_params.len() == 0 || at >= sig.param_type_names.len()) {
    return sig.param_types[at];
  }
  let written: ast.Expr[] = [];
  let i = 0;
  while (i + 1 < c.args.len()) {
    written = written.append(c.args[i]);
    i += 1;
  }
  let (bn, bt) = arg_bindings(sig, ast.ExprCall { ...c, args: written }, s);
  let slot = sig_param_ref(sig, at);
  let f = parser.ref_ungroup(slot);
  if (!parser.ref_is_fn_value(slot) || f.args.len() < 2) {
    return sig.param_types[at];
  }
  let unbound: string[] = [];
  for tp in sig.all_type_params {
    if (!util.has_str(bn, tp)) {
      unbound = unbound.append(tp);
    }
  }
  if (type_ref_names_any(f.args[0], unbound)) {
    return t_unknown("use: callback parameter names an unbound type parameter");
  }
  let whole = type_from_ref_subst(slot, bn, bt, s.type_names());
  if (type_ref_names_any(parser.ref_fn_result(slot), unbound)) {
    if let typeinfo.TypeFunc(cb) = whole {
      return typeinfo.TypeFunc { ...cb, ret_type: t_unknown("use: callback result names an unbound type parameter") };
    }
  }
  return whole;
}

function use_typed(c: ast.ExprCall, s: Scope): ast.ExprCall {
  let cbt = use_callback_type(c, s);
  let t = t_unknown("use: callee has no signature");
  if let typeinfo.TypeFunc(cb) = cbt {
    t = cb.param_types[0];
  }
  let at = c.args.len() - 1;
  if let ast.ExprLambda(lm) = c.args[at] {
    let p = lm.params[0];
    if (p.type_name.len() == 0) {
      p = decltypes.fn_param_from_type(p.name, t);
    }
    if (p.type_name.len() == 0) {
      let sp = typeinfo.spelling(t);
      if (sp.len() == 0) {
        return c;
      }
      p = ast.ParamDecl { ...lm.params[0], type_name: sp };
    }
    let nparams: ast.ParamDecl[] = [p];
    let i = 1;
    while (i < lm.params.len()) {
      nparams = nparams.append(lm.params[i]);
      i += 1;
    }
    let nargs: ast.Expr[] = [];
    let j = 0;
    while (j < at) {
      nargs = nargs.append(c.args[j]);
      j += 1;
    }
    nargs = nargs.append(use_ret_typed(ast.ExprLambda { ...lm, params: nparams }, cbt));
    return ast.ExprCall { ...c, args: nargs };
  }
  return c;
}

function use_ret_typed(lm: ast.ExprLambda, cbt: typeinfo.Type): ast.ExprLambda {
  if (lm.ret_type.len() > 0) {
    return lm;
  }
  if let typeinfo.TypeFunc(cb) = cbt {
    if (is_unknown(cb.ret_type)) {
      return lm;
    }
    let d = decltypes.param_from_type("", cb.ret_type);
    if (d.type_name.len() == 0) {
      return lm;
    }
    return ast.ExprLambda { ...lm, ret_type: d.type_name, ret_fn_ret: d.fn_ret, ret_fn_param_types: d.fn_param_types };
  }
  return lm;
}

pub function pretype_module(mod: parser.Module): parser.Module {
  let coll = colliding_variant_names(mod);
  if (needs_pretype_or_rescope(mod.top_stmts, coll)) {
    return pretype_module_in(mod, module_env(mod), whole_focus(mod));
  }
  for fd in mod.funcs {
    if (needs_pretype_or_rescope(fd.body, coll)) {
      return pretype_module_in(mod, module_env(mod), whole_focus(mod));
    }
  }
  return mod;
}

function pretype_module_in(mod: parser.Module, env: ModuleEnv, focus: Focus): parser.Module {
  let coll = colliding_variant_names(mod);
  let top_hit = focus.top && needs_pretype_or_rescope(mod.top_stmts, coll);
  let hits: boolean[] = [];
  let any = top_hit;
  let k = 0;
  for fn in mod.funcs {
    let hit = focus.funcs[k] && needs_pretype_or_rescope(fn.body, coll);
    k += 1;
    hits = hits.append(hit);
    if (hit) {
      any = true;
    }
  }
  if (!any) {
    return mod;
  }
  let nfuncs: parser.FuncDecl[] = [];
  let i = 0;
  while (i < mod.funcs.len()) {
    let func = mod.funcs[i];
    if (hits[i]) {
      let fs = build_func_scope(func, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
      nfuncs = nfuncs.append(parser.FuncDecl { ...func, body: pretype_stmts(func.body, fs) });
    } else {
      nfuncs = nfuncs.append(func);
    }
    i += 1;
  }
  let ntop = mod.top_stmts;
  if (top_hit) {
    ntop = pretype_stmts(mod.top_stmts, new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs));
  }
  return parser.Module { ...mod, funcs: nfuncs, top_stmts: ntop };
}

// qualify_variants_in rewrites a bare variant that two visible enums declare to
// `E.A` where the type its position expects names one of them (#12701).
function qualify_variants_in(mod: parser.Module, env: ModuleEnv, focus: Focus): parser.Module {
  let coll = shared_variant_names(mod);
  if (coll.names.len() == 0) {
    return mod;
  }
  let nfuncs: parser.FuncDecl[] = [];
  for i in 0..mod.funcs.len() {
    let func = mod.funcs[i];
    if (focus.funcs[i] && names_colliding_variant(func.body, coll)) {
      let fs = build_func_scope(func, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
      nfuncs = nfuncs.append(parser.FuncDecl { ...func, body: qualify_stmts(func.body, fs, coll) });
    } else {
      nfuncs = nfuncs.append(func);
    }
  }
  let ntop = mod.top_stmts;
  if (focus.top && names_colliding_variant(mod.top_stmts, coll)) {
    ntop = qualify_stmts(mod.top_stmts, new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs), coll);
  }
  return parser.Module { ...mod, funcs: nfuncs, top_stmts: ntop };
}

// shared_variant_names is the bare variant names two enums declare.
function shared_variant_names(mod: parser.Module): util.NameIndex {
  let no_names: string[] = [];
  let seen = util.name_index(no_names);
  let out = util.name_index(no_names);
  for ed in mod.enums {
    for vn in ed.variant_names {
      let b = variant_bare_name(vn);
      if (!seen.has(b) && parser.builtin_enum_of(b).len() == 0) {
        seen = seen.added(b);
      } else if (!out.has(b)) {
        out = out.added(b);
      }
    }
  }
  return out;
}

struct SharedScan { coll: util.NameIndex, found: boolean }

function shared_scan_at(e: ast.Expr, own a: SharedScan): SharedScan {
  if let ast.ExprIdent(id) = e {
    if (!a.found && a.coll.has(variant_bare_name(id.name))) {
      return SharedScan { ...a, found: true };
    }
  }
  return a;
}

function names_colliding_variant(stmts: ast.Stmt[], coll: util.NameIndex): boolean {
  let a = SharedScan { coll: coll, found: false };
  for st in stmts {
    a = astwalk.fold_stmt(st, a, shared_scan_at);
  }
  return a.found;
}

function qualify_stmts(stmts: ast.Stmt[], s: Scope, coll: util.NameIndex): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let cur = s;
  for stmt in stmts {
    let q = qualify_stmt(stmt, cur, coll);
    out = out.append(q);
    cur = bind_stmt(q, cur);
  }
  return out;
}

// var_dest_type is the type a `let` annotation expects of its initialiser.
function var_dest_type(v: ast.StmtVar, s: Scope): typeinfo.Type {
  if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name) && !vb_placeholder_decl(v)) {
    return var_declared_type(v, s);
  }
  return t_unknown("no expected type");
}

function assign_dest_type(a: ast.StmtAssign, s: Scope): typeinfo.Type {
  if (s.defines(a.target)) {
    return s.lookup(a.target);
  }
  return t_unknown("no expected type");
}

function qualify_stmt(st: ast.Stmt, s: Scope, coll: util.NameIndex): ast.Stmt {
  let none = t_unknown("no expected type");
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar { ...v, init: qualify_expr(v.init, var_dest_type(v, s), s, coll) };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: qualify_expr(r.value, s.ret_type, s, coll) };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: qualify_expr(x.value, none, s, coll) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: qualify_expr(a.value, assign_dest_type(a, s), s, coll) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: qualify_expr(f.cond, none, s, coll), then_body: qualify_stmts(f.then_body, s, coll), else_body: qualify_stmts(f.else_body, s, coll) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, cond: qualify_expr(w.cond, none, s, coll), body: qualify_stmts(w.body, s, coll) };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { ...fr, iter: qualify_expr(fr.iter, none, s, coll), body: qualify_stmts(fr.body, for_body_scope(fr, s), coll) };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      for arm in m.arms {
        arms = arms.append(ast.MatchArm { ...arm, body: qualify_stmts(arm.body, s, coll) });
      }
      return ast.StmtMatch { ...m, scrutinee: qualify_expr(m.scrutinee, none, s, coll), arms: arms };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: qualify_stmt(d.action, s, coll) };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function expr_names_shared(e: ast.Expr, coll: util.NameIndex): boolean {
  return astwalk.fold_expr(e, SharedScan { coll: coll, found: false }, shared_scan_at).found;
}

struct QualifyAcc { want: typeinfo.Type, s: Scope, coll: util.NameIndex }

function qualify_expr(e: ast.Expr, want: typeinfo.Type, s: Scope, coll: util.NameIndex): ast.Expr {
  if (!expr_names_shared(e, coll)) {
    return e;
  }
  let (out, _, _) = astwalk.map_expr_where(e, QualifyAcc { want: want, s: s, coll: coll }, qualify_at_stmt, qualify_at, astwalk.every_expr);
  return out;
}

function qualify_at_stmt(st: ast.Stmt, q: QualifyAcc): (ast.Stmt, QualifyAcc, boolean) {
  return (st, q, false);
}

// qualify_at rewrites one node for the type its position expects; the
// nodes below it expect nothing unless the node passes a type down itself.
function qualify_at(n: ast.Expr, q: QualifyAcc): (ast.Expr, QualifyAcc, boolean) {
  let none = t_unknown("no expected type");
  let child = QualifyAcc { ...q, want: none };
  let s = q.s;
  let coll = q.coll;
  match (n) {
    ast.ExprIdent(id) => {
      return (qualified_variant_ref(id, q.want, s), child, true);
    },
    ast.ExprCall(c) => {
      return (qualify_call(c, q.want, s, coll), child, true);
    },
    ast.ExprStructLit(sl) => {
      return (qualify_struct_lit(sl, q.want, s, coll), child, true);
    },
    ast.ExprArray(a) => {
      let elem = none;
      if let typeinfo.TypeArray(arr) = q.want {
        elem = arr.elem;
      }
      let elems: ast.Expr[] = [];
      for x in a.elements {
        elems = elems.append(qualify_expr(x, elem, s, coll));
      }
      return (ast.ExprArray { ...a, elements: elems }, child, true);
    },
    ast.ExprTuple(t) => {
      let slots: typeinfo.Type[] = [];
      if let typeinfo.TypeTuple(tt) = q.want {
        slots = tt.elements;
      }
      let elems: ast.Expr[] = [];
      for k in 0..t.elements.len() {
        elems = elems.append(qualify_expr(t.elements[k], dest_slot(slots, k), s, coll));
      }
      return (ast.ExprTuple { ...t, elements: elems }, child, true);
    },
    ast.ExprLambda(lm) => {
      return (ast.ExprLambda { ...lm, body: qualify_stmts(lm.body, lambda_body_scope(lm, s), coll) }, child, true);
    },
    ast.ExprFieldAccess(fa) => {
      return (n, child, qual_enum_name(fa.obj, s).len() > 0);
    },
    ast.ExprBinary(b) => {
      if (b.op != "==" && b.op != "!=") {
        return (n, child, false);
      }
      let left = qualify_expr(b.left, none, s, coll);
      return (ast.ExprBinary { ...b, left: left, right: qualify_expr(b.right, check_expr(left, s), s, coll) }, child, true);
    },
    _ => {
      return (n, child, false);
    }
  }
}

function dest_slot(slots: typeinfo.Type[], k: i32): typeinfo.Type {
  if (k < slots.len()) {
    return slots[k];
  }
  return t_unknown("no expected type");
}

// dest_variant is the member of the enum `want` names that the bare variant
// `name` stands for, when two visible enums declare `name`; or "".
function dest_variant(name: string, want: typeinfo.Type, s: Scope): string {
  let typeinfo.TypeUnion(du) = want else {
    return "";
  };
  if (s.known(name) || s.has_sig(name) || !s.variant_ambiguous(name)) {
    return "";
  }
  if (parser.builtin_enum_of(name) == du.name) {
    return name;
  }
  let Some(u) = s.lookup_union(du.name) else {
    return "";
  };
  if (!u.is_enum) {
    return "";
  }
  let bare = variant_bare_name(name);
  for v in u.variants {
    if (v == name || variant_bare_name(v) == bare) {
      return v;
    }
  }
  return "";
}

function qualified_variant_ref(id: ast.ExprIdent, want: typeinfo.Type, s: Scope): ast.Expr {
  let member = dest_variant(id.name, want, s);
  let typeinfo.TypeUnion(du) = want else {
    return ast.ExprIdent { ...id };
  };
  if (member.len() == 0) {
    return ast.ExprIdent { ...id };
  }
  return ast.ExprFieldAccess { obj: ast.ExprIdent { ...id, name: du.name, ty: "" }, field: member, line: id.line, col: id.col, ty: "", const_read: false };
}

function qualify_call(c: ast.ExprCall, want: typeinfo.Type, s: Scope, coll: util.NameIndex): ast.Expr {
  let none = t_unknown("no expected type");
  if (parser.is_value_block(c)) {
    if let ast.ExprLambda(lm) = c.callee {
      let bs = lambda_body_scope(lm, s);
      if (!is_unknown(want)) {
        bs = bs.with_block_ret(want);
      }
      return ast.ExprCall { ...c, callee: ast.ExprLambda { ...lm, body: qualify_stmts(lm.body, bs, coll) } };
    }
  }
  let callee = c.callee;
  let dests: typeinfo.Type[] = [];
  match (c.callee) {
    ast.ExprIdent(id) => {
      let member = dest_variant(id.name, want, s);
      if (member.len() > 0) {
        callee = qualified_variant_ref(id, want, s);
        dests = member_payload_dests(member, want, c, s);
      } else if (s.ident_binding(id) < 0) {
        dests = match (s.lookup_sig(id.name)) { Some(sig) => sig.param_types, None => variant_payload_dests(c, want, s, []) };
      }
    },
    ast.ExprFieldAccess(fa) => {
      callee = qualify_expr(c.callee, none, s, coll);
      if (args_name_shared(c.args, coll) && qual_enum_name(fa.obj, s).len() == 0) {
        if let Some(ms) = s.lookup_method(fa.field, cmp_method_receiver(check_expr(fa.obj, s))) {
          dests = ms.param_types;
        }
      }
    },
    _ => {
      callee = qualify_expr(c.callee, none, s, coll);
    }
  }
  let args: ast.Expr[] = [];
  for k in 0..c.args.len() {
    args = args.append(qualify_expr(c.args[k], dest_slot(dests, k), s, coll));
  }
  return ast.ExprCall { ...c, callee: callee, args: args };
}

function args_name_shared(args: ast.Expr[], coll: util.NameIndex): boolean {
  for a in args {
    if (expr_names_shared(a, coll)) {
      return true;
    }
  }
  return false;
}

// member_payload_dests is the payload types of the variant `member` of the
// enum `want` names, with the enum's type arguments filled in.
function member_payload_dests(member: string, want: typeinfo.Type, c: ast.ExprCall, s: Scope): typeinfo.Type[] {
  let typeinfo.TypeUnion(du) = want else {
    return [];
  };
  if (parser.builtin_enum_of(member) == du.name) {
    return variant_payload_dests(c, want, s, []);
  }
  let Some(u) = s.lookup_union(du.name) else {
    return [];
  };
  let Some(vs) = s.lookup_owned_struct(member, u.name) else {
    return [];
  };
  if (u.type_params.len() == 0) {
    return vs.field_types;
  }
  if (u.type_params.len() != du.args.len()) {
    return [];
  }
  let out: typeinfo.Type[] = [];
  for n in vs.field_type_names {
    out = out.append(type_from_ref_subst(parser.parse_type_ref(n), u.type_params, du.args, s.type_names()));
  }
  return out;
}

function qualify_struct_lit(sl: ast.ExprStructLit, want: typeinfo.Type, s: Scope, coll: util.NameIndex): ast.Expr {
  let none = t_unknown("no expected type");
  let found = s.lookup_struct(sl.type_name);
  let args: typeinfo.Type[] = [];
  if let typeinfo.TypeStruct(ws) = want {
    args = ws.args;
  }
  let values: ast.Expr[] = [];
  for k in 0..sl.field_values.len() {
    let fdest = none;
    if let Some(fsig) = found {
      if (k < sl.field_names.len() && field_index(fsig, sl.field_names[k]) >= 0) {
        fdest = lit_field_type(fsig, field_index(fsig, sl.field_names[k]), args, s);
      }
    }
    values = values.append(qualify_expr(sl.field_values[k], fdest, s, coll));
  }
  return ast.ExprStructLit { ...sl, field_values: values, base: qualify_expr(sl.base, none, s, coll) };
}

struct LitInfer { parent: i32[], width: typeinfo.Type[], keys: string[], cargs: string[], ctags: string[], pend: ast.Expr[], pend_id: i32[], pend_scope: Scope[], skeys: string[], snames: string[], sfirst: i32[], sargs: string[], sids: i32[], wkeys: string[], wtags: string[], eargs: string[], eids: i32[], tkeys: string[], ttypes: typeinfo.Type[], pargs: string[], ptypes: typeinfo.Type[], okeys: string[], otypes: typeinfo.Type[], ofills: typeinfo.Type[] }

struct LitRewrite { keys: string[], tags: string[], cargs: string[], ctags: string[], pargs: string[], ptypes: typeinfo.Type[] }

const LIT_MARK: string = "literal local #";

const LIT_WIDE: i32 = 0;

function lit_marker(k: i32): typeinfo.Type {
  return t_unknown(LIT_MARK + util.i32_to_string(k));
}

function lit_id(t: typeinfo.Type): i32 {
  if let typeinfo.TypeUnknown(u) = t {
    let n = LIT_MARK.len();
    if (u.reason.len() <= n || slice_unchecked(u.reason, 0, n) != LIT_MARK) {
      return -1;
    }
    let k = 0;
    let i = n;
    while (i < u.reason.len()) {
      k = k * 10 + u.reason[i] as i32 - 48;
      i += 1;
    }
    return k;
  }
  return -1;
}

const LIT_STRUCT_MARK: string = "literal struct #";

function lit_struct_marker(name: string, ids: i32[]): typeinfo.Type {
  let spelled = LIT_STRUCT_MARK + name + "|";
  for i in 0..ids.len() {
    if (i > 0) {
      spelled += ",";
    }
    spelled += util.i32_to_string(ids[i]);
  }
  return t_unknown(spelled);
}

function lit_struct_of(t: typeinfo.Type): (string, i32[]) {
  let none: i32[] = [];
  if let typeinfo.TypeUnknown(u) = t {
    let n = LIT_STRUCT_MARK.len();
    if (u.reason.len() <= n || slice_unchecked(u.reason, 0, n) != LIT_STRUCT_MARK) {
      return ("", none);
    }
    let bar = util.index_of_sub(u.reason, "|");
    let ids: i32[] = [];
    let k = 0;
    let neg = false;
    let i = bar + 1;
    while (i <= u.reason.len()) {
      if (i == u.reason.len() || u.reason[i] as i32 == 44) {
        if (neg) {
          k = -k;
        }
        ids = ids.append(k);
        k = 0;
        neg = false;
      } else if (u.reason[i] as i32 == 45) {
        neg = true;
      } else {
        k = k * 10 + u.reason[i] as i32 - 48;
      }
      i += 1;
    }
    return (slice_unchecked(u.reason, n, bar) + "", ids);
  }
  return ("", none);
}

function lit_struct_read(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprIdent(id) = e {
    let (name, ids) = lit_struct_of(s.lookup(id.name));
    return name.len() > 0;
  }
  return false;
}

// lit_marked_read is true for a read of a local whose type holds an integer
// literal, or of one of its elements, such as `bytes`, `bytes[0]` or `t.0`
// after `let bytes = [1, 2];` or `let t = (1, 2);`.
function lit_marked_read(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprIdent(id) = e {
    return lit_marked(s.lookup(id.name));
  }
  if let ast.ExprIndex(ix) = e {
    return lit_marked_read(ix.array, s);
  }
  if let ast.ExprFieldAccess(fa) = e {
    return util.is_all_digits(fa.field) && lit_marked_read(fa.obj, s);
  }
  return false;
}

function lit_marked(t: typeinfo.Type): boolean {
  if (lit_id(t) >= 0) {
    return true;
  }
  match (t) {
    typeinfo.TypeArray(a) => {
      return lit_marked(a.elem);
    },
    typeinfo.TypeTuple(tt) => {
      for el in tt.elements {
        if (lit_marked(el)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
}

// An open enum local is an unannotated local whose type holds a generic
// enum with no type arguments, such as `let e = Empty;`. Its first use at a
// known type writes that type on the local.
const LIT_OPEN_MARK: string = "open enum local #";

// open_call_type is the type of a generic call that leaves a type parameter
// unbound, such as `ordmap.new()`, with each unbound parameter open. It is
// false when the call binds each parameter.
function open_call_type(e: ast.Expr, s: Scope): (typeinfo.Type, boolean) {
  let none = t_unknown("not an open call");
  let ast.ExprCall(c) = e else {
    return (none, false);
  };
  let ast.ExprIdent(id) = c.callee else {
    return (none, false);
  };
  if (c.type_args.len() > 0 || s.defines(id.name)) {
    return (none, false);
  }
  let Some(sig) = s.lookup_sig(id.name) else {
    return (none, false);
  };
  if (sig.all_type_params.len() == 0 || c.args.len() != sig.param_types.len() || sig.ret_type_name.len() == 0) {
    return (none, false);
  }
  let (bn, bt) = call_type_bindings(sig, c, s);
  let open = false;
  for tp in sig.all_type_params {
    if (util.index_of_str(bn, tp) < 0) {
      bn = bn.append(tp);
      bt = bt.append(t_unknown("unbound " + tp));
      open = true;
    }
  }
  if (!open) {
    return (none, false);
  }
  return (type_from_ref_subst(sig_ret_ref(sig), bn, bt, s.type_names()), true);
}

function lit_open_marker(k: i32): typeinfo.Type {
  return t_unknown(LIT_OPEN_MARK + util.i32_to_string(k));
}

function lit_open_id(t: typeinfo.Type): i32 {
  let typeinfo.TypeUnknown(u) = t else {
    return -1;
  };
  let n = LIT_OPEN_MARK.len();
  if (u.reason.len() <= n || slice_unchecked(u.reason, 0, n) != LIT_OPEN_MARK) {
    return -1;
  }
  let k = 0;
  for i in n..u.reason.len() {
    k = k * 10 + u.reason[i] as i32 - 48;
  }
  return k;
}

function holds_open_enum(t: typeinfo.Type, s: Scope): boolean {
  match (t) {
    typeinfo.TypeUnion(u) => {
      if (bare_union(u)) {
        return open_union_arity(s, u.name) > 0;
      }
      return any_open_enum(u.args, s);
    },
    typeinfo.TypeStruct(st) => {
      return any_open_enum(st.args, s);
    },
    typeinfo.TypeMap(_) => {
      return bare_map(t);
    },
    typeinfo.TypeArray(a) => {
      return holds_open_enum(a.elem, s);
    },
    typeinfo.TypeTuple(tt) => {
      return any_open_enum(tt.elements, s);
    },
    _ => {
      return false;
    }
  }
}

function open_union_arity(s: Scope, name: string): i32 {
  if (name == "Option") {
    return 1;
  }
  if (name == "Result") {
    return 2;
  }
  return union_type_params(s, name).len();
}

// bare_union is a union named without its arguments: none, or each one never.
function bare_union(u: typeinfo.TypeUnion): boolean {
  for a in u.args {
    if let typeinfo.TypeNever(_) = a {
      continue;
    }
    return false;
  }
  return true;
}

function any_open_enum(ts: typeinfo.Type[], s: Scope): boolean {
  for t in ts {
    if (unbound_enum_argument(t) || holds_open_enum(t, s)) {
      return true;
    }
  }
  return false;
}

function all_known(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (!known_type(t)) {
      return false;
    }
  }
  return true;
}

function fill_open_args(have: typeinfo.Type[], want: typeinfo.Type[]): (typeinfo.Type[], boolean) {
  let out: typeinfo.Type[] = [];
  if (have.len() != want.len()) {
    return (out, false);
  }
  for i in 0..have.len() {
    if (unbound_enum_argument(have[i])) {
      if (!known_type(want[i])) {
        return (out, false);
      }
      out = out.append(want[i]);
      continue;
    }
    let (t, ok) = fill_open_enum(have[i], want[i]);
    if (!ok) {
      return (out, false);
    }
    out = out.append(t);
  }
  return (out, true);
}

// fill_open_enum gives each enum without arguments in `have` the arguments
// that `want` has at the same place. It is false when the shapes differ or
// `want` does not know the arguments.
function fill_open_enum(have: typeinfo.Type, want: typeinfo.Type): (typeinfo.Type, boolean) {
  if (unbound_enum_argument(have)) {
    return (want, known_type(want));
  }
  match (have) {
    typeinfo.TypeUnion(h) => {
      return fill_open_union(h, want);
    },
    typeinfo.TypeStruct(h) => {
      let typeinfo.TypeStruct(w) = want else {
        return (have, false);
      };
      let (args, ok) = fill_open_args(h.args, w.args);
      return (typeinfo.TypeStruct { name: h.name, args: args }, ok && w.name == h.name);
    },
    typeinfo.TypeArray(h) => {
      let typeinfo.TypeArray(w) = want else {
        return (have, false);
      };
      let (elem, ok) = fill_open_enum(h.elem, w.elem);
      return (typeinfo.TypeArray { ...h, elem: elem }, ok);
    },
    typeinfo.TypeTuple(h) => {
      let typeinfo.TypeTuple(w) = want else {
        return (have, false);
      };
      let (elems, ok) = fill_open_args(h.elements, w.elements);
      return (t_tuple(elems), ok);
    },
    typeinfo.TypeMap(h) => {
      return fill_open_map(h, want);
    },
    _ => {
      return (have, true);
    }
  }
}

function fill_open_map(h: typeinfo.TypeMap, want: typeinfo.Type): (typeinfo.Type, boolean) {
  let typeinfo.TypeMap(w) = want else {
    return (want, false);
  };
  let key = if (map_new_column(h.key)) { w.key } else { h.key };
  let value = if (map_new_column(h.value)) { w.value } else { h.value };
  return (t_map(key, value), known_type(key) && known_type(value));
}

function fill_open_union(h: typeinfo.TypeUnion, want: typeinfo.Type): (typeinfo.Type, boolean) {
  let typeinfo.TypeUnion(w) = want else {
    return (want, false);
  };
  if (w.name != h.name) {
    return (want, false);
  }
  if (bare_union(h)) {
    return (want, w.args.len() > 0 && known_type(want));
  }
  let (args, ok) = fill_open_args(h.args, w.args);
  return (typeinfo.TypeUnion { name: h.name, args: args }, ok);
}

function known_type(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return false;
    },
    typeinfo.TypeUnion(u) => {
      return all_known(u.args);
    },
    typeinfo.TypeStruct(st) => {
      return all_known(st.args);
    },
    typeinfo.TypeArray(a) => {
      return known_type(a.elem);
    },
    typeinfo.TypeMap(m) => {
      return known_type(m.key) && known_type(m.value);
    },
    typeinfo.TypeTuple(tt) => {
      return all_known(tt.elements);
    },
    _ => {
      return true;
    }
  }
}

// open_spelling writes a filled type as an annotation the checker reads back,
// with a type parameter under its erased name.
function open_spelling(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeErased(e) => {
      return e.name;
    },
    typeinfo.TypeUnion(u) => {
      return open_nominal(u.name, u.args);
    },
    typeinfo.TypeStruct(st) => {
      return open_nominal(st.name, st.args);
    },
    typeinfo.TypeArray(a) => {
      let elem = open_spelling(a.elem);
      if (elem.len() == 0) {
        return "";
      }
      if (a.view) {
        return "[" + elem + "]";
      }
      return elem + "[]";
    },
    typeinfo.TypeTuple(tt) => {
      let parts = open_spelling_list(tt.elements);
      if (parts.len() == 0) {
        return "";
      }
      return "(" + parts + ")";
    },
    typeinfo.TypeMap(m) => {
      return open_nominal("Map", [m.key, m.value]);
    },
    _ => {
      return typeinfo.spelling(t);
    }
  }
}

function open_nominal(name: string, args: typeinfo.Type[]): string {
  if (args.len() == 0) {
    return name;
  }
  let parts = open_spelling_list(args);
  if (parts.len() == 0) {
    return "";
  }
  return name + "[" + parts + "]";
}

function open_spelling_list(ts: typeinfo.Type[]): string {
  let out = "";
  for i in 0..ts.len() {
    let one = open_spelling(ts[i]);
    if (one.len() == 0) {
      return "";
    }
    if (i > 0) {
      out += ", ";
    }
    out += one;
  }
  return out;
}

function unknown_reason(t: typeinfo.Type): string {
  if let typeinfo.TypeUnknown(u) = t {
    return u.reason;
  }
  return "";
}

function lit_open_fill(st: LitInfer, k: i32, want: typeinfo.Type): LitInfer {
  if (!is_unknown(st.ofills[k])) {
    return st;
  }
  let (filled, ok) = fill_open_enum(st.otypes[k], want);
  if (!ok) {
    return st;
  }
  return LitInfer { ...st, ofills: st.ofills.with(k, filled) };
}

function lit_open_read(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprIdent(id) = e {
    return lit_open_id(s.lookup(id.name)) >= 0;
  }
  return false;
}

function lit_enum_read(e: ast.Expr, s: Scope): boolean {
  if let typeinfo.TypeUnion(u) = check_expr(e, s) {
    for arg in u.args {
      if (lit_id(arg) >= 0) {
        return true;
      }
    }
  }
  return false;
}

function lit_struct_field_class(fa: ast.ExprFieldAccess, s: Scope): i32 {
  if let ast.ExprIdent(oid) = fa.obj {
    let (name, ids) = lit_struct_of(s.lookup(oid.name));
    if (name.len() == 0) {
      return -1;
    }
    let Some(sig) = s.lookup_struct(name) else {
      return -1;
    };
    let fi = field_index(sig, fa.field);
    if (fi < 0 || fi >= sig.field_type_names.len()) {
      return -1;
    }
    let ti = util.index_of_str(sig.type_params, sig.field_type_names[fi]);
    if (ti >= 0 && ti < ids.len()) {
      return ids[ti];
    }
  }
  return -1;
}

function lit_tree(e: ast.Expr, s: Scope, ids: i32[]): (boolean, i32[]) {
  match (e) {
    ast.ExprNumber(_) => {
      if (unsettled_int_literal(e)) {
        return (true, ids);
      }
      if (int_literal_tree(e)) {
        return (true, ids.append(LIT_WIDE));
      }
      return (false, ids);
    },
    ast.ExprIdent(id) => {
      let k = lit_id(s.lookup(id.name));
      if (k < 0) {
        return (false, ids);
      }
      return (true, ids.append(k));
    },
    ast.ExprFieldAccess(fa) => {
      let fk = lit_struct_field_class(fa, s);
      if (fk < 0) {
        return (false, ids);
      }
      return (true, ids.append(fk));
    },
    ast.ExprUnary(u) => {
      if (u.op == "-" || u.op == "+") {
        if (unsettled_int_literal(e)) {
          return (true, ids);
        }
        return lit_tree(u.operand, s, ids);
      }
      return (false, ids);
    },
    ast.ExprBinary(b) => {
      if (!int_operand_op(b.op)) {
        return (false, ids);
      }
      let (l, lids) = lit_tree(b.left, s, ids);
      let (r, rids) = lit_tree(b.right, s, lids);
      return (l && r, rids);
    },
    _ => {
      return (false, ids);
    }
  }
  return (false, ids);
}

// The literal ids of a `let` or assignment value. A value `if`, `match` or
// block seeds when each arm that yields gives a literal tree. The walk of its
// arms is kept only when it seeds.
function lit_seed(e: ast.Expr, s: Scope, st: LitInfer): (boolean, i32[], LitInfer) {
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lm) = c.callee {
      let branches = lm.body.len() == 1 && (lm.origin == parser.ORIGIN_IF_EXPR || lm.origin == parser.ORIGIN_MATCH_EXPR);
      if (c.args.len() > 0 || lm.params.len() > 0 || !branches && lm.origin != parser.ORIGIN_BLOCK) {
        return (false, [], st);
      }
      let (n, ids, out) = lit_arms(lm.body, lambda_body_scope(lm, s), [], st);
      if (n > 0) {
        return (true, ids, out);
      }
      return (false, [], st);
    }
  }
  let (seed, ids) = lit_tree(e, s, []);
  return (seed, ids, st);
}

// The literal arms of a branch body: 0 when it leaves, -1 when an arm yields
// something else.
function lit_arms(body: ast.Stmt[], s: Scope, ids: i32[], st: LitInfer): (i32, i32[], LitInfer) {
  if (!mx_branch_yields(body)) {
    return (0, ids, lit_stmts(body, s, st));
  }
  let cur = s;
  let out = st;
  let last = body.len() - 1;
  for i in 0..last {
    let (ns, nst) = lit_stmt(body[i], cur, out);
    cur = ns;
    out = nst;
  }
  match (body[last]) {
    ast.StmtReturn(r) => {
      let (seed, rids, rst) = lit_seed(r.value, cur, out);
      if (seed) {
        return (1, util.append_all(ids, rids), rst);
      }
      return (0 - 1, ids, out);
    },
    ast.StmtIf(f) => {
      let (a, aids, tst) = lit_arms(f.then_body, cur, ids, lit_expr(f.cond, cur, out));
      let (b, bids, bst) = lit_arms(f.else_body, cur, aids, tst);
      return (unsettled_arm_sum(a, b), bids, bst);
    },
    ast.StmtMatch(m) => {
      return lit_match_arms(m, cur, ids, out);
    },
    _ => {}
  }
  let (ls, lst) = lit_stmt(body[last], cur, out);
  return (0, ids, lst);
}

function lit_match_arms(m: ast.StmtMatch, s: Scope, ids: i32[], st: LitInfer): (i32, i32[], LitInfer) {
  let whole = check_expr(m.scrutinee, s);
  let out = lit_arg(m.scrutinee, s, st);
  let n = 0;
  let kids = ids;
  for arm in m.arms {
    let asc = annotate_arm_scope(arm, s, whole);
    if (arm.has_guard) {
      out = lit_expr(arm.guard, asc, out);
    }
    let (k, nids, nst) = lit_arms(arm.body, asc, kids, out);
    n = unsettled_arm_sum(n, k);
    kids = nids;
    out = nst;
  }
  return (n, kids, out);
}

function lit_find(st: LitInfer, k: i32): i32 {
  let r = k;
  while (st.parent[r] != r) {
    r = st.parent[r];
  }
  return r;
}

function lit_new(st: LitInfer, key: string): LitInfer {
  return LitInfer { ...st, parent: st.parent.append(st.parent.len()), width: st.width.append(t_unknown("open")), keys: st.keys.append(key) };
}

function lit_fix(st: LitInfer, ids: i32[], w: typeinfo.Type): LitInfer {
  if (!is_integer(w) && !is_float(w)) {
    return st;
  }
  let out = st;
  for k in ids {
    let r = lit_find(out, k);
    if (is_unknown(out.width[r]) && is_integer(w) || is_poly_float(out.width[r]) && is_float(w)) {
      out = LitInfer { ...out, width: out.width.with(r, w) };
    }
  }
  return out;
}

function lit_link(st: LitInfer, ids: i32[]): LitInfer {
  let out = st;
  let i = 1;
  while (i < ids.len()) {
    let ra = lit_find(out, ids[0]);
    let rb = lit_find(out, ids[i]);
    let afixed = !is_unknown(out.width[ra]) && !is_poly_float(out.width[ra]);
    let bfixed = !is_unknown(out.width[rb]) && !is_poly_float(out.width[rb]);
    if (ra != rb && !(afixed && bfixed)) {
      if (bfixed) {
        out = LitInfer { ...out, parent: out.parent.with(ra, rb) };
      } else {
        out = LitInfer { ...out, parent: out.parent.with(rb, ra) };
        if (is_unknown(out.width[ra]) && is_poly_float(out.width[rb])) {
          out = LitInfer { ...out, width: out.width.with(ra, out.width[rb]) };
        }
      }
    }
    i += 1;
  }
  return out;
}

function lit_is_cmp(op: string): boolean {
  return op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=";
}

function lit_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprIdent(id) = e {
    st = lit_type_demand(s.lookup(id.name), want, st);
  }
  if let ast.ExprIndex(ix) = e {
    st = lit_index_demand(ix, want, s, st);
  }
  if let ast.ExprFieldAccess(fa) = e {
    st = lit_tuple_field_demand(fa, want, s, st);
  }
  if ((is_integer(want) || is_float(want)) && open_tree(e, s)) {
    return demand_open(e, want, s, st);
  }
  match (want) {
    typeinfo.TypeUnion(wu) => {
      return lit_union_demand(e, wu, s, st);
    },
    typeinfo.TypeStruct(ws) => {
      return lit_struct_demand(e, ws, s, st);
    },
    typeinfo.TypeTuple(wt) => {
      return lit_tuple_demand(e, wt, s, st);
    },
    typeinfo.TypeArray(wa) => {
      return lit_array_demand(e, wa, s, st);
    },
    _ => {}
  }
  return lit_other_demand(e, want, s, st);
}

// lit_index_demand gives a literal array local the type of a typed
// destination of one of its elements, such as `let m: u8 = z[0];`.
function lit_index_demand(ix: ast.ExprIndex, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let ast.ExprIdent(id) = ix.array else {
    return st;
  };
  let typeinfo.TypeArray(a) = s.lookup(id.name) else {
    return st;
  };
  let k = lit_id(a.elem);
  if (k < 0 || !settled_number(want)) {
    return st;
  }
  return lit_fix(st, [k], want);
}

// lit_tuple_field_demand gives a literal tuple local the type of a typed
// destination of one of its elements, such as `let y: u8 = t.0;`.
function lit_tuple_field_demand(fa: ast.ExprFieldAccess, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let ast.ExprIdent(id) = fa.obj else {
    return st;
  };
  let typeinfo.TypeTuple(t) = s.lookup(id.name) else {
    return st;
  };
  if (!util.is_all_digits(fa.field) || !settled_number(want)) {
    return st;
  }
  let i = digit_string_to_i32(fa.field);
  if (i < 0 || i >= t.elements.len()) {
    return st;
  }
  let k = lit_id(t.elements[i]);
  if (k < 0) {
    return st;
  }
  return lit_fix(st, [k], want);
}

// settled_number is true for an integer or float type that is not polymorphic.
function settled_number(t: typeinfo.Type): boolean {
  return is_integer(t) && !is_poly_int(t) || is_float(t) && !is_poly_float(t);
}

function lit_other_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      return lit_value_block(c, want, s, st);
    }
  }
  return lit_expr(e, s, gcall_demand(e, want, s, st));
}

function lit_union_demand(e: ast.Expr, wu: typeinfo.TypeUnion, s: Scope, st: LitInfer): LitInfer {
  if let Some(sig) = s.lookup_union(wu.name) {
    if (sig.instance != "") {
      return lit_demand(e, s.resolve_type(sig.instance), s, st);
    }
  }
  if let typeinfo.TypeUnion(have) = check_expr(e, s) {
    if (have.name == wu.name && have.args.len() == wu.args.len()) {
      let out = st;
      let j = 0;
      while (j < have.args.len()) {
        out = lit_type_demand(have.args[j], wu.args[j], out);
        j += 1;
      }
      return lit_other_demand(e, wu, s, out);
    }
  }
  return lit_other_demand(e, wu, s, st);
}

function lit_struct_demand(e: ast.Expr, ws: typeinfo.TypeStruct, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprIdent(sid) = e {
    let (name, ids) = lit_struct_of(s.lookup(sid.name));
    if (name == ws.name && ids.len() == ws.args.len()) {
      let outs = st;
      let j = 0;
      while (j < ids.len()) {
        if (ids[j] >= 0) {
          outs = lit_fix(outs, [ids[j]], ws.args[j]);
        }
        j += 1;
      }
      return outs;
    }
  }
  return lit_other_demand(e, ws, s, st);
}

function lit_tuple_demand(e: ast.Expr, wt: typeinfo.TypeTuple, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprTuple(tl) = e {
    if (tl.elements.len() == wt.elements.len()) {
      let out = st;
      let i = 0;
      while (i < tl.elements.len()) {
        out = lit_demand(tl.elements[i], wt.elements[i], s, out);
        i += 1;
      }
      return out;
    }
  }
  return lit_other_demand(e, wt, s, st);
}

function lit_array_demand(e: ast.Expr, wa: typeinfo.TypeArray, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprArray(arr) = e {
    let out = st;
    for el in arr.elements {
      if let typeinfo.TypeTuple(_) = wa.elem {
        if let ast.ExprCall(c) = el {
          if (parser.is_value_block(c)) {
            out = lit_expr(el, s, out);
            continue;
          }
        }
      }
      out = lit_demand(el, wa.elem, s, out);
    }
    return out;
  }
  return lit_other_demand(e, wa, s, st);
}

function lit_arg(e: ast.Expr, s: Scope, st: LitInfer): LitInfer {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed) {
    return lit_link(st, ids);
  }
  return lit_expr(e, s, st);
}

function lit_binary(b: ast.ExprBinary, s: Scope, st: LitInfer): LitInfer {
  if (!int_operand_op(b.op) && !lit_is_cmp(b.op)) {
    return lit_expr(b.right, s, lit_expr(b.left, s, st));
  }
  let (ls, lids) = lit_tree(b.left, s, []);
  let (rs, rids) = lit_tree(b.right, s, []);
  if (ls && rs) {
    let all = lids;
    for k in rids {
      all = all.append(k);
    }
    return lit_link(st, all);
  }
  let lo = open_tree(b.left, s);
  let ro = open_tree(b.right, s);
  if (ls) {
    return lit_expr(b.right, s, lit_beside(lids, b.right, ro, s, st));
  }
  if (rs) {
    return lit_expr(b.left, s, lit_beside(rids, b.left, lo, s, st));
  }
  return lit_expr(b.right, s, lit_expr(b.left, s, gcall_operands(b, lo, ro, s, st)));
}

function lit_beside(ids: i32[], other: ast.Expr, open: boolean, s: Scope, st: LitInfer): LitInfer {
  if (ids.len() == 0) {
    return st;
  }
  if (!open) {
    return lit_fix(st, ids, check_expr(other, s));
  }
  if (open_wide(other, s)) {
    return lit_fix(st, ids, t_i64());
  }
  let out = lit_link(st, ids);
  return LitInfer { ...out, pend: out.pend.append(other), pend_id: out.pend_id.append(ids[0]), pend_scope: out.pend_scope.append(s) };
}

function gcall_operands(b: ast.ExprBinary, lo: boolean, ro: boolean, s: Scope, st: LitInfer): LitInfer {
  if (lo && !ro) {
    return demand_open(b.left, check_expr(b.right, s), s, st);
  }
  if (ro && !lo) {
    return demand_open(b.right, check_expr(b.left, s), s, st);
  }
  if (lo && ro && (open_wide(b.left, s) || open_wide(b.right, s))) {
    return demand_open(b.right, t_i64(), s, demand_open(b.left, t_i64(), s, st));
  }
  return st;
}

function open_tree(e: ast.Expr, s: Scope): boolean {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed || gcall_open(e, s)) {
    return true;
  }
  if let ast.ExprUnary(u) = e {
    return (u.op == "-" || u.op == "+") && open_tree(u.operand, s);
  }
  if let ast.ExprBinary(b) = e {
    return int_operand_op(b.op) && open_tree(b.left, s) && open_tree(b.right, s);
  }
  return false;
}

function demand_open(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed) {
    return lit_fix(st, ids, want);
  }
  if let ast.ExprUnary(u) = e {
    return demand_open(u.operand, want, s, st);
  }
  if let ast.ExprBinary(b) = e {
    return demand_open(b.right, want, s, demand_open(b.left, want, s, st));
  }
  return lit_expr(e, s, gcall_demand(e, want, s, st));
}

function open_wide(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprUnary(u) = e {
    return open_wide(u.operand, s);
  }
  if let ast.ExprBinary(b) = e {
    return open_wide(b.left, s) || open_wide(b.right, s);
  }
  let (ce, tvs) = gcall_open_tvars(e, s);
  if let ast.ExprCall(c) = ce {
    let Some(sig) = gcall_sig(c, s) else {
      return false;
    };
    let k = 0;
    while (k < sig.param_type_names.len() && k < c.args.len()) {
      if (util.has_str(tvs, sig.param_type_names[k]) && wide_int_tree(c.args[k])) {
        return true;
      }
      k += 1;
    }
  }
  return false;
}

function wide_int_tree(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return int_literal_tree(e) && parser.literal_is_i64(n.text);
    },
    ast.ExprUnary(u) => {
      return wide_int_tree(u.operand);
    },
    ast.ExprBinary(b) => {
      return wide_int_tree(b.left) || wide_int_tree(b.right);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function gcall_of(e: ast.Expr, want: typeinfo.Type, s: Scope): (ast.Expr, typeinfo.Type, boolean) {
  if let ast.ExprFieldAccess(fa) = e {
    let (lifted, ok) = field_want_lift(check_expr(fa.obj, s), fa.field, want, s);
    if (!ok) {
      return (e, want, false);
    }
    return gcall_of(fa.obj, lifted, s);
  }
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      return (e, want, false);
    }
    let Some(sig) = gcall_sig(c, s) else {
      return (e, want, false);
    };
    return (e, want, sig.ret_type_name.len() > 0 && sig.typevars.len() > 0);
  }
  return (e, want, false);
}

function field_want_lift(ot: typeinfo.Type, field: string, want: typeinfo.Type, s: Scope): (typeinfo.Type, boolean) {
  if let typeinfo.TypeTuple(tt) = ot {
    let idx = digit_string_to_i32(field);
    if (idx < 0 || idx >= tt.elements.len()) {
      return (ot, false);
    }
    return (t_tuple(unknown_slots(tt.elements.len()).with(idx, want)), true);
  }
  if let typeinfo.TypeStruct(sn) = ot {
    let Some(sig) = s.lookup_struct(sn.name) else {
      return (ot, false);
    };
    let fi = field_index(sig, field);
    if (fi < 0 || fi >= sig.field_type_names.len()) {
      return (ot, false);
    }
    let ti = util.index_of_str(sig.type_params, sig.field_type_names[fi]);
    if (ti < 0) {
      return (ot, false);
    }
    return (t_struct_g(sn.name, unknown_slots(sig.type_params.len()).with(ti, want)), true);
  }
  return (ot, false);
}

function unknown_slots(n: i32): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  while (out.len() < n) {
    out = out.append(t_unknown("not read"));
  }
  return out;
}

function gcall_sig(c: ast.ExprCall, s: Scope): Option[FuncSig] {
  if let ast.ExprIdent(cid) = c.callee {
    return s.lookup_sig(cid.name);
  }
  return None;
}

function lit_bound_typevar(sig: FuncSig, c: ast.ExprCall, tp: string, s: Scope): boolean {
  let (wn, _) = written_type_bindings(sig, c, s);
  if (util.has_str(wn, tp)) {
    return false;
  }
  let n = 0;
  let k = 0;
  while (k < sig.param_type_names.len() && k < c.args.len()) {
    if (sig.param_type_names[k] == tp) {
      let (seed, ids) = lit_tree(c.args[k], s, []);
      if (!seed && !int_literal_tree(c.args[k]) && !gcall_open(c.args[k], s)) {
        return false;
      }
      n += 1;
    } else if (type_ref_names_any(sig_param_ref(sig, k), [tp])) {
      return false;
    }
    k += 1;
  }
  return n > 0;
}

function gcall_open(e: ast.Expr, s: Scope): boolean {
  let (ce, tvs) = gcall_open_tvars(e, s);
  return tvs.len() > 0;
}

function gcall_open_tvars(e: ast.Expr, s: Scope): (ast.Expr, string[]) {
  let tvs: string[] = [];
  let (ce, lifted, ok) = gcall_of(e, t_unknown("open"), s);
  if (!ok) {
    return (e, tvs);
  }
  if let ast.ExprCall(c) = ce {
    let Some(sig) = gcall_sig(c, s) else {
      return (ce, tvs);
    };
    let ret = sig_ret_ref(sig);
    for tp in sig.typevars {
      if (type_ref_names_any(ret, [tp]) && lit_bound_typevar(sig, c, tp, s)) {
        tvs = tvs.append(tp);
      }
    }
  }
  return (ce, tvs);
}

function gcall_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let (ce, lifted, ok) = gcall_of(e, want, s);
  if (!ok) {
    return st;
  }
  if let ast.ExprCall(c) = ce {
    let Some(sig) = gcall_sig(c, s) else {
      return st;
    };
    let (bn, bt) = gc_bind_param(sig_ret_ref(sig), lifted, sig.typevars, s.type_names(), [], []);
    let out = st;
    let i = 0;
    while (i < bn.len()) {
      if ((is_integer(bt[i]) || is_float(bt[i])) && lit_bound_typevar(sig, c, bn[i], s)) {
        out = gcall_settle(c, sig, bn[i], bt[i], s, out);
      }
      i += 1;
    }
    return out;
  }
  return st;
}

function gcall_settle(c: ast.ExprCall, sig: FuncSig, tp: string, w: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let tag = typeinfo.spelling(w);
  let out = st;
  let k = 0;
  while (k < sig.param_type_names.len() && k < c.args.len()) {
    if (sig.param_type_names[k] == tp) {
      let (seed, ids) = lit_tree(c.args[k], s, []);
      out = lit_fix(out, ids, w);
      if (int_literal_tree(c.args[k]) && (tag == "i32" || is_float(w) || lit_suffix_spelled(tag))) {
        out = LitInfer { ...out, cargs: out.cargs.append(gcall_arg_key(c, k)), ctags: out.ctags.append(tag) };
      }
      out = gcall_demand(c.args[k], w, s, out);
    }
    k += 1;
  }
  return out;
}

function gcall_arg_key(c: ast.ExprCall, k: i32): string {
  return "c" + util.i32_to_string(c.line) + ":" + util.i32_to_string(c.col) + "#" + util.i32_to_string(k);
}

// variant_payload_types is the payload types of a variant constructor call,
// with the type arguments the call gives its enum.
function variant_payload_types(c: ast.ExprCall, s: Scope): typeinfo.Type[] {
  let ast.ExprIdent(id) = c.callee else {
    return [];
  };
  let Some(sig) = s.lookup_variant(id.name) else {
    return [];
  };
  if (sig.enum_owner.len() == 0) {
    return [];
  }
  return instantiated_variant(sig, s, check_expr(c, s)).field_types;
}

// lit_arg_reads is true when a call argument holds something the pass must
// settle from the parameter type.
function lit_arg_reads(arg: ast.Expr, s: Scope): boolean {
  let (seed, ids) = lit_tree(arg, s, []);
  return seed && ids.len() > 0 || lit_composite(arg) || !seed && open_tree(arg, s) || lit_struct_read(arg, s) || lit_enum_read(arg, s) || lit_open_read(arg, s) || lit_marked_read(arg, s);
}

// lit_open_receiver gives an open local the type arguments that a method call
// on it binds. An open map takes the key and value types that a call of
// insert or get_or passes to it, as a map literal takes them from its entries.
function lit_open_receiver(c: ast.ExprCall, s: Scope, st: LitInfer): LitInfer {
  let ast.ExprFieldAccess(fa) = c.callee else {
    return st;
  };
  let ast.ExprIdent(id) = fa.obj else {
    return st;
  };
  let k = lit_open_id(s.lookup(id.name));
  if (k < 0) {
    return st;
  }
  let ts = lit_typed_scope(s, st);
  match (st.otypes[k]) {
    typeinfo.TypeStruct(h) => {
      return lit_open_fill(st, k, typeinfo.TypeStruct { name: h.name, args: lit_method_receiver(c, fa.field, h.name, h.args, ts) });
    },
    typeinfo.TypeUnion(h) => {
      return lit_open_fill(st, k, typeinfo.TypeUnion { name: h.name, args: lit_method_receiver(c, fa.field, h.name, h.args, ts) });
    },
    _ => {}
  }
  if (!bare_map(st.otypes[k]) || c.args.len() != 2 || fa.field != "insert" && fa.field != "get_or") {
    return st;
  }
  return lit_open_fill(st, k, t_map(settled_literal(check_expr(c.args[0], ts)), settled_literal(check_expr(c.args[1], ts))));
}

// lit_method_receiver is the receiver type arguments that the arguments of a
// method call bind, such as `[i32, string]` for `m.insert(1, "one")` with
// `insert(k: K, v: V)` on `OrdMap[K, V]`. An argument that the call does not
// bind stays as it is in `have`.
function lit_method_receiver(c: ast.ExprCall, method: string, name: string, have: typeinfo.Type[], s: Scope): typeinfo.Type[] {
  let Some(msig) = s.lookup_method(method, name) else {
    return have;
  };
  let rref = parser.parse_type_ref(msig.receiver_type);
  if (c.args.len() != msig.param_type_names.len() || rref.args.len() != have.len()) {
    return have;
  }
  let tps: string[] = [];
  for ar in rref.args {
    tps = tps.append(ar.base);
  }
  let bn: string[] = [];
  let bt: typeinfo.Type[] = [];
  for i in 0..c.args.len() {
    let (n2, t2) = gc_bind_param(parser.parse_type_ref(msig.param_type_names[i]), settled_literal(check_expr(c.args[i], s)), tps, s.type_names(), bn, bt);
    bn = n2;
    bt = t2;
  }
  let args: typeinfo.Type[] = [];
  for i in 0..have.len() {
    let at = util.index_of_str(bn, tps[i]);
    if (unbound_enum_argument(have[i]) && at >= 0) {
      args = args.append(bt[at]);
    } else {
      args = args.append(have[i]);
    }
  }
  return args;
}

// lit_array_receiver gives a literal array local the element type of a typed
// argument to `append` or `with`, as a literal takes the type of the other
// operand of a binary operator.
function lit_array_receiver(c: ast.ExprCall, s: Scope, st: LitInfer): LitInfer {
  let ast.ExprFieldAccess(fa) = c.callee else {
    return st;
  };
  let ast.ExprIdent(id) = fa.obj else {
    return st;
  };
  let typeinfo.TypeArray(a) = s.lookup(id.name) else {
    return st;
  };
  let k = lit_id(a.elem);
  let at = if (fa.field == "append") { 0 } else if (fa.field == "with") { 1 } else { -1 };
  if (k < 0 || at < 0 || c.args.len() != at + 1 || open_tree(c.args[at], s)) {
    return st;
  }
  let have = check_expr(c.args[at], s);
  if (settled_number(have)) {
    return lit_fix(st, [k], have);
  }
  return st;
}

// settled_literal is the type an untyped literal settles to by default.
function settled_literal(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeI32(i) = t {
    if (i.polymorphic) {
      return t_i32();
    }
  }
  if let typeinfo.TypeFloat(f) = t {
    if (f.polymorphic) {
      return typeinfo.TypeFloat { width: 64, polymorphic: false };
    }
  }
  return t;
}

function lit_call(c: ast.ExprCall, s: Scope, st: LitInfer): LitInfer {
  if (parser.is_value_block(c)) {
    return lit_value_block(c, t_unknown("value block"), s, st);
  }
  let out = lit_expr(c.callee, s, lit_array_receiver(c, s, lit_open_receiver(c, s, st)));
  let reads = false;
  for arg in c.args {
    reads = reads || lit_arg_reads(arg, s);
  }
  let pts: typeinfo.Type[] = [];
  if (reads) {
    pts = s.call_param_types(c);
    if (pts.len() == 0) {
      pts = variant_payload_types(c, s);
    }
  }
  let i = 0;
  while (i < c.args.len()) {
    if (i < pts.len()) {
      out = lit_demand(c.args[i], pts[i], s, out);
    } else {
      out = lit_arg(c.args[i], s, out);
    }
    i += 1;
  }
  return out;
}

function lit_value_block(c: ast.ExprCall, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if (is_unknown(want) || is_float(want)) {
    want = check_expr(c, lit_typed_scope(s, st));
  }
  if let ast.ExprLambda(vb) = c.callee {
    let cur = lambda_body_scope(vb, s).with_block_ret(want);
    let out = st;
    let last = vb.body.len() - 1;
    let i = 0;
    while (i < last) {
      let (ns, nst) = lit_stmt(vb.body[i], cur, out);
      cur = ns;
      out = nst;
      i += 1;
    }
    if (last < 0) {
      return out;
    }
    if let ast.StmtReturn(r) = vb.body[last] {
      return lit_demand(r.value, want, cur, lit_float_demand(r.value, want, cur, out));
    }
    return lit_value_branch(vb.body[last], want, cur, out);
  }
  return st;
}

function lit_value_branch(stmt: ast.Stmt, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if let ast.StmtIf(f) = stmt {
    st = lit_expr(f.cond, s, st);
    return lit_value_body(f.else_body, want, s, lit_value_body(f.then_body, want, s, st));
  }
  if let ast.StmtMatch(m) = stmt {
    st = lit_arg(m.scrutinee, s, st);
    for arm in m.arms {
      let cur = annotate_arm_scope(arm, s, check_expr(m.scrutinee, s));
      if (arm.has_guard) {
        st = lit_expr(arm.guard, cur, st);
      }
      st = lit_value_body(arm.body, want, cur, st);
    }
    return st;
  }
  let (scope, out) = lit_stmt(stmt, s, st);
  return out;
}

function lit_value_body(body: ast.Stmt[], want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let cur = s;
  let i = 0;
  while (i + 1 < body.len()) {
    let (next, out) = lit_stmt(body[i], cur, st);
    cur = next;
    st = out;
    i += 1;
  }
  if (body.len() == 0) {
    return st;
  }
  if let ast.StmtReturn(r) = body[i] {
    return lit_demand(r.value, want, cur, lit_float_demand(r.value, want, cur, st));
  }
  return lit_value_branch(body[i], want, cur, st);
}

function lit_float_needed(have: typeinfo.Type, want: typeinfo.Type): boolean {
  if (is_poly_int(have) && is_float(want)) {
    return true;
  }
  if let typeinfo.TypeTuple(h) = have {
    if let typeinfo.TypeTuple(w) = want {
      let i = 0;
      while (i < h.elements.len() && i < w.elements.len()) {
        if (lit_float_needed(h.elements[i], w.elements[i])) {
          return true;
        }
        i += 1;
      }
    }
  }
  return false;
}

function lit_float_key(e: ast.Expr): string {
  let shape = "";
  match (e) {
    ast.ExprIdent(id) => {
      shape = "id:" + id.name;
    },
    ast.ExprFieldAccess(fa) => {
      shape = "field:" + fa.field;
    },
    ast.ExprIndex(_) => {
      shape = "index";
    },
    ast.ExprUnary(u) => {
      shape = "unary:" + u.op;
    },
    ast.ExprBinary(b) => {
      shape = "binary:" + b.op;
    },
    ast.ExprCall(_) => {
      shape = "call";
    },
    _ => {
      return "";
    }
  }
  return "f" + util.i32_to_string(expr_line(e)) + ":" + util.i32_to_string(expr_col(e)) + ":" + shape;
}

function lit_float_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprIdent(id) = e {
    if (parser.is_value_local_name(id.name)) {
      return st;
    }
  }
  if let ast.ExprTuple(t) = e {
    if let typeinfo.TypeTuple(w) = want {
      let i = 0;
      while (i < t.elements.len() && i < w.elements.len()) {
        st = lit_float_demand(t.elements[i], w.elements[i], s, st);
        i += 1;
      }
      return st;
    }
  }
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      return lit_value_body(parser.vb_body(c), want, s, st);
    }
    st = lit_float_constructor(c, want, s, st);
  }
  let have = mx_arm_result_type(e, lit_typed_scope(s, st));
  if (lit_float_needed(have, want) && !int_literal_tree(e)) {
    return LitInfer { ...st, cargs: st.cargs.append(lit_float_key(e)), ctags: st.ctags.append(typeinfo.spelling(want)) };
  }
  return st;
}

function lit_float_constructor(c: ast.ExprCall, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if (constructor_destination(c, want, s)) {
    let index = builtin_payload_index(ctor_variant_name(c), want);
    let args = nominal_args(want);
    if (index >= 0 && index < args.len() && c.args.len() == 1) {
      return lit_float_demand(c.args[0], args[index], s, st);
    }
  }
  return st;
}

function lit_typed_scope(s: Scope, st: LitInfer): Scope {
  let types = s.types;
  let lits = s.lit_locals;
  let i = 0;
  while (i < types.len()) {
    let original = types[i];
    types = types.with(i, lit_typed_type(original, st, true));
    let k = lit_id(original);
    if (k >= 0) {
      let w = st.width[lit_find(st, k)];
      if (is_unknown(w)) {
        w = typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: true };
        lits = lits.append(s.names[i]);
      }
      types = types.with(i, w);
    }
    i += 1;
  }
  return Scope { ...s, types: types, lit_locals: lits };
}

function lit_typed_type(t: typeinfo.Type, st: LitInfer, poly: boolean): typeinfo.Type {
  let k = lit_id(t);
  if (k >= 0) {
    let w = st.width[lit_find(st, k)];
    if (is_unknown(w)) {
      return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: poly };
    }
    return w;
  }
  if let typeinfo.TypeTuple(tt) = t {
    let elems: typeinfo.Type[] = [];
    for el in tt.elements {
      elems = elems.append(lit_typed_type(el, st, poly));
    }
    return t_tuple(elems);
  }
  if let typeinfo.TypeArray(a) = t {
    return typeinfo.TypeArray { ...a, elem: lit_typed_type(a.elem, st, poly) };
  }
  return t;
}

function lit_type_demand(have: typeinfo.Type, want: typeinfo.Type, st: LitInfer): LitInfer {
  let o = lit_open_id(have);
  if (o >= 0) {
    return lit_open_fill(st, o, want);
  }
  let k = lit_id(have);
  if (k >= 0) {
    return lit_fix(st, [k], want);
  }
  if let typeinfo.TypeTuple(h) = have {
    if let typeinfo.TypeTuple(w) = want {
      if (h.elements.len() == w.elements.len()) {
        let i = 0;
        while (i < h.elements.len()) {
          st = lit_type_demand(h.elements[i], w.elements[i], st);
          i += 1;
        }
      }
    }
  }
  if let typeinfo.TypeArray(h) = have {
    if let typeinfo.TypeArray(w) = want {
      st = lit_type_demand(h.elem, w.elem, st);
    }
  }
  return st;
}

function lit_type_link(a: typeinfo.Type, b: typeinfo.Type, st: LitInfer): LitInfer {
  let left = lit_id(a);
  let right = lit_id(b);
  if (left >= 0 && right >= 0) {
    return lit_link(st, [left, right]);
  }
  if (left >= 0) {
    return lit_fix(st, [left], b);
  }
  if (right >= 0) {
    return lit_fix(st, [right], a);
  }
  if let typeinfo.TypeTuple(at) = a {
    if let typeinfo.TypeTuple(bt) = b {
      if (at.elements.len() == bt.elements.len()) {
        let i = 0;
        while (i < at.elements.len()) {
          st = lit_type_link(at.elements[i], bt.elements[i], st);
          i += 1;
        }
      }
    }
  }
  if let typeinfo.TypeArray(at) = a {
    if let typeinfo.TypeArray(bt) = b {
      st = lit_type_link(at.elem, bt.elem, st);
    }
  }
  return st;
}

function lit_composite_local(e: ast.Expr, s: Scope, st: LitInfer): (typeinfo.Type, LitInfer, boolean) {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed || float_literal_tree(e)) {
    let k = st.parent.len();
    st = lit_new(st, "");
    if (float_literal_tree(e)) {
      st = LitInfer { ...st, width: st.width.with(k, typeinfo.TypeFloat { width: 64, polymorphic: true }) };
    }
    return (lit_marker(k), lit_link(st, ids.append(k)), true);
  }
  if let ast.ExprTuple(t) = e {
    let elems: typeinfo.Type[] = [];
    let any = false;
    for el in t.elements {
      let (ty, next, found) = lit_composite_local(el, s, st);
      st = next;
      any = any || found;
      elems = elems.append(ty);
    }
    return (t_tuple(elems), st, any);
  }
  if let ast.ExprArray(a) = e {
    if (a.elements.len() > 0) {
      let (elem, next, any) = lit_composite_local(a.elements[0], s, st);
      st = next;
      let i = 1;
      while (i < a.elements.len()) {
        let (ty, more, found) = lit_composite_local(a.elements[i], s, st);
        st = more;
        st = lit_type_link(elem, ty, st);
        i += 1;
      }
      return (t_array(elem), st, any);
    }
  }
  return (check_expr(e, lit_typed_scope(s, st)), st, false);
}

function lit_composite(e: ast.Expr): boolean {
  if let ast.ExprTuple(_) = e {
    return true;
  }
  if let ast.ExprArray(_) = e {
    return true;
  }
  if let ast.ExprCall(c) = e {
    return parser.is_value_block(c);
  }
  return false;
}

function lit_array(arr: ast.ExprArray, s: Scope, st: LitInfer): LitInfer {
  let out = st;
  let ids: i32[] = [];
  let sibling = t_unknown("no typed element");
  for el in arr.elements {
    let (seed, eids) = lit_tree(el, s, []);
    if (seed) {
      for k in eids {
        ids = ids.append(k);
      }
    } else {
      out = lit_expr(el, s, out);
      if (is_unknown(sibling) && ids.len() > 0) {
        sibling = check_expr(el, s);
      }
    }
  }
  if (ids.len() == 0) {
    return out;
  }
  if (is_unknown(sibling) && ids.len() < arr.elements.len()) {
    for el in arr.elements {
      let (seed2, e2) = lit_tree(el, s, []);
      if (!seed2 && is_unknown(sibling)) {
        sibling = check_expr(el, s);
      }
    }
  }
  return lit_fix(lit_link(out, ids), ids, sibling);
}

// A struct literal with a base takes the type arguments of the base.
function spread_struct_args(sl: ast.ExprStructLit, sig: StructSig, largs: typeinfo.Type[], s: Scope): typeinfo.Type[] {
  if (!sl.has_base) {
    return largs;
  }
  let typeinfo.TypeStruct(bt) = check_expr(sl.base, s) else {
    return largs;
  };
  if (bt.name != sig.name || bt.args.len() != sig.type_params.len()) {
    return largs;
  }
  return bt.args;
}

// lit_field_want is the type a field of a generic struct literal demands. An
// open enum local takes the whole field type.
function lit_field_want(value: ast.Expr, sig: StructSig, j: i32, largs: typeinfo.Type[], s: Scope): typeinfo.Type {
  if (lit_open_read(value, s) && largs.len() == sig.type_params.len()) {
    return type_from_ref_subst(parser.parse_type_ref(sig.field_type_names[j]), sig.type_params, largs, s.type_names());
  }
  return widened_field_type(sig, j, largs, s);
}

function lit_struct_lit(sl: ast.ExprStructLit, s: Scope, st: LitInfer): LitInfer {
  let out = st;
  let found = s.lookup_struct(sl.type_name);
  let largs: typeinfo.Type[] = [];
  if let Some(sig) = found {
    if (sig.type_params.len() > 0) {
      largs = spread_struct_args(sl, sig, struct_lit_args(sl, sig, s), s);
    }
  }
  let i = 0;
  while (i < sl.field_values.len()) {
    let want = t_unknown("no field");
    if let Some(sig) = found {
      if (i < sl.field_names.len()) {
        let j = 0;
        while (j < sig.field_names.len()) {
          if (sig.field_names[j] == sl.field_names[i] && j < sig.field_types.len()) {
            want = sig.field_types[j];
            if (sig.type_params.len() > 0 && j < sig.field_type_names.len()) {
              want = lit_field_want(sl.field_values[i], sig, j, largs, s);
            }
          }
          j += 1;
        }
      }
    }
    out = lit_demand(sl.field_values[i], want, s, out);
    i += 1;
  }
  if (sl.has_base) {
    out = lit_expr(sl.base, s, out);
  }
  return out;
}

function lit_index(ix: ast.ExprIndex, s: Scope, st: LitInfer): LitInfer {
  let (seed, ids) = lit_tree(ix.index, s, []);
  if (!seed) {
    return lit_expr(ix.index, s, st);
  }
  if (ids.len() == 0) {
    return st;
  }
  let want = t_i32();
  if let typeinfo.TypeMap(tm) = check_expr(ix.array, s) {
    want = tm.key;
  }
  return lit_fix(st, ids, want);
}

function lit_expr(e: ast.Expr, s: Scope, st: LitInfer): LitInfer {
  match (e) {
    ast.ExprBinary(b) => {
      return lit_binary(b, s, st);
    },
    ast.ExprUnary(u) => {
      return lit_arg(u.operand, s, st);
    },
    ast.ExprCall(c) => {
      return lit_call(c, s, st);
    },
    ast.ExprArray(arr) => {
      return lit_array(arr, s, st);
    },
    ast.ExprStructLit(sl) => {
      return lit_struct_lit(sl, s, st);
    },
    ast.ExprLambda(lm) => {
      return lit_lambda(lm, s, st);
    },
    ast.ExprTuple(tl) => {
      let out = st;
      for el in tl.elements {
        out = lit_arg(el, s, out);
      }
      return out;
    },
    ast.ExprIndex(ix) => {
      return lit_index(ix, s, lit_arg(ix.array, s, st));
    },
    ast.ExprSlice(sx) => {
      let out2 = lit_arg(sx.array, s, st);
      if (!sx.open_start) {
        out2 = lit_demand(sx.start, t_i32(), s, out2);
      }
      if (!sx.open_end) {
        out2 = lit_demand(sx.end, t_i32(), s, out2);
      }
      return out2;
    },
    ast.ExprFieldAccess(fa) => {
      return lit_arg(fa.obj, s, st);
    },
    ast.ExprMapLit(ml) => {
      let out3 = st;
      for k in ml.keys {
        out3 = lit_arg(k, s, out3);
      }
      for v in ml.vals {
        out3 = lit_arg(v, s, out3);
      }
      return out3;
    },
    ast.ExprFString(fs) => {
      let out4 = st;
      let q = 0;
      while (q < fs.exprs.len()) {
        if (fs.is_expr[q]) {
          out4 = lit_arg(fs.exprs[q], s, out4);
        }
        q += 1;
      }
      return out4;
    },
    _ => {
      return st;
    }
  }
  return st;
}

function lit_lambda(lm: ast.ExprLambda, s: Scope, st: LitInfer): LitInfer {
  let bs = lambda_body_scope(lm, s);
  let out = lit_stmts(lm.body, bs, st);
  if (lm.ret_type.len() > 0) {
    return out;
  }
  let ids = lit_return_ids(lm.body, bs, []);
  if (ids.len() == 0) {
    return out;
  }
  let w = t_i32();
  for k in ids {
    let r = lit_find(out, k);
    if (!is_unknown(out.width[r]) && type_eq(w, t_i32())) {
      w = out.width[r];
    }
  }
  return lit_fix(out, ids, w);
}

function lit_return_ids(stmts: ast.Stmt[], s: Scope, ids: i32[]): i32[] {
  let cur = s;
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        let (seed, rids) = lit_tree(r.value, cur, []);
        if (seed) {
          for k in rids {
            ids = ids.append(k);
          }
        }
      },
      ast.StmtIf(f) => {
        ids = lit_return_ids(f.then_body, cur, ids);
        ids = lit_return_ids(f.else_body, cur, ids);
      },
      ast.StmtWhile(w) => {
        ids = lit_return_ids(w.body, cur, ids);
      },
      ast.StmtFor(fr) => {
        ids = lit_return_ids(fr.body, for_body_scope(fr, cur), ids);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          ids = lit_return_ids(arm.body, cur, ids);
        }
      },
      _ => {}
    }
    cur = bind_stmt(stmt, cur);
  }
  return ids;
}

function lit_var_key(v: ast.StmtVar): string {
  return "v" + util.i32_to_string(v.line) + ":" + util.i32_to_string(v.col) + ":" + v.name;
}

function lit_for_key(fr: ast.StmtFor, lo: ast.Expr): string {
  return "f" + util.i32_to_string(fr.line) + ":" + util.i32_to_string(ast.expr_line(lo)) + ":" + util.i32_to_string(ast.expr_col(lo)) + ":" + fr.var_name;
}

function lit_range_bounds(iter: ast.Expr): ast.Expr[] {
  if let ast.ExprCall(c) = iter {
    return c.args;
  }
  return [];
}

function lit_range(fr: ast.StmtFor, s: Scope, st: LitInfer): LitInfer {
  let bounds = lit_range_bounds(fr.iter);
  let (ls, lids) = lit_tree(bounds[0], s, []);
  let (hs, hids) = lit_tree(bounds[1], s, []);
  let out = st;
  if (!ls) {
    out = lit_expr(bounds[0], s, out);
  }
  if (!hs) {
    out = lit_expr(bounds[1], s, out);
  }
  let body = for_body_scope(fr, s);
  if (ls) {
    let k = out.parent.len();
    out = lit_new(out, lit_for_key(fr, bounds[0]));
    let ids: i32[] = [k];
    for a in lids {
      ids = ids.append(a);
    }
    if (hs) {
      for b in hids {
        ids = ids.append(b);
      }
      out = lit_link(out, ids);
    } else {
      out = lit_fix(lit_link(out, ids), ids, check_expr(bounds[1], s));
    }
    body = body.bind(fr.var_name, lit_marker(k));
  } else if (hs) {
    out = lit_fix(out, hids, check_expr(bounds[0], s));
  }
  return lit_stmts(fr.body, body, out);
}

function lit_stmts(stmts: ast.Stmt[], s: Scope, st: LitInfer): LitInfer {
  let cur = s;
  let out = st;
  for stmt in stmts {
    let (ns, nst) = lit_stmt(stmt, cur, out);
    cur = ns;
    out = nst;
  }
  return out;
}

function lit_stmt(stmt: ast.Stmt, s: Scope, st: LitInfer): (Scope, LitInfer) {
  match (stmt) {
    ast.StmtVar(v) => {
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return (bind_stmt(stmt, s), lit_expr(v.init, s, st));
      }
      if (v.type_name.len() > 0) {
        return (bind_stmt(stmt, s), lit_demand(v.init, var_declared_type(v, s), s, st));
      }
      let (seed, ids, sst) = lit_seed(v.init, s, st);
      if (!seed) {
        if let ast.ExprCall(call) = v.init {
          let (enum_type, enum_state) = lit_enum_local(call, s, st);
          if (!is_unknown(enum_type)) {
            return (s.bind(v.name, enum_type), enum_state);
          }
        }
        if let ast.ExprArray(ea) = v.init {
          let wtag = widened_array_tag(ea, s);
          if (wtag.len() > 0) {
            let wst = lit_expr(v.init, s, st);
            return (bind_stmt(stmt, s), LitInfer { ...wst, wkeys: wst.wkeys.append(lit_var_key(v)), wtags: wst.wtags.append(wtag) });
          }
        }
        if let ast.ExprStructLit(sl) = v.init {
          let (ss, sst) = lit_struct_local(v, sl, s, lit_expr(v.init, s, st));
          if (ss.len() > 0) {
            let own_ids: i32[] = [];
            let oi = sst.sfirst[sst.sfirst.len() - 1];
            while (oi < sst.sids.len()) {
              own_ids = own_ids.append(sst.sids[oi]);
              oi += 1;
            }
            return (s.bind(v.name, lit_struct_marker(ss, own_ids)), sst);
          }
        }
        if (lit_composite(v.init) || float_literal_tree(v.init)) {
          let (ct, cs, found) = lit_composite_local(v.init, s, st);
          if (found) {
            return (s.bind(v.name, ct), LitInfer { ...cs, tkeys: cs.tkeys.append(lit_var_key(v)), ttypes: cs.ttypes.append(ct) });
          }
        }
        let open_type = check_expr(v.init, s);
        let (call_type, open_call) = open_call_type(v.init, s);
        if (open_call) {
          open_type = call_type;
        }
        if (open_call || holds_open_enum(open_type, s)) {
          let ost = lit_expr(v.init, s, st);
          let k = ost.okeys.len();
          return (s.bind(v.name, lit_open_marker(k)), LitInfer { ...ost, okeys: ost.okeys.append(lit_var_key(v)), otypes: ost.otypes.append(open_type), ofills: ost.ofills.append(t_unknown("open")) });
        }
        return (bind_stmt(stmt, s), lit_expr(v.init, s, st));
      }
      let k = sst.parent.len();
      return (s.bind(v.name, lit_marker(k)), lit_link(lit_new(sst, lit_var_key(v)), ids.append(k)));
    },
    ast.StmtAssign(a) => {
      let tk = lit_id(s.lookup(a.target));
      if (tk < 0) {
        return (s, lit_demand(a.value, s.lookup(a.target), s, st));
      }
      let (seed2, ids2, ast2) = lit_seed(a.value, s, st);
      if (seed2) {
        return (s, lit_link(ast2, ids2.append(tk)));
      }
      let walked = lit_expr(a.value, s, st);
      return (s, lit_fix(walked, [tk], check_expr(a.value, s)));
    },
    ast.StmtReturn(r) => {
      return (s, lit_demand(r.value, s.ret_type, s, st));
    },
    ast.StmtExpr(x) => {
      return (s, lit_expr(x.value, s, st));
    },
    ast.StmtIf(f) => {
      let ci = lit_expr(f.cond, s, st);
      return (s, lit_stmts(f.else_body, s, lit_stmts(f.then_body, s, ci)));
    },
    ast.StmtWhile(w) => {
      return (s, lit_stmts(w.body, s, lit_expr(w.cond, s, st)));
    },
    ast.StmtFor(fr) => {
      if (for_iter_is_range(fr.iter)) {
        return (s, lit_range(fr, s, st));
      }
      return (s, lit_stmts(fr.body, for_body_scope(fr, s), lit_expr(fr.iter, s, st)));
    },
    ast.StmtMatch(m) => {
      let out = lit_arg(m.scrutinee, s, st);
      let whole = check_expr(m.scrutinee, s);
      if let ast.ExprCall(call) = m.scrutinee {
        let (enum_type, enum_state) = lit_enum_local(call, s, out);
        if (!is_unknown(enum_type)) {
          whole = enum_type;
          out = enum_state;
        }
      }
      for arm in m.arms {
        let asc = annotate_arm_scope(arm, s, whole);
        if (arm.has_guard) {
          out = lit_expr(arm.guard, asc, out);
        }
        out = lit_stmts(arm.body, asc, out);
      }
      return (s, out);
    },
    ast.StmtDefer(d) => {
      let (ds, dst) = lit_stmt(d.action, s, st);
      return (s, dst);
    },
    _ => {
      return (s, st);
    }
  }
  return (s, st);
}

function lit_enum_local(c: ast.ExprCall, s: Scope, st: LitInfer): (typeinfo.Type, LitInfer) {
  let none = t_unknown("not a literal enum local");
  if (ctor_name_taken(c, s)) {
    return (none, st);
  }
  if let typeinfo.TypeUnion(u) = check_expr(c, s) {
    let qualified = false;
    if let ast.ExprFieldAccess(fa) = c.callee {
      if let ast.ExprIdent(owner) = fa.obj {
        if (owner.name != u.name || s.known(owner.name)) {
          return (none, st);
        }
        qualified = true;
      } else {
        return (none, st);
      }
    }
    let args = u.args;
    let out = st;
    let p = 0;
    while (p < c.args.len()) {
      let slot = ctor_payload_slot(s, u.name, ctor_variant_name(c), p);
      if (qualified && u.name != "Option" && u.name != "Result") {
        slot = -1;
        if let Some(us) = s.lookup_union(u.name) {
          slot = payload_type_param(s, us, ctor_variant_name(c), p);
        }
      }
      let (seed, ids) = lit_tree(c.args[p], s, []);
      if (!seed && lit_composite(c.args[p])) {
        let (shape, next) = lit_payload_shape(c, p, u.name, s, out);
        if (shape.slot >= 0 && shape.slot < args.len()) {
          args = args.with(shape.slot, shape.param);
          out = LitInfer { ...next, pargs: next.pargs.append(gcall_arg_key(c, p)), ptypes: next.ptypes.append(shape.arg) };
        }
      }
      if (slot >= 0 && slot < args.len() && seed) {
        let k = out.parent.len();
        out = lit_link(lit_new(out, ""), ids.append(k));
        if let typeinfo.TypeI32(known) = u.args[slot] {
          if (!known.polymorphic) {
            out = lit_fix(out, [k], known);
          }
        }
        let prior = lit_id(args[slot]);
        if (prior >= 0) {
          out = lit_link(out, [prior, k]);
        }
        args = args.with(slot, lit_marker(k));
        out = LitInfer { ...out, eargs: out.eargs.append(gcall_arg_key(c, p)), eids: out.eids.append(k) };
      }
      p += 1;
    }
    if (out.eids.len() > st.eids.len() || out.pargs.len() > st.pargs.len()) {
      return (typeinfo.TypeUnion { ...u, args: args }, out);
    }
  }
  return (none, st);
}

// A constructor argument that is a tuple or array literal of unsettled
// integers: the type parameter its payload spells as T or T[], the marked
// type that parameter takes, and the marked type of the whole argument.
struct LitPayloadShape { slot: i32, param: typeinfo.Type, arg: typeinfo.Type }

function lit_payload_shape(c: ast.ExprCall, p: i32, owner: string, s: Scope, st: LitInfer): (LitPayloadShape, LitInfer) {
  let none = LitPayloadShape { slot: 0 - 1, param: t_unknown("no payload shape"), arg: t_unknown("no payload shape") };
  let (arg, next, found) = lit_composite_local(c.args[p], s, st);
  if (!found) {
    return (none, st);
  }
  let vname = ctor_variant_name(c);
  let slot = ctor_payload_slot(s, owner, vname, p);
  if (slot >= 0) {
    return (LitPayloadShape { slot: slot, param: arg, arg: arg }, next);
  }
  if (owner == "Option" || owner == "Result" || scope_variant_owner(vname, s) != owner) {
    return (none, st);
  }
  let us: UnionSig = match (s.lookup_union(owner)) { Some(sig) => sig, None => { return (none, st); } };
  let spelled = payload_spelling(s, us, vname, p);
  if let typeinfo.TypeArray(a) = arg {
    if (spelled.ends_with("[]")) {
      let elem_slot = util.index_of_str(us.type_params, slice_unchecked(spelled, 0, spelled.len() - 2) + "");
      if (elem_slot >= 0) {
        return (LitPayloadShape { slot: elem_slot, param: a.elem, arg: arg }, next);
      }
    }
  }
  return (none, st);
}

function lit_struct_local(v: ast.StmtVar, sl: ast.ExprStructLit, s: Scope, st: LitInfer): (string, LitInfer) {
  let Some(sig) = s.lookup_struct(sl.type_name) else {
    return ("", st);
  };
  if (sig.type_params.len() == 0 || sl.has_base || util.index_of_sub(sl.type_name, "[") >= 0) {
    return ("", st);
  }
  let args = struct_lit_args(sl, sig, s);
  let out = st;
  let ids: i32[] = [];
  let spelled: string[] = [];
  let any = false;
  let lit: ast.Expr[] = [sl];
  let ti = 0;
  while (ti < sig.type_params.len()) {
    let lits = false;
    let typed = false;
    let wide = false;
    for e in struct_param_exprs(sig, sig.type_params[ti], lit, s) {
      if (int_literal_tree(e)) {
        lits = true;
        wide = wide || wide_int_tree(e);
      } else {
        typed = true;
      }
    }
    if (lits && !typed) {
      let k = out.parent.len();
      out = lit_new(out, "");
      if (wide) {
        out = lit_fix(out, [k], t_i64());
      }
      ids = ids.append(k);
      any = true;
    } else {
      ids = ids.append(-1);
    }
    let sp = "";
    if (ti < args.len() && !is_unknown(args[ti])) {
      sp = typeinfo.spelling(args[ti]);
    }
    spelled = spelled.append(sp);
    ti += 1;
  }
  if (!any) {
    return ("", st);
  }
  let sargs = out.sargs;
  let sids = out.sids;
  let j = 0;
  while (j < ids.len()) {
    sargs = sargs.append(spelled[j]);
    sids = sids.append(ids[j]);
    j += 1;
  }
  return (sl.type_name, LitInfer { ...out, skeys: out.skeys.append(lit_var_key(v)), snames: out.snames.append(sl.type_name), sfirst: out.sfirst.append(out.sids.len()), sargs: sargs, sids: sids });
}

function lit_struct_tags(st: LitInfer): (string[], string[]) {
  let keys: string[] = [];
  let tags: string[] = [];
  let j = 0;
  while (j < st.skeys.len()) {
    let end = st.sids.len();
    if (j + 1 < st.sfirst.len()) {
      end = st.sfirst[j + 1];
    }
    let parts = "";
    let moved = false;
    let known = true;
    let i = st.sfirst[j];
    while (i < end) {
      let a = st.sargs[i];
      if (st.sids[i] >= 0) {
        a = "i32";
        let w = st.width[lit_find(st, st.sids[i])];
        if (!is_unknown(w)) {
          a = typeinfo.spelling(w);
        }
        moved = moved || a != "i32";
      }
      known = known && a.len() > 0;
      if (i > st.sfirst[j]) {
        parts += ", ";
      }
      parts += a;
      i += 1;
    }
    if (moved && known) {
      keys = keys.append(st.skeys[j]);
      tags = tags.append(st.snames[j] + "[" + parts + "]");
    }
    j += 1;
  }
  return (keys, tags);
}

// open_rewrites adds the type of each settled open enum local to the keys and
// tags of the rewrites.
function open_rewrites(st: LitInfer, own keys: string[], own tags: string[]): (string[], string[]) {
  for oi in 0..st.okeys.len() {
    if (!is_unknown(st.ofills[oi])) {
      keys = keys.append(st.okeys[oi]);
      tags = tags.append(open_spelling(st.ofills[oi]));
    }
  }
  return (keys, tags);
}

function lit_rewrites(st: LitInfer): LitRewrite {
  let keys: string[] = [];
  let tags: string[] = [];
  let k = 0;
  while (k < st.keys.len()) {
    if (st.keys[k].len() == 0) {
      k += 1;
      continue;
    }
    let w = st.width[lit_find(st, k)];
    let tag = "i32";
    if (!is_unknown(w)) {
      tag = typeinfo.spelling(w);
    }
    let at = util.index_of_str(keys, st.keys[k]);
    if (at < 0) {
      keys = keys.append(st.keys[k]);
      tags = tags.append(tag);
    } else if (tags[at] != tag) {
      tags = tags.with(at, "");
    }
    k += 1;
  }
  let ok: string[] = [];
  let ot: string[] = [];
  let i = 0;
  while (i < keys.len()) {
    if (tags[i].len() > 0 && (tags[i] != "i32" || !is_unknown(st.width[lit_find(st, util.index_of_str(st.keys, keys[i]))]))) {
      ok = ok.append(keys[i]);
      ot = ot.append(tags[i]);
    }
    i += 1;
  }
  let (sk, stg) = lit_struct_tags(st);
  let (ook, oot) = open_rewrites(st, ok, ot);
  ok = ook;
  ot = oot;
  let ti = 0;
  while (ti < st.tkeys.len()) {
    ok = ok.append(st.tkeys[ti]);
    ot = ot.append(typeinfo.spelling(lit_typed_type(st.ttypes[ti], st, false)));
    ti += 1;
  }
  let si = 0;
  while (si < sk.len()) {
    ok = ok.append(sk[si]);
    ot = ot.append(stg[si]);
    si += 1;
  }
  let wi = 0;
  while (wi < st.wkeys.len()) {
    ok = ok.append(st.wkeys[wi]);
    ot = ot.append(st.wtags[wi]);
    wi += 1;
  }
  let call_keys = st.cargs;
  let call_tags = st.ctags;
  let ei = 0;
  while (ei < st.eargs.len()) {
    let width = st.width[lit_find(st, st.eids[ei])];
    if (!is_unknown(width)) {
      call_keys = call_keys.append(st.eargs[ei]);
      call_tags = call_tags.append(typeinfo.spelling(width));
    }
    ei += 1;
  }
  let (ck, ct) = agreed_tags(call_keys, call_tags);
  let ptypes: typeinfo.Type[] = [];
  for pt in st.ptypes {
    ptypes = ptypes.append(lit_typed_type(pt, st, false));
  }
  return LitRewrite { keys: ok, tags: ot, cargs: ck, ctags: ct, pargs: st.pargs, ptypes: ptypes };
}

function agreed_tags(keys: string[], tags: string[]): (string[], string[]) {
  let ok: string[] = [];
  let ot: string[] = [];
  let i = 0;
  while (i < keys.len()) {
    let at = util.index_of_str(ok, keys[i]);
    if (at < 0) {
      ok = ok.append(keys[i]);
      ot = ot.append(tags[i]);
    } else if (ot[at] != tags[i]) {
      ot = ot.with(at, "");
    }
    i += 1;
  }
  let rk: string[] = [];
  let rt: string[] = [];
  let j = 0;
  while (j < ok.len()) {
    if (ot[j].len() > 0) {
      rk = rk.append(ok[j]);
      rt = rt.append(ot[j]);
    }
    j += 1;
  }
  return (rk, rt);
}

function lit_suffix_spelled(tag: string): boolean {
  return tag == "i64" || tag == "u64" || tag == "u32" || tag == "u8";
}

function lit_rewrite_stmt(st: ast.Stmt, rw: LitRewrite): (ast.Stmt, LitRewrite, boolean) {
  match (st) {
    ast.StmtVar(v) => {
      if (v.type_name.len() > 0) {
        return (st, rw, false);
      }
      let at = util.index_of_str(rw.keys, lit_var_key(v));
      if (at < 0) {
        return (st, rw, false);
      }
      let (ie, ia, ih) = astwalk.map_expr_where(v.init, rw, lit_rewrite_stmt, lit_rewrite_expr, astwalk.every_expr);
      return (ast.StmtVar { ...v, type_name: rw.tags[at], init: ie }, rw, true);
    },
    ast.StmtFor(fr) => {
      if (!for_iter_is_range(fr.iter)) {
        return (st, rw, false);
      }
      let bounds = lit_range_bounds(fr.iter);
      let at2 = util.index_of_str(rw.keys, lit_for_key(fr, bounds[0]));
      if (at2 < 0 || !lit_suffix_spelled(rw.tags[at2])) {
        return (st, rw, false);
      }
      let tag = rw.tags[at2];
      let nb: ast.Expr[] = [];
      for bound in bounds {
        if (int_literal_tree(bound)) {
          nb = nb.append(settle_int_tree(bound, tag));
        } else {
          nb = nb.append(bound);
        }
      }
      let iter = fr.iter;
      if let ast.ExprCall(c) = fr.iter {
        iter = ast.ExprCall { ...c, args: nb };
      }
      let (body, ba) = astwalk.map_stmts_where(fr.body, rw, lit_rewrite_stmt, lit_rewrite_expr, astwalk.every_expr);
      return (ast.StmtFor { ...fr, iter: iter, body: body }, rw, true);
    },
    _ => {
      return (st, rw, false);
    }
  }
  return (st, rw, false);
}

function lit_rewrite_expr(e: ast.Expr, rw: LitRewrite): (ast.Expr, LitRewrite, boolean) {
  if (rw.cargs.len() == 0 && rw.pargs.len() == 0) {
    return (e, rw, false);
  }
  let at = util.index_of_str(rw.cargs, lit_float_key(e));
  if (at >= 0) {
    return (lit_float_read(e, parser.parse_type_ref(rw.ctags[at])), rw, true);
  }
  if let ast.ExprCall(c) = e {
    if (lit_call_settled(c, rw)) {
      return (lit_rewrite_call(c, rw), rw, true);
    }
  }
  return (e, rw, false);
}

function lit_float_read(e: ast.Expr, want: parser.TypeRef): ast.Expr {
  if (want.is_tuple) {
    let elems: ast.Expr[] = [];
    let i = 0;
    while (i < want.args.len()) {
      let part: ast.Expr = ast.ExprFieldAccess { obj: e, field: util.i32_to_string(i), line: expr_line(e), col: expr_col(e), ty: "", const_read: false };
      elems = elems.append(lit_float_read(part, want.args[i]));
      i += 1;
    }
    return ast.ExprTuple { elements: elems, line: expr_line(e), col: expr_col(e) };
  }
  if (want.base != "f32" && want.base != "f64") {
    return e;
  }
  if let ast.ExprNumber(n) = e {
    return ast.ExprNumber { ...n, is_float: true, bits: parser.literal_bits(n.text, true), suffix: want.base };
  }
  if let ast.ExprBinary(b) = e {
    return ast.ExprBinary { ...b, left: lit_float_read(b.left, want), right: lit_float_read(b.right, want), ty: want.base };
  }
  if let ast.ExprUnary(u) = e {
    if (u.op == "-" || u.op == "+") {
      return ast.ExprUnary { ...u, operand: lit_float_read(u.operand, want), ty: want.base };
    }
  }
  return ast.ExprUnary { op: "as_" + want.base, operand: e, line: expr_line(e), col: expr_col(e), ty: want.base };
}

function lit_call_settled(c: ast.ExprCall, rw: LitRewrite): boolean {
  let k = 0;
  while (k < c.args.len()) {
    if (util.index_of_str(rw.cargs, gcall_arg_key(c, k)) >= 0 || util.index_of_str(rw.pargs, gcall_arg_key(c, k)) >= 0) {
      return true;
    }
    k += 1;
  }
  return false;
}

function lit_rewrite_call(c: ast.ExprCall, rw: LitRewrite): ast.Expr {
  let args: ast.Expr[] = [];
  let k = 0;
  while (k < c.args.len()) {
    let a = c.args[k];
    let at = util.index_of_str(rw.cargs, gcall_arg_key(c, k));
    if (at >= 0) {
      a = settle_int_tree(a, rw.ctags[at]);
    }
    let pt = util.index_of_str(rw.pargs, gcall_arg_key(c, k));
    if (pt >= 0) {
      a = settle_wide_literals(a, rw.ptypes[pt]);
    }
    let (ae, aa, ah) = astwalk.map_expr_where(a, rw, lit_rewrite_stmt, lit_rewrite_expr, astwalk.every_expr);
    args = args.append(ae);
    k += 1;
  }
  let (ce, ca, ch) = astwalk.map_expr_where(c.callee, rw, lit_rewrite_stmt, lit_rewrite_expr, astwalk.every_expr);
  return ast.ExprCall { ...c, callee: ce, args: args };
}

struct LitScan { found: boolean, generics: string[] }

function lit_scan_stmt(st: ast.Stmt, own sc: LitScan): LitScan {
  if (sc.found || !lit_candidate_at(st) && !open_call_candidate(st, sc.generics)) {
    return sc;
  }
  return LitScan { ...sc, found: true };
}

function open_call_candidate(st: ast.Stmt, generics: string[]): boolean {
  let ast.StmtVar(v) = st else {
    return false;
  };
  let ast.ExprCall(c) = v.init else {
    return false;
  };
  let ast.ExprIdent(id) = c.callee else {
    return false;
  };
  return v.type_name.len() == 0 && !name_has_comma(v.name) && c.type_args.len() == 0 && util.has_str(generics, id.name);
}

function lit_scan_expr(e: ast.Expr, own sc: LitScan): LitScan {
  if (sc.found) {
    return sc;
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(cid) = c.callee {
      if (lit_any_int_literal(c.args) && util.has_str(sc.generics, cid.name)) {
        return LitScan { ...sc, found: true };
      }
    }
  }
  return sc;
}

function widened_array_tag(ea: ast.ExprArray, s: Scope): string {
  let at = check_expr(ea, s);
  if let typeinfo.TypeArray(ta) = at {
    if let typeinfo.TypeStruct(ts) = ta.elem {
      if (!reads_i64(ta.elem)) {
        return "";
      }
      for e in ea.elements {
        if (struct_lit_gives_way(e, check_expr(e, s), ta.elem, s)) {
          return typeinfo.spelling(at);
        }
      }
    }
  }
  return "";
}

function lit_holds_int_literal(e: ast.Expr): boolean {
  if (int_literal_tree(e) || float_literal_tree(e)) {
    return true;
  }
  if let ast.ExprArray(ea) = e {
    return lit_holds_any(ea.elements);
  }
  if let ast.ExprTuple(et) = e {
    return lit_holds_any(et.elements);
  }
  if let ast.ExprStructLit(sl) = e {
    return lit_holds_any(sl.field_values);
  }
  if let ast.ExprCall(c) = e {
    return lit_holds_any(c.args) || unsettled_value_block(c, [], 0, []);
  }
  return false;
}

function lit_holds_any(es: ast.Expr[]): boolean {
  for e in es {
    if (lit_holds_int_literal(e)) {
      return true;
    }
  }
  return false;
}

function lit_any_int_literal(args: ast.Expr[]): boolean {
  for a in args {
    if (int_literal_tree(a)) {
      return true;
    }
  }
  return false;
}

function generic_fn_names(funcs: parser.FuncDecl[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    if (fd.receiver_name.len() == 0 && (fd.type_params.len() > 0 || fd.all_type_params.len() > 0)) {
      out = out.append(fd.name);
    }
  }
  return out;
}

function lit_candidate_at(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtMatch(m) => {
      return lit_holds_int_literal(m.scrutinee);
    },
    ast.StmtVar(v) => {
      if (v.type_name.len() > 0 || name_has_comma(v.name)) {
        return false;
      }
      return lit_holds_int_literal(v.init) || names_unit_variant(v.init);
    },
    ast.StmtFor(fr) => {
      if (!for_iter_is_range(fr.iter)) {
        return false;
      }
      let bounds = lit_range_bounds(fr.iter);
      return int_literal_tree(bounds[0]) || int_literal_tree(bounds[1]);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// A capitalised name, alone, as an argument or as an element, can be a unit variant whose
// type arguments come from a later use. A variant of another module has
// that module's prefix, as `tree__Empty`.
function variant_shaped(name: string): boolean {
  let at = 0;
  for i in 1..name.len() {
    if (name[i - 1] == b'_' && name[i] == b'_') {
      at = i + 1;
    }
  }
  return at < name.len() && name[at] >= b'A' && name[at] <= b'Z';
}

function names_unit_variant(e: ast.Expr): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return variant_shaped(id.name);
    },
    ast.ExprCall(c) => {
      for a in c.args {
        if let ast.ExprIdent(id) = a {
          if (variant_shaped(id.name)) {
            return true;
          }
        }
      }
      return false;
    },
    ast.ExprArray(a) => {
      return any_names_unit_variant(a.elements);
    },
    ast.ExprTuple(t) => {
      return any_names_unit_variant(t.elements);
    },
    _ => {
      return false;
    }
  }
}

function any_names_unit_variant(es: ast.Expr[]): boolean {
  for el in es {
    if (names_unit_variant(el)) {
      return true;
    }
  }
  return false;
}

function needs_lit_settle(stmts: ast.Stmt[], generics: string[]): boolean {
  let sc = LitScan { found: false, generics: generics };
  for stmt in stmts {
    sc = astwalk.fold_stmt_nodes(stmt, sc, lit_scan_stmt, lit_scan_expr, astwalk.descend_all);
  }
  return sc.found;
}

function lit_resolve_pending(st: LitInfer): LitInfer {
  let out = st;
  let i = 0;
  while (i < st.pend.len()) {
    let w = out.width[lit_find(out, st.pend_id[i])];
    if (!is_unknown(w)) {
      out = demand_open(st.pend[i], w, st.pend_scope[i], out);
    }
    i += 1;
  }
  return out;
}

function settle_lit_body(stmts: ast.Stmt[], s: Scope): ast.Stmt[] {
  let st = lit_resolve_pending(lit_stmts(stmts, s, LitInfer { parent: [LIT_WIDE], width: [t_i64()], keys: [""], cargs: [], ctags: [], pend: [], pend_id: [], pend_scope: [], skeys: [], snames: [], sfirst: [], sargs: [], sids: [], wkeys: [], wtags: [], eargs: [], eids: [], tkeys: [], ttypes: [], pargs: [], ptypes: [], okeys: [], otypes: [], ofills: [] }));
  let rw = lit_rewrites(st);
  if (rw.keys.len() == 0 && rw.cargs.len() == 0 && rw.pargs.len() == 0) {
    return stmts;
  }
  let (out, ra) = astwalk.map_stmts_where(stmts, rw, lit_rewrite_stmt, lit_rewrite_expr, astwalk.every_expr);
  return out;
}

pub function settle_literal_locals(mod: parser.Module): parser.Module {
  let generics = generic_fn_names(mod.funcs);
  let any = needs_lit_settle(mod.top_stmts, generics);
  for fd in mod.funcs {
    if (!any && needs_lit_settle(fd.body, generics)) {
      any = true;
    }
  }
  if (!any) {
    return mod;
  }
  return settle_literal_locals_in(mod, module_env(mod), whole_focus(mod));
}

function settle_literal_locals_in(mod: parser.Module, env: ModuleEnv, focus: Focus): parser.Module {
  let generics = generic_fn_names(mod.funcs);
  let nfuncs: parser.FuncDecl[] = [];
  let k = 0;
  for func in mod.funcs {
    let hit = focus.funcs[k] && needs_lit_settle(func.body, generics);
    k += 1;
    if (hit) {
      let fs = build_func_scope(func, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
      nfuncs = nfuncs.append(parser.FuncDecl { ...func, body: settle_lit_body(func.body, fs) });
    } else {
      nfuncs = nfuncs.append(func);
    }
  }
  let ntop = mod.top_stmts;
  if (focus.top && needs_lit_settle(mod.top_stmts, generics)) {
    ntop = settle_lit_body(mod.top_stmts, new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs));
  }
  return parser.Module { ...mod, funcs: nfuncs, top_stmts: ntop };
}

function scalar_numeric_join(a: typeinfo.Type, b: typeinfo.Type): typeinfo.Type {
  if (typeinfo.lossless_widen(a, b)) {
    return b;
  }
  if (typeinfo.lossless_widen(b, a)) {
    return a;
  }
  return typeinfo.mixed_integer_join(a, b);
}

function unknown_arm_expr(e: ast.Expr): boolean {
  if let ast.ExprUnknown(_) = e {
    return true;
  }
  return false;
}

function lit_kind_settled(e: ast.Expr): boolean {
  return numeric_literal_kind(e) == 0;
}

function array_element_preferred(e: ast.Expr, t: typeinfo.Type, lit: i32, first_expr: ast.Expr, first: typeinfo.Type, first_lit: i32, s: Scope): boolean {
  return !vaguer_than(t, first) && !literal_gives_way(lit, first) && !struct_lit_gives_way(e, t, first, s)
    && (same_element_type(t, first) || literal_gives_way(first_lit, t))
    || struct_lit_gives_way(first_expr, first, t, s) || nested_array_gives_way(first_expr, first, t, s);
}

function nested_array_gives_way(e: ast.Expr, from: typeinfo.Type, to: typeinfo.Type, s: Scope): boolean {
  if let ast.ExprArray(_) = e {
    return vaguer_than(from, to) && array_mix_settles(e, from, to, s);
  }
  return false;
}

function binary_numeric_join(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): typeinfo.Type {
  if (is_integer(lt) && is_integer(rt) && (int_literal_tree(b.left) || int_literal_tree(b.right))) {
    return int_result(lt, rt, b.left, b.right);
  }
  return scalar_numeric_join(lt, rt);
}

function widen_binary_operand(e: ast.Expr, from: typeinfo.Type, to: typeinfo.Type, line: i32, col: i32): ast.Expr {
  if (!int_literal_tree(e) && !is_unknown(to) && typeinfo.lossless_widen(from, to)) {
    return ast.ExprUnary { op: "as_" + typeinfo.spelling(to), operand: e, line: line, col: col, ty: type_to_irtag(to) };
  }
  return e;
}

function scalar_vb_joinable(a: VbStore, b: VbStore, scalar: typeinfo.Type): boolean {
  return !is_unknown(scalar) && scalar_arms_settled(a, b) && (!unknown_arm_expr(a.e) || !unknown_arm_expr(b.e));
}

function scalar_value_widens(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  return (is_integer(want) || is_float(want)) && typeinfo.lossless_widen(check_expr(e, s), want);
}

function scalar_arms_settled(a: VbStore, b: VbStore): boolean {
  return !arm_unsettled(a) && !arm_unsettled(b);
}
