  let stmts3 = parser.parse_program(toks3);
  let pt3 = check_program(stmts3);
  if (pt3.tys.len() != 3) {
    return 30;
  }
  if (!is_unknown(pt3.tys[0])) {
    return 31;
  }
  if (!type_eq(pt3.tys[1], t_i32())) {
    return 32;
  }
  if (!type_eq(pt3.tys[2], t_i32())) {
    return 33;
  }

  let src4 = "let f = true && false; let g = (1 < 2) || f;";
  let toks4 = lexer.tokenize(src4);
  let stmts4 = parser.parse_program(toks4);
  let pt4 = check_program(stmts4);
  if (pt4.tys.len() != 2) {
    return 40;
  }
  if (!type_eq(pt4.tys[0], t_bool())) {
    return 41;
  }
  if (!type_eq(pt4.tys[1], t_bool())) {
