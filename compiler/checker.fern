// builtin_row is `name`'s row of builtin_sigs(), or "" when no surface builtin
// has that name. `(` sorts below every byte of a name, so the first row not
// below `name(` is the one that starts with it, if any does.
function builtin_row(name: string): string {
  let rows: string[] = builtin_sigs();
  let head: string = name + "(";
  let lo: i32 = 0;
  let hi: i32 = rows.len();
  while (lo < hi) {
    let mid: i32 = (lo + hi) / 2;
    if (util.str_less(rows[mid], head)) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  if (lo < rows.len() && util.str_has_prefix(rows[lo], head)) {
    return rows[lo];
  }
  return "";
}

// builtin_sig is `name`'s signature from builtin_sigs() as a TypeFunc, or
// unknown when no surface builtin has that name.
pub function builtin_sig(name: string): typeinfo.Type {
  let row: string = builtin_row(name);
  if (row.len() == 0) {
    return t_unknown("not a builtin: " + name);
  }
  let close: i32 = util.index_of_sub(row, "): ");
  let inner: string = slice_unchecked(row, name.len() + 1, close) + "";
  let params: typeinfo.Type[] = [];
  if (inner.len() > 0) {
    for p in parser.split_top_commas(inner) {
      params = params.append(type_from_name(p));
    }
  }
  return t_func(params, type_from_name(slice_unchecked(row, close + 3, row.len()) + ""));
}

// builtin_method_sig is a builtin method's callable without its receiver, or
// unknown when `recv_name` has no builtin method `name`.
pub function builtin_method_sig(recv_name: string, name: string): typeinfo.Type {
  if let typeinfo.TypeFunc(bm) = builtin_sig("__method_" + recv_name + "_" + name) {
    let params: typeinfo.Type[] = [];
    let i: i32 = 1;
    while (i < bm.param_types.len()) {
      params = params.append(bm.param_types[i]);
      i = i + 1;
    }
    return t_func(params, bm.ret_type);
  }
  return t_unknown("not a builtin method: " + recv_name + "." + name);
}

function undeclared_call_type(name: string, s: Scope, args: ast.Expr[]): typeinfo.Type {
  if let typeinfo.TypeFunc(bf) = builtin_sig(name) {
    if (bf.param_types.len() == args.len()) {
      return bf.ret_type;
    }
  }
  let body: string = parser.mkclo_body(name);
  let at: i32 = 0 - 1;
  if (body.len() > 0) {
    at = s.sig_at(body);
  }
  if (at < 0) {
    return t_unknown("undefined function: " + name);
  }
  let sig: FuncSig = s.sigs.sigs[at];
  if (!closure_env_param(sig)) {
    return t_unknown("undefined function: " + name);
  }
  return t_func_after_env(sig);
}

// A hoisted closure body reads its captures through a leading `__env` array of
// machine words; a declaration without one is not a body a box was built for.
function closure_env_param(sig: FuncSig): boolean {
  if (sig.param_types.len() == 0) {
    return false;
  }
  if let typeinfo.TypeArray(a) = sig.param_types[0] {
    if let typeinfo.TypeI32(_) = a.elem {
      return true;
    }
  }
  return false;
}

// The type the box hands out: the body's signature without its environment.
function t_func_after_env(sig: FuncSig): typeinfo.Type {
  let params: typeinfo.Type[] = [];
  let owns: boolean[] = [];
  let i: i32 = 1;
  while (i < sig.param_types.len()) {
    params = params.append(sig.param_types[i]);
    owns = owns.append(i < sig.param_own.len() && sig.param_own[i]);
    i = i + 1;
  }
  return t_func_own(params, owns, sig.ret_type);
}

// check_call_expr types an ExprCall (plain / closure / method call).
// Extracted verbatim from check_expr's ExprCall arm to keep check_expr
// under the self-host oversized-function compile threshold (#2720); the
// body is self-contained on c + s.
// builtin_ctor_type types `Some(x)` as `Option[type of x]`, so a match on the
// value types its payload. Result constructors retain the argument their
// payload determines and leave the other position open for context.
function inferred_payload(e: ast.Expr, s: Scope): typeinfo.Type {
  return unsettled_marked(check_expr(e, s), e, s.lit_locals, true);
}

// Only an uncommitted literal can change a known enum argument's width.
// This conversion is lossless at either width and never crosses signedness.
function integer_literal_widens(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(a) = from {
    if let typeinfo.TypeI32(b) = to {
      return a.polymorphic && !a.is_char && !b.is_char && a.unsigned == b.unsigned
        && a.width > 0 && a.width < b.width;
    }
  }
  return false;
}

function builtin_ctor_type(en: string, name: string, c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (name == "Some" && c.args.len() == 1) {
    return t_union_g(en, [inferred_payload(c.args[0], s)]);
  }
  if (name == "Ok" && c.args.len() == 1) {
    return t_union_g(en, [inferred_payload(c.args[0], s), t_unknown("unbound E")]);
  }
  if (name == "Err" && c.args.len() == 1) {
    return t_union_g(en, [t_unknown("unbound T"), inferred_payload(c.args[0], s)]);
  }
  return t_union(en);
}

// A `Map { k: v }` literal desugars to a `map_new(n).insert(k, v)` chain with
// no columns; its entries name them, as native types the literal. A written
// `map_new(n).insert(…)` keeps them unresolved.
function literal_insert_columns(c: ast.ExprCall, mt: typeinfo.TypeMap, recv_ty: typeinfo.Type, s: Scope): typeinfo.Type {
  if (!literal_insert(c) || !is_unknown(mt.key) && !is_unknown(mt.value)) {
    return recv_ty;
  }
  let ik: typeinfo.Type = mt.key;
  let iv: typeinfo.Type = mt.value;
  if (is_unknown(ik)) {
    ik = check_expr(c.args[0], s);
  }
  if (is_unknown(iv)) {
    iv = check_expr(c.args[1], s);
  }
  return t_map(ik, iv);
}

// receiver_key is the receiver type name a method on a value of type `t` is
// looked up under (lookup_method), or "" when `t` names no receiver type. A
// primitive is keyed by its type keyword; an enum or struct-union by the
// union's own name, its generic arguments dropped, the way the lowering keys
// `<Union>.<method>`.
pub function receiver_key(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeStruct(sn) => {
      return sn.name;
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeMap(_) => {
      return "Map";
    },
    typeinfo.TypeUnion(un) => {
      return un.name;
    },
    typeinfo.TypeLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function check_call_expr(c: ast.ExprCall, s: Scope): typeinfo.Type {
  // A desugared value if/match-expression is a 0-arg call of a
  // 0-param lambda whose single-statement body is a StmtIf / StmtMatch
  // returning each branch's value. Its value type is the branches'
  // common type. Return it (instead of `unknown`) so assignment /
  // return / argument checks see the real type — closing E003/E002
  // on `let x: string = if (…) { 1 } else { 2 }` and the match form.
  // Arm-type *consistency* itself is E031, checked separately.
  if (c.args.len() == 0) {
    match (c.callee) {
      ast.ExprLambda(lm) => {
        if (lm.params.len() == 0 && lm.body.len() == 1) {
          let bts: typeinfo.Type[] = [];
          match (lm.body[0]) {
            ast.StmtIf(f) => {
              bts = mx_if_branch_types(f, s);
            },
            ast.StmtMatch(m) => {
              bts = mx_match_arm_types(m, s);
            },
            _ => {}
          }
          if (bts.len() > 0) {
            let result: typeinfo.Type = vb_arms_unified(bts, mx_body_result_exprs(lm.body));
            if (!is_unknown(result)) {
              return result;
            }
            // The arms disagree. Past an E031 the block has the type of the
            // arms joined before the one that failed, as native's does. A
            // literal prefix still settles at a numeric destination. Arms
            // that merely differ in width have settled to the lambda's tag —
            // the binding's annotation stamped on the block — all but the one
            // that could not, and that arm is the block's type for the
            // destination compare; reading the tag would pass the block as
            // its own annotation.
            if (parser.is_value_block_origin(lm.origin)) {
              let arms: ast.Expr[] = mx_body_result_exprs(lm.body);
              let fold: MxFold = vb_arms_fold(bts, arms, s);
              if (is_unknown(fold.acc.t)) {
                return t_unknown("value block arms disagree");
              }
              if (!fold.ok) {
                return fold.acc.t;
              }
              let tag: typeinfo.Type = lambda_ret_type(lm, s);
              let bi: i32 = 0;
              while (bi < bts.len() && bi < arms.len()) {
                if (!arm_int_literal(arms[bi]) && !is_unknown(bts[bi]) && !type_eq(bts[bi], tag)) {
                  return bts[bi];
                }
                bi = bi + 1;
              }
            }
          }
        }
        // The tuple / struct / nested-pattern desugars carry the value in a
        // LOCAL instead of arm `return`s, so their body is the three-statement
        // value block and the arm types are the stores into that local. Left
        // untyped, an unannotated `let got = match (t) { (q, n) => q }` sized
        // its slot from a structural walk that cannot see into the block, and a
        // string went into an i32 slot with no diagnostic.
        let vlocal: string = vb_local_name(lm.body);
        if (lm.params.len() == 0 && vlocal.len() > 0) {
          return vb_store_type(lm.body, vlocal, s);
        }
        if (lm.params.len() == 0 && lm.origin == parser.ORIGIN_BLOCK) {
          return value_block_tail_type(lm.body, s);
        }
      },
      _ => {}
    }
  }
  // Bare-ident callee → plain function call.
  // FieldAccess callee → method call: type-check the
  // receiver, look up the method by (name, recv_type).
  let name: string = "";
  let is_method: boolean = false;
  let recv_type_name: string = "";
  // Overwritten by the receiver's own type on every path that reads it; the
  // label is never compared, so this only has to be "unknown".
  let recv_ty: typeinfo.Type = t_unknown("");
  match (c.callee) {
    ast.ExprIdent(id) => {
      name = id.name;
    },
    ast.ExprFieldAccess(fa) => {
      // Qualified-name call: `Ns.func(…)` resolves
      // to a plain function named "Ns.func" when
      // such a sig exists. Otherwise fall through
      // to method-dispatch semantics.
      let qhandled: boolean = false;
      match (fa.obj) {
        ast.ExprIdent(ns_id) => {
          let qname: string = ns_id.name + "." + fa.field;
          if (s.has_sig(qname)) {
            name = qname;
            qhandled = true;
          }
        },
        _ => {}
      }
      // A qualified variant constructor `W.Wrap(1)` types to its enum,
      // exactly as the bare `Wrap(1)` does below (#6657). Without this it
      // fell through to method dispatch, typed to unknown, and the
      // destination check silently under-reported.
      if (!qhandled) {
        let cqu: string = qual_variant_union(fa, s);
        if (cqu.len() > 0) {
          return variant_ctor_type(s, cqu, fa.field, c);
        }
      }
      // An ASSOCIATED (receiver-less) call on a TYPE — `i32.zero()`, or
      // `T.zero()` through a bounded type parameter (#6933). There is no
      // receiver value to dispatch on, so it must be typed from the trait
      // requirement before the method path reads the object as a value and
      // returns unknown. `T` gives the type variable, a concrete type the real
      // type.
      if (!qhandled) {
        let ah: AssocHit = assoc_call_req(fa.obj, fa.field, s, fa.const_read);
        if (ah.found) {
          // An inherent impl's associated function has no trait requirement to
          // read its return from, so it is typed from its own declaration.
          if (ah.ret.len() == 0) {
            if let ast.ExprIdent(aoid) = fa.obj {
              let asig: FuncSig = s.lookup_assoc_sig(aoid.name, fa.field);
              if (asig.name.len() > 0) {
                return sig_call_type(asig, fa.field, c, s);
              }
            }
          }
          return assoc_hit_type(ah, fa.obj, s);
        }
      }
      if (!qhandled) {
        name = fa.field;
        is_method = true;
        recv_ty = check_expr(fa.obj, s);
        // Array method-syntax dispatch: `a.<field>(...)` on an
        // array resolves to its array-receiver method's return type
        // (or the built-in append/with growers).
        // Done ahead of the recv_type_name match below because an
        // array receiver has no nominal type-name and would
        // otherwise fall into the `_` "isn't a typed value" arm.
        let arr_mt: typeinfo.Type = s.array_method_ret_type(c, recv_ty, name);
        if (!is_unknown(arr_mt)) {
          return arr_mt;
        }
        recv_type_name = receiver_key(recv_ty);
        if (recv_type_name.len() == 0) {
          if let typeinfo.TypeDyn(d) = recv_ty {
            return dyn_method_type(d.traits, name, s);
          }
          match (bound_method(s, tp_receiver(recv_ty, s), name)) {
            Some(msig) => {
              return generic_method_ret(c, msig, method_binding(c, msig, recv_ty, s), s);
            },
            None => {}
          }
          // `t.0()` — a numeric field access whose element is a fn value is
          // a call THROUGH that value, not a method on the tuple.
          let tvr: typeinfo.Type = call_through_fn_value(c, s);
          if (!is_unknown(tvr)) {
            return tvr;
          }
          return t_unknown("method call: receiver isn't a typed value");
        }
      }
    },
    _ => {
      return call_through_fn_value(c, s);
    }
  }
  // map_new(cap) builtin — returns a TypeMap with
  // TypeUnknown key/value types since the call site
  // has no inference for them. The surrounding
  // type-annotation (e.g. `let m: Map[K, V] = …`)
  // pins them via assignability.
  if (!is_method && is_map_new_name(name)) {
    return t_map(t_unknown(MAP_NEW_KEY), t_unknown(MAP_NEW_VALUE));
  }
  // cell_new(v) builtin — the Cell[T] constructor
  // (docs/CELL-TYPE-PLAN.md). T is the argument's type; the
  // result is modelled as a nominal `Cell` struct handle. Typing
  // it (rather than leaving it unknown) lets a nested
  // `cell_new(cell_new(x))` see the inner cell as a composite
  // element, which is the E057 case the call-diag walk flags.
  if (!is_method && name == "cell_new") {
    return t_struct("Cell");
  }
  // print/eprint yield no value (TypeVoid). Leaving them unknown made every
  // printing function trip the #9053 catch-all under -check (#7311). Arity
  // is call_diags' E004 rule; a wrong count here stays unknown.
  if (!is_method && (name == "print" || name == "eprint") && c.args.len() == 1) {
    return t_void();
  }
  // target_os() / target_arch(): the two halves of the compile target's
  // name, each a string. The compile path folds the calls to literals before
  // emit (constfold.fold_target_name); -check keeps them, so they are typed
  // here as native's FuncSigs types them.
  if (!is_method && (name == "target_os" || name == "target_arch") && c.args.len() == 0) {
    return t_string();
  }
  // slice_unchecked(s, a, b) builtin — the byte slice s[a:b] under its
  // accurate name (#5634). Returns the borrowed `str` view, as native does
  // (#7293), so an owning sink refuses it without .to_owned().
  if (!is_method && name == "slice_unchecked") {
    if (c.args.len() != 3) {
      return t_unknown("slice_unchecked takes 3 arguments");
    }
    let sut: typeinfo.Type = check_expr(c.args[0], s);
    if (!is_integer(check_expr(c.args[1], s)) || !is_integer(check_expr(c.args[2], s))) {
      return t_unknown("slice_unchecked bounds must be i32");
    }
    match (sut) {
      typeinfo.TypeString(_) => {
        return t_str();
      },
      _ => {}
    }
    return t_unknown("slice_unchecked: first argument must be a string");
  }
  let builtin_typed: typeinfo.Type = builtin_result_type(recv_ty, name, is_method, c.args.len(), s);
  if (!is_unknown(builtin_typed)) {
    return builtin_typed;
  }
  // `s.len()` — the method spelling of the `len(s)` builtin above. It
  // resolves through the user MethodSig table, which has no entry for a
  // primitive receiver, so the statement types unknown. An unknown
  // statement type makes check_func_body mark the module ill-typed
  // while the coded passes stay silent, so the whole class surfaced as
  // the uncoded "cannot represent yet" bail instead of a real
  // diagnostic (#9053's catch-all). The array receiver is typed in
  // array_method_ret_type and Map in its own arm below.
  if (is_method && name == "len" && c.args.len() == 0) {
    match (recv_ty) {
      typeinfo.TypeString(_) => {
        return t_i32();
      },
      _ => {}
    }
  }
  // `s.as_bytes()` — the string's other builtin (registerStringMethod's
  // sibling of `len` above): a `[u8]` view of the bytes.
  if (is_method && name == "as_bytes" && c.args.len() == 0) {
    match (recv_ty) {
      typeinfo.TypeString(_) => {
        return t_view(t_u8());
      },
      _ => {}
    }
  }
  // Built-in VMap method dispatch — handled ahead of
  // the user MethodSig lookup.
  if (is_method) {
    recv_ty = map_method_receiver(c, recv_ty);
    match (recv_ty) {
      typeinfo.TypeMap(mt) => {
        if (name == "insert") {
          if (c.args.len() != 2) {
            return t_unknown("map.insert: 2 args");
          }
          return literal_insert_columns(c, mt, recv_ty, s);
        }
        if (name == "get_or") {
          if (c.args.len() != 2) {
            return t_unknown("map.get_or: 2 args");
          }
          return mt.value;
        }
        if (name == "get" && c.args.len() == 1) {
          return t_union_g("Option", [mt.value]);
        }
        if (name == "contains") {
          if (c.args.len() != 1) {
            return t_unknown("map.contains: 1 arg");
          }
          return t_bool();
        }
        if (name == "remove") {
          if (c.args.len() != 1) {
            return t_unknown("map.remove: 1 arg");
          }
          return recv_ty;
        }
        if (name == "len") {
          if (c.args.len() != 0) {
            return t_unknown("map.len: 0 args");
          }
          return t_i32();
        }
        if (name == "keys") {
          return t_array(mt.key);
        }
        if (name == "values") {
          return t_array(mt.value);
        }
        if (name == "iter" && c.args.len() == 0) {
          return t_struct_g("MapIter", [mt.key, mt.value]);
        }
        // `cleared` returns the receiver's own Map type. Its absence did not
        // read as a missing method: the dispatch fell through to the user
        // MethodSig lookup, which types the call `unknown` — so
        // `let c = m.cleared()` lost its Map tag, `c.len()` mis-dispatched off
        // the map path, and the answer came back as a buffer figure (56 for a
        // two-entry map) rather than 0, with no diagnostic (#9038).
        if (name == "cleared") {
          if (c.args.len() != 0) {
            return t_unknown("map.cleared: 0 args");
          }
          return recv_ty;
        }
      },
      typeinfo.TypeStruct(it) => {
        // The MapIter cursor Map.iter() hands out (native registerMapIterMethod).
        if (it.name == "MapIter" && it.args.len() == 2 && c.args.len() == 0 && is_map_iter_method(name)) {
          if (name == "has_next") {
            return t_bool();
          }
          if (name == "key") {
            return it.args[0];
          }
          if (name == "value") {
            return it.args[1];
          }
          if (name == "advance") {
            return t_void();
          }
        }
      },
      _ => {}
    }
    let msig: MethodSig = s.lookup_method(name, recv_type_name);
    if (msig.name.len() == 0) {
      if let typeinfo.TypeFunc(bm) = builtin_method_sig(recv_type_name, name) {
        if (bm.param_types.len() == c.args.len()) {
          return bm.ret_type;
        }
      }
      // A closure-FIELD call `h.f(args)`: no method `f`, but the struct
      // declares a fn-typed field `f` — the call yields the field's return,
      // as the receiver's instantiation reads it (#5986). The arguments are
      // call_diags' to check against the same field type.
      if let typeinfo.TypeStruct(cfsn) = recv_ty {
        if let typeinfo.TypeFunc(cff) = struct_field_type(cfsn, name, s) {
          return cff.ret_type;
        }
      }
      return t_unknown("undefined method `" + name + "` on `" + recv_type_name + "`");
    }
    if (c.args.len() != msig.param_types.len()) {
      return t_unknown("arity mismatch calling method `" + name + "`");
    }
    // A signature spelling one of the receiver's type parameters (`function
    // (b: Box[T]) get(): T`, `function (o: Option[T]) unwrap_or(fallback: T):
    // T`, or a nested `T[]`) resolves it to `unknown` at collect time. On a
    // concrete instantiation (`Box[i32]`, `Option[string]`) those parameters
    // are bound to the receiver's arguments throughout the parameter and
    // return spellings (#4346 piece 2); what stays unresolved is not checked.
    return generic_method_ret(c, msig, method_binding(c, msig, recv_ty, s), s);
  }
  // If the ident is bound in scope to a TypeFunc,
  // dispatch as a closure call rather than a plain
  // function lookup. Otherwise fall through to the
  // function-sig table.
  let bound_at: i32 = s.binding_index(name);
  if (bound_at >= 0) {
    if let typeinfo.TypeFunc(tf) = s.types[bound_at] {
      // An unrecorded param list says nothing about the call, so a binding
      // taken from a fn-typed struct field (`let h = obj.f; h(2)`) types to
      // the declared return rather than collapsing to unknown.
      if (!tf.params_known) {
        return tf.ret_type;
      }
      if (c.args.len() != tf.param_types.len()) {
        return t_unknown("arity mismatch calling closure `" + name + "`");
      }
      return tf.ret_type;
    }
  }
  // Variant constructors (#4346 piece 2): `Some(x)` / `Ok(x)` / `Err(e)`
  // (and a user enum's payload variant `A(x)`) aren't functions — they
  // construct their enum. Type the call to the enum's name-only union so
  // `let o: Option[i32] = Some(3);` type-checks. A DECLARED enum/union in
  // scope wins over the builtin table, so a user enum that reuses a builtin
  // variant name (`enum E { Ok(i32), … }`) types `Ok(1)` as `E`, not
  // `Result`. Arity / payload-type errors belong to variant_ctor_diags;
  // here we only supply the value type.
  //
  // A BINDING of the variant's name shadows the constructor, so the call is a
  // call of that value — `let Wrap = 3; Wrap(1)` is native E038 (calling a
  // non-function), not a `W`. Without this the call typed to the enum and the
  // error surfaced somewhere else entirely, as an E002 return mismatch (a
  // TypeFunc binding is already dispatched as a closure call above; this is
  // every other bound type). #6658. A top-level function of the name shadows
  // it the same way, and the call types to that function's return.
  let ctor_shadowed: boolean = ctor_name_taken(c, s);
  if (!ctor_shadowed && s.variant_ambiguous(name)) {
    return t_unknown("ambiguous variant `" + name + "`");
  }
  let ctor_user: string = "";
  if (!ctor_shadowed) {
    ctor_user = union_of_variant(name, s.unions);
  }
  if (ctor_user.len() > 0) {
    return variant_ctor_type(s, ctor_user, name, c);
  }
  let ctor_enum: string = "";
  if (!ctor_shadowed) {
    ctor_enum = parser.builtin_enum_of(name);
  }
  if (ctor_enum.len() > 0) {
    return builtin_ctor_type(ctor_enum, name, c, s);
  }
  let at: i32 = s.sig_at(name);
  if (at < 0) {
    return undeclared_call_type(name, s, c.args);
  }
  return sig_call_type(s.sigs.sigs[at], name, c, s);
}

// sig_call_type types a call of the function `sig` describes: its arity and
// argument types, then its return, with a generic one's type variables bound
// from the arguments. `name` is what a refusal names.
function sig_call_type(sig: FuncSig, name: string, c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (c.args.len() != sig.param_types.len()) {
    return t_unknown("arity mismatch calling `" + name + "`");
  }
  let bn: string[] = [];
  let bt: typeinfo.Type[] = [];
  if (sig.all_type_params.len() > 0) {
    let (names, types) = call_type_bindings(sig, c, s);
    bn = names;
    bt = types;
  }
  // Generic-call return-type inference (#4346 piece 2): a generic function's
  // declared return type erases to unknown here (it names a type parameter).
  // When the return type NAME also names a parameter's type — the pervasive
  // `ident[T](v: T): T`, `first[T, U](a: T, b: U): T` shape — the concrete
  // return is that argument's type. Without this a non-generic caller of a
  // generic function over-rejected on the unknown result (`return ident(3);`).
  // (A return type param that appears only nested — `Option[T]` — or in no
  // parameter isn't inferred here and stays unknown, a further slice.)
  if (sig.all_type_params.len() > 0 && is_unknown(sig.ret_type) && sig.ret_type_name.len() > 0) {
    let (rtv, rtv_bound) = ret_typevar_arg_type(sig, c, s);
    if (rtv_bound) {
      return rtv;
    }
  }
  return inferred_sig_ret(sig, c, s, bn, bt);
}

// Erased return variables can survive inside containers even when the callee
// no longer declares them; bind those from its arguments before substitution.
function inferred_sig_ret(sig: FuncSig, c: ast.ExprCall, s: Scope, names: string[], types: typeinfo.Type[]): typeinfo.Type {
  let bn: string[] = names;
  let bt: typeinfo.Type[] = types;
  if (type_contains_unknown(sig.ret_type) && sig.ret_type_name.len() > 0) {
    if (sig.all_type_params.len() == 0) {
      let (names, types) = call_type_bindings(sig, c, s);
      bn = names;
      bt = types;
    }
    // A declared type parameter no argument bound stays a VARIABLE in the
    // substitution. Resolving it by name instead would find a same-named
    // declared type and hand the call site a concrete result it never had.
    for tp in sig.type_params {
      if (util.index_of_str(bn, tp) < 0) {
        bn = bn.append(tp);
        bt = bt.append(t_unknown(TPARAM_MARK + tp));
      }
    }
    if (bn.len() > 0 && util.contains(sig.ret_type_name, "::")) {
      let pty: typeinfo.Type = projected_ret(sig.ret_type_name, bn, bt, s);
      if (!type_contains_unknown(pty)) {
        return pty;
      }
    }
    if (bn.len() > 0) {
      let gsubst: typeinfo.Type = type_from_ref_subst(sig_ret_ref(sig), bn, bt, s.type_names());
      if (!type_contains_unknown(gsubst)) {
        return gsubst;
      }
    }
  }
  return sig.ret_type;
}

// arg_bindings binds a generic call's type variables from its written type
// arguments, then from its typed arguments, then from its integer literal
// arguments; an earlier binding wins.
function arg_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let (wn, wt) = written_type_bindings(sig, c, s);
  let (tn, tt) = bind_from_args(sig, c, s, false, wn, wt);
  return bind_from_args(sig, c, s, true, tn, tt);
}

// bind_from_args binds type variables from the arguments that are integer
// literal trees (`literals`) or from the rest.
function bind_from_args(sig: FuncSig, c: ast.ExprCall, s: Scope, literals: boolean, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  let bn: string[] = names;
  let bt: typeinfo.Type[] = types;
  let i: i32 = 0;
  while (i < sig.param_type_names.len() && i < c.args.len()) {
    if (int_literal_tree(c.args[i]) == literals && !binds_nothing(c.args[i], s)) {
      let (bn2, bt2) = gc_bind_param(sig_param_ref(sig, i), check_expr(c.args[i], s), sig.type_params, s.type_names(), bn, bt);
      bn = bn2;
      bt = bt2;
    }
    i = i + 1;
  }
  return (bn, bt);
}

// A bound's integer type can settle an integer literal, but a different kind
// cannot: `C[string]` must not turn the argument `5` into a string. Recompute
// the bounds from the argument seeds after choosing the literal widths.
function call_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let (wn, wt) = written_type_bindings(sig, c, s);
  let (tn, tt) = bind_from_args(sig, c, s, false, wn, wt);
  let (bn, bt) = bound_bindings(sig, s, tn, tt);
  let (ln, lt) = bind_from_args(sig, c, s, true, tn, tt);
  let i: i32 = tn.len();
  while (i < ln.len()) {
    let bi: i32 = util.index_of_str(bn, ln[i]);
    if (bi >= 0 && is_integer(lt[i]) && is_integer(bt[bi])) {
      lt = lt.with(i, bt[bi]);
    }
    i = i + 1;
  }
  return bound_bindings(sig, s, ln, lt);
}

// written_type_bindings binds each type parameter to the type argument written
// in its position (`f[i32](x)`). A list of the wrong length is E040's to report
// and binds nothing; an argument the type grammar could not read is skipped.
function written_type_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let bn: string[] = [];
  let bt: typeinfo.Type[] = [];
  if (c.type_args.len() != sig.all_type_params.len()) {
    return (bn, bt);
  }
  let i: i32 = 0;
  while (i < c.type_args.len()) {
    if (c.type_args[i].len() > 0) {
      let wt: typeinfo.Type = type_from_spelling(c.type_args[i], s.type_names());
      if (!type_contains_unknown(wt)) {
        bn = bn.append(sig.all_type_params[i]);
        bt = bt.append(wt);
      }
    }
    i = i + 1;
  }
  return (bn, bt);
}

// bound_type_arg_diags holds argument `ai` of a free generic call to the type
// all its arguments and written type arguments give the parameter: E047 for a
// literal out of that type's range, E038 for any other mismatch. A parameter
// naming no bound variable is left to the ordinary argument check. Reuse the
// bindings the caller computed once for its argument checks.
function bound_type_arg_diags(sig: FuncSig, c: ast.ExprCall, ai: i32, at: typeinfo.Type, s: Scope, wn: string[], wt: typeinfo.Type[]): util.Diag[] {
  let none: util.Diag[] = [];
  if (ai >= sig.param_type_names.len() || !type_contains_unknown(sig.param_types[ai])) {
    return none;
  }
  let pref: parser.TypeRef = sig_param_ref(sig, ai);
  if (wn.len() == 0 || !type_ref_names_any(pref, wn)) {
    return none;
  }
  let want: typeinfo.Type = type_from_ref_subst(pref, wn, wt, s.type_names());
  if (type_contains_unknown(want)) {
    return none;
  }
  let out: util.Diag[] = int_dest_range_diags(c.args[ai], want);
  if (out.len() == 0 && !bound_arg_accepts(c.args[ai], at, want, s) && !generic_scalar_own_callback(at, want, pref, wn, s)) {
    out = out.append(dg_at("E038", arg_subject(c, ai + 1) + ": expected " + type_label(want) + ", got " + type_label(at), expr_line(c.args[ai]), expr_col(c.args[ai])));
  }
  return out;
}

function param_has_bindings(sig: FuncSig, ai: i32, names: string[]): boolean {
  return names.len() > 0 && type_contains_unknown(sig.param_types[ai]) && type_ref_names_any(sig_param_ref(sig, ai), names);
}

// bound_arg_accepts reports whether an argument of type `actual` serves a
// parameter of type `want`: unknown, a literal that settles to it, a view
// borrow or a coercion. A generic call's own-callback reading is
// generic_own_callback_accepts, asked after this declines.
function bound_arg_accepts(e: ast.Expr, actual: typeinfo.Type, want: typeinfo.Type, s: Scope): boolean {
  return is_unknown(actual) || settles_to(e, want, s) || view_arg_borrow(actual, want) || coercible(actual, want, s);
}

// generic_own_callback_accepts is generic_scalar_own_callback for a method
// parameter spelled `spelling`, parsed only by a call that bound a type
// variable; a function signature carries its refs parsed (sig_param_ref).
function generic_own_callback_accepts(actual: typeinfo.Type, want: typeinfo.Type, names: string[], spelling: string, s: Scope): boolean {
  return names.len() > 0 && generic_scalar_own_callback(actual, want, parser.parse_type_ref(spelling), names, s);
}

// An own T callback slot bound to a scalar transfers no RC unit. Native
// inference accepts either written mask there; explicit own boolean remains
// a strict contract at ordinary assignments and non-generic calls.
function generic_scalar_own_callback(actual: typeinfo.Type, want: typeinfo.Type, ref: parser.TypeRef, names: string[], s: Scope): boolean {
  if (names.len() == 0 || !parser.ref_is_fn_value(ref)) {
    return false;
  }
  if let typeinfo.TypeFunc(a) = actual {
    if let typeinfo.TypeFunc(w) = want {
      let owns: boolean[] = scalar_own_callback_flags(a, w, parser.ref_ungroup(ref), names);
      return callable_assignable(a, typeinfo.TypeFunc { ...w, param_own: owns }, s.unions.unions);
    }
  }
  return false;
}

function scalar_own_callback_flags(a: typeinfo.TypeFunc, w: typeinfo.TypeFunc, r: parser.TypeRef, names: string[]): boolean[] {
  let owns: boolean[] = [];
  let i: i32 = 0;
  while (i < w.param_types.len() && i + 1 < r.args.len()) {
    let on: boolean = typeinfo.fn_own_at(w, i);
    if (parser.ref_is_own(r.args[i]) && type_ref_names_any(parser.ref_without_own(r.args[i]), names) && !type_contains_unknown(w.param_types[i]) && !typeinfo.ownable(w.param_types[i])) {
      on = typeinfo.fn_own_at(a, i);
    }
    owns = owns.append(on);
    i = i + 1;
  }
  return owns;
}

// call_type_bindings binds a generic call's type variables from its arguments
// and from what their bounds' impls name. A type parameter every one of whose
// arguments is an integer literal settles at the widest reading, not the first
// (#8722 part 4).
function call_type_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let (bn, bt) = call_bindings(sig, c, s);
  let wbi: i32 = 0;
  while (wbi < bn.len()) {
    let (wty, wok) = shared_literal_typevar_width(sig, c, bn[wbi], s);
    if (wok) {
      bt = bt.with(wbi, wty);
    }
    wbi = wbi + 1;
  }
  return (bn, bt);
}

// elemless_array: an array whose element nothing has typed, as an empty
// literal's is. It binds no type variable (#10499).
function elemless_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return is_unknown(a.elem);
  }
  return false;
}

// uninferred_call_diags reports E040 for a type variable nothing binds: no
// explicit type argument, argument, bound, or result destination. Only an argument binds_nothing names counts as binding
// nothing; one the checker types in part is left to native, and so is a
// parameter a bound names, which only the bound's impl can bind.
function uninferred_call_diags(sig: FuncSig, c: ast.ExprCall, bn: string[], name: string, s: Scope, dest: typeinfo.Type): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() > 0) {
    return out;
  }
  let ret: parser.TypeRef = sig_ret_ref(sig);
  let bound: string[] = bn;
  if (!is_unknown(dest)) {
    let no_types: typeinfo.Type[] = [];
    let (dn, dt) = gc_bind_param(ret, dest, sig.type_params, s.type_names(), [], no_types);
    bound = util.append_all(bound, dn);
  }
  for tp in sig.all_type_params {
    let (named, all_empty) = empty_array_positions(sig.param_type_names, c.args, tp, s);
    if (util.index_of_str(bound, tp) < 0 && !bound_names_tp(sig.type_bounds, tp) && all_empty) {
      out = out.append(dg_at("E040", "could not infer type parameter " + tp + " for " + name + " — supply it explicitly at the call site (e.g. " + name + "[i32](...)) or annotate the binding", c.line, c.col));
    }
  }
  return out;
}

// uninferred_method_diags is uninferred_call_diags for a receiver method,
// labelled `recv`.`method` as native labels it. The receiver binds exactly the
// variables its declared type names, so a concrete receiver (`u8[]`, `[u8]`,
// `string`) binds none of the method's own (#10991).
function uninferred_method_diags(c: ast.ExprCall, recv: string, method: string, msig: MethodSig, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() > 0 || msig.name.len() == 0 || c.args.len() != msig.param_type_names.len()) {
    return out;
  }
  let rref: parser.TypeRef = parser.parse_type_ref(msig.receiver_type);
  let ret: parser.TypeRef = parser.parse_type_ref(msig.ret_type_name);
  for tp in msig.all_type_params {
    let (named, all_empty) = empty_array_positions(msig.param_type_names, c.args, tp, s);
    if (!type_ref_names_any(rref, [tp]) && !type_ref_names_any(ret, [tp]) && !bound_names_tp(msig.type_bounds, tp) && all_empty) {
      out = out.append(dg_at("E040", "could not infer type parameter " + tp + " for " + recv + "." + method + " — supply it explicitly at the call site (e.g. ." + method + "[i32](...)) or annotate the binding", c.line, c.col));
    }
  }
  return out;
}

// declared_method_diags checks a call to receiver method `method` declared on
// the scalar type `recv`: E004 for the wrong number of arguments, else E038
// for an argument of the wrong type and E040 for a type parameter nothing
// binds. Silent when no such method is declared.
function declared_method_diags(c: ast.ExprCall, recv_ty: typeinfo.Type, recv: string, method: string, s: Scope): util.Diag[] {
  let msig: MethodSig = s.lookup_method(method, recv);
  if (msig.name.len() == 0) {
    return uninferred_method_diags(c, recv, method, msig, s);
  }
  if (c.args.len() != msig.param_types.len()) {
    return [dg_at("E004", util.arity_message("method \"" + method + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col)];
  }
  let out: util.Diag[] = method_arg_diags(c, method, msig, recv_ty, s);
  out = util.append_diags(out, method_type_arg_diags(c, method, msig, recv_ty, s));
  return util.append_diags(out, uninferred_method_diags(c, recv, method, msig, s));
}

// map_method_arg_diags checks the arity and arguments of a Map method core/map
// declares (`merge`, `update`, …), as declared_method_diags does a scalar's.
// The builtin methods have no signature here; map_arg_diags checks theirs.
function map_method_arg_diags(c: ast.ExprCall, recv_ty: typeinfo.Type, method: string, s: Scope): util.Diag[] {
  let msig: MethodSig = s.lookup_method(method, "Map");
  if (msig.name.len() == 0) {
    return [];
  }
  if (c.args.len() != msig.param_types.len()) {
    return [dg_at("E004", util.arity_message("method \"" + method + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col)];
  }
  let out: util.Diag[] = method_arg_diags(c, method, msig, recv_ty, s);
  return util.append_diags(out, method_type_arg_diags(c, method, msig, recv_ty, s));
}

// uninferred_recv_diags reports E040 for a variable of the receiver's type
// that the receiver itself leaves unbound: `let o = GNil;` gives `o` no type
// argument at all, so nothing binds `T` in `o.count()` unless an argument, the
// result or a bound does, as in uninferred_method_diags. An argument that is a
// type variable (`self` inside the type's own generic methods) binds it.
function uninferred_recv_diags(c: ast.ExprCall, recv: string, method: string, msig: MethodSig, args: typeinfo.Type[], s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() > 0 || msig.name.len() == 0 || c.args.len() != msig.param_type_names.len()) {
    return out;
  }
  let rref: parser.TypeRef = parser.parse_type_ref(msig.receiver_type);
  let ret: parser.TypeRef = parser.parse_type_ref(msig.ret_type_name);
  let k: i32 = 0;
  while (k < rref.args.len()) {
    let ar: parser.TypeRef = rref.args[k];
    let tp: string = ar.base;
    let bare: boolean = ar.args.len() == 0 && ar.array_depth == 0 && !ar.is_tuple && !ar.is_fn;
    let bound: boolean = k < args.len();
    if (bare && !bound && !type_ref_names_any(ret, [tp]) && !bound_names_tp(msig.type_bounds, tp)) {
      let (_, all_empty) = empty_array_positions(msig.param_type_names, c.args, tp, s);
      if (all_empty) {
        out = out.append(dg_at("E040", "could not infer type parameter " + tp + " for " + recv + "." + method + " — supply it explicitly at the call site (e.g. ." + method + "[i32](...)) or annotate the binding", c.line, c.col));
      }
    }
    k = k + 1;
  }
  return out;
}

// empty_array_positions reads the values whose declared type spells `tp`:
// whether any does, and whether every one binds nothing: an empty array
// literal (#10499), a `use` callback whose binding has no type (#10833), or a
// bare payload-less variant of a generic enum (#12910).
// An empty spelling declares no type.
function empty_array_positions(spellings: string[], values: ast.Expr[], tp: string, s: Scope): (boolean, boolean) {
  let named: boolean = false;
  let all_empty: boolean = true;
  let k: i32 = 0;
  while (k < spellings.len() && k < values.len()) {
    if (spellings[k].len() > 0 && type_ref_names_any(parser.parse_type_ref(spellings[k]), [tp])) {
      named = true;
      if (!binds_nothing(values[k], s)) {
        all_empty = false;
      }
    }
    k = k + 1;
  }
  return (named, all_empty);
}

function binds_nothing(e: ast.Expr, s: Scope): boolean {
  match (e) {
    ast.ExprArray(arr) => {
      return arr.elements.len() == 0;
    },
    ast.ExprIdent(id) => {
      return !s.is_bound(id.name) && generic_unit_variant(id.name, s);
    },
    ast.ExprLambda(lm) => {
      return lm.use_infer && lm.params.len() > 0 && lm.params[0].type_name.len() == 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function use_untyped_call(e: ast.Expr): boolean {
  if let ast.ExprCall(c) = e {
    return use_untyped(c);
  }
  return false;
}

// generic_unit_variant: `name` is a payload-less variant of a generic enum,
// which as a bare value names none of the enum's type arguments.
function generic_unit_variant(name: string, s: Scope): boolean {
  let owner: UnionSig = union_sig_of_variant(name, s.unions);
  return owner.is_enum && owner.type_params.len() > 0 && variant_value_payloads(s, "", name) == 0;
}

// bound_names_tp: one of `bounds` spells `tp`, so bound_bindings may be what
// binds it.
function bound_names_tp(bounds: string[], tp: string): boolean {
  for b in bounds {
    for entry in parser.split_plus_bounds(b) {
      if (type_ref_names_any(parser.parse_type_ref(entry), [tp])) {
        return true;
      }
    }
  }
  return false;
}

// bound_arg_diags reports E021 where a bounded parameter's impl names other
// trait arguments than its bound does under the call's bindings:
// `to_array[T, I: Iterator[T]]` at `I = Range`, whose impl is `Iterator[i32]`,
// with T bound to string.
function bound_arg_diags(sig: FuncSig, c: ast.ExprCall, bn: string[], bt: typeinfo.Type[], s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let i: i32 = 0;
  while (i < sig.type_params.len() && i < sig.type_bounds.len()) {
    let bi: i32 = util.index_of_str(bn, sig.type_params[i]);
    if (sig.type_bounds[i].len() > 0 && bi >= 0) {
      for entry in parser.split_plus_bounds(sig.type_bounds[i]) {
        out = util.append_diags(out, bound_entry_diag(sig, sig.type_params[i], bt[bi], parser.parse_type_ref(entry), bn, bt, c, s));
      }
    }
    i = i + 1;
  }
  return out;
}

// bound_entry_diag is bound_arg_diags for one bound on type parameter `tp`,
// bound to `at`: nothing while either side still has an unknown in it.
function bound_entry_diag(sig: FuncSig, tp: string, at: typeinfo.Type, bref: parser.TypeRef, bn: string[], bt: typeinfo.Type[], c: ast.ExprCall, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  let iargs: typeinfo.Type[] = impl_trait_args(bref, sig.module, at, s);
  if (iargs.len() == 0 || iargs.len() != bref.args.len()) {
    return none;
  }
  let want: typeinfo.Type[] = [];
  let clash: boolean = false;
  let k: i32 = 0;
  while (k < iargs.len()) {
    let w: typeinfo.Type = type_from_ref_subst(bref.args[k], bn, bt, s.type_names());
    if (type_contains_unknown(w)) {
      return none;
    }
    if (!type_eq(w, iargs[k])) {
      clash = true;
    }
    want = want.append(w);
    k = k + 1;
  }
  if (!clash) {
    return none;
  }
  let tr: string = bound_trait_display(bref.base, sig.module, s.trait_reqs);
  return [dg_at("E021", "type argument " + tp + " = " + util.demangle(type_label(at)) + " implements " + tr + trait_args_label(iargs) + " but the bound requires " + tr + trait_args_label(want) + " (in " + util.demangle(sig.name) + ")", c.line, c.col)];
}

function trait_args_label(args: typeinfo.Type[]): string {
  let out: string = "";
  for a in args {
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + util.demangle(type_label(a));
  }
  return "[" + out + "]";
}

// dest_bound_diags is bound_arg_diags for a generic call whose result lands in
// a declared type: a variable the arguments leave unbound takes the
// destination's, so `let xs: string[] = to_array(range(0, 5))` asks Range for
// `Iterator[string]`.
function dest_bound_diags(e: ast.Expr, dest: typeinfo.Type, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  let arms: ast.Expr[] = value_if_results(e);
  if (arms.len() > 0) {
    let out: util.Diag[] = [];
    for arm in arms {
      out = util.append_diags(out, dest_bound_diags(arm, dest, s));
    }
    return out;
  }
  if let ast.ExprArray(arr) = e {
    let elem: typeinfo.Type = array_elem_type_of(dest);
    let eout: util.Diag[] = [];
    if (is_unknown(elem)) {
      return eout;
    }
    for element in arr.elements {
      eout = util.append_diags(eout, dest_bound_diags(element, elem, s));
    }
    return eout;
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (s.defines(id.name)) {
        return none;
      }
      let sig: FuncSig = s.lookup_sig(id.name);
      if (sig.all_type_params.len() == 0 || sig.ret_type_name.len() == 0 || c.args.len() != sig.param_types.len()) {
        return none;
      }
      let (cn, ct) = call_bindings(sig, c, s);
      if (bound_arg_diags(sig, c, cn, ct, s).len() > 0) {
        return none;
      }
      let (bn, bt) = arg_bindings(sig, c, s);
      let (dn, dt) = gc_bind_param(sig_ret_ref(sig), dest, sig.type_params, s.type_names(), bn, bt);
      if (dn.len() == bn.len()) {
        return none;
      }
      let (fn_, ft) = bound_bindings(sig, s, dn, dt);
      return util.append_diags(dest_bound_e021(sig, c, dn, dt, bn.len(), s), bound_arg_diags(sig, c, fn_, ft, s));
    }
  }
  return none;
}

// dest_bound_e021 is E021 for each of `sig`'s variables only the destination
// binds (dn[from..], at dt[from..]) whose bound that type does not meet.
function dest_bound_e021(sig: FuncSig, c: ast.ExprCall, dn: string[], dt: typeinfo.Type[], from: i32, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let di: i32 = from;
  while (di < dn.len()) {
    let ti: i32 = util.index_of_str(sig.type_params, dn[di]);
    if (ti >= 0 && ti < sig.type_bounds.len() && !is_unknown(dt[di]) && !is_type_variable(dt[di])) {
      out = util.append_diags(out, tp_bound_diags(dn[di], sig.type_bounds[ti], sig.module, util.demangle(sig.name), dt[di], s, c.line, c.col));
    }
    di = di + 1;
  }
  return out;
}

// dest_bound_result reports whether `e` is a generic call whose result is a
// type variable the call leaves unbound, so the destination binds it and the
// call reads at the destination's type.
function dest_bound_result(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (s.defines(id.name)) {
        return false;
      }
      let sig: FuncSig = s.lookup_sig(id.name);
      if (sig.all_type_params.len() == 0 || c.args.len() != sig.param_types.len()) {
        return false;
      }
      let ret: parser.TypeRef = sig_ret_ref(sig);
      if (ret.args.len() > 0 || ret.array_depth > 0 || !util.has_str(sig.all_type_params, ret.base)) {
        return false;
      }
      let (bn, _) = call_type_bindings(sig, c, s);
      return util.index_of_str(bn, ret.base) < 0 && is_type_variable(check_expr(e, s));
    }
  }
  return false;
}

// value_if_results are the values a value-`if` or value-`match` yields, the
// arms its desugared IIFE returns or stores into its value local; none for any
// other expression. An arm that binds names is read in the enclosing scope, so
// what it mentions from them stays unknown.
function value_if_results(e: ast.Expr): ast.Expr[] {
  let none: ast.Expr[] = [];
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lam) = c.callee {
      if (c.args.len() != 0 || lam.origin != parser.ORIGIN_IF_EXPR && lam.origin != parser.ORIGIN_MATCH_EXPR) {
        return none;
      }
      let out: ast.Expr[] = [];
      for st in lam.body {
        out = astwalk.fold_stmt_spine(st, out, collect_arm_result);
      }
      return out;
    }
  }
  return none;
}

function collect_arm_result(st: ast.Stmt, own acc: ast.Expr[]): ast.Expr[] {
  if let ast.StmtReturn(r) = st {
    return acc.append(r.value);
  }
  if let ast.StmtAssign(a) = st {
    if (parser.is_value_local_name(a.target)) {
      return acc.append(a.value);
    }
  }
  return acc;
}

// bound_bindings binds the type variables a call's bounds name: `I:
// Iterator[T]` with I at a type whose impl is `Iterator[i32]` binds T to i32.
// A variable one bound binds can make another bound's subject known, so it
// runs until nothing new binds.
function bound_bindings(sig: FuncSig, s: Scope, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  return bounds_bindings(sig.type_params, sig.type_bounds, sig.module, s, names, types);
}

// bounds_bindings is bound_bindings for type parameters `tparams` and the
// bounds that run parallel to them, declared in `module`: a free function's or
// a method's own.
function bounds_bindings(tparams: string[], bounds: string[], module: string, s: Scope, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  let ns: string[] = names;
  let ts: typeinfo.Type[] = types;
  let before: i32 = 0 - 1;
  while (ns.len() > before) {
    before = ns.len();
    let i: i32 = 0;
    while (i < tparams.len() && i < bounds.len()) {
      let bi: i32 = util.index_of_str(ns, tparams[i]);
      if (bounds[i].len() > 0 && bi >= 0) {
        for entry in parser.split_plus_bounds(bounds[i]) {
          let bref: parser.TypeRef = parser.parse_type_ref(entry);
          let iargs: typeinfo.Type[] = impl_trait_args(bref, module, ts[bi], s);
          if (iargs.len() == bref.args.len()) {
            let k: i32 = 0;
            while (k < iargs.len()) {
              let (n2, t2) = gc_bind_param(bref.args[k], iargs[k], tparams, s.type_names(), ns, ts);
              ns = n2;
              ts = t2;
              k = k + 1;
            }
          }
        }
      }
      i = i + 1;
    }
  }
  return (ns, ts);
}

// impl_trait_args are the trait arguments of the impl that makes `at` conform
// to `bound`, with the impl's own type parameters read off `at`: for
// `impl[T] Iterator[T] for ArrayIter[T]` at `ArrayIter[f64]`, [f64]. None when
// no impl applies or an argument stays unknown.
function impl_trait_args(bound: parser.TypeRef, module: string, at: typeinfo.Type, s: Scope): typeinfo.Type[] {
  let none: typeinfo.Type[] = [];
  if (bound.args.len() == 0 || type_contains_unknown(at)) {
    return none;
  }
  if let typeinfo.TypeDyn(d) = at {
    return dyn_trait_args(bound, d.traits, s);
  }
  let base: string = receiver_namespace(util.base_type_name(type_label(at)));
  for imp in s.impls {
    if (bound_names_trait(bound.base, module, imp.trait_name, imp.trait_module) && impl_receiver(imp) == base) {
      let (in_, it_) = gc_bind_param(parser.parse_type_ref(imp.impl_type), at, imp.all_type_params, s.type_names(), [], []);
      let out: typeinfo.Type[] = [];
      for targ in parser.parse_type_ref(imp.trait_ref).args {
        let ty: typeinfo.Type = type_from_ref_subst(targ, in_, it_, s.type_names());
        if (type_contains_unknown(ty)) {
          return none;
        }
        out = out.append(ty);
      }
      return out;
    }
  }
  return none;
}

// dyn_trait_args are the trait arguments a `dyn` spells for the trait a bound
// names, the arguments it conforms with (native DynTraitType.ArgsFor): for
// `dyn Container[i32]` against `C: Container[string]`, [i32]. None when the
// dyn does not name the trait or an argument stays unknown.
function dyn_trait_args(bound: parser.TypeRef, traits: string, s: Scope): typeinfo.Type[] {
  let none: typeinfo.Type[] = [];
  let want: string = parser.derive_simple_name(bound.base);
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let ref: parser.TypeRef = parser.parse_type_ref(tr);
    if (parser.derive_simple_name(ref.base) == want) {
      let out: typeinfo.Type[] = [];
      for targ in ref.args {
        let ty: typeinfo.Type = type_from_ref_subst(targ, [], [], s.type_names());
        if (type_contains_unknown(ty)) {
          return none;
        }
        out = out.append(ty);
      }
      return out;
    }
  }
  return none;
}

// bound_names_trait: the bound `base`, written in `module`'s function, names
// the trait `name` that `trait_module` declares. The bundled impl table holds
// every module's, so a name two modules declare is told apart by the declaring
// module, as flatten's canon_trait spells it: a bare bound is the writing
// module's own trait, and a qualified one an import's (#10845).
function bound_names_trait(base: string, module: string, name: string, trait_module: string): boolean {
  if (parser.derive_simple_name(base) != name) {
    return false;
  }
  if (util.index_of_sub(base, ".") >= 0) {
    return trait_module.len() > 0;
  }
  return trait_module == module;
}

// struct_lit_args are a generic struct literal's type arguments: each is bound
// by the first written field that fixes it, a typed integer ahead of an untyped
// integer literal, as native binds them; the rest stay unknown. An empty array
// literal fixes nothing.
function struct_lit_args(sl: ast.ExprStructLit, ssig: StructSig, s: Scope): typeinfo.Type[] {
  let written: typeinfo.Type[] = written_struct_args(sl, ssig, s);
  if (written.len() > 0) {
    return written;
  }
  let bn: string[] = [];
  let bt: typeinfo.Type[] = [];
  let pass: i32 = 0;
  while (pass < 2) {
    let i: i32 = 0;
    while (i < sl.field_names.len()) {
      let fi: i32 = field_index(ssig, sl.field_names[i]);
      // A typed integer binds ahead of an untyped literal, as native's
      // rebind does; every other value binds in written order, so a clash is
      // reported on the field that breaks what the earlier ones bound.
      let binds: boolean = fi >= 0 && fi < ssig.field_type_names.len() && typed_int_field(sl.field_values[i], s) == (pass == 0);
      // An empty array literal binds nothing; it takes whatever the others fix.
      if let ast.ExprArray(ea) = sl.field_values[i] {
        if (ea.elements.len() == 0) {
          binds = false;
        }
      }
      if (binds) {
        let (bn2, bt2) = gc_bind_param(parser.parse_type_ref(ssig.field_type_names[fi]), check_expr(sl.field_values[i], s), ssig.type_params, s.type_names(), bn, bt);
        bn = bn2;
        bt = bt2;
      }
      i = i + 1;
    }
    pass = pass + 1;
  }
  let args: typeinfo.Type[] = [];
  for tp in ssig.type_params {
    let bi: i32 = util.index_of_str(bn, tp);
    if (bi >= 0) {
      args = args.append(literal_bound_width(sl, ssig, tp, bt[bi], s));
    } else {
      args = args.append(t_unknown("unbound " + tp));
    }
  }
  return args;
}

// typed_int_field is whether a struct literal's field value is an integer
// that is not an untyped literal tree.
function typed_int_field(e: ast.Expr, s: Scope): boolean {
  return !int_literal_tree(e) && is_integer(check_expr(e, s));
}

// written_struct_args are the type arguments a literal spells, `Same[i32] {
// … }`: what the literal is, ahead of anything its fields would bind or widen.
// Empty when it spells none, or a number the struct does not take (E040).
function written_struct_args(sl: ast.ExprStructLit, ssig: StructSig, s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  if (sl.written.len() == 0) {
    return out;
  }
  let wref: parser.TypeRef = parser.parse_type_ref(sl.written);
  if (wref.args.len() != ssig.type_params.len()) {
    return out;
  }
  for a in wref.args {
    out = out.append(type_from_ref_subst(a, [], [], s.type_names()));
  }
  return out;
}

// literal_bound_width widens a type argument that only untyped integer
// literals bound to i64 when one of them has no i32 reading, as native's
// widenCompositeByLiterals does: `Same { a: 1, b: 4611686018427387904 }` is a
// Same[i64] (#10453), and so is `Stack { items: [1, 4611686018427387904] }`.
// An argument a typed value bound is left alone.
function literal_bound_width(sl: ast.ExprStructLit, ssig: StructSig, tp: string, bound: typeinfo.Type, s: Scope): typeinfo.Type {
  let lit: ast.Expr[] = [sl];
  let es: ast.Expr[] = struct_param_exprs(ssig, tp, lit, s);
  if (es.len() == 0) {
    return bound;
  }
  for e in es {
    if (!int_literal_tree(e)) {
      return bound;
    }
  }
  for e in es {
    if (wide_int_tree(e)) {
      return t_i64();
    }
  }
  return bound;
}

// struct_param_exprs are the expressions, across the literals of `ssig`'s
// struct in es, that occupy its type parameter tp: a field declared `T`, an
// element of one declared `T[]` or `(T, string)`, a field of a nested
// `Box[T]`. A literal that writes its own instantiation contributes nothing.
function struct_param_exprs(ssig: StructSig, tp: string, es: ast.Expr[], s: Scope): ast.Expr[] {
  let out: ast.Expr[] = [];
  let fi: i32 = 0;
  while (fi < ssig.field_names.len() && fi < ssig.field_type_names.len()) {
    let vals: ast.Expr[] = [];
    for e in es {
      if let ast.ExprStructLit(sl) = e {
        if (sl.type_name == ssig.name && sl.written.len() == 0) {
          let i: i32 = 0;
          while (i < sl.field_names.len()) {
            if (sl.field_names[i] == ssig.field_names[fi]) {
              vals = vals.append(sl.field_values[i]);
            }
            i = i + 1;
          }
        }
      }
    }
    out = util.append_all(out, param_exprs(parser.parse_type_ref(ssig.field_type_names[fi]), tp, vals, s));
    fi = fi + 1;
  }
  return out;
}

// param_exprs are the expressions within es, values of type tr, that occupy
// the type parameter tp.
function param_exprs(tr: parser.TypeRef, tp: string, es: ast.Expr[], s: Scope): ast.Expr[] {
  let out: ast.Expr[] = [];
  if (es.len() == 0) {
    return out;
  }
  if (tr.array_depth > 0 || tr.is_view) {
    let elems: ast.Expr[] = [];
    for e in es {
      if let ast.ExprArray(ea) = e {
        elems = util.append_all(elems, ea.elements);
      }
    }
    if (tr.is_view) {
      return param_exprs(tr.args[0], tp, elems, s);
    }
    return param_exprs(parser.elem_type_ref(tr), tp, elems, s);
  }
  if (tr.is_tuple) {
    let ti: i32 = 0;
    while (ti < tr.args.len()) {
      let elems: ast.Expr[] = [];
      for e in es {
        if let ast.ExprTuple(et) = e {
          if (ti < et.elements.len()) {
            elems = elems.append(et.elements[ti]);
          }
        }
      }
      out = util.append_all(out, param_exprs(tr.args[ti], tp, elems, s));
      ti = ti + 1;
    }
    return out;
  }
  if (tr.is_fn) {
    return out;
  }
  if (tr.args.len() == 0) {
    if (tr.base == tp) {
      return es;
    }
    return out;
  }
  let inner: StructSig = s.lookup_struct(tr.base);
  if (inner.name.len() == 0 || inner.type_params.len() != tr.args.len()) {
    return out;
  }
  let k: i32 = 0;
  while (k < inner.type_params.len()) {
    out = util.append_all(out, param_exprs(tr.args[k], tp, struct_param_exprs(inner, inner.type_params[k], es, s), s));
    k = k + 1;
  }
  return out;
}

// widened_field_type is field j's type under a generic literal's own
// arguments when that, or an element of it, reads at i64, and unknown
// otherwise: only a widening is the literal's to settle, a narrower width comes
// from its context.
function widened_field_type(sig: StructSig, j: i32, largs: typeinfo.Type[], s: Scope): typeinfo.Type {
  let want: typeinfo.Type = type_from_ref_subst(parser.parse_type_ref(sig.field_type_names[j]), sig.type_params, largs, s.type_names());
  if (reads_i64(want)) {
    return want;
  }
  return t_unknown("no field");
}

// reads_i64 is whether t, or an array or tuple element or struct type
// argument of it, is i64.
function reads_i64(t: typeinfo.Type): boolean {
  if (type_to_irtag(t) == "i64") {
    return true;
  }
  if let typeinfo.TypeArray(at) = t {
    return reads_i64(at.elem);
  }
  let parts: typeinfo.Type[] = [];
  if let typeinfo.TypeStruct(st) = t {
    parts = st.args;
  }
  if let typeinfo.TypeTuple(tt) = t {
    parts = tt.elements;
  }
  for p in parts {
    if (reads_i64(p)) {
      return true;
    }
  }
  return false;
}

// lit_uninferable_param names a type parameter of a destination-less literal
// that nothing can bind: unbound in `args`, and every field spelled with it
// holds an empty array literal. "" when there is none.
function lit_uninferable_param(sl: ast.ExprStructLit, ssig: StructSig, args: typeinfo.Type[], s: Scope): string {
  // A struct update's base fixes every argument the overrides leave open.
  if (sl.has_base) {
    return "";
  }
  let i: i32 = 0;
  while (i < ssig.type_params.len() && i < args.len()) {
    if (is_unknown(args[i])) {
      let tp: string = ssig.type_params[i];
      let spellings: string[] = [];
      for fname in sl.field_names {
        let fi: i32 = field_index(ssig, fname);
        if (fi >= 0 && fi < ssig.field_type_names.len()) {
          spellings = spellings.append(ssig.field_type_names[fi]);
        } else {
          spellings = spellings.append("");
        }
      }
      let (named, all_empty) = empty_array_positions(spellings, sl.field_values, tp, s);
      if (named && all_empty) {
        return tp;
      }
    }
    i = i + 1;
  }
  return "";
}

// lit_field_clash is the index of the first written field whose value its
// declared type refuses under `args`, or -1.
function lit_field_clash(sl: ast.ExprStructLit, ssig: StructSig, args: typeinfo.Type[], s: Scope): i32 {
  let i: i32 = 0;
  while (i < sl.field_names.len()) {
    let fi: i32 = field_index(ssig, sl.field_names[i]);
    if (fi >= 0) {
      let ft: typeinfo.Type = lit_field_type(ssig, fi, args, s);
      let vt: typeinfo.Type = check_expr(sl.field_values[i], s);
      if (!type_contains_unknown(ft) && !is_unknown(vt) && !settles_to(sl.field_values[i], ft, s) && !coercible(vt, ft, s)) {
        return i;
      }
    }
    i = i + 1;
  }
  return 0 - 1;
}

// projected_ret resolves a generic's return spelled through a projection on a
// type parameter (`H::Item`): the call's bindings make the base concrete, and
// the impl of that base says what the projection names.
function projected_ret(ret_name: string, bn: string[], bt: typeinfo.Type[], s: Scope): typeinfo.Type {
  let names: string[] = [];
  let spells: string[] = [];
  let i: i32 = 0;
  while (i < bn.len()) {
    if (!type_contains_unknown(bt[i])) {
      names = names.append(bn[i]);
      spells = spells.append(typeinfo.spelling(bt[i]));
    }
    i = i + 1;
  }
  let resolved: string = parser.resolve_proj_in_type(parser.subst_ty(ret_name, names, spells), s.impls);
  if (util.contains(resolved, "::")) {
    return t_unknown("unresolved projection " + resolved);
  }
  return s.resolve_type(resolved);
}

function check_expr(e: ast.Expr, s: Scope): typeinfo.Type {
  match (e) {
    ast.ExprNumber(n) => {
      return check_number_expr(n, s);
    },
    ast.ExprBool(_) => {
      return t_bool();
    },
    ast.ExprString(_) => {
      return t_string();
    },
    ast.ExprIdent(id) => {
      return check_ident_expr(id, s);
    },
    ast.ExprBinary(b) => {
      return check_binary_expr(b, s);
    },
    ast.ExprUnary(u) => {
      return check_unary_expr(u, s);
    },
    ast.ExprCall(c) => {
      return check_call_expr(c, s);
    },
    ast.ExprTuple(t) => {
      let elems: typeinfo.Type[] = [];
      for element in t.elements {
        elems = elems.append(check_expr(element, s));
      }
      return t_tuple(elems);
    },
    ast.ExprArray(a) => {
      return check_array_expr(a, s);
    },
    ast.ExprBytes(_) => {
      return t_array(t_u8());
    },
    ast.ExprIndex(x) => {
      return check_index_expr(x, s);
    },
    ast.ExprSlice(sl) => {
      return check_slice_expr(sl, s);
    },
    ast.ExprStructLit(sl) => {
      return check_struct_lit_expr(sl, s);
    },
    ast.ExprFieldAccess(fa) => {
      return check_field_access_expr(fa, s);
    },
    ast.ExprLambda(lm) => {
      return check_lambda_expr(lm, s);
    },
    ast.ExprMapLit(_) => {
      // ExprMapLit is the formatter's written form of `Map { … }`; the compile
      // parse desugars every map literal to its `map_new(…).insert(…)` chain,
      // so one reaching here means a verbatim parse was fed to the checker.
      return t_unknown("Map literal: formatter-only node");
    },
    ast.ExprFString(_) => {
      return t_unknown("f-string: formatter-only node");
    },
    ast.ExprUnknown(u) => {
      return t_unknown("parser-side unknown:" + u.kind);
    },
    ast.ExprZero(z) => {
      return s.resolve_type(z.type_name);
    }
  }
  return t_unknown("unhandled Expr variant");
}

function check_number_expr(n: ast.ExprNumber, s: Scope): typeinfo.Type {
  // `()` — the unit value. Its payload is the constant 0 the parser
  // records, so the spelling is what tells it from a written `0`; native
  // types its UnitLit `void` the same way.
  if (parser.is_unit_literal(n)) {
    return t_void();
  }
  // A float SUFFIX names the type outright, as an integer one does below;
  // only an unsuffixed float adapts to its context.
  if (n.is_float && n.suffix == "f32") {
    return t_f32();
  }
  if (n.is_float && n.suffix == "f64") {
    return typeinfo.TypeFloat { width: 64, polymorphic: false };
  }
  if (n.is_float) {
    return typeinfo.TypeFloat { width: 64, polymorphic: true };
  }
  // A SUFFIX names the type outright. Without this every integer
  // literal typed i32, and check_call_expr's if-expression arm — which
  // types the desugared IIFE from its branches' common type — handed
  // the lowering `c.ty = "i32"` for `if (c) { big_u64 } else { 0u64 }`.
  // expr_is_u64 trusts that tag before its structural walk, so the
  // chained `>>` selected the SIGNED shift: wrong once bit 63 is set,
  // with no trap and no diagnostic. parser.if_expr_rt and mono_infer
  // are the sibling literal classifiers.
  if (n.suffix == "i64") {
    return t_i64();
  }
  if (n.suffix == "u64") {
    return t_u64();
  }
  if (n.suffix == "u32") {
    return t_u32();
  }
  if (n.suffix == "u8") {
    return t_u8();
  }
  if (n.suffix == "usize") {
    return t_usize();
  }
  // An `i32` suffix names i32 even past i32-max, where the magnitude rule
  // below would call the literal i64 and the assignment would fail E003
  // instead of the range check's E047. parser.if_expr_rt and
  // parser.mono_infer read ANY suffix before that rule for the same reason.
  if (n.suffix == "i32") {
    return t_i32();
  }
  // `'x'` — the lexer tags a character literal with the type name
  // rather than a numeric suffix, since `char` has no suffix form.
  if (n.suffix == "char") {
    return t_char();
  }
  // A magnitude past i32-max names i64 with no suffix to say so.
  // parser.if_expr_rt and parser.mono_infer are the sibling literal
  // classifiers; all three have to agree or a width is lost between them.
  if (parser.literal_is_i64(n.text)) {
    return t_i64();
  }
  return t_i32();
}

function check_ident_expr(id: ast.ExprIdent, s: Scope): typeinfo.Type {
  let bi: i32 = s.binding_index(id.name);
  if (bi >= 0 && !is_unknown(s.types[bi])) {
    return s.types[bi];
  }
  // Fallback (#4346 piece 2): a bare no-payload enum variant used as
  // a value types to its enum's union. A local of the same name
  // shadows (handled above by the successful lookup). Payload
  // variants reach the checker as calls (`Some(3)`) / struct
  // literals and carry a backing struct with an `__ev` field, so we
  // resolve ONLY when the variant carries no payload — exactly a
  // unit variant like `Red` under `enum Color { Red, Green }`.
  // Builtin Option/Result variants aren't registered as unions here,
  // so they stay unknown (their generic payloads are a separate
  // slice).
  if (!s.has_sig(id.name) && s.variant_ambiguous(id.name)) {
    return t_unknown("ambiguous variant `" + id.name + "`");
  }
  let un: string = union_of_variant(id.name, s.unions);
  if (un.len() > 0 && !s.has_sig(id.name) && variant_value_payloads(s, "", id.name) == 0) {
    return t_union(un);
  }
  // Builtin no-payload variants (`None`, `JNull`, the IoError set)
  // aren't in the declared-union table but the front-end injects them
  // (#4346 piece 2). Restricted to the no-payload set so a payload
  // builtin (`Some` / `Ok` / …) stays unknown here and is typed at
  // its constructor call in check_call_expr — resolving it bare would
  // mistype a `Some(3)` callee as a value. A function of the same name
  // shadows the builtin, as native resolves it (#10394).
  if (is_nopayload_builtin_variant(id.name) && !s.has_sig(id.name)) {
    return t_union(parser.builtin_enum_of(id.name));
  }
  // A top-level `const` reaches the parser as a zero-parameter FuncDecl
  // carrying `is_const`, so it lands in the SIG table rather than the value
  // scope, and a bare reference to one found nothing here. The const flag is
  // what separates it from a bare function VALUE of the same shape, which
  // types as a function rather than as its return type.
  let csig: FuncSig = s.lookup_sig(id.name);
  if (csig.is_const) {
    return csig.ret_type;
  }
  // A bare NON-const function name used as a VALUE (`apply(mk)`,
  // `let g = mk;`) types as its signature's function type — the
  // call-site half of #5986's fn typing: with fn-typed params resolving
  // to TypeFunc, an unknown-typed named-function argument would read as
  // a mismatch and untype the call it feeds. Only for a name with NO
  // binding at all: a binding typed opaquely-unknown (a builtin variant
  // payload, a generic) still SHADOWS the function table — lookup's
  // unknown return conflates the two, and resolving the shadowed name
  // to the function turned `Some(pair) => pair.0` into an E043 inside
  // std the moment a user function was named `pair`.
  if (csig.name.len() > 0 && bi < 0) {
    // A generic template keeps its abstract signature here. Its destination
    // must instantiate it consistently (fn_value_settles), and the call walk
    // still reports E040 wherever no destination binds its parameters.
    return t_func_own(csig.param_types, csig.param_own, csig.ret_type);
  }
  if (bi >= 0) {
    return s.types[bi];
  }
  return t_unknown("undefined identifier:" + id.name);
}

function check_binary_expr(b: ast.ExprBinary, s: Scope): typeinfo.Type {
  // A named-argument marker survives only on a call fill_default_args
  // refused (E077 / E004 already reported); its value is what the
  // parameter check types, as native types the argument beside its name.
  if (b.op == "__named_arg") {
    return check_expr(b.right, s);
  }
  return binary_result_type(b, check_expr(b.left, s), check_expr(b.right, s), s);
}

// binary_result_type is check_binary_expr over operand types already checked
// (`lt`, `rt`): the annotation walk hands it the types of the operands it
// annotated rather than checking them again.
function binary_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): typeinfo.Type {
  let (sl, sr) = settled_operands(b, lt, rt);
  return operator_result_type(b, sl, sr, s);
}

// lanes_result_type types a binary with a lane operand: two values of one lane
// type under `+ - * /` give that type. A comparison, which E041 refuses, is a
// boolean, so no second error follows it.
function lanes_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): typeinfo.Type {
  if (util.has_str(["==", "!=", "<", ">", "<=", ">="], b.op)) {
    return t_bool();
  }
  if (util.has_str(["+", "-", "*", "/"], b.op) && type_eq(lt, rt)) {
    return lt;
  }
  return t_unknown("lane operands need one lane type and an arithmetic operator");
}

// operator_result_type types `b` over its settled operand types.
function operator_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): typeinfo.Type {
  // `+` is overloaded across i32 (arithmetic) and string
  // (concatenation). Other arithmetic ops are i32-only.
  if (is_lanes(lt) || is_lanes(rt)) {
    return lanes_result_type(b, lt, rt);
  }
  if (b.op == "+") {
    if (type_eq(lt, t_string()) && type_eq(rt, t_string())) {
      return t_string();
    }
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    if (float_operands_agree(lt, rt)) {
      return float_result(lt, rt);
    }
    // Composite operator overload (#2706): `a + b` on a struct / enum is
    // `a.add(b)` and evaluates to that method's declared return type.
    let povt: typeinfo.Type = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(povt)) {
      return povt;
    }
    return t_unknown("`+` operands type mismatch");
  }
  // Saturating arithmetic (#5542) clamps instead of wrapping;
  // integer-only, so there is no string or float form. `<<|` is
  // the shift member — same operand rule as `<<`.
  if (b.op == "+|" || b.op == "-|" || b.op == "*|" || b.op == "<<|") {
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    return t_unknown("`" + b.op + "` operands must both be integers");
  }
  // Checked arithmetic (#5542) yields `Option[T]` — integer-only,
  // no string or float form. The element carries the operands' own
  // width, so `a %? b` on i64 is `Option[i64]`.
  if (b.op == "+?" || b.op == "-?" || b.op == "*?" || b.op == "/?" || b.op == "%?" || b.op == "<<?" || b.op == ">>?") {
    if (is_integer(lt) && is_integer(rt)) {
      let chkoa: typeinfo.Type[] = [int_result(lt, rt, b.left, b.right)];
      return t_union_g("Option", chkoa);
    }
    return t_unknown("`" + b.op + "` operands must both be integers");
  }
  if (b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%") {
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    // `%` on floats isn't supported — interp surfaces
    // VErr; checker is lenient and just rejects it.
    if (b.op != "%" && float_operands_agree(lt, rt)) {
      return float_result(lt, rt);
    }
    // Composite operator overload (#2706), the `+` arm's sibling.
    let aovt: typeinfo.Type = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(aovt)) {
      return aovt;
    }
    return t_unknown("arithmetic op `" + b.op + "` requires matching i32 or f64 operands");
  }
  return bitwise_result_type(b, lt, rt, s);
}

// bitwise_result_type continues operator_result_type: the bitwise, shift,
// comparison and logical operators.
function bitwise_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): typeinfo.Type {
  // Bitwise expressions retain their operand type. Without this a u32
  // mask becomes unknown and a following wide literal loses its context.
  if (b.op == "&" || b.op == "|" || b.op == "^") {
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    let bovt: typeinfo.Type = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(bovt)) {
      return bovt;
    }
    return t_unknown("bitwise operands must both be integers");
  }
  // A shift keeps its left operand's type, except that an unsuffixed literal
  // there reads at the right's width, as in native's commonIntegerWidth.
  if (b.op == "<<" || b.op == ">>") {
    if (is_integer(lt) && is_integer(rt)) {
      if (int_literal_tree(b.left) && !int_literal_tree(b.right) || unsettled_int_literal(b.left)) {
        return rt;
      }
      return lt;
    }
    let sovt: typeinfo.Type = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(sovt)) {
      return sovt;
    }
    return t_unknown("shift operands must both be integers");
  }
  if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
    if (is_integer(lt) && is_integer(rt)) {
      return t_bool();
    }
    if (type_eq(lt, t_char()) && type_eq(rt, t_char())) {
      return t_bool();
    }
    if (float_operands_agree(lt, rt)) {
      return t_bool();
    }
    // String ordering is byte-wise lexicographic with a length
    // tiebreak, lowered to the `str_cmp` op — a primitive, like
    // `==` on strings, not an `Ord` dispatch.
    if (type_eq(lt, t_string()) && type_eq(rt, t_string())) {
      return t_bool();
    }
    // Two values of one struct or enum order through its `Ord` impl.
    if (s.orders_alike(lt, rt)) {
      return t_bool();
    }
    return t_unknown("comparison op `" + b.op + "` requires matching i32, f64, string or `Ord` operands");
  }
  if (b.op == "==" || b.op == "!=") {
    if (float_operands_agree(lt, rt)) {
      return t_bool();
    }
    if (type_eq(lt, rt) && !is_unknown(lt)) {
      return t_bool();
    }
    // An unsuffixed literal is read at the other operand's width, so
    // `n == 3` holds whatever integer type `n` has (the E041 rule
    // below says the same).
    if (is_integer(lt) && is_integer(rt)
      && (int_literal_tree(b.left) || int_literal_tree(b.right))) {
      return t_bool();
    }
    return t_unknown("equality op `" + b.op + "` requires same-typed operands");
  }
  if (b.op == "&&" || b.op == "||") {
    if (type_eq(lt, t_bool()) && type_eq(rt, t_bool())) {
      return t_bool();
    }
    return t_unknown("logical op `" + b.op + "` requires bool operands");
  }
  return t_unknown("unknown binary op:" + b.op);
}

function check_unary_expr(u: ast.ExprUnary, s: Scope): typeinfo.Type {
  // `-2147483648` is i32-min, though its operand alone has no i32 reading.
  if (u.op == "-" && unsettled_int_literal(ast.ExprUnary { ...u })) {
    if let ast.ExprNumber(_) = u.operand {
      return t_i32();
    }
  }
  return unary_result_type(u, check_expr(u.operand, s), s);
}

// unary_result_type is check_unary_expr over the operand's checked type.
function unary_result_type(u: ast.ExprUnary, ot: typeinfo.Type, s: Scope): typeinfo.Type {
  if (u.op == "-") {
    if (is_integer(ot)) {
      return ot;
    }
    if (is_float(ot) || is_lanes(ot)) {
      return ot;
    }
    // Composite operator overload (#2706): `-a` on a struct / enum is
    // `a.neg()`, the unary sibling of the binary arm above.
    let novt: typeinfo.Type = s.unop_overload_ret(u.op, ot);
    if (!is_unknown(novt)) {
      return novt;
    }
    return t_unknown("unary `-` requires i32 or f64 operand");
  }
  if (u.op == "!") {
    if (type_eq(ot, t_bool())) {
      return t_bool();
    }
    return t_unknown("unary `!` requires bool operand");
  }
  // `x as T` desugars to the unary op `as_<T>`. The result type
  // is the target type (matching the Go checker, which returns
  // n.Target even when the cast is invalid).
  if (u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as_") {
    return s.resolve_type(slice_unchecked(u.op, 3, u.op.len()) + "");
  }
  if (u.op == "try_") {
    return try_success_type(s, ot);
  }
  // `x as? T` is `Option[T]`; E059 / E060 police the operand and target.
  if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
    return typeinfo.TypeUnion { name: "Option", args: [s.resolve_type(slice_unchecked(u.op, 4, u.op.len()) + "")] };
  }
  return t_unknown("unknown unary op:" + u.op);
}

// Whether `a` settles less than `b`: it holds an unknown where `b` does not,
// or it is `b`'s union with its type arguments still open, as `None` and
// `Err(e)` type on their own.
function vaguer_than(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if (type_contains_unknown(a) && !type_contains_unknown(b)) {
    return true;
  }
  if let typeinfo.TypeUnion(ua) = a {
    if let typeinfo.TypeUnion(ub) = b {
      return ua.name == ub.name && ua.args.len() == 0 && ub.args.len() > 0;
    }
  }
  if let typeinfo.TypeArray(xa) = a {
    if let typeinfo.TypeArray(xb) = b {
      return vaguer_than(xa.elem, xb.elem);
    }
  }
  return false;
}

function check_array_expr(a: ast.ExprArray, s: Scope): typeinfo.Type {
  if (a.elements.len() == 0) {
    // Parser settlement (the destination's element type) and embed
    // expansion both stamp a literal's element type, which is authoritative.
    if (a.elem_ty.len() > 0) {
      return t_array(s.resolve_type(a.elem_ty));
    }
    return t_array(t_unknown("empty array literal"));
  }
  // An unsuffixed literal takes a concrete sibling's type, as in
  // call_diags_array's E034 rule.
  // A payload its constructor left unbound (`e` in `Err(e)` over an
  // un-annotated `Ok(5)`) is never held, so it constrains no sibling.
  let first: typeinfo.Type = check_expr(a.elements[0], s);
  let first_lit: i32 = numeric_literal_kind(a.elements[0]);
  let first_expr: ast.Expr = a.elements[0];
  let i: i32 = 1;
  while (i < a.elements.len()) {
    let et: typeinfo.Type = check_expr(a.elements[i], s);
    if (unbound_enum_argument(et)) {
      i = i + 1;
      continue;
    }
    if (unbound_enum_argument(first)) {
      first = et;
      first_lit = numeric_literal_kind(a.elements[i]);
      first_expr = a.elements[i];
      i = i + 1;
      continue;
    }
    let lit: i32 = numeric_literal_kind(a.elements[i]);
    // A mismatch is call_diags_array's E034; the literal keeps its
    // first element's type, as native types it. A sibling only ever makes
    // it more concrete: `None` after `Some(1)` keeps `Option[i32]`.
    if (!vaguer_than(et, first) && !literal_gives_way(lit, first) && !struct_lit_gives_way(a.elements[i], et, first, s)
      && (same_element_type(et, first) || literal_gives_way(first_lit, et))
      || struct_lit_gives_way(first_expr, first, et, s)) {
      first = et;
      first_lit = lit;
      first_expr = a.elements[i];
    }
    i = i + 1;
  }
  return t_array(first);
}

// struct_lit_gives_way is whether `e`, a generic struct literal of type
// `from`, takes a sibling's instantiation `to` instead: every argument the two
// differ in is one only untyped integer literals of `e` bound, and `to` reads
// it as an integer — `Same { a: 1, b: 2 }` beside a Same[i64].
function struct_lit_gives_way(e: ast.Expr, from: typeinfo.Type, to: typeinfo.Type, s: Scope): boolean {
  return struct_lit_yields(e, from, to, s, false);
}

// struct_lit_yields is struct_lit_gives_way, letting the literals give way to
// a float argument too when `to_float` is set: an integer literal is a valid
// f64, so E034 holds back, though the element type stays the literal's own.
function struct_lit_yields(e: ast.Expr, from: typeinfo.Type, to: typeinfo.Type, s: Scope, to_float: boolean): boolean {
  if let ast.ExprStructLit(sl) = e {
    if let typeinfo.TypeStruct(fs) = from {
      if let typeinfo.TypeStruct(ts) = to {
        let sig: StructSig = s.lookup_struct(sl.type_name);
        if (sl.written.len() > 0 || fs.name != ts.name || fs.args.len() != ts.args.len() || sig.type_params.len() != fs.args.len()) {
          return false;
        }
        let lit: ast.Expr[] = [sl];
        let differs: boolean = false;
        let k: i32 = 0;
        while (k < fs.args.len()) {
          if (typeinfo.spelling(fs.args[k]) != typeinfo.spelling(ts.args[k])) {
            let es: ast.Expr[] = struct_param_exprs(sig, sig.type_params[k], lit, s);
            if (es.len() == 0 || !is_integer(ts.args[k]) && !(to_float && is_float(ts.args[k]))) {
              return false;
            }
            for pe in es {
              if (!int_literal_tree(pe)) {
                return false;
              }
            }
            differs = true;
          }
          k = k + 1;
        }
        return differs;
      }
    }
  }
  return false;
}

function check_index_expr(x: ast.ExprIndex, s: Scope): typeinfo.Type {
  return index_result_type(check_expr(x.array, s), check_expr(x.index, s));
}

// index_result_type is check_index_expr over the checked array and index types.
function index_result_type(at: typeinfo.Type, it: typeinfo.Type): typeinfo.Type {
  if (!is_integer(it)) {
    return t_unknown("array index must be an integer");
  }
  match (at) {
    typeinfo.TypeArray(ta) => {
      return ta.elem;
    },
    typeinfo.TypeString(_) => {
      // String indexing yields the byte as `u8`, the byte type
      // (#5629) — same semantics as the production Fern pipeline.
      // This is what lets `s[i].is_ascii_digit()` find the
      // classifiers, which are declared on a u8 receiver.
      return t_u8();
    },
    _ => {
      return t_unknown("can only index into an array or string");
    }
  }
  return t_unknown("unreachable index arm");
}

function check_slice_expr(sl: ast.ExprSlice, s: Scope): typeinfo.Type {
  let at: typeinfo.Type = check_expr(sl.array, s);
  let st: typeinfo.Type = check_expr(sl.start, s);
  let et: typeinfo.Type = check_expr(sl.end, s);
  if (!is_integer(st)) {
    return t_unknown("slice start must be i32");
  }
  if (!is_integer(et)) {
    return t_unknown("slice end must be i32");
  }
  match (at) {
    typeinfo.TypeArray(_) => {
      // A window of an array, or of another window, is a `[T]` view.
      return as_view(at);
    },
    typeinfo.TypeString(_) => {
      // `s[a:b]` on a string is bounds- and codepoint-boundary-checked
      // (#5634), so it yields `Option[str]`. The unchecked byte slice
      // keeps its `string` type under `slice_unchecked`.
      let slcoa: typeinfo.Type[] = [t_str()];
      return t_union_g("Option", slcoa);
    },
    _ => {
      return t_unknown("can only slice array or string");
    }
  }
  return t_unknown("unreachable slice arm");
}

function check_struct_lit_expr(sl: ast.ExprStructLit, s: Scope): typeinfo.Type {
  // Look up the struct decl. Verify the literal's
  // fields cover the declared shape — same field
  // names, in declaration order, with matching types.
  let ssig: StructSig = s.lookup_struct(sl.type_name);
  if (ssig.name.len() == 0) {
    return t_unknown("undefined struct: " + sl.type_name);
  }
  if (sl.has_base) {
    // Struct-update `Name { ...base, f: v }`: the base
    // supplies the un-overridden fields, so completeness
    // and declaration-order are relaxed — a subset of
    // overrides is legal. The base must itself be a value
    // of the same struct type. Each override must name a
    // declared field with a matching type.
    let bt: typeinfo.Type = check_expr(sl.base, s);
    if (!type_eq(bt, t_struct(sl.type_name))) {
      return t_unknown("struct " + sl.type_name + " update base type mismatch");
    }
    let ui: i32 = 0;
    while (ui < sl.field_names.len()) {
      let uname: string = sl.field_names[ui];
      let found: boolean = false;
      let ufi: i32 = 0;
      while (ufi < ssig.field_names.len()) {
        if (ssig.field_names[ufi] == uname) {
          found = true;
          let uft: typeinfo.Type = check_expr(sl.field_values[ui], s);
          // A field whose declared type erases a type
          // parameter to unknown — bare (`Box[T] { v: T }`) or
          // nested (`Wrapper[T] { items: T[] }`) — is an
          // opaque generic field; any value is acceptable, so
          // skip rather than mis-flag a mismatch (#4346 piece
          // 2, mirrors the opaque-param skips elsewhere).
          if (!type_contains_unknown(ssig.field_types[ufi])
            && !settles_to(sl.field_values[ui], ssig.field_types[ufi], s)
            && !coercible(uft, ssig.field_types[ufi], s)) {
            return t_unknown("struct " + sl.type_name + " field `" + uname + "` type mismatch");
          }
        }
        ufi = ufi + 1;
      }
      if (!found) {
        return t_unknown("struct " + sl.type_name + " has no field `" + uname + "`");
      }
      ui = ui + 1;
    }
    return bt;
  }
  if (sl.field_names.len() != ssig.field_names.len()) {
    return t_unknown("struct " + sl.type_name + " field count mismatch");
  }
  // Field ORDER is free — a literal may write the declared fields in
  // any order. Resolve each written name against the declaration and
  // check its value against THAT field's type. The count matched
  // above, so "every declared field written exactly once" follows
  // from no name repeating and none being undeclared.
  let swritten: boolean[] = __alloc_bool(ssig.field_names.len());
  let sli: i32 = 0;
  while (sli < sl.field_names.len()) {
    let sfi: i32 = field_index(ssig, sl.field_names[sli]);
    if (sfi < 0) {
      return t_unknown("struct " + sl.type_name + " has no field `" + sl.field_names[sli] + "`");
    }
    if (swritten[sfi]) {
      return t_unknown("struct " + sl.type_name + " field `" + sl.field_names[sli] + "` written twice");
    }
    swritten = swritten.with(sfi, true);
    let ft: typeinfo.Type = check_expr(sl.field_values[sli], s);
    // An opaque generic field — bare (`Box[T] { v: T }`, T →
    // unknown) or nested (`items: T[]` → array<unknown>) — accepts
    // any value; skip the check (#4346 piece 2).
    //
    // The value is judged AGAINST the declared field type, by the
    // same pair every other destination uses: an unsuffixed literal
    // settles to the field's width, and a member widens to a
    // union-typed field. Tag-blind equality alone refused both, and
    // refusing collapsed the whole literal to unknown (#9042).
    if (!type_contains_unknown(ssig.field_types[sfi])
      && !settles_to(sl.field_values[sli], ssig.field_types[sfi], s)
      && !coercible(ft, ssig.field_types[sfi], s)) {
      return t_unknown("struct " + sl.type_name + " field `" + sl.field_names[sli] + "` type mismatch");
    }
    sli = sli + 1;
  }
  if (ssig.type_params.len() == 0) {
    return t_struct(sl.type_name);
  }
  let largs: typeinfo.Type[] = struct_lit_args(sl, ssig, s);
  if (lit_uninferable_param(sl, ssig, largs, s).len() > 0) {
    return t_unknown("struct " + sl.type_name + " has a type argument nothing binds");
  }
  if (lit_field_clash(sl, ssig, largs, s) >= 0) {
    return t_unknown("struct " + sl.type_name + " fields disagree on a type argument");
  }
  return typeinfo.TypeStruct { name: sl.type_name, args: largs };
}

function check_field_access_expr(fa: ast.ExprFieldAccess, s: Scope): typeinfo.Type {
  // A qualified UNIT variant `Color.Red` in VALUE position is not a field
  // read at all — the object is a bare ENUM NAME, not a value — so it has
  // to be resolved before the object is checked as one. Same rule as the
  // constructor form above.
  let vqu: string = qual_variant_union(fa, s);
  if (vqu.len() > 0) {
    return t_union(vqu);
  }
  return field_access_result_type(fa, check_expr(fa.obj, s), s);
}

// field_access_result_type is check_field_access_expr over the object's
// checked type, for a read that is not a qualified unit variant.
function field_access_result_type(fa: ast.ExprFieldAccess, ot: typeinfo.Type, s: Scope): typeinfo.Type {
  // `r.fd` on a stream handle (Reader, Writer, Dir): the descriptor, an
  // i32, as the Go checker's builtin declarations and the lowering have it.
  // The handles are declared nowhere in the self-host's struct table.
  if (fa.field == "fd" && semtypes.is_fd_handle(ot)) {
    return t_i32();
  }
  match (ot) {
    typeinfo.TypeStruct(sn) => {
      return struct_field_type(sn, fa.field, s);
    },
    typeinfo.TypeTuple(tt) => {
      // Tuple field is `.0` / `.1` / … — parse the
      // digit string back to an i32 index.
      let idx: i32 = digit_string_to_i32(fa.field);
      if (idx < 0 || idx >= tt.elements.len()) {
        return t_unknown("tuple index `" + fa.field + "` out of range");
      }
      return tt.elements[idx];
    },
    _ => {
      return t_unknown("can only field-access a struct or tuple");
    }
  }
  return t_unknown("unreachable field-access arm");
}

// struct_field_type is the declared type of field `field` of the struct `sn`
// names. When `sn` carries instantiation arguments (`Box[i32]`) they replace
// the struct's type parameters throughout the field's spelling, so `v: T`,
// `items: T[]` and `f: (T) => T` read as i32, i32[] and (i32) => i32.
function struct_field_type(sn: typeinfo.TypeStruct, field: string, s: Scope): typeinfo.Type {
  let fsig: StructSig = s.lookup_struct(sn.name);
  if (fsig.name.len() == 0) {
    return t_unknown("undefined struct: " + sn.name);
  }
  let fai: i32 = field_index(fsig, field);
  if (fai < 0) {
    return t_unknown("struct " + sn.name + " has no field `" + field + "`");
  }
  if (fai < fsig.field_type_names.len() && fsig.type_params.len() > 0 && sn.args.len() > 0) {
    let fref: parser.TypeRef = parser.parse_type_ref(fsig.field_type_names[fai]);
    if (sn.args.len() != fsig.type_params.len()) {
      return type_from_ref_subst(fref, fsig.type_params, rigid_tparams(fsig.type_params), s.type_names());
    }
    return type_from_ref_subst(fref, fsig.type_params, sn.args, s.type_names());
  }
  return fsig.field_types[fai];
}

function check_lambda_expr(lm: ast.ExprLambda, s: Scope): typeinfo.Type {
  // Resolve param + ret types through the existing
  // struct + union tables. The body is type-checked
  // in a derived scope where params are bound. Free
  // idents in the body still resolve against the
  // surrounding scope (lexical capture).
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(s.resolve_param(param));
  }
  let rt: typeinfo.Type = lambda_ret_type(lm, s);
  // Walk the body for side-effect checks. The body's
  // returns are checked against the lambda's own
  // ret_type (when one is declared), not the enclosing
  // function's.
  let body_scope: Scope = lambda_body_scope(lm, s);
  check_block(lm.body, body_scope);
  // A lambda that spells no result returns what its body returns: the
  // first value-carrying `return`, typed in the scope at that statement.
  // A written lambda returning no value is void, as native infers it.
  if (lm.ret_type.len() == 0 && is_unknown(rt)) {
    let (returned, at) = first_returned(lm.body, body_scope);
    if (!parser.bare_return(returned)) {
      let inferred: typeinfo.Type = check_expr(returned, at);
      if (!is_unknown(inferred)) {
        rt = inferred;
      }
    } else if (!parser.is_value_block_origin(lm.origin)) {
      rt = t_void();
    }
  }
  return t_func_own(pts, lambda_owns(lm), rt);
}

// check_stmt returns the updated scope (StmtVar binds a new name)
// and the inferred type of the contained expression, packaged so
// the validation harness can assert per-statement.
pub struct CheckResult { scope: Scope, ty: typeinfo.Type }

pub function check_stmt(st: ast.Stmt, s: Scope): CheckResult {
  match (st) {
    ast.StmtDefer(d) => {
      // StmtDefer is lowered away before emit; check its action.
      return check_stmt(d.action, s);
    },
    ast.StmtVar(v) => {
      let init_scope: Scope = rec_local_scope(v, s);
      let t: typeinfo.Type = check_expr(v.init, init_scope);
      // A destructuring `let` declares its bindings under ONE
      // comma-joined name, paired with the marker channel — binding that
      // encoding as if it were a variable leaves every real name unresolved,
      // and for a single-field struct destructure binds the one real name to
      // the WHOLE struct. Bind what the pattern actually declares instead.
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return CheckResult { scope: bind_destructure_names(s, v), ty: t };
      }
      // If the source carries a `: Type` annotation,
      // resolve it via the scope's struct + union tables
      // and use it as the binding's type. The init type
      // must be assignable to the annotation (so a
      // variant value flows into a union slot via the
      // existing type_assignable widening).
      if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name)) {
        let declared: typeinfo.Type = var_declared_type(v, s);
        if (is_unknown(declared)) {
          return CheckResult { scope: s.bind(v.name, declared), ty: declared };
        }
        if (!init_fits(v.init, t, declared, init_scope)) {
          let err: typeinfo.Type = t_unknown("var `" + v.name + "`: init type doesn't match annotation `" + v.type_name + "`");
          return CheckResult { scope: s.bind(v.name, declared), ty: err };
        }
        return CheckResult { scope: s.bind(v.name, declared), ty: declared };
      }
      return CheckResult { scope: s.bind_inferred(v, t), ty: t };
    },
    ast.StmtReturn(r) => {
      // A bare `return;` yields no value. The parser leaves an
      // ExprUnknown(BARE_RETURN) sentinel in r.value, which types as
      // unknown and would mark the enclosing body ill-typed (#6649).
      let bare_ret: boolean = false;
      match (r.value) {
        ast.ExprUnknown(bu) => {
          if (bu.kind == parser.BARE_RETURN) {
            bare_ret = true;
          }
        },
        _ => {}
      }
      if (bare_ret) {
        return CheckResult { scope: s, ty: t_void() };
      }
      let t: typeinfo.Type = check_expr(r.value, s);
      // Compare against the enclosing function's declared
      // ret_type when one is set (top-level stmts have an
      // "no enclosing function" sentinel and skip the
      // check). If the declared ret_type itself is unknown
      // (unresolved type name) we already surfaced that at
      // the FuncSig collection step — skip the comparison
      // to avoid double-reporting.
      match (s.ret_type) {
        typeinfo.TypeUnknown(_) => {
          return CheckResult { scope: s, ty: t };
        },
        _ => {}
      }
      if (is_unknown(t)) {
        // A generic function named as the value has the declared callable
        // type when that binds every one of its type parameters, and a
        // generic call whose result only the destination binds has the
        // declared type. So does a value block whose tail adapts to it.
        let (ret_block, is_block) = value_block_body(r.value);
        if (is_block && vb_settles(ret_block, s.ret_type, s) || (generic_fn_value_arg(r.value, s) || dest_bound_result(r.value, s)) && settles_to(r.value, s.ret_type, s)) {
          return CheckResult { scope: s, ty: s.ret_type };
        }
        return CheckResult { scope: s, ty: t };
      }
      if (!settles_to(r.value, s.ret_type, s) && !coercible(t, s.ret_type, s)) {
        return CheckResult { scope: s, ty: t_unknown("return type doesn't match declaration") };
      }
      return CheckResult { scope: s, ty: t };
    },
    ast.StmtExpr(x) => {
      let t: typeinfo.Type = check_expr(x.value, s);
      return CheckResult { scope: s, ty: t };
    },
    ast.StmtIf(ifs) => {
      // cond must be bool. Branches type-check in fresh
      // scopes that share `s` as parent — bindings inside a
      // branch don't leak out (the Scope passed back from
      // check_stmt for the branch's stmts is intentionally
      // discarded). The if-statement itself surfaces
      // TypeBool on success and TypeUnknown on a non-bool
      // cond — there's no enclosing-expression type yet
      // (no `if`-expression form in the parser stub), so
      // the type slot is just a checker-side bookkeeping
      // value.
      let ct: typeinfo.Type = check_expr(ifs.cond, s);
      if (!type_eq(ct, t_bool())) {
        check_block(ifs.then_body, s);
        check_block(ifs.else_body, s);
        return CheckResult { scope: s, ty: t_unknown("if cond not bool") };
      }
      let thenOk: boolean = check_block(ifs.then_body, s);
      let elseOk: boolean = check_block(ifs.else_body, s);
      if (!thenOk || !elseOk) {
        return CheckResult { scope: s, ty: t_unknown("if: ill-typed branch") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtWhile(w) => {
      // Same shape as if: cond must be bool, body walks in a
      // derived scope. The body sees loop_depth+1 so any
      // break / continue inside type-checks. Loop control
      // flow has no static type; the checker surfaces
      // TypeBool on success / TypeUnknown on a non-bool cond.
      let wt: typeinfo.Type = check_expr(w.cond, s);
      let body_scope: Scope = s.enter_loop();
      if (!type_eq(wt, t_bool())) {
        check_block(w.body, body_scope);
        return CheckResult { scope: s, ty: t_unknown("while cond not bool") };
      }
      let bodyOk: boolean = check_block(w.body, body_scope);
      if (!bodyOk) {
        return CheckResult { scope: s, ty: t_unknown("while: ill-typed body") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtAssign(a) => {
      // Target must already be bound; types of LHS and RHS
      // must match. Type-mismatched or undefined-target
      // assigns surface TypeUnknown so a future "collect-
      // errors" pass can harvest them. The scope is
      // unchanged — assignment doesn't introduce a new
      // binding.
      let existing: typeinfo.Type = s.lookup(a.target);
      if (is_unknown(existing)) {
        return CheckResult { scope: s, ty: t_unknown("assign to undefined `" + a.target + "`") };
      }
      let vt: typeinfo.Type = check_expr(a.value, s);
      if (is_unknown(vt)) {
        return CheckResult { scope: s, ty: vt };
      }
      if (!settles_to(a.value, existing, s) && !coercible(vt, existing, s)) {
        return CheckResult { scope: s, ty: t_unknown("type mismatch in assign to `" + a.target + "`") };
      }
      return CheckResult { scope: s, ty: vt };
    },
    ast.StmtMatch(m) => {
      // Type-check the scrutinee. An ill-typed scrutinee
      // surfaces as TypeUnknown and the whole match is
      // marked unknown — we still walk arm bodies so a
      // later "collect-errors" pass can harvest inner
      // diagnostics.
      let sct: typeinfo.Type = check_expr(m.scrutinee, s);
      let ok: boolean = !is_unknown(sct);
      // If the scrutinee is a TypeUnion, the union's
      // variant list is the authoritative set; PatVariant
      // arms must reference a member. If it's a TypeStruct,
      // PatVariant arms must reference that struct name
      // (anything else is a never-match).
      let union_name: string = "";
      let struct_name: string = "";
      match (sct) {
        typeinfo.TypeUnion(u) => {
          union_name = u.name;
        },
        typeinfo.TypeStruct(sn) => {
          struct_name = sn.name;
        },
        _ => {}
      }
      for arm in m.arms {
        // Derived scope per arm — bindings die at the
        // arm's close. The outer scope `s` is what we
        // return after the match.
        let armScope: Scope = s;
        match (arm.pattern) {
          ast.PatWildcard(_) => {},
          ast.PatVariant(pv) => {
            let pvn: string = variant_pattern_name(pv.type_name);
            let ss: StructSig = s.lookup_variant(pvn);
            // Option's and Result's variants have no struct sig, and no
            // built-in enum is in the union table.
            let builtin_arm: boolean = union_name.len() > 0 && parser.builtin_enum_of(pvn) == union_name;
            if (ss.name.len() == 0 && !builtin_arm) {
              ok = false;
            } else {
              // Variant must be compatible with
              // the scrutinee's type. For a union
              // scrutinee: variant must be in the
              // union's variant list. For a struct
              // scrutinee: variant must match the
              // struct's name.
              if (union_name.len() > 0) {
                if (!builtin_arm && !is_variant_of(pvn, union_name, s.unions.unions)) {
                  ok = false;
                }
              } else if (struct_name.len() > 0) {
                if (struct_name != pvn) {
                  ok = false;
                }
              }
              // Bring the payload bindings into the arm's
              // scope, each typed as the matching `__ev` field.
              // Bare names and `_` bindings stay out of scope.
              armScope = bind_variant_payloads(armScope, s, pv, sct);
            }
          }
        }
        if (!check_block(arm.body, armScope)) {
          ok = false;
        }
      }
      if (!ok) {
        return CheckResult { scope: s, ty: t_unknown("match: ill-typed arm or scrutinee") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtBreak(_) => {
      if (s.loop_depth == 0) {
        return CheckResult { scope: s, ty: t_unknown("break outside loop") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtContinue(_) => {
      if (s.loop_depth == 0) {
        return CheckResult { scope: s, ty: t_unknown("continue outside loop") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtFor(f) => {
      let binding = for_binding(f, s);
      let fOk: boolean = check_block(f.body, binding.scope);
      if (!binding.valid) {
        return CheckResult { scope: s, ty: t_unknown("for-in: invalid iterator binding") };
      }
      if (!fOk) {
        return CheckResult { scope: s, ty: t_unknown("for-in: ill-typed body") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtUnknown(u) => {
      return CheckResult { scope: s, ty: t_unknown("parser-side unknown stmt:" + u.kind) };
    }
  }
  return CheckResult { scope: s, ty: t_unknown("unhandled Stmt variant") };
}

// bind_stmt is check_stmt's SCOPE half: what a statement does to the name
// environment, without the type inference that fills CheckResult.ty.
//
// The twelve diagnostic walkers that thread a scope through a body want only
// that half — every one of them discards the type — so running full inference
// to obtain it type-checked the program thirteen times over: 14.41% of a
// `checker.fern` compile went into scope-only re-walks (#8181).
//
// Only ast.StmtVar rebinds, and only its unannotated form needs the
// initialiser inferred: an annotation binds what the annotation resolves to
// (check_stmt's three annotated returns differ only in the `ty` they report),
// and a destructuring pattern binds through bind_destructure_names, which
// takes the statement and the scope and nothing else.
//
// It must agree with check_stmt on every statement form — a form that binds
// in one and not the other silently breaks name resolution in all twelve
// passes, and the symptom is a spurious or missing diagnostic somewhere else
// entirely. Two gates hold them together: bind_stmt_parity_run.fern walks both
// over the same statements and reports every disagreement (driven by
// TestSelfHostBindStmtScopeParity), and
// TestCheckStmtAndBindStmtBindTheSameStatementForms (internal/testing/sourcelint) pins
// the set of arms that may rebind at all in each, so a NEW binding form cannot
// be added to one alone.
pub function bind_stmt(st: ast.Stmt, s: Scope): Scope {
  match (st) {
    ast.StmtDefer(d) => {
      return bind_stmt(d.action, s);
    },
    ast.StmtVar(v) => {
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return bind_destructure_names(s, v);
      }
      if (v.type_name.len() > 0) {
        return s.bind(v.name, var_declared_type(v, s));
      }
      return s.bind_inferred(v, check_expr(v.init, rec_local_scope(v, s)));
    },
    _ => {}
  }
  return s;
}

// check_block walks a body in a derived scope. The scope's
// bindings don't escape — the parent caller threads its own
// pre-block scope forward unchanged. Errors inside the block
// don't propagate up either; they'd surface as TypeUnknown on
// the offending statement, which a future "collect-errors" pass
// could harvest. For this minimal cut we just walk for the side
// effect of validating sub-expressions.
function check_block(body: ast.Stmt[], s: Scope): boolean {
  let cur: Scope = s;
  let ok: boolean = true;
  for stmt in body {
    let r: CheckResult = check_stmt(stmt, cur);
    cur = r.scope;
    if (is_unknown(r.ty)) {
      ok = false;
    }
  }
  return ok;
}

// check_program threads the scope through every statement in
// source order. Returns parallel arrays: one inferred type per
// statement so callers can spot-check the shape.
pub struct ProgramTypes { tys: typeinfo.Type[] }

function check_program(prog: ast.Stmt[]): ProgramTypes {
  let s: Scope = new_scope();
  let tys: typeinfo.Type[] = [];
  for stmt in prog {
    let r: CheckResult = check_stmt(stmt, s);
    s = r.scope;
    tys = tys.append(r.ty);
  }
  return ProgramTypes { tys: tys };
}

// collect_func_sigs builds the function-signature table from the
// module's FuncDecls. Resolves the parser's bare type-name strings
// to Types via type_from_name. The table is built in one pass and
// then passed to check_module's per-function body walk so calls
// (including recursive / mutually-recursive ones) can resolve.
// func_ret_type resolves a FuncDecl's declared return type.
function func_ret_type(fd: parser.FuncDecl, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  if (fd.ret_fn_ret.len() > 0 && parser.is_fn_contract_tag(fd.ret_type)) {
    return declared_callable_type(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types, tparams, subst, tn);
  }
  return type_from_name_subst(fd.ret_type, tparams, subst, tn);
}

// A lambda's own function type, as a binding of its name sees it.
function lambda_fn_type(lm: ast.ExprLambda, s: Scope): typeinfo.Type {
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(s.resolve_param(param));
  }
  return t_func_own(pts, lambda_owns(lm), lambda_ret_type(lm, s));
}

// rec_local_name is the name a `let`'s initialiser may call itself by, or "".
function rec_local_name(v: ast.StmtVar): string {
  if (ast.var_binds_itself(v)) {
    return v.name;
  }
  return "";
}

// rec_local_scope is the scope a `let`'s initialiser is checked in.
function rec_local_scope(v: ast.StmtVar, s: Scope): Scope {
  if let ast.ExprLambda(lm) = v.init {
    if (ast.var_binds_itself(v)) {
      return s.bind(v.name, lambda_fn_type(lm, s));
    }
  }
  return s;
}

// bind_mutual_siblings binds, ahead of a statement list, the nested functions
// in it that call one another around a cycle — native's checkBlock pre-pass.
// A function recursive only through itself binds through rec_local_scope.
function bind_mutual_siblings(stmts: ast.Stmt[], s: Scope): Scope {
  let fns: parser.NestedFn[] = parser.nested_fns(stmts);
  let out: Scope = s;
  for f in fns {
    if (parser.nested_fn_cycle(fns, f.name).len() > 1) {
      out = out.bind(f.name, lambda_fn_type(f.lam, s));
    }
  }
  return out;
}

// The result of a lambda that spells none, until its body's exits settle it.
const INFERRED_RESULT: string = "inferred lambda result";

// A lambda's declared result, through the sidecars a function-valued result
// is spelled in: the pair a declaration's `ret_fn_ret` carries.
function lambda_ret_type(lm: ast.ExprLambda, s: Scope): typeinfo.Type {
  if (lm.ret_type.len() == 0) {
    // A use callback inherits the declared result of its enclosing function.
    if (lm.origin == parser.ORIGIN_USE && !is_unknown(s.ret_type)) {
      return s.ret_type;
    }
    return t_unknown(INFERRED_RESULT);
  }
  if (lm.ret_fn_ret.len() > 0 && parser.is_fn_contract_tag(lm.ret_type)) {
    return declared_callable_type(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types, s.tparams, rigid_tparams(s.tparams), s.type_names());
  }
  return s.resolve_type(lm.ret_type);
}

// var_declared_type resolves a StmtVar's annotation.
function var_declared_type(v: ast.StmtVar, s: Scope): typeinfo.Type {
  if (v.fn_ret.len() > 0 && parser.is_fn_contract_tag(v.type_name)) {
    return declared_callable_type(v.type_name, v.fn_ret, v.fn_param_types, s.tparams, rigid_tparams(s.tparams), s.type_names());
  }
  return s.resolve_type(v.type_name);
}

function collect_func_sigs(funcs: parser.FuncDecl[], tn: TypeNames): FuncSig[] {
  let out: FuncSig[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let fd: parser.FuncDecl = funcs[i];
    // Skip receiver methods — they live in MethodSig table.
    if (fd.receiver_name.len() > 0) {
      i = i + 1;
      continue;
    }
    let pts: typeinfo.Type[] = [];
    let powns: boolean[] = [];
    let ptn: string[] = [];
    for param in fd.params {
      // A fn-typed param resolves through its sidecars to a real TypeFunc
      // (#5986's call-site half), so argument checks against it are live —
      // a lambda or named-function argument passes the fn-to-fn arm, a
      // non-function argument is a real mismatch.
      pts = pts.append(param_decl_type(param, fd.type_params, erased_tparams(fd.type_params), tn));
      powns = powns.append(param.own);
      ptn = ptn.append(parser.fn_tag_spelling(param.type_name, param.fn_ret, param.fn_param_types));
    }
    let tvs: string[] = [];
    for spelling in ptn {
      if (util.index_of_str(tvs, spelling) < 0 && gc_is_typevar_name(spelling, fd.type_params, tn)) {
        tvs = tvs.append(spelling);
      }
    }
    let rtn: string = parser.fn_tag_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types);
    out = out.append(FuncSig { receiver: fd.receiver_type, name: fd.name, param_types: pts, param_own: callable_own_flags(powns, pts.len()), ret_type: func_ret_type(fd, fd.type_params, erased_tparams(fd.type_params), tn), all_type_params: fd.all_type_params, type_params: fd.type_params, type_bounds: fd.bound_traits, ret_type_name: rtn, param_type_names: ptn, param_names: param_decl_names(fd.params), is_const: fd.is_const, typevars: tvs, module: fd.module, refs: generic_sig_refs(fd.all_type_params, ptn, rtn) });
    i = i + 1;
  }
  return out;
}

// MethodBinding is what a method call's type variables are bound to: the
// receiver's variables to its arguments, and those the call wrote to the
// written types. `full` is every type parameter, receiver's first.
struct MethodBinding { names: string[], types: typeinfo.Type[], full: string[] }

// method_binding binds a method call's type variables as native does (#9976):
// a written list names the whole parameter list, or when shorter the method's
// own parameters, the last ones.
function method_binding(c: ast.ExprCall, msig: MethodSig, recv: typeinfo.Type, s: Scope): MethodBinding {
  let rref: parser.TypeRef = parser.parse_type_ref(msig.receiver_type);
  let full: string[] = ref_type_vars(rref, msig.all_type_params, s, []);
  for tp in msig.all_type_params {
    if (!util.has_str(full, tp)) {
      full = full.append(tp);
    }
  }
  let names: string[] = [];
  let types: typeinfo.Type[] = [];
  let offset: i32 = full.len() - c.type_args.len();
  // Keep the in-range bindings even when E040 reports surplus arguments,
  // so a bad value argument still gets its own type diagnostic.
  if (offset < 0) {
    offset = 0;
  }
  let wi: i32 = 0;
  while (wi < c.type_args.len() && offset + wi < full.len()) {
    if (c.type_args[wi].len() > 0) {
      names = names.append(full[offset + wi]);
      types = types.append(type_from_spelling(c.type_args[wi], s.type_names()));
    }
    wi = wi + 1;
  }
  let (n2, t2) = gc_bind_param(rref, recv, full, s.type_names(), names, types);
  if (full.len() == 0) {
    return MethodBinding { names: n2, types: t2, full: full };
  }
  let mi: i32 = 0;
  while (mi < c.args.len() && mi < msig.param_type_names.len()) {
    let ref = parser.parse_type_ref(msig.param_type_names[mi]);
    let dest = type_from_ref_subst(ref, n2, t2, s.type_names());
    let actual = fn_value_at(c.args[mi], dest, s);
    let (n3, t3) = gc_bind_param(ref, actual, full, s.type_names(), n2, t2);
    n2 = n3;
    t2 = t3;
    mi = mi + 1;
  }
  return MethodBinding { names: n2, types: t2, full: full };
}

// ref_type_vars appends the type variables a receiver spelling names, in order:
// `Result[Result[T, E], E]` names T and E.
function ref_type_vars(r: parser.TypeRef, tparams: string[], s: Scope, acc: string[]): string[] {
  let out: string[] = acc;
  if (r.args.len() == 0) {
    if (gc_is_typevar_name(r.base, tparams, s.type_names()) && (util.has_str(tparams, r.base) || !util.has_str(s.tparams, r.base)) && !util.has_str(out, r.base)) {
      out = out.append(r.base);
    }
    return out;
  }
  for a in r.args {
    out = ref_type_vars(a, tparams, s, out);
  }
  return out;
}

// method_arg_diags checks each argument of a receiver-method call against its
// parameter with the receiver's type variables bound: E047 for a literal out of
// range, E038 for a mismatch, E034 for a composite array's elements. An opaque
// generic parameter is skipped, as the free-function check skips it.
function method_arg_diags(c: ast.ExprCall, method: string, msig: MethodSig, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let rmb: MethodBinding = method_binding(c, msig, recv, s);
  let mi: i32 = 0;
  while (mi < c.args.len() && mi < msig.param_types.len()) {
    let mat: typeinfo.Type = check_expr(c.args[mi], s);
    let want: typeinfo.Type = receiver_bound(msig.param_types[mi], param_type_name_at(msig, mi), rmb, s);
    out = util.append_diags(out, int_dest_range_diags(c.args[mi], want));
    // An unresolved function value gets E040 from its destination check.
    // Its abstract signature must not add a second mismatch here.
    let unresolved_value: boolean = false;
    if (generic_fn_value_arg(c.args[mi], s)) {
      if let ast.ExprIdent(id) = c.args[mi] {
        if let typeinfo.TypeFunc(wf) = want {
          let sig: FuncSig = s.lookup_sig(id.name);
          let (bn, bt) = fn_value_binds(sig, wf, s);
          unresolved_value = bn.len() != sig.all_type_params.len();
        }
      }
    }
    if (!unresolved_value && !is_unknown(want) && !bound_arg_accepts(c.args[mi], mat, want, s) && !generic_own_callback_accepts(mat, want, rmb.names, param_type_name_at(msig, mi), s)) {
      out = out.append(dg_at("E038", "argument " + util.i32_to_string(mi + 1) + " to \"" + method + "\": expected " + type_label(want) + ", got " + type_label(mat), expr_line(c.args[mi]), expr_col(c.args[mi])));
    }
    out = util.append_diags(out, array_elem_check(array_elem_type_of(msig.param_types[mi]), c.args[mi], s));
    mi = mi + 1;
  }
  let (bn, bt) = bounds_bindings(msig.type_params, msig.type_bounds, msig.module, s, rmb.names, rmb.types);
  return util.append_diags(out, call_bound_diags(msig.type_params, msig.type_bounds, msig.module, method_site(recv, msig.receiver_type, method), bn, bt, s, c.line, c.col));
}

// method_site names a method in a bound diagnostic as native does: by its
// receiver's namespace, or bare when the receiver is a type parameter, whose
// method a bound supplies.
function method_site(recv: typeinfo.Type, owner: string, method: string): string {
  if (is_unknown(recv) || is_type_variable(recv)) {
    return method;
  }
  return util.demangle(method_count_subject(recv, owner, method));
}

// method_type_arg_diags is E040 for a method call writing more type arguments
// than the method and its receiver have type parameters. The arguments the
// written ones bind are method_arg_diags' to check.
function method_type_arg_diags(c: ast.ExprCall, method: string, msig: MethodSig, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() == 0) {
    return out;
  }
  let full: i32 = method_binding(c, msig, recv, s).full.len();
  if (c.type_args.len() > full) {
    out = out.append(dg_at("E040", util.arity_message(method_count_subject(recv, msig.receiver_type, method), full, c.type_args.len(), "type argument"), c.line, c.col));
  }
  return out;
}

function method_count_subject(recv: typeinfo.Type, owner: string, method: string): string {
  if let typeinfo.TypeArray(a) = recv {
    return (if (a.view) { "slice" } else { "Array" }) + "." + method;
  }
  return util.base_type_name(owner) + "." + method;
}

// generic_method_ret is a method call's result with its type variables
// substituted: the receiver's and the written ones as `mb` binds them, and the
// method's own from its arguments (`r.and(Ok("vw"))` binds `U` to string) and
// then through its bounds. A variable nothing binds stays unknown.
function generic_method_ret(c: ast.ExprCall, msig: MethodSig, mb: MethodBinding, s: Scope): typeinfo.Type {
  if (!type_contains_unknown(msig.ret_type) || msig.ret_type_name.len() == 0) {
    return msig.ret_type;
  }
  let bn: string[] = mb.names;
  let bt: typeinfo.Type[] = mb.types;
  // method_binding already inferred every argument against this same scope.
  let (bn3, bt3) = bounds_bindings(msig.type_params, msig.type_bounds, msig.module, s, bn, bt);
  bn = bn3;
  bt = bt3;
  for tp in mb.full {
    if (util.index_of_str(bn, tp) < 0) {
      bn = bn.append(tp);
      bt = bt.append(t_unknown(TPARAM_MARK + tp));
    }
  }
  if (bn.len() == 0) {
    return msig.ret_type;
  }
  return type_from_ref_subst(parser.parse_type_ref(msig.ret_type_name), bn, bt, s.type_names());
}

// receiver_bound is `t`, spelled `spelling`, with the receiver's type
// parameters bound as `mb` binds them, when `t` holds an erased one.
function receiver_bound(t: typeinfo.Type, spelling: string, mb: MethodBinding, s: Scope): typeinfo.Type {
  if (!type_contains_unknown(t) || spelling.len() == 0 || mb.names.len() == 0) {
    return t;
  }
  return type_from_ref_subst(parser.parse_type_ref(spelling), mb.names, mb.types, s.type_names());
}

function param_type_name_at(msig: MethodSig, i: i32): string {
  if (i < msig.param_type_names.len()) {
    return msig.param_type_names[i];
  }
  return "";
}

// same_nominal reports whether two types are both the struct, or both the
// enum, of one name.
function same_nominal(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(au) = a {
    if let typeinfo.TypeUnion(bu) = b {
      return au.name == bu.name;
    }
  }
  if let typeinfo.TypeStruct(ast_) = a {
    if let typeinfo.TypeStruct(bs) = b {
      return ast_.name == bs.name;
    }
  }
  return false;
}

// nominal_args are a struct, enum or Map type's arguments, or none for any other.
function nominal_args(t: typeinfo.Type): typeinfo.Type[] {
  if let typeinfo.TypeStruct(st) = t {
    return st.args;
  }
  if let typeinfo.TypeUnion(u) = t {
    return u.args;
  }
  if let typeinfo.TypeMap(m) = t {
    return [m.key, m.value];
  }
  return [];
}

function is_dyn_slot(t: typeinfo.Type): boolean {
  if let typeinfo.TypeDyn(_) = t {
    return true;
  }
  return false;
}

// fills_unsettled_argument reports whether `from` settles an enum argument that
// `to` leaves unsettled: a binding of `None` or `Ok(1)` never holds the payload
// its construction did not name, so `Some(3)` or `Err(2)` cannot be stored in it.
function fills_unsettled_argument(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(fu) = from {
    if let typeinfo.TypeUnion(tu) = to {
      if (fu.name != tu.name) {
        return false;
      }
      let i: i32 = 0;
      while (i < fu.args.len()) {
        let open: boolean = tu.args.len() == 0 || i < tu.args.len() && unbound_enum_argument(tu.args[i]);
        if (open && !is_unknown(fu.args[i])) {
          return true;
        }
        i = i + 1;
      }
    }
  }
  return false;
}

// nominal_args_clash reports whether two instances of one generic struct or
// enum disagree on an argument. An argument unknown on either side is no
// constraint, as a tuple element is not (type_eq compares the name alone).
function nominal_args_clash(from: typeinfo.Type, to: typeinfo.Type, unions: UnionSig[]): boolean {
  if (!same_nominal(from, to)) {
    return false;
  }
  let fa: typeinfo.Type[] = nominal_args(from);
  let ta: typeinfo.Type[] = nominal_args(to);
  if (fa.len() != ta.len()) {
    return fa.len() > 0 && ta.len() > 0;
  }
  let i: i32 = 0;
  while (i < fa.len()) {
    if (!is_unknown(fa[i]) && !is_unknown(ta[i]) && !nested_assignable(fa[i], ta[i], unions)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// type_ref_names_any reports whether a type spelling names any of `vars`.
function type_ref_names_any(r: parser.TypeRef, vars: string[]): boolean {
  if (util.has_str(vars, r.base)) {
    return true;
  }
  for a in r.args {
    if (type_ref_names_any(a, vars)) {
      return true;
    }
  }
  return false;
}

// collect_method_sigs builds the method-sig table from the
// module's FuncDecls — picking up only those with a non-empty
// receiver_name. Param types resolve through the same
// structs + unions tables as func sigs.
function collect_method_sigs(funcs: parser.FuncDecl[], tn: TypeNames): MethodSig[] {
  let out: MethodSig[] = [];
  for fd in funcs {
    if (fd.receiver_name.len() > 0) {
      let pts: typeinfo.Type[] = [];
      let ptn: string[] = [];
      for param in fd.params {
        // Same sidecar resolution as collect_func_sigs (#5986).
        pts = pts.append(param_decl_type(param, fd.type_params, erased_tparams(fd.type_params), tn));
        ptn = ptn.append(parser.fn_tag_spelling(param.type_name, param.fn_ret, param.fn_param_types));
      }
      let rtn: string = parser.fn_tag_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types);
      out = out.append(MethodSig { name: fd.name, receiver_type: receiver_namespace(fd.receiver_type), param_types: pts, ret_type: func_ret_type(fd, fd.type_params, erased_tparams(fd.type_params), tn), ret_type_name: rtn, param_type_names: ptn, all_type_params: fd.all_type_params, type_params: fd.type_params, type_bounds: fd.bound_traits, module: fd.module, impl_trait: fd.impl_trait, line: fd.line, col: fd.col, file: decl_file_label(fd) });
    }
  }
  return out;
}

// collect_struct_sigs builds the struct-decl table from the
// module's StructDecls. Field types are resolved via the same
// type_from_name path used for function params — bare strings
// like "i32" / "boolean" / "string", plus references to other
// declared structs.
function collect_struct_sigs(structs: parser.StructDecl[], union_names: string[], resources: string[]): StructSig[] {
  let out: StructSig[] = [];
  // First pass: build a name-only table so type_from_name
  // can resolve struct → struct references (e.g. a `Box`
  // with an `inner: Point` field needs Point already known).
  // Variants are left out as type_head_names leaves them.
  let unions: util.NameIndex = util.name_index(union_names);
  let names: string[] = [];
  for sd in structs {
    if (sd.enum_owner.len() == 0 || !unions.has(sd.name)) {
      names = names.append(sd.name);
    }
  }
  let tn: TypeNames = type_names(names, union_names, resources);
  // Second pass: resolve fields with the full name set
  // available. Struct-to-struct field references resolve via
  // the name set; union-typed fields (`f: SomeUnion`, `xs:
  // SomeUnion[]`) resolve via union_names so they don't fall
  // through to `unknown` and trip the field-value E043 check.
  for sd in structs {
    let fnames: string[] = [];
    let ftypes: typeinfo.Type[] = [];
    let ftnames: string[] = [];
    for elem in sd.fields {
      fnames = fnames.append(elem.name);
      if (elem.fn_ret.len() > 0 && parser.is_fn_contract_tag(elem.type_name)) {
        ftypes = ftypes.append(declared_callable_type(elem.type_name, elem.fn_ret, elem.fn_param_types, sd.type_params, erased_tparams(sd.type_params), tn));
      } else {
        ftypes = ftypes.append(type_from_spelling(elem.type_name, tn));
      }
      // The field's raw declared type spelling — kept so field access on
      // a generic-struct instantiation can recognise a field typed by a
      // type parameter (`v: T`) and substitute the concrete arg (#4346
      // piece 2).
      ftnames = ftnames.append(parser.fn_tag_spelling(elem.type_name, elem.fn_ret, elem.fn_param_types));
    }
    out = out.append(StructSig { name: sd.name, field_names: fnames, field_types: ftypes, type_params: sd.type_params, field_type_names: ftnames, variant_field_names: sd.variant_field_names, derives: sd.derives, enum_owner: sd.enum_owner, opaque: sd.opaque, module: sd.module });
  }
  return out;
}

// The five type-name resolvers. All map a type SPELLING to a Type and differ
// only in the name context they carry — full StructSig[]/UnionSig[] tables, bare
// name lists, or nothing — so all five funnel through one ladder
// (type_from_spelling -> type_from_ref_names). Sharing it is what stops them
// disagreeing about a SHAPE: a resolver modelling fewer of them answers
// `unknown`, and an unknown type widens silently into every consumer (#8459).
pub function type_from_name_with_structs(name: string, structs: StructSig[]): typeinfo.Type {
  return type_from_spelling(name, type_names(struct_sig_names(structs), [], []));
}

pub function type_from_name_with_struct_names(name: string, struct_names: string[]): typeinfo.Type {
  return type_from_spelling(name, type_names(struct_names, [], []));
}

// The two `_unions` resolvers are the context that can also name a union alias.
// A struct name and an alias name can't collide — collect_union_sigs rejects the
// overlap at module build time.
pub function type_from_name_with_structs_unions(name: string, structs: StructSig[], unions: UnionSig[]): typeinfo.Type {
  let union_names: string[] = union_sig_names(unions);
  return type_from_spelling(name, type_names(type_head_names(structs, union_names), union_names, []));
}

pub function type_from_name_with_names_and_unions(name: string, struct_names: string[], union_names: string[]): typeinfo.Type {
  return type_from_spelling(name, type_names(struct_names, union_names, []));
}

function struct_sig_names(structs: StructSig[]): string[] {
  let out: string[] = [];
  for sd in structs {
    out = out.append(sd.name);
  }
  return out;
}

function union_sig_names(unions: UnionSig[]): string[] {
  let out: string[] = [];
  for u in unions {
    out = out.append(u.name);
  }
  return out;
}

// Parse once, then resolve every constituent through the same structured
// ladder; a spelling the module's memo holds is read off it instead.
function type_from_spelling(name: string, tn: TypeNames): typeinfo.Type {
  // Read through a local: the stage0 pin's pre-codegen gate types a read
  // through a struct-typed field by the field's name across every struct
  // (#11066, fixed in asmcore here, not yet in the pin).
  let memo: SpellMemo = tn.spellings;
  let at: i32 = memo.names.find(name);
  if (at >= 0) {
    return memo.types[at];
  }
  return type_from_ref_names(parser.parse_type_ref(name), tn);
}

// type_from_ref_names is the one resolution ladder: parse the spelling once
// (parse_type_ref), then pattern-match on the tree. Resolution order is
// primitives → array → fn → tuple → Map → builtin generic enum → generic
// instantiation → struct → union → unknown. `render_type_ref(r)` recovers a
// node's canonical spelling for the scalar / struct / union name compares and
// the unknown reason; for canonical inputs (what the parser feeds every caller)
// this equals the original substring.
function enum_argument_from_ref(r: parser.TypeRef, tn: TypeNames): typeinfo.Type {
  if (parser.render_type_ref(r) == "$unbound") {
    return t_unknown("unbound lifted enum argument");
  }
  return type_from_ref_names(r, tn);
}

function type_from_ref_names(r: parser.TypeRef, tn: TypeNames): typeinfo.Type {
  // Array suffix `Elem[]` → TypeArray of the element, one `[]` peeled per level
  // (so `X[][]` nests). Checked FIRST, so a `Map[…][]` / `(A, B)[]` array wraps
  // its element rather than being read as a generic / tuple.
  if (r.array_depth > 0) {
    let elem: parser.TypeRef = parser.elem_type_ref(r);
    return t_array(type_from_ref_names(elem, tn));
  }
  if (r.is_view) {
    return t_view(type_from_ref_names(r.args[0], tn));
  }
  // array_depth == 0 below. `name` is this node's canonical spelling — the
  // primitive / struct / union key and the unknown-reason text.
  let name: string = parser.render_type_ref(r);
  // TypeRef retains a dyn trait set as a named leaf. Resolve it here so nested
  // parameters, tuples and containers obey the same rule as a top-level type.
  if (name.len() >= 5 && slice_unchecked(name, 0, 4) == "dyn ") {
    return t_dyn(slice_unchecked(name, 4, name.len()) + "");
  }
  if (names_resource_handle(name, tn)) {
    return resource_handle(name);
  }
  if (name == "i32") {
    return t_i32();
  }
  // `char` erases to an i32 SLOT, but it is not i32: it carries its own method
  // surface, so it resolves to t_char() and dispatches under "char". A resolver
  // that did not know it silently skipped every check on a char value — a bogus
  // char method went unreported while the Go checker raised E043 (#5922).
  if (name == "char") {
    return t_char();
  }
  if (name == "i64") {
    return t_i64();
  }
  if (name == "u8") {
    return t_u8();
  }
  if (name == "u32") {
    return t_u32();
  }
  if (name == "u64") {
    return t_u64();
  }
  if (name == "usize") {
    return t_usize();
  }
  if (name == "boolean") {
    return t_bool();
  }
  if (name == "string") {
    return t_string();
  }
  if (name == "str") {
    return t_str();
  }
  if (name == "f32") {
    return t_f32();
  }
  if (name == "f64") {
    return t_float();
  }
  if (typeinfo.lanes_width(name) > 0) {
    return t_lanes(typeinfo.lanes_width(name));
  }
  if (name == "void") {
    return t_void();
  }
  // Retained arrows have known arity, including zero. Only bare fn is opaque.
  if (parser.ref_is_fn_value(r)) {
    return callable_from_ref_names(r, tn);
  }
  if (name == "fn") {
    return t_func_opaque(t_unknown("fn result (the coarse tag records none)"));
  }
  // Tuple `(A, B, …)` → TypeTuple of its elements. Needs ≥2 elements (a single
  // `(T)` / `()` is not a tuple — it falls through to the name lookups →
  // unknown).
  if (r.is_tuple) {
    if (r.args.len() >= 2) {
      let elems: typeinfo.Type[] = [];
      for arg in r.args {
        elems = elems.append(type_from_ref_names(arg, tn));
      }
      return t_tuple(elems);
    }
  } else if (is_map_ref(r)) {
    // `Map[K, V]` → TypeMap. (The recursively-resolved key/value are passed
    // straight into t_map's return-position wrap — an intermediate
    // `var: Type = <recursive call>` doesn't reliably trigger the struct→union
    // wrap here; see the t_i32 note.)
    return t_map(type_from_ref_names(r.args[0], tn), type_from_ref_names(r.args[1], tn));
  } else if (is_cell_ref(r)) {
    return t_struct_g("Cell", [type_from_ref_names(r.args[0], tn)]);
  } else if (is_map_iter_ref(r)) {
    return t_struct_g("MapIter", [type_from_ref_names(r.args[0], tn), type_from_ref_names(r.args[1], tn)]);
  } else if (is_wide_map_ref(r)) {
    // A (never-emitted) 3+ arg `Map[K, A, B]`: the value is "everything after
    // the first comma" — the trailing args re-joined and resolved as one name
    // (→ unknown).
    let v_name: string = parser.render_type_ref(r.args[1]);
    let vk: i32 = 2;
    while (vk < r.args.len()) {
      v_name = v_name + ", " + parser.render_type_ref(r.args[vk]);
      vk = vk + 1;
    }
    return t_map(type_from_ref_names(r.args[0], tn), type_from_spelling(v_name, tn));
  }
  // Builtin generic enums (#4346 piece 2): `Option[T]` / `Result[T, E]` (and
  // the bare `IoError` / `Body`) resolve to a NAME-ONLY union — the
  // generic arguments are dropped, exactly as user enums are name-only in
  // this partial type system. Keyed off r.base (the pre-bracket name), so
  // both `Option` and `Option[i32]` land here. Without this the full
  // spelling `Option[i32]` matches no struct/union below and the annotation
  // collapsed to unknown, over-rejecting every `let o: Option[i32] = …`.
  if (parser.is_reserved_enum_name(r.base)) {
    // Capture the instantiation args (Option[i32] → args [i32]) so the
    // typed-IR annotation can reconstruct the full "Option[T]"/"Result[T,E]"
    // tag. Checker-behaviour-neutral: type_eq/assignability ignore union args.
    let uargs: typeinfo.Type[] = [];
    for arg in r.args {
      uargs = uargs.append(enum_argument_from_ref(arg, tn));
    }
    return t_union_g(r.base, uargs);
  }
  // User generic struct / union-alias instantiation (#4346 piece 2):
  // `Box[i32]` / `Foo[T]` resolves to the NAME-ONLY struct / union off
  // r.base, dropping the generic args (this partial type system carries
  // none — the same way builtin enums and non-generic names are name-only).
  // Without this the full spelling `Box[i32]` matched no declared name below
  // and collapsed to unknown, over-rejecting every `let b: Box[i32] = …`.
  // Only fires for an actual instantiation (args present); a bare `Box`
  // resolves through the full-spelling loop as before.
  if (r.args.len() > 0) {
    if (tn.structs.has(r.base)) {
      // Carry the resolved instantiation args so field access can
      // substitute a type-parameter field (`Box[i32].v` → i32);
      // assignability still ignores them (#4346 piece 2).
      let gargs: typeinfo.Type[] = [];
      for arg in r.args {
        gargs = gargs.append(type_from_ref_names(arg, tn));
      }
      return t_struct_g(r.base, gargs);
    }
    if (tn.unions.has(r.base)) {
      // Same for a generic ENUM, and for the same reason: a spelling that
      // drops the argument names the GENERIC, which the enum monomorphiser
      // has dropped by the time anything reads it back.
      let uinst: typeinfo.Type[] = [];
      for arg in r.args {
        uinst = uinst.append(enum_argument_from_ref(arg, tn));
      }
      return t_union_g(r.base, uinst);
    }
  }
  // Any other shape (a bare name, a single-element tuple, a Map with <2 args, a
  // non-Map generic whose base names no declared type) resolves by its full
  // spelling: struct → union → unknown.
  if (tn.structs.has(name)) {
    return t_struct(name);
  }
  if (tn.unions.has(name)) {
    return t_union(name);
  }
  // The front end injects Reader / Writer / MapIter / … as struct
  // declarations on every program (checker.go's builtinStructDecls), so
  // naming one resolves to that struct even though no module declares it.
  // Their FIELDS stay unregistered — `lookup_struct` misses, which is what
  // keeps `r.read_chunk(n)` a builtin method rather than an E043 field read,
  // and what keeps the handle out of the reference-counted shapes.
  //
  // `Map` and `Cell` are excluded: they are containers resolved by the
  // is_map_ref / is_cell_ref arms above, which need the instantiation, and
  // an argless spelling of either names no layout. Resolving those two here
  // would make `let m: Map = map_new(4)` — which native accepts — an E003
  // against a nominal nothing produces.
  if (parser.is_reserved_struct_name(name) && name != "Map" && name != "Cell") {
    return t_struct(name);
  }
  // Unknown-BASE generic `Foo[T]` (non-tuple, non-Map, base declared
  // nowhere): the Go checker's resolveType keeps this shape as an
  // `ast.EnumType{Foo}` — an *unknown enum* — so a match / if-let /
  // let-else on a value of this type draws E023 ("unknown enum") rather
  // than dissolving to unknown and staying silent. Mirror it: resolve to
  // a name-only union carrying the BASE name; `lookup_union` misses for
  // it, which is exactly the state the E023 emission keys off. A generic
  // whose base IS a declared struct or union keeps today's conservative
  // unknown resolution (the Go checker resolves those to the declared
  // type — no E023 — so they must not take this branch).
  if (!r.is_tuple && r.args.len() > 0 && r.base != "Map" && r.base != "Cell") {
    if (!tn.structs.has(r.base) && !tn.unions.has(r.base)) {
      return t_union(r.base);
    }
  }
  return t_unknown(UNRESOLVED_MARK + name);
}

// Keep callable construction separate from the scalar/nominal resolution ladder:
// its recursive parameter traversal needs no other ladder state.
function callable_from_ref_names(r: parser.TypeRef, tn: TypeNames): typeinfo.Type {
  let f: parser.TypeRef = parser.ref_ungroup(r);
  let params: typeinfo.Type[] = [];
  let owns: boolean[] = [];
  let i: i32 = 0;
  while (i + 1 < f.args.len()) {
    owns = owns.append(parser.ref_is_own(f.args[i]));
    params = params.append(type_from_ref_names(parser.ref_without_own(f.args[i]), tn));
    i = i + 1;
  }
  return t_func_own(params, owns, type_from_ref_names(parser.ref_fn_result(r), tn));
}

// type_from_ref_subst resolves a field's declared type spelling against a
// struct's concrete instantiation args — substituting each type-parameter leaf
// with the matching arg Type throughout the spelling (#4346 piece 2, nested
// generic field spellings). It mirrors type_from_ref_names's shape recursion
// (array peel, tuple, Map) but, at a bare non-generic leaf whose name is one of
// `tparams`, returns the corresponding `targs` entry instead of resolving the
// name. So for `Box[i32]` (v: T) `.v` is i32, for `Wrapper[i32]` (items: T[])
// `.items` is i32[], and for `Pair[i32, string]` (kv: (K, V)) `.kv` is
// (i32, string). Any leaf that is NOT a type parameter resolves through the
// plain resolver, so mixed spellings (`(T, i32)`) work. A nested generic-struct
// arg (`inner: Box[T]`) falls to the plain name-only resolution — its args are
// erased, matching how this partial type system carries no generic args on a
// bare name.
function type_from_ref_subst(r: parser.TypeRef, tparams: string[], targs: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  if (r.array_depth > 0) {
    let elem: parser.TypeRef = parser.elem_type_ref(r);
    return t_array(type_from_ref_subst(elem, tparams, targs, tn));
  }
  if (r.is_view) {
    return t_view(type_from_ref_subst(r.args[0], tparams, targs, tn));
  }
  if (!r.is_tuple && r.args.len() == 0) {
    let tpi: i32 = util.index_of_str(tparams, r.base);
    if (tpi >= 0 && tpi < targs.len()) {
      return targs[tpi];
    }
    // A projection off a rigid type variable (`H::Item`) is as opaque as
    // the variable.
    let sep: i32 = util.index_of_sub(r.base, "::");
    if (sep > 0) {
      let opi: i32 = util.index_of_str(tparams, slice_unchecked(r.base, 0, sep) + "");
      if (opi >= 0 && opi < targs.len() && is_type_variable(targs[opi]) && !is_unknown(targs[opi])) {
        return typeinfo.TypeErased { name: r.base };
      }
    }
  }
  if (parser.ref_is_fn_value(r)) {
    let f: parser.TypeRef = parser.ref_ungroup(r);
    let pts: typeinfo.Type[] = [];
    let owns: boolean[] = [];
    let i: i32 = 0;
    while (i + 1 < f.args.len()) {
      let ref: parser.TypeRef = parser.ref_without_own(f.args[i]);
      let param: typeinfo.Type = type_from_ref_subst(ref, tparams, targs, tn);
      // A generic consuming callback slot bound to a scalar has no unit to
      // transfer. This inference exception does not erase written own i32.
      let on: boolean = parser.ref_is_own(f.args[i]);
      if (type_ref_names_any(ref, tparams) && !typeinfo.ownable(param)) {
        on = false;
      }
      owns = owns.append(on);
      pts = pts.append(param);
      i = i + 1;
    }
    return t_func_own(pts, owns, type_from_ref_subst(parser.ref_fn_result(r), tparams, targs, tn));
  }
  if (r.is_tuple && r.args.len() >= 2) {
    let elems: typeinfo.Type[] = [];
    for arg in r.args {
      elems = elems.append(type_from_ref_subst(arg, tparams, targs, tn));
    }
    return t_tuple(elems);
  }
  if (r.base == "Map" && r.args.len() == 2) {
    return t_map(type_from_ref_subst(r.args[0], tparams, targs, tn), type_from_ref_subst(r.args[1], tparams, targs, tn));
  }
  let whole: typeinfo.Type = type_from_ref_names(r, tn);
  if (r.is_tuple || r.args.len() == 0) {
    return whole;
  }
  let sargs: typeinfo.Type[] = [];
  let decoded: typeinfo.Type[] = nominal_args(whole);
  let ai: i32 = 0;
  while (ai < r.args.len()) {
    if (ai < decoded.len() && unbound_enum_argument(decoded[ai])) {
      // Keep the enum resolver's internal marker while substituting the
      // neighboring declaration variables. Other unknowns still recurse.
      sargs = sargs.append(decoded[ai]);
    } else {
      sargs = sargs.append(type_from_ref_subst(r.args[ai], tparams, targs, tn));
    }
    ai = ai + 1;
  }
  return with_nominal_args(whole, sargs);
}

// with_nominal_args is a generic struct, enum or Map type with `args` in place of
// its own: `Box[U, E]` with U bound is Box[<U's type>, …], not the unknowns
// the plain resolver reads. Any other type is returned unchanged.
function with_nominal_args(t: typeinfo.Type, args: typeinfo.Type[]): typeinfo.Type {
  if (nominal_args(t).len() != args.len()) {
    return t;
  }
  if let typeinfo.TypeStruct(st) = t {
    return typeinfo.TypeStruct { name: st.name, args: args };
  }
  if let typeinfo.TypeUnion(u) = t {
    return typeinfo.TypeUnion { name: u.name, args: args };
  }
  if let typeinfo.TypeMap(_) = t {
    return t_map(args[0], args[1]);
  }
  return t;
}

// type_from_name_erasing_tparams resolves a type spelling written INSIDE a
// function that declares `tparams`. A type parameter is a type VARIABLE there,
// never a reference to a declared type sharing its name: in
// `min[T: Ord](a: T, b: T)`, `a` is the variable T however many `struct T`
// declarations the program holds. Modules are merged into one program before
// checking, so without the erasure a user `struct T` — or an enum variant `T`,
// which registers as one — captures the T of every stdlib generic and its body
// reads `a.cmp(b)` as a field of that struct. Native scopes the same lookup
// (#6118).
//
// This is the CALLER's reading of a generic signature: each parameter
// substitutes to unknown, for the call to infer; a spelling naming none of
// them resolves unchanged. The body's own reading is rigid_tparams.
// TPARAM_MARK is the reason a type variable erased to unknown carries; the rest
// of the reason is the variable's name.
const TPARAM_MARK: string = "type parameter ";

const UNRESOLVED_MARK: string = "unrecognised type name: ";

// A type variable reaches the checker as an UNKNOWN naming it: a promoted
// parameter as "type parameter T", an unpromoted one as the unresolved
// spelling itself, since parse_func_decl drops an unbounded parameter's name
// from the declaration. This reads the name back out of either reason.
pub function typevar_reason_name(reason: string): string {
  if (reason.len() > TPARAM_MARK.len() && util.str_has_prefix(reason, TPARAM_MARK)) {
    return slice_unchecked(reason, TPARAM_MARK.len(), reason.len()) + "";
  }
  if (reason.len() > UNRESOLVED_MARK.len() && util.str_has_prefix(reason, UNRESOLVED_MARK)) {
    return slice_unchecked(reason, UNRESOLVED_MARK.len(), reason.len()) + "";
  }
  return "";
}

// tvar_name is the type variable `t` is, when it is one bare, else "".
function tvar_name(t: typeinfo.Type): string {
  if let typeinfo.TypeUnknown(u) = t {
    let name: string = typevar_reason_name(u.reason);
    if (parser.looks_type_var(name)) {
      return name;
    }
  }
  return "";
}

// is_type_variable reports whether `t` is a bare type variable: one erased to
// the unknown naming it, or an erased column.
function is_type_variable(t: typeinfo.Type): boolean {
  if let typeinfo.TypeErased(_) = t {
    return true;
  }
  return tvar_name(t).len() > 0;
}

// unknown_beyond_tvars is type_contains_unknown with a type variable of the
// enclosing generic counted as known: a binding to one is the instantiation's
// to substitute, as the Go checker's instantiateFuncValue leaves it.
function unknown_beyond_tvars(t: typeinfo.Type): boolean {
  if (is_type_variable(t)) {
    return false;
  }
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return !unbound_enum_argument(t);
    },
    typeinfo.TypeArray(ae) => {
      return unknown_beyond_tvars(ae.elem);
    },
    typeinfo.TypeTuple(tt) => {
      for element in tt.elements {
        if (unknown_beyond_tvars(element)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeMap(m) => {
      return unknown_beyond_tvars(m.key) || unknown_beyond_tvars(m.value);
    },
    typeinfo.TypeStruct(sn) => {
      for arg in sn.args {
        if (unknown_beyond_tvars(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        if (unknown_beyond_tvars(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeFunc(f) => {
      if (unknown_beyond_tvars(f.ret_type)) {
        return true;
      }
      for param_type in f.param_types {
        if (unknown_beyond_tvars(param_type)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function type_from_name_erasing_tparams(name: string, tparams: string[], tn: TypeNames): typeinfo.Type {
  return type_from_name_subst(name, tparams, erased_tparams(tparams), tn);
}

// type_from_name_subst resolves `name` with each of `tparams` read as the
// type at the same index of `subst`.
function type_from_name_subst(name: string, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  // A top-level dyn trait set cannot name an enclosing type variable.
  if (tparams.len() == 0 || name.len() == 0 || name.len() >= 5 && slice_unchecked(name, 0, 4) == "dyn ") {
    return type_from_spelling(name, tn);
  }
  return type_from_ref_subst(parser.parse_type_ref(name), tparams, subst, tn);
}

// erased_tparams is what each of `tparams` resolves to in its generic's
// signature, as a caller reads it: unknown, for the call to infer.
function erased_tparams(tparams: string[]): typeinfo.Type[] {
  let erased: typeinfo.Type[] = [];
  for tp in tparams {
    erased = erased.append(t_unknown(TPARAM_MARK + tp));
  }
  return erased;
}

// rigid_tparams is what each of `tparams` is inside its own generic's body: a
// type variable, equal only to itself.
function rigid_tparams(tparams: string[]): typeinfo.Type[] {
  let rigid: typeinfo.Type[] = [];
  for tp in tparams {
    rigid = rigid.append(typeinfo.TypeErased { name: tp });
  }
  return rigid;
}

// gc_is_typevar_name reports whether a bare type NAME is a type VARIABLE of the
// callee. `tparams` is what the callee DECLARED, which is the authority: a user
// `struct T` does not stop `sort_by[T]`'s T being a variable. The
// resolves-to-nothing fallback catches the unbounded parameters parse_func_decl
// drops from the decl, so `f64` and a declared `Box` still cannot be read as
// variables.
function gc_is_typevar_name(n: string, tparams: string[], tn: TypeNames): boolean {
  if (n.len() == 0) {
    return false;
  }
  if (util.index_of_str(tparams, n) >= 0) {
    return true;
  }
  return type_contains_unknown(type_from_spelling(n, tn));
}

// gc_bind_param collects type-parameter bindings by unifying a parameter's
// declared type SPELLING against the ARGUMENT's actual type, structurally:
// `T[]` against an `f64[]` argument binds `T` to f64, a bare `T` binds
// directly, and a tuple or callable spelling descends element-wise — the only
// `T` in `filter[T, I](it: I, keep: (T) => boolean): T[]` is the lambda
// argument's parameter. It is the inference the exact-match rule at the call
// site (#4346 piece 2) explicitly left open — its own comment names "a return
// type param that appears only nested" as a further slice, and
// `enum2[T](xs: T[]): (i32, T)[]` is exactly that shape.
//
// First binding wins; a shape that does not line up contributes nothing rather
// than guessing, so an unbindable variable simply leaves the return type
// partially unknown and the caller falls back to the old behaviour.
//
// A CONTAINER return (`both[T](a: T, b: T): (T, T)`) keeps first-wins (#8722
// part 4).
function gc_bind_param(r: parser.TypeRef, at: typeinfo.Type, tparams: string[], tn: TypeNames, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  let ns: string[] = names;
  let ts: typeinfo.Type[] = types;
  if (r.array_depth > 0 || r.is_view) {
    match (at) {
      typeinfo.TypeArray(a) => {
        if (r.array_depth > 0) {
          return gc_bind_param(parser.elem_type_ref(r), a.elem, tparams, tn, ns, ts);
        }
        return gc_bind_param(r.args[0], a.elem, tparams, tn, ns, ts);
      },
      _ => {
        return (ns, ts);
      }
    }
  }
  if (parser.ref_is_fn_value(r)) {
    // An argument whose parameter list was never recorded is not an arity, so
    // it lines up with nothing — as does an argument that is no callable.
    if let typeinfo.TypeFunc(f) = at {
      let fr: parser.TypeRef = parser.ref_ungroup(r);
      if (f.params_known && f.param_types.len() + 1 == fr.args.len()) {
        let fi: i32 = 0;
        while (fi < f.param_types.len()) {
          let (fn2, ft2) = gc_bind_param(parser.ref_without_own(fr.args[fi]), f.param_types[fi], tparams, tn, ns, ts);
          ns = fn2;
          ts = ft2;
          fi = fi + 1;
        }
        let (rn2, rt2) = gc_bind_param(parser.ref_fn_result(r), f.ret_type, tparams, tn, ns, ts);
        ns = rn2;
        ts = rt2;
      }
    }
    return (ns, ts);
  }
  if (r.is_tuple && r.args.len() >= 2) {
    match (at) {
      typeinfo.TypeTuple(tp) => {
        if (tp.elements.len() == r.args.len()) {
          let ti: i32 = 0;
          while (ti < r.args.len()) {
            let (tn2, tt2) = gc_bind_param(r.args[ti], tp.elements[ti], tparams, tn, ns, ts);
            ns = tn2;
            ts = tt2;
            ti = ti + 1;
          }
        }
      },
      _ => {}
    }
    return (ns, ts);
  }
  let nargs: typeinfo.Type[] = nominal_args(at);
  if (r.args.len() > 0 && nargs.len() == r.args.len()) {
    let ni: i32 = 0;
    while (ni < r.args.len()) {
      let (nn2, nt2) = gc_bind_param(r.args[ni], nargs[ni], tparams, tn, ns, ts);
      ns = nn2;
      ts = nt2;
      ni = ni + 1;
    }
    return (ns, ts);
  }
  // A bare variable binds to the argument's type, or to a type variable of
  // the enclosing generic (`apply(twice, x)` under `run[T](x: T)` binds
  // apply's T to run's), which a later concrete argument replaces.
  if (r.args.len() == 0 && (!is_unknown(at) || is_type_variable(at)) && !elemless_array(at) && gc_is_typevar_name(r.base, tparams, tn)) {
    let index: i32 = util.index_of_str(ns, r.base);
    if (index < 0) {
      ns = ns.append(r.base);
      ts = ts.append(at);
    } else if (is_type_variable(ts[index]) && !is_unknown(at)) {
      ts = ts.with(index, at);
    } else if let typeinfo.TypeUnion(prior) = ts[index] {
      if let typeinfo.TypeUnion(actual) = at {
        let joined: typeinfo.Type = join_enum_arguments(prior, actual);
        if (!is_unknown(joined)) {
          ts = ts.with(index, joined);
        }
      }
    }
  }
  return (ns, ts);
}

// declared_union_names is the names-only union set the STRUCT table is built
// with: type aliases and enums both name a union, and a field typed by either
// resolves through it. The full UnionSig table (with variants) comes after,
// once struct names are known.
function declared_union_names(mod: parser.Module): string[] {
  let out: string[] = [];
  for alias in mod.aliases {
    out = out.append(alias.name);
  }
  for ed in mod.enums {
    out = out.append(ed.name);
  }
  return out;
}

// collect_union_sigs is one union per alias that registers as an enum; a
// refused one (E016 or E006) leaves its name to whatever else declares it.
function collect_union_sigs(mod: parser.Module): UnionSig[] {
  let out: UnionSig[] = [];
  let i: i32 = 0;
  while (i < mod.aliases.len()) {
    let a: parser.TypeAlias = mod.aliases[i];
    if (parser.alias_registers(mod, i)) {
      out = out.append(UnionSig { name: a.name, variants: a.variants, is_try: false, is_enum: false, module: a.module, type_params: [], instance: "", visible_from: [] });
    }
    i = i + 1;
  }
  return out;
}

// validate_union_sigs walks each alias's variant list and
// returns false if any variant fails to resolve to a declared
// struct (the only variant shape supported in this slice).
// Primitives + nested unions as variants are a follow-up.
function validate_union_sigs(unions: UnionSig[], struct_names: string[]): boolean {
  for u in unions {
    for variant in u.variants {
      let name: string = variant;
      let k: i32 = 0;
      let found: boolean = false;
      while (k < struct_names.len()) {
        if (struct_names[k] == name) {
          found = true;
          break;
        }
        k = k + 1;
      }
      if (!found) {
        return false;
      }
    }
  }
  return true;
}

// check_func_body type-checks a function's body in a scope
// pre-bound to its parameters. Errors inside the body surface as
// TypeUnknown on the offending statement — we walk for side
// effects and don't return them yet. Returns true if every body
// stmt type-checked (no TypeUnknown anywhere); the caller can
// use that to count well-typed function bodies for diagnostics.
// build_func_scope seeds a fresh scope for a function body: the declared
// ret_type (so StmtReturn arms can compare against it), the receiver (for
// methods), then the parameters. Shared by check_func_body and the
// coded-diagnostic walks so they bind names identically.
// const_arg_diags checks each written generic argument of a call against the
// kind of its parameter. A const parameter takes an integer literal or a const
// parameter in scope (E089), and not a type (E090). A type parameter does not
// take an integer (E090).
function const_arg_diags(sig: FuncSig, c: ast.ExprCall, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let i: i32 = 0;
  while (i < sig.all_type_params.len() && i < c.type_args.len()) {
    let tp: string = sig.all_type_params[i];
    let arg: string = c.type_args[i];
    let k: i32 = util.index_of_str(sig.type_params, tp);
    let is_const: boolean = k >= 0 && k < sig.type_bounds.len() && parser.is_const_bound(sig.type_bounds[k]);
    if (is_const && parser.is_const_arg(arg) && !parser.const_arg_fits(arg)) {
      out = out.append(dg_at("E089", "the const argument for " + tp + " must fit in i32", c.line, c.col));
    } else if (is_const && !parser.is_const_arg(arg) && !s.is_const_param(arg)) {
      if (arg.len() == 0 || s.defines(arg)) {
        out = out.append(dg_at("E089", "the const argument for " + tp + " must be an integer literal or a const parameter", c.line, c.col));
      } else {
        out = out.append(dg_at("E090", "const parameter " + tp + " takes an integer, not the type " + arg, c.line, c.col));
      }
    } else if (!is_const && parser.is_const_arg(arg)) {
      out = out.append(dg_at("E090", "type parameter " + tp + " takes a type, not the integer " + arg, c.line, c.col));
    }
    i = i + 1;
  }
  return out;
}

// const_tparams is the const parameters of `fd` (`const N: i32`), each an
// i32 value in the body.
function const_tparams(fd: parser.FuncDecl): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < fd.type_params.len() && i < fd.bound_traits.len()) {
    if (parser.is_const_bound(fd.bound_traits[i])) {
      out = out.append(fd.type_params[i]);
    }
    i = i + 1;
  }
  return out;
}

function build_func_scope(fd: parser.FuncDecl, st: SigTable, structs: StructTable, unions: UnionTable, methods: MethodTable, imports: Imports, impls: parser.ImplInfo[], trait_reqs: parser.TraitReq[]): Scope {
  let s: Scope = Scope { ...new_scope_full(st, structs, unions.seen_from(fd), methods, imports, impls, trait_reqs), fn_module: fd.module };
  if (fd.impl_trait.len() > 0 && parser.is_inherited_default(impls, trait_reqs, fd)) {
    s = Scope { ...s, default_trait: fd.impl_trait, default_recv: util.base_type_name(fd.receiver_type) };
  }
  let tps: string[] = func_scope_tparams(fd);
  // A DERIVED associated function spells its receiver BARE (`Pair`, never
  // `Pair[T]`) so the struct-method monomorphiser keys on the plain name —
  // and the spelling is all struct_receiver_typevars has to read, so the
  // struct's own parameters have to come from its declaration instead.
  // Without them `T.default()` in a `@derive(cmp.Default) struct Pair[T]`
  // body read `T` as a value and drew an undefined-name E001 (#8461).
  // A generic enum's derived methods are spelled the same way, and their
  // parameters come from the enum's declaration (#11776). Each is bounded by
  // the trait being derived, as the Go checker's bindDeriveTypeParams does,
  // so the body's `T.default()` resolves through that bound.
  let declared_from: i32 = tps.len();
  if (fd.receiver_type.len() > 0) {
    let rbase: string = util.base_type_name(fd.receiver_type);
    let rtvs: string[] = s.lookup_struct(rbase).type_params;
    if (rtvs.len() == 0) {
      rtvs = s.lookup_union(rbase).type_params;
    }
    for rtv in rtvs {
      if (util.index_of_str(tps, rtv) < 0) {
        tps = tps.append(rtv);
      }
    }
  }
  let tbs: string[] = [];
  for b in fd.bound_traits {
    tbs = tbs.append(bounds_in_module(b, fd.module));
  }
  while (tbs.len() < tps.len()) {
    tbs = tbs.append("");
  }
  let k: i32 = declared_from;
  while (k < tps.len()) {
    if (tbs[k].len() == 0) {
      tbs = tbs.with(k, fd.impl_trait);
    }
    k = k + 1;
  }
  // The unbounded parameters are type variables of the body too.
  for tv in fd.all_type_params {
    if (!util.has_str(tps, tv)) {
      tps = tps.append(tv);
      tbs = tbs.append("");
    }
  }
  s = s.with_tparams(tps, tbs);
  if (fd.ret_type.len() > 0) {
    s = s.with_ret_type(func_ret_type(fd, tps, rigid_tparams(tps), s.type_names()));
  }
  if (fd.receiver_name.len() > 0) {
    s = s.bind(fd.receiver_name, type_from_name_subst(fd.receiver_type, tps, rigid_tparams(tps), s.type_names()));
  }
  for param in fd.params {
    s = s.bind(param.name, param_decl_type(param, tps, rigid_tparams(tps), s.type_names()));
  }
  for name in const_tparams(fd) {
    s = s.bind(name, t_i32());
  }
  return s;
}

// func_scope_tparams is what the body may read as type VARIABLES: the declared
// parameters plus the implicit ones a generic RECEIVER binds. `(m: Map[K, V])
// merge(...)` declares no `[K, V]`, yet K and V are variables in its body. The
// parser has already told the two apart by module visibility, as native's
// collectFreeTypeVars does, and respelled the variables, so type_str_vars
// reads them straight off the receiver, nested ones (`Option[(T, U)]`)
// included.
//
// The implicit ones are unbounded, so the caller pads tbounds to match.
function func_scope_tparams(fd: parser.FuncDecl): string[] {
  if (fd.receiver_type.len() == 0) {
    return fd.type_params;
  }
  return parser.type_str_vars(fd.receiver_type, fd.type_params);
}

// split_fn_param_spellings splits ParamDecl.fn_param_types — the comma-encoded
// param spellings of a fn-typed parameter — at depth-zero commas only, so a
// bracketed or parenthesised element ("Map[string,i32]", "(a,b)") stays whole.
function split_fn_param_spellings(csv: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i <= csv.len()) {
    if (i == csv.len() || csv[i] == b',' && depth == 0) {
      out = out.append(slice_unchecked(csv, start, i) + "");
      start = i + 1;
    } else if (csv[i] == b'(' || csv[i] == b'[') {
      depth = depth + 1;
    } else if (csv[i] == b')' || csv[i] == b']') {
      depth = depth - 1;
    }
    i = i + 1;
  }
  return out;
}

// Parameters use the same retained scalar/array callable contract as locals,
// fields and results. No recorded result means an opaque tag, not zero arity.
// param_decl_type is a declared parameter's type: its sidecar type, else its
// resolved name.
function param_decl_type(p: ast.ParamDecl, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  let t: typeinfo.Type = fn_param_decl_type(p, tparams, subst, tn);
  if (is_unknown(t)) {
    t = type_from_name_subst(p.type_name, tparams, subst, tn);
  }
  return t;
}

function fn_param_decl_type(p: ast.ParamDecl, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  if (!parser.is_fn_contract_tag(p.type_name) || p.fn_ret.len() == 0) {
    return t_unknown("opaque fn param");
  }
  return declared_callable_type(p.type_name, p.fn_ret, p.fn_param_types, tparams, subst, tn);
}

// Every lambda scope and diagnostic walk consumes the same declaration
// contract as top-level functions, including callable signatures and views.
function (s: Scope) resolve_param(p: ast.ParamDecl): typeinfo.Type {
  let ty = fn_param_decl_type(p, s.tparams, rigid_tparams(s.tparams), s.type_names());
  if (!is_unknown(ty)) {
    return ty;
  }
  return s.resolve_type(p.type_name);
}

// The parser retains callable signatures beside coarse fn/fn[]/[fn] tags. All
// declaration sites consume that same contract. A recorded result distinguishes
// a genuine empty parameter list from an opaque tag with no signature at all.
function declared_callable_type(name: string, ret: string, params: string, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  let pts: typeinfo.Type[] = [];
  let powns: boolean[] = [];
  if (params.len() > 0) {
    for seg in split_fn_param_spellings(params) {
      powns = powns.append(parser.spelling_is_own(seg));
      pts = pts.append(type_from_name_subst(parser.spelling_without_own(seg), tparams, subst, tn));
    }
  }
  let ft: typeinfo.Type = t_func_own(pts, powns, type_from_name_subst(ret, tparams, subst, tn));
  if (name == "fn[]") {
    return t_array(ft);
  }
  if (name == "[fn]") {
    return t_view(ft);
  }
  return ft;
}

// `s` is the function's body scope, built by build_func_scope and carrying the
// impl table for the E021 bound check. It is passed in rather than
// rebuilt because check_module already holds the identical scope.
function check_func_body(fd: parser.FuncDecl, s: Scope): boolean {
  // A GENERIC function's body operates on opaque-typed values — its type
  // parameters are rigid, but a callee's signature still erases to unknown,
  // so an expression over a `T` can infer unknown. That's expected, not an
  // error: native defers such checks to monomorphisation
  // and accepts the body. So a TypeUnknown statement here must NOT mark the
  // module ill-typed (which over-rejected `ident[T](v: T): T { return v; }`
  // under `-check`, #4346 piece 2). The CODED diagnostic passes still run —
  // and already skip opaque-generic param types when flagging E038 / E003 —
  // so genuine errors are unaffected; only the uncoded over-reject signal is
  // suppressed for generic bodies. Non-generic bodies keep the strict check.
  // `s.tparams` also holds the parameters a derived method's bare receiver
  // takes from its type's declaration (build_func_scope).
  let generic: boolean = s.tparams.len() > 0 || fd.all_type_params.len() > 0;
  // A generic-RECEIVER method (`function (o: Option[T]) unwrap_or(f: T): T`)
  // binds its type parameters through the receiver spelling, which
  // func_scope_tparams reads. A receiver spelling it does not read is still
  // generic when the resolved type carries an unknown component (the erased
  // `[T]`); a concrete receiver resolves without one and stays strict.
  if (!generic && fd.receiver_type.len() > 0) {
    if (type_contains_unknown(s.resolve_type(fd.receiver_type))) {
      generic = true;
    }
  }
  let ok: boolean = true;
  for stmt in fd.body {
    let r: CheckResult = check_stmt(stmt, s);
    s = r.scope;
    if (!generic && is_unknown(r.ty)) {
      ok = false;
    }
  }
  return ok;
}

// name_with_args_label renders a nominal with its generic instantiation args —
// `Option[i32]`, `Box[string, i32]` — or the bare name when it has none. The two
// nominal arms of type_label share it because native renders both the same way.
function name_with_args_label(name: string, args: typeinfo.Type[]): string {
  if (args.len() == 0) {
    return name;
  }
  let out: string = name + "[";
  let i: i32 = 0;
  while (i < args.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    out = out + type_label(args[i]);
    i = i + 1;
  }
  return out + "]";
}

// type_label renders a Type as a friendly name for a diagnostic message.
// Most message text is still outside the differential, but the hints that
// name a spelling to write are not: TestSelfHostCheckerHintTextDifferential
// compares those against native word for word (#7018).
//
// It returns the name as DECLARED, so a cross-module type arrives mangled.
// A hint has to demangle it — `mod__Name` is not writable Fern.
pub function type_label(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeString(st) => {
      if (st.tag == 1) {
        return "str";
      }
      return "string";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    typeinfo.TypeArray(a) => {
      return array_label(a);
    },
    typeinfo.TypeStruct(sd) => {
      return name_with_args_label(sd.name, sd.args);
    },
    typeinfo.TypeTuple(tp) => {
      return "(" + labels_joined(tp.elements) + ")";
    },
    typeinfo.TypeFunc(f) => {
      return func_label(f);
    },
    typeinfo.TypeMap(m) => {
      return "Map[" + type_label(m.key) + ", " + type_label(m.value) + "]";
    },
    typeinfo.TypeUnion(u) => {
      return name_with_args_label(u.name, u.args);
    },
    typeinfo.TypeDyn(d) => {
      return "dyn " + d.traits;
    },
    typeinfo.TypeHandle(h) => {
      return typeinfo.handle_spelling(h);
    },
    typeinfo.TypeVoid(_) => {
      return "void";
    },
    typeinfo.TypeNever(_) => {
      return "never";
    },
    typeinfo.TypeUnknown(_) => {
      return "unknown";
    },
    typeinfo.TypeErased(e) => {
      return e.name;
    }
  }
  return "unknown";
}

// array_label spells an array or view type; an array of known callables is
// bracketed, as `((i32) => i32)[]`.
function array_label(a: typeinfo.TypeArray): string {
  if (a.view) {
    return "[" + type_label(a.elem) + "]";
  }
  if let typeinfo.TypeFunc(ef) = a.elem {
    if (ef.params_known) {
      return "(" + type_label(a.elem) + ")[]";
    }
  }
  return type_label(a.elem) + "[]";
}

// labels_joined is each type's label, comma-separated.
function labels_joined(ts: typeinfo.Type[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < ts.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    out = out + type_label(ts[i]);
    i = i + 1;
  }
  return out;
}

// func_label spells a callable's signature. The opaque callable records no
// parameter list, so an arrow rendering would state an arity nothing supplied.
function func_label(f: typeinfo.TypeFunc): string {
  if (!f.params_known) {
    return "fn";
  }
  let out: string = "(";
  let i: i32 = 0;
  while (i < f.param_types.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    if (typeinfo.fn_own_at(f, i)) {
      out = out + "own ";
    }
    out = out + type_label(f.param_types[i]);
    i = i + 1;
  }
  return out + ") => " + type_label(f.ret_type);
}

// keep_code filters a diagnostic list to one code.
function keep_code(diags: util.Diag[], code: string): util.Diag[] {
  let out: util.Diag[] = [];
  for diag in diags {
    if (diag.code == code) {
      out = out.append(diag);
    }
  }
  return out;
}

// ret_diags walks a function body (recursing through if / while / for /
// match / defer sub-bodies, threading scope so a return can see locals
// declared earlier in the same block) and emits E002 for each return
// whose value type isn't assignable to the function's declared return
// type. It reuses the SAME `type_assignable` predicate check_stmt uses to
// flag the mismatch, so it introduces no new false positives — it only
// attaches the stable code. Branch-local bindings don't leak (each
// sub-body re-threads from the scope at the block), and a return value /
// ret_type that infers `unknown` is skipped (a separate error already).
function ret_diags(stmts: ast.Stmt[], s: Scope, ret_ty: typeinfo.Type, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  if (is_unknown(ret_ty)) {
    return out;
  }
  let cur: Scope = s;
  for st in stmts {
    out = util.append_diags(out, ret_diags_in_exprs(st, cur, ret_ty, unions, false));
    match (st) {
      ast.StmtReturn(r) => {
        // A bare `return;` in a function with a (non-void) declared
        // return type — the only context ret_diags runs in — is E012.
        let bare: boolean = false;
        match (r.value) {
          ast.ExprUnknown(u) => {
            if (u.kind == parser.BARE_RETURN) {
              bare = true;
            }
          },
          _ => {}
        }
        if (bare) {
          out = out.append(dg_at("E012", "return without value in function returning " + type_label(ret_ty), r.line, r.col));
        } else {
          let t: typeinfo.Type = check_expr(r.value, cur);
          out = util.append_diags(out, int_dest_range_diags(r.value, ret_ty));
          out = util.append_diags(out, ctor_payload_diags(r.value, ret_ty, cur));
          let rbound: util.Diag[] = dest_bound_diags(r.value, ret_ty, cur);
          out = util.append_diags(out, rbound);
          if (!use_untyped_call(r.value) && rbound.len() == 0 && !is_unknown(t) && !settles_to(r.value, ret_ty, cur) && !(type_assignable(t, ret_ty, unions) && dyn_conforms(t, ret_ty, cur))) {
            out = out.append(dg_at("E002", "return value: expected " + type_label(ret_ty) + ", got " + type_label(t) + str_copy_hint(t, ret_ty), r.line, r.col));
          }
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, ret_diags(f.then_body, cur, ret_ty, unions));
        out = util.append_diags(out, ret_diags(f.else_body, cur, ret_ty, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, ret_diags(w.body, cur, ret_ty, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, ret_diags(fr.body, for_body_scope(fr, cur), ret_ty, unions));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, ret_diags(arm.body, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), ret_ty, unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, ret_diags(one, cur, ret_ty, unions));
      },
      _ => {}
    }
    // Advance the scope so a later return sees bindings from a `let`.
    cur = bind_stmt(st, cur);
  }
  return out;
}

// A written `return` inside a value block leaves the ENCLOSING function:
// the block is an if- / match-expression desugar the lowering inlines, so only
// the tail of each arm is the block's value. ret_diags stops at a lambda,
// and a value block's callee is one, so this walks the value blocks one
// statement's own expressions hold (nested bodies are ret_diags' own
// recursion) and checks every return but the arm tails against `ret_ty` —
// the void form when `void` is set. An ordinary lambda is its own contract
// (lret_expr) and is not entered.
function ret_diags_in_exprs(st: ast.Stmt, cur: Scope, ret_ty: typeinfo.Type, unions: UnionSig[], is_void: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  for e in stmt_exprs(st) {
    out = astwalk.fold_expr_pruned(
      e, out, (x: ast.Expr, own a: util.Diag[]): util.Diag[] => {
        match (x) {
          ast.ExprCall(c) => {
            if (parser.is_value_block(c)) {
              return util.append_diags(a, vb_ret_diags(parser.vb_body(c), cur, ret_ty, unions, is_void));
            }
            return a;
          },
          _ => {
            return a;
          }
        }
        return a;
      },
      not_a_scope_root,
    );
  }
  return out;
}

// The expressions a statement holds directly; the bodies it encloses are
// left to the caller's own recursion.
function stmt_exprs(st: ast.Stmt): ast.Expr[] {
  let out: ast.Expr[] = [];
  match (st) {
    ast.StmtVar(v) => {
      return out.append(v.init);
    },
    ast.StmtReturn(r) => {
      return out.append(r.value);
    },
    ast.StmtExpr(e) => {
      return out.append(e.value);
    },
    ast.StmtAssign(a) => {
      return out.append(a.value);
    },
    ast.StmtIf(i) => {
      return out.append(i.cond);
    },
    ast.StmtWhile(w) => {
      return out.append(w.cond);
    },
    ast.StmtFor(f) => {
      return out.append(f.iter);
    },
    ast.StmtMatch(m) => {
      out = out.append(m.scrutinee);
      for arm in m.arms {
        if (arm.has_guard) {
          out = out.append(arm.guard);
        }
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

// The returns of a value block's body that leave the enclosing function:
// every statement but the last is checked as the function's own, and the
// last is the block's value when it is a return, or an if / match whose
// arms end the same way — the tail rule iife_rewrite_arm_body lowers by.
function vb_ret_diags(body: ast.Stmt[], s: Scope, ret_ty: typeinfo.Type, unions: UnionSig[], is_void: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  if (body.len() == 0) {
    return out;
  }
  let cur: Scope = s;
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    out = util.append_diags(out, stmt_ret_diags(body[i], cur, ret_ty, unions, is_void));
    cur = bind_stmt(body[i], cur);
    i = i + 1;
  }
  match (body[i]) {
    ast.StmtReturn(_) => {
      return util.append_diags(out, ret_diags_in_exprs(body[i], cur, ret_ty, unions, is_void));
    },
    ast.StmtIf(f) => {
      out = util.append_diags(out, ret_diags_in_exprs(body[i], cur, ret_ty, unions, is_void));
      out = util.append_diags(out, vb_ret_diags(f.then_body, cur, ret_ty, unions, is_void));
      return util.append_diags(out, vb_ret_diags(f.else_body, cur, ret_ty, unions, is_void));
    },
    ast.StmtMatch(m) => {
      out = util.append_diags(out, ret_diags_in_exprs(body[i], cur, ret_ty, unions, is_void));
      for arm in m.arms {
        out = util.append_diags(out, vb_ret_diags(arm.body, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), ret_ty, unions, is_void));
      }
      return out;
    },
    _ => {
      return util.append_diags(out, stmt_ret_diags(body[i], cur, ret_ty, unions, is_void));
    }
  }
  return out;
}

function stmt_ret_diags(st: ast.Stmt, s: Scope, ret_ty: typeinfo.Type, unions: UnionSig[], is_void: boolean): util.Diag[] {
  let one: ast.Stmt[] = [st];
  if (is_void) {
    return void_ret_diags(one, s, unions);
  }
  return ret_diags(one, s, ret_ty, unions);
}

// void_ret_diags is the `void`-return counterpart of ret_diags: a function
// declared `: void` must not return a value, so every `return <expr>;` with
// a real value is E002 (a bare `return;` is fine). Mirrors the Go checker,
// which rejects a value returned from a void function. Recurses into nested
// blocks the same way ret_diags does; the scope is threaded so a returned
// expression sees earlier `let` bindings (it's still type-checked for the
// message, though any concrete type is a mismatch against void).
// void_return_diag checks one `return` in a void body: a bare `return;` is
// its exit and a returned value of type void is fine, so only a return of a
// non-void value is E002.
function void_return_diag(r: ast.StmtReturn, cur: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  match (r.value) {
    ast.ExprUnknown(u) => {
      if (u.kind == parser.BARE_RETURN) {
        return out;
      }
    },
    _ => {}
  }
  let t: typeinfo.Type = check_expr(r.value, cur);
  if (!is_void(t)) {
    out = out.append(dg_at("E002", "return value: expected void, got " + type_label(t), r.line, r.col));
  }
  return out;
}

function void_ret_diags(stmts: ast.Stmt[], s: Scope, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for st in stmts {
    out = util.append_diags(out, ret_diags_in_exprs(st, cur, t_void(), unions, true));
    match (st) {
      ast.StmtReturn(r) => {
        out = util.append_diags(out, void_return_diag(r, cur));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, void_ret_diags(f.then_body, cur, unions));
        out = util.append_diags(out, void_ret_diags(f.else_body, cur, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, void_ret_diags(w.body, cur, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, void_ret_diags(fr.body, for_body_scope(fr, cur), unions));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, void_ret_diags(arm.body, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, void_ret_diags(one, cur, unions));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

// name_in reports whether `name` appears in `list` — the membership test
// the slice-escape walk uses to classify identifiers.
function name_in(name: string, list: string[]): boolean {
  for entry in list {
    if (entry == name) {
      return true;
    }
  }
  return false;
}

// ---- View-escape summaries (shared by E063 and E065) -----------------------
// Both escape rules stop a dangling view from being RETURNED, and both are
// laundered the same way: a function that hands back a view of one of its
// own PARAMETERS passes an escape straight through, so
// `return id_view(slice_unchecked(s, 0, 1))` and `return id_sl(a[0:2])`
// dangle exactly when their arguments do. Port of the native ViewRoots /
// returnViewSummaries pair — a per-function summary of which parameter
// positions a return may view, iterated to a fixpoint, then consulted at
// every call site.
//
// Positions run over the declared parameters in order with the RECEIVER
// LAST, matching the order view_positions builds them. The native side
// gets that ordering for free: by the time its pass runs the checker has
// rewritten `x.m(a)` into `__method_T_m(x, a)` and the receiver IS
// argument 0. Here the call is still an ExprFieldAccess with the receiver
// on the side, so view_callee reassembles the list.
//
// A summary is keyed the way the borrowability registry is — bare for a free function,
// "<BaseType>.<name>" for a method — because a method name can collide
// across receiver types whose bodies view different things.

pub struct ViewSum { key: string, flags: boolean[], fresh: boolean }

// ViewIndex is a name index over a ViewSum table — the StructTable idiom.
// It travels beside the table rather than inside it: the summary fixpoints
// below rebind the table with `.with` once per function, and keys never
// change once a table is filled, so the index built then holds throughout.
pub struct ViewIndex { head: i32[], next: i32[] }

// view_index builds the index. Chains are laid down backward so each ends
// up ascending, the order the scan it replaces visited: a duplicate key
// still answers with the FIRST entry.
function view_index(sums: ViewSum[]): ViewIndex {
  let head: i32[] = util.minus_ones(sig_buckets());
  let next: i32[] = util.minus_ones(sums.len());
  let k: i32 = sums.len() - 1;
  while (k >= 0) {
    let bk: i32 = sig_name_bucket(sums[k].key);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    k = k - 1;
  }
  return ViewIndex { head: head, next: next };
}

// view_sum_pos is the position of the summary recorded under key, or -1
// when nothing is.
function view_sum_pos(sums: ViewSum[], vix: ViewIndex, key: string): i32 {
  let i: i32 = vix.head[sig_name_bucket(key)];
  while (i >= 0) {
    if (sums[i].key == key) {
      return i;
    }
    i = vix.next[i];
  }
  return 0 - 1;
}

// ViewRoots is where a returned view bottoms out: `local` when it views
// storage the enclosing function owns (what the rules reject), and
// `params` naming each of that function's parameters whose storage it may
// view (what a caller's chase needs). Both can be set at once — a
// conditional returning a param view on one path and a local view on the
// other.
pub struct ViewRoots { local: boolean, params: string[] }

// ViewCallee is a call resolved against the summary registry: the key to
// look it up under and its arguments in position order, receiver last. An
// empty key means the callee is not a shape the registry can name.
pub struct ViewCallee { key: string, args: ast.Expr[] }

function view_sum_key(fn: parser.FuncDecl): string {
  if (fn.receiver_type.len() > 0) {
    return parser.receiver_base(fn.receiver_type) + "." + fn.name;
  }
  return fn.name;
}

// view_positions lists a declaration's parameter names in summary position
// order — declared parameters first, receiver last.
function view_positions(fn: parser.FuncDecl): string[] {
  let out: string[] = [];
  for param in fn.params {
    out = out.append(param.name);
  }
  if (fn.receiver_name.len() > 0) {
    out = out.append(fn.receiver_name);
  }
  return out;
}

// view_sum_flags is the summary recorded under key, or empty when nothing
// is — an unsummarised callee views none of its arguments.
function view_sum_flags(sums: ViewSum[], vix: ViewIndex, key: string): boolean[] {
  let at: i32 = view_sum_pos(sums, vix, key);
  if (at >= 0) {
    return sums[at].flags;
  }
  let none: boolean[] = [];
  return none;
}

// view_sum_known reports whether key names a summarised declaration at
// all. A callee with no entry is a BUILTIN — the only string-returning
// ones are `buf_take` and `string_from_bytes_unchecked`,
// and all allocate fresh — so a miss means fresh rather than harmless.
function view_sum_known(sums: ViewSum[], vix: ViewIndex, key: string): boolean {
  return view_sum_pos(sums, vix, key) >= 0;
}

// view_sum_fresh reports whether the callee recorded under key hands back
// storage IT owns — an owned `T[]` or `string` return built in its own
// frame. The CALLER's frame then owns that storage, so slicing the result
// and returning the slice dangles exactly as slicing a local does.
function view_sum_fresh(sums: ViewSum[], vix: ViewIndex, key: string): boolean {
  let at: i32 = view_sum_pos(sums, vix, key);
  if (at >= 0) {
    return sums[at].fresh;
  }
  return false;
}

// view_recv_key names the receiver's base type for a method-call key, or
// "" when the receiver's type is not one a summary can be keyed by.
function view_recv_key(obj: ast.Expr, s: Scope): string {
  match (check_expr(obj, s)) {
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeStruct(sd) => {
      return util.base_type_name(sd.name);
    },
    typeinfo.TypeUnion(u) => {
      return util.base_type_name(u.name);
    },
    _ => {}
  }
  return "";
}

function view_callee(c: ast.ExprCall, s: Scope): ViewCallee {
  let none: ast.Expr[] = [];
  match (c.callee) {
    ast.ExprIdent(cid) => {
      return ViewCallee { key: cid.name, args: c.args };
    },
    ast.ExprFieldAccess(cfa) => {
      let recv: string = view_recv_key(cfa.obj, s);
      if (recv.len() == 0) {
        return ViewCallee { key: "", args: none };
      }
      let xs: ast.Expr[] = c.args;
      return ViewCallee { key: recv + "." + cfa.field, args: xs.append(cfa.obj) };
    },
    _ => {}
  }
  return ViewCallee { key: "", args: none };
}

function no_view_roots(): ViewRoots {
  let none: string[] = [];
  return ViewRoots { local: false, params: none };
}

function merge_view_roots(a: ViewRoots, b: ViewRoots): ViewRoots {
  let ps: string[] = a.params;
  for n in b.params {
    if (!e065_ident_in(n, ps)) {
      ps = ps.append(n);
    }
  }
  return ViewRoots { local: a.local || b.local, params: ps };
}

// merge_view_names unions two parameter-name lists.
function merge_view_names(a: string[], b: string[]): string[] {
  let out: string[] = a;
  for n in b {
    if (!e065_ident_in(n, out)) {
      out = out.append(n);
    }
  }
  return out;
}

// slc_src_roots reports where the storage `e` names bottoms out: an array
// literal and a local owned-array binding (`localarr`) are the current
// function's own, a local slice binding that itself views local storage
// (`tainted`) inherits that, a parameter is the caller's, and a sub-slice
// inherits its source's origin.
//
// A CALL argument arrives here rather than at slc_expr_roots because an
// owned array passed straight in IS the storage, not a slice of it —
// `id_sl(a)[0:1]` needs this arm to see `a`.
function slc_src_roots(e: ast.Expr, cur: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  match (e) {
    ast.ExprBytes(_) => {
      return ViewRoots { local: true, params: [] };
    },
    ast.ExprArray(_) => {
      let none: string[] = [];
      return ViewRoots { local: true, params: none };
    },
    ast.ExprSlice(s2) => {
      return slc_src_roots(s2.array, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprCall(c2) => {
      return slc_call_roots(c2, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprIdent(id) => {
      if (name_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (name_in(id.name, localarr) || name_in(id.name, tainted)) {
        let no: string[] = [];
        return ViewRoots { local: true, params: no };
      }
    },
    _ => {}
  }
  return no_view_roots();
}

// slc_call_roots chases a call: the result views whatever the caller
// handed to the parameters the callee's summary names, chased as STORAGE
// (see slc_src_roots).
function slc_call_roots(c: ast.ExprCall, cur: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  let out: ViewRoots = no_view_roots();
  let callee: ViewCallee = view_callee(c, cur);
  if (callee.key.len() == 0) {
    return out;
  }
  // A callee handing back storage it BUILT is handing this frame the
  // owner, so slicing an unbound `mkarr()[0:1]` dangles exactly as
  // slicing a local array does — binding it first already reported, and
  // the temporary is the same storage without a name.
  if (view_sum_fresh(sums, vix, callee.key)) {
    out = ViewRoots { local: true, params: out.params };
  }
  let flags: boolean[] = view_sum_flags(sums, vix, callee.key);
  let i: i32 = 0;
  while (i < flags.len() && i < callee.args.len()) {
    if (flags[i]) {
      out = merge_view_roots(out, slc_src_roots(callee.args[i], cur, params, localarr, tainted, sums, vix));
    }
    i = i + 1;
  }
  return out;
}

// slc_expr_roots reports where the `[T]` slice `e` evaluates to bottoms
// out. A string slice copies into a fresh owned string (`__str_slice`) so
// it never dangles; a bare reference to a tainted local slice does.
function slc_expr_roots(e: ast.Expr, cur: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  match (e) {
    ast.ExprSlice(sl) => {
      match (check_expr(sl.array, cur)) {
        typeinfo.TypeString(_) => {
          return no_view_roots();
        },
        _ => {}
      }
      return slc_src_roots(sl.array, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprCall(c) => {
      return slc_call_roots(c, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprIdent(id) => {
      if (name_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (name_in(id.name, tainted)) {
        let no: string[] = [];
        return ViewRoots { local: true, params: no };
      }
    },
    _ => {}
  }
  return no_view_roots();
}

// SlcWalk is one E063 walk's result: the diagnostics it found, the
// enclosing function's parameter names its returns may view, and whether
// any return hands back storage the function itself owns (`owns`), which
// is what makes a CALLER's slice of the result dangle.
pub struct SlcWalk { diags: util.Diag[], viewed: string[], owns: boolean }

// slc_walk is the E063 body walk: it threads the scope (so a slice's
// source type resolves) plus `params` and two name sets — `localarr`
// (locals bound to an owned array literal) and `tainted` (locals bound to
// a slice that views local storage) — and flags every `return` of a slice
// viewing local storage. A local whose init is a slice of a *parameter*
// lands in neither set, so returning it (or a sub-slice of it) is not
// flagged; `viewed` is what names that parameter for a CALLER's chase.
// Mirrors the native checker's checkSliceEscapes.
function slc_walk(stmts: ast.Stmt[], fname: string, s: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex, ret_is_view: boolean): SlcWalk {
  let out: util.Diag[] = [];
  let viewed: string[] = [];
  let owns: boolean = false;
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (is_arr_view(var_declared_type(v, cur)) && is_owned_array(check_expr(v.init, cur))) {
          if (slc_src_roots(v.init, cur, params, localarr, tainted, sums, vix).local) {
            tainted = tainted.append(v.name);
          }
        }
        match (v.init) {
          ast.ExprBytes(_) => {
            localarr = localarr.append(v.name);
          },
          ast.ExprArray(_) => {
            localarr = localarr.append(v.name);
          },
          _ => {
            if (slc_expr_roots(v.init, cur, params, localarr, tainted, sums, vix).local) {
              tainted = tainted.append(v.name);
            }
          }
        }
      },
      ast.StmtReturn(r) => {
        if (ret_is_view) {
          let roots: ViewRoots = slc_expr_roots(r.value, cur, params, localarr, tainted, sums, vix);
          viewed = merge_view_names(viewed, roots.params);
          if (roots.local) {
            out = out.append(dg_at("E063", "returning a `[T]` slice that views function-local storage: the backing array is reclaimed when \"" + fname + "\" returns, leaving a dangling view — return an owned array (`T[]`) or slice a parameter instead", r.line, r.col));
          }
        } else {
          // An owned `T[]` return hands its STORAGE to the caller, so the
          // question is where that storage came from — an argument the
          // caller still owns, or this frame.
          let sroots: ViewRoots = slc_src_roots(r.value, cur, params, localarr, tainted, sums, vix);
          viewed = merge_view_names(viewed, sroots.params);
          if (sroots.local) {
            owns = true;
          }
        }
      },
      ast.StmtIf(f) => {
        let wt: SlcWalk = slc_walk(f.then_body, fname, cur, params, localarr, tainted, sums, vix, ret_is_view);
        out = util.append_diags(out, wt.diags);
        viewed = merge_view_names(viewed, wt.viewed);
        owns = owns || wt.owns;
        let we: SlcWalk = slc_walk(f.else_body, fname, cur, params, localarr, tainted, sums, vix, ret_is_view);
        out = util.append_diags(out, we.diags);
        viewed = merge_view_names(viewed, we.viewed);
        owns = owns || we.owns;
      },
      ast.StmtWhile(w) => {
        let ww: SlcWalk = slc_walk(w.body, fname, cur, params, localarr, tainted, sums, vix, ret_is_view);
        out = util.append_diags(out, ww.diags);
        viewed = merge_view_names(viewed, ww.viewed);
        owns = owns || ww.owns;
      },
      ast.StmtFor(fr) => {
        let wf: SlcWalk = slc_walk(fr.body, fname, for_body_scope(fr, cur), params, localarr, tainted, sums, vix, ret_is_view);
        out = util.append_diags(out, wf.diags);
        viewed = merge_view_names(viewed, wf.viewed);
        owns = owns || wf.owns;
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          let wa: SlcWalk = slc_walk(arm.body, fname, cur, params, localarr, tainted, sums, vix, ret_is_view);
          out = util.append_diags(out, wa.diags);
          viewed = merge_view_names(viewed, wa.viewed);
          owns = owns || wa.owns;
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        let wd: SlcWalk = slc_walk(one, fname, cur, params, localarr, tainted, sums, vix, ret_is_view);
        out = util.append_diags(out, wd.diags);
        viewed = merge_view_names(viewed, wd.viewed);
        owns = owns || wd.owns;
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return SlcWalk { diags: out, viewed: viewed, owns: owns };
}

// slc_call_names is the last segment of every key a walk of `fn`'s body
// reads under view_callee: the callee of a plain call, the method name of a
// method call (view_callee keys that one `recv.field` and view_sum_key keys
// its summary `Base.field`, so both end in the bare name), each as often as
// it occurs. The changed set holds the bare `fn.name` the same way, so a
// body naming none of it reads nothing that changed; a shared method name
// only over-includes.
function slc_call_names(fn: parser.FuncDecl): string[] {
  let out: string[] = [];
  for st in fn.body {
    out = astwalk.fold_stmt(st, out, slc_call_name_at);
  }
  return out;
}

function slc_call_name_at(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprCall(c) = e {
    match (c.callee) {
      ast.ExprIdent(cid) => {
        return acc.append(cid.name);
      },
      ast.ExprFieldAccess(cfa) => {
        return acc.append(cfa.field);
      },
      _ => {
        return acc;
      }
    }
  }
  return acc;
}

// slc_calls_any reports whether any of `calls` is in `marked`.
function slc_calls_any(calls: util.NameIndex, marked: util.NameIndex): boolean {
  for name in calls.names {
    if (marked.has(name)) {
      return true;
    }
  }
  return false;
}

// slice_escape_diags is the E063 entry point: seed empty name sets and
// walk a function body. See slc_walk.
function slice_escape_diags(fn: parser.FuncDecl, s: Scope, sums: ViewSum[], vix: ViewIndex): SlcWalk {
  let localarr: string[] = [];
  let tainted: string[] = [];
  return slc_walk(fn.body, fn.name, s, view_positions(fn), localarr, tainted, sums, vix, parser.spelling_is_view(fn.ret_type));
}

// ---------------------------------------------------------------------------
// E067 — `@must_consume` obligation checking (docs/MUST-CONSUME.md).
// Port of the native walk in internal/check/checker/mustconsume.go: a value whose
// struct/enum type carries `@must_consume` must be CONSUMED at least once on
// every control-flow path before its binding leaves scope. Consuming uses:
// call-argument position, `return x`, `match (x)`, `let y = x` / `y = x`
// (the obligation transfers), or storing into another marked type. Storing
// into an UNMARKED container (array/tuple literal, unmarked struct/enum) is
// a violation at the store site (the obligation would be laundered out of
// the checked world), as is capturing the binding in a lambda. Loop bodies
// are opaque to the path analysis; `own` params are exempt (the own checker
// makes the callee the sink). Function names mirror the native mc* family.
// mc_any_marked reports whether the module declares ANY @must_consume type —
// the fast path that keeps the walk free for the (overwhelmingly common)
// unmarked-module case, e.g. the self-host compiler's own sources.
function mc_any_marked(structs: parser.StructDecl[], enums: parser.EnumDecl[]): boolean {
  for sd in structs {
    if (sd.must_consume) {
      return true;
    }
  }
  for ed in enums {
    if (ed.must_consume) {
      return true;
    }
  }
  return false;
}

// mc_struct_marked reports whether `name` is a declared struct carrying
// `@must_consume` (the native mustConsumeStructName).
function mc_struct_marked(name: string, structs: parser.StructDecl[]): boolean {
  for sd in structs {
    if (sd.name == name) {
      return sd.must_consume;
    }
  }
  return false;
}

// mc_enum_marked reports whether `name` is a declared enum carrying
// `@must_consume`.
function mc_enum_marked(name: string, enums: parser.EnumDecl[]): boolean {
  for ed in enums {
    if (ed.name == name) {
      return ed.must_consume;
    }
  }
  return false;
}

// mc_marked_type_name resolves a type-annotation spelling to the marked
// struct/enum name it denotes, or "" when the type isn't marked. Exact
// nominal match only — `Ticket[]` (an array OF a marked type) is not itself
// marked, same as the native mustConsumeTypeName (StructType/EnumType only).
function mc_marked_type_name(tn: string, structs: parser.StructDecl[], enums: parser.EnumDecl[]): string {
  if (tn.len() == 0) {
    return "";
  }
  if (mc_struct_marked(tn, structs)) {
    return tn;
  }
  if (mc_enum_marked(tn, enums)) {
    return tn;
  }
  return "";
}

// mc_is_binding reports whether `e` is the bare binding ident.
function mc_is_binding(e: ast.Expr, name: string): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == name;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// mc_mentions_stmts reports whether `name` appears anywhere in a statement
// list — as an identifier, or as an assignment's target, which is a bare
// string on the statement rather than an expression and so needs the
// statement visitor rather than the expression one.
//
// It folds through astwalk, so a new parser node is covered here the moment
// astwalk covers it. The hand-written walk it replaced ended in a
// `_ => false` arm, which silently did not search whatever it did not name.
function mc_mentions_stmts(stmts: ast.Stmt[], name: string): boolean {
  function see_expr(n: ast.Expr, own acc: boolean): boolean {
    match (n) {
      ast.ExprIdent(id) => {
        return acc || id.name == name;
      },
      _ => {
        return acc;
      }
    }
  }
  function see_stmt(st: ast.Stmt, own acc: boolean): boolean {
    match (st) {
      ast.StmtAssign(a) => {
        return acc || a.target == name;
      },
      _ => {
        return acc;
      }
    }
  }
  let found: boolean = false;
  for stmt in stmts {
    found = astwalk.fold_stmt_nodes(stmt, found, see_stmt, see_expr, astwalk.descend_all);
  }
  return found;
}

// mc_list_consumes scans an expression list for a consuming use (recursing —
// the direct bare-binding checks happen in the callers before this).
function mc_list_consumes(list: ast.Expr[], name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let out: util.Diag[] = [];
  for entry in list {
    let (c2, d2) = mc_expr_consumes(entry, name, tname, report, structs, enums);
    out = util.append_diags(out, d2);
    if (c2) {
      return (true, out);
    }
  }
  return (false, out);
}

// mc_call_consumes: a bare binding in ARGUMENT position transfers the
// obligation to the callee. A variant-constructor call (`Reply(t)`) is the
// self-host spelling of the native EnumLit: storing into a MARKED enum
// consumes; an unmarked enum launders the obligation (violation at the
// store site, still treated as consuming so it reports exactly once).
function mc_call_consumes(c: ast.ExprCall, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  let owner: string = "";
  match (c.callee) {
    ast.ExprIdent(cid) => {
      owner = mx_enum_of(cid.name, enums);
      if (owner.len() == 0) {
        owner = parser.builtin_enum_of(cid.name);
      }
    },
    _ => {}
  }
  for arg in c.args {
    if (mc_is_binding(arg, name)) {
      if (owner.len() == 0 || mc_enum_marked(owner, enums)) {
        return (true, none);
      }
      let d: util.Diag[] = [];
      if (report) {
        d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into unmarked enum \"" + owner + "\" — the consumption obligation is lost; mark \"" + owner + "\" @must_consume or consume the value directly", c.line, c.col));
      }
      return (true, d);
    }
  }
  // An immediately-invoked lambda — the parser's desugar of a
  // value-position `match` / `if` expression, `((): RT => { … })()`
  // — runs its body exactly once inline, so a consuming use in the body
  // counts (the native MatchExpr-tag rule), NOT as a closure capture.
  // Consumption must hold on all body paths (mc_seq), which covers the
  // dominant shape: a value-match destructuring the binding itself.
  match (c.callee) {
    ast.ExprLambda(ilm) => {
      let (bc, bdv, bd) = mc_seq(ilm.body, 0, name, tname, structs, enums);
      if (report) {
        return (bc, bd);
      }
      return (bc, none);
    },
    _ => {}
  }
  let (kc, kd) = mc_expr_consumes(c.callee, name, tname, report, structs, enums);
  if (kc) {
    return (true, kd);
  }
  return mc_list_consumes(c.args, name, tname, report, structs, enums);
}

// mc_structlit_consumes: storing the binding into a MARKED struct consumes;
// an unmarked struct launders (violation at the store site). The `...base`
// spread is neutral for the bare binding (a functional update reads the old
// value, it doesn't discharge it) — only recursed for nested uses.
function mc_structlit_consumes(sl: ast.ExprStructLit, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  for field_value in sl.field_values {
    if (mc_is_binding(field_value, name)) {
      if (mc_struct_marked(sl.type_name, structs)) {
        return (true, none);
      }
      let d: util.Diag[] = [];
      if (report) {
        d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into unmarked struct \"" + sl.type_name + "\" — the consumption obligation is lost; mark \"" + sl.type_name + "\" @must_consume or consume the value directly", sl.line, sl.col));
      }
      return (true, d);
    }
  }
  if (sl.has_base) {
    let (bc, bd) = mc_expr_consumes(sl.base, name, tname, report, structs, enums);
    if (bc) {
      return (true, bd);
    }
  }
  return mc_list_consumes(sl.field_values, name, tname, report, structs, enums);
}

// mc_expr_consumes scans an expression tree for a consuming use of the bare
// binding (the native mcExprConsumes). Laundering into an array/tuple
// literal and lambda capture are violations reported here, treated as
// consuming so each misuse reports exactly once. Field reads are neutral.
function mc_expr_consumes(e: ast.Expr, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      return mc_call_consumes(c, name, tname, report, structs, enums);
    },
    ast.ExprStructLit(sl) => {
      return mc_structlit_consumes(sl, name, tname, report, structs, enums);
    },
    ast.ExprArray(ar) => {
      for element in ar.elements {
        if (mc_is_binding(element, name)) {
          let d: util.Diag[] = [];
          if (report) {
            d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into an array literal — arrays cannot carry consumption obligations; consume the value directly", expr_line(element), expr_col(element)));
          }
          return (true, d);
        }
      }
      return mc_list_consumes(ar.elements, name, tname, report, structs, enums);
    },
    ast.ExprTuple(tp) => {
      for element in tp.elements {
        if (mc_is_binding(element, name)) {
          let d2: util.Diag[] = [];
          if (report) {
            d2 = d2.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into a tuple — tuples cannot carry consumption obligations; consume the value directly", tp.line, tp.col));
          }
          return (true, d2);
        }
      }
      return mc_list_consumes(tp.elements, name, tname, report, structs, enums);
    },
    ast.ExprLambda(lm) => {
      if (mc_mentions_stmts(lm.body, name)) {
        let d3: util.Diag[] = [];
        if (report) {
          d3 = d3.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" captured by a closure — obligations cannot flow into closures; consume the value directly", 0, 0));
        }
        return (true, d3);
      }
      return (false, none);
    },
    ast.ExprBinary(b) => {
      let (lc, ld) = mc_expr_consumes(b.left, name, tname, report, structs, enums);
      if (lc) {
        return (true, ld);
      }
      let (rc, rd) = mc_expr_consumes(b.right, name, tname, report, structs, enums);
      return (rc, util.append_diags(ld, rd));
    },
    ast.ExprUnary(u) => {
      return mc_expr_consumes(u.operand, name, tname, report, structs, enums);
    },
    ast.ExprIndex(ix) => {
      let (ac, ad) = mc_expr_consumes(ix.array, name, tname, report, structs, enums);
      if (ac) {
        return (true, ad);
      }
      return mc_expr_consumes(ix.index, name, tname, report, structs, enums);
    },
    ast.ExprSlice(sl2) => {
      let (sc, sd) = mc_expr_consumes(sl2.array, name, tname, report, structs, enums);
      if (sc) {
        return (true, sd);
      }
      let (stc, std) = mc_expr_consumes(sl2.start, name, tname, report, structs, enums);
      if (stc) {
        return (true, std);
      }
      return mc_expr_consumes(sl2.end, name, tname, report, structs, enums);
    },
    ast.ExprFieldAccess(fa) => {
      return mc_expr_consumes(fa.obj, name, tname, report, structs, enums);
    },
    _ => {
      return (false, none);
    }
  }
  return (false, none);
}

// mc_stmt_consumes reports whether the statement definitely contains a
// consuming use of the binding (the native mcStmtConsumesImpl). `report`
// false is the detection-only variant the overwrite re-scan uses.
function mc_stmt_consumes(st: ast.Stmt, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  match (st) {
    ast.StmtExpr(es) => {
      return mc_expr_consumes(es.value, name, tname, report, structs, enums);
    },
    ast.StmtVar(v) => {
      // `let y = x;` — the obligation transfers to y (tracked at its
      // own binding site when its type is marked).
      if (mc_is_binding(v.init, name)) {
        return (true, none);
      }
      return mc_expr_consumes(v.init, name, tname, report, structs, enums);
    },
    ast.StmtReturn(r) => {
      if (mc_is_binding(r.value, name)) {
        return (true, none);
      }
      return mc_expr_consumes(r.value, name, tname, report, structs, enums);
    },
    ast.StmtAssign(a) => {
      // `y = x;` — the obligation transfers to y (the native Assign
      // case of mcExprConsumes; assignment is a statement here).
      if (mc_is_binding(a.value, name)) {
        return (true, none);
      }
      return mc_expr_consumes(a.value, name, tname, report, structs, enums);
    },
    ast.StmtMatch(m) => {
      if (mc_is_binding(m.scrutinee, name)) {
        return (true, none);
      }
      return (false, none);
    },
    _ => {
      return (false, none);
    }
  }
  return (false, none);
}

// mc_seq returns (consumed_on_all_paths, diverged_unconsumed, diags) for the
// statement sequence starting at `from` (the native mcSeq). A path that
// returns / breaks / continues out of the scope without a consuming use sets
// the second flag; falling off the end unconsumed reports false for the
// first (the caller decides that's the scope-exit violation). Loop bodies
// are opaque; defer is neutral.
function mc_seq(stmts: ast.Stmt[], from: i32, name: string, tname: string, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, boolean, util.Diag[]) {
  let out: util.Diag[] = [];
  let i: i32 = from;
  while (i < stmts.len()) {
    let st: ast.Stmt = stmts[i];
    let (con, cd) = mc_stmt_consumes(st, name, tname, true, structs, enums);
    out = util.append_diags(out, cd);
    if (con) {
      return (true, false, out);
    }
    match (st) {
      ast.StmtReturn(_) => {
        return (false, true, out);
      },
      ast.StmtBreak(_) => {
        return (false, true, out);
      },
      ast.StmtContinue(_) => {
        return (false, true, out);
      },
      ast.StmtIf(f) => {
        let (tc, tv, td) = mc_seq(f.then_body, 0, name, tname, structs, enums);
        out = util.append_diags(out, td);
        let ec: boolean = false;
        let ev: boolean = false;
        if (f.else_body.len() > 0) {
          let (ec2, ev2, ed) = mc_seq(f.else_body, 0, name, tname, structs, enums);
          out = util.append_diags(out, ed);
          ec = ec2;
          ev = ev2;
        }
        if (tv || ev) {
          return (false, true, out);
        }
        if (tc && f.else_body.len() > 0 && ec) {
          return (true, false, out);
        }
      },
      ast.StmtMatch(m) => {
        // Some path through the if did not consume — the rest of
        // the sequence must cover it (at-least-once checker).
        // The scrutinee-is-binding case already returned via
        // mc_stmt_consumes above. A parser-desugared if-let /
        // let-else (origin != "") mirrors the native IfLet/LetElse:
        // only the source-destructure consumes; its arms don't
        // participate in the all-arms path logic.
        if (m.origin == "") {
          let all: boolean = m.arms.len() > 0;
          for arm in m.arms {
            let (ac, av, ad) = mc_seq(arm.body, 0, name, tname, structs, enums);
            out = util.append_diags(out, ad);
            if (av) {
              return (false, true, out);
            }
            if (!ac) {
              all = false;
            }
          }
          if (all) {
            return (true, false, out);
          }
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return (false, false, out);
}

// mc_check_binding runs the at-least-once analysis for one binding over the
// remainder of its scope, plus the straight-line overwrite scan (the native
// mcCheckBinding).
function mc_check_binding(stmts: ast.Stmt[], from: i32, name: string, tname: string, bline: i32, bcol: i32, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let (con, div, out) = mc_seq(stmts, from, name, tname, structs, enums);
  if (!con || div) {
    out = out.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" bound to \"" + name + "\" may go out of scope without being consumed — pass it, return it, match on it, or store it into another @must_consume type on every path", bline, bcol));
    return out;
  }
  // Overwrite scan (same block, straight-line): re-assigning the binding
  // before any consuming use silently drops the old value. Detection-only
  // (report=false) — the pass above already emitted any laundering /
  // capture errors for these statements.
  let i: i32 = from;
  while (i < stmts.len()) {
    let (q, qd) = mc_stmt_consumes(stmts[i], name, tname, false, structs, enums);
    if (q) {
      return out;
    }
    match (stmts[i]) {
      ast.StmtAssign(a) => {
        if (a.target == name) {
          out = out.append(dg_at("E067", "overwriting \"" + name + "\" while it still holds an unconsumed @must_consume \"" + tname + "\" value — consume the old value first", a.line, a.col));
          return out;
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return out;
}

// mc_var_type_name resolves the marked type name of a `let` binding: the
// annotation when present, otherwise the inferred init type (the native
// falls back to info.VarTypes). Returns "" when the type isn't marked.
function mc_var_type_name(v: ast.StmtVar, cur: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): string {
  let tn: string = v.type_name;
  if (tn.len() == 0) {
    match (check_expr(v.init, cur)) {
      typeinfo.TypeStruct(ts) => {
        tn = ts.name;
      },
      typeinfo.TypeUnion(tu) => {
        tn = tu.name;
      },
      _ => {
        return "";
      }
    }
  }
  return mc_marked_type_name(tn, structs, enums);
}

// mc_walk_body finds marked-type `let` bindings at every block depth and
// checks each against the remainder of ITS block (the native mcWalkBlock).
// The scope is threaded like slc_walk so an unannotated binding's init type
// resolves.
function mc_walk_body(stmts: ast.Stmt[], s: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let st: ast.Stmt = stmts[i];
    match (st) {
      ast.StmtVar(v) => {
        let tn: string = mc_var_type_name(v, cur, structs, enums);
        if (tn.len() > 0) {
          out = util.append_diags(out, mc_check_binding(stmts, i + 1, v.name, tn, v.line, v.col, structs, enums));
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, mc_walk_body(f.then_body, cur, structs, enums));
        out = util.append_diags(out, mc_walk_body(f.else_body, cur, structs, enums));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, mc_walk_body(w.body, cur, structs, enums));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, mc_walk_body(fr.body, for_body_scope(fr, cur), structs, enums));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, mc_walk_body(arm.body, cur, structs, enums));
        }
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
    i = i + 1;
  }
  return out;
}

// must_consume_diags is the per-function E067 entry point (the native
// checkMustConsume): parameters of marked type carry the obligation in from
// the caller (their scope is the whole body) — EXCEPT `own` params, whose
// function is the value's sink (E050/E051 enforce affine use there; the
// caller-side at-least-once plus the sink-side at-most-once compose to
// exactly-once across the call boundary). Then walk the body for local
// bindings.
function must_consume_diags(fn: parser.FuncDecl, s: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  for p in fn.params {
    if (!p.own) {
      let tn: string = mc_marked_type_name(p.type_name, structs, enums);
      if (tn.len() > 0) {
        out = util.append_diags(out, mc_check_binding(fn.body, 0, p.name, tn, fn.line, fn.col, structs, enums));
      }
    }
  }
  out = util.append_diags(out, mc_walk_body(fn.body, s, structs, enums));
  return out;
}

// The results an unannotated lambda's body leaves with: every value `return`
// and every `?`, whose failure edge is a return of the lambda too (#9515).
struct LambdaExits { types: typeinfo.Type[], bare: boolean }

// Native's inferReturnType over those exits: known enum arguments constrain
// the result while absent arguments can be filled by another exit. Genuine
// unknowns contribute nothing, and incompatible known types are conflicts.
struct ExitFold { ty: typeinfo.Type, have: boolean, clash_with: typeinfo.Type[], clash: typeinfo.Type[] }

function fold_exits(types: typeinfo.Type[]): ExitFold {
  let out: ExitFold = ExitFold { ty: t_unknown("no value exit"), have: false, clash_with: [], clash: [] };
  for t in types {
    if (!exit_type_known(t)) {
      continue;
    }
    if (!out.have) {
      out = ExitFold { ...out, ty: t, have: true };
    } else if (!exits_unify(out.ty, t)) {
      out = ExitFold { ...out, clash_with: out.clash_with.append(out.ty), clash: out.clash.append(t) };
    } else {
      if let typeinfo.TypeUnion(u) = out.ty {
        if let typeinfo.TypeUnion(v) = t {
          out = ExitFold { ...out, ty: join_enum_arguments(u, v) };
        }
      }
    }
  }
  return out;
}

// exit_result is the result a body that spells none settles to, by the same
// inference lambda_exit_diags checks.
pub function exit_result(body: ast.Stmt[], scope: Scope): typeinfo.Type {
  return fold_exits(lambda_exits(body, scope, LambdaExits { types: [], bare: false }).types).ty;
}

// lambda_exit_diags is native's return inference for an unannotated lambda:
// its exits must agree on one type (E002), and a bare `return;` beside a value
// return is E012.
function lambda_exit_diags(lm: ast.ExprLambda, lsc: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let exits: LambdaExits = lambda_exits(lm.body, lsc.with_ret_type(lambda_ret_type(lm, lsc)), LambdaExits { types: [], bare: false });
  let fold: ExitFold = fold_exits(exits.types);
  let i: i32 = 0;
  while (i < fold.clash.len()) {
    out = out.append(dg_at("E002", "cannot infer return type for \"\": conflicting return types " + type_label(fold.clash_with[i]) + " and " + type_label(fold.clash[i]) + "; add an explicit return type", lm.line, lm.col));
    i = i + 1;
  }
  if (fold.have && exits.bare) {
    out = out.append(dg_at("E012", "function \"\" returns a value on some paths but not others; add an explicit return type", lm.line, lm.col));
  }
  return out;
}

// A `defer` action's `?` is E079's, not an exit; a nested lambda's exits are
// its own.
function lambda_exits(body: ast.Stmt[], scope: Scope, own acc: LambdaExits): LambdaExits {
  let cur: Scope = scope;
  for st in body {
    if (!is_defer_stmt(st)) {
      acc = lambda_try_exits(st, cur, acc);
    }
    match (st) {
      ast.StmtReturn(r) => {
        acc = lambda_return_exit(r, cur, acc);
      },
      ast.StmtIf(f) => {
        acc = lambda_exits(f.then_body, cur, acc);
        acc = lambda_exits(f.else_body, cur, acc);
      },
      ast.StmtWhile(w) => {
        acc = lambda_exits(w.body, cur, acc);
      },
      ast.StmtFor(fo) => {
        acc = lambda_exits(fo.body, for_body_scope(fo, cur), acc);
      },
      ast.StmtMatch(m) => {
        let whole: typeinfo.Type = expr_type(m.scrutinee, cur);
        for a in m.arms {
          acc = lambda_exits(a.body, arm_scope(a, cur, whole), acc);
        }
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return acc;
}

// A value return adds its type; a bare one marks the lambda as having one;
// an integer literal adapts to its context and constrains nothing.
function lambda_return_exit(r: ast.StmtReturn, cur: Scope, own acc: LambdaExits): LambdaExits {
  if (parser.bare_return(r.value)) {
    return LambdaExits { ...acc, bare: true };
  }
  if (int_literal_tree(r.value)) {
    return acc;
  }
  return LambdaExits { ...acc, types: acc.types.append(check_expr(r.value, cur)) };
}

function is_defer_stmt(st: ast.Stmt): boolean {
  if let ast.StmtDefer(_) = st {
    return true;
  }
  return false;
}

// The `?`s one statement's own expressions hold, value blocks included: those
// inline into the lambda, so their `?` leaves it.
function lambda_try_exits(st: ast.Stmt, cur: Scope, own acc: LambdaExits): LambdaExits {
  for e in stmt_exprs(st) {
    acc = astwalk.fold_expr_pruned(
      e, acc, (x: ast.Expr, own a: LambdaExits): LambdaExits => {
        if let ast.ExprUnary(u) = x {
          if (u.op == "try_") {
            return LambdaExits { ...a, types: a.types.append(check_expr(u.operand, cur)) };
          }
        }
        return a;
      },
      e079_not_lambda,
    );
  }
  return acc;
}

function exit_type_known(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnion(u) => {
      for a in u.args {
        if (!unbound_enum_argument(a) && !exit_type_known(a)) {
          return false;
        }
      }
      return true;
    },
    typeinfo.TypeFloat(f) => {
      return !f.polymorphic;
    },
    typeinfo.TypeVoid(_) => {
      return false;
    },
    _ => {
      return !type_contains_unknown(t);
    }
  }
  return true;
}

// Native's unifyReturnType: equal types or compatible partial enum arguments.
function exits_unify(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(ua) = a {
    if let typeinfo.TypeUnion(ub) = b {
      return !is_unknown(join_enum_arguments(ua, ub));
    }
  }
  return type_eq(a, b);
}

// lret_expr walks an expression looking for lambdas and, for each one
// that declares a return type, checks the lambda body's `return`s against
// THAT type (not the enclosing function's) by reusing ret_diags, or
// void_ret_diags for one declared `: void`, where a bare `return;` is the
// right exit; one that declares none has its exits unified instead
// (lambda_exit_diags). This is
// the lambda-body counterpart of the top-level ret_diags pass: ret_diags
// itself recurses through if/while/for/match/defer sub-bodies but stops at
// a lambda boundary (a nested function has its own return contract), so
// without this pass a `let f = (): i32 => { return "x"; }` would go
// unflagged. The lambda's scope is the surrounding scope plus its params
// (lexical capture keeps free idents resolving outward); when `self_name`
// is non-empty the lambda is a recursive local (`let f = function…`) and
// its own name is pre-bound to its function type so a self-call inside the
// body resolves rather than inferring unknown. After checking the lambda's
// own returns it recurses into the body via lret_stmts for nested lambdas.
// lambda_body_diags checks a lambda's body against its return type: a body
// declared void takes the void route (a bare `return;` or a void call is its
// exit), a declared non-void body is checked against that type, and an
// undeclared body has its exits reconciled by lambda_exit_diags.
function lambda_body_diags(lm: ast.ExprLambda, lsc: Scope, rt: typeinfo.Type, unions: UnionSig[]): util.Diag[] {
  if (lm.ret_type.len() > 0 && is_void(rt)) {
    return void_ret_diags(lm.body, lsc, unions);
  }
  if (lm.ret_type.len() > 0 || lm.origin == parser.ORIGIN_USE && !is_unknown(rt)) {
    return ret_diags(lm.body, lsc, rt, unions);
  }
  return lambda_exit_diags(lm, lsc);
}

function lret_lambda(lm: ast.ExprLambda, cur: Scope, unions: UnionSig[], self_name: string): util.Diag[] {
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(cur.resolve_param(param));
  }
  let rt: typeinfo.Type = lambda_ret_type(lm, cur);
  let lsc: Scope = cur;
  if (self_name.len() > 0) {
    lsc = lsc.bind(self_name, t_func_own(pts, lambda_owns(lm), rt));
  }
  let bi: i32 = 0;
  while (bi < lm.params.len()) {
    lsc = lsc.bind(lm.params[bi].name, pts[bi]);
    bi = bi + 1;
  }
  return util.append_diags(lambda_body_diags(lm, lsc, rt, unions), lret_stmts(lm.body, lsc, unions));
}

function lret_expr(e: ast.Expr, cur: Scope, unions: UnionSig[], self_name: string): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprLambda(lm) => {
      out = util.append_diags(out, lret_lambda(lm, cur, unions, self_name));
    },
    ast.ExprBinary(b) => {
      out = util.append_diags(lret_expr(b.left, cur, unions, ""), lret_expr(b.right, cur, unions, ""));
    },
    ast.ExprUnary(u) => {
      out = lret_expr(u.operand, cur, unions, "");
    },
    ast.ExprCall(c) => {
      // An immediately-invoked lambda — ((): RT => { … })() — is
      // how the parser desugars a `match` / `if` used in value
      // position. Its RT is a COARSE heuristic tag (if_expr_rt picks it
      // from the first arm's literal shape, defaulting to "i32"), NOT a
      // user-declared return type — so running ret_diags against it
      // would false-positive E002 whenever the arms aren't i32-literals
      // (e.g. a match returning strings, or an arm that's a call). Skip
      // the IIFE's own return check; still recurse into its body for any
      // genuinely-nested lambdas.
      match (c.callee) {
        ast.ExprLambda(lm) => {
          let lsc: Scope = cur;
          for param in lm.params {
            lsc = lsc.bind(param.name, cur.resolve_param(param));
          }
          out = util.append_diags(out, lret_stmts(lm.body, lsc, unions));
        },
        _ => {
          out = util.append_diags(out, lret_expr(c.callee, cur, unions, ""));
        }
      }
      for arg in c.args {
        out = util.append_diags(out, lret_expr(arg, cur, unions, ""));
      }
    },
    ast.ExprArray(a) => {
      for element in a.elements {
        out = util.append_diags(out, lret_expr(element, cur, unions, ""));
      }
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, lret_expr(element, cur, unions, ""));
      }
    },
    ast.ExprIndex(ix) => {
      out = util.append_diags(lret_expr(ix.array, cur, unions, ""), lret_expr(ix.index, cur, unions, ""));
    },
    ast.ExprSlice(s2) => {
      out = util.append_diags(lret_expr(s2.array, cur, unions, ""), util.append_diags(lret_expr(s2.start, cur, unions, ""), lret_expr(s2.end, cur, unions, "")));
    },
    ast.ExprFieldAccess(fa) => {
      out = lret_expr(fa.obj, cur, unions, "");
    },
    ast.ExprStructLit(sl) => {
      for field_value in sl.field_values {
        out = util.append_diags(out, lret_expr(field_value, cur, unions, ""));
      }
      if (sl.has_base) {
        out = util.append_diags(out, lret_expr(sl.base, cur, unions, ""));
      }
    },
    _ => {}
  }
  return out;
}

// lret_stmts walks a statement list, threading scope (so a lambda sees
// `let`s declared earlier in the same block, exactly as ret_diags does)
// and dispatching every contained expression through lret_expr. A
// `let f = function…` passes its own name as self_name so a recursive
// local resolves inside its body.
function lret_stmts(stmts: ast.Stmt[], s: Scope, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, lret_expr(v.init, cur, unions, rec_local_name(v)));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, lret_expr(r.value, cur, unions, ""));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, lret_expr(x.value, cur, unions, ""));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, lret_expr(a.value, cur, unions, ""));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, lret_expr(f.cond, cur, unions, ""));
        out = util.append_diags(out, lret_stmts(f.then_body, cur, unions));
        out = util.append_diags(out, lret_stmts(f.else_body, cur, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, lret_expr(w.cond, cur, unions, ""));
        out = util.append_diags(out, lret_stmts(w.body, cur, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, lret_expr(fr.iter, cur, unions, ""));
        out = util.append_diags(out, lret_stmts(fr.body, for_body_scope(fr, cur), unions));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, lret_expr(m.scrutinee, cur, unions, ""));
        for arm in m.arms {
          out = util.append_diags(out, lret_stmts(arm.body, cur, unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, lret_stmts(one, cur, unions));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

// ============ E031: match/if-expression arm-type unification ============
//
// A `match` / `if` used in VALUE position is desugared by the parser into
// an immediately-invoked closure — ((): RT => { <match|if with
// returning arms> })() — so the type system never sees a real
// match/if-expression node and the arm-type consistency check the Go
// checker performs (E031) was missing. These passes recognise that IIFE
// shape, type each arm's result expression, and emit E031 when the arms
// aren't all mutually compatible.
//
// The compatibility predicate (`mx_arm_compatible`) mirrors the Go
// checker's `unifyIfArms`: two arms coexist when they're equal
// (`type_eq`), assignable either way (covers an empty-array literal vs a
// typed array, and a struct that's a member of a union arm), numeric where an
// unsuffixed literal arm settles at the other arm's type (`arm_int_literal`,
// and a polymorphic float against any float), element-wise-compatible
// tuples / arrays / maps / generic enum arguments, or two struct
// values of the SAME enum family. The enum-family rule is the subtle one:
// the Go checker types an enum variant constructor as its ENUM type, so
// `A(1)` and `B("y")` of one `enum E` unify, whereas the members of a
// struct-union (`type U = A | B`) keep their distinct struct types and do
// NOT unify (Go reports E031). The self-host types BOTH as `t_struct(name)`,
// so the names are mapped back to their family via the user `enum` decls
// (`mx_enum_of`) and the built-in enums (`parser.builtin_enum_of`, Option /
// Result / IoError / Body) — but NOT via union aliases, so union
// members correctly stay incompatible. Bare no-payload variants (`None`,
// `Empty`) resolve to `unknown` in the self-host and so are handled by the
// unknown-skip below (matching Go, which sees them as the compatible enum
// type). If ANY arm types to `unknown` the check is skipped entirely (a bad
// arm is its own error — Go reports E001 there, not E031).

// arm_int_literal is whether an arm's value is an integer native still types
// polymorphic, reading no local.
function arm_int_literal(e: ast.Expr): boolean {
  let no_locals: string[] = [];
  return unsettled_tree(e, no_locals);
}

// unsettled_tree is whether a value is an integer native still types
// polymorphic: a literal tree (one a float destination stamped included), a
// read of one of the literal locals `lits`, arithmetic over such values, or a
// value block, if or match every arm of which is one.
function unsettled_tree(e: ast.Expr, lits: string[]): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return int_literal_tree(e) || parser.float_settled_int(n);
    },
    ast.ExprIdent(id) => {
      return util.has_str(lits, id.name);
    },
    ast.ExprUnary(u) => {
      return (u.op == "-" || u.op == "+") && unsettled_tree(u.operand, lits);
    },
    ast.ExprBinary(b) => {
      return parser.int_literal_op(b.op) && unsettled_tree(b.left, lits) && unsettled_tree(b.right, lits);
    },
    ast.ExprCall(c) => {
      return unsettled_value_block(c, [], 0, lits);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// unsettled_part is unsettled_tree over the part of `e` the tuple element
// indices `path[at..]` name.
function unsettled_part(e: ast.Expr, path: i32[], at: i32, lits: string[]): boolean {
  if (at >= path.len()) {
    return unsettled_tree(e, lits);
  }
  if let ast.ExprTuple(t) = e {
    return path[at] < t.elements.len() && unsettled_part(t.elements[path[at]], path, at + 1, lits);
  }
  if let ast.ExprCall(c) = e {
    return unsettled_value_block(c, path, at, lits);
  }
  return false;
}

// unsettled_value_block: is `c` a value block, if or match with an arm that
// yields, every such arm's unsettled_part at `path[at..]` unsettled?
function unsettled_value_block(c: ast.ExprCall, path: i32[], at: i32, lits: string[]): boolean {
  if (c.args.len() > 0) {
    return false;
  }
  if let ast.ExprLambda(lm) = c.callee {
    let branches: boolean = lm.body.len() == 1 && (lm.origin == parser.ORIGIN_IF_EXPR || lm.origin == parser.ORIGIN_MATCH_EXPR);
    if (lm.params.len() > 0 || !branches && lm.origin != parser.ORIGIN_BLOCK) {
      return false;
    }
    return unsettled_arms(lm.body, path, at, lits) > 0;
  }
  return false;
}

// unsettled_arms counts the arms of a value body that yield, reading each in
// the literal locals its leading statements and its pattern leave, or is -1
// where one's unsettled_part at `path[at..]` is not unsettled.
function unsettled_arms(body: ast.Stmt[], path: i32[], at: i32, outer: string[]): i32 {
  if (!mx_branch_yields(body)) {
    return 0;
  }
  let lits: string[] = outer;
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    lits = lit_locals_after(body[i], lits);
    i = i + 1;
  }
  match (body[i]) {
    ast.StmtReturn(r) => {
      if (unsettled_part(r.value, path, at, lits)) {
        return 1;
      }
      return 0 - 1;
    },
    ast.StmtIf(f) => {
      return unsettled_arm_sum(unsettled_arms(f.then_body, path, at, lits), unsettled_arms(f.else_body, path, at, lits));
    },
    ast.StmtMatch(m) => {
      let n: i32 = 0;
      for arm in m.arms {
        n = unsettled_arm_sum(n, unsettled_arms(arm.body, path, at, drop_lit_locals(lits, astwalk.pattern_binders(arm.pattern, []))));
      }
      return n;
    },
    _ => {}
  }
  return 0;
}

// unsettled_arm_sum adds two unsettled_arms counts, -1 absorbing.
function unsettled_arm_sum(a: i32, b: i32): i32 {
  if (a < 0 || b < 0) {
    return 0 - 1;
  }
  return a + b;
}

// lit_locals_after is `lits` past a statement, as bind_stmt leaves them: a
// `let` rebinds its names, and an unannotated one an unsettled integer
// initialises is a literal local.
function lit_locals_after(st: ast.Stmt, lits: string[]): string[] {
  if let ast.StmtVar(v) = st {
    let out: string[] = drop_lit_locals(lits, astwalk.binders_of(st, []));
    if (v.type_name.len() == 0 && !name_has_comma(v.name) && unsettled_tree(v.init, lits)) {
      return out.append(v.name);
    }
    return out;
  }
  return lits;
}

function drop_lit_locals(lits: string[], names: string[]): string[] {
  let out: string[] = [];
  for lit in lits {
    if (!util.has_str(names, lit)) {
      out = out.append(lit);
    }
  }
  return out;
}

// builtin_union_sig is the variant list of a built-in Option or Result,
// neither of which is in the union table, so a match on one is held to E014
// and E030 like any enum's. Any other name answers an empty sig.
function builtin_union_sig(name: string): UnionSig {
  if (name == "Option") {
    return UnionSig { name: name, variants: ["Some", "None"], is_try: false, is_enum: true, module: "", type_params: ["T"], instance: "", visible_from: [] };
  }
  if (name == "Result") {
    return UnionSig { name: name, variants: ["Ok", "Err"], is_try: false, is_enum: true, module: "", type_params: ["T", "E"], instance: "", visible_from: [] };
  }
  return UnionSig { name: "", variants: [], is_try: false, is_enum: false, module: "", type_params: [], instance: "", visible_from: [] };
}

// mx_enum_of returns the user `enum` whose variant list contains `name`, or
// "" if none. Used to recognise that two distinct variant structs of one
// enum unify. NOT consulted for union aliases (`type U = A | B`): union
// members keep their distinct struct types and do not unify (Go E031).
function mx_enum_of(name: string, enums: parser.EnumDecl[]): string {
  for ed in enums {
    if (util.has_str(ed.variant_names, name)) {
      return ed.name;
    }
  }
  return "";
}

// mx_same_enum_family reports whether two struct names are variant
// constructors of the same enum (built-in or user-declared).
function mx_same_enum_family(an: string, bn: string, enums: parser.EnumDecl[]): boolean {
  if (an == bn) {
    return true;
  }
  let ab: string = parser.builtin_enum_of(an);
  if (ab.len() > 0 && ab == parser.builtin_enum_of(bn)) {
    return true;
  }
  let au: string = mx_enum_of(an, enums);
  if (au.len() > 0 && au == mx_enum_of(bn, enums)) {
    return true;
  }
  return false;
}

// mx_arm_compatible reports whether two arm results may coexist, mirroring
// the Go checker's unifyIfArms (see the section header). An arm's expression
// says whether it is an unsettled integer, which its type alone does not.
// Map keys (`elem`) do not settle at each other: unifyIfArms compares them at
// their default widths, and only a match that unifies under assignability
// (`assigns`) settles an unsettled key at a sibling's.
function mx_arm_compatible(a: VbStore, b: VbStore, elem: boolean, assigns: boolean, unions: UnionSig[], enums: parser.EnumDecl[]): boolean {
  if (owned_beside_view(a.t, b.t)) {
    return false;
  }
  if (elem && !assigns && (arm_unsettled(a) || arm_unsettled(b))) {
    return mx_arm_compatible(mx_default_width(a), mx_default_width(b), elem, assigns, unions, enums);
  }
  if (mx_int_literal_settles(a, b.t, elem) || mx_int_literal_settles(b, a.t, elem)) {
    return true;
  }
  if (is_float(a.t) && is_float(b.t) && (!elem || assigns)) {
    return float_operands_agree(a.t, b.t);
  }
  if let typeinfo.TypeUnion(ua) = a.t {
    if let typeinfo.TypeUnion(ub) = b.t {
      if (ua.name == ub.name) {
        return mx_args_compatible(ua, ub, elem, assigns, unions, enums);
      }
    }
  }
  if (type_eq(a.t, b.t) || type_assignable(a.t, b.t, unions) || type_assignable(b.t, a.t, unions)) {
    return true;
  }
  return mx_parts_compatible(a, b, elem, assigns, unions, enums);
}

// owned_beside_view: is one of two arm types an owned array and the other a
// view, or an owned string and str? They never join, though an owned value
// passes where its view is wanted.
function owned_beside_view(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(aa) = a {
    if let typeinfo.TypeArray(ba) = b {
      return aa.view != ba.view;
    }
  }
  if let typeinfo.TypeString(aa) = a {
    if let typeinfo.TypeString(ba) = b {
      return aa.tag != ba.tag;
    }
  }
  return false;
}

// mx_args_compatible is mx_arm_compatible over two instances of one generic
// enum, argument by argument, as mergeEnumInference joins them: an argument
// either construction leaves open joins anything.
function mx_args_compatible(a: typeinfo.TypeUnion, b: typeinfo.TypeUnion, elem: boolean, assigns: boolean, unions: UnionSig[], enums: parser.EnumDecl[]): boolean {
  if (a.args.len() == 0 || b.args.len() == 0) {
    return true;
  }
  if (a.args.len() != b.args.len()) {
    return false;
  }
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let i: i32 = 0;
  while (i < a.args.len()) {
    let x: typeinfo.Type = a.args[i];
    let y: typeinfo.Type = b.args[i];
    if (!is_unknown(x) && !is_unknown(y) && !mx_arm_compatible(VbStore { t: x, e: none }, VbStore { t: y, e: none }, elem, assigns, unions, enums)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// mx_parts_compatible is mx_arm_compatible over two composite results, part by
// part: tuples element-wise, arrays and maps by element, and two structs of one
// enum family.
function mx_parts_compatible(a: VbStore, b: VbStore, elem: boolean, assigns: boolean, unions: UnionSig[], enums: parser.EnumDecl[]): boolean {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  match (a.t) {
    typeinfo.TypeTuple(ta) => {
      match (b.t) {
        typeinfo.TypeTuple(tb) => {
          let n: i32 = ta.elements.len();
          if (tb.elements.len() != n) {
            return false;
          }
          let aes: ast.Expr[] = vb_tuple_elems(a.e, n);
          let bes: ast.Expr[] = vb_tuple_elems(b.e, n);
          let i: i32 = 0;
          while (i < n) {
            if (!mx_arm_compatible(VbStore { t: ta.elements[i], e: aes[i] }, VbStore { t: tb.elements[i], e: bes[i] }, elem, assigns, unions, enums)) {
              return false;
            }
            i = i + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeArray(aa) => {
      match (b.t) {
        typeinfo.TypeArray(ba) => {
          return mx_arm_compatible(mx_elem_store(a.e, aa.elem), mx_elem_store(b.e, ba.elem), false, assigns, unions, enums);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeMap(ma) => {
      match (b.t) {
        typeinfo.TypeMap(mb) => {
          return mx_arm_compatible(VbStore { t: ma.key, e: none }, VbStore { t: mb.key, e: none }, true, assigns, unions, enums)
            && mx_arm_compatible(mx_map_value_store(a.e, ma.value), mx_map_value_store(b.e, mb.value), false, assigns, unions, enums);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeStruct(sa) => {
      match (b.t) {
        typeinfo.TypeStruct(sb) => {
          return mx_same_enum_family(sa.name, sb.name, enums);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// mx_elem_store is an array arm's element: an array literal whose elements
// are all unsettled reads as its first, which stands for every one.
function mx_elem_store(e: ast.Expr, elem: typeinfo.Type): VbStore {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  if let ast.ExprArray(ea) = e {
    if (ea.elements.len() > 0 && mx_unsettled_elements(ea.elements)) {
      return VbStore { t: elem, e: ea.elements[0] };
    }
  }
  return VbStore { t: elem, e: none };
}

// mx_map_value_store is a map arm's value. A map literal's values unify as an
// arm's own result would, so one whose values are all unsettled reads as its
// first.
function mx_map_value_store(e: ast.Expr, value: typeinfo.Type): VbStore {
  let vs: ast.Expr[] = mlit_values(e);
  if (vs.len() > 0 && mlit_is_desugared(e) && mx_unsettled_elements(vs)) {
    return VbStore { t: value, e: vs[0] };
  }
  return VbStore { t: value, e: ast.ExprUnknown { kind: "", line: 0, col: 0 } };
}

// mlit_values are the values a desugared map literal's `.insert` chain stores.
function mlit_values(e: ast.Expr): ast.Expr[] {
  if let ast.ExprCall(c) = e {
    if let ast.ExprFieldAccess(fa) = c.callee {
      if (fa.field == "insert" && c.args.len() == 2) {
        return mlit_values(fa.obj).append(c.args[1]);
      }
    }
  }
  let none: ast.Expr[] = [];
  return none;
}

// mx_unsettled_elements: is every element an unsettled integer, or an array
// literal of them?
function mx_unsettled_elements(es: ast.Expr[]): boolean {
  for x in es {
    if let ast.ExprArray(inner) = x {
      if (inner.elements.len() == 0 || !mx_unsettled_elements(inner.elements)) {
        return false;
      }
      continue;
    }
    if (!arm_int_literal(x)) {
      return false;
    }
  }
  return true;
}

// mx_default_width reads an unsettled integer element at i32, the width
// unifyIfArms compares it at however wide its literal.
function mx_default_width(a: VbStore): VbStore {
  if (arm_unsettled(a)) {
    return VbStore { t: t_i32(), e: ast.ExprUnknown { kind: "", line: 0, col: 0 } };
  }
  return a;
}

// mx_int_literal_settles: does arm `a`, an unsettled integer, take the
// numeric type `t` of a sibling? An element settles at an integer only.
function mx_int_literal_settles(a: VbStore, t: typeinfo.Type, elem: boolean): boolean {
  return arm_unsettled(a) && (is_integer(t) || !elem && is_float(t));
}

// arm_unsettled: is a value an integer native still types polymorphic — a
// literal tree, whatever width a destination stamped on it, or a value typed
// polymorphic (mx_arm_result_type)?
function arm_unsettled(a: VbStore): boolean {
  return arm_int_literal(a.e) || is_poly_int(a.t);
}

// mx_arm_join is the result unifyIfArms carries past two compatible arms: a
// settled arm's type over an unsettled literal's, element by element in a
// tuple.
function mx_arm_join(a: VbStore, b: VbStore): VbStore {
  if let typeinfo.TypeTuple(at) = a.t {
    if let typeinfo.TypeTuple(bt) = b.t {
      let n: i32 = at.elements.len();
      if (bt.elements.len() == n) {
        let aes: ast.Expr[] = vb_tuple_elems(a.e, n);
        let bes: ast.Expr[] = vb_tuple_elems(b.e, n);
        let elems: typeinfo.Type[] = [];
        let es: ast.Expr[] = [];
        let i: i32 = 0;
        while (i < n) {
          let j: VbStore = mx_arm_join(VbStore { t: at.elements[i], e: aes[i] }, VbStore { t: bt.elements[i], e: bes[i] });
          elems = elems.append(j.t);
          es = es.append(j.e);
          i = i + 1;
        }
        return VbStore { t: t_tuple(elems), e: ast.ExprTuple { elements: es, line: 0, col: 0 } };
      }
    }
  }
  if let typeinfo.TypeArray(aa) = a.t {
    if let typeinfo.TypeArray(ba) = b.t {
      if (aa.view == ba.view) {
        let el: VbStore = mx_arm_join(mx_elem_store(a.e, aa.elem), mx_elem_store(b.e, ba.elem));
        return VbStore { t: typeinfo.TypeArray { ...aa, elem: el.t }, e: mx_joined_literal(el, a.e) };
      }
    }
  }
  if let typeinfo.TypeMap(am) = a.t {
    if let typeinfo.TypeMap(bm) = b.t {
      let v: VbStore = mx_arm_join(mx_map_value_store(a.e, am.value), mx_map_value_store(b.e, bm.value));
      return VbStore { t: t_map(am.key, v.t), e: mx_joined_literal(v, a.e) };
    }
  }
  if (arm_unsettled(b)) {
    return a;
  }
  if (arm_unsettled(a)) {
    return b;
  }
  let t: typeinfo.Type = join_result_types(a.t, b.t);
  if (is_unknown(t)) {
    return a;
  }
  return VbStore { t: t, e: a.e };
}

// mx_joined_literal is the expression a joined array or map arm carries on:
// the literal `e` while its elements, joined as `el`, are still unsettled.
function mx_joined_literal(el: VbStore, e: ast.Expr): ast.Expr {
  if (arm_unsettled(el)) {
    return e;
  }
  return ast.ExprUnknown { kind: "", line: 0, col: 0 };
}

// MxFold is a value if's or match's arms joined in order: `ok` until an arm,
// typed `bad`, fails to join `acc`, the arms joined before it.
struct MxFold { ok: boolean, acc: VbStore, bad: typeinfo.Type, bad_index: i32 }

// mx_fold_arms joins arm results the way unifyIfArms does. An arm that did not
// type, or results that do not line up with their expressions, leave nothing
// to judge: the fold is ok and `acc` unknown. An if-expression's concrete arm
// does not coerce to its other, dyn arm: the Go checker's unifyIfArms has no
// assignability rule, where a match's arms unify under one — except a match on
// an enum, whose arms do not (`assigns`).
function mx_fold_arms(types: typeinfo.Type[], exprs: ast.Expr[], unions: UnionSig[], enums: parser.EnumDecl[], if_form: boolean, assigns: boolean): MxFold {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let unjudged: MxFold = MxFold { ok: true, acc: VbStore { t: t_unknown("value block arms unjudged"), e: none }, bad: t_unknown(""), bad_index: 0 };
  if (types.len() == 0 || types.len() != exprs.len()) {
    return unjudged;
  }
  for ty in types {
    if (is_unknown(ty)) {
      return unjudged;
    }
  }
  let acc: VbStore = VbStore { t: types[0], e: exprs[0] };
  let j: i32 = 1;
  while (j < types.len()) {
    let arm: VbStore = VbStore { t: types[j], e: exprs[j] };
    if (!mx_arm_compatible(acc, arm, false, assigns, unions, enums) || if_form && is_dyn_slot(acc.t) != is_dyn_slot(arm.t)) {
      return MxFold { ok: false, acc: acc, bad: arm.t, bad_index: j };
    }
    acc = mx_arm_join(acc, arm);
    j = j + 1;
  }
  return MxFold { ok: true, acc: acc, bad: acc.t, bad_index: 0 };
}

// vb_arms_fold is mx_fold_arms over a value block's arms. The scope carries no
// enum declarations, so two variants of one enum read as disagreeing here.
function vb_arms_fold(types: typeinfo.Type[], exprs: ast.Expr[], s: Scope): MxFold {
  let no_enums: parser.EnumDecl[] = [];
  return mx_fold_arms(types, exprs, s.unions.unions, no_enums, false, true);
}

// mx_e031 emits one E031 if a value if's or match's arms do not all join.
function mx_e031(types: typeinfo.Type[], exprs: ast.Expr[], unions: UnionSig[], enums: parser.EnumDecl[], if_form: boolean, assigns: boolean, line: i32, col: i32): util.Diag[] {
  let f: MxFold = mx_fold_arms(types, exprs, unions, enums, if_form, assigns);
  return mx_fold_diags(f, line, col, if_form);
}

function mx_fold_diags(f: MxFold, line: i32, col: i32, if_form: boolean): util.Diag[] {
  let kind: string = if (if_form) { "if-expression branches differ: " } else { "match-expression arms differ: " };
  return mx_named_fold_diags(f, line, col, kind);
}

function mx_named_fold_diags(f: MxFold, line: i32, col: i32, kind: string): util.Diag[] {
  if (!f.ok) {
    return [dg_at("E031", kind + type_label(f.acc.t) + " vs " + type_label(f.bad), line, col)];
  }
  return [];
}

// A literal match is an if chain whose conditions are synthetic. Its
// preserved arm positions identify the failing arm, as a real match does.
function mx_if_diags(f: ast.StmtIf, types: typeinfo.Type[], exprs: ast.Expr[], unions: UnionSig[], enums: parser.EnumDecl[], origin: string, origin_line: i32, origin_col: i32): util.Diag[] {
  let fold: MxFold = mx_fold_arms(types, exprs, unions, enums, origin == parser.ORIGIN_IF_EXPR, origin == parser.ORIGIN_MATCH_EXPR);
  let kind: string = "if-expression branches differ: ";
  if (origin == parser.ORIGIN_MATCH_EXPR) {
    kind = "match arms have incompatible types: ";
  }
  let line: i32 = expr_line(f.cond);
  let col: i32 = expr_col(f.cond);
  if (origin == parser.ORIGIN_IF_EXPR) {
    line = origin_line;
    col = origin_col;
  }
  if (!fold.ok && f.sugar.lits.len() > 0) {
    let at: i32 = 0;
    for arm in f.sugar.lits {
      if (mx_branch_yields(arm.body)) {
        if (at == fold.bad_index) {
          return mx_named_fold_diags(fold, arm.line, arm.col, kind);
        }
        at = at + 1;
      }
    }
    line = f.sugar.line;
    col = f.sugar.col;
  }
  return mx_named_fold_diags(fold, line, col, kind);
}

// mx_branch_yields: does a value branch reach its terminal value? One whose
// leading statements always leave (`{ return false; }`) never yields one: its
// tail is parse_branch_body's unreachable filler.
function mx_branch_yields(body: ast.Stmt[]): boolean {
  if (body.len() == 0) {
    return false;
  }
  let leading: ast.Stmt[] = [];
  let li: i32 = 0;
  while (li + 1 < body.len()) {
    leading = leading.append(body[li]);
    li = li + 1;
  }
  return leading.len() == 0 || !parser.branch_stmts_diverge(leading);
}

// mx_arm_result_type types an arm's value, polymorphic where it reads a literal
// local and is otherwise built only from unsettled integers: the arm's
// expression alone cannot say so, as it can for a literal tree. A value block
// whose tail adapts to its receiver, which check_expr leaves unknown, types as
// its tail does as an arm.
function mx_arm_result_type(e: ast.Expr, s: Scope): typeinfo.Type {
  let t: typeinfo.Type = check_expr(e, s);
  let (block, is_block) = value_block_body(e);
  if (is_unknown(t) && is_block) {
    return block_tail_arm_type(block, s);
  }
  if (is_integer(t) && gcall_open(e, s)) {
    if let typeinfo.TypeI32(n) = t {
      return typeinfo.TypeI32 { ...n, polymorphic: true };
    }
  }
  return unsettled_marked(t, e, s.lit_locals, false);
}

// unsettled_marked is `t` typed polymorphic wherever `e` is an unsettled
// integer, element by element through a tuple, which a literal, a value block,
// if or match may yield. A whole value that is a literal tree is marked only
// with `literals`; its expression says so already.
function unsettled_marked(t: typeinfo.Type, e: ast.Expr, lits: string[], literals: boolean): typeinfo.Type {
  return unsettled_marked_at(t, e, [], lits, literals);
}

// unsettled_marked_at is unsettled_marked over `t`, the part of `e` at tuple
// `path`.
function unsettled_marked_at(t: typeinfo.Type, e: ast.Expr, path: i32[], lits: string[], literals: boolean): typeinfo.Type {
  if let typeinfo.TypeTuple(tt) = t {
    let elems: typeinfo.Type[] = [];
    let k: i32 = 0;
    while (k < tt.elements.len()) {
      elems = elems.append(unsettled_marked_at(tt.elements[k], e, path.append(k), lits, literals));
      k = k + 1;
    }
    return t_tuple(elems);
  }
  if let typeinfo.TypeI32(i) = t {
    if (!i.is_char && (literals || path.len() > 0 || !arm_int_literal(e)) && unsettled_part(e, path, 0, lits)) {
      return typeinfo.TypeI32 { ...i, polymorphic: true };
    }
  }
  return t;
}

// value_block_body is the body of the `{ …; tail }` value block `e`, if it is
// one.
function value_block_body(e: ast.Expr): (ast.Stmt[], boolean) {
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lm) = c.callee {
      if (c.args.len() == 0 && lm.params.len() == 0 && lm.origin == parser.ORIGIN_BLOCK) {
        return (lm.body, true);
      }
    }
  }
  let none: ast.Stmt[] = [];
  return (none, false);
}

// block_tail_arm_type is mx_arm_result_type over a value block's tail, with the
// block's leading statements bound.
function block_tail_arm_type(body: ast.Stmt[], s: Scope): typeinfo.Type {
  if (body.len() == 0) {
    return t_unknown("empty value block");
  }
  if let ast.StmtReturn(r) = body[body.len() - 1] {
    if (parser.bare_return(r.value)) {
      return t_unknown("value block tail");
    }
    let bs: Scope = s;
    let i: i32 = 0;
    while (i < body.len() - 1) {
      bs = bind_stmt(body[i], bs);
      i = i + 1;
    }
    return mx_arm_result_type(r.value, bs);
  }
  return t_unknown("value block tail");
}

// Type the terminal value in the scope established by preceding statements.
// A branch that never yields contributes no type.
function mx_body_result_types(body: ast.Stmt[], s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  if (!mx_branch_yields(body)) {
    return out;
  }
  let cur: Scope = s;
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    cur = bind_stmt(body[i], cur);
    i = i + 1;
  }
  match (body[i]) {
    ast.StmtReturn(r) => {
      return out.append(mx_arm_result_type(r.value, cur));
    },
    ast.StmtIf(f) => {
      return mx_if_branch_types(f, cur);
    },
    ast.StmtMatch(m) => {
      return mx_match_arm_types(m, cur);
    },
    _ => {
      return out;
    }
  }
  return out;
}

// The arm expressions mx_body_result_types types, in the same order, for a
// reader that needs the expression's shape as well as its type.
function mx_body_result_exprs(body: ast.Stmt[]): ast.Expr[] {
  let out: ast.Expr[] = [];
  if (!mx_branch_yields(body)) {
    return out;
  }
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      return out.append(r.value);
    },
    ast.StmtIf(f) => {
      out = mx_body_result_exprs(f.then_body);
      for e in mx_body_result_exprs(f.else_body) {
        out = out.append(e);
      }
      return out;
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        for e in mx_body_result_exprs(arm.body) {
          out = out.append(e);
        }
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

// Pattern bindings belong only to their own arm's result scope.
function mx_match_arm_types(m: ast.StmtMatch, s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for arm in m.arms {
    let armScope: Scope = s;
    match (arm.pattern) {
      ast.PatVariant(pv) => {
        armScope = bind_variant_payloads(armScope, s, pv, check_expr(m.scrutinee, s));
      },
      _ => {}
    }
    for ty in mx_body_result_types(arm.body, armScope) {
      out = out.append(ty);
    }
  }
  return out;
}

// mx_if_branch_types collects an if-expression's branch result types,
// recursing through an `else if` chain (the else arm is itself a StmtIf).
function mx_if_branch_types(f: ast.StmtIf, s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = mx_body_result_types(f.then_body, s);
  for ty in mx_body_result_types(f.else_body, s) {
    out = out.append(ty);
  }
  return out;
}

// mx_expr walks an expression, emitting E031 for any value match/if-
// expression IIFE it finds and P002 for an out-of-range float literal, and
// recursing into sub-expressions (so nested match/if-expressions, and ones
// inside calls / operators / literals, are all covered).
function mx_expr(e: ast.Expr, s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      // Recognise the desugared value match/if-expression: a 0-arg
      // call of a 0-param lambda whose body is a single StmtMatch or
      // StmtIf (arms/branches return their value).
      if (c.args.len() == 0) {
        match (c.callee) {
          ast.ExprLambda(lm) => {
            if (lm.params.len() == 0 && lm.body.len() == 1) {
              let arms: ast.Expr[] = mx_body_result_exprs(lm.body);
              match (lm.body[0]) {
                ast.StmtMatch(m) => {
                  let mts: typeinfo.Type[] = mx_match_arm_types(m, s);
                  let enum_match: boolean = false;
                  if let typeinfo.TypeUnion(_) = check_expr(m.scrutinee, s) {
                    enum_match = true;
                  }
                  out = util.append_diags(out, mx_e031(mts, arms, unions, enums, false, !enum_match, expr_line(m.scrutinee), expr_col(m.scrutinee)));
                  out = util.append_diags(out, vb_pinned_ranges(mts, arms));
                },
                ast.StmtIf(f) => {
                  let fts: typeinfo.Type[] = mx_if_branch_types(f, s);
                  out = util.append_diags(out, mx_if_diags(f, fts, arms, unions, enums, lm.origin, c.line, c.col));
                  out = util.append_diags(out, vb_pinned_ranges(fts, arms));
                },
                _ => {}
              }
            }
          },
          _ => {}
        }
      }
      out = util.append_diags(out, mx_expr(c.callee, s, unions, enums));
      for arg in c.args {
        out = util.append_diags(out, mx_expr(arg, s, unions, enums));
      }
    },
    ast.ExprLambda(lm) => {
      let lsc: Scope = s;
      for param in lm.params {
        lsc = lsc.bind(param.name, s.resolve_param(param));
      }
      out = util.append_diags(out, mx_stmts(lm.body, lsc, unions, enums));
    },
    ast.ExprBinary(b) => {
      out = util.append_diags(mx_expr(b.left, s, unions, enums), mx_expr(b.right, s, unions, enums));
    },
    ast.ExprUnary(u) => {
      out = mx_expr(u.operand, s, unions, enums);
    },
    ast.ExprArray(a) => {
      for element in a.elements {
        out = util.append_diags(out, mx_expr(element, s, unions, enums));
      }
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, mx_expr(element, s, unions, enums));
      }
    },
    ast.ExprIndex(ix) => {
      out = util.append_diags(mx_expr(ix.array, s, unions, enums), mx_expr(ix.index, s, unions, enums));
    },
    ast.ExprSlice(s2) => {
      out = util.append_diags(mx_expr(s2.array, s, unions, enums), util.append_diags(mx_expr(s2.start, s, unions, enums), mx_expr(s2.end, s, unions, enums)));
    },
    ast.ExprFieldAccess(fa) => {
      out = mx_expr(fa.obj, s, unions, enums);
    },
    ast.ExprStructLit(sl) => {
      for field_value in sl.field_values {
        out = util.append_diags(out, mx_expr(field_value, s, unions, enums));
      }
      if (sl.has_base) {
        out = util.append_diags(out, mx_expr(sl.base, s, unions, enums));
      }
    },
    ast.ExprUnknown(u) => {
      // P002: a float literal whose magnitude f64 cannot hold. The
      // parser plants this marker where the token becomes a value
      // (util.f64_range_kind), because it has no error list of its own;
      // native reports the same code from its parser (#6842).
      if (util.is_f64_range_kind(u.kind)) {
        out = out.append(dg_at("P002", util.f64_range_message(u.kind), u.line, u.col));
      }
    },
    _ => {}
  }
  return out;
}

// mx_stmts walks a statement list, threading scope (so a match/if-
// expression sees earlier locals and a match arm sees its payload binding)
// and dispatching every contained expression through mx_expr. It also emits
// E061 for a value-position block with no trailing value (the marker
// StmtUnknown parse_branch_body leaves), reached here because the walk
// descends into the value-if/match IIFE lambda bodies where that marker lives.
function mx_stmts(stmts: ast.Stmt[], s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, mx_expr(v.init, cur, unions, enums));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, mx_expr(r.value, cur, unions, enums));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, mx_expr(x.value, cur, unions, enums));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, mx_expr(a.value, cur, unions, enums));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, mx_expr(f.cond, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(f.then_body, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(f.else_body, cur, unions, enums));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, mx_expr(w.cond, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(w.body, cur, unions, enums));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, mx_expr(fr.iter, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(fr.body, for_body_scope(fr, cur), unions, enums));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, mx_expr(m.scrutinee, cur, unions, enums));
        for arm in m.arms {
          let armScope: Scope = cur;
          match (arm.pattern) {
            ast.PatVariant(pv) => {
              armScope = bind_variant_payloads(armScope, cur, pv, check_expr(m.scrutinee, cur));
            },
            _ => {}
          }
          out = util.append_diags(out, mx_stmts(arm.body, armScope, unions, enums));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, mx_stmts(one, cur, unions, enums));
      },
      ast.StmtUnknown(u) => {
        // E061: a value-position block (an if/match value-branch) whose
        // last element is a `;`-terminated statement has no trailing
        // value. parse_branch_body tags exactly that case with this
        // marker StmtUnknown (the only producer of this kind), so
        // detecting it here — inside the same value-if/match IIFE walk
        // that drives E031 — matches the Go checker, which reports E061
        // when a value-position block has no tail expression.
        if (u.kind == "value branch has no trailing expression") {
          out = out.append(dg_at("E061", parser.BLOCK_VALUE_REQUIRED_MESSAGE, u.line, u.col));
        }
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

// name_in reports whether `n` is one of `names`.
// name_in -> util.has_str (SH-020).
// find_struct_sig returns the struct sig named `name`, or an empty-named
// sentinel when there's no such struct.
// find_struct_sig is lookup_struct over the flat list: the plain struct first,
// a variant only when no plain struct carries the name (#9968).
function find_struct_sig(structs: StructTable, name: string): StructSig {
  let first: i32 = 0 - 1;
  let k: i32 = structs.index.chain(name);
  while (k >= 0) {
    if (structs.structs[k].name == name) {
      if (structs.structs[k].enum_owner.len() == 0) {
        return structs.structs[k];
      }
      if (first < 0) {
        first = k;
      }
    }
    k = structs.index.next[k];
  }
  if (first >= 0) {
    return structs.structs[first];
  }
  let none: string[] = [];
  let nonet: typeinfo.Type[] = [];
  let none_tp: string[] = [];
  let none_ftn: string[] = [];
  return StructSig { name: "", field_names: none, field_types: nonet, type_params: none_tp, field_type_names: none_ftn, variant_field_names: none, derives: [], enum_owner: "", opaque: false, module: "" };
}

// find_variant_sig is find_struct_sig for the possibly enum-QUALIFIED spelling
// a match pattern or a qualified constructor writes (`E.Wrap`). Same rule as
// lookup_owned_struct on the hash table: the qualifier is not part of the key,
// it names the enum the decl must be owned by, so two enums declaring one
// variant name each answer for their own decl. A qualifier nothing claims,
// and an unqualified spelling, take the first VARIANT of that name, and the
// plain struct only when no enum declares one (#9968).
function find_variant_sig(structs: StructTable, name: string): StructSig {
  let bare: string = variant_pattern_name(name);
  let owner: string = variant_pattern_owner(name);
  if (owner.len() > 0) {
    let k: i32 = structs.index.chain(bare);
    while (k >= 0) {
      if (structs.structs[k].name == bare && structs.structs[k].enum_owner == owner) {
        return structs.structs[k];
      }
      k = structs.index.next[k];
    }
  }
  let k2: i32 = structs.index.chain(bare);
  while (k2 >= 0) {
    if (structs.structs[k2].name == bare && structs.structs[k2].enum_owner.len() > 0) {
      return structs.structs[k2];
    }
    k2 = structs.index.next[k2];
  }
  return find_struct_sig(structs, bare);
}

// slit_names_no_struct reports whether a struct literal's type names no struct
// at all: not a declared one (an instantiation names its base), and not a
// built-in.
function slit_names_no_struct(structs: StructTable, type_name: string): boolean {
  let base: string = util.base_type_name(type_name);
  return find_struct_sig(structs, base).name.len() == 0 && !parser.is_reserved_struct_name(base);
}

// slit_diags recurses through an expression and emits E005 for every
// non-update struct literal that omits a declared field. The struct table
// is module-global, so this needs no scope — and recursing into field
// values + lambda bodies catches nested literals. A literal whose type
// isn't a known struct is skipped (a separate error / a variant
// constructor), as is a struct-update `Name { ...base, … }` (partial
// overrides are legal).
function slit_diags(e: ast.Expr, structs: StructTable): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprStructLit(sl) => {
      for field_value in sl.field_values {
        out = util.append_diags(out, slit_diags(field_value, structs));
      }
      // E043: a literal whose type names no declared struct or variant,
      // reported where the literal stands as native does (#10965). A
      // reserved built-in struct is declared by the front end rather than
      // by a module, so it is not unknown here.
      if (lit_names_no_struct(sl.type_name, structs)) {
        out = out.append(dg_at("E043", "cannot find struct \"" + util.demangle(sl.type_name) + "\" in this scope", sl.line, sl.col));
      }
      // E043: a struct-literal field whose name isn't declared on the
      // struct. Mirrors the Go checker (per-literal-field "struct S has no
      // field f"). Runs for update literals too (`S { ...b, bad: 1 }`) —
      // you can't set an unknown field. A generic instantiation or a
      // variant finds no sig and is skipped.
      let usig: StructSig = find_struct_sig(structs, sl.type_name);
      if (usig.name.len() > 0) {
        let fi: i32 = 0;
        while (fi < sl.field_names.len()) {
          if (!util.has_str(usig.field_names, sl.field_names[fi])) {
            let d: util.Diag = dg_at("E043", "struct " + util.demangle(sl.type_name) + " has no field \"" + sl.field_names[fi] + "\"", sl.line, sl.col);
            out = out.append(literal_field_fix(d, sl, fi, usig.field_names));
          }
          fi = fi + 1;
        }
      } else if (slit_names_no_struct(structs, sl.type_name)) {
        out = out.append(dg_at("E043", "cannot find struct \"" + util.demangle(sl.type_name) + "\" in this scope", sl.line, sl.col));
      }
      if (sl.has_base) {
        out = util.append_diags(out, slit_diags(sl.base, structs));
      } else {
        let ssig: StructSig = find_struct_sig(structs, sl.type_name);
        if (ssig.name.len() > 0) {
          for field_name in ssig.field_names {
            if (!util.has_str(sl.field_names, field_name)) {
              out = out.append(dg_at("E005", "missing field \"" + field_name + "\" in this " + util.demangle(sl.type_name) + " literal", sl.line, sl.col));
            }
          }
        }
      }
    },
    ast.ExprBinary(b) => {
      out = util.append_diags(slit_diags(b.left, structs), slit_diags(b.right, structs));
    },
    ast.ExprUnary(u) => {
      out = slit_diags(u.operand, structs);
    },
    ast.ExprCall(c) => {
      out = slit_diags(c.callee, structs);
      for arg in c.args {
        out = util.append_diags(out, slit_diags(arg, structs));
      }
    },
    ast.ExprArray(a) => {
      for element in a.elements {
        out = util.append_diags(out, slit_diags(element, structs));
      }
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, slit_diags(element, structs));
      }
    },
    ast.ExprIndex(ix) => {
      out = util.append_diags(slit_diags(ix.array, structs), slit_diags(ix.index, structs));
    },
    ast.ExprSlice(s2) => {
      out = util.append_diags(slit_diags(s2.array, structs), util.append_diags(slit_diags(s2.start, structs), slit_diags(s2.end, structs)));
    },
    ast.ExprFieldAccess(fa) => {
      out = slit_diags(fa.obj, structs);
    },
    ast.ExprLambda(lm) => {
      out = stmts_slit_diags(lm.body, structs);
    },
    _ => {}
  }
  return out;
}

// stmts_slit_diags walks a statement list (recursing into nested blocks
// and lambda bodies via slit_diags) collecting the struct-literal E005s
// from every expression it contains.
// lit_names_no_struct reports whether a struct literal's type name is a
// plain identifier that no struct or variant declares: `Self` is the impl's
// type and a dotted or bracketed spelling resolves elsewhere.
function lit_names_no_struct(name: string, structs: StructTable): boolean {
  if (name == "Self" || parser.is_reserved_struct_name(name) || !plain_ident(name)) {
    return false;
  }
  return find_variant_sig(structs, name).name.len() == 0;
}

function stmts_slit_diags(stmts: ast.Stmt[], structs: StructTable): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, slit_diags(v.init, structs));
        out = util.append_diags(out, destructure_covers_diags(v, structs));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, slit_diags(r.value, structs));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, slit_diags(x.value, structs));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, slit_diags(a.value, structs));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, slit_diags(f.cond, structs));
        out = util.append_diags(out, struct_arms_cover_diags(f.sugar.strct, structs));
        out = util.append_diags(out, stmts_slit_diags(f.then_body, structs));
        out = util.append_diags(out, stmts_slit_diags(f.else_body, structs));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, slit_diags(w.cond, structs));
        out = util.append_diags(out, stmts_slit_diags(w.body, structs));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, slit_diags(fr.iter, structs));
        out = util.append_diags(out, stmts_slit_diags(fr.body, structs));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, slit_diags(m.scrutinee, structs));
        for arm in m.arms {
          out = util.append_diags(out, stmts_slit_diags(arm.body, structs));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, stmts_slit_diags(one, structs));
      },
      _ => {}
    }
  }
  return out;
}

// loop_diags emits E011 for a `break` / `continue` that isn't inside a
// loop, and E058 for a labeled `break L` / `continue L` whose `L` names no
// enclosing loop. It threads only the enclosing-loop label stack (no value
// scope): `while` / `for` bodies recurse with in_loop = true.
// sugar_arm_bodies collects the arm bodies a desugared match carries, or an
// empty list when the `if` is one the programmer wrote. The four lists are
// alternatives, not layers: one builder produced this chain.
function sugar_arm_bodies(sugar: ast.MatchSugar): ast.Stmt[][] {
  let out: ast.Stmt[][] = [];
  for arm in sugar.tup {
    out = out.append(arm.body);
  }
  for arm in sugar.strct {
    out = out.append(arm.body);
  }
  for arm in sugar.lits {
    out = out.append(arm.body);
  }
  for arm in sugar.arms {
    out = out.append(arm.body);
  }
  return out;
}

// block_exits reports whether a statement block is guaranteed to leave
// its function (return) on every path — an under-approximation mirroring
// the Go checker's funcBodyExits, used by E052. Only the LAST statement
// matters: a `return`, an `if` whose both arms exit, a `while (true)` /
// `loop` no `break` targets (loop_can_break), or a `match` whose every arm
// body exits. `if let` is already desugared to an if/else chain by the
// parser, so it needs no special case here.
function block_exits(stmts: ast.Stmt[]): boolean {
  return block_leaves(stmts, false);
}

// block_diverges is block_exits where a `break` or `continue` also leaves,
// mirroring the Go checker's blockDiverges: what a `let … else` else arm
// must do (E022), and what drops a branch from the moved-value join.
function block_diverges(stmts: ast.Stmt[]): boolean {
  return block_leaves(stmts, true);
}

function block_leaves(stmts: ast.Stmt[], jumps: boolean): boolean {
  if (stmts.len() == 0) {
    return false;
  }
  let last: ast.Stmt = stmts[stmts.len() - 1];
  match (last) {
    ast.StmtBreak(_) => {
      return jumps;
    },
    ast.StmtContinue(_) => {
      return jumps;
    },
    ast.StmtReturn(_) => {
      return true;
    },
    ast.StmtIf(f) => {
      // A tuple / struct / literal / nested-variant match is replaced at parse
      // time by a done-flag or if/else chain (build_tuple_match and friends),
      // which falls through by construction — so reading the chain says every
      // such function can fall off its end (#8461). The `if` carries the arms
      // as written; apply the same rules the StmtMatch arm below applies.
      let bodies: ast.Stmt[][] = sugar_arm_bodies(f.sugar);
      if (bodies.len() > 0) {
        // A `let … else` folds the rest of the enclosing block into its
        // success arm; the else arm is required to diverge (E022), so the
        // construct's only fall-through path is the success arm.
        if (f.sugar.origin == "let_else") {
          return block_leaves(bodies[0], jumps);
        }
        // An `if let` always carries a trailing wildcard arm holding the else
        // block — empty when the source wrote none, which does not exit, so
        // the one-armed form falls through the way native's `If` does.
        for body in bodies {
          if (!block_leaves(body, jumps)) {
            return false;
          }
        }
        return true;
      }
      // An if on a literal takes one arm: `if (true)` leaves when its then
      // arm does (a bare `{ … }` statement parses as one, and a pruned
      // branch on the target is one), `if (false)` when its else arm does.
      match (f.cond) {
        ast.ExprBool(b) => {
          if (b.value) {
            return block_leaves(f.then_body, jumps);
          }
          return block_leaves(f.else_body, jumps);
        },
        _ => {}
      }
      return block_leaves(f.then_body, jumps) && block_leaves(f.else_body, jumps);
    },
    ast.StmtWhile(w) => {
      match (w.cond) {
        ast.ExprBool(b) => {
          return b.value && !loop_can_break(w.body, w.label, false);
        },
        _ => {
          return false;
        }
      }
    },
    ast.StmtMatch(m) => {
      if (m.arms.len() == 0) {
        return false;
      }
      // A `let … else` desugar folds the rest of the enclosing block
      // into its success arm (arm[0]); the trailing `_` arm is the else
      // branch, which is REQUIRED to diverge (enforced separately by
      // E022). So the construct's only fall-through path is the success
      // arm — exits iff that arm exits, regardless of the else arm. (A
      // non-diverging else is E022, not a missing-return E052.)
      if (m.origin == "let_else") {
        return block_leaves(m.arms[0].body, jumps);
      }
      for arm in m.arms {
        if (!block_leaves(arm.body, jumps)) {
          return false;
        }
      }
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// loop_can_break reports whether `stmts`, the body of a loop, holds a
// `break` that targets that loop — an unlabelled break not inside a nested
// loop, or a labelled one naming `label`. Mirrors the Go checker's
// loopCanBreak: a loop that can break does not diverge, and treating it as
// divergent accepts a function that falls off its end (#8447). A value
// block — the desugar of a block-, if- or match-expression — is walked
// because the lowering inlines it, so its `break` targets this loop (#8562); a
// lambda body is not, since its `break` belongs to a loop of its own. A
// nested loop's header expression runs in this loop's context, so only the
// nested BODY counts as nested.
function loop_can_break(stmts: ast.Stmt[], label: string, nested: boolean): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtBreak(bk) => {
        if (bk.label.len() == 0) {
          if (!nested) {
            return true;
          }
        } else if (bk.label == label) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (expr_can_break(w.cond, label, nested) || loop_can_break(w.body, label, true)) {
          return true;
        }
      },
      ast.StmtFor(fr) => {
        if (expr_can_break(fr.iter, label, nested) || loop_can_break(fr.body, label, true)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (expr_can_break(f.cond, label, nested) || loop_can_break(f.then_body, label, nested) || loop_can_break(f.else_body, label, nested)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        if (expr_can_break(m.scrutinee, label, nested)) {
          return true;
        }
        for arm in m.arms {
          if (arm.has_guard && expr_can_break(arm.guard, label, nested) || loop_can_break(arm.body, label, nested)) {
            return true;
          }
        }
      },
      ast.StmtDefer(_) => {},
      _ => {
        if (astwalk.fold_stmt_pruned(
          stmt, false, (e: ast.Expr, own a: boolean): boolean => a || value_block_can_break(e, label, nested),
          not_a_scope_root,
        )) {
          return true;
        }
      }
    }
  }
  return false;
}

// expr_can_break is loop_can_break over the value blocks one expression holds.
function expr_can_break(e: ast.Expr, label: string, nested: boolean): boolean {
  return astwalk.fold_expr_pruned(
    e, false, (x: ast.Expr, own a: boolean): boolean => a || value_block_can_break(x, label, nested),
    not_a_scope_root,
  );
}

function value_block_can_break(e: ast.Expr, label: string, nested: boolean): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (parser.is_value_block(c)) {
        return loop_can_break(parser.vb_body(c), label, nested);
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// label_in_scope reports whether `name` is one of the enclosing loop
// labels (mirrors the Go checker's labelInScope over its loopLabels stack).
// A labeled `break`/`continue` may only target a loop it is nested inside.
function label_in_scope(labels: string[], name: string): boolean {
  for label in labels {
    if (label == name) {
      return true;
    }
  }
  return false;
}

// with in_loop = true, while `if` / `match` / `defer` pass the flag
// through unchanged — so a `break` in a match arm is legal only when that
// match is itself inside a loop (matching the Go checker).
//
// `labels` is the stack of enclosing loop labels (a labeled `while`/`for`
// pushes its label onto the stack for its body). A labeled `break L` /
// `continue L` whose `L` names no enclosing loop is E058 — but only when
// it IS inside a loop, since an out-of-loop break is already E011 (the Go
// checker reports E058 in the `else` branch after the E011 check, so the
// two never both fire on one statement).
// loop_diags_in_exprs runs loop_diags over the statement lists one statement's
// expressions hold, each with the scope it needs. An ordinary lambda is a
// scope: a label does not cross a function boundary and a `break` inside one is
// E011, so it recurses with in_loop = false and no labels. A value block is not
// — it is an if-/match-expression desugar that the lowering inlines, so
// `t = t + { if (c) { break; } i }` breaks the enclosing loop and inherits both.
//
// `not_a_scope_root` stops the fold at both node kinds, so a value block's
// callee is never also seen as a bare lambda, and a nested lambda is reached
// when its own enclosing body is walked rather than here.
//
// The accumulator is util.Diag[] rather than a list of bodies: a `ast.Stmt[][]`
// does not lower in the self-host — `append` on an array-of-arrays of a union
// resolves to `i32.append` and the module falls off the IR path.
function loop_diags_in_exprs(st: ast.Stmt, in_loop: boolean, labels: string[]): util.Diag[] {
  return astwalk.fold_stmt_pruned(
    st, no_diags(), (e: ast.Expr, own a: util.Diag[]): util.Diag[] => {
      match (e) {
        ast.ExprCall(c) => {
          if (parser.is_value_block(c)) {
            return util.append_diags(a, loop_diags(parser.vb_body(c), in_loop, labels));
          }
          return a;
        },
        ast.ExprLambda(lm) => {
          let nolabels: string[] = [];
          return util.append_diags(a, loop_diags(lm.body, false, nolabels));
        },
        _ => {
          return a;
        }
      }
      return a;
    },
    not_a_scope_root,
  );
}

function not_a_scope_root(e: ast.Expr): boolean {
  match (e) {
    ast.ExprLambda(_) => {
      return false;
    },
    ast.ExprCall(c) => {
      return !parser.is_value_block(c);
    },
    _ => {
      return true;
    }
  }
  return true;
}

function loop_diags(stmts: ast.Stmt[], in_loop: boolean, labels: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtBreak(bk) => {
        if (!in_loop) {
          out = out.append(dg_at("E011", "break outside of a loop", bk.line, bk.col));
        } else if (bk.label.len() > 0 && !label_in_scope(labels, bk.label)) {
          out = out.append(dg_at("E058", "break label \"" + bk.label + "\" does not match any enclosing loop", bk.line, bk.col));
        }
      },
      ast.StmtContinue(ck) => {
        if (!in_loop) {
          out = out.append(dg_at("E011", "continue outside of a loop", ck.line, ck.col));
        } else if (ck.label.len() > 0 && !label_in_scope(labels, ck.label)) {
          out = out.append(dg_at("E058", "continue label \"" + ck.label + "\" does not match any enclosing loop", ck.line, ck.col));
        }
      },
      ast.StmtWhile(w) => {
        let wl: string[] = labels;
        if (w.label.len() > 0) {
          wl = labels.append(w.label);
        }
        out = util.append_diags(out, loop_diags(w.body, true, wl));
      },
      ast.StmtFor(fr) => {
        let fl: string[] = labels;
        if (fr.label.len() > 0) {
          fl = labels.append(fr.label);
        }
        out = util.append_diags(out, loop_diags(fr.body, true, fl));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, loop_diags(f.then_body, in_loop, labels));
        out = util.append_diags(out, loop_diags(f.else_body, in_loop, labels));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, loop_diags(arm.body, in_loop, labels));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, loop_diags(one, in_loop, labels));
      },
      _ => {
        // A lambda body is NOT inside the enclosing loop: a label does not cross
        // a function boundary, and native rejects `break outer` from inside one
        // with E011. Without this descent the body was never visited, so the
        // illegal break was accepted (#7199) — the same lambda blindness as the
        // label RESOLVER had, one layer up.
        out = util.append_diags(out, loop_diags_in_exprs(stmt, in_loop, labels));
      }
    }
  }
  return out;
}

// count_type_args returns the number of top-level type arguments a
// `Name[A, B, …]` annotation supplies to its head generic (2 for `Map[K, V]`,
// 1 for `Box[i32]`), or -1 when the annotation is not a top-level generic
// instantiation (a bare name, a tuple, or an array). Decodes via the structured
// TypeRef (SH-021, docs/SELF-HOST-AUDIT.md T2) instead of a first-`[` + trailing-
// `]` window with a depth-tracking top-level-comma count; parse_type_ref already
// splits the args without letting a nested generic's / tuple's inner commas
// confuse the count. An ARRAY (`Box[i32][]`, array_depth > 0) is a value of array
// type, not a generic instantiation, so it returns -1 (the former scan treated a
// trailing `[]` as a 0-arg generic bracket — a value only reachable on an array
// annotation, which is never a struct's own generic head for the E019 arity check
// this feeds; the fixpoints confirm the arity diagnostics are unchanged).
pub function count_type_args(t: string): i32 {
  let r: parser.TypeRef = parser.parse_type_ref(t);
  if (r.is_tuple || r.is_view || r.array_depth > 0 || r.args.len() == 0) {
    return 0 - 1;
  }
  return r.args.len();
}

// struct_type_param_count returns how many type parameters the struct
// `name` declares, or -1 if there's no such struct.
//
// The parser desugars every enum variant into a StructDecl pushed to the same
// table (`enum_owner` names the enum). A variant is not a type head — Go answers
// E064 for `Yes[i32]`, never E019 — so variants are skipped here, and a variant
// sharing a builtin's name (`enum Stage { Map(..) }`) leaves `Map[K, V]` alone.
function struct_type_param_count(structs: parser.StructDecl[], name: string): i32 {
  for sd in structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return sd.type_params.len();
    }
  }
  return 0 - 1;
}

// struct_decl_line / struct_decl_col return the declaration position of a
// named struct (0 when absent). E019 is reported at the struct's
// definition (Go's `sd.P`), not the use site. Variants are skipped for the
// same reason as in struct_type_param_count.
function struct_decl_line(structs: parser.StructDecl[], name: string): i32 {
  for sd in structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return sd.line;
    }
  }
  return 0;
}

function struct_decl_col(structs: parser.StructDecl[], name: string): i32 {
  for sd in structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return sd.col;
    }
  }
  return 0;
}

// type_base strips a `[...]` suffix from a type annotation: `Box[i32]` ->
// `Box`, `P` -> `P`.
// type_base -> util.base_type_name (SH-020).
// dot_index returns the byte index of the first '.' in s, or -1. A
// variant pattern that still carries a dot at check time is qualified by
// an *enum* name (module qualifiers are mangled to `__` by flatten before
// the checker runs), which the E029 check keys off.
function dot_index(s: string): i32 {
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b'.') {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// variant_pattern_name is the variant a pattern names, with any ENUM qualifier
// stripped: `E.Wrap` -> `Wrap`, and in a prefix-mangled module
// `lib__E.lib__Wrap` -> `lib__Wrap`. That suffix is the name the enum's variant
// list and the variant struct are both keyed by — the same strip the lowering does
// when it lowers the arm. A module qualifier never survives to here (flatten
// mangles it to `__`), so a dot at this point is always the enum spelling.
function variant_pattern_name(name: string): string {
  let d: i32 = dot_index(name);
  if (d < 0) {
    return name;
  }
  return slice_unchecked(name, d + 1, name.len()) + "";
}

// variant_pattern_owner is the ENUM half of the same spelling — `E.Wrap` ->
// `E`, `lib__E.lib__Wrap` -> `lib__E` — and "" for an unqualified pattern,
// whose owner is not written down. It is what a variant struct's enum_owner
// is compared against, so two enums declaring the same variant name each
// answer for their own decl.
function variant_pattern_owner(name: string): string {
  let d: i32 = dot_index(name);
  if (d < 0) {
    return "";
  }
  return slice_unchecked(name, 0, d) + "";
}

// type_arity_diag checks one type annotation: if it supplies an explicit
// `[...]` argument list whose count doesn't match the named struct's or
// enum's declared type-parameter count, it's E019. Checked at every
// annotation position: parameter, struct field, return and body `let`. At
// the last two the Go checker adds an E003 / E002 on the mismatched value as
// well; this reports the E019 alone. A declaration that shadows a built-in's
// name is E010 and its arity is not judged, as native's reservedShadows
// skips it: the built-in's own uses would otherwise count against the
// shadowing declaration.
function type_arity_diag(t: string, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  // An array of an instantiation (`Pair[i32][]`) names the same head.
  while (t.len() > 2 && slice_unchecked(t, t.len() - 2, t.len()) == "[]") {
    t = slice_unchecked(t, 0, t.len() - 2) + "";
  }
  let nargs: i32 = count_type_args(t);
  if (nargs < 0) {
    return out;
  }
  let base: string = util.base_type_name(t);
  let shadows: boolean = parser.is_reserved_struct_name(base) || parser.is_reserved_enum_name(base);
  let tpc: i32 = struct_type_param_count(structs, base);
  if (tpc >= 0) {
    if (nargs != tpc && !shadows) {
      out = out.append(dg_at("E019", util.arity_message("struct " + base, tpc, nargs, "type argument"), struct_decl_line(structs, base), struct_decl_col(structs, base)));
    }
    return out;
  }
  // A built-in's name means the built-in: a declaration shadowing it is E010.
  if (parser.is_reserved_struct_name(base)) {
    let stp: i32 = parser.reserved_struct_tparams(base).len();
    if (nargs != stp) {
      out = out.append(dg_at("E019", util.arity_message("struct " + base, stp, nargs, "type argument"), 0, 0));
    }
    return out;
  }
  if (parser.is_reserved_enum_name(base)) {
    let etp: i32 = parser.reserved_enum_tparams(base).len();
    if (nargs != etp) {
      out = out.append(dg_at("E019", util.arity_message("enum " + base, etp, nargs, "type argument"), 0, 0));
    }
    return out;
  }
  for ed in enums {
    if (ed.name == base && ed.type_params.len() != nargs && !shadows) {
      return out.append(dg_at("E019", util.arity_message("enum " + base, ed.type_params.len(), nargs, "type argument"), ed.line, ed.col));
    }
  }
  return out;
}

// match_diags emits the structural `match`-arm diagnostics (no types
// needed): E026 when a wildcard `_` arm isn't the last arm, and E028 when
// a variant pattern repeats one covered by an earlier arm. Recurses into
// nested blocks + arm bodies.
// variant_payload_count returns the payload count of an enum variant — its
// synthesized struct carries one `__ev` marker field per payload — and -1
// otherwise (skip the E015 check). A struct WITHOUT `__ev` is ambiguous: it
// could be a no-payload enum variant (`Nil`) OR a struct-union member
// (`type U = A | B`, where `A(a)` binds the whole struct, not a payload), and
// the two aren't distinguishable here, so we conservatively skip rather than
// risk a false E015.
function variant_payload_count(name: string, structs: StructTable): i32 {
  let sd: StructSig = find_variant_sig(structs, name);
  if (sd.name.len() == 0 || !util.has_str(sd.field_names, "__ev")) {
    return 0 - 1;
  }
  // A multi-payload variant carries `__ev`, `__ev1`, … — count every
  // `__ev`-prefixed field so the E015 arity check allows a matching
  // multi-binding `V(a, b)`.
  let c: i32 = 0;
  for field_name in sd.field_names {
    let fn: string = field_name;
    if (fn.len() >= 4 && slice_unchecked(fn, 0, 4) == "__ev") {
      c = c + 1;
    }
  }
  return c;
}

// payload_arity_diags is E015 for a variant pattern binding a different number
// of payloads than `variant` (a bare or `Enum.Variant` spelling) carries. A
// union's member struct is its one payload.
function payload_arity_diags(pv: ast.PatVariant, variant: string, structs: StructTable, unions: UnionTable, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let pc: i32 = variant_payload_count(variant, structs);
  let owner: UnionSig = union_sig_of_variant(variant_pattern_name(variant), unions);
  if (pc < 0 && owner.name.len() > 0 && !owner.is_enum) {
    pc = 1;
  }
  if (pc >= 0) {
    let nb: i32 = pv.extra_bindings.len();
    if (pv.binding.len() > 0) {
      nb = nb + 1;
    }
    if (nb != pc) {
      out = out.append(dg_at("E015", payload_count_message(shown_variant_in(structs, pv.type_name), pc, nb), line, col));
    }
  }
  return out;
}

// variant_owner_count is how many enums declare a variant named `name`.
function variant_owner_count(name: string, structs: StructTable): i32 {
  let owners: string[] = [];
  let k: i32 = structs.index.chain(name);
  while (k >= 0) {
    let sd: StructSig = structs.structs[k];
    if (sd.name == name && sd.enum_owner.len() > 0 && !util.has_str(owners, sd.enum_owner)) {
      owners = owners.append(sd.enum_owner);
    }
    k = structs.index.next[k];
  }
  return owners.len();
}

// record_pattern_diags explains a record-form pattern (`Rect { h, x }`) that
// resolve_variant_fields_module left unresolved: it named a field the variant
// does not declare, named one twice, or missed one without `..` — or the
// variant carries positional payloads and cannot be matched by name at all.
// Mirrors native's settleNamedVariantPattern.
function record_pattern_diags(pvin: ast.PatVariant, structs: StructTable, line: i32, col: i32): util.Diag[] {
  // Native's wording uses the BARE variant name, so the pattern is stripped at
  // entry and every message below reads off `pv`. The SIG is still resolved
  // from the original spelling, whose qualifier names the owning enum — the
  // one thing that tells two enums' same-named variants apart.
  let pv: ast.PatVariant = ast.PatVariant { ...pvin, type_name: shown_variant_in(structs, pvin.type_name) };
  let out: util.Diag[] = [];
  let ss: StructSig = find_variant_sig(structs, pvin.type_name);
  if (ss.name.len() == 0) {
    return out;
  }
  let decl: string[] = ss.variant_field_names;
  if (decl.len() == 0) {
    return out.append(dg_at("E015", "variant " + pv.type_name + " has positional payloads; match it as " + pv.type_name + "(...), not " + pv.type_name + " { ... }", line, col));
  }
  let bound: string[] = [];
  for field_name in pv.field_names {
    let nm: string = field_name;
    if (!util.has_str(decl, nm)) {
      out = out.append(dg_at("E015", "variant " + pv.type_name + " has no field \"" + nm + "\"", line, col));
    } else if (util.has_str(bound, nm)) {
      out = out.append(dg_at("E015", "field \"" + nm + "\" bound more than once in pattern for " + pv.type_name, line, col));
    } else {
      bound = bound.append(nm);
    }
  }
  if (bound.len() != decl.len() && !pv.rest_written) {
    out = out.append(missing_pattern_fields_diag(pv.type_name, decl, line, col));
  }
  return out;
}

// missing_pattern_fields_diag is E015 for a named-field pattern that leaves a
// field of `name` out without a trailing `..`.
function missing_pattern_fields_diag(name: string, decl: string[], line: i32, col: i32): util.Diag {
  let listed: string = "";
  let d: i32 = 0;
  while (d < decl.len()) {
    if (d > 0) {
      listed = listed + ", ";
    }
    listed = listed + decl[d];
    d = d + 1;
  }
  return dg_at("E015", "named-field pattern for " + util.demangle(name) + " must bind all " + util.i32_to_string(decl.len()) + " field(s) (" + listed + "), or end in `..` to leave the rest out", line, col);
}

// destructure_covers_diags is struct_pattern_covers_diags for a `let`,
// parameter or `for` destructure, which reaches here as its marker.
function destructure_covers_diags(v: ast.StmtVar, structs: StructTable): util.Diag[] {
  if (!parser.is_struct_destr_marker(v.type_name)) {
    return [];
  }
  let (fields, _) = struct_destr_fields(v.type_name);
  return struct_pattern_covers_diags(struct_destr_name(v.type_name), fields, parser.destr_marker_split(v.type_name).rest_written, structs, v.line, v.col);
}

// struct_arms_cover_diags is struct_pattern_covers_diags for each arm of a
// desugared struct match.
function struct_arms_cover_diags(arms: ast.StructArm[], structs: StructTable): util.Diag[] {
  let out: util.Diag[] = [];
  for sa in arms {
    if (!sa.is_wild) {
      out = util.append_diags(out, struct_pattern_covers_diags(sa.type_name, sa.fields, sa.rest_written, structs, sa.line, sa.col));
    }
  }
  return out;
}

// struct_pattern_covers_diags holds a struct pattern to the rule a named-field
// variant pattern keeps: it names every field of struct `name` unless it ends
// in `..`.
function struct_pattern_covers_diags(name: string, fields: string[], rest: boolean, structs: StructTable, line: i32, col: i32): util.Diag[] {
  let sig: StructSig = find_struct_sig(structs, name);
  if (rest || sig.name.len() == 0) {
    return [];
  }
  // An unknown field is reported on its own; the count would only repeat it.
  for f in fields {
    if (!util.has_str(sig.field_names, f)) {
      return [];
    }
  }
  for f in sig.field_names {
    if (!util.has_str(fields, f)) {
      return [missing_pattern_fields_diag(name, sig.field_names, line, col)];
    }
  }
  return [];
}

// payload_slot_type_name is the declared type SPELLING of a variant's payload
// slot `idx` — the `__ev` / `__ev<idx>` field of its synthesized struct — or
// "" when the variant or the slot is unknown.
function payload_slot_type_name(ss: StructSig, idx: i32): string {
  let want: string = "__ev";
  if (idx > 0) {
    want = "__ev" + util.i32_to_string(idx);
  }
  let i: i32 = 0;
  while (i < ss.field_names.len()) {
    if (ss.field_names[i] == want && i < ss.field_type_names.len()) {
      return util.base_type_name(ss.field_type_names[i]);
    }
    i = i + 1;
  }
  return "";
}

// payloadless_binder_diags reports a bare payload-LESS variant name used as a
// payload binder: `Wrap(Er2)` binds the payload under the name `Er2` and so
// matches every value, where the author plainly meant to test for Er2. The
// spelling that does test the tag is `Wrap(Er2())`. Native rejects the same
// shape (resolveVariantBindings); this is that rule, scoped the same way — the
// name must be a variant of the enum THIS slot holds, so an unrelated binder
// that happens to share a variant's name elsewhere is untouched.
function payloadless_binder_diags(pv: ast.PatVariant, structs: StructTable, unions: UnionTable, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let ss: StructSig = find_variant_sig(structs, pv.type_name);
  if (ss.name.len() == 0) {
    return out;
  }
  let slot: i32 = 0;
  while (slot < pv.extra_bindings.len() + 1) {
    let nm: string = pv.binding;
    if (slot > 0) {
      nm = pv.extra_bindings[slot - 1];
    }
    if (nm.len() > 0 && nm != "_") {
      let pt: string = payload_slot_type_name(ss, slot);
      if (pt.len() > 0 && union_of_variant(nm, unions) == pt && variant_payload_count(nm, structs) < 0) {
        out = out.append(dg_at("E015", nm + " is a payload-less variant of enum " + pt + ", but a bare name in a payload slot is a binder that matches every value — write `" + nm + "()` to match the variant, or rename the binder", line, col));
      }
    }
    slot = slot + 1;
  }
  return out;
}

// generic_binder_diags is payloadless_binder_diags for a slot whose declared
// type is one of its enum's type variables (`Some(T)`): which enum the slot
// holds is known only from the scrutinee's instantiation, so the rule runs
// where the arm is typed. A slot declared at a concrete enum is
// payloadless_binder_diags' and is skipped here.
function generic_binder_diags(pv: ast.PatVariant, s: Scope, whole: typeinfo.Type, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let ss: StructSig = find_variant_sig(s.structs, pv.type_name);
  let slot: i32 = 0;
  while (slot < pv.extra_bindings.len() + 1) {
    let nm: string = pv.binding;
    if (slot > 0) {
      nm = pv.extra_bindings[slot - 1];
    }
    if let typeinfo.TypeUnion(u) = variant_pattern_payload_type(s, pv.type_name, whole, slot) {
      let declared: string = "";
      if (ss.name.len() > 0) {
        declared = payload_slot_type_name(ss, slot);
      }
      let owner: string = union_of_variant(nm, s.unions);
      if (owner.len() == 0) {
        owner = parser.builtin_enum_of(nm);
      }
      if (nm.len() > 0 && nm != "_" && declared != u.name && owner == u.name && variant_payload_count(nm, s.structs) < 0) {
        out = out.append(dg_at("E015", nm + " is a payload-less variant of enum " + u.name + ", but a bare name in a payload slot is a binder that matches every value — write `" + nm + "()` to match the variant, or rename the binder", line, col));
      }
    }
    slot = slot + 1;
  }
  return out;
}

// match_stmt_own_lambdas checks the match statements inside any lambda sitting
// in `st`'s own expressions. match_diags walks STATEMENTS and never entered an
// expression, so a `match` written inside a lambda body escaped E015 / E026 /
// E028 entirely — and since a nested named function parses as a StmtVar holding
// an ExprLambda, that covered both spellings.
//
// Pruned at ExprLambda for the reason e049_stmt_own_lambdas is: the recursive
// match_diags call already covers the whole body, nested lambdas included, so
// descending would report each inner one once per enclosing lambda.
function match_stmt_own_lambdas(st: ast.Stmt, structs: StructTable, unions: UnionTable): util.Diag[] {
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, match_diags(lm.body, structs, unions));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, not_into_lambda);
}

// Desugared tuple and struct matches retain source patterns on their outer
// if. A guard can fall through; an all-binding arm without one cannot.
function sugar_unreachable_diags(sg: ast.MatchSugar): util.Diag[] {
  if (sg.origin != "") {
    return [];
  }
  return util.append_diags(tuple_unreachable_diags(sg.tup), struct_unreachable_diags(sg.strct));
}

function tuple_unreachable_diags(arms: ast.TupArm[]): util.Diag[] {
  let out: util.Diag[] = [];
  let covered: boolean = false;
  for a in arms {
    if (covered) {
      out = out.append(dg_at("E026", "arm is unreachable — a preceding arm matches every value", a.line, a.col));
    }
    if (!a.has_guard && (a.is_wild || tuple_binders_only(a.elem_kinds, a.elem_pats))) {
      covered = true;
    }
  }
  return out;
}

function struct_unreachable_diags(arms: ast.StructArm[]): util.Diag[] {
  let out: util.Diag[] = [];
  let covered: boolean = false;
  for a in arms {
    if (covered) {
      out = out.append(dg_at("E026", "arm is unreachable — a preceding arm matches every value", a.line, a.col));
    }
    if (!a.has_guard && (a.is_wild || binds_only(a.field_kinds))) {
      covered = true;
    }
  }
  return out;
}

function tuple_binders_only(kinds: i32[], pats: ast.Pattern[]): boolean {
  let i: i32 = 0;
  while (i < kinds.len()) {
    if (kinds[i] == 4 && i < pats.len()) {
      if let ast.PatVariant(p) = pats[i] {
        if (!tuple_binders_only(p.tup_kinds, p.tup_pats)) {
          return false;
        }
      } else {
        return false;
      }
    } else if (kinds[i] != 0 && kinds[i] != 1) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// match_diags keeps its own statement recursion rather than folding onto
// astwalk. A pre-order fold visits the whole match node before any arm BODY, so
// every outer arm's diagnostics would precede a nested match's — measured
// against the Go checker, which interleaves them per arm as this does. The fold
// is used for the one thing it is right for here: reaching the lambdas.
function match_diags(stmts: ast.Stmt[], structs: StructTable, unions: UnionTable): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtMatch(m) => {
        let seen: string[] = [];
        let a: i32 = 0;
        while (a < m.arms.len()) {
          match (m.arms[a].pattern) {
            ast.PatWildcard(_) => {
              if (a < m.arms.len() - 1) {
                out = out.append(dg_at("E026", "wildcard `_` arm must be last in the match", m.arms[a].line, m.arms[a].col));
              }
            },
            ast.PatVariant(pv) => {
              out = util.append_diags(out, payloadless_binder_diags(pv, structs, unions, m.arms[a].line, m.arms[a].col));
              if (pv.type_name.len() > 0) {
                if (util.has_str(seen, pv.type_name)) {
                  out = out.append(dg_at("E028", "variant \"" + shown_variant_in(structs, pv.type_name) + "\" already covered earlier in this match", m.arms[a].line, m.arms[a].col));
                } else if (!m.arms[a].has_guard) {
                  // Only an UNGUARDED arm fully covers its variant. A
                  // guarded arm (`V(x) when cond =>`) may fall through, so
                  // it must NOT mark V covered — the standard
                  // guarded-then-unguarded shape (`Red when.. =>, Red =>`)
                  // is legal, and E030 still requires the later unguarded
                  // arm. Mirrors native checker.go:8318-8331 (#4344).
                  seen = seen.append(pv.type_name);
                }
                if (parser.is_record_pattern(pv)) {
                  // A record-form pattern that resolve_variant_fields_module
                  // could not settle against the variant's declared fields.
                  out = util.append_diags(out, record_pattern_diags(pv, structs, m.arms[a].line, m.arms[a].col));
                } else if (dot_index(pv.type_name) >= 0 || variant_owner_count(pv.type_name, structs) < 2) {
                  // E015: payload-binding arity. A bare name several enums
                  // declare is checked against the scrutinee's enum, in
                  // stmts_call_diags, which knows it.
                  out = util.append_diags(out, payload_arity_diags(pv, pv.type_name, structs, unions, m.arms[a].line, m.arms[a].col));
                }
              }
            }
          }
          out = util.append_diags(out, match_diags(m.arms[a].body, structs, unions));
          a = a + 1;
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, match_diags(f.then_body, structs, unions));
        out = util.append_diags(out, match_diags(f.else_body, structs, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, match_diags(w.body, structs, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, match_diags(fr.body, structs, unions));
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, match_diags(one, structs, unions));
      },
      _ => {}
    }
    out = util.append_diags(out, match_stmt_own_lambdas(stmt, structs, unions));
  }
  return out;
}

// magnitude_is_zero reports whether the numeral from `start` is all zeros.
function magnitude_is_zero(text: string, start: i32): boolean {
  let i: i32 = start;
  while (i < text.len() && text[i] as i32 == 48) {
    i = i + 1;
  }
  return i == text.len();
}

function main_result_ty(ty: string): boolean {
  return ty == "void" || ty == "boolean" || ty == "i32" || ty == "i64" || is_unsigned_int_ty(ty);
}

function is_unsigned_int_ty(ty: string): boolean {
  return ty == "u8" || ty == "u32" || ty == "u64" || ty == "usize";
}

// int_ty_max_dec / int_ty_max_hex are the largest magnitude each integer type
// holds, in decimal and in hex. A negated signed literal reaches one further
// down than up — i32 MIN is -2147483648 — so the sign selects the bound. A
// name that is not an integer type has no bound and returns "".
function int_ty_max_dec(ty: string, negated: boolean): string {
  if (ty == "i32") {
    if (negated) {
      return "2147483648";
    }
    return "2147483647";
  }
  if (ty == "i64") {
    if (negated) {
      return "9223372036854775808";
    }
    return "9223372036854775807";
  }
  if (ty == "u8") {
    return "255";
  }
  if (ty == "u32") {
    return "4294967295";
  }
  // usize's ceiling is the widest target's; wasm32 refuses a literal past its
  // 32 bits where it emits the constant.
  if (ty == "u64" || ty == "usize") {
    return "18446744073709551615";
  }
  return "";
}

function int_ty_max_hex(ty: string, negated: boolean): string {
  if (ty == "i32") {
    if (negated) {
      return "80000000";
    }
    return "7fffffff";
  }
  if (ty == "i64") {
    if (negated) {
      return "8000000000000000";
    }
    return "7fffffffffffffff";
  }
  if (ty == "u8") {
    return "ff";
  }
  if (ty == "u32") {
    return "ffffffff";
  }
  if (ty == "u64" || ty == "usize") {
    return "ffffffffffffffff";
  }
  return "";
}

// int_lit_fits reports whether the magnitude `text` — a decimal or `0x`
// numeral — is inside `ty`'s range when the source wrote it with the given
// sign. Zero has no sign, an unsigned type has no negative values at all, and
// a `ty` naming no integer type has no rule to apply.
function int_lit_fits(text: string, ty: string, negated: boolean): boolean {
  let hex: boolean = parser.is_hex_lit(text);
  let start: i32 = 0;
  if (hex) {
    start = 2;
  }
  let neg: boolean = negated && !magnitude_is_zero(text, start);
  if (neg && is_unsigned_int_ty(ty)) {
    return false;
  }
  let max: string = int_ty_max_dec(ty, neg);
  if (hex) {
    max = int_ty_max_hex(ty, neg);
  }
  if (max.len() == 0) {
    return true;
  }
  return parser.magnitude_fits(text, start, max);
}

// int_lit_as_written is the numeral the diagnostic quotes: hex as the source
// spelled it, decimal with leading zeros dropped, and a `-` when the source
// wrote one.
function int_lit_as_written(text: string, negated: boolean): string {
  let prefixed: boolean = parser.is_hex_lit(text)
    || text.len() > 2 && text[0] == b'0' && (text[1] == b'o' || text[1] == b'O' || text[1] == b'b' || text[1] == b'B');
  let start: i32 = 0;
  let out: string = text;
  if (prefixed) {
    start = 2;
  } else {
    let i: i32 = 0;
    while (i + 1 < text.len() && text[i] as i32 == 48) {
      i = i + 1;
    }
    out = slice_unchecked(text, i, text.len()) + "";
  }
  if (negated && !magnitude_is_zero(text, start)) {
    return "-" + out;
  }
  return out;
}

// dupvar_stmt_own_lambdas checks the blocks inside any lambda sitting in `st`'s
// own expressions. dupvar_diags walks STATEMENTS and never entered an
// expression, so a duplicate `let` (E013) written inside a lambda body went
// unreported — and a nested named function parses as a StmtVar holding an
// ExprLambda, so that covered both spellings.
//
// A lambda body is its own block, so the recursive call gets a fresh
// duplicate-set, which is what the per-block rule wants. Pruned at ExprLambda:
// that call already covers the whole body, nested lambdas included.
function dupvar_stmt_own_lambdas(st: ast.Stmt): util.Diag[] {
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, dupvar_diags(lm.body));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, not_into_lambda);
}

// dupvar_diags emits the structural `let`-declaration diagnostics, per
// block: E013 for a name already declared by an earlier `let` IN THE SAME
// BLOCK (each block — function body, branch, loop / match-arm body — gets
// a fresh name set, so shadowing across nested blocks / over a parameter
// is allowed, matching the Go checker), and E020 for an un-annotated
// `let x = []` whose empty-array initializer can't infer an element type.
// A literal's RANGE is judged where its type settles instead — off the
// destination type (int_dest_range_diags), not off the annotation's spelling.
function duplicate_var_diag(stmts: ast.Stmt[], v: ast.StmtVar): util.Diag {
  let d: util.Diag = dg_at("E013", "variable \"" + v.name + "\" already declared in this scope", v.line, v.col);
  for stmt in stmts {
    if let ast.StmtVar(prior) = stmt {
      if (prior.line == v.line && prior.col == v.col) {
        return d;
      }
      if (prior.name == v.name && prior.line > 0) {
        d = util.Diag { ...d, related: [util.Related { line: prior.line, col: prior.col, length: 0, message: "previous declaration is here" }] };
      }
    }
  }
  return d;
}

function dupvar_diags(stmts: ast.Stmt[]): util.Diag[] {
  let out: util.Diag[] = [];
  let declared: string[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (util.has_str(declared, v.name)) {
          out = out.append(duplicate_var_diag(stmts, v));
        } else {
          declared = declared.append(v.name);
        }
        if (v.type_name.len() == 0) {
          match (v.init) {
            ast.ExprArray(arr) => {
              if (arr.elements.len() == 0) {
                out = out.append(dg_at("E020", "empty array literal needs a type annotation", v.line, v.col));
              }
            },
            _ => {}
          }
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, dupvar_diags(f.then_body));
        out = util.append_diags(out, dupvar_diags(f.else_body));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, dupvar_diags(w.body));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, dupvar_diags(fr.body));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, dupvar_diags(arm.body));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, dupvar_diags(one));
      },
      _ => {}
    }
    out = util.append_diags(out, dupvar_stmt_own_lambdas(stmt));
  }
  return out;
}

// LitSign records one integer literal written under a `-`/`+` chain: where it
// sits and how many minuses stand over it.
struct LitSign { line: i32, col: i32, minuses: i32 }

// lit_sign_chain walks the `-`/`+` chain rooted at `e` and records the literal
// it ends at with the number of minuses above it. A literal carries only its
// magnitude — the sign is the enclosing unary — so the range rule reads the
// sign from here. Every unary in a chain is visited by the fold below and
// contributes its own count, so the LARGEST count for a position is the whole
// chain's: `- -5` is positive.
function lit_sign_chain(e: ast.Expr, minuses: i32, own acc: LitSign[]): LitSign[] {
  match (e) {
    ast.ExprUnary(u) => {
      if (u.op == "-") {
        return lit_sign_chain(u.operand, minuses + 1, acc);
      }
      if (u.op == "+") {
        return lit_sign_chain(u.operand, minuses, acc);
      }
      return acc;
    },
    ast.ExprNumber(n) => {
      if (minuses == 0) {
        return acc;
      }
      return acc.append(LitSign { line: n.line, col: n.col, minuses: minuses });
    },
    _ => {
      return acc;
    }
  }
}

function lit_signs_stmts(stmts: ast.Stmt[]): LitSign[] {
  function at_unary(n: ast.Expr, own acc: LitSign[]): LitSign[] {
    match (n) {
      ast.ExprUnary(_) => {
        return lit_sign_chain(n, 0, acc);
      },
      _ => {
        return acc;
      }
    }
  }
  let signs: LitSign[] = [];
  for st in stmts {
    signs = astwalk.fold_stmt(st, signs, at_unary);
  }
  return signs;
}

function lit_negated(signs: LitSign[], line: i32, col: i32): boolean {
  let deepest: i32 = 0;
  for s in signs {
    if (s.line == line && s.col == col && s.minuses > deepest) {
      deepest = s.minuses;
    }
  }
  return deepest % 2 == 1;
}

// numeral_spelling is an integer literal as written, without its suffix: a
// `0o` / `0b` numeral's text is its value in hex, and its `raw` the spelling.
function numeral_spelling(n: ast.ExprNumber): string {
  if (n.raw.len() == 0) {
    return n.text;
  }
  return slice_unchecked(n.raw, 0, n.raw.len() - n.suffix.len()) + "";
}

// suffix_range_diag: E047 for a typed-suffix integer literal outside its own
// type's range. A suffix pins the type in the parser, so no destination ever
// settles the literal and no other rule judges it. A quoted literal (`'a'`,
// `b'0'`) uses the same node with its spelling in `raw` and is not a written
// numeral, so it is left alone.
function suffix_range_diag(num: ast.ExprNumber, negated: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  if ((!num.is_float && num.suffix.len() == 0 || parser.float_settled_int(num)) && !parser.is_quoted_literal(num) && !parser.is_unit_literal(num) && !int_lit_fits(num.text, "u64", false)) {
    return out.append(dg_at("E047", "literal " + num.text + " does not fit in any integer type; write it as a float for f64", num.line, num.col));
  }
  if (num.is_float || parser.is_quoted_literal(num) || num.suffix.len() == 0) {
    return out;
  }
  if (int_lit_fits(num.text, num.suffix, negated)) {
    return out;
  }
  let msg: string = "literal " + int_lit_as_written(numeral_spelling(num), negated) + " does not fit in " + num.suffix;
  if (negated && is_unsigned_int_ty(num.suffix)) {
    msg = msg + ": unsigned types have no negative values";
  }
  return out.append(dg_at("E047", msg, num.line, num.col));
}

function suffix_range_stmts(stmts: ast.Stmt[]): util.Diag[] {
  let signs: LitSign[] = lit_signs_stmts(stmts);
  function at_number(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprNumber(num) => {
        return util.append_diags(acc, suffix_range_diag(num, lit_negated(signs, num.line, num.col)));
      },
      _ => {
        return acc;
      }
    }
  }
  let out: util.Diag[] = [];
  for st in stmts {
    out = astwalk.fold_stmt(st, out, at_number);
  }
  return out;
}

// call_diags recurses through an expression (scope-threaded) emitting the
// expression-level diagnostics: E004 for a FREE function call whose
// argument count doesn't match the declared parameter count, E038 for a
// matching-arity free call whose argument types don't match, and E009 for
// a `&&` / `||` / `!` operand that isn't boolean. The call checks are
// conservative — a callee name that's a local binding (parameter, `let`,
// or closure) is skipped, so only a real module function sig is checked
// (method / closure arity + argument types are left to later slices).
// mlit_is_base reports whether an expression is the base constructor call
// of a desugared map literal — `map_new(n)` (string keys) or
// `__map_new_i32(n)` (integer keys), which the parser's parse_map_lit emits
// before chaining `.insert(k, v)` per entry. Used to find a map literal's
// FIRST `.insert` (whose object is this base) so its key type can be
// checked (E045).
function mlit_is_base(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(bc) => {
      match (bc.callee) {
        ast.ExprIdent(bid) => {
          return is_map_new_name(bid.name);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// is_map_new_name reports whether `name` is one of the empty-map constructors.
function is_map_new_name(name: string): boolean {
  return name == "map_new" || name == "__map_new_i32";
}

// unsettled_int_literal: is `e` an integer literal that has not been pinned to a
// width — a bare `1`, not `1i64` and not `1.0` — or an arithmetic combination of
// only those? This is the expression set native's settleFloat descends
// (`internal/check/checker/checker.go`): a NumberLit, unary minus, and the four
// arithmetic binaries. Everything else is already typed and settles nothing,
// which is why an IDENTIFIER is absent: native rejects `let a: i32 = 1; let x:
// f64 = a;` exactly as the self-host does, so the rule is literal-only rather
// than an i32 -> f64 widening.
function unsettled_int_literal(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      // A wide literal is already settled at i64 by its magnitude, so it is
      // not free to be read at the destination's width. The unit is not a
      // numeral at all — it is typed `void` and settles nowhere.
      return !n.is_float && n.suffix.len() == 0 && !parser.is_unit_literal(n)
        && !parser.literal_is_i64(n.text);
    },
    ast.ExprUnary(u) => {
      if (u.op == "-") {
        // `-2147483648` is i32-min. The magnitude rule judges the operand's
        // POSITIVE text, where 2147483648 is one past i32-max, so the
        // negation has to be read on the signed value or the i32 corner
        // becomes an i64.
        match (u.operand) {
          ast.ExprNumber(un) => {
            if (!un.is_float && un.suffix.len() == 0 && un.text == "2147483648") {
              return true;
            }
          },
          _ => {}
        }
        return unsettled_int_literal(u.operand);
      }
      return false;
    },
    ast.ExprBinary(b) => {
      if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
        return unsettled_int_literal(b.left) && unsettled_int_literal(b.right);
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// int_literal_tree: is `e` written out of nothing but unsuffixed integer
// literals — the tree native's settleInt stamps a destination type onto? Unlike
// unsettled_int_literal above it does not stop at a magnitude past i32-max:
// native settles that literal at the destination or the other operand's type
// too and lets the RANGE rule below object, which is how a wide literal beside
// an operand already committed to i32 becomes E047 rather than an i64 the whole
// expression silently widens to (#8722). The two predicates answer different
// questions — this one "does a destination name this tree's type", the other
// "does this tree have an i32 reading of its own" — so a width DEFAULT (the
// type a binary yields, the arm of a comparison) still reads the magnitude.
function int_literal_tree(e: ast.Expr): boolean {
  return parser.int_literal_tree(e);
}

// numeric_literal_kind: 1 for a tree of unsuffixed integer literals, 2 for one
// of unsuffixed float literals, 0 for anything else.
function numeric_literal_kind(e: ast.Expr): i32 {
  if (int_literal_tree(e)) {
    return 1;
  }
  if (float_literal_tree(e)) {
    return 2;
  }
  return 0;
}

// float_literal_tree: is `e` built from unsuffixed float literals only?
function float_literal_tree(e: ast.Expr): boolean {
  return parser.float_literal_tree(e);
}

// literal_gives_way: does a literal of numeric_literal_kind `kind` take the
// concrete type `t` of a sibling, as native's unifyIfArms settles it?
function literal_gives_way(kind: i32, t: typeinfo.Type): boolean {
  if (kind == 1) {
    return is_integer(t) || is_float(t);
  }
  if (kind == 2) {
    return is_float(t);
  }
  return false;
}

// int_operand_op: does a binary `op` hand its own integer type down to both
// operands? Arithmetic, bitwise, shift and SATURATING operators do — including
// the shift COUNT, which native judges against the same type as the value — so
// a literal under one is read at the destination's type and range-checked
// there. The set is native's settleInt Binary case, entry for entry.
//
// Comparison and logical operators are absent because their operands carry a
// type of their own, and the CHECKED forms because they yield an Option, which
// never reaches an integer destination — native answers those with E003 on the
// Option, not a range error.
function int_operand_op(op: string): boolean {
  if (op == "+" || op == "-" || op == "*" || op == "/" || op == "%") {
    return true;
  }
  if (op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>") {
    return true;
  }
  return op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}

// const_refused_op: the operators native's constfold leaves out of its integer
// switch, so folding one is an error there rather than a value. Its message is
// uncoded, like the rest of the const grammar.
function const_refused_op(op: string): boolean {
  if (op == "+|" || op == "-|" || op == "*|" || op == "<<|") {
    return true;
  }
  if (op == "+?" || op == "-?" || op == "*?") {
    return true;
  }
  if (op == "/?" || op == "%?") {
    return true;
  }
  return op == "<<?" || op == ">>?";
}

// int_range_diags: E047 for every literal in `e` that the type it is READ at
// cannot hold. Native settles a polymorphic literal to the type its context
// names and then range-checks it (settleInt -> checkLiteralFits); the self-host
// has no settling pass, so the same question is asked at each destination —
// an annotated `let` / assignment target, the type an operand already committed
// to, or the i64 an unannotated binding defaults to. `negated` carries the sign
// down a `-` chain, since a literal holds only its magnitude and i32 MIN
// reaches one further down than up.
function int_range_diags(e: ast.Expr, ty: string, negated: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float || parser.is_quoted_literal(n) || n.suffix.len() > 0 || parser.is_unit_literal(n)) {
        return out;
      }
      if (int_lit_fits(n.text, ty, negated)) {
        return out;
      }
      let msg: string = "literal " + int_lit_as_written(numeral_spelling(n), negated) + " does not fit in " + ty;
      if (negated && is_unsigned_int_ty(ty)) {
        msg = msg + ": unsigned types have no negative values";
      }
      return out.append(dg_at("E047", msg, n.line, n.col));
    },
    ast.ExprUnary(u) => {
      if (u.op == "-") {
        return int_range_diags(u.operand, ty, !negated);
      }
      if (u.op == "+") {
        return int_range_diags(u.operand, ty, negated);
      }
      return out;
    },
    ast.ExprBinary(b) => {
      if (int_operand_op(b.op)) {
        out = util.append_diags(int_range_diags(b.left, ty, false), int_range_diags(b.right, ty, false));
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

// int_dest_range_diags: int_range_diags driven by a destination TYPE rather
// than a type name, recursing into a composite destination the way settles_to
// does so an annotated `let xs: i32[] = [big]` judges its elements.
function int_dest_range_diags(e: ast.Expr, want: typeinfo.Type): util.Diag[] {
  let out: util.Diag[] = [];
  if let ast.ExprUnary(tu) = e {
    if let ast.ExprCall(tc) = tu.operand {
      if (tu.op == "try_" && ctor_variant_name(tc) == "Some" && tc.args.len() == 1) {
        return int_dest_range_diags(tc.args[0], want);
      }
    }
  }
  match (want) {
    typeinfo.TypeI32(wi) => {
      if (wi.is_char || !int_literal_tree(e)) {
        return out;
      }
      return int_range_diags(e, int_label(wi), false);
    },
    typeinfo.TypeArray(wa) => {
      match (e) {
        ast.ExprArray(arr) => {
          for element in arr.elements {
            out = util.append_diags(out, int_dest_range_diags(element, wa.elem));
          }
          return out;
        },
        _ => {
          return out;
        }
      }
    },
    typeinfo.TypeTuple(wt) => {
      match (e) {
        ast.ExprTuple(tl) => {
          if (tl.elements.len() != wt.elements.len()) {
            return out;
          }
          let i: i32 = 0;
          while (i < wt.elements.len()) {
            out = util.append_diags(out, int_dest_range_diags(tl.elements[i], wt.elements[i]));
            i = i + 1;
          }
          return out;
        },
        _ => {
          return out;
        }
      }
    },
    _ => {
      return out;
    }
  }
  return out;
}

// settles_to: would `e` reach type `want` once its unsettled integer literals
// are read at the destination's type (#6654)? The self-host types every numeric
// literal i32 and has no counterpart to native's settleNumeric, which stamps the
// destination type onto a polymorphic literal BEFORE the assignability compare —
// so `let x: f64 = 1;` was an over-reject in seven positions where native is
// silent. There is no mutable AST to stamp here, so the same question is asked
// as a predicate at each destination instead.
//
// Composite destinations recurse element-wise, mirroring settleNumeric's
// ArrayType and TupleType arms: an element already assignable on its own needs
// no settling, which is what lets `let t: (f64, i32) = (1, 2);` through while
// still rejecting a genuinely wrong element.
function settles_to(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  // A value-position `if` / `match` settles where every arm's value does.
  if let ast.ExprCall(vc) = e {
    if (parser.is_value_block(vc)) {
      let body: ast.Stmt[] = parser.vb_body(vc);
      if (vb_numeric_recovery(body, want, s)) {
        return true;
      }
      return vb_settles(body, want, s);
    }
  }
  // `Some(lit)?` yields the payload, so it settles where the payload does.
  if let ast.ExprUnary(tu) = e {
    if (tu.op == "try_") {
      if let ast.ExprCall(tc) = tu.operand {
        if (ctor_variant_name(tc) == "Some" && tc.args.len() == 1 && !ctor_name_taken(tc, s)) {
          return settles_to(tc.args[0], want, s);
        }
      }
      return false;
    }
  }
  if (dest_bound_result(e, s)) {
    return true;
  }
  // A generic function named as a value settles to the function type
  // expected of it when that type binds every one of its type parameters;
  // monomorph instantiates it there.
  if let typeinfo.TypeFunc(wf) = want {
    if (generic_fn_value_arg(e, s)) {
      return fn_value_settles(e, wf, s);
    }
  }
  match (want) {
    typeinfo.TypeMap(wm) => {
      return mlit_is_desugared(e) && mlit_entries_settle(e, wm, s);
    },
    typeinfo.TypeFloat(_) => {
      return unsettled_int_literal(e) || is_poly_float(check_expr(e, s));
    },
    typeinfo.TypeI32(wi) => {
      // An unsuffixed literal is read at the destination's width, so
      // `let n: i64 = 5;` is not an i32-into-i64 assignment. `char` is
      // excluded: it needs a character literal, not a number (#5629).
      if (wi.is_char) {
        return false;
      }
      // A wide literal settles here too: native reads it at the destination's
      // type and lets the RANGE rule (E047) object if it does not fit, rather
      // than reporting an assignment mismatch as well.
      return int_literal_tree(e);
    },
    typeinfo.TypeArray(wa) => {
      return array_literal_settles(e, wa.elem, s);
    },
    typeinfo.TypeTuple(wt) => {
      return tuple_literal_settles(e, wt.elements, s);
    },
    typeinfo.TypeUnion(_) => {
      return ctor_boxes_into(e, want, s) || ctor_payload_settles(e, want, s);
    },
    typeinfo.TypeStruct(ws) => {
      return struct_lit_settles(e, ws, s);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function array_literal_settles(e: ast.Expr, elem: typeinfo.Type, s: Scope): boolean {
  match (e) {
    ast.ExprArray(arr) => {
      // Each element is a coercion site. A failed dyn coercion is E034.
      if (is_dyn_slot(elem)) {
        return true;
      }
      for element in arr.elements {
        if (!array_element_settles(element, elem, s)) {
          return false;
        }
      }
      return true;
    },
    ast.ExprBytes(_) => {
      return type_eq(elem, t_u8());
    },
    _ => {
      return false;
    }
  }
}

function tuple_literal_settles(e: ast.Expr, elements: typeinfo.Type[], s: Scope): boolean {
  if let ast.ExprTuple(tl) = e {
    if (tl.elements.len() != elements.len()) {
      return false;
    }
    let i: i32 = 0;
    while (i < elements.len()) {
      if (!settles_or_nested(tl.elements[i], elements[i], s)) {
        return false;
      }
      i = i + 1;
    }
    return true;
  }
  return false;
}

// A value block producing a tuple has already joined its elements. An
// enclosing array cannot settle those components again at another width.
function array_element_settles(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if let typeinfo.TypeTuple(_) = want {
    if let ast.ExprCall(c) = e {
      if (parser.is_value_block(c)) {
        return nested_assignable(check_expr(e, s), want, s.unions.unions);
      }
    }
  }
  return settles_or_assignable(e, want, s);
}

// ctor_boxes_into: a variant construction is a coercion site, so its payload
// may box into a `dyn` argument of the destination enum. ctor_payload_diags
// judges that payload's conformance; every other argument must still agree.
function ctor_boxes_into(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    let vname: string = ctor_variant_name(c);
    if (union_of_variant(vname, s.unions).len() == 0 && parser.builtin_enum_of(vname).len() == 0) {
      return false;
    }
    let got: typeinfo.Type = check_expr(e, s);
    if (!same_nominal(got, want)) {
      return false;
    }
    let ga: typeinfo.Type[] = nominal_args(got);
    let wa: typeinfo.Type[] = nominal_args(want);
    if (ga.len() != wa.len()) {
      return false;
    }
    let boxed: boolean = false;
    let i: i32 = 0;
    while (i < ga.len()) {
      if (is_dyn_slot(wa[i]) && !is_unknown(ga[i]) && !is_dyn_slot(ga[i])) {
        boxed = true;
      } else if (!is_unknown(ga[i]) && !is_unknown(wa[i]) && !nested_assignable(ga[i], wa[i], s.unions.unions)) {
        return false;
      }
      i = i + 1;
    }
    return boxed;
  }
  return false;
}

// Once an incompatible arm has E031, native retains the prefix's literal
// class. It can settle at a numeric destination without inventing an E003.
function vb_numeric_recovery(body: ast.Stmt[], want: typeinfo.Type, s: Scope): boolean {
  if (!is_integer(want) && !is_float(want)) {
    return false;
  }
  let arms: ast.Expr[] = mx_body_result_exprs(body);
  let types: typeinfo.Type[] = [];
  for arm in arms {
    types = types.append(check_expr(arm, s));
  }
  let fold: MxFold = vb_arms_fold(types, arms, s);
  return !fold.ok && arm_unsettled(fold.acc) && settles_to(fold.acc.e, want, s);
}

// vb_settles: the arms of a value block, each judged as its own value against
// the destination, walked the way vb_ret_diags walks them.
function vb_settles(body: ast.Stmt[], want: typeinfo.Type, s: Scope): boolean {
  if (body.len() == 0) {
    return false;
  }
  let cur: Scope = s;
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    cur = bind_stmt(body[i], cur);
    i = i + 1;
  }
  match (body[i]) {
    ast.StmtReturn(r) => {
      return settles_or_assignable(r.value, want, cur);
    },
    ast.StmtIf(f) => {
      return vb_settles(f.then_body, want, cur) && vb_settles(f.else_body, want, cur);
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        if (!vb_settles(arm.body, want, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)))) {
          return false;
        }
      }
      return m.arms.len() > 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// ctor_payload_settles: `Some(5)` is an Option[i64] where one is wanted, its
// literal payload read at the destination's payload type as a bare literal is.
function ctor_payload_settles(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    if (c.args.len() == 0 || !constructor_destination(c, want, s)) {
      return false;
    }
    let wa: typeinfo.Type[] = nominal_args(want);
    let at: i32 = builtin_payload_index(ctor_variant_name(c), want);
    if (at < 0) {
      return declared_payloads_settle(c, want, s);
    }
    if (c.args.len() != 1 || at >= wa.len()) {
      return false;
    }
    return settles_to(c.args[0], wa[at], s) || result_payload_widens(c.args[0], wa[at], want, s);
  }
  return false;
}

// A direct Result construction widens a same-signed integer payload at the
// destination. This is a constructor conversion, not covariance of an already
// constructed enum, and Option retains its stricter rule.
function result_payload_widens(payload: ast.Expr, slot: typeinfo.Type, want: typeinfo.Type, s: Scope): boolean {
  if let typeinfo.TypeUnion(u) = want {
    if (u.name == "Result") {
      if let typeinfo.TypeI32(from) = check_expr(payload, s) {
        if let typeinfo.TypeI32(to) = slot {
          return !from.is_char && !to.is_char && from.unsigned == to.unsigned
            && from.width > 0 && from.width < to.width;
        }
      }
    }
  }
  return false;
}

// A declared generic enum's construction settles where each payload does at
// the destination's instance of its field, as a builtin's does: `Full(1)` is a
// Bx[f64] where one is wanted.
function declared_payloads_settle(c: ast.ExprCall, want: typeinfo.Type, s: Scope): boolean {
  let vname: string = ctor_variant_name(c);
  let i: i32 = 0;
  while (i < c.args.len()) {
    let field: typeinfo.Type = generic_variant_payload_type(s, vname, want, i);
    if (is_unknown(field) || !settles_or_assignable(c.args[i], field, s)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// Only a constructor can convert its payload at an enum destination. A
// same-named method or qualified function returns an already constructed
// value, and a different enum keeps its own nominal identity.
function constructor_destination(c: ast.ExprCall, want: typeinfo.Type, s: Scope): boolean {
  if (ctor_name_taken(c, s) || !same_nominal(check_expr(c, s), want)) {
    return false;
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (qual_variant_union(fa, s).len() == 0) {
      return false;
    }
    if let ast.ExprIdent(ns) = fa.obj {
      if (s.has_sig(ns.name + "." + fa.field)) {
        return false;
      }
    }
  }
  return true;
}

// Which of an Option's or Result's arguments a builtin variant's payload is.
function builtin_payload_index(variant: string, want: typeinfo.Type): i32 {
  if let typeinfo.TypeUnion(u) = want {
    if (u.name == "Option" && variant == "Some") {
      return 0;
    }
    if (u.name == "Result" && variant == "Ok") {
      return 0;
    }
    if (u.name == "Result" && variant == "Err") {
      return 1;
    }
  }
  return 0 - 1;
}

// struct_lit_settles: a generic struct literal is read at its destination's
// arguments, so `Box { v: 1 }` is a Box[i64] where one is wanted. Its fields
// are judged under those arguments by dest_call_diags, as E043.
function struct_lit_settles(e: ast.Expr, want: typeinfo.TypeStruct, s: Scope): boolean {
  if (want.args.len() == 0) {
    return false;
  }
  if let ast.ExprStructLit(sl) = e {
    if (sl.has_base || sl.type_name != want.name) {
      return false;
    }
    return s.lookup_struct(sl.type_name).type_params.len() == want.args.len();
  }
  return false;
}

// settles_or_assignable: one element of a composite destination — either it
// settles, or it already types to something the slot accepts. An ARRAY
// literal's elements only: native coerces into a `dyn` slot there.
function settles_or_assignable(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if (settles_to(e, want, s)) {
    return true;
  }
  let t: typeinfo.Type = check_expr(e, s);
  return is_unknown(t) || type_assignable(t, want, s.unions.unions);
}

// settles_or_nested: the same for a TUPLE literal's elements, which are not a
// coercion site. Native refuses a concrete in a `dyn` tuple slot even when it
// conforms — boxing is a representation change, and a tuple is not where one
// happens — so this asks nested_assignable rather than type_assignable.
function settles_or_nested(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if (settles_to(e, want, s)) {
    return true;
  }
  let t: typeinfo.Type = check_expr(e, s);
  return is_unknown(t) || nested_assignable(t, want, s.unions.unions);
}

// variant_ctor_diags checks a variant-constructor call's ARGUMENTS against the
// variant's declared payloads — arity, then each payload's type (E036, #6650).
// check_call_expr types such a call to its enum and returns before the
// per-argument loop it runs for an ordinary function, and no other pass looked
// at the arguments, so `Wrap("x")` for `enum W { Wrap(i32) }` was accepted.
//
// Only an enum variant with a `__ev` payload marker is checked.
// A builtin `Ok` / `Some` / `Err` has no backing StructSig, and a variant
// without `__ev` is either payload-less (`Nil`) or a struct-union member
// (`type U = A | B`) — indistinguishable here, which is why
// variant_payload_count returns -1 for both and this skips them.
// It takes the variant NAME rather than the callee node because both spellings
// reach it: the bare `Wrap(1)` and the qualified `W.Wrap(1)` (#6657), whose
// callee is an ExprFieldAccess. The qualified spelling arrives qualified, so
// the payload type resolves through the owning enum — everything else here is
// keyed by, and worded with, the bare name.
function variant_ctor_diags(qname: string, c: ast.ExprCall, s: Scope): util.Diag[] {
  let vname: string = variant_pattern_name(qname);
  let out: util.Diag[] = [];
  // An injected enum (IoError, Body) has no union declaration; its
  // variants are known by their owner in the struct table.
  if (union_of_variant(vname, s.unions).len() == 0 && find_variant_sig(s.structs, qname).enum_owner.len() == 0) {
    return out;
  }
  if (dot_index(qname) < 0 && s.variant_ambiguous(vname)) {
    return out;
  }
  let want: i32 = variant_payload_count(qname, s.structs);
  if (want < 0) {
    return out;
  }
  if (c.args.len() != want) {
    out = out.append(dg_at("E036", util.arity_message("variant " + shown_variant(s, qname), want, c.args.len(), "argument"), c.line, c.col));
  }
  // Callable payloads can contain the enum's type variables too. Compare
  // their instantiated contracts, just as a match reads their payloads.
  let whole: typeinfo.Type = variant_ctor_type(s, variant_payload_struct(s, qname).enum_owner, qname, c);
  let i: i32 = 0;
  while (i < c.args.len() && i < want) {
    let at: typeinfo.Type = check_expr(c.args[i], s);
    let pt: typeinfo.Type = variant_pattern_payload_type(s, qname, whole, i);
    out = util.append_diags(out, int_dest_range_diags(c.args[i], pt));
    if (!is_unknown(at) && !is_unknown(pt) && !settles_to(c.args[i], pt, s) && !coercible(at, pt, s)) {
      out = out.append(dg_at("E036", "variant " + shown_variant(s, qname) + " payload " + util.i32_to_string(i) + " type " + type_label(at) + ", expected " + type_label(pt), expr_line(c.args[i]), expr_col(c.args[i])));
    }
    i = i + 1;
  }
  return out;
}

// qual_enum_name: `obj` is the qualifier of an `Enum.Variant` reference — a bare
// name resolving to a declared enum/union or to a builtin (Option / Result / …)
// — and returns that enum's name, or "" when it is an ordinary value. A local
// binding of the same name shadows the enum, so the reference is then a genuine
// field access. Module-qualified names never reach here: modload mangles them to
// bare names before checking.
function qual_enum_name(obj: ast.Expr, s: Scope): string {
  match (obj) {
    ast.ExprIdent(oid) => {
      if (s.known(oid.name)) {
        return "";
      }
      if (s.lookup_union(oid.name).name.len() > 0) {
        return oid.name;
      }
      if (parser.is_reserved_enum_name(oid.name)) {
        return oid.name;
      }
      return "";
    },
    _ => {
      return "";
    }
  }
  return "";
}

// qual_variant_exists: does `en` declare a variant named `field`? Separate from
// qual_enum_name so a caller can tell "not a qualified reference at all" from
// "qualified, but that enum has no such variant" — the latter is E036.
function qual_variant_exists(en: string, field: string, s: Scope): boolean {
  let ou: UnionSig = s.lookup_union(en);
  if (ou.name.len() > 0) {
    return util.has_str(ou.variants, field);
  }
  return parser.builtin_enum_of(field) == en;
}

// qual_variant_union names the enum a qualified variant reference `Enum.Variant`
// belongs to, or "" when `fa` is not one. Both spellings ask this ONE rule: the
// CONSTRUCTOR form (`W.Wrap(1)`) learned it in #6657 and the VALUE form
// (`Color.Red`) did not, so a unit variant written qualified typed unknown —
// which left the typed-IR stamp empty on every expression built from it
// (`[Color.Red, Color.Green][1]`) and took the lowering off the IR path (#5531).
//
// The WRITTEN enum is the answer, and deliberately not `union_of_variant`: two
// enums may declare the same variant name (`enum A { Zed, … }` /
// `enum B { …, Zed }`), and that scan returns the first union declaring it —
// a real-but-wrong owner, which is the resolution bug the conformance case
// `shared_variant_name` exists for one layer down. There is nothing to recover
// by scanning anyway: `qual_enum_name` only answers for a name `lookup_union`
// matched exactly (or a reserved builtin enum), and `qual_variant_exists` has
// already confirmed that enum declares this variant.
function qual_variant_union(fa: ast.ExprFieldAccess, s: Scope): string {
  let en: string = qual_enum_name(fa.obj, s);
  if (en.len() == 0 || !qual_variant_exists(en, fa.field, s)) {
    return "";
  }
  return en;
}

// AssocHit is an associated-call resolution: whether `Type.f(…)` names a
// receiver-less function at all, and — when the trait requirement that
// provides it is in scope — that requirement's declared return-type
// spelling, still written in `Self`. An empty `ret` means "resolved, but the
// return type is not recoverable here" and types to unknown. `owner` is the
// trait that declared the requirement (empty for an inherent impl), which the
// E021 "called as a method" message names. `params` are the requirement's
// parameter spellings, also in `Self`, read only when `owner` is set.
struct AssocHit { found: boolean, ret: string, owner: string, params: string[], is_const: boolean }

function assoc_miss(): AssocHit {
  return AssocHit { found: false, ret: "", owner: "", params: [], is_const: false };
}

// trait_req_idx resolves a bound's trait SPELLING to its requirement record.
// TraitReq stores the simple name (parse_trait_decl runs derive_simple_name),
// while a bound may be written module-qualified (`T: num.Zero`) — try the
// spelling first, then its simple name.
function trait_req_idx(tr: string, reqs: parser.TraitReq[]): i32 {
  let exact: i32 = derive_trait_idx(util.base_type_name(tr), reqs);
  if (exact >= 0) {
    return exact;
  }
  let i: i32 = e021_trait_idx(tr, reqs);
  if (i >= 0) {
    return i;
  }
  let simple: string = parser.derive_simple_name(tr);
  if (simple == tr) {
    return 0 - 1;
  }
  return e021_trait_idx(simple, reqs);
}

// bounds_in_module spells each bare trait of a `+`-joined bound by `module`, the
// bundle prefix of the module that wrote it, as flatten spells a derive: a bare
// `Ord` in core/cmp is `cmp.Ord`, whatever the program itself declares.
function bounds_in_module(b: string, module: string): string {
  if (module.len() == 0 || parser.is_const_bound(b)) {
    return b;
  }
  let out: string = "";
  for part in parser.split_plus_bounds(b) {
    if (out.len() > 0) {
      out = out + " + ";
    }
    if (util.index_of_sub(util.base_type_name(part), ".") < 0) {
      out = out + module + "." + part;
    } else {
      out = out + part;
    }
  }
  return out;
}

// trait_assoc_req resolves trait `tr`'s ASSOCIATED (receiver-less) function,
// abstract or defaulted. A method whose first parameter is `self` is a
// receiver method and does not answer a `Type.f()` call. Supertraits are
// followed, so `T: Num` reaches `Zero.zero` when `trait Num: Zero`. Track
// the current path to terminate cycles without rejecting deep valid chains.
function trait_assoc_req(reqs: parser.TraitReq[], tr: string, field: string, seen: string[]): AssocHit {
  let idx: i32 = trait_req_idx(tr, reqs);
  if (idx < 0) {
    return assoc_miss();
  }
  let req: parser.TraitReq = reqs[idx];
  if (util.has_str(seen, req.trait_name)) {
    return assoc_miss();
  }
  let path: string[] = seen.append(req.trait_name);
  for rs in req.assoc_sigs {
    if (rs.name == field) {
      // The parser already limits assoc_sigs to receiverless functions.
      let params: string[] = [];
      for p in rs.params {
        params = params.append(parser.fn_tag_spelling(p.type_name, p.fn_ret, p.fn_param_types));
      }
      return AssocHit { found: true, ret: rs.ret_type, owner: req.trait_name, params: params, is_const: rs.is_const };
    }
  }
  for supertrait in req.supertraits {
    let sh: AssocHit = trait_assoc_req(reqs, supertrait, field, path);
    if (sh.found) {
      return sh;
    }
  }
  return assoc_miss();
}

// dyn_method is the method `name` that a trait a `dyn` names declares,
// abstract or defaulted. Only the named traits count, not their supertraits:
// native's vtable has a slot per method of each trait in the set and none for
// an inherited one, so `dyn Derived` cannot call Base's method unless it says
// `dyn Derived + Base`.
function dyn_method(traits: string, name: string, s: Scope): Option[parser.FuncDecl] {
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let idx: i32 = trait_req_idx(util.base_type_name(tr), s.trait_reqs);
    if (idx >= 0) {
      match (trait_req_sig(s.trait_reqs[idx], name)) {
        Some(m) => {
          return Some(m);
        },
        None => {}
      }
    }
  }
  return None;
}

function trait_req_sig(req: parser.TraitReq, name: string): Option[parser.FuncDecl] {
  for m in req.req_sigs {
    if (m.name == name) {
      return Some(m);
    }
  }
  for m in req.default_sigs {
    if (m.name == name) {
      return Some(m);
    }
  }
  return None;
}

// dyn_method_type is the result of calling `name` on a `dyn` value: the
// return type its trait declares for it, read at the trait arguments
// (`dyn Tc[i32]`) and associated-type pins (`dyn P[Item = i32]`) the dyn
// spelling gives. A result still spelling Self has no one type behind a dyn,
// so it stays unknown.
function dyn_method_type(traits: string, name: string, s: Scope): typeinfo.Type {
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let idx: i32 = trait_req_idx(util.base_type_name(tr), s.trait_reqs);
    if (idx >= 0) {
      match (trait_req_sig(s.trait_reqs[idx], name)) {
        Some(m) => {
          let ret: string = dyn_ret_at_spelling(m.ret_type, tr, s.trait_reqs[idx].type_params);
          if (ret.len() == 0 || parser.subst_self(ret, "__dyn") != ret) {
            return t_unknown("dyn method result spells Self");
          }
          return s.resolve_type(ret);
        },
        None => {}
      }
    }
  }
  return t_unknown("no method `" + name + "` on `dyn " + traits + "`");
}

// dyn_param_type is parameter `k` of the method `name` a `dyn` value
// dispatches to, read at the dyn spelling as dyn_method_type reads its result.
function dyn_param_type(traits: string, name: string, k: i32, s: Scope): typeinfo.Type {
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let idx: i32 = trait_req_idx(util.base_type_name(tr), s.trait_reqs);
    if (idx >= 0) {
      match (trait_req_sig(s.trait_reqs[idx], name)) {
        Some(m) => {
          if (k >= m.params.len()) {
            return t_unknown("no such parameter");
          }
          let p: ast.ParamDecl = m.params[k];
          let pt: string = dyn_ret_at_spelling(parser.fn_tag_spelling(p.type_name, p.fn_ret, p.fn_param_types), tr, s.trait_reqs[idx].type_params);
          if (pt.len() == 0 || parser.subst_self(pt, "__dyn") != pt) {
            return t_unknown("dyn method parameter spells Self");
          }
          return s.resolve_type(pt);
        },
        None => {}
      }
    }
  }
  return t_unknown("no method `" + name + "` on `dyn " + traits + "`");
}

// dyn_ret_at_spelling reads a trait method's declared result at one trait of
// a dyn spelling: its positional arguments replace the trait's type
// parameters in order, and each `Name = T` pin replaces `Self::Name`.
function dyn_ret_at_spelling(ret: string, spelling: string, tparams: string[]): string {
  let open: i32 = e021_bracket_open(spelling);
  if (open < 0) {
    return ret;
  }
  let args: string[] = [];
  let out: string = ret;
  for raw in parser.split_top_commas(slice_unchecked(spelling, open + 1, spelling.len() - 1) + "") {
    let entry: string = util.trim(raw);
    let eq: i32 = pin_eq(entry);
    if (eq > 0) {
      out = subst_self_proj(out, util.trim(slice_unchecked(entry, 0, eq) + ""), util.trim(slice_unchecked(entry, eq + 1, entry.len()) + ""));
    } else {
      args = args.append(entry);
    }
  }
  if (args.len() == tparams.len()) {
    out = parser.subst_ty(out, tparams, args);
  }
  return out;
}

// pin_eq is the index of the `=` that makes a dyn bracket entry a pin
// (`Item = i32`), or -1 for a positional argument, whose own `=>` (a
// function type) is not one.
function pin_eq(entry: string): i32 {
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i < entry.len()) {
    let c: u8 = entry[i];
    if (c == b'(' || c == b'[') {
      depth = depth + 1;
    } else if (c == b')' || c == b']') {
      depth = depth - 1;
    } else if (c == b'=' && depth == 0 && !(i + 1 < entry.len() && entry[i + 1] == b'>')) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// subst_self_proj replaces each `Self::<name>` in t with val.
function subst_self_proj(t: string, name: string, val: string): string {
  let pat: string = "Self::" + name;
  let out: string = "";
  let i: i32 = 0;
  while (i < t.len()) {
    let end: i32 = i + pat.len();
    if (end <= t.len() && slice_unchecked(t, i, end) == pat && (end == t.len() || !parser.ident_byte(t[end] as i32)) && (i == 0 || !parser.ident_byte(t[i - 1] as i32))) {
      out = out + val;
      i = end;
    } else {
      out = out + slice_unchecked(t, i, i + 1);
      i = i + 1;
    }
  }
  return out;
}

// dyn_call_diags is a method call on a `dyn` value: E021 for a method none of
// its traits declares, E004 for the wrong number of arguments. An associated
// function has no receiver to dispatch on; its own E021 is reported elsewhere.
function dyn_call_diags(c: ast.ExprCall, mfa: ast.ExprFieldAccess, traits: string, s: Scope): util.Diag[] {
  match (dyn_method(traits, mfa.field, s)) {
    Some(m) => {
      if (m.params.len() == 0 || m.params[0].name != "self") {
        return [];
      }
      let want: i32 = m.params.len() - 1;
      if (c.args.len() != want) {
        return [dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", want, c.args.len(), "argument"), c.line, c.col)];
      }
      let out: util.Diag[] = [];
      let k: i32 = 0;
      while (k < c.args.len()) {
        let pt: typeinfo.Type = dyn_param_type(traits, mfa.field, k + 1, s);
        if (!is_unknown(pt) && !settles_or_assignable(c.args[k], pt, s)) {
          out = out.append(dg_at("E038", "argument " + util.i32_to_string(k + 1) + " to \"" + mfa.field + "\": expected " + type_label(pt) + ", got " + type_label(check_expr(c.args[k], s)), expr_line(c.args[k]), expr_col(c.args[k])));
        }
        k = k + 1;
      }
      return out;
    },
    None => {}
  }
  return [dg_at("E021", "no method \"" + mfa.field + "\" on `dyn " + traits + "`", mfa.line, mfa.col)];
}

// tp_assoc_req resolves `T.field(…)` against type parameter `T`'s declared
// bounds: a hit when one of the `+`-joined bound traits requires `field` as
// an associated function. Mirrors the gate on native checker.go's generic
// associated-dispatch arm (resolveTraitMethodForParam + `tm.Assoc`), so
// `T.nope()` — no bound providing it — stays the E001 native reports.
function tp_assoc_req(s: Scope, tname: string, field: string): AssocHit {
  for tr in tp_bound_traits(s, tname) {
    let h: AssocHit = trait_assoc_req(s.trait_reqs, tr, field, []);
    if (h.found) {
      return h;
    }
  }
  return assoc_miss();
}

// tp_bound_traits lists the traits bounding type parameter `tname` in scope:
// the `+`-joined spelling split into names, empty for an unbounded or unknown
// parameter. A bound carries its type arguments as written (`Iterator[T]`);
// what names the trait is the base, so each entry is stripped to it.
function tp_bound_traits(s: Scope, tname: string): string[] {
  let out: string[] = [];
  let k: i32 = util.index_of_str(s.tparams, tname);
  if (k < 0 || k >= s.tbounds.len()) {
    return out;
  }
  for entry in parser.split_plus_bounds(s.tbounds[k]) {
    out = out.append(util.base_type_name(entry));
  }
  return out;
}

// tp_bound_provides reports whether some bound on type parameter `tname` — or
// a supertrait of one — declares `field`, abstract, defaulted or associated.
// A bound naming a trait this module cannot see counts as providing it: the
// rule refuses only what the declarations in hand rule out.
function tp_bound_provides(s: Scope, tname: string, field: string): boolean {
  for tr in tp_bound_traits(s, tname) {
    if (trait_provides(s.trait_reqs, tr, field, [])) {
      return true;
    }
  }
  return false;
}

// A generic body knows a bound method's signature before any concrete
// instance exists. Preserve the trait arguments and substitute Self with
// the receiver parameter, then use ordinary method typing and diagnostics.
function bound_method(s: Scope, tname: string, field: string): Option[MethodSig] {
  let k: i32 = util.index_of_str(s.tparams, tname);
  if (tname.len() == 0 || k < 0 || k >= s.tbounds.len()) {
    return None;
  }
  for bound in parser.split_plus_bounds(s.tbounds[k]) {
    match (trait_bound_method(s, bound, tname, field, [])) {
      Some(sig) => {
        return Some(sig);
      },
      None => {}
    }
  }
  return None;
}

function trait_bound_method(s: Scope, bound: string, self: string, field: string, seen: string[]): Option[MethodSig] {
  let ref: parser.TypeRef = parser.parse_type_ref(bound);
  let idx: i32 = trait_req_idx(ref.base, s.trait_reqs);
  if (idx < 0) {
    return None;
  }
  let req: parser.TraitReq = s.trait_reqs[idx];
  let key: string = req.module + "." + req.trait_name;
  if (util.has_str(seen, key)) {
    return None;
  }
  let args: string[] = [];
  for arg in ref.args {
    args = args.append(parser.render_type_ref(arg));
  }
  for m in util.append_all(req.req_sigs, req.default_sigs) {
    if (m.name == field && m.params.len() > 0 && m.params[0].name == "self") {
      let pts: typeinfo.Type[] = [];
      let ptn: string[] = [];
      // The body's own parameters are rigid; the method's are the call's to
      // infer.
      let tps: string[] = util.append_all(s.tparams, m.all_type_params);
      let subst: typeinfo.Type[] = util.append_all(rigid_tparams(s.tparams), erased_tparams(m.all_type_params));
      let i: i32 = 1;
      while (i < m.params.len()) {
        let p: ast.ParamDecl = m.params[i];
        let spelling: string = parser.subst_ty(parser.subst_self(parser.fn_tag_spelling(p.type_name, p.fn_ret, p.fn_param_types), self), req.type_params, args);
        ptn = ptn.append(spelling);
        pts = pts.append(type_from_name_subst(spelling, tps, subst, s.type_names()));
        i = i + 1;
      }
      let rt: string = parser.subst_ty(parser.subst_self(parser.fn_tag_spelling(m.ret_type, m.ret_fn_ret, m.ret_fn_param_types), self), req.type_params, args);
      return Some(MethodSig { name: m.name, receiver_type: self, param_types: pts, ret_type: type_from_name_subst(rt, tps, subst, s.type_names()), ret_type_name: rt, param_type_names: ptn, all_type_params: m.all_type_params, type_params: m.type_params, type_bounds: m.bound_traits, module: m.module, impl_trait: req.trait_name, line: m.line, col: m.col, file: decl_file_label(m) });
    }
  }
  for parent in req.supertraits {
    match (trait_bound_method(s, parser.subst_ty(parent, req.type_params, args), self, field, seen.append(key))) {
      Some(sig) => {
        return Some(sig);
      },
      None => {}
    }
  }
  return None;
}

function trait_provides(reqs: parser.TraitReq[], tr: string, field: string, seen: string[]): boolean {
  let idx: i32 = trait_req_idx(tr, reqs);
  if (idx < 0) {
    return true;
  }
  let req: parser.TraitReq = reqs[idx];
  if (util.has_str(seen, req.trait_name)) {
    return false;
  }
  if (util.has_str(req.provided, field)) {
    return true;
  }
  let path: string[] = seen.append(req.trait_name);
  for supertrait in req.supertraits {
    if (trait_provides(reqs, supertrait, field, path)) {
      return true;
    }
  }
  return false;
}

// tp_receiver returns the type parameter a method call's RECEIVER is a value
// of, or "" when it is not one: a type variable of the enclosing function.
function tp_receiver(recv: typeinfo.Type, s: Scope): string {
  if let typeinfo.TypeErased(e) = recv {
    if (util.index_of_str(s.tparams, e.name) >= 0) {
      return e.name;
    }
  }
  return "";
}

// type_assoc_req resolves a CONCRETE `i32.zero()` / `Point.origin()` /
// `Box[string].make()`: some `impl … for <tyname>` (by its base name) in the
// module lists `field`, and `field` is not a
// receiver method on that type (parse_impl_decl gives an associated function
// an empty receiver_name, so collect_method_sigs never records it — absence
// from the method table is what makes it associated). A `self`-taking method
// of the same name is `v.f()`, not `Type.f()`, and is left alone. The return
// type comes from the trait requirement when the impl names a declared trait;
// an inherent impl resolves with no return type (unknown).
function type_assoc_req(s: Scope, tyname: string, field: string): AssocHit {
  let base: string = util.base_type_name(tyname);
  for imp in s.impls {
    if (imp.impl_type == base && util.has_str(imp.method_names, field)) {
      if (s.lookup_method(field, base).name.len() == 0) {
        let h: AssocHit = trait_assoc_req(s.trait_reqs, imp.trait_name, field, []);
        if (h.found) {
          return h;
        }
        return AssocHit { found: true, ret: "", owner: "", params: [], is_const: s.lookup_assoc_sig(base, field).is_const };
      }
    }
  }
  return assoc_miss();
}

// assoc_func_impls records the module's ASSOCIATED functions — a FuncDecl
// with no receiver NAME but a receiver TYPE — as impl-table entries, which is
// the record `Type.f()` resolution reads. An inherent `impl` already lands
// there; a `@derive` does not, and its synthesised functions are not trait
// requirements either (`@derive(json.FromJson)` supplies `from_json`, which the
// `Json` trait never declares), so the declaration is the only trace of them.
// Without this `Wrap.default()` and `User.from_json(s)` reported an undefined
// name for their own type (#8461). The blank trait name matches no declared
// trait, so conformance (e021_scope_has_impl) reads exactly what it did.
function assoc_func_impls(impls: parser.ImplInfo[], funcs: parser.FuncDecl[]): parser.ImplInfo[] {
  let out: parser.ImplInfo[] = impls;
  for fd in funcs {
    if (fd.receiver_name.len() == 0 && fd.receiver_type.len() > 0) {
      let noargs: string[] = [];
      out = out.append(parser.ImplInfo { trait_name: "", impl_type: util.base_type_name(fd.receiver_type), type_params: noargs, all_type_params: noargs, bounds: noargs, method_names: [fd.name], trait_spelling: "", trait_ref: "", assoc_names: noargs, assoc_values: noargs, trait_module: "", module: "", line: fd.line, col: fd.col });
    }
  }
  return out;
}

// assoc_call_req resolves the callee `obj.field(…)` as an ASSOCIATED
// (receiver-less) call on a TYPE rather than a method call on a value:
// `T.zero()` through a bounded type parameter, or `i32.zero()` on a concrete
// type. The object is a type qualifier with no value behind it, so walking it
// reports E001 "undefined name" on a call native accepts (#6933). A value
// binding of the same name shadows the type and makes it a genuine method
// call. A `Base.NAME` read (`const_read`) names a declared constant, so the
// instantiation-borne hit below is not for it.
function assoc_call_req(obj: ast.Expr, field: string, s: Scope, const_read: boolean): AssocHit {
  match (obj) {
    ast.ExprIdent(oid) => {
      if (s.known(oid.name)) {
        return assoc_miss();
      }
      let h: AssocHit = tp_assoc_req(s, oid.name, field);
      if (h.found) {
        return h;
      }
      let ht: AssocHit = type_assoc_req(s, oid.name, field);
      if (ht.found) {
        return ht;
      }
      return assoc_miss();
    },
    _ => {
      return assoc_miss();
    }
  }
  return assoc_miss();
}

// tparam_assoc_diag is E001 for `T.field(…)` where no bound on the type
// parameter `T` declares `field`: an associated call goes through a bound,
// never through what an instantiation happens to provide.
function tparam_assoc_diag(tid: ast.ExprIdent, field: string, s: Scope): util.Diag {
  let why: string = tid.name + " has no bound; bound it by a trait that declares " + field + "()";
  let k: i32 = util.index_of_str(s.tparams, tid.name);
  if (k < s.tbounds.len() && s.tbounds[k].len() > 0) {
    why = "its bound " + util.demangle(s.tbounds[k]) + " declares none";
  }
  let d: util.Diag = dg_at("E001", "type parameter " + tid.name + " has no associated function \"" + field + "\": " + why, tid.line, tid.col);
  return util.Diag { ...d, length: util.show_type_vars(tid.name).len() };
}

// assoc_hit_type is assoc_call_req's typing half: the associated call's
// result type, with the requirement's `Self` resolved to the object — the
// type variable for `T.zero()` and the concrete type for `i32.zero()`.
function assoc_hit_type(h: AssocHit, obj: ast.Expr, s: Scope): typeinfo.Type {
  if (h.ret.len() == 0) {
    return t_unknown("associated call: return type not recoverable");
  }
  let self_name: string = "";
  match (obj) {
    ast.ExprIdent(oid) => {
      self_name = oid.name;
    },
    _ => {}
  }
  return s.resolve_type(parser.subst_self(h.ret, self_name));
}

// assoc_base_name is the type a `Base.f` names, or "" when the object is not
// a bare name.
function assoc_base_name(obj: ast.Expr): string {
  if let ast.ExprIdent(oid) = obj {
    return oid.name;
  }
  return "";
}

// assoc_const_read_diags holds a `Base.NAME` read to a constant and a
// `Base.f(…)` call to a function.
function assoc_const_read_diags(h: AssocHit, c: ast.ExprCall, mfa: ast.ExprFieldAccess): util.Diag[] {
  if (mfa.const_read == h.is_const) {
    return [];
  }
  let base: string = util.demangle(assoc_base_name(mfa.obj));
  if (mfa.const_read) {
    return [dg_at("E043", base + "." + mfa.field + " is an associated function, not a constant; call it as " + base + "." + mfa.field + "(...)", c.line, c.col)];
  }
  return [dg_at("E043", base + "." + mfa.field + " is an associated constant; read it as " + base + "." + mfa.field + " without an argument list", c.line, c.col)];
}

// assoc_arg_diags checks an associated call's arguments against the trait
// requirement it resolved to, with `Self` read as the qualifier, or against
// an inherent associated function's own declaration.
function assoc_arg_diags(h: AssocHit, c: ast.ExprCall, mfa: ast.ExprFieldAccess, s: Scope): util.Diag[] {
  let self_name: string = "";
  if let ast.ExprIdent(oid) = mfa.obj {
    self_name = oid.name;
  }
  let pts: typeinfo.Type[] = [];
  if (h.owner.len() > 0) {
    for ps in h.params {
      pts = pts.append(s.resolve_type(parser.subst_self(ps, self_name)));
    }
  } else {
    let asig: FuncSig = s.lookup_assoc_sig(self_name, mfa.field);
    if (asig.name.len() == 0) {
      return [];
    }
    pts = asig.param_types;
  }
  if (c.args.len() != pts.len()) {
    return [dg_at("E004", util.arity_message("associated function \"" + mfa.field + "\"", pts.len(), c.args.len(), "argument"), c.line, c.col)];
  }
  let out: util.Diag[] = [];
  let k: i32 = 0;
  while (k < c.args.len()) {
    if (!is_unknown(pts[k]) && !settles_or_assignable(c.args[k], pts[k], s)) {
      out = out.append(dg_at("E038", "argument " + util.i32_to_string(k + 1) + " to \"" + mfa.field + "\": expected " + type_label(pts[k]) + ", got " + type_label(check_expr(c.args[k], s)), expr_line(c.args[k]), expr_col(c.args[k])));
    }
    k = k + 1;
  }
  return out;
}

// operand_open reports whether an operator's operand type leaves the operator
// unjudged here: an unknown, or a type variable, whose operators
// tvar_operator_diags judges by its bound.
function operand_open(t: typeinfo.Type): boolean {
  if let typeinfo.TypeErased(_) = t {
    return true;
  }
  return is_unknown(t);
}

// lanes_inside reports a lane type nested in `t`: an element of an array or a
// tuple, a map column, a parameter or the result of a function type, or a
// type argument. A lane value is 16 bytes, and no element or field is wider
// than 8.
function lanes_inside(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeArray(a) => {
      return holds_lanes(a.elem);
    },
    typeinfo.TypeTuple(tp) => {
      return any_holds_lanes(tp.elements);
    },
    typeinfo.TypeMap(m) => {
      return holds_lanes(m.key) || holds_lanes(m.value);
    },
    typeinfo.TypeFunc(f) => {
      return any_holds_lanes(f.param_types) || holds_lanes(f.ret_type);
    },
    typeinfo.TypeStruct(st) => {
      return any_holds_lanes(st.args);
    },
    typeinfo.TypeUnion(u) => {
      return any_holds_lanes(u.args);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function holds_lanes(t: typeinfo.Type): boolean {
  return is_lanes(t) || lanes_inside(t);
}

function any_holds_lanes(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (holds_lanes(t)) {
      return true;
    }
  }
  return false;
}

// lanes_inside_diags is E085 for a type that nests a lane type in another.
function lanes_inside_diags(t: typeinfo.Type, line: i32, col: i32): util.Diag[] {
  if (!lanes_inside(t)) {
    return [];
  }
  return [dg_at("E085", util.demangle_all(type_label(t)) + " holds a lane value inside another type; a lane value lives only in a local, a parameter or a result", line, col)];
}

// e085_decl_diags is E085 for the declared types of a module: a parameter, a
// result or a `let` annotation that nests a lane type, and a field or payload
// that holds one.
function e085_decl_diags(mod: parser.Module, focus: util.NameIndex, tn: TypeNames): util.Diag[] {
  let out: util.Diag[] = [];
  for efn in mod.funcs {
    if (in_focus(focus, efn)) {
      for param in efn.params {
        out = util.append_diags(out, lanes_inside_diags(type_from_spelling(e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), tn), efn.line, efn.col));
      }
      out = util.append_diags(out, lanes_inside_diags(type_from_spelling(e064_decl_spelling(efn.ret_type, efn.ret_fn_ret, efn.ret_fn_param_types), tn), efn.line, efn.col));
      for an in collect_annots(efn.body) {
        out = util.append_diags(out, lanes_inside_diags(type_from_spelling(an.type_name, tn), an.line, an.col));
      }
    }
  }
  for esd in mod.structs {
    for field in esd.fields {
      let ft: typeinfo.Type = type_from_spelling(e064_decl_spelling(field.type_name, field.fn_ret, field.fn_param_types), tn);
      if (holds_lanes(ft)) {
        out = out.append(dg_at("E085", "a field or payload of type " + util.demangle_all(type_label(ft)) + " holds a lane value; a lane value lives only in a local, a parameter or a result", esd.line, esd.col));
      }
    }
  }
  return out;
}

function call_diags(e: ast.Expr, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      out = call_diags_call(c, s, out, t_unknown("no destination"));
    },
    ast.ExprBinary(b) => {
      out = call_diags_binary(b, s, out);
    },
    ast.ExprUnary(u) => {
      out = call_diags_unary(u, s, out);
    },
    ast.ExprArray(a) => {
      out = call_diags_array(a, s, out);
      out = util.append_diags(out, lanes_inside_diags(check_expr(e, s), a.line, a.col));
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, call_diags(element, s));
      }
      out = util.append_diags(out, lanes_inside_diags(check_expr(e, s), t.line, t.col));
    },
    ast.ExprIndex(ix) => {
      out = call_diags_index(ix, s, out);
    },
    ast.ExprSlice(s2) => {
      out = call_diags_slice(s2, s, out);
    },
    ast.ExprFieldAccess(fa) => {
      out = call_diags_field_access(fa, s, out);
    },
    ast.ExprStructLit(sl) => {
      out = call_diags_struct_lit(sl, [], s, out);
    },
    ast.ExprLambda(lm) => {
      out = call_diags_lambda(lm, s, out);
    },
    ast.ExprIdent(id) => {
      out = call_diags_ident(id, s, out);
    },
    _ => {}
  }
  return out;
}

// cell_call_diags checks a call of one of Cell[T]'s two builtin methods.
//
// `get` reads the slot and `set` writes it; neither is in the method table or
// the struct table, because Cell is a reserved builtin rather than a declared
// struct, so the ordinary method path resolved nothing and reported nothing
// (#9518). A lambda handed to `set` was accepted in silence.
//
// The arity numbers count the RECEIVER, which is how native models these — as
// plain functions whose first parameter is the cell — so `c.set(v)` is two
// arguments and `c.get()` is one. A wrong value is numbered among the written
// arguments, as every method call's is, so on `set` it is "argument 1".
// payload_count_message is E015's wording for a pattern that binds a different
// number of values than its variant carries, as the native checker words it.
function payload_count_message(variant: string, want: i32, got: i32): string {
  let values: string = "values";
  if (want == 1) {
    values = "value";
  }
  return "variant " + variant + " carries " + util.i32_to_string(want) + " " + values + ", but the pattern binds " + util.i32_to_string(got);
}

// arg_subject names argument n of a call, with its callee when the callee is a
// name the reader wrote, as the native checker's argSubject does.
function arg_subject(c: ast.ExprCall, n: i32): string {
  let arg: string = "argument " + util.i32_to_string(n);
  if let ast.ExprIdent(id) = c.callee {
    if (!util.str_has_prefix(id.name, "__")) {
      return arg + " to \"" + util.demangle(id.name) + "\"";
    }
  }
  return arg;
}

// call_subject names a call's callee the way an arity diagnostic does: a
// function by name when the callee is one, "this function" for any other
// callable expression.
function call_subject(c: ast.ExprCall): string {
  match (c.callee) {
    ast.ExprIdent(id) => {
      return "function \"" + util.demangle(id.name) + "\"";
    },
    _ => {
      return "this function";
    }
  }
}

function cell_call_diags(c: ast.ExprCall, mfa: ast.ExprFieldAccess, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let want: i32 = 0 - 1;
  if (mfa.field == "get") {
    want = 0;
  }
  if (mfa.field == "set") {
    want = 1;
  }
  if (want < 0) {
    return [access_fix(dg_at("E043", "struct Cell has no field or method \"" + mfa.field + "\"", mfa.line, mfa.col), mfa, ["get", "set"])];
  }
  if (c.args.len() != want) {
    return [dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", want, c.args.len(), "argument"), c.line, c.col)];
  }
  if (want == 1) {
    let pt: typeinfo.Type = cell_elem_type(recv);
    let at: typeinfo.Type = check_expr(c.args[0], s);
    out = util.append_diags(out, int_dest_range_diags(c.args[0], pt));
    // The cell keeps the value, so a `str` view is not lent here: native's
    // storesArgument.
    if (!is_unknown(at) && !is_unknown(pt) && !settles_to(c.args[0], pt, s) && !coercible(at, pt, s)) {
      out = out.append(dg_at("E038", "argument 1 to \"" + mfa.field + "\": expected " + type_label(pt) + ", got " + type_label(at) + str_copy_hint(at, pt), expr_line(c.args[0]), expr_col(c.args[0])));
    }
    out = util.append_diags(out, array_elem_check(array_elem_type_of(pt), c.args[0], s));
  }
  return out;
}

// Value calls share one semantic contract regardless of the expression that
// produced the callee. Unknown constituents suppress only their own type check,
// not a known arity or checks on the other parameters.
function callable_arg_diags(c: ast.ExprCall, ft: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  match (ft) {
    typeinfo.TypeFunc(f) => {
      if (!f.params_known) {
        return out;
      }
      if (c.args.len() != f.param_types.len()) {
        return [dg_at("E004", util.arity_message(call_subject(c), f.param_types.len(), c.args.len(), "argument"), c.line, c.col)];
      }
      let i: i32 = 0;
      while (i < c.args.len()) {
        let pt: typeinfo.Type = f.param_types[i];
        let at: typeinfo.Type = check_expr(c.args[i], s);
        out = util.append_diags(out, int_dest_range_diags(c.args[i], pt));
        if (!is_unknown(at) && !is_unknown(pt) && !settles_to(c.args[i], pt, s) && !view_arg_borrow(at, pt) && !coercible(at, pt, s)) {
          out = out.append(dg_at("E038", arg_subject(c, i + 1) + ": expected " + type_label(pt) + ", got " + argument_type_label(c.args[i], at, s), expr_line(c.args[i]), expr_col(c.args[i])));
        }
        out = util.append_diags(out, array_elem_check(array_elem_type_of(pt), c.args[i], s));
        i = i + 1;
      }
    },
    _ => {}
  }
  return out;
}

// display_dispatch_name is the receiver spelling a value of type `t` dispatches
// `.to_string()` under: the integer or float label, "boolean", "string", or the
// struct / enum / union name. "" for a type with no method namespace (an
// array, tuple, map or fn) and for one not judged here (unknown, erased, dyn).
function display_dispatch_name(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeStruct(sd) => {
      return sd.name;
    },
    typeinfo.TypeUnion(u) => {
      return u.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// display_resolves reports whether `t.to_string(): string` resolves in `s` —
// the Display spine's question (docs/TRAITS.md §3a), native's
// typeImplementsDisplay: a `to_string` method on the type's dispatch name, an
// `impl Display` / `@derive(cmp.Display)` on its declaration, or a builtin
// `to_string` (a boolean's, which needs no import). The import
// closure is what puts a scalar's stdlib method in `s.methods`, so `print(7)`
// resolves with `core/cmp` imported and not without, as native has it.
function display_resolves(t: typeinfo.Type, s: Scope): boolean {
  let tn: string = display_dispatch_name(t);
  if (tn.len() == 0) {
    return false;
  }
  return s.has_method("to_string", tn) || conforms_by_impl_or_derive(s, tn, "Display") || !is_unknown(builtin_method_sig(tn, "to_string"));
}

// display_unjudged: an argument type the Display spine neither rewrites nor
// refuses — a string or `str` view passes through as it stands, and an
// unknown, erased or trait-object type is left to the code that knows it.
function display_unjudged(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeString(_) => {
      return true;
    },
    typeinfo.TypeUnknown(_) => {
      return true;
    },
    typeinfo.TypeErased(_) => {
      return true;
    },
    typeinfo.TypeDyn(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// display_call_name is the builtin a call dispatches to when it is `print`,
// `write` or `eprint` with one argument and no user function shadows the
// name; "" otherwise.
// is_display_builtin names the builtins that print any Display value.
function is_display_builtin(name: string): boolean {
  return name == "print" || name == "write" || name == "eprint";
}

function display_call_name(c: ast.ExprCall, s: Scope): string {
  if (c.args.len() != 1) {
    return "";
  }
  if let ast.ExprIdent(id) = c.callee {
    if (!is_display_builtin(id.name)) {
      return "";
    }
    if (s.lookup_sig(id.name).name.len() > 0) {
      return "";
    }
    return id.name;
  }
  return "";
}

// display_rewrite is the Display spine's rewrite: the one argument of `print` /
// `write` / `eprint` that is not already a string is passed as
// `arg.to_string()`, so the string-only runtime helper is only ever handed a
// string — native's checker does the same at the same point. Only where
// `to_string` resolves: a type it does not resolve on is display_arg_diags'
// E038, and stays as written.
function display_rewrite(c: ast.ExprCall, nargs: ast.Expr[], s: Scope): ast.Expr[] {
  if (display_call_name(c, s).len() == 0) {
    return nargs;
  }
  let at: typeinfo.Type = check_expr(c.args[0], s);
  if (display_unjudged(at) || !display_resolves(at, s)) {
    return nargs;
  }
  let ln: i32 = expr_line(c.args[0]);
  let cl: i32 = expr_col(c.args[0]);
  let callee: ast.Expr = ast.ExprFieldAccess { obj: nargs[0], field: "to_string", line: ln, col: cl, ty: "", const_read: false };
  return [ast.ExprCall { callee: callee, args: [], line: ln, col: cl, type_args: [], ty: "string" }];
}

// display_arg_diags is the Display spine's refusal: E038, in native's words,
// for a `print` / `write` / `eprint` argument whose type resolves no
// `to_string(): string`.
function display_arg_diags(c: ast.ExprCall, s: Scope): util.Diag[] {
  let name: string = display_call_name(c, s);
  if (name.len() == 0) {
    return [];
  }
  let at: typeinfo.Type = check_expr(c.args[0], s);
  if (display_unjudged(at) || display_resolves(at, s)) {
    return [];
  }
  let label: string = type_label(at);
  return [dg_at(
    "E038", "argument 1 to \"" + name + "\": " + label + " does not implement `Display` (no `to_string(): string` in scope) — give "
      + label + " a `to_string(): string` method, or " + util.derive_hint(display_dispatch_name(at), "cmp.Display", "cmp.Display"),
    expr_line(c.args[0]), expr_col(c.args[0]),
  )];
}

// The columns of a bare `map_new(n)`, which only a destination binds.
const MAP_NEW_KEY: string = "map_new key";

const MAP_NEW_VALUE: string = "map_new value";

function unbound_column(t: typeinfo.Type, reason: string): boolean {
  if let typeinfo.TypeUnknown(u) = t {
    return u.reason == reason;
  }
  return false;
}

function map_method_column(t: typeinfo.Type, reason: string, name: string): typeinfo.Type {
  if (unbound_column(t, reason)) {
    return typeinfo.TypeErased { name: name };
  }
  return t;
}

// The constructor's missing columns can take a destination annotation.
// A written method call instead returns its generic K/V contract; those
// variables cannot acquire concrete types from the method's destination.
function map_method_receiver(c: ast.ExprCall, recv_ty: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeMap(mr) = recv_ty {
    if ((unbound_column(mr.key, MAP_NEW_KEY) || unbound_column(mr.value, MAP_NEW_VALUE)) && !literal_insert(c)) {
      return t_map(map_method_column(mr.key, MAP_NEW_KEY, "K"), map_method_column(mr.value, MAP_NEW_VALUE, "V"));
    }
  }
  return recv_ty;
}

function map_method_takes_key(method: string): boolean {
  return method == "insert" || method == "get_or" || method == "get" || method == "contains" || method == "remove";
}

// unbound_map_arg_diags reports E038 for each written key or value argument of
// a Map method whose column a bare `map_new(n)` left unbound: nothing names K
// or V there, so the argument has no type to meet. A map literal's own inserts
// bind the columns from their entries and are exempt.
function unbound_map_arg_diags(c: ast.ExprCall, method: string, mt: typeinfo.TypeMap, s: Scope, out: util.Diag[]): util.Diag[] {
  if (literal_insert(c) || c.args.len() == 0) {
    return out;
  }
  if (map_method_takes_key(method) && unbound_column(mt.key, MAP_NEW_KEY)) {
    out = out.append(dg_at("E038", "argument 1 to \"" + method + "\": expected K, got " + type_label(check_expr(c.args[0], s)), expr_line(c.args[0]), expr_col(c.args[0])));
  }
  let takes_value: boolean = (method == "insert" || method == "get_or") && c.args.len() == 2;
  if (takes_value && unbound_column(mt.value, MAP_NEW_VALUE)) {
    out = out.append(dg_at("E038", "argument 2 to \"" + method + "\": expected V, got " + type_label(check_expr(c.args[1], s)), expr_line(c.args[1]), expr_col(c.args[1])));
  }
  return out;
}

// E004: a Map builtin takes a fixed number of arguments.
// E038: a Map method's key and value arguments must match the map's columns,
// as `append`'s element does. `insert` stores both, so a `str` view is not
// lent there (native's storesArgument); a read borrows its key, so a view is.
// A literal's own entries are the E045 check's, apart from the view.
function map_arg_diags(c: ast.ExprCall, method: string, mt: typeinfo.TypeMap, s: Scope, out: util.Diag[]): util.Diag[] {
  let want: i32 = map_builtin_arity(method);
  if (want >= 0 && c.args.len() != want) {
    return out.append(dg_at("E004", util.arity_message("method \"" + method + "\"", want, c.args.len(), "argument"), c.line, c.col));
  }
  let slots: typeinfo.Type[] = map_arg_slots(method, mt);
  if (slots.len() == 0 || c.args.len() != slots.len()) {
    return out;
  }
  let ii: i32 = 0;
  while (ii < slots.len()) {
    out = map_arg_diag(c, ii, method, slots[ii], s, out);
    ii = ii + 1;
  }
  return out;
}

// The types a Map method's arguments are checked against, none for a method
// whose arguments are not checked here.
function map_arg_slots(method: string, mt: typeinfo.TypeMap): typeinfo.Type[] {
  if (method == "insert" || method == "get_or") {
    return [mt.key, mt.value];
  }
  if (method == "get" || method == "contains" || method == "remove") {
    return [mt.key];
  }
  return [];
}

// map_builtin_arity is how many arguments a Map runtime builtin takes, or -1
// when `method` is not one.
function map_builtin_arity(method: string): i32 {
  if (method == "insert" || method == "get_or") {
    return 2;
  }
  if (method == "get" || method == "contains" || method == "remove") {
    return 1;
  }
  if (method == "len" || method == "cleared" || method == "keys" || method == "values" || method == "iter") {
    return 0;
  }
  return 0 - 1;
}

function map_arg_diag(c: ast.ExprCall, ii: i32, method: string, slot: typeinfo.Type, s: Scope, out: util.Diag[]): util.Diag[] {
  let arg: ast.Expr = c.args[ii];
  let it: typeinfo.Type = check_expr(arg, s);
  let stores: boolean = method == "insert";
  let lent: boolean = !stores && view_arg_borrow(it, slot);
  let mismatch: boolean = stores && is_str_view(it) && is_owned_string(slot);
  if (!literal_insert(c) && !is_unknown(slot) && !is_unknown(it)) {
    out = util.append_diags(out, int_dest_range_diags(arg, slot));
    mismatch = !lent && !settles_to(arg, slot, s) && !coercible(it, slot, s);
  }
  if (mismatch) {
    out = out.append(dg_at("E038", "argument " + util.i32_to_string(ii + 1) + " to \"" + method + "\": expected " + type_label(slot) + ", got " + type_label(it) + str_copy_hint(it, slot), expr_line(arg), expr_col(arg)));
  }
  return out;
}

function call_diags_call(c: ast.ExprCall, s: Scope, out: util.Diag[], dest: typeinfo.Type): util.Diag[] {
  out = util.append_diags(out, e032_call_check(c, s));
  // A method-call callee (`obj.m(...)`) is an ExprFieldAccess
  // whose field names a METHOD, not a field — recurse only into
  // the object so it isn't mis-flagged as an unknown field (E043).
  match (c.callee) {
    ast.ExprFieldAccess(mfa) => {
      // A QUALIFIED variant constructor `W.Wrap(1)` is not a
      // method call: the object is a type QUALIFIER, not a value
      // (#6657). Recursing into it walks `W` as a bare identifier
      // and reports E001 "undefined name" — on the VALID call as
      // much as the ill-typed one, which is why this has to come
      // before the recursion rather than beside the method checks
      // further down.
      //
      // Detected with the same qual_enum_name the bare
      // `Enum.Variant` reference uses, then routed to the same
      // argument checks as the bare constructor call, so the two
      // spellings cannot drift apart.
      // An enum name also qualifies an ASSOCIATED function — `Opt.empty()`
      // under `impl Empty for Opt`, `Status.default()` under a derive — so a
      // field that is not a variant is only E036 once the associated
      // resolution below has also missed. Ordered the other way this arm
      // claimed every such call and reported a variant nobody wrote (#8461).
      let cqen: string = qual_enum_name(mfa.obj, s);
      if (cqen.len() > 0 && !assoc_call_req(mfa.obj, mfa.field, s, mfa.const_read).found) {
        if (!qual_variant_exists(cqen, mfa.field, s)) {
          out = out.append(no_variant_diag(s, cqen, mfa.field, mfa.line, mfa.col));
        } else {
          out = util.append_diags(out, variant_ctor_diags(cqen + "." + mfa.field, c, s));
        }
        for arg in c.args {
          out = util.append_diags(out, call_diags(arg, s));
        }
        return out;
      }
      // An ASSOCIATED (receiver-less) call on a type — `T.zero()` on a
      // bounded type parameter, `i32.zero()` on a concrete type. Like
      // the qualified variant above, the object is a type QUALIFIER,
      // so it must be diverted before the recursion reads it as a
      // value and reports E001 (#6933). The arguments are still
      // walked.
      let ah: AssocHit = assoc_call_req(mfa.obj, mfa.field, s, mfa.const_read);
      if (ah.found) {
        // A `Base.NAME` read names a constant and `Base.f(…)` a function;
        // the rewrite marks the read's callee const_read.
        let acr: util.Diag[] = assoc_const_read_diags(ah, c, mfa);
        if (acr.len() > 0) {
          return util.append_diags(out, acr);
        }
        for arg in c.args {
          out = util.append_diags(out, call_diags(arg, s));
        }
        return util.append_diags(out, assoc_arg_diags(ah, c, mfa, s));
      }
      if (mfa.const_read) {
        return out.append(dg_at("E043", util.demangle(assoc_base_name(mfa.obj)) + " has no associated constant \"" + mfa.field + "\"", c.line, c.col));
      }
      if let ast.ExprIdent(tid) = mfa.obj {
        if (!s.known(tid.name) && util.has_str(s.tparams, tid.name)) {
          out = out.append(tparam_assoc_diag(tid, mfa.field, s));
          for arg in c.args {
            out = util.append_diags(out, call_diags(arg, s));
          }
          return out;
        }
      }
      out = call_diags(mfa.obj, s);
      match (check_expr(mfa.obj, s)) {
        typeinfo.TypeTuple(mtt) => {
          let tdg: util.Diag[] = tuple_field_diags(mfa.field, mtt, mfa.line, mfa.col);
          if (tdg.len() > 0) {
            return util.append_diags(out, tdg);
          }
        },
        _ => {}
      }
      // E045: a map literal `Map { k: v, … }` desugars to
      // `map_new[_i32](n).insert(k0, v0).insert(…)…`. The FIRST
      // insert (its object is the base constructor) carries the
      // literal's first key, which fixes the map's key type — it
      // must be i32 or string (the only key kinds the runtime's
      // hash/compare supports). Reported at the key, matching the
      // Go checker, which checks `MapLit.Entries[0].Key`.
      if (mfa.field == "insert" && mlit_is_base(mfa.obj) && c.args.len() >= 1) {
        let kt: typeinfo.Type = check_expr(c.args[0], s);
        let kmsg: string = map_key_type_error(s, kt);
        if (kmsg != "") {
          out = out.append(dg_at("E045", kmsg, expr_line(c.args[0]), expr_col(c.args[0])));
        }
      }
    },
    ast.ExprIdent(cid) => {
      // E001: a call to an undefined function. A bare-ident
      // callee that resolves to nothing — not a local (closure),
      // a free function, a variant constructor, a runtime
      // intrinsic (`__`-prefixed), or a builtin function — is an
      // undefined call, reported at the callee.
      if (!is_resolvable_callee(cid.name, s)) {
        out = out.append(undefined_name(cid.name, s, cid.line, cid.col));
      }
      // E001: a Map built without `core/map` in the program's import closure.
      // Every Map operation lowers to that module's runtime helpers, so
      // without it the build links against undefined symbols — native reports
      // it here rather than leaving it to codegen, and so does this. A map
      // LITERAL needs no arm of its own: the compile parse desugars
      // `Map { … }` to one of these two constructors, which is also why
      // __map_new_i32 is named here although native has no such spelling.
      // Reported at every site and thinned to the first by check_module,
      // matching native's one diagnostic per program.
      if (is_map_new_name(cid.name) && !s.module_imported("core/map")) {
        out = out.append(dg_at("E001", map_import_msg(), c.line, c.col));
      }
    },
    _ => {
      out = call_diags(c.callee, s);
    }
  }
  // A callee that resolves to nothing is its own error, and native checks no
  // argument of it: the call has no parameters for them to meet.
  let dests: typeinfo.Type[] = s.call_param_types(c);
  let di: i32 = 0;
  if (!s.callee_resolves(c)) {
    di = c.args.len();
  }
  while (di < c.args.len()) {
    let dest: typeinfo.Type = t_unknown("no declared parameter");
    if (di < dests.len()) {
      dest = dests[di];
    }
    // A generic callee's parameter is spelled in its own type variables; a
    // generic function named as the argument needs them bound, from the
    // call's other arguments, to take its own type arguments from it.
    if (generic_fn_value_arg(c.args[di], s)) {
      dest = bound_param_dest(c, di, dest, s);
    }
    out = util.append_diags(out, dest_call_diags(c.args[di], dest, s));
    di = di + 1;
  }
  // E038: calling a NON-FUNCTION value (`x(3)` where x is an i32 /
  // string / etc.). The callee's type, when known and not a function
  // type, isn't callable. Mirrors the Go checker (callee type not a
  // FuncType -> E038 at the call). A free function / variant
  // constructor / builtin callee types as unknown here (it's not a
  // scope binding), so only a value-typed callee is flagged. A
  // FieldAccess callee (a method, or a function-valued field) is left
  // to the method path — a method on a non-struct is E043, not E038.
  match (c.callee) {
    ast.ExprFieldAccess(_) => {},
    _ => {
      let calleet: typeinfo.Type = check_expr(c.callee, s);
      let callee_is_fn: boolean = is_func_type(calleet);
      if (!is_unknown(calleet) && !callee_is_fn) {
        out = out.append(dg_at("E038", "calling non-function value of type " + type_label(calleet), c.line, c.col));
      }
    }
  }
  match (c.callee) {
    ast.ExprIdent(id) => {
      // E048: a field assignment `obj.field = v` is desugared
      // by the parser to `__set_field(obj, "field", v)`. Fields
      // are immutable after construction (the immutable-data
      // rule that keeps RC cycle-free), so any such call is
      // E048, reported at the object — matching the Go checker,
      // which flags the field-access lvalue. No false positives:
      // __set_field is a parser-internal builtin that no
      // hand-written source names, and the self-host + stdlib
      // were migrated off field mutation to functional updates.
      if (id.name == "__set_field" && c.args.len() == 3) {
        let fld: string = "field";
        match (c.args[1]) {
          ast.ExprString(fs) => {
            fld = fs.value;
          },
          _ => {}
        }
        if let typeinfo.TypeStruct(ost) = check_expr(c.args[0], s) {
          out = util.append_diags(out, opaque_access_diags(s.lookup_struct(ost.name), s, "access a field of", expr_line(c.args[1]), expr_col(c.args[1])));
        }
        out = out.append(dg_at("E048", "cannot assign to field \"" + fld + "\": fields are immutable after construction; rebuild with a struct-update literal", expr_line(c.args[1]), expr_col(c.args[1])));
      }
      // E056: `arr[i] = v` is desugared by the parser to
      // `__set_index(arr, idx, rhs)`. Array elements are
      // immutable after construction (the subscript counterpart
      // of E048), so any such call is E056, reported at the
      // call, which carries the `[`. Same no-false-positives argument as E048:
      // __set_index is parser-internal and the self-host +
      // stdlib were migrated off subscript assignment to
      // `arr = arr.with(i, v)`.
      if (id.name == "__set_index" && c.args.len() == 3) {
        out = out.append(dg_at("E056", "cannot assign to an array element: subscripts are read-only after construction; use `arr = arr.with(i, value)`", c.line, c.col));
      }
      // E057: cell_new(v) — a Cell's element type must be
      // cycle-free (cell_payload_risk). Reported at the argument,
      // matching the Go checker (n.Args[0].Pos()).
      if (id.name == "cell_new" && c.args.len() == 1) {
        let cnat: typeinfo.Type = check_expr(c.args[0], s);
        out = util.append_diags(out, e057_diag(type_label(named_tparams(cnat)), cnat, s, expr_line(c.args[0]), expr_col(c.args[0])));
      }
      // E072: a void expression is not a value. Native's only
      // requireValue site is the variant-constructor payload
      // (`Some(nothing())`); the same argument to a plain
      // function draws E038 and to a struct field E043, so
      // widening this past variant constructors would report a
      // code native does not.
      if (union_of_variant(id.name, s.unions).len() > 0 || parser.builtin_enum_of(id.name).len() > 0) {
        for arg in c.args {
          // Unit literals and bindings carry a value. A void call does not.
          let unit_binding: boolean = false;
          if let ast.ExprIdent(_) = arg {
            unit_binding = true;
          }
          if (is_void(check_expr(arg, s)) && !parser.is_unit_expr(arg) && !unit_binding) {
            out = out.append(dg_at("E072", "a void expression is not a value here; call it as a statement, and write `()` if you meant the unit value", expr_line(arg), expr_col(arg)));
          }
        }
      }
      if (!s.defines(id.name)) {
        let sig: FuncSig = s.lookup_sig(id.name);
        // E040: a GENERIC function called with explicit
        // call-site type arguments whose count doesn't match
        // its declared type-parameter count. Only fires for a
        // generic function when type args were written
        // (`f[i32](x)`); a bare call relies on inference
        // (uninferred_call_diags), and type args on a non-generic
        // function are ignored (matching the Go checker).
        if (sig.name.len() > 0 && sig.all_type_params.len() > 0 && c.type_args.len() > 0 && c.type_args.len() != sig.all_type_params.len()) {
          out = out.append(dg_at("E040", util.arity_message(id.name, sig.all_type_params.len(), c.type_args.len(), "type argument"), c.line, c.col));
        } else if (sig.name.len() > 0 && c.type_args.len() > 0) {
          out = util.append_diags(out, const_arg_diags(sig, c, s));
        }
        if (sig.name.len() > 0) {
          if (c.args.len() != sig.param_types.len()) {
            out = out.append(dg_at("E004", util.arity_message(call_subject(c), sig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
          } else {
            // E038: per-argument type mismatch (only when
            // the arity matches, so indices line up).
            let cbn: string[] = [];
            let cbt: typeinfo.Type[] = [];
            if (sig.all_type_params.len() > 0) {
              let (bn0, bt0) = call_type_bindings(sig, c, s);
              cbn = bn0;
              cbt = bt0;
            }
            let ai: i32 = 0;
            while (ai < c.args.len()) {
              let at: typeinfo.Type = check_expr(c.args[ai], s);
              out = util.append_diags(out, int_dest_range_diags(c.args[ai], sig.param_types[ai]));
              out = util.append_diags(out, bound_type_arg_diags(sig, c, ai, at, s, cbn, cbt));
              out = util.append_diags(out, ctor_payload_diags(c.args[ai], sig.param_types[ai], s));
              // An unknown PARAM type is an opaque generic
              // parameter (`f[T](x: T)`, where T erases to
              // unknown) — the arg can't be checked against
              // it, so skip rather than mis-flag E038. (An
              // unknown ARG is already skipped above.)
              let bound_checked: boolean = param_has_bindings(sig, ai, cbn);
              if (!bound_checked && !(sig.all_type_params.len() > 0 && binds_nothing(c.args[ai], s)) && !is_unknown(at) && !is_unknown(sig.param_types[ai]) && !settles_to(c.args[ai], sig.param_types[ai], s) && !view_arg_borrow(at, sig.param_types[ai]) && !coercible(at, sig.param_types[ai], s)) {
                out = out.append(dg_at("E038", arg_subject(c, ai + 1) + ": expected " + type_label(sig.param_types[ai]) + ", got " + argument_type_label(c.args[ai], at, s), expr_line(c.args[ai]), expr_col(c.args[ai])));
              }
              // E034: a composite-array literal argument's
              // elements checked against the parameter's
              // declared element type (the array as a whole
              // is assignable, so the E038 above stays
              // silent — this catches a bad element).
              out = util.append_diags(out, array_elem_check(array_elem_type_of(sig.param_types[ai]), c.args[ai], s));
              ai = ai + 1;
            }
            if (sig.all_type_params.len() > 0) {
              out = util.append_diags(out, call_bound_diags(sig.type_params, sig.type_bounds, sig.module, util.demangle(sig.name), cbn, cbt, s, c.line, c.col));
              let (fbn, fbt) = call_bindings(sig, c, s);
              out = util.append_diags(out, bound_arg_diags(sig, c, fbn, fbt, s));
              out = util.append_diags(out, uninferred_call_diags(sig, c, fbn, id.name, s, dest));
            }
          }
        }
        // The free builtins, which have no FuncSig for the rule above to
        // read. Only when no user function shadows the name.
        if (sig.name.len() == 0) {
          // One the self-host TYPES carries a full signature, so its call
          // goes through the same callable_arg_diags a declared function's
          // does: E038 on a parameter, E004 on the count (#9987).
          out = util.append_diags(out, callable_arg_diags(c, free_builtin_sig(id.name, s), s));
          out = util.append_diags(out, lane_index_diags(id.name, c));
          // `print` / `write` / `eprint` take any Display type: the argument is
          // judged by display_arg_diags rather than typed `string`, which
          // would refuse a struct carrying its own `to_string`.
          out = util.append_diags(out, display_arg_diags(c, s));
          // The Display builtins' arity, which free_builtin_sig leaves to this
          // pass: native reports E004 at the call (#7311).
          if (is_display_builtin(id.name) && c.args.len() != 1) {
            out = out.append(dg_at("E004", util.arity_message(call_subject(c), 1, c.args.len(), "argument"), c.line, c.col));
          }
        }
        if (s.lookup_sig(id.name).name.len() == 0) {
          out = util.append_diags(out, variant_ctor_diags(id.name, c, s));
        }
      } else {
        out = util.append_diags(out, callable_arg_diags(c, s.lookup(id.name), s));
      }
    },
    ast.ExprFieldAccess(mfa) => {
      // E004 for a method call `obj.m(args)`: when `obj` is a
      // known struct with a USER-DEFINED method `m`, the
      // explicit-argument count must match the method's
      // declared parameter count (the receiver is stored
      // separately, so param_types already excludes `self`).
      // Built-in methods (.len / .push / .write …) and
      // non-struct receivers aren't in the method table, so
      // lookup returns empty and they're left alone.
      let recv: typeinfo.Type = check_expr(mfa.obj, s);
      match (recv) {
        typeinfo.TypeTuple(_) => {
          out = util.append_diags(out, callable_arg_diags(c, check_expr(c.callee, s), s));
        },
        typeinfo.TypeI32(it) => {
          // E043: a method call on a numeric scalar receiver
          // (`x.m(...)` where x is i32 or f64) for which no method
          // `m` is declared on that type. Fern allows user-defined
          // methods on primitives (`function (n: i32) twice()`), so
          // we only flag the call when the method table has no such
          // method — then it's a field access on a non-struct,
          // mirroring the Go checker, which resolves the method,
          // finds none, and reports E043. The lookup keys on the
          // receiver's width-aware label (int_label) so a method
          // declared on i64 / u32 / u64 resolves too, not just i32.
          // A declared method, and string / array / map receivers
          // (whose builtin methods route elsewhere), stay clean.
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice(int_label(it), mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, int_label(it), mfa.field, s));
        },
        typeinfo.TypeFloat(f) => {
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice(float_label(f), mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, float_label(f), mfa.field, s));
        },
        typeinfo.TypeBool(_) => {
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("boolean", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, "boolean", mfa.field, s));
        },
        typeinfo.TypeString(_) => {
          // E043: a string carries exactly two builtin methods
          // — `len` and `as_bytes` (mirrors registerStringMethod
          // in the Go checker). Any other method must be
          // user-defined (in scope via a `function (s: string)
          // m()` decl, typically from std/string); when it's
          // neither builtin nor user-defined, it's a call to a
          // non-existent method — same shape as the numeric-
          // scalar case above.
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("string", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          // E004 (#7311): the two string builtins take no arguments. A wrong
          // count used to fall through to IR lowering and surface as the
          // whole-function #9053 ineligibility hint; native reports E004 at
          // the call. Only when no user method shadows the name — a user
          // `(s: string) len(…)` resolves through the MethodSig path below,
          // which has its own arity rule.
          if ((mfa.field == "len" || mfa.field == "as_bytes") && c.args.len() != 0 && s.lookup_method(mfa.field, "string").name.len() == 0) {
            out = out.append(dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", 0, c.args.len(), "argument"), c.line, c.col));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, "string", mfa.field, s));
        },
        typeinfo.TypeArray(ar) => {
          // E038: a built-in array method whose argument must
          // match the element type. `append(elem)` takes the
          // element; `with(i32, elem)` replaces at an index, so
          // its second argument is the element. Mirrors the Go
          // checker, which types these builtins and reports a
          // per-argument mismatch. An unknown element type
          // (uninferred receiver) or unknown arg is skipped. Both store the
          // element, so a `str` view is not lent here: native's storesArgument.
          if (!ar.view && mfa.field == "append" && c.args.len() == 1 && !is_unknown(ar.elem)) {
            let aat: typeinfo.Type = check_expr(c.args[0], s);
            out = util.append_diags(out, int_dest_range_diags(c.args[0], ar.elem));
            if (!is_unknown(aat) && !settles_to(c.args[0], ar.elem, s) && !coercible(aat, ar.elem, s)) {
              out = out.append(dg_at("E038", "argument 1 to \"append\": expected " + type_label(ar.elem) + ", got " + type_label(aat) + str_copy_hint(aat, ar.elem), expr_line(c.args[0]), expr_col(c.args[0])));
            }
          }
          if (!ar.view && mfa.field == "with" && c.args.len() == 2 && !is_unknown(ar.elem)) {
            let wvt: typeinfo.Type = check_expr(c.args[1], s);
            out = util.append_diags(out, int_dest_range_diags(c.args[1], ar.elem));
            if (!is_unknown(wvt) && !settles_to(c.args[1], ar.elem, s) && !coercible(wvt, ar.elem, s)) {
              out = out.append(dg_at("E038", "argument 2 to \"with\": expected " + type_label(ar.elem) + ", got " + type_label(wvt) + str_copy_hint(wvt, ar.elem), expr_line(c.args[1]), expr_col(c.args[1])));
            }
          }
          // E043 (array method existence): only `append` / `with`
          // / `len` are unconditional array builtins. Every other
          // method comes from an imported module as a
          // `function (xs: T[]) <name>(…)` receiver method,
          // element-polymorphic or pinned to one element type.
          // When the call is none of those it names a
          // non-existent method. Mirrors the Go checker, which
          // registers append/with/len unconditionally and
          // resolves the rest from the imported module (so
          // `a.sum()` without `import "std/array"` is E043, but
          // resolves with it). The namespace is keyed on the
          // method name, so there is no per-element match to
          // make here either.
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("Array", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          let arr_label: string = "Array";
          if (ar.view) {
            arr_label = "slice";
          }
          let asig: MethodSig = s.array_recv_method(mfa.field, ar.view);
          out = util.append_diags(out, uninferred_method_diags(c, arr_label, mfa.field, asig, s));
          if (asig.name.len() > 0 && c.args.len() == asig.param_types.len()) {
            out = util.append_diags(out, method_arg_diags(c, mfa.field, asig, recv, s));
            out = util.append_diags(out, method_type_arg_diags(c, mfa.field, asig, recv, s));
          }
          // E004 (array builtin arity): the three unconditional array
          // builtins take a fixed number of arguments — `len()` none,
          // `append(x)` one, `with(i, v)` two — so an over- or
          // under-supplied call is a plain mistake the Go checker
          // reports and this one did not. Without it `a.len(3)` reached
          // lowering, which refuses the whole module as not IR-eligible:
          // a message naming neither the call nor the mistake.
          //
          // Only these three. Every other array method resolves from an
          // imported module, and its arity lives in the FuncSig the
          // E043 arm above looks up — a separate check, not this one.
          let abw: i32 = 0 - 1;
          if (mfa.field == "len") {
            abw = 0;
          }
          if (!ar.view && mfa.field == "append") {
            abw = 1;
          }
          if (!ar.view && mfa.field == "with") {
            abw = 2;
          }
          if (abw >= 0 && c.args.len() != abw) {
            out = out.append(dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", abw, c.args.len(), "argument"), c.line, c.col));
          }
        },
        typeinfo.TypeMap(mt) => {
          out = map_arg_diags(c, mfa.field, mt, s, out);
          out = unbound_map_arg_diags(c, mfa.field, mt, s, out);
          out = util.append_diags(out, map_method_arg_diags(c, recv, mfa.field, s));
          // E043 (map method existence). methods_in_namespace("Map") is the
          // whole surface — the runtime builtins plus whatever core/map's
          // receiver methods add once it is in the program — so a name that
          // is not in it exists nowhere. That covers the retired `set` /
          // `delete` / `clear`, which native registers and then removes, and
          // whose advice names the value-returning replacement.
          if (s.method_missing(recv, mfa.field)) {
            // Labelled "Map", not the parameterised spelling: native models a
            // Map as a struct of that name, so that is what its message says.
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_message("Map", mfa.field, "Map", recv), mfa.line, mfa.col), mfa, recv));
          }
        },
        typeinfo.TypeDyn(d) => {
          out = util.append_diags(out, dyn_call_diags(c, mfa, d.traits, s));
        },
        typeinfo.TypeStruct(sn) => {
          // Cell[T]'s two methods are builtins, so they are in neither the
          // method table nor the struct table. Both lookups missed, the arm
          // below found no struct to resolve a field against, and the call
          // was accepted whatever it was handed (#9518). Checked here, ahead
          // of the user tables, the way the receiver's type is.
          //
          // Arity and position follow native, which models these as ordinary
          // functions carrying the receiver: `c.set(v)` is two arguments and
          // the value is the SECOND, so a mismatch reads "argument 2".
          if (is_cell_type(recv)) {
            out = util.append_diags(out, cell_call_diags(c, mfa, recv, s));
          } else {
            out = util.append_diags(out, ambiguous_call_diags(mfa, sn.name, s));
            out = util.append_diags(out, finalizer_call_diags(mfa, sn.name, s));
            let msig: MethodSig = s.lookup_method(mfa.field, sn.name);
            if (msig.name.len() > 0) {
              if (c.args.len() != msig.param_types.len()) {
                out = out.append(dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
              } else {
                out = util.append_diags(out, method_arg_diags(c, mfa.field, msig, recv, s));
                out = util.append_diags(out, method_type_arg_diags(c, mfa.field, msig, recv, s));
                out = util.append_diags(out, uninferred_method_diags(c, sn.name, mfa.field, msig, s));
                out = util.append_diags(out, uninferred_recv_diags(c, sn.name, mfa.field, msig, sn.args, s));
              }
            } else {
              // A call `obj.m(...)` on a known struct with no
              // method `m`. Resolve `m` as a field (mirroring
              // the Go checker, which falls through to the
              // field after the method lookup misses):
              //   - not a field        → E043 (no such member)
              //   - field, function-typed → ok (closure-field
              //     call: `p.handler()` where handler: () => T)
              //   - field, non-function → E038 (calling a
              //     non-function value)
              // A present, function-typed field is the only
              // valid case, so neither diagnostic false-fires
              // on real method or closure-field calls. A builtin
              // method (`Reader.read_chunk`) is checked against
              // builtin_sigs instead.
              let bms: typeinfo.Type = builtin_method_sig(sn.name, mfa.field);
              let fsig: StructSig = s.lookup_struct(sn.name);
              if (!is_unknown(bms)) {
                out = util.append_diags(out, callable_arg_diags(c, bms, s));
              } else if (sn.name == "MapIter" && !is_map_iter_method(mfa.field)) {
                // Map.iter()'s cursor is a builtin with no struct
                // declaration, so the field fallback below never sees it.
                out = out.append(access_fix(dg_at("E043", "struct MapIter has no field or method \"" + mfa.field + "\"", mfa.line, mfa.col), mfa, map_iter_methods()));
              } else if (fsig.name.len() > 0) {
                let fldi: i32 = field_index(fsig, mfa.field);
                if (fldi < 0) {
                  out = out.append(s.member_fix(dg_at("E043", "struct " + util.demangle(sn.name) + " has no field or method \"" + mfa.field + "\"", mfa.line, mfa.col), mfa, fsig));
                } else {
                  let fldt: typeinfo.Type = field_access_result_type(mfa, sn, s);
                  let fld_is_fn: boolean = false;
                  match (fldt) {
                    typeinfo.TypeFunc(_) => {
                      fld_is_fn = true;
                    },
                    _ => {}
                  }
                  if (!fld_is_fn) {
                    out = out.append(dg_at("E038", "calling non-function value of type " + type_label(fldt), mfa.line, mfa.col));
                  } else {
                    out = util.append_diags(out, callable_arg_diags(c, check_expr(c.callee, s), s));
                  }
                }
              }
            }
          }
        },
        typeinfo.TypeUnion(un) => {
          out = util.append_diags(out, ambiguous_call_diags(mfa, un.name, s));
          out = util.append_diags(out, finalizer_call_diags(mfa, un.name, s));
          let umsig: MethodSig = s.lookup_method(mfa.field, un.name);
          if (umsig.name.len() > 0 && c.args.len() == umsig.param_types.len()) {
            out = util.append_diags(out, method_arg_diags(c, mfa.field, umsig, recv, s));
            out = util.append_diags(out, method_type_arg_diags(c, mfa.field, umsig, recv, s));
            out = util.append_diags(out, uninferred_method_diags(c, un.name, mfa.field, umsig, s));
            out = util.append_diags(out, uninferred_recv_diags(c, un.name, mfa.field, umsig, un.args, s));
          }
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
        },
        _ => {
          // A bounded type parameter receiver: `a.f(...)` where `a: T`
          // and `T: Tr`. T is a type variable, so the receiver lands
          // here rather than in a nominal arm above. A requirement of
          // one of T's bounds that has no leading `self` is an
          // ASSOCIATED function — `T.f(...)`, never a value's method —
          // and calling it through a value built a call one argument
          // wider than the callee, which only the IR verifier refused,
          // at codegen, in the language of an internal invariant
          // (#7221). A receiver method, and a `T.f(...)` written the
          // way it is meant to be, are resolved elsewhere and untouched.
          out = util.append_diags(out, type_param_method_diags(c, mfa, recv, s));
        }
      }
    },
    _ => {
      out = util.append_diags(out, callable_arg_diags(c, check_expr(c.callee, s), s));
    }
  }

  return out;
}

function type_param_method_diags(c: ast.ExprCall, mfa: ast.ExprFieldAccess, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let tpn: string = tp_receiver(recv, s);
  if (tpn.len() > 0) {
    let tph: AssocHit = tp_assoc_req(s, tpn, mfa.field);
    if (tph.found) {
      out = out.append(dg_at("E021", "\"" + mfa.field + "\" is an associated function of trait " + tph.owner + ", not a method; call it as " + tpn + "." + mfa.field + "(...)", c.line, c.col));
    } else if (!tp_bound_provides(s, tpn, mfa.field)) {
      out = out.append(dg_at("E021", "no method \"" + mfa.field + "\" on type parameter " + tpn + "; add a trait bound such as [" + tpn + ": SomeTrait] that provides it", c.line, c.col));
    } else {
      match (bound_method(s, tpn, mfa.field)) {
        Some(msig) => {
          if (c.args.len() != msig.param_types.len()) {
            out = out.append(dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
          } else {
            out = util.append_diags(out, method_arg_diags(c, mfa.field, msig, recv, s));
            out = util.append_diags(out, method_type_arg_diags(c, mfa.field, msig, recv, s));
          }
        },
        None => {}
      }
    }
  }
  return out;
}

// binop_lit_range_diags: E047 for a literal operand that the type the OTHER
// operand is already committed to cannot hold. `a - 4611686018427387904` with
// `a: i32` reads the literal at i32, where it truncates to 0 — native reports
// the literal rather than widening the whole binary behind the committed
// operand's back, and this is the rule that says so here (#8722).
function binop_lit_range_diags(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): util.Diag[] {
  let out: util.Diag[] = [];
  if (!is_integer(lt) || !is_integer(rt)) {
    return out;
  }
  if (int_literal_tree(b.left) && !int_literal_tree(b.right)) {
    return int_dest_range_diags(b.left, rt);
  }
  if (int_literal_tree(b.right) && !int_literal_tree(b.left)) {
    return int_dest_range_diags(b.right, lt);
  }
  return out;
}

// tvar_operator_diags is E009 for an operator on a value of a type variable
// whose bound supplies no method for it: an ordering needs `cmp`, arithmetic,
// bitwise and shift operators their `ast.operator_method`, and the saturating
// and checked forms are integer-only. With the method, the operator means that
// method in every instance. Equality is not the bound's question: it holds on
// any type variable.
function tvar_operator_diags(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): util.Diag[] {
  let method: string = tvar_operator_method(b.op);
  if (method == "-") {
    return [];
  }
  for side in [lt, rt] {
    let name: string = unmet_tvar(side, method, s);
    if (name != "") {
      return [dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + name, b.line, b.col)];
    }
  }
  // The bound's method takes another value of the same variable, so the
  // other operand must be one.
  let ln: string = unmet_tvar(lt, "", s);
  let rn: string = unmet_tvar(rt, "", s);
  if (ln != rn && !is_unknown(lt) && !is_unknown(rt)) {
    let name: string = ln;
    if (name == "") {
      name = rn;
    }
    return [dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + name, b.line, b.col)];
  }
  return [];
}

// tvar_operator_method is the method a bound must supply for `op` on a type
// variable: "" when none can, "-" when the bound is not asked.
function tvar_operator_method(op: string): string {
  if (op == "<" || op == "<=" || op == ">" || op == ">=") {
    return "cmp";
  }
  let method: string = ast.operator_method(op);
  if (method != "" || util.has_str(["+|", "-|", "*|", "<<|", "+?", "-?", "*?", "/?", "%?", "<<?", ">>?"], op)) {
    return method;
  }
  return "-";
}

// unmet_tvar names `t` when it is a type variable of this function whose bound
// supplies no `method` ("" supplied by none), else "".
function unmet_tvar(t: typeinfo.Type, method: string, s: Scope): string {
  let name: string = "";
  if let typeinfo.TypeErased(e) = t {
    name = e.name;
  }
  if (name == "" || !util.has_str(s.tparams, name)) {
    return "";
  }
  if (method != "" && tp_bound_provides(s, name, method)) {
    return "";
  }
  return name;
}

// tvar_neg_diags is E009 for `-` on a type variable whose bound supplies no `neg`.
function tvar_neg_diags(u: ast.ExprUnary, s: Scope): util.Diag[] {
  if (u.op != "-") {
    return [];
  }
  let name: string = unmet_tvar(check_expr(u.operand, s), "neg", s);
  if (name == "") {
    return [];
  }
  return [dg_at("E009", "operator \"-\" requires an integer type, got " + name, u.line, u.col)];
}

function call_diags_binary(b: ast.ExprBinary, s: Scope, out: util.Diag[]): util.Diag[] {
  // A named-argument marker's left side is the parameter NAME, not a value
  // read: only the value beside it is walked (the marker survives only on a
  // call fill_default_args refused, which E077 / E004 already name).
  if (b.op == "__named_arg") {
    return util.append_diags(out, call_diags(b.right, s));
  }
  let (diags, bt) = binary_diags_typed(b, s);
  return diags;
}

// operand_diags_typed is call_diags of a binary operator's operand together
// with its type. An operand that is itself an operator is walked by
// binary_diags_typed, which types it from its own operands' types, so a chain
// `a + b + c + ...` types each operand once rather than once per level above.
function operand_diags_typed(e: ast.Expr, s: Scope): (util.Diag[], typeinfo.Type) {
  if let ast.ExprBinary(b) = e {
    if (b.op != "__named_arg") {
      return binary_diags_typed(b, s);
    }
  }
  return (call_diags(e, s), check_expr(e, s));
}

// binary_diags_typed is call_diags_binary for an operator other than the
// named-argument marker, together with check_expr's type of `b`.
// lanes_operator_diags judges a binary with a lane operand. `+ - * /` take two
// values of one lane type (E009 otherwise), and no comparison takes a lane
// value, whose answer is a mask the `lt` and `ne` builtins give (E041).
function lanes_operator_diags(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): util.Diag[] {
  if (util.has_str(["==", "!=", "<", ">", "<=", ">="], b.op)) {
    let lanes: string = type_label(lt);
    if (!is_lanes(lt)) {
      lanes = type_label(rt);
    }
    return [dg_at("E041", "cannot compare values of type " + lanes + " with \"" + b.op + "\": a lane value compares lane by lane, through __" + lanes + "_lt and __" + lanes + "_ne", b.line, b.col)];
  }
  if (util.has_str(["+", "-", "*", "/"], b.op) && type_eq(lt, rt)) {
    return [];
  }
  if (operand_open(lt) || operand_open(rt)) {
    return [];
  }
  let what: string = "numeric";
  if (b.op == "+") {
    what = "numeric or string";
  }
  return [dg_at("E009", "operator \"" + b.op + "\" requires matching " + what + " operands, got " + type_label(lt) + " and " + type_label(rt), b.line, b.col)];
}

function binary_diags_typed(b: ast.ExprBinary, s: Scope): (util.Diag[], typeinfo.Type) {
  let (ldiags, blt) = operand_diags_typed(b.left, s);
  let (rdiags, brt) = operand_diags_typed(b.right, s);
  let out: util.Diag[] = util.append_diags(ldiags, rdiags);
  out = util.append_diags(out, binop_lit_range_diags(b, blt, brt));
  out = util.append_diags(out, tvar_operator_diags(b, blt, brt, s));
  if (is_lanes(blt) || is_lanes(brt)) {
    return (util.append_diags(out, lanes_operator_diags(b, blt, brt)), binary_result_type(b, blt, brt, s));
  }
  // E009: `&&` / `||` require both operands to be boolean.
  if (b.op == "&&" || b.op == "||") {
    if (!is_unknown(blt) && !type_eq(blt, t_bool())) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires boolean, got " + type_label(blt), b.line, b.col));
    }
    if (!is_unknown(brt) && !type_eq(brt, t_bool())) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires boolean, got " + type_label(brt), b.line, b.col));
    }
  }
  // E041: `==` / `!=` require same-typed operands (the same rule
  // check_expr applies). Ordering ops on mismatched types are
  // E009 instead, so they're not handled here.
  if (b.op == "==" || b.op == "!=") {
    // An unsuffixed literal on either side is read at the other operand's
    // type, so `n == 3` holds for an `n` of any integer width and
    // `u32_valued == 4294967295` is not a u32/i64 mismatch. `settles_to` is
    // the same predicate an assignment reads it through, magnitude rule
    // included. Two DIFFERENTLY-typed integers are still E041, matching
    // native.
    let eq_widths: boolean = type_eq(blt, brt)
      || settles_to(b.left, brt, s) || settles_to(b.right, blt, s);
    if (!is_unknown(blt) && !is_unknown(brt) && !eq_widths) {
      out = out.append(dg_at("E041", "cannot compare " + type_label(blt) + " with " + type_label(brt) + ": both sides of \"" + b.op + "\" must have the same type", b.line, b.col));
    } else if (!is_unknown(blt) && eq_widths && is_composite_type(blt)) {
      // Composite `==` / `!=` is STRUCTURAL equality via the
      // type's `Eq` impl — it desugars to `a.eq(b)`, so a struct
      // or enum that HAS an `eq` is well-formed. Without one the
      // operator would mean heap-pointer identity; arrays and
      // tuples have no structural equality at all.
      let eqrecv: string = cmp_method_receiver(blt);
      if (eqrecv == "") {
        out = out.append(dg_at("E041", "cannot compare values of type " + type_label(blt) + " with \"" + b.op + "\": structural equality for arrays / slices / tuples is not supported — compare elements individually", b.line, b.col));
      } else if (s.lookup_method("eq", eqrecv).name.len() == 0) {
        out = out.append(dg_at("E041", "cannot compare values of type " + util.demangle(type_label(blt)) + " with \"" + b.op + "\": type does not implement `Eq` — " + util.derive_hint(eqrecv, "cmp.Eq", "cmp.Eq") + ", so `==` can use structural equality", b.line, b.col));
      }
    }
  }
  // E009: `+` is overloaded — both string (concat), both i32, or
  // both f64; anything else is an operand error. `-` / `*` / `/`
  // need matching i32 or f64, `%` matching i32 only. Same rules
  // check_expr applies, so this fires only where it already
  // rejects the operands (no new false positives).
  if (b.op == "+") {
    let (pl, pr) = settled_operands(b, blt, brt);
    if (!operand_open(pl) && !operand_open(pr)) {
      let oks: boolean = type_eq(pl, t_string()) && type_eq(pr, t_string());
      let both_int: boolean = is_integer(pl) && is_integer(pr);
      let oki2: boolean = both_int && int_operands_agree(pl, pr, b.left, b.right);
      let okf2: boolean = float_operands_agree(pl, pr);
      // A composite operand carrying the overload method is well-formed —
      // the same rule check_expr applies, read from the same helper so the
      // promise above (this fires only where check_expr already rejects)
      // stays true.
      let okov2: boolean = !is_unknown(s.binop_overload_ret(b.op, pl));
      if (!oks && !oki2 && !okf2 && !okov2) {
        if (both_int) {
          out = out.append(mixed_int_diag(b.op, pl, pr, b.line, b.col));
        } else {
          out = util.append_diags(out, numeric_operand_diags(b.op, pl, pr, b.line, b.col));
        }
      }
    }
  }
  if (b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%") {
    let (alt, art) = settled_operands(b, blt, brt);
    if (!operand_open(alt) && !operand_open(art)) {
      let a_both_int: boolean = is_integer(alt) && is_integer(art);
      let oki: boolean = a_both_int && int_operands_agree(alt, art, b.left, b.right);
      let okf: boolean = b.op != "%" && float_operands_agree(alt, art);
      let okov: boolean = !is_unknown(s.binop_overload_ret(b.op, alt));
      if (!oki && !okf && !okov) {
        if (a_both_int) {
          out = out.append(mixed_int_diag(b.op, alt, art, b.line, b.col));
        } else {
          out = util.append_diags(out, numeric_operand_diags(b.op, alt, art, b.line, b.col));
        }
      }
    }
  }
  // E009: saturating arithmetic (`+|` `-|` `*|` `<<|`) is
  // integer-only — no string concat, no float form. Mirrors the Go
  // checker's dedicated requireInteger pair (#5542).
  if (b.op == "+|" || b.op == "-|" || b.op == "*|" || b.op == "<<|") {
    if (!operand_open(blt) && !operand_open(brt)) {
      if (!is_integer(blt) || !is_integer(brt)) {
        out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires matching integer operands, got " + type_label(blt) + " and " + type_label(brt), b.line, b.col));
      } else if (is_usize(blt) || is_usize(brt)) {
        out = out.append(dg_at("E009", "saturating operator \"" + b.op + "\" is not supported on `usize` — its clamp bounds are target-width-dependent; cast to a fixed-width integer (`as u64`) first", b.line, b.col));
      } else if (!int_operands_agree(blt, brt, b.left, b.right)) {
        out = out.append(mixed_int_diag(b.op, blt, brt, b.line, b.col));
      }
    }
  }
  // E009: checked arithmetic (`+?` `-?` `*?`) is integer-only too —
  // it yields Option[T]. Same requireInteger pair as saturating (#5542).
  if (b.op == "+?" || b.op == "-?" || b.op == "*?" || b.op == "/?" || b.op == "%?" || b.op == "<<?" || b.op == ">>?") {
    if (!operand_open(blt) && !operand_open(brt)) {
      if (!is_integer(blt) || !is_integer(brt)) {
        out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires matching integer operands, got " + type_label(blt) + " and " + type_label(brt), b.line, b.col));
      } else if (is_usize(blt) || is_usize(brt)) {
        out = out.append(dg_at("E009", "checked operator \"" + b.op + "\" is not supported on `usize` — its overflow bound is target-width-dependent; cast to a fixed-width integer (`as u64`) first", b.line, b.col));
      } else if (!int_operands_agree(blt, brt, b.left, b.right)) {
        out = out.append(mixed_int_diag(b.op, blt, brt, b.line, b.col));
      }
    }
  }
  // E009: shift / bitwise ops (`<<` `>>` `&` `|` `^`) require both
  // operands to be integers. Mirrors the Go checker's requireInteger
  // for `case "%", "&", "|", "^", "<<", ">>"` (`%` is in the numeric
  // group above). `&&` / `||` are the logical ops, handled separately.
  if (b.op == "<<" || b.op == ">>" || b.op == "&" || b.op == "|" || b.op == "^") {
    // A composite carrying the operator's method is well-formed: `a & b` is
    // `a.bitand(b)`, as check_expr types it.
    let sov: boolean = !is_unknown(s.binop_overload_ret(b.op, blt));
    if (!sov && !operand_open(blt) && !is_integer(blt)) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + type_label(blt), b.line, b.col));
    } else if (!sov && !operand_open(brt) && !is_integer(brt)) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + type_label(brt), b.line, b.col));
    } else if (!sov && !operand_open(blt) && !operand_open(brt) && !int_operands_agree(blt, brt, b.left, b.right)) {
      out = out.append(mixed_int_diag(b.op, blt, brt, b.line, b.col));
    }
  }
  // E009: ordering ops (`<` `>` `<=` `>=`) require both operands to be
  // the same numeric type (both i32 or both f64). Mirrors the Go
  // checker (requireInteger, or requireFloat when either side is
  // float). `==` / `!=` (equality, E041) are handled above.
  if (b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") {
    let (olt, ort) = settled_operands(b, blt, brt);
    if (!operand_open(olt) && !operand_open(ort)) {
      let o_both_int: boolean = is_integer(olt) && is_integer(ort);
      let oki_o: boolean = o_both_int && int_operands_agree(olt, ort, b.left, b.right);
      let okf_o: boolean = float_operands_agree(olt, ort);
      let oks_o: boolean = type_eq(olt, t_string()) && type_eq(ort, t_string());
      let okc_o: boolean = type_eq(olt, t_char()) && type_eq(ort, t_char());
      if (!oki_o && !okf_o && !oks_o && !okc_o) {
        if (type_eq(olt, ort) && is_composite_type(olt)) {
          // Ordering two values of the SAME composite type is
          // structural comparison via the type's `Ord` impl —
          // `a.cmp(b) <op> 0` — so a struct or enum that HAS a
          // `cmp` is well-formed. Without one, and for arrays /
          // tuples (which have no structural ordering at all),
          // it is E041. Mirrors the Go checker, which routes
          // same-composite ordering to E041 — mixed
          // composite/scalar operands, or two differing types,
          // stay E009 (verified against the Go checker).
          let ordrecv: string = cmp_method_receiver(olt);
          if (ordrecv == "") {
            out = out.append(dg_at("E041", "cannot order values of type " + type_label(olt) + " with \"" + b.op + "\": structural ordering for arrays / slices / tuples is not supported", b.line, b.col));
          } else if (!s.has_ord_cmp(olt)) {
            out = out.append(dg_at("E041", "cannot order values of type " + util.demangle(type_label(olt)) + " with \"" + b.op + "\": type does not implement `Ord` — " + util.derive_hint(ordrecv, "cmp.Ord", "cmp.Ord") + ", so ordering can use structural comparison", b.line, b.col));
          }
        } else if (o_both_int) {
          out = out.append(mixed_int_diag(b.op, olt, ort, b.line, b.col));
        } else {
          out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires matching numeric or string operands, got " + type_label(olt) + " and " + type_label(ort), b.line, b.col));
        }
      }
    }
  }

  return (out, binary_result_type(b, blt, brt, s));
}

function call_diags_unary(u: ast.ExprUnary, s: Scope, out: util.Diag[]): util.Diag[] {
  out = call_diags(u.operand, s);
  // E009: `!` requires a boolean operand.
  if (u.op == "!") {
    let ot: typeinfo.Type = check_expr(u.operand, s);
    if (!is_unknown(ot) && !type_eq(ot, t_bool())) {
      out = out.append(dg_at("E009", "operator \"!\" requires boolean, got " + type_label(ot), u.line, u.col));
    }
  }
  out = util.append_diags(out, tvar_neg_diags(u, s));
  // E009: unary `-` (negation) requires a numeric (i32 / f64) operand.
  // Mirrors the Go checker (requireInteger / requireFloat for unary
  // minus); a string / bool / composite operand is rejected.
  if (u.op == "-") {
    let nt: typeinfo.Type = check_expr(u.operand, s);
    let nok: boolean = !is_unknown(s.unop_overload_ret(u.op, nt));
    if (!operand_open(nt) && !is_integer(nt) && !is_float(nt) && !is_lanes(nt) && !nok) {
      out = out.append(dg_at("E009", "operator \"-\" requires an integer type, got " + type_label(nt), u.line, u.col));
    }
  }
  // E033 / E069: an invalid `as` cast. `x as T` desugars to the
  // unary op `as_<T>` (operand = x). Positioned at the `as` keyword to
  // match the Go checker (whose CastExpr position is the `as` token).
  if (u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as_") {
    // E071 (#5629 slice 5): a LITERAL cast to `char` must name a
    // Unicode scalar value. Keyed on the op text, not the target
    // Type, because this port resolves `char` to i32 and so cannot
    // tell `as_char` from `as_i32` by type alone. A non-literal
    // operand stays unchecked, matching the Go checker — `as char`
    // is the reinterpret hatch for values already known to be
    // scalars.
    if (u.op == "as_char") {
      match (u.operand) {
        ast.ExprNumber(cn) => {
          if (!cn.is_float && !lit_is_scalar_value(cn.text)) {
            out = out.append(dg_at("E071", lit_scalar_msg(cn.text), u.line, u.col));
          }
        },
        _ => {}
      }
    }
    let tgt: typeinfo.Type = s.resolve_type(slice_unchecked(u.op, 3, u.op.len()) + "");
    // E047: a bare literal operand settles at the cast's type, as native's
    // cast-inner settle does; a negated or computed operand is not settled.
    if let ast.ExprNumber(_) = u.operand {
      out = util.append_diags(out, int_dest_range_diags(u.operand, tgt));
    }
    out = util.append_diags(out, cast_diags(u, tgt, check_expr(u.operand, s), s));
  }
  // `x as? T` (the unary op `as?_T`) downcasts a `dyn Trait` value, or converts
  // an integer to an integer type: E059 for any other operand, E060 for an
  // integer's non-integer target.
  if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
    let aot: typeinfo.Type = check_expr(u.operand, s);
    let target: string = slice_unchecked(u.op, 4, u.op.len()) + "";
    if (is_integer(aot)) {
      if (!is_integer(s.resolve_type(target))) {
        out = out.append(dg_at("E060", "'as?' from " + type_label(aot) + " converts only to an integer type, got " + target, u.line, u.col));
      }
    } else if (!downcast_operand_ok(aot)) {
      out = out.append(dg_at("E059", "'as?' requires a 'dyn Trait' value or an integer on the left, got " + type_label(aot), u.line, u.col));
    }
  }
  // E042: the `?` try operator (parsed as the unary op `try_`)
  // requires an Option, Result, or @try enum operand. The self-host models a
  // sound, zero-false-positive subset: when the operand is a known
  // scalar primitive (i32 / bool / string / f64) it can never be an
  // supported enum, so flag it. Enum-typed operands type to
  // struct / union / unknown here (never a primitive), so legal `?`
  // uses are left untouched — mirroring the E033/E034 conservatism.
  if (u.op == "try_") {
    let trt: typeinfo.Type = check_expr(u.operand, s);
    if (is_primitive_type(trt)) {
      out = out.append(dg_at("E042", "`?` operator requires an Option, a Result, or an `@try` enum, got " + type_label(trt), u.line, u.col));
    } else {
      // E042 return-shape: `?` on a `?`-able enum requires the surrounding
      // function to return that same enum.
      match (trt) {
        typeinfo.TypeUnion(tu) => {
          if (try_able_union(s, tu.name)) {
            // The enum IS `?`-able, so the remaining question is the
            // return shape. Naming the enum rather than a placeholder
            // matches native, which prints the operand's enum in both
            // slots (#9344).
            if (try_ret_other_type(s.try_ret, tu.name)) {
              out = out.append(dg_at("E042", "`?` on " + tu.name + " requires the surrounding function to return " + tu.name + ", got " + try_ret_label(s.try_ret), u.line, u.col));
            } else {
              out = util.append_diags(out, try_residual_diags(s, trt, u));
            }
          } else {
            // E042 not-a-`?`-type (#9331). The conservatism above covers a
            // primitive operand; an unmarked enum is the other operand `?`
            // cannot take, and it reads as a union here rather than a
            // primitive, so it fell through. Gated on the union being
            // DECLARED in this module, so an unresolved name stays with the
            // native checker rather than drawing a guess.
            let us: UnionSig = s.lookup_union(tu.name);
            if (us.name.len() != 0) {
              out = out.append(dg_at("E042", "`?` operator requires an Option, a Result, or an `@try` enum, got " + tu.name + " — mark it `@try` to make it one", u.line, u.col));
            }
          }
        },
        _ => {}
      }
    }
  }

  return out;
}

// cast_diags are the E069 / E033 refusals of `u`, a cast of a `cot` value to
// `tgt`. Between scalars (`as_cast_allowed`) identity, numeric↔numeric and
// string↔i32 are accepted. Otherwise the cast is a pointer hop
// (`cast_pointer_shaped`) or a type ascription the value must be coercible
// to; a side that does not resolve is left alone.
function cast_diags(u: ast.ExprUnary, tgt: typeinfo.Type, cot: typeinfo.Type, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  if (is_primitive_type(tgt) && is_primitive_type(cot)) {
    // E069 (#5053): reinterpreting a 32-bit-only value (i32 / u32) as
    // `string` via `as` truncates a pointer once the heap exceeds 4 GiB. A
    // `usize` source is pointer-width and stays allowed.
    if (type_eq(tgt, t_string()) && cast_pointer_int(cot) && !is_usize(cot)) {
      return [e069_cast(u, cot, tgt)];
    }
    if (!as_cast_allowed(cot, tgt)) {
      return [e033_cast(u, cot, tgt)];
    }
    return none;
  }
  let unresolved: util.Diag[] = unresolved_cast_diags(u, tgt, cot, s);
  if (unresolved.len() > 0) {
    return unresolved;
  }
  if (type_contains_unknown(tgt) || type_contains_unknown(cot)) {
    return none;
  }
  if (cast_pointer_int(cot) && cast_pointer_shaped(tgt, false)) {
    if (!is_usize(cot)) {
      return [e069_cast(u, cot, tgt)];
    }
    return none;
  }
  if (!(cast_pointer_int(tgt) && cast_pointer_shaped(cot, true)) && !coercible(cot, tgt, s)) {
    return [e033_cast(u, cot, tgt)];
  }
  return none;
}

// Native treats an undeclared nominal cast destination as pointer-shaped.
// Keep an abstract type parameter distinct from that unresolved name.
function unresolved_cast_diags(u: ast.ExprUnary, tgt: typeinfo.Type, cot: typeinfo.Type, s: Scope): util.Diag[] {
  if let typeinfo.TypeUnknown(tu) = tgt {
    let name: string = typevar_reason_name(tu.reason);
    if (util.str_has_prefix(tu.reason, UNRESOLVED_MARK) && !util.has_str(s.tparams, name) && cast_pointer_int(cot) && !is_usize(cot)) {
      return [e069_cast(u, cot, t_struct(name))];
    }
  }
  return [];
}

function e069_cast(u: ast.ExprUnary, cot: typeinfo.Type, tgt: typeinfo.Type): util.Diag {
  return dg_at("E069", "reinterpreting a 32-bit " + type_label(cot) + " value as the pointer-shaped type " + type_label(tgt) + " via `as` truncates the address; carry pointer-shaped values in a usize local/param instead", u.line, u.col);
}

function e033_cast(u: ast.ExprUnary, cot: typeinfo.Type, tgt: typeinfo.Type): util.Diag {
  return dg_at("E033", "cannot cast " + type_label(cot) + " to " + type_label(tgt) + ": `as` converts only between numeric types", u.line, u.col);
}

// try_ret_other_type reports whether `ret`, the type a `?` propagates to, is
// resolved and is not the enum `name`: a type variable of the enclosing
// generic is resolved. An unresolved or still-inferred result says nothing.
function try_ret_other_type(ret: typeinfo.Type, name: string): boolean {
  if (is_type_variable(ret)) {
    return true;
  }
  match (ret) {
    typeinfo.TypeUnion(ru) => {
      return ru.name != name;
    },
    typeinfo.TypeVoid(_) => {
      return true;
    },
    _ => {
      return spellable(ret);
    }
  }
  return false;
}

// try_ret_label spells the type a `?` propagates to, a type variable by its name.
function try_ret_label(ret: typeinfo.Type): string {
  if (is_type_variable(ret)) {
    return callable_typevar_name(ret);
  }
  return type_label(ret);
}

// try_residual_diags: E042 for a `?` on a Result whose error type is not the
// function's and converts to it neither way native's checker allows: boxed
// into a `dyn` error type it implements, or through the function's error
// type's `from(E1)` constructor. Silent unless both error types resolved.
function try_residual_diags(s: Scope, src: typeinfo.Type, u: ast.ExprUnary): util.Diag[] {
  let out: util.Diag[] = [];
  let sr: typeinfo.Type = result_residual(src);
  let rr: typeinfo.Type = result_residual(s.try_ret);
  if (!spellable(sr) || !spellable(rr) || type_eq(sr, rr)) {
    return out;
  }
  let sl: string = util.demangle_all(type_label(sr));
  let rl: string = util.demangle_all(type_label(rr));
  if let typeinfo.TypeDyn(d) = rr {
    if (dyn_conforms(sr, rr, s)) {
      return out;
    }
    return out.append(dg_at("E042", "`?` cannot box " + sl + " into " + rl + ": " + sl + " does not implement " + unimplemented_traits(s, sr, d.traits), u.line, u.col));
  }
  if (from_converts(s, sr, rr)) {
    return out;
  }
  return out.append(dg_at("E042", "`?` on Result carrying " + sl + " but the surrounding function carries " + rl + ", and " + rl + " has no `from(" + sl + ")` constructor to convert it (std/convert's `impl From[" + sl + "] for " + rl + "`)", u.line, u.col));
}

// unimplemented_traits names the traits of the dyn set `traits` that `src`
// does not implement, joined by ` + ` as native's missingDynTraits does: the
// set's first when `src` is a type no impl can name (a dyn or an array).
function unimplemented_traits(s: Scope, src: typeinfo.Type, traits: string): string {
  let set: string[] = parser.dyn_trait_set("dyn " + traits);
  if (is_owned_array(src) || is_arr_view(src) || is_dyn_slot(src)) {
    return util.demangle_all(set[0]);
  }
  let tn: string = util.base_type_name(type_label(src));
  let missing: string = "";
  for tr in set {
    if (!conforms_to_dyn_trait(s, tn, tr)) {
      if (missing.len() > 0) {
        missing = missing + " + ";
      }
      missing = missing + util.demangle_all(tr);
    }
  }
  if (missing.len() == 0) {
    return util.demangle_all(set[0]);
  }
  return missing;
}

// result_residual is a Result type's error argument, unknown for any other.
function result_residual(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(tu) = t {
    if (tu.name == "Result" && tu.args.len() == 2) {
      return tu.args[1];
    }
  }
  return t_unknown("not a Result");
}

// from_converts reports whether the nominal type `to` has an associated
// `from` taking `from_t`. A parameter this checker could not resolve counts.
function from_converts(s: Scope, from_t: typeinfo.Type, to: typeinfo.Type): boolean {
  let owner: string = struct_name_of(to);
  if let typeinfo.TypeUnion(tu) = to {
    owner = tu.name;
  }
  if (owner.len() == 0) {
    return false;
  }
  let sig: FuncSig = s.lookup_assoc_sig(owner, "from");
  if (sig.name.len() == 0 || sig.param_types.len() != 1) {
    return false;
  }
  return !spellable(sig.param_types[0]) || type_eq(sig.param_types[0], from_t);
}

function call_diags_array(a: ast.ExprArray, s: Scope, out: util.Diag[]): util.Diag[] {
  for element in a.elements {
    out = util.append_diags(out, call_diags(element, s));
  }
  return array_mix_diags(a, s, out);
}

function array_mix_diags(a: ast.ExprArray, s: Scope, out: util.Diag[]): util.Diag[] {
  // E034: heterogeneous array literal. The element type starts at the
  // first element's and, as native's unifyIfArms does, an unsuffixed
  // literal gives way to a concrete sibling: an integer literal to any
  // integer or float, a float literal to any float. The first element that
  // fits neither way is flagged. Callable and tuple elements compare their
  // complete shape; generic structs use literal-aware comparison below.
  if (a.elements.len() >= 2) {
    let anchor: typeinfo.Type = check_expr(a.elements[0], s);
    if (type_contains_unknown(anchor)) {
      return out;
    }
    let anchor_lit: i32 = numeric_literal_kind(a.elements[0]);
    if (is_primitive_type(anchor) || is_func_type(anchor) || is_tuple_type(anchor)) {
      let k: i32 = 1;
      let flagged: boolean = false;
      while (k < a.elements.len() && !flagged) {
        let etk: typeinfo.Type = check_expr(a.elements[k], s);
        let lit: i32 = numeric_literal_kind(a.elements[k]);
        if (!type_contains_unknown(etk) && !literal_gives_way(lit, anchor)) {
          if (same_element_type(etk, anchor) || literal_gives_way(anchor_lit, etk)) {
            anchor = etk;
            anchor_lit = lit;
          } else {
            out = out.append(dg_at("E034", "array element: expected " + type_label(anchor) + ", got " + type_label(etk), expr_line(a.elements[k]), expr_col(a.elements[k])));
            flagged = true;
          }
        }
        k = k + 1;
      }
    } else if (concrete_instance(anchor)) {
      out = struct_instance_mix(a, anchor, s, out);
    }
  }

  return out;
}

// E034 for two instantiations of one generic struct, `Same[i32]` beside a
// `Same[string]`. type_eq ignores a struct's arguments, so they are compared
// by spelling. The first element that neither takes nor gives way to the
// other (struct_lit_gives_way) is flagged, as native's unifyIfArms does.
function struct_instance_mix(a: ast.ExprArray, first: typeinfo.Type, s: Scope, out: util.Diag[]): util.Diag[] {
  let anchor: typeinfo.Type = first;
  let anchor_expr: ast.Expr = a.elements[0];
  let k: i32 = 1;
  while (k < a.elements.len()) {
    let etk: typeinfo.Type = check_expr(a.elements[k], s);
    if (concrete_instance(etk) && struct_name_of(etk) == struct_name_of(anchor) && typeinfo.spelling(etk) != typeinfo.spelling(anchor)) {
      if (struct_lit_yields(anchor_expr, anchor, etk, s, true)) {
        anchor = etk;
        anchor_expr = a.elements[k];
      } else if (!struct_lit_yields(a.elements[k], etk, anchor, s, true)) {
        return out.append(dg_at("E034", "array element: expected " + type_label(anchor) + ", got " + type_label(etk), expr_line(a.elements[k]), expr_col(a.elements[k])));
      }
    }
    k = k + 1;
  }
  return out;
}

// A generic struct instantiated at arguments with nothing left to infer.
function concrete_instance(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(st) = t {
    return st.args.len() > 0 && !type_contains_unknown(t);
  }
  return false;
}

function struct_name_of(t: typeinfo.Type): string {
  if let typeinfo.TypeStruct(st) = t {
    return st.name;
  }
  return "";
}

function call_diags_index(ix: ast.ExprIndex, s: Scope, out: util.Diag[]): util.Diag[] {
  out = util.append_diags(call_diags(ix.array, s), call_diags(ix.index, s));
  // E034: an array / string index must be an integer. A missing / unknown
  // index type is skipped (no cascade).
  let ixt: typeinfo.Type = check_expr(ix.index, s);
  if (!is_unknown(ixt) && !is_integer(ixt)) {
    out = out.append(dg_at("E034", "index must be an integer, got " + type_label(ixt), expr_line(ix.index), expr_col(ix.index)));
  }
  // E034: the indexed value must be an array or string. Mirrors the Go
  // checker ("indexing non-array value"); a non-array/string (i32 /
  // struct / map / …) operand is rejected. Unknown is skipped.
  let iarrt: typeinfo.Type = check_expr(ix.array, s);
  let idxable: boolean = false;
  match (iarrt) {
    typeinfo.TypeArray(_) => {
      idxable = true;
    },
    typeinfo.TypeString(_) => {
      idxable = true;
    },
    _ => {}
  }
  if (!is_unknown(iarrt) && !idxable && !generic_fn_value_arg(ix.array, s)) {
    out = out.append(dg_at("E034", "indexing non-array value of type " + type_label(iarrt), ix.line, ix.col));
  }

  return out;
}

function call_diags_slice(s2: ast.ExprSlice, s: Scope, out: util.Diag[]): util.Diag[] {
  out = util.append_diags(call_diags(s2.array, s), call_diags(s2.start, s));
  // E037: a present slice bound must be i32.
  let sbt: typeinfo.Type = check_expr(s2.start, s);
  if (!is_unknown(sbt) && !type_eq(sbt, t_i32())) {
    out = out.append(dg_at("E037", "slice low bound must be i32, got " + type_label(sbt), expr_line(s2.start), expr_col(s2.start)));
  }
  // An open-ended `s[a:]` / `s[:]` writes no high bound: `end` holds a
  // placeholder the lowering never evaluates, so diagnosing it would
  // report on source the programmer did not write.
  if (!s2.open_end) {
    out = util.append_diags(out, call_diags(s2.end, s));
    let ebt: typeinfo.Type = check_expr(s2.end, s);
    if (!is_unknown(ebt) && !type_eq(ebt, t_i32())) {
      out = out.append(dg_at("E037", "slice high bound must be i32, got " + type_label(ebt), expr_line(s2.end), expr_col(s2.end)));
    }
  }
  // E037: the sliced value must be an array or string. Mirrors the Go
  // checker ("cannot slice value of type T").
  let sarrt: typeinfo.Type = check_expr(s2.array, s);
  let sliceable: boolean = false;
  match (sarrt) {
    typeinfo.TypeArray(_) => {
      sliceable = true;
    },
    typeinfo.TypeString(_) => {
      sliceable = true;
    },
    _ => {}
  }
  if (!is_unknown(sarrt) && !sliceable) {
    out = out.append(dg_at("E037", "cannot slice value of type " + type_label(sarrt), expr_line(s2.array), expr_col(s2.array)));
  }

  return out;
}

function call_diags_field_access(fa: ast.ExprFieldAccess, s: Scope, out: util.Diag[]): util.Diag[] {
  // A qualified reference `Enum.Variant` — the object names a declared
  // enum/union (registered as a UnionSig) or a built-in enum (Option /
  // Result / …). This is NOT a value field-read: the object is a type
  // qualifier, not a resolvable value, so recursing into it would
  // mis-fire E001 ("undefined name"). When the field IS one of the
  // enum's variants the reference is well-formed and silent (the Go
  // checker accepts `O.None` / `Color.Red`); when it ISN'T, it's a
  // bad qualified variant — E036, matching Go ("enum X has no variant
  // Y"). Either way the object recursion is skipped. A name bound as a
  // local shadows the enum, so it's a genuine field access — left to
  // the normal path. (Module-qualified names like `parser.Foo` never
  // reach here — modload mangles them to bare names before checking.)
  let qen: string = qual_enum_name(fa.obj, s);
  if (qen.len() > 0) {
    if (!qual_variant_exists(qen, fa.field, s)) {
      out = out.append(no_variant_diag(s, qen, fa.field, fa.line, fa.col));
    } else {
      let payloads: i32 = variant_value_payloads(s, qen, fa.field);
      if (payloads > 0) {
        out = out.append(payload_variant_value_diag(shown_enum(s, qen) + "." + shown_variant(s, qen + "." + fa.field), payloads, fa.line, fa.col));
      }
    }
    return out;
  }
  out = call_diags(fa.obj, s);
  // E043: a field READ on a struct that has no such field. Method-call
  // callees never reach here (the ExprCall arm above recurses only into
  // the object), so a field access here is a genuine read, and a method
  // of that name is not a value it can read.
  let ot: typeinfo.Type = check_expr(fa.obj, s);
  match (ot) {
    typeinfo.TypeStruct(sn) => {
      let fsig: StructSig = s.lookup_struct(sn.name);
      out = util.append_diags(out, opaque_access_diags(fsig, s, "access a field of", fa.line, fa.col));
      if (fsig.name.len() > 0 && !util.has_str(fsig.field_names, fa.field)) {
        out = out.append(s.member_fix(dg_at("E043", "struct " + util.demangle(sn.name) + " has no field or method \"" + fa.field + "\"", fa.line, fa.col), fa, fsig));
      }
    },
    typeinfo.TypeTuple(tt) => {
      out = util.append_diags(out, tuple_field_diags(fa.field, tt, fa.line, fa.col));
    },
    _ => {
      // E043: a field READ on a non-struct, non-tuple value (an i32 /
      // string / array / … has no fields). Mirrors the Go checker
      // (`tt` not a StructType -> "field access on non-struct value").
      // An unknown object type is skipped (no cascade). This is a
      // genuine read; method calls (`x.m()`) are an ExprCall callee and
      // never reach here.
      if (!is_unknown(ot)) {
        out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice(method_namespace_of(ot), fa.field, ot), fa.line, fa.col), fa, ot));
      }
    }
  }

  return out;
}

// tuple_field_diags is E046 for `t.field` on a tuple: the field must be a
// numeric index in range. A method-call callee takes the same rule, since a
// tuple has no methods; `t.0()` calls the function its element holds.
function tuple_field_diags(field: string, tt: typeinfo.TypeTuple, line: i32, col: i32): util.Diag[] {
  let idx: i32 = digit_string_to_i32(field);
  if (idx < 0) {
    return [dg_at("E046", "tuple field access requires a numeric index, got \"" + field + "\"", line, col)];
  }
  if (idx >= tt.elements.len()) {
    return [dg_at("E046", "tuple has " + util.i32_to_string(tt.elements.len()) + " elements; index " + util.i32_to_string(idx) + " is out of range", line, col)];
  }
  return [];
}

// `dest_args` are the literal's type arguments where its destination names
// them. Without them a generic literal's own are used (struct_lit_args), so a
// field that contradicts an earlier one is refused as native refuses it.
function call_diags_struct_lit(sl: ast.ExprStructLit, dest_args: typeinfo.Type[], s: Scope, out: util.Diag[]): util.Diag[] {
  let fsig: StructSig = s.lookup_struct(sl.type_name);
  out = util.append_diags(out, opaque_access_diags(fsig, s, "construct", sl.line, sl.col));
  let args: typeinfo.Type[] = dest_args;
  // The literal's own instantiation outranks its destination's, as natively;
  // a disagreement between the two is the assignment's to report.
  if (sl.written.len() > 0 && fsig.name.len() > 0) {
    let wn: i32 = parser.parse_type_ref(sl.written).args.len();
    if (wn != fsig.type_params.len()) {
      out = out.append(dg_at("E040", util.arity_message(fsig.name, fsig.type_params.len(), wn, "type argument"), sl.line, sl.col));
    } else {
      args = written_struct_args(sl, fsig, s);
    }
  }
  // A struct-update base's instantiation outranks the written one, as
  // natively: `Pair[i32] { ...p, a: "x" }` with `p: Pair[string]` is a
  // Pair[string].
  if (sl.has_base && fsig.type_params.len() > 0) {
    if let typeinfo.TypeStruct(bst) = check_expr(sl.base, s) {
      if (bst.args.len() == fsig.type_params.len()) {
        args = bst.args;
      }
    }
  }
  if (args.len() == 0 && fsig.type_params.len() > 0) {
    args = struct_lit_args(sl, fsig, s);
    let utp: string = lit_uninferable_param(sl, fsig, args, s);
    if (utp.len() > 0) {
      out = out.append(dg_at("E040", "could not infer type parameter " + utp + " for struct " + sl.type_name + " — supply it explicitly at the construction site (e.g. " + sl.type_name + "[i32] { ... }) or annotate the binding (e.g. let x: " + sl.type_name + "[i32] = ...)", sl.line, sl.col));
    }
  }
  let vi: i32 = 0;
  while (vi < sl.field_values.len()) {
    let fdest: typeinfo.Type = t_unknown("no declared field");
    if (fsig.name.len() > 0 && vi < sl.field_names.len() && field_index(fsig, sl.field_names[vi]) >= 0) {
      fdest = lit_field_type(fsig, field_index(fsig, sl.field_names[vi]), args, s);
    }
    out = util.append_diags(out, dest_call_diags(sl.field_values[vi], fdest, s));
    vi = vi + 1;
  }
  if (sl.has_base) {
    out = util.append_diags(out, call_diags(sl.base, s));
    let bt: typeinfo.Type = check_expr(sl.base, s);
    if (!is_unknown(bt) && !type_eq(bt, t_struct(sl.type_name))) {
      out = out.append(dg_at("E003", "struct-update base must be " + sl.type_name + ", got " + type_label(bt), expr_line(sl.base), expr_col(sl.base)));
    }
  }
  // E007: the same field initialised twice in one literal
  // (`Point { x: 1, x: 2, y: 3 }`). The declaration sibling of this
  // check already refuses a struct that DECLARES a name twice; a
  // literal that SETS one twice reached lowering, which keeps the last
  // write and silently drops the first. Reported at the literal, as
  // native reports it at the literal's own position, and independent of
  // whether the struct resolves — a repeat is a repeat.
  let seen_fields: string[] = [];
  for fname in sl.field_names {
    if (util.index_of_str(seen_fields, fname) >= 0) {
      out = out.append(dg_at("E007", "duplicate field \"" + fname + "\" in struct literal", sl.line, sl.col));
    } else {
      seen_fields = seen_fields.append(fname);
    }
  }
  // E043: a provided field's value must be assignable to the
  // declared field type. Only for a known struct; an unresolved
  // value type (`unknown`) is skipped, as is any field name not
  // in the declaration (E005 / unknown-field paths own those).
  let ssig: StructSig = s.lookup_struct(sl.type_name);
  if (ssig.name.len() > 0) {
    let fi: i32 = 0;
    while (fi < sl.field_names.len()) {
      let fidx: i32 = field_index(ssig, sl.field_names[fi]);
      if (fidx >= 0) {
        let ft: typeinfo.Type = lit_field_type(ssig, fidx, args, s);
        let vt: typeinfo.Type = check_expr(sl.field_values[fi], s);
        out = util.append_diags(out, int_dest_range_diags(sl.field_values[fi], ft));
        out = util.append_diags(out, ctor_payload_diags(sl.field_values[fi], ft, s));
        if (!is_unknown(ft) && !is_unknown(vt) && !settles_to(sl.field_values[fi], ft, s) && !coercible(vt, ft, s)) {
          out = out.append(dg_at("E043", "field \"" + sl.field_names[fi] + "\": expected " + type_label(ft) + ", got " + type_label(vt) + str_copy_hint(vt, ft), expr_line(sl.field_values[fi]), expr_col(sl.field_values[fi])));
        }
        // E034: a struct-literal field of composite-array type
        // whose value is an array literal — its elements checked
        // against the field's declared element type. The array as
        // a whole is assignable to the field type, so the E043
        // above stays silent; this catches a bad element. Same
        // composite-only + union-widening discipline as the other
        // positions; runs for plain and update (`...base`) literals.
        out = util.append_diags(out, array_elem_check(array_elem_type_of(ft), sl.field_values[fi], s));
      }
      fi = fi + 1;
    }
  }

  return out;
}

// lambda_body_scope is the scope a lambda's body is checked in: the enclosing
// scope (lexical capture) plus the lambda's own parameters, so a reference to
// one is not an undefined name, with the return type the lambda declares — or
// INFERRED_RESULT when it declares none — so a `return` inside it is checked against
// the lambda rather than the enclosing function. The semantic phase reads the
// type of what the body returns in it when the lambda spells no result.
pub function lambda_body_scope(lm: ast.ExprLambda, s: Scope): Scope {
  let lsc: Scope = s;
  for param in lm.params {
    lsc = lsc.bind(param.name, s.resolve_param(param));
  }
  if (parser.is_value_block_origin(lm.origin)) {
    return lsc.with_block_ret(lambda_ret_type(lm, s));
  }
  return lsc.with_ret_type(lambda_ret_type(lm, s));
}

function call_diags_lambda(lm: ast.ExprLambda, s: Scope, out: util.Diag[]): util.Diag[] {
  if (parser.is_written_lambda_origin(lm.origin)) {
    out = util.append_diags(out, capture_view_diags(lm, s));
    out = util.append_diags(out, lambda_lane_diags(lm, s));
  }
  return util.append_diags(out, stmts_call_diags(lm.body, lambda_body_scope(lm, s)));
}

// lambda_lane_diags is E085 for a lambda: a function value carries no lane
// value, so a lambda neither takes, returns nor captures one.
function lambda_lane_diags(lm: ast.ExprLambda, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (lanes_inside(check_lambda_expr(lm, s))) {
    out = out.append(dg_at("E085", "a lambda cannot take or return a lane value; a lane value crosses only a direct call", lm.line, lm.col));
  }
  let seen: string[] = [];
  for name in astwalk.collect_lambda_idents(lm, []) {
    if (!util.has_str(seen, name) && s.is_bound(name) && is_lanes(s.lookup(name))) {
      out = out.append(dg_at("E085", "a lambda cannot capture \"" + name + "\" of type " + util.demangle_all(type_label(s.lookup(name))) + "; a lane value lives only in a local, a parameter or a result", lm.line, lm.col));
    }
    seen = seen.append(name);
  }
  return out;
}

// capture_view_diags is E082, native's captureView: a closure may not capture
// a value holding a borrowed view. A function value's type does not say what
// its environment holds, so a view captured into one would leave every escape
// rule unable to see it. A nested lambda's captures count as the enclosing
// one's too, as they do natively.
function capture_view_diags(lm: ast.ExprLambda, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let seen: string[] = [];
  for name in astwalk.collect_lambda_idents(lm, []) {
    if (util.has_str(seen, name)) {
      continue;
    }
    seen = seen.append(name);
    if (!s.is_bound(name)) {
      continue;
    }
    let (holds, _) = type_holds_view(s.lookup(name), s, []);
    if (holds) {
      out = out.append(dg_at("E082", "closure captures \"" + name + "\", which holds a borrowed view: a function value's environment cannot carry a view — copy it into an owned value before the closure (`.to_owned()` on a `str`)", lm.line, lm.col));
    }
  }
  return out;
}

// type_holds_view mirrors native typeHoldsView: whether a value of `t` carries
// a `str`, a `[T]` slice or a `MapIter` cursor, directly or through an element,
// field, payload or type argument. `seen` names every struct and enum already
// entered, across the whole walk as natively, and comes back grown.
function type_holds_view(t: typeinfo.Type, s: Scope, seen: string[]): (boolean, string[]) {
  if (is_str_view(t) || is_arr_view(t)) {
    return (true, seen);
  }
  if let typeinfo.TypeArray(a) = t {
    return type_holds_view(a.elem, s, seen);
  }
  if let typeinfo.TypeTuple(tup) = t {
    return any_holds_view(tup.elements, s, seen);
  }
  if let typeinfo.TypeMap(m) = t {
    return any_holds_view([m.key, m.value], s, seen);
  }
  if let typeinfo.TypeStruct(st) = t {
    if (st.name == "MapIter") {
      return (true, seen);
    }
    if (util.has_str(seen, st.name)) {
      return (false, seen);
    }
    let (in_args, after) = any_holds_view(st.args, s, seen.append(st.name));
    if (in_args) {
      return (true, after);
    }
    return any_holds_view(s.lookup_struct(st.name).field_types, s, after);
  }
  if let typeinfo.TypeUnion(u) = t {
    if (util.has_str(seen, u.name)) {
      return (false, seen);
    }
    let (in_args, after) = any_holds_view(u.args, s, seen.append(u.name));
    if (in_args) {
      return (true, after);
    }
    for v in s.lookup_union(u.name).variants {
      let (in_payload, next) = any_holds_view(variant_shape_sig(s, v, u.name).field_types, s, after);
      if (in_payload) {
        return (true, next);
      }
      after = next;
    }
    return (false, after);
  }
  return (false, seen);
}

function any_holds_view(ts: typeinfo.Type[], s: Scope, seen: string[]): (boolean, string[]) {
  let at: string[] = seen;
  for t in ts {
    let (found, next) = type_holds_view(t, s, at);
    if (found) {
      return (true, next);
    }
    at = next;
  }
  return (false, at);
}

function call_diags_ident(id: ast.ExprIdent, s: Scope, out: util.Diag[]): util.Diag[] {
  // E036: a payload-bearing variant referenced bare — a union member
  // (`type U = P | Q`, P a struct), an enum variant with a payload
  // (`A(i32)`) or Some / Ok / Err used as a value WITHOUT calling its
  // constructor; a nullary variant stays a valid bare value. The
  // constructor CALL form (`P(...)` / `A(5)`) is an ExprCall callee
  // handled elsewhere, so it isn't flagged. Checked before E001 — these
  // names DO resolve (as variants), so is_resolvable_value would
  // otherwise let them pass silently.
  //
  // A BINDING of the same name shadows the variant, and then the read
  // is of the local — `let Wrap = 3; return Wrap;` is native-clean.
  // check_expr's ExprIdent arm gets that right by returning the
  // binding before it ever consults the variant tables; this arm does
  // no lookup at all, so it needs the shadowing test spelled out. The
  // sibling rules already gate on exactly this (the qualified-ref
  // detection and vref_expr's ambiguity rule). #6658.
  let payloads: i32 = 0;
  if (!s.known(id.name) && !s.has_sig(id.name)) {
    payloads = variant_value_payloads(s, "", id.name);
  }
  if (payloads > 0) {
    out = out.append(payload_variant_value_diag(shown_variant(s, id.name), payloads, id.line, id.col));
  } else if (!s.known(id.name) && !s.is_bound(id.name) && generic_fn_value(s.lookup_sig(id.name))) {
    out = out.append(generic_fn_value_diag(id, s.lookup_sig(id.name)));
  } else if (lane_fn_value(id, s)) {
    out = out.append(dg_at("E085", "function " + id.name + " takes or returns a lane value and cannot be used as a value; a lane value crosses only a direct call", id.line, id.col));
  } else if (!is_resolvable_value(id.name, s)) {
    // E001: a bare identifier in VALUE position that resolves to
    // nothing — not a local / param / loop / match binding, a free
    // function or const, an enum/union variant (declared or
    // builtin), or any other value. Call callees are handled in the
    // ExprCall arm (a bare-ident callee is skipped here), so this
    // fires only on value reads, matching where the Go checker's
    // errIdent reports E001.
    out = out.append(undefined_name(id.name, s, id.line, id.col));
  }

  return out;
}

// fn_value_binds is what the callable `dest` binds of the type parameters of
// the generic `sig` named as a value there: each parameter's spelling and the
// result's unified against `dest`'s, every one of them at most once.
function fn_value_binds(sig: FuncSig, dest: typeinfo.TypeFunc, s: Scope): (string[], typeinfo.Type[]) {
  let ns: string[] = [];
  let ts: typeinfo.Type[] = [];
  if (!dest.params_known || dest.param_types.len() != sig.param_type_names.len()) {
    return (ns, ts);
  }
  let i: i32 = 0;
  while (i < dest.param_types.len()) {
    let (pn, pt) = gc_bind_param(sig_param_ref(sig, i), dest.param_types[i], sig.all_type_params, s.type_names(), ns, ts);
    ns = pn;
    ts = pt;
    i = i + 1;
  }
  let (rn, rt) = gc_bind_param(sig_ret_ref(sig), dest.ret_type, sig.all_type_params, s.type_names(), ns, ts);
  return (rn, rt);
}

// fn_value_instance is the signature of the generic function `sig` with its
// type variables bound as `bn` / `bt` bind them.
function fn_value_instance(sig: FuncSig, bn: string[], bt: typeinfo.Type[], s: Scope): typeinfo.TypeFunc {
  let params: typeinfo.Type[] = [];
  let i: i32 = 0;
  while (i < sig.param_type_names.len()) {
    params = params.append(type_from_ref_subst(sig_param_ref(sig, i), bn, bt, s.type_names()));
    i = i + 1;
  }
  let result: typeinfo.Type = type_from_ref_subst(sig_ret_ref(sig), bn, bt, s.type_names());
  return typeinfo.TypeFunc { param_types: params, param_own: callable_own_flags(sig.param_own, params.len()), ret_type: result, params_known: true };
}

// fn_value_settles reports whether the callable `want` binds every type
// parameter of the generic function `e` names, to a known type or to a type
// variable of the enclosing generic.
function fn_value_settles(e: ast.Expr, want: typeinfo.TypeFunc, s: Scope): boolean {
  if let ast.ExprIdent(id) = e {
    let sig: FuncSig = s.lookup_sig(id.name);
    let (bn, bt) = fn_value_binds(sig, want, s);
    for tp in sig.all_type_params {
      let at: i32 = util.index_of_str(bn, tp);
      if (at < 0 || unknown_beyond_tvars(bt[at])) {
        return false;
      }
    }
    let inst: typeinfo.TypeFunc = fn_value_instance(sig, bn, bt, s);
    let result: typeinfo.Type = inst.ret_type;
    // A result the callable leaves open, as a method's own type parameter
    // is, takes what the function gives.
    if (is_unknown(want.ret_type)) {
      result = want.ret_type;
    }
    let actual: typeinfo.Type = t_func_own(inst.param_types, sig.param_own, result);
    // A method's unbound result variable can take the instantiated result.
    // A variable of the enclosing function remains a fixed contract.
    if (is_unknown(want.ret_type) && !util.has_str(s.tparams, callable_typevar_name(want.ret_type))) {
      return type_assignable(actual, typeinfo.TypeFunc { ...want, ret_type: result }, s.unions.unions);
    }
    return type_assignable(actual, want, s.unions.unions);
  }
  return false;
}

// A generic callback takes the known parameter types before it binds a method result.
function fn_value_at(e: ast.Expr, dest: typeinfo.Type, s: Scope): typeinfo.Type {
  if (generic_fn_value_arg(e, s)) {
    if let ast.ExprIdent(id) = e {
      if let typeinfo.TypeFunc(want) = dest {
        let sig = s.lookup_sig(id.name);
        let (names, types) = fn_value_binds(sig, want, s);
        return fn_value_instance(sig, names, types, s);
      }
    }
  }
  return check_expr(e, s);
}

// generic_fn_value_arg reports whether `e` names a generic function as a
// value: an identifier bound to nothing, naming a generic signature.
function generic_fn_value_arg(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprIdent(id) = e {
    return !s.known(id.name) && !s.is_bound(id.name) && generic_fn_value(s.lookup_sig(id.name));
  }
  return false;
}

// bound_param_dest is parameter `di` of the call `c`'s callee with the
// callee's type variables bound as the call binds them; `dest` when the
// callee is not a generic function or the parameter has no spelling.
function bound_param_dest(c: ast.ExprCall, di: i32, dest: typeinfo.Type, s: Scope): typeinfo.Type {
  if let ast.ExprIdent(cid) = c.callee {
    let sig: FuncSig = s.lookup_sig(cid.name);
    if (s.defines(cid.name) || sig.all_type_params.len() == 0 || di >= sig.param_type_names.len()) {
      return dest;
    }
    let (bn, bt) = call_type_bindings(sig, c, s);
    return type_from_ref_subst(sig_param_ref(sig, di), bn, bt, s.type_names());
  }
  return dest;
}

// generic_fn_value: a generic function named where a value is expected. No
// instantiation reaches such a use, so nothing determines its type
// parameters; native refuses it with E040 (#7040).
function generic_fn_value(sig: FuncSig): boolean {
  return sig.name.len() > 0 && !sig.is_const && sig.all_type_params.len() > 0;
}

// lane_fn_value: `id` names a function whose signature holds a lane type,
// where a value is expected. A function value carries no lane value (E085).
function lane_fn_value(id: ast.ExprIdent, s: Scope): boolean {
  if (s.known(id.name) || s.is_bound(id.name)) {
    return false;
  }
  let sig: FuncSig = s.lookup_sig(id.name);
  return sig.name.len() > 0 && !sig.is_const && (any_holds_lanes(sig.param_types) || holds_lanes(sig.ret_type));
}

// generic_fn_value_diag spells native's E040, whose hint eta-expands the
// declaration's own parameters.
function generic_fn_value_diag(id: ast.ExprIdent, sig: FuncSig): util.Diag {
  let tps: string = comma_list(sig.all_type_params);
  let plural: string = "";
  if (sig.all_type_params.len() > 1) {
    plural = "s";
  }
  let params: string[] = [];
  let i: i32 = 0;
  while (i < sig.param_names.len()) {
    let pt: string = "";
    if (i < sig.param_type_names.len()) {
      pt = sig.param_type_names[i];
    }
    params = params.append(sig.param_names[i] + ": " + pt);
    i = i + 1;
  }
  return dg_at("E040", "generic function " + id.name + " cannot be used as a value — nothing here determines its type parameter" + plural + " " + tps + ". Wrap it in a lambda, which does: (" + comma_list(params) + ") => " + id.name + "(" + comma_list(sig.param_names) + ")", id.line, id.col);
}

function comma_list(xs: string[]): string {
  let out: string = "";
  for x in xs {
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + x;
  }
  return out;
}

function param_decl_names(params: ast.ParamDecl[]): string[] {
  let out: string[] = [];
  for pd in params {
    out = out.append(pd.name);
  }
  return out;
}

// is_collection_mutator names the value-returning collection methods whose
// result must be used — the immutable-looking vocabulary
// (docs/PURE-COLLECTION-API-PLAN.md §3a). Mirrors the Go checker's
// pureCollectionMutators set.
function is_collection_mutator(field: string): boolean {
  return field == "insert" || field == "remove" || field == "cleared" || field == "with" || field == "append";
}

// e055_diag reports E055 when a bare statement is a value-returning collection
// mutator whose result is discarded (`m.insert(k, v);`, `arr.append(x);`, …).
// Under CoW that silently loses the write the moment an alias exists
// (docs/PURE-COLLECTION-API-PLAN.md §1); the result must be threaded back
// (`m = m.insert(k, v)`) or explicitly dropped (`let _ = …`). Only fires when
// the receiver is a Map or array, so a user method that happens to share the
// name (e.g. HeaderMap.append) is left alone — matching the Go checker's
// narrow scope.
function e055_diag(e: ast.Expr, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if (!is_collection_mutator(fa.field)) {
            return none;
          }
          let is_coll: boolean = false;
          match (check_expr(fa.obj, s)) {
            typeinfo.TypeMap(_) => {
              is_coll = true;
            },
            typeinfo.TypeArray(array) => {
              is_coll = !array.view;
            },
            _ => {}
          }
          if (!is_coll) {
            return none;
          }
          let d: util.Diag[] = [dg_at("E055", "result of `." + fa.field + "(...)` is unused; assign it back (e.g. `x = x." + fa.field + "(...)`) — collection operations return a new value, they do not mutate in place (use `let _ = …` to discard intentionally)", fa.line, fa.col)];
          return d;
        },
        _ => {
          return none;
        }
      }
    },
    _ => {
      return none;
    }
  }
  return none;
}

// stmts_call_diags walks a statement list, threading scope (so a callee
// name shadowed by a local `let` is recognised as a local, not the
// function) and collecting the E004s from every expression.
// array_elem_type_of returns t's array element type, or `unknown` when t
// isn't an array — the "expected element" feeding array_elem_check.
function array_elem_type_of(t: typeinfo.Type): typeinfo.Type {
  match (t) {
    typeinfo.TypeArray(ad) => {
      return ad.elem;
    },
    _ => {
      return t_unknown("not an array");
    }
  }
  return t_unknown("not an array");
}

// array_elem_check is the position-independent core of the typed
// composite-array E034: given the EXPECTED element type and an expression
// that may be an array literal, flag (E034) every element not assignable
// to it. Scoped to COMPOSITE element types — primitive-element arrays are
// covered by the first-element-anchored E034 in call_diags, so they're
// skipped here to avoid a duplicate. Uses the union-widening
// type_assignable, so a heterogeneous-but-widening literal (a `Stmt[]` of
// distinct variant structs) stays clean. Reused from every position where
// the expected element type is statically known: a `: T[]` let binding, a
// `T[]`-returning function's `return`, an assignment to a `T[]` variable,
// and a `T[]` call argument.
function array_elem_check(elem_ty: typeinfo.Type, init: ast.Expr, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (!is_dyn_slot(elem_ty) && !is_str_view(elem_ty)) {
    if let typeinfo.TypeUnion(_) = elem_ty {} else {
      if let typeinfo.TypeStruct(_) = elem_ty {} else {
        return out;
      }
    }
  }
  match (init) {
    ast.ExprArray(arr) => {
      for element in arr.elements {
        let ekt: typeinfo.Type = check_expr(element, s);
        if (!is_unknown(ekt) && !settles_to(element, elem_ty, s) && !coercible(ekt, elem_ty, s) && dest_bound_diags(element, elem_ty, s).len() == 0) {
          out = out.append(dg_at("E034", "array element: expected " + type_label(elem_ty) + ", got " + type_label(ekt), expr_line(element), expr_col(element)));
        }
      }
    },
    _ => {}
  }
  return out;
}

// lit_field_type is field `fi`'s declared type, substituted with a generic
// struct's arguments when there are as many as it has parameters.
function lit_field_type(ssig: StructSig, fi: i32, args: typeinfo.Type[], s: Scope): typeinfo.Type {
  if (args.len() == 0 || args.len() != ssig.type_params.len() || fi >= ssig.field_type_names.len()) {
    return ssig.field_types[fi];
  }
  return type_from_ref_subst(parser.parse_type_ref(ssig.field_type_names[fi]), ssig.type_params, args, s.type_names());
}

// The call walk of an expression bound to a destination of type `dest`. An
// array literal whose destination names a composite element type has each
// element checked against that type by `array_elem_check`, so the literal's
// own first-element-anchored E034 stands down: `[1, "a"]` is a valid
// `dyn Show[]` (#10097).
function dest_call_diags(e: ast.Expr, dest: typeinfo.Type, s: Scope): util.Diag[] {
  // A generic function named as a value where a callable is wanted takes its
  // type arguments from that callable: the monomorphiser clones it for them
  // (parser.mono_fn_value). Only a callable that binds every one of them
  // escapes E040.
  if let ast.ExprCall(c) = e {
    return call_diags_call(c, s, [], dest);
  }
  if let ast.ExprIdent(id) = e {
    if let typeinfo.TypeFunc(df) = dest {
      if (!s.known(id.name) && !s.is_bound(id.name) && generic_fn_value(s.lookup_sig(id.name))) {
        let sig: FuncSig = s.lookup_sig(id.name);
        let (bn, bt) = fn_value_binds(sig, df, s);
        if (bn.len() == sig.all_type_params.len()) {
          return call_bound_diags(sig.type_params, sig.type_bounds, sig.module, util.demangle(sig.name), bn, bt, s, id.line, id.col);
        }
      }
    }
  }
  if let ast.ExprStructLit(sl) = e {
    if let typeinfo.TypeStruct(ds) = dest {
      if (ds.name == sl.type_name) {
        return call_diags_struct_lit(sl, ds.args, s, []);
      }
    }
  }
  let elem: typeinfo.Type = array_elem_type_of(dest);
  // A `str[]` destination types the literal too: each element is read at
  // `str`, so a string literal widens beside a view (#10889).
  if (is_str_view(elem)) {
    if let ast.ExprArray(sa) = e {
      let out: util.Diag[] = [];
      for element in sa.elements {
        out = util.append_diags(out, call_diags(element, s));
        let et: typeinfo.Type = check_expr(element, s);
        if (!is_unknown(et) && !coercible(et, elem, s)) {
          out = out.append(dg_at("E034", "array element: expected " + type_label(elem) + ", got " + type_label(et), expr_line(element), expr_col(element)));
        }
      }
      return out;
    }
  }
  if (!is_unknown(elem) && !is_primitive_type(elem)) {
    if let ast.ExprArray(a) = e {
      let out: util.Diag[] = [];
      if (is_func_type(elem) || is_tuple_type(elem)) {
        out = array_mix_diags(a, s, out);
      }
      for element in a.elements {
        out = util.append_diags(out, dest_call_diags(element, elem, s));
      }
      return out;
    }
  }
  return call_diags(e, s);
}

// method_missing: a method call names nothing its receiver can call — no
// method on a scalar, string, array or map, and on a struct neither a method,
// a builtin, nor a function-typed field. Any other receiver answers false.
function (s: Scope) method_missing(recv: typeinfo.Type, field: string): boolean {
  match (recv) {
    typeinfo.TypeI32(it) => {
      return s.visible_method(field, int_label(it)).name.len() == 0;
    },
    typeinfo.TypeFloat(f) => {
      return s.visible_method(field, float_label(f)).name.len() == 0;
    },
    typeinfo.TypeBool(_) => {
      return s.visible_method(field, "boolean").name.len() == 0 && is_unknown(builtin_method_sig("boolean", field));
    },
    typeinfo.TypeString(_) => {
      return field != "len" && field != "as_bytes" && s.visible_method(field, "string").name.len() == 0;
    },
    typeinfo.TypeArray(array) => {
      let builtin: boolean = field == "len" || !array.view && (field == "append" || field == "with");
      return !builtin && !s.has_array_recv_method(field, array.view);
    },
    typeinfo.TypeMap(_) => {
      return !util.has_str(preregistered_methods("Map"), field) && s.visible_method(field, "Map").name.len() == 0;
    },
    typeinfo.TypeStruct(sn) => {
      if (is_cell_type(recv) || s.visible_method(field, sn.name).name.len() > 0 || !is_unknown(builtin_method_sig(sn.name, field))) {
        return false;
      }
      let fsig: StructSig = s.lookup_struct(sn.name);
      if (fsig.name.len() == 0) {
        return false;
      }
      let fi: i32 = field_index(fsig, field);
      if (fi < 0) {
        return true;
      }
      if let typeinfo.TypeFunc(_) = fsig.field_types[fi] {
        return false;
      }
      return true;
    },
    typeinfo.TypeUnion(un) => {
      // The built-in unions (Option, Result, IoError, Body) are declared by
      // no module; any other union must be declared here for its method
      // table to be whole.
      let declared: boolean = un.name == "Option" || un.name == "Result" || un.name == "IoError" || un.name == "Body" || s.lookup_union(un.name).name.len() > 0;
      return declared && s.visible_method(field, un.name).name.len() == 0 && is_unknown(builtin_method_sig(un.name, field));
    },
    _ => {
      return false;
    }
  }
  return false;
}

// callee_resolves: a call's callee names something to call. An undefined
// free function and a missing method on a receiver that has a method surface
// do not.
function (s: Scope) callee_resolves(c: ast.ExprCall): boolean {
  if let ast.ExprIdent(cid) = c.callee {
    return is_resolvable_callee(cid.name, s);
  }
  if let ast.ExprFieldAccess(mfa) = c.callee {
    return !s.method_missing(check_expr(mfa.obj, s), mfa.field);
  }
  return true;
}

// The declared parameter types of a call where the callee resolves: a free
// function, a struct's method or function-typed field, a function value, or a
// builtin method that stores its argument into a map or an array. Empty
// otherwise.
function (s: Scope) call_param_types(c: ast.ExprCall): typeinfo.Type[] {
  match (c.callee) {
    ast.ExprIdent(id) => {
      if (!s.defines(id.name)) {
        return s.lookup_sig(id.name).param_types;
      }
      if let typeinfo.TypeFunc(f) = s.lookup(id.name) {
        if (f.params_known) {
          return f.param_types;
        }
      }
    },
    ast.ExprFieldAccess(mfa) => {
      let rt: typeinfo.Type = check_expr(mfa.obj, s);
      if let typeinfo.TypeStruct(sn) = rt {
        let msig: MethodSig = s.lookup_method(mfa.field, sn.name);
        if (msig.name.len() > 0) {
          return s.bound_method_param_types(c, msig, rt);
        }
        if let typeinfo.TypeFunc(ff) = check_expr(c.callee, s) {
          if (ff.params_known) {
            return ff.param_types;
          }
        }
      }
      if let typeinfo.TypeUnion(un) = rt {
        let msig: MethodSig = s.lookup_method(mfa.field, un.name);
        if (msig.name.len() > 0) {
          return s.bound_method_param_types(c, msig, rt);
        }
      }
      if let typeinfo.TypeMap(mt) = rt {
        if (mfa.field == "insert") {
          return [mt.key, mt.value];
        }
      }
      if let typeinfo.TypeArray(at) = rt {
        if (mfa.field == "append") {
          return [at.elem];
        }
        if (mfa.field == "with") {
          return [t_i32(), at.elem];
        }
        return s.array_method_param_types(c, rt, mfa.field, at.view);
      }
    },
    _ => {}
  }
  return [];
}

// array_method_param_types is the parameter types of the array receiver
// method `field` that the call `c` names, with the receiver's element type and
// the call's type arguments bound. Empty when no such method is imported.
function (s: Scope) array_method_param_types(c: ast.ExprCall, recv: typeinfo.Type, field: string, view: boolean): typeinfo.Type[] {
  return s.bound_method_param_types(c, s.array_recv_method(field, view), recv);
}

// Instantiate the method's parameter types from its receiver and written arguments.
function (s: Scope) bound_method_param_types(c: ast.ExprCall, asig: MethodSig, recv: typeinfo.Type): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  if (asig.name.len() == 0) {
    return out;
  }
  let mb: MethodBinding = method_binding(c, asig, recv, s);
  let i: i32 = 0;
  while (i < asig.param_types.len()) {
    out = out.append(receiver_bound(asig.param_types[i], param_type_name_at(asig, i), mb, s));
    i = i + 1;
  }
  return out;
}

// for_iter_diags reports E083 for a `for` over a value it cannot walk: no
// array, string, Map or range, no Iterator, and no `iter()` returning one.
function for_iter_diags(fr: ast.StmtFor, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  if (for_iter_is_range(fr.iter)) {
    return none;
  }
  let it: typeinfo.Type = check_expr(fr.iter, s);
  if (builtin_iterable(it) || is_unknown(it) && tvar_name(it).len() == 0 || iter_subject(it, s).ok) {
    return none;
  }
  return [dg_at("E083", "cannot iterate over a value of type " + util.demangle_all(util.show_type_vars(type_label_or_tvar(it))) + ": `for` walks an array, a string, a Map, a range, an iter.Iterator, or a value whose iter() returns one", expr_line(fr.iter), expr_col(fr.iter))];
}

// tuple_destr_diags is E024 for a tuple pattern of `n` names over a value of
// type `t`.
function tuple_destr_diags(t: typeinfo.Type, n: i32, line: i32, col: i32): util.Diag[] {
  match (t) {
    typeinfo.TypeTuple(tt) => {
      if (tt.elements.len() != n) {
        return [dg_at("E024", "tuple has " + util.i32_to_string(tt.elements.len()) + " elements, but " + util.i32_to_string(n) + " names given", line, col)];
      }
    },
    typeinfo.TypeUnknown(_) => {},
    _ => {
      return [dg_at("E024", "tuple destructure needs a tuple expression, got " + type_label(t), line, col)];
    }
  }
  return [];
}

// for_pattern_diags is E024 for a `for (a, b) in X` header whose element is
// not a tuple of that many values, or that walks a Map with other than two
// names.
function for_pattern_diags(fr: ast.StmtFor, s: Scope): util.Diag[] {
  if (!name_has_comma(fr.var_name)) {
    return [];
  }
  let n: i32 = split_pattern_names(fr.var_name).len();
  if (for_iter_is_range(fr.iter)) {
    return tuple_destr_diags(range_var_type(fr.iter, s), n, fr.line, fr.col);
  }
  let it: typeinfo.Type = check_expr(fr.iter, s);
  match (it) {
    typeinfo.TypeString(_) => {
      return tuple_destr_diags(t_u8(), n, fr.line, fr.col);
    },
    typeinfo.TypeArray(ta) => {
      return tuple_destr_diags(ta.elem, n, fr.line, fr.col);
    },
    typeinfo.TypeMap(_) => {
      if (n != 2) {
        return [dg_at("E024", "iterating a Map binds a (key, value) pair, but this pattern binds " + util.i32_to_string(n), fr.line, fr.col)];
      }
      return [];
    },
    _ => {}
  }
  let sub: IterSubject = iter_subject(it, s);
  if (sub.ok) {
    return tuple_destr_diags(sub.elem, n, fr.line, fr.col);
  }
  return [];
}

// builtin_iterable: the subjects `for` walks without the Iterator protocol.
function builtin_iterable(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeArray(_) => {
      return true;
    },
    typeinfo.TypeString(_) => {
      return true;
    },
    typeinfo.TypeMap(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function type_label_or_tvar(t: typeinfo.Type): string {
  let tv: string = tvar_name(t);
  if (tv.len() > 0) {
    return tv;
  }
  return type_label(t);
}

// IterSubject is how a `for` walks a subject `builtin_iterable` refuses: the
// element its Iterator yields, and `via_iter` when that Iterator is the
// subject's `iter()` rather than the subject itself. `ok` is false for a
// subject that is neither.
struct IterSubject { ok: boolean, elem: typeinfo.Type, via_iter: boolean }

function iter_subject(t: typeinfo.Type, s: Scope): IterSubject {
  let direct: typeinfo.Type = iterator_elem(t, s);
  if (!is_unknown(direct) || tvar_name(direct).len() > 0) {
    return IterSubject { ok: true, elem: direct, via_iter: false };
  }
  if (is_unknown(t) || is_type_variable(t)) {
    return IterSubject { ok: false, elem: direct, via_iter: false };
  }
  let via: typeinfo.Type = iterator_elem(probe_method(t, "iter", s), s);
  if (!is_unknown(via) || tvar_name(via).len() > 0) {
    return IterSubject { ok: true, elem: via, via_iter: true };
  }
  return IterSubject { ok: false, elem: via, via_iter: false };
}

// iterator_elem is the `T` of the `Iterator[T]` that `t` implements, read off
// its `next()`; unknown when `t` implements no core/iter Iterator.
function iterator_elem(t: typeinfo.Type, s: Scope): typeinfo.Type {
  if (!implements_iterator(t, s)) {
    return t_unknown("not an Iterator");
  }
  if let typeinfo.TypeUnion(u) = probe_method(t, "next", s) {
    if (u.name == "Option" && u.args.len() == 1) {
      if let typeinfo.TypeTuple(tp) = u.args[0] {
        if (tp.elements.len() == 2) {
          return tp.elements[0];
        }
      }
    }
  }
  return t_unknown("not an Iterator");
}

// implements_iterator: an impl of core/iter's Iterator for `t`, or for a type
// parameter, a bound naming it.
function implements_iterator(t: typeinfo.Type, s: Scope): boolean {
  let tv: string = tp_receiver(t, s);
  if (tv.len() == 0) {
    tv = tvar_name(t);
  }
  if (tv.len() > 0) {
    for tr in tp_bound_traits(s, tv) {
      if (tr == CORE_ITERATOR) {
        return true;
      }
    }
    return false;
  }
  if (is_unknown(t)) {
    return false;
  }
  let base: string = util.base_type_name(type_label(t));
  for imp in s.impls {
    if (parser.impl_trait_key(imp) == CORE_ITERATOR && util.base_type_name(imp.impl_type) == base) {
      return true;
    }
  }
  return false;
}

// core/iter's Iterator as an impl key or a bound spells it.
const CORE_ITERATOR: string = "iter.Iterator";

// iterator_lowering is the loop over core/iter's Iterator protocol a `for`
// lowers to, or None for a range or a builtin iterable, which keep their
// counted loops.
function iterator_lowering(fr: ast.StmtFor, s: Scope): Option[ast.Stmt] {
  if (for_iter_is_range(fr.iter)) {
    return None;
  }
  let it: typeinfo.Type = check_expr(fr.iter, s);
  if (builtin_iterable(it)) {
    return None;
  }
  let sub: IterSubject = iter_subject(it, s);
  if (!sub.ok) {
    return None;
  }
  let line: i32 = expr_line(fr.iter);
  let col: i32 = expr_col(fr.iter);
  let subject: ast.Expr = fr.iter;
  if (sub.via_iter) {
    subject = ast.ExprCall { callee: ast.ExprFieldAccess { obj: fr.iter, field: "iter", line: line, col: col, ty: "", const_read: false }, args: [], line: line, col: col, type_args: [], ty: "" };
  }
  return Some(parser.iterator_loop(fr, subject, col));
}

// probe_method is the type of a zero-argument call of method `name` on a value
// of type `t`; unknown when `t` has no such method.
function probe_method(t: typeinfo.Type, name: string, s: Scope): typeinfo.Type {
  let recv: ast.Expr = ast.ExprIdent { name: "__for_iter", line: 0, col: 0, ty: "" };
  let call: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: recv, field: name, line: 0, col: 0, ty: "", const_read: false }, args: [], line: 0, col: 0, type_args: [], ty: "" };
  return check_expr(call, s.bind("__for_iter", t));
}

// ---- exhaustiveness of a desugared match --------------------------------------
//
// A match on a tuple or a struct, and one whose variant arms nest
// sub-patterns, reaches the checker as the done-flag chain the parser built,
// which falls through by construction. Its arms as written ride on the
// chain's `if` (ast.MatchSugar), and E030 is decided over them: the
// usefulness check over the arms' patterns, one row per unguarded arm. A
// column whose every constructor some row names (an enum's variants, a
// tuple's or a struct's one shape, a boolean's two values) is split per
// constructor, each split checked in turn; any other column needs a row that
// matches anything there. A literal other than `true` or `false` covers only
// itself (#12257). A match on a literal has its own rule
// (scalar_match_exhaustive_diags).

// A pattern as the check reads it: a constructor and its payload patterns, one
// that matches anything (ctor ""), or a test it cannot split on (opaque).
struct CoverPat { ctor: string, opaque: boolean, args: CoverPat[] }

function cover_any(): CoverPat {
  return CoverPat { ctor: "", opaque: false, args: [] };
}

function cover_opaque(): CoverPat {
  return CoverPat { ctor: "", opaque: true, args: [] };
}

function sugar_exhaustive_diags(sg: ast.MatchSugar, s: Scope): util.Diag[] {
  if (sg.origin != "" || sg.tup.len() + sg.strct.len() + sg.arms.len() == 0) {
    return [];
  }
  let out: util.Diag[] = [];
  let t: typeinfo.Type = check_expr(sg.scrut, s);
  let valid: ast.MatchSugar = sg;
  if let typeinfo.TypeTuple(tuple) = t {
    let arms: ast.TupArm[] = [];
    for arm in sg.tup {
      if (!arm.is_wild && arm.elem_kinds.len() != tuple.elements.len()) {
        out = out.append(dg_at("E035", "tuple pattern has " + util.i32_to_string(arm.elem_kinds.len()) + " elements, but scrutinee tuple has " + util.i32_to_string(tuple.elements.len()), arm.line, arm.col));
      } else {
        arms = arms.append(arm);
      }
    }
    valid = ast.MatchSugar { ...sg, tup: arms };
  }
  out = util.append_diags(out, sugar_unreachable_diags(valid));
  if (is_unknown(t)) {
    return out;
  }
  if (has_catch_all(valid)) {
    return out;
  }
  let rows: CoverPat[][] = sugar_rows(valid, t, s);
  if (sg.arms.len() > 0) {
    return util.append_diags(out, variant_cover_diags(rows, t, valid, s));
  }
  if (!cover_useful(rows, [t], s)) {
    return out;
  }
  if (sg.tup.len() > 0) {
    return out.append(dg_at("E030", "match on tuple is not exhaustive — add an unguarded `_` or all-binder arm", sg.line, sg.col));
  }
  return out.append(dg_at("E030", "match on struct is not exhaustive — add an unguarded struct-pattern or `_` arm", sg.line, sg.col));
}

// One E030 per variant of the scrutinee's enum some value of escapes every
// arm, in declaration order.
function variant_cover_diags(rows: CoverPat[][], t: typeinfo.Type, sg: ast.MatchSugar, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if let typeinfo.TypeUnion(u) = t {
    for v in cover_ctor_names(t, s) {
      let arity: i32 = cover_arity(rows, v);
      if (cover_useful(cover_split(rows, v, arity), cover_arg_types(t, v, arity, s), s)) {
        out = out.append(dg_at("E030", "match does not cover variant " + unprefixed_variant(v, s.lookup_union(u.name).module) + " of enum " + shown_enum(s, u.name) + " — add an arm for it, or a `_` arm", sg.line, sg.col));
      }
    }
  }
  return out;
}

// An unguarded arm that matches anything, which settles the question before
// the scrutinee is typed: a `_`, or a tuple arm of binders and `_`s.
function has_catch_all(sg: ast.MatchSugar): boolean {
  for a in sg.tup {
    if (!a.has_guard && (a.is_wild || binds_only(a.elem_kinds))) {
      return true;
    }
  }
  for a in sg.strct {
    if (!a.has_guard && a.is_wild) {
      return true;
    }
  }
  for a in sg.arms {
    if let ast.PatWildcard(_) = a.pattern {
      if (!a.has_guard) {
        return true;
      }
    }
  }
  return false;
}

function binds_only(kinds: i32[]): boolean {
  for k in kinds {
    if (k != 0 && k != 1) {
      return false;
    }
  }
  return true;
}

function sugar_rows(sg: ast.MatchSugar, t: typeinfo.Type, s: Scope): CoverPat[][] {
  let rows: CoverPat[][] = [];
  for a in sg.tup {
    if (!a.has_guard) {
      let p: CoverPat = cover_any();
      if (!a.is_wild) {
        p = tuple_cover(a.elem_kinds, a.lits, a.elem_pats);
      }
      rows = rows.append([p]);
    }
  }
  for a in sg.strct {
    if (!a.has_guard) {
      let p: CoverPat = cover_any();
      if (!a.is_wild) {
        p = struct_cover(a, t, s);
      }
      rows = rows.append([p]);
    }
  }
  for a in sg.arms {
    if (!a.has_guard) {
      rows = rows.append([pattern_cover(a.pattern)]);
    }
  }
  return rows;
}

function literal_cover(e: ast.Expr): CoverPat {
  if let ast.ExprBool(b) = e {
    if (b.value) {
      return CoverPat { ctor: "true", opaque: false, args: [] };
    }
    return CoverPat { ctor: "false", opaque: false, args: [] };
  }
  return cover_opaque();
}

// A tuple pattern's elements, by the TupArm encoding: 0 a binder, 1 `_`, 2 a
// literal, 3 a variant sub-pattern, 4 a nested tuple.
function tuple_cover(kinds: i32[], lits: ast.Expr[], pats: ast.Pattern[]): CoverPat {
  let args: CoverPat[] = [];
  let k: i32 = 0;
  while (k < kinds.len()) {
    let a: CoverPat = cover_any();
    if (kinds[k] == 2 && k < lits.len()) {
      a = literal_cover(lits[k]);
    } else if (kinds[k] == 3 && k < pats.len()) {
      a = pattern_cover(pats[k]);
    } else if (kinds[k] == 4 && k < pats.len()) {
      if let ast.PatVariant(np) = pats[k] {
        a = tuple_cover(np.tup_kinds, np.tup_lits, np.tup_pats);
      }
    }
    args = args.append(a);
    k = k + 1;
  }
  return CoverPat { ctor: "()", opaque: false, args: args };
}

// A struct pattern's fields in declaration order: a field it does not name
// matches anything.
function struct_cover(a: ast.StructArm, t: typeinfo.Type, s: Scope): CoverPat {
  let args: CoverPat[] = [];
  if let typeinfo.TypeStruct(st) = t {
    for name in s.lookup_struct(st.name).field_names {
      let p: CoverPat = cover_any();
      let j: i32 = util.index_of_str(a.fields, name);
      if (j >= 0 && j < a.field_kinds.len() && a.field_kinds[j] == 2) {
        p = literal_cover(a.field_lits[j]);
      } else if (j >= 0 && j < a.field_kinds.len() && a.field_kinds[j] == 3) {
        p = pattern_cover(a.field_pats[j]);
      }
      args = args.append(p);
    }
  }
  return CoverPat { ctor: "{}", opaque: false, args: args };
}

// A variant pattern and what each payload slot tests: a sub-pattern, a
// tuple, a literal (a synthetic `__pl` binder its lit_cond compares), or
// nothing.
function pattern_cover(p: ast.Pattern): CoverPat {
  match (p) {
    ast.PatWildcard(_) => {
      return cover_any();
    },
    ast.PatVariant(pv) => {
      if (pv.type_name.len() == 0) {
        if (pv.tup_kinds.len() > 0) {
          return tuple_cover(pv.tup_kinds, pv.tup_lits, pv.tup_pats);
        }
        return cover_any();
      }
      let slots: string[] = [];
      if (pv.binding.len() > 0 || pv.extra_bindings.len() > 0) {
        slots = [pv.binding];
        for b in pv.extra_bindings {
          slots = slots.append(b);
        }
      }
      let args: CoverPat[] = [];
      let i: i32 = 0;
      while (i < slots.len() || i < pv.nested.len()) {
        let a: CoverPat = cover_any();
        let named: string = "";
        if (i < slots.len()) {
          named = slots[i];
        }
        if (i < pv.nested.len() && nested_tests(pv.nested[i])) {
          a = pattern_cover(pv.nested[i]);
        } else if (named == "__tupslot") {
          a = tuple_cover(pv.tup_kinds, pv.tup_lits, pv.tup_pats);
        } else if (util.str_has_prefix(named, "__pl")) {
          a = slot_literal_cover(pv.lit_cond, named);
        }
        args = args.append(a);
        i = i + 1;
      }
      return CoverPat { ctor: variant_pattern_name(pv.type_name), opaque: false, args: args };
    }
  }
}

function nested_tests(p: ast.Pattern): boolean {
  if let ast.PatVariant(np) = p {
    return np.type_name.len() > 0 || np.tup_kinds.len() > 0;
  }
  return false;
}

// What a literal payload slot `slot` tests, from the conjunction lit_cond: a
// boolean constructor for `slot == true` or `slot == false`, opaque for
// anything else.
function slot_literal_cover(cond: ast.Expr, slot: string): CoverPat {
  if let ast.ExprBinary(b) = cond {
    if (b.op == "&&") {
      let l: CoverPat = slot_literal_cover(b.left, slot);
      if (l.ctor.len() > 0 || l.opaque) {
        return l;
      }
      return slot_literal_cover(b.right, slot);
    }
    if let ast.ExprIdent(id) = b.left {
      if (id.name == slot) {
        if (b.op == "==") {
          return literal_cover(b.right);
        }
        return cover_opaque();
      }
    }
    if (expr_mentions(b.left, slot) || expr_mentions(b.right, slot)) {
      return cover_opaque();
    }
  }
  return cover_any();
}

function expr_mentions(e: ast.Expr, name: string): boolean {
  if let ast.ExprIdent(id) = e {
    return id.name == name;
  }
  if let ast.ExprBinary(b) = e {
    return expr_mentions(b.left, name) || expr_mentions(b.right, name);
  }
  return false;
}

// Every constructor of `t` when it has finitely many: an enum's variants, a
// tuple's or a struct's one shape, a boolean's two values. None for any other
// type, which only a pattern that matches anything covers.
function cover_ctor_names(t: typeinfo.Type, s: Scope): string[] {
  match (t) {
    typeinfo.TypeUnion(u) => {
      let us: UnionSig = s.lookup_union(u.name);
      if (us.name.len() == 0) {
        us = builtin_union_sig(u.name);
      }
      return us.variants;
    },
    typeinfo.TypeTuple(_) => {
      return ["()"];
    },
    typeinfo.TypeStruct(_) => {
      return ["{}"];
    },
    typeinfo.TypeBool(_) => {
      return ["false", "true"];
    },
    _ => {
      let none: string[] = [];
      return none;
    }
  }
}

function cover_arg_types(t: typeinfo.Type, ctor: string, arity: i32, s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  match (t) {
    typeinfo.TypeTuple(tt) => {
      return tt.elements;
    },
    typeinfo.TypeStruct(st) => {
      return s.lookup_struct(st.name).field_types;
    },
    typeinfo.TypeUnion(u) => {
      let i: i32 = 0;
      while (i < arity) {
        out = out.append(variant_pattern_payload_type(s, u.name + "." + ctor, t, i));
        i = i + 1;
      }
    },
    _ => {}
  }
  return out;
}

// The arms of a flat match whose only guard is the payload test the parser
// made of a literal payload slot (`Patch(_, true)`: `__pl… == true`), as
// patterns with those literals back in their slots. Another guard can fall
// through, so its arm covers nothing.
function literal_payload_rows(arms: ast.MatchArm[]): CoverPat[][] {
  let rows: CoverPat[][] = [];
  for a in arms {
    if (!a.has_guard || !slot_tests_only(a.guard)) {
      continue;
    }
    if let ast.PatVariant(pv) = a.pattern {
      rows = rows.append([pattern_cover(ast.PatVariant { ...pv, lit_cond: a.guard, has_lit_cond: true })]);
    }
  }
  return rows;
}

// Whether `e` is a conjunction of tests of `__pl` slot binders only.
function slot_tests_only(e: ast.Expr): boolean {
  if let ast.ExprBinary(b) = e {
    if (b.op == "&&") {
      return slot_tests_only(b.left) && slot_tests_only(b.right);
    }
    if let ast.ExprIdent(id) = b.left {
      return util.str_has_prefix(id.name, "__pl");
    }
  }
  return false;
}

// Whether `rows` leave no value of variant `ctor` of `t` unmatched.
function rows_cover(rows: CoverPat[][], t: typeinfo.Type, ctor: string, s: Scope): boolean {
  if (rows.len() == 0) {
    return false;
  }
  let arity: i32 = cover_arity(rows, ctor);
  return !cover_useful(cover_split(rows, ctor, arity), cover_arg_types(t, ctor, arity, s), s);
}

// Whether a written pattern's constructor is `ctor`. The arms ride on the
// chain as written, so a variant of an enum another module declares is named
// bare there while the type lists it mangled (`rbtree__Node`).
function names_ctor(written: string, ctor: string): boolean {
  return written == ctor || written.len() > 0 && util.str_has_suffix(ctor, "__" + written);
}

// The payload count rows naming `ctor` give it.
function cover_arity(rows: CoverPat[][], ctor: string): i32 {
  let n: i32 = 0;
  for r in rows {
    if (!r[0].opaque && names_ctor(r[0].ctor, ctor) && r[0].args.len() > n) {
      n = r[0].args.len();
    }
  }
  return n;
}

// The rows that can match a value built by `ctor`, with its payloads in place
// of the first column.
function cover_split(rows: CoverPat[][], ctor: string, arity: i32): CoverPat[][] {
  let out: CoverPat[][] = [];
  for r in rows {
    let head: CoverPat = r[0];
    if (head.opaque || head.ctor.len() > 0 && !names_ctor(head.ctor, ctor)) {
      continue;
    }
    let row: CoverPat[] = [];
    let i: i32 = 0;
    while (i < arity) {
      if (i < head.args.len()) {
        row = row.append(head.args[i]);
      } else {
        row = row.append(cover_any());
      }
      i = i + 1;
    }
    let j: i32 = 1;
    while (j < r.len()) {
      row = row.append(r[j]);
      j = j + 1;
    }
    out = out.append(row);
  }
  return out;
}

// Whether some value of `types` escapes every row. A column of a type the
// checker could not resolve is passed over, every row that tests it counted
// as matching, so an unresolved payload never draws an E030.
function cover_useful(rows: CoverPat[][], types: typeinfo.Type[], s: Scope): boolean {
  if (types.len() == 0) {
    return rows.len() == 0;
  }
  let rest_types: typeinfo.Type[] = [];
  let k: i32 = 1;
  while (k < types.len()) {
    rest_types = rest_types.append(types[k]);
    k = k + 1;
  }
  let names: string[] = cover_ctor_names(types[0], s);
  let complete: boolean = names.len() > 0;
  for n in names {
    if (!cover_names(rows, n)) {
      complete = false;
    }
  }
  if (!complete) {
    let rest: CoverPat[][] = [];
    for r in rows {
      let matches_all: boolean = r[0].ctor.len() == 0 && !r[0].opaque;
      if (matches_all || is_unknown(types[0]) && !r[0].opaque) {
        rest = rest.append(cover_tail(r));
      }
    }
    return cover_useful(rest, rest_types, s);
  }
  for n in names {
    let arity: i32 = cover_arity(rows, n);
    let arg_types: typeinfo.Type[] = cover_arg_types(types[0], n, arity, s);
    for rt in rest_types {
      arg_types = arg_types.append(rt);
    }
    if (cover_useful(cover_split(rows, n, arity), arg_types, s)) {
      return true;
    }
  }
  return false;
}

function cover_names(rows: CoverPat[][], ctor: string): boolean {
  for r in rows {
    if (!r[0].opaque && names_ctor(r[0].ctor, ctor)) {
      return true;
    }
  }
  return false;
}

function cover_tail(r: CoverPat[]): CoverPat[] {
  let out: CoverPat[] = [];
  let j: i32 = 1;
  while (j < r.len()) {
    out = out.append(r[j]);
    j = j + 1;
  }
  return out;
}

function literal_bound_diags(value: ast.Expr, scrut: typeinfo.Type, scope: Scope, subject: string, line: i32, col: i32): util.Diag[] {
  let ty: typeinfo.Type = check_expr(value, scope);
  if (!is_unknown(ty) && !is_unknown(scrut) && !settles_to(value, scrut, scope) && !coercible(ty, scrut, scope)) {
    return [dg_at("E035", subject + " of type " + type_label(ty) + " does not match scrutinee type " + type_label(scrut), line, col)];
  }
  return [];
}

function literal_comparison_diags(cond: ast.Expr, arm: ast.LitArm, scope: Scope): util.Diag[] {
  if let ast.ExprBinary(compare) = cond {
    let scrut: typeinfo.Type = check_expr(compare.left, scope);
    let subject: string = "literal pattern";
    if (arm.has_range && compare.op != ">=") {
      subject = "range pattern bound";
    }
    return literal_bound_diags(compare.right, scrut, scope, subject, expr_line(arm.lit), expr_col(arm.lit));
  }
  return [];
}

function literal_arm_diags(cond: ast.Expr, arm: ast.LitArm, scope: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let pattern: ast.Expr = cond;
  if (arm.has_guard) {
    if (arm.is_wild) {
      return call_diags(cond, scope);
    }
    if let ast.ExprBinary(both) = cond {
      pattern = both.left;
      out = call_diags(both.right, scope);
    }
  }
  if (arm.has_range) {
    if let ast.ExprBinary(bounds) = pattern {
      out = util.append_diags(out, literal_comparison_diags(bounds.left, arm, scope));
      return util.append_diags(out, literal_comparison_diags(bounds.right, arm, scope));
    }
  }
  return util.append_diags(out, literal_comparison_diags(pattern, arm, scope));
}

// The written arms supply source sites. Types and bodies come from the rewritten chain.
function literal_match_diags(chain: ast.StmtIf, scope: Scope): util.Diag[] {
  if let ast.ExprBool(wrapper) = chain.cond {
    if (wrapper.value) {
      let out: util.Diag[] = [];
      let local: Scope = scope;
      let i: i32 = 0;
      for stmt in chain.then_body {
        if (i + 1 == chain.then_body.len()) {
          if let ast.StmtIf(tail) = stmt {
            return util.append_diags(out, literal_chain_diags(tail, chain.sugar.lits, 0, local));
          }
        }
        out = util.append_diags(out, stmts_call_diags([stmt], local));
        local = bind_stmt(stmt, local);
        i = i + 1;
      }
      return out;
    }
  }
  return literal_chain_diags(chain, chain.sugar.lits, 0, scope);
}

function literal_chain_diags(chain: ast.StmtIf, arms: ast.LitArm[], at: i32, scope: Scope): util.Diag[] {
  let out: util.Diag[] = literal_arm_diags(chain.cond, arms[at], scope);
  out = util.append_diags(out, stmts_call_diags(chain.then_body, scope));
  let next: i32 = at + 1;
  if (next < arms.len() && !(arms[next].is_wild && !arms[next].has_guard) && chain.else_body.len() == 1) {
    if let ast.StmtIf(tail) = chain.else_body[0] {
      return util.append_diags(out, literal_chain_diags(tail, arms, next, scope));
    }
  }
  return util.append_diags(out, stmts_call_diags(chain.else_body, scope));
}

function stmts_call_diags(stmts: ast.Stmt[], s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = bind_mutual_siblings(stmts, s);
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        // A function-valued local is in scope for the statements that
        // follow it; inside its own initialiser only as rec_local_scope admits.
        let vsc: Scope = cur;
        match (v.init) {
          ast.ExprLambda(lm) => {
            vsc = rec_local_scope(v, cur);
            cur = cur.bind(v.name, lambda_fn_type(lm, cur));
          },
          _ => {
            // A function-valued local whose init is not a lambda — `let g = dbl;`,
            // `let g = mk();`, `let h = obj.f;` — needs the same binding, or the
            // closure-arity E004 never sees a callee it could check. Only
            // fn-valued inits are bound: binding every local would make
            // `defines` true for names the free-function rules still check.
            let ivt: typeinfo.Type = check_expr(v.init, cur);
            if (is_func_type(ivt)) {
              vsc = cur.bind(v.name, ivt);
              cur = vsc;
            }
          }
        }
        let vdest: typeinfo.Type = t_unknown("no declared type");
        if (v.type_name.len() > 0) {
          vdest = var_declared_type(v, vsc);
        }
        out = util.append_diags(out, dest_call_diags(v.init, vdest, vsc));
        out = util.append_diags(out, array_elem_check(array_elem_type_of(vdest), v.init, vsc));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, dest_call_diags(r.value, cur.ret_type, cur));
        // E034: a composite-array `return` value's elements checked
        // against the function's declared element type (top-level
        // stmts carry an unknown ret_type sentinel and are skipped).
        out = util.append_diags(out, array_elem_check(array_elem_type_of(cur.ret_type), r.value, cur));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, call_diags(x.value, cur));
        out = util.append_diags(out, e055_diag(x.value, cur));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, dest_call_diags(a.value, cur.lookup(a.target), cur));
        // E034: reassigning a composite-array literal — its elements
        // checked against the target variable's declared element type.
        out = util.append_diags(out, array_elem_check(array_elem_type_of(cur.lookup(a.target)), a.value, cur));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, sugar_exhaustive_diags(f.sugar, cur));
        if (f.sugar.lits.len() > 0) {
          out = util.append_diags(out, literal_match_diags(f, cur));
        } else {
          out = util.append_diags(out, call_diags(f.cond, cur));
          out = util.append_diags(out, stmts_call_diags(f.then_body, cur));
          out = util.append_diags(out, stmts_call_diags(f.else_body, cur));
        }
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, call_diags(w.cond, cur));
        out = util.append_diags(out, stmts_call_diags(w.body, cur));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, call_diags(fr.iter, cur));
        out = util.append_diags(out, for_iter_diags(fr, cur));
        out = util.append_diags(out, for_pattern_diags(fr, cur));
        out = util.append_diags(out, stmts_call_diags(fr.body, for_body_scope(fr, cur)));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, call_diags(m.scrutinee, cur));
        // E035: a `match` on a non-enum (primitive) scrutinee only
        // accepts literal patterns or `_`. A named variant pattern
        // (`Foo`, `Some(x)`) over an i32 / string / f64 / bool
        // scrutinee is the error, reported at the arm. Literal
        // patterns parse to empty-name variants (skipped here), and
        // `true` / `false` are literal bool patterns (also skipped),
        // so this fires only on genuine variant patterns.
        let mst: typeinfo.Type = check_expr(m.scrutinee, cur);
        // E022 / E023: a match synthesised from `if let` / `let … else`
        // (origin != "") carries the dedicated pattern-binding
        // diagnostics the Go checker emits on the LetElse / IfLet nodes,
        // rather than the generic E035 the desugared shape would draw.
        // The scrutinee must be an enum value (typed TypeUnion here —
        // enums register as union sigs); a primitive / struct source is
        // E022. For `let … else`, the else branch (the trailing wildcard
        // arm) must additionally diverge.
        if (m.origin == "if_let" || m.origin == "let_else") {
          let src_is_enum: boolean = false;
          let src_unknown_enum: boolean = false;
          match (mst) {
            typeinfo.TypeUnion(su) => {
              src_is_enum = true;
              // E023: the source types to an enum the checker
              // doesn't know — the unknown-BASE generic
              // annotation shape (`s: Statuus[i32]`), which
              // type_from_ref_names resolves to a name-only union
              // that lookup_union misses. The Go checker reports
              // E023 at the source and skips the binding checks.
              // Reserved builtin enums (Option/Result/…) are
              // always known to the Go checker — never E023.
              if (cur.lookup_union(su.name).name.len() == 0 && !parser.is_reserved_enum_name(su.name)) {
                src_unknown_enum = true;
                out = out.append(dg_at("E023", "unknown enum \"" + su.name + "\"", expr_line(m.scrutinee), expr_col(m.scrutinee)));
              }
            },
            _ => {}
          }
          let kind_label: string = "if-let";
          if (m.origin == "let_else") {
            kind_label = "let-else";
          }
          if (!src_is_enum && !is_unknown(mst)) {
            out = out.append(dg_at("E022", kind_label + " source must be an enum value, got " + type_label(mst), expr_line(m.scrutinee), expr_col(m.scrutinee)));
          } else if (m.origin == "let_else" && src_is_enum && !src_unknown_enum) {
            // The else block is the synthesised trailing `_` arm; it
            // must diverge (return / break / continue) so the
            // bindings are live for the fall-through path.
            let le_last: i32 = m.arms.len() - 1;
            if (le_last >= 0 && !block_diverges(m.arms[le_last].body)) {
              out = out.append(dg_at("E022", "let-else: else branch must diverge (return / break / continue)", m.line, m.col));
            }
          }
        }
        // E035: a match on a declared STRUCT takes `Name { … }` patterns, which
        // the parser desugars before this sees the match, or `_`; any named arm
        // left here is a variant pattern over a value that has no variants.
        if let typeinfo.TypeStruct(msts) = mst {
          let msig: StructSig = cur.lookup_struct(msts.name);
          if (m.origin == "" && msig.name == msts.name && msig.enum_owner.len() == 0) {
            for sarm in m.arms {
              if let ast.PatVariant(spv) = sarm.pattern {
                if (spv.type_name.len() > 0) {
                  out = out.append(dg_at("E035", "match on struct `" + msts.name + "` only accepts struct patterns `" + msts.name + " { … }` or `_`", sarm.line, sarm.col));
                }
              }
            }
          }
        }
        if (is_primitive_type(mst) && m.origin == "") {
          for arm in m.arms {
            match (arm.pattern) {
              ast.PatVariant(epv) => {
                if (epv.type_name.len() > 0 && epv.type_name != "true" && epv.type_name != "false") {
                  out = out.append(dg_at("E035", "match on non-enum value `" + type_label(mst) + "` only accepts literal patterns or `_`", arm.line, arm.col));
                }
              },
              _ => {}
            }
          }
        }
        // E030: a `match` on a union scrutinee must cover every
        // variant or carry a `_` arm. Reported at the `match`
        // keyword (Go's `n.P`). Each uncovered variant is one
        // diagnostic (matching Go). Scrutinees that don't resolve to
        // a known union are skipped, so this never fires on the
        // union matches throughout the bundle (all exhaustive or
        // wildcarded) — verified across every self-host module.
        match (mst) {
          typeinfo.TypeUnion(mun) => {
            let usig: UnionSig = cur.lookup_union(mun.name);
            if (usig.name.len() == 0) {
              usig = builtin_union_sig(mun.name);
            }
            // E023: a plain `match` on a value whose type is an
            // enum the checker doesn't know (the unknown-BASE
            // generic annotation shape — see type_from_ref_names).
            // Reported at the scrutinee, like the Go checker's
            // checkMatch/checkMatchExpr; the arm checks below are
            // skipped (usig missed). if-let / let-else report
            // theirs in the origin block above — don't double up.
            if (usig.name.len() == 0 && !parser.is_reserved_enum_name(mun.name) && m.origin == "") {
              out = out.append(dg_at("E023", "unknown enum \"" + mun.name + "\"", expr_line(m.scrutinee), expr_col(m.scrutinee)));
            }
            if (usig.name.len() > 0) {
              let saw_wild: boolean = false;
              let covered: string[] = [];
              for elem in m.arms {
                match (elem.pattern) {
                  ast.PatWildcard(_) => {
                    saw_wild = true;
                  },
                  ast.PatVariant(cpv) => {
                    if (cpv.type_name.len() > 0) {
                      let cdp: i32 = dot_index(cpv.type_name);
                      if (cdp >= 0) {
                        // Qualified pattern `Qual.Variant`.
                        let cqual: str = slice_unchecked(cpv.type_name, 0, cdp);
                        let cbare: str = slice_unchecked(cpv.type_name, cdp + 1, cpv.type_name.len());
                        if (cqual == mun.name) {
                          // Correctly qualified — an UNGUARDED arm covers
                          // the bare variant. A guarded arm may fall
                          // through, so it does NOT count toward
                          // exhaustiveness (#4344).
                          if (!elem.has_guard) {
                            covered = covered.append(cbare + "");
                          }
                          if (!util.has_str(usig.variants, cbare)) {
                            out = out.append(unknown_variant_diag(cur, cbare, usig, elem.line, elem.col));
                          }
                        } else if (cur.lookup_union(cqual).name.len() > 0) {
                          // E029: qualifier is a known enum/union, but
                          // not the scrutinee's.
                          out = out.append(dg_at("E029", "variant pattern qualifier \"" + shown_enum(cur, cqual) + "\" does not match scrutinee enum " + shown_enum(cur, mun.name), elem.line, elem.col));
                        }
                      } else {
                        // (unknown qualifier: Go reports a module-source
                        // mismatch this port doesn't model — left alone.)
                        // Only an UNGUARDED arm covers its variant for
                        // exhaustiveness; a guarded arm may fall through
                        // (#4344). E014 (below) still fires for a guarded
                        // arm naming a foreign variant.
                        if (!elem.has_guard) {
                          covered = covered.append(cpv.type_name);
                        }
                        // E014: a variant pattern that names
                        // something outside the scrutinee's
                        // enum/union, reported at the arm.
                        if (!util.has_str(usig.variants, cpv.type_name)) {
                          out = out.append(unknown_variant_diag(cur, cpv.type_name, usig, elem.line, elem.col));
                        } else if (!parser.is_record_pattern(cpv) && variant_owner_count(cpv.type_name, cur.structs) >= 2) {
                          out = util.append_diags(out, payload_arity_diags(cpv, mun.name + "." + cpv.type_name, cur.structs, cur.unions, elem.line, elem.col));
                        }
                      }
                    }
                  }
                }
              }
              if (!saw_wild) {
                let lit_rows: CoverPat[][] = literal_payload_rows(m.arms);
                for variant in usig.variants {
                  if (!util.has_str(covered, variant) && !rows_cover(lit_rows, mst, variant, cur)) {
                    out = out.append(dg_at("E030", "match does not cover variant " + unprefixed_variant(variant, usig.module) + " of enum " + shown_enum(cur, mun.name) + " — add an arm for it, or a `_` arm", m.line, m.col));
                  }
                }
              }
            }
          },
          typeinfo.TypeBool(_) => {
            // Scalar scrutinee — native's checkLiteralMatch domain
            // (number / string / bool). Tuple and struct scrutinees
            // take their own native paths and are left alone here.
            //
            // A match whose first arm is a literal (`true` / `false`
            // included) is desugared by build_literal_match, which
            // hands back a StmtMatch for exactly the shapes this rule
            // and E026 refuse; a boolean match reaches here raw only
            // when a non-literal arm comes first.
            out = scalar_match_exhaustive_diags(m, out, true);
          },
          typeinfo.TypeI32(_) => {
            out = scalar_match_exhaustive_diags(m, out, false);
          },
          typeinfo.TypeString(_) => {
            out = scalar_match_exhaustive_diags(m, out, false);
          },
          typeinfo.TypeFloat(_) => {
            out = scalar_match_exhaustive_diags(m, out, false);
          },
          _ => {}
        }
        for elem in m.arms {
          // Bring the variant payload binding into the arm's
          // scope (as `TypeStruct(variant)`) before walking the
          // body, so a field access on it (`TokIdent(t) => t.name`)
          // resolves against the right struct instead of tripping
          // a spurious E043. Mirrors the body-check path's binding.
          let armScope: Scope = cur;
          match (elem.pattern) {
            ast.PatVariant(apv) => {
              // Don't bind the payloads of a FOREIGN variant
              // (one not in the scrutinee union) — their reads
              // are then genuinely undefined (E001), matching
              // the Go checker, which reports both E014 (bad
              // variant) and E001 (the now-undefined binding).
              let foreign: boolean = false;
              match (mst) {
                typeinfo.TypeUnion(amu) => {
                  let ausig: UnionSig = cur.lookup_union(amu.name);
                  if (ausig.name.len() > 0 && !util.has_str(ausig.variants, variant_pattern_name(apv.type_name))) {
                    foreign = true;
                  }
                },
                _ => {}
              }
              if (!foreign) {
                armScope = bind_variant_payloads(armScope, cur, apv, check_expr(m.scrutinee, cur));
                out = util.append_diags(out, generic_binder_diags(apv, cur, mst, elem.line, elem.col));
              }
            },
            _ => {}
          }
          // E027: a match-arm guard (`Pat if <expr> =>`) must be
          // boolean. Typed in the arm scope so a guard referencing
          // the pattern binding (`Has(n) if n > 0`) resolves.
          if (elem.has_guard) {
            let gt: typeinfo.Type = check_expr(elem.guard, armScope);
            if (!is_unknown(gt) && !type_eq(gt, t_bool())) {
              out = out.append(dg_at("E027", "match guard must be boolean, got " + type_label(gt), expr_line(elem.guard), expr_col(elem.guard)));
            }
            out = util.append_diags(out, call_diags(elem.guard, armScope));
          }
          out = util.append_diags(out, stmts_call_diags(elem.body, armScope));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, stmts_call_diags(one, cur));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

// ambiguous_variants returns the bare variant names some module may find
// ambiguous (E036): those two or more enums declare, or an enum and a
// built-in one (`enum O { Some(i32), None }` beside Option). Which modules do
// is variant_ambiguous's question; this only decides whether the walk runs.
// A variant repeated within one enum is E017 and counts once.
function ambiguous_variants(ut: UnionTable): string[] {
  let out: string[] = [];
  let e: i32 = 0;
  while (e < ut.bnames.len()) {
    let name: string = ut.bnames[e];
    if (ut.unions[ut.vowner[e]].is_enum && !util.has_str(out, name) && (parser.builtin_enum_of(name).len() > 0 || second_enum_declares(ut, e))) {
      out = out.append(name);
    }
    e = e + 1;
  }
  return out;
}

// second_enum_declares reports whether an enum other than entry `e`'s owner
// declares a variant of the same bare name.
function second_enum_declares(ut: UnionTable, e: i32): boolean {
  let k: i32 = ut.bhead[sig_name_bucket(ut.bnames[e])];
  while (k >= 0) {
    if (ut.bnames[k] == ut.bnames[e] && ut.vowner[k] != ut.vowner[e] && ut.unions[ut.vowner[k]].is_enum) {
      return true;
    }
    k = ut.bnext[k];
  }
  return false;
}

// vref_expr recurses an expression and emits E036 for a bare reference to
// a variant name that's declared in multiple enums (so it must be
// qualified). A local or declared function shadows the variant, and a
// QUALIFIED reference `Enum.Variant` is an ExprFieldAccess whose field
// isn't visited as a bare ident, so it's fine.
// vref_expr collects the E036 diagnostics an expression contributes: a variant
// name declared in more than one enum, referenced unqualified and not resolved
// by anything in scope.
//
// It PRUNES at ExprLambda and hands the body to vref_stmts, the scope-THREADED
// statement walk. That is the whole point of the arm: vref_stmts extends the
// scope as it goes, so a variant name shadowed by a local `let` inside the
// lambda is not flagged. Letting astwalk descend into the body instead would
// check it against the enclosing scope and report the shadowed name.
function vref_expr(e: ast.Expr, s: Scope, ambig: string[]): util.Diag[] {
  function at(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprIdent(id) => {
        let bare: string = unprefixed_variant(id.name, s.fn_module);
        if (util.has_str(ambig, bare) && !s.known(id.name) && !s.has_sig(id.name) && s.variant_ambiguous(id.name)) {
          return acc.append(dg_at("E036", "variant \"" + bare + "\" is declared in multiple enums — qualify the reference", id.line, id.col));
        }
        return acc;
      },
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, vref_stmts(lm.body, s, ambig));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_expr_pruned(e, no_diags(), at, not_into_lambda);
}

// vref_stmts is the scope-threaded statement walk behind vref_expr (so a
// variant name shadowed by a local `let` isn't flagged).
function vref_stmts(stmts: ast.Stmt[], s: Scope, ambig: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, vref_expr(v.init, cur, ambig));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, vref_expr(r.value, cur, ambig));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, vref_expr(x.value, cur, ambig));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, vref_expr(a.value, cur, ambig));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, vref_expr(f.cond, cur, ambig));
        out = util.append_diags(out, vref_stmts(f.then_body, cur, ambig));
        out = util.append_diags(out, vref_stmts(f.else_body, cur, ambig));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, vref_expr(w.cond, cur, ambig));
        out = util.append_diags(out, vref_stmts(w.body, cur, ambig));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, vref_expr(fr.iter, cur, ambig));
        out = util.append_diags(out, vref_stmts(fr.body, for_body_scope(fr, cur), ambig));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, vref_expr(m.scrutinee, cur, ambig));
        for arm in m.arms {
          out = util.append_diags(out, vref_stmts(arm.body, cur, ambig));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, vref_stmts(one, cur, ambig));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

// assign_diags checks one assignment `target = value`: the target is
// declared, and the value fits it.
function assign_diags(a: ast.StmtAssign, cur: Scope, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  if (!cur.defines(a.target)) {
    // E001: assignment to an undeclared name. An assignment
    // LHS can only be a local / param / loop / match binding
    // (field & index assignments are desugared to
    // __set_field / __set_index calls elsewhere), so a target
    // not in scope is unambiguously undefined — no function /
    // variant / builtin to confuse it with, hence no
    // allowlist needed. Reported at the `=` token (the
    // assignment position the parser captured).
    out = out.append(undefined_name(a.target, cur, a.target_line, a.target_col));
  } else if (cur.is_const_param(a.target)) {
    out = out.append(dg_at("E091", "cannot assign to const parameter " + a.target + ": it is the constant its instance is made for", a.target_line, a.target_col));
  } else {
    let tt: typeinfo.Type = cur.lookup(a.target);
    let vt: typeinfo.Type = check_expr(a.value, cur);
    out = util.append_diags(out, int_dest_range_diags(a.value, tt));
    out = util.append_diags(out, ctor_payload_diags(a.value, tt, cur));
    // The target's type is a generic call's destination, as a `let`
    // annotation's is.
    let abound: util.Diag[] = dest_bound_diags(a.value, tt, cur);
    out = util.append_diags(out, abound);
    let misfit: boolean = !settles_to(a.value, tt, cur) && !(type_assignable(vt, tt, unions) && dyn_conforms(vt, tt, cur));
    if (abound.len() == 0 && !is_unknown(tt) && !is_unknown(vt) && (misfit || fills_unsettled_argument(vt, tt))) {
      out = out.append(dg_at("E003", "variable \"" + a.target + "\": expected " + type_label(tt) + ", got " + type_label(vt) + str_copy_hint(vt, tt), a.line, a.col));
    }
  }
  return out;
}

// stmts_assign_diags walks a statement list (scope-threaded, recursing
// into nested blocks) emitting statement-level type diagnostics: E003
// when a value isn't assignable to its target (an annotated `let x: T = v`
// whose init type doesn't match T, or an assignment `x = v` whose value
// type doesn't match x's declared type), and E008 when an `if` / `while`
// condition isn't boolean. It reuses the same predicates check_stmt uses,
// so it fires exactly where the checker already flags the problem (no new
// false positives); unknown types are skipped.
// assign_stmt_own_lambdas checks the statements inside any lambda sitting in
// `st`'s own expressions. stmts_assign_diags walks STATEMENTS and never entered
// an expression, so nothing it reports was reported inside a lambda body —
// E001, E003, E008 and E024, which is the largest instance of that class the
// corpus sweep found (docs/SELF-HOST-AUDIT.md).
//
// Unlike the four collectors before it this one is SCOPE-THREADED, so the body
// cannot simply be handed back: a lambda body sees the enclosing scope plus its
// own params, and a `return` inside it returns from the LAMBDA. Both are built
// exactly as call_diags' ExprLambda arm builds them, so the two passes agree on
// what a lambda body's scope is rather than each inventing one.
//
// `cur` arrives as a PARAMETER because the caller reassigns its own per
// statement; pruned at ExprLambda because the recursive call already covers the
// whole body, nested lambdas included.
function assign_stmt_own_lambdas(st: ast.Stmt, cur: Scope, unions: UnionSig[]): util.Diag[] {
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, stmts_assign_diags(lm.body, lambda_body_scope(lm, cur), unions));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, not_into_lambda);
}

// init_fits reports whether a `let` initializer of type `t` fits its
// annotation. An owned array lends into a view annotation of its element.
function init_fits(init: ast.Expr, t: typeinfo.Type, declared: typeinfo.Type, s: Scope): boolean {
  return settles_to(init, declared, s) || semtypes.lends_array(t, declared) || coercible(t, declared, s);
}

function stmts_assign_diags(stmts: ast.Stmt[], s: Scope, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name) && !vb_placeholder_decl(v)) {
          let declared: typeinfo.Type = var_declared_type(v, cur);
          let initt: typeinfo.Type = check_expr(v.init, cur);
          if (!mlit_is_desugared(v.init)) {
            out = util.append_diags(out, e045_annot_diags(v.type_name, expr_line(v.init), expr_col(v.init), cur));
          }
          // E047: the annotation names the type every literal in the init is
          // read at, so one the type cannot hold is a range error rather than
          // the assignment mismatch it would otherwise be reported as.
          out = util.append_diags(out, int_dest_range_diags(v.init, declared));
          out = util.append_diags(out, ctor_payload_diags(v.init, declared, cur));
          let vbound: util.Diag[] = dest_bound_diags(v.init, declared, cur);
          out = util.append_diags(out, vbound);
          if (vbound.len() == 0 && !is_unknown(declared) && !is_unknown(initt) && !init_fits(v.init, initt, declared, cur)) {
            out = out.append(dg_at("E003", "variable \"" + v.name + "\": expected " + type_label(declared) + ", got " + type_label(initt) + str_copy_hint(initt, declared), v.line, v.col));
          }
          // An annotation naming no declared type (the E064 case) is a type
          // native cannot assign a typed init to either, so E003 stands
          // beside the E064 (#10965). An annotation this resolver merely
          // does not model stays unknown without either diagnostic.
          if (vbound.len() == 0 && is_unknown(declared) && !is_unknown(initt) && util.index_of_str(cur.tparams, v.type_name) < 0 && e064_unknown_bare(v.type_name, cur.type_names())) {
            out = out.append(dg_at("E003", "variable \"" + v.name + "\": expected " + v.type_name + ", got " + type_label(initt), v.line, v.col));
          }
        }
        // E047: an unannotated binding settles its literal-only init at i64
        // when a literal in it has no i32 reading (#3676 / #8668), so a
        // magnitude past i64 has nowhere left to go.
        if (v.type_name.len() == 0 && int_literal_tree(v.init)) {
          out = util.append_diags(out, int_range_diags(v.init, "i64", false));
        }
        // E024: a tuple destructure `let (a, b) = E` (the parser
        // encodes the names as "a,b") requires E to be a tuple whose
        // element count matches the number of names.
        out = util.append_diags(out, struct_destr_diags(v, cur));
        let positions: string[] = split_pattern_names(v.name);
        if (positions.len() > 1 && !parser.is_struct_destr_marker(v.type_name)) {
          out = util.append_diags(out, tuple_destr_diags(check_expr(v.init, cur), positions.len(), v.line, v.col));
        }
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, assign_diags(a, cur, unions));
      },
      ast.StmtIf(f) => {
        let ic: typeinfo.Type = check_expr(f.cond, cur);
        if (!is_unknown(ic) && !type_eq(ic, t_bool())) {
          out = out.append(dg_at("E008", "if condition must be boolean, got " + type_label(ic), expr_line(f.cond), expr_col(f.cond)));
        }
        out = util.append_diags(out, stmts_assign_diags(f.then_body, cur, unions));
        out = util.append_diags(out, stmts_assign_diags(f.else_body, cur, unions));
      },
      ast.StmtWhile(w) => {
        let wc: typeinfo.Type = check_expr(w.cond, cur);
        if (!is_unknown(wc) && !type_eq(wc, t_bool())) {
          out = out.append(dg_at("E008", "while condition must be boolean, got " + type_label(wc), expr_line(w.cond), expr_col(w.cond)));
        }
        out = util.append_diags(out, stmts_assign_diags(w.body, cur, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, stmts_assign_diags(fr.body, for_body_scope(fr, cur), unions));
      },
      ast.StmtMatch(m) => {
        for elem in m.arms {
          // Bind the arm's payload (if any) so an assignment to it
          // inside the body isn't mis-flagged as E001.
          let asc: Scope = cur;
          match (elem.pattern) {
            ast.PatVariant(apv) => {
              // A scalar-payload variant like `Has(i32)` binds
              // the inner value (the `__ev` payload type), not
              // the wrapper struct — bind_variant_payloads reads
              // the precise per-payload type so an assignment to
              // any payload binding type-checks the same way the
              // Go checker does (and a struct-union member still
              // binds its struct).
              asc = bind_variant_payloads(asc, cur, apv, check_expr(m.scrutinee, cur));
            },
            _ => {}
          }
          out = util.append_diags(out, stmts_assign_diags(elem.body, asc, unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, stmts_assign_diags(one, cur, unions));
      },
      _ => {}
    }
    out = util.append_diags(out, assign_stmt_own_lambdas(st, cur, unions));
    cur = bind_stmt(st, cur);
  }
  return out;
}

// check_module is the new entry point for sources that declare
// functions. Builds the sig table, walks each function body,
// and (separately) type-checks top-level stmts in a scope that
// has the sigs available — so `function main(): i32 { … }` and
// loose `let x = add(1, 2);` both resolve `add`.
pub struct ModuleTypes { sigs: FuncSig[], top_tys: typeinfo.Type[], all_well_typed: boolean, diags: util.Diag[] }

// is_build_gate_code reports whether `code` must reject a program before
// codegen: every coded diagnostic does, so a rule ported for parity gates the
// compile path the day it lands instead of being reachable only through
// `-check` (#6961). A code this checker raises on a program native accepts is
// a bug to fix, never a code to exempt here — an exemption list is how
// `xs == ys` came to compile to a pointer compare (#8461).
pub function is_build_gate_code(code: string): boolean {
  return util.is_diagnostic_code(code);
}

// build_gate_diags is what the compile path rejects a module for. Native folds
// consts before it type-checks and fails the build on a const its fold refuses;
// that refusal is uncoded, as native's is, so it gates here by where it comes
// from rather than by code.
pub function build_gate_diags(mod: parser.Module): util.Diag[] {
  return build_gate_diags_with_file(mod, "");
}

pub function build_gate_diags_with_file(mod: parser.Module, entry_file: string): util.Diag[] {
  let cgd: util.Diag[] = const_grammar_diags(mod);
  if (cgd.len() > 0) {
    return cgd;
  }
  return filter_build_gate(check_module_with_file(mod, entry_file).diags);
}

// Compiler-generated runtime modules use the private memory floor.
pub function build_runtime_gate_diags(mod: parser.Module): util.Diag[] {
  return build_runtime_gate_diags_with_file(mod, "");
}

pub function build_runtime_gate_diags_with_file(mod: parser.Module, entry_file: string): util.Diag[] {
  let cgd: util.Diag[] = const_grammar_diags(mod);
  if (cgd.len() > 0) {
    return cgd;
  }
  return filter_build_gate(check_module_raw_floor(mod, entry_file, true).diags);
}

// filter_build_gate keeps the diagnostics the compile path enforces.
pub function filter_build_gate(diags: util.Diag[]): util.Diag[] {
  let out: util.Diag[] = [];
  for diag in diags {
    if (is_build_gate_code(diag.code)) {
      out = out.append(diag);
    }
  }
  return out;
}

// dg builds a position-less diagnostic; dg_at attaches a 1-based source
// position. Most emitters use dg today and migrate to dg_at as their AST
// node gains a position.
function dg(code: string, message: string): util.Diag {
  return dg_at(code, message, 0, 0);
}

function dg_at(code: string, message: string, line: i32, col: i32): util.Diag {
  return util.Diag { related: [], length: 0, code: code, message: util.show_type_vars(message), line: line, col: col, fix: None };
}

// with_fix is `d` fixed by respelling `old`, written at `line`, `col`, as `to`,
// the fix's title ending in `note`; `d` itself when there is no `to` or no
// position.
function with_fix(d: util.Diag, old: string, line: i32, col: i32, to: string, note: string): util.Diag {
  if (to.len() == 0 || line <= 0) {
    return d;
  }
  return util.Diag { ...d, fix: Some(util.Fix { line: line, col: col, old: old, new_text: to, title: "replace `" + old + "` with `" + to + "`" + note }) };
}

// literal_field_fix is `d`, for field `i` of literal `sl`, which its struct
// does not declare, fixed by respelling the field as the closest of `fields`.
function literal_field_fix(d: util.Diag, sl: ast.ExprStructLit, i: i32, fields: string[]): util.Diag {
  if (i >= sl.field_lines.len()) {
    return d;
  }
  return with_fix(d, sl.field_names[i], sl.field_lines[i], sl.field_cols[i], util.suggest(sl.field_names[i], fields), "");
}

// member_fix is `d`, for an access to a member struct `st` lacks, fixed by
// respelling the member, written just past the access's `.`, as the closest
// of the struct's fields and then its methods.
function (s: Scope) member_fix(d: util.Diag, fa: ast.ExprFieldAccess, st: StructSig): util.Diag {
  return access_fix(d, fa, util.append_all(st.field_names, s.methods_in_namespace(st.name)));
}

// access_fix is `d`, for an access to a member its value lacks, fixed by
// respelling the member, written just past the access's `.`, as the closest
// of `members`.
function access_fix(d: util.Diag, fa: ast.ExprFieldAccess, members: string[]): util.Diag {
  return with_fix(d, fa.field, fa.line, fa.col + 1, util.suggest(fa.field, members), "");
}

function (s: Scope) method_fix(d: util.Diag, fa: ast.ExprFieldAccess, recv: typeinfo.Type): util.Diag {
  let ns: string = method_namespace_of(recv);
  if (retired_collection_spelling(ns, fa.field).len() > 0) {
    return d;
  }
  return access_fix(d, fa, s.method_fix_candidates(ns, recv));
}

// undefined_name is E001 for `name`, written at `line`, `col`, where nothing
// in `s` declares it. Its fix is a retired name's replacement, or else the
// closest name `s` can resolve.
function undefined_name(name: string, s: Scope, line: i32, col: i32): util.Diag {
  let d: util.Diag = util.Diag { ...dg_at("E001", "cannot find \"" + name + "\" in this scope", line, col), length: util.show_type_vars(name).len() };
  // A retired name is too far from its replacement for a respelling to find.
  if (name == "string_from_bytes") {
    return with_fix(d, name, line, col, "string_from_bytes_unchecked", " (or `std/utf8.from_bytes`, which validates and returns `Option[string]`)");
  }
  return with_fix(d, name, line, col, util.suggest(name, s.visible_names()), "");
}

// visible_names is every name `s` resolves: its bindings, innermost first,
// then the functions and builtins in name order. The Go checker lists them
// the same way, so a tie in util.suggest picks the same name in both.
function (s: Scope) visible_names(): string[] {
  let out: string[] = [];
  let i: i32 = s.names.len() - 1;
  while (i >= 0) {
    out = astwalk.append_bound_name(out, s.names[i]);
    i = i - 1;
  }
  let funcs: string[] = parser.builtin_function_names();
  for sig in s.sigs.sigs {
    if (sig.receiver.len() == 0) {
      funcs = funcs.append(sig.name);
    }
  }
  return util.append_all(out, util.sorted_by(funcs, name_after));
}

function name_after(a: string, b: string): boolean {
  return a > b;
}

// scalar_match_exhaustive_diags: E030 for a `match` on a number / string /
// boolean scrutinee that carries no unguarded `_` arm.
//
// Native requires the wildcard across every scalar domain but boolean, whose
// unguarded `true` and `false` arms close it (#6685); build_literal_match
// desugars that shape, so a boolean match reaching here is missing one.
// Reported at the `match` keyword, Go's `n.P`.
//
// A GUARDED `_` may fall through, so it does not count — the same rule the
// union arm above applies to a guarded variant arm.
//
// if-let / let-else desugars are skipped: their scrutinee is an enum and
// native reports E022 on a non-enum source, from a different path.
function scalar_match_exhaustive_diags(m: ast.StmtMatch, acc: util.Diag[], boolean_tag: boolean): util.Diag[] {
  if (m.origin.len() > 0) {
    return acc;
  }
  let saw_wild: boolean = false;
  for arm in m.arms {
    match (arm.pattern) {
      ast.PatWildcard(_) => {
        if (!arm.has_guard) {
          saw_wild = true;
        }
      },
      _ => {}
    }
  }
  if (saw_wild) {
    return acc;
  }
  if (boolean_tag) {
    return acc.append(dg_at("E030", "match on boolean is not exhaustive — add the missing `true` or `false` arm, or an unguarded `_`", m.line, m.col));
  }
  return acc.append(dg_at("E030", "match on non-enum value is not exhaustive — add an unguarded `_` arm", m.line, m.col));
}

// expr_line / expr_col read the 1-based source position off a positioned
// expression node (0 when the node doesn't yet carry one). Used by
// argument-level diagnostics (E038) that the Go checker reports at the
// argument's own position rather than the call's.
function expr_line(e: ast.Expr): i32 {
  return ast.expr_line(e);
}

function expr_col(e: ast.Expr): i32 {
  return ast.expr_col(e);
}

// dup_name_before reports whether names[idx] already appears at a lower
// index — the duplicate test shared by the declaration-level rules.
function dup_name_before(names: string[], idx: i32): boolean {
  let j: i32 = 0;
  while (j < idx) {
    if (names[j] == names[idx]) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

// collect_decl_diags emits the declaration-level coded diagnostics that
// are detectable from the decl tables alone (no positions, no type
// inference): E007 (a struct field name repeated) and E018 (a function
// parameter name repeated). These mirror the Go checker's E007 / E018.
// receiver_namespace is the method table a receiver spelling registers in: a
// `str` receiver shares the `string` methods, as native's ReceiverTypeName
// maps it.
function receiver_namespace(rt: string): string {
  if (rt == "str") {
    return "string";
  }
  return rt;
}

// receiver_type_ok reports whether a method's receiver type names a valid
// receiver — a primitive, or a declared struct / enum / union (alias). A
// generic / Map / array receiver (`X[...]`) or a `dyn Trait` object is
// skipped conservatively (so the E021 check never trips on shapes this
// port resolves coarsely). The base name is taken modulo `[...]`.
function receiver_type_ok(rt: string, mod: parser.Module): boolean {
  if (rt.len() == 0) {
    return true;
  }
  // Every name native's methodTypeName accepts belongs here, or the
  // width is a spurious E021 on every method declared with it — and,
  // because the receiver never registers, an E043 at every call site
  // too. `char` was added when std/unicode declared seven `char`
  // methods; `u8` when std/i32's 21 ascii classifiers moved onto the
  // byte type (both #5629). That is the same bug twice, so the whole
  // integer family is listed now rather than one width at a time.
  if (rt == "i32" || rt == "i64" || rt == "u8" || rt == "u32" || rt == "u64" || rt == "usize" || rt == "boolean" || rt == "string" || rt == "str" || rt == "f64" || rt == "f32" || rt == "char" || typeinfo.lanes_width(rt) > 0) {
    return true;
  }
  for ch in rt {
    if (ch == b'[') {
      return true;  // generic/Map/array
    }
  }
  if (rt.len() >= 4 && slice_unchecked(rt, 0, 4) == "dyn ") {
    return true;
  }
  let base: string = util.base_type_name(rt);
  if (parser.is_reserved_struct_name(base) || parser.is_reserved_enum_name(base)) {
    return true;
  }
  for sd in mod.structs {
    if (sd.name == base) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == base) {
      return true;
    }
  }
  for alias in mod.aliases {
    if (alias.name == base) {
      return true;
    }
  }
  return false;
}

// const_expr_ok reports whether `e` is inside native's constant grammar
// (internal/check/constfold evalConst): a literal, a reference to an EARLIER const,
// a unary / binary operation over those, or an array (#7987), tuple or struct
// (#6685) literal of them. Everything else — a call, a field access, an
// index, a struct update — is not a constant.
// `earlier` is the names of the consts declared before this one, so a forward
// reference is rejected the way native's sequential fold rejects it.
// Returns "" when `e` is constant, else the message tail native reports.
// A non-earlier IDENT gets its own wording there, so it is reproduced rather
// than folded into the generic one.
function const_expr_err(e: ast.Expr, earlier: string[]): string {
  match (e) {
    ast.ExprBytes(_) => {
      return "";
    },
    ast.ExprNumber(_) => {
      return "";
    },
    ast.ExprString(_) => {
      return "";
    },
    ast.ExprBool(_) => {
      return "";
    },
    ast.ExprIdent(id) => {
      if (util.has_str(earlier, id.name)) {
        return "";
      }
      return "\"" + id.name + "\" is not a constant (must reference an earlier `const` declaration)";
    },
    ast.ExprUnary(u) => {
      if (util.str_has_prefix(u.op, "as_")) {
        return "expression is not a constant (only literals, earlier consts, and arithmetic / comparison / logical operations on them are allowed)";
      }
      return const_expr_err(u.operand, earlier);
    },
    ast.ExprArray(a) => {
      return const_elems_err(a.elements, earlier);
    },
    ast.ExprTuple(t) => {
      return const_elems_err(t.elements, earlier);
    },
    ast.ExprStructLit(st) => {
      if (st.has_base) {
        return "expression is not a constant (only literals, earlier consts, and arithmetic / comparison / logical operations on them are allowed)";
      }
      return const_elems_err(st.field_values, earlier);
    },
    ast.ExprBinary(b) => {
      if (const_refused_op(b.op)) {
        return "operator `" + b.op + "` not allowed in integer constant expressions";
      }
      let le: string = const_expr_err(b.left, earlier);
      if (le.len() > 0) {
        return le;
      }
      return const_expr_err(b.right, earlier);
    },
    _ => {}
  }
  return "expression is not a constant (only literals, earlier consts, and arithmetic / comparison / logical operations on them are allowed)";
}

// const_elems_err is const_expr_err's answer for the first element of an
// array, tuple or struct literal that is not constant, "" when all are.
function const_elems_err(elems: ast.Expr[], earlier: string[]): string {
  for el in elems {
    let ee: string = const_expr_err(el, earlier);
    if (ee.len() > 0) {
      return ee;
    }
  }
  return "";
}

// const_grammar_diags: a const whose initialiser is outside the constant
// grammar (const_expr_err) is refused at the const's own position, as native
// refuses it (#6618).
//
// The diagnostic is UNCODED, matching native: an empty `code` renders as
// `<line>:<col>: error: <message>` with no `[…]` code.
function const_grammar_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let earlier: string[] = [];
  for fd in mod.funcs {
    // An associated constant is a function body, free to read `T.LANES`.
    if (fd.is_const && fd.receiver_type.len() == 0) {
      for stmt in fd.body {
        match (stmt) {
          ast.StmtReturn(r) => {
            let msg: string = const_expr_err(r.value, earlier);
            if (msg.len() > 0) {
              out = out.append(dg_at("", "const " + fd.name + ": " + msg, fd.line, fd.col));
            }
          },
          _ => {}
        }
      }
      earlier = earlier.append(fd.name);
    }
  }
  return out;
}

// is_script: top-level statements with no `main`, which become the body of a
// synthesized `function main(): i32` (asmcore.synth_script_main), so their
// returns are checked against i32.
function is_script(mod: parser.Module): boolean {
  for fd in mod.funcs {
    if (fd.name == "main" && fd.receiver_type.len() == 0) {
      return false;
    }
  }
  return mod.top_stmts.len() > 0;
}

// E075 belongs to the automatic init/handle wiring. A user-written main owns
// that wiring instead. Match native's declaration lookup: methods named init
// or handle are not lifecycle entries, and imported names remain qualified.
function handler_state_diags(mod: parser.Module): util.Diag[] {
  let init_idx: i32 = -1;
  let handle_idx: i32 = -1;
  let i: i32 = 0;
  for fd in mod.funcs {
    if (fd.name == "main") {
      return [];
    }
    if (fd.receiver_type.len() == 0) {
      if (fd.name == "init" && init_idx < 0) {
        init_idx = i;
      }
      if (fd.name == "handle" && handle_idx < 0) {
        handle_idx = i;
      }
    }
    i = i + 1;
  }
  if (handle_idx < 0) {
    return [];
  }
  let returns_state: boolean = false;
  if (init_idx >= 0) {
    let init_fd: parser.FuncDecl = mod.funcs[init_idx];
    if (init_fd.params.len() > 1 || init_fd.params.len() == 1 && !parser.is_platform_param(init_fd, 0, parser.std_qualifier(mod, "platform"))) {
      return [dg_at("E075", "`init` takes " + util.i32_to_string(init_fd.params.len()) + " parameters; it takes none, or the platform alone", init_fd.line, init_fd.col)];
    }
    let kind: i32 = parser.init_return_kind(init_fd.ret_type, parser.std_qualifier(mod, "serve"));
    returns_state = kind == 1 || kind == 3;
  }
  let handle: parser.FuncDecl = mod.funcs[handle_idx];
  let takes_state: boolean = handle.params.len() == 3;
  if (takes_state && !returns_state) {
    return [dg_at("E075", "handler takes a state parameter, but no `init` produces the state to thread through it", handle.line, handle.col)];
  }
  if (returns_state && !takes_state) {
    let init: parser.FuncDecl = mod.funcs[init_idx];
    return [dg_at("E075", "`init` returns a value, but the handler takes no state parameter to thread it through", init.line, init.col)];
  }
  // `shutdown(reason)` or `shutdown(reason, state)`: the state parameter
  // follows the handler's, since the loop hands the hook the state as the
  // last request left it.
  let j: i32 = 0;
  for fd in mod.funcs {
    if (fd.name == "shutdown" && fd.receiver_type.len() == 0) {
      if (fd.params.len() == 2 && !takes_state) {
        return [dg_at("E075", "`shutdown` takes a state parameter, but no `init` produces the state to hand it", fd.line, fd.col)];
      }
      if (fd.params.len() == 1 && takes_state) {
        return [dg_at("E075", "`shutdown` takes no state parameter, but the handler threads a state it would drop", fd.line, fd.col)];
      }
      return [];
    }
    j = j + 1;
  }
  return [];
}

// e078_payload_count returns how many payloads the variant `vname` of enum
// `ename` carries. A variant is a StructDecl whose enum_owner names the enum;
// its fields ARE the payloads, so the count is the field count.
function e078_payload_count(structs: parser.StructDecl[], ename: string, vname: string): i32 {
  for sd in structs {
    if (sd.enum_owner == ename && sd.name == vname) {
      return sd.fields.len();
    }
  }
  return 0 - 1;
}

// e078_diags reports an `@try` enum whose shape `?` cannot lower against.
//
// Mirrors native's registerTryShape exactly — exactly two variants, the first
// carrying exactly one payload and the second at most one — so the marker's
// RULE is enforced by both compilers even while only native can lower `?` on a
// marked enum. See docs/TRY.md.
function e078_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for ed in mod.enums {
    if (ed.try_marker) {
      if (ed.variant_names.len() != 2) {
        out = out.append(dg_at("E078", "@try enum " + ed.name + " must have exactly two variants — a success variant then a failure variant — but has " + util.i32_to_string(ed.variant_names.len()), ed.line, ed.col));
      } else {
        let ok_n: i32 = e078_payload_count(mod.structs, ed.name, ed.variant_names[0]);
        let fail_n: i32 = e078_payload_count(mod.structs, ed.name, ed.variant_names[1]);
        if (ok_n >= 0 && ok_n != 1) {
          out = out.append(dg_at("E078", "@try enum " + ed.name + ": the success variant \"" + ed.variant_names[0] + "\" must carry exactly one payload, but carries " + util.i32_to_string(ok_n), ed.line, ed.col));
        } else {
          if (fail_n > 1) {
            out = out.append(dg_at("E078", "@try enum " + ed.name + ": the failure variant \"" + ed.variant_names[1] + "\" must carry at most one payload, but carries " + util.i32_to_string(fail_n), ed.line, ed.col));
          }
        }
      }
    }
  }
  return out;
}

// E079Probe carries the first `?` a defer action reaches, for e079_diags.
struct E079Probe { found: boolean, line: i32, col: i32 }

// e079_note_try records the first `try_` unary — the `?` operator, as
// parser.fern desugars it — and ignores every later one, so a defer with two
// draws one diagnostic.
function e079_note_try(e: ast.Expr, own acc: E079Probe): E079Probe {
  if (acc.found) {
    return acc;
  }
  if let ast.ExprUnary(u) = e {
    if (u.op == "try_") {
      return E079Probe { found: true, line: u.line, col: u.col };
    }
  }
  return acc;
}

// e079_not_lambda keeps the walk out of a lambda body: a `?` there leaves the
// LAMBDA on its own exits, not the function whose defer replays the action, so
// it is an ordinary use.
// A value block is the exception, and it parses to the identical shape (#9553).
// `(match (k) { … })` and the if-expression / comprehension forms desugar to a
// zero-arg call of a zero-param lambda, which the lowering INLINES rather than
// lowering as a function — `lower_defers_body` excludes them from the per-scope
// defer lowering for that reason. So a `?` inside one leaves the ENCLOSING
// function after all, which is what makes it E079 rather than an ordinary use.
// Only `origin` separates the two, since a hand-written IIFE parses the same.
function e079_not_lambda(e: ast.Expr): boolean {
  if let ast.ExprLambda(lam) = e {
    return parser.is_value_block_origin(lam.origin);
  }
  return true;
}

// e079_no_expr is the expression half of the walk, for a scan whose whole
// contribution is statement-shaped.
function e079_no_expr(e: ast.Expr, own acc: util.Diag[]): util.Diag[] {
  return acc;
}

// e079_diags reports `?` inside a `defer` / `errdefer` action (#9470).
//
// Mirrors native's rule in checker.go's StmtDefer arm. The shape is circular:
// `?` leaves by the failure edge, which replays the deferred actions, one of
// which carries this `?`. Both compilers recursed until they died on it.
//
// Refused rather than lowered: `?` propagates a failure to the caller, and a
// deferred action has no caller to propagate to.
function e079_diags(mod: parser.Module): util.Diag[] {
  // fold_stmt_nodes rather than fold_stmt_spine: the spine enters no
  // expression, so a `defer` inside a LAMBDA body stayed out of reach and the
  // self-host accepted what native refused. A defer there registers on the
  // lambda's own exits, and a `?` in its action is the same circular shape one
  // level down. The expression half contributes nothing, so it is a no-op.
  let out: util.Diag[] = [];
  for fd in mod.funcs {
    for stmt in fd.body {
      out = astwalk.fold_stmt_nodes(stmt, out, e079_visit_stmt, e079_no_expr, astwalk.descend_all);
    }
  }
  return out;
}

function e079_visit_stmt(st: ast.Stmt, own acc: util.Diag[]): util.Diag[] {
  if let ast.StmtDefer(d) = st {
    let probe: E079Probe = astwalk.fold_stmt_pruned(
      d.action,
      E079Probe { found: false, line: 0, col: 0 }, e079_note_try, e079_not_lambda,
    );
    if (probe.found) {
      let kind: string = "a `defer`";
      if (d.on_error != 0) {
        kind = "an `errdefer`";
      }
      return acc.append(dg_at("E079", "`?` is not allowed inside " + kind + " action: it propagates a failure to the caller, and a deferred action has no caller to propagate to", probe.line, probe.col));
    }
  }
  return acc;
}

// registered_intrinsics are the `__` names native registers a signature for
// before it reads a program; TestSelfHostRegisteredIntrinsicsMatch pins the
// list entry for entry.
function registered_intrinsics(): string[] {
  return [
    "__task_cancelled", "__task_cur", "__task_enter", "__task_free", "__task_leave", "__task_new", "__task_park", "__task_set_cancelled", "__task_set_ready", "__task_timeout", "__task_wait",
    "__abs_f64", "__aes_ctr32", "__aes_expand_key", "__aes_gcm_open", "__aes_gcm_seal", "__ghash", "__sha256_hw", "__sha256_hw_blocks", "__sha1_hw", "__sha1_hw_blocks", "__alloc", "__alloc_bool", "__alloc_i32", "__alloc_i64", "__alloc_reuse", "__alloc_u8", "__arr_push_shared_bytes", "__arr_push_shared_count", "__arr_set_len",
    "__ascii_run", "__bsd_sum", "__c_call0", "__c_call0_f32", "__c_call0_f64", "__c_call1", "__c_call1_f32",
    "__c_call1_f64", "__c_call2", "__c_call2_f32", "__c_call2_f64", "__c_call3", "__c_call3_f32", "__c_call3_f64",
    "__c_call4", "__c_call4_f32", "__c_call4_f64", "__ceil_f64", "__clz32", "__clz64", "__count_byte",
    "__bytes_into", "__bytes_owned", "__bytes_range", "__count_runs", "__count_runs_bytes", "__crc32_cksum", "__ct_public", "__ct_secret", "__ctz32", "__ctz64", "__fern_arr_dec", "__fern_box_free", "__fern_drop_arr_ptr",
    "__fern_rc_dec", "__fern_rc_inc", "__fern_str_dec", "__floor_f64", "__free", "__heap_alloc_count", "__heap_bump_bytes",
    "__account_entry", "__heap_mark", "__heap_release_to", "__load_i32", "__load_i64", "__load_ptr", "__load_u8",
    "__map_hash_seed", "__memchr", "__mulhi_u64", "__count_byte_bytes", "__crc32_cksum_array", "__sum_bytes_array", "__bsd_sum_bytes", "__memchr_bytes", "__mismatch_bytes", "__mismatch_bytes_str", "__rmemchr_bytes", "__memcpy", "__memset", "__mismatch", "__popcount32", "__popcount64",
    "__ptr_width", "__rc_dec", "__rc_get", "__rc_inc", "__rc_underflow_count", "__rmemchr",
    "__round_f64", "__scale_f64", "__outer_mul_f64", "__inner_mul_add_f64", "__scan_set", "__scan_set_bytes", "__sqrt_f64", "__store_i32", "__store_i64",
    "__store_ptr", "__store_u8", "__str_bytes", "__str_hash", "__sum_bytes", "__syscall3", "__syscall4", "__syscall5", "__syscall6", "__trunc_f64",
    "__f64x2_splat", "__f64x2_of", "__f64x2_lane", "__f64x2_bitmask", "__f64x2_mul_add", "__f64x2_sqrt", "__f64x2_abs", "__f64x2_floor", "__f64x2_round", "__f64x2_min", "__f64x2_max", "__f64x2_lt", "__f64x2_ne", "__f64x2_select", "__f64x2_load", "__f64x2_with",
    "__f32x4_splat", "__f32x4_of", "__f32x4_lane", "__f32x4_bitmask", "__f32x4_mul_add", "__f32x4_sqrt", "__f32x4_abs", "__f32x4_floor", "__f32x4_round", "__f32x4_min", "__f32x4_max", "__f32x4_lt", "__f32x4_ne", "__f32x4_select", "__f32x4_load", "__f32x4_with",
  ];
}

// redeclares reports whether funcs[di] redeclares an earlier function, method
// or associated function, or a surface builtin.
function redeclares(funcs: parser.FuncDecl[], names: util.NameIndex, di: i32): boolean {
  let f2: parser.FuncDecl = funcs[di];
  let earlier: boolean = redeclares_preregistered(f2);
  let ej: i32 = names.chain(decl_key(f2));
  while (ej >= 0 && ej < di) {
    let pe: parser.FuncDecl = funcs[ej];
    // Key redeclaration on the receiver TYPE, not the receiver NAME:
    // an ASSOCIATED function (`impl Default for i32 { function default()
    // }`) has an empty receiver_name (no `self`) but a SET receiver_type
    // (`i32`). Keying on receiver_name mis-merged every type's `default`
    // into one "free function" and flagged E006 across distinct impls
    // (i32.default vs i64.default …). Free functions have NO receiver
    // type on either side; type-associated decls (methods OR associated
    // fns) collide only when name AND receiver type both match.
    if (f2.receiver_type.len() == 0 && pe.receiver_type.len() == 0 && pe.name == f2.name) {
      earlier = true;
    }
    if (same_method_decl(pe, f2)) {
      earlier = true;
    }
    ej = names.next[ej];
  }
  // A free function named like a builtin or an intrinsic redeclares it, as
  // native's pre-registered signature makes it there.
  if (f2.receiver_type.len() == 0 && (builtin_row(f2.name).len() > 0 || util.has_str(registered_intrinsics(), f2.name))) {
    earlier = true;
  }
  return earlier;
}

// A method on a built-in namespace named like one the checker registers
// there before any declaration (preregistered_methods) redeclares it, as
// native's pre-registered table makes it.
function redeclares_preregistered(f2: parser.FuncDecl): boolean {
  if (f2.receiver_type.len() == 0) {
    return false;
  }
  return util.has_str(preregistered_methods(parser.receiver_namespace(f2.receiver_type)), f2.name);
}

// decl_key is the name a redeclaration is keyed on: a free function's own, or
// a method's simple name, which the bundler interposes with its module when an
// earlier module claimed it (`Array.num.sum`).
function decl_key(fd: parser.FuncDecl): string {
  if (fd.receiver_type.len() == 0) {
    return fd.name;
  }
  return method_simple_name(fd.name);
}

// same_method_decl: two declarations of one method by the same provider, the
// type itself or one trait. An inherent method and a trait's are an ambiguity
// (method_ambiguity_diags), not a redeclaration.
function same_method_decl(pe: parser.FuncDecl, f2: parser.FuncDecl): boolean {
  if (f2.receiver_type.len() == 0 || pe.receiver_type.len() == 0 || decl_key(pe) != decl_key(f2)) {
    return false;
  }
  return pe.impl_trait == f2.impl_trait && parser.receiver_namespace(pe.receiver_type) == parser.receiver_namespace(f2.receiver_type);
}

// method_ambiguity_diags reports E074 where one type gets a method name from
// both an inherent declaration and a trait impl, in either order: a silent pick
// would give one spelling two meanings. Declarations register in native's
// order, the entry's first, and the later one of a clashing pair is reported,
// at whichever of the two the program wrote rather than at a standard-library
// one. Two traits providing one name are not ambiguous here; the call site
// ranks them.
function method_ambiguity_diags(mod: parser.Module): util.Diag[] {
  let order: i32[] = [];
  for entry in [true, false] {
    let i: i32 = 0;
    while (i < mod.funcs.len()) {
      let in_entry: boolean = mod.funcs[i].module.len() == 0;
      if (in_entry == entry && mod.funcs[i].receiver_type.len() > 0) {
        order = order.append(i);
      }
      i = i + 1;
    }
  }
  let keys: string[] = [];
  let inherent: i32[] = [];
  let traited: i32[] = [];
  let out: util.Diag[] = [];
  for fi in order {
    let fd: parser.FuncDecl = mod.funcs[fi];
    let key: string = parser.receiver_namespace(fd.receiver_type) + "." + method_simple_name(fd.name);
    let k: i32 = util.index_of_str(keys, key);
    if (k < 0) {
      k = keys.len();
      keys = keys.append(key);
      inherent = inherent.append(0 - 1);
      traited = traited.append(0 - 1);
    }
    let other: i32 = inherent[k];
    if (fd.impl_trait.len() == 0) {
      other = traited[k];
    }
    if (other >= 0) {
      out = out.append(ambiguous_method_diag(mod, fd, mod.funcs[other]));
    } else if (fd.impl_trait.len() == 0) {
      inherent = inherent.with(k, fi);
    } else if (traited[k] < 0) {
      traited = traited.with(k, fi);
    }
  }
  return out;
}

// A trait's method can be renamed `Trait.m` (claim_method_name) or interposed
// `ns.m` (flatten); its name as written is the last segment.
function method_simple_name(name: string): string {
  let i: i32 = name.len() - 1;
  while (i >= 0 && name[i] != b'.') {
    i = i - 1;
  }
  return slice_unchecked(name, i + 1, name.len()) + "";
}

function ambiguous_method_diag(mod: parser.Module, pending: parser.FuncDecl, other: parser.FuncDecl): util.Diag {
  let at: parser.FuncDecl = pending;
  if (pending.stdlib.len() > 0 && other.stdlib.len() == 0) {
    at = other;
  }
  let typ: string = util.demangle(parser.receiver_namespace(pending.receiver_type));
  let msg: string = "ambiguous method \"" + method_simple_name(pending.name) + "\" on " + typ + ": provided by " + method_provider(mod, pending) + " and " + method_provider(mod, other);
  return dg_at("E074", msg, at.line, at.col);
}

// method_provider names a candidate as native's E074 does: the trait, or "an
// inherent method", and where it was declared. A module's file is labelled as
// native labels it; the entry's position goes unlabelled, as the checker is
// not told the entry's file name.
function method_provider(mod: parser.Module, fd: parser.FuncDecl): string {
  let what: string = "an inherent method";
  if (fd.impl_trait.len() > 0) {
    what = "trait " + impl_trait_spelling(mod, fd);
  }
  let file: string = "";
  if (fd.stdlib.len() > 0) {
    file = fd.stdlib + ".fern:";
  } else if (fd.module.len() > 0) {
    file = fd.module + ".fern:";
  }
  return what + " (declared at " + file + util.i32_to_string(util.pos_line(fd.line)) + ":" + util.i32_to_string(fd.col) + ")";
}

// The trait a method was written for, `module.Trait` when another module
// declares it, as the impl that carries it records.
function impl_trait_spelling(mod: parser.Module, fd: parser.FuncDecl): string {
  let base: string = parser.receiver_namespace(fd.receiver_type);
  for im in mod.impls {
    if (im.trait_name == fd.impl_trait && im.trait_module.len() > 0 && parser.receiver_namespace(im.impl_type) == base) {
      return im.trait_module + "." + fd.impl_trait;
    }
  }
  return fd.impl_trait;
}

// orphan_impl_diags is native's coherence rule: an impl of a trait is legal
// only in the module that declares the trait or the type. A built-in type is
// declared in none, so a foreign trait's impl for one is an orphan anywhere.
function orphan_impl_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for im in mod.impls {
    if (im.trait_name.len() == 0 || im.trait_module == im.module || impl_type_is_local(mod, im)) {
      continue;
    }
    let tr: string = im.trait_name;
    if (im.trait_module.len() > 0) {
      tr = im.trait_module + "." + tr;
    }
    out = out.append(dg_at("E021", "orphan impl: `impl " + tr + " for " + util.demangle(util.base_type_name(im.impl_type)) + "` must be declared in the module that defines the trait or the type", im.line, im.col));
  }
  return out;
}

// A module's own declarations carry its `prefix__` mangling; the entry's carry
// none.
function impl_type_is_local(mod: parser.Module, im: parser.ImplInfo): boolean {
  let base: string = util.base_type_name(im.impl_type);
  if (!declares_nominal(mod, base)) {
    return false;
  }
  if (im.module.len() == 0) {
    return !util.contains(base, "__");
  }
  return util.str_has_prefix(base, im.module + "__");
}

function declares_nominal(mod: parser.Module, name: string): boolean {
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == name) {
      return true;
    }
  }
  return false;
}

// main_signature_diags appends E084 for the entry point `main`: every runner
// calls it with no arguments and turns its result into the exit status, which
// an integer or a boolean can be and nothing else can. Mirrors the Go
// checker's checkMainSignature.
function main_signature_diags(fd: parser.FuncDecl, out: util.Diag[]): util.Diag[] {
  if (fd.params.len() > 0) {
    out = out.append(dg_at("E084", "main takes no parameters; read the command line with args()", fd.line, fd.col));
  }
  if (fd.ret_type != "" && !main_result_ty(fd.ret_type)) {
    out = out.append(dg_at("E084", "main returns an integer, a boolean or void, not " + fd.ret_type, fd.line, fd.col));
  }
  return out;
}

// E006: a resource redeclared, or named like a struct, enum or union alias.
// registered_resources leaves it out, so the name keeps its other meaning.
function resource_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let rn: i32 = 0;
  while (rn < mod.resources.len()) {
    let rclash: string = parser.resource_collision(mod, rn);
    let rdecl: parser.ResourceDecl = mod.resources[rn];
    if (rclash == "resource") {
      out = out.append(dg_at("E006", "resource \"" + rdecl.name + "\" redeclared", rdecl.line, rdecl.col));
    } else if (rclash.len() > 0) {
      let article: string = "a ";
      if (rclash == "enum") {
        article = "an ";
      }
      out = out.append(dg_at("E006", "resource \"" + rdecl.name + "\" conflicts with " + article + rclash + " of the same name", rdecl.line, rdecl.col));
    }
    rn = rn + 1;
  }
  return out;
}

// E081: a named function that declares no return type. Every function
// writes its return type — `: void` when it returns nothing — so an
// omitted one is an error, not an inference request, and an empty body
// is no exception. `@import` externs are exempt (they carry a signature,
// not a definition). Mirrors the Go checker's checkFunction rule.
function return_type_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for func in mod.funcs {
    if (func.ret_type == "" && func.body.len() > 0 && func.is_const) {
      out = out.append(dg_at("E081", "cannot infer the type of const \"" + func.name + "\"; declare it explicitly", func.line, func.col));
    } else if (func.ret_type == "" && func.import_iface == "" && !func.is_const) {
      out = out.append(dg_at("E081", "missing return type on function \"" + func.name + "\"; declare it explicitly (use `: void` if it returns nothing)", func.line, func.col));
    }
  }
  for func in mod.funcs {
    if (func.name == "main" && func.receiver_type == "" && func.import_iface == "") {
      out = main_signature_diags(func, out);
    }
  }
  return out;
}

// E016: a `type X = …` union alias the Go checker refuses to desugar, and
// E006: one that desugars into an enum whose name is taken. Both are reported
// at the alias's `type` keyword, and the alias is then not an enum.
function alias_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let ak: i32 = 0;
  while (ak < mod.aliases.len()) {
    let alias: parser.TypeAlias = mod.aliases[ak];
    for msg in parser.union_alias_errors(mod, alias) {
      out = out.append(dg_at("E016", msg, alias.line, alias.col));
    }
    if (parser.alias_redeclares_enum(mod, ak)) {
      out = out.append(dg_at("E006", "enum \"" + alias.name + "\" redeclared", alias.line, alias.col));
    }
    ak = ak + 1;
  }
  return out;
}

// E054: an `@export(...)` function bound to a WIT world export cannot be
// generic (a world export is lifted with a single concrete canonical
// ABI) and cannot be a method (the export surface is for top-level
// functions). The binding is recorded on mod.exports by func name; we
// look the function up to read its type-param count + receiver.
function export_shape_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for export in mod.exports {
    let ename: string = export.func_name;
    for xfd in mod.funcs {
      if (xfd.name == ename) {
        if (xfd.all_type_params.len() > 0) {
          out = out.append(dg_at("E054", "@export function \"" + xfd.name + "\" cannot be generic (a world export has a single concrete ABI)", xfd.line, xfd.col));
        }
        if (xfd.receiver_name.len() > 0) {
          out = out.append(dg_at("E054", "@export cannot be applied to a method (\"" + xfd.name + "\"); use a top-level function", xfd.line, xfd.col));
        }
      }
    }
  }
  return out;
}

function collect_decl_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = util.append_diags([], const_grammar_diags(mod));
  out = util.append_diags(out, handler_state_diags(mod));
  out = util.append_diags(out, e078_diags(mod));
  out = util.append_diags(out, e079_diags(mod));
  // E007: duplicate field within a struct (enum-variant structs carry at
  // most one `__ev` field, so they never trip this).
  for sd in mod.structs {
    let fnames: string[] = [];
    for field in sd.fields {
      fnames = fnames.append(field.name);
    }
    let fk: i32 = 0;
    while (fk < fnames.len()) {
      if (dup_name_before(fnames, fk)) {
        out = out.append(dg_at("E007", "duplicate field \"" + fnames[fk] + "\" in struct " + sd.name, sd.line, sd.col));
      }
      fk = fk + 1;
    }
  }
  // E018: duplicate parameter within a function.
  for fd in mod.funcs {
    let pnames: string[] = [];
    for param in fd.params {
      pnames = pnames.append(param.name);
    }
    for cp in const_tparams(fd) {
      pnames = pnames.append(cp);
    }
    let pk: i32 = 0;
    while (pk < pnames.len()) {
      if (dup_name_before(pnames, pk)) {
        out = out.append(dg_at("E018", "duplicate parameter \"" + pnames[pk] + "\"", fd.line, fd.col));
      }
      pk = pk + 1;
    }
  }
  // E006: a free function redeclared (same name, both receiver-less), or
  // a method redeclared (same name AND receiver namespace). The redeclaration
  // SITE — the second + occurrences — is flagged, matching the Go
  // checker.
  let decl_names: string[] = [];
  for fd in mod.funcs {
    decl_names = decl_names.append(decl_key(fd));
  }
  out = util.append_diags(out, method_ambiguity_diags(mod));
  let decl_index: util.NameIndex = util.name_index(decl_names);
  let di: i32 = 0;
  while (di < mod.funcs.len()) {
    let f2: parser.FuncDecl = mod.funcs[di];
    if (redeclares(mod.funcs, decl_index, di)) {
      if (f2.receiver_type.len() == 0) {
        out = out.append(dg_at("E006", "function \"" + f2.name + "\" redeclared", f2.line, f2.col));
      } else {
        out = out.append(dg_at("E006", "method \"" + decl_key(f2) + "\" on " + parser.receiver_namespace(f2.receiver_type) + " redeclared", f2.line, f2.col));
      }
    }
    // E021: a method whose receiver type isn't a known struct / enum /
    // union (or a primitive / generic / dyn receiver), reported at the
    // method declaration.
    if (f2.receiver_name.len() > 0 && !receiver_type_ok(f2.receiver_type, mod)) {
      out = out.append(dg_at("E021", "method receiver type must be a struct, enum, array, slice, or built-in type, got " + util.base_type_name(f2.receiver_type), f2.line, f2.col));
    }
    di = di + 1;
  }
  // E006: struct redeclared. mod.structs is the FLAT table: enum variant
  // payloads land there too (tagged with their owning enum via
  // enum_owner), and desugars synthesize `__`-prefixed entries — both are
  // skipped so only genuine user struct declarations collide.
  let sn2: i32 = 0;
  while (sn2 < mod.structs.len()) {
    let s2: parser.StructDecl = mod.structs[sn2];
    let user_struct: boolean = s2.enum_owner.len() == 0 && !(s2.name.len() >= 2 && slice_unchecked(s2.name, 0, 2) == "__");
    if (user_struct) {
      let sdup: boolean = false;
      let sj2: i32 = 0;
      while (sj2 < sn2) {
        if (mod.structs[sj2].enum_owner.len() == 0 && mod.structs[sj2].name == s2.name) {
          sdup = true;
        }
        sj2 = sj2 + 1;
      }
      if (sdup) {
        out = out.append(dg_at("E006", "struct \"" + s2.name + "\" redeclared", s2.line, s2.col));
      }
      // E010: a user struct taking a reserved built-in name, struct or enum. The
      // line guard is native's `existing.P == ast.Position{}` check: a
      // synthetic re-entry carries no position and is the compiler's own
      // injection, not a user redeclaration.
      if (s2.line > 0 && (parser.is_reserved_struct_name(s2.name) || parser.is_reserved_enum_name(s2.name))) {
        out = out.append(dg_at("E010", "struct \"" + s2.name + "\" is a reserved built-in name and cannot be redeclared", s2.line, s2.col));
      }
    }
    sn2 = sn2 + 1;
  }
  // E006: enum redeclared, and E017: duplicate variant within an enum.
  // These need the enum -> variants grouping the parser preserves in
  // mod.enums (the flat struct table can't tell a variant from a
  // struct).
  let en: i32 = 0;
  while (en < mod.enums.len()) {
    let edup: boolean = false;
    let ej2: i32 = 0;
    while (ej2 < en) {
      if (mod.enums[ej2].name == mod.enums[en].name) {
        edup = true;
      }
      ej2 = ej2 + 1;
    }
    if (edup) {
      out = out.append(dg_at("E006", "enum \"" + mod.enums[en].name + "\" redeclared", mod.enums[en].line, mod.enums[en].col));
    }
    // E010: a user enum taking a reserved built-in name, enum or struct.
    if (parser.is_reserved_enum_name(mod.enums[en].name) || parser.is_reserved_struct_name(mod.enums[en].name)) {
      out = out.append(dg_at("E010", "enum \"" + mod.enums[en].name + "\" is a reserved built-in name and cannot be redeclared", mod.enums[en].line, mod.enums[en].col));
    }
    let vn: string[] = mod.enums[en].variant_names;
    let vk: i32 = 0;
    while (vk < vn.len()) {
      if (dup_name_before(vn, vk)) {
        out = out.append(dg_at("E017", "duplicate variant \"" + vn[vk] + "\" in enum " + mod.enums[en].name, mod.enums[en].line, mod.enums[en].col));
      }
      vk = vk + 1;
    }
    en = en + 1;
  }
  out = util.append_diags(out, resource_diags(mod));
  out = util.append_diags(out, return_type_diags(mod));
  out = util.append_diags(out, alias_diags(mod));
  out = util.append_diags(out, export_shape_diags(mod));
  return out;
}

// strip_generic_args drops a `[...]` argument list from a (possibly
// generic) receiver/type spelling: `Box[T]` -> `Box`, `P` -> `P`. Used so
// a method's receiver identity and message render by base struct name.
// strip_generic_args -> util.base_type_name (SH-020).
// ===================== owned-parameter move checking (E050/E051) =========
// Affine analysis for `own` parameters: using an owned value after it has
// been consumed (moved) is E050; passing a non-owned value to an `own`
// parameter is E051. A "consume" is a whole-value use of the bare owned
// param (returned, passed as a call argument, matched, bound); a "borrow"
// is a projection (`x.field`, `x[i]`, a method receiver `x.m()`, a call
// callee) which reads through without ending its life. Ports the core of
// the Go checker's checkOwnedParams; conservative where the self-host
// lacks the type detail (no match-payload ownership transfer, no
// dyn-trait consuming methods) — it under-reports rather than over-reports.
pub struct OwnFunc { name: string, flags: boolean[], arr: boolean[] }

// OwnFuncs is the module's own-taking free functions with a name index over
// them, one entry per row in order, beside the module's declared type names:
// `structs` holds every struct name and every enum that owns one, `decls` the
// enum and union-alias names only a whole module carries, and `ctors` every
// declared struct or variant, a call to which is a fresh construction.
// A method's row is keyed by its receiver's namespace (ow_receiver_ns) and its
// name, its receiver the first flag; a trait's method is keyed by the trait,
// for a `dyn` receiver. `methods` names the methods that take their receiver
// `own`, and `funcs` every declared free function, own-taking or not.
pub struct OwnFuncs { rows: OwnFunc[], names: util.NameIndex, structs: util.NameIndex, decls: util.NameIndex, ctors: util.NameIndex, methods: util.NameIndex, funcs: util.NameIndex }

struct MovedEntry { mname: string, mline: i32 }

struct OwnWalk { moved: MovedEntry[], diags: util.Diag[] }

// `admit` names the ONE local admitted as an owned argument while
// walking the RHS of a self-reassign `x = f(..., x, ...)` (#4873 step 0
// — the old binding dies at the assignment, so its exactly-once
// own-position occurrence is a transfer). "" outside that walk. The
// exactly-once check (ow_self_move_admits) makes name-keying equivalent
// to the native checker's node-keying within the RHS subtree.
//
// `admit_fields` is the field-read counterpart (#8186): the "base.field"
// keys admitted while walking `base = S { ...base, f: g(.., base.f, ..) }`
// or the return of that literal (ow_field_move_fields). `borrowed` names
// the parameters this frame does not own — never a base for that move.
//
// `scope` is the checker's scope at the walk's position: an argument whose
// checked type is scalar carries no reference, so handing it to a consuming
// parameter transfers nothing and needs no proof of ownership (native's
// scalarArgs).
struct OwnCtx { owned: string[], borrowed: string[], ofuncs: OwnFuncs, structs: parser.StructDecl[], snames: util.NameIndex, admit: string, admit_fields: string[], fresh: string[], fresh_methods: string[], fresh_scrut: string[], bound: string[], scope: Scope, last_use: string[] }

// ow_expr_is_scalar is native's definitelyScalar on the argument's checked type.
function ow_expr_is_scalar(e: ast.Expr, ctx: OwnCtx): boolean {
  if (ow_scalar_literal(e)) {
    return true;
  }
  match (check_expr(e, ctx.scope)) {
    typeinfo.TypeI32(_) => {
      return true;
    },
    typeinfo.TypeBool(_) => {
      return true;
    },
    typeinfo.TypeFloat(_) => {
      return true;
    },
    typeinfo.TypeVoid(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

// A `+` is a fresh string only as concatenation (native's IsStringConcat).
function ow_is_string_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeString(_) = t {
    return true;
  }
  return false;
}

function ow_moved_has(m: MovedEntry[], name: string): boolean {
  for elem in m {
    if (elem.mname == name) {
      return true;
    }
  }
  return false;
}

function ow_moved_line(m: MovedEntry[], name: string): i32 {
  for elem in m {
    if (elem.mname == name) {
      return elem.mline;
    }
  }
  return 0;
}

function ow_moved_add(m: MovedEntry[], name: string, line: i32): MovedEntry[] {
  if (ow_moved_has(m, name)) {
    return m;
  }
  return m.append(MovedEntry { mname: name, mline: line });
}

// ow_moved_join merges a non-diverging branch's consumes into dst (first
// consume wins). A diverging branch (returns on every path) never reaches
// the join, so its consumes don't constrain the fall-through.
function ow_moved_join(dst: MovedEntry[], branch: MovedEntry[], diverges: boolean): MovedEntry[] {
  if (diverges) {
    return dst;
  }
  let out: MovedEntry[] = dst;
  for elem in branch {
    out = ow_moved_add(out, elem.mname, elem.mline);
  }
  return out;
}

function ow_is_owned(ctx: OwnCtx, name: string): boolean {
  return util.has_str(ctx.owned, name);
}

// A slot where `own` says something: a reference, whose unit changes hands. A
// SCALAR carries none, so `own` on one transfers nothing and there is no
// affine discipline to enforce — a second mention of it is an ordinary read,
// not a use after move. A generic `own acc: T` reaches every instantiation,
// and its scalar ones would otherwise report one.
function ow_ownable_type(type_name: string): boolean {
  let scalars: string[] = ["boolean", "i32", "i64", "u8", "u32", "u64", "f64", "f32", "char", "usize", "void"];
  return !util.has_str(scalars, type_name);
}

// ow_nested_ctx layers a nested function's parameters over the enclosing
// owned set: an `own` parameter is owned inside the body it belongs to, and
// any other parameter SHADOWS an outer owned name it repeats.
function ow_nested_ctx(ctx: OwnCtx, lm: ast.ExprLambda): OwnCtx {
  let params: ast.ParamDecl[] = lm.params;
  let names: string[] = ctx.owned;
  let borrowed: string[] = ctx.borrowed;
  for param in params {
    if (param.own && ow_ownable_type(param.type_name)) {
      if (!util.has_str(names, param.name)) {
        names = names.append(param.name);
      }
      borrowed = ow_names_del(borrowed, param.name);
    } else {
      names = ow_names_del(names, param.name);
      if (!util.has_str(borrowed, param.name)) {
        borrowed = borrowed.append(param.name);
      }
    }
  }
  let bound: string[] = ctx.bound;
  for p in params {
    if (!util.has_str(bound, p.name)) {
      bound = bound.append(p.name);
    }
  }
  let nested: OwnCtx = OwnCtx { owned: names, borrowed: borrowed, ofuncs: ctx.ofuncs, structs: ctx.structs, snames: ctx.snames, admit: ctx.admit, admit_fields: ctx.admit_fields, fresh: ctx.fresh, fresh_methods: ctx.fresh_methods, fresh_scrut: ctx.fresh_scrut, bound: bound, scope: lambda_body_scope(lm, ctx.scope), last_use: ctx.last_use };
  return nested;
}

function ow_names_del(names: string[], name: string): string[] {
  let out: string[] = [];
  for nm in names {
    if (nm != name) {
      out = out.append(nm);
    }
  }
  return out;
}

// A nested parameter is a fresh binding: an outer name it shadows must not
// carry its consumed state into the body.
function ow_nested_moved(m: MovedEntry[], params: ast.ParamDecl[]): MovedEntry[] {
  let out: MovedEntry[] = m;
  for param in params {
    out = ow_moved_del(out, param.name);
  }
  return out;
}

function ow_func_flags(ofuncs: OwnFuncs, name: string): boolean[] {
  let i: i32 = ofuncs.names.find(name);
  if (i >= 0) {
    return ofuncs.rows[i].flags;
  }
  let empty: boolean[] = [];
  return empty;
}

function ow_is_own_func(ofuncs: OwnFuncs, name: string): boolean {
  return ofuncs.names.has(name);
}

// ow_variant_known reports whether `name` is a declared VARIANT, optionally of
// one named enum. A payload-less variant is spelled as a bare name rather than
// a call, so it reaches the ownership predicate as an identifier (or, spelled
// `Span.Empty`, as a field access) and not through the call arm that already
// admits `Wide(1.5, "ab")` (#9517).
function ow_variant_known(ctx: OwnCtx, name: string, owner: string): boolean {
  let i: i32 = ctx.snames.chain(name);
  while (i >= 0) {
    let sd: parser.StructDecl = ctx.structs[i];
    if (sd.name == name && sd.enum_owner != "" && (owner == "" || sd.enum_owner == owner)) {
      return true;
    }
    i = ctx.snames.next[i];
  }
  return false;
}

function ow_struct_names(structs: parser.StructDecl[]): string[] {
  let names: string[] = [];
  for sd in structs {
    names = names.append(sd.name);
  }
  return names;
}

// ow_is_owned_expr: a value the caller owns and may transfer into an `own`
// parameter — a fresh construction (struct/tuple/array literal, string
// concat), another owned parameter, a variant-constructor call, or a local at
// its last use (lu_last_use_args). Anything else (borrowed param, projection,
// a local still read afterwards, ordinary call) is not provably owned → E051.
// ow_scalar_literal: a literal carrying no unit. A consuming position takes
// nothing from the caller there, so there is nothing to prove owned — and a
// generic `own acc: T` reaches every instantiation, so refusing the scalar one
// would make the consuming convention unspellable for a fold that counts.
function ow_scalar_literal(e: ast.Expr): boolean {
  if let ast.ExprNumber(_) = e {
    return true;
  }
  if let ast.ExprBool(_) = e {
    return true;
  }
  return false;
}

// ow_is_owned_scrutinee answers a DIFFERENT question from an argument transfer,
// and deliberately keeps the narrower pre-#9538 answer for a call.
//
// Matching decomposes the box in place, and the RC lowering releases what it
// decomposes off the same signature-shaped rule the checker used before the
// returns-borrow inference. Handing the inference's wider answer to this site
// frees a freshly-returned scrutinee AT the match and then reads it (#9539).
// The two converge when the lowering moves with the rule, not before.
function ow_is_owned_scrutinee(e: ast.Expr, ctx: OwnCtx): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(cid) = c.callee {
      if (ctx.ofuncs.ctors.has(cid.name)) {
        return true;
      }
      return util.has_str(ctx.fresh_scrut, cid.name);
    }
    return false;
  }
  return ow_is_owned_expr(e, ctx);
}

function ow_is_owned_expr(e: ast.Expr, ctx: OwnCtx): boolean {
  if (ow_expr_is_scalar(e, ctx)) {
    return true;
  }
  match (e) {
    ast.ExprStructLit(_) => {
      return true;
    },
    ast.ExprArray(_) => {
      return true;
    },
    ast.ExprTuple(_) => {
      return true;
    },
    ast.ExprMapLit(_) => {
      return true;
    },
    ast.ExprBinary(b) => {
      return b.op == "+" && ow_is_string_type(check_expr(b.left, ctx.scope)) && ow_is_string_type(check_expr(b.right, ctx.scope));
    },
    ast.ExprIdent(id) => {
      if (ctx.admit.len() > 0 && ctx.admit == id.name) {
        return true;
      }
      if (util.has_str(ctx.last_use, lu_key(id.line, id.col))) {
        return true;
      }
      if (ow_variant_known(ctx, id.name, "")) {
        return true;
      }
      // A top-level const is one static value under the immortal rc: handing
      // it over moves nothing, and a write through the parameter copies
      // (#11471). A local of the same name shadows it.
      if (!util.has_str(ctx.bound, id.name) && !ctx.scope.is_bound(id.name) && ctx.scope.lookup_sig(id.name).is_const) {
        return true;
      }
      return ow_is_owned(ctx, id.name);
    },
    ast.ExprFieldAccess(fa) => {
      if (ow_variant_known(ctx, fa.field, ow_ident_name(fa.obj))) {
        return true;
      }
      return util.has_str(ctx.admit_fields, ow_ident_name(fa.obj) + "." + fa.field);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return ctx.ofuncs.ctors.has(cid.name) || util.has_str(ctx.fresh, cid.name);
        },
        ast.ExprFieldAccess(mfa) => {
          // A method is reached through its SPELLING here, because the
          // self-host does not mangle at parse time; ow_fresh_methods settles
          // which spellings cannot hand a receiver or an argument back.
          return util.has_str(ctx.fresh_methods, mfa.field);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

// ===================== last-use transfer (E051, #9541) ====================
// A local handed to an `own` parameter at its LAST use is a move: nothing reads
// the binding again. lu_last_use_args names those argument occurrences, as
// "line:col" keys, by native's CallArgDeaths (internal/check/checker/
// call_arg_deaths.go), which is also what the IR moves by. Only the question
// E051 asks is ported: a `let` local, at an `own` position of a direct call,
// outside any lambda, read by no defer or lambda.
//
// The source order of two occurrences is their position, where native numbers
// idents in walk order; the two agree wherever the parser leaves source order
// alone.

struct LuOcc { name: string, line: i32, col: i32 }

struct LuVar { name: string, init: ast.Expr }

// LuSel is one `obj.field` selection on a bare identifier.
struct LuSel { obj: string, field: string }

struct LuFacts { occ: LuOcc[], vars: LuVar[], escaping: string[], sels: LuSel[] }

// LuFn is what every verdict reads: the body's facts, its parameter names and
// the own-func table.
struct LuFn { facts: LuFacts, params: string[], ofuncs: OwnFuncs }

// LuSite is the statement a call sits in: its innermost statement list, its
// index there, whether a loop re-runs it, the locals the innermost loop body
// declares before it, and whether that list is the body of a parser-synthesised
// IIFE — a match / if expression or value block, which native keeps as an
// expression, so a `return` there does not leave the function.
struct LuSite { stmts: ast.Stmt[], idx: i32, in_loop: boolean, fresh: string[], in_iife: boolean }

function lu_key(line: i32, col: i32): string {
  return util.i32_to_string(line) + ":" + util.i32_to_string(col);
}

function lu_name_stmt(s: ast.Stmt, own a: string[]): string[] {
  if let ast.StmtAssign(asg) = s {
    return a.append(asg.target);
  }
  return a;
}

function lu_name_expr(e: ast.Expr, own a: string[]): string[] {
  if let ast.ExprIdent(id) = e {
    return a.append(id.name);
  }
  return a;
}

// lu_all_names is every name `st` mentions: each identifier, anywhere, and each
// assignment target.
function lu_all_names(st: ast.Stmt, own acc: string[]): string[] {
  return astwalk.fold_stmt_nodes(st, acc, lu_name_stmt, lu_name_expr, astwalk.descend_all);
}

function lu_fact_stmt(st: ast.Stmt, own f: LuFacts): LuFacts {
  match (st) {
    ast.StmtAssign(a) => {
      return LuFacts { ...f, occ: f.occ.append(LuOcc { name: a.target, line: a.target_line, col: a.target_col }) };
    },
    ast.StmtVar(v) => {
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return LuFacts { ...f, vars: lu_destr_vars(v, f.vars) };
      }
      return LuFacts { ...f, vars: f.vars.append(LuVar { name: v.name, init: v.init }) };
    },
    ast.StmtDefer(d) => {
      return LuFacts { ...f, escaping: lu_all_names(d.action, f.escaping) };
    },
    _ => {
      return f;
    }
  }
  return f;
}

// lu_destr_vars declares a destructure's bindings. Each top-level one is an
// element of the value it unpacks, so it is fresh when that value is — unless
// an `@` binding names the whole value — and is never a rename or an unpack.
// A nested position's bindings read a synthesised binder, which is not fresh.
function lu_destr_vars(v: ast.StmtVar, own vars: LuVar[]): LuVar[] {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let init: ast.Expr = none;
  if (lu_fresh_expr(v.init) && parser.destr_marker_split(v.type_name).at.len() == 0) {
    init = v.init;
  }
  for nm in split_pattern_names(v.name) {
    if (util.is_tuple_type_name(nm)) {
      vars = lu_nested_vars(nm, vars);
    } else {
      vars = vars.append(LuVar { name: nm, init: init });
    }
  }
  return vars;
}

function lu_nested_vars(group: string, own vars: LuVar[]): LuVar[] {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  for nm in split_pattern_names(slice_unchecked(group, 1, group.len() - 1) + "") {
    if (util.is_tuple_type_name(nm)) {
      vars = lu_nested_vars(nm, vars);
    } else {
      vars = vars.append(LuVar { name: nm, init: none });
    }
  }
  return vars;
}

// A lambda the parser synthesised for a value block or a match / if expression
// stands for a node native has no lambda for, so it makes nothing escape.
function lu_fact_expr(e: ast.Expr, own f: LuFacts): LuFacts {
  match (e) {
    ast.ExprIdent(id) => {
      return LuFacts { ...f, occ: f.occ.append(LuOcc { name: id.name, line: id.line, col: id.col }) };
    },
    ast.ExprLambda(lm) => {
      if (lm.origin.len() > 0) {
        return f;
      }
      let esc: string[] = f.escaping;
      for st in lm.body {
        esc = lu_all_names(st, esc);
      }
      return LuFacts { ...f, escaping: esc };
    },
    ast.ExprFieldAccess(fa) => {
      let obj: string = ow_ident_name(fa.obj);
      if (obj.len() == 0) {
        return f;
      }
      return LuFacts { ...f, sels: f.sels.append(LuSel { obj: obj, field: fa.field }) };
    },
    _ => {
      return f;
    }
  }
  return f;
}

function lu_occ_count(fx: LuFn, name: string): i32 {
  let n: i32 = 0;
  for o in fx.facts.occ {
    if (o.name == name) {
      n = n + 1;
    }
  }
  return n;
}

function lu_decl_count(fx: LuFn, name: string): i32 {
  let n: i32 = 0;
  for v in fx.facts.vars {
    if (v.name == name) {
      n = n + 1;
    }
  }
  return n;
}

// lu_init_of is the initialiser of the single declaration of `name`; `ok` is
// false for a name declared other than exactly once.
struct LuInit { ok: boolean, init: ast.Expr }

function lu_init_of(fx: LuFn, name: string): LuInit {
  let found: i32 = 0;
  let init: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  for v in fx.facts.vars {
    if (v.name == name) {
      found = found + 1;
      init = v.init;
    }
  }
  return LuInit { ok: found == 1, init: init };
}

function lu_is_local(fx: LuFn, name: string): boolean {
  return !util.has_str(fx.params, name) && lu_decl_count(fx, name) > 0;
}

// lu_fresh_init: declared once, from a fresh value — a call whose callee is
// named (a function, or a method, which native has rewritten to one by the time
// it asks), or an array, string or plain struct literal. A spread literal copies
// its base's fields, so it is not fresh.
function lu_fresh_init(fx: LuFn, name: string): boolean {
  let li: LuInit = lu_init_of(fx, name);
  return li.ok && lu_fresh_expr(li.init);
}

function lu_fresh_expr(e: ast.Expr): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(_) = c.callee {
      return true;
    }
    if let ast.ExprFieldAccess(_) = c.callee {
      return true;
    }
  }
  if let ast.ExprArray(_) = e {
    return true;
  }
  if let ast.ExprString(_) = e {
    return true;
  }
  if let ast.ExprStructLit(sl) = e {
    return !sl.has_base;
  }
  return false;
}

// lu_unpack_init: declared once as `h.f` of a fresh-initialised `h`, where that is
// the only read of `h.f` and every mention of `h` selects a field.
function lu_unpack_init(fx: LuFn, name: string): boolean {
  let li: LuInit = lu_init_of(fx, name);
  if (!li.ok) {
    return false;
  }
  if let ast.ExprFieldAccess(fa) = li.init {
    let h: string = ow_ident_name(fa.obj);
    if (h.len() == 0 || !lu_fresh_init(fx, h)) {
      return false;
    }
    let reads: i32 = 0;
    let selections: i32 = 0;
    for sel in fx.facts.sels {
      if (sel.obj == h) {
        selections = selections + 1;
        if (sel.field == fa.field) {
          reads = reads + 1;
        }
      }
    }
    return reads == 1 && selections == lu_occ_count(fx, h);
  }
  return false;
}

// lu_rename_source is the name `let name = src;` renames, when `src` is named
// nowhere else; "" otherwise.
function lu_rename_source(fx: LuFn, name: string): string {
  let li: LuInit = lu_init_of(fx, name);
  if (!li.ok) {
    return "";
  }
  let src: string = ow_ident_name(li.init);
  if (src.len() == 0 || lu_occ_count(fx, src) != 1) {
    return "";
  }
  return src;
}

// lu_admitted is the binding the last-occurrence shapes admit: one bound from a
// call, unpacked from one, or a rename of such a binding or of a parameter.
function lu_admitted(fx: LuFn, name: string): boolean {
  if (lu_fresh_init(fx, name) || lu_unpack_init(fx, name)) {
    return true;
  }
  let root: string = lu_rename_source(fx, name);
  if (root.len() == 0) {
    return false;
  }
  let seen: string[] = [name, root];
  let next: string = lu_rename_source(fx, root);
  while (next.len() > 0 && !util.has_str(seen, next)) {
    root = next;
    seen = seen.append(next);
    next = lu_rename_source(fx, root);
  }
  return util.has_str(fx.params, root) || lu_fresh_init(fx, root) || lu_unpack_init(fx, root);
}

// lu_is_last: no occurrence of the name sits after this one.
function lu_is_last(fx: LuFn, id: ast.ExprIdent): boolean {
  for o in fx.facts.occ {
    if (o.name == id.name && (o.line > id.line || o.line == id.line && o.col > id.col)) {
      return false;
    }
  }
  return true;
}

function lu_mentions(st: ast.Stmt, name: string): i32 {
  let n: i32 = 0;
  for nm in lu_all_names(st, []) {
    if (nm == name) {
      n = n + 1;
    }
  }
  return n;
}

// lu_jump_escapes: a break / continue in `st` that can leave the statement list
// holding it — unlabelled outside every loop `st` contains, or labelled.
function lu_jump_escapes(st: ast.Stmt, depth: i32): boolean {
  match (st) {
    ast.StmtBreak(b) => {
      return depth == 0 || b.label.len() > 0;
    },
    ast.StmtContinue(c) => {
      return depth == 0 || c.label.len() > 0;
    },
    ast.StmtIf(f) => {
      return lu_jumps_escape(f.then_body, depth) || lu_jumps_escape(f.else_body, depth);
    },
    ast.StmtWhile(w) => {
      return lu_jumps_escape(w.body, depth + 1);
    },
    ast.StmtFor(fo) => {
      return lu_jumps_escape(fo.body, depth + 1);
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        if (lu_jumps_escape(arm.body, depth)) {
          return true;
        }
      }
      return false;
    },
    ast.StmtDefer(d) => {
      return lu_jump_escapes(d.action, depth);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function lu_jumps_escape(stmts: ast.Stmt[], depth: i32): boolean {
  for s in stmts {
    if (lu_jump_escapes(s, depth)) {
      return true;
    }
  }
  return false;
}

// lu_returns_before_reading: the statement list holding the call returns before
// naming `name` again, so this read is the last on every path through it.
function lu_returns_before_reading(site: LuSite, name: string): boolean {
  if (lu_mentions(site.stmts[site.idx], name) != 1) {
    return false;
  }
  let j: i32 = site.idx + 1;
  while (j < site.stmts.len()) {
    let st: ast.Stmt = site.stmts[j];
    if (lu_mentions(st, name) != 0 || lu_jump_escapes(st, 0)) {
      return false;
    }
    if let ast.StmtReturn(_) = st {
      return true;
    }
    j = j + 1;
  }
  return false;
}

function lu_arr_position(fx: LuFn, callee: string, i: i32): boolean {
  for ofn in fx.ofuncs.rows {
    if (ofn.name == callee) {
      return i >= ofn.arr.len() || ofn.arr[i];
    }
  }
  return true;
}

// lu_dies reports whether the argument `aid` of `call` is dead at the call;
// `arr` says the parameter it binds is array-typed. `outer` is the outermost
// call enclosing it, when `has_outer`.
function lu_dies(fx: LuFn, call: ast.Expr, arr: boolean, aid: ast.ExprIdent, outer: ast.Expr, has_outer: boolean, site: LuSite): boolean {
  let name: string = aid.name;
  if (!lu_is_local(fx, name) || util.has_str(fx.facts.escaping, name)) {
    return false;
  }
  let once: boolean = astwalk.count_ident_expr(call, name) == 1;
  if (lu_rebind_site(site, name)) {
    return true;
  }
  // A local the innermost loop body declares before the call is bound anew on
  // every pass, so the loop re-reads no value it moved (#12260).
  let repeats: boolean = site.in_loop && !(util.has_str(site.fresh, name) && lu_decl_count(fx, name) == 1);
  if (repeats || !once || !lu_admitted(fx, name)) {
    return false;
  }
  if (lu_is_last(fx, aid)) {
    // An enclosing call that also names x already holds it (#9879).
    return !(has_outer && astwalk.count_ident_expr(outer, name) > 1);
  }
  if (site.in_iife || arr) {
    return false;
  }
  return lu_returns_before_reading(site, name);
}

// lu_rebind_site: the statement holding the call supersedes `name` whatever
// follows it.
function lu_rebind_site(site: LuSite, name: string): boolean {
  match (site.stmts[site.idx]) {
    ast.StmtAssign(a) => {
      // `x = f(.., x, ..)`, the call anywhere in the value.
      if let ast.ExprCall(_) = a.value {
        if (a.target == name && astwalk.count_ident_expr(a.value, name) == 1) {
          return true;
        }
      }
    },
    ast.StmtReturn(r) => {
      // `return f(.., x, ..)`, the call anywhere in a value that names x only
      // there.
      if (!site.in_iife && astwalk.count_ident_expr(r.value, name) == 1) {
        return true;
      }
    },
    ast.StmtVar(v) => {
      // `let y = f(.., x, ..); …; x = y;` — the store supersedes x before
      // anything reads it.
      if let ast.ExprCall(_) = v.init {
        if (astwalk.count_ident_expr(v.init, name) == 1) {
          return lu_rebound_after(site, name);
        }
      }
    },
    _ => {}
  }
  return false;
}

// lu_rebound_after: a later statement of the list stores to `name` without
// reading it, and every statement before that store is straight-line code that
// does not name it (#11093).
function lu_rebound_after(site: LuSite, name: string): boolean {
  let j: i32 = site.idx + 1;
  while (j < site.stmts.len()) {
    if let ast.StmtAssign(a) = site.stmts[j] {
      if (a.target == name) {
        if (astwalk.count_ident_expr(a.value, name) != 0) {
          return false;
        }
        let k: i32 = site.idx + 1;
        while (k < j) {
          if (!lu_straight(site.stmts[k]) || lu_mentions(site.stmts[k], name) != 0) {
            return false;
          }
          k = k + 1;
        }
        return true;
      }
    }
    j = j + 1;
  }
  return false;
}

// lu_straight: a statement that runs through to the next one, so it cannot
// leave the list before the store does.
function lu_straight(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return !lu_has_try(v.init);
    },
    ast.StmtAssign(a) => {
      return !lu_has_try(a.value);
    },
    ast.StmtExpr(x) => {
      return !lu_has_try(x.value);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function lu_has_try(e: ast.Expr): boolean {
  return astwalk.fold_expr_pruned(e, false, lu_try_at, astwalk.not_lambda);
}

function lu_try_at(x: ast.Expr, own found: boolean): boolean {
  if let ast.ExprUnary(u) = x {
    if (u.op == "try_") {
      return true;
    }
  }
  return found;
}

// lu_call collects the keys of `c`'s own-position arguments that die at it.
// It has no types, so a method with an `own` position is known by name: its
// receiver's and arguments' keys are only read where the call guard resolved
// that method. An argument that dies only if its parameter is not an array is
// keyed with a `~` suffix, which the guard reads for a non-array position alone.
function lu_call(c: ast.ExprCall, e: ast.Expr, outer: ast.Expr, has_outer: boolean, site: LuSite, fx: LuFn, own acc: string[]): string[] {
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (!fx.ofuncs.methods.has(fa.field)) {
      for a in c.args {
        acc = lu_method_arg(a, e, outer, has_outer, site, fx, acc);
      }
      return acc;
    }
    acc = lu_method_arg(fa.obj, e, outer, has_outer, site, fx, acc);
    for a in c.args {
      acc = lu_method_arg(a, e, outer, has_outer, site, fx, acc);
    }
    return acc;
  }
  let cname: string = ow_ident_name(c.callee);
  if (cname.len() == 0 || util.has_str(fx.params, cname) || !ow_is_own_func(fx.ofuncs, cname)) {
    for a in c.args {
      acc = lu_method_arg(a, e, outer, has_outer, site, fx, acc);
    }
    return acc;
  }
  let flags: boolean[] = ow_func_flags(fx.ofuncs, cname);
  let i: i32 = 0;
  while (i < c.args.len() && i < flags.len()) {
    if (flags[i]) {
      if let ast.ExprIdent(aid) = c.args[i] {
        if (lu_dies(fx, e, lu_arr_position(fx, cname, i), aid, outer, has_outer, site)) {
          acc = acc.append(lu_key(aid.line, aid.col));
        }
      }
    }
    i = i + 1;
  }
  return acc;
}

function lu_method_arg(a: ast.Expr, e: ast.Expr, outer: ast.Expr, has_outer: boolean, site: LuSite, fx: LuFn, own acc: string[]): string[] {
  if let ast.ExprIdent(id) = a {
    if (lu_dies(fx, e, true, id, outer, has_outer, site)) {
      return acc.append(lu_key(id.line, id.col));
    }
    if (lu_dies(fx, e, false, id, outer, has_outer, site)) {
      return acc.append(lu_key(id.line, id.col) + "~");
    }
  }
  return acc;
}

// lu_children lists an expression's operands. A lambda has none here: its body
// is lowered as a function of its own.
function lu_map_lit_children(ml: ast.ExprMapLit, own out: ast.Expr[]): ast.Expr[] {
  let k: i32 = 0;
  while (k < ml.keys.len()) {
    out = out.append(ml.keys[k]);
    out = out.append(ml.vals[k]);
    k = k + 1;
  }
  return out;
}

function lu_fstring_children(fs: ast.ExprFString, own out: ast.Expr[]): ast.Expr[] {
  let k: i32 = 0;
  while (k < fs.exprs.len()) {
    if (fs.is_expr[k]) {
      out = out.append(fs.exprs[k]);
    }
    k = k + 1;
  }
  return out;
}

function lu_children(e: ast.Expr): ast.Expr[] {
  let out: ast.Expr[] = [];
  match (e) {
    ast.ExprBinary(b) => {
      out = out.append(b.left);
      out = out.append(b.right);
    },
    ast.ExprUnary(u) => {
      out = out.append(u.operand);
    },
    ast.ExprCall(c) => {
      out = out.append(c.callee);
      for a in c.args {
        out = out.append(a);
      }
    },
    ast.ExprArray(a) => {
      for el in a.elements {
        out = out.append(el);
      }
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        out = out.append(el);
      }
    },
    ast.ExprMapLit(ml) => {
      out = lu_map_lit_children(ml, out);
    },
    ast.ExprFString(fs) => {
      out = lu_fstring_children(fs, out);
    },
    ast.ExprIndex(x) => {
      out = out.append(x.array);
      out = out.append(x.index);
    },
    ast.ExprSlice(sl) => {
      out = out.append(sl.array);
      out = out.append(sl.start);
      out = out.append(sl.end);
    },
    ast.ExprStructLit(sl) => {
      if (sl.has_base) {
        out = out.append(sl.base);
      }
      for fv in sl.field_values {
        out = out.append(fv);
      }
    },
    ast.ExprFieldAccess(fa) => {
      out = out.append(fa.obj);
    },
    _ => {}
  }
  return out;
}

function lu_expr(e: ast.Expr, outer: ast.Expr, has_outer: boolean, site: LuSite, fx: LuFn, own acc: string[]): string[] {
  let o: ast.Expr = outer;
  let ho: boolean = has_outer;
  if let ast.ExprCall(c) = e {
    // A written lambda is lowered as a function of its own, so its calls stay
    // out; a synthesised one runs in place.
    if let ast.ExprLambda(lm) = c.callee {
      if (lm.origin.len() == 0 || c.args.len() > 0) {
        return acc;
      }
      return lu_stmts(lm.body, site.in_loop, site.fresh, true, outer, has_outer, fx, acc);
    }
    acc = lu_call(c, e, outer, has_outer, site, fx, acc);
    if (!ho) {
      o = e;
      ho = true;
    }
  }
  for child in lu_children(e) {
    acc = lu_expr(child, o, ho, site, fx, acc);
  }
  return acc;
}

// lu_root walks a statement's own expression. `outer` carries an enclosing call
// into the body of a synthesised IIFE, which native sees as one expression.
function lu_root(e: ast.Expr, site: LuSite, outer: ast.Expr, has_outer: boolean, fx: LuFn, own acc: string[]): string[] {
  if (has_outer) {
    return lu_expr(e, outer, true, site, fx, acc);
  }
  return lu_expr(e, e, false, site, fx, acc);
}

function lu_stmts(stmts: ast.Stmt[], in_loop: boolean, fresh0: string[], in_iife: boolean, outer: ast.Expr, has_outer: boolean, fx: LuFn, own acc: string[]): string[] {
  let fresh: string[] = fresh0;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let site: LuSite = LuSite { stmts: stmts, idx: i, in_loop: in_loop, fresh: fresh, in_iife: in_iife };
    match (stmts[i]) {
      ast.StmtVar(v) => {
        acc = lu_root(v.init, site, outer, has_outer, fx, acc);
        fresh = lu_declared(stmts[i], fresh);
      },
      ast.StmtAssign(a) => {
        acc = lu_root(a.value, site, outer, has_outer, fx, acc);
      },
      ast.StmtReturn(r) => {
        acc = lu_root(r.value, site, outer, has_outer, fx, acc);
      },
      ast.StmtExpr(x) => {
        acc = lu_root(x.value, site, outer, has_outer, fx, acc);
      },
      ast.StmtIf(f) => {
        acc = lu_root(f.cond, site, outer, has_outer, fx, acc);
        acc = lu_stmts(f.then_body, in_loop, fresh, in_iife, outer, has_outer, fx, acc);
        acc = lu_stmts(f.else_body, in_loop, fresh, in_iife, outer, has_outer, fx, acc);
      },
      ast.StmtWhile(w) => {
        acc = lu_root(w.cond, LuSite { ...site, in_loop: true, fresh: [] }, outer, has_outer, fx, acc);
        acc = lu_stmts(w.body, true, [], in_iife, outer, has_outer, fx, acc);
      },
      ast.StmtFor(fo) => {
        acc = lu_root(fo.iter, LuSite { ...site, in_loop: true, fresh: [] }, outer, has_outer, fx, acc);
        acc = lu_stmts(fo.body, true, [], in_iife, outer, has_outer, fx, acc);
      },
      ast.StmtMatch(m) => {
        acc = lu_root(m.scrutinee, site, outer, has_outer, fx, acc);
        for arm in m.arms {
          if (arm.has_guard) {
            acc = lu_root(arm.guard, site, outer, has_outer, fx, acc);
          }
          acc = lu_stmts(arm.body, in_loop, fresh, in_iife, outer, has_outer, fx, acc);
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return acc;
}

// lu_declared appends the names `st` declares to `names`.
function lu_declared(st: ast.Stmt, own names: string[]): string[] {
  let facts: LuFacts = lu_fact_stmt(st, LuFacts { occ: [], vars: [], escaping: [], sels: [] });
  for d in facts.vars {
    names = names.append(d.name);
  }
  return names;
}

// lu_last_use_args is the E051 admission for `fn`: the keys of the local
// arguments handed to an `own` parameter where they die. A nested function is
// lowered as a function of its own, so its body is answered by its own walk.
function lu_last_use_args(fn: parser.FuncDecl, ofuncs: OwnFuncs): string[] {
  let facts: LuFacts = LuFacts { occ: [], vars: [], escaping: [], sels: [] };
  let nested: ast.ExprLambda[] = [];
  for st in fn.body {
    facts = astwalk.fold_stmt_nodes(st, facts, lu_fact_stmt, lu_fact_expr, astwalk.descend_all);
    nested = astwalk.fold_stmt_nodes(st, nested, lu_skip_stmt, lu_nested_fn, lu_outside_nested_fn);
  }
  let fx: LuFn = LuFn { facts: facts, params: ow_param_names(fn), ofuncs: ofuncs };
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let out: string[] = lu_stmts(fn.body, false, [], false, none, false, fx, []);
  for lm in nested {
    out = util.append_all(out, lu_last_use_args(parser.FuncDecl { ...fn, params: lm.params, body: lm.body }, ofuncs));
  }
  return out;
}

function lu_skip_stmt(st: ast.Stmt, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  return acc;
}

// lu_nested_fn collects the lambdas nested `function` declarations desugar to.
function lu_nested_fn(e: ast.Expr, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  if let ast.ExprLambda(lm) = e {
    if (lm.origin == ast.ORIGIN_NESTED_FN) {
      return acc.append(lm);
    }
  }
  return acc;
}

// lu_outside_nested_fn stops the walk at a nested function: the recursive walk
// over its own body finds the functions nested in it.
function lu_outside_nested_fn(e: ast.Expr): boolean {
  if let ast.ExprLambda(lm) = e {
    return lm.origin != ast.ORIGIN_NESTED_FN;
  }
  return true;
}

// ow_count_ident counts occurrences of `name` as a bare ident anywhere
// in `e` — the exactly-once probe for the self-reassign move admission.
// An unhandled variant counts 0, which under-counts and therefore REJECTS (fails safe: the
// admission needs exactly 1 and a direct-arg hit).
function ow_count_ident_list(list: ast.Expr[], name: string): i32 {
  let n: i32 = 0;
  for entry in list {
    n = n + ow_count_ident(entry, name);
  }
  return n;
}

// ow_count_ident tallies how many times `name` appears as an identifier in an
// expression. It uses astwalk's fold, so a new parser node is counted here the
// moment astwalk reaches it; the hand-written version ended in a `_ => 0` arm
// that silently did not look inside whatever it did not name.
function ow_count_ident(e: ast.Expr, name: string): i32 {
  function tally(n: ast.Expr, own acc: i32): i32 {
    match (n) {
      ast.ExprIdent(id) => {
        if (id.name == name) {
          return acc + 1;
        }
        return acc;
      },
      _ => {
        return acc;
      }
    }
  }
  return astwalk.fold_expr(e, 0, tally);
}

// ow_self_move_admits recognizes the #4873 step-0 shape for
// `target = <value>`: value is a call to an own-func or an own method,
// target occurs EXACTLY ONCE in its arguments (a method's receiver among
// them), and that occurrence is a direct bare-ident argument in an `own`
// position. Byte-matches the native SelfReassignOwnMoveArg so
// the two checkers admit identical programs.
function ow_self_move_admits(target: string, value: ast.Expr, ctx: OwnCtx): boolean {
  if let ast.ExprCall(c) = value {
    let oc: OwnCall = ow_own_call(c, ctx);
    if (oc.flags.len() == 0 || ow_count_ident_list(oc.args, target) != 1) {
      return false;
    }
    let i: i32 = 0;
    while (i < oc.args.len() && i < oc.flags.len()) {
      if let ast.ExprIdent(aid) = oc.args[i] {
        if (aid.name == target) {
          return oc.flags[i];
        }
      }
      i = i + 1;
    }
  }
  return false;
}

function ow_ident_name(e: ast.Expr): string {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// ow_is_field_read: is `e` exactly `target.field`?
function ow_is_field_read(e: ast.Expr, target: string, field: string): boolean {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      return fa.field == field && ow_ident_name(fa.obj) == target;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// ow_count_field_reads tallies the `target.<field>` reads in `e` — every
// field of `target` when `field` is "".
function ow_count_field_reads(e: ast.Expr, target: string, field: string): i32 {
  function tally(n: ast.Expr, own acc: i32): i32 {
    match (n) {
      ast.ExprFieldAccess(fa) => {
        if (ow_ident_name(fa.obj) == target && (field.len() == 0 || fa.field == field)) {
          return acc + 1;
        }
        return acc;
      },
      _ => {
        return acc;
      }
    }
  }
  return astwalk.fold_expr(e, 0, tally);
}

// ow_field_move_fields recognizes the #8186 superseded-field shape on
// `target = <value>` (or `return <value>`): value is `S { ...target, f: g(..,
// target.f, ..) }`, and it returns the "target.f" key of every such field —
// f's value is a plain own-func call holding `target.f` directly at an own
// position, `target.f` is read exactly once in the literal, and `target`
// occurs BARE exactly once (as the base): every other mention is a field
// read, so the callee has no second route to the box whose field it
// consumes. Byte-matches native SupersededFieldOwnMoveArgs.
function ow_field_move_fields(target: string, value: ast.Expr, ctx: OwnCtx): string[] {
  let out: string[] = [];
  match (value) {
    ast.ExprStructLit(sl) => {
      if (!sl.has_base || ow_ident_name(sl.base) != target) {
        return out;
      }
      if (ow_count_ident(value, target) - ow_count_field_reads(value, target, "") != 1) {
        return out;
      }
      let i: i32 = 0;
      while (i < sl.field_values.len() && i < sl.field_names.len()) {
        let fname: string = sl.field_names[i];
        match (sl.field_values[i]) {
          ast.ExprCall(c) => {
            match (c.callee) {
              ast.ExprIdent(cid) => {
                if (ow_is_own_func(ctx.ofuncs, cid.name) && ow_count_field_reads(value, target, fname) == 1) {
                  let flags: boolean[] = ow_func_flags(ctx.ofuncs, cid.name);
                  let j: i32 = 0;
                  while (j < c.args.len() && j < flags.len()) {
                    if (flags[j] && ow_is_field_read(c.args[j], target, fname)) {
                      out = out.append(target + "." + fname);
                      j = flags.len();
                    } else {
                      j = j + 1;
                    }
                  }
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
        i = i + 1;
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

// OwnCall is a call's arguments in its callee's parameter order, a method's
// receiver first, beside the callee's `own` flags: empty when it takes
// nothing `own`.
// `recv` says what args[0] is: RECV_NONE for a plain call, RECV_METHOD for a
// method's receiver, with `arr` the row's array-typed positions, and RECV_DYN
// for a `dyn` receiver: its moves count but nothing is guarded, as native
// guards no `dyn` dispatch.
struct OwnCall { args: ast.Expr[], flags: boolean[], arr: boolean[], recv: i32 }

const RECV_NONE: i32 = 0;

const RECV_METHOD: i32 = 1;

const RECV_DYN: i32 = 2;

function ow_own_call(c: ast.ExprCall, ctx: OwnCtx): OwnCall {
  let key: string = ow_method_key(c, ctx);
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (key.len() > 0) {
      let args: ast.Expr[] = [fa.obj];
      for a in c.args {
        args = args.append(a);
      }
      let row: i32 = ctx.ofuncs.names.find(key);
      let arr: boolean[] = [];
      if (row >= 0) {
        arr = ctx.ofuncs.rows[row].arr;
      }
      return OwnCall { args: args, flags: ow_func_flags(ctx.ofuncs, key), arr: arr, recv: ow_recv_kind(key) };
    }
  }
  let flags: boolean[] = ow_call_arg_flags(c.callee, ctx);
  let arr: boolean[] = [];
  if (flags.len() > 0) {
    if let typeinfo.TypeFunc(ft) = check_expr(c.callee, ctx.scope) {
      for t in ft.param_types {
        arr = arr.append(is_owned_array(t) || is_arr_view(t) || is_unknown(t));
      }
    }
  }
  return OwnCall { args: c.args, flags: flags, arr: arr, recv: RECV_NONE };
}

function ow_recv_kind(key: string): i32 {
  if (key.len() >= 4 && slice_unchecked(key, 0, 4) == "dyn ") {
    return RECV_DYN;
  }
  return RECV_METHOD;
}

// ow_arg_dies: a method call's argument, at a position that is not
// array-typed, that the last-use pass found dead under that condition
// (lu_method_arg's `~` key).
function ow_arg_dies(oc: OwnCall, i: i32, ctx: OwnCtx): boolean {
  if (oc.recv == RECV_DYN || i >= oc.arr.len() || oc.arr[i]) {
    return false;
  }
  if let ast.ExprIdent(id) = oc.args[i] {
    return util.has_str(ctx.last_use, lu_key(id.line, id.col) + "~");
  }
  return false;
}

// ow_guard_call: E051 — each argument passed to an `own` parameter, a method's
// receiver included, must be an owned value.
function ow_guard_call(c: ast.ExprCall, ctx: OwnCtx): util.Diag[] {
  let out: util.Diag[] = [];
  let oc: OwnCall = ow_own_call(c, ctx);
  let i: i32 = 0;
  while (i < oc.args.len() && i < oc.flags.len()) {
    let exempt: boolean = oc.recv == RECV_DYN || ow_arg_dies(oc, i, ctx);
    if (oc.flags[i] && !exempt && !ow_is_owned_expr(oc.args[i], ctx)) {
      // The argument is the anchor, as native's is; a kind that carries no
      // position of its own falls back to the call.
      let aline: i32 = ast.expr_line(oc.args[i]);
      let acol: i32 = ast.expr_col(oc.args[i]);
      if (aline <= 0) {
        aline = c.line;
        acol = c.col;
      }
      out = out.append(dg_at("E051", "argument to owned parameter must be an owned value (a fresh construction, another `own` parameter, or a local at its last use), not a borrowed one", aline, acol));
    }
    i = i + 1;
  }
  return out;
}

// ow_walk_call is the precise affine model over a call: an owned value is
// CONSUMED only when passed to an `own` parameter; an argument to a borrowed
// parameter is a read (borrow), not a move — so a borrowing helper can be
// passed an owned value and the value still used / consumed afterwards. The
// callee is a borrow (function ref / closure / method receiver) unless it is
// a method taking its receiver `own`.
function ow_walk_call(c: ast.ExprCall, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  let d: util.Diag[] = ow_guard_call(c, ctx);
  let oc: OwnCall = ow_own_call(c, ctx);
  let m: MovedEntry[] = moved;
  // A method's receiver leads the arguments and is walked as one.
  if (oc.args.len() == c.args.len()) {
    let rc: OwnWalk = ru_borrow(c.callee, m, ctx);
    m = rc.moved;
    d = util.append_diags(d, rc.diags);
  }
  let i: i32 = 0;
  while (i < oc.args.len()) {
    let ra: OwnWalk = ru_borrow(oc.args[i], m, ctx);
    if (i < oc.flags.len() && oc.flags[i]) {
      ra = ru_expr(oc.args[i], m, ctx);
    }
    m = ra.moved;
    d = util.append_diags(d, ra.diags);
    i = i + 1;
  }
  return OwnWalk { moved: m, diags: d };
}

// ow_call_arg_flags returns the callee's per-parameter `own` flags for a
// plain (ident-callee) call, or an empty list when the callee is not an
// own-func or a function value whose type declares consuming slots.
// A method receiver is ow_own_call's case.
// Drives the precise affine model: an argument is consumed only at an `own`
// position.
function ow_call_arg_flags(callee: ast.Expr, ctx: OwnCtx): boolean[] {
  match (callee) {
    ast.ExprIdent(id) => {
      if (util.has_str(ctx.bound, id.name)) {
        if let typeinfo.TypeFunc(ft) = check_expr(callee, ctx.scope) {
          return ft.param_own;
        }
        return [];
      }
      if (ow_is_own_func(ctx.ofuncs, id.name)) {
        return ow_func_flags(ctx.ofuncs, id.name);
      }
      return [];
    },
    _ => {
      if let typeinfo.TypeFunc(ft) = check_expr(callee, ctx.scope) {
        return ft.param_own;
      }
      return [];
    }
  }
}

// ru_borrow processes a borrow-position expression: a bare owned ident is
// a borrow (no consume) but using it after a move is still E050; anything
// else is processed as an ordinary (consume-position) expression.
function ru_borrow(e: ast.Expr, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  match (e) {
    ast.ExprIdent(id) => {
      let d: util.Diag[] = [];
      if (ow_is_owned(ctx, id.name) && ow_moved_has(moved, id.name)) {
        d = d.append(dg_at("E050", "use of owned parameter \"" + id.name + "\" after it was consumed (moved at line " + util.i32_to_string(util.pos_line(ow_moved_line(moved, id.name))) + ")", id.line, id.col));
      }
      return OwnWalk { moved: moved, diags: d };
    },
    _ => {
      return ru_expr(e, moved, ctx);
    }
  }
}

// ru_expr processes a consume-position expression left-to-right, threading
// the moved set: a bare owned ident is consumed (or E050 if already
// moved); projections/call-callees/receivers borrow their target.
function ru_expr(e: ast.Expr, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  match (e) {
    ast.ExprIdent(id) => {
      let d: util.Diag[] = [];
      let m: MovedEntry[] = moved;
      if (ow_is_owned(ctx, id.name)) {
        if (ow_moved_has(moved, id.name)) {
          d = d.append(dg_at("E050", "use of owned parameter \"" + id.name + "\" after it was consumed (moved at line " + util.i32_to_string(util.pos_line(ow_moved_line(moved, id.name))) + ")", id.line, id.col));
        } else {
          m = ow_moved_add(moved, id.name, id.line);
        }
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprFieldAccess(fa) => {
      return ru_borrow(fa.obj, moved, ctx);
    },
    ast.ExprIndex(ix) => {
      let r1: OwnWalk = ru_borrow(ix.array, moved, ctx);
      let r2: OwnWalk = ru_expr(ix.index, r1.moved, ctx);
      return OwnWalk { moved: r2.moved, diags: util.append_diags(r1.diags, r2.diags) };
    },
    ast.ExprSlice(sl) => {
      let r1: OwnWalk = ru_borrow(sl.array, moved, ctx);
      let r2: OwnWalk = ru_expr(sl.start, r1.moved, ctx);
      let r3: OwnWalk = ru_expr(sl.end, r2.moved, ctx);
      return OwnWalk { moved: r3.moved, diags: util.append_diags(util.append_diags(r1.diags, r2.diags), r3.diags) };
    },
    ast.ExprCall(c) => {
      // IIFE — a 0-arg call of a 0-param lambda runs its body in
      // place (the parser desugars match-/if-EXPRESSIONS to this), so
      // its consumes belong to the enclosing scope. Analyse the body
      // directly rather than treating it as an opaque closure.
      match (c.callee) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() == 0 && c.args.len() == 0) {
            return ow_stmts(ow_value_block_stmts(lm), moved, ctx);
          }
        },
        _ => {}
      }
      return ow_walk_call(c, moved, ctx);
    },
    ast.ExprBinary(b) => {
      let r1: OwnWalk = ru_expr(b.left, moved, ctx);
      let r2: OwnWalk = ru_expr(b.right, r1.moved, ctx);
      return OwnWalk { moved: r2.moved, diags: util.append_diags(r1.diags, r2.diags) };
    },
    ast.ExprUnary(u) => {
      return ru_expr(u.operand, moved, ctx);
    },
    ast.ExprArray(a) => {
      let m: MovedEntry[] = moved;
      let d: util.Diag[] = [];
      for element in a.elements {
        let r: OwnWalk = ru_expr(element, m, ctx);
        m = r.moved;
        d = util.append_diags(d, r.diags);
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprTuple(t) => {
      let m: MovedEntry[] = moved;
      let d: util.Diag[] = [];
      for element in t.elements {
        let r: OwnWalk = ru_expr(element, m, ctx);
        m = r.moved;
        d = util.append_diags(d, r.diags);
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprStructLit(s) => {
      let m: MovedEntry[] = moved;
      let d: util.Diag[] = [];
      // `S { ...base, f: v }`: the spread READS base's fields (the new
      // struct co-owns its pointer fields via the construction
      // alias-inc) — a borrow, not a transfer, so the record-update
      // idiom `a = A { ...a, f: a.f.append(v) }` on an `own a` is not a
      // use-after-move. The named field VALUES below are still consumes.
      if (s.has_base) {
        let rb: OwnWalk = ru_borrow(s.base, m, ctx);
        m = rb.moved;
        d = util.append_diags(d, rb.diags);
      }
      for field_value in s.field_values {
        let r: OwnWalk = ru_expr(field_value, m, ctx);
        m = r.moved;
        d = util.append_diags(d, r.diags);
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprLambda(lm) => {
      // A closure body is analysed the way ow_loop analyses a loop body: from
      // the state at the point the closure is CREATED, with the out-state
      // DISCARDED. It may run zero times or many, and at an unknown later
      // point, so its moves cannot flow back into the enclosing sequence — but
      // a capture already consumed before the closure exists is a use-after-
      // move whenever it does run, which is the E050 native reports here.
      //
      // Unlike ow_loop this adds no "consumed inside something that may
      // repeat" diagnostic: native does not report one for a closure, only for
      // a loop. Measured, not assumed.
      //
      // The IIFE form is handled in ow_stmt's ExprCall arm instead, where the
      // body DOES belong to the enclosing flow because it runs in place.
      //
      // The lambda's PARAMETERS layer over the enclosing owned set. A nested
      // named function parses as one of these, so without that a local
      // `function inner(own b)` could not transfer `b` onward, and a plain
      // parameter repeating an outer owned name would be read as that name
      // (#7452).
      let lctx: OwnCtx = ow_nested_ctx(ctx, lm);
      let inner: OwnWalk = ow_stmts(lm.body, ow_nested_moved(moved, lm.params), lctx);
      return OwnWalk { moved: moved, diags: inner.diags };
    },
    _ => {
      return OwnWalk { moved: moved, diags: [] };
    }
  }
}

// ow_value_block_stmts is a value block's body without the unreachable filler
// value the parser gives a branch that always leaves (mx_branch_yields): it
// repeats the branch's own `return` value, so walking it would count that
// value's moves twice. A written IIFE is ordinary code and is walked whole.
function ow_value_block_stmts(lm: ast.ExprLambda): ast.Stmt[] {
  if (lm.origin == parser.ORIGIN_BLOCK) {
    return ow_branch_stmts(lm.body);
  }
  if (lm.origin != parser.ORIGIN_IF_EXPR && lm.origin != parser.ORIGIN_MATCH_EXPR) {
    return lm.body;
  }
  let out: ast.Stmt[] = [];
  for st in lm.body {
    out = out.append(ow_value_arms(st));
  }
  return out;
}

function ow_value_arms(st: ast.Stmt): ast.Stmt {
  match (st) {
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      for arm in m.arms {
        arms = arms.append(ast.MatchArm { ...arm, body: ow_branch_stmts(arm.body) });
      }
      return ast.StmtMatch { ...m, arms: arms };
    },
    ast.StmtIf(f) => {
      let els: ast.Stmt[] = ow_branch_stmts(f.else_body);
      if (f.else_body.len() == 1) {
        if let ast.StmtIf(_) = f.else_body[0] {
          els = [ow_value_arms(f.else_body[0])];
        }
      }
      return ast.StmtIf { ...f, then_body: ow_branch_stmts(f.then_body), else_body: els };
    },
    _ => {
      return st;
    }
  }
}

function ow_branch_stmts(body: ast.Stmt[]): ast.Stmt[] {
  if (mx_branch_yields(body)) {
    return body;
  }
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    out = out.append(body[i]);
    i = i + 1;
  }
  return out;
}

// ow_loop walks a loop body once from the entry state and flags any owned
// param it consumes that was live at entry — a later iteration would use
// it after move. The fall-through state is left unchanged (the loop may
// run zero times).
function ow_loop(body: ast.Stmt[], moved: MovedEntry[], ctx: OwnCtx): util.Diag[] {
  let r: OwnWalk = ow_stmts(body, moved, ctx);
  let out: util.Diag[] = r.diags;
  for elem in r.moved {
    let nm: string = elem.mname;
    if (!ow_moved_has(moved, nm)) {
      out = out.append(dg_at("E050", "owned parameter \"" + nm + "\" is consumed inside a loop; a later iteration would use it after move", elem.mline, 0));
    }
  }
  return out;
}

function ow_stmt(st: ast.Stmt, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  match (st) {
    ast.StmtVar(v) => {
      return ru_expr(v.init, moved, ctx);
    },
    ast.StmtReturn(r) => {
      // The return form of the superseded-field move (#8186): nothing runs
      // after the return, so the field cannot be read back.
      let rctx: OwnCtx = ctx;
      match (r.value) {
        ast.ExprStructLit(sl) => {
          if (sl.has_base) {
            let base: string = ow_ident_name(sl.base);
            if (base.len() > 0 && !util.has_str(ctx.borrowed, base)) {
              rctx = OwnCtx { ...ctx, admit_fields: ow_field_move_fields(base, r.value, ctx) };
            }
          }
        },
        _ => {}
      }
      return ru_expr(r.value, moved, rctx);
    },
    ast.StmtExpr(e) => {
      return ru_expr(e.value, moved, ctx);
    },
    ast.StmtAssign(a) => {
      // Reassigning the bare owned param rebinds it to a fresh value, so
      // its consumed state resets; otherwise the rhs is a consume.
      // Self-reassign move admission (#4873 step 0): `x = f(..., x, ...)`
      // with local x passed exactly once, directly, in an `own`
      // position — admit that occurrence for the RHS walk only.
      // Superseded-field move admission (#8186): `x = S { ...x, f: g(..,
      // x.f, ..) }` with x an own param or a local — the store supersedes
      // the field the call consumes.
      let actx: OwnCtx = ctx;
      if (!ow_is_owned(ctx, a.target) && ow_self_move_admits(a.target, a.value, ctx)) {
        actx = OwnCtx { ...ctx, admit: a.target };
      }
      if (!util.has_str(ctx.borrowed, a.target)) {
        actx = OwnCtx { ...actx, admit_fields: ow_field_move_fields(a.target, a.value, ctx) };
      }
      let rv: OwnWalk = ru_expr(a.value, moved, actx);
      if (ow_is_owned(ctx, a.target)) {
        return OwnWalk { moved: ow_moved_del(rv.moved, a.target), diags: rv.diags };
      }
      return rv;
    },
    ast.StmtIf(f) => {
      // A bare `{ … }` statement is not a branch: its consumes stand, as
      // native's walker reads an *ast.Block's statements in line.
      if (f.origin == "block") {
        return ow_stmts(f.then_body, moved, ctx);
      }
      let rc: OwnWalk = ru_expr(f.cond, moved, ctx);
      let rt: OwnWalk = ow_stmts(f.then_body, rc.moved, ctx);
      let re: OwnWalk = ow_stmts(f.else_body, rc.moved, ctx);
      let m: MovedEntry[] = ow_moved_join(rc.moved, rt.moved, block_diverges(f.then_body));
      m = ow_moved_join(m, re.moved, f.else_body.len() > 0 && block_diverges(f.else_body));
      return OwnWalk { moved: m, diags: util.append_diags(util.append_diags(rc.diags, rt.diags), re.diags) };
    },
    ast.StmtWhile(w) => {
      let rc: OwnWalk = ru_expr(w.cond, moved, ctx);
      let ld: util.Diag[] = ow_loop(w.body, rc.moved, ctx);
      return OwnWalk { moved: rc.moved, diags: util.append_diags(rc.diags, ld) };
    },
    ast.StmtFor(fr) => {
      let ri: OwnWalk = ru_borrow(fr.iter, moved, ctx);
      let fctx: OwnCtx = ow_bind_ctx(ctx, fr.var_name);
      let ld: util.Diag[] = ow_loop(fr.body, ri.moved, OwnCtx { ...fctx, scope: for_body_scope(fr, ctx.scope) });
      return OwnWalk { moved: ri.moved, diags: util.append_diags(ri.diags, ld) };
    },
    ast.StmtMatch(m) => {
      // Matching an OWNED scrutinee decomposes the box and MOVES its
      // pointer-typed payloads into the arm bindings, so each is itself owned
      // for that arm — the `map(own xs) => Cons(h + 1, map(t))` shape, where
      // `t` is transferred onward. Scalar payloads are copied, not moved.
      let scrut_owned: boolean = ow_is_owned_scrutinee(m.scrutinee, ctx);
      let rs: OwnWalk = ru_expr(m.scrutinee, moved, ctx);
      // A match no arm of which takes a pointer payload out leaves the value
      // whole, so it does not consume a named scrutinee (#9539).
      if let ast.ExprIdent(sid) = m.scrutinee {
        let takes: boolean = false;
        for arm in m.arms {
          takes = takes || ow_arm_takes_pointer(ctx, arm.pattern);
        }
        if (!takes) {
          rs = OwnWalk { ...rs, moved: ow_unmove(rs.moved, moved, sid.name) };
        }
      }
      let mv: MovedEntry[] = rs.moved;
      let d: util.Diag[] = rs.diags;
      let whole: typeinfo.Type = check_expr(m.scrutinee, ctx.scope);
      for arm in m.arms {
        // A binder shadows for its arm either way; only the ownership
        // TRANSFER below depends on the scrutinee being owned.
        let actx: OwnCtx = ow_arm_bind_ctx(ctx, arm.pattern);
        actx = OwnCtx { ...actx, scope: annotate_arm_scope(arm, ctx.scope, whole) };
        if (scrut_owned) {
          actx = ow_arm_payload_ctx(actx, arm.pattern);
        } else {
          actx = ow_arm_lent_ctx(actx, arm.pattern);
        }
        let ra: OwnWalk = ow_stmts(arm.body, rs.moved, actx);
        d = util.append_diags(d, ra.diags);
        mv = ow_moved_join(mv, ra.moved, block_diverges(arm.body));
      }
      return OwnWalk { moved: mv, diags: d };
    },
    ast.StmtDefer(dd) => {
      let one: ast.Stmt[] = [dd.action];
      return ow_stmts(one, moved, ctx);
    },
    _ => {
      return OwnWalk { moved: moved, diags: [] };
    }
  }
}

function ow_stmts(stmts: ast.Stmt[], moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  let m: MovedEntry[] = moved;
  let d: util.Diag[] = [];
  // A local binds for the REST OF THIS BLOCK: after its own statement, so its
  // initialiser still sees the global, and not at all in an enclosing block,
  // since each block walks its own copy.
  let c: OwnCtx = ctx;
  for stmt in stmts {
    let r: OwnWalk = ow_stmt(stmt, m, c);
    m = r.moved;
    d = util.append_diags(d, r.diags);
    if let ast.StmtVar(v) = stmt {
      c = ow_bind_ctx(c, v.name);
    }
    c = OwnCtx { ...c, scope: bind_stmt(stmt, c.scope) };
  }
  return OwnWalk { moved: m, diags: d };
}

function ow_moved_del(m: MovedEntry[], name: string): MovedEntry[] {
  let out: MovedEntry[] = [];
  for elem in m {
    if (elem.mname != name) {
      out = out.append(elem);
    }
  }
  return out;
}

// A function's own parameter names: the bindings in scope before its body
// begins. Everything else — locals, `for` variables, arm binders, a lambda's
// parameters — layers onto this as the walk reaches the scope it binds in.
function ow_param_names(fn: parser.FuncDecl): string[] {
  let out: string[] = [];
  for p in fn.params {
    out = out.append(p.name);
  }
  return out;
}

// ow_arm_bind_ctx layers a match arm's binder NAMES, whatever the scrutinee's
// ownership: the binder shadows an own-func of the same name for its arm even
// when nothing was transferred into it.
function ow_arm_bind_ctx(ctx: OwnCtx, pat: ast.Pattern): OwnCtx {
  if let ast.PatVariant(pv) = pat {
    let c: OwnCtx = ctx;
    if (pv.binding.len() > 0) {
      c = ow_bind_ctx(c, pv.binding);
    }
    for extra in pv.extra_bindings {
      c = ow_bind_ctx(c, extra);
    }
    return c;
  }
  return ctx;
}

// ow_bind_ctx layers one binding onto the set of names in scope — a `for`
// variable or a match arm's binder, each of which shadows for its body only.
function ow_bind_ctx(ctx: OwnCtx, name: string): OwnCtx {
  if (name.len() == 0) {
    return ctx;
  }
  if (util.has_str(ctx.bound, name)) {
    return ctx;
  }
  return OwnCtx { ...ctx, bound: ctx.bound.append(name) };
}

// ow_arm_payload_ctx layers a match arm's pointer-typed payload bindings onto
// the owned set. The payload types come from the variant's synthesised struct
// decl (`__ev`, `__ev1`, …), which is where the self-host records them. A
// struct-union member's binding is the member's box itself, a pointer.
//
// ow_arm_lent_ctx is its counterpart for a BORROWED scrutinee: the same
// bindings read the caller's box, so a field moved out of one would be read
// back, as out of a borrowed parameter.
// Every binding is marked, a scalar's included: `borrowed` only gates what
// a field move may read through, which a scalar has no part in.
function ow_arm_lent_ctx(ctx: OwnCtx, pat: ast.Pattern): OwnCtx {
  if let ast.PatVariant(pv) = pat {
    let borrowed: string[] = ctx.borrowed;
    if (pv.binding.len() > 0 && pv.binding != "_" && !util.has_str(borrowed, pv.binding)) {
      borrowed = borrowed.append(pv.binding);
    }
    for extra in pv.extra_bindings {
      if (extra.len() > 0 && extra != "_" && !util.has_str(borrowed, extra)) {
        borrowed = borrowed.append(extra);
      }
    }
    return OwnCtx { ...ctx, borrowed: borrowed };
  }
  return ctx;
}

// ow_unmove drops the move of `name` a walk recorded on top of `before`.
function ow_unmove(after: MovedEntry[], before: MovedEntry[], name: string): MovedEntry[] {
  let out: MovedEntry[] = [];
  for e in after {
    let kept: boolean = e.mname != name;
    for b in before {
      kept = kept || b.mname == e.mname && b.mline == e.mline;
    }
    if (kept) {
      out = out.append(e);
    }
  }
  return out;
}

// ow_arm_takes_pointer reports whether an arm's pattern binds a payload of
// pointer type: only that takes anything out of the scrutinee's box.
function ow_arm_takes_pointer(ctx: OwnCtx, pat: ast.Pattern): boolean {
  let bound: OwnCtx = ow_arm_payload_ctx(OwnCtx { ...ctx, owned: [] }, pat);
  for n in bound.owned {
    if (n != "_") {
      return true;
    }
  }
  return false;
}

function ow_arm_payload_ctx(ctx: OwnCtx, pat: ast.Pattern): OwnCtx {
  if let ast.PatVariant(pv) = pat {
    // `E.Cons` and a bare `Cons` name the same variant decl.
    let vname: string = util.base_type_name(pv.type_name);
    let di: i32 = 0;
    let dot: i32 = 0 - 1;
    while (di < vname.len()) {
      if (vname[di] == b'.') {
        dot = di;
      }
      di = di + 1;
    }
    if (dot >= 0) {
      vname = slice_unchecked(vname, dot + 1, vname.len()) + "";
    }
    let binds: string[] = [];
    if (pv.binding.len() > 0) {
      binds = binds.append(pv.binding);
    }
    for extra in pv.extra_bindings {
      binds = binds.append(extra);
    }
    if (binds.len() == 0) {
      return ctx;
    }
    let names: string[] = ctx.owned;
    for sd in ctx.structs {
      if (sd.name == vname && sd.enum_owner.len() == 0) {
        if (binds[0] != "_" && !util.has_str(names, binds[0])) {
          names = names.append(binds[0]);
        }
      } else if (sd.name == vname && sd.enum_owner.len() > 0) {
        let i: i32 = 0;
        while (i < binds.len() && i < sd.fields.len()) {
          if (binds[i].len() > 0 && binds[i] != "_" && ow_type_is_pointer_name(sd.fields[i].type_name, ctx.ofuncs)
            && !util.has_str(names, binds[i])) {
            names = names.append(binds[i]);
          }
          i = i + 1;
        }
      }
    }
    return OwnCtx { ...ctx, owned: names };
  }
  return ctx;
}

// collect_own_funcs records every function that has at least one `own`
// parameter, with a per-parameter owned-flag list (for the E051 guard).
function collect_own_funcs(mod: parser.Module): OwnFuncs {
  let out: OwnFunc[] = [];
  let names: string[] = [];
  let methods: string[] = [];
  let funcs: string[] = [];
  for func in mod.funcs {
    if (func.receiver_name.len() == 0) {
      funcs = funcs.append(func.name);
    }
    let any_own: boolean = func.receiver_own;
    let flags: boolean[] = [];
    let arr: boolean[] = [];
    if (func.receiver_name.len() > 0) {
      flags = flags.append(func.receiver_own);
      arr = arr.append(ow_type_is_array(func.receiver_type));
    }
    for param in func.params {
      let o: boolean = param.own;
      flags = flags.append(o);
      arr = arr.append(ow_type_is_array(param.type_name));
      if (o) {
        any_own = true;
      }
    }
    if (any_own && func.receiver_name.len() == 0) {
      out = out.append(OwnFunc { name: func.name, flags: flags, arr: arr });
      names = names.append(func.name);
    } else if (any_own) {
      let key: string = ow_receiver_ns(func.receiver_type) + "." + func.name;
      out = out.append(OwnFunc { name: key, flags: flags, arr: arr });
      names = names.append(key);
      methods = methods.append(func.name);
    }
  }
  for td in mod.trait_decls {
    for m in td.methods {
      if (ow_takes_own_self(m)) {
        let row: OwnFunc = ow_trait_row(td.name, m);
        out = out.append(row);
        names = names.append(row.name);
        methods = methods.append(m.name);
      }
    }
  }
  let structs: string[] = [];
  let ctors: string[] = [];
  for sd in mod.structs {
    structs = structs.append(sd.name);
    ctors = ctors.append(sd.name);
    if (sd.enum_owner.len() > 0) {
      structs = structs.append(sd.enum_owner);
    }
  }
  let decls: string[] = [];
  for ed in mod.enums {
    decls = decls.append(ed.name);
  }
  for alias in mod.aliases {
    decls = decls.append(alias.name);
  }
  return OwnFuncs { rows: out, names: util.name_index(names), structs: util.name_index(structs), decls: util.name_index(decls), ctors: util.name_index(ctors), methods: util.name_index(methods), funcs: util.name_index(funcs) };
}

// ow_takes_own_self: a trait method whose receiver, its first parameter
// `self`, is `own`.
function ow_takes_own_self(m: parser.FuncDecl): boolean {
  return m.params.len() > 0 && m.params[0].name == "self" && m.params[0].own;
}

// ow_trait_row is the row a `dyn` receiver calls trait `tname`'s method `m`
// through, keyed `dyn Trait.method`.
function ow_trait_row(tname: string, m: parser.FuncDecl): OwnFunc {
  let flags: boolean[] = [];
  let arr: boolean[] = [];
  for param in m.params {
    flags = flags.append(param.own);
    arr = arr.append(ow_type_is_array(param.type_name));
  }
  return OwnFunc { name: "dyn " + tname + "." + m.name, flags: flags, arr: arr };
}

// ow_receiver_ns is the namespace a method with this receiver spelling is
// called through: an array, a view, a string, or the base type name.
function ow_receiver_ns(rt: string): string {
  if (parser.spelling_is_view(rt)) {
    return "[_]";
  }
  if (array_receiver_matches(rt, false)) {
    return "[]";
  }
  return util.base_type_name(receiver_namespace(rt));
}

function ow_type_is_array(tn: string): boolean {
  return tn.len() >= 2 && tn[tn.len() - 2] == b'[' && tn[tn.len() - 1] == b']';
}

// ow_method_key is the own-func row of a method call, by the receiver's
// checked type, or "" when the callee is no such method.
function ow_method_key(c: ast.ExprCall, ctx: OwnCtx): string {
  if let ast.ExprFieldAccess(fa) = c.callee {
    for ns in ow_type_namespaces(check_expr(fa.obj, ctx.scope)) {
      let key: string = ns + "." + fa.field;
      if (ow_is_own_func(ctx.ofuncs, key)) {
        return key;
      }
    }
  }
  return "";
}

// ow_type_namespaces is what a value of type `t` finds methods under, as
// ow_receiver_ns and the trait rows name them.
function ow_type_namespaces(t: typeinfo.Type): string[] {
  match (t) {
    typeinfo.TypeStruct(st) => {
      return [st.name];
    },
    typeinfo.TypeUnion(u) => {
      return [u.name];
    },
    typeinfo.TypeArray(a) => {
      if (a.view) {
        return ["[_]"];
      }
      return ["[]"];
    },
    typeinfo.TypeString(_) => {
      return ["string"];
    },
    typeinfo.TypeMap(_) => {
      return ["Map"];
    },
    typeinfo.TypeDyn(d) => {
      let out: string[] = [];
      for n in parser.dyn_trait_set("dyn " + d.traits) {
        out = out.append("dyn " + n);
      }
      return out;
    },
    _ => {
      let none: string[] = [];
      return none;
    }
  }
  let none: string[] = [];
  return none;
}

// ow_type_is_pointer reports whether a declared type SPELLING is
// pointer-shaped, native's ast.IsPointerType over the self-host's type text:
// strings, arrays / slices, tuples, function values, trait objects, and
// declared struct / enum names. Every scalar width, `boolean`, `char`, `void`
// and an unresolved name (an erased type parameter) are not.
function ow_type_is_pointer_name(tn: string, ofuncs: OwnFuncs): boolean {
  if (tn.len() == 0 || tn == "void") {
    return false;
  }
  if (tn == "string" || tn == "str" || tn == "fn") {
    return true;
  }
  if (tn[tn.len() - 1] == b']') {
    return true;
  }
  if (tn[0] == b'(') {
    return true;
  }
  if (tn.len() >= 4 && slice_unchecked(tn, 0, 4) == "dyn ") {
    return true;
  }
  let base: string = util.base_type_name(tn);
  if (parser.is_reserved_struct_name(base) || parser.is_reserved_enum_name(base)) {
    return true;
  }
  return ofuncs.structs.has(base);
}

// The module form adds the names only a whole module carries: a declared enum
// with no payload variants, and a union alias.
function ow_type_is_pointer(tn: string, ofuncs: OwnFuncs): boolean {
  if (ow_type_is_pointer_name(tn, ofuncs)) {
    return true;
  }
  return ofuncs.decls.has(util.base_type_name(tn));
}

// The ownership of a call's RESULT, which decides whether passing it into an
// `own` parameter transfers or borrows. Native's half is computeResultBorrows
// in internal/check/checker/result_borrow.go; these functions mirror it.
// ow_spine_stmts flattens a body into every statement its control flow
// encloses. fold_stmt_spine enters no expression, so a lambda's body — whose
// returns belong to the lambda, not to this function — stays out of it.
function ow_collect_stmt(st: ast.Stmt, own acc: ast.Stmt[]): ast.Stmt[] {
  return acc.append(st);
}

function ow_spine_stmts(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for st in body {
    out = astwalk.fold_stmt_spine(st, out, ow_collect_stmt);
  }
  return out;
}

// ow_borrowed_params names the parameters of `fn` that are pointers the caller
// still owns — the only values whose owner outlives the call.
function ow_borrowed_params(fn: parser.FuncDecl, mod: parser.Module, ofuncs: OwnFuncs): string[] {
  let flags: boolean[] = ow_func_flags(ofuncs, fn.name);
  let out: string[] = [];
  let i: i32 = 0;
  while (i < fn.params.len()) {
    if (ow_decl_type_is_pointer(fn, fn.params[i].type_name, ofuncs)) {
      if (i >= flags.len() || !flags[i]) {
        out = out.append(fn.params[i].name);
      }
    }
    i = i + 1;
  }
  return out;
}

// Native reads a type parameter two ways. The result analysis reads the
// declaration, where its spelling parses as a nominal type and so is
// pointer-shaped (ow_decl_type_is_pointer); the call-site and scrutinee rules
// read the resolved signature, where it is a ParamType and is not
// (ow_sig_type_is_pointer).
function ow_decl_type_is_pointer(fn: parser.FuncDecl, tn: string, ofuncs: OwnFuncs): boolean {
  return util.has_str(fn.all_type_params, tn) || ow_type_is_pointer(tn, ofuncs);
}

function ow_sig_type_is_pointer(fn: parser.FuncDecl, tn: string, ofuncs: OwnFuncs): boolean {
  return !util.has_str(fn.all_type_params, tn) && ow_type_is_pointer(tn, ofuncs);
}

// ow_elem_type_name is the element of an array (`T[]`) or view (`[T]`) type
// name, or "" for any other.
function ow_elem_type_name(tn: string): string {
  let n: i32 = tn.len();
  if (n > 2 && tn[n - 2] == b'[' && tn[n - 1] == b']') {
    return slice_unchecked(tn, 0, n - 2) + "";
  }
  if (n > 2 && tn[0] == b'[' && tn[n - 1] == b']') {
    return slice_unchecked(tn, 1, n - 1) + "";
  }
  return "";
}

// ow_value_elem_params names the borrowed parameters whose elements are
// values, so that indexing one yields a copy.
function ow_value_elem_params(fn: parser.FuncDecl, borrowed: string[], ofuncs: OwnFuncs): string[] {
  let out: string[] = [];
  for p in fn.params {
    let elem: string = ow_elem_type_name(p.type_name);
    if (util.has_str(borrowed, p.name) && elem.len() > 0 && !ow_type_is_pointer(elem, ofuncs)) {
      out = out.append(p.name);
    }
  }
  return out;
}

// ow_call_may_borrow reports whether a call's result can alias one of the
// arguments it was handed. A struct or variant construction cannot; a declared
// function answers from `borrows`; a builtin from the fresh list below. A
// method is reached through a receiver this walk does not resolve, and any
// other name is a function value, so both are assumed to be able to.
function ow_call_may_borrow(c: ast.ExprCall, ofuncs: OwnFuncs, borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if let ast.ExprIdent(cid) = c.callee {
    if (ofuncs.ctors.has(cid.name)) {
      return false;
    }
    if (builtins.has(cid.name)) {
      return false;
    }
    return borrows.has(cid.name) || !ofuncs.funcs.has(cid.name);
  }
  return true;
}

function ow_value_block_call(c: ast.ExprCall, lm: ast.ExprLambda): boolean {
  if (c.args.len() > 0 || lm.params.len() > 0) {
    return false;
  }
  return lm.origin == parser.ORIGIN_IF_EXPR || lm.origin == parser.ORIGIN_MATCH_EXPR || lm.origin == parser.ORIGIN_BLOCK;
}

function ow_value_if_origin(origin: string): boolean {
  return origin == parser.ORIGIN_IF_EXPR || origin == parser.ORIGIN_IF_DEAD_THEN || origin == parser.ORIGIN_IF_DEAD_ELSE || origin == parser.ORIGIN_IF_DEAD_BOTH;
}

// ow_value_block_borrows answers for a value `if`, `match` or block, which the
// parser lowers to a call of an argument-less lambda. Native reads an `if`
// whose arms are each a bare value arm by arm, and assumes any arm with
// statements, any `match` and any block can borrow. A written IIFE or a
// comprehension has the same shape but is an ordinary call (ow_value_block_call).
function ow_value_block_borrows(lm: ast.ExprLambda, ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if (lm.origin != parser.ORIGIN_IF_EXPR || lm.body.len() != 1) {
    return true;
  }
  return ow_value_arm_borrows(lm.body, ofuncs, borrowed, locals, values, borrows, builtins);
}

function ow_value_arm_borrows(arm: ast.Stmt[], ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if (arm.len() != 1) {
    return true;
  }
  match (arm[0]) {
    ast.StmtReturn(r) => {
      return ow_expr_borrows(r.value, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.StmtIf(f) => {
      if (!ow_value_if_origin(f.origin) || f.sugar.origin.len() > 0) {
        return true;
      }
      return ow_value_arm_borrows(f.then_body, ofuncs, borrowed, locals, values, borrows, builtins) || ow_value_arm_borrows(f.else_body, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    _ => {
      return true;
    }
  }
}

// ow_expr_borrows reports whether `e` can alias one of `borrowed`.
// Pessimistic by construction: a shape that is not a construction and not a
// path this walk follows is assumed to be able to.
function ow_expr_borrows(e: ast.Expr, ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  match (e) {
    ast.ExprBytes(_) => {
      return false;
    },
    ast.ExprNumber(_) => {
      return false;
    },
    ast.ExprString(_) => {
      return false;
    },
    ast.ExprBool(_) => {
      return false;
    },
    ast.ExprFString(_) => {
      return false;
    },
    ast.ExprUnknown(_) => {
      return false;
    },
    ast.ExprZero(_) => {
      return false;
    },
    ast.ExprLambda(_) => {
      return false;
    },
    ast.ExprStructLit(_) => {
      return false;
    },
    ast.ExprArray(_) => {
      return false;
    },
    ast.ExprTuple(_) => {
      return false;
    },
    ast.ExprMapLit(_) => {
      return false;
    },
    ast.ExprBinary(_) => {
      return false;
    },
    ast.ExprUnary(_) => {
      return false;
    },
    ast.ExprIdent(id) => {
      return util.has_str(borrowed, id.name) || util.has_str(locals, id.name);
    },
    ast.ExprFieldAccess(fa) => {
      return ow_expr_borrows(fa.obj, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.ExprIndex(ix) => {
      if let ast.ExprIdent(aid) = ix.array {
        if (util.has_str(values, aid.name)) {
          return false;
        }
      }
      return ow_expr_borrows(ix.array, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.ExprSlice(sl) => {
      return ow_expr_borrows(sl.array, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.ExprCall(c) => {
      return ow_call_borrows(c, ofuncs, borrowed, locals, values, borrows, builtins);
    }
  }
}

// ow_call_borrows: a callee that can hand a borrowed parameter back aliases
// whichever argument it was given, so its result is a borrow here only when
// one of those arguments is one.
function ow_call_borrows(c: ast.ExprCall, ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if let ast.ExprLambda(lm) = c.callee {
    if (ow_value_block_call(c, lm)) {
      return ow_value_block_borrows(lm, ofuncs, borrowed, locals, values, borrows, builtins);
    }
  }
  if (!ow_call_may_borrow(c, ofuncs, borrows, builtins)) {
    return false;
  }
  for a in c.args {
    if (ow_expr_borrows(a, ofuncs, borrowed, locals, values, borrows, builtins)) {
      return true;
    }
  }
  return false;
}

// ow_borrowed_locals names the locals that can hold a borrow of one of
// `borrowed`. Settled to a fixed point rather than read once, so a value that
// only becomes a borrow on a loop's second iteration is still seen.
function ow_borrowed_locals(spine: ast.Stmt[], ofuncs: OwnFuncs, borrowed: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): string[] {
  let locals: string[] = [];
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for st in spine {
      let name: string = "";
      let init: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
      if let ast.StmtVar(v) = st {
        name = v.name;
        init = v.init;
      }
      if let ast.StmtAssign(a) = st {
        name = a.target;
        init = a.value;
      }
      if (name.len() == 0 || util.has_str(locals, name)) {
        continue;
      }
      if (ow_expr_borrows(init, ofuncs, borrowed, locals, values, borrows, builtins)) {
        locals = locals.append(name);
        changed = true;
      }
    }
  }
  return locals;
}

// ow_func_result_borrows reports whether any of the returns of `fn` is derived
// from one of its borrowed pointer parameters.
function ow_func_result_borrows(fn: parser.FuncDecl, mod: parser.Module, ofuncs: OwnFuncs, borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  let borrowed: string[] = ow_borrowed_params(fn, mod, ofuncs);
  if (borrowed.len() == 0) {
    return false;
  }
  let values: string[] = ow_value_elem_params(fn, borrowed, ofuncs);
  let spine: ast.Stmt[] = ow_spine_stmts(fn.body);
  let locals: string[] = ow_borrowed_locals(spine, ofuncs, borrowed, values, borrows, builtins);
  for st in spine {
    if let ast.StmtReturn(r) = st {
      if (ow_expr_borrows(r.value, ofuncs, borrowed, locals, values, borrows, builtins)) {
        return true;
      }
    }
  }
  return false;
}

// ow_fresh_builtins are the builtins whose result is fresh. Native registers
// builtins in the same FuncSigs table it reads user functions from, so
// `__alloc_u8(n)` is derived there; here they carry no declaration to derive it
// from, so the ones that pass the test (pointer result, no pointer parameter)
// are listed, and the byte kernels native's freshResultBuiltins names, which
// are lent views and answer an array they built.
// TestSelfHostFreshOwnedBuiltinsMatchChecker recomputes the list from
// native's table and fails when the two drift.
function ow_fresh_builtins(): string[] {
  let out: string[] = [
    "__alloc_bool", "__alloc_i32", "__alloc_i64", "__alloc_u8", "__task_wait", "args", "buf_take", "buf_take_bytes", "cell_new", "clock_set", "environ", "getcwd", "getgroups",
    "hostname", "map_new", "mounts", "pipe", "random_bytes", "set_priority",
    "setgid", "setuid",
    "signal_send", "set_extproc", "set_process_group", "set_window_size",
    "stderr", "stdin", "stdout", "target_arch", "target_os",
    "termios_get", "uname_field", "window_size",
    "__bytes_owned", "__bytes_range", "__bytes_into", "__aes_expand_key", "__aes_ctr32", "__ghash", "__aes_gcm_seal", "__aes_gcm_open", "__sha256_hw_blocks", "__sha1_hw_blocks",
  ];
  // `termios_set` is deliberately absent beside its read half: it TAKES the
  // word array, and a pointer parameter is what the rule excludes. `chroot`
  // and `setgroups` are absent for the same reason — a string and an i64[]
  // are both pointer parameters — where `setgid` and `setuid` take a scalar
  // and so qualify.
  return out;
}

// ow_fresh_owners names the functions whose result cannot alias a value the
// CALLER still owns, so a call to one may be transferred into an `own`
// parameter. Mirrors native's computeResultBorrows (#9538): which functions
// those are comes from what each body RETURNS, not from its parameter list, so
// a factory that takes a reference and builds something new is admitted where
// the parameter-shape test refused it.
//
// Returning a local is not a borrow. A return moves it, so nothing the caller
// holds aliases it afterwards; only a borrowed parameter has an owner that
// outlives the call.
//
// Least fixed point from "nothing borrows": a function is marked when one of
// its returns is derived from a borrowed parameter, and marking one can only
// ever mark its callers, so iterating until nothing changes settles. A
// recursive cycle that returns no borrow is therefore never marked.
// ow_signature_fresh_owners is the pre-#9538 rule, kept for the match
// scrutinee alone (#9539): a pointer-returning function takes no pointer
// parameter, so its result is built fresh, or every pointer parameter is
// `own`, so the callee already took ownership of each.
function ow_signature_fresh_owners(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex): string[] {
  let out: string[] = builtins.names;
  for fn in mod.funcs {
    if (fn.receiver_name.len() > 0 || !ow_sig_type_is_pointer(fn, fn.ret_type, ofuncs)) {
      continue;
    }
    let flags: boolean[] = ow_func_flags(ofuncs, fn.name);
    let any_ptr: boolean = false;
    let all_own: boolean = true;
    let i: i32 = 0;
    while (i < fn.params.len()) {
      if (ow_sig_type_is_pointer(fn, fn.params[i].type_name, ofuncs)) {
        any_ptr = true;
        if (i >= flags.len() || !flags[i]) {
          all_own = false;
        }
      }
      i = i + 1;
    }
    if (!any_ptr || all_own) {
      out = out.append(fn.name);
    }
  }
  return out;
}

// ow_result_borrows settles the least fixed point described at
// ow_fresh_owners. After the first round only a function calling one the
// previous round marked can change its answer, so only those are examined again.
// Only a pending function can be marked, so each pending body's calls to one
// are gathered once (ow_calls_to) and every round reads them.
function ow_result_borrows(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex): util.NameIndex {
  let none: string[] = [];
  let borrows: util.NameIndex = util.name_index(none);
  let pending: parser.FuncDecl[] = [];
  let pnames: string[] = [];
  for fn in mod.funcs {
    if (fn.receiver_name.len() > 0) {
      continue;
    }
    if (ow_decl_type_is_pointer(fn, fn.ret_type, ofuncs)) {
      pending = pending.append(fn);
      pnames = pnames.append(fn.name);
    }
  }
  let pindex: util.NameIndex = util.name_index(pnames);
  let calls: string[][] = [];
  for fn in pending {
    calls = calls.append(ow_calls_to(fn, pindex));
  }
  let first: boolean = true;
  let marked: util.NameIndex = util.name_index(none);
  while (first || marked.names.len() > 0) {
    let now_marked: string[] = [];
    let unmarked: parser.FuncDecl[] = [];
    let unmarked_calls: string[][] = [];
    let i: i32 = 0;
    while (i < pending.len()) {
      let fn: parser.FuncDecl = pending[i];
      if ((first || ow_calls_any(calls[i], marked)) && ow_func_result_borrows(fn, mod, ofuncs, borrows, builtins)) {
        borrows = borrows.added(fn.name);
        now_marked = now_marked.append(fn.name);
      } else {
        unmarked = unmarked.append(fn);
        unmarked_calls = unmarked_calls.append(calls[i]);
      }
      i = i + 1;
    }
    first = false;
    marked = util.name_index(now_marked);
    pending = unmarked;
    calls = unmarked_calls;
  }
  return borrows;
}

// ow_calls_to is the callee name of each call in `fn`'s body that `names`
// holds, a method call's by its field name.
function ow_calls_to(fn: parser.FuncDecl, names: util.NameIndex): string[] {
  let hits: astwalk.CallSite[] = [];
  for st in fn.body {
    hits = astwalk.collect_calls_stmt(st, names, hits);
  }
  let out: string[] = [];
  for h in hits {
    out = out.append(h.name);
  }
  return out;
}

function ow_calls_any(callees: string[], names: util.NameIndex): boolean {
  for n in callees {
    if (names.has(n)) {
      return true;
    }
  }
  return false;
}

// ow_fresh_owners is the complement: every pointer-returning function the
// fixpoint did not mark, plus the builtins.
function ow_fresh_owners(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex, borrows: util.NameIndex): string[] {
  let out: string[] = builtins.names;
  for fn in mod.funcs {
    if (fn.receiver_name.len() > 0 || !ow_sig_type_is_pointer(fn, fn.ret_type, ofuncs)) {
      continue;
    }
    if (borrows.has(fn.name)) {
      continue;
    }
    out = out.append(fn.name);
  }
  return out;
}

// ow_fresh_methods names the method SPELLINGS whose result cannot alias the
// receiver or an argument. A method call is reached by spelling alone here, so
// a spelling several methods share is admitted only when NONE of them can hand
// a borrow back. ow_call_may_borrow already treats every method callee as able
// to, so one pass over the settled `borrows` is enough — a method reached only
// through another method is pessimistic already.
function ow_fresh_methods(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex, borrows: util.NameIndex): string[] {
  let out: string[] = [];
  let refused: string[] = [];
  for fn in mod.funcs {
    if (fn.receiver_name.len() == 0 || fn.type_params.len() > 0) {
      continue;
    }
    if (!ow_type_is_pointer(fn.ret_type, ofuncs)) {
      continue;
    }
    if (ow_func_result_borrows(fn, mod, ofuncs, borrows, builtins)) {
      refused = refused.append(fn.name);
    } else {
      out = out.append(fn.name);
    }
  }
  let kept: string[] = [];
  for name in out {
    if (!util.has_str(refused, name)) {
      kept = kept.append(name);
    }
  }
  return kept;
}

// own_diags checks moves and owned arguments in each function, including
// calls through a consuming function type. The result-borrow fixpoint spans
// the module. Only the bodies `focus` admits are walked.
pub function own_diags(mod: parser.Module, env: ModuleEnv, focus: util.NameIndex): util.Diag[] {
  let ofuncs: OwnFuncs = collect_own_funcs(mod);
  let builtins: util.NameIndex = util.name_index(ow_fresh_builtins());
  let borrows: util.NameIndex = ow_result_borrows(mod, ofuncs, builtins);
  let fresh: string[] = ow_fresh_owners(mod, ofuncs, builtins, borrows);
  let fresh_methods: string[] = ow_fresh_methods(mod, ofuncs, builtins, borrows);
  let fresh_scrut: string[] = ow_signature_fresh_owners(mod, ofuncs, builtins);
  let snames: util.NameIndex = util.name_index(ow_struct_names(mod.structs));
  let out: util.Diag[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    let owned: string[] = [];
    let borrowed: string[] = [];
    if (fn.receiver_own && ow_ownable_type(fn.receiver_type)) {
      owned = owned.append(fn.receiver_name);
    }
    for param in fn.params {
      if (param.own && ow_ownable_type(param.type_name)) {
        owned = owned.append(param.name);
      } else {
        borrowed = borrowed.append(param.name);
      }
    }
    let ctx: OwnCtx = OwnCtx { owned: owned, borrowed: borrowed, ofuncs: ofuncs, structs: mod.structs, snames: snames, admit: "", admit_fields: [], fresh: fresh, fresh_methods: fresh_methods, fresh_scrut: fresh_scrut, bound: ow_param_names(fn), scope: build_func_scope(fn, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs), last_use: lu_last_use_args(fn, ofuncs) };
    let nomoved: MovedEntry[] = [];
    let r: OwnWalk = ow_stmts(fn.body, nomoved, ctx);
    out = util.append_diags(out, r.diags);
  }
  return out;
}

// ===================== captured reference reassignment (E049) ============
// Assigning to a reference-typed (pointer) variable that a closure
// captures from an enclosing scope is E049: such a capture is read-only
// (rebinding it inside the closure could close a reference cycle and never
// takes effect in the outer scope) — return the new value instead. Scalar
// captures (i32 / bool / f64 …) live in the env block and may be
// reassigned freely, so they are exempt. The classification is by the
// declared type-name; an unannotated capture is conservatively skipped.
struct NameTy { nm: string, ty: string }

function e049_append_nt(a: NameTy[], b: NameTy[]): NameTy[] {
  let out: NameTy[] = a;
  for elem in b {
    out = out.append(elem);
  }
  return out;
}

// e049_is_ref classifies a capture's TYPE NAME as reference-shaped (E049
// applies) vs scalar (exempt). The scalar set must match native's
// ast.IsPointerType exactly (internal/syntax/ast) — everything IsPointerType calls
// false is exempt here: every numeric width (i32/i64 and the unsigned
// u8/u32/u64/usize) plus boolean. IsPointerType-true names (string, arrays,
// structs, enums, tuples, maps, dyn) fall through to `true`. An empty name
// (an unannotated `let`) is handled by the caller (e049_scope infers the
// init's shape); reaching here with "" stays conservatively scalar.
function e049_is_ref(tn: string): boolean {
  if (tn.len() == 0) {
    return false;
  }
  if (tn == "i32" || tn == "i64" || tn == "u8" || tn == "u32" || tn == "u64" || tn == "usize" || tn == "boolean" || tn == "f64" || tn == "f32" || tn == "char") {
    return false;
  }
  return true;
}

// e049_ref_capture reports whether `name` names a reference-typed variable
// in the enclosing scope (so assigning it inside a closure is E049).
function e049_ref_capture(enclosing: NameTy[], name: string): boolean {
  for elem in enclosing {
    if (elem.nm == name) {
      return e049_is_ref(elem.ty);
    }
  }
  return false;
}

function e049_capture_label(enclosing: NameTy[], name: string): string {
  for elem in enclosing {
    if (elem.nm == name && elem.ty != "__e049_ref") {
      return util.demangle(elem.ty) + " ";
    }
  }
  return "";
}

// e049_init_ref_ty infers a reference-shaped type marker for an UNANNOTATED
// `let x = <init>` whose init is an unambiguously pointer-shaped LITERAL —
// a string / array / struct / tuple literal, each of which native's full
// inference types as a reference (so a write-back capture of it is E049).
// Returns "" for a scalar literal or any non-literal init (call / ident /
// binary): those stay conservatively scalar here, matching the standalone
// e049 pass's lack of full type inference. This closes the common
// unannotated-capture parity gap (`let s = "x"`) against native without
// threading the whole type environment into this pass. Returns a sentinel
// e049_is_ref classifies as ref; the concrete name is irrelevant (NameTy.ty
// is read only through e049_is_ref).
function e049_init_ref_ty(init: ast.Expr): string {
  match (init) {
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprArray(_) => {
      return "__e049_ref";
    },
    ast.ExprStructLit(_) => {
      return "__e049_ref";
    },
    ast.ExprTuple(_) => {
      return "__e049_ref";
    },
    _ => {
      return "";
    }
  }
  return "";
}

// e049_scope collects (name, type) for every `let` declared in stmts,
// descending into control blocks but NOT into lambda bodies — the
// function-level scope a directly-nested closure captures from. An
// unannotated var's type is inferred from an obvious pointer-shaped literal
// init (e049_init_ref_ty) so its write-back capture matches native.
function e049_scope(stmts: ast.Stmt[]): NameTy[] {
  let out: NameTy[] = [];
  for stmt in stmts {
    for vb in e049_value_blocks(stmt) {
      out = e049_append_nt(out, e049_scope(vb.body));
    }
    match (stmt) {
      ast.StmtVar(v) => {
        let vty: string = v.type_name;
        if (vty.len() == 0) {
          vty = e049_init_ref_ty(v.init);
        }
        out = out.append(NameTy { nm: v.name, ty: vty });
      },
      ast.StmtIf(f) => {
        out = e049_append_nt(out, e049_scope(f.then_body));
        out = e049_append_nt(out, e049_scope(f.else_body));
      },
      ast.StmtWhile(w) => {
        out = e049_append_nt(out, e049_scope(w.body));
      },
      ast.StmtFor(fr) => {
        out = e049_append_nt(out, e049_scope(fr.body));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = e049_append_nt(out, e049_scope(arm.body));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = e049_append_nt(out, e049_scope(one));
      },
      _ => {}
    }
  }
  return out;
}

// e049_value_blocks lists the value blocks — the zero-argument lambdas an `if`
// or `match` expression, a `{ … }` block or a comprehension desugars to — in a
// statement's own expressions. A value block is not a closure: its body runs in
// place, so its locals belong to the enclosing body and its assignments are
// that body's own. A value block nested in one is reached through its body.
function e049_value_blocks(st: ast.Stmt): ast.ExprLambda[] {
  let none: ast.ExprLambda[] = [];
  return astwalk.fold_stmt_own_pruned(st, none, e049_value_block_at, e049_into_no_lambda);
}

function e049_value_block_at(n: ast.Expr, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  if let ast.ExprLambda(lm) = n {
    if (parser.is_value_block_origin(lm.origin)) {
      return acc.append(lm);
    }
  }
  return acc;
}

function e049_into_no_lambda(n: ast.Expr): boolean {
  if let ast.ExprLambda(_) = n {
    return false;
  }
  return true;
}

// e049_lambda_locals_nt collects a lambda's own bound names WITH their types —
// params plus body `let` decls, not descending into nested lambdas. Typed
// because the set serves twice: as the shadowing set for assignments in this
// body, and, once the walk descends, as part of the ENCLOSING set for a lambda
// nested inside it, where e049_ref_capture reads the type to decide whether the
// capture is reference-shaped. Built the way e049_diags builds a function's.
function e049_lambda_locals_nt(lm: ast.ExprLambda): NameTy[] {
  let out: NameTy[] = [];
  for param in lm.params {
    out = out.append(NameTy { nm: param.name, ty: param.type_name });
  }
  return e049_append_nt(out, e049_scope(lm.body));
}

// e049_nt_names projects the name half of a NameTy set.
function e049_nt_names(nts: NameTy[]): string[] {
  let out: string[] = [];
  for elem in nts {
    out = out.append(elem.nm);
  }
  return out;
}

// e049_check_assigns flags assignments inside a lambda body whose target
// is a reference-typed enclosing capture not shadowed by a lambda local.
// Descends into control blocks but not nested lambdas (those are checked
// separately from the enclosing function's scope).
// e049_stmt_own_lambdas checks the lambdas sitting in a statement's OWN
// expressions — the `let g = () => { … }` inside another lambda's body.
// Nothing used to look there: e049_check_assigns walks statements for
// StmtAssign and descends into if/while/for/match/defer bodies, but a nested
// lambda arrives as a StmtVar INITIALISER and fell to its `_ => {}` arm, while
// e049_expr_lambdas prunes at the enclosing lambda. So `s = "y"` inside a
// lambda inside a lambda was accepted outright, where the Go checker reports it.
//
// One level, pruned at ExprLambda: e049_check_assigns walks the child blocks
// itself, and each lambda body is handed on with that lambda's own locals, so
// every lambda is reached exactly once however deep it nests. A lambda NESTED
// in this body captures this body's own names as well as what this body
// captured, so its enclosing set is both; a value block is this body's own and
// keeps the two sets as they are.
function e049_stmt_own_lambdas(st: ast.Stmt, enclosing: NameTy[], locals: NameTy[]): util.Diag[] {
  let nested_encl: NameTy[] = e049_append_nt(enclosing, locals);
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        if (parser.is_value_block_origin(lm.origin)) {
          return util.append_diags(acc, e049_check_assigns(lm.body, enclosing, locals));
        }
        return util.append_diags(acc, e049_check_assigns(lm.body, nested_encl, e049_lambda_locals_nt(lm)));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, not_into_lambda);
}

function e049_check_assigns(stmts: ast.Stmt[], enclosing: NameTy[], locals: NameTy[]): util.Diag[] {
  let out: util.Diag[] = [];
  let local_names: string[] = e049_nt_names(locals);
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(a) => {
        if (!util.has_str(local_names, a.target) && e049_ref_capture(enclosing, a.target)) {
          out = out.append(dg_at("E049", "cannot assign to captured " + e049_capture_label(enclosing, a.target) + "\"" + a.target + "\": a reference-typed closure capture is read-only (it could close a reference cycle); return the new value from the closure instead", a.target_line, a.target_col));
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, e049_check_assigns(f.then_body, enclosing, locals));
        out = util.append_diags(out, e049_check_assigns(f.else_body, enclosing, locals));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e049_check_assigns(w.body, enclosing, locals));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e049_check_assigns(fr.body, enclosing, locals));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, e049_check_assigns(arm.body, enclosing, locals));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e049_check_assigns(one, enclosing, locals));
      },
      _ => {}
    }
    out = util.append_diags(out, e049_stmt_own_lambdas(stmt, enclosing, locals));
  }
  return out;
}

// e049_expr_lambdas finds lambdas in an expression and checks each one's
// body for captured-reference assignments.
// e049_expr_lambdas collects the E049 diagnostics of every lambda reachable from
// an expression. It PRUNES at ExprLambda: the body goes to e049_check_assigns
// with that lambda's own locals, so letting astwalk descend into it as well
// would report each nested lambda once per enclosing one.
function e049_expr_lambdas(e: ast.Expr, enclosing: NameTy[]): util.Diag[] {
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        if (parser.is_value_block_origin(lm.origin)) {
          return util.append_diags(acc, e049_find(lm.body, enclosing));
        }
        return util.append_diags(acc, e049_check_assigns(lm.body, enclosing, e049_lambda_locals_nt(lm)));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_expr_pruned(e, no_diags(), at_lambda, not_into_lambda);
}

// e049_find walks a statement list for lambda-bearing expressions (var
// inits, returns, expr/assign values) and control blocks, checking each
// lambda against the function-level enclosing scope.
function e049_find(stmts: ast.Stmt[], enclosing: NameTy[]): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, e049_expr_lambdas(v.init, enclosing));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, e049_expr_lambdas(r.value, enclosing));
      },
      ast.StmtExpr(e) => {
        out = util.append_diags(out, e049_expr_lambdas(e.value, enclosing));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, e049_expr_lambdas(a.value, enclosing));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, e049_find(f.then_body, enclosing));
        out = util.append_diags(out, e049_find(f.else_body, enclosing));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e049_find(w.body, enclosing));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e049_find(fr.body, enclosing));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, e049_find(arm.body, enclosing));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e049_find(one, enclosing));
      },
      _ => {}
    }
  }
  return out;
}

pub function e049_diags(mod: parser.Module, env: ModuleEnv, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    let encl: NameTy[] = [];
    for param in fn.params {
      encl = encl.append(NameTy { nm: param.name, ty: param.type_name });
    }
    encl = e049_append_nt(encl, e049_scope(fn.body));
    out = util.append_diags(out, e049_find(fn.body, encl));
    out = util.append_diags(out, e049_cell_stores(fn, mod, env));
  }
  return out;
}

// e049_cell_stores is the enclosing-scope half of E049 (#8440), native's
// checkCaptureCycleStores. A `let` some closure captures is shared by
// reference through one cell, so storing into it from the enclosing scope a
// value that can reach a function can close cell -> closure -> env -> cell.
// Judged on the stored value's own type, as native judges it: a `Ci` stored
// into a captured `dyn Shape` reaches no function whatever the variable could
// hold. The variable's declared type stands in where the checker has no type
// for the value, and a closure literal that captures neither the target nor
// anything that could is exempt.
//
// A lambda body is a body of its own, whose locals another closure can capture,
// so each one is checked the same way.
function e049_cell_stores(fn: parser.FuncDecl, mod: parser.Module, env: ModuleEnv): util.Diag[] {
  let out: util.Diag[] = e049_body_stores(fn, mod, env);
  let lams: ast.ExprLambda[] = [];
  for st in fn.body {
    lams = astwalk.fold_stmt_nodes(st, lams, e049_no_stmt_lambdas, e049_lambda_at, e049_into_all);
  }
  for lm in lams {
    out = util.append_diags(out, e049_body_stores(parser.FuncDecl { ...fn, params: lm.params, ret_type: lm.ret_type, body: lm.body }, mod, env));
  }
  return out;
}

function e049_body_stores(fn: parser.FuncDecl, mod: parser.Module, env: ModuleEnv): util.Diag[] {
  let captured: string[] = [];
  for st in fn.body {
    captured = astwalk.fold_stmt_own_pruned(st, captured, e049_lambda_captures, e049_not_into_lambda);
  }
  for st in fn.body {
    captured = e049_nested_stmt_captures(st, captured);
  }
  if (captured.len() == 0) {
    return [];
  }
  let vars: NameTy[] = e049_lambda_var_types(fn.body, e049_scope(fn.body));
  let sc: Scope = build_func_scope(fn, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  return e049_store_walk(fn.body, sc, vars, captured, fn.type_params, mod, []);
}

function e049_lambda_at(n: ast.Expr, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  if let ast.ExprLambda(lm) = n {
    if (!parser.is_value_block_origin(lm.origin)) {
      return acc.append(lm);
    }
  }
  return acc;
}

function e049_no_stmt_lambdas(st: ast.Stmt, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  return acc;
}

function e049_into_all(n: ast.Expr): boolean {
  return true;
}

// e049_nested_stmt_captures reaches the lambdas in nested statement blocks,
// which fold_stmt_own_pruned leaves to the caller.
function e049_nested_stmt_captures(st: ast.Stmt, acc: string[]): string[] {
  let kids: ast.Stmt[] = [];
  match (st) {
    ast.StmtIf(f) => {
      kids = e049_cat_stmts(f.then_body, f.else_body);
    },
    ast.StmtWhile(w) => {
      kids = w.body;
    },
    ast.StmtFor(fr) => {
      kids = fr.body;
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        kids = e049_cat_stmts(kids, arm.body);
      }
    },
    ast.StmtDefer(d) => {
      kids = [d.action];
    },
    _ => {}
  }
  for k in kids {
    acc = astwalk.fold_stmt_own_pruned(k, acc, e049_lambda_captures, e049_not_into_lambda);
    acc = e049_nested_stmt_captures(k, acc);
  }
  return acc;
}

function e049_lambda_captures(n: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprLambda(lm) = n {
    if (!parser.is_value_block_origin(lm.origin)) {
      return astwalk.collect_lambda_idents(lm, acc);
    }
  }
  return acc;
}

function e049_not_into_lambda(n: ast.Expr): boolean {
  if let ast.ExprLambda(lm) = n {
    return parser.is_value_block_origin(lm.origin);
  }
  return true;
}

function e049_cat_stmts(a: ast.Stmt[], b: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = a;
  for st in b {
    out = out.append(st);
  }
  return out;
}

// e049_lambda_var_types gives an unannotated `let f = () => …` the function
// type its initialiser has, which e049_scope leaves empty.
function e049_lambda_var_types(stmts: ast.Stmt[], vars: NameTy[]): NameTy[] {
  let out: NameTy[] = [];
  let lambdas: string[] = [];
  let walked: boolean = false;
  for nt in vars {
    let ty: string = nt.ty;
    if (ty.len() == 0) {
      if (!walked) {
        lambdas = e049_lambda_init_names(stmts);
        walked = true;
      }
      if (util.has_str(lambdas, nt.nm)) {
        ty = "fn";
      }
    }
    out = out.append(NameTy { nm: nt.nm, ty: ty });
  }
  return out;
}

// e049_lambda_init_names lists the variables some `let` outside a lambda body
// initialises with a lambda, in one walk for every variable asked about.
function e049_lambda_init_names(stmts: ast.Stmt[]): string[] {
  function at_var(st: ast.Stmt, own acc: string[]): string[] {
    if let ast.StmtVar(v) = st {
      if let ast.ExprLambda(_) = v.init {
        return acc.append(v.name);
      }
    }
    return acc;
  }
  let out: string[] = [];
  for st in stmts {
    out = astwalk.fold_stmt_spine(st, out, at_var);
  }
  return out;
}

function e049_store_walk(stmts: ast.Stmt[], sc: Scope, vars: NameTy[], captured: string[], tparams: string[], mod: parser.Module, own out: util.Diag[]): util.Diag[] {
  for st in stmts {
    for vb in e049_value_blocks(st) {
      out = e049_store_walk(vb.body, sc, vars, captured, tparams, mod, out);
    }
    match (st) {
      ast.StmtAssign(a) => {
        let ty: string = e049_var_type(vars, a.target);
        let vty: string = e049_value_type(a.value, sc, ty);
        if (util.has_str(captured, a.target) && e049_is_ref(ty) && e049_type_reaches_fn(vty, tparams, mod, [])
          && !e049_lambda_cannot_reach(a.value, a.target, vars, tparams, mod)) {
          out = out.append(dg_at("E049", "cannot assign a value of type " + vty + " to captured \"" + a.target + "\": a captured variable is shared by reference, so storing a value that can reach a closure would close a reference cycle the runtime cannot collect; keep the closure in a variable it does not capture", a.target_line, a.target_col));
        }
      },
      ast.StmtIf(f) => {
        out = e049_store_walk(f.then_body, sc, vars, captured, tparams, mod, out);
        out = e049_store_walk(f.else_body, sc, vars, captured, tparams, mod, out);
      },
      ast.StmtWhile(w) => {
        out = e049_store_walk(w.body, sc, vars, captured, tparams, mod, out);
      },
      ast.StmtFor(fr) => {
        out = e049_store_walk(fr.body, sc, vars, captured, tparams, mod, out);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = e049_store_walk(arm.body, sc, vars, captured, tparams, mod, out);
        }
      },
      _ => {}
    }
    sc = bind_stmt(st, sc);
  }
  return out;
}

// e049_value_type spells the checked type of a stored value, or `declared`
// when the checker has none for it.
function e049_value_type(v: ast.Expr, sc: Scope, declared: string): string {
  let vt: typeinfo.Type = check_expr(v, sc);
  if (is_unknown(vt)) {
    return declared;
  }
  let sp: string = typeinfo.spelling(vt);
  if (sp.len() == 0) {
    return declared;
  }
  return sp;
}

function e049_var_type(vars: NameTy[], name: string): string {
  for nt in vars {
    if (nt.nm == name) {
      return nt.ty;
    }
  }
  return "";
}

// e049_lambda_cannot_reach: a closure literal's only outward edges are its
// captures, so it closes nothing when it captures neither the target nor a
// variable whose type could hold a closure.
function e049_lambda_cannot_reach(v: ast.Expr, target: string, vars: NameTy[], tparams: string[], mod: parser.Module): boolean {
  if let ast.ExprLambda(lm) = v {
    for name in astwalk.collect_lambda_idents(lm, []) {
      if (name == target) {
        return false;
      }
      let ty: string = e049_var_type(vars, name);
      if (e049_type_reaches_fn(ty, tparams, mod, [])) {
        return false;
      }
    }
    return true;
  }
  return false;
}

// e049_type_reaches_fn reports whether a value of the named type can hold a
// function value: a function type, `dyn`, a type parameter, or a struct,
// variant or generic argument that reaches one. Mirrors native's
// typeReachesFunc over the self-host's type-name strings.
function e049_type_reaches_fn(ty: string, tparams: string[], mod: parser.Module, seen: string[]): boolean {
  if (ty.len() == 0) {
    return false;
  }
  if (util.contains(ty, "=>")) {
    return true;
  }
  let start: i32 = 0 - 1;
  let i: i32 = 0;
  while (i <= ty.len()) {
    let word: boolean = i < ty.len() && lexer.is_alnum(ty[i] as i32);
    if (word && start < 0) {
      start = i;
    }
    if (!word && start >= 0) {
      let w: string = slice_unchecked(ty, start, i) + "";
      start = 0 - 1;
      if (w == "fn" || w == "dyn" || util.has_str(tparams, w)) {
        return true;
      }
      if (!util.has_str(seen, w)) {
        seen = seen.append(w);
        for sd in mod.structs {
          if (sd.name == w || sd.enum_owner == w) {
            for fld in sd.fields {
              if (fld.fn_ret.len() > 0 || e049_type_reaches_fn(fld.type_name, tparams, mod, seen)) {
                return true;
              }
            }
          }
        }
      }
    }
    i = i + 1;
  }
  return false;
}

// e064_unknown_bare reports whether `type_name` is a BARE NOMINAL identifier
// that names no declared type — the E064 case. It is deliberately conservative
// so it never false-positives on the self-host bundle (which would break the
// fixpoint):
//   - empty / inferred annotations and the `void` / `Self` pseudo-types the
//     name resolver doesn't model are skipped;
//   - only a plain identifier ([A-Za-z0-9_]) is considered. Any other shape —
//     an array (`X[]`), generic instantiation (`Box[i32]`), function type
//     (`() => i32`), tuple, `dyn Trait`, or dotted cross-module name — is
//     skipped, because its surface text may legitimately mention an erased
//     generic parameter, a builtin, or syntax the simple resolver doesn't
//     model. Callers further restrict this to NON-generic declarations.
function e064_unknown_bare(type_name: string, tn: TypeNames): boolean {
  if (type_name.len() == 0) {
    return false;
  }
  if (type_name == "void" || type_name == "Self") {
    return false;
  }
  // Builtin type keywords the simple name resolver
  // (`type_from_name_with_names_and_unions`) doesn't enumerate — it only
  // knows i32/i64/u32/u64 among integers. u8/usize: the parser accepts
  // them (parser.go parseType), the Go checker treats them as real types,
  // and the stdlib uses them pervasively (`let b: u8` in std/string,
  // `let p: usize` scratch pointers in core/int), so flagging them would
  // diverge from the oracle on every program importing those modules.
  // `str` (the borrowed-string view, #4813): a real native type.
  // `char` (the Unicode scalar, #5629): a real native type since slice 1,
  // and std/utf8 now returns `char[]` / `Option[char]`, so every program
  // importing std/string reaches it. It used to be listed below as
  // intentionally-absent, which was correct only while it did not exist.
  // byte/isize/i8/i16/u16 remain intentionally absent: not valid types, so
  // the Go checker rejects them and the self-host must keep flagging.
  if (type_name == "u8" || type_name == "usize" || type_name == "str" || type_name == "char") {
    return false;
  }
  // The parser coarses some shapes to "tuple", which is no user nominal.
  if (type_name == "tuple") {
    return false;
  }
  // A coarsened function type reaches here only as a written `fn`, since
  // e064_decl_spelling sets a declared callable aside. `fn` names no type,
  // though the resolver reads the bare tag as the opaque callable.
  if (type_name == "fn") {
    return true;
  }
  // The front end's built-in structs and enums are registered types natively
  // (checker.go's builtinStructDecls / builtinEnumDecls), so naming one is not
  // an unknown type. Reader / Writer / MapIter reach here even on a module
  // carrying the injected decls: they are opaque handles whose methods the
  // checker resolves as builtins, so declaring them would turn every
  // `r.read_chunk(n)` into a field read (E043).
  if (parser.is_reserved_struct_name(type_name) || parser.is_reserved_enum_name(type_name)) {
    return false;
  }
  if (!plain_ident(type_name) || parser.looks_type_var(type_name)) {
    return false;
  }
  return is_unknown(type_from_spelling(type_name, tn));
}

// declared_struct_names is the struct names a type annotation may spell: every
// struct but an enum variant's, unless a struct of its own shares the name.
function declared_struct_names(structs: parser.StructDecl[]): string[] {
  let out: string[] = [];
  for sd in structs {
    if (sd.enum_owner.len() == 0) {
      out = out.append(sd.name);
    }
  }
  return out;
}

// plain_ident reports whether `name` is one identifier: letters, digits and
// underscores only, so no array suffix, generic argument, dot or arrow.
function plain_ident(name: string): boolean {
  for byte in name {
    let ch: i32 = byte as i32;
    let alpha: boolean = ch >= 65 && ch <= 90 || ch >= 97 && ch <= 122;
    let digit: boolean = ch >= 48 && ch <= 57;
    if (!alpha && !digit && ch != 95) {
      return false;
    }
  }
  return name.len() > 0;
}

// e064_unknown_name is the recursive form of the E064 check (#4363 item 3): it
// returns the FIRST unknown bare nominal name reachable through `type_name`'s
// array-element and generic-argument structure, or "" when none is unknown. The
// Go checker reports E064 for `Nope[]` (array element) and `Map[string, Nope]`
// (generic arg) exactly as for a bare `Nope`, naming the inner "Nope";
// e064_unknown_bare deliberately bailed on any non-identifier text, so those
// inner positions went unflagged. Returning the inner NAME (not the outer
// spelling) keeps the emitted message byte-matching native's `unknown type
// "Nope"`.
//
// Decomposition (via parser.parse_type_ref, the single type-spelling scanner):
//   - an array `E[]` reduces to its element E (so `E[][]` and `G[a][]` reduce
//     correctly);
//   - a generic instantiation `G[a, b]` checks each ARGUMENT — never the base
//     G, because a builtin generic container (Map / Cell / Option / Result / a
//     user generic struct) is not in struct_names and would false-positive;
//   - a tuple is skipped (out of item-3 scope, and the simple resolver doesn't
//     model tuple element text);
//   - a bare leaf falls through to the same conservative e064_unknown_bare.
// The callers restrict this to NON-generic, NON-method decls, so an inner bare
// name is never an erased type parameter — a genuine typo, matching the oracle.
// e064_unknown_name is the undeclared name `type_name` spells, or "".
// `extra_known` names the traits and resources the struct / union name sets
// leave out, which only a generic's base may spell; `tparams` the type
// parameters in scope, which a bare name may be.
function e064_unknown_name(type_name: string, tn: TypeNames, extra_known: string[], tparams: string[]): string {
  return e064_unknown_name_tref(parser.parse_type_ref(type_name), tn, extra_known, tparams);
}

// E064 reads the written callable shape, including its parameters and result,
// rather than the parser's coarse tag. A tag with no sidecars was written fn.
function e064_decl_spelling(type_name: string, fn_ret: string, fn_params: string): string {
  return parser.fn_tag_spelling(type_name, fn_ret, fn_params);
}

function e064_unknown_name_tref(tr: parser.TypeRef, tn: TypeNames, extra_known: string[], tparams: string[]): string {
  // Array `E[]` → element E (peel one level, keeping the base/args).
  if (tr.array_depth > 0) {
    let elem: parser.TypeRef = parser.elem_type_ref(tr);
    return e064_unknown_name_tref(elem, tn, extra_known, tparams);
  }
  if (tr.is_view) {
    return e064_unknown_name_tref(tr.args[0], tn, extra_known, tparams);
  }
  // Callable and tuple components are declared types too. Never treat the
  // internal function constructor as a user-written `fn` nominal.
  if (tr.is_tuple || parser.ref_is_fn_value(tr)) {
    return e064_component_unknown(parser.ref_ungroup(tr).args, tn, extra_known, tparams);
  }
  // Generic instantiation `G[a, b]`: check the BASE, then each arg. The
  // Go checker's checkTypeKnown flags an undeclared generic base
  // (`Statuus[i32]` → E064 "Statuus") exactly like a bare unknown name —
  // knownTypeName accepts any declared struct / enum / trait / resource.
  // The reserved builtin structs (Map / Cell / MapIter / …) and enums
  // (Option / Result / …) are registered types natively, so they are
  // allowlisted here; declared traits and resources arrive via extra_known
  // (they aren't in the struct/union name sets this resolver models).
  if (tr.args.len() > 0) {
    if (!parser.is_reserved_struct_name(tr.base) && !parser.is_reserved_enum_name(tr.base)) {
      let kx: boolean = false;
      for elem in extra_known {
        if (elem == tr.base) {
          kx = true;
        }
      }
      if (!kx && e064_unknown_bare(tr.base, tn)) {
        return tr.base;
      }
    }
    return e064_component_unknown(tr.args, tn, extra_known, tparams);
  }
  // Bare leaf: a type parameter in scope, else the original conservative
  // identifier check names the type.
  if (util.has_str(tparams, tr.base)) {
    return "";
  }
  if (e064_unknown_bare(tr.base, tn)) {
    return tr.base;
  }
  return "";
}

function e064_component_unknown(args: parser.TypeRef[], tn: TypeNames, extra_known: string[], tparams: string[]): string {
  for arg in args {
    let u: string = e064_unknown_name_tref(parser.ref_without_own(arg), tn, extra_known, tparams);
    if (u.len() > 0) {
      return u;
    }
  }
  return "";
}

// Annot is one type a declaration ANNOTATES, with where to report against it:
// a `let`'s type, a lambda's parameter / return type, or a struct literal's
// written type argument.
struct Annot { type_name: string, line: i32, col: i32 }

// collect_annots gathers every annotation in a body, wherever it nests —
// including inside a lambda, which the hand-rolled statement recursion this
// replaced could not reach at all, so neither E064 nor E057 ever fired on
// `((x: Wibble) => 1)` while both fired on the `let x: Wibble` beside it
// (#7100). Native reaches them through one shared node set for the same reason
// (forEachDeclaredType, #7099); here the shared spine is astwalk, so a parser
// node added later is covered the moment fold_stmt_nodes covers it.
//
// A lambda the PARSER synthesised carries no position (ExprLambda.line is 0)
// and no annotation the programmer wrote — its `ret_type` is if_expr_rt's guess
// — so it contributes nothing.
function collect_annots(stmts: ast.Stmt[]): Annot[] {
  let acc: Annot[] = [];
  for stmt in stmts {
    acc = astwalk.fold_stmt_nodes(stmt, acc, annot_of_stmt, annot_of_expr, astwalk.descend_all);
  }
  return acc;
}

function annot_of_stmt(st: ast.Stmt, own acc: Annot[]): Annot[] {
  match (st) {
    ast.StmtVar(v) => {
      return acc.append(Annot { type_name: e064_decl_spelling(v.type_name, v.fn_ret, v.fn_param_types), line: v.line, col: v.col });
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

// lambda_annots collects only the expression annotations a body holds: a
// lambda's parameter / return types and a struct literal's written arguments. collect_annots gathers the statement `let` annotations too, and
// those are reported by stmts_assign_diags, which is where the init is in
// scope — it decides whether a map literal has a key of its own to report at.
function lambda_annots(stmts: ast.Stmt[]): Annot[] {
  let acc: Annot[] = [];
  for stmt in stmts {
    acc = astwalk.fold_stmt_nodes(stmt, acc, annot_keep_acc, annot_of_expr, astwalk.descend_all);
  }
  return acc;
}

function annot_keep_acc(st: ast.Stmt, own acc: Annot[]): Annot[] {
  return acc;
}

function annot_of_expr(e: ast.Expr, own acc: Annot[]): Annot[] {
  match (e) {
    ast.ExprLambda(lm) => {
      if (lm.line == 0) {
        return acc;
      }
      for param in lm.params {
        acc = acc.append(Annot { type_name: e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), line: lm.line, col: lm.col });
      }
      return acc.append(Annot { type_name: e064_decl_spelling(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types), line: lm.line, col: lm.col });
    },
    ast.ExprStructLit(sl) => {
      // A literal's written type arguments, `Box[Zzz] { … }`, as native
      // walks them; the instantiation's own arity is call_diags_struct_lit's E040.
      if (sl.written.len() > 0) {
        for a in parser.parse_type_ref(sl.written).args {
          acc = acc.append(Annot { type_name: parser.render_type_ref(a), line: sl.line, col: sl.col });
        }
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

// unknown_type_hint suggests the right spelling for the handful of
// cross-language slips native's checker names, appended to the E064 message.
// The hint text is inside the differential, so the two must agree verbatim.
function unknown_type_hint(name: string, traits: string[]): string {
  if (util.has_str(traits, name)) {
    return " (`" + util.demangle(name) + "` is a trait: a parameter of trait type makes the function generic over it; anywhere else write `dyn " + util.demangle(name) + "`)";
  }
  if (name == "bool") {
    return " (did you mean `boolean`?)";
  }
  if (name == "int" || name == "long") {
    return " (did you mean `i32`?)";
  }
  if (name == "uint") {
    return " (did you mean `u32`?)";
  }
  if (name == "double") {
    return " (did you mean `f64`?)";
  }
  if (name == "String") {
    return " (did you mean `string`?)";
  }
  return "";
}

// e064_annot_diags reports E064 for any annotation whose bare nominal type is
// undefined. The caller restricts this to functions with no type parameters, so
// a plain identifier that resolves to unknown is a genuine typo, never an
// erased generic parameter.
// e064_fn_tparams is every type parameter in scope in `fd`'s signature and
// body annotations.
function e064_fn_tparams(fd: parser.FuncDecl): string[] {
  let out: string[] = fd.all_type_params;
  for tp in func_scope_tparams(fd) {
    if (!util.has_str(out, tp)) {
      out = out.append(tp);
    }
  }
  return out;
}

// handle_type_diags is native's validateResourceHandles: an E021 for each
// `own T` / `borrow T` whose T is not a declared resource, across every
// signature, body annotation and struct field.
function handle_type_diags(mod: parser.Module, focus: util.NameIndex, tn: TypeNames): util.Diag[] {
  let out: util.Diag[] = [];
  for fd in mod.funcs {
    if (in_focus(focus, fd)) {
      for param in fd.params {
        out = util.append_diags(out, handle_misuse_diags(e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), tn, fd.line, fd.col));
      }
      out = util.append_diags(out, handle_misuse_diags(e064_decl_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types), tn, fd.line, fd.col));
      for an in collect_annots(fd.body) {
        out = util.append_diags(out, handle_misuse_diags(an.type_name, tn, an.line, an.col));
      }
    }
  }
  for sd in mod.structs {
    let (line, col) = struct_decl_pos(mod, sd);
    for field in sd.fields {
      out = util.append_diags(out, handle_misuse_diags(e064_decl_spelling(field.type_name, field.fn_ret, field.fn_param_types), tn, line, col));
    }
  }
  return out;
}

// struct_decl_pos is where a struct is declared; an enum variant's payload
// struct has no position of its own, so it reports at its enum.
function struct_decl_pos(mod: parser.Module, sd: parser.StructDecl): (i32, i32) {
  if (sd.enum_owner.len() > 0) {
    for ed in mod.enums {
      if (ed.name == sd.enum_owner) {
        return (ed.line, ed.col);
      }
    }
  }
  return (sd.line, sd.col);
}

function handle_misuse_diags(type_name: string, tn: TypeNames, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  for leaf in handle_leaves(parser.parse_type_ref(type_name), []) {
    if (!names_resource_handle(leaf, tn)) {
      out = out.append(dg_at("E021", handle_not_resource_message(leaf), line, col));
    }
  }
  return out;
}

// handle_leaves collects every `own R` / `borrow R` spelling nested in `tr`.
function handle_leaves(tr: parser.TypeRef, own acc: string[]): string[] {
  if (tr.array_depth > 0) {
    return handle_leaves(parser.elem_type_ref(tr), acc);
  }
  if (tr.args.len() == 0 && handle_resource(tr.base) != tr.base) {
    return acc.append(tr.base);
  }
  // A function type's parameters precede its result in `args`.
  let slots: i32 = 0;
  if (tr.is_fn) {
    slots = tr.args.len() - 1;
  }
  let i: i32 = 0;
  while (i < tr.args.len()) {
    if (i < slots) {
      acc = handle_leaves(without_slot_marker(tr.args[i]), acc);
    } else {
      acc = handle_leaves(tr.args[i], acc);
    }
    i = i + 1;
  }
  return acc;
}

// without_slot_marker drops the `own` that marks a function type's parameter
// slot consuming, `(own T) => U`, which is not a handle.
function without_slot_marker(slot: parser.TypeRef): parser.TypeRef {
  if (util.str_has_prefix(slot.base, "own ")) {
    return parser.TypeRef { ...slot, base: slice_unchecked(slot.base, 4, slot.base.len()) + "" };
  }
  return slot;
}

function handle_not_resource_message(leaf: string): string {
  let name: string = util.demangle(handle_resource(leaf));
  if (util.str_has_prefix(leaf, "borrow ")) {
    return "`" + name + "` is not a resource, so `borrow " + name + "` is not a handle type; a parameter borrows by default, written `name: " + name + "`";
  }
  return "`" + name + "` is not a resource, so `own " + name + "` is not a handle type; a consuming parameter is written `own name: " + name + "`";
}

function e064_annot_diags(an: Annot[], tn: TypeNames, extra_known: string[], tparams: string[], traits: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  for elem in an {
    let vu: string = e064_unknown_name(elem.type_name, tn, extra_known, tparams);
    if (vu.len() > 0) {
      out = out.append(dg_at("E064", "cannot find type \"" + util.demangle(vu) + "\" in this scope" + unknown_type_hint(vu, traits), elem.line, elem.col));
    }
  }
  return out;
}

// cell_payload_risk returns "" when a value of `t` can never reach a Cell,
// else the spelling of the first part of `t` that could: a Cell, a function
// value (through its captures), a trait object (through what it erases), a
// map cursor or resource handle, a borrowed view (which a cell would
// outlive), or a type parameter, which could be instantiated with any of
// those. Everything else is immutable data — scalars, strings, arrays,
// tuples, maps, structs, enums — whose values form trees, so a cell can never
// end up inside its own payload and RC needs no cycle collector
// (docs/CELL-TYPE-PLAN.md §2). A recursive type is fine for the same reason:
// `seen` stops the walk at a nominal type already on it. `own` is the type
// parameters of the declaration whose fields are being walked, which its
// arguments stand for and were checked as.
function cell_payload_risk(t: typeinfo.Type, s: Scope, own: string[], seen: string[]): string {
  match (t) {
    typeinfo.TypeString(st) => {
      if (st.tag == 1) {
        return type_label(t);
      }
    },
    typeinfo.TypeArray(a) => {
      if (a.view) {
        return type_label(t);
      }
      return cell_payload_risk(a.elem, s, own, seen);
    },
    typeinfo.TypeTuple(tt) => {
      return cell_payload_risks(tt.elements, s, own, seen);
    },
    typeinfo.TypeMap(m) => {
      return cell_payload_risks([m.key, m.value], s, own, seen);
    },
    typeinfo.TypeStruct(st) => {
      if (st.name == "Cell" || st.name == "MapIter") {
        return type_label(t);
      }
      let ar: string = cell_payload_risks(st.args, s, own, seen);
      if (ar.len() > 0 || util.has_str(seen, st.name)) {
        return ar;
      }
      let sig: StructSig = s.lookup_struct(st.name);
      return cell_payload_risks(sig.field_types, s, sig.type_params, seen.append(st.name));
    },
    typeinfo.TypeUnion(u) => {
      let ar: string = cell_payload_risks(u.args, s, own, seen);
      let at: i32 = s.unions.index.find(u.name);
      if (ar.len() > 0 || at < 0 || util.has_str(seen, u.name)) {
        return ar;
      }
      return union_payload_risk(s.unions.unions[at], s, seen.append(u.name));
    },
    typeinfo.TypeUnknown(u) => {
      let n: i32 = TPARAM_MARK.len();
      if (u.reason.len() > n && slice_unchecked(u.reason, 0, n) == TPARAM_MARK) {
        let tp: string = slice_unchecked(u.reason, n, u.reason.len()) + "";
        if (!util.has_str(own, tp)) {
          return tp;
        }
      }
    },
    typeinfo.TypeErased(e) => {
      if (!util.has_str(own, e.name)) {
        return type_label(t);
      }
    },
    typeinfo.TypeFunc(_) => {
      return type_label(t);
    },
    typeinfo.TypeDyn(_) => {
      return type_label(t);
    },
    typeinfo.TypeHandle(_) => {
      return type_label(t);
    },
    _ => {}
  }
  return "";
}

function cell_payload_risks(ts: typeinfo.Type[], s: Scope, own: string[], seen: string[]): string {
  for t in ts {
    let r: string = cell_payload_risk(t, s, own, seen);
    if (r.len() > 0) {
      return r;
    }
  }
  return "";
}

// union_payload_risk walks every variant: an enum's variant is the struct
// carrying its payload, an alias's is a type it names.
function union_payload_risk(u: UnionSig, s: Scope, seen: string[]): string {
  for v in u.variants {
    let r: string = "";
    if (u.is_enum) {
      r = cell_payload_risks(s.lookup_owned_struct(v, u.name).field_types, s, u.type_params, seen);
    } else {
      r = cell_payload_risk(type_from_spelling(v, s.type_names()), s, u.type_params, seen);
    }
    if (r.len() > 0) {
      return r;
    }
  }
  return "";
}

// e057_diag is E057 at (line, col) for a `Cell[label]` whose element `elem`
// is not cycle-free, else nothing. Matches native's cellElemError.
function e057_diag(label: string, elem: typeinfo.Type, s: Scope, line: i32, col: i32): util.Diag[] {
  let risk: string = cell_payload_risk(elem, s, [], []);
  if (risk.len() == 0) {
    return [];
  }
  let why: string = ", and " + label + " contains " + risk;
  if (risk == type_label(named_tparams(elem))) {
    why = ", which " + label + " is not";
  }
  return [dg_at("E057", "Cell[" + label + "] is not allowed: a cell's element must be built from scalars, strings, arrays, tuples, maps, structs and enums" + why, line, col)];
}

// named_tparams replaces each erased type parameter in `t` by a nominal of its
// name, so type_label spells it as written rather than as `unknown`.
function named_tparams(t: typeinfo.Type): typeinfo.Type {
  match (t) {
    typeinfo.TypeUnknown(u) => {
      let n: i32 = TPARAM_MARK.len();
      if (u.reason.len() > n && slice_unchecked(u.reason, 0, n) == TPARAM_MARK) {
        return t_struct(slice_unchecked(u.reason, n, u.reason.len()) + "");
      }
    },
    typeinfo.TypeArray(a) => {
      return typeinfo.TypeArray { elem: named_tparams(a.elem), view: a.view };
    },
    typeinfo.TypeTuple(tt) => {
      return t_tuple(named_tparams_all(tt.elements));
    },
    typeinfo.TypeMap(m) => {
      return t_map(named_tparams(m.key), named_tparams(m.value));
    },
    typeinfo.TypeStruct(st) => {
      return t_struct_g(st.name, named_tparams_all(st.args));
    },
    typeinfo.TypeUnion(u) => {
      return t_union_g(u.name, named_tparams_all(u.args));
    },
    _ => {}
  }
  return t;
}

function named_tparams_all(ts: typeinfo.Type[]): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for t in ts {
    out = out.append(named_tparams(t));
  }
  return out;
}

// e057_annot_diags_tref walks a parsed annotation and reports every `Cell[X]`
// whose element is not cycle-free — the ANNOTATION form of E057 (#4363 item
// 2). Mirrors native resolveType's recursion into generic arguments and tuple
// elements, so a Cell nested anywhere in the spelling (`Option[Cell[P]]`,
// `(i32, Cell[P])`, `Cell[P][]`) fires. `tparams` are the type parameters in
// scope, which the element is resolved with.
function e057_annot_diags_tref(tr: parser.TypeRef, tparams: string[], s: Scope, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  if (!tr.is_tuple && tr.base == "Cell" && tr.args.len() == 1) {
    let elem: typeinfo.Type = type_from_ref_subst(tr.args[0], tparams, erased_tparams(tparams), s.type_names());
    out = util.append_diags(out, e057_diag(parser.render_type_ref(tr.args[0]), elem, s, line, col));
  }
  for arg in tr.args {
    out = util.append_diags(out, e057_annot_diags_tref(arg, tparams, s, line, col));
  }
  return out;
}

// e057_annot_diags parses one annotation spelling and emits E057 at the
// caller-supplied anchor for each offending `Cell[X]` in it.
function e057_annot_diags(type_name: string, tparams: string[], s: Scope, line: i32, col: i32): util.Diag[] {
  if (type_name.len() == 0) {
    return [];
  }
  return e057_annot_diags_tref(parser.parse_type_ref(type_name), tparams, s, line, col);
}

// e057_struct_diags reports the annotation-form E057 for a struct's fields,
// or for a variant's payloads, which carry their enum's type parameters and
// position.
function e057_struct_diags(sd: parser.StructDecl, enums: parser.EnumDecl[], s: Scope): util.Diag[] {
  let tps: string[] = sd.type_params;
  let line: i32 = sd.line;
  let col: i32 = sd.col;
  for ed in enums {
    if (sd.enum_owner.len() > 0 && ed.name == sd.enum_owner) {
      tps = ed.type_params;
      line = ed.line;
      col = ed.col;
    }
  }
  let out: util.Diag[] = [];
  for field in sd.fields {
    out = util.append_diags(out, e057_annot_diags(field.type_name, tps, s, line, col));
  }
  return out;
}

// e057_fn_diags reports the annotation-form E057 for a function's
// parameters, result and every annotation in its body.
function e057_fn_diags(fd: parser.FuncDecl, s: Scope): util.Diag[] {
  let tps: string[] = e064_fn_tparams(fd);
  let out: util.Diag[] = [];
  for param in fd.params {
    out = util.append_diags(out, e057_annot_diags(param.type_name, tps, s, fd.line, fd.col));
  }
  out = util.append_diags(out, e057_annot_diags(fd.ret_type, tps, s, fd.line, fd.col));
  for elem in collect_annots(fd.body) {
    out = util.append_diags(out, e057_annot_diags(elem.type_name, tps, s, elem.line, elem.col));
  }
  return out;
}

// E044Walk is what every step of the capture walk needs and none of it
// changes: the declared free functions returning `void`. It is a record
// rather than a parameter because the walk recurses through EXPRESSIONS as
// well as statements, and the expression side has twenty-five recursive call
// sites.
struct E044Walk { void_fns: string[] }

// e044_diags ports the Go checker's capture-eligibility rule (E044): a
// closure may capture scalars and pointer-shaped values, but NOT a value
// with no runtime representation — natively ast.VoidType, a `void` call
// result bound to a var, the one shape the native captureSink rejects
// (checker.go E044). The self-host type model erases it to `unknown`, so
// the suspects are identified SYNTACTICALLY and the rule stays deliberately
// narrow (it must never false-positive on the bundle): a body
// `let x = f();` whose callee is a declared free function with an explicit
// `void` return type. A lambda that CAPTURES a suspect draws E044 at the
// enclosing statement, labelled "void" like native.
// is_written_lambda_origin decides which lambdas this reaches: a bare one, a
// desugared local `function`, a `use` callback. Nested blocks re-walk with a
// copy of the suspect set so block-scoped vars don't leak.
function e044_lambda_check(lam: ast.ExprLambda, line: i32, col: i32, wk: E044Walk, suspects: string[], labels: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  // Captured, not mentioned: a suspect whose only appearance is a nested
  // binder's own name is not a capture, and every coded diagnostic is a build
  // gate, so a syntactic mention test here REJECTS programs native accepts.
  let free: string[] = astwalk.collect_lambda_idents(lam, []);
  let i: i32 = 0;
  while (i < suspects.len()) {
    if (util.has_str(free, suspects[i])) {
      out = out.append(dg_at("E044", "captured variable \"" + suspects[i] + "\" has unsupported type " + labels[i], line, col));
    }
    i = i + 1;
  }
  return out;
}

function e044_expr(e: ast.Expr, line: i32, col: i32, wk: E044Walk, suspects: string[], labels: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprLambda(lm) => {
      // Only a lambda the PROGRAMMER wrote is a capture site. The IIFEs this
      // parser synthesises — an if- / match-expression, a value block, a
      // comprehension — have no counterpart in the native AST, so native
      // draws nothing against them: `return if (c) { a } else { b };` inside
      // `pick[T](…, a: T, b: T)` reported E044 for both arms against a
      // program native accepts (#8461). Skipped rather than descended,
      // keeping the rule's deliberate narrowness: a written lambda nested
      // inside a synthesised one is under-reported, never false-reported.
      //
      // Report, then descend with a scope of the lambda's OWN. The report
      // covers every outer suspect this lambda captures, at any depth, because
      // collect_lambda_idents folds in a nested lambda's free names — so
      // descending with the outer set would report the same capture twice.
      // Descending with an EMPTY one reports neither twice nor not at all: a
      // suspect declared inside the body is found by the statement walk as it
      // goes, and a parameter of the lambda shadows an outer name of the same
      // spelling by simply not being in the set (#9777).
      if (parser.is_written_lambda_origin(lm.origin)) {
        out = util.append_diags(out, e044_lambda_check(lm, line, col, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(lm.body, wk, [], []));
      }
    },
    ast.ExprBinary(b) => {
      out = util.append_diags(out, e044_expr(b.left, line, col, wk, suspects, labels));
      out = util.append_diags(out, e044_expr(b.right, line, col, wk, suspects, labels));
    },
    ast.ExprUnary(u) => {
      out = util.append_diags(out, e044_expr(u.operand, line, col, wk, suspects, labels));
    },
    ast.ExprCall(c) => {
      out = util.append_diags(out, e044_expr(c.callee, line, col, wk, suspects, labels));
      for arg in c.args {
        out = util.append_diags(out, e044_expr(arg, line, col, wk, suspects, labels));
      }
    },
    ast.ExprArray(a) => {
      for element in a.elements {
        out = util.append_diags(out, e044_expr(element, line, col, wk, suspects, labels));
      }
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, e044_expr(element, line, col, wk, suspects, labels));
      }
    },
    ast.ExprIndex(ix) => {
      out = util.append_diags(out, e044_expr(ix.array, line, col, wk, suspects, labels));
      out = util.append_diags(out, e044_expr(ix.index, line, col, wk, suspects, labels));
    },
    ast.ExprSlice(sl) => {
      out = util.append_diags(out, e044_expr(sl.array, line, col, wk, suspects, labels));
      out = util.append_diags(out, e044_expr(sl.start, line, col, wk, suspects, labels));
      out = util.append_diags(out, e044_expr(sl.end, line, col, wk, suspects, labels));
    },
    ast.ExprFieldAccess(fa) => {
      out = util.append_diags(out, e044_expr(fa.obj, line, col, wk, suspects, labels));
    },
    ast.ExprStructLit(s) => {
      if (s.has_base) {
        out = util.append_diags(out, e044_expr(s.base, line, col, wk, suspects, labels));
      }
      for field_value in s.field_values {
        out = util.append_diags(out, e044_expr(field_value, line, col, wk, suspects, labels));
      }
    },
    _ => {}
  }
  return out;
}

function e044_stmts(stmts: ast.Stmt[], wk: E044Walk, suspects0: string[], labels0: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  let suspects: string[] = suspects0;
  let labels: string[] = labels0;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, e044_expr(v.init, v.line, v.col, wk, suspects, labels));
        // A `let x = f();` binding of a void call is a void suspect.
        let is_void_init: boolean = false;
        match (v.init) {
          ast.ExprCall(c) => {
            match (c.callee) {
              ast.ExprIdent(id) => {
                for void_fn in wk.void_fns {
                  if (void_fn == id.name) {
                    is_void_init = true;
                  }
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
        if (is_void_init && v.type_name.len() == 0) {
          suspects = suspects.append(v.name);
          labels = labels.append("void");
        }
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, e044_expr(r.value, r.line, r.col, wk, suspects, labels));
      },
      ast.StmtExpr(e) => {
        out = util.append_diags(out, e044_expr(e.value, 0, 0, wk, suspects, labels));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, e044_expr(a.value, a.line, a.col, wk, suspects, labels));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, e044_expr(f.cond, 0, 0, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(f.then_body, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(f.else_body, wk, suspects, labels));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e044_expr(w.cond, 0, 0, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(w.body, wk, suspects, labels));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e044_expr(fr.iter, 0, 0, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(fr.body, wk, suspects, labels));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, e044_expr(m.scrutinee, m.line, m.col, wk, suspects, labels));
        for arm in m.arms {
          out = util.append_diags(out, e044_stmts(arm.body, wk, suspects, labels));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e044_stmts(one, wk, suspects, labels));
      },
      _ => {}
    }
  }
  return out;
}

function e044_diags(efn: parser.FuncDecl, void_fns: string[]): util.Diag[] {
  return e044_stmts(efn.body, E044Walk { void_fns: void_fns }, [], []);
}

// ---- E053: `fip` fully-in-place verification -------------------------------
// Port of the native checkFipFunctions (checker.go): a `fip function` carries
// a CHECKED no-heap-allocation guarantee, verified as a sound conservative
// subset. Default-deny: anything not proven heap-neutral is rejected.
// Allowed: scalars, arithmetic/comparison/logic, field & index reads, control
// flow, (re)binding locals, `recv.with(i, v)` / index writes rooted at an
// `own` array parameter (the COW unique-in-place branch), `recv.map(f)` rooted
// at one (the in-place map, R7 of docs/REUSE-CONTRACT.md, which E068 verifies),
// calls to other `fip` functions and the whitelisted non-allocating builtin
// method (`len`).
// Rejected: array / tuple / struct literals, payload-carrying enum variant
// construction, string concatenation (incl. the f-string `+`-chain desugar),
// calls to non-`fip` functions, any other method call, indirect calls, and
// index/field writes not rooted at an `own` parameter.
//
// `fbip function` (the reuse-paired tier) runs the SAME walk with one
// relaxation: constructor expressions — struct / tuple literals and payload-
// carrying enum variants — are allowed, because irfipverify.fern's E068 checks
// each such site is reuse-paired or inside the graded allowance. A graded
// `fip(n)` / `fbip(n)` takes the same relaxation. Array literals stay rejected
// for both (no array reuse pairing exists), as do string concat, CoW-copy
// writes, and unproven calls. Call rule: `fip` may only call `fip`; `fbip` may
// call either.
function e053_root_len(target: string): i32 {
  // `xs[0]` / `p.f` → byte length of the base identifier being written
  // through, or -1 for a bare local rebind (no `[` / `.`), which
  // allocates nothing. Index-based (no slicing) so this stays free of
  // the str-view producer surface.
  let i: i32 = 0;
  while (i < target.len()) {
    let ch: i32 = target[i] as i32;
    if (ch == 91 || ch == 46) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function e053_root_is_own(target: string, rl: i32, own: string[]): boolean {
  for elem in own {
    if (elem.len() == rl) {
      let eq: boolean = true;
      let k: i32 = 0;
      while (k < rl) {
        if (elem[k] != target[k]) {
          eq = false;
        }
        k = k + 1;
      }
      if (eq) {
        return true;
      }
    }
  }
  return false;
}

function e053_stringish(e: ast.Expr, cur: Scope): boolean {
  match (e) {
    ast.ExprString(_) => {
      return true;
    },
    _ => {}
  }
  match (check_expr(e, cur)) {
    typeinfo.TypeString(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

// E053Ctx is the per-function context the walk carries. Constructor
// expressions are admitted in EVERY tier, `fip` included (#9602): the checker
// cannot tell a rebuild that reuses a dead donor's box from one that allocates
// a fresh box, so irfipverify's E068 owns the verdict — each emitted site must
// be reuse-paired or inside the allowance, which for a bare `fip` is zero.
struct E053Ctx { fname: string, kw: string, callable: string[], variants: string[], own: string[] }

// fip_recv_root names the variable a `.with` receiver is rooted at, or "" when
// the expression is not rooted at one. It is native's fipRootIdent: an index or
// a field access reaches the container it reads, and an earlier `.with` link
// reaches its own receiver, since the chain writes one array in place (#9702).
function fip_recv_root(e: ast.Expr): string {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    ast.ExprIndex(ix) => {
      return fip_recv_root(ix.array);
    },
    ast.ExprFieldAccess(fa) => {
      return fip_recv_root(fa.obj);
    },
    ast.ExprCall(c) => {
      if let ast.ExprFieldAccess(link) = c.callee {
        if (link.field == "with") {
          return fip_recv_root(link.obj);
        }
      }
      return "";
    },
    _ => {
      return "";
    }
  }
  return "";
}

// fip_link_reads_root is native's fipLinkReadsRoot: a `.with` link whose
// receiver is an earlier `.with` link and whose own arguments read the chain's
// root runs after that link's write, so the root copies and the chain
// allocates (#9702).
// An own-rooted `.with` writes in place unless an earlier link's write would
// be read through the root.
function fip_with_in_place(c: ast.ExprCall, fa: ast.ExprFieldAccess, root_own: boolean, root: string): boolean {
  return root_own && !fip_link_reads_root(c, fa, root);
}

function fip_link_reads_root(c: ast.ExprCall, fa: ast.ExprFieldAccess, root: string): boolean {
  if let ast.ExprCall(inner) = fa.obj {
    if let ast.ExprFieldAccess(link) = inner.callee {
      if (link.field != "with") {
        return false;
      }
      for a in c.args {
        if (astwalk.count_ident_expr(a, root) > 0) {
          return true;
        }
      }
    }
  }
  return false;
}

// e053_at_node flags, at ONE expression node, the constructs a `fip` / `fbip`
// function may not contain: array / tuple / struct literals and payload-carrying
// enum construction, string concatenation, a method call outside the
// non-allocating whitelist, a call to a callee outside the claim set, and any
// indirect call. It is native's checkFipFunctions switch (checker.go), which
// runs over ast.Walk — the same shape, on the same spine.
//
// No ExprLambda arm on purpose: native has none either. A lambda is not itself
// the violation; what it CONTAINS is, and the fold reaches that. The hand walk
// this replaced pruned there and so excused a whole closure body — and since the
// self-host has no FuncDecl statement (a nested named function parses as a
// StmtVar holding an ExprLambda), that one hole covered both spellings.
//
// No ExprMapLit / ExprFString arm for the opposite reason: neither reaches this
// pass. Both are printer-only nodes, every other parse having desugared them
// (parser.fern), and the desugared forms are already flagged as concatenation
// and `.to_string()` calls.
function e053_at_node(n: ast.Expr, fx: E053Ctx, cur: Scope, own out: util.Diag[]): util.Diag[] {
  match (n) {
    ast.ExprArray(a) => {
      return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not allocate (array literal)", a.line, a.col));
    },
    ast.ExprTuple(_) => {
      return out;
    },
    ast.ExprStructLit(_) => {
      return out;
    },
    ast.ExprBinary(b) => {
      if (b.op == "+" && (e053_stringish(b.left, cur) || e053_stringish(b.right, cur))) {
        return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not allocate (string concatenation)", b.line, b.col));
      }
      return out;
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          // Method call. `recv.with(i, v)` on an `own` receiver is the in-place
          // element set; `len` is the whitelisted non-allocating read.
          let recv_root: string = fip_recv_root(fa.obj);
          let root_own: boolean = false;
          for elem in fx.own {
            if (elem == recv_root) {
              root_own = true;
            }
          }
          if (fa.field == "with" && fip_with_in_place(c, fa, root_own, recv_root)) {
            return out;
          }
          // `recv.map(f)` on an `own` array is admitted as native admits it
          // (#9733): the in-place map is an IR fact, so irfipverify's E068
          // owns the verdict — and on this compiler, which has no in-place
          // map, that verdict is a refusal naming the reason.
          if (fa.field == "map" && root_own) {
            return out;
          }
          if (fa.field == "len") {
            return out;
          }
          return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not call method \"" + fa.field + "\" (not proven allocation-free)", fa.line, fa.col));
        },
        ast.ExprIdent(id) => {
          let is_variant: boolean = false;
          for variant in fx.variants {
            if (variant == id.name) {
              is_variant = true;
            }
          }
          if (is_variant) {
            return out;
          }
          // `fip` is the stronger claim and may only rely on other `fip`
          // callees; `fbip` may also call `fbip`, whose own construction sites
          // E068 verifies in turn.
          let callable: boolean = false;
          for elem in fx.callable {
            if (elem == id.name) {
              callable = true;
            }
          }
          if (!callable) {
            let only: string = "may only call other `fip` functions, not \"";
            if (fx.kw == "fbip") {
              only = "may only call `fip` or `fbip` functions, not \"";
            }
            return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" " + only + id.name + "\"", c.line, c.col));
          }
          return out;
        },
        _ => {
          return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not make an indirect call (not proven allocation-free)", c.line, c.col));
        }
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

// e053_own_exprs folds e053_at_node over the expressions `stmt` itself owns.
// `fx` and `cur` arrive as PARAMETERS rather than being read from the caller's
// loop: `cur` is reassigned once per statement there, and a visitor closing over
// a loop-mutated binding is a different question from one closing over a
// parameter.
function e053_own_exprs(stmt: ast.Stmt, fx: E053Ctx, cur: Scope): util.Diag[] {
  function at_node(n: ast.Expr, own out: util.Diag[]): util.Diag[] {
    return e053_at_node(n, fx, cur, out);
  }
  return astwalk.fold_stmt_own(stmt, no_diags(), at_node);
}

// e053_stmts keeps its own statement loop rather than folding: `cur` advances
// once per statement (check_stmt threads the scope), and each nested block is
// entered with the scope as of the statement that encloses it. A whole-subtree
// fold has one accumulator and cannot carry that.
//
// Order per statement is (1) the statement-shaped check, (2) the expressions the
// statement OWNS, (3) the blocks it encloses — which is the order the
// hand-written walk emitted in, arm for arm.
function e053_stmts(stmts: ast.Stmt[], fx: E053Ctx, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(a) => {
        // (Re)binding a local slot allocates nothing; an index/field
        // write is in-place only when rooted at an `own` parameter —
        // otherwise it triggers a copy-on-write.
        let trl: i32 = e053_root_len(a.target);
        if (trl >= 0 && !e053_root_is_own(a.target, trl, fx.own)) {
          out = out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not write to a non-`own` heap value (triggers a copy-on-write)", a.line, a.col));
        }
      },
      _ => {}
    }
    out = util.append_diags(out, e053_own_exprs(stmt, fx, cur));
    match (stmt) {
      ast.StmtIf(f) => {
        out = util.append_diags(out, e053_stmts(f.then_body, fx, cur));
        out = util.append_diags(out, e053_stmts(f.else_body, fx, cur));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e053_stmts(w.body, fx, cur));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e053_stmts(fr.body, fx, for_body_scope(fr, cur)));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, e053_stmts(arm.body, fx, cur));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e053_stmts(one, fx, cur));
      },
      _ => {}
    }
    cur = bind_stmt(stmt, cur);
  }
  return out;
}

// e053_diags walks one annotated function. `fips` / `fbips` are the module's
// two claim sets; the callee rule picks which of them this function may reach.
// fip_builtin_callees is native's fipNonAllocBuiltins: the builtins that lower
// to instructions or a runtime scan allocating nothing and returning a scalar or lane value,
// less any name the module declares as a free function. irfipverify's E068 stays the
// backstop for what they emit.
function fip_builtin_callees(funcs: parser.FuncDecl[]): string[] {
  let out: string[] = [];
  for name in [
    "__memchr", "__mismatch_bytes", "__mismatch_bytes_str", "__count_byte_bytes", "__crc32_cksum_array", "__sum_bytes_array", "__bsd_sum_bytes", "__memchr_bytes", "__rmemchr_bytes", "__rmemchr", "__ascii_run", "__count_byte", "__sum_bytes", "__scan_set", "__scan_set_bytes",
    "__bsd_sum", "__str_hash", "__count_runs", "__count_runs_bytes", "__crc32_cksum", "__clz32", "__ctz32", "__popcount32", "__clz64",
    "__ctz64", "__popcount64", "__mulhi_u64", "__ptr_width", "__heap_bump_bytes", "__heap_alloc_count", "monotonic_ns",
    "__f64x2_of", "__f64x2_splat", "__f64x2_lane",
    "__f64x2_lt", "__f64x2_ne", "__f64x2_bitmask", "__f32x4_bitmask",
  ] {
    let declared: boolean = false;
    for fd in funcs {
      if (fd.name == name && fd.receiver_type.len() == 0) {
        declared = true;
      }
    }
    if (!declared) {
      out = out.append(name);
    }
  }
  return out;
}

function e053_diags(efn: parser.FuncDecl, fips: string[], fbips: string[], variants: string[], s: Scope): util.Diag[] {
  let own: string[] = [];
  for param in efn.params {
    if (param.own) {
      own = own.append(param.name);
    }
  }
  let kw: string = "fip";
  let callable: string[] = fips;
  if (efn.fbip) {
    kw = "fbip";
    for fbip in fbips {
      callable = callable.append(fbip);
    }
  }
  let fx: E053Ctx = E053Ctx { fname: efn.name, kw: kw, callable: callable, variants: variants, own: own };
  return e053_stmts(efn.body, fx, s);
}

// ---- E065: returning a `str` view of a function-local string ---------------
// Port of the native checkStrEscape (checker.go): a function whose declared
// return type is `str` must not return a view of a function-LOCAL owned string — the
// backing box is reclaimed when the frame drops. Mirrors the native chase:
// a string literal is immortal, a parameter caller-owned; a local owned
// `string` IS the backing storage; a local `str` binding views whatever its initializer views; and a call views whatever its
// callee's summary says it hands back (see ViewSum below). `sbacked`
// accumulates locals known to be (views of) local string storage.
// E065Walk is one statement walk's result: the diagnostics it found, the
// enclosing function's parameter names its returns may view, and whether
// any return hands back a string the function itself built (`owns`),
// which is what makes a CALLER's view of the result dangle.
pub struct E065Walk { diags: util.Diag[], viewed: string[], owns: boolean }

function e065_ident_in(name: string, xs: string[]): boolean {
  for elem in xs {
    if (elem == name) {
      return true;
    }
  }
  return false;
}

// e065_return_roots reports where a returned expression's `str` bottoms
// out. Mirrors native strViewRoots' shapes: a bare ident naming a
// parameter or local-backed storage, `slice_unchecked(src, a, b)` which
// hands back a view of its source's bytes, and any other call, which
// hands back a view of whatever its summary names.
function e065_return_roots(e: ast.Expr, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): ViewRoots {
  match (e) {
    ast.ExprIdent(id) => {
      if (e065_ident_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (e065_ident_in(id.name, sbacked)) {
        let none: string[] = [];
        return ViewRoots { local: true, params: none };
      }
    },
    ast.ExprCall(c) => {
      return e065_call_roots(c, params, sbacked, sums, vix, s);
    },
    _ => {}
  }
  return no_view_roots();
}

// e065_string_src_roots reports where the storage behind an OWNED `string`
// value comes from: a parameter the caller still owns, or this frame. It
// answers the question e065_return_roots cannot, because a `string` is not
// a view — the interesting fact is who allocated it, not what it points at.
//
// A string literal is immortal and contributes neither root. A name that is
// not a parameter is this frame's, keyed on the binding rather than on what
// initialised it, so `let s: string = mk()` stays this frame's storage even
// when mk returns a literal (native keys on the declared type for the same
// reason). Anything that BUILDS a string — a concat, a format — is this
// frame's, and so is a call the summary does not cover.
function e065_string_src_roots(e: ast.Expr, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): ViewRoots {
  let none: string[] = [];
  match (e) {
    ast.ExprString(_) => {
      return no_view_roots();
    },
    ast.ExprIdent(id) => {
      if (e065_ident_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (e065_ident_in(id.name, sbacked)) {
        return ViewRoots { local: true, params: none };
      }
      // Neither a parameter nor known backing storage: a local `str`
      // holding a VIEW of something else, which this frame does not own.
      // `sbacked` is what the native side reads off the declared type —
      // a local `string` IS the storage, a local `str` only points at it.
      return no_view_roots();
    },
    ast.ExprCall(c) => {
      let callee: ViewCallee = view_callee(c, s);
      if (callee.key.len() == 0) {
        return ViewRoots { local: true, params: none };
      }
      let out: ViewRoots = no_view_roots();
      if (!view_sum_known(sums, vix, callee.key) || view_sum_fresh(sums, vix, callee.key)) {
        out = ViewRoots { local: true, params: out.params };
      }
      let flags: boolean[] = view_sum_flags(sums, vix, callee.key);
      let i: i32 = 0;
      while (i < flags.len() && i < callee.args.len()) {
        if (flags[i]) {
          out = merge_view_roots(out, e065_string_src_roots(callee.args[i], params, sbacked, sums, vix, s));
        }
        i = i + 1;
      }
      return out;
    },
    _ => {}
  }
  return ViewRoots { local: true, params: none };
}

// e065_call_roots chases a call: `slice_unchecked` hands back a view of
// its source, and any other callee hands back a view of whichever
// arguments its summary names.
function e065_call_roots(c: ast.ExprCall, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): ViewRoots {
  let direct: string = "";
  match (c.callee) {
    ast.ExprIdent(cid) => {
      direct = cid.name;
    },
    _ => {}
  }
  if (direct == "slice_unchecked" && c.args.len() == 3) {
    // Its source is a `string`, so who OWNS that string is the question —
    // a param outlives the call, storage this frame holds does not.
    return e065_string_src_roots(c.args[0], params, sbacked, sums, vix, s);
  }
  let out: ViewRoots = no_view_roots();
  let callee: ViewCallee = view_callee(c, s);
  if (callee.key.len() == 0) {
    return out;
  }
  let flags: boolean[] = view_sum_flags(sums, vix, callee.key);
  let i: i32 = 0;
  while (i < flags.len() && i < callee.args.len()) {
    if (flags[i]) {
      out = merge_view_roots(out, e065_return_roots(callee.args[i], params, sbacked, sums, vix, s));
    }
    i = i + 1;
  }
  return out;
}

// e065_view_source_name names the local whose storage a slice-producing
// scrutinee views, or "" when it views nothing nameable.
function e065_view_source_name(e: ast.Expr): string {
  match (e) {
    ast.ExprSlice(sl) => {
      match (sl.array) {
        ast.ExprIdent(sid) => {
          return sid.name;
        },
        _ => {}
      }
    },
    ast.ExprCall(c) => {
      let callee_name: string = "";
      match (c.callee) {
        ast.ExprIdent(cid) => {
          callee_name = cid.name;
        },
        _ => {}
      }
      if (callee_name == "slice_unchecked" && c.args.len() == 3) {
        match (c.args[0]) {
          ast.ExprIdent(sid) => {
            return sid.name;
          },
          _ => {}
        }
      }
    },
    ast.ExprIdent(id) => {
      // `let t = s[a:b]; match (t)` — the local carries the Option, and
      // the StmtVar arm above already recorded it as reaching backed
      // storage, so the name answers for itself.
      return id.name;
    },
    _ => {}
  }
  return "";
}

// e065_with_arm_bindings adds every arm's payload binding names to the
// backed set. A binding that is not a `str` can only reach the E065 check
// by being returned from a `str`-returning function, which its type
// forbids, so naming them all is conservative rather than wrong.
function e065_with_arm_bindings(sbacked: string[], arms: ast.MatchArm[]): string[] {
  let out: string[] = sbacked;
  for arm in arms {
    match (arm.pattern) {
      ast.PatVariant(pv) => {
        if (pv.binding.len() > 0) {
          out = out.append(pv.binding);
        }
        for extra in pv.extra_bindings {
          if (extra.len() > 0) {
            out = out.append(extra);
          }
        }
      },
      _ => {}
    }
  }
  return out;
}

function e065_stmts(stmts: ast.Stmt[], fname: string, params: string[], str_ret_names: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope, ret_is_view: boolean): E065Walk {
  let out: util.Diag[] = [];
  let viewed: string[] = [];
  let owns: boolean = false;
  let cur: Scope = s;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.type_name == "str") {
          // A `str` binding views its initializer: tainted only
          // when the init is (a view of) local string storage —
          // a backed ident, or a `slice_unchecked` whose SOURCE
          // is backed. `s[a:b]` cannot appear here: it is
          // `Option[str]` (#5634), which does not bind to `str`.
          match (v.init) {
            ast.ExprIdent(id) => {
              if (!e065_ident_in(id.name, params) && e065_ident_in(id.name, sbacked)) {
                sbacked = sbacked.append(v.name);
              }
            },
            ast.ExprCall(sc) => {
              if (e065_call_roots(sc, params, sbacked, sums, vix, cur).local) {
                sbacked = sbacked.append(v.name);
              }
            },
            _ => {}
          }
        } else if (v.type_name == "string") {
          // An annotated owned `string` local IS backing storage.
          sbacked = sbacked.append(v.name);
        } else if (v.type_name.len() == 0) {
          // Unannotated: infer the native way — a string literal
          // or an alias of known local storage makes an owned
          // StringType local; a call to a `str`-returning function
          // makes a view, tainted when the summary says it views
          // local-backed storage.
          match (v.init) {
            ast.ExprString(_) => {
              sbacked = sbacked.append(v.name);
            },
            ast.ExprIdent(id) => {
              if (e065_ident_in(id.name, sbacked)) {
                sbacked = sbacked.append(v.name);
              }
            },
            ast.ExprSlice(osl) => {
              // `let t = s[a:b]` binds an `Option[str]`, not a view — but
              // its PAYLOAD views `s`, and the only way to name that
              // payload is a match arm. Recording `t` here is what lets
              // the StmtMatch arm below see through the two-step form.
              // `t` itself can never trip the return check: its type is
              // not `str`.
              match (osl.array) {
                ast.ExprIdent(osid) => {
                  if (!e065_ident_in(osid.name, params) && e065_ident_in(osid.name, sbacked)) {
                    sbacked = sbacked.append(v.name);
                  }
                },
                _ => {}
              }
            },
            ast.ExprCall(c) => {
              // A call handing back a local-backed view is the same
              // escape one binding removed: `let t = idv(
              // slice_unchecked(s, 0, 1)); return t;` dangles exactly as
              // the direct return does. Plus the owned-`string`
              // inference the rest of this branch does.
              if (e065_call_roots(c, params, sbacked, sums, vix, cur).local) {
                sbacked = sbacked.append(v.name);
              }
              let callee_name: string = "";
              match (c.callee) {
                ast.ExprIdent(cid) => {
                  callee_name = cid.name;
                },
                ast.ExprFieldAccess(cfa) => {
                  callee_name = cfa.field;
                },
                _ => {}
              }
              if (!e065_ident_in(callee_name, str_ret_names)) {
                match (check_expr(v.init, cur)) {
                  typeinfo.TypeString(_) => {
                    sbacked = sbacked.append(v.name);
                  },
                  _ => {}
                }
              }
            },
            _ => {}
          }
        }
      },
      ast.StmtReturn(r) => {
        if (!ret_is_view) {
          // An owned `string` return hands its STORAGE to the caller, so
          // the question is who allocated it, not what it points at.
          let sroots: ViewRoots = e065_string_src_roots(r.value, params, sbacked, sums, vix, cur);
          viewed = merge_view_names(viewed, sroots.params);
          if (sroots.local) {
            owns = true;
          }
        }
        let roots: ViewRoots = e065_return_roots(r.value, params, sbacked, sums, vix, cur);
        viewed = merge_view_names(viewed, roots.params);
        if (ret_is_view && roots.local) {
          out = out.append(dg_at("E065", "returning a `str` view of a function-local string: the backing string is reclaimed when \"" + fname + "\" returns, leaving a dangling view — return an owned `string` (materialise with .to_owned()) or view a parameter instead", r.line, r.col));
        }
      },
      ast.StmtIf(f) => {
        let wt: E065Walk = e065_stmts(f.then_body, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, wt.diags);
        viewed = merge_view_names(viewed, wt.viewed);
        owns = owns || wt.owns;
        let we: E065Walk = e065_stmts(f.else_body, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, we.diags);
        viewed = merge_view_names(viewed, we.viewed);
        owns = owns || we.owns;
      },
      ast.StmtWhile(w) => {
        let ww: E065Walk = e065_stmts(w.body, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, ww.diags);
        viewed = merge_view_names(viewed, ww.viewed);
        owns = owns || ww.owns;
      },
      ast.StmtFor(fr) => {
        let wf: E065Walk = e065_stmts(fr.body, fname, params, str_ret_names, sbacked, sums, vix, for_body_scope(fr, cur), ret_is_view);
        out = util.append_diags(out, wf.diags);
        viewed = merge_view_names(viewed, wf.viewed);
        owns = owns || wf.owns;
      },
      ast.StmtMatch(m) => {
        // A match-arm payload binding is not a declared local, so without
        // this the arm body cannot tell that `v` in `match (s[a:b]) {
        // Some(v) => … }` views `s`. Since #5634 made the slice an
        // `Option[str]`, that unwrap is the only way to name the view.
        let arm_sb: string[] = sbacked;
        let msrc: string = e065_view_source_name(m.scrutinee);
        if (msrc.len() > 0 && !e065_ident_in(msrc, params) && e065_ident_in(msrc, sbacked)) {
          arm_sb = e065_with_arm_bindings(arm_sb, m.arms);
        }
        for arm in m.arms {
          let wa: E065Walk = e065_stmts(arm.body, fname, params, str_ret_names, arm_sb, sums, vix, cur, ret_is_view);
          out = util.append_diags(out, wa.diags);
          viewed = merge_view_names(viewed, wa.viewed);
          owns = owns || wa.owns;
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        let wd: E065Walk = e065_stmts(one, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, wd.diags);
        viewed = merge_view_names(viewed, wd.viewed);
        owns = owns || wd.owns;
      },
      _ => {}
    }
    cur = bind_stmt(stmt, cur);
  }
  return E065Walk { diags: out, viewed: viewed, owns: owns };
}

function e065_diags(efn: parser.FuncDecl, str_ret_names: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): E065Walk {
  let params: string[] = view_positions(efn);
  let none: string[] = [];
  return e065_stmts(efn.body, efn.name, params, str_ret_names, none, sums, vix, s, efn.ret_type == "str");
}

// e065_cursor_diags is E065 for a `MapIter`, the native checkCursorEscapes: a
// cursor reads its map's columns through a raw pointer, so returning one over
// a map the function owns hands the caller freed storage (#9920). A cursor
// over a parameter, or a field chain off one, stays anchored to the caller's
// map. A returned name is followed through every value the body binds or
// assigns to it, so neither a shadowing declaration nor a reassignment on
// another path hides the one that dangles.
struct CursorScan { params: string[], fname: string, var_names: string[], var_inits: ast.Expr[], diags: util.Diag[] }

function e065_cursor_diags(efn: parser.FuncDecl): util.Diag[] {
  let none: util.Diag[] = [];
  if (!util.contains(efn.ret_type, "MapIter[")) {
    return none;
  }
  let params: string[] = [];
  for p in efn.params {
    params = params.append(p.name);
  }
  let no_inits: ast.Expr[] = [];
  let sc: CursorScan = CursorScan { params: params, fname: efn.name, var_names: [], var_inits: no_inits, diags: none };
  for st in efn.body {
    sc = astwalk.fold_stmt_spine(st, sc, cursor_source_stmt);
  }
  for st in efn.body {
    sc = astwalk.fold_stmt_spine(st, sc, cursor_return_stmt);
  }
  return sc.diags;
}

function cursor_source_stmt(st: ast.Stmt, own sc: CursorScan): CursorScan {
  match (st) {
    ast.StmtVar(v) => {
      return CursorScan { ...sc, var_names: sc.var_names.append(v.name), var_inits: sc.var_inits.append(v.init) };
    },
    ast.StmtAssign(a) => {
      return CursorScan { ...sc, var_names: sc.var_names.append(a.target), var_inits: sc.var_inits.append(a.value) };
    },
    _ => {}
  }
  return sc;
}

function cursor_return_stmt(st: ast.Stmt, own sc: CursorScan): CursorScan {
  if let ast.StmtReturn(r) = st {
    if (cursor_over_local(r.value, sc, 0)) {
      return CursorScan { ...sc, diags: sc.diags.append(dg_at("E065", "returning a `MapIter` over a function-local map: the map is reclaimed when \"" + sc.fname + "\" returns, leaving the cursor reading freed storage — return the map and iterate it in the caller, or iterate a map the caller passed in", r.line, r.col)) };
    }
  }
  return sc;
}

// cursor_over_local reports whether e is `m.iter()`, or a local any of whose
// sources is one, whose map is not caller-owned storage.
function cursor_over_local(e: ast.Expr, sc: CursorScan, depth: i32): boolean {
  if (depth > 8) {
    return false;
  }
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          return fa.field == "iter" && c.args.len() == 0 && !lent_place(fa.obj, sc.params);
        },
        _ => {}
      }
    },
    ast.ExprIdent(id) => {
      return cursor_source_over_local(id.name, sc, depth + 1);
    },
    ast.ExprArray(al) => {
      return any_cursor_over_local(al.elements, sc, depth + 1);
    },
    ast.ExprTuple(tl) => {
      return any_cursor_over_local(tl.elements, sc, depth + 1);
    },
    _ => {}
  }
  return false;
}

// Whether any value bound or assigned to `name` is a cursor over a local map.
function cursor_source_over_local(name: string, sc: CursorScan, depth: i32): boolean {
  let i: i32 = 0;
  while (i < sc.var_names.len()) {
    if (sc.var_names[i] == name && cursor_over_local(sc.var_inits[i], sc, depth)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function any_cursor_over_local(es: ast.Expr[], sc: CursorScan, depth: i32): boolean {
  for e in es {
    if (cursor_over_local(e, sc, depth)) {
      return true;
    }
  }
  return false;
}

function lent_place(e: ast.Expr, params: string[]): boolean {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      return lent_place(fa.obj, params);
    },
    ast.ExprIdent(id) => {
      return util.index_of_str(params, id.name) >= 0;
    },
    _ => {}
  }
  return false;
}

// ---- E032: `use` binding-type inference ------------------------------------
// Port of the native inferUseParam (checker.go): `use BIND <- CALLEE(args);`
// with no `: TYPE` annotation infers BIND's type from CALLEE's signature —
// the trailing function-typed parameter's first argument. The parser marks
// the synthesised callback lambda with use_infer; this walk verifies the
// inference has a signature to read: the callee must be a bare identifier
// with a known signature whose last parameter is a function type taking at
// least one argument, and a generic callee's written arguments must bind
// the type parameters the callback's first parameter names.
function e032_call_check(c: ast.ExprCall, cur: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.args.len() == 0) {
    return out;
  }
  let infer: boolean = false;
  let line: i32 = c.line;
  let col: i32 = c.col;
  match (c.args[c.args.len() - 1]) {
    ast.ExprLambda(lm) => {
      if (lm.use_infer && lm.params.len() > 0 && lm.params[0].type_name.len() == 0) {
        infer = true;
        line = lm.line;
        col = lm.col;
      }
    },
    _ => {}
  }
  if (!infer) {
    return out;
  }
  let callee_name: string = "";
  match (c.callee) {
    ast.ExprIdent(id) => {
      callee_name = id.name;
    },
    _ => {
      out = out.append(dg_at("E032", "use: cannot infer binding type for non-identifier source — add an explicit `: TYPE` annotation", line, col));
      return out;
    }
  }
  // Resolve the callee: a module-level signature, or a local
  // function-typed binding. The side table identifies callback parameters,
  // and the callable type retains their arity. A generic callee whose arguments leave the
  // callback's parameter unbound is use_binding_type's unknown.
  let sig: FuncSig = cur.lookup_sig(callee_name);
  let have_sig: boolean = sig.name.len() > 0;
  if (have_sig) {
    if (sig.param_types.len() == 0) {
      out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", line, col));
      return out;
    }
    let last: i32 = sig.param_types.len() - 1;
    let lf: boolean = is_func_type(sig.param_types[last]);
    if (!lf) {
      out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s last parameter isn't a function — add an explicit `: TYPE` annotation", line, col));
    } else if (use_callback_empty(sig)) {
      out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s callback takes no arguments — there's nothing to bind", line, col));
    } else if (sig.all_type_params.len() > 0 && is_unknown(use_binding_type(c, cur))) {
      out = out.append(dg_at("E032", "use: could not infer binding type for \"" + callee_name + "\" from its arguments — add an explicit `: TYPE` annotation", line, col));
      // The callback's parameter stays unknown, so it does not fit the
      // callee's parameter either, which native reports as it is declared.
      let expected: string = "fn";
      if (last < sig.param_type_names.len()) {
        expected = sig.param_type_names[last];
      }
      out = out.append(dg_at("E038", arg_subject(c, c.args.len()) + ": expected " + expected + ", got " + use_callback_label(c.args[c.args.len() - 1], cur), line, col));
    }
    return out;
  }
  let bound_at: i32 = cur.binding_index(callee_name);
  if (bound_at >= 0) {
    if let typeinfo.TypeFunc(ft) = cur.types[bound_at] {
      if (ft.param_types.len() == 0) {
        out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", line, col));
        return out;
      }
      match (ft.param_types[ft.param_types.len() - 1]) {
        typeinfo.TypeFunc(cb) => {
          if (cb.param_types.len() == 0) {
            out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s callback takes no arguments — there's nothing to bind", line, col));
          }
        },
        _ => {
          out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s last parameter isn't a function — add an explicit `: TYPE` annotation", line, col));
        }
      }
      return out;
    }
  }
  out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", line, col));
  return out;
}

function use_callback_empty(sig: FuncSig): boolean {
  if (sig.param_types.len() > 0) {
    if let typeinfo.TypeFunc(f) = sig.param_types[sig.param_types.len() - 1] {
      return f.params_known && f.param_types.len() == 0;
    }
  }
  return false;
}

function argument_type_label(e: ast.Expr, t: typeinfo.Type, s: Scope): string {
  if let ast.ExprLambda(lm) = e {
    if (lm.use_infer && lm.params.len() > 0 && lm.params[0].type_name.len() == 0) {
      return use_callback_label(e, s);
    }
  }
  return type_label(t);
}

// use_callback_label spells a synthesised `use` callback whose binding has no
// type: each parameter unknown, and the return its body settled.
function use_callback_label(e: ast.Expr, s: Scope): string {
  let params: string = "";
  if let ast.ExprLambda(lm) = e {
    let i: i32 = 0;
    while (i < lm.params.len()) {
      if (i > 0) {
        params = params + ", ";
      }
      params = params + "<unknown>";
      i = i + 1;
    }
  }
  let ret: string = "unknown";
  if let typeinfo.TypeFunc(ft) = check_expr(e, s) {
    ret = type_label(ft.ret_type);
  }
  return "(" + params + ") => " + ret;
}

// e021_diags reports E021 (#4347): an `impl Trait for Type` block that omits a
// REQUIRED (abstract, non-defaulted) trait method. mod.trait_reqs carries each
// trait's abstract method set; mod.impls records each impl's explicitly-provided
// methods. For every impl, every required method of its trait that the impl
// doesn't provide draws E021 — matching native's `Type does not implement
// Trait: missing method "m"`. A defaulted method is never in trait_reqs (the
// default is synthesised onto the impl), so a complete-via-default impl is
// never falsely flagged. This is the first slice of the E021 family; arity /
// object-safety / supertrait / bound conformance (+ E060 / E062) are follow-ups.
// e021_const_kind_diags is E021 when a trait's associated constant is bound by
// a function, or its associated function by a const: the two are not
// interchangeable even at the same signature.
function e021_const_kind_diags(req: parser.FuncDecl, impl_fn: parser.FuncDecl, im: parser.ImplInfo): util.Diag[] {
  if (req.is_const == impl_fn.is_const) {
    return [];
  }
  if (req.is_const) {
    return [dg_at("E021", im.impl_type + "." + req.name + " is an associated constant of trait " + im.trait_name + "; bind it with `const " + req.name + ": " + parser.subst_self(req.ret_type, im.impl_type) + " = …;`, not a function", im.line, im.col)];
  }
  return [dg_at("E021", im.impl_type + "." + req.name + " is an associated function of trait " + im.trait_name + "; provide it with `function`, not a const", im.line, im.col)];
}

// e021_recv_method_idx returns the index in mod.funcs of the receiver method
// named `m` on base type `ty`, or -1. This is the impl's PROVIDING method — a
// written impl method OR an inherent method an empty impl adopts (a builtin like
// i32.to_string from core/int, matching native's "empty impls adopt the existing
// method" rule: `impl Display for i32 { }` is valid because i32 already carries
// to_string). A -1 with no in-block method_names entry is the missing-method
// E021; a hit additionally drives the signature check.
function e021_recv_method_idx(mod: parser.Module, ty: string, m: string): i32 {
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let f: parser.FuncDecl = mod.funcs[i];
    if (f.receiver_type.len() > 0 && f.name == m && util.base_type_name(f.receiver_type) == ty) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// e021_sig_matches compares a trait's required method signature `req` against
// the impl's providing method `impl_fn` (Self resolved to impl_type). It is
// DELIBERATELY conservative — returns true (no diagnostic) whenever it can't
// compare with certainty — so it never false-positives on the self-host bundle:
//   - a generic trait method OR impl method (type params present) is skipped,
//     since a bare type-name string compare can't see the erased params;
//   - a requirement of a generic TRAIT (`trait Iterator[T]`) is read at the
//     impl's trait arguments (`impl Iterator[i32] for Range`), and skipped
//     when the impl does not write one per trait parameter;
// otherwise the trait's post-`self` param type list + return type (each rewritten
// Self -> impl_type via the same parser.subst_self finalize_impl_method used on
// the impl side) must equal the impl method's params + return, or it's a
// mismatch (native E021 "wrong signature").
// `impls` is needed because the TRAIT side of the comparison still spells its
// associated types as projections (`Self::Item`): the parser resolves the impl
// method's copy, so the requirement must be resolved the same way before the
// two are compared, or every associated-type impl reads as a signature
// mismatch. Native does the same in its conformance pass (resolveProjWith).
function e021_sig_matches(req: parser.FuncDecl, impl_fn: parser.FuncDecl, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): boolean {
  if (tparams.len() > 0 && parser.parse_type_ref(im.trait_ref).args.len() != tparams.len()) {
    return true;
  }
  if (req.type_params.len() > 0 || req.all_type_params.len() > 0) {
    return true;
  }
  if (impl_fn.type_params.len() > 0 || impl_fn.all_type_params.len() > 0) {
    return true;
  }
  if (!e021_self_matches(req, im, tparams, impls)) {
    return false;
  }
  // A requirement without a `self` is an associated function, whose every
  // parameter the impl writes.
  let first: i32 = 0;
  if (req.params.len() > 0 && req.params[0].name == "self") {
    first = 1;
  }
  if (req.params.len() - first != impl_fn.params.len()) {
    return false;
  }
  let i: i32 = first;
  while (i < req.params.len()) {
    if (e021_req_spelling(req.params[i].type_name, im, tparams, impls) != impl_fn.params[i - first].type_name) {
      return false;
    }
    i = i + 1;
  }
  return e021_req_spelling(req.ret_type, im, tparams, impls) == impl_fn.ret_type;
}

// e021_wrong_sig is E021 for an impl method whose signature differs from the
// trait's, both spelled as the Go checker spells a function type.
function e021_wrong_sig(req: parser.FuncDecl, impl_fn: parser.FuncDecl, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): util.Diag {
  let want: string[] = [];
  let got: string[] = [];
  for p in req.params {
    if (p.name == "self" && p.type_name.len() == 0) {
      want = want.append(im.impl_type);
    } else {
      want = want.append(e021_req_spelling(p.type_name, im, tparams, impls));
    }
  }
  if (req.params.len() > 0 && req.params[0].name == "self") {
    got = got.append(impl_fn.receiver_type);
  }
  for p in impl_fn.params {
    got = got.append(p.type_name);
  }
  let expected: string = e021_sig_text(want, e021_req_spelling(req.ret_type, im, tparams, impls));
  return dg_at("E021", im.impl_type + "." + req.name + " has the wrong signature for trait " + im.trait_name + ": expected " + expected + ", got " + e021_sig_text(got, impl_fn.ret_type), im.line, im.col);
}

function e021_sig_text(params: string[], ret: string): string {
  let r: string = ret;
  if (r.len() == 0) {
    r = "void";
  }
  return "(" + comma_list(params) + ") => " + r;
}

// e021_self_matches reports whether a requirement's `self`, if it has one,
// names the impl type: the impl peels `self` into a receiver of that type,
// an inherited default's copy included.
function e021_self_matches(req: parser.FuncDecl, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): boolean {
  if (req.params.len() == 0 || req.params[0].name != "self" || req.params[0].type_name.len() == 0) {
    return true;
  }
  return e021_req_spelling(req.params[0].type_name, im, tparams, impls) == im.impl_type;
}

// e021_req_spelling is a requirement's type spelling as the impl must write
// it: `Self` the impl type, the trait's parameters its arguments, and each
// projection resolved.
function e021_req_spelling(t: string, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): string {
  let spelled: string = parser.subst_self(t, im.impl_type);
  if (tparams.len() > 0) {
    spelled = dyn_ret_at_spelling(spelled, im.trait_ref, tparams);
  }
  return parser.resolve_proj_in_type(spelled, impls);
}

// e021_has_impl reports whether the module contains an `impl <trait_name> for
// <impl_type>` — used for the supertrait-conformance check (#4347 slice 3).
function e021_has_impl(mod: parser.Module, trait_name: string, impl_type: string): boolean {
  for imp in mod.impls {
    if (imp.trait_name == trait_name && imp.impl_type == impl_type) {
      return true;
    }
  }
  return false;
}

function e021_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for im in mod.impls {
    // An array, owned or a view, has no receiver name a trait's methods could
    // hang on, as native's methodTypeName has none.
    let ir: parser.TypeRef = parser.parse_type_ref(im.impl_type);
    if (im.trait_name != "" && (ir.array_depth > 0 || ir.is_view)) {
      out = out.append(dg("E021", "`impl … for " + im.impl_type + "`: type must be a struct, enum, or built-in type"));
      continue;
    }
    for trait_req in mod.trait_reqs {
      if (trait_req.trait_name == im.trait_name && trait_req.module == im.trait_module) {
        // Supertrait conformance: `impl B for T` where `trait B: A`
        // requires a separate `impl A for T` (#4347 slice 3).
        let sup: string[] = trait_req.supertraits;
        for elem in sup {
          if (!e021_has_impl(mod, elem, im.impl_type)) {
            out = out.append(dg_at("E021", "impl " + im.trait_name + " for " + im.impl_type + " also requires `impl " + elem + " for " + im.impl_type + "` (supertrait of " + im.trait_name + ")", im.line, im.col));
          }
        }
        // Associated types: an impl must bind EXACTLY the trait's set — every
        // one the trait declares, and nothing it does not. Mirrors native's
        // conformance pass. See docs/ASSOCIATED-TYPES.md.
        //
        // Named by the BASE type, dropping any type arguments: a parametric
        // impl's `for` spelling is `Box[T]`, and native reports the same
        // conformance failure against `Box`.
        let im_base: string = util.base_type_name(im.impl_type);
        for at_req in trait_req.assoc_types {
          if (!name_in(at_req, im.assoc_names)) {
            out = out.append(dg_at("E021", "impl of " + im.trait_name + " for " + im_base + " must bind associated type \"" + at_req + "\" (`type " + at_req + " = …;`)", im.line, im.col));
          }
        }
        for at_bound in im.assoc_names {
          if (!name_in(at_bound, trait_req.assoc_types)) {
            out = out.append(dg_at("E021", "impl of " + im.trait_name + " for " + im_base + " binds associated type \"" + at_bound + "\" which the trait does not declare", im.line, im.col));
          }
        }
        let reqs: string[] = trait_req.methods;
        let sigs: parser.FuncDecl[] = trait_req.req_sigs;
        let ri: i32 = 0;
        while (ri < reqs.len()) {
          // Satisfied if the impl block writes it OR the type already
          // has an inherent / cross-impl method of that name (native's
          // "adopt the existing method" rule).
          let midx: i32 = e021_recv_method_idx(mod, im.impl_type, reqs[ri]);
          if (!name_in(reqs[ri], im.method_names) && midx < 0) {
            if (ri < sigs.len() && sigs[ri].is_const) {
              out = out.append(dg_at("E021", im.impl_type + " does not implement " + im.trait_name + ": missing associated constant \"" + reqs[ri] + "\"", im.line, im.col));
            } else {
              out = out.append(dg_at("E021", im.impl_type + " does not implement " + im.trait_name + ": missing method \"" + reqs[ri] + "\"", im.line, im.col));
            }
          } else if (midx >= 0 && ri < sigs.len()) {
            // Provided as a receiver method — check its signature
            // against the trait's declaration (#4347 slice 2).
            let kind_dg: util.Diag[] = e021_const_kind_diags(sigs[ri], mod.funcs[midx], im);
            if (kind_dg.len() > 0) {
              out = util.append_diags(out, kind_dg);
            } else if (!e021_sig_matches(sigs[ri], mod.funcs[midx], im, trait_req.type_params, mod.impls)) {
              out = out.append(e021_wrong_sig(sigs[ri], mod.funcs[midx], im, trait_req.type_params, mod.impls));
            }
          }
          ri = ri + 1;
        }
        // An impl that overrides a defaulted method is held to the
        // default's signature as to a requirement's; one that inherits it
        // takes it with its receiver at the impl type.
        for ds in trait_req.default_sigs {
          let didx: i32 = e021_recv_method_idx(mod, im.impl_type, ds.name);
          let written: boolean = name_in(ds.name, im.method_names) && didx >= 0;
          if (written && e021_const_kind_diags(ds, mod.funcs[didx], im).len() > 0) {
            out = util.append_diags(out, e021_const_kind_diags(ds, mod.funcs[didx], im));
          } else if (written && !e021_sig_matches(ds, mod.funcs[didx], im, trait_req.type_params, mod.impls)) {
            out = out.append(e021_wrong_sig(ds, mod.funcs[didx], im, trait_req.type_params, mod.impls));
          } else if (!written && !e021_self_matches(ds, im, trait_req.type_params, mod.impls)) {
            out = out.append(dg_at("E021", im.impl_type + "." + ds.name + " has the wrong signature for trait " + im.trait_name, im.line, im.col));
          }
        }
      }
    }
  }
  return out;
}

// e021_derive_field_known reports whether a derive-field type name is
// one the conformance pre-check can reason about: a primitive scalar or
// a declared struct / enum name. Composite shapes (`i32[]`, tuples,
// maps, closures) and unknown names stay silent — matching the native
// pre-check, which skips any type it cannot name.
//
// The scalar list must track what ast.ReceiverTypeName names, since that
// is the set native's pre-check reasons about: a name missing here is a
// field native checks and this side silently skips, not a conservative
// omission. `u8` and `char` were both missing. (`str` needs no entry: a field
// is checked in its receiver namespace, where a `str` is a `string`.)
function e021_derive_scalar(fty: string): boolean {
  return fty == "i32" || fty == "i64" || fty == "u8" || fty == "u32" || fty == "u64" || fty == "f32" || fty == "f64" || fty == "boolean" || fty == "char" || fty == "string";
}

function e021_derive_field_known(mod: parser.Module, fty: string): boolean {
  if (e021_derive_scalar(fty)) {
    return true;
  }
  for sd in mod.structs {
    if (sd.name == fty) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == fty) {
      return true;
    }
  }
  return false;
}

// e021_derive_conforms reports whether derive-field type `fty` satisfies
// trait `tr` (requirement record at `treq_idx`): an explicit `impl tr
// for fty`, or fty providing every required trait method as a receiver
// method — which captures both an inherent method set and a field type
// whose OWN @derive already synthesised the methods at parse time.
//
// The method-set arm is right HERE and wrong for a bound: this asks whether
// a derive on the owner can be synthesised from its fields, and a field whose
// derive already ran carries the methods and no impl-table entry. The bound
// check (type_implements) asks whether a type argument conforms, where an
// inherent method is not an impl — see #9486. A trait with no required
// methods conforms only via the explicit impl either way.
function e021_derive_conforms(mod: parser.Module, tr: string, treq_idx: i32, fty: string): boolean {
  if (e021_has_impl(mod, tr, fty)) {
    return true;
  }
  let reqs: string[] = mod.trait_reqs[treq_idx].methods;
  if (reqs.len() == 0) {
    return false;
  }
  for req in reqs {
    if (e021_recv_method_idx(mod, fty, req) < 0) {
      return false;
    }
  }
  return true;
}

// derive_trait_idx finds the trait a derive spelling names: a bare name among
// the program's own traits, `p.Name` among those of the module with bundle
// prefix `p` (flatten.canon_derives spells every derive that way). -1 when
// nothing in scope declares it.
function derive_trait_idx(tr: string, trait_reqs: parser.TraitReq[]): i32 {
  let dot: i32 = tr.len() - 1;
  while (dot >= 0 && tr[dot] != b'.') {
    dot = dot - 1;
  }
  let q: string = "";
  let name: string = tr;
  if (dot >= 0) {
    q = slice_unchecked(tr, 0, dot) + "";
    name = slice_unchecked(tr, dot + 1, tr.len()) + "";
  }
  let i: i32 = 0;
  while (i < trait_reqs.len()) {
    if (trait_reqs[i].trait_name == name && trait_reqs[i].module == q) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// derive_import_unloaded reports a qualified derive whose qualifier is one of
// the program's imports but whose module was never loaded — a single-module
// driver checks without its imports, so nothing can say what that module
// declares.
function derive_import_unloaded(mod: parser.Module, tr: string): boolean {
  let dot: i32 = tr.len() - 1;
  while (dot >= 0 && tr[dot] != b'.') {
    dot = dot - 1;
  }
  if (dot < 0) {
    return false;
  }
  let q: string = slice_unchecked(tr, 0, dot) + "";
  for r in mod.trait_reqs {
    if (r.module == q) {
      return false;
    }
  }
  for im in mod.imports {
    let qual: string = im.alias;
    if (qual.len() == 0) {
      let sl: i32 = im.path.len() - 1;
      while (sl >= 0 && im.path[sl] != b'/') {
        sl = sl - 1;
      }
      qual = slice_unchecked(im.path, sl + 1, im.path.len()) + "";
    }
    if (qual == q) {
      return true;
    }
  }
  return false;
}

// e021_derive_one_diag returns the E021 for ONE @derive(tr) on type
// `tname` (struct fields or flattened enum variant payloads: labels[i]
// names types[i] in the message), or none. As native does, a trait nothing
// in scope declares is "unknown" (there is no prelude, so a bare `Eq` needs
// the program's own `trait Eq`), and a declared trait outside the derivable
// set is refused. Then the field check mirrors native's pre-check (#5392):
// only known non-generic field types, and the first non-conforming field
// draws the single diagnostic at the deriving decl. Default gives a scalar
// field its zero literal, so only its struct and enum fields are checked:
// those delegate to their own `default()`.
function e021_derive_one_diag(mod: parser.Module, tr: string, tname: string, labels: string[], ftys: string[], tps: string[], ln: i32, cl: i32): util.Diag[] {
  let kind: string = parser.derive_simple_name(tr);
  let tidx: i32 = derive_trait_idx(tr, mod.trait_reqs);
  if (tidx < 0) {
    if (derive_import_unloaded(mod, tr)) {
      return [];
    }
    return [dg_at("E021", "@derive(" + tr + "): unknown trait", ln, cl)];
  }
  if (kind != "Eq" && kind != "Ord" && kind != "Hash" && kind != "Display" && kind != "Debug" && kind != "Json" && kind != "FromJson" && kind != "Default") {
    return [dg_at("E021", "cannot @derive(" + tr + "): only Eq, Display, Debug, Ord, Hash, Json, FromJson, and Default are derivable", ln, cl)];
  }
  // A FromJson derive decodes an array or Option field through its
  // element, so the element is what must conform; a container nested in
  // another has no decoder. Its body calls std/json's readers, so the
  // import is required.
  let ctys: string[] = ftys;
  if (kind == "FromJson") {
    if (!module_imports_std_json(mod)) {
      return [dg_at("E021", "cannot @derive(" + tr + "): the decoder is std/json's; import \"std/json\"", ln, cl)];
    }
    ctys = [];
    let ei: i32 = 0;
    while (ei < ftys.len()) {
      let elem: string = parser.fromjson_elem(ftys[ei]);
      if (parser.fromjson_container(elem).len() > 0 || elem.len() == 0 || elem[0] == b'(' || elem.len() > 3 && slice_unchecked(elem, 0, 3) == "fn(") {
        return [dg_at("E021", "cannot @derive(" + tr + ") for " + tname + ": " + labels[ei] + " has type " + ftys[ei] + "; FromJson decodes a field of a FromJson type, an array of one or an Option of one", ln, cl)];
      }
      ctys = ctys.append(elem);
      ei = ei + 1;
    }
  }
  let fi: i32 = 0;
  while (fi < ctys.len()) {
    let fty: string = receiver_namespace(ctys[fi]);
    let checked: boolean = kind != "Default" || !e021_derive_scalar(fty);
    if (checked && !name_in(fty, tps) && e021_derive_field_known(mod, fty)) {
      if (!e021_derive_conforms(mod, tr, tidx, fty)) {
        return [dg_at("E021", "cannot @derive(" + tr + ") for " + tname + ": " + labels[fi] + " of type " + fty + " does not implement " + tr + " — add `impl " + tr + " for " + fty + "` (or remove the derive)", ln, cl)];
      }
    }
    fi = fi + 1;
  }
  return [];
}

// module_imports_std_json reports whether the module imports std/json, whose
// readers a derived decoder calls.
function module_imports_std_json(mod: parser.Module): boolean {
  for im in mod.imports {
    if (im.path == "std/json") {
      return true;
    }
  }
  return false;
}

// derive_method_name maps a derivable trait kind to the method name its
// synthesised body defines, so a condemned derive can be keyed to the one
// function whose body must not be checked. Kinds outside the field-wise
// set return "" — notably Default, whose synthesis composes zero literals
// and `Type.default()` rather than a call on the field value.
function derive_method_name(kind: string): string {
  if (kind == "Display") {
    return "to_string";
  }
  if (kind == "Debug") {
    return "to_debug";
  }
  if (kind == "Json") {
    return "to_json";
  }
  if (kind == "FromJson") {
    return "from_json_value";
  }
  if (kind == "Eq") {
    return "eq";
  }
  if (kind == "Ord") {
    return "cmp";
  }
  if (kind == "Hash") {
    return "hash";
  }
  if (kind == "Default") {
    return "default";
  }
  return "";
}

// derive_body_suppressed reports whether `fn` is the parse-time-synthesised
// body of a @derive that e021_derive_field_diags already condemned (`keys`
// holds its "Type.method" entries).
//
// Native skips synthesis outright once preCheckDeriveFields fires, so its
// ill-typed body never exists to be checked. This side synthesises at PARSE
// time — before any `impl` is known — and reaches the same end state by
// declining to check the body it has already reported on. Without it the
// synthesised `self.f.to_debug()` stacks a position-less E043 (`struct Bare
// has no field "to_debug"`) in front of the E021 that named the real
// problem, blaming a missing FIELD named after the trait's method.
//
// Only synthesised methods sit at 0:0, so a user-written method of the same
// name on the same type is never matched.
function derive_body_suppressed(fn: parser.FuncDecl, keys: string[]): boolean {
  if (keys.len() == 0) {
    return false;
  }
  if (fn.line != 0 || fn.col != 0) {
    return false;
  }
  if (fn.receiver_type.len() == 0) {
    return false;
  }
  return name_in(fn.receiver_type + "." + fn.name, keys);
}

// e021_derive_field_diags reports E021 (#5392) for a struct/enum
// @derive whose field (variant payload) type does not implement the
// derived trait — the self-host mirror of the native
// checker's preCheckDeriveFields. One diagnostic per (type, trait),
// at the deriving declaration.
//
// Also returns the "Type.method" key of every derive it condemned, for
// derive_body_suppressed to silence the matching synthesised body.
function e021_derive_field_diags(mod: parser.Module): (util.Diag[], string[]) {
  let out: util.Diag[] = [];
  let keys: string[] = [];
  for sd in mod.structs {
    if (sd.enum_owner.len() == 0 && sd.derives.len() > 0) {
      let labels: string[] = [];
      let ftys: string[] = [];
      for field in sd.fields {
        labels = labels.append("field " + field.name);
        ftys = ftys.append(field.type_name);
      }
      for derive in sd.derives {
        let sdd: util.Diag[] = e021_derive_one_diag(mod, derive, sd.name, labels, ftys, sd.type_params, sd.line, sd.col);
        if (sdd.len() > 0) {
          let smn: string = derive_method_name(parser.derive_simple_name(derive));
          if (smn.len() > 0) {
            keys = keys.append(sd.name + "." + smn);
          }
        }
        out = util.append_diags(out, sdd);
      }
    }
  }
  for ed in mod.enums {
    let elabels: string[] = [];
    let eftys: string[] = [];
    let ederives: string[] = [];
    for vs in mod.structs {
      if (vs.enum_owner == ed.name) {
        if (ederives.len() == 0) {
          ederives = vs.derives;
        }
        for field in vs.fields {
          elabels = elabels.append("variant " + vs.name + " payload");
          eftys = eftys.append(field.type_name);
        }
      }
    }
    for ederive in ederives {
      let edd: util.Diag[] = e021_derive_one_diag(mod, ederive, ed.name, elabels, eftys, ed.type_params, ed.line, ed.col);
      if (edd.len() > 0) {
        let emn: string = derive_method_name(parser.derive_simple_name(ederive));
        if (emn.len() > 0) {
          keys = keys.append(ed.name + "." + emn);
        }
      }
      out = util.append_diags(out, edd);
    }
  }
  return (out, keys);
}

// type_ref_mentions_self reports whether `Self` appears anywhere in a decoded
// type spelling: as the whole type, under an array suffix (`Self[]`), as a
// generic argument (`Option[Self]`), or as a tuple member. docs/DYN-TRAITS.md
// §3 states both object-safety rules over exactly that — `Self` ANYWHERE in a
// non-receiver parameter or in the result — not `Self` as the whole type.
//
// Blind to `Self` inside a function type. parse_type_name coarsens a fn type
// to the opaque tag "fn" wherever it is the whole declared type — a parameter,
// a field, a local — before the checker runs, so `(Self) => i32` arrives with
// nothing to walk. Native's mentionsSelf walks a real ast.FuncType and does see
// it; closing that needs the parser to stop coarsening (#7311). A fn as a tuple
// ELEMENT keeps its signature (#7961) and so is walkable here, but that is only
// half of what reporting needs: the self-host draws no E021 object-safety
// diagnostic at all today, for a bare `Self` parameter either.
function type_ref_mentions_self(t: parser.TypeRef): boolean {
  if (t.base == "Self") {
    return true;
  }
  for a in t.args {
    if (type_ref_mentions_self(a)) {
      return true;
    }
  }
  return false;
}

function type_mentions_self(type_name: string): boolean {
  return type_ref_mentions_self(parser.parse_type_ref(type_name));
}

// e021_object_unsafe_method describes a required method that makes
// `trait_name` NOT object-safe (so it can't be used as `dyn T`), or "" when the
// trait is object-safe or unknown. Behind `dyn` the concrete type is erased, so
// a method mentioning `Self` in a non-receiver parameter or in its result has
// no type the call site could produce or check — docs/DYN-TRAITS.md §3 rules 1
// and 2. A GENERIC method is rejected for the neighbouring reason: a vtable
// slot cannot carry an un-monomorphised body.
//
// An ASSOCIATED FUNCTION (no leading `self` receiver) is deliberately NOT a
// reason. It takes no vtable slot to begin with, and calling one through a dyn
// value is separately E021 (#7398), so rejecting the whole trait buys no safety
// and costs every trait that pairs a constructor with dispatchable methods.
// Native's objectSafe has always allowed it; this is the convergent rule.
//
// Conservative: only the trait's ABSTRACT methods (trait_reqs.req_sigs) are
// inspected, so a default method that happens to be object-unsafe is not caught
// here (never a false positive).
function e021_object_unsafe_method(mod: parser.Module, trait_name: string): string {
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      let sigs: parser.FuncDecl[] = trait_req.req_sigs;
      for f in sigs {
        // Skip the receiver: `Self` is what it is FOR. An associated
        // function has none, so every one of its params is checked.
        let i: i32 = 0;
        if (f.params.len() > 0 && f.params[0].name == "self") {
          i = 1;
        }
        while (i < f.params.len()) {
          if (type_mentions_self(f.params[i].type_name)) {
            return "method \"" + f.name + "\" takes Self as a non-receiver parameter";
          }
          i = i + 1;
        }
        if (type_mentions_self(f.ret_type)) {
          return "method \"" + f.name + "\" returns Self";
        }
      }
      return "";
    }
  }
  return "";
}

// e021_dyn_target returns the trait name of a `dyn T` type annotation (the text
// after the `dyn ` prefix), or "" for any non-dyn type. A trailing `[]` (a
// `dyn T[]` array) is stripped so the element trait is classified.
function e021_dyn_target(type_name: string): string {
  if (type_name.len() < 5 || slice_unchecked(type_name, 0, 4) != "dyn ") {
    return "";
  }
  let t: string = e021_dyn_element(type_name);
  // An associated-type PIN list (`dyn Holder[Item = i32]`) or a generic
  // instantiation (`dyn Greet[i32]`) trails the trait name in brackets. The
  // trait NAME is what classifies, so drop it — the pins are read separately
  // by e021_dyn_pin_names. See docs/ASSOCIATED-TYPES.md.
  let cut: i32 = e021_bracket_open(t);
  if (cut > 0) {
    return slice_unchecked(t, 0, cut) + "";
  }
  return t;
}

// e021_dyn_element returns a `dyn ` spelling's tail with every trailing `[]`
// array suffix removed: `dyn Holder[Item = i32][]` gives `Holder[Item = i32]`.
function e021_dyn_element(type_name: string): string {
  let t: str = slice_unchecked(type_name, 4, type_name.len());
  while (t.len() >= 2 && t[t.len() - 2] == b'[' && t[t.len() - 1] == b']') {
    t = slice_unchecked(t, 0, t.len() - 2);
  }
  return t + "";
}

// e021_bracket_open returns the index of the `[` opening the trailing bracket
// group of `t`, or -1 when `t` does not end in one.
function e021_bracket_open(t: string): i32 {
  if (t.len() < 2 || t[t.len() - 1] != b']') {
    return 0 - 1;
  }
  let bal: i32 = 0;
  let i: i32 = t.len() - 1;
  while (i >= 0) {
    if (t[i] == b']') {
      bal = bal + 1;
    } else if (t[i] == b'[') {
      bal = bal - 1;
      if (bal == 0) {
        return i;
      }
    }
    i = i - 1;
  }
  return 0 - 1;
}

// e021_dyn_pin_names returns the associated-type names a dyn spelling PINS.
// Inside the bracket an entry with an `=` is a pin (`Item = i32`); a bare entry
// is a positional generic argument and names nothing. Empty for `dyn T`.
function e021_dyn_pin_names(type_name: string): string[] {
  let out: string[] = [];
  if (type_name.len() < 5 || slice_unchecked(type_name, 0, 4) != "dyn ") {
    return out;
  }
  let t: string = e021_dyn_element(type_name);
  let open: i32 = e021_bracket_open(t);
  if (open < 0) {
    return out;
  }
  let inner: string = slice_unchecked(t, open + 1, t.len() - 1) + "";
  let start: i32 = 0;
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i <= inner.len()) {
    let at_end: boolean = i == inner.len();
    let is_sep: boolean = at_end;
    if (!at_end) {
      let c: u8 = inner[i];
      if (c == b'[') {
        depth = depth + 1;
      }
      if (c == b']') {
        depth = depth - 1;
      }
      if (c == b',' && depth == 0) {
        is_sep = true;
      }
    }
    if (is_sep) {
      let seg: string = slice_unchecked(inner, start, i) + "";
      let eq: i32 = 0 - 1;
      let j: i32 = 0;
      while (j < seg.len()) {
        if (seg[j] == b'=' && eq < 0) {
          eq = j;
        }
        j = j + 1;
      }
      if (eq > 0) {
        out = out.append(util.trim(slice_unchecked(seg, 0, eq) + ""));
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

// e021_object_unsafe_assoc returns the reason `trait_name` cannot be used as
// the given dyn spelling because an associated type is left unpinned, or "".
// Behind `dyn` the concrete type is erased, so an unpinned associated type —
// and any `Self::Item` projection in a method signature — has nothing to
// resolve against at the call site. See docs/ASSOCIATED-TYPES.md.
function e021_object_unsafe_assoc(mod: parser.Module, trait_name: string, dyn_spelling: string): string {
  let pins: string[] = e021_dyn_pin_names(dyn_spelling);
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      for at in trait_req.assoc_types {
        if (!name_in(at, pins)) {
          return "associated type \"" + at + "\" is not pinned — write `dyn " + trait_name + "[" + at + " = ...]`";
        }
      }
      return "";
    }
  }
  return "";
}

// Object safety is reported once per trait at its first unsafe annotation.
function e021_object_safety_diags(mod: parser.Module, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  let seen: string[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    for site in e021_dyn_sites(fn) {
      if (e021_dyn_target(site.spelling).len() == 0) {
        continue;
      }
      for bound in parser.split_plus_bounds(e021_dyn_element(site.spelling)) {
        let spelling: string = util.trim(bound);
        let target_trait: string = parser.parse_type_ref(spelling).base;
        if (util.has_str(seen, target_trait)) {
          continue;
        }
        let reason: string = e021_object_unsafe_assoc(mod, target_trait, "dyn " + spelling);
        if (reason.len() == 0) {
          reason = e021_object_unsafe_method(mod, target_trait);
        }
        if (reason.len() > 0) {
          seen = seen.append(target_trait);
          let name: string = util.demangle(target_trait);
          out = out.append(dg_at("E021", "trait " + name + " is not object-safe: " + reason + ", so it cannot be used as `dyn " + name + "`", site.line, site.col));
        }
      }
    }
  }
  return out;
}

// e021_unknown_dyn_trait_diags is E021 for a trait a `dyn` type names that
// nothing declares, once per trait, in the positions native's
// validateDynTraitTypes walks: a parameter, a return type and a local
// annotation.
function e021_unknown_dyn_trait_diags(mod: parser.Module, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  let seen: string[] = [];
  let imports: string[] = import_paths_of(mod);
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    for site in e021_dyn_trait_sites(fn) {
      let base: string = site.spelling;
      if (!util.has_str(seen, base) && !bound_import_unloaded(base, imports, mod.trait_reqs) && bound_trait_req(base, fn.module, mod.trait_reqs) < 0) {
        seen = seen.append(base);
        out = out.append(dg_at("E021", "unknown trait \"" + util.demangle(bound_trait_display(base, fn.module, mod.trait_reqs)) + "\" in `dyn` type", site.line, site.col));
      }
    }
  }
  return out;
}

// DynSite is a `dyn` spelling and where native reports it: the function for a
// parameter or the return type, the `let` for a local annotation.
struct DynSite { spelling: string, line: i32, col: i32 }

// e021_dyn_trait_sites is every trait a `dyn` type in fn's parameters, return
// type or local annotations names, each `+` entry separately, in the order
// native visits them.
function e021_dyn_sites(fn: parser.FuncDecl): DynSite[] {
  let sites: DynSite[] = [];
  for param in fn.params {
    sites = sites.append(DynSite { spelling: param.type_name, line: fn.line, col: fn.col });
  }
  sites = sites.append(DynSite { spelling: fn.ret_type, line: fn.line, col: fn.col });
  for stmt in fn.body {
    sites = astwalk.fold_stmt_nodes(stmt, sites, e021_dyn_site_at, e021_no_site, astwalk.descend_all);
  }
  return sites;
}

function e021_dyn_trait_sites(fn: parser.FuncDecl): DynSite[] {
  let out: DynSite[] = [];
  for site in e021_dyn_sites(fn) {
    if (e021_dyn_target(site.spelling).len() > 0) {
      for entry in parser.split_plus_bounds(e021_dyn_element(site.spelling)) {
        out = out.append(DynSite { spelling: parser.parse_type_ref(util.trim(entry)).base, line: site.line, col: site.col });
      }
    }
  }
  return out;
}

function e021_dyn_site_at(st: ast.Stmt, own a: DynSite[]): DynSite[] {
  match (st) {
    ast.StmtVar(v) => {
      if (e021_dyn_target(v.type_name).len() > 0) {
        return a.append(DynSite { spelling: v.type_name, line: v.line, col: v.col });
      }
      return a;
    },
    _ => {
      return a;
    }
  }
}

function e021_no_site(e: ast.Expr, own a: DynSite[]): DynSite[] {
  return a;
}

// --- E060 / E062 / E021: dyn downcast target, ambiguous dyn method (#4347),
// --- associated function called through a dyn value (#7398) ----------------
//
// Both checks key on a local/param whose ANNOTATION is a `dyn` type ("dyn A" /
// "dyn A + B") — the self-host checker has no dyn-trait Type (a dyn value
// types `unknown`), so the textual annotation is the authoritative, zero-
// false-positive source of the trait set, exactly like e021_dyn_target's use
// for object-safety. A name annotated dyn MORE than once, or re-declared with
// any other type, is blanked (shadowing could change the set).
// e060_dyn_set_of returns the "A" / "A + B" tail of a dyn annotation, or ""
// for any non-dyn type (a `dyn T[]` ARRAY is excluded — its element, not the
// ident, is the dyn value; neither check applies to the array ident).
function e060_dyn_set_of(type_name: string): string {
  if (type_name.len() < 5 || slice_unchecked(type_name, 0, 4) != "dyn ") {
    return "";
  }
  let t: str = slice_unchecked(type_name, 4, type_name.len());
  if (t.len() >= 2 && t[t.len() - 2] == b'[' && t[t.len() - 1] == b']') {
    return "";
  }
  return t + "";
}

// e060_trait_known: the trait appears in trait_reqs (declared in the merged
// module) — the gate that keeps both checks silent when any trait in the set
// is unknown here (an impl could exist beyond what mod records).
function e060_trait_known(mod: parser.Module, trait_name: string): boolean {
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      return true;
    }
  }
  return false;
}

// e060_trait_declares: trait `trait_name` declares method `m` — its ABSTRACT
// method set only (trait_reqs.methods); a defaulted method isn't recorded, so
// an ambiguity involving one is conservatively missed, never invented.
function e060_trait_declares(mod: parser.Module, trait_name: string, m: string): boolean {
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      return name_in(m, trait_req.methods);
    }
  }
  return false;
}

// e060_collect_dyn_locals records `name|set` for each param / var whose
// annotation is a dyn type; a name bound MORE than once anywhere in the
// function (dyn or not) is blanked to "name|" so shadowing never mislabels a
// value. Assignment (`d = other`) keeps the declared annotation, matching the
// type system.
//
// The set is FLAT across the whole function — nested blocks and lambda bodies
// alike — which is why a rebind blanks rather than scopes. Statement-shaped, so
// it needs fold_stmt_nodes rather than a plain expression fold: a `let`'s name
// and annotation are fields on the statement.
function e060_collect_dyn_locals(stmts: ast.Stmt[], acc: string[]): string[] {
  function at_stmt(st: ast.Stmt, own a: string[]): string[] {
    match (st) {
      ast.StmtVar(v) => {
        let out: string[] = a;
        let seen: i32 = 0;
        let k: i32 = 0;
        while (k < out.len()) {
          let e: string = out[k];
          let bar: i32 = 0;
          while (bar < e.len() && e[bar] != b'|') {
            bar = bar + 1;
          }
          if (slice_unchecked(e, 0, bar) == v.name) {
            out = out.with(k, v.name + "|");
            seen = 1;
          }
          k = k + 1;
        }
        if (seen == 0) {
          out = out.append(v.name + "|" + e060_dyn_set_of(v.type_name));
        }
        return out;
      },
      _ => {
        return a;
      }
    }
  }
  let res: string[] = acc;
  for stmt in stmts {
    res = astwalk.fold_stmt_nodes(stmt, res, at_stmt, (e: ast.Expr, own a: string[]) => a, astwalk.descend_all);
  }
  return res;
}

// e060_set_of_name looks `name` up in the collected `name|set` entries.
function e060_set_of_name(dyns: string[], name: string): string {
  for dy in dyns {
    let e: string = dy;
    let bar: i32 = 0;
    while (bar < e.len() && e[bar] != b'|') {
      bar = bar + 1;
    }
    if (slice_unchecked(e, 0, bar) == name) {
      return slice_unchecked(e, bar + 1, e.len()) + "";
    }
  }
  return "";
}

// e060_is_primitive_name: a spelling that can NEVER be a struct/enum — the
// definitely-wrong `as?` targets the target-shape arm flags. Mirrors the
// zero-false-positive primitive gates of E033/E042/E059.
function e060_is_primitive_name(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u8" || t == "u32" || t == "u64" || t == "f32" || t == "f64" || t == "boolean" || t == "string" || t == "str" || t == "usize" || t == "char";
}

// e060_e062_stmts walks every statement in `stmts`, flagging at each
// expression node:
//   E060 — `d as? T` where d is a dyn-annotated ident: T a primitive → the
//   target-shape arm; T a declared plain struct / enum missing an `impl` for
//   any trait in d's set (every trait known) → the not-implementing arm, with
//   the missing traits joined " + " exactly like native's missingDynTraits.
//   E062 — `d.m(args)` where d's set has 2+ traits and 2+ of them declare m.
//   E021 — `d.m(args)` where m is an ASSOCIATED (receiver-less) requirement of
//   a trait in d's set: nothing can dispatch it through the erased Self.
//
// The recursion is astwalk's, so the checks reach every expression kind the
// shared spine knows. The hand-written walk this replaced listed nine kinds and
// dropped the rest on a `_ => {}` arm, which silently excused a downcast inside
// a lambda body or a slice bound — native reports both, since it checks these
// on its ordinary type-check traversal.
//
// ExprMapLit and ExprFString were dropped too and cost nothing: both reach only
// the printer, every other parse having desugared them (parser.fern:150-162).
// A dropped variant is a hole only if it REACHES this pass.
function e060_e062_stmts(stmts: ast.Stmt[], dyns: string[], mod: parser.Module, acc: util.Diag[]): util.Diag[] {
  function at_node(n: ast.Expr, own out: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprUnary(u) => {
        if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
          match (u.operand) {
            ast.ExprIdent(id) => {
              let set: string = e060_set_of_name(dyns, id.name);
              if (set.len() > 0) {
                let tgt: str = slice_unchecked(u.op, 4, u.op.len());
                if (e060_is_primitive_name(tgt)) {
                  return out.append(dg_at("E060", "'as?' downcast target must be a concrete struct or enum type (slice 1), got " + tgt, u.line, u.col));
                }
                if (e060_decl_is_plain_struct(mod, tgt) || e060_decl_is_enum(mod, tgt)) {
                  let trs: string[] = parser.dyn_trait_set("dyn " + set);
                  let all_known: boolean = true;
                  let missing: string = "";
                  for tr in trs {
                    if (!e060_trait_known(mod, tr)) {
                      all_known = false;
                    } else if (!e021_has_impl(mod, tr, tgt)) {
                      if (missing.len() > 0) {
                        missing = missing + " + ";
                      }
                      missing = missing + tr;
                    }
                  }
                  if (all_known && missing.len() > 0) {
                    return out.append(dg_at("E060", tgt + " does not implement " + missing + ", so a 'dyn " + set + "' cannot downcast to it", u.line, u.col));
                  }
                }
              }
            },
            _ => {}
          }
        }
        return out;
      },
      ast.ExprCall(c) => {
        match (c.callee) {
          ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
              ast.ExprIdent(rid) => {
                let rset: string = e060_set_of_name(dyns, rid.name);
                if (rset.len() > 0) {
                  let rtrs: string[] = parser.dyn_trait_set("dyn " + rset);
                  let declaring: string = "";
                  let n_decl: i32 = 0;
                  for rtr in rtrs {
                    if (e060_trait_declares(mod, rtr, fa.field)) {
                      if (n_decl > 0) {
                        declaring = declaring + ", ";
                      }
                      declaring = declaring + rtr;
                      n_decl = n_decl + 1;
                    }
                  }
                  if (rtrs.len() >= 2 && n_decl >= 2) {
                    return out.append(dg_at("E062", "ambiguous method \"" + fa.field + "\" on `dyn " + rset + "`: declared by traits " + declaring, fa.line, fa.col));
                  }
                  let assoc_owner: string = "";
                  for atr in rtrs {
                    if (assoc_owner.len() == 0) {
                      let ah: AssocHit = trait_assoc_req(mod.trait_reqs, atr, fa.field, []);
                      if (ah.found) {
                        assoc_owner = ah.owner;
                      }
                    }
                  }
                  if (assoc_owner.len() > 0) {
                    return out.append(dg_at("E021", "\"" + fa.field + "\" is an associated function of trait " + assoc_owner + ", not a method; it has no `self` receiver, so it cannot be called through a `dyn " + rset + "` value — call it on a concrete type", fa.line, fa.col));
                  }
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
        return out;
      },
      _ => {
        return out;
      }
    }
    return out;
  }
  let res: util.Diag[] = acc;
  for stmt in stmts {
    res = astwalk.fold_stmt(stmt, res, at_node);
  }
  return res;
}

// e060_decl_is_plain_struct: `name` is a declared plain struct (a decl by that
// name with NO enum_owner — a variant decl records its owner, and must not be
// admitted as an `as?` target here; native reports variants differently).
function e060_decl_is_plain_struct(mod: parser.Module, name: string): boolean {
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return true;
    }
  }
  return false;
}

// e060_decl_is_enum: `name` is a declared enum (some decl records it as its
// enum_owner) — mirrors irtables.decl_is_enum.
function e060_decl_is_enum(mod: parser.Module, name: string): boolean {
  if (name.len() == 0) {
    return false;
  }
  for sd in mod.structs {
    if (sd.enum_owner == name) {
      return true;
    }
  }
  return false;
}

// e060_e062_diags: per function, collect the dyn-annotated params/locals then
// walk the body for the two expression-level checks.
function e060_e062_diags(mod: parser.Module, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    let dyns: string[] = [];
    for param in fn.params {
      dyns = dyns.append(param.name + "|" + e060_dyn_set_of(param.type_name));
    }
    dyns = e060_collect_dyn_locals(fn.body, dyns);
    out = e060_e062_stmts(fn.body, dyns, mod, out);
  }
  return out;
}

// map_import_msg is the missing-`core/map` text, written once because the rule
// that emits it and the pass that thins it to one diagnostic both name it.
function map_import_msg(): string {
  return "Map operations require `import \"core/map\";`";
}

// thin_map_import_diags keeps only the FIRST missing-`core/map` diagnostic.
// Map's helpers all come from the one module, so one report covers every use;
// native keeps it to one with a checker-level flag, which this pure walk has
// no equivalent of, so it drops the repeats on the way out instead.
function thin_map_import_diags(ds: util.Diag[]): util.Diag[] {
  let msg: string = map_import_msg();
  let seen: boolean = false;
  let out: util.Diag[] = [];
  for d in ds {
    if (d.code == "E001" && d.message == msg) {
      if (seen) {
        continue;
      }
      seen = true;
    }
    out = out.append(d);
  }
  return out;
}

// Inst is one instantiation of a generic free function: the template, the
// concrete spelling of each of its type parameters, and how many clones deep
// the call that asked for it sits.
struct Inst { name: string, cts: string[], depth: i32 }

// max_inst_depth bounds the instantiation worklist, as native bounds its
// generic-struct rounds: `f[T](x: T)` calling `f([x])` asks for a new clone at
// every depth.
function max_inst_depth(): i32 {
  return 64;
}

// spellable reports whether `t` can be written back as an annotation a clone
// carries: an unknown, an erased variable, and a callable (type_label prints no
// parameter list for one) cannot.
function spellable(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return false;
    },
    typeinfo.TypeErased(_) => {
      return false;
    },
    typeinfo.TypeFunc(_) => {
      return false;
    },
    typeinfo.TypeVoid(_) => {
      return false;
    },
    typeinfo.TypeArray(a) => {
      return spellable(a.elem);
    },
    typeinfo.TypeMap(m) => {
      return spellable(m.key) && spellable(m.value);
    },
    typeinfo.TypeTuple(tp) => {
      for elem in tp.elements {
        if (!spellable(elem)) {
          return false;
        }
      }
      return true;
    },
    typeinfo.TypeStruct(sd) => {
      for arg in sd.args {
        if (!spellable(arg)) {
          return false;
        }
      }
      return true;
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        if (!spellable(arg)) {
          return false;
        }
      }
      return true;
    },
    _ => {
      return true;
    }
  }
  return true;
}

function template_index(gens: parser.FuncDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < gens.len()) {
    if (gens[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// call_inst is the instantiation a call to a generic free function asks for,
// or one with an empty name when the callee is not one or a type parameter
// stays unbound or unspellable.
function call_inst(c: ast.ExprCall, s: Scope, gens: parser.FuncDecl[], depth: i32): Inst {
  let none: Inst = Inst { name: "", cts: [], depth: depth };
  if let ast.ExprIdent(id) = c.callee {
    if (s.defines(id.name)) {
      return none;
    }
    let sig: FuncSig = s.lookup_sig(id.name);
    if (sig.all_type_params.len() == 0) {
      return none;
    }
    let gi: i32 = template_index(gens, id.name);
    if (gi < 0) {
      return none;
    }
    let (bn, bt) = call_type_bindings(sig, c, s);
    let cts: string[] = [];
    for tp in gens[gi].all_type_params {
      let k: i32 = util.index_of_str(bn, tp);
      if (k < 0 || !spellable(bt[k])) {
        return none;
      }
      cts = cts.append(type_label(bt[k]));
    }
    return Inst { name: id.name, cts: cts, depth: depth };
  }
  return none;
}

// fn_value_inst is the instantiation a generic free function named as a value
// asks for where the callable `dest` is expected, or one with an empty name when
// `e` names no such function or `dest` leaves a type parameter unbound or
// unspellable. The monomorphiser clones such a use (parser.mono_fn_value), so
// the clone is checked as a call's would be.
function fn_value_inst(e: ast.Expr, dest: typeinfo.Type, s: Scope, gens: parser.FuncDecl[], depth: i32): Inst {
  let none: Inst = Inst { name: "", cts: [], depth: depth };
  let ast.ExprIdent(id) = e else {
    return none;
  };
  let typeinfo.TypeFunc(df) = dest else {
    return none;
  };
  let gi: i32 = template_index(gens, id.name);
  if (gi < 0 || !generic_fn_value_arg(e, s)) {
    return none;
  }
  let (bn, bt) = fn_value_binds(s.lookup_sig(id.name), df, s);
  let cts: string[] = [];
  for tp in gens[gi].all_type_params {
    let k: i32 = util.index_of_str(bn, tp);
    if (k < 0 || !spellable(bt[k])) {
      return none;
    }
    cts = cts.append(type_label(bt[k]));
  }
  return Inst { name: id.name, cts: cts, depth: depth };
}

// arg_value_insts appends the instantiations the arguments of `c` that name a
// generic function as a value ask for, each against the parameter it is passed
// to.
function arg_value_insts(c: ast.ExprCall, s: Scope, gens: parser.FuncDecl[], depth: i32, own acc: Inst[]): Inst[] {
  let needs_dest: boolean = false;
  for a in c.args {
    if (generic_fn_value_arg(a, s)) {
      needs_dest = true;
    }
  }
  if (!needs_dest) {
    return acc;
  }
  if let ast.ExprIdent(cid) = c.callee {
    if (s.defines(cid.name)) {
      return acc;
    }
  }
  let dests: typeinfo.Type[] = s.call_param_types(c);
  let out: Inst[] = acc;
  let i: i32 = 0;
  while (i < c.args.len() && i < dests.len()) {
    if (generic_fn_value_arg(c.args[i], s)) {
      let inst: Inst = fn_value_inst(c.args[i], bound_param_dest(c, i, dests[i], s), s, gens, depth);
      if (inst.name.len() > 0) {
        out = out.append(inst);
      }
    }
    i = i + 1;
  }
  return out;
}

// calls_a_generic is the syntactic test that lets a body with no call to a
// generic free function skip inst_stmts, which types every statement. A
// generic function named as a value counts: it is instantiated where it is
// passed.
function calls_a_generic(stmts: ast.Stmt[], s: Scope): boolean {
  function at_call(n: ast.Expr, own hit: boolean): boolean {
    if (hit) {
      return true;
    }
    if let ast.ExprCall(c) = n {
      if let ast.ExprIdent(id) = c.callee {
        if (s.lookup_sig(id.name).all_type_params.len() > 0) {
          return true;
        }
      }
      for a in c.args {
        if (generic_fn_value_arg(a, s)) {
          return true;
        }
      }
    }
    return false;
  }
  let hit: boolean = false;
  for st in stmts {
    hit = astwalk.fold_stmt(st, hit, at_call);
  }
  return hit;
}

// inst_stmts collects the instantiations the calls in `stmts` ask for,
// scope-threaded so an argument's type is the one the checker gives it there.
function inst_stmts(stmts: ast.Stmt[], s: Scope, gens: parser.FuncDecl[], depth: i32, acc: Inst[]): Inst[] {
  let out: Inst[] = acc;
  let cur: Scope = s;
  for st in stmts {
    out = inst_stmt(st, cur, gens, depth, out);
    cur = bind_stmt(st, cur);
  }
  return out;
}

function inst_stmt(st: ast.Stmt, cur: Scope, gens: parser.FuncDecl[], depth: i32, own acc: Inst[]): Inst[] {
  function at_node(n: ast.Expr, own a: Inst[]): Inst[] {
    match (n) {
      ast.ExprCall(c) => {
        let inst: Inst = call_inst(c, cur, gens, depth);
        let out: Inst[] = arg_value_insts(c, cur, gens, depth, a);
        if (inst.name.len() > 0) {
          return out.append(inst);
        }
        return out;
      },
      ast.ExprLambda(lm) => {
        return inst_stmts(lm.body, lambda_body_scope(lm, cur), gens, depth, a);
      },
      _ => {
        return a;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    if let ast.ExprLambda(_) = n {
      return false;
    }
    return true;
  }
  let out: Inst[] = astwalk.fold_stmt_own_pruned(st, acc, at_node, not_into_lambda);
  match (st) {
    ast.StmtIf(f) => {
      out = inst_stmts(f.then_body, cur, gens, depth, out);
      out = inst_stmts(f.else_body, cur, gens, depth, out);
    },
    ast.StmtWhile(w) => {
      out = inst_stmts(w.body, cur, gens, depth, out);
    },
    ast.StmtFor(fr) => {
      out = inst_stmts(fr.body, for_body_scope(fr, cur), gens, depth, out);
    },
    ast.StmtMatch(m) => {
      let whole: typeinfo.Type = check_expr(m.scrutinee, cur);
      for arm in m.arms {
        out = inst_stmts(arm.body, annotate_arm_scope(arm, cur, whole), gens, depth, out);
      }
    },
    ast.StmtDefer(d) => {
      let one: ast.Stmt[] = [d.action];
      out = inst_stmts(one, cur, gens, depth, out);
    },
    _ => {}
  }
  return out;
}

// instantiated_clones is native's monomorphisation as far as the checker needs
// it: one concrete copy of a generic free function per instantiation reachable
// from non-generic code, following the copies' own calls. Native re-checks
// what monomorphisation produced, so a type a rule refuses when written — a
// `Map[T, i32]` at T = f64 — is refused when an instantiation produces it.
function instantiated_clones(mod: parser.Module, env: ModuleEnv): parser.FuncDecl[] {
  let clones: parser.FuncDecl[] = [];
  let gens: parser.FuncDecl[] = [];
  for fd in mod.funcs {
    if (fd.receiver_name.len() == 0 && fd.all_type_params.len() > 0) {
      gens = gens.append(fd);
    }
  }
  if (gens.len() == 0) {
    return clones;
  }
  let msc: Scope = new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  let mf: parser.MFns = parser.mfns_of(mod.funcs, mod.structs, mod.enums, mod.impls);
  let pending: Inst[] = [];
  for fd in mod.funcs {
    if (fd.all_type_params.len() == 0) {
      pending = body_insts(fd, env, msc, gens, 0, pending);
    }
  }
  if (calls_a_generic(mod.top_stmts, msc)) {
    pending = inst_stmts(mod.top_stmts, msc, gens, 0, pending);
  }
  let keys: string[] = [];
  let wi: i32 = 0;
  while (wi < pending.len()) {
    let inst: Inst = pending[wi];
    wi = wi + 1;
    let spelled: string = "";
    for ct in inst.cts {
      if (spelled.len() > 0) {
        spelled = spelled + ";";
      }
      spelled = spelled + ct;
    }
    let key: string = inst.name + "__" + parser.sanitize_key(spelled);
    if (inst.depth >= max_inst_depth() || util.has_str(keys, key)) {
      continue;
    }
    keys = keys.append(key);
    let g: parser.FuncDecl = gens[template_index(gens, inst.name)];
    let routed: parser.FuncDecl = parser.FuncDecl { ...g, body: parser.route_bound_calls(g, inst.cts, env.trait_reqs, mf) };
    let cl: parser.FuncDecl = parser.instantiate_func(routed, key, g.all_type_params, inst.cts, mod.impls);
    clones = clones.append(cl);
    pending = body_insts(cl, env, msc, gens, inst.depth + 1, pending);
  }
  return clones;
}

function body_insts(fd: parser.FuncDecl, env: ModuleEnv, msc: Scope, gens: parser.FuncDecl[], depth: i32, acc: Inst[]): Inst[] {
  if (!calls_a_generic(fd.body, msc)) {
    return acc;
  }
  return inst_stmts(fd.body, build_func_scope(fd, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs), gens, depth, acc);
}

// check_module checks a module and then, when that is clean, the concrete
// copies of its generics — the order native's check and monomorph re-check
// run in, so an instantiation's diagnostics are reported only for a program
// whose templates passed.
pub function check_module(raw_mod: parser.Module): ModuleTypes {
  return check_module_with_file(raw_mod, "");
}

pub function check_module_with_file(raw_mod: parser.Module, entry_file: string): ModuleTypes {
  return check_module_raw_floor(raw_mod, entry_file, false);
}

// Generated runtime source has an explicit checker entry for its raw floor.
// Source admission keeps that private catalog disabled.
function admission_env(mod: parser.Module, entry_file: string, raw_floor: boolean): ModuleEnv {
  let env: ModuleEnv = module_env_with_file(mod, entry_file);
  if (raw_floor) {
    return env;
  }
  return ModuleEnv { ...env, sigs: SigTable { ...env.sigs, raw_allowed: false } };
}

function check_module_raw_floor(raw_mod: parser.Module, entry_file: string, raw_floor: boolean): ModuleTypes {
  // Native's checker resolves named arguments and fills omitted defaults
  // before it types anything, and reports what does not resolve (E076 /
  // E077 / E004) as its first diagnostics. Filling here rather than in each
  // driver means a defaulted call arrives complete however this checker is
  // reached, and a driver that already filled sees the same diagnostics again
  // because a call that did not resolve was left as written.
  let (filled, fda_diags) = parser.fill_default_args_with_diags(raw_mod);
  let mod: parser.Module = prepared_module(filled);
  let env: ModuleEnv = admission_env(mod, entry_file, raw_floor);
  let mt: ModuleTypes = check_module_pass(mod, env, fda_diags, []);
  if (mt.diags.len() > 0) {
    return mt;
  }
  let clones: parser.FuncDecl[] = instantiated_clones(mod, env);
  if (clones.len() == 0) {
    return mt;
  }
  let funcs: parser.FuncDecl[] = mod.funcs;
  let names: string[] = [];
  for cl in clones {
    funcs = funcs.append(cl);
    names = names.append(cl.name);
  }
  let cmod: parser.Module = parser.Module { ...mod, funcs: funcs };
  let rt: ModuleTypes = check_module_pass(cmod, admission_env(cmod, entry_file, raw_floor), [], names);
  if (rt.diags.len() == 0) {
    return mt;
  }
  return ModuleTypes { ...mt, all_well_typed: false, diags: rt.diags };
}

// in_focus: a pass with a non-empty `focus` walks only the bodies it names.
// The re-check over a clean module's clones names them, since every other body
// already answered.
function in_focus(focus: util.NameIndex, fd: parser.FuncDecl): boolean {
  return focus.names.len() == 0 || focus.find(fd.name) >= 0;
}

// prepared_module is a default-filled module as the checker types it.
function prepared_module(filled: parser.Module): parser.Module {
  // A value block's local is declared from the first arm's syntax alone
  // (parser.if_expr_rt), and a `use` binding from nothing at all; re-declare
  // both from the types the program spells before anything is typed against
  // them, or a legal `string` / `i64` arm value reads as a store into an i32
  // (#8657) and the binding reads as unknown. Lowering gets the same rewrite
  // through annotate_module, and both first get each literal local's type
  // (#10123).
  let revalued: parser.Module = pretype_module(settle_literal_locals(filled));
  // The built-in struct declarations (Stream, HeaderMap, the
  // std/time types, …) are injected into the struct table, not written in any
  // source, so a checker reading `mod.structs` as parsed sees only the
  // reserved NAMES and reports E064 / E021 against every use of one. Native
  // registers the same decls before it types anything; this is that
  // registration.
  return parser.Module { ...revalued, structs: parser.inject_builtin_enums(revalued.structs) };
}

// check_module_pass types a prepared module against its tables, `env`, which
// module_env built from it; `fda_diags` are the default filling's diagnostics,
// reported first.
function check_module_pass(mod: parser.Module, env: ModuleEnv, fda_diags: util.Diag[], focus_names: string[]): ModuleTypes {
  let focus: util.NameIndex = util.name_index(focus_names);
  let imports: Imports = env.imports;
  let rnames: string[] = env.structs.resources.names;
  let st: SigTable = env.sigs;
  let stt: StructTable = env.structs;
  let ut: UnionTable = env.unions;
  let methods: MethodTable = env.methods;
  let sigs: FuncSig[] = st.sigs;
  let structs: StructSig[] = stt.structs;
  let unions: UnionSig[] = ut.unions;
  let union_names: string[] = ut.index.names;
  let well_typed: boolean = true;
  if (!validate_union_sigs(unions, stt.index.names)) {
    well_typed = false;
  }
  let body_diags: util.Diag[] = [];
  let ambig: string[] = ambiguous_variants(ut);
  // E067 runs only when the module declares a @must_consume type — the
  // fast path that keeps the obligation walk free for unmarked modules
  // (e.g. the self-host compiler's own sources).
  let mc_on: boolean = mc_any_marked(mod.structs, mod.enums);
  // Hoisted above the body loop: its condemned-derive keys decide which
  // parse-time-synthesised bodies to skip (derive_body_suppressed). The
  // diagnostics themselves are folded into `dd` below, unchanged.
  let (derive_diags, derive_keys) = e021_derive_field_diags(mod);
  // E063's callee route needs to know which parameter positions each
  // slice-returning function's returns may view before it can chase a
  // call into its arguments, so the summaries settle to a fixpoint
  // first. Every function is summarised rather than only the ones whose
  // declared return spelling looks like a slice: an inferred-return body
  // can hand one back too, which is why the walk below runs unfiltered.
  let call_impls: parser.ImplInfo[] = env.impls;
  let slc_fns: parser.FuncDecl[] = [];
  let slc_scopes: Scope[] = [];
  let slc_sums: ViewSum[] = [];
  for cfn in mod.funcs {
    slc_fns = slc_fns.append(cfn);
    slc_scopes = slc_scopes.append(build_func_scope(cfn, st, stt, ut, methods, imports, call_impls, mod.trait_reqs));
    slc_sums = slc_sums.append(ViewSum { key: view_sum_key(cfn), flags: __alloc_bool(view_positions(cfn).len()), fresh: false });
  }
  let slc_ix: ViewIndex = view_index(slc_sums);
  // A summary reads its callees' summaries (view_callee) and only ever
  // gains a flag, so after the first round
  // only a function calling a name whose summary changed in the last round
  // can change its own: each round walks those, told apart by the call
  // names collected off each body once.
  let slc_calls: util.NameIndex[] = [];
  for cfn in mod.funcs {
    slc_calls = slc_calls.append(util.name_index(slc_call_names(cfn)));
  }
  let slc_no_names: string[] = [];
  let slc_marked: util.NameIndex = util.name_index(slc_no_names);
  let slc_first: boolean = true;
  while (slc_first || slc_marked.names.len() > 0) {
    let slc_now: string[] = [];
    let sj: i32 = 0;
    while (sj < slc_fns.len()) {
      if (!slc_first && !slc_calls_any(slc_calls[sj], slc_marked)) {
        sj = sj + 1;
        continue;
      }
      let sjw: SlcWalk = slice_escape_diags(slc_fns[sj], slc_scopes[sj], slc_sums, slc_ix);
      let slc_positions: string[] = view_positions(slc_fns[sj]);
      let slc_cur: ViewSum = slc_sums[sj];
      let slc_next: boolean[] = slc_cur.flags;
      let slc_changed: boolean = false;
      let sp: i32 = 0;
      while (sp < slc_positions.len() && sp < slc_next.len()) {
        if (!slc_next[sp] && name_in(slc_positions[sp], sjw.viewed)) {
          slc_next = slc_next.with(sp, true);
          slc_changed = true;
        }
        sp = sp + 1;
      }
      // Storage the function BUILT and hands back by value belongs to
      // the CALLER's frame, so a slice of the result dangles there. A
      // `[T]` return in the same shape is reported where it stands, so
      // only an owned return is marked.
      let slc_fresh: boolean = slc_cur.fresh;
      if (!slc_fresh && sjw.owns) {
        slc_fresh = true;
        slc_changed = true;
      }
      if (slc_changed) {
        slc_now = slc_now.append(slc_fns[sj].name);
      }
      slc_sums = slc_sums.with(sj, ViewSum { key: slc_cur.key, flags: slc_next, fresh: slc_fresh });
      sj = sj + 1;
    }
    slc_first = false;
    slc_marked = util.name_index(slc_now);
  }
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    if (!in_focus(focus, mod.funcs[i]) || derive_body_suppressed(mod.funcs[i], derive_keys)) {
      i = i + 1;
      continue;
    }
    // The view-summary pass built the same initial scope for this body.
    // Every diagnostic pass threads its own bindings from that scope.
    let fsc: Scope = slc_scopes[i];
    if (!check_func_body(mod.funcs[i], fsc)) {
      well_typed = false;
    }
    let dbody: ast.Stmt[] = mod.funcs[i].body;
    let function_diags: util.Diag[] = [];
    // E002: return-type mismatch, per function (recursing into nested
    // blocks). Only meaningful when a return type is declared.
    if (mod.funcs[i].ret_type == "void") {
      // A `void` function returns nothing: it needs no `return` (so no
      // E052 — falling off the end is the normal exit) and must not
      // return a value (E002 on any `return <expr>;`). Matches the Go
      // checker, which treats void specially on both fronts.
      function_diags = util.append_diags(function_diags, void_ret_diags(dbody, fsc, unions));
    } else if (mod.funcs[i].ret_type.len() > 0) {
      // A return type naming no declared type (the E064 case) takes no value,
      // so each typed `return` is E002 beside the E064, as an annotated
      // binding's init is E003 (#10842).
      let rty: typeinfo.Type = fsc.ret_type;
      let rname: string = mod.funcs[i].ret_type;
      if (is_unknown(rty) && util.index_of_str(fsc.tparams, rname) < 0 && e064_unknown_bare(rname, fsc.type_names())) {
        rty = typeinfo.TypeStruct { name: rname, args: [] };
      }
      function_diags = util.append_diags(function_diags, ret_diags(dbody, fsc, rty, unions));
      // E052: a non-void function whose body can fall off the end
      // without returning, reported at the function declaration.
      //
      // An `@import` declaration is exempt: it legitimately has no body
      // (the host supplies it), and native skips the walk on a nil body
      // for the same reason. The empty body of `function f(): i32 { }`
      // is NOT exempt — an absent body and an empty one are the same
      // array here, so the import attribute is what separates them.
      if (mod.funcs[i].import_iface.len() == 0 && !block_exits(mod.funcs[i].body)) {
        function_diags = function_diags.append(dg_at("E052", "missing return: \"" + mod.funcs[i].name + "\" has return type " + mod.funcs[i].ret_type + " but can fall off the end without returning a value", mod.funcs[i].line, mod.funcs[i].col));
      }
    }
    // Missing annotations remain errors. Infer exits for recovery so a `?`
    // failure edge can still make a fallthrough non-void, as in the oracle.
    if (mod.funcs[i].ret_type.len() == 0 && mod.funcs[i].receiver_type.len() == 0
      && mod.funcs[i].all_type_params.len() == 0 && !mod.funcs[i].is_const
      && mod.funcs[i].import_iface.len() == 0 && !block_exits(dbody)) {
      let inferred: typeinfo.Type = exit_result(dbody, fsc);
      if (!is_unknown(inferred) && !is_void(inferred)) {
        function_diags = function_diags.append(dg_at("E052", "missing return: \"" + mod.funcs[i].name + "\" has return type " + type_label(inferred) + " but can fall off the end without returning a value", mod.funcs[i].line, mod.funcs[i].col));
      }
    }
    // E063: returning a `[T]` slice that views function-local storage
    // (a use-after-free once the frame is reclaimed). Only a `[T]`
    // return is reported against, even though every function is
    // summarised above: an owned `T[]` return MOVES its storage to the
    // caller, so it cannot dangle. Reporting on both flags every
    // `T[]`-returning function that hands a local array back — a move,
    // and legal — which is what bigint / sort / cmp / unicode do.
    if (parser.spelling_is_view(mod.funcs[i].ret_type)) {
      function_diags = util.append_diags(function_diags, slice_escape_diags(mod.funcs[i], fsc, slc_sums, slc_ix).diags);
    }
    // E067: a value of a @must_consume struct/enum type must be consumed
    // on every path before its binding leaves scope (the native
    // checkMustConsume — docs/MUST-CONSUME.md).
    if (mc_on) {
      function_diags = util.append_diags(function_diags, must_consume_diags(mod.funcs[i], fsc, mod.structs, mod.enums));
    }
    // E002 (lambda bodies): return-type mismatch inside a lambda is
    // checked against the lambda's own declared return type, not the
    // enclosing function's. Runs for every function (even void ones —
    // a lambda can be declared anywhere), scope-threaded so a lambda
    // sees earlier locals.
    function_diags = util.append_diags(function_diags, lret_stmts(dbody, fsc, unions));
    // E031: match/if-expression arms must have compatible types
    // (scope-threaded so an arm sees earlier locals + its payload).
    function_diags = util.append_diags(function_diags, mx_stmts(dbody, fsc, unions, mod.enums));
    // E005: struct literal missing a declared field (any expression in
    // the body, struct table is module-global so no scope needed).
    function_diags = util.append_diags(function_diags, stmts_slit_diags(dbody, stt));
    // E004: free-function call arity (scope-threaded so a shadowing
    // local isn't mistaken for the function).
    function_diags = util.append_diags(function_diags, stmts_call_diags(dbody, fsc));
    // E003: assignment / annotated-var type mismatch (scope-threaded).
    function_diags = util.append_diags(function_diags, stmts_assign_diags(dbody, fsc, unions));
    // E011 / E058: break / continue outside a loop, and a labeled
    // break/continue whose label names no enclosing loop (structural).
    function_diags = util.append_diags(function_diags, loop_diags(dbody, false, []));
    // E013: duplicate `let` in the same block (structural, no scope).
    function_diags = util.append_diags(function_diags, dupvar_diags(dbody));
    // E047: a typed-suffix integer literal outside its suffix's range.
    function_diags = util.append_diags(function_diags, suffix_range_stmts(dbody));
    // E026 / E028: structural match-arm errors (wildcard order, dup
    // variant).
    function_diags = util.append_diags(function_diags, match_diags(dbody, stt, ut));
    // P002 in a parameter's DEFAULT value. Nothing evaluates a default
    // until a call site omits the argument, so it sits outside the body
    // walk above — but native rejects the literal at parse time whether
    // the default is ever reached or not (#6842). Filtered to that code:
    // the walk's other rules are written for a body, not for an
    // un-called default expression.
    let pdi: i32 = 0;
    while (pdi < mod.funcs[i].params.len()) {
      if (mod.funcs[i].params[pdi].has_default) {
        function_diags = util.append_diags(function_diags, keep_code(mx_expr(mod.funcs[i].params[pdi].default_value, new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs), unions, mod.enums), "P002"));
      }
      pdi = pdi + 1;
    }
    // E019: explicit type-argument arity on a generic-struct reference
    // in a parameter type.
    let pai2: i32 = 0;
    while (pai2 < mod.funcs[i].params.len()) {
      function_diags = util.append_diags(function_diags, type_arity_diag(mod.funcs[i].params[pai2].type_name, mod.structs, mod.enums));
      pai2 = pai2 + 1;
    }
    function_diags = util.append_diags(function_diags, type_arity_diag(mod.funcs[i].ret_type, mod.structs, mod.enums));
    for annot in collect_annots(mod.funcs[i].body) {
      function_diags = util.append_diags(function_diags, type_arity_diag(annot.type_name, mod.structs, mod.enums));
    }
    // E036: unqualified reference to a variant shared by 2+ enums.
    if (ambig.len() > 0) {
      function_diags = util.append_diags(function_diags, vref_stmts(dbody, fsc, ambig));
    }
    body_diags = util.append_diags(body_diags, body_source_order(function_diags));
    i = i + 1;
  }
  let s: Scope = new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
  let top_tys: typeinfo.Type[] = [];
  for top_stmt in mod.top_stmts {
    let r: CheckResult = check_stmt(top_stmt, s);
    s = r.scope;
    if (is_unknown(r.ty)) {
      well_typed = false;
    }
    top_tys = top_tys.append(r.ty);
  }
  let dtop: ast.Stmt[] = mod.top_stmts;
  // A BARE module scope, not the `s` above: each pass re-threads the top-level
  // bindings itself, and `s` has already accumulated all of them.
  let tsc: Scope = new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
  body_diags = util.append_diags(body_diags, lret_stmts(dtop, tsc, unions));
  body_diags = util.append_diags(body_diags, mx_stmts(dtop, tsc, unions, mod.enums));
  body_diags = util.append_diags(body_diags, stmts_slit_diags(dtop, stt));
  body_diags = util.append_diags(body_diags, stmts_call_diags(dtop, tsc));
  body_diags = util.append_diags(body_diags, stmts_assign_diags(dtop, tsc, unions));
  if (ambig.len() > 0) {
    body_diags = util.append_diags(body_diags, vref_stmts(dtop, tsc, ambig));
  }
  body_diags = util.append_diags(body_diags, loop_diags(dtop, false, []));
  body_diags = util.append_diags(body_diags, dupvar_diags(dtop));
  body_diags = util.append_diags(body_diags, suffix_range_stmts(dtop));
  body_diags = util.append_diags(body_diags, match_diags(dtop, stt, ut));
  if (is_script(mod)) {
    body_diags = util.append_diags(body_diags, ret_diags(dtop, tsc, t_i32(), unions));
  }
  // E019: generic-struct type-argument arity in struct field types.
  for sd in mod.structs {
    for field in sd.fields {
      body_diags = util.append_diags(body_diags, type_arity_diag(field.type_name, mod.structs, mod.enums));
    }
  }
  // E064: a type annotation that names no declared type (the self-host
  // counterpart of the native checker's unknown-type rule). Scoped to bare
  // identifiers in NON-generic, NON-method functions and NON-generic,
  // NON-enum-variant structs — contexts with no type parameter in scope —
  // so a genuine typo (`let x: Wibble`) is reported while an erased generic
  // parameter is never mistaken for one. Resolves against the same struct +
  // union/enum name sets the rest of check_module uses.
  // Known-in-another-role names for the E064 generic-BASE check: declared
  // trait names (via requirement records and impl headers) and resource
  // names. The Go checker's knownTypeName accepts any declared struct /
  // enum / trait / resource, so the base check must not flag these.
  let signature_diags: util.Diag[] = [];
  let e064_extra: string[] = [];
  // e064_traits spells each trait as a parameter type reaches here: bare for
  // the entry's own, under the declaring module's prefix for an import's.
  let e064_traits: string[] = [];
  for trait_req in mod.trait_reqs {
    e064_extra = e064_extra.append(trait_req.trait_name);
    e064_traits = e064_traits.append(trait_req.trait_name);
    if (trait_req.module.len() > 0) {
      e064_traits = e064_traits.append(trait_req.module + "__" + trait_req.trait_name);
    }
  }
  for imp in mod.impls {
    e064_extra = e064_extra.append(imp.trait_name);
  }
  for resource in mod.resources {
    e064_extra = e064_extra.append(resource.name);
  }
  // A variant is materialised as a struct, but its name is no type (#10843).
  let e064_tn: TypeNames = with_spellings(type_names(declared_struct_names(mod.structs), union_names, rnames), mod);
  for efn in mod.funcs {
    // A generic function's own type parameters are known names in its
    // signature; the rest of it is checked as any function's is. Methods are
    // skipped — their receiver may bind type parameters that aren't in scope
    // for this resolver — and so is an associated function whose
    // `impl[T] Box[T]` binds them the same way.
    if (in_focus(focus, efn) && efn.receiver_name.len() == 0) {
      let efn_tps: string[] = e064_fn_tparams(efn);
      for param in efn.params {
        let pu: string = e064_unknown_name(e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), e064_tn, e064_extra, efn_tps);
        if (pu.len() > 0) {
          signature_diags = signature_diags.append(dg_at("E064", "cannot find type \"" + util.demangle(pu) + "\" in this scope" + unknown_type_hint(pu, e064_traits), efn.line, efn.col));
        }
      }
      let ru: string = e064_unknown_name(e064_decl_spelling(efn.ret_type, efn.ret_fn_ret, efn.ret_fn_param_types), e064_tn, e064_extra, efn_tps);
      if (ru.len() > 0) {
        signature_diags = signature_diags.append(dg_at("E064", "cannot find type \"" + util.demangle(ru) + "\" in this scope" + unknown_type_hint(ru, e064_traits), efn.line, efn.col));
      }
      // Body `let x: T` annotations.
      let efn_annots: Annot[] = collect_annots(efn.body);
      signature_diags = util.append_diags(signature_diags, e064_annot_diags(efn_annots, e064_tn, e064_extra, efn_tps, e064_traits));
    }
    if (in_focus(focus, efn)) {
      signature_diags = util.append_diags(signature_diags, e057_fn_diags(efn, tsc));
    }
  }
  signature_diags = util.append_diags(signature_diags, handle_type_diags(mod, focus, e064_tn));
  // E044: a closure capture of a value with no runtime representation, a
  // `void` call result.
  let e044_void_fns: string[] = [];
  for func in mod.funcs {
    if (func.receiver_name.len() == 0 && func.ret_type == "void") {
      e044_void_fns = e044_void_fns.append(func.name);
    }
  }
  for func in mod.funcs {
    if (in_focus(focus, func)) {
      body_diags = util.append_diags(body_diags, e044_diags(func, e044_void_fns));
    }
  }
  // E053 (`fip` no-allocation verification), E065 (`str` view escaping a
  // function-local string), and E032 (`use` binding-type inference).
  let fip_names: string[] = [];
  let fbip_names: string[] = [];
  let str_ret_names: string[] = [];
  for func in mod.funcs {
    if (func.fip) {
      fip_names = fip_names.append(func.name);
    }
    if (func.fbip) {
      fbip_names = fbip_names.append(func.name);
    }
    if (func.ret_type == "str") {
      str_ret_names = str_ret_names.append(func.name);
    }
  }
  let e053_variants: string[] = [];
  for union in unions {
    for variant in union.variants {
      e053_variants = e053_variants.append(variant);
    }
  }
  // E065's callee route needs to know which parameter positions each
  // `str`-returning function's returns may view before it can chase a
  // call into its arguments, so the summaries settle to a fixpoint
  // first. A summary only ever GAINS positions and each is bounded by
  // the parameter count, so this terminates — and a self-recursive
  // laundering function converges rather than looping.
  let e065_fns: parser.FuncDecl[] = [];
  let e065_scopes: Scope[] = [];
  let e065_sums: ViewSum[] = [];
  for sfn in mod.funcs {
    // `string`-returning functions are summarised alongside the `str`
    // ones: a view of the owned string one of them BUILT dangles once
    // this frame drops it, so `slice_unchecked(mkstr(), 0, 1)` needs
    // mkstr's summary. Only `str` returns are REPORTED against.
    if (sfn.ret_type == "str" || sfn.ret_type == "string") {
      e065_fns = e065_fns.append(sfn);
      e065_scopes = e065_scopes.append(build_func_scope(sfn, st, stt, ut, methods, imports, call_impls, mod.trait_reqs));
      e065_sums = e065_sums.append(ViewSum { key: view_sum_key(sfn), flags: __alloc_bool(view_positions(sfn).len()), fresh: false });
    }
  }
  let e065_ix: ViewIndex = view_index(e065_sums);
  let e065_changed: boolean = true;
  while (e065_changed) {
    e065_changed = false;
    let si: i32 = 0;
    while (si < e065_fns.len()) {
      let sw: E065Walk = e065_diags(e065_fns[si], str_ret_names, e065_sums, e065_ix, e065_scopes[si]);
      let positions: string[] = view_positions(e065_fns[si]);
      let cur_sum: ViewSum = e065_sums[si];
      let next_flags: boolean[] = cur_sum.flags;
      let pi: i32 = 0;
      while (pi < positions.len() && pi < next_flags.len()) {
        if (!next_flags[pi] && e065_ident_in(positions[pi], sw.viewed)) {
          next_flags = next_flags.with(pi, true);
          e065_changed = true;
        }
        pi = pi + 1;
      }
      let e065_fresh: boolean = cur_sum.fresh;
      if (!e065_fresh && sw.owns) {
        e065_fresh = true;
        e065_changed = true;
      }
      e065_sums = e065_sums.with(si, ViewSum { key: cur_sum.key, flags: next_flags, fresh: e065_fresh });
      si = si + 1;
    }
  }
  for xfn in mod.funcs {
    if (!in_focus(focus, xfn)) {
      continue;
    }
    let xsc: Scope = build_func_scope(xfn, st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
    for param in xfn.params {
      body_diags = util.append_diags(body_diags, e045_annot_diags(param.type_name, xfn.line, xfn.col, xsc));
    }
    body_diags = util.append_diags(body_diags, e045_annot_diags(xfn.ret_type, xfn.line, xfn.col, xsc));
    for an in lambda_annots(xfn.body) {
      body_diags = util.append_diags(body_diags, e045_annot_diags(an.type_name, an.line, an.col, xsc));
    }
    if (xfn.fip || xfn.fbip) {
      body_diags = util.append_diags(body_diags, e053_diags(xfn, util.append_all(fip_names, fip_builtin_callees(mod.funcs)), fbip_names, e053_variants, xsc));
    }
    if (xfn.ret_type == "str") {
      body_diags = util.append_diags(body_diags, e065_diags(xfn, str_ret_names, e065_sums, e065_ix, xsc).diags);
    }
    body_diags = util.append_diags(body_diags, e065_cursor_diags(xfn));
  }
  // E045 on a struct FIELD's annotation. Unlike E064 / E057 this needs no
  // non-generic scoping: a type-parameter key resolves to unknown, which
  // map_key_type_error accepts.
  let fld_scope: Scope = new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
  for esd in mod.structs {
    for field in esd.fields {
      body_diags = util.append_diags(body_diags, e045_annot_diags(field.type_name, esd.line, esd.col, fld_scope));
    }
  }
  for esd in mod.structs {
    if (esd.type_params.len() == 0 && esd.enum_owner.len() == 0) {
      for field in esd.fields {
        let fu: string = e064_unknown_name(e064_decl_spelling(field.type_name, field.fn_ret, field.fn_param_types), e064_tn, e064_extra, esd.type_params);
        if (fu.len() > 0) {
          body_diags = body_diags.append(dg_at("E064", "cannot find type \"" + util.demangle(fu) + "\" in this scope" + unknown_type_hint(fu, e064_traits), esd.line, esd.col));
        }
      }
    }
    body_diags = util.append_diags(body_diags, e057_struct_diags(esd, mod.enums, fld_scope));
  }
  body_diags = util.append_diags(body_diags, e085_decl_diags(mod, focus, e064_tn));
  // Native folds top-level consts BEFORE the checker runs, and a const the
  // fold refuses aborts it — so the checker never sees the module and nothing
  // else is reported. Mirror that ordering: without it a refused const also
  // collects whatever its body walk finds (a range error on the operand it
  // could not fold, a type error on the Option a checked operator yields),
  // which native never reaches.
  let cgd: util.Diag[] = const_grammar_diags(mod);
  if (cgd.len() > 0) {
    return ModuleTypes { sigs: sigs, top_tys: top_tys, all_well_typed: false, diags: cgd };
  }
  // own_diags (E050/E051) and e049_diags (E049) walk whole-function bodies
  // for move / capture analysis. The declarations and impls are a re-check's
  // template module's, which the first pass found clean.
  let decl_diags: util.Diag[] = [];
  if (focus_names.len() == 0) {
    decl_diags = util.append_diags(util.append_diags(collect_decl_diags(mod), util.append_diags(orphan_impl_diags(mod), util.append_diags(e021_diags(mod), bound_decl_diags(mod)))), derive_diags);
  }
  let leading: util.Diag[] = util.append_diags(fda_diags, decl_diags);
  leading = util.append_diags(leading, signature_diags);
  leading = util.append_diags(leading, e021_object_safety_diags(mod, focus));
  leading = util.append_diags(leading, e021_unknown_dyn_trait_diags(mod, focus));
  let dd: util.Diag[] = thin_map_import_diags(util.append_diags(util.append_diags(util.append_diags(leading, body_diags), own_diags(mod, env, focus)), util.append_diags(e049_diags(mod, env, focus), e060_e062_diags(mod, focus))));
  if (dd.len() > 0) {
    well_typed = false;
  }
  return ModuleTypes { sigs: sigs, top_tys: top_tys, all_well_typed: well_typed, diags: dd };
}

// Body diagnostics follow source order. A missing return is checked after the body.
function body_source_order(diags: util.Diag[]): util.Diag[] {
  let out: util.Diag[] = [];
  let exits: util.Diag[] = [];
  for d in diags {
    if (d.code == "E052") {
      exits = exits.append(d);
    } else {
      out = out.append(d);
      let i: i32 = out.len() - 1;
      while (i > 0 && (out[i].line < out[i - 1].line || out[i].line == out[i - 1].line && out[i].col < out[i - 1].col)) {
        let previous: util.Diag = out[i - 1];
        out = out.with(i - 1, out[i]).with(i, previous);
        i = i - 1;
      }
    }
  }
  return util.append_diags(out, exits);
}

// ModuleEnv is the module-level name environment: the four indexed tables a
// Scope carries plus the module's own import paths — everything
// build_func_scope and new_scope_full need to place a statement in the scope
// check_module would check it in. check_module builds it once per pass and
// every walk of that pass reads it; the rewriting passes (settle, pretype,
// annotate) build their own.
pub struct ModuleEnv { sigs: SigTable, structs: StructTable, unions: UnionTable, methods: MethodTable, imports: Imports, impls: parser.ImplInfo[], trait_reqs: parser.TraitReq[] }

function module_env(mod: parser.Module): ModuleEnv {
  return module_env_with_file(mod, "");
}

function module_env_with_file(mod: parser.Module, entry_file: string): ModuleEnv {
  // The struct sigs resolve against the union NAMES, so a struct field typed
  // as a union resolves rather than going unknown; the full union sigs, with
  // their variants, come after, and func sigs read both. The built-in structs
  // are in it whether or not the module was prepared, so a pass that types a
  // module lowering hands it (annotate_module) reads a built-in's fields too.
  let rnames: string[] = resource_names(mod);
  let structs: StructSig[] = collect_struct_sigs(parser.inject_builtin_enums(mod.structs), declared_union_names(mod), rnames);
  let unions: UnionSig[] = collect_union_sigs(mod);
  // An enum registers as a union sig, so an enum-typed scrutinee types to
  // TypeUnion and E030 exhaustiveness covers it as it covers an alias.
  for ed in mod.enums {
    unions = unions.append(enum_union_sig(ed));
  }
  let union_names: string[] = union_sig_names(unions);
  let tn: TypeNames = with_spellings(type_names(type_head_names(structs, union_names), union_names, rnames), mod);
  let sigs: FuncSig[] = collect_func_sigs(mod.funcs, tn);
  let methods: MethodSig[] = collect_method_sigs(mod.funcs, tn);
  if (entry_file.len() > 0) {
    let named: MethodSig[] = [];
    for m in methods {
      if (m.file.len() == 0 && m.line > 0) {
        named = named.append(MethodSig { ...m, file: entry_file + ":" });
      } else {
        named = named.append(m);
      }
    }
    methods = named;
  }
  return ModuleEnv {
    sigs: sig_table(sigs),
    structs: struct_table(structs, union_names, rnames, tn.spellings),
    unions: union_table(unions),
    methods: method_table(methods),
    imports: module_imports(mod),
    impls: assoc_func_impls(mod.impls, mod.funcs),
    trait_reqs: mod.trait_reqs,
  };
}

// module_scopes returns the scope each function body is walked in, in
// mod.funcs order, with the module-level scope for mod.top_stmts last. These
// are the scopes check_module hands the diagnostic walkers that thread a
// statement scope with bind_stmt, and the bind_stmt parity driver replays
// them: comparing bind_stmt against check_stmt in an empty scope would
// resolve every annotation to unknown on both sides and compare nothing.
// expr_type and scope_type are the semantic phase's read-only view of the
// checker's answers: an expression's resolved type in a scope, and a binding's
// declared or inferred type after bind_stmt.
pub function expr_type(e: ast.Expr, s: Scope): typeinfo.Type {
  return check_expr(e, s);
}

// binary_types is the type of `b` and of its two operands, typing each operand
// once: check_expr of `b` itself would type them again.
pub function binary_types(b: ast.ExprBinary, s: Scope): (typeinfo.Type, typeinfo.Type, typeinfo.Type) {
  let lt: typeinfo.Type = check_expr(b.left, s);
  let rt: typeinfo.Type = check_expr(b.right, s);
  if (b.op == "__named_arg") {
    return (rt, lt, rt);
  }
  return (binary_result_type(b, lt, rt, s), lt, rt);
}

pub function scope_type(s: Scope, name: string): typeinfo.Type {
  return s.lookup(name);
}

// func_type_params is function `name`'s type parameters in declared order,
// the positions a written instantiation `name[A, B](…)` binds. A method is
// named `Owner.method`, its receiver's parameters ahead of its own.
pub function func_type_params(s: Scope, name: string): string[] {
  let sig: FuncSig = s.lookup_sig(name);
  if (sig.name.len() > 0) {
    return sig.all_type_params;
  }
  let dot: i32 = name.len() - 1;
  while (dot > 0 && name[dot] != b'.') {
    dot = dot - 1;
  }
  if (dot <= 0) {
    return sig.all_type_params;
  }
  return s.lookup_method(slice_unchecked(name, dot + 1, name.len()) + "", slice_unchecked(name, 0, dot) + "").all_type_params;
}

// spelled_type is the type a written spelling names in this scope.
pub function spelled_type(s: Scope, spelling: string): typeinfo.Type {
  return s.resolve_type(spelling);
}

// struct_sig is the declared signature of struct `name` in this scope's
// module, or the empty-named sentinel when there is none.
pub function struct_sig(s: Scope, name: string): StructSig {
  return s.lookup_struct(name);
}

// variant_owner_of is the enum or union alias that declares a variant named
// `name`, or "" when none does — the receiver-position question: a bare name
// both a struct and a variant carry is the variant's value, as native reads it.
pub function variant_owner_of(s: Scope, name: string): string {
  return union_of_variant(name, s.unions);
}

// variant_sig is the declared signature of variant `name` of enum `owner`,
// or the empty-named sentinel when no such variant is declared.
pub function variant_sig(s: Scope, name: string, owner: string): StructSig {
  let sig: StructSig = s.lookup_owned_struct(name, owner);
  if (sig.enum_owner != owner) {
    return s.lookup_struct("");
  }
  return sig;
}

// Resolve a declared variant's fields at the enum instance's arguments.
// The caller supplies the owner-qualified signature, so equally named
// variants in other enums cannot provide this instance's payload shape.
pub function instantiated_variant(sig: StructSig, s: Scope, whole: typeinfo.Type): StructSig {
  if let typeinfo.TypeUnion(u) = whole {
    let us: UnionSig = s.lookup_union(u.name);
    if (sig.enum_owner == u.name && us.type_params.len() > 0 && us.type_params.len() == u.args.len()) {
      let types: typeinfo.Type[] = [];
      for spelling in sig.field_type_names {
        types = types.append(type_from_ref_subst(parser.parse_type_ref(spelling), us.type_params, u.args, s.type_names()));
      }
      return StructSig { ...sig, field_types: types };
    }
  }
  return sig;
}

pub function union_sig(s: Scope, name: string): UnionSig {
  return s.lookup_union(name);
}

// owned_variant_names lists the variants `owner` owns, in declaration order,
// read off the struct table rather than off an enum declaration. The front end
// INJECTS IoError and Body as variant structs with no enum declaration to
// list them (parser.inject_builtin_enums), so there is no UnionSig to ask.
pub function owned_variant_names(s: Scope, owner: string): string[] {
  let out: string[] = [];
  if (owner.len() == 0) {
    return out;
  }
  for sig in s.structs.structs {
    if (sig.enum_owner == owner) {
      out = out.append(sig.name);
    }
  }
  return out;
}

// variant_shape_sig is the declared field shape of `name` as a member of union
// `owner`: an enum's own variant declaration, or — for a struct-union
// (`type Shape = Circle | Square`) — the separately declared struct the union
// names. The two are distinguished by `enum_owner`, which a struct-union
// member never carries.
pub function variant_shape_sig(s: Scope, name: string, owner: string): StructSig {
  let owned: StructSig = s.lookup_owned_struct(name, owner);
  if (owned.enum_owner == owner) {
    return owned;
  }
  let plain: StructSig = s.lookup_struct(name);
  if (plain.name.len() > 0 && plain.enum_owner.len() == 0 && is_variant_of(name, owner, s.unions.unions)) {
    return plain;
  }
  return s.lookup_struct("");
}

// arm_scope is the scope a match arm's body sees: `s` plus the arm's payload
// bindings, typed as check_stmt types them.

// value_block_tail_type is the type of a `{ …; tail }` block: its final
// `return`, checked with the leading statements bound. An earlier `return`
// leaves the enclosing function, so it says nothing about the block. A bare
// literal tail stays unknown: it adapts to whatever receives the block.
function value_block_tail_type(body: ast.Stmt[], s: Scope): typeinfo.Type {
  if (body.len() == 0) {
    return t_unknown("empty value block");
  }
  if let ast.StmtUnknown(u) = body[body.len() - 1] {
    if (u.kind == "value branch has no trailing expression") {
      return t_void();
    }
  }
  if let ast.StmtReturn(r) = body[body.len() - 1] {
    if (parser.bare_return(r.value) || int_literal_tree(r.value)) {
      return t_unknown("value block tail");
    }
    let bs: Scope = s;
    let i: i32 = 0;
    while (i < body.len() - 1) {
      bs = bind_stmt(body[i], bs);
      i = i + 1;
    }
    let t: typeinfo.Type = check_expr(r.value, bs);
    if (!names_whole_type(t, bs)) {
      return t_unknown("value block tail");
    }
    return t;
  }
  return t_unknown("value block tail");
}

// The first `return` carrying a value, looked for through the branches, arms
// and loops of a body, with the scope at that statement; the bare-return
// sentinel when there is none. It is what an unannotated lambda's result is
// read from, and what the semantic phase reads a synthesised declaration's
// result from.
pub function first_returned(body: ast.Stmt[], scope: Scope): (ast.Expr, Scope) {
  let none: ast.Expr = ast.ExprUnknown { kind: parser.BARE_RETURN, line: 0, col: 0 };
  for st in body {
    match (st) {
      ast.StmtReturn(r) => {
        if (!parser.bare_return(r.value)) {
          return (r.value, scope);
        }
      },
      ast.StmtIf(f) => {
        let (t, ts) = first_returned(f.then_body, scope);
        if (!parser.bare_return(t)) {
          return (t, ts);
        }
        let (e, es) = first_returned(f.else_body, scope);
        if (!parser.bare_return(e)) {
          return (e, es);
        }
      },
      ast.StmtWhile(w) => {
        let (v, vs) = first_returned(w.body, scope);
        if (!parser.bare_return(v)) {
          return (v, vs);
        }
      },
      ast.StmtFor(fo) => {
        let (v, vs) = first_returned(fo.body, for_body_scope(fo, scope));
        if (!parser.bare_return(v)) {
          return (v, vs);
        }
      },
      ast.StmtMatch(m) => {
        let whole: typeinfo.Type = expr_type(m.scrutinee, scope);
        for a in m.arms {
          let (v, vs) = first_returned(a.body, arm_scope(a, scope, whole));
          if (!parser.bare_return(v)) {
            return (v, vs);
          }
        }
      },
      _ => {}
    }
    scope = bind_stmt(st, scope);
  }
  return (none, scope);
}

pub function arm_scope(arm: ast.MatchArm, s: Scope, whole: typeinfo.Type): Scope {
  return annotate_arm_scope(arm, s, whole);
}

pub function module_scopes(mod: parser.Module): Scope[] {
  let v: QueryView = QueryView { mod: mod, env: module_env(mod) };
  let out: Scope[] = [];
  for fd in mod.funcs {
    out = out.append(func_scope(v, fd));
  }
  return out.append(module_scope(v));
}

// QueryView is a module and the tables it is typed against: what the language
// server asks the type and declaration of a name in.
pub struct QueryView { mod: parser.Module, env: ModuleEnv }

// query_view is `raw_mod` as check_module types it, default arguments filled
// and the module prepared.
pub function query_view(raw_mod: parser.Module): QueryView {
  let (filled, _) = parser.fill_default_args_with_diags(raw_mod);
  let mod: parser.Module = prepared_module(filled);
  return QueryView { mod: mod, env: module_env(mod) };
}

// func_scope is the scope check_module walks the body of `fd`, a function of
// `v.mod`, in; module_scope the one it walks the top-level statements in.
pub function func_scope(v: QueryView, fd: parser.FuncDecl): Scope {
  return build_func_scope(fd, v.env.sigs, v.env.structs, v.env.unions, v.env.methods, v.env.imports, v.env.impls, v.env.trait_reqs);
}

pub function module_scope(v: QueryView): Scope {
  return new_scope_full(v.env.sigs, v.env.structs, v.env.unions, v.env.methods, v.env.imports, v.env.impls, v.env.trait_reqs);
}

// func_sig is the signature of function `name`, and method_sig that of method
// `name` on receiver type `recv` (receiver_key), or the empty-named sentinel.
pub function func_sig(s: Scope, name: string): FuncSig {
  return s.lookup_sig(name);
}

pub function method_sig(s: Scope, name: string, recv: string): MethodSig {
  return s.lookup_method(name, recv);
}

// methods_on is every method a receiver of type `recv` is called with, as
// method_sig finds one, in declaration order.
pub function methods_on(s: Scope, recv: string): MethodSig[] {
  let out: MethodSig[] = [];
  for ms in s.methods.methods {
    if (s.receives(ms, recv)) {
      out = out.append(ms);
    }
  }
  return out;
}

// builtin_method_names is the built-in methods of receiver type `recv`
// (builtin_method_sig).
pub function builtin_method_names(recv: string): string[] {
  let head: string = "__method_" + recv + "_";
  let out: string[] = [];
  for row in builtin_sigs() {
    let open: i32 = util.index_of_sub(row, "(");
    if (open > head.len() && util.str_has_prefix(row, head)) {
      out = out.append(slice_unchecked(row, head.len(), open) + "");
    }
  }
  return out;
}

// array_method_names is the methods an array (a view, when `view`) has from
// its receiver declarations, each once, in declaration order.
pub function array_method_names(s: Scope, view: boolean): string[] {
  let out: string[] = [];
  for method in s.methods.methods {
    if (array_receiver_matches(method.receiver_type, view) && !util.has_str(out, method.name)) {
      out = out.append(method.name);
    }
  }
  return out;
}

// enum_sig is enum `name`'s signature, a built-in Option's or Result's
// included; the empty-named sentinel when `name` is no enum.
pub function enum_sig(s: Scope, name: string): UnionSig {
  let u: UnionSig = s.lookup_union(name);
  if (u.name.len() > 0) {
    return u;
  }
  return builtin_union_sig(name);
}

// variant_enum is the enum declaring variant `name`, a built-in one's
// included, or "".
pub function variant_enum(s: Scope, name: string): string {
  let owner: string = union_of_variant(name, s.unions);
  if (owner.len() > 0) {
    return owner;
  }
  return parser.builtin_enum_of(name);
}

// payload_slot is which of enum `owner`'s type parameters payload `k` of its
// variant `name` is, or -1 when it is none.
pub function payload_slot(s: Scope, owner: string, name: string, k: i32): i32 {
  return ctor_payload_slot(s, owner, name, k);
}

// The innermost statement of a body whose type the checker could not infer,
// and the reason it recorded for the unknown.
struct UnknownSite { found: boolean, line: i32, col: i32, reason: string }

function unknown_site(stmts: ast.Stmt[], s: Scope): UnknownSite {
  let cur: Scope = s;
  for st in stmts {
    let r: CheckResult = check_stmt(st, cur);
    if let typeinfo.TypeUnknown(u) = r.ty {
      let inner: UnknownSite = unknown_site_within(st, cur);
      if (inner.found) {
        return inner;
      }
      return UnknownSite { found: true, line: ast.stmt_line(st), col: ast.stmt_col(st), reason: u.reason };
    }
    cur = r.scope;
  }
  return UnknownSite { found: false, line: 0, col: 0, reason: "" };
}

// The nested bodies a statement checks, each in the scope check_stmt gives it.
function unknown_site_within(st: ast.Stmt, s: Scope): UnknownSite {
  let none: UnknownSite = UnknownSite { found: false, line: 0, col: 0, reason: "" };
  match (st) {
    ast.StmtIf(f) => {
      let t: UnknownSite = unknown_site(f.then_body, s);
      if (t.found) {
        return t;
      }
      return unknown_site(f.else_body, s);
    },
    ast.StmtWhile(w) => {
      return unknown_site(w.body, s.enter_loop());
    },
    ast.StmtFor(fo) => {
      return unknown_site(fo.body, for_body_scope(fo, s));
    },
    ast.StmtMatch(m) => {
      let whole: typeinfo.Type = check_expr(m.scrutinee, s);
      for arm in m.arms {
        let a: UnknownSite = unknown_site(arm.body, annotate_arm_scope(arm, s, whole));
        if (a.found) {
          return a;
        }
      }
    },
    ast.StmtDefer(d) => {
      return unknown_site_within(d.action, s);
    },
    _ => {}
  }
  return none;
}

// ill_typed_hint is the diagnostic for a module check_module marked ill-typed
// without a coded diagnostic: an expression it collapsed to TypeUnknown. Every
// such module is a checker bug, either a rule with no diagnostic or a valid
// program it cannot type, so the report is an uncoded internal error at the
// innermost statement it could not type. `-check` calls it only when
// `all_well_typed` is false and `diags` is empty, so a rejection is never
// silent; being uncoded, it never gates a build (is_diagnostic_code).
pub function ill_typed_hint(raw_mod: parser.Module): util.Diag[] {
  // The module check_module typed, builtin structs (FileStat, …) included;
  // without them a function using one reads as the ill-typed one.
  let (filled, _) = parser.fill_default_args_with_diags(raw_mod);
  let mod: parser.Module = prepared_module(filled);
  let env: ModuleEnv = module_env(mod);
  for func in mod.funcs {
    let fs: Scope = build_func_scope(func, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
    if (!check_func_body(func, fs)) {
      let site: UnknownSite = unknown_site(func.body, fs);
      if (site.found) {
        return [untyped_code(site.line, site.col, "this statement in \"" + func.name + "\" (" + site.reason + ")")];
      }
      return [untyped_code(func.line, func.col, "the body of \"" + func.name + "\"")];
    }
  }
  let s: Scope = new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  for top_stmt in mod.top_stmts {
    let r: CheckResult = check_stmt(top_stmt, s);
    s = r.scope;
    if let typeinfo.TypeUnknown(u) = r.ty {
      return [untyped_code(ast.stmt_line(top_stmt), ast.stmt_col(top_stmt), "this top-level statement (" + u.reason + ")")];
    }
  }
  return [dg_at("", "internal error: the checker rejected this module without a diagnostic; this is a compiler bug, please report it", 0, 0)];
}

// untyped_code is ill_typed_hint's report that the checker could not type
// `what`, positioned at `line`, `col`; `col` 0 is a statement the parser keeps
// no column for, reported from its line's start. A positioned uncoded
// diagnostic prints as `error: internal: ...`, like the compiler's others.
function untyped_code(line: i32, col: i32, what: string): util.Diag {
  if (col <= 0) {
    col = 1;
  }
  return dg_at("", "internal: the checker could not type " + what + " and has no diagnostic for it; this is a compiler bug, please report it", line, col);
}

// =================== VALIDATION ====================
function main(): i32 {
  // Well-typed program:
  //   let a = 1 + 2 * 3;            // a: i32 = 7
  //   let b = "hi" + " there";      // b: string
  //   let c = a < 10;               // c: boolean
  //   let d = !c;                   // d: boolean
  //   return a + 1;                 // i32
  let src1: string = "let a = 1 + 2 * 3; let b = \"hi\" + \" there\"; let c = a < 10; let d = !c; return a + 1;";
  let toks1: lexer.Token[] = lexer.tokenize(src1);
  let stmts1: ast.Stmt[] = parser.parse_program(toks1);
  let pt1: ProgramTypes = check_program(stmts1);
  if (pt1.tys.len() != 5) {
    return 1;
  }
  if (!type_eq(pt1.tys[0], t_i32())) {
    return 10;
  }
  if (!type_eq(pt1.tys[1], t_string())) {
    return 11;
  }
  if (!type_eq(pt1.tys[2], t_bool())) {
    return 12;
  }
  if (!type_eq(pt1.tys[3], t_bool())) {
    return 13;
  }
  if (!type_eq(pt1.tys[4], t_i32())) {
    return 14;
  }

  // Ill-typed program: mixing types in arithmetic.
  //   let x = 1 + "no";            // Unknown — `+` mismatch
  let src2: string = "let x = 1 + \"no\";";
  let toks2: lexer.Token[] = lexer.tokenize(src2);
  let stmts2: ast.Stmt[] = parser.parse_program(toks2);
  let pt2: ProgramTypes = check_program(stmts2);
  if (pt2.tys.len() != 1) {
    return 20;
  }
  if (!is_unknown(pt2.tys[0])) {
    return 21;
  }

  // Ident lookup: forward reference fails, backward reference resolves.
  //   let p = q;                   // q undefined → Unknown
  //   let q = 5;                   // i32
  //   let r = q;                   // i32 (q now in scope)
  let src3: string = "let p = q; let q = 5; let r = q;";
  let toks3: lexer.Token[] = lexer.tokenize(src3);
  let stmts3: ast.Stmt[] = parser.parse_program(toks3);
  let pt3: ProgramTypes = check_program(stmts3);
  if (pt3.tys.len() != 3) {
    return 30;
  }
  if (!is_unknown(pt3.tys[0])) {
    return 31;
  }
  if (!type_eq(pt3.tys[1], t_i32())) {
    return 32;
  }
  if (!type_eq(pt3.tys[2], t_i32())) {
    return 33;
  }

  // Logical / comparison ops with bool operands.
  //   let f = true && false;       // bool
  //   let g = (1 < 2) || f;        // bool
  let src4: string = "let f = true && false; let g = (1 < 2) || f;";
  let toks4: lexer.Token[] = lexer.tokenize(src4);
  let stmts4: ast.Stmt[] = parser.parse_program(toks4);
  let pt4: ProgramTypes = check_program(stmts4);
  if (pt4.tys.len() != 2) {
    return 40;
  }
  if (!type_eq(pt4.tys[0], t_bool())) {
    return 41;
  }
  if (!type_eq(pt4.tys[1], t_bool())) {
    return 42;
  }

  // Module-level: well-typed function decls + a call.
  let src5: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
  let mod5: parser.Module = parser.parse_module(lexer.tokenize(src5));
  let mt5: ModuleTypes = check_module(mod5);
  if (!mt5.all_well_typed) {
    return 50;
  }
  if (mt5.sigs.len() != 2) {
    return 51;
  }
  if (mt5.sigs[0].name != "add") {
    return 52;
  }
  if (mt5.sigs[0].param_types.len() != 2) {
    return 53;
  }
  if (!type_eq(mt5.sigs[0].param_types[0], t_i32())) {
    return 54;
  }
  if (!type_eq(mt5.sigs[0].ret_type, t_i32())) {
    return 55;
  }

  // Ill-typed call: arity mismatch.
  let src6: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(1); }";
  let mod6: parser.Module = parser.parse_module(lexer.tokenize(src6));
  let mt6: ModuleTypes = check_module(mod6);
  if (mt6.all_well_typed) {
    return 60;
  }

  // Ill-typed call: wrong arg type (string into i32 param).
  let src7: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(1, \"x\"); }";
  let mod7: parser.Module = parser.parse_module(lexer.tokenize(src7));
  let mt7: ModuleTypes = check_module(mod7);
  if (mt7.all_well_typed) {
    return 70;
  }

  // Recursive call (factorial) is well-typed.
  let src8: string = "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); } function main(): i32 { return fact(5); }";
  let mod8: parser.Module = parser.parse_module(lexer.tokenize(src8));
  let mt8: ModuleTypes = check_module(mod8);
  if (!mt8.all_well_typed) {
    return 80;
  }

  // Array literal: `let a = [1, 2, 3]; return a[0];` → i32.
  let src9: string = "let a = [1, 2, 3]; return a[0];";
  let stmts9: ast.Stmt[] = parser.parse_program(lexer.tokenize(src9));
  let pt9: ProgramTypes = check_program(stmts9);
  if (pt9.tys.len() != 2) {
    return 90;
  }
  // First stmt's type is the array type.
  match (pt9.tys[0]) {
    typeinfo.TypeArray(ae) => {
      if (!type_eq(ae.elem, t_i32())) {
        return 91;
      }
    },
    _ => {
      return 92;
    }
  }
  // Second stmt (return a[0]) types as i32.
  if (!type_eq(pt9.tys[1], t_i32())) {
    return 93;
  }

  // .len() on an array → i32.
  let src10: string = "let a = [\"x\", \"y\"]; return a.len();";
  let stmts10: ast.Stmt[] = parser.parse_program(lexer.tokenize(src10));
  let pt10: ProgramTypes = check_program(stmts10);
  if (!type_eq(pt10.tys[1], t_i32())) {
    return 100;
  }

  // Mixed-type array literal → its first element's type, as native types it;
  // E034 reports the mismatch.
  let src11: string = "let a = [1, \"oops\"]; return a[0];";
  let stmts11: ast.Stmt[] = parser.parse_program(lexer.tokenize(src11));
  let pt11: ProgramTypes = check_program(stmts11);
  if (!type_eq(pt11.tys[0], t_array(t_i32()))) {
    return 110;
  }

  // String indexing: `s[0]` types as u8, the byte type (#5629).
  let src12: string = "let s = \"hi\"; return s[0];";
  let stmts12: ast.Stmt[] = parser.parse_program(lexer.tokenize(src12));
  let pt12: ProgramTypes = check_program(stmts12);
  if (!type_eq(pt12.tys[1], t_u8())) {
    return 120;
  }

  // String slicing is checked (#5634): `s[1:4]` is `Option[str]`.
  let src13: string = "let s = \"hello\"; let t = s[1:4]; return 0;";
  let stmts13: ast.Stmt[] = parser.parse_program(lexer.tokenize(src13));
  let pt13: ProgramTypes = check_program(stmts13);
  match (pt13.tys[1]) {
    typeinfo.TypeUnion(u13) => {
      if (u13.name != "Option") {
        return 130;
      }
      if (u13.args.len() != 1 || !type_eq(u13.args[0], t_string())) {
        return 131;
      }
    },
    _ => {
      return 132;
    }
  }

  // `slice_unchecked(s, 1, 4)` keeps the raw `string` type.
  let src13u: string = "let s = \"hello\"; let t = slice_unchecked(s, 1, 4); return 0;";
  let stmts13u: ast.Stmt[] = parser.parse_program(lexer.tokenize(src13u));
  let pt13u: ProgramTypes = check_program(stmts13u);
  if (!type_eq(pt13u.tys[1], t_string())) {
    return 133;
  }

  // Struct lit + field access well-typed.
  let src14: string = "struct Point { x: i32, y: i32 } function main(): i32 { let p = Point { x: 3, y: 4 }; return p.x + p.y; }";
  let mod14: parser.Module = parser.parse_module(lexer.tokenize(src14));
  let mt14: ModuleTypes = check_module(mod14);
  if (!mt14.all_well_typed) {
    return 140;
  }

  // Wrong field type: y wants i32 but a string is passed.
  let src15: string = "struct Point { x: i32, y: i32 } function main(): i32 { let p = Point { x: 3, y: \"oops\" }; return 0; }";
  let mod15: parser.Module = parser.parse_module(lexer.tokenize(src15));
  let mt15: ModuleTypes = check_module(mod15);
  if (mt15.all_well_typed) {
    return 150;
  }

  // Missing field on access: Point has no `z`.
  let src16: string = "struct Point { x: i32, y: i32 } function main(): i32 { let p = Point { x: 3, y: 4 }; return p.z; }";
  let mod16: parser.Module = parser.parse_module(lexer.tokenize(src16));
  let mt16: ModuleTypes = check_module(mod16);
  if (mt16.all_well_typed) {
    return 160;
  }

  // Field count mismatch: literal supplies only one field.
  let src17: string = "struct Point { x: i32, y: i32 } function main(): i32 { let p = Point { x: 3 }; return 0; }";
  let mod17: parser.Module = parser.parse_module(lexer.tokenize(src17));
  let mt17: ModuleTypes = check_module(mod17);
  if (mt17.all_well_typed) {
    return 170;
  }

  // Nested struct field type.
  let src18: string = "struct Inner { v: i32 } struct Outer { i: Inner } function main(): i32 { let o = Outer { i: Inner { v: 5 } }; return o.i.v; }";
  let mod18: parser.Module = parser.parse_module(lexer.tokenize(src18));
  let mt18: ModuleTypes = check_module(mod18);
  if (!mt18.all_well_typed) {
    return 180;
  }

  // Well-typed union alias: both variants resolve to declared
  // structs. Function takes a `Shape` param and the body
  // returns 0 — alias is referenced through the signature.
  let src19: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function area(_s: Shape): i32 { return 0; } function main(): i32 { return area(Circle { r: 3 }); }";
  let mod19: parser.Module = parser.parse_module(lexer.tokenize(src19));
  let mt19: ModuleTypes = check_module(mod19);
  if (!mt19.all_well_typed) {
    return 190;
  }

  // Variant→union subtyping: passing a Square into a Shape
  // slot is fine because Square is in Shape's variant list.
  let src20: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function area(_s: Shape): i32 { return 0; } function main(): i32 { return area(Square { s: 4 }); }";
  let mod20: parser.Module = parser.parse_module(lexer.tokenize(src20));
  let mt20: ModuleTypes = check_module(mod20);
  if (!mt20.all_well_typed) {
    return 200;
  }

  // Non-variant struct in a union slot is rejected. Triangle
  // is declared but not a variant of Shape.
  let src21: string = "struct Circle { r: i32 } struct Square { s: i32 } struct Triangle { b: i32 } pub type Shape = Circle | Square; function area(_s: Shape): i32 { return 0; } function main(): i32 { return area(Triangle { b: 5 }); }";
  let mod21: parser.Module = parser.parse_module(lexer.tokenize(src21));
  let mt21: ModuleTypes = check_module(mod21);
  if (mt21.all_well_typed) {
    return 210;
  }

  // Alias variant resolution: unknown variant name is
  // rejected at module-build time. NotAStruct never gets
  // declared, so validate_union_sigs reports failure.
  let src22: string = "struct Circle { r: i32 } pub type Bad = Circle | NotAStruct; function main(): i32 { return 0; }";
  let mod22: parser.Module = parser.parse_module(lexer.tokenize(src22));
  let mt22: ModuleTypes = check_module(mod22);
  if (mt22.all_well_typed) {
    return 220;
  }

  // Union same-type equality: equality through type_eq holds
  // when the union names match. Two `Shape`-typed slots are
  // compatible without further widening.
  let src23: string = "struct Circle { r: i32 } pub type Shape = Circle; function id(s: Shape): Shape { return s; } function main(): i32 { return 0; }";
  let mod23: parser.Module = parser.parse_module(lexer.tokenize(src23));
  let mt23: ModuleTypes = check_module(mod23);
  if (!mt23.all_well_typed) {
    return 230;
  }

  // Match scrutinee + variant patterns over a union — variant
  // arms reference real members of Shape and the binding is
  // typed as the variant's TypeStruct. Function-parameter
  // type annotations are honoured by the parser; local `let`
  // annotations are still dropped, so route the union through
  // a parameter.
  let src24: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function dispatch(sh: Shape): i32 { match (sh) { Circle(c) => { return c.r; }, Square(sq) => { return sq.s; } } return 0; } function main(): i32 { return dispatch(Circle { r: 3 }); }";
  let mod24: parser.Module = parser.parse_module(lexer.tokenize(src24));
  let mt24: ModuleTypes = check_module(mod24);
  if (!mt24.all_well_typed) {
    return 240;
  }

  // Match over a union with a wildcard catch-all is well-typed.
  let src25: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function go(sh: Shape): i32 { match (sh) { Circle(_) => { return 1; }, _ => { return 0; } } return 0; } function main(): i32 { return go(Circle { r: 1 }); }";
  let mod25: parser.Module = parser.parse_module(lexer.tokenize(src25));
  let mt25: ModuleTypes = check_module(mod25);
  if (!mt25.all_well_typed) {
    return 250;
  }

  // Match over a union with a non-member variant arm is
  // rejected. Triangle is a known struct but not a variant
  // of Shape — flag it.
  let src26: string = "struct Circle { r: i32 } struct Square { s: i32 } struct Triangle { b: i32 } pub type Shape = Circle | Square; function go(sh: Shape): i32 { match (sh) { Triangle(_) => { return 1; }, _ => { return 0; } } return 0; } function main(): i32 { return go(Circle { r: 1 }); }";
  let mod26: parser.Module = parser.parse_module(lexer.tokenize(src26));
  let mt26: ModuleTypes = check_module(mod26);
  if (mt26.all_well_typed) {
    return 260;
  }

  // Match arm body type-checks under the pattern binding.
  // `c.r` is a known i32 field on Circle (accessed via the
  // binding `c`), so the arm body is well-typed.
  let src27: string = "struct Circle { r: i32 } pub type Shape = Circle; function go(sh: Shape): i32 { match (sh) { Circle(c) => { return c.r; } } return 0; } function main(): i32 { return go(Circle { r: 4 }); }";
  let mod27: parser.Module = parser.parse_module(lexer.tokenize(src27));
  let mt27: ModuleTypes = check_module(mod27);
  if (!mt27.all_well_typed) {
    return 270;
  }

  // Match against a struct (non-union) scrutinee: the only
  // valid PatVariant target is the struct's own name. Anything
  // else is a never-match and gets flagged.
  let src28: string = "struct Circle { r: i32 } struct Square { s: i32 } function main(): i32 { let c = Circle { r: 1 }; match (c) { Square(_) => { return 1; } } return 0; }";
  let mod28: parser.Module = parser.parse_module(lexer.tokenize(src28));
  let mt28: ModuleTypes = check_module(mod28);
  if (mt28.all_well_typed) {
    return 280;
  }

  // A struct pattern's binding is in scope inside its arm.
  let src29: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 1 }; match (c) { Circle { r } => { return r; } } return 0; }";
  let mod29: parser.Module = parser.parse_module(lexer.tokenize(src29));
  let mt29: ModuleTypes = check_module(mod29);
  if (!mt29.all_well_typed) {
    return 290;
  }

  // Var type annotation honoured: `let sh: Shape = Circle{…}`
  // binds `sh` as Shape, so a match over `sh` accepts both
  // Circle and Square arms. Previously the parser dropped the
  // annotation and `sh` inferred to TypeStruct("Circle"),
  // making the Square arm a never-match.
  let src30: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function main(): i32 { let sh: Shape = Circle { r: 3 }; match (sh) { Circle(c) => { return c.r; }, Square(sq) => { return sq.s; } } return 0; }";
  let mod30: parser.Module = parser.parse_module(lexer.tokenize(src30));
  let mt30: ModuleTypes = check_module(mod30);
  if (!mt30.all_well_typed) {
    return 300;
  }

  // Var annotation type-mismatch: `let n: i32 = "hi"` is
  // rejected — the init type isn't assignable to the
  // declared type.
  let src31: string = "function main(): i32 { let n: i32 = \"hi\"; return 0; }";
  let mod31: parser.Module = parser.parse_module(lexer.tokenize(src31));
  let mt31: ModuleTypes = check_module(mod31);
  if (mt31.all_well_typed) {
    return 310;
  }

  // Var annotation with primitive type: well-typed.
  let src32: string = "function main(): i32 { let n: i32 = 7; let b: boolean = true; let s: string = \"x\"; return n; }";
  let mod32: parser.Module = parser.parse_module(lexer.tokenize(src32));
  let mt32: ModuleTypes = check_module(mod32);
  if (!mt32.all_well_typed) {
    return 320;
  }

  // Var annotation unknown type: rejected. `let w: NotAType`
  // resolves the annotation to TypeUnknown so well-typed
  // flips false.
  let src33: string = "function main(): i32 { let w: NotAType = 1; return 0; }";
  let mod33: parser.Module = parser.parse_module(lexer.tokenize(src33));
  let mt33: ModuleTypes = check_module(mod33);
  if (mt33.all_well_typed) {
    return 330;
  }

  // Receiver method call: `c.area()` type-checks via the
  // method-sig table when the receiver is a TypeStruct
  // matching the method's declared receiver_type.
  let src34: string = "struct Circle { r: i32 } function (c: Circle) area(): i32 { return c.r * c.r; } function main(): i32 { let k: Circle = Circle { r: 5 }; return k.area(); }";
  let mod34: parser.Module = parser.parse_module(lexer.tokenize(src34));
  let mt34: ModuleTypes = check_module(mod34);
  if (!mt34.all_well_typed) {
    return 340;
  }

  // Method with an arg — arg type-checks against the
  // method's param_types.
  let src35: string = "struct Box { v: i32 } function (b: Box) scale(n: i32): i32 { return b.v * n; } function main(): i32 { let x: Box = Box { v: 4 }; return x.scale(3); }";
  let mod35: parser.Module = parser.parse_module(lexer.tokenize(src35));
  let mt35: ModuleTypes = check_module(mod35);
  if (!mt35.all_well_typed) {
    return 350;
  }

  // Method-args type mismatch: passing a string where i32
  // is expected is rejected.
  let src36: string = "struct Box { v: i32 } function (b: Box) scale(n: i32): i32 { return b.v * n; } function main(): i32 { let x: Box = Box { v: 4 }; return x.scale(\"oops\"); }";
  let mod36: parser.Module = parser.parse_module(lexer.tokenize(src36));
  let mt36: ModuleTypes = check_module(mod36);
  if (mt36.all_well_typed) {
    return 360;
  }

  // Method on wrong receiver type — no Square.area method.
  let src37: string = "struct Circle { r: i32 } struct Square { s: i32 } function (c: Circle) area(): i32 { return c.r; } function main(): i32 { let sq: Square = Square { s: 7 }; return sq.area(); }";
  let mod37: parser.Module = parser.parse_module(lexer.tokenize(src37));
  let mt37: ModuleTypes = check_module(mod37);
  if (mt37.all_well_typed) {
    return 370;
  }

  // Plain function name + method name don't collide. Both
  // calls type-check independently — the plain `area()` and
  // the method `k.area()` resolve to different sigs.
  let src38: string = "struct Circle { r: i32 } function (c: Circle) area(): i32 { return c.r * c.r; } function area(): i32 { return 100; } function main(): i32 { let k: Circle = Circle { r: 5 }; let m: i32 = area(); let n: i32 = k.area(); return m + n; }";
  let mod38: parser.Module = parser.parse_module(lexer.tokenize(src38));
  let mt38: ModuleTypes = check_module(mod38);
  if (!mt38.all_well_typed) {
    return 380;
  }

  // Float literal + arithmetic — well-typed. let f: f64
  // catches the annotation; 1.5 + 2.5 type-checks via the
  // new f64 arm.
  let src39: string = "function main(): i32 { let f: f64 = 1.5 + 2.5; let g: f64 = f * 2.0; return 0; }";
  let mod39: parser.Module = parser.parse_module(lexer.tokenize(src39));
  let mt39: ModuleTypes = check_module(mod39);
  if (!mt39.all_well_typed) {
    return 390;
  }

  // Mixed-numeric `+` rejected: `1 + 2.5` doesn't unify.
  let src40: string = "function main(): i32 { let f: f64 = 1 + 2.5; return 0; }";
  let mod40: parser.Module = parser.parse_module(lexer.tokenize(src40));
  let mt40: ModuleTypes = check_module(mod40);
  if (mt40.all_well_typed) {
    return 400;
  }

  // Float comparison — well-typed, returns bool.
  let src41: string = "function main(): i32 { let b: boolean = 3.14 > 3.0; return 0; }";
  let mod41: parser.Module = parser.parse_module(lexer.tokenize(src41));
  let mt41: ModuleTypes = check_module(mod41);
  if (!mt41.all_well_typed) {
    return 410;
  }

  // `%` on floats rejected.
  let src42: string = "function main(): i32 { let f: f64 = 5.5 % 2.0; return 0; }";
  let mod42: parser.Module = parser.parse_module(lexer.tokenize(src42));
  let mt42: ModuleTypes = check_module(mod42);
  if (mt42.all_well_typed) {
    return 420;
  }

  // For-in: iter is a TypeArray; body type-checks under a
  // scope where the loop var has the array's elem type.
  let src43: string = "function main(): i32 { let arr = [1, 2, 3]; let s: i32 = 0; for n in arr { s = s + n; } return s; }";
  let mod43: parser.Module = parser.parse_module(lexer.tokenize(src43));
  let mt43: ModuleTypes = check_module(mod43);
  if (!mt43.all_well_typed) {
    return 430;
  }

  // For-in iter not an array — rejected.
  let src44: string = "function main(): i32 { for n in 7 { } return 0; }";
  let mod44: parser.Module = parser.parse_module(lexer.tokenize(src44));
  let mt44: ModuleTypes = check_module(mod44);
  if (mt44.all_well_typed) {
    return 440;
  }

  // Tuple literal — type-checks as TypeTuple, field access
  // via `.0` reads the elem type at that index.
  let src45: string = "function main(): i32 { let t = (1, 2, 3); return t.0; }";
  let mod45: parser.Module = parser.parse_module(lexer.tokenize(src45));
  let mt45: ModuleTypes = check_module(mod45);
  if (!mt45.all_well_typed) {
    return 450;
  }

  // Heterogeneous tuple — `.0` returns i32, `.1` returns
  // string. Both arms of the tuple type-check.
  let src46: string = "function main(): i32 { let t = (42, \"hi\"); let s: string = t.1; return t.0; }";
  let mod46: parser.Module = parser.parse_module(lexer.tokenize(src46));
  let mt46: ModuleTypes = check_module(mod46);
  if (!mt46.all_well_typed) {
    return 460;
  }

  // Tuple field type-mismatch: `let s: string = t.0` where
  // t.0 is i32 — rejected.
  let src47: string = "function main(): i32 { let t = (42, 100); let s: string = t.0; return 0; }";
  let mod47: parser.Module = parser.parse_module(lexer.tokenize(src47));
  let mt47: ModuleTypes = check_module(mod47);
  if (mt47.all_well_typed) {
    return 470;
  }

  // Tuple index out of range — rejected.
  let src48: string = "function main(): i32 { let t = (1, 2); return t.5; }";
  let mod48: parser.Module = parser.parse_module(lexer.tokenize(src48));
  let mt48: ModuleTypes = check_module(mod48);
  if (mt48.all_well_typed) {
    return 480;
  }

  // break inside a while is well-typed.
  let src49: string = "function main(): i32 { let i: i32 = 0; while (i < 10) { if (i == 3) { break; } i = i + 1; } return i; }";
  let mod49: parser.Module = parser.parse_module(lexer.tokenize(src49));
  let mt49: ModuleTypes = check_module(mod49);
  if (!mt49.all_well_typed) {
    return 490;
  }

  // continue inside a for is well-typed.
  let src50: string = "function main(): i32 { let s: i32 = 0; for n in [1, 2, 3] { if (n == 2) { continue; } s = s + n; } return s; }";
  let mod50: parser.Module = parser.parse_module(lexer.tokenize(src50));
  let mt50: ModuleTypes = check_module(mod50);
  if (!mt50.all_well_typed) {
    return 500;
  }

  // break outside any loop — rejected.
  let src51: string = "function main(): i32 { break; return 0; }";
  let mod51: parser.Module = parser.parse_module(lexer.tokenize(src51));
  let mt51: ModuleTypes = check_module(mod51);
  if (mt51.all_well_typed) {
    return 510;
  }

  // continue outside any loop — rejected.
  let src52: string = "function main(): i32 { continue; return 0; }";
  let mod52: parser.Module = parser.parse_module(lexer.tokenize(src52));
  let mt52: ModuleTypes = check_module(mod52);
  if (mt52.all_well_typed) {
    return 520;
  }

  // Method on a primitive receiver — well-typed.
  let src53: string = "function (s: string) doubled(): string { return s + s; } function main(): i32 { let v: string = \"ab\"; let w: string = v.doubled(); return 0; }";
  let mod53: parser.Module = parser.parse_module(lexer.tokenize(src53));
  let mt53: ModuleTypes = check_module(mod53);
  if (!mt53.all_well_typed) {
    return 530;
  }

  // Method on i32 receiver — well-typed.
  let src54: string = "function (n: i32) twice(): i32 { return n * 2; } function main(): i32 { let x: i32 = 21; return x.twice(); }";
  let mod54: parser.Module = parser.parse_module(lexer.tokenize(src54));
  let mt54: ModuleTypes = check_module(mod54);
  if (!mt54.all_well_typed) {
    return 540;
  }

  // Method on wrong primitive receiver — rejected. The
  // method is declared on `string`; calling on i32 fails.
  let src55: string = "function (s: string) doubled(): string { return s + s; } function main(): i32 { let x: i32 = 5; let y: string = x.doubled(); return 0; }";
  let mod55: parser.Module = parser.parse_module(lexer.tokenize(src55));
  let mt55: ModuleTypes = check_module(mod55);
  if (mt55.all_well_typed) {
    return 550;
  }

  // Union-receiver method: a method declared on a union
  // type-checks when called on any of its variant structs.
  let src56: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function (sh: Shape) tag(): i32 { return 1; } function main(): i32 { let c = Circle { r: 3 }; return c.tag(); }";
  let mod56: parser.Module = parser.parse_module(lexer.tokenize(src56));
  let mt56: ModuleTypes = check_module(mod56);
  if (!mt56.all_well_typed) {
    return 560;
  }

  // Lambda + invocation: `let f = (x: i32): i32 => { … }; f(41)`
  // type-checks; f's call dispatches via the TypeFunc-binding path.
  let src57: string = "function main(): i32 { let f = (x: i32): i32 => { return x + 1; }; return f(41); }";
  let mod57: parser.Module = parser.parse_module(lexer.tokenize(src57));
  let mt57: ModuleTypes = check_module(mod57);
  if (!mt57.all_well_typed) {
    return 570;
  }

  // Lambda arg-type mismatch — `f("hi")` where f expects i32.
  let src58: string = "function main(): i32 { let f = (x: i32): i32 => { return x + 1; }; return f(\"hi\"); }";
  let mod58: parser.Module = parser.parse_module(lexer.tokenize(src58));
  let mt58: ModuleTypes = check_module(mod58);
  if (mt58.all_well_typed) {
    return 580;
  }

  // Generic Map[K, V] param annotation type-checks as a
  // TypeMap. The function body is type-unaware of map ops
  // (no method dispatch), so we just return 0.
  let src59: string = "function lookup(m: Map[string, i32], k: string): i32 { return 0; } function main(): i32 { return 0; }";
  let mod59: parser.Module = parser.parse_module(lexer.tokenize(src59));
  let mt59: ModuleTypes = check_module(mod59);
  if (!mt59.all_well_typed) {
    return 590;
  }

  // Map method dispatch — `.get_or(k, default)` on `Map[K, V]`
  // returns V. The body's `let s = m.get_or(...)` resolves
  // to i32 via TypeMap value.
  let src60: string = "function lookup(m: Map[string, i32], k: string): i32 { return m.get_or(k, 0 - 1); } function main(): i32 { return 0; }";
  let mod60: parser.Module = parser.parse_module(lexer.tokenize(src60));
  let mt60: ModuleTypes = check_module(mod60);
  if (!mt60.all_well_typed) {
    return 600;
  }

  // Map method `.contains(k)` returns bool.
  let src61: string = "function check(m: Map[string, i32], k: string): boolean { return m.contains(k); } function main(): i32 { return 0; }";
  let mod61: parser.Module = parser.parse_module(lexer.tokenize(src61));
  let mt61: ModuleTypes = check_module(mod61);
  if (!mt61.all_well_typed) {
    return 610;
  }

  // Map method `.len()` returns i32.
  let src62: string = "function size(m: Map[string, i32]): i32 { return m.len(); } function main(): i32 { return 0; }";
  let mod62: parser.Module = parser.parse_module(lexer.tokenize(src62));
  let mt62: ModuleTypes = check_module(mod62);
  if (!mt62.all_well_typed) {
    return 620;
  }

  // Return-type matching: a `: i32` function returning a string
  // is rejected.
  let src63: string = "function f(): i32 { return \"hello\"; } function main(): i32 { return 0; }";
  let mod63: parser.Module = parser.parse_module(lexer.tokenize(src63));
  let mt63: ModuleTypes = check_module(mod63);
  if (mt63.all_well_typed) {
    return 630;
  }

  // Return-type matching: nested return inside if/while is also
  // checked. `: i32` with `return true;` in the then-arm is a
  // mismatch.
  let src64: string = "function f(x: i32): i32 { if (x < 0) { return true; } return x; } function main(): i32 { return 0; }";
  let mod64: parser.Module = parser.parse_module(lexer.tokenize(src64));
  let mt64: ModuleTypes = check_module(mod64);
  if (mt64.all_well_typed) {
    return 640;
  }

  // Return-type matching: variant→union widening is allowed.
  // A `: Shape` function returning a `Circle` is well-typed
  // when Shape = Circle | Square.
  let src65: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function f(): Shape { return Circle { r: 5 }; } function main(): i32 { return 0; }";
  let mod65: parser.Module = parser.parse_module(lexer.tokenize(src65));
  let mt65: ModuleTypes = check_module(mod65);
  if (!mt65.all_well_typed) {
    return 650;
  }

  // Return-type matching: returning a non-variant struct from
  // a union-typed function is rejected.
  let src66: string = "struct Circle { r: i32 } struct Triangle { b: i32 } pub type Shape = Circle; function f(): Shape { return Triangle { b: 3 }; } function main(): i32 { return 0; }";
  let mod66: parser.Module = parser.parse_module(lexer.tokenize(src66));
  let mt66: ModuleTypes = check_module(mod66);
  if (mt66.all_well_typed) {
    return 660;
  }

  // Return-type matching: methods are checked too. `(c: Circle)
  // area(): boolean { return c.r; }` declares boolean but returns i32.
  let src67: string = "struct Circle { r: i32 } function (c: Circle) area(): boolean { return c.r; } function main(): i32 { return 0; }";
  let mod67: parser.Module = parser.parse_module(lexer.tokenize(src67));
  let mt67: ModuleTypes = check_module(mod67);
  if (mt67.all_well_typed) {
    return 670;
  }

  return 0;
}

// ---------------------------------------------------------------------------
// Serialize the supported checked types for legacy lowering annotations, keeping
// concrete float widths. Unrepresentable types remain unannotated. Semantic IR
// must carry Type directly rather than depend on this incomplete projection.
function type_to_irtag(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeArray(a) => {
      let elem = type_to_irtag(a.elem);
      if (elem.len() == 0) {
        return "";
      }
      if (a.view) {
        return "[" + elem + "]";
      }
      return elem + "[]";
    },
    typeinfo.TypeFunc(_) => {
      return "fn";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeI32(x) => {
      return int_label(x);
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeStruct(st) => {
      // A struct-valued call carries its nominal type NAME as the tag. A
      // struct name never collides with a scalar tag
      // (f64/i32/... are reserved), and the scalar predicates that read c.ty
      // compare it to their own keyword, so a struct name reads false there —
      // matching the structural walk's false for a struct call.
      return st.name;
    },
    typeinfo.TypeMap(m) => {
      // A map-valued call: the "Map[K, V]" tag the lowering reads
      // (its own canonical spelling — see the "Map[" + ktag + ", " + vtag + "]"
      // constructor). Only when both K and V serialise to a scalar/string tag;
      // a composite key/value yields "" (unannotated → structural fallback).
      let kt: string = type_to_irtag(m.key);
      let vt: string = type_to_irtag(m.value);
      if (kt == "" || vt == "") {
        return "";
      }
      return "Map[" + kt + ", " + vt + "]";
    },
    typeinfo.TypeUnion(u) => {
      // A builtin Option/Result-valued call: reconstruct the full "Option[T]" /
      // "Result[T, E]" tag the lowering keys on, from the union's
      // captured args. "" if any payload/error type isn't scalar/string/struct-
      // serialisable, keeping the tag well-formed.
      if (u.name == "Option" && u.args.len() == 1) {
        let pt: string = type_to_irtag(u.args[0]);
        if (pt == "") {
          return "";
        }
        return "Option[" + pt + "]";
      }
      if (u.name == "Result" && u.args.len() == 2) {
        let ot: string = type_to_irtag(u.args[0]);
        let et: string = type_to_irtag(u.args[1]);
        if (ot == "" || et == "") {
          return "";
        }
        return "Result[" + ot + ", " + et + "]";
      }
      // A NOMINAL enum-valued expression carries its enum NAME, the sibling of
      // the TypeStruct arm above and read through the same admission helper
      // (the lowering's, which admits a struct or an enum and
      // rejects the scalar vocabulary first). A union carrying ARGS is a
      // generic instantiation whose spelling the lowering has no vocabulary for, so
      // only the bare form names itself.
      if (u.args.len() == 0) {
        return u.name;
      }
      return "";
    },
    typeinfo.TypeTuple(tp) => {
      // A tuple-valued call: the canonical "(t0, t1, …)" tag
      // irtables.tuple_type_elem_tag parses (via parse_type_ref),
      // so a `f().N` tuple-element read resolves element N's type instead of
      // bailing to the AST path. Every element must serialise to a scalar /
      // string / struct / nested-composite tag; any unserialisable element
      // (or a degenerate <2-element tuple) yields "" → structural fallback.
      if (tp.elements.len() < 2) {
        return "";
      }
      let out: string = "(";
      let i: i32 = 0;
      while (i < tp.elements.len()) {
        let et2: string = type_to_irtag(tp.elements[i]);
        if (et2 == "") {
          return "";
        }
        if (i > 0) {
          out = out + ", ";
        }
        out = out + et2;
        i = i + 1;
      }
      return out + ")";
    },
    typeinfo.TypeDyn(_) => {
      return typeinfo.spelling(t);
    },
    _ => {
      return "";
    }
  }
  return "";
}

// type_to_arrtag names an ARRAY / slice type as the lowering spells it — "f64[]",
// "i64[]", "string[]" — or "" for anything else. It is deliberately SEPARATE
// from type_to_irtag rather than a TypeArray arm added to it: type_to_irtag's
// result is read by tag-FIRST consumers (expr_is_str / _f64 / _u32 / _u64 all
// short-circuit their structural walk on any non-empty c.ty), so teaching it to
// name arrays would change what those four see on every array-valued call. This
// carrier needs the array spelling in exactly one place — ExprSlice.ty, read by
// a walk-first leaf — so it gets its own namer and the shared vocabulary is
// left alone.
function type_to_arrtag(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeArray(a) => {
      let et: string = type_to_irtag(a.elem);
      if (et == "") {
        return "";
      }
      if (a.view) {
        return "[" + et + "]";
      }
      return et + "[]";
    },
    _ => {
      return "";
    }
  }
  return "";
}

// Imports is the program's import paths, and the sight of each module of a
// bundle (parser.ModuleSight).
pub struct Imports { paths: string[], sights: parser.ModuleSight[] }

function module_imports(mod: parser.Module): Imports {
  return Imports { paths: import_paths_of(mod), sights: mod.sights };
}

// sees reports whether a function in module `from` can reach a declaration in
// module `decl`: its own module's, or one its import closure loads. Without
// sights, a module checked alone, everything is in reach.
function (im: Imports) sees(from: string, decl: string): boolean {
  if (from == decl) {
    return true;
  }
  for sg in im.sights {
    if (sg.module == from) {
      return util.has_str(sg.reaches, decl);
    }
  }
  return true;
}

// import_paths_of: the module's `import` paths exactly as written in source
// ("std/string"), which is the spelling a hint tells the reader to add.
function import_paths_of(mod: parser.Module): string[] {
  let out: string[] = [];
  for im in mod.imports {
    out = out.append(im.path);
  }
  return out;
}

// settle_generic_lit_fields settles at i64 each bare integer literal whose
// field the literal's own arguments widen, so
// `Same { a: 1, b: 4611686018427387904 }` reads both fields at i64 (#10453).
function settle_generic_lit_fields(sl: ast.ExprStructLit, fields: ast.Expr[], s: Scope): ast.Expr[] {
  let sig: StructSig = s.lookup_struct(sl.type_name);
  if (sig.type_params.len() == 0) {
    return fields;
  }
  let largs: typeinfo.Type[] = struct_lit_args(sl, sig, s);
  let out: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < fields.len()) {
    let v: ast.Expr = fields[i];
    let fi: i32 = -1;
    if (i < sl.field_names.len()) {
      fi = field_index(sig, sl.field_names[i]);
    }
    if (fi >= 0 && fi < sig.field_type_names.len()) {
      v = settle_wide_literals(v, type_from_ref_subst(parser.parse_type_ref(sig.field_type_names[fi]), sig.type_params, largs, s.type_names()));
    }
    out = out.append(v);
    i = i + 1;
  }
  return out;
}

// settle_wide_literals settles at i64 each integer literal tree that a part of
// t reads at i64: the value itself, an element of an array, or of a tuple.
// Only a widening is the literal's to settle; a narrower width comes from its
// context.
function settle_wide_literals(e: ast.Expr, t: typeinfo.Type): ast.Expr {
  if (type_to_irtag(t) == "i64" && int_literal_tree(e)) {
    return settle_int_tree(e, "i64");
  }
  if let typeinfo.TypeArray(at) = t {
    if let ast.ExprArray(ea) = e {
      let ne: ast.Expr[] = [];
      for el in ea.elements {
        ne = ne.append(settle_wide_literals(el, at.elem));
      }
      return ast.ExprArray { ...ea, elements: ne };
    }
  }
  if let typeinfo.TypeTuple(tt) = t {
    if let ast.ExprTuple(et) = e {
      let ne: ast.Expr[] = [];
      let k: i32 = 0;
      while (k < et.elements.len()) {
        if (k < tt.elements.len()) {
          ne = ne.append(settle_wide_literals(et.elements[k], tt.elements[k]));
        } else {
          ne = ne.append(et.elements[k]);
        }
        k = k + 1;
      }
      return ast.ExprTuple { ...et, elements: ne };
    }
  }
  return e;
}

// settle_int_tree records a contextual integer type on the compile-only AST.
// Number nodes have no type tag, so their suffix carries the settled width.
// Formatting uses the original parser tree, never this annotated copy.
function settle_int_tree(e: ast.Expr, tag: string): ast.Expr {
  return parser.settle_int_tree(e, tag);
}

// settle_at settles a tree of unsuffixed integer literals at the integer type
// of the destination it is written to: `let a: i64 = 2147483647 + 1` adds at
// 64 bits.
function settle_at(e: ast.Expr, t: typeinfo.Type): ast.Expr {
  if (is_integer(t) && int_literal_tree(e)) {
    return settle_int_tree(e, type_to_irtag(t));
  }
  return e;
}

// settle_args_at_params is settle_at for each argument against its parameter.
function settle_args_at_params(args: ast.Expr[], params: typeinfo.Type[]): ast.Expr[] {
  if (params.len() != args.len()) {
    return args;
  }
  let out: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < args.len()) {
    out = out.append(settle_at(args[i], params[i]));
    i = i + 1;
  }
  return out;
}

// call_param_types is what a call's arguments settle at: the callee's function
// type, or a receiver method's parameters with the receiver's type variables
// bound. Empty when neither is known.
function call_param_types(c: ast.ExprCall, s: Scope): typeinfo.Type[] {
  if let typeinfo.TypeFunc(ft) = check_expr(c.callee, s) {
    if (ft.params_known) {
      return ft.param_types;
    }
    return [];
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    let recv: typeinfo.Type = check_expr(fa.obj, s);
    let key: string = receiver_key(recv);
    let found: Option[MethodSig] = None;
    if (key.len() > 0) {
      let msig: MethodSig = s.lookup_method(fa.field, key);
      if (msig.name.len() > 0) {
        found = Some(msig);
      }
    } else {
      found = bound_method(s, tp_receiver(recv, s), fa.field);
    }
    if let Some(msig) = found {
      let rmb: MethodBinding = method_binding(c, msig, recv, s);
      let out: typeinfo.Type[] = [];
      let i: i32 = 0;
      while (i < msig.param_types.len()) {
        out = out.append(receiver_bound(msig.param_types[i], param_type_name_at(msig, i), rmb, s));
        i = i + 1;
      }
      return out;
    }
  }
  return [];
}

// settle_array_literals gives the unsuffixed literals of an array literal no
// destination has settled the type of a concrete numeric sibling, as native's
// settleNumeric does after joining the element type: `id([4, half(1.0)])` is an
// f32[], not an i32 in an f32 array.
function settle_array_literals(a: ast.ExprArray, s: Scope): ast.Expr {
  if (a.elem_ty.len() > 0) {
    return a;
  }
  let tag: string = "";
  for element in a.elements {
    let et: typeinfo.Type = check_expr(element, s);
    if (tag.len() == 0 && numeric_literal_kind(element) == 0 && (is_integer(et) || is_float(et))) {
      tag = type_to_irtag(et);
    }
  }
  if (tag.len() == 0) {
    return settle_array_struct_literals(a, s);
  }
  let els: ast.Expr[] = [];
  for element in a.elements {
    if (int_literal_tree(element) && !util.has_str(["f32", "f64"], tag)) {
      els = els.append(settle_int_tree(element, tag));
    } else {
      els = els.append(element);
    }
  }
  return parser.settle_to_name(ast.ExprArray { ...a, elements: els }, tag + "[]");
}

// settle_array_struct_literals settles the struct-literal elements of an
// array whose element type a typed sibling widened: `[Same { a: 1, b: 2 },
// Same { a: 3, b: y }]` with `y: i64` is a Same[i64][], so the first
// element's literals are read at i64 (#10453).
function settle_array_struct_literals(a: ast.ExprArray, s: Scope): ast.Expr {
  if let typeinfo.TypeArray(at) = check_expr(a, s) {
    if (!reads_i64(at.elem)) {
      return a;
    }
    let els: ast.Expr[] = [];
    for element in a.elements {
      els = els.append(settle_struct_lit_wide(element, at.elem, s));
    }
    return ast.ExprArray { ...a, elements: els };
  }
  return a;
}

// settle_struct_lit_wide settles a generic struct literal's fields at the
// widths t, an instantiation of its struct, reads at i64.
function settle_struct_lit_wide(e: ast.Expr, t: typeinfo.Type, s: Scope): ast.Expr {
  if let ast.ExprStructLit(sl) = e {
    if let typeinfo.TypeStruct(ts) = t {
      let sig: StructSig = s.lookup_struct(sl.type_name);
      if (ts.name != sl.type_name || sig.type_params.len() != ts.args.len() || sig.type_params.len() == 0) {
        return e;
      }
      let nv: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < sl.field_values.len()) {
        let v: ast.Expr = sl.field_values[i];
        let fi: i32 = 0 - 1;
        if (i < sl.field_names.len()) {
          fi = field_index(sig, sl.field_names[i]);
        }
        if (fi >= 0 && fi < sig.field_type_names.len()) {
          let ft: typeinfo.Type = type_from_ref_subst(parser.parse_type_ref(sig.field_type_names[fi]), sig.type_params, ts.args, s.type_names());
          v = settle_struct_lit_wide(settle_wide_literals(v, ft), ft, s);
        }
        nv = nv.append(v);
        i = i + 1;
      }
      return ast.ExprStructLit { ...sl, field_values: nv };
    }
  }
  return e;
}

// annotate_expr rebuilds `e`, stamping ExprCall.ty, ExprIdent.ty,
// ExprBinary.ty, ExprUnary.ty, ExprFieldAccess.ty and ExprIndex.ty with the
// checker-inferred result tag.
// Recurses through every composite so a nested call is reached.
// Typed is an annotated expression with, where the walk settled it
// (`known`), the type check_expr answers for the expression as written.
struct Typed { e: ast.Expr, ty: typeinfo.Type, known: boolean }

// typed_type is the checked type of `orig`, read off its annotation when
// the walk settled it and checked otherwise.
function typed_type(t: Typed, orig: ast.Expr, s: Scope): typeinfo.Type {
  if (t.known) {
    return t.ty;
  }
  return check_expr(orig, s);
}

function annotate_expr(e: ast.Expr, s: Scope): ast.Expr {
  return annotate_typed(e, s).e;
}

// annotate_typed stamps an expression with its checked type, bottom up: an
// operand's type is what its own annotation settled, and the node's type is
// what check_expr computes from the operands' types (binary_result_type and
// its siblings), so a subtree is checked once rather than once more per
// enclosing node.
function annotate_typed(e: ast.Expr, s: Scope): Typed {
  match (e) {
    ast.ExprIdent(id) => {
      let it: typeinfo.Type = check_ident_expr(id, s);
      return Typed { e: ast.ExprIdent { name: id.name, line: id.line, col: id.col, ty: type_to_irtag(it) }, ty: it, known: true };
    },
    ast.ExprBinary(b) => {
      let lta: Typed = annotate_typed(b.left, s);
      let rta: Typed = annotate_typed(b.right, s);
      let left: ast.Expr = lta.e;
      let right: ast.Expr = rta.e;
      let lt: typeinfo.Type = typed_type(lta, b.left, s);
      let rt: typeinfo.Type = typed_type(rta, b.right, s);
      // A wide bare literal is i64 only in the absence of a context. Beside
      // a u32 operand, 0xffffffff is a u32, including in comparisons and
      // checked arithmetic whose result tag is not the operand type.
      if (is_integer(lt) && is_integer(rt)) {
        if (int_literal_tree(b.left) && !int_literal_tree(b.right)) {
          left = settle_int_tree(left, type_to_irtag(rt));
        }
        if (int_literal_tree(b.right) && !int_literal_tree(b.left)) {
          right = settle_int_tree(right, type_to_irtag(lt));
        }
      }
      // A named-argument marker types as its value (check_binary_expr).
      let bt: typeinfo.Type = rt;
      if (b.op != "__named_arg") {
        bt = binary_result_type(b, lt, rt, s);
      }
      return Typed { e: ast.ExprBinary { op: b.op, left: left, right: right, line: b.line, col: b.col, ty: type_to_irtag(bt) }, ty: bt, known: true };
    },
    ast.ExprUnary(u) => {
      let oa: Typed = annotate_typed(u.operand, s);
      let ut: typeinfo.Type = unary_result_type(u, typed_type(oa, u.operand, s), s);
      return Typed { e: ast.ExprUnary { op: u.op, operand: oa.e, line: u.line, col: u.col, ty: type_to_irtag(ut) }, ty: ut, known: true };
    },
    ast.ExprCall(c) => {
      let nargs: ast.Expr[] = [];
      for arg in c.args {
        nargs = nargs.append(annotate_expr(arg, s));
      }
      nargs = settle_args_at_params(nargs, call_param_types(c, s));
      nargs = display_rewrite(c, nargs, s);
      nargs = settle_shared_literal_typevars(c, nargs, s);
      let ct: typeinfo.Type = check_expr(e, s);
      return Typed { e: ast.ExprCall { callee: annotate_callee(c, ct, s), args: nargs, line: c.line, col: c.col, type_args: stamped_type_args(c, s), ty: type_to_irtag(ct) }, ty: ct, known: true };
    },
    ast.ExprFieldAccess(fa) => {
      let oa: Typed = annotate_typed(fa.obj, s);
      let vqu: string = qual_variant_union(fa, s);
      let ft: typeinfo.Type = t_union(vqu);
      if (vqu.len() == 0) {
        ft = field_access_result_type(fa, typed_type(oa, fa.obj, s), s);
      }
      return Typed { e: ast.ExprFieldAccess { ...fa, obj: oa.e, ty: type_to_irtag(ft) }, ty: ft, known: true };
    },
    ast.ExprIndex(x) => {
      let aa: Typed = annotate_typed(x.array, s);
      let ia: Typed = annotate_typed(x.index, s);
      let xt: typeinfo.Type = index_result_type(typed_type(aa, x.array, s), typed_type(ia, x.index, s));
      return Typed { e: ast.ExprIndex { array: aa.e, index: ia.e, unchecked: x.unchecked, ty: type_to_irtag(xt), line: x.line, col: x.col }, ty: xt, known: true };
    },
    ast.ExprSlice(sl) => {
      let aa: Typed = annotate_typed(sl.array, s);
      let at: typeinfo.Type = typed_type(aa, sl.array, s);
      return Typed { e: ast.ExprSlice { ...sl, array: aa.e, start: annotate_expr(sl.start, s), end: annotate_expr(sl.end, s), ty: type_to_arrtag(at) }, ty: at, known: false };
    },
    ast.ExprArray(a) => {
      let na: ast.Expr[] = [];
      for element in a.elements {
        na = na.append(annotate_expr(element, s));
      }
      return unsettled(settle_array_literals(ast.ExprArray { ...a, elements: na }, s));
    },
    ast.ExprTuple(t) => {
      let nt: ast.Expr[] = [];
      for element in t.elements {
        nt = nt.append(annotate_expr(element, s));
      }
      return unsettled(ast.ExprTuple { elements: nt, line: t.line, col: t.col });
    },
    ast.ExprStructLit(sli) => {
      let nfv: ast.Expr[] = [];
      for field_value in sli.field_values {
        nfv = nfv.append(annotate_expr(field_value, s));
      }
      nfv = settle_generic_lit_fields(sli, nfv, s);
      let nbase: ast.Expr = sli.base;
      if (sli.has_base) {
        nbase = annotate_expr(sli.base, s);
      }
      return unsettled(ast.ExprStructLit { ...sli, field_values: nfv, base: nbase });
    },
    ast.ExprLambda(lm) => {
      return unsettled(annotate_lambda_expr(lm, s, "", t_unknown("")));
    },
    _ => {
      return unsettled(e);
    }
  }
  return unsettled(e);
}

// annotate_callee annotates a call's callee; a value block's lambda results in
// `ct`, the block's type, which joins every arm where its first arm alone may
// not: `if (c) { Full(1) } else { Full(2.5) }` is a Bx[f64].
// A free generic call that writes no type arguments carries the ones its
// arguments bind, so every later pass instantiates it as it would the written
// `f[T](...)`. A variable only the destination or a literal's open width can
// settle leaves the call unwritten, for those passes to settle.
function stamped_type_args(c: ast.ExprCall, s: Scope): string[] {
  let sig: FuncSig = free_generic_sig(c, s);
  if (c.type_args.len() > 0 || sig.all_type_params.len() == 0 || c.args.len() != sig.param_types.len()) {
    return c.type_args;
  }
  let (bn, bt) = call_type_bindings(sig, c, s);
  let out: string[] = [];
  for tp in sig.all_type_params {
    let bi: i32 = util.index_of_str(bn, tp);
    if (bi < 0 || type_contains_unknown(bt[bi]) || width_open(bt[bi])) {
      return c.type_args;
    }
    let spelled: string = typeinfo.spelling(bt[bi]);
    if (spelled.len() == 0) {
      return c.type_args;
    }
    out = out.append(parser.canonicalise_type_args(spelled));
  }
  return out;
}

// free_generic_sig: the declaration a bare call names when it is a free
// generic function rather than a local, or an empty signature.
function free_generic_sig(c: ast.ExprCall, s: Scope): FuncSig {
  if let ast.ExprIdent(cid) = c.callee {
    let sig: FuncSig = s.lookup_sig(cid.name);
    if (!s.is_bound(cid.name) && sig.receiver.len() == 0) {
      return sig;
    }
  }
  return s.lookup_sig("");
}

// width_open: does `t` hold an integer or float literal's type, whose width a
// destination may still choose?
function width_open(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(_) => {
      return is_poly_int(t);
    },
    typeinfo.TypeFloat(_) => {
      return is_poly_float(t);
    },
    typeinfo.TypeArray(a) => {
      return width_open(a.elem);
    },
    typeinfo.TypeMap(m) => {
      return width_open(m.key) || width_open(m.value);
    },
    typeinfo.TypeTuple(tup) => {
      return any_width_open(tup.elements);
    },
    typeinfo.TypeStruct(r) => {
      return any_width_open(r.args);
    },
    typeinfo.TypeUnion(u) => {
      return any_width_open(u.args);
    },
    typeinfo.TypeFunc(f) => {
      return width_open(f.ret_type) || any_width_open(f.param_types);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function any_width_open(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (width_open(t)) {
      return true;
    }
  }
  return false;
}

function annotate_callee(c: ast.ExprCall, ct: typeinfo.Type, s: Scope): ast.Expr {
  if let ast.ExprIdent(id) = c.callee {
    if let typeinfo.TypeUnion(u) = ct {
      if (!s.is_bound(id.name) && !s.has_sig(id.name)) {
        // A constructor retains the enum selected in its lexical module.
        return ast.ExprIdent { ...id, ty: u.name };
      }
    }
  }
  if let ast.ExprLambda(lm) = c.callee {
    if (parser.is_value_block(c)) {
      return annotate_lambda_expr(lm, s, "", ct);
    }
  }
  return annotate_expr(c.callee, s);
}

// unsettled is an annotated expression whose type the walk did not settle: a
// node reading it checks it as it always did.
function unsettled(e: ast.Expr): Typed {
  return Typed { e: e, ty: t_unknown("unsettled"), known: false };
}

// Capture contracts are resolved where the lambda is defined, including
// unknown-typed locals that still shadow globals. A recursive local binds itself.
function annotate_lambda_expr(lm: ast.ExprLambda, s: Scope, self_name: string, block: typeinfo.Type): ast.Expr {
  let captures: ast.TypedBinding[] = [];
  let seen: string[] = [];
  for name in astwalk.collect_lambda_idents(lm, []) {
    if (name != self_name && s.is_bound(name) && !util.has_str(seen, name)) {
      captures = captures.append(ast.TypedBinding { name: name, ty: s.lookup(name) });
      seen = seen.append(name);
    }
  }
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(s.resolve_param(param));
  }
  let rt: typeinfo.Type = lambda_ret_type(lm, s);
  let ls: Scope = Scope { ...s, loop_depth: 0, ret_type: rt, try_ret: rt };
  if (parser.is_value_block_origin(lm.origin)) {
    ls = Scope { ...s, loop_depth: 0, ret_type: rt };
  }
  if (self_name.len() > 0) {
    ls = ls.bind(self_name, t_func_own(pts, lambda_owns(lm), rt));
  }
  let i: i32 = 0;
  while (i < lm.params.len()) {
    ls = ls.bind(lm.params[i].name, pts[i]);
    i = i + 1;
  }
  // A value block's result spelling is the parser's guess from the tail's
  // syntax, so a checked tail that names a whole type replaces it.
  let typed: ast.ExprLambda = lm;
  if (lm.ret_type.len() == 0 || parser.is_value_block_origin(lm.origin)) {
    typed = inferred_lambda_result(lm, ls, lm.ret_type.len() > 0, block);
  }
  // Only a written result type is a destination a `return` settles at; a
  // value block's is its tail's guess, which the enclosing arm may widen.
  let body: Scope = ls;
  if (lm.ret_type.len() == 0 || parser.is_value_block_origin(lm.origin)) {
    body = Scope { ...ls, ret_type: t_unknown("") };
  }
  return ast.ExprLambda { ...typed, body: annotate_block(lm.body, body), captures: captures, captures_known: true };
}

// names_whole_type reports whether `t` is a complete type: nothing unknown in
// it, and no generic union named with fewer arguments than it declares — a
// bare `None` checks as the `Option` family, which no binding has.
function names_whole_type(t: typeinfo.Type, s: Scope): boolean {
  if (type_contains_unknown(t)) {
    return false;
  }
  match (t) {
    typeinfo.TypeUnion(u) => {
      return u.args.len() >= union_arity(s, u.name) && all_names_whole(u.args, s);
    },
    typeinfo.TypeArray(a) => {
      return names_whole_type(a.elem, s);
    },
    typeinfo.TypeTuple(tt) => {
      return all_names_whole(tt.elements, s);
    },
    typeinfo.TypeMap(m) => {
      return names_whole_type(m.key, s) && names_whole_type(m.value, s);
    },
    typeinfo.TypeStruct(sd) => {
      return all_names_whole(sd.args, s);
    },
    _ => {
      return true;
    }
  }
  return true;
}

function all_names_whole(ts: typeinfo.Type[], s: Scope): boolean {
  for t in ts {
    if (!names_whole_type(t, s)) {
      return false;
    }
  }
  return true;
}

// union_arity is how many type arguments the union `name` takes.
function union_arity(s: Scope, name: string): i32 {
  if (name == "Option") {
    return 1;
  }
  if (name == "Result") {
    return 2;
  }
  return s.lookup_union(name).type_params.len();
}

// A lambda spelling no result is hoisted as a declaration spelling none, and
// the signature table then types a call through its box as nothing. The
// result its body returns is stamped as the declaration's spelling; a
// function-valued result is stamped `fn` with the signature in the result
// sidecars, the pair a declaration's `ret_fn_ret` carries (#10025). Left
// empty: a result nested inside another type that holds a function, which no
// spelling carries, and a bare literal, which adapts to the width of whatever
// receives the lambda. A value block's `block` type, where known, is the result
// in place of its first return's.
function inferred_lambda_result(lm: ast.ExprLambda, body_scope: Scope, need_whole: boolean, block: typeinfo.Type): ast.ExprLambda {
  let (returned, at) = first_returned(lm.body, body_scope);
  if (parser.bare_return(returned) || int_literal_tree(returned)) {
    return lm;
  }
  let t: typeinfo.Type = block;
  if (is_unknown(t)) {
    t = check_expr(returned, at);
  }
  if (need_whole && !names_whole_type(t, at)) {
    return lm;
  }
  if let typeinfo.TypeFloat(f) = t {
    if (f.polymorphic) {
      return lm;
    }
  }
  if (is_unknown(t)) {
    return lm;
  }
  if let typeinfo.TypeFunc(_) = t {
    let callable: ast.ParamDecl = decltypes.fn_param_from_type("", t);
    if (callable.type_name != "fn") {
      return lm;
    }
    return ast.ExprLambda { ...lm, ret_type: "fn", ret_fn_ret: callable.fn_ret, ret_fn_param_types: callable.fn_param_types };
  }
  if (spells_function(t)) {
    return lm;
  }
  return ast.ExprLambda { ...lm, ret_type: typeinfo.spelling(t) };
}

function spells_function(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeFunc(_) => {
      return true;
    },
    typeinfo.TypeArray(a) => {
      return spells_function(a.elem);
    },
    typeinfo.TypeTuple(tup) => {
      for e in tup.elements {
        if (spells_function(e)) {
          return true;
        }
      }
    },
    typeinfo.TypeMap(m) => {
      return spells_function(m.key) || spells_function(m.value);
    },
    typeinfo.TypeStruct(st) => {
      for a in st.args {
        if (spells_function(a)) {
          return true;
        }
      }
    },
    typeinfo.TypeUnion(u) => {
      for a in u.args {
        if (spells_function(a)) {
          return true;
        }
      }
    },
    _ => {}
  }
  return false;
}

// annotate_block rebuilds a statement list, threading scope statement-to-statement
// via bind_stmt. A nested control-flow body is rebuilt in the scope that
// body actually sees: a for-loop's body binds the loop variable and a match arm's
// body binds its variant payloads (for_body_scope / annotate_arm_scope), so a
// call whose type depends on one is annotated rather than falling back to the
// structural walk.
function annotate_block(body: ast.Stmt[], s: Scope): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let cur: Scope = s;
  for stmt in body {
    let next: Scope = bind_stmt(stmt, cur);
    out = out.append(annotate_stmt(stmt, cur, next));
    cur = next;
  }
  return out;
}

struct ForBinding { scope: Scope, valid: boolean }

// range_var_type: a range loop's variable has its bounds' type — the first
// bound that is not an untyped literal decides it, and two untyped bounds
// leave the i32 default.
function range_var_type(iter: ast.Expr, s: Scope): typeinfo.Type {
  if let ast.ExprCall(c) = iter {
    for bound in c.args {
      if (!int_literal_tree(bound)) {
        let t: typeinfo.Type = check_expr(bound, s);
        if (is_integer(t)) {
          return t;
        }
      }
    }
  }
  return t_i32();
}

// Checking, diagnostics and annotation share the iterator's binding types.
function for_binding(fr: ast.StmtFor, s: Scope): ForBinding {
  let body = s.enter_loop();
  if (for_iter_is_range(fr.iter)) {
    return ForBinding { scope: bind_for_element(body, fr.var_name, range_var_type(fr.iter, s)), valid: !name_has_comma(fr.var_name) };
  }
  let it: typeinfo.Type = check_expr(fr.iter, s);
  match (it) {
    typeinfo.TypeString(_) => {
      return ForBinding { scope: bind_for_element(body, fr.var_name, t_u8()), valid: !name_has_comma(fr.var_name) };
    },
    typeinfo.TypeArray(ta) => {
      return ForBinding { scope: bind_for_element(body, fr.var_name, ta.elem), valid: true };
    },
    typeinfo.TypeMap(tm) => {
      let names = split_pattern_names(fr.var_name);
      return ForBinding { scope: bind_tuple_destr_names(body, names, t_tuple([tm.key, tm.value])), valid: names.len() == 2 };
    },
    _ => {
      let sub: IterSubject = iter_subject(it, s);
      // An invalid iterator still introduces names for diagnostic recovery.
      return ForBinding { scope: bind_for_element(body, fr.var_name, sub.elem), valid: sub.ok };
    }
  }
  return ForBinding { scope: bind_for_element(body, fr.var_name, t_unknown("invalid iterator")), valid: false };
}

function bind_for_element(s: Scope, name: string, ty: typeinfo.Type): Scope {
  if (name_has_comma(name)) {
    return bind_tuple_destr_names(s, split_pattern_names(name), ty);
  }
  if (name == "_") {
    return s;
  }
  return s.bind(name, ty);
}

// for_body_scope is the scope a `for` body sees: `s` plus the loop's element
// binding, typed as check_stmt types it. Public as the read-only view a
// checked-source consumer walking a loop body needs, beside arm_scope.
pub function for_body_scope(fr: ast.StmtFor, s: Scope): Scope {
  return for_binding(fr, s).scope;
}

// annotate_variant_struct resolves a match pattern's variant name to the name its
// struct sig is registered under, or "" when none is. parse_enum_decl registers
// a variant struct under the BARE name, so an enum-qualified pattern resolves
// through variant_pattern_name. The qualifier must actually name an enum owning
// that variant, so a dotted name that is not an enum-qualified variant resolves
// to "" (its payloads stay unbound) rather than to a same-named plain struct.
function annotate_variant_struct(name: string, s: Scope): string {
  if (s.has_struct(name)) {
    return name;
  }
  let d: i32 = dot_index(name);
  if (d < 0) {
    return "";
  }
  let bare: string = variant_pattern_name(name);
  if (!is_variant_of(bare, slice_unchecked(name, 0, d) + "", s.unions.unions)) {
    return "";
  }
  if (s.has_struct(bare)) {
    return bare;
  }
  return "";
}

// annotate_arm_scope returns the scope a match ARM (its guard and body) sees — `s`
// plus the arm's variant payload bindings, typed as check_stmt's StmtMatch types
// them. A wildcard arm, an unresolvable variant, and the `_` / bare-name bindings
// bind_variant_payloads skips all keep the enclosing scope — their calls annotate
// "" and take the structural fallback.
function annotate_arm_scope(arm: ast.MatchArm, s: Scope, whole: typeinfo.Type): Scope {
  match (arm.pattern) {
    ast.PatVariant(pv) => {
      let vn: string = annotate_variant_struct(pv.type_name, s);
      if (vn.len() == 0) {
        return bind_variant_payloads(s, s, pv, whole);
      }
      return bind_variant_payloads(s, s, ast.PatVariant { ...pv, type_name: vn }, whole);
    },
    ast.PatWildcard(_) => {
      return s;
    }
  }
  return s;
}

function annotate_stmt(st: ast.Stmt, s: Scope, after: Scope): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      // Reuse the type resolved for the binding; the initializer sees s.
      let init = v.init;
      if let ast.ExprLambda(lm) = v.init {
        init = annotate_lambda_expr(lm, s, rec_local_name(v), t_unknown(""));
      } else {
        init = annotate_expr(v.init, s);
      }
      if (v.type_name.len() > 0) {
        init = settle_at(init, after.lookup(v.name));
      }
      let callable: ast.ParamDecl = decltypes.fn_param_from_type(v.name, after.lookup(v.name));
      if (callable.type_name == "fn") {
        return ast.StmtVar {
          ...v, type_name: "fn", init: init,
          fn_ret: callable.fn_ret, fn_param_types: callable.fn_param_types,
        };
      }
      return ast.StmtVar { ...v, init: init };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: settle_at(annotate_expr(r.value, s), s.ret_type), line: r.line, col: r.col };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { value: annotate_expr(x.value, s), line: x.line };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: annotate_expr(f.cond, s), then_body: annotate_block(f.then_body, s), else_body: annotate_block(f.else_body, s) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: annotate_expr(w.cond, s), body: annotate_block(w.body, s), label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { target: a.target, value: settle_at(annotate_expr(a.value, s), s.lookup(a.target)), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
    },
    ast.StmtMatch(m) => {
      let narms: ast.MatchArm[] = [];
      for arm in m.arms {
        let asc: Scope = annotate_arm_scope(arm, s, check_expr(m.scrutinee, s));
        let g: ast.Expr = arm.guard;
        if (arm.has_guard) {
          g = annotate_expr(arm.guard, asc);
        }
        narms = narms.append(ast.MatchArm { ...arm, body: annotate_block(arm.body, asc), guard: g });
      }
      return ast.StmtMatch { ...m, scrutinee: annotate_expr(m.scrutinee, s), arms: narms };
    },
    ast.StmtFor(fr) => {
      if let Some(lowered) = iterator_lowering(fr, s) {
        return annotate_stmt(lowered, s, after);
      }
      return ast.StmtFor { var_name: fr.var_name, iter: annotate_expr(fr.iter, s), body: annotate_block(fr.body, for_body_scope(fr, s)), label: fr.label, line: fr.line, col: fr.col };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: annotate_stmt(d.action, s, after), on_error: d.on_error, line: d.line };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function annotate_func(fd: parser.FuncDecl, env: ModuleEnv): parser.FuncDecl {
  let s: Scope = build_func_scope(fd, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  return parser.FuncDecl { ...fd, body: annotate_block(fd.body, s) };
}

// annotate_module stamps every call, field-access and index expression — in a function
// body and at the TOP LEVEL — with its checker-inferred result type. Top-level
// statements walk
// from the bare module scope, threading statement-to-statement exactly as
// check_module's own top_stmts loop does, so a script-shaped module (which now
// lowers through the IR path, #5657) gets the same annotation coverage a
// function body does.
pub function annotate_module(mod: parser.Module): parser.Module {
  // The same value-local re-declaration check_module types against, so the
  // module handed to lowering carries the arms' type rather than the parser's
  // syntactic guess (#8657).
  return annotate_module_in(mod, module_env(mod), whole_focus(mod));
}

// The parts of a module a pass rewrites: function `i` where `funcs[i]`, and the
// top level where `top`. Every other part comes back as it was.
struct Focus { funcs: boolean[], top: boolean }

function whole_focus(mod: parser.Module): Focus {
  let funcs: boolean[] = [];
  for fd in mod.funcs {
    funcs = funcs.append(true);
  }
  return Focus { funcs: funcs, top: true };
}

function annotate_module_in(mod: parser.Module, env: ModuleEnv, focus: Focus): parser.Module {
  let rmod: parser.Module = pretype_module_in(settle_literal_locals_in(mod, env, focus), env, focus);
  let nfuncs: parser.FuncDecl[] = [];
  let i: i32 = 0;
  while (i < rmod.funcs.len()) {
    if (focus.funcs[i]) {
      nfuncs = nfuncs.append(annotate_func(rmod.funcs[i], env));
    } else {
      nfuncs = nfuncs.append(rmod.funcs[i]);
    }
    i = i + 1;
  }
  let ntop: ast.Stmt[] = rmod.top_stmts;
  if (focus.top) {
    ntop = annotate_block(rmod.top_stmts, new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs));
  }
  return parser.Module { funcs: nfuncs, structs: rmod.structs, aliases: rmod.aliases, imports: rmod.imports, top_stmts: ntop, enums: rmod.enums, resources: rmod.resources, exports: rmod.exports, impls: rmod.impls, trait_reqs: rmod.trait_reqs, trait_decls: rmod.trait_decls, inferred_consts: rmod.inferred_consts, todo_sites: rmod.todo_sites, sights: rmod.sights };
}

function unchecked_capture(e: ast.Expr, own found: boolean): boolean {
  if let ast.ExprLambda(lm) = e {
    return found || !lm.captures_known;
  }
  return found;
}

// display_unrewritten reports whether `e` is a `print` / `write` / `eprint`
// call whose argument the Display rewrite has not judged: not a string
// literal, and not stamped `string` by annotate_module — the shape a raw IR
// driver hands over, where the CLI hands over the rewritten call.
function display_unrewritten(e: ast.Expr, own found: boolean): boolean {
  if (found) {
    return true;
  }
  if let ast.ExprCall(c) = e {
    if (c.args.len() != 1) {
      return false;
    }
    if let ast.ExprIdent(id) = c.callee {
      if (id.name != "print" && id.name != "write" && id.name != "eprint") {
        return false;
      }
      if let ast.ExprString(_) = c.args[0] {
        return false;
      }
      if let ast.ExprFString(_) = c.args[0] {
        return false;
      }
      return ast.expr_ty(c.args[0]) != "string";
    }
  }
  return false;
}

// unannotated reports whether `stmts` hold a lambda whose captures have not
// been typed or a `print` / `write` / `eprint` argument the Display rewrite has
// not judged.
function unannotated(stmts: ast.Stmt[]): boolean {
  let found: boolean = false;
  for st in stmts {
    found = astwalk.fold_stmt(st, found, unchecked_or_unrewritten);
  }
  return found;
}

function unchecked_or_unrewritten(e: ast.Expr, own found: boolean): boolean {
  return display_unrewritten(e, unchecked_capture(e, found));
}

// The parts of `mod` annotate_module has not been through.
function unannotated_focus(mod: parser.Module): Focus {
  let funcs: boolean[] = [];
  for fd in mod.funcs {
    funcs = funcs.append(unannotated(fd.body));
  }
  return Focus { funcs: funcs, top: unannotated(mod.top_stmts) };
}

function any_focus(f: Focus): boolean {
  if (f.top) {
    return true;
  }
  for b in f.funcs {
    if (b) {
      return true;
    }
  }
  return false;
}

// Raw IR drivers enter the same checked boundary as the CLI: a function whose
// lambdas have not had their captures typed, or whose `print` / `write` /
// `eprint` arguments have not been through the Display rewrite, is annotated
// here — a generic's instance among them, since instantiation retypes its
// lambdas' captures. Already annotated syntax keeps its contracts without a
// second pass.
pub function ensure_annotated(mod: parser.Module): parser.Module {
  let focus: Focus = unannotated_focus(mod);
  if (any_focus(focus)) {
    return annotate_module_in(mod, module_env(mod), focus);
  }
  return mod;
}

// Separate emission does not make imported nominal types or call signatures
// opaque. Build the shared declaration context once, retaining each part's
// own functions, top-level statements and emission ownership.
pub function ensure_annotated_parts(mods: parser.Module[]): parser.Module[] {
  let needed: boolean = false;
  let focus: Focus[] = [];
  for mod in mods {
    let f: Focus = unannotated_focus(mod);
    if (any_focus(f)) {
      needed = true;
    }
    focus = focus.append(f);
  }
  if (!needed) {
    return mods;
  }
  let funcs: parser.FuncDecl[] = [];
  let structs: parser.StructDecl[] = [];
  let aliases: parser.TypeAlias[] = [];
  let enums: parser.EnumDecl[] = [];
  for mod in mods {
    for fd in mod.funcs {
      funcs = funcs.append(fd);
    }
    for sd in mod.structs {
      structs = structs.append(sd);
    }
    for ad in mod.aliases {
      aliases = aliases.append(ad);
    }
    for ed in mod.enums {
      enums = enums.append(ed);
    }
  }
  let view = parser.Module { ...mods[0], funcs: funcs, structs: structs, aliases: aliases, enums: enums };
  let env = module_env(view);
  let out: parser.Module[] = [];
  let k: i32 = 0;
  while (k < mods.len()) {
    if (any_focus(focus[k])) {
      out = out.append(annotate_module_in(mods[k], ModuleEnv { ...env, imports: module_imports(mods[k]) }, focus[k]));
    } else {
      out = out.append(mods[k]);
    }
    k = k + 1;
  }
  return out;
}

// ---------------------------------------------------------------------------
// Value-block local retyping (#8657)
//
// A `match` in value position desugars to an IIFE, and the tuple- / struct- /
// nested-pattern desugars route their arm values through a synthesised local
// (parser.IfChain.value_local) rather than through `return`. The parser has to
// declare that local before it can know what the arms produce, so it types it
// from the first arm's SYNTAX (parser.if_expr_rt), where a bare pattern binder
// reads as i32 — the arm store is then E003 on legal code and the slot the
// lowering sizes is an i32 holding a string. The types exist here, so the
// declaration (and the IIFE's matching return tag) is rewritten to the type the
// arms actually assign.
//
// The pass is conservative in both directions: it rewrites only when every
// store agrees on one resolved type that has a literal zero, and leaves the
// parser's declaration alone otherwise.

// vb_local_name returns the value local a value block routes its arm values
// through — a body shaped `[let v = <zero>; <chain>; return v;]` — or "" for
// any other body. The compiler's own value local may carry the annotation
// settle_literal_locals gave it.
function vb_local_name(body: ast.Stmt[]): string {
  if (body.len() < 3) {
    return "";
  }
  let name: string = "";
  match (body[0]) {
    ast.StmtVar(v) => {
      if (v.type_name.len() > 0 && !parser.is_value_local_name(v.name) || name_has_comma(v.name)) {
        return "";
      }
      name = v.name;
    },
    _ => {
      return "";
    }
  }
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      if (ow_ident_name(r.value) == name) {
        return name;
      }
    },
    _ => {}
  }
  return "";
}

// VbStore is one value stored into a value local: its checked type and the
// expression, which the join reads for an untyped literal.
struct VbStore { t: typeinfo.Type, e: ast.Expr }

// vb_assigned_stores collects every value stored into `name` by the desugar
// chain, threading the scope the chain's own bindings introduce (the tuple
// destructure and the per-arm binder decls the desugar emits).
function vb_assigned_stores(stmts: ast.Stmt[], name: string, s: Scope, acc: VbStore[]): VbStore[] {
  let out: VbStore[] = acc;
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtAssign(a) => {
        if (a.target == name) {
          out = out.append(VbStore { t: check_expr(a.value, cur), e: a.value });
        }
      },
      ast.StmtIf(f) => {
        out = vb_assigned_stores(f.then_body, name, cur, out);
        out = vb_assigned_stores(f.else_body, name, cur, out);
      },
      ast.StmtWhile(w) => {
        out = vb_assigned_stores(w.body, name, cur, out);
      },
      ast.StmtFor(fr) => {
        out = vb_assigned_stores(fr.body, name, for_body_scope(fr, cur), out);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = vb_assigned_stores(arm.body, name, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), out);
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = vb_assigned_stores(one, name, cur, out);
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

// vb_untyped_fits reports whether `e` is a tree of unsuffixed integer literals
// that `t` can hold: such a literal settles to the type the value is declared
// with. Any float holds one.
function vb_untyped_fits(e: ast.Expr, t: typeinfo.Type): boolean {
  if (!int_literal_tree(e)) {
    return false;
  }
  return is_float(t) || is_integer(t) && int_range_diags(e, type_to_irtag(t), false).len() == 0;
}

// vb_pinned_ranges is E047 for a value if's or match's literal arms, at the
// width a typed arm pins: native settles every arm at the joint type, and a
// typed integer arm leaves the literal no room to widen. A tuple pins element
// by element.
function vb_pinned_ranges(ts: typeinfo.Type[], es: ast.Expr[]): util.Diag[] {
  let out: util.Diag[] = [];
  if (ts.len() != es.len() || ts.len() == 0) {
    return out;
  }
  if let typeinfo.TypeTuple(t0) = ts[0] {
    let n: i32 = t0.elements.len();
    let cols: typeinfo.Type[][] = [];
    let ecols: ast.Expr[][] = [];
    let k: i32 = 0;
    while (k < n) {
      cols = cols.append([]);
      ecols = ecols.append([]);
      k = k + 1;
    }
    let i: i32 = 0;
    while (i < ts.len()) {
      if let typeinfo.TypeTuple(ti) = ts[i] {
        if (ti.elements.len() != n) {
          return out;
        }
        let ei: ast.Expr[] = vb_tuple_elems(es[i], n);
        k = 0;
        while (k < n) {
          cols = cols.with(k, cols[k].append(ti.elements[k]));
          ecols = ecols.with(k, ecols[k].append(ei[k]));
          k = k + 1;
        }
      } else {
        return out;
      }
      i = i + 1;
    }
    k = 0;
    while (k < n) {
      out = util.append_diags(out, vb_pinned_ranges(cols[k], ecols[k]));
      k = k + 1;
    }
    return out;
  }
  let pin: string = "";
  let i: i32 = 0;
  while (i < ts.len() && pin.len() == 0) {
    if (is_integer(ts[i]) && !int_literal_tree(es[i])) {
      pin = type_to_irtag(ts[i]);
    }
    i = i + 1;
  }
  if (pin.len() == 0) {
    return out;
  }
  i = 0;
  while (i < es.len()) {
    if (int_literal_tree(es[i])) {
      out = util.append_diags(out, int_range_diags(es[i], pin, false));
    }
    i = i + 1;
  }
  return out;
}

// vb_join joins two stores the way native's widenCompositeByLiterals does: where
// the types disagree and one side is an untyped integer literal the other's type
// holds, the slot takes the other type. A tuple joins element by element, and a
// typed value never widens. The joined expression stays a literal only where
// both sides were, so a later store meets every typed value before it.
function vb_join(a: VbStore, b: VbStore): VbStore {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  if let typeinfo.TypeTuple(at) = a.t {
    if let typeinfo.TypeTuple(bt) = b.t {
      if (at.elements.len() != bt.elements.len()) {
        return VbStore { t: t_unknown("result tuple arities differ"), e: none };
      }
      let aes: ast.Expr[] = vb_tuple_elems(a.e, at.elements.len());
      let bes: ast.Expr[] = vb_tuple_elems(b.e, bt.elements.len());
      let elems: typeinfo.Type[] = [];
      let es: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < at.elements.len()) {
        let j: VbStore = vb_join(VbStore { t: at.elements[i], e: aes[i] }, VbStore { t: bt.elements[i], e: bes[i] });
        if (is_unknown(j.t)) {
          return j;
        }
        elems = elems.append(j.t);
        es = es.append(j.e);
        i = i + 1;
      }
      return VbStore { t: t_tuple(elems), e: ast.ExprTuple { elements: es, line: 0, col: 0 } };
    }
  }
  if let typeinfo.TypeArray(aa) = a.t {
    if let typeinfo.TypeArray(ba) = b.t {
      if (aa.view == ba.view) {
        let j: VbStore = vb_join(mx_elem_store(a.e, aa.elem), mx_elem_store(b.e, ba.elem));
        let t: typeinfo.Type = typeinfo.TypeArray { ...aa, elem: j.t };
        if let ast.ExprUnknown(_) = j.e {
          return VbStore { t: t, e: none };
        }
        return VbStore { t: t, e: a.e };
      }
    }
  }
  let t: typeinfo.Type = join_result_types(a.t, b.t);
  if (is_unknown(t) && vb_untyped_fits(b.e, a.t)) {
    t = a.t;
  } else if (is_unknown(t) && vb_untyped_fits(a.e, b.t)) {
    t = b.t;
  }
  if (!is_unknown(t) && vb_untyped_fits(a.e, t) && vb_untyped_fits(b.e, t)) {
    return VbStore { t: t, e: a.e };
  }
  return VbStore { t: t, e: none };
}

// vb_tuple_elems is a tuple literal's elements, or `n` unknowns for any other
// expression, whose elements are typed values.
function vb_tuple_elems(e: ast.Expr, n: i32): ast.Expr[] {
  if let ast.ExprTuple(t) = e {
    if (t.elements.len() == n) {
      return t.elements;
    }
  }
  let out: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(ast.ExprUnknown { kind: "", line: 0, col: 0 });
    i = i + 1;
  }
  return out;
}

// vb_arms_unified is vb_stores_unified over a value if's or match's arm
// results, or vb_unified when the expressions do not line up with the types.
function vb_arms_unified(ts: typeinfo.Type[], es: ast.Expr[]): typeinfo.Type {
  if (ts.len() != es.len()) {
    return vb_unified(ts);
  }
  let ss: VbStore[] = [];
  let i: i32 = 0;
  while (i < ts.len()) {
    ss = ss.append(VbStore { t: ts[i], e: es[i] });
    i = i + 1;
  }
  return vb_stores_unified(ss);
}

// vb_stores_unified is vb_unified over the stores themselves, so an untyped
// literal settles to the width another arm needs.
function vb_stores_unified(ss0: VbStore[]): typeinfo.Type {
  if (ss0.len() == 0) {
    return t_unknown("value block stores nothing");
  }
  let ss: VbStore[] = [];
  for st in ss0 {
    if (!unbound_enum_argument(st.t)) {
      ss = ss.append(st);
    }
  }
  if (ss.len() == 0) {
    return ss0[0].t;
  }
  let acc: VbStore = ss[0];
  let i: i32 = 1;
  while (i < ss.len() && !is_unknown(acc.t)) {
    acc = vb_join(acc, ss[i]);
    i = i + 1;
  }
  if (is_unknown(acc.t) && ss.len() > 1) {
    return t_unknown("value block arms disagree");
  }
  return acc.t;
}

// vb_unified returns the type every store agrees on, or unknown when they
// disagree, one is unresolved, or nothing is stored at all.
function vb_unified(ts: typeinfo.Type[]): typeinfo.Type {
  if (ts.len() == 0) {
    return t_unknown("value block stores nothing");
  }
  let k: i32 = 0;
  while (k < ts.len() - 1 && unbound_enum_argument(ts[k])) {
    k = k + 1;
  }
  let first: typeinfo.Type = ts[k];
  if (is_unknown(first)) {
    return first;
  }
  let i: i32 = k + 1;
  while (i < ts.len()) {
    first = join_result_types(first, ts[i]);
    if (is_unknown(first)) {
      return t_unknown("value block arms disagree");
    }
    i = i + 1;
  }
  return first;
}

// vb_store_type is the type a value-LOCAL block evaluates to: the one type
// every store into its value local agrees on, or unknown. `s` is the scope the
// block itself sits in.
function vb_store_type(body: ast.Stmt[], name: string, s: Scope): typeinfo.Type {
  let chain: ast.Stmt[] = [];
  let i: i32 = 1;
  while (i < body.len() - 1) {
    chain = chain.append(body[i]);
    i = i + 1;
  }
  let none: VbStore[] = [];
  return vb_stores_unified(vb_assigned_stores(chain, name, bind_stmt(body[0], s), none));
}

// vb_local_tag names `t` as the value local's declaration spells it, or "" for a
// type with no literal zero to declare it with (a struct, an array, a tuple),
// which keeps the parser's declaration.
function vb_local_tag(t: typeinfo.Type): string {
  // A `str` VIEW is spelled "string" by the lowering's tag vocabulary but has no
  // literal to declare a local with — `""` is an OWNED string — so it keeps the
  // parser's declaration, like the aggregates.
  if (type_label(t) == "str") {
    return "";
  }
  let tag: string = type_to_irtag(t);
  if (tag == "string" || tag == "boolean" || tag == "f64" || tag == "f32" || tag == "char"
    || tag == "i32" || tag == "i64" || tag == "u32" || tag == "u64" || tag == "u8") {
    return tag;
  }
  return "";
}

// vb_annotation_of spells a value local's type the way a declaration would,
// for the types vb_local_tag declines: a struct or enum, an array of one, a
// tuple, a function. A `str` view stays unspelled — nothing writable declares one.
function vb_annotation_of(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeStruct(_) => {
      return type_label(t);
    },
    typeinfo.TypeTuple(_) => {
      return type_label(t);
    },
    typeinfo.TypeFunc(_) => {
      return typeinfo.spelling(t);
    },
    typeinfo.TypeArray(a) => {
      if (type_label(a.elem) == "str") {
        return "";
      }
      // Keep the checked namespace until method calls have been resolved.
      // The AST lowering erases views only after the typed module is built.
      return typeinfo.spelling(t);
    },
    typeinfo.TypeUnion(u) => {
      if (u.args.len() == 0) {
        return "";
      }
      return type_label(t);
    },
    _ => {
      return "";
    }
  }
  return "";
}

// vb_wants_annotation reports whether `t` is a composite the destination's
// spelling may declare the value local with when the stores leave it partial.
function vb_wants_annotation(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnion(_) => {
      return true;
    },
    typeinfo.TypeStruct(_) => {
      return true;
    },
    typeinfo.TypeArray(_) => {
      return true;
    },
    typeinfo.TypeTuple(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// vb_placeholder_decl reports whether `v` is a value local the compiler declared
// with an annotation and the parser's `0` placeholder: the annotation types the
// slot and the placeholder only zeroes it, so it is not an assignment to check.
function vb_placeholder_decl(v: ast.StmtVar): boolean {
  if (!parser.is_value_local_name(v.name) || v.type_name.len() == 0) {
    return false;
  }
  match (v.init) {
    ast.ExprNumber(n) => {
      return n.text == "0" && n.suffix.len() == 0 && !n.is_float;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// vb_zero_of builds the declaration placeholder for a value local of type
// `tag`. The integer widths carry their suffix: the local is declared
// unannotated, so a bare `0` is what makes it an i32 — the width and the
// signedness have nowhere else to be recorded, and the store the arms make is checked
// against exactly this declaration.
function vb_zero_of(tag: string): ast.Expr {
  if (tag == "string") {
    return ast.ExprString { value: "", line: 0, col: 0 };
  }
  if (tag == "boolean") {
    return ast.ExprBool { value: false, line: 0, col: 0 };
  }
  if (tag == "f64") {
    return ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: true, line: 0, col: 0 };
  }
  if (tag == "f32") {
    return ast.ExprUnary { op: "as_f32", operand: vb_zero_of("f64"), line: 0, col: 0, ty: "f32" };
  }
  if (tag == "i32") {
    return ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 };
  }
  return ast.ExprNumber { text: "0", suffix: tag, raw: "", is_float: false, line: 0, col: 0 };
}

// vb_retype rewrites one value block whose value local the arms contradict.
// Everything else — including a value block whose local the parser already
// typed correctly — is returned untouched.
function vb_retype(e: ast.Expr, s: Scope): ast.Expr {
  return vb_retype_dest(e, s, "");
}

// vb_retype_dest is vb_retype with the annotation of the binding the block
// initialises, for a type the stores name only partially — an enum whose
// arguments the construction leaves open spells `Option`, and only the
// destination says `Option[i32]`.
function vb_retype_dest(e: ast.Expr, s: Scope, dest: string): ast.Expr {
  match (e) {
    ast.ExprCall(c) => {
      if (!parser.is_value_block(c)) {
        return e;
      }
      let body: ast.Stmt[] = parser.vb_body(c);
      let name: string = vb_local_name(body);
      if (name.len() == 0) {
        return e;
      }
      let want: typeinfo.Type = vb_store_type(body, name, s);
      if (is_unknown(want)) {
        return e;
      }
      let tag: string = vb_local_tag(want);
      let nbody: ast.Stmt[] = [];
      match (body[0]) {
        ast.StmtVar(v) => {
          if (type_eq(check_expr(v.init, s), want)) {
            return e;
          }
          if (tag.len() > 0) {
            nbody = nbody.append(ast.StmtVar { ...v, init: vb_zero_of(tag) });
          } else {
            // No literal zero exists for the type (a struct, an enum, an
            // array, a tuple): the local keeps the parser's placeholder and
            // gains the annotation, so the declaration alone types it — the
            // arms write the slot before anything reads it (#8777).
            tag = vb_annotation_of(want);
            if (tag.len() == 0 && dest.len() > 0 && !parser.is_destr_marker(dest) && vb_wants_annotation(want)) {
              tag = dest;
            }
            if (tag.len() == 0) {
              return e;
            }
            nbody = nbody.append(ast.StmtVar { ...v, type_name: tag });
          }
        },
        _ => {
          return e;
        }
      }
      let j: i32 = 1;
      while (j < body.len()) {
        nbody = nbody.append(body[j]);
        j = j + 1;
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          return ast.ExprCall { ...c, callee: ast.ExprLambda { ...lm, ret_type: tag, body: nbody } };
        },
        _ => {
          return e;
        }
      }
    },
    _ => {
      return e;
    }
  }
  return e;
}

// pretype_expr rewrites every value block one expression holds. The walk claims
// two node kinds and descends into everything else:
//
//   - a value block: its body is rewritten first, so a block nested inside
//     another is retyped before the store that reads it is typed, and the
//     block itself is then retyped in the scope it sits in;
//   - a lambda: its body is rewritten as STATEMENTS in the lambda's own scope.
//     The value local's type is read off the arm stores, and inside a lambda
//     those name the lambda's parameters and locals, which the enclosing scope
//     does not hold; and a `let` inside the lambda supplies the destination
//     annotation exactly as one outside does.
//
// The scope is carried in the accumulator unchanged: the walk never rebinds it, so
// every sibling reads the same one.
function pretype_expr(e: ast.Expr, s: Scope): ast.Expr {
  let (ne, ns, nh) = astwalk.map_expr_acc(e, s, pretype_at_stmt, pretype_at_expr);
  return ne;
}

function pretype_at_stmt(st: ast.Stmt, s: Scope): (ast.Stmt, Scope, boolean) {
  return (st, s, false);
}

function pretype_at_expr(x: ast.Expr, s: Scope): (ast.Expr, Scope, boolean) {
  match (x) {
    ast.ExprCall(c) => {
      if (use_untyped(c)) {
        let uc: ast.ExprCall = use_typed(c, s);
        let nargs: ast.Expr[] = [];
        for arg in uc.args {
          nargs = nargs.append(pretype_expr(arg, s));
        }
        return (ast.ExprCall { ...uc, callee: pretype_expr(uc.callee, s), args: nargs }, s, true);
      }
      if (!parser.is_value_block(c)) {
        return (x, s, false);
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          let body: ast.Stmt[] = struct_record_value_body(lm, s);
          let inner: ast.Expr = ast.ExprCall { ...c, callee: ast.ExprLambda { ...lm, body: pretype_stmts(body, s) } };
          return (vb_retype(inner, s), s, true);
        },
        _ => {
          return (x, s, false);
        }
      }
    },
    ast.ExprLambda(lm) => {
      return (ast.ExprLambda { ...lm, body: pretype_stmts(lm.body, lambda_body_scope(lm, s)) }, s, true);
    },
    _ => {
      return (x, s, false);
    }
  }
  return (x, s, false);
}

function pretype_tuple_if(f: ast.StmtIf, s: Scope): ast.StmtIf {
  let ready: ast.StmtIf = f;
  if (f.sugar.origin == "" && f.sugar.tup.len() > 0) {
    if let typeinfo.TypeTuple(tuple) = check_expr(f.sugar.scrut, s) {
      let wrong: boolean = false;
      for arm in f.sugar.tup {
        if (!arm.is_wild && arm.elem_kinds.len() != tuple.elements.len()) {
          wrong = true;
        }
      }
      if (wrong) {
        if let ast.StmtIf(rebuilt) = parser.build_tuple_match_sized(f.sugar.scrut, f.sugar.tup, tuple.elements.len(), f.sugar.line, f.sugar.col) {
          ready = rebuilt;
        }
      }
    }
  }
  return ready;
}

function pretype_if(st: ast.Stmt, f: ast.StmtIf, s: Scope): ast.Stmt {
  if let Some(m) = parser.struct_record_source(st) {
    if (struct_record_match(m, s)) {
      return pretype_stmt(parser.lower_struct_record_match(m, ""), s);
    }
  }
  let ready: ast.StmtIf = pretype_tuple_if(f, s);
  return ast.StmtIf { ...ready, cond: pretype_expr(ready.cond, s), then_body: pretype_stmts(ready.then_body, s), else_body: pretype_stmts(ready.else_body, s) };
}

function pretype_match(m: ast.StmtMatch, s: Scope): ast.Stmt {
  if (struct_record_match(m, s)) {
    return pretype_stmt(parser.lower_struct_record_match(m, ""), s);
  }
  let narms: ast.MatchArm[] = [];
  let whole: typeinfo.Type = check_expr(m.scrutinee, s);
  for arm0 in m.arms {
    let arm: ast.MatchArm = ast.MatchArm { ...arm0, pattern: rescope_pattern(arm0.pattern, whole, s) };
    let asc: Scope = annotate_arm_scope(arm, s, whole);
    let g: ast.Expr = arm.guard;
    if (arm.has_guard) {
      g = pretype_expr(arm.guard, asc);
    }
    narms = narms.append(ast.MatchArm { ...arm, body: pretype_stmts(arm.body, asc), guard: g });
  }
  return ast.StmtMatch { ...m, scrutinee: pretype_expr(m.scrutinee, s), arms: narms };
}

function pretype_stmt(st: ast.Stmt, s: Scope): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      let init: ast.Expr = pretype_expr(v.init, s);
      if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name)) {
        init = vb_retype_dest(init, s, v.type_name);
      }
      return ast.StmtVar { ...v, init: init };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: pretype_expr(r.value, s) };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: pretype_expr(x.value, s) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: pretype_expr(a.value, s) };
    },
    ast.StmtIf(f) => {
      return pretype_if(st, f, s);
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, cond: pretype_expr(w.cond, s), body: pretype_stmts(w.body, s) };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { ...fr, iter: pretype_expr(fr.iter, s), body: pretype_stmts(fr.body, for_body_scope(fr, s)) };
    },
    ast.StmtMatch(m) => {
      return pretype_match(m, s);
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: pretype_stmt(d.action, s) };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function pretype_stmts(stmts: ast.Stmt[], s: Scope): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let cur: Scope = s;
  for stmt in stmts {
    out = out.append(pretype_stmt(stmt, cur));
    cur = bind_stmt(stmt, cur);
  }
  return out;
}

// pretype_at is the pre-scan's per-node contribution: a value block that
// routes its value through a local, or a `use` binding with no annotation.
function pretype_at(x: ast.Expr, own acc: boolean): boolean {
  if (acc) {
    return true;
  }
  match (x) {
    ast.ExprCall(c) => {
      if (use_untyped(c)) {
        return true;
      }
      if (!parser.is_value_block(c)) {
        return false;
      }
      return vb_local_name(parser.vb_body(c)).len() > 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// Pattern variants are named by the scrutinee (#10922). The module bundler
// resolves a bare variant name lexically, so with std/net loaded an arm's
// `Other` names `net__Other` even when the match is on an IoError. Wherever a
// bare name is spelled by more than one variant, pretype_stmt renames an arm
// to the member of the scrutinee's enum that spells it, which is what native
// resolves the pattern against.

// colliding_variant_names lists each bare variant name that two variants of
// the module's enums, or of the built-in ones, spell.
function colliding_variant_names(mod: parser.Module): string[] {
  let full: string[] = [];
  for ed in mod.enums {
    for vn in ed.variant_names {
      full = full.append(vn);
    }
  }
  for sd in parser.inject_builtin_enums([]) {
    if (sd.enum_owner.len() > 0) {
      full = full.append(sd.name);
    }
  }
  let seen: string[] = [];
  let seen_full: string[] = [];
  let out: string[] = [];
  let i: i32 = 0;
  while (i < full.len()) {
    let b: string = variant_bare_name(full[i]);
    let at: i32 = util.index_of_str(seen, b);
    if (at < 0) {
      seen = seen.append(b);
      seen_full = seen_full.append(full[i]);
    } else if (seen_full[at] != full[i] && !util.has_str(out, b)) {
      out = out.append(b);
    }
    i = i + 1;
  }
  return out;
}

// variant_bare_name is a variant's name without its module prefix.
function variant_bare_name(name: string): string {
  let i: i32 = name.len() - 2;
  while (i > 0) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      return slice_unchecked(name, i + 2, name.len()) + "";
    }
    i = i - 1;
  }
  return name;
}

// rescope_pattern renames an unqualified variant pattern to the member of the
// scrutinee's enum that spells the same bare name, when it names another
// enum's variant.
function rescope_pattern(p: ast.Pattern, whole: typeinfo.Type, s: Scope): ast.Pattern {
  if let ast.PatVariant(pv) = p {
    if (variant_pattern_qualified(pv.type_name)) {
      return p;
    }
    if let typeinfo.TypeUnion(u) = whole {
      let members: string[] = enum_members(s, u.name, pv.type_name);
      if (util.has_str(members, pv.type_name)) {
        return p;
      }
      let bare: string = variant_bare_name(pv.type_name);
      for v in members {
        if (variant_bare_name(v) == bare) {
          return ast.PatVariant { ...pv, type_name: v };
        }
      }
    }
  }
  return p;
}

// enum_members is the variant names of enum `name`: its union signature's, or
// for a built-in enum outside the table (IoError, Body) the
// injected variant declarations it owns. The built-ins are read only for a
// module-prefixed `variant`, the one spelling that can name another enum's.
function enum_members(s: Scope, name: string, variant: string): string[] {
  let us: UnionSig = s.lookup_union(name);
  if (us.name.len() > 0) {
    return us.variants;
  }
  let out: string[] = [];
  if (variant_bare_name(variant).len() == variant.len()) {
    return out;
  }
  for sd in parser.inject_builtin_enums([]) {
    if (sd.enum_owner == name) {
      out = out.append(sd.name);
    }
  }
  return out;
}

struct RescopeScan { coll: string[], found: boolean }

function rescope_at_stmt(st: ast.Stmt, own a: RescopeScan): RescopeScan {
  if (a.found) {
    return a;
  }
  if (pretype_needed_stmt(st, false)) {
    return RescopeScan { ...a, found: true };
  }
  if let ast.StmtMatch(m) = st {
    for arm in m.arms {
      if let ast.PatVariant(pv) = arm.pattern {
        if (parser.is_record_pattern(pv) || util.has_str(a.coll, variant_bare_name(pv.type_name))) {
          return RescopeScan { ...a, found: true };
        }
      }
    }
  }
  return a;
}

function rescope_at_expr(e: ast.Expr, own a: RescopeScan): RescopeScan {
  if (!a.found && pretype_at(e, false)) {
    return RescopeScan { ...a, found: true };
  }
  return a;
}

// One scan finds value blocks, unresolved record patterns, and colliding variant names.
function needs_pretype_or_rescope(stmts: ast.Stmt[], coll: string[]): boolean {
  let a: RescopeScan = RescopeScan { coll: coll, found: false };
  for stmt in stmts {
    a = astwalk.fold_stmt_nodes(stmt, a, rescope_at_stmt, rescope_at_expr, astwalk.descend_all);
  }
  return a.found;
}

// Record spelling also names enum variants. Resolve the scrutinee before this desugar.
function struct_record_match(m: ast.StmtMatch, s: Scope): boolean {
  let head: string = parser.struct_record_head(m);
  if (head.len() == 0) {
    return false;
  }
  if let typeinfo.TypeStruct(st) = check_expr(m.scrutinee, s) {
    let sig: StructSig = s.lookup_struct(st.name);
    return sig.name == st.name && sig.enum_owner.len() == 0 && head == st.name;
  }
  return false;
}

function struct_record_value_body(lm: ast.ExprLambda, s: Scope): ast.Stmt[] {
  if (lm.origin != parser.ORIGIN_MATCH_EXPR) {
    return lm.body;
  }
  if (lm.body.len() == 1) {
    if let Some(m) = parser.struct_record_source(lm.body[0]) {
      if (struct_record_match(m, s)) {
        return parser.struct_record_value_body(m, lm.ret_type);
      }
    }
  }
  let value: string = vb_local_name(lm.body);
  if (value.len() > 0) {
    if let Some(m) = parser.struct_record_source(lm.body[1]) {
      if (struct_record_match(m, s)) {
        return lm.body.with(1, parser.lower_struct_record_match(m, value));
      }
    }
  }
  return lm.body;
}

function pretype_needed_stmt(st: ast.Stmt, own found: boolean): boolean {
  if (found) {
    return true;
  }
  if let ast.StmtIf(f) = st {
    return f.sugar.origin == "" && f.sugar.tup.len() > 0;
  }
  return false;
}

// use_untyped reports whether `c` is the source call of a `use NAME <- CALL;`
// with something still to type: the parser appended the callback lambda as
// CALL's last argument with no return type, and with `use_infer` set and its
// parameter untyped when the author wrote no `: TYPE`.
function use_untyped(c: ast.ExprCall): boolean {
  if (c.args.len() == 0) {
    return false;
  }
  if let ast.ExprLambda(lm) = c.args[c.args.len() - 1] {
    if (lm.origin != parser.ORIGIN_USE || lm.params.len() == 0) {
      return false;
    }
    return lm.ret_type.len() == 0 || lm.use_infer && lm.params[0].type_name.len() == 0;
  }
  return false;
}

// use_callback_type is the callee's trailing callable parameter, the slot the
// callback is passed into (native inferUseParam): what the `use` binding is
// typed from, and what the callback returns. A value binding shadows a module
// function of the same name (#6302), so it is read first. Unknown when the
// callee is not a bare name, is not callable, or its trailing parameter is not
// a callable taking a parameter; E032 reports those. A generic callee's type
// parameters are bound from the arguments written before the callback, and
// one they leave unbound leaves the binding unannotated as well.
function use_callback_type(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if let ast.ExprIdent(id) = c.callee {
    let last: typeinfo.Type = t_unknown("use: callee has no signature");
    if let typeinfo.TypeFunc(ft) = s.lookup(id.name) {
      if (ft.param_types.len() > 0) {
        last = ft.param_types[ft.param_types.len() - 1];
      }
    } else {
      let sig: FuncSig = s.lookup_sig(id.name);
      if (sig.param_types.len() > 0) {
        last = use_callback_slot(sig, c, s);
      }
    }
    if let typeinfo.TypeFunc(cb) = last {
      if (cb.params_known && cb.param_types.len() > 0) {
        return last;
      }
    }
  }
  return t_unknown("use: callee has no signature");
}

// use_binding_type is the type a `use` binding takes: the first parameter of
// the callback slot.
function use_binding_type(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if let typeinfo.TypeFunc(cb) = use_callback_type(c, s) {
    return cb.param_types[0];
  }
  return t_unknown("use: callee has no signature");
}

// use_callback_slot is the callback parameter of `sig`, the last, instantiated
// by the arguments written before it (native inferUseParam):
// `each[T](items: T[], cb: (T) => i32)` given an i32[] takes an (i32) => i32.
function use_callback_slot(sig: FuncSig, c: ast.ExprCall, s: Scope): typeinfo.Type {
  let at: i32 = sig.param_types.len() - 1;
  if (sig.all_type_params.len() == 0 || at >= sig.param_type_names.len()) {
    return sig.param_types[at];
  }
  let written: ast.Expr[] = [];
  let i: i32 = 0;
  while (i + 1 < c.args.len()) {
    written = written.append(c.args[i]);
    i = i + 1;
  }
  let (bn, bt) = arg_bindings(sig, ast.ExprCall { ...c, args: written }, s);
  let slot: parser.TypeRef = sig_param_ref(sig, at);
  let f: parser.TypeRef = parser.ref_ungroup(slot);
  if (!parser.ref_is_fn_value(slot) || f.args.len() < 2) {
    return sig.param_types[at];
  }
  let unbound: string[] = [];
  for tp in sig.all_type_params {
    if (!util.has_str(bn, tp)) {
      unbound = unbound.append(tp);
    }
  }
  if (type_ref_names_any(f.args[0], unbound)) {
    return t_unknown("use: callback parameter names an unbound type parameter");
  }
  let whole: typeinfo.Type = type_from_ref_subst(slot, bn, bt, s.type_names());
  if (type_ref_names_any(parser.ref_fn_result(slot), unbound)) {
    if let typeinfo.TypeFunc(cb) = whole {
      return typeinfo.TypeFunc { ...cb, ret_type: t_unknown("use: callback result names an unbound type parameter") };
    }
  }
  return whole;
}

// use_typed stamps the `use` binding's parameter with its inferred type, so
// the body reads the binding at that type and a lift of the callback carries a
// typed declaration, and the callback's return type with the slot's, so a `?`
// or an `Ok` in the rest of the block is typed against what the callee hands
// back rather than inferred from the block's returns alone. A binding type
// with no declaration spelling leaves the call as written.
function use_typed(c: ast.ExprCall, s: Scope): ast.ExprCall {
  let cbt: typeinfo.Type = use_callback_type(c, s);
  let t: typeinfo.Type = t_unknown("use: callee has no signature");
  if let typeinfo.TypeFunc(cb) = cbt {
    t = cb.param_types[0];
  }
  let at: i32 = c.args.len() - 1;
  if let ast.ExprLambda(lm) = c.args[at] {
    let p: ast.ParamDecl = lm.params[0];
    if (p.type_name.len() == 0) {
      p = decltypes.fn_param_from_type(p.name, t);
    }
    if (p.type_name.len() == 0) {
      let sp: string = typeinfo.spelling(t);
      if (sp.len() == 0) {
        return c;
      }
      p = ast.ParamDecl { ...lm.params[0], type_name: sp };
    }
    let nparams: ast.ParamDecl[] = [p];
    let i: i32 = 1;
    while (i < lm.params.len()) {
      nparams = nparams.append(lm.params[i]);
      i = i + 1;
    }
    let nargs: ast.Expr[] = [];
    let j: i32 = 0;
    while (j < at) {
      nargs = nargs.append(c.args[j]);
      j = j + 1;
    }
    nargs = nargs.append(use_ret_typed(ast.ExprLambda { ...lm, params: nparams }, cbt));
    return ast.ExprCall { ...c, args: nargs };
  }
  return c;
}

// use_ret_typed is `lm` returning what the callback slot `cbt` returns. A
// result the slot leaves unknown, or one with no declaration spelling, leaves
// the lambda's result to its enclosing function when that result is known.
function use_ret_typed(lm: ast.ExprLambda, cbt: typeinfo.Type): ast.ExprLambda {
  if (lm.ret_type.len() > 0) {
    return lm;
  }
  if let typeinfo.TypeFunc(cb) = cbt {
    if (is_unknown(cb.ret_type)) {
      return lm;
    }
    let d: ast.ParamDecl = decltypes.param_from_type("", cb.ret_type);
    if (d.type_name.len() == 0) {
      return lm;
    }
    return ast.ExprLambda { ...lm, ret_type: d.type_name, ret_fn_ret: d.fn_ret, ret_fn_param_types: d.fn_param_types };
  }
  return lm;
}

// pretype_module re-declares what the parser typed from syntax alone before
// anything is typed against it: a value-block local gets the type its arms
// assign, and an unannotated `use` binding the type its callee's callback
// slot spells. Runs ahead of the checker's own diagnostics and of lowering, so
// both see one declaration.
pub function pretype_module(mod: parser.Module): parser.Module {
  let coll: string[] = colliding_variant_names(mod);
  if (needs_pretype_or_rescope(mod.top_stmts, coll)) {
    return pretype_module_in(mod, module_env(mod), whole_focus(mod));
  }
  for fd in mod.funcs {
    if (needs_pretype_or_rescope(fd.body, coll)) {
      return pretype_module_in(mod, module_env(mod), whole_focus(mod));
    }
  }
  return mod;
}

function pretype_module_in(mod: parser.Module, env: ModuleEnv, focus: Focus): parser.Module {
  // Keep untouched functions and avoid rebuilding bodies with nothing to retype.
  let coll: string[] = colliding_variant_names(mod);
  let top_hit: boolean = focus.top && needs_pretype_or_rescope(mod.top_stmts, coll);
  let hits: boolean[] = [];
  let any: boolean = top_hit;
  let k: i32 = 0;
  for fn in mod.funcs {
    let hit: boolean = focus.funcs[k] && needs_pretype_or_rescope(fn.body, coll);
    k = k + 1;
    hits = hits.append(hit);
    if (hit) {
      any = true;
    }
  }
  if (!any) {
    return mod;
  }
  let nfuncs: parser.FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let func: parser.FuncDecl = mod.funcs[i];
    if (hits[i]) {
      let fs: Scope = build_func_scope(func, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
      nfuncs = nfuncs.append(parser.FuncDecl { ...func, body: pretype_stmts(func.body, fs) });
    } else {
      nfuncs = nfuncs.append(func);
    }
    i = i + 1;
  }
  let ntop: ast.Stmt[] = mod.top_stmts;
  if (top_hit) {
    ntop = pretype_stmts(mod.top_stmts, new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs));
  }
  return parser.Module { ...mod, funcs: nfuncs, top_stmts: ntop };
}

// ---------------------------------------------------------------------------
// Literal locals (#10123).
//
// An unannotated local seeded by an untyped integer — `let x = 5`, or the
// variable of a range loop over untyped bounds — takes ONE integer type: the
// first use that fixes a width decides it, and it is i32 when no use does.
// Native settles such a local while it types the body
// (internal/check/checker/literal_local.go). This checker types from an immutable
// AST, so settle_literal_locals infers each local's width first and writes it
// into the source: an annotation on the `let`, a suffix on the literals of the
// range bounds. The checker and the lowering then read one declared type. An
// local whose class stays open is left as written.
//
// The inference is union-find over the literal locals of one function. Two
// locals an untyped expression joins (`let y = x + 1`, `x < y`, `x = y`) share
// a class; a use that reads a class member at a typed integer (an annotated
// destination, a typed operand, a parameter, a return) fixes the class unless
// an earlier use already did. A later, different width is left for the checker
// to report against the declaration this pass writes.
//
// A generic call whose type parameter only untyped literals bind takes the
// width of the position that reads it, the way native's
// settleGenericCallByHint settles it (#10176): `let x: (u64, u64) = both(1,
// 2)` is `both(1u64, 2u64)`. The pass records that width against each literal
// argument (cargs / ctags) and writes it as the literal's suffix. A call no
// position types keeps its default: i32, or i64 for a wide literal argument.
// Float locals and tuple/array components keep classes too. Integer locals
// read by a float arm keep their integer representation: the rewrite converts
// that read, including arithmetic over it, instead of changing other uses.

// pend holds the open generic reads a literal local was compared or combined
// with: each takes the width pend_id's class settles at, once the body is walked.
// skeys / snames / sargs / sids record each generic struct local (#10453):
// its declaration's key, the struct, each type argument's spelling, and the
// class of each argument only untyped literals bound (-1 for one a typed field
// bound). sargs and sids are flat; sfirst[j] is struct j's first argument.
// wkeys / wtags are the declarations whose whole type a widening already
// decided: an array of generic struct literals a typed sibling widened.
// tkeys / ttypes keep tuple, array and float locals with classes in their
// component types. cargs / ctags also carry float conversions keyed by the
// expression's position; generic argument keys use a separate `c` prefix.
struct LitInfer { parent: i32[], width: typeinfo.Type[], keys: string[], cargs: string[], ctags: string[], pend: ast.Expr[], pend_id: i32[], pend_scope: Scope[], skeys: string[], snames: string[], sfirst: i32[], sargs: string[], sids: i32[], wkeys: string[], wtags: string[], eargs: string[], eids: i32[], tkeys: string[], ttypes: typeinfo.Type[] }

struct LitRewrite { keys: string[], tags: string[], cargs: string[], ctags: string[] }

const LIT_MARK: string = "literal local #";

// LIT_WIDE is the class every wide literal in an untyped tree belongs to, fixed
// at i64: linked with no destination the tree defaults to i64, and a
// destination still fixes the tree's open locals at its own width.
const LIT_WIDE: i32 = 0;

// A literal local is bound in the inference scope under a marker type naming
// its class, so the checker's own scoping decides which declaration a name
// reads.
function lit_marker(k: i32): typeinfo.Type {
  return t_unknown(LIT_MARK + util.i32_to_string(k));
}

function lit_id(t: typeinfo.Type): i32 {
  if let typeinfo.TypeUnknown(u) = t {
    let n: i32 = LIT_MARK.len();
    if (u.reason.len() <= n || slice_unchecked(u.reason, 0, n) != LIT_MARK) {
      return 0 - 1;
    }
    let k: i32 = 0;
    let i: i32 = n;
    while (i < u.reason.len()) {
      k = k * 10 + u.reason[i] as i32 - 48;
      i = i + 1;
    }
    return k;
  }
  return 0 - 1;
}

const LIT_STRUCT_MARK: string = "literal struct #";

// A generic struct local whose type arguments untyped literals bound is bound
// under a marker naming its struct and the class of each argument, -1 for one
// a typed field bound: `Same|3`.
function lit_struct_marker(name: string, ids: i32[]): typeinfo.Type {
  let spelled: string = LIT_STRUCT_MARK + name + "|";
  let i: i32 = 0;
  while (i < ids.len()) {
    if (i > 0) {
      spelled = spelled + ",";
    }
    spelled = spelled + util.i32_to_string(ids[i]);
    i = i + 1;
  }
  return t_unknown(spelled);
}

// lit_struct_of reads a struct-local marker back: the struct and the class of
// each argument. ("", []) for any other type.
function lit_struct_of(t: typeinfo.Type): (string, i32[]) {
  let none: i32[] = [];
  if let typeinfo.TypeUnknown(u) = t {
    let n: i32 = LIT_STRUCT_MARK.len();
    if (u.reason.len() <= n || slice_unchecked(u.reason, 0, n) != LIT_STRUCT_MARK) {
      return ("", none);
    }
    let bar: i32 = util.index_of_sub(u.reason, "|");
    let ids: i32[] = [];
    let k: i32 = 0;
    let neg: boolean = false;
    let i: i32 = bar + 1;
    while (i <= u.reason.len()) {
      if (i == u.reason.len() || u.reason[i] as i32 == 44) {
        if (neg) {
          k = 0 - k;
        }
        ids = ids.append(k);
        k = 0;
        neg = false;
      } else if (u.reason[i] as i32 == 45) {
        neg = true;
      } else {
        k = k * 10 + u.reason[i] as i32 - 48;
      }
      i = i + 1;
    }
    return (slice_unchecked(u.reason, n, bar) + "", ids);
  }
  return ("", none);
}

// lit_struct_read reports whether `e` reads a generic struct local whole.
function lit_struct_read(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprIdent(id) = e {
    let (name, ids) = lit_struct_of(s.lookup(id.name));
    return name.len() > 0;
  }
  return false;
}

function lit_enum_read(e: ast.Expr, s: Scope): boolean {
  if let typeinfo.TypeUnion(u) = check_expr(e, s) {
    for arg in u.args {
      if (lit_id(arg) >= 0) {
        return true;
      }
    }
  }
  return false;
}

// lit_struct_field_class is the class a read `obj.field` reads when obj is a
// generic struct local and the field is declared at a literal-bound type
// parameter, else -1.
function lit_struct_field_class(fa: ast.ExprFieldAccess, s: Scope): i32 {
  if let ast.ExprIdent(oid) = fa.obj {
    let (name, ids) = lit_struct_of(s.lookup(oid.name));
    if (name.len() == 0) {
      return 0 - 1;
    }
    let sig: StructSig = s.lookup_struct(name);
    let fi: i32 = field_index(sig, fa.field);
    if (fi < 0 || fi >= sig.field_type_names.len()) {
      return 0 - 1;
    }
    let ti: i32 = util.index_of_str(sig.type_params, sig.field_type_names[fi]);
    if (ti >= 0 && ti < ids.len()) {
      return ids[ti];
    }
  }
  return 0 - 1;
}

// lit_tree reports whether `e` is an untyped integer tree — unsuffixed
// literals and literal locals under sign and arithmetic operators, the shape
// native's settleInt descends — and appends the literal locals it reads.
function lit_tree(e: ast.Expr, s: Scope, ids: i32[]): (boolean, i32[]) {
  match (e) {
    ast.ExprNumber(_) => {
      if (unsettled_int_literal(e)) {
        return (true, ids);
      }
      if (int_literal_tree(e)) {
        return (true, ids.append(LIT_WIDE));
      }
      return (false, ids);
    },
    ast.ExprIdent(id) => {
      let k: i32 = lit_id(s.lookup(id.name));
      if (k < 0) {
        return (false, ids);
      }
      return (true, ids.append(k));
    },
    ast.ExprFieldAccess(fa) => {
      let fk: i32 = lit_struct_field_class(fa, s);
      if (fk < 0) {
        return (false, ids);
      }
      return (true, ids.append(fk));
    },
    ast.ExprUnary(u) => {
      if (u.op == "-" || u.op == "+") {
        if (unsettled_int_literal(e)) {
          return (true, ids);
        }
        return lit_tree(u.operand, s, ids);
      }
      return (false, ids);
    },
    ast.ExprBinary(b) => {
      if (!int_operand_op(b.op)) {
        return (false, ids);
      }
      let (l, lids) = lit_tree(b.left, s, ids);
      let (r, rids) = lit_tree(b.right, s, lids);
      return (l && r, rids);
    },
    _ => {
      return (false, ids);
    }
  }
  return (false, ids);
}

function lit_find(st: LitInfer, k: i32): i32 {
  let r: i32 = k;
  while (st.parent[r] != r) {
    r = st.parent[r];
  }
  return r;
}

function lit_new(st: LitInfer, key: string): LitInfer {
  return LitInfer { ...st, parent: st.parent.append(st.parent.len()), width: st.width.append(t_unknown("open")), keys: st.keys.append(key) };
}

// lit_fix fixes open integer classes, or a float class at a concrete float
// width. An integer local cannot acquire a float representation here.
function lit_fix(st: LitInfer, ids: i32[], w: typeinfo.Type): LitInfer {
  if (!is_integer(w) && !is_float(w)) {
    return st;
  }
  let out: LitInfer = st;
  for k in ids {
    let r: i32 = lit_find(out, k);
    if (is_unknown(out.width[r]) && is_integer(w) || is_poly_float(out.width[r]) && is_float(w)) {
      out = LitInfer { ...out, width: out.width.with(r, w) };
    }
  }
  return out;
}

// lit_link joins the classes of `ids`. Two classes already fixed stay apart:
// their members disagree, and the checker reports it where one is read.
function lit_link(st: LitInfer, ids: i32[]): LitInfer {
  let out: LitInfer = st;
  let i: i32 = 1;
  while (i < ids.len()) {
    let ra: i32 = lit_find(out, ids[0]);
    let rb: i32 = lit_find(out, ids[i]);
    let afixed: boolean = !is_unknown(out.width[ra]) && !is_poly_float(out.width[ra]);
    let bfixed: boolean = !is_unknown(out.width[rb]) && !is_poly_float(out.width[rb]);
    if (ra != rb && !(afixed && bfixed)) {
      if (bfixed) {
        out = LitInfer { ...out, parent: out.parent.with(ra, rb) };
      } else {
        out = LitInfer { ...out, parent: out.parent.with(rb, ra) };
        if (is_unknown(out.width[ra]) && is_poly_float(out.width[rb])) {
          out = LitInfer { ...out, width: out.width.with(ra, out.width[rb]) };
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function lit_is_cmp(op: string): boolean {
  return op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=";
}

// lit_demand: `e` is read at `want`, so an untyped tree takes it.
function lit_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprIdent(id) = e {
    st = lit_type_demand(s.lookup(id.name), want, st);
  }
  if ((is_integer(want) || is_float(want)) && open_tree(e, s)) {
    return demand_open(e, want, s, st);
  }
  match (want) {
    typeinfo.TypeUnion(wu) => {
      return lit_union_demand(e, wu, s, st);
    },
    typeinfo.TypeStruct(ws) => {
      return lit_struct_demand(e, ws, s, st);
    },
    typeinfo.TypeTuple(wt) => {
      return lit_tuple_demand(e, wt, s, st);
    },
    typeinfo.TypeArray(wa) => {
      return lit_array_demand(e, wa, s, st);
    },
    _ => {}
  }
  return lit_other_demand(e, want, s, st);
}

function lit_other_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      return lit_value_block(c, want, s, st);
    }
  }
  return lit_expr(e, s, gcall_demand(e, want, s, st));
}

function lit_union_demand(e: ast.Expr, wu: typeinfo.TypeUnion, s: Scope, st: LitInfer): LitInfer {
  let sig: UnionSig = s.lookup_union(wu.name);
  if (sig.instance != "") {
    return lit_demand(e, s.resolve_type(sig.instance), s, st);
  }
  if let typeinfo.TypeUnion(have) = check_expr(e, s) {
    if (have.name == wu.name && have.args.len() == wu.args.len()) {
      let out: LitInfer = st;
      let j: i32 = 0;
      while (j < have.args.len()) {
        let k: i32 = lit_id(have.args[j]);
        if (k >= 0) {
          out = lit_fix(out, [k], wu.args[j]);
        }
        j = j + 1;
      }
      return out;
    }
  }
  return lit_other_demand(e, wu, s, st);
}

function lit_struct_demand(e: ast.Expr, ws: typeinfo.TypeStruct, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprIdent(sid) = e {
    let (name, ids) = lit_struct_of(s.lookup(sid.name));
    if (name == ws.name && ids.len() == ws.args.len()) {
      let outs: LitInfer = st;
      let j: i32 = 0;
      while (j < ids.len()) {
        if (ids[j] >= 0) {
          outs = lit_fix(outs, [ids[j]], ws.args[j]);
        }
        j = j + 1;
      }
      return outs;
    }
  }
  return lit_other_demand(e, ws, s, st);
}

function lit_tuple_demand(e: ast.Expr, wt: typeinfo.TypeTuple, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprTuple(tl) = e {
    if (tl.elements.len() == wt.elements.len()) {
      let out: LitInfer = st;
      let i: i32 = 0;
      while (i < tl.elements.len()) {
        out = lit_demand(tl.elements[i], wt.elements[i], s, out);
        i = i + 1;
      }
      return out;
    }
  }
  return lit_other_demand(e, wt, s, st);
}

function lit_array_demand(e: ast.Expr, wa: typeinfo.TypeArray, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprArray(arr) = e {
    let out: LitInfer = st;
    for el in arr.elements {
      if let typeinfo.TypeTuple(_) = wa.elem {
        if let ast.ExprCall(c) = el {
          if (parser.is_value_block(c)) {
            out = lit_expr(el, s, out);
            continue;
          }
        }
      }
      out = lit_demand(el, wa.elem, s, out);
    }
    return out;
  }
  return lit_other_demand(e, wa, s, st);
}

// lit_arg: `e` stands alone — an untyped tree's members share one type, and
// anything else is walked for the uses inside it.
function lit_arg(e: ast.Expr, s: Scope, st: LitInfer): LitInfer {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed) {
    return lit_link(st, ids);
  }
  return lit_expr(e, s, st);
}

function lit_binary(b: ast.ExprBinary, s: Scope, st: LitInfer): LitInfer {
  if (!int_operand_op(b.op) && !lit_is_cmp(b.op)) {
    return lit_expr(b.right, s, lit_expr(b.left, s, st));
  }
  let (ls, lids) = lit_tree(b.left, s, []);
  let (rs, rids) = lit_tree(b.right, s, []);
  if (ls && rs) {
    let all: i32[] = lids;
    for k in rids {
      all = all.append(k);
    }
    return lit_link(st, all);
  }
  let lo: boolean = open_tree(b.left, s);
  let ro: boolean = open_tree(b.right, s);
  if (ls) {
    return lit_expr(b.right, s, lit_beside(lids, b.right, ro, s, st));
  }
  if (rs) {
    return lit_expr(b.left, s, lit_beside(rids, b.left, lo, s, st));
  }
  return lit_expr(b.right, s, lit_expr(b.left, s, gcall_operands(b, lo, ro, s, st)));
}

// lit_beside: the literal locals `ids` of an untyped tree read beside `other`.
// A typed operand fixes them. An open generic read shares their width: i64 when
// a wide literal binds it, else whatever the locals settle at.
function lit_beside(ids: i32[], other: ast.Expr, open: boolean, s: Scope, st: LitInfer): LitInfer {
  if (ids.len() == 0) {
    return st;
  }
  if (!open) {
    return lit_fix(st, ids, check_expr(other, s));
  }
  if (open_wide(other, s)) {
    return lit_fix(st, ids, t_i64());
  }
  let out: LitInfer = lit_link(st, ids);
  return LitInfer { ...out, pend: out.pend.append(other), pend_id: out.pend_id.append(ids[0]), pend_scope: out.pend_scope.append(s) };
}

// gcall_operands: an open generic read beside a typed operand takes that
// operand's width. Two open operands take the default the comparison or
// arithmetic gives them: i64 when a wide literal binds either.
function gcall_operands(b: ast.ExprBinary, lo: boolean, ro: boolean, s: Scope, st: LitInfer): LitInfer {
  if (lo && !ro) {
    return demand_open(b.left, check_expr(b.right, s), s, st);
  }
  if (ro && !lo) {
    return demand_open(b.right, check_expr(b.left, s), s, st);
  }
  if (lo && ro && (open_wide(b.left, s) || open_wide(b.right, s))) {
    return demand_open(b.right, t_i64(), s, demand_open(b.left, t_i64(), s, st));
  }
  return st;
}

// open_tree: an untyped integer tree whose leaves may also be open generic
// reads — the shape native's settleInt descends to a generic call.
function open_tree(e: ast.Expr, s: Scope): boolean {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed || gcall_open(e, s)) {
    return true;
  }
  if let ast.ExprUnary(u) = e {
    return (u.op == "-" || u.op == "+") && open_tree(u.operand, s);
  }
  if let ast.ExprBinary(b) = e {
    return int_operand_op(b.op) && open_tree(b.left, s) && open_tree(b.right, s);
  }
  return false;
}

// demand_open reads every leaf of an open tree at `want`.
function demand_open(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed) {
    return lit_fix(st, ids, want);
  }
  if let ast.ExprUnary(u) = e {
    return demand_open(u.operand, want, s, st);
  }
  if let ast.ExprBinary(b) = e {
    return demand_open(b.right, want, s, demand_open(b.left, want, s, st));
  }
  return lit_expr(e, s, gcall_demand(e, want, s, st));
}

// open_wide: a wide literal binds one of an open tree's generic reads.
function open_wide(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprUnary(u) = e {
    return open_wide(u.operand, s);
  }
  if let ast.ExprBinary(b) = e {
    return open_wide(b.left, s) || open_wide(b.right, s);
  }
  let (ce, tvs) = gcall_open_tvars(e, s);
  if let ast.ExprCall(c) = ce {
    let sig: FuncSig = gcall_sig(c, s);
    let k: i32 = 0;
    while (k < sig.param_type_names.len() && k < c.args.len()) {
      if (util.has_str(tvs, sig.param_type_names[k]) && wide_int_tree(c.args[k])) {
        return true;
      }
      k = k + 1;
    }
  }
  return false;
}

// wide_int_tree: an untyped integer tree holding a literal with no i32 reading.
function wide_int_tree(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return int_literal_tree(e) && parser.literal_is_i64(n.text);
    },
    ast.ExprUnary(u) => {
      return wide_int_tree(u.operand);
    },
    ast.ExprBinary(b) => {
      return wide_int_tree(b.left) || wide_int_tree(b.right);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// gcall_of: the generic call `e` reads — the call itself, or a tuple or struct
// field of its result — with `want`, the type `e` is read at, lifted to the
// call's whole result. False when `e` reads no generic call.
function gcall_of(e: ast.Expr, want: typeinfo.Type, s: Scope): (ast.Expr, typeinfo.Type, boolean) {
  if let ast.ExprFieldAccess(fa) = e {
    let (lifted, ok) = field_want_lift(check_expr(fa.obj, s), fa.field, want, s);
    if (!ok) {
      return (e, want, false);
    }
    return gcall_of(fa.obj, lifted, s);
  }
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      return (e, want, false);
    }
    return (e, want, gcall_sig(c, s).ret_type_name.len() > 0 && gcall_sig(c, s).typevars.len() > 0);
  }
  return (e, want, false);
}

// field_want_lift: the type a value of type `ot` is read at when its field
// `field` is read at `want` — unknown in every other slot, which binds nothing.
function field_want_lift(ot: typeinfo.Type, field: string, want: typeinfo.Type, s: Scope): (typeinfo.Type, boolean) {
  if let typeinfo.TypeTuple(tt) = ot {
    let idx: i32 = digit_string_to_i32(field);
    if (idx < 0 || idx >= tt.elements.len()) {
      return (ot, false);
    }
    return (t_tuple(unknown_slots(tt.elements.len()).with(idx, want)), true);
  }
  if let typeinfo.TypeStruct(sn) = ot {
    let sig: StructSig = s.lookup_struct(sn.name);
    let fi: i32 = field_index(sig, field);
    if (fi < 0 || fi >= sig.field_type_names.len()) {
      return (ot, false);
    }
    let ti: i32 = util.index_of_str(sig.type_params, sig.field_type_names[fi]);
    if (ti < 0) {
      return (ot, false);
    }
    return (t_struct_g(sn.name, unknown_slots(sig.type_params.len()).with(ti, want)), true);
  }
  return (ot, false);
}

function unknown_slots(n: i32): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  while (out.len() < n) {
    out = out.append(t_unknown("not read"));
  }
  return out;
}

// gcall_sig: the signature a call names, or an empty one.
function gcall_sig(c: ast.ExprCall, s: Scope): FuncSig {
  if let ast.ExprIdent(cid) = c.callee {
    let at: i32 = s.sig_at(cid.name);
    if (at >= 0) {
      return s.sigs.sigs[at];
    }
  }
  return FuncSig { receiver: "", name: "", param_types: [], param_own: [], ret_type: t_unknown("no callee"), all_type_params: [], type_params: [], type_bounds: [], ret_type_name: "", param_type_names: [], param_names: [], is_const: false, typevars: [], module: "", refs: [] };
}

// lit_bound_typevar: every argument declared as `tp` is an untyped integer
// tree or a generic call whose width is itself still open (`id(id(1))`), and
// no parameter mentions `tp` inside another type (`T[]`, `Option[T]`), which
// would pin it on its own. A written type argument pins it too.
function lit_bound_typevar(sig: FuncSig, c: ast.ExprCall, tp: string, s: Scope): boolean {
  let (wn, _) = written_type_bindings(sig, c, s);
  if (util.has_str(wn, tp)) {
    return false;
  }
  let n: i32 = 0;
  let k: i32 = 0;
  while (k < sig.param_type_names.len() && k < c.args.len()) {
    if (sig.param_type_names[k] == tp) {
      let (seed, ids) = lit_tree(c.args[k], s, []);
      if (!seed && !int_literal_tree(c.args[k]) && !gcall_open(c.args[k], s)) {
        return false;
      }
      n = n + 1;
    } else if (type_ref_names_any(sig_param_ref(sig, k), [tp])) {
      return false;
    }
    k = k + 1;
  }
  return n > 0;
}

// gcall_open: `e` reads a generic call's result through a type variable only
// untyped literals bind, so its width is still open.
function gcall_open(e: ast.Expr, s: Scope): boolean {
  let (ce, tvs) = gcall_open_tvars(e, s);
  return tvs.len() > 0;
}

// gcall_open_tvars: the generic call `e` reads, and the type variables of its
// result that only untyped literals bind.
function gcall_open_tvars(e: ast.Expr, s: Scope): (ast.Expr, string[]) {
  let tvs: string[] = [];
  let (ce, lifted, ok) = gcall_of(e, t_unknown("open"), s);
  if (!ok) {
    return (e, tvs);
  }
  if let ast.ExprCall(c) = ce {
    let sig: FuncSig = gcall_sig(c, s);
    let ret: parser.TypeRef = sig_ret_ref(sig);
    for tp in sig.typevars {
      if (type_ref_names_any(ret, [tp]) && lit_bound_typevar(sig, c, tp, s)) {
        tvs = tvs.append(tp);
      }
    }
  }
  return (ce, tvs);
}

// gcall_demand: `e`, a generic call or a field of one, is read at `want`. Each
// type variable only untyped literals bind takes the integer type `want` binds
// it to through the callee's result.
function gcall_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let (ce, lifted, ok) = gcall_of(e, want, s);
  if (!ok) {
    return st;
  }
  if let ast.ExprCall(c) = ce {
    let sig: FuncSig = gcall_sig(c, s);
    let (bn, bt) = gc_bind_param(sig_ret_ref(sig), lifted, sig.typevars, s.type_names(), [], []);
    let out: LitInfer = st;
    let i: i32 = 0;
    while (i < bn.len()) {
      if ((is_integer(bt[i]) || is_float(bt[i])) && lit_bound_typevar(sig, c, bn[i], s)) {
        out = gcall_settle(c, sig, bn[i], bt[i], s, out);
      }
      i = i + 1;
    }
    return out;
  }
  return st;
}

// gcall_settle gives the arguments declared as `tp` the integer type `w`: a
// literal local among them is fixed, a literal is recorded for a suffix, and
// a generic call among them is read at `w` in its turn, so `id(id(1))` reaches
// the inner literal.
function gcall_settle(c: ast.ExprCall, sig: FuncSig, tp: string, w: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let tag: string = typeinfo.spelling(w);
  let out: LitInfer = st;
  let k: i32 = 0;
  while (k < sig.param_type_names.len() && k < c.args.len()) {
    if (sig.param_type_names[k] == tp) {
      let (seed, ids) = lit_tree(c.args[k], s, []);
      out = lit_fix(out, ids, w);
      if (int_literal_tree(c.args[k]) && (tag == "i32" || is_float(w) || lit_suffix_spelled(tag))) {
        out = LitInfer { ...out, cargs: out.cargs.append(gcall_arg_key(c, k)), ctags: out.ctags.append(tag) };
      }
      out = gcall_demand(c.args[k], w, s, out);
    }
    k = k + 1;
  }
  return out;
}

function gcall_arg_key(c: ast.ExprCall, k: i32): string {
  return "c" + util.i32_to_string(c.line) + ":" + util.i32_to_string(c.col) + "#" + util.i32_to_string(k);
}

// lit_call: an argument is read at its parameter's type. A value block's
// desugared lambda spells no result, so a block reached here, with no position
// reading it, is walked without a destination; lit_demand passes one.
function lit_call(c: ast.ExprCall, s: Scope, st: LitInfer): LitInfer {
  if (parser.is_value_block(c)) {
    return lit_value_block(c, t_unknown("value block"), s, st);
  }
  let out: LitInfer = lit_expr(c.callee, s, st);
  let reads: boolean = false;
  for arg in c.args {
    let (seed, ids) = lit_tree(arg, s, []);
    reads = reads || seed && ids.len() > 0 || lit_composite(arg) || !seed && open_tree(arg, s) || lit_struct_read(arg, s) || lit_enum_read(arg, s);
  }
  let pts: typeinfo.Type[] = [];
  if (reads) {
    pts = s.call_param_types(c);
  }
  let i: i32 = 0;
  while (i < c.args.len()) {
    if (i < pts.len()) {
      out = lit_demand(c.args[i], pts[i], s, out);
    } else {
      out = lit_arg(c.args[i], s, out);
    }
    i = i + 1;
  }
  return out;
}

// lit_value_block walks a value block whose value is read at `want`. Every
// return, including returns in match arms, shares that destination type.
function lit_value_block(c: ast.ExprCall, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if (is_unknown(want) || is_float(want)) {
    want = check_expr(c, lit_typed_scope(s, st));
  }
  if let ast.ExprLambda(vb) = c.callee {
    // Match-expression arms return before the final statement. They share
    // the value block's destination just as its final return does.
    let cur: Scope = lambda_body_scope(vb, s).with_block_ret(want);
    let out: LitInfer = st;
    let last: i32 = vb.body.len() - 1;
    let i: i32 = 0;
    while (i < last) {
      let (ns, nst) = lit_stmt(vb.body[i], cur, out);
      cur = ns;
      out = nst;
      i = i + 1;
    }
    if (last < 0) {
      return out;
    }
    if let ast.StmtReturn(r) = vb.body[last] {
      return lit_demand(r.value, want, cur, lit_float_demand(r.value, want, cur, out));
    }
    return lit_value_branch(vb.body[last], want, cur, out);
  }
  return st;
}

function lit_value_branch(stmt: ast.Stmt, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if let ast.StmtIf(f) = stmt {
    st = lit_expr(f.cond, s, st);
    return lit_value_body(f.else_body, want, s, lit_value_body(f.then_body, want, s, st));
  }
  if let ast.StmtMatch(m) = stmt {
    st = lit_arg(m.scrutinee, s, st);
    for arm in m.arms {
      let cur: Scope = annotate_arm_scope(arm, s, check_expr(m.scrutinee, s));
      if (arm.has_guard) {
        st = lit_expr(arm.guard, cur, st);
      }
      st = lit_value_body(arm.body, want, cur, st);
    }
    return st;
  }
  let (scope, out) = lit_stmt(stmt, s, st);
  return out;
}

function lit_value_body(body: ast.Stmt[], want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let cur: Scope = s;
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    let (next, out) = lit_stmt(body[i], cur, st);
    cur = next;
    st = out;
    i = i + 1;
  }
  if (body.len() == 0) {
    return st;
  }
  if let ast.StmtReturn(r) = body[i] {
    return lit_demand(r.value, want, cur, lit_float_demand(r.value, want, cur, st));
  }
  return lit_value_branch(body[i], want, cur, st);
}

function lit_float_needed(have: typeinfo.Type, want: typeinfo.Type): boolean {
  if (is_poly_int(have) && is_float(want)) {
    return true;
  }
  if let typeinfo.TypeTuple(h) = have {
    if let typeinfo.TypeTuple(w) = want {
      let i: i32 = 0;
      while (i < h.elements.len() && i < w.elements.len()) {
        if (lit_float_needed(h.elements[i], w.elements[i])) {
          return true;
        }
        i = i + 1;
      }
    }
  }
  return false;
}

function lit_float_key(e: ast.Expr): string {
  let shape: string = "";
  match (e) {
    ast.ExprIdent(id) => {
      shape = "id:" + id.name;
    },
    ast.ExprFieldAccess(fa) => {
      shape = "field:" + fa.field;
    },
    ast.ExprIndex(_) => {
      shape = "index";
    },
    ast.ExprUnary(u) => {
      shape = "unary:" + u.op;
    },
    ast.ExprBinary(b) => {
      shape = "binary:" + b.op;
    },
    ast.ExprCall(_) => {
      shape = "call";
    },
    _ => {
      return "";
    }
  }
  return "f" + util.i32_to_string(expr_line(e)) + ":" + util.i32_to_string(expr_col(e)) + ":" + shape;
}

// An integer literal local stays an integer. A float arm promotes the read,
// so earlier arithmetic and a later integer-width demand keep their meaning.
function lit_float_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  // The value-block pretype pass derives this synthetic slot from its stores.
  // Its initial integer zero is a placeholder, not a literal local to convert.
  if let ast.ExprIdent(id) = e {
    if (parser.is_value_local_name(id.name)) {
      return st;
    }
  }
  if let ast.ExprTuple(t) = e {
    if let typeinfo.TypeTuple(w) = want {
      let i: i32 = 0;
      while (i < t.elements.len() && i < w.elements.len()) {
        st = lit_float_demand(t.elements[i], w.elements[i], s, st);
        i = i + 1;
      }
      return st;
    }
  }
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      return lit_value_body(parser.vb_body(c), want, s, st);
    }
    st = lit_float_constructor(c, want, s, st);
  }
  let have: typeinfo.Type = mx_arm_result_type(e, lit_typed_scope(s, st));
  if (lit_float_needed(have, want) && !int_literal_tree(e)) {
    return LitInfer { ...st, cargs: st.cargs.append(lit_float_key(e)), ctags: st.ctags.append(typeinfo.spelling(want)) };
  }
  return st;
}

function lit_float_constructor(c: ast.ExprCall, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if (constructor_destination(c, want, s)) {
    let index: i32 = builtin_payload_index(ctor_variant_name(c), want);
    let args: typeinfo.Type[] = nominal_args(want);
    if (index >= 0 && index < args.len() && c.args.len() == 1) {
      return lit_float_demand(c.args[0], args[index], s, st);
    }
  }
  return st;
}

// The inference walk binds locals to class markers. Read their current
// numeric types when joining value arms, retaining polymorphism only for
// classes that no earlier use has fixed.
function lit_typed_scope(s: Scope, st: LitInfer): Scope {
  let types: typeinfo.Type[] = s.types;
  let lits: string[] = s.lit_locals;
  let i: i32 = 0;
  while (i < types.len()) {
    let original: typeinfo.Type = types[i];
    types = types.with(i, lit_typed_type(original, st, true));
    let k: i32 = lit_id(original);
    if (k >= 0) {
      let w: typeinfo.Type = st.width[lit_find(st, k)];
      if (is_unknown(w)) {
        w = typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: true };
        lits = lits.append(s.names[i]);
      }
      types = types.with(i, w);
    }
    i = i + 1;
  }
  return Scope { ...s, types: types, lit_locals: lits };
}

function lit_typed_type(t: typeinfo.Type, st: LitInfer, poly: boolean): typeinfo.Type {
  let k: i32 = lit_id(t);
  if (k >= 0) {
    let w: typeinfo.Type = st.width[lit_find(st, k)];
    if (is_unknown(w)) {
      return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: poly };
    }
    return w;
  }
  if let typeinfo.TypeTuple(tt) = t {
    let elems: typeinfo.Type[] = [];
    for el in tt.elements {
      elems = elems.append(lit_typed_type(el, st, poly));
    }
    return t_tuple(elems);
  }
  if let typeinfo.TypeArray(a) = t {
    return typeinfo.TypeArray { ...a, elem: lit_typed_type(a.elem, st, poly) };
  }
  return t;
}

function lit_type_demand(have: typeinfo.Type, want: typeinfo.Type, st: LitInfer): LitInfer {
  let k: i32 = lit_id(have);
  if (k >= 0) {
    return lit_fix(st, [k], want);
  }
  if let typeinfo.TypeTuple(h) = have {
    if let typeinfo.TypeTuple(w) = want {
      if (h.elements.len() == w.elements.len()) {
        let i: i32 = 0;
        while (i < h.elements.len()) {
          st = lit_type_demand(h.elements[i], w.elements[i], st);
          i = i + 1;
        }
      }
    }
  }
  if let typeinfo.TypeArray(h) = have {
    if let typeinfo.TypeArray(w) = want {
      st = lit_type_demand(h.elem, w.elem, st);
    }
  }
  return st;
}

function lit_type_link(a: typeinfo.Type, b: typeinfo.Type, st: LitInfer): LitInfer {
  let left: i32 = lit_id(a);
  let right: i32 = lit_id(b);
  if (left >= 0 && right >= 0) {
    return lit_link(st, [left, right]);
  }
  if (left >= 0) {
    return lit_fix(st, [left], b);
  }
  if (right >= 0) {
    return lit_fix(st, [right], a);
  }
  if let typeinfo.TypeTuple(at) = a {
    if let typeinfo.TypeTuple(bt) = b {
      if (at.elements.len() == bt.elements.len()) {
        let i: i32 = 0;
        while (i < at.elements.len()) {
          st = lit_type_link(at.elements[i], bt.elements[i], st);
          i = i + 1;
        }
      }
    }
  }
  if let typeinfo.TypeArray(at) = a {
    if let typeinfo.TypeArray(bt) = b {
      st = lit_type_link(at.elem, bt.elem, st);
    }
  }
  return st;
}

// Keep a class for each literal component, so a later whole-tuple or
// whole-array demand reaches the original initialiser as well as its uses.
function lit_composite_local(e: ast.Expr, s: Scope, st: LitInfer): (typeinfo.Type, LitInfer, boolean) {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed || float_literal_tree(e)) {
    let k: i32 = st.parent.len();
    st = lit_new(st, "");
    if (float_literal_tree(e)) {
      st = LitInfer { ...st, width: st.width.with(k, typeinfo.TypeFloat { width: 64, polymorphic: true }) };
    }
    return (lit_marker(k), lit_link(st, ids.append(k)), true);
  }
  if let ast.ExprTuple(t) = e {
    let elems: typeinfo.Type[] = [];
    let any: boolean = false;
    for el in t.elements {
      let (ty, next, found) = lit_composite_local(el, s, st);
      st = next;
      any = any || found;
      elems = elems.append(ty);
    }
    return (t_tuple(elems), st, any);
  }
  if let ast.ExprArray(a) = e {
    if (a.elements.len() > 0) {
      let (elem, next, any) = lit_composite_local(a.elements[0], s, st);
      st = next;
      let i: i32 = 1;
      while (i < a.elements.len()) {
        let (ty, more, found) = lit_composite_local(a.elements[i], s, st);
        st = more;
        st = lit_type_link(elem, ty, st);
        i = i + 1;
      }
      return (t_array(elem), st, any);
    }
  }
  return (check_expr(e, lit_typed_scope(s, st)), st, false);
}

function lit_composite(e: ast.Expr): boolean {
  if let ast.ExprTuple(_) = e {
    return true;
  }
  if let ast.ExprArray(_) = e {
    return true;
  }
  if let ast.ExprCall(c) = e {
    return parser.is_value_block(c);
  }
  return false;
}

// lit_array: the elements of an array literal share one type, so an untyped
// element takes a typed sibling's.
function lit_array(arr: ast.ExprArray, s: Scope, st: LitInfer): LitInfer {
  let out: LitInfer = st;
  let ids: i32[] = [];
  let sibling: typeinfo.Type = t_unknown("no typed element");
  for el in arr.elements {
    let (seed, eids) = lit_tree(el, s, []);
    if (seed) {
      for k in eids {
        ids = ids.append(k);
      }
    } else {
      out = lit_expr(el, s, out);
      if (is_unknown(sibling) && ids.len() > 0) {
        sibling = check_expr(el, s);
      }
    }
  }
  if (ids.len() == 0) {
    return out;
  }
  if (is_unknown(sibling) && ids.len() < arr.elements.len()) {
    for el in arr.elements {
      let (seed2, e2) = lit_tree(el, s, []);
      if (!seed2 && is_unknown(sibling)) {
        sibling = check_expr(el, s);
      }
    }
  }
  return lit_fix(lit_link(out, ids), ids, sibling);
}

function lit_struct_lit(sl: ast.ExprStructLit, s: Scope, st: LitInfer): LitInfer {
  let out: LitInfer = st;
  let sig: StructSig = s.lookup_struct(sl.type_name);
  // A generic literal's wide field settles at the i64 its argument widens to.
  let largs: typeinfo.Type[] = [];
  if (sig.type_params.len() > 0) {
    largs = struct_lit_args(sl, sig, s);
  }
  let i: i32 = 0;
  while (i < sl.field_values.len()) {
    let want: typeinfo.Type = t_unknown("no field");
    if (i < sl.field_names.len()) {
      let j: i32 = 0;
      while (j < sig.field_names.len()) {
        if (sig.field_names[j] == sl.field_names[i] && j < sig.field_types.len()) {
          want = sig.field_types[j];
          if (sig.type_params.len() > 0 && j < sig.field_type_names.len()) {
            want = widened_field_type(sig, j, largs, s);
          }
        }
        j = j + 1;
      }
    }
    out = lit_demand(sl.field_values[i], want, s, out);
    i = i + 1;
  }
  if (sl.has_base) {
    out = lit_expr(sl.base, s, out);
  }
  return out;
}

// lit_index: a position is an i32, and a map's key its key type.
function lit_index(ix: ast.ExprIndex, s: Scope, st: LitInfer): LitInfer {
  let (seed, ids) = lit_tree(ix.index, s, []);
  if (!seed) {
    return lit_expr(ix.index, s, st);
  }
  if (ids.len() == 0) {
    return st;
  }
  let want: typeinfo.Type = t_i32();
  if let typeinfo.TypeMap(tm) = check_expr(ix.array, s) {
    want = tm.key;
  }
  return lit_fix(st, ids, want);
}

// lit_expr walks an expression whose own value no context types, for the
// uses of literal locals inside it.
function lit_expr(e: ast.Expr, s: Scope, st: LitInfer): LitInfer {
  match (e) {
    ast.ExprBinary(b) => {
      return lit_binary(b, s, st);
    },
    ast.ExprUnary(u) => {
      return lit_arg(u.operand, s, st);
    },
    ast.ExprCall(c) => {
      return lit_call(c, s, st);
    },
    ast.ExprArray(arr) => {
      return lit_array(arr, s, st);
    },
    ast.ExprStructLit(sl) => {
      return lit_struct_lit(sl, s, st);
    },
    ast.ExprLambda(lm) => {
      return lit_lambda(lm, s, st);
    },
    ast.ExprTuple(tl) => {
      let out: LitInfer = st;
      for el in tl.elements {
        out = lit_arg(el, s, out);
      }
      return out;
    },
    ast.ExprIndex(ix) => {
      return lit_index(ix, s, lit_arg(ix.array, s, st));
    },
    ast.ExprSlice(sx) => {
      let out2: LitInfer = lit_arg(sx.array, s, st);
      if (!sx.open_start) {
        out2 = lit_demand(sx.start, t_i32(), s, out2);
      }
      if (!sx.open_end) {
        out2 = lit_demand(sx.end, t_i32(), s, out2);
      }
      return out2;
    },
    ast.ExprFieldAccess(fa) => {
      return lit_arg(fa.obj, s, st);
    },
    ast.ExprMapLit(ml) => {
      let out3: LitInfer = st;
      for k in ml.keys {
        out3 = lit_arg(k, s, out3);
      }
      for v in ml.vals {
        out3 = lit_arg(v, s, out3);
      }
      return out3;
    },
    ast.ExprFString(fs) => {
      let out4: LitInfer = st;
      let q: i32 = 0;
      while (q < fs.exprs.len()) {
        if (fs.is_expr[q]) {
          out4 = lit_arg(fs.exprs[q], s, out4);
        }
        q = q + 1;
      }
      return out4;
    },
    _ => {
      return st;
    }
  }
  return st;
}

// lit_lambda walks a lambda body in its own scope. A lambda that spells no
// result takes one from its returns when it is checked, so a literal local it
// returns is committed there: to the width its class already has, else i32 —
// native's settleLitReturns.
function lit_lambda(lm: ast.ExprLambda, s: Scope, st: LitInfer): LitInfer {
  let bs: Scope = lambda_body_scope(lm, s);
  let out: LitInfer = lit_stmts(lm.body, bs, st);
  if (lm.ret_type.len() > 0) {
    return out;
  }
  let ids: i32[] = lit_return_ids(lm.body, bs, []);
  if (ids.len() == 0) {
    return out;
  }
  let w: typeinfo.Type = t_i32();
  for k in ids {
    let r: i32 = lit_find(out, k);
    if (!is_unknown(out.width[r]) && type_eq(w, t_i32())) {
      w = out.width[r];
    }
  }
  return lit_fix(out, ids, w);
}

function lit_return_ids(stmts: ast.Stmt[], s: Scope, ids: i32[]): i32[] {
  let cur: Scope = s;
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        let (seed, rids) = lit_tree(r.value, cur, []);
        if (seed) {
          for k in rids {
            ids = ids.append(k);
          }
        }
      },
      ast.StmtIf(f) => {
        ids = lit_return_ids(f.then_body, cur, ids);
        ids = lit_return_ids(f.else_body, cur, ids);
      },
      ast.StmtWhile(w) => {
        ids = lit_return_ids(w.body, cur, ids);
      },
      ast.StmtFor(fr) => {
        ids = lit_return_ids(fr.body, for_body_scope(fr, cur), ids);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          ids = lit_return_ids(arm.body, cur, ids);
        }
      },
      _ => {}
    }
    cur = bind_stmt(stmt, cur);
  }
  return ids;
}

function lit_var_key(v: ast.StmtVar): string {
  return "v" + util.i32_to_string(v.line) + ":" + util.i32_to_string(v.col) + ":" + v.name;
}

function lit_for_key(fr: ast.StmtFor, lo: ast.Expr): string {
  return "f" + util.i32_to_string(fr.line) + ":" + util.i32_to_string(ast.expr_line(lo)) + ":" + util.i32_to_string(ast.expr_col(lo)) + ":" + fr.var_name;
}

function lit_range_bounds(iter: ast.Expr): ast.Expr[] {
  if let ast.ExprCall(c) = iter {
    return c.args;
  }
  return [];
}

// lit_range: `for i in LOW..HIGH` declares `i` from LOW and compares it with
// HIGH, so all three share a type — the one a typed bound has, when either
// has one.
function lit_range(fr: ast.StmtFor, s: Scope, st: LitInfer): LitInfer {
  let bounds: ast.Expr[] = lit_range_bounds(fr.iter);
  let (ls, lids) = lit_tree(bounds[0], s, []);
  let (hs, hids) = lit_tree(bounds[1], s, []);
  let out: LitInfer = st;
  if (!ls) {
    out = lit_expr(bounds[0], s, out);
  }
  if (!hs) {
    out = lit_expr(bounds[1], s, out);
  }
  let body: Scope = for_body_scope(fr, s);
  if (ls) {
    let k: i32 = out.parent.len();
    out = lit_new(out, lit_for_key(fr, bounds[0]));
    let ids: i32[] = [k];
    for a in lids {
      ids = ids.append(a);
    }
    if (hs) {
      for b in hids {
        ids = ids.append(b);
      }
      out = lit_link(out, ids);
    } else {
      out = lit_fix(lit_link(out, ids), ids, check_expr(bounds[1], s));
    }
    body = body.bind(fr.var_name, lit_marker(k));
  } else if (hs) {
    out = lit_fix(out, hids, check_expr(bounds[0], s));
  }
  return lit_stmts(fr.body, body, out);
}

function lit_stmts(stmts: ast.Stmt[], s: Scope, st: LitInfer): LitInfer {
  let cur: Scope = s;
  let out: LitInfer = st;
  for stmt in stmts {
    let (ns, nst) = lit_stmt(stmt, cur, out);
    cur = ns;
    out = nst;
  }
  return out;
}

function lit_stmt(stmt: ast.Stmt, s: Scope, st: LitInfer): (Scope, LitInfer) {
  match (stmt) {
    ast.StmtVar(v) => {
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return (bind_stmt(stmt, s), lit_expr(v.init, s, st));
      }
      if (v.type_name.len() > 0) {
        return (bind_stmt(stmt, s), lit_demand(v.init, var_declared_type(v, s), s, st));
      }
      let (seed, ids) = lit_tree(v.init, s, []);
      if (!seed) {
        if let ast.ExprCall(call) = v.init {
          let (enum_type, enum_state) = lit_enum_local(call, s, st);
          if (!is_unknown(enum_type)) {
            return (s.bind(v.name, enum_type), enum_state);
          }
        }
        if let ast.ExprArray(ea) = v.init {
          let wtag: string = widened_array_tag(ea, s);
          if (wtag.len() > 0) {
            let wst: LitInfer = lit_expr(v.init, s, st);
            return (bind_stmt(stmt, s), LitInfer { ...wst, wkeys: wst.wkeys.append(lit_var_key(v)), wtags: wst.wtags.append(wtag) });
          }
        }
        if let ast.ExprStructLit(sl) = v.init {
          let (ss, sst) = lit_struct_local(v, sl, s, lit_expr(v.init, s, st));
          if (ss.len() > 0) {
            let own_ids: i32[] = [];
            let oi: i32 = sst.sfirst[sst.sfirst.len() - 1];
            while (oi < sst.sids.len()) {
              own_ids = own_ids.append(sst.sids[oi]);
              oi = oi + 1;
            }
            return (s.bind(v.name, lit_struct_marker(ss, own_ids)), sst);
          }
        }
        if (lit_composite(v.init) || float_literal_tree(v.init)) {
          let (ct, cs, found) = lit_composite_local(v.init, s, st);
          if (found) {
            return (s.bind(v.name, ct), LitInfer { ...cs, tkeys: cs.tkeys.append(lit_var_key(v)), ttypes: cs.ttypes.append(ct) });
          }
        }
        return (bind_stmt(stmt, s), lit_expr(v.init, s, st));
      }
      let k: i32 = st.parent.len();
      return (s.bind(v.name, lit_marker(k)), lit_link(lit_new(st, lit_var_key(v)), ids.append(k)));
    },
    ast.StmtAssign(a) => {
      let tk: i32 = lit_id(s.lookup(a.target));
      if (tk < 0) {
        return (s, lit_demand(a.value, s.lookup(a.target), s, st));
      }
      let (seed2, ids2) = lit_tree(a.value, s, []);
      if (seed2) {
        return (s, lit_link(st, ids2.append(tk)));
      }
      let walked: LitInfer = lit_expr(a.value, s, st);
      return (s, lit_fix(walked, [tk], check_expr(a.value, s)));
    },
    ast.StmtReturn(r) => {
      return (s, lit_demand(r.value, s.ret_type, s, st));
    },
    ast.StmtExpr(x) => {
      return (s, lit_expr(x.value, s, st));
    },
    ast.StmtIf(f) => {
      let ci: LitInfer = lit_expr(f.cond, s, st);
      return (s, lit_stmts(f.else_body, s, lit_stmts(f.then_body, s, ci)));
    },
    ast.StmtWhile(w) => {
      return (s, lit_stmts(w.body, s, lit_expr(w.cond, s, st)));
    },
    ast.StmtFor(fr) => {
      if (for_iter_is_range(fr.iter)) {
        return (s, lit_range(fr, s, st));
      }
      return (s, lit_stmts(fr.body, for_body_scope(fr, s), lit_expr(fr.iter, s, st)));
    },
    ast.StmtMatch(m) => {
      let out: LitInfer = lit_arg(m.scrutinee, s, st);
      let whole: typeinfo.Type = check_expr(m.scrutinee, s);
      if let ast.ExprCall(call) = m.scrutinee {
        let (enum_type, enum_state) = lit_enum_local(call, s, out);
        if (!is_unknown(enum_type)) {
          whole = enum_type;
          out = enum_state;
        }
      }
      for arm in m.arms {
        let asc: Scope = annotate_arm_scope(arm, s, whole);
        if (arm.has_guard) {
          out = lit_expr(arm.guard, asc, out);
        }
        out = lit_stmts(arm.body, asc, out);
      }
      return (s, out);
    },
    ast.StmtDefer(d) => {
      let (ds, dst) = lit_stmt(d.action, s, st);
      return (s, dst);
    },
    _ => {
      return (s, st);
    }
  }
  return (s, st);
}

// Constructor payloads share literal classes with later whole-enum demands
// and match bindings. The original argument is rewritten at the chosen width.
function lit_enum_local(c: ast.ExprCall, s: Scope, st: LitInfer): (typeinfo.Type, LitInfer) {
  let none: typeinfo.Type = t_unknown("not a literal enum local");
  if (ctor_name_taken(c, s)) {
    return (none, st);
  }
  if let typeinfo.TypeUnion(u) = check_expr(c, s) {
    let qualified: boolean = false;
    if let ast.ExprFieldAccess(fa) = c.callee {
      if let ast.ExprIdent(owner) = fa.obj {
        if (owner.name != u.name || s.known(owner.name)) {
          return (none, st);
        }
        qualified = true;
      } else {
        return (none, st);
      }
    }
    let args: typeinfo.Type[] = u.args;
    let out: LitInfer = st;
    let p: i32 = 0;
    while (p < c.args.len()) {
      let slot: i32 = ctor_payload_slot(s, u.name, ctor_variant_name(c), p);
      if (qualified && u.name != "Option" && u.name != "Result") {
        slot = payload_type_param(s, s.lookup_union(u.name), ctor_variant_name(c), p);
      }
      let (seed, ids) = lit_tree(c.args[p], s, []);
      if (slot >= 0 && slot < args.len() && seed) {
        let k: i32 = out.parent.len();
        out = lit_link(lit_new(out, ""), ids.append(k));
        if let typeinfo.TypeI32(known) = u.args[slot] {
          if (!known.polymorphic) {
            out = lit_fix(out, [k], known);
          }
        }
        let prior: i32 = lit_id(args[slot]);
        if (prior >= 0) {
          out = lit_link(out, [prior, k]);
        }
        args = args.with(slot, lit_marker(k));
        out = LitInfer { ...out, eargs: out.eargs.append(gcall_arg_key(c, p)), eids: out.eids.append(k) };
      }
      p = p + 1;
    }
    if (out.eids.len() > st.eids.len()) {
      return (typeinfo.TypeUnion { ...u, args: args }, out);
    }
  }
  return (none, st);
}

// Each type argument only untyped struct fields bind is a literal class.
// Return the struct's name, or "" when no argument is literal-bound.
function lit_struct_local(v: ast.StmtVar, sl: ast.ExprStructLit, s: Scope, st: LitInfer): (string, LitInfer) {
  let sig: StructSig = s.lookup_struct(sl.type_name);
  if (sig.type_params.len() == 0 || sl.has_base || util.index_of_sub(sl.type_name, "[") >= 0) {
    return ("", st);
  }
  let args: typeinfo.Type[] = struct_lit_args(sl, sig, s);
  let out: LitInfer = st;
  let ids: i32[] = [];
  let spelled: string[] = [];
  let any: boolean = false;
  let lit: ast.Expr[] = [sl];
  let ti: i32 = 0;
  while (ti < sig.type_params.len()) {
    let lits: boolean = false;
    let typed: boolean = false;
    let wide: boolean = false;
    for e in struct_param_exprs(sig, sig.type_params[ti], lit, s) {
      if (int_literal_tree(e)) {
        lits = true;
        wide = wide || wide_int_tree(e);
      } else {
        typed = true;
      }
    }
    if (lits && !typed) {
      let k: i32 = out.parent.len();
      out = lit_new(out, "");
      if (wide) {
        out = lit_fix(out, [k], t_i64());
      }
      ids = ids.append(k);
      any = true;
    } else {
      ids = ids.append(0 - 1);
    }
    let sp: string = "";
    if (ti < args.len() && !is_unknown(args[ti])) {
      sp = typeinfo.spelling(args[ti]);
    }
    spelled = spelled.append(sp);
    ti = ti + 1;
  }
  if (!any) {
    return ("", st);
  }
  let sargs: string[] = out.sargs;
  let sids: i32[] = out.sids;
  let j: i32 = 0;
  while (j < ids.len()) {
    sargs = sargs.append(spelled[j]);
    sids = sids.append(ids[j]);
    j = j + 1;
  }
  return (sl.type_name, LitInfer { ...out, skeys: out.skeys.append(lit_var_key(v)), snames: out.snames.append(sl.type_name), sfirst: out.sfirst.append(out.sids.len()), sargs: sargs, sids: sids });
}

// lit_struct_tags spells each generic struct local whose literal-bound
// arguments settled anywhere but i32: `Same[i64]`.
function lit_struct_tags(st: LitInfer): (string[], string[]) {
  let keys: string[] = [];
  let tags: string[] = [];
  let j: i32 = 0;
  while (j < st.skeys.len()) {
    let end: i32 = st.sids.len();
    if (j + 1 < st.sfirst.len()) {
      end = st.sfirst[j + 1];
    }
    let parts: string = "";
    let moved: boolean = false;
    let known: boolean = true;
    let i: i32 = st.sfirst[j];
    while (i < end) {
      let a: string = st.sargs[i];
      if (st.sids[i] >= 0) {
        a = "i32";
        let w: typeinfo.Type = st.width[lit_find(st, st.sids[i])];
        if (!is_unknown(w)) {
          a = typeinfo.spelling(w);
        }
        moved = moved || a != "i32";
      }
      known = known && a.len() > 0;
      if (i > st.sfirst[j]) {
        parts = parts + ", ";
      }
      parts = parts + a;
      i = i + 1;
    }
    if (moved && known) {
      keys = keys.append(st.skeys[j]);
      tags = tags.append(st.snames[j] + "[" + parts + "]");
    }
    j = j + 1;
  }
  return (keys, tags);
}

// lit_rewrites lists the declarations whose class a use fixed, with the
// spelling to write. A key two candidates share — two
// synthesized declarations at one position — is dropped when they disagree.
function lit_rewrites(st: LitInfer): LitRewrite {
  let keys: string[] = [];
  let tags: string[] = [];
  let k: i32 = 0;
  while (k < st.keys.len()) {
    if (st.keys[k].len() == 0) {
      k = k + 1;
      continue;
    }
    let w: typeinfo.Type = st.width[lit_find(st, k)];
    let tag: string = "i32";
    if (!is_unknown(w)) {
      tag = typeinfo.spelling(w);
    }
    let at: i32 = util.index_of_str(keys, st.keys[k]);
    if (at < 0) {
      keys = keys.append(st.keys[k]);
      tags = tags.append(tag);
    } else if (tags[at] != tag) {
      tags = tags.with(at, "");
    }
    k = k + 1;
  }
  let ok: string[] = [];
  let ot: string[] = [];
  let i: i32 = 0;
  while (i < keys.len()) {
    if (tags[i].len() > 0 && (tags[i] != "i32" || !is_unknown(st.width[lit_find(st, util.index_of_str(st.keys, keys[i]))]))) {
      ok = ok.append(keys[i]);
      ot = ot.append(tags[i]);
    }
    i = i + 1;
  }
  let (sk, stg) = lit_struct_tags(st);
  let ti: i32 = 0;
  while (ti < st.tkeys.len()) {
    ok = ok.append(st.tkeys[ti]);
    ot = ot.append(typeinfo.spelling(lit_typed_type(st.ttypes[ti], st, false)));
    ti = ti + 1;
  }
  let si: i32 = 0;
  while (si < sk.len()) {
    ok = ok.append(sk[si]);
    ot = ot.append(stg[si]);
    si = si + 1;
  }
  let wi: i32 = 0;
  while (wi < st.wkeys.len()) {
    ok = ok.append(st.wkeys[wi]);
    ot = ot.append(st.wtags[wi]);
    wi = wi + 1;
  }
  let call_keys: string[] = st.cargs;
  let call_tags: string[] = st.ctags;
  let ei: i32 = 0;
  while (ei < st.eargs.len()) {
    let width: typeinfo.Type = st.width[lit_find(st, st.eids[ei])];
    if (!is_unknown(width)) {
      call_keys = call_keys.append(st.eargs[ei]);
      call_tags = call_tags.append(typeinfo.spelling(width));
    }
    ei = ei + 1;
  }
  let (ck, ct) = agreed_tags(call_keys, call_tags);
  return LitRewrite { keys: ok, tags: ot, cargs: ck, ctags: ct };
}

// agreed_tags keeps one tag per key, dropping a key two records disagree on.
function agreed_tags(keys: string[], tags: string[]): (string[], string[]) {
  let ok: string[] = [];
  let ot: string[] = [];
  let i: i32 = 0;
  while (i < keys.len()) {
    let at: i32 = util.index_of_str(ok, keys[i]);
    if (at < 0) {
      ok = ok.append(keys[i]);
      ot = ot.append(tags[i]);
    } else if (ot[at] != tags[i]) {
      ot = ot.with(at, "");
    }
    i = i + 1;
  }
  let rk: string[] = [];
  let rt: string[] = [];
  let j: i32 = 0;
  while (j < ok.len()) {
    if (ot[j].len() > 0) {
      rk = rk.append(ok[j]);
      rt = rt.append(ot[j]);
    }
    j = j + 1;
  }
  return (rk, rt);
}

// The literal suffixes check_expr reads; a width with no suffix (usize) keeps
// its bounds as written.
function lit_suffix_spelled(tag: string): boolean {
  return tag == "i64" || tag == "u64" || tag == "u32" || tag == "u8";
}

function lit_rewrite_stmt(st: ast.Stmt, rw: LitRewrite): (ast.Stmt, LitRewrite, boolean) {
  match (st) {
    ast.StmtVar(v) => {
      if (v.type_name.len() > 0) {
        return (st, rw, false);
      }
      let at: i32 = util.index_of_str(rw.keys, lit_var_key(v));
      if (at < 0) {
        return (st, rw, false);
      }
      let (ie, ia, ih) = astwalk.map_expr_acc(v.init, rw, lit_rewrite_stmt, lit_rewrite_expr);
      return (ast.StmtVar { ...v, type_name: rw.tags[at], init: ie }, rw, true);
    },
    ast.StmtFor(fr) => {
      if (!for_iter_is_range(fr.iter)) {
        return (st, rw, false);
      }
      let bounds: ast.Expr[] = lit_range_bounds(fr.iter);
      let at2: i32 = util.index_of_str(rw.keys, lit_for_key(fr, bounds[0]));
      if (at2 < 0 || !lit_suffix_spelled(rw.tags[at2])) {
        return (st, rw, false);
      }
      let tag: string = rw.tags[at2];
      let nb: ast.Expr[] = [];
      for bound in bounds {
        if (int_literal_tree(bound)) {
          nb = nb.append(settle_int_tree(bound, tag));
        } else {
          nb = nb.append(bound);
        }
      }
      let iter: ast.Expr = fr.iter;
      if let ast.ExprCall(c) = fr.iter {
        iter = ast.ExprCall { ...c, args: nb };
      }
      let (body, ba) = astwalk.map_stmts_acc(fr.body, rw, lit_rewrite_stmt, lit_rewrite_expr);
      return (ast.StmtFor { ...fr, iter: iter, body: body }, rw, true);
    },
    _ => {
      return (st, rw, false);
    }
  }
  return (st, rw, false);
}

function lit_rewrite_expr(e: ast.Expr, rw: LitRewrite): (ast.Expr, LitRewrite, boolean) {
  let at: i32 = util.index_of_str(rw.cargs, lit_float_key(e));
  if (at >= 0) {
    return (lit_float_read(e, parser.parse_type_ref(rw.ctags[at])), rw, true);
  }
  if let ast.ExprCall(c) = e {
    if (lit_call_settled(c, rw)) {
      return (lit_rewrite_call(c, rw), rw, true);
    }
  }
  return (e, rw, false);
}

function lit_float_read(e: ast.Expr, want: parser.TypeRef): ast.Expr {
  if (want.is_tuple) {
    let elems: ast.Expr[] = [];
    let i: i32 = 0;
    while (i < want.args.len()) {
      let part: ast.Expr = ast.ExprFieldAccess { obj: e, field: util.i32_to_string(i), line: expr_line(e), col: expr_col(e), ty: "", const_read: false };
      elems = elems.append(lit_float_read(part, want.args[i]));
      i = i + 1;
    }
    return ast.ExprTuple { elements: elems, line: expr_line(e), col: expr_col(e) };
  }
  if (want.base != "f32" && want.base != "f64") {
    return e;
  }
  if let ast.ExprNumber(n) = e {
    return ast.ExprNumber { ...n, is_float: true, suffix: want.base };
  }
  if let ast.ExprBinary(b) = e {
    return ast.ExprBinary { ...b, left: lit_float_read(b.left, want), right: lit_float_read(b.right, want), ty: want.base };
  }
  if let ast.ExprUnary(u) = e {
    if (u.op == "-" || u.op == "+") {
      return ast.ExprUnary { ...u, operand: lit_float_read(u.operand, want), ty: want.base };
    }
  }
  return ast.ExprUnary { op: "as_" + want.base, operand: e, line: expr_line(e), col: expr_col(e), ty: want.base };
}

function lit_call_settled(c: ast.ExprCall, rw: LitRewrite): boolean {
  let k: i32 = 0;
  while (k < c.args.len()) {
    if (util.index_of_str(rw.cargs, gcall_arg_key(c, k)) >= 0) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

// lit_rewrite_call suffixes the call's settled literal arguments, then
// rewrites inside the call as the walk would have.
function lit_rewrite_call(c: ast.ExprCall, rw: LitRewrite): ast.Expr {
  let args: ast.Expr[] = [];
  let k: i32 = 0;
  while (k < c.args.len()) {
    let a: ast.Expr = c.args[k];
    let at: i32 = util.index_of_str(rw.cargs, gcall_arg_key(c, k));
    if (at >= 0) {
      a = settle_int_tree(a, rw.ctags[at]);
    }
    let (ae, aa, ah) = astwalk.map_expr_acc(a, rw, lit_rewrite_stmt, lit_rewrite_expr);
    args = args.append(ae);
    k = k + 1;
  }
  let (ce, ca, ch) = astwalk.map_expr_acc(c.callee, rw, lit_rewrite_stmt, lit_rewrite_expr);
  return ast.ExprCall { ...c, callee: ce, args: args };
}

// LitScan is the pre-scan that keeps functions with nothing to infer off the
// scoped walk: a declaration the inference could type, or a call of one of
// the module's generic functions with an untyped literal argument.
struct LitScan { found: boolean, generics: string[] }

function lit_scan_stmt(st: ast.Stmt, own sc: LitScan): LitScan {
  if (sc.found || !lit_candidate_at(st)) {
    return sc;
  }
  return LitScan { ...sc, found: true };
}

function lit_scan_expr(e: ast.Expr, own sc: LitScan): LitScan {
  if (sc.found) {
    return sc;
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(cid) = c.callee {
      if (lit_any_int_literal(c.args) && util.has_str(sc.generics, cid.name)) {
        return LitScan { ...sc, found: true };
      }
    }
  }
  return sc;
}

// lit_holds_int_literal is whether e is an untyped integer tree or holds one
// as an element of an array, tuple or struct literal.
// widened_array_tag spells an array literal's type when a typed sibling
// widened its generic struct element past a struct-literal element's own
// instantiation: `[Same { a: 1, b: 2 }, Same { a: 3, b: y }]` is a
// Same[i64][]. "" for any other array.
function widened_array_tag(ea: ast.ExprArray, s: Scope): string {
  let at: typeinfo.Type = check_expr(ea, s);
  if let typeinfo.TypeArray(ta) = at {
    if let typeinfo.TypeStruct(ts) = ta.elem {
      if (!reads_i64(ta.elem)) {
        return "";
      }
      for e in ea.elements {
        if (struct_lit_gives_way(e, check_expr(e, s), ta.elem, s)) {
          return typeinfo.spelling(at);
        }
      }
    }
  }
  return "";
}

function lit_holds_int_literal(e: ast.Expr): boolean {
  if (int_literal_tree(e) || float_literal_tree(e)) {
    return true;
  }
  if let ast.ExprArray(ea) = e {
    return lit_holds_any(ea.elements);
  }
  if let ast.ExprTuple(et) = e {
    return lit_holds_any(et.elements);
  }
  if let ast.ExprStructLit(sl) = e {
    return lit_holds_any(sl.field_values);
  }
  if let ast.ExprCall(c) = e {
    return lit_holds_any(c.args);
  }
  return false;
}

function lit_holds_any(es: ast.Expr[]): boolean {
  for e in es {
    if (lit_holds_int_literal(e)) {
      return true;
    }
  }
  return false;
}

function lit_any_int_literal(args: ast.Expr[]): boolean {
  for a in args {
    if (int_literal_tree(a)) {
      return true;
    }
  }
  return false;
}

function generic_fn_names(funcs: parser.FuncDecl[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    if (fd.receiver_name.len() == 0 && (fd.type_params.len() > 0 || fd.all_type_params.len() > 0)) {
      out = out.append(fd.name);
    }
  }
  return out;
}

// lit_candidate_at: a declaration the inference could type.
function lit_candidate_at(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtMatch(m) => {
      return lit_holds_int_literal(m.scrutinee);
    },
    ast.StmtVar(v) => {
      if (v.type_name.len() > 0 || name_has_comma(v.name)) {
        return false;
      }
      return lit_holds_int_literal(v.init);
    },
    ast.StmtFor(fr) => {
      if (!for_iter_is_range(fr.iter)) {
        return false;
      }
      let bounds: ast.Expr[] = lit_range_bounds(fr.iter);
      return int_literal_tree(bounds[0]) || int_literal_tree(bounds[1]);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function needs_lit_settle(stmts: ast.Stmt[], generics: string[]): boolean {
  let sc: LitScan = LitScan { found: false, generics: generics };
  for stmt in stmts {
    sc = astwalk.fold_stmt_nodes(stmt, sc, lit_scan_stmt, lit_scan_expr, astwalk.descend_all);
  }
  return sc.found;
}

// lit_resolve_pending reads each pending generic read at the width its literal
// locals settled at. Locals left open take the default, as the read does.
function lit_resolve_pending(st: LitInfer): LitInfer {
  let out: LitInfer = st;
  let i: i32 = 0;
  while (i < st.pend.len()) {
    let w: typeinfo.Type = out.width[lit_find(out, st.pend_id[i])];
    if (!is_unknown(w)) {
      out = demand_open(st.pend[i], w, st.pend_scope[i], out);
    }
    i = i + 1;
  }
  return out;
}

function settle_lit_body(stmts: ast.Stmt[], s: Scope): ast.Stmt[] {
  let st: LitInfer = lit_resolve_pending(lit_stmts(stmts, s, LitInfer { parent: [LIT_WIDE], width: [t_i64()], keys: [""], cargs: [], ctags: [], pend: [], pend_id: [], pend_scope: [], skeys: [], snames: [], sfirst: [], sargs: [], sids: [], wkeys: [], wtags: [], eargs: [], eids: [], tkeys: [], ttypes: [] }));
  let rw: LitRewrite = lit_rewrites(st);
  if (rw.keys.len() == 0 && rw.cargs.len() == 0) {
    return stmts;
  }
  let (out, ra) = astwalk.map_stmts_acc(stmts, rw, lit_rewrite_stmt, lit_rewrite_expr);
  return out;
}

// settle_literal_locals writes each literal local's inferred type into the
// module, ahead of the checker's diagnostics and of lowering.
pub function settle_literal_locals(mod: parser.Module): parser.Module {
  let generics: string[] = generic_fn_names(mod.funcs);
  let any: boolean = needs_lit_settle(mod.top_stmts, generics);
  for fd in mod.funcs {
    if (!any && needs_lit_settle(fd.body, generics)) {
      any = true;
    }
  }
  if (!any) {
    return mod;
  }
  return settle_literal_locals_in(mod, module_env(mod), whole_focus(mod));
}

function settle_literal_locals_in(mod: parser.Module, env: ModuleEnv, focus: Focus): parser.Module {
  let generics: string[] = generic_fn_names(mod.funcs);
  let nfuncs: parser.FuncDecl[] = [];
  let k: i32 = 0;
  for func in mod.funcs {
    let hit: boolean = focus.funcs[k] && needs_lit_settle(func.body, generics);
    k = k + 1;
    if (hit) {
      let fs: Scope = build_func_scope(func, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
      nfuncs = nfuncs.append(parser.FuncDecl { ...func, body: settle_lit_body(func.body, fs) });
    } else {
      nfuncs = nfuncs.append(func);
    }
  }
  let ntop: ast.Stmt[] = mod.top_stmts;
  if (focus.top && needs_lit_settle(mod.top_stmts, generics)) {
    ntop = settle_lit_body(mod.top_stmts, new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs));
  }
  return parser.Module { ...mod, funcs: nfuncs, top_stmts: ntop };
}
