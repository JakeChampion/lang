import "./ast";
import "./util";
import "./lexer";
import "./parser";
import "./astwalk";
import "./typeinfo";
import "./decltypes";
import "./semtypes";
import "./stdlib_methods";
import "./consteval";

function t_i32(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 32, unsigned: false, polymorphic: false };
}

function t_i64(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 64, unsigned: false, polymorphic: false };
}

function t_u32(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 32, unsigned: true, polymorphic: false };
}

function t_u64(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 64, unsigned: true, polymorphic: false };
}

function t_usize(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: typeinfo.width_ptr(), unsigned: true, polymorphic: false };
}

function is_usize(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(i) => {
      return i.width == typeinfo.width_ptr() && !i.is_char;
    },
    _ => {
      return false;
    }
  }
}

function t_u8(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 8, unsigned: true, polymorphic: false };
}

function t_char(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: true, width: 32, unsigned: false, polymorphic: false };
}

function lit_is_scalar_value(text: string): boolean {
  let off: i32 = 0;
  if (text.len() > 0 && text[0] == b'-') {
    off = 1;
  }
  let digits: i32 = text.len() - off;
  let is_hex: boolean = digits > 1 && text[off] == b'0' && (text[off + 1] == b'x' || text[off + 1] == b'X');
  if (is_hex) {
    if (digits - 2 > 6) {
      return false;
    }
  } else {
    if (digits > 7) {
      return false;
    }
  }
  let v: i32 = util.lit_to_i32(text);
  if (v < 0 || v > 1114111) {
    return false;
  }
  if (v >= 55296 && v <= 57343) {
    return false;
  }
  return true;
}

function lit_scalar_msg(text: string): string {
  let v: i32 = util.lit_to_i32(text);
  let hint: string = "";
  if (v >= 55296 && v <= 57343) {
    hint = " (this is a surrogate)";
  }
  return util.i32_to_string(v) + " is not a Unicode scalar value, so it cannot be cast to `char`: the range is 0..0x10FFFF excluding the surrogates 0xD800..0xDFFF" + hint + " — use `utf8.char_from_i32` for a value that is only known at run time";
}

function int_label(t: typeinfo.TypeI32): string {
  if (t.is_char) {
    return "char";
  }
  if (t.unsigned) {
    if (t.width == 64) {
      return "u64";
    }
    if (t.width == 8) {
      return "u8";
    }
    if (t.width == typeinfo.width_ptr()) {
      return "usize";
    }
    return "u32";
  }
  if (t.width == 64) {
    return "i64";
  }
  return "i32";
}

function t_bool(): typeinfo.Type {
  return typeinfo.TypeBool { tag: 0 };
}

function t_string(): typeinfo.Type {
  return typeinfo.TypeString { tag: 0 };
}

function t_str(): typeinfo.Type {
  return typeinfo.TypeString { tag: 1 };
}

function is_str_view(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeString(st) => {
      return st.tag == 1;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_owned_string(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeString(st) => {
      return st.tag == 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function str_copy_hint(from: typeinfo.Type, to: typeinfo.Type): string {
  if (is_str_view(from) && is_owned_string(to)) {
    return " — `str` is a borrowed view of a string; add `.to_owned()` to copy it into an owned string";
  }
  return "";
}

function view_arg_borrow(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if (is_str_view(from) && is_owned_string(to)) {
    return true;
  }
  if let typeinfo.TypeArray(fa) = from {
    if let typeinfo.TypeArray(ta) = to {
      return !fa.view && ta.view && (type_eq(fa.elem, ta.elem) || is_unknown(ta.elem));
    }
  }
  return false;
}

function t_float(): typeinfo.Type {
  return typeinfo.TypeFloat { width: 64, polymorphic: false };
}

function t_f32(): typeinfo.Type {
  return typeinfo.TypeFloat { width: 32, polymorphic: false };
}

function t_lanes(width: i32): typeinfo.Type {
  return typeinfo.TypeLanes { width: width };
}

function is_lanes(t: typeinfo.Type): boolean {
  if let typeinfo.TypeLanes(_) = t {
    return true;
  }
  return false;
}

function is_float(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFloat(f) = t {
    return true;
  }
  return false;
}

function is_poly_float(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFloat(f) = t {
    return f.polymorphic;
  }
  return false;
}

function float_label(t: typeinfo.TypeFloat): string {
  if (t.width == 32) {
    return "f32";
  }
  return "f64";
}

function float_operands_agree(a: typeinfo.Type, b: typeinfo.Type): boolean {
  return is_float(a) && is_float(b);
}

function settled_operands(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): (typeinfo.Type, typeinfo.Type) {
  if (is_float(lt) && !is_poly_float(lt) && unsettled_int_literal(b.right)) {
    return (lt, lt);
  }
  if (is_float(rt) && !is_poly_float(rt) && unsettled_int_literal(b.left)) {
    return (rt, rt);
  }
  return (lt, rt);
}

function float_result(a: typeinfo.Type, b: typeinfo.Type): typeinfo.Type {
  if (!float_operands_agree(a, b)) {
    return t_unknown("float operands have incompatible widths");
  }
  if (is_poly_float(a) || typeinfo.lossless_widen(a, b)) {
    return b;
  }
  return a;
}

function is_poly_int(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return i.polymorphic && !i.is_char;
  }
  return false;
}

function join_result_types(a: typeinfo.Type, b: typeinfo.Type): typeinfo.Type {
  if (unbound_enum_argument(a)) {
    return b;
  }
  if (unbound_enum_argument(b)) {
    return a;
  }
  if (integer_literal_widens(a, b) || is_poly_int(a) && is_float(b)) {
    return b;
  }
  if (integer_literal_widens(b, a) || is_poly_int(b) && is_float(a)) {
    return a;
  }
  if let typeinfo.TypeI32(ai) = a {
    if let typeinfo.TypeI32(bi) = b {
      if (type_eq(a, b)) {
        return typeinfo.TypeI32 { ...ai, polymorphic: ai.polymorphic && bi.polymorphic };
      }
    }
  }
  if let typeinfo.TypeUnion(au) = a {
    if let typeinfo.TypeUnion(bu) = b {
      return join_enum_arguments(au, bu);
    }
  }
  if (is_float(a) && is_float(b) && (type_eq(a, b) || is_poly_float(a) || is_poly_float(b))) {
    return float_result(a, b);
  }
  if let typeinfo.TypeTuple(at) = a {
    if let typeinfo.TypeTuple(bt) = b {
      if (at.elements.len() != bt.elements.len()) {
        return t_unknown("result tuple arities differ");
      }
      let elems: typeinfo.Type[] = [];
      let i: i32 = 0;
      while (i < at.elements.len()) {
        let elem: typeinfo.Type = join_result_types(at.elements[i], bt.elements[i]);
        if (is_unknown(elem)) {
          return elem;
        }
        elems = elems.append(elem);
        i = i + 1;
      }
      return t_tuple(elems);
    }
  }
  if (type_eq(a, b)) {
    return a;
  }
  return t_unknown("result types disagree");
}

pub function unbound_enum_argument(t: typeinfo.Type): boolean {
  if let typeinfo.TypeUnknown(u) = t {
    return util.str_has_prefix(u.reason, "unbound ");
  }
  return false;
}

function join_enum_arguments(a: typeinfo.TypeUnion, b: typeinfo.TypeUnion): typeinfo.Type {
  if (a.name != b.name) {
    return t_unknown("result enum names disagree");
  }
  if (a.args.len() == 0) {
    return b;
  }
  if (b.args.len() == 0) {
    return a;
  }
  if (a.args.len() != b.args.len()) {
    return t_unknown("result enum arities differ");
  }
  let args: typeinfo.Type[] = [];
  let i: i32 = 0;
  while (i < a.args.len()) {
    let joined: typeinfo.Type = a.args[i];
    if (unbound_enum_argument(joined)) {
      joined = b.args[i];
    } else if (!unbound_enum_argument(b.args[i])) {
      joined = join_result_types(joined, b.args[i]);
      if (is_unknown(joined)) {
        return joined;
      }
    }
    args = args.append(joined);
    i = i + 1;
  }
  return typeinfo.TypeUnion { name: a.name, args: args };
}

function t_array(elem: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeArray { elem: elem, view: false };
}

function is_sha_hw_builtin(name: string): boolean {
  return name == "__sha256_hw" || name == "__sha1_hw";
}

function byte_kernel_arity(name: string): i32 {
  if (name == "__aes_expand_key") {
    return 1;
  }
  if (name == "__sha256_hw_blocks" || name == "__sha1_hw_blocks") {
    return 2;
  }
  if (name == "__aes_ctr32" || name == "__ghash") {
    return 3;
  }
  if (name == "__aes_gcm_seal" || name == "__aes_gcm_open") {
    return 5;
  }
  return 0 - 1;
}

function t_view(elem: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeArray { elem: elem, view: true };
}

function as_view(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeArray(a) = t {
    return t_view(a.elem);
  }
  return t;
}

function is_arr_view(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return a.view;
  }
  return false;
}

function is_owned_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return !a.view;
  }
  return false;
}

function t_struct(name: string): typeinfo.Type {
  let noargs: typeinfo.Type[] = [];
  return typeinfo.TypeStruct { name: name, args: noargs };
}

function t_struct_g(name: string, args: typeinfo.Type[]): typeinfo.Type {
  return typeinfo.TypeStruct { name: name, args: args };
}

function t_tuple(elements: typeinfo.Type[]): typeinfo.Type {
  return typeinfo.TypeTuple { elements: elements };
}

function no_diags(): util.Diag[] {
  return [];
}

function t_func(param_types: typeinfo.Type[], ret_type: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeFunc { param_types: param_types, param_own: [], ret_type: ret_type, params_known: true };
}

function t_func_own(param_types: typeinfo.Type[], param_own: boolean[], ret_type: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeFunc { param_types: param_types, param_own: callable_own_flags(param_own, param_types.len()), ret_type: ret_type, params_known: true };
}

function callable_own_flags(flags: boolean[], count: i32): boolean[] {
  let out: boolean[] = [];
  let any: boolean = false;
  let i: i32 = 0;
  while (i < count) {
    let on: boolean = i < flags.len() && flags[i];
    out = out.append(on);
    any = any || on;
    i = i + 1;
  }
  return if (any) { out } else { [] };
}

function lambda_owns(lm: ast.ExprLambda): boolean[] {
  let owns: boolean[] = [];
  for param in lm.params {
    owns = owns.append(param.own);
  }
  return owns;
}

function t_func_opaque(ret_type: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeFunc { param_types: [], param_own: [], ret_type: ret_type, params_known: false };
}

function t_map(key: typeinfo.Type, value: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeMap { key: key, value: value };
}

function digit_string_to_i32(s: string): i32 {
  let n: i32 = s.len();
  if (n == 0) {
    return 0 - 1;
  }
  let acc: i32 = 0;
  let i: i32 = 0;
  while (i < n) {
    let b: i32 = s[i] as i32;
    if (b < 48 || b > 57) {
      return 0 - 1;
    }
    acc = acc * 10 + (b - 48);
    i = i + 1;
  }
  return acc;
}

function t_union(name: string): typeinfo.Type {
  let noargs: typeinfo.Type[] = [];
  return typeinfo.TypeUnion { name: name, args: noargs };
}

function t_union_g(name: string, args: typeinfo.Type[]): typeinfo.Type {
  return typeinfo.TypeUnion { name: name, args: args };
}

function canon_trait_set(traits: string): string {
  let names: string[] = [];
  for n in parser.dyn_trait_set("dyn " + traits) {
    names = push_str_unique_sorted(names, n);
  }
  let out: string = "";
  let i: i32 = 0;
  while (i < names.len()) {
    if (i > 0) {
      out = out + " + ";
    }
    out = out + names[i];
    i = i + 1;
  }
  return out;
}

function names_resource_handle(name: string, tn: TypeNames): boolean {
  return tn.resources.names.len() > 0 && tn.resources.has(handle_resource(name));
}

function handle_resource(name: string): string {
  if (name.len() > 4 && slice_unchecked(name, 0, 4) == "own ") {
    return slice_unchecked(name, 4, name.len()) + "";
  }
  if (name.len() > 7 && slice_unchecked(name, 0, 7) == "borrow ") {
    return slice_unchecked(name, 7, name.len()) + "";
  }
  return name;
}

function resource_handle(name: string): typeinfo.Type {
  let borrowed: boolean = name.len() > 7 && slice_unchecked(name, 0, 7) == "borrow ";
  return typeinfo.TypeHandle { resource: handle_resource(name), borrowed: borrowed };
}

function t_dyn(traits: string): typeinfo.Type {
  return typeinfo.TypeDyn { traits: canon_trait_set(traits) };
}

function t_void(): typeinfo.Type {
  return typeinfo.TypeVoid { tag: 0 };
}

function t_unknown(reason: string): typeinfo.Type {
  return typeinfo.TypeUnknown { reason: reason };
}

function is_cell_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(s) = t {
    return s.name == "Cell";
  }
  return false;
}

function cell_elem_type(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeStruct(s) = t {
    if (s.args.len() == 1) {
      return s.args[0];
    }
  }
  return t_unknown("cell element");
}

function is_cell_ref(r: parser.TypeRef): boolean {
  return r.base == "Cell" && r.args.len() == 1;
}

function is_map_ref(r: parser.TypeRef): boolean {
  return r.base == "Map" && r.args.len() == 2;
}

function is_wide_map_ref(r: parser.TypeRef): boolean {
  return r.base == "Map" && r.args.len() > 2;
}

function cell_method_type(recv: typeinfo.Type, name: string, argc: i32): typeinfo.Type {
  if (!is_cell_type(recv)) {
    return t_unknown("not a cell method call");
  }
  if (name == "get" && argc == 0) {
    return cell_elem_type(recv);
  }
  if (name == "set" && argc == 1) {
    return t_void();
  }
  return t_unknown("not a cell method");
}

function is_f64_primitive(name: string): boolean {
  let names: string[] = [
    "__sqrt_f64", "__floor_f64", "__ceil_f64", "__round_f64", "__trunc_f64",
    "__abs_f64",
  ];
  for n in names {
    if (n == name) {
      return true;
    }
  }
  return false;
}

function is_lane_builtin(name: string): boolean {
  let names: string[] = [
    "__f64x2_splat", "__f64x2_of", "__f64x2_lane", "__f64x2_bitmask", "__f64x2_mul_add", "__f64x2_sqrt",
    "__f64x2_abs", "__f64x2_floor", "__f64x2_round", "__f64x2_min", "__f64x2_max",
    "__f64x2_lt", "__f64x2_ne", "__f64x2_select", "__f64x2_load", "__f64x2_with",
    "__f32x4_splat", "__f32x4_of", "__f32x4_lane", "__f32x4_bitmask", "__f32x4_mul_add", "__f32x4_sqrt",
    "__f32x4_abs", "__f32x4_floor", "__f32x4_round", "__f32x4_min", "__f32x4_max",
    "__f32x4_lt", "__f32x4_ne", "__f32x4_select", "__f32x4_load", "__f32x4_with",
  ];
  return typeinfo.lane_builtin_width(name) > 0 && util.has_str(names, name);
}

function is_bit_count(name: string): boolean {
  let names: string[] = ["__clz32", "__ctz32", "__popcount32", "__clz64", "__ctz64", "__popcount64"];
  for n in names {
    if (n == name) {
      return true;
    }
  }
  return false;
}

function internal_name(name: string): boolean {
  return name.len() > 2 && name[0] == b'_' && name[1] == b'_';
}

function intrinsic_result(name: string, argc: i32, t: SigTable): typeinfo.Type {
  if (!internal_name(name)) {
    return t_unknown("not a runtime intrinsic");
  }
  let at: i32 = raw_floor_at(t, name);
  if (at >= 0 && raw_floor_allowed(t, name) && t.raw[at].params.len() == argc) {
    return t.raw[at].result;
  }
  if (argc == 1 && is_f64_primitive(name)) {
    return t_float();
  }
  if (is_lane_builtin(name) && argc == typeinfo.lane_builtin_params(name).len()) {
    return typeinfo.lane_builtin_result(name);
  }
  if (argc == 1 && is_bit_count(name)) {
    return t_i32();
  }
  if (argc == 2 && name == "__mulhi_u64") {
    return t_u64();
  }
  if (argc == 1 && name == "__alloc") {
    return t_usize();
  }
  if (argc == 1 && name == "__alloc_u8") {
    return typeinfo.TypeArray { elem: t_u8(), view: false };
  }
  if (argc == 1 && name == "__alloc_i32") {
    return typeinfo.TypeArray { elem: t_i32(), view: false };
  }
  if (argc == 1 && name == "__alloc_i64") {
    return typeinfo.TypeArray { elem: t_i64(), view: false };
  }
  if (argc == 1 && name == "__alloc_bool") {
    return typeinfo.TypeArray { elem: t_bool(), view: false };
  }
  if (argc == 2 && name == "__free") {
    return t_void();
  }
  if (argc == 2 && name == "__fern_box_free") {
    return t_usize();
  }
  if (argc == 0 && name == "__ptr_width") {
    return t_i32();
  }
  if (argc == 0 && name == "__map_hash_seed") {
    return t_i32();
  }
  if (argc == 0 && name == "__heap_bump_bytes") {
    return t_i64();
  }
  if (argc == 0 && name == "__heap_alloc_count") {
    return t_i64();
  }
  if (argc == 1 && (name == "__ct_secret" || name == "__ct_public")) {
    return t_void();
  }
  if (argc == 1 && name == "__bytes_owned" || argc == 3 && name == "__bytes_range" || argc == 5 && name == "__bytes_into") {
    return t_array(t_u8());
  }
  if (argc == byte_kernel_arity(name)) {
    return t_array(t_u8());
  }
  if (argc == 0 && is_sha_hw_builtin(name)) {
    return t_bool();
  }
  if (argc == 0 && name == "__task_new") {
    return t_i32();
  }
  if (argc == 1 && name == "__task_free") {
    return t_void();
  }
  if (argc == 0 && name == "__task_cur") {
    return t_i32();
  }
  return intrinsic_result_task(name, argc);
}

function intrinsic_result_task(name: string, argc: i32): typeinfo.Type {
  if (argc == 2 && name == "__task_enter") {
    return t_void();
  }
  if (argc == 0 && name == "__task_leave") {
    return t_i32();
  }
  if (argc == 2 && name == "__task_park") {
    return t_i32();
  }
  if (argc == 1 && name == "__task_wait") {
    return t_array(t_i32());
  }
  if (argc == 1 && name == "__task_timeout") {
    return t_i32();
  }
  if (argc == 2 && name == "__task_set_ready") {
    return t_void();
  }
  if (argc == 1 && name == "__task_set_cancelled") {
    return t_void();
  }
  if (argc == 0 && name == "__task_cancelled") {
    return t_i32();
  }
  if (argc == 0 && name == "__heap_mark") {
    return t_i64();
  }
  if (argc == 1 && name == "__heap_release_to") {
    return t_void();
  }
  if (argc == 0 && name == "__rc_underflow_count") {
    return t_i32();
  }
  if (argc == 0 && name == "__arr_push_shared_count") {
    return t_i32();
  }
  if (argc == 0 && name == "__arr_push_shared_bytes") {
    return t_i64();
  }
  if (argc == 1 && name == "__rc_inc") {
    return typeinfo.TypeArray { elem: t_u8(), view: false };
  }
  if (argc == 1 && name == "__rc_dec") {
    return t_void();
  }
  if (argc == 1 && name == "__rc_get") {
    return t_i32();
  }
  if (argc == 3 && name == "__alloc_reuse") {
    return t_usize();
  }
  if (argc == 3 && name == "__memcpy") {
    return t_void();
  }
  if (argc == 3 && name == "__memset") {
    return t_void();
  }
  if (argc == 1 && name == "__load_u8") {
    return t_i32();
  }
  if (argc == 2 && name == "__account_entry") {
    return t_usize();
  }
  if (argc == 1 && name == "__load_i32") {
    return t_i32();
  }
  if (argc == 1 && name == "__load_i64") {
    return t_i64();
  }
  if (argc == 1 && name == "__load_ptr") {
    return t_usize();
  }
  return intrinsic_result_memory(name, argc);
}

function intrinsic_result_memory(name: string, argc: i32): typeinfo.Type {
  if (argc == 2 && name == "__store_u8") {
    return t_void();
  }
  if (argc == 2 && name == "__str_bytes") {
    return t_usize();
  }
  if (argc == 2 && name == "__arr_set_len") {
    return t_void();
  }
  if (argc == 2 && name == "__store_i32") {
    return t_void();
  }
  if (argc == 2 && name == "__store_i64") {
    return t_void();
  }
  if (argc == 2 && name == "__store_ptr") {
    return t_void();
  }
  if (argc == 5 && (name == "__mismatch" || name == "__mismatch_bytes" || name == "__mismatch_bytes_str")) {
    return t_i32();
  }
  if (argc == 1 && name == "__sum_bytes") {
    return t_i32();
  }
  if (argc == 2 && (name == "__scale_f64" || name == "__outer_mul_f64")) {
    return t_array(t_float());
  }
  if (argc == 6 && name == "__inner_mul_add_f64") {
    return t_array(t_float());
  }
  if (argc == 2 && name == "__ascii_run") {
    return t_i32();
  }
  if (argc == 3 && (name == "__scan_set" || name == "__scan_set_bytes")) {
    return t_i32();
  }
  if (argc == 3 && (name == "__count_runs" || name == "__count_runs_bytes")) {
    return t_i32();
  }
  if (argc == 2 && name == "__bsd_sum") {
    return t_i32();
  }
  if (argc == 2 && name == "__str_hash") {
    return t_i32();
  }
  if (argc == 2 && name == "__count_byte") {
    return t_i32();
  }
  if (argc == 2 && (name == "__crc32_cksum" || name == "__crc32_cksum_array")) {
    return t_i32();
  }
  if (argc == 3 && name == "__memchr") {
    return t_i32();
  }
  if (argc == 2 && name == "__count_byte_bytes") {
    return t_i32();
  }
  if (argc == 1 && name == "__sum_bytes_array") {
    return t_i32();
  }
  if (argc == 2 && name == "__bsd_sum_bytes") {
    return t_i32();
  }
  if (argc == 3 && (name == "__memchr_bytes" || name == "__rmemchr_bytes")) {
    return t_i32();
  }
  if (argc == 1 && name == "__fern_rc_inc") {
    return t_usize();
  }
  if (argc == 1 && name == "__fern_str_dec") {
    return t_usize();
  }
  if (argc == 2 && name == "__fern_arr_dec") {
    return t_usize();
  }
  if (argc == 2 && name == "__fern_drop_arr_ptr") {
    return t_usize();
  }
  if (argc == 3 && name == "__rmemchr") {
    return t_i32();
  }
  return t_unknown("not a runtime intrinsic");
}

function builtin_result_type(recv: typeinfo.Type, name: string, is_method: boolean, argc: i32, s: Scope): typeinfo.Type {
  if (is_method) {
    return cell_method_type(recv, name, argc);
  }
  if ((util.str_has_prefix(name, "__raw_") || util.str_has_prefix(name, "__syscall"))
    && (s.defines(name) || s.lookup_sig(name).name.len() > 0)) {
    return t_unknown("a declared callable shadows the raw floor");
  }
  return intrinsic_result(name, argc, s.sigs);
}

function intrinsic_params(name: string, t: SigTable): (typeinfo.Type[], boolean) {
  if (!internal_name(name)) {
    return ([], false);
  }
  let at: i32 = raw_floor_at(t, name);
  if (at >= 0 && raw_floor_allowed(t, name)) {
    return (t.raw[at].params, true);
  }
  if (is_f64_primitive(name)) {
    return ([t_float()], true);
  }
  if (is_lane_builtin(name)) {
    return (typeinfo.lane_builtin_params(name), true);
  }
  if (name == "__clz32" || name == "__ctz32" || name == "__popcount32") {
    return ([t_u32()], true);
  }
  if (name == "__clz64" || name == "__ctz64" || name == "__popcount64") {
    return ([t_u64()], true);
  }
  if (name == "__mulhi_u64") {
    return ([t_u64(), t_u64()], true);
  }
  if (name == "__alloc") {
    return ([t_i32()], true);
  }
  if (name == "__alloc_u8" || name == "__alloc_i32" || name == "__alloc_i64" || name == "__alloc_bool") {
    return ([t_i32()], true);
  }
  if (name == "__free") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__fern_box_free") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__ptr_width") {
    return ([], true);
  }
  if (name == "__map_hash_seed") {
    return ([], true);
  }
  if (name == "__heap_bump_bytes") {
    return ([], true);
  }
  if (name == "__heap_alloc_count") {
    return ([], true);
  }
  if (name == "__ct_secret" || name == "__ct_public" || name == "__bytes_owned") {
    return ([t_view(t_u8())], true);
  }
  if (name == "__bytes_range") {
    return ([t_view(t_u8()), t_i32(), t_i32()], true);
  }
  if (name == "__bytes_into") {
    return ([t_array(t_u8()), t_i32(), t_view(t_u8()), t_i32(), t_i32()], true);
  }
  if (is_sha_hw_builtin(name)) {
    return ([], true);
  }
  if (byte_kernel_arity(name) > 0) {
    let views: typeinfo.Type[] = [];
    while (views.len() < byte_kernel_arity(name)) {
      views = views.append(t_view(t_u8()));
    }
    return (views, true);
  }
  if (name == "__task_new") {
    return ([], true);
  }
  if (name == "__task_free") {
    return ([t_i32()], true);
  }
  if (name == "__task_cur") {
    return ([], true);
  }
  if (name == "__task_enter") {
    return ([t_i32(), t_i32()], true);
  }
  if (name == "__task_leave") {
    return ([], true);
  }
  if (name == "__task_park") {
    return ([t_array(t_i32()), t_i32()], true);
  }
  if (name == "__task_wait") {
    return ([t_i32()], true);
  }
  if (name == "__task_timeout") {
    return ([t_i32()], true);
  }
  if (name == "__task_set_ready") {
    return ([t_i32(), t_i32()], true);
  }
  if (name == "__task_set_cancelled") {
    return ([t_i32()], true);
  }
  if (name == "__task_cancelled") {
    return ([], true);
  }
  if (name == "__heap_mark") {
    return ([], true);
  }
  if (name == "__heap_release_to") {
    return ([t_i64()], true);
  }
  if (name == "__rc_underflow_count" || name == "__arr_push_shared_count" || name == "__arr_push_shared_bytes") {
    return ([], true);
  }
  if (name == "__rc_inc" || name == "__rc_dec" || name == "__rc_get") {
    return ([t_array(t_u8())], true);
  }
  if (name == "__alloc_reuse") {
    return ([t_usize(), t_i32(), t_i32()], true);
  }
  if (name == "__memcpy") {
    return ([t_usize(), t_usize(), t_i32()], true);
  }
  if (name == "__memset") {
    return ([t_usize(), t_i32(), t_i32()], true);
  }
  if (name == "__load_u8" || name == "__load_i32" || name == "__load_i64" || name == "__load_ptr") {
    return ([t_usize()], true);
  }
  if (name == "__store_u8") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__account_entry") {
    return ([t_i32(), t_usize()], true);
  }
  if (name == "__str_bytes") {
    return ([t_string(), t_usize()], true);
  }
  if (name == "__arr_set_len") {
    return ([t_array(t_u8()), t_i32()], true);
  }
  if (name == "__store_i32") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__store_i64") {
    return ([t_usize(), t_i64()], true);
  }
  if (name == "__store_ptr") {
    return ([t_usize(), t_usize()], true);
  }
  if (name == "__mismatch") {
    return ([t_string(), t_i32(), t_string(), t_i32(), t_i32()], true);
  }
  if (name == "__mismatch_bytes") {
    return ([t_view(t_u8()), t_i32(), t_view(t_u8()), t_i32(), t_i32()], true);
  }
  if (name == "__mismatch_bytes_str") {
    return ([t_array(t_u8()), t_i32(), t_string(), t_i32(), t_i32()], true);
  }
  if (name == "__sum_bytes") {
    return ([t_string()], true);
  }
  if (name == "__scale_f64") {
    return ([t_array(t_float()), t_float()], true);
  }
  if (name == "__outer_mul_f64") {
    return ([t_array(t_float()), t_array(t_float())], true);
  }
  if (name == "__inner_mul_add_f64") {
    return ([t_array(t_float()), t_array(t_float()), t_i32(), t_i32(), t_i32(), t_float()], true);
  }
  if (name == "__ascii_run") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__scan_set") {
    return ([t_string(), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__scan_set_bytes") {
    return ([t_array(t_u8()), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__count_runs") {
    return ([t_string(), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__count_runs_bytes") {
    return ([t_array(t_u8()), t_i32(), t_array(t_u8())], true);
  }
  if (name == "__bsd_sum") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__str_hash") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__count_byte") {
    return ([t_string(), t_i32()], true);
  }
  if (name == "__crc32_cksum") {
    return ([t_i32(), t_string()], true);
  }
  if (name == "__crc32_cksum_array") {
    return ([t_i32(), t_view(t_u8())], true);
  }
  if (name == "__memchr" || name == "__rmemchr") {
    return ([t_string(), t_i32(), t_i32()], true);
  }
  if (name == "__count_byte_bytes") {
    return ([t_array(t_u8()), t_i32()], true);
  }
  if (name == "__sum_bytes_array") {
    return ([t_view(t_u8())], true);
  }
  if (name == "__bsd_sum_bytes") {
    return ([t_view(t_u8()), t_i32()], true);
  }
  if (name == "__memchr_bytes" || name == "__rmemchr_bytes") {
    return ([t_array(t_u8()), t_i32(), t_i32()], true);
  }
  if (name == "__fern_rc_inc") {
    return ([t_usize()], true);
  }
  if (name == "__fern_str_dec") {
    return ([t_string()], true);
  }
  if (name == "__fern_arr_dec") {
    return ([t_usize(), t_i32()], true);
  }
  if (name == "__fern_drop_arr_ptr") {
    return ([t_usize(), t_i32()], true);
  }
  return ([], false);
}

pub struct RawFloorSig { name: string, params: typeinfo.Type[], result: typeinfo.Type }

pub function raw_floor_sigs(): RawFloorSig[] {
  let p: typeinfo.Type = t_usize();
  let n: typeinfo.Type = t_i32();
  let w: typeinfo.Type = t_i64();
  return [
    RawFloorSig { name: "__raw_alloc", params: [n], result: p },
    RawFloorSig { name: "__raw_store8", params: [p, n, n], result: t_void() },
    RawFloorSig { name: "__raw_load8", params: [p, n], result: n },
    RawFloorSig { name: "__raw_store_ptr", params: [p, n, p], result: t_void() },
    RawFloorSig { name: "__raw_load_ptr", params: [p, n], result: p },
    RawFloorSig { name: "__raw_string", params: [p, n], result: t_string() },
    RawFloorSig { name: "__raw_array", params: [p], result: typeinfo.TypeArray { elem: n, view: false } },
    RawFloorSig { name: "__raw_arr_ptr", params: [typeinfo.TypeArray { elem: n, view: false }], result: p },
    RawFloorSig { name: "__raw_data", params: [t_string()], result: p },
    RawFloorSig { name: "__raw_arr_box", params: [n], result: p },
    RawFloorSig { name: "__raw_scratch", params: [n], result: p },
    RawFloorSig { name: "__raw_environ", params: [], result: p },
    RawFloorSig { name: "__raw_splice_pipe", params: [], result: p },
    RawFloorSig { name: "__raw_cover", params: [], result: p },
    RawFloorSig { name: "__raw_task_state", params: [], result: p },
    RawFloorSig { name: "__raw_vdso", params: [], result: p },
    RawFloorSig { name: "__raw_call1", params: [p, p], result: n },
    RawFloorSig { name: "__raw_call2", params: [p, p, p], result: n },
    RawFloorSig { name: "__fern_str_eq", params: [p, p], result: t_bool() },
    RawFloorSig { name: "__fern_str_free", params: [p], result: t_void() },
    RawFloorSig { name: "__fern_str_arr_free", params: [p], result: t_void() },
    RawFloorSig { name: "__fern_rc_dec", params: [p], result: t_void() },
    RawFloorSig { name: "__fern_slice_abort", params: [], result: t_void() },
    RawFloorSig { name: "__fern_oob_abort", params: [], result: t_void() },
    RawFloorSig { name: "__fern_vdso_clock", params: [], result: p },
    RawFloorSig { name: "__syscall3", params: [n, w, w, w], result: w },
    RawFloorSig { name: "__syscall4", params: [n, w, w, w, w], result: w },
    RawFloorSig { name: "__syscall5", params: [n, w, w, w, w, w], result: w },
    RawFloorSig { name: "__syscall6", params: [n, w, w, w, w, w, w], result: w },
    RawFloorSig { name: "__raw_vg_request", params: [p], result: w },
    RawFloorSig { name: "__raw_utf8_blocks", params: [p, n, n], result: n },
  ];
}

function raw_floor_allowed(t: SigTable, name: string): boolean {
  return t.raw_allowed || name == "__fern_rc_dec";
}

function raw_floor_at(t: SigTable, name: string): i32 {
  if (!util.str_has_prefix(name, "__raw_") && !util.str_has_prefix(name, "__syscall") && !util.str_has_prefix(name, "__fern_")) {
    return 0 - 1;
  }
  let i: i32 = 0;
  while (i < t.raw.len()) {
    if (t.raw[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function lane_index_diags(name: string, c: ast.ExprCall): util.Diag[] {
  if (c.args.len() != 2 || !is_lane_builtin(name) || typeinfo.lane_builtin_verb(name) != "lane") {
    return [];
  }
  let lanes: i32 = 128 / typeinfo.lane_builtin_width(name);
  if let ast.ExprNumber(n) = c.args[1] {
    let start: i32 = 0;
    if (parser.is_hex_lit(n.text)) {
      start = 2;
    }
    if (!n.is_float && !parser.is_quoted_literal(n) && parser.magnitude_fits(n.text, start, util.i32_to_string(lanes - 1))) {
      return [];
    }
  }
  return [dg_at("E038", "argument 2 to \"" + name + "\": the lane index is an integer literal from 0 to " + util.i32_to_string(lanes - 1), expr_line(c.args[1]), expr_col(c.args[1]))];
}

function free_builtin_sig(name: string, s: Scope): typeinfo.Type {
  let (params, known) = intrinsic_params(name, s.sigs);
  if (known) {
    return t_func(params, intrinsic_result(name, params.len(), s.sigs));
  }
  if (is_display_builtin(name)) {
    return t_unknown("a Display builtin");
  }
  return builtin_sig(name);
}

pub function type_debug(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(x) => {
      return int_label(x);
    },
    typeinfo.TypeBool(_) => {
      return "bool";
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    typeinfo.TypeArray(a) => {
      return "array<" + type_debug(a.elem) + ">";
    },
    typeinfo.TypeStruct(st) => {
      return "struct:" + st.name;
    },
    typeinfo.TypeTuple(tp) => {
      let out: string = "tuple<";
      let i: i32 = 0;
      while (i < tp.elements.len()) {
        if (i > 0) {
          out = out + ", ";
        }
        out = out + type_debug(tp.elements[i]);
        i = i + 1;
      }
      return out + ">";
    },
    typeinfo.TypeFunc(f) => {
      return "fn";
    },
    typeinfo.TypeMap(m) => {
      return "map<" + type_debug(m.key) + ", " + type_debug(m.value) + ">";
    },
    typeinfo.TypeUnion(u) => {
      return "union:" + u.name;
    },
    typeinfo.TypeDyn(d) => {
      return "dyn:" + d.traits;
    },
    typeinfo.TypeHandle(h) => {
      return "handle:" + typeinfo.handle_spelling(h);
    },
    typeinfo.TypeVoid(_) => {
      return "void";
    },
    typeinfo.TypeNever(_) => {
      return "never";
    },
    typeinfo.TypeUnknown(uk) => {
      return "unknown(" + uk.reason + ")";
    },
    typeinfo.TypeErased(e) => {
      return "erased(" + e.name + ")";
    }
  }
  return "?";
}

function is_integer(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(i) => {
      return !i.is_char;
    },
    _ => {
      return false;
    }
  }
}

function int_operands_agree(lt: typeinfo.Type, rt: typeinfo.Type, le: ast.Expr, re: ast.Expr): boolean {
  if (int_literal_tree(le) || int_literal_tree(re)) {
    return true;
  }
  if (is_usize(lt) || is_usize(rt)) {
    return true;
  }
  return int_is_unsigned(lt) == int_is_unsigned(rt) || !is_unknown(typeinfo.mixed_integer_join(lt, rt));
}

function int_is_unsigned(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(i) => {
      return i.unsigned;
    },
    _ => {
      return false;
    }
  }
}

function mixed_int_diag(op: string, lt: typeinfo.Type, rt: typeinfo.Type, line: i32, col: i32): util.Diag {
  return dg_at(
    "E009", "operator \"" + op + "\" requires both operands to share an integer type; got "
      + type_label(lt) + " and " + type_label(rt) + " — use `as` for explicit conversion",
    line, col,
  );
}

function numeric_operand_diags(op: string, lt: typeinfo.Type, rt: typeinfo.Type, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let want_float: boolean = op != "%" && (is_float(lt) || is_float(rt));
  if (want_float && is_float(lt) && is_float(rt)) {
    return [dg_at("E009", "operator \"" + op + "\" requires both operands to share a float type; got " + type_label(lt) + " and " + type_label(rt) + " — use `as` for explicit conversion", line, col)];
  }
  for operand in [lt, rt] {
    if (want_float && !is_float(operand)) {
      out = out.append(dg_at("E009", "operator \"" + op + "\" requires float, got " + type_label(operand), line, col));
    } else if (!want_float && !is_integer(operand)) {
      out = out.append(dg_at("E009", "operator \"" + op + "\" requires an integer type, got " + type_label(operand), line, col));
    }
  }
  return out;
}

function int_result(lt: typeinfo.Type, rt: typeinfo.Type, le: ast.Expr, re: ast.Expr): typeinfo.Type {
  if (int_literal_tree(le) && !int_literal_tree(re)) {
    return rt;
  }
  if (int_literal_tree(re) && !int_literal_tree(le)) {
    return lt;
  }
  if (unsettled_int_literal(le)) {
    return rt;
  }
  return wider_int(lt, rt);
}

function wider_int(lt: typeinfo.Type, rt: typeinfo.Type): typeinfo.Type {
  let mixed: typeinfo.Type = typeinfo.mixed_integer_join(lt, rt);
  if (!is_unknown(mixed)) {
    return mixed;
  }
  if (is_usize(lt)) {
    return lt;
  }
  if (is_usize(rt)) {
    return rt;
  }
  match (lt) {
    typeinfo.TypeI32(li) => {
      match (rt) {
        typeinfo.TypeI32(ri) => {
          if (ri.width > li.width) {
            return rt;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return lt;
}

function type_eq(a: typeinfo.Type, b: typeinfo.Type): boolean {
  match (a) {
    typeinfo.TypeI32(ai) => {
      match (b) {
        typeinfo.TypeI32(bi) => {
          return ai.is_char == bi.is_char && ai.width == bi.width && ai.unsigned == bi.unsigned;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeBool(_) => {
      match (b) {
        typeinfo.TypeBool(_) => {
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeString(_) => {
      match (b) {
        typeinfo.TypeString(_) => {
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeFloat(af) => {
      match (b) {
        typeinfo.TypeFloat(bf) => {
          return af.width == bf.width;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeLanes(al) => {
      match (b) {
        typeinfo.TypeLanes(bl) => {
          return al.width == bl.width;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeArray(ae) => {
      match (b) {
        typeinfo.TypeArray(be) => {
          return type_eq(ae.elem, be.elem);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeStruct(an) => {
      match (b) {
        typeinfo.TypeStruct(bn) => {
          return an.name == bn.name;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeTuple(at) => {
      match (b) {
        typeinfo.TypeTuple(bt) => {
          if (at.elements.len() != bt.elements.len()) {
            return false;
          }
          let i: i32 = 0;
          while (i < at.elements.len()) {
            if (!type_eq(at.elements[i], bt.elements[i])) {
              return false;
            }
            i = i + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeFunc(af) => {
      match (b) {
        typeinfo.TypeFunc(bf) => {
          if (af.param_types.len() != bf.param_types.len()) {
            return false;
          }
          if (!type_eq(af.ret_type, bf.ret_type)) {
            return false;
          }
          let fi: i32 = 0;
          while (fi < af.param_types.len()) {
            if (!type_eq(af.param_types[fi], bf.param_types[fi])) {
              return false;
            }
            fi = fi + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeMap(am) => {
      match (b) {
        typeinfo.TypeMap(bm) => {
          return type_eq(am.key, bm.key) && type_eq(am.value, bm.value);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeUnion(an) => {
      match (b) {
        typeinfo.TypeUnion(bn) => {
          return an.name == bn.name;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeDyn(ad) => {
      match (b) {
        typeinfo.TypeDyn(bd) => {
          return ad.traits == bd.traits;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeHandle(ah) => {
      if let typeinfo.TypeHandle(bh) = b {
        return ah.resource == bh.resource && ah.borrowed == bh.borrowed;
      }
      return false;
    },
    typeinfo.TypeVoid(_) => {
      match (b) {
        typeinfo.TypeVoid(_) => {
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeUnknown(_) => {
      return false;
    },
    typeinfo.TypeNever(_) => {
      if let typeinfo.TypeNever(_) = b {
        return true;
      }
      return false;
    },
    typeinfo.TypeErased(ae) => {
      if let typeinfo.TypeErased(be) = b {
        return ae.name == be.name;
      }
      return false;
    }
  }
  return false;
}

function is_unknown(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_void(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeVoid(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_func_type(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeFunc(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_tuple_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  return false;
}

function type_contains_unknown(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return !unbound_enum_argument(t);
    },
    typeinfo.TypeArray(ae) => {
      return type_contains_unknown(ae.elem);
    },
    typeinfo.TypeTuple(tt) => {
      for element in tt.elements {
        if (type_contains_unknown(element)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeMap(m) => {
      return type_contains_unknown(m.key) || type_contains_unknown(m.value);
    },
    typeinfo.TypeStruct(sn) => {
      for arg in sn.args {
        if (type_contains_unknown(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        if (type_contains_unknown(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeFunc(f) => {
      if (type_contains_unknown(f.ret_type)) {
        return true;
      }
      for param_type in f.param_types {
        if (type_contains_unknown(param_type)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_composite_type(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeStruct(_) => {
      return true;
    },
    typeinfo.TypeUnion(_) => {
      return true;
    },
    typeinfo.TypeArray(_) => {
      return true;
    },
    typeinfo.TypeTuple(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function cmp_method_receiver(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeStruct(st) => {
      return st.name;
    },
    typeinfo.TypeUnion(u) => {
      return u.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function (s: Scope) has_ord_cmp(t: typeinfo.Type): boolean {
  let recv: string = cmp_method_receiver(t);
  return recv != "" && s.lookup_method("cmp", recv).name.len() > 0;
}

function (s: Scope) orders_alike(a: typeinfo.Type, b: typeinfo.Type): boolean {
  return type_eq(a, b) && s.has_ord_cmp(a);
}

function (s: Scope) binop_overload_ret(op: string, lt: typeinfo.Type): typeinfo.Type {
  return s.overload_ret(ast.operator_method(op), lt);
}

function (s: Scope) unop_overload_ret(op: string, ot: typeinfo.Type): typeinfo.Type {
  if (op != "-") {
    return t_unknown("operator has no overload form");
  }
  return s.overload_ret("neg", ot);
}

function (s: Scope) overload_ret(method: string, t: typeinfo.Type): typeinfo.Type {
  if (method == "") {
    return t_unknown("operator has no overload form");
  }
  let recv: string = cmp_method_receiver(t);
  if (recv == "") {
    return t_unknown("operand is not a nominal type");
  }
  return s.lookup_method(method, recv).ret_type;
}

function downcast_operand_ok(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeDyn(_) => {
      return true;
    },
    typeinfo.TypeUnknown(_) => {
      return true;
    },
    typeinfo.TypeNever(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function is_primitive_type(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(_) => {
      return true;
    },
    typeinfo.TypeBool(_) => {
      return true;
    },
    typeinfo.TypeString(_) => {
      return true;
    },
    typeinfo.TypeFloat(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function as_cast_allowed(src: typeinfo.Type, tgt: typeinfo.Type): boolean {
  if (type_eq(src, tgt)) {
    return true;
  }
  let src_num: boolean = is_integer(src) || type_eq(src, t_char()) || is_float(src);
  let tgt_num: boolean = is_integer(tgt) || type_eq(tgt, t_char()) || is_float(tgt);
  if (src_num && tgt_num) {
    return true;
  }
  if (type_eq(src, t_string()) && cast_pointer_int(tgt)) {
    return true;
  }
  if (cast_pointer_int(src) && type_eq(tgt, t_string())) {
    return true;
  }
  return false;
}

function cast_pointer_int(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return !i.is_char && (i.width == 32 || i.width == typeinfo.width_ptr());
  }
  return false;
}

function cast_pointer_shaped(t: typeinfo.Type, source: boolean): boolean {
  match (t) {
    typeinfo.TypeArray(a) => {
      return source || !a.view;
    },
    typeinfo.TypeStruct(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub struct FuncSig { name: string, param_types: typeinfo.Type[], param_own: boolean[], ret_type: typeinfo.Type, all_type_params: string[], type_params: string[], type_bounds: string[], ret_type_name: string, param_type_names: string[], param_names: string[], is_const: boolean, receiver: string, typevars: string[], module: string, refs: parser.TypeRef[] }

function sig_param_ref(sig: FuncSig, i: i32): parser.TypeRef {
  if (sig.refs.len() > 0) {
    return sig.refs[i];
  }
  return parser.parse_type_ref(sig.param_type_names[i]);
}

function sig_ret_ref(sig: FuncSig): parser.TypeRef {
  if (sig.refs.len() > 0) {
    return sig.refs[sig.param_type_names.len()];
  }
  return parser.parse_type_ref(sig.ret_type_name);
}

function generic_sig_refs(all_type_params: string[], param_type_names: string[], ret_type_name: string): parser.TypeRef[] {
  let out: parser.TypeRef[] = [];
  if (all_type_params.len() == 0) {
    return out;
  }
  for sp in param_type_names {
    out = out.append(parser.parse_type_ref(sp));
  }
  return out.append(parser.parse_type_ref(ret_type_name));
}

pub struct StructSig { name: string, field_names: string[], field_types: typeinfo.Type[], type_params: string[], field_type_names: string[], variant_field_names: string[], derives: string[], enum_owner: string, opaque: boolean, module: string }

pub struct MethodSig { name: string, receiver_type: string, param_types: typeinfo.Type[], ret_type: typeinfo.Type, ret_type_name: string, param_type_names: string[], all_type_params: string[], type_params: string[], type_bounds: string[], module: string, impl_trait: string, line: i32, col: i32, file: string }

pub struct UnionSig { name: string, variants: string[], is_try: boolean, is_enum: boolean, module: string, type_params: string[], instance: string, visible_from: string[] }

pub struct Scope {
  names: string[],
  types: typeinfo.Type[],
  sigs: SigTable,
  structs: StructTable,
  unions: UnionTable,
  names_of_types: TypeNames,
  methods: MethodTable,
  imports: Imports,
  loop_depth: i32,
  ret_type: typeinfo.Type,
  try_ret: typeinfo.Type,
  impls: parser.ImplInfo[],
  trait_reqs: parser.TraitReq[],
  fn_module: string,
  default_trait: string,
  default_recv: string,
  tparams: string[],
  tbounds: string[],
  lit_locals: string[],
}

pub struct SigTable {
  sigs: FuncSig[],
  head: i32[],
  next: i32[],
  raw: RawFloorSig[],
  raw_allowed: boolean,
}

function sig_buckets(): i32 {
  return 4093;
}

function sig_name_bucket(name: string): i32 {
  return (__str_hash(name, 0) & 1073741823) % 4093;
}

function sig_table(sigs: FuncSig[]): SigTable {
  let head: i32[] = util.minus_ones(sig_buckets());
  let next: i32[] = util.minus_ones(sigs.len());
  let k: i32 = sigs.len() - 1;
  while (k >= 0) {
    let nm: string = sigs[k].name;
    let bk: i32 = sig_name_bucket(nm);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    k = k - 1;
  }
  return SigTable { sigs: sigs, head: head, next: next, raw: raw_floor_sigs(), raw_allowed: true };
}

pub struct StructTable {
  structs: StructSig[],
  index: util.NameIndex,
  heads: util.NameIndex,
  resources: util.NameIndex,
  spellings: SpellMemo,
}

pub struct SpellMemo { names: util.NameIndex, types: typeinfo.Type[] }

function no_spellings(): SpellMemo {
  let none: string[] = [];
  return SpellMemo { names: util.name_index(none), types: [] };
}

pub struct TypeNames {
  structs: util.NameIndex,
  unions: util.NameIndex,
  resources: util.NameIndex,
  spellings: SpellMemo,
}

function type_names(struct_names: string[], union_names: string[], resource_names: string[]): TypeNames {
  return TypeNames { structs: util.name_index(struct_names), unions: util.name_index(union_names), resources: util.name_index(resource_names), spellings: no_spellings() };
}

function with_spellings(tn: TypeNames, mod: parser.Module): TypeNames {
  let names: util.NameIndex = tn.spellings.names;
  let types: typeinfo.Type[] = [];
  for sp in module_spellings(mod) {
    if (sp.len() == 0 || names.has(sp)) {
      continue;
    }
    names = names.added(sp);
    types = types.append(type_from_spelling(sp, tn));
  }
  return TypeNames { ...tn, spellings: SpellMemo { names: names, types: types } };
}

function module_spellings(mod: parser.Module): string[] {
  let out: string[] = [];
  for fd in mod.funcs {
    for p in fd.params {
      out = out.append(p.type_name);
    }
    out = out.append(fd.ret_type);
    for st in fd.body {
      out = astwalk.fold_stmt_spine(st, out, spelling_of_stmt);
    }
  }
  for sd in mod.structs {
    for f in sd.fields {
      out = out.append(f.type_name);
    }
  }
  for st in mod.top_stmts {
    out = astwalk.fold_stmt_spine(st, out, spelling_of_stmt);
  }
  return out;
}

function spelling_of_stmt(st: ast.Stmt, own acc: string[]): string[] {
  match (st) {
    ast.StmtVar(v) => {
      return acc.append(v.type_name);
    },
    _ => {
      return acc;
    }
  }
}

function struct_table(structs: StructSig[], union_names: string[], resources: string[], spellings: SpellMemo): StructTable {
  let names: string[] = [];
  for sd in structs {
    names = names.append(sd.name);
  }
  return StructTable { structs: structs, index: util.name_index(names), heads: util.name_index(type_head_names(structs, union_names)), resources: util.name_index(resources), spellings: spellings };
}

function type_head_names(structs: StructSig[], union_names: string[]): string[] {
  let unions: util.NameIndex = util.name_index(union_names);
  let out: string[] = [];
  for sd in structs {
    if (sd.enum_owner.len() == 0 || !unions.has(sd.name)) {
      out = out.append(sd.name);
    }
  }
  return out;
}

function resource_names(mod: parser.Module): string[] {
  let out: string[] = [];
  for r in parser.registered_resources(mod) {
    out = out.append(r.name);
  }
  return out;
}

pub struct UnionTable {
  unions: UnionSig[],
  vnames: string[],
  vowner: i32[],
  index: util.NameIndex,
  head: i32[],
  next: i32[],
  lib_head: i32[],
  lib_next: i32[],
  from_import: boolean,
  bnames: string[],
  bhead: i32[],
  bnext: i32[],
}

function enum_union_sig(ed: parser.EnumDecl): UnionSig {
  return UnionSig { name: ed.name, variants: ed.variant_names, is_try: ed.try_marker, is_enum: true, module: ed.module, type_params: ed.type_params, instance: ed.instance, visible_from: ed.visible_from };
}

function union_table(unions: UnionSig[]): UnionTable {
  let head: i32[] = util.minus_ones(sig_buckets());
  let vnames: string[] = [];
  let vowner: i32[] = [];
  let u: i32 = 0;
  while (u < unions.len()) {
    let vs: string[] = unions[u].variants;
    let v: i32 = 0;
    while (v < vs.len()) {
      vnames = vnames.append(vs[v]);
      vowner = vowner.append(u);
      v = v + 1;
    }
    u = u + 1;
  }
  let next: i32[] = util.minus_ones(vnames.len());
  let lib_head: i32[] = head;
  let lib_next: i32[] = next;
  let bnames: string[] = [];
  let b: i32 = 0;
  while (b < vnames.len()) {
    bnames = bnames.append(unprefixed_variant(vnames[b], unions[vowner[b]].module));
    b = b + 1;
  }
  let bhead: i32[] = head;
  let bnext: i32[] = next;
  let k: i32 = vnames.len() - 1;
  while (k >= 0) {
    let bk: i32 = sig_name_bucket(vnames[k]);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    if (!declared_by_entry(unions[vowner[k]])) {
      lib_next = lib_next.with(k, lib_head[bk]);
      lib_head = lib_head.with(bk, k);
    }
    let bb: i32 = sig_name_bucket(bnames[k]);
    bnext = bnext.with(k, bhead[bb]);
    bhead = bhead.with(bb, k);
    k = k - 1;
  }
  let names: string[] = [];
  let m: i32 = 0;
  while (m < unions.len()) {
    names = names.append(unions[m].name);
    m = m + 1;
  }
  return UnionTable { unions: unions, vnames: vnames, vowner: vowner, index: util.name_index(names), head: head, next: next, lib_head: lib_head, lib_next: lib_next, from_import: false, bnames: bnames, bhead: bhead, bnext: bnext };
}

function declared_by_entry(u: UnionSig): boolean {
  return u.module.len() == 0;
}

function unprefixed_variant(name: string, module: string): string {
  let m: i32 = module.len();
  if (m > 0 && name.len() > m + 2 && name[m] == b'_' && name[m + 1] == b'_' && slice_unchecked(name, 0, m) == module) {
    return slice_unchecked(name, m + 2, name.len()) + "";
  }
  return name;
}

function enum_visible_from(u: UnionSig, from: string): boolean {
  return u.module == from || util.has_str(u.visible_from, from);
}

function enum_access_diags(u: UnionSig, s: Scope, line: i32, col: i32): util.Diag[] {
  if (u.is_enum && !parser.is_reserved_enum_name(u.name) && !enum_visible_from(u, s.fn_module)) {
    return [dg_at("E087", "enum " + util.demangle(u.name) + " is not visible from this package", line, col)];
  }
  return [];
}

function (ut: UnionTable) seen_from(fd: parser.FuncDecl): UnionTable {
  return UnionTable { ...ut, from_import: fd.module.len() > 0 };
}

function (ut: UnionTable) variant_chain_head(name: string): i32 {
  if (ut.from_import) {
    return ut.lib_head[sig_name_bucket(name)];
  }
  return ut.head[sig_name_bucket(name)];
}

function (ut: UnionTable) variant_chain_next(e: i32): i32 {
  if (ut.from_import) {
    return ut.lib_next[e];
  }
  return ut.next[e];
}

pub struct MethodTable {
  methods: MethodSig[],
  head: i32[],
  next: i32[],
  shead: i32[],
  snext: i32[],
}

function method_table(methods: MethodSig[]): MethodTable {
  let head: i32[] = util.minus_ones(sig_buckets());
  let next: i32[] = util.minus_ones(methods.len());
  let shead: i32[] = util.minus_ones(sig_buckets());
  let snext: i32[] = util.minus_ones(methods.len());
  let k: i32 = methods.len() - 1;
  while (k >= 0) {
    let bk: i32 = sig_name_bucket(methods[k].name);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    let sb: i32 = sig_name_bucket(method_simple_name(methods[k].name));
    snext = snext.with(k, shead[sb]);
    shead = shead.with(sb, k);
    k = k - 1;
  }
  return MethodTable { methods: methods, head: head, next: next, shead: shead, snext: snext };
}

function (s: Scope) trait_providers(name: string, recv_type: string): MethodSig[] {
  let out: MethodSig[] = [];
  let i: i32 = s.methods.shead[sig_name_bucket(name)];
  while (i >= 0) {
    let m: MethodSig = s.methods.methods[i];
    if (m.impl_trait.len() > 0 && method_simple_name(m.name) == name && (m.receiver_type == recv_type || parser.parse_type_ref(m.receiver_type).base == recv_type)) {
      out = out.append(m);
    }
    i = s.methods.snext[i];
  }
  return out;
}

function trait_visible_from(s: Scope, tname: string, from: string): boolean {
  for tr in s.trait_reqs {
    if (tr.trait_name == tname || method_simple_name(tr.trait_name) == method_simple_name(tname)) {
      return tr.module.len() == 0 || tr.module == from || util.has_str(tr.visible_from, from);
    }
  }
  return true;
}

function ambiguous_call_diags(fa: ast.ExprFieldAccess, recv_type: string, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (util.index_of_sub(fa.field, ".") >= 0) {
    return out;
  }
  let cands: MethodSig[] = s.trait_providers(fa.field, recv_type);
  if (cands.len() < 2) {
    return out;
  }
  if (s.default_trait.len() > 0 && recv_type == s.default_recv) {
    for m in cands {
      if (method_simple_name(m.impl_trait) == s.default_trait) {
        return out;
      }
    }
  }
  let best: MethodSig[] = [];
  for m in cands {
    if (trait_visible_from(s, m.impl_trait, s.fn_module)) {
      best = best.append(m);
    }
  }
  if (best.len() == 0) {
    best = cands;
  }
  if (best.len() < 2) {
    return out;
  }
  best = util.sorted_by(best, method_provider_after);
  let providers: string = "";
  for m in best {
    if (providers.len() > 0) {
      providers = providers + " and ";
    }
    providers = providers + sig_provider(m);
  }
  let msg: string = "ambiguous method \"" + fa.field + "\" on " + util.demangle(recv_type) + ": provided by " + providers;
  return out.append(dg_at("E074", msg, fa.line, fa.col));
}

function finalizer_call_diags(fa: ast.ExprFieldAccess, recv_type: string, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (fa.field != "drop") {
    return out;
  }
  for m in s.trait_providers("drop", recv_type) {
    if (method_simple_name(m.impl_trait) == "Drop") {
      let msg: string = "`drop` is a finalizer, not a method to call: the runtime runs " + util.demangle(recv_type) + "'s `drop` when the value's last reference goes away, so calling it here runs the body a second time on a value that will still be finalized";
      return out.append(dg_at("E073", msg, fa.line, fa.col + 1));
    }
  }
  return out;
}

function method_provider_after(a: MethodSig, b: MethodSig): boolean {
  return a.impl_trait > b.impl_trait;
}

function sig_provider(m: MethodSig): string {
  return "trait " + util.demangle(m.impl_trait) + " (declared at " + m.file + util.i32_to_string(util.pos_line(m.line)) + ":" + util.i32_to_string(m.col) + ")";
}

function decl_file_label(fd: parser.FuncDecl): string {
  if (fd.stdlib.len() > 0) {
    return fd.stdlib + ".fern:";
  }
  if (fd.module.len() > 0) {
    return fd.module + ".fern:";
  }
  return "";
}

function new_scope(): Scope {
  let ns: string[] = [];
  let ts: typeinfo.Type[] = [];
  let fs: FuncSig[] = [];
  let ss: StructSig[] = [];
  let us: UnionSig[] = [];
  let ms: MethodSig[] = [];
  let structs: StructTable = struct_table(ss, [], [], no_spellings());
  let unions: UnionTable = union_table(us);
  return Scope { names: ns, types: ts, sigs: sig_table(fs), structs: structs, unions: unions, names_of_types: type_names_of(structs, unions), methods: method_table(ms), imports: Imports { paths: [], sights: [] }, loop_depth: 0, ret_type: t_unknown("no enclosing function"), try_ret: t_unknown("no enclosing function"), impls: [], trait_reqs: [], fn_module: "", default_trait: "", default_recv: "", tparams: [], tbounds: [], lit_locals: [] };
}

function new_scope_full(st: SigTable, structs: StructTable, unions: UnionTable, methods: MethodTable, imports: Imports, impls: parser.ImplInfo[], trait_reqs: parser.TraitReq[]): Scope {
  let ns: string[] = [];
  let ts: typeinfo.Type[] = [];
  return Scope { names: ns, types: ts, sigs: st, structs: structs, unions: unions, names_of_types: type_names_of(structs, unions), methods: methods, imports: imports, loop_depth: 0, ret_type: t_unknown("no enclosing function"), try_ret: t_unknown("no enclosing function"), impls: impls, trait_reqs: trait_reqs, fn_module: "", default_trait: "", default_recv: "", tparams: [], tbounds: [], lit_locals: [] };
}

function (s: Scope) bind(name: string, t: typeinfo.Type): Scope {
  let ns: string[] = s.names.append(name);
  let ts: typeinfo.Type[] = s.types.append(t);
  if (!util.has_str(s.lit_locals, name)) {
    return Scope { ...s, names: ns, types: ts };
  }
  let lits: string[] = [];
  for lit in s.lit_locals {
    if (lit != name) {
      lits = lits.append(lit);
    }
  }
  return Scope { ...s, names: ns, types: ts, lit_locals: lits };
}

function (s: Scope) bind_inferred(v: ast.StmtVar, t: typeinfo.Type): Scope {
  let b: Scope = s.bind(v.name, cell_new_settled(v.init, t, s));
  if (is_integer(t) && unsettled_tree(v.init, s.lit_locals)) {
    return Scope { ...b, lit_locals: b.lit_locals.append(v.name) };
  }
  return b;
}

function cell_new_settled(init: ast.Expr, t: typeinfo.Type, s: Scope): typeinfo.Type {
  if (!is_cell_type(t) || !is_unknown(cell_elem_type(t))) {
    return t;
  }
  if let ast.ExprCall(c) = init {
    if let ast.ExprIdent(id) = c.callee {
      if (id.name == "cell_new" && c.args.len() == 1) {
        let et: typeinfo.Type = check_expr(c.args[0], s);
        if (!is_unknown(et)) {
          return t_struct_g("Cell", [et]);
        }
      }
    }
  }
  return t;
}

function (s: Scope) with_tparams(tparams: string[], tbounds: string[]): Scope {
  return Scope { ...s, tparams: tparams, tbounds: tbounds };
}

function (s: Scope) is_const_param(name: string): boolean {
  let i: i32 = util.index_of_str(s.tparams, name);
  if (i < 0 || i >= s.tbounds.len() || !parser.is_const_bound(s.tbounds[i])) {
    return false;
  }
  return util.index_of_str(s.names, name) == s.binding_index(name);
}

function (s: Scope) type_names(): TypeNames {
  return s.names_of_types;
}

function type_names_of(structs: StructTable, unions: UnionTable): TypeNames {
  return TypeNames { structs: structs.heads, unions: unions.index, resources: structs.resources, spellings: structs.spellings };
}

function (s: Scope) resolve_type(name: string): typeinfo.Type {
  return type_from_name_subst(name, s.tparams, rigid_tparams(s.tparams), s.type_names());
}

function (s: Scope) defines(name: string): boolean {
  let i: i32 = s.names.len() - 1;
  while (i >= 0) {
    if (s.names[i] == name) {
      return true;
    }
    i = i - 1;
  }
  return false;
}

function name_has_comma(name: string): boolean {
  for ch in name {
    if (ch == b',') {
      return true;
    }
  }
  return false;
}

function bind_destructure_names(s: Scope, v: ast.StmtVar): Scope {
  if (!name_has_comma(v.name) && !parser.is_destr_marker(v.type_name)) {
    return s;
  }
  let at: string = parser.destr_marker_split(v.type_name).at;
  let whole: typeinfo.Type = check_expr(v.init, s);
  let out: Scope = s;
  if (at.len() > 0) {
    out = out.bind(at, whole);
  }
  if (parser.is_struct_destr_marker(v.type_name)) {
    return bind_struct_destr_fields(out, v, s);
  }
  return bind_tuple_destr_names(out, split_pattern_names(v.name), whole);
}

function bind_struct_destr_fields(out: Scope, v: ast.StmtVar, s: Scope): Scope {
  let (fields, ok) = struct_destr_fields(v.type_name);
  if (!ok) {
    return bind_names(out, v.name);
  }
  let names: string[] = split_pattern_names(v.name);
  let i: i32 = 0;
  while (i < names.len()) {
    let ft: typeinfo.Type = t_unknown("binding");
    if (i < fields.len()) {
      ft = check_expr(ast.ExprFieldAccess { obj: v.init, field: fields[i], line: v.line, col: v.col, ty: "", const_read: false }, s);
    }
    out = out.bind(names[i], ft);
    i = i + 1;
  }
  return out;
}

function struct_destr_fields(type_name: string): (string[], boolean) {
  let marker: string = parser.destr_marker_split(type_name).tag;
  let rest: string = slice_unchecked(marker, 4, marker.len()) + "";
  let colon: i32 = util.index_of_sub(rest, ":");
  if (colon < 0) {
    return ([], false);
  }
  return (split_pattern_names(slice_unchecked(rest, colon + 1, rest.len()) + ""), true);
}

function struct_destr_name(type_name: string): string {
  let marker: string = parser.destr_marker_split(type_name).tag;
  let rest: string = slice_unchecked(marker, 4, marker.len()) + "";
  let colon: i32 = util.index_of_sub(rest, ":");
  if (colon < 0) {
    return "";
  }
  return slice_unchecked(rest, 0, colon) + "";
}

function opaque_access_diags(sig: StructSig, s: Scope, what: string, line: i32, col: i32): util.Diag[] {
  if (!sig.opaque || sig.module == s.fn_module) {
    return [];
  }
  return [dg_at("E021", "cannot " + what + " opaque type " + util.demangle(sig.name) + " outside the module that defines it", line, col)];
}

function struct_destr_diags(v: ast.StmtVar, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (!parser.is_struct_destr_marker(v.type_name)) {
    return out;
  }
  let (fields, _) = struct_destr_fields(v.type_name);
  let it: typeinfo.Type = check_expr(v.init, s);
  match (it) {
    typeinfo.TypeStruct(st) => {
      let named: string = struct_destr_name(v.type_name);
      if (named.len() > 0 && named != st.name) {
        return out.append(dg_at("E024", "struct destructure pattern names " + named + ", but the expression is " + st.name, v.line, v.col));
      }
      let sig: StructSig = s.lookup_struct(st.name);
      let access: string = "destructure a field of";
      if (parser.destr_marker_split(v.type_name).struct_match) {
        access = "destructure";
      }
      out = util.append_diags(out, opaque_access_diags(sig, s, access, v.line, v.col));
      for f in fields {
        if (sig.name.len() > 0 && !util.has_str(sig.field_names, f)) {
          let d: util.Diag = dg_at("E043", "struct " + util.demangle(st.name) + " has no field \"" + f + "\"", v.line, v.col);
          out = out.append(with_fix(d, f, v.line, v.col, util.suggest(f, sig.field_names), ""));
        }
      }
    },
    typeinfo.TypeUnknown(_) => {},
    _ => {
      out = out.append(dg_at("E024", "struct destructure needs a struct expression, got " + type_label(it), v.line, v.col));
    }
  }
  return out;
}

function bind_tuple_destr_names(out: Scope, names: string[], whole: typeinfo.Type): Scope {
  let elems: typeinfo.Type[] = [];
  match (whole) {
    typeinfo.TypeTuple(tt) => {
      elems = tt.elements;
    },
    _ => {}
  }
  let i: i32 = 0;
  while (i < names.len()) {
    let nm: string = names[i];
    let et: typeinfo.Type = t_unknown("binding");
    if (i < elems.len()) {
      et = elems[i];
    }
    if (util.is_tuple_type_name(nm)) {
      out = bind_tuple_destr_names(out, split_pattern_names(slice_unchecked(nm, 1, nm.len() - 1) + ""), et);
    } else if (nm.len() > 0) {
      out = out.bind(nm, et);
    }
    i = i + 1;
  }
  return out;
}

pub function split_pattern_names(encoded: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i <= encoded.len()) {
    if (i == encoded.len() || encoded[i] == b',' && depth == 0) {
      if (i > start) {
        out = out.append(slice_unchecked(encoded, start, i) + "");
      }
      start = i + 1;
    } else if (encoded[i] == b'(') {
      depth = depth + 1;
    } else if (encoded[i] == b')') {
      depth = depth - 1;
    }
    i = i + 1;
  }
  return out;
}

function bind_names(s: Scope, name: string): Scope {
  let out: Scope = s;
  for nm in split_pattern_names(name) {
    if (util.is_tuple_type_name(nm)) {
      out = bind_names(out, slice_unchecked(nm, 1, nm.len() - 1) + "");
    } else if (nm.len() > 0) {
      out = out.bind(nm, t_unknown("binding"));
    }
  }
  return out;
}

function is_builtin_variant(name: string): boolean {
  return parser.builtin_enum_of(name).len() > 0;
}

function variant_in_unions(name: string, unions: UnionTable): boolean {
  let e: i32 = unions.variant_chain_head(name);
  while (e >= 0) {
    if (unions.vnames[e] == name) {
      return true;
    }
    e = unions.variant_chain_next(e);
  }
  return false;
}

function is_nopayload_builtin_variant(name: string): boolean {
  if (name == "None") {
    return true;
  }
  if (name == "JNull") {
    return true;
  }
  if (name == "Interrupted" || name == "Unsupported") {
    return true;
  }
  return false;
}

function union_sig_of_variant(name: string, unions: UnionTable): UnionSig {
  let e: i32 = unions.variant_chain_head(name);
  while (e >= 0) {
    if (unions.vnames[e] == name) {
      return unions.unions[unions.vowner[e]];
    }
    e = unions.variant_chain_next(e);
  }
  let empty_v: string[] = [];
  return UnionSig { name: "", variants: empty_v, is_try: false, is_enum: false, module: "", type_params: [], instance: "", visible_from: [] };
}

function union_of_variant(name: string, unions: UnionTable): string {
  return union_sig_of_variant(name, unions).name;
}

// Prefer visible variants when hidden enums share a constructor name.
// Retain a hidden candidate so the diagnostic can identify its enum.
function scope_variant_sig(name: string, s: Scope): UnionSig {
  let first: UnionSig = union_sig_of_variant(name, s.unions);
  let e: i32 = s.unions.variant_chain_head(name);
  while (e >= 0) {
    if (s.unions.vnames[e] == name) {
      let u: UnionSig = s.unions.unions[s.unions.vowner[e]];
      if (!u.is_enum || parser.is_reserved_enum_name(u.name) || enum_visible_from(u, s.fn_module)) {
        return u;
      }
    }
    e = s.unions.variant_chain_next(e);
  }
  if (parser.builtin_enum_of(name).len() > 0) {
    return s.lookup_union(parser.builtin_enum_of(name));
  }
  return first;
}

function scope_variant_owner(name: string, s: Scope): string {
  return scope_variant_sig(name, s).name;
}

function variant_value_payloads(s: Scope, en: string, name: string): i32 {
  let owner: UnionSig = scope_variant_sig(name, s);
  if (en.len() > 0) {
    owner = s.lookup_union(en);
  }
  if (owner.is_enum) {
    let vs: StructSig = s.lookup_owned_struct(name, owner.name);
    if (vs.enum_owner == owner.name) {
      return vs.field_names.len();
    }
    return 0;
  }
  if (owner.name.len() > 0) {
    if (s.lookup_struct(name).field_names.len() > 0) {
      return 1;
    }
    return 0;
  }
  return builtin_variant_payloads(s, en, name);
}

function builtin_variant_payloads(s: Scope, en: string, name: string): i32 {
  let builtin: string = parser.builtin_enum_of(name);
  if (builtin.len() == 0 || en.len() > 0 && en != builtin) {
    return 0;
  }
  if (builtin == "Option" || builtin == "Result") {
    if (name == "None") {
      return 0;
    }
    return 1;
  }
  let injected: StructSig = s.lookup_owned_struct(name, builtin);
  if (injected.enum_owner == builtin) {
    return injected.field_names.len();
  }
  return 0;
}

function payload_variant_value_diag(shown: string, payloads: i32, line: i32, col: i32): util.Diag {
  return dg_at("E036", "variant " + shown + " expects " + util.i32_to_string(payloads) + " payload argument(s); call it as " + shown + "(...)", line, col);
}

function no_variant_diag(s: Scope, en: string, field: string, line: i32, col: i32): util.Diag {
  return dg_at("E036", "enum " + shown_enum(s, en) + " has no variant \"" + unprefixed_variant(field, s.lookup_union(en).module) + "\"", line, col);
}

function shown_variant(s: Scope, name: string): string {
  let bare: string = variant_pattern_name(name);
  let owner: UnionSig = union_sig_of_variant(bare, s.unions);
  if (variant_pattern_owner(name).len() > 0) {
    owner = s.lookup_union(variant_pattern_owner(name));
  }
  return unprefixed_variant(bare, owner.module);
}

function shown_variant_in(structs: StructTable, name: string): string {
  return unprefixed_variant(variant_pattern_name(name), find_variant_sig(structs, name).module);
}

function shown_enum(s: Scope, name: string): string {
  let m: string = s.lookup_union(name).module;
  let bare: string = unprefixed_variant(name, m);
  if (bare == name || m == s.fn_module) {
    return bare;
  }
  return m + "." + bare;
}

function unknown_variant_diag(s: Scope, name: string, u: UnionSig, line: i32, col: i32): util.Diag {
  let shown: string = unprefixed_variant(name, u.module);
  let hint: string = " — a bare name in arm position is a VARIANT, not a binding; for a catch-all use `_`, binding the scrutinee to a variable first if you need its value";
  let best: string = "";
  let best_d: i32 = 0;
  for v in u.variants {
    let d: i32 = util.levenshtein(shown, unprefixed_variant(v, u.module));
    if (d <= shown.len() / 3 + 1 && (best.len() == 0 || d < best_d)) {
      best = unprefixed_variant(v, u.module);
      best_d = d;
    }
  }
  if (best.len() > 0) {
    hint = " (did you mean \"" + best + "\"?)";
  }
  return dg_at("E014", "variant \"" + shown + "\" is not part of enum " + shown_enum(s, u.name) + hint, line, col);
}

function is_resolvable_value(name: string, s: Scope): boolean {
  if (s.defines(name)) {
    return true;
  }
  if (s.has_sig(name)) {
    return true;
  }
  if (variant_in_unions(name, s.unions) || s.variant_ambiguous(name)) {
    return true;
  }
  if (is_builtin_variant(name)) {
    return true;
  }
  let floor: i32 = raw_floor_at(s.sigs, name);
  if (floor >= 0 || util.str_has_prefix(name, "__raw_") || util.str_has_prefix(name, "__syscall")) {
    return floor >= 0 && raw_floor_allowed(s.sigs, name);
  }
  if (name.len() >= 2 && slice_unchecked(name, 0, 2) == "__") {
    return true;
  }
  if (parser.is_builtin_function(name)) {
    return true;
  }
  return false;
}

function is_resolvable_callee(name: string, s: Scope): boolean {
  if (s.defines(name)) {
    return true;
  }
  if (s.has_sig(name)) {
    return true;
  }
  if (variant_in_unions(name, s.unions) || s.variant_ambiguous(name)) {
    return true;
  }
  if (is_builtin_variant(name)) {
    return true;
  }
  let floor: i32 = raw_floor_at(s.sigs, name);
  if (floor >= 0 || util.str_has_prefix(name, "__raw_") || util.str_has_prefix(name, "__syscall")) {
    return floor >= 0 && raw_floor_allowed(s.sigs, name);
  }
  if (name.len() >= 2 && slice_unchecked(name, 0, 2) == "__") {
    return true;
  }
  if (parser.is_builtin_function(name)) {
    return true;
  }
  return false;
}

function for_iter_is_range(iter: ast.Expr): boolean {
  match (iter) {
    ast.ExprCall(c) => {
      if (c.args.len() != 2) {
        return false;
      }
      match (c.callee) {
        ast.ExprIdent(id) => {
          return id.name == "__range" || id.name == "__range_incl";
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

function (s: Scope) enter_loop(): Scope {
  return Scope { ...s, loop_depth: s.loop_depth + 1 };
}

function (s: Scope) with_ret_type(rt: typeinfo.Type): Scope {
  return Scope { ...s, ret_type: rt, try_ret: rt };
}

function (s: Scope) with_block_ret(rt: typeinfo.Type): Scope {
  return Scope { ...s, ret_type: rt };
}

function (s: Scope) binding_index(name: string): i32 {
  let i: i32 = s.names.len() - 1;
  while (i >= 0) {
    if (s.names[i] == name) {
      return i;
    }
    i = i - 1;
  }
  return 0 - 1;
}

function (s: Scope) lookup(name: string): typeinfo.Type {
  let i: i32 = s.binding_index(name);
  if (i >= 0) {
    return s.types[i];
  }
  return t_unknown("undefined identifier:" + name);
}

function (s: Scope) known(name: string): boolean {
  let i: i32 = s.binding_index(name);
  return i >= 0 && !is_unknown(s.types[i]);
}

function (s: Scope) is_bound(name: string): boolean {
  return s.binding_index(name) >= 0;
}

function (s: Scope) lookup_assoc_sig(tyname: string, field: string): FuncSig {
  for sig in s.sigs.sigs {
    if (sig.name == field && sig.receiver.len() > 0 && util.base_type_name(sig.receiver) == tyname) {
      return sig;
    }
  }
  return s.lookup_sig("");
}

function (s: Scope) sig_at(name: string): i32 {
  let first: i32 = 0 - 1;
  let i: i32 = s.sigs.head[sig_name_bucket(name)];
  while (i >= 0) {
    if (s.sigs.sigs[i].name == name) {
      if (s.sigs.sigs[i].receiver.len() == 0) {
        return i;
      }
      if (first < 0) {
        first = i;
      }
    }
    i = s.sigs.next[i];
  }
  return first;
}

function (s: Scope) lookup_sig(name: string): FuncSig {
  let i: i32 = s.sig_at(name);
  if (i >= 0) {
    return s.sigs.sigs[i];
  }
  let empty: typeinfo.Type[] = [];
  let non: string[] = [];
  return FuncSig { receiver: "", name: "", param_types: empty, param_own: [], ret_type: t_unknown("undefined function"), all_type_params: [], type_params: [], type_bounds: [], ret_type_name: "", param_type_names: non, param_names: [], is_const: false, typevars: [], module: "", refs: [] };
}

function tp_bound_for(ptype: string, type_params: string[], bound_traits: string[]): string {
  let k: i32 = 0;
  while (k < type_params.len()) {
    if (type_params[k] == ptype) {
      if (k < bound_traits.len()) {
        return bound_traits[k];
      }
      return "";
    }
    k = k + 1;
  }
  return "";
}

function e021_trait_idx(tr: string, trait_reqs: parser.TraitReq[]): i32 {
  let i: i32 = 0;
  while (i < trait_reqs.len()) {
    if (trait_reqs[i].trait_name == tr) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function e021_scope_has_impl(impls: parser.ImplInfo[], trait_name: string, impl_type: string): boolean {
  let base: string = util.base_type_name(impl_type);
  for imp in impls {
    if (imp.trait_name == trait_name && util.base_type_name(imp.impl_type) == base) {
      return true;
    }
  }
  return false;
}

function conforms_by_impl_or_derive(s: Scope, tyname: string, tr: string): boolean {
  return e021_scope_has_impl(s.impls, tr, tyname) || derives_trait(s, tyname, tr);
}

function derives_trait(s: Scope, tyname: string, tr: string): boolean {
  for sd in s.structs.structs {
    if (sd.name == tyname || sd.enum_owner == tyname) {
      for derive in sd.derives {
        if (parser.derive_simple_name(derive) == tr) {
          return true;
        }
      }
    }
  }
  return false;
}

function conforms_to_dyn_trait(s: Scope, tyname: string, tr: string): boolean {
  let key: string = util.base_type_name(tr);
  for imp in s.impls {
    if (parser.impl_trait_key(imp) == key && parser.receiver_base(imp.impl_type) == parser.receiver_base(tyname)) {
      return true;
    }
  }
  return derives_trait(s, tyname, parser.derive_simple_name(key));
}

function map_key_type_error(s: Scope, kt: typeinfo.Type): string {
  if (is_unknown(kt) || is_type_variable(kt) || is_integer(kt) || type_eq(kt, t_char()) || type_eq(kt, t_string()) || type_eq(kt, t_str())) {
    return "";
  }
  if (is_tuple_or_array(kt)) {
    if (structural_map_key(kt)) {
      return "";
    }
    return "map key type " + type_label(kt) + " is not supported — a tuple or array used as a key may hold only integers, booleans, chars, strings, and such tuples and arrays";
  }
  if let typeinfo.TypeBool(_) = kt {
    return "";
  }
  let kn: string = "";
  let kw: string = "";
  match (kt) {
    typeinfo.TypeStruct(st) => {
      kn = st.name;
      kw = "a struct";
    },
    typeinfo.TypeUnion(u) => {
      if (u.name != "Option" && u.name != "Result") {
        kn = u.name;
        kw = "an enum";
      }
    },
    _ => {}
  }
  if (kn != "") {
    if (conforms_by_impl_or_derive(s, kn, "Eq") && conforms_by_impl_or_derive(s, kn, "Hash")) {
      return "";
    }
    return "map key type " + type_label(kt) + " is not supported — " + kw + " used as a key must derive Eq and Hash: add `@derive(cmp.Eq, cmp.Hash)`, which requires `import \"core/cmp\";`";
  }
  return "map key type " + type_label(kt) + " is not yet supported — use i32, string, or a struct/enum with `@derive(cmp.Eq, cmp.Hash)`, which requires `import \"core/cmp\";`";
}

function is_tuple_or_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  return false;
}

function structural_map_key(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      if (!structural_key_element(e)) {
        return false;
      }
    }
    return tup.elements.len() > 0;
  }
  if let typeinfo.TypeArray(a) = t {
    return structural_key_element(a.elem);
  }
  return false;
}

function structural_key_element(t: typeinfo.Type): boolean {
  if (type_eq(t, t_string()) || structural_map_key(t)) {
    return true;
  }
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  if let typeinfo.TypeI32(_) = t {
    return true;
  }
  return false;
}

function mlit_entries_settle(e: ast.Expr, want: typeinfo.TypeMap, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprFieldAccess(fa) = c.callee {
      if (fa.field != "insert" || c.args.len() != 2) {
        return false;
      }
      if (!settles_or_assignable(c.args[0], want.key, s) || !settles_or_assignable(c.args[1], want.value, s)) {
        return false;
      }
      return mlit_is_base(fa.obj) || mlit_entries_settle(fa.obj, want, s);
    }
  }
  return false;
}

function mlit_is_desugared(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (c.line != 0 || c.col != 0) {
        return false;
      }
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "insert") {
            return false;
          }
          if (mlit_is_base(fa.obj)) {
            return true;
          }
          return mlit_is_desugared(fa.obj);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

function literal_insert(c: ast.ExprCall): boolean {
  return c.line == 0 && c.col == 0 && mlit_is_desugared(c);
}

function e045_map_key_msgs(t: typeinfo.Type, s: Scope): string[] {
  let out: string[] = [];
  match (t) {
    typeinfo.TypeMap(mt) => {
      out = util.append_all(out, map_shape_msgs(s, mt));
      out = util.append_all(out, e045_map_key_msgs(mt.key, s));
      out = util.append_all(out, e045_map_key_msgs(mt.value, s));
    },
    typeinfo.TypeArray(a) => {
      out = util.append_all(out, e045_map_key_msgs(a.elem, s));
    },
    typeinfo.TypeTuple(tup) => {
      for elem in tup.elements {
        out = util.append_all(out, e045_map_key_msgs(elem, s));
      }
    },
    typeinfo.TypeStruct(st) => {
      for arg in st.args {
        out = util.append_all(out, e045_map_key_msgs(arg, s));
      }
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        out = util.append_all(out, e045_map_key_msgs(arg, s));
      }
    },
    typeinfo.TypeFunc(f) => {
      for pt in f.param_types {
        out = util.append_all(out, e045_map_key_msgs(pt, s));
      }
      out = util.append_all(out, e045_map_key_msgs(f.ret_type, s));
    },
    _ => {}
  }
  return out;
}

function map_shape_msgs(s: Scope, mt: typeinfo.TypeMap): string[] {
  let out: string[] = [];
  let msg: string = map_key_type_error(s, mt.key);
  if (msg != "") {
    out = out.append(msg);
  }
  if (is_void(mt.value)) {
    out = out.append("map value type void is not supported — a set of keys is std/set's `Set`");
  }
  return out;
}

function e045_annot_diags(type_name: string, line: i32, col: i32, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (type_name.len() == 0) {
    return out;
  }
  for msg in e045_map_key_msgs(s.resolve_type(type_name), s) {
    out = out.append(dg_at("E045", msg, line, col));
  }
  return out;
}

function call_bound_diags(tparams: string[], bounds: string[], module: string, site: string, bn: string[], bt: typeinfo.Type[], s: Scope, ln: i32, cl: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let i: i32 = 0;
  while (i < tparams.len() && i < bounds.len()) {
    let bi: i32 = util.index_of_str(bn, tparams[i]);
    if (bi >= 0 && !is_unknown(bt[bi]) && !is_type_variable(bt[bi])) {
      out = util.append_diags(out, tp_bound_diags(tparams[i], bounds[i], module, site, bt[bi], s, ln, cl));
    }
    i = i + 1;
  }
  return out;
}

function tp_bound_diags(tp: string, bound: string, module: string, site: string, at: typeinfo.Type, s: Scope, ln: i32, cl: i32): util.Diag[] {
  let out: util.Diag[] = [];
  for entry in parser.split_plus_bounds(bound) {
    let base: string = util.base_type_name(entry);
    if (!bound_import_unloaded(base, s.imports.paths, s.trait_reqs) && !type_implements(s, at, base, module)) {
      out = out.append(dg_at("E021", "type argument " + tp + " = " + util.demangle(type_label(at)) + " does not implement trait " + bound_trait_display(base, module, s.trait_reqs) + " required by " + site, ln, cl));
    }
  }
  return out;
}

function type_implements(s: Scope, t: typeinfo.Type, base: string, module: string): boolean {
  if let typeinfo.TypeDyn(d) = t {
    let want: string = parser.derive_simple_name(base);
    for tr in parser.dyn_trait_set("dyn " + d.traits) {
      if (parser.derive_simple_name(util.base_type_name(tr)) == want) {
        return true;
      }
    }
    return false;
  }
  let tn: string = impl_type_name(t);
  if (tn.len() == 0) {
    return false;
  }
  for imp in s.impls {
    if (impl_receiver(imp) == tn && bound_names_trait(base, module, imp.trait_name, imp.trait_module)) {
      return true;
    }
  }
  return derives_bound(s, tn, base, module);
}

function impl_receiver(imp: parser.ImplInfo): string {
  return receiver_namespace(util.base_type_name(imp.impl_type));
}

function impl_type_name(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(_) => {},
    typeinfo.TypeBool(_) => {},
    typeinfo.TypeString(_) => {},
    typeinfo.TypeFloat(_) => {},
    typeinfo.TypeLanes(_) => {},
    typeinfo.TypeStruct(_) => {},
    typeinfo.TypeUnion(_) => {},
    typeinfo.TypeMap(_) => {},
    _ => {
      return "";
    }
  }
  return receiver_namespace(util.base_type_name(type_label(t)));
}

function derives_bound(s: Scope, tyname: string, base: string, module: string): boolean {
  for sd in s.structs.structs {
    if (sd.name == tyname || sd.enum_owner == tyname) {
      for derive in sd.derives {
        let name: string = parser.derive_simple_name(derive);
        if (bound_names_trait(base, module, name, spelling_qualifier(derive, name))) {
          return true;
        }
      }
    }
  }
  return false;
}

function spelling_qualifier(spelling: string, name: string): string {
  if (spelling.len() <= name.len()) {
    return "";
  }
  return slice_unchecked(spelling, 0, spelling.len() - name.len() - 1) + "";
}

function bound_trait_display(base: string, module: string, reqs: parser.TraitReq[]): string {
  let name: string = parser.derive_simple_name(base);
  if (util.index_of_sub(base, ".") < 0) {
    if (module.len() == 0) {
      return name;
    }
    return module + "." + name;
  }
  let idx: i32 = bound_trait_req(base, module, reqs);
  if (idx >= 0) {
    return reqs[idx].module + "." + name;
  }
  return base;
}

function bound_trait_req(base: string, module: string, reqs: parser.TraitReq[]): i32 {
  let name: string = parser.derive_simple_name(base);
  let q: string = spelling_qualifier(base, name);
  let want: string = module;
  if (q.len() > 0) {
    want = q;
  }
  let found: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < reqs.len()) {
    if (reqs[i].trait_name == name && reqs[i].module == want) {
      return i;
    }
    if (found < 0 && reqs[i].trait_name == name && q.len() > 0 && reqs[i].module.len() > 0) {
      found = i;
    }
    i = i + 1;
  }
  return found;
}

function bound_import_unloaded(base: string, imports: string[], reqs: parser.TraitReq[]): boolean {
  let q: string = spelling_qualifier(base, parser.derive_simple_name(base));
  if (q.len() == 0) {
    return false;
  }
  for r in reqs {
    if (r.module == q) {
      return false;
    }
  }
  for path in imports {
    if (path == q || util.str_has_suffix(path, "/" + q)) {
      return true;
    }
  }
  return false;
}

function bound_decl_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let imports: string[] = import_paths_of(mod);
  for fd in mod.funcs {
    let i: i32 = 0;
    while (i < fd.type_params.len() && i < fd.bound_traits.len()) {
      for entry in parser.split_plus_bounds(fd.bound_traits[i]) {
        out = util.append_diags(out, bound_entry_decl_diags(entry, fd, fd.type_params[i], imports, mod.trait_reqs));
      }
      i = i + 1;
    }
  }
  return out;
}

function bound_entry_decl_diags(entry: string, fd: parser.FuncDecl, tp: string, imports: string[], reqs: parser.TraitReq[]): util.Diag[] {
  let none: util.Diag[] = [];
  let bref: parser.TypeRef = parser.parse_type_ref(entry);
  if (bound_import_unloaded(bref.base, imports, reqs)) {
    return none;
  }
  let display: string = bound_trait_display(bref.base, fd.module, reqs);
  let idx: i32 = bound_trait_req(bref.base, fd.module, reqs);
  if (idx < 0) {
    return [dg_at("E021", "unknown trait \"" + util.demangle(display) + "\" in bound on type parameter " + tp, fd.line, fd.col)];
  }
  let want: i32 = reqs[idx].type_params.len();
  if (bref.args.len() != want) {
    return [dg_at("E021", "trait " + util.demangle(display) + " takes " + util.i32_to_string(want) + " type argument(s), " + util.i32_to_string(bref.args.len()) + " supplied in bound on type parameter " + tp, fd.line, fd.col)];
  }
  return none;
}

function array_receiver_matches(rt: string, view: boolean): boolean {
  if (view) {
    return parser.spelling_is_view(rt);
  }
  return rt.len() > 2 && slice_unchecked(rt, 0, 1) != "[" && slice_unchecked(rt, rt.len() - 2, rt.len()) == "[]";
}

function (s: Scope) array_recv_method(field: string, view: boolean): MethodSig {
  let i: i32 = s.methods.head[sig_name_bucket(field)];
  while (i >= 0) {
    let method: MethodSig = s.methods.methods[i];
    let rt: string = method.receiver_type;
    if (method.name == field && array_receiver_matches(rt, view) && s.method_visible(method)) {
      return method;
    }
    i = s.methods.next[i];
  }
  let empty_pt: typeinfo.Type[] = [];
  return MethodSig { name: "", receiver_type: "", param_types: empty_pt, ret_type: t_unknown("no such array method"), ret_type_name: "", param_type_names: [], all_type_params: [], type_params: [], type_bounds: [], module: "", impl_trait: "", line: 0, col: 0, file: "" };
}

function (s: Scope) array_method_ret_type(c: ast.ExprCall, recv_ty: typeinfo.Type, field: string): typeinfo.Type {
  match (recv_ty) {
    typeinfo.TypeArray(array) => {
      if (!array.view && (field == "append" || field == "with")) {
        return recv_ty;
      }
      if (field == "len") {
        return t_i32();
      }
      if (array.view) {
        return s.arr_recv_ret_type(c, recv_ty, s.array_recv_method(field, true));
      }
      let arm: MethodSig = s.array_recv_method(field, false);
      if (arm.name.len() > 0) {
        return s.arr_recv_ret_type(c, recv_ty, arm);
      }
      return t_unknown("no array method `" + field + "`");
    },
    _ => {
      return t_unknown("array_method_ret_type: receiver isn't an array");
    }
  }
}

pub function array_method_sig(s: Scope, field: string, view: boolean): MethodSig {
  return s.array_recv_method(field, view);
}

function (s: Scope) arr_recv_ret_type(c: ast.ExprCall, recv_ty: typeinfo.Type, arm: MethodSig): typeinfo.Type {
  if (arm.name.len() == 0) {
    return arm.ret_type;
  }
  return generic_method_ret(c, arm, method_binding(c, arm, recv_ty, s), s);
}

function (s: Scope) has_struct(name: string): boolean {
  let i: i32 = s.structs.index.chain(name);
  while (i >= 0) {
    if (s.structs.structs[i].name == name) {
      return true;
    }
    i = s.structs.index.next[i];
  }
  return false;
}

function (s: Scope) lookup_struct(name: string): StructSig {
  let first: i32 = 0 - 1;
  let i: i32 = s.structs.index.chain(name);
  while (i >= 0) {
    if (s.structs.structs[i].name == name) {
      if (s.structs.structs[i].enum_owner.len() == 0) {
        return s.structs.structs[i];
      }
      if (first < 0) {
        first = i;
      }
    }
    i = s.structs.index.next[i];
  }
  if (first >= 0) {
    return s.structs.structs[first];
  }
  let empty_n: string[] = [];
  let empty_t: typeinfo.Type[] = [];
  let empty_tp: string[] = [];
  let empty_ftn: string[] = [];
  return StructSig { name: "", field_names: empty_n, field_types: empty_t, type_params: empty_tp, field_type_names: empty_ftn, variant_field_names: empty_n, derives: [], enum_owner: "", opaque: false, module: "" };
}

function (s: Scope) lookup_variant(name: string): StructSig {
  let i: i32 = s.structs.index.chain(name);
  while (i >= 0) {
    if (s.structs.structs[i].name == name && s.structs.structs[i].enum_owner.len() > 0 && !s.variant_hidden(s.structs.structs[i])) {
      return s.structs.structs[i];
    }
    i = s.structs.index.next[i];
  }
  return s.lookup_struct(name);
}

function (s: Scope) variant_hidden(v: StructSig): boolean {
  let owner: i32 = s.unions.index.find(v.enum_owner);
  if (owner >= 0) {
    let u: UnionSig = s.unions.unions[owner];
    if (u.is_enum && !parser.is_reserved_enum_name(u.name) && !enum_visible_from(u, s.fn_module)) {
      return true;
    }
  }
  if (!s.unions.from_import) {
    return false;
  }
  let e: i32 = s.unions.head[sig_name_bucket(v.name)];
  while (e >= 0) {
    let u: UnionSig = s.unions.unions[s.unions.vowner[e]];
    if (s.unions.vnames[e] == v.name && u.name == v.enum_owner) {
      return declared_by_entry(u);
    }
    e = s.unions.next[e];
  }
  return false;
}

function (s: Scope) variant_ambiguous(name: string): boolean {
  let bare: string = unprefixed_variant(name, s.fn_module);
  let n: i32 = 0;
  if (parser.builtin_enum_of(bare).len() > 0) {
    n = 1;
  }
  let last: i32 = 0 - 1;
  let e: i32 = s.unions.bhead[sig_name_bucket(bare)];
  while (e >= 0) {
    let o: i32 = s.unions.vowner[e];
    let u: UnionSig = s.unions.unions[o];
    if (s.unions.bnames[e] == bare && u.is_enum && o != last && enum_visible_from(u, s.fn_module)) {
      n = n + 1;
      last = o;
    }
    e = s.unions.bnext[e];
  }
  return n >= 2;
}

function (s: Scope) lookup_owned_struct(name: string, owner: string): StructSig {
  let i: i32 = s.structs.index.chain(name);
  while (i >= 0) {
    if (s.structs.structs[i].name == name && s.structs.structs[i].enum_owner == owner) {
      return s.structs.structs[i];
    }
    i = s.structs.index.next[i];
  }
  return s.lookup_struct(name);
}

function variant_payload_struct(s: Scope, type_name: string): StructSig {
  if (dot_index(type_name) < 0) {
    return s.lookup_variant(type_name);
  }
  return s.lookup_owned_struct(variant_pattern_name(type_name), variant_pattern_owner(type_name));
}

function field_index(ssig: StructSig, name: string): i32 {
  let i: i32 = 0;
  while (i < ssig.field_names.len()) {
    if (ssig.field_names[i] == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function variant_payload_type_at(s: Scope, type_name: string, idx: i32): typeinfo.Type {
  let ss: StructSig = variant_payload_struct(s, type_name);
  if (ss.name.len() == 0) {
    return t_unknown("built-in variant payload `" + type_name + "`");
  }
  let want: string = "__ev";
  if (idx > 0) {
    want = "__ev" + util.i32_to_string(idx);
  }
  let i: i32 = 0;
  while (i < ss.field_names.len()) {
    if (ss.field_names[i] == want) {
      return ss.field_types[i];
    }
    i = i + 1;
  }
  return t_struct(ss.name);
}

function variant_pattern_qualified(type_name: string): boolean {
  let i: i32 = 0;
  while (i < type_name.len()) {
    if (type_name[i] == b'.') {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function variant_pattern_payload_type(s: Scope, name: string, whole: typeinfo.Type, index: i32): typeinfo.Type {
  if let typeinfo.TypeUnion(u) = whole {
    let bare: string = variant_pattern_name(name);
    if ((u.name == "Option" || u.name == "Result") && parser.builtin_enum_of(bare) == u.name) {
      let arg: i32 = 0;
      if (bare == "Err") {
        arg = 1;
      }
      if (index == 0 && bare != "None" && arg < u.args.len()) {
        return u.args[arg];
      }
      if (index == 0 && bare == "Some" && u.args.len() == 0) {
        return t_unknown("unbound T");
      }
      return t_unknown("unresolved generic pattern payload");
    }
  }
  let g: typeinfo.Type = generic_variant_payload_type(s, name, whole, index);
  if (!is_unknown(g) || lit_id(g) >= 0 || unbound_enum_argument(g)) {
    return g;
  }
  return variant_payload_type_at(s, name, index);
}

function generic_variant_payload_type(s: Scope, name: string, whole: typeinfo.Type, index: i32): typeinfo.Type {
  let u: typeinfo.TypeUnion = typeinfo.TypeUnion { name: "", args: [] };
  if let typeinfo.TypeUnion(wu) = whole {
    u = wu;
  } else {
    return t_unknown("not a union");
  }
  let us: UnionSig = s.lookup_union(u.name);
  let args: typeinfo.Type[] = u.args;
  if (args.len() == 0) {
    for tp in us.type_params {
      args = args.append(t_unknown("unbound " + tp));
    }
  }
  if (us.type_params.len() == 0 || us.type_params.len() != args.len()) {
    return t_unknown("not a generic enum instance");
  }
  let ss: StructSig = s.lookup_owned_struct(variant_pattern_name(name), u.name);
  let want: string = "__ev";
  if (index > 0) {
    want = "__ev" + util.i32_to_string(index);
  }
  let i: i32 = 0;
  while (i < ss.field_names.len() && i < ss.field_type_names.len()) {
    if (ss.field_names[i] == want) {
      return type_from_ref_subst(parser.parse_type_ref(ss.field_type_names[i]), us.type_params, args, s.type_names());
    }
    i = i + 1;
  }
  return t_unknown("no payload " + want);
}

function variant_ctor_type(s: Scope, union_name: string, name: string, c: ast.ExprCall): typeinfo.Type {
  let us: UnionSig = s.lookup_union(union_name);
  if (us.name.len() == 0 && (union_name == "Result" || union_name == "Option")) {
    return builtin_ctor_type(union_name, name, c, s);
  }
  if (us.type_params.len() == 0) {
    return t_union(union_name);
  }
  let args: typeinfo.Type[] = [];
  for tp in us.type_params {
    args = args.append(t_unknown("unbound " + tp));
  }
  let k: i32 = 0;
  while (k < c.args.len()) {
    let ti: i32 = payload_type_param(s, us, name, k);
    if (ti >= 0) {
      let payload: typeinfo.Type = inferred_payload(c.args[k], s);
      if (!unbound_enum_argument(args[ti])) {
        payload = join_result_types(args[ti], payload);
      }
      args = args.with(ti, payload);
    }
    k = k + 1;
  }
  return typeinfo.TypeUnion { name: union_name, args: args };
}

function bind_variant_payloads(arm: Scope, look: Scope, pvin0: ast.PatVariant, whole: typeinfo.Type): Scope {
  let scrut_enum: string = "";
  if let typeinfo.TypeUnion(u) = whole {
    scrut_enum = u.name;
  }
  let pvin: ast.PatVariant = pvin0;
  if (scrut_enum.len() > 0 && !variant_pattern_qualified(pvin0.type_name)) {
    pvin = ast.PatVariant { ...pvin0, type_name: scrut_enum + "." + pvin0.type_name };
  }
  let pv: ast.PatVariant = pvin;
  if (parser.is_record_pattern(pv)) {
    let rss: StructSig = variant_payload_struct(look, pv.type_name);
    if (rss.variant_field_names.len() > 0) {
      pv = parser.rebind_record_positional(pv, rss.variant_field_names);
    }
  }
  let sc: Scope = arm;
  if (pv.at_binding.len() > 0 && pv.at_binding != "_") {
    sc = sc.bind(pv.at_binding, whole);
  }
  if (pv.binding.len() > 0 && pv.binding != "_") {
    sc = sc.bind(pv.binding, variant_pattern_payload_type(look, pv.type_name, whole, 0));
  }
  let k: i32 = 0;
  while (k < pv.extra_bindings.len()) {
    let nm: string = pv.extra_bindings[k];
    if (nm.len() > 0 && nm != "_") {
      sc = sc.bind(nm, variant_pattern_payload_type(look, pv.type_name, whole, k + 1));
    }
    k = k + 1;
  }
  return sc;
}

function (s: Scope) receives(ms: MethodSig, recv_type: string): boolean {
  return ms.receiver_type == recv_type || parser.parse_type_ref(ms.receiver_type).base == recv_type || is_variant_of(recv_type, ms.receiver_type, s.unions.unions);
}

function (s: Scope) lookup_method(name: string, recv_type: string): MethodSig {
  if (name == "iter" && recv_type == "Map") {
    let provider: MethodSig = s.lookup_method("__iterator", recv_type);
    if (provider.name.len() > 0) {
      return provider;
    }
  }
  let i: i32 = s.methods.head[sig_name_bucket(name)];
  while (i >= 0) {
    if (s.methods.methods[i].name != name) {
      i = s.methods.next[i];
      continue;
    }
    if (s.receives(s.methods.methods[i], recv_type)) {
      return s.methods.methods[i];
    }
    i = s.methods.next[i];
  }
  let at: i32 = s.trait_spelled_method(name, recv_type);
  if (at >= 0) {
    return s.methods.methods[at];
  }
  return no_method_sig();
}

function no_method_sig(): MethodSig {
  let empty_pt: typeinfo.Type[] = [];
  return MethodSig { name: "", receiver_type: "", param_types: empty_pt, ret_type: t_unknown("no such method"), ret_type_name: "", param_type_names: [], all_type_params: [], type_params: [], type_bounds: [], module: "", impl_trait: "", line: 0, col: 0, file: "" };
}

function (s: Scope) trait_spelled_method(name: string, recv_type: string): i32 {
  let dot: i32 = name.len() - 1;
  while (dot >= 0 && name[dot] != b'.') {
    dot = dot - 1;
  }
  if (dot <= 0) {
    return -1;
  }
  let tname: string = method_simple_name(slice_unchecked(name, 0, dot) + "");
  let simple: string = slice_unchecked(name, dot + 1, name.len()) + "";
  let i: i32 = s.methods.shead[sig_name_bucket(simple)];
  while (i >= 0) {
    let m: MethodSig = s.methods.methods[i];
    if (method_simple_name(m.impl_trait) == tname && method_simple_name(m.name) == simple && (m.receiver_type == recv_type || parser.parse_type_ref(m.receiver_type).base == recv_type)) {
      return i;
    }
    i = s.methods.snext[i];
  }
  return -1;
}

function (s: Scope) has_method(name: string, recv_type: string): boolean {
  let i: i32 = s.methods.head[sig_name_bucket(name)];
  while (i >= 0) {
    if (s.methods.methods[i].name != name) {
      i = s.methods.next[i];
      continue;
    }
    if (s.methods.methods[i].receiver_type == recv_type) {
      return true;
    }
    if (parser.parse_type_ref(s.methods.methods[i].receiver_type).base == recv_type) {
      return true;
    }
    if (is_variant_of(recv_type, s.methods.methods[i].receiver_type, s.unions.unions)) {
      return true;
    }
    i = s.methods.next[i];
  }
  return s.trait_spelled_method(name, recv_type) >= 0;
}

function (s: Scope) has_sig(name: string): boolean {
  return s.sig_at(name) >= 0;
}

function retired_collection_spelling(ns: string, method: string): string {
  if (ns == "Array" && method == "push") {
    return "append";
  }
  if (ns == "Array" && method == "set") {
    return "with";
  }
  if (ns == "Map" && method == "set") {
    return "insert";
  }
  if (ns == "Map" && method == "has") {
    return "contains";
  }
  if (ns == "Map" && (method == "delete" || method == "without")) {
    return "remove";
  }
  if (ns == "Map" && method == "clear") {
    return "cleared";
  }
  return "";
}

function scalar_integer_module(lb: string): string {
  if (lb == "u64" || lb == "usize") {
    return "std/u64";
  }
  if (lb == "u8") {
    return "std/i32";
  }
  if (lb == "u32" || lb == "u16") {
    return "std/u32";
  }
  if (lb == "i64") {
    return "std/i64";
  }
  if (lb == "char") {
    return "";
  }
  return "std/i32";
}

// scalar_module_for: the stdlib module carrying a scalar type's method surface,
// "" for a type whose methods are not in one. u8 uses std/i32, not std/u32 —
// every `pub function (b: u8) …` in the stdlib is declared there, so naming
// std/u32 made the hint unfollowable.
function scalar_module_for(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(it) => {
      return scalar_integer_module(int_label(it));
    },
    typeinfo.TypeFloat(_) => {
      return "std/f64";
    },
    typeinfo.TypeString(_) => {
      return "std/string";
    },
    _ => {
      return "";
    }
  }
  return "";
}

function scalar_method_available(recv: string, method: string): boolean {
  if (recv == "i32" && (method == "to_string_radix" || method == "to_string_padded" || method == "to_string_with_sep")
    || recv == "i64" && method == "to_string_radix"
    || (recv == "f32" || recv == "f64") && method == "to_string_prec") {
    return true;
  }
  return false;
}

// scalar_method_module: scalar_module_for narrowed to the names that module
// actually defines for every scalar. to_string is the f-string desugar target
// and the case that motivates this; keeping the set tight is what stops the
// hint naming a module that would not help.
function scalar_method_module(t: typeinfo.Type, method: string): string {
  let mod: string = scalar_module_for(t);
  if (mod.len() == 0) {
    return "";
  }
  if (scalar_method_available(display_dispatch_name(t), method)) {
    return mod;
  }
  return "";
}

// module_imported: `path` is in the program's import list. For a single module
// that is its own imports; for a bundle it is the closure flatten.bundle keeps.
function (s: Scope) module_imported(path: string): boolean {
  return util.index_of_str(s.imports.paths, path) >= 0;
}

function (s: Scope) imports_directly(path: string): boolean {
  for sg in s.imports.sights {
    if (sg.module == s.fn_module) {
      return util.has_str(sg.imports, path);
    }
  }
  return s.module_imported(path);
}

function (s: Scope) method_visible(m: MethodSig): boolean {
  return m.impl_trait.len() > 0 || s.imports.sees(s.fn_module, m.module);
}

function (s: Scope) visible_method(name: string, recv_type: string): MethodSig {
  let m: MethodSig = s.lookup_method(name, recv_type);
  if (m.name.len() > 0 && !s.method_visible(m)) {
    return no_method_sig();
  }
  return m;
}

function (s: Scope) methods_in_namespace(ns: string): string[] {
  let out: string[] = preregistered_methods(ns);
  for method in s.methods.methods {
    if (method.receiver_type == ns || ns == "Map" && map_receiver_type(method.receiver_type)) {
      out = push_str_unique_sorted(out, method.name);
    }
  }
  return out;
}

function preregistered_methods(ns: string): string[] {
  if (ns == "Array") {
    return ["append", "len", "with"];
  }
  if (ns == "slice") {
    return ["len"];
  }
  if (ns == "string") {
    return ["as_bytes", "len"];
  }
  if (ns == "Map") {
    return ["cleared", "contains", "get", "get_or", "insert", "keys", "len", "remove", "values"];
  }
  if (ns == "Cell") {
    return ["get", "set"];
  }
  return [];
}

function map_receiver_type(rt: string): boolean {
  if (rt == "Map") {
    return true;
  }
  return rt.len() > 4 && slice_unchecked(rt, 0, 4) == "Map[";
}

function (s: Scope) namespace_is_exact(ns: string): boolean {
  if (ns != "Array") {
    return true;
  }
  for method in s.methods.methods {
    let rt: string = method.receiver_type;
    if (rt.len() > 2 && slice_unchecked(rt, rt.len() - 2, rt.len()) == "[]" && s.method_visible(method)) {
      return false;
    }
  }
  return true;
}

function push_str_unique_sorted(xs: string[], v: string): string[] {
  let out: string[] = [];
  let placed: boolean = false;
  for x in xs {
    if (x == v) {
      return xs;
    }
    if (!placed && v < x) {
      out = out.append(v);
      placed = true;
    }
    out = out.append(x);
  }
  if (!placed) {
    out = out.append(v);
  }
  return out;
}

function (s: Scope) stdlib_receiver_matches(ns: string, method: string, recv: typeinfo.Type): boolean {
  let written: string = stdlib_methods.receiver_of(ns, method);
  if (written.len() == 0) {
    return true;
  }
  let ref: parser.TypeRef = parser.parse_type_ref(written);
  let params: string[] = stdlib_methods.receiver_params(ns, method);
  let (names, types) = gc_bind_param(ref, recv, params, s.type_names(), [], []);
  if (names.len() != params.len()) {
    return false;
  }
  let expected: typeinfo.Type = type_from_ref_subst(ref, names, types, s.type_names());
  return type_label(expected) == type_label(recv);
}

function (s: Scope) unknown_method_message(ns: string, method: string, label: string, recv: typeinfo.Type): string {
  let base: string = "no method \"" + method + "\" on " + label;
  let repl: string = retired_collection_spelling(ns, method);
  let view: boolean = false;
  if let typeinfo.TypeArray(a) = recv {
    view = a.view;
  }
  if (view) {
    repl = "";
  }
  if (ns == "Map" && (method == "has" || method == "without")) {
    return base + " — it was renamed; use \"" + repl + "\"";
  }
  if (repl.len() > 0) {
    return base + " — the in-place spelling was removed; use \"" + repl
      + "\", which returns the updated " + ns + " (assign the result back)";
  }
  let declared_receiver: string = stdlib_methods.receiver_of(ns, method);
  if (declared_receiver.len() > 0 && !s.stdlib_receiver_matches(ns, method, recv)) {
    return base + " — \"" + method + "\" is declared for " + declared_receiver + " in \"" + stdlib_methods.module_of(ns, method) + "\"";
  }
  let import_advice: string = s.stdlib_import_advice(ns, method);
  if (import_advice.len() > 0) {
    return base + import_advice;
  }
  let names: string[] = s.method_fix_candidates(ns, recv);
  let did: string = util.suggest(method, names);
  if (did.len() > 0) {
    return base + " — did you mean \"" + did + "\"?";
  }
  let near_advice: string = s.stdlib_near_advice(ns, method, recv);
  if (near_advice.len() > 0) {
    return base + near_advice;
  }
  if (stdlib_methods.methods_on(ns).len() > 0) {
    base = base + ", and no stdlib module declares one";
  }
  return base + method_list(names);
}

function method_list(names: string[]): string {
  if (names.len() == 0) {
    return "";
  }
  let listed: string = "";
  for n in names {
    if (listed.len() > 0) {
      listed = listed + ", ";
    }
    listed = listed + n;
  }
  return " (it has: " + listed + ")";
}

function (s: Scope) stdlib_import_advice(ns: string, method: string): string {
  let mod: string = stdlib_methods.module_of(ns, method);
  if (mod.len() == 0 || s.imports_directly(mod)) {
    return "";
  }
  let note: string = "";
  if (method == "to_string") {
    note = " (an f-string like `f\"{x}\"` desugars to `x.to_string()`)";
  }
  return " — add `import \"" + mod + "\"`" + note;
}

function (s: Scope) stdlib_near_advice(ns: string, method: string, recv: typeinfo.Type): string {
  let near: string = util.suggest(method, stdlib_methods.methods_on(ns));
  if (near.len() == 0 || !s.stdlib_receiver_matches(ns, near, recv)) {
    return "";
  }
  let mod: string = stdlib_methods.module_of(ns, near);
  if (s.imports_directly(mod)) {
    return "";
  }
  return " — did you mean \"" + near + "\", which needs `import \"" + mod + "\"`?";
}

function (s: Scope) method_fix_candidates(ns: string, recv: typeinfo.Type): string[] {
  if let typeinfo.TypeArray(a) = recv {
    if (a.view) {
      let names: string[] = ["len"];
      for candidate in s.methods.methods {
        if (parser.spelling_is_view(candidate.receiver_type)) {
          names = push_str_unique_sorted(names, candidate.name);
        }
      }
      return names;
    }
  }
  if (!s.namespace_is_exact(ns)) {
    return [];
  }
  let out: string[] = preregistered_methods(ns);
  for method in s.methods.methods {
    if ((method.receiver_type == ns || ns == "Map" && map_receiver_type(method.receiver_type)) && s.method_visible(method)) {
      out = push_str_unique_sorted(out, method.name);
    }
  }
  return out;
}

function (s: Scope) unknown_method_advice(ns: string, method: string, recv: typeinfo.Type): string {
  let label: string = type_label(recv);
  let surface: string = ns;
  if let typeinfo.TypeUnion(u) = recv {
    surface = u.name;
  }
  if (s.methods_in_namespace(surface).len() > 0 || stdlib_methods.methods_on(surface).len() > 0) {
    return s.unknown_method_message(surface, method, label, recv);
  }
  return "field access on non-struct value of type " + label;
}

function method_namespace_of(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeArray(_) => {
      return "Array";
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function (s: Scope) has_array_recv_method(field: string, view: boolean): boolean {
  return s.array_recv_method(field, view).name.len() > 0;
}

function (s: Scope) lookup_union(name: string): UnionSig {
  let at: i32 = s.unions.index.find(name);
  if (at >= 0) {
    return s.unions.unions[at];
  }
  let empty_v: string[] = [];
  return UnionSig { name: "", variants: empty_v, is_try: false, is_enum: false, module: "", type_params: [], instance: "", visible_from: [] };
}

function try_able_union(s: Scope, name: string): boolean {
  if (name == "Option" || name == "Result") {
    return true;
  }
  let us: UnionSig = s.lookup_union(name);
  return us.name.len() != 0 && us.is_try;
}

function try_success_type(s: Scope, ot: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(tu) = ot {
    let same_ret: boolean = false;
    if let typeinfo.TypeUnion(ru) = s.try_ret {
      same_ret = ru.name == tu.name;
    }
    if let typeinfo.TypeUnknown(ru) = s.try_ret {
      same_ret = ru.reason == INFERRED_RESULT;
    }
    if (!same_ret) {
      return t_unknown("`?` outside a function returning " + tu.name);
    }
    if ((tu.name == "Option" || tu.name == "Result") && tu.args.len() > 0) {
      return tu.args[0];
    }
    let us: UnionSig = s.lookup_union(tu.name);
    if (us.is_try && us.variants.len() == 2) {
      return variant_pattern_payload_type(s, tu.name + "." + us.variants[0], ot, 0);
    }
  }
  return t_unknown("`?` operand is not a resolved `?`-able enum");
}

function is_variant_of(struct_name: string, union_name: string, unions: UnionSig[]): boolean {
  for union in unions {
    if (union.name == union_name) {
      for variant in union.variants {
        if (variant == struct_name) {
          return true;
        }
      }
      return false;
    }
  }
  return false;
}

function nested_assignable(from: typeinfo.Type, to: typeinfo.Type, unions: UnionSig[]): boolean {
  if let typeinfo.TypeDyn(_) = to {
    return type_eq(from, to);
  }
  return type_assignable(from, to, unions);
}

function coercible(from: typeinfo.Type, to: typeinfo.Type, s: Scope): boolean {
  return type_assignable(from, to, s.unions.unions) && dyn_conforms(from, to, s);
}

function dyn_conforms(from: typeinfo.Type, to: typeinfo.Type, s: Scope): boolean {
  if let typeinfo.TypeNever(_) = from {
    return true;
  }
  let traits: string = "";
  if let typeinfo.TypeDyn(d) = to {
    traits = d.traits;
  } else {
    return true;
  }
  if let typeinfo.TypeDyn(_) = from {
    return type_eq(from, to);
  }
  if (is_unknown(from)) {
    return true;
  }
  if let typeinfo.TypeErased(_) = from {
    return true;
  }
  if (is_owned_array(from) || is_arr_view(from)) {
    return false;
  }
  let tn: string = util.base_type_name(type_label(from));
  if (tn.len() == 0) {
    return true;
  }
  for tr in parser.dyn_trait_set("dyn " + traits) {
    if (!conforms_to_dyn_trait(s, tn, tr)) {
      return false;
    }
  }
  return true;
}

function ctor_payload_diags(e: ast.Expr, to: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let args: typeinfo.Type[] = [];
  let owner: string = "";
  if let typeinfo.TypeUnion(u) = to {
    args = u.args;
    owner = u.name;
  } else {
    return out;
  }
  if let ast.ExprCall(c) = e {
    if (!constructor_destination(c, to, s)) {
      return out;
    }
    let vname: string = ctor_variant_name(c);
    let k: i32 = 0;
    while (k < c.args.len()) {
      let slot: i32 = ctor_payload_slot(s, owner, vname, k);
      if (slot >= 0 && slot < args.len()) {
        let pt: typeinfo.Type = args[slot];
        out = util.append_diags(out, int_dest_range_diags(c.args[k], pt));
        out = util.append_diags(out, ctor_payload_diags(c.args[k], pt, s));
        if let typeinfo.TypeDyn(_) = pt {
          let at: typeinfo.Type = check_expr(c.args[k], s);
          if (!is_unknown(at) && !dyn_conforms(at, pt, s)) {
            out = out.append(dg_at("E033", "cannot cast " + type_label(at) + " to " + type_label(pt) + ": `as` converts only between numeric types", expr_line(c.args[k]), expr_col(c.args[k])));
          }
        }
      }
      k = k + 1;
    }
  }
  return out;
}

function ctor_name_taken(c: ast.ExprCall, s: Scope): boolean {
  if let ast.ExprIdent(id) = c.callee {
    return s.known(id.name) || s.has_sig(id.name);
  }
  return false;
}

function ctor_variant_name(c: ast.ExprCall): string {
  if let ast.ExprIdent(id) = c.callee {
    return id.name;
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    return fa.field;
  }
  return "";
}

function ctor_payload_slot(s: Scope, owner: string, vname: string, k: i32): i32 {
  if (owner == "Option" || owner == "Result") {
    if (k != 0) {
      return 0 - 1;
    }
    if (owner == "Option" && vname == "Some" || owner == "Result" && vname == "Ok") {
      return 0;
    }
    if (owner == "Result" && vname == "Err") {
      return 1;
    }
    return 0 - 1;
  }
  if (scope_variant_owner(vname, s) != owner) {
    return 0 - 1;
  }
  return payload_type_param(s, s.lookup_union(owner), vname, k);
}

function payload_type_param(s: Scope, us: UnionSig, vname: string, k: i32): i32 {
  let ss: StructSig = s.lookup_owned_struct(variant_pattern_name(vname), us.name);
  let want: string = "__ev";
  if (k > 0) {
    want = "__ev" + util.i32_to_string(k);
  }
  let fi: i32 = util.index_of_str(ss.field_names, want);
  if (fi < 0 || fi >= ss.field_type_names.len()) {
    return 0 - 1;
  }
  return util.index_of_str(us.type_params, ss.field_type_names[fi]);
}

function promotes_view(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if (is_str_view(from) && is_owned_string(to)) {
    return true;
  }
  match (from) {
    typeinfo.TypeArray(fa) => {
      if let typeinfo.TypeArray(ta) = to {
        return promotes_view(fa.elem, ta.elem);
      }
    },
    typeinfo.TypeTuple(ft) => {
      if let typeinfo.TypeTuple(tt) = to {
        return any_promotes_view(ft.elements, tt.elements);
      }
    },
    typeinfo.TypeMap(fm) => {
      if let typeinfo.TypeMap(tm) = to {
        return promotes_view(fm.key, tm.key) || promotes_view(fm.value, tm.value);
      }
    },
    typeinfo.TypeUnion(fu) => {
      if let typeinfo.TypeUnion(tu) = to {
        return any_promotes_view(fu.args, tu.args);
      }
    },
    typeinfo.TypeStruct(fs) => {
      if let typeinfo.TypeStruct(ts) = to {
        return any_promotes_view(fs.args, ts.args);
      }
    },
    _ => {}
  }
  return false;
}

function same_element_type(a: typeinfo.Type, b: typeinfo.Type): boolean {
  return type_eq(a, b) && !promotes_view(a, b) && !promotes_view(b, a);
}

function any_promotes_view(from: typeinfo.Type[], to: typeinfo.Type[]): boolean {
  if (from.len() != to.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < from.len()) {
    if (promotes_view(from[i], to[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function type_assignable(from: typeinfo.Type, to: typeinfo.Type, unions: UnionSig[]): boolean {
  if let typeinfo.TypeNever(_) = from {
    return true;
  }
  if (integer_literal_widens(from, to)) {
    return true;
  }
  if let typeinfo.TypeFunc(tf) = to {
    if let typeinfo.TypeFunc(ff) = from {
      return callable_assignable(ff, tf, unions);
    }
    return false;
  }
  if (promotes_view(from, to)) {
    return false;
  }
  if (is_arr_view(from) && is_owned_array(to) || is_owned_array(from) && is_arr_view(to)) {
    return false;
  }
  if (nominal_args_clash(from, to, unions)) {
    return false;
  }
  if (type_eq(from, to)) {
    return true;
  }
  match (to) {
    typeinfo.TypeArray(te) => {
      match (from) {
        typeinfo.TypeArray(fe) => {
          if (is_unknown(fe.elem) || is_unknown(te.elem)) {
            return true;
          }
          return nested_assignable(fe.elem, te.elem, unions);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeTuple(te) => {
      match (from) {
        typeinfo.TypeTuple(fe) => {
          if (fe.elements.len() != te.elements.len()) {
            return false;
          }
          let i: i32 = 0;
          while (i < te.elements.len()) {
            if (!is_unknown(fe.elements[i]) && !is_unknown(te.elements[i]) && !nested_assignable(fe.elements[i], te.elements[i], unions)) {
              return false;
            }
            i = i + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeUnion(un) => {
      match (from) {
        typeinfo.TypeStruct(sn) => {
          return is_variant_of(sn.name, un.name, unions);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeMap(tm) => {
      match (from) {
        typeinfo.TypeMap(fm) => {
          let kok: boolean = is_unknown(fm.key) || is_unknown(tm.key) || nested_assignable(fm.key, tm.key, unions);
          let vok: boolean = is_unknown(fm.value) || is_unknown(tm.value) || nested_assignable(fm.value, tm.value, unions);
          return kok && vok;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeHandle(th) => {
      if let typeinfo.TypeHandle(fh) = from {
        return th.borrowed && !fh.borrowed && th.resource == fh.resource;
      }
      return false;
    },
    typeinfo.TypeDyn(_) => {
      return !is_str_view(from) && !is_arr_view(from);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function callable_assignable(from: typeinfo.TypeFunc, to: typeinfo.TypeFunc, unions: UnionSig[]): boolean {
  if (!from.params_known || !to.params_known) {
    return true;
  }
  if (from.param_types.len() != to.param_types.len() || !callable_slot_matches(from.ret_type, to.ret_type, unions)) {
    return false;
  }
  let i: i32 = 0;
  while (i < from.param_types.len()) {
    let fp: typeinfo.Type = from.param_types[i];
    let tp: typeinfo.Type = to.param_types[i];
    if (callable_slot_open(fp) || callable_slot_open(tp)) {
      i = i + 1;
      continue;
    }
    if (typeinfo.fn_own_at(from, i) != typeinfo.fn_own_at(to, i) || !callable_slot_matches(fp, tp, unions)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function callable_slot_open(t: typeinfo.Type): boolean {
  if let typeinfo.TypeUnknown(u) = t {
    return !util.str_has_prefix(u.reason, TPARAM_MARK) && !util.str_has_prefix(u.reason, UNRESOLVED_MARK);
  }
  return false;
}

function callable_slot_matches(a: typeinfo.Type, b: typeinfo.Type, unions: UnionSig[]): boolean {
  if (callable_slot_open(a) || callable_slot_open(b)) {
    return true;
  }
  if (is_type_variable(a) || is_type_variable(b)) {
    return is_type_variable(a) && is_type_variable(b) && callable_typevar_name(a) == callable_typevar_name(b);
  }
  return type_assignable(a, b, unions) && type_assignable(b, a, unions);
}

function callable_typevar_name(t: typeinfo.Type): string {
  if let typeinfo.TypeErased(e) = t {
    return e.name;
  }
  return tvar_name(t);
}

function type_from_name(name: string): typeinfo.Type {
  return type_from_spelling(name, type_names([], [], []));
}

function call_through_fn_value(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (desugared_lambda(c.callee)) {
    return t_unknown("immediately-invoked lambda: typed from its branches, not its value");
  }
  let ct: typeinfo.Type = check_expr(c.callee, s);
  match (ct) {
    typeinfo.TypeFunc(tf) => {
      if (!tf.params_known) {
        return tf.ret_type;
      }
      if (c.args.len() != tf.param_types.len()) {
        return t_unknown("arity mismatch calling function value");
      }
      return tf.ret_type;
    },
    _ => {}
  }
  return t_unknown("call target is not a function value");
}

function desugared_lambda(e: ast.Expr): boolean {
  if let ast.ExprLambda(lm) = e {
    return !parser.is_written_lambda_origin(lm.origin);
  }
  return false;
}

function ret_typevar_arg_type(sig: FuncSig, c: ast.ExprCall, s: Scope): (typeinfo.Type, boolean) {
  let (wn, wt) = written_type_bindings(sig, c, s);
  let wi: i32 = util.index_of_str(wn, sig.ret_type_name);
  if (wi >= 0) {
    return (wt[wi], true);
  }
  let rt: typeinfo.Type = t_unknown("no parameter names " + sig.ret_type_name);
  let bound: boolean = false;
  let empty: typeinfo.Type = rt;
  let has_empty: boolean = false;
  let k: i32 = 0;
  while (k < sig.param_type_names.len()) {
    if (sig.param_type_names[k] == sig.ret_type_name && k < c.args.len()) {
      let kt: typeinfo.Type = check_expr(c.args[k], s);
      if (elemless_array(kt)) {
        if (!has_empty) {
          empty = kt;
          has_empty = true;
        }
      } else if (bound) {
        rt = joined_return_argument(rt, kt);
      } else {
        rt = kt;
        bound = true;
      }
    }
    k = k + 1;
  }
  if (!bound && has_empty && !call_binds_elsewhere(sig, c, s)) {
    return (empty, true);
  }
  return (rt, bound);
}

function joined_return_argument(a: typeinfo.Type, b: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(au) = a {
    if let typeinfo.TypeUnion(bu) = b {
      return join_enum_arguments(au, bu);
    }
  }
  return wider_int(a, b);
}

function call_binds_elsewhere(sig: FuncSig, c: ast.ExprCall, s: Scope): boolean {
  let (bn, _) = arg_bindings(sig, c, s);
  return util.index_of_str(bn, sig.ret_type_name) >= 0;
}

function shared_literal_typevar_width(sig: FuncSig, c: ast.ExprCall, tp: string, s: Scope): (typeinfo.Type, boolean) {
  let wt: typeinfo.Type = t_unknown("no literal argument binds " + tp);
  if (c.type_args.len() > 0) {
    return (wt, false);
  }
  let n: i32 = 0;
  let k: i32 = 0;
  while (k < sig.param_type_names.len() && k < c.args.len()) {
    if (sig.param_type_names[k] == tp) {
      if (!int_literal_tree(c.args[k])) {
        return (wt, false);
      }
      let kt: typeinfo.Type = check_expr(c.args[k], s);
      if (n == 0) {
        wt = kt;
      } else {
        wt = wider_int(wt, kt);
      }
      n = n + 1;
    }
    k = k + 1;
  }
  return (wt, n >= 2 && is_integer(wt));
}

function settle_shared_literal_typevars(c: ast.ExprCall, nargs: ast.Expr[], s: Scope): ast.Expr[] {
  let name: string = "";
  if let ast.ExprIdent(cid) = c.callee {
    name = cid.name;
  }
  let at: i32 = 0 - 1;
  if (name.len() > 0) {
    at = s.sig_at(name);
  }
  if (at < 0) {
    return nargs;
  }
  let sig: FuncSig = s.sigs.sigs[at];
  let out: ast.Expr[] = nargs;
  for tp in sig.typevars {
    let (wty, wok) = shared_literal_typevar_width(sig, c, tp, s);
    if (wok) {
      let tag: string = type_to_irtag(wty);
      let k: i32 = 0;
      while (k < sig.param_type_names.len() && k < out.len()) {
        if (sig.param_type_names[k] == tp) {
          out = out.with(k, settle_int_tree(out[k], tag));
        }
        k = k + 1;
      }
    }
  }
  return out;
}

