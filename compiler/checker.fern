function builtin_row(name: string): string {
  let rows: string[] = builtin_sigs();
  let head: string = name + "(";
  let lo: i32 = 0;
  let hi: i32 = rows.len();
  while (lo < hi) {
    let mid: i32 = (lo + hi) / 2;
    if (util.str_less(rows[mid], head)) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  if (lo < rows.len() && util.str_has_prefix(rows[lo], head)) {
    return rows[lo];
  }
  return "";
}

pub function builtin_sig(name: string): typeinfo.Type {
  let row: string = builtin_row(name);
  if (row.len() == 0) {
    return t_unknown("not a builtin: " + name);
  }
  let close: i32 = util.index_of_sub(row, "): ");
  let inner: string = slice_unchecked(row, name.len() + 1, close) + "";
  let params: typeinfo.Type[] = [];
  if (inner.len() > 0) {
    for p in parser.split_top_commas(inner) {
      params = params.append(type_from_name(p));
    }
  }
  return t_func(params, type_from_name(slice_unchecked(row, close + 3, row.len()) + ""));
}

// Primitive display signatures are completed by private runtime source bodies.
function is_primitive_display_builtin(name: string): boolean {
  return util.str_has_prefix(name, "__primitive_") && builtin_row(name).len() > 0;
}

// builtin_method_sig is a builtin method's callable without its receiver, or
// unknown when `recv_name` has no builtin method `name`.
pub function builtin_method_sig(recv_name: string, name: string): typeinfo.Type {
  let builtin_name: string = "__method_" + recv_name + "_" + name;
  if (name == "to_string" && recv_name != "boolean") {
    builtin_name = "__primitive_" + recv_name + "_to_string";
  }
  if let typeinfo.TypeFunc(bm) = builtin_sig(builtin_name) {
    let params: typeinfo.Type[] = [];
    let i: i32 = 1;
    while (i < bm.param_types.len()) {
      params = params.append(bm.param_types[i]);
      i = i + 1;
    }
    return t_func(params, bm.ret_type);
  }
  return t_unknown("not a builtin method: " + recv_name + "." + name);
}

function undeclared_call_type(name: string, s: Scope, args: ast.Expr[]): typeinfo.Type {
  if let typeinfo.TypeFunc(bf) = builtin_sig(name) {
    if (bf.param_types.len() == args.len()) {
      return bf.ret_type;
    }
  }
  let body: string = parser.mkclo_body(name);
  let at: i32 = 0 - 1;
  if (body.len() > 0) {
    at = s.sig_at(body);
  }
  if (at < 0) {
    return t_unknown("undefined function: " + name);
  }
  let sig: FuncSig = s.sigs.sigs[at];
  if (!closure_env_param(sig)) {
    return t_unknown("undefined function: " + name);
  }
  return t_func_after_env(sig);
}

function closure_env_param(sig: FuncSig): boolean {
  if (sig.param_types.len() == 0) {
    return false;
  }
  if let typeinfo.TypeArray(a) = sig.param_types[0] {
    if let typeinfo.TypeI32(_) = a.elem {
      return true;
    }
  }
  return false;
}

function t_func_after_env(sig: FuncSig): typeinfo.Type {
  let params: typeinfo.Type[] = [];
  let owns: boolean[] = [];
  let i: i32 = 1;
  while (i < sig.param_types.len()) {
    params = params.append(sig.param_types[i]);
    owns = owns.append(i < sig.param_own.len() && sig.param_own[i]);
    i = i + 1;
  }
  return t_func_own(params, owns, sig.ret_type);
}

function inferred_payload(e: ast.Expr, s: Scope): typeinfo.Type {
  return unsettled_marked(check_expr(e, s), e, s.lit_locals, true);
}

function integer_literal_widens(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(a) = from {
    if let typeinfo.TypeI32(b) = to {
      return a.polymorphic && !a.is_char && !b.is_char && a.unsigned == b.unsigned
        && a.width > 0 && a.width < b.width;
    }
  }
  return false;
}

function builtin_ctor_type(en: string, name: string, c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (name == "Some" && c.args.len() == 1) {
    return t_union_g(en, [inferred_payload(c.args[0], s)]);
  }
  if (name == "Ok" && c.args.len() == 1) {
    return t_union_g(en, [inferred_payload(c.args[0], s), t_unknown("unbound E")]);
  }
  if (name == "Err" && c.args.len() == 1) {
    return t_union_g(en, [t_unknown("unbound T"), inferred_payload(c.args[0], s)]);
  }
  return t_union(en);
}

function literal_insert_columns(c: ast.ExprCall, mt: typeinfo.TypeMap, recv_ty: typeinfo.Type, s: Scope): typeinfo.Type {
  if (!literal_insert(c) || !is_unknown(mt.key) && !is_unknown(mt.value)) {
    return recv_ty;
  }
  let ik: typeinfo.Type = mt.key;
  let iv: typeinfo.Type = mt.value;
  if (is_unknown(ik)) {
    ik = check_expr(c.args[0], s);
  }
  if (is_unknown(iv)) {
    iv = check_expr(c.args[1], s);
  }
  return t_map(ik, iv);
}

pub function receiver_key(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeStruct(sn) => {
      return sn.name;
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeMap(_) => {
      return "Map";
    },
    typeinfo.TypeUnion(un) => {
      return un.name;
    },
    typeinfo.TypeLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function check_call_expr(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (c.args.len() == 0) {
    match (c.callee) {
      ast.ExprLambda(lm) => {
        if (lm.params.len() == 0 && lm.body.len() == 1) {
          let bts: typeinfo.Type[] = [];
          match (lm.body[0]) {
            ast.StmtIf(f) => {
              bts = mx_if_branch_types(f, s);
            },
            ast.StmtMatch(m) => {
              bts = mx_match_arm_types(m, s);
            },
            _ => {}
          }
          if (bts.len() > 0) {
            let result: typeinfo.Type = vb_arms_unified(bts, mx_body_result_exprs(lm.body));
            if (!is_unknown(result)) {
              return result;
            }
            if (parser.is_value_block_origin(lm.origin)) {
              let arms: ast.Expr[] = mx_body_result_exprs(lm.body);
              let fold: MxFold = vb_arms_fold(bts, arms, s);
              if (is_unknown(fold.acc.t)) {
                return t_unknown("value block arms disagree");
              }
              if (!fold.ok) {
                return fold.acc.t;
              }
              let tag: typeinfo.Type = lambda_ret_type(lm, s);
              let bi: i32 = 0;
              while (bi < bts.len() && bi < arms.len()) {
                if (!arm_int_literal(arms[bi]) && !is_unknown(bts[bi]) && !type_eq(bts[bi], tag)) {
                  return bts[bi];
                }
                bi = bi + 1;
              }
            }
          }
        }
        let vlocal: string = vb_local_name(lm.body);
        if (lm.params.len() == 0 && vlocal.len() > 0) {
          return vb_store_type(lm.body, vlocal, s);
        }
        if (lm.params.len() == 0 && lm.origin == parser.ORIGIN_BLOCK) {
          return value_block_tail_type(lm.body, s);
        }
      },
      _ => {}
    }
  }
  let name: string = "";
  let is_method: boolean = false;
  let recv_type_name: string = "";
  let recv_ty: typeinfo.Type = t_unknown("");
  match (c.callee) {
    ast.ExprIdent(id) => {
      name = id.name;
    },
    ast.ExprFieldAccess(fa) => {
      let qhandled: boolean = false;
      match (fa.obj) {
        ast.ExprIdent(ns_id) => {
          let qname: string = ns_id.name + "." + fa.field;
          if (s.has_sig(qname)) {
            name = qname;
            qhandled = true;
          }
        },
        _ => {}
      }
      if (!qhandled) {
        let cqu: string = qual_variant_union(fa, s);
        if (cqu.len() > 0) {
          return variant_ctor_type(s, cqu, fa.field, c);
        }
      }
      if (!qhandled) {
        let ah: AssocHit = assoc_call_req(fa.obj, fa.field, s, fa.const_read);
        if (ah.found) {
          if (ah.ret.len() == 0) {
            if let ast.ExprIdent(aoid) = fa.obj {
              let asig: FuncSig = s.lookup_assoc_sig(aoid.name, fa.field);
              if (asig.name.len() > 0) {
                return sig_call_type(asig, fa.field, c, s);
              }
            }
          }
          return assoc_hit_type(ah, fa.obj, s);
        }
      }
      if (!qhandled) {
        name = fa.field;
        is_method = true;
        recv_ty = check_expr(fa.obj, s);
        let arr_mt: typeinfo.Type = s.array_method_ret_type(c, recv_ty, name);
        if (!is_unknown(arr_mt)) {
          return arr_mt;
        }
        recv_type_name = receiver_key(recv_ty);
        if (recv_type_name.len() == 0) {
          if let typeinfo.TypeDyn(d) = recv_ty {
            return dyn_method_type(d.traits, name, s);
          }
          match (bound_method(s, tp_receiver(recv_ty, s), name)) {
            Some(msig) => {
              return generic_method_ret(c, msig, method_binding(c, msig, recv_ty, s), s);
            },
            None => {}
          }
          let tvr: typeinfo.Type = call_through_fn_value(c, s);
          if (!is_unknown(tvr)) {
            return tvr;
          }
          return t_unknown("method call: receiver isn't a typed value");
        }
      }
    },
    _ => {
      return call_through_fn_value(c, s);
    }
  }
  if (!is_method && is_map_new_name(name)) {
    return t_map(t_unknown(MAP_NEW_KEY), t_unknown(MAP_NEW_VALUE));
  }
  if (!is_method && name == "cell_new") {
    return t_struct("Cell");
  }
  if (!is_method && (name == "print" || name == "eprint") && c.args.len() == 1) {
    return t_void();
  }
  if (!is_method && (name == "target_os" || name == "target_arch") && c.args.len() == 0) {
    return t_string();
  }
  if (!is_method && name == "slice_unchecked") {
    if (c.args.len() != 3) {
      return t_unknown("slice_unchecked takes 3 arguments");
    }
    let sut: typeinfo.Type = check_expr(c.args[0], s);
    if (!is_integer(check_expr(c.args[1], s)) || !is_integer(check_expr(c.args[2], s))) {
      return t_unknown("slice_unchecked bounds must be i32");
    }
    match (sut) {
      typeinfo.TypeString(_) => {
        return t_str();
      },
      _ => {}
    }
    return t_unknown("slice_unchecked: first argument must be a string");
  }
  let builtin_typed: typeinfo.Type = builtin_result_type(recv_ty, name, is_method, c.args.len(), s);
  if (!is_unknown(builtin_typed)) {
    return builtin_typed;
  }
  if (is_method && name == "len" && c.args.len() == 0) {
    match (recv_ty) {
      typeinfo.TypeString(_) => {
        return t_i32();
      },
      _ => {}
    }
  }
  if (is_method && name == "as_bytes" && c.args.len() == 0) {
    match (recv_ty) {
      typeinfo.TypeString(_) => {
        return t_view(t_u8());
      },
      _ => {}
    }
  }
  if (is_method) {
    let source_recv_ty: typeinfo.Type = recv_ty;
    recv_ty = map_method_receiver(c, recv_ty);
    match (recv_ty) {
      typeinfo.TypeMap(mt) => {
        if (name == "insert") {
          if (c.args.len() != 2) {
            return t_unknown("map.insert: 2 args");
          }
          return literal_insert_columns(c, mt, recv_ty, s);
        }
        if (name == "get_or") {
          if (c.args.len() != 2) {
            return t_unknown("map.get_or: 2 args");
          }
          return mt.value;
        }
        if (name == "get" && c.args.len() == 1) {
          return t_union_g("Option", [mt.value]);
        }
        if (name == "contains") {
          if (c.args.len() != 1) {
            return t_unknown("map.contains: 1 arg");
          }
          return t_bool();
        }
        if (name == "remove") {
          if (c.args.len() != 1) {
            return t_unknown("map.remove: 1 arg");
          }
          return recv_ty;
        }
        if (name == "len") {
          if (c.args.len() != 0) {
            return t_unknown("map.len: 0 args");
          }
          return t_i32();
        }
        if (name == "keys") {
          return t_array(mt.key);
        }
        if (name == "values") {
          return t_array(mt.value);
        }
        if (name == "cleared") {
          if (c.args.len() != 0) {
            return t_unknown("map.cleared: 0 args");
          }
          return recv_ty;
        }
      },
      _ => {}
    }
    let msig: MethodSig = s.lookup_method(name, recv_type_name);
    if (map_source_receiver_missing(source_recv_ty, msig)) {
      return t_unknown("method receiver lacks map columns");
    }
    if (msig.name.len() == 0) {
      if let typeinfo.TypeFunc(bm) = builtin_method_sig(recv_type_name, name) {
        if (bm.param_types.len() == c.args.len()) {
          return bm.ret_type;
        }
      }
      if let typeinfo.TypeStruct(cfsn) = recv_ty {
        if let typeinfo.TypeFunc(cff) = struct_field_type(cfsn, name, s) {
          return cff.ret_type;
        }
      }
      return t_unknown("undefined method `" + name + "` on `" + recv_type_name + "`");
    }
    if (c.args.len() != msig.param_types.len()) {
      return t_unknown("arity mismatch calling method `" + name + "`");
    }
    return generic_method_ret(c, msig, method_binding(c, msig, recv_ty, s), s);
  }
  let bound_at: i32 = s.binding_index(name);
  if (bound_at >= 0) {
    if let typeinfo.TypeFunc(tf) = s.types[bound_at] {
      if (!tf.params_known) {
        return tf.ret_type;
      }
      if (c.args.len() != tf.param_types.len()) {
        return t_unknown("arity mismatch calling closure `" + name + "`");
      }
      return tf.ret_type;
    }
  }
  let ctor_shadowed: boolean = ctor_name_taken(c, s);
  if (!ctor_shadowed && s.variant_ambiguous(name)) {
    return t_unknown("ambiguous variant `" + name + "`");
  }
  let ctor_user: string = "";
  if (!ctor_shadowed) {
    ctor_user = scope_variant_owner(name, s);
  }
  if (ctor_user.len() > 0) {
    return variant_ctor_type(s, ctor_user, name, c);
  }
  let ctor_enum: string = "";
  if (!ctor_shadowed) {
    ctor_enum = parser.builtin_enum_of(name);
  }
  if (ctor_enum.len() > 0) {
    return builtin_ctor_type(ctor_enum, name, c, s);
  }
  let at: i32 = s.sig_at(name);
  if (at < 0) {
    return undeclared_call_type(name, s, c.args);
  }
  return sig_call_type(s.sigs.sigs[at], name, c, s);
}

function sig_call_type(sig: FuncSig, name: string, c: ast.ExprCall, s: Scope): typeinfo.Type {
  if (c.args.len() != sig.param_types.len()) {
    return t_unknown("arity mismatch calling `" + name + "`");
  }
  let bn: string[] = [];
  let bt: typeinfo.Type[] = [];
  if (sig.all_type_params.len() > 0) {
    let (names, types) = call_type_bindings(sig, c, s);
    bn = names;
    bt = types;
  }
  if (sig.all_type_params.len() > 0 && is_unknown(sig.ret_type) && sig.ret_type_name.len() > 0) {
    let (rtv, rtv_bound) = ret_typevar_arg_type(sig, c, s);
    if (rtv_bound) {
      return rtv;
    }
  }
  return inferred_sig_ret(sig, c, s, bn, bt);
}

function inferred_sig_ret(sig: FuncSig, c: ast.ExprCall, s: Scope, names: string[], types: typeinfo.Type[]): typeinfo.Type {
  let bn: string[] = names;
  let bt: typeinfo.Type[] = types;
  if (type_contains_unknown(sig.ret_type) && sig.ret_type_name.len() > 0) {
    if (sig.all_type_params.len() == 0) {
      let (names, types) = call_type_bindings(sig, c, s);
      bn = names;
      bt = types;
    }
    for tp in sig.type_params {
      if (util.index_of_str(bn, tp) < 0) {
        bn = bn.append(tp);
        bt = bt.append(t_unknown(TPARAM_MARK + tp));
      }
    }
    if (bn.len() > 0 && util.contains(sig.ret_type_name, "::")) {
      let pty: typeinfo.Type = projected_ret(sig.ret_type_name, bn, bt, s);
      if (!type_contains_unknown(pty)) {
        return pty;
      }
    }
    if (bn.len() > 0) {
      let gsubst: typeinfo.Type = type_from_ref_subst(sig_ret_ref(sig), bn, bt, s.type_names());
      if (!type_contains_unknown(gsubst)) {
        return gsubst;
      }
    }
  }
  return sig.ret_type;
}

function arg_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let (wn, wt) = written_type_bindings(sig, c, s);
  let (tn, tt) = bind_from_args(sig, c, s, false, wn, wt);
  return bind_from_args(sig, c, s, true, tn, tt);
}

function bind_from_args(sig: FuncSig, c: ast.ExprCall, s: Scope, literals: boolean, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  let bn: string[] = names;
  let bt: typeinfo.Type[] = types;
  let i: i32 = 0;
  while (i < sig.param_type_names.len() && i < c.args.len()) {
    if (int_literal_tree(c.args[i]) == literals && !binds_nothing(c.args[i], s)) {
      let (bn2, bt2) = gc_bind_param(sig_param_ref(sig, i), check_expr(c.args[i], s), sig.type_params, s.type_names(), bn, bt);
      bn = bn2;
      bt = bt2;
    }
    i = i + 1;
  }
  return (bn, bt);
}

function call_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let (wn, wt) = written_type_bindings(sig, c, s);
  let (tn, tt) = bind_from_args(sig, c, s, false, wn, wt);
  let (bn, bt) = bound_bindings(sig, s, tn, tt);
  let (ln, lt) = bind_from_args(sig, c, s, true, tn, tt);
  let i: i32 = tn.len();
  while (i < ln.len()) {
    let bi: i32 = util.index_of_str(bn, ln[i]);
    if (bi >= 0 && is_integer(lt[i]) && is_integer(bt[bi])) {
      lt = lt.with(i, bt[bi]);
    }
    i = i + 1;
  }
  return bound_bindings(sig, s, ln, lt);
}

function written_type_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let bn: string[] = [];
  let bt: typeinfo.Type[] = [];
  if (c.type_args.len() != sig.all_type_params.len()) {
    return (bn, bt);
  }
  let i: i32 = 0;
  while (i < c.type_args.len()) {
    if (c.type_args[i].len() > 0) {
      let wt: typeinfo.Type = type_from_spelling(c.type_args[i], s.type_names());
      if (!type_contains_unknown(wt)) {
        bn = bn.append(sig.all_type_params[i]);
        bt = bt.append(wt);
      }
    }
    i = i + 1;
  }
  return (bn, bt);
}

function bound_type_arg_diags(sig: FuncSig, c: ast.ExprCall, ai: i32, at: typeinfo.Type, s: Scope, wn: string[], wt: typeinfo.Type[]): util.Diag[] {
  let none: util.Diag[] = [];
  if (ai >= sig.param_type_names.len() || !type_contains_unknown(sig.param_types[ai])) {
    return none;
  }
  let pref: parser.TypeRef = sig_param_ref(sig, ai);
  if (wn.len() == 0 || !type_ref_names_any(pref, wn)) {
    return none;
  }
  let want: typeinfo.Type = type_from_ref_subst(pref, wn, wt, s.type_names());
  if (type_contains_unknown(want)) {
    return none;
  }
  let out: util.Diag[] = int_dest_range_diags(c.args[ai], want);
  if (out.len() == 0 && !bound_arg_accepts(c.args[ai], at, want, s) && !generic_scalar_own_callback(at, want, pref, wn, s)) {
    out = out.append(dg_at("E038", arg_subject(c, ai + 1) + ": expected " + type_label(want) + ", got " + type_label(at), expr_line(c.args[ai]), expr_col(c.args[ai])));
  }
  return out;
}

function param_has_bindings(sig: FuncSig, ai: i32, names: string[]): boolean {
  return names.len() > 0 && type_contains_unknown(sig.param_types[ai]) && type_ref_names_any(sig_param_ref(sig, ai), names);
}

function bound_arg_accepts(e: ast.Expr, actual: typeinfo.Type, want: typeinfo.Type, s: Scope): boolean {
  return is_unknown(actual) || settles_to(e, want, s) || view_arg_borrow(actual, want) || coercible(actual, want, s);
}

function generic_own_callback_accepts(actual: typeinfo.Type, want: typeinfo.Type, names: string[], spelling: string, s: Scope): boolean {
  return names.len() > 0 && generic_scalar_own_callback(actual, want, parser.parse_type_ref(spelling), names, s);
}

function generic_scalar_own_callback(actual: typeinfo.Type, want: typeinfo.Type, ref: parser.TypeRef, names: string[], s: Scope): boolean {
  if (names.len() == 0 || !parser.ref_is_fn_value(ref)) {
    return false;
  }
  if let typeinfo.TypeFunc(a) = actual {
    if let typeinfo.TypeFunc(w) = want {
      let owns: boolean[] = scalar_own_callback_flags(a, w, parser.ref_ungroup(ref), names);
      return callable_assignable(a, typeinfo.TypeFunc { ...w, param_own: owns }, s.unions.unions);
    }
  }
  return false;
}

function scalar_own_callback_flags(a: typeinfo.TypeFunc, w: typeinfo.TypeFunc, r: parser.TypeRef, names: string[]): boolean[] {
  let owns: boolean[] = [];
  let i: i32 = 0;
  while (i < w.param_types.len() && i + 1 < r.args.len()) {
    let on: boolean = typeinfo.fn_own_at(w, i);
    if (parser.ref_is_own(r.args[i]) && type_ref_names_any(parser.ref_without_own(r.args[i]), names) && !type_contains_unknown(w.param_types[i]) && !typeinfo.ownable(w.param_types[i])) {
      on = typeinfo.fn_own_at(a, i);
    }
    owns = owns.append(on);
    i = i + 1;
  }
  return owns;
}

function call_type_bindings(sig: FuncSig, c: ast.ExprCall, s: Scope): (string[], typeinfo.Type[]) {
  let (bn, bt) = call_bindings(sig, c, s);
  let wbi: i32 = 0;
  while (wbi < bn.len()) {
    let (wty, wok) = shared_literal_typevar_width(sig, c, bn[wbi], s);
    if (wok) {
      bt = bt.with(wbi, wty);
    }
    wbi = wbi + 1;
  }
  return (bn, bt);
}

function elemless_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return is_unknown(a.elem);
  }
  return false;
}

function uninferred_call_diags(sig: FuncSig, c: ast.ExprCall, bn: string[], name: string, s: Scope, dest: typeinfo.Type): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() > 0) {
    return out;
  }
  let ret: parser.TypeRef = sig_ret_ref(sig);
  let bound: string[] = bn;
  if (!is_unknown(dest)) {
    let no_types: typeinfo.Type[] = [];
    let (dn, dt) = gc_bind_param(ret, dest, sig.type_params, s.type_names(), [], no_types);
    bound = util.append_all(bound, dn);
  }
  for tp in sig.all_type_params {
    let (named, all_empty) = empty_array_positions(sig.param_type_names, c.args, tp, s);
    if (util.index_of_str(bound, tp) < 0 && !bound_names_tp(sig.type_bounds, tp) && all_empty) {
      out = out.append(dg_at("E040", "could not infer type parameter " + tp + " for " + name + " — supply it explicitly at the call site (e.g. " + name + "[i32](...)) or annotate the binding", c.line, c.col));
    }
  }
  return out;
}

function uninferred_method_diags(c: ast.ExprCall, recv: string, method: string, msig: MethodSig, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() > 0 || msig.name.len() == 0 || c.args.len() != msig.param_type_names.len()) {
    return out;
  }
  let rref: parser.TypeRef = parser.parse_type_ref(msig.receiver_type);
  let ret: parser.TypeRef = parser.parse_type_ref(msig.ret_type_name);
  for tp in msig.all_type_params {
    let (named, all_empty) = empty_array_positions(msig.param_type_names, c.args, tp, s);
    if (!type_ref_names_any(rref, [tp]) && !type_ref_names_any(ret, [tp]) && !bound_names_tp(msig.type_bounds, tp) && all_empty) {
      out = out.append(dg_at("E040", "could not infer type parameter " + tp + " for " + recv + "." + method + " — supply it explicitly at the call site (e.g. ." + method + "[i32](...)) or annotate the binding", c.line, c.col));
    }
  }
  return out;
}

function declared_method_diags(c: ast.ExprCall, recv_ty: typeinfo.Type, recv: string, method: string, s: Scope): util.Diag[] {
  let msig: MethodSig = s.lookup_method(method, recv);
  if (msig.name.len() == 0) {
    let builtin: typeinfo.Type = builtin_method_sig(recv, method);
    if let typeinfo.TypeFunc(f) = builtin {
      if (c.args.len() != f.param_types.len()) {
        return [dg_at("E004", util.arity_message("method \"" + method + "\"", f.param_types.len(), c.args.len(), "argument"), c.line, c.col)];
      }
      return callable_arg_diags(c, builtin, s);
    }
    return uninferred_method_diags(c, recv, method, msig, s);
  }
  if (c.args.len() != msig.param_types.len()) {
    return [dg_at("E004", util.arity_message("method \"" + method + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col)];
  }
  let out: util.Diag[] = method_arg_diags(c, method, msig, recv_ty, s);
  out = util.append_diags(out, method_type_arg_diags(c, method, msig, recv_ty, s));
  return util.append_diags(out, uninferred_method_diags(c, recv, method, msig, s));
}

function map_method_arg_diags(c: ast.ExprCall, recv_ty: typeinfo.Type, method: string, s: Scope): util.Diag[] {
  let msig: MethodSig = s.lookup_method(method, "Map");
  if (msig.name.len() == 0) {
    return [];
  }
  if (c.args.len() != msig.param_types.len()) {
    return [dg_at("E004", util.arity_message("method \"" + method + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col)];
  }
  let out: util.Diag[] = method_arg_diags(c, method, msig, recv_ty, s);
  return util.append_diags(out, method_type_arg_diags(c, method, msig, recv_ty, s));
}

function uninferred_recv_diags(c: ast.ExprCall, recv: string, method: string, msig: MethodSig, args: typeinfo.Type[], s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() > 0 || msig.name.len() == 0 || c.args.len() != msig.param_type_names.len()) {
    return out;
  }
  let rref: parser.TypeRef = parser.parse_type_ref(msig.receiver_type);
  let ret: parser.TypeRef = parser.parse_type_ref(msig.ret_type_name);
  let k: i32 = 0;
  while (k < rref.args.len()) {
    let ar: parser.TypeRef = rref.args[k];
    let tp: string = ar.base;
    let bare: boolean = ar.args.len() == 0 && ar.array_depth == 0 && !ar.is_tuple && !ar.is_fn;
    let bound: boolean = k < args.len();
    if (bare && !bound && !type_ref_names_any(ret, [tp]) && !bound_names_tp(msig.type_bounds, tp)) {
      let (_, all_empty) = empty_array_positions(msig.param_type_names, c.args, tp, s);
      if (all_empty) {
        out = out.append(dg_at("E040", "could not infer type parameter " + tp + " for " + recv + "." + method + " — supply it explicitly at the call site (e.g. ." + method + "[i32](...)) or annotate the binding", c.line, c.col));
      }
    }
    k = k + 1;
  }
  return out;
}

function empty_array_positions(spellings: string[], values: ast.Expr[], tp: string, s: Scope): (boolean, boolean) {
  let named: boolean = false;
  let all_empty: boolean = true;
  let k: i32 = 0;
  while (k < spellings.len() && k < values.len()) {
    if (spellings[k].len() > 0 && type_ref_names_any(parser.parse_type_ref(spellings[k]), [tp])) {
      named = true;
      if (!binds_nothing(values[k], s)) {
        all_empty = false;
      }
    }
    k = k + 1;
  }
  return (named, all_empty);
}

function binds_nothing(e: ast.Expr, s: Scope): boolean {
  match (e) {
    ast.ExprArray(arr) => {
      return arr.elements.len() == 0;
    },
    ast.ExprIdent(id) => {
      return !s.is_bound(id.name) && generic_unit_variant(id.name, s);
    },
    ast.ExprLambda(lm) => {
      return lm.use_infer && lm.params.len() > 0 && lm.params[0].type_name.len() == 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function use_untyped_call(e: ast.Expr): boolean {
  if let ast.ExprCall(c) = e {
    return use_untyped(c);
  }
  return false;
}

function generic_unit_variant(name: string, s: Scope): boolean {
  let owner: UnionSig = union_sig_of_variant(name, s.unions);
  return owner.is_enum && owner.type_params.len() > 0 && variant_value_payloads(s, "", name) == 0;
}

function bound_names_tp(bounds: string[], tp: string): boolean {
  for b in bounds {
    for entry in parser.split_plus_bounds(b) {
      if (type_ref_names_any(parser.parse_type_ref(entry), [tp])) {
        return true;
      }
    }
  }
  return false;
}

function bound_arg_diags(sig: FuncSig, c: ast.ExprCall, bn: string[], bt: typeinfo.Type[], s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let i: i32 = 0;
  while (i < sig.type_params.len() && i < sig.type_bounds.len()) {
    let bi: i32 = util.index_of_str(bn, sig.type_params[i]);
    if (sig.type_bounds[i].len() > 0 && bi >= 0) {
      for entry in parser.split_plus_bounds(sig.type_bounds[i]) {
        out = util.append_diags(out, bound_entry_diag(sig, sig.type_params[i], bt[bi], parser.parse_type_ref(entry), bn, bt, c, s));
      }
    }
    i = i + 1;
  }
  return out;
}

function bound_entry_diag(sig: FuncSig, tp: string, at: typeinfo.Type, bref: parser.TypeRef, bn: string[], bt: typeinfo.Type[], c: ast.ExprCall, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  let iargs: typeinfo.Type[] = impl_trait_args(bref, sig.module, at, s);
  if (iargs.len() == 0 || iargs.len() != bref.args.len()) {
    return none;
  }
  let want: typeinfo.Type[] = [];
  let clash: boolean = false;
  let k: i32 = 0;
  while (k < iargs.len()) {
    let w: typeinfo.Type = type_from_ref_subst(bref.args[k], bn, bt, s.type_names());
    if (type_contains_unknown(w)) {
      return none;
    }
    if (!type_eq(w, iargs[k])) {
      clash = true;
    }
    want = want.append(w);
    k = k + 1;
  }
  if (!clash) {
    return none;
  }
  let tr: string = bound_trait_display(bref.base, sig.module, s.trait_reqs);
  return [dg_at("E021", "type argument " + tp + " = " + util.demangle(type_label(at)) + " implements " + tr + trait_args_label(iargs) + " but the bound requires " + tr + trait_args_label(want) + " (in " + util.demangle(sig.name) + ")", c.line, c.col)];
}

function trait_args_label(args: typeinfo.Type[]): string {
  let out: string = "";
  for a in args {
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + util.demangle(type_label(a));
  }
  return "[" + out + "]";
}

function dest_bound_diags(e: ast.Expr, dest: typeinfo.Type, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  let arms: ast.Expr[] = value_if_results(e);
  if (arms.len() > 0) {
    let out: util.Diag[] = [];
    for arm in arms {
      out = util.append_diags(out, dest_bound_diags(arm, dest, s));
    }
    return out;
  }
  if let ast.ExprArray(arr) = e {
    let elem: typeinfo.Type = array_elem_type_of(dest);
    let eout: util.Diag[] = [];
    if (is_unknown(elem)) {
      return eout;
    }
    for element in arr.elements {
      eout = util.append_diags(eout, dest_bound_diags(element, elem, s));
    }
    return eout;
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (s.defines(id.name)) {
        return none;
      }
      let sig: FuncSig = s.lookup_sig(id.name);
      if (sig.all_type_params.len() == 0 || sig.ret_type_name.len() == 0 || c.args.len() != sig.param_types.len()) {
        return none;
      }
      let (cn, ct) = call_bindings(sig, c, s);
      if (bound_arg_diags(sig, c, cn, ct, s).len() > 0) {
        return none;
      }
      let (bn, bt) = arg_bindings(sig, c, s);
      let (dn, dt) = gc_bind_param(sig_ret_ref(sig), dest, sig.type_params, s.type_names(), bn, bt);
      if (dn.len() == bn.len()) {
        return none;
      }
      let (fn_, ft) = bound_bindings(sig, s, dn, dt);
      return util.append_diags(dest_bound_e021(sig, c, dn, dt, bn.len(), s), bound_arg_diags(sig, c, fn_, ft, s));
    }
  }
  return none;
}

function dest_bound_e021(sig: FuncSig, c: ast.ExprCall, dn: string[], dt: typeinfo.Type[], from: i32, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let di: i32 = from;
  while (di < dn.len()) {
    let ti: i32 = util.index_of_str(sig.type_params, dn[di]);
    if (ti >= 0 && ti < sig.type_bounds.len() && !is_unknown(dt[di]) && !is_type_variable(dt[di])) {
      out = util.append_diags(out, tp_bound_diags(dn[di], sig.type_bounds[ti], sig.module, util.demangle(sig.name), dt[di], s, c.line, c.col));
    }
    di = di + 1;
  }
  return out;
}

function dest_bound_result(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (s.defines(id.name)) {
        return false;
      }
      let sig: FuncSig = s.lookup_sig(id.name);
      if (sig.all_type_params.len() == 0 || c.args.len() != sig.param_types.len()) {
        return false;
      }
      let ret: parser.TypeRef = sig_ret_ref(sig);
      if (ret.args.len() > 0 || ret.array_depth > 0 || !util.has_str(sig.all_type_params, ret.base)) {
        return false;
      }
      let (bn, _) = call_type_bindings(sig, c, s);
      return util.index_of_str(bn, ret.base) < 0 && is_type_variable(check_expr(e, s));
    }
  }
  return false;
}

function value_if_results(e: ast.Expr): ast.Expr[] {
  let none: ast.Expr[] = [];
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lam) = c.callee {
      if (c.args.len() != 0 || lam.origin != parser.ORIGIN_IF_EXPR && lam.origin != parser.ORIGIN_MATCH_EXPR) {
        return none;
      }
      let out: ast.Expr[] = [];
      for st in lam.body {
        out = astwalk.fold_stmt_spine(st, out, collect_arm_result);
      }
      return out;
    }
  }
  return none;
}

function collect_arm_result(st: ast.Stmt, own acc: ast.Expr[]): ast.Expr[] {
  if let ast.StmtReturn(r) = st {
    return acc.append(r.value);
  }
  if let ast.StmtAssign(a) = st {
    if (parser.is_value_local_name(a.target)) {
      return acc.append(a.value);
    }
  }
  return acc;
}

function bound_bindings(sig: FuncSig, s: Scope, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  return bounds_bindings(sig.type_params, sig.type_bounds, sig.module, s, names, types);
}

function bounds_bindings(tparams: string[], bounds: string[], module: string, s: Scope, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  let ns: string[] = names;
  let ts: typeinfo.Type[] = types;
  let before: i32 = 0 - 1;
  while (ns.len() > before) {
    before = ns.len();
    let i: i32 = 0;
    while (i < tparams.len() && i < bounds.len()) {
      let bi: i32 = util.index_of_str(ns, tparams[i]);
      if (bounds[i].len() > 0 && bi >= 0) {
        for entry in parser.split_plus_bounds(bounds[i]) {
          let bref: parser.TypeRef = parser.parse_type_ref(entry);
          let iargs: typeinfo.Type[] = impl_trait_args(bref, module, ts[bi], s);
          if (iargs.len() == bref.args.len()) {
            let k: i32 = 0;
            while (k < iargs.len()) {
              let (n2, t2) = gc_bind_param(bref.args[k], iargs[k], tparams, s.type_names(), ns, ts);
              ns = n2;
              ts = t2;
              k = k + 1;
            }
          }
        }
      }
      i = i + 1;
    }
  }
  return (ns, ts);
}

function impl_trait_args(bound: parser.TypeRef, module: string, at: typeinfo.Type, s: Scope): typeinfo.Type[] {
  let none: typeinfo.Type[] = [];
  if (bound.args.len() == 0 || type_contains_unknown(at)) {
    return none;
  }
  if let typeinfo.TypeDyn(d) = at {
    return dyn_trait_args(bound, d.traits, s);
  }
  let base: string = receiver_namespace(util.base_type_name(type_label(at)));
  for imp in s.impls {
    if (bound_names_trait(bound.base, module, imp.trait_name, imp.trait_module) && impl_receiver(imp) == base) {
      let (in_, it_) = gc_bind_param(parser.parse_type_ref(imp.impl_type), at, imp.all_type_params, s.type_names(), [], []);
      let out: typeinfo.Type[] = [];
      for targ in parser.parse_type_ref(imp.trait_ref).args {
        let ty: typeinfo.Type = type_from_ref_subst(targ, in_, it_, s.type_names());
        if (type_contains_unknown(ty)) {
          return none;
        }
        out = out.append(ty);
      }
      return out;
    }
  }
  return none;
}

function dyn_trait_args(bound: parser.TypeRef, traits: string, s: Scope): typeinfo.Type[] {
  let none: typeinfo.Type[] = [];
  let want: string = parser.derive_simple_name(bound.base);
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let ref: parser.TypeRef = parser.parse_type_ref(tr);
    if (parser.derive_simple_name(ref.base) == want) {
      let out: typeinfo.Type[] = [];
      for targ in ref.args {
        let ty: typeinfo.Type = type_from_ref_subst(targ, [], [], s.type_names());
        if (type_contains_unknown(ty)) {
          return none;
        }
        out = out.append(ty);
      }
      return out;
    }
  }
  return none;
}

function bound_names_trait(base: string, module: string, name: string, trait_module: string): boolean {
  if (parser.derive_simple_name(base) != name) {
    return false;
  }
  if (util.index_of_sub(base, ".") >= 0) {
    return trait_module.len() > 0;
  }
  return trait_module == module;
}

function struct_lit_args(sl: ast.ExprStructLit, ssig: StructSig, s: Scope): typeinfo.Type[] {
  let written: typeinfo.Type[] = written_struct_args(sl, ssig, s);
  if (written.len() > 0) {
    return written;
  }
  let bn: string[] = [];
  let bt: typeinfo.Type[] = [];
  let pass: i32 = 0;
  while (pass < 2) {
    let i: i32 = 0;
    while (i < sl.field_names.len()) {
      let fi: i32 = field_index(ssig, sl.field_names[i]);
      let binds: boolean = fi >= 0 && fi < ssig.field_type_names.len() && typed_int_field(sl.field_values[i], s) == (pass == 0);
      if let ast.ExprArray(ea) = sl.field_values[i] {
        if (ea.elements.len() == 0) {
          binds = false;
        }
      }
      if (binds) {
        let (bn2, bt2) = gc_bind_param(parser.parse_type_ref(ssig.field_type_names[fi]), check_expr(sl.field_values[i], s), ssig.type_params, s.type_names(), bn, bt);
        bn = bn2;
        bt = bt2;
      }
      i = i + 1;
    }
    pass = pass + 1;
  }
  let args: typeinfo.Type[] = [];
  for tp in ssig.type_params {
    let bi: i32 = util.index_of_str(bn, tp);
    if (bi >= 0) {
      args = args.append(literal_bound_width(sl, ssig, tp, bt[bi], s));
    } else {
      args = args.append(t_unknown("unbound " + tp));
    }
  }
  return args;
}

function typed_int_field(e: ast.Expr, s: Scope): boolean {
  return !int_literal_tree(e) && is_integer(check_expr(e, s));
}

function written_struct_args(sl: ast.ExprStructLit, ssig: StructSig, s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  if (sl.written.len() == 0) {
    return out;
  }
  let wref: parser.TypeRef = parser.parse_type_ref(sl.written);
  if (wref.args.len() != ssig.type_params.len()) {
    return out;
  }
  for a in wref.args {
    out = out.append(type_from_ref_subst(a, [], [], s.type_names()));
  }
  return out;
}

function literal_bound_width(sl: ast.ExprStructLit, ssig: StructSig, tp: string, bound: typeinfo.Type, s: Scope): typeinfo.Type {
  let lit: ast.Expr[] = [sl];
  let es: ast.Expr[] = struct_param_exprs(ssig, tp, lit, s);
  if (es.len() == 0) {
    return bound;
  }
  for e in es {
    if (!int_literal_tree(e)) {
      return bound;
    }
  }
  for e in es {
    if (wide_int_tree(e)) {
      return t_i64();
    }
  }
  return bound;
}

function struct_param_exprs(ssig: StructSig, tp: string, es: ast.Expr[], s: Scope): ast.Expr[] {
  let out: ast.Expr[] = [];
  let fi: i32 = 0;
  while (fi < ssig.field_names.len() && fi < ssig.field_type_names.len()) {
    let vals: ast.Expr[] = [];
    for e in es {
      if let ast.ExprStructLit(sl) = e {
        if (sl.type_name == ssig.name && sl.written.len() == 0) {
          let i: i32 = 0;
          while (i < sl.field_names.len()) {
            if (sl.field_names[i] == ssig.field_names[fi]) {
              vals = vals.append(sl.field_values[i]);
            }
            i = i + 1;
          }
        }
      }
    }
    out = util.append_all(out, param_exprs(parser.parse_type_ref(ssig.field_type_names[fi]), tp, vals, s));
    fi = fi + 1;
  }
  return out;
}

function param_exprs(tr: parser.TypeRef, tp: string, es: ast.Expr[], s: Scope): ast.Expr[] {
  let out: ast.Expr[] = [];
  if (es.len() == 0) {
    return out;
  }
  if (tr.array_depth > 0 || tr.is_view) {
    let elems: ast.Expr[] = [];
    for e in es {
      if let ast.ExprArray(ea) = e {
        elems = util.append_all(elems, ea.elements);
      }
    }
    if (tr.is_view) {
      return param_exprs(tr.args[0], tp, elems, s);
    }
    return param_exprs(parser.elem_type_ref(tr), tp, elems, s);
  }
  if (tr.is_tuple) {
    let ti: i32 = 0;
    while (ti < tr.args.len()) {
      let elems: ast.Expr[] = [];
      for e in es {
        if let ast.ExprTuple(et) = e {
          if (ti < et.elements.len()) {
            elems = elems.append(et.elements[ti]);
          }
        }
      }
      out = util.append_all(out, param_exprs(tr.args[ti], tp, elems, s));
      ti = ti + 1;
    }
    return out;
  }
  if (tr.is_fn) {
    return out;
  }
  if (tr.args.len() == 0) {
    if (tr.base == tp) {
      return es;
    }
    return out;
  }
  let inner: StructSig = s.lookup_struct(tr.base);
  if (inner.name.len() == 0 || inner.type_params.len() != tr.args.len()) {
    return out;
  }
  let k: i32 = 0;
  while (k < inner.type_params.len()) {
    out = util.append_all(out, param_exprs(tr.args[k], tp, struct_param_exprs(inner, inner.type_params[k], es, s), s));
    k = k + 1;
  }
  return out;
}

function widened_field_type(sig: StructSig, j: i32, largs: typeinfo.Type[], s: Scope): typeinfo.Type {
  let want: typeinfo.Type = type_from_ref_subst(parser.parse_type_ref(sig.field_type_names[j]), sig.type_params, largs, s.type_names());
  if (reads_i64(want)) {
    return want;
  }
  return t_unknown("no field");
}

function reads_i64(t: typeinfo.Type): boolean {
  if (type_to_irtag(t) == "i64") {
    return true;
  }
  if let typeinfo.TypeArray(at) = t {
    return reads_i64(at.elem);
  }
  let parts: typeinfo.Type[] = [];
  if let typeinfo.TypeStruct(st) = t {
    parts = st.args;
  }
  if let typeinfo.TypeTuple(tt) = t {
    parts = tt.elements;
  }
  for p in parts {
    if (reads_i64(p)) {
      return true;
    }
  }
  return false;
}

function lit_uninferable_param(sl: ast.ExprStructLit, ssig: StructSig, args: typeinfo.Type[], s: Scope): string {
  if (sl.has_base) {
    return "";
  }
  let i: i32 = 0;
  while (i < ssig.type_params.len() && i < args.len()) {
    if (is_unknown(args[i])) {
      let tp: string = ssig.type_params[i];
      let spellings: string[] = [];
      for fname in sl.field_names {
        let fi: i32 = field_index(ssig, fname);
        if (fi >= 0 && fi < ssig.field_type_names.len()) {
          spellings = spellings.append(ssig.field_type_names[fi]);
        } else {
          spellings = spellings.append("");
        }
      }
      let (named, all_empty) = empty_array_positions(spellings, sl.field_values, tp, s);
      if (named && all_empty) {
        return tp;
      }
    }
    i = i + 1;
  }
  return "";
}

function lit_field_clash(sl: ast.ExprStructLit, ssig: StructSig, args: typeinfo.Type[], s: Scope): i32 {
  let i: i32 = 0;
  while (i < sl.field_names.len()) {
    let fi: i32 = field_index(ssig, sl.field_names[i]);
    if (fi >= 0) {
      let ft: typeinfo.Type = lit_field_type(ssig, fi, args, s);
      let vt: typeinfo.Type = check_expr(sl.field_values[i], s);
      if (!type_contains_unknown(ft) && !is_unknown(vt) && !settles_to(sl.field_values[i], ft, s) && !coercible(vt, ft, s)) {
        return i;
      }
    }
    i = i + 1;
  }
  return 0 - 1;
}

function projected_ret(ret_name: string, bn: string[], bt: typeinfo.Type[], s: Scope): typeinfo.Type {
  let names: string[] = [];
  let spells: string[] = [];
  let i: i32 = 0;
  while (i < bn.len()) {
    if (!type_contains_unknown(bt[i])) {
      names = names.append(bn[i]);
      spells = spells.append(typeinfo.spelling(bt[i]));
    }
    i = i + 1;
  }
  let resolved: string = parser.resolve_proj_in_type(parser.subst_ty(ret_name, names, spells), s.impls);
  if (util.contains(resolved, "::")) {
    return t_unknown("unresolved projection " + resolved);
  }
  return s.resolve_type(resolved);
}

function check_expr(e: ast.Expr, s: Scope): typeinfo.Type {
  match (e) {
    ast.ExprNumber(n) => {
      return check_number_expr(n, s);
    },
    ast.ExprBool(_) => {
      return t_bool();
    },
    ast.ExprString(_) => {
      return t_string();
    },
    ast.ExprIdent(id) => {
      return check_ident_expr(id, s);
    },
    ast.ExprBinary(b) => {
      return check_binary_expr(b, s);
    },
    ast.ExprUnary(u) => {
      return check_unary_expr(u, s);
    },
    ast.ExprCall(c) => {
      return check_call_expr(c, s);
    },
    ast.ExprTuple(t) => {
      let elems: typeinfo.Type[] = [];
      for element in t.elements {
        elems = elems.append(check_expr(element, s));
      }
      return t_tuple(elems);
    },
    ast.ExprArray(a) => {
      return check_array_expr(a, s);
    },
    ast.ExprBytes(_) => {
      return t_array(t_u8());
    },
    ast.ExprIndex(x) => {
      return check_index_expr(x, s);
    },
    ast.ExprSlice(sl) => {
      return check_slice_expr(sl, s);
    },
    ast.ExprStructLit(sl) => {
      return check_struct_lit_expr(sl, s);
    },
    ast.ExprFieldAccess(fa) => {
      return check_field_access_expr(fa, s);
    },
    ast.ExprLambda(lm) => {
      return check_lambda_expr(lm, s);
    },
    ast.ExprMapLit(_) => {
      return t_unknown("Map literal: formatter-only node");
    },
    ast.ExprFString(_) => {
      return t_unknown("f-string: formatter-only node");
    },
    ast.ExprUnknown(u) => {
      return t_unknown("parser-side unknown:" + u.kind);
    },
    ast.ExprZero(z) => {
      return s.resolve_type(z.type_name);
    }
  }
  return t_unknown("unhandled Expr variant");
}

function check_number_expr(n: ast.ExprNumber, s: Scope): typeinfo.Type {
  if (parser.is_unit_literal(n)) {
    return t_void();
  }
  if (n.is_float && n.suffix == "f32") {
    return t_f32();
  }
  if (n.is_float && n.suffix == "f64") {
    return typeinfo.TypeFloat { width: 64, polymorphic: false };
  }
  if (n.is_float) {
    return typeinfo.TypeFloat { width: 64, polymorphic: true };
  }
  if (n.suffix == "i64") {
    return t_i64();
  }
  if (n.suffix == "u64") {
    return t_u64();
  }
  if (n.suffix == "u32") {
    return t_u32();
  }
  if (n.suffix == "u8") {
    return t_u8();
  }
  if (n.suffix == "usize") {
    return t_usize();
  }
  if (n.suffix == "i32") {
    return t_i32();
  }
  if (n.suffix == "char") {
    return t_char();
  }
  if (parser.literal_is_i64(n.text)) {
    return t_i64();
  }
  return t_i32();
}

function check_ident_expr(id: ast.ExprIdent, s: Scope): typeinfo.Type {
  let bi: i32 = s.binding_index(id.name);
  if (bi >= 0 && !is_unknown(s.types[bi])) {
    return s.types[bi];
  }
  if (!s.has_sig(id.name) && s.variant_ambiguous(id.name)) {
    return t_unknown("ambiguous variant `" + id.name + "`");
  }
  let un: string = scope_variant_owner(id.name, s);
  if (un.len() > 0 && !s.has_sig(id.name) && variant_value_payloads(s, "", id.name) == 0) {
    return t_union(un);
  }
  if (is_nopayload_builtin_variant(id.name) && !s.has_sig(id.name)) {
    return t_union(parser.builtin_enum_of(id.name));
  }
  let csig: FuncSig = s.lookup_sig(id.name);
  if (csig.is_const) {
    return csig.ret_type;
  }
  if (csig.name.len() > 0 && bi < 0) {
    return t_func_own(csig.param_types, csig.param_own, csig.ret_type);
  }
  if (bi >= 0) {
    return s.types[bi];
  }
  return t_unknown("undefined identifier:" + id.name);
}

function check_binary_expr(b: ast.ExprBinary, s: Scope): typeinfo.Type {
  if (b.op == "__named_arg") {
    return check_expr(b.right, s);
  }
  return binary_result_type(b, check_expr(b.left, s), check_expr(b.right, s), s);
}

function binary_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): typeinfo.Type {
  let (sl, sr) = settled_operands(b, lt, rt);
  return operator_result_type(b, sl, sr, s);
}

function lanes_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): typeinfo.Type {
  if (util.has_str(["==", "!=", "<", ">", "<=", ">="], b.op)) {
    return t_bool();
  }
  if (util.has_str(["+", "-", "*", "/"], b.op) && type_eq(lt, rt)) {
    return lt;
  }
  return t_unknown("lane operands need one lane type and an arithmetic operator");
}

function operator_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): typeinfo.Type {
  if (is_lanes(lt) || is_lanes(rt)) {
    return lanes_result_type(b, lt, rt);
  }
  if (b.op == "+") {
    if (type_eq(lt, t_string()) && type_eq(rt, t_string())) {
      return t_string();
    }
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    if (float_operands_agree(lt, rt)) {
      return float_result(lt, rt);
    }
    let povt: typeinfo.Type = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(povt)) {
      return povt;
    }
    return t_unknown("`+` operands type mismatch");
  }
  if (b.op == "+|" || b.op == "-|" || b.op == "*|" || b.op == "<<|") {
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    return t_unknown("`" + b.op + "` operands must both be integers");
  }
  if (b.op == "+?" || b.op == "-?" || b.op == "*?" || b.op == "/?" || b.op == "%?" || b.op == "<<?" || b.op == ">>?") {
    if (is_integer(lt) && is_integer(rt)) {
      let chkoa: typeinfo.Type[] = [int_result(lt, rt, b.left, b.right)];
      return t_union_g("Option", chkoa);
    }
    return t_unknown("`" + b.op + "` operands must both be integers");
  }
  if (b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%") {
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    if (b.op != "%" && float_operands_agree(lt, rt)) {
      return float_result(lt, rt);
    }
    let aovt: typeinfo.Type = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(aovt)) {
      return aovt;
    }
    return t_unknown("arithmetic op `" + b.op + "` requires matching i32 or f64 operands");
  }
  return bitwise_result_type(b, lt, rt, s);
}

function bitwise_result_type(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): typeinfo.Type {
  if (b.op == "&" || b.op == "|" || b.op == "^") {
    if (is_integer(lt) && is_integer(rt)) {
      return int_result(lt, rt, b.left, b.right);
    }
    let bovt: typeinfo.Type = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(bovt)) {
      return bovt;
    }
    return t_unknown("bitwise operands must both be integers");
  }
  if (b.op == "<<" || b.op == ">>") {
    if (is_integer(lt) && is_integer(rt)) {
      if (int_literal_tree(b.left) && !int_literal_tree(b.right) || unsettled_int_literal(b.left)) {
        return rt;
      }
      return lt;
    }
    let sovt: typeinfo.Type = s.binop_overload_ret(b.op, lt);
    if (!is_unknown(sovt)) {
      return sovt;
    }
    return t_unknown("shift operands must both be integers");
  }
  if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
    if (is_integer(lt) && is_integer(rt)) {
      return t_bool();
    }
    if (type_eq(lt, t_char()) && type_eq(rt, t_char())) {
      return t_bool();
    }
    if (float_operands_agree(lt, rt)) {
      return t_bool();
    }
    if (type_eq(lt, t_string()) && type_eq(rt, t_string())) {
      return t_bool();
    }
    if (s.orders_alike(lt, rt)) {
      return t_bool();
    }
    return t_unknown("comparison op `" + b.op + "` requires matching i32, f64, string or `Ord` operands");
  }
  if (b.op == "==" || b.op == "!=") {
    if (float_operands_agree(lt, rt)) {
      return t_bool();
    }
    if (type_eq(lt, rt) && !is_unknown(lt)) {
      return t_bool();
    }
    if (is_integer(lt) && is_integer(rt)
      && (int_literal_tree(b.left) || int_literal_tree(b.right) || !is_unknown(scalar_numeric_join(lt, rt)))) {
      return t_bool();
    }
    return t_unknown("equality op `" + b.op + "` requires same-typed operands");
  }
  if (b.op == "&&" || b.op == "||") {
    if (type_eq(lt, t_bool()) && type_eq(rt, t_bool())) {
      return t_bool();
    }
    return t_unknown("logical op `" + b.op + "` requires bool operands");
  }
  return t_unknown("unknown binary op:" + b.op);
}

function check_unary_expr(u: ast.ExprUnary, s: Scope): typeinfo.Type {
  return unary_result_type(u, check_expr(u.operand, s), s);
}

function unary_result_type(u: ast.ExprUnary, ot: typeinfo.Type, s: Scope): typeinfo.Type {
  if (u.op == "-" && unsettled_int_literal(ast.ExprUnary { ...u })) {
    if let ast.ExprNumber(_) = u.operand {
      return t_i32();
    }
  }
  if (u.op == "-") {
    if (is_integer(ot)) {
      return ot;
    }
    if (is_float(ot) || is_lanes(ot)) {
      return ot;
    }
    let novt: typeinfo.Type = s.unop_overload_ret(u.op, ot);
    if (!is_unknown(novt)) {
      return novt;
    }
    return t_unknown("unary `-` requires i32 or f64 operand");
  }
  if (u.op == "!") {
    if (type_eq(ot, t_bool())) {
      return t_bool();
    }
    return t_unknown("unary `!` requires bool operand");
  }
  if (u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as_") {
    return s.resolve_type(slice_unchecked(u.op, 3, u.op.len()) + "");
  }
  if (u.op == "try_") {
    return try_success_type(s, ot);
  }
  if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
    return typeinfo.TypeUnion { name: "Option", args: [s.resolve_type(slice_unchecked(u.op, 4, u.op.len()) + "")] };
  }
  return t_unknown("unknown unary op:" + u.op);
}

function vaguer_than(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if (type_contains_unknown(a) && !type_contains_unknown(b)) {
    return true;
  }
  if let typeinfo.TypeUnion(ua) = a {
    if let typeinfo.TypeUnion(ub) = b {
      return ua.name == ub.name && ua.args.len() == 0 && ub.args.len() > 0;
    }
  }
  if let typeinfo.TypeArray(xa) = a {
    if let typeinfo.TypeArray(xb) = b {
      return vaguer_than(xa.elem, xb.elem);
    }
  }
  return false;
}

function check_array_expr(a: ast.ExprArray, s: Scope): typeinfo.Type {
  if (a.elements.len() == 0) {
    if (a.elem_ty.len() > 0) {
      return t_array(s.resolve_type(a.elem_ty));
    }
    return t_array(t_unknown("empty array literal"));
  }
  let first: typeinfo.Type = check_expr(a.elements[0], s);
  let first_lit: i32 = numeric_literal_kind(a.elements[0]);
  let first_expr: ast.Expr = a.elements[0];
  for i in 1..a.elements.len() {
    let et: typeinfo.Type = check_expr(a.elements[i], s);
    if (unbound_enum_argument(et)) {
      continue;
    }
    if (unbound_enum_argument(first)) {
      first = et;
      first_lit = numeric_literal_kind(a.elements[i]);
      first_expr = a.elements[i];
      continue;
    }
    let scalar: typeinfo.Type = scalar_numeric_join(first, et);
    if (!is_unknown(scalar) && !int_literal_tree(first_expr) && !int_literal_tree(a.elements[i])) {
      first = scalar;
      first_lit = 0;
      first_expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
      continue;
    }
    let lit: i32 = numeric_literal_kind(a.elements[i]);
    if (array_element_preferred(a.elements[i], et, lit, first_expr, first, first_lit, s)) {
      first = et;
      first_lit = lit;
      first_expr = a.elements[i];
    }
  }
  return t_array(first);
}

function struct_lit_gives_way(e: ast.Expr, from: typeinfo.Type, to: typeinfo.Type, s: Scope): boolean {
  return struct_lit_yields(e, from, to, s, false);
}

function struct_lit_yields(e: ast.Expr, from: typeinfo.Type, to: typeinfo.Type, s: Scope, to_float: boolean): boolean {
  if let ast.ExprStructLit(sl) = e {
    if let typeinfo.TypeStruct(fs) = from {
      if let typeinfo.TypeStruct(ts) = to {
        let sig: StructSig = s.lookup_struct(sl.type_name);
        if (sl.written.len() > 0 || fs.name != ts.name || fs.args.len() != ts.args.len() || sig.type_params.len() != fs.args.len()) {
          return false;
        }
        let lit: ast.Expr[] = [sl];
        let differs: boolean = false;
        let k: i32 = 0;
        while (k < fs.args.len()) {
          if (typeinfo.spelling(fs.args[k]) != typeinfo.spelling(ts.args[k])) {
            let es: ast.Expr[] = struct_param_exprs(sig, sig.type_params[k], lit, s);
            if (es.len() == 0 || !is_integer(ts.args[k]) && !(to_float && is_float(ts.args[k]))) {
              return false;
            }
            for pe in es {
              if (!int_literal_tree(pe)) {
                return false;
              }
            }
            differs = true;
          }
          k = k + 1;
        }
        return differs;
      }
    }
  }
  return false;
}

function check_index_expr(x: ast.ExprIndex, s: Scope): typeinfo.Type {
  return index_result_type(check_expr(x.array, s), check_expr(x.index, s));
}

function index_result_type(at: typeinfo.Type, it: typeinfo.Type): typeinfo.Type {
  if (!is_integer(it)) {
    return t_unknown("array index must be an integer");
  }
  match (at) {
    typeinfo.TypeArray(ta) => {
      return ta.elem;
    },
    typeinfo.TypeString(_) => {
      return t_u8();
    },
    _ => {
      return t_unknown("can only index into an array or string");
    }
  }
  return t_unknown("unreachable index arm");
}

function check_slice_expr(sl: ast.ExprSlice, s: Scope): typeinfo.Type {
  let at: typeinfo.Type = check_expr(sl.array, s);
  let st: typeinfo.Type = check_expr(sl.start, s);
  let et: typeinfo.Type = check_expr(sl.end, s);
  if (!is_integer(st)) {
    return t_unknown("slice start must be i32");
  }
  if (!is_integer(et)) {
    return t_unknown("slice end must be i32");
  }
  match (at) {
    typeinfo.TypeArray(_) => {
      return as_view(at);
    },
    typeinfo.TypeString(_) => {
      let slcoa: typeinfo.Type[] = [t_str()];
      return t_union_g("Option", slcoa);
    },
    _ => {
      return t_unknown("can only slice array or string");
    }
  }
  return t_unknown("unreachable slice arm");
}

function check_struct_lit_expr(sl: ast.ExprStructLit, s: Scope): typeinfo.Type {
  let ssig: StructSig = s.lookup_struct(sl.type_name);
  if (ssig.name.len() == 0) {
    return t_unknown("undefined struct: " + sl.type_name);
  }
  if (sl.has_base) {
    let bt: typeinfo.Type = check_expr(sl.base, s);
    if (!type_eq(bt, t_struct(sl.type_name))) {
      return t_unknown("struct " + sl.type_name + " update base type mismatch");
    }
    let ui: i32 = 0;
    while (ui < sl.field_names.len()) {
      let uname: string = sl.field_names[ui];
      let found: boolean = false;
      let ufi: i32 = 0;
      while (ufi < ssig.field_names.len()) {
        if (ssig.field_names[ufi] == uname) {
          found = true;
          let uft: typeinfo.Type = check_expr(sl.field_values[ui], s);
          if (!type_contains_unknown(ssig.field_types[ufi])
            && !settles_to(sl.field_values[ui], ssig.field_types[ufi], s)
            && !coercible(uft, ssig.field_types[ufi], s)) {
            return t_unknown("struct " + sl.type_name + " field `" + uname + "` type mismatch");
          }
        }
        ufi = ufi + 1;
      }
      if (!found) {
        return t_unknown("struct " + sl.type_name + " has no field `" + uname + "`");
      }
      ui = ui + 1;
    }
    return bt;
  }
  if (sl.field_names.len() != ssig.field_names.len()) {
    return t_unknown("struct " + sl.type_name + " field count mismatch");
  }
  let swritten: boolean[] = __alloc_bool(ssig.field_names.len());
  let sli: i32 = 0;
  while (sli < sl.field_names.len()) {
    let sfi: i32 = field_index(ssig, sl.field_names[sli]);
    if (sfi < 0) {
      return t_unknown("struct " + sl.type_name + " has no field `" + sl.field_names[sli] + "`");
    }
    if (swritten[sfi]) {
      return t_unknown("struct " + sl.type_name + " field `" + sl.field_names[sli] + "` written twice");
    }
    swritten = swritten.with(sfi, true);
    let ft: typeinfo.Type = check_expr(sl.field_values[sli], s);
    if (!type_contains_unknown(ssig.field_types[sfi])
      && !settles_to(sl.field_values[sli], ssig.field_types[sfi], s)
      && !coercible(ft, ssig.field_types[sfi], s)) {
      return t_unknown("struct " + sl.type_name + " field `" + sl.field_names[sli] + "` type mismatch");
    }
    sli = sli + 1;
  }
  if (ssig.type_params.len() == 0) {
    return t_struct(sl.type_name);
  }
  let largs: typeinfo.Type[] = struct_lit_args(sl, ssig, s);
  if (lit_uninferable_param(sl, ssig, largs, s).len() > 0) {
    return t_unknown("struct " + sl.type_name + " has a type argument nothing binds");
  }
  if (lit_field_clash(sl, ssig, largs, s) >= 0) {
    return t_unknown("struct " + sl.type_name + " fields disagree on a type argument");
  }
  return typeinfo.TypeStruct { name: sl.type_name, args: largs };
}

function check_field_access_expr(fa: ast.ExprFieldAccess, s: Scope): typeinfo.Type {
  let vqu: string = qual_variant_union(fa, s);
  if (vqu.len() > 0) {
    return t_union(vqu);
  }
  return field_access_result_type(fa, check_expr(fa.obj, s), s);
}

function field_access_result_type(fa: ast.ExprFieldAccess, ot: typeinfo.Type, s: Scope): typeinfo.Type {
  if (fa.field == "fd" && semtypes.is_fd_handle(ot)) {
    return t_i32();
  }
  match (ot) {
    typeinfo.TypeStruct(sn) => {
      return struct_field_type(sn, fa.field, s);
    },
    typeinfo.TypeTuple(tt) => {
      let idx: i32 = digit_string_to_i32(fa.field);
      if (idx < 0 || idx >= tt.elements.len()) {
        return t_unknown("tuple index `" + fa.field + "` out of range");
      }
      return tt.elements[idx];
    },
    _ => {
      return t_unknown("can only field-access a struct or tuple");
    }
  }
  return t_unknown("unreachable field-access arm");
}

function struct_field_type(sn: typeinfo.TypeStruct, field: string, s: Scope): typeinfo.Type {
  let fsig: StructSig = s.lookup_struct(sn.name);
  if (fsig.name.len() == 0) {
    return t_unknown("undefined struct: " + sn.name);
  }
  let fai: i32 = field_index(fsig, field);
  if (fai < 0) {
    return t_unknown("struct " + sn.name + " has no field `" + field + "`");
  }
  if (fai < fsig.field_type_names.len() && fsig.type_params.len() > 0 && sn.args.len() > 0) {
    let fref: parser.TypeRef = parser.parse_type_ref(fsig.field_type_names[fai]);
    if (sn.args.len() != fsig.type_params.len()) {
      return type_from_ref_subst(fref, fsig.type_params, rigid_tparams(fsig.type_params), s.type_names());
    }
    return type_from_ref_subst(fref, fsig.type_params, sn.args, s.type_names());
  }
  return fsig.field_types[fai];
}

function check_lambda_expr(lm: ast.ExprLambda, s: Scope): typeinfo.Type {
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(s.resolve_param(param));
  }
  let rt: typeinfo.Type = lambda_ret_type(lm, s);
  let body_scope: Scope = lambda_body_scope(lm, s);
  check_block(lm.body, body_scope);
  if (lm.ret_type.len() == 0 && is_unknown(rt)) {
    let (returned, at) = first_returned(lm.body, body_scope);
    if (!parser.bare_return(returned)) {
      let inferred: typeinfo.Type = check_expr(returned, at);
      if (!is_unknown(inferred)) {
        rt = inferred;
      }
    } else if (!parser.is_value_block_origin(lm.origin)) {
      rt = t_void();
    }
  }
  return t_func_own(pts, lambda_owns(lm), rt);
}

pub struct CheckResult { scope: Scope, ty: typeinfo.Type }

pub function check_stmt(st: ast.Stmt, s: Scope): CheckResult {
  match (st) {
    ast.StmtDefer(d) => {
      return check_stmt(d.action, s);
    },
    ast.StmtVar(v) => {
      let init_scope: Scope = rec_local_scope(v, s);
      let t: typeinfo.Type = check_expr(v.init, init_scope);
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return CheckResult { scope: bind_destructure_names(s, v), ty: t };
      }
      if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name)) {
        let declared: typeinfo.Type = var_declared_type(v, s);
        if (is_unknown(declared)) {
          return CheckResult { scope: s.bind(v.name, declared), ty: declared };
        }
        if (!init_fits(v.init, t, declared, init_scope)) {
          let err: typeinfo.Type = t_unknown("var `" + v.name + "`: init type doesn't match annotation `" + v.type_name + "`");
          return CheckResult { scope: s.bind(v.name, declared), ty: err };
        }
        return CheckResult { scope: s.bind(v.name, declared), ty: declared };
      }
      return CheckResult { scope: s.bind_inferred(v, t), ty: t };
    },
    ast.StmtReturn(r) => {
      let bare_ret: boolean = false;
      match (r.value) {
        ast.ExprUnknown(bu) => {
          if (bu.kind == parser.BARE_RETURN) {
            bare_ret = true;
          }
        },
        _ => {}
      }
      if (bare_ret) {
        return CheckResult { scope: s, ty: t_void() };
      }
      let t: typeinfo.Type = check_expr(r.value, s);
      match (s.ret_type) {
        typeinfo.TypeUnknown(_) => {
          return CheckResult { scope: s, ty: t };
        },
        _ => {}
      }
      if (is_unknown(t)) {
        let (ret_block, is_block) = value_block_body(r.value);
        if (is_block && vb_settles(ret_block, s.ret_type, s) || (generic_fn_value_arg(r.value, s) || dest_bound_result(r.value, s)) && settles_to(r.value, s.ret_type, s)) {
          return CheckResult { scope: s, ty: s.ret_type };
        }
        return CheckResult { scope: s, ty: t };
      }
      if (!settles_to(r.value, s.ret_type, s) && !coercible(t, s.ret_type, s)) {
        return CheckResult { scope: s, ty: t_unknown("return type doesn't match declaration") };
      }
      return CheckResult { scope: s, ty: t };
    },
    ast.StmtExpr(x) => {
      let t: typeinfo.Type = check_expr(x.value, s);
      return CheckResult { scope: s, ty: t };
    },
    ast.StmtIf(ifs) => {
      let ct: typeinfo.Type = check_expr(ifs.cond, s);
      if (!type_eq(ct, t_bool())) {
        check_block(ifs.then_body, s);
        check_block(ifs.else_body, s);
        return CheckResult { scope: s, ty: t_unknown("if cond not bool") };
      }
      let thenOk: boolean = check_block(ifs.then_body, s);
      let elseOk: boolean = check_block(ifs.else_body, s);
      if (!thenOk || !elseOk) {
        return CheckResult { scope: s, ty: t_unknown("if: ill-typed branch") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtWhile(w) => {
      let wt: typeinfo.Type = check_expr(w.cond, s);
      let body_scope: Scope = s.enter_loop();
      if (!type_eq(wt, t_bool())) {
        check_block(w.body, body_scope);
        return CheckResult { scope: s, ty: t_unknown("while cond not bool") };
      }
      let bodyOk: boolean = check_block(w.body, body_scope);
      if (!bodyOk) {
        return CheckResult { scope: s, ty: t_unknown("while: ill-typed body") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtAssign(a) => {
      let existing: typeinfo.Type = s.lookup(a.target);
      if (is_unknown(existing)) {
        return CheckResult { scope: s, ty: t_unknown("assign to undefined `" + a.target + "`") };
      }
      let vt: typeinfo.Type = check_expr(a.value, s);
      if (is_unknown(vt)) {
        return CheckResult { scope: s, ty: vt };
      }
      if (!settles_to(a.value, existing, s) && !coercible(vt, existing, s)) {
        return CheckResult { scope: s, ty: t_unknown("type mismatch in assign to `" + a.target + "`") };
      }
      return CheckResult { scope: s, ty: vt };
    },
    ast.StmtMatch(m) => {
      let sct: typeinfo.Type = check_expr(m.scrutinee, s);
      let ok: boolean = !is_unknown(sct);
      let union_name: string = "";
      let struct_name: string = "";
      match (sct) {
        typeinfo.TypeUnion(u) => {
          union_name = u.name;
        },
        typeinfo.TypeStruct(sn) => {
          struct_name = sn.name;
        },
        _ => {}
      }
      for arm in m.arms {
        let armScope: Scope = s;
        match (arm.pattern) {
          ast.PatWildcard(_) => {},
          ast.PatVariant(pv) => {
            let pvn: string = variant_pattern_name(pv.type_name);
            let ss: StructSig = s.lookup_variant(pvn);
            let builtin_arm: boolean = union_name.len() > 0 && parser.builtin_enum_of(pvn) == union_name;
            if (ss.name.len() == 0 && !builtin_arm) {
              ok = false;
            } else {
              if (union_name.len() > 0) {
                if (!builtin_arm && !is_variant_of(pvn, union_name, s.unions.unions)) {
                  ok = false;
                }
              } else if (struct_name.len() > 0) {
                if (struct_name != pvn) {
                  ok = false;
                }
              }
              armScope = bind_variant_payloads(armScope, s, pv, sct);
            }
          }
        }
        if (!check_block(arm.body, armScope)) {
          ok = false;
        }
      }
      if (!ok) {
        return CheckResult { scope: s, ty: t_unknown("match: ill-typed arm or scrutinee") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtBreak(_) => {
      if (s.loop_depth == 0) {
        return CheckResult { scope: s, ty: t_unknown("break outside loop") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtContinue(_) => {
      if (s.loop_depth == 0) {
        return CheckResult { scope: s, ty: t_unknown("continue outside loop") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtFor(f) => {
      let binding = for_binding(f, s);
      let fOk: boolean = check_block(f.body, binding.scope);
      if (!binding.valid) {
        return CheckResult { scope: s, ty: t_unknown("for-in: invalid iterator binding") };
      }
      if (!fOk) {
        return CheckResult { scope: s, ty: t_unknown("for-in: ill-typed body") };
      }
      return CheckResult { scope: s, ty: t_bool() };
    },
    ast.StmtUnknown(u) => {
      return CheckResult { scope: s, ty: t_unknown("parser-side unknown stmt:" + u.kind) };
    }
  }
  return CheckResult { scope: s, ty: t_unknown("unhandled Stmt variant") };
}

pub function bind_stmt(st: ast.Stmt, s: Scope): Scope {
  match (st) {
    ast.StmtDefer(d) => {
      return bind_stmt(d.action, s);
    },
    ast.StmtVar(v) => {
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return bind_destructure_names(s, v);
      }
      if (v.type_name.len() > 0) {
        return s.bind(v.name, var_declared_type(v, s));
      }
      return s.bind_inferred(v, check_expr(v.init, rec_local_scope(v, s)));
    },
    _ => {}
  }
  return s;
}

function check_block(body: ast.Stmt[], s: Scope): boolean {
  let cur: Scope = s;
  let ok: boolean = true;
  for stmt in body {
    let r: CheckResult = check_stmt(stmt, cur);
    cur = r.scope;
    if (is_unknown(r.ty)) {
      ok = false;
    }
  }
  return ok;
}

pub struct ProgramTypes { tys: typeinfo.Type[] }

function check_program(prog: ast.Stmt[]): ProgramTypes {
  let s: Scope = new_scope();
  let tys: typeinfo.Type[] = [];
  for stmt in prog {
    let r: CheckResult = check_stmt(stmt, s);
    s = r.scope;
    tys = tys.append(r.ty);
  }
  return ProgramTypes { tys: tys };
}

function func_ret_type(fd: parser.FuncDecl, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  if (fd.ret_fn_ret.len() > 0 && parser.is_fn_contract_tag(fd.ret_type)) {
    return declared_callable_type(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types, tparams, subst, tn);
  }
  return type_from_name_subst(fd.ret_type, tparams, subst, tn);
}

function lambda_fn_type(lm: ast.ExprLambda, s: Scope): typeinfo.Type {
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(s.resolve_param(param));
  }
  return t_func_own(pts, lambda_owns(lm), lambda_ret_type(lm, s));
}

function rec_local_name(v: ast.StmtVar): string {
  if (ast.var_binds_itself(v)) {
    return v.name;
  }
  return "";
}

function rec_local_scope(v: ast.StmtVar, s: Scope): Scope {
  if let ast.ExprLambda(lm) = v.init {
    if (ast.var_binds_itself(v)) {
      return s.bind(v.name, lambda_fn_type(lm, s));
    }
  }
  return s;
}

function bind_mutual_siblings(stmts: ast.Stmt[], s: Scope): Scope {
  let fns: parser.NestedFn[] = parser.nested_fns(stmts);
  let out: Scope = s;
  for f in fns {
    if (parser.nested_fn_cycle(fns, f.name).len() > 1) {
      out = out.bind(f.name, lambda_fn_type(f.lam, s));
    }
  }
  return out;
}

const INFERRED_RESULT: string = "inferred lambda result";

function lambda_ret_type(lm: ast.ExprLambda, s: Scope): typeinfo.Type {
  if (lm.ret_type.len() == 0) {
    if (lm.origin == parser.ORIGIN_USE && !is_unknown(s.ret_type)) {
      return s.ret_type;
    }
    return t_unknown(INFERRED_RESULT);
  }
  if (lm.ret_fn_ret.len() > 0 && parser.is_fn_contract_tag(lm.ret_type)) {
    return declared_callable_type(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types, s.tparams, rigid_tparams(s.tparams), s.type_names());
  }
  return s.resolve_type(lm.ret_type);
}

function var_declared_type(v: ast.StmtVar, s: Scope): typeinfo.Type {
  if (v.fn_ret.len() > 0 && parser.is_fn_contract_tag(v.type_name)) {
    return declared_callable_type(v.type_name, v.fn_ret, v.fn_param_types, s.tparams, rigid_tparams(s.tparams), s.type_names());
  }
  return s.resolve_type(v.type_name);
}

function collect_func_sigs(funcs: parser.FuncDecl[], tn: TypeNames): FuncSig[] {
  let out: FuncSig[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let fd: parser.FuncDecl = funcs[i];
    if (fd.receiver_name.len() > 0) {
      i = i + 1;
      continue;
    }
    let pts: typeinfo.Type[] = [];
    let powns: boolean[] = [];
    let ptn: string[] = [];
    for param in fd.params {
      pts = pts.append(param_decl_type(param, fd.type_params, erased_tparams(fd.type_params), tn));
      powns = powns.append(param.own);
      ptn = ptn.append(parser.fn_tag_spelling(param.type_name, param.fn_ret, param.fn_param_types));
    }
    let tvs: string[] = [];
    for spelling in ptn {
      if (util.index_of_str(tvs, spelling) < 0 && gc_is_typevar_name(spelling, fd.type_params, tn)) {
        tvs = tvs.append(spelling);
      }
    }
    let rtn: string = parser.fn_tag_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types);
    out = out.append(FuncSig { receiver: fd.receiver_type, name: fd.name, param_types: pts, param_own: callable_own_flags(powns, pts.len()), ret_type: func_ret_type(fd, fd.type_params, erased_tparams(fd.type_params), tn), all_type_params: fd.all_type_params, type_params: fd.type_params, type_bounds: fd.bound_traits, ret_type_name: rtn, param_type_names: ptn, param_names: param_decl_names(fd.params), is_const: fd.is_const, typevars: tvs, module: fd.module, refs: generic_sig_refs(fd.all_type_params, ptn, rtn) });
    i = i + 1;
  }
  return out;
}

struct MethodBinding { names: string[], types: typeinfo.Type[], full: string[] }

function method_binding(c: ast.ExprCall, msig: MethodSig, recv: typeinfo.Type, s: Scope): MethodBinding {
  let rref: parser.TypeRef = parser.parse_type_ref(msig.receiver_type);
  let full: string[] = ref_type_vars(rref, msig.all_type_params, s, []);
  for tp in msig.all_type_params {
    if (!util.has_str(full, tp)) {
      full = full.append(tp);
    }
  }
  let names: string[] = [];
  let types: typeinfo.Type[] = [];
  let offset: i32 = full.len() - c.type_args.len();
  if (offset < 0) {
    offset = 0;
  }
  let wi: i32 = 0;
  while (wi < c.type_args.len() && offset + wi < full.len()) {
    if (c.type_args[wi].len() > 0) {
      names = names.append(full[offset + wi]);
      types = types.append(type_from_spelling(c.type_args[wi], s.type_names()));
    }
    wi = wi + 1;
  }
  let (n2, t2) = gc_bind_param(rref, recv, full, s.type_names(), names, types);
  if (full.len() == 0) {
    return MethodBinding { names: n2, types: t2, full: full };
  }
  let mi: i32 = 0;
  while (mi < c.args.len() && mi < msig.param_type_names.len()) {
    let ref = parser.parse_type_ref(msig.param_type_names[mi]);
    let dest = type_from_ref_subst(ref, n2, t2, s.type_names());
    let actual = fn_value_at(c.args[mi], dest, s);
    let (n3, t3) = gc_bind_param(ref, actual, full, s.type_names(), n2, t2);
    n2 = n3;
    t2 = t3;
    mi = mi + 1;
  }
  return MethodBinding { names: n2, types: t2, full: full };
}

function ref_type_vars(r: parser.TypeRef, tparams: string[], s: Scope, acc: string[]): string[] {
  let out: string[] = acc;
  if (r.args.len() == 0) {
    if (gc_is_typevar_name(r.base, tparams, s.type_names()) && (util.has_str(tparams, r.base) || !util.has_str(s.tparams, r.base)) && !util.has_str(out, r.base)) {
      out = out.append(r.base);
    }
    return out;
  }
  for a in r.args {
    out = ref_type_vars(a, tparams, s, out);
  }
  return out;
}

function method_arg_diags(c: ast.ExprCall, method: string, msig: MethodSig, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let rmb: MethodBinding = method_binding(c, msig, recv, s);
  let mi: i32 = 0;
  while (mi < c.args.len() && mi < msig.param_types.len()) {
    let mat: typeinfo.Type = check_expr(c.args[mi], s);
    let want: typeinfo.Type = receiver_bound(msig.param_types[mi], param_type_name_at(msig, mi), rmb, s);
    out = util.append_diags(out, int_dest_range_diags(c.args[mi], want));
    let unresolved_value: boolean = false;
    if (generic_fn_value_arg(c.args[mi], s)) {
      if let ast.ExprIdent(id) = c.args[mi] {
        if let typeinfo.TypeFunc(wf) = want {
          let sig: FuncSig = s.lookup_sig(id.name);
          let (bn, bt) = fn_value_binds(sig, wf, s);
          unresolved_value = bn.len() != sig.all_type_params.len();
        }
      }
    }
    if (!unresolved_value && !is_unknown(want) && !bound_arg_accepts(c.args[mi], mat, want, s) && !generic_own_callback_accepts(mat, want, rmb.names, param_type_name_at(msig, mi), s)) {
      out = out.append(dg_at("E038", "argument " + util.i32_to_string(mi + 1) + " to \"" + method + "\": expected " + type_label(want) + ", got " + type_label(mat), expr_line(c.args[mi]), expr_col(c.args[mi])));
    }
    out = util.append_diags(out, array_elem_check(array_elem_type_of(msig.param_types[mi]), c.args[mi], s));
    mi = mi + 1;
  }
  let (bn, bt) = bounds_bindings(msig.type_params, msig.type_bounds, msig.module, s, rmb.names, rmb.types);
  return util.append_diags(out, call_bound_diags(msig.type_params, msig.type_bounds, msig.module, method_site(recv, msig.receiver_type, method), bn, bt, s, c.line, c.col));
}

function method_site(recv: typeinfo.Type, owner: string, method: string): string {
  if (is_unknown(recv) || is_type_variable(recv)) {
    return method;
  }
  return util.demangle(method_count_subject(recv, owner, method));
}

function method_type_arg_diags(c: ast.ExprCall, method: string, msig: MethodSig, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.type_args.len() == 0) {
    return out;
  }
  let full: i32 = method_binding(c, msig, recv, s).full.len();
  if (c.type_args.len() > full) {
    out = out.append(dg_at("E040", util.arity_message(method_count_subject(recv, msig.receiver_type, method), full, c.type_args.len(), "type argument"), c.line, c.col));
  }
  return out;
}

function method_count_subject(recv: typeinfo.Type, owner: string, method: string): string {
  if let typeinfo.TypeArray(a) = recv {
    return (if (a.view) { "slice" } else { "Array" }) + "." + method;
  }
  return util.base_type_name(owner) + "." + method;
}

function generic_method_ret(c: ast.ExprCall, msig: MethodSig, mb: MethodBinding, s: Scope): typeinfo.Type {
  if (!type_contains_unknown(msig.ret_type) || msig.ret_type_name.len() == 0) {
    return msig.ret_type;
  }
  let bn: string[] = mb.names;
  let bt: typeinfo.Type[] = mb.types;
  let (bn3, bt3) = bounds_bindings(msig.type_params, msig.type_bounds, msig.module, s, bn, bt);
  bn = bn3;
  bt = bt3;
  for tp in mb.full {
    if (util.index_of_str(bn, tp) < 0) {
      bn = bn.append(tp);
      bt = bt.append(t_unknown(TPARAM_MARK + tp));
    }
  }
  if (bn.len() == 0) {
    return msig.ret_type;
  }
  return type_from_ref_subst(parser.parse_type_ref(msig.ret_type_name), bn, bt, s.type_names());
}

function receiver_bound(t: typeinfo.Type, spelling: string, mb: MethodBinding, s: Scope): typeinfo.Type {
  if (!type_contains_unknown(t) || spelling.len() == 0 || mb.names.len() == 0) {
    return t;
  }
  return type_from_ref_subst(parser.parse_type_ref(spelling), mb.names, mb.types, s.type_names());
}

function param_type_name_at(msig: MethodSig, i: i32): string {
  if (i < msig.param_type_names.len()) {
    return msig.param_type_names[i];
  }
  return "";
}

function same_nominal(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(au) = a {
    if let typeinfo.TypeUnion(bu) = b {
      return au.name == bu.name;
    }
  }
  if let typeinfo.TypeStruct(ast_) = a {
    if let typeinfo.TypeStruct(bs) = b {
      return ast_.name == bs.name;
    }
  }
  return false;
}

function nominal_args(t: typeinfo.Type): typeinfo.Type[] {
  if let typeinfo.TypeStruct(st) = t {
    return st.args;
  }
  if let typeinfo.TypeUnion(u) = t {
    return u.args;
  }
  if let typeinfo.TypeMap(m) = t {
    return [m.key, m.value];
  }
  return [];
}

function is_dyn_slot(t: typeinfo.Type): boolean {
  if let typeinfo.TypeDyn(_) = t {
    return true;
  }
  return false;
}

function fills_unsettled_argument(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(fu) = from {
    if let typeinfo.TypeUnion(tu) = to {
      if (fu.name != tu.name) {
        return false;
      }
      let i: i32 = 0;
      while (i < fu.args.len()) {
        let open: boolean = tu.args.len() == 0 || i < tu.args.len() && unbound_enum_argument(tu.args[i]);
        if (open && !is_unknown(fu.args[i])) {
          return true;
        }
        i = i + 1;
      }
    }
  }
  return false;
}

function nominal_args_clash(from: typeinfo.Type, to: typeinfo.Type, unions: UnionSig[]): boolean {
  if (!same_nominal(from, to)) {
    return false;
  }
  let fa: typeinfo.Type[] = nominal_args(from);
  let ta: typeinfo.Type[] = nominal_args(to);
  if (fa.len() != ta.len()) {
    return fa.len() > 0 && ta.len() > 0;
  }
  let i: i32 = 0;
  while (i < fa.len()) {
    if (!is_unknown(fa[i]) && !is_unknown(ta[i]) && !nested_assignable(fa[i], ta[i], unions)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function type_ref_names_any(r: parser.TypeRef, vars: string[]): boolean {
  if (util.has_str(vars, r.base)) {
    return true;
  }
  for a in r.args {
    if (type_ref_names_any(a, vars)) {
      return true;
    }
  }
  return false;
}

function collect_method_sigs(funcs: parser.FuncDecl[], tn: TypeNames): MethodSig[] {
  let out: MethodSig[] = [];
  for fd in funcs {
    if (fd.receiver_name.len() > 0) {
      let pts: typeinfo.Type[] = [];
      let ptn: string[] = [];
      for param in fd.params {
        pts = pts.append(param_decl_type(param, fd.type_params, erased_tparams(fd.type_params), tn));
        ptn = ptn.append(parser.fn_tag_spelling(param.type_name, param.fn_ret, param.fn_param_types));
      }
      let rtn: string = parser.fn_tag_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types);
      out = out.append(MethodSig { name: fd.name, receiver_type: receiver_namespace(fd.receiver_type), param_types: pts, ret_type: func_ret_type(fd, fd.type_params, erased_tparams(fd.type_params), tn), ret_type_name: rtn, param_type_names: ptn, all_type_params: fd.all_type_params, type_params: fd.type_params, type_bounds: fd.bound_traits, module: fd.module, impl_trait: fd.impl_trait, line: fd.line, col: fd.col, file: decl_file_label(fd) });
    }
  }
  return out;
}

function collect_struct_sigs(structs: parser.StructDecl[], union_names: string[], resources: string[]): StructSig[] {
  let out: StructSig[] = [];
  let unions: util.NameIndex = util.name_index(union_names);
  let names: string[] = [];
  for sd in structs {
    if (sd.enum_owner.len() == 0 || !unions.has(sd.name)) {
      names = names.append(sd.name);
    }
  }
  let tn: TypeNames = type_names(names, union_names, resources);
  for sd in structs {
    let fnames: string[] = [];
    let ftypes: typeinfo.Type[] = [];
    let ftnames: string[] = [];
    for elem in sd.fields {
      fnames = fnames.append(elem.name);
      if (elem.fn_ret.len() > 0 && parser.is_fn_contract_tag(elem.type_name)) {
        ftypes = ftypes.append(declared_callable_type(elem.type_name, elem.fn_ret, elem.fn_param_types, sd.type_params, erased_tparams(sd.type_params), tn));
      } else {
        ftypes = ftypes.append(type_from_spelling(elem.type_name, tn));
      }
      ftnames = ftnames.append(parser.fn_tag_spelling(elem.type_name, elem.fn_ret, elem.fn_param_types));
    }
    out = out.append(StructSig { name: sd.name, field_names: fnames, field_types: ftypes, type_params: sd.type_params, field_type_names: ftnames, variant_field_names: sd.variant_field_names, derives: sd.derives, enum_owner: sd.enum_owner, opaque: sd.opaque, module: sd.module });
  }
  return out;
}

pub function type_from_name_with_structs(name: string, structs: StructSig[]): typeinfo.Type {
  return type_from_spelling(name, type_names(struct_sig_names(structs), [], []));
}

pub function type_from_name_with_struct_names(name: string, struct_names: string[]): typeinfo.Type {
  return type_from_spelling(name, type_names(struct_names, [], []));
}

pub function type_from_name_with_structs_unions(name: string, structs: StructSig[], unions: UnionSig[]): typeinfo.Type {
  let union_names: string[] = union_sig_names(unions);
  return type_from_spelling(name, type_names(type_head_names(structs, union_names), union_names, []));
}

pub function type_from_name_with_names_and_unions(name: string, struct_names: string[], union_names: string[]): typeinfo.Type {
  return type_from_spelling(name, type_names(struct_names, union_names, []));
}

function struct_sig_names(structs: StructSig[]): string[] {
  let out: string[] = [];
  for sd in structs {
    out = out.append(sd.name);
  }
  return out;
}

function union_sig_names(unions: UnionSig[]): string[] {
  let out: string[] = [];
  for u in unions {
    out = out.append(u.name);
  }
  return out;
}

function type_from_spelling(name: string, tn: TypeNames): typeinfo.Type {
  let memo: SpellMemo = tn.spellings;
  let at: i32 = memo.names.find(name);
  if (at >= 0) {
    return memo.types[at];
  }
  return type_from_ref_names(parser.parse_type_ref(name), tn);
}

function enum_argument_from_ref(r: parser.TypeRef, tn: TypeNames): typeinfo.Type {
  if (parser.render_type_ref(r) == "$unbound") {
    return t_unknown("unbound lifted enum argument");
  }
  return type_from_ref_names(r, tn);
}

function type_from_ref_names(r: parser.TypeRef, tn: TypeNames): typeinfo.Type {
  if (r.array_depth > 0) {
    let elem: parser.TypeRef = parser.elem_type_ref(r);
    return t_array(type_from_ref_names(elem, tn));
  }
  if (r.is_view) {
    return t_view(type_from_ref_names(r.args[0], tn));
  }
  let name: string = parser.render_type_ref(r);
  if (name.len() >= 5 && slice_unchecked(name, 0, 4) == "dyn ") {
    return t_dyn(slice_unchecked(name, 4, name.len()) + "");
  }
  if (names_resource_handle(name, tn)) {
    return resource_handle(name);
  }
  if (name == "i32") {
    return t_i32();
  }
  if (name == "char") {
    return t_char();
  }
  if (name == "i64") {
    return t_i64();
  }
  if (name == "u8") {
    return t_u8();
  }
  if (name == "u32") {
    return t_u32();
  }
  if (name == "u64") {
    return t_u64();
  }
  if (name == "usize") {
    return t_usize();
  }
  if (name == "boolean") {
    return t_bool();
  }
  if (name == "string") {
    return t_string();
  }
  if (name == "str") {
    return t_str();
  }
  if (name == "f32") {
    return t_f32();
  }
  if (name == "f64") {
    return t_float();
  }
  if (typeinfo.lanes_width(name) > 0) {
    return t_lanes(typeinfo.lanes_width(name));
  }
  if (name == "void") {
    return t_void();
  }
  if (parser.ref_is_fn_value(r)) {
    return callable_from_ref_names(r, tn);
  }
  if (name == "fn") {
    return t_func_opaque(t_unknown("fn result (the coarse tag records none)"));
  }
  if (r.is_tuple) {
    if (r.args.len() >= 2) {
      let elems: typeinfo.Type[] = [];
      for arg in r.args {
        elems = elems.append(type_from_ref_names(arg, tn));
      }
      return t_tuple(elems);
    }
  } else if (is_map_ref(r)) {
    return t_map(type_from_ref_names(r.args[0], tn), type_from_ref_names(r.args[1], tn));
  } else if (is_cell_ref(r)) {
    return t_struct_g("Cell", [type_from_ref_names(r.args[0], tn)]);
  } else if (is_wide_map_ref(r)) {
    let v_name: string = parser.render_type_ref(r.args[1]);
    let vk: i32 = 2;
    while (vk < r.args.len()) {
      v_name = v_name + ", " + parser.render_type_ref(r.args[vk]);
      vk = vk + 1;
    }
    return t_map(type_from_ref_names(r.args[0], tn), type_from_spelling(v_name, tn));
  }
  if (parser.is_reserved_enum_name(r.base)) {
    let uargs: typeinfo.Type[] = [];
    for arg in r.args {
      uargs = uargs.append(enum_argument_from_ref(arg, tn));
    }
    return t_union_g(r.base, uargs);
  }
  if (r.args.len() > 0) {
    if (tn.structs.has(r.base)) {
      let gargs: typeinfo.Type[] = [];
      for arg in r.args {
        gargs = gargs.append(type_from_ref_names(arg, tn));
      }
      return t_struct_g(r.base, gargs);
    }
    if (tn.unions.has(r.base)) {
      let uinst: typeinfo.Type[] = [];
      for arg in r.args {
        uinst = uinst.append(enum_argument_from_ref(arg, tn));
      }
      return t_union_g(r.base, uinst);
    }
  }
  if (tn.structs.has(name)) {
    return t_struct(name);
  }
  if (tn.unions.has(name)) {
    return t_union(name);
  }
  if (parser.is_reserved_struct_name(name) && name != "Map" && name != "Cell") {
    return t_struct(name);
  }
  if (!r.is_tuple && r.args.len() > 0 && r.base != "Map" && r.base != "Cell") {
    if (!tn.structs.has(r.base) && !tn.unions.has(r.base)) {
      return t_union(r.base);
    }
  }
  return t_unknown(UNRESOLVED_MARK + name);
}

function callable_from_ref_names(r: parser.TypeRef, tn: TypeNames): typeinfo.Type {
  let f: parser.TypeRef = parser.ref_ungroup(r);
  let params: typeinfo.Type[] = [];
  let owns: boolean[] = [];
  let i: i32 = 0;
  while (i + 1 < f.args.len()) {
    owns = owns.append(parser.ref_is_own(f.args[i]));
    params = params.append(type_from_ref_names(parser.ref_without_own(f.args[i]), tn));
    i = i + 1;
  }
  return t_func_own(params, owns, type_from_ref_names(parser.ref_fn_result(r), tn));
}

function type_from_ref_subst(r: parser.TypeRef, tparams: string[], targs: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  if (r.array_depth > 0) {
    let elem: parser.TypeRef = parser.elem_type_ref(r);
    return t_array(type_from_ref_subst(elem, tparams, targs, tn));
  }
  if (r.is_view) {
    return t_view(type_from_ref_subst(r.args[0], tparams, targs, tn));
  }
  if (!r.is_tuple && r.args.len() == 0) {
    let tpi: i32 = util.index_of_str(tparams, r.base);
    if (tpi >= 0 && tpi < targs.len()) {
      return targs[tpi];
    }
    let sep: i32 = util.index_of_sub(r.base, "::");
    if (sep > 0) {
      let opi: i32 = util.index_of_str(tparams, slice_unchecked(r.base, 0, sep) + "");
      if (opi >= 0 && opi < targs.len() && is_type_variable(targs[opi]) && !is_unknown(targs[opi])) {
        return typeinfo.TypeErased { name: r.base };
      }
    }
  }
  if (parser.ref_is_fn_value(r)) {
    let f: parser.TypeRef = parser.ref_ungroup(r);
    let pts: typeinfo.Type[] = [];
    let owns: boolean[] = [];
    let i: i32 = 0;
    while (i + 1 < f.args.len()) {
      let ref: parser.TypeRef = parser.ref_without_own(f.args[i]);
      let param: typeinfo.Type = type_from_ref_subst(ref, tparams, targs, tn);
      let on: boolean = parser.ref_is_own(f.args[i]);
      if (type_ref_names_any(ref, tparams) && !typeinfo.ownable(param)) {
        on = false;
      }
      owns = owns.append(on);
      pts = pts.append(param);
      i = i + 1;
    }
    return t_func_own(pts, owns, type_from_ref_subst(parser.ref_fn_result(r), tparams, targs, tn));
  }
  if (r.is_tuple && r.args.len() >= 2) {
    let elems: typeinfo.Type[] = [];
    for arg in r.args {
      elems = elems.append(type_from_ref_subst(arg, tparams, targs, tn));
    }
    return t_tuple(elems);
  }
  if (r.base == "Map" && r.args.len() == 2) {
    return t_map(type_from_ref_subst(r.args[0], tparams, targs, tn), type_from_ref_subst(r.args[1], tparams, targs, tn));
  }
  let whole: typeinfo.Type = type_from_ref_names(r, tn);
  if (r.is_tuple || r.args.len() == 0) {
    return whole;
  }
  let sargs: typeinfo.Type[] = [];
  let decoded: typeinfo.Type[] = nominal_args(whole);
  let ai: i32 = 0;
  while (ai < r.args.len()) {
    if (ai < decoded.len() && unbound_enum_argument(decoded[ai])) {
      sargs = sargs.append(decoded[ai]);
    } else {
      sargs = sargs.append(type_from_ref_subst(r.args[ai], tparams, targs, tn));
    }
    ai = ai + 1;
  }
  return with_nominal_args(whole, sargs);
}

function with_nominal_args(t: typeinfo.Type, args: typeinfo.Type[]): typeinfo.Type {
  if (nominal_args(t).len() != args.len()) {
    return t;
  }
  if let typeinfo.TypeStruct(st) = t {
    return typeinfo.TypeStruct { name: st.name, args: args };
  }
  if let typeinfo.TypeUnion(u) = t {
    return typeinfo.TypeUnion { name: u.name, args: args };
  }
  if let typeinfo.TypeMap(_) = t {
    return t_map(args[0], args[1]);
  }
  return t;
}

const TPARAM_MARK: string = "type parameter ";

const UNRESOLVED_MARK: string = "unrecognised type name: ";

pub function typevar_reason_name(reason: string): string {
  if (reason.len() > TPARAM_MARK.len() && util.str_has_prefix(reason, TPARAM_MARK)) {
    return slice_unchecked(reason, TPARAM_MARK.len(), reason.len()) + "";
  }
  if (reason.len() > UNRESOLVED_MARK.len() && util.str_has_prefix(reason, UNRESOLVED_MARK)) {
    return slice_unchecked(reason, UNRESOLVED_MARK.len(), reason.len()) + "";
  }
  return "";
}

function tvar_name(t: typeinfo.Type): string {
  if let typeinfo.TypeUnknown(u) = t {
    let name: string = typevar_reason_name(u.reason);
    if (parser.looks_type_var(name)) {
      return name;
    }
  }
  return "";
}

function is_type_variable(t: typeinfo.Type): boolean {
  if let typeinfo.TypeErased(_) = t {
    return true;
  }
  return tvar_name(t).len() > 0;
}

function unknown_beyond_tvars(t: typeinfo.Type): boolean {
  if (is_type_variable(t)) {
    return false;
  }
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return !unbound_enum_argument(t);
    },
    typeinfo.TypeArray(ae) => {
      return unknown_beyond_tvars(ae.elem);
    },
    typeinfo.TypeTuple(tt) => {
      for element in tt.elements {
        if (unknown_beyond_tvars(element)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeMap(m) => {
      return unknown_beyond_tvars(m.key) || unknown_beyond_tvars(m.value);
    },
    typeinfo.TypeStruct(sn) => {
      for arg in sn.args {
        if (unknown_beyond_tvars(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        if (unknown_beyond_tvars(arg)) {
          return true;
        }
      }
      return false;
    },
    typeinfo.TypeFunc(f) => {
      if (unknown_beyond_tvars(f.ret_type)) {
        return true;
      }
      for param_type in f.param_types {
        if (unknown_beyond_tvars(param_type)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function type_from_name_erasing_tparams(name: string, tparams: string[], tn: TypeNames): typeinfo.Type {
  return type_from_name_subst(name, tparams, erased_tparams(tparams), tn);
}

function type_from_name_subst(name: string, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  if (tparams.len() == 0 || name.len() == 0 || name.len() >= 5 && slice_unchecked(name, 0, 4) == "dyn ") {
    return type_from_spelling(name, tn);
  }
  return type_from_ref_subst(parser.parse_type_ref(name), tparams, subst, tn);
}

function erased_tparams(tparams: string[]): typeinfo.Type[] {
  let erased: typeinfo.Type[] = [];
  for tp in tparams {
    erased = erased.append(t_unknown(TPARAM_MARK + tp));
  }
  return erased;
}

function rigid_tparams(tparams: string[]): typeinfo.Type[] {
  let rigid: typeinfo.Type[] = [];
  for tp in tparams {
    rigid = rigid.append(typeinfo.TypeErased { name: tp });
  }
  return rigid;
}

function gc_is_typevar_name(n: string, tparams: string[], tn: TypeNames): boolean {
  if (n.len() == 0) {
    return false;
  }
  if (util.index_of_str(tparams, n) >= 0) {
    return true;
  }
  return type_contains_unknown(type_from_spelling(n, tn));
}

function gc_bind_param(r: parser.TypeRef, at: typeinfo.Type, tparams: string[], tn: TypeNames, names: string[], types: typeinfo.Type[]): (string[], typeinfo.Type[]) {
  let ns: string[] = names;
  let ts: typeinfo.Type[] = types;
  if (r.array_depth > 0 || r.is_view) {
    match (at) {
      typeinfo.TypeArray(a) => {
        if (r.array_depth > 0) {
          return gc_bind_param(parser.elem_type_ref(r), a.elem, tparams, tn, ns, ts);
        }
        return gc_bind_param(r.args[0], a.elem, tparams, tn, ns, ts);
      },
      _ => {
        return (ns, ts);
      }
    }
  }
  if (parser.ref_is_fn_value(r)) {
    if let typeinfo.TypeFunc(f) = at {
      let fr: parser.TypeRef = parser.ref_ungroup(r);
      if (f.params_known && f.param_types.len() + 1 == fr.args.len()) {
        let fi: i32 = 0;
        while (fi < f.param_types.len()) {
          let (fn2, ft2) = gc_bind_param(parser.ref_without_own(fr.args[fi]), f.param_types[fi], tparams, tn, ns, ts);
          ns = fn2;
          ts = ft2;
          fi = fi + 1;
        }
        let (rn2, rt2) = gc_bind_param(parser.ref_fn_result(r), f.ret_type, tparams, tn, ns, ts);
        ns = rn2;
        ts = rt2;
      }
    }
    return (ns, ts);
  }
  if (r.is_tuple && r.args.len() >= 2) {
    match (at) {
      typeinfo.TypeTuple(tp) => {
        if (tp.elements.len() == r.args.len()) {
          let ti: i32 = 0;
          while (ti < r.args.len()) {
            let (tn2, tt2) = gc_bind_param(r.args[ti], tp.elements[ti], tparams, tn, ns, ts);
            ns = tn2;
            ts = tt2;
            ti = ti + 1;
          }
        }
      },
      _ => {}
    }
    return (ns, ts);
  }
  let nargs: typeinfo.Type[] = nominal_args(at);
  if (r.args.len() > 0 && nargs.len() == r.args.len()) {
    let ni: i32 = 0;
    while (ni < r.args.len()) {
      let (nn2, nt2) = gc_bind_param(r.args[ni], nargs[ni], tparams, tn, ns, ts);
      ns = nn2;
      ts = nt2;
      ni = ni + 1;
    }
    return (ns, ts);
  }
  if (r.args.len() == 0 && (!is_unknown(at) || is_type_variable(at)) && !elemless_array(at) && gc_is_typevar_name(r.base, tparams, tn)) {
    let index: i32 = util.index_of_str(ns, r.base);
    if (index < 0) {
      ns = ns.append(r.base);
      ts = ts.append(at);
    } else if (is_type_variable(ts[index]) && !is_unknown(at)) {
      ts = ts.with(index, at);
    } else if let typeinfo.TypeUnion(prior) = ts[index] {
      if let typeinfo.TypeUnion(actual) = at {
        let joined: typeinfo.Type = join_enum_arguments(prior, actual);
        if (!is_unknown(joined)) {
          ts = ts.with(index, joined);
        }
      }
    }
  }
  return (ns, ts);
}

function declared_union_names(mod: parser.Module): string[] {
  let out: string[] = [];
  for alias in mod.aliases {
    out = out.append(alias.name);
  }
  for ed in mod.enums {
    out = out.append(ed.name);
  }
  return out;
}

function collect_union_sigs(mod: parser.Module): UnionSig[] {
  let out: UnionSig[] = [];
  let i: i32 = 0;
  while (i < mod.aliases.len()) {
    let a: parser.TypeAlias = mod.aliases[i];
    if (parser.alias_registers(mod, i)) {
      out = out.append(UnionSig { name: a.name, variants: a.variants, is_try: false, is_enum: false, module: a.module, type_params: [], instance: "", visible_from: [] });
    }
    i = i + 1;
  }
  return out;
}

function validate_union_sigs(unions: UnionSig[], struct_names: string[]): boolean {
  for u in unions {
    for variant in u.variants {
      let name: string = variant;
      let k: i32 = 0;
      let found: boolean = false;
      while (k < struct_names.len()) {
        if (struct_names[k] == name) {
          found = true;
          break;
        }
        k = k + 1;
      }
      if (!found) {
        return false;
      }
    }
  }
  return true;
}

function const_arg_diags(sig: FuncSig, c: ast.ExprCall, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let i: i32 = 0;
  while (i < sig.all_type_params.len() && i < c.type_args.len()) {
    let tp: string = sig.all_type_params[i];
    let arg: string = c.type_args[i];
    let k: i32 = util.index_of_str(sig.type_params, tp);
    let is_const: boolean = k >= 0 && k < sig.type_bounds.len() && parser.is_const_bound(sig.type_bounds[k]);
    if (is_const && parser.is_const_arg(arg) && !parser.const_arg_fits(arg)) {
      out = out.append(dg_at("E089", "the const argument for " + tp + " must fit in i32", c.line, c.col));
    } else if (is_const && !parser.is_const_arg(arg) && !s.is_const_param(arg)) {
      if (arg.len() == 0 || s.defines(arg)) {
        out = out.append(dg_at("E089", "the const argument for " + tp + " must be an integer literal or a const parameter", c.line, c.col));
      } else {
        out = out.append(dg_at("E090", "const parameter " + tp + " takes an integer, not the type " + arg, c.line, c.col));
      }
    } else if (!is_const && parser.is_const_arg(arg)) {
      out = out.append(dg_at("E090", "type parameter " + tp + " takes a type, not the integer " + arg, c.line, c.col));
    }
    i = i + 1;
  }
  return out;
}

function const_tparams(fd: parser.FuncDecl): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < fd.type_params.len() && i < fd.bound_traits.len()) {
    if (parser.is_const_bound(fd.bound_traits[i])) {
      out = out.append(fd.type_params[i]);
    }
    i = i + 1;
  }
  return out;
}

function build_func_scope(fd: parser.FuncDecl, st: SigTable, structs: StructTable, unions: UnionTable, methods: MethodTable, imports: Imports, impls: parser.ImplInfo[], trait_reqs: parser.TraitReq[]): Scope {
  let s: Scope = Scope { ...new_scope_full(st, structs, unions.seen_from(fd), methods, imports, impls, trait_reqs), fn_module: fd.module };
  if (fd.impl_trait.len() > 0 && parser.is_inherited_default(impls, trait_reqs, fd)) {
    s = Scope { ...s, default_trait: fd.impl_trait, default_recv: util.base_type_name(fd.receiver_type) };
  }
  let tps: string[] = func_scope_tparams(fd);
  let declared_from: i32 = tps.len();
  if (fd.receiver_type.len() > 0) {
    let rbase: string = util.base_type_name(fd.receiver_type);
    let rtvs: string[] = s.lookup_struct(rbase).type_params;
    if (rtvs.len() == 0) {
      rtvs = s.lookup_union(rbase).type_params;
    }
    for rtv in rtvs {
      if (util.index_of_str(tps, rtv) < 0) {
        tps = tps.append(rtv);
      }
    }
  }
  let tbs: string[] = [];
  for b in fd.bound_traits {
    tbs = tbs.append(bounds_in_module(b, fd.module));
  }
  while (tbs.len() < tps.len()) {
    tbs = tbs.append("");
  }
  let k: i32 = declared_from;
  while (k < tps.len()) {
    if (tbs[k].len() == 0) {
      tbs = tbs.with(k, fd.impl_trait);
    }
    k = k + 1;
  }
  for tv in fd.all_type_params {
    if (!util.has_str(tps, tv)) {
      tps = tps.append(tv);
      tbs = tbs.append("");
    }
  }
  s = s.with_tparams(tps, tbs);
  if (fd.ret_type.len() > 0) {
    s = s.with_ret_type(func_ret_type(fd, tps, rigid_tparams(tps), s.type_names()));
  }
  if (fd.receiver_name.len() > 0) {
    s = s.bind(fd.receiver_name, type_from_name_subst(fd.receiver_type, tps, rigid_tparams(tps), s.type_names()));
  }
  for param in fd.params {
    s = s.bind(param.name, param_decl_type(param, tps, rigid_tparams(tps), s.type_names()));
  }
  for name in const_tparams(fd) {
    s = s.bind(name, t_i32());
  }
  return s;
}

function func_scope_tparams(fd: parser.FuncDecl): string[] {
  if (fd.receiver_type.len() == 0) {
    return fd.type_params;
  }
  return parser.type_str_vars(fd.receiver_type, fd.type_params);
}

function split_fn_param_spellings(csv: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i <= csv.len()) {
    if (i == csv.len() || csv[i] == b',' && depth == 0) {
      out = out.append(slice_unchecked(csv, start, i) + "");
      start = i + 1;
    } else if (csv[i] == b'(' || csv[i] == b'[') {
      depth = depth + 1;
    } else if (csv[i] == b')' || csv[i] == b']') {
      depth = depth - 1;
    }
    i = i + 1;
  }
  return out;
}

function param_decl_type(p: ast.ParamDecl, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  let t: typeinfo.Type = fn_param_decl_type(p, tparams, subst, tn);
  if (is_unknown(t)) {
    t = type_from_name_subst(p.type_name, tparams, subst, tn);
  }
  return t;
}

function fn_param_decl_type(p: ast.ParamDecl, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  if (!parser.is_fn_contract_tag(p.type_name) || p.fn_ret.len() == 0) {
    return t_unknown("opaque fn param");
  }
  return declared_callable_type(p.type_name, p.fn_ret, p.fn_param_types, tparams, subst, tn);
}

function (s: Scope) resolve_param(p: ast.ParamDecl): typeinfo.Type {
  let ty = fn_param_decl_type(p, s.tparams, rigid_tparams(s.tparams), s.type_names());
  if (!is_unknown(ty)) {
    return ty;
  }
  return s.resolve_type(p.type_name);
}

function declared_callable_type(name: string, ret: string, params: string, tparams: string[], subst: typeinfo.Type[], tn: TypeNames): typeinfo.Type {
  let pts: typeinfo.Type[] = [];
  let powns: boolean[] = [];
  if (params.len() > 0) {
    for seg in split_fn_param_spellings(params) {
      powns = powns.append(parser.spelling_is_own(seg));
      pts = pts.append(type_from_name_subst(parser.spelling_without_own(seg), tparams, subst, tn));
    }
  }
  let ft: typeinfo.Type = t_func_own(pts, powns, type_from_name_subst(ret, tparams, subst, tn));
  if (name == "fn[]") {
    return t_array(ft);
  }
  if (name == "[fn]") {
    return t_view(ft);
  }
  return ft;
}

function check_func_body(fd: parser.FuncDecl, s: Scope): boolean {
  let generic: boolean = s.tparams.len() > 0 || fd.all_type_params.len() > 0;
  if (!generic && fd.receiver_type.len() > 0) {
    if (type_contains_unknown(s.resolve_type(fd.receiver_type))) {
      generic = true;
    }
  }
  let ok: boolean = true;
  for stmt in fd.body {
    let r: CheckResult = check_stmt(stmt, s);
    s = r.scope;
    if (!generic && is_unknown(r.ty)) {
      ok = false;
    }
  }
  return ok;
}

function name_with_args_label(name: string, args: typeinfo.Type[]): string {
  if (args.len() == 0) {
    return name;
  }
  let out: string = name + "[";
  let i: i32 = 0;
  while (i < args.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    out = out + type_label(args[i]);
    i = i + 1;
  }
  return out + "]";
}

pub function type_label(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeString(st) => {
      if (st.tag == 1) {
        return "str";
      }
      return "string";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    typeinfo.TypeArray(a) => {
      return array_label(a);
    },
    typeinfo.TypeStruct(sd) => {
      return name_with_args_label(sd.name, sd.args);
    },
    typeinfo.TypeTuple(tp) => {
      return "(" + labels_joined(tp.elements) + ")";
    },
    typeinfo.TypeFunc(f) => {
      return func_label(f);
    },
    typeinfo.TypeMap(m) => {
      return "Map[" + type_label(m.key) + ", " + type_label(m.value) + "]";
    },
    typeinfo.TypeUnion(u) => {
      return name_with_args_label(u.name, u.args);
    },
    typeinfo.TypeDyn(d) => {
      return "dyn " + d.traits;
    },
    typeinfo.TypeHandle(h) => {
      return typeinfo.handle_spelling(h);
    },
    typeinfo.TypeVoid(_) => {
      return "void";
    },
    typeinfo.TypeNever(_) => {
      return "never";
    },
    typeinfo.TypeUnknown(_) => {
      return "unknown";
    },
    typeinfo.TypeErased(e) => {
      return e.name;
    }
  }
  return "unknown";
}

function array_label(a: typeinfo.TypeArray): string {
  if (a.view) {
    return "[" + type_label(a.elem) + "]";
  }
  if let typeinfo.TypeFunc(ef) = a.elem {
    if (ef.params_known) {
      return "(" + type_label(a.elem) + ")[]";
    }
  }
  return type_label(a.elem) + "[]";
}

function labels_joined(ts: typeinfo.Type[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < ts.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    out = out + type_label(ts[i]);
    i = i + 1;
  }
  return out;
}

function func_label(f: typeinfo.TypeFunc): string {
  if (!f.params_known) {
    return "fn";
  }
  let out: string = "(";
  let i: i32 = 0;
  while (i < f.param_types.len()) {
    if (i > 0) {
      out = out + ", ";
    }
    if (typeinfo.fn_own_at(f, i)) {
      out = out + "own ";
    }
    out = out + type_label(f.param_types[i]);
    i = i + 1;
  }
  return out + ") => " + type_label(f.ret_type);
}

function keep_code(diags: util.Diag[], code: string): util.Diag[] {
  let out: util.Diag[] = [];
  for diag in diags {
    if (diag.code == code) {
      out = out.append(diag);
    }
  }
  return out;
}

function ret_diags(stmts: ast.Stmt[], s: Scope, ret_ty: typeinfo.Type, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  if (is_unknown(ret_ty)) {
    return out;
  }
  let cur: Scope = s;
  for st in stmts {
    out = util.append_diags(out, ret_diags_in_exprs(st, cur, ret_ty, unions, false));
    match (st) {
      ast.StmtReturn(r) => {
        let bare: boolean = false;
        match (r.value) {
          ast.ExprUnknown(u) => {
            if (u.kind == parser.BARE_RETURN) {
              bare = true;
            }
          },
          _ => {}
        }
        if (bare) {
          out = out.append(dg_at("E012", "return without value in function returning " + type_label(ret_ty), r.line, r.col));
        } else {
          let t: typeinfo.Type = check_expr(r.value, cur);
          out = util.append_diags(out, int_dest_range_diags(r.value, ret_ty));
          out = util.append_diags(out, ctor_payload_diags(r.value, ret_ty, cur));
          let rbound: util.Diag[] = dest_bound_diags(r.value, ret_ty, cur);
          out = util.append_diags(out, rbound);
          if (!use_untyped_call(r.value) && rbound.len() == 0 && !is_unknown(t) && !settles_to(r.value, ret_ty, cur) && !(type_assignable(t, ret_ty, unions) && dyn_conforms(t, ret_ty, cur))) {
            out = out.append(dg_at("E002", "return value: expected " + type_label(ret_ty) + ", got " + type_label(t) + str_copy_hint(t, ret_ty), r.line, r.col));
          }
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, ret_diags(f.then_body, cur, ret_ty, unions));
        out = util.append_diags(out, ret_diags(f.else_body, cur, ret_ty, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, ret_diags(w.body, cur, ret_ty, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, ret_diags(fr.body, for_body_scope(fr, cur), ret_ty, unions));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, ret_diags(arm.body, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), ret_ty, unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, ret_diags(one, cur, ret_ty, unions));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function ret_diags_in_exprs(st: ast.Stmt, cur: Scope, ret_ty: typeinfo.Type, unions: UnionSig[], is_void: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  for e in stmt_exprs(st) {
    out = astwalk.fold_expr_pruned(
      e, out, (x: ast.Expr, own a: util.Diag[]): util.Diag[] => {
        match (x) {
          ast.ExprCall(c) => {
            if (parser.is_value_block(c)) {
              return util.append_diags(a, vb_ret_diags(parser.vb_body(c), cur, ret_ty, unions, is_void));
            }
            return a;
          },
          _ => {
            return a;
          }
        }
        return a;
      },
      not_a_scope_root,
    );
  }
  return out;
}

function stmt_exprs(st: ast.Stmt): ast.Expr[] {
  let out: ast.Expr[] = [];
  match (st) {
    ast.StmtVar(v) => {
      return out.append(v.init);
    },
    ast.StmtReturn(r) => {
      return out.append(r.value);
    },
    ast.StmtExpr(e) => {
      return out.append(e.value);
    },
    ast.StmtAssign(a) => {
      return out.append(a.value);
    },
    ast.StmtIf(i) => {
      return out.append(i.cond);
    },
    ast.StmtWhile(w) => {
      return out.append(w.cond);
    },
    ast.StmtFor(f) => {
      return out.append(f.iter);
    },
    ast.StmtMatch(m) => {
      out = out.append(m.scrutinee);
      for arm in m.arms {
        if (arm.has_guard) {
          out = out.append(arm.guard);
        }
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

function vb_ret_diags(body: ast.Stmt[], s: Scope, ret_ty: typeinfo.Type, unions: UnionSig[], is_void: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  if (body.len() == 0) {
    return out;
  }
  let cur: Scope = s;
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    out = util.append_diags(out, stmt_ret_diags(body[i], cur, ret_ty, unions, is_void));
    cur = bind_stmt(body[i], cur);
    i = i + 1;
  }
  match (body[i]) {
    ast.StmtReturn(_) => {
      return util.append_diags(out, ret_diags_in_exprs(body[i], cur, ret_ty, unions, is_void));
    },
    ast.StmtIf(f) => {
      out = util.append_diags(out, ret_diags_in_exprs(body[i], cur, ret_ty, unions, is_void));
      out = util.append_diags(out, vb_ret_diags(f.then_body, cur, ret_ty, unions, is_void));
      return util.append_diags(out, vb_ret_diags(f.else_body, cur, ret_ty, unions, is_void));
    },
    ast.StmtMatch(m) => {
      out = util.append_diags(out, ret_diags_in_exprs(body[i], cur, ret_ty, unions, is_void));
      for arm in m.arms {
        out = util.append_diags(out, vb_ret_diags(arm.body, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), ret_ty, unions, is_void));
      }
      return out;
    },
    _ => {
      return util.append_diags(out, stmt_ret_diags(body[i], cur, ret_ty, unions, is_void));
    }
  }
  return out;
}

function stmt_ret_diags(st: ast.Stmt, s: Scope, ret_ty: typeinfo.Type, unions: UnionSig[], is_void: boolean): util.Diag[] {
  let one: ast.Stmt[] = [st];
  if (is_void) {
    return void_ret_diags(one, s, unions);
  }
  return ret_diags(one, s, ret_ty, unions);
}

function void_return_diag(r: ast.StmtReturn, cur: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  match (r.value) {
    ast.ExprUnknown(u) => {
      if (u.kind == parser.BARE_RETURN) {
        return out;
      }
    },
    _ => {}
  }
  let t: typeinfo.Type = check_expr(r.value, cur);
  if (!is_void(t)) {
    out = out.append(dg_at("E002", "return value: expected void, got " + type_label(t), r.line, r.col));
  }
  return out;
}

function void_ret_diags(stmts: ast.Stmt[], s: Scope, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for st in stmts {
    out = util.append_diags(out, ret_diags_in_exprs(st, cur, t_void(), unions, true));
    match (st) {
      ast.StmtReturn(r) => {
        out = util.append_diags(out, void_return_diag(r, cur));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, void_ret_diags(f.then_body, cur, unions));
        out = util.append_diags(out, void_ret_diags(f.else_body, cur, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, void_ret_diags(w.body, cur, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, void_ret_diags(fr.body, for_body_scope(fr, cur), unions));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, void_ret_diags(arm.body, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, void_ret_diags(one, cur, unions));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function name_in(name: string, list: string[]): boolean {
  for entry in list {
    if (entry == name) {
      return true;
    }
  }
  return false;
}

pub struct ViewSum { key: string, flags: boolean[], fresh: boolean }

pub struct ViewIndex { head: i32[], next: i32[] }

function view_index(sums: ViewSum[]): ViewIndex {
  let head: i32[] = util.minus_ones(sig_buckets());
  let next: i32[] = util.minus_ones(sums.len());
  let k: i32 = sums.len() - 1;
  while (k >= 0) {
    let bk: i32 = sig_name_bucket(sums[k].key);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    k = k - 1;
  }
  return ViewIndex { head: head, next: next };
}

function view_sum_pos(sums: ViewSum[], vix: ViewIndex, key: string): i32 {
  let i: i32 = vix.head[sig_name_bucket(key)];
  while (i >= 0) {
    if (sums[i].key == key) {
      return i;
    }
    i = vix.next[i];
  }
  return 0 - 1;
}

pub struct ViewRoots { local: boolean, params: string[] }

pub struct ViewCallee { key: string, args: ast.Expr[] }

function view_sum_key(fn: parser.FuncDecl): string {
  if (fn.receiver_type.len() > 0) {
    return parser.receiver_base(fn.receiver_type) + "." + fn.name;
  }
  return fn.name;
}

function view_positions(fn: parser.FuncDecl): string[] {
  let out: string[] = [];
  for param in fn.params {
    out = out.append(param.name);
  }
  if (fn.receiver_name.len() > 0) {
    out = out.append(fn.receiver_name);
  }
  return out;
}

function view_sum_flags(sums: ViewSum[], vix: ViewIndex, key: string): boolean[] {
  let at: i32 = view_sum_pos(sums, vix, key);
  if (at >= 0) {
    return sums[at].flags;
  }
  let none: boolean[] = [];
  return none;
}

function view_sum_known(sums: ViewSum[], vix: ViewIndex, key: string): boolean {
  return view_sum_pos(sums, vix, key) >= 0;
}

function view_sum_fresh(sums: ViewSum[], vix: ViewIndex, key: string): boolean {
  let at: i32 = view_sum_pos(sums, vix, key);
  if (at >= 0) {
    return sums[at].fresh;
  }
  return false;
}

function view_recv_key(obj: ast.Expr, s: Scope): string {
  match (check_expr(obj, s)) {
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeStruct(sd) => {
      return util.base_type_name(sd.name);
    },
    typeinfo.TypeUnion(u) => {
      return util.base_type_name(u.name);
    },
    _ => {}
  }
  return "";
}

function view_callee(c: ast.ExprCall, s: Scope): ViewCallee {
  let none: ast.Expr[] = [];
  match (c.callee) {
    ast.ExprIdent(cid) => {
      return ViewCallee { key: cid.name, args: c.args };
    },
    ast.ExprFieldAccess(cfa) => {
      let recv: string = view_recv_key(cfa.obj, s);
      if (recv.len() == 0) {
        return ViewCallee { key: "", args: none };
      }
      let xs: ast.Expr[] = c.args;
      return ViewCallee { key: recv + "." + cfa.field, args: xs.append(cfa.obj) };
    },
    _ => {}
  }
  return ViewCallee { key: "", args: none };
}

function no_view_roots(): ViewRoots {
  let none: string[] = [];
  return ViewRoots { local: false, params: none };
}

function merge_view_roots(a: ViewRoots, b: ViewRoots): ViewRoots {
  let ps: string[] = a.params;
  for n in b.params {
    if (!e065_ident_in(n, ps)) {
      ps = ps.append(n);
    }
  }
  return ViewRoots { local: a.local || b.local, params: ps };
}

function merge_view_names(a: string[], b: string[]): string[] {
  let out: string[] = a;
  for n in b {
    if (!e065_ident_in(n, out)) {
      out = out.append(n);
    }
  }
  return out;
}

function slc_src_roots(e: ast.Expr, cur: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  match (e) {
    ast.ExprBytes(_) => {
      return ViewRoots { local: true, params: [] };
    },
    ast.ExprArray(_) => {
      let none: string[] = [];
      return ViewRoots { local: true, params: none };
    },
    ast.ExprSlice(s2) => {
      return slc_src_roots(s2.array, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprCall(c2) => {
      return slc_call_roots(c2, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprIdent(id) => {
      if (name_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (name_in(id.name, localarr) || name_in(id.name, tainted)) {
        let no: string[] = [];
        return ViewRoots { local: true, params: no };
      }
    },
    _ => {}
  }
  return no_view_roots();
}

function slc_call_roots(c: ast.ExprCall, cur: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  let out: ViewRoots = no_view_roots();
  let callee: ViewCallee = view_callee(c, cur);
  if (callee.key.len() == 0) {
    return out;
  }
  if (view_sum_fresh(sums, vix, callee.key)) {
    out = ViewRoots { local: true, params: out.params };
  }
  let flags: boolean[] = view_sum_flags(sums, vix, callee.key);
  let i: i32 = 0;
  while (i < flags.len() && i < callee.args.len()) {
    if (flags[i]) {
      out = merge_view_roots(out, slc_src_roots(callee.args[i], cur, params, localarr, tainted, sums, vix));
    }
    i = i + 1;
  }
  return out;
}

function slc_expr_roots(e: ast.Expr, cur: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex): ViewRoots {
  match (e) {
    ast.ExprSlice(sl) => {
      match (check_expr(sl.array, cur)) {
        typeinfo.TypeString(_) => {
          return no_view_roots();
        },
        _ => {}
      }
      return slc_src_roots(sl.array, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprCall(c) => {
      return slc_call_roots(c, cur, params, localarr, tainted, sums, vix);
    },
    ast.ExprIdent(id) => {
      if (name_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (name_in(id.name, tainted)) {
        let no: string[] = [];
        return ViewRoots { local: true, params: no };
      }
    },
    _ => {}
  }
  return no_view_roots();
}

pub struct SlcWalk { diags: util.Diag[], viewed: string[], owns: boolean }

function slc_walk(stmts: ast.Stmt[], fname: string, s: Scope, params: string[], localarr: string[], tainted: string[], sums: ViewSum[], vix: ViewIndex, ret_is_view: boolean): SlcWalk {
  let out: util.Diag[] = [];
  let viewed: string[] = [];
  let owns: boolean = false;
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (is_arr_view(var_declared_type(v, cur)) && is_owned_array(check_expr(v.init, cur))) {
          if (slc_src_roots(v.init, cur, params, localarr, tainted, sums, vix).local) {
            tainted = tainted.append(v.name);
          }
        }
        match (v.init) {
          ast.ExprBytes(_) => {
            localarr = localarr.append(v.name);
          },
          ast.ExprArray(_) => {
            localarr = localarr.append(v.name);
          },
          _ => {
            if (slc_expr_roots(v.init, cur, params, localarr, tainted, sums, vix).local) {
              tainted = tainted.append(v.name);
            }
          }
        }
      },
      ast.StmtReturn(r) => {
        if (ret_is_view) {
          let roots: ViewRoots = slc_expr_roots(r.value, cur, params, localarr, tainted, sums, vix);
          viewed = merge_view_names(viewed, roots.params);
          if (roots.local) {
            out = out.append(dg_at("E063", "returning a `[T]` slice that views function-local storage: the backing array is reclaimed when \"" + fname + "\" returns, leaving a dangling view — return an owned array (`T[]`) or slice a parameter instead", r.line, r.col));
          }
        } else {
          let sroots: ViewRoots = slc_src_roots(r.value, cur, params, localarr, tainted, sums, vix);
          viewed = merge_view_names(viewed, sroots.params);
          if (sroots.local) {
            owns = true;
          }
        }
      },
      ast.StmtIf(f) => {
        let wt: SlcWalk = slc_walk(f.then_body, fname, cur, params, localarr, tainted, sums, vix, ret_is_view);
        out = util.append_diags(out, wt.diags);
        viewed = merge_view_names(viewed, wt.viewed);
        owns = owns || wt.owns;
        let we: SlcWalk = slc_walk(f.else_body, fname, cur, params, localarr, tainted, sums, vix, ret_is_view);
        out = util.append_diags(out, we.diags);
        viewed = merge_view_names(viewed, we.viewed);
        owns = owns || we.owns;
      },
      ast.StmtWhile(w) => {
        let ww: SlcWalk = slc_walk(w.body, fname, cur, params, localarr, tainted, sums, vix, ret_is_view);
        out = util.append_diags(out, ww.diags);
        viewed = merge_view_names(viewed, ww.viewed);
        owns = owns || ww.owns;
      },
      ast.StmtFor(fr) => {
        let wf: SlcWalk = slc_walk(fr.body, fname, for_body_scope(fr, cur), params, localarr, tainted, sums, vix, ret_is_view);
        out = util.append_diags(out, wf.diags);
        viewed = merge_view_names(viewed, wf.viewed);
        owns = owns || wf.owns;
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          let wa: SlcWalk = slc_walk(arm.body, fname, cur, params, localarr, tainted, sums, vix, ret_is_view);
          out = util.append_diags(out, wa.diags);
          viewed = merge_view_names(viewed, wa.viewed);
          owns = owns || wa.owns;
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        let wd: SlcWalk = slc_walk(one, fname, cur, params, localarr, tainted, sums, vix, ret_is_view);
        out = util.append_diags(out, wd.diags);
        viewed = merge_view_names(viewed, wd.viewed);
        owns = owns || wd.owns;
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return SlcWalk { diags: out, viewed: viewed, owns: owns };
}

function slc_call_names(fn: parser.FuncDecl): string[] {
  let out: string[] = [];
  for st in fn.body {
    out = astwalk.fold_stmt(st, out, slc_call_name_at);
  }
  return out;
}

function slc_call_name_at(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprCall(c) = e {
    match (c.callee) {
      ast.ExprIdent(cid) => {
        return acc.append(cid.name);
      },
      ast.ExprFieldAccess(cfa) => {
        return acc.append(cfa.field);
      },
      _ => {
        return acc;
      }
    }
  }
  return acc;
}

function slc_calls_any(calls: util.NameIndex, marked: util.NameIndex): boolean {
  for name in calls.names {
    if (marked.has(name)) {
      return true;
    }
  }
  return false;
}

function slice_escape_diags(fn: parser.FuncDecl, s: Scope, sums: ViewSum[], vix: ViewIndex): SlcWalk {
  let localarr: string[] = [];
  let tainted: string[] = [];
  return slc_walk(fn.body, fn.name, s, view_positions(fn), localarr, tainted, sums, vix, parser.spelling_is_view(fn.ret_type));
}

function mc_any_marked(structs: parser.StructDecl[], enums: parser.EnumDecl[]): boolean {
  for sd in structs {
    if (sd.must_consume) {
      return true;
    }
  }
  for ed in enums {
    if (ed.must_consume) {
      return true;
    }
  }
  return false;
}

function mc_struct_marked(name: string, structs: parser.StructDecl[]): boolean {
  for sd in structs {
    if (sd.name == name) {
      return sd.must_consume;
    }
  }
  return false;
}

function mc_enum_marked(name: string, enums: parser.EnumDecl[]): boolean {
  for ed in enums {
    if (ed.name == name) {
      return ed.must_consume;
    }
  }
  return false;
}

function mc_marked_type_name(tn: string, structs: parser.StructDecl[], enums: parser.EnumDecl[]): string {
  if (tn.len() == 0) {
    return "";
  }
  if (mc_struct_marked(tn, structs)) {
    return tn;
  }
  if (mc_enum_marked(tn, enums)) {
    return tn;
  }
  return "";
}

function mc_is_binding(e: ast.Expr, name: string): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == name;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function mc_mentions_stmts(stmts: ast.Stmt[], name: string): boolean {
  function see_expr(n: ast.Expr, own acc: boolean): boolean {
    match (n) {
      ast.ExprIdent(id) => {
        return acc || id.name == name;
      },
      _ => {
        return acc;
      }
    }
  }
  function see_stmt(st: ast.Stmt, own acc: boolean): boolean {
    match (st) {
      ast.StmtAssign(a) => {
        return acc || a.target == name;
      },
      _ => {
        return acc;
      }
    }
  }
  let found: boolean = false;
  for stmt in stmts {
    found = astwalk.fold_stmt_nodes(stmt, found, see_stmt, see_expr, astwalk.descend_all);
  }
  return found;
}

function mc_list_consumes(list: ast.Expr[], name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let out: util.Diag[] = [];
  for entry in list {
    let (c2, d2) = mc_expr_consumes(entry, name, tname, report, structs, enums);
    out = util.append_diags(out, d2);
    if (c2) {
      return (true, out);
    }
  }
  return (false, out);
}

function mc_call_consumes(c: ast.ExprCall, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  let owner: string = "";
  match (c.callee) {
    ast.ExprIdent(cid) => {
      owner = mx_enum_of(cid.name, enums);
      if (owner.len() == 0) {
        owner = parser.builtin_enum_of(cid.name);
      }
    },
    _ => {}
  }
  for arg in c.args {
    if (mc_is_binding(arg, name)) {
      if (owner.len() == 0 || mc_enum_marked(owner, enums)) {
        return (true, none);
      }
      let d: util.Diag[] = [];
      if (report) {
        d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into unmarked enum \"" + owner + "\" — the consumption obligation is lost; mark \"" + owner + "\" @must_consume or consume the value directly", c.line, c.col));
      }
      return (true, d);
    }
  }
  match (c.callee) {
    ast.ExprLambda(ilm) => {
      let (bc, bdv, bd) = mc_seq(ilm.body, 0, name, tname, structs, enums);
      if (report) {
        return (bc, bd);
      }
      return (bc, none);
    },
    _ => {}
  }
  let (kc, kd) = mc_expr_consumes(c.callee, name, tname, report, structs, enums);
  if (kc) {
    return (true, kd);
  }
  return mc_list_consumes(c.args, name, tname, report, structs, enums);
}

function mc_structlit_consumes(sl: ast.ExprStructLit, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  for field_value in sl.field_values {
    if (mc_is_binding(field_value, name)) {
      if (mc_struct_marked(sl.type_name, structs)) {
        return (true, none);
      }
      let d: util.Diag[] = [];
      if (report) {
        d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into unmarked struct \"" + sl.type_name + "\" — the consumption obligation is lost; mark \"" + sl.type_name + "\" @must_consume or consume the value directly", sl.line, sl.col));
      }
      return (true, d);
    }
  }
  if (sl.has_base) {
    let (bc, bd) = mc_expr_consumes(sl.base, name, tname, report, structs, enums);
    if (bc) {
      return (true, bd);
    }
  }
  return mc_list_consumes(sl.field_values, name, tname, report, structs, enums);
}

function mc_expr_consumes(e: ast.Expr, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      return mc_call_consumes(c, name, tname, report, structs, enums);
    },
    ast.ExprStructLit(sl) => {
      return mc_structlit_consumes(sl, name, tname, report, structs, enums);
    },
    ast.ExprArray(ar) => {
      for element in ar.elements {
        if (mc_is_binding(element, name)) {
          let d: util.Diag[] = [];
          if (report) {
            d = d.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into an array literal — arrays cannot carry consumption obligations; consume the value directly", expr_line(element), expr_col(element)));
          }
          return (true, d);
        }
      }
      return mc_list_consumes(ar.elements, name, tname, report, structs, enums);
    },
    ast.ExprTuple(tp) => {
      for element in tp.elements {
        if (mc_is_binding(element, name)) {
          let d2: util.Diag[] = [];
          if (report) {
            d2 = d2.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" stored into a tuple — tuples cannot carry consumption obligations; consume the value directly", tp.line, tp.col));
          }
          return (true, d2);
        }
      }
      return mc_list_consumes(tp.elements, name, tname, report, structs, enums);
    },
    ast.ExprLambda(lm) => {
      if (mc_mentions_stmts(lm.body, name)) {
        let d3: util.Diag[] = [];
        if (report) {
          d3 = d3.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" captured by a closure — obligations cannot flow into closures; consume the value directly", 0, 0));
        }
        return (true, d3);
      }
      return (false, none);
    },
    ast.ExprBinary(b) => {
      let (lc, ld) = mc_expr_consumes(b.left, name, tname, report, structs, enums);
      if (lc) {
        return (true, ld);
      }
      let (rc, rd) = mc_expr_consumes(b.right, name, tname, report, structs, enums);
      return (rc, util.append_diags(ld, rd));
    },
    ast.ExprUnary(u) => {
      return mc_expr_consumes(u.operand, name, tname, report, structs, enums);
    },
    ast.ExprIndex(ix) => {
      let (ac, ad) = mc_expr_consumes(ix.array, name, tname, report, structs, enums);
      if (ac) {
        return (true, ad);
      }
      return mc_expr_consumes(ix.index, name, tname, report, structs, enums);
    },
    ast.ExprSlice(sl2) => {
      let (sc, sd) = mc_expr_consumes(sl2.array, name, tname, report, structs, enums);
      if (sc) {
        return (true, sd);
      }
      let (stc, std) = mc_expr_consumes(sl2.start, name, tname, report, structs, enums);
      if (stc) {
        return (true, std);
      }
      return mc_expr_consumes(sl2.end, name, tname, report, structs, enums);
    },
    ast.ExprFieldAccess(fa) => {
      return mc_expr_consumes(fa.obj, name, tname, report, structs, enums);
    },
    _ => {
      return (false, none);
    }
  }
  return (false, none);
}

function mc_stmt_consumes(st: ast.Stmt, name: string, tname: string, report: boolean, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, util.Diag[]) {
  let none: util.Diag[] = [];
  match (st) {
    ast.StmtExpr(es) => {
      return mc_expr_consumes(es.value, name, tname, report, structs, enums);
    },
    ast.StmtVar(v) => {
      if (mc_is_binding(v.init, name)) {
        return (true, none);
      }
      return mc_expr_consumes(v.init, name, tname, report, structs, enums);
    },
    ast.StmtReturn(r) => {
      if (mc_is_binding(r.value, name)) {
        return (true, none);
      }
      return mc_expr_consumes(r.value, name, tname, report, structs, enums);
    },
    ast.StmtAssign(a) => {
      if (mc_is_binding(a.value, name)) {
        return (true, none);
      }
      return mc_expr_consumes(a.value, name, tname, report, structs, enums);
    },
    ast.StmtMatch(m) => {
      if (mc_is_binding(m.scrutinee, name)) {
        return (true, none);
      }
      return (false, none);
    },
    _ => {
      return (false, none);
    }
  }
  return (false, none);
}

function mc_seq(stmts: ast.Stmt[], from: i32, name: string, tname: string, structs: parser.StructDecl[], enums: parser.EnumDecl[]): (boolean, boolean, util.Diag[]) {
  let out: util.Diag[] = [];
  let i: i32 = from;
  while (i < stmts.len()) {
    let st: ast.Stmt = stmts[i];
    let (con, cd) = mc_stmt_consumes(st, name, tname, true, structs, enums);
    out = util.append_diags(out, cd);
    if (con) {
      return (true, false, out);
    }
    match (st) {
      ast.StmtReturn(_) => {
        return (false, true, out);
      },
      ast.StmtBreak(_) => {
        return (false, true, out);
      },
      ast.StmtContinue(_) => {
        return (false, true, out);
      },
      ast.StmtIf(f) => {
        let (tc, tv, td) = mc_seq(f.then_body, 0, name, tname, structs, enums);
        out = util.append_diags(out, td);
        let ec: boolean = false;
        let ev: boolean = false;
        if (f.else_body.len() > 0) {
          let (ec2, ev2, ed) = mc_seq(f.else_body, 0, name, tname, structs, enums);
          out = util.append_diags(out, ed);
          ec = ec2;
          ev = ev2;
        }
        if (tv || ev) {
          return (false, true, out);
        }
        if (tc && f.else_body.len() > 0 && ec) {
          return (true, false, out);
        }
      },
      ast.StmtMatch(m) => {
        if (ordinary_match_origin(m.origin)) {
          let all: boolean = m.arms.len() > 0;
          for arm in m.arms {
            let (ac, av, ad) = mc_seq(arm.body, 0, name, tname, structs, enums);
            out = util.append_diags(out, ad);
            if (av) {
              return (false, true, out);
            }
            if (!ac) {
              all = false;
            }
          }
          if (all) {
            return (true, false, out);
          }
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return (false, false, out);
}

function mc_check_binding(stmts: ast.Stmt[], from: i32, name: string, tname: string, bline: i32, bcol: i32, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let (con, div, out) = mc_seq(stmts, from, name, tname, structs, enums);
  if (!con || div) {
    out = out.append(dg_at("E067", "value of @must_consume type \"" + tname + "\" bound to \"" + name + "\" may go out of scope without being consumed — pass it, return it, match on it, or store it into another @must_consume type on every path", bline, bcol));
    return out;
  }
  let i: i32 = from;
  while (i < stmts.len()) {
    let (q, qd) = mc_stmt_consumes(stmts[i], name, tname, false, structs, enums);
    if (q) {
      return out;
    }
    match (stmts[i]) {
      ast.StmtAssign(a) => {
        if (a.target == name) {
          out = out.append(dg_at("E067", "overwriting \"" + name + "\" while it still holds an unconsumed @must_consume \"" + tname + "\" value — consume the old value first", a.line, a.col));
          return out;
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return out;
}

function mc_var_type_name(v: ast.StmtVar, cur: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): string {
  let tn: string = v.type_name;
  if (tn.len() == 0) {
    match (check_expr(v.init, cur)) {
      typeinfo.TypeStruct(ts) => {
        tn = ts.name;
      },
      typeinfo.TypeUnion(tu) => {
        tn = tu.name;
      },
      _ => {
        return "";
      }
    }
  }
  return mc_marked_type_name(tn, structs, enums);
}

function mc_walk_body(stmts: ast.Stmt[], s: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let st: ast.Stmt = stmts[i];
    match (st) {
      ast.StmtVar(v) => {
        let tn: string = mc_var_type_name(v, cur, structs, enums);
        if (tn.len() > 0) {
          out = util.append_diags(out, mc_check_binding(stmts, i + 1, v.name, tn, v.line, v.col, structs, enums));
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, mc_walk_body(f.then_body, cur, structs, enums));
        out = util.append_diags(out, mc_walk_body(f.else_body, cur, structs, enums));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, mc_walk_body(w.body, cur, structs, enums));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, mc_walk_body(fr.body, for_body_scope(fr, cur), structs, enums));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, mc_walk_body(arm.body, cur, structs, enums));
        }
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
    i = i + 1;
  }
  return out;
}

function must_consume_diags(fn: parser.FuncDecl, s: Scope, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  for p in fn.params {
    if (!p.own) {
      let tn: string = mc_marked_type_name(p.type_name, structs, enums);
      if (tn.len() > 0) {
        out = util.append_diags(out, mc_check_binding(fn.body, 0, p.name, tn, fn.line, fn.col, structs, enums));
      }
    }
  }
  out = util.append_diags(out, mc_walk_body(fn.body, s, structs, enums));
  return out;
}

struct LambdaExits { types: typeinfo.Type[], bare: boolean }

struct ExitFold { ty: typeinfo.Type, have: boolean, clash_with: typeinfo.Type[], clash: typeinfo.Type[] }

function fold_exits(types: typeinfo.Type[]): ExitFold {
  let out: ExitFold = ExitFold { ty: t_unknown("no value exit"), have: false, clash_with: [], clash: [] };
  for t in types {
    if (!exit_type_known(t)) {
      continue;
    }
    if (!out.have) {
      out = ExitFold { ...out, ty: t, have: true };
    } else if (!exits_unify(out.ty, t)) {
      out = ExitFold { ...out, clash_with: out.clash_with.append(out.ty), clash: out.clash.append(t) };
    } else {
      if let typeinfo.TypeUnion(u) = out.ty {
        if let typeinfo.TypeUnion(v) = t {
          out = ExitFold { ...out, ty: join_enum_arguments(u, v) };
        }
      }
    }
  }
  return out;
}

pub function exit_result(body: ast.Stmt[], scope: Scope): typeinfo.Type {
  return fold_exits(lambda_exits(body, scope, LambdaExits { types: [], bare: false }).types).ty;
}

function lambda_exit_diags(lm: ast.ExprLambda, lsc: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let exits: LambdaExits = lambda_exits(lm.body, lsc.with_ret_type(lambda_ret_type(lm, lsc)), LambdaExits { types: [], bare: false });
  let fold: ExitFold = fold_exits(exits.types);
  let i: i32 = 0;
  while (i < fold.clash.len()) {
    out = out.append(dg_at("E002", "cannot infer return type for \"\": conflicting return types " + type_label(fold.clash_with[i]) + " and " + type_label(fold.clash[i]) + "; add an explicit return type", lm.line, lm.col));
    i = i + 1;
  }
  if (fold.have && exits.bare) {
    out = out.append(dg_at("E012", "function \"\" returns a value on some paths but not others; add an explicit return type", lm.line, lm.col));
  }
  return out;
}

function lambda_exits(body: ast.Stmt[], scope: Scope, own acc: LambdaExits): LambdaExits {
  let cur: Scope = scope;
  for st in body {
    if (!is_defer_stmt(st)) {
      acc = lambda_try_exits(st, cur, acc);
    }
    match (st) {
      ast.StmtReturn(r) => {
        acc = lambda_return_exit(r, cur, acc);
      },
      ast.StmtIf(f) => {
        acc = lambda_exits(f.then_body, cur, acc);
        acc = lambda_exits(f.else_body, cur, acc);
      },
      ast.StmtWhile(w) => {
        acc = lambda_exits(w.body, cur, acc);
      },
      ast.StmtFor(fo) => {
        acc = lambda_exits(fo.body, for_body_scope(fo, cur), acc);
      },
      ast.StmtMatch(m) => {
        let whole: typeinfo.Type = expr_type(m.scrutinee, cur);
        for a in m.arms {
          acc = lambda_exits(a.body, arm_scope(a, cur, whole), acc);
        }
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return acc;
}

function lambda_return_exit(r: ast.StmtReturn, cur: Scope, own acc: LambdaExits): LambdaExits {
  if (parser.bare_return(r.value)) {
    return LambdaExits { ...acc, bare: true };
  }
  if (int_literal_tree(r.value)) {
    return acc;
  }
  return LambdaExits { ...acc, types: acc.types.append(check_expr(r.value, cur)) };
}

function is_defer_stmt(st: ast.Stmt): boolean {
  if let ast.StmtDefer(_) = st {
    return true;
  }
  return false;
}

function lambda_try_exits(st: ast.Stmt, cur: Scope, own acc: LambdaExits): LambdaExits {
  for e in stmt_exprs(st) {
    acc = astwalk.fold_expr_pruned(
      e, acc, (x: ast.Expr, own a: LambdaExits): LambdaExits => {
        if let ast.ExprUnary(u) = x {
          if (u.op == "try_") {
            return LambdaExits { ...a, types: a.types.append(check_expr(u.operand, cur)) };
          }
        }
        return a;
      },
      e079_not_lambda,
    );
  }
  return acc;
}

function exit_type_known(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnion(u) => {
      for a in u.args {
        if (!unbound_enum_argument(a) && !exit_type_known(a)) {
          return false;
        }
      }
      return true;
    },
    typeinfo.TypeFloat(f) => {
      return !f.polymorphic;
    },
    typeinfo.TypeVoid(_) => {
      return false;
    },
    _ => {
      return !type_contains_unknown(t);
    }
  }
  return true;
}

function exits_unify(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(ua) = a {
    if let typeinfo.TypeUnion(ub) = b {
      return !is_unknown(join_enum_arguments(ua, ub));
    }
  }
  return type_eq(a, b);
}

function lambda_body_diags(lm: ast.ExprLambda, lsc: Scope, rt: typeinfo.Type, unions: UnionSig[]): util.Diag[] {
  if (lm.ret_type.len() > 0 && is_void(rt)) {
    return void_ret_diags(lm.body, lsc, unions);
  }
  if (lm.ret_type.len() > 0 || lm.origin == parser.ORIGIN_USE && !is_unknown(rt)) {
    return ret_diags(lm.body, lsc, rt, unions);
  }
  return lambda_exit_diags(lm, lsc);
}

function lret_lambda(lm: ast.ExprLambda, cur: Scope, unions: UnionSig[], self_name: string): util.Diag[] {
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(cur.resolve_param(param));
  }
  let rt: typeinfo.Type = lambda_ret_type(lm, cur);
  let lsc: Scope = cur;
  if (self_name.len() > 0) {
    lsc = lsc.bind(self_name, t_func_own(pts, lambda_owns(lm), rt));
  }
  let bi: i32 = 0;
  while (bi < lm.params.len()) {
    lsc = lsc.bind(lm.params[bi].name, pts[bi]);
    bi = bi + 1;
  }
  return util.append_diags(lambda_body_diags(lm, lsc, rt, unions), lret_stmts(lm.body, lsc, unions));
}

function lret_expr(e: ast.Expr, cur: Scope, unions: UnionSig[], self_name: string): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprLambda(lm) => {
      out = util.append_diags(out, lret_lambda(lm, cur, unions, self_name));
    },
    ast.ExprBinary(b) => {
      out = util.append_diags(lret_expr(b.left, cur, unions, ""), lret_expr(b.right, cur, unions, ""));
    },
    ast.ExprUnary(u) => {
      out = lret_expr(u.operand, cur, unions, "");
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprLambda(lm) => {
          let lsc: Scope = cur;
          for param in lm.params {
            lsc = lsc.bind(param.name, cur.resolve_param(param));
          }
          out = util.append_diags(out, lret_stmts(lm.body, lsc, unions));
        },
        _ => {
          out = util.append_diags(out, lret_expr(c.callee, cur, unions, ""));
        }
      }
      for arg in c.args {
        out = util.append_diags(out, lret_expr(arg, cur, unions, ""));
      }
    },
    ast.ExprArray(a) => {
      for element in a.elements {
        out = util.append_diags(out, lret_expr(element, cur, unions, ""));
      }
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, lret_expr(element, cur, unions, ""));
      }
    },
    ast.ExprIndex(ix) => {
      out = util.append_diags(lret_expr(ix.array, cur, unions, ""), lret_expr(ix.index, cur, unions, ""));
    },
    ast.ExprSlice(s2) => {
      out = util.append_diags(lret_expr(s2.array, cur, unions, ""), util.append_diags(lret_expr(s2.start, cur, unions, ""), lret_expr(s2.end, cur, unions, "")));
    },
    ast.ExprFieldAccess(fa) => {
      out = lret_expr(fa.obj, cur, unions, "");
    },
    ast.ExprStructLit(sl) => {
      for field_value in sl.field_values {
        out = util.append_diags(out, lret_expr(field_value, cur, unions, ""));
      }
      if (sl.has_base) {
        out = util.append_diags(out, lret_expr(sl.base, cur, unions, ""));
      }
    },
    _ => {}
  }
  return out;
}

function lret_stmts(stmts: ast.Stmt[], s: Scope, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, lret_expr(v.init, cur, unions, rec_local_name(v)));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, lret_expr(r.value, cur, unions, ""));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, lret_expr(x.value, cur, unions, ""));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, lret_expr(a.value, cur, unions, ""));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, lret_expr(f.cond, cur, unions, ""));
        out = util.append_diags(out, lret_stmts(f.then_body, cur, unions));
        out = util.append_diags(out, lret_stmts(f.else_body, cur, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, lret_expr(w.cond, cur, unions, ""));
        out = util.append_diags(out, lret_stmts(w.body, cur, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, lret_expr(fr.iter, cur, unions, ""));
        out = util.append_diags(out, lret_stmts(fr.body, for_body_scope(fr, cur), unions));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, lret_expr(m.scrutinee, cur, unions, ""));
        for arm in m.arms {
          out = util.append_diags(out, lret_stmts(arm.body, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, lret_stmts(one, cur, unions));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function arm_int_literal(e: ast.Expr): boolean {
  let no_locals: string[] = [];
  return unsettled_tree(e, no_locals);
}

function unsettled_tree(e: ast.Expr, lits: string[]): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return int_literal_tree(e) || parser.float_settled_int(n);
    },
    ast.ExprIdent(id) => {
      return util.has_str(lits, id.name);
    },
    ast.ExprUnary(u) => {
      return (u.op == "-" || u.op == "+") && unsettled_tree(u.operand, lits);
    },
    ast.ExprBinary(b) => {
      return parser.int_literal_op(b.op) && unsettled_tree(b.left, lits) && unsettled_tree(b.right, lits);
    },
    ast.ExprCall(c) => {
      return unsettled_value_block(c, [], 0, lits);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function unsettled_part(e: ast.Expr, path: i32[], at: i32, lits: string[]): boolean {
  if (at >= path.len()) {
    return unsettled_tree(e, lits);
  }
  if let ast.ExprTuple(t) = e {
    return path[at] < t.elements.len() && unsettled_part(t.elements[path[at]], path, at + 1, lits);
  }
  if let ast.ExprCall(c) = e {
    return unsettled_value_block(c, path, at, lits);
  }
  return false;
}

function unsettled_value_block(c: ast.ExprCall, path: i32[], at: i32, lits: string[]): boolean {
  if (c.args.len() > 0) {
    return false;
  }
  if let ast.ExprLambda(lm) = c.callee {
    let branches: boolean = lm.body.len() == 1 && (lm.origin == parser.ORIGIN_IF_EXPR || lm.origin == parser.ORIGIN_MATCH_EXPR);
    if (lm.params.len() > 0 || !branches && lm.origin != parser.ORIGIN_BLOCK) {
      return false;
    }
    return unsettled_arms(lm.body, path, at, lits) > 0;
  }
  return false;
}

function unsettled_arms(body: ast.Stmt[], path: i32[], at: i32, outer: string[]): i32 {
  if (!mx_branch_yields(body)) {
    return 0;
  }
  let lits: string[] = outer;
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    lits = lit_locals_after(body[i], lits);
    i = i + 1;
  }
  match (body[i]) {
    ast.StmtReturn(r) => {
      if (unsettled_part(r.value, path, at, lits)) {
        return 1;
      }
      return 0 - 1;
    },
    ast.StmtIf(f) => {
      return unsettled_arm_sum(unsettled_arms(f.then_body, path, at, lits), unsettled_arms(f.else_body, path, at, lits));
    },
    ast.StmtMatch(m) => {
      let n: i32 = 0;
      for arm in m.arms {
        n = unsettled_arm_sum(n, unsettled_arms(arm.body, path, at, drop_lit_locals(lits, astwalk.pattern_binders(arm.pattern, []))));
      }
      return n;
    },
    _ => {}
  }
  return 0;
}

function unsettled_arm_sum(a: i32, b: i32): i32 {
  if (a < 0 || b < 0) {
    return 0 - 1;
  }
  return a + b;
}

function lit_locals_after(st: ast.Stmt, lits: string[]): string[] {
  if let ast.StmtVar(v) = st {
    let out: string[] = drop_lit_locals(lits, astwalk.binders_of(st, []));
    if (v.type_name.len() == 0 && !name_has_comma(v.name) && unsettled_tree(v.init, lits)) {
      return out.append(v.name);
    }
    return out;
  }
  return lits;
}

function drop_lit_locals(lits: string[], names: string[]): string[] {
  let out: string[] = [];
  for lit in lits {
    if (!util.has_str(names, lit)) {
      out = out.append(lit);
    }
  }
  return out;
}

function builtin_union_sig(name: string): UnionSig {
  if (name == "Option") {
    return UnionSig { name: name, variants: ["Some", "None"], is_try: false, is_enum: true, module: "", type_params: ["T"], instance: "", visible_from: [] };
  }
  if (name == "Result") {
    return UnionSig { name: name, variants: ["Ok", "Err"], is_try: false, is_enum: true, module: "", type_params: ["T", "E"], instance: "", visible_from: [] };
  }
  return UnionSig { name: "", variants: [], is_try: false, is_enum: false, module: "", type_params: [], instance: "", visible_from: [] };
}

function mx_enum_of(name: string, enums: parser.EnumDecl[]): string {
  for ed in enums {
    if (util.has_str(ed.variant_names, name)) {
      return ed.name;
    }
  }
  return "";
}

function mx_same_enum_family(an: string, bn: string, enums: parser.EnumDecl[]): boolean {
  if (an == bn) {
    return true;
  }
  let ab: string = parser.builtin_enum_of(an);
  if (ab.len() > 0 && ab == parser.builtin_enum_of(bn)) {
    return true;
  }
  let au: string = mx_enum_of(an, enums);
  if (au.len() > 0 && au == mx_enum_of(bn, enums)) {
    return true;
  }
  return false;
}

function mx_arm_compatible(a: VbStore, b: VbStore, elem: boolean, assigns: boolean, unions: UnionSig[], enums: parser.EnumDecl[]): boolean {
  if (owned_beside_view(a.t, b.t)) {
    return false;
  }
  if (elem && !assigns && (arm_unsettled(a) || arm_unsettled(b))) {
    return mx_arm_compatible(mx_default_width(a), mx_default_width(b), elem, assigns, unions, enums);
  }
  if (mx_int_literal_settles(a, b.t, elem) || mx_int_literal_settles(b, a.t, elem)) {
    return true;
  }
  if (is_float(a.t) && is_float(b.t) && (!elem || assigns)) {
    return type_eq(a.t, b.t) || is_poly_float(a.t) || is_poly_float(b.t);
  }
  if let typeinfo.TypeUnion(ua) = a.t {
    if let typeinfo.TypeUnion(ub) = b.t {
      if (ua.name == ub.name) {
        return mx_args_compatible(ua, ub, elem, assigns, unions, enums);
      }
    }
  }
  if (type_eq(a.t, b.t) || type_assignable(a.t, b.t, unions) || type_assignable(b.t, a.t, unions)) {
    return true;
  }
  return mx_parts_compatible(a, b, elem, assigns, unions, enums);
}

function owned_beside_view(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(aa) = a {
    if let typeinfo.TypeArray(ba) = b {
      return aa.view != ba.view;
    }
  }
  if let typeinfo.TypeString(aa) = a {
    if let typeinfo.TypeString(ba) = b {
      return aa.tag != ba.tag;
    }
  }
  return false;
}

function mx_args_compatible(a: typeinfo.TypeUnion, b: typeinfo.TypeUnion, elem: boolean, assigns: boolean, unions: UnionSig[], enums: parser.EnumDecl[]): boolean {
  if (a.args.len() == 0 || b.args.len() == 0) {
    return true;
  }
  if (a.args.len() != b.args.len()) {
    return false;
  }
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let i: i32 = 0;
  while (i < a.args.len()) {
    let x: typeinfo.Type = a.args[i];
    let y: typeinfo.Type = b.args[i];
    if (!is_unknown(x) && !is_unknown(y) && !mx_arm_compatible(VbStore { t: x, e: none }, VbStore { t: y, e: none }, elem, assigns, unions, enums)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function mx_parts_compatible(a: VbStore, b: VbStore, elem: boolean, assigns: boolean, unions: UnionSig[], enums: parser.EnumDecl[]): boolean {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  match (a.t) {
    typeinfo.TypeTuple(ta) => {
      match (b.t) {
        typeinfo.TypeTuple(tb) => {
          let n: i32 = ta.elements.len();
          if (tb.elements.len() != n) {
            return false;
          }
          let aes: ast.Expr[] = vb_tuple_elems(a.e, n);
          let bes: ast.Expr[] = vb_tuple_elems(b.e, n);
          let i: i32 = 0;
          while (i < n) {
            if (!mx_arm_compatible(VbStore { t: ta.elements[i], e: aes[i] }, VbStore { t: tb.elements[i], e: bes[i] }, elem, assigns, unions, enums)) {
              return false;
            }
            i = i + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeArray(aa) => {
      match (b.t) {
        typeinfo.TypeArray(ba) => {
          return mx_arm_compatible(mx_elem_store(a.e, aa.elem), mx_elem_store(b.e, ba.elem), false, assigns, unions, enums);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeMap(ma) => {
      match (b.t) {
        typeinfo.TypeMap(mb) => {
          return mx_arm_compatible(VbStore { t: ma.key, e: none }, VbStore { t: mb.key, e: none }, true, assigns, unions, enums)
            && mx_arm_compatible(mx_map_value_store(a.e, ma.value), mx_map_value_store(b.e, mb.value), false, assigns, unions, enums);
        },
        _ => {
          return false;
        }
      }
    },
    typeinfo.TypeStruct(sa) => {
      match (b.t) {
        typeinfo.TypeStruct(sb) => {
          return mx_same_enum_family(sa.name, sb.name, enums);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

function mx_elem_store(e: ast.Expr, elem: typeinfo.Type): VbStore {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  if let ast.ExprArray(ea) = e {
    if (ea.elements.len() > 0 && mx_unsettled_elements(ea.elements)) {
      return VbStore { t: elem, e: ea.elements[0] };
    }
  }
  return VbStore { t: elem, e: none };
}

function mx_map_value_store(e: ast.Expr, value: typeinfo.Type): VbStore {
  let vs: ast.Expr[] = mlit_values(e);
  if (vs.len() > 0 && mlit_is_desugared(e) && mx_unsettled_elements(vs)) {
    return VbStore { t: value, e: vs[0] };
  }
  return VbStore { t: value, e: ast.ExprUnknown { kind: "", line: 0, col: 0 } };
}

function mlit_values(e: ast.Expr): ast.Expr[] {
  if let ast.ExprCall(c) = e {
    if let ast.ExprFieldAccess(fa) = c.callee {
      if (fa.field == "insert" && c.args.len() == 2) {
        return mlit_values(fa.obj).append(c.args[1]);
      }
    }
  }
  let none: ast.Expr[] = [];
  return none;
}

function mx_unsettled_elements(es: ast.Expr[]): boolean {
  for x in es {
    if let ast.ExprArray(inner) = x {
      if (inner.elements.len() == 0 || !mx_unsettled_elements(inner.elements)) {
        return false;
      }
      continue;
    }
    if (!arm_int_literal(x)) {
      return false;
    }
  }
  return true;
}

function mx_default_width(a: VbStore): VbStore {
  if (arm_unsettled(a)) {
    return VbStore { t: t_i32(), e: ast.ExprUnknown { kind: "", line: 0, col: 0 } };
  }
  return a;
}

function mx_int_literal_settles(a: VbStore, t: typeinfo.Type, elem: boolean): boolean {
  return arm_unsettled(a) && (is_integer(t) || !elem && is_float(t));
}

function arm_unsettled(a: VbStore): boolean {
  return arm_int_literal(a.e) || is_poly_int(a.t);
}

function mx_arm_join(a: VbStore, b: VbStore): VbStore {
  if let typeinfo.TypeTuple(at) = a.t {
    if let typeinfo.TypeTuple(bt) = b.t {
      let n: i32 = at.elements.len();
      if (bt.elements.len() == n) {
        let aes: ast.Expr[] = vb_tuple_elems(a.e, n);
        let bes: ast.Expr[] = vb_tuple_elems(b.e, n);
        let elems: typeinfo.Type[] = [];
        let es: ast.Expr[] = [];
        let i: i32 = 0;
        while (i < n) {
          let j: VbStore = mx_arm_join(VbStore { t: at.elements[i], e: aes[i] }, VbStore { t: bt.elements[i], e: bes[i] });
          elems = elems.append(j.t);
          es = es.append(j.e);
          i = i + 1;
        }
        return VbStore { t: t_tuple(elems), e: ast.ExprTuple { elements: es, line: 0, col: 0 } };
      }
    }
  }
  if let typeinfo.TypeArray(aa) = a.t {
    if let typeinfo.TypeArray(ba) = b.t {
      if (aa.view == ba.view) {
        let el: VbStore = mx_arm_join(mx_elem_store(a.e, aa.elem), mx_elem_store(b.e, ba.elem));
        return VbStore { t: typeinfo.TypeArray { ...aa, elem: el.t }, e: mx_joined_literal(el, a.e) };
      }
    }
  }
  if let typeinfo.TypeMap(am) = a.t {
    if let typeinfo.TypeMap(bm) = b.t {
      let v: VbStore = mx_arm_join(mx_map_value_store(a.e, am.value), mx_map_value_store(b.e, bm.value));
      return VbStore { t: t_map(am.key, v.t), e: mx_joined_literal(v, a.e) };
    }
  }
  if (arm_unsettled(b)) {
    return a;
  }
  if (arm_unsettled(a)) {
    return b;
  }
  let t: typeinfo.Type = join_result_types(a.t, b.t);
  if (is_unknown(t)) {
    return a;
  }
  return VbStore { t: t, e: a.e };
}

function mx_joined_literal(el: VbStore, e: ast.Expr): ast.Expr {
  if (arm_unsettled(el)) {
    return e;
  }
  return ast.ExprUnknown { kind: "", line: 0, col: 0 };
}

struct MxFold { ok: boolean, acc: VbStore, bad: typeinfo.Type, bad_index: i32 }

function mx_fold_arms(types: typeinfo.Type[], exprs: ast.Expr[], unions: UnionSig[], enums: parser.EnumDecl[], if_form: boolean, assigns: boolean): MxFold {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let unjudged: MxFold = MxFold { ok: true, acc: VbStore { t: t_unknown("value block arms unjudged"), e: none }, bad: t_unknown(""), bad_index: 0 };
  if (types.len() == 0 || types.len() != exprs.len()) {
    return unjudged;
  }
  for ty in types {
    if (is_unknown(ty)) {
      return unjudged;
    }
  }
  let acc: VbStore = VbStore { t: types[0], e: exprs[0] };
  let j: i32 = 1;
  while (j < types.len()) {
    let arm: VbStore = VbStore { t: types[j], e: exprs[j] };
    let scalar: typeinfo.Type = scalar_numeric_join(acc.t, arm.t);
    if (!is_unknown(scalar) && scalar_arms_settled(acc, arm)) {
      acc = VbStore { t: scalar, e: none };
      j = j + 1;
      continue;
    }
    if (!mx_arm_compatible(acc, arm, false, assigns, unions, enums) || if_form && is_dyn_slot(acc.t) != is_dyn_slot(arm.t)) {
      return MxFold { ok: false, acc: acc, bad: arm.t, bad_index: j };
    }
    acc = mx_arm_join(acc, arm);
    j = j + 1;
  }
  return MxFold { ok: true, acc: acc, bad: acc.t, bad_index: 0 };
}

function vb_arms_fold(types: typeinfo.Type[], exprs: ast.Expr[], s: Scope): MxFold {
  let no_enums: parser.EnumDecl[] = [];
  return mx_fold_arms(types, exprs, s.unions.unions, no_enums, false, true);
}

function mx_e031(types: typeinfo.Type[], exprs: ast.Expr[], unions: UnionSig[], enums: parser.EnumDecl[], if_form: boolean, assigns: boolean, line: i32, col: i32): util.Diag[] {
  let f: MxFold = mx_fold_arms(types, exprs, unions, enums, if_form, assigns);
  return mx_fold_diags(f, line, col, if_form);
}

function mx_fold_diags(f: MxFold, line: i32, col: i32, if_form: boolean): util.Diag[] {
  let kind: string = if (if_form) { "if-expression branches differ: " } else { "match-expression arms differ: " };
  return mx_named_fold_diags(f, line, col, kind);
}

function mx_named_fold_diags(f: MxFold, line: i32, col: i32, kind: string): util.Diag[] {
  if (!f.ok) {
    return [dg_at("E031", kind + type_label(f.acc.t) + " vs " + type_label(f.bad), line, col)];
  }
  return [];
}

function mx_if_diags(f: ast.StmtIf, types: typeinfo.Type[], exprs: ast.Expr[], unions: UnionSig[], enums: parser.EnumDecl[], origin: string, origin_line: i32, origin_col: i32): util.Diag[] {
  let fold: MxFold = mx_fold_arms(types, exprs, unions, enums, origin == parser.ORIGIN_IF_EXPR, origin == parser.ORIGIN_MATCH_EXPR);
  let kind: string = "if-expression branches differ: ";
  if (origin == parser.ORIGIN_MATCH_EXPR) {
    kind = "match arms have incompatible types: ";
  }
  let line: i32 = expr_line(f.cond);
  let col: i32 = expr_col(f.cond);
  if (origin == parser.ORIGIN_IF_EXPR) {
    line = origin_line;
    col = origin_col;
  }
  if (!fold.ok && f.sugar.lits.len() > 0) {
    let at: i32 = 0;
    for arm in f.sugar.lits {
      if (mx_branch_yields(arm.body)) {
        if (at == fold.bad_index) {
          return mx_named_fold_diags(fold, arm.line, arm.col, kind);
        }
        at = at + 1;
      }
    }
    line = f.sugar.line;
    col = f.sugar.col;
  }
  return mx_named_fold_diags(fold, line, col, kind);
}

function mx_branch_yields(body: ast.Stmt[]): boolean {
  if (body.len() == 0) {
    return false;
  }
  let leading: ast.Stmt[] = [];
  let li: i32 = 0;
  while (li + 1 < body.len()) {
    leading = leading.append(body[li]);
    li = li + 1;
  }
  return leading.len() == 0 || !parser.branch_stmts_diverge(leading);
}

function mx_arm_result_type(e: ast.Expr, s: Scope): typeinfo.Type {
  let t: typeinfo.Type = check_expr(e, s);
  let (block, is_block) = value_block_body(e);
  if (is_unknown(t) && is_block) {
    return block_tail_arm_type(block, s);
  }
  if (is_integer(t) && gcall_open(e, s)) {
    if let typeinfo.TypeI32(n) = t {
      return typeinfo.TypeI32 { ...n, polymorphic: true };
    }
  }
  return unsettled_marked(t, e, s.lit_locals, false);
}

function unsettled_marked(t: typeinfo.Type, e: ast.Expr, lits: string[], literals: boolean): typeinfo.Type {
  return unsettled_marked_at(t, e, [], lits, literals);
}

function unsettled_marked_at(t: typeinfo.Type, e: ast.Expr, path: i32[], lits: string[], literals: boolean): typeinfo.Type {
  if let typeinfo.TypeTuple(tt) = t {
    let elems: typeinfo.Type[] = [];
    let k: i32 = 0;
    while (k < tt.elements.len()) {
      elems = elems.append(unsettled_marked_at(tt.elements[k], e, path.append(k), lits, literals));
      k = k + 1;
    }
    return t_tuple(elems);
  }
  if let typeinfo.TypeI32(i) = t {
    if (!i.is_char && (literals || path.len() > 0 || !arm_int_literal(e)) && unsettled_part(e, path, 0, lits)) {
      return typeinfo.TypeI32 { ...i, polymorphic: true };
    }
  }
  return t;
}

function value_block_body(e: ast.Expr): (ast.Stmt[], boolean) {
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lm) = c.callee {
      if (c.args.len() == 0 && lm.params.len() == 0 && lm.origin == parser.ORIGIN_BLOCK) {
        return (lm.body, true);
      }
    }
  }
  let none: ast.Stmt[] = [];
  return (none, false);
}

function block_tail_arm_type(body: ast.Stmt[], s: Scope): typeinfo.Type {
  if (body.len() == 0) {
    return t_unknown("empty value block");
  }
  if let ast.StmtReturn(r) = body[body.len() - 1] {
    if (parser.bare_return(r.value)) {
      return t_unknown("value block tail");
    }
    let bs: Scope = s;
    let i: i32 = 0;
    while (i < body.len() - 1) {
      bs = bind_stmt(body[i], bs);
      i = i + 1;
    }
    return mx_arm_result_type(r.value, bs);
  }
  return t_unknown("value block tail");
}

function mx_body_result_types(body: ast.Stmt[], s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  if (!mx_branch_yields(body)) {
    return out;
  }
  let cur: Scope = s;
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    cur = bind_stmt(body[i], cur);
    i = i + 1;
  }
  match (body[i]) {
    ast.StmtReturn(r) => {
      return out.append(mx_arm_result_type(r.value, cur));
    },
    ast.StmtIf(f) => {
      return mx_if_branch_types(f, cur);
    },
    ast.StmtMatch(m) => {
      return mx_match_arm_types(m, cur);
    },
    _ => {
      return out;
    }
  }
  return out;
}

function mx_body_result_exprs(body: ast.Stmt[]): ast.Expr[] {
  let out: ast.Expr[] = [];
  if (!mx_branch_yields(body)) {
    return out;
  }
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      return out.append(r.value);
    },
    ast.StmtIf(f) => {
      out = mx_body_result_exprs(f.then_body);
      for e in mx_body_result_exprs(f.else_body) {
        out = out.append(e);
      }
      return out;
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        for e in mx_body_result_exprs(arm.body) {
          out = out.append(e);
        }
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

function mx_match_arm_types(m: ast.StmtMatch, s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for arm in m.arms {
    let armScope: Scope = s;
    match (arm.pattern) {
      ast.PatVariant(pv) => {
        armScope = bind_variant_payloads(armScope, s, pv, check_expr(m.scrutinee, s));
      },
      _ => {}
    }
    for ty in mx_body_result_types(arm.body, armScope) {
      out = out.append(ty);
    }
  }
  return out;
}

function mx_if_branch_types(f: ast.StmtIf, s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = mx_body_result_types(f.then_body, s);
  for ty in mx_body_result_types(f.else_body, s) {
    out = out.append(ty);
  }
  return out;
}

function mx_expr(e: ast.Expr, s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() == 0) {
        match (c.callee) {
          ast.ExprLambda(lm) => {
            let local: string = vb_local_name(lm.body);
            if (lm.params.len() == 0 && parser.is_iflet_value_local(local)) {
              let stores: VbStore[] = vb_value_stores(lm.body, local, s);
              let types: typeinfo.Type[] = [];
              let exprs: ast.Expr[] = [];
              for store in stores {
                types = types.append(store.t);
                exprs = exprs.append(store.e);
              }
              out = util.append_diags(out, mx_e031(types, exprs, unions, enums, false, true, c.line, c.col));
            }
            if (lm.params.len() == 0 && lm.body.len() == 1) {
              let arms: ast.Expr[] = mx_body_result_exprs(lm.body);
              match (lm.body[0]) {
                ast.StmtMatch(m) => {
                  let mts: typeinfo.Type[] = mx_match_arm_types(m, s);
                  let enum_match: boolean = false;
                  if let typeinfo.TypeUnion(_) = check_expr(m.scrutinee, s) {
                    enum_match = true;
                  }
                  out = util.append_diags(out, mx_e031(mts, arms, unions, enums, false, !enum_match, expr_line(m.scrutinee), expr_col(m.scrutinee)));
                  out = util.append_diags(out, vb_pinned_ranges(mts, arms));
                },
                ast.StmtIf(f) => {
                  let fts: typeinfo.Type[] = mx_if_branch_types(f, s);
                  out = util.append_diags(out, mx_if_diags(f, fts, arms, unions, enums, lm.origin, c.line, c.col));
                  out = util.append_diags(out, vb_pinned_ranges(fts, arms));
                },
                _ => {}
              }
            }
          },
          _ => {}
        }
      }
      out = util.append_diags(out, mx_expr(c.callee, s, unions, enums));
      for arg in c.args {
        out = util.append_diags(out, mx_expr(arg, s, unions, enums));
      }
    },
    ast.ExprLambda(lm) => {
      let lsc: Scope = s;
      for param in lm.params {
        lsc = lsc.bind(param.name, s.resolve_param(param));
      }
      out = util.append_diags(out, mx_stmts(lm.body, lsc, unions, enums));
    },
    ast.ExprBinary(b) => {
      out = util.append_diags(mx_expr(b.left, s, unions, enums), mx_expr(b.right, s, unions, enums));
    },
    ast.ExprUnary(u) => {
      out = mx_expr(u.operand, s, unions, enums);
    },
    ast.ExprArray(a) => {
      for element in a.elements {
        out = util.append_diags(out, mx_expr(element, s, unions, enums));
      }
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, mx_expr(element, s, unions, enums));
      }
    },
    ast.ExprIndex(ix) => {
      out = util.append_diags(mx_expr(ix.array, s, unions, enums), mx_expr(ix.index, s, unions, enums));
    },
    ast.ExprSlice(s2) => {
      out = util.append_diags(mx_expr(s2.array, s, unions, enums), util.append_diags(mx_expr(s2.start, s, unions, enums), mx_expr(s2.end, s, unions, enums)));
    },
    ast.ExprFieldAccess(fa) => {
      out = mx_expr(fa.obj, s, unions, enums);
    },
    ast.ExprStructLit(sl) => {
      for field_value in sl.field_values {
        out = util.append_diags(out, mx_expr(field_value, s, unions, enums));
      }
      if (sl.has_base) {
        out = util.append_diags(out, mx_expr(sl.base, s, unions, enums));
      }
    },
    ast.ExprUnknown(u) => {
      if (util.is_f64_range_kind(u.kind)) {
        out = out.append(dg_at("P002", util.f64_range_message(u.kind), u.line, u.col));
      }
    },
    _ => {}
  }
  return out;
}

function mx_stmts(stmts: ast.Stmt[], s: Scope, unions: UnionSig[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, mx_expr(v.init, cur, unions, enums));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, mx_expr(r.value, cur, unions, enums));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, mx_expr(x.value, cur, unions, enums));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, mx_expr(a.value, cur, unions, enums));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, mx_expr(f.cond, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(f.then_body, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(f.else_body, cur, unions, enums));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, mx_expr(w.cond, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(w.body, cur, unions, enums));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, mx_expr(fr.iter, cur, unions, enums));
        out = util.append_diags(out, mx_stmts(fr.body, for_body_scope(fr, cur), unions, enums));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, mx_expr(m.scrutinee, cur, unions, enums));
        for arm in m.arms {
          let armScope: Scope = cur;
          match (arm.pattern) {
            ast.PatVariant(pv) => {
              armScope = bind_variant_payloads(armScope, cur, pv, check_expr(m.scrutinee, cur));
            },
            _ => {}
          }
          out = util.append_diags(out, mx_stmts(arm.body, armScope, unions, enums));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, mx_stmts(one, cur, unions, enums));
      },
      ast.StmtUnknown(u) => {
        if (u.kind == "value branch has no trailing expression") {
          out = out.append(dg_at("E061", parser.BLOCK_VALUE_REQUIRED_MESSAGE, u.line, u.col));
        }
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function find_struct_sig(structs: StructTable, name: string): StructSig {
  let first: i32 = 0 - 1;
  let k: i32 = structs.index.chain(name);
  while (k >= 0) {
    if (structs.structs[k].name == name) {
      if (structs.structs[k].enum_owner.len() == 0) {
        return structs.structs[k];
      }
      if (first < 0) {
        first = k;
      }
    }
    k = structs.index.next[k];
  }
  if (first >= 0) {
    return structs.structs[first];
  }
  let none: string[] = [];
  let nonet: typeinfo.Type[] = [];
  let none_tp: string[] = [];
  let none_ftn: string[] = [];
  return StructSig { name: "", field_names: none, field_types: nonet, type_params: none_tp, field_type_names: none_ftn, variant_field_names: none, derives: [], enum_owner: "", opaque: false, module: "" };
}

function find_variant_sig(structs: StructTable, name: string): StructSig {
  let bare: string = variant_pattern_name(name);
  let owner: string = variant_pattern_owner(name);
  if (owner.len() > 0) {
    let k: i32 = structs.index.chain(bare);
    while (k >= 0) {
      if (structs.structs[k].name == bare && structs.structs[k].enum_owner == owner) {
        return structs.structs[k];
      }
      k = structs.index.next[k];
    }
  }
  let k2: i32 = structs.index.chain(bare);
  while (k2 >= 0) {
    if (structs.structs[k2].name == bare && structs.structs[k2].enum_owner.len() > 0) {
      return structs.structs[k2];
    }
    k2 = structs.index.next[k2];
  }
  return find_struct_sig(structs, bare);
}

function slit_names_no_struct(structs: StructTable, type_name: string): boolean {
  let base: string = util.base_type_name(type_name);
  return find_struct_sig(structs, base).name.len() == 0 && !parser.is_reserved_struct_name(base);
}

function slit_diags(e: ast.Expr, structs: StructTable): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprStructLit(sl) => {
      for field_value in sl.field_values {
        out = util.append_diags(out, slit_diags(field_value, structs));
      }
      if (lit_names_no_struct(sl.type_name, structs)) {
        out = out.append(dg_at("E043", "cannot find struct \"" + util.demangle(sl.type_name) + "\" in this scope", sl.line, sl.col));
      }
      let usig: StructSig = find_struct_sig(structs, sl.type_name);
      if (usig.name.len() > 0) {
        let fi: i32 = 0;
        while (fi < sl.field_names.len()) {
          if (!util.has_str(usig.field_names, sl.field_names[fi])) {
            let d: util.Diag = dg_at("E043", "struct " + util.demangle(sl.type_name) + " has no field \"" + sl.field_names[fi] + "\"", sl.line, sl.col);
            out = out.append(literal_field_fix(d, sl, fi, usig.field_names));
          }
          fi = fi + 1;
        }
      } else if (slit_names_no_struct(structs, sl.type_name)) {
        out = out.append(dg_at("E043", "cannot find struct \"" + util.demangle(sl.type_name) + "\" in this scope", sl.line, sl.col));
      }
      if (sl.has_base) {
        out = util.append_diags(out, slit_diags(sl.base, structs));
      } else {
        let ssig: StructSig = find_struct_sig(structs, sl.type_name);
        if (ssig.name.len() > 0) {
          for field_name in ssig.field_names {
            if (!util.has_str(sl.field_names, field_name)) {
              out = out.append(dg_at("E005", "missing field \"" + field_name + "\" in this " + util.demangle(sl.type_name) + " literal", sl.line, sl.col));
            }
          }
        }
      }
    },
    ast.ExprBinary(b) => {
      out = util.append_diags(slit_diags(b.left, structs), slit_diags(b.right, structs));
    },
    ast.ExprUnary(u) => {
      out = slit_diags(u.operand, structs);
    },
    ast.ExprCall(c) => {
      out = slit_diags(c.callee, structs);
      for arg in c.args {
        out = util.append_diags(out, slit_diags(arg, structs));
      }
    },
    ast.ExprArray(a) => {
      for element in a.elements {
        out = util.append_diags(out, slit_diags(element, structs));
      }
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, slit_diags(element, structs));
      }
    },
    ast.ExprIndex(ix) => {
      out = util.append_diags(slit_diags(ix.array, structs), slit_diags(ix.index, structs));
    },
    ast.ExprSlice(s2) => {
      out = util.append_diags(slit_diags(s2.array, structs), util.append_diags(slit_diags(s2.start, structs), slit_diags(s2.end, structs)));
    },
    ast.ExprFieldAccess(fa) => {
      out = slit_diags(fa.obj, structs);
    },
    ast.ExprLambda(lm) => {
      out = stmts_slit_diags(lm.body, structs);
    },
    _ => {}
  }
  return out;
}

function lit_names_no_struct(name: string, structs: StructTable): boolean {
  if (name == "Self" || parser.is_reserved_struct_name(name) || !plain_ident(name)) {
    return false;
  }
  return find_variant_sig(structs, name).name.len() == 0;
}

function stmts_slit_diags(stmts: ast.Stmt[], structs: StructTable): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, slit_diags(v.init, structs));
        out = util.append_diags(out, destructure_covers_diags(v, structs));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, slit_diags(r.value, structs));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, slit_diags(x.value, structs));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, slit_diags(a.value, structs));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, slit_diags(f.cond, structs));
        out = util.append_diags(out, struct_arms_cover_diags(f.sugar.strct, structs));
        out = util.append_diags(out, stmts_slit_diags(f.then_body, structs));
        out = util.append_diags(out, stmts_slit_diags(f.else_body, structs));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, slit_diags(w.cond, structs));
        out = util.append_diags(out, stmts_slit_diags(w.body, structs));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, slit_diags(fr.iter, structs));
        out = util.append_diags(out, stmts_slit_diags(fr.body, structs));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, slit_diags(m.scrutinee, structs));
        for arm in m.arms {
          out = util.append_diags(out, stmts_slit_diags(arm.body, structs));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, stmts_slit_diags(one, structs));
      },
      _ => {}
    }
  }
  return out;
}

function sugar_arm_bodies(sugar: ast.MatchSugar): ast.Stmt[][] {
  let out: ast.Stmt[][] = [];
  for arm in sugar.tup {
    out = out.append(arm.body);
  }
  for arm in sugar.strct {
    out = out.append(arm.body);
  }
  for arm in sugar.lits {
    out = out.append(arm.body);
  }
  for arm in sugar.arms {
    out = out.append(arm.body);
  }
  return out;
}

// exit_bound: a local named `exit` is in scope, so a call to `exit` is not the builtin.
function block_exits(stmts: ast.Stmt[], exit_bound: boolean): boolean {
  return block_leaves(stmts, false, exit_bound);
}

function block_diverges(stmts: ast.Stmt[], exit_bound: boolean): boolean {
  return block_leaves(stmts, true, exit_bound);
}

function block_leaves(stmts: ast.Stmt[], jumps: boolean, exit_bound: boolean): boolean {
  if (stmts.len() == 0) {
    return false;
  }
  let last: ast.Stmt = stmts[stmts.len() - 1];
  let bound: boolean = exit_bound || lets_bind_exit(stmts);
  match (last) {
    ast.StmtExpr(x) => {
      return !bound && parser.calls_exit(x.value);
    },
    ast.StmtBreak(_) => {
      return jumps;
    },
    ast.StmtContinue(_) => {
      return jumps;
    },
    ast.StmtReturn(_) => {
      return true;
    },
    ast.StmtIf(f) => {
      return if_leaves(f, jumps, bound);
    },
    ast.StmtWhile(w) => {
      match (w.cond) {
        ast.ExprBool(b) => {
          return b.value && !loop_can_break(w.body, w.label, false);
        },
        _ => {
          return false;
        }
      }
    },
    ast.StmtMatch(m) => {
      return match_leaves(m, jumps, bound);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function if_leaves(f: ast.StmtIf, jumps: boolean, bound: boolean): boolean {
  let bodies: ast.Stmt[][] = sugar_arm_bodies(f.sugar);
  if (bodies.len() > 0) {
    return sugar_leaves(f.sugar, bodies, jumps, bound || util.has_str(sugar_binders(f.sugar), "exit"));
  }
  match (f.cond) {
    ast.ExprBool(b) => {
      if (b.value) {
        return block_leaves(f.then_body, jumps, bound);
      }
      return block_leaves(f.else_body, jumps, bound);
    },
    _ => {}
  }
  return block_leaves(f.then_body, jumps, bound) && block_leaves(f.else_body, jumps, bound);
}

function sugar_leaves(sugar: ast.MatchSugar, bodies: ast.Stmt[][], jumps: boolean, bound: boolean): boolean {
  if (sugar.origin == "let_else") {
    return block_leaves(bodies[0], jumps, bound);
  }
  for body in bodies {
    if (!block_leaves(body, jumps, bound)) {
      return false;
    }
  }
  return true;
}

function match_leaves(m: ast.StmtMatch, jumps: boolean, bound: boolean): boolean {
  if (m.arms.len() == 0) {
    return false;
  }
  if (m.origin == "let_else") {
    return block_leaves(m.arms[0].body, jumps, bound || pattern_binds_exit(m.arms[0].pattern));
  }
  for arm in m.arms {
    if (!block_leaves(arm.body, jumps, bound || pattern_binds_exit(arm.pattern))) {
      return false;
    }
  }
  return true;
}

function lets_bind_exit(stmts: ast.Stmt[]): boolean {
  for st in stmts {
    if let ast.StmtVar(v) = st {
      if (util.has_str(astwalk.append_bound_name([], v.name), "exit")) {
        return true;
      }
    }
  }
  return false;
}

function pattern_binds_exit(p: ast.Pattern): boolean {
  return util.has_str(astwalk.pattern_binders(p, []), "exit");
}

function sugar_binders(sugar: ast.MatchSugar): string[] {
  let out: string[] = [];
  for arm in sugar.tup {
    for b in arm.binds {
      out = out.append(b);
    }
    out = out.append(arm.at_binding);
    for p in arm.elem_pats {
      out = astwalk.pattern_binders(p, out);
    }
  }
  for arm in sugar.strct {
    for b in arm.binds {
      out = out.append(b);
    }
    out = out.append(arm.at_binding);
    for p in arm.field_pats {
      out = astwalk.pattern_binders(p, out);
    }
  }
  for arm in sugar.lits {
    out = out.append(arm.at_binding);
  }
  for arm in sugar.arms {
    out = astwalk.pattern_binders(arm.pattern, out);
  }
  return out;
}

function loop_can_break(stmts: ast.Stmt[], label: string, nested: boolean): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtBreak(bk) => {
        if (bk.label.len() == 0) {
          if (!nested) {
            return true;
          }
        } else if (bk.label == label) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (expr_can_break(w.cond, label, nested) || loop_can_break(w.body, label, true)) {
          return true;
        }
      },
      ast.StmtFor(fr) => {
        if (expr_can_break(fr.iter, label, nested) || loop_can_break(fr.body, label, true)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (expr_can_break(f.cond, label, nested) || loop_can_break(f.then_body, label, nested) || loop_can_break(f.else_body, label, nested)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        if (expr_can_break(m.scrutinee, label, nested)) {
          return true;
        }
        for arm in m.arms {
          if (arm.has_guard && expr_can_break(arm.guard, label, nested) || loop_can_break(arm.body, label, nested)) {
            return true;
          }
        }
      },
      ast.StmtDefer(_) => {},
      _ => {
        if (astwalk.fold_stmt_pruned(
          stmt, false, (e: ast.Expr, own a: boolean): boolean => a || value_block_can_break(e, label, nested),
          not_a_scope_root,
        )) {
          return true;
        }
      }
    }
  }
  return false;
}

function expr_can_break(e: ast.Expr, label: string, nested: boolean): boolean {
  return astwalk.fold_expr_pruned(
    e, false, (x: ast.Expr, own a: boolean): boolean => a || value_block_can_break(x, label, nested),
    not_a_scope_root,
  );
}

function value_block_can_break(e: ast.Expr, label: string, nested: boolean): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (parser.is_value_block(c)) {
        return loop_can_break(parser.vb_body(c), label, nested);
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function label_in_scope(labels: string[], name: string): boolean {
  for label in labels {
    if (label == name) {
      return true;
    }
  }
  return false;
}

function loop_diags_in_exprs(st: ast.Stmt, in_loop: boolean, labels: string[]): util.Diag[] {
  return astwalk.fold_stmt_pruned(
    st, no_diags(), (e: ast.Expr, own a: util.Diag[]): util.Diag[] => {
      match (e) {
        ast.ExprCall(c) => {
          if (parser.is_value_block(c)) {
            return util.append_diags(a, loop_diags(parser.vb_body(c), in_loop, labels));
          }
          return a;
        },
        ast.ExprLambda(lm) => {
          let nolabels: string[] = [];
          return util.append_diags(a, loop_diags(lm.body, false, nolabels));
        },
        _ => {
          return a;
        }
      }
      return a;
    },
    not_a_scope_root,
  );
}

function not_a_scope_root(e: ast.Expr): boolean {
  match (e) {
    ast.ExprLambda(_) => {
      return false;
    },
    ast.ExprCall(c) => {
      return !parser.is_value_block(c);
    },
    _ => {
      return true;
    }
  }
  return true;
}

function loop_diags(stmts: ast.Stmt[], in_loop: boolean, labels: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtBreak(bk) => {
        if (!in_loop) {
          out = out.append(dg_at("E011", "break outside of a loop", bk.line, bk.col));
        } else if (bk.label.len() > 0 && !label_in_scope(labels, bk.label)) {
          out = out.append(dg_at("E058", "break label \"" + bk.label + "\" does not match any enclosing loop", bk.line, bk.col));
        }
      },
      ast.StmtContinue(ck) => {
        if (!in_loop) {
          out = out.append(dg_at("E011", "continue outside of a loop", ck.line, ck.col));
        } else if (ck.label.len() > 0 && !label_in_scope(labels, ck.label)) {
          out = out.append(dg_at("E058", "continue label \"" + ck.label + "\" does not match any enclosing loop", ck.line, ck.col));
        }
      },
      ast.StmtWhile(w) => {
        let wl: string[] = labels;
        if (w.label.len() > 0) {
          wl = labels.append(w.label);
        }
        out = util.append_diags(out, loop_diags(w.body, true, wl));
      },
      ast.StmtFor(fr) => {
        let fl: string[] = labels;
        if (fr.label.len() > 0) {
          fl = labels.append(fr.label);
        }
        out = util.append_diags(out, loop_diags(fr.body, true, fl));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, loop_diags(f.then_body, in_loop, labels));
        out = util.append_diags(out, loop_diags(f.else_body, in_loop, labels));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, loop_diags(arm.body, in_loop, labels));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, loop_diags(one, in_loop, labels));
      },
      _ => {
        out = util.append_diags(out, loop_diags_in_exprs(stmt, in_loop, labels));
      }
    }
  }
  return out;
}

pub function count_type_args(t: string): i32 {
  let r: parser.TypeRef = parser.parse_type_ref(t);
  if (r.is_tuple || r.is_view || r.array_depth > 0 || r.args.len() == 0) {
    return 0 - 1;
  }
  return r.args.len();
}

function struct_type_param_count(structs: parser.StructDecl[], name: string): i32 {
  for sd in structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return sd.type_params.len();
    }
  }
  return 0 - 1;
}

function struct_decl_line(structs: parser.StructDecl[], name: string): i32 {
  for sd in structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return sd.line;
    }
  }
  return 0;
}

function struct_decl_col(structs: parser.StructDecl[], name: string): i32 {
  for sd in structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return sd.col;
    }
  }
  return 0;
}

function dot_index(s: string): i32 {
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b'.') {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function variant_pattern_name(name: string): string {
  let d: i32 = dot_index(name);
  if (d < 0) {
    return name;
  }
  return slice_unchecked(name, d + 1, name.len()) + "";
}

function variant_pattern_owner(name: string): string {
  let d: i32 = dot_index(name);
  if (d < 0) {
    return "";
  }
  return slice_unchecked(name, 0, d) + "";
}

function type_arity_diag(t: string, structs: parser.StructDecl[], enums: parser.EnumDecl[]): util.Diag[] {
  let out: util.Diag[] = [];
  while (t.len() > 2 && slice_unchecked(t, t.len() - 2, t.len()) == "[]") {
    t = slice_unchecked(t, 0, t.len() - 2) + "";
  }
  let nargs: i32 = count_type_args(t);
  if (nargs < 0) {
    return out;
  }
  let base: string = util.base_type_name(t);
  let shadows: boolean = parser.is_reserved_struct_name(base) || parser.is_reserved_enum_name(base);
  let tpc: i32 = struct_type_param_count(structs, base);
  if (tpc >= 0) {
    if (nargs != tpc && !shadows) {
      out = out.append(dg_at("E019", util.arity_message("struct " + base, tpc, nargs, "type argument"), struct_decl_line(structs, base), struct_decl_col(structs, base)));
    }
    return out;
  }
  if (parser.is_reserved_struct_name(base)) {
    let stp: i32 = parser.reserved_struct_tparams(base).len();
    if (nargs != stp) {
      out = out.append(dg_at("E019", util.arity_message("struct " + base, stp, nargs, "type argument"), 0, 0));
    }
    return out;
  }
  if (parser.is_reserved_enum_name(base)) {
    let etp: i32 = parser.reserved_enum_tparams(base).len();
    if (nargs != etp) {
      out = out.append(dg_at("E019", util.arity_message("enum " + base, etp, nargs, "type argument"), 0, 0));
    }
    return out;
  }
  for ed in enums {
    if (ed.name == base && ed.type_params.len() != nargs && !shadows) {
      return out.append(dg_at("E019", util.arity_message("enum " + base, ed.type_params.len(), nargs, "type argument"), ed.line, ed.col));
    }
  }
  return out;
}

function variant_payload_count(name: string, structs: StructTable): i32 {
  let sd: StructSig = find_variant_sig(structs, name);
  if (sd.name.len() == 0 || !util.has_str(sd.field_names, "__ev")) {
    return 0 - 1;
  }
  let c: i32 = 0;
  for field_name in sd.field_names {
    let fn: string = field_name;
    if (fn.len() >= 4 && slice_unchecked(fn, 0, 4) == "__ev") {
      c = c + 1;
    }
  }
  return c;
}

function payload_arity_diags(pv: ast.PatVariant, variant: string, structs: StructTable, unions: UnionTable, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let pc: i32 = variant_payload_count(variant, structs);
  let owner: UnionSig = union_sig_of_variant(variant_pattern_name(variant), unions);
  if (pc < 0 && owner.name.len() > 0 && !owner.is_enum) {
    pc = 1;
  }
  if (pc >= 0) {
    let nb: i32 = pv.extra_bindings.len();
    if (pv.binding.len() > 0) {
      nb = nb + 1;
    }
    if (nb != pc) {
      out = out.append(dg_at("E015", payload_count_message(shown_variant_in(structs, pv.type_name), pc, nb), line, col));
    }
  }
  return out;
}

function variant_owner_count(name: string, structs: StructTable): i32 {
  let owners: string[] = [];
  let k: i32 = structs.index.chain(name);
  while (k >= 0) {
    let sd: StructSig = structs.structs[k];
    if (sd.name == name && sd.enum_owner.len() > 0 && !util.has_str(owners, sd.enum_owner)) {
      owners = owners.append(sd.enum_owner);
    }
    k = structs.index.next[k];
  }
  return owners.len();
}

function record_pattern_diags(pvin: ast.PatVariant, structs: StructTable, line: i32, col: i32): util.Diag[] {
  let pv: ast.PatVariant = ast.PatVariant { ...pvin, type_name: shown_variant_in(structs, pvin.type_name) };
  let out: util.Diag[] = [];
  let ss: StructSig = find_variant_sig(structs, pvin.type_name);
  if (ss.name.len() == 0) {
    return out;
  }
  let decl: string[] = ss.variant_field_names;
  if (decl.len() == 0) {
    return out.append(dg_at("E015", "variant " + pv.type_name + " has positional payloads; match it as " + pv.type_name + "(...), not " + pv.type_name + " { ... }", line, col));
  }
  let bound: string[] = [];
  for field_name in pv.field_names {
    let nm: string = field_name;
    if (!util.has_str(decl, nm)) {
      out = out.append(dg_at("E015", "variant " + pv.type_name + " has no field \"" + nm + "\"", line, col));
    } else if (util.has_str(bound, nm)) {
      out = out.append(dg_at("E015", "field \"" + nm + "\" bound more than once in pattern for " + pv.type_name, line, col));
    } else {
      bound = bound.append(nm);
    }
  }
  if (bound.len() != decl.len() && !pv.rest_written) {
    out = out.append(missing_pattern_fields_diag(pv.type_name, decl, line, col));
  }
  return out;
}

function missing_pattern_fields_diag(name: string, decl: string[], line: i32, col: i32): util.Diag {
  let listed: string = "";
  let d: i32 = 0;
  while (d < decl.len()) {
    if (d > 0) {
      listed = listed + ", ";
    }
    listed = listed + decl[d];
    d = d + 1;
  }
  return dg_at("E015", "named-field pattern for " + util.demangle(name) + " must bind all " + util.i32_to_string(decl.len()) + " field(s) (" + listed + "), or end in `..` to leave the rest out", line, col);
}

function destructure_covers_diags(v: ast.StmtVar, structs: StructTable): util.Diag[] {
  if (!parser.is_struct_destr_marker(v.type_name)) {
    return [];
  }
  let (fields, _) = struct_destr_fields(v.type_name);
  return struct_pattern_covers_diags(struct_destr_name(v.type_name), fields, parser.destr_marker_split(v.type_name).rest_written, structs, v.line, v.col);
}

function struct_arms_cover_diags(arms: ast.StructArm[], structs: StructTable): util.Diag[] {
  let out: util.Diag[] = [];
  for sa in arms {
    if (!sa.is_wild) {
      out = util.append_diags(out, struct_pattern_covers_diags(sa.type_name, sa.fields, sa.rest_written, structs, sa.line, sa.col));
    }
  }
  return out;
}

function struct_pattern_covers_diags(name: string, fields: string[], rest: boolean, structs: StructTable, line: i32, col: i32): util.Diag[] {
  let sig: StructSig = find_struct_sig(structs, name);
  if (rest || sig.name.len() == 0) {
    return [];
  }
  for f in fields {
    if (!util.has_str(sig.field_names, f)) {
      return [];
    }
  }
  for f in sig.field_names {
    if (!util.has_str(fields, f)) {
      return [missing_pattern_fields_diag(name, sig.field_names, line, col)];
    }
  }
  return [];
}

function payload_slot_type_name(ss: StructSig, idx: i32): string {
  let want: string = "__ev";
  if (idx > 0) {
    want = "__ev" + util.i32_to_string(idx);
  }
  let i: i32 = 0;
  while (i < ss.field_names.len()) {
    if (ss.field_names[i] == want && i < ss.field_type_names.len()) {
      return util.base_type_name(ss.field_type_names[i]);
    }
    i = i + 1;
  }
  return "";
}

function payloadless_binder_diags(pv: ast.PatVariant, structs: StructTable, unions: UnionTable, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let ss: StructSig = find_variant_sig(structs, pv.type_name);
  if (ss.name.len() == 0) {
    return out;
  }
  let slot: i32 = 0;
  while (slot < pv.extra_bindings.len() + 1) {
    let nm: string = pv.binding;
    if (slot > 0) {
      nm = pv.extra_bindings[slot - 1];
    }
    if (nm.len() > 0 && nm != "_") {
      let pt: string = payload_slot_type_name(ss, slot);
      if (pt.len() > 0 && union_of_variant(nm, unions) == pt && variant_payload_count(nm, structs) < 0) {
        out = out.append(dg_at("E015", nm + " is a payload-less variant of enum " + pt + ", but a bare name in a payload slot is a binder that matches every value — write `" + nm + "()` to match the variant, or rename the binder", line, col));
      }
    }
    slot = slot + 1;
  }
  return out;
}

function generic_binder_diags(pv: ast.PatVariant, s: Scope, whole: typeinfo.Type, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  let ss: StructSig = find_variant_sig(s.structs, pv.type_name);
  let slot: i32 = 0;
  while (slot < pv.extra_bindings.len() + 1) {
    let nm: string = pv.binding;
    if (slot > 0) {
      nm = pv.extra_bindings[slot - 1];
    }
    if let typeinfo.TypeUnion(u) = variant_pattern_payload_type(s, pv.type_name, whole, slot) {
      let declared: string = "";
      if (ss.name.len() > 0) {
        declared = payload_slot_type_name(ss, slot);
      }
      let owner: string = scope_variant_owner(nm, s);
      if (owner.len() == 0) {
        owner = parser.builtin_enum_of(nm);
      }
      if (nm.len() > 0 && nm != "_" && declared != u.name && owner == u.name && variant_payload_count(nm, s.structs) < 0) {
        out = out.append(dg_at("E015", nm + " is a payload-less variant of enum " + u.name + ", but a bare name in a payload slot is a binder that matches every value — write `" + nm + "()` to match the variant, or rename the binder", line, col));
      }
    }
    slot = slot + 1;
  }
  return out;
}

function match_stmt_own_lambdas(st: ast.Stmt, structs: StructTable, unions: UnionTable): util.Diag[] {
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, match_diags(lm.body, structs, unions));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, not_into_lambda);
}

function sugar_unreachable_diags(sg: ast.MatchSugar, t: typeinfo.Type, s: Scope): util.Diag[] {
  if (sg.origin != "") {
    return [];
  }
  let out: util.Diag[] = util.append_diags(tuple_unreachable_diags(sg.tup), struct_unreachable_diags(sg.strct));
  return util.append_diags(out, variant_unreachable_diags(sg.arms, t, s));
}

function variant_unreachable_diags(arms: ast.MatchArm[], t: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if let typeinfo.TypeUnion(_) = t {
    let covered: string[] = [];
    let all: boolean = false;
    for arm in arms {
      if (all) {
        out = out.append(dg_at("E026", "arm is unreachable — a preceding arm matches every value", arm.line, arm.col));
        continue;
      }
      match (arm.pattern) {
        ast.PatWildcard(_) => {
          if (!arm.has_guard) {
            all = true;
          }
        },
        ast.PatVariant(pv) => {
          let p: CoverPat = typed_pattern_cover(arm.pattern, t, s);
          if (util.has_str(covered, p.ctor)) {
            out = out.append(dg_at("E028", "variant \"" + shown_variant_in(s.structs, pv.type_name) + "\" already covered earlier in this match", arm.line, arm.col));
          } else if (!arm.has_guard && cover_binders_only(p.args)) {
            covered = covered.append(p.ctor);
          }
        }
      }
    }
  }
  return out;
}

function cover_binders_only(args: CoverPat[]): boolean {
  for p in args {
    if (p.opaque || p.ctor.len() > 0 && p.ctor != "()" && p.ctor != "{}") {
      return false;
    }
    if (!cover_binders_only(p.args)) {
      return false;
    }
  }
  return true;
}

function tuple_unreachable_diags(arms: ast.TupArm[]): util.Diag[] {
  let out: util.Diag[] = [];
  let covered: boolean = false;
  for a in arms {
    if (covered) {
      out = out.append(dg_at("E026", "arm is unreachable — a preceding arm matches every value", a.line, a.col));
    }
    if (!a.has_guard && (a.is_wild || tuple_binders_only(a.elem_kinds, a.elem_pats))) {
      covered = true;
    }
  }
  return out;
}

function struct_unreachable_diags(arms: ast.StructArm[]): util.Diag[] {
  let out: util.Diag[] = [];
  let covered: boolean = false;
  for a in arms {
    if (covered) {
      out = out.append(dg_at("E026", "arm is unreachable — a preceding arm matches every value", a.line, a.col));
    }
    if (!a.has_guard && (a.is_wild || binds_only(a.field_kinds))) {
      covered = true;
    }
  }
  return out;
}

function tuple_binders_only(kinds: i32[], pats: ast.Pattern[]): boolean {
  let i: i32 = 0;
  while (i < kinds.len()) {
    if (kinds[i] == 4 && i < pats.len()) {
      if let ast.PatVariant(p) = pats[i] {
        if (!tuple_binders_only(p.tup_kinds, p.tup_pats)) {
          return false;
        }
      } else {
        return false;
      }
    } else if (kinds[i] != 0 && kinds[i] != 1) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function match_diags(stmts: ast.Stmt[], structs: StructTable, unions: UnionTable): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtMatch(m) => {
        let seen: string[] = [];
        let a: i32 = 0;
        while (a < m.arms.len()) {
          match (m.arms[a].pattern) {
            ast.PatWildcard(_) => {
              if (a < m.arms.len() - 1) {
                out = out.append(dg_at("E026", "wildcard `_` arm must be last in the match", m.arms[a].line, m.arms[a].col));
              }
            },
            ast.PatVariant(pv) => {
              out = util.append_diags(out, payloadless_binder_diags(pv, structs, unions, m.arms[a].line, m.arms[a].col));
              if (pv.type_name.len() > 0) {
                if (util.has_str(seen, pv.type_name)) {
                  out = out.append(dg_at("E028", "variant \"" + shown_variant_in(structs, pv.type_name) + "\" already covered earlier in this match", m.arms[a].line, m.arms[a].col));
                } else if (!m.arms[a].has_guard) {
                  seen = seen.append(pv.type_name);
                }
                if (parser.is_record_pattern(pv)) {
                  out = util.append_diags(out, record_pattern_diags(pv, structs, m.arms[a].line, m.arms[a].col));
                } else if (dot_index(pv.type_name) >= 0 || variant_owner_count(pv.type_name, structs) < 2) {
                  out = util.append_diags(out, payload_arity_diags(pv, pv.type_name, structs, unions, m.arms[a].line, m.arms[a].col));
                }
              }
            }
          }
          out = util.append_diags(out, match_diags(m.arms[a].body, structs, unions));
          a = a + 1;
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, match_diags(f.then_body, structs, unions));
        out = util.append_diags(out, match_diags(f.else_body, structs, unions));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, match_diags(w.body, structs, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, match_diags(fr.body, structs, unions));
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, match_diags(one, structs, unions));
      },
      _ => {}
    }
    out = util.append_diags(out, match_stmt_own_lambdas(stmt, structs, unions));
  }
  return out;
}

function magnitude_is_zero(text: string, start: i32): boolean {
  let i: i32 = start;
  while (i < text.len() && text[i] as i32 == 48) {
    i = i + 1;
  }
  return i == text.len();
}

function main_result_ty(ty: string): boolean {
  return ty == "void" || ty == "boolean" || ty == "i32" || ty == "i64" || is_unsigned_int_ty(ty);
}

function is_unsigned_int_ty(ty: string): boolean {
  return ty == "u8" || ty == "u32" || ty == "u64" || ty == "usize";
}

function int_ty_max_dec(ty: string, negated: boolean): string {
  if (ty == "i32") {
    if (negated) {
      return "2147483648";
    }
    return "2147483647";
  }
  if (ty == "i64") {
    if (negated) {
      return "9223372036854775808";
    }
    return "9223372036854775807";
  }
  if (ty == "u8") {
    return "255";
  }
  if (ty == "u32") {
    return "4294967295";
  }
  if (ty == "u64" || ty == "usize") {
    return "18446744073709551615";
  }
  return "";
}

function int_ty_max_hex(ty: string, negated: boolean): string {
  if (ty == "i32") {
    if (negated) {
      return "80000000";
    }
    return "7fffffff";
  }
  if (ty == "i64") {
    if (negated) {
      return "8000000000000000";
    }
    return "7fffffffffffffff";
  }
  if (ty == "u8") {
    return "ff";
  }
  if (ty == "u32") {
    return "ffffffff";
  }
  if (ty == "u64" || ty == "usize") {
    return "ffffffffffffffff";
  }
  return "";
}

function int_lit_fits(text: string, ty: string, negated: boolean): boolean {
  let hex: boolean = parser.is_hex_lit(text);
  let start: i32 = 0;
  if (hex) {
    start = 2;
  }
  let neg: boolean = negated && !magnitude_is_zero(text, start);
  if (neg && is_unsigned_int_ty(ty)) {
    return false;
  }
  let max: string = int_ty_max_dec(ty, neg);
  if (hex) {
    max = int_ty_max_hex(ty, neg);
  }
  if (max.len() == 0) {
    return true;
  }
  return parser.magnitude_fits(text, start, max);
}

function int_lit_as_written(text: string, negated: boolean): string {
  let prefixed: boolean = parser.is_hex_lit(text)
    || text.len() > 2 && text[0] == b'0' && (text[1] == b'o' || text[1] == b'O' || text[1] == b'b' || text[1] == b'B');
  let start: i32 = 0;
  let out: string = text;
  if (prefixed) {
    start = 2;
  } else {
    let i: i32 = 0;
    while (i + 1 < text.len() && text[i] as i32 == 48) {
      i = i + 1;
    }
    out = slice_unchecked(text, i, text.len()) + "";
  }
  if (negated && !magnitude_is_zero(text, start)) {
    return "-" + out;
  }
  return out;
}

function dupvar_stmt_own_lambdas(st: ast.Stmt): util.Diag[] {
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, dupvar_diags(lm.body));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, not_into_lambda);
}

function duplicate_var_diag(stmts: ast.Stmt[], v: ast.StmtVar): util.Diag {
  let d: util.Diag = dg_at("E013", "variable \"" + v.name + "\" already declared in this scope", v.line, v.col);
  for stmt in stmts {
    if let ast.StmtVar(prior) = stmt {
      if (prior.line == v.line && prior.col == v.col) {
        return d;
      }
      if (prior.name == v.name && prior.line > 0) {
        d = util.Diag { ...d, related: [util.Related { line: prior.line, col: prior.col, length: 0, message: "previous declaration is here" }] };
      }
    }
  }
  return d;
}

function dupvar_diags(stmts: ast.Stmt[]): util.Diag[] {
  let out: util.Diag[] = [];
  let declared: string[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (util.has_str(declared, v.name)) {
          out = out.append(duplicate_var_diag(stmts, v));
        } else {
          declared = declared.append(v.name);
        }
        if (v.type_name.len() == 0) {
          match (v.init) {
            ast.ExprArray(arr) => {
              if (arr.elements.len() == 0) {
                out = out.append(dg_at("E020", "empty array literal needs a type annotation", v.line, v.col));
              }
            },
            _ => {}
          }
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, dupvar_diags(f.then_body));
        out = util.append_diags(out, dupvar_diags(f.else_body));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, dupvar_diags(w.body));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, dupvar_diags(fr.body));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, dupvar_diags(arm.body));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, dupvar_diags(one));
      },
      _ => {}
    }
    out = util.append_diags(out, dupvar_stmt_own_lambdas(stmt));
  }
  return out;
}

struct LitSign { line: i32, col: i32, minuses: i32 }

function lit_sign_chain(e: ast.Expr, minuses: i32, own acc: LitSign[]): LitSign[] {
  match (e) {
    ast.ExprUnary(u) => {
      if (u.op == "-") {
        return lit_sign_chain(u.operand, minuses + 1, acc);
      }
      if (u.op == "+") {
        return lit_sign_chain(u.operand, minuses, acc);
      }
      return acc;
    },
    ast.ExprNumber(n) => {
      if (minuses == 0) {
        return acc;
      }
      return acc.append(LitSign { line: n.line, col: n.col, minuses: minuses });
    },
    _ => {
      return acc;
    }
  }
}

function lit_signs_stmts(stmts: ast.Stmt[]): LitSign[] {
  function at_unary(n: ast.Expr, own acc: LitSign[]): LitSign[] {
    match (n) {
      ast.ExprUnary(_) => {
        return lit_sign_chain(n, 0, acc);
      },
      _ => {
        return acc;
      }
    }
  }
  let signs: LitSign[] = [];
  for st in stmts {
    signs = astwalk.fold_stmt(st, signs, at_unary);
  }
  return signs;
}

function lit_negated(signs: LitSign[], line: i32, col: i32): boolean {
  let deepest: i32 = 0;
  for s in signs {
    if (s.line == line && s.col == col && s.minuses > deepest) {
      deepest = s.minuses;
    }
  }
  return deepest % 2 == 1;
}

function numeral_spelling(n: ast.ExprNumber): string {
  if (n.raw.len() == 0) {
    return n.text;
  }
  return slice_unchecked(n.raw, 0, n.raw.len() - n.suffix.len()) + "";
}

function suffix_range_diag(num: ast.ExprNumber, negated: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  if ((!num.is_float && num.suffix.len() == 0 || parser.float_settled_int(num)) && !parser.is_quoted_literal(num) && !parser.is_unit_literal(num) && !int_lit_fits(num.text, "u64", false)) {
    return out.append(dg_at("E047", "literal " + num.text + " does not fit in any integer type; write it as a float for f64", num.line, num.col));
  }
  if (num.is_float || parser.is_quoted_literal(num) || num.suffix.len() == 0) {
    return out;
  }
  if (int_lit_fits(num.text, num.suffix, negated)) {
    return out;
  }
  let msg: string = "literal " + int_lit_as_written(numeral_spelling(num), negated) + " does not fit in " + num.suffix;
  if (negated && is_unsigned_int_ty(num.suffix)) {
    msg = msg + ": unsigned types have no negative values";
  }
  return out.append(dg_at("E047", msg, num.line, num.col));
}

function suffix_range_stmts(stmts: ast.Stmt[]): util.Diag[] {
  let signs: LitSign[] = lit_signs_stmts(stmts);
  function at_number(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprNumber(num) => {
        return util.append_diags(acc, suffix_range_diag(num, lit_negated(signs, num.line, num.col)));
      },
      _ => {
        return acc;
      }
    }
  }
  let out: util.Diag[] = [];
  for st in stmts {
    out = astwalk.fold_stmt(st, out, at_number);
  }
  return out;
}

function mlit_is_base(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(bc) => {
      match (bc.callee) {
        ast.ExprIdent(bid) => {
          return is_map_new_name(bid.name);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_map_new_name(name: string): boolean {
  return name == "map_new" || name == "__map_new_i32";
}

function unsettled_int_literal(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return !n.is_float && n.suffix.len() == 0 && !parser.is_unit_literal(n)
        && !parser.literal_is_i64(n.text);
    },
    ast.ExprUnary(u) => {
      if (u.op == "-") {
        match (u.operand) {
          ast.ExprNumber(un) => {
            if (!un.is_float && un.suffix.len() == 0 && un.text == "2147483648") {
              return true;
            }
          },
          _ => {}
        }
        return unsettled_int_literal(u.operand);
      }
      return false;
    },
    ast.ExprBinary(b) => {
      if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
        return unsettled_int_literal(b.left) && unsettled_int_literal(b.right);
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function int_literal_tree(e: ast.Expr): boolean {
  return parser.int_literal_tree(e);
}

function numeric_literal_kind(e: ast.Expr): i32 {
  if (int_literal_tree(e)) {
    return 1;
  }
  if (float_literal_tree(e)) {
    return 2;
  }
  return 0;
}

function float_literal_tree(e: ast.Expr): boolean {
  return parser.float_literal_tree(e);
}

function literal_gives_way(kind: i32, t: typeinfo.Type): boolean {
  if (kind == 1) {
    return is_integer(t) || is_float(t);
  }
  if (kind == 2) {
    return is_float(t);
  }
  return false;
}

function int_operand_op(op: string): boolean {
  if (op == "+" || op == "-" || op == "*" || op == "/" || op == "%") {
    return true;
  }
  if (op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>") {
    return true;
  }
  return op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}

function const_refused_op(op: string): boolean {
  if (op == "+|" || op == "-|" || op == "*|" || op == "<<|") {
    return true;
  }
  if (op == "+?" || op == "-?" || op == "*?") {
    return true;
  }
  if (op == "/?" || op == "%?") {
    return true;
  }
  return op == "<<?" || op == ">>?";
}

function int_range_diags(e: ast.Expr, ty: string, negated: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float || parser.is_quoted_literal(n) || n.suffix.len() > 0 || parser.is_unit_literal(n)) {
        return out;
      }
      if (int_lit_fits(n.text, ty, negated)) {
        return out;
      }
      let msg: string = "literal " + int_lit_as_written(numeral_spelling(n), negated) + " does not fit in " + ty;
      if (negated && is_unsigned_int_ty(ty)) {
        msg = msg + ": unsigned types have no negative values";
      }
      return out.append(dg_at("E047", msg, n.line, n.col));
    },
    ast.ExprUnary(u) => {
      if (u.op == "-") {
        return int_range_diags(u.operand, ty, !negated);
      }
      if (u.op == "+") {
        return int_range_diags(u.operand, ty, negated);
      }
      return out;
    },
    ast.ExprBinary(b) => {
      if (int_operand_op(b.op)) {
        out = util.append_diags(int_range_diags(b.left, ty, false), int_range_diags(b.right, ty, false));
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

function int_dest_range_diags(e: ast.Expr, want: typeinfo.Type): util.Diag[] {
  let out: util.Diag[] = [];
  if let ast.ExprUnary(tu) = e {
    if let ast.ExprCall(tc) = tu.operand {
      if (tu.op == "try_" && ctor_variant_name(tc) == "Some" && tc.args.len() == 1) {
        return int_dest_range_diags(tc.args[0], want);
      }
    }
  }
  match (want) {
    typeinfo.TypeI32(wi) => {
      if (wi.is_char || !int_literal_tree(e)) {
        return out;
      }
      return int_range_diags(e, int_label(wi), false);
    },
    typeinfo.TypeArray(wa) => {
      match (e) {
        ast.ExprArray(arr) => {
          for element in arr.elements {
            out = util.append_diags(out, int_dest_range_diags(element, wa.elem));
          }
          return out;
        },
        _ => {
          return out;
        }
      }
    },
    typeinfo.TypeTuple(wt) => {
      match (e) {
        ast.ExprTuple(tl) => {
          if (tl.elements.len() != wt.elements.len()) {
            return out;
          }
          let i: i32 = 0;
          while (i < wt.elements.len()) {
            out = util.append_diags(out, int_dest_range_diags(tl.elements[i], wt.elements[i]));
            i = i + 1;
          }
          return out;
        },
        _ => {
          return out;
        }
      }
    },
    _ => {
      return out;
    }
  }
  return out;
}

function settles_to(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if (scalar_value_widens(e, want, s)) {
    return true;
  }
  if let ast.ExprCall(vc) = e {
    if (parser.is_value_block(vc)) {
      let body: ast.Stmt[] = parser.vb_body(vc);
      if (vb_numeric_recovery(body, want, s)) {
        return true;
      }
      return vb_settles(body, want, s);
    }
  }
  if let ast.ExprUnary(tu) = e {
    if (tu.op == "try_") {
      if let ast.ExprCall(tc) = tu.operand {
        if (ctor_variant_name(tc) == "Some" && tc.args.len() == 1 && !ctor_name_taken(tc, s)) {
          return settles_to(tc.args[0], want, s);
        }
      }
      return false;
    }
  }
  if (dest_bound_result(e, s)) {
    return true;
  }
  if let typeinfo.TypeFunc(wf) = want {
    if (generic_fn_value_arg(e, s)) {
      return fn_value_settles(e, wf, s);
    }
  }
  match (want) {
    typeinfo.TypeMap(wm) => {
      return mlit_is_desugared(e) && mlit_entries_settle(e, wm, s);
    },
    typeinfo.TypeFloat(_) => {
      return unsettled_int_literal(e) || is_poly_float(check_expr(e, s));
    },
    typeinfo.TypeI32(wi) => {
      if (wi.is_char) {
        return false;
      }
      return int_literal_tree(e);
    },
    typeinfo.TypeArray(wa) => {
      return array_literal_settles(e, wa.elem, s);
    },
    typeinfo.TypeTuple(wt) => {
      return tuple_literal_settles(e, wt.elements, s);
    },
    typeinfo.TypeUnion(_) => {
      return ctor_boxes_into(e, want, s) || ctor_payload_settles(e, want, s);
    },
    typeinfo.TypeStruct(ws) => {
      return struct_lit_settles(e, ws, s);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function array_literal_settles(e: ast.Expr, elem: typeinfo.Type, s: Scope): boolean {
  match (e) {
    ast.ExprArray(arr) => {
      if (is_dyn_slot(elem)) {
        return true;
      }
      for element in arr.elements {
        if (!array_element_settles(element, elem, s)) {
          return false;
        }
      }
      return true;
    },
    ast.ExprBytes(_) => {
      return type_eq(elem, t_u8());
    },
    _ => {
      return false;
    }
  }
}

function tuple_literal_settles(e: ast.Expr, elements: typeinfo.Type[], s: Scope): boolean {
  if let ast.ExprTuple(tl) = e {
    if (tl.elements.len() != elements.len()) {
      return false;
    }
    let i: i32 = 0;
    while (i < elements.len()) {
      if (!settles_or_nested(tl.elements[i], elements[i], s)) {
        return false;
      }
      i = i + 1;
    }
    return true;
  }
  return false;
}

function array_element_settles(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if let typeinfo.TypeTuple(_) = want {
    if let ast.ExprCall(c) = e {
      if (parser.is_value_block(c)) {
        return nested_assignable(check_expr(e, s), want, s.unions.unions);
      }
    }
  }
  return settles_or_assignable(e, want, s);
}

function ctor_boxes_into(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    let vname: string = ctor_variant_name(c);
    if (scope_variant_owner(vname, s).len() == 0 && parser.builtin_enum_of(vname).len() == 0) {
      return false;
    }
    let got: typeinfo.Type = check_expr(e, s);
    if (!same_nominal(got, want)) {
      return false;
    }
    let ga: typeinfo.Type[] = nominal_args(got);
    let wa: typeinfo.Type[] = nominal_args(want);
    if (ga.len() != wa.len()) {
      return false;
    }
    let boxed: boolean = false;
    let i: i32 = 0;
    while (i < ga.len()) {
      if (is_dyn_slot(wa[i]) && !is_unknown(ga[i]) && !is_dyn_slot(ga[i])) {
        boxed = true;
      } else if (!is_unknown(ga[i]) && !is_unknown(wa[i]) && !nested_assignable(ga[i], wa[i], s.unions.unions)) {
        return false;
      }
      i = i + 1;
    }
    return boxed;
  }
  return false;
}

function vb_numeric_recovery(body: ast.Stmt[], want: typeinfo.Type, s: Scope): boolean {
  if (!is_integer(want) && !is_float(want)) {
    return false;
  }
  let arms: ast.Expr[] = mx_body_result_exprs(body);
  let types: typeinfo.Type[] = [];
  for arm in arms {
    types = types.append(check_expr(arm, s));
  }
  let fold: MxFold = vb_arms_fold(types, arms, s);
  return !fold.ok && arm_unsettled(fold.acc) && settles_to(fold.acc.e, want, s);
}

function vb_settles(body: ast.Stmt[], want: typeinfo.Type, s: Scope): boolean {
  if (body.len() == 0) {
    return false;
  }
  let cur: Scope = s;
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    cur = bind_stmt(body[i], cur);
    i = i + 1;
  }
  match (body[i]) {
    ast.StmtReturn(r) => {
      return settles_or_assignable(r.value, want, cur);
    },
    ast.StmtIf(f) => {
      return vb_settles(f.then_body, want, cur) && vb_settles(f.else_body, want, cur);
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        if (!vb_settles(arm.body, want, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)))) {
          return false;
        }
      }
      return m.arms.len() > 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function ctor_payload_settles(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if let ast.ExprCall(c) = e {
    if (c.args.len() == 0 || !constructor_destination(c, want, s)) {
      return false;
    }
    let wa: typeinfo.Type[] = nominal_args(want);
    let at: i32 = builtin_payload_index(ctor_variant_name(c), want);
    if (at < 0) {
      return declared_payloads_settle(c, want, s);
    }
    if (c.args.len() != 1 || at >= wa.len()) {
      return false;
    }
    return settles_to(c.args[0], wa[at], s);
  }
  return false;
}

function declared_payloads_settle(c: ast.ExprCall, want: typeinfo.Type, s: Scope): boolean {
  let vname: string = ctor_variant_name(c);
  let i: i32 = 0;
  while (i < c.args.len()) {
    let field: typeinfo.Type = generic_variant_payload_type(s, vname, want, i);
    if (is_unknown(field) || !settles_or_assignable(c.args[i], field, s)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function constructor_destination(c: ast.ExprCall, want: typeinfo.Type, s: Scope): boolean {
  if (ctor_name_taken(c, s) || !same_nominal(check_expr(c, s), want)) {
    return false;
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (qual_variant_union(fa, s).len() == 0) {
      return false;
    }
    if let ast.ExprIdent(ns) = fa.obj {
      if (s.has_sig(ns.name + "." + fa.field)) {
        return false;
      }
    }
  }
  return true;
}

function builtin_payload_index(variant: string, want: typeinfo.Type): i32 {
  if let typeinfo.TypeUnion(u) = want {
    if (u.name == "Option" && variant == "Some") {
      return 0;
    }
    if (u.name == "Result" && variant == "Ok") {
      return 0;
    }
    if (u.name == "Result" && variant == "Err") {
      return 1;
    }
  }
  return 0 - 1;
}

function struct_lit_settles(e: ast.Expr, want: typeinfo.TypeStruct, s: Scope): boolean {
  if (want.args.len() == 0) {
    return false;
  }
  if let ast.ExprStructLit(sl) = e {
    if (sl.has_base || sl.type_name != want.name) {
      return false;
    }
    return s.lookup_struct(sl.type_name).type_params.len() == want.args.len();
  }
  return false;
}

function settles_or_assignable(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if (settles_to(e, want, s)) {
    return true;
  }
  let t: typeinfo.Type = check_expr(e, s);
  return is_unknown(t) || type_assignable(t, want, s.unions.unions);
}

function settles_or_nested(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  if (settles_to(e, want, s)) {
    return true;
  }
  let t: typeinfo.Type = check_expr(e, s);
  return is_unknown(t) || nested_assignable(t, want, s.unions.unions);
}

function variant_ctor_diags(qname: string, c: ast.ExprCall, s: Scope): util.Diag[] {
  let vname: string = variant_pattern_name(qname);
  let out: util.Diag[] = [];
  let owner: UnionSig = scope_variant_sig(vname, s);
  if (dot_index(qname) >= 0) {
    owner = s.lookup_union(variant_pattern_owner(qname));
  }
  out = util.append_diags(out, enum_access_diags(owner, s, c.line, c.col));

  if (scope_variant_owner(vname, s).len() == 0 && find_variant_sig(s.structs, qname).enum_owner.len() == 0) {
    return out;
  }
  if (dot_index(qname) < 0 && s.variant_ambiguous(vname)) {
    return out;
  }
  let want: i32 = variant_payload_count(qname, s.structs);
  if (want < 0) {
    return out;
  }
  if (c.args.len() != want) {
    out = out.append(dg_at("E036", util.arity_message("variant " + shown_variant(s, qname), want, c.args.len(), "argument"), c.line, c.col));
  }
  let whole: typeinfo.Type = variant_ctor_type(s, variant_payload_struct(s, qname).enum_owner, qname, c);
  let i: i32 = 0;
  while (i < c.args.len() && i < want) {
    let at: typeinfo.Type = check_expr(c.args[i], s);
    let pt: typeinfo.Type = variant_pattern_payload_type(s, qname, whole, i);
    out = util.append_diags(out, int_dest_range_diags(c.args[i], pt));
    if (!is_unknown(at) && !is_unknown(pt) && !settles_to(c.args[i], pt, s) && !coercible(at, pt, s)) {
      out = out.append(dg_at("E036", "variant " + shown_variant(s, qname) + " payload " + util.i32_to_string(i) + " type " + type_label(at) + ", expected " + type_label(pt), expr_line(c.args[i]), expr_col(c.args[i])));
    }
    i = i + 1;
  }
  return out;
}

function qual_enum_name(obj: ast.Expr, s: Scope): string {
  match (obj) {
    ast.ExprIdent(oid) => {
      if (s.known(oid.name)) {
        return "";
      }
      if (s.lookup_union(oid.name).name.len() > 0) {
        return oid.name;
      }
      if (parser.is_reserved_enum_name(oid.name)) {
        return oid.name;
      }
      return "";
    },
    _ => {
      return "";
    }
  }
  return "";
}

function qual_variant_exists(en: string, field: string, s: Scope): boolean {
  let ou: UnionSig = s.lookup_union(en);
  if (ou.name.len() > 0) {
    return util.has_str(ou.variants, field);
  }
  return parser.builtin_enum_of(field) == en;
}

function qual_variant_union(fa: ast.ExprFieldAccess, s: Scope): string {
  let en: string = qual_enum_name(fa.obj, s);
  if (en.len() == 0 || !qual_variant_exists(en, fa.field, s)) {
    return "";
  }
  return en;
}

struct AssocHit { found: boolean, ret: string, owner: string, params: string[], is_const: boolean }

function assoc_miss(): AssocHit {
  return AssocHit { found: false, ret: "", owner: "", params: [], is_const: false };
}

function trait_req_idx(tr: string, reqs: parser.TraitReq[]): i32 {
  let exact: i32 = derive_trait_idx(util.base_type_name(tr), reqs);
  if (exact >= 0) {
    return exact;
  }
  let i: i32 = e021_trait_idx(tr, reqs);
  if (i >= 0) {
    return i;
  }
  let simple: string = parser.derive_simple_name(tr);
  if (simple == tr) {
    return 0 - 1;
  }
  return e021_trait_idx(simple, reqs);
}

function bounds_in_module(b: string, module: string): string {
  if (module.len() == 0 || parser.is_const_bound(b)) {
    return b;
  }
  let out: string = "";
  for part in parser.split_plus_bounds(b) {
    if (out.len() > 0) {
      out = out + " + ";
    }
    if (util.index_of_sub(util.base_type_name(part), ".") < 0) {
      out = out + module + "." + part;
    } else {
      out = out + part;
    }
  }
  return out;
}

function trait_assoc_req(reqs: parser.TraitReq[], tr: string, field: string, seen: string[]): AssocHit {
  let idx: i32 = trait_req_idx(util.base_type_name(tr), reqs);
  if (idx < 0) {
    return assoc_miss();
  }
  let req: parser.TraitReq = reqs[idx];
  if (util.has_str(seen, req.trait_name)) {
    return assoc_miss();
  }
  let path: string[] = seen.append(req.trait_name);
  let args: string[] = [];
  for arg in parser.parse_type_ref(tr).args {
    args = args.append(parser.render_type_ref(arg));
  }
  for rs in req.assoc_sigs {
    if (rs.name == field) {
      let params: string[] = [];
      for p in rs.params {
        params = params.append(parser.subst_ty(parser.fn_tag_spelling(p.type_name, p.fn_ret, p.fn_param_types), req.type_params, args));
      }
      return AssocHit { found: true, ret: parser.subst_ty(rs.ret_type, req.type_params, args), owner: req.trait_name, params: params, is_const: rs.is_const };
    }
  }
  for supertrait in req.supertraits {
    let sh: AssocHit = trait_assoc_req(reqs, parser.subst_ty(supertrait, req.type_params, args), field, path);
    if (sh.found) {
      return sh;
    }
  }
  return assoc_miss();
}

function dyn_method(traits: string, name: string, s: Scope): Option[parser.FuncDecl] {
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let idx: i32 = trait_req_idx(util.base_type_name(tr), s.trait_reqs);
    if (idx >= 0) {
      match (trait_req_sig(s.trait_reqs[idx], name)) {
        Some(m) => {
          return Some(m);
        },
        None => {}
      }
    }
  }
  return None;
}

function trait_req_sig(req: parser.TraitReq, name: string): Option[parser.FuncDecl] {
  for m in req.req_sigs {
    if (m.name == name) {
      return Some(m);
    }
  }
  for m in req.default_sigs {
    if (m.name == name) {
      return Some(m);
    }
  }
  return None;
}

function dyn_method_type(traits: string, name: string, s: Scope): typeinfo.Type {
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let idx: i32 = trait_req_idx(util.base_type_name(tr), s.trait_reqs);
    if (idx >= 0) {
      match (trait_req_sig(s.trait_reqs[idx], name)) {
        Some(m) => {
          let ret: string = dyn_ret_at_spelling(m.ret_type, tr, s.trait_reqs[idx].type_params);
          if (ret.len() == 0 || parser.subst_self(ret, "__dyn") != ret) {
            return t_unknown("dyn method result spells Self");
          }
          return s.resolve_type(ret);
        },
        None => {}
      }
    }
  }
  return t_unknown("no method `" + name + "` on `dyn " + traits + "`");
}

function dyn_param_type(traits: string, name: string, k: i32, s: Scope): typeinfo.Type {
  for tr in parser.dyn_trait_set("dyn " + traits) {
    let idx: i32 = trait_req_idx(util.base_type_name(tr), s.trait_reqs);
    if (idx >= 0) {
      match (trait_req_sig(s.trait_reqs[idx], name)) {
        Some(m) => {
          if (k >= m.params.len()) {
            return t_unknown("no such parameter");
          }
          let p: ast.ParamDecl = m.params[k];
          let pt: string = dyn_ret_at_spelling(parser.fn_tag_spelling(p.type_name, p.fn_ret, p.fn_param_types), tr, s.trait_reqs[idx].type_params);
          if (pt.len() == 0 || parser.subst_self(pt, "__dyn") != pt) {
            return t_unknown("dyn method parameter spells Self");
          }
          return s.resolve_type(pt);
        },
        None => {}
      }
    }
  }
  return t_unknown("no method `" + name + "` on `dyn " + traits + "`");
}

function dyn_ret_at_spelling(ret: string, spelling: string, tparams: string[]): string {
  let open: i32 = e021_bracket_open(spelling);
  if (open < 0) {
    return ret;
  }
  let args: string[] = [];
  let out: string = ret;
  for raw in parser.split_top_commas(slice_unchecked(spelling, open + 1, spelling.len() - 1) + "") {
    let entry: string = util.trim(raw);
    let eq: i32 = pin_eq(entry);
    if (eq > 0) {
      out = subst_self_proj(out, util.trim(slice_unchecked(entry, 0, eq) + ""), util.trim(slice_unchecked(entry, eq + 1, entry.len()) + ""));
    } else {
      args = args.append(entry);
    }
  }
  if (args.len() == tparams.len()) {
    out = parser.subst_ty(out, tparams, args);
  }
  return out;
}

function pin_eq(entry: string): i32 {
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i < entry.len()) {
    let c: u8 = entry[i];
    if (c == b'(' || c == b'[') {
      depth = depth + 1;
    } else if (c == b')' || c == b']') {
      depth = depth - 1;
    } else if (c == b'=' && depth == 0 && !(i + 1 < entry.len() && entry[i + 1] == b'>')) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function subst_self_proj(t: string, name: string, val: string): string {
  let pat: string = "Self::" + name;
  let out: string = "";
  let i: i32 = 0;
  while (i < t.len()) {
    let end: i32 = i + pat.len();
    if (end <= t.len() && slice_unchecked(t, i, end) == pat && (end == t.len() || !parser.ident_byte(t[end] as i32)) && (i == 0 || !parser.ident_byte(t[i - 1] as i32))) {
      out = out + val;
      i = end;
    } else {
      out = out + slice_unchecked(t, i, i + 1);
      i = i + 1;
    }
  }
  return out;
}

function dyn_call_diags(c: ast.ExprCall, mfa: ast.ExprFieldAccess, traits: string, s: Scope): util.Diag[] {
  match (dyn_method(traits, mfa.field, s)) {
    Some(m) => {
      if (m.params.len() == 0 || m.params[0].name != "self") {
        return [];
      }
      let want: i32 = m.params.len() - 1;
      if (c.args.len() != want) {
        return [dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", want, c.args.len(), "argument"), c.line, c.col)];
      }
      let out: util.Diag[] = [];
      let k: i32 = 0;
      while (k < c.args.len()) {
        let pt: typeinfo.Type = dyn_param_type(traits, mfa.field, k + 1, s);
        if (!is_unknown(pt) && !settles_or_assignable(c.args[k], pt, s)) {
          out = out.append(dg_at("E038", "argument " + util.i32_to_string(k + 1) + " to \"" + mfa.field + "\": expected " + type_label(pt) + ", got " + type_label(check_expr(c.args[k], s)), expr_line(c.args[k]), expr_col(c.args[k])));
        }
        k = k + 1;
      }
      return out;
    },
    None => {}
  }
  return [dg_at("E021", "no method \"" + mfa.field + "\" on `dyn " + traits + "`", mfa.line, mfa.col)];
}

function tp_assoc_req(s: Scope, tname: string, field: string): AssocHit {
  let k: i32 = util.index_of_str(s.tparams, tname);
  if (k < 0 || k >= s.tbounds.len()) {
    return assoc_miss();
  }
  for tr in parser.split_plus_bounds(s.tbounds[k]) {
    let h: AssocHit = trait_assoc_req(s.trait_reqs, tr, field, []);
    if (h.found) {
      return h;
    }
  }
  return assoc_miss();
}

function tp_bound_traits(s: Scope, tname: string): string[] {
  let out: string[] = [];
  let k: i32 = util.index_of_str(s.tparams, tname);
  if (k < 0 || k >= s.tbounds.len()) {
    return out;
  }
  for entry in parser.split_plus_bounds(s.tbounds[k]) {
    out = out.append(util.base_type_name(entry));
  }
  return out;
}

function tp_bound_provides(s: Scope, tname: string, field: string): boolean {
  for tr in tp_bound_traits(s, tname) {
    if (trait_provides(s.trait_reqs, tr, field, [])) {
      return true;
    }
  }
  return false;
}

function bound_method(s: Scope, tname: string, field: string): Option[MethodSig] {
  let k: i32 = util.index_of_str(s.tparams, tname);
  if (tname.len() == 0 || k < 0 || k >= s.tbounds.len()) {
    return None;
  }
  for bound in parser.split_plus_bounds(s.tbounds[k]) {
    match (trait_bound_method(s, bound, tname, field, [])) {
      Some(sig) => {
        return Some(sig);
      },
      None => {}
    }
  }
  return None;
}

function trait_bound_method(s: Scope, bound: string, self: string, field: string, seen: string[]): Option[MethodSig] {
  let ref: parser.TypeRef = parser.parse_type_ref(bound);
  let idx: i32 = trait_req_idx(ref.base, s.trait_reqs);
  if (idx < 0) {
    return None;
  }
  let req: parser.TraitReq = s.trait_reqs[idx];
  let key: string = req.module + "." + req.trait_name;
  if (util.has_str(seen, key)) {
    return None;
  }
  let args: string[] = [];
  for arg in ref.args {
    args = args.append(parser.render_type_ref(arg));
  }
  for m in util.append_all(req.req_sigs, req.default_sigs) {
    if (m.name == field && m.params.len() > 0 && m.params[0].name == "self") {
      let pts: typeinfo.Type[] = [];
      let ptn: string[] = [];
      let tps: string[] = util.append_all(s.tparams, m.all_type_params);
      let subst: typeinfo.Type[] = util.append_all(rigid_tparams(s.tparams), erased_tparams(m.all_type_params));
      let i: i32 = 1;
      while (i < m.params.len()) {
        let p: ast.ParamDecl = m.params[i];
        let spelling: string = parser.subst_ty(parser.subst_self(parser.fn_tag_spelling(p.type_name, p.fn_ret, p.fn_param_types), self), req.type_params, args);
        ptn = ptn.append(spelling);
        pts = pts.append(type_from_name_subst(spelling, tps, subst, s.type_names()));
        i = i + 1;
      }
      let rt: string = parser.subst_ty(parser.subst_self(parser.fn_tag_spelling(m.ret_type, m.ret_fn_ret, m.ret_fn_param_types), self), req.type_params, args);
      return Some(MethodSig { name: m.name, receiver_type: self, param_types: pts, ret_type: type_from_name_subst(rt, tps, subst, s.type_names()), ret_type_name: rt, param_type_names: ptn, all_type_params: m.all_type_params, type_params: m.type_params, type_bounds: m.bound_traits, module: m.module, impl_trait: req.trait_name, line: m.line, col: m.col, file: decl_file_label(m) });
    }
  }
  for parent in req.supertraits {
    match (trait_bound_method(s, parser.subst_ty(parent, req.type_params, args), self, field, seen.append(key))) {
      Some(sig) => {
        return Some(sig);
      },
      None => {}
    }
  }
  return None;
}

function trait_provides(reqs: parser.TraitReq[], tr: string, field: string, seen: string[]): boolean {
  let idx: i32 = trait_req_idx(tr, reqs);
  if (idx < 0) {
    return true;
  }
  let req: parser.TraitReq = reqs[idx];
  if (util.has_str(seen, req.trait_name)) {
    return false;
  }
  if (util.has_str(req.provided, field)) {
    return true;
  }
  let path: string[] = seen.append(req.trait_name);
  for supertrait in req.supertraits {
    if (trait_provides(reqs, supertrait, field, path)) {
      return true;
    }
  }
  return false;
}

function tp_receiver(recv: typeinfo.Type, s: Scope): string {
  if let typeinfo.TypeErased(e) = recv {
    if (util.index_of_str(s.tparams, e.name) >= 0) {
      return e.name;
    }
  }
  return "";
}

function type_assoc_req(s: Scope, tyname: string, field: string): AssocHit {
  let base: string = util.base_type_name(tyname);
  for imp in s.impls {
    if (imp.impl_type == base && util.has_str(imp.method_names, field)) {
      if (s.lookup_method(field, base).name.len() == 0) {
        let spelling: string = imp.trait_ref;
        if (spelling.len() == 0) {
          spelling = imp.trait_name;
        }
        let h: AssocHit = trait_assoc_req(s.trait_reqs, spelling, field, []);
        if (h.found) {
          return h;
        }
        return AssocHit { found: true, ret: "", owner: "", params: [], is_const: s.lookup_assoc_sig(base, field).is_const };
      }
    }
  }
  return assoc_miss();
}

function assoc_func_impls(impls: parser.ImplInfo[], funcs: parser.FuncDecl[]): parser.ImplInfo[] {
  let out: parser.ImplInfo[] = impls;
  for fd in funcs {
    if (fd.receiver_name.len() == 0 && fd.receiver_type.len() > 0) {
      let noargs: string[] = [];
      out = out.append(parser.ImplInfo { trait_name: "", impl_type: util.base_type_name(fd.receiver_type), type_params: noargs, all_type_params: noargs, bounds: noargs, method_names: [fd.name], trait_spelling: "", trait_ref: "", assoc_names: noargs, assoc_values: noargs, trait_module: "", module: "", line: fd.line, col: fd.col });
    }
  }
  return out;
}

function assoc_call_req(obj: ast.Expr, field: string, s: Scope, const_read: boolean): AssocHit {
  match (obj) {
    ast.ExprIdent(oid) => {
      if (s.known(oid.name)) {
        return assoc_miss();
      }
      let h: AssocHit = tp_assoc_req(s, oid.name, field);
      if (h.found) {
        return h;
      }
      let ht: AssocHit = type_assoc_req(s, oid.name, field);
      if (ht.found) {
        return ht;
      }
      return assoc_miss();
    },
    _ => {
      return assoc_miss();
    }
  }
  return assoc_miss();
}

function tparam_assoc_diag(tid: ast.ExprIdent, field: string, s: Scope): util.Diag {
  let why: string = tid.name + " has no bound; bound it by a trait that declares " + field + "()";
  let k: i32 = util.index_of_str(s.tparams, tid.name);
  if (k < s.tbounds.len() && s.tbounds[k].len() > 0) {
    why = "its bound " + util.demangle(s.tbounds[k]) + " declares none";
  }
  let d: util.Diag = dg_at("E001", "type parameter " + tid.name + " has no associated function \"" + field + "\": " + why, tid.line, tid.col);
  return util.Diag { ...d, length: util.show_type_vars(tid.name).len() };
}

function assoc_hit_type(h: AssocHit, obj: ast.Expr, s: Scope): typeinfo.Type {
  if (h.ret.len() == 0) {
    return t_unknown("associated call: return type not recoverable");
  }
  let self_name: string = "";
  match (obj) {
    ast.ExprIdent(oid) => {
      self_name = oid.name;
    },
    _ => {}
  }
  return s.resolve_type(parser.subst_self(h.ret, self_name));
}

function assoc_base_name(obj: ast.Expr): string {
  if let ast.ExprIdent(oid) = obj {
    return oid.name;
  }
  return "";
}

function assoc_const_read_diags(h: AssocHit, c: ast.ExprCall, mfa: ast.ExprFieldAccess): util.Diag[] {
  if (mfa.const_read == h.is_const) {
    return [];
  }
  let base: string = util.demangle(assoc_base_name(mfa.obj));
  if (mfa.const_read) {
    return [dg_at("E043", base + "." + mfa.field + " is an associated function, not a constant; call it as " + base + "." + mfa.field + "(...)", c.line, c.col)];
  }
  return [dg_at("E043", base + "." + mfa.field + " is an associated constant; read it as " + base + "." + mfa.field + " without an argument list", c.line, c.col)];
}

function assoc_arg_diags(h: AssocHit, c: ast.ExprCall, mfa: ast.ExprFieldAccess, s: Scope): util.Diag[] {
  let self_name: string = "";
  if let ast.ExprIdent(oid) = mfa.obj {
    self_name = oid.name;
  }
  let pts: typeinfo.Type[] = [];
  if (h.owner.len() > 0) {
    for ps in h.params {
      pts = pts.append(s.resolve_type(parser.subst_self(ps, self_name)));
    }
  } else {
    let asig: FuncSig = s.lookup_assoc_sig(self_name, mfa.field);
    if (asig.name.len() == 0) {
      return [];
    }
    pts = asig.param_types;
  }
  if (c.args.len() != pts.len()) {
    return [dg_at("E004", util.arity_message("associated function \"" + mfa.field + "\"", pts.len(), c.args.len(), "argument"), c.line, c.col)];
  }
  let out: util.Diag[] = [];
  let k: i32 = 0;
  while (k < c.args.len()) {
    if (!is_unknown(pts[k]) && !settles_or_assignable(c.args[k], pts[k], s)) {
      out = out.append(dg_at("E038", "argument " + util.i32_to_string(k + 1) + " to \"" + mfa.field + "\": expected " + type_label(pts[k]) + ", got " + type_label(check_expr(c.args[k], s)), expr_line(c.args[k]), expr_col(c.args[k])));
    }
    k = k + 1;
  }
  return out;
}

function operand_open(t: typeinfo.Type): boolean {
  if let typeinfo.TypeErased(_) = t {
    return true;
  }
  return is_unknown(t);
}

function lanes_inside(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeArray(a) => {
      return holds_lanes(a.elem);
    },
    typeinfo.TypeTuple(tp) => {
      return any_holds_lanes(tp.elements);
    },
    typeinfo.TypeMap(m) => {
      return holds_lanes(m.key) || holds_lanes(m.value);
    },
    typeinfo.TypeFunc(f) => {
      return any_holds_lanes(f.param_types) || holds_lanes(f.ret_type);
    },
    typeinfo.TypeStruct(st) => {
      return any_holds_lanes(st.args);
    },
    typeinfo.TypeUnion(u) => {
      return any_holds_lanes(u.args);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function holds_lanes(t: typeinfo.Type): boolean {
  return is_lanes(t) || lanes_inside(t);
}

function any_holds_lanes(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (holds_lanes(t)) {
      return true;
    }
  }
  return false;
}

function lanes_inside_diags(t: typeinfo.Type, line: i32, col: i32): util.Diag[] {
  if (!lanes_inside(t)) {
    return [];
  }
  return [dg_at("E085", type_label(t) + " holds a lane value inside another type; a lane value lives only in a local, a parameter or a result", line, col)];
}

function e085_decl_diags(mod: parser.Module, focus: util.NameIndex, tn: TypeNames): util.Diag[] {
  let out: util.Diag[] = [];
  for efn in mod.funcs {
    if (in_focus(focus, efn)) {
      for param in efn.params {
        out = util.append_diags(out, lanes_inside_diags(type_from_spelling(e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), tn), efn.line, efn.col));
      }
      out = util.append_diags(out, lanes_inside_diags(type_from_spelling(e064_decl_spelling(efn.ret_type, efn.ret_fn_ret, efn.ret_fn_param_types), tn), efn.line, efn.col));
      for an in collect_annots(efn.body) {
        out = util.append_diags(out, lanes_inside_diags(type_from_spelling(an.type_name, tn), an.line, an.col));
      }
    }
  }
  for esd in mod.structs {
    for field in esd.fields {
      let ft: typeinfo.Type = type_from_spelling(e064_decl_spelling(field.type_name, field.fn_ret, field.fn_param_types), tn);
      if (holds_lanes(ft)) {
        out = out.append(dg_at("E085", "a field or payload of type " + type_label(ft) + " holds a lane value; a lane value lives only in a local, a parameter or a result", esd.line, esd.col));
      }
    }
  }
  return out;
}

function call_diags(e: ast.Expr, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      out = call_diags_call(c, s, out, t_unknown("no destination"));
    },
    ast.ExprBinary(b) => {
      out = call_diags_binary(b, s, out);
    },
    ast.ExprUnary(u) => {
      out = call_diags_unary(u, s, out);
    },
    ast.ExprArray(a) => {
      out = call_diags_array(a, s, out);
      out = util.append_diags(out, lanes_inside_diags(check_expr(e, s), a.line, a.col));
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, call_diags(element, s));
      }
      out = util.append_diags(out, lanes_inside_diags(check_expr(e, s), t.line, t.col));
    },
    ast.ExprIndex(ix) => {
      out = call_diags_index(ix, s, out);
    },
    ast.ExprSlice(s2) => {
      out = call_diags_slice(s2, s, out);
    },
    ast.ExprFieldAccess(fa) => {
      out = call_diags_field_access(fa, s, out);
    },
    ast.ExprStructLit(sl) => {
      out = call_diags_struct_lit(sl, [], s, out);
    },
    ast.ExprLambda(lm) => {
      out = call_diags_lambda(lm, s, out);
    },
    ast.ExprIdent(id) => {
      out = call_diags_ident(id, s, out);
    },
    _ => {}
  }
  return out;
}

function payload_count_message(variant: string, want: i32, got: i32): string {
  let values: string = "values";
  if (want == 1) {
    values = "value";
  }
  return "variant " + variant + " carries " + util.i32_to_string(want) + " " + values + ", but the pattern binds " + util.i32_to_string(got);
}

function arg_subject(c: ast.ExprCall, n: i32): string {
  let arg: string = "argument " + util.i32_to_string(n);
  if let ast.ExprIdent(id) = c.callee {
    if (!util.str_has_prefix(id.name, "__")) {
      return arg + " to \"" + util.demangle(id.name) + "\"";
    }
  }
  return arg;
}

function call_subject(c: ast.ExprCall): string {
  match (c.callee) {
    ast.ExprIdent(id) => {
      return "function \"" + util.demangle(id.name) + "\"";
    },
    _ => {
      return "this function";
    }
  }
}

function cell_call_diags(c: ast.ExprCall, mfa: ast.ExprFieldAccess, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let want: i32 = 0 - 1;
  if (mfa.field == "get") {
    want = 0;
  }
  if (mfa.field == "set") {
    want = 1;
  }
  if (want < 0) {
    return [access_fix(dg_at("E043", "struct Cell has no field or method \"" + mfa.field + "\"", mfa.line, mfa.col), mfa, ["get", "set"])];
  }
  if (c.args.len() != want) {
    return [dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", want, c.args.len(), "argument"), c.line, c.col)];
  }
  if (want == 1) {
    let pt: typeinfo.Type = cell_elem_type(recv);
    let at: typeinfo.Type = check_expr(c.args[0], s);
    out = util.append_diags(out, int_dest_range_diags(c.args[0], pt));
    if (!is_unknown(at) && !is_unknown(pt) && !settles_to(c.args[0], pt, s) && !coercible(at, pt, s)) {
      out = out.append(dg_at("E038", "argument 1 to \"" + mfa.field + "\": expected " + type_label(pt) + ", got " + type_label(at) + str_copy_hint(at, pt), expr_line(c.args[0]), expr_col(c.args[0])));
    }
    out = util.append_diags(out, array_elem_check(array_elem_type_of(pt), c.args[0], s));
  }
  return out;
}

function callable_arg_diags(c: ast.ExprCall, ft: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  match (ft) {
    typeinfo.TypeFunc(f) => {
      if (!f.params_known) {
        return out;
      }
      if (c.args.len() != f.param_types.len()) {
        return [dg_at("E004", util.arity_message(call_subject(c), f.param_types.len(), c.args.len(), "argument"), c.line, c.col)];
      }
      let i: i32 = 0;
      while (i < c.args.len()) {
        let pt: typeinfo.Type = f.param_types[i];
        let at: typeinfo.Type = check_expr(c.args[i], s);
        out = util.append_diags(out, int_dest_range_diags(c.args[i], pt));
        if (!is_unknown(at) && !is_unknown(pt) && !settles_to(c.args[i], pt, s) && !view_arg_borrow(at, pt) && !coercible(at, pt, s)) {
          out = out.append(dg_at("E038", arg_subject(c, i + 1) + ": expected " + type_label(pt) + ", got " + argument_type_label(c.args[i], at, s), expr_line(c.args[i]), expr_col(c.args[i])));
        }
        out = util.append_diags(out, array_elem_check(array_elem_type_of(pt), c.args[i], s));
        i = i + 1;
      }
    },
    _ => {}
  }
  return out;
}

function scalar_receiver_name(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeI32(it) => {
      return int_label(it);
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function display_dispatch_name(t: typeinfo.Type): string {
  let scalar: string = scalar_receiver_name(t);
  if (scalar.len() > 0) {
    return scalar;
  }
  match (t) {
    typeinfo.TypeStruct(sd) => {
      return sd.name;
    },
    typeinfo.TypeUnion(u) => {
      return u.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function display_resolves(t: typeinfo.Type, s: Scope): boolean {
  let tn: string = display_dispatch_name(t);
  if (tn.len() == 0) {
    return false;
  }
  return s.has_method("to_string", tn) || conforms_by_impl_or_derive(s, tn, "Display") || !is_unknown(builtin_method_sig(tn, "to_string"));
}

function display_unjudged(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeString(_) => {
      return true;
    },
    typeinfo.TypeUnknown(_) => {
      return true;
    },
    typeinfo.TypeErased(_) => {
      return true;
    },
    typeinfo.TypeDyn(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_display_builtin(name: string): boolean {
  return name == "print" || name == "write" || name == "eprint";
}

function display_call_name(c: ast.ExprCall, s: Scope): string {
  if (c.args.len() != 1) {
    return "";
  }
  if let ast.ExprIdent(id) = c.callee {
    if (!is_display_builtin(id.name)) {
      return "";
    }
    if (s.lookup_sig(id.name).name.len() > 0) {
      return "";
    }
    return id.name;
  }
  return "";
}

function display_rewrite(c: ast.ExprCall, nargs: ast.Expr[], s: Scope): ast.Expr[] {
  if (display_call_name(c, s).len() == 0) {
    return nargs;
  }
  let at: typeinfo.Type = check_expr(c.args[0], s);
  if (display_unjudged(at) || !display_resolves(at, s)) {
    return nargs;
  }
  let ln: i32 = expr_line(c.args[0]);
  let cl: i32 = expr_col(c.args[0]);
  let callee: ast.Expr = ast.ExprFieldAccess { obj: nargs[0], field: "to_string", line: ln, col: cl, ty: "", const_read: false };
  return [ast.ExprCall { callee: callee, args: [], line: ln, col: cl, type_args: [], ty: "string" }];
}

function display_arg_diags(c: ast.ExprCall, s: Scope): util.Diag[] {
  let name: string = display_call_name(c, s);
  if (name.len() == 0) {
    return [];
  }
  let at: typeinfo.Type = check_expr(c.args[0], s);
  if (display_unjudged(at) || display_resolves(at, s)) {
    return [];
  }
  let label: string = type_label(at);
  return [dg_at(
    "E038", "argument 1 to \"" + name + "\": " + label + " does not implement `Display` (no `to_string(): string` in scope) — give "
      + label + " a `to_string(): string` method, or " + util.derive_hint(display_dispatch_name(at), "cmp.Display", "cmp.Display"),
    expr_line(c.args[0]), expr_col(c.args[0]),
  )];
}

const MAP_NEW_KEY: string = "map_new key";

const MAP_NEW_VALUE: string = "map_new value";

function unbound_column(t: typeinfo.Type, reason: string): boolean {
  if let typeinfo.TypeUnknown(u) = t {
    return u.reason == reason;
  }
  return false;
}

function map_method_column(t: typeinfo.Type, reason: string, name: string): typeinfo.Type {
  if (unbound_column(t, reason)) {
    return typeinfo.TypeErased { name: name };
  }
  return t;
}

function map_method_receiver(c: ast.ExprCall, recv_ty: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeMap(mr) = recv_ty {
    if ((unbound_column(mr.key, MAP_NEW_KEY) || unbound_column(mr.value, MAP_NEW_VALUE)) && !literal_insert(c)) {
      return t_map(map_method_column(mr.key, MAP_NEW_KEY, "K"), map_method_column(mr.value, MAP_NEW_VALUE, "V"));
    }
  }
  return recv_ty;
}

function map_source_receiver_missing(recv: typeinfo.Type, msig: MethodSig): boolean {
  if (parser.parse_type_ref(msig.receiver_type).args.len() == 0) {
    return false;
  }
  if let typeinfo.TypeMap(mt) = recv {
    return unbound_column(mt.key, MAP_NEW_KEY) || unbound_column(mt.value, MAP_NEW_VALUE);
  }
  return false;
}

function map_method_takes_key(method: string): boolean {
  return method == "insert" || method == "get_or" || method == "get" || method == "contains" || method == "remove";
}

function unbound_map_arg_diags(c: ast.ExprCall, method: string, mt: typeinfo.TypeMap, s: Scope, out: util.Diag[]): util.Diag[] {
  if (literal_insert(c) || c.args.len() == 0) {
    return out;
  }
  if (map_method_takes_key(method) && unbound_column(mt.key, MAP_NEW_KEY)) {
    out = out.append(dg_at("E038", "argument 1 to \"" + method + "\": expected K, got " + type_label(check_expr(c.args[0], s)), expr_line(c.args[0]), expr_col(c.args[0])));
  }
  let takes_value: boolean = (method == "insert" || method == "get_or") && c.args.len() == 2;
  if (takes_value && unbound_column(mt.value, MAP_NEW_VALUE)) {
    out = out.append(dg_at("E038", "argument 2 to \"" + method + "\": expected V, got " + type_label(check_expr(c.args[1], s)), expr_line(c.args[1]), expr_col(c.args[1])));
  }
  return out;
}

function map_arg_diags(c: ast.ExprCall, method: string, mt: typeinfo.TypeMap, s: Scope, out: util.Diag[]): util.Diag[] {
  let want: i32 = map_builtin_arity(method);
  if (want < 0) {
    let msig: MethodSig = s.lookup_method(method, "Map");
    if (msig.name.len() == 0) {
      return out;
    }
    let recv: typeinfo.Type = mt;
    if (map_source_receiver_missing(recv, msig)) {
      return out.append(dg_at("E043", "no method \"" + method + "\" on Map — \"" + method + "\" is declared for " + msig.receiver_type, c.line, c.col));
    }
    if (c.args.len() != msig.param_types.len()) {
      return out.append(dg_at("E004", util.arity_message("method \"" + method + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
    }
    out = util.append_diags(out, method_arg_diags(c, method, msig, recv, s));
    out = util.append_diags(out, method_type_arg_diags(c, method, msig, recv, s));
    return util.append_diags(out, uninferred_method_diags(c, "Map", method, msig, s));
  }
  if (want >= 0 && c.args.len() != want) {
    return out.append(dg_at("E004", util.arity_message("method \"" + method + "\"", want, c.args.len(), "argument"), c.line, c.col));
  }
  let slots: typeinfo.Type[] = map_arg_slots(method, mt);
  if (slots.len() == 0 || c.args.len() != slots.len()) {
    return out;
  }
  let ii: i32 = 0;
  while (ii < slots.len()) {
    out = map_arg_diag(c, ii, method, slots[ii], s, out);
    ii = ii + 1;
  }
  return out;
}

function map_arg_slots(method: string, mt: typeinfo.TypeMap): typeinfo.Type[] {
  if (method == "insert" || method == "get_or") {
    return [mt.key, mt.value];
  }
  if (method == "get" || method == "contains" || method == "remove") {
    return [mt.key];
  }
  return [];
}

function map_builtin_arity(method: string): i32 {
  if (method == "insert" || method == "get_or") {
    return 2;
  }
  if (method == "get" || method == "contains" || method == "remove") {
    return 1;
  }
  if (method == "len" || method == "cleared" || method == "keys" || method == "values") {
    return 0;
  }
  return 0 - 1;
}

function map_arg_diag(c: ast.ExprCall, ii: i32, method: string, slot: typeinfo.Type, s: Scope, out: util.Diag[]): util.Diag[] {
  let arg: ast.Expr = c.args[ii];
  let it: typeinfo.Type = check_expr(arg, s);
  let stores: boolean = method == "insert";
  let lent: boolean = !stores && view_arg_borrow(it, slot);
  let mismatch: boolean = stores && is_str_view(it) && is_owned_string(slot);
  if (!literal_insert(c) && !is_unknown(slot) && !is_unknown(it)) {
    out = util.append_diags(out, int_dest_range_diags(arg, slot));
    mismatch = !lent && !settles_to(arg, slot, s) && !coercible(it, slot, s);
  }
  if (mismatch) {
    out = out.append(dg_at("E038", "argument " + util.i32_to_string(ii + 1) + " to \"" + method + "\": expected " + type_label(slot) + ", got " + type_label(it) + str_copy_hint(it, slot), expr_line(arg), expr_col(arg)));
  }
  return out;
}

function call_diags_call(c: ast.ExprCall, s: Scope, out: util.Diag[], dest: typeinfo.Type): util.Diag[] {
  out = util.append_diags(out, e032_call_check(c, s));
  match (c.callee) {
    ast.ExprFieldAccess(mfa) => {
      let cqen: string = qual_enum_name(mfa.obj, s);
      if (cqen.len() > 0 && !assoc_call_req(mfa.obj, mfa.field, s, mfa.const_read).found) {
        if (!qual_variant_exists(cqen, mfa.field, s)) {
          out = out.append(no_variant_diag(s, cqen, mfa.field, mfa.line, mfa.col));
        } else {
          out = util.append_diags(out, variant_ctor_diags(cqen + "." + mfa.field, c, s));
        }
        for arg in c.args {
          out = util.append_diags(out, call_diags(arg, s));
        }
        return out;
      }
      let ah: AssocHit = assoc_call_req(mfa.obj, mfa.field, s, mfa.const_read);
      if (ah.found) {
        let acr: util.Diag[] = assoc_const_read_diags(ah, c, mfa);
        if (acr.len() > 0) {
          return util.append_diags(out, acr);
        }
        for arg in c.args {
          out = util.append_diags(out, call_diags(arg, s));
        }
        return util.append_diags(out, assoc_arg_diags(ah, c, mfa, s));
      }
      if (mfa.const_read) {
        return out.append(dg_at("E043", util.demangle(assoc_base_name(mfa.obj)) + " has no associated constant \"" + mfa.field + "\"", c.line, c.col));
      }
      if let ast.ExprIdent(tid) = mfa.obj {
        if (!s.known(tid.name) && util.has_str(s.tparams, tid.name)) {
          out = out.append(tparam_assoc_diag(tid, mfa.field, s));
          for arg in c.args {
            out = util.append_diags(out, call_diags(arg, s));
          }
          return out;
        }
      }
      out = call_diags(mfa.obj, s);
      match (check_expr(mfa.obj, s)) {
        typeinfo.TypeTuple(mtt) => {
          let tdg: util.Diag[] = tuple_field_diags(mfa.field, mtt, mfa.line, mfa.col);
          if (tdg.len() > 0) {
            return util.append_diags(out, tdg);
          }
        },
        _ => {}
      }
      if (mfa.field == "insert" && mlit_is_base(mfa.obj) && c.args.len() >= 1) {
        let kt: typeinfo.Type = check_expr(c.args[0], s);
        let kmsg: string = map_key_type_error(s, kt);
        if (kmsg != "") {
          out = out.append(dg_at("E045", kmsg, expr_line(c.args[0]), expr_col(c.args[0])));
        }
      }
    },
    ast.ExprIdent(cid) => {
      if (!is_resolvable_callee(cid.name, s)) {
        out = out.append(undefined_name(cid.name, s, cid.line, cid.col));
      }
      if (is_map_new_name(cid.name) && !s.module_imported("core/map")) {
        out = out.append(dg_at("E001", map_import_msg(), c.line, c.col));
      }
    },
    _ => {
      out = call_diags(c.callee, s);
    }
  }
  let dests: typeinfo.Type[] = s.call_param_types(c);
  let di: i32 = 0;
  if (!s.callee_resolves(c)) {
    di = c.args.len();
  }
  while (di < c.args.len()) {
    let dest: typeinfo.Type = t_unknown("no declared parameter");
    if (di < dests.len()) {
      dest = dests[di];
    }
    if (generic_fn_value_arg(c.args[di], s)) {
      dest = bound_param_dest(c, di, dest, s);
    }
    out = util.append_diags(out, dest_call_diags(c.args[di], dest, s));
    di = di + 1;
  }
  match (c.callee) {
    ast.ExprFieldAccess(_) => {},
    _ => {
      let calleet: typeinfo.Type = check_expr(c.callee, s);
      let callee_is_fn: boolean = is_func_type(calleet);
      if (!is_unknown(calleet) && !callee_is_fn) {
        out = out.append(dg_at("E038", "calling non-function value of type " + type_label(calleet), c.line, c.col));
      }
    }
  }
  match (c.callee) {
    ast.ExprIdent(id) => {
      if (id.name == "__set_field" && c.args.len() == 3) {
        let fld: string = "field";
        match (c.args[1]) {
          ast.ExprString(fs) => {
            fld = fs.value;
          },
          _ => {}
        }
        if let typeinfo.TypeStruct(ost) = check_expr(c.args[0], s) {
          out = util.append_diags(out, opaque_access_diags(s.lookup_struct(ost.name), s, "access a field of", expr_line(c.args[1]), expr_col(c.args[1])));
        }
        out = out.append(dg_at("E048", "cannot assign to field \"" + fld + "\": fields are immutable after construction; rebuild with a struct-update literal", expr_line(c.args[1]), expr_col(c.args[1])));
      }
      if (id.name == "__set_index" && c.args.len() == 3) {
        out = out.append(dg_at("E056", "cannot assign to an array element: subscripts are read-only after construction; use `arr = arr.with(i, value)`", c.line, c.col));
      }
      if (id.name == "cell_new" && c.args.len() == 1) {
        let cnat: typeinfo.Type = check_expr(c.args[0], s);
        out = util.append_diags(out, e057_diag(type_label(named_tparams(cnat)), cnat, s, expr_line(c.args[0]), expr_col(c.args[0])));
      }

      if (scope_variant_owner(id.name, s).len() > 0 || parser.builtin_enum_of(id.name).len() > 0) {
        for arg in c.args {
          let unit_binding: boolean = false;
          if let ast.ExprIdent(_) = arg {
            unit_binding = true;
          }
          if (is_void(check_expr(arg, s)) && !parser.is_unit_expr(arg) && !unit_binding) {
            out = out.append(dg_at("E072", "a void expression is not a value here; call it as a statement, and write `()` if you meant the unit value", expr_line(arg), expr_col(arg)));
          }
        }
      }
      if (!s.defines(id.name)) {
        let sig: FuncSig = s.lookup_sig(id.name);
        if (sig.name.len() > 0 && sig.all_type_params.len() > 0 && c.type_args.len() > 0 && c.type_args.len() != sig.all_type_params.len()) {
          out = out.append(dg_at("E040", util.arity_message(id.name, sig.all_type_params.len(), c.type_args.len(), "type argument"), c.line, c.col));
        } else if (sig.name.len() > 0 && c.type_args.len() > 0) {
          out = util.append_diags(out, const_arg_diags(sig, c, s));
        }
        if (sig.name.len() > 0) {
          if (c.args.len() != sig.param_types.len()) {
            out = out.append(dg_at("E004", util.arity_message(call_subject(c), sig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
          } else {
            let cbn: string[] = [];
            let cbt: typeinfo.Type[] = [];
            if (sig.all_type_params.len() > 0) {
              let (bn0, bt0) = call_type_bindings(sig, c, s);
              cbn = bn0;
              cbt = bt0;
            }
            let ai: i32 = 0;
            while (ai < c.args.len()) {
              let at: typeinfo.Type = check_expr(c.args[ai], s);
              out = util.append_diags(out, int_dest_range_diags(c.args[ai], sig.param_types[ai]));
              out = util.append_diags(out, bound_type_arg_diags(sig, c, ai, at, s, cbn, cbt));
              out = util.append_diags(out, ctor_payload_diags(c.args[ai], sig.param_types[ai], s));
              let bound_checked: boolean = param_has_bindings(sig, ai, cbn);
              if (!bound_checked && !(sig.all_type_params.len() > 0 && binds_nothing(c.args[ai], s)) && !is_unknown(at) && !is_unknown(sig.param_types[ai]) && !settles_to(c.args[ai], sig.param_types[ai], s) && !view_arg_borrow(at, sig.param_types[ai]) && !coercible(at, sig.param_types[ai], s)) {
                out = out.append(dg_at("E038", arg_subject(c, ai + 1) + ": expected " + type_label(sig.param_types[ai]) + ", got " + argument_type_label(c.args[ai], at, s), expr_line(c.args[ai]), expr_col(c.args[ai])));
              }
              out = util.append_diags(out, array_elem_check(array_elem_type_of(sig.param_types[ai]), c.args[ai], s));
              ai = ai + 1;
            }
            if (sig.all_type_params.len() > 0) {
              out = util.append_diags(out, call_bound_diags(sig.type_params, sig.type_bounds, sig.module, util.demangle(sig.name), cbn, cbt, s, c.line, c.col));
              let (fbn, fbt) = call_bindings(sig, c, s);
              out = util.append_diags(out, bound_arg_diags(sig, c, fbn, fbt, s));
              out = util.append_diags(out, uninferred_call_diags(sig, c, fbn, id.name, s, dest));
            }
          }
        }
        if (sig.name.len() == 0) {
          out = util.append_diags(out, callable_arg_diags(c, free_builtin_sig(id.name, s), s));
          out = util.append_diags(out, lane_index_diags(id.name, c));
          out = util.append_diags(out, display_arg_diags(c, s));
          if (is_display_builtin(id.name) && c.args.len() != 1) {
            out = out.append(dg_at("E004", util.arity_message(call_subject(c), 1, c.args.len(), "argument"), c.line, c.col));
          }
        }
        if (s.lookup_sig(id.name).name.len() == 0) {
          out = util.append_diags(out, variant_ctor_diags(id.name, c, s));
        }
      } else {
        out = util.append_diags(out, callable_arg_diags(c, s.lookup(id.name), s));
      }
    },
    ast.ExprFieldAccess(mfa) => {
      let recv: typeinfo.Type = check_expr(mfa.obj, s);
      match (recv) {
        typeinfo.TypeTuple(_) => {
          out = util.append_diags(out, callable_arg_diags(c, check_expr(c.callee, s), s));
        },
        typeinfo.TypeI32(it) => {
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice(int_label(it), mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, int_label(it), mfa.field, s));
        },
        typeinfo.TypeFloat(f) => {
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice(float_label(f), mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, float_label(f), mfa.field, s));
        },
        typeinfo.TypeBool(_) => {
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("boolean", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, "boolean", mfa.field, s));
        },
        typeinfo.TypeString(_) => {
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("string", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          out = util.append_diags(out, declared_method_diags(c, recv, "string", mfa.field, s));
        },
        typeinfo.TypeArray(ar) => {
          if (!ar.view && mfa.field == "append" && c.args.len() == 1 && !is_unknown(ar.elem)) {
            let aat: typeinfo.Type = check_expr(c.args[0], s);
            out = util.append_diags(out, int_dest_range_diags(c.args[0], ar.elem));
            if (!is_unknown(aat) && !settles_to(c.args[0], ar.elem, s) && !coercible(aat, ar.elem, s)) {
              out = out.append(dg_at("E038", "argument 1 to \"append\": expected " + type_label(ar.elem) + ", got " + type_label(aat) + str_copy_hint(aat, ar.elem), expr_line(c.args[0]), expr_col(c.args[0])));
            }
          }
          if (!ar.view && mfa.field == "with" && c.args.len() == 2 && !is_unknown(ar.elem)) {
            let wvt: typeinfo.Type = check_expr(c.args[1], s);
            out = util.append_diags(out, int_dest_range_diags(c.args[1], ar.elem));
            if (!is_unknown(wvt) && !settles_to(c.args[1], ar.elem, s) && !coercible(wvt, ar.elem, s)) {
              out = out.append(dg_at("E038", "argument 2 to \"with\": expected " + type_label(ar.elem) + ", got " + type_label(wvt) + str_copy_hint(wvt, ar.elem), expr_line(c.args[1]), expr_col(c.args[1])));
            }
          }
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("Array", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
          let arr_label: string = "Array";
          if (ar.view) {
            arr_label = "slice";
          }
          let asig: MethodSig = s.array_recv_method(mfa.field, ar.view);
          out = util.append_diags(out, uninferred_method_diags(c, arr_label, mfa.field, asig, s));
          if (asig.name.len() > 0 && c.args.len() == asig.param_types.len()) {
            out = util.append_diags(out, method_arg_diags(c, mfa.field, asig, recv, s));
            out = util.append_diags(out, method_type_arg_diags(c, mfa.field, asig, recv, s));
          }
          let abw: i32 = 0 - 1;
          if (mfa.field == "len") {
            abw = 0;
          }
          if (!ar.view && mfa.field == "append") {
            abw = 1;
          }
          if (!ar.view && mfa.field == "with") {
            abw = 2;
          }
          if (abw >= 0 && c.args.len() != abw) {
            out = out.append(dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", abw, c.args.len(), "argument"), c.line, c.col));
          }
        },
        typeinfo.TypeMap(mt) => {
          out = map_arg_diags(c, mfa.field, mt, s, out);
          out = unbound_map_arg_diags(c, mfa.field, mt, s, out);
          out = util.append_diags(out, map_method_arg_diags(c, recv, mfa.field, s));
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_message("Map", mfa.field, "Map", recv), mfa.line, mfa.col), mfa, recv));
          }
        },
        typeinfo.TypeDyn(d) => {
          out = util.append_diags(out, dyn_call_diags(c, mfa, d.traits, s));
        },
        typeinfo.TypeStruct(sn) => {
          if (is_cell_type(recv)) {
            out = util.append_diags(out, cell_call_diags(c, mfa, recv, s));
          } else {
            out = util.append_diags(out, ambiguous_call_diags(mfa, sn.name, s));
            out = util.append_diags(out, finalizer_call_diags(mfa, sn.name, s));
            let msig: MethodSig = s.lookup_method(mfa.field, sn.name);
            if (msig.name.len() > 0) {
              if (c.args.len() != msig.param_types.len()) {
                out = out.append(dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
              } else {
                out = util.append_diags(out, method_arg_diags(c, mfa.field, msig, recv, s));
                out = util.append_diags(out, method_type_arg_diags(c, mfa.field, msig, recv, s));
                out = util.append_diags(out, uninferred_method_diags(c, sn.name, mfa.field, msig, s));
                out = util.append_diags(out, uninferred_recv_diags(c, sn.name, mfa.field, msig, sn.args, s));
              }
            } else {
              let bms: typeinfo.Type = builtin_method_sig(sn.name, mfa.field);
              let fsig: StructSig = s.lookup_struct(sn.name);
              if (!is_unknown(bms)) {
                out = util.append_diags(out, callable_arg_diags(c, bms, s));
              } else if (fsig.name.len() > 0) {
                let fldi: i32 = field_index(fsig, mfa.field);
                if (fldi < 0) {
                  out = out.append(s.member_fix(dg_at("E043", "struct " + util.demangle(sn.name) + " has no field or method \"" + mfa.field + "\"", mfa.line, mfa.col), mfa, fsig));
                } else {
                  let fldt: typeinfo.Type = field_access_result_type(mfa, sn, s);
                  let fld_is_fn: boolean = false;
                  match (fldt) {
                    typeinfo.TypeFunc(_) => {
                      fld_is_fn = true;
                    },
                    _ => {}
                  }
                  if (!fld_is_fn) {
                    out = out.append(dg_at("E038", "calling non-function value of type " + type_label(fldt), mfa.line, mfa.col));
                  } else {
                    out = util.append_diags(out, callable_arg_diags(c, check_expr(c.callee, s), s));
                  }
                }
              }
            }
          }
        },
        typeinfo.TypeUnion(un) => {
          out = util.append_diags(out, ambiguous_call_diags(mfa, un.name, s));
          out = util.append_diags(out, finalizer_call_diags(mfa, un.name, s));
          let umsig: MethodSig = s.lookup_method(mfa.field, un.name);
          if (umsig.name.len() > 0 && c.args.len() == umsig.param_types.len()) {
            out = util.append_diags(out, method_arg_diags(c, mfa.field, umsig, recv, s));
            out = util.append_diags(out, method_type_arg_diags(c, mfa.field, umsig, recv, s));
            out = util.append_diags(out, uninferred_method_diags(c, un.name, mfa.field, umsig, s));
            out = util.append_diags(out, uninferred_recv_diags(c, un.name, mfa.field, umsig, un.args, s));
          }
          if (s.method_missing(recv, mfa.field)) {
            out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice("", mfa.field, recv), mfa.line, mfa.col), mfa, recv));
          }
        },
        _ => {
          out = util.append_diags(out, type_param_method_diags(c, mfa, recv, s));
        }
      }
    },
    _ => {
      out = util.append_diags(out, callable_arg_diags(c, check_expr(c.callee, s), s));
    }
  }

  return out;
}

function type_param_method_diags(c: ast.ExprCall, mfa: ast.ExprFieldAccess, recv: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let tpn: string = tp_receiver(recv, s);
  if (tpn.len() > 0) {
    let tph: AssocHit = tp_assoc_req(s, tpn, mfa.field);
    if (tph.found) {
      out = out.append(dg_at("E021", "\"" + mfa.field + "\" is an associated function of trait " + tph.owner + ", not a method; call it as " + tpn + "." + mfa.field + "(...)", c.line, c.col));
    } else if (!tp_bound_provides(s, tpn, mfa.field)) {
      out = out.append(dg_at("E021", "no method \"" + mfa.field + "\" on type parameter " + tpn + "; add a trait bound such as [" + tpn + ": SomeTrait] that provides it", c.line, c.col));
    } else {
      match (bound_method(s, tpn, mfa.field)) {
        Some(msig) => {
          if (c.args.len() != msig.param_types.len()) {
            out = out.append(dg_at("E004", util.arity_message("method \"" + mfa.field + "\"", msig.param_types.len(), c.args.len(), "argument"), c.line, c.col));
          } else {
            out = util.append_diags(out, method_arg_diags(c, mfa.field, msig, recv, s));
            out = util.append_diags(out, method_type_arg_diags(c, mfa.field, msig, recv, s));
          }
        },
        None => {}
      }
    }
  }
  return out;
}

function binop_lit_range_diags(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): util.Diag[] {
  let out: util.Diag[] = [];
  if (!is_integer(lt) || !is_integer(rt)) {
    return out;
  }
  if (int_literal_tree(b.left) && !int_literal_tree(b.right)) {
    return int_dest_range_diags(b.left, rt);
  }
  if (int_literal_tree(b.right) && !int_literal_tree(b.left)) {
    return int_dest_range_diags(b.right, lt);
  }
  return out;
}

function tvar_operator_diags(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type, s: Scope): util.Diag[] {
  let method: string = tvar_operator_method(b.op);
  if (method == "-") {
    return [];
  }
  for side in [lt, rt] {
    let name: string = unmet_tvar(side, method, s);
    if (name != "") {
      return [dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + name, b.line, b.col)];
    }
  }
  let ln: string = unmet_tvar(lt, "", s);
  let rn: string = unmet_tvar(rt, "", s);
  if (ln != rn && !is_unknown(lt) && !is_unknown(rt)) {
    let name: string = ln;
    if (name == "") {
      name = rn;
    }
    return [dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + name, b.line, b.col)];
  }
  return [];
}

function tvar_operator_method(op: string): string {
  if (op == "<" || op == "<=" || op == ">" || op == ">=") {
    return "cmp";
  }
  let method: string = ast.operator_method(op);
  if (method != "" || util.has_str(["+|", "-|", "*|", "<<|", "+?", "-?", "*?", "/?", "%?", "<<?", ">>?"], op)) {
    return method;
  }
  return "-";
}

function unmet_tvar(t: typeinfo.Type, method: string, s: Scope): string {
  let name: string = "";
  if let typeinfo.TypeErased(e) = t {
    name = e.name;
  }
  if (name == "" || !util.has_str(s.tparams, name)) {
    return "";
  }
  if (method != "" && tp_bound_provides(s, name, method)) {
    return "";
  }
  return name;
}

function tvar_neg_diags(u: ast.ExprUnary, s: Scope): util.Diag[] {
  if (u.op != "-") {
    return [];
  }
  let name: string = unmet_tvar(check_expr(u.operand, s), "neg", s);
  if (name == "") {
    return [];
  }
  return [dg_at("E009", "operator \"-\" requires an integer type, got " + name, u.line, u.col)];
}

function call_diags_binary(b: ast.ExprBinary, s: Scope, out: util.Diag[]): util.Diag[] {
  if (b.op == "__named_arg") {
    return util.append_diags(out, call_diags(b.right, s));
  }
  let (diags, bt) = binary_diags_typed(b, s);
  return diags;
}

function operand_diags_typed(e: ast.Expr, s: Scope): (util.Diag[], typeinfo.Type) {
  if let ast.ExprBinary(b) = e {
    if (b.op != "__named_arg") {
      return binary_diags_typed(b, s);
    }
  }
  return (call_diags(e, s), check_expr(e, s));
}

function lanes_operator_diags(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): util.Diag[] {
  if (util.has_str(["==", "!=", "<", ">", "<=", ">="], b.op)) {
    let lanes: string = type_label(lt);
    if (!is_lanes(lt)) {
      lanes = type_label(rt);
    }
    return [dg_at("E041", "cannot compare values of type " + lanes + " with \"" + b.op + "\": a lane value compares lane by lane, through __" + lanes + "_lt and __" + lanes + "_ne", b.line, b.col)];
  }
  if (util.has_str(["+", "-", "*", "/"], b.op) && type_eq(lt, rt)) {
    return [];
  }
  if (operand_open(lt) || operand_open(rt)) {
    return [];
  }
  let what: string = "numeric";
  if (b.op == "+") {
    what = "numeric or string";
  }
  return [dg_at("E009", "operator \"" + b.op + "\" requires matching " + what + " operands, got " + type_label(lt) + " and " + type_label(rt), b.line, b.col)];
}

function binary_diags_typed(b: ast.ExprBinary, s: Scope): (util.Diag[], typeinfo.Type) {
  let (ldiags, blt) = operand_diags_typed(b.left, s);
  let (rdiags, brt) = operand_diags_typed(b.right, s);
  let out: util.Diag[] = util.append_diags(ldiags, rdiags);
  out = util.append_diags(out, binop_lit_range_diags(b, blt, brt));
  out = util.append_diags(out, tvar_operator_diags(b, blt, brt, s));
  if (is_lanes(blt) || is_lanes(brt)) {
    return (util.append_diags(out, lanes_operator_diags(b, blt, brt)), binary_result_type(b, blt, brt, s));
  }
  if (b.op == "&&" || b.op == "||") {
    if (!is_unknown(blt) && !type_eq(blt, t_bool())) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires boolean, got " + type_label(blt), b.line, b.col));
    }
    if (!is_unknown(brt) && !type_eq(brt, t_bool())) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires boolean, got " + type_label(brt), b.line, b.col));
    }
  }
  if (b.op == "==" || b.op == "!=") {
    let eq_widths: boolean = type_eq(blt, brt) || !is_unknown(scalar_numeric_join(blt, brt))
      || settles_to(b.left, brt, s) || settles_to(b.right, blt, s);
    if (!is_unknown(blt) && !is_unknown(brt) && !eq_widths) {
      out = out.append(dg_at("E041", "cannot compare " + type_label(blt) + " with " + type_label(brt) + ": both sides of \"" + b.op + "\" must have the same type", b.line, b.col));
    } else if (!is_unknown(blt) && eq_widths && is_composite_type(blt)) {
      let eqrecv: string = cmp_method_receiver(blt);
      if (eqrecv == "") {
        out = out.append(dg_at("E041", "cannot compare values of type " + type_label(blt) + " with \"" + b.op + "\": structural equality for arrays / slices / tuples is not supported — compare elements individually", b.line, b.col));
      } else if (s.lookup_method("eq", eqrecv).name.len() == 0) {
        out = out.append(dg_at("E041", "cannot compare values of type " + util.demangle(type_label(blt)) + " with \"" + b.op + "\": type does not implement `Eq` — " + util.derive_hint(eqrecv, "cmp.Eq", "cmp.Eq") + ", so `==` can use structural equality", b.line, b.col));
      }
    }
  }
  if (b.op == "+") {
    let (pl, pr) = settled_operands(b, blt, brt);
    if (!operand_open(pl) && !operand_open(pr)) {
      let oks: boolean = type_eq(pl, t_string()) && type_eq(pr, t_string());
      let both_int: boolean = is_integer(pl) && is_integer(pr);
      let oki2: boolean = both_int && int_operands_agree(pl, pr, b.left, b.right);
      let okf2: boolean = float_operands_agree(pl, pr);
      let okov2: boolean = !is_unknown(s.binop_overload_ret(b.op, pl));
      if (!oks && !oki2 && !okf2 && !okov2) {
        if (both_int) {
          out = out.append(mixed_int_diag(b.op, pl, pr, b.line, b.col));
        } else {
          out = util.append_diags(out, numeric_operand_diags(b.op, pl, pr, b.line, b.col));
        }
      }
    }
  }
  if (b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%") {
    let (alt, art) = settled_operands(b, blt, brt);
    if (!operand_open(alt) && !operand_open(art)) {
      let a_both_int: boolean = is_integer(alt) && is_integer(art);
      let oki: boolean = a_both_int && int_operands_agree(alt, art, b.left, b.right);
      let okf: boolean = b.op != "%" && float_operands_agree(alt, art);
      let okov: boolean = !is_unknown(s.binop_overload_ret(b.op, alt));
      if (!oki && !okf && !okov) {
        if (a_both_int) {
          out = out.append(mixed_int_diag(b.op, alt, art, b.line, b.col));
        } else {
          out = util.append_diags(out, numeric_operand_diags(b.op, alt, art, b.line, b.col));
        }
      }
    }
  }
  if (b.op == "+|" || b.op == "-|" || b.op == "*|" || b.op == "<<|") {
    if (!operand_open(blt) && !operand_open(brt)) {
      if (!is_integer(blt) || !is_integer(brt)) {
        out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires matching integer operands, got " + type_label(blt) + " and " + type_label(brt), b.line, b.col));
      } else if (is_usize(blt) || is_usize(brt)) {
        out = out.append(dg_at("E009", "saturating operator \"" + b.op + "\" is not supported on `usize` — its clamp bounds are target-width-dependent; cast to a fixed-width integer (`as u64`) first", b.line, b.col));
      } else if (!int_operands_agree(blt, brt, b.left, b.right)) {
        out = out.append(mixed_int_diag(b.op, blt, brt, b.line, b.col));
      }
    }
  }
  if (b.op == "+?" || b.op == "-?" || b.op == "*?" || b.op == "/?" || b.op == "%?" || b.op == "<<?" || b.op == ">>?") {
    if (!operand_open(blt) && !operand_open(brt)) {
      if (!is_integer(blt) || !is_integer(brt)) {
        out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires matching integer operands, got " + type_label(blt) + " and " + type_label(brt), b.line, b.col));
      } else if (is_usize(blt) || is_usize(brt)) {
        out = out.append(dg_at("E009", "checked operator \"" + b.op + "\" is not supported on `usize` — its overflow bound is target-width-dependent; cast to a fixed-width integer (`as u64`) first", b.line, b.col));
      } else if (!int_operands_agree(blt, brt, b.left, b.right)) {
        out = out.append(mixed_int_diag(b.op, blt, brt, b.line, b.col));
      }
    }
  }
  if (b.op == "<<" || b.op == ">>" || b.op == "&" || b.op == "|" || b.op == "^") {
    let sov: boolean = !is_unknown(s.binop_overload_ret(b.op, blt));
    if (!sov && !operand_open(blt) && !is_integer(blt)) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + type_label(blt), b.line, b.col));
    } else if (!sov && !operand_open(brt) && !is_integer(brt)) {
      out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires an integer type, got " + type_label(brt), b.line, b.col));
    } else if (!sov && !operand_open(blt) && !operand_open(brt) && !int_operands_agree(blt, brt, b.left, b.right)) {
      out = out.append(mixed_int_diag(b.op, blt, brt, b.line, b.col));
    }
  }
  if (b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") {
    let (olt, ort) = settled_operands(b, blt, brt);
    if (!operand_open(olt) && !operand_open(ort)) {
      let o_both_int: boolean = is_integer(olt) && is_integer(ort);
      let oki_o: boolean = o_both_int && int_operands_agree(olt, ort, b.left, b.right);
      let okf_o: boolean = float_operands_agree(olt, ort);
      let oks_o: boolean = type_eq(olt, t_string()) && type_eq(ort, t_string());
      let okc_o: boolean = type_eq(olt, t_char()) && type_eq(ort, t_char());
      if (!oki_o && !okf_o && !oks_o && !okc_o) {
        if (type_eq(olt, ort) && is_composite_type(olt)) {
          let ordrecv: string = cmp_method_receiver(olt);
          if (ordrecv == "") {
            out = out.append(dg_at("E041", "cannot order values of type " + type_label(olt) + " with \"" + b.op + "\": structural ordering for arrays / slices / tuples is not supported", b.line, b.col));
          } else if (!s.has_ord_cmp(olt)) {
            out = out.append(dg_at("E041", "cannot order values of type " + util.demangle(type_label(olt)) + " with \"" + b.op + "\": type does not implement `Ord` — " + util.derive_hint(ordrecv, "cmp.Ord", "cmp.Ord") + ", so ordering can use structural comparison", b.line, b.col));
          }
        } else if (o_both_int) {
          out = out.append(mixed_int_diag(b.op, olt, ort, b.line, b.col));
        } else {
          out = out.append(dg_at("E009", "operator \"" + b.op + "\" requires matching numeric or string operands, got " + type_label(olt) + " and " + type_label(ort), b.line, b.col));
        }
      }
    }
  }

  return (out, binary_result_type(b, blt, brt, s));
}

function call_diags_unary(u: ast.ExprUnary, s: Scope, out: util.Diag[]): util.Diag[] {
  out = call_diags(u.operand, s);
  if (u.op == "!") {
    let ot: typeinfo.Type = check_expr(u.operand, s);
    if (!is_unknown(ot) && !type_eq(ot, t_bool())) {
      out = out.append(dg_at("E009", "operator \"!\" requires boolean, got " + type_label(ot), u.line, u.col));
    }
  }
  out = util.append_diags(out, tvar_neg_diags(u, s));
  if (u.op == "-") {
    let nt: typeinfo.Type = check_expr(u.operand, s);
    let nok: boolean = !is_unknown(s.unop_overload_ret(u.op, nt));
    if (!operand_open(nt) && !is_integer(nt) && !is_float(nt) && !is_lanes(nt) && !nok) {
      out = out.append(dg_at("E009", "operator \"-\" requires an integer type, got " + type_label(nt), u.line, u.col));
    }
  }
  if (u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as_") {
    if (u.op == "as_char") {
      match (u.operand) {
        ast.ExprNumber(cn) => {
          if (!cn.is_float && !lit_is_scalar_value(cn.text)) {
            out = out.append(dg_at("E071", lit_scalar_msg(cn.text), u.line, u.col));
          }
        },
        _ => {}
      }
    }
    let tgt: typeinfo.Type = s.resolve_type(slice_unchecked(u.op, 3, u.op.len()) + "");
    if let ast.ExprNumber(_) = u.operand {
      out = util.append_diags(out, int_dest_range_diags(u.operand, tgt));
    }
    out = util.append_diags(out, cast_diags(u, tgt, check_expr(u.operand, s), s));
  }
  if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
    let aot: typeinfo.Type = check_expr(u.operand, s);
    let target: string = slice_unchecked(u.op, 4, u.op.len()) + "";
    if (is_integer(aot)) {
      if (!is_integer(s.resolve_type(target))) {
        out = out.append(dg_at("E060", "'as?' from " + type_label(aot) + " converts only to an integer type, got " + target, u.line, u.col));
      }
    } else if (!downcast_operand_ok(aot)) {
      out = out.append(dg_at("E059", "'as?' requires a 'dyn Trait' value or an integer on the left, got " + type_label(aot), u.line, u.col));
    }
  }
  if (u.op == "try_") {
    let trt: typeinfo.Type = check_expr(u.operand, s);
    if (is_primitive_type(trt)) {
      out = out.append(dg_at("E042", "`?` operator requires an Option, a Result, or an `@try` enum, got " + type_label(trt), u.line, u.col));
    } else {
      match (trt) {
        typeinfo.TypeUnion(tu) => {
          if (try_able_union(s, tu.name)) {
            if (try_ret_other_type(s.try_ret, tu.name)) {
              out = out.append(dg_at("E042", "`?` on " + tu.name + " requires the surrounding function to return " + tu.name + ", got " + try_ret_label(s.try_ret), u.line, u.col));
            } else {
              out = util.append_diags(out, try_residual_diags(s, trt, u));
            }
          } else {
            let us: UnionSig = s.lookup_union(tu.name);
            if (us.name.len() != 0) {
              out = out.append(dg_at("E042", "`?` operator requires an Option, a Result, or an `@try` enum, got " + tu.name + " — mark it `@try` to make it one", u.line, u.col));
            }
          }
        },
        _ => {}
      }
    }
  }

  return out;
}

function cast_diags(u: ast.ExprUnary, tgt: typeinfo.Type, cot: typeinfo.Type, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  if (is_primitive_type(tgt) && is_primitive_type(cot)) {
    if (type_eq(tgt, t_string()) && cast_pointer_int(cot) && !is_usize(cot)) {
      return [e069_cast(u, cot, tgt)];
    }
    if (!as_cast_allowed(cot, tgt)) {
      return [e033_cast(u, cot, tgt)];
    }
    return none;
  }
  let unresolved: util.Diag[] = unresolved_cast_diags(u, tgt, cot, s);
  if (unresolved.len() > 0) {
    return unresolved;
  }
  if (type_contains_unknown(tgt) || type_contains_unknown(cot)) {
    return none;
  }
  if (cast_pointer_int(cot) && cast_pointer_shaped(tgt, false)) {
    if (!is_usize(cot)) {
      return [e069_cast(u, cot, tgt)];
    }
    return none;
  }
  if (!(cast_pointer_int(tgt) && cast_pointer_shaped(cot, true)) && !coercible(cot, tgt, s)) {
    return [e033_cast(u, cot, tgt)];
  }
  return none;
}

function unresolved_cast_diags(u: ast.ExprUnary, tgt: typeinfo.Type, cot: typeinfo.Type, s: Scope): util.Diag[] {
  if let typeinfo.TypeUnknown(tu) = tgt {
    let name: string = typevar_reason_name(tu.reason);
    if (util.str_has_prefix(tu.reason, UNRESOLVED_MARK) && !util.has_str(s.tparams, name) && cast_pointer_int(cot) && !is_usize(cot)) {
      return [e069_cast(u, cot, t_struct(name))];
    }
  }
  return [];
}

function e069_cast(u: ast.ExprUnary, cot: typeinfo.Type, tgt: typeinfo.Type): util.Diag {
  return dg_at("E069", "reinterpreting a 32-bit " + type_label(cot) + " value as the pointer-shaped type " + type_label(tgt) + " via `as` truncates the address; carry pointer-shaped values in a usize local/param instead", u.line, u.col);
}

function e033_cast(u: ast.ExprUnary, cot: typeinfo.Type, tgt: typeinfo.Type): util.Diag {
  return dg_at("E033", "cannot cast " + type_label(cot) + " to " + type_label(tgt) + ": `as` converts only between numeric types", u.line, u.col);
}

function try_ret_other_type(ret: typeinfo.Type, name: string): boolean {
  if (is_type_variable(ret)) {
    return true;
  }
  match (ret) {
    typeinfo.TypeUnion(ru) => {
      return ru.name != name;
    },
    typeinfo.TypeVoid(_) => {
      return true;
    },
    _ => {
      return spellable(ret);
    }
  }
  return false;
}

function try_ret_label(ret: typeinfo.Type): string {
  if (is_type_variable(ret)) {
    return callable_typevar_name(ret);
  }
  return type_label(ret);
}

function try_residual_diags(s: Scope, src: typeinfo.Type, u: ast.ExprUnary): util.Diag[] {
  let out: util.Diag[] = [];
  let sr: typeinfo.Type = result_residual(src);
  let rr: typeinfo.Type = result_residual(s.try_ret);
  if (!spellable(sr) || !spellable(rr) || type_eq(sr, rr)) {
    return out;
  }
  let sl: string = type_label(sr);
  let rl: string = type_label(rr);
  if let typeinfo.TypeDyn(d) = rr {
    if (dyn_conforms(sr, rr, s)) {
      return out;
    }
    return out.append(dg_at("E042", "`?` cannot box " + sl + " into " + rl + ": " + sl + " does not implement " + unimplemented_traits(s, sr, d.traits), u.line, u.col));
  }
  if (from_converts(s, sr, rr)) {
    return out;
  }
  return out.append(dg_at("E042", "`?` on Result carrying " + sl + " but the surrounding function carries " + rl + ", and " + rl + " has no `from(" + sl + ")` constructor to convert it (std/convert's `impl From[" + sl + "] for " + rl + "`)", u.line, u.col));
}

function unimplemented_traits(s: Scope, src: typeinfo.Type, traits: string): string {
  let set: string[] = parser.dyn_trait_set("dyn " + traits);
  if (is_owned_array(src) || is_arr_view(src) || is_dyn_slot(src)) {
    return set[0];
  }
  let tn: string = util.base_type_name(type_label(src));
  let missing: string = "";
  for tr in set {
    if (!conforms_to_dyn_trait(s, tn, tr)) {
      if (missing.len() > 0) {
        missing = missing + " + ";
      }
      missing = missing + tr;
    }
  }
  if (missing.len() == 0) {
    return set[0];
  }
  return missing;
}

function result_residual(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(tu) = t {
    if (tu.name == "Result" && tu.args.len() == 2) {
      return tu.args[1];
    }
  }
  return t_unknown("not a Result");
}

function from_converts(s: Scope, from_t: typeinfo.Type, to: typeinfo.Type): boolean {
  let owner: string = struct_name_of(to);
  if let typeinfo.TypeUnion(tu) = to {
    owner = tu.name;
  }
  if (owner.len() == 0) {
    return false;
  }
  let sig: FuncSig = s.lookup_assoc_sig(owner, "from");
  if (sig.name.len() == 0 || sig.param_types.len() != 1) {
    return false;
  }
  return !spellable(sig.param_types[0]) || type_eq(sig.param_types[0], from_t);
}

function call_diags_array(a: ast.ExprArray, s: Scope, out: util.Diag[]): util.Diag[] {
  for element in a.elements {
    out = util.append_diags(out, call_diags(element, s));
  }
  return array_mix_diags(a, s, out);
}

function array_mix_diags(a: ast.ExprArray, s: Scope, out: util.Diag[]): util.Diag[] {
  if (a.elements.len() >= 2) {
    let anchor: typeinfo.Type = check_expr(a.elements[0], s);
    if (type_contains_unknown(anchor)) {
      return out;
    }
    let anchor_lit: i32 = numeric_literal_kind(a.elements[0]);
    if (is_primitive_type(anchor) || is_func_type(anchor) || is_tuple_type(anchor)) {
      let k: i32 = 1;
      let flagged: boolean = false;
      while (k < a.elements.len() && !flagged) {
        let etk: typeinfo.Type = check_expr(a.elements[k], s);
        let scalar: typeinfo.Type = scalar_numeric_join(anchor, etk);
        if (!is_unknown(scalar) && anchor_lit == 0 && lit_kind_settled(a.elements[k])) {
          anchor = scalar;
          anchor_lit = 0;
          k = k + 1;
          continue;
        }
        let lit: i32 = numeric_literal_kind(a.elements[k]);
        if (!type_contains_unknown(etk) && !literal_gives_way(lit, anchor)) {
          if (same_element_type(etk, anchor) || literal_gives_way(anchor_lit, etk)) {
            anchor = etk;
            anchor_lit = lit;
          } else {
            out = out.append(dg_at("E034", "array element: expected " + type_label(anchor) + ", got " + type_label(etk), expr_line(a.elements[k]), expr_col(a.elements[k])));
            flagged = true;
          }
        }
        k = k + 1;
      }
    } else if (concrete_instance(anchor)) {
      out = struct_instance_mix(a, anchor, s, out);
    }
  }

  return out;
}

function struct_instance_mix(a: ast.ExprArray, first: typeinfo.Type, s: Scope, out: util.Diag[]): util.Diag[] {
  let anchor: typeinfo.Type = first;
  let anchor_expr: ast.Expr = a.elements[0];
  let k: i32 = 1;
  while (k < a.elements.len()) {
    let etk: typeinfo.Type = check_expr(a.elements[k], s);
    if (concrete_instance(etk) && struct_name_of(etk) == struct_name_of(anchor) && typeinfo.spelling(etk) != typeinfo.spelling(anchor)) {
      if (struct_lit_yields(anchor_expr, anchor, etk, s, true)) {
        anchor = etk;
        anchor_expr = a.elements[k];
      } else if (!struct_lit_yields(a.elements[k], etk, anchor, s, true)) {
        return out.append(dg_at("E034", "array element: expected " + type_label(anchor) + ", got " + type_label(etk), expr_line(a.elements[k]), expr_col(a.elements[k])));
      }
    }
    k = k + 1;
  }
  return out;
}

function concrete_instance(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(st) = t {
    return st.args.len() > 0 && !type_contains_unknown(t);
  }
  return false;
}

function struct_name_of(t: typeinfo.Type): string {
  if let typeinfo.TypeStruct(st) = t {
    return st.name;
  }
  return "";
}

function call_diags_index(ix: ast.ExprIndex, s: Scope, out: util.Diag[]): util.Diag[] {
  out = util.append_diags(call_diags(ix.array, s), call_diags(ix.index, s));
  let ixt: typeinfo.Type = check_expr(ix.index, s);
  if (!is_unknown(ixt) && !is_integer(ixt)) {
    out = out.append(dg_at("E034", "index must be an integer, got " + type_label(ixt), expr_line(ix.index), expr_col(ix.index)));
  }
  let iarrt: typeinfo.Type = check_expr(ix.array, s);
  let idxable: boolean = false;
  match (iarrt) {
    typeinfo.TypeArray(_) => {
      idxable = true;
    },
    typeinfo.TypeString(_) => {
      idxable = true;
    },
    _ => {}
  }
  if (!is_unknown(iarrt) && !idxable && !generic_fn_value_arg(ix.array, s)) {
    out = out.append(dg_at("E034", "indexing non-array value of type " + type_label(iarrt), ix.line, ix.col));
  }

  return out;
}

function call_diags_slice(s2: ast.ExprSlice, s: Scope, out: util.Diag[]): util.Diag[] {
  out = util.append_diags(call_diags(s2.array, s), call_diags(s2.start, s));
  let sbt: typeinfo.Type = check_expr(s2.start, s);
  if (!is_unknown(sbt) && !type_eq(sbt, t_i32())) {
    out = out.append(dg_at("E037", "slice low bound must be i32, got " + type_label(sbt), expr_line(s2.start), expr_col(s2.start)));
  }
  if (!s2.open_end) {
    out = util.append_diags(out, call_diags(s2.end, s));
    let ebt: typeinfo.Type = check_expr(s2.end, s);
    if (!is_unknown(ebt) && !type_eq(ebt, t_i32())) {
      out = out.append(dg_at("E037", "slice high bound must be i32, got " + type_label(ebt), expr_line(s2.end), expr_col(s2.end)));
    }
  }
  let sarrt: typeinfo.Type = check_expr(s2.array, s);
  let sliceable: boolean = false;
  match (sarrt) {
    typeinfo.TypeArray(_) => {
      sliceable = true;
    },
    typeinfo.TypeString(_) => {
      sliceable = true;
    },
    _ => {}
  }
  if (!is_unknown(sarrt) && !sliceable) {
    out = out.append(dg_at("E037", "cannot slice value of type " + type_label(sarrt), expr_line(s2.array), expr_col(s2.array)));
  }

  return out;
}

function call_diags_field_access(fa: ast.ExprFieldAccess, s: Scope, out: util.Diag[]): util.Diag[] {
  let qen: string = qual_enum_name(fa.obj, s);
  if (qen.len() > 0) {
    out = util.append_diags(out, enum_access_diags(s.lookup_union(qen), s, fa.line, fa.col));
    if (!qual_variant_exists(qen, fa.field, s)) {
      out = out.append(no_variant_diag(s, qen, fa.field, fa.line, fa.col));
    } else {
      let payloads: i32 = variant_value_payloads(s, qen, fa.field);
      if (payloads > 0) {
        out = out.append(payload_variant_value_diag(shown_enum(s, qen) + "." + shown_variant(s, qen + "." + fa.field), payloads, fa.line, fa.col));
      }
    }
    return out;
  }
  out = call_diags(fa.obj, s);
  let ot: typeinfo.Type = check_expr(fa.obj, s);
  match (ot) {
    typeinfo.TypeStruct(sn) => {
      let fsig: StructSig = s.lookup_struct(sn.name);
      out = util.append_diags(out, opaque_access_diags(fsig, s, "access a field of", fa.line, fa.col));
      if (fsig.name.len() > 0 && !util.has_str(fsig.field_names, fa.field)) {
        out = out.append(s.member_fix(dg_at("E043", "struct " + util.demangle(sn.name) + " has no field or method \"" + fa.field + "\"", fa.line, fa.col), fa, fsig));
      }
    },
    typeinfo.TypeTuple(tt) => {
      out = util.append_diags(out, tuple_field_diags(fa.field, tt, fa.line, fa.col));
    },
    _ => {
      if (!is_unknown(ot)) {
        out = out.append(s.method_fix(dg_at("E043", s.unknown_method_advice(method_namespace_of(ot), fa.field, ot), fa.line, fa.col), fa, ot));
      }
    }
  }

  return out;
}

function tuple_field_diags(field: string, tt: typeinfo.TypeTuple, line: i32, col: i32): util.Diag[] {
  let idx: i32 = digit_string_to_i32(field);
  if (idx < 0) {
    return [dg_at("E046", "tuple field access requires a numeric index, got \"" + field + "\"", line, col)];
  }
  if (idx >= tt.elements.len()) {
    return [dg_at("E046", "tuple has " + util.i32_to_string(tt.elements.len()) + " elements; index " + util.i32_to_string(idx) + " is out of range", line, col)];
  }
  return [];
}

function call_diags_struct_lit(sl: ast.ExprStructLit, dest_args: typeinfo.Type[], s: Scope, out: util.Diag[]): util.Diag[] {
  let fsig: StructSig = s.lookup_struct(sl.type_name);
  out = util.append_diags(out, opaque_access_diags(fsig, s, "construct", sl.line, sl.col));
  let args: typeinfo.Type[] = dest_args;
  if (sl.written.len() > 0 && fsig.name.len() > 0) {
    let wn: i32 = parser.parse_type_ref(sl.written).args.len();
    if (wn != fsig.type_params.len()) {
      out = out.append(dg_at("E040", util.arity_message(fsig.name, fsig.type_params.len(), wn, "type argument"), sl.line, sl.col));
    } else {
      args = written_struct_args(sl, fsig, s);
    }
  }
  if (sl.has_base && fsig.type_params.len() > 0) {
    if let typeinfo.TypeStruct(bst) = check_expr(sl.base, s) {
      if (bst.args.len() == fsig.type_params.len()) {
        args = bst.args;
      }
    }
  }
  if (args.len() == 0 && fsig.type_params.len() > 0) {
    args = struct_lit_args(sl, fsig, s);
    let utp: string = lit_uninferable_param(sl, fsig, args, s);
    if (utp.len() > 0) {
      out = out.append(dg_at("E040", "could not infer type parameter " + utp + " for struct " + sl.type_name + " — supply it explicitly at the construction site (e.g. " + sl.type_name + "[i32] { ... }) or annotate the binding (e.g. let x: " + sl.type_name + "[i32] = ...)", sl.line, sl.col));
    }
  }
  let vi: i32 = 0;
  while (vi < sl.field_values.len()) {
    let fdest: typeinfo.Type = t_unknown("no declared field");
    if (fsig.name.len() > 0 && vi < sl.field_names.len() && field_index(fsig, sl.field_names[vi]) >= 0) {
      fdest = lit_field_type(fsig, field_index(fsig, sl.field_names[vi]), args, s);
    }
    out = util.append_diags(out, dest_call_diags(sl.field_values[vi], fdest, s));
    vi = vi + 1;
  }
  if (sl.has_base) {
    out = util.append_diags(out, call_diags(sl.base, s));
    let bt: typeinfo.Type = check_expr(sl.base, s);
    if (!is_unknown(bt) && !type_eq(bt, t_struct(sl.type_name))) {
      out = out.append(dg_at("E003", "struct-update base must be " + sl.type_name + ", got " + type_label(bt), expr_line(sl.base), expr_col(sl.base)));
    }
  }
  let seen_fields: string[] = [];
  for fname in sl.field_names {
    if (util.index_of_str(seen_fields, fname) >= 0) {
      out = out.append(dg_at("E007", "duplicate field \"" + fname + "\" in struct literal", sl.line, sl.col));
    } else {
      seen_fields = seen_fields.append(fname);
    }
  }
  let ssig: StructSig = s.lookup_struct(sl.type_name);
  if (ssig.name.len() > 0) {
    let fi: i32 = 0;
    while (fi < sl.field_names.len()) {
      let fidx: i32 = field_index(ssig, sl.field_names[fi]);
      if (fidx >= 0) {
        let ft: typeinfo.Type = lit_field_type(ssig, fidx, args, s);
        let vt: typeinfo.Type = check_expr(sl.field_values[fi], s);
        out = util.append_diags(out, int_dest_range_diags(sl.field_values[fi], ft));
        out = util.append_diags(out, ctor_payload_diags(sl.field_values[fi], ft, s));
        if (!is_unknown(ft) && !is_unknown(vt) && !settles_to(sl.field_values[fi], ft, s) && !coercible(vt, ft, s)) {
          out = out.append(dg_at("E043", "field \"" + sl.field_names[fi] + "\": expected " + type_label(ft) + ", got " + type_label(vt) + str_copy_hint(vt, ft), expr_line(sl.field_values[fi]), expr_col(sl.field_values[fi])));
        }
        out = util.append_diags(out, array_elem_check(array_elem_type_of(ft), sl.field_values[fi], s));
      }
      fi = fi + 1;
    }
  }

  return out;
}

pub function lambda_body_scope(lm: ast.ExprLambda, s: Scope): Scope {
  let lsc: Scope = s;
  for param in lm.params {
    lsc = lsc.bind(param.name, s.resolve_param(param));
  }
  if (parser.is_value_block_origin(lm.origin)) {
    return lsc.with_block_ret(lambda_ret_type(lm, s));
  }
  return lsc.with_ret_type(lambda_ret_type(lm, s));
}

function call_diags_lambda(lm: ast.ExprLambda, s: Scope, out: util.Diag[]): util.Diag[] {
  if (parser.is_written_lambda_origin(lm.origin)) {
    out = util.append_diags(out, capture_view_diags(lm, s));
    out = util.append_diags(out, lambda_lane_diags(lm, s));
  }
  return util.append_diags(out, stmts_call_diags(lm.body, lambda_body_scope(lm, s)));
}

function lambda_lane_diags(lm: ast.ExprLambda, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (lanes_inside(check_lambda_expr(lm, s))) {
    out = out.append(dg_at("E085", "a lambda cannot take or return a lane value; a lane value crosses only a direct call", lm.line, lm.col));
  }
  let seen: string[] = [];
  for name in astwalk.collect_lambda_idents(lm, []) {
    if (!util.has_str(seen, name) && s.is_bound(name) && is_lanes(s.lookup(name))) {
      out = out.append(dg_at("E085", "a lambda cannot capture \"" + name + "\" of type " + type_label(s.lookup(name)) + "; a lane value lives only in a local, a parameter or a result", lm.line, lm.col));
    }
    seen = seen.append(name);
  }
  return out;
}

function capture_view_diags(lm: ast.ExprLambda, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let seen: string[] = [];
  for name in astwalk.collect_lambda_idents(lm, []) {
    if (util.has_str(seen, name)) {
      continue;
    }
    seen = seen.append(name);
    if (!s.is_bound(name)) {
      continue;
    }
    let (holds, _) = type_holds_view(s.lookup(name), s, []);
    if (holds) {
      out = out.append(dg_at("E082", "closure captures \"" + name + "\", which holds a borrowed view: a function value's environment cannot carry a view — copy it into an owned value before the closure (`.to_owned()` on a `str`)", lm.line, lm.col));
    }
  }
  return out;
}

function type_holds_view(t: typeinfo.Type, s: Scope, seen: string[]): (boolean, string[]) {
  if (is_str_view(t) || is_arr_view(t)) {
    return (true, seen);
  }
  if let typeinfo.TypeArray(a) = t {
    return type_holds_view(a.elem, s, seen);
  }
  if let typeinfo.TypeTuple(tup) = t {
    return any_holds_view(tup.elements, s, seen);
  }
  if let typeinfo.TypeMap(m) = t {
    return any_holds_view([m.key, m.value], s, seen);
  }
  if let typeinfo.TypeStruct(st) = t {
    if (util.has_str(seen, st.name)) {
      return (false, seen);
    }
    let (in_args, after) = any_holds_view(st.args, s, seen.append(st.name));
    if (in_args) {
      return (true, after);
    }
    return any_holds_view(s.lookup_struct(st.name).field_types, s, after);
  }
  if let typeinfo.TypeUnion(u) = t {
    if (util.has_str(seen, u.name)) {
      return (false, seen);
    }
    let (in_args, after) = any_holds_view(u.args, s, seen.append(u.name));
    if (in_args) {
      return (true, after);
    }
    for v in s.lookup_union(u.name).variants {
      let (in_payload, next) = any_holds_view(variant_shape_sig(s, v, u.name).field_types, s, after);
      if (in_payload) {
        return (true, next);
      }
      after = next;
    }
    return (false, after);
  }
  return (false, seen);
}

function any_holds_view(ts: typeinfo.Type[], s: Scope, seen: string[]): (boolean, string[]) {
  let at: string[] = seen;
  for t in ts {
    let (found, next) = type_holds_view(t, s, at);
    if (found) {
      return (true, next);
    }
    at = next;
  }
  return (false, at);
}

function call_diags_ident(id: ast.ExprIdent, s: Scope, out: util.Diag[]): util.Diag[] {
  if (!s.known(id.name) && !s.has_sig(id.name)) {
    out = util.append_diags(out, enum_access_diags(scope_variant_sig(id.name, s), s, id.line, id.col));
  }

  let payloads: i32 = 0;
  if (!s.known(id.name) && !s.has_sig(id.name)) {
    payloads = variant_value_payloads(s, "", id.name);
  }
  if (payloads > 0) {
    out = out.append(payload_variant_value_diag(shown_variant(s, id.name), payloads, id.line, id.col));
  } else if (!s.known(id.name) && !s.is_bound(id.name) && generic_fn_value(s.lookup_sig(id.name))) {
    out = out.append(generic_fn_value_diag(id, s.lookup_sig(id.name)));
  } else if (lane_fn_value(id, s)) {
    out = out.append(dg_at("E085", "function " + id.name + " takes or returns a lane value and cannot be used as a value; a lane value crosses only a direct call", id.line, id.col));
  } else if (!is_resolvable_value(id.name, s)) {
    out = out.append(undefined_name(id.name, s, id.line, id.col));
  }

  return out;
}

function fn_value_binds(sig: FuncSig, dest: typeinfo.TypeFunc, s: Scope): (string[], typeinfo.Type[]) {
  let ns: string[] = [];
  let ts: typeinfo.Type[] = [];
  if (!dest.params_known || dest.param_types.len() != sig.param_type_names.len()) {
    return (ns, ts);
  }
  let i: i32 = 0;
  while (i < dest.param_types.len()) {
    let (pn, pt) = gc_bind_param(sig_param_ref(sig, i), dest.param_types[i], sig.all_type_params, s.type_names(), ns, ts);
    ns = pn;
    ts = pt;
    i = i + 1;
  }
  let (rn, rt) = gc_bind_param(sig_ret_ref(sig), dest.ret_type, sig.all_type_params, s.type_names(), ns, ts);
  return (rn, rt);
}

function fn_value_instance(sig: FuncSig, bn: string[], bt: typeinfo.Type[], s: Scope): typeinfo.TypeFunc {
  let params: typeinfo.Type[] = [];
  let i: i32 = 0;
  while (i < sig.param_type_names.len()) {
    params = params.append(type_from_ref_subst(sig_param_ref(sig, i), bn, bt, s.type_names()));
    i = i + 1;
  }
  let result: typeinfo.Type = type_from_ref_subst(sig_ret_ref(sig), bn, bt, s.type_names());
  return typeinfo.TypeFunc { param_types: params, param_own: callable_own_flags(sig.param_own, params.len()), ret_type: result, params_known: true };
}

function fn_value_settles(e: ast.Expr, want: typeinfo.TypeFunc, s: Scope): boolean {
  if let ast.ExprIdent(id) = e {
    let sig: FuncSig = s.lookup_sig(id.name);
    let (bn, bt) = fn_value_binds(sig, want, s);
    for tp in sig.all_type_params {
      let at: i32 = util.index_of_str(bn, tp);
      if (at < 0 || unknown_beyond_tvars(bt[at])) {
        return false;
      }
    }
    let inst: typeinfo.TypeFunc = fn_value_instance(sig, bn, bt, s);
    let result: typeinfo.Type = inst.ret_type;
    if (is_unknown(want.ret_type)) {
      result = want.ret_type;
    }
    let actual: typeinfo.Type = t_func_own(inst.param_types, sig.param_own, result);
    if (is_unknown(want.ret_type) && !util.has_str(s.tparams, callable_typevar_name(want.ret_type))) {
      return type_assignable(actual, typeinfo.TypeFunc { ...want, ret_type: result }, s.unions.unions);
    }
    return type_assignable(actual, want, s.unions.unions);
  }
  return false;
}

function fn_value_at(e: ast.Expr, dest: typeinfo.Type, s: Scope): typeinfo.Type {
  if (generic_fn_value_arg(e, s)) {
    if let ast.ExprIdent(id) = e {
      if let typeinfo.TypeFunc(want) = dest {
        let sig = s.lookup_sig(id.name);
        let (names, types) = fn_value_binds(sig, want, s);
        return fn_value_instance(sig, names, types, s);
      }
    }
  }
  return check_expr(e, s);
}

function generic_fn_value_arg(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprIdent(id) = e {
    return !s.known(id.name) && !s.is_bound(id.name) && generic_fn_value(s.lookup_sig(id.name));
  }
  return false;
}

function bound_param_dest(c: ast.ExprCall, di: i32, dest: typeinfo.Type, s: Scope): typeinfo.Type {
  if let ast.ExprIdent(cid) = c.callee {
    let sig: FuncSig = s.lookup_sig(cid.name);
    if (s.defines(cid.name) || sig.all_type_params.len() == 0 || di >= sig.param_type_names.len()) {
      return dest;
    }
    let (bn, bt) = call_type_bindings(sig, c, s);
    return type_from_ref_subst(sig_param_ref(sig, di), bn, bt, s.type_names());
  }
  return dest;
}

function generic_fn_value(sig: FuncSig): boolean {
  return sig.name.len() > 0 && !sig.is_const && sig.all_type_params.len() > 0;
}

function lane_fn_value(id: ast.ExprIdent, s: Scope): boolean {
  if (s.known(id.name) || s.is_bound(id.name)) {
    return false;
  }
  let sig: FuncSig = s.lookup_sig(id.name);
  return sig.name.len() > 0 && !sig.is_const && (any_holds_lanes(sig.param_types) || holds_lanes(sig.ret_type));
}

function generic_fn_value_diag(id: ast.ExprIdent, sig: FuncSig): util.Diag {
  let tps: string = comma_list(sig.all_type_params);
  let plural: string = "";
  if (sig.all_type_params.len() > 1) {
    plural = "s";
  }
  let params: string[] = [];
  let i: i32 = 0;
  while (i < sig.param_names.len()) {
    let pt: string = "";
    if (i < sig.param_type_names.len()) {
      pt = sig.param_type_names[i];
    }
    params = params.append(sig.param_names[i] + ": " + pt);
    i = i + 1;
  }
  return dg_at("E040", "generic function " + id.name + " cannot be used as a value — nothing here determines its type parameter" + plural + " " + tps + ". Wrap it in a lambda, which does: (" + comma_list(params) + ") => " + id.name + "(" + comma_list(sig.param_names) + ")", id.line, id.col);
}

function comma_list(xs: string[]): string {
  let out: string = "";
  for x in xs {
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + x;
  }
  return out;
}

function param_decl_names(params: ast.ParamDecl[]): string[] {
  let out: string[] = [];
  for pd in params {
    out = out.append(pd.name);
  }
  return out;
}

function is_collection_mutator(field: string): boolean {
  return field == "insert" || field == "remove" || field == "cleared" || field == "with" || field == "append";
}

function e055_diag(e: ast.Expr, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if (!is_collection_mutator(fa.field)) {
            return none;
          }
          let is_coll: boolean = false;
          match (check_expr(fa.obj, s)) {
            typeinfo.TypeMap(_) => {
              is_coll = true;
            },
            typeinfo.TypeArray(array) => {
              is_coll = !array.view;
            },
            _ => {}
          }
          if (!is_coll) {
            return none;
          }
          let d: util.Diag[] = [dg_at("E055", "result of `." + fa.field + "(...)` is unused; assign it back (e.g. `x = x." + fa.field + "(...)`) — collection operations return a new value, they do not mutate in place (use `let _ = …` to discard intentionally)", fa.line, fa.col)];
          return d;
        },
        _ => {
          return none;
        }
      }
    },
    _ => {
      return none;
    }
  }
  return none;
}

function array_elem_type_of(t: typeinfo.Type): typeinfo.Type {
  match (t) {
    typeinfo.TypeArray(ad) => {
      return ad.elem;
    },
    _ => {
      return t_unknown("not an array");
    }
  }
  return t_unknown("not an array");
}

function array_elem_check(elem_ty: typeinfo.Type, init: ast.Expr, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (!is_dyn_slot(elem_ty) && !is_str_view(elem_ty)) {
    if let typeinfo.TypeUnion(_) = elem_ty {} else {
      if let typeinfo.TypeStruct(_) = elem_ty {} else {
        return out;
      }
    }
  }
  match (init) {
    ast.ExprArray(arr) => {
      for element in arr.elements {
        let ekt: typeinfo.Type = check_expr(element, s);
        if (!is_unknown(ekt) && !settles_to(element, elem_ty, s) && !coercible(ekt, elem_ty, s) && dest_bound_diags(element, elem_ty, s).len() == 0) {
          out = out.append(dg_at("E034", "array element: expected " + type_label(elem_ty) + ", got " + type_label(ekt), expr_line(element), expr_col(element)));
        }
      }
    },
    _ => {}
  }
  return out;
}

function lit_field_type(ssig: StructSig, fi: i32, args: typeinfo.Type[], s: Scope): typeinfo.Type {
  if (args.len() == 0 || args.len() != ssig.type_params.len() || fi >= ssig.field_type_names.len()) {
    return ssig.field_types[fi];
  }
  return type_from_ref_subst(parser.parse_type_ref(ssig.field_type_names[fi]), ssig.type_params, args, s.type_names());
}

function dest_call_diags(e: ast.Expr, dest: typeinfo.Type, s: Scope): util.Diag[] {
  if let ast.ExprCall(c) = e {
    return call_diags_call(c, s, [], dest);
  }
  if let ast.ExprIdent(id) = e {
    if let typeinfo.TypeFunc(df) = dest {
      if (!s.known(id.name) && !s.is_bound(id.name) && generic_fn_value(s.lookup_sig(id.name))) {
        let sig: FuncSig = s.lookup_sig(id.name);
        let (bn, bt) = fn_value_binds(sig, df, s);
        if (bn.len() == sig.all_type_params.len()) {
          return call_bound_diags(sig.type_params, sig.type_bounds, sig.module, util.demangle(sig.name), bn, bt, s, id.line, id.col);
        }
      }
    }
  }
  if let ast.ExprStructLit(sl) = e {
    if let typeinfo.TypeStruct(ds) = dest {
      if (ds.name == sl.type_name) {
        return call_diags_struct_lit(sl, ds.args, s, []);
      }
    }
  }
  let elem: typeinfo.Type = array_elem_type_of(dest);
  if (is_str_view(elem)) {
    if let ast.ExprArray(sa) = e {
      let out: util.Diag[] = [];
      for element in sa.elements {
        out = util.append_diags(out, call_diags(element, s));
        let et: typeinfo.Type = check_expr(element, s);
        if (!is_unknown(et) && !coercible(et, elem, s)) {
          out = out.append(dg_at("E034", "array element: expected " + type_label(elem) + ", got " + type_label(et), expr_line(element), expr_col(element)));
        }
      }
      return out;
    }
  }
  if (!is_unknown(elem) && !is_primitive_type(elem)) {
    if let ast.ExprArray(a) = e {
      let out: util.Diag[] = [];
      if (is_func_type(elem) || is_tuple_type(elem)) {
        out = array_mix_diags(a, s, out);
      }
      for element in a.elements {
        out = util.append_diags(out, dest_call_diags(element, elem, s));
      }
      return out;
    }
  }
  return call_diags(e, s);
}

function (s: Scope) method_missing(recv: typeinfo.Type, field: string): boolean {
  let scalar: string = scalar_receiver_name(recv);
  if (scalar.len() > 0) {
    return s.visible_method(field, scalar).name.len() == 0 && is_unknown(builtin_method_sig(scalar, field));
  }
  match (recv) {
    typeinfo.TypeArray(array) => {
      let builtin: boolean = field == "len" || !array.view && (field == "append" || field == "with");
      return !builtin && !s.has_array_recv_method(field, array.view);
    },
    typeinfo.TypeMap(_) => {
      return !util.has_str(preregistered_methods("Map"), field) && s.visible_method(field, "Map").name.len() == 0;
    },
    typeinfo.TypeStruct(sn) => {
      if (is_cell_type(recv) || s.visible_method(field, sn.name).name.len() > 0 || !is_unknown(builtin_method_sig(sn.name, field))) {
        return false;
      }
      let fsig: StructSig = s.lookup_struct(sn.name);
      if (fsig.name.len() == 0) {
        return false;
      }
      let fi: i32 = field_index(fsig, field);
      if (fi < 0) {
        return true;
      }
      if let typeinfo.TypeFunc(_) = fsig.field_types[fi] {
        return false;
      }
      return true;
    },
    typeinfo.TypeUnion(un) => {
      let declared: boolean = un.name == "Option" || un.name == "Result" || un.name == "IoError" || un.name == "Body" || s.lookup_union(un.name).name.len() > 0;
      return declared && s.visible_method(field, un.name).name.len() == 0 && is_unknown(builtin_method_sig(un.name, field));
    },
    _ => {
      return false;
    }
  }
  return false;
}

function (s: Scope) callee_resolves(c: ast.ExprCall): boolean {
  if let ast.ExprIdent(cid) = c.callee {
    return is_resolvable_callee(cid.name, s);
  }
  if let ast.ExprFieldAccess(mfa) = c.callee {
    return !s.method_missing(check_expr(mfa.obj, s), mfa.field);
  }
  return true;
}

function (s: Scope) call_param_types(c: ast.ExprCall): typeinfo.Type[] {
  match (c.callee) {
    ast.ExprIdent(id) => {
      if (!s.defines(id.name)) {
        return s.lookup_sig(id.name).param_types;
      }
      if let typeinfo.TypeFunc(f) = s.lookup(id.name) {
        if (f.params_known) {
          return f.param_types;
        }
      }
    },
    ast.ExprFieldAccess(mfa) => {
      let rt: typeinfo.Type = check_expr(mfa.obj, s);
      if let typeinfo.TypeStruct(sn) = rt {
        let msig: MethodSig = s.lookup_method(mfa.field, sn.name);
        if (msig.name.len() > 0) {
          return s.bound_method_param_types(c, msig, rt);
        }
        if let typeinfo.TypeFunc(ff) = check_expr(c.callee, s) {
          if (ff.params_known) {
            return ff.param_types;
          }
        }
      }
      if let typeinfo.TypeUnion(un) = rt {
        let msig: MethodSig = s.lookup_method(mfa.field, un.name);
        if (msig.name.len() > 0) {
          return s.bound_method_param_types(c, msig, rt);
        }
      }
      if let typeinfo.TypeMap(mt) = rt {
        if (mfa.field == "insert") {
          return [mt.key, mt.value];
        }
      }
      if let typeinfo.TypeArray(at) = rt {
        if (mfa.field == "append") {
          return [at.elem];
        }
        if (mfa.field == "with") {
          return [t_i32(), at.elem];
        }
        return s.array_method_param_types(c, rt, mfa.field, at.view);
      }
    },
    _ => {}
  }
  return [];
}

function (s: Scope) array_method_param_types(c: ast.ExprCall, recv: typeinfo.Type, field: string, view: boolean): typeinfo.Type[] {
  return s.bound_method_param_types(c, s.array_recv_method(field, view), recv);
}

function (s: Scope) bound_method_param_types(c: ast.ExprCall, asig: MethodSig, recv: typeinfo.Type): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  if (asig.name.len() == 0) {
    return out;
  }
  let mb: MethodBinding = method_binding(c, asig, recv, s);
  let i: i32 = 0;
  while (i < asig.param_types.len()) {
    out = out.append(receiver_bound(asig.param_types[i], param_type_name_at(asig, i), mb, s));
    i = i + 1;
  }
  return out;
}

function for_iter_diags(fr: ast.StmtFor, s: Scope): util.Diag[] {
  let none: util.Diag[] = [];
  if (for_iter_is_range(fr.iter)) {
    return none;
  }
  let it: typeinfo.Type = check_expr(fr.iter, s);
  if (builtin_iterable(it) || is_unknown(it) && tvar_name(it).len() == 0 || iter_subject(it, s).ok) {
    return none;
  }
  return [dg_at("E083", "cannot iterate over a value of type " + util.show_type_vars(type_label_or_tvar(it)) + ": `for` walks an array, a string, a Map, a range, an iter.Iterator, or a value whose iter() returns one", expr_line(fr.iter), expr_col(fr.iter))];
}

function tuple_destr_diags(t: typeinfo.Type, n: i32, line: i32, col: i32): util.Diag[] {
  match (t) {
    typeinfo.TypeTuple(tt) => {
      if (tt.elements.len() != n) {
        return [dg_at("E024", "tuple has " + util.i32_to_string(tt.elements.len()) + " elements, but " + util.i32_to_string(n) + " names given", line, col)];
      }
    },
    typeinfo.TypeUnknown(_) => {},
    _ => {
      return [dg_at("E024", "tuple destructure needs a tuple expression, got " + type_label(t), line, col)];
    }
  }
  return [];
}

function for_pattern_diags(fr: ast.StmtFor, s: Scope): util.Diag[] {
  if (!name_has_comma(fr.var_name)) {
    return [];
  }
  let n: i32 = split_pattern_names(fr.var_name).len();
  if (for_iter_is_range(fr.iter)) {
    return tuple_destr_diags(range_var_type(fr.iter, s), n, fr.line, fr.col);
  }
  let it: typeinfo.Type = check_expr(fr.iter, s);
  match (it) {
    typeinfo.TypeString(_) => {
      return tuple_destr_diags(t_u8(), n, fr.line, fr.col);
    },
    typeinfo.TypeArray(ta) => {
      return tuple_destr_diags(ta.elem, n, fr.line, fr.col);
    },
    typeinfo.TypeMap(_) => {
      if (n != 2) {
        return [dg_at("E024", "iterating a Map binds a (key, value) pair, but this pattern binds " + util.i32_to_string(n), fr.line, fr.col)];
      }
      return [];
    },
    _ => {}
  }
  let sub: IterSubject = iter_subject(it, s);
  if (sub.ok) {
    return tuple_destr_diags(sub.elem, n, fr.line, fr.col);
  }
  return [];
}

function builtin_iterable(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeArray(_) => {
      return true;
    },
    typeinfo.TypeString(_) => {
      return true;
    },
    typeinfo.TypeMap(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function type_label_or_tvar(t: typeinfo.Type): string {
  let tv: string = tvar_name(t);
  if (tv.len() > 0) {
    return tv;
  }
  return type_label(t);
}

struct IterSubject { ok: boolean, elem: typeinfo.Type, via_iter: boolean }

function iter_subject(t: typeinfo.Type, s: Scope): IterSubject {
  let direct: typeinfo.Type = iterator_elem(t, s);
  if (!is_unknown(direct) || tvar_name(direct).len() > 0) {
    return IterSubject { ok: true, elem: direct, via_iter: false };
  }
  if (is_unknown(t) || is_type_variable(t)) {
    return IterSubject { ok: false, elem: direct, via_iter: false };
  }
  let via: typeinfo.Type = iterator_elem(probe_method(t, "iter", s), s);
  if (!is_unknown(via) || tvar_name(via).len() > 0) {
    return IterSubject { ok: true, elem: via, via_iter: true };
  }
  return IterSubject { ok: false, elem: via, via_iter: false };
}

function iterator_elem(t: typeinfo.Type, s: Scope): typeinfo.Type {
  if (!implements_iterator(t, s)) {
    return t_unknown("not an Iterator");
  }
  if let typeinfo.TypeUnion(u) = probe_method(t, "next", s) {
    if (u.name == "Option" && u.args.len() == 1) {
      if let typeinfo.TypeTuple(tp) = u.args[0] {
        if (tp.elements.len() == 2) {
          return tp.elements[0];
        }
      }
    }
  }
  return t_unknown("not an Iterator");
}

function implements_iterator(t: typeinfo.Type, s: Scope): boolean {
  let tv: string = tp_receiver(t, s);
  if (tv.len() == 0) {
    tv = tvar_name(t);
  }
  if (tv.len() > 0) {
    for tr in tp_bound_traits(s, tv) {
      if (tr == CORE_ITERATOR) {
        return true;
      }
    }
    return false;
  }
  if (is_unknown(t)) {
    return false;
  }
  let base: string = util.base_type_name(type_label(t));
  for imp in s.impls {
    if (parser.impl_trait_key(imp) == CORE_ITERATOR && util.base_type_name(imp.impl_type) == base) {
      return true;
    }
  }
  return false;
}

const CORE_ITERATOR: string = "iter.Iterator";

function iterator_lowering(fr: ast.StmtFor, s: Scope): Option[ast.Stmt] {
  if (for_iter_is_range(fr.iter)) {
    return None;
  }
  let it: typeinfo.Type = check_expr(fr.iter, s);
  if (builtin_iterable(it)) {
    return None;
  }
  let sub: IterSubject = iter_subject(it, s);
  if (!sub.ok) {
    return None;
  }
  let line: i32 = expr_line(fr.iter);
  let col: i32 = expr_col(fr.iter);
  let subject: ast.Expr = fr.iter;
  if (sub.via_iter) {
    subject = ast.ExprCall { callee: ast.ExprFieldAccess { obj: fr.iter, field: "iter", line: line, col: col, ty: "", const_read: false }, args: [], line: line, col: col, type_args: [], ty: "" };
  }
  return Some(parser.iterator_loop(fr, subject, col));
}

function probe_method(t: typeinfo.Type, name: string, s: Scope): typeinfo.Type {
  let recv: ast.Expr = ast.ExprIdent { name: "__for_iter", line: 0, col: 0, ty: "" };
  let call: ast.Expr = ast.ExprCall { callee: ast.ExprFieldAccess { obj: recv, field: name, line: 0, col: 0, ty: "", const_read: false }, args: [], line: 0, col: 0, type_args: [], ty: "" };
  return check_expr(call, s.bind("__for_iter", t));
}

struct CoverPat { ctor: string, opaque: boolean, args: CoverPat[] }

function cover_any(): CoverPat {
  return CoverPat { ctor: "", opaque: false, args: [] };
}

function cover_opaque(): CoverPat {
  return CoverPat { ctor: "", opaque: true, args: [] };
}

function cover_shape_diags(p: CoverPat, t: typeinfo.Type, s: Scope, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  if (p.ctor == "()") {
    match (t) {
      typeinfo.TypeTuple(tuple) => {
        if (p.args.len() != tuple.elements.len()) {
          return [dg_at("E035", "tuple pattern has " + util.i32_to_string(p.args.len()) + " elements, but scrutinee tuple has " + util.i32_to_string(tuple.elements.len()), line, col)];
        }
      },
      typeinfo.TypeUnknown(_) => {},
      _ => {
        return [dg_at("E035", "tuple pattern needs a tuple value, got " + type_label(t), line, col)];
      }
    }
  }
  if (p.args.len() == 0) {
    return out;
  }
  let types: typeinfo.Type[] = cover_arg_types(t, p.ctor, p.args.len(), s);
  for i in 0..p.args.len() {
    if (i >= types.len()) {
      break;
    }
    out = util.append_diags(out, cover_shape_diags(p.args[i], types[i], s, line, col));
  }
  return out;
}

function sugar_shape_diags(sg: ast.MatchSugar, t: typeinfo.Type, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  for arm in sg.arms {
    out = util.append_diags(out, cover_shape_diags(typed_pattern_cover(arm.pattern, t, s), t, s, arm.line, arm.col));
  }
  for arm in sg.tup {
    if (!arm.is_wild) {
      out = util.append_diags(out, cover_shape_diags(tuple_cover(arm.elem_kinds, arm.lits, arm.elem_pats), t, s, arm.line, arm.col));
    }
  }
  for arm in sg.strct {
    if (!arm.is_wild) {
      out = util.append_diags(out, cover_shape_diags(struct_cover(arm, t, s), t, s, arm.line, arm.col));
    }
  }
  return out;
}

function sugar_exhaustive_diags(sg: ast.MatchSugar, s: Scope): util.Diag[] {
  if (sg.origin != "" || sg.tup.len() + sg.strct.len() + sg.arms.len() == 0) {
    return [];
  }
  let out: util.Diag[] = [];
  let t: typeinfo.Type = check_expr(sg.scrut, s);
  let valid: ast.MatchSugar = sg;
  if let typeinfo.TypeTuple(tuple) = t {
    let arms: ast.TupArm[] = [];
    for arm in sg.tup {
      if (!arm.is_wild && arm.elem_kinds.len() != tuple.elements.len()) {
        out = out.append(dg_at("E035", "tuple pattern has " + util.i32_to_string(arm.elem_kinds.len()) + " elements, but scrutinee tuple has " + util.i32_to_string(tuple.elements.len()), arm.line, arm.col));
      } else {
        arms = arms.append(arm);
      }
    }
    valid = ast.MatchSugar { ...sg, tup: arms };
  }
  out = util.append_diags(out, sugar_shape_diags(valid, t, s));
  if (out.len() > 0) {
    return out;
  }
  out = util.append_diags(out, sugar_unreachable_diags(valid, t, s));
  if (is_unknown(t)) {
    return out;
  }
  if (has_catch_all(valid)) {
    return out;
  }
  let rows: CoverPat[][] = sugar_rows(valid, t, s);
  if (sg.arms.len() > 0) {
    return util.append_diags(out, variant_cover_diags(rows, t, valid, s));
  }
  if (!cover_useful(rows, [t], s)) {
    return out;
  }
  if (sg.tup.len() > 0) {
    return out.append(dg_at("E030", "match on tuple is not exhaustive — add an unguarded `_` or all-binder arm", sg.line, sg.col));
  }
  return out.append(dg_at("E030", "match on struct is not exhaustive — add an unguarded struct-pattern or `_` arm", sg.line, sg.col));
}

function variant_cover_diags(rows: CoverPat[][], t: typeinfo.Type, sg: ast.MatchSugar, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if let typeinfo.TypeUnion(u) = t {
    for v in cover_ctor_names(t, s) {
      let arity: i32 = cover_arity(rows, v);
      if (cover_useful(cover_split(rows, v, arity), cover_arg_types(t, v, arity, s), s)) {
        out = out.append(dg_at("E030", "match does not cover variant " + unprefixed_variant(v, s.lookup_union(u.name).module) + " of enum " + shown_enum(s, u.name) + " — add an arm for it, or a `_` arm", sg.line, sg.col));
      }
    }
  }
  return out;
}

function has_catch_all(sg: ast.MatchSugar): boolean {
  for a in sg.tup {
    if (!a.has_guard && (a.is_wild || binds_only(a.elem_kinds))) {
      return true;
    }
  }
  for a in sg.strct {
    if (!a.has_guard && a.is_wild) {
      return true;
    }
  }
  for a in sg.arms {
    if let ast.PatWildcard(_) = a.pattern {
      if (!a.has_guard) {
        return true;
      }
    }
  }
  return false;
}

function binds_only(kinds: i32[]): boolean {
  for k in kinds {
    if (k != 0 && k != 1) {
      return false;
    }
  }
  return true;
}

function sugar_rows(sg: ast.MatchSugar, t: typeinfo.Type, s: Scope): CoverPat[][] {
  let rows: CoverPat[][] = [];
  for a in sg.tup {
    if (!a.has_guard) {
      let p: CoverPat = cover_any();
      if (!a.is_wild) {
        p = tuple_cover(a.elem_kinds, a.lits, a.elem_pats);
      }
      rows = rows.append([p]);
    }
  }
  for a in sg.strct {
    if (!a.has_guard) {
      let p: CoverPat = cover_any();
      if (!a.is_wild) {
        p = struct_cover(a, t, s);
      }
      rows = rows.append([p]);
    }
  }
  for a in sg.arms {
    if (!a.has_guard) {
      rows = rows.append([typed_pattern_cover(a.pattern, t, s)]);
    }
  }
  return rows;
}

function literal_cover(e: ast.Expr): CoverPat {
  if let ast.ExprBool(b) = e {
    if (b.value) {
      return CoverPat { ctor: "true", opaque: false, args: [] };
    }
    return CoverPat { ctor: "false", opaque: false, args: [] };
  }
  return cover_opaque();
}

function tuple_cover(kinds: i32[], lits: ast.Expr[], pats: ast.Pattern[]): CoverPat {
  let args: CoverPat[] = [];
  let k: i32 = 0;
  while (k < kinds.len()) {
    let a: CoverPat = cover_any();
    if (kinds[k] == 2 && k < lits.len()) {
      a = literal_cover(lits[k]);
    } else if (kinds[k] == 3 && k < pats.len()) {
      a = pattern_cover(pats[k]);
    } else if (kinds[k] == 4 && k < pats.len()) {
      if let ast.PatVariant(np) = pats[k] {
        a = tuple_cover(np.tup_kinds, np.tup_lits, np.tup_pats);
      }
    }
    args = args.append(a);
    k = k + 1;
  }
  return CoverPat { ctor: "()", opaque: false, args: args };
}

function struct_cover(a: ast.StructArm, t: typeinfo.Type, s: Scope): CoverPat {
  let args: CoverPat[] = [];
  if let typeinfo.TypeStruct(st) = t {
    for name in s.lookup_struct(st.name).field_names {
      let p: CoverPat = cover_any();
      let j: i32 = util.index_of_str(a.fields, name);
      if (j >= 0 && j < a.field_kinds.len() && a.field_kinds[j] == 2) {
        p = literal_cover(a.field_lits[j]);
      } else if (j >= 0 && j < a.field_kinds.len() && a.field_kinds[j] == 3) {
        p = typed_pattern_cover(a.field_pats[j], struct_field_type(st, name, s), s);
      }
      args = args.append(p);
    }
  }
  return CoverPat { ctor: "{}", opaque: false, args: args };
}

function pattern_cover(p: ast.Pattern): CoverPat {
  match (p) {
    ast.PatWildcard(_) => {
      return cover_any();
    },
    ast.PatVariant(pv) => {
      if (pv.type_name.len() == 0) {
        if (pv.tup_kinds.len() > 0) {
          return tuple_cover(pv.tup_kinds, pv.tup_lits, pv.tup_pats);
        }
        return cover_any();
      }
      let slots: string[] = [];
      if (pv.binding.len() > 0 || pv.extra_bindings.len() > 0) {
        slots = [pv.binding];
        for b in pv.extra_bindings {
          slots = slots.append(b);
        }
      }
      let args: CoverPat[] = [];
      let i: i32 = 0;
      while (i < slots.len() || i < pv.nested.len()) {
        let a: CoverPat = cover_any();
        let named: string = "";
        if (i < slots.len()) {
          named = slots[i];
        }
        if (i < pv.nested.len() && nested_tests(pv.nested[i])) {
          a = pattern_cover(pv.nested[i]);
        } else if (named == "__tupslot") {
          a = tuple_cover(pv.tup_kinds, pv.tup_lits, pv.tup_pats);
        } else if (util.str_has_prefix(named, "__pl")) {
          a = slot_literal_cover(pv.lit_cond, named);
        }
        args = args.append(a);
        i = i + 1;
      }
      return CoverPat { ctor: variant_pattern_name(pv.type_name), opaque: false, args: args };
    }
  }
}

// Coverage follows each payload type, with support for structs inside enum slots.
function typed_pattern_cover(p: ast.Pattern, t: typeinfo.Type, s: Scope): CoverPat {
  if let ast.PatVariant(pv) = p {
    if let typeinfo.TypeStruct(st) = t {
      if (parser.is_record_pattern(pv) && pv.type_name == st.name) {
        return record_pattern_cover(pv, st, s);
      }
    }
    let base: CoverPat = pattern_cover(p);
    if (pv.nested.len() == 0) {
      return base;
    }
    let args: CoverPat[] = base.args;
    let types: typeinfo.Type[] = cover_arg_types(t, base.ctor, args.len(), s);
    let i: i32 = 0;
    while (i < args.len() && i < pv.nested.len() && i < types.len()) {
      if (nested_tests(pv.nested[i])) {
        args = args.with(i, typed_pattern_cover(pv.nested[i], types[i], s));
      }
      i = i + 1;
    }
    return CoverPat { ...base, args: args };
  }
  return cover_any();
}

function record_pattern_cover(pv: ast.PatVariant, st: typeinfo.TypeStruct, s: Scope): CoverPat {
  let args: CoverPat[] = [];
  for field in s.lookup_struct(st.name).field_names {
    let p: CoverPat = cover_any();
    let i: i32 = util.index_of_str(pv.field_names, field);
    if (i >= 0) {
      p = slot_literal_cover(pv.lit_cond, parser.payload_binder(pv, i));
      if (i < pv.nested.len() && nested_tests(pv.nested[i])) {
        p = typed_pattern_cover(pv.nested[i], struct_field_type(st, field, s), s);
      }
    }
    args = args.append(p);
  }
  return CoverPat { ctor: "{}", opaque: false, args: args };
}

function nested_tests(p: ast.Pattern): boolean {
  if let ast.PatVariant(np) = p {
    return np.type_name.len() > 0 || np.tup_kinds.len() > 0;
  }
  return false;
}

function slot_literal_cover(cond: ast.Expr, slot: string): CoverPat {
  if let ast.ExprBinary(b) = cond {
    if (b.op == "&&") {
      let l: CoverPat = slot_literal_cover(b.left, slot);
      if (l.ctor.len() > 0 || l.opaque) {
        return l;
      }
      return slot_literal_cover(b.right, slot);
    }
    if let ast.ExprIdent(id) = b.left {
      if (id.name == slot) {
        if (b.op == "==") {
          return literal_cover(b.right);
        }
        return cover_opaque();
      }
    }
    if (expr_mentions(b.left, slot) || expr_mentions(b.right, slot)) {
      return cover_opaque();
    }
  }
  return cover_any();
}

function expr_mentions(e: ast.Expr, name: string): boolean {
  if let ast.ExprIdent(id) = e {
    return id.name == name;
  }
  if let ast.ExprBinary(b) = e {
    return expr_mentions(b.left, name) || expr_mentions(b.right, name);
  }
  return false;
}

function cover_ctor_names(t: typeinfo.Type, s: Scope): string[] {
  match (t) {
    typeinfo.TypeUnion(u) => {
      let us: UnionSig = s.lookup_union(u.name);
      if (us.name.len() == 0) {
        us = builtin_union_sig(u.name);
      }
      return us.variants;
    },
    typeinfo.TypeTuple(_) => {
      return ["()"];
    },
    typeinfo.TypeStruct(_) => {
      return ["{}"];
    },
    typeinfo.TypeBool(_) => {
      return ["false", "true"];
    },
    _ => {
      let none: string[] = [];
      return none;
    }
  }
}

function cover_arg_types(t: typeinfo.Type, ctor: string, arity: i32, s: Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  match (t) {
    typeinfo.TypeTuple(tt) => {
      return tt.elements;
    },
    typeinfo.TypeStruct(st) => {
      for field in s.lookup_struct(st.name).field_names {
        out = out.append(struct_field_type(st, field, s));
      }
    },
    typeinfo.TypeUnion(u) => {
      let i: i32 = 0;
      while (i < arity) {
        out = out.append(variant_pattern_payload_type(s, u.name + "." + ctor, t, i));
        i = i + 1;
      }
    },
    _ => {}
  }
  return out;
}

function literal_payload_rows(arms: ast.MatchArm[]): CoverPat[][] {
  let rows: CoverPat[][] = [];
  for a in arms {
    if (!a.has_guard || !slot_tests_only(a.guard)) {
      continue;
    }
    if let ast.PatVariant(pv) = a.pattern {
      rows = rows.append([pattern_cover(ast.PatVariant { ...pv, lit_cond: a.guard, has_lit_cond: true })]);
    }
  }
  return rows;
}

function slot_tests_only(e: ast.Expr): boolean {
  if let ast.ExprBinary(b) = e {
    if (b.op == "&&") {
      return slot_tests_only(b.left) && slot_tests_only(b.right);
    }
    if let ast.ExprIdent(id) = b.left {
      return util.str_has_prefix(id.name, "__pl");
    }
  }
  return false;
}

function rows_cover(rows: CoverPat[][], t: typeinfo.Type, ctor: string, s: Scope): boolean {
  if (rows.len() == 0) {
    return false;
  }
  let arity: i32 = cover_arity(rows, ctor);
  return !cover_useful(cover_split(rows, ctor, arity), cover_arg_types(t, ctor, arity, s), s);
}

function names_ctor(written: string, ctor: string): boolean {
  return written == ctor || written.len() > 0 && util.str_has_suffix(ctor, "__" + written);
}

function cover_arity(rows: CoverPat[][], ctor: string): i32 {
  let n: i32 = 0;
  for r in rows {
    if (!r[0].opaque && names_ctor(r[0].ctor, ctor) && r[0].args.len() > n) {
      n = r[0].args.len();
    }
  }
  return n;
}

function cover_split(rows: CoverPat[][], ctor: string, arity: i32): CoverPat[][] {
  let out: CoverPat[][] = [];
  for r in rows {
    let head: CoverPat = r[0];
    if (head.opaque || head.ctor.len() > 0 && !names_ctor(head.ctor, ctor)) {
      continue;
    }
    let row: CoverPat[] = [];
    let i: i32 = 0;
    while (i < arity) {
      if (i < head.args.len()) {
        row = row.append(head.args[i]);
      } else {
        row = row.append(cover_any());
      }
      i = i + 1;
    }
    let j: i32 = 1;
    while (j < r.len()) {
      row = row.append(r[j]);
      j = j + 1;
    }
    out = out.append(row);
  }
  return out;
}

function cover_useful(rows: CoverPat[][], types: typeinfo.Type[], s: Scope): boolean {
  if (types.len() == 0) {
    return rows.len() == 0;
  }
  let rest_types: typeinfo.Type[] = [];
  let k: i32 = 1;
  while (k < types.len()) {
    rest_types = rest_types.append(types[k]);
    k = k + 1;
  }
  let names: string[] = cover_ctor_names(types[0], s);
  let complete: boolean = names.len() > 0;
  for n in names {
    if (!cover_names(rows, n)) {
      complete = false;
    }
  }
  if (!complete) {
    let rest: CoverPat[][] = [];
    for r in rows {
      let matches_all: boolean = r[0].ctor.len() == 0 && !r[0].opaque;
      if (matches_all || is_unknown(types[0]) && !r[0].opaque) {
        rest = rest.append(cover_tail(r));
      }
    }
    return cover_useful(rest, rest_types, s);
  }
  for n in names {
    let arity: i32 = cover_arity(rows, n);
    let arg_types: typeinfo.Type[] = cover_arg_types(types[0], n, arity, s);
    for rt in rest_types {
      arg_types = arg_types.append(rt);
    }
    if (cover_useful(cover_split(rows, n, arity), arg_types, s)) {
      return true;
    }
  }
  return false;
}

function cover_names(rows: CoverPat[][], ctor: string): boolean {
  for r in rows {
    if (!r[0].opaque && names_ctor(r[0].ctor, ctor)) {
      return true;
    }
  }
  return false;
}

function cover_tail(r: CoverPat[]): CoverPat[] {
  let out: CoverPat[] = [];
  let j: i32 = 1;
  while (j < r.len()) {
    out = out.append(r[j]);
    j = j + 1;
  }
  return out;
}

function ordinary_match_origin(origin: string): boolean {
  return origin == "" || origin == parser.ORIGIN_PATTERN_PROBE;
}

function literal_bound_diags(value: ast.Expr, scrut: typeinfo.Type, scope: Scope, subject: string, line: i32, col: i32): util.Diag[] {
  let ty: typeinfo.Type = check_expr(value, scope);
  if (!is_unknown(ty) && !is_unknown(scrut) && !settles_to(value, scrut, scope) && !coercible(ty, scrut, scope)) {
    return [dg_at("E035", subject + " of type " + type_label(ty) + " does not match scrutinee type " + type_label(scrut), line, col)];
  }
  return [];
}

function literal_comparison_diags(cond: ast.Expr, arm: ast.LitArm, scope: Scope): util.Diag[] {
  if let ast.ExprBinary(compare) = cond {
    let scrut: typeinfo.Type = check_expr(compare.left, scope);
    let subject: string = "literal pattern";
    if (arm.has_range && compare.op != ">=") {
      subject = "range pattern bound";
    }
    return literal_bound_diags(compare.right, scrut, scope, subject, expr_line(arm.lit), expr_col(arm.lit));
  }
  return [];
}

function literal_arm_diags(cond: ast.Expr, arm: ast.LitArm, scope: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let pattern: ast.Expr = cond;
  if (arm.has_guard) {
    if (arm.is_wild) {
      return call_diags(cond, scope);
    }
    if let ast.ExprBinary(both) = cond {
      pattern = both.left;
      out = call_diags(both.right, scope);
    }
  }
  if (arm.has_range) {
    if let ast.ExprBinary(bounds) = pattern {
      out = util.append_diags(out, literal_comparison_diags(bounds.left, arm, scope));
      return util.append_diags(out, literal_comparison_diags(bounds.right, arm, scope));
    }
  }
  return util.append_diags(out, literal_comparison_diags(pattern, arm, scope));
}

function literal_match_diags(chain: ast.StmtIf, scope: Scope): util.Diag[] {
  if let ast.ExprBool(wrapper) = chain.cond {
    if (wrapper.value) {
      let out: util.Diag[] = [];
      let local: Scope = scope;
      let i: i32 = 0;
      for stmt in chain.then_body {
        if (i + 1 == chain.then_body.len()) {
          if let ast.StmtIf(tail) = stmt {
            return util.append_diags(out, literal_chain_diags(tail, chain.sugar.lits, 0, local));
          }
        }
        out = util.append_diags(out, stmts_call_diags([stmt], local));
        local = bind_stmt(stmt, local);
        i = i + 1;
      }
      return out;
    }
  }
  return literal_chain_diags(chain, chain.sugar.lits, 0, scope);
}

function literal_chain_diags(chain: ast.StmtIf, arms: ast.LitArm[], at: i32, scope: Scope): util.Diag[] {
  let out: util.Diag[] = literal_arm_diags(chain.cond, arms[at], scope);
  out = util.append_diags(out, stmts_call_diags(chain.then_body, scope));
  let next: i32 = at + 1;
  if (next < arms.len() && !(arms[next].is_wild && !arms[next].has_guard) && chain.else_body.len() == 1) {
    if let ast.StmtIf(tail) = chain.else_body[0] {
      return util.append_diags(out, literal_chain_diags(tail, arms, next, scope));
    }
  }
  return util.append_diags(out, stmts_call_diags(chain.else_body, scope));
}

function stmts_call_diags(stmts: ast.Stmt[], s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = bind_mutual_siblings(stmts, s);
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        let vsc: Scope = cur;
        match (v.init) {
          ast.ExprLambda(lm) => {
            vsc = rec_local_scope(v, cur);
            cur = cur.bind(v.name, lambda_fn_type(lm, cur));
          },
          _ => {
            let ivt: typeinfo.Type = check_expr(v.init, cur);
            if (is_func_type(ivt)) {
              vsc = cur.bind(v.name, ivt);
              cur = vsc;
            }
          }
        }
        let vdest: typeinfo.Type = t_unknown("no declared type");
        if (v.type_name.len() > 0) {
          vdest = var_declared_type(v, vsc);
        }
        out = util.append_diags(out, dest_call_diags(v.init, vdest, vsc));
        out = util.append_diags(out, array_elem_check(array_elem_type_of(vdest), v.init, vsc));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, dest_call_diags(r.value, cur.ret_type, cur));
        out = util.append_diags(out, array_elem_check(array_elem_type_of(cur.ret_type), r.value, cur));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, call_diags(x.value, cur));
        out = util.append_diags(out, e055_diag(x.value, cur));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, dest_call_diags(a.value, cur.lookup(a.target), cur));
        out = util.append_diags(out, array_elem_check(array_elem_type_of(cur.lookup(a.target)), a.value, cur));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, sugar_exhaustive_diags(f.sugar, cur));
        if (f.sugar.lits.len() > 0) {
          out = util.append_diags(out, literal_match_diags(f, cur));
        } else {
          out = util.append_diags(out, call_diags(f.cond, cur));
          out = util.append_diags(out, stmts_call_diags(f.then_body, cur));
          out = util.append_diags(out, stmts_call_diags(f.else_body, cur));
        }
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, call_diags(w.cond, cur));
        out = util.append_diags(out, stmts_call_diags(w.body, cur));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, call_diags(fr.iter, cur));
        out = util.append_diags(out, for_iter_diags(fr, cur));
        out = util.append_diags(out, for_pattern_diags(fr, cur));
        out = util.append_diags(out, stmts_call_diags(fr.body, for_body_scope(fr, cur)));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, call_diags(m.scrutinee, cur));
        let mst: typeinfo.Type = check_expr(m.scrutinee, cur);
        if (m.sugar.len() > 0) {
          let written: ast.MatchSugar = ast.MatchSugar { ...parser.no_match_sugar(), scrut: m.scrutinee, arms: m.sugar, line: m.line, col: m.col, origin: m.origin };
          out = util.append_diags(out, sugar_exhaustive_diags(written, cur));
        }
        if (m.origin == "if_let" || m.origin == "let_else") {
          let src_is_enum: boolean = false;
          let src_unknown_enum: boolean = false;
          match (mst) {
            typeinfo.TypeUnion(su) => {
              src_is_enum = true;
              if (cur.lookup_union(su.name).name.len() == 0 && !parser.is_reserved_enum_name(su.name)) {
                src_unknown_enum = true;
                out = out.append(dg_at("E023", "unknown enum \"" + su.name + "\"", expr_line(m.scrutinee), expr_col(m.scrutinee)));
              }
            },
            _ => {}
          }
          let kind_label: string = "if-let";
          if (m.origin == "let_else") {
            kind_label = "let-else";
          }
          if (!src_is_enum && !is_unknown(mst)) {
            out = out.append(dg_at("E022", kind_label + " source must be an enum value, got " + type_label(mst), expr_line(m.scrutinee), expr_col(m.scrutinee)));
          } else if (m.origin == "let_else" && src_is_enum && !src_unknown_enum) {
            let le_last: i32 = m.arms.len() - 1;
            if (le_last >= 0 && !block_diverges(m.arms[le_last].body, cur.defines("exit"))) {
              out = out.append(dg_at("E022", "let-else: else branch must diverge (return / break / continue / exit)", m.line, m.col));
            }
          }
        }
        if let typeinfo.TypeStruct(msts) = mst {
          let msig: StructSig = cur.lookup_struct(msts.name);
          if (ordinary_match_origin(m.origin) && msig.name == msts.name && msig.enum_owner.len() == 0) {
            for sarm in m.arms {
              if let ast.PatVariant(spv) = sarm.pattern {
                if (spv.type_name.len() > 0) {
                  out = out.append(dg_at("E035", "match on struct `" + msts.name + "` only accepts struct patterns `" + msts.name + " { … }` or `_`", sarm.line, sarm.col));
                }
              }
            }
          }
        }
        if (is_primitive_type(mst) && ordinary_match_origin(m.origin)) {
          for arm in m.arms {
            match (arm.pattern) {
              ast.PatVariant(epv) => {
                if (epv.type_name.len() > 0 && epv.type_name != "true" && epv.type_name != "false") {
                  out = out.append(dg_at("E035", "match on non-enum value `" + type_label(mst) + "` only accepts literal patterns or `_`", arm.line, arm.col));
                }
              },
              _ => {}
            }
          }
        }
        match (mst) {
          typeinfo.TypeUnion(mun) => {
            let usig: UnionSig = cur.lookup_union(mun.name);
            if (usig.name.len() == 0) {
              usig = builtin_union_sig(mun.name);
            }
            if (usig.name.len() == 0 && !parser.is_reserved_enum_name(mun.name) && ordinary_match_origin(m.origin)) {
              out = out.append(dg_at("E023", "unknown enum \"" + mun.name + "\"", expr_line(m.scrutinee), expr_col(m.scrutinee)));
            }
            if (usig.name.len() > 0) {
              let saw_wild: boolean = false;
              let covered: string[] = [];
              for elem in m.arms {
                match (elem.pattern) {
                  ast.PatWildcard(_) => {
                    saw_wild = true;
                  },
                  ast.PatVariant(cpv) => {
                    if (cpv.type_name.len() > 0) {
                      out = util.append_diags(out, enum_access_diags(usig, cur, elem.line, elem.col));
                      let cdp: i32 = dot_index(cpv.type_name);
                      if (cdp >= 0) {
                        let cqual: str = slice_unchecked(cpv.type_name, 0, cdp);
                        let cbare: str = slice_unchecked(cpv.type_name, cdp + 1, cpv.type_name.len());
                        if (cqual == mun.name) {
                          if (!elem.has_guard) {
                            covered = covered.append(cbare + "");
                          }
                          if (!util.has_str(usig.variants, cbare)) {
                            out = out.append(unknown_variant_diag(cur, cbare, usig, elem.line, elem.col));
                          }
                        } else if (cur.lookup_union(cqual).name.len() > 0) {
                          out = out.append(dg_at("E029", "variant pattern qualifier \"" + shown_enum(cur, cqual) + "\" does not match scrutinee enum " + shown_enum(cur, mun.name), elem.line, elem.col));
                        }
                      } else {
                        if (!elem.has_guard) {
                          covered = covered.append(cpv.type_name);
                        }
                        if (!util.has_str(usig.variants, cpv.type_name)) {
                          out = out.append(unknown_variant_diag(cur, cpv.type_name, usig, elem.line, elem.col));
                        } else if (!parser.is_record_pattern(cpv) && variant_owner_count(cpv.type_name, cur.structs) >= 2) {
                          out = util.append_diags(out, payload_arity_diags(cpv, mun.name + "." + cpv.type_name, cur.structs, cur.unions, elem.line, elem.col));
                        }
                      }
                    }
                  }
                }
              }
              if (!saw_wild && m.sugar.len() == 0) {
                let lit_rows: CoverPat[][] = literal_payload_rows(m.arms);
                for variant in usig.variants {
                  if (!util.has_str(covered, variant) && !rows_cover(lit_rows, mst, variant, cur)) {
                    out = out.append(dg_at("E030", "match does not cover variant " + unprefixed_variant(variant, usig.module) + " of enum " + shown_enum(cur, mun.name) + " — add an arm for it, or a `_` arm", m.line, m.col));
                  }
                }
              }
            }
          },
          typeinfo.TypeBool(_) => {
            out = scalar_match_exhaustive_diags(m, out, true);
          },
          typeinfo.TypeI32(_) => {
            out = scalar_match_exhaustive_diags(m, out, false);
          },
          typeinfo.TypeString(_) => {
            out = scalar_match_exhaustive_diags(m, out, false);
          },
          typeinfo.TypeFloat(_) => {
            out = scalar_match_exhaustive_diags(m, out, false);
          },
          _ => {}
        }
        for elem in m.arms {
          let armScope: Scope = cur;
          match (elem.pattern) {
            ast.PatVariant(apv) => {
              let foreign: boolean = false;
              match (mst) {
                typeinfo.TypeUnion(amu) => {
                  let ausig: UnionSig = cur.lookup_union(amu.name);
                  if (ausig.name.len() > 0 && !util.has_str(ausig.variants, variant_pattern_name(apv.type_name))) {
                    foreign = true;
                  }
                },
                _ => {}
              }
              if (!foreign) {
                armScope = bind_variant_payloads(armScope, cur, apv, check_expr(m.scrutinee, cur));
                out = util.append_diags(out, generic_binder_diags(apv, cur, mst, elem.line, elem.col));
              }
            },
            _ => {}
          }
          if (elem.has_guard) {
            let gt: typeinfo.Type = check_expr(elem.guard, armScope);
            if (!is_unknown(gt) && !type_eq(gt, t_bool())) {
              out = out.append(dg_at("E027", "match guard must be boolean, got " + type_label(gt), expr_line(elem.guard), expr_col(elem.guard)));
            }
            out = util.append_diags(out, call_diags(elem.guard, armScope));
          }
          out = util.append_diags(out, stmts_call_diags(elem.body, armScope));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, stmts_call_diags(one, cur));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function ambiguous_variants(ut: UnionTable): string[] {
  let out: string[] = [];
  let e: i32 = 0;
  while (e < ut.bnames.len()) {
    let name: string = ut.bnames[e];
    if (ut.unions[ut.vowner[e]].is_enum && !util.has_str(out, name) && (parser.builtin_enum_of(name).len() > 0 || second_enum_declares(ut, e))) {
      out = out.append(name);
    }
    e = e + 1;
  }
  return out;
}

function second_enum_declares(ut: UnionTable, e: i32): boolean {
  let k: i32 = ut.bhead[sig_name_bucket(ut.bnames[e])];
  while (k >= 0) {
    if (ut.bnames[k] == ut.bnames[e] && ut.vowner[k] != ut.vowner[e] && ut.unions[ut.vowner[k]].is_enum) {
      return true;
    }
    k = ut.bnext[k];
  }
  return false;
}

function vref_expr(e: ast.Expr, s: Scope, ambig: string[]): util.Diag[] {
  function at(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprIdent(id) => {
        let bare: string = unprefixed_variant(id.name, s.fn_module);
        if (util.has_str(ambig, bare) && !s.known(id.name) && !s.has_sig(id.name) && s.variant_ambiguous(id.name)) {
          return acc.append(dg_at("E036", "variant \"" + bare + "\" is declared in multiple enums — qualify the reference", id.line, id.col));
        }
        return acc;
      },
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, vref_stmts(lm.body, s, ambig));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_expr_pruned(e, no_diags(), at, not_into_lambda);
}

function vref_stmts(stmts: ast.Stmt[], s: Scope, ambig: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, vref_expr(v.init, cur, ambig));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, vref_expr(r.value, cur, ambig));
      },
      ast.StmtExpr(x) => {
        out = util.append_diags(out, vref_expr(x.value, cur, ambig));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, vref_expr(a.value, cur, ambig));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, vref_expr(f.cond, cur, ambig));
        out = util.append_diags(out, vref_stmts(f.then_body, cur, ambig));
        out = util.append_diags(out, vref_stmts(f.else_body, cur, ambig));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, vref_expr(w.cond, cur, ambig));
        out = util.append_diags(out, vref_stmts(w.body, cur, ambig));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, vref_expr(fr.iter, cur, ambig));
        out = util.append_diags(out, vref_stmts(fr.body, for_body_scope(fr, cur), ambig));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, vref_expr(m.scrutinee, cur, ambig));
        for arm in m.arms {
          out = util.append_diags(out, vref_stmts(arm.body, cur, ambig));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, vref_stmts(one, cur, ambig));
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function assign_diags(a: ast.StmtAssign, cur: Scope, unions: UnionSig[]): util.Diag[] {
  let out: util.Diag[] = [];
  if (!cur.defines(a.target) && cur.lookup_sig(a.target).is_const) {
    out = out.append(dg_at("E091", "cannot assign to const " + a.target, a.target_line, a.target_col));
  } else if (!cur.defines(a.target)) {
    out = out.append(undefined_name(a.target, cur, a.target_line, a.target_col));
  } else if (cur.is_const_param(a.target)) {
    out = out.append(dg_at("E091", "cannot assign to const parameter " + a.target + ": it is the constant its instance is made for", a.target_line, a.target_col));
  } else {
    let tt: typeinfo.Type = cur.lookup(a.target);
    let vt: typeinfo.Type = check_expr(a.value, cur);
    out = util.append_diags(out, int_dest_range_diags(a.value, tt));
    out = util.append_diags(out, ctor_payload_diags(a.value, tt, cur));
    let abound: util.Diag[] = dest_bound_diags(a.value, tt, cur);
    out = util.append_diags(out, abound);
    let misfit: boolean = !settles_to(a.value, tt, cur) && !(type_assignable(vt, tt, unions) && dyn_conforms(vt, tt, cur));
    if (!parser.is_iflet_value_local(a.target) && abound.len() == 0 && !is_unknown(tt) && !is_unknown(vt) && (misfit || fills_unsettled_argument(vt, tt))) {
      out = out.append(dg_at("E003", "variable \"" + a.target + "\": expected " + type_label(tt) + ", got " + type_label(vt) + str_copy_hint(vt, tt), a.line, a.col));
    }
  }
  return out;
}

function assign_stmt_own_lambdas(st: ast.Stmt, cur: Scope, unions: UnionSig[]): util.Diag[] {
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        return util.append_diags(acc, stmts_assign_diags(lm.body, lambda_body_scope(lm, cur), unions));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, not_into_lambda);
}

function init_fits(init: ast.Expr, t: typeinfo.Type, declared: typeinfo.Type, s: Scope): boolean {
  return settles_to(init, declared, s) || semtypes.lends_array(t, declared) || coercible(t, declared, s);
}

function stmts_assign_diags(stmts: ast.Stmt[], s: Scope, unions: UnionSig[]): util.Diag[] {
  return stmts_assign_diags_mode(stmts, s, unions, false);
}

function var_pattern_diags(v: ast.StmtVar, s: Scope, tuple_pattern: boolean): util.Diag[] {
  let out: util.Diag[] = struct_destr_diags(v, s);
  let positions: string[] = split_pattern_names(v.name);
  if (!tuple_pattern && positions.len() > 1 && !parser.is_struct_destr_marker(v.type_name)) {
    out = util.append_diags(out, tuple_destr_diags(check_expr(v.init, s), positions.len(), v.line, v.col));
  }
  return out;
}

function stmts_assign_diags_mode(stmts: ast.Stmt[], s: Scope, unions: UnionSig[], tuple_pattern: boolean): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name) && !vb_placeholder_decl(v)) {
          let declared: typeinfo.Type = var_declared_type(v, cur);
          let initt: typeinfo.Type = check_expr(v.init, cur);
          if (!mlit_is_desugared(v.init)) {
            out = util.append_diags(out, e045_annot_diags(v.type_name, expr_line(v.init), expr_col(v.init), cur));
          }
          out = util.append_diags(out, int_dest_range_diags(v.init, declared));
          out = util.append_diags(out, ctor_payload_diags(v.init, declared, cur));
          let vbound: util.Diag[] = dest_bound_diags(v.init, declared, cur);
          out = util.append_diags(out, vbound);
          if (vbound.len() == 0 && !is_unknown(declared) && !is_unknown(initt) && !init_fits(v.init, initt, declared, cur)) {
            out = out.append(dg_at("E003", "variable \"" + v.name + "\": expected " + type_label(declared) + ", got " + type_label(initt) + str_copy_hint(initt, declared), v.line, v.col));
          }
          if (vbound.len() == 0 && is_unknown(declared) && !is_unknown(initt) && util.index_of_str(cur.tparams, v.type_name) < 0 && e064_unknown_bare(v.type_name, cur.type_names())) {
            out = out.append(dg_at("E003", "variable \"" + v.name + "\": expected " + v.type_name + ", got " + type_label(initt), v.line, v.col));
          }
        }
        if (v.type_name.len() == 0 && int_literal_tree(v.init)) {
          out = util.append_diags(out, int_range_diags(v.init, "i64", false));
        }
        out = util.append_diags(out, var_pattern_diags(v, cur, tuple_pattern));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, assign_diags(a, cur, unions));
      },
      ast.StmtIf(f) => {
        let ic: typeinfo.Type = check_expr(f.cond, cur);
        if (!is_unknown(ic) && !type_eq(ic, t_bool())) {
          out = out.append(dg_at("E008", "if condition must be boolean, got " + type_label(ic), expr_line(f.cond), expr_col(f.cond)));
        }
        out = util.append_diags(out, stmts_assign_diags_mode(f.then_body, cur, unions, f.sugar.tup.len() > 0));
        out = util.append_diags(out, stmts_assign_diags(f.else_body, cur, unions));
      },
      ast.StmtWhile(w) => {
        let wc: typeinfo.Type = check_expr(w.cond, cur);
        if (!is_unknown(wc) && !type_eq(wc, t_bool())) {
          out = out.append(dg_at("E008", "while condition must be boolean, got " + type_label(wc), expr_line(w.cond), expr_col(w.cond)));
        }
        out = util.append_diags(out, stmts_assign_diags(w.body, cur, unions));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, stmts_assign_diags(fr.body, for_body_scope(fr, cur), unions));
      },
      ast.StmtMatch(m) => {
        for elem in m.arms {
          let asc: Scope = cur;
          match (elem.pattern) {
            ast.PatVariant(apv) => {
              asc = bind_variant_payloads(asc, cur, apv, check_expr(m.scrutinee, cur));
            },
            _ => {}
          }
          out = util.append_diags(out, stmts_assign_diags(elem.body, asc, unions));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, stmts_assign_diags(one, cur, unions));
      },
      _ => {}
    }
    out = util.append_diags(out, assign_stmt_own_lambdas(st, cur, unions));
    cur = bind_stmt(st, cur);
  }
  return out;
}

pub struct ModuleTypes { sigs: FuncSig[], top_tys: typeinfo.Type[], all_well_typed: boolean, diags: util.Diag[] }

pub function is_build_gate_code(code: string): boolean {
  return util.is_diagnostic_code(code);
}

pub function build_gate_diags(mod: parser.Module): util.Diag[] {
  return build_gate_diags_with_file(mod, "");
}

pub function build_gate_diags_with_file(mod: parser.Module, entry_file: string): util.Diag[] {
  let cgd: util.Diag[] = const_init_diags(mod);
  if (cgd.len() > 0) {
    return cgd;
  }
  return filter_build_gate(check_module_with_file(mod, entry_file).diags);
}

pub function build_runtime_gate_diags(mod: parser.Module): util.Diag[] {
  return build_runtime_gate_diags_with_file(mod, "");
}

pub function build_runtime_gate_diags_with_file(mod: parser.Module, entry_file: string): util.Diag[] {
  let cgd: util.Diag[] = const_init_diags(mod);
  if (cgd.len() > 0) {
    return cgd;
  }
  return filter_build_gate(check_module_raw_floor(mod, entry_file, true).diags);
}

pub function filter_build_gate(diags: util.Diag[]): util.Diag[] {
  let out: util.Diag[] = [];
  for diag in diags {
    if (is_build_gate_code(diag.code)) {
      out = out.append(diag);
    }
  }
  return out;
}

function dg(code: string, message: string): util.Diag {
  return dg_at(code, message, 0, 0);
}

function dg_at(code: string, message: string, line: i32, col: i32): util.Diag {
  return util.Diag { related: [], length: 0, code: code, message: util.show_type_vars(message), line: line, col: col, fix: None };
}

function with_fix(d: util.Diag, old: string, line: i32, col: i32, to: string, note: string): util.Diag {
  if (to.len() == 0 || line <= 0) {
    return d;
  }
  return util.Diag { ...d, fix: Some(util.Fix { line: line, col: col, old: old, new_text: to, title: "replace `" + old + "` with `" + to + "`" + note }) };
}

function literal_field_fix(d: util.Diag, sl: ast.ExprStructLit, i: i32, fields: string[]): util.Diag {
  if (i >= sl.field_lines.len()) {
    return d;
  }
  return with_fix(d, sl.field_names[i], sl.field_lines[i], sl.field_cols[i], util.suggest(sl.field_names[i], fields), "");
}

function (s: Scope) member_fix(d: util.Diag, fa: ast.ExprFieldAccess, st: StructSig): util.Diag {
  return access_fix(d, fa, util.append_all(st.field_names, s.methods_in_namespace(st.name)));
}

function access_fix(d: util.Diag, fa: ast.ExprFieldAccess, members: string[]): util.Diag {
  return with_fix(d, fa.field, fa.line, fa.col + 1, util.suggest(fa.field, members), "");
}

function (s: Scope) method_fix(d: util.Diag, fa: ast.ExprFieldAccess, recv: typeinfo.Type): util.Diag {
  let ns: string = method_namespace_of(recv);
  if (retired_collection_spelling(ns, fa.field).len() > 0) {
    return d;
  }
  return access_fix(d, fa, s.method_fix_candidates(ns, recv));
}

function undefined_name(name: string, s: Scope, line: i32, col: i32): util.Diag {
  let d: util.Diag = util.Diag { ...dg_at("E001", "cannot find \"" + name + "\" in this scope", line, col), length: util.show_type_vars(name).len() };
  if (name == "string_from_bytes") {
    return with_fix(d, name, line, col, "string_from_bytes_unchecked", " (or `std/utf8.from_bytes`, which validates and returns `Option[string]`)");
  }
  return with_fix(d, name, line, col, util.suggest(name, s.visible_names()), "");
}

function (s: Scope) visible_names(): string[] {
  let out: string[] = [];
  let i: i32 = s.names.len() - 1;
  while (i >= 0) {
    out = astwalk.append_bound_name(out, s.names[i]);
    i = i - 1;
  }
  let funcs: string[] = parser.builtin_function_names();
  for sig in s.sigs.sigs {
    if (sig.receiver.len() == 0) {
      funcs = funcs.append(sig.name);
    }
  }
  return util.append_all(out, util.sorted_by(funcs, name_after));
}

function name_after(a: string, b: string): boolean {
  return a > b;
}

function scalar_match_exhaustive_diags(m: ast.StmtMatch, acc: util.Diag[], boolean_tag: boolean): util.Diag[] {
  if (m.origin.len() > 0) {
    return acc;
  }
  let saw_wild: boolean = false;
  for arm in m.arms {
    match (arm.pattern) {
      ast.PatWildcard(_) => {
        if (!arm.has_guard) {
          saw_wild = true;
        }
      },
      _ => {}
    }
  }
  if (saw_wild) {
    return acc;
  }
  if (boolean_tag) {
    return acc.append(dg_at("E030", "match on boolean is not exhaustive — add the missing `true` or `false` arm, or an unguarded `_`", m.line, m.col));
  }
  return acc.append(dg_at("E030", "match on non-enum value is not exhaustive — add an unguarded `_` arm", m.line, m.col));
}

function expr_line(e: ast.Expr): i32 {
  return ast.expr_line(e);
}

function expr_col(e: ast.Expr): i32 {
  return ast.expr_col(e);
}

function dup_name_before(names: string[], idx: i32): boolean {
  let j: i32 = 0;
  while (j < idx) {
    if (names[j] == names[idx]) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

function receiver_namespace(rt: string): string {
  if (rt == "str") {
    return "string";
  }
  return rt;
}

function receiver_type_ok(rt: string, mod: parser.Module): boolean {
  if (rt.len() == 0) {
    return true;
  }
  if (rt == "i32" || rt == "i64" || rt == "u8" || rt == "u32" || rt == "u64" || rt == "usize" || rt == "boolean" || rt == "string" || rt == "str" || rt == "f64" || rt == "f32" || rt == "char" || typeinfo.lanes_width(rt) > 0) {
    return true;
  }
  for ch in rt {
    if (ch == b'[') {
      return true;
    }
  }
  if (rt.len() >= 4 && slice_unchecked(rt, 0, 4) == "dyn ") {
    return true;
  }
  let base: string = util.base_type_name(rt);
  if (parser.is_reserved_struct_name(base) || parser.is_reserved_enum_name(base)) {
    return true;
  }
  for sd in mod.structs {
    if (sd.name == base) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == base) {
      return true;
    }
  }
  for alias in mod.aliases {
    if (alias.name == base) {
      return true;
    }
  }
  return false;
}

function const_literal(e: ast.Expr): boolean {
  match (e) {
    ast.ExprBytes(_) => {
      return true;
    },
    ast.ExprNumber(_) => {
      return true;
    },
    ast.ExprString(_) => {
      return true;
    },
    ast.ExprBool(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function const_unary_err(u: ast.ExprUnary, earlier: string[]): string {
  if (util.str_has_prefix(u.op, "as_")) {
    return "expression is not a constant (only literals, earlier consts, and arithmetic / comparison / logical operations on them are allowed)";
  }
  return const_expr_err(u.operand, earlier);
}

function const_struct_err(st: ast.ExprStructLit, earlier: string[]): string {
  if (st.has_base) {
    return "expression is not a constant (only literals, earlier consts, and arithmetic / comparison / logical operations on them are allowed)";
  }
  return const_elems_err(st.field_values, earlier);
}

function const_binary_err(b: ast.ExprBinary, earlier: string[]): string {
  if (const_refused_op(b.op)) {
    return "operator `" + b.op + "` not allowed in integer constant expressions";
  }
  let le: string = const_expr_err(b.left, earlier);
  if (le.len() > 0) {
    return le;
  }
  return const_expr_err(b.right, earlier);
}

function const_expr_err(e: ast.Expr, earlier: string[]): string {
  if (const_literal(e)) {
    return "";
  }
  match (e) {
    ast.ExprIdent(id) => {
      if (util.has_str(earlier, id.name)) {
        return "";
      }
      return "\"" + id.name + "\" is not a constant (must reference an earlier `const` declaration)";
    },
    ast.ExprUnary(u) => {
      return const_unary_err(u, earlier);
    },
    ast.ExprArray(a) => {
      return const_elems_err(a.elements, earlier);
    },
    ast.ExprTuple(t) => {
      return const_elems_err(t.elements, earlier);
    },
    ast.ExprStructLit(st) => {
      return const_struct_err(st, earlier);
    },
    ast.ExprBinary(b) => {
      return const_binary_err(b, earlier);
    },
    _ => {}
  }
  return "expression is not a constant (only literals, earlier consts, and arithmetic / comparison / logical operations on them are allowed)";
}

function const_elems_err(elems: ast.Expr[], earlier: string[]): string {
  for el in elems {
    let ee: string = const_expr_err(el, earlier);
    if (ee.len() > 0) {
      return ee;
    }
  }
  return "";
}

function const_init_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let earlier: string[] = [];
  let evaluated_names: string[] = [];
  let values: consteval.Value[] = [];
  for fd in mod.funcs {
    if (fd.is_const && fd.receiver_type.len() == 0) {
      for stmt in fd.body {
        match (stmt) {
          ast.StmtReturn(r) => {
            let msg: string = const_expr_err(r.value, earlier);
            if (msg.len() > 0) {
              out = out.append(dg_at("E093", "const " + fd.name + ": " + msg, fd.line, fd.col));
              continue;
            }
            let ranges: util.Diag[] = util.append_diags(suffix_range_stmts(fd.body), int_range_diags(r.value, fd.ret_type, false));
            if (ranges.len() > 0) {
              out = util.append_diags(out, ranges);
              continue;
            }
            let value: consteval.Value = consteval.settle(consteval.evaluate(r.value, parser.parse_type_ref(fd.ret_type), evaluated_names, values), fd.ret_type);
            if (value.error.len() > 0) {
              out = out.append(dg_at("E093", "const " + fd.name + ": " + value.error, fd.line, fd.col));
            } else {
              evaluated_names = evaluated_names.append(fd.name);
              values = values.append(value);
            }
          },
          _ => {}
        }
      }
      earlier = earlier.append(fd.name);
    }
  }
  return out;
}

function is_script(mod: parser.Module): boolean {
  for fd in mod.funcs {
    if (fd.name == "main" && fd.receiver_type.len() == 0) {
      return false;
    }
  }
  return mod.top_stmts.len() > 0;
}

function handler_state_diags(mod: parser.Module): util.Diag[] {
  let init_idx: i32 = -1;
  let handle_idx: i32 = -1;
  let i: i32 = 0;
  for fd in mod.funcs {
    if (fd.name == "main") {
      return [];
    }
    if (fd.receiver_type.len() == 0) {
      if (fd.name == "init" && init_idx < 0) {
        init_idx = i;
      }
      if (fd.name == "handle" && handle_idx < 0) {
        handle_idx = i;
      }
    }
    i = i + 1;
  }
  if (handle_idx < 0) {
    return [];
  }
  let returns_state: boolean = false;
  if (init_idx >= 0) {
    let init_fd: parser.FuncDecl = mod.funcs[init_idx];
    if (init_fd.params.len() > 1 || init_fd.params.len() == 1 && !parser.is_platform_param(init_fd, 0, parser.std_qualifier(mod, "platform"))) {
      return [dg_at("E075", "`init` takes " + util.i32_to_string(init_fd.params.len()) + " parameters; it takes none, or the platform alone", init_fd.line, init_fd.col)];
    }
    let kind: i32 = parser.init_return_kind(init_fd.ret_type, parser.std_qualifier(mod, "serve"));
    returns_state = kind == 1 || kind == 3;
  }
  let handle: parser.FuncDecl = mod.funcs[handle_idx];
  let takes_state: boolean = handle.params.len() == 3;
  if (takes_state && !returns_state) {
    return [dg_at("E075", "handler takes a state parameter, but no `init` produces the state to thread through it", handle.line, handle.col)];
  }
  if (returns_state && !takes_state) {
    let init: parser.FuncDecl = mod.funcs[init_idx];
    return [dg_at("E075", "`init` returns a value, but the handler takes no state parameter to thread it through", init.line, init.col)];
  }
  let j: i32 = 0;
  for fd in mod.funcs {
    if (fd.name == "shutdown" && fd.receiver_type.len() == 0) {
      if (fd.params.len() == 2 && !takes_state) {
        return [dg_at("E075", "`shutdown` takes a state parameter, but no `init` produces the state to hand it", fd.line, fd.col)];
      }
      if (fd.params.len() == 1 && takes_state) {
        return [dg_at("E075", "`shutdown` takes no state parameter, but the handler threads a state it would drop", fd.line, fd.col)];
      }
      return [];
    }
    j = j + 1;
  }
  return [];
}

function e078_payload_count(structs: parser.StructDecl[], ename: string, vname: string): i32 {
  for sd in structs {
    if (sd.enum_owner == ename && sd.name == vname) {
      return sd.fields.len();
    }
  }
  return 0 - 1;
}

function e078_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for ed in mod.enums {
    if (ed.try_marker) {
      if (ed.variant_names.len() != 2) {
        out = out.append(dg_at("E078", "@try enum " + ed.name + " must have exactly two variants — a success variant then a failure variant — but has " + util.i32_to_string(ed.variant_names.len()), ed.line, ed.col));
      } else {
        let ok_n: i32 = e078_payload_count(mod.structs, ed.name, ed.variant_names[0]);
        let fail_n: i32 = e078_payload_count(mod.structs, ed.name, ed.variant_names[1]);
        if (ok_n >= 0 && ok_n != 1) {
          out = out.append(dg_at("E078", "@try enum " + ed.name + ": the success variant \"" + ed.variant_names[0] + "\" must carry exactly one payload, but carries " + util.i32_to_string(ok_n), ed.line, ed.col));
        } else {
          if (fail_n > 1) {
            out = out.append(dg_at("E078", "@try enum " + ed.name + ": the failure variant \"" + ed.variant_names[1] + "\" must carry at most one payload, but carries " + util.i32_to_string(fail_n), ed.line, ed.col));
          }
        }
      }
    }
  }
  return out;
}

struct E079Probe { found: boolean, line: i32, col: i32 }

function e079_note_try(e: ast.Expr, own acc: E079Probe): E079Probe {
  if (acc.found) {
    return acc;
  }
  if let ast.ExprUnary(u) = e {
    if (u.op == "try_") {
      return E079Probe { found: true, line: u.line, col: u.col };
    }
  }
  return acc;
}

function e079_not_lambda(e: ast.Expr): boolean {
  if let ast.ExprLambda(lam) = e {
    return parser.is_value_block_origin(lam.origin);
  }
  return true;
}

function e079_no_expr(e: ast.Expr, own acc: util.Diag[]): util.Diag[] {
  return acc;
}

function e079_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for fd in mod.funcs {
    for stmt in fd.body {
      out = astwalk.fold_stmt_nodes(stmt, out, e079_visit_stmt, e079_no_expr, astwalk.descend_all);
    }
  }
  return out;
}

function e079_visit_stmt(st: ast.Stmt, own acc: util.Diag[]): util.Diag[] {
  if let ast.StmtDefer(d) = st {
    let probe: E079Probe = astwalk.fold_stmt_pruned(
      d.action,
      E079Probe { found: false, line: 0, col: 0 }, e079_note_try, e079_not_lambda,
    );
    if (probe.found) {
      let kind: string = "a `defer`";
      if (d.on_error != 0) {
        kind = "an `errdefer`";
      }
      return acc.append(dg_at("E079", "`?` is not allowed inside " + kind + " action: it propagates a failure to the caller, and a deferred action has no caller to propagate to", probe.line, probe.col));
    }
  }
  return acc;
}

function registered_intrinsics(): string[] {
  return [
    "__primitive_char_to_string", "__primitive_f32_to_string", "__primitive_f64_to_string", "__primitive_i32_to_string", "__primitive_i64_to_string", "__primitive_string_to_string", "__primitive_u32_to_string", "__primitive_u64_to_string", "__primitive_u8_to_string", "__primitive_usize_to_string",
    "__task_cancelled", "__task_cur", "__task_enter", "__task_free", "__task_leave", "__task_new", "__task_park", "__task_set_cancelled", "__task_set_ready", "__task_timeout", "__task_wait",
    "__abs_f64", "__aes_ctr32", "__aes_expand_key", "__aes_gcm_open", "__aes_gcm_seal", "__ghash", "__sha256_hw", "__sha256_hw_blocks", "__sha1_hw", "__sha1_hw_blocks", "__alloc", "__alloc_bool", "__alloc_i32", "__alloc_i64", "__alloc_reuse", "__alloc_u8", "__arr_push_shared_bytes", "__arr_push_shared_count", "__arr_set_len",
    "__ascii_run", "__bsd_sum", "__c_call0", "__c_call0_f32", "__c_call0_f64", "__c_call1", "__c_call1_f32",
    "__c_call1_f64", "__c_call2", "__c_call2_f32", "__c_call2_f64", "__c_call3", "__c_call3_f32", "__c_call3_f64",
    "__c_call4", "__c_call4_f32", "__c_call4_f64", "__ceil_f64", "__clz32", "__clz64", "__count_byte",
    "__bytes_into", "__bytes_owned", "__bytes_range", "__count_runs", "__count_runs_bytes", "__crc32_cksum", "__ct_public", "__ct_secret", "__ctz32", "__ctz64", "__fern_arr_dec", "__fern_box_free", "__fern_drop_arr_ptr",
    "__fern_rc_dec", "__fern_rc_inc", "__fern_str_dec", "__floor_f64", "__free", "__heap_alloc_count", "__heap_bump_bytes",
    "__account_entry", "__heap_mark", "__heap_release_to", "__load_i32", "__load_i64", "__load_ptr", "__load_u8",
    "__map_hash_seed", "__memchr", "__mulhi_u64", "__count_byte_bytes", "__crc32_cksum_array", "__sum_bytes_array", "__bsd_sum_bytes", "__memchr_bytes", "__mismatch_bytes", "__mismatch_bytes_str", "__rmemchr_bytes", "__memcpy", "__memset", "__mismatch", "__popcount32", "__popcount64",
    "__ptr_width", "__rc_dec", "__rc_get", "__rc_inc", "__rc_underflow_count", "__rmemchr",
    "__round_f64", "__scale_f64", "__outer_mul_f64", "__inner_mul_add_f64", "__scan_set", "__scan_set_bytes", "__sqrt_f64", "__store_i32", "__store_i64",
    "__store_ptr", "__store_u8", "__str_bytes", "__str_hash", "__sum_bytes", "__syscall3", "__syscall4", "__syscall5", "__syscall6", "__trunc_f64",
    "__f64x2_splat", "__f64x2_of", "__f64x2_lane", "__f64x2_bitmask", "__f64x2_mul_add", "__f64x2_sqrt", "__f64x2_abs", "__f64x2_floor", "__f64x2_round", "__f64x2_min", "__f64x2_max", "__f64x2_lt", "__f64x2_ne", "__f64x2_select", "__f64x2_load", "__f64x2_with",
    "__f32x4_splat", "__f32x4_of", "__f32x4_lane", "__f32x4_bitmask", "__f32x4_mul_add", "__f32x4_sqrt", "__f32x4_abs", "__f32x4_floor", "__f32x4_round", "__f32x4_min", "__f32x4_max", "__f32x4_lt", "__f32x4_ne", "__f32x4_select", "__f32x4_load", "__f32x4_with",
  ];
}

function redeclares(funcs: parser.FuncDecl[], names: util.NameIndex, di: i32): boolean {
  let f2: parser.FuncDecl = funcs[di];
  let earlier: boolean = redeclares_preregistered(f2);
  let ej: i32 = names.chain(decl_key(f2));
  while (ej >= 0 && ej < di) {
    let pe: parser.FuncDecl = funcs[ej];
    if (f2.receiver_type.len() == 0 && pe.receiver_type.len() == 0 && pe.name == f2.name) {
      earlier = true;
    }
    if (same_method_decl(pe, f2)) {
      earlier = true;
    }
    ej = names.next[ej];
  }
  // A free function named like a builtin or an intrinsic redeclares it, as
  // native's pre-registered signature makes it there.
  if (f2.receiver_type.len() == 0 && !is_primitive_display_builtin(f2.name) && (builtin_row(f2.name).len() > 0 || util.has_str(registered_intrinsics(), f2.name))) {
    earlier = true;
  }
  return earlier;
}

function redeclares_preregistered(f2: parser.FuncDecl): boolean {
  if (f2.receiver_type.len() == 0) {
    return false;
  }
  return util.has_str(preregistered_methods(parser.receiver_namespace(f2.receiver_type)), f2.name);
}

function decl_key(fd: parser.FuncDecl): string {
  if (parser.receiver_namespace(fd.receiver_type) == "Map" && fd.name == "__iterator") {
    return "iter";
  }
  if (fd.receiver_type.len() == 0) {
    return fd.name;
  }
  return method_simple_name(fd.name);
}

function same_method_decl(pe: parser.FuncDecl, f2: parser.FuncDecl): boolean {
  if (f2.receiver_type.len() == 0 || pe.receiver_type.len() == 0 || decl_key(pe) != decl_key(f2)) {
    return false;
  }
  return pe.impl_trait == f2.impl_trait && parser.receiver_namespace(pe.receiver_type) == parser.receiver_namespace(f2.receiver_type);
}

function method_ambiguity_diags(mod: parser.Module): util.Diag[] {
  let order: i32[] = [];
  for entry in [true, false] {
    let i: i32 = 0;
    while (i < mod.funcs.len()) {
      let in_entry: boolean = mod.funcs[i].module.len() == 0;
      if (in_entry == entry && mod.funcs[i].receiver_type.len() > 0) {
        order = order.append(i);
      }
      i = i + 1;
    }
  }
  let keys: string[] = [];
  let inherent: i32[] = [];
  let traited: i32[] = [];
  let out: util.Diag[] = [];
  for fi in order {
    let fd: parser.FuncDecl = mod.funcs[fi];
    let key: string = parser.receiver_namespace(fd.receiver_type) + "." + method_simple_name(fd.name);
    let k: i32 = util.index_of_str(keys, key);
    if (k < 0) {
      k = keys.len();
      keys = keys.append(key);
      inherent = inherent.append(0 - 1);
      traited = traited.append(0 - 1);
    }
    let other: i32 = inherent[k];
    if (fd.impl_trait.len() == 0) {
      other = traited[k];
    }
    if (other >= 0) {
      out = out.append(ambiguous_method_diag(mod, fd, mod.funcs[other]));
    } else if (fd.impl_trait.len() == 0) {
      inherent = inherent.with(k, fi);
    } else if (traited[k] < 0) {
      traited = traited.with(k, fi);
    }
  }
  return out;
}

function method_simple_name(name: string): string {
  let i: i32 = name.len() - 1;
  while (i >= 0 && name[i] != b'.') {
    i = i - 1;
  }
  return slice_unchecked(name, i + 1, name.len()) + "";
}

function ambiguous_method_diag(mod: parser.Module, pending: parser.FuncDecl, other: parser.FuncDecl): util.Diag {
  let at: parser.FuncDecl = pending;
  if (pending.stdlib.len() > 0 && other.stdlib.len() == 0) {
    at = other;
  }
  let typ: string = util.demangle(parser.receiver_namespace(pending.receiver_type));
  let msg: string = "ambiguous method \"" + method_simple_name(pending.name) + "\" on " + typ + ": provided by " + method_provider(mod, pending) + " and " + method_provider(mod, other);
  return dg_at("E074", msg, at.line, at.col);
}

function method_provider(mod: parser.Module, fd: parser.FuncDecl): string {
  let what: string = "an inherent method";
  if (fd.impl_trait.len() > 0) {
    what = "trait " + impl_trait_spelling(mod, fd);
  }
  let file: string = "";
  if (fd.stdlib.len() > 0) {
    file = fd.stdlib + ".fern:";
  } else if (fd.module.len() > 0) {
    file = fd.module + ".fern:";
  }
  return what + " (declared at " + file + util.i32_to_string(util.pos_line(fd.line)) + ":" + util.i32_to_string(fd.col) + ")";
}

function impl_trait_spelling(mod: parser.Module, fd: parser.FuncDecl): string {
  let base: string = parser.receiver_namespace(fd.receiver_type);
  for im in mod.impls {
    if (im.trait_name == fd.impl_trait && im.trait_module.len() > 0 && parser.receiver_namespace(im.impl_type) == base) {
      return im.trait_module + "." + fd.impl_trait;
    }
  }
  return fd.impl_trait;
}

function orphan_impl_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for im in mod.impls {
    if (im.trait_name.len() == 0 || im.trait_module == im.module || impl_type_is_local(mod, im)) {
      continue;
    }
    let tr: string = im.trait_name;
    if (im.trait_module.len() > 0) {
      tr = im.trait_module + "." + tr;
    }
    out = out.append(dg_at("E021", "orphan impl: `impl " + tr + " for " + util.demangle(util.base_type_name(im.impl_type)) + "` must be declared in the module that defines the trait or the type", im.line, im.col));
  }
  return out;
}

function impl_type_is_local(mod: parser.Module, im: parser.ImplInfo): boolean {
  let base: string = util.base_type_name(im.impl_type);
  if (!declares_nominal(mod, base)) {
    return false;
  }
  if (im.module.len() == 0) {
    return !util.contains(base, "__");
  }
  return util.str_has_prefix(base, im.module + "__");
}

function declares_nominal(mod: parser.Module, name: string): boolean {
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == name) {
      return true;
    }
  }
  return false;
}

function main_signature_diags(fd: parser.FuncDecl, out: util.Diag[]): util.Diag[] {
  if (fd.params.len() > 0) {
    out = out.append(dg_at("E084", "main takes no parameters; read the command line with args()", fd.line, fd.col));
  }
  if (fd.ret_type != "" && !main_result_ty(fd.ret_type)) {
    out = out.append(dg_at("E084", "main returns an integer, a boolean or void, not " + fd.ret_type, fd.line, fd.col));
  }
  return out;
}

function resource_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let rn: i32 = 0;
  while (rn < mod.resources.len()) {
    let rclash: string = parser.resource_collision(mod, rn);
    let rdecl: parser.ResourceDecl = mod.resources[rn];
    if (rclash == "resource") {
      out = out.append(dg_at("E006", "resource \"" + rdecl.name + "\" redeclared", rdecl.line, rdecl.col));
    } else if (rclash.len() > 0) {
      let article: string = "a ";
      if (rclash == "enum") {
        article = "an ";
      }
      out = out.append(dg_at("E006", "resource \"" + rdecl.name + "\" conflicts with " + article + rclash + " of the same name", rdecl.line, rdecl.col));
    }
    rn = rn + 1;
  }
  return out;
}

function return_type_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for func in mod.funcs {
    if (func.ret_type == "" && func.body.len() > 0 && func.is_const) {
      out = out.append(dg_at("E081", "cannot infer the type of const \"" + func.name + "\"; declare it explicitly", func.line, func.col));
    } else if (func.ret_type == "" && func.import_iface == "" && !func.is_const) {
      out = out.append(dg_at("E081", "missing return type on function \"" + func.name + "\"; declare it explicitly (use `: void` if it returns nothing)", func.line, func.col));
    }
  }
  for func in mod.funcs {
    if (func.name == "main" && func.receiver_type == "" && func.import_iface == "") {
      out = main_signature_diags(func, out);
    }
  }
  return out;
}

function alias_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let ak: i32 = 0;
  while (ak < mod.aliases.len()) {
    let alias: parser.TypeAlias = mod.aliases[ak];
    for msg in parser.union_alias_errors(mod, alias) {
      out = out.append(dg_at("E016", msg, alias.line, alias.col));
    }
    if (parser.alias_redeclares_enum(mod, ak)) {
      out = out.append(dg_at("E006", "enum \"" + alias.name + "\" redeclared", alias.line, alias.col));
    }
    ak = ak + 1;
  }
  return out;
}

function export_shape_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for export in mod.exports {
    let ename: string = export.func_name;
    for xfd in mod.funcs {
      if (xfd.name == ename && xfd.receiver_name.len() > 0 == export.method) {
        if (xfd.all_type_params.len() > 0) {
          out = out.append(dg_at("E054", "@export function \"" + xfd.name + "\" cannot be generic (a world export has a single concrete ABI)", xfd.line, xfd.col));
        }
        if (xfd.receiver_name.len() > 0) {
          out = out.append(dg_at("E054", "@export cannot be applied to a method (\"" + xfd.name + "\"); use a top-level function", xfd.line, xfd.col));
        }
      }
    }
  }
  return out;
}

function collect_decl_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = util.append_diags([], const_init_diags(mod));
  out = util.append_diags(out, handler_state_diags(mod));
  out = util.append_diags(out, e078_diags(mod));
  out = util.append_diags(out, e079_diags(mod));
  for sd in mod.structs {
    let fnames: string[] = [];
    for field in sd.fields {
      fnames = fnames.append(field.name);
    }
    let fk: i32 = 0;
    while (fk < fnames.len()) {
      if (dup_name_before(fnames, fk)) {
        out = out.append(dg_at("E007", "duplicate field \"" + fnames[fk] + "\" in struct " + sd.name, sd.line, sd.col));
      }
      fk = fk + 1;
    }
  }
  for fd in mod.funcs {
    let pnames: string[] = [];
    for param in fd.params {
      pnames = pnames.append(param.name);
    }
    for cp in const_tparams(fd) {
      pnames = pnames.append(cp);
    }
    let pk: i32 = 0;
    while (pk < pnames.len()) {
      if (dup_name_before(pnames, pk)) {
        out = out.append(dg_at("E018", "duplicate parameter \"" + pnames[pk] + "\"", fd.line, fd.col));
      }
      pk = pk + 1;
    }
  }
  let decl_names: string[] = [];
  for fd in mod.funcs {
    decl_names = decl_names.append(decl_key(fd));
  }
  out = util.append_diags(out, method_ambiguity_diags(mod));
  let decl_index: util.NameIndex = util.name_index(decl_names);
  let di: i32 = 0;
  while (di < mod.funcs.len()) {
    let f2: parser.FuncDecl = mod.funcs[di];
    if (redeclares(mod.funcs, decl_index, di)) {
      if (f2.is_const) {
        out = out.append(dg_at("E006", "const \"" + f2.name + "\" redeclared", f2.line, f2.col));
      } else if (f2.receiver_type.len() == 0) {
        out = out.append(dg_at("E006", "function \"" + f2.name + "\" redeclared", f2.line, f2.col));
      } else {
        out = out.append(dg_at("E006", "method \"" + decl_key(f2) + "\" on " + parser.receiver_namespace(f2.receiver_type) + " redeclared", f2.line, f2.col));
      }
    }
    if (f2.receiver_name.len() > 0 && !receiver_type_ok(f2.receiver_type, mod)) {
      out = out.append(dg_at("E021", "method receiver type must be a struct, enum, array, slice, or built-in type, got " + util.base_type_name(f2.receiver_type), f2.line, f2.col));
    }
    di = di + 1;
  }
  let sn2: i32 = 0;
  while (sn2 < mod.structs.len()) {
    let s2: parser.StructDecl = mod.structs[sn2];
    let user_struct: boolean = s2.enum_owner.len() == 0 && !(s2.name.len() >= 2 && slice_unchecked(s2.name, 0, 2) == "__");
    if (user_struct) {
      let sdup: boolean = false;
      let sj2: i32 = 0;
      while (sj2 < sn2) {
        if (mod.structs[sj2].enum_owner.len() == 0 && mod.structs[sj2].name == s2.name) {
          sdup = true;
        }
        sj2 = sj2 + 1;
      }
      if (sdup) {
        out = out.append(dg_at("E006", "struct \"" + s2.name + "\" redeclared", s2.line, s2.col));
      }
      if (s2.line > 0 && (parser.is_reserved_struct_name(s2.name) || parser.is_reserved_enum_name(s2.name))) {
        out = out.append(dg_at("E010", "struct \"" + s2.name + "\" is a reserved built-in name and cannot be redeclared", s2.line, s2.col));
      }
    }
    sn2 = sn2 + 1;
  }
  let en: i32 = 0;
  while (en < mod.enums.len()) {
    let edup: boolean = false;
    let ej2: i32 = 0;
    while (ej2 < en) {
      if (mod.enums[ej2].name == mod.enums[en].name) {
        edup = true;
      }
      ej2 = ej2 + 1;
    }
    if (edup) {
      out = out.append(dg_at("E006", "enum \"" + mod.enums[en].name + "\" redeclared", mod.enums[en].line, mod.enums[en].col));
    }
    if (parser.is_reserved_enum_name(mod.enums[en].name) || parser.is_reserved_struct_name(mod.enums[en].name)) {
      out = out.append(dg_at("E010", "enum \"" + mod.enums[en].name + "\" is a reserved built-in name and cannot be redeclared", mod.enums[en].line, mod.enums[en].col));
    }
    let vn: string[] = mod.enums[en].variant_names;
    let vk: i32 = 0;
    while (vk < vn.len()) {
      if (dup_name_before(vn, vk)) {
        out = out.append(dg_at("E017", "duplicate variant \"" + vn[vk] + "\" in enum " + mod.enums[en].name, mod.enums[en].line, mod.enums[en].col));
      }
      vk = vk + 1;
    }
    en = en + 1;
  }
  out = util.append_diags(out, resource_diags(mod));
  out = util.append_diags(out, return_type_diags(mod));
  out = util.append_diags(out, alias_diags(mod));
  out = util.append_diags(out, export_shape_diags(mod));
  return out;
}

pub struct OwnFunc { name: string, flags: boolean[], arr: boolean[] }

pub struct OwnFuncs { rows: OwnFunc[], names: util.NameIndex, structs: util.NameIndex, decls: util.NameIndex, ctors: util.NameIndex, methods: util.NameIndex, funcs: util.NameIndex }

struct MovedEntry { mname: string, mline: i32 }

struct OwnWalk { moved: MovedEntry[], diags: util.Diag[] }

struct OwnCtx { owned: string[], borrowed: string[], ofuncs: OwnFuncs, structs: parser.StructDecl[], snames: util.NameIndex, admit: string, admit_fields: string[], fresh: string[], fresh_methods: string[], fresh_scrut: string[], bound: string[], scope: Scope, last_use: string[] }

function ow_expr_is_scalar(e: ast.Expr, ctx: OwnCtx): boolean {
  if (ow_scalar_literal(e)) {
    return true;
  }
  match (check_expr(e, ctx.scope)) {
    typeinfo.TypeI32(_) => {
      return true;
    },
    typeinfo.TypeBool(_) => {
      return true;
    },
    typeinfo.TypeFloat(_) => {
      return true;
    },
    typeinfo.TypeVoid(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function ow_is_string_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeString(_) = t {
    return true;
  }
  return false;
}

function ow_moved_has(m: MovedEntry[], name: string): boolean {
  for elem in m {
    if (elem.mname == name) {
      return true;
    }
  }
  return false;
}

function ow_moved_line(m: MovedEntry[], name: string): i32 {
  for elem in m {
    if (elem.mname == name) {
      return elem.mline;
    }
  }
  return 0;
}

function ow_moved_add(m: MovedEntry[], name: string, line: i32): MovedEntry[] {
  if (ow_moved_has(m, name)) {
    return m;
  }
  return m.append(MovedEntry { mname: name, mline: line });
}

function ow_moved_join(dst: MovedEntry[], branch: MovedEntry[], diverges: boolean): MovedEntry[] {
  if (diverges) {
    return dst;
  }
  let out: MovedEntry[] = dst;
  for elem in branch {
    out = ow_moved_add(out, elem.mname, elem.mline);
  }
  return out;
}

function ow_is_owned(ctx: OwnCtx, name: string): boolean {
  return util.has_str(ctx.owned, name);
}

function ow_ownable_type(type_name: string): boolean {
  let scalars: string[] = ["boolean", "i32", "i64", "u8", "u32", "u64", "f64", "f32", "char", "usize", "void"];
  return !util.has_str(scalars, type_name);
}

function ow_nested_ctx(ctx: OwnCtx, lm: ast.ExprLambda): OwnCtx {
  let params: ast.ParamDecl[] = lm.params;
  let names: string[] = ctx.owned;
  let borrowed: string[] = ctx.borrowed;
  for param in params {
    if (param.own && ow_ownable_type(param.type_name)) {
      if (!util.has_str(names, param.name)) {
        names = names.append(param.name);
      }
      borrowed = ow_names_del(borrowed, param.name);
    } else {
      names = ow_names_del(names, param.name);
      if (!util.has_str(borrowed, param.name)) {
        borrowed = borrowed.append(param.name);
      }
    }
  }
  let bound: string[] = ctx.bound;
  for p in params {
    if (!util.has_str(bound, p.name)) {
      bound = bound.append(p.name);
    }
  }
  let nested: OwnCtx = OwnCtx { owned: names, borrowed: borrowed, ofuncs: ctx.ofuncs, structs: ctx.structs, snames: ctx.snames, admit: ctx.admit, admit_fields: ctx.admit_fields, fresh: ctx.fresh, fresh_methods: ctx.fresh_methods, fresh_scrut: ctx.fresh_scrut, bound: bound, scope: lambda_body_scope(lm, ctx.scope), last_use: ctx.last_use };
  return nested;
}

function ow_names_del(names: string[], name: string): string[] {
  let out: string[] = [];
  for nm in names {
    if (nm != name) {
      out = out.append(nm);
    }
  }
  return out;
}

function ow_nested_moved(m: MovedEntry[], params: ast.ParamDecl[]): MovedEntry[] {
  let out: MovedEntry[] = m;
  for param in params {
    out = ow_moved_del(out, param.name);
  }
  return out;
}

function ow_func_flags(ofuncs: OwnFuncs, name: string): boolean[] {
  let i: i32 = ofuncs.names.find(name);
  if (i >= 0) {
    return ofuncs.rows[i].flags;
  }
  let empty: boolean[] = [];
  return empty;
}

function ow_is_own_func(ofuncs: OwnFuncs, name: string): boolean {
  return ofuncs.names.has(name);
}

function ow_variant_known(ctx: OwnCtx, name: string, owner: string): boolean {
  let i: i32 = ctx.snames.chain(name);
  while (i >= 0) {
    let sd: parser.StructDecl = ctx.structs[i];
    if (sd.name == name && sd.enum_owner != "" && (owner == "" || sd.enum_owner == owner)) {
      return true;
    }
    i = ctx.snames.next[i];
  }
  return false;
}

function ow_struct_names(structs: parser.StructDecl[]): string[] {
  let names: string[] = [];
  for sd in structs {
    names = names.append(sd.name);
  }
  return names;
}

function ow_scalar_literal(e: ast.Expr): boolean {
  if let ast.ExprNumber(_) = e {
    return true;
  }
  if let ast.ExprBool(_) = e {
    return true;
  }
  return false;
}

function ow_is_owned_scrutinee(e: ast.Expr, ctx: OwnCtx): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(cid) = c.callee {
      if (ctx.ofuncs.ctors.has(cid.name)) {
        return true;
      }
      return util.has_str(ctx.fresh_scrut, cid.name);
    }
    return false;
  }
  return ow_is_owned_expr(e, ctx);
}

function ow_is_owned_expr(e: ast.Expr, ctx: OwnCtx): boolean {
  if (ow_expr_is_scalar(e, ctx)) {
    return true;
  }
  match (e) {
    ast.ExprStructLit(_) => {
      return true;
    },
    ast.ExprArray(_) => {
      return true;
    },
    ast.ExprTuple(_) => {
      return true;
    },
    ast.ExprMapLit(_) => {
      return true;
    },
    ast.ExprBinary(b) => {
      return b.op == "+" && ow_is_string_type(check_expr(b.left, ctx.scope)) && ow_is_string_type(check_expr(b.right, ctx.scope));
    },
    ast.ExprIdent(id) => {
      if (ctx.admit.len() > 0 && ctx.admit == id.name) {
        return true;
      }
      if (util.has_str(ctx.last_use, lu_key(id.line, id.col))) {
        return true;
      }
      if (ow_variant_known(ctx, id.name, "")) {
        return true;
      }
      if (!util.has_str(ctx.bound, id.name) && !ctx.scope.is_bound(id.name) && ctx.scope.lookup_sig(id.name).is_const) {
        return true;
      }
      return ow_is_owned(ctx, id.name);
    },
    ast.ExprFieldAccess(fa) => {
      if (ow_variant_known(ctx, fa.field, ow_ident_name(fa.obj))) {
        return true;
      }
      return util.has_str(ctx.admit_fields, ow_ident_name(fa.obj) + "." + fa.field);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return ctx.ofuncs.ctors.has(cid.name) || util.has_str(ctx.fresh, cid.name);
        },
        ast.ExprFieldAccess(mfa) => {
          for ns in ow_type_namespaces(check_expr(mfa.obj, ctx.scope)) {
            if (util.has_str(ctx.fresh_methods, ns + "." + mfa.field)) {
              return true;
            }
          }
          return false;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

struct LuOcc { name: string, line: i32, col: i32 }

struct LuVar { name: string, init: ast.Expr }

struct LuSel { obj: string, field: string }

struct LuFacts { occ: LuOcc[], vars: LuVar[], escaping: string[], sels: LuSel[] }

struct LuFn { facts: LuFacts, params: string[], ofuncs: OwnFuncs }

struct LuSite { stmts: ast.Stmt[], idx: i32, in_loop: boolean, fresh: string[], in_iife: boolean }

function lu_key(line: i32, col: i32): string {
  return util.i32_to_string(line) + ":" + util.i32_to_string(col);
}

function lu_name_stmt(s: ast.Stmt, own a: string[]): string[] {
  if let ast.StmtAssign(asg) = s {
    return a.append(asg.target);
  }
  return a;
}

function lu_name_expr(e: ast.Expr, own a: string[]): string[] {
  if let ast.ExprIdent(id) = e {
    return a.append(id.name);
  }
  return a;
}

function lu_all_names(st: ast.Stmt, own acc: string[]): string[] {
  return astwalk.fold_stmt_nodes(st, acc, lu_name_stmt, lu_name_expr, astwalk.descend_all);
}

function lu_fact_stmt(st: ast.Stmt, own f: LuFacts): LuFacts {
  match (st) {
    ast.StmtAssign(a) => {
      return LuFacts { ...f, occ: f.occ.append(LuOcc { name: a.target, line: a.target_line, col: a.target_col }) };
    },
    ast.StmtVar(v) => {
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return LuFacts { ...f, vars: lu_destr_vars(v, f.vars) };
      }
      return LuFacts { ...f, vars: f.vars.append(LuVar { name: v.name, init: v.init }) };
    },
    ast.StmtDefer(d) => {
      return LuFacts { ...f, escaping: lu_all_names(d.action, f.escaping) };
    },
    _ => {
      return f;
    }
  }
  return f;
}

function lu_destr_vars(v: ast.StmtVar, own vars: LuVar[]): LuVar[] {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let init: ast.Expr = none;
  if (lu_fresh_expr(v.init) && parser.destr_marker_split(v.type_name).at.len() == 0) {
    init = v.init;
  }
  for nm in split_pattern_names(v.name) {
    if (util.is_tuple_type_name(nm)) {
      vars = lu_nested_vars(nm, vars);
    } else {
      vars = vars.append(LuVar { name: nm, init: init });
    }
  }
  return vars;
}

function lu_nested_vars(group: string, own vars: LuVar[]): LuVar[] {
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  for nm in split_pattern_names(slice_unchecked(group, 1, group.len() - 1) + "") {
    if (util.is_tuple_type_name(nm)) {
      vars = lu_nested_vars(nm, vars);
    } else {
      vars = vars.append(LuVar { name: nm, init: none });
    }
  }
  return vars;
}

function lu_fact_expr(e: ast.Expr, own f: LuFacts): LuFacts {
  match (e) {
    ast.ExprIdent(id) => {
      return LuFacts { ...f, occ: f.occ.append(LuOcc { name: id.name, line: id.line, col: id.col }) };
    },
    ast.ExprLambda(lm) => {
      if (lm.origin.len() > 0) {
        return f;
      }
      let esc: string[] = f.escaping;
      for st in lm.body {
        esc = lu_all_names(st, esc);
      }
      return LuFacts { ...f, escaping: esc };
    },
    ast.ExprFieldAccess(fa) => {
      let obj: string = ow_ident_name(fa.obj);
      if (obj.len() == 0) {
        return f;
      }
      return LuFacts { ...f, sels: f.sels.append(LuSel { obj: obj, field: fa.field }) };
    },
    _ => {
      return f;
    }
  }
  return f;
}

function lu_occ_count(fx: LuFn, name: string): i32 {
  let n: i32 = 0;
  for o in fx.facts.occ {
    if (o.name == name) {
      n = n + 1;
    }
  }
  return n;
}

function lu_decl_count(fx: LuFn, name: string): i32 {
  let n: i32 = 0;
  for v in fx.facts.vars {
    if (v.name == name) {
      n = n + 1;
    }
  }
  return n;
}

struct LuInit { ok: boolean, init: ast.Expr }

function lu_init_of(fx: LuFn, name: string): LuInit {
  let found: i32 = 0;
  let init: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  for v in fx.facts.vars {
    if (v.name == name) {
      found = found + 1;
      init = v.init;
    }
  }
  return LuInit { ok: found == 1, init: init };
}

function lu_is_local(fx: LuFn, name: string): boolean {
  return !util.has_str(fx.params, name) && lu_decl_count(fx, name) > 0;
}

function lu_fresh_init(fx: LuFn, name: string): boolean {
  let li: LuInit = lu_init_of(fx, name);
  return li.ok && lu_fresh_expr(li.init);
}

function lu_fresh_expr(e: ast.Expr): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(_) = c.callee {
      return true;
    }
    if let ast.ExprFieldAccess(_) = c.callee {
      return true;
    }
  }
  if let ast.ExprArray(_) = e {
    return true;
  }
  if let ast.ExprString(_) = e {
    return true;
  }
  if let ast.ExprStructLit(sl) = e {
    return !sl.has_base;
  }
  return false;
}

function lu_unpack_init(fx: LuFn, name: string): boolean {
  let li: LuInit = lu_init_of(fx, name);
  if (!li.ok) {
    return false;
  }
  if let ast.ExprFieldAccess(fa) = li.init {
    let h: string = ow_ident_name(fa.obj);
    if (h.len() == 0 || !lu_fresh_init(fx, h)) {
      return false;
    }
    let reads: i32 = 0;
    let selections: i32 = 0;
    for sel in fx.facts.sels {
      if (sel.obj == h) {
        selections = selections + 1;
        if (sel.field == fa.field) {
          reads = reads + 1;
        }
      }
    }
    return reads == 1 && selections == lu_occ_count(fx, h);
  }
  return false;
}

function lu_rename_source(fx: LuFn, name: string): string {
  let li: LuInit = lu_init_of(fx, name);
  if (!li.ok) {
    return "";
  }
  let src: string = ow_ident_name(li.init);
  if (src.len() == 0 || lu_occ_count(fx, src) != 1) {
    return "";
  }
  return src;
}

function lu_admitted(fx: LuFn, name: string): boolean {
  if (lu_fresh_init(fx, name) || lu_unpack_init(fx, name)) {
    return true;
  }
  let root: string = lu_rename_source(fx, name);
  if (root.len() == 0) {
    return false;
  }
  let seen: string[] = [name, root];
  let next: string = lu_rename_source(fx, root);
  while (next.len() > 0 && !util.has_str(seen, next)) {
    root = next;
    seen = seen.append(next);
    next = lu_rename_source(fx, root);
  }
  return util.has_str(fx.params, root) || lu_fresh_init(fx, root) || lu_unpack_init(fx, root);
}

function lu_is_last(fx: LuFn, id: ast.ExprIdent): boolean {
  for o in fx.facts.occ {
    if (o.name == id.name && (o.line > id.line || o.line == id.line && o.col > id.col)) {
      return false;
    }
  }
  return true;
}

function lu_mentions(st: ast.Stmt, name: string): i32 {
  let n: i32 = 0;
  for nm in lu_all_names(st, []) {
    if (nm == name) {
      n = n + 1;
    }
  }
  return n;
}

function lu_jump_escapes(st: ast.Stmt, depth: i32): boolean {
  match (st) {
    ast.StmtBreak(b) => {
      return depth == 0 || b.label.len() > 0;
    },
    ast.StmtContinue(c) => {
      return depth == 0 || c.label.len() > 0;
    },
    ast.StmtIf(f) => {
      return lu_jumps_escape(f.then_body, depth) || lu_jumps_escape(f.else_body, depth);
    },
    ast.StmtWhile(w) => {
      return lu_jumps_escape(w.body, depth + 1);
    },
    ast.StmtFor(fo) => {
      return lu_jumps_escape(fo.body, depth + 1);
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        if (lu_jumps_escape(arm.body, depth)) {
          return true;
        }
      }
      return false;
    },
    ast.StmtDefer(d) => {
      return lu_jump_escapes(d.action, depth);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function lu_jumps_escape(stmts: ast.Stmt[], depth: i32): boolean {
  for s in stmts {
    if (lu_jump_escapes(s, depth)) {
      return true;
    }
  }
  return false;
}

function lu_returns_before_reading(site: LuSite, name: string): boolean {
  if (lu_mentions(site.stmts[site.idx], name) != 1) {
    return false;
  }
  let j: i32 = site.idx + 1;
  while (j < site.stmts.len()) {
    let st: ast.Stmt = site.stmts[j];
    if (lu_mentions(st, name) != 0 || lu_jump_escapes(st, 0)) {
      return false;
    }
    if let ast.StmtReturn(_) = st {
      return true;
    }
    j = j + 1;
  }
  return false;
}

function lu_arr_position(fx: LuFn, callee: string, i: i32): boolean {
  for ofn in fx.ofuncs.rows {
    if (ofn.name == callee) {
      return i >= ofn.arr.len() || ofn.arr[i];
    }
  }
  return true;
}

function lu_dies(fx: LuFn, call: ast.Expr, arr: boolean, aid: ast.ExprIdent, outer: ast.Expr, has_outer: boolean, site: LuSite): boolean {
  let name: string = aid.name;
  if (!lu_is_local(fx, name) || util.has_str(fx.facts.escaping, name)) {
    return false;
  }
  let once: boolean = astwalk.count_ident_expr(call, name) == 1;
  if (lu_rebind_site(site, name)) {
    return true;
  }
  let repeats: boolean = site.in_loop && !(util.has_str(site.fresh, name) && lu_decl_count(fx, name) == 1);
  if (repeats || !once || !lu_admitted(fx, name)) {
    return false;
  }
  if (lu_is_last(fx, aid)) {
    return !(has_outer && astwalk.count_ident_expr(outer, name) > 1);
  }
  if (site.in_iife || arr) {
    return false;
  }
  return lu_returns_before_reading(site, name);
}

function lu_rebind_site(site: LuSite, name: string): boolean {
  match (site.stmts[site.idx]) {
    ast.StmtAssign(a) => {
      if let ast.ExprCall(_) = a.value {
        if (a.target == name && astwalk.count_ident_expr(a.value, name) == 1) {
          return true;
        }
      }
    },
    ast.StmtReturn(r) => {
      if (!site.in_iife && astwalk.count_ident_expr(r.value, name) == 1) {
        return true;
      }
    },
    ast.StmtVar(v) => {
      if let ast.ExprCall(_) = v.init {
        if (astwalk.count_ident_expr(v.init, name) == 1) {
          return lu_rebound_after(site, name);
        }
      }
    },
    _ => {}
  }
  return false;
}

function lu_rebound_after(site: LuSite, name: string): boolean {
  let j: i32 = site.idx + 1;
  while (j < site.stmts.len()) {
    if let ast.StmtAssign(a) = site.stmts[j] {
      if (a.target == name) {
        if (astwalk.count_ident_expr(a.value, name) != 0) {
          return false;
        }
        let k: i32 = site.idx + 1;
        while (k < j) {
          if (!lu_straight(site.stmts[k]) || lu_mentions(site.stmts[k], name) != 0) {
            return false;
          }
          k = k + 1;
        }
        return true;
      }
    }
    j = j + 1;
  }
  return false;
}

function lu_straight(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return !lu_has_try(v.init);
    },
    ast.StmtAssign(a) => {
      return !lu_has_try(a.value);
    },
    ast.StmtExpr(x) => {
      return !lu_has_try(x.value);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function lu_has_try(e: ast.Expr): boolean {
  return astwalk.fold_expr_pruned(e, false, lu_try_at, astwalk.not_lambda);
}

function lu_try_at(x: ast.Expr, own found: boolean): boolean {
  if let ast.ExprUnary(u) = x {
    if (u.op == "try_") {
      return true;
    }
  }
  return found;
}

function lu_call(c: ast.ExprCall, e: ast.Expr, outer: ast.Expr, has_outer: boolean, site: LuSite, fx: LuFn, own acc: string[]): string[] {
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (!fx.ofuncs.methods.has(fa.field)) {
      for a in c.args {
        acc = lu_method_arg(a, e, outer, has_outer, site, fx, acc);
      }
      return acc;
    }
    acc = lu_method_arg(fa.obj, e, outer, has_outer, site, fx, acc);
    for a in c.args {
      acc = lu_method_arg(a, e, outer, has_outer, site, fx, acc);
    }
    return acc;
  }
  let cname: string = ow_ident_name(c.callee);
  if (cname.len() == 0 || util.has_str(fx.params, cname) || !ow_is_own_func(fx.ofuncs, cname)) {
    for a in c.args {
      acc = lu_method_arg(a, e, outer, has_outer, site, fx, acc);
    }
    return acc;
  }
  let flags: boolean[] = ow_func_flags(fx.ofuncs, cname);
  let i: i32 = 0;
  while (i < c.args.len() && i < flags.len()) {
    if (flags[i]) {
      if let ast.ExprIdent(aid) = c.args[i] {
        if (lu_dies(fx, e, lu_arr_position(fx, cname, i), aid, outer, has_outer, site)) {
          acc = acc.append(lu_key(aid.line, aid.col));
        }
      }
    }
    i = i + 1;
  }
  return acc;
}

function lu_method_arg(a: ast.Expr, e: ast.Expr, outer: ast.Expr, has_outer: boolean, site: LuSite, fx: LuFn, own acc: string[]): string[] {
  if let ast.ExprIdent(id) = a {
    if (lu_dies(fx, e, true, id, outer, has_outer, site)) {
      return acc.append(lu_key(id.line, id.col));
    }
    if (lu_dies(fx, e, false, id, outer, has_outer, site)) {
      return acc.append(lu_key(id.line, id.col) + "~");
    }
  }
  return acc;
}

function lu_map_lit_children(ml: ast.ExprMapLit, own out: ast.Expr[]): ast.Expr[] {
  let k: i32 = 0;
  while (k < ml.keys.len()) {
    out = out.append(ml.keys[k]);
    out = out.append(ml.vals[k]);
    k = k + 1;
  }
  return out;
}

function lu_fstring_children(fs: ast.ExprFString, own out: ast.Expr[]): ast.Expr[] {
  let k: i32 = 0;
  while (k < fs.exprs.len()) {
    if (fs.is_expr[k]) {
      out = out.append(fs.exprs[k]);
    }
    k = k + 1;
  }
  return out;
}

function lu_children(e: ast.Expr): ast.Expr[] {
  let out: ast.Expr[] = [];
  match (e) {
    ast.ExprBinary(b) => {
      out = out.append(b.left);
      out = out.append(b.right);
    },
    ast.ExprUnary(u) => {
      out = out.append(u.operand);
    },
    ast.ExprCall(c) => {
      out = out.append(c.callee);
      for a in c.args {
        out = out.append(a);
      }
    },
    ast.ExprArray(a) => {
      for el in a.elements {
        out = out.append(el);
      }
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        out = out.append(el);
      }
    },
    ast.ExprMapLit(ml) => {
      out = lu_map_lit_children(ml, out);
    },
    ast.ExprFString(fs) => {
      out = lu_fstring_children(fs, out);
    },
    ast.ExprIndex(x) => {
      out = out.append(x.array);
      out = out.append(x.index);
    },
    ast.ExprSlice(sl) => {
      out = out.append(sl.array);
      out = out.append(sl.start);
      out = out.append(sl.end);
    },
    ast.ExprStructLit(sl) => {
      if (sl.has_base) {
        out = out.append(sl.base);
      }
      for fv in sl.field_values {
        out = out.append(fv);
      }
    },
    ast.ExprFieldAccess(fa) => {
      out = out.append(fa.obj);
    },
    _ => {}
  }
  return out;
}

function lu_expr(e: ast.Expr, outer: ast.Expr, has_outer: boolean, site: LuSite, fx: LuFn, own acc: string[]): string[] {
  let o: ast.Expr = outer;
  let ho: boolean = has_outer;
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lm) = c.callee {
      if (lm.origin.len() == 0 || c.args.len() > 0) {
        return acc;
      }
      return lu_stmts(lm.body, site.in_loop, site.fresh, true, outer, has_outer, fx, acc);
    }
    acc = lu_call(c, e, outer, has_outer, site, fx, acc);
    if (!ho) {
      o = e;
      ho = true;
    }
  }
  for child in lu_children(e) {
    acc = lu_expr(child, o, ho, site, fx, acc);
  }
  return acc;
}

function lu_root(e: ast.Expr, site: LuSite, outer: ast.Expr, has_outer: boolean, fx: LuFn, own acc: string[]): string[] {
  if (has_outer) {
    return lu_expr(e, outer, true, site, fx, acc);
  }
  return lu_expr(e, e, false, site, fx, acc);
}

function lu_stmts(stmts: ast.Stmt[], in_loop: boolean, fresh0: string[], in_iife: boolean, outer: ast.Expr, has_outer: boolean, fx: LuFn, own acc: string[]): string[] {
  let fresh: string[] = fresh0;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let site: LuSite = LuSite { stmts: stmts, idx: i, in_loop: in_loop, fresh: fresh, in_iife: in_iife };
    match (stmts[i]) {
      ast.StmtVar(v) => {
        acc = lu_root(v.init, site, outer, has_outer, fx, acc);
        fresh = lu_declared(stmts[i], fresh);
      },
      ast.StmtAssign(a) => {
        acc = lu_root(a.value, site, outer, has_outer, fx, acc);
      },
      ast.StmtReturn(r) => {
        acc = lu_root(r.value, site, outer, has_outer, fx, acc);
      },
      ast.StmtExpr(x) => {
        acc = lu_root(x.value, site, outer, has_outer, fx, acc);
      },
      ast.StmtIf(f) => {
        acc = lu_root(f.cond, site, outer, has_outer, fx, acc);
        acc = lu_stmts(f.then_body, in_loop, fresh, in_iife, outer, has_outer, fx, acc);
        acc = lu_stmts(f.else_body, in_loop, fresh, in_iife, outer, has_outer, fx, acc);
      },
      ast.StmtWhile(w) => {
        acc = lu_root(w.cond, LuSite { ...site, in_loop: true, fresh: [] }, outer, has_outer, fx, acc);
        acc = lu_stmts(w.body, true, [], in_iife, outer, has_outer, fx, acc);
      },
      ast.StmtFor(fo) => {
        acc = lu_root(fo.iter, LuSite { ...site, in_loop: true, fresh: [] }, outer, has_outer, fx, acc);
        acc = lu_stmts(fo.body, true, [], in_iife, outer, has_outer, fx, acc);
      },
      ast.StmtMatch(m) => {
        acc = lu_root(m.scrutinee, site, outer, has_outer, fx, acc);
        for arm in m.arms {
          if (arm.has_guard) {
            acc = lu_root(arm.guard, site, outer, has_outer, fx, acc);
          }
          acc = lu_stmts(arm.body, in_loop, fresh, in_iife, outer, has_outer, fx, acc);
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return acc;
}

function lu_declared(st: ast.Stmt, own names: string[]): string[] {
  let facts: LuFacts = lu_fact_stmt(st, LuFacts { occ: [], vars: [], escaping: [], sels: [] });
  for d in facts.vars {
    names = names.append(d.name);
  }
  return names;
}

function lu_last_use_args(fn: parser.FuncDecl, ofuncs: OwnFuncs): string[] {
  let facts: LuFacts = LuFacts { occ: [], vars: [], escaping: [], sels: [] };
  let nested: ast.ExprLambda[] = [];
  for st in fn.body {
    facts = astwalk.fold_stmt_nodes(st, facts, lu_fact_stmt, lu_fact_expr, astwalk.descend_all);
    nested = astwalk.fold_stmt_nodes(st, nested, lu_skip_stmt, lu_nested_fn, lu_outside_nested_fn);
  }
  let fx: LuFn = LuFn { facts: facts, params: ow_param_names(fn), ofuncs: ofuncs };
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  let out: string[] = lu_stmts(fn.body, false, [], false, none, false, fx, []);
  for lm in nested {
    out = util.append_all(out, lu_last_use_args(parser.FuncDecl { ...fn, params: lm.params, body: lm.body }, ofuncs));
  }
  return out;
}

function lu_skip_stmt(st: ast.Stmt, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  return acc;
}

function lu_nested_fn(e: ast.Expr, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  if let ast.ExprLambda(lm) = e {
    if (lm.origin == ast.ORIGIN_NESTED_FN) {
      return acc.append(lm);
    }
  }
  return acc;
}

function lu_outside_nested_fn(e: ast.Expr): boolean {
  if let ast.ExprLambda(lm) = e {
    return lm.origin != ast.ORIGIN_NESTED_FN;
  }
  return true;
}

function ow_count_ident_list(list: ast.Expr[], name: string): i32 {
  let n: i32 = 0;
  for entry in list {
    n = n + ow_count_ident(entry, name);
  }
  return n;
}

function ow_count_ident(e: ast.Expr, name: string): i32 {
  function tally(n: ast.Expr, own acc: i32): i32 {
    match (n) {
      ast.ExprIdent(id) => {
        if (id.name == name) {
          return acc + 1;
        }
        return acc;
      },
      _ => {
        return acc;
      }
    }
  }
  return astwalk.fold_expr(e, 0, tally);
}

function ow_self_move_admits(target: string, value: ast.Expr, ctx: OwnCtx): boolean {
  if let ast.ExprCall(c) = value {
    let oc: OwnCall = ow_own_call(c, ctx);
    if (oc.flags.len() == 0 || ow_count_ident_list(oc.args, target) != 1) {
      return false;
    }
    let i: i32 = 0;
    while (i < oc.args.len() && i < oc.flags.len()) {
      if let ast.ExprIdent(aid) = oc.args[i] {
        if (aid.name == target) {
          return oc.flags[i];
        }
      }
      i = i + 1;
    }
  }
  return false;
}

function ow_ident_name(e: ast.Expr): string {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function ow_is_field_read(e: ast.Expr, target: string, field: string): boolean {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      return fa.field == field && ow_ident_name(fa.obj) == target;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function ow_count_field_reads(e: ast.Expr, target: string, field: string): i32 {
  function tally(n: ast.Expr, own acc: i32): i32 {
    match (n) {
      ast.ExprFieldAccess(fa) => {
        if (ow_ident_name(fa.obj) == target && (field.len() == 0 || fa.field == field)) {
          return acc + 1;
        }
        return acc;
      },
      _ => {
        return acc;
      }
    }
  }
  return astwalk.fold_expr(e, 0, tally);
}

function ow_field_move_fields(target: string, value: ast.Expr, ctx: OwnCtx): string[] {
  let out: string[] = [];
  match (value) {
    ast.ExprStructLit(sl) => {
      if (!sl.has_base || ow_ident_name(sl.base) != target) {
        return out;
      }
      if (ow_count_ident(value, target) - ow_count_field_reads(value, target, "") != 1) {
        return out;
      }
      let i: i32 = 0;
      while (i < sl.field_values.len() && i < sl.field_names.len()) {
        let fname: string = sl.field_names[i];
        match (sl.field_values[i]) {
          ast.ExprCall(c) => {
            match (c.callee) {
              ast.ExprIdent(cid) => {
                if (ow_is_own_func(ctx.ofuncs, cid.name) && ow_count_field_reads(value, target, fname) == 1) {
                  let flags: boolean[] = ow_func_flags(ctx.ofuncs, cid.name);
                  let j: i32 = 0;
                  while (j < c.args.len() && j < flags.len()) {
                    if (flags[j] && ow_is_field_read(c.args[j], target, fname)) {
                      out = out.append(target + "." + fname);
                      j = flags.len();
                    } else {
                      j = j + 1;
                    }
                  }
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
        i = i + 1;
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

struct OwnCall { args: ast.Expr[], flags: boolean[], arr: boolean[], recv: i32 }

const RECV_NONE: i32 = 0;

const RECV_METHOD: i32 = 1;

const RECV_DYN: i32 = 2;

function ow_own_call(c: ast.ExprCall, ctx: OwnCtx): OwnCall {
  let key: string = ow_method_key(c, ctx);
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (key.len() > 0) {
      let args: ast.Expr[] = [fa.obj];
      for a in c.args {
        args = args.append(a);
      }
      let row: i32 = ctx.ofuncs.names.find(key);
      let arr: boolean[] = [];
      if (row >= 0) {
        arr = ctx.ofuncs.rows[row].arr;
      }
      return OwnCall { args: args, flags: ow_func_flags(ctx.ofuncs, key), arr: arr, recv: ow_recv_kind(key) };
    }
  }
  let flags: boolean[] = ow_call_arg_flags(c.callee, ctx);
  let arr: boolean[] = [];
  if (flags.len() > 0) {
    if let typeinfo.TypeFunc(ft) = check_expr(c.callee, ctx.scope) {
      for t in ft.param_types {
        arr = arr.append(is_owned_array(t) || is_arr_view(t) || is_unknown(t));
      }
    }
  }
  return OwnCall { args: c.args, flags: flags, arr: arr, recv: RECV_NONE };
}

function ow_recv_kind(key: string): i32 {
  if (key.len() >= 4 && slice_unchecked(key, 0, 4) == "dyn ") {
    return RECV_DYN;
  }
  return RECV_METHOD;
}

function ow_arg_dies(oc: OwnCall, i: i32, ctx: OwnCtx): boolean {
  if (oc.recv == RECV_DYN || i >= oc.arr.len() || oc.arr[i]) {
    return false;
  }
  if let ast.ExprIdent(id) = oc.args[i] {
    return util.has_str(ctx.last_use, lu_key(id.line, id.col) + "~");
  }
  return false;
}

function ow_guard_call(c: ast.ExprCall, ctx: OwnCtx): util.Diag[] {
  let out: util.Diag[] = [];
  let oc: OwnCall = ow_own_call(c, ctx);
  let i: i32 = 0;
  while (i < oc.args.len() && i < oc.flags.len()) {
    let exempt: boolean = oc.recv == RECV_DYN || ow_arg_dies(oc, i, ctx);
    if (oc.flags[i] && !exempt && !ow_is_owned_expr(oc.args[i], ctx)) {
      let aline: i32 = ast.expr_line(oc.args[i]);
      let acol: i32 = ast.expr_col(oc.args[i]);
      if (aline <= 0) {
        aline = c.line;
        acol = c.col;
      }
      out = out.append(dg_at("E051", "argument to owned parameter must be an owned value (a fresh construction, another `own` parameter, or a local at its last use), not a borrowed one", aline, acol));
    }
    i = i + 1;
  }
  return out;
}

function ow_walk_call(c: ast.ExprCall, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  let d: util.Diag[] = ow_guard_call(c, ctx);
  let oc: OwnCall = ow_own_call(c, ctx);
  let m: MovedEntry[] = moved;
  if (oc.args.len() == c.args.len()) {
    let rc: OwnWalk = ru_borrow(c.callee, m, ctx);
    m = rc.moved;
    d = util.append_diags(d, rc.diags);
  }
  let i: i32 = 0;
  while (i < oc.args.len()) {
    let ra: OwnWalk = ru_borrow(oc.args[i], m, ctx);
    if (i < oc.flags.len() && oc.flags[i]) {
      ra = ru_expr(oc.args[i], m, ctx);
    }
    m = ra.moved;
    d = util.append_diags(d, ra.diags);
    i = i + 1;
  }
  return OwnWalk { moved: m, diags: d };
}

function ow_call_arg_flags(callee: ast.Expr, ctx: OwnCtx): boolean[] {
  match (callee) {
    ast.ExprIdent(id) => {
      if (util.has_str(ctx.bound, id.name)) {
        if let typeinfo.TypeFunc(ft) = check_expr(callee, ctx.scope) {
          return ft.param_own;
        }
        return [];
      }
      if (ow_is_own_func(ctx.ofuncs, id.name)) {
        return ow_func_flags(ctx.ofuncs, id.name);
      }
      return [];
    },
    _ => {
      if let typeinfo.TypeFunc(ft) = check_expr(callee, ctx.scope) {
        return ft.param_own;
      }
      return [];
    }
  }
}

function ru_borrow(e: ast.Expr, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  match (e) {
    ast.ExprIdent(id) => {
      let d: util.Diag[] = [];
      if (ow_is_owned(ctx, id.name) && ow_moved_has(moved, id.name)) {
        d = d.append(dg_at("E050", "use of owned parameter \"" + id.name + "\" after it was consumed (moved at line " + util.i32_to_string(util.pos_line(ow_moved_line(moved, id.name))) + ")", id.line, id.col));
      }
      return OwnWalk { moved: moved, diags: d };
    },
    _ => {
      return ru_expr(e, moved, ctx);
    }
  }
}

function ru_expr(e: ast.Expr, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  match (e) {
    ast.ExprIdent(id) => {
      let d: util.Diag[] = [];
      let m: MovedEntry[] = moved;
      if (ow_is_owned(ctx, id.name)) {
        if (ow_moved_has(moved, id.name)) {
          d = d.append(dg_at("E050", "use of owned parameter \"" + id.name + "\" after it was consumed (moved at line " + util.i32_to_string(util.pos_line(ow_moved_line(moved, id.name))) + ")", id.line, id.col));
        } else {
          m = ow_moved_add(moved, id.name, id.line);
        }
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprFieldAccess(fa) => {
      return ru_borrow(fa.obj, moved, ctx);
    },
    ast.ExprIndex(ix) => {
      let r1: OwnWalk = ru_borrow(ix.array, moved, ctx);
      let r2: OwnWalk = ru_expr(ix.index, r1.moved, ctx);
      return OwnWalk { moved: r2.moved, diags: util.append_diags(r1.diags, r2.diags) };
    },
    ast.ExprSlice(sl) => {
      let r1: OwnWalk = ru_borrow(sl.array, moved, ctx);
      let r2: OwnWalk = ru_expr(sl.start, r1.moved, ctx);
      let r3: OwnWalk = ru_expr(sl.end, r2.moved, ctx);
      return OwnWalk { moved: r3.moved, diags: util.append_diags(util.append_diags(r1.diags, r2.diags), r3.diags) };
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() == 0 && c.args.len() == 0) {
            return ow_stmts(ow_value_block_stmts(lm), moved, ctx);
          }
        },
        _ => {}
      }
      return ow_walk_call(c, moved, ctx);
    },
    ast.ExprBinary(b) => {
      let r1: OwnWalk = ru_expr(b.left, moved, ctx);
      let r2: OwnWalk = ru_expr(b.right, r1.moved, ctx);
      return OwnWalk { moved: r2.moved, diags: util.append_diags(r1.diags, r2.diags) };
    },
    ast.ExprUnary(u) => {
      return ru_expr(u.operand, moved, ctx);
    },
    ast.ExprArray(a) => {
      let m: MovedEntry[] = moved;
      let d: util.Diag[] = [];
      for element in a.elements {
        let r: OwnWalk = ru_expr(element, m, ctx);
        m = r.moved;
        d = util.append_diags(d, r.diags);
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprTuple(t) => {
      let m: MovedEntry[] = moved;
      let d: util.Diag[] = [];
      for element in t.elements {
        let r: OwnWalk = ru_expr(element, m, ctx);
        m = r.moved;
        d = util.append_diags(d, r.diags);
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprStructLit(s) => {
      let m: MovedEntry[] = moved;
      let d: util.Diag[] = [];
      if (s.has_base) {
        let rb: OwnWalk = ru_borrow(s.base, m, ctx);
        m = rb.moved;
        d = util.append_diags(d, rb.diags);
      }
      for field_value in s.field_values {
        let r: OwnWalk = ru_expr(field_value, m, ctx);
        m = r.moved;
        d = util.append_diags(d, r.diags);
      }
      return OwnWalk { moved: m, diags: d };
    },
    ast.ExprLambda(lm) => {
      let lctx: OwnCtx = ow_nested_ctx(ctx, lm);
      let inner: OwnWalk = ow_stmts(lm.body, ow_nested_moved(moved, lm.params), lctx);
      return OwnWalk { moved: moved, diags: inner.diags };
    },
    _ => {
      return OwnWalk { moved: moved, diags: [] };
    }
  }
}

function ow_value_block_stmts(lm: ast.ExprLambda): ast.Stmt[] {
  if (lm.origin == parser.ORIGIN_BLOCK) {
    return ow_branch_stmts(lm.body);
  }
  if (lm.origin != parser.ORIGIN_IF_EXPR && lm.origin != parser.ORIGIN_MATCH_EXPR) {
    return lm.body;
  }
  let out: ast.Stmt[] = [];
  for st in lm.body {
    out = out.append(ow_value_arms(st));
  }
  return out;
}

function ow_value_arms(st: ast.Stmt): ast.Stmt {
  match (st) {
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      for arm in m.arms {
        arms = arms.append(ast.MatchArm { ...arm, body: ow_branch_stmts(arm.body) });
      }
      return ast.StmtMatch { ...m, arms: arms };
    },
    ast.StmtIf(f) => {
      let els: ast.Stmt[] = ow_branch_stmts(f.else_body);
      if (f.else_body.len() == 1) {
        if let ast.StmtIf(_) = f.else_body[0] {
          els = [ow_value_arms(f.else_body[0])];
        }
      }
      return ast.StmtIf { ...f, then_body: ow_branch_stmts(f.then_body), else_body: els };
    },
    _ => {
      return st;
    }
  }
}

function ow_branch_stmts(body: ast.Stmt[]): ast.Stmt[] {
  if (mx_branch_yields(body)) {
    return body;
  }
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    out = out.append(body[i]);
    i = i + 1;
  }
  return out;
}

function ow_loop(body: ast.Stmt[], moved: MovedEntry[], ctx: OwnCtx): util.Diag[] {
  let r: OwnWalk = ow_stmts(body, moved, ctx);
  let out: util.Diag[] = r.diags;
  for elem in r.moved {
    let nm: string = elem.mname;
    if (!ow_moved_has(moved, nm)) {
      out = out.append(dg_at("E050", "owned parameter \"" + nm + "\" is consumed inside a loop; a later iteration would use it after move", elem.mline, 0));
    }
  }
  return out;
}

function ow_stmt(st: ast.Stmt, moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  match (st) {
    ast.StmtVar(v) => {
      return ru_expr(v.init, moved, ctx);
    },
    ast.StmtReturn(r) => {
      let rctx: OwnCtx = ctx;
      match (r.value) {
        ast.ExprStructLit(sl) => {
          if (sl.has_base) {
            let base: string = ow_ident_name(sl.base);
            if (base.len() > 0 && !util.has_str(ctx.borrowed, base)) {
              rctx = OwnCtx { ...ctx, admit_fields: ow_field_move_fields(base, r.value, ctx) };
            }
          }
        },
        _ => {}
      }
      return ru_expr(r.value, moved, rctx);
    },
    ast.StmtExpr(e) => {
      return ru_expr(e.value, moved, ctx);
    },
    ast.StmtAssign(a) => {
      let actx: OwnCtx = ctx;
      if (!ow_is_owned(ctx, a.target) && ow_self_move_admits(a.target, a.value, ctx)) {
        actx = OwnCtx { ...ctx, admit: a.target };
      }
      if (!util.has_str(ctx.borrowed, a.target)) {
        actx = OwnCtx { ...actx, admit_fields: ow_field_move_fields(a.target, a.value, ctx) };
      }
      let rv: OwnWalk = ru_expr(a.value, moved, actx);
      if (ow_is_owned(ctx, a.target)) {
        return OwnWalk { moved: ow_moved_del(rv.moved, a.target), diags: rv.diags };
      }
      return rv;
    },
    ast.StmtIf(f) => {
      if (f.origin == "block") {
        return ow_stmts(f.then_body, moved, ctx);
      }
      let rc: OwnWalk = ru_expr(f.cond, moved, ctx);
      let rt: OwnWalk = ow_stmts(f.then_body, rc.moved, ctx);
      let re: OwnWalk = ow_stmts(f.else_body, rc.moved, ctx);
      let m: MovedEntry[] = ow_moved_join(rc.moved, rt.moved, block_diverges(f.then_body, util.has_str(ctx.bound, "exit")));
      m = ow_moved_join(m, re.moved, f.else_body.len() > 0 && block_diverges(f.else_body, util.has_str(ctx.bound, "exit")));
      return OwnWalk { moved: m, diags: util.append_diags(util.append_diags(rc.diags, rt.diags), re.diags) };
    },
    ast.StmtWhile(w) => {
      let rc: OwnWalk = ru_expr(w.cond, moved, ctx);
      let ld: util.Diag[] = ow_loop(w.body, rc.moved, ctx);
      return OwnWalk { moved: rc.moved, diags: util.append_diags(rc.diags, ld) };
    },
    ast.StmtFor(fr) => {
      let ri: OwnWalk = ru_borrow(fr.iter, moved, ctx);
      let fctx: OwnCtx = ow_bind_ctx(ctx, fr.var_name);
      let ld: util.Diag[] = ow_loop(fr.body, ri.moved, OwnCtx { ...fctx, scope: for_body_scope(fr, ctx.scope) });
      return OwnWalk { moved: ri.moved, diags: util.append_diags(ri.diags, ld) };
    },
    ast.StmtMatch(m) => {
      let scrut_owned: boolean = ow_is_owned_scrutinee(m.scrutinee, ctx);
      let rs: OwnWalk = ru_expr(m.scrutinee, moved, ctx);
      if let ast.ExprIdent(sid) = m.scrutinee {
        let takes: boolean = false;
        for arm in m.arms {
          takes = takes || ow_arm_takes_pointer(ctx, arm.pattern);
        }
        if (!takes) {
          rs = OwnWalk { ...rs, moved: ow_unmove(rs.moved, moved, sid.name) };
        }
      }
      let mv: MovedEntry[] = rs.moved;
      let d: util.Diag[] = rs.diags;
      let whole: typeinfo.Type = check_expr(m.scrutinee, ctx.scope);
      for arm in m.arms {
        let actx: OwnCtx = ow_arm_bind_ctx(ctx, arm.pattern);
        actx = OwnCtx { ...actx, scope: annotate_arm_scope(arm, ctx.scope, whole) };
        if (scrut_owned) {
          actx = ow_arm_payload_ctx(actx, arm.pattern);
        } else {
          actx = ow_arm_lent_ctx(actx, arm.pattern);
        }
        let ra: OwnWalk = ow_stmts(arm.body, rs.moved, actx);
        d = util.append_diags(d, ra.diags);
        mv = ow_moved_join(mv, ra.moved, block_diverges(arm.body, ow_exit_bound(ctx, arm.pattern)));
      }
      return OwnWalk { moved: mv, diags: d };
    },
    ast.StmtDefer(dd) => {
      let one: ast.Stmt[] = [dd.action];
      return ow_stmts(one, moved, ctx);
    },
    _ => {
      return OwnWalk { moved: moved, diags: [] };
    }
  }
}

function ow_stmts(stmts: ast.Stmt[], moved: MovedEntry[], ctx: OwnCtx): OwnWalk {
  let m: MovedEntry[] = moved;
  let d: util.Diag[] = [];
  let c: OwnCtx = ctx;
  for stmt in stmts {
    let r: OwnWalk = ow_stmt(stmt, m, c);
    m = r.moved;
    d = util.append_diags(d, r.diags);
    if let ast.StmtVar(v) = stmt {
      c = ow_bind_ctx(c, v.name);
    }
    c = OwnCtx { ...c, scope: bind_stmt(stmt, c.scope) };
  }
  return OwnWalk { moved: m, diags: d };
}

function ow_moved_del(m: MovedEntry[], name: string): MovedEntry[] {
  let out: MovedEntry[] = [];
  for elem in m {
    if (elem.mname != name) {
      out = out.append(elem);
    }
  }
  return out;
}

function ow_param_names(fn: parser.FuncDecl): string[] {
  let out: string[] = [];
  for p in fn.params {
    out = out.append(p.name);
  }
  return out;
}

function ow_exit_bound(ctx: OwnCtx, pat: ast.Pattern): boolean {
  return util.has_str(ctx.bound, "exit") || pattern_binds_exit(pat);
}

function ow_arm_bind_ctx(ctx: OwnCtx, pat: ast.Pattern): OwnCtx {
  if let ast.PatVariant(pv) = pat {
    let c: OwnCtx = ctx;
    if (pv.binding.len() > 0) {
      c = ow_bind_ctx(c, pv.binding);
    }
    for extra in pv.extra_bindings {
      c = ow_bind_ctx(c, extra);
    }
    return c;
  }
  return ctx;
}

function ow_bind_ctx(ctx: OwnCtx, name: string): OwnCtx {
  if (name.len() == 0) {
    return ctx;
  }
  if (util.has_str(ctx.bound, name)) {
    return ctx;
  }
  return OwnCtx { ...ctx, bound: ctx.bound.append(name) };
}

function ow_arm_lent_ctx(ctx: OwnCtx, pat: ast.Pattern): OwnCtx {
  if let ast.PatVariant(pv) = pat {
    let borrowed: string[] = ctx.borrowed;
    if (pv.binding.len() > 0 && pv.binding != "_" && !util.has_str(borrowed, pv.binding)) {
      borrowed = borrowed.append(pv.binding);
    }
    for extra in pv.extra_bindings {
      if (extra.len() > 0 && extra != "_" && !util.has_str(borrowed, extra)) {
        borrowed = borrowed.append(extra);
      }
    }
    return OwnCtx { ...ctx, borrowed: borrowed };
  }
  return ctx;
}

function ow_unmove(after: MovedEntry[], before: MovedEntry[], name: string): MovedEntry[] {
  let out: MovedEntry[] = [];
  for e in after {
    let kept: boolean = e.mname != name;
    for b in before {
      kept = kept || b.mname == e.mname && b.mline == e.mline;
    }
    if (kept) {
      out = out.append(e);
    }
  }
  return out;
}

function ow_arm_takes_pointer(ctx: OwnCtx, pat: ast.Pattern): boolean {
  let bound: OwnCtx = ow_arm_payload_ctx(OwnCtx { ...ctx, owned: [] }, pat);
  for n in bound.owned {
    if (n != "_") {
      return true;
    }
  }
  return false;
}

function ow_arm_payload_ctx(ctx: OwnCtx, pat: ast.Pattern): OwnCtx {
  if let ast.PatVariant(pv) = pat {
    let vname: string = util.base_type_name(pv.type_name);
    let di: i32 = 0;
    let dot: i32 = 0 - 1;
    while (di < vname.len()) {
      if (vname[di] == b'.') {
        dot = di;
      }
      di = di + 1;
    }
    if (dot >= 0) {
      vname = slice_unchecked(vname, dot + 1, vname.len()) + "";
    }
    let binds: string[] = [];
    if (pv.binding.len() > 0) {
      binds = binds.append(pv.binding);
    }
    for extra in pv.extra_bindings {
      binds = binds.append(extra);
    }
    if (binds.len() == 0) {
      return ctx;
    }
    let names: string[] = ctx.owned;
    for sd in ctx.structs {
      if (sd.name == vname && sd.enum_owner.len() == 0) {
        if (binds[0] != "_" && !util.has_str(names, binds[0])) {
          names = names.append(binds[0]);
        }
      } else if (sd.name == vname && sd.enum_owner.len() > 0) {
        let i: i32 = 0;
        while (i < binds.len() && i < sd.fields.len()) {
          if (binds[i].len() > 0 && binds[i] != "_" && ow_type_is_pointer_name(sd.fields[i].type_name, ctx.ofuncs)
            && !util.has_str(names, binds[i])) {
            names = names.append(binds[i]);
          }
          i = i + 1;
        }
      }
    }
    return OwnCtx { ...ctx, owned: names };
  }
  return ctx;
}

function collect_own_funcs(mod: parser.Module): OwnFuncs {
  let out: OwnFunc[] = [];
  let names: string[] = [];
  let methods: string[] = [];
  let funcs: string[] = [];
  for func in mod.funcs {
    if (func.receiver_name.len() == 0) {
      funcs = funcs.append(func.name);
    }
    let any_own: boolean = func.receiver_own;
    let flags: boolean[] = [];
    let arr: boolean[] = [];
    if (func.receiver_name.len() > 0) {
      flags = flags.append(func.receiver_own);
      arr = arr.append(ow_type_is_array(func.receiver_type));
    }
    for param in func.params {
      let o: boolean = param.own;
      flags = flags.append(o);
      arr = arr.append(ow_type_is_array(param.type_name));
      if (o) {
        any_own = true;
      }
    }
    if (any_own && func.receiver_name.len() == 0) {
      out = out.append(OwnFunc { name: func.name, flags: flags, arr: arr });
      names = names.append(func.name);
    } else if (any_own) {
      let key: string = ow_receiver_ns(func.receiver_type) + "." + func.name;
      out = out.append(OwnFunc { name: key, flags: flags, arr: arr });
      names = names.append(key);
      methods = methods.append(func.name);
    }
  }
  for td in mod.trait_decls {
    for m in td.methods {
      if (ow_takes_own_self(m)) {
        let row: OwnFunc = ow_trait_row(td.name, m);
        out = out.append(row);
        names = names.append(row.name);
        methods = methods.append(m.name);
      }
    }
  }
  let structs: string[] = [];
  let ctors: string[] = [];
  for sd in mod.structs {
    structs = structs.append(sd.name);
    ctors = ctors.append(sd.name);
    if (sd.enum_owner.len() > 0) {
      structs = structs.append(sd.enum_owner);
    }
  }
  let decls: string[] = [];
  for ed in mod.enums {
    decls = decls.append(ed.name);
  }
  for alias in mod.aliases {
    decls = decls.append(alias.name);
  }
  return OwnFuncs { rows: out, names: util.name_index(names), structs: util.name_index(structs), decls: util.name_index(decls), ctors: util.name_index(ctors), methods: util.name_index(methods), funcs: util.name_index(funcs) };
}

function ow_takes_own_self(m: parser.FuncDecl): boolean {
  return m.params.len() > 0 && m.params[0].name == "self" && m.params[0].own;
}

function ow_trait_row(tname: string, m: parser.FuncDecl): OwnFunc {
  let flags: boolean[] = [];
  let arr: boolean[] = [];
  for param in m.params {
    flags = flags.append(param.own);
    arr = arr.append(ow_type_is_array(param.type_name));
  }
  return OwnFunc { name: "dyn " + tname + "." + m.name, flags: flags, arr: arr };
}

function ow_receiver_ns(rt: string): string {
  if (parser.spelling_is_view(rt)) {
    return "[_]";
  }
  if (array_receiver_matches(rt, false)) {
    return "[]";
  }
  return util.base_type_name(receiver_namespace(rt));
}

function ow_type_is_array(tn: string): boolean {
  return tn.len() >= 2 && tn[tn.len() - 2] == b'[' && tn[tn.len() - 1] == b']';
}

function ow_method_key(c: ast.ExprCall, ctx: OwnCtx): string {
  if let ast.ExprFieldAccess(fa) = c.callee {
    for ns in ow_type_namespaces(check_expr(fa.obj, ctx.scope)) {
      let key: string = ns + "." + fa.field;
      if (ow_is_own_func(ctx.ofuncs, key)) {
        return key;
      }
    }
  }
  return "";
}

function ow_type_namespaces(t: typeinfo.Type): string[] {
  match (t) {
    typeinfo.TypeStruct(st) => {
      return [st.name];
    },
    typeinfo.TypeUnion(u) => {
      return [u.name];
    },
    typeinfo.TypeArray(a) => {
      if (a.view) {
        return ["[_]"];
      }
      return ["[]"];
    },
    typeinfo.TypeString(_) => {
      return ["string"];
    },
    typeinfo.TypeMap(_) => {
      return ["Map"];
    },
    typeinfo.TypeDyn(d) => {
      let out: string[] = [];
      for n in parser.dyn_trait_set("dyn " + d.traits) {
        out = out.append("dyn " + n);
      }
      return out;
    },
    _ => {
      if (!is_unknown(t)) {
        return [ow_receiver_ns(type_label(t))];
      }
      return [];
    }
  }
  let none: string[] = [];
  return none;
}

function ow_type_is_pointer_name(tn: string, ofuncs: OwnFuncs): boolean {
  if (tn.len() == 0 || tn == "void") {
    return false;
  }
  if (tn == "string" || tn == "str" || tn == "fn") {
    return true;
  }
  if (tn[tn.len() - 1] == b']') {
    return true;
  }
  if (tn[0] == b'(') {
    return true;
  }
  if (tn.len() >= 4 && slice_unchecked(tn, 0, 4) == "dyn ") {
    return true;
  }
  let base: string = util.base_type_name(tn);
  if (parser.is_reserved_struct_name(base) || parser.is_reserved_enum_name(base)) {
    return true;
  }
  return ofuncs.structs.has(base);
}

function ow_type_is_pointer(tn: string, ofuncs: OwnFuncs): boolean {
  if (ow_type_is_pointer_name(tn, ofuncs)) {
    return true;
  }
  return ofuncs.decls.has(util.base_type_name(tn));
}

function ow_collect_stmt(st: ast.Stmt, own acc: ast.Stmt[]): ast.Stmt[] {
  return acc.append(st);
}

function ow_spine_stmts(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for st in body {
    out = astwalk.fold_stmt_spine(st, out, ow_collect_stmt);
  }
  return out;
}

function ow_borrowed_params(fn: parser.FuncDecl, mod: parser.Module, ofuncs: OwnFuncs): string[] {
  let flags: boolean[] = ow_func_flags(ofuncs, fn.name);
  let out: string[] = [];
  let i: i32 = 0;
  while (i < fn.params.len()) {
    if (ow_decl_type_is_pointer(fn, fn.params[i].type_name, ofuncs)) {
      if (i >= flags.len() || !flags[i]) {
        out = out.append(fn.params[i].name);
      }
    }
    i = i + 1;
  }
  return out;
}

function ow_decl_type_is_pointer(fn: parser.FuncDecl, tn: string, ofuncs: OwnFuncs): boolean {
  return util.has_str(fn.all_type_params, tn) || ow_type_is_pointer(tn, ofuncs);
}

function ow_sig_type_is_pointer(fn: parser.FuncDecl, tn: string, ofuncs: OwnFuncs): boolean {
  return !util.has_str(fn.all_type_params, tn) && ow_type_is_pointer(tn, ofuncs);
}

function ow_elem_type_name(tn: string): string {
  let n: i32 = tn.len();
  if (n > 2 && tn[n - 2] == b'[' && tn[n - 1] == b']') {
    return slice_unchecked(tn, 0, n - 2) + "";
  }
  if (n > 2 && tn[0] == b'[' && tn[n - 1] == b']') {
    return slice_unchecked(tn, 1, n - 1) + "";
  }
  return "";
}

function ow_value_elem_params(fn: parser.FuncDecl, borrowed: string[], ofuncs: OwnFuncs): string[] {
  let out: string[] = [];
  for p in fn.params {
    let elem: string = ow_elem_type_name(p.type_name);
    if (util.has_str(borrowed, p.name) && elem.len() > 0 && !ow_type_is_pointer(elem, ofuncs)) {
      out = out.append(p.name);
    }
  }
  return out;
}

function ow_call_may_borrow(c: ast.ExprCall, ofuncs: OwnFuncs, borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if let ast.ExprIdent(cid) = c.callee {
    if (ofuncs.ctors.has(cid.name)) {
      return false;
    }
    if (builtins.has(cid.name)) {
      return false;
    }
    return borrows.has(cid.name) || !ofuncs.funcs.has(cid.name);
  }
  return true;
}

function ow_value_block_call(c: ast.ExprCall, lm: ast.ExprLambda): boolean {
  if (c.args.len() > 0 || lm.params.len() > 0) {
    return false;
  }
  return lm.origin == parser.ORIGIN_IF_EXPR || lm.origin == parser.ORIGIN_MATCH_EXPR || lm.origin == parser.ORIGIN_BLOCK;
}

function ow_value_if_origin(origin: string): boolean {
  return origin == parser.ORIGIN_IF_EXPR || origin == parser.ORIGIN_IF_DEAD_THEN || origin == parser.ORIGIN_IF_DEAD_ELSE || origin == parser.ORIGIN_IF_DEAD_BOTH;
}

function ow_value_block_borrows(lm: ast.ExprLambda, ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if (lm.origin != parser.ORIGIN_IF_EXPR || lm.body.len() != 1) {
    return true;
  }
  return ow_value_arm_borrows(lm.body, ofuncs, borrowed, locals, values, borrows, builtins);
}

function ow_value_arm_borrows(arm: ast.Stmt[], ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if (arm.len() != 1) {
    return true;
  }
  match (arm[0]) {
    ast.StmtReturn(r) => {
      return ow_expr_borrows(r.value, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.StmtIf(f) => {
      if (!ow_value_if_origin(f.origin) || f.sugar.origin.len() > 0) {
        return true;
      }
      return ow_value_arm_borrows(f.then_body, ofuncs, borrowed, locals, values, borrows, builtins) || ow_value_arm_borrows(f.else_body, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    _ => {
      return true;
    }
  }
}

function ow_expr_borrows(e: ast.Expr, ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  match (e) {
    ast.ExprBytes(_) => {
      return false;
    },
    ast.ExprNumber(_) => {
      return false;
    },
    ast.ExprString(_) => {
      return false;
    },
    ast.ExprBool(_) => {
      return false;
    },
    ast.ExprFString(_) => {
      return false;
    },
    ast.ExprUnknown(_) => {
      return false;
    },
    ast.ExprZero(_) => {
      return false;
    },
    ast.ExprLambda(_) => {
      return false;
    },
    ast.ExprStructLit(_) => {
      return false;
    },
    ast.ExprArray(_) => {
      return false;
    },
    ast.ExprTuple(_) => {
      return false;
    },
    ast.ExprMapLit(_) => {
      return false;
    },
    ast.ExprBinary(_) => {
      return false;
    },
    ast.ExprUnary(_) => {
      return false;
    },
    ast.ExprIdent(id) => {
      return util.has_str(borrowed, id.name) || util.has_str(locals, id.name);
    },
    ast.ExprFieldAccess(fa) => {
      return ow_expr_borrows(fa.obj, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.ExprIndex(ix) => {
      if let ast.ExprIdent(aid) = ix.array {
        if (util.has_str(values, aid.name)) {
          return false;
        }
      }
      return ow_expr_borrows(ix.array, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.ExprSlice(sl) => {
      return ow_expr_borrows(sl.array, ofuncs, borrowed, locals, values, borrows, builtins);
    },
    ast.ExprCall(c) => {
      return ow_call_borrows(c, ofuncs, borrowed, locals, values, borrows, builtins);
    }
  }
}

function ow_call_borrows(c: ast.ExprCall, ofuncs: OwnFuncs, borrowed: string[], locals: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  if let ast.ExprLambda(lm) = c.callee {
    if (ow_value_block_call(c, lm)) {
      return ow_value_block_borrows(lm, ofuncs, borrowed, locals, values, borrows, builtins);
    }
  }
  if (!ow_call_may_borrow(c, ofuncs, borrows, builtins)) {
    return false;
  }
  for a in c.args {
    if (ow_expr_borrows(a, ofuncs, borrowed, locals, values, borrows, builtins)) {
      return true;
    }
  }
  return false;
}

function ow_borrowed_locals(spine: ast.Stmt[], ofuncs: OwnFuncs, borrowed: string[], values: string[], borrows: util.NameIndex, builtins: util.NameIndex): string[] {
  let locals: string[] = [];
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for st in spine {
      let name: string = "";
      let init: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
      if let ast.StmtVar(v) = st {
        name = v.name;
        init = v.init;
      }
      if let ast.StmtAssign(a) = st {
        name = a.target;
        init = a.value;
      }
      if (name.len() == 0 || util.has_str(locals, name)) {
        continue;
      }
      if (ow_expr_borrows(init, ofuncs, borrowed, locals, values, borrows, builtins)) {
        locals = locals.append(name);
        changed = true;
      }
    }
  }
  return locals;
}

function ow_func_result_borrows(fn: parser.FuncDecl, mod: parser.Module, ofuncs: OwnFuncs, borrows: util.NameIndex, builtins: util.NameIndex): boolean {
  let borrowed: string[] = ow_borrowed_params(fn, mod, ofuncs);
  if (borrowed.len() == 0) {
    return false;
  }
  let values: string[] = ow_value_elem_params(fn, borrowed, ofuncs);
  let spine: ast.Stmt[] = ow_spine_stmts(fn.body);
  let locals: string[] = ow_borrowed_locals(spine, ofuncs, borrowed, values, borrows, builtins);
  for st in spine {
    if let ast.StmtReturn(r) = st {
      if (ow_expr_borrows(r.value, ofuncs, borrowed, locals, values, borrows, builtins)) {
        return true;
      }
    }
  }
  return false;
}

function ow_fresh_builtins(): string[] {
  let out: string[] = [
    "__primitive_char_to_string", "__primitive_f32_to_string", "__primitive_f64_to_string", "__primitive_i32_to_string", "__primitive_i64_to_string", "__primitive_u32_to_string", "__primitive_u64_to_string", "__primitive_u8_to_string", "__primitive_usize_to_string",
    "__alloc_bool", "__alloc_i32", "__alloc_i64", "__alloc_u8", "__task_wait", "args", "buf_take", "buf_take_bytes", "cell_new", "clock_set", "environ", "getcwd", "getgroups",
    "hostname", "map_new", "mounts", "pipe", "random_bytes", "set_priority",
    "setgid", "setuid",
    "signal_send", "set_extproc", "set_process_group", "set_window_size",
    "stderr", "stdin", "stdout", "target_arch", "target_os",
    "termios_get", "uname_field", "window_size",
    "__bytes_owned", "__bytes_range", "__bytes_into", "__aes_expand_key", "__aes_ctr32", "__ghash", "__aes_gcm_seal", "__aes_gcm_open", "__sha256_hw_blocks", "__sha1_hw_blocks",
  ];
  return out;
}

function ow_signature_fresh_owners(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex): string[] {
  let out: string[] = builtins.names;
  for fn in mod.funcs {
    if (fn.receiver_name.len() > 0 || !ow_sig_type_is_pointer(fn, fn.ret_type, ofuncs)) {
      continue;
    }
    let flags: boolean[] = ow_func_flags(ofuncs, fn.name);
    let any_ptr: boolean = false;
    let all_own: boolean = true;
    let i: i32 = 0;
    while (i < fn.params.len()) {
      if (ow_sig_type_is_pointer(fn, fn.params[i].type_name, ofuncs)) {
        any_ptr = true;
        if (i >= flags.len() || !flags[i]) {
          all_own = false;
        }
      }
      i = i + 1;
    }
    if (!any_ptr || all_own) {
      out = out.append(fn.name);
    }
  }
  return out;
}

function ow_result_borrows(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex): util.NameIndex {
  let none: string[] = [];
  let borrows: util.NameIndex = util.name_index(none);
  let pending: parser.FuncDecl[] = [];
  let pnames: string[] = [];
  for fn in mod.funcs {
    if (fn.receiver_name.len() > 0) {
      continue;
    }
    if (ow_decl_type_is_pointer(fn, fn.ret_type, ofuncs)) {
      pending = pending.append(fn);
      pnames = pnames.append(fn.name);
    }
  }
  let pindex: util.NameIndex = util.name_index(pnames);
  let calls: string[][] = [];
  for fn in pending {
    calls = calls.append(ow_calls_to(fn, pindex));
  }
  let first: boolean = true;
  let marked: util.NameIndex = util.name_index(none);
  while (first || marked.names.len() > 0) {
    let now_marked: string[] = [];
    let unmarked: parser.FuncDecl[] = [];
    let unmarked_calls: string[][] = [];
    let i: i32 = 0;
    while (i < pending.len()) {
      let fn: parser.FuncDecl = pending[i];
      if ((first || ow_calls_any(calls[i], marked)) && ow_func_result_borrows(fn, mod, ofuncs, borrows, builtins)) {
        borrows = borrows.added(fn.name);
        now_marked = now_marked.append(fn.name);
      } else {
        unmarked = unmarked.append(fn);
        unmarked_calls = unmarked_calls.append(calls[i]);
      }
      i = i + 1;
    }
    first = false;
    marked = util.name_index(now_marked);
    pending = unmarked;
    calls = unmarked_calls;
  }
  return borrows;
}

function ow_calls_to(fn: parser.FuncDecl, names: util.NameIndex): string[] {
  let hits: astwalk.CallSite[] = [];
  for st in fn.body {
    hits = astwalk.collect_calls_stmt(st, names, hits);
  }
  let out: string[] = [];
  for h in hits {
    out = out.append(h.name);
  }
  return out;
}

function ow_calls_any(callees: string[], names: util.NameIndex): boolean {
  for n in callees {
    if (names.has(n)) {
      return true;
    }
  }
  return false;
}

function ow_fresh_owners(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex, borrows: util.NameIndex): string[] {
  let out: string[] = builtins.names;
  for fn in mod.funcs {
    if (fn.receiver_name.len() > 0 || !ow_sig_type_is_pointer(fn, fn.ret_type, ofuncs)) {
      continue;
    }
    if (borrows.has(fn.name)) {
      continue;
    }
    out = out.append(fn.name);
  }
  return out;
}

// The receiver namespace and method name identify a fresh method.
function ow_fresh_methods(mod: parser.Module, ofuncs: OwnFuncs, builtins: util.NameIndex, borrows: util.NameIndex): string[] {
  let out: string[] = [];
  let refused: string[] = [];
  for fn in mod.funcs {
    if (fn.receiver_name.len() == 0 || fn.type_params.len() > 0) {
      continue;
    }
    if (!ow_type_is_pointer(fn.ret_type, ofuncs)) {
      continue;
    }
    let key: string = ow_receiver_ns(fn.receiver_type) + "." + fn.name;
    if (ow_func_result_borrows(fn, mod, ofuncs, borrows, builtins)) {
      refused = refused.append(key);
    } else {
      out = out.append(key);
    }
  }
  let kept: string[] = [];
  for name in out {
    if (!util.has_str(refused, name)) {
      kept = kept.append(name);
    }
  }
  return kept;
}

pub function own_diags(mod: parser.Module, env: ModuleEnv, focus: util.NameIndex): util.Diag[] {
  let ofuncs: OwnFuncs = collect_own_funcs(mod);
  let builtins: util.NameIndex = util.name_index(ow_fresh_builtins());
  let borrows: util.NameIndex = ow_result_borrows(mod, ofuncs, builtins);
  let fresh: string[] = ow_fresh_owners(mod, ofuncs, builtins, borrows);
  let fresh_methods: string[] = ow_fresh_methods(mod, ofuncs, builtins, borrows);
  let fresh_scrut: string[] = ow_signature_fresh_owners(mod, ofuncs, builtins);
  let snames: util.NameIndex = util.name_index(ow_struct_names(mod.structs));
  let out: util.Diag[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    let owned: string[] = [];
    let borrowed: string[] = [];
    if (fn.receiver_own && ow_ownable_type(fn.receiver_type)) {
      owned = owned.append(fn.receiver_name);
    }
    for param in fn.params {
      if (param.own && ow_ownable_type(param.type_name)) {
        owned = owned.append(param.name);
      } else {
        borrowed = borrowed.append(param.name);
      }
    }
    let ctx: OwnCtx = OwnCtx { owned: owned, borrowed: borrowed, ofuncs: ofuncs, structs: mod.structs, snames: snames, admit: "", admit_fields: [], fresh: fresh, fresh_methods: fresh_methods, fresh_scrut: fresh_scrut, bound: ow_param_names(fn), scope: build_func_scope(fn, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs), last_use: lu_last_use_args(fn, ofuncs) };
    let nomoved: MovedEntry[] = [];
    let r: OwnWalk = ow_stmts(fn.body, nomoved, ctx);
    out = util.append_diags(out, r.diags);
  }
  return out;
}

struct NameTy { nm: string, ty: string }

function e049_append_nt(a: NameTy[], b: NameTy[]): NameTy[] {
  let out: NameTy[] = a;
  for elem in b {
    out = out.append(elem);
  }
  return out;
}

function e049_is_ref(tn: string): boolean {
  if (tn.len() == 0) {
    return false;
  }
  if (tn == "i32" || tn == "i64" || tn == "u8" || tn == "u32" || tn == "u64" || tn == "usize" || tn == "boolean" || tn == "f64" || tn == "f32" || tn == "char") {
    return false;
  }
  return true;
}

function e049_ref_capture(enclosing: NameTy[], name: string): boolean {
  for elem in enclosing {
    if (elem.nm == name) {
      return e049_is_ref(elem.ty);
    }
  }
  return false;
}

function e049_capture_label(enclosing: NameTy[], name: string): string {
  for elem in enclosing {
    if (elem.nm == name && elem.ty != "__e049_ref") {
      return util.demangle(elem.ty) + " ";
    }
  }
  return "";
}

function e049_init_ref_ty(init: ast.Expr): string {
  match (init) {
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprArray(_) => {
      return "__e049_ref";
    },
    ast.ExprStructLit(_) => {
      return "__e049_ref";
    },
    ast.ExprTuple(_) => {
      return "__e049_ref";
    },
    _ => {
      return "";
    }
  }
  return "";
}

function e049_scope(stmts: ast.Stmt[]): NameTy[] {
  let out: NameTy[] = [];
  for stmt in stmts {
    for vb in e049_value_blocks(stmt) {
      out = e049_append_nt(out, e049_scope(vb.body));
    }
    match (stmt) {
      ast.StmtVar(v) => {
        let vty: string = v.type_name;
        if (vty.len() == 0) {
          vty = e049_init_ref_ty(v.init);
        }
        out = out.append(NameTy { nm: v.name, ty: vty });
      },
      ast.StmtIf(f) => {
        out = e049_append_nt(out, e049_scope(f.then_body));
        out = e049_append_nt(out, e049_scope(f.else_body));
      },
      ast.StmtWhile(w) => {
        out = e049_append_nt(out, e049_scope(w.body));
      },
      ast.StmtFor(fr) => {
        out = e049_append_nt(out, e049_scope(fr.body));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = e049_append_nt(out, e049_scope(arm.body));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = e049_append_nt(out, e049_scope(one));
      },
      _ => {}
    }
  }
  return out;
}

function e049_value_blocks(st: ast.Stmt): ast.ExprLambda[] {
  let none: ast.ExprLambda[] = [];
  return astwalk.fold_stmt_own_pruned(st, none, e049_value_block_at, e049_into_no_lambda);
}

function e049_value_block_at(n: ast.Expr, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  if let ast.ExprLambda(lm) = n {
    if (parser.is_value_block_origin(lm.origin)) {
      return acc.append(lm);
    }
  }
  return acc;
}

function e049_into_no_lambda(n: ast.Expr): boolean {
  if let ast.ExprLambda(_) = n {
    return false;
  }
  return true;
}

function e049_lambda_locals_nt(lm: ast.ExprLambda): NameTy[] {
  let out: NameTy[] = [];
  for param in lm.params {
    out = out.append(NameTy { nm: param.name, ty: param.type_name });
  }
  return e049_append_nt(out, e049_scope(lm.body));
}

function e049_nt_names(nts: NameTy[]): string[] {
  let out: string[] = [];
  for elem in nts {
    out = out.append(elem.nm);
  }
  return out;
}

function e049_stmt_own_lambdas(st: ast.Stmt, enclosing: NameTy[], locals: NameTy[]): util.Diag[] {
  let nested_encl: NameTy[] = e049_append_nt(enclosing, locals);
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        if (parser.is_value_block_origin(lm.origin)) {
          return util.append_diags(acc, e049_check_assigns(lm.body, enclosing, locals));
        }
        return util.append_diags(acc, e049_check_assigns(lm.body, nested_encl, e049_lambda_locals_nt(lm)));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_stmt_own_pruned(st, no_diags(), at_lambda, not_into_lambda);
}

function e049_check_assigns(stmts: ast.Stmt[], enclosing: NameTy[], locals: NameTy[]): util.Diag[] {
  let out: util.Diag[] = [];
  let local_names: string[] = e049_nt_names(locals);
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(a) => {
        if (!util.has_str(local_names, a.target) && e049_ref_capture(enclosing, a.target)) {
          out = out.append(dg_at("E049", "cannot assign to captured " + e049_capture_label(enclosing, a.target) + "\"" + a.target + "\": a reference-typed closure capture is read-only (it could close a reference cycle); return the new value from the closure instead", a.target_line, a.target_col));
        }
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, e049_check_assigns(f.then_body, enclosing, locals));
        out = util.append_diags(out, e049_check_assigns(f.else_body, enclosing, locals));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e049_check_assigns(w.body, enclosing, locals));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e049_check_assigns(fr.body, enclosing, locals));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, e049_check_assigns(arm.body, enclosing, locals));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e049_check_assigns(one, enclosing, locals));
      },
      _ => {}
    }
    out = util.append_diags(out, e049_stmt_own_lambdas(stmt, enclosing, locals));
  }
  return out;
}

function e049_expr_lambdas(e: ast.Expr, enclosing: NameTy[]): util.Diag[] {
  function at_lambda(n: ast.Expr, own acc: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprLambda(lm) => {
        if (parser.is_value_block_origin(lm.origin)) {
          return util.append_diags(acc, e049_find(lm.body, enclosing));
        }
        return util.append_diags(acc, e049_check_assigns(lm.body, enclosing, e049_lambda_locals_nt(lm)));
      },
      _ => {
        return acc;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    match (n) {
      ast.ExprLambda(_) => {
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return astwalk.fold_expr_pruned(e, no_diags(), at_lambda, not_into_lambda);
}

function e049_find(stmts: ast.Stmt[], enclosing: NameTy[]): util.Diag[] {
  let out: util.Diag[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, e049_expr_lambdas(v.init, enclosing));
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, e049_expr_lambdas(r.value, enclosing));
      },
      ast.StmtExpr(e) => {
        out = util.append_diags(out, e049_expr_lambdas(e.value, enclosing));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, e049_expr_lambdas(a.value, enclosing));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, e049_find(f.then_body, enclosing));
        out = util.append_diags(out, e049_find(f.else_body, enclosing));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e049_find(w.body, enclosing));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e049_find(fr.body, enclosing));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, e049_find(arm.body, enclosing));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e049_find(one, enclosing));
      },
      _ => {}
    }
  }
  return out;
}

pub function e049_diags(mod: parser.Module, env: ModuleEnv, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    let encl: NameTy[] = [];
    for param in fn.params {
      encl = encl.append(NameTy { nm: param.name, ty: param.type_name });
    }
    encl = e049_append_nt(encl, e049_scope(fn.body));
    out = util.append_diags(out, e049_find(fn.body, encl));
    out = util.append_diags(out, e049_cell_stores(fn, mod, env));
  }
  return out;
}

function e049_cell_stores(fn: parser.FuncDecl, mod: parser.Module, env: ModuleEnv): util.Diag[] {
  let out: util.Diag[] = e049_body_stores(fn, mod, env);
  let lams: ast.ExprLambda[] = [];
  for st in fn.body {
    lams = astwalk.fold_stmt_nodes(st, lams, e049_no_stmt_lambdas, e049_lambda_at, e049_into_all);
  }
  for lm in lams {
    out = util.append_diags(out, e049_body_stores(parser.FuncDecl { ...fn, params: lm.params, ret_type: lm.ret_type, body: lm.body }, mod, env));
  }
  return out;
}

function e049_body_stores(fn: parser.FuncDecl, mod: parser.Module, env: ModuleEnv): util.Diag[] {
  let captured: string[] = [];
  for st in fn.body {
    captured = astwalk.fold_stmt_own_pruned(st, captured, e049_lambda_captures, e049_not_into_lambda);
  }
  for st in fn.body {
    captured = e049_nested_stmt_captures(st, captured);
  }
  if (captured.len() == 0) {
    return [];
  }
  let vars: NameTy[] = e049_lambda_var_types(fn.body, e049_scope(fn.body));
  let sc: Scope = build_func_scope(fn, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  return e049_store_walk(fn.body, sc, vars, captured, fn.type_params, mod, []);
}

function e049_lambda_at(n: ast.Expr, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  if let ast.ExprLambda(lm) = n {
    if (!parser.is_value_block_origin(lm.origin)) {
      return acc.append(lm);
    }
  }
  return acc;
}

function e049_no_stmt_lambdas(st: ast.Stmt, own acc: ast.ExprLambda[]): ast.ExprLambda[] {
  return acc;
}

function e049_into_all(n: ast.Expr): boolean {
  return true;
}

function e049_nested_stmt_captures(st: ast.Stmt, acc: string[]): string[] {
  let kids: ast.Stmt[] = [];
  match (st) {
    ast.StmtIf(f) => {
      kids = e049_cat_stmts(f.then_body, f.else_body);
    },
    ast.StmtWhile(w) => {
      kids = w.body;
    },
    ast.StmtFor(fr) => {
      kids = fr.body;
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        kids = e049_cat_stmts(kids, arm.body);
      }
    },
    ast.StmtDefer(d) => {
      kids = [d.action];
    },
    _ => {}
  }
  for k in kids {
    acc = astwalk.fold_stmt_own_pruned(k, acc, e049_lambda_captures, e049_not_into_lambda);
    acc = e049_nested_stmt_captures(k, acc);
  }
  return acc;
}

function e049_lambda_captures(n: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprLambda(lm) = n {
    if (!parser.is_value_block_origin(lm.origin)) {
      return astwalk.collect_lambda_idents(lm, acc);
    }
  }
  return acc;
}

function e049_not_into_lambda(n: ast.Expr): boolean {
  if let ast.ExprLambda(lm) = n {
    return parser.is_value_block_origin(lm.origin);
  }
  return true;
}

function e049_cat_stmts(a: ast.Stmt[], b: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = a;
  for st in b {
    out = out.append(st);
  }
  return out;
}

function e049_lambda_var_types(stmts: ast.Stmt[], vars: NameTy[]): NameTy[] {
  let out: NameTy[] = [];
  let lambdas: string[] = [];
  let walked: boolean = false;
  for nt in vars {
    let ty: string = nt.ty;
    if (ty.len() == 0) {
      if (!walked) {
        lambdas = e049_lambda_init_names(stmts);
        walked = true;
      }
      if (util.has_str(lambdas, nt.nm)) {
        ty = "fn";
      }
    }
    out = out.append(NameTy { nm: nt.nm, ty: ty });
  }
  return out;
}

function e049_lambda_init_names(stmts: ast.Stmt[]): string[] {
  function at_var(st: ast.Stmt, own acc: string[]): string[] {
    if let ast.StmtVar(v) = st {
      if let ast.ExprLambda(_) = v.init {
        return acc.append(v.name);
      }
    }
    return acc;
  }
  let out: string[] = [];
  for st in stmts {
    out = astwalk.fold_stmt_spine(st, out, at_var);
  }
  return out;
}

function e049_store_walk(stmts: ast.Stmt[], sc: Scope, vars: NameTy[], captured: string[], tparams: string[], mod: parser.Module, own out: util.Diag[]): util.Diag[] {
  for st in stmts {
    for vb in e049_value_blocks(st) {
      out = e049_store_walk(vb.body, sc, vars, captured, tparams, mod, out);
    }
    match (st) {
      ast.StmtAssign(a) => {
        let ty: string = e049_var_type(vars, a.target);
        let vty: string = e049_value_type(a.value, sc, ty);
        if (util.has_str(captured, a.target) && e049_is_ref(ty) && e049_type_reaches_fn(vty, tparams, mod, [])
          && !e049_lambda_cannot_reach(a.value, a.target, vars, tparams, mod)) {
          out = out.append(dg_at("E049", "cannot assign a value of type " + vty + " to captured \"" + a.target + "\": a captured variable is shared by reference, so storing a value that can reach a closure would close a reference cycle the runtime cannot collect; keep the closure in a variable it does not capture", a.target_line, a.target_col));
        }
      },
      ast.StmtIf(f) => {
        out = e049_store_walk(f.then_body, sc, vars, captured, tparams, mod, out);
        out = e049_store_walk(f.else_body, sc, vars, captured, tparams, mod, out);
      },
      ast.StmtWhile(w) => {
        out = e049_store_walk(w.body, sc, vars, captured, tparams, mod, out);
      },
      ast.StmtFor(fr) => {
        out = e049_store_walk(fr.body, sc, vars, captured, tparams, mod, out);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = e049_store_walk(arm.body, sc, vars, captured, tparams, mod, out);
        }
      },
      _ => {}
    }
    sc = bind_stmt(st, sc);
  }
  return out;
}

function e049_value_type(v: ast.Expr, sc: Scope, declared: string): string {
  let vt: typeinfo.Type = check_expr(v, sc);
  if (is_unknown(vt)) {
    return declared;
  }
  let sp: string = typeinfo.spelling(vt);
  if (sp.len() == 0) {
    return declared;
  }
  return sp;
}

function e049_var_type(vars: NameTy[], name: string): string {
  for nt in vars {
    if (nt.nm == name) {
      return nt.ty;
    }
  }
  return "";
}

function e049_lambda_cannot_reach(v: ast.Expr, target: string, vars: NameTy[], tparams: string[], mod: parser.Module): boolean {
  if let ast.ExprLambda(lm) = v {
    for name in astwalk.collect_lambda_idents(lm, []) {
      if (name == target) {
        return false;
      }
      let ty: string = e049_var_type(vars, name);
      if (e049_type_reaches_fn(ty, tparams, mod, [])) {
        return false;
      }
    }
    return true;
  }
  return false;
}

function e049_type_reaches_fn(ty: string, tparams: string[], mod: parser.Module, seen: string[]): boolean {
  if (ty.len() == 0) {
    return false;
  }
  if (util.contains(ty, "=>")) {
    return true;
  }
  let start: i32 = 0 - 1;
  let i: i32 = 0;
  while (i <= ty.len()) {
    let word: boolean = i < ty.len() && lexer.is_alphanumeric(ty[i] as i32);
    if (word && start < 0) {
      start = i;
    }
    if (!word && start >= 0) {
      let w: string = slice_unchecked(ty, start, i) + "";
      start = 0 - 1;
      if (w == "fn" || w == "dyn" || util.has_str(tparams, w)) {
        return true;
      }
      if (!util.has_str(seen, w)) {
        seen = seen.append(w);
        for sd in mod.structs {
          if (sd.name == w || sd.enum_owner == w) {
            for fld in sd.fields {
              if (fld.fn_ret.len() > 0 || e049_type_reaches_fn(fld.type_name, tparams, mod, seen)) {
                return true;
              }
            }
          }
        }
      }
    }
    i = i + 1;
  }
  return false;
}

function e064_unknown_bare(type_name: string, tn: TypeNames): boolean {
  if (type_name.len() == 0) {
    return false;
  }
  if (type_name == "void" || type_name == "Self") {
    return false;
  }
  if (type_name == "u8" || type_name == "usize" || type_name == "str" || type_name == "char") {
    return false;
  }
  if (type_name == "tuple") {
    return false;
  }
  if (type_name == "fn") {
    return true;
  }
  if (parser.is_reserved_struct_name(type_name) || parser.is_reserved_enum_name(type_name)) {
    return false;
  }
  if (!plain_ident(type_name) || parser.looks_type_var(type_name)) {
    return false;
  }
  return is_unknown(type_from_spelling(type_name, tn));
}

function declared_struct_names(structs: parser.StructDecl[]): string[] {
  let out: string[] = [];
  for sd in structs {
    if (sd.enum_owner.len() == 0) {
      out = out.append(sd.name);
    }
  }
  return out;
}

function plain_ident(name: string): boolean {
  for byte in name {
    let ch: i32 = byte as i32;
    let alpha: boolean = ch >= 65 && ch <= 90 || ch >= 97 && ch <= 122;
    let digit: boolean = ch >= 48 && ch <= 57;
    if (!alpha && !digit && ch != 95) {
      return false;
    }
  }
  return name.len() > 0;
}

function e064_unknown_name(type_name: string, tn: TypeNames, extra_known: string[], tparams: string[]): string {
  return e064_unknown_name_tref(parser.parse_type_ref(type_name), tn, extra_known, tparams);
}

function e064_decl_spelling(type_name: string, fn_ret: string, fn_params: string): string {
  return parser.fn_tag_spelling(type_name, fn_ret, fn_params);
}

function e064_unknown_name_tref(tr: parser.TypeRef, tn: TypeNames, extra_known: string[], tparams: string[]): string {
  if (tr.array_depth > 0) {
    let elem: parser.TypeRef = parser.elem_type_ref(tr);
    return e064_unknown_name_tref(elem, tn, extra_known, tparams);
  }
  if (tr.is_view) {
    return e064_unknown_name_tref(tr.args[0], tn, extra_known, tparams);
  }
  if (tr.is_tuple || parser.ref_is_fn_value(tr)) {
    return e064_component_unknown(parser.ref_ungroup(tr).args, tn, extra_known, tparams);
  }
  if (tr.args.len() > 0) {
    if (!parser.is_reserved_struct_name(tr.base) && !parser.is_reserved_enum_name(tr.base)) {
      let kx: boolean = false;
      for elem in extra_known {
        if (elem == tr.base) {
          kx = true;
        }
      }
      if (!kx && e064_unknown_bare(tr.base, tn)) {
        return tr.base;
      }
    }
    return e064_component_unknown(tr.args, tn, extra_known, tparams);
  }
  if (util.has_str(tparams, tr.base)) {
    return "";
  }
  if (e064_unknown_bare(tr.base, tn)) {
    return tr.base;
  }
  return "";
}

function e064_component_unknown(args: parser.TypeRef[], tn: TypeNames, extra_known: string[], tparams: string[]): string {
  for arg in args {
    let u: string = e064_unknown_name_tref(parser.ref_without_own(arg), tn, extra_known, tparams);
    if (u.len() > 0) {
      return u;
    }
  }
  return "";
}

struct Annot { type_name: string, line: i32, col: i32 }

function collect_annots(stmts: ast.Stmt[]): Annot[] {
  let acc: Annot[] = [];
  for stmt in stmts {
    acc = astwalk.fold_stmt_nodes(stmt, acc, annot_of_stmt, annot_of_expr, astwalk.descend_all);
  }
  return acc;
}

function annot_of_stmt(st: ast.Stmt, own acc: Annot[]): Annot[] {
  match (st) {
    ast.StmtVar(v) => {
      return acc.append(Annot { type_name: e064_decl_spelling(v.type_name, v.fn_ret, v.fn_param_types), line: v.line, col: v.col });
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function lambda_annots(stmts: ast.Stmt[]): Annot[] {
  let acc: Annot[] = [];
  for stmt in stmts {
    acc = astwalk.fold_stmt_nodes(stmt, acc, annot_keep_acc, annot_of_expr, astwalk.descend_all);
  }
  return acc;
}

function annot_keep_acc(st: ast.Stmt, own acc: Annot[]): Annot[] {
  return acc;
}

function annot_of_expr(e: ast.Expr, own acc: Annot[]): Annot[] {
  match (e) {
    ast.ExprLambda(lm) => {
      if (lm.line == 0) {
        return acc;
      }
      for param in lm.params {
        acc = acc.append(Annot { type_name: e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), line: lm.line, col: lm.col });
      }
      return acc.append(Annot { type_name: e064_decl_spelling(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types), line: lm.line, col: lm.col });
    },
    ast.ExprStructLit(sl) => {
      if (sl.written.len() > 0) {
        for a in parser.parse_type_ref(sl.written).args {
          acc = acc.append(Annot { type_name: parser.render_type_ref(a), line: sl.line, col: sl.col });
        }
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function unknown_type_hint(name: string, traits: string[]): string {
  if (util.has_str(traits, name)) {
    return " (`" + util.demangle(name) + "` is a trait: a parameter of trait type makes the function generic over it; anywhere else write `dyn " + util.demangle(name) + "`)";
  }
  if (name == "bool") {
    return " (did you mean `boolean`?)";
  }
  if (name == "int" || name == "long") {
    return " (did you mean `i32`?)";
  }
  if (name == "uint") {
    return " (did you mean `u32`?)";
  }
  if (name == "double") {
    return " (did you mean `f64`?)";
  }
  if (name == "String") {
    return " (did you mean `string`?)";
  }
  return "";
}

function e064_fn_tparams(fd: parser.FuncDecl): string[] {
  let out: string[] = fd.all_type_params;
  for tp in func_scope_tparams(fd) {
    if (!util.has_str(out, tp)) {
      out = out.append(tp);
    }
  }
  return out;
}

function handle_type_diags(mod: parser.Module, focus: util.NameIndex, tn: TypeNames): util.Diag[] {
  let out: util.Diag[] = [];
  for fd in mod.funcs {
    if (in_focus(focus, fd)) {
      for param in fd.params {
        out = util.append_diags(out, handle_misuse_diags(e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), tn, fd.line, fd.col));
      }
      out = util.append_diags(out, handle_misuse_diags(e064_decl_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types), tn, fd.line, fd.col));
      for an in collect_annots(fd.body) {
        out = util.append_diags(out, handle_misuse_diags(an.type_name, tn, an.line, an.col));
      }
    }
  }
  for sd in mod.structs {
    let (line, col) = struct_decl_pos(mod, sd);
    for field in sd.fields {
      out = util.append_diags(out, handle_misuse_diags(e064_decl_spelling(field.type_name, field.fn_ret, field.fn_param_types), tn, line, col));
    }
  }
  return out;
}

function struct_decl_pos(mod: parser.Module, sd: parser.StructDecl): (i32, i32) {
  if (sd.enum_owner.len() > 0) {
    for ed in mod.enums {
      if (ed.name == sd.enum_owner) {
        return (ed.line, ed.col);
      }
    }
  }
  return (sd.line, sd.col);
}

function handle_misuse_diags(type_name: string, tn: TypeNames, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  for leaf in handle_leaves(parser.parse_type_ref(type_name), []) {
    if (!names_resource_handle(leaf, tn)) {
      out = out.append(dg_at("E021", handle_not_resource_message(leaf), line, col));
    }
  }
  return out;
}

function handle_leaves(tr: parser.TypeRef, own acc: string[]): string[] {
  if (tr.array_depth > 0) {
    return handle_leaves(parser.elem_type_ref(tr), acc);
  }
  if (tr.args.len() == 0 && handle_resource(tr.base) != tr.base) {
    return acc.append(tr.base);
  }
  let slots: i32 = 0;
  if (tr.is_fn) {
    slots = tr.args.len() - 1;
  }
  let i: i32 = 0;
  while (i < tr.args.len()) {
    if (i < slots) {
      acc = handle_leaves(without_slot_marker(tr.args[i]), acc);
    } else {
      acc = handle_leaves(tr.args[i], acc);
    }
    i = i + 1;
  }
  return acc;
}

function without_slot_marker(slot: parser.TypeRef): parser.TypeRef {
  if (util.str_has_prefix(slot.base, "own ")) {
    return parser.TypeRef { ...slot, base: slice_unchecked(slot.base, 4, slot.base.len()) + "" };
  }
  return slot;
}

function handle_not_resource_message(leaf: string): string {
  let name: string = util.demangle(handle_resource(leaf));
  if (util.str_has_prefix(leaf, "borrow ")) {
    return "`" + name + "` is not a resource, so `borrow " + name + "` is not a handle type; a parameter borrows by default, written `name: " + name + "`";
  }
  return "`" + name + "` is not a resource, so `own " + name + "` is not a handle type; a consuming parameter is written `own name: " + name + "`";
}

function e064_annot_diags(an: Annot[], tn: TypeNames, extra_known: string[], tparams: string[], traits: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  for elem in an {
    let vu: string = e064_unknown_name(elem.type_name, tn, extra_known, tparams);
    if (vu.len() > 0) {
      out = out.append(dg_at("E064", "cannot find type \"" + util.demangle(vu) + "\" in this scope" + unknown_type_hint(vu, traits), elem.line, elem.col));
    }
  }
  return out;
}

function cell_payload_risk(t: typeinfo.Type, s: Scope, own: string[], seen: string[]): string {
  match (t) {
    typeinfo.TypeString(st) => {
      if (st.tag == 1) {
        return type_label(t);
      }
    },
    typeinfo.TypeArray(a) => {
      if (a.view) {
        return type_label(t);
      }
      return cell_payload_risk(a.elem, s, own, seen);
    },
    typeinfo.TypeTuple(tt) => {
      return cell_payload_risks(tt.elements, s, own, seen);
    },
    typeinfo.TypeMap(m) => {
      return cell_payload_risks([m.key, m.value], s, own, seen);
    },
    typeinfo.TypeStruct(st) => {
      if (st.name == "Cell") {
        return type_label(t);
      }
      let ar: string = cell_payload_risks(st.args, s, own, seen);
      if (ar.len() > 0 || util.has_str(seen, st.name)) {
        return ar;
      }
      let sig: StructSig = s.lookup_struct(st.name);
      return cell_payload_risks(sig.field_types, s, sig.type_params, seen.append(st.name));
    },
    typeinfo.TypeUnion(u) => {
      let ar: string = cell_payload_risks(u.args, s, own, seen);
      let at: i32 = s.unions.index.find(u.name);
      if (ar.len() > 0 || at < 0 || util.has_str(seen, u.name)) {
        return ar;
      }
      return union_payload_risk(s.unions.unions[at], s, seen.append(u.name));
    },
    typeinfo.TypeUnknown(u) => {
      let n: i32 = TPARAM_MARK.len();
      if (u.reason.len() > n && slice_unchecked(u.reason, 0, n) == TPARAM_MARK) {
        let tp: string = slice_unchecked(u.reason, n, u.reason.len()) + "";
        if (!util.has_str(own, tp)) {
          return tp;
        }
      }
    },
    typeinfo.TypeErased(e) => {
      if (!util.has_str(own, e.name)) {
        return type_label(t);
      }
    },
    typeinfo.TypeFunc(_) => {
      return type_label(t);
    },
    typeinfo.TypeDyn(_) => {
      return type_label(t);
    },
    typeinfo.TypeHandle(_) => {
      return type_label(t);
    },
    _ => {}
  }
  return "";
}

function cell_payload_risks(ts: typeinfo.Type[], s: Scope, own: string[], seen: string[]): string {
  for t in ts {
    let r: string = cell_payload_risk(t, s, own, seen);
    if (r.len() > 0) {
      return r;
    }
  }
  return "";
}

function union_payload_risk(u: UnionSig, s: Scope, seen: string[]): string {
  for v in u.variants {
    let r: string = "";
    if (u.is_enum) {
      r = cell_payload_risks(s.lookup_owned_struct(v, u.name).field_types, s, u.type_params, seen);
    } else {
      r = cell_payload_risk(type_from_spelling(v, s.type_names()), s, u.type_params, seen);
    }
    if (r.len() > 0) {
      return r;
    }
  }
  return "";
}

function e057_diag(label: string, elem: typeinfo.Type, s: Scope, line: i32, col: i32): util.Diag[] {
  let risk: string = cell_payload_risk(elem, s, [], []);
  if (risk.len() == 0) {
    return [];
  }
  let why: string = ", and " + label + " contains " + risk;
  if (risk == type_label(named_tparams(elem))) {
    why = ", which " + label + " is not";
  }
  return [dg_at("E057", "Cell[" + label + "] is not allowed: a cell's element must be built from scalars, strings, arrays, tuples, maps, structs and enums" + why, line, col)];
}

function named_tparams(t: typeinfo.Type): typeinfo.Type {
  match (t) {
    typeinfo.TypeUnknown(u) => {
      let n: i32 = TPARAM_MARK.len();
      if (u.reason.len() > n && slice_unchecked(u.reason, 0, n) == TPARAM_MARK) {
        return t_struct(slice_unchecked(u.reason, n, u.reason.len()) + "");
      }
    },
    typeinfo.TypeArray(a) => {
      return typeinfo.TypeArray { elem: named_tparams(a.elem), view: a.view };
    },
    typeinfo.TypeTuple(tt) => {
      return t_tuple(named_tparams_all(tt.elements));
    },
    typeinfo.TypeMap(m) => {
      return t_map(named_tparams(m.key), named_tparams(m.value));
    },
    typeinfo.TypeStruct(st) => {
      return t_struct_g(st.name, named_tparams_all(st.args));
    },
    typeinfo.TypeUnion(u) => {
      return t_union_g(u.name, named_tparams_all(u.args));
    },
    _ => {}
  }
  return t;
}

function named_tparams_all(ts: typeinfo.Type[]): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for t in ts {
    out = out.append(named_tparams(t));
  }
  return out;
}

function e057_annot_diags_tref(tr: parser.TypeRef, tparams: string[], s: Scope, line: i32, col: i32): util.Diag[] {
  let out: util.Diag[] = [];
  if (!tr.is_tuple && tr.base == "Cell" && tr.args.len() == 1) {
    let elem: typeinfo.Type = type_from_ref_subst(tr.args[0], tparams, erased_tparams(tparams), s.type_names());
    out = util.append_diags(out, e057_diag(parser.render_type_ref(tr.args[0]), elem, s, line, col));
  }
  for arg in tr.args {
    out = util.append_diags(out, e057_annot_diags_tref(arg, tparams, s, line, col));
  }
  return out;
}

function e057_annot_diags(type_name: string, tparams: string[], s: Scope, line: i32, col: i32): util.Diag[] {
  if (type_name.len() == 0) {
    return [];
  }
  return e057_annot_diags_tref(parser.parse_type_ref(type_name), tparams, s, line, col);
}

function e057_struct_diags(sd: parser.StructDecl, enums: parser.EnumDecl[], s: Scope): util.Diag[] {
  let tps: string[] = sd.type_params;
  let line: i32 = sd.line;
  let col: i32 = sd.col;
  for ed in enums {
    if (sd.enum_owner.len() > 0 && ed.name == sd.enum_owner) {
      tps = ed.type_params;
      line = ed.line;
      col = ed.col;
    }
  }
  let out: util.Diag[] = [];
  for field in sd.fields {
    out = util.append_diags(out, e057_annot_diags(field.type_name, tps, s, line, col));
  }
  return out;
}

function e057_fn_diags(fd: parser.FuncDecl, s: Scope): util.Diag[] {
  let tps: string[] = e064_fn_tparams(fd);
  let out: util.Diag[] = [];
  for param in fd.params {
    out = util.append_diags(out, e057_annot_diags(param.type_name, tps, s, fd.line, fd.col));
  }
  out = util.append_diags(out, e057_annot_diags(fd.ret_type, tps, s, fd.line, fd.col));
  for elem in collect_annots(fd.body) {
    out = util.append_diags(out, e057_annot_diags(elem.type_name, tps, s, elem.line, elem.col));
  }
  return out;
}

struct E044Walk { void_fns: string[] }

function e044_lambda_check(lam: ast.ExprLambda, line: i32, col: i32, wk: E044Walk, suspects: string[], labels: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  let free: string[] = astwalk.collect_lambda_idents(lam, []);
  let i: i32 = 0;
  while (i < suspects.len()) {
    if (util.has_str(free, suspects[i])) {
      out = out.append(dg_at("E044", "captured variable \"" + suspects[i] + "\" has unsupported type " + labels[i], line, col));
    }
    i = i + 1;
  }
  return out;
}

function e044_expr(e: ast.Expr, line: i32, col: i32, wk: E044Walk, suspects: string[], labels: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  match (e) {
    ast.ExprLambda(lm) => {
      if (parser.is_written_lambda_origin(lm.origin)) {
        out = util.append_diags(out, e044_lambda_check(lm, line, col, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(lm.body, wk, [], []));
      }
    },
    ast.ExprBinary(b) => {
      out = util.append_diags(out, e044_expr(b.left, line, col, wk, suspects, labels));
      out = util.append_diags(out, e044_expr(b.right, line, col, wk, suspects, labels));
    },
    ast.ExprUnary(u) => {
      out = util.append_diags(out, e044_expr(u.operand, line, col, wk, suspects, labels));
    },
    ast.ExprCall(c) => {
      out = util.append_diags(out, e044_expr(c.callee, line, col, wk, suspects, labels));
      for arg in c.args {
        out = util.append_diags(out, e044_expr(arg, line, col, wk, suspects, labels));
      }
    },
    ast.ExprArray(a) => {
      for element in a.elements {
        out = util.append_diags(out, e044_expr(element, line, col, wk, suspects, labels));
      }
    },
    ast.ExprTuple(t) => {
      for element in t.elements {
        out = util.append_diags(out, e044_expr(element, line, col, wk, suspects, labels));
      }
    },
    ast.ExprIndex(ix) => {
      out = util.append_diags(out, e044_expr(ix.array, line, col, wk, suspects, labels));
      out = util.append_diags(out, e044_expr(ix.index, line, col, wk, suspects, labels));
    },
    ast.ExprSlice(sl) => {
      out = util.append_diags(out, e044_expr(sl.array, line, col, wk, suspects, labels));
      out = util.append_diags(out, e044_expr(sl.start, line, col, wk, suspects, labels));
      out = util.append_diags(out, e044_expr(sl.end, line, col, wk, suspects, labels));
    },
    ast.ExprFieldAccess(fa) => {
      out = util.append_diags(out, e044_expr(fa.obj, line, col, wk, suspects, labels));
    },
    ast.ExprStructLit(s) => {
      if (s.has_base) {
        out = util.append_diags(out, e044_expr(s.base, line, col, wk, suspects, labels));
      }
      for field_value in s.field_values {
        out = util.append_diags(out, e044_expr(field_value, line, col, wk, suspects, labels));
      }
    },
    _ => {}
  }
  return out;
}

function e044_stmts(stmts: ast.Stmt[], wk: E044Walk, suspects0: string[], labels0: string[]): util.Diag[] {
  let out: util.Diag[] = [];
  let suspects: string[] = suspects0;
  let labels: string[] = labels0;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        out = util.append_diags(out, e044_expr(v.init, v.line, v.col, wk, suspects, labels));
        let is_void_init: boolean = false;
        match (v.init) {
          ast.ExprCall(c) => {
            match (c.callee) {
              ast.ExprIdent(id) => {
                for void_fn in wk.void_fns {
                  if (void_fn == id.name) {
                    is_void_init = true;
                  }
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
        if (is_void_init && v.type_name.len() == 0) {
          suspects = suspects.append(v.name);
          labels = labels.append("void");
        }
      },
      ast.StmtReturn(r) => {
        out = util.append_diags(out, e044_expr(r.value, r.line, r.col, wk, suspects, labels));
      },
      ast.StmtExpr(e) => {
        out = util.append_diags(out, e044_expr(e.value, 0, 0, wk, suspects, labels));
      },
      ast.StmtAssign(a) => {
        out = util.append_diags(out, e044_expr(a.value, a.line, a.col, wk, suspects, labels));
      },
      ast.StmtIf(f) => {
        out = util.append_diags(out, e044_expr(f.cond, 0, 0, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(f.then_body, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(f.else_body, wk, suspects, labels));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e044_expr(w.cond, 0, 0, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(w.body, wk, suspects, labels));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e044_expr(fr.iter, 0, 0, wk, suspects, labels));
        out = util.append_diags(out, e044_stmts(fr.body, wk, suspects, labels));
      },
      ast.StmtMatch(m) => {
        out = util.append_diags(out, e044_expr(m.scrutinee, m.line, m.col, wk, suspects, labels));
        for arm in m.arms {
          out = util.append_diags(out, e044_stmts(arm.body, wk, suspects, labels));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e044_stmts(one, wk, suspects, labels));
      },
      _ => {}
    }
  }
  return out;
}

function e044_diags(efn: parser.FuncDecl, void_fns: string[]): util.Diag[] {
  return e044_stmts(efn.body, E044Walk { void_fns: void_fns }, [], []);
}

function e053_root_len(target: string): i32 {
  let i: i32 = 0;
  while (i < target.len()) {
    let ch: i32 = target[i] as i32;
    if (ch == 91 || ch == 46) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function e053_root_is_own(target: string, rl: i32, own: string[]): boolean {
  for elem in own {
    if (elem.len() == rl) {
      let eq: boolean = true;
      let k: i32 = 0;
      while (k < rl) {
        if (elem[k] != target[k]) {
          eq = false;
        }
        k = k + 1;
      }
      if (eq) {
        return true;
      }
    }
  }
  return false;
}

function e053_stringish(e: ast.Expr, cur: Scope): boolean {
  match (e) {
    ast.ExprString(_) => {
      return true;
    },
    _ => {}
  }
  match (check_expr(e, cur)) {
    typeinfo.TypeString(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

struct E053Ctx { fname: string, kw: string, callable: string[], variants: string[], own: string[] }

function fip_recv_root(e: ast.Expr): string {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    ast.ExprIndex(ix) => {
      return fip_recv_root(ix.array);
    },
    ast.ExprFieldAccess(fa) => {
      return fip_recv_root(fa.obj);
    },
    ast.ExprCall(c) => {
      if let ast.ExprFieldAccess(link) = c.callee {
        if (link.field == "with") {
          return fip_recv_root(link.obj);
        }
      }
      return "";
    },
    _ => {
      return "";
    }
  }
  return "";
}

function fip_with_in_place(c: ast.ExprCall, fa: ast.ExprFieldAccess, root_own: boolean, root: string): boolean {
  return root_own && !fip_link_reads_root(c, fa, root);
}

function fip_link_reads_root(c: ast.ExprCall, fa: ast.ExprFieldAccess, root: string): boolean {
  if let ast.ExprCall(inner) = fa.obj {
    if let ast.ExprFieldAccess(link) = inner.callee {
      if (link.field != "with") {
        return false;
      }
      for a in c.args {
        if (astwalk.count_ident_expr(a, root) > 0) {
          return true;
        }
      }
    }
  }
  return false;
}

function e053_at_node(n: ast.Expr, fx: E053Ctx, cur: Scope, own out: util.Diag[]): util.Diag[] {
  match (n) {
    ast.ExprArray(a) => {
      return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not allocate (array literal)", a.line, a.col));
    },
    ast.ExprTuple(_) => {
      return out;
    },
    ast.ExprStructLit(_) => {
      return out;
    },
    ast.ExprBinary(b) => {
      if (b.op == "+" && (e053_stringish(b.left, cur) || e053_stringish(b.right, cur))) {
        return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not allocate (string concatenation)", b.line, b.col));
      }
      return out;
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          let recv_root: string = fip_recv_root(fa.obj);
          let root_own: boolean = false;
          for elem in fx.own {
            if (elem == recv_root) {
              root_own = true;
            }
          }
          if (fa.field == "with" && fip_with_in_place(c, fa, root_own, recv_root)) {
            return out;
          }
          if (fa.field == "map" && root_own) {
            return out;
          }
          if (fa.field == "len") {
            return out;
          }
          return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not call method \"" + fa.field + "\" (not proven allocation-free)", fa.line, fa.col));
        },
        ast.ExprIdent(id) => {
          let is_variant: boolean = false;
          for variant in fx.variants {
            if (variant == id.name) {
              is_variant = true;
            }
          }
          if (is_variant) {
            return out;
          }
          let callable: boolean = false;
          for elem in fx.callable {
            if (elem == id.name) {
              callable = true;
            }
          }
          if (!callable) {
            let only: string = "may only call other `fip` functions, not \"";
            if (fx.kw == "fbip") {
              only = "may only call `fip` or `fbip` functions, not \"";
            }
            return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" " + only + id.name + "\"", c.line, c.col));
          }
          return out;
        },
        _ => {
          return out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not make an indirect call (not proven allocation-free)", c.line, c.col));
        }
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

function e053_own_exprs(stmt: ast.Stmt, fx: E053Ctx, cur: Scope): util.Diag[] {
  function at_node(n: ast.Expr, own out: util.Diag[]): util.Diag[] {
    return e053_at_node(n, fx, cur, out);
  }
  return astwalk.fold_stmt_own(stmt, no_diags(), at_node);
}

function e053_stmts(stmts: ast.Stmt[], fx: E053Ctx, s: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  let cur: Scope = s;
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(a) => {
        let trl: i32 = e053_root_len(a.target);
        if (trl >= 0 && !e053_root_is_own(a.target, trl, fx.own)) {
          out = out.append(dg_at("E053", "`" + fx.kw + "` function \"" + fx.fname + "\" may not write to a non-`own` heap value (triggers a copy-on-write)", a.line, a.col));
        }
      },
      _ => {}
    }
    out = util.append_diags(out, e053_own_exprs(stmt, fx, cur));
    match (stmt) {
      ast.StmtIf(f) => {
        out = util.append_diags(out, e053_stmts(f.then_body, fx, cur));
        out = util.append_diags(out, e053_stmts(f.else_body, fx, cur));
      },
      ast.StmtWhile(w) => {
        out = util.append_diags(out, e053_stmts(w.body, fx, cur));
      },
      ast.StmtFor(fr) => {
        out = util.append_diags(out, e053_stmts(fr.body, fx, for_body_scope(fr, cur)));
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = util.append_diags(out, e053_stmts(arm.body, fx, cur));
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = util.append_diags(out, e053_stmts(one, fx, cur));
      },
      _ => {}
    }
    cur = bind_stmt(stmt, cur);
  }
  return out;
}

function fip_builtin_callees(funcs: parser.FuncDecl[]): string[] {
  let out: string[] = [];
  for name in [
    "__memchr", "__mismatch_bytes", "__mismatch_bytes_str", "__count_byte_bytes", "__crc32_cksum_array", "__sum_bytes_array", "__bsd_sum_bytes", "__memchr_bytes", "__rmemchr_bytes", "__rmemchr", "__ascii_run", "__count_byte", "__sum_bytes", "__scan_set", "__scan_set_bytes",
    "__bsd_sum", "__str_hash", "__count_runs", "__count_runs_bytes", "__crc32_cksum", "__clz32", "__ctz32", "__popcount32", "__clz64",
    "__ctz64", "__popcount64", "__mulhi_u64", "__ptr_width", "__heap_bump_bytes", "__heap_alloc_count", "monotonic_ns",
    "__f64x2_of", "__f64x2_splat", "__f64x2_lane",
    "__f64x2_lt", "__f64x2_ne", "__f64x2_bitmask", "__f32x4_bitmask",
  ] {
    let declared: boolean = false;
    for fd in funcs {
      if (fd.name == name && fd.receiver_type.len() == 0) {
        declared = true;
      }
    }
    if (!declared) {
      out = out.append(name);
    }
  }
  return out;
}

function e053_diags(efn: parser.FuncDecl, fips: string[], fbips: string[], variants: string[], s: Scope): util.Diag[] {
  let own: string[] = [];
  for param in efn.params {
    if (param.own) {
      own = own.append(param.name);
    }
  }
  let kw: string = "fip";
  let callable: string[] = fips;
  if (efn.fbip) {
    kw = "fbip";
    for fbip in fbips {
      callable = callable.append(fbip);
    }
  }
  let fx: E053Ctx = E053Ctx { fname: efn.name, kw: kw, callable: callable, variants: variants, own: own };
  return e053_stmts(efn.body, fx, s);
}

pub struct E065Walk { diags: util.Diag[], viewed: string[], owns: boolean }

function e065_ident_in(name: string, xs: string[]): boolean {
  for elem in xs {
    if (elem == name) {
      return true;
    }
  }
  return false;
}

function e065_return_roots(e: ast.Expr, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): ViewRoots {
  match (e) {
    ast.ExprIdent(id) => {
      if (e065_ident_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (e065_ident_in(id.name, sbacked)) {
        let none: string[] = [];
        return ViewRoots { local: true, params: none };
      }
    },
    ast.ExprCall(c) => {
      return e065_call_roots(c, params, sbacked, sums, vix, s);
    },
    _ => {}
  }
  return no_view_roots();
}

function e065_string_src_roots(e: ast.Expr, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): ViewRoots {
  let none: string[] = [];
  match (e) {
    ast.ExprString(_) => {
      return no_view_roots();
    },
    ast.ExprIdent(id) => {
      if (e065_ident_in(id.name, params)) {
        let one: string[] = [];
        return ViewRoots { local: false, params: one.append(id.name) };
      }
      if (e065_ident_in(id.name, sbacked)) {
        return ViewRoots { local: true, params: none };
      }
      return no_view_roots();
    },
    ast.ExprCall(c) => {
      let callee: ViewCallee = view_callee(c, s);
      if (callee.key.len() == 0) {
        return ViewRoots { local: true, params: none };
      }
      let out: ViewRoots = no_view_roots();
      if (!view_sum_known(sums, vix, callee.key) || view_sum_fresh(sums, vix, callee.key)) {
        out = ViewRoots { local: true, params: out.params };
      }
      let flags: boolean[] = view_sum_flags(sums, vix, callee.key);
      let i: i32 = 0;
      while (i < flags.len() && i < callee.args.len()) {
        if (flags[i]) {
          out = merge_view_roots(out, e065_string_src_roots(callee.args[i], params, sbacked, sums, vix, s));
        }
        i = i + 1;
      }
      return out;
    },
    _ => {}
  }
  return ViewRoots { local: true, params: none };
}

function e065_call_roots(c: ast.ExprCall, params: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): ViewRoots {
  let direct: string = "";
  match (c.callee) {
    ast.ExprIdent(cid) => {
      direct = cid.name;
    },
    _ => {}
  }
  if (direct == "slice_unchecked" && c.args.len() == 3) {
    return e065_string_src_roots(c.args[0], params, sbacked, sums, vix, s);
  }
  let out: ViewRoots = no_view_roots();
  let callee: ViewCallee = view_callee(c, s);
  if (callee.key.len() == 0) {
    return out;
  }
  let flags: boolean[] = view_sum_flags(sums, vix, callee.key);
  let i: i32 = 0;
  while (i < flags.len() && i < callee.args.len()) {
    if (flags[i]) {
      out = merge_view_roots(out, e065_return_roots(callee.args[i], params, sbacked, sums, vix, s));
    }
    i = i + 1;
  }
  return out;
}

function e065_view_source_name(e: ast.Expr): string {
  match (e) {
    ast.ExprSlice(sl) => {
      match (sl.array) {
        ast.ExprIdent(sid) => {
          return sid.name;
        },
        _ => {}
      }
    },
    ast.ExprCall(c) => {
      let callee_name: string = "";
      match (c.callee) {
        ast.ExprIdent(cid) => {
          callee_name = cid.name;
        },
        _ => {}
      }
      if (callee_name == "slice_unchecked" && c.args.len() == 3) {
        match (c.args[0]) {
          ast.ExprIdent(sid) => {
            return sid.name;
          },
          _ => {}
        }
      }
    },
    ast.ExprIdent(id) => {
      return id.name;
    },
    _ => {}
  }
  return "";
}

function e065_with_arm_bindings(sbacked: string[], arms: ast.MatchArm[]): string[] {
  let out: string[] = sbacked;
  for arm in arms {
    match (arm.pattern) {
      ast.PatVariant(pv) => {
        if (pv.binding.len() > 0) {
          out = out.append(pv.binding);
        }
        for extra in pv.extra_bindings {
          if (extra.len() > 0) {
            out = out.append(extra);
          }
        }
      },
      _ => {}
    }
  }
  return out;
}

function e065_stmts(stmts: ast.Stmt[], fname: string, params: string[], str_ret_names: string[], sbacked: string[], sums: ViewSum[], vix: ViewIndex, s: Scope, ret_is_view: boolean): E065Walk {
  let out: util.Diag[] = [];
  let viewed: string[] = [];
  let owns: boolean = false;
  let cur: Scope = s;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.type_name == "str") {
          match (v.init) {
            ast.ExprIdent(id) => {
              if (!e065_ident_in(id.name, params) && e065_ident_in(id.name, sbacked)) {
                sbacked = sbacked.append(v.name);
              }
            },
            ast.ExprCall(sc) => {
              if (e065_call_roots(sc, params, sbacked, sums, vix, cur).local) {
                sbacked = sbacked.append(v.name);
              }
            },
            _ => {}
          }
        } else if (v.type_name == "string") {
          sbacked = sbacked.append(v.name);
        } else if (v.type_name.len() == 0) {
          match (v.init) {
            ast.ExprString(_) => {
              sbacked = sbacked.append(v.name);
            },
            ast.ExprIdent(id) => {
              if (e065_ident_in(id.name, sbacked)) {
                sbacked = sbacked.append(v.name);
              }
            },
            ast.ExprSlice(osl) => {
              match (osl.array) {
                ast.ExprIdent(osid) => {
                  if (!e065_ident_in(osid.name, params) && e065_ident_in(osid.name, sbacked)) {
                    sbacked = sbacked.append(v.name);
                  }
                },
                _ => {}
              }
            },
            ast.ExprCall(c) => {
              if (e065_call_roots(c, params, sbacked, sums, vix, cur).local) {
                sbacked = sbacked.append(v.name);
              }
              let callee_name: string = "";
              match (c.callee) {
                ast.ExprIdent(cid) => {
                  callee_name = cid.name;
                },
                ast.ExprFieldAccess(cfa) => {
                  callee_name = cfa.field;
                },
                _ => {}
              }
              if (!e065_ident_in(callee_name, str_ret_names)) {
                match (check_expr(v.init, cur)) {
                  typeinfo.TypeString(_) => {
                    sbacked = sbacked.append(v.name);
                  },
                  _ => {}
                }
              }
            },
            _ => {}
          }
        }
      },
      ast.StmtReturn(r) => {
        if (!ret_is_view) {
          let sroots: ViewRoots = e065_string_src_roots(r.value, params, sbacked, sums, vix, cur);
          viewed = merge_view_names(viewed, sroots.params);
          if (sroots.local) {
            owns = true;
          }
        }
        let roots: ViewRoots = e065_return_roots(r.value, params, sbacked, sums, vix, cur);
        viewed = merge_view_names(viewed, roots.params);
        if (ret_is_view && roots.local) {
          out = out.append(dg_at("E065", "returning a `str` view of a function-local string: the backing string is reclaimed when \"" + fname + "\" returns, leaving a dangling view — return an owned `string` (materialise with .to_owned()) or view a parameter instead", r.line, r.col));
        }
      },
      ast.StmtIf(f) => {
        let wt: E065Walk = e065_stmts(f.then_body, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, wt.diags);
        viewed = merge_view_names(viewed, wt.viewed);
        owns = owns || wt.owns;
        let we: E065Walk = e065_stmts(f.else_body, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, we.diags);
        viewed = merge_view_names(viewed, we.viewed);
        owns = owns || we.owns;
      },
      ast.StmtWhile(w) => {
        let ww: E065Walk = e065_stmts(w.body, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, ww.diags);
        viewed = merge_view_names(viewed, ww.viewed);
        owns = owns || ww.owns;
      },
      ast.StmtFor(fr) => {
        let wf: E065Walk = e065_stmts(fr.body, fname, params, str_ret_names, sbacked, sums, vix, for_body_scope(fr, cur), ret_is_view);
        out = util.append_diags(out, wf.diags);
        viewed = merge_view_names(viewed, wf.viewed);
        owns = owns || wf.owns;
      },
      ast.StmtMatch(m) => {
        let arm_sb: string[] = sbacked;
        let msrc: string = e065_view_source_name(m.scrutinee);
        if (msrc.len() > 0 && !e065_ident_in(msrc, params) && e065_ident_in(msrc, sbacked)) {
          arm_sb = e065_with_arm_bindings(arm_sb, m.arms);
        }
        for arm in m.arms {
          let wa: E065Walk = e065_stmts(arm.body, fname, params, str_ret_names, arm_sb, sums, vix, cur, ret_is_view);
          out = util.append_diags(out, wa.diags);
          viewed = merge_view_names(viewed, wa.viewed);
          owns = owns || wa.owns;
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        let wd: E065Walk = e065_stmts(one, fname, params, str_ret_names, sbacked, sums, vix, cur, ret_is_view);
        out = util.append_diags(out, wd.diags);
        viewed = merge_view_names(viewed, wd.viewed);
        owns = owns || wd.owns;
      },
      _ => {}
    }
    cur = bind_stmt(stmt, cur);
  }
  return E065Walk { diags: out, viewed: viewed, owns: owns };
}

function e065_diags(efn: parser.FuncDecl, str_ret_names: string[], sums: ViewSum[], vix: ViewIndex, s: Scope): E065Walk {
  let params: string[] = view_positions(efn);
  let none: string[] = [];
  return e065_stmts(efn.body, efn.name, params, str_ret_names, none, sums, vix, s, efn.ret_type == "str");
}

function e032_call_check(c: ast.ExprCall, cur: Scope): util.Diag[] {
  let out: util.Diag[] = [];
  if (c.args.len() == 0) {
    return out;
  }
  let infer: boolean = false;
  let line: i32 = c.line;
  let col: i32 = c.col;
  match (c.args[c.args.len() - 1]) {
    ast.ExprLambda(lm) => {
      if (lm.use_infer && lm.params.len() > 0 && lm.params[0].type_name.len() == 0) {
        infer = true;
        line = lm.line;
        col = lm.col;
      }
    },
    _ => {}
  }
  if (!infer) {
    return out;
  }
  let callee_name: string = "";
  match (c.callee) {
    ast.ExprIdent(id) => {
      callee_name = id.name;
    },
    _ => {
      out = out.append(dg_at("E032", "use: cannot infer binding type for non-identifier source — add an explicit `: TYPE` annotation", line, col));
      return out;
    }
  }
  let sig: FuncSig = cur.lookup_sig(callee_name);
  let have_sig: boolean = sig.name.len() > 0;
  if (have_sig) {
    if (sig.param_types.len() == 0) {
      out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", line, col));
      return out;
    }
    let last: i32 = sig.param_types.len() - 1;
    let lf: boolean = is_func_type(sig.param_types[last]);
    if (!lf) {
      out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s last parameter isn't a function — add an explicit `: TYPE` annotation", line, col));
    } else if (use_callback_empty(sig)) {
      out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s callback takes no arguments — there's nothing to bind", line, col));
    } else if (sig.all_type_params.len() > 0 && is_unknown(use_binding_type(c, cur))) {
      out = out.append(dg_at("E032", "use: could not infer binding type for \"" + callee_name + "\" from its arguments — add an explicit `: TYPE` annotation", line, col));
      let expected: string = "fn";
      if (last < sig.param_type_names.len()) {
        expected = sig.param_type_names[last];
      }
      out = out.append(dg_at("E038", arg_subject(c, c.args.len()) + ": expected " + expected + ", got " + use_callback_label(c.args[c.args.len() - 1], cur), line, col));
    }
    return out;
  }
  let bound_at: i32 = cur.binding_index(callee_name);
  if (bound_at >= 0) {
    if let typeinfo.TypeFunc(ft) = cur.types[bound_at] {
      if (ft.param_types.len() == 0) {
        out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", line, col));
        return out;
      }
      match (ft.param_types[ft.param_types.len() - 1]) {
        typeinfo.TypeFunc(cb) => {
          if (cb.param_types.len() == 0) {
            out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s callback takes no arguments — there's nothing to bind", line, col));
          }
        },
        _ => {
          out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\"'s last parameter isn't a function — add an explicit `: TYPE` annotation", line, col));
        }
      }
      return out;
    }
  }
  out = out.append(dg_at("E032", "use: callee \"" + callee_name + "\" has no signature; add an explicit `: TYPE` annotation", line, col));
  return out;
}

function use_callback_empty(sig: FuncSig): boolean {
  if (sig.param_types.len() > 0) {
    if let typeinfo.TypeFunc(f) = sig.param_types[sig.param_types.len() - 1] {
      return f.params_known && f.param_types.len() == 0;
    }
  }
  return false;
}

function argument_type_label(e: ast.Expr, t: typeinfo.Type, s: Scope): string {
  if let ast.ExprLambda(lm) = e {
    if (lm.use_infer && lm.params.len() > 0 && lm.params[0].type_name.len() == 0) {
      return use_callback_label(e, s);
    }
  }
  return type_label(t);
}

function use_callback_label(e: ast.Expr, s: Scope): string {
  let params: string = "";
  if let ast.ExprLambda(lm) = e {
    let i: i32 = 0;
    while (i < lm.params.len()) {
      if (i > 0) {
        params = params + ", ";
      }
      params = params + "<unknown>";
      i = i + 1;
    }
  }
  let ret: string = "unknown";
  if let typeinfo.TypeFunc(ft) = check_expr(e, s) {
    ret = type_label(ft.ret_type);
  }
  return "(" + params + ") => " + ret;
}

function e021_const_kind_diags(req: parser.FuncDecl, impl_fn: parser.FuncDecl, im: parser.ImplInfo): util.Diag[] {
  if (req.is_const == impl_fn.is_const) {
    return [];
  }
  if (req.is_const) {
    return [dg_at("E021", im.impl_type + "." + req.name + " is an associated constant of trait " + im.trait_name + "; bind it with `const " + req.name + ": " + parser.subst_self(req.ret_type, im.impl_type) + " = …;`, not a function", im.line, im.col)];
  }
  return [dg_at("E021", im.impl_type + "." + req.name + " is an associated function of trait " + im.trait_name + "; provide it with `function`, not a const", im.line, im.col)];
}

function e021_recv_method_idx(mod: parser.Module, ty: string, m: string): i32 {
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let f: parser.FuncDecl = mod.funcs[i];
    if (f.receiver_type.len() > 0 && f.name == m && util.base_type_name(f.receiver_type) == ty) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function e021_sig_matches(req: parser.FuncDecl, impl_fn: parser.FuncDecl, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): boolean {
  if (tparams.len() > 0 && parser.parse_type_ref(im.trait_ref).args.len() != tparams.len()) {
    return true;
  }
  if (req.type_params.len() > 0 || req.all_type_params.len() > 0) {
    return true;
  }
  if (impl_fn.type_params.len() > 0 || impl_fn.all_type_params.len() > 0) {
    return true;
  }
  if (!e021_self_matches(req, im, tparams, impls)) {
    return false;
  }
  let first: i32 = 0;
  if (req.params.len() > 0 && req.params[0].name == "self") {
    first = 1;
  }
  if (req.params.len() - first != impl_fn.params.len()) {
    return false;
  }
  let i: i32 = first;
  while (i < req.params.len()) {
    if (e021_req_spelling(req.params[i].type_name, im, tparams, impls) != impl_fn.params[i - first].type_name) {
      return false;
    }
    i = i + 1;
  }
  return e021_req_spelling(req.ret_type, im, tparams, impls) == impl_fn.ret_type;
}

function e021_wrong_sig(req: parser.FuncDecl, impl_fn: parser.FuncDecl, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): util.Diag {
  let want: string[] = [];
  let got: string[] = [];
  for p in req.params {
    if (p.name == "self" && p.type_name.len() == 0) {
      want = want.append(im.impl_type);
    } else {
      want = want.append(e021_req_spelling(p.type_name, im, tparams, impls));
    }
  }
  if (req.params.len() > 0 && req.params[0].name == "self") {
    got = got.append(impl_fn.receiver_type);
  }
  for p in impl_fn.params {
    got = got.append(p.type_name);
  }
  let expected: string = e021_sig_text(want, e021_req_spelling(req.ret_type, im, tparams, impls));
  return dg_at("E021", im.impl_type + "." + req.name + " has the wrong signature for trait " + im.trait_name + ": expected " + expected + ", got " + e021_sig_text(got, impl_fn.ret_type), im.line, im.col);
}

function e021_sig_text(params: string[], ret: string): string {
  let r: string = ret;
  if (r.len() == 0) {
    r = "void";
  }
  return "(" + comma_list(params) + ") => " + r;
}

function e021_self_matches(req: parser.FuncDecl, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): boolean {
  if (req.params.len() == 0 || req.params[0].name != "self" || req.params[0].type_name.len() == 0) {
    return true;
  }
  return e021_req_spelling(req.params[0].type_name, im, tparams, impls) == im.impl_type;
}

function e021_req_spelling(t: string, im: parser.ImplInfo, tparams: string[], impls: parser.ImplInfo[]): string {
  let spelled: string = parser.subst_self(t, im.impl_type);
  if (tparams.len() > 0) {
    spelled = dyn_ret_at_spelling(spelled, im.trait_ref, tparams);
  }
  return parser.resolve_proj_in_type(spelled, impls);
}

function e021_has_impl(mod: parser.Module, trait_name: string, impl_type: string): boolean {
  for imp in mod.impls {
    if (imp.trait_name == trait_name && imp.impl_type == impl_type) {
      return true;
    }
  }
  return false;
}

function e021_supertrait_impl(mod: parser.Module, spelling: string, self: string): boolean {
  let idx: i32 = trait_req_idx(util.base_type_name(spelling), mod.trait_reqs);
  if (idx < 0) {
    return false;
  }
  let req: parser.TraitReq = mod.trait_reqs[idx];
  let want: parser.TypeRef = parser.parse_type_ref(spelling);
  for imp in mod.impls {
    if (imp.trait_name != req.trait_name || imp.trait_module != req.module || imp.impl_type != self) {
      continue;
    }
    let got: parser.TypeRef = parser.parse_type_ref(imp.trait_ref);
    if (got.args.len() != want.args.len()) {
      continue;
    }
    let same: boolean = true;
    let i: i32 = 0;
    while (i < want.args.len()) {
      if (parser.render_type_ref(got.args[i]) != parser.render_type_ref(want.args[i])) {
        same = false;
      }
      i = i + 1;
    }
    if (same) {
      return true;
    }
  }
  return false;
}

function e021_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for req in mod.trait_reqs {
    for parent in req.supertraits {
      let idx: i32 = trait_req_idx(util.base_type_name(parent), mod.trait_reqs);
      if (idx >= 0) {
        let want: i32 = mod.trait_reqs[idx].type_params.len();
        let got: i32 = parser.parse_type_ref(parent).args.len();
        if (want != got) {
          out = out.append(dg("E021", "supertrait " + util.base_type_name(parent) + " expects " + util.i32_to_string(want) + " type arguments, got " + util.i32_to_string(got)));
        }
      }
    }
  }
  for im in mod.impls {
    let ir: parser.TypeRef = parser.parse_type_ref(im.impl_type);
    if (im.trait_name != "" && (ir.array_depth > 0 || ir.is_view)) {
      out = out.append(dg("E021", "`impl … for " + im.impl_type + "`: type must be a struct, enum, or built-in type"));
      continue;
    }
    for trait_req in mod.trait_reqs {
      if (trait_req.trait_name == im.trait_name && trait_req.module == im.trait_module) {
        let sup: string[] = trait_req.supertraits;
        for parent in sup {
          let elem: string = e021_req_spelling(parent, im, trait_req.type_params, mod.impls);
          if (!e021_supertrait_impl(mod, elem, im.impl_type)) {
            out = out.append(dg_at("E021", "impl " + im.trait_name + " for " + im.impl_type + " also requires `impl " + elem + " for " + im.impl_type + "` (supertrait of " + im.trait_name + ")", im.line, im.col));
          }
        }
        let im_base: string = util.base_type_name(im.impl_type);
        for at_req in trait_req.assoc_types {
          if (!name_in(at_req, im.assoc_names)) {
            out = out.append(dg_at("E021", "impl of " + im.trait_name + " for " + im_base + " must bind associated type \"" + at_req + "\" (`type " + at_req + " = …;`)", im.line, im.col));
          }
        }
        for at_bound in im.assoc_names {
          if (!name_in(at_bound, trait_req.assoc_types)) {
            out = out.append(dg_at("E021", "impl of " + im.trait_name + " for " + im_base + " binds associated type \"" + at_bound + "\" which the trait does not declare", im.line, im.col));
          }
        }
        let reqs: string[] = trait_req.methods;
        let sigs: parser.FuncDecl[] = trait_req.req_sigs;
        let ri: i32 = 0;
        while (ri < reqs.len()) {
          let midx: i32 = e021_recv_method_idx(mod, im.impl_type, reqs[ri]);
          if (!name_in(reqs[ri], im.method_names) && midx < 0) {
            if (ri < sigs.len() && sigs[ri].is_const) {
              out = out.append(dg_at("E021", im.impl_type + " does not implement " + im.trait_name + ": missing associated constant \"" + reqs[ri] + "\"", im.line, im.col));
            } else {
              out = out.append(dg_at("E021", im.impl_type + " does not implement " + im.trait_name + ": missing method \"" + reqs[ri] + "\"", im.line, im.col));
            }
          } else if (midx >= 0 && ri < sigs.len()) {
            let kind_dg: util.Diag[] = e021_const_kind_diags(sigs[ri], mod.funcs[midx], im);
            if (kind_dg.len() > 0) {
              out = util.append_diags(out, kind_dg);
            } else if (!e021_sig_matches(sigs[ri], mod.funcs[midx], im, trait_req.type_params, mod.impls)) {
              out = out.append(e021_wrong_sig(sigs[ri], mod.funcs[midx], im, trait_req.type_params, mod.impls));
            }
          }
          ri = ri + 1;
        }
        for ds in trait_req.default_sigs {
          let didx: i32 = e021_recv_method_idx(mod, im.impl_type, ds.name);
          let written: boolean = name_in(ds.name, im.method_names) && didx >= 0;
          if (written && e021_const_kind_diags(ds, mod.funcs[didx], im).len() > 0) {
            out = util.append_diags(out, e021_const_kind_diags(ds, mod.funcs[didx], im));
          } else if (written && !e021_sig_matches(ds, mod.funcs[didx], im, trait_req.type_params, mod.impls)) {
            out = out.append(e021_wrong_sig(ds, mod.funcs[didx], im, trait_req.type_params, mod.impls));
          } else if (!written && !e021_self_matches(ds, im, trait_req.type_params, mod.impls)) {
            out = out.append(dg_at("E021", im.impl_type + "." + ds.name + " has the wrong signature for trait " + im.trait_name, im.line, im.col));
          }
        }
      }
    }
  }
  return out;
}

function e021_derive_scalar(fty: string): boolean {
  return fty == "i32" || fty == "i64" || fty == "u8" || fty == "u32" || fty == "u64" || fty == "f32" || fty == "f64" || fty == "boolean" || fty == "char" || fty == "string";
}

function e021_derive_field_known(mod: parser.Module, fty: string): boolean {
  if (e021_derive_scalar(fty)) {
    return true;
  }
  for sd in mod.structs {
    if (sd.name == fty) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == fty) {
      return true;
    }
  }
  return false;
}

function e021_derive_conforms(mod: parser.Module, tr: string, treq_idx: i32, fty: string): boolean {
  if (e021_has_impl(mod, tr, fty)) {
    return true;
  }
  let reqs: string[] = mod.trait_reqs[treq_idx].methods;
  if (reqs.len() == 0) {
    return false;
  }
  for req in reqs {
    if (e021_recv_method_idx(mod, fty, req) < 0) {
      return false;
    }
  }
  return true;
}

function derive_trait_idx(tr: string, trait_reqs: parser.TraitReq[]): i32 {
  let dot: i32 = tr.len() - 1;
  while (dot >= 0 && tr[dot] != b'.') {
    dot = dot - 1;
  }
  let q: string = "";
  let name: string = tr;
  if (dot >= 0) {
    q = slice_unchecked(tr, 0, dot) + "";
    name = slice_unchecked(tr, dot + 1, tr.len()) + "";
  }
  let i: i32 = 0;
  while (i < trait_reqs.len()) {
    if (trait_reqs[i].trait_name == name && trait_reqs[i].module == q) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function derive_import_unloaded(mod: parser.Module, tr: string): boolean {
  let dot: i32 = tr.len() - 1;
  while (dot >= 0 && tr[dot] != b'.') {
    dot = dot - 1;
  }
  if (dot < 0) {
    return false;
  }
  let q: string = slice_unchecked(tr, 0, dot) + "";
  for r in mod.trait_reqs {
    if (r.module == q) {
      return false;
    }
  }
  for im in mod.imports {
    let qual: string = im.alias;
    if (qual.len() == 0) {
      let sl: i32 = im.path.len() - 1;
      while (sl >= 0 && im.path[sl] != b'/') {
        sl = sl - 1;
      }
      qual = slice_unchecked(im.path, sl + 1, im.path.len()) + "";
    }
    if (qual == q) {
      return true;
    }
  }
  return false;
}

function fromjson_field_shape(elem: string): boolean {
  if (elem.len() == 0 || parser.fromjson_container(elem) == "array") {
    return false;
  }
  if (elem[0] == b'(') {
    return false;
  }
  return !(elem.len() > 3 && slice_unchecked(elem, 0, 3) == "fn(");
}

function e021_derive_one_diag(mod: parser.Module, tr: string, tname: string, labels: string[], ftys: string[], tps: string[], ln: i32, cl: i32): util.Diag[] {
  let kind: string = parser.derive_simple_name(tr);
  let tidx: i32 = derive_trait_idx(tr, mod.trait_reqs);
  if (tidx < 0) {
    if (derive_import_unloaded(mod, tr)) {
      return [];
    }
    return [dg_at("E021", "@derive(" + tr + "): unknown trait", ln, cl)];
  }
  if (kind != "Eq" && kind != "Ord" && kind != "Hash" && kind != "Display" && kind != "Debug" && kind != "Json" && kind != "FromJson" && kind != "Default") {
    return [dg_at("E021", "cannot @derive(" + tr + "): only Eq, Display, Debug, Ord, Hash, Json, FromJson, and Default are derivable", ln, cl)];
  }
  let ctys: string[] = ftys;
  if (kind == "FromJson") {
    if (!module_imports_std_json(mod)) {
      return [dg_at("E021", "cannot @derive(" + tr + "): the decoder is std/json's; import \"std/json\"", ln, cl)];
    }
    ctys = [];
    let ei: i32 = 0;
    while (ei < ftys.len()) {
      let elem: string = parser.fromjson_elem(ftys[ei]);
      if (!fromjson_field_shape(elem)) {
        return [dg_at("E021", "cannot @derive(" + tr + ") for " + tname + ": " + labels[ei] + " has type " + ftys[ei] + "; FromJson decodes a field of a FromJson type, an array of one or an Option of one", ln, cl)];
      }
      ctys = ctys.append(elem);
      ei = ei + 1;
    }
  }
  let fi: i32 = 0;
  while (fi < ctys.len()) {
    let fty: string = receiver_namespace(ctys[fi]);
    let checked: boolean = kind != "Default" || !e021_derive_scalar(fty);
    if (checked && !name_in(fty, tps) && e021_derive_field_known(mod, fty)) {
      if (!e021_derive_conforms(mod, tr, tidx, fty)) {
        return [dg_at("E021", "cannot @derive(" + tr + ") for " + tname + ": " + labels[fi] + " of type " + fty + " does not implement " + tr + " — add `impl " + tr + " for " + fty + "` (or remove the derive)", ln, cl)];
      }
    }
    fi = fi + 1;
  }
  return [];
}

function module_imports_std_json(mod: parser.Module): boolean {
  for im in mod.imports {
    if (im.path == "std/json") {
      return true;
    }
  }
  return false;
}

function derive_method_name(kind: string): string {
  if (kind == "Display") {
    return "to_string";
  }
  if (kind == "Debug") {
    return "to_debug";
  }
  if (kind == "Json") {
    return "to_json";
  }
  if (kind == "FromJson") {
    return "from_json_value";
  }
  if (kind == "Eq") {
    return "eq";
  }
  if (kind == "Ord") {
    return "cmp";
  }
  if (kind == "Hash") {
    return "hash";
  }
  if (kind == "Default") {
    return "default";
  }
  return "";
}

function derive_body_suppressed(fn: parser.FuncDecl, keys: string[]): boolean {
  if (keys.len() == 0) {
    return false;
  }
  if (fn.line != 0 || fn.col != 0) {
    return false;
  }
  if (fn.receiver_type.len() == 0) {
    return false;
  }
  return name_in(fn.receiver_type + "." + fn.name, keys);
}

function e021_derive_field_diags(mod: parser.Module): (util.Diag[], string[]) {
  let out: util.Diag[] = [];
  let keys: string[] = [];
  for sd in mod.structs {
    if (sd.enum_owner.len() == 0 && sd.derives.len() > 0) {
      let labels: string[] = [];
      let ftys: string[] = [];
      for field in sd.fields {
        labels = labels.append("field " + field.name);
        ftys = ftys.append(field.type_name);
      }
      for derive in sd.derives {
        let sdd: util.Diag[] = e021_derive_one_diag(mod, derive, sd.name, labels, ftys, sd.type_params, sd.line, sd.col);
        if (sdd.len() > 0) {
          let smn: string = derive_method_name(parser.derive_simple_name(derive));
          if (smn.len() > 0) {
            keys = keys.append(sd.name + "." + smn);
          }
        }
        out = util.append_diags(out, sdd);
      }
    }
  }
  for ed in mod.enums {
    let elabels: string[] = [];
    let eftys: string[] = [];
    let ederives: string[] = [];
    for vs in mod.structs {
      if (vs.enum_owner == ed.name) {
        if (ederives.len() == 0) {
          ederives = vs.derives;
        }
        for field in vs.fields {
          elabels = elabels.append("variant " + vs.name + " payload");
          eftys = eftys.append(field.type_name);
        }
      }
    }
    for ederive in ederives {
      let edd: util.Diag[] = e021_derive_one_diag(mod, ederive, ed.name, elabels, eftys, ed.type_params, ed.line, ed.col);
      if (edd.len() > 0) {
        let emn: string = derive_method_name(parser.derive_simple_name(ederive));
        if (emn.len() > 0) {
          keys = keys.append(ed.name + "." + emn);
        }
      }
      out = util.append_diags(out, edd);
    }
  }
  return (out, keys);
}

function type_ref_mentions_self(t: parser.TypeRef): boolean {
  if (t.base == "Self") {
    return true;
  }
  for a in t.args {
    if (type_ref_mentions_self(a)) {
      return true;
    }
  }
  return false;
}

function type_mentions_self(type_name: string): boolean {
  return type_ref_mentions_self(parser.parse_type_ref(type_name));
}

function e021_object_unsafe_method(mod: parser.Module, trait_name: string): string {
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      let sigs: parser.FuncDecl[] = trait_req.req_sigs;
      for f in sigs {
        let i: i32 = 0;
        if (f.params.len() > 0 && f.params[0].name == "self") {
          i = 1;
        }
        while (i < f.params.len()) {
          if (type_mentions_self(f.params[i].type_name)) {
            return "method \"" + f.name + "\" takes Self as a non-receiver parameter";
          }
          i = i + 1;
        }
        if (type_mentions_self(f.ret_type)) {
          return "method \"" + f.name + "\" returns Self";
        }
      }
      return "";
    }
  }
  return "";
}

function e021_dyn_target(type_name: string): string {
  if (type_name.len() < 5 || slice_unchecked(type_name, 0, 4) != "dyn ") {
    return "";
  }
  let t: string = e021_dyn_element(type_name);
  let cut: i32 = e021_bracket_open(t);
  if (cut > 0) {
    return slice_unchecked(t, 0, cut) + "";
  }
  return t;
}

function e021_dyn_element(type_name: string): string {
  let t: str = slice_unchecked(type_name, 4, type_name.len());
  while (t.len() >= 2 && t[t.len() - 2] == b'[' && t[t.len() - 1] == b']') {
    t = slice_unchecked(t, 0, t.len() - 2);
  }
  return t + "";
}

function e021_bracket_open(t: string): i32 {
  if (t.len() < 2 || t[t.len() - 1] != b']') {
    return 0 - 1;
  }
  let bal: i32 = 0;
  let i: i32 = t.len() - 1;
  while (i >= 0) {
    if (t[i] == b']') {
      bal = bal + 1;
    } else if (t[i] == b'[') {
      bal = bal - 1;
      if (bal == 0) {
        return i;
      }
    }
    i = i - 1;
  }
  return 0 - 1;
}

function e021_dyn_pin_names(type_name: string): string[] {
  let out: string[] = [];
  if (type_name.len() < 5 || slice_unchecked(type_name, 0, 4) != "dyn ") {
    return out;
  }
  let t: string = e021_dyn_element(type_name);
  let open: i32 = e021_bracket_open(t);
  if (open < 0) {
    return out;
  }
  let inner: string = slice_unchecked(t, open + 1, t.len() - 1) + "";
  let start: i32 = 0;
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i <= inner.len()) {
    let at_end: boolean = i == inner.len();
    let is_sep: boolean = at_end;
    if (!at_end) {
      let c: u8 = inner[i];
      if (c == b'[') {
        depth = depth + 1;
      }
      if (c == b']') {
        depth = depth - 1;
      }
      if (c == b',' && depth == 0) {
        is_sep = true;
      }
    }
    if (is_sep) {
      let seg: string = slice_unchecked(inner, start, i) + "";
      let eq: i32 = 0 - 1;
      let j: i32 = 0;
      while (j < seg.len()) {
        if (seg[j] == b'=' && eq < 0) {
          eq = j;
        }
        j = j + 1;
      }
      if (eq > 0) {
        out = out.append(util.trim(slice_unchecked(seg, 0, eq) + ""));
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

function e021_object_unsafe_assoc(mod: parser.Module, trait_name: string, dyn_spelling: string): string {
  let pins: string[] = e021_dyn_pin_names(dyn_spelling);
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      for at in trait_req.assoc_types {
        if (!name_in(at, pins)) {
          return "associated type \"" + at + "\" is not pinned — write `dyn " + trait_name + "[" + at + " = ...]`";
        }
      }
      return "";
    }
  }
  return "";
}

function e021_object_safety_diags(mod: parser.Module, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  let seen: string[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    for site in e021_dyn_sites(fn) {
      if (e021_dyn_target(site.spelling).len() == 0) {
        continue;
      }
      for bound in parser.split_plus_bounds(e021_dyn_element(site.spelling)) {
        let spelling: string = util.trim(bound);
        let target_trait: string = parser.parse_type_ref(spelling).base;
        if (util.has_str(seen, target_trait)) {
          continue;
        }
        let reason: string = e021_object_unsafe_assoc(mod, target_trait, "dyn " + spelling);
        if (reason.len() == 0) {
          reason = e021_object_unsafe_method(mod, target_trait);
        }
        if (reason.len() > 0) {
          seen = seen.append(target_trait);
          let name: string = util.demangle(target_trait);
          out = out.append(dg_at("E021", "trait " + name + " is not object-safe: " + reason + ", so it cannot be used as `dyn " + name + "`", site.line, site.col));
        }
      }
    }
  }
  return out;
}

function e021_unknown_dyn_trait_diags(mod: parser.Module, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  let seen: string[] = [];
  let imports: string[] = import_paths_of(mod);
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    for site in e021_dyn_trait_sites(fn) {
      let base: string = site.spelling;
      if (!util.has_str(seen, base) && !bound_import_unloaded(base, imports, mod.trait_reqs) && bound_trait_req(base, fn.module, mod.trait_reqs) < 0) {
        seen = seen.append(base);
        out = out.append(dg_at("E021", "unknown trait \"" + util.demangle(bound_trait_display(base, fn.module, mod.trait_reqs)) + "\" in `dyn` type", site.line, site.col));
      }
    }
  }
  return out;
}

struct DynSite { spelling: string, line: i32, col: i32 }

function e021_dyn_sites(fn: parser.FuncDecl): DynSite[] {
  let sites: DynSite[] = [];
  for param in fn.params {
    sites = sites.append(DynSite { spelling: param.type_name, line: fn.line, col: fn.col });
  }
  sites = sites.append(DynSite { spelling: fn.ret_type, line: fn.line, col: fn.col });
  for stmt in fn.body {
    sites = astwalk.fold_stmt_nodes(stmt, sites, e021_dyn_site_at, e021_no_site, astwalk.descend_all);
  }
  return sites;
}

function e021_dyn_trait_sites(fn: parser.FuncDecl): DynSite[] {
  let out: DynSite[] = [];
  for site in e021_dyn_sites(fn) {
    if (e021_dyn_target(site.spelling).len() > 0) {
      for entry in parser.split_plus_bounds(e021_dyn_element(site.spelling)) {
        out = out.append(DynSite { spelling: parser.parse_type_ref(util.trim(entry)).base, line: site.line, col: site.col });
      }
    }
  }
  return out;
}

function e021_dyn_site_at(st: ast.Stmt, own a: DynSite[]): DynSite[] {
  match (st) {
    ast.StmtVar(v) => {
      if (e021_dyn_target(v.type_name).len() > 0) {
        return a.append(DynSite { spelling: v.type_name, line: v.line, col: v.col });
      }
      return a;
    },
    _ => {
      return a;
    }
  }
}

function e021_no_site(e: ast.Expr, own a: DynSite[]): DynSite[] {
  return a;
}

function e060_dyn_set_of(type_name: string): string {
  if (type_name.len() < 5 || slice_unchecked(type_name, 0, 4) != "dyn ") {
    return "";
  }
  let t: str = slice_unchecked(type_name, 4, type_name.len());
  if (t.len() >= 2 && t[t.len() - 2] == b'[' && t[t.len() - 1] == b']') {
    return "";
  }
  return t + "";
}

function e060_trait_known(mod: parser.Module, trait_name: string): boolean {
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      return true;
    }
  }
  return false;
}

function e060_trait_declares(mod: parser.Module, trait_name: string, m: string): boolean {
  for trait_req in mod.trait_reqs {
    if (trait_req.trait_name == trait_name) {
      return name_in(m, trait_req.methods);
    }
  }
  return false;
}

function e060_collect_dyn_locals(stmts: ast.Stmt[], acc: string[]): string[] {
  function at_stmt(st: ast.Stmt, own a: string[]): string[] {
    match (st) {
      ast.StmtVar(v) => {
        let out: string[] = a;
        let seen: i32 = 0;
        let k: i32 = 0;
        while (k < out.len()) {
          let e: string = out[k];
          let bar: i32 = 0;
          while (bar < e.len() && e[bar] != b'|') {
            bar = bar + 1;
          }
          if (slice_unchecked(e, 0, bar) == v.name) {
            out = out.with(k, v.name + "|");
            seen = 1;
          }
          k = k + 1;
        }
        if (seen == 0) {
          out = out.append(v.name + "|" + e060_dyn_set_of(v.type_name));
        }
        return out;
      },
      _ => {
        return a;
      }
    }
  }
  let res: string[] = acc;
  for stmt in stmts {
    res = astwalk.fold_stmt_nodes(stmt, res, at_stmt, (e: ast.Expr, own a: string[]) => a, astwalk.descend_all);
  }
  return res;
}

function e060_set_of_name(dyns: string[], name: string): string {
  for dy in dyns {
    let e: string = dy;
    let bar: i32 = 0;
    while (bar < e.len() && e[bar] != b'|') {
      bar = bar + 1;
    }
    if (slice_unchecked(e, 0, bar) == name) {
      return slice_unchecked(e, bar + 1, e.len()) + "";
    }
  }
  return "";
}

function e060_is_primitive_name(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u8" || t == "u32" || t == "u64" || t == "f32" || t == "f64" || t == "boolean" || t == "string" || t == "str" || t == "usize" || t == "char";
}

function e060_e062_stmts(stmts: ast.Stmt[], dyns: string[], mod: parser.Module, acc: util.Diag[]): util.Diag[] {
  function at_node(n: ast.Expr, own out: util.Diag[]): util.Diag[] {
    match (n) {
      ast.ExprUnary(u) => {
        if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
          match (u.operand) {
            ast.ExprIdent(id) => {
              let set: string = e060_set_of_name(dyns, id.name);
              if (set.len() > 0) {
                let tgt: str = slice_unchecked(u.op, 4, u.op.len());
                if (e060_is_primitive_name(tgt)) {
                  return out.append(dg_at("E060", "'as?' downcast target must be a concrete struct or enum type (slice 1), got " + tgt, u.line, u.col));
                }
                if (e060_decl_is_plain_struct(mod, tgt) || e060_decl_is_enum(mod, tgt)) {
                  let trs: string[] = parser.dyn_trait_set("dyn " + set);
                  let all_known: boolean = true;
                  let missing: string = "";
                  for tr in trs {
                    if (!e060_trait_known(mod, tr)) {
                      all_known = false;
                    } else if (!e021_has_impl(mod, tr, tgt)) {
                      if (missing.len() > 0) {
                        missing = missing + " + ";
                      }
                      missing = missing + tr;
                    }
                  }
                  if (all_known && missing.len() > 0) {
                    return out.append(dg_at("E060", tgt + " does not implement " + missing + ", so a 'dyn " + set + "' cannot downcast to it", u.line, u.col));
                  }
                }
              }
            },
            _ => {}
          }
        }
        return out;
      },
      ast.ExprCall(c) => {
        match (c.callee) {
          ast.ExprFieldAccess(fa) => {
            match (fa.obj) {
              ast.ExprIdent(rid) => {
                let rset: string = e060_set_of_name(dyns, rid.name);
                if (rset.len() > 0) {
                  let rtrs: string[] = parser.dyn_trait_set("dyn " + rset);
                  let declaring: string = "";
                  let n_decl: i32 = 0;
                  for rtr in rtrs {
                    if (e060_trait_declares(mod, rtr, fa.field)) {
                      if (n_decl > 0) {
                        declaring = declaring + ", ";
                      }
                      declaring = declaring + rtr;
                      n_decl = n_decl + 1;
                    }
                  }
                  if (rtrs.len() >= 2 && n_decl >= 2) {
                    return out.append(dg_at("E062", "ambiguous method \"" + fa.field + "\" on `dyn " + rset + "`: declared by traits " + declaring, fa.line, fa.col));
                  }
                  let assoc_owner: string = "";
                  for atr in rtrs {
                    if (assoc_owner.len() == 0) {
                      let ah: AssocHit = trait_assoc_req(mod.trait_reqs, atr, fa.field, []);
                      if (ah.found) {
                        assoc_owner = ah.owner;
                      }
                    }
                  }
                  if (assoc_owner.len() > 0) {
                    return out.append(dg_at("E021", "\"" + fa.field + "\" is an associated function of trait " + assoc_owner + ", not a method; it has no `self` receiver, so it cannot be called through a `dyn " + rset + "` value — call it on a concrete type", fa.line, fa.col));
                  }
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
        return out;
      },
      _ => {
        return out;
      }
    }
    return out;
  }
  let res: util.Diag[] = acc;
  for stmt in stmts {
    res = astwalk.fold_stmt(stmt, res, at_node);
  }
  return res;
}

function e060_decl_is_plain_struct(mod: parser.Module, name: string): boolean {
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return true;
    }
  }
  return false;
}

function e060_decl_is_enum(mod: parser.Module, name: string): boolean {
  if (name.len() == 0) {
    return false;
  }
  for sd in mod.structs {
    if (sd.enum_owner == name) {
      return true;
    }
  }
  return false;
}

function e060_e062_diags(mod: parser.Module, focus: util.NameIndex): util.Diag[] {
  let out: util.Diag[] = [];
  for fn in mod.funcs {
    if (!in_focus(focus, fn)) {
      continue;
    }
    let dyns: string[] = [];
    for param in fn.params {
      dyns = dyns.append(param.name + "|" + e060_dyn_set_of(param.type_name));
    }
    dyns = e060_collect_dyn_locals(fn.body, dyns);
    out = e060_e062_stmts(fn.body, dyns, mod, out);
  }
  return out;
}

function map_import_msg(): string {
  return "Map operations require `import \"core/map\";`";
}

function thin_map_import_diags(ds: util.Diag[]): util.Diag[] {
  let msg: string = map_import_msg();
  let seen: boolean = false;
  let out: util.Diag[] = [];
  for d in ds {
    if (d.code == "E001" && d.message == msg) {
      if (seen) {
        continue;
      }
      seen = true;
    }
    out = out.append(d);
  }
  return out;
}

struct Inst { name: string, cts: string[], depth: i32 }

function max_inst_depth(): i32 {
  return 64;
}

function spellable(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnknown(_) => {
      return false;
    },
    typeinfo.TypeErased(_) => {
      return false;
    },
    typeinfo.TypeFunc(_) => {
      return false;
    },
    typeinfo.TypeVoid(_) => {
      return false;
    },
    typeinfo.TypeArray(a) => {
      return spellable(a.elem);
    },
    typeinfo.TypeMap(m) => {
      return spellable(m.key) && spellable(m.value);
    },
    typeinfo.TypeTuple(tp) => {
      for elem in tp.elements {
        if (!spellable(elem)) {
          return false;
        }
      }
      return true;
    },
    typeinfo.TypeStruct(sd) => {
      for arg in sd.args {
        if (!spellable(arg)) {
          return false;
        }
      }
      return true;
    },
    typeinfo.TypeUnion(u) => {
      for arg in u.args {
        if (!spellable(arg)) {
          return false;
        }
      }
      return true;
    },
    _ => {
      return true;
    }
  }
  return true;
}

function template_index(gens: parser.FuncDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < gens.len()) {
    if (gens[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function call_inst(c: ast.ExprCall, s: Scope, gens: parser.FuncDecl[], depth: i32): Inst {
  let none: Inst = Inst { name: "", cts: [], depth: depth };
  if let ast.ExprIdent(id) = c.callee {
    if (s.defines(id.name)) {
      return none;
    }
    let sig: FuncSig = s.lookup_sig(id.name);
    if (sig.all_type_params.len() == 0) {
      return none;
    }
    let gi: i32 = template_index(gens, id.name);
    if (gi < 0) {
      return none;
    }
    let (bn, bt) = call_type_bindings(sig, c, s);
    let cts: string[] = [];
    for tp in gens[gi].all_type_params {
      let k: i32 = util.index_of_str(bn, tp);
      if (k < 0 || !spellable(bt[k])) {
        return none;
      }
      cts = cts.append(type_label(bt[k]));
    }
    return Inst { name: id.name, cts: cts, depth: depth };
  }
  return none;
}

function fn_value_inst(e: ast.Expr, dest: typeinfo.Type, s: Scope, gens: parser.FuncDecl[], depth: i32): Inst {
  let none: Inst = Inst { name: "", cts: [], depth: depth };
  let ast.ExprIdent(id) = e else {
    return none;
  };
  let typeinfo.TypeFunc(df) = dest else {
    return none;
  };
  let gi: i32 = template_index(gens, id.name);
  if (gi < 0 || !generic_fn_value_arg(e, s)) {
    return none;
  }
  let (bn, bt) = fn_value_binds(s.lookup_sig(id.name), df, s);
  let cts: string[] = [];
  for tp in gens[gi].all_type_params {
    let k: i32 = util.index_of_str(bn, tp);
    if (k < 0 || !spellable(bt[k])) {
      return none;
    }
    cts = cts.append(type_label(bt[k]));
  }
  return Inst { name: id.name, cts: cts, depth: depth };
}

function arg_value_insts(c: ast.ExprCall, s: Scope, gens: parser.FuncDecl[], depth: i32, own acc: Inst[]): Inst[] {
  let needs_dest: boolean = false;
  for a in c.args {
    if (generic_fn_value_arg(a, s)) {
      needs_dest = true;
    }
  }
  if (!needs_dest) {
    return acc;
  }
  if let ast.ExprIdent(cid) = c.callee {
    if (s.defines(cid.name)) {
      return acc;
    }
  }
  let dests: typeinfo.Type[] = s.call_param_types(c);
  let out: Inst[] = acc;
  let i: i32 = 0;
  while (i < c.args.len() && i < dests.len()) {
    if (generic_fn_value_arg(c.args[i], s)) {
      let inst: Inst = fn_value_inst(c.args[i], bound_param_dest(c, i, dests[i], s), s, gens, depth);
      if (inst.name.len() > 0) {
        out = out.append(inst);
      }
    }
    i = i + 1;
  }
  return out;
}

function calls_a_generic(stmts: ast.Stmt[], s: Scope): boolean {
  function at_call(n: ast.Expr, own hit: boolean): boolean {
    if (hit) {
      return true;
    }
    if let ast.ExprCall(c) = n {
      if let ast.ExprIdent(id) = c.callee {
        if (s.lookup_sig(id.name).all_type_params.len() > 0) {
          return true;
        }
      }
      for a in c.args {
        if (generic_fn_value_arg(a, s)) {
          return true;
        }
      }
    }
    return false;
  }
  let hit: boolean = false;
  for st in stmts {
    hit = astwalk.fold_stmt(st, hit, at_call);
  }
  return hit;
}

function inst_stmts(stmts: ast.Stmt[], s: Scope, gens: parser.FuncDecl[], depth: i32, acc: Inst[]): Inst[] {
  let out: Inst[] = acc;
  let cur: Scope = s;
  for st in stmts {
    out = inst_stmt(st, cur, gens, depth, out);
    cur = bind_stmt(st, cur);
  }
  return out;
}

function inst_stmt(st: ast.Stmt, cur: Scope, gens: parser.FuncDecl[], depth: i32, own acc: Inst[]): Inst[] {
  function at_node(n: ast.Expr, own a: Inst[]): Inst[] {
    match (n) {
      ast.ExprCall(c) => {
        let inst: Inst = call_inst(c, cur, gens, depth);
        let out: Inst[] = arg_value_insts(c, cur, gens, depth, a);
        if (inst.name.len() > 0) {
          return out.append(inst);
        }
        return out;
      },
      ast.ExprLambda(lm) => {
        return inst_stmts(lm.body, lambda_body_scope(lm, cur), gens, depth, a);
      },
      _ => {
        return a;
      }
    }
  }
  function not_into_lambda(n: ast.Expr): boolean {
    if let ast.ExprLambda(_) = n {
      return false;
    }
    return true;
  }
  let out: Inst[] = astwalk.fold_stmt_own_pruned(st, acc, at_node, not_into_lambda);
  match (st) {
    ast.StmtIf(f) => {
      out = inst_stmts(f.then_body, cur, gens, depth, out);
      out = inst_stmts(f.else_body, cur, gens, depth, out);
    },
    ast.StmtWhile(w) => {
      out = inst_stmts(w.body, cur, gens, depth, out);
    },
    ast.StmtFor(fr) => {
      out = inst_stmts(fr.body, for_body_scope(fr, cur), gens, depth, out);
    },
    ast.StmtMatch(m) => {
      let whole: typeinfo.Type = check_expr(m.scrutinee, cur);
      for arm in m.arms {
        out = inst_stmts(arm.body, annotate_arm_scope(arm, cur, whole), gens, depth, out);
      }
    },
    ast.StmtDefer(d) => {
      let one: ast.Stmt[] = [d.action];
      out = inst_stmts(one, cur, gens, depth, out);
    },
    _ => {}
  }
  return out;
}

function instantiated_clones(mod: parser.Module, env: ModuleEnv): parser.FuncDecl[] {
  let clones: parser.FuncDecl[] = [];
  let gens: parser.FuncDecl[] = [];
  for fd in mod.funcs {
    if (fd.receiver_name.len() == 0 && fd.all_type_params.len() > 0) {
      gens = gens.append(fd);
    }
  }
  if (gens.len() == 0) {
    return clones;
  }
  let msc: Scope = new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  let mf: parser.MFns = parser.mfns_of(mod.funcs, mod.structs, mod.enums, mod.impls);
  let pending: Inst[] = [];
  for fd in mod.funcs {
    if (fd.all_type_params.len() == 0) {
      pending = body_insts(fd, env, msc, gens, 0, pending);
    }
  }
  if (calls_a_generic(mod.top_stmts, msc)) {
    pending = inst_stmts(mod.top_stmts, msc, gens, 0, pending);
  }
  let keys: string[] = [];
  let wi: i32 = 0;
  while (wi < pending.len()) {
    let inst: Inst = pending[wi];
    wi = wi + 1;
    let spelled: string = "";
    for ct in inst.cts {
      if (spelled.len() > 0) {
        spelled = spelled + ";";
      }
      spelled = spelled + ct;
    }
    let key: string = inst.name + "__" + parser.sanitize_key(spelled);
    if (inst.depth >= max_inst_depth() || util.has_str(keys, key)) {
      continue;
    }
    keys = keys.append(key);
    let g: parser.FuncDecl = gens[template_index(gens, inst.name)];
    let routed: parser.FuncDecl = parser.FuncDecl { ...g, body: parser.route_bound_calls(g, inst.cts, env.trait_reqs, mf) };
    let cl: parser.FuncDecl = parser.instantiate_func(routed, key, g.all_type_params, inst.cts, mod.impls);
    clones = clones.append(cl);
    pending = body_insts(cl, env, msc, gens, inst.depth + 1, pending);
  }
  return clones;
}

function body_insts(fd: parser.FuncDecl, env: ModuleEnv, msc: Scope, gens: parser.FuncDecl[], depth: i32, acc: Inst[]): Inst[] {
  if (!calls_a_generic(fd.body, msc)) {
    return acc;
  }
  return inst_stmts(fd.body, build_func_scope(fd, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs), gens, depth, acc);
}

pub function check_module(raw_mod: parser.Module): ModuleTypes {
  return check_module_with_file(raw_mod, "");
}

pub function check_module_with_file(raw_mod: parser.Module, entry_file: string): ModuleTypes {
  return check_module_raw_floor(raw_mod, entry_file, false);
}

function admission_env(mod: parser.Module, entry_file: string, raw_floor: boolean): ModuleEnv {
  let env: ModuleEnv = module_env_with_file(mod, entry_file);
  if (raw_floor) {
    return env;
  }
  return ModuleEnv { ...env, sigs: SigTable { ...env.sigs, raw_allowed: false } };
}

function check_module_raw_floor(raw_mod: parser.Module, entry_file: string, raw_floor: boolean): ModuleTypes {
  let mt: ModuleTypes = checked_module(raw_mod, entry_file, raw_floor);
  if (mt.diags.len() == 0) {
    return mt;
  }
  let mangled: util.NameIndex = util.name_index(imported_decl_names(raw_mod));
  let named: util.Diag[] = [];
  for d in mt.diags {
    named = named.append(source_named_diag(d, mangled));
  }
  return ModuleTypes { ...mt, diags: named };
}

// source_named_diag spells each name an imported module declares as its
// source does, `iter.ArrayIter` for the bundle's `iter__ArrayIter`.
function source_named_diag(d: util.Diag, mangled: util.NameIndex): util.Diag {
  let related: util.Related[] = [];
  for r in d.related {
    related = related.append(util.Related { ...r, message: util.demangle_named(r.message, mangled) });
  }
  return util.Diag { ...d, message: util.demangle_named(d.message, mangled), related: related };
}

// imported_decl_names is every bundle name an imported module's declaration
// carries; an entry-module name is never mangled, whatever it contains.
function imported_decl_names(mod: parser.Module): string[] {
  let out: string[] = [];
  for fd in mod.funcs {
    out = with_mangled(out, fd.name, fd.module);
  }
  for sd in mod.structs {
    out = with_mangled(out, sd.name, sd.module);
  }
  for ed in mod.enums {
    out = with_mangled(out, ed.name, ed.module);
  }
  for a in mod.aliases {
    out = with_mangled(out, a.name, a.module);
  }
  for sight in mod.sights {
    for td in mod.trait_decls {
      out = with_mangled(out, td.name, sight.module);
    }
  }
  return out;
}

function with_mangled(out: string[], name: string, prefix: string): string[] {
  if (prefix.len() == 0 || !util.str_has_prefix(name, prefix + "__")) {
    return out;
  }
  return out.append(name);
}

function checked_module(raw_mod: parser.Module, entry_file: string, raw_floor: boolean): ModuleTypes {
  let (filled, fda_diags) = parser.fill_default_args_with_diags(raw_mod);
  let mod: parser.Module = prepared_module(filled);
  let env: ModuleEnv = admission_env(mod, entry_file, raw_floor);
  let mt: ModuleTypes = check_module_pass(mod, env, fda_diags, []);
  if (mt.diags.len() > 0) {
    return mt;
  }
  let clones: parser.FuncDecl[] = instantiated_clones(mod, env);
  if (clones.len() == 0) {
    return mt;
  }
  let funcs: parser.FuncDecl[] = mod.funcs;
  let names: string[] = [];
  for cl in clones {
    funcs = funcs.append(cl);
    names = names.append(cl.name);
  }
  let cmod: parser.Module = parser.Module { ...mod, funcs: funcs };
  let rt: ModuleTypes = check_module_pass(cmod, admission_env(cmod, entry_file, raw_floor), [], names);
  if (rt.diags.len() == 0) {
    return mt;
  }
  return ModuleTypes { ...mt, all_well_typed: false, diags: rt.diags };
}

function in_focus(focus: util.NameIndex, fd: parser.FuncDecl): boolean {
  return focus.names.len() == 0 || focus.find(fd.name) >= 0;
}

function prepared_module(filled: parser.Module): parser.Module {
  let revalued: parser.Module = pretype_module(settle_literal_locals(filled));
  return parser.Module { ...revalued, structs: parser.inject_builtin_enums(revalued.structs) };
}

function check_module_pass(mod: parser.Module, env: ModuleEnv, fda_diags: util.Diag[], focus_names: string[]): ModuleTypes {
  let focus: util.NameIndex = util.name_index(focus_names);
  let imports: Imports = env.imports;
  let rnames: string[] = env.structs.resources.names;
  let st: SigTable = env.sigs;
  let stt: StructTable = env.structs;
  let ut: UnionTable = env.unions;
  let methods: MethodTable = env.methods;
  let sigs: FuncSig[] = st.sigs;
  let structs: StructSig[] = stt.structs;
  let unions: UnionSig[] = ut.unions;
  let union_names: string[] = ut.index.names;
  let well_typed: boolean = true;
  if (!validate_union_sigs(unions, stt.index.names)) {
    well_typed = false;
  }
  let body_diags: util.Diag[] = [];
  let ambig: string[] = ambiguous_variants(ut);
  let mc_on: boolean = mc_any_marked(mod.structs, mod.enums);
  let (derive_diags, derive_keys) = e021_derive_field_diags(mod);
  let call_impls: parser.ImplInfo[] = env.impls;
  let slc_fns: parser.FuncDecl[] = [];
  let slc_scopes: Scope[] = [];
  let slc_sums: ViewSum[] = [];
  for cfn in mod.funcs {
    slc_fns = slc_fns.append(cfn);
    slc_scopes = slc_scopes.append(build_func_scope(cfn, st, stt, ut, methods, imports, call_impls, mod.trait_reqs));
    slc_sums = slc_sums.append(ViewSum { key: view_sum_key(cfn), flags: __alloc_bool(view_positions(cfn).len()), fresh: false });
  }
  let slc_ix: ViewIndex = view_index(slc_sums);
  let slc_calls: util.NameIndex[] = [];
  for cfn in mod.funcs {
    slc_calls = slc_calls.append(util.name_index(slc_call_names(cfn)));
  }
  let slc_no_names: string[] = [];
  let slc_marked: util.NameIndex = util.name_index(slc_no_names);
  let slc_first: boolean = true;
  while (slc_first || slc_marked.names.len() > 0) {
    let slc_now: string[] = [];
    let sj: i32 = 0;
    while (sj < slc_fns.len()) {
      if (!slc_first && !slc_calls_any(slc_calls[sj], slc_marked)) {
        sj = sj + 1;
        continue;
      }
      let sjw: SlcWalk = slice_escape_diags(slc_fns[sj], slc_scopes[sj], slc_sums, slc_ix);
      let slc_positions: string[] = view_positions(slc_fns[sj]);
      let slc_cur: ViewSum = slc_sums[sj];
      let slc_next: boolean[] = slc_cur.flags;
      let slc_changed: boolean = false;
      let sp: i32 = 0;
      while (sp < slc_positions.len() && sp < slc_next.len()) {
        if (!slc_next[sp] && name_in(slc_positions[sp], sjw.viewed)) {
          slc_next = slc_next.with(sp, true);
          slc_changed = true;
        }
        sp = sp + 1;
      }
      let slc_fresh: boolean = slc_cur.fresh;
      if (!slc_fresh && sjw.owns) {
        slc_fresh = true;
        slc_changed = true;
      }
      if (slc_changed) {
        slc_now = slc_now.append(slc_fns[sj].name);
      }
      slc_sums = slc_sums.with(sj, ViewSum { key: slc_cur.key, flags: slc_next, fresh: slc_fresh });
      sj = sj + 1;
    }
    slc_first = false;
    slc_marked = util.name_index(slc_now);
  }
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    if (!in_focus(focus, mod.funcs[i]) || derive_body_suppressed(mod.funcs[i], derive_keys)) {
      i = i + 1;
      continue;
    }
    let fsc: Scope = slc_scopes[i];
    if (!check_func_body(mod.funcs[i], fsc)) {
      well_typed = false;
    }
    let dbody: ast.Stmt[] = mod.funcs[i].body;
    let function_diags: util.Diag[] = [];
    if (mod.funcs[i].ret_type == "void") {
      function_diags = util.append_diags(function_diags, void_ret_diags(dbody, fsc, unions));
    } else if (mod.funcs[i].ret_type.len() > 0) {
      let rty: typeinfo.Type = fsc.ret_type;
      let rname: string = mod.funcs[i].ret_type;
      if (is_unknown(rty) && util.index_of_str(fsc.tparams, rname) < 0 && e064_unknown_bare(rname, fsc.type_names())) {
        rty = typeinfo.TypeStruct { name: rname, args: [] };
      }
      function_diags = util.append_diags(function_diags, ret_diags(dbody, fsc, rty, unions));
      if (mod.funcs[i].import_iface.len() == 0 && !block_exits(mod.funcs[i].body, fsc.defines("exit"))) {
        function_diags = function_diags.append(dg_at("E052", "missing return: \"" + mod.funcs[i].name + "\" has return type " + mod.funcs[i].ret_type + " but can fall off the end without returning a value", mod.funcs[i].line, mod.funcs[i].col));
      }
    }
    if (mod.funcs[i].ret_type.len() == 0 && mod.funcs[i].receiver_type.len() == 0
      && mod.funcs[i].all_type_params.len() == 0 && !mod.funcs[i].is_const
      && mod.funcs[i].import_iface.len() == 0 && !block_exits(dbody, fsc.defines("exit"))) {
      let inferred: typeinfo.Type = exit_result(dbody, fsc);
      if (!is_unknown(inferred) && !is_void(inferred)) {
        function_diags = function_diags.append(dg_at("E052", "missing return: \"" + mod.funcs[i].name + "\" has return type " + type_label(inferred) + " but can fall off the end without returning a value", mod.funcs[i].line, mod.funcs[i].col));
      }
    }
    if (parser.spelling_is_view(mod.funcs[i].ret_type)) {
      function_diags = util.append_diags(function_diags, slice_escape_diags(mod.funcs[i], fsc, slc_sums, slc_ix).diags);
    }
    if (mc_on) {
      function_diags = util.append_diags(function_diags, must_consume_diags(mod.funcs[i], fsc, mod.structs, mod.enums));
    }
    function_diags = util.append_diags(function_diags, lret_stmts(dbody, fsc, unions));
    function_diags = util.append_diags(function_diags, mx_stmts(dbody, fsc, unions, mod.enums));
    function_diags = util.append_diags(function_diags, stmts_slit_diags(dbody, stt));
    function_diags = util.append_diags(function_diags, stmts_call_diags(dbody, fsc));
    function_diags = util.append_diags(function_diags, stmts_assign_diags(dbody, fsc, unions));
    function_diags = util.append_diags(function_diags, loop_diags(dbody, false, []));
    function_diags = util.append_diags(function_diags, dupvar_diags(dbody));
    function_diags = util.append_diags(function_diags, suffix_range_stmts(dbody));
    function_diags = util.append_diags(function_diags, match_diags(dbody, stt, ut));
    let pdi: i32 = 0;
    while (pdi < mod.funcs[i].params.len()) {
      if (mod.funcs[i].params[pdi].has_default) {
        function_diags = util.append_diags(function_diags, keep_code(mx_expr(mod.funcs[i].params[pdi].default_value, new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs), unions, mod.enums), "P002"));
      }
      pdi = pdi + 1;
    }
    let pai2: i32 = 0;
    while (pai2 < mod.funcs[i].params.len()) {
      function_diags = util.append_diags(function_diags, type_arity_diag(mod.funcs[i].params[pai2].type_name, mod.structs, mod.enums));
      pai2 = pai2 + 1;
    }
    function_diags = util.append_diags(function_diags, type_arity_diag(mod.funcs[i].ret_type, mod.structs, mod.enums));
    for annot in collect_annots(mod.funcs[i].body) {
      function_diags = util.append_diags(function_diags, type_arity_diag(annot.type_name, mod.structs, mod.enums));
    }
    if (ambig.len() > 0) {
      function_diags = util.append_diags(function_diags, vref_stmts(dbody, fsc, ambig));
    }
    body_diags = util.append_diags(body_diags, body_source_order(function_diags));
    i = i + 1;
  }
  let s: Scope = new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
  let top_tys: typeinfo.Type[] = [];
  for top_stmt in mod.top_stmts {
    let r: CheckResult = check_stmt(top_stmt, s);
    s = r.scope;
    if (is_unknown(r.ty)) {
      well_typed = false;
    }
    top_tys = top_tys.append(r.ty);
  }
  let dtop: ast.Stmt[] = mod.top_stmts;
  let tsc: Scope = new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
  body_diags = util.append_diags(body_diags, lret_stmts(dtop, tsc, unions));
  body_diags = util.append_diags(body_diags, mx_stmts(dtop, tsc, unions, mod.enums));
  body_diags = util.append_diags(body_diags, stmts_slit_diags(dtop, stt));
  body_diags = util.append_diags(body_diags, stmts_call_diags(dtop, tsc));
  body_diags = util.append_diags(body_diags, stmts_assign_diags(dtop, tsc, unions));
  if (ambig.len() > 0) {
    body_diags = util.append_diags(body_diags, vref_stmts(dtop, tsc, ambig));
  }
  body_diags = util.append_diags(body_diags, loop_diags(dtop, false, []));
  body_diags = util.append_diags(body_diags, dupvar_diags(dtop));
  body_diags = util.append_diags(body_diags, suffix_range_stmts(dtop));
  body_diags = util.append_diags(body_diags, match_diags(dtop, stt, ut));
  if (is_script(mod)) {
    body_diags = util.append_diags(body_diags, ret_diags(dtop, tsc, t_i32(), unions));
  }
  for sd in mod.structs {
    for field in sd.fields {
      body_diags = util.append_diags(body_diags, type_arity_diag(field.type_name, mod.structs, mod.enums));
    }
  }
  let signature_diags: util.Diag[] = [];
  let e064_extra: string[] = [];
  let e064_traits: string[] = [];
  for trait_req in mod.trait_reqs {
    e064_extra = e064_extra.append(trait_req.trait_name);
    e064_traits = e064_traits.append(trait_req.trait_name);
    if (trait_req.module.len() > 0) {
      e064_traits = e064_traits.append(trait_req.module + "__" + trait_req.trait_name);
    }
  }
  for imp in mod.impls {
    e064_extra = e064_extra.append(imp.trait_name);
  }
  for resource in mod.resources {
    e064_extra = e064_extra.append(resource.name);
  }
  let e064_tn: TypeNames = with_spellings(type_names(declared_struct_names(mod.structs), union_names, rnames), mod);
  for efn in mod.funcs {
    if (in_focus(focus, efn) && efn.receiver_name.len() == 0) {
      let efn_tps: string[] = e064_fn_tparams(efn);
      for param in efn.params {
        let pu: string = e064_unknown_name(e064_decl_spelling(param.type_name, param.fn_ret, param.fn_param_types), e064_tn, e064_extra, efn_tps);
        if (pu.len() > 0) {
          signature_diags = signature_diags.append(dg_at("E064", "cannot find type \"" + util.demangle(pu) + "\" in this scope" + unknown_type_hint(pu, e064_traits), efn.line, efn.col));
        }
      }
      let ru: string = e064_unknown_name(e064_decl_spelling(efn.ret_type, efn.ret_fn_ret, efn.ret_fn_param_types), e064_tn, e064_extra, efn_tps);
      if (ru.len() > 0) {
        signature_diags = signature_diags.append(dg_at("E064", "cannot find type \"" + util.demangle(ru) + "\" in this scope" + unknown_type_hint(ru, e064_traits), efn.line, efn.col));
      }
      let efn_annots: Annot[] = collect_annots(efn.body);
      signature_diags = util.append_diags(signature_diags, e064_annot_diags(efn_annots, e064_tn, e064_extra, efn_tps, e064_traits));
    }
    if (in_focus(focus, efn)) {
      signature_diags = util.append_diags(signature_diags, e057_fn_diags(efn, tsc));
    }
  }
  signature_diags = util.append_diags(signature_diags, handle_type_diags(mod, focus, e064_tn));
  let e044_void_fns: string[] = [];
  for func in mod.funcs {
    if (func.receiver_name.len() == 0 && func.ret_type == "void") {
      e044_void_fns = e044_void_fns.append(func.name);
    }
  }
  for func in mod.funcs {
    if (in_focus(focus, func)) {
      body_diags = util.append_diags(body_diags, e044_diags(func, e044_void_fns));
    }
  }
  let fip_names: string[] = [];
  let fbip_names: string[] = [];
  let str_ret_names: string[] = [];
  for func in mod.funcs {
    if (func.fip) {
      fip_names = fip_names.append(func.name);
    }
    if (func.fbip) {
      fbip_names = fbip_names.append(func.name);
    }
    if (func.ret_type == "str") {
      str_ret_names = str_ret_names.append(func.name);
    }
  }
  let e053_variants: string[] = [];
  for union in unions {
    for variant in union.variants {
      e053_variants = e053_variants.append(variant);
    }
  }
  let e065_fns: parser.FuncDecl[] = [];
  let e065_scopes: Scope[] = [];
  let e065_sums: ViewSum[] = [];
  for sfn in mod.funcs {
    if (sfn.ret_type == "str" || sfn.ret_type == "string") {
      e065_fns = e065_fns.append(sfn);
      e065_scopes = e065_scopes.append(build_func_scope(sfn, st, stt, ut, methods, imports, call_impls, mod.trait_reqs));
      e065_sums = e065_sums.append(ViewSum { key: view_sum_key(sfn), flags: __alloc_bool(view_positions(sfn).len()), fresh: false });
    }
  }
  let e065_ix: ViewIndex = view_index(e065_sums);
  let e065_changed: boolean = true;
  while (e065_changed) {
    e065_changed = false;
    let si: i32 = 0;
    while (si < e065_fns.len()) {
      let sw: E065Walk = e065_diags(e065_fns[si], str_ret_names, e065_sums, e065_ix, e065_scopes[si]);
      let positions: string[] = view_positions(e065_fns[si]);
      let cur_sum: ViewSum = e065_sums[si];
      let next_flags: boolean[] = cur_sum.flags;
      let pi: i32 = 0;
      while (pi < positions.len() && pi < next_flags.len()) {
        if (!next_flags[pi] && e065_ident_in(positions[pi], sw.viewed)) {
          next_flags = next_flags.with(pi, true);
          e065_changed = true;
        }
        pi = pi + 1;
      }
      let e065_fresh: boolean = cur_sum.fresh;
      if (!e065_fresh && sw.owns) {
        e065_fresh = true;
        e065_changed = true;
      }
      e065_sums = e065_sums.with(si, ViewSum { key: cur_sum.key, flags: next_flags, fresh: e065_fresh });
      si = si + 1;
    }
  }
  for xfn in mod.funcs {
    if (!in_focus(focus, xfn)) {
      continue;
    }
    let xsc: Scope = build_func_scope(xfn, st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
    for param in xfn.params {
      body_diags = util.append_diags(body_diags, e045_annot_diags(param.type_name, xfn.line, xfn.col, xsc));
    }
    body_diags = util.append_diags(body_diags, e045_annot_diags(xfn.ret_type, xfn.line, xfn.col, xsc));
    for an in lambda_annots(xfn.body) {
      body_diags = util.append_diags(body_diags, e045_annot_diags(an.type_name, an.line, an.col, xsc));
    }
    if (xfn.fip || xfn.fbip) {
      body_diags = util.append_diags(body_diags, e053_diags(xfn, util.append_all(fip_names, fip_builtin_callees(mod.funcs)), fbip_names, e053_variants, xsc));
    }
    if (xfn.ret_type == "str") {
      body_diags = util.append_diags(body_diags, e065_diags(xfn, str_ret_names, e065_sums, e065_ix, xsc).diags);
    }
  }
  let fld_scope: Scope = new_scope_full(st, stt, ut, methods, imports, call_impls, mod.trait_reqs);
  for esd in mod.structs {
    for field in esd.fields {
      body_diags = util.append_diags(body_diags, e045_annot_diags(field.type_name, esd.line, esd.col, fld_scope));
    }
  }
  for esd in mod.structs {
    if (esd.type_params.len() == 0 && esd.enum_owner.len() == 0) {
      for field in esd.fields {
        let fu: string = e064_unknown_name(e064_decl_spelling(field.type_name, field.fn_ret, field.fn_param_types), e064_tn, e064_extra, esd.type_params);
        if (fu.len() > 0) {
          body_diags = body_diags.append(dg_at("E064", "cannot find type \"" + util.demangle(fu) + "\" in this scope" + unknown_type_hint(fu, e064_traits), esd.line, esd.col));
        }
      }
    }
    body_diags = util.append_diags(body_diags, e057_struct_diags(esd, mod.enums, fld_scope));
  }
  body_diags = util.append_diags(body_diags, e085_decl_diags(mod, focus, e064_tn));
  let cgd: util.Diag[] = const_init_diags(mod);
  if (cgd.len() > 0) {
    return ModuleTypes { sigs: sigs, top_tys: top_tys, all_well_typed: false, diags: cgd };
  }
  let decl_diags: util.Diag[] = [];
  if (focus_names.len() == 0) {
    decl_diags = util.append_diags(util.append_diags(collect_decl_diags(mod), util.append_diags(orphan_impl_diags(mod), util.append_diags(e021_diags(mod), bound_decl_diags(mod)))), derive_diags);
  }
  let leading: util.Diag[] = util.append_diags(fda_diags, decl_diags);
  leading = util.append_diags(leading, signature_diags);
  leading = util.append_diags(leading, e021_object_safety_diags(mod, focus));
  leading = util.append_diags(leading, e021_unknown_dyn_trait_diags(mod, focus));
  let dd: util.Diag[] = thin_map_import_diags(util.append_diags(util.append_diags(util.append_diags(leading, body_diags), own_diags(mod, env, focus)), util.append_diags(e049_diags(mod, env, focus), e060_e062_diags(mod, focus))));
  if (dd.len() > 0) {
    well_typed = false;
  }
  return ModuleTypes { sigs: sigs, top_tys: top_tys, all_well_typed: well_typed, diags: dd };
}

function body_source_order(diags: util.Diag[]): util.Diag[] {
  let out: util.Diag[] = [];
  let exits: util.Diag[] = [];
  for d in diags {
    if (d.code == "E052") {
      exits = exits.append(d);
    } else {
      out = out.append(d);
      let i: i32 = out.len() - 1;
      while (i > 0 && (out[i].line < out[i - 1].line || out[i].line == out[i - 1].line && out[i].col < out[i - 1].col)) {
        let previous: util.Diag = out[i - 1];
        out = out.with(i - 1, out[i]).with(i, previous);
        i = i - 1;
      }
    }
  }
  return util.append_diags(out, exits);
}

pub struct ModuleEnv { sigs: SigTable, structs: StructTable, unions: UnionTable, methods: MethodTable, imports: Imports, impls: parser.ImplInfo[], trait_reqs: parser.TraitReq[] }

function module_env(mod: parser.Module): ModuleEnv {
  return module_env_with_file(mod, "");
}

function module_env_with_file(mod: parser.Module, entry_file: string): ModuleEnv {
  let rnames: string[] = resource_names(mod);
  let structs: StructSig[] = collect_struct_sigs(parser.inject_builtin_enums(mod.structs), declared_union_names(mod), rnames);
  let unions: UnionSig[] = collect_union_sigs(mod);
  for ed in mod.enums {
    unions = unions.append(enum_union_sig(ed));
  }
  let union_names: string[] = union_sig_names(unions);
  let tn: TypeNames = with_spellings(type_names(type_head_names(structs, union_names), union_names, rnames), mod);
  let sigs: FuncSig[] = collect_func_sigs(mod.funcs, tn);
  let methods: MethodSig[] = collect_method_sigs(mod.funcs, tn);
  if (entry_file.len() > 0) {
    let named: MethodSig[] = [];
    for m in methods {
      if (m.file.len() == 0 && m.line > 0) {
        named = named.append(MethodSig { ...m, file: entry_file + ":" });
      } else {
        named = named.append(m);
      }
    }
    methods = named;
  }
  return ModuleEnv {
    sigs: sig_table(sigs),
    structs: struct_table(structs, union_names, rnames, tn.spellings),
    unions: union_table(unions),
    methods: method_table(methods),
    imports: module_imports(mod),
    impls: assoc_func_impls(mod.impls, mod.funcs),
    trait_reqs: mod.trait_reqs,
  };
}

pub function expr_type(e: ast.Expr, s: Scope): typeinfo.Type {
  return check_expr(e, s);
}

pub function binary_types(b: ast.ExprBinary, s: Scope): (typeinfo.Type, typeinfo.Type, typeinfo.Type) {
  let lt: typeinfo.Type = check_expr(b.left, s);
  let rt: typeinfo.Type = check_expr(b.right, s);
  if (b.op == "__named_arg") {
    return (rt, lt, rt);
  }
  return (binary_result_type(b, lt, rt, s), lt, rt);
}

pub function scope_type(s: Scope, name: string): typeinfo.Type {
  return s.lookup(name);
}

pub function func_type_params(s: Scope, name: string): string[] {
  let sig: FuncSig = s.lookup_sig(name);
  if (sig.name.len() > 0) {
    return sig.all_type_params;
  }
  let dot: i32 = name.len() - 1;
  while (dot > 0 && name[dot] != b'.') {
    dot = dot - 1;
  }
  if (dot <= 0) {
    return sig.all_type_params;
  }
  return s.lookup_method(slice_unchecked(name, dot + 1, name.len()) + "", slice_unchecked(name, 0, dot) + "").all_type_params;
}

pub function spelled_type(s: Scope, spelling: string): typeinfo.Type {
  return s.resolve_type(spelling);
}

pub function signature_receiver(s: Scope, sig: FuncSig): typeinfo.Type {
  return type_from_name_erasing_tparams(sig.receiver, sig.all_type_params, s.type_names());
}

pub function struct_sig(s: Scope, name: string): StructSig {
  return s.lookup_struct(name);
}

pub function variant_owner_of(s: Scope, name: string): string {
  return scope_variant_owner(name, s);
}

pub function variant_sig(s: Scope, name: string, owner: string): StructSig {
  let sig: StructSig = s.lookup_owned_struct(name, owner);
  if (sig.enum_owner != owner) {
    return s.lookup_struct("");
  }
  return sig;
}

pub function instantiated_variant(sig: StructSig, s: Scope, whole: typeinfo.Type): StructSig {
  if let typeinfo.TypeUnion(u) = whole {
    let us: UnionSig = s.lookup_union(u.name);
    if (sig.enum_owner == u.name && us.type_params.len() > 0 && us.type_params.len() == u.args.len()) {
      let types: typeinfo.Type[] = [];
      for spelling in sig.field_type_names {
        types = types.append(type_from_ref_subst(parser.parse_type_ref(spelling), us.type_params, u.args, s.type_names()));
      }
      return StructSig { ...sig, field_types: types };
    }
  }
  return sig;
}

pub function union_sig(s: Scope, name: string): UnionSig {
  return s.lookup_union(name);
}

pub function owned_variant_names(s: Scope, owner: string): string[] {
  let out: string[] = [];
  if (owner.len() == 0) {
    return out;
  }
  for sig in s.structs.structs {
    if (sig.enum_owner == owner) {
      out = out.append(sig.name);
    }
  }
  return out;
}

pub function variant_shape_sig(s: Scope, name: string, owner: string): StructSig {
  let owned: StructSig = s.lookup_owned_struct(name, owner);
  if (owned.enum_owner == owner) {
    return owned;
  }
  let plain: StructSig = s.lookup_struct(name);
  if (plain.name.len() > 0 && plain.enum_owner.len() == 0 && is_variant_of(name, owner, s.unions.unions)) {
    return plain;
  }
  return s.lookup_struct("");
}

// An earlier return exits the function and does not determine the block type.
// Integer literal tails retain their polymorphic type for the receiver.
function value_block_tail_type(body: ast.Stmt[], s: Scope): typeinfo.Type {
  if (body.len() == 0) {
    return t_unknown("empty value block");
  }
  if let ast.StmtUnknown(u) = body[body.len() - 1] {
    if (u.kind == "value branch has no trailing expression") {
      return t_unknown("missing block value");
    }
  }
  if (parser.branch_exits_early(body)) {
    return typeinfo.TypeNever { tag: 0 };
  }
  if let ast.StmtReturn(r) = body[body.len() - 1] {
    if (parser.bare_return(r.value)) {
      return t_unknown("value block tail");
    }
    let bs: Scope = s;
    let i: i32 = 0;
    while (i < body.len() - 1) {
      bs = bind_stmt(body[i], bs);
      i = i + 1;
    }
    let t: typeinfo.Type = check_expr(r.value, bs);
    if (int_literal_tree(r.value)) {
      return unsettled_marked(t, r.value, bs.lit_locals, true);
    }
    if (!names_whole_type(t, bs)) {
      return t_unknown("value block tail");
    }
    return t;
  }
  return t_unknown("value block tail");
}

pub function first_returned(body: ast.Stmt[], scope: Scope): (ast.Expr, Scope) {
  let none: ast.Expr = ast.ExprUnknown { kind: parser.BARE_RETURN, line: 0, col: 0 };
  for st in body {
    match (st) {
      ast.StmtReturn(r) => {
        if (!parser.bare_return(r.value)) {
          return (r.value, scope);
        }
      },
      ast.StmtIf(f) => {
        let (t, ts) = first_returned(f.then_body, scope);
        if (!parser.bare_return(t)) {
          return (t, ts);
        }
        let (e, es) = first_returned(f.else_body, scope);
        if (!parser.bare_return(e)) {
          return (e, es);
        }
      },
      ast.StmtWhile(w) => {
        let (v, vs) = first_returned(w.body, scope);
        if (!parser.bare_return(v)) {
          return (v, vs);
        }
      },
      ast.StmtFor(fo) => {
        let (v, vs) = first_returned(fo.body, for_body_scope(fo, scope));
        if (!parser.bare_return(v)) {
          return (v, vs);
        }
      },
      ast.StmtMatch(m) => {
        let whole: typeinfo.Type = expr_type(m.scrutinee, scope);
        for a in m.arms {
          let (v, vs) = first_returned(a.body, arm_scope(a, scope, whole));
          if (!parser.bare_return(v)) {
            return (v, vs);
          }
        }
      },
      _ => {}
    }
    scope = bind_stmt(st, scope);
  }
  return (none, scope);
}

pub function arm_scope(arm: ast.MatchArm, s: Scope, whole: typeinfo.Type): Scope {
  return annotate_arm_scope(arm, s, whole);
}

pub function module_scopes(mod: parser.Module): Scope[] {
  let v: QueryView = QueryView { mod: mod, env: module_env(mod) };
  let out: Scope[] = [];
  for fd in mod.funcs {
    out = out.append(func_scope(v, fd));
  }
  return out.append(module_scope(v));
}

pub struct QueryView { mod: parser.Module, env: ModuleEnv }

pub function query_view(raw_mod: parser.Module): QueryView {
  let (filled, _) = parser.fill_default_args_with_diags(raw_mod);
  let mod: parser.Module = prepared_module(filled);
  return QueryView { mod: mod, env: module_env(mod) };
}

pub function func_scope(v: QueryView, fd: parser.FuncDecl): Scope {
  return build_func_scope(fd, v.env.sigs, v.env.structs, v.env.unions, v.env.methods, v.env.imports, v.env.impls, v.env.trait_reqs);
}

pub function module_scope(v: QueryView): Scope {
  return new_scope_full(v.env.sigs, v.env.structs, v.env.unions, v.env.methods, v.env.imports, v.env.impls, v.env.trait_reqs);
}

pub function func_sig(s: Scope, name: string): FuncSig {
  return s.lookup_sig(name);
}

pub function method_sig(s: Scope, name: string, recv: string): MethodSig {
  return s.lookup_method(name, recv);
}

pub function methods_on(s: Scope, recv: string): MethodSig[] {
  let out: MethodSig[] = [];
  for ms in s.methods.methods {
    if (s.receives(ms, recv)) {
      out = out.append(ms);
    }
  }
  return out;
}

pub function builtin_method_names(recv: string): string[] {
  let head: string = "__method_" + recv + "_";
  let out: string[] = [];
  for row in builtin_sigs() {
    let open: i32 = util.index_of_sub(row, "(");
    if (open > head.len() && util.str_has_prefix(row, head)) {
      out = out.append(slice_unchecked(row, head.len(), open) + "");
    }
  }
  return out;
}

pub function array_method_names(s: Scope, view: boolean): string[] {
  let out: string[] = [];
  for method in s.methods.methods {
    if (array_receiver_matches(method.receiver_type, view) && !util.has_str(out, method.name)) {
      out = out.append(method.name);
    }
  }
  return out;
}

pub function enum_sig(s: Scope, name: string): UnionSig {
  let u: UnionSig = s.lookup_union(name);
  if (u.name.len() > 0) {
    return u;
  }
  return builtin_union_sig(name);
}

pub function variant_enum(s: Scope, name: string): string {
  let owner: string = scope_variant_owner(name, s);
  if (owner.len() > 0) {
    return owner;
  }
  return parser.builtin_enum_of(name);
}

pub function payload_slot(s: Scope, owner: string, name: string, k: i32): i32 {
  return ctor_payload_slot(s, owner, name, k);
}

struct UnknownSite { found: boolean, line: i32, col: i32, reason: string }

function unknown_site(stmts: ast.Stmt[], s: Scope): UnknownSite {
  let cur: Scope = s;
  for st in stmts {
    let r: CheckResult = check_stmt(st, cur);
    if let typeinfo.TypeUnknown(u) = r.ty {
      let inner: UnknownSite = unknown_site_within(st, cur);
      if (inner.found) {
        return inner;
      }
      return UnknownSite { found: true, line: ast.stmt_line(st), col: ast.stmt_col(st), reason: u.reason };
    }
    cur = r.scope;
  }
  return UnknownSite { found: false, line: 0, col: 0, reason: "" };
}

function unknown_site_within(st: ast.Stmt, s: Scope): UnknownSite {
  let none: UnknownSite = UnknownSite { found: false, line: 0, col: 0, reason: "" };
  match (st) {
    ast.StmtIf(f) => {
      let t: UnknownSite = unknown_site(f.then_body, s);
      if (t.found) {
        return t;
      }
      return unknown_site(f.else_body, s);
    },
    ast.StmtWhile(w) => {
      return unknown_site(w.body, s.enter_loop());
    },
    ast.StmtFor(fo) => {
      return unknown_site(fo.body, for_body_scope(fo, s));
    },
    ast.StmtMatch(m) => {
      let whole: typeinfo.Type = check_expr(m.scrutinee, s);
      for arm in m.arms {
        let a: UnknownSite = unknown_site(arm.body, annotate_arm_scope(arm, s, whole));
        if (a.found) {
          return a;
        }
      }
    },
    ast.StmtDefer(d) => {
      return unknown_site_within(d.action, s);
    },
    _ => {}
  }
  return none;
}

pub function ill_typed_hint(raw_mod: parser.Module): util.Diag[] {
  let (filled, _) = parser.fill_default_args_with_diags(raw_mod);
  let mod: parser.Module = prepared_module(filled);
  let env: ModuleEnv = module_env(mod);
  for func in mod.funcs {
    let fs: Scope = build_func_scope(func, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
    if (!check_func_body(func, fs)) {
      let site: UnknownSite = unknown_site(func.body, fs);
      if (site.found) {
        return [untyped_code(site.line, site.col, "this statement in \"" + func.name + "\" (" + site.reason + ")")];
      }
      return [untyped_code(func.line, func.col, "the body of \"" + func.name + "\"")];
    }
  }
  let s: Scope = new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  for top_stmt in mod.top_stmts {
    let r: CheckResult = check_stmt(top_stmt, s);
    s = r.scope;
    if let typeinfo.TypeUnknown(u) = r.ty {
      return [untyped_code(ast.stmt_line(top_stmt), ast.stmt_col(top_stmt), "this top-level statement (" + u.reason + ")")];
    }
  }
  return [dg_at("", "internal error: the checker rejected this module without a diagnostic; this is a compiler bug, please report it", 0, 0)];
}

function untyped_code(line: i32, col: i32, what: string): util.Diag {
  if (col <= 0) {
    col = 1;
  }
  return dg_at("", "internal: the checker could not type " + what + " and has no diagnostic for it; this is a compiler bug, please report it", line, col);
}

function main(): i32 {
  let src1: string = "let a = 1 + 2 * 3; let b = \"hi\" + \" there\"; let c = a < 10; let d = !c; return a + 1;";
  let toks1: lexer.Token[] = lexer.tokenize(src1);
  let stmts1: ast.Stmt[] = parser.parse_program(toks1);
  let pt1: ProgramTypes = check_program(stmts1);
  if (pt1.tys.len() != 5) {
    return 1;
  }
  if (!type_eq(pt1.tys[0], t_i32())) {
    return 10;
  }
  if (!type_eq(pt1.tys[1], t_string())) {
    return 11;
  }
  if (!type_eq(pt1.tys[2], t_bool())) {
    return 12;
  }
  if (!type_eq(pt1.tys[3], t_bool())) {
    return 13;
  }
  if (!type_eq(pt1.tys[4], t_i32())) {
    return 14;
  }

  let src2: string = "let x = 1 + \"no\";";
  let toks2: lexer.Token[] = lexer.tokenize(src2);
  let stmts2: ast.Stmt[] = parser.parse_program(toks2);
  let pt2: ProgramTypes = check_program(stmts2);
  if (pt2.tys.len() != 1) {
    return 20;
  }
  if (!is_unknown(pt2.tys[0])) {
    return 21;
  }

  let src3: string = "let p = q; let q = 5; let r = q;";
  let toks3: lexer.Token[] = lexer.tokenize(src3);
  let stmts3: ast.Stmt[] = parser.parse_program(toks3);
  let pt3: ProgramTypes = check_program(stmts3);
  if (pt3.tys.len() != 3) {
    return 30;
  }
  if (!is_unknown(pt3.tys[0])) {
    return 31;
  }
  if (!type_eq(pt3.tys[1], t_i32())) {
    return 32;
  }
  if (!type_eq(pt3.tys[2], t_i32())) {
    return 33;
  }

  let src4: string = "let f = true && false; let g = (1 < 2) || f;";
  let toks4: lexer.Token[] = lexer.tokenize(src4);
  let stmts4: ast.Stmt[] = parser.parse_program(toks4);
  let pt4: ProgramTypes = check_program(stmts4);
  if (pt4.tys.len() != 2) {
    return 40;
  }
  if (!type_eq(pt4.tys[0], t_bool())) {
    return 41;
  }
  if (!type_eq(pt4.tys[1], t_bool())) {
    return 42;
  }

  let src5: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
  let mod5: parser.Module = parser.parse_module(lexer.tokenize(src5));
  let mt5: ModuleTypes = check_module(mod5);
  if (!mt5.all_well_typed) {
    return 50;
  }
  if (mt5.sigs.len() != 2) {
    return 51;
  }
  if (mt5.sigs[0].name != "add") {
    return 52;
  }
  if (mt5.sigs[0].param_types.len() != 2) {
    return 53;
  }
  if (!type_eq(mt5.sigs[0].param_types[0], t_i32())) {
    return 54;
  }
  if (!type_eq(mt5.sigs[0].ret_type, t_i32())) {
    return 55;
  }

  let src6: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(1); }";
  let mod6: parser.Module = parser.parse_module(lexer.tokenize(src6));
  let mt6: ModuleTypes = check_module(mod6);
  if (mt6.all_well_typed) {
    return 60;
  }

  let src7: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(1, \"x\"); }";
  let mod7: parser.Module = parser.parse_module(lexer.tokenize(src7));
  let mt7: ModuleTypes = check_module(mod7);
  if (mt7.all_well_typed) {
    return 70;
  }

  let src8: string = "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); } function main(): i32 { return fact(5); }";
  let mod8: parser.Module = parser.parse_module(lexer.tokenize(src8));
  let mt8: ModuleTypes = check_module(mod8);
  if (!mt8.all_well_typed) {
    return 80;
  }

  let src9: string = "let a = [1, 2, 3]; return a[0];";
  let stmts9: ast.Stmt[] = parser.parse_program(lexer.tokenize(src9));
  let pt9: ProgramTypes = check_program(stmts9);
  if (pt9.tys.len() != 2) {
    return 90;
  }
  match (pt9.tys[0]) {
    typeinfo.TypeArray(ae) => {
      if (!type_eq(ae.elem, t_i32())) {
        return 91;
      }
    },
    _ => {
      return 92;
    }
  }
  if (!type_eq(pt9.tys[1], t_i32())) {
    return 93;
  }

  let src10: string = "let a = [\"x\", \"y\"]; return a.len();";
  let stmts10: ast.Stmt[] = parser.parse_program(lexer.tokenize(src10));
  let pt10: ProgramTypes = check_program(stmts10);
  if (!type_eq(pt10.tys[1], t_i32())) {
    return 100;
  }

  let src11: string = "let a = [1, \"oops\"]; return a[0];";
  let stmts11: ast.Stmt[] = parser.parse_program(lexer.tokenize(src11));
  let pt11: ProgramTypes = check_program(stmts11);
  if (!type_eq(pt11.tys[0], t_array(t_i32()))) {
    return 110;
  }

  let src12: string = "let s = \"hi\"; return s[0];";
  let stmts12: ast.Stmt[] = parser.parse_program(lexer.tokenize(src12));
  let pt12: ProgramTypes = check_program(stmts12);
  if (!type_eq(pt12.tys[1], t_u8())) {
    return 120;
  }

  let src13: string = "let s = \"hello\"; let t = s[1:4]; return 0;";
  let stmts13: ast.Stmt[] = parser.parse_program(lexer.tokenize(src13));
  let pt13: ProgramTypes = check_program(stmts13);
  match (pt13.tys[1]) {
    typeinfo.TypeUnion(u13) => {
      if (u13.name != "Option") {
        return 130;
      }
      if (u13.args.len() != 1 || !type_eq(u13.args[0], t_string())) {
        return 131;
      }
    },
    _ => {
      return 132;
    }
  }

  let src13u: string = "let s = \"hello\"; let t = slice_unchecked(s, 1, 4); return 0;";
  let stmts13u: ast.Stmt[] = parser.parse_program(lexer.tokenize(src13u));
  let pt13u: ProgramTypes = check_program(stmts13u);
  if (!type_eq(pt13u.tys[1], t_string())) {
    return 133;
  }

  let src14: string = "struct Point { x: i32, y: i32 } function main(): i32 { let p = Point { x: 3, y: 4 }; return p.x + p.y; }";
