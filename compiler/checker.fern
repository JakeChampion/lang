function type_to_irtag(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeArray(a) => {
      let elem = type_to_irtag(a.elem);
      if (elem.len() == 0) {
        return "";
      }
      if (a.view) {
        return "[" + elem + "]";
      }
      return elem + "[]";
    },
    typeinfo.TypeFunc(_) => {
      return "fn";
    },
    typeinfo.TypeFloat(f) => {
      return float_label(f);
    },
    typeinfo.TypeI32(x) => {
      return int_label(x);
    },
    typeinfo.TypeString(_) => {
      return "string";
    },
    typeinfo.TypeBool(_) => {
      return "boolean";
    },
    typeinfo.TypeStruct(st) => {
      return st.name;
    },
    typeinfo.TypeMap(m) => {
      let kt: string = type_to_irtag(m.key);
      let vt: string = type_to_irtag(m.value);
      if (kt == "" || vt == "") {
        return "";
      }
      return "Map[" + kt + ", " + vt + "]";
    },
    typeinfo.TypeUnion(u) => {
      if (u.name == "Option" && u.args.len() == 1) {
        let pt: string = type_to_irtag(u.args[0]);
        if (pt == "") {
          return "";
        }
        return "Option[" + pt + "]";
      }
      if (u.name == "Result" && u.args.len() == 2) {
        let ot: string = type_to_irtag(u.args[0]);
        let et: string = type_to_irtag(u.args[1]);
        if (ot == "" || et == "") {
          return "";
        }
        return "Result[" + ot + ", " + et + "]";
      }
      if (u.args.len() == 0) {
        return u.name;
      }
      return "";
    },
    typeinfo.TypeTuple(tp) => {
      if (tp.elements.len() < 2) {
        return "";
      }
      let out: string = "(";
      let i: i32 = 0;
      while (i < tp.elements.len()) {
        let et2: string = type_to_irtag(tp.elements[i]);
        if (et2 == "") {
          return "";
        }
        if (i > 0) {
          out = out + ", ";
        }
        out = out + et2;
        i = i + 1;
      }
      return out + ")";
    },
    typeinfo.TypeDyn(_) => {
      return typeinfo.spelling(t);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function type_to_arrtag(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeArray(a) => {
      let et: string = type_to_irtag(a.elem);
      if (et == "") {
        return "";
      }
      if (a.view) {
        return "[" + et + "]";
      }
      return et + "[]";
    },
    _ => {
      return "";
    }
  }
  return "";
}

pub struct Imports { paths: string[], sights: parser.ModuleSight[] }

function module_imports(mod: parser.Module): Imports {
  return Imports { paths: import_paths_of(mod), sights: mod.sights };
}

function (im: Imports) sees(from: string, decl: string): boolean {
  if (from == decl) {
    return true;
  }
  for sg in im.sights {
    if (sg.module == from) {
      return util.has_str(sg.reaches, decl);
    }
  }
  return true;
}

function import_paths_of(mod: parser.Module): string[] {
  let out: string[] = [];
  for im in mod.imports {
    out = out.append(im.path);
  }
  return out;
}

function settle_generic_lit_fields(sl: ast.ExprStructLit, fields: ast.Expr[], s: Scope): ast.Expr[] {
  let sig: StructSig = s.lookup_struct(sl.type_name);
  if (sig.type_params.len() == 0) {
    return fields;
  }
  let largs: typeinfo.Type[] = struct_lit_args(sl, sig, s);
  let out: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < fields.len()) {
    let v: ast.Expr = fields[i];
    let fi: i32 = -1;
    if (i < sl.field_names.len()) {
      fi = field_index(sig, sl.field_names[i]);
    }
    if (fi >= 0 && fi < sig.field_type_names.len()) {
      v = settle_wide_literals(v, type_from_ref_subst(parser.parse_type_ref(sig.field_type_names[fi]), sig.type_params, largs, s.type_names()));
    }
    out = out.append(v);
    i = i + 1;
  }
  return out;
}

function settle_wide_literals(e: ast.Expr, t: typeinfo.Type): ast.Expr {
  if (type_to_irtag(t) == "i64" && int_literal_tree(e)) {
    return settle_int_tree(e, "i64");
  }
  if let typeinfo.TypeArray(at) = t {
    if let ast.ExprArray(ea) = e {
      let ne: ast.Expr[] = [];
      for el in ea.elements {
        ne = ne.append(settle_wide_literals(el, at.elem));
      }
      return ast.ExprArray { ...ea, elements: ne };
    }
  }
  if let typeinfo.TypeTuple(tt) = t {
    if let ast.ExprTuple(et) = e {
      let ne: ast.Expr[] = [];
      let k: i32 = 0;
      while (k < et.elements.len()) {
        if (k < tt.elements.len()) {
          ne = ne.append(settle_wide_literals(et.elements[k], tt.elements[k]));
        } else {
          ne = ne.append(et.elements[k]);
        }
        k = k + 1;
      }
      return ast.ExprTuple { ...et, elements: ne };
    }
  }
  return e;
}

function settle_int_tree(e: ast.Expr, tag: string): ast.Expr {
  return parser.settle_int_tree(e, tag);
}

function settle_at(e: ast.Expr, t: typeinfo.Type): ast.Expr {
  if (is_integer(t) && int_literal_tree(e)) {
    return settle_int_tree(e, type_to_irtag(t));
  }
  return e;
}

function settle_args_at_params(args: ast.Expr[], params: typeinfo.Type[]): ast.Expr[] {
  if (params.len() != args.len()) {
    return args;
  }
  let out: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < args.len()) {
    out = out.append(settle_at(args[i], params[i]));
    i = i + 1;
  }
  return out;
}

function call_param_types(c: ast.ExprCall, s: Scope): typeinfo.Type[] {
  if let typeinfo.TypeFunc(ft) = check_expr(c.callee, s) {
    if (ft.params_known) {
      return ft.param_types;
    }
    return [];
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    let recv: typeinfo.Type = check_expr(fa.obj, s);
    let key: string = receiver_key(recv);
    let found: Option[MethodSig] = None;
    if (key.len() > 0) {
      let msig: MethodSig = s.lookup_method(fa.field, key);
      if (msig.name.len() > 0) {
        found = Some(msig);
      }
    } else {
      found = bound_method(s, tp_receiver(recv, s), fa.field);
    }
    if let Some(msig) = found {
      let rmb: MethodBinding = method_binding(c, msig, recv, s);
      let out: typeinfo.Type[] = [];
      let i: i32 = 0;
      while (i < msig.param_types.len()) {
        out = out.append(receiver_bound(msig.param_types[i], param_type_name_at(msig, i), rmb, s));
        i = i + 1;
      }
      return out;
    }
  }
  return [];
}

function settle_array_literals(a: ast.ExprArray, s: Scope): ast.Expr {
  if (a.elem_ty.len() > 0) {
    return a;
  }
  let tag: string = "";
  for element in a.elements {
    let et: typeinfo.Type = check_expr(element, s);
    if (tag.len() == 0 && numeric_literal_kind(element) == 0 && (is_integer(et) || is_float(et))) {
      tag = type_to_irtag(et);
    }
  }
  if (tag.len() == 0) {
    return settle_array_struct_literals(a, s);
  }
  let els: ast.Expr[] = [];
  for element in a.elements {
    if (int_literal_tree(element) && !util.has_str(["f32", "f64"], tag)) {
      els = els.append(settle_int_tree(element, tag));
    } else {
      els = els.append(element);
    }
  }
  return parser.settle_to_name(ast.ExprArray { ...a, elements: els }, tag + "[]");
}

function settle_array_struct_literals(a: ast.ExprArray, s: Scope): ast.Expr {
  if let typeinfo.TypeArray(at) = check_expr(a, s) {
    if (!reads_i64(at.elem)) {
      return a;
    }
    let els: ast.Expr[] = [];
    for element in a.elements {
      els = els.append(settle_struct_lit_wide(element, at.elem, s));
    }
    return ast.ExprArray { ...a, elements: els };
  }
  return a;
}

function settle_struct_lit_wide(e: ast.Expr, t: typeinfo.Type, s: Scope): ast.Expr {
  if let ast.ExprStructLit(sl) = e {
    if let typeinfo.TypeStruct(ts) = t {
      let sig: StructSig = s.lookup_struct(sl.type_name);
      if (ts.name != sl.type_name || sig.type_params.len() != ts.args.len() || sig.type_params.len() == 0) {
        return e;
      }
      let nv: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < sl.field_values.len()) {
        let v: ast.Expr = sl.field_values[i];
        let fi: i32 = 0 - 1;
        if (i < sl.field_names.len()) {
          fi = field_index(sig, sl.field_names[i]);
        }
        if (fi >= 0 && fi < sig.field_type_names.len()) {
          let ft: typeinfo.Type = type_from_ref_subst(parser.parse_type_ref(sig.field_type_names[fi]), sig.type_params, ts.args, s.type_names());
          v = settle_struct_lit_wide(settle_wide_literals(v, ft), ft, s);
        }
        nv = nv.append(v);
        i = i + 1;
      }
      return ast.ExprStructLit { ...sl, field_values: nv };
    }
  }
  return e;
}

struct Typed { e: ast.Expr, ty: typeinfo.Type, known: boolean }

function typed_type(t: Typed, orig: ast.Expr, s: Scope): typeinfo.Type {
  if (t.known) {
    return t.ty;
  }
  return check_expr(orig, s);
}

function annotate_expr(e: ast.Expr, s: Scope): ast.Expr {
  return annotate_typed(e, s).e;
}

function annotate_typed(e: ast.Expr, s: Scope): Typed {
  match (e) {
    ast.ExprIdent(id) => {
      let it: typeinfo.Type = check_ident_expr(id, s);
      return Typed { e: ast.ExprIdent { name: id.name, line: id.line, col: id.col, ty: type_to_irtag(it) }, ty: it, known: true };
    },
    ast.ExprBinary(b) => {
      let lta: Typed = annotate_typed(b.left, s);
      let rta: Typed = annotate_typed(b.right, s);
      let left: ast.Expr = lta.e;
      let right: ast.Expr = rta.e;
      let lt: typeinfo.Type = typed_type(lta, b.left, s);
      let rt: typeinfo.Type = typed_type(rta, b.right, s);
      if (is_integer(lt) && is_integer(rt)) {
        if (int_literal_tree(b.left) && !int_literal_tree(b.right)) {
          left = settle_int_tree(left, type_to_irtag(rt));
        }
        if (int_literal_tree(b.right) && !int_literal_tree(b.left)) {
          right = settle_int_tree(right, type_to_irtag(lt));
        }
      }
      let common: typeinfo.Type = binary_numeric_join(b, lt, rt);
      left = widen_binary_operand(left, lt, common, b.line, b.col);
      right = widen_binary_operand(right, rt, common, b.line, b.col);
      let bt: typeinfo.Type = rt;
      if (b.op != "__named_arg") {
        bt = binary_result_type(b, lt, rt, s);
      }
      return Typed { e: ast.ExprBinary { op: b.op, left: left, right: right, line: b.line, col: b.col, ty: type_to_irtag(bt) }, ty: bt, known: true };
    },
    ast.ExprUnary(u) => {
      let oa: Typed = annotate_typed(u.operand, s);
      let ut: typeinfo.Type = unary_result_type(u, typed_type(oa, u.operand, s), s);
      return Typed { e: ast.ExprUnary { op: u.op, operand: oa.e, line: u.line, col: u.col, ty: type_to_irtag(ut) }, ty: ut, known: true };
    },
    ast.ExprCall(c) => {
      let nargs: ast.Expr[] = [];
      for arg in c.args {
        nargs = nargs.append(annotate_expr(arg, s));
      }
      nargs = settle_args_at_params(nargs, call_param_types(c, s));
      nargs = display_rewrite(c, nargs, s);
      nargs = settle_shared_literal_typevars(c, nargs, s);
      let ct: typeinfo.Type = check_expr(e, s);
      return Typed { e: ast.ExprCall { callee: annotate_callee(c, ct, s), args: nargs, line: c.line, col: c.col, type_args: stamped_type_args(c, s), ty: type_to_irtag(ct) }, ty: ct, known: true };
    },
    ast.ExprFieldAccess(fa) => {
      let oa: Typed = annotate_typed(fa.obj, s);
      let vqu: string = qual_variant_union(fa, s);
      let ft: typeinfo.Type = t_union(vqu);
      if (vqu.len() == 0) {
        ft = field_access_result_type(fa, typed_type(oa, fa.obj, s), s);
      }
      let member: string = fa.field;
      if (member == "iter" && s.lookup_method("__iterator", "Map").name.len() > 0) {
        if let typeinfo.TypeMap(_) = typed_type(oa, fa.obj, s) {
          member = "__iterator";
        }
      }
      return Typed { e: ast.ExprFieldAccess { ...fa, obj: oa.e, field: member, ty: type_to_irtag(ft) }, ty: ft, known: true };
    },
    ast.ExprIndex(x) => {
      let aa: Typed = annotate_typed(x.array, s);
      let ia: Typed = annotate_typed(x.index, s);
      let xt: typeinfo.Type = index_result_type(typed_type(aa, x.array, s), typed_type(ia, x.index, s));
      return Typed { e: ast.ExprIndex { array: aa.e, index: ia.e, unchecked: x.unchecked, ty: type_to_irtag(xt), line: x.line, col: x.col }, ty: xt, known: true };
    },
    ast.ExprSlice(sl) => {
      let aa: Typed = annotate_typed(sl.array, s);
      let at: typeinfo.Type = typed_type(aa, sl.array, s);
      return Typed { e: ast.ExprSlice { ...sl, array: aa.e, start: annotate_expr(sl.start, s), end: annotate_expr(sl.end, s), ty: type_to_arrtag(at) }, ty: at, known: false };
    },
    ast.ExprArray(a) => {
      let na: ast.Expr[] = [];
      for element in a.elements {
        na = na.append(annotate_expr(element, s));
      }
      return unsettled(settle_array_literals(ast.ExprArray { ...a, elements: na }, s));
    },
    ast.ExprTuple(t) => {
      let nt: ast.Expr[] = [];
      for element in t.elements {
        nt = nt.append(annotate_expr(element, s));
      }
      return unsettled(ast.ExprTuple { elements: nt, line: t.line, col: t.col });
    },
    ast.ExprStructLit(sli) => {
      let nfv: ast.Expr[] = [];
      for field_value in sli.field_values {
        nfv = nfv.append(annotate_expr(field_value, s));
      }
      nfv = settle_generic_lit_fields(sli, nfv, s);
      let nbase: ast.Expr = sli.base;
      if (sli.has_base) {
        nbase = annotate_expr(sli.base, s);
      }
      return unsettled(ast.ExprStructLit { ...sli, field_values: nfv, base: nbase });
    },
    ast.ExprLambda(lm) => {
      return unsettled(annotate_lambda_expr(lm, s, "", t_unknown("")));
    },
    _ => {
      return unsettled(e);
    }
  }
  return unsettled(e);
}

function stamped_type_args(c: ast.ExprCall, s: Scope): string[] {
  let sig: FuncSig = free_generic_sig(c, s);
  if (c.type_args.len() > 0 || sig.all_type_params.len() == 0 || c.args.len() != sig.param_types.len()) {
    return c.type_args;
  }
  let (bn, bt) = call_type_bindings(sig, c, s);
  let out: string[] = [];
  for tp in sig.all_type_params {
    let bi: i32 = util.index_of_str(bn, tp);
    if (bi < 0 || type_contains_unknown(bt[bi]) || width_open(bt[bi])) {
      return c.type_args;
    }
    let spelled: string = typeinfo.spelling(bt[bi]);
    if (spelled.len() == 0) {
      return c.type_args;
    }
    out = out.append(parser.canonicalise_type_args(spelled));
  }
  return out;
}

function free_generic_sig(c: ast.ExprCall, s: Scope): FuncSig {
  if let ast.ExprIdent(cid) = c.callee {
    let sig: FuncSig = s.lookup_sig(cid.name);
    if (!s.is_bound(cid.name) && sig.receiver.len() == 0) {
      return sig;
    }
  }
  return s.lookup_sig("");
}

function width_open(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeI32(_) => {
      return is_poly_int(t);
    },
    typeinfo.TypeFloat(_) => {
      return is_poly_float(t);
    },
    typeinfo.TypeArray(a) => {
      return width_open(a.elem);
    },
    typeinfo.TypeMap(m) => {
      return width_open(m.key) || width_open(m.value);
    },
    typeinfo.TypeTuple(tup) => {
      return any_width_open(tup.elements);
    },
    typeinfo.TypeStruct(r) => {
      return any_width_open(r.args);
    },
    typeinfo.TypeUnion(u) => {
      return any_width_open(u.args);
    },
    typeinfo.TypeFunc(f) => {
      return width_open(f.ret_type) || any_width_open(f.param_types);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function any_width_open(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (width_open(t)) {
      return true;
    }
  }
  return false;
}

function annotate_callee(c: ast.ExprCall, ct: typeinfo.Type, s: Scope): ast.Expr {
  if let ast.ExprIdent(id) = c.callee {
    if let typeinfo.TypeUnion(u) = ct {
      if (!s.is_bound(id.name) && !s.has_sig(id.name)) {
        return ast.ExprIdent { ...id, ty: u.name };
      }
    }
  }
  if let ast.ExprLambda(lm) = c.callee {
    if (parser.is_value_block(c)) {
      return annotate_lambda_expr(lm, s, "", ct);
    }
  }
  return annotate_expr(c.callee, s);
}

function unsettled(e: ast.Expr): Typed {
  return Typed { e: e, ty: t_unknown("unsettled"), known: false };
}

function annotate_lambda_expr(lm: ast.ExprLambda, s: Scope, self_name: string, block: typeinfo.Type): ast.Expr {
  let captures: ast.TypedBinding[] = [];
  let seen: string[] = [];
  for name in astwalk.collect_lambda_idents(lm, []) {
    if (name != self_name && s.is_bound(name) && !util.has_str(seen, name)) {
      captures = captures.append(ast.TypedBinding { name: name, ty: s.lookup(name) });
      seen = seen.append(name);
    }
  }
  let pts: typeinfo.Type[] = [];
  for param in lm.params {
    pts = pts.append(s.resolve_param(param));
  }
  let rt: typeinfo.Type = lambda_ret_type(lm, s);
  let ls: Scope = Scope { ...s, loop_depth: 0, ret_type: rt, try_ret: rt };
  if (parser.is_value_block_origin(lm.origin)) {
    ls = Scope { ...s, loop_depth: 0, ret_type: rt };
  }
  if (self_name.len() > 0) {
    ls = ls.bind(self_name, t_func_own(pts, lambda_owns(lm), rt));
  }
  let i: i32 = 0;
  while (i < lm.params.len()) {
    ls = ls.bind(lm.params[i].name, pts[i]);
    i = i + 1;
  }
  let typed: ast.ExprLambda = lm;
  if (lm.ret_type.len() == 0 || parser.is_value_block_origin(lm.origin)) {
    typed = inferred_lambda_result(lm, ls, lm.ret_type.len() > 0, block);
  }
  let body: Scope = ls;
  if (lm.ret_type.len() == 0 || parser.is_value_block_origin(lm.origin)) {
    body = Scope { ...ls, ret_type: t_unknown("") };
  }
  return ast.ExprLambda { ...typed, body: annotate_block(lm.body, body), captures: captures, captures_known: true };
}

function names_whole_type(t: typeinfo.Type, s: Scope): boolean {
  if (type_contains_unknown(t)) {
    return false;
  }
  match (t) {
    typeinfo.TypeUnion(u) => {
      return u.args.len() >= union_arity(s, u.name) && all_names_whole(u.args, s);
    },
    typeinfo.TypeArray(a) => {
      return names_whole_type(a.elem, s);
    },
    typeinfo.TypeTuple(tt) => {
      return all_names_whole(tt.elements, s);
    },
    typeinfo.TypeMap(m) => {
      return names_whole_type(m.key, s) && names_whole_type(m.value, s);
    },
    typeinfo.TypeStruct(sd) => {
      return all_names_whole(sd.args, s);
    },
    _ => {
      return true;
    }
  }
  return true;
}

function all_names_whole(ts: typeinfo.Type[], s: Scope): boolean {
  for t in ts {
    if (!names_whole_type(t, s)) {
      return false;
    }
  }
  return true;
}

function union_arity(s: Scope, name: string): i32 {
  if (name == "Option") {
    return 1;
  }
  if (name == "Result") {
    return 2;
  }
  return s.lookup_union(name).type_params.len();
}

function inferred_lambda_result(lm: ast.ExprLambda, body_scope: Scope, need_whole: boolean, block: typeinfo.Type): ast.ExprLambda {
  let (returned, at) = first_returned(lm.body, body_scope);
  if (parser.bare_return(returned) || int_literal_tree(returned)) {
    return lm;
  }
  let t: typeinfo.Type = block;
  if (is_unknown(t)) {
    t = check_expr(returned, at);
  }
  if (need_whole && !names_whole_type(t, at)) {
    return lm;
  }
  if let typeinfo.TypeFloat(f) = t {
    if (f.polymorphic) {
      return lm;
    }
  }
  if (is_unknown(t)) {
    return lm;
  }
  if let typeinfo.TypeFunc(_) = t {
    let callable: ast.ParamDecl = decltypes.fn_param_from_type("", t);
    if (callable.type_name != "fn") {
      return lm;
    }
    return ast.ExprLambda { ...lm, ret_type: "fn", ret_fn_ret: callable.fn_ret, ret_fn_param_types: callable.fn_param_types };
  }
  if (spells_function(t)) {
    return lm;
  }
  return ast.ExprLambda { ...lm, ret_type: typeinfo.spelling(t) };
}

function spells_function(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeFunc(_) => {
      return true;
    },
    typeinfo.TypeArray(a) => {
      return spells_function(a.elem);
    },
    typeinfo.TypeTuple(tup) => {
      for e in tup.elements {
        if (spells_function(e)) {
          return true;
        }
      }
    },
    typeinfo.TypeMap(m) => {
      return spells_function(m.key) || spells_function(m.value);
    },
    typeinfo.TypeStruct(st) => {
      for a in st.args {
        if (spells_function(a)) {
          return true;
        }
      }
    },
    typeinfo.TypeUnion(u) => {
      for a in u.args {
        if (spells_function(a)) {
          return true;
        }
      }
    },
    _ => {}
  }
  return false;
}

function annotate_block(body: ast.Stmt[], s: Scope): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let cur: Scope = s;
  for stmt in body {
    let next: Scope = bind_stmt(stmt, cur);
    out = out.append(annotate_stmt(stmt, cur, next));
    cur = next;
  }
  return out;
}

struct ForBinding { scope: Scope, valid: boolean }

function range_var_type(iter: ast.Expr, s: Scope): typeinfo.Type {
  if let ast.ExprCall(c) = iter {
    for bound in c.args {
      if (!int_literal_tree(bound)) {
        let t: typeinfo.Type = check_expr(bound, s);
        if (is_integer(t)) {
          return t;
        }
      }
    }
  }
  return t_i32();
}

function for_binding(fr: ast.StmtFor, s: Scope): ForBinding {
  let body = s.enter_loop();
  if (for_iter_is_range(fr.iter)) {
    return ForBinding { scope: bind_for_element(body, fr.var_name, range_var_type(fr.iter, s)), valid: !name_has_comma(fr.var_name) };
  }
  let it: typeinfo.Type = check_expr(fr.iter, s);
  match (it) {
    typeinfo.TypeString(_) => {
      return ForBinding { scope: bind_for_element(body, fr.var_name, t_u8()), valid: !name_has_comma(fr.var_name) };
    },
    typeinfo.TypeArray(ta) => {
      return ForBinding { scope: bind_for_element(body, fr.var_name, ta.elem), valid: true };
    },
    typeinfo.TypeMap(tm) => {
      let names = split_pattern_names(fr.var_name);
      return ForBinding { scope: bind_tuple_destr_names(body, names, t_tuple([tm.key, tm.value])), valid: names.len() == 2 };
    },
    _ => {
      let sub: IterSubject = iter_subject(it, s);
      return ForBinding { scope: bind_for_element(body, fr.var_name, sub.elem), valid: sub.ok };
    }
  }
  return ForBinding { scope: bind_for_element(body, fr.var_name, t_unknown("invalid iterator")), valid: false };
}

function bind_for_element(s: Scope, name: string, ty: typeinfo.Type): Scope {
  if (name_has_comma(name)) {
    return bind_tuple_destr_names(s, split_pattern_names(name), ty);
  }
  if (name == "_") {
    return s;
  }
  return s.bind(name, ty);
}

pub function for_body_scope(fr: ast.StmtFor, s: Scope): Scope {
  return for_binding(fr, s).scope;
}

function annotate_variant_struct(name: string, s: Scope): string {
  if (s.has_struct(name)) {
    return name;
  }
  let d: i32 = dot_index(name);
  if (d < 0) {
    return "";
  }
  let bare: string = variant_pattern_name(name);
  if (!is_variant_of(bare, slice_unchecked(name, 0, d) + "", s.unions.unions)) {
    return "";
  }
  if (s.has_struct(bare)) {
    return bare;
  }
  return "";
}

function annotate_arm_scope(arm: ast.MatchArm, s: Scope, whole: typeinfo.Type): Scope {
  match (arm.pattern) {
    ast.PatVariant(pv) => {
      let vn: string = annotate_variant_struct(pv.type_name, s);
      if (vn.len() == 0) {
        return bind_variant_payloads(s, s, pv, whole);
      }
      return bind_variant_payloads(s, s, ast.PatVariant { ...pv, type_name: vn }, whole);
    },
    ast.PatWildcard(_) => {
      return s;
    }
  }
  return s;
}

function annotate_stmt(st: ast.Stmt, s: Scope, after: Scope): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      let init = v.init;
      if let ast.ExprLambda(lm) = v.init {
        init = annotate_lambda_expr(lm, s, rec_local_name(v), t_unknown(""));
      } else {
        init = annotate_expr(v.init, s);
      }
      if (v.type_name.len() > 0) {
        init = settle_at(init, after.lookup(v.name));
      }
      let callable: ast.ParamDecl = decltypes.fn_param_from_type(v.name, after.lookup(v.name));
      if (callable.type_name == "fn") {
        return ast.StmtVar {
          ...v, type_name: "fn", init: init,
          fn_ret: callable.fn_ret, fn_param_types: callable.fn_param_types,
        };
      }
      return ast.StmtVar { ...v, init: init };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: settle_at(annotate_expr(r.value, s), s.ret_type), line: r.line, col: r.col };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { value: annotate_expr(x.value, s), line: x.line };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: annotate_expr(f.cond, s), then_body: annotate_block(f.then_body, s), else_body: annotate_block(f.else_body, s) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: annotate_expr(w.cond, s), body: annotate_block(w.body, s), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { target: a.target, value: settle_at(annotate_expr(a.value, s), s.lookup(a.target)), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
    },
    ast.StmtMatch(m) => {
      let narms: ast.MatchArm[] = [];
      for arm in m.arms {
        let asc: Scope = annotate_arm_scope(arm, s, check_expr(m.scrutinee, s));
        let g: ast.Expr = arm.guard;
        if (arm.has_guard) {
          g = annotate_expr(arm.guard, asc);
        }
        narms = narms.append(ast.MatchArm { ...arm, body: annotate_block(arm.body, asc), guard: g });
      }
      return ast.StmtMatch { ...m, scrutinee: annotate_expr(m.scrutinee, s), arms: narms };
    },
    ast.StmtFor(fr) => {
      if let Some(lowered) = iterator_lowering(fr, s) {
        return annotate_stmt(lowered, s, after);
      }
      return ast.StmtFor { var_name: fr.var_name, iter: annotate_expr(fr.iter, s), body: annotate_block(fr.body, for_body_scope(fr, s)), label: fr.label, line: fr.line, col: fr.col };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: annotate_stmt(d.action, s, after), on_error: d.on_error, line: d.line };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function annotate_func(fd: parser.FuncDecl, env: ModuleEnv): parser.FuncDecl {
  let s: Scope = build_func_scope(fd, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
  return parser.FuncDecl { ...fd, body: annotate_block(fd.body, s) };
}

pub function annotate_module(mod: parser.Module): parser.Module {
  return annotate_module_in(mod, module_env(mod), whole_focus(mod));
}

struct Focus { funcs: boolean[], top: boolean }

function whole_focus(mod: parser.Module): Focus {
  let funcs: boolean[] = [];
  for fd in mod.funcs {
    funcs = funcs.append(true);
  }
  return Focus { funcs: funcs, top: true };
}

function annotate_module_in(mod: parser.Module, env: ModuleEnv, focus: Focus): parser.Module {
  let rmod: parser.Module = pretype_module_in(settle_literal_locals_in(mod, env, focus), env, focus);
  let nfuncs: parser.FuncDecl[] = [];
  let i: i32 = 0;
  while (i < rmod.funcs.len()) {
    if (focus.funcs[i]) {
      nfuncs = nfuncs.append(annotate_func(rmod.funcs[i], env));
    } else {
      nfuncs = nfuncs.append(rmod.funcs[i]);
    }
    i = i + 1;
  }
  let ntop: ast.Stmt[] = rmod.top_stmts;
  if (focus.top) {
    ntop = annotate_block(rmod.top_stmts, new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs));
  }
  return parser.Module { funcs: nfuncs, structs: rmod.structs, aliases: rmod.aliases, imports: rmod.imports, top_stmts: ntop, enums: rmod.enums, resources: rmod.resources, exports: rmod.exports, impls: rmod.impls, trait_reqs: rmod.trait_reqs, trait_decls: rmod.trait_decls, inferred_consts: rmod.inferred_consts, todo_sites: rmod.todo_sites, sights: rmod.sights };
}

function unchecked_capture(e: ast.Expr, own found: boolean): boolean {
  if let ast.ExprLambda(lm) = e {
    return found || !lm.captures_known;
  }
  return found;
}

function display_unrewritten(e: ast.Expr, own found: boolean): boolean {
  if (found) {
    return true;
  }
  if let ast.ExprCall(c) = e {
    if (c.args.len() != 1) {
      return false;
    }
    if let ast.ExprIdent(id) = c.callee {
      if (id.name != "print" && id.name != "write" && id.name != "eprint") {
        return false;
      }
      if let ast.ExprString(_) = c.args[0] {
        return false;
      }
      if let ast.ExprFString(_) = c.args[0] {
        return false;
      }
      return ast.expr_ty(c.args[0]) != "string";
    }
  }
  return false;
}

function unannotated(stmts: ast.Stmt[]): boolean {
  let found: boolean = false;
  for st in stmts {
    found = astwalk.fold_stmt(st, found, unchecked_or_unrewritten);
  }
  return found;
}

function unchecked_or_unrewritten(e: ast.Expr, own found: boolean): boolean {
  return display_unrewritten(e, unchecked_capture(e, found));
}

function unannotated_focus(mod: parser.Module): Focus {
  let funcs: boolean[] = [];
  for fd in mod.funcs {
    funcs = funcs.append(unannotated(fd.body));
  }
  return Focus { funcs: funcs, top: unannotated(mod.top_stmts) };
}

function any_focus(f: Focus): boolean {
  if (f.top) {
    return true;
  }
  for b in f.funcs {
    if (b) {
      return true;
    }
  }
  return false;
}

pub function ensure_annotated(mod: parser.Module): parser.Module {
  let focus: Focus = unannotated_focus(mod);
  if (any_focus(focus)) {
    return annotate_module_in(mod, module_env(mod), focus);
  }
  return mod;
}

pub function ensure_annotated_parts(mods: parser.Module[]): parser.Module[] {
  let needed: boolean = false;
  let focus: Focus[] = [];
  for mod in mods {
    let f: Focus = unannotated_focus(mod);
    if (any_focus(f)) {
      needed = true;
    }
    focus = focus.append(f);
  }
  if (!needed) {
    return mods;
  }
  let funcs: parser.FuncDecl[] = [];
  let structs: parser.StructDecl[] = [];
  let aliases: parser.TypeAlias[] = [];
  let enums: parser.EnumDecl[] = [];
  for mod in mods {
    for fd in mod.funcs {
      funcs = funcs.append(fd);
    }
    for sd in mod.structs {
      structs = structs.append(sd);
    }
    for ad in mod.aliases {
      aliases = aliases.append(ad);
    }
    for ed in mod.enums {
      enums = enums.append(ed);
    }
  }
  let view = parser.Module { ...mods[0], funcs: funcs, structs: structs, aliases: aliases, enums: enums };
  let env = module_env(view);
  let out: parser.Module[] = [];
  let k: i32 = 0;
  while (k < mods.len()) {
    if (any_focus(focus[k])) {
      out = out.append(annotate_module_in(mods[k], ModuleEnv { ...env, imports: module_imports(mods[k]) }, focus[k]));
    } else {
      out = out.append(mods[k]);
    }
    k = k + 1;
  }
  return out;
}

function vb_local_name(body: ast.Stmt[]): string {
  if (body.len() < 3) {
    return "";
  }
  let name: string = "";
  match (body[0]) {
    ast.StmtVar(v) => {
      if (v.type_name.len() > 0 && !parser.is_value_local_name(v.name) || name_has_comma(v.name)) {
        return "";
      }
      name = v.name;
    },
    _ => {
      return "";
    }
  }
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      if (ow_ident_name(r.value) == name) {
        return name;
      }
    },
    _ => {}
  }
  return "";
}

struct VbStore { t: typeinfo.Type, e: ast.Expr }

function vb_assigned_stores(stmts: ast.Stmt[], name: string, s: Scope, acc: VbStore[]): VbStore[] {
  let out: VbStore[] = acc;
  let cur: Scope = s;
  for st in stmts {
    match (st) {
      ast.StmtAssign(a) => {
        if (a.target == name) {
          out = out.append(VbStore { t: check_expr(a.value, cur), e: a.value });
        }
      },
      ast.StmtIf(f) => {
        out = vb_assigned_stores(f.then_body, name, cur, out);
        out = vb_assigned_stores(f.else_body, name, cur, out);
      },
      ast.StmtWhile(w) => {
        out = vb_assigned_stores(w.body, name, cur, out);
      },
      ast.StmtFor(fr) => {
        out = vb_assigned_stores(fr.body, name, for_body_scope(fr, cur), out);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = vb_assigned_stores(arm.body, name, annotate_arm_scope(arm, cur, check_expr(m.scrutinee, cur)), out);
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = vb_assigned_stores(one, name, cur, out);
      },
      _ => {}
    }
    cur = bind_stmt(st, cur);
  }
  return out;
}

function vb_untyped_fits(e: ast.Expr, t: typeinfo.Type): boolean {
  if (!int_literal_tree(e)) {
    return false;
  }
  return is_float(t) || is_integer(t) && int_range_diags(e, type_to_irtag(t), false).len() == 0;
}

function vb_pinned_ranges(ts: typeinfo.Type[], es: ast.Expr[]): util.Diag[] {
  let out: util.Diag[] = [];
  if (ts.len() != es.len() || ts.len() == 0) {
    return out;
  }
  if let typeinfo.TypeTuple(t0) = ts[0] {
    let n: i32 = t0.elements.len();
    let cols: typeinfo.Type[][] = [];
    let ecols: ast.Expr[][] = [];
    let k: i32 = 0;
    while (k < n) {
      cols = cols.append([]);
      ecols = ecols.append([]);
      k = k + 1;
    }
    let i: i32 = 0;
    while (i < ts.len()) {
      if let typeinfo.TypeTuple(ti) = ts[i] {
        if (ti.elements.len() != n) {
          return out;
        }
        let ei: ast.Expr[] = vb_tuple_elems(es[i], n);
        k = 0;
        while (k < n) {
          cols = cols.with(k, cols[k].append(ti.elements[k]));
          ecols = ecols.with(k, ecols[k].append(ei[k]));
          k = k + 1;
        }
      } else {
        return out;
      }
      i = i + 1;
    }
    k = 0;
    while (k < n) {
      out = util.append_diags(out, vb_pinned_ranges(cols[k], ecols[k]));
      k = k + 1;
    }
    return out;
  }
  let pin: string = "";
  let i: i32 = 0;
  while (i < ts.len() && pin.len() == 0) {
    if (is_integer(ts[i]) && !int_literal_tree(es[i])) {
      pin = type_to_irtag(ts[i]);
    }
    i = i + 1;
  }
  if (pin.len() == 0) {
    return out;
  }
  i = 0;
  while (i < es.len()) {
    if (int_literal_tree(es[i])) {
      out = util.append_diags(out, int_range_diags(es[i], pin, false));
    }
    i = i + 1;
  }
  return out;
}

function vb_join(a: VbStore, b: VbStore): VbStore {
  let scalar: typeinfo.Type = scalar_numeric_join(a.t, b.t);
  if (scalar_vb_joinable(a, b, scalar)) {
    return VbStore { t: scalar, e: ast.ExprUnknown { kind: "", line: 0, col: 0 } };
  }
  let none: ast.Expr = ast.ExprUnknown { kind: "", line: 0, col: 0 };
  if let typeinfo.TypeTuple(at) = a.t {
    if let typeinfo.TypeTuple(bt) = b.t {
      if (at.elements.len() != bt.elements.len()) {
        return VbStore { t: t_unknown("result tuple arities differ"), e: none };
      }
      let aes: ast.Expr[] = vb_tuple_elems(a.e, at.elements.len());
      let bes: ast.Expr[] = vb_tuple_elems(b.e, bt.elements.len());
      let elems: typeinfo.Type[] = [];
      let es: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < at.elements.len()) {
        let j: VbStore = vb_join(VbStore { t: at.elements[i], e: aes[i] }, VbStore { t: bt.elements[i], e: bes[i] });
        if (is_unknown(j.t)) {
          return j;
        }
        elems = elems.append(j.t);
        es = es.append(j.e);
        i = i + 1;
      }
      return VbStore { t: t_tuple(elems), e: ast.ExprTuple { elements: es, line: 0, col: 0 } };
    }
  }
  if let typeinfo.TypeArray(aa) = a.t {
    if let typeinfo.TypeArray(ba) = b.t {
      if (aa.view == ba.view) {
        let j: VbStore = vb_join(mx_elem_store(a.e, aa.elem), mx_elem_store(b.e, ba.elem));
        let t: typeinfo.Type = typeinfo.TypeArray { ...aa, elem: j.t };
        if let ast.ExprUnknown(_) = j.e {
          return VbStore { t: t, e: none };
        }
        return VbStore { t: t, e: a.e };
      }
    }
  }
  let t: typeinfo.Type = join_result_types(a.t, b.t);
  if (is_unknown(t) && vb_untyped_fits(b.e, a.t)) {
    t = a.t;
  } else if (is_unknown(t) && vb_untyped_fits(a.e, b.t)) {
    t = b.t;
  }
  if (!is_unknown(t) && vb_untyped_fits(a.e, t) && vb_untyped_fits(b.e, t)) {
    return VbStore { t: t, e: a.e };
  }
  return VbStore { t: t, e: none };
}

function vb_tuple_elems(e: ast.Expr, n: i32): ast.Expr[] {
  if let ast.ExprTuple(t) = e {
    if (t.elements.len() == n) {
      return t.elements;
    }
  }
  let out: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(ast.ExprUnknown { kind: "", line: 0, col: 0 });
    i = i + 1;
  }
  return out;
}

function vb_arms_unified(ts: typeinfo.Type[], es: ast.Expr[]): typeinfo.Type {
  if (ts.len() != es.len()) {
    return vb_unified(ts);
  }
  let ss: VbStore[] = [];
  let i: i32 = 0;
  while (i < ts.len()) {
    ss = ss.append(VbStore { t: ts[i], e: es[i] });
    i = i + 1;
  }
  return vb_stores_unified(ss);
}

function vb_stores_unified(ss0: VbStore[]): typeinfo.Type {
  if (ss0.len() == 0) {
    return t_unknown("value block stores nothing");
  }
  let ss: VbStore[] = [];
  for st in ss0 {
    if (!unbound_enum_argument(st.t)) {
      ss = ss.append(st);
    }
  }
  if (ss.len() == 0) {
    return ss0[0].t;
  }
  let acc: VbStore = ss[0];
  let i: i32 = 1;
  while (i < ss.len() && !is_unknown(acc.t)) {
    acc = vb_join(acc, ss[i]);
    i = i + 1;
  }
  if (is_unknown(acc.t) && ss.len() > 1) {
    return t_unknown("value block arms disagree");
  }
  return acc.t;
}

function vb_unified(ts: typeinfo.Type[]): typeinfo.Type {
  if (ts.len() == 0) {
    return t_unknown("value block stores nothing");
  }
  let k: i32 = 0;
  while (k < ts.len() - 1 && unbound_enum_argument(ts[k])) {
    k = k + 1;
  }
  let first: typeinfo.Type = ts[k];
  if (is_unknown(first)) {
    return first;
  }
  let i: i32 = k + 1;
  while (i < ts.len()) {
    first = join_result_types(first, ts[i]);
    if (is_unknown(first)) {
      return t_unknown("value block arms disagree");
    }
    i = i + 1;
  }
  return first;
}

function vb_store_type(body: ast.Stmt[], name: string, s: Scope): typeinfo.Type {
  return vb_stores_unified(vb_value_stores(body, name, s));
}

function vb_value_stores(body: ast.Stmt[], name: string, s: Scope): VbStore[] {
  let chain: ast.Stmt[] = [];
  let i: i32 = 1;
  while (i < body.len() - 1) {
    chain = chain.append(body[i]);
    i = i + 1;
  }
  let none: VbStore[] = [];
  return vb_assigned_stores(chain, name, bind_stmt(body[0], s), none);
}

function vb_local_tag(t: typeinfo.Type): string {
  if (type_label(t) == "str") {
    return "";
  }
  let tag: string = type_to_irtag(t);
  if (tag == "string" || tag == "boolean" || tag == "f64" || tag == "f32" || tag == "char"
    || tag == "i32" || tag == "i64" || tag == "u32" || tag == "u64" || tag == "u8") {
    return tag;
  }
  return "";
}

function vb_annotation_of(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeStruct(_) => {
      return type_label(t);
    },
    typeinfo.TypeTuple(_) => {
      return type_label(t);
    },
    typeinfo.TypeFunc(_) => {
      return typeinfo.spelling(t);
    },
    typeinfo.TypeArray(a) => {
      if (type_label(a.elem) == "str") {
        return "";
      }
      return typeinfo.spelling(t);
    },
    typeinfo.TypeUnion(u) => {
      if (u.args.len() == 0) {
        return "";
      }
      return type_label(t);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function vb_wants_annotation(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeUnion(_) => {
      return true;
    },
    typeinfo.TypeStruct(_) => {
      return true;
    },
    typeinfo.TypeArray(_) => {
      return true;
    },
    typeinfo.TypeTuple(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function vb_placeholder_decl(v: ast.StmtVar): boolean {
  if (!parser.is_value_local_name(v.name) || v.type_name.len() == 0) {
    return false;
  }
  match (v.init) {
    ast.ExprNumber(n) => {
      return n.text == "0" && n.suffix.len() == 0 && !n.is_float;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function vb_zero_of(tag: string): ast.Expr {
  if (tag == "string") {
    return ast.ExprString { value: "", line: 0, col: 0 };
  }
  if (tag == "boolean") {
    return ast.ExprBool { value: false, line: 0, col: 0 };
  }
  if (tag == "f64") {
    return ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: true, line: 0, col: 0 };
  }
  if (tag == "f32") {
    return ast.ExprUnary { op: "as_f32", operand: vb_zero_of("f64"), line: 0, col: 0, ty: "f32" };
  }
  if (tag == "i32") {
    return ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 };
  }
  return ast.ExprNumber { text: "0", suffix: tag, raw: "", is_float: false, line: 0, col: 0 };
}

function vb_retype(e: ast.Expr, s: Scope): ast.Expr {
  return vb_retype_dest(e, s, "");
}

function vb_retype_dest(e: ast.Expr, s: Scope, dest: string): ast.Expr {
  match (e) {
    ast.ExprCall(c) => {
      if (!parser.is_value_block(c)) {
        return e;
      }
      let body: ast.Stmt[] = parser.vb_body(c);
      let name: string = vb_local_name(body);
      if (name.len() == 0) {
        return e;
      }
      let want: typeinfo.Type = vb_store_type(body, name, s);
      if (is_unknown(want)) {
        return e;
      }
      let tag: string = vb_local_tag(want);
      let nbody: ast.Stmt[] = [];
      match (body[0]) {
        ast.StmtVar(v) => {
          if (type_eq(check_expr(v.init, s), want)) {
            return e;
          }
          if (tag.len() > 0) {
            nbody = nbody.append(ast.StmtVar { ...v, init: vb_zero_of(tag) });
          } else {
            tag = vb_annotation_of(want);
            if (tag.len() == 0 && dest.len() > 0 && !parser.is_destr_marker(dest) && vb_wants_annotation(want)) {
              tag = dest;
            }
            if (tag.len() == 0) {
              return e;
            }
            nbody = nbody.append(ast.StmtVar { ...v, type_name: tag });
          }
        },
        _ => {
          return e;
        }
      }
      let j: i32 = 1;
      while (j < body.len()) {
        nbody = nbody.append(body[j]);
        j = j + 1;
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          return ast.ExprCall { ...c, callee: ast.ExprLambda { ...lm, ret_type: tag, body: nbody } };
        },
        _ => {
          return e;
        }
      }
    },
    _ => {
      return e;
    }
  }
  return e;
}

function pretype_expr(e: ast.Expr, s: Scope): ast.Expr {
  let (ne, ns, nh) = astwalk.map_expr_acc(e, s, pretype_at_stmt, pretype_at_expr);
  return ne;
}

function pretype_at_stmt(st: ast.Stmt, s: Scope): (ast.Stmt, Scope, boolean) {
  return (st, s, false);
}

function pretype_at_expr(x: ast.Expr, s: Scope): (ast.Expr, Scope, boolean) {
  match (x) {
    ast.ExprCall(c) => {
      if (use_untyped(c)) {
        let uc: ast.ExprCall = use_typed(c, s);
        let nargs: ast.Expr[] = [];
        for arg in uc.args {
          nargs = nargs.append(pretype_expr(arg, s));
        }
        return (ast.ExprCall { ...uc, callee: pretype_expr(uc.callee, s), args: nargs }, s, true);
      }
      if (!parser.is_value_block(c)) {
        return (x, s, false);
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          let body: ast.Stmt[] = struct_record_value_body(lm, s);
          let inner: ast.Expr = ast.ExprCall { ...c, callee: ast.ExprLambda { ...lm, body: pretype_stmts(body, s) } };
          return (vb_retype(inner, s), s, true);
        },
        _ => {
          return (x, s, false);
        }
      }
    },
    ast.ExprLambda(lm) => {
      return (ast.ExprLambda { ...lm, body: pretype_stmts(lm.body, lambda_body_scope(lm, s)) }, s, true);
    },
    _ => {
      return (x, s, false);
    }
  }
  return (x, s, false);
}

function pretype_tuple_if(f: ast.StmtIf, s: Scope): ast.StmtIf {
  let ready: ast.StmtIf = f;
  if (f.sugar.origin == "" && f.sugar.tup.len() > 0) {
    if let typeinfo.TypeTuple(tuple) = check_expr(f.sugar.scrut, s) {
      let wrong: boolean = false;
      for arm in f.sugar.tup {
        if (!arm.is_wild && arm.elem_kinds.len() != tuple.elements.len()) {
          wrong = true;
        }
      }
      if (wrong) {
        if let ast.StmtIf(rebuilt) = parser.build_tuple_match_sized(f.sugar.scrut, f.sugar.tup, tuple.elements.len(), f.sugar.line, f.sugar.col) {
          ready = rebuilt;
        }
      }
    }
  }
  return ready;
}

function pretype_if(st: ast.Stmt, f: ast.StmtIf, s: Scope): ast.Stmt {
  if let Some(m) = parser.struct_record_source(st) {
    if (struct_record_match(m, s)) {
      return pretype_stmt(parser.lower_struct_record_match(m, ""), s);
    }
  }
  let ready: ast.StmtIf = pretype_tuple_if(f, s);
  return ast.StmtIf { ...ready, cond: pretype_expr(ready.cond, s), then_body: pretype_stmts(ready.then_body, s), else_body: pretype_stmts(ready.else_body, s) };
}

function pretype_match(m: ast.StmtMatch, s: Scope): ast.Stmt {
  if (struct_record_match(m, s)) {
    return pretype_stmt(parser.lower_struct_record_match(m, ""), s);
  }
  let narms: ast.MatchArm[] = [];
  let whole: typeinfo.Type = check_expr(m.scrutinee, s);
  for arm0 in m.arms {
    let arm: ast.MatchArm = ast.MatchArm { ...arm0, pattern: rescope_pattern(arm0.pattern, whole, s) };
    let asc: Scope = annotate_arm_scope(arm, s, whole);
    let g: ast.Expr = arm.guard;
    if (arm.has_guard) {
      g = pretype_expr(arm.guard, asc);
    }
    narms = narms.append(ast.MatchArm { ...arm, body: pretype_stmts(arm.body, asc), guard: g });
  }
  return ast.StmtMatch { ...m, scrutinee: pretype_expr(m.scrutinee, s), arms: narms };
}

function pretype_stmt(st: ast.Stmt, s: Scope): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      let init: ast.Expr = pretype_expr(v.init, s);
      if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name)) {
        init = vb_retype_dest(init, s, v.type_name);
      }
      return ast.StmtVar { ...v, init: init };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: pretype_expr(r.value, s) };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: pretype_expr(x.value, s) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: pretype_expr(a.value, s) };
    },
    ast.StmtIf(f) => {
      return pretype_if(st, f, s);
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, cond: pretype_expr(w.cond, s), body: pretype_stmts(w.body, s) };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { ...fr, iter: pretype_expr(fr.iter, s), body: pretype_stmts(fr.body, for_body_scope(fr, s)) };
    },
    ast.StmtMatch(m) => {
      return pretype_match(m, s);
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: pretype_stmt(d.action, s) };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function pretype_stmts(stmts: ast.Stmt[], s: Scope): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let cur: Scope = s;
  for stmt in stmts {
    out = out.append(pretype_stmt(stmt, cur));
    cur = bind_stmt(stmt, cur);
  }
  return out;
}

function pretype_at(x: ast.Expr, own acc: boolean): boolean {
  if (acc) {
    return true;
  }
  match (x) {
    ast.ExprCall(c) => {
      if (use_untyped(c)) {
        return true;
      }
      if (!parser.is_value_block(c)) {
        return false;
      }
      return vb_local_name(parser.vb_body(c)).len() > 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function colliding_variant_names(mod: parser.Module): string[] {
  let full: string[] = [];
  for ed in mod.enums {
    for vn in ed.variant_names {
      full = full.append(vn);
    }
  }
  for sd in parser.inject_builtin_enums([]) {
    if (sd.enum_owner.len() > 0) {
      full = full.append(sd.name);
    }
  }
  let seen: string[] = [];
  let seen_full: string[] = [];
  let out: string[] = [];
  let i: i32 = 0;
  while (i < full.len()) {
    let b: string = variant_bare_name(full[i]);
    let at: i32 = util.index_of_str(seen, b);
    if (at < 0) {
      seen = seen.append(b);
      seen_full = seen_full.append(full[i]);
    } else if (seen_full[at] != full[i] && !util.has_str(out, b)) {
      out = out.append(b);
    }
    i = i + 1;
  }
  return out;
}

function variant_bare_name(name: string): string {
  let i: i32 = name.len() - 2;
  while (i > 0) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      return slice_unchecked(name, i + 2, name.len()) + "";
    }
    i = i - 1;
  }
  return name;
}

function rescope_pattern(p: ast.Pattern, whole: typeinfo.Type, s: Scope): ast.Pattern {
  if let ast.PatVariant(pv) = p {
    if (variant_pattern_qualified(pv.type_name)) {
      return p;
    }
    if let typeinfo.TypeUnion(u) = whole {
      let members: string[] = enum_members(s, u.name, pv.type_name);
      if (util.has_str(members, pv.type_name)) {
        return p;
      }
      let bare: string = variant_bare_name(pv.type_name);
      for v in members {
        if (variant_bare_name(v) == bare) {
          return ast.PatVariant { ...pv, type_name: v };
        }
      }
    }
  }
  return p;
}

function enum_members(s: Scope, name: string, variant: string): string[] {
  let us: UnionSig = s.lookup_union(name);
  if (us.name.len() > 0) {
    return us.variants;
  }
  let out: string[] = [];
  if (variant_bare_name(variant).len() == variant.len()) {
    return out;
  }
  for sd in parser.inject_builtin_enums([]) {
    if (sd.enum_owner == name) {
      out = out.append(sd.name);
    }
  }
  return out;
}

struct RescopeScan { coll: string[], found: boolean }

function rescope_at_stmt(st: ast.Stmt, own a: RescopeScan): RescopeScan {
  if (a.found) {
    return a;
  }
  if (pretype_needed_stmt(st, false)) {
    return RescopeScan { ...a, found: true };
  }
  if let ast.StmtMatch(m) = st {
    for arm in m.arms {
      if let ast.PatVariant(pv) = arm.pattern {
        if (parser.is_record_pattern(pv) || util.has_str(a.coll, variant_bare_name(pv.type_name))) {
          return RescopeScan { ...a, found: true };
        }
      }
    }
  }
  return a;
}

function rescope_at_expr(e: ast.Expr, own a: RescopeScan): RescopeScan {
  if (!a.found && pretype_at(e, false)) {
    return RescopeScan { ...a, found: true };
  }
  return a;
}

function needs_pretype_or_rescope(stmts: ast.Stmt[], coll: string[]): boolean {
  let a: RescopeScan = RescopeScan { coll: coll, found: false };
  for stmt in stmts {
    a = astwalk.fold_stmt_nodes(stmt, a, rescope_at_stmt, rescope_at_expr, astwalk.descend_all);
  }
  return a.found;
}

function struct_record_match(m: ast.StmtMatch, s: Scope): boolean {
  let head: string = parser.struct_record_head(m);
  if (head.len() == 0) {
    return false;
  }
  if let typeinfo.TypeStruct(st) = check_expr(m.scrutinee, s) {
    let sig: StructSig = s.lookup_struct(st.name);
    return sig.name == st.name && sig.enum_owner.len() == 0 && head == st.name;
  }
  return false;
}

function struct_record_value_body(lm: ast.ExprLambda, s: Scope): ast.Stmt[] {
  if (lm.origin != parser.ORIGIN_MATCH_EXPR) {
    return lm.body;
  }
  if (lm.body.len() == 1) {
    if let Some(m) = parser.struct_record_source(lm.body[0]) {
      if (struct_record_match(m, s)) {
        return parser.struct_record_value_body(m, lm.ret_type);
      }
    }
  }
  let value: string = vb_local_name(lm.body);
  if (value.len() > 0) {
    if let Some(m) = parser.struct_record_source(lm.body[1]) {
      if (struct_record_match(m, s)) {
        return lm.body.with(1, parser.lower_struct_record_match(m, value));
      }
    }
  }
  return lm.body;
}

function pretype_needed_stmt(st: ast.Stmt, own found: boolean): boolean {
  if (found) {
    return true;
  }
  if let ast.StmtIf(f) = st {
    return f.sugar.origin == "" && f.sugar.tup.len() > 0;
  }
  return false;
}

function use_untyped(c: ast.ExprCall): boolean {
  if (c.args.len() == 0) {
    return false;
  }
  if let ast.ExprLambda(lm) = c.args[c.args.len() - 1] {
    if (lm.origin != parser.ORIGIN_USE || lm.params.len() == 0) {
      return false;
    }
    return lm.ret_type.len() == 0 || lm.use_infer && lm.params[0].type_name.len() == 0;
  }
  return false;
}

function use_callback_type(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if let ast.ExprIdent(id) = c.callee {
    let last: typeinfo.Type = t_unknown("use: callee has no signature");
    if let typeinfo.TypeFunc(ft) = s.lookup(id.name) {
      if (ft.param_types.len() > 0) {
        last = ft.param_types[ft.param_types.len() - 1];
      }
    } else {
      let sig: FuncSig = s.lookup_sig(id.name);
      if (sig.param_types.len() > 0) {
        last = use_callback_slot(sig, c, s);
      }
    }
    if let typeinfo.TypeFunc(cb) = last {
      if (cb.params_known && cb.param_types.len() > 0) {
        return last;
      }
    }
  }
  return t_unknown("use: callee has no signature");
}

function use_binding_type(c: ast.ExprCall, s: Scope): typeinfo.Type {
  if let typeinfo.TypeFunc(cb) = use_callback_type(c, s) {
    return cb.param_types[0];
  }
  return t_unknown("use: callee has no signature");
}

function use_callback_slot(sig: FuncSig, c: ast.ExprCall, s: Scope): typeinfo.Type {
  let at: i32 = sig.param_types.len() - 1;
  if (sig.all_type_params.len() == 0 || at >= sig.param_type_names.len()) {
    return sig.param_types[at];
  }
  let written: ast.Expr[] = [];
  let i: i32 = 0;
  while (i + 1 < c.args.len()) {
    written = written.append(c.args[i]);
    i = i + 1;
  }
  let (bn, bt) = arg_bindings(sig, ast.ExprCall { ...c, args: written }, s);
  let slot: parser.TypeRef = sig_param_ref(sig, at);
  let f: parser.TypeRef = parser.ref_ungroup(slot);
  if (!parser.ref_is_fn_value(slot) || f.args.len() < 2) {
    return sig.param_types[at];
  }
  let unbound: string[] = [];
  for tp in sig.all_type_params {
    if (!util.has_str(bn, tp)) {
      unbound = unbound.append(tp);
    }
  }
  if (type_ref_names_any(f.args[0], unbound)) {
    return t_unknown("use: callback parameter names an unbound type parameter");
  }
  let whole: typeinfo.Type = type_from_ref_subst(slot, bn, bt, s.type_names());
  if (type_ref_names_any(parser.ref_fn_result(slot), unbound)) {
    if let typeinfo.TypeFunc(cb) = whole {
      return typeinfo.TypeFunc { ...cb, ret_type: t_unknown("use: callback result names an unbound type parameter") };
    }
  }
  return whole;
}

function use_typed(c: ast.ExprCall, s: Scope): ast.ExprCall {
  let cbt: typeinfo.Type = use_callback_type(c, s);
  let t: typeinfo.Type = t_unknown("use: callee has no signature");
  if let typeinfo.TypeFunc(cb) = cbt {
    t = cb.param_types[0];
  }
  let at: i32 = c.args.len() - 1;
  if let ast.ExprLambda(lm) = c.args[at] {
    let p: ast.ParamDecl = lm.params[0];
    if (p.type_name.len() == 0) {
      p = decltypes.fn_param_from_type(p.name, t);
    }
    if (p.type_name.len() == 0) {
      let sp: string = typeinfo.spelling(t);
      if (sp.len() == 0) {
        return c;
      }
      p = ast.ParamDecl { ...lm.params[0], type_name: sp };
    }
    let nparams: ast.ParamDecl[] = [p];
    let i: i32 = 1;
    while (i < lm.params.len()) {
      nparams = nparams.append(lm.params[i]);
      i = i + 1;
    }
    let nargs: ast.Expr[] = [];
    let j: i32 = 0;
    while (j < at) {
      nargs = nargs.append(c.args[j]);
      j = j + 1;
    }
    nargs = nargs.append(use_ret_typed(ast.ExprLambda { ...lm, params: nparams }, cbt));
    return ast.ExprCall { ...c, args: nargs };
  }
  return c;
}

function use_ret_typed(lm: ast.ExprLambda, cbt: typeinfo.Type): ast.ExprLambda {
  if (lm.ret_type.len() > 0) {
    return lm;
  }
  if let typeinfo.TypeFunc(cb) = cbt {
    if (is_unknown(cb.ret_type)) {
      return lm;
    }
    let d: ast.ParamDecl = decltypes.param_from_type("", cb.ret_type);
    if (d.type_name.len() == 0) {
      return lm;
    }
    return ast.ExprLambda { ...lm, ret_type: d.type_name, ret_fn_ret: d.fn_ret, ret_fn_param_types: d.fn_param_types };
  }
  return lm;
}

pub function pretype_module(mod: parser.Module): parser.Module {
  let coll: string[] = colliding_variant_names(mod);
  if (needs_pretype_or_rescope(mod.top_stmts, coll)) {
    return pretype_module_in(mod, module_env(mod), whole_focus(mod));
  }
  for fd in mod.funcs {
    if (needs_pretype_or_rescope(fd.body, coll)) {
      return pretype_module_in(mod, module_env(mod), whole_focus(mod));
    }
  }
  return mod;
}

function pretype_module_in(mod: parser.Module, env: ModuleEnv, focus: Focus): parser.Module {
  let coll: string[] = colliding_variant_names(mod);
  let top_hit: boolean = focus.top && needs_pretype_or_rescope(mod.top_stmts, coll);
  let hits: boolean[] = [];
  let any: boolean = top_hit;
  let k: i32 = 0;
  for fn in mod.funcs {
    let hit: boolean = focus.funcs[k] && needs_pretype_or_rescope(fn.body, coll);
    k = k + 1;
    hits = hits.append(hit);
    if (hit) {
      any = true;
    }
  }
  if (!any) {
    return mod;
  }
  let nfuncs: parser.FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let func: parser.FuncDecl = mod.funcs[i];
    if (hits[i]) {
      let fs: Scope = build_func_scope(func, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
      nfuncs = nfuncs.append(parser.FuncDecl { ...func, body: pretype_stmts(func.body, fs) });
    } else {
      nfuncs = nfuncs.append(func);
    }
    i = i + 1;
  }
  let ntop: ast.Stmt[] = mod.top_stmts;
  if (top_hit) {
    ntop = pretype_stmts(mod.top_stmts, new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs));
  }
  return parser.Module { ...mod, funcs: nfuncs, top_stmts: ntop };
}

struct LitInfer { parent: i32[], width: typeinfo.Type[], keys: string[], cargs: string[], ctags: string[], pend: ast.Expr[], pend_id: i32[], pend_scope: Scope[], skeys: string[], snames: string[], sfirst: i32[], sargs: string[], sids: i32[], wkeys: string[], wtags: string[], eargs: string[], eids: i32[], tkeys: string[], ttypes: typeinfo.Type[] }

struct LitRewrite { keys: string[], tags: string[], cargs: string[], ctags: string[] }

const LIT_MARK: string = "literal local #";

const LIT_WIDE: i32 = 0;

function lit_marker(k: i32): typeinfo.Type {
  return t_unknown(LIT_MARK + util.i32_to_string(k));
}

function lit_id(t: typeinfo.Type): i32 {
  if let typeinfo.TypeUnknown(u) = t {
    let n: i32 = LIT_MARK.len();
    if (u.reason.len() <= n || slice_unchecked(u.reason, 0, n) != LIT_MARK) {
      return 0 - 1;
    }
    let k: i32 = 0;
    let i: i32 = n;
    while (i < u.reason.len()) {
      k = k * 10 + u.reason[i] as i32 - 48;
      i = i + 1;
    }
    return k;
  }
  return 0 - 1;
}

const LIT_STRUCT_MARK: string = "literal struct #";

function lit_struct_marker(name: string, ids: i32[]): typeinfo.Type {
  let spelled: string = LIT_STRUCT_MARK + name + "|";
  let i: i32 = 0;
  while (i < ids.len()) {
    if (i > 0) {
      spelled = spelled + ",";
    }
    spelled = spelled + util.i32_to_string(ids[i]);
    i = i + 1;
  }
  return t_unknown(spelled);
}

function lit_struct_of(t: typeinfo.Type): (string, i32[]) {
  let none: i32[] = [];
  if let typeinfo.TypeUnknown(u) = t {
    let n: i32 = LIT_STRUCT_MARK.len();
    if (u.reason.len() <= n || slice_unchecked(u.reason, 0, n) != LIT_STRUCT_MARK) {
      return ("", none);
    }
    let bar: i32 = util.index_of_sub(u.reason, "|");
    let ids: i32[] = [];
    let k: i32 = 0;
    let neg: boolean = false;
    let i: i32 = bar + 1;
    while (i <= u.reason.len()) {
      if (i == u.reason.len() || u.reason[i] as i32 == 44) {
        if (neg) {
          k = 0 - k;
        }
        ids = ids.append(k);
        k = 0;
        neg = false;
      } else if (u.reason[i] as i32 == 45) {
        neg = true;
      } else {
        k = k * 10 + u.reason[i] as i32 - 48;
      }
      i = i + 1;
    }
    return (slice_unchecked(u.reason, n, bar) + "", ids);
  }
  return ("", none);
}

function lit_struct_read(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprIdent(id) = e {
    let (name, ids) = lit_struct_of(s.lookup(id.name));
    return name.len() > 0;
  }
  return false;
}

function lit_enum_read(e: ast.Expr, s: Scope): boolean {
  if let typeinfo.TypeUnion(u) = check_expr(e, s) {
    for arg in u.args {
      if (lit_id(arg) >= 0) {
        return true;
      }
    }
  }
  return false;
}

function lit_struct_field_class(fa: ast.ExprFieldAccess, s: Scope): i32 {
  if let ast.ExprIdent(oid) = fa.obj {
    let (name, ids) = lit_struct_of(s.lookup(oid.name));
    if (name.len() == 0) {
      return 0 - 1;
    }
    let sig: StructSig = s.lookup_struct(name);
    let fi: i32 = field_index(sig, fa.field);
    if (fi < 0 || fi >= sig.field_type_names.len()) {
      return 0 - 1;
    }
    let ti: i32 = util.index_of_str(sig.type_params, sig.field_type_names[fi]);
    if (ti >= 0 && ti < ids.len()) {
      return ids[ti];
    }
  }
  return 0 - 1;
}

function lit_tree(e: ast.Expr, s: Scope, ids: i32[]): (boolean, i32[]) {
  match (e) {
    ast.ExprNumber(_) => {
      if (unsettled_int_literal(e)) {
        return (true, ids);
      }
      if (int_literal_tree(e)) {
        return (true, ids.append(LIT_WIDE));
      }
      return (false, ids);
    },
    ast.ExprIdent(id) => {
      let k: i32 = lit_id(s.lookup(id.name));
      if (k < 0) {
        return (false, ids);
      }
      return (true, ids.append(k));
    },
    ast.ExprFieldAccess(fa) => {
      let fk: i32 = lit_struct_field_class(fa, s);
      if (fk < 0) {
        return (false, ids);
      }
      return (true, ids.append(fk));
    },
    ast.ExprUnary(u) => {
      if (u.op == "-" || u.op == "+") {
        if (unsettled_int_literal(e)) {
          return (true, ids);
        }
        return lit_tree(u.operand, s, ids);
      }
      return (false, ids);
    },
    ast.ExprBinary(b) => {
      if (!int_operand_op(b.op)) {
        return (false, ids);
      }
      let (l, lids) = lit_tree(b.left, s, ids);
      let (r, rids) = lit_tree(b.right, s, lids);
      return (l && r, rids);
    },
    _ => {
      return (false, ids);
    }
  }
  return (false, ids);
}

function lit_find(st: LitInfer, k: i32): i32 {
  let r: i32 = k;
  while (st.parent[r] != r) {
    r = st.parent[r];
  }
  return r;
}

function lit_new(st: LitInfer, key: string): LitInfer {
  return LitInfer { ...st, parent: st.parent.append(st.parent.len()), width: st.width.append(t_unknown("open")), keys: st.keys.append(key) };
}

function lit_fix(st: LitInfer, ids: i32[], w: typeinfo.Type): LitInfer {
  if (!is_integer(w) && !is_float(w)) {
    return st;
  }
  let out: LitInfer = st;
  for k in ids {
    let r: i32 = lit_find(out, k);
    if (is_unknown(out.width[r]) && is_integer(w) || is_poly_float(out.width[r]) && is_float(w)) {
      out = LitInfer { ...out, width: out.width.with(r, w) };
    }
  }
  return out;
}

function lit_link(st: LitInfer, ids: i32[]): LitInfer {
  let out: LitInfer = st;
  let i: i32 = 1;
  while (i < ids.len()) {
    let ra: i32 = lit_find(out, ids[0]);
    let rb: i32 = lit_find(out, ids[i]);
    let afixed: boolean = !is_unknown(out.width[ra]) && !is_poly_float(out.width[ra]);
    let bfixed: boolean = !is_unknown(out.width[rb]) && !is_poly_float(out.width[rb]);
    if (ra != rb && !(afixed && bfixed)) {
      if (bfixed) {
        out = LitInfer { ...out, parent: out.parent.with(ra, rb) };
      } else {
        out = LitInfer { ...out, parent: out.parent.with(rb, ra) };
        if (is_unknown(out.width[ra]) && is_poly_float(out.width[rb])) {
          out = LitInfer { ...out, width: out.width.with(ra, out.width[rb]) };
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function lit_is_cmp(op: string): boolean {
  return op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=";
}

function lit_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprIdent(id) = e {
    st = lit_type_demand(s.lookup(id.name), want, st);
  }
  if ((is_integer(want) || is_float(want)) && open_tree(e, s)) {
    return demand_open(e, want, s, st);
  }
  match (want) {
    typeinfo.TypeUnion(wu) => {
      return lit_union_demand(e, wu, s, st);
    },
    typeinfo.TypeStruct(ws) => {
      return lit_struct_demand(e, ws, s, st);
    },
    typeinfo.TypeTuple(wt) => {
      return lit_tuple_demand(e, wt, s, st);
    },
    typeinfo.TypeArray(wa) => {
      return lit_array_demand(e, wa, s, st);
    },
    _ => {}
  }
  return lit_other_demand(e, want, s, st);
}

function lit_other_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      return lit_value_block(c, want, s, st);
    }
  }
  return lit_expr(e, s, gcall_demand(e, want, s, st));
}

function lit_union_demand(e: ast.Expr, wu: typeinfo.TypeUnion, s: Scope, st: LitInfer): LitInfer {
  let sig: UnionSig = s.lookup_union(wu.name);
  if (sig.instance != "") {
    return lit_demand(e, s.resolve_type(sig.instance), s, st);
  }
  if let typeinfo.TypeUnion(have) = check_expr(e, s) {
    if (have.name == wu.name && have.args.len() == wu.args.len()) {
      let out: LitInfer = st;
      let j: i32 = 0;
      while (j < have.args.len()) {
        let k: i32 = lit_id(have.args[j]);
        if (k >= 0) {
          out = lit_fix(out, [k], wu.args[j]);
        }
        j = j + 1;
      }
      return out;
    }
  }
  return lit_other_demand(e, wu, s, st);
}

function lit_struct_demand(e: ast.Expr, ws: typeinfo.TypeStruct, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprIdent(sid) = e {
    let (name, ids) = lit_struct_of(s.lookup(sid.name));
    if (name == ws.name && ids.len() == ws.args.len()) {
      let outs: LitInfer = st;
      let j: i32 = 0;
      while (j < ids.len()) {
        if (ids[j] >= 0) {
          outs = lit_fix(outs, [ids[j]], ws.args[j]);
        }
        j = j + 1;
      }
      return outs;
    }
  }
  return lit_other_demand(e, ws, s, st);
}

function lit_tuple_demand(e: ast.Expr, wt: typeinfo.TypeTuple, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprTuple(tl) = e {
    if (tl.elements.len() == wt.elements.len()) {
      let out: LitInfer = st;
      let i: i32 = 0;
      while (i < tl.elements.len()) {
        out = lit_demand(tl.elements[i], wt.elements[i], s, out);
        i = i + 1;
      }
      return out;
    }
  }
  return lit_other_demand(e, wt, s, st);
}

function lit_array_demand(e: ast.Expr, wa: typeinfo.TypeArray, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprArray(arr) = e {
    let out: LitInfer = st;
    for el in arr.elements {
      if let typeinfo.TypeTuple(_) = wa.elem {
        if let ast.ExprCall(c) = el {
          if (parser.is_value_block(c)) {
            out = lit_expr(el, s, out);
            continue;
          }
        }
      }
      out = lit_demand(el, wa.elem, s, out);
    }
    return out;
  }
  return lit_other_demand(e, wa, s, st);
}

function lit_arg(e: ast.Expr, s: Scope, st: LitInfer): LitInfer {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed) {
    return lit_link(st, ids);
  }
  return lit_expr(e, s, st);
}

function lit_binary(b: ast.ExprBinary, s: Scope, st: LitInfer): LitInfer {
  if (!int_operand_op(b.op) && !lit_is_cmp(b.op)) {
    return lit_expr(b.right, s, lit_expr(b.left, s, st));
  }
  let (ls, lids) = lit_tree(b.left, s, []);
  let (rs, rids) = lit_tree(b.right, s, []);
  if (ls && rs) {
    let all: i32[] = lids;
    for k in rids {
      all = all.append(k);
    }
    return lit_link(st, all);
  }
  let lo: boolean = open_tree(b.left, s);
  let ro: boolean = open_tree(b.right, s);
  if (ls) {
    return lit_expr(b.right, s, lit_beside(lids, b.right, ro, s, st));
  }
  if (rs) {
    return lit_expr(b.left, s, lit_beside(rids, b.left, lo, s, st));
  }
  return lit_expr(b.right, s, lit_expr(b.left, s, gcall_operands(b, lo, ro, s, st)));
}

function lit_beside(ids: i32[], other: ast.Expr, open: boolean, s: Scope, st: LitInfer): LitInfer {
  if (ids.len() == 0) {
    return st;
  }
  if (!open) {
    return lit_fix(st, ids, check_expr(other, s));
  }
  if (open_wide(other, s)) {
    return lit_fix(st, ids, t_i64());
  }
  let out: LitInfer = lit_link(st, ids);
  return LitInfer { ...out, pend: out.pend.append(other), pend_id: out.pend_id.append(ids[0]), pend_scope: out.pend_scope.append(s) };
}

function gcall_operands(b: ast.ExprBinary, lo: boolean, ro: boolean, s: Scope, st: LitInfer): LitInfer {
  if (lo && !ro) {
    return demand_open(b.left, check_expr(b.right, s), s, st);
  }
  if (ro && !lo) {
    return demand_open(b.right, check_expr(b.left, s), s, st);
  }
  if (lo && ro && (open_wide(b.left, s) || open_wide(b.right, s))) {
    return demand_open(b.right, t_i64(), s, demand_open(b.left, t_i64(), s, st));
  }
  return st;
}

function open_tree(e: ast.Expr, s: Scope): boolean {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed || gcall_open(e, s)) {
    return true;
  }
  if let ast.ExprUnary(u) = e {
    return (u.op == "-" || u.op == "+") && open_tree(u.operand, s);
  }
  if let ast.ExprBinary(b) = e {
    return int_operand_op(b.op) && open_tree(b.left, s) && open_tree(b.right, s);
  }
  return false;
}

function demand_open(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed) {
    return lit_fix(st, ids, want);
  }
  if let ast.ExprUnary(u) = e {
    return demand_open(u.operand, want, s, st);
  }
  if let ast.ExprBinary(b) = e {
    return demand_open(b.right, want, s, demand_open(b.left, want, s, st));
  }
  return lit_expr(e, s, gcall_demand(e, want, s, st));
}

function open_wide(e: ast.Expr, s: Scope): boolean {
  if let ast.ExprUnary(u) = e {
    return open_wide(u.operand, s);
  }
  if let ast.ExprBinary(b) = e {
    return open_wide(b.left, s) || open_wide(b.right, s);
  }
  let (ce, tvs) = gcall_open_tvars(e, s);
  if let ast.ExprCall(c) = ce {
    let sig: FuncSig = gcall_sig(c, s);
    let k: i32 = 0;
    while (k < sig.param_type_names.len() && k < c.args.len()) {
      if (util.has_str(tvs, sig.param_type_names[k]) && wide_int_tree(c.args[k])) {
        return true;
      }
      k = k + 1;
    }
  }
  return false;
}

function wide_int_tree(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return int_literal_tree(e) && parser.literal_is_i64(n.text);
    },
    ast.ExprUnary(u) => {
      return wide_int_tree(u.operand);
    },
    ast.ExprBinary(b) => {
      return wide_int_tree(b.left) || wide_int_tree(b.right);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function gcall_of(e: ast.Expr, want: typeinfo.Type, s: Scope): (ast.Expr, typeinfo.Type, boolean) {
  if let ast.ExprFieldAccess(fa) = e {
    let (lifted, ok) = field_want_lift(check_expr(fa.obj, s), fa.field, want, s);
    if (!ok) {
      return (e, want, false);
    }
    return gcall_of(fa.obj, lifted, s);
  }
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      return (e, want, false);
    }
    return (e, want, gcall_sig(c, s).ret_type_name.len() > 0 && gcall_sig(c, s).typevars.len() > 0);
  }
  return (e, want, false);
}

function field_want_lift(ot: typeinfo.Type, field: string, want: typeinfo.Type, s: Scope): (typeinfo.Type, boolean) {
  if let typeinfo.TypeTuple(tt) = ot {
    let idx: i32 = digit_string_to_i32(field);
    if (idx < 0 || idx >= tt.elements.len()) {
      return (ot, false);
    }
    return (t_tuple(unknown_slots(tt.elements.len()).with(idx, want)), true);
  }
  if let typeinfo.TypeStruct(sn) = ot {
    let sig: StructSig = s.lookup_struct(sn.name);
    let fi: i32 = field_index(sig, field);
    if (fi < 0 || fi >= sig.field_type_names.len()) {
      return (ot, false);
    }
    let ti: i32 = util.index_of_str(sig.type_params, sig.field_type_names[fi]);
    if (ti < 0) {
      return (ot, false);
    }
    return (t_struct_g(sn.name, unknown_slots(sig.type_params.len()).with(ti, want)), true);
  }
  return (ot, false);
}

function unknown_slots(n: i32): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  while (out.len() < n) {
    out = out.append(t_unknown("not read"));
  }
  return out;
}

function gcall_sig(c: ast.ExprCall, s: Scope): FuncSig {
  if let ast.ExprIdent(cid) = c.callee {
    let at: i32 = s.sig_at(cid.name);
    if (at >= 0) {
      return s.sigs.sigs[at];
    }
  }
  return FuncSig { receiver: "", name: "", param_types: [], param_own: [], ret_type: t_unknown("no callee"), all_type_params: [], type_params: [], type_bounds: [], ret_type_name: "", param_type_names: [], param_names: [], is_const: false, typevars: [], module: "", refs: [] };
}

function lit_bound_typevar(sig: FuncSig, c: ast.ExprCall, tp: string, s: Scope): boolean {
  let (wn, _) = written_type_bindings(sig, c, s);
  if (util.has_str(wn, tp)) {
    return false;
  }
  let n: i32 = 0;
  let k: i32 = 0;
  while (k < sig.param_type_names.len() && k < c.args.len()) {
    if (sig.param_type_names[k] == tp) {
      let (seed, ids) = lit_tree(c.args[k], s, []);
      if (!seed && !int_literal_tree(c.args[k]) && !gcall_open(c.args[k], s)) {
        return false;
      }
      n = n + 1;
    } else if (type_ref_names_any(sig_param_ref(sig, k), [tp])) {
      return false;
    }
    k = k + 1;
  }
  return n > 0;
}

function gcall_open(e: ast.Expr, s: Scope): boolean {
  let (ce, tvs) = gcall_open_tvars(e, s);
  return tvs.len() > 0;
}

function gcall_open_tvars(e: ast.Expr, s: Scope): (ast.Expr, string[]) {
  let tvs: string[] = [];
  let (ce, lifted, ok) = gcall_of(e, t_unknown("open"), s);
  if (!ok) {
    return (e, tvs);
  }
  if let ast.ExprCall(c) = ce {
    let sig: FuncSig = gcall_sig(c, s);
    let ret: parser.TypeRef = sig_ret_ref(sig);
    for tp in sig.typevars {
      if (type_ref_names_any(ret, [tp]) && lit_bound_typevar(sig, c, tp, s)) {
        tvs = tvs.append(tp);
      }
    }
  }
  return (ce, tvs);
}

function gcall_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let (ce, lifted, ok) = gcall_of(e, want, s);
  if (!ok) {
    return st;
  }
  if let ast.ExprCall(c) = ce {
    let sig: FuncSig = gcall_sig(c, s);
    let (bn, bt) = gc_bind_param(sig_ret_ref(sig), lifted, sig.typevars, s.type_names(), [], []);
    let out: LitInfer = st;
    let i: i32 = 0;
    while (i < bn.len()) {
      if ((is_integer(bt[i]) || is_float(bt[i])) && lit_bound_typevar(sig, c, bn[i], s)) {
        out = gcall_settle(c, sig, bn[i], bt[i], s, out);
      }
      i = i + 1;
    }
    return out;
  }
  return st;
}

function gcall_settle(c: ast.ExprCall, sig: FuncSig, tp: string, w: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let tag: string = typeinfo.spelling(w);
  let out: LitInfer = st;
  let k: i32 = 0;
  while (k < sig.param_type_names.len() && k < c.args.len()) {
    if (sig.param_type_names[k] == tp) {
      let (seed, ids) = lit_tree(c.args[k], s, []);
      out = lit_fix(out, ids, w);
      if (int_literal_tree(c.args[k]) && (tag == "i32" || is_float(w) || lit_suffix_spelled(tag))) {
        out = LitInfer { ...out, cargs: out.cargs.append(gcall_arg_key(c, k)), ctags: out.ctags.append(tag) };
      }
      out = gcall_demand(c.args[k], w, s, out);
    }
    k = k + 1;
  }
  return out;
}

function gcall_arg_key(c: ast.ExprCall, k: i32): string {
  return "c" + util.i32_to_string(c.line) + ":" + util.i32_to_string(c.col) + "#" + util.i32_to_string(k);
}

function lit_call(c: ast.ExprCall, s: Scope, st: LitInfer): LitInfer {
  if (parser.is_value_block(c)) {
    return lit_value_block(c, t_unknown("value block"), s, st);
  }
  let out: LitInfer = lit_expr(c.callee, s, st);
  let reads: boolean = false;
  for arg in c.args {
    let (seed, ids) = lit_tree(arg, s, []);
    reads = reads || seed && ids.len() > 0 || lit_composite(arg) || !seed && open_tree(arg, s) || lit_struct_read(arg, s) || lit_enum_read(arg, s);
  }
  let pts: typeinfo.Type[] = [];
  if (reads) {
    pts = s.call_param_types(c);
  }
  let i: i32 = 0;
  while (i < c.args.len()) {
    if (i < pts.len()) {
      out = lit_demand(c.args[i], pts[i], s, out);
    } else {
      out = lit_arg(c.args[i], s, out);
    }
    i = i + 1;
  }
  return out;
}

function lit_value_block(c: ast.ExprCall, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if (is_unknown(want) || is_float(want)) {
    want = check_expr(c, lit_typed_scope(s, st));
  }
  if let ast.ExprLambda(vb) = c.callee {
    let cur: Scope = lambda_body_scope(vb, s).with_block_ret(want);
    let out: LitInfer = st;
    let last: i32 = vb.body.len() - 1;
    let i: i32 = 0;
    while (i < last) {
      let (ns, nst) = lit_stmt(vb.body[i], cur, out);
      cur = ns;
      out = nst;
      i = i + 1;
    }
    if (last < 0) {
      return out;
    }
    if let ast.StmtReturn(r) = vb.body[last] {
      return lit_demand(r.value, want, cur, lit_float_demand(r.value, want, cur, out));
    }
    return lit_value_branch(vb.body[last], want, cur, out);
  }
  return st;
}

function lit_value_branch(stmt: ast.Stmt, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if let ast.StmtIf(f) = stmt {
    st = lit_expr(f.cond, s, st);
    return lit_value_body(f.else_body, want, s, lit_value_body(f.then_body, want, s, st));
  }
  if let ast.StmtMatch(m) = stmt {
    st = lit_arg(m.scrutinee, s, st);
    for arm in m.arms {
      let cur: Scope = annotate_arm_scope(arm, s, check_expr(m.scrutinee, s));
      if (arm.has_guard) {
        st = lit_expr(arm.guard, cur, st);
      }
      st = lit_value_body(arm.body, want, cur, st);
    }
    return st;
  }
  let (scope, out) = lit_stmt(stmt, s, st);
  return out;
}

function lit_value_body(body: ast.Stmt[], want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  let cur: Scope = s;
  let i: i32 = 0;
  while (i + 1 < body.len()) {
    let (next, out) = lit_stmt(body[i], cur, st);
    cur = next;
    st = out;
    i = i + 1;
  }
  if (body.len() == 0) {
    return st;
  }
  if let ast.StmtReturn(r) = body[i] {
    return lit_demand(r.value, want, cur, lit_float_demand(r.value, want, cur, st));
  }
  return lit_value_branch(body[i], want, cur, st);
}

function lit_float_needed(have: typeinfo.Type, want: typeinfo.Type): boolean {
  if (is_poly_int(have) && is_float(want)) {
    return true;
  }
  if let typeinfo.TypeTuple(h) = have {
    if let typeinfo.TypeTuple(w) = want {
      let i: i32 = 0;
      while (i < h.elements.len() && i < w.elements.len()) {
        if (lit_float_needed(h.elements[i], w.elements[i])) {
          return true;
        }
        i = i + 1;
      }
    }
  }
  return false;
}

function lit_float_key(e: ast.Expr): string {
  let shape: string = "";
  match (e) {
    ast.ExprIdent(id) => {
      shape = "id:" + id.name;
    },
    ast.ExprFieldAccess(fa) => {
      shape = "field:" + fa.field;
    },
    ast.ExprIndex(_) => {
      shape = "index";
    },
    ast.ExprUnary(u) => {
      shape = "unary:" + u.op;
    },
    ast.ExprBinary(b) => {
      shape = "binary:" + b.op;
    },
    ast.ExprCall(_) => {
      shape = "call";
    },
    _ => {
      return "";
    }
  }
  return "f" + util.i32_to_string(expr_line(e)) + ":" + util.i32_to_string(expr_col(e)) + ":" + shape;
}

function lit_float_demand(e: ast.Expr, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if let ast.ExprIdent(id) = e {
    if (parser.is_value_local_name(id.name)) {
      return st;
    }
  }
  if let ast.ExprTuple(t) = e {
    if let typeinfo.TypeTuple(w) = want {
      let i: i32 = 0;
      while (i < t.elements.len() && i < w.elements.len()) {
        st = lit_float_demand(t.elements[i], w.elements[i], s, st);
        i = i + 1;
      }
      return st;
    }
  }
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      return lit_value_body(parser.vb_body(c), want, s, st);
    }
    st = lit_float_constructor(c, want, s, st);
  }
  let have: typeinfo.Type = mx_arm_result_type(e, lit_typed_scope(s, st));
  if (lit_float_needed(have, want) && !int_literal_tree(e)) {
    return LitInfer { ...st, cargs: st.cargs.append(lit_float_key(e)), ctags: st.ctags.append(typeinfo.spelling(want)) };
  }
  return st;
}

function lit_float_constructor(c: ast.ExprCall, want: typeinfo.Type, s: Scope, st: LitInfer): LitInfer {
  if (constructor_destination(c, want, s)) {
    let index: i32 = builtin_payload_index(ctor_variant_name(c), want);
    let args: typeinfo.Type[] = nominal_args(want);
    if (index >= 0 && index < args.len() && c.args.len() == 1) {
      return lit_float_demand(c.args[0], args[index], s, st);
    }
  }
  return st;
}

function lit_typed_scope(s: Scope, st: LitInfer): Scope {
  let types: typeinfo.Type[] = s.types;
  let lits: string[] = s.lit_locals;
  let i: i32 = 0;
  while (i < types.len()) {
    let original: typeinfo.Type = types[i];
    types = types.with(i, lit_typed_type(original, st, true));
    let k: i32 = lit_id(original);
    if (k >= 0) {
      let w: typeinfo.Type = st.width[lit_find(st, k)];
      if (is_unknown(w)) {
        w = typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: true };
        lits = lits.append(s.names[i]);
      }
      types = types.with(i, w);
    }
    i = i + 1;
  }
  return Scope { ...s, types: types, lit_locals: lits };
}

function lit_typed_type(t: typeinfo.Type, st: LitInfer, poly: boolean): typeinfo.Type {
  let k: i32 = lit_id(t);
  if (k >= 0) {
    let w: typeinfo.Type = st.width[lit_find(st, k)];
    if (is_unknown(w)) {
      return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: poly };
    }
    return w;
  }
  if let typeinfo.TypeTuple(tt) = t {
    let elems: typeinfo.Type[] = [];
    for el in tt.elements {
      elems = elems.append(lit_typed_type(el, st, poly));
    }
    return t_tuple(elems);
  }
  if let typeinfo.TypeArray(a) = t {
    return typeinfo.TypeArray { ...a, elem: lit_typed_type(a.elem, st, poly) };
  }
  return t;
}

function lit_type_demand(have: typeinfo.Type, want: typeinfo.Type, st: LitInfer): LitInfer {
  let k: i32 = lit_id(have);
  if (k >= 0) {
    return lit_fix(st, [k], want);
  }
  if let typeinfo.TypeTuple(h) = have {
    if let typeinfo.TypeTuple(w) = want {
      if (h.elements.len() == w.elements.len()) {
        let i: i32 = 0;
        while (i < h.elements.len()) {
          st = lit_type_demand(h.elements[i], w.elements[i], st);
          i = i + 1;
        }
      }
    }
  }
  if let typeinfo.TypeArray(h) = have {
    if let typeinfo.TypeArray(w) = want {
      st = lit_type_demand(h.elem, w.elem, st);
    }
  }
  return st;
}

function lit_type_link(a: typeinfo.Type, b: typeinfo.Type, st: LitInfer): LitInfer {
  let left: i32 = lit_id(a);
  let right: i32 = lit_id(b);
  if (left >= 0 && right >= 0) {
    return lit_link(st, [left, right]);
  }
  if (left >= 0) {
    return lit_fix(st, [left], b);
  }
  if (right >= 0) {
    return lit_fix(st, [right], a);
  }
  if let typeinfo.TypeTuple(at) = a {
    if let typeinfo.TypeTuple(bt) = b {
      if (at.elements.len() == bt.elements.len()) {
        let i: i32 = 0;
        while (i < at.elements.len()) {
          st = lit_type_link(at.elements[i], bt.elements[i], st);
          i = i + 1;
        }
      }
    }
  }
  if let typeinfo.TypeArray(at) = a {
    if let typeinfo.TypeArray(bt) = b {
      st = lit_type_link(at.elem, bt.elem, st);
    }
  }
  return st;
}

function lit_composite_local(e: ast.Expr, s: Scope, st: LitInfer): (typeinfo.Type, LitInfer, boolean) {
  let (seed, ids) = lit_tree(e, s, []);
  if (seed || float_literal_tree(e)) {
    let k: i32 = st.parent.len();
    st = lit_new(st, "");
    if (float_literal_tree(e)) {
      st = LitInfer { ...st, width: st.width.with(k, typeinfo.TypeFloat { width: 64, polymorphic: true }) };
    }
    return (lit_marker(k), lit_link(st, ids.append(k)), true);
  }
  if let ast.ExprTuple(t) = e {
    let elems: typeinfo.Type[] = [];
    let any: boolean = false;
    for el in t.elements {
      let (ty, next, found) = lit_composite_local(el, s, st);
      st = next;
      any = any || found;
      elems = elems.append(ty);
    }
    return (t_tuple(elems), st, any);
  }
  if let ast.ExprArray(a) = e {
    if (a.elements.len() > 0) {
      let (elem, next, any) = lit_composite_local(a.elements[0], s, st);
      st = next;
      let i: i32 = 1;
      while (i < a.elements.len()) {
        let (ty, more, found) = lit_composite_local(a.elements[i], s, st);
        st = more;
        st = lit_type_link(elem, ty, st);
        i = i + 1;
      }
      return (t_array(elem), st, any);
    }
  }
  return (check_expr(e, lit_typed_scope(s, st)), st, false);
}

function lit_composite(e: ast.Expr): boolean {
  if let ast.ExprTuple(_) = e {
    return true;
  }
  if let ast.ExprArray(_) = e {
    return true;
  }
  if let ast.ExprCall(c) = e {
    return parser.is_value_block(c);
  }
  return false;
}

function lit_array(arr: ast.ExprArray, s: Scope, st: LitInfer): LitInfer {
  let out: LitInfer = st;
  let ids: i32[] = [];
  let sibling: typeinfo.Type = t_unknown("no typed element");
  for el in arr.elements {
    let (seed, eids) = lit_tree(el, s, []);
    if (seed) {
      for k in eids {
        ids = ids.append(k);
      }
    } else {
      out = lit_expr(el, s, out);
      if (is_unknown(sibling) && ids.len() > 0) {
        sibling = check_expr(el, s);
      }
    }
  }
  if (ids.len() == 0) {
    return out;
  }
  if (is_unknown(sibling) && ids.len() < arr.elements.len()) {
    for el in arr.elements {
      let (seed2, e2) = lit_tree(el, s, []);
      if (!seed2 && is_unknown(sibling)) {
        sibling = check_expr(el, s);
      }
    }
  }
  return lit_fix(lit_link(out, ids), ids, sibling);
}

function lit_struct_lit(sl: ast.ExprStructLit, s: Scope, st: LitInfer): LitInfer {
  let out: LitInfer = st;
  let sig: StructSig = s.lookup_struct(sl.type_name);
  let largs: typeinfo.Type[] = [];
  if (sig.type_params.len() > 0) {
    largs = struct_lit_args(sl, sig, s);
  }
  let i: i32 = 0;
  while (i < sl.field_values.len()) {
    let want: typeinfo.Type = t_unknown("no field");
    if (i < sl.field_names.len()) {
      let j: i32 = 0;
      while (j < sig.field_names.len()) {
        if (sig.field_names[j] == sl.field_names[i] && j < sig.field_types.len()) {
          want = sig.field_types[j];
          if (sig.type_params.len() > 0 && j < sig.field_type_names.len()) {
            want = widened_field_type(sig, j, largs, s);
          }
        }
        j = j + 1;
      }
    }
    out = lit_demand(sl.field_values[i], want, s, out);
    i = i + 1;
  }
  if (sl.has_base) {
    out = lit_expr(sl.base, s, out);
  }
  return out;
}

function lit_index(ix: ast.ExprIndex, s: Scope, st: LitInfer): LitInfer {
  let (seed, ids) = lit_tree(ix.index, s, []);
  if (!seed) {
    return lit_expr(ix.index, s, st);
  }
  if (ids.len() == 0) {
    return st;
  }
  let want: typeinfo.Type = t_i32();
  if let typeinfo.TypeMap(tm) = check_expr(ix.array, s) {
    want = tm.key;
  }
  return lit_fix(st, ids, want);
}

function lit_expr(e: ast.Expr, s: Scope, st: LitInfer): LitInfer {
  match (e) {
    ast.ExprBinary(b) => {
      return lit_binary(b, s, st);
    },
    ast.ExprUnary(u) => {
      return lit_arg(u.operand, s, st);
    },
    ast.ExprCall(c) => {
      return lit_call(c, s, st);
    },
    ast.ExprArray(arr) => {
      return lit_array(arr, s, st);
    },
    ast.ExprStructLit(sl) => {
      return lit_struct_lit(sl, s, st);
    },
    ast.ExprLambda(lm) => {
      return lit_lambda(lm, s, st);
    },
    ast.ExprTuple(tl) => {
      let out: LitInfer = st;
      for el in tl.elements {
        out = lit_arg(el, s, out);
      }
      return out;
    },
    ast.ExprIndex(ix) => {
      return lit_index(ix, s, lit_arg(ix.array, s, st));
    },
    ast.ExprSlice(sx) => {
      let out2: LitInfer = lit_arg(sx.array, s, st);
      if (!sx.open_start) {
        out2 = lit_demand(sx.start, t_i32(), s, out2);
      }
      if (!sx.open_end) {
        out2 = lit_demand(sx.end, t_i32(), s, out2);
      }
      return out2;
    },
    ast.ExprFieldAccess(fa) => {
      return lit_arg(fa.obj, s, st);
    },
    ast.ExprMapLit(ml) => {
      let out3: LitInfer = st;
      for k in ml.keys {
        out3 = lit_arg(k, s, out3);
      }
      for v in ml.vals {
        out3 = lit_arg(v, s, out3);
      }
      return out3;
    },
    ast.ExprFString(fs) => {
      let out4: LitInfer = st;
      let q: i32 = 0;
      while (q < fs.exprs.len()) {
        if (fs.is_expr[q]) {
          out4 = lit_arg(fs.exprs[q], s, out4);
        }
        q = q + 1;
      }
      return out4;
    },
    _ => {
      return st;
    }
  }
  return st;
}

function lit_lambda(lm: ast.ExprLambda, s: Scope, st: LitInfer): LitInfer {
  let bs: Scope = lambda_body_scope(lm, s);
  let out: LitInfer = lit_stmts(lm.body, bs, st);
  if (lm.ret_type.len() > 0) {
    return out;
  }
  let ids: i32[] = lit_return_ids(lm.body, bs, []);
  if (ids.len() == 0) {
    return out;
  }
  let w: typeinfo.Type = t_i32();
  for k in ids {
    let r: i32 = lit_find(out, k);
    if (!is_unknown(out.width[r]) && type_eq(w, t_i32())) {
      w = out.width[r];
    }
  }
  return lit_fix(out, ids, w);
}

function lit_return_ids(stmts: ast.Stmt[], s: Scope, ids: i32[]): i32[] {
  let cur: Scope = s;
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        let (seed, rids) = lit_tree(r.value, cur, []);
        if (seed) {
          for k in rids {
            ids = ids.append(k);
          }
        }
      },
      ast.StmtIf(f) => {
        ids = lit_return_ids(f.then_body, cur, ids);
        ids = lit_return_ids(f.else_body, cur, ids);
      },
      ast.StmtWhile(w) => {
        ids = lit_return_ids(w.body, cur, ids);
      },
      ast.StmtFor(fr) => {
        ids = lit_return_ids(fr.body, for_body_scope(fr, cur), ids);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          ids = lit_return_ids(arm.body, cur, ids);
        }
      },
      _ => {}
    }
    cur = bind_stmt(stmt, cur);
  }
  return ids;
}

function lit_var_key(v: ast.StmtVar): string {
  return "v" + util.i32_to_string(v.line) + ":" + util.i32_to_string(v.col) + ":" + v.name;
}

function lit_for_key(fr: ast.StmtFor, lo: ast.Expr): string {
  return "f" + util.i32_to_string(fr.line) + ":" + util.i32_to_string(ast.expr_line(lo)) + ":" + util.i32_to_string(ast.expr_col(lo)) + ":" + fr.var_name;
}

function lit_range_bounds(iter: ast.Expr): ast.Expr[] {
  if let ast.ExprCall(c) = iter {
    return c.args;
  }
  return [];
}

function lit_range(fr: ast.StmtFor, s: Scope, st: LitInfer): LitInfer {
  let bounds: ast.Expr[] = lit_range_bounds(fr.iter);
  let (ls, lids) = lit_tree(bounds[0], s, []);
  let (hs, hids) = lit_tree(bounds[1], s, []);
  let out: LitInfer = st;
  if (!ls) {
    out = lit_expr(bounds[0], s, out);
  }
  if (!hs) {
    out = lit_expr(bounds[1], s, out);
  }
  let body: Scope = for_body_scope(fr, s);
  if (ls) {
    let k: i32 = out.parent.len();
    out = lit_new(out, lit_for_key(fr, bounds[0]));
    let ids: i32[] = [k];
    for a in lids {
      ids = ids.append(a);
    }
    if (hs) {
      for b in hids {
        ids = ids.append(b);
      }
      out = lit_link(out, ids);
    } else {
      out = lit_fix(lit_link(out, ids), ids, check_expr(bounds[1], s));
    }
    body = body.bind(fr.var_name, lit_marker(k));
  } else if (hs) {
    out = lit_fix(out, hids, check_expr(bounds[0], s));
  }
  return lit_stmts(fr.body, body, out);
}

function lit_stmts(stmts: ast.Stmt[], s: Scope, st: LitInfer): LitInfer {
  let cur: Scope = s;
  let out: LitInfer = st;
  for stmt in stmts {
    let (ns, nst) = lit_stmt(stmt, cur, out);
    cur = ns;
    out = nst;
  }
  return out;
}

function lit_stmt(stmt: ast.Stmt, s: Scope, st: LitInfer): (Scope, LitInfer) {
  match (stmt) {
    ast.StmtVar(v) => {
      if (name_has_comma(v.name) || parser.is_destr_marker(v.type_name)) {
        return (bind_stmt(stmt, s), lit_expr(v.init, s, st));
      }
      if (v.type_name.len() > 0) {
        return (bind_stmt(stmt, s), lit_demand(v.init, var_declared_type(v, s), s, st));
      }
      let (seed, ids) = lit_tree(v.init, s, []);
      if (!seed) {
        if let ast.ExprCall(call) = v.init {
          let (enum_type, enum_state) = lit_enum_local(call, s, st);
          if (!is_unknown(enum_type)) {
            return (s.bind(v.name, enum_type), enum_state);
          }
        }
        if let ast.ExprArray(ea) = v.init {
          let wtag: string = widened_array_tag(ea, s);
          if (wtag.len() > 0) {
            let wst: LitInfer = lit_expr(v.init, s, st);
            return (bind_stmt(stmt, s), LitInfer { ...wst, wkeys: wst.wkeys.append(lit_var_key(v)), wtags: wst.wtags.append(wtag) });
          }
        }
        if let ast.ExprStructLit(sl) = v.init {
          let (ss, sst) = lit_struct_local(v, sl, s, lit_expr(v.init, s, st));
          if (ss.len() > 0) {
            let own_ids: i32[] = [];
            let oi: i32 = sst.sfirst[sst.sfirst.len() - 1];
            while (oi < sst.sids.len()) {
              own_ids = own_ids.append(sst.sids[oi]);
              oi = oi + 1;
            }
            return (s.bind(v.name, lit_struct_marker(ss, own_ids)), sst);
          }
        }
        if (lit_composite(v.init) || float_literal_tree(v.init)) {
          let (ct, cs, found) = lit_composite_local(v.init, s, st);
          if (found) {
            return (s.bind(v.name, ct), LitInfer { ...cs, tkeys: cs.tkeys.append(lit_var_key(v)), ttypes: cs.ttypes.append(ct) });
          }
        }
        return (bind_stmt(stmt, s), lit_expr(v.init, s, st));
      }
      let k: i32 = st.parent.len();
      return (s.bind(v.name, lit_marker(k)), lit_link(lit_new(st, lit_var_key(v)), ids.append(k)));
    },
    ast.StmtAssign(a) => {
      let tk: i32 = lit_id(s.lookup(a.target));
      if (tk < 0) {
        return (s, lit_demand(a.value, s.lookup(a.target), s, st));
      }
      let (seed2, ids2) = lit_tree(a.value, s, []);
      if (seed2) {
        return (s, lit_link(st, ids2.append(tk)));
      }
      let walked: LitInfer = lit_expr(a.value, s, st);
      return (s, lit_fix(walked, [tk], check_expr(a.value, s)));
    },
    ast.StmtReturn(r) => {
      return (s, lit_demand(r.value, s.ret_type, s, st));
    },
    ast.StmtExpr(x) => {
      return (s, lit_expr(x.value, s, st));
    },
    ast.StmtIf(f) => {
      let ci: LitInfer = lit_expr(f.cond, s, st);
      return (s, lit_stmts(f.else_body, s, lit_stmts(f.then_body, s, ci)));
    },
    ast.StmtWhile(w) => {
      return (s, lit_stmts(w.body, s, lit_expr(w.cond, s, st)));
    },
    ast.StmtFor(fr) => {
      if (for_iter_is_range(fr.iter)) {
        return (s, lit_range(fr, s, st));
      }
      return (s, lit_stmts(fr.body, for_body_scope(fr, s), lit_expr(fr.iter, s, st)));
    },
    ast.StmtMatch(m) => {
      let out: LitInfer = lit_arg(m.scrutinee, s, st);
      let whole: typeinfo.Type = check_expr(m.scrutinee, s);
      if let ast.ExprCall(call) = m.scrutinee {
        let (enum_type, enum_state) = lit_enum_local(call, s, out);
        if (!is_unknown(enum_type)) {
          whole = enum_type;
          out = enum_state;
        }
      }
      for arm in m.arms {
        let asc: Scope = annotate_arm_scope(arm, s, whole);
        if (arm.has_guard) {
          out = lit_expr(arm.guard, asc, out);
        }
        out = lit_stmts(arm.body, asc, out);
      }
      return (s, out);
    },
    ast.StmtDefer(d) => {
      let (ds, dst) = lit_stmt(d.action, s, st);
      return (s, dst);
    },
    _ => {
      return (s, st);
    }
  }
  return (s, st);
}

function lit_enum_local(c: ast.ExprCall, s: Scope, st: LitInfer): (typeinfo.Type, LitInfer) {
  let none: typeinfo.Type = t_unknown("not a literal enum local");
  if (ctor_name_taken(c, s)) {
    return (none, st);
  }
  if let typeinfo.TypeUnion(u) = check_expr(c, s) {
    let qualified: boolean = false;
    if let ast.ExprFieldAccess(fa) = c.callee {
      if let ast.ExprIdent(owner) = fa.obj {
        if (owner.name != u.name || s.known(owner.name)) {
          return (none, st);
        }
        qualified = true;
      } else {
        return (none, st);
      }
    }
    let args: typeinfo.Type[] = u.args;
    let out: LitInfer = st;
    let p: i32 = 0;
    while (p < c.args.len()) {
      let slot: i32 = ctor_payload_slot(s, u.name, ctor_variant_name(c), p);
      if (qualified && u.name != "Option" && u.name != "Result") {
        slot = payload_type_param(s, s.lookup_union(u.name), ctor_variant_name(c), p);
      }
      let (seed, ids) = lit_tree(c.args[p], s, []);
      if (slot >= 0 && slot < args.len() && seed) {
        let k: i32 = out.parent.len();
        out = lit_link(lit_new(out, ""), ids.append(k));
        if let typeinfo.TypeI32(known) = u.args[slot] {
          if (!known.polymorphic) {
            out = lit_fix(out, [k], known);
          }
        }
        let prior: i32 = lit_id(args[slot]);
        if (prior >= 0) {
          out = lit_link(out, [prior, k]);
        }
        args = args.with(slot, lit_marker(k));
        out = LitInfer { ...out, eargs: out.eargs.append(gcall_arg_key(c, p)), eids: out.eids.append(k) };
      }
      p = p + 1;
    }
    if (out.eids.len() > st.eids.len()) {
      return (typeinfo.TypeUnion { ...u, args: args }, out);
    }
  }
  return (none, st);
}

function lit_struct_local(v: ast.StmtVar, sl: ast.ExprStructLit, s: Scope, st: LitInfer): (string, LitInfer) {
  let sig: StructSig = s.lookup_struct(sl.type_name);
  if (sig.type_params.len() == 0 || sl.has_base || util.index_of_sub(sl.type_name, "[") >= 0) {
    return ("", st);
  }
  let args: typeinfo.Type[] = struct_lit_args(sl, sig, s);
  let out: LitInfer = st;
  let ids: i32[] = [];
  let spelled: string[] = [];
  let any: boolean = false;
  let lit: ast.Expr[] = [sl];
  let ti: i32 = 0;
  while (ti < sig.type_params.len()) {
    let lits: boolean = false;
    let typed: boolean = false;
    let wide: boolean = false;
    for e in struct_param_exprs(sig, sig.type_params[ti], lit, s) {
      if (int_literal_tree(e)) {
        lits = true;
        wide = wide || wide_int_tree(e);
      } else {
        typed = true;
      }
    }
    if (lits && !typed) {
      let k: i32 = out.parent.len();
      out = lit_new(out, "");
      if (wide) {
        out = lit_fix(out, [k], t_i64());
      }
      ids = ids.append(k);
      any = true;
    } else {
      ids = ids.append(0 - 1);
    }
    let sp: string = "";
    if (ti < args.len() && !is_unknown(args[ti])) {
      sp = typeinfo.spelling(args[ti]);
    }
    spelled = spelled.append(sp);
    ti = ti + 1;
  }
  if (!any) {
    return ("", st);
  }
  let sargs: string[] = out.sargs;
  let sids: i32[] = out.sids;
  let j: i32 = 0;
  while (j < ids.len()) {
    sargs = sargs.append(spelled[j]);
    sids = sids.append(ids[j]);
    j = j + 1;
  }
  return (sl.type_name, LitInfer { ...out, skeys: out.skeys.append(lit_var_key(v)), snames: out.snames.append(sl.type_name), sfirst: out.sfirst.append(out.sids.len()), sargs: sargs, sids: sids });
}

function lit_struct_tags(st: LitInfer): (string[], string[]) {
  let keys: string[] = [];
  let tags: string[] = [];
  let j: i32 = 0;
  while (j < st.skeys.len()) {
    let end: i32 = st.sids.len();
    if (j + 1 < st.sfirst.len()) {
      end = st.sfirst[j + 1];
    }
    let parts: string = "";
    let moved: boolean = false;
    let known: boolean = true;
    let i: i32 = st.sfirst[j];
    while (i < end) {
      let a: string = st.sargs[i];
      if (st.sids[i] >= 0) {
        a = "i32";
        let w: typeinfo.Type = st.width[lit_find(st, st.sids[i])];
        if (!is_unknown(w)) {
          a = typeinfo.spelling(w);
        }
        moved = moved || a != "i32";
      }
      known = known && a.len() > 0;
      if (i > st.sfirst[j]) {
        parts = parts + ", ";
      }
      parts = parts + a;
      i = i + 1;
    }
    if (moved && known) {
      keys = keys.append(st.skeys[j]);
      tags = tags.append(st.snames[j] + "[" + parts + "]");
    }
    j = j + 1;
  }
  return (keys, tags);
}

function lit_rewrites(st: LitInfer): LitRewrite {
  let keys: string[] = [];
  let tags: string[] = [];
  let k: i32 = 0;
  while (k < st.keys.len()) {
    if (st.keys[k].len() == 0) {
      k = k + 1;
      continue;
    }
    let w: typeinfo.Type = st.width[lit_find(st, k)];
    let tag: string = "i32";
    if (!is_unknown(w)) {
      tag = typeinfo.spelling(w);
    }
    let at: i32 = util.index_of_str(keys, st.keys[k]);
    if (at < 0) {
      keys = keys.append(st.keys[k]);
      tags = tags.append(tag);
    } else if (tags[at] != tag) {
      tags = tags.with(at, "");
    }
    k = k + 1;
  }
  let ok: string[] = [];
  let ot: string[] = [];
  let i: i32 = 0;
  while (i < keys.len()) {
    if (tags[i].len() > 0 && (tags[i] != "i32" || !is_unknown(st.width[lit_find(st, util.index_of_str(st.keys, keys[i]))]))) {
      ok = ok.append(keys[i]);
      ot = ot.append(tags[i]);
    }
    i = i + 1;
  }
  let (sk, stg) = lit_struct_tags(st);
  let ti: i32 = 0;
  while (ti < st.tkeys.len()) {
    ok = ok.append(st.tkeys[ti]);
    ot = ot.append(typeinfo.spelling(lit_typed_type(st.ttypes[ti], st, false)));
    ti = ti + 1;
  }
  let si: i32 = 0;
  while (si < sk.len()) {
    ok = ok.append(sk[si]);
    ot = ot.append(stg[si]);
    si = si + 1;
  }
  let wi: i32 = 0;
  while (wi < st.wkeys.len()) {
    ok = ok.append(st.wkeys[wi]);
    ot = ot.append(st.wtags[wi]);
    wi = wi + 1;
  }
  let call_keys: string[] = st.cargs;
  let call_tags: string[] = st.ctags;
  let ei: i32 = 0;
  while (ei < st.eargs.len()) {
    let width: typeinfo.Type = st.width[lit_find(st, st.eids[ei])];
    if (!is_unknown(width)) {
      call_keys = call_keys.append(st.eargs[ei]);
      call_tags = call_tags.append(typeinfo.spelling(width));
    }
    ei = ei + 1;
  }
  let (ck, ct) = agreed_tags(call_keys, call_tags);
  return LitRewrite { keys: ok, tags: ot, cargs: ck, ctags: ct };
}

function agreed_tags(keys: string[], tags: string[]): (string[], string[]) {
  let ok: string[] = [];
  let ot: string[] = [];
  let i: i32 = 0;
  while (i < keys.len()) {
    let at: i32 = util.index_of_str(ok, keys[i]);
    if (at < 0) {
      ok = ok.append(keys[i]);
      ot = ot.append(tags[i]);
    } else if (ot[at] != tags[i]) {
      ot = ot.with(at, "");
    }
    i = i + 1;
  }
  let rk: string[] = [];
  let rt: string[] = [];
  let j: i32 = 0;
  while (j < ok.len()) {
    if (ot[j].len() > 0) {
      rk = rk.append(ok[j]);
      rt = rt.append(ot[j]);
    }
    j = j + 1;
  }
  return (rk, rt);
}

function lit_suffix_spelled(tag: string): boolean {
  return tag == "i64" || tag == "u64" || tag == "u32" || tag == "u8";
}

function lit_rewrite_stmt(st: ast.Stmt, rw: LitRewrite): (ast.Stmt, LitRewrite, boolean) {
  match (st) {
    ast.StmtVar(v) => {
      if (v.type_name.len() > 0) {
        return (st, rw, false);
      }
      let at: i32 = util.index_of_str(rw.keys, lit_var_key(v));
      if (at < 0) {
        return (st, rw, false);
      }
      let (ie, ia, ih) = astwalk.map_expr_acc(v.init, rw, lit_rewrite_stmt, lit_rewrite_expr);
      return (ast.StmtVar { ...v, type_name: rw.tags[at], init: ie }, rw, true);
    },
    ast.StmtFor(fr) => {
      if (!for_iter_is_range(fr.iter)) {
        return (st, rw, false);
      }
      let bounds: ast.Expr[] = lit_range_bounds(fr.iter);
      let at2: i32 = util.index_of_str(rw.keys, lit_for_key(fr, bounds[0]));
      if (at2 < 0 || !lit_suffix_spelled(rw.tags[at2])) {
        return (st, rw, false);
      }
      let tag: string = rw.tags[at2];
      let nb: ast.Expr[] = [];
      for bound in bounds {
        if (int_literal_tree(bound)) {
          nb = nb.append(settle_int_tree(bound, tag));
        } else {
          nb = nb.append(bound);
        }
      }
      let iter: ast.Expr = fr.iter;
      if let ast.ExprCall(c) = fr.iter {
        iter = ast.ExprCall { ...c, args: nb };
      }
      let (body, ba) = astwalk.map_stmts_acc(fr.body, rw, lit_rewrite_stmt, lit_rewrite_expr);
      return (ast.StmtFor { ...fr, iter: iter, body: body }, rw, true);
    },
    _ => {
      return (st, rw, false);
    }
  }
  return (st, rw, false);
}

function lit_rewrite_expr(e: ast.Expr, rw: LitRewrite): (ast.Expr, LitRewrite, boolean) {
  let at: i32 = util.index_of_str(rw.cargs, lit_float_key(e));
  if (at >= 0) {
    return (lit_float_read(e, parser.parse_type_ref(rw.ctags[at])), rw, true);
  }
  if let ast.ExprCall(c) = e {
    if (lit_call_settled(c, rw)) {
      return (lit_rewrite_call(c, rw), rw, true);
    }
  }
  return (e, rw, false);
}

function lit_float_read(e: ast.Expr, want: parser.TypeRef): ast.Expr {
  if (want.is_tuple) {
    let elems: ast.Expr[] = [];
    let i: i32 = 0;
    while (i < want.args.len()) {
      let part: ast.Expr = ast.ExprFieldAccess { obj: e, field: util.i32_to_string(i), line: expr_line(e), col: expr_col(e), ty: "", const_read: false };
      elems = elems.append(lit_float_read(part, want.args[i]));
      i = i + 1;
    }
    return ast.ExprTuple { elements: elems, line: expr_line(e), col: expr_col(e) };
  }
  if (want.base != "f32" && want.base != "f64") {
    return e;
  }
  if let ast.ExprNumber(n) = e {
    return ast.ExprNumber { ...n, is_float: true, suffix: want.base };
  }
  if let ast.ExprBinary(b) = e {
    return ast.ExprBinary { ...b, left: lit_float_read(b.left, want), right: lit_float_read(b.right, want), ty: want.base };
  }
  if let ast.ExprUnary(u) = e {
    if (u.op == "-" || u.op == "+") {
      return ast.ExprUnary { ...u, operand: lit_float_read(u.operand, want), ty: want.base };
    }
  }
  return ast.ExprUnary { op: "as_" + want.base, operand: e, line: expr_line(e), col: expr_col(e), ty: want.base };
}

function lit_call_settled(c: ast.ExprCall, rw: LitRewrite): boolean {
  let k: i32 = 0;
  while (k < c.args.len()) {
    if (util.index_of_str(rw.cargs, gcall_arg_key(c, k)) >= 0) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function lit_rewrite_call(c: ast.ExprCall, rw: LitRewrite): ast.Expr {
  let args: ast.Expr[] = [];
  let k: i32 = 0;
  while (k < c.args.len()) {
    let a: ast.Expr = c.args[k];
    let at: i32 = util.index_of_str(rw.cargs, gcall_arg_key(c, k));
    if (at >= 0) {
      a = settle_int_tree(a, rw.ctags[at]);
    }
    let (ae, aa, ah) = astwalk.map_expr_acc(a, rw, lit_rewrite_stmt, lit_rewrite_expr);
    args = args.append(ae);
    k = k + 1;
  }
  let (ce, ca, ch) = astwalk.map_expr_acc(c.callee, rw, lit_rewrite_stmt, lit_rewrite_expr);
  return ast.ExprCall { ...c, callee: ce, args: args };
}

struct LitScan { found: boolean, generics: string[] }

function lit_scan_stmt(st: ast.Stmt, own sc: LitScan): LitScan {
  if (sc.found || !lit_candidate_at(st)) {
    return sc;
  }
  return LitScan { ...sc, found: true };
}

function lit_scan_expr(e: ast.Expr, own sc: LitScan): LitScan {
  if (sc.found) {
    return sc;
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(cid) = c.callee {
      if (lit_any_int_literal(c.args) && util.has_str(sc.generics, cid.name)) {
        return LitScan { ...sc, found: true };
      }
    }
  }
  return sc;
}

function widened_array_tag(ea: ast.ExprArray, s: Scope): string {
  let at: typeinfo.Type = check_expr(ea, s);
  if let typeinfo.TypeArray(ta) = at {
    if let typeinfo.TypeStruct(ts) = ta.elem {
      if (!reads_i64(ta.elem)) {
        return "";
      }
      for e in ea.elements {
        if (struct_lit_gives_way(e, check_expr(e, s), ta.elem, s)) {
          return typeinfo.spelling(at);
        }
      }
    }
  }
  return "";
}

function lit_holds_int_literal(e: ast.Expr): boolean {
  if (int_literal_tree(e) || float_literal_tree(e)) {
    return true;
  }
  if let ast.ExprArray(ea) = e {
    return lit_holds_any(ea.elements);
  }
  if let ast.ExprTuple(et) = e {
    return lit_holds_any(et.elements);
  }
  if let ast.ExprStructLit(sl) = e {
    return lit_holds_any(sl.field_values);
  }
  if let ast.ExprCall(c) = e {
    return lit_holds_any(c.args);
  }
  return false;
}

function lit_holds_any(es: ast.Expr[]): boolean {
  for e in es {
    if (lit_holds_int_literal(e)) {
      return true;
    }
  }
  return false;
}

function lit_any_int_literal(args: ast.Expr[]): boolean {
  for a in args {
    if (int_literal_tree(a)) {
      return true;
    }
  }
  return false;
}

function generic_fn_names(funcs: parser.FuncDecl[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    if (fd.receiver_name.len() == 0 && (fd.type_params.len() > 0 || fd.all_type_params.len() > 0)) {
      out = out.append(fd.name);
    }
  }
  return out;
}

function lit_candidate_at(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtMatch(m) => {
      return lit_holds_int_literal(m.scrutinee);
    },
    ast.StmtVar(v) => {
      if (v.type_name.len() > 0 || name_has_comma(v.name)) {
        return false;
      }
      return lit_holds_int_literal(v.init);
    },
    ast.StmtFor(fr) => {
      if (!for_iter_is_range(fr.iter)) {
        return false;
      }
      let bounds: ast.Expr[] = lit_range_bounds(fr.iter);
      return int_literal_tree(bounds[0]) || int_literal_tree(bounds[1]);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function needs_lit_settle(stmts: ast.Stmt[], generics: string[]): boolean {
  let sc: LitScan = LitScan { found: false, generics: generics };
  for stmt in stmts {
    sc = astwalk.fold_stmt_nodes(stmt, sc, lit_scan_stmt, lit_scan_expr, astwalk.descend_all);
  }
  return sc.found;
}

function lit_resolve_pending(st: LitInfer): LitInfer {
  let out: LitInfer = st;
  let i: i32 = 0;
  while (i < st.pend.len()) {
    let w: typeinfo.Type = out.width[lit_find(out, st.pend_id[i])];
    if (!is_unknown(w)) {
      out = demand_open(st.pend[i], w, st.pend_scope[i], out);
    }
    i = i + 1;
  }
  return out;
}

function settle_lit_body(stmts: ast.Stmt[], s: Scope): ast.Stmt[] {
  let st: LitInfer = lit_resolve_pending(lit_stmts(stmts, s, LitInfer { parent: [LIT_WIDE], width: [t_i64()], keys: [""], cargs: [], ctags: [], pend: [], pend_id: [], pend_scope: [], skeys: [], snames: [], sfirst: [], sargs: [], sids: [], wkeys: [], wtags: [], eargs: [], eids: [], tkeys: [], ttypes: [] }));
  let rw: LitRewrite = lit_rewrites(st);
  if (rw.keys.len() == 0 && rw.cargs.len() == 0) {
    return stmts;
  }
  let (out, ra) = astwalk.map_stmts_acc(stmts, rw, lit_rewrite_stmt, lit_rewrite_expr);
  return out;
}

pub function settle_literal_locals(mod: parser.Module): parser.Module {
  let generics: string[] = generic_fn_names(mod.funcs);
  let any: boolean = needs_lit_settle(mod.top_stmts, generics);
  for fd in mod.funcs {
    if (!any && needs_lit_settle(fd.body, generics)) {
      any = true;
    }
  }
  if (!any) {
    return mod;
  }
  return settle_literal_locals_in(mod, module_env(mod), whole_focus(mod));
}

function settle_literal_locals_in(mod: parser.Module, env: ModuleEnv, focus: Focus): parser.Module {
  let generics: string[] = generic_fn_names(mod.funcs);
  let nfuncs: parser.FuncDecl[] = [];
  let k: i32 = 0;
  for func in mod.funcs {
    let hit: boolean = focus.funcs[k] && needs_lit_settle(func.body, generics);
    k = k + 1;
    if (hit) {
      let fs: Scope = build_func_scope(func, env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs);
      nfuncs = nfuncs.append(parser.FuncDecl { ...func, body: settle_lit_body(func.body, fs) });
    } else {
      nfuncs = nfuncs.append(func);
    }
  }
  let ntop: ast.Stmt[] = mod.top_stmts;
  if (focus.top && needs_lit_settle(mod.top_stmts, generics)) {
    ntop = settle_lit_body(mod.top_stmts, new_scope_full(env.sigs, env.structs, env.unions, env.methods, env.imports, env.impls, env.trait_reqs));
  }
  return parser.Module { ...mod, funcs: nfuncs, top_stmts: ntop };
}

function scalar_numeric_join(a: typeinfo.Type, b: typeinfo.Type): typeinfo.Type {
  if (typeinfo.lossless_widen(a, b)) {
    return b;
  }
  if (typeinfo.lossless_widen(b, a)) {
    return a;
  }
  return typeinfo.mixed_integer_join(a, b);
}

function unknown_arm_expr(e: ast.Expr): boolean {
  if let ast.ExprUnknown(_) = e {
    return true;
  }
  return false;
}

function lit_kind_settled(e: ast.Expr): boolean {
  return numeric_literal_kind(e) == 0;
}

function array_element_preferred(e: ast.Expr, t: typeinfo.Type, lit: i32, first_expr: ast.Expr, first: typeinfo.Type, first_lit: i32, s: Scope): boolean {
  return !vaguer_than(t, first) && !literal_gives_way(lit, first) && !struct_lit_gives_way(e, t, first, s)
    && (same_element_type(t, first) || literal_gives_way(first_lit, t))
    || struct_lit_gives_way(first_expr, first, t, s);
}

function binary_numeric_join(b: ast.ExprBinary, lt: typeinfo.Type, rt: typeinfo.Type): typeinfo.Type {
  if (is_integer(lt) && is_integer(rt) && (int_literal_tree(b.left) || int_literal_tree(b.right))) {
    return int_result(lt, rt, b.left, b.right);
  }
  return scalar_numeric_join(lt, rt);
}

function widen_binary_operand(e: ast.Expr, from: typeinfo.Type, to: typeinfo.Type, line: i32, col: i32): ast.Expr {
  if (!int_literal_tree(e) && !is_unknown(to) && typeinfo.lossless_widen(from, to)) {
    return ast.ExprUnary { op: "as_" + typeinfo.spelling(to), operand: e, line: line, col: col, ty: type_to_irtag(to) };
  }
  return e;
}

function scalar_vb_joinable(a: VbStore, b: VbStore, scalar: typeinfo.Type): boolean {
  return !is_unknown(scalar) && scalar_arms_settled(a, b) && (!unknown_arm_expr(a.e) || !unknown_arm_expr(b.e));
}

function scalar_value_widens(e: ast.Expr, want: typeinfo.Type, s: Scope): boolean {
  return (is_integer(want) || is_float(want)) && typeinfo.lossless_widen(check_expr(e, s), want);
}

function scalar_arms_settled(a: VbStore, b: VbStore): boolean {
  return !arm_unsettled(a) && !arm_unsettled(b);
}
