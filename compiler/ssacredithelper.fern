// Independent body proofs for the one-flat-child containment pilot. The caller
// supplies an audited layout, not a planner verdict. No production adapter yet.
import "./ssa";
import "./util";

// Exactly one reference slot, whose child has no owned payload or finalizer.
// Other slots are scalar; neither type has a user-defined finalizer. These are
// trusted boundary facts, not inferred here or from a successful plan verdict.
pub struct FlatChild { offset: i32 }

pub struct Proof { ok: boolean, function_name: string, message: string }

function refused(f: ssa.SFunc, why: string): Proof {
  return Proof { ok: false, function_name: f.name, message: why };
}

function unary(op: ssa.SInst, kind: i32, value: i32, name: string): boolean {
  return op.kind_tag == kind && op.args.len() == 1 && op.args[0] == value && op.str == name;
}

function zero(op: ssa.SInst): boolean {
  return op.kind_tag == 1 && op.args.len() == 0 && op.imm == 0 && op.str == "";
}

function parameter(op: ssa.SInst): boolean {
  return op.kind_tag == 6 && op.args.len() == 0 && op.imm == 0 && op.str == "";
}

function shape(f: ssa.SFunc): boolean {
  // Runtime symbols can be intrinsic calls or target-specific aliases rather
  // than calls to this supplied body. They cannot serve as user helper proofs.
  if (f.name == "" || util.str_has_prefix(f.name, "__fern_") || f.nparams != 1 || f.takes_env || f.nvals < 1) {
    return false;
  }
  let ids: i32[] = [];
  let values: i32[] = [];
  for b in f.blocks {
    if (b.id < 0 || util.index_of_i32(ids, b.id) >= 0) {
      return false;
    }
    ids = ids.append(b.id);
    for op in b.insts {
      if (op.result < 0 || op.result >= f.nvals || util.index_of_i32(values, op.result) >= 0) {
        return false;
      }
      values = values.append(op.result);
    }
  }
  return util.index_of_i32(ids, f.entry) >= 0;
}

function block_index(f: ssa.SFunc, id: i32): i32 {
  let i: i32 = 0;
  for b in f.blocks {
    if (b.id == id) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

function single_pred(b: ssa.SBlock, id: i32): boolean {
  return b.preds.len() == 1 && b.preds[0] == id;
}

// A proof of children-only dropping. In particular, this body does not consume
// the parent credit, and its summary requires an independently proved unique
// parent. Null cleared slots are valid inputs to the runtime flat release.
pub function drop_body(f: ssa.SFunc, layout: FlatChild): Proof {
  if (layout.offset < 8 || layout.offset % 8 != 0) {
    return refused(f, "unsupported child layout");
  }
  if (!shape(f) || f.blocks.len() != 1) {
    return refused(f, "unsupported drop graph");
  }
  let b = f.blocks[0];
  if (b.preds.len() != 0 || b.insts.len() != 5) {
    return refused(f, "unsupported drop effects");
  }
  let p = b.insts[0];
  let load = b.insts[2];
  let dec = b.insts[3];
  let result = b.insts[4];
  if (!parameter(p) || !zero(b.insts[1]) || !zero(result)) {
    return refused(f, "unsupported drop values");
  }
  if (!unary(load, 40, p.result, "") || load.imm != layout.offset) {
    return refused(f, "child slot mismatch");
  }
  if (!unary(dec, 11, load.result, "__fern_rc_dec") || dec.imm != 0) {
    return refused(f, "child release mismatch");
  }
  if (b.term.kind_tag != 1 || b.term.value != result.result) {
    return refused(f, "drop return mismatch");
  }
  return Proof { ok: true, function_name: f.name, message: "proved flat-child drop body" };
}

// Prove the named callee's body before using it. Merely naming a helper
// __sem_release_* or __sem_drop_* is not evidence of its ownership effects.
pub function release_body(f: ssa.SFunc, drop: ssa.SFunc, layout: FlatChild): Proof {
  let child = drop_body(drop, layout);
  if (!child.ok) {
    return child;
  }
  if (f.name == drop.name || !shape(f) || f.blocks.len() != 4) {
    return refused(f, "unsupported release graph");
  }
  let entry = f.blocks[block_index(f, f.entry)];
  if (entry.preds.len() != 0 || entry.insts.len() != 2 || entry.term.kind_tag != 3) {
    return refused(f, "unsupported uniqueness guard");
  }
  let p = entry.insts[0];
  let test = entry.insts[1];
  if (!parameter(p) || !unary(test, 11, p.result, "__fern_rc_is_unique") || test.imm != 4 || entry.term.cond != test.result) {
    return refused(f, "uniqueness subject mismatch");
  }
  let ti = block_index(f, entry.term.t);
  let fi = block_index(f, entry.term.f);
  if (ti < 0 || fi < 0 || ti == fi) {
    return refused(f, "invalid uniqueness edges");
  }
  let yes = f.blocks[ti];
  let no = f.blocks[fi];
  if (!single_pred(yes, entry.id) || !single_pred(no, entry.id) || yes.insts.len() != 1 || no.insts.len() != 0) {
    return refused(f, "conditional child drop mismatch");
  }
  if (!unary(yes.insts[0], 11, p.result, drop.name) || yes.insts[0].imm != 0) {
    return refused(f, "drop callee or subject mismatch");
  }
  if (yes.term.kind_tag != 2 || no.term.kind_tag != 2 || yes.term.target != no.term.target) {
    return refused(f, "release join mismatch");
  }
  let ji = block_index(f, yes.term.target);
  if (ji < 0 || ji == ti || ji == fi || f.blocks[ji].id == entry.id) {
    return refused(f, "invalid release join");
  }
  let join = f.blocks[ji];
  if (join.preds.len() != 2 || util.index_of_i32(join.preds, yes.id) < 0 || util.index_of_i32(join.preds, no.id) < 0 || join.insts.len() != 2) {
    return refused(f, "unsupported final release effects");
  }
  let dec = join.insts[0];
  let result = join.insts[1];
  if (!unary(dec, 11, p.result, "__fern_rc_dec") || dec.imm != 0 || !zero(result)) {
    return refused(f, "parent release mismatch");
  }
  if (join.term.kind_tag != 1 || join.term.value != result.result) {
    return refused(f, "release return mismatch");
  }
  return Proof { ok: true, function_name: f.name, message: "proved conditional parent release body" };
}
