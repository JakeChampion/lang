import "std/unicode";
import "std/string";
import "./literate";
import "./util";

struct UsedIn { refs: string[], users: string[] }

function used_in(d: literate.Doc): UsedIn {
  let u = UsedIn { refs: [], users: [] };
  for b in d.blocks {
    if (b.kind == literate.CHUNK) {
      let k = b.first;
      while (k < b.first + b.count) {
        let t = util.trim(d.lines[k]);
        if (literate.is_ref(t)) {
          u = UsedIn { refs: u.refs.append(literate.ref_name(t)), users: u.users.append(b.name) };
        }
        k += 1;
      }
    }
  }
  return u;
}

function users_of(u: UsedIn, name: string): string[] {
  let out: string[] = [];
  let i = 0;
  while (i < u.refs.len()) {
    if (u.refs[i] == name && !has(out, u.users[i])) {
      out = literate.insert_sorted(out, u.users[i]);
    }
    i += 1;
  }
  return out;
}

function has(xs: string[], s: string): boolean {
  for x in xs {
    if (x == s) {
      return true;
    }
  }
  return false;
}

function sorted(xs: string[]): string[] {
  let out: string[] = [];
  for x in xs {
    out = literate.insert_sorted(out, x);
  }
  return out;
}

function marker(continuation: boolean): string {
  if (continuation) {
    return "+≡";
  }
  return "≡";
}

function label(name: string): string {
  return "⟨" + name + "⟩";
}

function labels(names: string[]): string {
  let s = "";
  for n in names {
    if (s.len() > 0) {
      s += ", ";
    }
    s += label(n);
  }
  return s;
}

pub function weave(src: string): string {
  let d = literate.parse(src);
  let u = used_in(d);
  let seen: string[] = [];
  let out = "";
  let i = 0;
  while (i < d.blocks.len()) {
    let b = d.blocks[i];
    if (i > 0) {
      out += "\n";
    }
    if (b.kind == literate.CHUNK || b.kind == literate.FILE) {
      let continuation = has(seen, b.name);
      seen = seen.append(b.name);
      if (b.kind == literate.CHUNK) {
        out = out + "**" + label(b.name) + marker(continuation) + "**\n\n" + body_md(d, b) + note_md(b.name, users_of(u, b.name));
      } else {
        out = out + "**📄 `" + b.name + "`" + marker(continuation) + "**\n\n" + body_md(d, b);
      }
    } else {
      out = out + b.raw + "\n";
    }
    i += 1;
  }
  return out + index_md(src, d, u);
}

function body_md(d: literate.Doc, b: literate.Block): string {
  let s = "```fern\n";
  let k = b.first;
  while (k < b.first + b.count) {
    let text = d.lines[k];
    let t = util.trim(text);
    if (literate.is_ref(t)) {
      s = s + literate.leading_ws(text) + label(literate.ref_name(t)) + "\n";
    } else {
      s = s + literate.de_escape(text) + "\n";
    }
    k += 1;
  }
  return s + "```\n";
}

function note_md(name: string, users: string[]): string {
  if (users.len() == 0) {
    return "";
  }
  return "*" + label(name) + " is used in " + labels(users) + ".*\n\n";
}

function index_md(src: string, d: literate.Doc, u: UsedIn): string {
  let names = sorted(literate.defined_chunks(d));
  if (names.len() < 2) {
    return "";
  }
  let unused = literate.unused_chunks(src);
  let s = "\n## Chunk index\n\n";
  for n in names {
    let users = users_of(u, n);
    if (n == "*") {
      s = s + "- " + label(n) + " — *(root)*\n";
    } else if (has(unused, n)) {
      s = s + "- " + label(n) + " — *(unused)*\n";
    } else if (users.len() > 0) {
      s = s + "- " + label(n) + " — used in " + labels(users) + "\n";
    } else {
      s = s + "- " + label(n) + " — *(used by a file root)*\n";
    }
  }
  return s;
}

pub function weave_html(src: string): string {
  let d = literate.parse(src);
  let u = used_in(d);
  let seen: string[] = [];
  let body = "";
  for b in d.blocks {
    if (b.kind == literate.CHUNK) {
      let continuation = has(seen, b.name);
      seen = seen.append(b.name);
      body += chunk_html(d, b, continuation, users_of(u, b.name));
    } else if (b.kind == literate.FILE) {
      let continuation = has(seen, b.name);
      seen = seen.append(b.name);
      body = body + "<section class=\"chunk file\">\n<div class=\"chunk-label\"><span class=\"chunk-name\">📄 <code>" + html_escape(b.name)
        + "</code></span>" + marker(continuation) + "</div>\n" + body_html(d, b) + "</section>\n";
    } else if (b.kind == literate.PROSE) {
      body += markdown_to_html(b.raw);
    } else {
      body += "<pre class=\"code display\"><code>";
      for line in literate.split_lines(strip_fence(b.raw)) {
        body = body + highlight_fern(line) + "\n";
      }
      body += "</code></pre>\n";
    }
  }
  return "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
    + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    + "<title>" + html_escape(html_title(d)) + "</title>\n<style>\n" + weave_css() + "</style>\n"
    + "</head>\n<body>\n<main>\n" + toc_html(d) + body + index_html(src, d, u) + "</main>\n</body>\n</html>\n";
}

function chunk_html(d: literate.Doc, b: literate.Block, continuation: boolean, users: string[]): string {
  let id = "";
  if (!continuation) {
    id = " id=\"" + chunk_anchor(b.name) + "\"";
  }
  let s: string = "<section class=\"chunk\">\n<div class=\"chunk-label\"" + id + "><span class=\"chunk-name\">⟨" + html_escape(b.name) + "⟩</span>"
    + marker(continuation) + "</div>\n" + body_html(d, b);
  if (users.len() > 0) {
    s = s + "<p class=\"xref\">⟨" + html_escape(b.name) + "⟩ is used in " + ref_links(users) + ".</p>\n";
  }
  return s + "</section>\n";
}

function body_html(d: literate.Doc, b: literate.Block): string {
  let s = "<pre class=\"code\"><code>";
  let k = b.first;
  while (k < b.first + b.count) {
    let text = d.lines[k];
    let t = util.trim(text);
    if (literate.is_ref(t)) {
      s = s + html_escape(literate.leading_ws(text)) + ref_link(literate.ref_name(t)) + "\n";
    } else {
      s = s + highlight_fern(literate.de_escape(text)) + "\n";
    }
    k += 1;
  }
  return s + "</code></pre>\n";
}

function ref_link(name: string): string {
  return "<a class=\"ref\" href=\"#" + chunk_anchor(name) + "\">⟨" + html_escape(name) + "⟩</a>";
}

function ref_links(names: string[]): string {
  let s = "";
  for n in names {
    if (s.len() > 0) {
      s += ", ";
    }
    s += ref_link(n);
  }
  return s;
}

function chunk_anchor(name: string): string {
  let buf: u8[] = [];
  let i = 0;
  while (i < name.len()) {
    let c = name[i];
    if (is_alphanumeric(c)) {
      buf = buf.append(c);
    } else if (c < 128 || c >= 192) {
      buf = buf.append(b'-');
    }
    i += 1;
  }
  unsafe {
    return "chunk-" + string_from_bytes_unchecked(buf);
  }
}

function is_alphanumeric(c: u8): boolean {
  return c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c >= b'0' && c <= b'9';
}

function index_html(src: string, d: literate.Doc, u: UsedIn): string {
  let names = sorted(literate.defined_chunks(d));
  if (names.len() == 0) {
    return "";
  }
  let unused = literate.unused_chunks(src);
  let s = "<section class=\"chunk-index\">\n<h2 id=\"chunk-index\">Chunk index</h2>\n<ul>\n";
  for n in names {
    let users = users_of(u, n);
    s = s + "<li>" + ref_link(n);
    if (n == "*") {
      s += " <span class=\"idx-note\">(root)</span>";
    } else if (has(unused, n)) {
      s += " <span class=\"idx-note\">(unused)</span>";
    } else if (users.len() > 0) {
      s = s + " <span class=\"idx-note\">used in " + ref_links(users) + "</span>";
    } else {
      s += " <span class=\"idx-note\">(used by a file root)</span>";
    }
    s += "</li>\n";
  }
  return s + "</ul>\n</section>\n";
}

function html_title(d: literate.Doc): string {
  for b in d.blocks {
    if (b.kind == literate.PROSE) {
      for line in literate.split_lines(b.raw) {
        let h = util.trim(line);
        if (h.starts_with("# ")) {
          return util.trim(slice_unchecked(h, 2, h.len()) + "");
        }
      }
    }
  }
  return "Fern literate document";
}

function toc_html(d: literate.Doc): string {
  let levels: i32[] = [];
  let texts: string[] = [];
  for b in d.blocks {
    if (b.kind == literate.PROSE) {
      let in_fence = 0;
      for line in literate.split_lines(b.raw) {
        let t = util.trim(line);
        let fl = run_len(t, b'`');
        if (fl >= 3) {
          if (in_fence == 0) {
            in_fence = fl;
          } else if (fl >= in_fence && fl == t.len()) {
            in_fence = 0;
          }
        } else if (in_fence == 0 && heading_level(t) > 0) {
          let n = heading_level(t);
          levels = levels.append(n);
          texts = texts.append(util.trim(slice_unchecked(t, n + 1, t.len()) + ""));
        }
      }
    }
  }
  if (texts.len() < 2) {
    return "";
  }
  let s = "<nav class=\"toc\"><div class=\"toc-title\">Contents</div>\n<ul>\n";
  let i = 0;
  while (i < texts.len()) {
    s = s + "<li class=\"toc-l" + util.i32_to_string(levels[i]) + "\"><a href=\"#" + texts[i].slugify() + "\">" + inline_markdown(texts[i]) + "</a></li>\n";
    i += 1;
  }
  return s + "</ul>\n</nav>\n";
}

function strip_fence(raw: string): string {
  let lines = literate.split_lines(raw);
  if (lines.len() < 2 || !util.trim(lines[0]).starts_with("```")) {
    return raw;
  }
  let to = lines.len();
  if (util.trim(lines[to - 1]).starts_with("```")) {
    to -= 1;
  }
  let s = "";
  let i = 1;
  while (i < to) {
    if (i > 1) {
      s += "\n";
    }
    s += lines[i];
    i += 1;
  }
  return s;
}

pub function html_escape(s: string): string {
  let out = "";
  let from = 0;
  let i = 0;
  while (i < s.len()) {
    let rep = escape_of(s[i]);
    if (rep.len() > 0) {
      out = out + slice_unchecked(s, from, i) + rep;
      from = i + 1;
    }
    i += 1;
  }
  return out + slice_unchecked(s, from, s.len());
}

function escape_of(c: u8): string {
  if (c == b'&') {
    return "&amp;";
  }
  if (c == b'<') {
    return "&lt;";
  }
  if (c == b'>') {
    return "&gt;";
  }
  if (c == b'"') {
    return "&quot;";
  }
  if (c == 39) {
    return "&#39;";
  }
  return "";
}

struct Html { out: string, para: string[] }

function flush_para(h: Html): Html {
  if (h.para.len() == 0) {
    return h;
  }
  let joined = "";
  for p in h.para {
    if (joined.len() > 0) {
      joined += " ";
    }
    joined += p;
  }
  return Html { out: h.out + "<p>" + inline_markdown(joined) + "</p>\n", para: [] };
}

pub function markdown_to_html(prose: string): string {
  let lines = literate.split_lines(prose);
  let h = Html { out: "", para: [] };
  let i = 0;
  while (i < lines.len()) {
    let t = util.trim(lines[i]);
    if (t.len() == 0) {
      h = flush_para(h);
      i += 1;
    } else if (run_len(t, b'`') >= 3) {
      h = flush_para(h);
      let (code, next) = fenced_html(lines, i);
      h = Html { ...h, out: h.out + code };
      i = next;
    } else if (is_thematic_break(t)) {
      h = flush_para(h);
      h = Html { ...h, out: h.out + "<hr>\n" };
      i += 1;
    } else if (heading_level(t) > 0) {
      h = flush_para(h);
      let n = heading_level(t);
      let text = util.trim(slice_unchecked(t, n + 1, t.len()) + "");
      let tag = "h" + util.i32_to_string(n);
      h = Html { ...h, out: h.out + "<" + tag + " id=\"" + text.slugify() + "\">" + inline_markdown(text) + "</" + tag + ">\n" };
      i += 1;
    } else if (t.starts_with("> ")) {
      h = flush_para(h);
      let (quote, next) = quote_html(lines, i);
      h = Html { ...h, out: h.out + quote };
      i = next;
    } else if (is_unordered_item(t) || ordered_item(t).len() > 0) {
      h = flush_para(h);
      let (list, next) = list_html(lines, i, is_unordered_item(t));
      h = Html { ...h, out: h.out + list };
      i = next;
    } else {
      h = Html { ...h, para: h.para.append(t) };
      i += 1;
    }
  }
  return flush_para(h).out;
}

function fenced_html(lines: string[], i: i32): (string, i32) {
  let t = util.trim(lines[i]);
  let open = run_len(t, b'`');
  let lang = util.trim(slice_unchecked(t, open, t.len()) + "");
  let s = "<pre class=\"code display\"><code>";
  let k = i + 1;
  while (k < lines.len()) {
    let c = util.trim(lines[k]);
    if (run_len(c, b'`') >= open && run_len(c, b'`') == c.len()) {
      k += 1;
      break;
    }
    if (lang == "fern") {
      s = s + highlight_fern(lines[k]) + "\n";
    } else {
      s = s + html_escape(lines[k]) + "\n";
    }
    k += 1;
  }
  return (s + "</code></pre>\n", k);
}

function quote_html(lines: string[], i: i32): (string, i32) {
  let s = "";
  let k = i;
  while (k < lines.len()) {
    let q = util.trim(lines[k]);
    if (!q.starts_with(">")) {
      break;
    }
    if (k > i) {
      s += " ";
    }
    s += inline_markdown(util.trim(slice_unchecked(q, 1, q.len()) + ""));
    k += 1;
  }
  return ("<blockquote>" + s + "</blockquote>\n", k);
}

function list_html(lines: string[], i: i32, unordered: boolean): (string, i32) {
  let tag = "ol";
  if (unordered) {
    tag = "ul";
  }
  let s = "<" + tag + ">\n";
  let k = i;
  while (k < lines.len()) {
    let t = util.trim(lines[k]);
    let item = ordered_item(t);
    if (unordered) {
      if (!is_unordered_item(t)) {
        break;
      }
      item = util.trim(slice_unchecked(t, 1, t.len()) + "");
    } else if (item.len() == 0) {
      break;
    }
    s = s + "<li>" + inline_markdown(item) + "</li>\n";
    k += 1;
  }
  return (s + "</" + tag + ">\n", k);
}

function run_len(t: string, c: u8): i32 {
  let n = 0;
  while (n < t.len() && t[n] == c) {
    n += 1;
  }
  return n;
}

function heading_level(t: string): i32 {
  let n = run_len(t, b'#');
  if (n >= 1 && n <= 6 && n < t.len() && t[n] == b' ') {
    return n;
  }
  return 0;
}

function is_thematic_break(t: string): boolean {
  if (t.len() < 3) {
    return false;
  }
  let c = t[0];
  return (c == b'-' || c == b'*' || c == b'_') && run_len(t, c) == t.len();
}

function is_unordered_item(t: string): boolean {
  return t.len() >= 2 && (t[0] == b'-' || t[0] == b'*' || t[0] == b'+') && t[1] == b' ';
}

function ordered_item(t: string): string {
  let n = 0;
  while (n < t.len() && t[n] >= b'0' && t[n] <= b'9') {
    n += 1;
  }
  if (n == 0 || n + 1 >= t.len() || t[n] != b'.' || !is_space(t[n + 1])) {
    return "";
  }
  let k = n + 1;
  while (k < t.len() && is_space(t[k])) {
    k += 1;
  }
  return slice_unchecked(t, k, t.len()) + "";
}

function is_space(c: u8): boolean {
  return c == b' ' || c == b'\t' || c == b'\r' || c == 12;
}

pub function inline_markdown(s: string): string {
  let out = "";
  let i = 0;
  while (i < s.len()) {
    if (s[i] != b'`') {
      let j = i;
      while (j < s.len() && s[j] != b'`') {
        j += 1;
      }
      out += emphasis(slice_unchecked(s, i, j) + "");
      i = j;
    } else {
      let n = run_len(slice_unchecked(s, i, s.len()) + "", b'`');
      let close = find_closer(s, i + n, n);
      if (close >= 0) {
        out = out + "<code>" + html_escape(trim_code_span(slice_unchecked(s, i + n, close) + "")) + "</code>";
        i = close + n;
      } else {
        out += slice_unchecked(s, i, i + n);
        i += n;
      }
    }
  }
  return out;
}

function find_closer(s: string, from: i32, want: i32): i32 {
  let i = from;
  while (i < s.len()) {
    if (s[i] == b'`') {
      let run = run_len(slice_unchecked(s, i, s.len()) + "", b'`');
      if (run == want) {
        return i;
      }
      i += run;
    } else {
      i += 1;
    }
  }
  return -1;
}

function trim_code_span(c: string): string {
  if (c.len() >= 2 && c[0] == b' ' && c[c.len() - 1] == b' ' && util.trim(c).len() > 0) {
    return slice_unchecked(c, 1, c.len() - 1) + "";
  }
  return c;
}

function emphasis(seg: string): string {
  return delimited(delimited(links(html_escape(seg)), "**", "<strong>", "</strong>"), "*", "<em>", "</em>");
}

function delimited(s: string, d: string, open: string, close: string): string {
  let out = "";
  let i = 0;
  let dn = d.len();
  while (i < s.len()) {
    if (at(s, i, d)) {
      let j = i + dn;
      while (j < s.len() && s[j] != b'*') {
        j += 1;
      }
      if (j > i + dn && at(s, j, d)) {
        out = out + open + slice_unchecked(s, i + dn, j) + close;
        i = j + dn;
        continue;
      }
    }
    out += slice_unchecked(s, i, i + 1);
    i += 1;
  }
  return out;
}

function at(s: string, i: i32, d: string): boolean {
  return i + d.len() <= s.len() && slice_unchecked(s, i, i + d.len()) == d;
}

function links(s: string): string {
  let out = "";
  let i = 0;
  while (i < s.len()) {
    if (s[i] == b'[') {
      let tc = index_from(s, i + 1, b']');
      if (tc > i + 1 && tc + 1 < s.len() && s[tc + 1] == b'(') {
        let uc = index_from(s, tc + 2, b')');
        if (uc > tc + 2) {
          let text = slice_unchecked(s, i + 1, tc) + "";
          let url = slice_unchecked(s, tc + 2, uc) + "";
          if (safe_link_url(url)) {
            out = out + "<a href=\"" + url + "\">" + text + "</a>";
          } else {
            out += text;
          }
          i = uc + 1;
          continue;
        }
      }
    }
    out += slice_unchecked(s, i, i + 1);
    i += 1;
  }
  return out;
}

function index_from(s: string, from: i32, c: u8): i32 {
  let i = from;
  while (i < s.len()) {
    if (s[i] == c) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function safe_link_url(url: string): boolean {
  let i = 0;
  while (i < url.len()) {
    let c = url[i];
    if (c == b':') {
      let scheme = (slice_unchecked(url, 0, i) + "").to_lower();
      return scheme == "http" || scheme == "https" || scheme == "mailto";
    }
    if (!is_alphanumeric(c) && c != b'+' && c != b'-' && c != b'.') {
      return true;
    }
    i += 1;
  }
  return true;
}

function is_keyword(w: string): boolean {
  return has(["function", "fn", "let", "const", "return", "if", "else", "while", "for", "in", "match", "struct", "enum", "type", "pub", "import", "as", "own", "fip", "fbip", "async", "defer", "errdefer", "break", "continue", "true", "false"], w);
}

function is_type_name(w: string): boolean {
  return has(["i32", "i64", "f32", "f64", "f32x4", "f64x2", "u8", "u32", "u64", "usize", "char", "bool", "boolean", "string", "void", "Option", "Result", "Cell"], w);
}

function is_word(c: u8): boolean {
  return c == b'_' || is_alphanumeric(c);
}

function span(cls: string, text: string): string {
  return "<span class=\"" + cls + "\">" + text + "</span>";
}

pub function highlight_fern(line: string): string {
  let out = "";
  let i = 0;
  while (i < line.len()) {
    let j = token_end(line, i);
    out += token_html(slice_unchecked(line, i, j) + "");
    i = j;
  }
  return out;
}

function token_end(line: string, i: i32): i32 {
  let n = line.len();
  let c = line[i];
  let j = i + 1;
  if (c == b'/' && j < n && line[j] == b'/') {
    return n;
  }
  if (c == b'"') {
    return string_end(line, j);
  }
  let number = c >= b'0' && c <= b'9';
  if (number || is_word(c)) {
    while (j < n && (is_word(line[j]) || number && line[j] == b'.')) {
      j += 1;
    }
  }
  return j;
}

function string_end(line: string, j: i32): i32 {
  let k = j;
  while (k < line.len() && line[k] != b'"') {
    if (line[k] == b'\\' && k + 1 < line.len()) {
      k += 1;
    }
    k += 1;
  }
  if (k < line.len()) {
    return k + 1;
  }
  return k;
}

function token_html(t: string): string {
  let c = t[0];
  if (t.len() > 1 && c == b'/' && t[1] == b'/') {
    return span("c", html_escape(t));
  }
  if (c == b'"') {
    return span("s", html_escape(t));
  }
  if (c >= b'0' && c <= b'9') {
    return span("n", html_escape(t));
  }
  if (is_keyword(t)) {
    return span("k", t);
  }
  if (is_type_name(t)) {
    return span("t", t);
  }
  return html_escape(t);
}

function weave_css(): string {
  return ":root{--fg:#24292f;--muted:#57606a;--bg:#fff;--code-bg:#f6f8fa;--border:#d0d7de;--accent:#0969da;--kw:#cf222e;--type:#953800;--str:#0a3069;--com:#6e7781;--num:#0550ae}\n"
    + "*{box-sizing:border-box}\n"
    + "body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.6 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Helvetica,Arial,sans-serif}\n"
    + "main{max-width:52rem;margin:0 auto;padding:2.5rem 1.25rem 6rem}\n"
    + "h1,h2,h3,h4,h5,h6{line-height:1.25;margin:1.6em 0 .6em;font-weight:600}\n"
    + "h1{font-size:1.9rem;border-bottom:1px solid var(--border);padding-bottom:.3em}\n"
    + "h2{font-size:1.5rem;border-bottom:1px solid var(--border);padding-bottom:.3em}\n"
    + "p{margin:.8em 0}\n"
    + "a{color:var(--accent);text-decoration:none}\n"
    + "a:hover{text-decoration:underline}\n"
    + "blockquote{margin:.8em 0;padding:0 1em;color:var(--muted);border-left:.25em solid var(--border)}\n"
    + "hr{border:0;border-top:1px solid var(--border);margin:1.6em 0}\n"
    + "ul,ol{margin:.8em 0;padding-left:1.6em}\n"
    + "code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.9em;background:var(--code-bg);padding:.15em .35em;border-radius:6px}\n"
    + "pre.code{background:var(--code-bg);border:1px solid var(--border);border-radius:8px;padding:.85rem 1rem;overflow:auto;margin:0}\n"
    + "pre.code code{background:none;padding:0;font-size:.86rem;line-height:1.55}\n"
    + "section.chunk{margin:1.6em 0}\n"
    + ".chunk-label{font-weight:600;color:var(--muted);margin-bottom:.4em;scroll-margin-top:1rem}\n"
    + ".chunk-name{color:var(--fg)}\n"
    + "section.file .chunk-name code{background:none;padding:0;color:var(--fg)}\n"
    + ".xref{font-size:.85rem;color:var(--muted);margin:.4em 0 0;font-style:italic}\n"
    + "a.ref{font-weight:600}\n"
    + ".code .k{color:var(--kw)}\n"
    + ".code .t{color:var(--type)}\n"
    + ".code .s{color:var(--str)}\n"
    + ".code .c{color:var(--com);font-style:italic}\n"
    + ".code .n{color:var(--num)}\n"
    + "nav.toc{background:var(--code-bg);border:1px solid var(--border);border-radius:8px;padding:.8rem 1rem;margin:0 0 2rem}\n"
    + "nav.toc .toc-title{font-weight:600;font-size:.85rem;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin-bottom:.4em}\n"
    + "nav.toc ul{list-style:none;margin:0;padding:0}\n"
    + "nav.toc li{margin:.15em 0}\n"
    + "nav.toc .toc-l2{padding-left:1rem}\n"
    + "nav.toc .toc-l3{padding-left:2rem}\n"
    + "nav.toc .toc-l4,nav.toc .toc-l5,nav.toc .toc-l6{padding-left:3rem}\n"
    + "section.chunk-index{margin-top:3rem;border-top:1px solid var(--border);padding-top:1rem}\n"
    + "section.chunk-index ul{list-style:none;margin:0;padding:0}\n"
    + "section.chunk-index li{margin:.25em 0;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.9rem}\n"
    + ".idx-note{color:var(--muted);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:.82rem}\n";
}
