// compiler/coverreport.fern — `fern -cover-report FILE` (`-` for stdin), the
// read half of `-cover`: fold a saved run's `fern-cover:` / `fern-branch:`
// rows into per-file line and branch totals, or into an lcov tracefile.
//
// A -cover binary writes a row for every instrumented line whether it ran or
// not, so the rows present are the denominator: a missing row means the line
// was never instrumented, not that it went unexecuted. Rows for one line sum,
// so several runs' output can be concatenated into one report. Lines without
// a prefix are the program's own stderr and are skipped; a prefixed row that
// does not parse is an error, because dropping it would move a percentage.

import "./util";

const LINE_PREFIX: string = "fern-cover: ";

const BRANCH_PREFIX: string = "fern-branch: ";

// File is one source file's folded counts. `lines` / `hits` are parallel and
// `bline` / `bcol` / `beval` / `btaken` hold one conditional each, keyed by
// (line, col) so two conditionals on one line stay apart; both are sorted
// before reporting.
struct File {
  name: string,
  lines: i32[],
  hits: i64[],
  bline: i32[],
  bcol: i32[],
  beval: i64[],
  btaken: i64[],
}

struct Folded {
  files: File[],
  err: string,
}

function last_index(s: string, b: u8): i32 {
  let i: i32 = s.len() - 1;
  while (i >= 0) {
    if (s[i] == b) {
      return i;
    }
    i = i - 1;
  }
  return 0 - 1;
}

function sub(s: string, lo: i32, hi: i32): string {
  return slice_unchecked(s, lo, hi) + "";
}

// parse_count reads a non-negative decimal, or -1 when `s` is not one.
function parse_count(s: string): i64 {
  if (s.len() == 0 || s.len() > 19) {
    return 0 as i64 - 1;
  }
  let n: i64 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    let c: u8 = s[i];
    if (c < b'0' || c > b'9') {
      return 0 as i64 - 1;
    }
    n = n * 10 + (c - b'0') as i64;
    i = i + 1;
  }
  return n;
}

function bad(lineno: i32, text: string, why: string): Folded {
  let none: File[] = [];
  return Folded { files: none, err: "line " + util.i32_to_string(lineno) + ": \"" + text + "\": " + why };
}

function file_index(files: File[], names: Map[string, i32], name: string): i32 {
  match (names.get(name)) {
    Some(i) => {
      return i;
    },
    None => {
      return 0 - 1;
    }
  }
}

function new_file(name: string): File {
  let ni: i32[] = [];
  let nl: i64[] = [];
  return File { name: name, lines: ni, hits: nl, bline: ni, bcol: ni, beval: nl, btaken: nl };
}

// fold reads the stream and folds every prefixed row.
function fold(text: string): Folded {
  let files: File[] = [];
  let names: Map[string, i32] = map_new(16);
  // (file index, line) and (file index, line, col) to the row's slot.
  let line_slot: Map[string, i32] = map_new(256);
  let branch_slot: Map[string, i32] = map_new(64);
  let lineno: i32 = 0;
  let start: i32 = 0;
  let i: i32 = 0;
  while (i <= text.len()) {
    if (i < text.len() && text[i] != b'\n') {
      i = i + 1;
      continue;
    }
    lineno = lineno + 1;
    let row: string = sub(text, start, i);
    start = i + 1;
    i = i + 1;
    let is_branch: boolean = util.str_has_prefix(row, BRANCH_PREFIX);
    if (!is_branch && !util.str_has_prefix(row, LINE_PREFIX)) {
      continue;
    }
    let rest: string = "";
    if (is_branch) {
      rest = sub(row, BRANCH_PREFIX.len(), row.len());
    } else {
      rest = sub(row, LINE_PREFIX.len(), row.len());
    }
    let sp: i32 = last_index(rest, b' ');
    if (sp < 0) {
      return bad(lineno, row, "no count");
    }
    let count: i64 = parse_count(sub(rest, sp + 1, rest.len()));
    if (count < 0) {
      return bad(lineno, row, "bad count");
    }
    let site: string = sub(rest, 0, sp);
    let edge: string = "";
    let col: i32 = 0;
    if (is_branch) {
      let esp: i32 = last_index(site, b' ');
      if (esp < 0) {
        return bad(lineno, row, "no edge");
      }
      edge = sub(site, esp + 1, site.len());
      site = sub(site, 0, esp);
      if (edge != "E" && edge != "T") {
        return bad(lineno, row, "edge is \"" + edge + "\", want E or T");
      }
      let cs: i32 = last_index(site, b':');
      if (cs < 0 || parse_count(sub(site, cs + 1, site.len())) < 0) {
        return bad(lineno, row, "site is not <file>:<line>:<col>");
      }
      col = util.digits_to_i32(sub(site, cs + 1, site.len()));
      site = sub(site, 0, cs);
    }
    let ls: i32 = last_index(site, b':');
    if (ls < 0 || parse_count(sub(site, ls + 1, site.len())) < 0) {
      if (is_branch) {
        return bad(lineno, row, "site is not <file>:<line>:<col>");
      }
      return bad(lineno, row, "site is not <file>:<line>");
    }
    let src_line: i32 = util.digits_to_i32(sub(site, ls + 1, site.len()));
    let name: string = sub(site, 0, ls);
    let fi: i32 = file_index(files, names, name);
    if (fi < 0) {
      fi = files.len();
      files = files.append(new_file(name));
      names = names.insert(name, fi);
    }
    let f: File = files[fi];
    if (is_branch) {
      let key: string = util.i32_to_string(fi) + ":" + util.i32_to_string(src_line) + ":" + util.i32_to_string(col);
      let slot: i32 = 0 - 1;
      match (branch_slot.get(key)) {
        Some(s) => {
          slot = s;
        },
        None => {
          slot = f.bline.len();
          branch_slot = branch_slot.insert(key, slot);
          f = File { ...f, bline: f.bline.append(src_line), bcol: f.bcol.append(col), beval: f.beval.append(0 as i64), btaken: f.btaken.append(0 as i64) };
        }
      }
      if (edge == "E") {
        f = File { ...f, beval: f.beval.with(slot, f.beval[slot] + count) };
      } else {
        f = File { ...f, btaken: f.btaken.with(slot, f.btaken[slot] + count) };
      }
    } else {
      let key: string = util.i32_to_string(fi) + ":" + util.i32_to_string(src_line);
      match (line_slot.get(key)) {
        Some(s) => {
          f = File { ...f, hits: f.hits.with(s, f.hits[s] + count) };
        },
        None => {
          line_slot = line_slot.insert(key, f.lines.len());
          f = File { ...f, lines: f.lines.append(src_line), hits: f.hits.append(count) };
        }
      }
    }
    files = files.with(fi, f);
  }
  return Folded { files: sort_files(files), err: "" };
}

// sort_file orders a file's lines ascending and its conditionals by (line,
// col). Insertion sort: a coverage stream arrives nearly in order.
function sort_file(f: File): File {
  let lines: i32[] = f.lines;
  let hits: i64[] = f.hits;
  let i: i32 = 1;
  while (i < lines.len()) {
    let l: i32 = lines[i];
    let h: i64 = hits[i];
    let j: i32 = i - 1;
    while (j >= 0 && lines[j] > l) {
      lines = lines.with(j + 1, lines[j]);
      hits = hits.with(j + 1, hits[j]);
      j = j - 1;
    }
    lines = lines.with(j + 1, l);
    hits = hits.with(j + 1, h);
    i = i + 1;
  }
  let bl: i32[] = f.bline;
  let bc: i32[] = f.bcol;
  let be: i64[] = f.beval;
  let bt: i64[] = f.btaken;
  i = 1;
  while (i < bl.len()) {
    let l: i32 = bl[i];
    let c: i32 = bc[i];
    let e: i64 = be[i];
    let t: i64 = bt[i];
    let j: i32 = i - 1;
    while (j >= 0 && (bl[j] > l || bl[j] == l && bc[j] > c)) {
      bl = bl.with(j + 1, bl[j]);
      bc = bc.with(j + 1, bc[j]);
      be = be.with(j + 1, be[j]);
      bt = bt.with(j + 1, bt[j]);
      j = j - 1;
    }
    bl = bl.with(j + 1, l);
    bc = bc.with(j + 1, c);
    be = be.with(j + 1, e);
    bt = bt.with(j + 1, t);
    i = i + 1;
  }
  return File { ...f, lines: lines, hits: hits, bline: bl, bcol: bc, beval: be, btaken: bt };
}

function sort_files(files: File[]): File[] {
  let out: File[] = [];
  for f in files {
    let g: File = sort_file(f);
    let at: i32 = out.len();
    while (at > 0 && util.str_less(g.name, out[at - 1].name)) {
      at = at - 1;
    }
    let next: File[] = [];
    let k: i32 = 0;
    while (k < out.len()) {
      if (k == at) {
        next = next.append(g);
      }
      next = next.append(out[k]);
      k = k + 1;
    }
    if (at == out.len()) {
      next = next.append(g);
    }
    out = next;
  }
  return out;
}

// false_count is how often conditional `k` took its false edge: evaluations
// less true-arm entries, clamped at zero for a stream truncated oddly.
function false_count(f: File, k: i32): i64 {
  if (f.btaken[k] > f.beval[k]) {
    return 0 as i64;
  }
  return f.beval[k] - f.btaken[k];
}

function covered_lines(f: File): i32 {
  let n: i32 = 0;
  for h in f.hits {
    if (h > 0) {
      n = n + 1;
    }
  }
  return n;
}

// covered_edges counts the edges that ran; every conditional has two.
function covered_edges(f: File): i32 {
  let n: i32 = 0;
  let k: i32 = 0;
  while (k < f.bline.len()) {
    if (f.btaken[k] > 0) {
      n = n + 1;
    }
    if (false_count(f, k) > 0) {
      n = n + 1;
    }
    k = k + 1;
  }
  return n;
}

// pct renders n/total as a percentage to one decimal, rounding half to even,
// or "n/a" for an empty denominator: 0.0% for a program with nothing
// instrumented would read as a result rather than the absence of one.
function pct(n: i32, total: i32): string {
  if (total == 0) {
    return "n/a";
  }
  let num: i64 = n as i64 * 1000;
  let den: i64 = total as i64;
  let tenths: i64 = num / den;
  let rem: i64 = num - tenths * den;
  if (rem * 2 > den || rem * 2 == den && tenths % 2 == 1) {
    tenths = tenths + 1;
  }
  return util.i64_to_string(tenths / 10) + "." + util.i64_to_string(tenths % 10) + "%";
}

// counts is the "N/M lines (P), N/M branches (P)" figure; a file with no
// conditionals has no branch half rather than a 0/0 one.
function counts(lh: i32, la: i32, eh: i32, ea: i32): string {
  let out: string = util.i32_to_string(lh) + "/" + util.i32_to_string(la) + " lines (" + pct(lh, la) + ")";
  if (ea > 0) {
    out = out + ", " + util.i32_to_string(eh) + "/" + util.i32_to_string(ea) + " branches (" + pct(eh, ea) + ")";
  }
  return out;
}

// line_ranges collapses an ascending list into runs: [3 4 5 9] -> "3-5, 9".
function line_ranges(ls: i32[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < ls.len()) {
    let j: i32 = i;
    while (j + 1 < ls.len() && ls[j + 1] == ls[j] + 1) {
      j = j + 1;
    }
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + util.i32_to_string(ls[i]);
    if (j > i) {
      out = out + "-" + util.i32_to_string(ls[j]);
    }
    i = j + 1;
  }
  return out;
}

function summary(files: File[]): string {
  let out: string = "";
  let tl: i32 = 0;
  let tc: i32 = 0;
  let te: i32 = 0;
  let th: i32 = 0;
  for f in files {
    let cov: i32 = covered_lines(f);
    let eh: i32 = covered_edges(f);
    let ea: i32 = 2 * f.bline.len();
    tc = tc + cov;
    tl = tl + f.lines.len();
    th = th + eh;
    te = te + ea;
    out = out + f.name + ": " + counts(cov, f.lines.len(), eh, ea) + "\n";
    let missing: i32[] = [];
    let k: i32 = 0;
    while (k < f.lines.len()) {
      if (f.hits[k] == 0) {
        missing = missing.append(f.lines[k]);
      }
      k = k + 1;
    }
    if (missing.len() > 0) {
      out = out + "  uncovered lines: " + line_ranges(missing) + "\n";
    }
    let edges: string = "";
    k = 0;
    while (k < f.bline.len()) {
      let at: string = util.i32_to_string(f.bline[k]) + ":" + util.i32_to_string(f.bcol[k]);
      if (f.btaken[k] == 0) {
        if (edges.len() > 0) {
          edges = edges + ", ";
        }
        edges = edges + at + " true";
      }
      if (false_count(f, k) == 0) {
        if (edges.len() > 0) {
          edges = edges + ", ";
        }
        edges = edges + at + " false";
      }
      k = k + 1;
    }
    if (edges.len() > 0) {
      out = out + "  uncovered branches: " + edges + "\n";
    }
  }
  return out + "total: " + counts(tc, tl, th, te) + "\n";
}

// lcov writes one SF/DA/BRDA/LF/LH/BRF/BRH record set per file. Each
// conditional is two BRDA rows sharing its index within the file as the block
// id, branch 0 the false edge and 1 the true one; a conditional never
// evaluated writes `-` for both, lcov's spelling of "never reached".
function lcov(files: File[]): string {
  let out: string = "";
  for f in files {
    out = out + "SF:" + f.name + "\n";
    let k: i32 = 0;
    while (k < f.lines.len()) {
      out = out + "DA:" + util.i32_to_string(f.lines[k]) + "," + util.i64_to_string(f.hits[k]) + "\n";
      k = k + 1;
    }
    k = 0;
    while (k < f.bline.len()) {
      let vals: i64[] = [false_count(f, k), f.btaken[k]];
      let br: i32 = 0;
      while (br < 2) {
        let v: string = util.i64_to_string(vals[br]);
        if (f.beval[k] == 0) {
          v = "-";
        }
        out = out + "BRDA:" + util.i32_to_string(f.bline[k]) + "," + util.i32_to_string(k) + "," + util.i32_to_string(br) + "," + v + "\n";
        br = br + 1;
      }
      k = k + 1;
    }
    out = out + "LF:" + util.i32_to_string(f.lines.len()) + "\nLH:" + util.i32_to_string(covered_lines(f)) + "\n";
    if (f.bline.len() > 0) {
      out = out + "BRF:" + util.i32_to_string(2 * f.bline.len()) + "\nBRH:" + util.i32_to_string(covered_edges(f)) + "\n";
    }
    out = out + "end_of_record\n";
  }
  return out;
}

// report folds `text`, a saved -cover run's output, into the summary or, with
// `as_lcov`, the tracefile. The error is set, and the output empty, when a
// prefixed row does not parse.
pub function report(text: string, as_lcov: boolean): (string, string) {
  let fd: Folded = fold(text);
  if (fd.err.len() > 0) {
    return ("", fd.err);
  }
  if (as_lcov) {
    return (lcov(fd.files), "");
  }
  return (summary(fd.files), "");
}
