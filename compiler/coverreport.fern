import "./util";
import "std/string";

const LINE_PREFIX: string = "fern-cover: ";

const BRANCH_PREFIX: string = "fern-branch: ";

pub struct File {
  name: string,
  lines: i32[],
  hits: i64[],
  bline: i32[],
  bcol: i32[],
  beval: i64[],
  btaken: i64[],
}

pub struct Folded {
  files: File[],
  err: string,
}

function last_index(s: string, b: u8): i32 {
  let i = s.len() - 1;
  while (i >= 0) {
    if (s[i] == b) {
      return i;
    }
    i -= 1;
  }
  return -1;
}

function sub(s: string, lo: i32, hi: i32): string {
  return slice_unchecked(s, lo, hi).to_owned();
}

function parse_count(s: string): i64 {
  if (s.len() == 0 || s.len() > 19) {
    return 0 as i64 - 1;
  }
  let n: i64 = 0;
  let i = 0;
  while (i < s.len()) {
    let c = s[i];
    if (c < b'0' || c > b'9') {
      return 0 as i64 - 1;
    }
    n = n * 10 + (c - b'0') as i64;
    i += 1;
  }
  return n;
}

function bad(lineno: i32, text: string, why: string): Folded {
  let none: File[] = [];
  return Folded { files: none, err: "line " + util.i32_to_string(lineno) + ": \"" + text + "\": " + why };
}

function new_file(name: string): File {
  let ni: i32[] = [];
  let nl: i64[] = [];
  return File { name: name, lines: ni, hits: nl, bline: ni, bcol: ni, beval: nl, btaken: nl };
}

pub function fold(text: string): Folded {
  let files: File[] = [];
  let none: string[] = [];
  let names = util.name_index(none);
  let line_keys = util.name_index(none);
  let line_slots: i32[] = [];
  let branch_keys = util.name_index(none);
  let branch_slots: i32[] = [];
  let lineno = 0;
  let start = 0;
  let i = 0;
  while (i <= text.len()) {
    if (i < text.len() && text[i] != b'\n') {
      i += 1;
      continue;
    }
    lineno += 1;
    let row = sub(text, start, i);
    start = i + 1;
    i += 1;
    let is_branch = row.starts_with(BRANCH_PREFIX);
    if (!is_branch && !row.starts_with(LINE_PREFIX)) {
      continue;
    }
    let rest = "";
    if (is_branch) {
      rest = sub(row, BRANCH_PREFIX.len(), row.len());
    } else {
      rest = sub(row, LINE_PREFIX.len(), row.len());
    }
    let sp = last_index(rest, b' ');
    if (sp < 0) {
      return bad(lineno, row, "no count");
    }
    let count = parse_count(sub(rest, sp + 1, rest.len()));
    if (count < 0) {
      return bad(lineno, row, "bad count");
    }
    let site = sub(rest, 0, sp);
    let edge = "";
    let col = 0;
    if (is_branch) {
      let esp = last_index(site, b' ');
      if (esp < 0) {
        return bad(lineno, row, "no edge");
      }
      edge = sub(site, esp + 1, site.len());
      site = sub(site, 0, esp);
      if (edge != "E" && edge != "T") {
        return bad(lineno, row, "edge is \"" + edge + "\", want E or T");
      }
      let cs = last_index(site, b':');
      if (cs < 0 || parse_count(sub(site, cs + 1, site.len())) < 0) {
        return bad(lineno, row, "site is not <file>:<line>:<col>");
      }
      col = util.digits_to_i32(sub(site, cs + 1, site.len()));
      site = sub(site, 0, cs);
    }
    let ls = last_index(site, b':');
    if (ls < 0 || parse_count(sub(site, ls + 1, site.len())) < 0) {
      if (is_branch) {
        return bad(lineno, row, "site is not <file>:<line>:<col>");
      }
      return bad(lineno, row, "site is not <file>:<line>");
    }
    let src_line = util.digits_to_i32(sub(site, ls + 1, site.len()));
    let name = sub(site, 0, ls);
    let fi = names.find(name);
    if (fi < 0) {
      fi = files.len();
      files = files.append(new_file(name));
      names = names.added(name);
    }
    let f = files[fi];
    if (is_branch) {
      let key = util.i32_to_string(fi) + ":" + util.i32_to_string(src_line) + ":" + util.i32_to_string(col);
      let slot: i32 = -1;
      let at = branch_keys.find(key);
      if (at >= 0) {
        slot = branch_slots[at];
      } else {
        slot = f.bline.len();
        branch_keys = branch_keys.added(key);
        branch_slots = branch_slots.append(slot);
        f = File { ...f, bline: f.bline.append(src_line), bcol: f.bcol.append(col), beval: f.beval.append(0 as i64), btaken: f.btaken.append(0 as i64) };
      }
      if (edge == "E") {
        f = File { ...f, beval: f.beval.with(slot, f.beval[slot] + count) };
      } else {
        f = File { ...f, btaken: f.btaken.with(slot, f.btaken[slot] + count) };
      }
    } else {
      let key = util.i32_to_string(fi) + ":" + util.i32_to_string(src_line);
      let at = line_keys.find(key);
      if (at >= 0) {
        let s = line_slots[at];
        f = File { ...f, hits: f.hits.with(s, f.hits[s] + count) };
      } else {
        line_keys = line_keys.added(key);
        line_slots = line_slots.append(f.lines.len());
        f = File { ...f, lines: f.lines.append(src_line), hits: f.hits.append(count) };
      }
    }
    files = files.with(fi, f);
  }
  return Folded { files: sort_files(files), err: "" };
}

function sort_file(f: File): File {
  let lines = f.lines;
  let hits = f.hits;
  let i = 1;
  while (i < lines.len()) {
    let l = lines[i];
    let h = hits[i];
    let j = i - 1;
    while (j >= 0 && lines[j] > l) {
      lines = lines.with(j + 1, lines[j]);
      hits = hits.with(j + 1, hits[j]);
      j -= 1;
    }
    lines = lines.with(j + 1, l);
    hits = hits.with(j + 1, h);
    i += 1;
  }
  let bl = f.bline;
  let bc = f.bcol;
  let be = f.beval;
  let bt = f.btaken;
  i = 1;
  while (i < bl.len()) {
    let l = bl[i];
    let c = bc[i];
    let e = be[i];
    let t = bt[i];
    let j = i - 1;
    while (j >= 0 && (bl[j] > l || bl[j] == l && bc[j] > c)) {
      bl = bl.with(j + 1, bl[j]);
      bc = bc.with(j + 1, bc[j]);
      be = be.with(j + 1, be[j]);
      bt = bt.with(j + 1, bt[j]);
      j -= 1;
    }
    bl = bl.with(j + 1, l);
    bc = bc.with(j + 1, c);
    be = be.with(j + 1, e);
    bt = bt.with(j + 1, t);
    i += 1;
  }
  return File { ...f, lines: lines, hits: hits, bline: bl, bcol: bc, beval: be, btaken: bt };
}

function sort_files(files: File[]): File[] {
  let out: File[] = [];
  for f in files {
    let g = sort_file(f);
    let at = out.len();
    while (at > 0 && util.str_less(g.name, out[at - 1].name)) {
      at -= 1;
    }
    let next: File[] = [];
    let k = 0;
    while (k < out.len()) {
      if (k == at) {
        next = next.append(g);
      }
      next = next.append(out[k]);
      k += 1;
    }
    if (at == out.len()) {
      next = next.append(g);
    }
    out = next;
  }
  return out;
}

function false_count(f: File, k: i32): i64 {
  if (f.btaken[k] > f.beval[k]) {
    return 0 as i64;
  }
  return f.beval[k] - f.btaken[k];
}

function covered_lines(f: File): i32 {
  let n = 0;
  for h in f.hits {
    if (h > 0) {
      n += 1;
    }
  }
  return n;
}

function covered_edges(f: File): i32 {
  let n = 0;
  let k = 0;
  while (k < f.bline.len()) {
    if (f.btaken[k] > 0) {
      n += 1;
    }
    if (false_count(f, k) > 0) {
      n += 1;
    }
    k += 1;
  }
  return n;
}

pub function pct(n: i32, total: i32): string {
  if (total == 0) {
    return "n/a";
  }
  let num = n as i64 * 1000;
  let den = total as i64;
  let tenths = num / den;
  let rem = num - tenths * den;
  if (rem * 2 > den || rem * 2 == den && tenths % 2 == 1) {
    tenths += 1;
  }
  return util.i64_to_string(tenths / 10) + "." + util.i64_to_string(tenths % 10) + "%";
}

function counts(lh: i32, la: i32, eh: i32, ea: i32): string {
  let out = util.i32_to_string(lh) + "/" + util.i32_to_string(la) + " lines (" + pct(lh, la) + ")";
  if (ea > 0) {
    out = out + ", " + util.i32_to_string(eh) + "/" + util.i32_to_string(ea) + " branches (" + pct(eh, ea) + ")";
  }
  return out;
}

function line_ranges(ls: i32[]): string {
  let out = "";
  let i = 0;
  while (i < ls.len()) {
    let j = i;
    while (j + 1 < ls.len() && ls[j + 1] == ls[j] + 1) {
      j += 1;
    }
    if (out.len() > 0) {
      out += ", ";
    }
    out += util.i32_to_string(ls[i]);
    if (j > i) {
      out = out + "-" + util.i32_to_string(ls[j]);
    }
    i = j + 1;
  }
  return out;
}

function summary(files: File[]): string {
  let out = "";
  let tl = 0;
  let tc = 0;
  let te = 0;
  let th = 0;
  for f in files {
    let cov = covered_lines(f);
    let eh = covered_edges(f);
    let ea = 2 * f.bline.len();
    tc += cov;
    tl += f.lines.len();
    th += eh;
    te += ea;
    out = out + f.name + ": " + counts(cov, f.lines.len(), eh, ea) + "\n";
    let missing: i32[] = [];
    let k = 0;
    while (k < f.lines.len()) {
      if (f.hits[k] == 0) {
        missing = missing.append(f.lines[k]);
      }
      k += 1;
    }
    if (missing.len() > 0) {
      out = out + "  uncovered lines: " + line_ranges(missing) + "\n";
    }
    let edges = "";
    k = 0;
    while (k < f.bline.len()) {
      let at = util.i32_to_string(f.bline[k]) + ":" + util.i32_to_string(f.bcol[k]);
      if (f.btaken[k] == 0) {
        if (edges.len() > 0) {
          edges += ", ";
        }
        edges = edges + at + " true";
      }
      if (false_count(f, k) == 0) {
        if (edges.len() > 0) {
          edges += ", ";
        }
        edges = edges + at + " false";
      }
      k += 1;
    }
    if (edges.len() > 0) {
      out = out + "  uncovered branches: " + edges + "\n";
    }
  }
  return out + "total: " + counts(tc, tl, th, te) + "\n";
}

function lcov(files: File[]): string {
  let out = "";
  for f in files {
    out = out + "SF:" + f.name + "\n";
    let k = 0;
    while (k < f.lines.len()) {
      out = out + "DA:" + util.i32_to_string(f.lines[k]) + "," + util.i64_to_string(f.hits[k]) + "\n";
      k += 1;
    }
    k = 0;
    while (k < f.bline.len()) {
      let vals: i64[] = [false_count(f, k), f.btaken[k]];
      let br = 0;
      while (br < 2) {
        let v = util.i64_to_string(vals[br]);
        if (f.beval[k] == 0) {
          v = "-";
        }
        out = out + "BRDA:" + util.i32_to_string(f.bline[k]) + "," + util.i32_to_string(k) + "," + util.i32_to_string(br) + "," + v + "\n";
        br += 1;
      }
      k += 1;
    }
    out = out + "LF:" + util.i32_to_string(f.lines.len()) + "\nLH:" + util.i32_to_string(covered_lines(f)) + "\n";
    if (f.bline.len() > 0) {
      out = out + "BRF:" + util.i32_to_string(2 * f.bline.len()) + "\nBRH:" + util.i32_to_string(covered_edges(f)) + "\n";
    }
    out += "end_of_record\n";
  }
  return out;
}

pub function report(text: string, as_lcov: boolean): (string, string) {
  let fd = fold(text);
  if (fd.err.len() > 0) {
    return ("", fd.err);
  }
  if (as_lcov) {
    return (lcov(fd.files), "");
  }
  return (summary(fd.files), "");
}
