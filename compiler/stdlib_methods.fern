    }
    i = i + 1;
  }
  return "";
}

pub function receiver_of(receiver: string, method: string): string {
  if (receiver == "Option") {
    if (method == "flatten") {
      return "Option[Option[T]]";
    }
    if (method == "transpose") {
      return "Option[Result[T, E]]";
    }
    if (method == "unzip") {
      return "Option[(T, U)]";
    }
  }
  if (receiver == "Result") {
    if (method == "flatten") {
      return "Result[Result[T, E], E]";
    }
    if (method == "transpose") {
      return "Result[Option[T], E]";
    }
  }
  return "";
}

pub function methods_on(receiver: string): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < METHODS.len()) {
    if (RECEIVERS[i] == receiver) {
      out = out.append(METHODS[i]);
    }
    i = i + 1;
  }
  return out;
}
