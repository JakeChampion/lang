  if (receiver == "Option" && method == "transpose") {
    return ["T", "E"];
  }
  if (receiver == "Option" && method == "unzip") {
    return ["T", "U"];
  }
  if (receiver == "Result" && method == "flatten") {
    return ["T", "E"];
  }
  if (receiver == "Result" && method == "transpose") {
    return ["T", "E"];
  }
  return [];
}

pub function module_of(receiver: string, method: string): string {
