enum IoError {
  NotFound(string),
  PermissionDenied(string),
  AlreadyExists(string),
  InvalidUtf8(string),
  Interrupted,
  Unsupported,
  Other(string, string, i32),
}

struct ChunkProducer { next: (i32) => Option[u8[]], idle_ms: i32, filler: u8[], trailers: () => HeaderMap }

enum Body {
  BodyText(string),
  BodyBytes(u8[]),
  BodyStream(Stream),
  BodyFile(string),
  BodyChunks(ChunkProducer),
  BodyFileRanges(string, i64[], u8[][]),
}

struct FileStat { is_file: boolean, is_dir: boolean, size: i64, mode: u32, nlink: u32, uid: u32, gid: u32, dev: i64, rdev: i64, ino: i64, blksize: i64, blocks: i64, atime: i64, atime_nsec: i64, mtime: i64, mtime_nsec: i64, ctime: i64, ctime_nsec: i64, btime: i64, btime_nsec: i64 }

struct DirEntry { name: string, ino: i64, kind: u32 }

struct ProcessResult { stdout: string, stderr: string, exit_code: i32 }

struct HeaderMap { names: string[], values: string[] }

struct BodySource { next: () => Option[u8[]], fault: Cell[i32], send: (u8[]) => i32 }

struct Stream { data: u8[], pos: i32, source: Option[BodySource] }

struct HttpRequest { method: string, path: string, body: Stream, headers: HeaderMap, trailers: HeaderMap }

struct HttpResponse { status: i32, body: Body, headers: HeaderMap, trailers: HeaderMap, background: Option[() => void] }
