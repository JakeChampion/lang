// Scoped continuation proof over actual retained native rows. This does not
// certify runtime implementations, startup, WASI or an entire compilation.
import "./ssaprepare";
import "./ssacreditbound" as bound;
import "./ssacreditselected" as selected;
import "./ssacreditabi" as abi;
import "./ssacredithelper" as helper;
import "./ssacreditscalar" as scalar;
import "./ssacreditcontinuation" as continuation;
import "./ssasem";
import "./semrecords";
import "./ssa";
import "./util";

struct Functions { bodies: ssa.SFunc[], error: string }

function refused(name: string, error: string): helper.Proof {
  return helper.Proof { ok: false, function_name: name, message: error };
}

function resolve(rows: ssaprepare.Emitted[], name: string, architecture: string, parameters: i32): bound.Binding {
  let result = bound.resolve(rows, name, architecture);
  if (result.error != "") {
    return result;
  }
  if (result.rows[0].body.formed.f.nparams != parameters) {
    return bound.Binding { rows: [], error: "mismatched retained ABI arity" };
  }
  return result;
}

function producer(rows: ssaprepare.Emitted[], name: string, architecture: string, consumer: ssaprepare.Emitted, d: ssasem.Contract): Functions {
  let binding = resolve(rows, name, architecture, 2);
  if (binding.error != "") {
    return Functions { bodies: [], error: name + ": " + binding.error };
  }
  let row = binding.rows[0];
  let cs = selected.contracts(row);
  if (cs.len() != 1 || !selected.producer(selected.metadata(row), cs[0], selected.metadata(consumer), d)) {
    return Functions { bodies: [], error: name + ": incompatible retained producer metadata" };
  }
  let proof = abi.check_emitted_producer(rows, name, architecture);
  if (!proof.proof.ok || proof.words != 3) {
    return Functions { bodies: [], error: name + ": retained producer refused: " + proof.proof.message };
  }
  return Functions { bodies: [row.body.formed.f], error: "" };
}

function producers(rows: ssaprepare.Emitted[], wrapper: ssaprepare.Emitted, consumer: ssaprepare.Emitted, d: ssasem.Contract, architecture: string): Functions {
  let names: string[] = [];
  let functions: ssa.SFunc[] = [];
  for b in wrapper.body.formed.f.blocks {
    for op in b.insts {
      if (op.kind_tag == 11 && op.str != consumer.label_name && !util.has_str(names, op.str)) {
        names = names.append(op.str);
        let p = producer(rows, op.str, architecture, consumer, d);
        if (p.error != "") {
          return p;
        }
        functions = util.append_all(functions, p.bodies);
      }
    }
  }
  return Functions { bodies: functions, error: "" };
}

function helpers(rows: ssaprepare.Emitted[], names: string[], architecture: string, consumer: ssaprepare.Emitted, d: ssasem.Contract): Functions {
  let functions: ssa.SFunc[] = [];
  for name in names {
    let binding = resolve(rows, name, architecture, 1);
    if (binding.error != "") {
      return Functions { bodies: [], error: name + ": " + binding.error };
    }
    let row = binding.rows[0];
    // Generated helpers have no source declaration contract. Their own
    // selected schema must agree, and continuation checks their real effects.
    if (!selected.compatible(selected.metadata(row), selected.metadata(consumer), d.params[0], 1)) {
      return Functions { bodies: [], error: name + ": incompatible retained helper schema" };
    }
    functions = functions.append(row.body.formed.f);
  }
  return Functions { bodies: functions, error: "" };
}

function assertions(rows: ssaprepare.Emitted[], names: string[], architecture: string): Functions {
  let functions: ssa.SFunc[] = [];
  for name in names {
    let binding = resolve(rows, name, architecture, 2);
    if (binding.error != "") {
      return Functions { bodies: [], error: name + ": " + binding.error };
    }
    let row = binding.rows[0];
    let cs = selected.contracts(row);
    if (cs.len() != 1 || !selected.assertion(cs[0])) {
      return Functions { bodies: [], error: name + ": incompatible retained assertion ABI" };
    }
    let proof = scalar.zero_or_exit(row.body.formed.f);
    if (!proof.ok) {
      return Functions { bodies: [], error: name + ": " + proof.message };
    }
    functions = functions.append(row.body.formed.f);
  }
  return Functions { bodies: functions, error: "" };
}

function continuation_proof(rows: ssaprepare.Emitted[], w: ssaprepare.Emitted, c: ssaprepare.Emitted, d: ssasem.Contract, drop: string, release: string, calls: string[], architecture: string): helper.Proof {
  let ps = producers(rows, w, c, d, architecture);
  if (ps.error != "") {
    return refused(w.label_name, ps.error);
  }
  let hs = helpers(rows, [drop, release], architecture, c, d);
  if (hs.error != "") {
    return refused(c.label_name, hs.error);
  }
  let effects = assertions(rows, calls, architecture);
  if (effects.error != "") {
    return refused(c.label_name, effects.error);
  }
  return continuation.check(w.body.formed.f, ps.bodies, c.body.formed.f, hs.bodies[0], hs.bodies[1], semrecords.name_of(d.params[0]), semrecords.name_of(d.result), selected.fields(selected.metadata(c), d), effects.bodies);
}

pub function check_wrapper(rows: ssaprepare.Emitted[], name: string, consumer: string, drop: string, release: string, calls: string[], architecture: string): helper.Proof {
  let wrapper = resolve(rows, name, architecture, 4);
  let callee = resolve(rows, consumer, architecture, 2);
  if (wrapper.error != "") {
    return refused(name, wrapper.error);
  }
  if (callee.error != "") {
    return refused(consumer, callee.error);
  }
  let w = wrapper.rows[0];
  let c = callee.rows[0];
  let ws = selected.contracts(w);
  let cs = selected.contracts(c);
  if (name == consumer || ws.len() != 1 || cs.len() != 1) {
    return refused(name, "missing or ambiguous retained wrapper ABI");
  }
  if (!selected.wrapper(selected.metadata(w), ws[0])) {
    return refused(name, "unsupported retained wrapper metadata");
  }
  if (!selected.consumer(selected.metadata(w), ws[0], selected.metadata(c), cs[0])) {
    return refused(consumer, "incompatible retained consumer metadata");
  }
  return continuation_proof(rows, w, c, cs[0], drop, release, calls, architecture);
}
