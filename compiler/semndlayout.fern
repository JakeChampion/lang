// Ndarray layout facts on typed SSA, before reference-count lowering.
// Unknown is an ordinary conservative answer. Unseen is analysis bottom:
// it must never be consumed by a rewrite as evidence about a runtime value.
import "./ssa";
import "./ssasem";
import "./typeinfo";
import "./util";

pub struct Facts { values: i32[][], params: i32[][], returns: i32[] }

pub function unknown(): i32 {
  return 0;
}

pub function strided(): i32 {
  return 1;
}

pub function row_major(): i32 {
  return 2;
}

pub function packed(): i32 {
  return 3;
}

function unseen(): i32 {
  return 4;
}

function meet(a: i32, b: i32): i32 {
  if (a < b) {
    return a;
  }
  return b;
}

function handle(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(s) = t {
    return util.str_has_prefix(s.name, "ndarray__NdArray__");
  }
  return false;
}

function seed(types: typeinfo.Type[], open: boolean): i32[] {
  let out: i32[] = [];
  for t in types {
    let fact: i32 = unknown();
    if (!open && handle(t)) {
      fact = unseen();
    }
    out = out.append(fact);
  }
  return out;
}

// A generic struct method is a folded free generic, or a receiver-qualified
// method. These names are candidates, not proof of stdlib identity. Match
// the delimiter too, so names such as map_rank cannot be mistaken for map.
pub function operation(name: string): string {
  let prefix: string = "__smm_ndarray__NdArray_";
  if (util.str_has_prefix(name, prefix)) {
    let end: i32 = prefix.len();
    while (end < name.len() && name[end] != b'$' && !(name[end] == b'_' && end + 1 < name.len() && name[end + 1] == b'_')) {
      end = end + 1;
    }
    return slice_unchecked(name, prefix.len(), end) + "";
  }
  if (util.str_has_prefix(name, "ndarray__NdArray__")) {
    let k: i32 = 0;
    while (k < name.len()) {
      if (name[k] == b'.') {
        return slice_unchecked(name, k + 1, name.len()) + "";
      }
      k = k + 1;
    }
  }
  return "";
}

function library_layout(ins: ssa.SInst, values: i32[]): i32 {
  if (util.str_has_prefix(ins.str, "ndarray__from_flat__") || util.str_has_prefix(ins.str, "ndarray__from_flat$")) {
    return packed();
  }
  let v: string = operation(ins.str);
  if (packed_result(v)) {
    return packed();
  }
  if (strided_result(v)) {
    return strided();
  }
  if (v == "reshape" && ins.args.len() > 0) {
    let recv: i32 = values[ins.args[0]];
    if (recv == unseen() || recv == packed()) {
      return recv;
    }
    return row_major();
  }
  return 0 - 1;
}

function called_layout(ins: ssa.SInst, values: i32[], returns: i32[], index: util.NameIndex, trusted: util.NameIndex): i32 {
  if (trusted.has(ins.str)) {
    let fact: i32 = library_layout(ins, values);
    if (fact >= 0) {
      return fact;
    }
  }
  let at: i32 = index.find(ins.str);
  if (at >= 0) {
    return returns[at];
  }
  return unknown();
}

function packed_result(v: string): boolean {
  return v == "packed" || v == "map" || v == "zip_with" || v == "outer" || v == "inner" || v == "reduce_axis" || v == "scan_axis" || v == "map_rank";
}

function strided_result(v: string): boolean {
  return v == "transpose" || v == "permute" || v == "reverse" || v == "slice" || v == "select" || v == "broadcast_to";
}

function transfer(ins: ssa.SInst, values: i32[], params: i32[], returns: i32[], index: util.NameIndex, trusted: util.NameIndex): i32 {
  if (ins.kind_tag == ssasem.param()) {
    return params[ins.imm];
  }
  if ((ins.kind_tag == 7 || ins.kind_tag == 8) && ins.args.len() > 0) {
    let result: i32 = unseen();
    for a in ins.args {
      result = meet(result, values[a]);
    }
    return result;
  }
  if (ins.kind_tag == ssasem.call()) {
    return called_layout(ins, values, returns, index, trusted);
  }
  // Fields, mutable cells, opaque calls and hand-written record literals
  // cannot inherit a layout merely from their result's nominal type.
  return unknown();
}

// open marks entry points the module's direct calls cannot account for:
// exported functions, methods, closure bodies and refused bodies.
// Every other parameter is the meet of ALL direct callers, independent of
// their order in the module. Recursive edges participate in the same fixed
// point, so a cycle neither forces unknown nor supplies a packed assumption.
pub function analyze(funcs: ssasem.Func[], names: string[], usable: boolean[], open: boolean[], trusted: util.NameIndex): Facts {
  let index: util.NameIndex = util.name_index(names);
  let values: i32[][] = [];
  let params: i32[][] = [];
  let returns: i32[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    values = values.append(seed(funcs[i].values, !usable[i]));
    params = params.append(seed(funcs[i].params, !usable[i] || open[i]));
    let result: i32 = unknown();
    if (usable[i] && handle(funcs[i].result)) {
      result = unseen();
    }
    returns = returns.append(result);
    i = i + 1;
  }
  let facts: Facts = settle(funcs, usable, index, trusted, Facts { values: values, params: params, returns: returns });
  // A closed cycle with no incoming value has learned nothing. Turn every
  // remaining bottom into unknown, then propagate that through consumers.
  values = [];
  params = [];
  returns = finish(facts.returns);
  for row in facts.values {
    values = values.append(finish(row));
  }
  for row in facts.params {
    params = params.append(finish(row));
  }
  return settle(funcs, usable, index, trusted, Facts { values: values, params: params, returns: returns });
}

function finish(row: i32[]): i32[] {
  let out: i32[] = [];
  for v in row {
    if (v == unseen()) {
      out = out.append(unknown());
    } else {
      out = out.append(v);
    }
  }
  return out;
}

// Each cell only descends through five states, so convergence is bounded by
// the number of values/parameters/returns, without an arbitrary round limit.
struct Step { facts: Facts, changed: boolean }

function feed_call(ins: ssa.SInst, values: i32[], usable: boolean[], index: util.NameIndex, facts: Facts): Step {
  let at: i32 = index.find(ins.str);
  if (at < 0 || !usable[at] || ins.args.len() != facts.params[at].len()) {
    return Step { facts: facts, changed: false };
  }
  let row: i32[] = facts.params[at];
  let changed: boolean = false;
  let j: i32 = 0;
  while (j < row.len()) {
    let next: i32 = meet(row[j], values[ins.args[j]]);
    if (next != row[j]) {
      row = row.with(j, next);
      changed = true;
    }
    j = j + 1;
  }
  return Step { facts: Facts { ...facts, params: facts.params.with(at, row) }, changed: changed };
}

function step(f: ssasem.Func, i: i32, usable: boolean[], index: util.NameIndex, trusted: util.NameIndex, initial: Facts): Step {
  let facts: Facts = initial;
  let values: i32[] = facts.values[i];
  let result: i32 = facts.returns[i];
  let changed: boolean = false;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (handle(f.values[ins.result])) {
        let next: i32 = meet(values[ins.result], transfer(ins, values, facts.params[i], facts.returns, index, trusted));
        if (next != values[ins.result]) {
          values = values.with(ins.result, next);
          changed = true;
        }
      }
      if (ins.kind_tag == ssasem.call()) {
        let fed: Step = feed_call(ins, values, usable, index, facts);
        facts = fed.facts;
        changed = changed || fed.changed;
      }
    }
    if (handle(f.result) && b.term.kind_tag == 1) {
      result = meet(result, values[b.term.value]);
    }
  }
  return Step { facts: Facts { ...facts, values: facts.values.with(i, values), returns: facts.returns.with(i, result) }, changed: changed || result != facts.returns[i] };
}

function settle(funcs: ssasem.Func[], usable: boolean[], index: util.NameIndex, trusted: util.NameIndex, initial: Facts): Facts {
  let facts: Facts = initial;
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let i: i32 = 0;
    while (i < funcs.len()) {
      if (!usable[i]) {
        i = i + 1;
        continue;
      }
      let next: Step = step(funcs[i], i, usable, index, trusted, facts);
      changed = changed || next.changed;
      facts = next.facts;
      i = i + 1;
    }
  }
  return facts;
}
