import "./ssa";
import "./ssasem";
import "./util";

pub struct Hoisted { f: ssasem.Func, moved: i32 }

pub function hoist(f: ssasem.Func): Hoisted {
  let g = f.graph;
  let moved = 0;
  let blocks: ssa.SBlock[] = [];
  for b in g.blocks {
    let (insts, n) = hoist_block(b.insts, f);
    blocks = blocks.append(ssa.SBlock { ...b, insts: insts });
    moved += n;
  }
  if (moved == 0) {
    return Hoisted { f: f, moved: 0 };
  }
  return Hoisted { f: ssasem.Func { ...f, graph: ssa.SFunc { ...g, blocks: blocks } }, moved: moved };
}

function hoist_block(insts: ssa.SInst[], f: ssasem.Func): (ssa.SInst[], i32) {
  let moved = 0;
  let p = 0;
  while (p < insts.len()) {
    let lifted: i32[] = [];
    for v in consumed(insts[p]) {
      if (lifted.len() == 0) {
        lifted = first_read(insts, p, v, f);
      }
    }
    if (lifted.len() > 0) {
      insts = move_before(insts, p, lifted);
      moved += 1;
      p += lifted.len();
    } else {
      p += 1;
    }
  }
  return (insts, moved);
}

// The values that `ins` can consume: the receiver of a write, or each
// argument of a call.
function consumed(ins: ssa.SInst): i32[] {
  if ((ins.kind_tag == ssasem.with() || ins.kind_tag == ssasem.append() || ins.kind_tag == ssasem.truncate()) && ins.args.len() > 0) {
    return [ins.args[0]];
  }
  if (ins.kind_tag == ssasem.call()) {
    return ins.args;
  }
  return [];
}

function first_read(insts: ssa.SInst[], p: i32, v: i32, f: ssasem.Func): i32[] {
  let call = insts[p].kind_tag == ssasem.call();
  let q = p + 1;
  while (q < insts.len() && passable(insts[q])) {
    if (reads(insts[q], v, call, f)) {
      return feeders(insts, p, q);
    }
    q += 1;
  }
  return [];
}

// Above a call, only a read that cannot trap and holds no count moves: the
// call can have effects, and a counted result would hold `v` across it.
function reads(ins: ssa.SInst, v: i32, call: boolean, f: ssasem.Func): boolean {
  if (ins.args.len() == 0 || ins.args[0] != v) {
    return false;
  }
  let k = ins.kind_tag;
  if (call) {
    return (k == ssasem.record_get() || k == ssasem.length()) && !ssasem.counted(f, f.values[ins.result]);
  }
  return k == ssasem.array_get() || k == ssasem.length();
}

function passable(ins: ssa.SInst): boolean {
  let k = ins.kind_tag;
  return ssasem.reorderable(ins) || k == ssasem.array_get() || k == ssasem.with() || k == ssasem.append();
}

function feeders(insts: ssa.SInst[], p: i32, q: i32): i32[] {
  let keep: boolean[] = [];
  let i = 0;
  while (i < insts.len()) {
    keep = keep.append(i == q);
    i += 1;
  }
  let at = q;
  while (at > p) {
    if (keep[at]) {
      for a in insts[at].args {
        let d = defined_at(insts, p, at, a);
        if (d == p || d > p && !ssasem.reorderable(insts[d])) {
          return [];
        }
        if (d > p) {
          keep = keep.with(d, true);
        }
      }
    }
    at -= 1;
  }
  let out: i32[] = [];
  for i in p + 1..=q {
    if (keep[i]) {
      out = out.append(i);
    }
  }
  return out;
}

function defined_at(insts: ssa.SInst[], p: i32, before: i32, v: i32): i32 {
  for i in p..before {
    if (insts[i].result == v) {
      return i;
    }
  }
  return -1;
}

function move_before(insts: ssa.SInst[], p: i32, lifted: i32[]): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  let i = 0;
  while (i < p) {
    out = out.append(insts[i]);
    i += 1;
  }
  for at in lifted {
    out = out.append(insts[at]);
  }
  while (i < insts.len()) {
    if (util.index_of_i32(lifted, i) < 0) {
      out = out.append(insts[i]);
    }
    i += 1;
  }
  return out;
}
