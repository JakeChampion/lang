// The raw builtins that reach "privileged" when a function of a package
// calls one. A call site in the standard library does not count for the
// caller.
pub function direct_privileged(): string[] {
  return [
    "__alloc", "__alloc_reuse", "__alloc_u8_uninit", "__arr_set_len",
    "__bytes_data", "__c_call0", "__c_call0_f32", "__c_call0_f64",
    "__c_call1", "__c_call1_f32", "__c_call1_f64", "__c_call2",
    "__c_call2_f32", "__c_call2_f64", "__c_call3", "__c_call3_f32",
    "__c_call3_f64", "__c_call4", "__c_call4_f32", "__c_call4_f64",
    "__c_call5", "__c_call5_f32", "__c_call5_f64", "__c_call6",
    "__c_call6_f32", "__c_call6_f64", "__c_callv", "__f32x4_load_ptr",
    "__f32x4_store", "__f64x2_load_f32_ptr", "__f64x2_load_ptr", "__f64x2_store",
    "__fern_arr_dec", "__fern_box_free", "__fern_drop_arr_ptr", "__fern_rc_dec",
    "__fern_rc_inc", "__fern_str_dec", "__free", "__heap_adopt",
    "__heap_mark", "__heap_release_to", "__load_i32", "__load_i64",
    "__load_ptr", "__load_u8", "__memcpy", "__memset",
    "__rc_dec", "__rc_get", "__rc_inc", "__store_i32",
    "__store_i64", "__store_ptr", "__store_u8", "__str_bytes",
    "__syscall3", "__syscall4", "__syscall5", "__syscall6",
    "__task_cancelled", "__task_cur", "__task_enter", "__task_fd_gen", "__task_free", "__task_inline",
    "__task_leave", "__task_new", "__task_park", "__task_park_until",
    "__task_set_cancelled", "__task_set_ready", "__task_timeout", "__task_until",
    "__task_wait",
  ];
}

pub function frontend_ungated(): string[] {
  return ["__map_new_i32"];
}

pub function capability_of(name: string): string {
  let bs = builtin_caps();
  for i in 0..bs.len() {
    if (bs[i].builtin == name) {
      return bs[i].capability;
    }
  }
  return "";
}

// internal/pkg/caps's IsBuiltin is the same test.
pub function is_builtin(name: string): boolean {
  return capability_of(name).len() > 0 || util.has_str(direct_privileged(), name) || util.has_str(ungated(), name);
}

pub function classified(name: string): boolean {
  if (name.len() >= 2 && name[0] == b'_' && name[1] == b'_') {
    return true;
  }
  if (capability_of(name).len() > 0) {
    return true;
  }
  if (util.has_str(ungated(), name)) {
    return true;
  }
  return util.has_str(frontend_ungated(), name);
}

pub struct Pkg {
  module: string,
  dir: string,
  name: string,
  root: boolean,
  governed: boolean,
  grants: string[],
}

pub function pkg_of(pkgs: Pkg[], module: string): string {
  for i in 0..pkgs.len() {
    if (pkgs[i].module == module) {
      return pkgs[i].dir;
    }
  }
  return "";
}

function pkg_index(pkgs: Pkg[], dir: string): i32 {
  for i in 0..pkgs.len() {
    if (pkgs[i].dir == dir) {
      return i;
    }
  }
  return -1;
}

pub function enforceable(mod: parser.Module, pkgs: Pkg[]): boolean {
  let non_root = false;
  for p in pkgs {
    if (!p.root) {
      non_root = true;
    }
  }
  if (!non_root) {
    return false;
  }
  for i in 0..mod.funcs.len() {
    let p = pkg_of(pkgs, mod.funcs[i].module);
    if (p.len() > 0) {
      let k = pkg_index(pkgs, p);
      if (k >= 0 && !pkgs[k].root) {
        return true;
      }
    }
  }
  return false;
}

pub struct Use { capability: string, chain: string[] }

pub struct Row { key: string, pkg: string, uses: Use[] }

function has_i32(xs: i32[], v: i32): boolean {
  for i in 0..xs.len() {
    if (xs[i] == v) {
      return true;
    }
  }
  return false;
}

pub function func_index(mod: parser.Module, name: string): i32 {
  for i in 0..mod.funcs.len() {
    if (mod.funcs[i].name == name) {
      return i;
    }
  }
  return -1;
}

function analysis_want(): string[] {
  let want: string[] = [];
  for b in builtin_caps() {
    want = want.append(b.builtin);
  }
  for name in direct_privileged() {
    want = want.append(name);
  }
  return want;
}

function chain_of(mod: parser.Module, order: i32[], parent: i32[], at: i32, builtin: string): string[] {
  let rev: string[] = [];
  let p = at;
  while (p >= 0) {
    rev = rev.append(mod.funcs[order[p]].name);
    p = parent[p];
  }
  let out: string[] = [];
  let i = rev.len() - 1;
  while (i >= 0) {
    out = out.append(rev[i]);
    i -= 1;
  }
  return out.append(builtin);
}

function walk(mod: parser.Module, pkgs: Pkg[], roots: i32[], want: util.NameIndex): Use[] {
  let order: i32[] = [];
  let parent: i32[] = [];
  for ri in 0..roots.len() {
    if (!has_i32(order, roots[ri])) {
      order = order.append(roots[ri]);
      parent = parent.append(-1);
    }
  }

  let direct = direct_privileged();
  let found_cap: string[] = [];
  let found_at: i32[] = [];
  let found_builtin: string[] = [];

  let qi = 0;
  while (qi < order.len()) {
    let fd = mod.funcs[order[qi]];

    let calls: astwalk.CallSite[] = [];
    for bi in 0..fd.body.len() {
      calls = astwalk.collect_calls_stmt(fd.body[bi], want, calls);
    }
    for ci in 0..calls.len() {
      let cap = capability_of(calls[ci].name);
      if (cap.len() == 0 && util.has_str(direct, calls[ci].name) && pkg_of(pkgs, fd.module).len() > 0) {
        cap = "privileged";
      }
      if (!calls[ci].method && cap.len() > 0 && !util.has_str(found_cap, cap)) {
        found_cap = found_cap.append(cap);
        found_at = found_at.append(qi);
        found_builtin = found_builtin.append(calls[ci].name);
      }
    }

    let refs = treeshake.body_refs(fd);
    for fi in 0..mod.funcs.len() {
      if (!has_i32(order, fi) && treeshake.refs_name(refs, mod.funcs[fi])) {
        order = order.append(fi);
        parent = parent.append(qi);
      }
    }
    qi += 1;
  }

  let uses: Use[] = [];
  let vocab = capabilities();
  for vi in 0..vocab.len() {
    let k = util.index_of_str(found_cap, vocab[vi]);
    if (k >= 0) {
      uses = uses.append(Use { capability: vocab[vi], chain: chain_of(mod, order, parent, found_at[k], found_builtin[k]) });
    }
  }
  return uses;
}

function sort_rows(rows: Row[]): Row[] {
  let taken = __alloc_i32(rows.len());
  let out: Row[] = [];
  for k in 0..rows.len() {
    let best: i32 = -1;
    for j in 0..rows.len() {
      if (taken[j] == 0) {
        if (best < 0 || util.str_less(rows[j].pkg, rows[best].pkg)) {
          best = j;
        }
      }
    }
    taken = taken.with(best, 1);
    out = out.append(rows[best]);
  }
  return out;
}

pub function analyze(mod: parser.Module, pkgs: Pkg[]): Row[] {
  let want = util.name_index(analysis_want());
  let names: string[] = [];
  for fi in 0..mod.funcs.len() {
    let p = pkg_of(pkgs, mod.funcs[fi].module);
    if (p.len() > 0 && !util.has_str(names, p)) {
      names = names.append(p);
    }
  }

  let rows: Row[] = [];
  for pi in 0..names.len() {
    let roots: i32[] = [];
    for fj in 0..mod.funcs.len() {
      if (pkg_of(pkgs, mod.funcs[fj].module) == names[pi]) {
        roots = roots.append(fj);
      }
    }
    let k = pkg_index(pkgs, names[pi]);
    let label = pkgs[k].name;
    let duplicate = false;
    for other in names {
      let oi = pkg_index(pkgs, other);
      if (other != names[pi] && pkgs[oi].name == label) {
        duplicate = true;
      }
    }
    if (duplicate) {
      label = label + " (" + names[pi] + ")";
    }
    rows = rows.append(Row { key: names[pi], pkg: label, uses: walk(mod, pkgs, roots, want) });
  }
  return sort_rows(rows);
}

function join_chain(chain: string[]): string {
  let out = "";
  for i in 0..chain.len() {
    if (i > 0) {
      out += " → ";
    }
    out += chain[i];
  }
  return out;
}

pub function format_rows(rows: Row[]): string {
  let out = "";
  for i in 0..rows.len() {
    if (rows[i].uses.len() == 0) {
      out = out + rows[i].pkg + "  -\n";
    } else {
      let names = "";
      let u = 0;
      while (u < rows[i].uses.len()) {
        if (u > 0) {
          names += ",";
        }
        names += rows[i].uses[u].capability;
        u += 1;
      }
      out = out + rows[i].pkg + "  " + names + "  (example: " + join_chain(rows[i].uses[0].chain) + ")\n";
    }
  }
  return out;
}

pub struct Violation {
  pkg: string,
  capability: string,
  chain: string[],
  governed: boolean,
}

pub function enforce(rows: Row[], pkgs: Pkg[]): Violation[] {
  let out: Violation[] = [];
  for ri in 0..rows.len() {
    let k = pkg_index(pkgs, rows[ri].key);
    let is_root = k >= 0 && pkgs[k].root;
    if (!is_root) {
      let governed = k >= 0 && pkgs[k].governed;
      let ui = 0;
      while (ui < rows[ri].uses.len()) {
        let u = rows[ri].uses[ui];
        let granted = false;
        if (governed) {
          granted = util.has_str(pkgs[k].grants, u.capability);
        }
        if (!granted) {
          out = out.append(Violation {
            pkg: rows[ri].pkg,
            capability: u.capability,
            chain: u.chain,
            governed: governed,
          });
        }
        ui += 1;
      }
    }
  }
  return out;
}

pub function source_chain(mod: parser.Module, chain: string[]): string[] {
  let out: string[] = [];
  for name in chain {
    let shown = name;
    let fi = func_index(mod, name);
    if (fi >= 0) {
      let pre = mod.funcs[fi].module + "__";
      if (mod.funcs[fi].module.len() > 0 && name.starts_with(pre)) {
        shown = slice_unchecked(name, pre.len(), name.len()).to_owned();
      }
    }
    out = out.append(shown);
  }
  return out;
}

pub function violation_message(v: Violation): string {
  let builtin = "";
  if (v.chain.len() > 0) {
    builtin = v.chain[v.chain.len() - 1];
  }
  let head = "package \"" + v.pkg + "\" reaches '" + v.capability + "' (" + builtin + ")";
  if (v.governed) {
    return head + " without a capability grant: " + join_chain(v.chain)
      + "; add \"" + v.capability + "\" to its capabilities in fern.toml or remove the call";
  }
  return head + " but no capabilities key governs it: " + join_chain(v.chain)
    + "; add capabilities = [...] to its dependency entry in fern.toml (ungoverned packages will become errors once default-deny lands)";
}
