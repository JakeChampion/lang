    "__outer_mul_f64",
    "__inner_mul_add_f64",
    "putchar", "print", "write", "eprint",
    "stdin", "stdout", "stderr", "isatty", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc", "pipe", "target_os", "target_arch", "args", "set_args", "exit",
    "signal_ignore", "signal_default",
    "signal_catch", "signal_taken", "signal_catch_interrupting",
    "signal_raise",
    "signal_mask", "signal_disposition",
    "priority", "set_priority",
    "geteuid", "getegid", "getuid", "getgid", "getgroups",
    "__account_entry",
    "rlimit_nofile", "disable_core_dumps",
    "__ct_secret", "__ct_public",
    "__bytes_owned", "__bytes_range", "__bytes_into",
    "__aes_expand_key", "__aes_ctr32", "__ghash", "__aes_gcm_seal_into", "__aes_gcm_open_into", "__sha256_hw", "__sha256_hw_blocks", "__sha1_hw", "__sha1_hw_blocks", "__sha1x8_hw", "__sha1x8_hw_blocks", "__chacha20_xor_into", "__poly1305_blocks",
    "__chacha20_poly1305_seal_into", "__chacha20_poly1305_open_into", "__mont_mul", "__scrypt_block_mix",
    "buf_new", "buf_push", "buf_push_range", "buf_push_bytes_range", "buf_push_mapped", "buf_push_filtered", "buf_push_expanded", "buf_push_bytes_mapped", "buf_push_bytes_filtered", "buf_push_bytes_expanded", "buf_push_byte", "buf_push_u64", "buf_push_decimal", "buf_push_base64", "buf_push_base32", "buf_decode_base32",
    "buf_len", "buf_take", "buf_take_bytes", "buf_clear", "buf_free",
    "f32_bits", "f32_from_bits", "f64_bits", "f64_from_bits",
    "poll", "wasm_block", "wasm_poll", "wasm_pollable_drop",
    "reactor_new", "reactor_ctl", "reactor_wait", "ring_new", "ring_ctl", "ring_wait", "ring_recv", "ring_send_zc",
