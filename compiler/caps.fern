pub function ungated(): string[] {
  return [
    "__outer_mul_f64",
    "__inner_mul_add_f64",
    "putchar", "print", "write", "eprint",
    "stdin", "stdout", "stderr", "isatty", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc", "pipe", "target_os", "target_arch", "args", "set_args", "exit",
    "signal_ignore", "signal_default",
    "signal_catch", "signal_taken", "signal_catch_interrupting",
    "signal_raise",
    "signal_mask", "signal_disposition",
    "priority", "set_priority",
    "geteuid", "getegid", "getuid", "getgid", "getgroups",
    "__account_entry",
    "rlimit_nofile", "disable_core_dumps",
    "__ct_secret", "__ct_public",
    "__bytes_owned", "__bytes_range", "__bytes_into",
    "__aes_expand_key", "__aes_ctr32", "__ghash", "__aes_gcm_seal_into", "__aes_gcm_open_into", "__sha256_hw", "__sha256_hw_blocks", "__sha1_hw", "__sha1_hw_blocks",
    "buf_new", "buf_push", "buf_push_range", "buf_push_bytes_range", "buf_push_mapped", "buf_push_filtered", "buf_push_expanded", "buf_push_bytes_mapped", "buf_push_bytes_filtered", "buf_push_bytes_expanded", "buf_push_byte", "buf_push_u64",
    "buf_len", "buf_take", "buf_take_bytes", "buf_clear", "buf_free",
    "f32_bits", "f32_from_bits", "f64_bits", "f64_from_bits",
    "poll", "wasm_block", "wasm_poll", "wasm_pollable_drop",
    "reactor_new", "reactor_ctl", "reactor_wait", "ring_new", "ring_ctl", "ring_wait", "ring_recv", "ring_send_zc",
    "map_new", "cell_new", "string_from_bytes_unchecked", "string_from_bytes_range_unchecked",
    "slice_unchecked",
    "int_to_string",
  ];
}

pub function frontend_ungated(): string[] {
  return ["__map_new_i32"];
}

pub function capability_of(name: string): string {
  let bs: BuiltinCap[] = builtin_caps();
  let i: i32 = 0;
  while (i < bs.len()) {
    if (bs[i].builtin == name) {
      return bs[i].capability;
    }
    i = i + 1;
  }
  return "";
}

pub function classified(name: string): boolean {
  if (name.len() >= 2 && name[0] == b'_' && name[1] == b'_') {
    return true;
  }
  if (capability_of(name).len() > 0) {
    return true;
  }
  if (util.has_str(ungated(), name)) {
    return true;
  }
  return util.has_str(frontend_ungated(), name);
}

pub struct Pkg {
  module: string,
  dir: string,
  name: string,
  root: boolean,
  governed: boolean,
  grants: string[],
}

pub function pkg_of(pkgs: Pkg[], module: string): string {
  let i: i32 = 0;
  while (i < pkgs.len()) {
    if (pkgs[i].module == module) {
      return pkgs[i].dir;
    }
    i = i + 1;
  }
  return "";
}

function pkg_index(pkgs: Pkg[], dir: string): i32 {
  let i: i32 = 0;
  while (i < pkgs.len()) {
    if (pkgs[i].dir == dir) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function enforceable(mod: parser.Module, pkgs: Pkg[]): boolean {
  let non_root: boolean = false;
  for p in pkgs {
    if (!p.root) {
      non_root = true;
    }
  }
  if (!non_root) {
    return false;
  }
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let p: string = pkg_of(pkgs, mod.funcs[i].module);
    if (p.len() > 0) {
      let k: i32 = pkg_index(pkgs, p);
      if (k >= 0 && !pkgs[k].root) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

pub struct Use { capability: string, chain: string[] }

pub struct Row { key: string, pkg: string, uses: Use[] }

function has_i32(xs: i32[], v: i32): boolean {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == v) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function func_index(mod: parser.Module, name: string): i32 {
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    if (mod.funcs[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function analysis_want(mod: parser.Module): string[] {
  let want: string[] = [];
  let bs: BuiltinCap[] = builtin_caps();
  let i: i32 = 0;
  while (i < bs.len()) {
    want = want.append(bs[i].builtin);
    i = i + 1;
  }
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    if (mod.funcs[fi].receiver_type.len() > 0) {
      let sn: string = util.mangled_name(mod.funcs[fi].name);
      if (!util.has_str(want, sn)) {
        want = want.append(sn);
      }
    }
    fi = fi + 1;
  }
  return want;
}

function chain_of(mod: parser.Module, order: i32[], parent: i32[], at: i32, builtin: string): string[] {
  let rev: string[] = [];
  let p: i32 = at;
  while (p >= 0) {
    rev = rev.append(mod.funcs[order[p]].name);
    p = parent[p];
  }
  let out: string[] = [];
  let i: i32 = rev.len() - 1;
  while (i >= 0) {
    out = out.append(rev[i]);
    i = i - 1;
  }
  return out.append(builtin);
}

function walk(mod: parser.Module, roots: i32[], want: util.NameIndex): Use[] {
  let order: i32[] = [];
  let parent: i32[] = [];
  let ri: i32 = 0;
  while (ri < roots.len()) {
    if (!has_i32(order, roots[ri])) {
      order = order.append(roots[ri]);
      parent = parent.append(0 - 1);
    }
    ri = ri + 1;
  }

  let found_cap: string[] = [];
  let found_at: i32[] = [];
  let found_builtin: string[] = [];

  let qi: i32 = 0;
  while (qi < order.len()) {
    let fd: parser.FuncDecl = mod.funcs[order[qi]];

    let calls: astwalk.CallSite[] = [];
    let bi: i32 = 0;
    while (bi < fd.body.len()) {
      calls = astwalk.collect_calls_stmt(fd.body[bi], want, calls);
      bi = bi + 1;
    }
    let ci: i32 = 0;
    while (ci < calls.len()) {
      if (calls[ci].method) {
        let mi: i32 = 0;
        while (mi < mod.funcs.len()) {
          if (mod.funcs[mi].receiver_type.len() > 0 && util.mangled_name(mod.funcs[mi].name) == calls[ci].name) {
            if (!has_i32(order, mi)) {
              order = order.append(mi);
              parent = parent.append(qi);
            }
          }
          mi = mi + 1;
        }
      } else {
        let cap: string = capability_of(calls[ci].name);
        if (cap.len() > 0 && !util.has_str(found_cap, cap)) {
          found_cap = found_cap.append(cap);
          found_at = found_at.append(qi);
          found_builtin = found_builtin.append(calls[ci].name);
        }
      }
      ci = ci + 1;
    }

    let ids: string[] = [];
    let si: i32 = 0;
    while (si < fd.body.len()) {
      ids = astwalk.collect_idents_stmt(fd.body[si], ids);
      si = si + 1;
    }
    let ii: i32 = 0;
    while (ii < ids.len()) {
      let fx: i32 = func_index(mod, ids[ii]);
      if (fx >= 0 && !has_i32(order, fx)) {
        order = order.append(fx);
        parent = parent.append(qi);
      }
      ii = ii + 1;
    }
    qi = qi + 1;
  }

  let uses: Use[] = [];
  let vocab: string[] = capabilities();
  let vi: i32 = 0;
  while (vi < vocab.len()) {
    let k: i32 = util.index_of_str(found_cap, vocab[vi]);
    if (k >= 0) {
      uses = uses.append(Use { capability: vocab[vi], chain: chain_of(mod, order, parent, found_at[k], found_builtin[k]) });
    }
    vi = vi + 1;
  }
  return uses;
}

function sort_rows(rows: Row[]): Row[] {
  let taken: i32[] = __alloc_i32(rows.len());
  let out: Row[] = [];
  let k: i32 = 0;
  while (k < rows.len()) {
    let best: i32 = 0 - 1;
    let j: i32 = 0;
    while (j < rows.len()) {
      if (taken[j] == 0) {
        if (best < 0 || util.str_less(rows[j].pkg, rows[best].pkg)) {
          best = j;
        }
      }
      j = j + 1;
    }
    taken = taken.with(best, 1);
    out = out.append(rows[best]);
    k = k + 1;
  }
  return out;
}

pub function analyze(mod: parser.Module, pkgs: Pkg[]): Row[] {
  let want: util.NameIndex = util.name_index(analysis_want(mod));
  let names: string[] = [];
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let p: string = pkg_of(pkgs, mod.funcs[fi].module);
    if (p.len() > 0 && !util.has_str(names, p)) {
      names = names.append(p);
    }
    fi = fi + 1;
  }

  let rows: Row[] = [];
  let pi: i32 = 0;
  while (pi < names.len()) {
    let roots: i32[] = [];
    let fj: i32 = 0;
    while (fj < mod.funcs.len()) {
      if (pkg_of(pkgs, mod.funcs[fj].module) == names[pi]) {
        roots = roots.append(fj);
      }
      fj = fj + 1;
    }
    let k: i32 = pkg_index(pkgs, names[pi]);
    let label: string = pkgs[k].name;
    let duplicate: boolean = false;
    for other in names {
      let oi: i32 = pkg_index(pkgs, other);
      if (other != names[pi] && pkgs[oi].name == label) {
        duplicate = true;
      }
    }
    if (duplicate) {
      label = label + " (" + names[pi] + ")";
    }
    rows = rows.append(Row { key: names[pi], pkg: label, uses: walk(mod, roots, want) });
    pi = pi + 1;
  }
  return sort_rows(rows);
}

function join_chain(chain: string[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < chain.len()) {
    if (i > 0) {
      out = out + " → ";
    }
    out = out + chain[i];
    i = i + 1;
  }
  return out;
}

pub function format_rows(rows: Row[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < rows.len()) {
    if (rows[i].uses.len() == 0) {
      out = out + rows[i].pkg + "  -\n";
    } else {
      let names: string = "";
      let u: i32 = 0;
      while (u < rows[i].uses.len()) {
        if (u > 0) {
          names = names + ",";
        }
        names = names + rows[i].uses[u].capability;
        u = u + 1;
      }
      out = out + rows[i].pkg + "  " + names + "  (example: " + join_chain(rows[i].uses[0].chain) + ")\n";
    }
    i = i + 1;
  }
  return out;
}

pub struct Violation {
  pkg: string,
  capability: string,
  chain: string[],
  governed: boolean,
}

pub function enforce(rows: Row[], pkgs: Pkg[]): Violation[] {
  let out: Violation[] = [];
  let ri: i32 = 0;
  while (ri < rows.len()) {
    let k: i32 = pkg_index(pkgs, rows[ri].key);
    let is_root: boolean = k >= 0 && pkgs[k].root;
    if (!is_root) {
      let governed: boolean = k >= 0 && pkgs[k].governed;
      let ui: i32 = 0;
      while (ui < rows[ri].uses.len()) {
        let u: Use = rows[ri].uses[ui];
        let granted: boolean = false;
        if (governed) {
          granted = util.has_str(pkgs[k].grants, u.capability);
        }
        if (!granted) {
          out = out.append(Violation {
            pkg: rows[ri].pkg,
            capability: u.capability,
            chain: u.chain,
            governed: governed,
          });
        }
        ui = ui + 1;
      }
    }
    ri = ri + 1;
  }
  return out;
}

pub function source_chain(mod: parser.Module, chain: string[]): string[] {
  let out: string[] = [];
  for name in chain {
    let shown: string = name;
    let fi: i32 = func_index(mod, name);
    if (fi >= 0) {
      let pre: string = mod.funcs[fi].module + "__";
      if (mod.funcs[fi].module.len() > 0 && util.str_has_prefix(name, pre)) {
        shown = slice_unchecked(name, pre.len(), name.len()) + "";
      }
    }
    out = out.append(shown);
  }
  return out;
}

pub function violation_message(v: Violation): string {
  let builtin: string = "";
  if (v.chain.len() > 0) {
    builtin = v.chain[v.chain.len() - 1];
  }
  let head: string = "package \"" + v.pkg + "\" reaches '" + v.capability + "' (" + builtin + ")";
  if (v.governed) {
    return head + " without a capability grant: " + join_chain(v.chain)
      + "; add \"" + v.capability + "\" to its capabilities in fern.toml or remove the call";
  }
  return head + " but no capabilities key governs it: " + join_chain(v.chain)
    + "; add capabilities = [...] to its dependency entry in fern.toml (ungoverned packages will become errors once default-deny lands)";
}
