import "./ssaallocatormachine" as initialized;
import "./ssaallocatorfirstmachine" as first;
import "./ssaarrayboxmachine" as box;
import "./ssaconstructormachine" as constructor;
import "./ssaprepare";

pub function allocator(output: string): boolean {
  return initialized.check(output) && first.check(output);
}

pub function array_box(output: string): boolean {
  return allocator(output) && box.check(output);
}

pub function record(output: ssaprepare.Output, name: string): boolean {
  return allocator(output.text) && constructor.check(output, name);
}
