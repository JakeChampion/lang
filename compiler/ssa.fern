pub function kind_name(id: i32): string {
  if (id < 0) {
    let at = -id - 1;
    if (at < SEMANTIC_KIND_NAMES.len() && SEMANTIC_KIND_NAMES[at] != "") {
      return SEMANTIC_KIND_NAMES[at];
    }
    return "invalid";
  }
  if (id == 0 || id >= KIND_NAMES.len() || KIND_NAMES[id] == "") {
    return "invalid";
  }
  return KIND_NAMES[id];
}

// The id of an instruction kind name, or 0. Semantic names are not looked up.
pub function kind_id(name: string): i32 {
  if (name == "") {
    return 0;
  }
  for id in 1..KIND_NAMES.len() {
    if (KIND_NAMES[id] == name) {
      return id;
    }
  }
  return 0;
}

pub function kind_count(): i32 {
  return KIND_NAMES.len() - 1;
}

pub function kind_retired(id: i32): boolean {
  return id > 0 && id < KIND_NAMES.len() && KIND_NAMES[id] == "";
}

pub function semantic_kind_count(): i32 {
  return SEMANTIC_KIND_NAMES.len();
}

const TERM_NAMES: string[] = ["", "ret", "br", "brif", "unreachable"];

pub function term_count(): i32 {
  return TERM_NAMES.len() - 1;
}

pub function term_id(name: string): i32 {
  for id in 1..TERM_NAMES.len() {
    if (TERM_NAMES[id] == name) {
      return id;
    }
  }
  return TERM_NONE;
}

pub function term_name(id: i32): string {
  if (id >= 0 && id < TERM_NAMES.len()) {
    return TERM_NAMES[id];
  }
  return "terminator " + util.i32_to_string(id);
}

function rewrite_args(ins: SInst, resolved: i32[]): SInst {
  let na: i32[] = [];
  for a in ins.args {
    // An argument below zero names no value.
    na = na.append(if (a >= 0) { resolved[a] } else { a });
  }
  return SInst { kind_tag: ins.kind_tag, result: ins.result, args: na, imm: ins.imm, str: ins.str };
}

function rewrite_term(t: STerm, resolved: i32[]): STerm {
  if (t.kind_tag == TERM_RET) {
    return t_ret(resolved[t.value]);
  }
  if (t.kind_tag == TERM_BRIF) {
    return t_brif(resolved[t.cond], t.t, t.f);
  }
  return t;
}

// A call_word copies a word of the last call's result out of its register.
// It calls nothing.
pub function result_word(ins: SInst): boolean {
  return ins.kind_tag == FLAT_OP && ins.str == "call_word";
}

// For each position, bit n is set where a later call_word of the block still
// reads word n from its register: from the position after the call to that
// call_word. No other value may hold that register there.
pub function result_word_masks(f: SFunc, ops: ir.Op[]): i32[] {
  let masks: i32[] = [];
  for blk in f.blocks {
    let row = __alloc_i32(blk.insts.len() + 1);
    let held = 0;
    let k = blk.insts.len() - 1;
    while (k >= 0) {
      let ins = blk.insts[k];
      if (result_word(ins)) {
        let slot = ops[ins.imm].i32_imm;
        if (slot >= 0 && slot < 3) {
          held = held | 1 << slot;
        }
        row = row.with(k, held);
      } else if (inst_is_call(ins)) {
        held = 0;
      } else {
        row = row.with(k, held);
      }
      k -= 1;
    }
    masks = util.append_all(masks, row);
  }
  return masks;
}

function inst_is_call(ins: SInst): boolean {
  if (result_word(ins)) {
    return false;
  }
  let k = ins.kind_tag;
  if (k == CALL || k == CALL_INDIRECT || k == CONCAT || k == STREQ || k == ARR_BOX || k == STR_CALL || k == RT_CALL || k == STR_VIEW || k == CALL_IND || k == FLAT_OP || k == DYN_DISPATCH) {
    return true;
  }
  return k >= PRINT && k <= WRITE_FILE;
}

// A runtime abort exits the process, so no value has to survive it.
pub function never_returns(ins: SInst): boolean {
  return inst_is_call(ins) && ins.args.len() == 0
    && (ins.str == "__fern_oob_abort" || ins.str == "__fern_str_oob_abort" || ins.str == "__fern_slice_abort" || ins.str == "__fern_alloc_size_abort");
}

pub function cold_call(ins: SInst): boolean {
  return ins.kind_tag == RT_CALL && ins.result >= 0 && ins.str.starts_with("arr_push");
}

// A back-reference copy calls only when its inline copy cannot run.
pub function back_copy_call(ins: SInst): boolean {
  return ins.kind_tag == CALL && ins.result >= 0 && ins.str == "__fern_bytes_append_back";
}

pub function reuse_alloc_call(ins: SInst): boolean {
  return ins.kind_tag == CALL && ins.result >= 0 && ins.str == "__fern_alloc_reuse" && ins.args.len() == 2;
}

// The imm of a reuse allocation whose token is null (fresh_boxes).
pub const REUSE_NULL: i32 = 7;

// The imm of a reuse allocation that runs only for a token that is null or
// has another shape (ssatokenkeep).
pub const REUSE_SPLIT: i32 = 8;

// A reuse allocation that always allocates.
pub function fresh_alloc_call(ins: SInst): boolean {
  return reuse_alloc_call(ins) && ins.imm == REUSE_NULL;
}

// A reuse allocation that calls only when its token is null or has another
// size.
pub function inline_reuse_call(ins: SInst): boolean {
  return reuse_alloc_call(ins) && ins.imm != REUSE_NULL;
}

// A reuse allocation that tests its token inline. A build for size calls the
// helper instead.
pub function slow_reuse_call(ins: SInst, size: boolean): boolean {
  return !size && inline_reuse_call(ins);
}

// A reuse allocation that the emitters expand inline.
pub function alloc_inline(ins: SInst, size: boolean): boolean {
  return fresh_alloc_call(ins) || slow_reuse_call(ins, size);
}

// A call that the allocator counts: it returns, and its result is not the
// block's own return value.
pub function counted_call(blk: SBlock, k: i32): boolean {
  let ins = blk.insts[k];
  return inst_is_call(ins) && !never_returns(ins) && !returns_call(blk, k);
}

// For each position, whether a counted call there clobbers the caller
// registers: a cold call saves what it needs itself.
pub function hard_call_positions(f: SFunc, cold: i32[]): boolean[] {
  let out: boolean[] = [];
  for blk in f.blocks {
    for k in 0..blk.insts.len() {
      let pos = out.len();
      out = out.append(counted_call(blk, k) && (cold.len() == 0 || cold[pos] == COLD_NONE));
    }
    out = out.append(false);
  }
  return out;
}

// `early` has each block that runs before the function makes its frame, and
// `sites` has each block that makes the frame when control enters it. The two
// are empty when the frame is made at the entry.
pub struct FrameSplit { early: boolean[], sites: boolean[] }

// The positions that the jumps of `t` reach. The emitter sends a jump to a
// block that only passes it on to the end of that chain (`forward_target`),
// and `fwd` has that end for each position.
function block_successors(at: i32[], fwd: i32[], t: STerm): i32[] {
  let ids: i32[] = [];
  if (t.kind_tag == TERM_BR) {
    ids = [t.target];
  } else if (t.kind_tag == TERM_BRIF && t.t == t.f) {
    ids = [t.t];
  } else if (t.kind_tag == TERM_BRIF) {
    ids = [t.t, t.f];
  }
  let out: i32[] = [];
  for id in ids {
    let to = block_index(at, id);
    out = out.append(if (to >= 0) { fwd[to] } else { to });
  }
  return out;
}

// Splits a function whose frame only saves registers. `ok[b]` says the block
// at position b needs no frame: it makes no call and no trap, and it reads
// and writes no register that the frame saves. `tied[b]` is the position of a
// block that the emitter copies to the end of b, or -1. `fwd[b]` is the
// position that a jump to b reaches.
//
// A block is early when it is ok, each of its predecessors is early, and a
// block tied to it is early. The predecessors of a block that is not early
// are all early or all not early, so the frame is made one time on each path.
// The split is empty unless an early block returns.
pub function frame_split(f: SFunc, at: i32[], ok: boolean[], tied: i32[], fwd: i32[]): FrameSplit {
  let none = FrameSplit { early: [], sites: [] };
  let n = f.blocks.len();
  if (n == 0 || f.blocks[0].id != f.entry || !ok[0]) {
    return none;
  }
  let preds: i32[][] = [];
  for b in f.blocks {
    preds = preds.append([]);
  }
  for b in 0..n {
    for to in block_successors(at, fwd, f.blocks[b].term) {
      if (to < 0) {
        return none;
      }
      preds = preds.with(to, preds[to].append(b));
    }
  }
  let early = ok;
  let changed = true;
  while (changed && early[0]) {
    changed = false;
    for b in 0..n {
      let before = false;
      let after = false;
      for p in preds[b] {
        before = before || early[p];
        after = after || !early[p];
      }
      if (early[b] && (after || tied[b] >= 0 && !early[tied[b]])) {
        early = early.with(b, false);
        changed = true;
      } else if (!early[b] && before && after) {
        for p in preds[b] {
          early = early.with(p, false);
        }
        changed = true;
      }
    }
  }
  let returns = false;
  let sites = __alloc_bool(n);
  for b in 0..n {
    returns = returns || early[b] && f.blocks[b].term.kind_tag == TERM_RET;
    for p in preds[b] {
      if (!early[b] && early[p]) {
        sites = sites.with(b, true);
      }
    }
  }
  if (!early[0] || !returns) {
    return none;
  }
  return FrameSplit { early: early, sites: sites };
}

pub const COLD_NONE: i32 = 0;

pub const COLD_SLOW: i32 = 1;

pub const COLD_BRANCH: i32 = 2;

pub const COLD_INLINE: i32 = 3;

// A call of a routine that changes only the registers that `light_call`
// names. A value that lives across it keeps any other register, and the
// call saves nothing.
pub const COLD_LIGHT: i32 = 4;

// An inline kernel. It calls nothing, and it changes only the registers that
// the emitter names for its position. A value that lives across it keeps any
// other register.
pub const COLD_KERNEL: i32 = 5;

// `cold` with COLD_KERNEL at each position that has a mask in `clobbers`.
// A kernel in a cold block is a kernel: it saves nothing.
pub function with_kernels(cold: i32[], clobbers: i32[]): i32[] {
  for pos in 0..cold.len() {
    if (clobbers[pos] != 0) {
      cold = cold.with(pos, COLD_KERNEL);
    }
  }
  return cold;
}

// `light` says the box routines of the build change only the result and
// their arguments.
pub function cold_positions(f: SFunc, size: boolean, back: boolean, light: boolean): i32[] {
  let cold = cold_blocks(f);
  let out: i32[] = [];
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    for k in 0..blk.insts.len() {
      out = out.append(cold_kind(blk, k, cold[bi], size, back, light));
    }
    out = out.append(COLD_NONE);
  }
  return out;
}

// The block of a record, a variant or a tuple, and the allocation for a null
// token, which goes to the same routine.
pub function light_call(ins: SInst): boolean {
  return ins.kind_tag == ARR_BOX && ins.str == "box" || fresh_alloc_call(ins);
}

// The imm of a release of a box that its frame proved unique (ir.sole).
pub const SOLE: i32 = 5;

// The imm of such a release of a box of 1 to 255 words (ir.sole_box).
pub const SOLE_BOX: i32 = 9;

// The imm of the helper release of a record or a variant that a uniqueness
// test found shared (ir.shared_dec). The emitters only take one from the
// count, inline.
pub const SHARED_DEC: i32 = 10;

// The imm of the release of a static box (ir.static_release).
pub const STATIC_RELEASE: i32 = 11;

pub function static_release(ins: SInst): boolean {
  return ins.kind_tag == CALL && ins.args.len() == 1 && ins.imm == STATIC_RELEASE;
}

pub function shared_dec(ins: SInst): boolean {
  return ins.kind_tag == CALL && ins.args.len() == 1 && ins.imm == SHARED_DEC && ins.str.starts_with("__sem_release_");
}

// A release with no test of the count.
pub function sole_release(ins: SInst): boolean {
  return ins.imm == SOLE || ins.imm == SOLE_BOX;
}

// A release that the emitters test inline: the count of a shared box goes
// down by one, and only a unique box calls the routine. The helper release
// of a record or a variant has the mark 7 (`ir.box_release`).
pub function inline_release(ins: SInst): boolean {
  return ins.kind_tag == CALL && ins.args.len() == 1 && (ins.str == "__fern_rc_dec" && !sole_release(ins) && !static_release(ins) || ins.imm == 7 && ins.str.starts_with("__sem_release_"));
}

function cold_kind(blk: SBlock, k: i32, cold: boolean, size: boolean, back: boolean, light: boolean): i32 {
  let ins = blk.insts[k];
  if (light && light_call(ins)) {
    return COLD_LIGHT;
  }
  if (!size && inline_release(ins)) {
    return COLD_BRANCH;
  }
  if (cold_call(ins) || back && back_copy_call(ins)) {
    return COLD_SLOW;
  }
  if (rc_inlined(ins)) {
    return if (size) { COLD_NONE } else { COLD_INLINE };
  }
  if (cold_branch(blk, k, cold)) {
    return COLD_BRANCH;
  }
  if (slow_reuse_call(ins, size)) {
    return COLD_SLOW;
  }
  return COLD_NONE;
}

// A call in a cold block, or an allocation for a null token.
function cold_branch(blk: SBlock, k: i32, cold: boolean): boolean {
  let ins = blk.insts[k];
  return (cold || fresh_alloc_call(ins)) && inst_is_call(ins) && !never_returns(ins) && !returns_call(blk, k);
}

pub function cold_blocks(f: SFunc): boolean[] {
  let n = f.blocks.len();
  let at = block_positions(f);
  let latch = __alloc_i32(n);
  let span = __alloc_i32(n);
  for i in 0..n {
    latch = latch.with(i, -1);
    span = span.with(i, n + 1);
  }
  for bi in 0..n {
    for which in 0..2 {
      let tgt = distinct_successor_position(at, f.blocks[bi].term, which);
      if (tgt >= 0 && tgt <= bi) {
        for k in tgt..=bi {
          if (bi - tgt < span[k]) {
            span = span.with(k, bi - tgt);
            latch = latch.with(k, bi);
          }
        }
      }
    }
  }
  let idom = immediate_dominators(f, at);
  let out = __alloc_bool(n);
  for i in 0..n {
    out = out.with(i, latch[i] >= 0 && !dominates(idom, i, latch[i]));
  }
  return out;
}

// The immediate dominator of each block position, the entry its own, or -1
// for a block the entry does not reach.
pub function immediate_dominators(f: SFunc, at: i32[]): i32[] {
  let n = f.blocks.len();
  let entry = position_of(at, f.entry);
  let idom = __alloc_i32(n);
  let po = __alloc_i32(n);
  for i in 0..n {
    idom = idom.with(i, -1);
    po = po.with(i, -1);
  }
  if (entry < 0) {
    return idom;
  }
  let order = postorder(f, at, entry);
  for i in 0..order.len() {
    po = po.with(order[i], i);
  }
  idom = idom.with(entry, entry);
  let changed = true;
  while (changed) {
    changed = false;
    let r = order.len() - 1;
    while (r >= 0) {
      let b = order[r];
      r -= 1;
      if (b == entry) {
        continue;
      }
      let pick = meet_preds(f, at, idom, po, b);
      if (pick != idom[b]) {
        idom = idom.with(b, pick);
        changed = true;
      }
    }
  }
  return idom;
}

function meet_preds(f: SFunc, at: i32[], idom: i32[], po: i32[], b: i32): i32 {
  let pick: i32 = -1;
  for pid in f.blocks[b].preds {
    let p = position_of(at, pid);
    if (p >= 0 && idom[p] >= 0) {
      if (pick < 0) {
        pick = p;
      } else {
        pick = intersect(idom, po, p, pick);
      }
    }
  }
  return pick;
}

function intersect(idom: i32[], po: i32[], a: i32, b: i32): i32 {
  while (a != b) {
    while (po[a] < po[b]) {
      a = idom[a];
    }
    while (po[b] < po[a]) {
      b = idom[b];
    }
  }
  return a;
}

function postorder(f: SFunc, at: i32[], entry: i32): i32[] {
  let seen = __alloc_bool(f.blocks.len());
  let out: i32[] = [];
  let stack = __alloc_i32(f.blocks.len());
  let next = __alloc_i32(f.blocks.len());
  stack = stack.with(0, entry);
  let depth = 1;
  seen = seen.with(entry, true);
  while (depth > 0) {
    let top = depth - 1;
    let b = stack[top];
    let which = next[top];
    if (which < 2) {
      next = next.with(top, which + 1);
      let s = distinct_successor_position(at, f.blocks[b].term, which);
      if (s >= 0 && !seen[s]) {
        seen = seen.with(s, true);
        stack = stack.with(depth, s);
        next = next.with(depth, 0);
        depth += 1;
      }
    } else {
      out = out.append(b);
      depth -= 1;
    }
  }
  return out;
}

// The block positions the entry reaches, in reverse postorder.
pub function reverse_postorder(f: SFunc, at: i32[]): i32[] {
  let entry = position_of(at, f.entry);
  if (entry < 0) {
    return [];
  }
  let order = postorder(f, at, entry);
  let out: i32[] = [];
  let i = order.len() - 1;
  while (i >= 0) {
    out = out.append(order[i]);
    i -= 1;
  }
  return out;
}

function dominates(idom: i32[], a: i32, b: i32): boolean {
  if (idom[b] < 0) {
    return false;
  }
  let x = b;
  while (x != a) {
    if (idom[x] == x) {
      return false;
    }
    x = idom[x];
  }
  return true;
}

pub function returns_call(blk: SBlock, k: i32): boolean {
  let ins = blk.insts[k];
  return k == blk.insts.len() - 1 && blk.term.kind_tag == TERM_RET && ins.result >= 0 && blk.term.value == ins.result;
}

pub function calls_out(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (calls(ins)) {
        return true;
      }
    }
  }
  return false;
}

pub function calls(ins: SInst): boolean {
  return inst_is_call(ins) && !rc_inlined(ins) && !never_returns(ins);
}

pub function rc_inlined(ins: SInst): boolean {
  if (ins.kind_tag != CALL || ins.args.len() != 1) {
    return false;
  }
  return ins.str == "__fern_rc_is_unique" || ins.str == "__fern_rc_inc" || shared_dec(ins) || static_release(ins);
}

function calls_before(calls: i32[], total_pos: i32): i32[] {
  let cum = __alloc_i32(total_pos + 2);
  let ci = 0;
  for p in 0..=total_pos + 1 {
    cum = cum.with(p, ci);
    while (ci < calls.len() && calls[ci] < p + 1) {
      ci += 1;
    }
  }
  return cum;
}

function spans_call(cum: i32[], lo: i32, hi: i32): boolean {
  if (hi <= lo + 1) {
    return false;
  }
  let a = lo + 1;
  if (a >= cum.len()) {
    return false;
  }
  let b = hi;
  if (b >= cum.len()) {
    b = cum.len() - 1;
  }
  return cum[b] - cum[a] > 0;
}

// With no saved register left, saving a caller register around the cold
// calls costs less than a spill that every iteration loads and stores.
function cold_caller(saved_free: i32, cold_integer: boolean, pick: i32, cum: i32[], lo: i32, hi: i32): boolean {
  return saved_free == 0 && cold_integer && pick >= 0 && !spans_call(cum, lo, hi);
}

// A value spans a call when it is live after one. `crossing` gives that from
// block liveness. Without it, any call inside the value's interval counts.
function hard_spans(f: SFunc, bw: i32[], cum: i32[], cold: i32[], lo: i32[], hi: i32[], weight: i32[], crossing: boolean[]): boolean[] {
  let out = __alloc_bool(f.nvals);
  let exact = crossing.len() == f.nvals;
  if (cold.len() == 0) {
    for v in 0..f.nvals {
      out = out.with(v, if (exact) { crossing[v] } else { spans_call(cum, lo[v], hi[v]) });
    }
    return out;
  }
  let cost = cold_call_cost(f, cold, bw);
  for v in 0..f.nvals {
    let h: boolean = if (exact) { crossing[v] } else { spans_call(cum, lo[v], hi[v]) };
    if (!h && hi[v] > lo[v] + 1 && lo[v] + 1 < cost.len()) {
      let b = hi[v];
      if (b >= cost.len()) {
        b = cost.len() - 1;
      }
      h = 2 * (cost[b] - cost[lo[v] + 1]) >= weight[v];
    }
    out = out.with(v, h);
  }
  return out;
}

function cold_call_cost(f: SFunc, cold: i32[], bw: i32[]): i32[] {
  let out: i32[] = [0];
  let total = 0;
  let pos = 0;
  for bi in 0..f.blocks.len() {
    for k in 0..=f.blocks[bi].insts.len() {
      if (pos < cold.len() && cold[pos] == COLD_BRANCH) {
        total += bw[bi];
      }
      pos += 1;
      out = out.append(total);
    }
  }
  return out;
}

// The emitter saves no float register around a cold call, so a float value
// counts each call it is live after.
function spans_hard(hard: boolean[], crossing_all: boolean[], integer: boolean, cum: i32[], lo: i32, hi: i32, v: i32): boolean {
  if (integer) {
    return hard[v];
  }
  if (v < crossing_all.len()) {
    return crossing_all[v];
  }
  return spans_call(cum, lo, hi);
}

function order_by_lo(n: i32, lo: i32[]): i32[] {
  let maxp = 0;
  let v = 0;
  while (v < n) {
    if (lo[v] < 2000000000 && lo[v] > maxp) {
      maxp = lo[v];
    }
    v += 1;
  }
  let starts = __alloc_i32(maxp + 3);
  v = 0;
  while (v < n) {
    let b = order_bucket(lo[v], maxp);
    starts = starts.with(b + 1, starts[b + 1] + 1);
    v += 1;
  }
  let b2 = 1;
  while (b2 < starts.len()) {
    starts = starts.with(b2, starts[b2] + starts[b2 - 1]);
    b2 += 1;
  }
  let out = __alloc_i32(n);
  for v in 0..n {
    let bk = order_bucket(lo[v], maxp);
    out = out.with(starts[bk], v);
    starts = starts.with(bk, starts[bk] + 1);
  }
  return out;
}

function order_bucket(lo: i32, maxp: i32): i32 {
  if (lo >= 2000000000) {
    return maxp + 1;
  }
  return lo;
}

function extend_loop_invariant_intervals(f: SFunc, def_pos: i32[], hi: i32[]): i32[] {
  let top: i32 = -1;
  for b in f.blocks {
    if (b.id > top) {
      top = b.id;
    }
  }
  let start_of = util.minus_ones(top + 1);
  let rpos = 0;
  for b in f.blocks {
    if (b.id >= 0) {
      start_of = start_of.with(b.id, rpos);
    }
    rpos = rpos + b.insts.len() + 1;
  }
  let edge_head: i32[] = [];
  let edge_end: i32[] = [];
  let lstart = 0;
  for lblk in f.blocks {
    let lterm_pos = lstart + lblk.insts.len();
    for th in 0..2 {
      let tgt: i32 = -1;
      if (th == 0) {
        if (lblk.term.kind_tag == TERM_BR) {
          tgt = lblk.term.target;
        } else if (lblk.term.kind_tag == TERM_BRIF) {
          tgt = lblk.term.t;
        }
      } else if (lblk.term.kind_tag == TERM_BRIF) {
        tgt = lblk.term.f;
      }
      if (tgt >= 0 && tgt <= top) {
        let hstart = start_of[tgt];
        if (hstart >= 0 && hstart <= lstart) {
          edge_head = edge_head.append(hstart);
          edge_end = edge_end.append(lterm_pos);
        }
      }
    }
    lstart = lterm_pos + 1;
  }
  if (edge_head.len() == 0) {
    return hi;
  }
  let heads = sorted_i32(edge_head);
  let vv = 0;
  while (vv < f.nvals && vv < hi.len()) {
    let d = def_pos[vv];
    if (d >= 0) {
      let first = first_above(heads, d);
      if (first < heads.len() && heads[first] <= hi[vv]) {
        for e in 0..edge_head.len() {
          if (d < edge_head[e] && hi[vv] >= edge_head[e] && edge_end[e] > hi[vv]) {
            hi = hi.with(vv, edge_end[e]);
          }
        }
      }
    }
    vv += 1;
  }
  return hi;
}

function sorted_i32(xs: i32[]): i32[] {
  let out: i32[] = [];
  for x in xs {
    out = out.append(x);
    let i = out.len() - 1;
    while (i > 0 && out[i - 1] > x) {
      out = out.with(i, out[i - 1]);
      i -= 1;
    }
    out = out.with(i, x);
  }
  return out;
}

function first_above(xs: i32[], v: i32): i32 {
  let lo = 0;
  let hi = xs.len();
  while (lo < hi) {
    let mid: i32 = (lo + hi) / 2;
    if (xs[mid] > v) {
      hi = mid;
    } else {
      lo = mid + 1;
    }
  }
  return lo;
}

pub function binary_fixes_abi(op: string): boolean {
  return op == "div_s" || op == "div_u" || op == "rem_s" || op == "rem_u" || op == "mulhi_u" || op == "mulhi_s";
}

function pick_caller_reg(free: i32[], abi_reg: i32, want_abi: boolean, abi_ok: boolean): i32 {
  if (free.len() == 0) {
    return -1;
  }
  if (abi_reg < 0) {
    return free[free.len() - 1];
  }
  if (want_abi) {
    for r in free {
      if (r == abi_reg) {
        return abi_reg;
      }
    }
  }
  let i = free.len() - 1;
  while (i >= 0) {
    if (free[i] != abi_reg) {
      return free[i];
    }
    i -= 1;
  }
  if (!abi_ok) {
    return -1;
  }
  return abi_reg;
}

function pick_fixed_reg(free: i32[], abi_reg: i32, want_abi: boolean, abi_ok: boolean, fixed: ssafixed.Table, lo: i32, hi: i32): i32 {
  if (ssafixed.empty(fixed)) {
    return pick_caller_reg(free, abi_reg, want_abi, abi_ok);
  }
  let take_abi = abi_ok && abi_reg >= 0 && ssafixed.allows(fixed, abi_reg, lo, hi) && index_of_reg(free, abi_reg) >= 0;
  if (want_abi && take_abi) {
    return abi_reg;
  }
  let i = free.len() - 1;
  while (i >= 0) {
    let r = free[i];
    if (r != abi_reg && ssafixed.allows(fixed, r, lo, hi)) {
      return r;
    }
    i -= 1;
  }
  if (take_abi) {
    return abi_reg;
  }
  return -1;
}

function preferred_register_allowed(reg: i32, abi: i32, abi_ok: boolean, spans: boolean, lo: i32, hi: i32, fixed: ssafixed.Table): boolean {
  return reg >= 0 && !spans && (reg != abi || abi_ok) && ssafixed.allows(fixed, reg, lo, hi);
}

function candidate(mates: Mates, def_a: i32[], def_b: i32[], v: i32, k: i32): i32 {
  return match (k) {
    0 => mates.alt[v],
    1 => mates.hint[v],
    2 => -2,
    3 => def_a[v],
    _ => def_b[v],
  };
}

function remove_reg(free: i32[], reg: i32): i32[] {
  let out: i32[] = [];
  let dropped = false;
  for r in free {
    if (r == reg && !dropped) {
      dropped = true;
    } else {
      out = out.append(r);
    }
  }
  return out;
}

function forbidden_abi(abi_reg: i32, allowed: boolean): i32 {
  if (allowed) {
    return -1;
  }
  return abi_reg;
}

function cheapest_active(act_val: i32[], act_reg: i32[], act_hi: i32[], shared_with: i32[], lent: boolean[], weight: i32[], lo: i32[], hi: i32[], lens: i32[], now: i32, nregs: i32, need_saved: boolean, forbidden: i32, fixed: ssafixed.Table, until: i32): i32 {
  let best: i32 = -1;
  let best_w = 0;
  let best_len = 1;
  for i in 0..act_val.len() {
    if ((act_reg[i] >= nregs || !need_saved) && act_reg[i] != forbidden && ssafixed.allows(fixed, act_reg[i], now, until)) {
      let w = chain_weight(act_val[i], shared_with, lent, weight, hi, now);
      let len = chain_len(act_val[i], act_hi[i], shared_with, lent, lo, hi, lens, now);
      let cmp = cmp_spill_cost(w, len, best_w, best_len);
      if (best < 0 || cmp < 0 || cmp == 0 && act_hi[i] > act_hi[best]) {
        best = i;
        best_w = w;
        best_len = len;
      }
    }
  }
  return best;
}

function cmp_spill_cost(w1: i32, len1: i32, w2: i32, len2: i32): i32 {
  let a = w1 as f64 * (w1 as f64) * (len2 as f64);
  let b = w2 as f64 * (w2 as f64) * (len1 as f64);
  if (a < b) {
    return -1;
  }
  if (a > b) {
    return 1;
  }
  return 0;
}

// The positions a chain's values are live at, or, with no live lengths, the
// span from its first value's start to its end.
function chain_len(v: i32, top: i32, shared_with: i32[], lent: boolean[], lo: i32[], hi: i32[], lens: i32[], now: i32): i32 {
  if (lens.len() == 0) {
    return top - chain_lo(v, shared_with, lo, hi, now) + 1;
  }
  let n = 0;
  if (heads(v, lent, hi, now)) {
    n = live_len(v, lo, hi, lens);
  }
  let ev = shared_with[v];
  while (ev >= 0) {
    if (still_holds(ev, hi, now)) {
      n += live_len(ev, lo, hi, lens);
    }
    ev = shared_with[ev];
  }
  if (n == 0) {
    return 1;
  }
  return n;
}

function live_len(v: i32, lo: i32[], hi: i32[], lens: i32[]): i32 {
  if (v < lens.len() && lens[v] > 0) {
    return lens[v];
  }
  return hi[v] - lo[v] + 1;
}

function chain_lo(v: i32, shared_with: i32[], lo: i32[], hi: i32[], now: i32): i32 {
  let m = lo[v];
  let ev = shared_with[v];
  while (ev >= 0) {
    if (still_holds(ev, hi, now) && lo[ev] < m) {
      m = lo[ev];
    }
    ev = shared_with[ev];
  }
  return m;
}

// The first value of a chain counts: its mates are the same value at another
// place. But a value that borrowed the register is not a mate, and it can end
// before the value that lent it. It then counts no more.
function heads(v: i32, lent: boolean[], hi: i32[], now: i32): boolean {
  return v >= lent.len() || !lent[v] || still_holds(v, hi, now);
}

function chain_weight(v: i32, shared_with: i32[], lent: boolean[], weight: i32[], hi: i32[], now: i32): i32 {
  let w = 0;
  if (heads(v, lent, hi, now)) {
    w = weight[v];
  }
  let ev = shared_with[v];
  while (ev >= 0) {
    if (still_holds(ev, hi, now)) {
      w += weight[ev];
    }
    ev = shared_with[ev];
  }
  return w;
}

function any_below(xs: i32[], x: i32): boolean {
  for e in xs {
    if (e < x) {
      return true;
    }
  }
  return false;
}

function still_holds(ev: i32, hi: i32[], now: i32): boolean {
  return hi[ev] >= now;
}

// The position of each header's last back edge, or -1.
function furthest_latches(f: SFunc, at: i32[]): i32[] {
  let latch = util.minus_ones(f.blocks.len());
  for bi in 0..f.blocks.len() {
    for which in 0..2 {
      let tgt = distinct_successor_position(at, f.blocks[bi].term, which);
      if (tgt >= 0 && tgt <= bi && bi > latch[tgt]) {
        latch = latch.with(tgt, bi);
      }
    }
  }
  return latch;
}

// A loop is a header and the blocks up to its last back edge, so a header
// with two back edges counts once.
pub function block_loop_weights(f: SFunc): i32[] {
  return weights_from_latches(furthest_latches(f, block_positions(f)));
}

function weights_from_latches(latch: i32[]): i32[] {
  let out = __alloc_i32(latch.len());
  let depth = 0;
  for i in 0..latch.len() {
    let last = latch[i];
    if (last >= i) {
      depth += 1;
      // Until the scan reaches a latch, its slot counts the loops ending there.
      out = out.with(last, out[last] + 1);
    }
    let ending = out[i];
    let levels = if (depth < 3) { depth } else { 3 };
    out = out.with(i, 1 << levels * 3);
    depth -= ending;
  }
  return out;
}

function drop_active_at(a: i32[], k: i32): i32[] {
  let out: i32[] = [];
  for i in 0..a.len() {
    if (i != k) {
      out = out.append(a[i]);
    }
  }
  return out;
}

pub struct Alloc { reg_of: i32[], def_pos: i32[], lo: i32[], hi: i32[], cold: i32[] }

pub function lane_base(op: string): string {
  for k in 0..op.len() {
    if (op[k] == b':') {
      return slice_unchecked(op, 0, k).to_owned();
    }
  }
  return op;
}

pub function lane_op(op: string): boolean {
  return op.len() > 1 && op[0] == b'v' && ir.is_lane_kind(ir.kind_id(lane_base(op)));
}

pub function lane_inst(ins: SInst): boolean {
  let k = ins.kind_tag;
  return (k == BINARY || k == UNARY || k == TERNARY || k == LANE_STORE) && lane_op(ins.str);
}

pub function lane_param(f: SFunc, p: i32): boolean {
  if (f.blocks.len() == 0) {
    return false;
  }
  for ins in f.blocks[0].insts {
    if (ins.kind_tag == PARAM && ins.imm == p) {
      return ins.str == lane_param_mark();
    }
  }
  return false;
}

pub function lane_param_mark(): string {
  return "v128";
}

pub function lane_memory(b: string): boolean {
  return util.has_str(["vload", "vload_f32", "vstore", "vget", "vset"], b);
}

pub function lane_result(ins: SInst): boolean {
  if (ins.kind_tag == PARAM && ins.str == lane_param_mark() || ins.kind_tag == CALL && ins.imm == 6) {
    return true;
  }
  if (!lane_inst(ins)) {
    return false;
  }
  let b = lane_base(ins.str);
  return b != "vextract" && b != "vextract_bits" && b != "vbitmask" && b != "vstore" && b != "vset" && b != "viextracts" && b != "viextractu" && b != "vibitmask";
}

pub function lane_values(f: SFunc): boolean[] {
  let lanes = lane_results(f);
  if (lanes.len() == 0) {
    return [];
  }
  return lane_carriers(f, lanes);
}

function lane_results(f: SFunc): boolean[] {
  let lanes: boolean[] = [];
  for blk in f.blocks {
    for ins in blk.insts {
      let k = ins.kind_tag;
      let maybe = k == PARAM || k == CALL && ins.imm == 6 || (k == BINARY || k == UNARY || k == TERNARY || k == LANE_STORE) && ins.str.len() > 1 && ins.str[0] == b'v';
      if (maybe && ins.result >= 0 && ins.result < f.nvals && lane_result(ins)) {
        if (lanes.len() == 0) {
          lanes = __alloc_bool(f.nvals);
        }
        lanes = lanes.with(ins.result, true);
      }
    }
  }
  return lanes;
}

function lane_carriers(f: SFunc, lanes: boolean[]): boolean[] {
  let changed = true;
  while (changed) {
    changed = false;
    for blk in f.blocks {
      for ins in blk.insts {
        if ((ins.kind_tag == PHI || ins.kind_tag == COPY) && ins.result >= 0 && !lanes[ins.result] && phi_joins_lane(ins, lanes)) {
          lanes = lanes.with(ins.result, true);
          changed = true;
        }
      }
    }
  }
  return lanes;
}

function phi_joins_lane(ins: SInst, lanes: boolean[]): boolean {
  for a in ins.args {
    if (a >= 0 && a < lanes.len() && lanes[a]) {
      return true;
    }
  }
  return false;
}

pub function has_lanes(f: SFunc): boolean {
  return lane_values(f).len() > 0;
}

pub function float_values(f: SFunc, fcalls: boolean[], tolerant: boolean): boolean[] {
  let fl = __alloc_bool(f.nvals);
  let derived = __alloc_bool(f.nvals);
  let seeded = false;
  for blk in f.blocks {
    for ins in blk.insts {
      let fcall = ins.kind_tag == CALL && ins.result >= 0 && ins.result < fcalls.len() && fcalls[ins.result];
      if (ins.result >= 0 && ins.result < f.nvals && (float_def(ins) || fcall)) {
        let d = ins.kind_tag == PARAM || ins.kind_tag == PHI || ins.kind_tag == CALL || float_load(ins);
        fl = fl.with(ins.result, true);
        derived = derived.with(ins.result, d);
        seeded = seeded || !d;
      }
      seeded = seeded || float_use(ins);
    }
  }
  if (!seeded) {
    return with_lanes(f, __alloc_bool(f.nvals));
  }
  let changed = true;
  while (changed) {
    changed = false;
    let strong = float_strong(f, fl, derived);
    for blk in f.blocks {
      for ins in blk.insts {
        let keeps = float_use(ins) || ins.kind_tag == PHI && fl[ins.result] || tolerant && float_tolerant(ins);
        for a in ins.args {
          if (!keeps && a >= 0 && a < f.nvals && fl[a]) {
            fl = fl.with(a, false);
            changed = true;
          }
        }
      }
      let t = blk.term;
      if (t.kind_tag == TERM_BRIF && t.cond >= 0 && t.cond < f.nvals && fl[t.cond]) {
        fl = fl.with(t.cond, false);
        changed = true;
      }
    }
    for v in 0..f.nvals {
      if (fl[v] && derived[v] && !strong[v]) {
        fl = fl.with(v, false);
        changed = true;
      }
    }
  }
  return with_lanes(f, fl);
}

function with_lanes(f: SFunc, fl: boolean[]): boolean[] {
  let lanes = lane_values(f);
  for v in 0..lanes.len() {
    if (lanes[v]) {
      fl = fl.with(v, true);
    }
  }
  for x in fl {
    if (x) {
      return fl;
    }
  }
  return [];
}

function float_strong(f: SFunc, fl: boolean[], derived: boolean[]): boolean[] {
  let strong = __alloc_bool(f.nvals);
  let changed = true;
  while (changed) {
    changed = false;
    for blk in f.blocks {
      for ins in blk.insts {
        let fop = float_use(ins) || ins.kind_tag == PHI && fl[ins.result] && strong[ins.result];
        for a in ins.args {
          if (fop && a >= 0 && a < f.nvals && fl[a] && !strong[a]) {
            strong = strong.with(a, true);
            changed = true;
          }
        }
        if (ins.kind_tag == PHI && ins.result >= 0 && fl[ins.result] && !strong[ins.result]) {
          for a in ins.args {
            if (a >= 0 && a < f.nvals && fl[a] && (!derived[a] || strong[a]) && !strong[ins.result]) {
              strong = strong.with(ins.result, true);
              changed = true;
            }
          }
        }
      }
    }
  }
  return strong;
}

function float_tolerant(ins: SInst): boolean {
  return ins.kind_tag == CALL && !rc_inlined(ins);
}

function float_def(ins: SInst): boolean {
  let k = ins.kind_tag;
  if (k == CONST_FLOAT || k == PARAM || k == PHI || float_load(ins)) {
    return true;
  }
  if (k == BINARY) {
    return float_arith(ins.str);
  }
  if (k == UNARY) {
    return float_math(ins.str) || ins.str.starts_with("i32_to_f64:") || ins.str == "f64_from_bits" || lane_base(ins.str) == "vextract";
  }
  return k == TERNARY && (ins.str == "ffma" || ins.str == "ffma32");
}

function float_load(ins: SInst): boolean {
  return ins.kind_tag == LD_AT || ins.kind_tag == ARR_AT && mark_bits(ins.str) == 0;
}

// The bits of an array element that an access marks: "u8" for a byte, "u16"
// and "i16" for 2 bytes, "u32" and "i32" for 4 bytes, or 0 for a word.
pub function mark_bits(mark: string): i32 {
  if (mark == "u8") {
    return 8;
  }
  if (mark == "u16" || mark == "i16") {
    return 16;
  }
  return if (mark == "u32" || mark == "i32") { 32 } else { 0 };
}

function float_use(ins: SInst): boolean {
  let k = ins.kind_tag;
  if (k == BINARY) {
    return float_arith(ins.str) || float_cmp(ins.str);
  }
  if (k == UNARY) {
    return float_math(ins.str) || ins.str == "f64_to_i32" || ins.str == "f64_to_i64" || ins.str == "f64_bits" || ins.str == "vsplat";
  }
  return k == TERNARY && (ins.str == "ffma" || ins.str == "ffma32");
}

pub function float_arith(op: string): boolean {
  return op == "fadd" || op == "fsub" || op == "fmul" || op == "fdiv";
}

pub function float_cmp(op: string): boolean {
  return op == "feq" || op == "fne" || op == "flt" || op == "fle" || op == "fgt" || op == "fge";
}

pub function float_math(op: string): boolean {
  return op == "fsqrt" || op == "ffloor" || op == "fceil" || op == "ftrunc" || op == "fabs" || op == "fround" || op == "fneg";
}

function class_order(order: i32[], fl: boolean[]): i32[] {
  let out: i32[] = [];
  for v in order {
    if (!fl[v]) {
      out = out.append(v);
    }
  }
  for v in order {
    if (fl[v]) {
      out = out.append(v);
    }
  }
  return out;
}

function count_false(fl: boolean[]): i32 {
  let n = 0;
  for x in fl {
    if (!x) {
      n += 1;
    }
  }
  return n;
}

pub function regalloc_linear(f: SFunc, nregs: i32, nsaved: i32, abi_reg: i32, abi_fixed_by_div: boolean, no_home: boolean[], pref: i32[], fl: boolean[], nf: i32, nfs: i32): Alloc {
  return regalloc_linear_fixed(f, nregs, nsaved, abi_reg, abi_fixed_by_div, no_home, pref, fl, nf, nfs, ssafixed.none(), [], []);
}

// The call still runs when its result has no reader. Its result needs no
// register or spill slot, and cannot prevent another value from taking one.
function unhomed_call_results(f: SFunc, own no_home: boolean[]): boolean[] {
  while (no_home.len() < f.nvals) {
    no_home = no_home.append(false);
  }
  let uses = use_counts(f);
  for b in f.blocks {
    for ins in b.insts {
      if (inst_is_call(ins) && ins.result >= 0 && uses[ins.result] == 0) {
        no_home = no_home.with(ins.result, true);
      }
    }
  }
  return no_home;
}

pub function regalloc_linear_fixed(f: SFunc, nregs: i32, nsaved: i32, abi_reg: i32, abi_fixed_by_div: boolean, no_home: boolean[], pref: i32[], fl: boolean[], nf: i32, nfs: i32, fixed: ssafixed.Table, cold: i32[], crossing: boolean[]): Alloc {
  return regalloc_linear_fixed_costs(f, nregs, nsaved, abi_reg, abi_fixed_by_div, no_home, pref, fl, nf, nfs, fixed, cold, crossing, [], [], SpillCosts { fold_alu_rhs: false });
}

// A spill definition or normal read needs an extra transfer instruction.
// An x86 ALU instruction can read a right operand from its spill slot.
// The model discounts those reads and keeps the squared-use protection.
pub struct SpillCosts { fold_alu_rhs: boolean }

function phi_count(insts: SInst[]): i32 {
  let count = 0;
  for ins in insts {
    count += if (ins.kind_tag == PHI) { 1 } else { 0 };
  }
  return count;
}

pub function regalloc_linear_fixed_costs(f: SFunc, nregs: i32, nsaved: i32, abi_reg: i32, abi_fixed_by_div: boolean, no_home: boolean[], pref: i32[], fl: boolean[], nf: i32, nfs: i32, fixed: ssafixed.Table, cold: i32[], crossing: boolean[], crossing_all: boolean[], lens: i32[], costs: SpillCosts): Alloc {
  no_home = unhomed_call_results(f, no_home);
  let cold_calls = cold.len() > 0;
  let wish = return_prefs(f, pref, abi_reg);
  let big = 2000000000;
  let lo = __alloc_i32(f.nvals);
  let hi = __alloc_i32(f.nvals);
  let i = 0;
  while (i < f.nvals) {
    lo = lo.with(i, big);
    hi = hi.with(i, -1);
    i += 1;
  }
  let calls: i32[] = [];
  let all_calls: i32[] = [];
  let soft_calls: i32[] = [];
  let abi_cl: i32[] = [];

  let def_pos = __alloc_i32(f.nvals);
  let def_blk = __alloc_i32(f.nvals);
  let call_def = __alloc_i32(f.nvals);
  let reads_mate = __alloc_bool(f.nvals);
  let def_a = __alloc_i32(f.nvals);
  let def_b = __alloc_i32(f.nvals);
  i = 0;
  while (i < f.nvals) {
    def_pos = def_pos.with(i, -1);
    def_blk = def_blk.with(i, -1);
    def_a = def_a.with(i, -1);
    def_b = def_b.with(i, -1);
    i += 1;
  }
  let blk_start: i32[] = [];
  let pos = 0;
  let bi = 0;
  while (bi < f.blocks.len()) {
    let blk = f.blocks[bi];
    blk_start = blk_start.append(pos);
    // The moves of an edge write each phi of the block together, so each
    // phi lives at least to the last phi, even with no read.
    let phi_end = pos + phi_count(blk.insts) - 1;
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      if (ins.result >= 0 && ins.result < lo.len() && pos < lo[ins.result]) {
        lo = lo.with(ins.result, pos);
      }
      let end = if (ins.kind_tag == PHI && phi_end > pos) { phi_end } else { pos };
      if (ins.result >= 0 && ins.result < hi.len() && end > hi[ins.result]) {
        hi = hi.with(ins.result, end);
      }
      if (ins.result >= 0 && ins.result < def_pos.len()) {
        def_pos = def_pos.with(ins.result, pos);
        def_blk = def_blk.with(ins.result, bi);
        if (ins.kind_tag == SELECT) {
          reads_mate = reads_mate.with(ins.result, true);
          def_a = def_a.with(ins.result, ins.args[1]);
          def_b = def_b.with(ins.result, ins.args[2]);
        } else if (ins.kind_tag == PHI || ins.kind_tag == UNARY || ins.kind_tag == CALL || ins.kind_tag == CALL_IND || ins.kind_tag == DYN_DISPATCH || ins.kind_tag == BINARY && shares_operand_home(ins.str)) {
          reads_mate = reads_mate.with(ins.result, true);
          if (ins.kind_tag != PHI && ins.args.len() > 0) {
            def_a = def_a.with(ins.result, ins.args[0]);
          }
          if (ins.kind_tag != PHI && ins.args.len() > 1) {
            def_b = def_b.with(ins.result, ins.args[1]);
          }
        }
      }
      let a = 0;
      while (a < ins.args.len() && ins.kind_tag != PHI) {
        if (ins.args[a] >= 0 && ins.args[a] < lo.len() && pos < lo[ins.args[a]]) {
          lo = lo.with(ins.args[a], pos);
        }
        if (ins.args[a] >= 0 && ins.args[a] < hi.len() && pos > hi[ins.args[a]]) {
          hi = hi.with(ins.args[a], pos);
        }
        a += 1;
      }
      if (inst_is_call(ins) && !never_returns(ins)) {
        if (counted_call(blk, k)) {
          all_calls = all_calls.append(pos);
          let kind = COLD_NONE;
          if (cold_calls) {
            kind = cold[pos];
          }
          if (kind == COLD_NONE) {
            calls = calls.append(pos);
          } else if (kind == COLD_BRANCH) {
            soft_calls = soft_calls.append(pos);
          }
        }
        if (ins.result >= 0 && ins.result < call_def.len()) {
          call_def = call_def.with(ins.result, 1);
        }
      }
      if (abi_fixed_by_div && ins.kind_tag == BINARY && binary_fixes_abi(ins.str)) {
        abi_cl = abi_cl.append(pos);
      }
      pos += 1;
    }
    if (blk.term.kind_tag == TERM_RET) {
      if (blk.term.value >= 0 && blk.term.value < lo.len() && pos < lo[blk.term.value]) {
        lo = lo.with(blk.term.value, pos);
      }
      if (blk.term.value >= 0 && blk.term.value < hi.len() && pos > hi[blk.term.value]) {
        hi = hi.with(blk.term.value, pos);
      }
    } else if (blk.term.kind_tag == TERM_BRIF) {
      if (blk.term.cond >= 0 && blk.term.cond < lo.len() && pos < lo[blk.term.cond]) {
        lo = lo.with(blk.term.cond, pos);
      }
      if (blk.term.cond >= 0 && blk.term.cond < hi.len() && pos > hi[blk.term.cond]) {
        hi = hi.with(blk.term.cond, pos);
      }
    }
    pos += 1;
    bi += 1;
  }
  i = 0;
  while (i < f.nparams && i < f.nvals) {
    if (hi[i] >= 0) {
      lo = lo.with(i, 0);
    }
    i += 1;
  }
  let total_pos = pos;
  ssafixed.validate(fixed, nregs, total_pos);
  let at = block_positions(f);
  for bi in 0..f.blocks.len() {
    let pb = f.blocks[bi];
    for pk in 0..pb.insts.len() {
      let ph = pb.insts[pk];
      if (ph.kind_tag == PHI) {
        for sl in 0..ph.args.len() {
          let upos = blk_start[bi] + pk;
          if (sl < pb.preds.len() && pb.preds[sl] >= 0 && pb.preds[sl] < at.len() && at[pb.preds[sl]] >= 0) {
            let pi = at[pb.preds[sl]];
            upos = blk_start[pi] + f.blocks[pi].insts.len();
          }
          let pa = ph.args[sl];
          if (pa >= 0 && pa < lo.len() && upos < lo[pa]) {
            lo = lo.with(pa, upos);
          }
          if (pa >= 0 && pa < hi.len() && upos > hi[pa]) {
            hi = hi.with(pa, upos);
          }
        }
      }
    }
  }
  i = 0;
  while (i < no_home.len() && i < f.nvals) {
    if (no_home[i]) {
      hi = hi.with(i, -1);
    }
    i += 1;
  }

  hi = extend_loop_invariant_intervals(f, def_pos, hi);
  let cum = calls_before(calls, total_pos);
  let cum_abi = calls_before(abi_cl, total_pos);
  let cum_all = cum;
  let cum_soft = calls_before(soft_calls, total_pos);
  if (cold_calls) {
    cum_all = calls_before(all_calls, total_pos);
  }
  let mates = phi_mates(f, at, def_pos, hi, no_home);
  let bw = weights_from_latches(furthest_latches(f, at));
  let weight = spill_weights(f, at, costs, bw);
  let hard = hard_spans(f, bw, cum, cold, lo, hi, weight, crossing);
  let sole = sole_readers(f);

  let sites = ReadSites { start: [], blk: [], pos: [], succ_a: [], succ_b: [], phi_end: [], nparams: f.nparams };
  let phi_side: boolean[] = [];
  let phi_only: boolean[] = [];
  let phi_none: boolean[] = [];
  let lent_to: boolean[] = [];
  let wanted = MateStarts { start: [], lo: [] };
  let mate_lo = wanted;
  let reg_of = __alloc_i32(f.nvals);
  let shared_with = __alloc_i32(f.nvals);
  for i in 0..f.nvals {
    reg_of = reg_of.with(i, -1);
    shared_with = shared_with.with(i, -1);
  }

  let order = order_by_lo(f.nvals, lo);
  let split = order.len();
  if (fl.len() > 0) {
    order = class_order(order, fl);
    split = count_false(fl);
  }
  let act_val: i32[] = [];
  let act_hi: i32[] = [];
  let act_reg: i32[] = [];
  let free: i32[] = [];
  let r = nregs - 1;
  while (r >= 0) {
    if (!ssafixed.denied(fixed, r)) {
      free = free.append(r);
    }
    r -= 1;
  }
  let free_s: i32[] = [];
  r = nregs + nsaved - 1;
  while (r >= nregs) {
    if (!ssafixed.denied(fixed, r)) {
      free_s = free_s.append(r);
    }
    r -= 1;
  }

  let cbase = 0;
  let sat = nregs;
  let cabi = abi_reg;
  let oi = 0;
  while (oi < order.len()) {
    if (oi == split) {
      cum = cum_all;
      cbase = nregs + nsaved;
      sat = cbase + nf;
      cabi = -1;
      act_val = [];
      act_hi = [];
      act_reg = [];
      free = [];
      r = sat - 1;
      while (r >= cbase) {
        if (!ssafixed.denied(fixed, r)) {
          free = free.append(r);
        }
        r -= 1;
      }
      free_s = [];
      r = sat + nfs - 1;
      while (r >= sat) {
        if (!ssafixed.denied(fixed, r)) {
          free_s = free_s.append(r);
        }
        r -= 1;
      }
    }
    let v = order[oi];
    if (hi[v] < 0) {
      oi += 1;
      continue;
    }
    if (any_below(act_hi, lo[v])) {
      let nv: i32[] = [];
      let nh: i32[] = [];
      let nr: i32[] = [];
      for ai in 0..act_val.len() {
        if (act_hi[ai] < lo[v]) {
          if (act_reg[ai] >= sat) {
            free_s = free_s.append(act_reg[ai]);
          } else {
            free = free.append(act_reg[ai]);
          }
        } else {
          nv = nv.append(act_val[ai]);
          nh = nh.append(act_hi[ai]);
          nr = nr.append(act_reg[ai]);
        }
      }
      act_val = nv;
      act_hi = nh;
      act_reg = nr;
    }

    let mh = mates.hint[v];
    if (mh >= 0 && sole[v] == mh && lo[mh] <= lo[v] && hi[mh] >= 0 && reg_of[mh] == -1) {
      sites = cached_read_sites(f, sites, at, blk_start);
      if (!live_at_def(sites, mh, v, def_blk, def_pos)) {
        oi += 1;
        continue;
      }
    }
    if (mh >= 0 && mates.through[v] && reg_of[mh] == -1 && hi[mh] < lo[v] && !(cold_calls && weight[v] > 4 * weight[mh])) {
      oi += 1;
      continue;
    }
    let ma = mates.alt[v];
    if (ma >= 0 && reg_of[ma] == -1 && lo[ma] <= lo[v] && hi[ma] >= 0) {
      sites = cached_read_sites(f, sites, at, blk_start);
      if (!live_at_def(sites, ma, v, def_blk, def_pos)) {
        oi += 1;
        continue;
      }
    }
    let abi_ok = !spans_call(cum_abi, lo[v], hi[v]);
    let soft = cold_calls && oi < split && spans_call(cum_soft, lo[v], hi[v]) && free_s.len() > 0;
    let keep_caller = spans_hard(hard, crossing_all, oi < split, cum, lo[v], hi[v], v) || soft;
    let placed = false;
    let ci = 0;
    while (ci < 5 && !placed) {
      let h = candidate(mates, def_a, def_b, v, ci);
      ci += 1;
      if (ci == 1 && h == mates.hint[v]) {
        continue;
      }
      if (h == -2) {
        let pr: i32 = -1;
        if (v < wish.len()) {
          pr = wish[v];
        }
        if (!preferred_register_allowed(pr, abi_reg, abi_ok, keep_caller, lo[v], hi[v], fixed)) {
          continue;
        }
        if (index_of_reg(free, pr) >= 0) {
          free = remove_reg(free, pr);
          reg_of = reg_of.with(v, pr);
          act_val = act_val.append(v);
          act_hi = act_hi.append(hi[v]);
          act_reg = act_reg.append(pr);
          placed = true;
          continue;
        }
        let held = index_of_reg(act_reg, pr);
        if (held < 0) {
          continue;
        }
        h = act_val[held];
      }
      if (h < 0 || reg_of[h] < 0) {
        continue;
      }
      let hr = reg_of[h];
      if (call_def[v] == 1 && h != mates.hint[v] && hr != abi_reg) {
        continue;
      }
      if (hr < cbase || keep_caller && hr < sat || hr == cabi && !abi_ok || !ssafixed.allows(fixed, hr, lo[v], hi[v])) {
        continue;
      }
      let fi = index_of_reg(free, hr);
      let fsi = index_of_reg(free_s, hr);
      if (fi >= 0 || fsi >= 0) {
        if (fi >= 0) {
          free = remove_reg(free, hr);
        } else {
          free_s = remove_reg(free_s, hr);
        }
        reg_of = reg_of.with(v, hr);
        shared_with = shared_with.with(v, h);
        act_val = act_val.append(v);
        act_hi = act_hi.append(hi[v]);
        act_reg = act_reg.append(hr);
        placed = true;
        continue;
      }
      let ha = index_of_reg(act_reg, hr);
      if (ha < 0) {
        continue;
      }
      let share = act_hi[ha] == lo[v] && reads_mate[v];
      if (!share && (h == mates.hint[v] && mates.carried[v] || h == mates.alt[v])) {
        sites = cached_read_sites(f, sites, at, blk_start);
        share = chain_dead_at_def(sites, act_val[ha], v, shared_with, lo, hi, def_blk, def_pos);
      }
      if (!share) {
        continue;
      }
      let top = later_interval_end(act_hi[ha], hi[v]);
      let holder = act_val[ha];
      act_val = drop_active_at(act_val, ha);
      act_hi = drop_active_at(act_hi, ha);
      act_reg = drop_active_at(act_reg, ha);
      reg_of = reg_of.with(v, hr);
      shared_with = shared_with.with(v, holder);
      act_val = act_val.append(v);
      act_hi = act_hi.append(top);
      act_reg = act_reg.append(hr);
      placed = true;
    }
    if (placed) {
      oi += 1;
      continue;
    }
    let pick = pick_fixed_reg(free, cabi, call_def[v] == 1 && abi_ok, abi_ok, fixed, lo[v], hi[v]);
    let from_caller = !spans_hard(hard, crossing_all, oi < split, cum, lo[v], hi[v], v) && pick >= 0 && !soft;
    from_caller = from_caller || cold_caller(free_s.len(), cold_calls && oi < split, pick, cum, lo[v], hi[v]);
    // A save around a call restores its holder, so a lent interval of a caller
    // register holds none. A call keeps a saved register.
    let lends_caller = !from_caller && oi < split && !keep_caller && !spans_call(cum_all, lo[v] - 1, hi[v] + 1);
    let lends_saved = !from_caller && oi < split && free_s.len() == 0 && held_until(act_reg, act_hi, sat, sat + nsaved, hi[v]);
    if (lends_caller || lends_saved) {
      sites = cached_read_sites(f, sites, at, blk_start);
      if (phi_side.len() == 0) {
        phi_side = phi_values(f);
      }
      let reads = defining_args(f, v, def_blk, def_pos, blk_start);
      let lend: i32 = -1;
      if (lends_caller) {
        let caller = Lender { cbase: cbase, sat: sat, cabi: cabi, abi_ok: abi_ok, phi: phi_side, keeps: phi_side, wanted: wanted, first: true };
        if let Some(ai) = borrowable(sites, v, act_val, act_reg, act_hi, caller, Reads { all: reads, a: -1, b: -1 }, fixed, shared_with, lo, hi, def_blk, def_pos) {
          lend = ai;
        }
      }
      if (lend < 0 && lends_saved) {
        if (phi_only.len() == 0) {
          phi_only = phi_results(f);
          phi_none = __alloc_bool(f.nvals + 1);
          mate_lo = mate_starts(mates, def_a, def_b, lo, hi, f.nvals);
        }
        let saved = Lender { cbase: sat, sat: sat + nsaved, cabi: -1, abi_ok: true, phi: phi_none, keeps: phi_only, wanted: mate_lo, first: false };
        if let Some(ai) = borrowable(sites, v, act_val, act_reg, act_hi, saved, Reads { all: reads, a: def_a[v], b: def_b[v] }, fixed, shared_with, lo, hi, def_blk, def_pos) {
          lend = ai;
        }
      }
      if (lend >= 0) {
        let top = later_interval_end(act_hi[lend], hi[v]);
        let lent = act_reg[lend];
        let holder = act_val[lend];
        act_val = drop_active_at(act_val, lend);
        act_hi = drop_active_at(act_hi, lend);
        act_reg = drop_active_at(act_reg, lend);
        reg_of = reg_of.with(v, lent);
        shared_with = shared_with.with(v, holder);
        if (lent_to.len() == 0) {
          lent_to = __alloc_bool(f.nvals);
        }
        lent_to = lent_to.with(v, true);
        act_val = act_val.append(v);
        act_hi = act_hi.append(top);
        act_reg = act_reg.append(lent);
        oi += 1;
        continue;
      }
    }
    if (!from_caller && free_s.len() == 0) {
      let need_saved = spans_hard(hard, crossing_all, oi < split, cum, lo[v], hi[v], v);
      let fa = cheapest_active(act_val, act_reg, act_hi, shared_with, lent_to, weight, lo, hi, lens, lo[v], sat, need_saved, forbidden_abi(cabi, abi_ok), fixed, hi[v]);
      let cmp = 0;
      if (fa >= 0) {
        let fw = chain_weight(act_val[fa], shared_with, lent_to, weight, hi, lo[v]);
        cmp = cmp_spill_cost(fw, chain_len(act_val[fa], act_hi[fa], shared_with, lent_to, lo, hi, lens, lo[v]), weight[v], live_len(v, lo, hi, lens));
      }
      if (fa >= 0 && (cmp < 0 || cmp == 0 && act_hi[fa] > hi[v])) {
        let taken = act_reg[fa];
        let ev = act_val[fa];
        let first = true;
        while (ev >= 0) {
          if (first && heads(ev, lent_to, hi, lo[v]) || still_holds(ev, hi, lo[v])) {
            reg_of = reg_of.with(ev, -1);
          }
          first = false;
          let nx = shared_with[ev];
          shared_with = shared_with.with(ev, -1);
          ev = nx;
        }
        act_val = drop_active_at(act_val, fa);
        act_hi = drop_active_at(act_hi, fa);
        act_reg = drop_active_at(act_reg, fa);
        reg_of = reg_of.with(v, taken);
        act_val = act_val.append(v);
        act_hi = act_hi.append(hi[v]);
        act_reg = act_reg.append(taken);
      } else {
        reg_of = reg_of.with(v, -1);
      }
    } else {
      let reg = 0;
      if (from_caller) {
        reg = pick;
        free = remove_reg(free, reg);
      } else {
        reg = free_s[free_s.len() - 1];
        free_s = util.drop_last_i32(free_s);
      }
      reg_of = reg_of.with(v, reg);
      act_val = act_val.append(v);
      act_hi = act_hi.append(hi[v]);
      act_reg = act_reg.append(reg);
    }
    oi += 1;
  }
  if (nfs > 0) {
    reg_of = lanes_off_saved(f, reg_of, nregs + nsaved + nf);
  }
  reg_of = spilled_phi_cycles(f, reg_of);
  let shape = SlotShape { at: at, blk_start: blk_start, def_blk: def_blk, def_pos: def_pos, def_a: def_a, def_b: def_b };
  if (sites.start.len() == 0 && spilled_mates(reg_of, def_pos, mates.hint)) {
    sites = read_sites(f, at, blk_start);
  }
  return Alloc { reg_of: assign_spill_slots(f, shape, lo, hi, reg_of, slot_hints(f, sites, def_blk, def_pos, reg_of, mates), sites), def_pos: def_pos, lo: lo, hi: hi, cold: cold };
}

// A phi in a register whose only reads are phis in memory, one of which is
// also its own operand, goes to memory too. A loop that keeps a value in a
// slot then moves it only where it changes, not on each edge of the loop.
pub function spilled_phi_cycles(f: SFunc, reg_of: i32[]): i32[] {
  let other = __alloc_bool(f.nvals);
  let users: i32[][] = [];
  for v in 0..f.nvals {
    users = users.append([]);
  }
  for b in f.blocks {
    for ins in b.insts {
      for a in ins.args {
        if (a >= 0 && a < f.nvals) {
          if (ins.kind_tag == PHI && ins.result >= 0) {
            users = users.with(a, users[a].append(ins.result));
          } else {
            other = other.with(a, true);
          }
        }
      }
    }
    let t = term_operand(b.term);
    if (t >= 0 && t < f.nvals) {
      other = other.with(t, true);
    }
  }
  let out = reg_of;
  for b in f.blocks {
    for ins in b.insts {
      let v = ins.result;
      if (ins.kind_tag == PHI && v >= 0 && v < f.nvals && reg_of[v] >= 0 && !other[v] && users[v].len() > 0 && memory_phis(users[v], reg_of) && util.index_of_i32(ins.args, users[v][0]) >= 0) {
        out = out.with(v, -1);
      }
    }
  }
  return out;
}

function memory_phis(phis: i32[], reg_of: i32[]): boolean {
  for h in phis {
    if (reg_of[h] != -1) {
      return false;
    }
  }
  return true;
}

function lanes_off_saved(f: SFunc, reg_of: i32[], saved_from: i32): i32[] {
  let lanes = lane_values(f);
  for v in 0..lanes.len() {
    if (lanes[v] && reg_of[v] >= saved_from) {
      reg_of = reg_of.with(v, -1);
    }
  }
  return reg_of;
}

struct SlotHints { hint: i32[], take_over: boolean[] }

function slot_hints(f: SFunc, sites: ReadSites, def_blk: i32[], def_pos: i32[], reg_of: i32[], mates: Mates): SlotHints {
  let hint: i32[] = [];
  let take_over: boolean[] = [];
  for i in 0..f.nvals {
    let sh = mates.hint[i];
    if (reg_of[i] >= 0 || sh < 0 || reg_of[sh] >= 0) {
      sh = -1;
    }
    let free = sh >= 0 && def_pos[sh] >= 0 && !live_at_def(sites, sh, i, def_blk, def_pos);
    if (sh >= 0 && mates.carried[i] && !free) {
      sh = -1;
    }
    hint = hint.append(sh);
    take_over = take_over.append(free);
  }
  return SlotHints { hint: hint, take_over: take_over };
}

function spilled_mates(reg_of: i32[], def_pos: i32[], hint: i32[]): boolean {
  for i in 0..reg_of.len() {
    let sh = hint[i];
    if (reg_of[i] < 0 && sh >= 0 && reg_of[sh] < 0 && def_pos[sh] >= 0) {
      return true;
    }
  }
  return false;
}

function return_prefs(f: SFunc, pref: i32[], abi_reg: i32): i32[] {
  let out = pref;
  while (out.len() < f.nvals) {
    out = out.append(-1);
  }
  for blk in f.blocks {
    let v = blk.term.value;
    if (blk.term.kind_tag == TERM_RET && v >= 0 && v < out.len() && out[v] < 0) {
      out = out.with(v, abi_reg);
    }
  }
  let bi = f.blocks.len() - 1;
  while (bi >= 0) {
    for ins in f.blocks[bi].insts {
      if (ins.kind_tag == PHI && ins.result >= 0 && ins.result < out.len() && out[ins.result] >= 0) {
        for a in ins.args {
          if (a >= 0 && a < out.len() && out[a] < 0) {
            out = out.with(a, out[ins.result]);
          }
        }
      }
    }
    bi -= 1;
  }
  return out;
}

function sole_readers(f: SFunc): i32[] {
  let out = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      for a in ins.args {
        if (a >= 0 && a < f.nvals && out[a] != ins.result) {
          if (out[a] == -1 && ins.result >= 0) {
            out = out.with(a, ins.result);
          } else {
            out = out.with(a, -2);
          }
        }
      }
    }
    let tv: i32 = -1;
    if (blk.term.kind_tag == TERM_RET) {
      tv = blk.term.value;
    }
    if (blk.term.kind_tag == TERM_BRIF) {
      tv = blk.term.cond;
    }
    if (tv >= 0 && tv < f.nvals) {
      out = out.with(tv, -2);
    }
  }
  return out;
}

function spill_weights(f: SFunc, at: i32[], costs: SpillCosts, bw: i32[]): i32[] {
  let w = __alloc_i32(f.nvals);
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals) {
        w = w.with(ins.result, w[ins.result] + bw[bi]);
      }
      for sl in 0..ins.args.len() {
        let a = ins.args[sl];
        let rb = bi;
        if (ins.kind_tag == PHI) {
          rb = -1;
          if (sl < blk.preds.len()) {
            rb = position_of(at, blk.preds[sl]);
          }
        }
        if (a >= 0 && a < f.nvals && rb >= 0) {
          let cost = 1;
          if (costs.fold_alu_rhs && ins.kind_tag == BINARY && sl == 1 && folds_spill_rhs(ins.str)) {
            cost = 0;
          }
          w = w.with(a, w[a] + bw[rb] * cost);
        }
      }
    }
    let tv: i32 = -1;
    if (blk.term.kind_tag == TERM_RET) {
      tv = blk.term.value;
    }
    if (blk.term.kind_tag == TERM_BRIF) {
      tv = blk.term.cond;
    }
    if (tv >= 0 && tv < f.nvals) {
      w = w.with(tv, w[tv] + bw[bi]);
    }
  }
  return w;
}

function folds_spill_rhs(op: string): boolean {
  return op == "add" || op == "sub" || op == "and" || op == "or" || op == "xor";
}

function kept_for_mate(wanted_by: i32[], reg_of: i32[], holder: i32, v: i32): boolean {
  let w = wanted_by[holder];
  return w >= 0 && w != v && reg_of[w] == -1;
}

// The weight of the reads and the writes of the values that `reg_of` keeps
// in a frame slot.
pub function spill_cost(f: SFunc, reg_of: i32[], costs: SpillCosts): i32 {
  let at = block_positions(f);
  let bw = weights_from_latches(furthest_latches(f, at));
  let w = spill_weights(f, at, costs, bw);
  let total = 0;
  for v in 0..f.nvals {
    if (v < reg_of.len() && reg_of[v] <= -2) {
      total += w[v];
    }
  }
  return total;
}

// A parameter used as an array base inside and outside a nested loop can
// spill for the whole function. Give its reads inside the loop a separate
// value. The allocator can then split that value around an inner loop.
pub function loop_index_copy(f: SFunc, reg_of: i32[]): SFunc {
  if (f.nparams == 0 || f.blocks.len() < 3) {
    return f;
  }
  let spilled = false;
  for p in 0..f.nparams {
    spilled = spilled || reg_of[p] < -1;
  }
  if (!spilled) {
    return f;
  }
  // Require three read blocks inside the loop and one outside. Two inside
  // did not cover the cost of the split on the checker workload.
  let sites: i32[][] = [];
  let repeated = false;
  for bi in 0..f.blocks.len() {
    for ins in f.blocks[bi].insts {
      if (ins.kind_tag != ARR_AT) {
        continue;
      }
      let p = ins.args[0];
      if (p < 0 || p >= f.nparams || reg_of[p] >= -1) {
        continue;
      }
      if (sites.len() == 0) {
        for i in 0..f.nparams {
          sites = sites.append([]);
        }
      }
      let bs = sites[p];
      if (bs.len() == 0 || bs[bs.len() - 1] != bi) {
        sites = sites.with(p, bs.append(bi));
        repeated = repeated || sites[p].len() >= 4;
      }
    }
  }
  if (!repeated) {
    return f;
  }
  let at = block_positions(f);
  let last = furthest_latches(f, at);
  let head = -1;
  let param = -1;
  let best = 2;
  let outer_last = -1;
  for h in 0..last.len() {
    if (last[h] <= h) {
      continue;
    }
    if (last[h] > outer_last) {
      outer_last = last[h];
      continue;
    }
    for p in 0..sites.len() {
      let count = 0;
      for b in sites[p] {
        if (h <= b && b <= last[h]) {
          count += 1;
        }
      }
      if (count > best && count < sites[p].len()) {
        head = h;
        param = p;
        best = count;
      }
    }
  }
  if (head < 0) {
    return f;
  }
  return copy_loop_index(f, at, head, last[head], param, sites[param]);
}

function copy_loop_index(f: SFunc, at: i32[], head: i32, last: i32, param: i32, sites: i32[]): SFunc {
  let idom = immediate_dominators(f, at);
  let pre = idom[head];
  if (pre < 0 || pre == head || f.blocks[pre].term.kind_tag != TERM_BR || f.blocks[pre].term.target != f.blocks[head].id) {
    return f;
  }
  for id in f.blocks[head].preds {
    let p = position_of(at, id);
    if (p < 0 || p != pre && !dominates(idom, head, p)) {
      return f;
    }
  }
  for b in sites {
    if (b >= head && b <= last && !dominates(idom, head, b)) {
      return f;
    }
  }
  let blocks = f.blocks;
  let source = blocks[pre];
  let copy = SInst { kind_tag: COPY, result: f.nvals, args: [param], imm: 0, str: "" };
  blocks = blocks.with(pre, SBlock { ...source, insts: source.insts.append(copy) });
  for b in sites {
    if (b < head || b > last) {
      continue;
    }
    let blk = blocks[b];
    let insts = blk.insts;
    for k in 0..insts.len() {
      let ins = insts[k];
      if (ins.kind_tag == ARR_AT && ins.args[0] == param) {
        insts = insts.with(k, SInst { ...ins, args: ins.args.with(0, f.nvals) });
      }
    }
    blocks = blocks.with(b, SBlock { ...blk, insts: insts });
  }
  return SFunc { ...f, blocks: blocks, nvals: f.nvals + 1 };
}

// A function with values split around inner loops, and the weight of the
// stores and the loads that the split adds.
pub struct LoopSplit { f: SFunc, cost: i32 }

// One split: the value, the block before the loop, the head and the last
// block of the loop, the head and the last block of the inner loop, the
// block after the inner loop that loads the value again, and whether the
// loop reads the value before the inner loop.
struct SplitPlan { v: i32, pre: i32, head: i32, last: i32, inner: i32, inner_last: i32, after: i32, early: boolean }

// A value in a frame slot that a loop reads, and that an inner loop of it
// carries with no read, can keep a register in the rest of the loop. One
// store before the loop puts it in a frame cell. A load after the inner
// loop takes it back, and a phi at the head of the loop joins the two. The
// allocator gives each value one interval, so none of these values is live
// in the inner loop.
pub function split_spilled(f: SFunc, reg_of: i32[], fl: boolean[]): LoopSplit {
  // A split needs a preheader, two loop headers, and two distinct latches.
  if (f.blocks.len() < 5 || !any_below(reg_of, -1)) {
    return LoopSplit { f: f, cost: 0 };
  }
  let at = block_positions(f);
  let latch = furthest_latches(f, at);
  let loops: i32[] = [];
  let furthest = -1;
  let nested = false;
  for h in 0..latch.len() {
    let end = latch[h];
    if (end > h) {
      loops = loops.append(h);
      if (end < furthest) {
        nested = true;
      } else {
        furthest = end;
      }
    }
  }
  if (!nested) {
    return LoopSplit { f: f, cost: 0 };
  }
  return split_spilled_in_loops(f, reg_of, fl, at, latch, loops);
}

function split_spilled_in_loops(f: SFunc, reg_of: i32[], fl: boolean[], at: i32[], latch: i32[], loops: i32[]): LoopSplit {
  let none = LoopSplit { f: f, cost: 0 };
  let slot = util.minus_ones(f.nvals);
  let cands: i32[] = [];
  for v in 0..f.nvals {
    if (v < reg_of.len() && reg_of[v] <= -2 && !(v < fl.len() && fl[v])) {
      slot = slot.with(v, cands.len());
      cands = cands.append(v);
    }
  }
  if (cands.len() == 0) {
    return none;
  }
  let uses: i32[][] = cands.map((v: i32): i32[] => []);
  let def_at = util.minus_ones(cands.len());
  let in_phi = __alloc_bool(cands.len());
  let cells = 0;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    for ins in blk.insts {
      if (ins.kind_tag == FRAME_CELL && cell_number(ins) >= cells) {
        cells = cell_number(ins) + 1;
      }
      if (ins.result >= 0 && ins.result < f.nvals && slot[ins.result] >= 0) {
        def_at = def_at.with(slot[ins.result], bi);
      }
      for a in ins.args {
        if (a >= 0 && a < f.nvals && slot[a] >= 0) {
          if (ins.kind_tag == PHI) {
            in_phi = in_phi.with(slot[a], true);
          } else {
            uses = uses.with(slot[a], uses[slot[a]].append(bi));
          }
        }
      }
    }
    let t = term_use(blk.term);
    if (t >= 0 && t < f.nvals && slot[t] >= 0) {
      uses = uses.with(slot[t], uses[slot[t]].append(bi));
    }
  }
  let idom = immediate_dominators(f, at);
  let plans: SplitPlan[] = [];
  for c in 0..cands.len() {
    if (in_phi[c] || def_at[c] < 0 || uses[c].len() == 0) {
      continue;
    }
    if let Some(p) = split_plan(f, at, idom, latch, loops, cands[c], def_at[c], uses[c]) {
      plans = plans.append(p);
    }
  }
  if (plans.len() == 0) {
    return none;
  }
  return split_by(f, at, idom, plans, cells, weights_from_latches(latch));
}

function split_plan(f: SFunc, at: i32[], idom: i32[], latch: i32[], loops: i32[], v: i32, def: i32, uses: i32[]): Option[SplitPlan] {
  let lo = uses[0];
  let hi = uses[0];
  for u in uses {
    lo = if (u < lo) { u } else { lo };
    hi = if (u > hi) { u } else { hi };
  }
  let head = -1;
  for h in loops {
    if (h > def && h <= lo && hi <= latch[h] && h > head) {
      head = h;
    }
  }
  if (head < 0) {
    return None;
  }
  let last = latch[head];
  let pre = -1;
  for p in f.blocks[head].preds {
    let pb = position_of(at, p);
    if (pb < head) {
      if (pre >= 0) {
        return None;
      }
      pre = pb;
    }
  }
  if (pre < 0 || !dominated_by(idom, pre, def)) {
    return None;
  }
  for inner in loops {
    let inner_last = latch[inner];
    if (inner <= head || inner_last >= last || uses.filter((u: i32): boolean => u >= inner && u <= inner_last).len() > 0) {
      continue;
    }
    // The load comes before each later read. When the loop reads the value
    // before the inner loop, a phi at the head joins it, so the load also
    // comes before each back edge after the inner loop.
    let early = uses.filter((u: i32): boolean => u < inner).len() > 0;
    let later = uses.filter((u: i32): boolean => u > inner_last);
    let joins = true;
    for p in f.blocks[head].preds {
      let pb = position_of(at, p);
      if (early && pb > inner_last) {
        later = later.append(pb);
      } else if (early && pb >= inner) {
        joins = false;
      }
    }
    if (!joins) {
      continue;
    }
    for b in inner_last + 1..last + 1 {
      if (later.filter((u: i32): boolean => u < b || !dominated_by(idom, u, b)).len() == 0) {
        return checked_split(idom, SplitPlan { v: v, pre: pre, head: head, last: last, inner: inner, inner_last: inner_last, after: b, early: early });
      }
    }
  }
  return None;
}

// A second entry into the loop can bypass a definition introduced by the
// split. The store must dominate the reload. Before the inner loop, the
// header phi must dominate the blocks in which it replaces the old value.
function checked_split(idom: i32[], p: SplitPlan): Option[SplitPlan] {
  if (!dominates(idom, p.pre, p.after)) {
    return None;
  }
  if (p.early) {
    for b in p.head + 1..p.inner {
      if (!dominates(idom, p.head, b)) {
        return None;
      }
    }
  }
  return Some(p);
}

// Whether the block at position `d` dominates the block at position `b`.
function dominated_by(idom: i32[], b: i32, d: i32): boolean {
  let x = b;
  for step in 0..idom.len() {
    if (x == d) {
      return true;
    }
    if (x < 0 || idom[x] == x) {
      return false;
    }
    x = idom[x];
  }
  return false;
}

function split_by(f: SFunc, at: i32[], idom: i32[], plans: SplitPlan[], cells: i32, weights: i32[]): LoopSplit {
  let made: i32[] = [];
  let blocks = f.blocks;
  let cost = 0;
  let cold = cold_blocks(f);
  for k in 0..plans.len() {
    let p = plans[k];
    let cell = cells + k;
    let exit = p.after;
    let stored = f.nvals + made.len();
    let wrote = stored + 1;
    let addr = stored + 2;
    let back = stored + 3;
    made = made.concat([stored, wrote, addr, back]);
    // A phi with no read could share a register with another phi of the
    // head, so the head gets one only when the loop reads it.
    let head_v = -1;
    if (p.early) {
      head_v = f.nvals + made.len();
      made = made.append(head_v);
    }
    let pre = blocks[p.pre];
    blocks = blocks.with(p.pre, SBlock { ...pre, insts: pre.insts.append(frame_cell(stored, cell, 0)).append(SInst { kind_tag: ST_AT, result: wrote, args: [stored, p.v], imm: 0, str: "" }) });
    cost += weights[p.pre] + (if (cold[exit]) { 1 } else { weights[exit] });
    // The value in each block of the loop: the phi before the inner loop,
    // and the load in each block that the load dominates. Other blocks
    // after the inner loop do not read the value.
    let cur = util.minus_ones(p.last + 1);
    for b in p.head..p.last + 1 {
      if (b < p.inner) {
        cur = cur.with(b, head_v);
      } else if (b > p.inner_last && dominated_by(idom, b, exit)) {
        cur = cur.with(b, back);
      }
    }
    if (p.early) {
      let h = blocks[p.head];
      let head_args = h.preds.map((id: i32): i32 => if (position_of(at, id) < p.head) { p.v } else if (position_of(at, id) < p.inner) { head_v } else { back });
      blocks = blocks.with(p.head, SBlock { ...h, insts: [SInst { kind_tag: PHI, result: head_v, args: head_args, imm: 0, str: "" }].concat(h.insts) });
    }
    let e = blocks[exit];
    let phis = e.insts.filter((ins: SInst): boolean => ins.kind_tag == PHI);
    let rest = e.insts.filter((ins: SInst): boolean => ins.kind_tag != PHI);
    blocks = blocks.with(exit, SBlock { ...e, insts: phis.append(frame_cell(addr, cell, 0)).append(SInst { kind_tag: LD_AT, result: back, args: [addr], imm: 0, str: "" }).concat(rest) });
    for b in p.head..p.last + 1 {
      if (cur[b] >= 0) {
        blocks = blocks.with(b, renamed_in(blocks[b], p.v, cur[b], head_v));
      }
    }
  }
  return LoopSplit { f: SFunc { ...f, blocks: blocks, nvals: f.nvals + made.len() }, cost: cost };
}

// The block with each read of `from` reading `to`, except in the phi that
// gives `keep`.
function renamed_in(b: SBlock, from: i32, to: i32, keep: i32): SBlock {
  let insts: SInst[] = [];
  for ins in b.insts {
    if (ins.result == keep) {
      insts = insts.append(ins);
    } else {
      insts = insts.append(SInst { ...ins, args: ins.args.map((a: i32): i32 => if (a == from) { to } else { a }) });
    }
  }
  let t = b.term;
  if (t.kind_tag == TERM_BRIF && t.cond == from) {
    t = STerm { ...t, cond: to };
  }
  if (t.kind_tag == TERM_RET && t.value == from) {
    t = STerm { ...t, value: to };
  }
  return SBlock { ...b, insts: insts, term: t };
}

pub function spill_code(slot: i32): i32 {
  return -2 - slot;
}

pub function spill_slot(code: i32): i32 {
  return -2 - code;
}

// One line per value with a home: its interval, its spill weight and the
// register index or frame slot it took. FERN_DEBUG_SSA_ALLOC=<function> prints it,
// and `*` prints each function.
pub function print_alloc(f: SFunc, a: Alloc): string {
  return print_alloc_costs(f, a, SpillCosts { fold_alu_rhs: false });
}

pub function print_alloc_costs(f: SFunc, a: Alloc, costs: SpillCosts): string {
  let at = block_positions(f);
  let bw = weights_from_latches(furthest_latches(f, at));
  let w = spill_weights(f, at, costs, bw);
  let cold = cold_blocks(f);
  let out = "";
  let start = 0;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    out = out + "  block " + util.i32_to_string(bi) + " id " + util.i32_to_string(blk.id) + " at " + util.i32_to_string(start);
    if (cold[bi]) {
      out += " cold";
    }
    out += "\n";
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      if (inst_is_call(ins)) {
        let kind = COLD_NONE;
        if (start + k < a.cold.len()) {
          kind = a.cold[start + k];
        }
        out = out + "    " + util.i32_to_string(start + k) + ": v" + util.i32_to_string(ins.result) + " " + ins.str + " cold=" + util.i32_to_string(kind) + "\n";
      }
    }
    start = start + blk.insts.len() + 1;
  }
  for v in 0..a.reg_of.len() {
    if (a.hi[v] < 0) {
      continue;
    }
    let home = "reg " + util.i32_to_string(a.reg_of[v]);
    if (a.reg_of[v] == -1) {
      home = "none";
    }
    if (a.reg_of[v] < -1) {
      home = "slot " + util.i32_to_string(spill_slot(a.reg_of[v]));
    }
    out = out + "  v" + util.i32_to_string(v) + " [" + util.i32_to_string(a.lo[v]) + ", " + util.i32_to_string(a.hi[v]) + "] w=" + util.i32_to_string(w[v]) + " " + home + "\n";
  }
  return out;
}

pub function spill_count(reg_of: i32[]): i32 {
  let n = 0;
  for h in reg_of {
    if (h < -1 && spill_slot(h) + 1 > n) {
      n = spill_slot(h) + 1;
    }
  }
  return n;
}

function shares_operand_home(op: string): boolean {
  return int_binary(op);
}

function int_binary(op: string): boolean {
  let ops: string[] = ["add", "sub", "mul", "and", "and_not", "or", "xor", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u", "shl", "shr_s", "shr_u"];
  for o in ops {
    if (o == op) {
      return true;
    }
  }
  return false;
}

struct Mates { hint: i32[], carried: boolean[], alt: i32[], through: boolean[] }

function phi_mates(f: SFunc, at: i32[], def_pos: i32[], hi: i32[], no_home: boolean[]): Mates {
  let hint = util.minus_ones(f.nvals);
  let carried = __alloc_bool(f.nvals);
  let alt = hint;
  let fell = carried;
  let pos = 0;
  let bi = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == PHI && ins.result >= 0 && ins.result < hint.len()) {
        let dying: i32 = -1;
        let outliving: i32 = -1;
        let through: i32 = -1;
        let ai = 0;
        while (ai < ins.args.len()) {
          let a = ins.args[ai];
          ai += 1;
          if (a < 0 || a >= hint.len() || a < no_home.len() && no_home[a]) {
            continue;
          }
          if (def_pos[a] < pos) {
            if (hint[ins.result] < 0) {
              hint = hint.with(ins.result, a);
            }
            if (dying < 0 && hi[a] < pos) {
              dying = a;
            }
            if (hi[a] < pos && ai - 1 < blk.preds.len() && position_of(at, blk.preds[ai - 1]) == bi - 1) {
              through = a;
            }
            if (outliving < 0 && hi[a] >= pos) {
              outliving = a;
            }
          } else if (hint[a] < 0) {
            hint = hint.with(a, ins.result);
            carried = carried.with(a, true);
          }
        }
        let h = hint[ins.result];
        if (dying >= 0 && !carried[ins.result] && h >= 0 && hi[h] >= pos) {
          hint = hint.with(ins.result, dying);
        }
        if (through >= 0 && !carried[ins.result]) {
          hint = hint.with(ins.result, through);
          fell = fell.with(ins.result, true);
        }
        if (!carried[ins.result]) {
          alt = alt.with(ins.result, outliving);
        }
      }
      pos += 1;
    }
    pos += 1;
    bi += 1;
  }
  return Mates { hint: hint, carried: carried, alt: alt, through: fell };
}

// live_masks gives, for each position of `at` in ascending order, the
// registers below `nregs` that hold a value live across it. The mask at
// `at[k]` leaves out the value `skip[k]`.
pub function live_masks(alloc: Alloc, nregs: i32, at: i32[], skip: i32[]): i32[] {
  let masks = __alloc_i32(at.len());
  if (at.len() == 0) {
    return masks;
  }
  let order = order_by_lo(alloc.reg_of.len(), alloc.lo);
  let active = __alloc_i32(order.len());
  let na = 0;
  let next = 0;
  for k in 0..at.len() {
    let p = at[k];
    while (next < order.len() && alloc.lo[order[next]] < p) {
      let v = order[next];
      let r = alloc.reg_of[v];
      if (r >= 0 && r < nregs) {
        active = active.with(na, v);
        na += 1;
      }
      next += 1;
    }
    let mask = 0;
    let kept = 0;
    for j in 0..na {
      let v = active[j];
      if (alloc.hi[v] > p) {
        active = active.with(kept, v);
        kept += 1;
        if (v != skip[k]) {
          mask = mask | 1 << alloc.reg_of[v];
        }
      }
    }
    na = kept;
    masks = masks.with(k, mask);
  }
  return masks;
}

pub function position_count(f: SFunc): i32 {
  let n = 0;
  for blk in f.blocks {
    n = n + blk.insts.len() + 1;
  }
  return n;
}

pub function block_positions(f: SFunc): i32[] {
  return positions_of(f.blocks);
}

// The index of each block in `blocks`, by block id, and -1 for an id with no block.
pub function positions_of(blocks: SBlock[]): i32[] {
  let top: i32 = -1;
  for blk in blocks {
    if (blk.id > top) {
      top = blk.id;
    }
  }
  let out = util.minus_ones(top + 1);
  for i in 0..blocks.len() {
    let id = blocks[i].id;
    if (id >= 0 && out[id] < 0) {
      out = out.with(id, i);
    }
  }
  return out;
}

// The distinct blocks a terminator can jump to.
pub function successors(t: STerm): i32[] {
  if (t.kind_tag == TERM_BR) {
    return [t.target];
  }
  if (t.kind_tag == TERM_BRIF && t.t == t.f) {
    return [t.t];
  }
  if (t.kind_tag == TERM_BRIF) {
    return [t.t, t.f];
  }
  return [];
}

// The number of distinct blocks a terminator can jump to.
pub function successor_count(t: STerm): i32 {
  if (t.kind_tag == TERM_BR || t.kind_tag == TERM_BRIF && t.t == t.f) {
    return 1;
  }
  if (t.kind_tag == TERM_BRIF) {
    return 2;
  }
  return 0;
}

pub function successor_id(t: STerm, which: i32): i32 {
  if (t.kind_tag == TERM_BR && which == 0) {
    return t.target;
  }
  if (t.kind_tag == TERM_BRIF) {
    if (which == 0) {
      return t.t;
    }
    if (which == 1) {
      return t.f;
    }
  }
  return -1;
}

function distinct_successor_position(at: i32[], t: STerm, which: i32): i32 {
  let id = successor_id(t, which);
  if (id < 0 || which == 1 && id == t.t) {
    return -1;
  }
  return position_of(at, id);
}

pub function position_of(at: i32[], id: i32): i32 {
  if (id < 0 || id >= at.len()) {
    return -1;
  }
  return at[id];
}

pub function reads_value(ins: SInst, v: i32): boolean {
  for a in ins.args {
    if (a == v) {
      return true;
    }
  }
  return false;
}

pub function term_reads_value(t: STerm, v: i32): boolean {
  if (t.kind_tag == TERM_RET) {
    return t.value == v;
  }
  if (t.kind_tag == TERM_BRIF) {
    return t.cond == v;
  }
  return false;
}

function index_of_reg(a: i32[], x: i32): i32 {
  for i in 0..a.len() {
    if (a[i] == x) {
      return i;
    }
  }
  return -1;
}

function marked(marks: boolean[], v: i32): boolean {
  return v >= 0 && v < marks.len() && marks[v];
}

function unmarked_or_none(v: i32, marks: boolean[]): i32 {
  if (marked(marks, v)) {
    return -1;
  }
  return v;
}

function unmarked(vs: i32[], marks: boolean[]): i32[] {
  if (marks.len() == 0) {
    return vs;
  }
  let out: i32[] = [];
  for v in vs {
    if (!marked(marks, v)) {
      out = out.append(v);
    }
  }
  return out;
}

struct PairSlots { slot_end: i32[], holder: i32[], occupants: i32[][] }

function even_pair(t: PairSlots, p: i32, v: i32): PairSlots {
  if (p % 2 == 0) {
    return t;
  }
  return PairSlots { slot_end: t.slot_end.append(2147483647), holder: t.holder.append(v), occupants: t.occupants.append([v]) };
}

function take_pair(t: PairSlots, p: i32, end: i32, v: i32): PairSlots {
  for u in p..=p + 1 {
    if (u == t.slot_end.len()) {
      t = PairSlots { slot_end: t.slot_end.append(end), holder: t.holder.append(v), occupants: t.occupants.append([v]) };
    } else {
      t = PairSlots { slot_end: t.slot_end.with(u, end), holder: t.holder.with(u, v), occupants: t.occupants.with(u, [v]) };
    }
  }
  return t;
}

function assign_spill_slots(f: SFunc, shape: SlotShape, lo: i32[], hi: i32[], reg_of: i32[], hints: SlotHints, given: ReadSites): i32[] {
  let def_pos = shape.def_pos;
  let from = spill_starts(lo, def_pos);
  let wanted_by = mates_wanted(hi, reg_of, hints.hint);
  let lanes = lane_values(f);
  let slot_end: i32[] = [];
  let holder: i32[] = [];
  let occupants: i32[][] = [];
  let sites = given;
  let built = given.start.len() > 0;
  let live = no_spill_live();
  let pairs: i32[] = [];
  for v in order_by_lo(reg_of.len(), from) {
    if (hi[v] < 0 || reg_of[v] >= 0) {
      continue;
    }
    if (marked(lanes, v)) {
      let p = free_pair(slot_end, holder, wanted_by, reg_of, pairs, from[v], v);
      let t = even_pair(PairSlots { slot_end: slot_end, holder: holder, occupants: occupants }, p, v);
      p = p + t.slot_end.len() - slot_end.len();
      if (p == t.slot_end.len()) {
        pairs = pairs.append(p);
      }
      let pair = take_pair(t, p, hi[v], v);
      slot_end = pair.slot_end;
      holder = pair.holder;
      occupants = pair.occupants;
      reg_of = reg_of.with(v, spill_code(p));
      continue;
    }
    let ends = closed_pairs(slot_end, pairs);
    let h = unmarked_or_none(hints.hint[v], lanes);
    let s = hinted_slot(ends, holder, reg_of, h, from[v], hints.take_over[v]);
    if (s < 0 && def_pos[v] >= 0) {
      let reads = unmarked(slot_operands(f, shape, reg_of, v), lanes);
      if (h >= 0 && reg_of[h] < -1) {
        let mate_first: i32[] = [h];
        for r in reads {
          mate_first = mate_first.append(r);
        }
        reads = mate_first;
      }
      if (reads.len() > 0 && !built) {
        sites = read_sites(f, shape.at, shape.blk_start);
        built = true;
      }
      if (reads.len() > 0 && live.words == 0) {
        live = spill_live(sites, shape.def_blk, spilled_values(reg_of, hi), reg_of.len());
      }
      s = path_slot(sites, live, shape, reads, ends, holder, occupants, wanted_by, reg_of, hi, from[v], v);
    }
    if (s < 0) {
      s = free_slot(ends, holder, wanted_by, reg_of, from[v], v);
    }
    let end = hi[v];
    if (s < slot_end.len() && slot_end[s] > end) {
      end = slot_end[s];
    }
    if (s == slot_end.len()) {
      slot_end = slot_end.append(end);
      holder = holder.append(v);
      occupants = occupants.append([v]);
    } else {
      slot_end = slot_end.with(s, end);
      holder = holder.with(s, v);
      occupants = occupants.with(s, still_in(occupants[s], hi, from[v]).append(v));
    }
    reg_of = reg_of.with(v, spill_code(s));
  }
  return reg_of;
}

function spilled_values(reg_of: i32[], hi: i32[]): i32[] {
  let out: i32[] = [];
  for v in 0..reg_of.len() {
    if (hi[v] >= 0 && reg_of[v] < 0) {
      out = out.append(v);
    }
  }
  return out;
}

struct SlotShape { at: i32[], blk_start: i32[], def_blk: i32[], def_pos: i32[], def_a: i32[], def_b: i32[] }

function slot_operands(f: SFunc, shape: SlotShape, reg_of: i32[], v: i32): i32[] {
  let out: i32[] = [];
  let bi = shape.def_blk[v];
  let ins = f.blocks[bi].insts[shape.def_pos[v] - shape.blk_start[bi]];
  let cands: i32[] = [shape.def_a[v], shape.def_b[v]];
  if (ins.kind_tag == PHI) {
    cands = ins.args;
  }
  for c in cands {
    if (c >= 0 && reg_of[c] < -1) {
      out = out.append(c);
    }
  }
  return out;
}

function path_slot(sites: ReadSites, live: SpillLive, shape: SlotShape, reads: i32[], slot_end: i32[], holder: i32[], occupants: i32[][], wanted_by: i32[], reg_of: i32[], hi: i32[], from: i32, v: i32): i32 {
  for c in reads {
    let cs = spill_slot(reg_of[c]);
    let ok = true;
    for w in occupants[cs] {
      if (ok && hi[w] >= from && (spill_live_at(live, sites, w, v, shape.def_blk, shape.def_pos) || shape.def_pos[w] >= 0 && spill_live_at(live, sites, v, w, shape.def_blk, shape.def_pos))) {
        ok = false;
      }
    }
    if (ok && (slot_end[cs] >= from || !kept_for_mate(wanted_by, reg_of, holder[cs], v))) {
      return cs;
    }
  }
  return -1;
}

function still_in(occ: i32[], hi: i32[], from: i32): i32[] {
  let out: i32[] = [];
  for w in occ {
    if (hi[w] >= from) {
      out = out.append(w);
    }
  }
  return out;
}

struct ReadSites { start: i32[], blk: i32[], pos: i32[], succ_a: i32[], succ_b: i32[], phi_end: i32[], nparams: i32 }

function cached_read_sites(f: SFunc, own sites: ReadSites, at: i32[], blk_start: i32[]): ReadSites {
  if (sites.start.len() == 0) {
    return read_sites(f, at, blk_start);
  }
  return sites;
}

function later_interval_end(a: i32, b: i32): i32 {
  if (b > a) {
    return b;
  }
  return a;
}

function read_sites(f: SFunc, at: i32[], blk_start: i32[]): ReadSites {
  let count = __alloc_i32(f.nvals + 1);
  let succ_a = __alloc_i32(f.blocks.len());
  let succ_b = __alloc_i32(f.blocks.len());
  let phi_end: i32[] = [];
  let bi = 0;
  while (bi < f.blocks.len()) {
    let t = f.blocks[bi].term;
    succ_a = succ_a.with(bi, distinct_successor_position(at, t, 0));
    succ_b = succ_b.with(bi, distinct_successor_position(at, t, 1));
    let end = 0;
    let k = 0;
    while (k < f.blocks[bi].insts.len()) {
      if (f.blocks[bi].insts[k].kind_tag == PHI) {
        end = k + 1;
      }
      k += 1;
    }
    phi_end = phi_end.append(blk_start[bi] + end);
    bi += 1;
  }
  let pass = 0;
  let start: i32[] = [];
  let blk: i32[] = [];
  let pos: i32[] = [];
  while (pass < 2) {
    let fill = start;
    for bi in 0..f.blocks.len() {
      let b = f.blocks[bi];
      for k in 0..b.insts.len() {
        let ins = b.insts[k];
        for sl in 0..ins.args.len() {
          let a = ins.args[sl];
          let rb = bi;
          let rp = blk_start[bi] + k;
          if (ins.kind_tag == PHI) {
            rb = -1;
            if (sl < b.preds.len()) {
              rb = position_of(at, b.preds[sl]);
            }
            if (rb >= 0) {
              rp = blk_start[rb] + f.blocks[rb].insts.len();
            }
          }
          if (a >= 0 && a < f.nvals && rb >= 0) {
            if (pass == 0) {
              count = count.with(a + 1, count[a + 1] + 1);
            } else {
              blk = blk.with(fill[a], rb);
              pos = pos.with(fill[a], rp);
              fill = fill.with(a, fill[a] + 1);
            }
          }
        }
      }
      let tv: i32 = -1;
      if (b.term.kind_tag == TERM_RET) {
        tv = b.term.value;
      }
      if (b.term.kind_tag == TERM_BRIF) {
        tv = b.term.cond;
      }
      if (tv >= 0 && tv < f.nvals) {
        if (pass == 0) {
          count = count.with(tv + 1, count[tv + 1] + 1);
        } else {
          blk = blk.with(fill[tv], bi);
          pos = pos.with(fill[tv], blk_start[bi] + b.insts.len());
          fill = fill.with(tv, fill[tv] + 1);
        }
      }
    }
    if (pass == 0) {
      let v = 1;
      while (v < count.len()) {
        count = count.with(v, count[v] + count[v - 1]);
        v += 1;
      }
      start = count;
      blk = __alloc_i32(count[f.nvals]);
      pos = __alloc_i32(count[f.nvals]);
    }
    pass += 1;
  }
  return ReadSites { start: start, blk: blk, pos: pos, succ_a: succ_a, succ_b: succ_b, phi_end: phi_end, nparams: f.nparams };
}

// phi marks each phi and each value a phi reads: an edge copy writes outside
// the intervals, so those values lend no register. keeps marks the values
// that borrow none.
struct Lender { cbase: i32, sat: i32, cabi: i32, abi_ok: boolean, phi: boolean[], keeps: boolean[], wanted: MateStarts, first: boolean }

// The operands of the definition of a borrower. The emitter lets the result
// share the home of `a` or of `b`, so those two can lend.
struct Reads { all: i32[], a: i32, b: i32 }

function phi_results(f: SFunc): boolean[] {
  let out = __alloc_bool(f.nvals + 1);
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == PHI && ins.result >= 0 && ins.result < f.nvals) {
        out = out.with(ins.result, true);
      }
    }
  }
  return out;
}

function phi_values(f: SFunc): boolean[] {
  let out = __alloc_bool(f.nvals + 1);
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == PHI) {
        if (ins.result >= 0 && ins.result < f.nvals) {
          out = out.with(ins.result, true);
        }
        for a in ins.args {
          if (a >= 0 && a < f.nvals) {
            out = out.with(a, true);
          }
        }
      }
    }
  }
  return out;
}

function defining_args(f: SFunc, v: i32, def_blk: i32[], def_pos: i32[], blk_start: i32[]): i32[] {
  let b = def_blk[v];
  if (b < 0) {
    return [];
  }
  let k = def_pos[v] - blk_start[b];
  if (k < 0 || k >= f.blocks[b].insts.len()) {
    return [];
  }
  return f.blocks[b].insts[k].args;
}

// For each value, the start of each value that can take its register: a
// value that names it as a mate, or whose definition reads it.
struct MateStarts { start: i32[], lo: i32[] }

function mate_starts(mates: Mates, def_a: i32[], def_b: i32[], lo: i32[], hi: i32[], nvals: i32): MateStarts {
  let count = __alloc_i32(nvals + 1);
  for w in 0..nvals {
    if (hi[w] >= 0) {
      for m in [mates.hint[w], mates.alt[w], def_a[w], def_b[w]] {
        if (m >= 0) {
          count = count.with(m + 1, count[m + 1] + 1);
        }
      }
    }
  }
  for m in 0..nvals {
    count = count.with(m + 1, count[m + 1] + count[m]);
  }
  let fill = count;
  let out = __alloc_i32(count[nvals]);
  for w in 0..nvals {
    if (hi[w] >= 0) {
      for m in [mates.hint[w], mates.alt[w], def_a[w], def_b[w]] {
        if (m >= 0) {
          out = out.with(fill[m], lo[w]);
          fill = fill.with(m, fill[m] + 1);
        }
      }
    }
  }
  return MateStarts { start: count, lo: out };
}

// A mate of a value of the chain starts after `from` and not after `to`. It
// takes the register of the chain only when no other value holds it then.
function chain_wanted(ms: MateStarts, holder: i32, shared_with: i32[], from: i32, to: i32): boolean {
  if (ms.start.len() == 0) {
    return false;
  }
  let m = holder;
  while (m >= 0) {
    for i in ms.start[m]..ms.start[m + 1] {
      if (ms.lo[i] > from && ms.lo[i] <= to) {
        return true;
      }
    }
    m = shared_with[m];
  }
  return false;
}

// A register from `first` to before `last` has values that hold it to `until`
// or longer.
function held_until(act_reg: i32[], act_hi: i32[], first: i32, last: i32, until: i32): boolean {
  for ai in 0..act_reg.len() {
    if (act_reg[ai] >= first && act_reg[ai] < last && act_hi[ai] >= until) {
      return true;
    }
  }
  return false;
}

// A register of the pool of `ln` whose values do not interfere with v: none is
// live at v's definition, and v is live at none of theirs. With `first`, v
// takes the first such register. Without it, the values of the register hold
// it to the end of v or longer, so v keeps it from no later value, and v
// takes the one that comes free first.
function borrowable(sites: ReadSites, v: i32, act_val: i32[], act_reg: i32[], act_hi: i32[], ln: Lender, reads: Reads, fixed: ssafixed.Table, shared_with: i32[], lo: i32[], hi: i32[], def_blk: i32[], def_pos: i32[]): Option[i32] {
  if (ln.keeps[v]) {
    return None;
  }
  let best: i32 = -1;
  for ai in 0..act_val.len() {
    let hr = act_reg[ai];
    let open = hr >= ln.cbase && hr < ln.sat && (hr != ln.cabi || ln.abi_ok) && ssafixed.allows(fixed, hr, lo[v], hi[v]);
    if (open && (ln.first || act_hi[ai] >= hi[v]) && (best < 0 || !ln.first && act_hi[ai] < act_hi[best]) && !chain_wanted(ln.wanted, act_val[ai], shared_with, lo[v], hi[v]) && chain_dead_at_def(sites, act_val[ai], v, shared_with, lo, hi, def_blk, def_pos) && dead_at_chain(sites, v, act_val[ai], shared_with, reads, ln.phi, lo, hi, def_blk, def_pos)) {
      best = ai;
    }
  }
  if (best < 0) {
    return None;
  }
  return Some(best);
}

function dead_at_chain(sites: ReadSites, v: i32, holder: i32, shared_with: i32[], reads: Reads, phi: boolean[], lo: i32[], hi: i32[], def_blk: i32[], def_pos: i32[]): boolean {
  let m = holder;
  while (m >= 0) {
    if (hi[m] >= lo[v] && (phi[m] || m != reads.a && m != reads.b && util.index_of_i32(reads.all, m) >= 0 || live_at_def(sites, v, m, def_blk, def_pos))) {
      return false;
    }
    m = shared_with[m];
  }
  return true;
}

function chain_dead_at_def(sites: ReadSites, holder: i32, a: i32, shared_with: i32[], lo: i32[], hi: i32[], def_blk: i32[], def_pos: i32[]): boolean {
  let m = holder;
  while (m >= 0) {
    if (hi[m] >= lo[a] && live_at_def(sites, m, a, def_blk, def_pos)) {
      return false;
    }
    m = shared_with[m];
  }
  return true;
}

function live_near(sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): i32 {
  let ab = def_blk[a];
  if (r < 0 || ab < 0) {
    return 1;
  }
  let rb = def_blk[r];
  // The entry writes a parameter, not its instruction.
  if (r >= sites.nparams && rb == ab && def_pos[r] > def_pos[a] && def_pos[r] >= sites.phi_end[rb]) {
    return 0;
  }
  let first = sites.start[r];
  let last = sites.start[r + 1];
  let far = false;
  let elsewhere = false;
  for i in first..last {
    if (sites.blk[i] == ab && sites.pos[i] > def_pos[a]) {
      return 1;
    }
    far = far || sites.blk[i] != ab || rb != ab;
    elsewhere = elsewhere || sites.blk[i] != rb;
  }
  if (!far) {
    return 0;
  }
  if (!elsewhere && rb != ab) {
    return 0;
  }
  return 2;
}

// The entry of a function writes each parameter at one time, so two
// parameters are live at the definition of each other. No other value is
// live at the entry.
function live_at_def(sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): boolean {
  if (a >= 0 && a < sites.nparams) {
    return r < sites.nparams;
  }
  let near = live_near(sites, r, a, def_blk, def_pos);
  if (near != 2) {
    return near == 1;
  }
  let ab = def_blk[a];
  let rb = def_blk[r];
  let first = sites.start[r];
  let last = sites.start[r + 1];
  let n = sites.succ_a.len();
  let walk = __alloc_i32(3 * n);
  for i in first..last {
    walk = walk.with(2 * n + sites.blk[i], 1);
  }
  let top = 0;
  let b = ab;
  while (true) {
    let s = sites.succ_a[b];
    if (s >= 0 && s != rb && walk[n + s] == 0) {
      walk = walk.with(n + s, 1).with(top, s);
      top += 1;
    }
    s = sites.succ_b[b];
    if (s >= 0 && s != rb && walk[n + s] == 0) {
      walk = walk.with(n + s, 1).with(top, s);
      top += 1;
    }
    if (top == 0) {
      return false;
    }
    top -= 1;
    b = walk[top];
    if (walk[2 * n + b] == 1) {
      return true;
    }
  }
}

struct SpillLive { index: i32[], words: i32, live_in: i64[] }

function no_spill_live(): SpillLive {
  return SpillLive { index: [], words: 0, live_in: [] };
}

function spill_live(sites: ReadSites, def_blk: i32[], values: i32[], nvals: i32): SpillLive {
  let n = sites.succ_a.len();
  let words: i32 = (values.len() + 63) / 64;
  let index = util.minus_ones(nvals);
  let uses = __alloc_i64(n * words);
  let kills = __alloc_i64(n * words);
  let k = 0;
  for v in values {
    index = index.with(v, k);
    let rb = def_blk[v];
    if (rb >= 0) {
      kills = spill_bit(kills, rb * words, k);
    }
    let i = sites.start[v];
    while (i < sites.start[v + 1]) {
      if (sites.blk[i] != rb) {
        uses = spill_bit(uses, sites.blk[i] * words, k);
      }
      i += 1;
    }
    k += 1;
  }
  let live_in = uses;
  let all: i64 = 0i64 - 1i64;
  let changed = true;
  while (changed) {
    changed = false;
    let b = n - 1;
    while (b >= 0) {
      for w in 0..words {
        let out: i64 = 0i64;
        if (sites.succ_a[b] >= 0) {
          out = out | live_in[sites.succ_a[b] * words + w];
        }
        if (sites.succ_b[b] >= 0) {
          out = out | live_in[sites.succ_b[b] * words + w];
        }
        let next = uses[b * words + w] | out & (kills[b * words + w] ^ all);
        if (next != live_in[b * words + w]) {
          live_in = live_in.with(b * words + w, next);
          changed = true;
        }
      }
      b -= 1;
    }
  }
  return SpillLive { index: index, words: words, live_in: live_in };
}

function spill_bit(own rows: i64[], base: i32, k: i32): i64[] {
  let w = base + k / 64;
  return rows.with(w, rows[w] | 1i64 << (k % 64) as i64);
}

function spill_live_at(live: SpillLive, sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): boolean {
  let near = live_near(sites, r, a, def_blk, def_pos);
  if (near != 2) {
    return near == 1;
  }
  let k: i32 = -1;
  if (r < live.index.len()) {
    k = live.index[r];
  }
  if (k < 0) {
    return live_at_def(sites, r, a, def_blk, def_pos);
  }
  let ab = def_blk[a];
  for s in [sites.succ_a[ab], sites.succ_b[ab]] {
    if (s >= 0 && (live.live_in[s * live.words + k / 64] >> (k % 64) as i64 & 1i64) != 0i64) {
      return true;
    }
  }
  return false;
}

function spill_starts(lo: i32[], def_pos: i32[]): i32[] {
  let from = __alloc_i32(lo.len());
  for i in 0..lo.len() {
    if (def_pos[i] >= 0) {
      from = from.with(i, lo[i]);
    }
  }
  return from;
}

function mates_wanted(hi: i32[], reg_of: i32[], hint: i32[]): i32[] {
  let wanted_by = util.minus_ones(reg_of.len());
  for i in 0..reg_of.len() {
    let m = hint[i];
    if (m >= 0 && hi[i] >= 0 && reg_of[i] == -1 && reg_of[m] == -1) {
      wanted_by = wanted_by.with(m, i);
    }
  }
  return wanted_by;
}

function hinted_slot(slot_end: i32[], holder: i32[], reg_of: i32[], h: i32, from: i32, take_over: boolean): i32 {
  if (h < 0 || reg_of[h] >= -1) {
    return -1;
  }
  let hs = spill_slot(reg_of[h]);
  if (slot_end[hs] < from || take_over && holder[hs] == h) {
    return hs;
  }
  return -1;
}

function free_slot(slot_end: i32[], holder: i32[], wanted_by: i32[], reg_of: i32[], from: i32, v: i32): i32 {
  let s = 0;
  while (s < slot_end.len() && (slot_end[s] >= from || kept_for_mate(wanted_by, reg_of, holder[s], v))) {
    s += 1;
  }
  return s;
}

function free_pair(slot_end: i32[], holder: i32[], wanted_by: i32[], reg_of: i32[], pairs: i32[], from: i32, v: i32): i32 {
  for p in pairs {
    if (slot_free_at(slot_end, holder, wanted_by, reg_of, from, v, p) && slot_free_at(slot_end, holder, wanted_by, reg_of, from, v, p + 1)) {
      return p;
    }
  }
  return slot_end.len();
}

function closed_pairs(slot_end: i32[], pairs: i32[]): i32[] {
  for p in pairs {
    slot_end = slot_end.with(p, 2147483647).with(p + 1, 2147483647);
  }
  return slot_end;
}

function slot_free_at(slot_end: i32[], holder: i32[], wanted_by: i32[], reg_of: i32[], from: i32, v: i32, s: i32): boolean {
  return slot_end[s] < from && !kept_for_mate(wanted_by, reg_of, holder[s], v);
}

// `nibble` marks each value whose lanes of 8 bits are all below 16. It is
// empty when the function has no swizzle.
pub struct Imms { is_imm: boolean[], konst: boolean[], value: i64[], sym_at: i32[], syms: string[], nibble: boolean[] }

pub function lane_nibble(imm: Imms, v: i32): boolean {
  return v >= 0 && v < imm.nibble.len() && imm.nibble[v];
}

pub function imm_sym(imm: Imms, v: i32): string {
  let k = imm.sym_at[v];
  return if (k > 0) { imm.syms[k - 1] } else { "" };
}

// The offset of the shape tag of a box: the high half of its header word.
// A SHAPE_ADDR value is the tag of its shape. A load and a store of a tag
// have the mark "u32".
pub function tag_offset(): i32 {
  return -4;
}

pub function with_value(own imm: Imms, v: i32, value: i64): Imms {
  return Imms { ...imm, is_imm: imm.is_imm.with(v, true), value: imm.value.with(v, value) };
}

pub function with_sym(own imm: Imms, v: i32, sym: string): Imms {
  let syms = imm.syms.append(sym);
  return Imms { ...imm, is_imm: imm.is_imm.with(v, true), sym_at: imm.sym_at.with(v, syms.len()), syms: syms };
}

// `stores` says the target stores an immediate to memory with one instruction.
// `zero_stores` says it stores only a zero so.
pub function imm_operands(f: SFunc, lo: i64, hi: i64, right: string[], left: string[], stores: boolean, zero_stores: boolean): Imms {
  let is_imm = __alloc_bool(f.nvals);
  let konst = __alloc_bool(f.nvals);
  let value = __alloc_i64(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag != CONST_INT && ins.kind_tag != CONST_I64) {
        continue;
      }
      konst = konst.with(ins.result, true);
      let c = ins.imm as i64;
      if (ins.kind_tag == CONST_I64) {
        c = util.lit_to_i64(ins.str);
      }
      value = value.with(ins.result, c);
      if (c < lo || c > hi) {
        continue;
      }
      is_imm = is_imm.with(ins.result, true);
    }
  }
  for blk in f.blocks {
    for ins in blk.insts {
      for a in 0..ins.args.len() {
        let v = ins.args[a];
        if (v >= 0 && v < is_imm.len() && is_imm[v] && ins.kind_tag != PHI && !((stores || zero_stores && value[v] == 0i64) && stored_value(ins, a)) && !imm_use(ins, a, konst, value[v], right, left)) {
          is_imm = is_imm.with(v, false);
        }
      }
    }
    let t = blk.term;
    if (t.kind_tag == TERM_BRIF && t.cond >= 0 && t.cond < is_imm.len()) {
      is_imm = is_imm.with(t.cond, false);
    }
  }
  let nibble = lane_nibbles(f, konst, value);
  return Imms { is_imm: is_imm, konst: konst, value: value, sym_at: __alloc_i32(f.nvals), syms: [], nibble: nibble };
}

function has_swizzle(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == BINARY && ins.str.starts_with("viswizzle")) {
        return true;
      }
    }
  }
  return false;
}

function lane_nibbles(f: SFunc, konst: boolean[], value: i64[]): boolean[] {
  if (!has_swizzle(f)) {
    return [];
  }
  let out = __alloc_bool(f.nvals);
  let changed = true;
  while (changed) {
    changed = false;
    for blk in f.blocks {
      for ins in blk.insts {
        if (ins.result >= 0 && !out[ins.result] && lane_inst(ins) && nibble_result(ins, out, konst, value)) {
          out = out.with(ins.result, true);
          changed = true;
        }
      }
    }
  }
  return out;
}

function nibble_result(ins: SInst, nibble: boolean[], konst: boolean[], value: i64[]): boolean {
  let b = lane_base(ins.str);
  if (b == "vand") {
    return nibble[ins.args[0]] || nibble[ins.args[1]];
  }
  if (ins.imm != 8) {
    return false;
  }
  if (b == "visplat") {
    return konst[ins.args[0]] && (value[ins.args[0]] & 255i64) < 16i64;
  }
  if (b == "vishru") {
    return konst[ins.args[1]] && (value[ins.args[1]] & 7i64) >= 4i64;
  }
  return b == "viminu" && (nibble[ins.args[0]] || nibble[ins.args[1]]);
}

// Operand `a` is the value of a store of 4 or 8 bytes.
pub function stored_value(ins: SInst, a: i32): boolean {
  return ins.kind_tag == ST_AT && a == 1 && ins.str != "u8";
}

function imm_use(ins: SInst, a: i32, konst: boolean[], c: i64, right: string[], left: string[]): boolean {
  if ((ins.kind_tag == LD_IDX || ins.kind_tag == ST_IDX) && a == 1) {
    return c >= 0i64 && c <= 4095i64;
  }
  if ((ins.kind_tag == LD_BYTE || ins.kind_tag == ST_BYTE) && a == 1) {
    return true;
  }
  if (ins.kind_tag >= ARR_AT && ins.kind_tag <= STR_AT && a == 1) {
    return c >= 0i64 && c <= 4087i64;
  }
  if (ins.kind_tag != BINARY || ins.args.len() != 2) {
    return false;
  }
  let other = ins.args[1 - a];
  if (other < 0 || other >= konst.len()) {
    return false;
  }
  if (a == 0 && konst[other]) {
    return false;
  }
  let names = left;
  if (a == 1) {
    names = right;
  }
  for n in names {
    if (n == ins.str) {
      return true;
    }
  }
  return false;
}

pub function literal_first_bytes(f: SFunc): i32[] {
  let out = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == STR_LIT && ins.str.len() > 0) {
        out = out.with(ins.result, ins.str[0] as i32);
      }
    }
  }
  return out;
}

pub function use_counts(f: SFunc): i32[] {
  let uses = __alloc_i32(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      for a in ins.args {
        if (a >= 0 && a < uses.len()) {
          uses = uses.with(a, uses[a] + 1);
        }
      }
    }
    let t = blk.term;
    if (t.kind_tag == TERM_RET && t.value >= 0 && t.value < uses.len()) {
      uses = uses.with(t.value, uses[t.value] + 1);
    }
    if (t.kind_tag == TERM_BRIF && t.cond >= 0 && t.cond < uses.len()) {
      uses = uses.with(t.cond, uses[t.cond] + 1);
    }
  }
  return uses;
}

function phi_sole_operand(ins: SInst, repl: i32[]): i32 {
  let only: i32 = -1;
  for i in 0..ins.args.len() {
    let a = resolve_repl(repl, ins.args[i]);
    if (a != ins.result) {
      if (only < 0) {
        only = a;
      } else if (only != a) {
        return -1;
      }
    }
  }
  return only;
}

function resolve_repl(repl: i32[], v: i32): i32 {
  let seen = 0;
  while (v >= 0 && v < repl.len() && repl[v] != v && seen < 1000) {
    v = repl[v];
    seen += 1;
  }
  return v;
}

function trivial_phi_repl(f: SFunc): i32[] {
  let repl = __alloc_i32(f.nvals);
  for i in 0..f.nvals {
    repl = repl.with(i, i);
  }
  let rounds = 0;
  let changed = true;
  while (changed && rounds < 100) {
    changed = false;
    rounds += 1;
    for blk in f.blocks {
      for ins in blk.insts {
        if (ins.kind_tag != PHI) {
          continue;
        }
        if (repl[ins.result] != ins.result) {
          continue;
        }
        let only = phi_sole_operand(ins, repl);
        if (only >= 0 && only != ins.result) {
          repl = repl.with(ins.result, only);
          changed = true;
        }
      }
    }
  }
  return repl;
}

pub struct Leaf { name: string, func: SFunc }

pub struct Leaves { list: Leaf[], ix: util.NameIndex }

pub function leaves_of(list: Leaf[]): Leaves {
  let names: string[] = [];
  for l in list {
    names = names.append(l.name);
  }
  return Leaves { list: list, ix: util.name_index(names) };
}

function leaf_limit(): i32 {
  return 12;
}

function leaf_kind(k: i32): boolean {
  return k == CONST_INT || k == CONST_BOOL || k == CONST_I64 || k == PARAM || k == COPY || k == BINARY || k == UNARY;
}

pub function leaf_of(name: string, f: SFunc): Leaf[] {
  if (f.takes_env || f.blocks.len() == 0) {
    return [];
  }
  let at = block_positions(f);
  let insts: SInst[] = [];
  let bi = position_of(at, f.entry);
  let seen = 0;
  while (bi >= 0 && seen < f.blocks.len()) {
    let b = f.blocks[bi];
    for ins in b.insts {
      insts = insts.append(ins);
    }
    seen += 1;
    if (b.term.kind_tag == TERM_RET) {
      if (seen != f.blocks.len()) {
        return [];
      }
      return returning_leaf(name, f, insts, b.term);
    }
    if (b.term.kind_tag != TERM_BR) {
      return [];
    }
    bi = position_of(at, b.term.target);
  }
  return [];
}

function returning_leaf(name: string, f: SFunc, insts: SInst[], term: STerm): Leaf[] {
  if (term.value < 0) {
    return [];
  }
  let n = 0;
  for ins in insts {
    if (!leaf_kind(ins.kind_tag)) {
      return [];
    }
    if (ins.kind_tag != PARAM) {
      n += 1;
    }
  }
  if (n > leaf_limit()) {
    return [];
  }
  let one = SBlock { id: f.entry, insts: insts, term: term, preds: [] };
  return [Leaf { name: name, func: SFunc { ...f, blocks: [one] } }];
}

pub function inline_leaves(f: SFunc, leaves: Leaves): SFunc {
  if (leaves.list.len() == 0) {
    return f;
  }
  let nvals = f.nvals;
  let blocks: SBlock[] = [];
  let copying = false;
  let bi = 0;
  while (bi < f.blocks.len()) {
    let b = f.blocks[bi];
    let insts: SInst[] = [];
    let spliced = false;
    let k = 0;
    while (k < b.insts.len()) {
      let ins = b.insts[k];
      let at: i32 = -1;
      if (ins.kind_tag == CALL) {
        at = leaf_index(leaves, ins.str, ins.args.len());
      }
      if (at < 0) {
        if (spliced) {
          insts = insts.append(ins);
        }
        k += 1;
        continue;
      }
      if (!spliced) {
        insts = insts_before(b.insts, k);
        spliced = true;
      }
      let leaf = leaves.list[at].func;
      let map = util.minus_ones(leaf.nvals);
      for li in leaf.blocks[0].insts {
        if (li.kind_tag == PARAM) {
          map = map.with(li.result, ins.args[li.imm]);
        } else {
          map = map.with(li.result, nvals);
          let args: i32[] = [];
          for a in li.args {
            args = args.append(map[a]);
          }
          insts = insts.append(SInst { ...li, result: nvals, args: args });
          nvals += 1;
        }
      }
      if (ins.result >= 0) {
        insts = insts.append(SInst { kind_tag: COPY, result: ins.result, args: [map[leaf.blocks[0].term.value]], imm: 0, str: "" });
      }
      k += 1;
    }
    if (spliced) {
      if (!copying) {
        blocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      blocks = blocks.append(SBlock { ...b, insts: insts });
    } else if (copying) {
      blocks = blocks.append(b);
    }
    bi += 1;
  }
  if (!copying) {
    return f;
  }
  return SFunc { ...f, nvals: nvals, blocks: blocks };
}

pub function calls_leaf(f: SFunc, leaves: Leaves): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == CALL && leaf_index(leaves, ins.str, ins.args.len()) >= 0) {
        return true;
      }
    }
  }
  return false;
}

function leaf_index(leaves: Leaves, name: string, argc: i32): i32 {
  let i = leaves.ix.chain(name);
  while (i >= 0) {
    if (leaves.list[i].func.nparams == argc && leaves.ix.names[i] == name) {
      return i;
    }
    i = leaves.ix.next[i];
  }
  return -1;
}

pub function prune_trivial_phis(f: SFunc): Formed {
  let repl = trivial_phi_repl(f);
  let any = false;
  let i = 0;
  while (i < f.nvals) {
    if (repl[i] != i) {
      any = true;
    }
    i += 1;
  }
  if (!any) {
    return Formed { f: f, repl: [] };
  }
  let flat: i32[] = [];
  for i in 0..f.nvals {
    flat = flat.append(resolve_repl(repl, i));
  }
  return Formed { f: rewrite_through(f, flat), repl: flat };
}

function rewrite_through(f: SFunc, flat: i32[]): SFunc {
  let nblocks: SBlock[] = [];
  let copying = false;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    let ninsts: SInst[] = [];
    let changed = false;
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      let gone = ins.result >= 0 && flat[ins.result] != ins.result;
      let moved = !gone && args_move(ins, flat);
      if (!changed && (gone || moved)) {
        ninsts = insts_before(blk.insts, k);
        changed = true;
      }
      if (changed && !gone) {
        if (moved) {
          ninsts = ninsts.append(rewrite_args(ins, flat));
        } else {
          ninsts = ninsts.append(ins);
        }
      }
    }
    let term = blk.term;
    if (term_moves(term, flat)) {
      term = rewrite_term(term, flat);
      if (!changed) {
        ninsts = blk.insts;
        changed = true;
      }
    }
    if (changed) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { ...blk, insts: ninsts, term: term });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
  }
  if (!copying) {
    return f;
  }
  return SFunc { ...f, blocks: nblocks };
}

function merge_duplicates(f: SFunc): Formed {
  let canon = identity_repl(f.nvals);
  let n = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag >= CONST_INT && ins.kind_tag <= CONST_I64 || ins.kind_tag == BINARY || ins.kind_tag == UNARY) {
        n += 1;
      }
    }
  }
  let nb = n * 2 + 1;
  let head = util.minus_ones(nb);
  let seen: SInst[] = [];
  let seen_block: i32[] = [];
  let next: i32[] = [];
  let merged: i32[] = [];
  for bi in 0..f.blocks.len() {
    for ins in f.blocks[bi].insts {
      let scope: i32 = -2;
      if (is_constant(ins, f.nvals)) {
        scope = -1;
      } else if (mergeable(ins)) {
        scope = bi;
      }
      if (scope >= -1) {
        let bk = (inst_hash(ins, canon) * 31 + (scope & 65535) & 1073741823) % nb;
        let found: i32 = -1;
        let j = head[bk];
        while (j >= 0 && found < 0) {
          if (seen_block[j] == scope && same_operation(seen[j], ins, canon)) {
            found = seen[j].result;
          }
          j = next[j];
        }
        if (found >= 0) {
          canon = canon.with(ins.result, found);
          if (scope >= 0) {
            merged = merged.append(ins.result).append(found);
          }
        } else {
          next = next.append(head[bk]);
          head = head.with(bk, seen.len());
          seen = seen.append(ins);
          seen_block = seen_block.append(scope);
        }
      }
    }
  }
  if (merged.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  let repl = identity_repl(f.nvals);
  let k = 0;
  while (k < merged.len()) {
    repl = repl.with(merged[k], merged[k + 1]);
    k += 2;
  }
  return Formed { f: rewrite_through(f, repl), repl: repl };
}

function identity_repl(n: i32): i32[] {
  let out = __alloc_i32(n);
  for i in 0..n {
    out = out.with(i, i);
  }
  return out;
}

// x + 0, x - 0, x | 0, x ^ 0, x shifted by 0 and x * 1 are x.
function fold_identities(f: SFunc): Formed {
  let defs = inst_defs(f);
  let flat = identity_repl(f.nvals);
  let changed = false;
  for blk in f.blocks {
    for ins in blk.insts {
      let kept = identity_operand(ins, defs);
      if (kept >= 0 && ins.result >= 0) {
        flat = flat.with(ins.result, flat[kept]);
        changed = true;
      }
    }
  }
  if (!changed) {
    return Formed { f: f, repl: [] };
  }
  return Formed { f: rewrite_through(f, flat), repl: flat };
}

function identity_operand(ins: SInst, defs: SInst[]): i32 {
  if (ins.kind_tag != BINARY || ins.args.len() != 2) {
    return -1;
  }
  let unit: i64 = 0i64;
  if (ins.str == "mul") {
    unit = 1i64;
  }
  if (right_identity(ins.str) && const_is(defs, ins.args[1], unit)) {
    return ins.args[0];
  }
  if (left_identity(ins.str) && const_is(defs, ins.args[0], unit)) {
    return ins.args[1];
  }
  return -1;
}

function left_identity(op: string): boolean {
  return op == "add" || op == "or" || op == "xor" || op == "mul";
}

function right_identity(op: string): boolean {
  return left_identity(op) || op == "sub" || op == "shl" || op == "shr_s" || op == "shr_u";
}

function const_is(defs: SInst[], v: i32, n: i64): boolean {
  if (v < 0 || v >= defs.len()) {
    return false;
  }
  let d = defs[v];
  if (d.kind_tag == CONST_INT) {
    return d.imm as i64 == n;
  }
  return d.kind_tag == CONST_I64 && d.str.len() > 0 && util.lit_to_i64(d.str) == n;
}

function is_constant(ins: SInst, nvals: i32): boolean {
  return ins.kind_tag >= CONST_INT && ins.kind_tag <= CONST_I64 && ins.result >= 0 && ins.result < nvals;
}

function mergeable(ins: SInst): boolean {
  if (ins.result < 0) {
    return false;
  }
  if (ins.kind_tag == BINARY) {
    return !binary_fixes_abi(ins.str);
  }
  if (ins.kind_tag == UNARY) {
    return ins.str == "!" || ins.str == "u32_wrap" || ins.str == "int_wrap" || ins.str == "int_extend"
      || ins.str.starts_with("int_cast:") || ins.str.starts_with("rotr:");
  }
  return false;
}

function operand_id(a: i32, canon: i32[]): i32 {
  if (a < 0 || a >= canon.len()) {
    return a;
  }
  return canon[a];
}

function inst_hash(ins: SInst, canon: i32[]): i32 {
  let h: i32 = (ins.kind_tag * 31 + (ins.imm & 65535)) * 31 + (__str_hash(ins.str, 0) & 65535) & 1048575;
  for a in ins.args {
    h = h * 31 + (operand_id(a, canon) & 1048575) & 1048575;
  }
  return h;
}

function same_operation(a: SInst, b: SInst, canon: i32[]): boolean {
  if (a.kind_tag != b.kind_tag || a.imm != b.imm || a.args.len() != b.args.len() || a.str != b.str) {
    return false;
  }
  for k in 0..a.args.len() {
    if (operand_id(a.args[k], canon) != operand_id(b.args[k], canon)) {
      return false;
    }
  }
  return true;
}

function args_move(ins: SInst, resolved: i32[]): boolean {
  for a in ins.args {
    if (a >= 0 && resolved[a] != a) {
      return true;
    }
  }
  return false;
}

function term_moves(t: STerm, resolved: i32[]): boolean {
  if (t.kind_tag == TERM_RET) {
    return t.value >= 0 && resolved[t.value] != t.value;
  }
  if (t.kind_tag == TERM_BRIF) {
    return resolved[t.cond] != t.cond;
  }
  return false;
}

pub function repeated_block_id(f: SFunc): i32 {
  let top = 0;
  for blk in f.blocks {
    if (blk.id > top) {
      top = blk.id;
    }
  }
  let seen = __alloc_i32(top + 1);
  for blk in f.blocks {
    if (seen[blk.id] == 1) {
      return blk.id;
    }
    seen = seen.with(blk.id, 1);
  }
  return -1;
}

pub function thread_forwarding(f: SFunc): Threading {
  let at = block_positions(f);
  let nblocks: SBlock[] = [];
  let copying = false;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    let t = blk.term;
    let moved = false;
    if (t.kind_tag == TERM_BR) {
      let target = forwarded(f, at, t.target);
      if (target != t.target) {
        t = STerm { ...t, target: target };
        moved = true;
      }
    }
    if (t.kind_tag == TERM_BRIF) {
      let nt = forwarded_branch(f, at, t);
      moved = nt.kind_tag != TERM_BRIF || nt.t != t.t || nt.f != t.f;
      t = nt;
    }
    if (moved) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { ...blk, term: t });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
  }
  let g = f;
  if (copying) {
    g = SFunc { ...f, blocks: nblocks };
  }
  let live = __alloc_bool(g.blocks.len());
  let work: i32[] = [position_of(at, g.entry)];
  let next = 0;
  while (next < work.len()) {
    let b = work[next];
    next += 1;
    if (b < 0 || live[b]) {
      continue;
    }
    live = live.with(b, true);
    for which in 0..2 {
      let id = successor_id(g.blocks[b].term, which);
      if (id >= 0 && (which == 0 || id != g.blocks[b].term.t)) {
        work = work.append(position_of(at, id));
      }
    }
  }
  let kept: SBlock[] = [];
  let dropping = false;
  for i in 0..g.blocks.len() {
    if (!live[i]) {
      if (!dropping) {
        kept = blocks_before(g.blocks, i);
        dropping = true;
      }
    } else if (dropping) {
      kept = kept.append(g.blocks[i]);
    }
  }
  let out = g;
  if (dropping) {
    out = SFunc { ...g, blocks: kept };
  }
  return Threading { f: SFunc { ...out, blocks: refreshed_preds(out) }, changed: copying || dropping };
}

// A branch whose two targets meet in a block with no phi is a jump.
function forwarded_branch(f: SFunc, at: i32[], t: STerm): STerm {
  let tt = forwarded(f, at, t.t);
  let tf = forwarded(f, at, t.f);
  if (tt == tf && tt >= 0 && tt < at.len() && at[tt] >= 0 && !has_phi(f.blocks[at[tt]])) {
    return t_br(tt);
  }
  return STerm { ...t, t: tt, f: tf };
}

function forwarded(f: SFunc, at: i32[], id: i32): i32 {
  let cur = id;
  for steps in 0..=f.blocks.len() {
    if (cur < 0 || cur >= at.len() || at[cur] < 0) {
      return cur;
    }
    let b = f.blocks[at[cur]];
    if (b.insts.len() != 0 || b.term.kind_tag != TERM_BR || b.term.target == cur) {
      return cur;
    }
    let nt = b.term.target;
    if (nt < 0 || nt >= at.len() || at[nt] < 0 || has_phi(f.blocks[at[nt]])) {
      return cur;
    }
    cur = nt;
  }
  return cur;
}

function has_phi(b: SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag == PHI) {
      return true;
    }
  }
  return false;
}

pub function refreshed_preds(f: SFunc): SBlock[] {
  let at = block_positions(f);
  let preds: i32[][] = [];
  let i = 0;
  while (i < f.blocks.len()) {
    preds = preds.append([]);
    i += 1;
  }
  i = 0;
  while (i < f.blocks.len()) {
    for which in 0..2 {
      let s = distinct_successor_position(at, f.blocks[i].term, which);
      if (s >= 0 && !has_pred(preds[s], f.blocks[i].id)) {
        preds = preds.with(s, preds[s].append(f.blocks[i].id));
      }
    }
    i += 1;
  }
  let out: SBlock[] = [];
  let copying = false;
  for i in 0..f.blocks.len() {
    let b = f.blocks[i];
    let nb = b;
    let fresh = false;
    if (has_phi(b)) {
      if (!every_pred(b.preds, preds[i])) {
        nb = trim_phi_edges(b, preds[i]);
        fresh = true;
      }
    } else if (!util.same_i32s(b.preds, preds[i])) {
      nb = SBlock { ...b, preds: preds[i] };
      fresh = true;
    }
    if (fresh) {
      if (!copying) {
        out = blocks_before(f.blocks, i);
        copying = true;
      }
      out = out.append(nb);
    } else if (copying) {
      out = out.append(b);
    }
  }
  if (!copying) {
    return f.blocks;
  }
  return out;
}

function every_pred(ps: i32[], edges: i32[]): boolean {
  for p in ps {
    if (!has_pred(edges, p)) {
      return false;
    }
  }
  return true;
}

function trim_phi_edges(b: SBlock, edges: i32[]): SBlock {
  let keep: boolean[] = [];
  let npreds: i32[] = [];
  for p in b.preds {
    let k = has_pred(edges, p);
    keep = keep.append(k);
    if (k) {
      npreds = npreds.append(p);
    }
  }
  if (npreds.len() == b.preds.len()) {
    return b;
  }
  let ninsts: SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag != PHI) {
      ninsts = ninsts.append(ins);
      continue;
    }
    let nargs: i32[] = [];
    for i in 0..ins.args.len() {
      if (i >= keep.len() || keep[i]) {
        nargs = nargs.append(ins.args[i]);
      }
    }
    ninsts = ninsts.append(SInst { ...ins, args: nargs });
  }
  return SBlock { id: b.id, insts: ninsts, term: b.term, preds: npreds };
}

function has_pred(ps: i32[], id: i32): boolean {
  for p in ps {
    if (p == id) {
      return true;
    }
  }
  return false;
}

struct BoolJoin { ok: boolean, j: i32, k: i32, t: i32, f: i32 }

pub struct Threading { f: SFunc, changed: boolean }

struct ThreadRound { blocks: SBlock[], busy: boolean[], gone: boolean[], changed: boolean }

pub function thread_bool_joins(f: SFunc): Threading {
  let g = f;
  let changed = false;
  for rounds in 0..8 {
    let r = thread_round(g);
    if (!r.changed) {
      return Threading { f: g, changed: changed };
    }
    g = r.f;
    changed = true;
  }
  return Threading { f: g, changed: changed };
}

function thread_round(f: SFunc): Threading {
  let at = block_positions(f);
  let uses = use_counts(f);
  let konst = truth_constants(f);
  let flags = __alloc_bool(f.blocks.len());
  let r = ThreadRound { blocks: f.blocks, busy: flags, gone: flags, changed: false };
  for j in 0..f.blocks.len() {
    let jn = bool_join_at(f, at, uses, j);
    if (jn.ok && !join_busy(f, at, r.busy, jn)) {
      r = thread_join(f, at, konst, jn, r);
    }
  }
  if (!r.changed) {
    return Threading { f: f, changed: false };
  }
  let kept: SBlock[] = [];
  for i in 0..r.blocks.len() {
    if (!r.gone[i]) {
      kept = kept.append(r.blocks[i]);
    }
  }
  let g = SFunc { ...f, blocks: kept };
  return Threading { f: SFunc { ...g, blocks: refreshed_preds(g) }, changed: true };
}

function truth_constants(f: SFunc): i32[] {
  let out = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if ((ins.kind_tag == CONST_INT || ins.kind_tag == CONST_BOOL) && ins.result >= 0 && ins.result < out.len()) {
        let truth = 0;
        if (ins.imm != 0) {
          truth = 1;
        }
        out = out.with(ins.result, truth);
      }
    }
  }
  return out;
}

function bool_join_at(f: SFunc, at: i32[], uses: i32[], j: i32): BoolJoin {
  let blk = f.blocks[j];
  let none = BoolJoin { ok: false, j: j, k: -1, t: 0, f: 0 };
  if (blk.insts.len() != 1 || blk.insts[0].kind_tag != PHI || uses[blk.insts[0].result] != 1 || !entered_forward(f, at, j)) {
    return none;
  }
  let k: i32 = -1;
  let last = j;
  let br = blk.term;
  if (br.kind_tag == TERM_BR) {
    k = position_of(at, br.target);
    if (k <= j || !branch_only(f.blocks[k], blk.id)) {
      return none;
    }
    last = k;
    br = f.blocks[k].term;
  }
  if (br.kind_tag != TERM_BRIF || br.cond != blk.insts[0].result || br.t == br.f
    || !plain_target(f, at, br.t, last) || !plain_target(f, at, br.f, last)) {
    return none;
  }
  return BoolJoin { ok: true, j: j, k: k, t: br.t, f: br.f };
}

function entered_forward(f: SFunc, at: i32[], j: i32): boolean {
  let blk = f.blocks[j];
  if (blk.preds.len() == 0 || blk.insts[0].args.len() != blk.preds.len()) {
    return false;
  }
  for i in 0..blk.preds.len() {
    let p = position_of(at, blk.preds[i]);
    if (p < 0 || p >= j || pred_slot(blk, blk.preds[i]) != i) {
      return false;
    }
  }
  return true;
}

function branch_only(b: SBlock, from: i32): boolean {
  return b.insts.len() == 0 && b.term.kind_tag == TERM_BRIF && b.preds.len() == 1 && b.preds[0] == from;
}

function plain_target(f: SFunc, at: i32[], id: i32, last: i32): boolean {
  let p = position_of(at, id);
  return p > last && !has_phi(f.blocks[p]);
}

function join_busy(f: SFunc, at: i32[], busy: boolean[], jn: BoolJoin): boolean {
  if (busy[jn.j] || jn.k >= 0 && busy[jn.k]) {
    return true;
  }
  for p in f.blocks[jn.j].preds {
    if (busy[at[p]]) {
      return true;
    }
  }
  return false;
}

function thread_join(f: SFunc, at: i32[], konst: i32[], jn: BoolJoin, r: ThreadRound): ThreadRound {
  let jb = f.blocks[jn.j];
  let blocks = r.blocks;
  let busy = r.busy.with(jn.j, true);
  let kept = 0;
  for i in 0..jb.preds.len() {
    let pp = at[jb.preds[i]];
    if (blocks[pp].term.kind_tag == TERM_BR) {
      blocks = blocks.with(pp, SBlock { ...blocks[pp], term: arm_term(jb.insts[0].args[i], konst, jn) });
      busy = busy.with(pp, true);
    } else {
      kept += 1;
    }
  }
  let gone = r.gone;
  if (kept == 0) {
    gone = gone.with(jn.j, true);
    if (jn.k >= 0) {
      gone = gone.with(jn.k, true);
    }
  }
  return ThreadRound { blocks: blocks, busy: busy, gone: gone, changed: r.changed || kept < jb.preds.len() };
}

function arm_term(v: i32, konst: i32[], jn: BoolJoin): STerm {
  if (v >= 0 && v < konst.len() && konst[v] == 1) {
    return t_br(jn.t);
  }
  if (v >= 0 && v < konst.len() && konst[v] == 0) {
    return t_br(jn.f);
  }
  return t_brif(v, jn.t, jn.f);
}

// A call whose result reaches the return only through a join returns from its
// own block, where an emitter can make it a tail call. The block with id to[k]
// took the return of the join with id from[k], in that order.
pub function return_calls(f: SFunc): Selection {
  let out = Selection { f: f, from: [], to: [] };
  for rounds in 0..8 {
    let r = return_round(out.f);
    if (r.from.len() == 0) {
      return out;
    }
    out = Selection { f: r.f, from: util.append_all(out.from, r.from), to: util.append_all(out.to, r.to) };
  }
  return out;
}

function return_round(f: SFunc): Selection {
  let at = block_positions(f);
  let uses = use_counts(f);
  let blocks = f.blocks;
  let from: i32[] = [];
  let to: i32[] = [];
  for jb in f.blocks {
    if (!return_join(jb, uses)) {
      continue;
    }
    for i in 0..jb.preds.len() {
      let pp = position_of(at, jb.preds[i]);
      if (pp >= 0 && yields_call(f, at, uses, f.blocks[pp], jb.insts[0].args[i], 4)) {
        blocks = blocks.with(pp, SBlock { ...blocks[pp], term: t_ret(jb.insts[0].args[i]) });
        from = from.append(jb.id);
        to = to.append(jb.preds[i]);
      }
    }
  }
  if (from.len() == 0) {
    return Selection { f: f, from: from, to: to };
  }
  let g = SFunc { ...f, blocks: blocks };
  return Selection { f: SFunc { ...g, blocks: settled_return_joins(refreshed_preds(g), f.entry) }, from: from, to: to };
}

// A block that holds one phi, with one value for each predecessor, that has one use.
function value_join(b: SBlock, uses: i32[]): boolean {
  return b.insts.len() == 1 && b.insts[0].kind_tag == PHI && b.insts[0].args.len() == b.preds.len() && b.preds.len() > 0 && uses[b.insts[0].result] == 1;
}

function return_join(b: SBlock, uses: i32[]): boolean {
  return value_join(b, uses) && b.term.kind_tag == TERM_RET && b.term.value == b.insts[0].result;
}

// A return join with no predecessor left goes. One with a single predecessor
// left returns the value of that predecessor.
function settled_return_joins(blocks: SBlock[], entry: i32): SBlock[] {
  let kept: SBlock[] = [];
  for b in blocks {
    if (b.preds.len() == 0 && b.id != entry) {
      continue;
    }
    if (b.preds.len() == 1 && b.insts.len() == 1 && b.insts[0].kind_tag == PHI && b.term.kind_tag == TERM_RET && b.term.value == b.insts[0].result) {
      kept = kept.append(SBlock { ...b, insts: [], term: t_ret(b.insts[0].args[0]) });
    } else {
      kept = kept.append(b);
    }
  }
  return kept;
}

// Whether b jumps to its join with v, and v is the result of a call that ends
// b, or of a call that ends a block which reaches b through joins only.
function yields_call(f: SFunc, at: i32[], uses: i32[], b: SBlock, v: i32, fuel: i32): boolean {
  if (b.term.kind_tag != TERM_BR || b.insts.len() == 0 || v < 0 || uses[v] != 1) {
    return false;
  }
  let last = b.insts[b.insts.len() - 1];
  if (last.result != v) {
    return false;
  }
  return calls(last) || fuel > 0 && value_join(b, uses) && join_yields_call(f, at, uses, b, fuel - 1);
}

function join_yields_call(f: SFunc, at: i32[], uses: i32[], b: SBlock, fuel: i32): boolean {
  for i in 0..b.preds.len() {
    let pp = position_of(at, b.preds[i]);
    if (pp >= 0 && yields_call(f, at, uses, f.blocks[pp], b.insts[0].args[i], fuel)) {
      return true;
    }
  }
  return false;
}

// A reuse token is a phi of a box and null behind a uniqueness test, and the
// blocks after it test the token again for each thing they do. split_tokens
// gives each side of the uniqueness test its own copy of those blocks, with
// each token test decided, so the token is tested once.
pub function split_tokens(f: SFunc): SFunc {
  let g = f;
  for rounds in 0..16 {
    let at = token_split_at(g);
    if (at.p < 0) {
      return g;
    }
    g = token_split(g, at);
  }
  return g;
}

// Marks each reuse allocation whose token is null.
pub function fresh_boxes(f: SFunc): SFunc {
  if (!has_reuse_alloc(f)) {
    return f;
  }
  let defs = inst_defs(f);
  let at = block_positions(f);
  let blocks = f.blocks;
  for bi in 0..f.blocks.len() {
    let b = f.blocks[bi];
    let insts = b.insts;
    for k in 0..b.insts.len() {
      let ins = b.insts[k];
      if (reuse_alloc_call(ins) && null_token(f, at, defs, b, ins.args[0])) {
        insts = insts.with(k, SInst { ...ins, imm: REUSE_NULL });
      }
    }
    blocks = blocks.with(bi, SBlock { ...b, insts: insts });
  }
  return SFunc { ...f, blocks: blocks };
}

function has_reuse_alloc(f: SFunc): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (reuse_alloc_call(ins)) {
        return true;
      }
    }
  }
  return false;
}

// The token is the constant, or the block is the null side of a test of it.
function null_token(f: SFunc, at: i32[], defs: SInst[], b: SBlock, tok: i32): boolean {
  if (const_is(defs, tok, 0i64)) {
    return true;
  }
  if (b.preds.len() != 1) {
    return false;
  }
  let p = position_of(at, b.preds[0]);
  if (p < 0) {
    return false;
  }
  let term = f.blocks[p].term;
  let side = token_test(f.blocks[p], defs, tok);
  if (side == 1) {
    return term.f == b.id && term.t != b.id;
  }
  return side == 0 && term.t == b.id && term.f != b.id;
}

// p, t, f and m are block positions: p ends in the uniqueness test, t and f
// are its arms and m holds the token phi. heads and arms are the positions of
// the blocks that test the token and of the arm each side takes, -1 for an
// edge straight to the join. e is the position of the block after the last
// join.
struct TokenSplit { p: i32, t: i32, f: i32, m: i32, tok: i32, box: i32, heads: i32[], fast_arms: i32[], slow_arms: i32[], dead_arms: i32[], e: i32 }

function no_token_split(): TokenSplit {
  return TokenSplit { p: -1, t: -1, f: -1, m: -1, tok: -1, box: -1, heads: [], fast_arms: [], slow_arms: [], dead_arms: [], e: -1 };
}

function token_split_at(f: SFunc): TokenSplit {
  let at = block_positions(f);
  let defs = inst_defs(f);
  for p in 0..f.blocks.len() {
    let found = token_entry(f, at, defs, p);
    if (found.p >= 0) {
      let chain = token_chain(f, at, defs, found);
      if (chain.heads.len() > 0 && chain.e != p && util.index_of_i32(chain.heads, chain.e) < 0 && token_copyable(f, chain)) {
        return chain;
      }
    }
  }
  return no_token_split();
}

// Whether each instruction the split copies can be in a function twice. A
// flat op and a dyn dispatch name their labels after the index of their op,
// not after their result, so a second copy defines those labels again.
function token_copyable(f: SFunc, sp: TokenSplit): boolean {
  for k in 0..sp.heads.len() {
    for part in [sp.heads[k], sp.fast_arms[k], sp.slow_arms[k]] {
      if (part >= 0 && op_indexed(f.blocks[part])) {
        return false;
      }
    }
  }
  return true;
}

function op_indexed(b: SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag == FLAT_OP || ins.kind_tag == DYN_DISPATCH) {
      return true;
    }
  }
  return false;
}

// The token phi: one arm of the test is empty, the other holds one zero, and
// both jump to a block whose one phi takes the box and that zero.
function token_entry(f: SFunc, at: i32[], defs: SInst[], p: i32): TokenSplit {
  let none = no_token_split();
  let term = f.blocks[p].term;
  if (term.kind_tag != TERM_BRIF || term.t == term.f) {
    return none;
  }
  let t = position_of(at, term.t);
  let fb = position_of(at, term.f);
  if (t < 0 || fb < 0 || !token_arm(f.blocks[t], f.blocks[p].id, 0) || !token_arm(f.blocks[fb], f.blocks[p].id, 1)) {
    return none;
  }
  let m = token_meet(f, at, p, t, fb);
  if (m < 0) {
    return none;
  }
  let box = token_box(f.blocks[m], f.blocks[t], f.blocks[fb], defs);
  if (box < 0) {
    return none;
  }
  return TokenSplit { ...none, p: p, t: t, f: fb, m: m, tok: f.blocks[m].insts[0].result, box: box };
}

// The position of the block both arms jump to, when it starts with the one phi. -1 for another shape.
function token_meet(f: SFunc, at: i32[], p: i32, t: i32, fb: i32): i32 {
  let m = position_of(at, f.blocks[t].term.target);
  if (m < 0 || m == p || f.blocks[t].term.target != f.blocks[fb].term.target || !token_phi_block(f.blocks[m])) {
    return -1;
  }
  return m;
}

// The box the phi of mb takes from tb, when it takes the zero of zb from zb. -1 for another phi.
function token_box(mb: SBlock, tb: SBlock, zb: SBlock, defs: SInst[]): i32 {
  let zero_slot = pred_slot(mb, zb.id);
  let box_slot = pred_slot(mb, tb.id);
  let zero = mb.insts[0].args[zero_slot];
  if (zero_slot == box_slot || zero != zb.insts[0].result || !const_is(defs, zero, 0i64)) {
    return -1;
  }
  return mb.insts[0].args[box_slot];
}

// An arm of the uniqueness test: entered from the test alone, n instructions, then a jump.
function token_arm(b: SBlock, from: i32, n: i32): boolean {
  return sole_pred(b, from) && b.insts.len() == n && b.term.kind_tag == TERM_BR;
}

// A block that two blocks enter and that starts with its one phi.
function token_phi_block(b: SBlock): boolean {
  if (b.preds.len() != 2 || b.insts.len() == 0 || b.insts[0].kind_tag != PHI || b.insts[0].args.len() != 2) {
    return false;
  }
  return b.insts.len() == 1 || b.insts[1].kind_tag != PHI;
}

function sole_pred(b: SBlock, id: i32): boolean {
  return b.preds.len() == 1 && b.preds[0] == id && !has_phi(b);
}

// 1 when the block ends in a branch that a token which is a box takes to its
// t side, 0 for its f side, -1 when the block does not end in a token test.
function token_test(b: SBlock, defs: SInst[], tok: i32): i32 {
  if (b.term.kind_tag != TERM_BRIF || b.term.cond < 0 || b.term.cond >= defs.len()) {
    return -1;
  }
  let c = defs[b.term.cond];
  if (c.kind_tag != BINARY || c.args.len() != 2 || c.args[0] != tok || !const_is(defs, c.args[1], 0i64)) {
    return -1;
  }
  if (c.str == "ne") {
    return 1;
  }
  if (c.str == "eq") {
    return 0;
  }
  return -1;
}

function token_chain(f: SFunc, at: i32[], defs: SInst[], entry: TokenSplit): TokenSplit {
  let out = entry;
  let cur = entry.m;
  for steps in 0..16 {
    let b = f.blocks[cur];
    let side = token_test(b, defs, entry.tok);
    if (side < 0) {
      break;
    }
    let ta = position_of(at, b.term.t);
    let fa = position_of(at, b.term.f);
    let join = token_join(f, at, cur, ta, fa);
    if (join < 0 || join == entry.p || join == entry.m || util.index_of_i32(out.heads, join) >= 0) {
      break;
    }
    let t_arm = ta;
    if (ta == join) {
      t_arm = -1;
    }
    let f_arm = fa;
    if (fa == join) {
      f_arm = -1;
    }
    let fast = f_arm;
    let slow = t_arm;
    if (side == 1) {
      fast = t_arm;
      slow = f_arm;
    }
    out = TokenSplit { ...out, heads: out.heads.append(cur), fast_arms: out.fast_arms.append(fast), slow_arms: out.slow_arms.append(slow), e: join };
    cur = join;
  }
  return out;
}

// The join of a branch whose arms are one block each, or one block and the
// join itself. -1 for another shape.
function token_join(f: SFunc, at: i32[], head: i32, ta: i32, fa: i32): i32 {
  if (ta < 0 || fa < 0 || ta == fa) {
    return -1;
  }
  let id = f.blocks[head].id;
  let t_to = arm_target(f, at, ta, id);
  let f_to = arm_target(f, at, fa, id);
  let join: i32 = -1;
  if (t_to >= 0 && t_to == f_to) {
    join = t_to;
  } else if (t_to == fa) {
    join = fa;
  } else if (f_to == ta) {
    join = ta;
  }
  if (join < 0 || f.blocks[join].preds.len() != 2) {
    return -1;
  }
  return join;
}

// Where the block at pos jumps, when it is entered from the block id alone
// and ends in a jump. -1 for another block.
function arm_target(f: SFunc, at: i32[], pos: i32, id: i32): i32 {
  if (!sole_pred(f.blocks[pos], id) || f.blocks[pos].term.kind_tag != TERM_BR) {
    return -1;
  }
  return position_of(at, f.blocks[pos].term.target);
}

struct TokenCopy { insts: SInst[], map: i32[], nvals: i32, last: i32 }

// One side of the split as one block: each head and the arm that side takes,
// with fresh results. map gives the value on this side of each value the
// copied blocks define. last is the id of the block this side enters e from.
function token_copy(f: SFunc, sp: TokenSplit, defs: SInst[], arms: i32[], tok_value: i32, own insts: SInst[], nvals: i32): TokenCopy {
  let map = util.minus_ones(f.nvals);
  map = map.with(sp.tok, tok_value);
  let loads = loads_above(f, sp.p);
  let n = nvals;
  let prev = -1;
  for k in 0..sp.heads.len() {
    for part in head_and_arm(sp.heads[k], arms[k]) {
      let b = f.blocks[part];
      for ins in b.insts {
        if (ins.kind_tag == PHI) {
          if (ins.result != sp.tok) {
            map = map.with(ins.result, token_mapped(map, ins.args[pred_slot(b, prev)]));
          }
          continue;
        }
        if (token_test_part(b, defs, ins)) {
          continue;
        }
        let nargs: i32[] = [];
        for a in ins.args {
          nargs = nargs.append(token_mapped(map, a));
        }
        let copy = SInst { ...ins, args: nargs };
        let again = same_load(loads, copy);
        if (again >= 0) {
          map = map.with(ins.result, again);
          continue;
        }
        loads = without_stored(loads, copy);
        if (copy.result >= 0) {
          map = map.with(copy.result, n);
          copy = SInst { ...copy, result: n };
          n += 1;
        }
        insts = insts.append(copy);
      }
      prev = b.id;
    }
  }
  return TokenCopy { insts: insts, map: map, nvals: n, last: prev };
}

function head_and_arm(head: i32, arm: i32): i32[] {
  if (arm < 0) {
    return [head];
  }
  return [head, arm];
}

// The field loads that hold where the block at p ends: each ld_at of the
// block and of the blocks above it that one block alone enters, less each
// one that a later st_at to the same field of the same base follows.
function loads_above(f: SFunc, p: i32): SInst[] {
  let at = block_positions(f);
  let chain: i32[] = [p];
  let cur = p;
  for steps in 0..8 {
    if (f.blocks[cur].preds.len() != 1) {
      break;
    }
    let up = position_of(at, f.blocks[cur].preds[0]);
    if (up < 0 || util.index_of_i32(chain, up) >= 0) {
      break;
    }
    chain = chain.append(up);
    cur = up;
  }
  let loads: SInst[] = [];
  let k = chain.len() - 1;
  while (k >= 0) {
    for ins in f.blocks[chain[k]].insts {
      loads = without_stored(loads, ins);
      if (ins.kind_tag == LD_AT && ins.args.len() == 1 && ins.result >= 0) {
        loads = loads.append(ins);
      }
    }
    k -= 1;
  }
  return loads;
}

// loads less each load of the field that ins stores to.
function without_stored(loads: SInst[], ins: SInst): SInst[] {
  if (ins.kind_tag != ST_AT || ins.args.len() == 0) {
    return loads;
  }
  let kept: SInst[] = [];
  for l in loads {
    if (l.args[0] != ins.args[0] || l.imm != ins.imm) {
      kept = kept.append(l);
    }
  }
  return kept;
}

// The result of a load in loads of the field that ins loads, or -1.
function same_load(loads: SInst[], ins: SInst): i32 {
  if (ins.kind_tag != LD_AT || ins.args.len() != 1) {
    return -1;
  }
  for l in loads {
    if (l.args[0] == ins.args[0] && l.imm == ins.imm && l.str == ins.str) {
      return l.result;
    }
  }
  return -1;
}

// The compare of the decided token test of b, or the zero it compares with
// when nothing else in b reads that zero.
function token_test_part(b: SBlock, defs: SInst[], ins: SInst): boolean {
  if (b.term.kind_tag != TERM_BRIF || ins.result < 0) {
    return false;
  }
  if (ins.result == b.term.cond) {
    return true;
  }
  let c = defs[b.term.cond];
  if (ins.kind_tag != CONST_INT || c.args.len() != 2 || c.args[1] != ins.result) {
    return false;
  }
  for other in b.insts {
    if (other.result != c.result && util.index_of_i32(other.args, ins.result) >= 0) {
      return false;
    }
  }
  return true;
}

function token_mapped(map: i32[], v: i32): i32 {
  if (v >= 0 && v < map.len() && map[v] >= 0) {
    return map[v];
  }
  return v;
}

function token_split(f: SFunc, sp: TokenSplit): SFunc {
  let defs = inst_defs(f);
  let region = token_region(f, sp);
  let top = 0;
  for b in f.blocks {
    if (b.id >= top) {
      top = b.id + 1;
    }
  }
  let from = f.blocks[sp.p].id;
  let eb = f.blocks[sp.e];
  let fast = token_copy(f, sp, defs, sp.fast_arms, sp.box, [], f.nvals);
  let zero = fast.nvals;
  let slow = token_copy(f, sp, defs, sp.slow_arms, zero, [SInst { kind_tag: CONST_INT, result: zero, args: [], imm: 0, str: "" }], zero + 1);
  let join = token_joined(f, sp, region, fast, slow);
  let after = token_renamed(eb, join.map, true);
  let sunk = write_backs(after.insts, join.insts, sp.box, defs, fast.insts);
  let blocks: SBlock[] = [];
  for bi in 0..f.blocks.len() {
    if (bi == sp.t) {
      blocks = blocks.append(SBlock { id: top, insts: fast.insts, term: t_br(eb.id), preds: [from] });
      blocks = blocks.append(SBlock { id: top + 1, insts: util.append_all(slow.insts, sunk.moved), term: t_br(eb.id), preds: [from] });
    }
    if (region[bi]) {
      continue;
    }
    let b = token_renamed(f.blocks[bi], join.map, bi == sp.e);
    if (bi == sp.e) {
      b = SBlock { ...b, insts: util.append_all(join.insts, sunk.kept), preds: [top, top + 1] };
    }
    if (bi == sp.p) {
      b = SBlock { ...b, term: t_brif(b.term.cond, top, top + 1) };
    }
    blocks = blocks.append(b);
  }
  return SFunc { ...f, nvals: join.nvals, blocks: blocks };
}

struct WriteBacks { kept: SInst[], moved: SInst[] }

// The stores that lead the block after the split and write a field of the
// unique box back to itself: the base is a phi that takes the box from the
// unique side, and the value is a load of the same field of the box. Only
// the shared side needs such a store. moved holds each one with the base of
// that side, and kept holds the other instructions.
function write_backs(insts: SInst[], phis: SInst[], box: i32, defs: SInst[], unique_side: SInst[]): WriteBacks {
  let kept: SInst[] = [];
  let moved: SInst[] = [];
  let leading = true;
  for ins in insts {
    leading = leading && (ins.kind_tag == ST_AT || ins.kind_tag == CONST_INT);
    let base = -1;
    if (leading && ins.kind_tag == ST_AT && ins.args.len() == 2) {
      base = shared_base(phis, ins.args[0], box);
    }
    if (base >= 0 && writes_back(ins, box, defs) && !stores_field(unique_side, box, ins.imm)) {
      moved = moved.append(SInst { ...ins, args: [base, ins.args[1]] });
    } else {
      kept = kept.append(ins);
    }
  }
  return WriteBacks { kept: kept, moved: moved };
}

// What the phi v takes from the shared side, when it takes the box from the unique side. -1 for another value.
function shared_base(phis: SInst[], v: i32, box: i32): i32 {
  for phi in phis {
    if (phi.result == v && phi.args.len() == 2 && phi.args[0] == box) {
      return phi.args[1];
    }
  }
  return -1;
}

function stores_field(insts: SInst[], base: i32, offset: i32): boolean {
  for ins in insts {
    if (ins.kind_tag == ST_AT && ins.args.len() > 0 && ins.args[0] == base && ins.imm == offset) {
      return true;
    }
  }
  return false;
}

function writes_back(ins: SInst, box: i32, defs: SInst[]): boolean {
  let v = ins.args[1];
  if (v < 0 || v >= defs.len()) {
    return false;
  }
  let d = defs[v];
  return d.kind_tag == LD_AT && d.args.len() == 1 && d.args[0] == box && d.imm == ins.imm && d.str == ins.str;
}

// The blocks the split replaces: the arms of the uniqueness test, each head
// and each arm of a head.
function token_region(f: SFunc, sp: TokenSplit): boolean[] {
  let region = __alloc_bool(f.blocks.len());
  region = region.with(sp.t, true).with(sp.f, true);
  for k in 0..sp.heads.len() {
    region = region.with(sp.heads[k], true);
    if (sp.fast_arms[k] >= 0) {
      region = region.with(sp.fast_arms[k], true);
    }
    if (sp.slow_arms[k] >= 0) {
      region = region.with(sp.slow_arms[k], true);
    }
  }
  return region;
}

// The phis of the block after the split. Its own phis take the value of each
// side. Each value both sides define, and a later block reads, gets a phi,
// and map names it.
function token_joined(f: SFunc, sp: TokenSplit, region: boolean[], fast: TokenCopy, slow: TokenCopy): TokenCopy {
  let eb = f.blocks[sp.e];
  let insts: SInst[] = [];
  for ins in eb.insts {
    if (ins.kind_tag == PHI) {
      insts = insts.append(SInst { ...ins, args: [token_mapped(fast.map, ins.args[pred_slot(eb, fast.last)]), token_mapped(slow.map, ins.args[pred_slot(eb, slow.last)])] });
    }
  }
  let map = util.minus_ones(f.nvals);
  let nvals = slow.nvals;
  let read = token_read_outside(f, region, sp.e);
  for v in 0..f.nvals {
    if (read[v] && fast.map[v] >= 0 && slow.map[v] >= 0) {
      insts = insts.append(SInst { kind_tag: PHI, result: nvals, args: [fast.map[v], slow.map[v]], imm: 0, str: "" });
      map = map.with(v, nvals);
      nvals += 1;
    }
  }
  return TokenCopy { insts: insts, map: map, nvals: nvals, last: -1 };
}

// The block with its reads renamed by map. no_phis leaves its phis out.
function token_renamed(b: SBlock, map: i32[], no_phis: boolean): SBlock {
  if (!no_phis && !token_reads_mapped(b, map)) {
    return b;
  }
  let insts: SInst[] = [];
  for ins in b.insts {
    if (no_phis && ins.kind_tag == PHI) {
      continue;
    }
    let nargs: i32[] = [];
    for a in ins.args {
      nargs = nargs.append(token_mapped(map, a));
    }
    insts = insts.append(SInst { ...ins, args: nargs });
  }
  let term = b.term;
  if (term.kind_tag == TERM_BRIF) {
    term = STerm { ...term, cond: token_mapped(map, term.cond) };
  }
  if (term.kind_tag == TERM_RET && term.value >= 0) {
    term = STerm { ...term, value: token_mapped(map, term.value) };
  }
  return SBlock { ...b, insts: insts, term: term };
}

// Whether the block reads a value that map renames.
function token_reads_mapped(b: SBlock, map: i32[]): boolean {
  for ins in b.insts {
    for a in ins.args {
      if (token_mapped(map, a) != a) {
        return true;
      }
    }
  }
  return token_mapped(map, b.term.cond) != b.term.cond || token_mapped(map, b.term.value) != b.term.value;
}

// The values that a block outside the copied ones reads.
function token_read_outside(f: SFunc, region: boolean[], e: i32): boolean[] {
  let read = __alloc_bool(f.nvals);
  for bi in 0..f.blocks.len() {
    if (region[bi]) {
      continue;
    }
    let b = f.blocks[bi];
    for ins in b.insts {
      if (bi != e || ins.kind_tag != PHI) {
        read = marked_all(read, ins.args);
      }
    }
    if (b.term.kind_tag == TERM_BRIF) {
      read = with_mark(read, b.term.cond);
    }
    if (b.term.kind_tag == TERM_RET) {
      read = with_mark(read, b.term.value);
    }
  }
  return read;
}

function marked_all(own marks: boolean[], values: i32[]): boolean[] {
  for v in values {
    marks = with_mark(marks, v);
  }
  return marks;
}

function with_mark(own marks: boolean[], v: i32): boolean[] {
  if (v >= 0 && v < marks.len()) {
    return marks.with(v, true);
  }
  return marks;
}

struct Diamond { ok: boolean, head: i32, t: i32, f: i32, join: i32 }

pub function select_arm_limit(): i32 {
  return 3;
}

// Selection is a function after select_branches. The block with id from[k]
// was folded into the block with id to[k], in that order.
pub struct Selection { f: SFunc, from: i32[], to: i32[] }

pub function select_branches(f: SFunc): Selection {
  let out = Selection { f: f, from: [], to: [] };
  for rounds in 0..8 {
    let r = select_round(out.f);
    if (!r.changed) {
      return out;
    }
    out = Selection { f: r.s.f, from: util.append_all(out.from, r.s.from), to: util.append_all(out.to, r.s.to) };
  }
  return out;
}

struct SelectRound { s: Selection, changed: boolean }

function select_round(f: SFunc): SelectRound {
  let at = block_positions(f);
  let fl = float_values(f, [], false);
  let none = __alloc_bool(f.blocks.len());
  let r = Flattening { blocks: f.blocks, busy: none, gone: none, nvals: f.nvals, changed: false, joins: [] };
  for p in 0..f.blocks.len() {
    let d = diamond_at(f, at, fl, p);
    if (d.ok && !diamond_busy(r.busy, d)) {
      r = flatten_diamond(f, d, r);
    }
  }
  if (!r.changed) {
    return SelectRound { s: Selection { f: f, from: [], to: [] }, changed: false };
  }
  let m = merge_joins(r, at);
  let kept: SBlock[] = [];
  for i in 0..m.blocks.len() {
    if (!m.gone[i]) {
      kept = kept.append(m.blocks[i]);
    }
  }
  return SelectRound { s: Selection { f: SFunc { ...f, nvals: r.nvals, blocks: kept }, from: m.from, to: m.to }, changed: true };
}

// joins holds a head position, then its join position, for each flattened diamond.
struct Flattening { blocks: SBlock[], busy: boolean[], gone: boolean[], nvals: i32, changed: boolean, joins: i32[] }

struct Merging { blocks: SBlock[], gone: boolean[], from: i32[], to: i32[] }

// merge_joins folds each flattened join into its head, which now ends in a
// jump to it. The diamonds of one round share no block, so no head is folded.
function merge_joins(r: Flattening, at: i32[]): Merging {
  let m = Merging { blocks: r.blocks, gone: r.gone, from: [], to: [] };
  let k = 0;
  while (k + 1 < r.joins.len()) {
    m = merge_join(m, r.joins[k], r.joins[k + 1], at);
    k += 2;
  }
  return m;
}

function merge_join(m: Merging, h: i32, j: i32, at: i32[]): Merging {
  let hb = m.blocks[h];
  let jb = m.blocks[j];
  if (hb.term.kind_tag != TERM_BR || hb.term.target != jb.id || jb.preds.len() != 1 || jb.preds[0] != hb.id || has_phi(jb)) {
    return m;
  }
  let succ: i32[] = [distinct_successor_position(at, jb.term, 0), distinct_successor_position(at, jb.term, 1)];
  if (succ[0] == h || succ[1] == h) {
    return m;
  }
  let blocks = m.blocks.with(h, SBlock { ...hb, insts: util.append_all(hb.insts, jb.insts), term: jb.term });
  for s in succ {
    if (s >= 0) {
      blocks = blocks.with(s, SBlock { ...blocks[s], preds: renamed_pred(blocks[s].preds, jb.id, hb.id) });
    }
  }
  return Merging { blocks: blocks, gone: m.gone.with(j, true), from: m.from.append(jb.id), to: m.to.append(hb.id) };
}

function renamed_pred(preds: i32[], from: i32, to: i32): i32[] {
  let out: i32[] = [];
  for p in preds {
    out = out.append(if (p == from) { to } else { p });
  }
  return out;
}

function flatten_diamond(f: SFunc, d: Diamond, r: Flattening): Flattening {
  let head = f.blocks[d.head];
  let insts = hoisted(head, util.append_all(arm_insts(f, d.t), arm_insts(f, d.f)));
  r = drop_arm(drop_arm(Flattening { ...r, busy: r.busy.with(d.head, true), changed: true }, d.t), d.f);
  if (d.join >= 0) {
    let j = f.blocks[d.join];
    let picks = join_selects(j, head.term.cond, arm_source(f, head, d.t), arm_source(f, head, d.f));
    let blocks = r.blocks.with(d.head, SBlock { ...head, insts: util.append_all(insts, picks), term: t_br(j.id) });
    return Flattening { ...r, blocks: blocks.with(d.join, SBlock { ...j, insts: without_phis(j.insts), preds: [head.id] }), busy: r.busy.with(d.join, true), joins: r.joins.append(d.head).append(d.join) };
  }
  let vt = f.blocks[d.t].term.value;
  let vf = f.blocks[d.f].term.value;
  if (vt == vf) {
    return Flattening { ...r, blocks: r.blocks.with(d.head, SBlock { ...head, insts: insts, term: t_ret(vt) }) };
  }
  let pick = SInst { kind_tag: SELECT, result: r.nvals, args: [head.term.cond, vt, vf], imm: 0, str: "" };
  return Flattening { ...r, blocks: r.blocks.with(d.head, SBlock { ...head, insts: insts.append(pick), term: t_ret(r.nvals) }), nvals: r.nvals + 1 };
}

function drop_arm(r: Flattening, arm: i32): Flattening {
  if (arm < 0) {
    return r;
  }
  return Flattening { ...r, busy: r.busy.with(arm, true), gone: r.gone.with(arm, true) };
}

function diamond_at(f: SFunc, at: i32[], fl: boolean[], p: i32): Diamond {
  let none = Diamond { ok: false, head: p, t: -1, f: -1, join: -1 };
  let head = f.blocks[p];
  let br = head.term;
  if (!two_way(head)) {
    return none;
  }
  let tp = position_of(at, br.t);
  let fp = position_of(at, br.f);
  if (tp < 0 || fp < 0) {
    return none;
  }
  let at_t = arm_at(f, tp, head.id);
  let at_f = arm_at(f, fp, head.id);
  if (!arms_fit(f, at_t, at_f)) {
    return none;
  }
  if (returns_picked(f, fl, at_t) && returns_picked(f, fl, at_f)) {
    return Diamond { ok: true, head: p, t: tp, f: fp, join: -1 };
  }
  let jp = join_of(f, at, p, tp, at_t, fp, at_f);
  if (jp < 0 || !select_join(f, fl, f.blocks[jp], arm_source(f, head, at_t), arm_source(f, head, at_f))) {
    return none;
  }
  return Diamond { ok: true, head: p, t: at_t, f: at_f, join: jp };
}

function arm_at(f: SFunc, p: i32, from: i32): i32 {
  if (select_arm(f.blocks[p], from)) {
    return p;
  }
  return -1;
}

function arms_fit(f: SFunc, at_t: i32, at_f: i32): boolean {
  if (at_t < 0 || at_f < 0) {
    return true;
  }
  return f.blocks[at_t].insts.len() + f.blocks[at_f].insts.len() <= select_arm_limit() + 1;
}

function returns_picked(f: SFunc, fl: boolean[], a: i32): boolean {
  if (a < 0) {
    return false;
  }
  let t = f.blocks[a].term;
  return t.kind_tag == TERM_RET && t.value >= 0 && !picks_float(fl, t.value);
}

function join_of(f: SFunc, at: i32[], p: i32, tp: i32, at_t: i32, fp: i32, at_f: i32): i32 {
  if (at_t < 0 && at_f < 0) {
    return -1;
  }
  let jt = arm_exit(f, at, tp, at_t);
  let jf = arm_exit(f, at, fp, at_f);
  if (jt < 0 || jt != jf || jt == p) {
    return -1;
  }
  return jt;
}

function arm_exit(f: SFunc, at: i32[], p: i32, arm: i32): i32 {
  if (arm < 0) {
    return p;
  }
  let t = f.blocks[arm].term;
  if (t.kind_tag != TERM_BR) {
    return -1;
  }
  return position_of(at, t.target);
}

function two_way(head: SBlock): boolean {
  let br = head.term;
  return br.kind_tag == TERM_BRIF && br.t != br.f && !tested_by_call(head, br.cond);
}

function tested_by_call(head: SBlock, cond: i32): boolean {
  for ins in head.insts {
    if (ins.result == cond && ins.kind_tag == UNARY && ins.str == "!") {
      return tested_by_call(head, ins.args[0]);
    }
    if (ins.result == cond) {
      return inst_is_call(ins);
    }
  }
  return false;
}

function select_arm(b: SBlock, from: i32): boolean {
  if (b.preds.len() != 1 || b.preds[0] != from || b.insts.len() > select_arm_limit()) {
    return false;
  }
  if (b.term.kind_tag != TERM_RET && b.term.kind_tag != TERM_BR) {
    return false;
  }
  for ins in b.insts {
    if (!speculable(ins)) {
      return false;
    }
  }
  return true;
}

function speculable(ins: SInst): boolean {
  let k = ins.kind_tag;
  if (k == CONST_INT || k == CONST_BOOL || k == CONST_I64 || k == COPY) {
    return true;
  }
  if (k == BINARY) {
    return int_binary(ins.str);
  }
  if (k == UNARY) {
    return int_unary(ins.str);
  }
  return false;
}

function int_unary(op: string): boolean {
  if (util.has_str(["!", "int_extend", "int_wrap", "u32_wrap"], op)) {
    return true;
  }
  for pre in ["int_cast:", "rotr:", "bswap:", "clz:", "ctz:", "popcount:"] {
    if (op.starts_with(pre)) {
      return true;
    }
  }
  return false;
}

function select_join(f: SFunc, fl: boolean[], j: SBlock, from_t: i32, from_f: i32): boolean {
  if (j.preds.len() != 2 || !has_pred(j.preds, from_t) || !has_pred(j.preds, from_f)) {
    return false;
  }
  let phis = 0;
  for ins in j.insts {
    if (ins.kind_tag == PHI) {
      if (ins.args.len() != 2 || picks_float(fl, ins.result)) {
        return false;
      }
      phis += 1;
    }
  }
  return phis <= 2;
}

function picks_float(fl: boolean[], v: i32): boolean {
  return v >= 0 && v < fl.len() && fl[v];
}

function arm_source(f: SFunc, head: SBlock, arm: i32): i32 {
  if (arm < 0) {
    return head.id;
  }
  return f.blocks[arm].id;
}

function arm_insts(f: SFunc, arm: i32): SInst[] {
  if (arm < 0) {
    return [];
  }
  return f.blocks[arm].insts;
}

function diamond_busy(busy: boolean[], d: Diamond): boolean {
  return busy[d.head] || d.t >= 0 && busy[d.t] || d.f >= 0 && busy[d.f] || d.join >= 0 && busy[d.join];
}

function hoisted(head: SBlock, arms: SInst[]): SInst[] {
  let n = head.insts.len();
  if (n == 0 || head.insts[n - 1].result != head.term.cond || head.insts[n - 1].kind_tag == PHI || arms_read(arms, head.term.cond)) {
    return util.append_all(head.insts, arms);
  }
  let out = util.append_all(slice_insts(head.insts, 0, n - 1), arms);
  return out.append(head.insts[n - 1]);
}

function arms_read(arms: SInst[], v: i32): boolean {
  for ins in arms {
    if (reads_value(ins, v)) {
      return true;
    }
  }
  return false;
}

pub function select_run(blk: SBlock, ii: i32): i32[] {
  let c = blk.insts[ii].args[0];
  let lo = ii;
  while (lo > 0 && blk.insts[lo - 1].kind_tag == SELECT && blk.insts[lo - 1].args[0] == c) {
    lo -= 1;
  }
  let hi = ii + 1;
  while (hi < blk.insts.len() && blk.insts[hi].kind_tag == SELECT && blk.insts[hi].args[0] == c) {
    hi += 1;
  }
  return [lo, hi];
}

function join_selects(j: SBlock, cond: i32, from_t: i32, from_f: i32): SInst[] {
  let picks: SInst[] = [];
  let copies: SInst[] = [];
  for ins in j.insts {
    if (ins.kind_tag == PHI) {
      let vt = ins.args[pred_slot(j, from_t)];
      let vf = ins.args[pred_slot(j, from_f)];
      if (vt == vf) {
        copies = copies.append(SInst { kind_tag: COPY, result: ins.result, args: [vt], imm: 0, str: "" });
      } else {
        picks = picks.append(SInst { kind_tag: SELECT, result: ins.result, args: [cond, vt, vf], imm: 0, str: "" });
      }
    }
  }
  return util.append_all(picks, copies);
}

function without_phis(insts: SInst[]): SInst[] {
  let out: SInst[] = [];
  for ins in insts {
    if (ins.kind_tag != PHI) {
      out = out.append(ins);
    }
  }
  return out;
}

function slice_insts(a: SInst[], lo: i32, hi: i32): SInst[] {
  let out: SInst[] = [];
  for i in lo..hi {
    out = out.append(a[i]);
  }
  return out;
}

pub struct Formed { f: SFunc, repl: i32[] }

function formed_by(f: SFunc, repl: i32[]): Formed {
  let flat: i32[] = [];
  for i in 0..repl.len() {
    flat = flat.append(resolve_repl(repl, i));
  }
  return Formed { f: f, repl: flat };
}

function compose_repl(a: i32[], b: i32[]): i32[] {
  if (a.len() == 0) {
    return b;
  }
  if (b.len() == 0) {
    return a;
  }
  let out: i32[] = [];
  for v in a {
    if (v >= 0 && v < b.len()) {
      out = out.append(b[v]);
    } else {
      out = out.append(v);
    }
  }
  return out;
}

pub function register_form(f: SFunc): Formed {
  return form(f, false);
}

// owned_frame_views: a view in the frame holds a unit, so its release stays.
pub function form(f: SFunc, owned_frame_views: boolean): Formed {
  let folded = prune_trivial_phis(slot_calls(without_lines(f)));
  let merged = merge_duplicates(folded.f);
  let plain = fold_identities(merged.f);
  let shared = share_shape_loads(plain.f);
  let unwrapped = drop_low_wraps(prune_dead(fold_offsets(fuse_rotates(fold_lane_identities(narrow_field_loads(shared.f))))));
  let extended = fold_extensions(unwrapped.f);
  let g = extended.f;
  let bytes = fold_byte_access(g);
  if (bytes.repl.len() > 0) {
    g = prune_dead(bytes.f);
  }
  let t = thread_bool_joins(g);
  if (t.changed) {
    g = prune_dead(t.f);
  }
  let fw = thread_forwarding(g);
  g = fw.f;
  let trimmed: i32[] = [];
  if (fw.changed) {
    // A join that lost a predecessor can be left with one value on every edge.
    let pruned = prune_trivial_phis(prune_dead(g));
    g = pruned.f;
    trimmed = pruned.repl;
  }
  g = sink_loads(combine_byte_stores(zero_extended_indices(unsigned_group_checks(drop_inert_counts(g, owned_frame_views)))));
  return Formed { f: g, repl: compose_repl(compose_repl(compose_repl(compose_repl(compose_repl(compose_repl(compose_repl(folded.repl, merged.repl), plain.repl), shared.repl), unwrapped.repl), extended.repl), bytes.repl), trimmed) };
}

// A byte or a half of a loaded word is a narrow load. A variant keeps its
// narrow fields in one word, and the code takes a field out with a shift and
// a mask. The narrow load is next to the load of the word, so it reads the
// same memory. Each target stores a word with its low byte first.
function narrow_field_loads(f: SFunc): SFunc {
  let defs = inst_defs(f);
  let n = narrow_parts(f, defs);
  if (!n.found) {
    return f;
  }
  let blocks: SBlock[] = [];
  for blk in f.blocks {
    let insts: SInst[] = [];
    for ins in blk.insts {
      if (ins.result >= 0 && n.gone[ins.result]) {
        continue;
      }
      insts = insts.append(ins);
      if (ins.result >= 0 && ins.kind_tag == LD_AT) {
        insts = with_insts(insts, n.after[ins.result]);
      }
    }
    blocks = blocks.append(SBlock { ...blk, insts: insts });
  }
  return rejoined_words(SFunc { ...f, blocks: blocks }, defs, n.parts);
}

// `after[w]` has the narrow loads that follow the load of word w. `gone[v]`
// says a narrow load gives value v in place of its instruction.
struct Narrowed { after: SInst[][], gone: boolean[], parts: Parts, found: boolean }

function narrow_parts(f: SFunc, defs: SInst[]): Narrowed {
  let n = Narrowed { after: [], gone: [], parts: no_parts(0), found: false };
  for blk in f.blocks {
    for ins in blk.insts {
      let part = narrow_part(defs, ins);
      if (part.kind_tag != LD_AT) {
        continue;
      }
      if (!n.found) {
        n = Narrowed { after: no_insts(f.nvals), gone: __alloc_bool(f.nvals), parts: no_parts(f.nvals), found: true };
      }
      let word = part.result;
      n = Narrowed {
        ...n,
        after: n.after.with(word, n.after[word].append(SInst { ...part, result: ins.result })),
        gone: n.gone.with(ins.result, true),
        parts: with_part(n.parts, ins.result, part, def_of(defs, word)),
      };
    }
  }
  return n;
}

// What a value is of a loaded word, by value. `raw[v]` is the word when v is
// its bits from `shift[v]` under the mask `low[v]`, moved down to bit 0.
// `half[v]` is the word when v is its high half with the sign. `placed[v]`
// is the word when v is its bits `mask[v]`, each at its own place.
struct Parts { raw: i32[], shift: i32[], low: i64[], half: i32[], placed: i32[], mask: i64[] }

function no_parts(n: i32): Parts {
  return Parts { raw: util.minus_ones(n), shift: __alloc_i32(n), low: __alloc_i64(n), half: util.minus_ones(n), placed: util.minus_ones(n), mask: __alloc_i64(n) };
}

// The narrow load `part` of the word `word` gives value v.
function with_part(own p: Parts, v: i32, part: SInst, word: SInst): Parts {
  let at = part.imm - word.imm;
  if (part.str == "i32") {
    return Parts { ...p, half: p.half.with(v, word.result) };
  }
  p = Parts { ...p, raw: p.raw.with(v, word.result), shift: p.shift.with(v, at * 8), low: p.low.with(v, 255i64) };
  return if (at == 0) { with_placed(p, v, word.result, 255i64) } else { p };
}

function with_placed(own p: Parts, v: i32, word: i32, mask: i64): Parts {
  return Parts { ...p, placed: p.placed.with(v, word), mask: p.mask.with(v, mask) };
}

// A constructor that takes fields of one box puts them back in one word: a
// shift of each part to its place, and an `or`. The same bits are a mask of
// the loaded word.
function rejoined_words(f: SFunc, defs: SInst[], parts0: Parts): SFunc {
  let parts = parts0;
  // The masks that the new constants hold. Each takes the next value id.
  let masks: i64[] = [];
  let blocks: SBlock[] = [];
  for blk in f.blocks {
    let insts: SInst[] = [];
    for ins in blk.insts {
      parts = with_low_half(with_extended(parts, ins), defs, ins);
      let j = joined_part(defs, parts, ins);
      if (j.word < 0) {
        insts = insts.append(ins);
        continue;
      }
      parts = with_placed(parts, ins.result, j.word, j.mask);
      let mask = f.nvals + masks.len();
      masks = masks.append(j.mask);
      insts = insts.append(SInst { kind_tag: CONST_I64, result: mask, args: [], imm: 0, str: util.i64_to_string(j.mask) });
      insts = insts.append(SInst { kind_tag: BINARY, result: ins.result, args: [j.word, mask], imm: 0, str: "and" });
    }
    blocks = blocks.append(SBlock { ...blk, insts: insts });
  }
  return if (masks.len() > 0) { SFunc { ...f, blocks: blocks, nvals: f.nvals + masks.len() } } else { f };
}

// An extension gives the same value for a byte, and a signed extension from
// 32 bits gives the same value for a signed half.
function with_extended(own p: Parts, ins: SInst): Parts {
  let signed = signed_extension(ins);
  if (!signed && !unsigned_extension(ins) || !in_parts(p, ins.result) || !in_parts(p, ins.args[0])) {
    return p;
  }
  let v = ins.args[0];
  if (signed && p.half[v] >= 0) {
    p = Parts { ...p, half: p.half.with(ins.result, p.half[v]) };
  }
  return with_byte(p, ins.result, v);
}

function in_parts(p: Parts, v: i32): boolean {
  return v >= 0 && v < p.raw.len();
}

// Value r is the byte that value v is.
function with_byte(own p: Parts, r: i32, v: i32): Parts {
  if (p.raw[v] < 0 || p.low[v] != 255i64) {
    return p;
  }
  let word = p.placed[v];
  let mask = p.mask[v];
  p = Parts { ...p, raw: p.raw.with(r, p.raw[v]), shift: p.shift.with(r, p.shift[v]), low: p.low.with(r, 255i64) };
  return if (word >= 0) { with_placed(p, r, word, mask) } else { p };
}

// The low half of the signed high half of a word is its high 32 bits, moved
// down to bit 0.
function with_low_half(own p: Parts, defs: SInst[], ins: SInst): Parts {
  let r = ins.result;
  if (ins.kind_tag != BINARY || ins.str != "and" || ins.args.len() != 2 || r < 0 || r >= p.raw.len()) {
    return p;
  }
  let v = ins.args[0];
  if (v < 0 || v >= p.half.len() || p.half[v] < 0 || word_constant(defs, ins.args[1]) != 4294967295i64) {
    return p;
  }
  return Parts { ...p, raw: p.raw.with(r, p.half[v]), shift: p.shift.with(r, 32), low: p.low.with(r, 4294967295i64) };
}

struct Joined { word: i32, mask: i64 }

// The word and the bits that `ins` gives at their place, or the word -1.
function joined_part(defs: SInst[], parts: Parts, ins: SInst): Joined {
  if (ins.kind_tag != BINARY || ins.args.len() != 2 || !in_parts(parts, ins.result) || !in_parts(parts, ins.args[0])) {
    return no_join();
  }
  if (ins.str == "shl") {
    return shifted_back(parts, ins.args[0], word_constant(defs, ins.args[1]));
  }
  return if (ins.str == "or") { joined_or(parts, ins.args[0], ins.args[1]) } else { no_join() };
}

function no_join(): Joined {
  return Joined { word: -1, mask: 0i64 };
}

// A part that a shift by `by` puts back at its own place.
function shifted_back(parts: Parts, a: i32, by: i64): Joined {
  if (parts.raw[a] < 0 || parts.shift[a] <= 0 || by != parts.shift[a] as i64) {
    return no_join();
  }
  return Joined { word: parts.raw[a], mask: parts.low[a] << parts.shift[a] as i64 };
}

// The bits of two values that have bits of one word at their place.
function joined_or(parts: Parts, a: i32, b: i32): Joined {
  if (!in_parts(parts, b) || parts.placed[a] < 0 || parts.placed[a] != parts.placed[b]) {
    return no_join();
  }
  return Joined { word: parts.placed[a], mask: parts.mask[a] | parts.mask[b] };
}

function no_insts(n: i32): SInst[][] {
  let out: SInst[][] = [];
  for i in 0..n {
    out = out.append([]);
  }
  return out;
}

// The narrow load that gives the value of `ins`, with the word that `ins`
// takes it from as its result, or no_inst().
function narrow_part(defs: SInst[], ins: SInst): SInst {
  if (ins.kind_tag != BINARY || ins.args.len() != 2) {
    return no_inst();
  }
  let by = word_constant(defs, ins.args[1]);
  let from = def_of(defs, ins.args[0]);
  if (ins.str == "shr_s" && by == 32i64) {
    return part_of(from, 4, "i32");
  }
  return if (ins.str == "and" && by == 255i64) { narrow_byte(defs, from) } else { no_inst() };
}

// The load of the byte that the low byte of `from` is.
function narrow_byte(defs: SInst[], from: SInst): SInst {
  if (from.kind_tag != BINARY || from.str != "shr_s" || from.args.len() != 2) {
    return part_of(from, 0, "u8");
  }
  let shift = word_constant(defs, from.args[1]);
  if (shift <= 0i64 || shift >= 64i64 || shift % 8i64 != 0i64) {
    return no_inst();
  }
  return part_of(def_of(defs, from.args[0]), (shift / 8i64) as i32, "u8");
}

// The load of `mark` at byte `at` of the word that `word` loads.
function part_of(word: SInst, at: i32, mark: string): SInst {
  if (word.kind_tag != LD_AT || word.str != "" || word.imm < 0) {
    return no_inst();
  }
  return SInst { kind_tag: LD_AT, result: word.result, args: word.args, imm: word.imm + at, str: mark };
}

// The value of a constant, or -1 for a value that is not a constant.
function word_constant(defs: SInst[], v: i32): i64 {
  let d = def_of(defs, v);
  if (d.kind_tag == CONST_INT) {
    return d.imm as i64;
  }
  return if (d.kind_tag == CONST_I64) { util.lit_to_i64(d.str) } else { 0i64 - 1i64 };
}

// A load at the end of a block, which only one side of the branch reads,
// moves to that side. A match loads each binding of a pattern before it
// tests the nested patterns, and the side that fails reads none of them.
function sink_loads(f: SFunc): SFunc {
  let g = f;
  for round in 0..8 {
    let next = sink_round(g);
    if (!next.changed) {
      return g;
    }
    g = next.f;
  }
  return g;
}

struct Sunk { f: SFunc, changed: boolean }

struct Readers { blocks: i32[][], pinned: boolean[] }

function sink_round(f: SFunc): Sunk {
  let at = block_positions(f);
  let idom = immediate_dominators(f, at);
  let entries = entry_counts(f, at);
  let readers = value_readers(f);
  let moved: SInst[][] = [];
  for blk in f.blocks {
    moved = moved.append([]);
  }
  let blocks = f.blocks;
  let splits: Split[] = [];
  let changed = false;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    let kept: SInst[] = [];
    let tail = pure_tail(blk);
    let fl = Flow { at: at, idom: idom, entries: entries, term: blk.term };
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      let sk = sink_of(ins, bi, k >= tail, fl, readers);
      if (sk.other >= 0) {
        let copy = f.nvals + splits.len();
        splits = splits.append(Split { from: ins.result, to: copy, side: sk.other });
        moved = moved.with(sk.other, moved[sk.other].append(SInst { ...ins, result: copy }));
      }
      if (sk.to < 0) {
        kept = kept.append(ins);
      } else {
        moved = moved.with(sk.to, moved[sk.to].append(ins));
        changed = true;
      }
    }
    blocks = blocks.with(bi, SBlock { ...blk, insts: kept });
  }
  if (!changed) {
    return Sunk { f: f, changed: false };
  }
  for bi in 0..blocks.len() {
    if (moved[bi].len() > 0) {
      blocks = blocks.with(bi, SBlock { ...blocks[bi], insts: after_phis(blocks[bi].insts, moved[bi]) });
    }
  }
  return Sunk { f: SFunc { ...f, nvals: f.nvals + splits.len(), blocks: renamed_sides(blocks, idom, splits) }, changed: true };
}

// A load that both sides of a branch read gets a copy on side `side`, and
// the blocks that run after that side read the copy `to`.
struct Split { from: i32, to: i32, side: i32 }

// Where an instruction goes: successor `to` takes it, and successor `other`
// takes a copy. Each is -1 for none.
struct Sink { to: i32, other: i32 }

function sink_of(ins: SInst, bi: i32, in_tail: boolean, fl: Flow, readers: Readers): Sink {
  if (!in_tail) {
    return Sink { to: -1, other: -1 };
  }
  let to = sink_target(ins, bi, fl, readers);
  if (to >= 0) {
    return Sink { to: to, other: -1 };
  }
  let other = split_target(ins, bi, fl, readers);
  if (other < 0) {
    return Sink { to: -1, other: -1 };
  }
  return Sink { to: distinct_successor_position(fl.at, fl.term, 0), other: other };
}

// The second successor, when the load of `ins` can go to each side of the
// branch as one copy, or -1. A side that reads the value in its first block
// gains nothing, so one side must read it later.
function split_target(ins: SInst, bi: i32, fl: Flow, readers: Readers): i32 {
  if (ins.kind_tag != LD_AT || fl.term.kind_tag != TERM_BRIF || readers.pinned[ins.result]) {
    return -1;
  }
  let read = readers.blocks[ins.result];
  let s0 = distinct_successor_position(fl.at, fl.term, 0);
  let s1 = distinct_successor_position(fl.at, fl.term, 1);
  if (!single_entry_sides(fl, bi, s0, s1) || util.index_of_i32(read, bi) >= 0) {
    return -1;
  }
  if (util.index_of_i32(read, s0) >= 0 && util.index_of_i32(read, s1) >= 0) {
    return -1;
  }
  return if (each_after_a_side(fl.idom, s0, s1, read)) { s1 } else { -1 };
}

function single_entry_sides(fl: Flow, bi: i32, s0: i32, s1: i32): boolean {
  return s0 >= 0 && s1 >= 0 && s0 != bi && s1 != bi && fl.entries[s0] == 1 && fl.entries[s1] == 1;
}

function each_after_a_side(idom: i32[], s0: i32, s1: i32, read: i32[]): boolean {
  for b in read {
    if (!dominates(idom, s0, b) && !dominates(idom, s1, b)) {
      return false;
    }
  }
  return true;
}

function renamed_sides(own blocks: SBlock[], idom: i32[], splits: Split[]): SBlock[] {
  for sp in splits {
    for bi in 0..blocks.len() {
      if (dominates(idom, sp.side, bi)) {
        blocks = blocks.with(bi, block_reading(blocks[bi], sp.from, sp.to));
      }
    }
  }
  return blocks;
}

// The block with each read of value `from` turned into a read of `to`.
function block_reading(blk: SBlock, from: i32, to: i32): SBlock {
  let insts: SInst[] = [];
  for ins in blk.insts {
    let args = ins.args;
    for a in 0..args.len() {
      if (args[a] == from) {
        args = args.with(a, to);
      }
    }
    insts = insts.append(SInst { ...ins, args: args });
  }
  let term = blk.term;
  if (term.cond == from) {
    term = STerm { ...term, cond: to };
  }
  if (term.value == from) {
    term = STerm { ...term, value: to };
  }
  return SBlock { ...blk, insts: insts, term: term };
}

struct Flow { at: i32[], idom: i32[], entries: i32[], term: STerm }

// The position of the successor that `ins` can move to, or -1.
function sink_target(ins: SInst, bi: i32, fl: Flow, readers: Readers): i32 {
  if (ins.kind_tag != LD_AT || fl.term.kind_tag != TERM_BRIF || readers.pinned[ins.result]) {
    return -1;
  }
  let read = readers.blocks[ins.result];
  let s0 = distinct_successor_position(fl.at, fl.term, 0);
  let s1 = distinct_successor_position(fl.at, fl.term, 1);
  if (read.len() == 0 || util.index_of_i32(read, bi) >= 0 || s0 < 0 || s1 < 0) {
    return -1;
  }
  if (sole_reader(fl, bi, s0, read)) {
    return s0;
  }
  return if (sole_reader(fl, bi, s1, read)) { s1 } else { -1 };
}

// Block `s` has one edge into it, and each block of `read` runs after it.
function sole_reader(fl: Flow, bi: i32, s: i32, read: i32[]): boolean {
  return s != bi && fl.entries[s] == 1 && dominates_each(fl.idom, s, read);
}

function dominates_each(idom: i32[], s: i32, blocks: i32[]): boolean {
  for b in blocks {
    if (!dominates(idom, s, b)) {
      return false;
    }
  }
  return true;
}

// The first position of the run of instructions at the end of the block
// that write no memory and call nothing.
function pure_tail(blk: SBlock): i32 {
  let k = blk.insts.len();
  while (k > 0 && reads_only(blk.insts[k - 1])) {
    k -= 1;
  }
  return k;
}

function reads_only(ins: SInst): boolean {
  let k = ins.kind_tag;
  return k == LD_AT || k == CONST_INT || k == CONST_BOOL || k == CONST_I64 || k == SHAPE_ADDR || k == AGG_LIT || k == BINARY || k == UNARY || unique_test(ins);
}

// The number of edges into each block position.
function entry_counts(f: SFunc, at: i32[]): i32[] {
  let out = __alloc_i32(f.blocks.len());
  for blk in f.blocks {
    for which in 0..2 {
      let s = distinct_successor_position(at, blk.term, which);
      if (s >= 0) {
        out = out.with(s, out[s] + 1);
      }
    }
  }
  return out;
}

// The block positions that read each value. A value that a phi reads is
// pinned: the phi reads it at the end of another block.
function value_readers(f: SFunc): Readers {
  let blocks: i32[][] = [];
  for v in 0..f.nvals {
    blocks = blocks.append([]);
  }
  let pinned = __alloc_bool(f.nvals);
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    for ins in blk.insts {
      for a in ins.args {
        if (a >= 0 && a < f.nvals && ins.kind_tag == PHI) {
          pinned = pinned.with(a, true);
        } else if (a >= 0 && a < f.nvals) {
          blocks = read_in(blocks, a, bi);
        }
      }
    }
    blocks = read_in(read_in(blocks, blk.term.cond, bi), blk.term.value, bi);
  }
  return Readers { blocks: blocks, pinned: pinned };
}

function read_in(own blocks: i32[][], v: i32, bi: i32): i32[][] {
  if (v < 0 || v >= blocks.len() || blocks[v].len() > 0 && blocks[v][blocks[v].len() - 1] == bi) {
    return blocks;
  }
  return blocks.with(v, blocks[v].append(bi));
}

function after_phis(insts: SInst[], moved: SInst[]): SInst[] {
  let out: SInst[] = [];
  let head = true;
  for ins in insts {
    if (head && ins.kind_tag != PHI) {
      out = with_insts(out, moved);
      head = false;
    }
    out = out.append(ins);
  }
  return if (head) { with_insts(out, moved) } else { out };
}

function with_insts(own out: SInst[], more: SInst[]): SInst[] {
  for ins in more {
    out = out.append(ins);
  }
  return out;
}

// A count taken or given back on a constant null does nothing: the runtime
// entries return at the floor test. Nor does the release of a view the
// function builds in its own frame, where its count is immortal. The
// instruction goes.
function drop_inert_counts(f: SFunc, owned_frame_views: boolean): SFunc {
  if (!has_inert_counts(f, owned_frame_views)) {
    return f;
  }
  let defs = inst_defs(f);
  let uses = use_counts(f);
  let nblocks: SBlock[] = [];
  let changed = false;
  for blk in f.blocks {
    let kept = without_inert_counts(blk, defs, uses, owned_frame_views);
    changed = changed || kept.insts.len() != blk.insts.len();
    nblocks = nblocks.append(kept);
  }
  if (!changed) {
    return f;
  }
  return SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: nblocks, entry: f.entry, takes_env: f.takes_env };
}

// Whether the function holds a zero constant and a count call, or a frame
// view and a view release, so the common function pays one scan and no
// allocation.
function has_inert_counts(f: SFunc, owned_frame_views: boolean): boolean {
  let zero = false;
  let counts = false;
  let frame = false;
  let views = false;
  for blk in f.blocks {
    for ins in blk.insts {
      zero = zero || zero_constant(ins);
      counts = counts || count_call(ins);
      frame = frame || frame_view(ins);
      views = views || view_release(ins);
    }
  }
  return zero && counts || !owned_frame_views && frame && views;
}

function zero_constant(ins: SInst): boolean {
  if (ins.result < 0) {
    return false;
  }
  if (ins.kind_tag == CONST_INT) {
    return ins.imm == 0;
  }
  return ins.kind_tag == CONST_I64 && ins.str.len() > 0 && util.lit_to_i64(ins.str) == 0i64;
}

function without_inert_counts(blk: SBlock, defs: SInst[], uses: i32[], owned_frame_views: boolean): SBlock {
  let ninsts: SInst[] = [];
  for ins in blk.insts {
    if (!inert_count(ins, defs, uses, owned_frame_views)) {
      ninsts = ninsts.append(ins);
    }
  }
  if (ninsts.len() == blk.insts.len()) {
    return blk;
  }
  return SBlock { id: blk.id, insts: ninsts, term: blk.term, preds: blk.preds };
}

function count_call(ins: SInst): boolean {
  return ins.kind_tag == CALL && ins.args.len() == 1 && (ins.str == "__fern_rc_dec" || ins.str == "__fern_rc_inc");
}

function view_release(ins: SInst): boolean {
  return ins.kind_tag == CALL && ins.args.len() == 1 && (ins.str == "__fern_str_view_free" || tagged_view_release(ins.str));
}

// The releases of an array view, which take a descriptor tagged with bit 1.
function tagged_view_release(name: string): boolean {
  return name == "__sem_view_release" || name.starts_with("__sem_release_$view$");
}

// A view in the frame of its function, which the register backends build
// with an immortal count (`str_slice frame:N`, `raw_string frame:N`).
function frame_view(ins: SInst): boolean {
  return ins.kind_tag == STR_VIEW && ins.imm >= 1;
}

function frame_view_at(defs: SInst[], v: i32): boolean {
  return v >= 0 && v < defs.len() && frame_view(defs[v]);
}

function tagged_frame_view(defs: SInst[], v: i32): boolean {
  if (v < 0 || v >= defs.len()) {
    return false;
  }
  let d = defs[v];
  return d.kind_tag == BINARY && d.str == "add" && d.args.len() == 2 && frame_view_at(defs, d.args[0]) && const_is(defs, d.args[1], 2i64);
}

// Which calls may be tail calls: none when `on` is false, and none that
// reads a view in the frame, since a tail call ends the frame. `framed` is
// indexed by the value of a call, and empty when the function has no frame view.
pub struct Tails { on: boolean, framed: boolean[] }

pub function tails_of(f: SFunc, on: boolean): Tails {
  if (!on) {
    return Tails { on: false, framed: [] };
  }
  return Tails { on: true, framed: frame_view_calls(f) };
}

pub function may_tail(t: Tails, ins: SInst): boolean {
  return t.on && !(ins.result >= 0 && ins.result < t.framed.len() && t.framed[ins.result]);
}

function frame_view_calls(f: SFunc): boolean[] {
  let frame = false;
  for blk in f.blocks {
    for ins in blk.insts {
      frame = frame || frame_view(ins);
    }
  }
  if (!frame) {
    return [];
  }
  let defs = inst_defs(f);
  let out = __alloc_bool(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals && calls(ins) && reads_frame_view(defs, ins)) {
        out = out.with(ins.result, true);
      }
    }
  }
  return out;
}

function reads_frame_view(defs: SInst[], ins: SInst): boolean {
  for a in ins.args {
    if (frame_view_at(defs, a) || tagged_frame_view(defs, a)) {
      return true;
    }
  }
  return false;
}

function inert_count(ins: SInst, defs: SInst[], uses: i32[], owned_frame_views: boolean): boolean {
  if (ins.result >= 0 && ins.result < uses.len() && uses[ins.result] > 0) {
    return false;
  }
  if (count_call(ins)) {
    return const_is(defs, ins.args[0], 0i64);
  }
  if (owned_frame_views || !view_release(ins)) {
    return false;
  }
  if (tagged_view_release(ins.str)) {
    return tagged_frame_view(defs, ins.args[0]);
  }
  return frame_view_at(defs, ins.args[0]);
}

struct GroupIndex { lo: i32, span: i32, chain: i32 }

// The parts of the index `(lo + span) | (lo >> 31)` of a check with no read,
// or lo -1. chain is the count of reads of lo that the index alone keeps.
function group_index(defs: SInst[], uses: i32[], ins: SInst): GroupIndex {
  let none = GroupIndex { lo: -1, span: 0, chain: 0 };
  if (ins.kind_tag != ARR_AT && ins.kind_tag != STR_AT || ins.imm != 2 || ins.args.len() < 2) {
    return none;
  }
  let join = def_of(defs, ins.args[1]);
  if (join.kind_tag != BINARY || join.str != "or" || join.args.len() != 2 || uses[join.result] != 1) {
    return none;
  }
  for k in 0..2 {
    let sign = def_of(defs, join.args[1 - k]);
    if (sign.kind_tag != BINARY || sign.str != "shr_s" || sign.args.len() != 2 || !const_is(defs, sign.args[1], 31i64)) {
      continue;
    }
    let lo = sign.args[0];
    let top = def_of(defs, join.args[k]);
    let chain = if (uses[sign.result] == 1) { 1 } else { 0 };
    let sole = uses[top.result] == 1;
    if (signed_extension(top)) {
      top = def_of(defs, top.args[0]);
      sole = sole && uses[top.result] == 1;
    }
    if (top.kind_tag != BINARY || top.str != "add" || top.args.len() != 2 || top.args[0] != lo) {
      continue;
    }
    let span = def_of(defs, top.args[1]);
    if (span.kind_tag == CONST_INT && span.imm >= 0 && span.imm <= 65536) {
      return GroupIndex { lo: lo, span: span.imm, chain: if (sole) { chain + 1 } else { chain } };
    }
  }
  return none;
}

function has_check_only(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if ((ins.kind_tag == ARR_AT || ins.kind_tag == STR_AT) && ins.imm == 2) {
        return true;
      }
    }
  }
  return false;
}

function reads_of(insts: SInst[], from: i32, v: i32): i32 {
  let n = 0;
  for k in from..insts.len() {
    for a in insts[k].args {
      if (a == v) {
        n += 1;
      }
    }
  }
  return n;
}

// A check with no read takes the index `(lo + span) | (lo >> 31)`. That index
// is not below a length when lo is negative or lo + span is past the end. The
// zero-extended lo plus span gives the same answer, because no length reaches
// 2^31. After the check lo is not negative, so each later read of lo in the
// block takes the zero-extended value when that leaves lo with no read.
pub function unsigned_group_checks(f: SFunc): SFunc {
  if (!has_check_only(f)) {
    return f;
  }
  let defs = inst_defs(f);
  let uses = use_counts(f);
  let nvals = f.nvals;
  let blocks: SBlock[] = [];
  for blk in f.blocks {
    let insts: SInst[] = [];
    let lo = -1;
    let wide = -1;
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      if (lo >= 0 && ins.kind_tag != PHI) {
        for a in 0..ins.args.len() {
          if (ins.args[a] == lo) {
            ins = SInst { ...ins, args: ins.args.with(a, wide) };
          }
        }
      }
      let g = group_index(defs, uses, ins);
      if (g.lo < 0) {
        insts = insts.append(ins);
        continue;
      }
      let src = g.lo;
      if (signed_extension(def_of(defs, src))) {
        src = def_of(defs, src).args[0];
      }
      insts = insts.append(SInst { kind_tag: UNARY, result: nvals, args: [src], imm: 0, str: "int_cast:u32" });
      insts = insts.append(SInst { kind_tag: CONST_INT, result: nvals + 1, args: [], imm: g.span, str: "" });
      insts = insts.append(SInst { kind_tag: BINARY, result: nvals + 2, args: [nvals, nvals + 1], imm: 64, str: "add" });
      insts = insts.append(SInst { ...ins, args: ins.args.with(1, nvals + 2) });
      if (reads_of(blk.insts, k + 1, g.lo) == uses[g.lo] - g.chain) {
        lo = g.lo;
        wide = nvals;
      } else {
        lo = -1;
      }
      nvals += 3;
    }
    blocks = blocks.append(SBlock { ...blk, insts: insts });
  }
  if (nvals == f.nvals) {
    return f;
  }
  return prune_dead(SFunc { ...f, blocks: blocks, nvals: nvals });
}

// An index reads a sign- and a zero-extended i32 the same: no length reaches 2^31, so a negative index fails either way.
pub function zero_extended_indices(f: SFunc): SFunc {
  let at_index = __alloc_i32(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag >= ARR_AT && ins.kind_tag <= STR_AT && ins.args.len() >= 2 && ins.args[1] >= 0 && ins.args[1] < f.nvals) {
        at_index = at_index.with(ins.args[1], at_index[ins.args[1]] + 1);
      }
    }
  }
  let uses = use_counts(f);
  let zero = __alloc_bool(f.nvals);
  let any = false;
  for blk in f.blocks {
    for ins in blk.insts {
      if (signed_extension(ins) && ins.result >= 0 && ins.result < f.nvals && uses[ins.result] > 0 && at_index[ins.result] == uses[ins.result]) {
        zero = zero.with(ins.result, true);
        any = true;
      }
    }
  }
  if (!any) {
    return f;
  }
  let blocks: SBlock[] = [];
  for blk in f.blocks {
    let insts: SInst[] = [];
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals && zero[ins.result]) {
        insts = insts.append(SInst { ...ins, str: "u32_wrap" });
      } else {
        insts = insts.append(ins);
      }
    }
    blocks = blocks.append(SBlock { ...blk, insts: insts });
  }
  return SFunc { ...f, blocks: blocks };
}

function lane_constant_fact(ins: SInst): i32 {
  if (ins.kind_tag != CONST_FLOAT) {
    return 0;
  }
  if (ins.str == "0") {
    return 1;
  }
  return if (ins.str == "4611686018427387904") { 2 } else { 0 };
}

function lane_identity(ins: SInst, facts: i32[]): SInst {
  if (ins.kind_tag == TERNARY && ins.str == "vselect" && ins.args.len() == 3) {
    if (facts[ins.args[1]] == 1) {
      return SInst { ...ins, kind_tag: BINARY, str: "vand", args: [ins.args[0], ins.args[2]] };
    }
    if (facts[ins.args[0]] == 1) {
      return SInst { ...ins, kind_tag: BINARY, str: "vandnot", args: [ins.args[1], ins.args[2]] };
    }
  }
  if (ins.kind_tag == BINARY && (ins.str == "vmul" || ins.str == "fmul") && (facts[ins.args[0]] == 2 || facts[ins.args[1]] == 2)) {
    let a = if (facts[ins.args[0]] == 2) { ins.args[1] } else { ins.args[0] };
    let op = if (ins.str == "fmul") { "fadd" } else { "vadd" };
    return SInst { ...ins, str: op, args: [a, a] };
  }
  return ins;
}

pub function fold_lane_identities(f: SFunc): SFunc {
  let has_two = false;
  let has_zero = false;
  let has_multiply = false;
  let has_select = false;
  for blk in f.blocks {
    for ins in blk.insts {
      let fact = lane_constant_fact(ins);
      has_two = has_two || fact == 2;
      has_zero = has_zero || fact == 1;
      has_multiply = has_multiply || ins.kind_tag == BINARY && (ins.str == "vmul" || ins.str == "fmul");
      has_select = has_select || ins.kind_tag == TERNARY && ins.str == "vselect";
    }
  }
  if (!(has_two && has_multiply || has_zero && has_select)) {
    return f;
  }
  let facts = __alloc_i32(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      let fact = lane_constant_fact(ins);
      if (fact != 0) {
        facts = facts.with(ins.result, fact);
      }
    }
  }
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == UNARY && ins.args.len() == 1 && (ins.str == "vsplat" || facts[ins.args[0]] == 1 && (ins.str == "f32_bits" || ins.str == "f32_from_bits"))) {
        facts = facts.with(ins.result, facts[ins.args[0]]);
      }
    }
  }
  let blocks: SBlock[] = [];
  for blk in f.blocks {
    let insts: SInst[] = [];
    for ins in blk.insts {
      insts = insts.append(lane_identity(ins, facts));
    }
    blocks = blocks.append(SBlock { ...blk, insts: insts });
  }
  return SFunc { ...f, blocks: blocks };
}

function without_lines(f: SFunc): SFunc {
  if (!has_kind(f, 35)) {
    return f;
  }
  let blocks: SBlock[] = [];
  for b in f.blocks {
    let insts: SInst[] = [];
    for ins in b.insts {
      if (ins.kind_tag != LINE) {
        insts = insts.append(ins);
      }
    }
    blocks = blocks.append(SBlock { ...b, insts: insts });
  }
  return SFunc { ...f, blocks: blocks };
}

// A call that reads its target out of its own environment. The text is
// "slot", or "slot:" and the contract of the call (ir.call_units).
pub function slot_call(ins: SInst): boolean {
  return ins.kind_tag == CALL_IND && (ins.str == "slot" || ins.str.starts_with("slot:"));
}

// The text of a call that reads its target out of its own environment, with
// the contract that `text` holds.
function slot_text(text: string): string {
  if (text.len() == 0) {
    return "slot";
  }
  return "slot:" + text;
}

function slot_calls(f: SFunc): SFunc {
  if (!has_kind(f, 56)) {
    return f;
  }
  let env_of = slot_reads(f);
  let uses = use_counts(f);
  let dropped = __alloc_bool(f.nvals);
  let found = false;
  for blk in f.blocks {
    for ins in blk.insts {
      if (reads_own_slot(ins, env_of, uses)) {
        dropped = dropped.with(ins.args[0], true);
        found = true;
      }
    }
  }
  if (!found) {
    return f;
  }
  let out: SBlock[] = [];
  for blk in f.blocks {
    out = out.append(slot_block(blk, env_of, uses, dropped));
  }
  return SFunc { ...f, blocks: out };
}

pub function has_kind(f: SFunc, k: i32): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == k) {
        return true;
      }
    }
  }
  return false;
}

function slot_reads(f: SFunc): i32[] {
  let zero = __alloc_bool(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == CONST_INT && ins.imm == 0) {
        zero = zero.with(ins.result, true);
      }
    }
  }
  let env_of = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == ARR_AT && ins.imm == 1 && ins.str == "" && zero[ins.args[1]]) {
        env_of = env_of.with(ins.result, ins.args[0]);
      }
    }
  }
  return env_of;
}

function slot_block(blk: SBlock, env_of: i32[], uses: i32[], dropped: boolean[]): SBlock {
  let edit = false;
  for ins in blk.insts {
    edit = edit || reads_own_slot(ins, env_of, uses) || ins.kind_tag == ARR_AT && dropped[ins.result];
  }
  if (!edit) {
    return blk;
  }
  let insts: SInst[] = [];
  for ins in blk.insts {
    if (reads_own_slot(ins, env_of, uses)) {
      insts = insts.append(SInst { ...ins, args: ins.args.with(0, ins.args[1]), str: slot_text(ins.str) });
    } else if (ins.kind_tag != ARR_AT || !dropped[ins.result]) {
      insts = insts.append(ins);
    }
  }
  return SBlock { ...blk, insts: insts };
}

function reads_own_slot(ins: SInst, env_of: i32[], uses: i32[]): boolean {
  return ins.kind_tag == CALL_IND && ins.args.len() > 1 && env_of[ins.args[0]] == ins.args[1] && uses[ins.args[0]] == 1;
}

function share_shape_loads(f: SFunc): Formed {
  let stored = __alloc_bool(f.nvals);
  let loads = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      let k = ins.kind_tag;
      if (k == STORE_ELEM || k == ST_IDX || k == ST_BYTE) {
        return Formed { f: f, repl: [] };
      }
      if ((k == ST_AT && ins.imm <= 0 || k == ARR_ST) && ins.args.len() > 0 && ins.args[0] >= 0 && ins.args[0] < f.nvals) {
        stored = stored.with(ins.args[0], true);
      }
      if (shape_load(ins, f.nvals)) {
        loads += 1;
      }
    }
  }
  if (loads < 2) {
    return Formed { f: f, repl: [] };
  }
  let repl = earlier_shapes(f, stored);
  if (repl.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  return Formed { f: rewrite_through(f, repl), repl: repl };
}

// Checked reads and writes of one array in a block, with no write of
// memory between them other than to its elements, share one load of its
// length. The length is then a value, and each check compares the index
// with it. A target that compares with the length in memory gains nothing.
pub function shared_lengths(f: SFunc): SFunc {
  let used = used_values(f);
  let made: i32[] = [];
  let blocks: SBlock[] = [];
  for blk in f.blocks {
    let wins = length_windows(blk.insts, used);
    if (!wins.shared) {
      blocks = blocks.append(blk);
      continue;
    }
    let lens = wins.count.map((c: i32): i32 => -1);
    let insts: SInst[] = [];
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      let w = wins.of[k];
      if (w < 0 || wins.count[w] < 2) {
        insts = insts.append(ins);
        continue;
      }
      if (lens[w] < 0) {
        lens = lens.with(w, f.nvals + made.len());
        made = made.append(w);
        insts = insts.append(SInst { kind_tag: LD_AT, result: lens[w], args: [ins.args[0]], imm: if (ins.kind_tag == STR_AT) { 8 } else { 0 }, str: "" });
      }
      insts = insts.append(SInst { kind_tag: BOUND, result: -1, args: [ins.args[1], lens[w]], imm: if (ins.kind_tag == STR_AT) { 1 } else { 0 }, str: "" });
      if (ins.kind_tag == ARR_ST || ins.imm == 0) {
        insts = insts.append(SInst { ...ins, imm: 1 });
      }
    }
    blocks = blocks.append(SBlock { ...blk, insts: insts });
  }
  if (made.len() == 0) {
    return f;
  }
  return SFunc { ...f, blocks: blocks, nvals: f.nvals + made.len() };
}

// Each AGG_LIT of one constant gives the same address. Where one of them
// reaches another on each path with no call between them, the second reads
// the value of the first, so a target forms the address once. `hard` says
// which positions are calls, as hard_call_positions gives them. A value that
// lives across a call needs a register that the call keeps, so a call ends
// the reach.
pub function shared_static_boxes(f: SFunc, hard: boolean[]): SFunc {
  let keys: string[] = [];
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == AGG_LIT && ins.result >= 0 && !util.has_str(keys, ins.str)) {
        keys = keys.append(ins.str);
      }
    }
  }
  if (keys.len() == 0) {
    return f;
  }
  let at = block_positions(f);
  let first: i32[] = [];
  let pos = 0;
  for blk in f.blocks {
    first = first.append(pos);
    pos += blk.insts.len() + 1;
  }
  let flat: i32[] = [];
  for v in 0..f.nvals {
    flat = flat.append(v);
  }
  let shared = false;
  for key in keys {
    let outs = box_reach(f, at, first, hard, key);
    for bi in 0..f.blocks.len() {
      let cur = box_reach_in(f, at, outs, bi);
      let blk = f.blocks[bi];
      for k in 0..blk.insts.len() {
        let ins = blk.insts[k];
        if (hard[first[bi] + k]) {
          cur = -1;
        }
        if (ins.kind_tag == AGG_LIT && ins.result >= 0 && ins.str == key) {
          if (cur >= 0) {
            flat = flat.with(ins.result, cur);
            shared = true;
          } else {
            cur = ins.result;
          }
        }
      }
    }
  }
  if (!shared) {
    return f;
  }
  return rewrite_through(f, flat);
}

// The static box of a variant with no field has a key that ends in `|`.
// Such a box that a loop reads gets its address once, at the start of the
// entry block, and each AGG_LIT of that constant in the function reads that
// value. A loop then forms no address in each turn. A block is in a loop
// when a branch from it or from a later block goes to it or to an earlier
// block.
pub function hoisted_static_boxes(f: SFunc): SFunc {
  if (f.blocks.len() < 2 || f.blocks[0].term.kind_tag != TERM_BR) {
    return f;
  }
  let at = block_positions(f);
  let n = f.blocks.len();
  let looped = __alloc_bool(n);
  let any = false;
  for bi in 0..n {
    for id in successors(f.blocks[bi].term) {
      let tgt = position_of(at, id);
      if (tgt >= 0 && tgt <= bi) {
        for k in tgt..=bi {
          looped = looped.with(k, true);
        }
        any = true;
      }
    }
  }
  if (!any) {
    return f;
  }
  let keys: string[] = [];
  let firsts: SInst[] = [];
  for bi in 0..n {
    for ins in f.blocks[bi].insts {
      if (looped[bi] && ins.kind_tag == AGG_LIT && ins.result >= 0 && ins.str.ends_with("|") && !util.has_str(keys, ins.str)) {
        keys = keys.append(ins.str);
        firsts = firsts.append(ins);
      }
    }
  }
  if (keys.len() == 0) {
    return f;
  }
  let flat: i32[] = [];
  for v in 0..f.nvals + keys.len() {
    flat = flat.append(v);
  }
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == AGG_LIT && ins.result >= 0) {
        let k = util.index_of_str(keys, ins.str);
        if (k >= 0) {
          flat = flat.with(ins.result, f.nvals + k);
        }
      }
    }
  }
  // The entry block can read the constant too, so the address goes before
  // its first instruction that is not a parameter.
  let entry = f.blocks[0];
  let insts: SInst[] = [];
  let placed = false;
  for ins in entry.insts {
    if (!placed && ins.kind_tag != PARAM) {
      for k in 0..keys.len() {
        insts = insts.append(SInst { ...firsts[k], result: f.nvals + k });
      }
      placed = true;
    }
    insts = insts.append(ins);
  }
  if (!placed) {
    for k in 0..keys.len() {
      insts = insts.append(SInst { ...firsts[k], result: f.nvals + k });
    }
  }
  let blocks = f.blocks.with(0, SBlock { ...entry, insts: insts });
  return rewrite_through(SFunc { ...f, blocks: blocks, nvals: f.nvals + keys.len() }, flat);
}

// The AGG_LIT of `key` that reaches the end of each block, -1 for none, and
// -2 for a block that the walk did not reach.
function box_reach(f: SFunc, at: i32[], first: i32[], hard: boolean[], key: string): i32[] {
  let outs: i32[] = [];
  for blk in f.blocks {
    outs = outs.append(-2);
  }
  let changed = true;
  while (changed) {
    changed = false;
    for bi in 0..f.blocks.len() {
      let cur = box_reach_in(f, at, outs, bi);
      let blk = f.blocks[bi];
      for k in 0..blk.insts.len() {
        if (hard[first[bi] + k]) {
          cur = -1;
        }
        let ins = blk.insts[k];
        if (cur < 0 && ins.kind_tag == AGG_LIT && ins.result >= 0 && ins.str == key) {
          cur = ins.result;
        }
      }
      if (cur != outs[bi]) {
        outs = outs.with(bi, cur);
        changed = true;
      }
    }
  }
  return outs;
}

// The value that each predecessor of the block at bi gives. A predecessor
// that the walk did not reach yet gives no opinion.
function box_reach_in(f: SFunc, at: i32[], outs: i32[], bi: i32): i32 {
  let blk = f.blocks[bi];
  if (bi == 0 || blk.preds.len() == 0) {
    return -1;
  }
  let cur = -2;
  for p in blk.preds {
    let pi = position_of(at, p);
    if (pi < 0) {
      return -1;
    }
    let o = outs[pi];
    if (o == -2) {
      continue;
    }
    if (cur == -2) {
      cur = o;
    } else if (cur != o) {
      return -1;
    }
  }
  return if (cur == -2) { -1 } else { cur };
}

// `used[v]` is true when an instruction or a terminator reads value v.
function used_values(f: SFunc): boolean[] {
  let used = __alloc_bool(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      for a in ins.args {
        if (a >= 0 && a < f.nvals) {
          used = used.with(a, true);
        }
      }
    }
    let v = term_use(blk.term);
    if (v >= 0 && v < f.nvals) {
      used = used.with(v, true);
    }
  }
  return used;
}

// The value that a terminator reads, or -1.
function term_use(t: STerm): i32 {
  if (t.kind_tag == TERM_BRIF) {
    return t.cond;
  }
  if (t.kind_tag == TERM_RET) {
    return t.value;
  }
  return -1;
}

// `of[k]` is the window of the checked access at k, or -1, and `count[w]`
// the accesses of window w. A window holds the accesses of one array up to
// a write that can change a length.
struct Windows { of: i32[], count: i32[], shared: boolean }

function length_windows(insts: SInst[], used: boolean[]): Windows {
  let of: i32[] = [];
  let count: i32[] = [];
  let bases: i32[] = [];
  let open: i32[] = [];
  let shared = false;
  for ins in insts {
    if (length_checked(ins, used)) {
      let w = -1;
      for j in 0..bases.len() {
        if (bases[j] == ins.args[0]) {
          w = open[j];
        }
      }
      if (w < 0) {
        w = count.len();
        count = count.append(0);
        bases = bases.append(ins.args[0]);
        open = open.append(w);
      }
      count = count.with(w, count[w] + 1);
      shared = shared || count[w] >= 2;
      of = of.append(w);
      continue;
    }
    of = of.append(-1);
    if (inst_has_effect(ins.kind_tag) && ins.kind_tag != LINE && ins.kind_tag != ARR_AT && ins.kind_tag != STR_AT && ins.kind_tag != ARR_ST && ins.kind_tag != BOUND) {
      bases = [];
      open = [];
    }
  }
  return Windows { of: of, count: count, shared: shared };
}

// A read, a check alone whose result has no use, or a write of an array
// that compares its index with the length in the array, or such a read of
// a string.
function length_checked(ins: SInst, used: boolean[]): boolean {
  if (ins.kind_tag == ARR_AT || ins.kind_tag == STR_AT) {
    return ins.args.len() == 2 && (ins.imm == 0 || ins.imm == 2 && (ins.result < 0 || !used[ins.result]));
  }
  return ins.kind_tag == ARR_ST && ins.args.len() == 3 && ins.imm == 0;
}

// For each shape load, the nearest shape load of the same word before it
// with no write of memory between them, as its replacement. The search goes
// back in the block, and then through each block that is the one earlier
// predecessor of the block after it. Those links make a forest, and a walk
// of the forest keeps the loads that are on the path to the current block.
// `seen` has the last load of each word on the path, and `since` the last
// write on the path when the load was seen: 0 for none, or the number of the
// instruction that wrote. A block undoes its entries when the walk leaves it.
function earlier_shapes(f: SFunc, stored: boolean[]): i32[] {
  let at = block_positions(f);
  let n = f.blocks.len();
  let parent = util.minus_ones(n);
  let child = util.minus_ones(n);
  let sibling = util.minus_ones(n);
  let first = __alloc_i32(n);
  let insts = 1;
  for b in 0..n {
    first = first.with(b, insts);
    insts = insts + f.blocks[b].insts.len();
    if (f.blocks[b].preds.len() == 1) {
      let pb = position_of(at, f.blocks[b].preds[0]);
      if (pb >= 0 && pb < b) {
        parent = parent.with(b, pb);
        sibling = sibling.with(b, child[pb]);
        child = child.with(pb, b);
      }
    }
  }
  let seen = util.minus_ones(2 * f.nvals);
  let since = __alloc_i32(2 * f.nvals);
  // Each undo entry is a slot, its `seen` and its `since`.
  let undo = util.stack();
  let mark = __alloc_i32(n);
  let entry = __alloc_i32(n);
  let wrote = 0;
  let repl: i32[] = [];
  // A block to enter, or -1 - b for a block b to leave.
  let todo = util.stack();
  for root in 0..n {
    if (parent[root] >= 0) {
      continue;
    }
    wrote = 0;
    todo = util.stack_push(todo, root);
    while (util.stack_len(todo) > 0) {
      let top = util.stack_at(todo, 0);
      todo = util.stack_pop(todo, 1);
      if (top < 0) {
        let done = -1 - top;
        while (util.stack_len(undo) > mark[done]) {
          let slot = util.stack_at(undo, 2);
          seen = seen.with(slot, util.stack_at(undo, 1));
          since = since.with(slot, util.stack_at(undo, 0));
          undo = util.stack_pop(undo, 3);
        }
        wrote = entry[done];
        continue;
      }
      mark = mark.with(top, util.stack_len(undo));
      entry = entry.with(top, wrote);
      let block = f.blocks[top].insts;
      for k in 0..block.len() {
        let ins = block[k];
        if (shape_load(ins, f.nvals)) {
          let slot = 2 * ins.args[0] + (if (ins.imm == 0) { 0 } else { 1 });
          if (!stored[ins.args[0]] && seen[slot] >= 0 && since[slot] == wrote) {
            if (repl.len() == 0) {
              repl = identity_repl(f.nvals);
            }
            repl = repl.with(ins.result, repl[seen[slot]]);
          }
          undo = util.stack_push(util.stack_push(util.stack_push(undo, slot), seen[slot]), since[slot]);
          seen = seen.with(slot, ins.result);
          since = since.with(slot, wrote);
        }
        if (may_write(ins.kind_tag)) {
          wrote = first[top] + k;
        }
      }
      todo = util.stack_push(todo, -1 - top);
      let c = child[top];
      while (c >= 0) {
        todo = util.stack_push(todo, c);
        c = sibling[c];
      }
    }
  }
  return repl;
}

function may_write(k: i32): boolean {
  return inst_has_effect(k) && k != LINE && k != ARR_AT && k != STR_AT;
}

// A load of the first word of a block, or of the shape tag in the header of
// a box.
function shape_load(ins: SInst, nvals: i32): boolean {
  if (ins.kind_tag != LD_AT || ins.args.len() != 1 || ins.args[0] < 0 || ins.args[0] >= nvals || ins.result < 0 || ins.result >= nvals) {
    return false;
  }
  return ins.imm == 0 && ins.str == "" || ins.imm == tag_offset() && ins.str == "u32";
}

pub function fold_byte_access(f: SFunc): Formed {
  if (!has_byte_access(f)) {
    return Formed { f: f, repl: [] };
  }
  let def_b = __alloc_i32(f.nvals);
  let def_k = __alloc_i32(f.nvals);
  for i in 0..f.nvals {
    def_b = def_b.with(i, -1);
    def_k = def_k.with(i, -1);
  }
  for bi in 0..f.blocks.len() {
    let k = 0;
    while (k < f.blocks[bi].insts.len()) {
      let r = f.blocks[bi].insts[k].result;
      if (r >= 0 && r < f.nvals) {
        def_b = def_b.with(r, bi);
        def_k = def_k.with(r, k);
      }
      k += 1;
    }
  }
  let uses = use_counts(f);
  let changed = false;
  let nblocks: SBlock[] = [];
  for blk in f.blocks {
    let ninsts: SInst[] = [];
    for ins0 in blk.insts {
      let ins = ins0;
      if ((ins.kind_tag == LD_BYTE || ins.kind_tag == ST_BYTE) && const_zero(f, def_b, def_k, ins.args[1])) {
        let base = ins.args[0];
        let d = def_at(f, def_b, def_k, base);
        if (d.kind_tag == BINARY && d.str == "add" && d.imm == 64 && d.args.len() == 2 && base >= 0 && base < uses.len() && uses[base] == 1) {
          let nargs: i32[] = [d.args[0], d.args[1]];
          if (ins.kind_tag == ST_BYTE) {
            nargs = nargs.append(ins.args[2]);
          }
          ins = SInst { ...ins, args: nargs };
          changed = true;
        }
      }
      ninsts = ninsts.append(ins);
    }
    nblocks = nblocks.append(SBlock { ...blk, insts: ninsts });
  }
  if (!changed) {
    return Formed { f: f, repl: [] };
  }
  return Formed { f: SFunc { ...f, blocks: nblocks }, repl: identity_repl(f.nvals) };
}

function has_byte_access(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == LD_BYTE || ins.kind_tag == ST_BYTE) {
        return true;
      }
    }
  }
  return false;
}

// What a register is known to hold: a sign-extended i32, a zero-extended u32,
// or a byte, which is both.
const EXT_I32: i32 = 1;

const EXT_U32: i32 = 2;

const EXT_BYTE: i32 = 7;

// Replaces a wrap, extension or narrowing cast by its operand when the
// operand's register already holds the result. A phi or a select holds what
// all its operands hold. The facts start full and only shrink, so a loop
// phi keeps what its back edge keeps.
pub function fold_extensions(f: SFunc): Formed {
  if (!has_extension(f)) {
    return Formed { f: f, repl: [] };
  }
  let d = def_sites_of(f);
  let facts = ext_facts(f, d);
  if (facts.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  let repl = dropped_extensions(f, facts);
  if (repl.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  let flat = formed_by(f, repl);
  return Formed { f: rewrite_through(f, flat.repl), repl: flat.repl };
}

// Native 32-bit right shifts preserve a proven narrow source. Mode 1 needs
// sign extension afterwards; mode 2 already has a zero-extended result.
// Other shifts retain their full-width physical IR semantics.
pub function narrow_right_shifts(f: SFunc, imm: Imms): i32[] {
  let any = false;
  for blk in f.blocks {
    for ins in blk.insts {
      any = any || narrow_shift_candidate(ins, imm);
    }
  }
  if (!any) {
    return [];
  }
  let facts = ext_facts(f, def_sites_of(f));
  if (facts.len() == 0) {
    return [];
  }
  let modes = __alloc_i32(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (narrow_shift_candidate(ins, imm)) {
        let held = fact_of(facts, ins.args[0]);
        if (ins.str == "shr_s" && (held & EXT_I32) != 0) {
          modes = modes.with(ins.result, if ((held & EXT_U32) != 0) { 2 } else { 1 });
        } else if (ins.str == "shr_u" && (held & EXT_U32) != 0) {
          modes = modes.with(ins.result, 2);
        }
      }
    }
  }
  return modes;
}

function narrow_shift_candidate(ins: SInst, imm: Imms): boolean {
  return ins.kind_tag == BINARY && ins.args.len() == 2 && ins.imm != 64
    && (ins.str == "shr_s" || ins.str == "shr_u") && !imm.is_imm[ins.args[1]];
}

pub struct DefSites { block: i32[], at: i32[] }

pub function def_sites_of(f: SFunc): DefSites {
  let blk = util.minus_ones(f.nvals);
  let at = util.minus_ones(f.nvals);
  for bi in 0..f.blocks.len() {
    for k in 0..f.blocks[bi].insts.len() {
      let r = f.blocks[bi].insts[k].result;
      if (r >= 0 && r < f.nvals) {
        blk = blk.with(r, bi);
        at = at.with(r, k);
      }
    }
  }
  return DefSites { block: blk, at: at };
}

// The fixed point, or [] when 64 rounds do not settle it.
function ext_facts(f: SFunc, d: DefSites): i32[] {
  let facts = __alloc_i32(f.nvals);
  for v in 0..f.nvals {
    if (d.block[v] >= 0) {
      facts = facts.with(v, EXT_BYTE);
    }
  }
  for round in 0..64 {
    let next = ext_round(f, d, facts);
    if (next.len() == 0) {
      return facts;
    }
    facts = next;
  }
  return [];
}

// One pass over the instructions, or [] when no fact shrank.
function ext_round(f: SFunc, d: DefSites, facts: i32[]): i32[] {
  let changed = false;
  for blk in f.blocks {
    for ins in blk.insts {
      let r = ins.result;
      if (r >= 0 && r < f.nvals) {
        let x = ext_transfer(f, d.block, d.at, facts, ins) & facts[r];
        changed = changed || x != facts[r];
        facts = facts.with(r, x);
      }
    }
  }
  if (!changed) {
    return [];
  }
  return facts;
}

// The replacement map, or [] when no extension goes.
function dropped_extensions(f: SFunc, facts: i32[]): i32[] {
  let repl = identity_repl(f.nvals);
  let dropped = false;
  for blk in f.blocks {
    for ins in blk.insts {
      if (drops(f, facts, ins)) {
        repl = repl.with(ins.result, ins.args[0]);
        dropped = true;
      }
    }
  }
  if (!dropped) {
    return [];
  }
  return repl;
}

function drops(f: SFunc, facts: i32[], ins: SInst): boolean {
  return ins.result >= 0 && ins.result < f.nvals && ins.args.len() == 1 && ins.args[0] >= 0 && ins.args[0] < f.nvals && holds_result(ins, facts[ins.args[0]]);
}

function has_extension(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (signed_extension(ins) || unsigned_extension(ins) || ins.kind_tag == UNARY && (ins.str == "int_cast:u8" || ins.str == "int_cast:u16" || ins.str == "int_cast:i16")) {
        return true;
      }
    }
  }
  return false;
}

function signed_extension(ins: SInst): boolean {
  return ins.kind_tag == UNARY && ins.args.len() == 1 && ins.imm == 0 && (ins.str == "int_wrap" || ins.str == "int_extend" || ins.str == "int_cast:i32");
}

function unsigned_extension(ins: SInst): boolean {
  if (ins.kind_tag != UNARY || ins.args.len() != 1) {
    return false;
  }
  return ins.str == "u32_wrap" || ins.str == "int_cast:u32" || ins.imm != 0 && (ins.str == "int_wrap" || ins.str == "int_extend");
}

function holds_result(ins: SInst, held: i32): boolean {
  if (signed_extension(ins)) {
    return (held & EXT_I32) != 0;
  }
  if (unsigned_extension(ins)) {
    return (held & EXT_U32) != 0;
  }
  return ins.kind_tag == UNARY && ins.str == "int_cast:u8" && held == EXT_BYTE;
}

function ext_transfer(f: SFunc, def_b: i32[], def_k: i32[], facts: i32[], ins: SInst): i32 {
  let k = ins.kind_tag;
  if (k >= CONST_INT && k <= CONST_I64) {
    return constant_facts(ins);
  }
  if (k == COPY || k == PHI) {
    return shared_facts(facts, ins.args, 0);
  }
  if (k == SELECT) {
    return shared_facts(facts, ins.args, 1);
  }
  let loaded = source_facts(f, def_b, def_k, ins);
  if (loaded != 0) {
    return loaded;
  }
  if (k == BINARY) {
    return binary_facts(f, def_b, def_k, facts, ins);
  }
  if (k == UNARY && ins.args.len() == 1) {
    return unary_facts(ins, fact_of(facts, ins.args[0]));
  }
  return 0;
}

function constant_facts(ins: SInst): i32 {
  if (ins.kind_tag == CONST_INT) {
    return const_facts(ins.imm as i64);
  }
  if (ins.kind_tag == CONST_BOOL) {
    return EXT_BYTE;
  }
  return const_facts(util.lit_to_i64(ins.str));
}

function const_facts(c: i64): i32 {
  if (c >= 0i64 && c <= 255i64) {
    return EXT_BYTE;
  }
  let out = 0;
  if (c >= 0 - 2147483648i64 && c <= 2147483647i64) {
    out = EXT_I32;
  }
  if (c >= 0i64 && c <= 4294967295i64) {
    out = out | EXT_U32;
  }
  return out;
}

function fact_of(facts: i32[], v: i32): i32 {
  if (v < 0 || v >= facts.len()) {
    return 0;
  }
  return facts[v];
}

function shared_facts(facts: i32[], args: i32[], from: i32): i32 {
  let out = EXT_BYTE;
  for i in from..args.len() {
    out = out & fact_of(facts, args[i]);
  }
  return out;
}

function binary_facts(f: SFunc, def_b: i32[], def_k: i32[], facts: i32[], ins: SInst): i32 {
  if (ins.args.len() != 2) {
    return 0;
  }
  if (compare_op(ins.str)) {
    return EXT_BYTE;
  }
  if (ins.str == "and") {
    return and_facts(fact_of(facts, ins.args[0]), fact_of(facts, ins.args[1]));
  }
  let source = fact_of(facts, ins.args[0]);
  if (ins.str == "shr_s" && (source & EXT_I32) != 0) {
    return source;
  }
  if (ins.str == "shr_u" && (source & EXT_U32) != 0) {
    let result = source | narrowed_facts(f, def_b, def_k, ins.args[1]);
    if (ins.imm == 64) {
      result = result | shifted_facts(f, def_b, def_k, ins.args[1]);
    }
    return result;
  }
  if (ins.str == "shr_u" && ins.imm == 64) {
    return shifted_facts(f, def_b, def_k, ins.args[1]);
  }
  return 0;
}

// A u32 shifted right by a constant from 1 to 31 is a non-negative i32.
function narrowed_facts(f: SFunc, def_b: i32[], def_k: i32[], count: i32): i32 {
  if (const_in(f, def_b, def_k, count, 24i64, 31i64)) {
    return EXT_BYTE;
  }
  if (const_in(f, def_b, def_k, count, 1i64, 31i64)) {
    return 3;
  }
  return 0;
}

function compare_op(op: string): boolean {
  return op == "eq" || op == "ne" || op.starts_with("lt_") || op.starts_with("le_") || op.starts_with("gt_") || op.starts_with("ge_");
}

// An and with a byte is a byte, and one with a non-negative i32 is one.
function and_facts(a: i32, b: i32): i32 {
  if ((a | b) == EXT_BYTE) {
    return EXT_BYTE;
  }
  if ((a & 3) == 3 || (b & 3) == 3) {
    return 3;
  }
  return (a | b) & EXT_U32;
}

function shifted_facts(f: SFunc, def_b: i32[], def_k: i32[], count: i32): i32 {
  if (const_in(f, def_b, def_k, count, 56i64, 63i64)) {
    return EXT_BYTE;
  }
  if (const_in(f, def_b, def_k, count, 33i64, 63i64)) {
    return 3;
  }
  if (const_in(f, def_b, def_k, count, 32i64, 63i64)) {
    return EXT_U32;
  }
  return 0;
}

// A unary that loads from its operand's address: a sign-extended i32, or a 16-bit word.
pub function is_unary_load(what: string): boolean {
  return what == "load_i32" || what == "load_u16";
}

function unary_facts(ins: SInst, held: i32): i32 {
  if (is_unary_load(ins.str)) {
    return if (ins.str == "load_u16") { EXT_I32 | EXT_U32 } else { EXT_I32 };
  }
  if (signed_extension(ins)) {
    if ((held & EXT_I32) != 0) {
      return held;
    }
    return EXT_I32;
  }
  if (unsigned_extension(ins)) {
    if ((held & EXT_U32) != 0) {
      return held;
    }
    return EXT_U32;
  }
  if (ins.str == "int_cast:u8" || ins.str.starts_with("ctz:") || ins.str.starts_with("clz:") || ins.str.starts_with("popcount:")) {
    return EXT_BYTE;
  }
  if (ins.str == "int_cast:u16") {
    return EXT_I32 | EXT_U32;
  }
  return if (ins.str == "int_cast:i16") { EXT_I32 } else { 0 };
}

// What a load or a byte mask leaves in its register, or 0.
function source_facts(f: SFunc, def_b: i32[], def_k: i32[], ins: SInst): i32 {
  if (ins.kind_tag == LD_BYTE) {
    return EXT_BYTE;
  }
  if (ins.kind_tag == ARR_AT || ins.kind_tag == STR_AT) {
    return if (ins.imm == 2 || ins.imm == 3) { 0 } else { elem_facts(ins) };
  }
  if (ins.kind_tag == LD_AT) {
    return elem_facts(ins);
  }
  if (ins.kind_tag == BINARY && ins.str == "and" && ins.args.len() == 2 && (const_in(f, def_b, def_k, ins.args[0], 0i64, 255i64) || const_in(f, def_b, def_k, ins.args[1], 0i64, 255i64))) {
    return EXT_BYTE;
  }
  return 0;
}

function elem_facts(ins: SInst): i32 {
  if (ins.kind_tag == STR_AT || ins.str == "u8") {
    return EXT_BYTE;
  }
  if (ins.str == "u16") {
    return EXT_I32 | EXT_U32;
  }
  if (ins.str == "i32" || ins.str == "i16") {
    return EXT_I32;
  }
  return if (ins.str == "u32") { EXT_U32 } else { 0 };
}

function const_zero(f: SFunc, def_b: i32[], def_k: i32[], v: i32): boolean {
  return const_in(f, def_b, def_k, v, 0i64, 0i64);
}

function const_in(f: SFunc, def_b: i32[], def_k: i32[], v: i32, lo: i64, hi: i64): boolean {
  let d = def_at(f, def_b, def_k, v);
  if (d.kind_tag == CONST_INT) {
    return d.imm as i64 >= lo && d.imm as i64 <= hi;
  }
  if (d.kind_tag == CONST_I64) {
    let c = util.lit_to_i64(d.str);
    return c >= lo && c <= hi;
  }
  return false;
}

pub function drop_low_wraps(f: SFunc): Formed {
  if (!has_low_wrap(f)) {
    return Formed { f: f, repl: [] };
  }
  let def_b = __alloc_i32(f.nvals);
  let def_k = __alloc_i32(f.nvals);
  let required = __alloc_i32(f.nvals);
  let prop = __alloc_bool(f.nvals);
  for i in 0..f.nvals {
    def_b = def_b.with(i, -1);
    def_k = def_k.with(i, -1);
  }
  let wraps: i32[] = [];
  let wrap_arg: i32[] = [];
  let params = util.minus_ones(f.nparams);
  for bi in 0..f.blocks.len() {
    let insts = f.blocks[bi].insts;
    for k in 0..insts.len() {
      let ins = insts[k];
      let r = ins.result;
      if (r >= 0 && r < f.nvals) {
        def_b = def_b.with(r, bi);
        def_k = def_k.with(r, k);
        if (demand_propagates(ins)) {
          prop = prop.with(r, true);
        }
        if (ins.kind_tag == PARAM && ins.imm >= 0 && ins.imm < f.nparams) {
          params = params.with(ins.imm, r);
          prop = prop.with(r, true);
        }
        if (low_wrap(ins)) {
          wraps = wraps.append(r);
          wrap_arg = wrap_arg.append(ins.args[0]);
        }
      }
    }
  }
  let work: i32[] = [];
  // Fixed operand requirements are seeded once. Only operations whose
  // operands depend on result demand need to enter the worklist.
  for blk in f.blocks {
    for ins in blk.insts {
      if ((ins.result < 0 || ins.result >= f.nvals || !prop[ins.result]) && !self_call(f, ins)) {
        for ai in 0..ins.args.len() {
          let a = ins.args[ai];
          if (a >= 0 && a < f.nvals && prop[a]) {
            let bits = operand_bits(ins, ai, 0, f, def_b, def_k);
            if (bits > required[a]) {
              required = required.with(a, bits);
              work = work.append(a);
            }
          }
        }
      }
    }
    let tv = term_operand(blk.term);
    if (tv >= 0 && tv < f.nvals && prop[tv] && required[tv] < 64) {
      required = required.with(tv, 64);
      work = work.append(tv);
    }
  }
  required = spread_demand(f, def_b, def_k, prop, required, work);
  while (true) {
    let wants = self_call_demand(f, params, required);
    let fed: i32[] = [];
    for a in 0..f.nvals {
      if (prop[a] && wants[a] > required[a]) {
        required = required.with(a, wants[a]);
        fed = fed.append(a);
      }
    }
    if (fed.len() == 0) {
      break;
    }
    required = spread_demand(f, def_b, def_k, prop, required, fed);
  }
  let repl: i32[] = [];
  let dropped = false;
  let at = block_positions(f);
  let heads = signed_compare_heads(f, def_b, def_k);
  for wj in 0..wraps.len() {
    let w = wraps[wj];
    if (required[w] <= low_wrap_bits(def_at(f, def_b, def_k, w)) || signed_extension(def_at(f, def_b, def_k, w)) && counter_step(f, at, heads, def_b, def_k, wrap_arg[wj])) {
      if (!dropped) {
        for i in 0..f.nvals {
          repl = repl.append(i);
        }
        dropped = true;
      }
      repl = repl.with(w, wrap_arg[wj]);
    }
  }
  if (!dropped) {
    return Formed { f: f, repl: [] };
  }
  let nblocks: SBlock[] = [];
  for blk in f.blocks {
    if (!block_reads_replaced(blk, repl)) {
      nblocks = nblocks.append(blk);
      continue;
    }
    let ninsts: SInst[] = [];
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals && repl[ins.result] != ins.result) {
        continue;
      }
      let nargs: i32[] = [];
      for a in ins.args {
        nargs = nargs.append(resolve_repl(repl, a));
      }
      ninsts = ninsts.append(SInst { ...ins, args: nargs });
    }
    let t = blk.term;
    if (t.kind_tag == TERM_RET) {
      t = STerm { ...t, value: resolve_repl(repl, t.value) };
    } else if (t.kind_tag == TERM_BRIF) {
      t = STerm { ...t, cond: resolve_repl(repl, t.cond) };
    }
    nblocks = nblocks.append(SBlock { ...blk, insts: ninsts, term: t });
  }
  return formed_by(SFunc { ...f, blocks: nblocks }, repl);
}

// The demand of each value once the demand of each value in `work` reaches
// its operands.
function spread_demand(f: SFunc, def_b: i32[], def_k: i32[], prop: boolean[], own required: i32[], own work: i32[]): i32[] {
  let wi = 0;
  while (wi < work.len()) {
    let v = work[wi];
    wi += 1;
    let ins = def_at(f, def_b, def_k, v);
    for ai in 0..ins.args.len() {
      let a = ins.args[ai];
      if (a >= 0 && a < f.nvals && prop[a]) {
        let bits = operand_bits(ins, ai, required[v], f, def_b, def_k);
        if (bits > required[a]) {
          required = required.with(a, bits);
          work = work.append(a);
        }
      }
    }
  }
  return required;
}

// A call of the function itself reads only the bits of an argument that the
// uses of its parameter read.
function self_call(f: SFunc, ins: SInst): boolean {
  return ins.kind_tag == CALL && ins.str == f.name && !f.takes_env && ins.args.len() == f.nparams;
}

// For each value, the largest demand of a parameter that a call of the
// function itself gives it to.
function self_call_demand(f: SFunc, params: i32[], required: i32[]): i32[] {
  let out = __alloc_i32(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (!self_call(f, ins)) {
        continue;
      }
      for k in 0..ins.args.len() {
        let a = ins.args[k];
        if (a >= 0 && a < f.nvals && params[k] >= 0 && required[params[k]] > out[a]) {
          out = out.with(a, required[params[k]]);
        }
      }
    }
  }
  return out;
}

function has_low_wrap(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (low_wrap(ins)) {
        return true;
      }
    }
  }
  return false;
}

function block_reads_replaced(blk: SBlock, repl: i32[]): boolean {
  for ins in blk.insts {
    if (ins.result >= 0 && ins.result < repl.len() && repl[ins.result] != ins.result) {
      return true;
    }
    for a in ins.args {
      if (a >= 0 && a < repl.len() && repl[a] != a) {
        return true;
      }
    }
  }
  let tv = term_operand(blk.term);
  return tv >= 0 && tv < repl.len() && repl[tv] != tv;
}

// x + 1 below a test that x is less than an i32, or x - 1 below a test that x is greater.
function counter_step(f: SFunc, at: i32[], heads: i32[], def_b: i32[], def_k: i32[], a: i32): boolean {
  let st = def_at(f, def_b, def_k, a);
  if (st.kind_tag != BINARY || st.imm == 64 || st.args.len() != 2) {
    return false;
  }
  if (st.str == "sub") {
    return const_one(f, def_b, def_k, st.args[1]) && tested(f, at, heads, def_b, def_k, st.args[0], def_b[a], false);
  }
  if (st.str != "add") {
    return false;
  }
  if (const_one(f, def_b, def_k, st.args[1])) {
    return tested(f, at, heads, def_b, def_k, st.args[0], def_b[a], true);
  }
  return const_one(f, def_b, def_k, st.args[0]) && tested(f, at, heads, def_b, def_k, st.args[1], def_b[a], true);
}

// Some branch on a signed compare of `v` reaches block `d` only on the edge where `v` is below (or above) the other operand.
function tested(f: SFunc, at: i32[], heads: i32[], def_b: i32[], def_k: i32[], v: i32, d: i32, below: boolean): boolean {
  for hi in heads {
    let h = f.blocks[hi];
    let t = h.term;
    let c = def_at(f, def_b, def_k, t.cond);
    let pass: i32 = -1;
    if (below && compares_below(c, v, "lt_s", "gt_s") || !below && compares_below(c, v, "gt_s", "lt_s")) {
      pass = t.t;
    } else if (below && compares_below(c, v, "ge_s", "le_s") || !below && compares_below(c, v, "le_s", "ge_s")) {
      pass = t.f;
    }
    let b = position_of(at, pass);
    if (b >= 0 && f.blocks[b].preds.len() == 1 && f.blocks[b].preds[0] == h.id && dominates_position(f, at, b, d)) {
      return true;
    }
  }
  return false;
}

// signed_compare_heads lists, in block order, the blocks whose two-way branch tests a signed compare.
function signed_compare_heads(f: SFunc, def_b: i32[], def_k: i32[]): i32[] {
  let out: i32[] = [];
  for hi in 0..f.blocks.len() {
    let t = f.blocks[hi].term;
    if (t.kind_tag == TERM_BRIF && t.t != t.f) {
      let c = def_at(f, def_b, def_k, t.cond);
      if (c.kind_tag == BINARY && c.imm != 64 && c.args.len() == 2 && (c.str == "lt_s" || c.str == "gt_s" || c.str == "ge_s" || c.str == "le_s")) {
        out = out.append(hi);
      }
    }
  }
  return out;
}

function dominates_position(f: SFunc, at: i32[], b: i32, d: i32): boolean {
  if (b == d) {
    return true;
  }
  let entry = position_of(at, f.entry);
  if (entry == b) {
    return true;
  }
  if (entry < 0 || d < 0) {
    return false;
  }
  let seen = __alloc_bool(f.blocks.len());
  seen = seen.with(d, true);
  let stack: i32[] = [d];
  let si = 0;
  while (si < stack.len()) {
    let cur = stack[si];
    si += 1;
    if (cur == entry) {
      return false;
    }
    for pid in f.blocks[cur].preds {
      let p = position_of(at, pid);
      if (p < 0) {
        return false;
      }
      if (p != b && !seen[p]) {
        seen = seen.with(p, true);
        stack = stack.append(p);
      }
    }
  }
  return true;
}

function compares_below(c: SInst, o: i32, first: string, second: string): boolean {
  if (c.kind_tag != BINARY || c.imm == 64 || c.args.len() != 2) {
    return false;
  }
  return c.str == first && c.args[0] == o || c.str == second && c.args[1] == o;
}

function const_one(f: SFunc, def_b: i32[], def_k: i32[], v: i32): boolean {
  let d = def_at(f, def_b, def_k, v);
  return d.kind_tag == CONST_INT && d.imm == 1;
}

function def_at(f: SFunc, def_b: i32[], def_k: i32[], v: i32): SInst {
  if (v < 0 || v >= def_b.len() || def_b[v] < 0) {
    return no_inst();
  }
  return f.blocks[def_b[v]].insts[def_k[v]];
}

function low_wrap(ins: SInst): boolean {
  return signed_extension(ins) || ins.kind_tag == UNARY && ins.args.len() == 1 && (ins.str == "u32_wrap" || ins.str == "int_cast:u32" || ins.str == "int_cast:u8" || ins.str == "int_cast:u16" || ins.str == "int_cast:i16");
}

function low_half_binary(op: string): boolean {
  return op == "add" || op == "sub" || op == "mul" || op == "and" || op == "or" || op == "xor";
}

function demand_propagates(ins: SInst): boolean {
  if (ins.kind_tag == COPY || ins.kind_tag == PHI) {
    return true;
  }
  if (ins.kind_tag == BINARY) {
    return low_half_binary(ins.str) || ins.str == "shl" || ins.str == "shr_s" || ins.str == "shr_u";
  }
  return ins.kind_tag == UNARY && (low_wrap(ins) || ins.str == "int_wrap" || ins.str == "int_extend");
}

// A five-level lattice bounds worklist growth even when shifts feed a phi.
function demand_bits(n: i32): i32 {
  if (n <= 0) {
    return 0;
  }
  if (n <= 8) {
    return 8;
  }
  if (n <= 16) {
    return 16;
  }
  if (n <= 32) {
    return 32;
  }
  return 64;
}

function low_wrap_bits(ins: SInst): i32 {
  if (ins.str == "int_cast:u8") {
    return 8;
  }
  if (ins.str == "int_cast:u16" || ins.str == "int_cast:i16") {
    return 16;
  }
  return 32;
}

function constant_bits(ins: SInst): i32 {
  let value = -1i64;
  if (ins.kind_tag == CONST_INT) {
    value = ins.imm as i64;
  } else if (ins.kind_tag == CONST_I64) {
    value = util.lit_to_i64(ins.str);
  }
  if (value < 0) {
    return 64;
  }
  if (value == 0) {
    return 0;
  }
  if (value <= 255i64) {
    return 8;
  }
  if (value <= 65535i64) {
    return 16;
  }
  if (value <= 4294967295i64) {
    return 32;
  }
  return 64;
}

// The low bits of operand `k` that a store of a packed element writes, or 0.
// An append takes its element as operand 1.
function stored_bits(ins: SInst, k: i32): i32 {
  let mark = ins.str;
  if (ins.kind_tag == RT_CALL && k == 1 && ins.str.starts_with("arr_push")) {
    mark = if (ins.str.ends_with("_u8")) { "u8" } else if (ins.str.ends_with("_u16")) { "u16" } else if (ins.str.ends_with("_u32")) { "i32" } else { "" };
  } else if (!(ins.kind_tag == ST_AT && k == 1 || ins.kind_tag == ARR_ST && k == 2)) {
    return 0;
  }
  return mark_bits(mark);
}

// The low result bits of arithmetic and logic depend only on the same
// low operand bits. A constant right shift can bring higher bits down;
// variable right shifts conservatively observe the whole source.
function operand_bits(ins: SInst, k: i32, result: i32, f: SFunc, def_b: i32[], def_k: i32[]): i32 {
  let stored = stored_bits(ins, k);
  if (stored > 0) {
    return stored;
  }
  if (ins.kind_tag == COPY || ins.kind_tag == PHI) {
    return result;
  }
  if (ins.kind_tag == BINARY) {
    if (low_half_binary(ins.str)) {
      if (ins.str == "and" && ins.args.len() == 2) {
        let limit = constant_bits(def_at(f, def_b, def_k, ins.args[1 - k]));
        if (limit < result) {
          return limit;
        }
      }
      return result;
    }
    if (ins.str == "shl") {
      if (k == 1) {
        return 32;
      }
      return result;
    }
    if (ins.str == "shr_s" || ins.str == "shr_u") {
      if (k == 1) {
        return 32;
      }
      if (result == 0) {
        return 0;
      }
      let count = def_at(f, def_b, def_k, ins.args[1]);
      if (count.kind_tag != CONST_INT && count.kind_tag != CONST_I64) {
        return 64;
      }
      let n = count.imm as i64;
      if (count.kind_tag == CONST_I64) {
        n = util.lit_to_i64(count.str);
      }
      let mask = if (ins.imm == 64) { 63i64 } else { 31i64 };
      return demand_bits(result + (n & mask) as i32);
    }
  }
  if (ins.kind_tag == UNARY) {
    if (low_wrap(ins) || ins.str == "int_wrap" || ins.str == "int_extend") {
      let bits = low_wrap_bits(ins);
      if (bits < result) {
        return bits;
      }
      return result;
    }
    if (ins.str.starts_with("rotr:") && rotr_width(ins.str) == 32 || ins.str == "bswap:32") {
      return 32;
    }
  }
  return 64;
}

pub function term_operand(t: STerm): i32 {
  if (t.kind_tag == TERM_RET) {
    return t.value;
  }
  if (t.kind_tag == TERM_BRIF) {
    return t.cond;
  }
  return -1;
}

// term_targets lists the blocks a terminator can branch to.
pub function term_targets(t: STerm): i32[] {
  if (t.kind_tag == TERM_BR) {
    return [t.target];
  }
  if (t.kind_tag == TERM_BRIF) {
    return [t.t, t.f];
  }
  return [];
}

// next_block_id is one more than the largest block id in g.
pub function next_block_id(g: SFunc): i32 {
  let hi = 0;
  for b in g.blocks {
    if (b.id >= hi) {
      hi = b.id + 1;
    }
  }
  return hi;
}

pub function t_unreachable(): STerm {
  return STerm { kind_tag: TERM_UNREACHABLE, cond: 0, target: 0, t: 0, f: 0, value: 0 };
}

// branches_to is true when t can branch to block id.
pub function branches_to(t: STerm, id: i32): boolean {
  return t.kind_tag == TERM_BR && t.target == id || t.kind_tag == TERM_BRIF && (t.t == id || t.f == id);
}

// block_with_id is the index of the block whose id is id, or -1.
pub function block_with_id(f: SFunc, id: i32): i32 {
  let i = 0;
  for b in f.blocks {
    if (b.id == id) {
      return i;
    }
    i += 1;
  }
  return -1;
}

// A load or a store through base + constant takes the constant as its offset.
pub function fold_offsets(f: SFunc): SFunc {
  return rewrite_insts(f, inst_defs(f), offset_access).f;
}

function offset_access(defs: SInst[], ins: SInst): SInst {
  if (ins.kind_tag != LD_AT && ins.kind_tag != ST_AT || ins.str != "" || ins.args.len() == 0 || ins.args[0] < 0) {
    return no_inst();
  }
  let at = def_of(defs, ins.args[0]);
  if (at.kind_tag != BINARY || at.str != "add" || at.imm != 64 || at.args.len() != 2) {
    return no_inst();
  }
  let off = ins.imm as i64 + offset_const(defs, at.args[1]);
  if (off < ins.imm as i64 || off > 1073741824i64) {
    return no_inst();
  }
  return SInst { ...ins, args: ins.args.with(0, at.args[0]), imm: off as i32 };
}

function offset_const(defs: SInst[], v: i32): i64 {
  let d = def_of(defs, v);
  if (d.kind_tag == CONST_INT && d.imm >= 0) {
    return d.imm as i64;
  }
  if (d.kind_tag == CONST_I64 && d.str.len() > 0 && d.str[0] != b'-') {
    return util.lit_to_i64(d.str);
  }
  return 0i64 - 1i64;
}

pub function fuse_rotates(f: SFunc): SFunc {
  if (!has_or(f)) {
    return f;
  }
  let defs = inst_defs(f);
  return rewrite_insts(f, defs, rotate_of).f;
}

function rotate_of(defs: SInst[], ins: SInst): SInst {
  if (ins.kind_tag != BINARY || ins.str != "or" || ins.args.len() != 2) {
    return no_inst();
  }
  let m = rotate_half_pair(defs, ins, ins.args[0], ins.args[1]);
  if (m.kind_tag == NONE) {
    m = rotate_half_pair(defs, ins, ins.args[1], ins.args[0]);
  }
  return m;
}

pub function no_inst(): SInst {
  return SInst { kind_tag: NONE, result: -1, args: [], imm: 0, str: "" };
}

pub function inst_defs(f: SFunc): SInst[] {
  let defs: SInst[] = [];
  for i in 0..f.nvals {
    defs = defs.append(no_inst());
  }
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals) {
        defs = defs.with(ins.result, ins);
      }
    }
  }
  return defs;
}

function rewrite_insts(f: SFunc, defs: SInst[], rewrite: (SInst[], SInst) => SInst): Threading {
  let nblocks: SBlock[] = [];
  let copying = false;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    let ninsts: SInst[] = [];
    let changed = false;
    for k in 0..blk.insts.len() {
      let m = rewrite(defs, blk.insts[k]);
      if (m.kind_tag != NONE && !changed) {
        ninsts = insts_before(blk.insts, k);
        changed = true;
      }
      if (changed) {
        ninsts = ninsts.append(if (m.kind_tag != NONE) { m } else { blk.insts[k] });
      }
    }
    if (changed && !copying) {
      nblocks = blocks_before(f.blocks, bi);
      copying = true;
    }
    if (changed) {
      nblocks = nblocks.append(SBlock { ...blk, insts: ninsts });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
  }
  if (!copying) {
    return Threading { f: f, changed: false };
  }
  return Threading { f: SFunc { ...f, blocks: nblocks }, changed: true };
}

function has_or(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == BINARY && ins.args.len() == 2 && ins.str == "or") {
        return true;
      }
    }
  }
  return false;
}

function rotate_half_pair(defs: SInst[], or: SInst, rv: i32, lv: i32): SInst {
  let no = no_inst();
  let rs = def_of(defs, rv);
  let ls = def_of(defs, lv);
  let w = 64;
  if (zero_extends_u32(ls)) {
    w = 32;
    ls = def_of(defs, ls.args[0]);
  }
  if (rs.kind_tag != BINARY || rs.str != "shr_u" || ls.kind_tag != BINARY || ls.str != "shl") {
    return no;
  }
  if (shift_width(rs.imm) != w || shift_width(ls.imm) != w) {
    return no;
  }
  if (copy_root(defs, rs.args[0]) != copy_root(defs, ls.args[0])) {
    return no;
  }
  let n = const_value(defs, rs.args[1]);
  let k = const_value(defs, ls.args[1]);
  if (n <= 0i64 || k <= 0i64 || n + k != w as i64) {
    return no;
  }
  return SInst { kind_tag: UNARY, result: or.result, args: [rs.args[0]], imm: 0, str: "rotr:" + util.i32_to_string(w) + ":" + util.i64_to_string(n) };
}

pub function fuse_and_not(f: SFunc): SFunc {
  if (!has_and_xor(f)) {
    return f;
  }
  let t = rewrite_insts(f, inst_defs(f), and_not_of);
  return if (t.changed) { prune_dead(t.f) } else { f };
}

function has_and_xor(f: SFunc): boolean {
  let has_and = false;
  let has_xor = false;
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == BINARY) {
        if (ins.str == "and") {
          has_and = true;
        }
        if (ins.str == "xor") {
          has_xor = true;
        }
        if (has_and && has_xor) {
          return true;
        }
      }
    }
  }
  return false;
}

function and_not_of(defs: SInst[], ins: SInst): SInst {
  if (ins.kind_tag != BINARY || ins.str != "and" || ins.args.len() != 2) {
    return no_inst();
  }
  let v = not_of(defs, ins.args[1]);
  if (v >= 0) {
    return SInst { ...ins, args: [ins.args[0], v], str: "and_not" };
  }
  v = not_of(defs, ins.args[0]);
  if (v >= 0) {
    return SInst { ...ins, args: [ins.args[1], v], str: "and_not" };
  }
  return no_inst();
}

// The add, sub or mul at `ii` feeds only the zero-extension after it, so its 32-bit form makes the extended value.
pub function low_word_pair(blk: SBlock, ii: i32, uses: i32[]): boolean {
  if (ii < 0 || ii + 1 >= blk.insts.len()) {
    return false;
  }
  let op = blk.insts[ii];
  let w = blk.insts[ii + 1];
  if (op.kind_tag != BINARY || op.args.len() != 2 || op.str != "add" && op.str != "sub" && op.str != "mul") {
    return false;
  }
  return unsigned_extension(w) && w.args[0] == op.result && op.result >= 0 && op.result < uses.len() && uses[op.result] == 1;
}

pub function fuse_carries(f: SFunc): SFunc {
  if (!has_carry_shift(f)) {
    return f;
  }
  let defs = inst_defs(f);
  let t = rewrite_insts(f, defs, carry_of);
  if (!t.changed) {
    return f;
  }
  return gather_carries(prune_dead(t.f));
}

// The roles of the instructions of a carry chain. The emitters keep the
// carry of a chain in the flags, so no instruction between two members of a
// chain can change the flags.
//
// - HEAD is an add or a subtract that makes the flags for the carry after it.
// - FLAG is a carry that stays in the flags. KEEP also gets a register,
//   because a reader that is not next in the chain uses it.
// - SKIP and LINK are the two adds of `x + y + carry`. The second one adds
//   the three operands with the carry of the flags.
// - READ adds a carry to one operand.
pub const CARRY_HEAD: i32 = 1;

pub const CARRY_FLAG: i32 = 2;

pub const CARRY_KEEP: i32 = 3;

pub const CARRY_SKIP: i32 = 4;

pub const CARRY_LINK: i32 = 5;

pub const CARRY_READ: i32 = 6;

// The role of each value in a carry chain, or an empty array for a function
// with no carry.
pub function carry_roles(f: SFunc, uses: i32[]): i32[] {
  if (!has_carry(f)) {
    return [];
  }
  let roles = __alloc_i32(f.nvals);
  for blk in f.blocks {
    roles = block_carry_roles(blk.insts, uses, roles);
  }
  return roles;
}

pub function carry_role(roles: i32[], ins: SInst): i32 {
  if (ins.result < 0 || ins.result >= roles.len()) {
    return 0;
  }
  return roles[ins.result];
}

// The instruction at `ii` is a carry that reads the flags of the instruction before it.
pub function carry_fed(roles: i32[], blk: SBlock, ii: i32): boolean {
  if (ii >= blk.insts.len()) {
    return false;
  }
  let role = carry_role(roles, blk.insts[ii]);
  return role == CARRY_FLAG || role == CARRY_KEEP;
}

function has_carry(f: SFunc): boolean {
  for blk in f.blocks {
    if (block_has_carry(blk)) {
      return true;
    }
  }
  return false;
}

function block_has_carry(blk: SBlock): boolean {
  for ins in blk.insts {
    if (ins.kind_tag == CARRY) {
      return true;
    }
  }
  return false;
}

function block_carry_roles(a: SInst[], uses: i32[], roles: i32[]): i32[] {
  for i in 1..a.len() {
    if (sum_of(a[i - 1], a[i])) {
      let role = roles[a[i - 1].result];
      if (role == 0) {
        roles = roles.with(a[i - 1].result, CARRY_HEAD);
      }
      if (role == 0 || role == CARRY_READ) {
        roles = chain_roles(a, i, uses, roles);
      }
    }
  }
  return roles;
}

// The carry at `first` is in the flags. Its role and the roles of the
// instructions that read the flags after it.
function chain_roles(a: SInst[], first: i32, uses: i32[], roles: i32[]): i32[] {
  let at = first;
  while (at >= 0) {
    let c = a[at];
    let read = 0;
    let next = -1;
    if (at + 2 < a.len() && link_of(a[at + 1], a[at + 2], c, uses)) {
      roles = roles.with(a[at + 1].result, CARRY_SKIP).with(a[at + 2].result, CARRY_LINK);
      read = 1;
      if (at + 3 < a.len() && carry_out_of(a[at + 3], a[at + 1], c)) {
        read = 2;
        next = at + 3;
      }
    } else if (at + 1 < a.len() && reader_of(a[at + 1], c)) {
      roles = roles.with(a[at + 1].result, CARRY_READ);
      read = if (at + 2 < a.len() && sum_of(a[at + 1], a[at + 2])) { 2 } else { 1 };
    }
    roles = roles.with(c.result, if (uses[c.result] > read) { CARRY_KEEP } else { CARRY_FLAG });
    at = next;
  }
  return roles;
}

function carry_op(c: SInst): string {
  return if (c.imm == 1) { "sub" } else { "add" };
}

function wide_op(ins: SInst, op: string): boolean {
  return ins.kind_tag == BINARY && ins.str == op && ins.imm == 64 && ins.args.len() == 2;
}

// `ins` has the operands x and y, in that order for a subtract.
function operands_are(ins: SInst, x: i32, y: i32): boolean {
  if (ins.args[0] == x && ins.args[1] == y) {
    return true;
  }
  return ins.str == "add" && ins.args[0] == y && ins.args[1] == x;
}

// `c` is the carry of the two operands of `sum`.
function sum_of(sum: SInst, c: SInst): boolean {
  return c.kind_tag == CARRY && c.args.len() == 2 && wide_op(sum, carry_op(c)) && operands_are(sum, c.args[0], c.args[1]);
}

// `r` adds the carry `c` to one operand, or subtracts the borrow `c` from it.
function reader_of(r: SInst, c: SInst): boolean {
  return wide_op(r, carry_op(c)) && r.args[1 - carry_at(r, c)] != c.result && r.args[carry_at(r, c)] == c.result;
}

function carry_at(r: SInst, c: SInst): i32 {
  return if (r.str == "add" && r.args[0] == c.result) { 0 } else { 1 };
}

// `t` and `s` are the two adds of `x + y + c`, and only `s` reads `t`.
function link_of(t: SInst, s: SInst, c: SInst, uses: i32[]): boolean {
  let op = carry_op(c);
  if (!wide_op(t, op) || !wide_op(s, op) || uses[t.result] != 1 || t.args[0] == c.result || t.args[1] == c.result) {
    return false;
  }
  return operands_are(s, t.result, c.result);
}

// `out` is the carry of the operands of `t` and of the carry `c`.
function carry_out_of(out: SInst, t: SInst, c: SInst): boolean {
  return out.kind_tag == CARRY && out.args.len() == 3 && out.imm == c.imm && out.args[2] == c.result && operands_are(t, out.args[0], out.args[1]);
}

// Puts the members of each carry chain of a block next to each other. Each
// instruction that moves is an add, a subtract or a carry, which has no
// effect, and each one stays after the instructions that make its operands.
function gather_carries(f: SFunc): SFunc {
  let uses = use_counts(f);
  let nblocks: SBlock[] = [];
  for blk in f.blocks {
    if (block_has_carry(blk)) {
      nblocks = nblocks.append(SBlock { ...blk, insts: chained(carries_after_sums(blk.insts), uses) });
    } else {
      nblocks = nblocks.append(blk);
    }
  }
  return SFunc { ...f, blocks: nblocks };
}

function carries_after_sums(a: SInst[]): SInst[] {
  for i in 1..a.len() {
    let c = a[i];
    let j = sum_before(a, i);
    if (j >= 0 && j + 1 != i && !sum_of(a[j], a[j + 1])) {
      a = arranged(a, a[j].result, [c.result], false);
    }
  }
  return a;
}

function sum_before(a: SInst[], at: i32): i32 {
  if (a[at].kind_tag != CARRY) {
    return -1;
  }
  for j in 0..at {
    if (sum_of(a[j], a[at])) {
      return j;
    }
  }
  return -1;
}

// `moved` names instructions by result. `before` puts them before the
// instruction `anchor`, and they go after it when `before` is not set.
struct CarryMove { moved: i32[], anchor: i32, before: boolean }

function no_carry_move(): CarryMove {
  return CarryMove { moved: [], anchor: -1, before: false };
}

function chained(a: SInst[], uses: i32[]): SInst[] {
  let tail = -1;
  let sunk: i32[] = [];
  let p = 0;
  while (p < a.len()) {
    let c = a[p];
    if (c.kind_tag == CARRY && (c.result == tail || p > 0 && sum_of(a[p - 1], c))) {
      let m = link_move(a, p, uses);
      if (m.moved.len() == 0) {
        m = reader_move(a, p, sunk);
      }
      if (m.moved.len() > 0) {
        a = arranged(a, m.anchor, m.moved, m.before);
      }
      if (m.moved.len() == 3) {
        tail = m.moved[2];
      }
      if (m.before) {
        sunk = sunk.append(c.result);
        p -= 2;
      } else {
        p = made_at(a, c.result);
      }
    }
    p += 1;
  }
  return a;
}

function made_at(a: SInst[], v: i32): i32 {
  for i in 0..a.len() {
    if (a[i].result == v) {
      return i;
    }
  }
  return -1;
}

function listed(ids: i32[], v: i32): boolean {
  for id in ids {
    if (id == v) {
      return true;
    }
  }
  return false;
}

function arranged(a: SInst[], anchor: i32, moved: i32[], before: boolean): SInst[] {
  let out: SInst[] = [];
  for ins in a {
    if (ins.result == anchor && before) {
      out = with_made(out, a, moved);
    }
    if (ins.result < 0 || !listed(moved, ins.result)) {
      out = out.append(ins);
    }
    if (ins.result == anchor && !before) {
      out = with_made(out, a, moved);
    }
  }
  return out;
}

function with_made(out: SInst[], a: SInst[], moved: i32[]): SInst[] {
  for v in moved {
    out = out.append(a[made_at(a, v)]);
  }
  return out;
}

// `v` has its value before the instruction at `p`.
function made_before(a: SInst[], v: i32, p: i32): boolean {
  let at = made_at(a, v);
  return at < p;
}

// The instruction at `i` reads the flags of a carry before it that is not `except`.
function reads_flags(a: SInst[], i: i32, except: i32): boolean {
  for back in 1..3 {
    if (i >= back && a[i - back].kind_tag == CARRY && a[i - back].result != except && listed(a[i].args, a[i - back].result)) {
      return true;
    }
  }
  return false;
}

// The two adds of `x + y + c` for the carry `c` at `p`, and the carry of that sum when the block has it.
function link_move(a: SInst[], p: i32, uses: i32[]): CarryMove {
  let c = a[p];
  for q in p + 1..a.len() {
    let s = a[q];
    if (!wide_op(s, carry_op(c)) || !listed(s.args, c.result)) {
      continue;
    }
    let ti = made_at(a, s.args[1 - carry_at(s, c)]);
    if (ti < 0 || !link_of(a[ti], s, c, uses) || reads_flags(a, ti, -1) || sum_of(a[ti], a[ti + 1])) {
      continue;
    }
    if (ti > p && !(made_before(a, a[ti].args[0], p) && made_before(a, a[ti].args[1], p))) {
      continue;
    }
    let moved: i32[] = [a[ti].result, s.result];
    for out in a {
      if (carry_out_of(out, a[ti], c)) {
        return CarryMove { moved: moved.append(out.result), anchor: c.result, before: false };
      }
    }
    return CarryMove { moved: moved, anchor: c.result, before: false };
  }
  return no_carry_move();
}

// The reader of the carry `c` at `p` goes after `c`, with the carry of its
// own sum. When an operand of the reader comes later, the sum and `c` go down
// to the reader, one time for each carry.
function reader_move(a: SInst[], p: i32, sunk: i32[]): CarryMove {
  let c = a[p];
  for q in p + 1..a.len() {
    let r = a[q];
    if (!reader_of(r, c) || reads_flags(a, q, c.result)) {
      continue;
    }
    if (made_before(a, r.args[1 - carry_at(r, c)], p)) {
      let moved: i32[] = [r.result];
      if (q + 1 < a.len() && sum_of(r, a[q + 1])) {
        moved = moved.append(a[q + 1].result);
      }
      return CarryMove { moved: moved, anchor: c.result, before: false };
    }
    if (c.args.len() == 2 && !listed(sunk, c.result) && !reads_flags(a, p - 1, -1) && !read_between(a, p, q)) {
      return CarryMove { moved: [a[p - 1].result, c.result], anchor: r.result, before: true };
    }
  }
  return no_carry_move();
}

// An instruction between `p` and `q` reads the carry at `p` or the sum before it.
function read_between(a: SInst[], p: i32, q: i32): boolean {
  for k in p + 1..q {
    if (listed(a[k].args, a[p].result) || listed(a[k].args, a[p - 1].result)) {
      return true;
    }
  }
  return false;
}

function has_carry_shift(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == BINARY && ins.str == "shr_u" && ins.imm == 64) {
        return true;
      }
    }
  }
  return false;
}

function is_top_bit(defs: SInst[], ins: SInst): boolean {
  return ins.kind_tag == BINARY && ins.str == "shr_u" && ins.imm == 64 && ins.args.len() == 2 && is_const(defs, ins.args[1], 63i64);
}

function is_const(defs: SInst[], v: i32, want: i64): boolean {
  let d = copy_source(defs, v);
  if (d.kind_tag == CONST_INT) {
    return d.imm as i64 == want;
  }
  return d.kind_tag == CONST_I64 && util.lit_to_i64(d.str) == want;
}

function bin_of(defs: SInst[], v: i32, op: string): SInst {
  let d = copy_source(defs, v);
  if (d.kind_tag == BINARY && d.str == op && d.args.len() == 2) {
    return d;
  }
  return no_inst();
}

function wide_of(defs: SInst[], v: i32, op: string): SInst {
  let d = bin_of(defs, v, op);
  return if (d.imm == 64) { d } else { no_inst() };
}

function not_of(defs: SInst[], v: i32): i32 {
  let d = bin_of(defs, v, "xor");
  if (d.kind_tag == NONE) {
    return -1;
  }
  if (is_const(defs, d.args[1], 0i64 - 1i64)) {
    return copy_root(defs, d.args[0]);
  }
  if (is_const(defs, d.args[0], 0i64 - 1i64)) {
    return copy_root(defs, d.args[1]);
  }
  return -1;
}

function same_pair(defs: SInst[], a: i32, b: i32, x: i32, y: i32): boolean {
  let ra = copy_root(defs, a);
  let rb = copy_root(defs, b);
  return ra == x && rb == y || ra == y && rb == x;
}

function zero_one(defs: SInst[], v: i32): boolean {
  let d = copy_source(defs, v);
  if (d.kind_tag == CARRY || is_top_bit(defs, d)) {
    return true;
  }
  return d.kind_tag == BINARY && d.str == "and" && d.args.len() == 2 && (is_const(defs, d.args[0], 1i64) || is_const(defs, d.args[1], 1i64));
}

function carry_of(defs: SInst[], shr: SInst): SInst {
  if (wide_op(shr, "or") || wide_op(shr, "add")) {
    return full_carry(defs, shr);
  }
  if (!is_top_bit(defs, shr)) {
    return no_inst();
  }
  let o = bin_of(defs, shr.args[0], "or");
  if (o.kind_tag == NONE) {
    return no_inst();
  }
  let m = carry_halves(defs, shr, o.args[0], o.args[1]);
  if (m.kind_tag == NONE) {
    m = carry_halves(defs, shr, o.args[1], o.args[0]);
  }
  return m;
}

// `carry(x, y) | carry(x + y, c)` is the carry of `x + y + c` when `c` is 0
// or 1. The two halves are not 1 together, so their sum is the same carry.
function full_carry(defs: SInst[], join: SInst): SInst {
  let a = half_carry(defs, join.args[0]);
  let b = half_carry(defs, join.args[1]);
  if (a.kind_tag == NONE || b.kind_tag == NONE || a.imm != b.imm) {
    return no_inst();
  }
  let m = carry_of_halves(defs, join, a, b);
  return if (m.kind_tag == NONE) { carry_of_halves(defs, join, b, a) } else { m };
}

function half_carry(defs: SInst[], v: i32): SInst {
  let d = copy_source(defs, v);
  if (!is_top_bit(defs, d)) {
    return no_inst();
  }
  let m = carry_of(defs, d);
  return if (m.kind_tag == CARRY && m.args.len() == 2) { m } else { no_inst() };
}

function carry_of_halves(defs: SInst[], join: SInst, first: SInst, second: SInst): SInst {
  let x = first.args[0];
  let y = first.args[1];
  for k in 0..2 {
    let inner = wide_of(defs, second.args[k], carry_op(first));
    if (inner.kind_tag == NONE || !zero_one(defs, second.args[1 - k]) || first.imm == 1 && k == 1) {
      continue;
    }
    if (copy_root(defs, inner.args[0]) == x && copy_root(defs, inner.args[1]) == y || first.imm == 0 && same_pair(defs, inner.args[0], inner.args[1], x, y)) {
      return SInst { kind_tag: CARRY, result: join.result, args: [x, y, second.args[1 - k]], imm: first.imm, str: "" };
    }
  }
  return no_inst();
}

function carry_halves(defs: SInst[], shr: SInst, p: i32, q: i32): SInst {
  let pa = bin_of(defs, p, "and");
  let qa = bin_of(defs, q, "and");
  if (pa.kind_tag == NONE || qa.kind_tag == NONE) {
    return no_inst();
  }
  for k in 0..2 {
    let m = add_carry(defs, shr, pa, qa.args[k], qa.args[1 - k]);
    if (m.kind_tag == NONE) {
      m = sub_borrow(defs, shr, pa, qa.args[k], qa.args[1 - k]);
    }
    if (m.kind_tag != NONE) {
      return m;
    }
  }
  return no_inst();
}

function add_carry(defs: SInst[], shr: SInst, p: SInst, either: i32, inv: i32): SInst {
  let x = copy_root(defs, p.args[0]);
  let y = copy_root(defs, p.args[1]);
  let e = bin_of(defs, either, "or");
  if (e.kind_tag == NONE || !same_pair(defs, e.args[0], e.args[1], x, y)) {
    return no_inst();
  }
  let s = wide_of(defs, not_of(defs, inv), "add");
  if (s.kind_tag == NONE) {
    return no_inst();
  }
  if (same_pair(defs, s.args[0], s.args[1], x, y)) {
    return SInst { kind_tag: CARRY, result: shr.result, args: [x, y], imm: 0, str: "" };
  }
  for k in 0..2 {
    let inner = wide_of(defs, s.args[k], "add");
    if (inner.kind_tag != NONE && same_pair(defs, inner.args[0], inner.args[1], x, y) && zero_one(defs, s.args[1 - k])) {
      return SInst { kind_tag: CARRY, result: shr.result, args: [x, y, copy_root(defs, s.args[1 - k])], imm: 0, str: "" };
    }
  }
  return no_inst();
}

function sub_borrow(defs: SInst[], shr: SInst, p: SInst, either: i32, diff: i32): SInst {
  for k in 0..2 {
    let x = not_of(defs, p.args[k]);
    let y = copy_root(defs, p.args[1 - k]);
    if (x >= 0 && inverted_or(defs, either, x, y)) {
      return borrow_from(defs, shr, diff, x, y);
    }
  }
  return no_inst();
}

function inverted_or(defs: SInst[], v: i32, x: i32, y: i32): boolean {
  let e = bin_of(defs, v, "or");
  if (e.kind_tag == NONE) {
    return false;
  }
  return not_of(defs, e.args[0]) == x && copy_root(defs, e.args[1]) == y || not_of(defs, e.args[1]) == x && copy_root(defs, e.args[0]) == y;
}

function borrow_from(defs: SInst[], shr: SInst, diff: i32, x: i32, y: i32): SInst {
  let d = wide_of(defs, diff, "sub");
  if (d.kind_tag == NONE) {
    return no_inst();
  }
  if (copy_root(defs, d.args[0]) == x && copy_root(defs, d.args[1]) == y) {
    return SInst { kind_tag: CARRY, result: shr.result, args: [x, y], imm: 1, str: "" };
  }
  let inner = wide_of(defs, d.args[0], "sub");
  if (inner.kind_tag != NONE && copy_root(defs, inner.args[0]) == x && copy_root(defs, inner.args[1]) == y && zero_one(defs, d.args[1])) {
    return SInst { kind_tag: CARRY, result: shr.result, args: [x, y, copy_root(defs, d.args[1])], imm: 1, str: "" };
  }
  return no_inst();
}

function zero_extends_u32(ins: SInst): boolean {
  if (ins.kind_tag != UNARY || ins.args.len() != 1) {
    return false;
  }
  if (ins.str == "u32_wrap" || ins.str == "int_cast:u32") {
    return true;
  }
  return (ins.str == "int_wrap" || ins.str == "int_extend") && ins.imm == 1;
}

function def_of(defs: SInst[], v: i32): SInst {
  if (v < 0 || v >= defs.len()) {
    return no_inst();
  }
  return defs[v];
}

function shift_width(imm: i32): i32 {
  if (imm == 64) {
    return 64;
  }
  return 32;
}

// The first value of the chain of copies that ends at v.
pub function copy_root(defs: SInst[], v: i32): i32 {
  let r = v;
  for steps in 0..defs.len() {
    let d = def_of(defs, r);
    if (d.kind_tag != COPY || d.args.len() != 1) {
      return r;
    }
    r = d.args[0];
  }
  return r;
}

// The definition of copy_root(defs, v).
pub function copy_source(defs: SInst[], v: i32): SInst {
  return def_of(defs, copy_root(defs, v));
}

function const_value(defs: SInst[], v: i32): i64 {
  let d = copy_source(defs, v);
  if (d.kind_tag == CONST_INT) {
    return d.imm as i64;
  }
  if (d.kind_tag == CONST_I64) {
    return util.lit_to_i64(d.str);
  }
  return 0i64 - 1i64;
}

pub function rotr_width(what: string): i32 {
  if (what.starts_with("rotr:64:")) {
    return 64;
  }
  return 32;
}

// A rotate immediate is a decimal bit index in its operand width.
pub function rotr_count(what: string): i32 {
  if (what.len() <= 8 || !(what.starts_with("rotr:32:") || what.starts_with("rotr:64:"))) {
    return -1;
  }
  let width = rotr_width(what);
  let n = 0;
  for i in 8..what.len() {
    let digit = what[i];
    if (digit < b'0' || digit > b'9') {
      return -1;
    }
    n = n * 10 + (digit as i32 - 48);
    if (n >= width) {
      return -1;
    }
  }
  return n;
}

pub function prune_dead(f: SFunc): SFunc {
  let live = prune_mark(f, prune_roots(f));
  let nblocks: SBlock[] = [];
  let copying = false;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    let ninsts: SInst[] = [];
    let pruned = false;
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      let stays = inst_has_effect(ins.kind_tag) || live[ins.result] == 1;
      if (pruned) {
        if (stays) {
          ninsts = ninsts.append(ins);
        }
      } else if (!stays) {
        ninsts = insts_before(blk.insts, k);
        pruned = true;
      }
    }
    if (pruned) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { id: blk.id, insts: ninsts, term: blk.term, preds: blk.preds });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
  }
  if (!copying) {
    return f;
  }
  return SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: nblocks, entry: f.entry, takes_env: f.takes_env };
}

function insts_before(insts: SInst[], n: i32): SInst[] {
  let out: SInst[] = [];
  for j in 0..n {
    out = out.append(insts[j]);
  }
  return out;
}

function blocks_before(blocks: SBlock[], n: i32): SBlock[] {
  let out: SBlock[] = [];
  for j in 0..n {
    out = out.append(blocks[j]);
  }
  return out;
}

function inst_has_effect(k: i32): boolean {
  if (k < PRINT) {
    return k == PARAM || k == CALL || k == CALL_INDIRECT || k == ALLOC || k == STORE_ELEM || k == CONCAT;
  }
  return k != SELECT && k != CARRY && k != LD_AT && k != FN_ADDR && k != SHAPE_ADDR && k != STR_LIT && k != LD_IDX && k != LD_BYTE && k != AGG_LIT && k != SYM_ADDR && k != TERNARY && k != FRAME_CELL;
}

function prune_roots(f: SFunc): i32[] {
  let work: i32[] = [];
  for blk in f.blocks {
    for ins in blk.insts {
      if (inst_has_effect(ins.kind_tag)) {
        for a in ins.args {
          work = work.append(a);
        }
      }
    }
    if (blk.term.kind_tag == TERM_RET) {
      work = work.append(blk.term.value);
    }
    if (blk.term.kind_tag == TERM_BRIF) {
      work = work.append(blk.term.cond);
    }
  }
  return work;
}

function prune_mark(f: SFunc, work: i32[]): i32[] {
  let live = __alloc_i32(f.nvals);
  let def_b = __alloc_i32(f.nvals);
  let def_k = __alloc_i32(f.nvals);
  for bi in 0..f.blocks.len() {
    for k in 0..f.blocks[bi].insts.len() {
      let r = f.blocks[bi].insts[k].result;
      def_b = def_b.with(r, bi + 1);
      def_k = def_k.with(r, k);
    }
  }
  let at = 0;
  while (at < work.len()) {
    let v = work[at];
    at += 1;
    if (v < 0 || v >= f.nvals || live[v] == 1) {
      continue;
    }
    live = live.with(v, 1);
    if (def_b[v] == 0) {
      continue;
    }
    for a in f.blocks[def_b[v] - 1].insts[def_k[v]].args {
      work = work.append(a);
    }
  }
  return live;
}

pub function count_insts(f: SFunc): i32 {
  let n = 0;
  for bi in 0..f.blocks.len() {
    n += f.blocks[bi].insts.len();
  }
  return n;
}

pub function pred_slot(blk: SBlock, prev: i32): i32 {
  for i in 0..blk.preds.len() {
    if (blk.preds[i] == prev) {
      return i;
    }
  }
  return 0;
}

function eval_binary(op: string, l: i32, r: i32): i32 {
  if (op == "+") {
    return l + r;
  }
  if (op == "-") {
    return l - r;
  }
  if (op == "*") {
    return l * r;
  }
  if (op == "/") {
    return l / r;
  }
  if (op == "%") {
    return l % r;
  }
  if (op == "==") {
    if (l == r) {
      return 1;
    }
    return 0;
  }
  if (op == "!=") {
    if (l != r) {
      return 1;
    }
    return 0;
  }
  if (op == "<") {
    if (l < r) {
      return 1;
    }
    return 0;
  }
  if (op == "<=") {
    if (l <= r) {
      return 1;
    }
    return 0;
  }
  if (op == ">") {
    if (l > r) {
      return 1;
    }
    return 0;
  }
  if (op == ">=") {
    if (l >= r) {
      return 1;
    }
    return 0;
  }
  if (op == "&&") {
    if (l != 0 && r != 0) {
      return 1;
    }
    return 0;
  }
  if (op == "||") {
    if (l != 0 || r != 0) {
      return 1;
    }
    return 0;
  }
  if (op == "&") {
    return l & r;
  }
  if (op == "|") {
    return l | r;
  }
  if (op == "^") {
    return l ^ r;
  }
  if (op == "<<") {
    return l << r;
  }
  if (op == ">>") {
    return l >> r;
  }
  return 0;
}

pub function only_phis(b: SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag != PHI) {
      return false;
    }
  }
  return true;
}

// block_index is the index in its function of block id, given the function's
// map from block id to index, or -1.
pub function block_index(blk_pos: i32[], id: i32): i32 {
  if (id < 0 || id >= blk_pos.len()) {
    return -1;
  }
  return blk_pos[id];
}

// edge_moves is true when the edge from pred into block id needs a phi move.
pub function edge_moves(f: SFunc, blk_pos: i32[], imm: Imms, reg_of: i32[], pred: i32, id: i32): boolean {
  let ti = block_index(blk_pos, id);
  if (ti < 0) {
    return false;
  }
  let tb = f.blocks[ti];
  let sl = pred_slot(tb, pred);
  for ins in tb.insts {
    if (ins.kind_tag == PHI && reg_of[ins.result] != -1 && (imm.is_imm[ins.args[sl]] || reg_of[ins.args[sl]] != reg_of[ins.result])) {
      return true;
    }
  }
  return false;
}

// forward_target follows up to 8 blocks that hold only phis and branch on
// with no edge moves, and returns the block a jump to id reaches.
pub function forward_target(f: SFunc, blk_pos: i32[], imm: Imms, reg_of: i32[], id: i32): i32 {
  let cur = id;
  for step in 0..8 {
    let bi = block_index(blk_pos, cur);
    if (bi < 0) {
      return cur;
    }
    let b = f.blocks[bi];
    if (!only_phis(b) || b.term.kind_tag != TERM_BR || b.term.target == cur || edge_moves(f, blk_pos, imm, reg_of, cur, b.term.target)) {
      return cur;
    }
    cur = b.term.target;
  }
  return cur;
}

pub function same_fallthrough(f: SFunc, blk_pos: i32[], imm: Imms, reg_of: i32[], to: i32, next: i32): boolean {
  return to == next || forward_target(f, blk_pos, imm, reg_of, to) == forward_target(f, blk_pos, imm, reg_of, next);
}

pub function has_phis(f: SFunc, blk_pos: i32[], id: i32): boolean {
  let ti = block_index(blk_pos, id);
  if (ti < 0) {
    return false;
  }
  for ins in f.blocks[ti].insts {
    if (ins.kind_tag == PHI) {
      return true;
    }
  }
  return false;
}

// The frame slot of each view that lives in the frame, and of each frame
// cell. The instructions of one cell share one slot.
pub function view_slots(f: SFunc): i32[] {
  let out: i32[] = [];
  let n = 0;
  let cells: i32[] = [];
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag != STR_VIEW && ins.kind_tag != FRAME_CELL) {
        continue;
      }
      if (out.len() == 0) {
        out = util.minus_ones(f.nvals);
      }
      let slot = -1;
      if (ins.kind_tag == FRAME_CELL) {
        while (cells.len() <= cell_number(ins)) {
          cells = cells.append(-1);
        }
        slot = cells[cell_number(ins)];
      }
      if (ins.kind_tag == STR_VIEW && ins.imm >= 1 || ins.kind_tag == FRAME_CELL && slot < 0) {
        slot = n;
        n += 1;
      }
      if (ins.kind_tag == FRAME_CELL) {
        cells = cells.with(cell_number(ins), slot);
      }
      if (slot >= 0) {
        out = out.with(ins.result, slot);
      }
    }
  }
  return out;
}

pub function view_count(views: i32[]): i32 {
  let n = 0;
  for v in views {
    if (v >= 0) {
      n += 1;
    }
  }
  return n;
}

pub function unique_test(ins: SInst): boolean {
  return rc_inlined(ins) && ins.str == "__fern_rc_is_unique";
}

// A select past the first instruction, which the select fusion can read.
pub function select_at(blk: SBlock, ii: i32): boolean {
  return ii >= 1 && ii < blk.insts.len() && blk.insts[ii].kind_tag == SELECT;
}

pub function runtime_helper_name(op: string): string {
  return match (op) {
    "str_from_bytes" => "string_from_bytes",
    "str_from_bytes_u8" => "string_from_bytes_u8",
    "str_from_bytes_range_u8" => "string_from_bytes_range_u8",
    "read_chunk" => "reader_read_chunk",
    "write_bytes" => "writer_write_bytes",
    "write_bytes_u8" => "writer_write_bytes_u8",
    "write_some_bytes" => "writer_write_some_bytes",
    "write_some_bytes_u8" => "writer_write_some_bytes_u8",
    "read_chunk_bytes" => "reader_read_chunk_bytes",
    "read_chunk_bytes_u8" => "reader_read_chunk_bytes_u8",
    _ => op,
  };
}

// Scalar masks and byte shifts can describe a vector byte permutation. Keep
// each search bounded and refuse any bit whose provenance is not exact.
struct ByteOrigin { atom: i32, fuel: i32 }

struct ByteAddress { base: i32, offset: i32 }

function byte_unknown(fuel: i32): ByteOrigin {
  return ByteOrigin { atom: -2, fuel: fuel };
}

function byte_constant(ins: SInst): boolean {
  return ins.kind_tag == CONST_INT || ins.kind_tag == CONST_I64;
}

function byte_constant_value(ins: SInst): i64 {
  return if (ins.kind_tag == CONST_INT) { ins.imm as i64 } else { util.lit_to_i64(ins.str) };
}

function byte_shift_op(op: string): boolean {
  return op == "shl" || op == "shr_s" || op == "shr_u";
}

function byte_wrap_op(ins: SInst): boolean {
  return low_wrap(ins) || ins.str == "int_wrap" || ins.str == "int_extend";
}

function byte_extract(ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  let lane = (ins.str[ins.str.len() - 1] - b'0') as i32;
  let bytes = ins.imm / 8;
  if (byte >= bytes || lane < 0 || lane * bytes + byte >= 16) {
    return byte_unknown(fuel);
  }
  let vector = ins.args[0];
  if (vector < 0 || vector > 134217727) {
    return byte_unknown(fuel);
  }
  return ByteOrigin { atom: vector * 16 + lane * bytes + byte, fuel: fuel };
}

function byte_unary(defs: SInst[], ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  if (ins.args.len() != 1) {
    return byte_unknown(fuel);
  }
  if (ins.str.starts_with("vextract_bits:")) {
    return byte_extract(ins, byte, fuel);
  }
  if (byte_wrap_op(ins) && byte < low_wrap_bits(ins) / 8) {
    return byte_origin(defs, ins.args[0], byte, fuel);
  }
  return byte_unknown(fuel);
}

function byte_and(defs: SInst[], ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  for k in 0..2 {
    let c = def_of(defs, ins.args[k]);
    if (byte_constant(c)) {
      let mask = byte_constant_value(c) >> 8 * byte & 255i64;
      if (mask == 0i64) {
        return ByteOrigin { atom: -1, fuel: fuel };
      }
      if (mask == 255i64) {
        return byte_origin(defs, ins.args[1 - k], byte, fuel);
      }
    }
  }
  return byte_unknown(fuel);
}

function byte_or(defs: SInst[], ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  let a = byte_origin(defs, ins.args[0], byte, fuel);
  if (a.atom == -2) {
    return a;
  }
  let b = byte_origin(defs, ins.args[1], byte, a.fuel);
  if (a.atom == -1 || a.atom == b.atom) {
    return b;
  }
  if (b.atom == -1) {
    return ByteOrigin { atom: a.atom, fuel: b.fuel };
  }
  return byte_unknown(b.fuel);
}

function byte_shift(defs: SInst[], ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  let c = def_of(defs, ins.args[1]);
  if (!byte_constant(c)) {
    return byte_unknown(fuel);
  }
  let width = if (ins.imm == 64) { 64 } else { 32 };
  let count = (byte_constant_value(c) & (width - 1) as i64) as i32;
  if ((count & 7) != 0 || byte >= width / 8) {
    return byte_unknown(fuel);
  }
  let at = byte + (if (ins.str == "shl") { -count / 8 } else { count / 8 });
  if (at < 0 || at >= width / 8 && ins.str == "shr_u") {
    return ByteOrigin { atom: -1, fuel: fuel };
  }
  if (at >= width / 8) {
    return byte_unknown(fuel);
  }
  return byte_origin(defs, ins.args[0], at, fuel);
}

function byte_binary(defs: SInst[], ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  if (ins.args.len() != 2) {
    return byte_unknown(fuel);
  }
  if (ins.str == "and") {
    return byte_and(defs, ins, byte, fuel);
  }
  if (ins.str == "or") {
    return byte_or(defs, ins, byte, fuel);
  }
  if (byte_shift_op(ins.str)) {
    return byte_shift(defs, ins, byte, fuel);
  }
  return byte_unknown(fuel);
}

function byte_origin(defs: SInst[], value: i32, byte: i32, fuel: i32): ByteOrigin {
  if (fuel <= 0 || byte < 0 || byte >= 8) {
    return byte_unknown(0);
  }
  fuel -= 1;
  let ins = def_of(defs, value);
  if (ins.kind_tag == COPY && ins.args.len() == 1) {
    return byte_origin(defs, ins.args[0], byte, fuel);
  }
  if (ins.kind_tag == UNARY) {
    return byte_unary(defs, ins, byte, fuel);
  }
  if (byte_constant(ins)) {
    let zero = (byte_constant_value(ins) >> 8 * byte & 255i64) == 0i64;
    return ByteOrigin { atom: if (zero) { -1 } else { -2 }, fuel: fuel };
  }
  if (ins.kind_tag == BINARY) {
    return byte_binary(defs, ins, byte, fuel);
  }
  return byte_unknown(fuel);
}

function byte_store_size(ins: SInst): i32 {
  if (ins.kind_tag == ST_BYTE && ins.args.len() == 3) {
    return 1;
  }
  if (ins.kind_tag != ST_AT || ins.args.len() != 2) {
    return 0;
  }
  if (ins.str == "u8") {
    return 1;
  }
  if (ins.str == "i32") {
    return 4;
  }
  return if (ins.str == "") { 8 } else { 0 };
}

function byte_store_address(defs: SInst[], ins: SInst): ByteAddress {
  let base = ins.args[0];
  let offset = ins.imm;
  if (ins.kind_tag == ST_BYTE) {
    let index = offset_const(defs, ins.args[1]);
    if (index < 0i64 || index > 32i64) {
      return ByteAddress { base: -1, offset: 0 };
    }
    offset = index as i32;
  }
  for depth in 0..4 {
    let d = def_of(defs, base);
    if (d.kind_tag != BINARY || d.str != "add" || d.imm != 64 || d.args.len() != 2) {
      break;
    }
    let n = offset_const(defs, d.args[1]);
    if (n < 0i64 || n > 32i64 || offset > 64) {
      break;
    }
    offset += n as i32;
    base = d.args[0];
  }
  return ByteAddress { base: base, offset: offset };
}

// Only operations which cannot observe memory or trap may move between the
// old stores and their replacement. A load, call or unknown opcode is a fence.
function byte_store_transparent(ins: SInst): boolean {
  if (ins.kind_tag == CONST_INT || ins.kind_tag == CONST_I64 || ins.kind_tag == COPY) {
    return true;
  }
  if (ins.kind_tag == UNARY) {
    return byte_wrap_op(ins) || ins.str.starts_with("vextract_bits:");
  }
  return ins.kind_tag == BINARY && (low_half_binary(ins.str) || byte_shift_op(ins.str));
}

function shuffled_byte_store(defs: SInst[], insts: SInst[], stores: i32[], count: i32): SInst {
  if (stores.len() < 2 || count != 4 && count != 8 && count != 12 && count != 16) {
    return no_inst();
  }
  let first = insts[stores[0]];
  if (first.imm != 0 || first.kind_tag == ST_BYTE && offset_const(defs, first.args[1]) != 0i64) {
    return no_inst();
  }
  let atoms: i32[] = [];
  let vectors: i32[] = [];
  for at in stores {
    let store = insts[at];
    for byte in 0..byte_store_size(store) {
      let value = store.args[if (store.kind_tag == ST_BYTE) { 2 } else { 1 }];
      let origin = byte_origin(defs, value, byte, 64);
      if (origin.atom == -2) {
        return no_inst();
      }
      atoms = atoms.append(origin.atom);
      if (origin.atom >= 0 && util.index_of_i32(vectors, origin.atom / 16) < 0) {
        vectors = vectors.append(origin.atom / 16);
        if (vectors.len() > 2) {
          return no_inst();
        }
      }
    }
  }
  if (vectors.len() == 0) {
    return no_inst();
  }
  let mask = __alloc_u8(16);
  for i in 0..16 {
    let byte = b'?';
    if (i < atoms.len() && atoms[i] >= 0) {
      let atom = atoms[i];
      byte = (65 + 16 * util.index_of_i32(vectors, atom / 16) + atom % 16) as u8;
    }
    mask = mask.with(i, byte);
  }
  let other = if (vectors.len() == 2) { vectors[1] } else { vectors[0] };
  let text = "";
  unsafe {
    // Every mask byte is an ASCII index or the zero-fill marker.
    text = string_from_bytes_unchecked(mask);
  }
  return SInst { ...first, kind_tag: LANE_STORE, args: [first.args[0], vectors[0], other], str: "vstore:shuffle:" + text, imm: count };
}

pub function combine_byte_stores(f: SFunc): SFunc {
  let extracts = false;
  let stores = 0;
  for block in f.blocks {
    for ins in block.insts {
      extracts = extracts || ins.kind_tag == UNARY && ins.str.starts_with("vextract_bits:");
      if (byte_store_size(ins) > 0) {
        stores += 1;
      }
    }
  }
  if (!extracts || stores < 2) {
    return f;
  }
  let defs = inst_defs(f);
  let blocks: SBlock[] = [];
  let changed = false;
  for block in f.blocks {
    let insts = block.insts;
    let i = 0;
    while (i < insts.len()) {
      if (byte_store_size(insts[i]) == 0) {
        i += 1;
        continue;
      }
      let start = byte_store_address(defs, insts[i]);
      if (start.base < 0) {
        i += 1;
        continue;
      }
      let count = 0;
      let group: i32[] = [];
      let j = i;
      while (j < insts.len() && j - i < 64) {
        let size = byte_store_size(insts[j]);
        if (size > 0) {
          let address = byte_store_address(defs, insts[j]);
          if (address.base != start.base || address.offset != start.offset + count || count + size > 16) {
            break;
          }
          count += size;
          group = group.append(j);
        } else if (!byte_store_transparent(insts[j])) {
          break;
        }
        j += 1;
      }
      let packed = shuffled_byte_store(defs, insts, group, count);
      if (packed.kind_tag != NONE) {
        for at in group {
          insts = insts.with(at, no_inst());
        }
        insts = insts.with(group[group.len() - 1], packed);
        changed = true;
      }
      i = if (j > i) { j } else { i + 1 };
    }
    let kept: SInst[] = [];
    for ins in insts {
      if (ins.kind_tag != NONE) {
        kept = kept.append(ins);
      }
    }
    blocks = blocks.append(SBlock { ...block, insts: kept });
  }
  return if (changed) { prune_dead(SFunc { ...f, blocks: blocks }) } else { f };
}
