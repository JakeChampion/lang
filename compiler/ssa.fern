  "append",  // -14
  "slice",  // -15
  "str_index",  // -16
  "cast",  // -17
  "str_as",  // -18
  "with",  // -19
  "closure_new",  // -20
  "call_value",  // -21
  "cell_new",  // -22
  "cell_get",  // -23
  "cell_set",  // -24
  "map_new",  // -25
  "map_insert",  // -26
  "map_has",  // -27
