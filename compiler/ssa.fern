import "./ast";
import "./parser";
import "./astwalk";
import "./util";
import "./ssafixed";
import "./ir";
import "std/string";

pub struct SInst { kind_tag: i32, result: i32, args: i32[], imm: i32, str: string }

pub struct STerm { kind_tag: i32, cond: i32, target: i32, t: i32, f: i32, value: i32 }

pub struct SBlock { id: i32, insts: SInst[], term: STerm, preds: i32[] }

pub struct SFunc { name: string, nparams: i32, nvals: i32, blocks: SBlock[], entry: i32, takes_env: boolean }

// The kinds of SInst. Negative kinds are the semantic ones in ssasem.fern.
// NONE is the kind of no_inst().
pub const NONE: i32 = 0;

pub const CONST_INT: i32 = 1;

pub const CONST_BOOL: i32 = 2;

pub const CONST_I64: i32 = 3;

pub const CONST_FLOAT: i32 = 4;

pub const CONST_STR: i32 = 5;

pub const PARAM: i32 = 6;

pub const COPY: i32 = 7;

pub const PHI: i32 = 8;

pub const BINARY: i32 = 9;

pub const UNARY: i32 = 10;

pub const CALL: i32 = 11;

pub const CALL_INDIRECT: i32 = 12;

pub const FUNCADDR: i32 = 13;

pub const ALLOC: i32 = 14;

pub const LOAD_ELEM: i32 = 15;

pub const STORE_ELEM: i32 = 16;

pub const CONCAT: i32 = 17;

pub const STREQ: i32 = 18;

pub const PRINT: i32 = 19;

pub const WRITE: i32 = 20;

pub const EXIT: i32 = 21;

pub const ARGS: i32 = 22;

pub const READ_FILE: i32 = 26;

pub const WRITE_FILE: i32 = 27;

pub const LINE: i32 = 35;

pub const SELECT: i32 = 36;

pub const CARRY: i32 = 37;

pub const LD_AT: i32 = 40;

pub const ST_AT: i32 = 41;

pub const ARR_AT: i32 = 42;

pub const ARR_ST: i32 = 43;

pub const STR_AT: i32 = 44;

pub const FN_ADDR: i32 = 45;

pub const SHAPE_ADDR: i32 = 46;

pub const STR_LIT: i32 = 47;

pub const ARR_BOX: i32 = 48;

pub const STR_CALL: i32 = 49;

pub const RT_CALL: i32 = 50;

pub const STR_VIEW: i32 = 51;

pub const LD_IDX: i32 = 52;

pub const ST_IDX: i32 = 53;

pub const LD_BYTE: i32 = 54;

pub const ST_BYTE: i32 = 55;

pub const CALL_IND: i32 = 56;

pub const AGG_LIT: i32 = 57;

pub const SYM_ADDR: i32 = 58;

pub const FLAT_OP: i32 = 59;

pub const DYN_DISPATCH: i32 = 60;

pub const LANE3: i32 = 61;

pub const LANE_STORE: i32 = 62;

// The kinds of STerm.
pub const TERM_NONE: i32 = 0;

pub const TERM_RET: i32 = 1;

pub const TERM_BR: i32 = 2;

pub const TERM_BRIF: i32 = 3;

pub const TERM_UNREACHABLE: i32 = 4;

pub function t_ret(value: i32): STerm {
  return STerm { kind_tag: TERM_RET, cond: 0, target: 0, t: 0, f: 0, value: value };
}

pub function t_br(target: i32): STerm {
  return STerm { kind_tag: TERM_BR, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

pub function t_brif(cond: i32, t: i32, f: i32): STerm {
  return STerm { kind_tag: TERM_BRIF, cond: cond, target: 0, t: t, f: f, value: 0 };
}

function semantic_names_symbol(id: i32): boolean {
  return id == -7 || id == -8 || id == -9 || id == -10
    || id == -11 || id == -12 || id == -20;
}

pub function plain_str(ins: SInst): string {
  if ((ins.kind_tag == LD_AT || ins.kind_tag == ARR_AT) && ins.str.len() >= 2 && ins.str.ends_with("rc")) {
    return slice_unchecked(ins.str, 0, ins.str.len() - 2).to_owned();
  }
  return ins.str;
}

pub function plain_imm(ins: SInst): i32 {
  if (ins.kind_tag == CALL && ins.imm >= 1 && ins.imm <= 3) {
    return 0;
  }
  return ins.imm;
}

function carries_imm(kind: i32): boolean {
  return kind == CONST_INT || kind == CONST_BOOL || kind == PARAM || kind == -4 || kind == -6 || kind == -10 || kind == -49;
}

function carries_str(kind: i32): boolean {
  return kind == BINARY || kind == UNARY || kind == CALL || semantic_names_symbol(kind);
}

function shows_imm(ins: SInst): boolean {
  return carries_imm(ins.kind_tag) || ins.kind_tag >= LD_AT && ins.kind_tag <= ARR_ST && ins.imm != 0;
}

function shows_str(ins: SInst): boolean {
  return carries_str(ins.kind_tag) || ins.kind_tag >= LD_AT && ins.kind_tag <= LANE_STORE && ins.str != "";
}

function inst_detail(ins: SInst): string {
  if (ins.kind_tag == CONST_INT && ins.str != "") {
    return " " + ins.str;
  }
  let out = "";
  if (shows_imm(ins)) {
    out = out + " " + util.i32_to_string(ins.imm);
  }
  if (shows_str(ins)) {
    out = out + " " + ins.str;
  }
  return out;
}

pub function print_func(f: SFunc): string {
  let out = "func " + f.name + " {\n";
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    out = out + "  b" + util.i32_to_string(blk.id) + ":\n";
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      out = out + "    v" + util.i32_to_string(ins.result) + " = " + kind_name(ins.kind_tag) + inst_detail(ins);
      for ai in 0..ins.args.len() {
        out = out + " v" + util.i32_to_string(ins.args[ai]);
      }
      out += "\n";
    }
    if (blk.term.kind_tag == TERM_UNREACHABLE) {
      out += "    unreachable\n";
    } else if (blk.term.kind_tag == TERM_RET && blk.term.value < 0) {
      out += "    ret\n";
    } else if (blk.term.kind_tag == TERM_RET) {
      out = out + "    ret v" + util.i32_to_string(blk.term.value) + "\n";
    } else if (blk.term.kind_tag == TERM_BR) {
      out = out + "    br b" + util.i32_to_string(blk.term.target) + "\n";
    } else if (blk.term.kind_tag == TERM_BRIF) {
      out = out + "    brif v" + util.i32_to_string(blk.term.cond) + " b" + util.i32_to_string(blk.term.t) + " b" + util.i32_to_string(blk.term.f) + "\n";
    }
  }
  return out + "}\n";
}

