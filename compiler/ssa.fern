pub const SEM_MAP_HAS: i32 = -27;

pub const SEM_MAP_GET_OR: i32 = -28;

pub const SEM_MAP_LEN: i32 = -29;

pub const SEM_MAP_GET: i32 = -30;

pub const SEM_MAP_KEYS: i32 = -31;

pub const SEM_MAP_VALUES: i32 = -32;

pub const SEM_MAP_DELETE: i32 = -33;

pub const SEM_MAP_CLEARED: i32 = -34;

pub const SEM_ZERO: i32 = -35;

pub const SEM_STR_BYTES: i32 = -36;

pub const SEM_ARR_JOIN: i32 = -37;

pub const SEM_ARR_SLICE: i32 = -38;

pub const SEM_DYN_UP: i32 = -44;

pub const SEM_DYN_BOX: i32 = -45;

pub const SEM_DYN_IS: i32 = -46;

pub const SEM_DYN_AS: i32 = -47;

pub const SEM_HOLE_AT: i32 = -48;

pub const SEM_HOLE_FILL: i32 = -49;

pub const SEM_ARRAY_LEND: i32 = -50;

pub const SEM_STR_BYTE_VIEW: i32 = -51;

pub const SEM_APPEND_RANGE: i32 = -52;

pub const SEM_ARRAY_RESERVE: i32 = -53;

