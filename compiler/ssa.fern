pub const SEM_ARRAY_NEW: i32 = -1;

pub const SEM_TUPLE_NEW: i32 = -2;

pub const SEM_ARRAY_GET: i32 = -3;

pub const SEM_TUPLE_GET: i32 = -4;

pub const SEM_RECORD_NEW: i32 = -5;

pub const SEM_RECORD_GET: i32 = -6;

pub const SEM_CALL: i32 = -7;

