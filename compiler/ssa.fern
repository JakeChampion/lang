// compiler/ssa.fern — the static-single-assignment form the
// self-host SSA backend (`-backend ssa`, docs/SELFHOST-SSA-BACKEND.md) works
// on: the data model, the kind and terminator registries, the optimiser
// passes and the register allocator. `ssa_lift.fern` builds an SFunc from a
// lowered function's stack IR; `asm_arm64_ir.fern` and `asm_ir.fern` emit
// it.
//
// Representation (pointer-free — values
// and blocks are referenced by integer id / array index, matching the
// self-host's value-semantics style):
//   - an SSA Value is an i32 id; an instruction (SInst) DEFINES the value
//     whose id is its `result`, and references operands by their ids in
//     `args`;
//   - a block (SBlock) is a list of instructions ending in a terminator;
//   - a function (SFunc) is a list of blocks with an entry index.
//

import "./ast";
import "./parser";
import "./astwalk";
import "./util";

// digits_to_i32 parses a decimal literal's text (non-negative; unary minus
// is a separate ExprUnary). Mirrors the private helper in the emitters.
// digits_to_i32 now lives in util.fern (imported as `util`). See SH-020.

// is_all_digits reports whether every byte of s is an ASCII digit (and s is
// non-empty) — used to tell a tuple index `t.0` from a struct field `t.x`.
// is_all_digits now lives in util.fern (imported as `util`). See SH-020.

// ---- IR ----------------------------------------------------------------

// SInst is integer-tagged: `kind_tag` holds a kind_id (the registry below;
// `kind_name` renders one). `args` are value ids, `str` carries a name or
// operator for the kinds that need text.
//
// `imm` IS OVERLOADED — one i32 field carrying four unrelated meanings,
// discriminated only by kind_tag, which the checker cannot police (SH-049):
//
//   const_int    the constant value          const_bool  0 / 1
//   param        the parameter index         alloc       the slot COUNT
//   load_elem / store_elem                   the operand WIDTH, 32 or 64
//
// So a kind_tag/imm mismatch type-checks and surfaces as a wrong-width load or
// a wrong-size allocation. Until the tagged union in SH-049 lands, this table
// is the only thing standing between the two.
//
// The kinds carrying no imm leave it 0: binary / unary (op in `str`, operands
// in `args`), call (callee in `str`), copy (result aliases args[0], a var
// read), and phi (args parallel to the block's preds — operand i flows in when
// control arrives from preds[i]).
pub struct SInst { kind_tag: i32, result: i32, args: i32[], imm: i32, str: string }

// STerm kinds: "ret" (value), "br" (target), "brif" (cond, t, f).
pub struct STerm { kind_tag: i32, cond: i32, target: i32, t: i32, f: i32, value: i32 }

pub struct SBlock { id: i32, insts: SInst[], term: STerm, preds: i32[] }

// SFunc: nparams params occupy value ids 0..nparams-1; nvals is the next
// fresh value id; blocks[entry] is the entry block.
// takes_env is true when the function's last param is the closure `__env`
// (a capturing lambda lifted by collect_lambdas). The wasm backend uses it
// to decide whether a function-table entry can be called with the closure
// convention directly or needs an env-dropping wrapper; the native backends
// ignore it (their indirect calls tolerate an unused trailing arg).
pub struct SFunc { name: string, nparams: i32, nvals: i32, blocks: SBlock[], entry: i32, takes_env: boolean }

function t_ret(value: i32): STerm {
  return STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: value };
}

function t_br(target: i32): STerm {
  return STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function t_brif(cond: i32, t: i32, f: i32): STerm {
  return STerm { kind_tag: 3, cond: cond, target: 0, t: t, f: f, value: 0 };
}

function buf_kind_name(id: i32): string {
  if (id == 28) {
    return "buf_new";
  }
  if (id == 29) {
    return "buf_push";
  }
  if (id == 30) {
    return "buf_push_range";
  }
  if (id == 31) {
    return "buf_push_byte";
  }
  if (id == 32) {
    return "buf_len";
  }
  if (id == 33) {
    return "buf_take";
  }
  return "buf_free";
}

pub function kind_name(id: i32): string {
  if (id < 0) {
    return semantic_kind_name(id);
  }
  // line: the source-position marker (#11410), imm the merged module's line
  // and str its column, no operands and a value nothing reads.
  if (id == 35) {
    return "line";
  }
  // select: args [cond, a, b], a when cond is non-zero and b otherwise
  // (select_branches).
  if (id == 36) {
    return "select";
  }
  if (id == 1) {
    return "const_int";
  }
  if (id == 2) {
    return "const_bool";
  }
  if (id == 3) {
    return "const_i64";
  }
  if (id == 4) {
    return "const_float";
  }
  if (id == 5) {
    return "const_str";
  }
  if (id == 6) {
    return "param";
  }
  if (id == 7) {
    return "copy";
  }
  if (id == 8) {
    return "phi";
  }
  if (id == 9) {
    return "binary";
  }
  if (id == 10) {
    return "unary";
  }
  if (id == 11) {
    return "call";
  }
  if (id == 12) {
    return "call_indirect";
  }
  if (id == 13) {
    return "funcaddr";
  }
  if (id == 14) {
    return "alloc";
  }
  if (id == 15) {
    return "load_elem";
  }
  if (id == 16) {
    return "store_elem";
  }
  if (id == 17) {
    return "concat";
  }
  if (id == 18) {
    return "streq";
  }
  if (id == 19) {
    return "print";
  }
  if (id == 20) {
    return "write";
  }
  if (id == 21) {
    return "exit";
  }
  if (id == 22) {
    return "args";
  }
  if (id == 26) {
    return "read_file";
  }
  if (id == 27) {
    return "write_file";
  }
  if (id >= 28 && id <= 34) {
    return buf_kind_name(id);
  }
  if (id >= 40 && id <= 60) {
    return prod_kind_name(id);
  }
  return "invalid";
}

// The semantic operations whose str names something: a call names its callee,
// a variant operation names its variant, and a closure names the body whose
// address its box holds. `length` names nothing, so the set is listed rather
// than taken as a range over the tags below call's.
function semantic_names_symbol(id: i32): boolean {
  return id == 0 - 7 || id == 0 - 8 || id == 0 - 9 || id == 0 - 10
    || id == 0 - 11 || id == 0 - 12 || id == 0 - 20;
}

// What an instruction prints after its kind. A constant too wide for the
// immediate carries the literal's TEXT instead, so that is what is printed for
// it rather than the zero its immediate holds; the other kinds print the
// immediate, the operator, or the symbol they name.
// The emitted-RC certifier's marks on a lifted instruction (ssa_lift): a
// load's `rc` in `str` when it reads a counted reference, a call's 1 (its
// result is a counted reference), 2 (a shell release) or 3 (a lent result)
// in `imm`; a call's 4 (the emitters' alignment proof) and 5 (a sole
// release) stay. A pass that reads an instruction's shape rather than its
// ownership reads it through these.
pub function plain_str(ins: SInst): string {
  if ((ins.kind_tag == 40 || ins.kind_tag == 42) && ins.str.len() >= 2 && slice_unchecked(ins.str, ins.str.len() - 2, ins.str.len()) == "rc") {
    return slice_unchecked(ins.str, 0, ins.str.len() - 2) + "";
  }
  return ins.str;
}

pub function plain_imm(ins: SInst): i32 {
  if (ins.kind_tag == 11 && ins.imm >= 1 && ins.imm <= 3) {
    return 0;
  }
  return ins.imm;
}

function carries_imm(kind: i32): boolean {
  return kind == 1 || kind == 2 || kind == 6 || kind == 0 - 4 || kind == 0 - 6 || kind == 0 - 10 || kind == 0 - 49;
}

function carries_str(kind: i32): boolean {
  return kind == 9 || kind == 10 || kind == 11 || semantic_names_symbol(kind);
}

// A variant projection carries BOTH: the field index and the variant name.
// A memory or call-like instruction (40..60) prints the offset and mark it
// carries: `ld_at 8 rc`.
function shows_imm(ins: SInst): boolean {
  return carries_imm(ins.kind_tag) || ins.kind_tag >= 40 && ins.kind_tag <= 43 && ins.imm != 0;
}

function shows_str(ins: SInst): boolean {
  return carries_str(ins.kind_tag) || ins.kind_tag >= 40 && ins.kind_tag <= 60 && ins.str != "";
}

function inst_detail(ins: SInst): string {
  if (ins.kind_tag == 1 && ins.str != "") {
    return " " + ins.str;
  }
  let out: string = "";
  if (shows_imm(ins)) {
    out = out + " " + util.i32_to_string(ins.imm);
  }
  if (shows_str(ins)) {
    out = out + " " + ins.str;
  }
  return out;
}

pub function print_func(f: SFunc): string {
  let out: string = "func " + f.name + " {\n";
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    out = out + "  b" + util.i32_to_string(blk.id) + ":\n";
    let k: i32 = 0;
    while (k < blk.insts.len()) {
      let ins: SInst = blk.insts[k];
      out = out + "    v" + util.i32_to_string(ins.result) + " = " + kind_name(ins.kind_tag) + inst_detail(ins);
      let ai: i32 = 0;
      while (ai < ins.args.len()) {
        out = out + " v" + util.i32_to_string(ins.args[ai]);
        ai = ai + 1;
      }
      out = out + "\n";
      k = k + 1;
    }
    if (blk.term.kind_tag == 4) {
      out = out + "    unreachable\n";
    } else if (blk.term.kind_tag == 1 && blk.term.value < 0) {
      out = out + "    ret\n";
    } else if (blk.term.kind_tag == 1) {
      out = out + "    ret v" + util.i32_to_string(blk.term.value) + "\n";
    } else if (blk.term.kind_tag == 2) {
      out = out + "    br b" + util.i32_to_string(blk.term.target) + "\n";
    } else if (blk.term.kind_tag == 3) {
      out = out + "    brif v" + util.i32_to_string(blk.term.cond) + " b" + util.i32_to_string(blk.term.t) + " b" + util.i32_to_string(blk.term.f) + "\n";
    }
    bi = bi + 1;
  }
  return out + "}\n";
}

// Kinds 40..48 are the production lift's memory vocabulary
// (ssa_lift.lift_from_ir_prod, docs/SELFHOST-SSA-BACKEND.md): the flat
// backends' box layouts spelled as loads, stores, checked element reads, a
// box allocation and label addresses, so every record, array, string and
// variant op lifts to a few of these and each emitter selects them with the
// flat backend's own instructions.
//
//   40 ld_at      args [base]           imm = byte offset; 8-byte load
//   41 st_at      args [base, val]      imm = byte offset; 8-byte store, no result read
//   42 arr_at     args [base, idx]      element idx of a length-prefixed box, bounds-checked (imm 1: unchecked; imm 2: the check alone, no load or result)
//   43 arr_st     args [base, idx, val] the checked store
//   44 str_at     args [box, idx]       byte idx of a string box, bounds-checked (imm as on arr_at)
//   45 fn_addr    str = function name   the address of __fn_<name>
//   46 shape_addr str = shape name      the address of the interned shape
//   47 str_lit    str = literal         the address of the literal's static box
//   48 arr_box    imm = cap             __fern_arr_box(cap): a fresh rc-headered box (a call)
//   49 str_call   str = IR op name      a Fern-compiled runtime helper on the stack ABI (str_concat, arr_slice, ...)
//   50 rt_call    str = IR op name      a runtime routine on the register ABI (arr_push, alloc, ...)
//   51 str_view   args [src, lo, hi]    a string slice: the {rc -1, data, len} view box, in the frame (imm 1) or on the heap (imm 0)
//   52 ld_idx     args [base, idx]      8-byte load at base + idx*8, unchecked (the raw memory floor)
//   53 st_idx     args [base, idx, val] 8-byte store at base + idx*8
//   54 ld_byte    args [base, idx]      byte load at base + idx, zero-extended
//   55 st_byte    args [base, idx, val] byte store at base + idx
//   56 call_ind   args [target, a0..]   a call through a function value, on the stack ABI
//   57 agg_lit    str = packed constant a static record or variant box (ir.const_struct_*), by address
function prod_kind_name(id: i32): string {
  let names: string[] = [
    "ld_at", "st_at", "arr_at", "arr_st", "str_at", "fn_addr", "shape_addr", "str_lit", "arr_box", "str_call", "rt_call", "str_view",
    "ld_idx", "st_idx", "ld_byte", "st_byte", "call_ind", "agg_lit", "sym_addr", "flat_op", "dyn_dispatch",
  ];
  return names[id - 40];
}

// Negative ids are the typed semantic phase's operations (ssasem.fern owns
// them); physical consumers never see them, the printer only names them. They
// run from -1 downward without gaps, so the table is indexed by -id - 1; an id
// outside it names nothing, exactly as an unknown id always did.
function semantic_kind_name(id: i32): string {
  let names: string[] = [
    "array_new", "tuple_new", "array_get", "tuple_get",
    "record_new", "record_get", "call", "variant_new", "variant_is",
    "variant_get", "variant_up", "variant_as", "length", "append", "slice",
    "str_index", "cast", "str_as", "with", "closure_new", "call_value", "cell_new", "cell_get", "cell_set",
    "map_new", "map_insert", "map_has", "map_get_or", "map_len", "map_get",
    "map_keys", "map_values", "map_delete", "map_cleared", "zero", "str_bytes",
    "arr_join", "arr_slice", "map_iter", "mapiter_has_next",
    "mapiter_key", "mapiter_value", "mapiter_advance", "dyn_up", "dyn_box",
    "dyn_is", "dyn_as", "hole_at", "hole_fill", "array_lend", "str_byte_view", "append_range",
  ];
  let at: i32 = 0 - id - 1;
  if (at < 0 || at >= names.len()) {
    return "invalid";
  }
  return names[at];
}

// ---- integer kind registry (#4394 lever 2 / #5351, foundation slice) ----
// The SSA analogue of ir.fern's op-kind registry (kind_id / kind_name):
// a stable 1-based id per SInst kind and per STerm kind, with 0 as the
// invalid / none sentinel in both spaces. The conversion this registry was
// staged for is DONE: SInst and STerm carry `kind_tag: i32` and no string
// kind, and the backend dispatch ladders switch on the id. What the names
// are still for is printing and the golden below.
// The ssa_kind_run driver + TestSelfHostSSAKindRegistry pin the id<->name
// bijection and both sentinels, so a kind added to one direction (or a
// duplicated id) fails the golden instead of silently misdispatching a
// backend later (the SH-003/SH-005 class).
//
// NOTE: this vocabulary is the SSA layer's own — it deliberately does NOT
// reuse ir.kind_id (SSA's "const_int"/"binary"/"phi"/... don't exist in
// the stack-IR registry and vice versa).

// kind_count is the number of registered SInst kinds (ids 1..kind_count()).
pub function kind_count(): i32 {
  return 36;
}

// kind_retired is an id in 1..kind_count() whose kind is gone: 23..25 (the
// strbuf singleton). The number is not reused.
pub function kind_retired(id: i32): boolean {
  return id >= 23 && id <= 25;
}

pub function kind_id(name: string): i32 {
  if (name == "const_int") {
    return 1;
  }
  if (name == "line") {
    return 35;
  }
  if (name == "select") {
    return 36;
  }
  if (name == "const_bool") {
    return 2;
  }
  if (name == "const_i64") {
    return 3;
  }
  if (name == "const_float") {
    return 4;
  }
  if (name == "const_str") {
    return 5;
  }
  if (name == "param") {
    return 6;
  }
  if (name == "copy") {
    return 7;
  }
  if (name == "phi") {
    return 8;
  }
  if (name == "binary") {
    return 9;
  }
  if (name == "unary") {
    return 10;
  }
  if (name == "call") {
    return 11;
  }
  if (name == "call_indirect") {
    return 12;
  }
  if (name == "funcaddr") {
    return 13;
  }
  if (name == "alloc") {
    return 14;
  }
  if (name == "load_elem") {
    return 15;
  }
  if (name == "store_elem") {
    return 16;
  }
  if (name == "concat") {
    return 17;
  }
  if (name == "streq") {
    return 18;
  }
  if (name == "print") {
    return 19;
  }
  if (name == "write") {
    return 20;
  }
  if (name == "exit") {
    return 21;
  }
  if (name == "args") {
    return 22;
  }
  if (name == "read_file") {
    return 26;
  }
  if (name == "write_file") {
    return 27;
  }
  if (name.len() >= 7 && name[0] == b'b') {
    return buf_kind_id(name);
  }
  return 0;
}

// The capacity-carrying string builder's block (#8773), split out so the seven
// names cost kind_id / kind_name one test apiece. `binary` is the only other
// kind starting with 'b' and it is six bytes, so the length guard separates
// them without a second compare.
//
// `buf_push_u64` is deliberately absent. This backend stores a string as one
// byte per EIGHT-byte word, so the single store the op exists for (#9221)
// would be eight stores here and the op would lose its whole reason to be one.
// An unknown callee bails calls_all_known, so a module using it takes the IR
// path — the same answer wasm's SSA lowering gives the family entire.
function buf_kind_id(name: string): i32 {
  if (name == "buf_new") {
    return 28;
  }
  if (name == "buf_push") {
    return 29;
  }
  if (name == "buf_push_range") {
    return 30;
  }
  if (name == "buf_push_byte") {
    return 31;
  }
  if (name == "buf_len") {
    return 32;
  }
  if (name == "buf_take") {
    return 33;
  }
  if (name == "buf_free") {
    return 34;
  }
  return 0;
}

// term_count is the number of registered STerm kinds (ids 1..term_count()).
// Id 0 is the "no terminator" sentinel (t_none's empty-string kind today):
// term_id("") == 0 and term_name(0) == "" by construction, so the eventual
// `terminated()` check becomes `term.kind_tag != 0`.
pub function term_count(): i32 {
  return 3;
}

pub function term_id(name: string): i32 {
  if (name == "ret") {
    return 1;
  }
  if (name == "br") {
    return 2;
  }
  if (name == "brif") {
    return 3;
  }
  return 0;
}

pub function term_name(id: i32): string {
  if (id == 1) {
    return "ret";
  }
  if (id == 2) {
    return "br";
  }
  if (id == 3) {
    return "brif";
  }
  return "";
}

// zeros returns an n-long i32 array of 0s (scratch flag/value tables).
function rewrite_args(ins: SInst, resolved: i32[]): SInst {
  let na: i32[] = [];
  let i: i32 = 0;
  while (i < ins.args.len()) {
    na = na.append(resolved[ins.args[i]]);
    i = i + 1;
  }
  return SInst { kind_tag: ins.kind_tag, result: ins.result, args: na, imm: ins.imm, str: ins.str };
}

function rewrite_term(t: STerm, resolved: i32[]): STerm {
  if (t.kind_tag == 1) {
    return t_ret(resolved[t.value]);
  }
  if (t.kind_tag == 3) {
    return t_brif(resolved[t.cond], t.t, t.f);
  }
  return t;
}

// ---- register allocation ------------------------------------------------
// regalloc assigns each SSA value either a physical register index
// (0..nregs-1) or -1 (spilled — the backend keeps it in its [sp,#8*v] /
// rbp-slot). It's a linear-scan allocator over a conservative live
// interval per value: the value is numbered live from the lowest to the
// highest instruction position among its definition and all its uses. For
// our structured CFGs that range covers the true live range (a loop-
// carried value used by a header phi gets a use position BELOW its body
// def, which widens the interval to span the loop — exactly where it's
// live). A value whose interval strictly contains a `call` takes a
// callee-saved register or a slot, never a caller-saved register.

// inst_is_call names the instructions that clobber the caller-saved registers:
// the calls proper, the toy runtime's string / output / file / buffer
// helpers, and the production lift's box allocation.
function inst_is_call(k: i32): boolean {
  if (k == 11 || k == 12 || k == 17 || k == 18 || k == 48 || k == 49 || k == 50 || k == 51 || k == 56 || k == 59 || k == 60) {
    return true;
  }
  return k >= 19 && k <= 27;
}

// returns_call reports a call at `k` that ends `blk`, which returns its
// result: nothing but that result is live past it, so no value needs a
// register the call preserves. Whatever else holds a register over it lives
// only on paths that do not run it.
pub function returns_call(blk: SBlock, k: i32): boolean {
  let ins: SInst = blk.insts[k];
  return k == blk.insts.len() - 1 && blk.term.kind_tag == 1 && ins.result >= 0 && blk.term.value == ins.result;
}

// calls_out reports an instruction that is a call wherever it is emitted. An
// inlined rc primitive is not one, though its slow path may still call.
pub function calls_out(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (calls(ins)) {
        return true;
      }
    }
  }
  return false;
}

// calls reports one instruction calls_out counts.
pub function calls(ins: SInst): boolean {
  return inst_is_call(ins.kind_tag) && !rc_inlined(ins);
}

// rc_inlined names a call both register-path emitters render at the site
// rather than calling: the two rc primitives whose whole body is a guard
// chain over the count word. `__fern_rc_dec` is NOT one of them — it maps to
// the array release, which frees.
//
// The allocator still counts these positions as calls (inst_is_call), so a
// value is still spilled across one. Not counting them was measured and did
// not pay: it frees six caller-saved registers to more values at once, and
// over bench that came out between 0.5% worse and unchanged.
pub function rc_inlined(ins: SInst): boolean {
  if (ins.kind_tag != 11 || ins.args.len() != 1) {
    return false;
  }
  return ins.str == "__fern_rc_is_unique" || ins.str == "__fern_rc_inc";
}

// calls_before counts, for every position p, the calls at positions below
// p; spans_call reads two entries. The scan over the call list it replaces
// ran once per value, which on a function with thousands of calls and tens
// of thousands of values was most of the allocator's time.
function calls_before(calls: i32[], total_pos: i32): i32[] {
  let cum: i32[] = __alloc_i32(total_pos + 2);
  let ci: i32 = 0;
  let p: i32 = 0;
  while (p <= total_pos + 1) {
    cum = cum.with(p, ci);
    while (ci < calls.len() && calls[ci] < p + 1) {
      ci = ci + 1;
    }
    p = p + 1;
  }
  return cum;
}

// spans_call is true when some call position lies strictly inside (lo, hi).
function spans_call(cum: i32[], lo: i32, hi: i32): boolean {
  if (hi <= lo + 1) {
    return false;
  }
  let a: i32 = lo + 1;
  if (a >= cum.len()) {
    return false;
  }
  let b: i32 = hi;
  if (b >= cum.len()) {
    b = cum.len() - 1;
  }
  return cum[b] - cum[a] > 0;
}

// order_by_lo returns value ids 0..n-1 sorted ascending by lo, ids ascending
// within one lo. A counting sort over the positions: the insertion sort this
// replaces rebuilt the output array once per value, which on a function with
// tens of thousands of values was a quadratic number of allocations the arena
// never returns.
function order_by_lo(n: i32, lo: i32[]): i32[] {
  let maxp: i32 = 0;
  let v: i32 = 0;
  while (v < n) {
    if (lo[v] < 2000000000 && lo[v] > maxp) {
      maxp = lo[v];
    }
    v = v + 1;
  }
  // Bucket maxp + 1 holds the values never referenced (lo left at the sentinel).
  let starts: i32[] = __alloc_i32(maxp + 3);
  v = 0;
  while (v < n) {
    let b: i32 = order_bucket(lo[v], maxp);
    starts = starts.with(b + 1, starts[b + 1] + 1);
    v = v + 1;
  }
  let b2: i32 = 1;
  while (b2 < starts.len()) {
    starts = starts.with(b2, starts[b2] + starts[b2 - 1]);
    b2 = b2 + 1;
  }
  let out: i32[] = __alloc_i32(n);
  v = 0;
  while (v < n) {
    let bk: i32 = order_bucket(lo[v], maxp);
    out = out.with(starts[bk], v);
    starts = starts.with(bk, starts[bk] + 1);
    v = v + 1;
  }
  return out;
}

function order_bucket(lo: i32, maxp: i32): i32 {
  if (lo >= 2000000000) {
    return maxp + 1;
  }
  return lo;
}

function extend_loop_invariant_intervals(f: SFunc, def_pos: i32[], hi: i32[]): i32[] {
  // Loop-invariant fix: a value defined BEFORE a loop header and used inside
  // the loop is live across the whole loop (re-read every iteration), so its
  // interval must reach the back-edge — otherwise the scan expires it at its
  // textual last use and a loop-body temp reuses its register, corrupting it
  // on the next iteration. (A loop-CARRIED value is covered by the phi's
  // read on the back edge; this covers loop-INVARIANT ones.) Block start
  // positions are recomputed with the same per-block stride (insts + one
  // terminator slot); a terminator targeting a block at or before its own
  // block is a back-edge, and the loop spans [header_start, terminator_pos].
  //
  // Each value's extension reads only the back edges, in block order, so the
  // values are independent: one with no header in (def, hi] cannot extend,
  // and a binary search over the sorted header starts rules most out.
  let top: i32 = 0 - 1;
  for b in f.blocks {
    if (b.id > top) {
      top = b.id;
    }
  }
  let start_of: i32[] = util.minus_ones(top + 1);
  let rpos: i32 = 0;
  for b in f.blocks {
    if (b.id >= 0) {
      start_of = start_of.with(b.id, rpos);
    }
    rpos = rpos + b.insts.len() + 1;
  }
  let edge_head: i32[] = [];
  let edge_end: i32[] = [];
  let lstart: i32 = 0;
  for lblk in f.blocks {
    let lterm_pos: i32 = lstart + lblk.insts.len();
    let th: i32 = 0;
    while (th < 2) {
      let tgt: i32 = 0 - 1;
      if (th == 0) {
        if (lblk.term.kind_tag == 2) {
          tgt = lblk.term.target;
        } else if (lblk.term.kind_tag == 3) {
          tgt = lblk.term.t;
        }
      } else if (lblk.term.kind_tag == 3) {
        tgt = lblk.term.f;
      }
      if (tgt >= 0 && tgt <= top) {
        let hstart: i32 = start_of[tgt];
        if (hstart >= 0 && hstart <= lstart) {
          edge_head = edge_head.append(hstart);
          edge_end = edge_end.append(lterm_pos);
        }
      }
      th = th + 1;
    }
    lstart = lterm_pos + 1;
  }
  if (edge_head.len() == 0) {
    return hi;
  }
  let heads: i32[] = sorted_i32(edge_head);
  let vv: i32 = 0;
  while (vv < f.nvals && vv < hi.len()) {
    let d: i32 = def_pos[vv];
    if (d >= 0) {
      let first: i32 = first_above(heads, d);
      if (first < heads.len() && heads[first] <= hi[vv]) {
        let e: i32 = 0;
        while (e < edge_head.len()) {
          if (d < edge_head[e] && hi[vv] >= edge_head[e] && edge_end[e] > hi[vv]) {
            hi = hi.with(vv, edge_end[e]);
          }
          e = e + 1;
        }
      }
    }
    vv = vv + 1;
  }
  return hi;
}

// sorted_i32 is xs in ascending order (an insertion sort; the lists are a
// function's back edges).
function sorted_i32(xs: i32[]): i32[] {
  let out: i32[] = [];
  for x in xs {
    out = out.append(x);
    let i: i32 = out.len() - 1;
    while (i > 0 && out[i - 1] > x) {
      out = out.with(i, out[i - 1]);
      i = i - 1;
    }
    out = out.with(i, x);
  }
  return out;
}

// first_above is the index of the first element of ascending xs greater than
// v, or xs.len() when there is none.
function first_above(xs: i32[], v: i32): i32 {
  let lo: i32 = 0;
  let hi: i32 = xs.len();
  while (lo < hi) {
    let mid: i32 = (lo + hi) / 2;
    if (xs[mid] > v) {
      hi = mid;
    } else {
      lo = mid + 1;
    }
  }
  return lo;
}

// An instruction can also fix a register without being a call: x86-64's idiv
// takes its dividend in %rax and writes %rdx, so a division clobbers the ABI
// result register while remaining an ordinary binary. A value may only be
// homed there if its interval spans none of them. The op names are the IR
// registry's (kind ids 24-27); arm64's sdiv/udiv take any registers, so its
// emitter names none.
pub function binary_fixes_abi(op: string): boolean {
  return op == "div_s" || op == "div_u" || op == "rem_s" || op == "rem_u" || op == "mulhi_u";
}

// `abi_reg` is the pool index of the register the target's ABI returns a
// call's result in, or -1 where the emitter still uses that register as
// scratch. A value a call defines is given it when it is free, so the store
// after the call finds the value already home and emits nothing; every other
// value takes it last, so it stays available for the next call result.
// Returns -1 when no caller-saved register this value may use is free, so the
// caller falls through to the callee-saved pool or to a spill.
function pick_caller_reg(free: i32[], abi_reg: i32, want_abi: boolean, abi_ok: boolean): i32 {
  if (free.len() == 0) {
    return 0 - 1;
  }
  if (abi_reg < 0) {
    return free[free.len() - 1];
  }
  if (want_abi) {
    for r in free {
      if (r == abi_reg) {
        return abi_reg;
      }
    }
  }
  let i: i32 = free.len() - 1;
  while (i >= 0) {
    if (free[i] != abi_reg) {
      return free[i];
    }
    i = i - 1;
  }
  if (!abi_ok) {
    return 0 - 1;
  }
  return abi_reg;
}

function remove_reg(free: i32[], reg: i32): i32[] {
  let out: i32[] = [];
  let dropped: boolean = false;
  for r in free {
    if (r == reg && !dropped) {
      dropped = true;
    } else {
      out = out.append(r);
    }
  }
  return out;
}

function forbidden_abi(abi_reg: i32, allowed: boolean): i32 {
  if (allowed) {
    return 0 - 1;
  }
  return abi_reg;
}

// cheapest_active is the index of the active interval, among those holding a
// register of the class this value needs, whose spill costs least per
// position it covers (the latest ending on a tie), or -1. A spilled value pays
// at every reference and frees its register for its whole interval, so what is
// spilled should minimize weighted reference cost for its lifetime.
function cheapest_active(act_val: i32[], act_reg: i32[], act_hi: i32[], shared_with: i32[], weight: i32[], lo: i32[], hi: i32[], now: i32, nregs: i32, need_saved: boolean, forbidden: i32): i32 {
  let best: i32 = 0 - 1;
  let best_w: i32 = 0;
  let best_len: i32 = 1;
  let i: i32 = 0;
  while (i < act_val.len()) {
    if (act_reg[i] >= nregs == need_saved && act_reg[i] != forbidden) {
      let w: i32 = chain_weight(act_val[i], shared_with, weight, hi, now);
      let len: i32 = act_hi[i] - chain_lo(act_val[i], shared_with, lo, hi, now) + 1;
      let cmp: i32 = cmp_spill_cost(w, len, best_w, best_len);
      if (best < 0 || cmp < 0 || cmp == 0 && act_hi[i] > act_hi[best]) {
        best = i;
        best_w = w;
        best_len = len;
      }
    }
    i = i + 1;
  }
  return best;
}

// Compare squared reference weight per position. Squaring protects values
// expensive to spill without ignoring how long they occupy a register.
// f64 products avoid overflowing when weights or intervals are large.
function cmp_spill_cost(w1: i32, len1: i32, w2: i32, len2: i32): i32 {
  let a: f64 = w1 as f64 * (w1 as f64) * (len2 as f64);
  let b: f64 = w2 as f64 * (w2 as f64) * (len1 as f64);
  if (a < b) {
    return 0 - 1;
  }
  if (a > b) {
    return 1;
  }
  return 0;
}

// chain_lo is where the first of the values sharing v's register that an
// eviction at `now` spills begins (still_holds).
function chain_lo(v: i32, shared_with: i32[], lo: i32[], hi: i32[], now: i32): i32 {
  let m: i32 = lo[v];
  let ev: i32 = shared_with[v];
  while (ev >= 0) {
    if (still_holds(ev, hi, now) && lo[ev] < m) {
      m = lo[ev];
    }
    ev = shared_with[ev];
  }
  return m;
}

// chain_weight sums the spill weights of a register's holder and of the
// values before it that an eviction at `now` spills too.
function chain_weight(v: i32, shared_with: i32[], weight: i32[], hi: i32[], now: i32): i32 {
  let w: i32 = weight[v];
  let ev: i32 = shared_with[v];
  while (ev >= 0) {
    if (still_holds(ev, hi, now)) {
      w = w + weight[ev];
    }
    ev = shared_with[ev];
  }
  return w;
}

// any_below says some entry of xs is below x.
function any_below(xs: i32[], x: i32): boolean {
  for e in xs {
    if (e < x) {
      return true;
    }
  }
  return false;
}

// still_holds says an eviction at `now` spills ev, an earlier holder of the
// evicted value's register: one whose interval still reaches `now`, as a phi
// does when its loop-carried operand took its register over. A holder whose
// interval ended keeps the register; the edge to its successor moves instead.
// Ends do not fall along a chain, so a live holder can follow an ended one.
function still_holds(ev: i32, hi: i32[], now: i32): boolean {
  return hi[ev] >= now;
}

// block_loop_weights gives each block, by position, the weight of one
// reference inside it: 8 per enclosing loop, up to three. A loop is the span
// of block positions from a back edge's target to its source.
function block_loop_weights(f: SFunc): i32[] {
  let at: i32[] = block_positions(f);
  let depth: i32[] = __alloc_i32(f.blocks.len());
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let which: i32 = 0;
    while (which < 2) {
      let tgt: i32 = distinct_successor_position(at, f.blocks[bi].term, which);
      if (tgt >= 0 && tgt <= bi) {
        let k: i32 = tgt;
        while (k <= bi) {
          depth = depth.with(k, depth[k] + 1);
          k = k + 1;
        }
      }
      which = which + 1;
    }
    bi = bi + 1;
  }
  let out: i32[] = [];
  for d in depth {
    let w: i32 = 1;
    let n: i32 = 0;
    while (n < d && n < 3) {
      w = w * 8;
      n = n + 1;
    }
    out = out.append(w);
  }
  return out;
}

function drop_active_at(a: i32[], k: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < a.len()) {
    if (i != k) {
      out = out.append(a[i]);
    }
    i = i + 1;
  }
  return out;
}

// Alloc is regalloc_linear's assignment, `reg_of`, with the interval each home
// holds its value over: from the end of position def_pos[v] to the end of
// hi[v], numbered over the instructions and then the terminator of each block
// in layout order, -1 for a value with no interval. A `-g` build describes a
// variable's location from it (#11410).
pub struct Alloc { reg_of: i32[], def_pos: i32[], hi: i32[] }

// float_values marks the values that live in the float register class: an
// f64 an f64 operation defines (or a parameter, phi, word load, or the result
// of a call `fcalls` marks) that f64 operations (the reinterpret to
// its bits among them), phis of the class and a return read, and, on an
// emitter whose calls take a float home (`tolerant`), direct call arguments as
// well. A parameter, phi or call result also needs one f64
// operation or float phi among its readers, or nothing is gained by a float
// home. Anything else that reads it — a store, say — keeps it in an integer
// register, so that only the emitters' class-aware paths ever meet a float
// home. Empty when no value qualifies.
pub function float_values(f: SFunc, fcalls: boolean[], tolerant: boolean): boolean[] {
  let fl: boolean[] = __alloc_bool(f.nvals);
  let derived: boolean[] = __alloc_bool(f.nvals);
  // A derived value stays only where an f64 operation reads it, so a function
  // with no f64 operation and no value only an f64 can be keeps none.
  let seeded: boolean = false;
  for blk in f.blocks {
    for ins in blk.insts {
      let fcall: boolean = ins.kind_tag == 11 && ins.result >= 0 && ins.result < fcalls.len() && fcalls[ins.result];
      if (ins.result >= 0 && ins.result < f.nvals && (float_def(ins) || fcall)) {
        let d: boolean = ins.kind_tag == 6 || ins.kind_tag == 8 || ins.kind_tag == 11 || float_load(ins);
        fl = fl.with(ins.result, true);
        derived = derived.with(ins.result, d);
        seeded = seeded || !d;
      }
      seeded = seeded || float_use(ins);
    }
  }
  if (!seeded) {
    return [];
  }
  // A value leaves the class when anything outside it reads it, which can
  // take a phi out and with it the values only that phi read.
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let strong: boolean[] = float_strong(f, fl, derived);
    for blk in f.blocks {
      for ins in blk.insts {
        let keeps: boolean = float_use(ins) || ins.kind_tag == 8 && fl[ins.result] || tolerant && float_tolerant(ins);
        for a in ins.args {
          if (!keeps && a >= 0 && a < f.nvals && fl[a]) {
            fl = fl.with(a, false);
            changed = true;
          }
        }
      }
      let t: STerm = blk.term;
      if (t.kind_tag == 3 && t.cond >= 0 && t.cond < f.nvals && fl[t.cond]) {
        fl = fl.with(t.cond, false);
        changed = true;
      }
    }
    let v: i32 = 0;
    while (v < f.nvals) {
      if (fl[v] && derived[v] && !strong[v]) {
        fl = fl.with(v, false);
        changed = true;
      }
      v = v + 1;
    }
  }
  for x in fl {
    if (x) {
      return fl;
    }
  }
  return [];
}

// float_strong marks the derived values (parameters, phis, call results) a
// float home serves: one an f64 operation reads, or a phi joining one that is
// an f64 operation's result or is itself served so.
function float_strong(f: SFunc, fl: boolean[], derived: boolean[]): boolean[] {
  let strong: boolean[] = __alloc_bool(f.nvals);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for blk in f.blocks {
      for ins in blk.insts {
        let fop: boolean = float_use(ins) || ins.kind_tag == 8 && fl[ins.result] && strong[ins.result];
        for a in ins.args {
          if (fop && a >= 0 && a < f.nvals && fl[a] && !strong[a]) {
            strong = strong.with(a, true);
            changed = true;
          }
        }
        if (ins.kind_tag == 8 && ins.result >= 0 && fl[ins.result] && !strong[ins.result]) {
          for a in ins.args {
            if (a >= 0 && a < f.nvals && fl[a] && (!derived[a] || strong[a]) && !strong[ins.result]) {
              strong = strong.with(ins.result, true);
              changed = true;
            }
          }
        }
      }
    }
  }
  return strong;
}

// float_tolerant names a reader that takes a float home through a scratch:
// a direct call's argument.
function float_tolerant(ins: SInst): boolean {
  return ins.kind_tag == 11 && !rc_inlined(ins);
}

// float_def names an instruction whose result is an f64 the float class can
// hold: the literal, the arithmetic, the one-instruction math, the widening to
// f64 and the reinterpret from its bits, a word load, a parameter and a phi.
// The last three are only candidates (float_strong).
function float_def(ins: SInst): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 4 || k == 6 || k == 8 || float_load(ins)) {
    return true;
  }
  if (k == 9) {
    return float_arith(ins.str);
  }
  if (k == 10) {
    return float_math(ins.str) || util.str_has_prefix(ins.str, "i32_to_f64:") || ins.str == "f64_from_bits";
  }
  return false;
}

// float_load names a word load, from a field or an array element, whose word
// an f64 operation may be what reads.
function float_load(ins: SInst): boolean {
  return ins.kind_tag == 40 || ins.kind_tag == 42 && ins.str != "u8";
}

// float_use names an instruction that reads its operands as f64s: the float
// arithmetic and compares, the math, and the conversions and the reinterpret
// out of f64.
function float_use(ins: SInst): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 9) {
    return float_arith(ins.str) || float_cmp(ins.str);
  }
  if (k == 10) {
    return float_math(ins.str) || ins.str == "f64_to_i32" || ins.str == "f64_to_i64" || ins.str == "f64_bits";
  }
  return false;
}

pub function float_arith(op: string): boolean {
  return op == "fadd" || op == "fsub" || op == "fmul" || op == "fdiv";
}

pub function float_cmp(op: string): boolean {
  return op == "feq" || op == "fne" || op == "flt" || op == "fle" || op == "fgt" || op == "fge";
}

pub function float_math(op: string): boolean {
  return op == "fsqrt" || op == "ffloor" || op == "fceil" || op == "ftrunc" || op == "fabs" || op == "fround" || op == "fneg";
}

// class_order is `order` with the float values moved after every other value,
// each part still in its own order; the second result is where they start.
function class_order(order: i32[], fl: boolean[]): i32[] {
  let out: i32[] = [];
  for v in order {
    if (!fl[v]) {
      out = out.append(v);
    }
  }
  for v in order {
    if (fl[v]) {
      out = out.append(v);
    }
  }
  return out;
}

function count_false(fl: boolean[]): i32 {
  let n: i32 = 0;
  for x in fl {
    if (!x) {
      n = n + 1;
    }
  }
  return n;
}

// regalloc_linear assigns each value a register index or a spill slot. The
// indices below `nregs` are the caller-saved registers, the `nsaved` above
// them the callee-saved ones: a value live across a call takes one of the
// latter, or a slot when they are out; any other value takes a caller-saved
// register first, a callee-saved one when those are out, a slot last. The
// lowest indices go first, so an emitter that saves the callee-saved
// registers a function uses saves a dense prefix of them.
// The values `fl` marks (float_values) are the float class: they take the
// `nf` caller-saved float registers numbered from nregs + nsaved and the `nfs`
// callee-saved ones above those, by the same rules. The classes share no
// register, so each is scanned on its own, the float values last.
// `pref[v]`, when not -1, is the caller-saved register v would rather have:
// the one a register-ABI parameter arrives in or a call argument leaves in. It
// is taken when free and v does not live across a call; an empty `pref` asks
// for nothing. A value a block returns that names no register asks for
// `abi_reg`, where the return reads it (`return_prefs`).
pub function regalloc_linear(f: SFunc, nregs: i32, nsaved: i32, abi_reg: i32, abi_fixed_by_div: boolean, no_home: boolean[], pref: i32[], fl: boolean[], nf: i32, nfs: i32): Alloc {
  let wish: i32[] = return_prefs(f, pref, abi_reg);
  let big: i32 = 2000000000;
  let lo: i32[] = __alloc_i32(f.nvals);
  let hi: i32[] = __alloc_i32(f.nvals);
  let i: i32 = 0;
  while (i < f.nvals) {
    lo = lo.with(i, big);
    hi = hi.with(i, 0 - 1);
    i = i + 1;
  }
  let calls: i32[] = [];
  let abi_cl: i32[] = [];

  // Number instructions and record each value's def/use positions.
  let def_pos: i32[] = __alloc_i32(f.nvals);
  let def_blk: i32[] = __alloc_i32(f.nvals);
  let call_def: i32[] = __alloc_i32(f.nvals);
  let reads_mate: boolean[] = __alloc_bool(f.nvals);
  let def_a: i32[] = __alloc_i32(f.nvals);
  let def_b: i32[] = __alloc_i32(f.nvals);
  i = 0;
  while (i < f.nvals) {
    def_pos = def_pos.with(i, 0 - 1);
    def_blk = def_blk.with(i, 0 - 1);
    def_a = def_a.with(i, 0 - 1);
    def_b = def_b.with(i, 0 - 1);
    i = i + 1;
  }
  let blk_start: i32[] = [];
  let pos: i32 = 0;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    blk_start = blk_start.append(pos);
    let k: i32 = 0;
    while (k < blk.insts.len()) {
      let ins: SInst = blk.insts[k];
      if (ins.result >= 0 && ins.result < lo.len() && pos < lo[ins.result]) {
        lo = lo.with(ins.result, pos);
      }
      if (ins.result >= 0 && ins.result < hi.len() && pos > hi[ins.result]) {
        hi = hi.with(ins.result, pos);
      }
      if (ins.result >= 0 && ins.result < def_pos.len()) {
        def_pos = def_pos.with(ins.result, pos);
        def_blk = def_blk.with(ins.result, bi);
        // A call reads its arguments before it writes its result, so
        // the result may take a dying argument's register; a select may
        // take either of the values it picks between.
        if (ins.kind_tag == 36) {
          reads_mate = reads_mate.with(ins.result, true);
          def_a = def_a.with(ins.result, ins.args[1]);
          def_b = def_b.with(ins.result, ins.args[2]);
        } else if (ins.kind_tag == 8 || ins.kind_tag == 10 || ins.kind_tag == 11 || ins.kind_tag == 56 || ins.kind_tag == 60 || ins.kind_tag == 9 && shares_operand_home(ins.str)) {
          reads_mate = reads_mate.with(ins.result, true);
          if (ins.kind_tag != 8 && ins.args.len() > 0) {
            def_a = def_a.with(ins.result, ins.args[0]);
          }
          if (ins.kind_tag != 8 && ins.args.len() > 1) {
            def_b = def_b.with(ins.result, ins.args[1]);
          }
        }
      }
      let a: i32 = 0;
      while (a < ins.args.len() && ins.kind_tag != 8) {
        if (ins.args[a] >= 0 && ins.args[a] < lo.len() && pos < lo[ins.args[a]]) {
          lo = lo.with(ins.args[a], pos);
        }
        if (ins.args[a] >= 0 && ins.args[a] < hi.len() && pos > hi[ins.args[a]]) {
          hi = hi.with(ins.args[a], pos);
        }
        a = a + 1;
      }
      if (inst_is_call(ins.kind_tag)) {
        if (!returns_call(blk, k)) {
          calls = calls.append(pos);
        }
        if (ins.result >= 0 && ins.result < call_def.len()) {
          call_def = call_def.with(ins.result, 1);
        }
      }
      if (abi_fixed_by_div && ins.kind_tag == 9 && binary_fixes_abi(ins.str)) {
        abi_cl = abi_cl.append(pos);
      }
      pos = pos + 1;
      k = k + 1;
    }
    if (blk.term.kind_tag == 1) {
      if (blk.term.value >= 0 && blk.term.value < lo.len() && pos < lo[blk.term.value]) {
        lo = lo.with(blk.term.value, pos);
      }
      if (blk.term.value >= 0 && blk.term.value < hi.len() && pos > hi[blk.term.value]) {
        hi = hi.with(blk.term.value, pos);
      }
    } else if (blk.term.kind_tag == 3) {
      if (blk.term.cond >= 0 && blk.term.cond < lo.len() && pos < lo[blk.term.cond]) {
        lo = lo.with(blk.term.cond, pos);
      }
      if (blk.term.cond >= 0 && blk.term.cond < hi.len() && pos > hi[blk.term.cond]) {
        hi = hi.with(blk.term.cond, pos);
      }
    }
    pos = pos + 1;
    bi = bi + 1;
  }
  // A parameter has no defining instruction: it arrives at entry. Every
  // referenced one is live from position 0, so two parameters whose first
  // reads are apart still interfere, and the entry's moves cannot write one
  // into a home another is still arriving in.
  i = 0;
  while (i < f.nparams && i < f.nvals) {
    if (hi[i] >= 0) {
      lo = lo.with(i, 0);
    }
    i = i + 1;
  }
  let total_pos: i32 = pos;
  let at: i32[] = block_positions(f);
  // A phi reads its operand on the edge from the predecessor, at that
  // block's terminator, not at its own position inside the header. Read
  // there, an operand arriving from before a loop ends before the loop
  // rather than looking live through it, and a loop-carried operand lives
  // from its definition to the back edge it is read on, and no further:
  // what follows the loop, calls included, is not on its interval.
  bi = 0;
  while (bi < f.blocks.len()) {
    let pb: SBlock = f.blocks[bi];
    let pk: i32 = 0;
    while (pk < pb.insts.len()) {
      let ph: SInst = pb.insts[pk];
      if (ph.kind_tag == 8) {
        let sl: i32 = 0;
        while (sl < ph.args.len()) {
          let upos: i32 = blk_start[bi] + pk;
          if (sl < pb.preds.len() && pb.preds[sl] >= 0 && pb.preds[sl] < at.len() && at[pb.preds[sl]] >= 0) {
            let pi: i32 = at[pb.preds[sl]];
            upos = blk_start[pi] + f.blocks[pi].insts.len();
          }
          let pa: i32 = ph.args[sl];
          if (pa >= 0 && pa < lo.len() && upos < lo[pa]) {
            lo = lo.with(pa, upos);
          }
          if (pa >= 0 && pa < hi.len() && upos > hi[pa]) {
            hi = hi.with(pa, upos);
          }
          sl = sl + 1;
        }
      }
      pk = pk + 1;
    }
    bi = bi + 1;
  }
  // A value with no home has no interval: the phi reads above are dropped
  // with the rest, and the loop extension below leaves a value with none.
  i = 0;
  while (i < no_home.len() && i < f.nvals) {
    if (no_home[i]) {
      hi = hi.with(i, 0 - 1);
    }
    i = i + 1;
  }

  hi = extend_loop_invariant_intervals(f, def_pos, hi);
  let cum: i32[] = calls_before(calls, total_pos);
  let cum_abi: i32[] = calls_before(abi_cl, total_pos);
  let mates: Mates = phi_mates(f, at, def_pos, hi, no_home);
  let weight: i32[] = spill_weights(f, at);
  let sole: i32[] = sole_readers(f);

  // Built the first time an interference question is asked.
  let sites: ReadSites = ReadSites { start: [], blk: [], pos: [], succ_a: [], succ_b: [], phi_end: [] };
  let reg_of: i32[] = __alloc_i32(f.nvals);
  let shared_with: i32[] = __alloc_i32(f.nvals);
  i = 0;
  while (i < f.nvals) {
    reg_of = reg_of.with(i, 0 - 1);
    shared_with = shared_with.with(i, 0 - 1);
    i = i + 1;
  }

  // Linear scan in order of interval start.
  let order: i32[] = order_by_lo(f.nvals, lo);
  let split: i32 = order.len();
  if (fl.len() > 0) {
    order = class_order(order, fl);
    split = count_false(fl);
  }
  let act_val: i32[] = [];
  let act_hi: i32[] = [];
  let act_reg: i32[] = [];
  let free: i32[] = [];
  let r: i32 = nregs - 1;
  while (r >= 0) {
    free = free.append(r);
    r = r - 1;
  }
  let free_s: i32[] = [];
  r = nregs + nsaved - 1;
  while (r >= nregs) {
    free_s = free_s.append(r);
    r = r - 1;
  }

  // The integer class's bounds first: its pool starts at 0, its callee-saved
  // registers at `sat`, and its call results arrive in `cabi`.
  let cbase: i32 = 0;
  let sat: i32 = nregs;
  let cabi: i32 = abi_reg;
  let oi: i32 = 0;
  while (oi < order.len()) {
    if (oi == split) {
      cbase = nregs + nsaved;
      sat = cbase + nf;
      cabi = 0 - 1;
      act_val = [];
      act_hi = [];
      act_reg = [];
      free = [];
      r = sat - 1;
      while (r >= cbase) {
        free = free.append(r);
        r = r - 1;
      }
      free_s = [];
      r = sat + nfs - 1;
      while (r >= sat) {
        free_s = free_s.append(r);
        r = r - 1;
      }
    }
    let v: i32 = order[oi];
    if (hi[v] < 0) {  // never referenced
      oi = oi + 1;
      continue;
    }
    // Expire active intervals that end before v begins.
    if (any_below(act_hi, lo[v])) {
      let nv: i32[] = [];
      let nh: i32[] = [];
      let nr: i32[] = [];
      let ai: i32 = 0;
      while (ai < act_val.len()) {
        if (act_hi[ai] < lo[v]) {
          if (act_reg[ai] >= sat) {
            free_s = free_s.append(act_reg[ai]);
          } else {
            free = free.append(act_reg[ai]);
          }
        } else {
          nv = nv.append(act_val[ai]);
          nh = nh.append(act_hi[ai]);
          nr = nr.append(act_reg[ai]);
        }
        ai = ai + 1;
      }
      act_val = nv;
      act_hi = nh;
      act_reg = nr;
    }

    // A value read only by its phi mate, already spilled, would be stored to
    // the mate's slot on the edge whatever its home; it takes the slot.
    let mh: i32 = mates.hint[v];
    if (mh >= 0 && sole[v] == mh && lo[mh] <= lo[v] && hi[mh] >= 0 && reg_of[mh] == 0 - 1) {
      if (sites.start.len() == 0) {
        sites = read_sites(f, at, blk_start);
      }
      if (!live_at_def(sites, mh, v, def_blk, def_pos)) {
        oi = oi + 1;
        continue;
      }
    }
    // A phi whose fall-through operand is spilled stays spilled too, to
    // share its slot (hinted_slot): loaded into a register, it would take
    // one an operand of a later phi in the block is still hinted at.
    if (mh >= 0 && mates.through[v] && reg_of[mh] == 0 - 1 && hi[mh] < lo[v]) {
      oi = oi + 1;
      continue;
    }
    // A phi whose outliving operand is spilled and dead where the phi is
    // defined stays spilled too, to share that slot (path_slot) rather than
    // load it into a register on every edge.
    let ma: i32 = mates.alt[v];
    if (ma >= 0 && reg_of[ma] == 0 - 1 && lo[ma] <= lo[v] && hi[ma] >= 0) {
      if (sites.start.len() == 0) {
        sites = read_sites(f, at, blk_start);
      }
      if (!live_at_def(sites, ma, v, def_blk, def_pos)) {
        oi = oi + 1;
        continue;
      }
    }
    let abi_ok: boolean = !spans_call(cum_abi, lo[v], hi[v]);
    // A value takes the register of its phi mate, or of an operand of
    // its definition, when it can: the register is free, or its holder
    // dies at this very definition and the emitter reads before it
    // writes, or the holder is the phi this loop-carried value feeds and
    // the two never live at once. First fit wins; the phi mate first.
    let placed: boolean = false;
    // -2 stands for `wish[v]`, which names a register rather than a value.
    let cands: i32[] = [];
    if (mates.alt[v] != mates.hint[v]) {
      cands = cands.append(mates.alt[v]);
    }
    cands = cands.append(mates.hint[v]).append(0 - 2).append(def_a[v]).append(def_b[v]);
    let ci: i32 = 0;
    while (ci < cands.len() && !placed) {
      let h: i32 = cands[ci];
      ci = ci + 1;
      if (h == 0 - 2) {
        let pr: i32 = 0 - 1;
        if (v < wish.len()) {
          pr = wish[v];
        }
        if (pr < 0 || spans_call(cum, lo[v], hi[v]) || pr == abi_reg && !abi_ok) {
          continue;
        }
        if (index_of_reg(free, pr) >= 0) {
          free = remove_reg(free, pr);
          reg_of = reg_of.with(v, pr);
          act_val = act_val.append(v);
          act_hi = act_hi.append(hi[v]);
          act_reg = act_reg.append(pr);
          placed = true;
          continue;
        }
        // Held: taken below if its holder dies at this definition.
        let held: i32 = index_of_reg(act_reg, pr);
        if (held < 0) {
          continue;
        }
        h = act_val[held];
      }
      if (h < 0 || reg_of[h] < 0) {
        continue;
      }
      let hr: i32 = reg_of[h];
      // A call's result arrives in abi_reg, so an argument's register
      // saves a move only when it is that one.
      if (call_def[v] == 1 && h != mates.hint[v] && hr != abi_reg) {
        continue;
      }
      if (hr < cbase || spans_call(cum, lo[v], hi[v]) && hr < sat || hr == cabi && !abi_ok) {
        continue;
      }
      let fi: i32 = index_of_reg(free, hr);
      let fsi: i32 = index_of_reg(free_s, hr);
      if (fi >= 0 || fsi >= 0) {
        if (fi >= 0) {
          free = remove_reg(free, hr);
        } else {
          free_s = remove_reg(free_s, hr);
        }
        reg_of = reg_of.with(v, hr);
        shared_with = shared_with.with(v, h);
        act_val = act_val.append(v);
        act_hi = act_hi.append(hi[v]);
        act_reg = act_reg.append(hr);
        placed = true;
        continue;
      }
      let ha: i32 = index_of_reg(act_reg, hr);
      if (ha < 0) {
        continue;
      }
      let share: boolean = act_hi[ha] == lo[v] && reads_mate[v];
      if (!share && (h == mates.hint[v] && mates.carried[v] || h == mates.alt[v])) {
        if (sites.start.len() == 0) {
          sites = read_sites(f, at, blk_start);
        }
        share = chain_dead_at_def(sites, act_val[ha], v, shared_with, lo, hi, def_blk, def_pos);
      }
      if (!share) {
        continue;
      }
      let top: i32 = act_hi[ha];
      if (hi[v] > top) {
        top = hi[v];
      }
      let holder: i32 = act_val[ha];
      act_val = drop_active_at(act_val, ha);
      act_hi = drop_active_at(act_hi, ha);
      act_reg = drop_active_at(act_reg, ha);
      reg_of = reg_of.with(v, hr);
      shared_with = shared_with.with(v, holder);
      act_val = act_val.append(v);
      act_hi = act_hi.append(top);
      act_reg = act_reg.append(hr);
      placed = true;
    }
    if (placed) {
      oi = oi + 1;
      continue;
    }
    let pick: i32 = pick_caller_reg(free, cabi, call_def[v] == 1 && abi_ok, abi_ok);
    let from_caller: boolean = !spans_call(cum, lo[v], hi[v]) && pick >= 0;
    if (!from_caller && free_s.len() == 0) {
      // Nothing free: take the register from the active interval whose
      // spill costs least, if that is less than this one's, and spill it
      // instead. `need_saved` keeps the two pools apart, since a value
      // live across a call may only sit in a callee-saved register.
      let need_saved: boolean = spans_call(cum, lo[v], hi[v]);
      let fa: i32 = cheapest_active(act_val, act_reg, act_hi, shared_with, weight, lo, hi, lo[v], sat, need_saved, forbidden_abi(cabi, abi_ok));
      let cmp: i32 = 0;
      if (fa >= 0) {
        let fw: i32 = chain_weight(act_val[fa], shared_with, weight, hi, lo[v]);
        cmp = cmp_spill_cost(fw, act_hi[fa] - chain_lo(act_val[fa], shared_with, lo, hi, lo[v]) + 1, weight[v], hi[v] - lo[v] + 1);
      }
      if (fa >= 0 && (cmp < 0 || cmp == 0 && act_hi[fa] > hi[v])) {
        let taken: i32 = act_reg[fa];
        let ev: i32 = act_val[fa];
        let first: boolean = true;
        while (ev >= 0) {
          if (first || still_holds(ev, hi, lo[v])) {
            reg_of = reg_of.with(ev, 0 - 1);
          }
          first = false;
          let nx: i32 = shared_with[ev];
          shared_with = shared_with.with(ev, 0 - 1);
          ev = nx;
        }
        act_val = drop_active_at(act_val, fa);
        act_hi = drop_active_at(act_hi, fa);
        act_reg = drop_active_at(act_reg, fa);
        reg_of = reg_of.with(v, taken);
        act_val = act_val.append(v);
        act_hi = act_hi.append(hi[v]);
        act_reg = act_reg.append(taken);
      } else {
        reg_of = reg_of.with(v, 0 - 1);  // spill
      }
    } else {
      let reg: i32 = 0;
      if (from_caller) {
        reg = pick;
        free = remove_reg(free, reg);
      } else {
        reg = free_s[free_s.len() - 1];
        free_s = drop_last_i(free_s);
      }
      reg_of = reg_of.with(v, reg);
      act_val = act_val.append(v);
      act_hi = act_hi.append(hi[v]);
      act_reg = act_reg.append(reg);
    }
    oi = oi + 1;
  }
  let shape: SlotShape = SlotShape { at: at, blk_start: blk_start, def_blk: def_blk, def_pos: def_pos, def_a: def_a, def_b: def_b };
  if (sites.start.len() == 0 && spilled_mates(reg_of, def_pos, mates.hint)) {
    sites = read_sites(f, at, blk_start);
  }
  return Alloc { reg_of: assign_spill_slots(f, shape, lo, hi, reg_of, slot_hints(f, sites, def_blk, def_pos, reg_of, mates), sites), def_pos: def_pos, hi: hi };
}

// A spilled value keeps its phi mate's hint for a slot, a loop-carried one
// only where the register rule would have let the two share. Where the mate
// is dead from the value's definition on, `take_over` lets the value take the
// slot over while the mate's interval still covers it.
struct SlotHints { hint: i32[], take_over: boolean[] }

function slot_hints(f: SFunc, sites: ReadSites, def_blk: i32[], def_pos: i32[], reg_of: i32[], mates: Mates): SlotHints {
  let hint: i32[] = [];
  let take_over: boolean[] = [];
  let i: i32 = 0;
  while (i < f.nvals) {
    let sh: i32 = mates.hint[i];
    if (reg_of[i] >= 0 || sh < 0 || reg_of[sh] >= 0) {
      sh = 0 - 1;
    }
    let free: boolean = sh >= 0 && def_pos[sh] >= 0 && !live_at_def(sites, sh, i, def_blk, def_pos);
    if (sh >= 0 && mates.carried[i] && !free) {
      sh = 0 - 1;
    }
    hint = hint.append(sh);
    take_over = take_over.append(free);
    i = i + 1;
  }
  return SlotHints { hint: hint, take_over: take_over };
}

// spilled_mates says some spilled value's phi mate is spilled too and has a
// definition, which is when slot_hints asks whether the two interfere.
function spilled_mates(reg_of: i32[], def_pos: i32[], hint: i32[]): boolean {
  let i: i32 = 0;
  while (i < reg_of.len()) {
    let sh: i32 = hint[i];
    if (reg_of[i] < 0 && sh >= 0 && reg_of[sh] < 0 && def_pos[sh] >= 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// return_prefs is `pref`, filled out to every value, with `abi_reg` asked
// for each value a block returns that asks for nothing else. A phi's ask
// passes to its operands that ask for nothing, last block first, so the
// values a returned merge gathers aim for the register it is returned from.
function return_prefs(f: SFunc, pref: i32[], abi_reg: i32): i32[] {
  let out: i32[] = pref;
  while (out.len() < f.nvals) {
    out = out.append(0 - 1);
  }
  for blk in f.blocks {
    let v: i32 = blk.term.value;
    if (blk.term.kind_tag == 1 && v >= 0 && v < out.len() && out[v] < 0) {
      out = out.with(v, abi_reg);
    }
  }
  let bi: i32 = f.blocks.len() - 1;
  while (bi >= 0) {
    for ins in f.blocks[bi].insts {
      if (ins.kind_tag == 8 && ins.result >= 0 && ins.result < out.len() && out[ins.result] >= 0) {
        for a in ins.args {
          if (a >= 0 && a < out.len() && out[a] < 0) {
            out = out.with(a, out[ins.result]);
          }
        }
      }
    }
    bi = bi - 1;
  }
  return out;
}

// sole_readers gives each value the result of the one instruction that reads
// it, -1 when nothing does and -2 when more than one instruction or a
// terminator does.
function sole_readers(f: SFunc): i32[] {
  let out: i32[] = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      for a in ins.args {
        if (a >= 0 && a < f.nvals && out[a] != ins.result) {
          if (out[a] == 0 - 1 && ins.result >= 0) {
            out = out.with(a, ins.result);
          } else {
            out = out.with(a, 0 - 2);
          }
        }
      }
    }
    let tv: i32 = 0 - 1;
    if (blk.term.kind_tag == 1) {
      tv = blk.term.value;
    }
    if (blk.term.kind_tag == 3) {
      tv = blk.term.cond;
    }
    if (tv >= 0 && tv < f.nvals) {
      out = out.with(tv, 0 - 2);
    }
  }
  return out;
}

// spill_weights counts, per value, its definition and every read, each at the
// loop weight of the block it happens in; a phi operand is read at the end of
// the predecessor it arrives from. A spilled value pays a load or store at each.
function spill_weights(f: SFunc, at: i32[]): i32[] {
  let bw: i32[] = block_loop_weights(f);
  let w: i32[] = __alloc_i32(f.nvals);
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals) {
        w = w.with(ins.result, w[ins.result] + bw[bi]);
      }
      let sl: i32 = 0;
      while (sl < ins.args.len()) {
        let a: i32 = ins.args[sl];
        let rb: i32 = bi;
        if (ins.kind_tag == 8) {
          rb = 0 - 1;
          if (sl < blk.preds.len()) {
            rb = position_of(at, blk.preds[sl]);
          }
        }
        if (a >= 0 && a < f.nvals && rb >= 0) {
          w = w.with(a, w[a] + bw[rb]);
        }
        sl = sl + 1;
      }
    }
    let tv: i32 = 0 - 1;
    if (blk.term.kind_tag == 1) {
      tv = blk.term.value;
    }
    if (blk.term.kind_tag == 3) {
      tv = blk.term.cond;
    }
    if (tv >= 0 && tv < f.nvals) {
      w = w.with(tv, w[tv] + bw[bi]);
    }
    bi = bi + 1;
  }
  return w;
}

// kept_for_mate says the slot `holder` last held is wanted by its phi mate,
// which is not `v` and has no slot yet.
function kept_for_mate(wanted_by: i32[], reg_of: i32[], holder: i32, v: i32): boolean {
  let w: i32 = wanted_by[holder];
  return w >= 0 && w != v && reg_of[w] == 0 - 1;
}

// A value's home after allocation is a register index, or `spill_code(slot)`
// for a frame slot; -1 is a value nothing defines, which has no home. The
// slots are numbered densely and shared, so an emitter sizes the
// frame by `spill_count` rather than by the id space, which the lift's phi per
// local per merge makes hundreds of times larger than what survives pruning.
function drop_last_i(a: i32[]): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < a.len() - 1) {
    out = out.append(a[i]);
    i = i + 1;
  }
  return out;
}

pub function spill_code(slot: i32): i32 {
  return 0 - 2 - slot;
}

pub function spill_slot(code: i32): i32 {
  return 0 - 2 - code;
}

pub function spill_count(reg_of: i32[]): i32 {
  let n: i32 = 0;
  for h in reg_of {
    if (h < 0 - 1 && spill_slot(h) + 1 > n) {
      n = spill_slot(h) + 1;
    }
  }
  return n;
}

// The two-operand integer ops whose result may take the register of an
// operand that dies at them: both emitters read the operands before writing
// the destination, or swap them when the right one lives there.
function shares_operand_home(op: string): boolean {
  return int_binary(op);
}

// int_binary names the integer operators that cannot trap.
function int_binary(op: string): boolean {
  let ops: string[] = ["add", "sub", "mul", "and", "or", "xor", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u", "shl", "shr_s", "shr_u"];
  for o in ops {
    if (o == op) {
      return true;
    }
  }
  return false;
}

// Mates pairs each phi with its operands for register sharing: `hint[r]` for
// a phi result r is the operand that arrives from before the phi (a
// parameter, which nothing defines, counts as one), `hint[a]` for an operand
// a defined at or after its phi is the phi, and `carried[a]` marks that
// second kind, whose interference with the phi is a question of paths rather
// than positions. An operand with no home pairs with nothing. When the first
// operand from before the phi outlives it, as the loop header's phi does at
// every merge of an else-if chain inside the loop, the hint is the first
// operand that dies by the phi instead, and `alt[r]` is the outliving one. The
// two overlap by position only, so the phi shares alt's home when no path has
// both live at once (chain_dead_at_def). A phi already marked carried, as the
// last merge's phis are by the loop header laid out before them, gets no alt:
// the carried hint covers it.
struct Mates { hint: i32[], carried: boolean[], alt: i32[], through: boolean[] }

function phi_mates(f: SFunc, at: i32[], def_pos: i32[], hi: i32[], no_home: boolean[]): Mates {
  let hint: i32[] = util.minus_ones(f.nvals);
  let carried: boolean[] = __alloc_bool(f.nvals);
  // Both start all -1, sharing one buffer: the first write to either copies it.
  let alt: i32[] = hint;
  let fell: boolean[] = carried;
  let pos: i32 = 0;
  let bi: i32 = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 8 && ins.result >= 0 && ins.result < hint.len()) {
        let dying: i32 = 0 - 1;
        let outliving: i32 = 0 - 1;
        // The dying operand arriving from the block laid out just before
        // this one, which falls through into it.
        let through: i32 = 0 - 1;
        let ai: i32 = 0;
        while (ai < ins.args.len()) {
          let a: i32 = ins.args[ai];
          ai = ai + 1;
          if (a < 0 || a >= hint.len() || a < no_home.len() && no_home[a]) {
            continue;
          }
          if (def_pos[a] < pos) {
            if (hint[ins.result] < 0) {
              hint = hint.with(ins.result, a);
            }
            if (dying < 0 && hi[a] < pos) {
              dying = a;
            }
            if (hi[a] < pos && ai - 1 < blk.preds.len() && pred_index(at, blk.preds[ai - 1]) == bi - 1) {
              through = a;
            }
            if (outliving < 0 && hi[a] >= pos) {
              outliving = a;
            }
          } else if (hint[a] < 0) {
            hint = hint.with(a, ins.result);
            carried = carried.with(a, true);
          }
        }
        let h: i32 = hint[ins.result];
        if (dying >= 0 && !carried[ins.result] && h >= 0 && hi[h] >= pos) {
          hint = hint.with(ins.result, dying);
        }
        // An else-if chain is one merge per arm, each falling through to
        // the next with the values the deeper arms wrote: a phi that takes
        // the fall-through operand's home moves nothing on that path, and
        // the arm's edge pays the one move when that arm runs.
        if (through >= 0 && !carried[ins.result]) {
          hint = hint.with(ins.result, through);
          fell = fell.with(ins.result, true);
        }
        if (!carried[ins.result]) {
          alt = alt.with(ins.result, outliving);
        }
      }
      pos = pos + 1;
    }
    pos = pos + 1;
    bi = bi + 1;
  }
  return Mates { hint: hint, carried: carried, alt: alt, through: fell };
}

function pred_index(at: i32[], id: i32): i32 {
  if (id < 0 || id >= at.len()) {
    return 0 - 1;
  }
  return at[id];
}

// position_count is the number of positions regalloc_linear numbers: one per
// instruction and one per block's terminator.
pub function position_count(f: SFunc): i32 {
  let n: i32 = 0;
  for blk in f.blocks {
    n = n + blk.insts.len() + 1;
  }
  return n;
}

// block_positions maps each non-negative block id to the position of the
// first block carrying it, -1 for an id no block carries.
pub function block_positions(f: SFunc): i32[] {
  let top: i32 = 0 - 1;
  for blk in f.blocks {
    if (blk.id > top) {
      top = blk.id;
    }
  }
  let out: i32[] = __alloc_i32(top + 1);
  let i: i32 = 0;
  while (i <= top) {
    out = out.with(i, 0 - 1);
    i = i + 1;
  }
  i = 0;
  while (i < f.blocks.len()) {
    let id: i32 = f.blocks[i].id;
    if (id >= 0 && out[id] < 0) {
      out = out.with(id, i);
    }
    i = i + 1;
  }
  return out;
}

// successor_id is branch `which` of `t` by block id, in branch order: a
// plain branch has one, a conditional two, and -1 stands past them. A walk
// over the two reads them without building a list.
pub function successor_id(t: STerm, which: i32): i32 {
  if (t.kind_tag == 2 && which == 0) {
    return t.target;
  }
  if (t.kind_tag == 3) {
    if (which == 0) {
      return t.t;
    }
    if (which == 1) {
      return t.f;
    }
  }
  return 0 - 1;
}

// distinct_successor_position is successor_id's branch by position, or -1
// for a second branch to the first's block, so a branch to one block on
// both arms is one successor; an edge to an id no block carries is -1 too.
function distinct_successor_position(at: i32[], t: STerm, which: i32): i32 {
  let id: i32 = successor_id(t, which);
  if (id < 0 || which == 1 && id == t.t) {
    return 0 - 1;
  }
  return position_of(at, id);
}

function position_of(at: i32[], id: i32): i32 {
  if (id < 0 || id >= at.len()) {
    return 0 - 1;
  }
  return at[id];
}

pub function reads_value(ins: SInst, v: i32): boolean {
  for a in ins.args {
    if (a == v) {
      return true;
    }
  }
  return false;
}

pub function term_reads_value(t: STerm, v: i32): boolean {
  if (t.kind_tag == 1) {
    return t.value == v;
  }
  if (t.kind_tag == 3) {
    return t.cond == v;
  }
  return false;
}

function index_of_reg(a: i32[], x: i32): i32 {
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] == x) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// assign_spill_slots gives the spilled values frame slots, sharing one between
// values whose intervals do not meet. A value nothing defines (a parameter) is
// stored on entry, so it is live from position 0. A value takes the slot of
// `hints.hint[v]`, its phi mate, before any other: when the slot is free, or
// when the mate still holds it and `hints.take_over[v]` says the two were
// found not to interfere. The edge between them then moves nothing. Failing
// that it takes the slot of its mate or of one of the values it reads (a
// phi's operands, or the operands a two-address op computes over), the mate
// first, when no value in that slot is
// live where it is defined, nor it where they are (path_slot), although their
// intervals meet: an else-if chain inside a loop merges each arm's value with
// the loop header's phi, whose interval covers the whole body when it is read
// after the loop. A value with no such slot passes over a free one whose last
// holder is the mate of a value not placed yet: a block's phis start one after
// another, but every operand arriving from before them dies at the edge, so
// the first phi would otherwise take the slot a later one wants.
function assign_spill_slots(f: SFunc, shape: SlotShape, lo: i32[], hi: i32[], reg_of: i32[], hints: SlotHints, given: ReadSites): i32[] {
  let def_pos: i32[] = shape.def_pos;
  let from: i32[] = spill_starts(lo, def_pos);
  let wanted_by: i32[] = mates_wanted(hi, reg_of, hints.hint);
  let slot_end: i32[] = [];
  let holder: i32[] = [];
  let occupants: i32[][] = [];
  let sites: ReadSites = given;
  let built: boolean = given.start.len() > 0;
  let live: SpillLive = no_spill_live();
  for v in order_by_lo(reg_of.len(), from) {
    if (hi[v] < 0 || reg_of[v] >= 0) {
      continue;
    }
    let h: i32 = hints.hint[v];
    let s: i32 = hinted_slot(slot_end, holder, reg_of, h, from[v], hints.take_over[v]);
    if (s < 0 && def_pos[v] >= 0) {
      let reads: i32[] = slot_operands(f, shape, reg_of, v);
      if (h >= 0 && reg_of[h] < 0 - 1) {
        let mate_first: i32[] = [h];
        for r in reads {
          mate_first = mate_first.append(r);
        }
        reads = mate_first;
      }
      if (reads.len() > 0 && !built) {
        sites = read_sites(f, shape.at, shape.blk_start);
        built = true;
      }
      if (reads.len() > 0 && live.words == 0) {
        live = spill_live(sites, shape.def_blk, spilled_values(reg_of, hi), reg_of.len());
      }
      s = path_slot(sites, live, shape, reads, slot_end, holder, occupants, wanted_by, reg_of, hi, from[v], v);
    }
    if (s < 0) {
      s = free_slot(slot_end, holder, wanted_by, reg_of, from[v], v);
    }
    let end: i32 = hi[v];
    if (s < slot_end.len() && slot_end[s] > end) {
      end = slot_end[s];
    }
    if (s == slot_end.len()) {
      slot_end = slot_end.append(end);
      holder = holder.append(v);
      occupants = occupants.append([v]);
    } else {
      slot_end = slot_end.with(s, end);
      holder = holder.with(s, v);
      occupants = occupants.with(s, still_in(occupants[s], hi, from[v]).append(v));
    }
    reg_of = reg_of.with(v, spill_code(s));
  }
  return reg_of;
}

// spilled_values are the values assign_spill_slots gives a slot.
function spilled_values(reg_of: i32[], hi: i32[]): i32[] {
  let out: i32[] = [];
  let v: i32 = 0;
  while (v < reg_of.len()) {
    if (hi[v] >= 0 && reg_of[v] < 0) {
      out = out.append(v);
    }
    v = v + 1;
  }
  return out;
}

// SlotShape is what slot sharing reads of a function's numbering.
struct SlotShape { at: i32[], blk_start: i32[], def_blk: i32[], def_pos: i32[], def_a: i32[], def_b: i32[] }

// slot_operands lists the spilled values v reads whose slot it could share:
// a phi's operands, or the two a two-address op computes over.
function slot_operands(f: SFunc, shape: SlotShape, reg_of: i32[], v: i32): i32[] {
  let out: i32[] = [];
  let bi: i32 = shape.def_blk[v];
  let ins: SInst = f.blocks[bi].insts[shape.def_pos[v] - shape.blk_start[bi]];
  let cands: i32[] = [shape.def_a[v], shape.def_b[v]];
  if (ins.kind_tag == 8) {
    cands = ins.args;
  }
  for c in cands {
    if (c >= 0 && reg_of[c] < 0 - 1) {
      out = out.append(c);
    }
  }
  return out;
}

// path_slot is the slot of the first of `reads` whose occupants still live at
// `from` are none of them live where v is defined, nor v where they are, and
// which, when free, no other value's phi mate is keeping; -1 when there is
// none.
function path_slot(sites: ReadSites, live: SpillLive, shape: SlotShape, reads: i32[], slot_end: i32[], holder: i32[], occupants: i32[][], wanted_by: i32[], reg_of: i32[], hi: i32[], from: i32, v: i32): i32 {
  for c in reads {
    let cs: i32 = spill_slot(reg_of[c]);
    let ok: boolean = true;
    for w in occupants[cs] {
      if (ok && hi[w] >= from && (spill_live_at(live, sites, w, v, shape.def_blk, shape.def_pos) || shape.def_pos[w] >= 0 && spill_live_at(live, sites, v, w, shape.def_blk, shape.def_pos))) {
        ok = false;
      }
    }
    if (ok && (slot_end[cs] >= from || !kept_for_mate(wanted_by, reg_of, holder[cs], v))) {
      return cs;
    }
  }
  return 0 - 1;
}

// still_in keeps the occupants whose intervals reach `from`.
function still_in(occ: i32[], hi: i32[], from: i32): i32[] {
  let out: i32[] = [];
  for w in occ {
    if (hi[w] >= from) {
      out = out.append(w);
    }
  }
  return out;
}

// ReadSites lists where each value is read, as the block position and the
// instruction position of each read: a terminator reads at the position after
// its block's last instruction, and a phi reads its operand there in the
// predecessor it arrives from. Value v's reads are entries start[v] up to
// start[v + 1]. succ_a and succ_b are each block's successor positions, -1
// for none; a branch to one block on both arms is one successor.
// phi_end is, per block, the position just past its last phi.
struct ReadSites { start: i32[], blk: i32[], pos: i32[], succ_a: i32[], succ_b: i32[], phi_end: i32[] }

function read_sites(f: SFunc, at: i32[], blk_start: i32[]): ReadSites {
  let count: i32[] = __alloc_i32(f.nvals + 1);
  let succ_a: i32[] = __alloc_i32(f.blocks.len());
  let succ_b: i32[] = __alloc_i32(f.blocks.len());
  let phi_end: i32[] = [];
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let t: STerm = f.blocks[bi].term;
    succ_a = succ_a.with(bi, distinct_successor_position(at, t, 0));
    succ_b = succ_b.with(bi, distinct_successor_position(at, t, 1));
    let end: i32 = 0;
    let k: i32 = 0;
    while (k < f.blocks[bi].insts.len()) {
      if (f.blocks[bi].insts[k].kind_tag == 8) {
        end = k + 1;
      }
      k = k + 1;
    }
    phi_end = phi_end.append(blk_start[bi] + end);
    bi = bi + 1;
  }
  let pass: i32 = 0;
  let start: i32[] = [];
  let blk: i32[] = [];
  let pos: i32[] = [];
  while (pass < 2) {
    let fill: i32[] = start;
    bi = 0;
    while (bi < f.blocks.len()) {
      let b: SBlock = f.blocks[bi];
      let k: i32 = 0;
      while (k < b.insts.len()) {
        let ins: SInst = b.insts[k];
        let sl: i32 = 0;
        while (sl < ins.args.len()) {
          let a: i32 = ins.args[sl];
          let rb: i32 = bi;
          let rp: i32 = blk_start[bi] + k;
          if (ins.kind_tag == 8) {
            rb = 0 - 1;
            if (sl < b.preds.len()) {
              rb = position_of(at, b.preds[sl]);
            }
            if (rb >= 0) {
              rp = blk_start[rb] + f.blocks[rb].insts.len();
            }
          }
          if (a >= 0 && a < f.nvals && rb >= 0) {
            if (pass == 0) {
              count = count.with(a + 1, count[a + 1] + 1);
            } else {
              blk = blk.with(fill[a], rb);
              pos = pos.with(fill[a], rp);
              fill = fill.with(a, fill[a] + 1);
            }
          }
          sl = sl + 1;
        }
        k = k + 1;
      }
      let tv: i32 = 0 - 1;
      if (b.term.kind_tag == 1) {
        tv = b.term.value;
      }
      if (b.term.kind_tag == 3) {
        tv = b.term.cond;
      }
      if (tv >= 0 && tv < f.nvals) {
        if (pass == 0) {
          count = count.with(tv + 1, count[tv + 1] + 1);
        } else {
          blk = blk.with(fill[tv], bi);
          pos = pos.with(fill[tv], blk_start[bi] + b.insts.len());
          fill = fill.with(tv, fill[tv] + 1);
        }
      }
      bi = bi + 1;
    }
    if (pass == 0) {
      let v: i32 = 1;
      while (v < count.len()) {
        count = count.with(v, count[v] + count[v - 1]);
        v = v + 1;
      }
      start = count;
      blk = __alloc_i32(count[f.nvals]);
      pos = __alloc_i32(count[f.nvals]);
    }
    pass = pass + 1;
  }
  return ReadSites { start: start, blk: blk, pos: pos, succ_a: succ_a, succ_b: succ_b, phi_end: phi_end };
}

// chain_dead_at_def says no value sharing `holder`'s register, the holder and
// those it shares with, is live where `a` is defined. One whose interval ends
// before a's begins is not.
function chain_dead_at_def(sites: ReadSites, holder: i32, a: i32, shared_with: i32[], lo: i32[], hi: i32[], def_blk: i32[], def_pos: i32[]): boolean {
  let m: i32 = holder;
  while (m >= 0) {
    if (hi[m] >= lo[a] && live_at_def(sites, m, a, def_blk, def_pos)) {
      return false;
    }
    m = shared_with[m];
  }
  return true;
}

// live_near is what live_at_def decides inside a's block: 0 for not live, 1
// for live, 2 when only the blocks reachable from a's can tell.
function live_near(sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): i32 {
  let ab: i32 = def_blk[a];
  if (r < 0 || ab < 0) {
    return 1;
  }
  let rb: i32 = def_blk[r];
  if (rb == ab && def_pos[r] > def_pos[a] && def_pos[r] >= sites.phi_end[rb]) {
    return 0;
  }
  let first: i32 = sites.start[r];
  let last: i32 = sites.start[r + 1];
  let far: boolean = false;
  let elsewhere: boolean = false;
  let i: i32 = first;
  while (i < last) {
    if (sites.blk[i] == ab && sites.pos[i] > def_pos[a]) {
      return 1;
    }
    far = far || sites.blk[i] != ab || rb != ab;
    elsewhere = elsewhere || sites.blk[i] != rb;
    i = i + 1;
  }
  if (!far) {
    return 0;
  }
  // Read only in its own block, after its definition (a phi's operand
  // is read at the predecessor's end): a path from `a` back to a read
  // enters that block at its top and defines `r` again first.
  if (!elsewhere && rb != ab) {
    return 0;
  }
  return 2;
}

// live_at_def says r is live where a is defined: some read of r is reachable
// from there without passing r's definition. The read at a's own definition
// comes before the write and does not count; one in a's block after it does,
// unless r is defined between. A block's phis are all defined at its entry,
// whatever their order. A value with no definition, a parameter, is defined
// before every block.
function live_at_def(sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): boolean {
  let near: i32 = live_near(sites, r, a, def_blk, def_pos);
  if (near != 2) {
    return near == 1;
  }
  let ab: i32 = def_blk[a];
  let rb: i32 = def_blk[r];
  let first: i32 = sites.start[r];
  let last: i32 = sites.start[r + 1];
  // A walk of the blocks reachable from a's without passing r's. `walk`
  // is the stack of blocks reached and not yet scanned, then a mark per
  // block from `n` on; a block is marked and stacked once, when first
  // reached. a's own block is not marked, so a path back to it is walked.
  let n: i32 = sites.succ_a.len();
  let walk: i32[] = __alloc_i32(2 * n);
  let top: i32 = 0;
  let b: i32 = ab;
  let i: i32 = first;
  while (true) {
    let s: i32 = sites.succ_a[b];
    if (s >= 0 && s != rb && walk[n + s] == 0) {
      walk = walk.with(n + s, 1).with(top, s);
      top = top + 1;
    }
    s = sites.succ_b[b];
    if (s >= 0 && s != rb && walk[n + s] == 0) {
      walk = walk.with(n + s, 1).with(top, s);
      top = top + 1;
    }
    if (top == 0) {
      return false;
    }
    top = top - 1;
    b = walk[top];
    i = first;
    while (i < last) {
      if (sites.blk[i] == b) {
        return true;
      }
      i = i + 1;
    }
  }
}

// SpillLive is live_at_def's walk answered once for a set of values: each
// block's live-in set over them, bit k of words [b * words, (b + 1) * words)
// for the value `index` numbers k. A value is used in every block that reads
// it but its own, where it is defined first; nothing passes its definition.
struct SpillLive { index: i32[], words: i32, live_in: i64[] }

function no_spill_live(): SpillLive {
  return SpillLive { index: [], words: 0, live_in: [] };
}

// spill_live computes live-in sets over `values` to the fixed point.
function spill_live(sites: ReadSites, def_blk: i32[], values: i32[], nvals: i32): SpillLive {
  let n: i32 = sites.succ_a.len();
  let words: i32 = (values.len() + 63) / 64;
  let index: i32[] = util.minus_ones(nvals);
  let uses: i64[] = __alloc_i64(n * words);
  let kills: i64[] = __alloc_i64(n * words);
  let k: i32 = 0;
  for v in values {
    index = index.with(v, k);
    let rb: i32 = def_blk[v];
    if (rb >= 0) {
      kills = spill_bit(kills, rb * words, k);
    }
    let i: i32 = sites.start[v];
    while (i < sites.start[v + 1]) {
      if (sites.blk[i] != rb) {
        uses = spill_bit(uses, sites.blk[i] * words, k);
      }
      i = i + 1;
    }
    k = k + 1;
  }
  let live_in: i64[] = uses;
  let all: i64 = 0i64 - 1i64;
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let b: i32 = n - 1;
    while (b >= 0) {
      let w: i32 = 0;
      while (w < words) {
        let out: i64 = 0i64;
        if (sites.succ_a[b] >= 0) {
          out = out | live_in[sites.succ_a[b] * words + w];
        }
        if (sites.succ_b[b] >= 0) {
          out = out | live_in[sites.succ_b[b] * words + w];
        }
        let next: i64 = uses[b * words + w] | out & (kills[b * words + w] ^ all);
        if (next != live_in[b * words + w]) {
          live_in = live_in.with(b * words + w, next);
          changed = true;
        }
        w = w + 1;
      }
      b = b - 1;
    }
  }
  return SpillLive { index: index, words: words, live_in: live_in };
}

function spill_bit(own rows: i64[], base: i32, k: i32): i64[] {
  let w: i32 = base + k / 64;
  return rows.with(w, rows[w] | 1i64 << (k % 64) as i64);
}

// spill_live_at is live_at_def for a value `live` covers, read off its sets.
function spill_live_at(live: SpillLive, sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): boolean {
  let near: i32 = live_near(sites, r, a, def_blk, def_pos);
  if (near != 2) {
    return near == 1;
  }
  let k: i32 = 0 - 1;
  if (r < live.index.len()) {
    k = live.index[r];
  }
  if (k < 0) {
    return live_at_def(sites, r, a, def_blk, def_pos);
  }
  let ab: i32 = def_blk[a];
  for s in [sites.succ_a[ab], sites.succ_b[ab]] {
    if (s >= 0 && (live.live_in[s * live.words + k / 64] >> (k % 64) as i64 & 1i64) != 0i64) {
      return true;
    }
  }
  return false;
}

function spill_starts(lo: i32[], def_pos: i32[]): i32[] {
  let from: i32[] = __alloc_i32(lo.len());
  let i: i32 = 0;
  while (i < lo.len()) {
    if (def_pos[i] >= 0) {
      from = from.with(i, lo[i]);
    }
    i = i + 1;
  }
  return from;
}

// wanted_by[m] is the spilled value whose phi mate is m, or -1.
function mates_wanted(hi: i32[], reg_of: i32[], hint: i32[]): i32[] {
  let wanted_by: i32[] = util.minus_ones(reg_of.len());
  let i: i32 = 0;
  while (i < reg_of.len()) {
    let m: i32 = hint[i];
    if (m >= 0 && hi[i] >= 0 && reg_of[i] == 0 - 1 && reg_of[m] == 0 - 1) {
      wanted_by = wanted_by.with(m, i);
    }
    i = i + 1;
  }
  return wanted_by;
}

// The slot of the mate h, when it is free at `from` or the value may take it
// over from h; -1 otherwise.
function hinted_slot(slot_end: i32[], holder: i32[], reg_of: i32[], h: i32, from: i32, take_over: boolean): i32 {
  if (h < 0 || reg_of[h] >= 0 - 1) {
    return 0 - 1;
  }
  let hs: i32 = spill_slot(reg_of[h]);
  if (slot_end[hs] < from || take_over && holder[hs] == h) {
    return hs;
  }
  return 0 - 1;
}

function free_slot(slot_end: i32[], holder: i32[], wanted_by: i32[], reg_of: i32[], from: i32, v: i32): i32 {
  let s: i32 = 0;
  while (s < slot_end.len() && (slot_end[s] >= from || kept_for_mate(wanted_by, reg_of, holder[s], v))) {
    s = s + 1;
  }
  return s;
}

// Imms marks the integer constants an emitter reads as immediate operands and
// never materialises: `is_imm[v]` says value v needs no home. A constant
// qualifies when it lies in lo..hi and every use is a binary op reading it as
// the right operand of an op named in `right`, or as the left operand of one
// named in `left` (the commutative ops and the comparisons, which the emitter
// turns round), the offset of a byte load or store (54, 55), which the
// emitter reads as a displacement, the index of an array element or string
// byte (42..44) up to 4087, which both emitters fold into the address and the
// bounds compare, a phi operand, which the edge's moves load into the phi's
// home, or a returned value, loaded into the result register; a use anywhere
// else keeps it in a register. When both
// operands are constants (the optimiser's folds do not run here, so
// `0i64 - 5i64` reaches the emitter) only the right one is an immediate, so
// the op still has a register to compute in. `konst[v]` says v is an integer
// constant at all and `value[v]` is its value, whether or not it is an
// immediate, for an arm that specialises on a constant it still reads from a
// register (the x86-64 literal-divisor forms).
// is_imm says a value is read as an immediate and never materialised; konst
// and value hold the integer constants (kinds 1 and 3). A symbolic immediate,
// an address a backend compares as a sign-extended imm32, has sym_at[v] > 0
// and its label at syms[sym_at[v] - 1]; imm_sym reads it.
pub struct Imms { is_imm: boolean[], konst: boolean[], value: i64[], sym_at: i32[], syms: string[] }

pub function imm_sym(imm: Imms, v: i32): string {
  let k: i32 = imm.sym_at[v];
  return if (k > 0) { imm.syms[k - 1] } else { "" };
}

// with_sym marks v an immediate spelt as the label `sym`.
pub function with_sym(own imm: Imms, v: i32, sym: string): Imms {
  let syms: string[] = imm.syms.append(sym);
  return Imms { ...imm, is_imm: imm.is_imm.with(v, true), sym_at: imm.sym_at.with(v, syms.len()), syms: syms };
}

pub function imm_operands(f: SFunc, lo: i64, hi: i64, right: string[], left: string[]): Imms {
  let is_imm: boolean[] = __alloc_bool(f.nvals);
  let konst: boolean[] = __alloc_bool(f.nvals);
  let value: i64[] = __alloc_i64(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag != 1 && ins.kind_tag != 3) {
        continue;
      }
      konst = konst.with(ins.result, true);
      let c: i64 = ins.imm as i64;
      if (ins.kind_tag == 3) {
        c = util.lit_to_i64(ins.str);
      }
      value = value.with(ins.result, c);
      if (c < lo || c > hi) {
        continue;
      }
      is_imm = is_imm.with(ins.result, true);
    }
  }
  for blk in f.blocks {
    for ins in blk.insts {
      let a: i32 = 0;
      while (a < ins.args.len()) {
        let v: i32 = ins.args[a];
        if (v >= 0 && v < is_imm.len() && is_imm[v] && ins.kind_tag != 8 && !imm_use(ins, a, konst, value[v], right, left)) {
          is_imm = is_imm.with(v, false);
        }
        a = a + 1;
      }
    }
    let t: STerm = blk.term;
    if (t.kind_tag == 3 && t.cond >= 0 && t.cond < is_imm.len()) {
      is_imm = is_imm.with(t.cond, false);
    }
  }
  return Imms { is_imm: is_imm, konst: konst, value: value, sym_at: __alloc_i32(f.nvals), syms: [] };
}

function imm_use(ins: SInst, a: i32, konst: boolean[], c: i64, right: string[], left: string[]): boolean {
  if ((ins.kind_tag == 54 || ins.kind_tag == 55) && a == 1) {
    return true;
  }
  if (ins.kind_tag >= 42 && ins.kind_tag <= 44 && a == 1) {
    return c >= 0i64 && c <= 4087i64;
  }
  if (ins.kind_tag != 9 || ins.args.len() != 2) {
    return false;
  }
  let other: i32 = ins.args[1 - a];
  if (other < 0 || other >= konst.len()) {
    return false;
  }
  if (a == 0 && konst[other]) {
    return false;
  }
  let names: string[] = left;
  if (a == 1) {
    names = right;
  }
  for n in names {
    if (n == ins.str) {
      return true;
    }
  }
  return false;
}

// literal_first_bytes is, per value, the first byte of the string literal
// the value is the address of (kind 47), or -1: for every other value, and
// for the empty literal, which has no byte to read.
pub function literal_first_bytes(f: SFunc): i32[] {
  let out: i32[] = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 47 && ins.str.len() > 0) {
        out = out.with(ins.result, ins.str[0] as i32);
      }
    }
  }
  return out;
}

// use_counts is how many instruction operands and terminators read each
// value; a value read once by the branch that ends its block can be
// consumed as flags rather than materialised.
pub function use_counts(f: SFunc): i32[] {
  let uses: i32[] = __alloc_i32(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      for a in ins.args {
        if (a >= 0 && a < uses.len()) {
          uses = uses.with(a, uses[a] + 1);
        }
      }
    }
    let t: STerm = blk.term;
    if (t.kind_tag == 1 && t.value >= 0 && t.value < uses.len()) {
      uses = uses.with(t.value, uses[t.value] + 1);
    }
    if (t.kind_tag == 3 && t.cond >= 0 && t.cond < uses.len()) {
      uses = uses.with(t.cond, uses[t.cond] + 1);
    }
  }
  return uses;
}

// A phi whose operands are all one value IS that value. The production lift
// emits a placeholder phi per live local at every merge and every loop
// header, and most locals are untouched on the paths that meet there, so most
// of those phis are trivial. Folding them before allocation takes the values
// out of the interval set altogether, which is where the frame traffic comes
// from — an allocator can only choose between spilling and not spilling, it
// cannot decline to have a value.
//
// A self-reference does not count: a loop header phi reads [init, itself]
// while the body leaves the local alone, and that is trivial too.

// phi_sole_operand is the one value a phi collapses to, or -1. `repl`
// resolves operands folded in an earlier round.
function phi_sole_operand(ins: SInst, repl: i32[]): i32 {
  let only: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let a: i32 = resolve_repl(repl, ins.args[i]);
    if (a != ins.result) {
      if (only < 0) {
        only = a;
      } else if (only != a) {
        return 0 - 1;
      }
    }
    i = i + 1;
  }
  return only;
}

function resolve_repl(repl: i32[], v: i32): i32 {
  let seen: i32 = 0;
  while (v >= 0 && v < repl.len() && repl[v] != v && seen < 1000) {
    v = repl[v];
    seen = seen + 1;
  }
  return v;
}

// trivial_phi_repl builds the value-to-value map, to a fixpoint: folding one
// phi can make the next trivial.
function trivial_phi_repl(f: SFunc): i32[] {
  let repl: i32[] = __alloc_i32(f.nvals);
  let i: i32 = 0;
  while (i < f.nvals) {
    repl = repl.with(i, i);
    i = i + 1;
  }
  let rounds: i32 = 0;
  let changed: boolean = true;
  while (changed && rounds < 100) {
    changed = false;
    rounds = rounds + 1;
    for blk in f.blocks {
      for ins in blk.insts {
        if (ins.kind_tag != 8) {
          continue;
        }
        if (repl[ins.result] != ins.result) {
          continue;
        }
        let only: i32 = phi_sole_operand(ins, repl);
        if (only >= 0 && only != ins.result) {
          repl = repl.with(ins.result, only);
          changed = true;
        }
      }
    }
  }
  return repl;
}

// ---- inlining ------------------------------------------------------------
// A leaf is a function a caller may take in place of a call to it: one block,
// or a chain of blocks each branching to the next, that returns a value and
// calls nothing, of at most leaf_limit() instructions
// that compute (constants, copies, binaries, unaries) and its parameters. Its
// body is already reference-counted as the callee's own, so splicing it in
// place of the call keeps every retain and release the call would have made.
// `name` is the callee name a call to it carries.
pub struct Leaf { name: string, func: SFunc }

function leaf_limit(): i32 {
  return 12;
}

function leaf_kind(k: i32): boolean {
  return k == 1 || k == 2 || k == 3 || k == 6 || k == 7 || k == 9 || k == 10;
}

// leaf_of is the leaf `f` is, as one block, or none.
pub function leaf_of(name: string, f: SFunc): Leaf[] {
  if (f.takes_env || f.blocks.len() == 0) {
    return [];
  }
  let at: i32[] = block_positions(f);
  let insts: SInst[] = [];
  let bi: i32 = position_of(at, f.entry);
  let seen: i32 = 0;
  while (bi >= 0 && seen < f.blocks.len()) {
    let b: SBlock = f.blocks[bi];
    for ins in b.insts {
      insts = insts.append(ins);
    }
    seen = seen + 1;
    if (b.term.kind_tag == 1) {
      if (seen != f.blocks.len()) {
        return [];
      }
      return returning_leaf(name, f, insts, b.term);
    }
    if (b.term.kind_tag != 2) {
      return [];
    }
    bi = position_of(at, b.term.target);
  }
  return [];
}

// returning_leaf is the leaf of `f`'s instructions, flattened into one block
// that ends in `term`, or none when they return no value, include an op a leaf
// may not, or are too many.
function returning_leaf(name: string, f: SFunc, insts: SInst[], term: STerm): Leaf[] {
  if (term.value < 0) {
    return [];
  }
  let n: i32 = 0;
  for ins in insts {
    if (!leaf_kind(ins.kind_tag)) {
      return [];
    }
    if (ins.kind_tag != 6) {
      n = n + 1;
    }
  }
  if (n > leaf_limit()) {
    return [];
  }
  let one: SBlock = SBlock { id: f.entry, insts: insts, term: term, preds: [] };
  return [Leaf { name: name, func: SFunc { ...f, blocks: [one] } }];
}

// inline_leaves replaces each direct call to a leaf with the leaf's
// instructions: its parameters read the call's
// arguments, its other values are renumbered past the caller's, and the call's
// result becomes a copy of the value the leaf returns.
pub function inline_leaves(f: SFunc, leaves: Leaf[]): SFunc {
  if (leaves.len() == 0) {
    return f;
  }
  let nvals: i32 = f.nvals;
  // `blocks` is written from the first block that splices a leaf on, and a
  // block's `insts` from its first spliced call on.
  let blocks: SBlock[] = [];
  let copying: boolean = false;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let b: SBlock = f.blocks[bi];
    let insts: SInst[] = [];
    let spliced: boolean = false;
    let k: i32 = 0;
    while (k < b.insts.len()) {
      let ins: SInst = b.insts[k];
      let at: i32 = 0 - 1;
      if (ins.kind_tag == 11) {
        at = leaf_index(leaves, ins.str, ins.args.len());
      }
      if (at < 0) {
        if (spliced) {
          insts = insts.append(ins);
        }
        k = k + 1;
        continue;
      }
      if (!spliced) {
        insts = insts_before(b.insts, k);
        spliced = true;
      }
      let leaf: SFunc = leaves[at].func;
      let map: i32[] = util.minus_ones(leaf.nvals);
      for li in leaf.blocks[0].insts {
        if (li.kind_tag == 6) {
          map = map.with(li.result, ins.args[li.imm]);
        } else {
          map = map.with(li.result, nvals);
          let args: i32[] = [];
          for a in li.args {
            args = args.append(map[a]);
          }
          insts = insts.append(SInst { ...li, result: nvals, args: args });
          nvals = nvals + 1;
        }
      }
      if (ins.result >= 0) {
        insts = insts.append(SInst { kind_tag: 7, result: ins.result, args: [map[leaf.blocks[0].term.value]], imm: 0, str: "" });
      }
      k = k + 1;
    }
    if (spliced) {
      if (!copying) {
        blocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      blocks = blocks.append(SBlock { ...b, insts: insts });
    } else if (copying) {
      blocks = blocks.append(b);
    }
    bi = bi + 1;
  }
  if (!copying) {
    return f;
  }
  return SFunc { ...f, nvals: nvals, blocks: blocks };
}

// calls_leaf reports a direct call in `f` to one of `leaves`: whether
// inline_leaves has anything to splice.
pub function calls_leaf(f: SFunc, leaves: Leaf[]): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 11 && leaf_index(leaves, ins.str, ins.args.len()) >= 0) {
        return true;
      }
    }
  }
  return false;
}

function leaf_index(leaves: Leaf[], name: string, argc: i32): i32 {
  let i: i32 = 0;
  while (i < leaves.len()) {
    if (leaves[i].func.nparams == argc && leaves[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// prune_trivial_phis drops the folded phis and rewrites every reader.
pub function prune_trivial_phis(f: SFunc): Formed {
  let repl: i32[] = trivial_phi_repl(f);
  let any: boolean = false;
  let i: i32 = 0;
  while (i < f.nvals) {
    if (repl[i] != i) {
      any = true;
    }
    i = i + 1;
  }
  if (!any) {
    return Formed { f: f, repl: [] };
  }
  let flat: i32[] = [];
  i = 0;
  while (i < f.nvals) {
    flat = flat.append(resolve_repl(repl, i));
    i = i + 1;
  }
  return Formed { f: rewrite_through(f, flat), repl: flat };
}

// rewrite_through drops every instruction whose result `flat` maps to another
// value and points every reader at the value it maps to.
function rewrite_through(f: SFunc, flat: i32[]): SFunc {
  // `nblocks` is written from the first block that changes on, and a block's
  // `ninsts` from its first dropped or rewritten instruction on.
  let nblocks: SBlock[] = [];
  let copying: boolean = false;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    let ninsts: SInst[] = [];
    let changed: boolean = false;
    let k: i32 = 0;
    while (k < blk.insts.len()) {
      let ins: SInst = blk.insts[k];
      let gone: boolean = ins.result >= 0 && flat[ins.result] != ins.result;
      let moved: boolean = !gone && args_move(ins, flat);
      if (!changed && (gone || moved)) {
        ninsts = insts_before(blk.insts, k);
        changed = true;
      }
      if (changed && !gone) {
        if (moved) {
          ninsts = ninsts.append(rewrite_args(ins, flat));
        } else {
          ninsts = ninsts.append(ins);
        }
      }
      k = k + 1;
    }
    let term: STerm = blk.term;
    if (term_moves(term, flat)) {
      term = rewrite_term(term, flat);
      if (!changed) {
        ninsts = blk.insts;
        changed = true;
      }
    }
    if (changed) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { ...blk, insts: ninsts, term: term });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
    bi = bi + 1;
  }
  if (!copying) {
    return f;
  }
  return SFunc { ...f, blocks: nblocks };
}

// merge_duplicates maps an instruction that repeats an earlier one in its
// block, the same pure operation on the same operands, onto the earlier one,
// so a rotate whose operand is written out twice reaches fuse_rotates as one
// value (#10615). Constants compare by value. Loads, calls and integer
// divisions are left alone.
function merge_duplicates(f: SFunc): Formed {
  // `canon` is what each value compares as: the value it merged into, or for
  // a constant the first constant of the same value, in any block.
  let canon: i32[] = identity_repl(f.nvals);
  let n: i32 = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag >= 1 && ins.kind_tag <= 3 || ins.kind_tag == 9 || ins.kind_tag == 10) {
        n = n + 1;
      }
    }
  }
  let nb: i32 = n * 2 + 1;
  let head: i32[] = util.minus_ones(nb);
  let seen: SInst[] = [];
  let seen_block: i32[] = [];
  let next: i32[] = [];
  let merged: i32[] = [];
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    for ins in f.blocks[bi].insts {
      let scope: i32 = 0 - 2;
      if (is_constant(ins, f.nvals)) {
        scope = 0 - 1;
      } else if (mergeable(ins)) {
        scope = bi;
      }
      if (scope >= 0 - 1) {
        let bk: i32 = (inst_hash(ins, canon) * 31 + (scope & 65535) & 1073741823) % nb;
        let found: i32 = 0 - 1;
        let j: i32 = head[bk];
        while (j >= 0 && found < 0) {
          if (seen_block[j] == scope && same_operation(seen[j], ins, canon)) {
            found = seen[j].result;
          }
          j = next[j];
        }
        if (found >= 0) {
          canon = canon.with(ins.result, found);
          if (scope >= 0) {
            merged = merged.append(ins.result).append(found);
          }
        } else {
          next = next.append(head[bk]);
          head = head.with(bk, seen.len());
          seen = seen.append(ins);
          seen_block = seen_block.append(scope);
        }
      }
    }
    bi = bi + 1;
  }
  if (merged.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  let repl: i32[] = identity_repl(f.nvals);
  let k: i32 = 0;
  while (k < merged.len()) {
    repl = repl.with(merged[k], merged[k + 1]);
    k = k + 2;
  }
  return Formed { f: rewrite_through(f, repl), repl: repl };
}

function identity_repl(n: i32): i32[] {
  let out: i32[] = __alloc_i32(n);
  let i: i32 = 0;
  while (i < n) {
    out = out.with(i, i);
    i = i + 1;
  }
  return out;
}

function is_constant(ins: SInst, nvals: i32): boolean {
  return ins.kind_tag >= 1 && ins.kind_tag <= 3 && ins.result >= 0 && ins.result < nvals;
}

function mergeable(ins: SInst): boolean {
  if (ins.result < 0) {
    return false;
  }
  if (ins.kind_tag == 9) {
    return !binary_fixes_abi(ins.str);
  }
  if (ins.kind_tag == 10) {
    return ins.str == "!" || ins.str == "u32_wrap" || ins.str == "int_wrap" || ins.str == "int_extend"
      || util.str_has_prefix(ins.str, "int_cast:") || util.str_has_prefix(ins.str, "rotr:");
  }
  return false;
}

function operand_id(a: i32, canon: i32[]): i32 {
  if (a < 0 || a >= canon.len()) {
    return a;
  }
  return canon[a];
}

// inst_hash is a non-negative hash of an instruction's operation and operands.
function inst_hash(ins: SInst, canon: i32[]): i32 {
  let h: i32 = (ins.kind_tag * 31 + (ins.imm & 65535)) * 31 + (__str_hash(ins.str, 0) & 65535) & 1048575;
  for a in ins.args {
    h = h * 31 + (operand_id(a, canon) & 1048575) & 1048575;
  }
  return h;
}

function same_operation(a: SInst, b: SInst, canon: i32[]): boolean {
  if (a.kind_tag != b.kind_tag || a.imm != b.imm || a.args.len() != b.args.len() || a.str != b.str) {
    return false;
  }
  let k: i32 = 0;
  while (k < a.args.len()) {
    if (operand_id(a.args[k], canon) != operand_id(b.args[k], canon)) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

// args_move reports whether `resolved` maps any operand of `ins` elsewhere.
function args_move(ins: SInst, resolved: i32[]): boolean {
  for a in ins.args {
    if (a >= 0 && resolved[a] != a) {
      return true;
    }
  }
  return false;
}

function term_moves(t: STerm, resolved: i32[]): boolean {
  if (t.kind_tag == 1) {
    return resolved[t.value] != t.value;
  }
  if (t.kind_tag == 3) {
    return resolved[t.cond] != t.cond;
  }
  return false;
}

// repeated_block_id names the first block id that appears twice in `f.blocks`,
// or -1 when every id is distinct. The emitters write one `.Lssa_<fn>_<id>:`
// per entry, so a repeat spells one label twice and the assembler rejects the
// whole module without naming the pass that produced it (#9688).
pub function repeated_block_id(f: SFunc): i32 {
  let top: i32 = 0;
  for blk in f.blocks {
    if (blk.id > top) {
      top = blk.id;
    }
  }
  let seen: i32[] = __alloc_i32(top + 1);
  for blk in f.blocks {
    if (seen[blk.id] == 1) {
      return blk.id;
    }
    seen = seen.with(blk.id, 1);
  }
  return 0 - 1;
}

// prune_dead drops every pure instruction (const / copy / binary / unary /
// phi) whose result reaches no instruction with an effect and no terminator,
// through any number of pure instructions. Marking from those roots, rather
// than asking whether each result has a reader, is what removes a cycle of
// phis that only read each other. Params and calls are always kept.
// thread_forwarding sends every edge past the empty blocks on its way: a
// block with no instructions whose terminator is a plain branch to a block
// with no phis adds nothing, so its predecessors branch to its target and,
// once nothing reaches it, it is dropped. prune_dead and prune_trivial_phis
// leave such blocks behind wherever a branch's arms or a loop's exits
// carried only values nothing read. A block with phis keeps every edge into
// it, since the phis' operands are per predecessor. `changed` says an edge
// moved or a block was dropped.
pub function thread_forwarding(f: SFunc): Threading {
  let at: i32[] = block_positions(f);
  // `nblocks` is written from the first block whose branch moves on.
  let nblocks: SBlock[] = [];
  let copying: boolean = false;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    let t: STerm = blk.term;
    let moved: boolean = false;
    if (t.kind_tag == 2) {
      let target: i32 = forwarded(f, at, t.target);
      if (target != t.target) {
        t = STerm { ...t, target: target };
        moved = true;
      }
    }
    if (t.kind_tag == 3) {
      let tt: i32 = forwarded(f, at, t.t);
      let tf: i32 = forwarded(f, at, t.f);
      if (tt != t.t || tf != t.f) {
        t = STerm { ...t, t: tt, f: tf };
        moved = true;
      }
    }
    if (moved) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { ...blk, term: t });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
    bi = bi + 1;
  }
  let g: SFunc = f;
  if (copying) {
    g = SFunc { ...f, blocks: nblocks };
  }
  let live: boolean[] = __alloc_bool(g.blocks.len());
  let work: i32[] = [position_of(at, g.entry)];
  let next: i32 = 0;
  while (next < work.len()) {
    let b: i32 = work[next];
    next = next + 1;
    if (b < 0 || live[b]) {
      continue;
    }
    live = live.with(b, true);
    let which: i32 = 0;
    while (which < 2) {
      let id: i32 = successor_id(g.blocks[b].term, which);
      if (id >= 0 && (which == 0 || id != g.blocks[b].term.t)) {
        work = work.append(position_of(at, id));
      }
      which = which + 1;
    }
  }
  // `kept` is written from the first unreachable block on.
  let kept: SBlock[] = [];
  let dropping: boolean = false;
  let i: i32 = 0;
  while (i < g.blocks.len()) {
    if (!live[i]) {
      if (!dropping) {
        kept = blocks_before(g.blocks, i);
        dropping = true;
      }
    } else if (dropping) {
      kept = kept.append(g.blocks[i]);
    }
    i = i + 1;
  }
  let out: SFunc = g;
  if (dropping) {
    out = SFunc { ...g, blocks: kept };
  }
  return Threading { f: SFunc { ...out, blocks: refreshed_preds(out) }, changed: copying || dropping };
}

// forwarded follows a chain of empty forwarding blocks from `id` to the
// first block that is not one; a cycle of them ends the walk where it is.
function forwarded(f: SFunc, at: i32[], id: i32): i32 {
  let cur: i32 = id;
  let steps: i32 = 0;
  while (steps <= f.blocks.len()) {
    if (cur < 0 || cur >= at.len() || at[cur] < 0) {
      return cur;
    }
    let b: SBlock = f.blocks[at[cur]];
    if (b.insts.len() != 0 || b.term.kind_tag != 2 || b.term.target == cur) {
      return cur;
    }
    let nt: i32 = b.term.target;
    if (nt < 0 || nt >= at.len() || at[nt] < 0 || has_phi(f.blocks[at[nt]])) {
      return cur;
    }
    cur = nt;
    steps = steps + 1;
  }
  return cur;
}

function has_phi(b: SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag == 8) {
      return true;
    }
  }
  return false;
}

// refreshed_preds recomputes the predecessor list of every block without
// phis from the edges as they now are. A block with phis keeps its list,
// whose order the phis' operands follow, less the entries no edge backs any
// more: a dropped block, or a folded branch that no longer comes this way.
pub function refreshed_preds(f: SFunc): SBlock[] {
  let at: i32[] = block_positions(f);
  let preds: i32[][] = [];
  let i: i32 = 0;
  while (i < f.blocks.len()) {
    preds = preds.append([]);
    i = i + 1;
  }
  i = 0;
  while (i < f.blocks.len()) {
    let which: i32 = 0;
    while (which < 2) {
      let s: i32 = distinct_successor_position(at, f.blocks[i].term, which);
      if (s >= 0 && !has_pred(preds[s], f.blocks[i].id)) {
        preds = preds.with(s, preds[s].append(f.blocks[i].id));
      }
      which = which + 1;
    }
    i = i + 1;
  }
  // `out` is written from the first block whose list changes on.
  let out: SBlock[] = [];
  let copying: boolean = false;
  i = 0;
  while (i < f.blocks.len()) {
    let b: SBlock = f.blocks[i];
    let nb: SBlock = b;
    let fresh: boolean = false;
    if (has_phi(b)) {
      if (!every_pred(b.preds, preds[i])) {
        nb = trim_phi_edges(b, preds[i]);
        fresh = true;
      }
    } else if (!same_preds(b.preds, preds[i])) {
      nb = SBlock { ...b, preds: preds[i] };
      fresh = true;
    }
    if (fresh) {
      if (!copying) {
        out = blocks_before(f.blocks, i);
        copying = true;
      }
      out = out.append(nb);
    } else if (copying) {
      out = out.append(b);
    }
    i = i + 1;
  }
  if (!copying) {
    return f.blocks;
  }
  return out;
}

// every_pred reports whether `edges` backs every entry of `ps`.
function every_pred(ps: i32[], edges: i32[]): boolean {
  for p in ps {
    if (!has_pred(edges, p)) {
      return false;
    }
  }
  return true;
}

function same_preds(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// trim_phi_edges drops the predecessor slots of b, and each phi's operand
// for them, whose predecessor is not among `edges`, the blocks that branch
// to b now.
function trim_phi_edges(b: SBlock, edges: i32[]): SBlock {
  let keep: boolean[] = [];
  let npreds: i32[] = [];
  for p in b.preds {
    let k: boolean = has_pred(edges, p);
    keep = keep.append(k);
    if (k) {
      npreds = npreds.append(p);
    }
  }
  if (npreds.len() == b.preds.len()) {
    return b;
  }
  let ninsts: SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag != 8) {
      ninsts = ninsts.append(ins);
      continue;
    }
    let nargs: i32[] = [];
    let i: i32 = 0;
    while (i < ins.args.len()) {
      if (i >= keep.len() || keep[i]) {
        nargs = nargs.append(ins.args[i]);
      }
      i = i + 1;
    }
    ninsts = ninsts.append(SInst { ...ins, args: nargs });
  }
  return SBlock { id: b.id, insts: ninsts, term: b.term, preds: npreds };
}

function has_pred(ps: i32[], id: i32): boolean {
  for p in ps {
    if (p == id) {
      return true;
    }
  }
  return false;
}

// ---- branches on boolean joins ---------------------------------------------
//
// A boolean made as a VALUE by `&&` or `||` — a predicate spliced into its
// caller, or a flag held in a local — reaches its use as a phi of each arm's
// 0/1, and a branch on that phi tests again what the arms just decided.
// thread_bool_joins sends each arm straight to the branch's targets: an arm
// bringing a constant jumps to the side the constant picks, and one bringing a
// comparison branches on it, which the emitters fuse into compare and jump.
//
// The join must hold that phi alone, read by nothing but the branch (its own,
// or that of an empty block it falls into), be entered only forward, and
// branch forward to blocks without phis. An arm is moved only when it ends in
// a plain branch to the join. Every block that dominates the join dominates
// each block entering it, so no other block changes dominator.

// BoolJoin is a join the pass can take apart: `j` its position, `k` the
// position of the empty block holding the branch or -1, `t` / `f` the targets.
struct BoolJoin { ok: boolean, j: i32, k: i32, t: i32, f: i32 }

pub struct Threading { f: SFunc, changed: boolean }

struct ThreadRound { blocks: SBlock[], busy: boolean[], gone: boolean[], changed: boolean }

pub function thread_bool_joins(f: SFunc): Threading {
  let g: SFunc = f;
  let changed: boolean = false;
  let rounds: i32 = 0;
  while (rounds < 8) {
    let r: Threading = thread_round(g);
    if (!r.changed) {
      return Threading { f: g, changed: changed };
    }
    g = r.f;
    changed = true;
    rounds = rounds + 1;
  }
  return Threading { f: g, changed: changed };
}

// thread_round threads every join whose blocks no earlier join in the round
// rewrote; the next round sees the graph that leaves.
function thread_round(f: SFunc): Threading {
  let at: i32[] = block_positions(f);
  let uses: i32[] = use_counts(f);
  let konst: i32[] = truth_constants(f);
  let flags: boolean[] = __alloc_bool(f.blocks.len());
  let r: ThreadRound = ThreadRound { blocks: f.blocks, busy: flags, gone: flags, changed: false };
  let j: i32 = 0;
  while (j < f.blocks.len()) {
    let jn: BoolJoin = bool_join_at(f, at, uses, j);
    if (jn.ok && !join_busy(f, at, r.busy, jn)) {
      r = thread_join(f, at, konst, jn, r);
    }
    j = j + 1;
  }
  if (!r.changed) {
    return Threading { f: f, changed: false };
  }
  let kept: SBlock[] = [];
  let i: i32 = 0;
  while (i < r.blocks.len()) {
    if (!r.gone[i]) {
      kept = kept.append(r.blocks[i]);
    }
    i = i + 1;
  }
  let g: SFunc = SFunc { ...f, blocks: kept };
  return Threading { f: SFunc { ...g, blocks: refreshed_preds(g) }, changed: true };
}

// truth_constants maps each value an integer or boolean constant defines to
// 1 or 0 as a branch reads it, and every other value to -1.
function truth_constants(f: SFunc): i32[] {
  let out: i32[] = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if ((ins.kind_tag == 1 || ins.kind_tag == 2) && ins.result >= 0 && ins.result < out.len()) {
        let truth: i32 = 0;
        if (ins.imm != 0) {
          truth = 1;
        }
        out = out.with(ins.result, truth);
      }
    }
  }
  return out;
}

// bool_join_at is the join at position j, or one that is not ok.
function bool_join_at(f: SFunc, at: i32[], uses: i32[], j: i32): BoolJoin {
  let blk: SBlock = f.blocks[j];
  let none: BoolJoin = BoolJoin { ok: false, j: j, k: 0 - 1, t: 0, f: 0 };
  if (blk.insts.len() != 1 || blk.insts[0].kind_tag != 8 || uses[blk.insts[0].result] != 1 || !entered_forward(f, at, j)) {
    return none;
  }
  let k: i32 = 0 - 1;
  let last: i32 = j;
  let br: STerm = blk.term;
  if (br.kind_tag == 2) {
    k = position_of(at, br.target);
    if (k <= j || !branch_only(f.blocks[k], blk.id)) {
      return none;
    }
    last = k;
    br = f.blocks[k].term;
  }
  if (br.kind_tag != 3 || br.cond != blk.insts[0].result || br.t == br.f
    || !plain_target(f, at, br.t, last) || !plain_target(f, at, br.f, last)) {
    return none;
  }
  return BoolJoin { ok: true, j: j, k: k, t: br.t, f: br.f };
}

// entered_forward says every edge into position j comes from a block laid out
// before it, one edge per predecessor, and the phi has an operand for each.
function entered_forward(f: SFunc, at: i32[], j: i32): boolean {
  let blk: SBlock = f.blocks[j];
  if (blk.preds.len() == 0 || blk.insts[0].args.len() != blk.preds.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < blk.preds.len()) {
    let p: i32 = position_of(at, blk.preds[i]);
    if (p < 0 || p >= j || pred_slot(blk, blk.preds[i]) != i) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// branch_only says b holds nothing but a conditional branch and is entered
// from `from` alone.
function branch_only(b: SBlock, from: i32): boolean {
  return b.insts.len() == 0 && b.term.kind_tag == 3 && b.preds.len() == 1 && b.preds[0] == from;
}

// plain_target says the block `id` is laid out past position `last` and has
// no phis, so a new edge into it needs no operand.
function plain_target(f: SFunc, at: i32[], id: i32, last: i32): boolean {
  let p: i32 = position_of(at, id);
  return p > last && !has_phi(f.blocks[p]);
}

// join_busy says an earlier join this round rewrote a block this one would.
function join_busy(f: SFunc, at: i32[], busy: boolean[], jn: BoolJoin): boolean {
  if (busy[jn.j] || jn.k >= 0 && busy[jn.k]) {
    return true;
  }
  for p in f.blocks[jn.j].preds {
    if (busy[at[p]]) {
      return true;
    }
  }
  return false;
}

// thread_join moves every edge into the join that ends a plain branch, and
// drops the join once no edge is left entering it.
function thread_join(f: SFunc, at: i32[], konst: i32[], jn: BoolJoin, r: ThreadRound): ThreadRound {
  let jb: SBlock = f.blocks[jn.j];
  let blocks: SBlock[] = r.blocks;
  let busy: boolean[] = r.busy.with(jn.j, true);
  let kept: i32 = 0;
  let i: i32 = 0;
  while (i < jb.preds.len()) {
    let pp: i32 = at[jb.preds[i]];
    if (blocks[pp].term.kind_tag == 2) {
      blocks = blocks.with(pp, SBlock { ...blocks[pp], term: arm_term(jb.insts[0].args[i], konst, jn) });
      busy = busy.with(pp, true);
    } else {
      kept = kept + 1;
    }
    i = i + 1;
  }
  let gone: boolean[] = r.gone;
  if (kept == 0) {
    gone = gone.with(jn.j, true);
    if (jn.k >= 0) {
      gone = gone.with(jn.k, true);
    }
  }
  return ThreadRound { blocks: blocks, busy: busy, gone: gone, changed: r.changed || kept < jb.preds.len() };
}

// arm_term is where an arm bringing `v` to the join goes instead: the target
// a constant picks, or a branch on `v` itself.
function arm_term(v: i32, konst: i32[], jn: BoolJoin): STerm {
  if (v >= 0 && v < konst.len() && konst[v] == 1) {
    return t_br(jn.t);
  }
  if (v >= 0 && v < konst.len() && konst[v] == 0) {
    return t_br(jn.f);
  }
  return t_brif(v, jn.t, jn.f);
}

// ---- conditional values ----------------------------------------------------
//
// A branch whose two arms compute a few pure integer values and then meet,
// at a join's phis or at a return each, becomes straight-line code: the arms'
// instructions move up into the branching block, and each value the arms
// chose between becomes a `select` on the branch's condition, which the
// emitters render as a conditional move. A branch the data decides at random
// mispredicts half the time; a conditional move never does.
//
// An arm is the edge itself, or a block entered from the branch alone that
// holds at most select_arm_limit() instructions, each of which may run on the
// path that did not take it: no memory access, no call, no division, no
// float. A join must be entered from the two arms alone. A float the
// emitters keep in a float register stays a phi.
//
// The pass runs on the certified form: what it moves holds no reference
// count operation, so it changes none of the events the certifier proved.

// Diamond is a branch the pass can flatten: `head` the branching block's
// position, `t` / `f` each arm's position or -1 for an arm that is the edge
// itself, and `join` the join's position, or -1 when both arms return.
struct Diamond { ok: boolean, head: i32, t: i32, f: i32, join: i32 }

pub function select_arm_limit(): i32 {
  return 3;
}

pub function select_branches(f: SFunc): SFunc {
  let g: SFunc = f;
  let rounds: i32 = 0;
  while (rounds < 8) {
    let r: Threading = select_round(g);
    if (!r.changed) {
      return g;
    }
    g = r.f;
    rounds = rounds + 1;
  }
  return g;
}

// select_round flattens every diamond whose blocks no earlier one in the
// round rewrote; the next round sees the graph that leaves, where a join
// that became straight-line code may head a diamond of its own.
function select_round(f: SFunc): Threading {
  let at: i32[] = block_positions(f);
  let fl: boolean[] = float_values(f, [], false);
  let none: boolean[] = __alloc_bool(f.blocks.len());
  let r: Flattening = Flattening { blocks: f.blocks, busy: none, gone: none, nvals: f.nvals, changed: false };
  let p: i32 = 0;
  while (p < f.blocks.len()) {
    let d: Diamond = diamond_at(f, at, fl, p);
    if (d.ok && !diamond_busy(r.busy, d)) {
      r = flatten_diamond(f, d, r);
    }
    p = p + 1;
  }
  if (!r.changed) {
    return Threading { f: f, changed: false };
  }
  let kept: SBlock[] = [];
  let i: i32 = 0;
  while (i < r.blocks.len()) {
    if (!r.gone[i]) {
      kept = kept.append(r.blocks[i]);
    }
    i = i + 1;
  }
  return Threading { f: SFunc { ...f, nvals: r.nvals, blocks: kept }, changed: true };
}

// Flattening is a round's rewritten blocks, the positions it rewrote (busy)
// and dropped (gone), and the next fresh value.
struct Flattening { blocks: SBlock[], busy: boolean[], gone: boolean[], nvals: i32, changed: boolean }

// flatten_diamond rewrites diamond d: the head takes the arms' instructions
// and a select per value they chose between, and the arms are dropped.
function flatten_diamond(f: SFunc, d: Diamond, r: Flattening): Flattening {
  let head: SBlock = f.blocks[d.head];
  let insts: SInst[] = hoisted(head, util.append_all(arm_insts(f, d.t), arm_insts(f, d.f)));
  r = drop_arm(drop_arm(Flattening { ...r, busy: r.busy.with(d.head, true), changed: true }, d.t), d.f);
  if (d.join >= 0) {
    let j: SBlock = f.blocks[d.join];
    let picks: SInst[] = join_selects(j, head.term.cond, arm_source(f, head, d.t), arm_source(f, head, d.f));
    let blocks: SBlock[] = r.blocks.with(d.head, SBlock { ...head, insts: util.append_all(insts, picks), term: t_br(j.id) });
    return Flattening { ...r, blocks: blocks.with(d.join, SBlock { ...j, insts: without_phis(j.insts), preds: [head.id] }), busy: r.busy.with(d.join, true) };
  }
  let vt: i32 = f.blocks[d.t].term.value;
  let vf: i32 = f.blocks[d.f].term.value;
  if (vt == vf) {
    return Flattening { ...r, blocks: r.blocks.with(d.head, SBlock { ...head, insts: insts, term: t_ret(vt) }) };
  }
  let pick: SInst = SInst { kind_tag: 36, result: r.nvals, args: [head.term.cond, vt, vf], imm: 0, str: "" };
  return Flattening { ...r, blocks: r.blocks.with(d.head, SBlock { ...head, insts: insts.append(pick), term: t_ret(r.nvals) }), nvals: r.nvals + 1 };
}

function drop_arm(r: Flattening, arm: i32): Flattening {
  if (arm < 0) {
    return r;
  }
  return Flattening { ...r, busy: r.busy.with(arm, true), gone: r.gone.with(arm, true) };
}

// diamond_at is the diamond the branch ending position p heads, or one that
// is not ok.
function diamond_at(f: SFunc, at: i32[], fl: boolean[], p: i32): Diamond {
  let none: Diamond = Diamond { ok: false, head: p, t: 0 - 1, f: 0 - 1, join: 0 - 1 };
  let head: SBlock = f.blocks[p];
  let br: STerm = head.term;
  if (!two_way(head)) {
    return none;
  }
  let tp: i32 = position_of(at, br.t);
  let fp: i32 = position_of(at, br.f);
  if (tp < 0 || fp < 0) {
    return none;
  }
  let at_t: i32 = arm_at(f, tp, head.id);
  let at_f: i32 = arm_at(f, fp, head.id);
  if (!arms_fit(f, at_t, at_f)) {
    return none;
  }
  if (returns_picked(f, fl, at_t) && returns_picked(f, fl, at_f)) {
    return Diamond { ok: true, head: p, t: tp, f: fp, join: 0 - 1 };
  }
  let jp: i32 = join_of(f, at, p, tp, at_t, fp, at_f);
  if (jp < 0 || !select_join(f, fl, f.blocks[jp], arm_source(f, head, at_t), arm_source(f, head, at_f))) {
    return none;
  }
  return Diamond { ok: true, head: p, t: at_t, f: at_f, join: jp };
}

// arm_at is position p when its block is an arm of the branch out of `from`
// (select_arm), and -1 when the branch goes straight to it.
function arm_at(f: SFunc, p: i32, from: i32): i32 {
  if (select_arm(f.blocks[p], from)) {
    return p;
  }
  return 0 - 1;
}

// arms_fit says two arm blocks hold no more than select_arm_limit() + 1
// instructions between them.
function arms_fit(f: SFunc, at_t: i32, at_f: i32): boolean {
  if (at_t < 0 || at_f < 0) {
    return true;
  }
  return f.blocks[at_t].insts.len() + f.blocks[at_f].insts.len() <= select_arm_limit() + 1;
}

// returns_picked says the arm at position a returns a value that is no float.
function returns_picked(f: SFunc, fl: boolean[], a: i32): boolean {
  if (a < 0) {
    return false;
  }
  let t: STerm = f.blocks[a].term;
  return t.kind_tag == 1 && t.value >= 0 && !picks_float(fl, t.value);
}

// join_of is the position both edges out of the head at p meet at, through
// the arm block on each side that has one, or -1. An edge with no arm block
// goes to the join itself; at least one side has an arm.
function join_of(f: SFunc, at: i32[], p: i32, tp: i32, at_t: i32, fp: i32, at_f: i32): i32 {
  if (at_t < 0 && at_f < 0) {
    return 0 - 1;
  }
  let jt: i32 = arm_exit(f, at, tp, at_t);
  let jf: i32 = arm_exit(f, at, fp, at_f);
  if (jt < 0 || jt != jf || jt == p) {
    return 0 - 1;
  }
  return jt;
}

// arm_exit is where the edge to position p leads: past its arm block's plain
// branch, or p itself when it has no arm block; -1 for an arm that returns.
function arm_exit(f: SFunc, at: i32[], p: i32, arm: i32): i32 {
  if (arm < 0) {
    return p;
  }
  let t: STerm = f.blocks[arm].term;
  if (t.kind_tag != 2) {
    return 0 - 1;
  }
  return position_of(at, t.target);
}

// two_way says the head ends in a branch with two distinct targets on a
// condition no call computes.
function two_way(head: SBlock): boolean {
  let br: STerm = head.term;
  return br.kind_tag == 3 && br.t != br.f && !tested_by_call(head, br.cond);
}

// tested_by_call says the head computes the branch's condition with a call
// or an inline rc primitive, or negates one. Those branch as they compute
// it, and the uniqueness test's guard chain sets the very flags the branch
// reads, so a select would only add a test of the value they leave.
function tested_by_call(head: SBlock, cond: i32): boolean {
  for ins in head.insts {
    if (ins.result == cond && ins.kind_tag == 10 && ins.str == "!") {
      return tested_by_call(head, ins.args[0]);
    }
    if (ins.result == cond) {
      return inst_is_call(ins.kind_tag);
    }
  }
  return false;
}

// select_arm says b is entered from the block `from` alone, holds no phi and
// no more than select_arm_limit() instructions, and each may run whichever
// way the branch goes.
function select_arm(b: SBlock, from: i32): boolean {
  if (b.preds.len() != 1 || b.preds[0] != from || b.insts.len() > select_arm_limit()) {
    return false;
  }
  if (b.term.kind_tag != 1 && b.term.kind_tag != 2) {
    return false;
  }
  for ins in b.insts {
    if (!speculable(ins)) {
      return false;
    }
  }
  return true;
}

// speculable names an instruction that may run on a path that did not ask
// for it: a constant, a copy, and the integer operators that cannot trap.
function speculable(ins: SInst): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 1 || k == 2 || k == 3 || k == 7) {
    return true;
  }
  if (k == 9) {
    return int_binary(ins.str);
  }
  if (k == 10) {
    return int_unary(ins.str);
  }
  return false;
}

// int_unary names the integer unaries: the width casts, the rotate and the
// bit counts, none of which reads memory or traps.
function int_unary(op: string): boolean {
  if (util.has_str(["!", "int_extend", "int_wrap", "u32_wrap"], op)) {
    return true;
  }
  for pre in ["int_cast:", "rotr:", "bswap:", "clz:", "ctz:", "popcount:"] {
    if (util.str_has_prefix(op, pre)) {
      return true;
    }
  }
  return false;
}

// select_join says the join j is entered from the two arms' sources alone and
// holds at most two phis, none of a float.
function select_join(f: SFunc, fl: boolean[], j: SBlock, from_t: i32, from_f: i32): boolean {
  if (j.preds.len() != 2 || !has_pred(j.preds, from_t) || !has_pred(j.preds, from_f)) {
    return false;
  }
  let phis: i32 = 0;
  for ins in j.insts {
    if (ins.kind_tag == 8) {
      if (ins.args.len() != 2 || picks_float(fl, ins.result)) {
        return false;
      }
      phis = phis + 1;
    }
  }
  return phis <= 2;
}

function picks_float(fl: boolean[], v: i32): boolean {
  return v >= 0 && v < fl.len() && fl[v];
}

// arm_source is the block an arm's edge into the join leaves from: the arm,
// or the head when the arm is the edge itself.
function arm_source(f: SFunc, head: SBlock, arm: i32): i32 {
  if (arm < 0) {
    return head.id;
  }
  return f.blocks[arm].id;
}

function arm_insts(f: SFunc, arm: i32): SInst[] {
  if (arm < 0) {
    return [];
  }
  return f.blocks[arm].insts;
}

function diamond_busy(busy: boolean[], d: Diamond): boolean {
  return busy[d.head] || d.t >= 0 && busy[d.t] || d.f >= 0 && busy[d.f] || d.join >= 0 && busy[d.join];
}

// hoisted is the head's instructions with the arms' added. They go in ahead
// of the instruction that ends the head when it computes the condition and
// no arm reads it, so a comparison still sits beside its select; never
// ahead of a phi, which must lead its block.
function hoisted(head: SBlock, arms: SInst[]): SInst[] {
  let n: i32 = head.insts.len();
  if (n == 0 || head.insts[n - 1].result != head.term.cond || head.insts[n - 1].kind_tag == 8 || arms_read(arms, head.term.cond)) {
    return util.append_all(head.insts, arms);
  }
  let out: SInst[] = util.append_all(slice_insts(head.insts, 0, n - 1), arms);
  return out.append(head.insts[n - 1]);
}

function arms_read(arms: SInst[], v: i32): boolean {
  for ins in arms {
    if (reads_value(ins, v)) {
      return true;
    }
  }
  return false;
}

// select_run is the first position of the run of selects around position
// ii that read ii's condition, and the position just past it.
pub function select_run(blk: SBlock, ii: i32): i32[] {
  let c: i32 = blk.insts[ii].args[0];
  let lo: i32 = ii;
  while (lo > 0 && blk.insts[lo - 1].kind_tag == 36 && blk.insts[lo - 1].args[0] == c) {
    lo = lo - 1;
  }
  let hi: i32 = ii + 1;
  while (hi < blk.insts.len() && blk.insts[hi].kind_tag == 36 && blk.insts[hi].args[0] == c) {
    hi = hi + 1;
  }
  return [lo, hi];
}

// join_selects is a select, or a copy when both arms bring the same value,
// for each of the join's phis. The selects come first and together, so the
// emitters read one compare's flags for all of them.
function join_selects(j: SBlock, cond: i32, from_t: i32, from_f: i32): SInst[] {
  let picks: SInst[] = [];
  let copies: SInst[] = [];
  for ins in j.insts {
    if (ins.kind_tag == 8) {
      let vt: i32 = ins.args[pred_slot(j, from_t)];
      let vf: i32 = ins.args[pred_slot(j, from_f)];
      if (vt == vf) {
        copies = copies.append(SInst { kind_tag: 7, result: ins.result, args: [vt], imm: 0, str: "" });
      } else {
        picks = picks.append(SInst { kind_tag: 36, result: ins.result, args: [cond, vt, vf], imm: 0, str: "" });
      }
    }
  }
  return util.append_all(picks, copies);
}

function without_phis(insts: SInst[]): SInst[] {
  let out: SInst[] = [];
  for ins in insts {
    if (ins.kind_tag != 8) {
      out = out.append(ins);
    }
  }
  return out;
}

function slice_insts(a: SInst[], lo: i32, hi: i32): SInst[] {
  let out: SInst[] = [];
  let i: i32 = lo;
  while (i < hi) {
    out = out.append(a[i]);
    i = i + 1;
  }
  return out;
}

// Formed is a function with `repl`, the value each of the input's values was
// replaced by (resolved, so one lookup is enough); empty when none was. A `-g`
// build follows a variable's value through it (#11410).
pub struct Formed { f: SFunc, repl: i32[] }

function formed_by(f: SFunc, repl: i32[]): Formed {
  let flat: i32[] = [];
  let i: i32 = 0;
  while (i < repl.len()) {
    flat = flat.append(resolve_repl(repl, i));
    i = i + 1;
  }
  return Formed { f: f, repl: flat };
}

// compose_repl is the replacement `b` makes after `a`.
function compose_repl(a: i32[], b: i32[]): i32[] {
  if (a.len() == 0) {
    return b;
  }
  if (b.len() == 0) {
    return a;
  }
  let out: i32[] = [];
  for v in a {
    if (v >= 0 && v < b.len()) {
      out = out.append(b[v]);
    } else {
      out = out.append(v);
    }
  }
  return out;
}

// register_form is a lifted function as the register backends allocate it:
// trivial phis folded, repeated pure operations merged, rotates fused, wraps
// nothing reads dropped, dead values pruned, branches on boolean joins
// threaded and forwarding blocks threaded. Threading drops the blocks it
// leaves unreachable, so what only they read is pruned after it.
// Dead values are pruned before the wraps too: a fused rotate's right shift
// would otherwise still read its operand's high half.
pub function register_form(f: SFunc): Formed {
  let folded: Formed = prune_trivial_phis(slot_calls(without_lines(f)));
  let merged: Formed = merge_duplicates(folded.f);
  let shared: Formed = share_shape_loads(merged.f);
  // drop_low_wraps deletes each wrap it replaces, and the wrap's operand
  // takes over its reads, so nothing it leaves is dead. prune_dead is
  // idempotent, so a pass that changed nothing needs no prune after it.
  let unwrapped: Formed = drop_low_wraps(prune_dead(fuse_rotates(shared.f)));
  let g: SFunc = unwrapped.f;
  let bytes: Formed = fold_byte_access(g);
  if (bytes.repl.len() > 0) {
    g = prune_dead(bytes.f);
  }
  let t: Threading = thread_bool_joins(g);
  if (t.changed) {
    g = prune_dead(t.f);
  }
  let fw: Threading = thread_forwarding(g);
  g = fw.f;
  if (fw.changed) {
    g = prune_dead(g);
  }
  return Formed { f: g, repl: compose_repl(compose_repl(compose_repl(compose_repl(folded.repl, merged.repl), shared.repl), unwrapped.repl), bytes.repl) };
}

// Source positions describe code; they are not allocator or optimizer inputs.
function without_lines(f: SFunc): SFunc {
  if (!has_kind(f, 35)) {
    return f;
  }
  let blocks: SBlock[] = [];
  for b in f.blocks {
    let insts: SInst[] = [];
    for ins in b.insts {
      if (ins.kind_tag != 35) {
        insts = insts.append(ins);
      }
    }
    blocks = blocks.append(SBlock { ...b, insts: insts });
  }
  return SFunc { ...f, blocks: blocks };
}

// slot_call is a call through a function value that reads the body's address
// out of slot 0 of the environment it passes first, args[1]; its args[0]
// repeats the environment.
pub function slot_call(ins: SInst): boolean {
  return ins.kind_tag == 56 && ins.str == "slot";
}

// slot_calls makes a slot_call of each call through a function value whose
// address is the unchecked read of slot 0 of the environment the call passes
// (ssarc.body_address) and is read nowhere else, and drops the read: the
// emitter loads the address from the environment at the call.
function slot_calls(f: SFunc): SFunc {
  if (!has_kind(f, 56)) {
    return f;
  }
  let env_of: i32[] = slot_reads(f);
  let uses: i32[] = use_counts(f);
  let dropped: boolean[] = __alloc_bool(f.nvals);
  let found: boolean = false;
  for blk in f.blocks {
    for ins in blk.insts {
      if (reads_own_slot(ins, env_of, uses)) {
        dropped = dropped.with(ins.args[0], true);
        found = true;
      }
    }
  }
  if (!found) {
    return f;
  }
  let out: SBlock[] = [];
  for blk in f.blocks {
    out = out.append(slot_block(blk, env_of, uses, dropped));
  }
  return SFunc { ...f, blocks: out };
}

pub function has_kind(f: SFunc, k: i32): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == k) {
        return true;
      }
    }
  }
  return false;
}

// slot_reads maps each unchecked read of slot 0 of a box to the box.
function slot_reads(f: SFunc): i32[] {
  let zero: boolean[] = __alloc_bool(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 1 && ins.imm == 0) {
        zero = zero.with(ins.result, true);
      }
    }
  }
  let env_of: i32[] = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 42 && ins.imm == 1 && ins.str == "" && zero[ins.args[1]]) {
        env_of = env_of.with(ins.result, ins.args[0]);
      }
    }
  }
  return env_of;
}

// slot_block is `blk` with its slot calls marked and the reads they replace
// dropped; a block with neither is handed back as it is.
function slot_block(blk: SBlock, env_of: i32[], uses: i32[], dropped: boolean[]): SBlock {
  let edit: boolean = false;
  for ins in blk.insts {
    edit = edit || reads_own_slot(ins, env_of, uses) || ins.kind_tag == 42 && dropped[ins.result];
  }
  if (!edit) {
    return blk;
  }
  let insts: SInst[] = [];
  for ins in blk.insts {
    if (reads_own_slot(ins, env_of, uses)) {
      insts = insts.append(SInst { ...ins, args: ins.args.with(0, ins.args[1]), str: "slot" });
    } else if (ins.kind_tag != 42 || !dropped[ins.result]) {
      insts = insts.append(ins);
    }
  }
  return SBlock { ...blk, insts: insts };
}

// reads_own_slot is a call through a function value whose target is read out
// of slot 0 of the environment it passes and by nothing else.
function reads_own_slot(ins: SInst, env_of: i32[], uses: i32[]): boolean {
  return ins.kind_tag == 56 && ins.args.len() > 1 && env_of[ins.args[0]] == ins.args[1] && uses[ins.args[0]] == 1;
}

// share_shape_loads maps a load of a box's word 0, its shape, onto an earlier
// load of the same word that reaches it along a chain of blocks each entered
// from one predecessor with nothing between them that may write memory: the
// shape of a `match`'s chain of variant tests. A runtime call may update a box
// in place (a map iterator's advance does), so a call ends what is shared. A
// box whose word 0 or elements the function stores, and any function with a
// raw store, is left alone.
function share_shape_loads(f: SFunc): Formed {
  let stored: boolean[] = __alloc_bool(f.nvals);
  let loads: i32 = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      let k: i32 = ins.kind_tag;
      if (k == 16 || k == 53 || k == 55) {
        return Formed { f: f, repl: [] };
      }
      if ((k == 41 && ins.imm == 0 || k == 43) && ins.args.len() > 0 && ins.args[0] >= 0 && ins.args[0] < f.nvals) {
        stored = stored.with(ins.args[0], true);
      }
      if (shape_load(ins, f.nvals)) {
        loads = loads + 1;
      }
    }
  }
  if (loads < 2) {
    return Formed { f: f, repl: [] };
  }
  let at: i32[] = block_positions(f);
  let repl: i32[] = [];
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let insts: SInst[] = f.blocks[bi].insts;
    let k: i32 = 0;
    while (k < insts.len()) {
      let ins: SInst = insts[k];
      if (shape_load(ins, f.nvals) && !stored[ins.args[0]]) {
        let found: i32 = earlier_shape(f, at, bi, k, ins.args[0]);
        if (found >= 0) {
          if (repl.len() == 0) {
            repl = identity_repl(f.nvals);
          }
          repl = repl.with(ins.result, repl[found]);
        }
      }
      k = k + 1;
    }
    bi = bi + 1;
  }
  if (repl.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  return Formed { f: rewrite_through(f, repl), repl: repl };
}

// earlier_shape is the load of `box`'s word 0 that position `k` of block `bi`
// reads its shape from: the nearest before it in the block, or up the chain of
// blocks each entered from one earlier block, with nothing that may write
// memory on the way. -1 when there is none.
function earlier_shape(f: SFunc, at: i32[], bi: i32, k: i32, box: i32): i32 {
  let b: i32 = bi;
  let j: i32 = k - 1;
  while (true) {
    while (j >= 0) {
      let ins: SInst = f.blocks[b].insts[j];
      if (shape_load(ins, f.nvals) && ins.args[0] == box) {
        return ins.result;
      }
      if (may_write(ins.kind_tag)) {
        return 0 - 1;
      }
      j = j - 1;
    }
    if (f.blocks[b].preds.len() != 1) {
      return 0 - 1;
    }
    let pb: i32 = position_of(at, f.blocks[b].preds[0]);
    if (pb < 0 || pb >= b) {
      return 0 - 1;
    }
    b = pb;
    j = f.blocks[b].insts.len() - 1;
  }
}

// may_write is an instruction that may write memory: one with an effect other
// than a line mark or a bounds-checked read, which can only abort.
function may_write(k: i32): boolean {
  return inst_has_effect(k) && k != 35 && k != 42 && k != 44;
}

function shape_load(ins: SInst, nvals: i32): boolean {
  return ins.kind_tag == 40 && ins.imm == 0 && ins.args.len() == 1 && ins.args[0] >= 0 && ins.args[0] < nvals && ins.result >= 0 && ins.result < nvals && ins.str == "";
}

// fold_byte_access does two things for a byte. It replaces an extension,
// wrap or widening cast of a byte value by its operand: a byte load leaves
// 0..255 in the whole register, which every one of those leaves unchanged.
// And it gives a byte load or store at `add(a, b) + 0` the address `a + b`,
// when the full-width sum is read nowhere else, so the backends use the
// base-plus-index form rather than computing the sum and a zero index. The
// register backends only: on wasm an extension changes the value's type.
pub function fold_byte_access(f: SFunc): Formed {
  if (!has_byte_access(f)) {
    return Formed { f: f, repl: [] };
  }
  let def_b: i32[] = __alloc_i32(f.nvals);
  let def_k: i32[] = __alloc_i32(f.nvals);
  let i: i32 = 0;
  while (i < f.nvals) {
    def_b = def_b.with(i, 0 - 1);
    def_k = def_k.with(i, 0 - 1);
    i = i + 1;
  }
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let k: i32 = 0;
    while (k < f.blocks[bi].insts.len()) {
      let r: i32 = f.blocks[bi].insts[k].result;
      if (r >= 0 && r < f.nvals) {
        def_b = def_b.with(r, bi);
        def_k = def_k.with(r, k);
      }
      k = k + 1;
    }
    bi = bi + 1;
  }
  let byte: boolean[] = __alloc_bool(f.nvals);
  let repl: i32[] = [];
  let uses: i32[] = use_counts(f);
  let changed: boolean = false;
  let nblocks: SBlock[] = [];
  for blk in f.blocks {
    let ninsts: SInst[] = [];
    for ins0 in blk.insts {
      let ins: SInst = ins0;
      if (repl.len() > 0) {
        let nargs: i32[] = [];
        for a in ins.args {
          nargs = nargs.append(resolve_repl(repl, a));
        }
        ins = SInst { ...ins, args: nargs };
      }
      let r: i32 = ins.result;
      if (r >= 0 && r < f.nvals && byte_extension(ins) && ins.args[0] >= 0 && ins.args[0] < f.nvals && byte[ins.args[0]]) {
        if (repl.len() == 0) {
          i = 0;
          while (i < f.nvals) {
            repl = repl.append(i);
            i = i + 1;
          }
        }
        repl = repl.with(r, ins.args[0]);
        byte = byte.with(r, true);
        changed = true;
        continue;
      }
      if (r >= 0 && r < f.nvals && byte_source(f, def_b, def_k, ins)) {
        byte = byte.with(r, true);
      }
      if ((ins.kind_tag == 54 || ins.kind_tag == 55) && const_zero(f, def_b, def_k, ins.args[1])) {
        let base: i32 = ins.args[0];
        let d: SInst = def_at(f, def_b, def_k, base);
        if (d.kind_tag == 9 && d.str == "add" && d.imm == 64 && d.args.len() == 2 && base >= 0 && base < uses.len() && uses[base] == 1) {
          let nargs: i32[] = [d.args[0], d.args[1]];
          if (ins.kind_tag == 55) {
            nargs = nargs.append(ins.args[2]);
          }
          ins = SInst { ...ins, args: nargs };
          changed = true;
        }
      }
      ninsts = ninsts.append(ins);
    }
    let t: STerm = blk.term;
    if (repl.len() > 0) {
      if (t.kind_tag == 1) {
        t = STerm { ...t, value: resolve_repl(repl, t.value) };
      } else if (t.kind_tag == 3) {
        t = STerm { ...t, cond: resolve_repl(repl, t.cond) };
      }
    }
    nblocks = nblocks.append(SBlock { ...blk, insts: ninsts, term: t });
  }
  if (!changed) {
    return Formed { f: f, repl: [] };
  }
  if (repl.len() == 0) {
    repl = identity_repl(f.nvals);
  }
  return formed_by(SFunc { ...f, blocks: nblocks }, repl);
}

// has_byte_access says `f` holds an instruction fold_byte_access can start
// from: a byte load or store, or one byte_source may call a byte.
function has_byte_access(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      let k: i32 = ins.kind_tag;
      if (k == 54 || k == 55 || k == 44 || k == 42 && ins.str == "u8" || k == 9 && ins.str == "and") {
        return true;
      }
    }
  }
  return false;
}

// byte_source is an instruction whose value is a byte, 0..255 zero-extended
// to the whole register: a byte load, an element of a u8 array, a byte of a
// string, or an `and` with a constant mask no wider than a byte.
function byte_source(f: SFunc, def_b: i32[], def_k: i32[], ins: SInst): boolean {
  if (ins.kind_tag == 54) {
    return true;
  }
  if (ins.kind_tag == 42 || ins.kind_tag == 44) {
    return ins.imm != 2 && (ins.kind_tag == 44 || ins.str == "u8");
  }
  if (ins.kind_tag == 9 && ins.str == "and" && ins.args.len() == 2) {
    return const_in(f, def_b, def_k, ins.args[0], 0i64, 255i64) || const_in(f, def_b, def_k, ins.args[1], 0i64, 255i64);
  }
  return false;
}

// byte_extension is a unary that leaves a value in 0..255 unchanged: a 32-bit
// wrap or extension, signed or not, or a cast to u8, i32 or u32.
function byte_extension(ins: SInst): boolean {
  if (ins.kind_tag != 10 || ins.args.len() != 1) {
    return false;
  }
  return ins.str == "int_wrap" || ins.str == "int_extend" || ins.str == "u32_wrap"
    || ins.str == "int_cast:u8" || ins.str == "int_cast:i32" || ins.str == "int_cast:u32";
}

function const_zero(f: SFunc, def_b: i32[], def_k: i32[], v: i32): boolean {
  return const_in(f, def_b, def_k, v, 0i64, 0i64);
}

// const_in says v is an integer constant in lo..hi.
function const_in(f: SFunc, def_b: i32[], def_k: i32[], v: i32, lo: i64, hi: i64): boolean {
  let d: SInst = def_at(f, def_b, def_k, v);
  if (d.kind_tag == 1) {
    return d.imm as i64 >= lo && d.imm as i64 <= hi;
  }
  if (d.kind_tag == 3) {
    let c: i64 = util.lit_to_i64(d.str);
    return c >= lo && c <= hi;
  }
  return false;
}

// drop_low_wraps replaces a 32-bit wrap, extend or cast, signed or unsigned, by
// its operand where nothing reads the high half of its result. A sum,
// difference, product, bitwise op or left shift reads only its operands' low
// halves when nothing reads its own high half, as do a shift's count, a 32-bit
// rotate or byte swap and the narrowing unaries, so the wrap the lowering puts
// after each 32-bit op is needed only where the value reaches a comparison, a
// division, a right shift, a call, a store, a branch or a return. A signed
// loop counter's step goes too, read or not: `v + 1` for a v that is below a
// 32-bit value cannot overflow (counter_step). The register backends only: on
// wasm the wrap changes the value's type.
pub function drop_low_wraps(f: SFunc): Formed {
  if (!has_low_wrap(f)) {
    return Formed { f: f, repl: [] };
  }
  // prop[v] is how many leading operands of v's definition have their high
  // half read once v's is (high_operands); def_b / def_k locate v's
  // definition, -1 for a value nothing defines.
  let prop: i32[] = __alloc_i32(f.nvals);
  let def_b: i32[] = __alloc_i32(f.nvals);
  let def_k: i32[] = __alloc_i32(f.nvals);
  let high: boolean[] = __alloc_bool(f.nvals);
  let i: i32 = 0;
  while (i < f.nvals) {
    def_b = def_b.with(i, 0 - 1);
    def_k = def_k.with(i, 0 - 1);
    i = i + 1;
  }
  let wraps: i32[] = [];
  let wrap_arg: i32[] = [];
  let work: i32[] = [];
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let insts: SInst[] = f.blocks[bi].insts;
    let k: i32 = 0;
    while (k < insts.len()) {
      let ins: SInst = insts[k];
      let r: i32 = ins.result;
      if (r >= 0 && r < f.nvals) {
        let n: i32 = high_operands(ins);
        if (n > 0) {
          prop = prop.with(r, n);
        }
        def_b = def_b.with(r, bi);
        def_k = def_k.with(r, k);
        if (low_wrap(ins)) {
          wraps = wraps.append(r);
          wrap_arg = wrap_arg.append(ins.args[0]);
        }
      }
      let ai: i32 = 0;
      while (ai < ins.args.len()) {
        let a: i32 = ins.args[ai];
        if (a >= 0 && a < f.nvals && !high[a] && !reads_low_half(ins, ai)) {
          high = high.with(a, true);
          work = work.append(a);
        }
        ai = ai + 1;
      }
      k = k + 1;
    }
    let tv: i32 = term_operand(f.blocks[bi].term);
    if (tv >= 0 && tv < f.nvals && !high[tv]) {
      high = high.with(tv, true);
      work = work.append(tv);
    }
    bi = bi + 1;
  }
  let wi: i32 = 0;
  while (wi < work.len()) {
    let v: i32 = work[wi];
    wi = wi + 1;
    if (prop[v] == 0) {
      continue;
    }
    let args: i32[] = f.blocks[def_b[v]].insts[def_k[v]].args;
    let ai: i32 = 0;
    while (ai < prop[v]) {
      let a: i32 = args[ai];
      if (a >= 0 && a < f.nvals && !high[a]) {
        high = high.with(a, true);
        work = work.append(a);
      }
      ai = ai + 1;
    }
  }
  let repl: i32[] = [];
  let dropped: boolean = false;
  let at: i32[] = block_positions(f);
  let wj: i32 = 0;
  while (wj < wraps.len()) {
    let w: i32 = wraps[wj];
    if (!high[w] || signed_wrap(def_at(f, def_b, def_k, w)) && counter_step(f, at, def_b, def_k, wrap_arg[wj])) {
      if (!dropped) {
        i = 0;
        while (i < f.nvals) {
          repl = repl.append(i);
          i = i + 1;
        }
        dropped = true;
      }
      repl = repl.with(w, wrap_arg[wj]);
    }
    wj = wj + 1;
  }
  if (!dropped) {
    return Formed { f: f, repl: [] };
  }
  let nblocks: SBlock[] = [];
  for blk in f.blocks {
    if (!block_reads_replaced(blk, repl)) {
      nblocks = nblocks.append(blk);
      continue;
    }
    let ninsts: SInst[] = [];
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals && repl[ins.result] != ins.result) {
        continue;
      }
      let nargs: i32[] = [];
      for a in ins.args {
        nargs = nargs.append(resolve_repl(repl, a));
      }
      ninsts = ninsts.append(SInst { ...ins, args: nargs });
    }
    let t: STerm = blk.term;
    if (t.kind_tag == 1) {
      t = STerm { ...t, value: resolve_repl(repl, t.value) };
    } else if (t.kind_tag == 3) {
      t = STerm { ...t, cond: resolve_repl(repl, t.cond) };
    }
    nblocks = nblocks.append(SBlock { ...blk, insts: ninsts, term: t });
  }
  return formed_by(SFunc { ...f, blocks: nblocks }, repl);
}

function has_low_wrap(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (low_wrap(ins)) {
        return true;
      }
    }
  }
  return false;
}

// block_reads_replaced says a block defines or reads a value `repl` maps
// elsewhere, so drop_low_wraps has to rebuild it.
function block_reads_replaced(blk: SBlock, repl: i32[]): boolean {
  for ins in blk.insts {
    if (ins.result >= 0 && ins.result < repl.len() && repl[ins.result] != ins.result) {
      return true;
    }
    for a in ins.args {
      if (a >= 0 && a < repl.len() && repl[a] != a) {
        return true;
      }
    }
  }
  let tv: i32 = term_operand(blk.term);
  return tv >= 0 && tv < repl.len() && repl[tv] != tv;
}

// counter_step says `a` is `v + 1` at 32 bits computed where v is known to be
// below a 32-bit value (tested_below): v + 1 cannot pass INT32_MAX, so a wrap
// of it changes nothing whoever reads it. A reader of the high half (a call,
// `sarq`) still sees the sign extension because v's own register holds it:
// the header's compare marks v high, and high_operands carries that through
// the phi to the wrap that defines v.
function counter_step(f: SFunc, at: i32[], def_b: i32[], def_k: i32[], a: i32): boolean {
  let add: SInst = def_at(f, def_b, def_k, a);
  if (add.kind_tag != 9 || add.str != "add" || add.imm == 64 || add.args.len() != 2) {
    return false;
  }
  if (const_one(f, def_b, def_k, add.args[1])) {
    return tested_below(f, at, def_b, def_k, add.args[0], def_b[a]);
  }
  return const_one(f, def_b, def_k, add.args[0]) && tested_below(f, at, def_b, def_k, add.args[1], def_b[a]);
}

// tested_below says block position `d` runs only after v tested below a 32-bit
// value: v is a phi whose block branches on `v < n` (or out on `v >= n`) to a
// successor that dominates d, which refuses a body another test also enters.
// The successor must be entered from that test alone too: the lowering never
// branches into a shared block today, but a lifted op_brif can.
function tested_below(f: SFunc, at: i32[], def_b: i32[], def_k: i32[], v: i32, d: i32): boolean {
  if (def_at(f, def_b, def_k, v).kind_tag != 8) {
    return false;
  }
  let h: SBlock = f.blocks[def_b[v]];
  let t: STerm = h.term;
  if (t.kind_tag != 3 || t.t == t.f) {
    return false;
  }
  let c: SInst = def_at(f, def_b, def_k, t.cond);
  let below: i32 = 0 - 1;
  if (compares_below(c, v, "lt_s", "gt_s")) {
    below = t.t;
  } else if (compares_below(c, v, "ge_s", "le_s")) {
    below = t.f;
  }
  let b: i32 = position_of(at, below);
  if (b < 0 || f.blocks[b].preds.len() != 1 || f.blocks[b].preds[0] != h.id) {
    return false;
  }
  return dominates_position(f, at, b, d);
}

// dominates_position says every path from the entry to position d passes
// position b: walking predecessors back from d without stepping onto b never
// reaches the entry. A dominated d keeps the walk inside the region b heads.
function dominates_position(f: SFunc, at: i32[], b: i32, d: i32): boolean {
  if (b == d) {
    return true;
  }
  let entry: i32 = position_of(at, f.entry);
  if (entry == b) {
    return true;
  }
  if (entry < 0 || d < 0) {
    return false;
  }
  let seen: boolean[] = __alloc_bool(f.blocks.len());
  seen = seen.with(d, true);
  let stack: i32[] = [d];
  let si: i32 = 0;
  while (si < stack.len()) {
    let cur: i32 = stack[si];
    si = si + 1;
    if (cur == entry) {
      return false;
    }
    for pid in f.blocks[cur].preds {
      let p: i32 = position_of(at, pid);
      if (p < 0) {
        return false;
      }
      if (p != b && !seen[p]) {
        seen = seen.with(p, true);
        stack = stack.append(p);
      }
    }
  }
  return true;
}

// compares_below says c is a 32-bit `o first n` or `n second o`; a binary's
// imm is 64 at full width.
function compares_below(c: SInst, o: i32, first: string, second: string): boolean {
  if (c.kind_tag != 9 || c.imm == 64 || c.args.len() != 2) {
    return false;
  }
  return c.str == first && c.args[0] == o || c.str == second && c.args[1] == o;
}

function const_one(f: SFunc, def_b: i32[], def_k: i32[], v: i32): boolean {
  let d: SInst = def_at(f, def_b, def_k, v);
  return d.kind_tag == 1 && d.imm == 1;
}

// def_at is v's defining instruction, or one of kind 0 for a value nothing
// defines.
function def_at(f: SFunc, def_b: i32[], def_k: i32[], v: i32): SInst {
  if (v < 0 || v >= def_b.len() || def_b[v] < 0) {
    return SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  }
  return f.blocks[def_b[v]].insts[def_k[v]];
}

// signed_wrap is a signed 32-bit wrap, extend or cast, which the register
// backends render as a sign extension of the low half.
function signed_wrap(ins: SInst): boolean {
  if (ins.kind_tag != 10 || ins.args.len() != 1 || ins.imm != 0) {
    return false;
  }
  return ins.str == "int_wrap" || ins.str == "int_extend" || ins.str == "int_cast:i32";
}

// low_wrap is a signed wrap or a u32 one, which the register backends render
// as a zero extension of the low half.
function low_wrap(ins: SInst): boolean {
  if (signed_wrap(ins)) {
    return true;
  }
  return ins.kind_tag == 10 && ins.args.len() == 1 && (ins.str == "u32_wrap" || ins.str == "int_cast:u32");
}

// low_half_binary is a binary whose result's low half depends on its
// operands' low halves alone.
function low_half_binary(op: string): boolean {
  return op == "add" || op == "sub" || op == "mul" || op == "and" || op == "or" || op == "xor";
}

// reads_low_half says `ins` reads only the low half of its operand `k`, or
// passes the question on to its own result (high_operands).
function reads_low_half(ins: SInst, k: i32): boolean {
  if (ins.kind_tag == 7 || ins.kind_tag == 8) {
    return true;
  }
  if (ins.kind_tag == 9) {
    if (low_half_binary(ins.str) || ins.str == "shl") {
      return true;
    }
    return k == 1 && (ins.str == "shr_s" || ins.str == "shr_u");
  }
  if (ins.kind_tag == 10) {
    if (util.str_has_prefix(ins.str, "rotr:")) {
      return rotr_width(ins.str) == 32;
    }
    if (ins.str == "bswap:32") {
      return true;
    }
    return ins.str == "int_wrap" || ins.str == "int_extend" || ins.str == "u32_wrap" || ins.str == "int_cast:i32" || ins.str == "int_cast:u32" || ins.str == "int_cast:u8";
  }
  return false;
}

// high_operands is how many leading operands of `d` have their high half read
// once d's own is: all of a copy's, a phi's and a low-half binary's, a left
// shift's value but not its count.
function high_operands(d: SInst): i32 {
  if (d.kind_tag == 7 || d.kind_tag == 8 || d.kind_tag == 9 && low_half_binary(d.str)) {
    return d.args.len();
  }
  if (d.kind_tag == 9 && d.str == "shl") {
    return 1;
  }
  return 0;
}

// term_operand is the value a terminator reads, or -1.
function term_operand(t: STerm): i32 {
  if (t.kind_tag == 1) {
    return t.value;
  }
  if (t.kind_tag == 3) {
    return t.cond;
  }
  return 0 - 1;
}

// fuse_rotates rewrites `(x >> n) | (x << (W - n))`, the only spelling Fern
// has for a rotate, into one `rotr:W:n` unary on x (#10615). A u32 keeps its
// value zero-extended, so its left half carries a u32_wrap and its right half
// needs none; a 64-bit rotate has neither. The shifts are left to prune_dead.
pub function fuse_rotates(f: SFunc): SFunc {
  if (!has_or(f)) {
    return f;
  }
  let defs: SInst[] = [];
  let none: SInst = SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  let i: i32 = 0;
  while (i < f.nvals) {
    defs = defs.append(none);
    i = i + 1;
  }
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals) {
        defs = defs.with(ins.result, ins);
      }
    }
  }
  // `nblocks` is written from the first block that fuses a rotate on, and a
  // block's `ninsts` from its first fused instruction on.
  let nblocks: SBlock[] = [];
  let copying: boolean = false;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    let ninsts: SInst[] = [];
    let fused: boolean = false;
    let k: i32 = 0;
    while (k < blk.insts.len()) {
      let ins: SInst = blk.insts[k];
      let r: SInst = ins;
      if (ins.kind_tag == 9 && ins.str == "or" && ins.args.len() == 2) {
        let m: SInst = rotate_half_pair(defs, ins, ins.args[0], ins.args[1]);
        if (m.kind_tag == 0) {
          m = rotate_half_pair(defs, ins, ins.args[1], ins.args[0]);
        }
        if (m.kind_tag != 0) {
          r = m;
          if (!fused) {
            ninsts = insts_before(blk.insts, k);
            fused = true;
          }
        }
      }
      if (fused) {
        ninsts = ninsts.append(r);
      }
      k = k + 1;
    }
    if (fused) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { ...blk, insts: ninsts });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
    bi = bi + 1;
  }
  if (!copying) {
    return f;
  }
  return SFunc { ...f, blocks: nblocks };
}

// has_or reports whether `f` holds a two-operand `or`, the only instruction
// fuse_rotates rewrites.
function has_or(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 9 && ins.args.len() == 2 && ins.str == "or") {
        return true;
      }
    }
  }
  return false;
}

// rotate_half_pair is the rotate `or` computes when `rv` is the logical right
// shift and `lv` the left one, or an instruction of kind 0 when it is not one.
function rotate_half_pair(defs: SInst[], or: SInst, rv: i32, lv: i32): SInst {
  let no: SInst = SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  let rs: SInst = def_of(defs, rv);
  let ls: SInst = def_of(defs, lv);
  let w: i32 = 64;
  if (zero_extends_u32(ls)) {
    w = 32;
    ls = def_of(defs, ls.args[0]);
  }
  if (rs.kind_tag != 9 || rs.str != "shr_u" || ls.kind_tag != 9 || ls.str != "shl") {
    return no;
  }
  if (shift_width(rs.imm) != w || shift_width(ls.imm) != w) {
    return no;
  }
  if (copy_root(defs, rs.args[0]) != copy_root(defs, ls.args[0])) {
    return no;
  }
  let n: i64 = const_value(defs, rs.args[1]);
  let k: i64 = const_value(defs, ls.args[1]);
  if (n <= 0i64 || k <= 0i64 || n + k != w as i64) {
    return no;
  }
  return SInst { kind_tag: 10, result: or.result, args: [rs.args[0]], imm: 0, str: "rotr:" + util.i32_to_string(w) + ":" + util.i64_to_string(n) };
}

// zero_extends_u32 is a unary the emitters render as a 32-bit zero extension.
function zero_extends_u32(ins: SInst): boolean {
  if (ins.kind_tag != 10 || ins.args.len() != 1) {
    return false;
  }
  if (ins.str == "u32_wrap" || ins.str == "int_cast:u32") {
    return true;
  }
  return (ins.str == "int_wrap" || ins.str == "int_extend") && ins.imm == 1;
}

function def_of(defs: SInst[], v: i32): SInst {
  if (v < 0 || v >= defs.len()) {
    return SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  }
  return defs[v];
}

// A shift's imm is its operand width; anything but 64 is the 32-bit form.
function shift_width(imm: i32): i32 {
  if (imm == 64) {
    return 64;
  }
  return 32;
}

// copy_root follows `copy` instructions back to the value they alias.
function copy_root(defs: SInst[], v: i32): i32 {
  let r: i32 = v;
  let steps: i32 = 0;
  while (steps < defs.len()) {
    let d: SInst = def_of(defs, r);
    if (d.kind_tag != 7 || d.args.len() != 1) {
      return r;
    }
    r = d.args[0];
    steps = steps + 1;
  }
  return r;
}

// const_value is an integer constant's value, or -1 for anything else (no
// rotate count is negative).
function const_value(defs: SInst[], v: i32): i64 {
  let d: SInst = def_of(defs, copy_root(defs, v));
  if (d.kind_tag == 1) {
    return d.imm as i64;
  }
  if (d.kind_tag == 3) {
    return util.lit_to_i64(d.str);
  }
  return 0i64 - 1i64;
}

// rotr_width and rotr_count read a `rotr:W:n` unary's name back.
pub function rotr_width(what: string): i32 {
  if (util.str_has_prefix(what, "rotr:64:")) {
    return 64;
  }
  return 32;
}

pub function rotr_count(what: string): i32 {
  let n: i32 = 0;
  let i: i32 = 8;
  while (i < what.len()) {
    n = n * 10 + (what[i] as i32 - 48);
    i = i + 1;
  }
  return n;
}

// prune_dead drops the pure instructions nothing reads. A block that keeps
// every instruction keeps its record, and a function that keeps every block
// is returned as it came: `nblocks` is written from the first block that
// loses an instruction on, and a block's `ninsts` from its first dead
// instruction on.
pub function prune_dead(f: SFunc): SFunc {
  let live: i32[] = prune_mark(f, prune_roots(f));
  let nblocks: SBlock[] = [];
  let copying: boolean = false;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    let ninsts: SInst[] = [];
    let pruned: boolean = false;
    let k: i32 = 0;
    while (k < blk.insts.len()) {
      let ins: SInst = blk.insts[k];
      let stays: boolean = inst_has_effect(ins.kind_tag) || live[ins.result] == 1;
      if (pruned) {
        if (stays) {
          ninsts = ninsts.append(ins);
        }
      } else if (!stays) {
        ninsts = insts_before(blk.insts, k);
        pruned = true;
      }
      k = k + 1;
    }
    if (pruned) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { id: blk.id, insts: ninsts, term: blk.term, preds: blk.preds });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
    bi = bi + 1;
  }
  if (!copying) {
    return f;
  }
  return SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: nblocks, entry: f.entry, takes_env: f.takes_env };
}

function insts_before(insts: SInst[], n: i32): SInst[] {
  let out: SInst[] = [];
  let j: i32 = 0;
  while (j < n) {
    out = out.append(insts[j]);
    j = j + 1;
  }
  return out;
}

function blocks_before(blocks: SBlock[], n: i32): SBlock[] {
  let out: SBlock[] = [];
  let j: i32 = 0;
  while (j < n) {
    out = out.append(blocks[j]);
    j = j + 1;
  }
  return out;
}

// inst_has_effect names the instructions kept whether or not their result is
// read: params, calls, allocation and stores, and the output and buffer ops.
function inst_has_effect(k: i32): boolean {
  // Below 19: params, calls, allocation, stores and concat. From 19 on
  // everything but a select (36), a load (40) and a label address (45..47) has one: the
  // output, file and buffer ops, a store, a bounds-checked read (it may
  // abort) and the box allocation.
  if (k < 19) {
    return k == 6 || k == 11 || k == 12 || k == 14 || k == 16 || k == 17;
  }
  return k != 36 && k != 40 && k != 45 && k != 46 && k != 47 && k != 52 && k != 54 && k != 57 && k != 58;
}

// prune_roots is every value an effectful instruction or a terminator reads.
function prune_roots(f: SFunc): i32[] {
  let work: i32[] = [];
  for blk in f.blocks {
    for ins in blk.insts {
      if (inst_has_effect(ins.kind_tag)) {
        for a in ins.args {
          work = work.append(a);
        }
      }
    }
    if (blk.term.kind_tag == 1) {
      work = work.append(blk.term.value);
    }
    if (blk.term.kind_tag == 3) {
      work = work.append(blk.term.cond);
    }
  }
  return work;
}

// prune_mark marks the roots and, through the pure instructions that define
// them, everything they read.
function prune_mark(f: SFunc, work: i32[]): i32[] {
  let live: i32[] = __alloc_i32(f.nvals);
  let def_b: i32[] = __alloc_i32(f.nvals);
  let def_k: i32[] = __alloc_i32(f.nvals);
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let k: i32 = 0;
    while (k < f.blocks[bi].insts.len()) {
      let r: i32 = f.blocks[bi].insts[k].result;
      def_b = def_b.with(r, bi + 1);
      def_k = def_k.with(r, k);
      k = k + 1;
    }
    bi = bi + 1;
  }
  let at: i32 = 0;
  while (at < work.len()) {
    let v: i32 = work[at];
    at = at + 1;
    if (v < 0 || v >= f.nvals || live[v] == 1) {
      continue;
    }
    live = live.with(v, 1);
    if (def_b[v] == 0) {
      continue;
    }
    for a in f.blocks[def_b[v] - 1].insts[def_k[v]].args {
      work = work.append(a);
    }
  }
  return live;
}

// count_insts totals the instructions across all blocks (used by tests to
// confirm the optimiser actually shrinks the IR).
pub function count_insts(f: SFunc): i32 {
  let n: i32 = 0;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    n = n + f.blocks[bi].insts.len();
    bi = bi + 1;
  }
  return n;
}

pub function pred_slot(blk: SBlock, prev: i32): i32 {
  let i: i32 = 0;
  while (i < blk.preds.len()) {
    if (blk.preds[i] == prev) {
      return i;
    }
    i = i + 1;
  }
  return 0;
}

function eval_binary(op: string, l: i32, r: i32): i32 {
  if (op == "+") {
    return l + r;
  }
  if (op == "-") {
    return l - r;
  }
  if (op == "*") {
    return l * r;
  }
  if (op == "/") {
    return l / r;
  }
  if (op == "%") {
    return l % r;
  }
  if (op == "==") {
    if (l == r) {
      return 1;
    }
    return 0;
  }
  if (op == "!=") {
    if (l != r) {
      return 1;
    }
    return 0;
  }
  if (op == "<") {
    if (l < r) {
      return 1;
    }
    return 0;
  }
  if (op == "<=") {
    if (l <= r) {
      return 1;
    }
    return 0;
  }
  if (op == ">") {
    if (l > r) {
      return 1;
    }
    return 0;
  }
  if (op == ">=") {
    if (l >= r) {
      return 1;
    }
    return 0;
  }
  if (op == "&&") {
    if (l != 0 && r != 0) {
      return 1;
    }
    return 0;
  }
  if (op == "||") {
    if (l != 0 || r != 0) {
      return 1;
    }
    return 0;
  }
  if (op == "&") {
    return l & r;
  }
  if (op == "|") {
    return l | r;
  }
  if (op == "^") {
    return l ^ r;
  }
  if (op == "<<") {
    return l << r;
  }
  if (op == ">>") {
    return l >> r;
  }
  return 0;
}
