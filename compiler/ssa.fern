// The name of each semantic kind. Semantic ids run from -1 downward, so the
// kind -k is at index k - 1. An empty name marks a retired id.
const SEMANTIC_KIND_NAMES: string[] = [
  "array_new",  // -1
  "tuple_new",  // -2
  "array_get",  // -3
  "tuple_get",  // -4
  "record_new",  // -5
  "record_get",  // -6
