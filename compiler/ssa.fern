  "checked_value",  // -58
  "array_zero",  // -59
];

pub function kind_name(id: i32): string {
  if (id < 0) {
    let at = -id - 1;
    if (at < SEMANTIC_KIND_NAMES.len() && SEMANTIC_KIND_NAMES[at] != "") {
      return SEMANTIC_KIND_NAMES[at];
    }
    return "invalid";
  }
  if (id == 0 || id >= KIND_NAMES.len() || KIND_NAMES[id] == "") {
    return "invalid";
  }
  return KIND_NAMES[id];
}

// The id of an instruction kind name, or 0. Semantic names are not looked up.
pub function kind_id(name: string): i32 {
  if (name == "") {
    return 0;
  }
  for id in 1..KIND_NAMES.len() {
    if (KIND_NAMES[id] == name) {
      return id;
    }
  }
  return 0;
}

pub function kind_count(): i32 {
  return KIND_NAMES.len() - 1;
}

pub function kind_retired(id: i32): boolean {
  return id > 0 && id < KIND_NAMES.len() && KIND_NAMES[id] == "";
}

pub function semantic_kind_count(): i32 {
  return SEMANTIC_KIND_NAMES.len();
}

pub function term_count(): i32 {
  return 3;
}

pub function term_id(name: string): i32 {
  return match (name) {
    "ret" => 1,
    "br" => 2,
    "brif" => 3,
    _ => 0,
  };
}

pub function term_name(id: i32): string {
  return match (id) {
    0 => "",
    1 => "ret",
    2 => "br",
    3 => "brif",
    4 => "unreachable",
    _ => "terminator " + util.i32_to_string(id),
  };
}

function rewrite_args(ins: SInst, resolved: i32[]): SInst {
  let na: i32[] = [];
  for i in 0..ins.args.len() {
    na = na.append(resolved[ins.args[i]]);
  }
  return SInst { kind_tag: ins.kind_tag, result: ins.result, args: na, imm: ins.imm, str: ins.str };
}

function rewrite_term(t: STerm, resolved: i32[]): STerm {
  if (t.kind_tag == TERM_RET) {
    return t_ret(resolved[t.value]);
  }
  if (t.kind_tag == TERM_BRIF) {
    return t_brif(resolved[t.cond], t.t, t.f);
  }
  return t;
}

function inst_is_call(k: i32): boolean {
  if (k == CALL || k == CALL_INDIRECT || k == CONCAT || k == STREQ || k == ARR_BOX || k == STR_CALL || k == RT_CALL || k == STR_VIEW || k == CALL_IND || k == FLAT_OP || k == DYN_DISPATCH) {
    return true;
  }
  return k >= PRINT && k <= WRITE_FILE;
}

// A runtime abort exits the process, so no value has to survive it.
pub function never_returns(ins: SInst): boolean {
  return inst_is_call(ins.kind_tag) && ins.args.len() == 0
    && (ins.str == "__fern_oob_abort" || ins.str == "__fern_str_oob_abort" || ins.str == "__fern_slice_abort" || ins.str == "__fern_alloc_size_abort");
}

pub function cold_call(ins: SInst): boolean {
  return ins.kind_tag == RT_CALL && ins.result >= 0 && ins.str.starts_with("arr_push");
}

// A back-reference copy calls only when its inline copy cannot run.
pub function back_copy_call(ins: SInst): boolean {
  return ins.kind_tag == CALL && ins.result >= 0 && ins.str == "__fern_bytes_append_back";
}

// A call that the allocator counts: it returns, and its result is not the
// block's own return value.
pub function counted_call(blk: SBlock, k: i32): boolean {
  let ins = blk.insts[k];
  return inst_is_call(ins.kind_tag) && !never_returns(ins) && !returns_call(blk, k);
}

// For each position, whether a counted call there clobbers the caller
// registers: a cold call saves what it needs itself.
pub function hard_call_positions(f: SFunc, cold: i32[]): boolean[] {
  let out: boolean[] = [];
  for blk in f.blocks {
    for k in 0..blk.insts.len() {
      let pos = out.len();
      out = out.append(counted_call(blk, k) && (cold.len() == 0 || cold[pos] == COLD_NONE));
    }
    out = out.append(false);
  }
  return out;
}

pub const COLD_NONE: i32 = 0;

pub const COLD_SLOW: i32 = 1;

pub const COLD_BRANCH: i32 = 2;

pub const COLD_INLINE: i32 = 3;

pub function cold_positions(f: SFunc, size: boolean, back: boolean): i32[] {
  let cold = cold_blocks(f);
  let out: i32[] = [];
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      let kind = COLD_NONE;
      if (cold_call(ins) || back && back_copy_call(ins)) {
        kind = COLD_SLOW;
      } else if (rc_inlined(ins)) {
        if (!size) {
          kind = COLD_INLINE;
        }
      } else if (cold[bi] && inst_is_call(ins.kind_tag) && !never_returns(ins) && !returns_call(blk, k)) {
        kind = COLD_BRANCH;
      }
      out = out.append(kind);
    }
    out = out.append(COLD_NONE);
  }
  return out;
}

pub function cold_blocks(f: SFunc): boolean[] {
  let n = f.blocks.len();
  let at = block_positions(f);
  let latch = __alloc_i32(n);
  let span = __alloc_i32(n);
  for i in 0..n {
    latch = latch.with(i, -1);
    span = span.with(i, n + 1);
  }
  for bi in 0..n {
    for which in 0..2 {
      let tgt = distinct_successor_position(at, f.blocks[bi].term, which);
      if (tgt >= 0 && tgt <= bi) {
        for k in tgt..=bi {
          if (bi - tgt < span[k]) {
            span = span.with(k, bi - tgt);
            latch = latch.with(k, bi);
          }
        }
      }
    }
  }
  let idom = immediate_dominators(f, at);
  let out = __alloc_bool(n);
  for i in 0..n {
    out = out.with(i, latch[i] >= 0 && !dominates(idom, i, latch[i]));
  }
  return out;
}

// The immediate dominator of each block position, the entry its own, or -1
// for a block the entry does not reach.
pub function immediate_dominators(f: SFunc, at: i32[]): i32[] {
  let n = f.blocks.len();
  let entry = position_of(at, f.entry);
  let idom = __alloc_i32(n);
  let po = __alloc_i32(n);
  for i in 0..n {
    idom = idom.with(i, -1);
    po = po.with(i, -1);
  }
  if (entry < 0) {
    return idom;
  }
  let order = postorder(f, at, entry);
  for i in 0..order.len() {
    po = po.with(order[i], i);
  }
  idom = idom.with(entry, entry);
  let changed = true;
  while (changed) {
    changed = false;
    let r = order.len() - 1;
    while (r >= 0) {
      let b = order[r];
      r -= 1;
      if (b == entry) {
        continue;
      }
      let pick = meet_preds(f, at, idom, po, b);
      if (pick != idom[b]) {
        idom = idom.with(b, pick);
        changed = true;
      }
    }
  }
  return idom;
}

function meet_preds(f: SFunc, at: i32[], idom: i32[], po: i32[], b: i32): i32 {
  let pick: i32 = -1;
  for pid in f.blocks[b].preds {
    let p = position_of(at, pid);
    if (p >= 0 && idom[p] >= 0) {
      if (pick < 0) {
        pick = p;
      } else {
        pick = intersect(idom, po, p, pick);
      }
    }
  }
  return pick;
}

function intersect(idom: i32[], po: i32[], a: i32, b: i32): i32 {
  while (a != b) {
    while (po[a] < po[b]) {
      a = idom[a];
    }
    while (po[b] < po[a]) {
      b = idom[b];
    }
  }
  return a;
}

function postorder(f: SFunc, at: i32[], entry: i32): i32[] {
  let seen = __alloc_bool(f.blocks.len());
  let out: i32[] = [];
  let stack = __alloc_i32(f.blocks.len());
  let next = __alloc_i32(f.blocks.len());
  stack = stack.with(0, entry);
  let depth = 1;
  seen = seen.with(entry, true);
  while (depth > 0) {
    let top = depth - 1;
    let b = stack[top];
    let which = next[top];
    if (which < 2) {
      next = next.with(top, which + 1);
      let s = distinct_successor_position(at, f.blocks[b].term, which);
      if (s >= 0 && !seen[s]) {
        seen = seen.with(s, true);
        stack = stack.with(depth, s);
        next = next.with(depth, 0);
        depth += 1;
      }
    } else {
      out = out.append(b);
      depth -= 1;
    }
  }
  return out;
}

// The block positions the entry reaches, in reverse postorder.
pub function reverse_postorder(f: SFunc, at: i32[]): i32[] {
  let entry = position_of(at, f.entry);
  if (entry < 0) {
    return [];
  }
  let order = postorder(f, at, entry);
  let out: i32[] = [];
  let i = order.len() - 1;
  while (i >= 0) {
    out = out.append(order[i]);
    i -= 1;
  }
  return out;
}

function dominates(idom: i32[], a: i32, b: i32): boolean {
  if (idom[b] < 0) {
    return false;
  }
  let x = b;
  while (x != a) {
    if (idom[x] == x) {
      return false;
    }
    x = idom[x];
  }
  return true;
}

pub function returns_call(blk: SBlock, k: i32): boolean {
  let ins = blk.insts[k];
  return k == blk.insts.len() - 1 && blk.term.kind_tag == TERM_RET && ins.result >= 0 && blk.term.value == ins.result;
}

pub function calls_out(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (calls(ins)) {
        return true;
      }
    }
  }
  return false;
}

pub function calls(ins: SInst): boolean {
  return inst_is_call(ins.kind_tag) && !rc_inlined(ins) && !never_returns(ins);
}

pub function rc_inlined(ins: SInst): boolean {
  if (ins.kind_tag != CALL || ins.args.len() != 1) {
    return false;
  }
  return ins.str == "__fern_rc_is_unique" || ins.str == "__fern_rc_inc";
}

function calls_before(calls: i32[], total_pos: i32): i32[] {
  let cum = __alloc_i32(total_pos + 2);
  let ci = 0;
  for p in 0..=total_pos + 1 {
    cum = cum.with(p, ci);
    while (ci < calls.len() && calls[ci] < p + 1) {
      ci += 1;
    }
  }
  return cum;
}

function spans_call(cum: i32[], lo: i32, hi: i32): boolean {
  if (hi <= lo + 1) {
    return false;
  }
  let a = lo + 1;
  if (a >= cum.len()) {
    return false;
  }
  let b = hi;
  if (b >= cum.len()) {
    b = cum.len() - 1;
  }
  return cum[b] - cum[a] > 0;
}

// With no saved register left, saving a caller register around the cold
// calls costs less than a spill that every iteration loads and stores.
function cold_caller(saved_free: i32, cold_integer: boolean, pick: i32, cum: i32[], lo: i32, hi: i32): boolean {
  return saved_free == 0 && cold_integer && pick >= 0 && !spans_call(cum, lo, hi);
}

// A value spans a call when it is live after one. `crossing` gives that from
// block liveness. Without it, any call inside the value's interval counts.
function hard_spans(f: SFunc, cum: i32[], cold: i32[], lo: i32[], hi: i32[], weight: i32[], crossing: boolean[]): boolean[] {
  let out = __alloc_bool(f.nvals);
  let exact = crossing.len() == f.nvals;
  if (cold.len() == 0) {
    for v in 0..f.nvals {
      out = out.with(v, if (exact) { crossing[v] } else { spans_call(cum, lo[v], hi[v]) });
    }
    return out;
  }
  let cost = cold_call_cost(f, cold);
  for v in 0..f.nvals {
    let h: boolean = if (exact) { crossing[v] } else { spans_call(cum, lo[v], hi[v]) };
    if (!h && hi[v] > lo[v] + 1 && lo[v] + 1 < cost.len()) {
      let b = hi[v];
      if (b >= cost.len()) {
        b = cost.len() - 1;
      }
      h = 2 * (cost[b] - cost[lo[v] + 1]) >= weight[v];
    }
    out = out.with(v, h);
  }
  return out;
}

function cold_call_cost(f: SFunc, cold: i32[]): i32[] {
  let bw = block_loop_weights(f);
  let out: i32[] = [0];
  let total = 0;
  let pos = 0;
  for bi in 0..f.blocks.len() {
    for k in 0..=f.blocks[bi].insts.len() {
      if (pos < cold.len() && cold[pos] == COLD_BRANCH) {
        total += bw[bi];
      }
      pos += 1;
      out = out.append(total);
    }
  }
  return out;
}

function spans_hard(hard: boolean[], integer: boolean, cum: i32[], lo: i32, hi: i32, v: i32): boolean {
  if (integer) {
    return hard[v];
  }
  return spans_call(cum, lo, hi);
}

function order_by_lo(n: i32, lo: i32[]): i32[] {
  let maxp = 0;
  let v = 0;
  while (v < n) {
    if (lo[v] < 2000000000 && lo[v] > maxp) {
      maxp = lo[v];
    }
    v += 1;
  }
  let starts = __alloc_i32(maxp + 3);
  v = 0;
  while (v < n) {
    let b = order_bucket(lo[v], maxp);
    starts = starts.with(b + 1, starts[b + 1] + 1);
    v += 1;
  }
  let b2 = 1;
  while (b2 < starts.len()) {
    starts = starts.with(b2, starts[b2] + starts[b2 - 1]);
    b2 += 1;
  }
  let out = __alloc_i32(n);
  for v in 0..n {
    let bk = order_bucket(lo[v], maxp);
    out = out.with(starts[bk], v);
    starts = starts.with(bk, starts[bk] + 1);
  }
  return out;
}

function order_bucket(lo: i32, maxp: i32): i32 {
  if (lo >= 2000000000) {
    return maxp + 1;
  }
  return lo;
}

function extend_loop_invariant_intervals(f: SFunc, def_pos: i32[], hi: i32[]): i32[] {
  let top: i32 = -1;
  for b in f.blocks {
    if (b.id > top) {
      top = b.id;
    }
  }
  let start_of = util.minus_ones(top + 1);
  let rpos = 0;
  for b in f.blocks {
    if (b.id >= 0) {
      start_of = start_of.with(b.id, rpos);
    }
    rpos = rpos + b.insts.len() + 1;
  }
  let edge_head: i32[] = [];
  let edge_end: i32[] = [];
  let lstart = 0;
  for lblk in f.blocks {
    let lterm_pos = lstart + lblk.insts.len();
    for th in 0..2 {
      let tgt: i32 = -1;
      if (th == 0) {
        if (lblk.term.kind_tag == TERM_BR) {
          tgt = lblk.term.target;
        } else if (lblk.term.kind_tag == TERM_BRIF) {
          tgt = lblk.term.t;
        }
      } else if (lblk.term.kind_tag == TERM_BRIF) {
        tgt = lblk.term.f;
      }
      if (tgt >= 0 && tgt <= top) {
        let hstart = start_of[tgt];
        if (hstart >= 0 && hstart <= lstart) {
          edge_head = edge_head.append(hstart);
          edge_end = edge_end.append(lterm_pos);
        }
      }
    }
    lstart = lterm_pos + 1;
  }
  if (edge_head.len() == 0) {
    return hi;
  }
  let heads = sorted_i32(edge_head);
  let vv = 0;
  while (vv < f.nvals && vv < hi.len()) {
    let d = def_pos[vv];
    if (d >= 0) {
      let first = first_above(heads, d);
      if (first < heads.len() && heads[first] <= hi[vv]) {
        for e in 0..edge_head.len() {
          if (d < edge_head[e] && hi[vv] >= edge_head[e] && edge_end[e] > hi[vv]) {
            hi = hi.with(vv, edge_end[e]);
          }
        }
      }
    }
    vv += 1;
  }
  return hi;
}

function sorted_i32(xs: i32[]): i32[] {
  let out: i32[] = [];
  for x in xs {
    out = out.append(x);
    let i = out.len() - 1;
    while (i > 0 && out[i - 1] > x) {
      out = out.with(i, out[i - 1]);
      i -= 1;
    }
    out = out.with(i, x);
  }
  return out;
}

function first_above(xs: i32[], v: i32): i32 {
  let lo = 0;
  let hi = xs.len();
  while (lo < hi) {
    let mid: i32 = (lo + hi) / 2;
    if (xs[mid] > v) {
      hi = mid;
    } else {
      lo = mid + 1;
    }
  }
  return lo;
}

pub function binary_fixes_abi(op: string): boolean {
  return op == "div_s" || op == "div_u" || op == "rem_s" || op == "rem_u" || op == "mulhi_u" || op == "mulhi_s";
}

function pick_caller_reg(free: i32[], abi_reg: i32, want_abi: boolean, abi_ok: boolean): i32 {
  if (free.len() == 0) {
    return -1;
  }
  if (abi_reg < 0) {
    return free[free.len() - 1];
  }
  if (want_abi) {
    for r in free {
      if (r == abi_reg) {
        return abi_reg;
      }
    }
  }
  let i = free.len() - 1;
  while (i >= 0) {
    if (free[i] != abi_reg) {
      return free[i];
    }
    i -= 1;
  }
  if (!abi_ok) {
    return -1;
  }
  return abi_reg;
}

function pick_fixed_reg(free: i32[], abi_reg: i32, want_abi: boolean, abi_ok: boolean, fixed: ssafixed.Table, lo: i32, hi: i32): i32 {
  if (ssafixed.empty(fixed)) {
    return pick_caller_reg(free, abi_reg, want_abi, abi_ok);
  }
  let take_abi = abi_ok && abi_reg >= 0 && ssafixed.allows(fixed, abi_reg, lo, hi) && index_of_reg(free, abi_reg) >= 0;
  if (want_abi && take_abi) {
    return abi_reg;
  }
  let i = free.len() - 1;
  while (i >= 0) {
    let r = free[i];
    if (r != abi_reg && ssafixed.allows(fixed, r, lo, hi)) {
      return r;
    }
    i -= 1;
  }
  if (take_abi) {
    return abi_reg;
  }
  return -1;
}

function preferred_register_allowed(reg: i32, abi: i32, abi_ok: boolean, spans: boolean, lo: i32, hi: i32, fixed: ssafixed.Table): boolean {
  return reg >= 0 && !spans && (reg != abi || abi_ok) && ssafixed.allows(fixed, reg, lo, hi);
}

function candidate(mates: Mates, def_a: i32[], def_b: i32[], v: i32, k: i32): i32 {
  return match (k) {
    0 => mates.alt[v],
    1 => mates.hint[v],
    2 => -2,
    3 => def_a[v],
    _ => def_b[v],
  };
}

function remove_reg(free: i32[], reg: i32): i32[] {
  let out: i32[] = [];
  let dropped = false;
  for r in free {
    if (r == reg && !dropped) {
      dropped = true;
    } else {
      out = out.append(r);
    }
  }
  return out;
}

function forbidden_abi(abi_reg: i32, allowed: boolean): i32 {
  if (allowed) {
    return -1;
  }
  return abi_reg;
}

function cheapest_active(act_val: i32[], act_reg: i32[], act_hi: i32[], shared_with: i32[], weight: i32[], lo: i32[], hi: i32[], now: i32, nregs: i32, need_saved: boolean, forbidden: i32, fixed: ssafixed.Table, until: i32): i32 {
  let best: i32 = -1;
  let best_w = 0;
  let best_len = 1;
  for i in 0..act_val.len() {
    if ((act_reg[i] >= nregs || !need_saved) && act_reg[i] != forbidden && ssafixed.allows(fixed, act_reg[i], now, until)) {
      let w = chain_weight(act_val[i], shared_with, weight, hi, now);
      let len = act_hi[i] - chain_lo(act_val[i], shared_with, lo, hi, now) + 1;
      let cmp = cmp_spill_cost(w, len, best_w, best_len);
      if (best < 0 || cmp < 0 || cmp == 0 && act_hi[i] > act_hi[best]) {
        best = i;
        best_w = w;
        best_len = len;
      }
    }
  }
  return best;
}

function cmp_spill_cost(w1: i32, len1: i32, w2: i32, len2: i32): i32 {
  let a = w1 as f64 * (w1 as f64) * (len2 as f64);
  let b = w2 as f64 * (w2 as f64) * (len1 as f64);
  if (a < b) {
    return -1;
  }
  if (a > b) {
    return 1;
  }
  return 0;
}

function chain_lo(v: i32, shared_with: i32[], lo: i32[], hi: i32[], now: i32): i32 {
  let m = lo[v];
  let ev = shared_with[v];
  while (ev >= 0) {
    if (still_holds(ev, hi, now) && lo[ev] < m) {
      m = lo[ev];
    }
    ev = shared_with[ev];
  }
  return m;
}

function chain_weight(v: i32, shared_with: i32[], weight: i32[], hi: i32[], now: i32): i32 {
  let w = weight[v];
  let ev = shared_with[v];
  while (ev >= 0) {
    if (still_holds(ev, hi, now)) {
      w += weight[ev];
    }
    ev = shared_with[ev];
  }
  return w;
}

function any_below(xs: i32[], x: i32): boolean {
  for e in xs {
    if (e < x) {
      return true;
    }
  }
  return false;
}

function still_holds(ev: i32, hi: i32[], now: i32): boolean {
  return hi[ev] >= now;
}

// The position of each header's last back edge, or -1.
function furthest_latches(f: SFunc): i32[] {
  let at = block_positions(f);
  let latch = util.minus_ones(f.blocks.len());
  for bi in 0..f.blocks.len() {
    for which in 0..2 {
      let tgt = distinct_successor_position(at, f.blocks[bi].term, which);
      if (tgt >= 0 && tgt <= bi && bi > latch[tgt]) {
        latch = latch.with(tgt, bi);
      }
    }
  }
  return latch;
}

// A loop is a header and the blocks up to its last back edge, so a header
// with two back edges counts once.
pub function block_loop_weights(f: SFunc): i32[] {
  let latch = furthest_latches(f);
  let depth = __alloc_i32(f.blocks.len());
  for h in 0..f.blocks.len() {
    let k = h;
    while (k <= latch[h]) {
      depth = depth.with(k, depth[k] + 1);
      k += 1;
    }
  }
  let out: i32[] = [];
  for d in depth {
    let w = 1;
    let n = 0;
    while (n < d && n < 3) {
      w *= 8;
      n += 1;
    }
    out = out.append(w);
  }
  return out;
}

function drop_active_at(a: i32[], k: i32): i32[] {
  let out: i32[] = [];
  for i in 0..a.len() {
    if (i != k) {
      out = out.append(a[i]);
    }
  }
  return out;
}

pub struct Alloc { reg_of: i32[], def_pos: i32[], lo: i32[], hi: i32[], cold: i32[] }

pub function lane_base(op: string): string {
  for k in 0..op.len() {
    if (op[k] == b':') {
      return slice_unchecked(op, 0, k).to_owned();
    }
  }
  return op;
}

pub function lane_op(op: string): boolean {
  return op.len() > 1 && op[0] == b'v' && ir.is_lane_kind(ir.kind_id(lane_base(op)));
}

pub function lane_inst(ins: SInst): boolean {
  let k = ins.kind_tag;
  return (k == BINARY || k == UNARY || k == LANE3 || k == LANE_STORE) && lane_op(ins.str);
}

pub function lane_param(f: SFunc, p: i32): boolean {
  if (f.blocks.len() == 0) {
    return false;
  }
  for ins in f.blocks[0].insts {
    if (ins.kind_tag == PARAM && ins.imm == p) {
      return ins.str == lane_param_mark();
    }
  }
  return false;
}

pub function lane_param_mark(): string {
  return "v128";
}

pub function lane_memory(b: string): boolean {
  return util.has_str(["vload", "vload_f32", "vstore", "vget", "vset"], b);
}

pub function lane_result(ins: SInst): boolean {
  if (ins.kind_tag == PARAM && ins.str == lane_param_mark() || ins.kind_tag == CALL && ins.imm == 6) {
    return true;
  }
  if (!lane_inst(ins)) {
    return false;
  }
  let b = lane_base(ins.str);
  return b != "vextract" && b != "vextract_bits" && b != "vbitmask" && b != "vstore" && b != "vset" && b != "viextracts" && b != "viextractu" && b != "vibitmask";
}

pub function lane_values(f: SFunc): boolean[] {
  let lanes = lane_results(f);
  if (lanes.len() == 0) {
    return [];
  }
  return lane_carriers(f, lanes);
}

function lane_results(f: SFunc): boolean[] {
  let lanes: boolean[] = [];
  for blk in f.blocks {
    for ins in blk.insts {
      let k = ins.kind_tag;
      let maybe = k == PARAM || k == CALL && ins.imm == 6 || (k == BINARY || k == UNARY || k == LANE3 || k == LANE_STORE) && ins.str.len() > 1 && ins.str[0] == b'v';
      if (maybe && ins.result >= 0 && ins.result < f.nvals && lane_result(ins)) {
        if (lanes.len() == 0) {
          lanes = __alloc_bool(f.nvals);
        }
        lanes = lanes.with(ins.result, true);
      }
    }
  }
  return lanes;
}

function lane_carriers(f: SFunc, lanes: boolean[]): boolean[] {
  let changed = true;
  while (changed) {
    changed = false;
    for blk in f.blocks {
      for ins in blk.insts {
        if ((ins.kind_tag == PHI || ins.kind_tag == COPY) && ins.result >= 0 && !lanes[ins.result] && phi_joins_lane(ins, lanes)) {
          lanes = lanes.with(ins.result, true);
          changed = true;
        }
      }
    }
  }
  return lanes;
}

function phi_joins_lane(ins: SInst, lanes: boolean[]): boolean {
  for a in ins.args {
    if (a >= 0 && a < lanes.len() && lanes[a]) {
      return true;
    }
  }
  return false;
}

pub function has_lanes(f: SFunc): boolean {
  return lane_values(f).len() > 0;
}

pub function float_values(f: SFunc, fcalls: boolean[], tolerant: boolean): boolean[] {
  let fl = __alloc_bool(f.nvals);
  let derived = __alloc_bool(f.nvals);
  let seeded = false;
  for blk in f.blocks {
    for ins in blk.insts {
      let fcall = ins.kind_tag == CALL && ins.result >= 0 && ins.result < fcalls.len() && fcalls[ins.result];
      if (ins.result >= 0 && ins.result < f.nvals && (float_def(ins) || fcall)) {
        let d = ins.kind_tag == PARAM || ins.kind_tag == PHI || ins.kind_tag == CALL || float_load(ins);
        fl = fl.with(ins.result, true);
        derived = derived.with(ins.result, d);
        seeded = seeded || !d;
      }
      seeded = seeded || float_use(ins);
    }
  }
  if (!seeded) {
    return with_lanes(f, __alloc_bool(f.nvals));
  }
  let changed = true;
  while (changed) {
    changed = false;
    let strong = float_strong(f, fl, derived);
    for blk in f.blocks {
      for ins in blk.insts {
        let keeps = float_use(ins) || ins.kind_tag == PHI && fl[ins.result] || tolerant && float_tolerant(ins);
        for a in ins.args {
          if (!keeps && a >= 0 && a < f.nvals && fl[a]) {
            fl = fl.with(a, false);
            changed = true;
          }
        }
      }
      let t = blk.term;
      if (t.kind_tag == TERM_BRIF && t.cond >= 0 && t.cond < f.nvals && fl[t.cond]) {
        fl = fl.with(t.cond, false);
        changed = true;
      }
    }
    for v in 0..f.nvals {
      if (fl[v] && derived[v] && !strong[v]) {
        fl = fl.with(v, false);
        changed = true;
      }
    }
  }
  return with_lanes(f, fl);
}

function with_lanes(f: SFunc, fl: boolean[]): boolean[] {
  let lanes = lane_values(f);
  for v in 0..lanes.len() {
    if (lanes[v]) {
      fl = fl.with(v, true);
    }
  }
  for x in fl {
    if (x) {
      return fl;
    }
  }
  return [];
}

function float_strong(f: SFunc, fl: boolean[], derived: boolean[]): boolean[] {
  let strong = __alloc_bool(f.nvals);
  let changed = true;
  while (changed) {
    changed = false;
    for blk in f.blocks {
      for ins in blk.insts {
        let fop = float_use(ins) || ins.kind_tag == PHI && fl[ins.result] && strong[ins.result];
        for a in ins.args {
          if (fop && a >= 0 && a < f.nvals && fl[a] && !strong[a]) {
            strong = strong.with(a, true);
            changed = true;
          }
        }
        if (ins.kind_tag == PHI && ins.result >= 0 && fl[ins.result] && !strong[ins.result]) {
          for a in ins.args {
            if (a >= 0 && a < f.nvals && fl[a] && (!derived[a] || strong[a]) && !strong[ins.result]) {
              strong = strong.with(ins.result, true);
              changed = true;
            }
          }
        }
      }
    }
  }
  return strong;
}

function float_tolerant(ins: SInst): boolean {
  return ins.kind_tag == CALL && !rc_inlined(ins);
}

function float_def(ins: SInst): boolean {
  let k = ins.kind_tag;
  if (k == CONST_FLOAT || k == PARAM || k == PHI || float_load(ins)) {
    return true;
  }
  if (k == BINARY) {
    return float_arith(ins.str);
  }
  if (k == UNARY) {
    return float_math(ins.str) || ins.str.starts_with("i32_to_f64:") || ins.str == "f64_from_bits" || lane_base(ins.str) == "vextract";
  }
  return false;
}

function float_load(ins: SInst): boolean {
  return ins.kind_tag == LD_AT || ins.kind_tag == ARR_AT && ins.str != "u8";
}

function float_use(ins: SInst): boolean {
  let k = ins.kind_tag;
  if (k == BINARY) {
    return float_arith(ins.str) || float_cmp(ins.str);
  }
  if (k == UNARY) {
    return float_math(ins.str) || ins.str == "f64_to_i32" || ins.str == "f64_to_i64" || ins.str == "f64_bits" || ins.str == "vsplat";
  }
  return false;
}

pub function float_arith(op: string): boolean {
  return op == "fadd" || op == "fsub" || op == "fmul" || op == "fdiv";
}

pub function float_cmp(op: string): boolean {
  return op == "feq" || op == "fne" || op == "flt" || op == "fle" || op == "fgt" || op == "fge";
}

pub function float_math(op: string): boolean {
  return op == "fsqrt" || op == "ffloor" || op == "fceil" || op == "ftrunc" || op == "fabs" || op == "fround" || op == "fneg";
}

function class_order(order: i32[], fl: boolean[]): i32[] {
  let out: i32[] = [];
  for v in order {
    if (!fl[v]) {
      out = out.append(v);
    }
  }
  for v in order {
    if (fl[v]) {
      out = out.append(v);
    }
  }
  return out;
}

function count_false(fl: boolean[]): i32 {
  let n = 0;
  for x in fl {
    if (!x) {
      n += 1;
    }
  }
  return n;
}

pub function regalloc_linear(f: SFunc, nregs: i32, nsaved: i32, abi_reg: i32, abi_fixed_by_div: boolean, no_home: boolean[], pref: i32[], fl: boolean[], nf: i32, nfs: i32): Alloc {
  return regalloc_linear_fixed(f, nregs, nsaved, abi_reg, abi_fixed_by_div, no_home, pref, fl, nf, nfs, ssafixed.none(), [], []);
}

// The call still runs when its result has no reader. Its result needs no
// register or spill slot, and cannot prevent another value from taking one.
function unhomed_call_results(f: SFunc, own no_home: boolean[]): boolean[] {
  while (no_home.len() < f.nvals) {
    no_home = no_home.append(false);
  }
  let uses = use_counts(f);
  for b in f.blocks {
    for ins in b.insts {
      if (inst_is_call(ins.kind_tag) && ins.result >= 0 && uses[ins.result] == 0) {
        no_home = no_home.with(ins.result, true);
      }
    }
  }
  return no_home;
}

pub function regalloc_linear_fixed(f: SFunc, nregs: i32, nsaved: i32, abi_reg: i32, abi_fixed_by_div: boolean, no_home: boolean[], pref: i32[], fl: boolean[], nf: i32, nfs: i32, fixed: ssafixed.Table, cold: i32[], crossing: boolean[]): Alloc {
  return regalloc_linear_fixed_costs(f, nregs, nsaved, abi_reg, abi_fixed_by_div, no_home, pref, fl, nf, nfs, fixed, cold, crossing, SpillCosts { fold_alu_rhs: false });
}

// A spill definition or normal read needs an extra transfer instruction.
// An x86 ALU instruction can read a right operand from its spill slot.
// The model discounts those reads and keeps the squared-use protection.
pub struct SpillCosts { fold_alu_rhs: boolean }

pub function regalloc_linear_fixed_costs(f: SFunc, nregs: i32, nsaved: i32, abi_reg: i32, abi_fixed_by_div: boolean, no_home: boolean[], pref: i32[], fl: boolean[], nf: i32, nfs: i32, fixed: ssafixed.Table, cold: i32[], crossing: boolean[], costs: SpillCosts): Alloc {
  no_home = unhomed_call_results(f, no_home);
  let cold_calls = cold.len() > 0;
  let wish = return_prefs(f, pref, abi_reg);
  let big = 2000000000;
  let lo = __alloc_i32(f.nvals);
  let hi = __alloc_i32(f.nvals);
  let i = 0;
  while (i < f.nvals) {
    lo = lo.with(i, big);
    hi = hi.with(i, -1);
    i += 1;
  }
  let calls: i32[] = [];
  let all_calls: i32[] = [];
  let soft_calls: i32[] = [];
  let abi_cl: i32[] = [];

  let def_pos = __alloc_i32(f.nvals);
  let def_blk = __alloc_i32(f.nvals);
  let call_def = __alloc_i32(f.nvals);
  let reads_mate = __alloc_bool(f.nvals);
  let def_a = __alloc_i32(f.nvals);
  let def_b = __alloc_i32(f.nvals);
  i = 0;
  while (i < f.nvals) {
    def_pos = def_pos.with(i, -1);
    def_blk = def_blk.with(i, -1);
    def_a = def_a.with(i, -1);
    def_b = def_b.with(i, -1);
    i += 1;
  }
  let blk_start: i32[] = [];
  let pos = 0;
  let bi = 0;
  while (bi < f.blocks.len()) {
    let blk = f.blocks[bi];
    blk_start = blk_start.append(pos);
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      if (ins.result >= 0 && ins.result < lo.len() && pos < lo[ins.result]) {
        lo = lo.with(ins.result, pos);
      }
      if (ins.result >= 0 && ins.result < hi.len() && pos > hi[ins.result]) {
        hi = hi.with(ins.result, pos);
      }
      if (ins.result >= 0 && ins.result < def_pos.len()) {
        def_pos = def_pos.with(ins.result, pos);
        def_blk = def_blk.with(ins.result, bi);
        if (ins.kind_tag == SELECT) {
          reads_mate = reads_mate.with(ins.result, true);
          def_a = def_a.with(ins.result, ins.args[1]);
          def_b = def_b.with(ins.result, ins.args[2]);
        } else if (ins.kind_tag == PHI || ins.kind_tag == UNARY || ins.kind_tag == CALL || ins.kind_tag == CALL_IND || ins.kind_tag == DYN_DISPATCH || ins.kind_tag == BINARY && shares_operand_home(ins.str)) {
          reads_mate = reads_mate.with(ins.result, true);
          if (ins.kind_tag != PHI && ins.args.len() > 0) {
            def_a = def_a.with(ins.result, ins.args[0]);
          }
          if (ins.kind_tag != PHI && ins.args.len() > 1) {
            def_b = def_b.with(ins.result, ins.args[1]);
          }
        }
      }
      let a = 0;
      while (a < ins.args.len() && ins.kind_tag != PHI) {
        if (ins.args[a] >= 0 && ins.args[a] < lo.len() && pos < lo[ins.args[a]]) {
          lo = lo.with(ins.args[a], pos);
        }
        if (ins.args[a] >= 0 && ins.args[a] < hi.len() && pos > hi[ins.args[a]]) {
          hi = hi.with(ins.args[a], pos);
        }
        a += 1;
      }
      if (inst_is_call(ins.kind_tag) && !never_returns(ins)) {
        if (counted_call(blk, k)) {
          all_calls = all_calls.append(pos);
          let kind = COLD_NONE;
          if (cold_calls) {
            kind = cold[pos];
          }
          if (kind == COLD_NONE) {
            calls = calls.append(pos);
          } else if (kind == COLD_BRANCH) {
            soft_calls = soft_calls.append(pos);
          }
        }
        if (ins.result >= 0 && ins.result < call_def.len()) {
          call_def = call_def.with(ins.result, 1);
        }
      }
      if (abi_fixed_by_div && ins.kind_tag == BINARY && binary_fixes_abi(ins.str)) {
        abi_cl = abi_cl.append(pos);
      }
      pos += 1;
    }
    if (blk.term.kind_tag == TERM_RET) {
      if (blk.term.value >= 0 && blk.term.value < lo.len() && pos < lo[blk.term.value]) {
        lo = lo.with(blk.term.value, pos);
      }
      if (blk.term.value >= 0 && blk.term.value < hi.len() && pos > hi[blk.term.value]) {
        hi = hi.with(blk.term.value, pos);
      }
    } else if (blk.term.kind_tag == TERM_BRIF) {
      if (blk.term.cond >= 0 && blk.term.cond < lo.len() && pos < lo[blk.term.cond]) {
        lo = lo.with(blk.term.cond, pos);
      }
      if (blk.term.cond >= 0 && blk.term.cond < hi.len() && pos > hi[blk.term.cond]) {
        hi = hi.with(blk.term.cond, pos);
      }
    }
    pos += 1;
    bi += 1;
  }
  i = 0;
  while (i < f.nparams && i < f.nvals) {
    if (hi[i] >= 0) {
      lo = lo.with(i, 0);
    }
    i += 1;
  }
  let total_pos = pos;
  ssafixed.validate(fixed, nregs, total_pos);
  let at = block_positions(f);
  for bi in 0..f.blocks.len() {
    let pb = f.blocks[bi];
    for pk in 0..pb.insts.len() {
      let ph = pb.insts[pk];
      if (ph.kind_tag == PHI) {
        for sl in 0..ph.args.len() {
          let upos = blk_start[bi] + pk;
          if (sl < pb.preds.len() && pb.preds[sl] >= 0 && pb.preds[sl] < at.len() && at[pb.preds[sl]] >= 0) {
            let pi = at[pb.preds[sl]];
            upos = blk_start[pi] + f.blocks[pi].insts.len();
          }
          let pa = ph.args[sl];
          if (pa >= 0 && pa < lo.len() && upos < lo[pa]) {
            lo = lo.with(pa, upos);
          }
          if (pa >= 0 && pa < hi.len() && upos > hi[pa]) {
            hi = hi.with(pa, upos);
          }
        }
      }
    }
  }
  i = 0;
  while (i < no_home.len() && i < f.nvals) {
    if (no_home[i]) {
      hi = hi.with(i, -1);
    }
    i += 1;
  }

  hi = extend_loop_invariant_intervals(f, def_pos, hi);
  let cum = calls_before(calls, total_pos);
  let cum_abi = calls_before(abi_cl, total_pos);
  let cum_all = cum;
  let cum_soft = calls_before(soft_calls, total_pos);
  if (cold_calls) {
    cum_all = calls_before(all_calls, total_pos);
  }
  let mates = phi_mates(f, at, def_pos, hi, no_home);
  let weight = spill_weights(f, at, costs);
  let hard = hard_spans(f, cum, cold, lo, hi, weight, crossing);
  let sole = sole_readers(f);

  let sites = ReadSites { start: [], blk: [], pos: [], succ_a: [], succ_b: [], phi_end: [] };
  let phi_side: boolean[] = [];
  let reg_of = __alloc_i32(f.nvals);
  let shared_with = __alloc_i32(f.nvals);
  for i in 0..f.nvals {
    reg_of = reg_of.with(i, -1);
    shared_with = shared_with.with(i, -1);
  }

  let order = order_by_lo(f.nvals, lo);
  let split = order.len();
  if (fl.len() > 0) {
    order = class_order(order, fl);
    split = count_false(fl);
  }
  let act_val: i32[] = [];
  let act_hi: i32[] = [];
  let act_reg: i32[] = [];
  let free: i32[] = [];
  let r = nregs - 1;
  while (r >= 0) {
    free = free.append(r);
    r -= 1;
  }
  let free_s: i32[] = [];
  r = nregs + nsaved - 1;
  while (r >= nregs) {
    free_s = free_s.append(r);
    r -= 1;
  }

  let cbase = 0;
  let sat = nregs;
  let cabi = abi_reg;
  let oi = 0;
  while (oi < order.len()) {
    if (oi == split) {
      cum = cum_all;
      cbase = nregs + nsaved;
      sat = cbase + nf;
      cabi = -1;
      act_val = [];
      act_hi = [];
      act_reg = [];
      free = [];
      r = sat - 1;
      while (r >= cbase) {
        free = free.append(r);
        r -= 1;
      }
      free_s = [];
      r = sat + nfs - 1;
      while (r >= sat) {
        free_s = free_s.append(r);
        r -= 1;
      }
    }
    let v = order[oi];
    if (hi[v] < 0) {
      oi += 1;
      continue;
    }
    if (any_below(act_hi, lo[v])) {
      let nv: i32[] = [];
      let nh: i32[] = [];
      let nr: i32[] = [];
      for ai in 0..act_val.len() {
        if (act_hi[ai] < lo[v]) {
          if (act_reg[ai] >= sat) {
            free_s = free_s.append(act_reg[ai]);
          } else {
            free = free.append(act_reg[ai]);
          }
        } else {
          nv = nv.append(act_val[ai]);
          nh = nh.append(act_hi[ai]);
          nr = nr.append(act_reg[ai]);
        }
      }
      act_val = nv;
      act_hi = nh;
      act_reg = nr;
    }

    let mh = mates.hint[v];
    if (mh >= 0 && sole[v] == mh && lo[mh] <= lo[v] && hi[mh] >= 0 && reg_of[mh] == -1) {
      sites = cached_read_sites(f, sites, at, blk_start);
      if (!live_at_def(sites, mh, v, def_blk, def_pos)) {
        oi += 1;
        continue;
      }
    }
    if (mh >= 0 && mates.through[v] && reg_of[mh] == -1 && hi[mh] < lo[v] && !(cold_calls && weight[v] > 4 * weight[mh])) {
      oi += 1;
      continue;
    }
    let ma = mates.alt[v];
    if (ma >= 0 && reg_of[ma] == -1 && lo[ma] <= lo[v] && hi[ma] >= 0) {
      sites = cached_read_sites(f, sites, at, blk_start);
      if (!live_at_def(sites, ma, v, def_blk, def_pos)) {
        oi += 1;
        continue;
      }
    }
    let abi_ok = !spans_call(cum_abi, lo[v], hi[v]);
    let soft = cold_calls && oi < split && spans_call(cum_soft, lo[v], hi[v]) && free_s.len() > 0;
    let keep_caller = spans_hard(hard, oi < split, cum, lo[v], hi[v], v) || soft;
    let placed = false;
    let ci = 0;
    while (ci < 5 && !placed) {
      let h = candidate(mates, def_a, def_b, v, ci);
      ci += 1;
      if (ci == 1 && h == mates.hint[v]) {
        continue;
      }
      if (h == -2) {
        let pr: i32 = -1;
        if (v < wish.len()) {
          pr = wish[v];
        }
        if (!preferred_register_allowed(pr, abi_reg, abi_ok, keep_caller, lo[v], hi[v], fixed)) {
          continue;
        }
        if (index_of_reg(free, pr) >= 0) {
          free = remove_reg(free, pr);
          reg_of = reg_of.with(v, pr);
          act_val = act_val.append(v);
          act_hi = act_hi.append(hi[v]);
          act_reg = act_reg.append(pr);
          placed = true;
          continue;
        }
        let held = index_of_reg(act_reg, pr);
        if (held < 0) {
          continue;
        }
        h = act_val[held];
      }
      if (h < 0 || reg_of[h] < 0) {
        continue;
      }
      let hr = reg_of[h];
      if (call_def[v] == 1 && h != mates.hint[v] && hr != abi_reg) {
        continue;
      }
      if (hr < cbase || keep_caller && hr < sat || hr == cabi && !abi_ok || !ssafixed.allows(fixed, hr, lo[v], hi[v])) {
        continue;
      }
      let fi = index_of_reg(free, hr);
      let fsi = index_of_reg(free_s, hr);
      if (fi >= 0 || fsi >= 0) {
        if (fi >= 0) {
          free = remove_reg(free, hr);
        } else {
          free_s = remove_reg(free_s, hr);
        }
        reg_of = reg_of.with(v, hr);
        shared_with = shared_with.with(v, h);
        act_val = act_val.append(v);
        act_hi = act_hi.append(hi[v]);
        act_reg = act_reg.append(hr);
        placed = true;
        continue;
      }
      let ha = index_of_reg(act_reg, hr);
      if (ha < 0) {
        continue;
      }
      let share = act_hi[ha] == lo[v] && reads_mate[v];
      if (!share && (h == mates.hint[v] && mates.carried[v] || h == mates.alt[v])) {
        sites = cached_read_sites(f, sites, at, blk_start);
        share = chain_dead_at_def(sites, act_val[ha], v, shared_with, lo, hi, def_blk, def_pos);
      }
      if (!share) {
        continue;
      }
      let top = later_interval_end(act_hi[ha], hi[v]);
      let holder = act_val[ha];
      act_val = drop_active_at(act_val, ha);
      act_hi = drop_active_at(act_hi, ha);
      act_reg = drop_active_at(act_reg, ha);
      reg_of = reg_of.with(v, hr);
      shared_with = shared_with.with(v, holder);
      act_val = act_val.append(v);
      act_hi = act_hi.append(top);
      act_reg = act_reg.append(hr);
      placed = true;
    }
    if (placed) {
      oi += 1;
      continue;
    }
    let pick = pick_fixed_reg(free, cabi, call_def[v] == 1 && abi_ok, abi_ok, fixed, lo[v], hi[v]);
    let from_caller = !spans_hard(hard, oi < split, cum, lo[v], hi[v], v) && pick >= 0 && !soft;
    from_caller = from_caller || cold_caller(free_s.len(), cold_calls && oi < split, pick, cum, lo[v], hi[v]);
    // A save around a call restores its holder, so a lent interval holds none.
    if (!from_caller && oi < split && !keep_caller && !spans_call(cum_all, lo[v] - 1, hi[v] + 1)) {
      sites = cached_read_sites(f, sites, at, blk_start);
      if (phi_side.len() == 0) {
        phi_side = phi_values(f);
      }
      if let Some(lend) = borrowable(sites, v, act_val, act_reg, Lender { cbase: cbase, sat: sat, cabi: cabi, abi_ok: abi_ok, reads: defining_args(f, v, def_blk, def_pos, blk_start), phi: phi_side }, fixed, shared_with, lo, hi, def_blk, def_pos) {
        let top = later_interval_end(act_hi[lend], hi[v]);
        let lent = act_reg[lend];
        let holder = act_val[lend];
        act_val = drop_active_at(act_val, lend);
        act_hi = drop_active_at(act_hi, lend);
        act_reg = drop_active_at(act_reg, lend);
        reg_of = reg_of.with(v, lent);
        shared_with = shared_with.with(v, holder);
        act_val = act_val.append(v);
        act_hi = act_hi.append(top);
        act_reg = act_reg.append(lent);
        oi += 1;
        continue;
      }
    }
    if (!from_caller && free_s.len() == 0) {
      let need_saved = spans_hard(hard, oi < split, cum, lo[v], hi[v], v);
      let fa = cheapest_active(act_val, act_reg, act_hi, shared_with, weight, lo, hi, lo[v], sat, need_saved, forbidden_abi(cabi, abi_ok), fixed, hi[v]);
      let cmp = 0;
      if (fa >= 0) {
        let fw = chain_weight(act_val[fa], shared_with, weight, hi, lo[v]);
        cmp = cmp_spill_cost(fw, act_hi[fa] - chain_lo(act_val[fa], shared_with, lo, hi, lo[v]) + 1, weight[v], hi[v] - lo[v] + 1);
      }
      if (fa >= 0 && (cmp < 0 || cmp == 0 && act_hi[fa] > hi[v])) {
        let taken = act_reg[fa];
        let ev = act_val[fa];
        let first = true;
        while (ev >= 0) {
          if (first || still_holds(ev, hi, lo[v])) {
            reg_of = reg_of.with(ev, -1);
          }
          first = false;
          let nx = shared_with[ev];
          shared_with = shared_with.with(ev, -1);
          ev = nx;
        }
        act_val = drop_active_at(act_val, fa);
        act_hi = drop_active_at(act_hi, fa);
        act_reg = drop_active_at(act_reg, fa);
        reg_of = reg_of.with(v, taken);
        act_val = act_val.append(v);
        act_hi = act_hi.append(hi[v]);
        act_reg = act_reg.append(taken);
      } else {
        reg_of = reg_of.with(v, -1);
      }
    } else {
      let reg = 0;
      if (from_caller) {
        reg = pick;
        free = remove_reg(free, reg);
      } else {
        reg = free_s[free_s.len() - 1];
        free_s = util.drop_last_i32(free_s);
      }
      reg_of = reg_of.with(v, reg);
      act_val = act_val.append(v);
      act_hi = act_hi.append(hi[v]);
      act_reg = act_reg.append(reg);
    }
    oi += 1;
  }
  if (nfs > 0) {
    reg_of = lanes_off_saved(f, reg_of, nregs + nsaved + nf);
  }
  let shape = SlotShape { at: at, blk_start: blk_start, def_blk: def_blk, def_pos: def_pos, def_a: def_a, def_b: def_b };
  if (sites.start.len() == 0 && spilled_mates(reg_of, def_pos, mates.hint)) {
    sites = read_sites(f, at, blk_start);
  }
  return Alloc { reg_of: assign_spill_slots(f, shape, lo, hi, reg_of, slot_hints(f, sites, def_blk, def_pos, reg_of, mates), sites), def_pos: def_pos, lo: lo, hi: hi, cold: cold };
}

function lanes_off_saved(f: SFunc, reg_of: i32[], saved_from: i32): i32[] {
  let lanes = lane_values(f);
  for v in 0..lanes.len() {
    if (lanes[v] && reg_of[v] >= saved_from) {
      reg_of = reg_of.with(v, -1);
    }
  }
  return reg_of;
}

struct SlotHints { hint: i32[], take_over: boolean[] }

function slot_hints(f: SFunc, sites: ReadSites, def_blk: i32[], def_pos: i32[], reg_of: i32[], mates: Mates): SlotHints {
  let hint: i32[] = [];
  let take_over: boolean[] = [];
  for i in 0..f.nvals {
    let sh = mates.hint[i];
    if (reg_of[i] >= 0 || sh < 0 || reg_of[sh] >= 0) {
      sh = -1;
    }
    let free = sh >= 0 && def_pos[sh] >= 0 && !live_at_def(sites, sh, i, def_blk, def_pos);
    if (sh >= 0 && mates.carried[i] && !free) {
      sh = -1;
    }
    hint = hint.append(sh);
    take_over = take_over.append(free);
  }
  return SlotHints { hint: hint, take_over: take_over };
}

function spilled_mates(reg_of: i32[], def_pos: i32[], hint: i32[]): boolean {
  for i in 0..reg_of.len() {
    let sh = hint[i];
    if (reg_of[i] < 0 && sh >= 0 && reg_of[sh] < 0 && def_pos[sh] >= 0) {
      return true;
    }
  }
  return false;
}

function return_prefs(f: SFunc, pref: i32[], abi_reg: i32): i32[] {
  let out = pref;
  while (out.len() < f.nvals) {
    out = out.append(-1);
  }
  for blk in f.blocks {
    let v = blk.term.value;
    if (blk.term.kind_tag == TERM_RET && v >= 0 && v < out.len() && out[v] < 0) {
      out = out.with(v, abi_reg);
    }
  }
  let bi = f.blocks.len() - 1;
  while (bi >= 0) {
    for ins in f.blocks[bi].insts {
      if (ins.kind_tag == PHI && ins.result >= 0 && ins.result < out.len() && out[ins.result] >= 0) {
        for a in ins.args {
          if (a >= 0 && a < out.len() && out[a] < 0) {
            out = out.with(a, out[ins.result]);
          }
        }
      }
    }
    bi -= 1;
  }
  return out;
}

function sole_readers(f: SFunc): i32[] {
  let out = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      for a in ins.args {
        if (a >= 0 && a < f.nvals && out[a] != ins.result) {
          if (out[a] == -1 && ins.result >= 0) {
            out = out.with(a, ins.result);
          } else {
            out = out.with(a, -2);
          }
        }
      }
    }
    let tv: i32 = -1;
    if (blk.term.kind_tag == TERM_RET) {
      tv = blk.term.value;
    }
    if (blk.term.kind_tag == TERM_BRIF) {
      tv = blk.term.cond;
    }
    if (tv >= 0 && tv < f.nvals) {
      out = out.with(tv, -2);
    }
  }
  return out;
}

function spill_weights(f: SFunc, at: i32[], costs: SpillCosts): i32[] {
  let bw = block_loop_weights(f);
  let w = __alloc_i32(f.nvals);
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals) {
        w = w.with(ins.result, w[ins.result] + bw[bi]);
      }
      for sl in 0..ins.args.len() {
        let a = ins.args[sl];
        let rb = bi;
        if (ins.kind_tag == PHI) {
          rb = -1;
          if (sl < blk.preds.len()) {
            rb = position_of(at, blk.preds[sl]);
          }
        }
        if (a >= 0 && a < f.nvals && rb >= 0) {
          let cost = 1;
          if (costs.fold_alu_rhs && ins.kind_tag == BINARY && sl == 1 && folds_spill_rhs(ins.str)) {
            cost = 0;
          }
          w = w.with(a, w[a] + bw[rb] * cost);
        }
      }
    }
    let tv: i32 = -1;
    if (blk.term.kind_tag == TERM_RET) {
      tv = blk.term.value;
    }
    if (blk.term.kind_tag == TERM_BRIF) {
      tv = blk.term.cond;
    }
    if (tv >= 0 && tv < f.nvals) {
      w = w.with(tv, w[tv] + bw[bi]);
    }
  }
  return w;
}

function folds_spill_rhs(op: string): boolean {
  return op == "add" || op == "sub" || op == "and" || op == "or" || op == "xor";
}

function kept_for_mate(wanted_by: i32[], reg_of: i32[], holder: i32, v: i32): boolean {
  let w = wanted_by[holder];
  return w >= 0 && w != v && reg_of[w] == -1;
}

pub function spill_code(slot: i32): i32 {
  return -2 - slot;
}

pub function spill_slot(code: i32): i32 {
  return -2 - code;
}

// One line per value with a home: its interval, its spill weight and the
// register index or frame slot it took. FERN_SSA_ALLOC=<function> prints it.
pub function print_alloc(f: SFunc, a: Alloc): string {
  return print_alloc_costs(f, a, SpillCosts { fold_alu_rhs: false });
}

pub function print_alloc_costs(f: SFunc, a: Alloc, costs: SpillCosts): string {
  let w = spill_weights(f, block_positions(f), costs);
  let cold = cold_blocks(f);
  let out = "";
  let start = 0;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    out = out + "  block " + util.i32_to_string(bi) + " id " + util.i32_to_string(blk.id) + " at " + util.i32_to_string(start);
    if (cold[bi]) {
      out += " cold";
    }
    out += "\n";
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      if (inst_is_call(ins.kind_tag)) {
        let kind = COLD_NONE;
        if (start + k < a.cold.len()) {
          kind = a.cold[start + k];
        }
        out = out + "    " + util.i32_to_string(start + k) + ": v" + util.i32_to_string(ins.result) + " " + ins.str + " cold=" + util.i32_to_string(kind) + "\n";
      }
    }
    start = start + blk.insts.len() + 1;
  }
  for v in 0..a.reg_of.len() {
    if (a.hi[v] < 0) {
      continue;
    }
    let home = "reg " + util.i32_to_string(a.reg_of[v]);
    if (a.reg_of[v] == -1) {
      home = "none";
    }
    if (a.reg_of[v] < -1) {
      home = "slot " + util.i32_to_string(spill_slot(a.reg_of[v]));
    }
    out = out + "  v" + util.i32_to_string(v) + " [" + util.i32_to_string(a.lo[v]) + ", " + util.i32_to_string(a.hi[v]) + "] w=" + util.i32_to_string(w[v]) + " " + home + "\n";
  }
  return out;
}

pub function spill_count(reg_of: i32[]): i32 {
  let n = 0;
  for h in reg_of {
    if (h < -1 && spill_slot(h) + 1 > n) {
      n = spill_slot(h) + 1;
    }
  }
  return n;
}

function shares_operand_home(op: string): boolean {
  return int_binary(op);
}

function int_binary(op: string): boolean {
  let ops: string[] = ["add", "sub", "mul", "and", "and_not", "or", "xor", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u", "shl", "shr_s", "shr_u"];
  for o in ops {
    if (o == op) {
      return true;
    }
  }
  return false;
}

struct Mates { hint: i32[], carried: boolean[], alt: i32[], through: boolean[] }

function phi_mates(f: SFunc, at: i32[], def_pos: i32[], hi: i32[], no_home: boolean[]): Mates {
  let hint = util.minus_ones(f.nvals);
  let carried = __alloc_bool(f.nvals);
  let alt = hint;
  let fell = carried;
  let pos = 0;
  let bi = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == PHI && ins.result >= 0 && ins.result < hint.len()) {
        let dying: i32 = -1;
        let outliving: i32 = -1;
        let through: i32 = -1;
        let ai = 0;
        while (ai < ins.args.len()) {
          let a = ins.args[ai];
          ai += 1;
          if (a < 0 || a >= hint.len() || a < no_home.len() && no_home[a]) {
            continue;
          }
          if (def_pos[a] < pos) {
            if (hint[ins.result] < 0) {
              hint = hint.with(ins.result, a);
            }
            if (dying < 0 && hi[a] < pos) {
              dying = a;
            }
            if (hi[a] < pos && ai - 1 < blk.preds.len() && position_of(at, blk.preds[ai - 1]) == bi - 1) {
              through = a;
            }
            if (outliving < 0 && hi[a] >= pos) {
              outliving = a;
            }
          } else if (hint[a] < 0) {
            hint = hint.with(a, ins.result);
            carried = carried.with(a, true);
          }
        }
        let h = hint[ins.result];
        if (dying >= 0 && !carried[ins.result] && h >= 0 && hi[h] >= pos) {
          hint = hint.with(ins.result, dying);
        }
        if (through >= 0 && !carried[ins.result]) {
          hint = hint.with(ins.result, through);
          fell = fell.with(ins.result, true);
        }
        if (!carried[ins.result]) {
          alt = alt.with(ins.result, outliving);
        }
      }
      pos += 1;
    }
    pos += 1;
    bi += 1;
  }
  return Mates { hint: hint, carried: carried, alt: alt, through: fell };
}

// live_masks gives, for each position of `at` in ascending order, the
// registers below `nregs` that hold a value live across it. The mask at
// `at[k]` leaves out the value `skip[k]`.
pub function live_masks(alloc: Alloc, nregs: i32, at: i32[], skip: i32[]): i32[] {
  let masks = __alloc_i32(at.len());
  if (at.len() == 0) {
    return masks;
  }
  let order = order_by_lo(alloc.reg_of.len(), alloc.lo);
  let active = __alloc_i32(order.len());
  let na = 0;
  let next = 0;
  for k in 0..at.len() {
    let p = at[k];
    while (next < order.len() && alloc.lo[order[next]] < p) {
      let v = order[next];
      let r = alloc.reg_of[v];
      if (r >= 0 && r < nregs) {
        active = active.with(na, v);
        na += 1;
      }
      next += 1;
    }
    let mask = 0;
    let kept = 0;
    for j in 0..na {
      let v = active[j];
      if (alloc.hi[v] > p) {
        active = active.with(kept, v);
        kept += 1;
        if (v != skip[k]) {
          mask = mask | 1 << alloc.reg_of[v];
        }
      }
    }
    na = kept;
    masks = masks.with(k, mask);
  }
  return masks;
}

pub function position_count(f: SFunc): i32 {
  let n = 0;
  for blk in f.blocks {
    n = n + blk.insts.len() + 1;
  }
  return n;
}

pub function block_positions(f: SFunc): i32[] {
  return positions_of(f.blocks);
}

// The index of each block in `blocks`, by block id, and -1 for an id with no block.
pub function positions_of(blocks: SBlock[]): i32[] {
  let top: i32 = -1;
  for blk in blocks {
    if (blk.id > top) {
      top = blk.id;
    }
  }
  let out = util.minus_ones(top + 1);
  for i in 0..blocks.len() {
    let id = blocks[i].id;
    if (id >= 0 && out[id] < 0) {
      out = out.with(id, i);
    }
  }
  return out;
}

// The distinct blocks a terminator can jump to.
pub function successors(t: STerm): i32[] {
  if (t.kind_tag == TERM_BR) {
    return [t.target];
  }
  if (t.kind_tag == TERM_BRIF && t.t == t.f) {
    return [t.t];
  }
  if (t.kind_tag == TERM_BRIF) {
    return [t.t, t.f];
  }
  return [];
}

pub function successor_id(t: STerm, which: i32): i32 {
  if (t.kind_tag == TERM_BR && which == 0) {
    return t.target;
  }
  if (t.kind_tag == TERM_BRIF) {
    if (which == 0) {
      return t.t;
    }
    if (which == 1) {
      return t.f;
    }
  }
  return -1;
}

function distinct_successor_position(at: i32[], t: STerm, which: i32): i32 {
  let id = successor_id(t, which);
  if (id < 0 || which == 1 && id == t.t) {
    return -1;
  }
  return position_of(at, id);
}

pub function position_of(at: i32[], id: i32): i32 {
  if (id < 0 || id >= at.len()) {
    return -1;
  }
  return at[id];
}

pub function reads_value(ins: SInst, v: i32): boolean {
  for a in ins.args {
    if (a == v) {
      return true;
    }
  }
  return false;
}

pub function term_reads_value(t: STerm, v: i32): boolean {
  if (t.kind_tag == TERM_RET) {
    return t.value == v;
  }
  if (t.kind_tag == TERM_BRIF) {
    return t.cond == v;
  }
  return false;
}

function index_of_reg(a: i32[], x: i32): i32 {
  for i in 0..a.len() {
    if (a[i] == x) {
      return i;
    }
  }
  return -1;
}

function marked(marks: boolean[], v: i32): boolean {
  return v >= 0 && v < marks.len() && marks[v];
}

function unmarked_or_none(v: i32, marks: boolean[]): i32 {
  if (marked(marks, v)) {
    return -1;
  }
  return v;
}

function unmarked(vs: i32[], marks: boolean[]): i32[] {
  if (marks.len() == 0) {
    return vs;
  }
  let out: i32[] = [];
  for v in vs {
    if (!marked(marks, v)) {
      out = out.append(v);
    }
  }
  return out;
}

struct PairSlots { slot_end: i32[], holder: i32[], occupants: i32[][] }

function even_pair(t: PairSlots, p: i32, v: i32): PairSlots {
  if (p % 2 == 0) {
    return t;
  }
  return PairSlots { slot_end: t.slot_end.append(2147483647), holder: t.holder.append(v), occupants: t.occupants.append([v]) };
}

function take_pair(t: PairSlots, p: i32, end: i32, v: i32): PairSlots {
  for u in p..=p + 1 {
    if (u == t.slot_end.len()) {
      t = PairSlots { slot_end: t.slot_end.append(end), holder: t.holder.append(v), occupants: t.occupants.append([v]) };
    } else {
      t = PairSlots { slot_end: t.slot_end.with(u, end), holder: t.holder.with(u, v), occupants: t.occupants.with(u, [v]) };
    }
  }
  return t;
}

function assign_spill_slots(f: SFunc, shape: SlotShape, lo: i32[], hi: i32[], reg_of: i32[], hints: SlotHints, given: ReadSites): i32[] {
  let def_pos = shape.def_pos;
  let from = spill_starts(lo, def_pos);
  let wanted_by = mates_wanted(hi, reg_of, hints.hint);
  let lanes = lane_values(f);
  let slot_end: i32[] = [];
  let holder: i32[] = [];
  let occupants: i32[][] = [];
  let sites = given;
  let built = given.start.len() > 0;
  let live = no_spill_live();
  let pairs: i32[] = [];
  for v in order_by_lo(reg_of.len(), from) {
    if (hi[v] < 0 || reg_of[v] >= 0) {
      continue;
    }
    if (marked(lanes, v)) {
      let p = free_pair(slot_end, holder, wanted_by, reg_of, pairs, from[v], v);
      let t = even_pair(PairSlots { slot_end: slot_end, holder: holder, occupants: occupants }, p, v);
      p = p + t.slot_end.len() - slot_end.len();
      if (p == t.slot_end.len()) {
        pairs = pairs.append(p);
      }
      let pair = take_pair(t, p, hi[v], v);
      slot_end = pair.slot_end;
      holder = pair.holder;
      occupants = pair.occupants;
      reg_of = reg_of.with(v, spill_code(p));
      continue;
    }
    let ends = closed_pairs(slot_end, pairs);
    let h = unmarked_or_none(hints.hint[v], lanes);
    let s = hinted_slot(ends, holder, reg_of, h, from[v], hints.take_over[v]);
    if (s < 0 && def_pos[v] >= 0) {
      let reads = unmarked(slot_operands(f, shape, reg_of, v), lanes);
      if (h >= 0 && reg_of[h] < -1) {
        let mate_first: i32[] = [h];
        for r in reads {
          mate_first = mate_first.append(r);
        }
        reads = mate_first;
      }
      if (reads.len() > 0 && !built) {
        sites = read_sites(f, shape.at, shape.blk_start);
        built = true;
      }
      if (reads.len() > 0 && live.words == 0) {
        live = spill_live(sites, shape.def_blk, spilled_values(reg_of, hi), reg_of.len());
      }
      s = path_slot(sites, live, shape, reads, ends, holder, occupants, wanted_by, reg_of, hi, from[v], v);
    }
    if (s < 0) {
      s = free_slot(ends, holder, wanted_by, reg_of, from[v], v);
    }
    let end = hi[v];
    if (s < slot_end.len() && slot_end[s] > end) {
      end = slot_end[s];
    }
    if (s == slot_end.len()) {
      slot_end = slot_end.append(end);
      holder = holder.append(v);
      occupants = occupants.append([v]);
    } else {
      slot_end = slot_end.with(s, end);
      holder = holder.with(s, v);
      occupants = occupants.with(s, still_in(occupants[s], hi, from[v]).append(v));
    }
    reg_of = reg_of.with(v, spill_code(s));
  }
  return reg_of;
}

function spilled_values(reg_of: i32[], hi: i32[]): i32[] {
  let out: i32[] = [];
  for v in 0..reg_of.len() {
    if (hi[v] >= 0 && reg_of[v] < 0) {
      out = out.append(v);
    }
  }
  return out;
}

struct SlotShape { at: i32[], blk_start: i32[], def_blk: i32[], def_pos: i32[], def_a: i32[], def_b: i32[] }

function slot_operands(f: SFunc, shape: SlotShape, reg_of: i32[], v: i32): i32[] {
  let out: i32[] = [];
  let bi = shape.def_blk[v];
  let ins = f.blocks[bi].insts[shape.def_pos[v] - shape.blk_start[bi]];
  let cands: i32[] = [shape.def_a[v], shape.def_b[v]];
  if (ins.kind_tag == PHI) {
    cands = ins.args;
  }
  for c in cands {
    if (c >= 0 && reg_of[c] < -1) {
      out = out.append(c);
    }
  }
  return out;
}

function path_slot(sites: ReadSites, live: SpillLive, shape: SlotShape, reads: i32[], slot_end: i32[], holder: i32[], occupants: i32[][], wanted_by: i32[], reg_of: i32[], hi: i32[], from: i32, v: i32): i32 {
  for c in reads {
    let cs = spill_slot(reg_of[c]);
    let ok = true;
    for w in occupants[cs] {
      if (ok && hi[w] >= from && (spill_live_at(live, sites, w, v, shape.def_blk, shape.def_pos) || shape.def_pos[w] >= 0 && spill_live_at(live, sites, v, w, shape.def_blk, shape.def_pos))) {
        ok = false;
      }
    }
    if (ok && (slot_end[cs] >= from || !kept_for_mate(wanted_by, reg_of, holder[cs], v))) {
      return cs;
    }
  }
  return -1;
}

function still_in(occ: i32[], hi: i32[], from: i32): i32[] {
  let out: i32[] = [];
  for w in occ {
    if (hi[w] >= from) {
      out = out.append(w);
    }
  }
  return out;
}

struct ReadSites { start: i32[], blk: i32[], pos: i32[], succ_a: i32[], succ_b: i32[], phi_end: i32[] }

function cached_read_sites(f: SFunc, own sites: ReadSites, at: i32[], blk_start: i32[]): ReadSites {
  if (sites.start.len() == 0) {
    return read_sites(f, at, blk_start);
  }
  return sites;
}

function later_interval_end(a: i32, b: i32): i32 {
  if (b > a) {
    return b;
  }
  return a;
}

function read_sites(f: SFunc, at: i32[], blk_start: i32[]): ReadSites {
  let count = __alloc_i32(f.nvals + 1);
  let succ_a = __alloc_i32(f.blocks.len());
  let succ_b = __alloc_i32(f.blocks.len());
  let phi_end: i32[] = [];
  let bi = 0;
  while (bi < f.blocks.len()) {
    let t = f.blocks[bi].term;
    succ_a = succ_a.with(bi, distinct_successor_position(at, t, 0));
    succ_b = succ_b.with(bi, distinct_successor_position(at, t, 1));
    let end = 0;
    let k = 0;
    while (k < f.blocks[bi].insts.len()) {
      if (f.blocks[bi].insts[k].kind_tag == PHI) {
        end = k + 1;
      }
      k += 1;
    }
    phi_end = phi_end.append(blk_start[bi] + end);
    bi += 1;
  }
  let pass = 0;
  let start: i32[] = [];
  let blk: i32[] = [];
  let pos: i32[] = [];
  while (pass < 2) {
    let fill = start;
    for bi in 0..f.blocks.len() {
      let b = f.blocks[bi];
      for k in 0..b.insts.len() {
        let ins = b.insts[k];
        for sl in 0..ins.args.len() {
          let a = ins.args[sl];
          let rb = bi;
          let rp = blk_start[bi] + k;
          if (ins.kind_tag == PHI) {
            rb = -1;
            if (sl < b.preds.len()) {
              rb = position_of(at, b.preds[sl]);
            }
            if (rb >= 0) {
              rp = blk_start[rb] + f.blocks[rb].insts.len();
            }
          }
          if (a >= 0 && a < f.nvals && rb >= 0) {
            if (pass == 0) {
              count = count.with(a + 1, count[a + 1] + 1);
            } else {
              blk = blk.with(fill[a], rb);
              pos = pos.with(fill[a], rp);
              fill = fill.with(a, fill[a] + 1);
            }
          }
        }
      }
      let tv: i32 = -1;
      if (b.term.kind_tag == TERM_RET) {
        tv = b.term.value;
      }
      if (b.term.kind_tag == TERM_BRIF) {
        tv = b.term.cond;
      }
      if (tv >= 0 && tv < f.nvals) {
        if (pass == 0) {
          count = count.with(tv + 1, count[tv + 1] + 1);
        } else {
          blk = blk.with(fill[tv], bi);
          pos = pos.with(fill[tv], blk_start[bi] + b.insts.len());
          fill = fill.with(tv, fill[tv] + 1);
        }
      }
    }
    if (pass == 0) {
      let v = 1;
      while (v < count.len()) {
        count = count.with(v, count[v] + count[v - 1]);
        v += 1;
      }
      start = count;
      blk = __alloc_i32(count[f.nvals]);
      pos = __alloc_i32(count[f.nvals]);
    }
    pass += 1;
  }
  return ReadSites { start: start, blk: blk, pos: pos, succ_a: succ_a, succ_b: succ_b, phi_end: phi_end };
}

// reads are the operands of v's definition: the emitter can write v before it
// reads them, so none of them can hold the register v takes.
// phi marks each phi and each value a phi reads: an edge copy writes outside
// the intervals, so those values take no part in a lend.
struct Lender { cbase: i32, sat: i32, cabi: i32, abi_ok: boolean, reads: i32[], phi: boolean[] }

function phi_values(f: SFunc): boolean[] {
  let out = __alloc_bool(f.nvals + 1);
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == PHI) {
        if (ins.result >= 0 && ins.result < f.nvals) {
          out = out.with(ins.result, true);
        }
        for a in ins.args {
          if (a >= 0 && a < f.nvals) {
            out = out.with(a, true);
          }
        }
      }
    }
  }
  return out;
}

function defining_args(f: SFunc, v: i32, def_blk: i32[], def_pos: i32[], blk_start: i32[]): i32[] {
  let b = def_blk[v];
  if (b < 0) {
    return [];
  }
  let k = def_pos[v] - blk_start[b];
  if (k < 0 || k >= f.blocks[b].insts.len()) {
    return [];
  }
  return f.blocks[b].insts[k].args;
}

// A caller-saved register whose values do not interfere with v: none is live
// at v's definition, and v is live at none of theirs.
function borrowable(sites: ReadSites, v: i32, act_val: i32[], act_reg: i32[], ln: Lender, fixed: ssafixed.Table, shared_with: i32[], lo: i32[], hi: i32[], def_blk: i32[], def_pos: i32[]): Option[i32] {
  if (ln.phi[v]) {
    return None;
  }
  for ai in 0..act_val.len() {
    let hr = act_reg[ai];
    let open = hr >= ln.cbase && hr < ln.sat && (hr != ln.cabi || ln.abi_ok) && ssafixed.allows(fixed, hr, lo[v], hi[v]);
    if (open && chain_dead_at_def(sites, act_val[ai], v, shared_with, lo, hi, def_blk, def_pos) && dead_at_chain(sites, v, act_val[ai], shared_with, ln.reads, ln.phi, lo, hi, def_blk, def_pos)) {
      return Some(ai);
    }
  }
  return None;
}

function dead_at_chain(sites: ReadSites, v: i32, holder: i32, shared_with: i32[], reads: i32[], phi: boolean[], lo: i32[], hi: i32[], def_blk: i32[], def_pos: i32[]): boolean {
  let m = holder;
  while (m >= 0) {
    if (hi[m] >= lo[v] && (phi[m] || util.index_of_i32(reads, m) >= 0 || live_at_def(sites, v, m, def_blk, def_pos))) {
      return false;
    }
    m = shared_with[m];
  }
  return true;
}

function chain_dead_at_def(sites: ReadSites, holder: i32, a: i32, shared_with: i32[], lo: i32[], hi: i32[], def_blk: i32[], def_pos: i32[]): boolean {
  let m = holder;
  while (m >= 0) {
    if (hi[m] >= lo[a] && live_at_def(sites, m, a, def_blk, def_pos)) {
      return false;
    }
    m = shared_with[m];
  }
  return true;
}

function live_near(sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): i32 {
  let ab = def_blk[a];
  if (r < 0 || ab < 0) {
    return 1;
  }
  let rb = def_blk[r];
  if (rb == ab && def_pos[r] > def_pos[a] && def_pos[r] >= sites.phi_end[rb]) {
    return 0;
  }
  let first = sites.start[r];
  let last = sites.start[r + 1];
  let far = false;
  let elsewhere = false;
  for i in first..last {
    if (sites.blk[i] == ab && sites.pos[i] > def_pos[a]) {
      return 1;
    }
    far = far || sites.blk[i] != ab || rb != ab;
    elsewhere = elsewhere || sites.blk[i] != rb;
  }
  if (!far) {
    return 0;
  }
  if (!elsewhere && rb != ab) {
    return 0;
  }
  return 2;
}

function live_at_def(sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): boolean {
  let near = live_near(sites, r, a, def_blk, def_pos);
  if (near != 2) {
    return near == 1;
  }
  let ab = def_blk[a];
  let rb = def_blk[r];
  let first = sites.start[r];
  let last = sites.start[r + 1];
  let n = sites.succ_a.len();
  let walk = __alloc_i32(3 * n);
  for i in first..last {
    walk = walk.with(2 * n + sites.blk[i], 1);
  }
  let top = 0;
  let b = ab;
  while (true) {
    let s = sites.succ_a[b];
    if (s >= 0 && s != rb && walk[n + s] == 0) {
      walk = walk.with(n + s, 1).with(top, s);
      top += 1;
    }
    s = sites.succ_b[b];
    if (s >= 0 && s != rb && walk[n + s] == 0) {
      walk = walk.with(n + s, 1).with(top, s);
      top += 1;
    }
    if (top == 0) {
      return false;
    }
    top -= 1;
    b = walk[top];
    if (walk[2 * n + b] == 1) {
      return true;
    }
  }
}

struct SpillLive { index: i32[], words: i32, live_in: i64[] }

function no_spill_live(): SpillLive {
  return SpillLive { index: [], words: 0, live_in: [] };
}

function spill_live(sites: ReadSites, def_blk: i32[], values: i32[], nvals: i32): SpillLive {
  let n = sites.succ_a.len();
  let words: i32 = (values.len() + 63) / 64;
  let index = util.minus_ones(nvals);
  let uses = __alloc_i64(n * words);
  let kills = __alloc_i64(n * words);
  let k = 0;
  for v in values {
    index = index.with(v, k);
    let rb = def_blk[v];
    if (rb >= 0) {
      kills = spill_bit(kills, rb * words, k);
    }
    let i = sites.start[v];
    while (i < sites.start[v + 1]) {
      if (sites.blk[i] != rb) {
        uses = spill_bit(uses, sites.blk[i] * words, k);
      }
      i += 1;
    }
    k += 1;
  }
  let live_in = uses;
  let all: i64 = 0i64 - 1i64;
  let changed = true;
  while (changed) {
    changed = false;
    let b = n - 1;
    while (b >= 0) {
      for w in 0..words {
        let out: i64 = 0i64;
        if (sites.succ_a[b] >= 0) {
          out = out | live_in[sites.succ_a[b] * words + w];
        }
        if (sites.succ_b[b] >= 0) {
          out = out | live_in[sites.succ_b[b] * words + w];
        }
        let next = uses[b * words + w] | out & (kills[b * words + w] ^ all);
        if (next != live_in[b * words + w]) {
          live_in = live_in.with(b * words + w, next);
          changed = true;
        }
      }
      b -= 1;
    }
  }
  return SpillLive { index: index, words: words, live_in: live_in };
}

function spill_bit(own rows: i64[], base: i32, k: i32): i64[] {
  let w = base + k / 64;
  return rows.with(w, rows[w] | 1i64 << (k % 64) as i64);
}

function spill_live_at(live: SpillLive, sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): boolean {
  let near = live_near(sites, r, a, def_blk, def_pos);
  if (near != 2) {
    return near == 1;
  }
  let k: i32 = -1;
  if (r < live.index.len()) {
    k = live.index[r];
  }
  if (k < 0) {
    return live_at_def(sites, r, a, def_blk, def_pos);
  }
  let ab = def_blk[a];
  for s in [sites.succ_a[ab], sites.succ_b[ab]] {
    if (s >= 0 && (live.live_in[s * live.words + k / 64] >> (k % 64) as i64 & 1i64) != 0i64) {
      return true;
    }
  }
  return false;
}

function spill_starts(lo: i32[], def_pos: i32[]): i32[] {
  let from = __alloc_i32(lo.len());
  for i in 0..lo.len() {
    if (def_pos[i] >= 0) {
      from = from.with(i, lo[i]);
    }
  }
  return from;
}

function mates_wanted(hi: i32[], reg_of: i32[], hint: i32[]): i32[] {
  let wanted_by = util.minus_ones(reg_of.len());
  for i in 0..reg_of.len() {
    let m = hint[i];
    if (m >= 0 && hi[i] >= 0 && reg_of[i] == -1 && reg_of[m] == -1) {
      wanted_by = wanted_by.with(m, i);
    }
  }
  return wanted_by;
}

function hinted_slot(slot_end: i32[], holder: i32[], reg_of: i32[], h: i32, from: i32, take_over: boolean): i32 {
  if (h < 0 || reg_of[h] >= -1) {
    return -1;
  }
  let hs = spill_slot(reg_of[h]);
  if (slot_end[hs] < from || take_over && holder[hs] == h) {
    return hs;
  }
  return -1;
}

function free_slot(slot_end: i32[], holder: i32[], wanted_by: i32[], reg_of: i32[], from: i32, v: i32): i32 {
  let s = 0;
  while (s < slot_end.len() && (slot_end[s] >= from || kept_for_mate(wanted_by, reg_of, holder[s], v))) {
    s += 1;
  }
  return s;
}

function free_pair(slot_end: i32[], holder: i32[], wanted_by: i32[], reg_of: i32[], pairs: i32[], from: i32, v: i32): i32 {
  for p in pairs {
    if (slot_free_at(slot_end, holder, wanted_by, reg_of, from, v, p) && slot_free_at(slot_end, holder, wanted_by, reg_of, from, v, p + 1)) {
      return p;
    }
  }
  return slot_end.len();
}

function closed_pairs(slot_end: i32[], pairs: i32[]): i32[] {
  for p in pairs {
    slot_end = slot_end.with(p, 2147483647).with(p + 1, 2147483647);
  }
  return slot_end;
}

function slot_free_at(slot_end: i32[], holder: i32[], wanted_by: i32[], reg_of: i32[], from: i32, v: i32, s: i32): boolean {
  return slot_end[s] < from && !kept_for_mate(wanted_by, reg_of, holder[s], v);
}

pub struct Imms { is_imm: boolean[], konst: boolean[], value: i64[], sym_at: i32[], syms: string[] }

pub function imm_sym(imm: Imms, v: i32): string {
  let k = imm.sym_at[v];
  return if (k > 0) { imm.syms[k - 1] } else { "" };
}

pub function with_sym(own imm: Imms, v: i32, sym: string): Imms {
  let syms = imm.syms.append(sym);
  return Imms { ...imm, is_imm: imm.is_imm.with(v, true), sym_at: imm.sym_at.with(v, syms.len()), syms: syms };
}

pub function imm_operands(f: SFunc, lo: i64, hi: i64, right: string[], left: string[]): Imms {
  let is_imm = __alloc_bool(f.nvals);
  let konst = __alloc_bool(f.nvals);
  let value = __alloc_i64(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag != CONST_INT && ins.kind_tag != CONST_I64) {
        continue;
      }
      konst = konst.with(ins.result, true);
      let c = ins.imm as i64;
      if (ins.kind_tag == CONST_I64) {
        c = util.lit_to_i64(ins.str);
      }
      value = value.with(ins.result, c);
      if (c < lo || c > hi) {
        continue;
      }
      is_imm = is_imm.with(ins.result, true);
    }
  }
  for blk in f.blocks {
    for ins in blk.insts {
      for a in 0..ins.args.len() {
        let v = ins.args[a];
        if (v >= 0 && v < is_imm.len() && is_imm[v] && ins.kind_tag != PHI && !imm_use(ins, a, konst, value[v], right, left)) {
          is_imm = is_imm.with(v, false);
        }
      }
    }
    let t = blk.term;
    if (t.kind_tag == TERM_BRIF && t.cond >= 0 && t.cond < is_imm.len()) {
      is_imm = is_imm.with(t.cond, false);
    }
  }
  return Imms { is_imm: is_imm, konst: konst, value: value, sym_at: __alloc_i32(f.nvals), syms: [] };
}

function imm_use(ins: SInst, a: i32, konst: boolean[], c: i64, right: string[], left: string[]): boolean {
  if ((ins.kind_tag == LD_IDX || ins.kind_tag == ST_IDX) && a == 1) {
    return c >= 0i64 && c <= 4095i64;
  }
  if ((ins.kind_tag == LD_BYTE || ins.kind_tag == ST_BYTE) && a == 1) {
    return true;
  }
  if (ins.kind_tag >= ARR_AT && ins.kind_tag <= STR_AT && a == 1) {
    return c >= 0i64 && c <= 4087i64;
  }
  if (ins.kind_tag != BINARY || ins.args.len() != 2) {
    return false;
  }
  let other = ins.args[1 - a];
  if (other < 0 || other >= konst.len()) {
    return false;
  }
  if (a == 0 && konst[other]) {
    return false;
  }
  let names = left;
  if (a == 1) {
    names = right;
  }
  for n in names {
    if (n == ins.str) {
      return true;
    }
  }
  return false;
}

pub function literal_first_bytes(f: SFunc): i32[] {
  let out = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == STR_LIT && ins.str.len() > 0) {
        out = out.with(ins.result, ins.str[0] as i32);
      }
    }
  }
  return out;
}

pub function use_counts(f: SFunc): i32[] {
  let uses = __alloc_i32(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      for a in ins.args {
        if (a >= 0 && a < uses.len()) {
          uses = uses.with(a, uses[a] + 1);
        }
      }
    }
    let t = blk.term;
    if (t.kind_tag == TERM_RET && t.value >= 0 && t.value < uses.len()) {
      uses = uses.with(t.value, uses[t.value] + 1);
    }
    if (t.kind_tag == TERM_BRIF && t.cond >= 0 && t.cond < uses.len()) {
      uses = uses.with(t.cond, uses[t.cond] + 1);
    }
  }
  return uses;
}

function phi_sole_operand(ins: SInst, repl: i32[]): i32 {
  let only: i32 = -1;
  for i in 0..ins.args.len() {
    let a = resolve_repl(repl, ins.args[i]);
    if (a != ins.result) {
      if (only < 0) {
        only = a;
      } else if (only != a) {
        return -1;
      }
    }
  }
  return only;
}

function resolve_repl(repl: i32[], v: i32): i32 {
  let seen = 0;
  while (v >= 0 && v < repl.len() && repl[v] != v && seen < 1000) {
    v = repl[v];
    seen += 1;
  }
  return v;
}

function trivial_phi_repl(f: SFunc): i32[] {
  let repl = __alloc_i32(f.nvals);
  for i in 0..f.nvals {
    repl = repl.with(i, i);
  }
  let rounds = 0;
  let changed = true;
  while (changed && rounds < 100) {
    changed = false;
    rounds += 1;
    for blk in f.blocks {
      for ins in blk.insts {
        if (ins.kind_tag != PHI) {
          continue;
        }
        if (repl[ins.result] != ins.result) {
          continue;
        }
        let only = phi_sole_operand(ins, repl);
        if (only >= 0 && only != ins.result) {
          repl = repl.with(ins.result, only);
          changed = true;
        }
      }
    }
  }
  return repl;
}

pub struct Leaf { name: string, func: SFunc }

pub struct Leaves { list: Leaf[], ix: util.NameIndex }

pub function leaves_of(list: Leaf[]): Leaves {
  let names: string[] = [];
  for l in list {
    names = names.append(l.name);
  }
  return Leaves { list: list, ix: util.name_index(names) };
}

function leaf_limit(): i32 {
  return 12;
}

function leaf_kind(k: i32): boolean {
  return k == CONST_INT || k == CONST_BOOL || k == CONST_I64 || k == PARAM || k == COPY || k == BINARY || k == UNARY;
}

pub function leaf_of(name: string, f: SFunc): Leaf[] {
  if (f.takes_env || f.blocks.len() == 0) {
    return [];
  }
  let at = block_positions(f);
  let insts: SInst[] = [];
  let bi = position_of(at, f.entry);
  let seen = 0;
  while (bi >= 0 && seen < f.blocks.len()) {
    let b = f.blocks[bi];
    for ins in b.insts {
      insts = insts.append(ins);
    }
    seen += 1;
    if (b.term.kind_tag == TERM_RET) {
      if (seen != f.blocks.len()) {
        return [];
      }
      return returning_leaf(name, f, insts, b.term);
    }
    if (b.term.kind_tag != TERM_BR) {
      return [];
    }
    bi = position_of(at, b.term.target);
  }
  return [];
}

function returning_leaf(name: string, f: SFunc, insts: SInst[], term: STerm): Leaf[] {
  if (term.value < 0) {
    return [];
  }
  let n = 0;
  for ins in insts {
    if (!leaf_kind(ins.kind_tag)) {
      return [];
    }
    if (ins.kind_tag != PARAM) {
      n += 1;
    }
  }
  if (n > leaf_limit()) {
    return [];
  }
  let one = SBlock { id: f.entry, insts: insts, term: term, preds: [] };
  return [Leaf { name: name, func: SFunc { ...f, blocks: [one] } }];
}

pub function inline_leaves(f: SFunc, leaves: Leaves): SFunc {
  if (leaves.list.len() == 0) {
    return f;
  }
  let nvals = f.nvals;
  let blocks: SBlock[] = [];
  let copying = false;
  let bi = 0;
  while (bi < f.blocks.len()) {
    let b = f.blocks[bi];
    let insts: SInst[] = [];
    let spliced = false;
    let k = 0;
    while (k < b.insts.len()) {
      let ins = b.insts[k];
      let at: i32 = -1;
      if (ins.kind_tag == CALL) {
        at = leaf_index(leaves, ins.str, ins.args.len());
      }
      if (at < 0) {
        if (spliced) {
          insts = insts.append(ins);
        }
        k += 1;
        continue;
      }
      if (!spliced) {
        insts = insts_before(b.insts, k);
        spliced = true;
      }
      let leaf = leaves.list[at].func;
      let map = util.minus_ones(leaf.nvals);
      for li in leaf.blocks[0].insts {
        if (li.kind_tag == PARAM) {
          map = map.with(li.result, ins.args[li.imm]);
        } else {
          map = map.with(li.result, nvals);
          let args: i32[] = [];
          for a in li.args {
            args = args.append(map[a]);
          }
          insts = insts.append(SInst { ...li, result: nvals, args: args });
          nvals += 1;
        }
      }
      if (ins.result >= 0) {
        insts = insts.append(SInst { kind_tag: COPY, result: ins.result, args: [map[leaf.blocks[0].term.value]], imm: 0, str: "" });
      }
      k += 1;
    }
    if (spliced) {
      if (!copying) {
        blocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      blocks = blocks.append(SBlock { ...b, insts: insts });
    } else if (copying) {
      blocks = blocks.append(b);
    }
    bi += 1;
  }
  if (!copying) {
    return f;
  }
  return SFunc { ...f, nvals: nvals, blocks: blocks };
}

pub function calls_leaf(f: SFunc, leaves: Leaves): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == CALL && leaf_index(leaves, ins.str, ins.args.len()) >= 0) {
        return true;
      }
    }
  }
  return false;
}

function leaf_index(leaves: Leaves, name: string, argc: i32): i32 {
  let i = leaves.ix.chain(name);
  while (i >= 0) {
    if (leaves.list[i].func.nparams == argc && leaves.ix.names[i] == name) {
      return i;
    }
    i = leaves.ix.next[i];
  }
  return -1;
}

pub function prune_trivial_phis(f: SFunc): Formed {
  let repl = trivial_phi_repl(f);
  let any = false;
  let i = 0;
  while (i < f.nvals) {
    if (repl[i] != i) {
      any = true;
    }
    i += 1;
  }
  if (!any) {
    return Formed { f: f, repl: [] };
  }
  let flat: i32[] = [];
  for i in 0..f.nvals {
    flat = flat.append(resolve_repl(repl, i));
  }
  return Formed { f: rewrite_through(f, flat), repl: flat };
}

function rewrite_through(f: SFunc, flat: i32[]): SFunc {
  let nblocks: SBlock[] = [];
  let copying = false;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    let ninsts: SInst[] = [];
    let changed = false;
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      let gone = ins.result >= 0 && flat[ins.result] != ins.result;
      let moved = !gone && args_move(ins, flat);
      if (!changed && (gone || moved)) {
        ninsts = insts_before(blk.insts, k);
        changed = true;
      }
      if (changed && !gone) {
        if (moved) {
          ninsts = ninsts.append(rewrite_args(ins, flat));
        } else {
          ninsts = ninsts.append(ins);
        }
      }
    }
    let term = blk.term;
    if (term_moves(term, flat)) {
      term = rewrite_term(term, flat);
      if (!changed) {
        ninsts = blk.insts;
        changed = true;
      }
    }
    if (changed) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { ...blk, insts: ninsts, term: term });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
  }
  if (!copying) {
    return f;
  }
  return SFunc { ...f, blocks: nblocks };
}

function merge_duplicates(f: SFunc): Formed {
  let canon = identity_repl(f.nvals);
  let n = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag >= CONST_INT && ins.kind_tag <= CONST_I64 || ins.kind_tag == BINARY || ins.kind_tag == UNARY) {
        n += 1;
      }
    }
  }
  let nb = n * 2 + 1;
  let head = util.minus_ones(nb);
  let seen: SInst[] = [];
  let seen_block: i32[] = [];
  let next: i32[] = [];
  let merged: i32[] = [];
  for bi in 0..f.blocks.len() {
    for ins in f.blocks[bi].insts {
      let scope: i32 = -2;
      if (is_constant(ins, f.nvals)) {
        scope = -1;
      } else if (mergeable(ins)) {
        scope = bi;
      }
      if (scope >= -1) {
        let bk = (inst_hash(ins, canon) * 31 + (scope & 65535) & 1073741823) % nb;
        let found: i32 = -1;
        let j = head[bk];
        while (j >= 0 && found < 0) {
          if (seen_block[j] == scope && same_operation(seen[j], ins, canon)) {
            found = seen[j].result;
          }
          j = next[j];
        }
        if (found >= 0) {
          canon = canon.with(ins.result, found);
          if (scope >= 0) {
            merged = merged.append(ins.result).append(found);
          }
        } else {
          next = next.append(head[bk]);
          head = head.with(bk, seen.len());
          seen = seen.append(ins);
          seen_block = seen_block.append(scope);
        }
      }
    }
  }
  if (merged.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  let repl = identity_repl(f.nvals);
  let k = 0;
  while (k < merged.len()) {
    repl = repl.with(merged[k], merged[k + 1]);
    k += 2;
  }
  return Formed { f: rewrite_through(f, repl), repl: repl };
}

function identity_repl(n: i32): i32[] {
  let out = __alloc_i32(n);
  for i in 0..n {
    out = out.with(i, i);
  }
  return out;
}

// x + 0, x - 0, x | 0, x ^ 0, x shifted by 0 and x * 1 are x.
function fold_identities(f: SFunc): Formed {
  let defs = inst_defs(f);
  let flat = identity_repl(f.nvals);
  let changed = false;
  for blk in f.blocks {
    for ins in blk.insts {
      let kept = identity_operand(ins, defs);
      if (kept >= 0 && ins.result >= 0) {
        flat = flat.with(ins.result, flat[kept]);
        changed = true;
      }
    }
  }
  if (!changed) {
    return Formed { f: f, repl: [] };
  }
  return Formed { f: rewrite_through(f, flat), repl: flat };
}

function identity_operand(ins: SInst, defs: SInst[]): i32 {
  if (ins.kind_tag != BINARY || ins.args.len() != 2) {
    return -1;
  }
  let unit: i64 = 0i64;
  if (ins.str == "mul") {
    unit = 1i64;
  }
  if (right_identity(ins.str) && const_is(defs, ins.args[1], unit)) {
    return ins.args[0];
  }
  if (left_identity(ins.str) && const_is(defs, ins.args[0], unit)) {
    return ins.args[1];
  }
  return -1;
}

function left_identity(op: string): boolean {
  return op == "add" || op == "or" || op == "xor" || op == "mul";
}

function right_identity(op: string): boolean {
  return left_identity(op) || op == "sub" || op == "shl" || op == "shr_s" || op == "shr_u";
}

function const_is(defs: SInst[], v: i32, n: i64): boolean {
  if (v < 0 || v >= defs.len()) {
    return false;
  }
  let d = defs[v];
  if (d.kind_tag == CONST_INT) {
    return d.imm as i64 == n;
  }
  return d.kind_tag == CONST_I64 && d.str.len() > 0 && util.lit_to_i64(d.str) == n;
}

function is_constant(ins: SInst, nvals: i32): boolean {
  return ins.kind_tag >= CONST_INT && ins.kind_tag <= CONST_I64 && ins.result >= 0 && ins.result < nvals;
}

function mergeable(ins: SInst): boolean {
  if (ins.result < 0) {
    return false;
  }
  if (ins.kind_tag == BINARY) {
    return !binary_fixes_abi(ins.str);
  }
  if (ins.kind_tag == UNARY) {
    return ins.str == "!" || ins.str == "u32_wrap" || ins.str == "int_wrap" || ins.str == "int_extend"
      || ins.str.starts_with("int_cast:") || ins.str.starts_with("rotr:");
  }
  return false;
}

function operand_id(a: i32, canon: i32[]): i32 {
  if (a < 0 || a >= canon.len()) {
    return a;
  }
  return canon[a];
}

function inst_hash(ins: SInst, canon: i32[]): i32 {
  let h: i32 = (ins.kind_tag * 31 + (ins.imm & 65535)) * 31 + (__str_hash(ins.str, 0) & 65535) & 1048575;
  for a in ins.args {
    h = h * 31 + (operand_id(a, canon) & 1048575) & 1048575;
  }
  return h;
}

function same_operation(a: SInst, b: SInst, canon: i32[]): boolean {
  if (a.kind_tag != b.kind_tag || a.imm != b.imm || a.args.len() != b.args.len() || a.str != b.str) {
    return false;
  }
  for k in 0..a.args.len() {
    if (operand_id(a.args[k], canon) != operand_id(b.args[k], canon)) {
      return false;
    }
  }
  return true;
}

function args_move(ins: SInst, resolved: i32[]): boolean {
  for a in ins.args {
    if (a >= 0 && resolved[a] != a) {
      return true;
    }
  }
  return false;
}

function term_moves(t: STerm, resolved: i32[]): boolean {
  if (t.kind_tag == TERM_RET) {
    return t.value >= 0 && resolved[t.value] != t.value;
  }
  if (t.kind_tag == TERM_BRIF) {
    return resolved[t.cond] != t.cond;
  }
  return false;
}

pub function repeated_block_id(f: SFunc): i32 {
  let top = 0;
  for blk in f.blocks {
    if (blk.id > top) {
      top = blk.id;
    }
  }
  let seen = __alloc_i32(top + 1);
  for blk in f.blocks {
    if (seen[blk.id] == 1) {
      return blk.id;
    }
    seen = seen.with(blk.id, 1);
  }
  return -1;
}

pub function thread_forwarding(f: SFunc): Threading {
  let at = block_positions(f);
  let nblocks: SBlock[] = [];
  let copying = false;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    let t = blk.term;
    let moved = false;
    if (t.kind_tag == TERM_BR) {
      let target = forwarded(f, at, t.target);
      if (target != t.target) {
        t = STerm { ...t, target: target };
        moved = true;
      }
    }
    if (t.kind_tag == TERM_BRIF) {
      let nt = forwarded_branch(f, at, t);
      moved = nt.kind_tag != TERM_BRIF || nt.t != t.t || nt.f != t.f;
      t = nt;
    }
    if (moved) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { ...blk, term: t });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
  }
  let g = f;
  if (copying) {
    g = SFunc { ...f, blocks: nblocks };
  }
  let live = __alloc_bool(g.blocks.len());
  let work: i32[] = [position_of(at, g.entry)];
  let next = 0;
  while (next < work.len()) {
    let b = work[next];
    next += 1;
    if (b < 0 || live[b]) {
      continue;
    }
    live = live.with(b, true);
    for which in 0..2 {
      let id = successor_id(g.blocks[b].term, which);
      if (id >= 0 && (which == 0 || id != g.blocks[b].term.t)) {
        work = work.append(position_of(at, id));
      }
    }
  }
  let kept: SBlock[] = [];
  let dropping = false;
  for i in 0..g.blocks.len() {
    if (!live[i]) {
      if (!dropping) {
        kept = blocks_before(g.blocks, i);
        dropping = true;
      }
    } else if (dropping) {
      kept = kept.append(g.blocks[i]);
    }
  }
  let out = g;
  if (dropping) {
    out = SFunc { ...g, blocks: kept };
  }
  return Threading { f: SFunc { ...out, blocks: refreshed_preds(out) }, changed: copying || dropping };
}

// A branch whose two targets meet in a block with no phi is a jump.
function forwarded_branch(f: SFunc, at: i32[], t: STerm): STerm {
  let tt = forwarded(f, at, t.t);
  let tf = forwarded(f, at, t.f);
  if (tt == tf && tt >= 0 && tt < at.len() && at[tt] >= 0 && !has_phi(f.blocks[at[tt]])) {
    return t_br(tt);
  }
  return STerm { ...t, t: tt, f: tf };
}

function forwarded(f: SFunc, at: i32[], id: i32): i32 {
  let cur = id;
  for steps in 0..=f.blocks.len() {
    if (cur < 0 || cur >= at.len() || at[cur] < 0) {
      return cur;
    }
    let b = f.blocks[at[cur]];
    if (b.insts.len() != 0 || b.term.kind_tag != TERM_BR || b.term.target == cur) {
      return cur;
    }
    let nt = b.term.target;
    if (nt < 0 || nt >= at.len() || at[nt] < 0 || has_phi(f.blocks[at[nt]])) {
      return cur;
    }
    cur = nt;
  }
  return cur;
}

function has_phi(b: SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag == PHI) {
      return true;
    }
  }
  return false;
}

pub function refreshed_preds(f: SFunc): SBlock[] {
  let at = block_positions(f);
  let preds: i32[][] = [];
  let i = 0;
  while (i < f.blocks.len()) {
    preds = preds.append([]);
    i += 1;
  }
  i = 0;
  while (i < f.blocks.len()) {
    for which in 0..2 {
      let s = distinct_successor_position(at, f.blocks[i].term, which);
      if (s >= 0 && !has_pred(preds[s], f.blocks[i].id)) {
        preds = preds.with(s, preds[s].append(f.blocks[i].id));
      }
    }
    i += 1;
  }
  let out: SBlock[] = [];
  let copying = false;
  for i in 0..f.blocks.len() {
    let b = f.blocks[i];
    let nb = b;
    let fresh = false;
    if (has_phi(b)) {
      if (!every_pred(b.preds, preds[i])) {
        nb = trim_phi_edges(b, preds[i]);
        fresh = true;
      }
    } else if (!util.same_i32s(b.preds, preds[i])) {
      nb = SBlock { ...b, preds: preds[i] };
      fresh = true;
    }
    if (fresh) {
      if (!copying) {
        out = blocks_before(f.blocks, i);
        copying = true;
      }
      out = out.append(nb);
    } else if (copying) {
      out = out.append(b);
    }
  }
  if (!copying) {
    return f.blocks;
  }
  return out;
}

function every_pred(ps: i32[], edges: i32[]): boolean {
  for p in ps {
    if (!has_pred(edges, p)) {
      return false;
    }
  }
  return true;
}

function trim_phi_edges(b: SBlock, edges: i32[]): SBlock {
  let keep: boolean[] = [];
  let npreds: i32[] = [];
  for p in b.preds {
    let k = has_pred(edges, p);
    keep = keep.append(k);
    if (k) {
      npreds = npreds.append(p);
    }
  }
  if (npreds.len() == b.preds.len()) {
    return b;
  }
  let ninsts: SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag != PHI) {
      ninsts = ninsts.append(ins);
      continue;
    }
    let nargs: i32[] = [];
    for i in 0..ins.args.len() {
      if (i >= keep.len() || keep[i]) {
        nargs = nargs.append(ins.args[i]);
      }
    }
    ninsts = ninsts.append(SInst { ...ins, args: nargs });
  }
  return SBlock { id: b.id, insts: ninsts, term: b.term, preds: npreds };
}

function has_pred(ps: i32[], id: i32): boolean {
  for p in ps {
    if (p == id) {
      return true;
    }
  }
  return false;
}

struct BoolJoin { ok: boolean, j: i32, k: i32, t: i32, f: i32 }

pub struct Threading { f: SFunc, changed: boolean }

struct ThreadRound { blocks: SBlock[], busy: boolean[], gone: boolean[], changed: boolean }

pub function thread_bool_joins(f: SFunc): Threading {
  let g = f;
  let changed = false;
  for rounds in 0..8 {
    let r = thread_round(g);
    if (!r.changed) {
      return Threading { f: g, changed: changed };
    }
    g = r.f;
    changed = true;
  }
  return Threading { f: g, changed: changed };
}

function thread_round(f: SFunc): Threading {
  let at = block_positions(f);
  let uses = use_counts(f);
  let konst = truth_constants(f);
  let flags = __alloc_bool(f.blocks.len());
  let r = ThreadRound { blocks: f.blocks, busy: flags, gone: flags, changed: false };
  for j in 0..f.blocks.len() {
    let jn = bool_join_at(f, at, uses, j);
    if (jn.ok && !join_busy(f, at, r.busy, jn)) {
      r = thread_join(f, at, konst, jn, r);
    }
  }
  if (!r.changed) {
    return Threading { f: f, changed: false };
  }
  let kept: SBlock[] = [];
  for i in 0..r.blocks.len() {
    if (!r.gone[i]) {
      kept = kept.append(r.blocks[i]);
    }
  }
  let g = SFunc { ...f, blocks: kept };
  return Threading { f: SFunc { ...g, blocks: refreshed_preds(g) }, changed: true };
}

function truth_constants(f: SFunc): i32[] {
  let out = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if ((ins.kind_tag == CONST_INT || ins.kind_tag == CONST_BOOL) && ins.result >= 0 && ins.result < out.len()) {
        let truth = 0;
        if (ins.imm != 0) {
          truth = 1;
        }
        out = out.with(ins.result, truth);
      }
    }
  }
  return out;
}

function bool_join_at(f: SFunc, at: i32[], uses: i32[], j: i32): BoolJoin {
  let blk = f.blocks[j];
  let none = BoolJoin { ok: false, j: j, k: -1, t: 0, f: 0 };
  if (blk.insts.len() != 1 || blk.insts[0].kind_tag != PHI || uses[blk.insts[0].result] != 1 || !entered_forward(f, at, j)) {
    return none;
  }
  let k: i32 = -1;
  let last = j;
  let br = blk.term;
  if (br.kind_tag == TERM_BR) {
    k = position_of(at, br.target);
    if (k <= j || !branch_only(f.blocks[k], blk.id)) {
      return none;
    }
    last = k;
    br = f.blocks[k].term;
  }
  if (br.kind_tag != TERM_BRIF || br.cond != blk.insts[0].result || br.t == br.f
    || !plain_target(f, at, br.t, last) || !plain_target(f, at, br.f, last)) {
    return none;
  }
  return BoolJoin { ok: true, j: j, k: k, t: br.t, f: br.f };
}

function entered_forward(f: SFunc, at: i32[], j: i32): boolean {
  let blk = f.blocks[j];
  if (blk.preds.len() == 0 || blk.insts[0].args.len() != blk.preds.len()) {
    return false;
  }
  for i in 0..blk.preds.len() {
    let p = position_of(at, blk.preds[i]);
    if (p < 0 || p >= j || pred_slot(blk, blk.preds[i]) != i) {
      return false;
    }
  }
  return true;
}

function branch_only(b: SBlock, from: i32): boolean {
  return b.insts.len() == 0 && b.term.kind_tag == TERM_BRIF && b.preds.len() == 1 && b.preds[0] == from;
}

function plain_target(f: SFunc, at: i32[], id: i32, last: i32): boolean {
  let p = position_of(at, id);
  return p > last && !has_phi(f.blocks[p]);
}

function join_busy(f: SFunc, at: i32[], busy: boolean[], jn: BoolJoin): boolean {
  if (busy[jn.j] || jn.k >= 0 && busy[jn.k]) {
    return true;
  }
  for p in f.blocks[jn.j].preds {
    if (busy[at[p]]) {
      return true;
    }
  }
  return false;
}

function thread_join(f: SFunc, at: i32[], konst: i32[], jn: BoolJoin, r: ThreadRound): ThreadRound {
  let jb = f.blocks[jn.j];
  let blocks = r.blocks;
  let busy = r.busy.with(jn.j, true);
  let kept = 0;
  for i in 0..jb.preds.len() {
    let pp = at[jb.preds[i]];
    if (blocks[pp].term.kind_tag == TERM_BR) {
      blocks = blocks.with(pp, SBlock { ...blocks[pp], term: arm_term(jb.insts[0].args[i], konst, jn) });
      busy = busy.with(pp, true);
    } else {
      kept += 1;
    }
  }
  let gone = r.gone;
  if (kept == 0) {
    gone = gone.with(jn.j, true);
    if (jn.k >= 0) {
      gone = gone.with(jn.k, true);
    }
  }
  return ThreadRound { blocks: blocks, busy: busy, gone: gone, changed: r.changed || kept < jb.preds.len() };
}

function arm_term(v: i32, konst: i32[], jn: BoolJoin): STerm {
  if (v >= 0 && v < konst.len() && konst[v] == 1) {
    return t_br(jn.t);
  }
  if (v >= 0 && v < konst.len() && konst[v] == 0) {
    return t_br(jn.f);
  }
  return t_brif(v, jn.t, jn.f);
}

// A call whose result reaches the return only through a join returns from its
// own block, where an emitter can make it a tail call. The block with id to[k]
// took the return of the join with id from[k], in that order.
pub function return_calls(f: SFunc): Selection {
  let out = Selection { f: f, from: [], to: [] };
  for rounds in 0..8 {
    let r = return_round(out.f);
    if (r.from.len() == 0) {
      return out;
    }
    out = Selection { f: r.f, from: util.append_all(out.from, r.from), to: util.append_all(out.to, r.to) };
  }
  return out;
}

function return_round(f: SFunc): Selection {
  let at = block_positions(f);
  let uses = use_counts(f);
  let blocks = f.blocks;
  let from: i32[] = [];
  let to: i32[] = [];
  for jb in f.blocks {
    if (!return_join(jb, uses)) {
      continue;
    }
    for i in 0..jb.preds.len() {
      let pp = position_of(at, jb.preds[i]);
      if (pp >= 0 && yields_call(f, at, uses, f.blocks[pp], jb.insts[0].args[i], 4)) {
        blocks = blocks.with(pp, SBlock { ...blocks[pp], term: t_ret(jb.insts[0].args[i]) });
        from = from.append(jb.id);
        to = to.append(jb.preds[i]);
      }
    }
  }
  if (from.len() == 0) {
    return Selection { f: f, from: from, to: to };
  }
  let g = SFunc { ...f, blocks: blocks };
  return Selection { f: SFunc { ...g, blocks: settled_return_joins(refreshed_preds(g), f.entry) }, from: from, to: to };
}

// A block that holds one phi, with one value for each predecessor, that has one use.
function value_join(b: SBlock, uses: i32[]): boolean {
  return b.insts.len() == 1 && b.insts[0].kind_tag == PHI && b.insts[0].args.len() == b.preds.len() && b.preds.len() > 0 && uses[b.insts[0].result] == 1;
}

function return_join(b: SBlock, uses: i32[]): boolean {
  return value_join(b, uses) && b.term.kind_tag == TERM_RET && b.term.value == b.insts[0].result;
}

// A return join with no predecessor left goes. One with a single predecessor
// left returns the value of that predecessor.
function settled_return_joins(blocks: SBlock[], entry: i32): SBlock[] {
  let kept: SBlock[] = [];
  for b in blocks {
    if (b.preds.len() == 0 && b.id != entry) {
      continue;
    }
    if (b.preds.len() == 1 && b.insts.len() == 1 && b.insts[0].kind_tag == PHI && b.term.kind_tag == TERM_RET && b.term.value == b.insts[0].result) {
      kept = kept.append(SBlock { ...b, insts: [], term: t_ret(b.insts[0].args[0]) });
    } else {
      kept = kept.append(b);
    }
  }
  return kept;
}

// Whether b jumps to its join with v, and v is the result of a call that ends
// b, or of a call that ends a block which reaches b through joins only.
function yields_call(f: SFunc, at: i32[], uses: i32[], b: SBlock, v: i32, fuel: i32): boolean {
  if (b.term.kind_tag != TERM_BR || b.insts.len() == 0 || v < 0 || uses[v] != 1) {
    return false;
  }
  let last = b.insts[b.insts.len() - 1];
  if (last.result != v) {
    return false;
  }
  return calls(last) || fuel > 0 && value_join(b, uses) && join_yields_call(f, at, uses, b, fuel - 1);
}

function join_yields_call(f: SFunc, at: i32[], uses: i32[], b: SBlock, fuel: i32): boolean {
  for i in 0..b.preds.len() {
    let pp = position_of(at, b.preds[i]);
    if (pp >= 0 && yields_call(f, at, uses, f.blocks[pp], b.insts[0].args[i], fuel)) {
      return true;
    }
  }
  return false;
}

struct Diamond { ok: boolean, head: i32, t: i32, f: i32, join: i32 }

pub function select_arm_limit(): i32 {
  return 3;
}

// Selection is a function after select_branches. The block with id from[k]
// was folded into the block with id to[k], in that order.
pub struct Selection { f: SFunc, from: i32[], to: i32[] }

pub function select_branches(f: SFunc): Selection {
  let out = Selection { f: f, from: [], to: [] };
  for rounds in 0..8 {
    let r = select_round(out.f);
    if (!r.changed) {
      return out;
    }
    out = Selection { f: r.s.f, from: util.append_all(out.from, r.s.from), to: util.append_all(out.to, r.s.to) };
  }
  return out;
}

struct SelectRound { s: Selection, changed: boolean }

function select_round(f: SFunc): SelectRound {
  let at = block_positions(f);
  let fl = float_values(f, [], false);
  let none = __alloc_bool(f.blocks.len());
  let r = Flattening { blocks: f.blocks, busy: none, gone: none, nvals: f.nvals, changed: false, joins: [] };
  for p in 0..f.blocks.len() {
    let d = diamond_at(f, at, fl, p);
    if (d.ok && !diamond_busy(r.busy, d)) {
      r = flatten_diamond(f, d, r);
    }
  }
  if (!r.changed) {
    return SelectRound { s: Selection { f: f, from: [], to: [] }, changed: false };
  }
  let m = merge_joins(r, at);
  let kept: SBlock[] = [];
  for i in 0..m.blocks.len() {
    if (!m.gone[i]) {
      kept = kept.append(m.blocks[i]);
    }
  }
  return SelectRound { s: Selection { f: SFunc { ...f, nvals: r.nvals, blocks: kept }, from: m.from, to: m.to }, changed: true };
}

// joins holds a head position, then its join position, for each flattened diamond.
struct Flattening { blocks: SBlock[], busy: boolean[], gone: boolean[], nvals: i32, changed: boolean, joins: i32[] }

struct Merging { blocks: SBlock[], gone: boolean[], from: i32[], to: i32[] }

// merge_joins folds each flattened join into its head, which now ends in a
// jump to it. The diamonds of one round share no block, so no head is folded.
function merge_joins(r: Flattening, at: i32[]): Merging {
  let m = Merging { blocks: r.blocks, gone: r.gone, from: [], to: [] };
  let k = 0;
  while (k + 1 < r.joins.len()) {
    m = merge_join(m, r.joins[k], r.joins[k + 1], at);
    k += 2;
  }
  return m;
}

function merge_join(m: Merging, h: i32, j: i32, at: i32[]): Merging {
  let hb = m.blocks[h];
  let jb = m.blocks[j];
  if (hb.term.kind_tag != TERM_BR || hb.term.target != jb.id || jb.preds.len() != 1 || jb.preds[0] != hb.id || has_phi(jb)) {
    return m;
  }
  let succ: i32[] = [distinct_successor_position(at, jb.term, 0), distinct_successor_position(at, jb.term, 1)];
  if (succ[0] == h || succ[1] == h) {
    return m;
  }
  let blocks = m.blocks.with(h, SBlock { ...hb, insts: util.append_all(hb.insts, jb.insts), term: jb.term });
  for s in succ {
    if (s >= 0) {
      blocks = blocks.with(s, SBlock { ...blocks[s], preds: renamed_pred(blocks[s].preds, jb.id, hb.id) });
    }
  }
  return Merging { blocks: blocks, gone: m.gone.with(j, true), from: m.from.append(jb.id), to: m.to.append(hb.id) };
}

function renamed_pred(preds: i32[], from: i32, to: i32): i32[] {
  let out: i32[] = [];
  for p in preds {
    out = out.append(if (p == from) { to } else { p });
  }
  return out;
}

function flatten_diamond(f: SFunc, d: Diamond, r: Flattening): Flattening {
  let head = f.blocks[d.head];
  let insts = hoisted(head, util.append_all(arm_insts(f, d.t), arm_insts(f, d.f)));
  r = drop_arm(drop_arm(Flattening { ...r, busy: r.busy.with(d.head, true), changed: true }, d.t), d.f);
  if (d.join >= 0) {
    let j = f.blocks[d.join];
    let picks = join_selects(j, head.term.cond, arm_source(f, head, d.t), arm_source(f, head, d.f));
    let blocks = r.blocks.with(d.head, SBlock { ...head, insts: util.append_all(insts, picks), term: t_br(j.id) });
    return Flattening { ...r, blocks: blocks.with(d.join, SBlock { ...j, insts: without_phis(j.insts), preds: [head.id] }), busy: r.busy.with(d.join, true), joins: r.joins.append(d.head).append(d.join) };
  }
  let vt = f.blocks[d.t].term.value;
  let vf = f.blocks[d.f].term.value;
  if (vt == vf) {
    return Flattening { ...r, blocks: r.blocks.with(d.head, SBlock { ...head, insts: insts, term: t_ret(vt) }) };
  }
  let pick = SInst { kind_tag: SELECT, result: r.nvals, args: [head.term.cond, vt, vf], imm: 0, str: "" };
  return Flattening { ...r, blocks: r.blocks.with(d.head, SBlock { ...head, insts: insts.append(pick), term: t_ret(r.nvals) }), nvals: r.nvals + 1 };
}

function drop_arm(r: Flattening, arm: i32): Flattening {
  if (arm < 0) {
    return r;
  }
  return Flattening { ...r, busy: r.busy.with(arm, true), gone: r.gone.with(arm, true) };
}

function diamond_at(f: SFunc, at: i32[], fl: boolean[], p: i32): Diamond {
  let none = Diamond { ok: false, head: p, t: -1, f: -1, join: -1 };
  let head = f.blocks[p];
  let br = head.term;
  if (!two_way(head)) {
    return none;
  }
  let tp = position_of(at, br.t);
  let fp = position_of(at, br.f);
  if (tp < 0 || fp < 0) {
    return none;
  }
  let at_t = arm_at(f, tp, head.id);
  let at_f = arm_at(f, fp, head.id);
  if (!arms_fit(f, at_t, at_f)) {
    return none;
  }
  if (returns_picked(f, fl, at_t) && returns_picked(f, fl, at_f)) {
    return Diamond { ok: true, head: p, t: tp, f: fp, join: -1 };
  }
  let jp = join_of(f, at, p, tp, at_t, fp, at_f);
  if (jp < 0 || !select_join(f, fl, f.blocks[jp], arm_source(f, head, at_t), arm_source(f, head, at_f))) {
    return none;
  }
  return Diamond { ok: true, head: p, t: at_t, f: at_f, join: jp };
}

function arm_at(f: SFunc, p: i32, from: i32): i32 {
  if (select_arm(f.blocks[p], from)) {
    return p;
  }
  return -1;
}

function arms_fit(f: SFunc, at_t: i32, at_f: i32): boolean {
  if (at_t < 0 || at_f < 0) {
    return true;
  }
  return f.blocks[at_t].insts.len() + f.blocks[at_f].insts.len() <= select_arm_limit() + 1;
}

function returns_picked(f: SFunc, fl: boolean[], a: i32): boolean {
  if (a < 0) {
    return false;
  }
  let t = f.blocks[a].term;
  return t.kind_tag == TERM_RET && t.value >= 0 && !picks_float(fl, t.value);
}

function join_of(f: SFunc, at: i32[], p: i32, tp: i32, at_t: i32, fp: i32, at_f: i32): i32 {
  if (at_t < 0 && at_f < 0) {
    return -1;
  }
  let jt = arm_exit(f, at, tp, at_t);
  let jf = arm_exit(f, at, fp, at_f);
  if (jt < 0 || jt != jf || jt == p) {
    return -1;
  }
  return jt;
}

function arm_exit(f: SFunc, at: i32[], p: i32, arm: i32): i32 {
  if (arm < 0) {
    return p;
  }
  let t = f.blocks[arm].term;
  if (t.kind_tag != TERM_BR) {
    return -1;
  }
  return position_of(at, t.target);
}

function two_way(head: SBlock): boolean {
  let br = head.term;
  return br.kind_tag == TERM_BRIF && br.t != br.f && !tested_by_call(head, br.cond);
}

function tested_by_call(head: SBlock, cond: i32): boolean {
  for ins in head.insts {
    if (ins.result == cond && ins.kind_tag == UNARY && ins.str == "!") {
      return tested_by_call(head, ins.args[0]);
    }
    if (ins.result == cond) {
      return inst_is_call(ins.kind_tag);
    }
  }
  return false;
}

function select_arm(b: SBlock, from: i32): boolean {
  if (b.preds.len() != 1 || b.preds[0] != from || b.insts.len() > select_arm_limit()) {
    return false;
  }
  if (b.term.kind_tag != TERM_RET && b.term.kind_tag != TERM_BR) {
    return false;
  }
  for ins in b.insts {
    if (!speculable(ins)) {
      return false;
    }
  }
  return true;
}

function speculable(ins: SInst): boolean {
  let k = ins.kind_tag;
  if (k == CONST_INT || k == CONST_BOOL || k == CONST_I64 || k == COPY) {
    return true;
  }
  if (k == BINARY) {
    return int_binary(ins.str);
  }
  if (k == UNARY) {
    return int_unary(ins.str);
  }
  return false;
}

function int_unary(op: string): boolean {
  if (util.has_str(["!", "int_extend", "int_wrap", "u32_wrap"], op)) {
    return true;
  }
  for pre in ["int_cast:", "rotr:", "bswap:", "clz:", "ctz:", "popcount:"] {
    if (op.starts_with(pre)) {
      return true;
    }
  }
  return false;
}

function select_join(f: SFunc, fl: boolean[], j: SBlock, from_t: i32, from_f: i32): boolean {
  if (j.preds.len() != 2 || !has_pred(j.preds, from_t) || !has_pred(j.preds, from_f)) {
    return false;
  }
  let phis = 0;
  for ins in j.insts {
    if (ins.kind_tag == PHI) {
      if (ins.args.len() != 2 || picks_float(fl, ins.result)) {
        return false;
      }
      phis += 1;
    }
  }
  return phis <= 2;
}

function picks_float(fl: boolean[], v: i32): boolean {
  return v >= 0 && v < fl.len() && fl[v];
}

function arm_source(f: SFunc, head: SBlock, arm: i32): i32 {
  if (arm < 0) {
    return head.id;
  }
  return f.blocks[arm].id;
}

function arm_insts(f: SFunc, arm: i32): SInst[] {
  if (arm < 0) {
    return [];
  }
  return f.blocks[arm].insts;
}

function diamond_busy(busy: boolean[], d: Diamond): boolean {
  return busy[d.head] || d.t >= 0 && busy[d.t] || d.f >= 0 && busy[d.f] || d.join >= 0 && busy[d.join];
}

function hoisted(head: SBlock, arms: SInst[]): SInst[] {
  let n = head.insts.len();
  if (n == 0 || head.insts[n - 1].result != head.term.cond || head.insts[n - 1].kind_tag == PHI || arms_read(arms, head.term.cond)) {
    return util.append_all(head.insts, arms);
  }
  let out = util.append_all(slice_insts(head.insts, 0, n - 1), arms);
  return out.append(head.insts[n - 1]);
}

function arms_read(arms: SInst[], v: i32): boolean {
  for ins in arms {
    if (reads_value(ins, v)) {
      return true;
    }
  }
  return false;
}

pub function select_run(blk: SBlock, ii: i32): i32[] {
  let c = blk.insts[ii].args[0];
  let lo = ii;
  while (lo > 0 && blk.insts[lo - 1].kind_tag == SELECT && blk.insts[lo - 1].args[0] == c) {
    lo -= 1;
  }
  let hi = ii + 1;
  while (hi < blk.insts.len() && blk.insts[hi].kind_tag == SELECT && blk.insts[hi].args[0] == c) {
    hi += 1;
  }
  return [lo, hi];
}

function join_selects(j: SBlock, cond: i32, from_t: i32, from_f: i32): SInst[] {
  let picks: SInst[] = [];
  let copies: SInst[] = [];
  for ins in j.insts {
    if (ins.kind_tag == PHI) {
      let vt = ins.args[pred_slot(j, from_t)];
      let vf = ins.args[pred_slot(j, from_f)];
      if (vt == vf) {
        copies = copies.append(SInst { kind_tag: COPY, result: ins.result, args: [vt], imm: 0, str: "" });
      } else {
        picks = picks.append(SInst { kind_tag: SELECT, result: ins.result, args: [cond, vt, vf], imm: 0, str: "" });
      }
    }
  }
  return util.append_all(picks, copies);
}

function without_phis(insts: SInst[]): SInst[] {
  let out: SInst[] = [];
  for ins in insts {
    if (ins.kind_tag != PHI) {
      out = out.append(ins);
    }
  }
  return out;
}

function slice_insts(a: SInst[], lo: i32, hi: i32): SInst[] {
  let out: SInst[] = [];
  for i in lo..hi {
    out = out.append(a[i]);
  }
  return out;
}

pub struct Formed { f: SFunc, repl: i32[] }

function formed_by(f: SFunc, repl: i32[]): Formed {
  let flat: i32[] = [];
  for i in 0..repl.len() {
    flat = flat.append(resolve_repl(repl, i));
  }
  return Formed { f: f, repl: flat };
}

function compose_repl(a: i32[], b: i32[]): i32[] {
  if (a.len() == 0) {
    return b;
  }
  if (b.len() == 0) {
    return a;
  }
  let out: i32[] = [];
  for v in a {
    if (v >= 0 && v < b.len()) {
      out = out.append(b[v]);
    } else {
      out = out.append(v);
    }
  }
  return out;
}

pub function register_form(f: SFunc): Formed {
  let folded = prune_trivial_phis(slot_calls(without_lines(f)));
  let merged = merge_duplicates(folded.f);
  let plain = fold_identities(merged.f);
  let shared = share_shape_loads(plain.f);
  let unwrapped = drop_low_wraps(prune_dead(fold_offsets(fuse_rotates(fold_lane_identities(shared.f)))));
  let extended = fold_extensions(unwrapped.f);
  let g = extended.f;
  let bytes = fold_byte_access(g);
  if (bytes.repl.len() > 0) {
    g = prune_dead(bytes.f);
  }
  let t = thread_bool_joins(g);
  if (t.changed) {
    g = prune_dead(t.f);
  }
  let fw = thread_forwarding(g);
  g = fw.f;
  let trimmed: i32[] = [];
  if (fw.changed) {
    // A join that lost a predecessor can be left with one value on every edge.
    let pruned = prune_trivial_phis(prune_dead(g));
    g = pruned.f;
    trimmed = pruned.repl;
  }
  g = combine_byte_stores(zero_extended_indices(drop_null_counts(g)));
  return Formed { f: g, repl: compose_repl(compose_repl(compose_repl(compose_repl(compose_repl(compose_repl(compose_repl(folded.repl, merged.repl), plain.repl), shared.repl), unwrapped.repl), extended.repl), bytes.repl), trimmed) };
}

// A count taken or given back on a constant null does nothing: the runtime
// entries return at the floor test. The instruction goes.
pub function drop_null_counts(f: SFunc): SFunc {
  if (!counts_a_null(f)) {
    return f;
  }
  let defs = inst_defs(f);
  let uses = use_counts(f);
  let nblocks: SBlock[] = [];
  let changed = false;
  for blk in f.blocks {
    let kept = without_null_counts(blk, defs, uses);
    changed = changed || kept.insts.len() != blk.insts.len();
    nblocks = nblocks.append(kept);
  }
  if (!changed) {
    return f;
  }
  return SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: nblocks, entry: f.entry, takes_env: f.takes_env };
}

// Whether the function holds both a zero constant and a count call, so the
// common function pays one scan and no allocation.
function counts_a_null(f: SFunc): boolean {
  let zero = false;
  let counts = false;
  for blk in f.blocks {
    for ins in blk.insts {
      zero = zero || zero_constant(ins);
      counts = counts || count_call(ins);
    }
  }
  return zero && counts;
}

function zero_constant(ins: SInst): boolean {
  if (ins.result < 0) {
    return false;
  }
  if (ins.kind_tag == CONST_INT) {
    return ins.imm == 0;
  }
  return ins.kind_tag == CONST_I64 && ins.str.len() > 0 && util.lit_to_i64(ins.str) == 0i64;
}

function without_null_counts(blk: SBlock, defs: SInst[], uses: i32[]): SBlock {
  let ninsts: SInst[] = [];
  for ins in blk.insts {
    if (!null_count(ins, defs, uses)) {
      ninsts = ninsts.append(ins);
    }
  }
  if (ninsts.len() == blk.insts.len()) {
    return blk;
  }
  return SBlock { id: blk.id, insts: ninsts, term: blk.term, preds: blk.preds };
}

function count_call(ins: SInst): boolean {
  return ins.kind_tag == CALL && ins.args.len() == 1 && (ins.str == "__fern_rc_dec" || ins.str == "__fern_rc_inc");
}

function null_count(ins: SInst, defs: SInst[], uses: i32[]): boolean {
  if (!count_call(ins) || ins.result >= 0 && ins.result < uses.len() && uses[ins.result] > 0) {
    return false;
  }
  return const_is(defs, ins.args[0], 0i64);
}

// An index reads a sign- and a zero-extended i32 the same: no length reaches 2^31, so a negative index fails either way.
pub function zero_extended_indices(f: SFunc): SFunc {
  let at_index = __alloc_i32(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag >= ARR_AT && ins.kind_tag <= STR_AT && ins.args.len() >= 2 && ins.args[1] >= 0 && ins.args[1] < f.nvals) {
        at_index = at_index.with(ins.args[1], at_index[ins.args[1]] + 1);
      }
    }
  }
  let uses = use_counts(f);
  let zero = __alloc_bool(f.nvals);
  let any = false;
  for blk in f.blocks {
    for ins in blk.insts {
      if (signed_extension(ins) && ins.result >= 0 && ins.result < f.nvals && uses[ins.result] > 0 && at_index[ins.result] == uses[ins.result]) {
        zero = zero.with(ins.result, true);
        any = true;
      }
    }
  }
  if (!any) {
    return f;
  }
  let blocks: SBlock[] = [];
  for blk in f.blocks {
    let insts: SInst[] = [];
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals && zero[ins.result]) {
        insts = insts.append(SInst { ...ins, str: "u32_wrap" });
      } else {
        insts = insts.append(ins);
      }
    }
    blocks = blocks.append(SBlock { ...blk, insts: insts });
  }
  return SFunc { ...f, blocks: blocks };
}

function lane_constant_fact(ins: SInst): i32 {
  if (ins.kind_tag != CONST_FLOAT) {
    return 0;
  }
  if (ins.str == "0") {
    return 1;
  }
  return if (ins.str == "4611686018427387904") { 2 } else { 0 };
}

function lane_identity(ins: SInst, facts: i32[]): SInst {
  if (ins.kind_tag == LANE3 && ins.str == "vselect" && ins.args.len() == 3) {
    if (facts[ins.args[1]] == 1) {
      return SInst { ...ins, kind_tag: BINARY, str: "vand", args: [ins.args[0], ins.args[2]] };
    }
    if (facts[ins.args[0]] == 1) {
      return SInst { ...ins, kind_tag: BINARY, str: "vandnot", args: [ins.args[1], ins.args[2]] };
    }
  }
  if (ins.kind_tag == BINARY && (ins.str == "vmul" || ins.str == "fmul") && (facts[ins.args[0]] == 2 || facts[ins.args[1]] == 2)) {
    let a = if (facts[ins.args[0]] == 2) { ins.args[1] } else { ins.args[0] };
    let op = if (ins.str == "fmul") { "fadd" } else { "vadd" };
    return SInst { ...ins, str: op, args: [a, a] };
  }
  return ins;
}

pub function fold_lane_identities(f: SFunc): SFunc {
  let has_two = false;
  let has_zero = false;
  let has_multiply = false;
  let has_select = false;
  for blk in f.blocks {
    for ins in blk.insts {
      let fact = lane_constant_fact(ins);
      has_two = has_two || fact == 2;
      has_zero = has_zero || fact == 1;
      has_multiply = has_multiply || ins.kind_tag == BINARY && (ins.str == "vmul" || ins.str == "fmul");
      has_select = has_select || ins.kind_tag == LANE3 && ins.str == "vselect";
    }
  }
  if (!(has_two && has_multiply || has_zero && has_select)) {
    return f;
  }
  let facts = __alloc_i32(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      let fact = lane_constant_fact(ins);
      if (fact != 0) {
        facts = facts.with(ins.result, fact);
      }
    }
  }
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == UNARY && ins.args.len() == 1 && (ins.str == "vsplat" || facts[ins.args[0]] == 1 && (ins.str == "f32_bits" || ins.str == "f32_from_bits"))) {
        facts = facts.with(ins.result, facts[ins.args[0]]);
      }
    }
  }
  let blocks: SBlock[] = [];
  for blk in f.blocks {
    let insts: SInst[] = [];
    for ins in blk.insts {
      insts = insts.append(lane_identity(ins, facts));
    }
    blocks = blocks.append(SBlock { ...blk, insts: insts });
  }
  return SFunc { ...f, blocks: blocks };
}

function without_lines(f: SFunc): SFunc {
  if (!has_kind(f, 35)) {
    return f;
  }
  let blocks: SBlock[] = [];
  for b in f.blocks {
    let insts: SInst[] = [];
    for ins in b.insts {
      if (ins.kind_tag != LINE) {
        insts = insts.append(ins);
      }
    }
    blocks = blocks.append(SBlock { ...b, insts: insts });
  }
  return SFunc { ...f, blocks: blocks };
}

pub function slot_call(ins: SInst): boolean {
  return ins.kind_tag == CALL_IND && ins.str == "slot";
}

function slot_calls(f: SFunc): SFunc {
  if (!has_kind(f, 56)) {
    return f;
  }
  let env_of = slot_reads(f);
  let uses = use_counts(f);
  let dropped = __alloc_bool(f.nvals);
  let found = false;
  for blk in f.blocks {
    for ins in blk.insts {
      if (reads_own_slot(ins, env_of, uses)) {
        dropped = dropped.with(ins.args[0], true);
        found = true;
      }
    }
  }
  if (!found) {
    return f;
  }
  let out: SBlock[] = [];
  for blk in f.blocks {
    out = out.append(slot_block(blk, env_of, uses, dropped));
  }
  return SFunc { ...f, blocks: out };
}

pub function has_kind(f: SFunc, k: i32): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == k) {
        return true;
      }
    }
  }
  return false;
}

function slot_reads(f: SFunc): i32[] {
  let zero = __alloc_bool(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == CONST_INT && ins.imm == 0) {
        zero = zero.with(ins.result, true);
      }
    }
  }
  let env_of = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == ARR_AT && ins.imm == 1 && ins.str == "" && zero[ins.args[1]]) {
        env_of = env_of.with(ins.result, ins.args[0]);
      }
    }
  }
  return env_of;
}

function slot_block(blk: SBlock, env_of: i32[], uses: i32[], dropped: boolean[]): SBlock {
  let edit = false;
  for ins in blk.insts {
    edit = edit || reads_own_slot(ins, env_of, uses) || ins.kind_tag == ARR_AT && dropped[ins.result];
  }
  if (!edit) {
    return blk;
  }
  let insts: SInst[] = [];
  for ins in blk.insts {
    if (reads_own_slot(ins, env_of, uses)) {
      insts = insts.append(SInst { ...ins, args: ins.args.with(0, ins.args[1]), str: "slot" });
    } else if (ins.kind_tag != ARR_AT || !dropped[ins.result]) {
      insts = insts.append(ins);
    }
  }
  return SBlock { ...blk, insts: insts };
}

function reads_own_slot(ins: SInst, env_of: i32[], uses: i32[]): boolean {
  return ins.kind_tag == CALL_IND && ins.args.len() > 1 && env_of[ins.args[0]] == ins.args[1] && uses[ins.args[0]] == 1;
}

function share_shape_loads(f: SFunc): Formed {
  let stored = __alloc_bool(f.nvals);
  let loads = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      let k = ins.kind_tag;
      if (k == 16 || k == 53 || k == 55) {
        return Formed { f: f, repl: [] };
      }
      if ((k == 41 && ins.imm == 0 || k == 43) && ins.args.len() > 0 && ins.args[0] >= 0 && ins.args[0] < f.nvals) {
        stored = stored.with(ins.args[0], true);
      }
      if (shape_load(ins, f.nvals)) {
        loads += 1;
      }
    }
  }
  if (loads < 2) {
    return Formed { f: f, repl: [] };
  }
  let at = block_positions(f);
  let repl: i32[] = [];
  for bi in 0..f.blocks.len() {
    let insts = f.blocks[bi].insts;
    for k in 0..insts.len() {
      let ins = insts[k];
      if (shape_load(ins, f.nvals) && !stored[ins.args[0]]) {
        let found = earlier_shape(f, at, bi, k, ins.args[0]);
        if (found >= 0) {
          if (repl.len() == 0) {
            repl = identity_repl(f.nvals);
          }
          repl = repl.with(ins.result, repl[found]);
        }
      }
    }
  }
  if (repl.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  return Formed { f: rewrite_through(f, repl), repl: repl };
}

function earlier_shape(f: SFunc, at: i32[], bi: i32, k: i32, box: i32): i32 {
  let b = bi;
  let j = k - 1;
  while (true) {
    while (j >= 0) {
      let ins = f.blocks[b].insts[j];
      if (shape_load(ins, f.nvals) && ins.args[0] == box) {
        return ins.result;
      }
      if (may_write(ins.kind_tag)) {
        return -1;
      }
      j -= 1;
    }
    if (f.blocks[b].preds.len() != 1) {
      return -1;
    }
    let pb = position_of(at, f.blocks[b].preds[0]);
    if (pb < 0 || pb >= b) {
      return -1;
    }
    b = pb;
    j = f.blocks[b].insts.len() - 1;
  }
}

function may_write(k: i32): boolean {
  return inst_has_effect(k) && k != LINE && k != ARR_AT && k != STR_AT;
}

function shape_load(ins: SInst, nvals: i32): boolean {
  return ins.kind_tag == LD_AT && ins.imm == 0 && ins.args.len() == 1 && ins.args[0] >= 0 && ins.args[0] < nvals && ins.result >= 0 && ins.result < nvals && ins.str == "";
}

pub function fold_byte_access(f: SFunc): Formed {
  if (!has_byte_access(f)) {
    return Formed { f: f, repl: [] };
  }
  let def_b = __alloc_i32(f.nvals);
  let def_k = __alloc_i32(f.nvals);
  for i in 0..f.nvals {
    def_b = def_b.with(i, -1);
    def_k = def_k.with(i, -1);
  }
  for bi in 0..f.blocks.len() {
    let k = 0;
    while (k < f.blocks[bi].insts.len()) {
      let r = f.blocks[bi].insts[k].result;
      if (r >= 0 && r < f.nvals) {
        def_b = def_b.with(r, bi);
        def_k = def_k.with(r, k);
      }
      k += 1;
    }
  }
  let uses = use_counts(f);
  let changed = false;
  let nblocks: SBlock[] = [];
  for blk in f.blocks {
    let ninsts: SInst[] = [];
    for ins0 in blk.insts {
      let ins = ins0;
      if ((ins.kind_tag == LD_BYTE || ins.kind_tag == ST_BYTE) && const_zero(f, def_b, def_k, ins.args[1])) {
        let base = ins.args[0];
        let d = def_at(f, def_b, def_k, base);
        if (d.kind_tag == BINARY && d.str == "add" && d.imm == 64 && d.args.len() == 2 && base >= 0 && base < uses.len() && uses[base] == 1) {
          let nargs: i32[] = [d.args[0], d.args[1]];
          if (ins.kind_tag == ST_BYTE) {
            nargs = nargs.append(ins.args[2]);
          }
          ins = SInst { ...ins, args: nargs };
          changed = true;
        }
      }
      ninsts = ninsts.append(ins);
    }
    nblocks = nblocks.append(SBlock { ...blk, insts: ninsts });
  }
  if (!changed) {
    return Formed { f: f, repl: [] };
  }
  return Formed { f: SFunc { ...f, blocks: nblocks }, repl: identity_repl(f.nvals) };
}

function has_byte_access(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == LD_BYTE || ins.kind_tag == ST_BYTE) {
        return true;
      }
    }
  }
  return false;
}

// What a register is known to hold: a sign-extended i32, a zero-extended u32,
// or a byte, which is both.
const EXT_I32: i32 = 1;

const EXT_U32: i32 = 2;

const EXT_BYTE: i32 = 7;

// Replaces a wrap, extension or narrowing cast by its operand when the
// operand's register already holds the result. A phi or a select holds what
// all its operands hold. The facts start full and only shrink, so a loop
// phi keeps what its back edge keeps.
pub function fold_extensions(f: SFunc): Formed {
  if (!has_extension(f)) {
    return Formed { f: f, repl: [] };
  }
  let d = def_sites_of(f);
  let facts = ext_facts(f, d);
  if (facts.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  let repl = dropped_extensions(f, facts);
  if (repl.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  let flat = formed_by(f, repl);
  return Formed { f: rewrite_through(f, flat.repl), repl: flat.repl };
}

// Native 32-bit right shifts preserve a proven narrow source. Mode 1 needs
// sign extension afterwards; mode 2 already has a zero-extended result.
// Other shifts retain their full-width physical IR semantics.
pub function narrow_right_shifts(f: SFunc, imm: Imms): i32[] {
  let any = false;
  for blk in f.blocks {
    for ins in blk.insts {
      any = any || narrow_shift_candidate(ins, imm);
    }
  }
  if (!any) {
    return [];
  }
  let facts = ext_facts(f, def_sites_of(f));
  if (facts.len() == 0) {
    return [];
  }
  let modes = __alloc_i32(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (narrow_shift_candidate(ins, imm)) {
        let held = fact_of(facts, ins.args[0]);
        if (ins.str == "shr_s" && (held & EXT_I32) != 0) {
          modes = modes.with(ins.result, if ((held & EXT_U32) != 0) { 2 } else { 1 });
        } else if (ins.str == "shr_u" && (held & EXT_U32) != 0) {
          modes = modes.with(ins.result, 2);
        }
      }
    }
  }
  return modes;
}

function narrow_shift_candidate(ins: SInst, imm: Imms): boolean {
  return ins.kind_tag == BINARY && ins.args.len() == 2 && ins.imm != 64
    && (ins.str == "shr_s" || ins.str == "shr_u") && !imm.is_imm[ins.args[1]];
}

pub struct DefSites { block: i32[], at: i32[] }

pub function def_sites_of(f: SFunc): DefSites {
  let blk = util.minus_ones(f.nvals);
  let at = util.minus_ones(f.nvals);
  for bi in 0..f.blocks.len() {
    for k in 0..f.blocks[bi].insts.len() {
      let r = f.blocks[bi].insts[k].result;
      if (r >= 0 && r < f.nvals) {
        blk = blk.with(r, bi);
        at = at.with(r, k);
      }
    }
  }
  return DefSites { block: blk, at: at };
}

// The fixed point, or [] when 64 rounds do not settle it.
function ext_facts(f: SFunc, d: DefSites): i32[] {
  let facts = __alloc_i32(f.nvals);
  for v in 0..f.nvals {
    if (d.block[v] >= 0) {
      facts = facts.with(v, EXT_BYTE);
    }
  }
  for round in 0..64 {
    let next = ext_round(f, d, facts);
    if (next.len() == 0) {
      return facts;
    }
    facts = next;
  }
  return [];
}

// One pass over the instructions, or [] when no fact shrank.
function ext_round(f: SFunc, d: DefSites, facts: i32[]): i32[] {
  let changed = false;
  for blk in f.blocks {
    for ins in blk.insts {
      let r = ins.result;
      if (r >= 0 && r < f.nvals) {
        let x = ext_transfer(f, d.block, d.at, facts, ins) & facts[r];
        changed = changed || x != facts[r];
        facts = facts.with(r, x);
      }
    }
  }
  if (!changed) {
    return [];
  }
  return facts;
}

// The replacement map, or [] when no extension goes.
function dropped_extensions(f: SFunc, facts: i32[]): i32[] {
  let repl = identity_repl(f.nvals);
  let dropped = false;
  for blk in f.blocks {
    for ins in blk.insts {
      if (drops(f, facts, ins)) {
        repl = repl.with(ins.result, ins.args[0]);
        dropped = true;
      }
    }
  }
  if (!dropped) {
    return [];
  }
  return repl;
}

function drops(f: SFunc, facts: i32[], ins: SInst): boolean {
  return ins.result >= 0 && ins.result < f.nvals && ins.args.len() == 1 && ins.args[0] >= 0 && ins.args[0] < f.nvals && holds_result(ins, facts[ins.args[0]]);
}

function has_extension(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (signed_extension(ins) || unsigned_extension(ins) || ins.kind_tag == UNARY && ins.str == "int_cast:u8") {
        return true;
      }
    }
  }
  return false;
}

function signed_extension(ins: SInst): boolean {
  return ins.kind_tag == UNARY && ins.args.len() == 1 && ins.imm == 0 && (ins.str == "int_wrap" || ins.str == "int_extend" || ins.str == "int_cast:i32");
}

function unsigned_extension(ins: SInst): boolean {
  if (ins.kind_tag != UNARY || ins.args.len() != 1) {
    return false;
  }
  return ins.str == "u32_wrap" || ins.str == "int_cast:u32" || ins.imm != 0 && (ins.str == "int_wrap" || ins.str == "int_extend");
}

function holds_result(ins: SInst, held: i32): boolean {
  if (signed_extension(ins)) {
    return (held & EXT_I32) != 0;
  }
  if (unsigned_extension(ins)) {
    return (held & EXT_U32) != 0;
  }
  return ins.kind_tag == UNARY && ins.str == "int_cast:u8" && held == EXT_BYTE;
}

function ext_transfer(f: SFunc, def_b: i32[], def_k: i32[], facts: i32[], ins: SInst): i32 {
  let k = ins.kind_tag;
  if (k >= CONST_INT && k <= CONST_I64) {
    return constant_facts(ins);
  }
  if (k == COPY || k == PHI) {
    return shared_facts(facts, ins.args, 0);
  }
  if (k == SELECT) {
    return shared_facts(facts, ins.args, 1);
  }
  if (byte_source(f, def_b, def_k, ins)) {
    return EXT_BYTE;
  }
  if (k == BINARY) {
    return binary_facts(f, def_b, def_k, facts, ins);
  }
  if (k == UNARY && ins.args.len() == 1) {
    return unary_facts(ins, fact_of(facts, ins.args[0]));
  }
  return 0;
}

function constant_facts(ins: SInst): i32 {
  if (ins.kind_tag == CONST_INT) {
    return const_facts(ins.imm as i64);
  }
  if (ins.kind_tag == CONST_BOOL) {
    return EXT_BYTE;
  }
  return const_facts(util.lit_to_i64(ins.str));
}

function const_facts(c: i64): i32 {
  if (c >= 0i64 && c <= 255i64) {
    return EXT_BYTE;
  }
  let out = 0;
  if (c >= 0 - 2147483648i64 && c <= 2147483647i64) {
    out = EXT_I32;
  }
  if (c >= 0i64 && c <= 4294967295i64) {
    out = out | EXT_U32;
  }
  return out;
}

function fact_of(facts: i32[], v: i32): i32 {
  if (v < 0 || v >= facts.len()) {
    return 0;
  }
  return facts[v];
}

function shared_facts(facts: i32[], args: i32[], from: i32): i32 {
  let out = EXT_BYTE;
  for i in from..args.len() {
    out = out & fact_of(facts, args[i]);
  }
  return out;
}

function binary_facts(f: SFunc, def_b: i32[], def_k: i32[], facts: i32[], ins: SInst): i32 {
  if (ins.args.len() != 2) {
    return 0;
  }
  if (compare_op(ins.str)) {
    return EXT_BYTE;
  }
  if (ins.str == "and") {
    return and_facts(fact_of(facts, ins.args[0]), fact_of(facts, ins.args[1]));
  }
  let source = fact_of(facts, ins.args[0]);
  if (ins.str == "shr_s" && (source & EXT_I32) != 0) {
    return source;
  }
  if (ins.str == "shr_u" && (source & EXT_U32) != 0) {
    let result = source | narrowed_facts(f, def_b, def_k, ins.args[1]);
    if (ins.imm == 64) {
      result = result | shifted_facts(f, def_b, def_k, ins.args[1]);
    }
    return result;
  }
  if (ins.str == "shr_u" && ins.imm == 64) {
    return shifted_facts(f, def_b, def_k, ins.args[1]);
  }
  return 0;
}

// A u32 shifted right by a constant from 1 to 31 is a non-negative i32.
function narrowed_facts(f: SFunc, def_b: i32[], def_k: i32[], count: i32): i32 {
  if (const_in(f, def_b, def_k, count, 24i64, 31i64)) {
    return EXT_BYTE;
  }
  if (const_in(f, def_b, def_k, count, 1i64, 31i64)) {
    return 3;
  }
  return 0;
}

function compare_op(op: string): boolean {
  return op == "eq" || op == "ne" || op.starts_with("lt_") || op.starts_with("le_") || op.starts_with("gt_") || op.starts_with("ge_");
}

// An and with a byte is a byte, and one with a non-negative i32 is one.
function and_facts(a: i32, b: i32): i32 {
  if ((a | b) == EXT_BYTE) {
    return EXT_BYTE;
  }
  if ((a & 3) == 3 || (b & 3) == 3) {
    return 3;
  }
  return (a | b) & EXT_U32;
}

function shifted_facts(f: SFunc, def_b: i32[], def_k: i32[], count: i32): i32 {
  if (const_in(f, def_b, def_k, count, 56i64, 63i64)) {
    return EXT_BYTE;
  }
  if (const_in(f, def_b, def_k, count, 33i64, 63i64)) {
    return 3;
  }
  if (const_in(f, def_b, def_k, count, 32i64, 63i64)) {
    return EXT_U32;
  }
  return 0;
}

function unary_facts(ins: SInst, held: i32): i32 {
  if (ins.str == "load_i32") {
    return EXT_I32;
  }
  if (signed_extension(ins)) {
    if ((held & EXT_I32) != 0) {
      return held;
    }
    return EXT_I32;
  }
  if (unsigned_extension(ins)) {
    if ((held & EXT_U32) != 0) {
      return held;
    }
    return EXT_U32;
  }
  if (ins.str == "int_cast:u8" || ins.str.starts_with("ctz:") || ins.str.starts_with("clz:") || ins.str.starts_with("popcount:")) {
    return EXT_BYTE;
  }
  return 0;
}

function byte_source(f: SFunc, def_b: i32[], def_k: i32[], ins: SInst): boolean {
  if (ins.kind_tag == LD_BYTE) {
    return true;
  }
  if (ins.kind_tag == ARR_AT || ins.kind_tag == STR_AT) {
    return ins.imm != 2 && (ins.kind_tag == STR_AT || ins.str == "u8");
  }
  if (ins.kind_tag == BINARY && ins.str == "and" && ins.args.len() == 2) {
    return const_in(f, def_b, def_k, ins.args[0], 0i64, 255i64) || const_in(f, def_b, def_k, ins.args[1], 0i64, 255i64);
  }
  return false;
}

function const_zero(f: SFunc, def_b: i32[], def_k: i32[], v: i32): boolean {
  return const_in(f, def_b, def_k, v, 0i64, 0i64);
}

function const_in(f: SFunc, def_b: i32[], def_k: i32[], v: i32, lo: i64, hi: i64): boolean {
  let d = def_at(f, def_b, def_k, v);
  if (d.kind_tag == CONST_INT) {
    return d.imm as i64 >= lo && d.imm as i64 <= hi;
  }
  if (d.kind_tag == CONST_I64) {
    let c = util.lit_to_i64(d.str);
    return c >= lo && c <= hi;
  }
  return false;
}

pub function drop_low_wraps(f: SFunc): Formed {
  if (!has_low_wrap(f)) {
    return Formed { f: f, repl: [] };
  }
  let def_b = __alloc_i32(f.nvals);
  let def_k = __alloc_i32(f.nvals);
  let required = __alloc_i32(f.nvals);
  let prop = __alloc_bool(f.nvals);
  let i = 0;
  while (i < f.nvals) {
    def_b = def_b.with(i, -1);
    def_k = def_k.with(i, -1);
    i += 1;
  }
  let wraps: i32[] = [];
  let wrap_arg: i32[] = [];
  for bi in 0..f.blocks.len() {
    let insts = f.blocks[bi].insts;
    for k in 0..insts.len() {
      let ins = insts[k];
      let r = ins.result;
      if (r >= 0 && r < f.nvals) {
        def_b = def_b.with(r, bi);
        def_k = def_k.with(r, k);
        if (demand_propagates(ins)) {
          prop = prop.with(r, true);
        }
        if (low_wrap(ins)) {
          wraps = wraps.append(r);
          wrap_arg = wrap_arg.append(ins.args[0]);
        }
      }
    }
  }
  let work: i32[] = [];
  // Fixed operand requirements are seeded once. Only operations whose
  // operands depend on result demand need to enter the worklist.
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.result < 0 || ins.result >= f.nvals || !prop[ins.result]) {
        for ai in 0..ins.args.len() {
          let a = ins.args[ai];
          if (a >= 0 && a < f.nvals && prop[a]) {
            let bits = operand_bits(ins, ai, 0, f, def_b, def_k);
            if (bits > required[a]) {
              required = required.with(a, bits);
              work = work.append(a);
            }
          }
        }
      }
    }
    let tv = term_operand(blk.term);
    if (tv >= 0 && tv < f.nvals && prop[tv] && required[tv] < 64) {
      required = required.with(tv, 64);
      work = work.append(tv);
    }
  }
  let wi = 0;
  while (wi < work.len()) {
    let v = work[wi];
    wi += 1;
    let ins = def_at(f, def_b, def_k, v);
    for ai in 0..ins.args.len() {
      let a = ins.args[ai];
      if (a >= 0 && a < f.nvals && prop[a]) {
        let bits = operand_bits(ins, ai, required[v], f, def_b, def_k);
        if (bits > required[a]) {
          required = required.with(a, bits);
          work = work.append(a);
        }
      }
    }
  }
  let repl: i32[] = [];
  let dropped = false;
  let at = block_positions(f);
  let heads = signed_compare_heads(f, def_b, def_k);
  for wj in 0..wraps.len() {
    let w = wraps[wj];
    if (required[w] <= low_wrap_bits(def_at(f, def_b, def_k, w)) || signed_extension(def_at(f, def_b, def_k, w)) && counter_step(f, at, heads, def_b, def_k, wrap_arg[wj])) {
      if (!dropped) {
        for i in 0..f.nvals {
          repl = repl.append(i);
        }
        dropped = true;
      }
      repl = repl.with(w, wrap_arg[wj]);
    }
  }
  if (!dropped) {
    return Formed { f: f, repl: [] };
  }
  let nblocks: SBlock[] = [];
  for blk in f.blocks {
    if (!block_reads_replaced(blk, repl)) {
      nblocks = nblocks.append(blk);
      continue;
    }
    let ninsts: SInst[] = [];
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals && repl[ins.result] != ins.result) {
        continue;
      }
      let nargs: i32[] = [];
      for a in ins.args {
        nargs = nargs.append(resolve_repl(repl, a));
      }
      ninsts = ninsts.append(SInst { ...ins, args: nargs });
    }
    let t = blk.term;
    if (t.kind_tag == TERM_RET) {
      t = STerm { ...t, value: resolve_repl(repl, t.value) };
    } else if (t.kind_tag == TERM_BRIF) {
      t = STerm { ...t, cond: resolve_repl(repl, t.cond) };
    }
    nblocks = nblocks.append(SBlock { ...blk, insts: ninsts, term: t });
  }
  return formed_by(SFunc { ...f, blocks: nblocks }, repl);
}

function has_low_wrap(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (low_wrap(ins)) {
        return true;
      }
    }
  }
  return false;
}

function block_reads_replaced(blk: SBlock, repl: i32[]): boolean {
  for ins in blk.insts {
    if (ins.result >= 0 && ins.result < repl.len() && repl[ins.result] != ins.result) {
      return true;
    }
    for a in ins.args {
      if (a >= 0 && a < repl.len() && repl[a] != a) {
        return true;
      }
    }
  }
  let tv = term_operand(blk.term);
  return tv >= 0 && tv < repl.len() && repl[tv] != tv;
}

// x + 1 below a test that x is less than an i32, or x - 1 below a test that x is greater.
function counter_step(f: SFunc, at: i32[], heads: i32[], def_b: i32[], def_k: i32[], a: i32): boolean {
  let st = def_at(f, def_b, def_k, a);
  if (st.kind_tag != BINARY || st.imm == 64 || st.args.len() != 2) {
    return false;
  }
  if (st.str == "sub") {
    return const_one(f, def_b, def_k, st.args[1]) && tested(f, at, heads, def_b, def_k, st.args[0], def_b[a], false);
  }
  if (st.str != "add") {
    return false;
  }
  if (const_one(f, def_b, def_k, st.args[1])) {
    return tested(f, at, heads, def_b, def_k, st.args[0], def_b[a], true);
  }
  return const_one(f, def_b, def_k, st.args[0]) && tested(f, at, heads, def_b, def_k, st.args[1], def_b[a], true);
}

// Some branch on a signed compare of `v` reaches block `d` only on the edge where `v` is below (or above) the other operand.
function tested(f: SFunc, at: i32[], heads: i32[], def_b: i32[], def_k: i32[], v: i32, d: i32, below: boolean): boolean {
  for hi in heads {
    let h = f.blocks[hi];
    let t = h.term;
    let c = def_at(f, def_b, def_k, t.cond);
    let pass: i32 = -1;
    if (below && compares_below(c, v, "lt_s", "gt_s") || !below && compares_below(c, v, "gt_s", "lt_s")) {
      pass = t.t;
    } else if (below && compares_below(c, v, "ge_s", "le_s") || !below && compares_below(c, v, "le_s", "ge_s")) {
      pass = t.f;
    }
    let b = position_of(at, pass);
    if (b >= 0 && f.blocks[b].preds.len() == 1 && f.blocks[b].preds[0] == h.id && dominates_position(f, at, b, d)) {
      return true;
    }
  }
  return false;
}

// signed_compare_heads lists, in block order, the blocks whose two-way branch tests a signed compare.
function signed_compare_heads(f: SFunc, def_b: i32[], def_k: i32[]): i32[] {
  let out: i32[] = [];
  for hi in 0..f.blocks.len() {
    let t = f.blocks[hi].term;
    if (t.kind_tag == TERM_BRIF && t.t != t.f) {
      let c = def_at(f, def_b, def_k, t.cond);
      if (c.kind_tag == BINARY && c.imm != 64 && c.args.len() == 2 && (c.str == "lt_s" || c.str == "gt_s" || c.str == "ge_s" || c.str == "le_s")) {
        out = out.append(hi);
      }
    }
  }
  return out;
}

function dominates_position(f: SFunc, at: i32[], b: i32, d: i32): boolean {
  if (b == d) {
    return true;
  }
  let entry = position_of(at, f.entry);
  if (entry == b) {
    return true;
  }
  if (entry < 0 || d < 0) {
    return false;
  }
  let seen = __alloc_bool(f.blocks.len());
  seen = seen.with(d, true);
  let stack: i32[] = [d];
  let si = 0;
  while (si < stack.len()) {
    let cur = stack[si];
    si += 1;
    if (cur == entry) {
      return false;
    }
    for pid in f.blocks[cur].preds {
      let p = position_of(at, pid);
      if (p < 0) {
        return false;
      }
      if (p != b && !seen[p]) {
        seen = seen.with(p, true);
        stack = stack.append(p);
      }
    }
  }
  return true;
}

function compares_below(c: SInst, o: i32, first: string, second: string): boolean {
  if (c.kind_tag != BINARY || c.imm == 64 || c.args.len() != 2) {
    return false;
  }
  return c.str == first && c.args[0] == o || c.str == second && c.args[1] == o;
}

function const_one(f: SFunc, def_b: i32[], def_k: i32[], v: i32): boolean {
  let d = def_at(f, def_b, def_k, v);
  return d.kind_tag == CONST_INT && d.imm == 1;
}

function def_at(f: SFunc, def_b: i32[], def_k: i32[], v: i32): SInst {
  if (v < 0 || v >= def_b.len() || def_b[v] < 0) {
    return no_inst();
  }
  return f.blocks[def_b[v]].insts[def_k[v]];
}

function low_wrap(ins: SInst): boolean {
  return signed_extension(ins) || ins.kind_tag == UNARY && ins.args.len() == 1 && (ins.str == "u32_wrap" || ins.str == "int_cast:u32" || ins.str == "int_cast:u8");
}

function low_half_binary(op: string): boolean {
  return op == "add" || op == "sub" || op == "mul" || op == "and" || op == "or" || op == "xor";
}

function demand_propagates(ins: SInst): boolean {
  if (ins.kind_tag == COPY || ins.kind_tag == PHI) {
    return true;
  }
  if (ins.kind_tag == BINARY) {
    return low_half_binary(ins.str) || ins.str == "shl" || ins.str == "shr_s" || ins.str == "shr_u";
  }
  return ins.kind_tag == UNARY && (low_wrap(ins) || ins.str == "int_wrap" || ins.str == "int_extend");
}

// A five-level lattice bounds worklist growth even when shifts feed a phi.
function demand_bits(n: i32): i32 {
  if (n <= 0) {
    return 0;
  }
  if (n <= 8) {
    return 8;
  }
  if (n <= 16) {
    return 16;
  }
  if (n <= 32) {
    return 32;
  }
  return 64;
}

function low_wrap_bits(ins: SInst): i32 {
  if (ins.str == "int_cast:u8") {
    return 8;
  }
  return 32;
}

function constant_bits(ins: SInst): i32 {
  let value = -1i64;
  if (ins.kind_tag == CONST_INT) {
    value = ins.imm as i64;
  } else if (ins.kind_tag == CONST_I64) {
    value = util.lit_to_i64(ins.str);
  }
  if (value < 0) {
    return 64;
  }
  if (value == 0) {
    return 0;
  }
  if (value <= 255i64) {
    return 8;
  }
  if (value <= 65535i64) {
    return 16;
  }
  if (value <= 4294967295i64) {
    return 32;
  }
  return 64;
}

// The low result bits of arithmetic and logic depend only on the same
// low operand bits. A constant right shift can bring higher bits down;
// variable right shifts conservatively observe the whole source.
function operand_bits(ins: SInst, k: i32, result: i32, f: SFunc, def_b: i32[], def_k: i32[]): i32 {
  if (ins.kind_tag == ST_AT && k == 1) {
    if (ins.str == "u8") {
      return 8;
    }
    if (ins.str == "i32") {
      return 32;
    }
  }
  if (ins.kind_tag == COPY || ins.kind_tag == PHI) {
    return result;
  }
  if (ins.kind_tag == BINARY) {
    if (low_half_binary(ins.str)) {
      if (ins.str == "and" && ins.args.len() == 2) {
        let limit = constant_bits(def_at(f, def_b, def_k, ins.args[1 - k]));
        if (limit < result) {
          return limit;
        }
      }
      return result;
    }
    if (ins.str == "shl") {
      if (k == 1) {
        return 32;
      }
      return result;
    }
    if (ins.str == "shr_s" || ins.str == "shr_u") {
      if (k == 1) {
        return 32;
      }
      if (result == 0) {
        return 0;
      }
      let count = def_at(f, def_b, def_k, ins.args[1]);
      if (count.kind_tag != CONST_INT && count.kind_tag != CONST_I64) {
        return 64;
      }
      let n = count.imm as i64;
      if (count.kind_tag == CONST_I64) {
        n = util.lit_to_i64(count.str);
      }
      let mask = if (ins.imm == 64) { 63i64 } else { 31i64 };
      return demand_bits(result + (n & mask) as i32);
    }
  }
  if (ins.kind_tag == UNARY) {
    if (low_wrap(ins) || ins.str == "int_wrap" || ins.str == "int_extend") {
      let bits = low_wrap_bits(ins);
      if (bits < result) {
        return bits;
      }
      return result;
    }
    if (ins.str.starts_with("rotr:") && rotr_width(ins.str) == 32 || ins.str == "bswap:32") {
      return 32;
    }
  }
  return 64;
}

pub function term_operand(t: STerm): i32 {
  if (t.kind_tag == TERM_RET) {
    return t.value;
  }
  if (t.kind_tag == TERM_BRIF) {
    return t.cond;
  }
  return -1;
}

// term_targets lists the blocks a terminator can branch to.
pub function term_targets(t: STerm): i32[] {
  if (t.kind_tag == TERM_BR) {
    return [t.target];
  }
  if (t.kind_tag == TERM_BRIF) {
    return [t.t, t.f];
  }
  return [];
}

// next_block_id is one more than the largest block id in g.
pub function next_block_id(g: SFunc): i32 {
  let hi = 0;
  for b in g.blocks {
    if (b.id >= hi) {
      hi = b.id + 1;
    }
  }
  return hi;
}

pub function t_unreachable(): STerm {
  return STerm { kind_tag: TERM_UNREACHABLE, cond: 0, target: 0, t: 0, f: 0, value: 0 };
}

// branches_to is true when t can branch to block id.
pub function branches_to(t: STerm, id: i32): boolean {
  return t.kind_tag == TERM_BR && t.target == id || t.kind_tag == TERM_BRIF && (t.t == id || t.f == id);
}

// block_with_id is the index of the block whose id is id, or -1.
pub function block_with_id(f: SFunc, id: i32): i32 {
  let i = 0;
  for b in f.blocks {
    if (b.id == id) {
      return i;
    }
    i += 1;
  }
  return -1;
}

// A load or a store through base + constant takes the constant as its offset.
pub function fold_offsets(f: SFunc): SFunc {
  return rewrite_insts(f, inst_defs(f), offset_access).f;
}

function offset_access(defs: SInst[], ins: SInst): SInst {
  if (ins.kind_tag != LD_AT && ins.kind_tag != ST_AT || ins.str != "" || ins.args.len() == 0 || ins.args[0] < 0) {
    return no_inst();
  }
  let at = def_of(defs, ins.args[0]);
  if (at.kind_tag != BINARY || at.str != "add" || at.imm != 64 || at.args.len() != 2) {
    return no_inst();
  }
  let off = ins.imm as i64 + offset_const(defs, at.args[1]);
  if (off < ins.imm as i64 || off > 1073741824i64) {
    return no_inst();
  }
  return SInst { ...ins, args: ins.args.with(0, at.args[0]), imm: off as i32 };
}

function offset_const(defs: SInst[], v: i32): i64 {
  let d = def_of(defs, v);
  if (d.kind_tag == CONST_INT && d.imm >= 0) {
    return d.imm as i64;
  }
  if (d.kind_tag == CONST_I64 && d.str.len() > 0 && d.str[0] != b'-') {
    return util.lit_to_i64(d.str);
  }
  return 0i64 - 1i64;
}

pub function fuse_rotates(f: SFunc): SFunc {
  if (!has_or(f)) {
    return f;
  }
  let defs = inst_defs(f);
  return rewrite_insts(f, defs, rotate_of).f;
}

function rotate_of(defs: SInst[], ins: SInst): SInst {
  if (ins.kind_tag != BINARY || ins.str != "or" || ins.args.len() != 2) {
    return no_inst();
  }
  let m = rotate_half_pair(defs, ins, ins.args[0], ins.args[1]);
  if (m.kind_tag == NONE) {
    m = rotate_half_pair(defs, ins, ins.args[1], ins.args[0]);
  }
  return m;
}

pub function no_inst(): SInst {
  return SInst { kind_tag: NONE, result: -1, args: [], imm: 0, str: "" };
}

pub function inst_defs(f: SFunc): SInst[] {
  let defs: SInst[] = [];
  for i in 0..f.nvals {
    defs = defs.append(no_inst());
  }
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals) {
        defs = defs.with(ins.result, ins);
      }
    }
  }
  return defs;
}

function rewrite_insts(f: SFunc, defs: SInst[], rewrite: (SInst[], SInst) => SInst): Threading {
  let nblocks: SBlock[] = [];
  let copying = false;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    let ninsts: SInst[] = [];
    let changed = false;
    for k in 0..blk.insts.len() {
      let m = rewrite(defs, blk.insts[k]);
      if (m.kind_tag != NONE && !changed) {
        ninsts = insts_before(blk.insts, k);
        changed = true;
      }
      if (changed) {
        ninsts = ninsts.append(if (m.kind_tag != NONE) { m } else { blk.insts[k] });
      }
    }
    if (changed && !copying) {
      nblocks = blocks_before(f.blocks, bi);
      copying = true;
    }
    if (changed) {
      nblocks = nblocks.append(SBlock { ...blk, insts: ninsts });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
  }
  if (!copying) {
    return Threading { f: f, changed: false };
  }
  return Threading { f: SFunc { ...f, blocks: nblocks }, changed: true };
}

function has_or(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == BINARY && ins.args.len() == 2 && ins.str == "or") {
        return true;
      }
    }
  }
  return false;
}

function rotate_half_pair(defs: SInst[], or: SInst, rv: i32, lv: i32): SInst {
  let no = no_inst();
  let rs = def_of(defs, rv);
  let ls = def_of(defs, lv);
  let w = 64;
  if (zero_extends_u32(ls)) {
    w = 32;
    ls = def_of(defs, ls.args[0]);
  }
  if (rs.kind_tag != BINARY || rs.str != "shr_u" || ls.kind_tag != BINARY || ls.str != "shl") {
    return no;
  }
  if (shift_width(rs.imm) != w || shift_width(ls.imm) != w) {
    return no;
  }
  if (copy_root(defs, rs.args[0]) != copy_root(defs, ls.args[0])) {
    return no;
  }
  let n = const_value(defs, rs.args[1]);
  let k = const_value(defs, ls.args[1]);
  if (n <= 0i64 || k <= 0i64 || n + k != w as i64) {
    return no;
  }
  return SInst { kind_tag: UNARY, result: or.result, args: [rs.args[0]], imm: 0, str: "rotr:" + util.i32_to_string(w) + ":" + util.i64_to_string(n) };
}

pub function fuse_and_not(f: SFunc): SFunc {
  if (!has_and_xor(f)) {
    return f;
  }
  let t = rewrite_insts(f, inst_defs(f), and_not_of);
  return if (t.changed) { prune_dead(t.f) } else { f };
}

function has_and_xor(f: SFunc): boolean {
  let has_and = false;
  let has_xor = false;
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == BINARY) {
        if (ins.str == "and") {
          has_and = true;
        }
        if (ins.str == "xor") {
          has_xor = true;
        }
        if (has_and && has_xor) {
          return true;
        }
      }
    }
  }
  return false;
}

function and_not_of(defs: SInst[], ins: SInst): SInst {
  if (ins.kind_tag != BINARY || ins.str != "and" || ins.args.len() != 2) {
    return no_inst();
  }
  let v = not_of(defs, ins.args[1]);
  if (v >= 0) {
    return SInst { ...ins, args: [ins.args[0], v], str: "and_not" };
  }
  v = not_of(defs, ins.args[0]);
  if (v >= 0) {
    return SInst { ...ins, args: [ins.args[1], v], str: "and_not" };
  }
  return no_inst();
}

// The add, sub or mul at `ii` feeds only the zero-extension after it, so its 32-bit form makes the extended value.
pub function low_word_pair(blk: SBlock, ii: i32, uses: i32[]): boolean {
  if (ii < 0 || ii + 1 >= blk.insts.len()) {
    return false;
  }
  let op = blk.insts[ii];
  let w = blk.insts[ii + 1];
  if (op.kind_tag != BINARY || op.args.len() != 2 || op.str != "add" && op.str != "sub" && op.str != "mul") {
    return false;
  }
  return unsigned_extension(w) && w.args[0] == op.result && op.result >= 0 && op.result < uses.len() && uses[op.result] == 1;
}

pub function carry_triple(blk: SBlock, ii: i32, uses: i32[]): boolean {
  if (ii < 0 || ii + 2 >= blk.insts.len()) {
    return false;
  }
  let sum = blk.insts[ii];
  let c = blk.insts[ii + 1];
  let reader = blk.insts[ii + 2];
  if (c.kind_tag != CARRY || c.args.len() != 2 || sum.kind_tag != BINARY || reader.kind_tag != BINARY || sum.args.len() != 2 || reader.args.len() != 2) {
    return false;
  }
  let sub = c.imm == 1;
  let op: string = if (sub) { "sub" } else { "add" };
  if (sum.str != op || reader.str != op || uses[c.result] != 1) {
    return false;
  }
  let same = sum.args[0] == c.args[0] && sum.args[1] == c.args[1];
  if (!sub && sum.args[0] == c.args[1] && sum.args[1] == c.args[0]) {
    same = true;
  }
  if (!same) {
    return false;
  }
  if (sub) {
    return reader.args[1] == c.result && reader.args[0] != c.result;
  }
  return reader.args[0] == c.result != (reader.args[1] == c.result);
}

pub function fuse_carries(f: SFunc): SFunc {
  if (!has_carry_shift(f)) {
    return f;
  }
  let defs = inst_defs(f);
  let t = rewrite_insts(f, defs, carry_of);
  if (!t.changed) {
    return f;
  }
  return prune_dead(t.f);
}

function has_carry_shift(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == BINARY && ins.str == "shr_u" && ins.imm == 64) {
        return true;
      }
    }
  }
  return false;
}

function is_top_bit(defs: SInst[], ins: SInst): boolean {
  return ins.kind_tag == BINARY && ins.str == "shr_u" && ins.imm == 64 && ins.args.len() == 2 && is_const(defs, ins.args[1], 63i64);
}

function is_const(defs: SInst[], v: i32, want: i64): boolean {
  let d = copy_source(defs, v);
  if (d.kind_tag == CONST_INT) {
    return d.imm as i64 == want;
  }
  return d.kind_tag == CONST_I64 && util.lit_to_i64(d.str) == want;
}

function bin_of(defs: SInst[], v: i32, op: string): SInst {
  let d = copy_source(defs, v);
  if (d.kind_tag == BINARY && d.str == op && d.args.len() == 2) {
    return d;
  }
  return no_inst();
}

function wide_of(defs: SInst[], v: i32, op: string): SInst {
  let d = bin_of(defs, v, op);
  return if (d.imm == 64) { d } else { no_inst() };
}

function not_of(defs: SInst[], v: i32): i32 {
  let d = bin_of(defs, v, "xor");
  if (d.kind_tag == NONE) {
    return -1;
  }
  if (is_const(defs, d.args[1], 0i64 - 1i64)) {
    return copy_root(defs, d.args[0]);
  }
  if (is_const(defs, d.args[0], 0i64 - 1i64)) {
    return copy_root(defs, d.args[1]);
  }
  return -1;
}

function same_pair(defs: SInst[], a: i32, b: i32, x: i32, y: i32): boolean {
  let ra = copy_root(defs, a);
  let rb = copy_root(defs, b);
  return ra == x && rb == y || ra == y && rb == x;
}

function zero_one(defs: SInst[], v: i32): boolean {
  let d = copy_source(defs, v);
  if (d.kind_tag == CARRY || is_top_bit(defs, d)) {
    return true;
  }
  return d.kind_tag == BINARY && d.str == "and" && d.args.len() == 2 && (is_const(defs, d.args[0], 1i64) || is_const(defs, d.args[1], 1i64));
}

function carry_of(defs: SInst[], shr: SInst): SInst {
  if (!is_top_bit(defs, shr)) {
    return no_inst();
  }
  let o = bin_of(defs, shr.args[0], "or");
  if (o.kind_tag == NONE) {
    return no_inst();
  }
  let m = carry_halves(defs, shr, o.args[0], o.args[1]);
  if (m.kind_tag == NONE) {
    m = carry_halves(defs, shr, o.args[1], o.args[0]);
  }
  return m;
}

function carry_halves(defs: SInst[], shr: SInst, p: i32, q: i32): SInst {
  let pa = bin_of(defs, p, "and");
  let qa = bin_of(defs, q, "and");
  if (pa.kind_tag == NONE || qa.kind_tag == NONE) {
    return no_inst();
  }
  for k in 0..2 {
    let m = add_carry(defs, shr, pa, qa.args[k], qa.args[1 - k]);
    if (m.kind_tag == NONE) {
      m = sub_borrow(defs, shr, pa, qa.args[k], qa.args[1 - k]);
    }
    if (m.kind_tag != NONE) {
      return m;
    }
  }
  return no_inst();
}

function add_carry(defs: SInst[], shr: SInst, p: SInst, either: i32, inv: i32): SInst {
  let x = copy_root(defs, p.args[0]);
  let y = copy_root(defs, p.args[1]);
  let e = bin_of(defs, either, "or");
  if (e.kind_tag == NONE || !same_pair(defs, e.args[0], e.args[1], x, y)) {
    return no_inst();
  }
  let s = wide_of(defs, not_of(defs, inv), "add");
  if (s.kind_tag == NONE) {
    return no_inst();
  }
  if (same_pair(defs, s.args[0], s.args[1], x, y)) {
    return SInst { kind_tag: CARRY, result: shr.result, args: [x, y], imm: 0, str: "" };
  }
  for k in 0..2 {
    let inner = wide_of(defs, s.args[k], "add");
    if (inner.kind_tag != NONE && same_pair(defs, inner.args[0], inner.args[1], x, y) && zero_one(defs, s.args[1 - k])) {
      return SInst { kind_tag: CARRY, result: shr.result, args: [x, y, copy_root(defs, s.args[1 - k])], imm: 0, str: "" };
    }
  }
  return no_inst();
}

function sub_borrow(defs: SInst[], shr: SInst, p: SInst, either: i32, diff: i32): SInst {
  for k in 0..2 {
    let x = not_of(defs, p.args[k]);
    let y = copy_root(defs, p.args[1 - k]);
    if (x >= 0 && inverted_or(defs, either, x, y)) {
      return borrow_from(defs, shr, diff, x, y);
    }
  }
  return no_inst();
}

function inverted_or(defs: SInst[], v: i32, x: i32, y: i32): boolean {
  let e = bin_of(defs, v, "or");
  if (e.kind_tag == NONE) {
    return false;
  }
  return not_of(defs, e.args[0]) == x && copy_root(defs, e.args[1]) == y || not_of(defs, e.args[1]) == x && copy_root(defs, e.args[0]) == y;
}

function borrow_from(defs: SInst[], shr: SInst, diff: i32, x: i32, y: i32): SInst {
  let d = wide_of(defs, diff, "sub");
  if (d.kind_tag == NONE) {
    return no_inst();
  }
  if (copy_root(defs, d.args[0]) == x && copy_root(defs, d.args[1]) == y) {
    return SInst { kind_tag: CARRY, result: shr.result, args: [x, y], imm: 1, str: "" };
  }
  let inner = wide_of(defs, d.args[0], "sub");
  if (inner.kind_tag != NONE && copy_root(defs, inner.args[0]) == x && copy_root(defs, inner.args[1]) == y && zero_one(defs, d.args[1])) {
    return SInst { kind_tag: CARRY, result: shr.result, args: [x, y, copy_root(defs, d.args[1])], imm: 1, str: "" };
  }
  return no_inst();
}

function zero_extends_u32(ins: SInst): boolean {
  if (ins.kind_tag != UNARY || ins.args.len() != 1) {
    return false;
  }
  if (ins.str == "u32_wrap" || ins.str == "int_cast:u32") {
    return true;
  }
  return (ins.str == "int_wrap" || ins.str == "int_extend") && ins.imm == 1;
}

function def_of(defs: SInst[], v: i32): SInst {
  if (v < 0 || v >= defs.len()) {
    return no_inst();
  }
  return defs[v];
}

function shift_width(imm: i32): i32 {
  if (imm == 64) {
    return 64;
  }
  return 32;
}

// The first value of the chain of copies that ends at v.
pub function copy_root(defs: SInst[], v: i32): i32 {
  let r = v;
  for steps in 0..defs.len() {
    let d = def_of(defs, r);
    if (d.kind_tag != COPY || d.args.len() != 1) {
      return r;
    }
    r = d.args[0];
  }
  return r;
}

// The definition of copy_root(defs, v).
pub function copy_source(defs: SInst[], v: i32): SInst {
  return def_of(defs, copy_root(defs, v));
}

function const_value(defs: SInst[], v: i32): i64 {
  let d = copy_source(defs, v);
  if (d.kind_tag == CONST_INT) {
    return d.imm as i64;
  }
  if (d.kind_tag == CONST_I64) {
    return util.lit_to_i64(d.str);
  }
  return 0i64 - 1i64;
}

pub function rotr_width(what: string): i32 {
  if (what.starts_with("rotr:64:")) {
    return 64;
  }
  return 32;
}

pub function rotr_count(what: string): i32 {
  let n = 0;
  for i in 8..what.len() {
    n = n * 10 + (what[i] as i32 - 48);
  }
  return n;
}

pub function prune_dead(f: SFunc): SFunc {
  let live = prune_mark(f, prune_roots(f));
  let nblocks: SBlock[] = [];
  let copying = false;
  for bi in 0..f.blocks.len() {
    let blk = f.blocks[bi];
    let ninsts: SInst[] = [];
    let pruned = false;
    for k in 0..blk.insts.len() {
      let ins = blk.insts[k];
      let stays = inst_has_effect(ins.kind_tag) || live[ins.result] == 1;
      if (pruned) {
        if (stays) {
          ninsts = ninsts.append(ins);
        }
      } else if (!stays) {
        ninsts = insts_before(blk.insts, k);
        pruned = true;
      }
    }
    if (pruned) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { id: blk.id, insts: ninsts, term: blk.term, preds: blk.preds });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
  }
  if (!copying) {
    return f;
  }
  return SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: nblocks, entry: f.entry, takes_env: f.takes_env };
}

function insts_before(insts: SInst[], n: i32): SInst[] {
  let out: SInst[] = [];
  for j in 0..n {
    out = out.append(insts[j]);
  }
  return out;
}

function blocks_before(blocks: SBlock[], n: i32): SBlock[] {
  let out: SBlock[] = [];
  for j in 0..n {
    out = out.append(blocks[j]);
  }
  return out;
}

function inst_has_effect(k: i32): boolean {
  if (k < PRINT) {
    return k == PARAM || k == CALL || k == CALL_INDIRECT || k == ALLOC || k == STORE_ELEM || k == CONCAT;
  }
  return k != SELECT && k != LD_AT && k != FN_ADDR && k != SHAPE_ADDR && k != STR_LIT && k != LD_IDX && k != LD_BYTE && k != AGG_LIT && k != SYM_ADDR && k != LANE3;
}

function prune_roots(f: SFunc): i32[] {
  let work: i32[] = [];
  for blk in f.blocks {
    for ins in blk.insts {
      if (inst_has_effect(ins.kind_tag)) {
        for a in ins.args {
          work = work.append(a);
        }
      }
    }
    if (blk.term.kind_tag == TERM_RET) {
      work = work.append(blk.term.value);
    }
    if (blk.term.kind_tag == TERM_BRIF) {
      work = work.append(blk.term.cond);
    }
  }
  return work;
}

function prune_mark(f: SFunc, work: i32[]): i32[] {
  let live = __alloc_i32(f.nvals);
  let def_b = __alloc_i32(f.nvals);
  let def_k = __alloc_i32(f.nvals);
  for bi in 0..f.blocks.len() {
    let k = 0;
    while (k < f.blocks[bi].insts.len()) {
      let r = f.blocks[bi].insts[k].result;
      def_b = def_b.with(r, bi + 1);
      def_k = def_k.with(r, k);
      k += 1;
    }
  }
  let at = 0;
  while (at < work.len()) {
    let v = work[at];
    at += 1;
    if (v < 0 || v >= f.nvals || live[v] == 1) {
      continue;
    }
    live = live.with(v, 1);
    if (def_b[v] == 0) {
      continue;
    }
    for a in f.blocks[def_b[v] - 1].insts[def_k[v]].args {
      work = work.append(a);
    }
  }
  return live;
}

pub function count_insts(f: SFunc): i32 {
  let n = 0;
  for bi in 0..f.blocks.len() {
    n += f.blocks[bi].insts.len();
  }
  return n;
}

pub function pred_slot(blk: SBlock, prev: i32): i32 {
  for i in 0..blk.preds.len() {
    if (blk.preds[i] == prev) {
      return i;
    }
  }
  return 0;
}

function eval_binary(op: string, l: i32, r: i32): i32 {
  if (op == "+") {
    return l + r;
  }
  if (op == "-") {
    return l - r;
  }
  if (op == "*") {
    return l * r;
  }
  if (op == "/") {
    return l / r;
  }
  if (op == "%") {
    return l % r;
  }
  if (op == "==") {
    if (l == r) {
      return 1;
    }
    return 0;
  }
  if (op == "!=") {
    if (l != r) {
      return 1;
    }
    return 0;
  }
  if (op == "<") {
    if (l < r) {
      return 1;
    }
    return 0;
  }
  if (op == "<=") {
    if (l <= r) {
      return 1;
    }
    return 0;
  }
  if (op == ">") {
    if (l > r) {
      return 1;
    }
    return 0;
  }
  if (op == ">=") {
    if (l >= r) {
      return 1;
    }
    return 0;
  }
  if (op == "&&") {
    if (l != 0 && r != 0) {
      return 1;
    }
    return 0;
  }
  if (op == "||") {
    if (l != 0 || r != 0) {
      return 1;
    }
    return 0;
  }
  if (op == "&") {
    return l & r;
  }
  if (op == "|") {
    return l | r;
  }
  if (op == "^") {
    return l ^ r;
  }
  if (op == "<<") {
    return l << r;
  }
  if (op == ">>") {
    return l >> r;
  }
  return 0;
}

pub function only_phis(b: SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag != PHI) {
      return false;
    }
  }
  return true;
}

// block_index is the index in its function of block id, given the function's
// map from block id to index, or -1.
pub function block_index(blk_pos: i32[], id: i32): i32 {
  if (id < 0 || id >= blk_pos.len()) {
    return -1;
  }
  return blk_pos[id];
}

// edge_moves is true when the edge from pred into block id needs a phi move.
pub function edge_moves(f: SFunc, blk_pos: i32[], imm: Imms, reg_of: i32[], pred: i32, id: i32): boolean {
  let ti = block_index(blk_pos, id);
  if (ti < 0) {
    return false;
  }
  let tb = f.blocks[ti];
  let sl = pred_slot(tb, pred);
  for ins in tb.insts {
    if (ins.kind_tag == PHI && reg_of[ins.result] != -1 && (imm.is_imm[ins.args[sl]] || reg_of[ins.args[sl]] != reg_of[ins.result])) {
      return true;
    }
  }
  return false;
}

// forward_target follows up to 8 blocks that hold only phis and branch on
// with no edge moves, and returns the block a jump to id reaches.
pub function forward_target(f: SFunc, blk_pos: i32[], imm: Imms, reg_of: i32[], id: i32): i32 {
  let cur = id;
  for step in 0..8 {
    let bi = block_index(blk_pos, cur);
    if (bi < 0) {
      return cur;
    }
    let b = f.blocks[bi];
    if (!only_phis(b) || b.term.kind_tag != TERM_BR || b.term.target == cur || edge_moves(f, blk_pos, imm, reg_of, cur, b.term.target)) {
      return cur;
    }
    cur = b.term.target;
  }
  return cur;
}

pub function same_fallthrough(f: SFunc, blk_pos: i32[], imm: Imms, reg_of: i32[], to: i32, next: i32): boolean {
  return to == next || forward_target(f, blk_pos, imm, reg_of, to) == forward_target(f, blk_pos, imm, reg_of, next);
}

pub function has_phis(f: SFunc, blk_pos: i32[], id: i32): boolean {
  let ti = block_index(blk_pos, id);
  if (ti < 0) {
    return false;
  }
  for ins in f.blocks[ti].insts {
    if (ins.kind_tag == PHI) {
      return true;
    }
  }
  return false;
}

pub function view_slots(f: SFunc): i32[] {
  let out: i32[] = [];
  let n = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == STR_VIEW) {
        if (out.len() == 0) {
          out = util.minus_ones(f.nvals);
        }
        if (ins.imm >= 1) {
          out = out.with(ins.result, n);
          n += 1;
        }
      }
    }
  }
  return out;
}

pub function view_count(views: i32[]): i32 {
  let n = 0;
  for v in views {
    if (v >= 0) {
      n += 1;
    }
  }
  return n;
}

pub function unique_test(ins: SInst): boolean {
  return rc_inlined(ins) && ins.str == "__fern_rc_is_unique";
}

// A select past the first instruction, which the select fusion can read.
pub function select_at(blk: SBlock, ii: i32): boolean {
  return ii >= 1 && ii < blk.insts.len() && blk.insts[ii].kind_tag == SELECT;
}

pub function runtime_helper_name(op: string): string {
  return match (op) {
    "str_from_bytes" => "string_from_bytes",
    "str_from_bytes_u8" => "string_from_bytes_u8",
    "str_from_bytes_range_u8" => "string_from_bytes_range_u8",
    "read_chunk" => "reader_read_chunk",
    "write_bytes" => "writer_write_bytes",
    "write_bytes_u8" => "writer_write_bytes_u8",
    "write_some_bytes" => "writer_write_some_bytes",
    "write_some_bytes_u8" => "writer_write_some_bytes_u8",
    "read_chunk_bytes" => "reader_read_chunk_bytes",
    "read_chunk_bytes_u8" => "reader_read_chunk_bytes_u8",
    _ => op,
  };
}

// Scalar masks and byte shifts can describe a vector byte permutation. Keep
// each search bounded and refuse any bit whose provenance is not exact.
struct ByteOrigin { atom: i32, fuel: i32 }

struct ByteAddress { base: i32, offset: i32 }

function byte_unknown(fuel: i32): ByteOrigin {
  return ByteOrigin { atom: -2, fuel: fuel };
}

function byte_constant(ins: SInst): boolean {
  return ins.kind_tag == CONST_INT || ins.kind_tag == CONST_I64;
}

function byte_constant_value(ins: SInst): i64 {
  return if (ins.kind_tag == CONST_INT) { ins.imm as i64 } else { util.lit_to_i64(ins.str) };
}

function byte_shift_op(op: string): boolean {
  return op == "shl" || op == "shr_s" || op == "shr_u";
}

function byte_wrap_op(ins: SInst): boolean {
  return low_wrap(ins) || ins.str == "int_wrap" || ins.str == "int_extend";
}

function byte_extract(ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  let lane = (ins.str[ins.str.len() - 1] - b'0') as i32;
  let bytes = ins.imm / 8;
  if (byte >= bytes || lane < 0 || lane * bytes + byte >= 16) {
    return byte_unknown(fuel);
  }
  let vector = ins.args[0];
  if (vector < 0 || vector > 134217727) {
    return byte_unknown(fuel);
  }
  return ByteOrigin { atom: vector * 16 + lane * bytes + byte, fuel: fuel };
}

function byte_unary(defs: SInst[], ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  if (ins.args.len() != 1) {
    return byte_unknown(fuel);
  }
  if (ins.str.starts_with("vextract_bits:")) {
    return byte_extract(ins, byte, fuel);
  }
  if (byte_wrap_op(ins) && byte < low_wrap_bits(ins) / 8) {
    return byte_origin(defs, ins.args[0], byte, fuel);
  }
  return byte_unknown(fuel);
}

function byte_and(defs: SInst[], ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  for k in 0..2 {
    let c = def_of(defs, ins.args[k]);
    if (byte_constant(c)) {
      let mask = byte_constant_value(c) >> 8 * byte & 255i64;
      if (mask == 0i64) {
        return ByteOrigin { atom: -1, fuel: fuel };
      }
      if (mask == 255i64) {
        return byte_origin(defs, ins.args[1 - k], byte, fuel);
      }
    }
  }
  return byte_unknown(fuel);
}

function byte_or(defs: SInst[], ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  let a = byte_origin(defs, ins.args[0], byte, fuel);
  if (a.atom == -2) {
    return a;
  }
  let b = byte_origin(defs, ins.args[1], byte, a.fuel);
  if (a.atom == -1 || a.atom == b.atom) {
    return b;
  }
  if (b.atom == -1) {
    return ByteOrigin { atom: a.atom, fuel: b.fuel };
  }
  return byte_unknown(b.fuel);
}

function byte_shift(defs: SInst[], ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  let c = def_of(defs, ins.args[1]);
  if (!byte_constant(c)) {
    return byte_unknown(fuel);
  }
  let width = if (ins.imm == 64) { 64 } else { 32 };
  let count = (byte_constant_value(c) & (width - 1) as i64) as i32;
  if ((count & 7) != 0 || byte >= width / 8) {
    return byte_unknown(fuel);
  }
  let at = byte + (if (ins.str == "shl") { -count / 8 } else { count / 8 });
  if (at < 0 || at >= width / 8 && ins.str == "shr_u") {
    return ByteOrigin { atom: -1, fuel: fuel };
  }
  if (at >= width / 8) {
    return byte_unknown(fuel);
  }
  return byte_origin(defs, ins.args[0], at, fuel);
}

function byte_binary(defs: SInst[], ins: SInst, byte: i32, fuel: i32): ByteOrigin {
  if (ins.args.len() != 2) {
    return byte_unknown(fuel);
  }
  if (ins.str == "and") {
    return byte_and(defs, ins, byte, fuel);
  }
  if (ins.str == "or") {
    return byte_or(defs, ins, byte, fuel);
  }
  if (byte_shift_op(ins.str)) {
    return byte_shift(defs, ins, byte, fuel);
  }
  return byte_unknown(fuel);
}

function byte_origin(defs: SInst[], value: i32, byte: i32, fuel: i32): ByteOrigin {
  if (fuel <= 0 || byte < 0 || byte >= 8) {
    return byte_unknown(0);
  }
  fuel -= 1;
  let ins = def_of(defs, value);
  if (ins.kind_tag == COPY && ins.args.len() == 1) {
    return byte_origin(defs, ins.args[0], byte, fuel);
  }
  if (ins.kind_tag == UNARY) {
    return byte_unary(defs, ins, byte, fuel);
  }
  if (byte_constant(ins)) {
    let zero = (byte_constant_value(ins) >> 8 * byte & 255i64) == 0i64;
    return ByteOrigin { atom: if (zero) { -1 } else { -2 }, fuel: fuel };
  }
  if (ins.kind_tag == BINARY) {
    return byte_binary(defs, ins, byte, fuel);
  }
  return byte_unknown(fuel);
}

function byte_store_size(ins: SInst): i32 {
  if (ins.kind_tag == ST_BYTE && ins.args.len() == 3) {
    return 1;
  }
  if (ins.kind_tag != ST_AT || ins.args.len() != 2) {
    return 0;
  }
  if (ins.str == "u8") {
    return 1;
  }
  if (ins.str == "i32") {
    return 4;
  }
  return if (ins.str == "") { 8 } else { 0 };
}

function byte_store_address(defs: SInst[], ins: SInst): ByteAddress {
  let base = ins.args[0];
  let offset = ins.imm;
  if (ins.kind_tag == ST_BYTE) {
    let index = offset_const(defs, ins.args[1]);
    if (index < 0i64 || index > 32i64) {
      return ByteAddress { base: -1, offset: 0 };
    }
    offset = index as i32;
  }
  for depth in 0..4 {
    let d = def_of(defs, base);
    if (d.kind_tag != BINARY || d.str != "add" || d.imm != 64 || d.args.len() != 2) {
      break;
    }
    let n = offset_const(defs, d.args[1]);
    if (n < 0i64 || n > 32i64 || offset > 64) {
      break;
    }
    offset += n as i32;
    base = d.args[0];
  }
  return ByteAddress { base: base, offset: offset };
}

// Only operations which cannot observe memory or trap may move between the
// old stores and their replacement. A load, call or unknown opcode is a fence.
function byte_store_transparent(ins: SInst): boolean {
  if (ins.kind_tag == CONST_INT || ins.kind_tag == CONST_I64 || ins.kind_tag == COPY) {
    return true;
  }
  if (ins.kind_tag == UNARY) {
    return byte_wrap_op(ins) || ins.str.starts_with("vextract_bits:");
  }
  return ins.kind_tag == BINARY && (low_half_binary(ins.str) || byte_shift_op(ins.str));
}

function shuffled_byte_store(defs: SInst[], insts: SInst[], stores: i32[], count: i32): SInst {
  if (stores.len() < 2 || count != 4 && count != 8 && count != 12 && count != 16) {
    return no_inst();
  }
  let first = insts[stores[0]];
  if (first.imm != 0 || first.kind_tag == ST_BYTE && offset_const(defs, first.args[1]) != 0i64) {
    return no_inst();
  }
  let atoms: i32[] = [];
  let vectors: i32[] = [];
  for at in stores {
    let store = insts[at];
    for byte in 0..byte_store_size(store) {
      let value = store.args[if (store.kind_tag == ST_BYTE) { 2 } else { 1 }];
      let origin = byte_origin(defs, value, byte, 64);
      if (origin.atom == -2) {
        return no_inst();
      }
      atoms = atoms.append(origin.atom);
      if (origin.atom >= 0 && util.index_of_i32(vectors, origin.atom / 16) < 0) {
        vectors = vectors.append(origin.atom / 16);
        if (vectors.len() > 2) {
          return no_inst();
        }
      }
    }
  }
  if (vectors.len() == 0) {
    return no_inst();
  }
  let mask = __alloc_u8(16);
  for i in 0..16 {
    let byte = b'?';
    if (i < atoms.len() && atoms[i] >= 0) {
      let atom = atoms[i];
      byte = (65 + 16 * util.index_of_i32(vectors, atom / 16) + atom % 16) as u8;
    }
    mask = mask.with(i, byte);
  }
  let other = if (vectors.len() == 2) { vectors[1] } else { vectors[0] };
  let text = "";
  unsafe {
    // Every mask byte is an ASCII index or the zero-fill marker.
    text = string_from_bytes_unchecked(mask);
  }
  return SInst { ...first, kind_tag: LANE_STORE, args: [first.args[0], vectors[0], other], str: "vstore:shuffle:" + text, imm: count };
}

pub function combine_byte_stores(f: SFunc): SFunc {
  let extracts = false;
  let stores = 0;
  for block in f.blocks {
    for ins in block.insts {
      extracts = extracts || ins.kind_tag == UNARY && ins.str.starts_with("vextract_bits:");
      if (byte_store_size(ins) > 0) {
        stores += 1;
      }
    }
  }
  if (!extracts || stores < 2) {
    return f;
  }
  let defs = inst_defs(f);
  let blocks: SBlock[] = [];
  let changed = false;
  for block in f.blocks {
    let insts = block.insts;
    let i = 0;
    while (i < insts.len()) {
      if (byte_store_size(insts[i]) == 0) {
        i += 1;
        continue;
      }
      let start = byte_store_address(defs, insts[i]);
      if (start.base < 0) {
        i += 1;
        continue;
      }
      let count = 0;
      let group: i32[] = [];
      let j = i;
      while (j < insts.len() && j - i < 64) {
        let size = byte_store_size(insts[j]);
        if (size > 0) {
          let address = byte_store_address(defs, insts[j]);
          if (address.base != start.base || address.offset != start.offset + count || count + size > 16) {
            break;
          }
          count += size;
          group = group.append(j);
        } else if (!byte_store_transparent(insts[j])) {
          break;
        }
        j += 1;
      }
      let packed = shuffled_byte_store(defs, insts, group, count);
      if (packed.kind_tag != NONE) {
        for at in group {
          insts = insts.with(at, no_inst());
        }
        insts = insts.with(group[group.len() - 1], packed);
        changed = true;
      }
      i = if (j > i) { j } else { i + 1 };
    }
    let kept: SInst[] = [];
    for ins in insts {
      if (ins.kind_tag != NONE) {
        kept = kept.append(ins);
      }
    }
    blocks = blocks.append(SBlock { ...block, insts: kept });
  }
  return if (changed) { prune_dead(SFunc { ...f, blocks: blocks }) } else { f };
}
