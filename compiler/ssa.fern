import "./ast";
import "./parser";
import "./astwalk";
import "./util";
import "./ssafixed";
import "./ir";

pub struct SInst { kind_tag: i32, result: i32, args: i32[], imm: i32, str: string }

pub struct STerm { kind_tag: i32, cond: i32, target: i32, t: i32, f: i32, value: i32 }

pub struct SBlock { id: i32, insts: SInst[], term: STerm, preds: i32[] }

pub struct SFunc { name: string, nparams: i32, nvals: i32, blocks: SBlock[], entry: i32, takes_env: boolean }

function t_ret(value: i32): STerm {
  return STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: value };
}

function t_br(target: i32): STerm {
  return STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function t_brif(cond: i32, t: i32, f: i32): STerm {
  return STerm { kind_tag: 3, cond: cond, target: 0, t: t, f: f, value: 0 };
}

function buf_kind_name(id: i32): string {
  if (id == 28) {
    return "buf_new";
  }
  if (id == 29) {
    return "buf_push";
  }
  if (id == 30) {
    return "buf_push_range";
  }
  if (id == 31) {
    return "buf_push_byte";
  }
  if (id == 32) {
    return "buf_len";
  }
  if (id == 33) {
    return "buf_take";
  }
  return "buf_free";
}

pub function kind_name(id: i32): string {
  if (id < 0) {
    return semantic_kind_name(id);
  }
  if (id == 35) {
    return "line";
  }
  if (id == 36) {
    return "select";
  }
  if (id == 37) {
    return "carry";
  }
  if (id == 1) {
    return "const_int";
  }
  if (id == 2) {
    return "const_bool";
  }
  if (id == 3) {
    return "const_i64";
  }
  if (id == 4) {
    return "const_float";
  }
  if (id == 5) {
    return "const_str";
  }
  if (id == 6) {
    return "param";
  }
  if (id == 7) {
    return "copy";
  }
  if (id == 8) {
    return "phi";
  }
  if (id == 9) {
    return "binary";
  }
  if (id == 10) {
    return "unary";
  }
  if (id == 11) {
    return "call";
  }
  if (id == 12) {
    return "call_indirect";
  }
  if (id == 13) {
    return "funcaddr";
  }
  if (id == 14) {
    return "alloc";
  }
  if (id == 15) {
    return "load_elem";
  }
  if (id == 16) {
    return "store_elem";
  }
  if (id == 17) {
    return "concat";
  }
  if (id == 18) {
    return "streq";
  }
  if (id == 19) {
    return "print";
  }
  if (id == 20) {
    return "write";
  }
  if (id == 21) {
    return "exit";
  }
  if (id == 22) {
    return "args";
  }
  if (id == 26) {
    return "read_file";
  }
  if (id == 27) {
    return "write_file";
  }
  if (id >= 28 && id <= 34) {
    return buf_kind_name(id);
  }
  if (id >= 40 && id <= 62) {
    return prod_kind_name(id);
  }
  return "invalid";
}

function semantic_names_symbol(id: i32): boolean {
  return id == 0 - 7 || id == 0 - 8 || id == 0 - 9 || id == 0 - 10
    || id == 0 - 11 || id == 0 - 12 || id == 0 - 20;
}

pub function plain_str(ins: SInst): string {
  if ((ins.kind_tag == 40 || ins.kind_tag == 42) && ins.str.len() >= 2 && slice_unchecked(ins.str, ins.str.len() - 2, ins.str.len()) == "rc") {
    return slice_unchecked(ins.str, 0, ins.str.len() - 2) + "";
  }
  return ins.str;
}

pub function plain_imm(ins: SInst): i32 {
  if (ins.kind_tag == 11 && ins.imm >= 1 && ins.imm <= 3) {
    return 0;
  }
  return ins.imm;
}

function carries_imm(kind: i32): boolean {
  return kind == 1 || kind == 2 || kind == 6 || kind == 0 - 4 || kind == 0 - 6 || kind == 0 - 10 || kind == 0 - 49;
}

function carries_str(kind: i32): boolean {
  return kind == 9 || kind == 10 || kind == 11 || semantic_names_symbol(kind);
}

function shows_imm(ins: SInst): boolean {
  return carries_imm(ins.kind_tag) || ins.kind_tag >= 40 && ins.kind_tag <= 43 && ins.imm != 0;
}

function shows_str(ins: SInst): boolean {
  return carries_str(ins.kind_tag) || ins.kind_tag >= 40 && ins.kind_tag <= 62 && ins.str != "";
}

function inst_detail(ins: SInst): string {
  if (ins.kind_tag == 1 && ins.str != "") {
    return " " + ins.str;
  }
  let out: string = "";
  if (shows_imm(ins)) {
    out = out + " " + util.i32_to_string(ins.imm);
  }
  if (shows_str(ins)) {
    out = out + " " + ins.str;
  }
  return out;
}

pub function print_func(f: SFunc): string {
  let out: string = "func " + f.name + " {\n";
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    out = out + "  b" + util.i32_to_string(blk.id) + ":\n";
    let k: i32 = 0;
    while (k < blk.insts.len()) {
      let ins: SInst = blk.insts[k];
      out = out + "    v" + util.i32_to_string(ins.result) + " = " + kind_name(ins.kind_tag) + inst_detail(ins);
      let ai: i32 = 0;
      while (ai < ins.args.len()) {
        out = out + " v" + util.i32_to_string(ins.args[ai]);
        ai = ai + 1;
      }
      out = out + "\n";
      k = k + 1;
    }
    if (blk.term.kind_tag == 4) {
      out = out + "    unreachable\n";
    } else if (blk.term.kind_tag == 1 && blk.term.value < 0) {
      out = out + "    ret\n";
    } else if (blk.term.kind_tag == 1) {
      out = out + "    ret v" + util.i32_to_string(blk.term.value) + "\n";
    } else if (blk.term.kind_tag == 2) {
      out = out + "    br b" + util.i32_to_string(blk.term.target) + "\n";
    } else if (blk.term.kind_tag == 3) {
      out = out + "    brif v" + util.i32_to_string(blk.term.cond) + " b" + util.i32_to_string(blk.term.t) + " b" + util.i32_to_string(blk.term.f) + "\n";
    }
    bi = bi + 1;
  }
  return out + "}\n";
}

function prod_kind_name(id: i32): string {
  let names: string[] = [
    "ld_at", "st_at", "arr_at", "arr_st", "str_at", "fn_addr", "shape_addr", "str_lit", "arr_box", "str_call", "rt_call", "str_view",
    "ld_idx", "st_idx", "ld_byte", "st_byte", "call_ind", "agg_lit", "sym_addr", "flat_op", "dyn_dispatch", "lane3", "lane_store",
  ];
  return names[id - 40];
}

// run from -1 downward. Retired slots name invalid. The index is -id - 1.
// An id outside the table is invalid.
function semantic_kind_names(): string[] {
  return [
    "array_new", "tuple_new", "array_get", "tuple_get",
    "record_new", "record_get", "call", "variant_new", "variant_is",
    "variant_get", "variant_up", "variant_as", "length", "append", "slice",
    "str_index", "cast", "str_as", "with", "closure_new", "call_value", "cell_new", "cell_get", "cell_set",
    "map_new", "map_insert", "map_has", "map_get_or", "map_len", "map_get",
    "map_keys", "map_values", "map_delete", "map_cleared", "zero", "str_bytes",
    "arr_join", "arr_slice", "invalid", "invalid",
    "invalid", "invalid", "invalid", "dyn_up", "dyn_box",
    "dyn_is", "dyn_as", "hole_at", "hole_fill", "array_lend", "str_byte_view", "append_range",
  ];
}

pub function semantic_kind_count(): i32 {
  return semantic_kind_names().len();
}

function semantic_kind_name(id: i32): string {
  let names: string[] = semantic_kind_names();
  let at: i32 = 0 - id - 1;
  if (at < 0 || at >= names.len()) {
    return "invalid";
  }
  return names[at];
}

pub function kind_count(): i32 {
  return 37;
}

pub function kind_retired(id: i32): boolean {
  return id >= 23 && id <= 25;
}

pub function kind_id(name: string): i32 {
  if (name == "const_int") {
    return 1;
  }
  if (name == "line") {
    return 35;
  }
  if (name == "select") {
    return 36;
  }
  if (name == "carry") {
    return 37;
  }
  if (name == "const_bool") {
    return 2;
  }
  if (name == "const_i64") {
    return 3;
  }
  if (name == "const_float") {
    return 4;
  }
  if (name == "const_str") {
    return 5;
  }
  if (name == "param") {
    return 6;
  }
  if (name == "copy") {
    return 7;
  }
  if (name == "phi") {
    return 8;
  }
  if (name == "binary") {
    return 9;
  }
  if (name == "unary") {
    return 10;
  }
  if (name == "call") {
    return 11;
  }
  if (name == "call_indirect") {
    return 12;
  }
  if (name == "funcaddr") {
    return 13;
  }
  if (name == "alloc") {
    return 14;
  }
  if (name == "load_elem") {
    return 15;
  }
  if (name == "store_elem") {
    return 16;
  }
  if (name == "concat") {
    return 17;
  }
  if (name == "streq") {
    return 18;
  }
  if (name == "print") {
    return 19;
  }
  if (name == "write") {
    return 20;
  }
  if (name == "exit") {
    return 21;
  }
  if (name == "args") {
    return 22;
  }
  if (name == "read_file") {
    return 26;
  }
  if (name == "write_file") {
    return 27;
  }
  if (name.len() >= 7 && name[0] == b'b') {
    return buf_kind_id(name);
  }
  return 0;
}

function buf_kind_id(name: string): i32 {
  if (name == "buf_new") {
    return 28;
  }
  if (name == "buf_push") {
    return 29;
  }
  if (name == "buf_push_range") {
    return 30;
  }
  if (name == "buf_push_byte") {
    return 31;
  }
  if (name == "buf_len") {
    return 32;
  }
  if (name == "buf_take") {
    return 33;
  }
  if (name == "buf_free") {
    return 34;
  }
  return 0;
}

pub function term_count(): i32 {
  return 3;
}

pub function term_id(name: string): i32 {
  if (name == "ret") {
    return 1;
  }
  if (name == "br") {
    return 2;
  }
  if (name == "brif") {
    return 3;
  }
  return 0;
}

pub function term_name(id: i32): string {
  if (id == 1) {
    return "ret";
  }
  if (id == 2) {
    return "br";
  }
  if (id == 3) {
    return "brif";
  }
  return "";
}

function rewrite_args(ins: SInst, resolved: i32[]): SInst {
  let na: i32[] = [];
  let i: i32 = 0;
  while (i < ins.args.len()) {
    na = na.append(resolved[ins.args[i]]);
    i = i + 1;
  }
  return SInst { kind_tag: ins.kind_tag, result: ins.result, args: na, imm: ins.imm, str: ins.str };
}

function rewrite_term(t: STerm, resolved: i32[]): STerm {
  if (t.kind_tag == 1) {
    return t_ret(resolved[t.value]);
  }
  if (t.kind_tag == 3) {
    return t_brif(resolved[t.cond], t.t, t.f);
  }
  return t;
}

function inst_is_call(k: i32): boolean {
  if (k == 11 || k == 12 || k == 17 || k == 18 || k == 48 || k == 49 || k == 50 || k == 51 || k == 56 || k == 59 || k == 60) {
    return true;
  }
  return k >= 19 && k <= 27;
}

// A runtime abort exits the process, so no value has to survive it.
pub function never_returns(ins: SInst): boolean {
  return inst_is_call(ins.kind_tag) && ins.args.len() == 0
    && (ins.str == "__fern_oob_abort" || ins.str == "__fern_str_oob_abort" || ins.str == "__fern_slice_abort" || ins.str == "__fern_alloc_size_abort");
}

pub function cold_call(ins: SInst): boolean {
  return ins.kind_tag == 50 && ins.result >= 0 && util.str_has_prefix(ins.str, "arr_push");
}

pub const COLD_NONE: i32 = 0;

pub const COLD_SLOW: i32 = 1;

pub const COLD_BRANCH: i32 = 2;

pub const COLD_INLINE: i32 = 3;

pub function cold_positions(f: SFunc, size: boolean): i32[] {
  let cold: boolean[] = cold_blocks(f);
  let out: i32[] = [];
  for bi in 0..f.blocks.len() {
    let blk: SBlock = f.blocks[bi];
    for k in 0..blk.insts.len() {
      let ins: SInst = blk.insts[k];
      let kind: i32 = COLD_NONE;
      if (cold_call(ins)) {
        kind = COLD_SLOW;
      } else if (rc_inlined(ins)) {
        if (!size) {
          kind = COLD_INLINE;
        }
      } else if (cold[bi] && inst_is_call(ins.kind_tag) && !never_returns(ins) && !returns_call(blk, k)) {
        kind = COLD_BRANCH;
      }
      out = out.append(kind);
    }
    out = out.append(COLD_NONE);
  }
  return out;
}

pub function cold_blocks(f: SFunc): boolean[] {
  let n: i32 = f.blocks.len();
  let at: i32[] = block_positions(f);
  let latch: i32[] = __alloc_i32(n);
  let span: i32[] = __alloc_i32(n);
  for i in 0..n {
    latch = latch.with(i, 0 - 1);
    span = span.with(i, n + 1);
  }
  for bi in 0..n {
    for which in 0..2 {
      let tgt: i32 = distinct_successor_position(at, f.blocks[bi].term, which);
      if (tgt >= 0 && tgt <= bi) {
        for k in tgt..=bi {
          if (bi - tgt < span[k]) {
            span = span.with(k, bi - tgt);
            latch = latch.with(k, bi);
          }
        }
      }
    }
  }
  let idom: i32[] = dominators(f, at);
  let out: boolean[] = __alloc_bool(n);
  for i in 0..n {
    out = out.with(i, latch[i] >= 0 && !dominates(idom, i, latch[i]));
  }
  return out;
}

function dominators(f: SFunc, at: i32[]): i32[] {
  let n: i32 = f.blocks.len();
  let entry: i32 = position_of(at, f.entry);
  let idom: i32[] = __alloc_i32(n);
  let po: i32[] = __alloc_i32(n);
  for i in 0..n {
    idom = idom.with(i, 0 - 1);
    po = po.with(i, 0 - 1);
  }
  if (entry < 0) {
    return idom;
  }
  let order: i32[] = postorder(f, at, entry);
  for i in 0..order.len() {
    po = po.with(order[i], i);
  }
  idom = idom.with(entry, entry);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let r: i32 = order.len() - 1;
    while (r >= 0) {
      let b: i32 = order[r];
      r = r - 1;
      if (b == entry) {
        continue;
      }
      let pick: i32 = meet_preds(f, at, idom, po, b);
      if (pick != idom[b]) {
        idom = idom.with(b, pick);
        changed = true;
      }
    }
  }
  return idom;
}

function meet_preds(f: SFunc, at: i32[], idom: i32[], po: i32[], b: i32): i32 {
  let pick: i32 = 0 - 1;
  for pid in f.blocks[b].preds {
    let p: i32 = position_of(at, pid);
    if (p >= 0 && idom[p] >= 0) {
      if (pick < 0) {
        pick = p;
      } else {
        pick = intersect(idom, po, p, pick);
      }
    }
  }
  return pick;
}

function intersect(idom: i32[], po: i32[], a: i32, b: i32): i32 {
  while (a != b) {
    while (po[a] < po[b]) {
      a = idom[a];
    }
    while (po[b] < po[a]) {
      b = idom[b];
    }
  }
  return a;
}

function postorder(f: SFunc, at: i32[], entry: i32): i32[] {
  let seen: boolean[] = __alloc_bool(f.blocks.len());
  let out: i32[] = [];
  let stack: i32[] = [entry];
  let next: i32[] = [0];
  seen = seen.with(entry, true);
  while (stack.len() > 0) {
    let top: i32 = stack.len() - 1;
    let b: i32 = stack[top];
    let which: i32 = next[top];
    if (which < 2) {
      next = next.with(top, which + 1);
      let s: i32 = distinct_successor_position(at, f.blocks[b].term, which);
      if (s >= 0 && !seen[s]) {
        seen = seen.with(s, true);
        stack = stack.append(s);
        next = next.append(0);
      }
    } else {
      out = out.append(b);
      stack = drop_last_i(stack);
      next = drop_last_i(next);
    }
  }
  return out;
}

function dominates(idom: i32[], a: i32, b: i32): boolean {
  if (idom[b] < 0) {
    return false;
  }
  let x: i32 = b;
  while (x != a) {
    if (idom[x] == x) {
      return false;
    }
    x = idom[x];
  }
  return true;
}

pub function returns_call(blk: SBlock, k: i32): boolean {
  let ins: SInst = blk.insts[k];
  return k == blk.insts.len() - 1 && blk.term.kind_tag == 1 && ins.result >= 0 && blk.term.value == ins.result;
}

pub function calls_out(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (calls(ins)) {
        return true;
      }
    }
  }
  return false;
}

pub function calls(ins: SInst): boolean {
  return inst_is_call(ins.kind_tag) && !rc_inlined(ins) && !never_returns(ins);
}

pub function rc_inlined(ins: SInst): boolean {
  if (ins.kind_tag != 11 || ins.args.len() != 1) {
    return false;
  }
  return ins.str == "__fern_rc_is_unique" || ins.str == "__fern_rc_inc";
}

function calls_before(calls: i32[], total_pos: i32): i32[] {
  let cum: i32[] = __alloc_i32(total_pos + 2);
  let ci: i32 = 0;
  let p: i32 = 0;
  while (p <= total_pos + 1) {
    cum = cum.with(p, ci);
    while (ci < calls.len() && calls[ci] < p + 1) {
      ci = ci + 1;
    }
    p = p + 1;
  }
  return cum;
}

function spans_call(cum: i32[], lo: i32, hi: i32): boolean {
  if (hi <= lo + 1) {
    return false;
  }
  let a: i32 = lo + 1;
  if (a >= cum.len()) {
    return false;
  }
  let b: i32 = hi;
  if (b >= cum.len()) {
    b = cum.len() - 1;
  }
  return cum[b] - cum[a] > 0;
}

// With no saved register left, saving a caller register around the cold
// calls costs less than a spill that every iteration loads and stores.
function cold_caller(saved_free: i32, cold_integer: boolean, pick: i32, cum: i32[], lo: i32, hi: i32): boolean {
  return saved_free == 0 && cold_integer && pick >= 0 && !spans_call(cum, lo, hi);
}

function hard_spans(f: SFunc, cum: i32[], cold: i32[], lo: i32[], hi: i32[], weight: i32[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.nvals);
  if (cold.len() == 0) {
    for v in 0..f.nvals {
      out = out.with(v, spans_call(cum, lo[v], hi[v]));
    }
    return out;
  }
  let cost: i32[] = cold_call_cost(f, cold);
  for v in 0..f.nvals {
    let h: boolean = spans_call(cum, lo[v], hi[v]);
    if (!h && hi[v] > lo[v] + 1 && lo[v] + 1 < cost.len()) {
      let b: i32 = hi[v];
      if (b >= cost.len()) {
        b = cost.len() - 1;
      }
      h = 2 * (cost[b] - cost[lo[v] + 1]) >= weight[v];
    }
    out = out.with(v, h);
  }
  return out;
}

function cold_call_cost(f: SFunc, cold: i32[]): i32[] {
  let bw: i32[] = block_loop_weights(f);
  let out: i32[] = [0];
  let total: i32 = 0;
  let pos: i32 = 0;
  for bi in 0..f.blocks.len() {
    for k in 0..=f.blocks[bi].insts.len() {
      if (pos < cold.len() && cold[pos] == COLD_BRANCH) {
        total = total + bw[bi];
      }
      pos = pos + 1;
      out = out.append(total);
    }
  }
  return out;
}

function spans_hard(hard: boolean[], integer: boolean, cum: i32[], lo: i32, hi: i32, v: i32): boolean {
  if (integer) {
    return hard[v];
  }
  return spans_call(cum, lo, hi);
}

function order_by_lo(n: i32, lo: i32[]): i32[] {
  let maxp: i32 = 0;
  let v: i32 = 0;
  while (v < n) {
    if (lo[v] < 2000000000 && lo[v] > maxp) {
      maxp = lo[v];
    }
    v = v + 1;
  }
  let starts: i32[] = __alloc_i32(maxp + 3);
  v = 0;
  while (v < n) {
    let b: i32 = order_bucket(lo[v], maxp);
    starts = starts.with(b + 1, starts[b + 1] + 1);
    v = v + 1;
  }
  let b2: i32 = 1;
  while (b2 < starts.len()) {
    starts = starts.with(b2, starts[b2] + starts[b2 - 1]);
    b2 = b2 + 1;
  }
  let out: i32[] = __alloc_i32(n);
  v = 0;
  while (v < n) {
    let bk: i32 = order_bucket(lo[v], maxp);
    out = out.with(starts[bk], v);
    starts = starts.with(bk, starts[bk] + 1);
    v = v + 1;
  }
  return out;
}

function order_bucket(lo: i32, maxp: i32): i32 {
  if (lo >= 2000000000) {
    return maxp + 1;
  }
  return lo;
}

function extend_loop_invariant_intervals(f: SFunc, def_pos: i32[], hi: i32[]): i32[] {
  let top: i32 = 0 - 1;
  for b in f.blocks {
    if (b.id > top) {
      top = b.id;
    }
  }
  let start_of: i32[] = util.minus_ones(top + 1);
  let rpos: i32 = 0;
  for b in f.blocks {
    if (b.id >= 0) {
      start_of = start_of.with(b.id, rpos);
    }
    rpos = rpos + b.insts.len() + 1;
  }
  let edge_head: i32[] = [];
  let edge_end: i32[] = [];
  let lstart: i32 = 0;
  for lblk in f.blocks {
    let lterm_pos: i32 = lstart + lblk.insts.len();
    let th: i32 = 0;
    while (th < 2) {
      let tgt: i32 = 0 - 1;
      if (th == 0) {
        if (lblk.term.kind_tag == 2) {
          tgt = lblk.term.target;
        } else if (lblk.term.kind_tag == 3) {
          tgt = lblk.term.t;
        }
      } else if (lblk.term.kind_tag == 3) {
        tgt = lblk.term.f;
      }
      if (tgt >= 0 && tgt <= top) {
        let hstart: i32 = start_of[tgt];
        if (hstart >= 0 && hstart <= lstart) {
          edge_head = edge_head.append(hstart);
          edge_end = edge_end.append(lterm_pos);
        }
      }
      th = th + 1;
    }
    lstart = lterm_pos + 1;
  }
  if (edge_head.len() == 0) {
    return hi;
  }
  let heads: i32[] = sorted_i32(edge_head);
  let vv: i32 = 0;
  while (vv < f.nvals && vv < hi.len()) {
    let d: i32 = def_pos[vv];
    if (d >= 0) {
      let first: i32 = first_above(heads, d);
      if (first < heads.len() && heads[first] <= hi[vv]) {
        let e: i32 = 0;
        while (e < edge_head.len()) {
          if (d < edge_head[e] && hi[vv] >= edge_head[e] && edge_end[e] > hi[vv]) {
            hi = hi.with(vv, edge_end[e]);
          }
          e = e + 1;
        }
      }
    }
    vv = vv + 1;
  }
  return hi;
}

function sorted_i32(xs: i32[]): i32[] {
  let out: i32[] = [];
  for x in xs {
    out = out.append(x);
    let i: i32 = out.len() - 1;
    while (i > 0 && out[i - 1] > x) {
      out = out.with(i, out[i - 1]);
      i = i - 1;
    }
    out = out.with(i, x);
  }
  return out;
}

function first_above(xs: i32[], v: i32): i32 {
  let lo: i32 = 0;
  let hi: i32 = xs.len();
  while (lo < hi) {
    let mid: i32 = (lo + hi) / 2;
    if (xs[mid] > v) {
      hi = mid;
    } else {
      lo = mid + 1;
    }
  }
  return lo;
}

pub function binary_fixes_abi(op: string): boolean {
  return op == "div_s" || op == "div_u" || op == "rem_s" || op == "rem_u" || op == "mulhi_u";
}

function pick_caller_reg(free: i32[], abi_reg: i32, want_abi: boolean, abi_ok: boolean): i32 {
  if (free.len() == 0) {
    return 0 - 1;
  }
  if (abi_reg < 0) {
    return free[free.len() - 1];
  }
  if (want_abi) {
    for r in free {
      if (r == abi_reg) {
        return abi_reg;
      }
    }
  }
  let i: i32 = free.len() - 1;
  while (i >= 0) {
    if (free[i] != abi_reg) {
      return free[i];
    }
    i = i - 1;
  }
  if (!abi_ok) {
    return 0 - 1;
  }
  return abi_reg;
}

function pick_fixed_reg(free: i32[], abi_reg: i32, want_abi: boolean, abi_ok: boolean, fixed: ssafixed.Table, lo: i32, hi: i32): i32 {
  if (ssafixed.empty(fixed)) {
    return pick_caller_reg(free, abi_reg, want_abi, abi_ok);
  }
  let take_abi = abi_ok && abi_reg >= 0 && ssafixed.allows(fixed, abi_reg, lo, hi) && index_of_reg(free, abi_reg) >= 0;
  if (want_abi && take_abi) {
    return abi_reg;
  }
  let i = free.len() - 1;
  while (i >= 0) {
    let r = free[i];
    if (r != abi_reg && ssafixed.allows(fixed, r, lo, hi)) {
      return r;
    }
    i = i - 1;
  }
  if (take_abi) {
    return abi_reg;
  }
  return 0 - 1;
}

function preferred_register_allowed(reg: i32, abi: i32, abi_ok: boolean, spans: boolean, lo: i32, hi: i32, fixed: ssafixed.Table): boolean {
  return reg >= 0 && !spans && (reg != abi || abi_ok) && ssafixed.allows(fixed, reg, lo, hi);
}

function candidate(mates: Mates, def_a: i32[], def_b: i32[], v: i32, k: i32): i32 {
  if (k == 0) {
    return mates.alt[v];
  }
  if (k == 1) {
    return mates.hint[v];
  }
  if (k == 2) {
    return 0 - 2;
  }
  if (k == 3) {
    return def_a[v];
  }
  return def_b[v];
}

function remove_reg(free: i32[], reg: i32): i32[] {
  let out: i32[] = [];
  let dropped: boolean = false;
  for r in free {
    if (r == reg && !dropped) {
      dropped = true;
    } else {
      out = out.append(r);
    }
  }
  return out;
}

function forbidden_abi(abi_reg: i32, allowed: boolean): i32 {
  if (allowed) {
    return 0 - 1;
  }
  return abi_reg;
}

function cheapest_active(act_val: i32[], act_reg: i32[], act_hi: i32[], shared_with: i32[], weight: i32[], lo: i32[], hi: i32[], now: i32, nregs: i32, need_saved: boolean, forbidden: i32, fixed: ssafixed.Table, until: i32): i32 {
  let best: i32 = 0 - 1;
  let best_w: i32 = 0;
  let best_len: i32 = 1;
  let i: i32 = 0;
  while (i < act_val.len()) {
    if (act_reg[i] >= nregs == need_saved && act_reg[i] != forbidden && ssafixed.allows(fixed, act_reg[i], now, until)) {
      let w: i32 = chain_weight(act_val[i], shared_with, weight, hi, now);
      let len: i32 = act_hi[i] - chain_lo(act_val[i], shared_with, lo, hi, now) + 1;
      let cmp: i32 = cmp_spill_cost(w, len, best_w, best_len);
      if (best < 0 || cmp < 0 || cmp == 0 && act_hi[i] > act_hi[best]) {
        best = i;
        best_w = w;
        best_len = len;
      }
    }
    i = i + 1;
  }
  return best;
}

function cmp_spill_cost(w1: i32, len1: i32, w2: i32, len2: i32): i32 {
  let a: f64 = w1 as f64 * (w1 as f64) * (len2 as f64);
  let b: f64 = w2 as f64 * (w2 as f64) * (len1 as f64);
  if (a < b) {
    return 0 - 1;
  }
  if (a > b) {
    return 1;
  }
  return 0;
}

function chain_lo(v: i32, shared_with: i32[], lo: i32[], hi: i32[], now: i32): i32 {
  let m: i32 = lo[v];
  let ev: i32 = shared_with[v];
  while (ev >= 0) {
    if (still_holds(ev, hi, now) && lo[ev] < m) {
      m = lo[ev];
    }
    ev = shared_with[ev];
  }
  return m;
}

function chain_weight(v: i32, shared_with: i32[], weight: i32[], hi: i32[], now: i32): i32 {
  let w: i32 = weight[v];
  let ev: i32 = shared_with[v];
  while (ev >= 0) {
    if (still_holds(ev, hi, now)) {
      w = w + weight[ev];
    }
    ev = shared_with[ev];
  }
  return w;
}

function any_below(xs: i32[], x: i32): boolean {
  for e in xs {
    if (e < x) {
      return true;
    }
  }
  return false;
}

function still_holds(ev: i32, hi: i32[], now: i32): boolean {
  return hi[ev] >= now;
}

function block_loop_weights(f: SFunc): i32[] {
  let at: i32[] = block_positions(f);
  let depth: i32[] = __alloc_i32(f.blocks.len());
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let which: i32 = 0;
    while (which < 2) {
      let tgt: i32 = distinct_successor_position(at, f.blocks[bi].term, which);
      if (tgt >= 0 && tgt <= bi) {
        let k: i32 = tgt;
        while (k <= bi) {
          depth = depth.with(k, depth[k] + 1);
          k = k + 1;
        }
      }
      which = which + 1;
    }
    bi = bi + 1;
  }
  let out: i32[] = [];
  for d in depth {
    let w: i32 = 1;
    let n: i32 = 0;
    while (n < d && n < 3) {
      w = w * 8;
      n = n + 1;
    }
    out = out.append(w);
  }
  return out;
}

function drop_active_at(a: i32[], k: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < a.len()) {
    if (i != k) {
      out = out.append(a[i]);
    }
    i = i + 1;
  }
  return out;
}

pub struct Alloc { reg_of: i32[], def_pos: i32[], lo: i32[], hi: i32[], cold: i32[] }

pub function lane_base(op: string): string {
  let k: i32 = 0;
  while (k < op.len()) {
    if (op[k] == b':') {
      return slice_unchecked(op, 0, k) + "";
    }
    k = k + 1;
  }
  return op;
}

pub function lane_op(op: string): boolean {
  return op.len() > 1 && op[0] == b'v' && ir.is_lane_kind(ir.kind_id(lane_base(op)));
}

pub function lane_inst(ins: SInst): boolean {
  let k: i32 = ins.kind_tag;
  return (k == 9 || k == 10 || k == 61 || k == 62) && lane_op(ins.str);
}

pub function lane_param(f: SFunc, p: i32): boolean {
  if (f.blocks.len() == 0) {
    return false;
  }
  for ins in f.blocks[0].insts {
    if (ins.kind_tag == 6 && ins.imm == p) {
      return ins.str == lane_param_mark();
    }
  }
  return false;
}

pub function lane_param_mark(): string {
  return "v128";
}

pub function lane_memory(b: string): boolean {
  return util.has_str(["vload", "vstore", "vget", "vset"], b);
}

pub function lane_result(ins: SInst): boolean {
  if (ins.kind_tag == 6 && ins.str == lane_param_mark() || ins.kind_tag == 11 && ins.imm == 6) {
    return true;
  }
  if (!lane_inst(ins)) {
    return false;
  }
  let b: string = lane_base(ins.str);
  return b != "vextract" && b != "vbitmask" && b != "vstore" && b != "vset";
}

pub function lane_values(f: SFunc): boolean[] {
  let lanes: boolean[] = lane_results(f);
  if (lanes.len() == 0) {
    return [];
  }
  return lane_carriers(f, lanes);
}

function lane_results(f: SFunc): boolean[] {
  let lanes: boolean[] = [];
  for blk in f.blocks {
    for ins in blk.insts {
      let k: i32 = ins.kind_tag;
      let maybe: boolean = k == 6 || k == 11 && ins.imm == 6 || (k == 9 || k == 10 || k == 61 || k == 62) && ins.str.len() > 1 && ins.str[0] == b'v';
      if (maybe && ins.result >= 0 && ins.result < f.nvals && lane_result(ins)) {
        if (lanes.len() == 0) {
          lanes = __alloc_bool(f.nvals);
        }
        lanes = lanes.with(ins.result, true);
      }
    }
  }
  return lanes;
}

function lane_carriers(f: SFunc, lanes: boolean[]): boolean[] {
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for blk in f.blocks {
      for ins in blk.insts {
        if ((ins.kind_tag == 8 || ins.kind_tag == 7) && ins.result >= 0 && !lanes[ins.result] && phi_joins_lane(ins, lanes)) {
          lanes = lanes.with(ins.result, true);
          changed = true;
        }
      }
    }
  }
  return lanes;
}

function phi_joins_lane(ins: SInst, lanes: boolean[]): boolean {
  for a in ins.args {
    if (a >= 0 && a < lanes.len() && lanes[a]) {
      return true;
    }
  }
  return false;
}

pub function has_lanes(f: SFunc): boolean {
  return lane_values(f).len() > 0;
}

pub function float_values(f: SFunc, fcalls: boolean[], tolerant: boolean): boolean[] {
  let fl: boolean[] = __alloc_bool(f.nvals);
  let derived: boolean[] = __alloc_bool(f.nvals);
  let seeded: boolean = false;
  for blk in f.blocks {
    for ins in blk.insts {
      let fcall: boolean = ins.kind_tag == 11 && ins.result >= 0 && ins.result < fcalls.len() && fcalls[ins.result];
      if (ins.result >= 0 && ins.result < f.nvals && (float_def(ins) || fcall)) {
        let d: boolean = ins.kind_tag == 6 || ins.kind_tag == 8 || ins.kind_tag == 11 || float_load(ins);
        fl = fl.with(ins.result, true);
        derived = derived.with(ins.result, d);
        seeded = seeded || !d;
      }
      seeded = seeded || float_use(ins);
    }
  }
  if (!seeded) {
    return with_lanes(f, __alloc_bool(f.nvals));
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let strong: boolean[] = float_strong(f, fl, derived);
    for blk in f.blocks {
      for ins in blk.insts {
        let keeps: boolean = float_use(ins) || ins.kind_tag == 8 && fl[ins.result] || tolerant && float_tolerant(ins);
        for a in ins.args {
          if (!keeps && a >= 0 && a < f.nvals && fl[a]) {
            fl = fl.with(a, false);
            changed = true;
          }
        }
      }
      let t: STerm = blk.term;
      if (t.kind_tag == 3 && t.cond >= 0 && t.cond < f.nvals && fl[t.cond]) {
        fl = fl.with(t.cond, false);
        changed = true;
      }
    }
    let v: i32 = 0;
    while (v < f.nvals) {
      if (fl[v] && derived[v] && !strong[v]) {
        fl = fl.with(v, false);
        changed = true;
      }
      v = v + 1;
    }
  }
  return with_lanes(f, fl);
}

function with_lanes(f: SFunc, fl: boolean[]): boolean[] {
  let lanes: boolean[] = lane_values(f);
  let v: i32 = 0;
  while (v < lanes.len()) {
    if (lanes[v]) {
      fl = fl.with(v, true);
    }
    v = v + 1;
  }
  for x in fl {
    if (x) {
      return fl;
    }
  }
  return [];
}

function float_strong(f: SFunc, fl: boolean[], derived: boolean[]): boolean[] {
  let strong: boolean[] = __alloc_bool(f.nvals);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for blk in f.blocks {
      for ins in blk.insts {
        let fop: boolean = float_use(ins) || ins.kind_tag == 8 && fl[ins.result] && strong[ins.result];
        for a in ins.args {
          if (fop && a >= 0 && a < f.nvals && fl[a] && !strong[a]) {
            strong = strong.with(a, true);
            changed = true;
          }
        }
        if (ins.kind_tag == 8 && ins.result >= 0 && fl[ins.result] && !strong[ins.result]) {
          for a in ins.args {
            if (a >= 0 && a < f.nvals && fl[a] && (!derived[a] || strong[a]) && !strong[ins.result]) {
              strong = strong.with(ins.result, true);
              changed = true;
            }
          }
        }
      }
    }
  }
  return strong;
}

function float_tolerant(ins: SInst): boolean {
  return ins.kind_tag == 11 && !rc_inlined(ins);
}

function float_def(ins: SInst): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 4 || k == 6 || k == 8 || float_load(ins)) {
    return true;
  }
  if (k == 9) {
    return float_arith(ins.str);
  }
  if (k == 10) {
    return float_math(ins.str) || util.str_has_prefix(ins.str, "i32_to_f64:") || ins.str == "f64_from_bits" || lane_base(ins.str) == "vextract";
  }
  return false;
}

function float_load(ins: SInst): boolean {
  return ins.kind_tag == 40 || ins.kind_tag == 42 && ins.str != "u8";
}

function float_use(ins: SInst): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 9) {
    return float_arith(ins.str) || float_cmp(ins.str);
  }
  if (k == 10) {
    return float_math(ins.str) || ins.str == "f64_to_i32" || ins.str == "f64_to_i64" || ins.str == "f64_bits" || ins.str == "vsplat";
  }
  return false;
}

pub function float_arith(op: string): boolean {
  return op == "fadd" || op == "fsub" || op == "fmul" || op == "fdiv";
}

pub function float_cmp(op: string): boolean {
  return op == "feq" || op == "fne" || op == "flt" || op == "fle" || op == "fgt" || op == "fge";
}

pub function float_math(op: string): boolean {
  return op == "fsqrt" || op == "ffloor" || op == "fceil" || op == "ftrunc" || op == "fabs" || op == "fround" || op == "fneg";
}

function class_order(order: i32[], fl: boolean[]): i32[] {
  let out: i32[] = [];
  for v in order {
    if (!fl[v]) {
      out = out.append(v);
    }
  }
  for v in order {
    if (fl[v]) {
      out = out.append(v);
    }
  }
  return out;
}

function count_false(fl: boolean[]): i32 {
  let n: i32 = 0;
  for x in fl {
    if (!x) {
      n = n + 1;
    }
  }
  return n;
}

pub function regalloc_linear(f: SFunc, nregs: i32, nsaved: i32, abi_reg: i32, abi_fixed_by_div: boolean, no_home: boolean[], pref: i32[], fl: boolean[], nf: i32, nfs: i32): Alloc {
  return regalloc_linear_fixed(f, nregs, nsaved, abi_reg, abi_fixed_by_div, no_home, pref, fl, nf, nfs, ssafixed.none(), []);
}

pub function regalloc_linear_fixed(f: SFunc, nregs: i32, nsaved: i32, abi_reg: i32, abi_fixed_by_div: boolean, no_home: boolean[], pref: i32[], fl: boolean[], nf: i32, nfs: i32, fixed: ssafixed.Table, cold: i32[]): Alloc {
  let cold_calls: boolean = cold.len() > 0;
  let wish: i32[] = return_prefs(f, pref, abi_reg);
  let big: i32 = 2000000000;
  let lo: i32[] = __alloc_i32(f.nvals);
  let hi: i32[] = __alloc_i32(f.nvals);
  let i: i32 = 0;
  while (i < f.nvals) {
    lo = lo.with(i, big);
    hi = hi.with(i, 0 - 1);
    i = i + 1;
  }
  let calls: i32[] = [];
  let all_calls: i32[] = [];
  let soft_calls: i32[] = [];
  let abi_cl: i32[] = [];

  let def_pos: i32[] = __alloc_i32(f.nvals);
  let def_blk: i32[] = __alloc_i32(f.nvals);
  let call_def: i32[] = __alloc_i32(f.nvals);
  let reads_mate: boolean[] = __alloc_bool(f.nvals);
  let def_a: i32[] = __alloc_i32(f.nvals);
  let def_b: i32[] = __alloc_i32(f.nvals);
  i = 0;
  while (i < f.nvals) {
    def_pos = def_pos.with(i, 0 - 1);
    def_blk = def_blk.with(i, 0 - 1);
    def_a = def_a.with(i, 0 - 1);
    def_b = def_b.with(i, 0 - 1);
    i = i + 1;
  }
  let blk_start: i32[] = [];
  let pos: i32 = 0;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    blk_start = blk_start.append(pos);
    let k: i32 = 0;
    while (k < blk.insts.len()) {
      let ins: SInst = blk.insts[k];
      if (ins.result >= 0 && ins.result < lo.len() && pos < lo[ins.result]) {
        lo = lo.with(ins.result, pos);
      }
      if (ins.result >= 0 && ins.result < hi.len() && pos > hi[ins.result]) {
        hi = hi.with(ins.result, pos);
      }
      if (ins.result >= 0 && ins.result < def_pos.len()) {
        def_pos = def_pos.with(ins.result, pos);
        def_blk = def_blk.with(ins.result, bi);
        if (ins.kind_tag == 36) {
          reads_mate = reads_mate.with(ins.result, true);
          def_a = def_a.with(ins.result, ins.args[1]);
          def_b = def_b.with(ins.result, ins.args[2]);
        } else if (ins.kind_tag == 8 || ins.kind_tag == 10 || ins.kind_tag == 11 || ins.kind_tag == 56 || ins.kind_tag == 60 || ins.kind_tag == 9 && shares_operand_home(ins.str)) {
          reads_mate = reads_mate.with(ins.result, true);
          if (ins.kind_tag != 8 && ins.args.len() > 0) {
            def_a = def_a.with(ins.result, ins.args[0]);
          }
          if (ins.kind_tag != 8 && ins.args.len() > 1) {
            def_b = def_b.with(ins.result, ins.args[1]);
          }
        }
      }
      let a: i32 = 0;
      while (a < ins.args.len() && ins.kind_tag != 8) {
        if (ins.args[a] >= 0 && ins.args[a] < lo.len() && pos < lo[ins.args[a]]) {
          lo = lo.with(ins.args[a], pos);
        }
        if (ins.args[a] >= 0 && ins.args[a] < hi.len() && pos > hi[ins.args[a]]) {
          hi = hi.with(ins.args[a], pos);
        }
        a = a + 1;
      }
      if (inst_is_call(ins.kind_tag) && !never_returns(ins)) {
        if (!returns_call(blk, k)) {
          all_calls = all_calls.append(pos);
          let kind: i32 = COLD_NONE;
          if (cold_calls) {
            kind = cold[pos];
          }
          if (kind == COLD_NONE) {
            calls = calls.append(pos);
          } else if (kind == COLD_BRANCH) {
            soft_calls = soft_calls.append(pos);
          }
        }
        if (ins.result >= 0 && ins.result < call_def.len()) {
          call_def = call_def.with(ins.result, 1);
        }
      }
      if (abi_fixed_by_div && ins.kind_tag == 9 && binary_fixes_abi(ins.str)) {
        abi_cl = abi_cl.append(pos);
      }
      pos = pos + 1;
      k = k + 1;
    }
    if (blk.term.kind_tag == 1) {
      if (blk.term.value >= 0 && blk.term.value < lo.len() && pos < lo[blk.term.value]) {
        lo = lo.with(blk.term.value, pos);
      }
      if (blk.term.value >= 0 && blk.term.value < hi.len() && pos > hi[blk.term.value]) {
        hi = hi.with(blk.term.value, pos);
      }
    } else if (blk.term.kind_tag == 3) {
      if (blk.term.cond >= 0 && blk.term.cond < lo.len() && pos < lo[blk.term.cond]) {
        lo = lo.with(blk.term.cond, pos);
      }
      if (blk.term.cond >= 0 && blk.term.cond < hi.len() && pos > hi[blk.term.cond]) {
        hi = hi.with(blk.term.cond, pos);
      }
    }
    pos = pos + 1;
    bi = bi + 1;
  }
  i = 0;
  while (i < f.nparams && i < f.nvals) {
    if (hi[i] >= 0) {
      lo = lo.with(i, 0);
    }
    i = i + 1;
  }
  let total_pos: i32 = pos;
  ssafixed.validate(fixed, nregs, total_pos);
  let at: i32[] = block_positions(f);
  bi = 0;
  while (bi < f.blocks.len()) {
    let pb: SBlock = f.blocks[bi];
    let pk: i32 = 0;
    while (pk < pb.insts.len()) {
      let ph: SInst = pb.insts[pk];
      if (ph.kind_tag == 8) {
        let sl: i32 = 0;
        while (sl < ph.args.len()) {
          let upos: i32 = blk_start[bi] + pk;
          if (sl < pb.preds.len() && pb.preds[sl] >= 0 && pb.preds[sl] < at.len() && at[pb.preds[sl]] >= 0) {
            let pi: i32 = at[pb.preds[sl]];
            upos = blk_start[pi] + f.blocks[pi].insts.len();
          }
          let pa: i32 = ph.args[sl];
          if (pa >= 0 && pa < lo.len() && upos < lo[pa]) {
            lo = lo.with(pa, upos);
          }
          if (pa >= 0 && pa < hi.len() && upos > hi[pa]) {
            hi = hi.with(pa, upos);
          }
          sl = sl + 1;
        }
      }
      pk = pk + 1;
    }
    bi = bi + 1;
  }
  i = 0;
  while (i < no_home.len() && i < f.nvals) {
    if (no_home[i]) {
      hi = hi.with(i, 0 - 1);
    }
    i = i + 1;
  }

  hi = extend_loop_invariant_intervals(f, def_pos, hi);
  let cum: i32[] = calls_before(calls, total_pos);
  let cum_abi: i32[] = calls_before(abi_cl, total_pos);
  let cum_all: i32[] = cum;
  let cum_soft: i32[] = calls_before(soft_calls, total_pos);
  if (cold_calls) {
    cum_all = calls_before(all_calls, total_pos);
  }
  let mates: Mates = phi_mates(f, at, def_pos, hi, no_home);
  let weight: i32[] = spill_weights(f, at);
  let hard: boolean[] = hard_spans(f, cum, cold, lo, hi, weight);
  let sole: i32[] = sole_readers(f);

  let sites: ReadSites = ReadSites { start: [], blk: [], pos: [], succ_a: [], succ_b: [], phi_end: [] };
  let reg_of: i32[] = __alloc_i32(f.nvals);
  let shared_with: i32[] = __alloc_i32(f.nvals);
  i = 0;
  while (i < f.nvals) {
    reg_of = reg_of.with(i, 0 - 1);
    shared_with = shared_with.with(i, 0 - 1);
    i = i + 1;
  }

  let order: i32[] = order_by_lo(f.nvals, lo);
  let split: i32 = order.len();
  if (fl.len() > 0) {
    order = class_order(order, fl);
    split = count_false(fl);
  }
  let act_val: i32[] = [];
  let act_hi: i32[] = [];
  let act_reg: i32[] = [];
  let free: i32[] = [];
  let r: i32 = nregs - 1;
  while (r >= 0) {
    free = free.append(r);
    r = r - 1;
  }
  let free_s: i32[] = [];
  r = nregs + nsaved - 1;
  while (r >= nregs) {
    free_s = free_s.append(r);
    r = r - 1;
  }

  let cbase: i32 = 0;
  let sat: i32 = nregs;
  let cabi: i32 = abi_reg;
  let oi: i32 = 0;
  while (oi < order.len()) {
    if (oi == split) {
      cum = cum_all;
      cbase = nregs + nsaved;
      sat = cbase + nf;
      cabi = 0 - 1;
      act_val = [];
      act_hi = [];
      act_reg = [];
      free = [];
      r = sat - 1;
      while (r >= cbase) {
        free = free.append(r);
        r = r - 1;
      }
      free_s = [];
      r = sat + nfs - 1;
      while (r >= sat) {
        free_s = free_s.append(r);
        r = r - 1;
      }
    }
    let v: i32 = order[oi];
    if (hi[v] < 0) {
      oi = oi + 1;
      continue;
    }
    if (any_below(act_hi, lo[v])) {
      let nv: i32[] = [];
      let nh: i32[] = [];
      let nr: i32[] = [];
      let ai: i32 = 0;
      while (ai < act_val.len()) {
        if (act_hi[ai] < lo[v]) {
          if (act_reg[ai] >= sat) {
            free_s = free_s.append(act_reg[ai]);
          } else {
            free = free.append(act_reg[ai]);
          }
        } else {
          nv = nv.append(act_val[ai]);
          nh = nh.append(act_hi[ai]);
          nr = nr.append(act_reg[ai]);
        }
        ai = ai + 1;
      }
      act_val = nv;
      act_hi = nh;
      act_reg = nr;
    }

    let mh: i32 = mates.hint[v];
    if (mh >= 0 && sole[v] == mh && lo[mh] <= lo[v] && hi[mh] >= 0 && reg_of[mh] == 0 - 1) {
      if (sites.start.len() == 0) {
        sites = read_sites(f, at, blk_start);
      }
      if (!live_at_def(sites, mh, v, def_blk, def_pos)) {
        oi = oi + 1;
        continue;
      }
    }
    if (mh >= 0 && mates.through[v] && reg_of[mh] == 0 - 1 && hi[mh] < lo[v] && !(cold_calls && weight[v] > 4 * weight[mh])) {
      oi = oi + 1;
      continue;
    }
    let ma: i32 = mates.alt[v];
    if (ma >= 0 && reg_of[ma] == 0 - 1 && lo[ma] <= lo[v] && hi[ma] >= 0) {
      if (sites.start.len() == 0) {
        sites = read_sites(f, at, blk_start);
      }
      if (!live_at_def(sites, ma, v, def_blk, def_pos)) {
        oi = oi + 1;
        continue;
      }
    }
    let abi_ok: boolean = !spans_call(cum_abi, lo[v], hi[v]);
    let soft: boolean = cold_calls && oi < split && spans_call(cum_soft, lo[v], hi[v]) && free_s.len() > 0;
    let keep_caller: boolean = spans_hard(hard, oi < split, cum, lo[v], hi[v], v) || soft;
    let placed: boolean = false;
    let ci: i32 = 0;
    while (ci < 5 && !placed) {
      let h: i32 = candidate(mates, def_a, def_b, v, ci);
      ci = ci + 1;
      if (ci == 1 && h == mates.hint[v]) {
        continue;
      }
      if (h == 0 - 2) {
        let pr: i32 = 0 - 1;
        if (v < wish.len()) {
          pr = wish[v];
        }
        if (!preferred_register_allowed(pr, abi_reg, abi_ok, keep_caller, lo[v], hi[v], fixed)) {
          continue;
        }
        if (index_of_reg(free, pr) >= 0) {
          free = remove_reg(free, pr);
          reg_of = reg_of.with(v, pr);
          act_val = act_val.append(v);
          act_hi = act_hi.append(hi[v]);
          act_reg = act_reg.append(pr);
          placed = true;
          continue;
        }
        let held: i32 = index_of_reg(act_reg, pr);
        if (held < 0) {
          continue;
        }
        h = act_val[held];
      }
      if (h < 0 || reg_of[h] < 0) {
        continue;
      }
      let hr: i32 = reg_of[h];
      if (call_def[v] == 1 && h != mates.hint[v] && hr != abi_reg) {
        continue;
      }
      if (hr < cbase || keep_caller && hr < sat || hr == cabi && !abi_ok || !ssafixed.allows(fixed, hr, lo[v], hi[v])) {
        continue;
      }
      let fi: i32 = index_of_reg(free, hr);
      let fsi: i32 = index_of_reg(free_s, hr);
      if (fi >= 0 || fsi >= 0) {
        if (fi >= 0) {
          free = remove_reg(free, hr);
        } else {
          free_s = remove_reg(free_s, hr);
        }
        reg_of = reg_of.with(v, hr);
        shared_with = shared_with.with(v, h);
        act_val = act_val.append(v);
        act_hi = act_hi.append(hi[v]);
        act_reg = act_reg.append(hr);
        placed = true;
        continue;
      }
      let ha: i32 = index_of_reg(act_reg, hr);
      if (ha < 0) {
        continue;
      }
      let share: boolean = act_hi[ha] == lo[v] && reads_mate[v];
      if (!share && (h == mates.hint[v] && mates.carried[v] || h == mates.alt[v])) {
        if (sites.start.len() == 0) {
          sites = read_sites(f, at, blk_start);
        }
        share = chain_dead_at_def(sites, act_val[ha], v, shared_with, lo, hi, def_blk, def_pos);
      }
      if (!share) {
        continue;
      }
      let top: i32 = act_hi[ha];
      if (hi[v] > top) {
        top = hi[v];
      }
      let holder: i32 = act_val[ha];
      act_val = drop_active_at(act_val, ha);
      act_hi = drop_active_at(act_hi, ha);
      act_reg = drop_active_at(act_reg, ha);
      reg_of = reg_of.with(v, hr);
      shared_with = shared_with.with(v, holder);
      act_val = act_val.append(v);
      act_hi = act_hi.append(top);
      act_reg = act_reg.append(hr);
      placed = true;
    }
    if (placed) {
      oi = oi + 1;
      continue;
    }
    let pick: i32 = pick_fixed_reg(free, cabi, call_def[v] == 1 && abi_ok, abi_ok, fixed, lo[v], hi[v]);
    let from_caller: boolean = !spans_hard(hard, oi < split, cum, lo[v], hi[v], v) && pick >= 0 && !soft;
    from_caller = from_caller || cold_caller(free_s.len(), cold_calls && oi < split, pick, cum, lo[v], hi[v]);
    if (!from_caller && free_s.len() == 0) {
      let need_saved: boolean = spans_hard(hard, oi < split, cum, lo[v], hi[v], v);
      let fa: i32 = cheapest_active(act_val, act_reg, act_hi, shared_with, weight, lo, hi, lo[v], sat, need_saved, forbidden_abi(cabi, abi_ok), fixed, hi[v]);
      let cmp: i32 = 0;
      if (fa >= 0) {
        let fw: i32 = chain_weight(act_val[fa], shared_with, weight, hi, lo[v]);
        cmp = cmp_spill_cost(fw, act_hi[fa] - chain_lo(act_val[fa], shared_with, lo, hi, lo[v]) + 1, weight[v], hi[v] - lo[v] + 1);
      }
      if (fa >= 0 && (cmp < 0 || cmp == 0 && act_hi[fa] > hi[v])) {
        let taken: i32 = act_reg[fa];
        let ev: i32 = act_val[fa];
        let first: boolean = true;
        while (ev >= 0) {
          if (first || still_holds(ev, hi, lo[v])) {
            reg_of = reg_of.with(ev, 0 - 1);
          }
          first = false;
          let nx: i32 = shared_with[ev];
          shared_with = shared_with.with(ev, 0 - 1);
          ev = nx;
        }
        act_val = drop_active_at(act_val, fa);
        act_hi = drop_active_at(act_hi, fa);
        act_reg = drop_active_at(act_reg, fa);
        reg_of = reg_of.with(v, taken);
        act_val = act_val.append(v);
        act_hi = act_hi.append(hi[v]);
        act_reg = act_reg.append(taken);
      } else {
        reg_of = reg_of.with(v, 0 - 1);
      }
    } else {
      let reg: i32 = 0;
      if (from_caller) {
        reg = pick;
        free = remove_reg(free, reg);
      } else {
        reg = free_s[free_s.len() - 1];
        free_s = drop_last_i(free_s);
      }
      reg_of = reg_of.with(v, reg);
      act_val = act_val.append(v);
      act_hi = act_hi.append(hi[v]);
      act_reg = act_reg.append(reg);
    }
    oi = oi + 1;
  }
  if (nfs > 0) {
    reg_of = lanes_off_saved(f, reg_of, nregs + nsaved + nf);
  }
  let shape: SlotShape = SlotShape { at: at, blk_start: blk_start, def_blk: def_blk, def_pos: def_pos, def_a: def_a, def_b: def_b };
  if (sites.start.len() == 0 && spilled_mates(reg_of, def_pos, mates.hint)) {
    sites = read_sites(f, at, blk_start);
  }
  return Alloc { reg_of: assign_spill_slots(f, shape, lo, hi, reg_of, slot_hints(f, sites, def_blk, def_pos, reg_of, mates), sites), def_pos: def_pos, lo: lo, hi: hi, cold: cold };
}

function lanes_off_saved(f: SFunc, reg_of: i32[], saved_from: i32): i32[] {
  let lanes: boolean[] = lane_values(f);
  let v: i32 = 0;
  while (v < lanes.len()) {
    if (lanes[v] && reg_of[v] >= saved_from) {
      reg_of = reg_of.with(v, 0 - 1);
    }
    v = v + 1;
  }
  return reg_of;
}

struct SlotHints { hint: i32[], take_over: boolean[] }

function slot_hints(f: SFunc, sites: ReadSites, def_blk: i32[], def_pos: i32[], reg_of: i32[], mates: Mates): SlotHints {
  let hint: i32[] = [];
  let take_over: boolean[] = [];
  let i: i32 = 0;
  while (i < f.nvals) {
    let sh: i32 = mates.hint[i];
    if (reg_of[i] >= 0 || sh < 0 || reg_of[sh] >= 0) {
      sh = 0 - 1;
    }
    let free: boolean = sh >= 0 && def_pos[sh] >= 0 && !live_at_def(sites, sh, i, def_blk, def_pos);
    if (sh >= 0 && mates.carried[i] && !free) {
      sh = 0 - 1;
    }
    hint = hint.append(sh);
    take_over = take_over.append(free);
    i = i + 1;
  }
  return SlotHints { hint: hint, take_over: take_over };
}

function spilled_mates(reg_of: i32[], def_pos: i32[], hint: i32[]): boolean {
  let i: i32 = 0;
  while (i < reg_of.len()) {
    let sh: i32 = hint[i];
    if (reg_of[i] < 0 && sh >= 0 && reg_of[sh] < 0 && def_pos[sh] >= 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function return_prefs(f: SFunc, pref: i32[], abi_reg: i32): i32[] {
  let out: i32[] = pref;
  while (out.len() < f.nvals) {
    out = out.append(0 - 1);
  }
  for blk in f.blocks {
    let v: i32 = blk.term.value;
    if (blk.term.kind_tag == 1 && v >= 0 && v < out.len() && out[v] < 0) {
      out = out.with(v, abi_reg);
    }
  }
  let bi: i32 = f.blocks.len() - 1;
  while (bi >= 0) {
    for ins in f.blocks[bi].insts {
      if (ins.kind_tag == 8 && ins.result >= 0 && ins.result < out.len() && out[ins.result] >= 0) {
        for a in ins.args {
          if (a >= 0 && a < out.len() && out[a] < 0) {
            out = out.with(a, out[ins.result]);
          }
        }
      }
    }
    bi = bi - 1;
  }
  return out;
}

function sole_readers(f: SFunc): i32[] {
  let out: i32[] = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      for a in ins.args {
        if (a >= 0 && a < f.nvals && out[a] != ins.result) {
          if (out[a] == 0 - 1 && ins.result >= 0) {
            out = out.with(a, ins.result);
          } else {
            out = out.with(a, 0 - 2);
          }
        }
      }
    }
    let tv: i32 = 0 - 1;
    if (blk.term.kind_tag == 1) {
      tv = blk.term.value;
    }
    if (blk.term.kind_tag == 3) {
      tv = blk.term.cond;
    }
    if (tv >= 0 && tv < f.nvals) {
      out = out.with(tv, 0 - 2);
    }
  }
  return out;
}

function spill_weights(f: SFunc, at: i32[]): i32[] {
  let bw: i32[] = block_loop_weights(f);
  let w: i32[] = __alloc_i32(f.nvals);
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals) {
        w = w.with(ins.result, w[ins.result] + bw[bi]);
      }
      let sl: i32 = 0;
      while (sl < ins.args.len()) {
        let a: i32 = ins.args[sl];
        let rb: i32 = bi;
        if (ins.kind_tag == 8) {
          rb = 0 - 1;
          if (sl < blk.preds.len()) {
            rb = position_of(at, blk.preds[sl]);
          }
        }
        if (a >= 0 && a < f.nvals && rb >= 0) {
          w = w.with(a, w[a] + bw[rb]);
        }
        sl = sl + 1;
      }
    }
    let tv: i32 = 0 - 1;
    if (blk.term.kind_tag == 1) {
      tv = blk.term.value;
    }
    if (blk.term.kind_tag == 3) {
      tv = blk.term.cond;
    }
    if (tv >= 0 && tv < f.nvals) {
      w = w.with(tv, w[tv] + bw[bi]);
    }
    bi = bi + 1;
  }
  return w;
}

function kept_for_mate(wanted_by: i32[], reg_of: i32[], holder: i32, v: i32): boolean {
  let w: i32 = wanted_by[holder];
  return w >= 0 && w != v && reg_of[w] == 0 - 1;
}

function drop_last_i(a: i32[]): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < a.len() - 1) {
    out = out.append(a[i]);
    i = i + 1;
  }
  return out;
}

pub function spill_code(slot: i32): i32 {
  return 0 - 2 - slot;
}

pub function spill_slot(code: i32): i32 {
  return 0 - 2 - code;
}

pub function spill_count(reg_of: i32[]): i32 {
  let n: i32 = 0;
  for h in reg_of {
    if (h < 0 - 1 && spill_slot(h) + 1 > n) {
      n = spill_slot(h) + 1;
    }
  }
  return n;
}

function shares_operand_home(op: string): boolean {
  return int_binary(op);
}

function int_binary(op: string): boolean {
  let ops: string[] = ["add", "sub", "mul", "and", "and_not", "or", "xor", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u", "shl", "shr_s", "shr_u"];
  for o in ops {
    if (o == op) {
      return true;
    }
  }
  return false;
}

struct Mates { hint: i32[], carried: boolean[], alt: i32[], through: boolean[] }

function phi_mates(f: SFunc, at: i32[], def_pos: i32[], hi: i32[], no_home: boolean[]): Mates {
  let hint: i32[] = util.minus_ones(f.nvals);
  let carried: boolean[] = __alloc_bool(f.nvals);
  let alt: i32[] = hint;
  let fell: boolean[] = carried;
  let pos: i32 = 0;
  let bi: i32 = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 8 && ins.result >= 0 && ins.result < hint.len()) {
        let dying: i32 = 0 - 1;
        let outliving: i32 = 0 - 1;
        let through: i32 = 0 - 1;
        let ai: i32 = 0;
        while (ai < ins.args.len()) {
          let a: i32 = ins.args[ai];
          ai = ai + 1;
          if (a < 0 || a >= hint.len() || a < no_home.len() && no_home[a]) {
            continue;
          }
          if (def_pos[a] < pos) {
            if (hint[ins.result] < 0) {
              hint = hint.with(ins.result, a);
            }
            if (dying < 0 && hi[a] < pos) {
              dying = a;
            }
            if (hi[a] < pos && ai - 1 < blk.preds.len() && pred_index(at, blk.preds[ai - 1]) == bi - 1) {
              through = a;
            }
            if (outliving < 0 && hi[a] >= pos) {
              outliving = a;
            }
          } else if (hint[a] < 0) {
            hint = hint.with(a, ins.result);
            carried = carried.with(a, true);
          }
        }
        let h: i32 = hint[ins.result];
        if (dying >= 0 && !carried[ins.result] && h >= 0 && hi[h] >= pos) {
          hint = hint.with(ins.result, dying);
        }
        if (through >= 0 && !carried[ins.result]) {
          hint = hint.with(ins.result, through);
          fell = fell.with(ins.result, true);
        }
        if (!carried[ins.result]) {
          alt = alt.with(ins.result, outliving);
        }
      }
      pos = pos + 1;
    }
    pos = pos + 1;
    bi = bi + 1;
  }
  return Mates { hint: hint, carried: carried, alt: alt, through: fell };
}

function pred_index(at: i32[], id: i32): i32 {
  if (id < 0 || id >= at.len()) {
    return 0 - 1;
  }
  return at[id];
}

pub function position_count(f: SFunc): i32 {
  let n: i32 = 0;
  for blk in f.blocks {
    n = n + blk.insts.len() + 1;
  }
  return n;
}

pub function block_positions(f: SFunc): i32[] {
  let top: i32 = 0 - 1;
  for blk in f.blocks {
    if (blk.id > top) {
      top = blk.id;
    }
  }
  let out: i32[] = __alloc_i32(top + 1);
  let i: i32 = 0;
  while (i <= top) {
    out = out.with(i, 0 - 1);
    i = i + 1;
  }
  i = 0;
  while (i < f.blocks.len()) {
    let id: i32 = f.blocks[i].id;
    if (id >= 0 && out[id] < 0) {
      out = out.with(id, i);
    }
    i = i + 1;
  }
  return out;
}

pub function successor_id(t: STerm, which: i32): i32 {
  if (t.kind_tag == 2 && which == 0) {
    return t.target;
  }
  if (t.kind_tag == 3) {
    if (which == 0) {
      return t.t;
    }
    if (which == 1) {
      return t.f;
    }
  }
  return 0 - 1;
}

function distinct_successor_position(at: i32[], t: STerm, which: i32): i32 {
  let id: i32 = successor_id(t, which);
  if (id < 0 || which == 1 && id == t.t) {
    return 0 - 1;
  }
  return position_of(at, id);
}

function position_of(at: i32[], id: i32): i32 {
  if (id < 0 || id >= at.len()) {
    return 0 - 1;
  }
  return at[id];
}

pub function reads_value(ins: SInst, v: i32): boolean {
  for a in ins.args {
    if (a == v) {
      return true;
    }
  }
  return false;
}

pub function term_reads_value(t: STerm, v: i32): boolean {
  if (t.kind_tag == 1) {
    return t.value == v;
  }
  if (t.kind_tag == 3) {
    return t.cond == v;
  }
  return false;
}

function index_of_reg(a: i32[], x: i32): i32 {
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] == x) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function marked(marks: boolean[], v: i32): boolean {
  return v >= 0 && v < marks.len() && marks[v];
}

function unmarked_or_none(v: i32, marks: boolean[]): i32 {
  if (marked(marks, v)) {
    return 0 - 1;
  }
  return v;
}

function unmarked(vs: i32[], marks: boolean[]): i32[] {
  if (marks.len() == 0) {
    return vs;
  }
  let out: i32[] = [];
  for v in vs {
    if (!marked(marks, v)) {
      out = out.append(v);
    }
  }
  return out;
}

struct PairSlots { slot_end: i32[], holder: i32[], occupants: i32[][] }

function even_pair(t: PairSlots, p: i32, v: i32): PairSlots {
  if (p % 2 == 0) {
    return t;
  }
  return PairSlots { slot_end: t.slot_end.append(2147483647), holder: t.holder.append(v), occupants: t.occupants.append([v]) };
}

function take_pair(t: PairSlots, p: i32, end: i32, v: i32): PairSlots {
  let u: i32 = p;
  while (u <= p + 1) {
    if (u == t.slot_end.len()) {
      t = PairSlots { slot_end: t.slot_end.append(end), holder: t.holder.append(v), occupants: t.occupants.append([v]) };
    } else {
      t = PairSlots { slot_end: t.slot_end.with(u, end), holder: t.holder.with(u, v), occupants: t.occupants.with(u, [v]) };
    }
    u = u + 1;
  }
  return t;
}

function assign_spill_slots(f: SFunc, shape: SlotShape, lo: i32[], hi: i32[], reg_of: i32[], hints: SlotHints, given: ReadSites): i32[] {
  let def_pos: i32[] = shape.def_pos;
  let from: i32[] = spill_starts(lo, def_pos);
  let wanted_by: i32[] = mates_wanted(hi, reg_of, hints.hint);
  let lanes: boolean[] = lane_values(f);
  let slot_end: i32[] = [];
  let holder: i32[] = [];
  let occupants: i32[][] = [];
  let sites: ReadSites = given;
  let built: boolean = given.start.len() > 0;
  let live: SpillLive = no_spill_live();
  let pairs: i32[] = [];
  for v in order_by_lo(reg_of.len(), from) {
    if (hi[v] < 0 || reg_of[v] >= 0) {
      continue;
    }
    if (marked(lanes, v)) {
      let p: i32 = free_pair(slot_end, holder, wanted_by, reg_of, pairs, from[v], v);
      let t: PairSlots = even_pair(PairSlots { slot_end: slot_end, holder: holder, occupants: occupants }, p, v);
      p = p + t.slot_end.len() - slot_end.len();
      if (p == t.slot_end.len()) {
        pairs = pairs.append(p);
      }
      let pair: PairSlots = take_pair(t, p, hi[v], v);
      slot_end = pair.slot_end;
      holder = pair.holder;
      occupants = pair.occupants;
      reg_of = reg_of.with(v, spill_code(p));
      continue;
    }
    let ends: i32[] = closed_pairs(slot_end, pairs);
    let h: i32 = unmarked_or_none(hints.hint[v], lanes);
    let s: i32 = hinted_slot(ends, holder, reg_of, h, from[v], hints.take_over[v]);
    if (s < 0 && def_pos[v] >= 0) {
      let reads: i32[] = unmarked(slot_operands(f, shape, reg_of, v), lanes);
      if (h >= 0 && reg_of[h] < 0 - 1) {
        let mate_first: i32[] = [h];
        for r in reads {
          mate_first = mate_first.append(r);
        }
        reads = mate_first;
      }
      if (reads.len() > 0 && !built) {
        sites = read_sites(f, shape.at, shape.blk_start);
        built = true;
      }
      if (reads.len() > 0 && live.words == 0) {
        live = spill_live(sites, shape.def_blk, spilled_values(reg_of, hi), reg_of.len());
      }
      s = path_slot(sites, live, shape, reads, ends, holder, occupants, wanted_by, reg_of, hi, from[v], v);
    }
    if (s < 0) {
      s = free_slot(ends, holder, wanted_by, reg_of, from[v], v);
    }
    let end: i32 = hi[v];
    if (s < slot_end.len() && slot_end[s] > end) {
      end = slot_end[s];
    }
    if (s == slot_end.len()) {
      slot_end = slot_end.append(end);
      holder = holder.append(v);
      occupants = occupants.append([v]);
    } else {
      slot_end = slot_end.with(s, end);
      holder = holder.with(s, v);
      occupants = occupants.with(s, still_in(occupants[s], hi, from[v]).append(v));
    }
    reg_of = reg_of.with(v, spill_code(s));
  }
  return reg_of;
}

function spilled_values(reg_of: i32[], hi: i32[]): i32[] {
  let out: i32[] = [];
  let v: i32 = 0;
  while (v < reg_of.len()) {
    if (hi[v] >= 0 && reg_of[v] < 0) {
      out = out.append(v);
    }
    v = v + 1;
  }
  return out;
}

struct SlotShape { at: i32[], blk_start: i32[], def_blk: i32[], def_pos: i32[], def_a: i32[], def_b: i32[] }

function slot_operands(f: SFunc, shape: SlotShape, reg_of: i32[], v: i32): i32[] {
  let out: i32[] = [];
  let bi: i32 = shape.def_blk[v];
  let ins: SInst = f.blocks[bi].insts[shape.def_pos[v] - shape.blk_start[bi]];
  let cands: i32[] = [shape.def_a[v], shape.def_b[v]];
  if (ins.kind_tag == 8) {
    cands = ins.args;
  }
  for c in cands {
    if (c >= 0 && reg_of[c] < 0 - 1) {
      out = out.append(c);
    }
  }
  return out;
}

function path_slot(sites: ReadSites, live: SpillLive, shape: SlotShape, reads: i32[], slot_end: i32[], holder: i32[], occupants: i32[][], wanted_by: i32[], reg_of: i32[], hi: i32[], from: i32, v: i32): i32 {
  for c in reads {
    let cs: i32 = spill_slot(reg_of[c]);
    let ok: boolean = true;
    for w in occupants[cs] {
      if (ok && hi[w] >= from && (spill_live_at(live, sites, w, v, shape.def_blk, shape.def_pos) || shape.def_pos[w] >= 0 && spill_live_at(live, sites, v, w, shape.def_blk, shape.def_pos))) {
        ok = false;
      }
    }
    if (ok && (slot_end[cs] >= from || !kept_for_mate(wanted_by, reg_of, holder[cs], v))) {
      return cs;
    }
  }
  return 0 - 1;
}

function still_in(occ: i32[], hi: i32[], from: i32): i32[] {
  let out: i32[] = [];
  for w in occ {
    if (hi[w] >= from) {
      out = out.append(w);
    }
  }
  return out;
}

struct ReadSites { start: i32[], blk: i32[], pos: i32[], succ_a: i32[], succ_b: i32[], phi_end: i32[] }

function read_sites(f: SFunc, at: i32[], blk_start: i32[]): ReadSites {
  let count: i32[] = __alloc_i32(f.nvals + 1);
  let succ_a: i32[] = __alloc_i32(f.blocks.len());
  let succ_b: i32[] = __alloc_i32(f.blocks.len());
  let phi_end: i32[] = [];
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let t: STerm = f.blocks[bi].term;
    succ_a = succ_a.with(bi, distinct_successor_position(at, t, 0));
    succ_b = succ_b.with(bi, distinct_successor_position(at, t, 1));
    let end: i32 = 0;
    let k: i32 = 0;
    while (k < f.blocks[bi].insts.len()) {
      if (f.blocks[bi].insts[k].kind_tag == 8) {
        end = k + 1;
      }
      k = k + 1;
    }
    phi_end = phi_end.append(blk_start[bi] + end);
    bi = bi + 1;
  }
  let pass: i32 = 0;
  let start: i32[] = [];
  let blk: i32[] = [];
  let pos: i32[] = [];
  while (pass < 2) {
    let fill: i32[] = start;
    bi = 0;
    while (bi < f.blocks.len()) {
      let b: SBlock = f.blocks[bi];
      let k: i32 = 0;
      while (k < b.insts.len()) {
        let ins: SInst = b.insts[k];
        let sl: i32 = 0;
        while (sl < ins.args.len()) {
          let a: i32 = ins.args[sl];
          let rb: i32 = bi;
          let rp: i32 = blk_start[bi] + k;
          if (ins.kind_tag == 8) {
            rb = 0 - 1;
            if (sl < b.preds.len()) {
              rb = position_of(at, b.preds[sl]);
            }
            if (rb >= 0) {
              rp = blk_start[rb] + f.blocks[rb].insts.len();
            }
          }
          if (a >= 0 && a < f.nvals && rb >= 0) {
            if (pass == 0) {
              count = count.with(a + 1, count[a + 1] + 1);
            } else {
              blk = blk.with(fill[a], rb);
              pos = pos.with(fill[a], rp);
              fill = fill.with(a, fill[a] + 1);
            }
          }
          sl = sl + 1;
        }
        k = k + 1;
      }
      let tv: i32 = 0 - 1;
      if (b.term.kind_tag == 1) {
        tv = b.term.value;
      }
      if (b.term.kind_tag == 3) {
        tv = b.term.cond;
      }
      if (tv >= 0 && tv < f.nvals) {
        if (pass == 0) {
          count = count.with(tv + 1, count[tv + 1] + 1);
        } else {
          blk = blk.with(fill[tv], bi);
          pos = pos.with(fill[tv], blk_start[bi] + b.insts.len());
          fill = fill.with(tv, fill[tv] + 1);
        }
      }
      bi = bi + 1;
    }
    if (pass == 0) {
      let v: i32 = 1;
      while (v < count.len()) {
        count = count.with(v, count[v] + count[v - 1]);
        v = v + 1;
      }
      start = count;
      blk = __alloc_i32(count[f.nvals]);
      pos = __alloc_i32(count[f.nvals]);
    }
    pass = pass + 1;
  }
  return ReadSites { start: start, blk: blk, pos: pos, succ_a: succ_a, succ_b: succ_b, phi_end: phi_end };
}

function chain_dead_at_def(sites: ReadSites, holder: i32, a: i32, shared_with: i32[], lo: i32[], hi: i32[], def_blk: i32[], def_pos: i32[]): boolean {
  let m: i32 = holder;
  while (m >= 0) {
    if (hi[m] >= lo[a] && live_at_def(sites, m, a, def_blk, def_pos)) {
      return false;
    }
    m = shared_with[m];
  }
  return true;
}

function live_near(sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): i32 {
  let ab: i32 = def_blk[a];
  if (r < 0 || ab < 0) {
    return 1;
  }
  let rb: i32 = def_blk[r];
  if (rb == ab && def_pos[r] > def_pos[a] && def_pos[r] >= sites.phi_end[rb]) {
    return 0;
  }
  let first: i32 = sites.start[r];
  let last: i32 = sites.start[r + 1];
  let far: boolean = false;
  let elsewhere: boolean = false;
  let i: i32 = first;
  while (i < last) {
    if (sites.blk[i] == ab && sites.pos[i] > def_pos[a]) {
      return 1;
    }
    far = far || sites.blk[i] != ab || rb != ab;
    elsewhere = elsewhere || sites.blk[i] != rb;
    i = i + 1;
  }
  if (!far) {
    return 0;
  }
  if (!elsewhere && rb != ab) {
    return 0;
  }
  return 2;
}

function live_at_def(sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): boolean {
  let near: i32 = live_near(sites, r, a, def_blk, def_pos);
  if (near != 2) {
    return near == 1;
  }
  let ab: i32 = def_blk[a];
  let rb: i32 = def_blk[r];
  let first: i32 = sites.start[r];
  let last: i32 = sites.start[r + 1];
  let n: i32 = sites.succ_a.len();
  let walk: i32[] = __alloc_i32(3 * n);
  let i: i32 = first;
  while (i < last) {
    walk = walk.with(2 * n + sites.blk[i], 1);
    i = i + 1;
  }
  let top: i32 = 0;
  let b: i32 = ab;
  while (true) {
    let s: i32 = sites.succ_a[b];
    if (s >= 0 && s != rb && walk[n + s] == 0) {
      walk = walk.with(n + s, 1).with(top, s);
      top = top + 1;
    }
    s = sites.succ_b[b];
    if (s >= 0 && s != rb && walk[n + s] == 0) {
      walk = walk.with(n + s, 1).with(top, s);
      top = top + 1;
    }
    if (top == 0) {
      return false;
    }
    top = top - 1;
    b = walk[top];
    if (walk[2 * n + b] == 1) {
      return true;
    }
  }
}

struct SpillLive { index: i32[], words: i32, live_in: i64[] }

function no_spill_live(): SpillLive {
  return SpillLive { index: [], words: 0, live_in: [] };
}

function spill_live(sites: ReadSites, def_blk: i32[], values: i32[], nvals: i32): SpillLive {
  let n: i32 = sites.succ_a.len();
  let words: i32 = (values.len() + 63) / 64;
  let index: i32[] = util.minus_ones(nvals);
  let uses: i64[] = __alloc_i64(n * words);
  let kills: i64[] = __alloc_i64(n * words);
  let k: i32 = 0;
  for v in values {
    index = index.with(v, k);
    let rb: i32 = def_blk[v];
    if (rb >= 0) {
      kills = spill_bit(kills, rb * words, k);
    }
    let i: i32 = sites.start[v];
    while (i < sites.start[v + 1]) {
      if (sites.blk[i] != rb) {
        uses = spill_bit(uses, sites.blk[i] * words, k);
      }
      i = i + 1;
    }
    k = k + 1;
  }
  let live_in: i64[] = uses;
  let all: i64 = 0i64 - 1i64;
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let b: i32 = n - 1;
    while (b >= 0) {
      let w: i32 = 0;
      while (w < words) {
        let out: i64 = 0i64;
        if (sites.succ_a[b] >= 0) {
          out = out | live_in[sites.succ_a[b] * words + w];
        }
        if (sites.succ_b[b] >= 0) {
          out = out | live_in[sites.succ_b[b] * words + w];
        }
        let next: i64 = uses[b * words + w] | out & (kills[b * words + w] ^ all);
        if (next != live_in[b * words + w]) {
          live_in = live_in.with(b * words + w, next);
          changed = true;
        }
        w = w + 1;
      }
      b = b - 1;
    }
  }
  return SpillLive { index: index, words: words, live_in: live_in };
}

function spill_bit(own rows: i64[], base: i32, k: i32): i64[] {
  let w: i32 = base + k / 64;
  return rows.with(w, rows[w] | 1i64 << (k % 64) as i64);
}

function spill_live_at(live: SpillLive, sites: ReadSites, r: i32, a: i32, def_blk: i32[], def_pos: i32[]): boolean {
  let near: i32 = live_near(sites, r, a, def_blk, def_pos);
  if (near != 2) {
    return near == 1;
  }
  let k: i32 = 0 - 1;
  if (r < live.index.len()) {
    k = live.index[r];
  }
  if (k < 0) {
    return live_at_def(sites, r, a, def_blk, def_pos);
  }
  let ab: i32 = def_blk[a];
  for s in [sites.succ_a[ab], sites.succ_b[ab]] {
    if (s >= 0 && (live.live_in[s * live.words + k / 64] >> (k % 64) as i64 & 1i64) != 0i64) {
      return true;
    }
  }
  return false;
}

function spill_starts(lo: i32[], def_pos: i32[]): i32[] {
  let from: i32[] = __alloc_i32(lo.len());
  let i: i32 = 0;
  while (i < lo.len()) {
    if (def_pos[i] >= 0) {
      from = from.with(i, lo[i]);
    }
    i = i + 1;
  }
  return from;
}

function mates_wanted(hi: i32[], reg_of: i32[], hint: i32[]): i32[] {
  let wanted_by: i32[] = util.minus_ones(reg_of.len());
  let i: i32 = 0;
  while (i < reg_of.len()) {
    let m: i32 = hint[i];
    if (m >= 0 && hi[i] >= 0 && reg_of[i] == 0 - 1 && reg_of[m] == 0 - 1) {
      wanted_by = wanted_by.with(m, i);
    }
    i = i + 1;
  }
  return wanted_by;
}

function hinted_slot(slot_end: i32[], holder: i32[], reg_of: i32[], h: i32, from: i32, take_over: boolean): i32 {
  if (h < 0 || reg_of[h] >= 0 - 1) {
    return 0 - 1;
  }
  let hs: i32 = spill_slot(reg_of[h]);
  if (slot_end[hs] < from || take_over && holder[hs] == h) {
    return hs;
  }
  return 0 - 1;
}

function free_slot(slot_end: i32[], holder: i32[], wanted_by: i32[], reg_of: i32[], from: i32, v: i32): i32 {
  let s: i32 = 0;
  while (s < slot_end.len() && (slot_end[s] >= from || kept_for_mate(wanted_by, reg_of, holder[s], v))) {
    s = s + 1;
  }
  return s;
}

function free_pair(slot_end: i32[], holder: i32[], wanted_by: i32[], reg_of: i32[], pairs: i32[], from: i32, v: i32): i32 {
  for p in pairs {
    if (slot_free_at(slot_end, holder, wanted_by, reg_of, from, v, p) && slot_free_at(slot_end, holder, wanted_by, reg_of, from, v, p + 1)) {
      return p;
    }
  }
  return slot_end.len();
}

function closed_pairs(slot_end: i32[], pairs: i32[]): i32[] {
  for p in pairs {
    slot_end = slot_end.with(p, 2147483647).with(p + 1, 2147483647);
  }
  return slot_end;
}

function slot_free_at(slot_end: i32[], holder: i32[], wanted_by: i32[], reg_of: i32[], from: i32, v: i32, s: i32): boolean {
  return slot_end[s] < from && !kept_for_mate(wanted_by, reg_of, holder[s], v);
}

pub struct Imms { is_imm: boolean[], konst: boolean[], value: i64[], sym_at: i32[], syms: string[] }

pub function imm_sym(imm: Imms, v: i32): string {
  let k: i32 = imm.sym_at[v];
  return if (k > 0) { imm.syms[k - 1] } else { "" };
}

pub function with_sym(own imm: Imms, v: i32, sym: string): Imms {
  let syms: string[] = imm.syms.append(sym);
  return Imms { ...imm, is_imm: imm.is_imm.with(v, true), sym_at: imm.sym_at.with(v, syms.len()), syms: syms };
}

pub function imm_operands(f: SFunc, lo: i64, hi: i64, right: string[], left: string[]): Imms {
  let is_imm: boolean[] = __alloc_bool(f.nvals);
  let konst: boolean[] = __alloc_bool(f.nvals);
  let value: i64[] = __alloc_i64(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag != 1 && ins.kind_tag != 3) {
        continue;
      }
      konst = konst.with(ins.result, true);
      let c: i64 = ins.imm as i64;
      if (ins.kind_tag == 3) {
        c = util.lit_to_i64(ins.str);
      }
      value = value.with(ins.result, c);
      if (c < lo || c > hi) {
        continue;
      }
      is_imm = is_imm.with(ins.result, true);
    }
  }
  for blk in f.blocks {
    for ins in blk.insts {
      let a: i32 = 0;
      while (a < ins.args.len()) {
        let v: i32 = ins.args[a];
        if (v >= 0 && v < is_imm.len() && is_imm[v] && ins.kind_tag != 8 && !imm_use(ins, a, konst, value[v], right, left)) {
          is_imm = is_imm.with(v, false);
        }
        a = a + 1;
      }
    }
    let t: STerm = blk.term;
    if (t.kind_tag == 3 && t.cond >= 0 && t.cond < is_imm.len()) {
      is_imm = is_imm.with(t.cond, false);
    }
  }
  return Imms { is_imm: is_imm, konst: konst, value: value, sym_at: __alloc_i32(f.nvals), syms: [] };
}

function imm_use(ins: SInst, a: i32, konst: boolean[], c: i64, right: string[], left: string[]): boolean {
  if ((ins.kind_tag == 52 || ins.kind_tag == 53) && a == 1) {
    return c >= 0i64 && c <= 4095i64;
  }
  if ((ins.kind_tag == 54 || ins.kind_tag == 55) && a == 1) {
    return true;
  }
  if (ins.kind_tag >= 42 && ins.kind_tag <= 44 && a == 1) {
    return c >= 0i64 && c <= 4087i64;
  }
  if (ins.kind_tag != 9 || ins.args.len() != 2) {
    return false;
  }
  let other: i32 = ins.args[1 - a];
  if (other < 0 || other >= konst.len()) {
    return false;
  }
  if (a == 0 && konst[other]) {
    return false;
  }
  let names: string[] = left;
  if (a == 1) {
    names = right;
  }
  for n in names {
    if (n == ins.str) {
      return true;
    }
  }
  return false;
}

pub function literal_first_bytes(f: SFunc): i32[] {
  let out: i32[] = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 47 && ins.str.len() > 0) {
        out = out.with(ins.result, ins.str[0] as i32);
      }
    }
  }
  return out;
}

pub function use_counts(f: SFunc): i32[] {
  let uses: i32[] = __alloc_i32(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      for a in ins.args {
        if (a >= 0 && a < uses.len()) {
          uses = uses.with(a, uses[a] + 1);
        }
      }
    }
    let t: STerm = blk.term;
    if (t.kind_tag == 1 && t.value >= 0 && t.value < uses.len()) {
      uses = uses.with(t.value, uses[t.value] + 1);
    }
    if (t.kind_tag == 3 && t.cond >= 0 && t.cond < uses.len()) {
      uses = uses.with(t.cond, uses[t.cond] + 1);
    }
  }
  return uses;
}

function phi_sole_operand(ins: SInst, repl: i32[]): i32 {
  let only: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let a: i32 = resolve_repl(repl, ins.args[i]);
    if (a != ins.result) {
      if (only < 0) {
        only = a;
      } else if (only != a) {
        return 0 - 1;
      }
    }
    i = i + 1;
  }
  return only;
}

function resolve_repl(repl: i32[], v: i32): i32 {
  let seen: i32 = 0;
  while (v >= 0 && v < repl.len() && repl[v] != v && seen < 1000) {
    v = repl[v];
    seen = seen + 1;
  }
  return v;
}

function trivial_phi_repl(f: SFunc): i32[] {
  let repl: i32[] = __alloc_i32(f.nvals);
  let i: i32 = 0;
  while (i < f.nvals) {
    repl = repl.with(i, i);
    i = i + 1;
  }
  let rounds: i32 = 0;
  let changed: boolean = true;
  while (changed && rounds < 100) {
    changed = false;
    rounds = rounds + 1;
    for blk in f.blocks {
      for ins in blk.insts {
        if (ins.kind_tag != 8) {
          continue;
        }
        if (repl[ins.result] != ins.result) {
          continue;
        }
        let only: i32 = phi_sole_operand(ins, repl);
        if (only >= 0 && only != ins.result) {
          repl = repl.with(ins.result, only);
          changed = true;
        }
      }
    }
  }
  return repl;
}

pub struct Leaf { name: string, func: SFunc }

pub struct Leaves { list: Leaf[], ix: util.NameIndex }

pub function leaves_of(list: Leaf[]): Leaves {
  let names: string[] = [];
  for l in list {
    names = names.append(l.name);
  }
  return Leaves { list: list, ix: util.name_index(names) };
}

function leaf_limit(): i32 {
  return 12;
}

function leaf_kind(k: i32): boolean {
  return k == 1 || k == 2 || k == 3 || k == 6 || k == 7 || k == 9 || k == 10;
}

pub function leaf_of(name: string, f: SFunc): Leaf[] {
  if (f.takes_env || f.blocks.len() == 0) {
    return [];
  }
  let at: i32[] = block_positions(f);
  let insts: SInst[] = [];
  let bi: i32 = position_of(at, f.entry);
  let seen: i32 = 0;
  while (bi >= 0 && seen < f.blocks.len()) {
    let b: SBlock = f.blocks[bi];
    for ins in b.insts {
      insts = insts.append(ins);
    }
    seen = seen + 1;
    if (b.term.kind_tag == 1) {
      if (seen != f.blocks.len()) {
        return [];
      }
      return returning_leaf(name, f, insts, b.term);
    }
    if (b.term.kind_tag != 2) {
      return [];
    }
    bi = position_of(at, b.term.target);
  }
  return [];
}

function returning_leaf(name: string, f: SFunc, insts: SInst[], term: STerm): Leaf[] {
  if (term.value < 0) {
    return [];
  }
  let n: i32 = 0;
  for ins in insts {
    if (!leaf_kind(ins.kind_tag)) {
      return [];
    }
    if (ins.kind_tag != 6) {
      n = n + 1;
    }
  }
  if (n > leaf_limit()) {
    return [];
  }
  let one: SBlock = SBlock { id: f.entry, insts: insts, term: term, preds: [] };
  return [Leaf { name: name, func: SFunc { ...f, blocks: [one] } }];
}

pub function inline_leaves(f: SFunc, leaves: Leaves): SFunc {
  if (leaves.list.len() == 0) {
    return f;
  }
  let nvals: i32 = f.nvals;
  let blocks: SBlock[] = [];
  let copying: boolean = false;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let b: SBlock = f.blocks[bi];
    let insts: SInst[] = [];
    let spliced: boolean = false;
    let k: i32 = 0;
    while (k < b.insts.len()) {
      let ins: SInst = b.insts[k];
      let at: i32 = 0 - 1;
      if (ins.kind_tag == 11) {
        at = leaf_index(leaves, ins.str, ins.args.len());
      }
      if (at < 0) {
        if (spliced) {
          insts = insts.append(ins);
        }
        k = k + 1;
        continue;
      }
      if (!spliced) {
        insts = insts_before(b.insts, k);
        spliced = true;
      }
      let leaf: SFunc = leaves.list[at].func;
      let map: i32[] = util.minus_ones(leaf.nvals);
      for li in leaf.blocks[0].insts {
        if (li.kind_tag == 6) {
          map = map.with(li.result, ins.args[li.imm]);
        } else {
          map = map.with(li.result, nvals);
          let args: i32[] = [];
          for a in li.args {
            args = args.append(map[a]);
          }
          insts = insts.append(SInst { ...li, result: nvals, args: args });
          nvals = nvals + 1;
        }
      }
      if (ins.result >= 0) {
        insts = insts.append(SInst { kind_tag: 7, result: ins.result, args: [map[leaf.blocks[0].term.value]], imm: 0, str: "" });
      }
      k = k + 1;
    }
    if (spliced) {
      if (!copying) {
        blocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      blocks = blocks.append(SBlock { ...b, insts: insts });
    } else if (copying) {
      blocks = blocks.append(b);
    }
    bi = bi + 1;
  }
  if (!copying) {
    return f;
  }
  return SFunc { ...f, nvals: nvals, blocks: blocks };
}

pub function calls_leaf(f: SFunc, leaves: Leaves): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 11 && leaf_index(leaves, ins.str, ins.args.len()) >= 0) {
        return true;
      }
    }
  }
  return false;
}

function leaf_index(leaves: Leaves, name: string, argc: i32): i32 {
  let i: i32 = leaves.ix.chain(name);
  while (i >= 0) {
    if (leaves.list[i].func.nparams == argc && leaves.ix.names[i] == name) {
      return i;
    }
    i = leaves.ix.next[i];
  }
  return 0 - 1;
}

pub function prune_trivial_phis(f: SFunc): Formed {
  let repl: i32[] = trivial_phi_repl(f);
  let any: boolean = false;
  let i: i32 = 0;
  while (i < f.nvals) {
    if (repl[i] != i) {
      any = true;
    }
    i = i + 1;
  }
  if (!any) {
    return Formed { f: f, repl: [] };
  }
  let flat: i32[] = [];
  i = 0;
  while (i < f.nvals) {
    flat = flat.append(resolve_repl(repl, i));
    i = i + 1;
  }
  return Formed { f: rewrite_through(f, flat), repl: flat };
}

function rewrite_through(f: SFunc, flat: i32[]): SFunc {
  let nblocks: SBlock[] = [];
  let copying: boolean = false;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    let ninsts: SInst[] = [];
    let changed: boolean = false;
    let k: i32 = 0;
    while (k < blk.insts.len()) {
      let ins: SInst = blk.insts[k];
      let gone: boolean = ins.result >= 0 && flat[ins.result] != ins.result;
      let moved: boolean = !gone && args_move(ins, flat);
      if (!changed && (gone || moved)) {
        ninsts = insts_before(blk.insts, k);
        changed = true;
      }
      if (changed && !gone) {
        if (moved) {
          ninsts = ninsts.append(rewrite_args(ins, flat));
        } else {
          ninsts = ninsts.append(ins);
        }
      }
      k = k + 1;
    }
    let term: STerm = blk.term;
    if (term_moves(term, flat)) {
      term = rewrite_term(term, flat);
      if (!changed) {
        ninsts = blk.insts;
        changed = true;
      }
    }
    if (changed) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { ...blk, insts: ninsts, term: term });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
    bi = bi + 1;
  }
  if (!copying) {
    return f;
  }
  return SFunc { ...f, blocks: nblocks };
}

function merge_duplicates(f: SFunc): Formed {
  let canon: i32[] = identity_repl(f.nvals);
  let n: i32 = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag >= 1 && ins.kind_tag <= 3 || ins.kind_tag == 9 || ins.kind_tag == 10) {
        n = n + 1;
      }
    }
  }
  let nb: i32 = n * 2 + 1;
  let head: i32[] = util.minus_ones(nb);
  let seen: SInst[] = [];
  let seen_block: i32[] = [];
  let next: i32[] = [];
  let merged: i32[] = [];
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    for ins in f.blocks[bi].insts {
      let scope: i32 = 0 - 2;
      if (is_constant(ins, f.nvals)) {
        scope = 0 - 1;
      } else if (mergeable(ins)) {
        scope = bi;
      }
      if (scope >= 0 - 1) {
        let bk: i32 = (inst_hash(ins, canon) * 31 + (scope & 65535) & 1073741823) % nb;
        let found: i32 = 0 - 1;
        let j: i32 = head[bk];
        while (j >= 0 && found < 0) {
          if (seen_block[j] == scope && same_operation(seen[j], ins, canon)) {
            found = seen[j].result;
          }
          j = next[j];
        }
        if (found >= 0) {
          canon = canon.with(ins.result, found);
          if (scope >= 0) {
            merged = merged.append(ins.result).append(found);
          }
        } else {
          next = next.append(head[bk]);
          head = head.with(bk, seen.len());
          seen = seen.append(ins);
          seen_block = seen_block.append(scope);
        }
      }
    }
    bi = bi + 1;
  }
  if (merged.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  let repl: i32[] = identity_repl(f.nvals);
  let k: i32 = 0;
  while (k < merged.len()) {
    repl = repl.with(merged[k], merged[k + 1]);
    k = k + 2;
  }
  return Formed { f: rewrite_through(f, repl), repl: repl };
}

function identity_repl(n: i32): i32[] {
  let out: i32[] = __alloc_i32(n);
  let i: i32 = 0;
  while (i < n) {
    out = out.with(i, i);
    i = i + 1;
  }
  return out;
}

function is_constant(ins: SInst, nvals: i32): boolean {
  return ins.kind_tag >= 1 && ins.kind_tag <= 3 && ins.result >= 0 && ins.result < nvals;
}

function mergeable(ins: SInst): boolean {
  if (ins.result < 0) {
    return false;
  }
  if (ins.kind_tag == 9) {
    return !binary_fixes_abi(ins.str);
  }
  if (ins.kind_tag == 10) {
    return ins.str == "!" || ins.str == "u32_wrap" || ins.str == "int_wrap" || ins.str == "int_extend"
      || util.str_has_prefix(ins.str, "int_cast:") || util.str_has_prefix(ins.str, "rotr:");
  }
  return false;
}

function operand_id(a: i32, canon: i32[]): i32 {
  if (a < 0 || a >= canon.len()) {
    return a;
  }
  return canon[a];
}

function inst_hash(ins: SInst, canon: i32[]): i32 {
  let h: i32 = (ins.kind_tag * 31 + (ins.imm & 65535)) * 31 + (__str_hash(ins.str, 0) & 65535) & 1048575;
  for a in ins.args {
    h = h * 31 + (operand_id(a, canon) & 1048575) & 1048575;
  }
  return h;
}

function same_operation(a: SInst, b: SInst, canon: i32[]): boolean {
  if (a.kind_tag != b.kind_tag || a.imm != b.imm || a.args.len() != b.args.len() || a.str != b.str) {
    return false;
  }
  let k: i32 = 0;
  while (k < a.args.len()) {
    if (operand_id(a.args[k], canon) != operand_id(b.args[k], canon)) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

function args_move(ins: SInst, resolved: i32[]): boolean {
  for a in ins.args {
    if (a >= 0 && resolved[a] != a) {
      return true;
    }
  }
  return false;
}

function term_moves(t: STerm, resolved: i32[]): boolean {
  if (t.kind_tag == 1) {
    return resolved[t.value] != t.value;
  }
  if (t.kind_tag == 3) {
    return resolved[t.cond] != t.cond;
  }
  return false;
}

pub function repeated_block_id(f: SFunc): i32 {
  let top: i32 = 0;
  for blk in f.blocks {
    if (blk.id > top) {
      top = blk.id;
    }
  }
  let seen: i32[] = __alloc_i32(top + 1);
  for blk in f.blocks {
    if (seen[blk.id] == 1) {
      return blk.id;
    }
    seen = seen.with(blk.id, 1);
  }
  return 0 - 1;
}

pub function thread_forwarding(f: SFunc): Threading {
  let at: i32[] = block_positions(f);
  let nblocks: SBlock[] = [];
  let copying: boolean = false;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    let t: STerm = blk.term;
    let moved: boolean = false;
    if (t.kind_tag == 2) {
      let target: i32 = forwarded(f, at, t.target);
      if (target != t.target) {
        t = STerm { ...t, target: target };
        moved = true;
      }
    }
    if (t.kind_tag == 3) {
      let tt: i32 = forwarded(f, at, t.t);
      let tf: i32 = forwarded(f, at, t.f);
      if (tt != t.t || tf != t.f) {
        t = STerm { ...t, t: tt, f: tf };
        moved = true;
      }
    }
    if (moved) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { ...blk, term: t });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
    bi = bi + 1;
  }
  let g: SFunc = f;
  if (copying) {
    g = SFunc { ...f, blocks: nblocks };
  }
  let live: boolean[] = __alloc_bool(g.blocks.len());
  let work: i32[] = [position_of(at, g.entry)];
  let next: i32 = 0;
  while (next < work.len()) {
    let b: i32 = work[next];
    next = next + 1;
    if (b < 0 || live[b]) {
      continue;
    }
    live = live.with(b, true);
    let which: i32 = 0;
    while (which < 2) {
      let id: i32 = successor_id(g.blocks[b].term, which);
      if (id >= 0 && (which == 0 || id != g.blocks[b].term.t)) {
        work = work.append(position_of(at, id));
      }
      which = which + 1;
    }
  }
  let kept: SBlock[] = [];
  let dropping: boolean = false;
  let i: i32 = 0;
  while (i < g.blocks.len()) {
    if (!live[i]) {
      if (!dropping) {
        kept = blocks_before(g.blocks, i);
        dropping = true;
      }
    } else if (dropping) {
      kept = kept.append(g.blocks[i]);
    }
    i = i + 1;
  }
  let out: SFunc = g;
  if (dropping) {
    out = SFunc { ...g, blocks: kept };
  }
  return Threading { f: SFunc { ...out, blocks: refreshed_preds(out) }, changed: copying || dropping };
}

function forwarded(f: SFunc, at: i32[], id: i32): i32 {
  let cur: i32 = id;
  let steps: i32 = 0;
  while (steps <= f.blocks.len()) {
    if (cur < 0 || cur >= at.len() || at[cur] < 0) {
      return cur;
    }
    let b: SBlock = f.blocks[at[cur]];
    if (b.insts.len() != 0 || b.term.kind_tag != 2 || b.term.target == cur) {
      return cur;
    }
    let nt: i32 = b.term.target;
    if (nt < 0 || nt >= at.len() || at[nt] < 0 || has_phi(f.blocks[at[nt]])) {
      return cur;
    }
    cur = nt;
    steps = steps + 1;
  }
  return cur;
}

function has_phi(b: SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag == 8) {
      return true;
    }
  }
  return false;
}

pub function refreshed_preds(f: SFunc): SBlock[] {
  let at: i32[] = block_positions(f);
  let preds: i32[][] = [];
  let i: i32 = 0;
  while (i < f.blocks.len()) {
    preds = preds.append([]);
    i = i + 1;
  }
  i = 0;
  while (i < f.blocks.len()) {
    let which: i32 = 0;
    while (which < 2) {
      let s: i32 = distinct_successor_position(at, f.blocks[i].term, which);
      if (s >= 0 && !has_pred(preds[s], f.blocks[i].id)) {
        preds = preds.with(s, preds[s].append(f.blocks[i].id));
      }
      which = which + 1;
    }
    i = i + 1;
  }
  let out: SBlock[] = [];
  let copying: boolean = false;
  i = 0;
  while (i < f.blocks.len()) {
    let b: SBlock = f.blocks[i];
    let nb: SBlock = b;
    let fresh: boolean = false;
    if (has_phi(b)) {
      if (!every_pred(b.preds, preds[i])) {
        nb = trim_phi_edges(b, preds[i]);
        fresh = true;
      }
    } else if (!same_preds(b.preds, preds[i])) {
      nb = SBlock { ...b, preds: preds[i] };
      fresh = true;
    }
    if (fresh) {
      if (!copying) {
        out = blocks_before(f.blocks, i);
        copying = true;
      }
      out = out.append(nb);
    } else if (copying) {
      out = out.append(b);
    }
    i = i + 1;
  }
  if (!copying) {
    return f.blocks;
  }
  return out;
}

function every_pred(ps: i32[], edges: i32[]): boolean {
  for p in ps {
    if (!has_pred(edges, p)) {
      return false;
    }
  }
  return true;
}

function same_preds(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function trim_phi_edges(b: SBlock, edges: i32[]): SBlock {
  let keep: boolean[] = [];
  let npreds: i32[] = [];
  for p in b.preds {
    let k: boolean = has_pred(edges, p);
    keep = keep.append(k);
    if (k) {
      npreds = npreds.append(p);
    }
  }
  if (npreds.len() == b.preds.len()) {
    return b;
  }
  let ninsts: SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag != 8) {
      ninsts = ninsts.append(ins);
      continue;
    }
    let nargs: i32[] = [];
    let i: i32 = 0;
    while (i < ins.args.len()) {
      if (i >= keep.len() || keep[i]) {
        nargs = nargs.append(ins.args[i]);
      }
      i = i + 1;
    }
    ninsts = ninsts.append(SInst { ...ins, args: nargs });
  }
  return SBlock { id: b.id, insts: ninsts, term: b.term, preds: npreds };
}

function has_pred(ps: i32[], id: i32): boolean {
  for p in ps {
    if (p == id) {
      return true;
    }
  }
  return false;
}

struct BoolJoin { ok: boolean, j: i32, k: i32, t: i32, f: i32 }

pub struct Threading { f: SFunc, changed: boolean }

struct ThreadRound { blocks: SBlock[], busy: boolean[], gone: boolean[], changed: boolean }

pub function thread_bool_joins(f: SFunc): Threading {
  let g: SFunc = f;
  let changed: boolean = false;
  let rounds: i32 = 0;
  while (rounds < 8) {
    let r: Threading = thread_round(g);
    if (!r.changed) {
      return Threading { f: g, changed: changed };
    }
    g = r.f;
    changed = true;
    rounds = rounds + 1;
  }
  return Threading { f: g, changed: changed };
}

function thread_round(f: SFunc): Threading {
  let at: i32[] = block_positions(f);
  let uses: i32[] = use_counts(f);
  let konst: i32[] = truth_constants(f);
  let flags: boolean[] = __alloc_bool(f.blocks.len());
  let r: ThreadRound = ThreadRound { blocks: f.blocks, busy: flags, gone: flags, changed: false };
  let j: i32 = 0;
  while (j < f.blocks.len()) {
    let jn: BoolJoin = bool_join_at(f, at, uses, j);
    if (jn.ok && !join_busy(f, at, r.busy, jn)) {
      r = thread_join(f, at, konst, jn, r);
    }
    j = j + 1;
  }
  if (!r.changed) {
    return Threading { f: f, changed: false };
  }
  let kept: SBlock[] = [];
  let i: i32 = 0;
  while (i < r.blocks.len()) {
    if (!r.gone[i]) {
      kept = kept.append(r.blocks[i]);
    }
    i = i + 1;
  }
  let g: SFunc = SFunc { ...f, blocks: kept };
  return Threading { f: SFunc { ...g, blocks: refreshed_preds(g) }, changed: true };
}

function truth_constants(f: SFunc): i32[] {
  let out: i32[] = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if ((ins.kind_tag == 1 || ins.kind_tag == 2) && ins.result >= 0 && ins.result < out.len()) {
        let truth: i32 = 0;
        if (ins.imm != 0) {
          truth = 1;
        }
        out = out.with(ins.result, truth);
      }
    }
  }
  return out;
}

function bool_join_at(f: SFunc, at: i32[], uses: i32[], j: i32): BoolJoin {
  let blk: SBlock = f.blocks[j];
  let none: BoolJoin = BoolJoin { ok: false, j: j, k: 0 - 1, t: 0, f: 0 };
  if (blk.insts.len() != 1 || blk.insts[0].kind_tag != 8 || uses[blk.insts[0].result] != 1 || !entered_forward(f, at, j)) {
    return none;
  }
  let k: i32 = 0 - 1;
  let last: i32 = j;
  let br: STerm = blk.term;
  if (br.kind_tag == 2) {
    k = position_of(at, br.target);
    if (k <= j || !branch_only(f.blocks[k], blk.id)) {
      return none;
    }
    last = k;
    br = f.blocks[k].term;
  }
  if (br.kind_tag != 3 || br.cond != blk.insts[0].result || br.t == br.f
    || !plain_target(f, at, br.t, last) || !plain_target(f, at, br.f, last)) {
    return none;
  }
  return BoolJoin { ok: true, j: j, k: k, t: br.t, f: br.f };
}

function entered_forward(f: SFunc, at: i32[], j: i32): boolean {
  let blk: SBlock = f.blocks[j];
  if (blk.preds.len() == 0 || blk.insts[0].args.len() != blk.preds.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < blk.preds.len()) {
    let p: i32 = position_of(at, blk.preds[i]);
    if (p < 0 || p >= j || pred_slot(blk, blk.preds[i]) != i) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function branch_only(b: SBlock, from: i32): boolean {
  return b.insts.len() == 0 && b.term.kind_tag == 3 && b.preds.len() == 1 && b.preds[0] == from;
}

function plain_target(f: SFunc, at: i32[], id: i32, last: i32): boolean {
  let p: i32 = position_of(at, id);
  return p > last && !has_phi(f.blocks[p]);
}

function join_busy(f: SFunc, at: i32[], busy: boolean[], jn: BoolJoin): boolean {
  if (busy[jn.j] || jn.k >= 0 && busy[jn.k]) {
    return true;
  }
  for p in f.blocks[jn.j].preds {
    if (busy[at[p]]) {
      return true;
    }
  }
  return false;
}

function thread_join(f: SFunc, at: i32[], konst: i32[], jn: BoolJoin, r: ThreadRound): ThreadRound {
  let jb: SBlock = f.blocks[jn.j];
  let blocks: SBlock[] = r.blocks;
  let busy: boolean[] = r.busy.with(jn.j, true);
  let kept: i32 = 0;
  let i: i32 = 0;
  while (i < jb.preds.len()) {
    let pp: i32 = at[jb.preds[i]];
    if (blocks[pp].term.kind_tag == 2) {
      blocks = blocks.with(pp, SBlock { ...blocks[pp], term: arm_term(jb.insts[0].args[i], konst, jn) });
      busy = busy.with(pp, true);
    } else {
      kept = kept + 1;
    }
    i = i + 1;
  }
  let gone: boolean[] = r.gone;
  if (kept == 0) {
    gone = gone.with(jn.j, true);
    if (jn.k >= 0) {
      gone = gone.with(jn.k, true);
    }
  }
  return ThreadRound { blocks: blocks, busy: busy, gone: gone, changed: r.changed || kept < jb.preds.len() };
}

function arm_term(v: i32, konst: i32[], jn: BoolJoin): STerm {
  if (v >= 0 && v < konst.len() && konst[v] == 1) {
    return t_br(jn.t);
  }
  if (v >= 0 && v < konst.len() && konst[v] == 0) {
    return t_br(jn.f);
  }
  return t_brif(v, jn.t, jn.f);
}

struct Diamond { ok: boolean, head: i32, t: i32, f: i32, join: i32 }

pub function select_arm_limit(): i32 {
  return 3;
}

pub function select_branches(f: SFunc): SFunc {
  let g: SFunc = f;
  let rounds: i32 = 0;
  while (rounds < 8) {
    let r: Threading = select_round(g);
    if (!r.changed) {
      return g;
    }
    g = r.f;
    rounds = rounds + 1;
  }
  return g;
}

function select_round(f: SFunc): Threading {
  let at: i32[] = block_positions(f);
  let fl: boolean[] = float_values(f, [], false);
  let none: boolean[] = __alloc_bool(f.blocks.len());
  let r: Flattening = Flattening { blocks: f.blocks, busy: none, gone: none, nvals: f.nvals, changed: false };
  let p: i32 = 0;
  while (p < f.blocks.len()) {
    let d: Diamond = diamond_at(f, at, fl, p);
    if (d.ok && !diamond_busy(r.busy, d)) {
      r = flatten_diamond(f, d, r);
    }
    p = p + 1;
  }
  if (!r.changed) {
    return Threading { f: f, changed: false };
  }
  let kept: SBlock[] = [];
  let i: i32 = 0;
  while (i < r.blocks.len()) {
    if (!r.gone[i]) {
      kept = kept.append(r.blocks[i]);
    }
    i = i + 1;
  }
  return Threading { f: SFunc { ...f, nvals: r.nvals, blocks: kept }, changed: true };
}

struct Flattening { blocks: SBlock[], busy: boolean[], gone: boolean[], nvals: i32, changed: boolean }

function flatten_diamond(f: SFunc, d: Diamond, r: Flattening): Flattening {
  let head: SBlock = f.blocks[d.head];
  let insts: SInst[] = hoisted(head, util.append_all(arm_insts(f, d.t), arm_insts(f, d.f)));
  r = drop_arm(drop_arm(Flattening { ...r, busy: r.busy.with(d.head, true), changed: true }, d.t), d.f);
  if (d.join >= 0) {
    let j: SBlock = f.blocks[d.join];
    let picks: SInst[] = join_selects(j, head.term.cond, arm_source(f, head, d.t), arm_source(f, head, d.f));
    let blocks: SBlock[] = r.blocks.with(d.head, SBlock { ...head, insts: util.append_all(insts, picks), term: t_br(j.id) });
    return Flattening { ...r, blocks: blocks.with(d.join, SBlock { ...j, insts: without_phis(j.insts), preds: [head.id] }), busy: r.busy.with(d.join, true) };
  }
  let vt: i32 = f.blocks[d.t].term.value;
  let vf: i32 = f.blocks[d.f].term.value;
  if (vt == vf) {
    return Flattening { ...r, blocks: r.blocks.with(d.head, SBlock { ...head, insts: insts, term: t_ret(vt) }) };
  }
  let pick: SInst = SInst { kind_tag: 36, result: r.nvals, args: [head.term.cond, vt, vf], imm: 0, str: "" };
  return Flattening { ...r, blocks: r.blocks.with(d.head, SBlock { ...head, insts: insts.append(pick), term: t_ret(r.nvals) }), nvals: r.nvals + 1 };
}

function drop_arm(r: Flattening, arm: i32): Flattening {
  if (arm < 0) {
    return r;
  }
  return Flattening { ...r, busy: r.busy.with(arm, true), gone: r.gone.with(arm, true) };
}

function diamond_at(f: SFunc, at: i32[], fl: boolean[], p: i32): Diamond {
  let none: Diamond = Diamond { ok: false, head: p, t: 0 - 1, f: 0 - 1, join: 0 - 1 };
  let head: SBlock = f.blocks[p];
  let br: STerm = head.term;
  if (!two_way(head)) {
    return none;
  }
  let tp: i32 = position_of(at, br.t);
  let fp: i32 = position_of(at, br.f);
  if (tp < 0 || fp < 0) {
    return none;
  }
  let at_t: i32 = arm_at(f, tp, head.id);
  let at_f: i32 = arm_at(f, fp, head.id);
  if (!arms_fit(f, at_t, at_f)) {
    return none;
  }
  if (returns_picked(f, fl, at_t) && returns_picked(f, fl, at_f)) {
    return Diamond { ok: true, head: p, t: tp, f: fp, join: 0 - 1 };
  }
  let jp: i32 = join_of(f, at, p, tp, at_t, fp, at_f);
  if (jp < 0 || !select_join(f, fl, f.blocks[jp], arm_source(f, head, at_t), arm_source(f, head, at_f))) {
    return none;
  }
  return Diamond { ok: true, head: p, t: at_t, f: at_f, join: jp };
}

function arm_at(f: SFunc, p: i32, from: i32): i32 {
  if (select_arm(f.blocks[p], from)) {
    return p;
  }
  return 0 - 1;
}

function arms_fit(f: SFunc, at_t: i32, at_f: i32): boolean {
  if (at_t < 0 || at_f < 0) {
    return true;
  }
  return f.blocks[at_t].insts.len() + f.blocks[at_f].insts.len() <= select_arm_limit() + 1;
}

function returns_picked(f: SFunc, fl: boolean[], a: i32): boolean {
  if (a < 0) {
    return false;
  }
  let t: STerm = f.blocks[a].term;
  return t.kind_tag == 1 && t.value >= 0 && !picks_float(fl, t.value);
}

function join_of(f: SFunc, at: i32[], p: i32, tp: i32, at_t: i32, fp: i32, at_f: i32): i32 {
  if (at_t < 0 && at_f < 0) {
    return 0 - 1;
  }
  let jt: i32 = arm_exit(f, at, tp, at_t);
  let jf: i32 = arm_exit(f, at, fp, at_f);
  if (jt < 0 || jt != jf || jt == p) {
    return 0 - 1;
  }
  return jt;
}

function arm_exit(f: SFunc, at: i32[], p: i32, arm: i32): i32 {
  if (arm < 0) {
    return p;
  }
  let t: STerm = f.blocks[arm].term;
  if (t.kind_tag != 2) {
    return 0 - 1;
  }
  return position_of(at, t.target);
}

function two_way(head: SBlock): boolean {
  let br: STerm = head.term;
  return br.kind_tag == 3 && br.t != br.f && !tested_by_call(head, br.cond);
}

function tested_by_call(head: SBlock, cond: i32): boolean {
  for ins in head.insts {
    if (ins.result == cond && ins.kind_tag == 10 && ins.str == "!") {
      return tested_by_call(head, ins.args[0]);
    }
    if (ins.result == cond) {
      return inst_is_call(ins.kind_tag);
    }
  }
  return false;
}

function select_arm(b: SBlock, from: i32): boolean {
  if (b.preds.len() != 1 || b.preds[0] != from || b.insts.len() > select_arm_limit()) {
    return false;
  }
  if (b.term.kind_tag != 1 && b.term.kind_tag != 2) {
    return false;
  }
  for ins in b.insts {
    if (!speculable(ins)) {
      return false;
    }
  }
  return true;
}

function speculable(ins: SInst): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 1 || k == 2 || k == 3 || k == 7) {
    return true;
  }
  if (k == 9) {
    return int_binary(ins.str);
  }
  if (k == 10) {
    return int_unary(ins.str);
  }
  return false;
}

function int_unary(op: string): boolean {
  if (util.has_str(["!", "int_extend", "int_wrap", "u32_wrap"], op)) {
    return true;
  }
  for pre in ["int_cast:", "rotr:", "bswap:", "clz:", "ctz:", "popcount:"] {
    if (util.str_has_prefix(op, pre)) {
      return true;
    }
  }
  return false;
}

function select_join(f: SFunc, fl: boolean[], j: SBlock, from_t: i32, from_f: i32): boolean {
  if (j.preds.len() != 2 || !has_pred(j.preds, from_t) || !has_pred(j.preds, from_f)) {
    return false;
  }
  let phis: i32 = 0;
  for ins in j.insts {
    if (ins.kind_tag == 8) {
      if (ins.args.len() != 2 || picks_float(fl, ins.result)) {
        return false;
      }
      phis = phis + 1;
    }
  }
  return phis <= 2;
}

function picks_float(fl: boolean[], v: i32): boolean {
  return v >= 0 && v < fl.len() && fl[v];
}

function arm_source(f: SFunc, head: SBlock, arm: i32): i32 {
  if (arm < 0) {
    return head.id;
  }
  return f.blocks[arm].id;
}

function arm_insts(f: SFunc, arm: i32): SInst[] {
  if (arm < 0) {
    return [];
  }
  return f.blocks[arm].insts;
}

function diamond_busy(busy: boolean[], d: Diamond): boolean {
  return busy[d.head] || d.t >= 0 && busy[d.t] || d.f >= 0 && busy[d.f] || d.join >= 0 && busy[d.join];
}

function hoisted(head: SBlock, arms: SInst[]): SInst[] {
  let n: i32 = head.insts.len();
  if (n == 0 || head.insts[n - 1].result != head.term.cond || head.insts[n - 1].kind_tag == 8 || arms_read(arms, head.term.cond)) {
    return util.append_all(head.insts, arms);
  }
  let out: SInst[] = util.append_all(slice_insts(head.insts, 0, n - 1), arms);
  return out.append(head.insts[n - 1]);
}

function arms_read(arms: SInst[], v: i32): boolean {
  for ins in arms {
    if (reads_value(ins, v)) {
      return true;
    }
  }
  return false;
}

pub function select_run(blk: SBlock, ii: i32): i32[] {
  let c: i32 = blk.insts[ii].args[0];
  let lo: i32 = ii;
  while (lo > 0 && blk.insts[lo - 1].kind_tag == 36 && blk.insts[lo - 1].args[0] == c) {
    lo = lo - 1;
  }
  let hi: i32 = ii + 1;
  while (hi < blk.insts.len() && blk.insts[hi].kind_tag == 36 && blk.insts[hi].args[0] == c) {
    hi = hi + 1;
  }
  return [lo, hi];
}

function join_selects(j: SBlock, cond: i32, from_t: i32, from_f: i32): SInst[] {
  let picks: SInst[] = [];
  let copies: SInst[] = [];
  for ins in j.insts {
    if (ins.kind_tag == 8) {
      let vt: i32 = ins.args[pred_slot(j, from_t)];
      let vf: i32 = ins.args[pred_slot(j, from_f)];
      if (vt == vf) {
        copies = copies.append(SInst { kind_tag: 7, result: ins.result, args: [vt], imm: 0, str: "" });
      } else {
        picks = picks.append(SInst { kind_tag: 36, result: ins.result, args: [cond, vt, vf], imm: 0, str: "" });
      }
    }
  }
  return util.append_all(picks, copies);
}

function without_phis(insts: SInst[]): SInst[] {
  let out: SInst[] = [];
  for ins in insts {
    if (ins.kind_tag != 8) {
      out = out.append(ins);
    }
  }
  return out;
}

function slice_insts(a: SInst[], lo: i32, hi: i32): SInst[] {
  let out: SInst[] = [];
  let i: i32 = lo;
  while (i < hi) {
    out = out.append(a[i]);
    i = i + 1;
  }
  return out;
}

pub struct Formed { f: SFunc, repl: i32[] }

function formed_by(f: SFunc, repl: i32[]): Formed {
  let flat: i32[] = [];
  let i: i32 = 0;
  while (i < repl.len()) {
    flat = flat.append(resolve_repl(repl, i));
    i = i + 1;
  }
  return Formed { f: f, repl: flat };
}

function compose_repl(a: i32[], b: i32[]): i32[] {
  if (a.len() == 0) {
    return b;
  }
  if (b.len() == 0) {
    return a;
  }
  let out: i32[] = [];
  for v in a {
    if (v >= 0 && v < b.len()) {
      out = out.append(b[v]);
    } else {
      out = out.append(v);
    }
  }
  return out;
}

pub function register_form(f: SFunc): Formed {
  let folded: Formed = prune_trivial_phis(slot_calls(without_lines(f)));
  let merged: Formed = merge_duplicates(folded.f);
  let shared: Formed = share_shape_loads(merged.f);
  let unwrapped: Formed = drop_low_wraps(prune_dead(fuse_rotates(double_lanes(shared.f))));
  let g: SFunc = unwrapped.f;
  let bytes: Formed = fold_byte_access(g);
  if (bytes.repl.len() > 0) {
    g = prune_dead(bytes.f);
  }
  let t: Threading = thread_bool_joins(g);
  if (t.changed) {
    g = prune_dead(t.f);
  }
  let fw: Threading = thread_forwarding(g);
  g = fw.f;
  if (fw.changed) {
    g = prune_dead(g);
  }
  return Formed { f: g, repl: compose_repl(compose_repl(compose_repl(compose_repl(folded.repl, merged.repl), shared.repl), unwrapped.repl), bytes.repl) };
}

pub function double_lanes(f: SFunc): SFunc {
  let has_two: boolean = false;
  let has_multiply: boolean = false;
  for blk in f.blocks {
    for ins in blk.insts {
      has_two = has_two || ins.kind_tag == 4 && ins.str == "4611686018427387904";
      has_multiply = has_multiply || ins.kind_tag == 9 && (ins.str == "vmul" || ins.str == "fmul");
    }
  }
  if (!has_two || !has_multiply) {
    return f;
  }
  let two: boolean[] = __alloc_bool(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 4 && ins.str == "4611686018427387904") {
        two = two.with(ins.result, true);
      }
    }
  }
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 10 && ins.str == "vsplat" && two[ins.args[0]]) {
        two = two.with(ins.result, true);
      }
    }
  }
  let blocks: SBlock[] = [];
  for blk in f.blocks {
    let insts: SInst[] = [];
    for ins in blk.insts {
      if (ins.kind_tag == 9 && (ins.str == "vmul" || ins.str == "fmul") && (two[ins.args[0]] || two[ins.args[1]])) {
        let a: i32 = ins.args[0];
        if (two[a]) {
          a = ins.args[1];
        }
        let op: string = "vadd";
        if (ins.str == "fmul") {
          op = "fadd";
        }
        insts = insts.append(SInst { ...ins, str: op, args: [a, a] });
      } else {
        insts = insts.append(ins);
      }
    }
    blocks = blocks.append(SBlock { ...blk, insts: insts });
  }
  return SFunc { ...f, blocks: blocks };
}

function without_lines(f: SFunc): SFunc {
  if (!has_kind(f, 35)) {
    return f;
  }
  let blocks: SBlock[] = [];
  for b in f.blocks {
    let insts: SInst[] = [];
    for ins in b.insts {
      if (ins.kind_tag != 35) {
        insts = insts.append(ins);
      }
    }
    blocks = blocks.append(SBlock { ...b, insts: insts });
  }
  return SFunc { ...f, blocks: blocks };
}

pub function slot_call(ins: SInst): boolean {
  return ins.kind_tag == 56 && ins.str == "slot";
}

function slot_calls(f: SFunc): SFunc {
  if (!has_kind(f, 56)) {
    return f;
  }
  let env_of: i32[] = slot_reads(f);
  let uses: i32[] = use_counts(f);
  let dropped: boolean[] = __alloc_bool(f.nvals);
  let found: boolean = false;
  for blk in f.blocks {
    for ins in blk.insts {
      if (reads_own_slot(ins, env_of, uses)) {
        dropped = dropped.with(ins.args[0], true);
        found = true;
      }
    }
  }
  if (!found) {
    return f;
  }
  let out: SBlock[] = [];
  for blk in f.blocks {
    out = out.append(slot_block(blk, env_of, uses, dropped));
  }
  return SFunc { ...f, blocks: out };
}

pub function has_kind(f: SFunc, k: i32): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == k) {
        return true;
      }
    }
  }
  return false;
}

function slot_reads(f: SFunc): i32[] {
  let zero: boolean[] = __alloc_bool(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 1 && ins.imm == 0) {
        zero = zero.with(ins.result, true);
      }
    }
  }
  let env_of: i32[] = util.minus_ones(f.nvals);
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 42 && ins.imm == 1 && ins.str == "" && zero[ins.args[1]]) {
        env_of = env_of.with(ins.result, ins.args[0]);
      }
    }
  }
  return env_of;
}

function slot_block(blk: SBlock, env_of: i32[], uses: i32[], dropped: boolean[]): SBlock {
  let edit: boolean = false;
  for ins in blk.insts {
    edit = edit || reads_own_slot(ins, env_of, uses) || ins.kind_tag == 42 && dropped[ins.result];
  }
  if (!edit) {
    return blk;
  }
  let insts: SInst[] = [];
  for ins in blk.insts {
    if (reads_own_slot(ins, env_of, uses)) {
      insts = insts.append(SInst { ...ins, args: ins.args.with(0, ins.args[1]), str: "slot" });
    } else if (ins.kind_tag != 42 || !dropped[ins.result]) {
      insts = insts.append(ins);
    }
  }
  return SBlock { ...blk, insts: insts };
}

function reads_own_slot(ins: SInst, env_of: i32[], uses: i32[]): boolean {
  return ins.kind_tag == 56 && ins.args.len() > 1 && env_of[ins.args[0]] == ins.args[1] && uses[ins.args[0]] == 1;
}

function share_shape_loads(f: SFunc): Formed {
  let stored: boolean[] = __alloc_bool(f.nvals);
  let loads: i32 = 0;
  for blk in f.blocks {
    for ins in blk.insts {
      let k: i32 = ins.kind_tag;
      if (k == 16 || k == 53 || k == 55) {
        return Formed { f: f, repl: [] };
      }
      if ((k == 41 && ins.imm == 0 || k == 43) && ins.args.len() > 0 && ins.args[0] >= 0 && ins.args[0] < f.nvals) {
        stored = stored.with(ins.args[0], true);
      }
      if (shape_load(ins, f.nvals)) {
        loads = loads + 1;
      }
    }
  }
  if (loads < 2) {
    return Formed { f: f, repl: [] };
  }
  let at: i32[] = block_positions(f);
  let repl: i32[] = [];
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let insts: SInst[] = f.blocks[bi].insts;
    let k: i32 = 0;
    while (k < insts.len()) {
      let ins: SInst = insts[k];
      if (shape_load(ins, f.nvals) && !stored[ins.args[0]]) {
        let found: i32 = earlier_shape(f, at, bi, k, ins.args[0]);
        if (found >= 0) {
          if (repl.len() == 0) {
            repl = identity_repl(f.nvals);
          }
          repl = repl.with(ins.result, repl[found]);
        }
      }
      k = k + 1;
    }
    bi = bi + 1;
  }
  if (repl.len() == 0) {
    return Formed { f: f, repl: [] };
  }
  return Formed { f: rewrite_through(f, repl), repl: repl };
}

function earlier_shape(f: SFunc, at: i32[], bi: i32, k: i32, box: i32): i32 {
  let b: i32 = bi;
  let j: i32 = k - 1;
  while (true) {
    while (j >= 0) {
      let ins: SInst = f.blocks[b].insts[j];
      if (shape_load(ins, f.nvals) && ins.args[0] == box) {
        return ins.result;
      }
      if (may_write(ins.kind_tag)) {
        return 0 - 1;
      }
      j = j - 1;
    }
    if (f.blocks[b].preds.len() != 1) {
      return 0 - 1;
    }
    let pb: i32 = position_of(at, f.blocks[b].preds[0]);
    if (pb < 0 || pb >= b) {
      return 0 - 1;
    }
    b = pb;
    j = f.blocks[b].insts.len() - 1;
  }
}

function may_write(k: i32): boolean {
  return inst_has_effect(k) && k != 35 && k != 42 && k != 44;
}

function shape_load(ins: SInst, nvals: i32): boolean {
  return ins.kind_tag == 40 && ins.imm == 0 && ins.args.len() == 1 && ins.args[0] >= 0 && ins.args[0] < nvals && ins.result >= 0 && ins.result < nvals && ins.str == "";
}

pub function fold_byte_access(f: SFunc): Formed {
  if (!has_byte_access(f)) {
    return Formed { f: f, repl: [] };
  }
  let def_b: i32[] = __alloc_i32(f.nvals);
  let def_k: i32[] = __alloc_i32(f.nvals);
  let i: i32 = 0;
  while (i < f.nvals) {
    def_b = def_b.with(i, 0 - 1);
    def_k = def_k.with(i, 0 - 1);
    i = i + 1;
  }
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let k: i32 = 0;
    while (k < f.blocks[bi].insts.len()) {
      let r: i32 = f.blocks[bi].insts[k].result;
      if (r >= 0 && r < f.nvals) {
        def_b = def_b.with(r, bi);
        def_k = def_k.with(r, k);
      }
      k = k + 1;
    }
    bi = bi + 1;
  }
  let byte: boolean[] = __alloc_bool(f.nvals);
  let repl: i32[] = [];
  let uses: i32[] = use_counts(f);
  let changed: boolean = false;
  let nblocks: SBlock[] = [];
  for blk in f.blocks {
    let ninsts: SInst[] = [];
    for ins0 in blk.insts {
      let ins: SInst = ins0;
      if (repl.len() > 0) {
        let nargs: i32[] = [];
        for a in ins.args {
          nargs = nargs.append(resolve_repl(repl, a));
        }
        ins = SInst { ...ins, args: nargs };
      }
      let r: i32 = ins.result;
      if (r >= 0 && r < f.nvals && byte_extension(ins) && ins.args[0] >= 0 && ins.args[0] < f.nvals && byte[ins.args[0]]) {
        if (repl.len() == 0) {
          i = 0;
          while (i < f.nvals) {
            repl = repl.append(i);
            i = i + 1;
          }
        }
        repl = repl.with(r, ins.args[0]);
        byte = byte.with(r, true);
        changed = true;
        continue;
      }
      if (r >= 0 && r < f.nvals && byte_source(f, def_b, def_k, ins)) {
        byte = byte.with(r, true);
      }
      if ((ins.kind_tag == 54 || ins.kind_tag == 55) && const_zero(f, def_b, def_k, ins.args[1])) {
        let base: i32 = ins.args[0];
        let d: SInst = def_at(f, def_b, def_k, base);
        if (d.kind_tag == 9 && d.str == "add" && d.imm == 64 && d.args.len() == 2 && base >= 0 && base < uses.len() && uses[base] == 1) {
          let nargs: i32[] = [d.args[0], d.args[1]];
          if (ins.kind_tag == 55) {
            nargs = nargs.append(ins.args[2]);
          }
          ins = SInst { ...ins, args: nargs };
          changed = true;
        }
      }
      ninsts = ninsts.append(ins);
    }
    let t: STerm = blk.term;
    if (repl.len() > 0) {
      if (t.kind_tag == 1) {
        t = STerm { ...t, value: resolve_repl(repl, t.value) };
      } else if (t.kind_tag == 3) {
        t = STerm { ...t, cond: resolve_repl(repl, t.cond) };
      }
    }
    nblocks = nblocks.append(SBlock { ...blk, insts: ninsts, term: t });
  }
  if (!changed) {
    return Formed { f: f, repl: [] };
  }
  if (repl.len() == 0) {
    repl = identity_repl(f.nvals);
  }
  return formed_by(SFunc { ...f, blocks: nblocks }, repl);
}

function has_byte_access(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      let k: i32 = ins.kind_tag;
      if (k == 54 || k == 55 || k == 44 || k == 42 && ins.str == "u8" || k == 9 && ins.str == "and") {
        return true;
      }
    }
  }
  return false;
}

function byte_source(f: SFunc, def_b: i32[], def_k: i32[], ins: SInst): boolean {
  if (ins.kind_tag == 54) {
    return true;
  }
  if (ins.kind_tag == 42 || ins.kind_tag == 44) {
    return ins.imm != 2 && (ins.kind_tag == 44 || ins.str == "u8");
  }
  if (ins.kind_tag == 9 && ins.str == "and" && ins.args.len() == 2) {
    return const_in(f, def_b, def_k, ins.args[0], 0i64, 255i64) || const_in(f, def_b, def_k, ins.args[1], 0i64, 255i64);
  }
  return false;
}

function byte_extension(ins: SInst): boolean {
  if (ins.kind_tag != 10 || ins.args.len() != 1) {
    return false;
  }
  return ins.str == "int_wrap" || ins.str == "int_extend" || ins.str == "u32_wrap"
    || ins.str == "int_cast:u8" || ins.str == "int_cast:i32" || ins.str == "int_cast:u32";
}

function const_zero(f: SFunc, def_b: i32[], def_k: i32[], v: i32): boolean {
  return const_in(f, def_b, def_k, v, 0i64, 0i64);
}

function const_in(f: SFunc, def_b: i32[], def_k: i32[], v: i32, lo: i64, hi: i64): boolean {
  let d: SInst = def_at(f, def_b, def_k, v);
  if (d.kind_tag == 1) {
    return d.imm as i64 >= lo && d.imm as i64 <= hi;
  }
  if (d.kind_tag == 3) {
    let c: i64 = util.lit_to_i64(d.str);
    return c >= lo && c <= hi;
  }
  return false;
}

pub function drop_low_wraps(f: SFunc): Formed {
  if (!has_low_wrap(f)) {
    return Formed { f: f, repl: [] };
  }
  let prop: i32[] = __alloc_i32(f.nvals);
  let def_b: i32[] = __alloc_i32(f.nvals);
  let def_k: i32[] = __alloc_i32(f.nvals);
  let high: boolean[] = __alloc_bool(f.nvals);
  let i: i32 = 0;
  while (i < f.nvals) {
    def_b = def_b.with(i, 0 - 1);
    def_k = def_k.with(i, 0 - 1);
    i = i + 1;
  }
  let wraps: i32[] = [];
  let wrap_arg: i32[] = [];
  let work: i32[] = [];
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let insts: SInst[] = f.blocks[bi].insts;
    let k: i32 = 0;
    while (k < insts.len()) {
      let ins: SInst = insts[k];
      let r: i32 = ins.result;
      if (r >= 0 && r < f.nvals) {
        let n: i32 = high_operands(ins);
        if (n > 0) {
          prop = prop.with(r, n);
        }
        def_b = def_b.with(r, bi);
        def_k = def_k.with(r, k);
        if (low_wrap(ins)) {
          wraps = wraps.append(r);
          wrap_arg = wrap_arg.append(ins.args[0]);
        }
      }
      let ai: i32 = 0;
      while (ai < ins.args.len()) {
        let a: i32 = ins.args[ai];
        if (a >= 0 && a < f.nvals && !high[a] && !reads_low_half(ins, ai)) {
          high = high.with(a, true);
          work = work.append(a);
        }
        ai = ai + 1;
      }
      k = k + 1;
    }
    let tv: i32 = term_operand(f.blocks[bi].term);
    if (tv >= 0 && tv < f.nvals && !high[tv]) {
      high = high.with(tv, true);
      work = work.append(tv);
    }
    bi = bi + 1;
  }
  let wi: i32 = 0;
  while (wi < work.len()) {
    let v: i32 = work[wi];
    wi = wi + 1;
    if (prop[v] == 0) {
      continue;
    }
    let args: i32[] = f.blocks[def_b[v]].insts[def_k[v]].args;
    let ai: i32 = 0;
    while (ai < prop[v]) {
      let a: i32 = args[ai];
      if (a >= 0 && a < f.nvals && !high[a]) {
        high = high.with(a, true);
        work = work.append(a);
      }
      ai = ai + 1;
    }
  }
  let repl: i32[] = [];
  let dropped: boolean = false;
  let at: i32[] = block_positions(f);
  let wj: i32 = 0;
  while (wj < wraps.len()) {
    let w: i32 = wraps[wj];
    if (!high[w] || signed_wrap(def_at(f, def_b, def_k, w)) && counter_step(f, at, def_b, def_k, wrap_arg[wj])) {
      if (!dropped) {
        i = 0;
        while (i < f.nvals) {
          repl = repl.append(i);
          i = i + 1;
        }
        dropped = true;
      }
      repl = repl.with(w, wrap_arg[wj]);
    }
    wj = wj + 1;
  }
  if (!dropped) {
    return Formed { f: f, repl: [] };
  }
  let nblocks: SBlock[] = [];
  for blk in f.blocks {
    if (!block_reads_replaced(blk, repl)) {
      nblocks = nblocks.append(blk);
      continue;
    }
    let ninsts: SInst[] = [];
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals && repl[ins.result] != ins.result) {
        continue;
      }
      let nargs: i32[] = [];
      for a in ins.args {
        nargs = nargs.append(resolve_repl(repl, a));
      }
      ninsts = ninsts.append(SInst { ...ins, args: nargs });
    }
    let t: STerm = blk.term;
    if (t.kind_tag == 1) {
      t = STerm { ...t, value: resolve_repl(repl, t.value) };
    } else if (t.kind_tag == 3) {
      t = STerm { ...t, cond: resolve_repl(repl, t.cond) };
    }
    nblocks = nblocks.append(SBlock { ...blk, insts: ninsts, term: t });
  }
  return formed_by(SFunc { ...f, blocks: nblocks }, repl);
}

function has_low_wrap(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (low_wrap(ins)) {
        return true;
      }
    }
  }
  return false;
}

function block_reads_replaced(blk: SBlock, repl: i32[]): boolean {
  for ins in blk.insts {
    if (ins.result >= 0 && ins.result < repl.len() && repl[ins.result] != ins.result) {
      return true;
    }
    for a in ins.args {
      if (a >= 0 && a < repl.len() && repl[a] != a) {
        return true;
      }
    }
  }
  let tv: i32 = term_operand(blk.term);
  return tv >= 0 && tv < repl.len() && repl[tv] != tv;
}

function counter_step(f: SFunc, at: i32[], def_b: i32[], def_k: i32[], a: i32): boolean {
  let add: SInst = def_at(f, def_b, def_k, a);
  if (add.kind_tag != 9 || add.str != "add" || add.imm == 64 || add.args.len() != 2) {
    return false;
  }
  if (const_one(f, def_b, def_k, add.args[1])) {
    return tested_below(f, at, def_b, def_k, add.args[0], def_b[a]);
  }
  return const_one(f, def_b, def_k, add.args[0]) && tested_below(f, at, def_b, def_k, add.args[1], def_b[a]);
}

function tested_below(f: SFunc, at: i32[], def_b: i32[], def_k: i32[], v: i32, d: i32): boolean {
  if (def_at(f, def_b, def_k, v).kind_tag != 8) {
    return false;
  }
  let h: SBlock = f.blocks[def_b[v]];
  let t: STerm = h.term;
  if (t.kind_tag != 3 || t.t == t.f) {
    return false;
  }
  let c: SInst = def_at(f, def_b, def_k, t.cond);
  let below: i32 = 0 - 1;
  if (compares_below(c, v, "lt_s", "gt_s")) {
    below = t.t;
  } else if (compares_below(c, v, "ge_s", "le_s")) {
    below = t.f;
  }
  let b: i32 = position_of(at, below);
  if (b < 0 || f.blocks[b].preds.len() != 1 || f.blocks[b].preds[0] != h.id) {
    return false;
  }
  return dominates_position(f, at, b, d);
}

function dominates_position(f: SFunc, at: i32[], b: i32, d: i32): boolean {
  if (b == d) {
    return true;
  }
  let entry: i32 = position_of(at, f.entry);
  if (entry == b) {
    return true;
  }
  if (entry < 0 || d < 0) {
    return false;
  }
  let seen: boolean[] = __alloc_bool(f.blocks.len());
  seen = seen.with(d, true);
  let stack: i32[] = [d];
  let si: i32 = 0;
  while (si < stack.len()) {
    let cur: i32 = stack[si];
    si = si + 1;
    if (cur == entry) {
      return false;
    }
    for pid in f.blocks[cur].preds {
      let p: i32 = position_of(at, pid);
      if (p < 0) {
        return false;
      }
      if (p != b && !seen[p]) {
        seen = seen.with(p, true);
        stack = stack.append(p);
      }
    }
  }
  return true;
}

function compares_below(c: SInst, o: i32, first: string, second: string): boolean {
  if (c.kind_tag != 9 || c.imm == 64 || c.args.len() != 2) {
    return false;
  }
  return c.str == first && c.args[0] == o || c.str == second && c.args[1] == o;
}

function const_one(f: SFunc, def_b: i32[], def_k: i32[], v: i32): boolean {
  let d: SInst = def_at(f, def_b, def_k, v);
  return d.kind_tag == 1 && d.imm == 1;
}

function def_at(f: SFunc, def_b: i32[], def_k: i32[], v: i32): SInst {
  if (v < 0 || v >= def_b.len() || def_b[v] < 0) {
    return SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  }
  return f.blocks[def_b[v]].insts[def_k[v]];
}

function signed_wrap(ins: SInst): boolean {
  if (ins.kind_tag != 10 || ins.args.len() != 1 || ins.imm != 0) {
    return false;
  }
  return ins.str == "int_wrap" || ins.str == "int_extend" || ins.str == "int_cast:i32";
}

function low_wrap(ins: SInst): boolean {
  if (signed_wrap(ins)) {
    return true;
  }
  return ins.kind_tag == 10 && ins.args.len() == 1 && (ins.str == "u32_wrap" || ins.str == "int_cast:u32");
}

function low_half_binary(op: string): boolean {
  return op == "add" || op == "sub" || op == "mul" || op == "and" || op == "or" || op == "xor";
}

function reads_low_half(ins: SInst, k: i32): boolean {
  if (ins.kind_tag == 7 || ins.kind_tag == 8) {
    return true;
  }
  if (ins.kind_tag == 9) {
    if (low_half_binary(ins.str) || ins.str == "shl") {
      return true;
    }
    return k == 1 && (ins.str == "shr_s" || ins.str == "shr_u");
  }
  if (ins.kind_tag == 10) {
    if (util.str_has_prefix(ins.str, "rotr:")) {
      return rotr_width(ins.str) == 32;
    }
    if (ins.str == "bswap:32") {
      return true;
    }
    return ins.str == "int_wrap" || ins.str == "int_extend" || ins.str == "u32_wrap" || ins.str == "int_cast:i32" || ins.str == "int_cast:u32" || ins.str == "int_cast:u8";
  }
  return false;
}

function high_operands(d: SInst): i32 {
  if (d.kind_tag == 7 || d.kind_tag == 8 || d.kind_tag == 9 && low_half_binary(d.str)) {
    return d.args.len();
  }
  if (d.kind_tag == 9 && d.str == "shl") {
    return 1;
  }
  return 0;
}

function term_operand(t: STerm): i32 {
  if (t.kind_tag == 1) {
    return t.value;
  }
  if (t.kind_tag == 3) {
    return t.cond;
  }
  return 0 - 1;
}

pub function fuse_rotates(f: SFunc): SFunc {
  if (!has_or(f)) {
    return f;
  }
  let defs: SInst[] = inst_defs(f);
  return rewrite_insts(f, defs, rotate_of).f;
}

function rotate_of(defs: SInst[], ins: SInst): SInst {
  if (ins.kind_tag != 9 || ins.str != "or" || ins.args.len() != 2) {
    return no_inst();
  }
  let m: SInst = rotate_half_pair(defs, ins, ins.args[0], ins.args[1]);
  if (m.kind_tag == 0) {
    m = rotate_half_pair(defs, ins, ins.args[1], ins.args[0]);
  }
  return m;
}

function no_inst(): SInst {
  return SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
}

function inst_defs(f: SFunc): SInst[] {
  let defs: SInst[] = [];
  let i: i32 = 0;
  while (i < f.nvals) {
    defs = defs.append(no_inst());
    i = i + 1;
  }
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.result >= 0 && ins.result < f.nvals) {
        defs = defs.with(ins.result, ins);
      }
    }
  }
  return defs;
}

function rewrite_insts(f: SFunc, defs: SInst[], rewrite: (SInst[], SInst) => SInst): Threading {
  let nblocks: SBlock[] = [];
  let copying: boolean = false;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    let ninsts: SInst[] = [];
    let changed: boolean = false;
    let k: i32 = 0;
    while (k < blk.insts.len()) {
      let m: SInst = rewrite(defs, blk.insts[k]);
      if (m.kind_tag != 0 && !changed) {
        ninsts = insts_before(blk.insts, k);
        changed = true;
      }
      if (changed) {
        ninsts = ninsts.append(if (m.kind_tag != 0) { m } else { blk.insts[k] });
      }
      k = k + 1;
    }
    if (changed && !copying) {
      nblocks = blocks_before(f.blocks, bi);
      copying = true;
    }
    if (changed) {
      nblocks = nblocks.append(SBlock { ...blk, insts: ninsts });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
    bi = bi + 1;
  }
  if (!copying) {
    return Threading { f: f, changed: false };
  }
  return Threading { f: SFunc { ...f, blocks: nblocks }, changed: true };
}

function has_or(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 9 && ins.args.len() == 2 && ins.str == "or") {
        return true;
      }
    }
  }
  return false;
}

function rotate_half_pair(defs: SInst[], or: SInst, rv: i32, lv: i32): SInst {
  let no: SInst = no_inst();
  let rs: SInst = def_of(defs, rv);
  let ls: SInst = def_of(defs, lv);
  let w: i32 = 64;
  if (zero_extends_u32(ls)) {
    w = 32;
    ls = def_of(defs, ls.args[0]);
  }
  if (rs.kind_tag != 9 || rs.str != "shr_u" || ls.kind_tag != 9 || ls.str != "shl") {
    return no;
  }
  if (shift_width(rs.imm) != w || shift_width(ls.imm) != w) {
    return no;
  }
  if (copy_root(defs, rs.args[0]) != copy_root(defs, ls.args[0])) {
    return no;
  }
  let n: i64 = const_value(defs, rs.args[1]);
  let k: i64 = const_value(defs, ls.args[1]);
  if (n <= 0i64 || k <= 0i64 || n + k != w as i64) {
    return no;
  }
  return SInst { kind_tag: 10, result: or.result, args: [rs.args[0]], imm: 0, str: "rotr:" + util.i32_to_string(w) + ":" + util.i64_to_string(n) };
}

pub function fuse_and_not(f: SFunc): SFunc {
  if (!has_and_xor(f)) {
    return f;
  }
  let t: Threading = rewrite_insts(f, inst_defs(f), and_not_of);
  return if (t.changed) { prune_dead(t.f) } else { f };
}

function has_and_xor(f: SFunc): boolean {
  let has_and: boolean = false;
  let has_xor: boolean = false;
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 9) {
        if (ins.str == "and") {
          has_and = true;
        }
        if (ins.str == "xor") {
          has_xor = true;
        }
        if (has_and && has_xor) {
          return true;
        }
      }
    }
  }
  return false;
}

function and_not_of(defs: SInst[], ins: SInst): SInst {
  if (ins.kind_tag != 9 || ins.str != "and" || ins.args.len() != 2) {
    return no_inst();
  }
  let v: i32 = not_of(defs, ins.args[1]);
  if (v >= 0) {
    return SInst { ...ins, args: [ins.args[0], v], str: "and_not" };
  }
  v = not_of(defs, ins.args[0]);
  if (v >= 0) {
    return SInst { ...ins, args: [ins.args[1], v], str: "and_not" };
  }
  return no_inst();
}

pub function carry_triple(blk: SBlock, ii: i32, uses: i32[]): boolean {
  if (ii < 0 || ii + 2 >= blk.insts.len()) {
    return false;
  }
  let sum: SInst = blk.insts[ii];
  let c: SInst = blk.insts[ii + 1];
  let reader: SInst = blk.insts[ii + 2];
  if (c.kind_tag != 37 || c.args.len() != 2 || sum.kind_tag != 9 || reader.kind_tag != 9 || sum.args.len() != 2 || reader.args.len() != 2) {
    return false;
  }
  let sub: boolean = c.imm == 1;
  let op: string = if (sub) { "sub" } else { "add" };
  if (sum.str != op || reader.str != op || uses[c.result] != 1) {
    return false;
  }
  let same: boolean = sum.args[0] == c.args[0] && sum.args[1] == c.args[1];
  if (!sub && sum.args[0] == c.args[1] && sum.args[1] == c.args[0]) {
    same = true;
  }
  if (!same) {
    return false;
  }
  if (sub) {
    return reader.args[1] == c.result && reader.args[0] != c.result;
  }
  return reader.args[0] == c.result != (reader.args[1] == c.result);
}

pub function fuse_carries(f: SFunc): SFunc {
  if (!has_carry_shift(f)) {
    return f;
  }
  let defs: SInst[] = inst_defs(f);
  let t: Threading = rewrite_insts(f, defs, carry_of);
  if (!t.changed) {
    return f;
  }
  return prune_dead(t.f);
}

function has_carry_shift(f: SFunc): boolean {
  for blk in f.blocks {
    for ins in blk.insts {
      if (ins.kind_tag == 9 && ins.str == "shr_u" && ins.imm == 64) {
        return true;
      }
    }
  }
  return false;
}

function is_top_bit(defs: SInst[], ins: SInst): boolean {
  return ins.kind_tag == 9 && ins.str == "shr_u" && ins.imm == 64 && ins.args.len() == 2 && is_const(defs, ins.args[1], 63i64);
}

function is_const(defs: SInst[], v: i32, want: i64): boolean {
  let d: SInst = def_of(defs, copy_root(defs, v));
  if (d.kind_tag == 1) {
    return d.imm as i64 == want;
  }
  return d.kind_tag == 3 && util.lit_to_i64(d.str) == want;
}

function bin_of(defs: SInst[], v: i32, op: string): SInst {
  let d: SInst = def_of(defs, copy_root(defs, v));
  if (d.kind_tag == 9 && d.str == op && d.args.len() == 2) {
    return d;
  }
  return no_inst();
}

function wide_of(defs: SInst[], v: i32, op: string): SInst {
  let d: SInst = bin_of(defs, v, op);
  return if (d.imm == 64) { d } else { no_inst() };
}

function not_of(defs: SInst[], v: i32): i32 {
  let d: SInst = bin_of(defs, v, "xor");
  if (d.kind_tag == 0) {
    return 0 - 1;
  }
  if (is_const(defs, d.args[1], 0i64 - 1i64)) {
    return copy_root(defs, d.args[0]);
  }
  if (is_const(defs, d.args[0], 0i64 - 1i64)) {
    return copy_root(defs, d.args[1]);
  }
  return 0 - 1;
}

function same_pair(defs: SInst[], a: i32, b: i32, x: i32, y: i32): boolean {
  let ra: i32 = copy_root(defs, a);
  let rb: i32 = copy_root(defs, b);
  return ra == x && rb == y || ra == y && rb == x;
}

function zero_one(defs: SInst[], v: i32): boolean {
  let d: SInst = def_of(defs, copy_root(defs, v));
  if (d.kind_tag == 37 || is_top_bit(defs, d)) {
    return true;
  }
  return d.kind_tag == 9 && d.str == "and" && d.args.len() == 2 && (is_const(defs, d.args[0], 1i64) || is_const(defs, d.args[1], 1i64));
}

function carry_of(defs: SInst[], shr: SInst): SInst {
  if (!is_top_bit(defs, shr)) {
    return no_inst();
  }
  let o: SInst = bin_of(defs, shr.args[0], "or");
  if (o.kind_tag == 0) {
    return no_inst();
  }
  let m: SInst = carry_halves(defs, shr, o.args[0], o.args[1]);
  if (m.kind_tag == 0) {
    m = carry_halves(defs, shr, o.args[1], o.args[0]);
  }
  return m;
}

function carry_halves(defs: SInst[], shr: SInst, p: i32, q: i32): SInst {
  let pa: SInst = bin_of(defs, p, "and");
  let qa: SInst = bin_of(defs, q, "and");
  if (pa.kind_tag == 0 || qa.kind_tag == 0) {
    return no_inst();
  }
  let k: i32 = 0;
  while (k < 2) {
    let m: SInst = add_carry(defs, shr, pa, qa.args[k], qa.args[1 - k]);
    if (m.kind_tag == 0) {
      m = sub_borrow(defs, shr, pa, qa.args[k], qa.args[1 - k]);
    }
    if (m.kind_tag != 0) {
      return m;
    }
    k = k + 1;
  }
  return no_inst();
}

function add_carry(defs: SInst[], shr: SInst, p: SInst, either: i32, inv: i32): SInst {
  let x: i32 = copy_root(defs, p.args[0]);
  let y: i32 = copy_root(defs, p.args[1]);
  let e: SInst = bin_of(defs, either, "or");
  if (e.kind_tag == 0 || !same_pair(defs, e.args[0], e.args[1], x, y)) {
    return no_inst();
  }
  let s: SInst = wide_of(defs, not_of(defs, inv), "add");
  if (s.kind_tag == 0) {
    return no_inst();
  }
  if (same_pair(defs, s.args[0], s.args[1], x, y)) {
    return SInst { kind_tag: 37, result: shr.result, args: [x, y], imm: 0, str: "" };
  }
  let k: i32 = 0;
  while (k < 2) {
    let inner: SInst = wide_of(defs, s.args[k], "add");
    if (inner.kind_tag != 0 && same_pair(defs, inner.args[0], inner.args[1], x, y) && zero_one(defs, s.args[1 - k])) {
      return SInst { kind_tag: 37, result: shr.result, args: [x, y, copy_root(defs, s.args[1 - k])], imm: 0, str: "" };
    }
    k = k + 1;
  }
  return no_inst();
}

function sub_borrow(defs: SInst[], shr: SInst, p: SInst, either: i32, diff: i32): SInst {
  let k: i32 = 0;
  while (k < 2) {
    let x: i32 = not_of(defs, p.args[k]);
    let y: i32 = copy_root(defs, p.args[1 - k]);
    if (x >= 0 && inverted_or(defs, either, x, y)) {
      return borrow_from(defs, shr, diff, x, y);
    }
    k = k + 1;
  }
  return no_inst();
}

function inverted_or(defs: SInst[], v: i32, x: i32, y: i32): boolean {
  let e: SInst = bin_of(defs, v, "or");
  if (e.kind_tag == 0) {
    return false;
  }
  return not_of(defs, e.args[0]) == x && copy_root(defs, e.args[1]) == y || not_of(defs, e.args[1]) == x && copy_root(defs, e.args[0]) == y;
}

function borrow_from(defs: SInst[], shr: SInst, diff: i32, x: i32, y: i32): SInst {
  let d: SInst = wide_of(defs, diff, "sub");
  if (d.kind_tag == 0) {
    return no_inst();
  }
  if (copy_root(defs, d.args[0]) == x && copy_root(defs, d.args[1]) == y) {
    return SInst { kind_tag: 37, result: shr.result, args: [x, y], imm: 1, str: "" };
  }
  let inner: SInst = wide_of(defs, d.args[0], "sub");
  if (inner.kind_tag != 0 && copy_root(defs, inner.args[0]) == x && copy_root(defs, inner.args[1]) == y && zero_one(defs, d.args[1])) {
    return SInst { kind_tag: 37, result: shr.result, args: [x, y, copy_root(defs, d.args[1])], imm: 1, str: "" };
  }
  return no_inst();
}

function zero_extends_u32(ins: SInst): boolean {
  if (ins.kind_tag != 10 || ins.args.len() != 1) {
    return false;
  }
  if (ins.str == "u32_wrap" || ins.str == "int_cast:u32") {
    return true;
  }
  return (ins.str == "int_wrap" || ins.str == "int_extend") && ins.imm == 1;
}

function def_of(defs: SInst[], v: i32): SInst {
  if (v < 0 || v >= defs.len()) {
    return SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  }
  return defs[v];
}

function shift_width(imm: i32): i32 {
  if (imm == 64) {
    return 64;
  }
  return 32;
}

function copy_root(defs: SInst[], v: i32): i32 {
  let r: i32 = v;
  let steps: i32 = 0;
  while (steps < defs.len()) {
    let d: SInst = def_of(defs, r);
    if (d.kind_tag != 7 || d.args.len() != 1) {
      return r;
    }
    r = d.args[0];
    steps = steps + 1;
  }
  return r;
}

function const_value(defs: SInst[], v: i32): i64 {
  let d: SInst = def_of(defs, copy_root(defs, v));
  if (d.kind_tag == 1) {
    return d.imm as i64;
  }
  if (d.kind_tag == 3) {
    return util.lit_to_i64(d.str);
  }
  return 0i64 - 1i64;
}

pub function rotr_width(what: string): i32 {
  if (util.str_has_prefix(what, "rotr:64:")) {
    return 64;
  }
  return 32;
}

pub function rotr_count(what: string): i32 {
  let n: i32 = 0;
  let i: i32 = 8;
  while (i < what.len()) {
    n = n * 10 + (what[i] as i32 - 48);
    i = i + 1;
  }
  return n;
}

pub function prune_dead(f: SFunc): SFunc {
  let live: i32[] = prune_mark(f, prune_roots(f));
  let nblocks: SBlock[] = [];
  let copying: boolean = false;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let blk: SBlock = f.blocks[bi];
    let ninsts: SInst[] = [];
    let pruned: boolean = false;
    let k: i32 = 0;
    while (k < blk.insts.len()) {
      let ins: SInst = blk.insts[k];
      let stays: boolean = inst_has_effect(ins.kind_tag) || live[ins.result] == 1;
      if (pruned) {
        if (stays) {
          ninsts = ninsts.append(ins);
        }
      } else if (!stays) {
        ninsts = insts_before(blk.insts, k);
        pruned = true;
      }
      k = k + 1;
    }
    if (pruned) {
      if (!copying) {
        nblocks = blocks_before(f.blocks, bi);
        copying = true;
      }
      nblocks = nblocks.append(SBlock { id: blk.id, insts: ninsts, term: blk.term, preds: blk.preds });
    } else if (copying) {
      nblocks = nblocks.append(blk);
    }
    bi = bi + 1;
  }
  if (!copying) {
    return f;
  }
  return SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: nblocks, entry: f.entry, takes_env: f.takes_env };
}

function insts_before(insts: SInst[], n: i32): SInst[] {
  let out: SInst[] = [];
  let j: i32 = 0;
  while (j < n) {
    out = out.append(insts[j]);
    j = j + 1;
  }
  return out;
}

function blocks_before(blocks: SBlock[], n: i32): SBlock[] {
  let out: SBlock[] = [];
  let j: i32 = 0;
  while (j < n) {
    out = out.append(blocks[j]);
    j = j + 1;
  }
  return out;
}

function inst_has_effect(k: i32): boolean {
  if (k < 19) {
    return k == 6 || k == 11 || k == 12 || k == 14 || k == 16 || k == 17;
  }
  return k != 36 && k != 40 && k != 45 && k != 46 && k != 47 && k != 52 && k != 54 && k != 57 && k != 58 && k != 61;
}

function prune_roots(f: SFunc): i32[] {
  let work: i32[] = [];
  for blk in f.blocks {
    for ins in blk.insts {
      if (inst_has_effect(ins.kind_tag)) {
        for a in ins.args {
          work = work.append(a);
        }
      }
    }
    if (blk.term.kind_tag == 1) {
      work = work.append(blk.term.value);
    }
    if (blk.term.kind_tag == 3) {
      work = work.append(blk.term.cond);
    }
  }
  return work;
}

function prune_mark(f: SFunc, work: i32[]): i32[] {
  let live: i32[] = __alloc_i32(f.nvals);
  let def_b: i32[] = __alloc_i32(f.nvals);
  let def_k: i32[] = __alloc_i32(f.nvals);
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let k: i32 = 0;
    while (k < f.blocks[bi].insts.len()) {
      let r: i32 = f.blocks[bi].insts[k].result;
      def_b = def_b.with(r, bi + 1);
      def_k = def_k.with(r, k);
      k = k + 1;
    }
    bi = bi + 1;
  }
  let at: i32 = 0;
  while (at < work.len()) {
    let v: i32 = work[at];
    at = at + 1;
    if (v < 0 || v >= f.nvals || live[v] == 1) {
      continue;
    }
    live = live.with(v, 1);
    if (def_b[v] == 0) {
      continue;
    }
    for a in f.blocks[def_b[v] - 1].insts[def_k[v]].args {
      work = work.append(a);
    }
  }
  return live;
}

pub function count_insts(f: SFunc): i32 {
  let n: i32 = 0;
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    n = n + f.blocks[bi].insts.len();
    bi = bi + 1;
  }
  return n;
}

pub function pred_slot(blk: SBlock, prev: i32): i32 {
  let i: i32 = 0;
  while (i < blk.preds.len()) {
    if (blk.preds[i] == prev) {
      return i;
    }
    i = i + 1;
  }
  return 0;
}

function eval_binary(op: string, l: i32, r: i32): i32 {
  if (op == "+") {
    return l + r;
  }
  if (op == "-") {
    return l - r;
  }
  if (op == "*") {
    return l * r;
  }
  if (op == "/") {
    return l / r;
  }
  if (op == "%") {
    return l % r;
  }
  if (op == "==") {
    if (l == r) {
      return 1;
    }
    return 0;
  }
  if (op == "!=") {
    if (l != r) {
      return 1;
    }
    return 0;
  }
  if (op == "<") {
    if (l < r) {
      return 1;
    }
    return 0;
  }
  if (op == "<=") {
    if (l <= r) {
      return 1;
    }
    return 0;
  }
  if (op == ">") {
    if (l > r) {
      return 1;
    }
    return 0;
  }
  if (op == ">=") {
    if (l >= r) {
      return 1;
    }
    return 0;
  }
  if (op == "&&") {
    if (l != 0 && r != 0) {
      return 1;
    }
    return 0;
  }
  if (op == "||") {
    if (l != 0 || r != 0) {
      return 1;
    }
    return 0;
  }
  if (op == "&") {
    return l & r;
  }
  if (op == "|") {
    return l | r;
  }
  if (op == "^") {
    return l ^ r;
  }
  if (op == "<<") {
    return l << r;
  }
  if (op == ">>") {
    return l >> r;
  }
  return 0;
}
