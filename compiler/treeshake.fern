import "./ast";
import "./astwalk";
import "./lexer";
import "./parser";
import "./util";
import "std/string";

function ts_op_method(op: string): string {
  let named = ast.operator_method(op);
  if (named != "") {
    return named;
  }
  if (op == "==" || op == "!=") {
    return "eq";
  }
  if (op == "<" || op == "<=" || op == ">" || op == ">=") {
    return "cmp";
  }
  return "";
}

// The root of an operator. Qualified by the type of its operand, or bare
// on an operand of unknown type, it reaches only the methods of its name
// with the shape of an operator. Bare, it also reaches the free functions
// of its name.
function ts_op_root(method: string): string {
  return "op " + method;
}

// `fd` can be the method of an operator: unary minus takes no argument, and
// each other operator takes one.
function ts_operator_shaped(fd: parser.FuncDecl): boolean {
  if (fd.receiver_type.len() == 0) {
    return true;
  }
  if (fd.name == "neg") {
    return fd.params.len() == 0;
  }
  return fd.params.len() == 1;
}

function ts_op_overloads(op: string): boolean {
  return ast.operator_method(op) != "";
}

function ts_qualified_root(tag: string, method: string): string {
  return canonical_tag(tag) + "|" + method;
}

pub function canonical_tag(tag: string): string {
  if (tag == "str") {
    return "string";
  }
  if (tag == "bool") {
    return "boolean";
  }
  return tag;
}

function ts_free_root(name: string): string {
  return ts_qualified_root("", name);
}

function ts_named_tag(tag: string): boolean {
  if (tag.len() == 0) {
    return false;
  }
  let i = 0;
  while (i < tag.len()) {
    if (!lexer.is_alphanumeric(tag[i] as i32) && tag[i] != b'_') {
      return false;
    }
    i += 1;
  }
  return true;
}

function ts_routed_map_roots(): string[] {
  return [
    "map_new_impl", "__map_put_impl", "__map_len_impl", "__map_has_impl", "__map_get_impl",
    "__map_get_or_impl", "__map_delete_impl", "__map_cow_inplace", "__map_i32_column",
    "__map_bool_column", "__map_drop_impl", "__map_string_column", "__map_box_column", "__map_key_of", "__map_lookup_val",
    "__map_drop_strcols_impl", "__map_drop_boxes_impl", "__map_u8_column", "__map_cell", "__map_cell_load",
    "__map_cell_free", "__map_get_cell_impl", "__map_get_cell_f64_impl", "__map_cell_column", "__map_cell_f64_column",
    "__map_put_keyed", "__map_has_keyed_impl", "__map_get_keyed_impl", "__map_get_or_keyed_impl",
    "__map_delete_keyed_impl", "__map_lookup_val_keyed", "__map_key_of_keyed", "__map_drop_keyed_impl",
    "__map_get_cell_keyed_impl", "__map_get_cell_f64_keyed_impl",
  ];
}

function ts_with_key_roots(mod: parser.Module, rs: util.NameIndex): util.NameIndex {
  let live = ts_live_type_names(mod, rs);
  for fd in mod.funcs {
    let base = util.base_type_name(fd.receiver_type);
    if (ts_key_method(fd) && ts_nominal(mod, base) && live.has(base)) {
      rs = ts_with_root(rs, ts_qualified_root(base, fd.name));
    }
  }
  return rs;
}

function ts_key_method(fd: parser.FuncDecl): boolean {
  return fd.impl_trait == "Eq" && fd.name == "eq" || fd.impl_trait == "Hash" && fd.name == "hash";
}

function ts_with_root(rs: util.NameIndex, root: string): util.NameIndex {
  if (rs.has(root)) {
    return rs;
  }
  return rs.added(root);
}

function ts_nominal(mod: parser.Module, t: string): boolean {
  for st in mod.structs {
    if (st.name == t || st.enum_owner == t) {
      return true;
    }
  }
  for e in mod.enums {
    if (e.name == t) {
      return true;
    }
  }
  return false;
}

function ts_name_of(e: ast.Expr, own acc: string[]): string[] {
  match (e) {
    ast.ExprBytes(_) => {
      return acc;
    },
    ast.ExprIdent(id) => {
      return acc.append(ts_free_root(id.name));
    },
    ast.ExprBinary(b) => {
      let m = ts_op_method(b.op);
      if (m.len() == 0) {
        return acc;
      }
      if (ts_op_overloads(b.op)) {
        let bt = ast.receiver_tag(b.left);
        if (bt.len() > 0) {
          return acc.append(ts_qualified_root(bt, ts_op_root(m)));
        }
      }
      return acc.append(ts_op_root(m));
    },
    ast.ExprUnary(u) => {
      if (u.op == "try_") {
        return acc.append("from");
      }
      if (u.op != "-") {
        return acc;
      }
      let ut = ast.receiver_tag(u.operand);
      if (ut.len() > 0) {
        return acc.append(ts_qualified_root(ut, ts_op_root("neg")));
      }
      return acc.append(ts_op_root("neg"));
    },
    ast.ExprCall(c) => {
      if let ast.ExprFieldAccess(fa) = c.callee {
        return ts_called_method(fa, c.args.len(), acc);
      }
      return acc;
    },
    ast.ExprNumber(_) => {
      return acc;
    },
    ast.ExprString(_) => {
      return acc;
    },
    ast.ExprBool(_) => {
      return acc;
    },
    ast.ExprFieldAccess(_) => {
      return acc;
    },
    ast.ExprArray(_) => {
      return acc;
    },
    ast.ExprTuple(_) => {
      return acc;
    },
    ast.ExprMapLit(_) => {
      return acc;
    },
    ast.ExprFString(_) => {
      return acc;
    },
    ast.ExprIndex(_) => {
      return acc;
    },
    ast.ExprSlice(_) => {
      return acc;
    },
    ast.ExprStructLit(_) => {
      return acc;
    },
    ast.ExprLambda(_) => {
      return acc;
    },
    ast.ExprUnknown(_) => {
      return acc;
    },
    ast.ExprZero(_) => {
      return acc;
    }
  }
}

// The roots of a call of the method `fa.field` with `arity` arguments. A
// method of that name reaches only methods with that many parameters. On a
// receiver of unknown type, `ts_call_root` also reaches free functions of
// that name.
function ts_called_method(fa: ast.ExprFieldAccess, arity: i32, own acc: string[]): string[] {
  let tag = ast.receiver_tag(fa.obj);
  let ft = util.base_type_name(tag);
  let m = ts_arity_root(fa.field, arity);
  if (ts_named_tag(ft) && !tag.ends_with("[]")) {
    return acc.append(ts_qualified_root(ft, m)).append(ts_any_root(m));
  }
  return acc.append(m).append(ts_call_root(fa.field));
}

// The root of a method `name` called with `arity` arguments.
function ts_arity_root(name: string, arity: i32): string {
  return name + "/" + util.i32_to_string(arity);
}

// The root of a free function `name` on an unresolved module receiver.
function ts_call_root(name: string): string {
  return "call " + name;
}

function ts_any_root(method: string): string {
  return ts_qualified_root("*", method);
}

function ts_widened(names: string[], open: util.NameIndex, fd: parser.FuncDecl): string[] {
  let out = names;
  for n in names {
    let bar = util.index_of_sub(n, "|");
    if (bar > 0) {
      let tag = slice_unchecked(n, 0, bar).to_owned();
      if (open.has(tag) || util.has_str(fd.type_params, tag) || util.has_str(fd.all_type_params, tag) || tag.starts_with("impl ")) {
        out = out.append(slice_unchecked(n, bar + 1, n.len()).to_owned());
      }
    }
  }
  return out;
}

function ts_open_tags(mod: parser.Module): util.NameIndex {
  let names: string[] = [];
  for fd in mod.funcs {
    names = util.append_all(names, fd.type_params);
  }
  for sd in mod.structs {
    names = util.append_all(names, sd.type_params);
  }
  for ed in mod.enums {
    names = util.append_all(names, ed.type_params);
  }
  for al in mod.aliases {
    names = names.append(al.name);
  }
  for td in mod.trait_decls {
    names = names.append(td.name);
  }
  return util.name_index(names);
}

function ts_names_stmt(st: ast.Stmt, own acc: string[]): string[] {
  return astwalk.fold_stmt(st, acc, ts_name_of);
}

function ts_func_names(fd: parser.FuncDecl, acc: string[]): string[] {
  let lt = local_types(fd);
  function name_of(e: ast.Expr, own names: string[]): string[] {
    if let ast.ExprCall(c) = e {
      if let ast.ExprFieldAccess(fa) = c.callee {
        return typed_method_name_of(fa, c.args.len(), lt, names);
      }
      // Drivers may prune before the checker rewrites display arguments.
      // Keep the same receiver-qualified method that rewrite will call.
      if let ast.ExprIdent(id) = c.callee {
        if (id.name == "print" || id.name == "write" || id.name == "eprint") {
          for arg in c.args {
            let display = ast.ExprFieldAccess { obj: arg, field: "to_string", line: c.line, col: c.col, ty: "", const_read: false };
            names = typed_method_name_of(display, 0, lt, names);
          }
        }
      }
    }
    return ts_name_of(e, names);
  }
  if (fd.name == "inner" && util.base_type_name(fd.receiver_type) == "ndarray__NdArray") {
    acc = acc.append("ndarray__inner_kernel");
  }
  let i = 0;
  while (i < fd.body.len()) {
    acc = astwalk.fold_stmt(fd.body[i], acc, name_of);
    i += 1;
  }
  return acc;
}

function ts_interposed_method_name(name: string): string {
  let last_dot: i32 = -1;
  let i = 0;
  while (i < name.len()) {
    if (name[i] == b'.') {
      last_dot = i;
    }
    i += 1;
  }
  if (last_dot < 0) {
    return "";
  }
  return slice_unchecked(name, last_dot + 1, name.len()).to_owned();
}

function ts_recv_keys(fd: parser.FuncDecl): string[] {
  if (fd.receiver_type.len() == 0) {
    return [];
  }
  let base = util.base_type_name(fd.receiver_type);
  if (base.len() == 0) {
    return [];
  }
  let name = fd.name;
  let im = ts_interposed_method_name(fd.name);
  if (im.len() > 0) {
    name = im;
  }
  let keys = ts_recv_keys_as(fd, base, ts_arity_root(name, fd.params.len()));
  if (name != fd.name) {
    keys = util.append_all(keys, ts_recv_keys_as(fd, base, ts_arity_root(fd.name, fd.params.len())));
  }
  if (util.has_str(fd.type_params, base)) {
    keys = keys.append(ts_any_root(name));
    if (name != fd.name) {
      keys = keys.append(ts_any_root(fd.name));
    }
    return keys;
  }
  if (ts_operator_shaped(fd)) {
    keys = keys.append(ts_qualified_root(base, ts_op_root(fd.name)));
    if (fd.impl_trait.len() > 0) {
      keys = keys.append(ts_qualified_root(ts_impl_tag(fd.impl_trait), ts_op_root(fd.name)));
    }
  }
  if (fd.impl_trait.len() > 0) {
    keys = keys.append(ts_qualified_root(ts_impl_tag(fd.impl_trait), name));
    if (name != fd.name) {
      keys = keys.append(ts_qualified_root(ts_impl_tag(fd.impl_trait), fd.name));
    }
  }
  keys = keys.append(ts_qualified_root(base, name));
  if (name != fd.name) {
    keys = keys.append(ts_qualified_root(base, fd.name));
  }
  return keys;
}

// `fd` is kept by the root of a call by the name `called`, on a type
// parameter, on the receiver type `base`, or on the trait it implements.
function ts_recv_keys_as(fd: parser.FuncDecl, base: string, called: string): string[] {
  if (util.has_str(fd.type_params, base)) {
    return [ts_any_root(called)];
  }
  if (fd.impl_trait.len() > 0) {
    return [ts_qualified_root(ts_impl_tag(fd.impl_trait), called), ts_qualified_root(base, called)];
  }
  return [ts_qualified_root(base, called)];
}

pub struct BodyRefs { any: util.NameIndex, methods: util.NameIndex }

pub function body_refs(fd: parser.FuncDecl): BodyRefs {
  let lt = local_types(fd);
  function method_of(e: ast.Expr, own acc: string[]): string[] {
    return method_name_of(e, lt, acc);
  }
  let methods: string[] = [];
  let bare: string[] = [];
  let i = 0;
  while (i < fd.body.len()) {
    methods = astwalk.fold_stmt(fd.body[i], methods, method_of);
    bare = astwalk.fold_stmt(fd.body[i], bare, ts_method_name_of);
    i += 1;
  }
  let bound: string[] = [];
  if (fd.receiver_name.len() > 0) {
    bound = bound.append(fd.receiver_name);
  }
  let pi = 0;
  while (pi < fd.params.len()) {
    bound = bound.append(fd.params[pi].name);
    pi += 1;
  }
  let any: string[] = [];
  any = util.append_all(any, methods);
  any = util.append_all(any, bare);
  let free = astwalk.collect_free_idents(bound, fd.body, []);
  let fi = 0;
  while (fi < free.len()) {
    any = any.append(ts_free_root(free[fi]));
    fi += 1;
  }
  return BodyRefs { any: util.name_index(any), methods: util.name_index(methods) };
}

struct LocalTypes { names: string[], types: string[] }

function lt_bind(own lt: LocalTypes, name: string, ty0: string): LocalTypes {
  // A generic `Vec[N, T]` is a lane type the instance picks, so its methods
  // keep the bare method root.
  let ty = ty0;
  if (ty.starts_with("Vec[") && ty.ends_with("]")) {
    ty = "";
  }
  let k = util.index_of_str(lt.names, name);
  if (k < 0) {
    return LocalTypes { names: lt.names.append(name), types: lt.types.append(ty) };
  }
  if (lt.types[k] == ty) {
    return lt;
  }
  return LocalTypes { names: lt.names, types: lt.types.with(k, "") };
}

function lt_stmt(st: ast.Stmt, own lt: LocalTypes): LocalTypes {
  match (st) {
    ast.StmtVar(v) => {
      if (v.type_name.len() == 0) {
        if let ast.ExprStructLit(lit) = v.init {
          return lt_bind(lt, v.name, lit.type_name);
        }
      }
      return lt_bind(lt, v.name, v.type_name);
    },
    ast.StmtFor(f) => {
      return lt_bind(lt, f.var_name, "");
    },
    _ => {
      return lt;
    }
  }
}

function local_types(fd: parser.FuncDecl): LocalTypes {
  let lt = LocalTypes { names: [], types: [] };
  if (fd.receiver_name.len() > 0) {
    lt = lt_bind(lt, fd.receiver_name, fd.receiver_type);
  }
  let pi = 0;
  while (pi < fd.params.len()) {
    let ty = fd.params[pi].type_name;
    if (util.base_type_name(ty) == "Self") {
      ty = fd.receiver_type;
    }
    let tk = util.index_of_str(fd.type_params, util.base_type_name(ty));
    if (tk >= 0) {
      ty = "";
      if (tk < fd.bound_traits.len() && fd.bound_traits[tk].len() > 0) {
        ty = ts_bound_type(fd.bound_traits[tk]);
      }
    }
    lt = lt_bind(lt, fd.params[pi].name, ty);
    pi += 1;
  }
  let i = 0;
  while (i < fd.body.len()) {
    lt = astwalk.fold_stmt_spine(fd.body[i], lt, lt_stmt);
    i += 1;
  }
  return lt;
}

function ts_bound_type(bounds: string): string {
  return "impl " + bounds;
}

function ts_impl_tag(tr: string): string {
  return "impl " + parser.trait_simple_name(tr);
}

function body_recv_tag(e: ast.Expr, lt: LocalTypes): string {
  if let ast.ExprString(_) = e {
    return "string";
  }
  if let ast.ExprArray(_) = e {
    return "[]";
  }
  if let ast.ExprIdent(id) = e {
    let k = util.index_of_str(lt.names, id.name);
    if (k >= 0 && lt.types[k].len() > 0) {
      return lt.types[k];
    }
  }
  return ast.receiver_tag(e);
}

function builtin_len(tag: string, field: string): boolean {
  return field == "len" && (tag == "string" || tag == "str" || tag.ends_with("[]") || tag.starts_with("["));
}

function method_name_of(e: ast.Expr, lt: LocalTypes, own acc: string[]): string[] {
  if let ast.ExprCall(c) = e {
    if let ast.ExprFieldAccess(fa) = c.callee {
      if (builtin_len(body_recv_tag(fa.obj, lt), fa.field)) {
        return acc;
      }
      acc = typed_method_name_of(fa, c.args.len(), lt, acc);
    }
    return acc;
  }
  return ts_method_name_of(e, acc);
}

function typed_method_name_of(fa: ast.ExprFieldAccess, arity: i32, lt: LocalTypes, own acc: string[]): string[] {
  let m = ts_arity_root(fa.field, arity);
  if let ast.ExprIdent(id) = fa.obj {
    let k = util.index_of_str(lt.names, id.name);
    if (k >= 0) {
      let spelled = lt.types[k];
      if (spelled.starts_with("impl ")) {
        for b in parser.split_plus_bounds(slice_unchecked(spelled, 5, spelled.len()).to_owned()) {
          acc = acc.append(ts_qualified_root(ts_impl_tag(b), m));
        }
        return acc;
      }
      let base = util.base_type_name(spelled);
      if (ts_named_tag(base) && !spelled.ends_with("[]")) {
        return acc.append(ts_qualified_root(base, m)).append(ts_any_root(m));
      }
    }
  }
  return ts_called_method(fa, arity, acc);
}

pub function free_names(br: BodyRefs): string[] {
  let out: string[] = [];
  let root = ts_free_root("");
  for n in br.any.names {
    if (n.starts_with(root)) {
      out = out.append(slice_unchecked(n, root.len(), n.len()).to_owned());
    }
  }
  return out;
}

pub function refs_name(br: BodyRefs, fd: parser.FuncDecl): boolean {
  if (fd.receiver_type.len() > 0) {
    if (ts_kept_name(fd, br.methods)) {
      return true;
    }
    if (br.methods.has(ts_qualified_root(util.base_type_name(fd.receiver_type), fd.name))) {
      return true;
    }
    if (fd.impl_trait.len() > 0 && br.methods.has(ts_qualified_root(ts_impl_tag(fd.impl_trait), fd.name))) {
      return true;
    }
    return ts_interposed_kept(fd, br.any);
  }
  if (br.any.has(ts_free_root(fd.name))) {
    return true;
  }
  return ts_interposed_kept(fd, br.any);
}

function ts_method_name_of(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprIdent(_) = e {
    return acc;
  }
  return ts_name_of(e, acc);
}

function ts_kept_name(fd: parser.FuncDecl, refs: util.NameIndex): boolean {
  return ts_any_held(refs, ts_kept_keys(fd));
}

function ts_any_held(refs: util.NameIndex, keys: string[]): boolean {
  for k in keys {
    if (refs.has(k)) {
      return true;
    }
  }
  return false;
}

// ts_kept_keys are the names whose presence in the root set keeps `fd`.
function ts_kept_keys(fd: parser.FuncDecl): string[] {
  let keys = [fd.name];
  if (ts_operator_shaped(fd)) {
    keys = keys.append(ts_op_root(fd.name));
  }
  if (fd.receiver_type.len() > 0) {
    keys = keys.append(ts_arity_root(fd.name, fd.params.len()));
  } else {
    keys = keys.append(ts_free_root(fd.name)).append(ts_call_root(fd.name));
  }
  // Primitive method syntax can dispatch to a private free runtime body.
  // Unknown generic receivers contribute the bare method root until bound.
  if (fd.receiver_type.len() == 0 && fd.name.starts_with("__primitive_") && fd.name.ends_with("_to_string")) {
    let owner = slice_unchecked(fd.name, 12, fd.name.len() - 10).to_owned();
    keys = keys.append(ts_arity_root("to_string", 0)).append(ts_qualified_root(owner, ts_arity_root("to_string", 0)));
  }
  return util.append_all(util.append_all(keys, ts_interposed_keys(fd)), ts_recv_keys(fd));
}

// `fd` has an interposed name, such as `P.B.scale` for the method `scale`
// of trait B on P, and a root keeps the method part of that name.
function ts_interposed_keys(fd: parser.FuncDecl): string[] {
  let im = ts_interposed_method_name(fd.name);
  if (im.len() == 0) {
    return [];
  }
  return [im, ts_call_root(im), ts_arity_root(im, fd.params.len())];
}

function ts_interposed_kept(fd: parser.FuncDecl, refs: util.NameIndex): boolean {
  return ts_any_held(refs, ts_interposed_keys(fd));
}

struct TsGrown { rs: util.NameIndex, pending: i32[] }

// A pending function becomes kept once one of its keys enters the set, so
// each key wakes the functions that wait on it.
function ts_grow(mod: parser.Module, rs0: util.NameIndex, pending0: i32[]): TsGrown {
  let open = ts_open_tags(mod);
  let rs = rs0;
  let woken = util.filled_i32(mod.funcs.len(), 0);
  let queue: i32[] = [];
  let keys: string[] = [];
  let waiters: i32[] = [];
  for fi in pending0 {
    let fk = ts_kept_keys(mod.funcs[fi]);
    if (ts_any_held(rs, fk)) {
      woken = woken.with(fi, 1);
      queue = queue.append(fi);
    } else {
      for k in fk {
        keys = keys.append(k);
        waiters = waiters.append(fi);
      }
    }
  }
  let waiting = util.name_index(keys);
  let qi = 0;
  while (qi < queue.len()) {
    let fd = mod.funcs[queue[qi]];
    qi += 1;
    for name in ts_widened(ts_func_names(fd, []), open, fd) {
      if (rs.has(name)) {
        continue;
      }
      rs = rs.added(name);
      let w = waiting.chain(name);
      while (w >= 0) {
        if (woken[waiters[w]] == 0 && keys[w] == name) {
          woken = woken.with(waiters[w], 1);
          queue = queue.append(waiters[w]);
        }
        w = waiting.next[w];
      }
    }
  }
  let pending: i32[] = [];
  for fi in pending0 {
    if (woken[fi] == 0) {
      pending = pending.append(fi);
    }
  }
  return TsGrown { rs: rs, pending: pending };
}

function ts_reaches_map(mod: parser.Module, rs: util.NameIndex): boolean {
  if (rs.has("map_new") || rs.has(ts_free_root("map_new"))
    || rs.has("__map_new_i32") || rs.has(ts_free_root("__map_new_i32"))) {
    return true;
  }
  for fd in mod.funcs {
    if (ts_kept_name(fd, rs) && ts_mentions_map(ts_named_types(fd))) {
      return true;
    }
  }
  let owners: string[] = [];
  for st in mod.structs {
    if (ts_holds_map(st)) {
      let key = st.name;
      if (st.enum_owner.len() > 0) {
        key = st.enum_owner;
      }
      if (util.index_of_str(owners, key) < 0) {
        owners = owners.append(key);
      }
    }
  }
  if (owners.len() == 0) {
    return false;
  }
  let live = ts_live_type_names(mod, rs);
  for o in owners {
    if (live.has(o)) {
      return true;
    }
  }
  return false;
}

function ts_live_type_names(mod: parser.Module, rs: util.NameIndex): util.NameIndex {
  let live = util.name_index([]);
  for fd in mod.funcs {
    if (ts_kept_name(fd, rs)) {
      for t in ts_named_types(fd) {
        live = ts_add_type_words(live, t);
      }
    }
  }
  for st in mod.structs {
    let owner = st.enum_owner;
    let key = st.name;
    if (owner.len() > 0) {
      key = owner;
    }
    let named: boolean = rs.has(st.name) || rs.has(ts_free_root(st.name))
      || rs.has(owner) || rs.has(ts_free_root(owner));
    if (named && !live.has(key)) {
      live = live.added(key);
    }
  }
  let grew = true;
  while (grew) {
    grew = false;
    for st in mod.structs {
      let key = st.name;
      if (st.enum_owner.len() > 0) {
        key = st.enum_owner;
      }
      if (!live.has(key)) {
        continue;
      }
      for fl in st.fields {
        let before = live.names.len();
        live = ts_add_type_words(live, fl.type_name);
        if (live.names.len() > before) {
          grew = true;
        }
      }
    }
  }
  return live;
}

function ts_add_type_words(names: util.NameIndex, t: string): util.NameIndex {
  let i = 0;
  while (i < t.len()) {
    if (!lexer.is_alphanumeric(t[i] as i32)) {
      i += 1;
      continue;
    }
    let j = i;
    while (j < t.len() && lexer.is_alphanumeric(t[j] as i32)) {
      j += 1;
    }
    let w = slice_unchecked(t, i, j).to_owned();
    if (!names.has(w)) {
      names = names.added(w);
    }
    i = j;
  }
  return names;
}

function ts_holds_map(st: parser.StructDecl): boolean {
  for fl in st.fields {
    if (util.contains(fl.type_name, "Map[")) {
      return true;
    }
  }
  return false;
}

function ts_mentions_map(types: string[]): boolean {
  for t in types {
    if (util.contains(t, "Map[")) {
      return true;
    }
  }
  return false;
}

function ts_named_types(fd: parser.FuncDecl): string[] {
  let types: string[] = [fd.ret_type, fd.receiver_type];
  for p in fd.params {
    types = types.append(p.type_name);
  }
  for st in fd.body {
    types = astwalk.fold_stmt(st, types, ts_expr_types);
  }
  return types;
}

function ts_expr_types(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprLambda(l) = e {
    acc = acc.append(l.ret_type);
    for p in l.params {
      acc = acc.append(p.type_name);
    }
  }
  if let ast.ExprStructLit(lit) = e {
    acc = acc.append(lit.type_name);
  }
  return acc;
}

pub function top_level_names(mod: parser.Module, own refs: string[]): string[] {
  for st in mod.top_stmts {
    refs = ts_names_stmt(st, refs);
  }
  return refs;
}

// main, each `@interrupt` handler, which the vector table calls, and the
// `@early` hook, which the reset entry calls.
pub function entry_roots(mod: parser.Module): string[] {
  let roots = ["main"];
  for m in mod.marks {
    if (m.attr == "interrupt" || m.attr == "early") {
      roots = roots.append(m.func_name);
    }
  }
  return roots;
}

pub function treeshake(mod: parser.Module): parser.Module {
  let roots = entry_roots(mod);
  return treeshake_roots(mod, roots);
}

pub function treeshake_roots(mod: parser.Module, own roots: string[]): parser.Module {
  let refs = top_level_names(mod, roots);
  let ei = 0;
  while (ei < mod.exports.len()) {
    refs = refs.append(mod.exports[ei].func_name);
    ei += 1;
  }

  let di = 0;
  while (di < mod.impls.len()) {
    if (mod.impls[di].trait_name == "Drop") {
      let dm = 0;
      while (dm < mod.impls[di].method_names.len()) {
        refs = refs.append(ts_qualified_root(ts_impl_tag("Drop"), mod.impls[di].method_names[dm]));
        dm += 1;
      }
    }
    di += 1;
  }

  let ai = 0;
  while (ai < mod.funcs.len()) {
    if (mod.funcs[ai].async && mod.funcs[ai].import_iface.len() == 0) {
      refs = refs.append(mod.funcs[ai].name);
    }
    ai += 1;
  }

  let pending: i32[] = [];
  let pi0 = 0;
  while (pi0 < mod.funcs.len()) {
    pending = pending.append(pi0);
    pi0 += 1;
  }

  let grown = ts_grow(mod, util.name_index(refs), pending);
  if (ts_reaches_map(mod, grown.rs)) {
    let rs0 = grown.rs;
    for root in ts_routed_map_roots() {
      rs0 = ts_with_root(rs0, root);
    }
    grown = ts_grow(mod, ts_with_key_roots(mod, rs0), grown.pending);
  }
  let rs = grown.rs;

  let kept: parser.FuncDecl[] = [];
  let ki = 0;
  while (ki < mod.funcs.len()) {
    if (ts_kept_name(mod.funcs[ki], rs)) {
      kept = kept.append(mod.funcs[ki]);
    }
    ki += 1;
  }
  return parser.Module { funcs: kept, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, marks: mod.marks, impls: mod.impls, trait_reqs: mod.trait_reqs, trait_decls: mod.trait_decls, substituted_consts: mod.substituted_consts, todo_sites: mod.todo_sites, sights: mod.sights };
}

pub function without_extern_callers(mod: parser.Module): parser.Module {
  let dropped: string[] = [];
  for f in mod.funcs {
    if (f.import_iface.len() > 0) {
      dropped = dropped.append(f.name);
    }
  }
  if (dropped.len() == 0) {
    return mod;
  }
  let grew = true;
  while (grew) {
    grew = false;
    for f in mod.funcs {
      if (f.import_iface.len() == 0 && !util.has_str(dropped, f.name) && calls_any(f, dropped)) {
        dropped = dropped.append(f.name);
        grew = true;
      }
    }
  }
  let kept: parser.FuncDecl[] = [];
  for f in mod.funcs {
    if (!util.has_str(dropped, f.name)) {
      kept = kept.append(f);
    }
  }
  return parser.Module { ...mod, funcs: kept };
}

function calls_any(f: parser.FuncDecl, names: string[]): boolean {
  let ids: string[] = [];
  for st in f.body {
    ids = astwalk.collect_idents_stmt(st, ids);
  }
  for id in ids {
    if (util.has_str(names, id)) {
      return true;
    }
  }
  return false;
}
