import "./ir";
import "./irverify";
import "./rcsigs";
import "./util";

pub struct RcResult {
  problems: irverify.Problem[],
  sites: i32,
  checked: i32,
  skips: string[],
}

pub function rc_result_new(): RcResult {
  let no_p: irverify.Problem[] = [];
  let no_s: string[] = [];
  return RcResult { problems: no_p, sites: 0, checked: 0, skips: no_s };
}

pub function rc_coverage_str(r: RcResult): string {
  let out: string = "reuse sites modelled " + util.i32_to_string(r.checked)
    + "/" + util.i32_to_string(r.sites);
  let seen: string[] = [];
  let count: i32[] = [];
  let i: i32 = 0;
  while (i < r.skips.len()) {
    let at: i32 = util.index_of_str(seen, r.skips[i]);
    if (at < 0) {
      seen = seen.append(r.skips[i]);
      count = count.append(1);
    } else {
      count = count.with(at, count[at] + 1);
    }
    i = i + 1;
  }
  let j: i32 = 0;
  while (j < seen.len()) {
    out = out + "\n    skipped " + util.i32_to_string(count[j]) + ": " + seen[j];
    j = j + 1;
  }
  return out;
}

function is_reuse_alloc(op: ir.Op, k_calld: i32): boolean {
  if (op.kind_tag != k_calld) {
    return false;
  }
  return op.str == "__fern_alloc_reuse" || op.str == "__alloc_reuse";
}

function is_call_named(op: ir.Op, name: string): boolean {
  return op.kind_tag == ir.K_CALL_DIRECT && op.str == name;
}

function is_is_unique(op: ir.Op): boolean {
  return is_call_named(op, "__fern_rc_is_unique");
}

function releases_operand(name: string): boolean {
  return rcsigs.releases_operand(name);
}

function is_rc_dec(op: ir.Op): boolean {
  if (op.kind_tag != ir.K_CALL_DIRECT) {
    return false;
  }
  return releases_operand(op.str);
}

function is_kind(op: ir.Op, name: string): boolean {
  return op.kind_tag == ir.kind_id(name);
}

struct IfSpan { ok: boolean, if_at: i32, else_at: i32, end_at: i32 }

function match_if_backwards(ops: ir.Op[], end_at: i32): IfSpan {
  let depth: i32 = 0;
  let else_at: i32 = 0 - 1;
  let i: i32 = end_at - 1;
  while (i >= 0) {
    let k: i32 = ops[i].kind_tag;
    if (k == ir.K_END) {
      depth = depth + 1;
    } else if (k == ir.K_BLOCK || k == ir.K_LOOP) {
      if (depth == 0) {
        return IfSpan { ok: false, if_at: 0, else_at: 0 - 1, end_at: end_at };
      }
      depth = depth - 1;
    } else if (k == ir.K_IF) {
      if (depth == 0) {
        return IfSpan { ok: true, if_at: i, else_at: else_at, end_at: end_at };
      }
      depth = depth - 1;
    } else if (k == ir.K_ELSE) {
      if (depth == 0) {
        else_at = i;
      }
    }
    i = i - 1;
  }
  return IfSpan { ok: false, if_at: 0, else_at: 0 - 1, end_at: end_at };
}

struct SlotFind { ok: boolean, slot: i32, at: i32 }

function scope_delta(op: ir.Op): i32 {
  if (is_kind(op, "block") || is_kind(op, "loop") || is_kind(op, "if")) {
    return 1;
  }
  if (is_kind(op, "end")) {
    return 0 - 1;
  }
  return 0;
}

function sole_token_source(ops: ir.Op[], from: i32, to: i32, token_slot: i32): SlotFind {
  let found: SlotFind = SlotFind { ok: false, slot: 0, at: 0 };
  let depth: i32 = 0;
  let i: i32 = from;
  while (i < to) {
    let d: i32 = scope_delta(ops[i]);
    if (d != 0) {
      depth = depth + d;
      i = i + 1;
      continue;
    }
    if (depth != 0 || !is_kind(ops[i], "store_local") || ops[i].i32_imm != token_slot) {
      i = i + 1;
      continue;
    }
    if (found.ok) {
      return SlotFind { ok: false, slot: 0, at: 0 };
    }
    let src: i32 = read_token_operand(ops, from, i);
    if (src < 0) {
      return SlotFind { ok: false, slot: 0, at: 0 };
    }
    found = SlotFind { ok: true, slot: src, at: i };
    i = i + 1;
  }
  return found;
}

function read_token_operand(ops: ir.Op[], from: i32, at: i32): i32 {
  if (at - 1 >= from && is_kind(ops[at - 1], "load_local")) {
    return ops[at - 1].i32_imm;
  }
  if (at - 3 >= from && is_kind(ops[at - 1], "sub")
    && is_kind(ops[at - 2], "const_i32") && is_kind(ops[at - 3], "load_local")) {
    return ops[at - 3].i32_imm;
  }
  return 0 - 1;
}

struct DeclineRead { ok: boolean, found: boolean, slot: i32, at: i32 }

function sole_decline(ops: ir.Op[], from: i32, to: i32): DeclineRead {
  let found: DeclineRead = DeclineRead { ok: true, found: false, slot: 0, at: 0 };
  let depth: i32 = 0;
  let i: i32 = from;
  while (i < to) {
    let d: i32 = scope_delta(ops[i]);
    if (d != 0) {
      depth = depth + d;
      i = i + 1;
      continue;
    }
    if (depth != 0 || !is_rc_dec(ops[i])) {
      i = i + 1;
      continue;
    }
    if (found.found || i - 1 < from || !is_kind(ops[i - 1], "load_local")) {
      return DeclineRead { ok: false, found: false, slot: 0, at: 0 };
    }
    found = DeclineRead { ok: true, found: true, slot: ops[i - 1].i32_imm, at: i };
    i = i + 1;
  }
  return found;
}

struct Site {
  ok: boolean,
  why: string,
  have_dec: boolean,
  gate: i32,
  token: i32,
  dec: i32,
  gate_at: i32,
  token_at: i32,
  dec_at: i32,
}

function site_skip(why: string): Site {
  return Site { ok: false, why: why, have_dec: false, gate: 0, token: 0, dec: 0, gate_at: 0, token_at: 0, dec_at: 0 };
}

function token_arg_slot(ops: ir.Op[], call: i32): i32 {
  let j: i32 = call - 1;
  while (j >= 0 && is_kind(ops[j], "const_i32")) {
    j = j - 1;
  }
  if (j < 0 || !is_kind(ops[j], "load_local")) {
    return 0 - 1;
  }
  return j;
}

function select_end_at(ops: ir.Op[], token_at: i32): i32 {
  let k: i32 = token_at - 1;
  if (k >= 1 && is_kind(ops[k], "store_local")
    && is_kind(ops[k - 1], "const_i32") && ops[k - 1].i32_imm == 0) {
    k = k - 2;
  }
  if (k < 0 || !is_kind(ops[k], "end")) {
    return 0 - 1;
  }
  return k;
}

struct GateRead { code: i32, slot: i32 }

function gate_slot(ops: ir.Op[], if_at: i32): GateRead {
  let at: i32 = flag_source(ops, if_at);
  if (at < 0) {
    return GateRead { code: 2, slot: 0 };
  }
  if (at < 1 || !is_is_unique(ops[at])) {
    return GateRead { code: 1, slot: 0 };
  }
  if (!is_kind(ops[at - 1], "load_local") && !is_kind(ops[at - 1], "tee_local")) {
    return GateRead { code: 1, slot: 0 };
  }
  return GateRead { code: 0, slot: ops[at - 1].i32_imm };
}

function flag_source(ops: ir.Op[], if_at: i32): i32 {
  let at: i32 = if_at - 1;
  if (at < 0) {
    return 0 - 1;
  }
  if (is_is_unique(ops[at])) {
    return at;
  }
  if (is_kind(ops[at], "tee_local")) {
    return at - 1;
  }
  if (at >= 1 && is_kind(ops[at], "load_local")
    && is_kind(ops[at - 1], "store_local") && ops[at - 1].i32_imm == ops[at].i32_imm) {
    return at - 2;
  }
  return 0 - 1;
}

function no_keep(): Site {
  return Site { ok: false, why: "", have_dec: false, gate: 0, token: 0, dec: 0, gate_at: 0, token_at: 0, dec_at: 0 };
}

function read_keep_site(ops: ir.Op[], call: i32, token_slot: i32): Site {
  let at: i32 = call + 1;
  if (at >= ops.len()) {
    return no_keep();
  }
  let result: i32 = ops[at].i32_imm;
  let shape: i32 = at + 1;
  if (is_kind(ops[at], "store_local")) {
    if (shape >= ops.len() || !is_kind(ops[shape], "load_local") || ops[shape].i32_imm != result) {
      return no_keep();
    }
    shape = shape + 1;
  } else if (!is_kind(ops[at], "tee_local")) {
    return no_keep();
  }
  if (shape + 1 >= ops.len() || !is_kind(ops[shape], "struct_set_shape") || !is_kind(ops[shape + 1], "drop")) {
    return no_keep();
  }
  if (call < 6 || !is_kind(ops[call - 3], "if") || !is_kind(ops[call - 4], "eq")
    || !is_kind(ops[call - 5], "const_i32") || ops[call - 5].i32_imm != 0
    || !is_kind(ops[call - 6], "load_local") || ops[call - 6].i32_imm != token_slot) {
    return no_keep();
  }
  let fresh: IfSpan = match_if_forwards(ops, call - 3);
  if (!fresh.ok || fresh.else_at != fresh.end_at - 3
    || !is_kind(ops[fresh.else_at + 1], "load_local") || ops[fresh.else_at + 1].i32_imm != token_slot
    || !is_kind(ops[fresh.else_at + 2], "store_local") || ops[fresh.else_at + 2].i32_imm != result) {
    return no_keep();
  }
  at = fresh.end_at + 1;
  if (at + 3 >= ops.len() || !is_kind(ops[at], "load_local") || ops[at].i32_imm != token_slot
    || !is_kind(ops[at + 1], "const_i32") || ops[at + 1].i32_imm != 0 || !is_kind(ops[at + 2], "ne")
    || !is_kind(ops[at + 3], "if")) {
    return no_keep();
  }
  let span: IfSpan = match_if_forwards(ops, at + 3);
  if (!span.ok || span.else_at < 0) {
    return no_keep();
  }
  let k: i32 = call - 1;
  while (k >= 2) {
    if (is_kind(ops[k], "end") && is_kind(ops[k - 1], "store_local") && ops[k - 1].i32_imm == token_slot
      && is_kind(ops[k - 2], "const_i32") && ops[k - 2].i32_imm == 0) {
      let sel: IfSpan = match_if_backwards(ops, k);
      if (!sel.ok || sel.else_at < 0) {
        return no_keep();
      }
      let gate: GateRead = gate_slot(ops, sel.if_at);
      if (gate.code != 0) {
        return no_keep();
      }
      let tok: SlotFind = sole_token_source(ops, sel.if_at + 1, sel.else_at, token_slot);
      if (!tok.ok) {
        return no_keep();
      }
      let dec: DeclineRead = sole_decline(ops, span.else_at + 1, span.end_at);
      if (!dec.ok) {
        return no_keep();
      }
      return Site {
        ok: true, why: "", have_dec: dec.found, gate: gate.slot, token: tok.slot, dec: dec.slot,
        gate_at: sel.if_at - 3, token_at: tok.at, dec_at: dec.at,
      };
    }
    k = k - 1;
  }
  return no_keep();
}

function match_if_forwards(ops: ir.Op[], if_at: i32): IfSpan {
  let else_at: i32 = 0 - 1;
  let depth: i32 = 0;
  let i: i32 = if_at + 1;
  while (i < ops.len()) {
    if (is_kind(ops[i], "block") || is_kind(ops[i], "loop") || is_kind(ops[i], "if")) {
      depth = depth + 1;
    } else if (is_kind(ops[i], "end")) {
      if (depth == 0) {
        return IfSpan { ok: true, if_at: if_at, else_at: else_at, end_at: i };
      }
      depth = depth - 1;
    } else if (is_kind(ops[i], "else") && depth == 0) {
      else_at = i;
    }
    i = i + 1;
  }
  return IfSpan { ok: false, if_at: 0, else_at: 0 - 1, end_at: 0 - 1 };
}

function read_site(ops: ir.Op[], call: i32): Site {
  let tok_at: i32 = token_arg_slot(ops, call);
  if (tok_at < 0) {
    return site_skip("token argument is not a local load");
  }
  let token_slot: i32 = ops[tok_at].i32_imm;

  let kept: Site = read_keep_site(ops, call, token_slot);
  if (kept.ok) {
    return kept;
  }
  let end_at: i32 = select_end_at(ops, tok_at);
  if (end_at < 0) {
    return site_skip("no token select before the reuse call");
  }

  let span: IfSpan = match_if_backwards(ops, end_at);
  if (!span.ok) {
    return site_skip("token select is not a well-formed if");
  }
  if (span.else_at < 0) {
    return site_skip("token select has no decline arm");
  }

  let gate: GateRead = gate_slot(ops, span.if_at);
  if (gate.code == 1) {
    return site_skip("no uniqueness gate before the token select");
  }
  if (gate.code == 2) {
    return site_skip("token select is not conditioned on a local");
  }

  let tok: SlotFind = sole_token_source(ops, span.if_at + 1, span.else_at, token_slot);
  if (!tok.ok) {
    return site_skip("reuse arm does not derive the token from one local");
  }

  let dec: DeclineRead = sole_decline(ops, span.else_at + 1, end_at);
  if (!dec.ok) {
    return site_skip("decline arm releases more than one local");
  }

  return Site {
    ok: true,
    why: "",
    have_dec: dec.found,
    gate: gate.slot,
    token: tok.slot,
    dec: dec.slot,
    gate_at: span.if_at - 3,
    token_at: tok.at,
    dec_at: dec.at,
  };
}

function site_problems(fn_name: string, call: i32, s: Site): irverify.Problem[] {
  let out: irverify.Problem[] = [];
  if (s.gate != s.token) {
    out = out.append(irverify.Problem {
      fn_name: fn_name,
      op: call,
      kind: "call_direct",
      msg: "reuse site takes local " + util.i32_to_string(s.token)
        + "'s box as its allocation token, but tested local " + util.i32_to_string(s.gate)
        + " for sole ownership (gate at op " + util.i32_to_string(s.gate_at)
        + ", token at op " + util.i32_to_string(s.token_at)
        + "): the box being written over was never proved unique",
    });
  }
  if (s.have_dec && s.dec != s.gate) {
    out = out.append(irverify.Problem {
      fn_name: fn_name,
      op: call,
      kind: "call_direct",
      msg: "reuse site's decline arm releases local " + util.i32_to_string(s.dec)
        + ", but the uniqueness gate tested local " + util.i32_to_string(s.gate)
        + " (gate at op " + util.i32_to_string(s.gate_at)
        + ", release at op " + util.i32_to_string(s.dec_at)
        + "): the tested donor leaks on the decline path",
    });
  }
  return out;
}

struct Claim { at: i32, donor: i32 }

struct Flow { next: i32[], other: i32[] }

function flow_graph(ops: ir.Op[]): Flow {
  let next: i32[] = [];
  let other: i32[] = [];
  let ends: i32[] = [];
  let owner: i32[] = [];
  let stack: i32[] = [];
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i < ops.len()) {
    next = next.append(i + 1);
    other = other.append(ops.len());
    ends = ends.append(ops.len());
    owner = owner.append(0 - 1);
    if (is_kind(ops[i], "block") || is_kind(ops[i], "loop") || is_kind(ops[i], "if")) {
      if (depth < stack.len()) {
        stack = stack.with(depth, i);
      } else {
        stack = stack.append(i);
      }
      depth = depth + 1;
    } else if (is_kind(ops[i], "end") && depth > 0) {
      depth = depth - 1;
      ends = ends.with(stack[depth], i);
    } else if (is_kind(ops[i], "else") && depth > 0) {
      other = other.with(stack[depth - 1], i + 1);
      owner = owner.with(i, stack[depth - 1]);
    } else if (is_kind(ops[i], "br") || is_kind(ops[i], "brif")) {
      let label: i32 = depth - 1 - ops[i].i32_imm;
      if (label >= 0 && label < depth) {
        owner = owner.with(i, stack[label]);
      }
    }
    i = i + 1;
  }
  i = 0;
  while (i < ops.len()) {
    if (is_kind(ops[i], "if") && other[i] == ops.len()) {
      other = other.with(i, ends[i] + 1);
    } else if (is_kind(ops[i], "else") || is_kind(ops[i], "br") || is_kind(ops[i], "brif")) {
      let target: i32 = ops.len();
      let at: i32 = owner[i];
      if (at >= 0) {
        target = ends[at] + 1;
        if (is_kind(ops[at], "loop")) {
          target = at + 1;
        }
      }
      if (is_kind(ops[i], "brif")) {
        other = other.with(i, target);
      } else {
        next = next.with(i, target);
      }
    } else if (is_kind(ops[i], "return")) {
      next = next.with(i, ops.len());
    }
    i = i + 1;
  }
  return Flow { next: next, other: other };
}

function reaches(ops: ir.Op[], flow: Flow, from: i32, to: i32, donor: i32): boolean {
  let seen: i32[] = [];
  let n: i32 = 0;
  while (n < ops.len()) {
    seen = seen.append(0);
    n = n + 1;
  }
  let work: i32[] = [from + 1];
  let at: i32 = 0;
  while (at < work.len()) {
    let i: i32 = work[at];
    at = at + 1;
    if (i < 0 || i >= ops.len() || seen[i] != 0) {
      continue;
    }
    if (i == to) {
      return true;
    }
    seen = seen.with(i, 1);
    if ((is_kind(ops[i], "store_local") || is_kind(ops[i], "tee_local")) && ops[i].i32_imm == donor) {
      continue;
    }
    work = work.append(flow.next[i]);
    if (flow.other[i] < ops.len()) {
      work = work.append(flow.other[i]);
    }
  }
  return false;
}

function double_claim_problems(fn_name: string, ops: ir.Op[], claims: Claim[]): irverify.Problem[] {
  let out: irverify.Problem[] = [];
  if (claims.len() < 2) {
    return out;
  }
  let flow: Flow = flow_graph(ops);
  let i: i32 = 0;
  while (i < claims.len()) {
    let j: i32 = i + 1;
    while (j < claims.len()) {
      if (claims[j].donor == claims[i].donor
        && reaches(ops, flow, claims[i].at, claims[j].at, claims[i].donor)) {
        out = out.append(irverify.Problem {
          fn_name: fn_name,
          op: claims[j].at,
          kind: "call_direct",
          msg: "reuse site takes local " + util.i32_to_string(claims[j].donor)
            + "'s box, which the site at op " + util.i32_to_string(claims[i].at)
            + " already took and never rebound: one allocation handed to two recipients",
        });
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return out;
}

pub function verify_rc_fn(fn_name: string, ops: ir.Op[]): RcResult {
  let r: RcResult = rc_result_new();
  let claims: Claim[] = [];
  let k_calld: i32 = ir.K_CALL_DIRECT;
  let i: i32 = 0;
  while (i < ops.len()) {
    if (is_reuse_alloc(ops[i], k_calld)) {
      r = RcResult { ...r, sites: r.sites + 1 };
      let s: Site = read_site(ops, i);
      if (s.ok) {
        let ps: irverify.Problem[] = site_problems(fn_name, i, s);
        let j: i32 = 0;
        let acc: irverify.Problem[] = r.problems;
        while (j < ps.len()) {
          acc = acc.append(ps[j]);
          j = j + 1;
        }
        r = RcResult { ...r, checked: r.checked + 1, problems: acc };
        claims = claims.append(Claim { at: i, donor: s.gate });
      } else {
        r = RcResult { ...r, skips: r.skips.append(s.why) };
      }
    }
    i = i + 1;
  }
  let dp: irverify.Problem[] = double_claim_problems(fn_name, ops, claims);
  let k: i32 = 0;
  let all: irverify.Problem[] = r.problems;
  while (k < dp.len()) {
    all = all.append(dp[k]);
    k = k + 1;
  }
  return RcResult { ...r, problems: all };
}
