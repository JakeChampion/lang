function interp_mulhi(a: u64, b: u64): u64 {
  let m: u64 = 4294967295 as u64;
  let sh: u64 = 32 as u64;
  let al: u64 = a & m;
  let ah: u64 = a >> sh;
  let bl: u64 = b & m;
  let bh: u64 = b >> sh;
  let mid: u64 = ah * bl + (al * bl >> sh);
  return ah * bh + (mid >> sh) + ((mid & m) + al * bh >> sh);
}
