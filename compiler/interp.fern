// compiler/interp.fern — the tree-walking interpreter behind `fern -interp`,
// `fern -repl` and the playground. It evaluates the checker's annotated module
// (prepared in `lowered`) directly, to a runtime Value: functions, closures
// and methods, every statement form, structs, enums and pattern matching,
// maps, and the host builtins (call_host). internal/oracle/interp is the Go
// interpreter the differential tests hold it to.

import "./ast";
import "./lexer";
import "./lexical";
import "./parser";
import "./util";
import "./aborts";
import "./astwalk";
import "./checker";
import "./aesref";
import "./platforms";
import "./typeinfo";
import "std/io_outcome";
import "std/utf8";

// =================== VALUES ====================

// char uses the same numeric payload as i32 but has a distinct method surface.
// Keep that identity in values so inferred bindings and container reads retain it.
pub struct VInt { v: i32, is_char: boolean }

// VInt64 holds a 64-bit integer (an i64 literal or the result of 64-bit
// arithmetic). The value is stored as two i32 halves rather than a
// single i64 field on purpose: a union variant carrying a raw i64 payload
// trips a native-backend codegen fault in the compiled interpreter (the
// i64 slot is mishandled on the drop path), whereas two i32 fields are
// laid out and dropped cleanly. The full i64 is reconstructed into a local
// only for arithmetic (local i64s are fine); it never lives in the union.
//
// `unsigned` tags the pattern as u64 rather than i64. A u64 occupies the same
// bits (native's `Number` does too, and takes signedness from the checker's
// static type); only div / rem / compares / `>>` and the receiver type name
// read it — the 64-bit twin of the split VUint makes at 32 bits.
//
// `ptr` tags a usize (always unsigned too), which wraps at ptr_bits() rather
// than at 64 (v_usize).
pub struct VInt64 { hi: i32, lo: i32, unsigned: boolean, ptr: boolean }

// VUint carries a u32 as its 32-bit pattern in an i32 field. Unsigned
// semantics (div / rem / compares / logical `>>`, docs/INTEGER-SEMANTICS.md)
// live in eval_binary's unsigned dispatch; `+ - * & | ^ <<` are
// bit-identical to signed i32 and compute on the pattern directly.
pub struct VUint { v: i32 }

pub struct VBool { v: boolean }

pub struct VString { v: string }

// VFloat carries a 64-bit IEEE 754 float. Literals tagged
// `is_float = true` by the parser produce a VFloat; arithmetic
// + comparison operators on two VFloats stay on the float path.
// Mixed i32/f64 isn't supported — explicit cast at the source
// level would route through a future numeric coercion pass.
pub struct VFloat { v: f64 }

// VFloat32 carries an f32-precision value as the ALREADY-ROUNDED f64
// (the native pipelines' f32 model, #4366): arithmetic computes at f64,
// then the result rounds to single precision via f32_round, and the
// f32 tag stays sticky through operator chains.
pub struct VFloat32 { v: f64 }

// VArr holds an array value. `elem` names its declared element type, which
// coerce_int_width stamps from the annotation an array is bound under — the
// value plane is untyped, so an EMPTY array has no element to read the type
// off, and a `T[]` parameter would have nothing to pin `T` to. Empty for an
// array that never passed through an annotation; only type-argument inference
// reads it. `view` preserves the receiver namespace. `reserved` retains
// storage hidden by __arr_set_len so a later host write can regrow it.
pub struct VArr { elements: Value[], elem: string, view: boolean, reserved: Value[] }

// VTuple holds an immutable fixed-arity sequence of values.
// Each slot's runtime type stays whatever the source emitted;
// `.0` / `.1` / … indices read positionally.
pub struct VTuple { elements: Value[] }

// VFunc is a first-class callable value (a closure). It captures
// the lambda's body / params / ret_type plus the scope at the
// point of construction so free identifiers in the body resolve
// against the enclosing function's bindings rather than the
// caller's. `generic_name` names the generic top-level function the value
// is, which a call binds the type parameters of; it is "" otherwise.
pub struct VFunc { params: ast.ParamDecl[], ret_type: string, body: ast.Stmt[], captured_names: string[], captured_values: Value[], captured_types: string[], generic_name: string }

// VMap models the runtime hash-map. Parallel arrays for keys
// and values keep the implementation trivial — lookup is a
// linear scan via value_eq. Realistic-size programs would
// route through std/map's hash table; this is the self-host
// port's minimal-viable storage.
pub struct VMap { keys: Value[], values: Value[] }

// VStruct holds a user-defined struct value. Parallel arrays
// for field names and corresponding evaluated values.
// type_name is the struct's declared name — useful for
// diagnostics and (later) for struct-aware equality. A variant's `owner` is
// the enum it was built as, which its bare name may not decide; "" for a
// struct, or a variant whose enum the construction did not name.
// targs names the type arguments a generic struct's value was built at
// (`Dual[f64]`), read when the value pins a type parameter (tyarg_of_value):
// its field values alone cannot say what T a `Dual[T]` holds.
pub struct VStruct { type_name: string, field_names: string[], field_values: Value[], owner: string, targs: string[] }

pub struct VErr { msg: string, abort: boolean }

// VErr is the bottom of the value lattice — it propagates
// silently through every operator that touches it so the first
// error wins. Mirrors how the checker's TypeUnknown works.
//
// `abort` marks the program's own failure — an out-of-range index, a slice
// past its source, a negative allocation size — which stops it with the
// message the Go interpreter prints and exit status 1 (docs/ARRAY-BOUNDS.md).
// Without it the stop is the interpreter's: something it cannot evaluate.

// VCellI / VCellF are the by-reference binding for a MUTABLE SCALAR CAPTURE
// (SH-057 / #2850). The language deliberately splits capture semantics: scalars
// are captured by reference and a closure may write them (closures-as-counters
// is a supported feature), while reference-typed captures are read-only (E049)
// precisely so a write-back cannot close an RC cycle — the same no-cycles model
// Roc uses. Env is persistent (bind/update return fresh copies), so there is no
// shared mutable state to write through; a cell supplies exactly that. A Value
// can hold a closure, so E057 rejects a Cell[Value] for the same cycle reason:
// a scalar has a cell of its own shape here, and any other value VCellV below.
// A program's own cells are VCell below.
pub struct VCellI { c: Cell[i32], is_char: boolean, is_bool: boolean }

pub struct VCellF { c: Cell[f64] }

// VCell is a program's own `cell_new(v)`: a first-class value the program
// reads with `.get()` and writes with `.set(v)`, distinct from the capture
// cells above, which `lookup` reads through. `kind` names which host cell
// holds the value: one per scalar width, and the string cell for a string or,
// encoded, for any composite E057 admits (cell_value_text).
pub struct VCell { kind: string, ci: Cell[i32], cl: Cell[i64], cf: Cell[f64], cs: Cell[string] }

// VTry is the `expr?` early-return in flight. `?` on a None / Err unwinds to
// the enclosing function's return, which a value-returning eval_unary cannot
// do on its own — so it yields this marker carrying the box to return, and
// is_err reports it as abrupt so the existing "propagate the first error"
// plumbing (`if (is_err(v)) { return v; }`, at every operand site) carries it
// out of the expression for free. Every function boundary — call_func,
// call_method, call_closure — unwraps it back into `box` as that function's
// return value, which is what keeps the unwind from escaping one frame too
// far. Distinct from VErr: an unwind is a normal result of a correct program,
// not a diagnostic.
pub struct VTry { box: Value }

// A value expression carries an enclosing return or loop jump across its operands.
pub struct VControl { box: Value, sig: i32 }

// VType is a TYPE standing in for a value — the object of a receiver-less
// ("associated") trait call, which dispatches on the type itself rather than
// on a receiver: `i32.zero()`, or `T.zero()` inside a generic whose `T` this
// frame pinned to a concrete type. It carries no payload; only call_method
// reads it, to pick the associated FuncDecl.
pub struct VType { name: string }

// VHandle is an open host handle: the Reader, Writer or Dir that stdin(),
// open_reader, pipe(), open_dir and their kin answered. The host's handles are
// opaque records, so the value holds the host's own and each method on it is
// the host's method. Exactly one of the three is Some.
pub struct VHandle { r: Option[Reader], w: Option[Writer], d: Option[Dir] }

// VCellA is a variable's array while a builtin may write into it (see "arrays
// a builtin writes into"): the elements in a host cell every frame the
// variable was passed through shares. Like the capture cells it lives only in
// an Env slot, and lookup reads through it.
pub struct VCellA { c: Cell[i64[]], elem: string, length: Cell[i32] }

// VCellV is the capture cell for any other value a closure reads and its
// enclosing body reassigns: a string, an array, a map, a struct. E057 keeps a
// Value out of a Cell, so it holds the value as the program cell's text
// encoding (cell_any_text), read back on every lookup.
pub struct VCellV { c: Cell[string] }

// VLanes is a value of a lane type: `f64x2` (width 64) or `f32x4` (width 32).
// Each lane is held as its bits, because a comparison gives a mask of all-ones
// lanes and `select` combines masks bit by bit. An f32 lane holds its bits in
// the low 32 of the word.
pub struct VLanes { width: i32, bits: i64[] }

pub type Value = VInt | VInt64 | VUint | VBool | VString | VFloat | VFloat32 | VLanes | VArr | VTuple | VFunc | VMap | VStruct | VCellI | VCellF | VCell | VErr | VTry | VControl | VType | VHandle | VCellA | VCellV;

function v_int(n: i32): Value {
  return VInt { v: n, is_char: false };
}

function char_value(v: Value): Value {
  if let VInt(n) = v {
    if (n.is_char) {
      return v;
    }
  }
  if (is_int_like(v)) {
    return VInt { v: vint_as_i64(v) as i32, is_char: true };
  }
  return v;
}

function int_type_name(n: VInt): string {
  if (n.is_char) {
    return "char";
  }
  return "i32";
}

function v_type(n: string): Value {
  return VType { name: n };
}

// v_wide packs a 64-bit pattern into a VInt64's two i32 halves; unpack_i64
// rebuilds it. `lo` keeps the low 32 bits (masked so a negative low half isn't
// sign-extended into the high word); `hi` is the arithmetic-shifted top 32.
// v_int64 / v_uint64 are the i64 / u64 spellings — same bits, different tag.
function v_wide(n: i64, unsigned: boolean): Value {
  return VInt64 { hi: (n >> 32) as i32, lo: (n & 4294967295) as i32, unsigned: unsigned, ptr: false };
}

// ptr_bits is the pointer width of the target this interpreter runs on: the
// playground's wasm32 build models a 32-bit usize, every other build 64.
function ptr_bits(): i64 {
  if (target_arch() == "wasm32") {
    return 32;
  }
  return 64;
}

// v_usize wraps `n` to the pointer width and tags it a usize.
function v_usize(n: i64): Value {
  let w: i64 = n;
  if (ptr_bits() == 32) {
    w = uint_zext(n as i32);
  }
  return VInt64 { hi: (w >> 32) as i32, lo: w as i32, unsigned: true, ptr: true };
}

function is_vusize(v: Value): boolean {
  if let VInt64(i) = v {
    return i.ptr;
  }
  return false;
}

function v_int64(n: i64): Value {
  return v_wide(n, false);
}

function v_uint64(n: i64): Value {
  return v_wide(n, true);
}

function unpack_i64(x: VInt64): i64 {
  // The low-32 mask is held in a local, NOT written inline as
  // `& 4294967295`: the native backend mis-emits that i64 literal as a
  // sign-extended 32-bit immediate (-1), so an inline mask is a no-op and
  // a negative `lo` stays sign-extended into the high word (which then
  // corrupts e.g. an i64 divide). A `let` forces a full 64-bit load.
  let lo_mask: i64 = 4294967295;
  return x.hi as i64 << 32 | x.lo as i64 & lo_mask;
}

function v_uint(n: i32): Value {
  return VUint { v: n };
}

// wide_as_f64 converts a 64-bit value to a float on the value plane its tag
// selects: a u64 above 2^63 becomes its unsigned magnitude, not the negative
// i64 the same bits spell (#6051 is the codegen half of this).
function wide_as_f64(x: VInt64): f64 {
  if (x.unsigned) {
    let uw: u64 = unpack_i64(x) as u64;
    return uw as f64;
  }
  return unpack_i64(x) as f64;
}

// uint_zext zero-extends a u32 bit pattern to i64 — the value plane for
// unsigned div / rem / compares / logical shift. The mask lives in a local
// for the same native-backend immediate reason as unpack_i64's.
function uint_zext(n: i32): i64 {
  let lo_mask: i64 = 4294967295;
  return n as i64 & lo_mask;
}

// box_i64 narrows an i64 result back to a compact VInt when it fits i32,
// so values that fall back into range don't stay wide (and downstream i32
// consumers keep seeing a VInt). Only genuinely-wide results stay VInt64.
function box_i64(n: i64): Value {
  if (n >= -2147483648 && n <= 2147483647) {
    return v_int(n as i32);
  }
  return v_int64(n);
}

// coerce_int_width promotes a compact VInt to a VInt64 when a binding's
// declared type is a 64-bit integer, so arithmetic on it takes the 64-bit
// path even when the value happens to fit i32 — `let x: i64 = 100000;
// x * 100000` must not overflow as i32. The interpreter is otherwise
// untyped at the value level, so this declared-type hint at var/param
// binding sites is where width intent enters.
// The zero of an annotation, tagged as that annotation's plane: the lowering picks
// the constant's width the same way, and a reference type's zero is the null
// word the compiled paths store, which is v_int(0) here.
function zero_value_of(type_name: string): Value {
  if (parser.spelling_is_view(type_name)) {
    return VArr { elements: [], elem: parser.array_method_element(type_name), view: true, reserved: [] };
  }
  if (name_ends_with(type_name, "[]")) {
    return v_arr_of([], slice_unchecked(type_name, 0, type_name.len() - 2) + "");
  }
  if (type_name == "f64" || type_name == "f32") {
    return v_float(0.0);
  }
  if (type_name == "string" || type_name == "str") {
    return v_string("");
  }
  if (type_name == "boolean" || type_name == "bool") {
    return v_bool(false);
  }
  if (type_name == "i64" || type_name == "u64") {
    return v_wide(0, type_name == "u64");
  }
  if (type_name == "usize") {
    return v_usize(0);
  }
  return v_int(0);
}

function coerce_int_width(val: Value, type_name: string): Value {
  if (type_name == "char") {
    return char_value(val);
  }
  // A usize binding takes a value the checker already proved fits (a literal,
  // or a lossless u8 / u32 widening), so this only retags it.
  if (type_name == "usize" && is_int_like(val)) {
    return v_usize(vint_as_i64(val));
  }
  if (type_name == "i64" || type_name == "u64") {
    // A declared u64 also (re)tags the pattern unsigned — the value plane
    // is untyped, so this and the `as u64` cast are the only two places
    // the signedness of a 64-bit value can enter.
    let uns64: boolean = type_name == "u64";
    match (val) {
      VInt(i) => {
        return v_wide(i.v as i64, uns64);
      },
      VInt64(i) => {
        return v_wide(unpack_i64(i), uns64);
      },
      VUint(u) => {
        return v_wide(uint_zext(u.v), uns64);
      },
      _ => {
        return val;
      }
    }
  }
  // A declared i32 or u8 wraps the value to its width: a literal the checker
  // settled at i32 (`-2147483648`'s magnitude) reads wide until here.
  if (type_name == "i32" && is_int_like(val)) {
    return v_int(vint_as_i64(val) as i32);
  }
  if (type_name == "u8" && is_int_like(val)) {
    return v_int(vint_as_i64(val) as i32 & 255);
  }
  // A declared u32 tags the 32-bit pattern unsigned (a wide VInt64
  // initializer contributes its low word); a declared f32 rounds the
  // value to single precision and tags it sticky.
  if (type_name == "u32") {
    match (val) {
      VInt(i) => {
        return v_uint(i.v);
      },
      VInt64(i) => {
        return v_uint(i.lo);
      },
      _ => {
        return val;
      }
    }
  }
  if (type_name == "f32") {
    match (val) {
      VFloat(f) => {
        return v_float32(f.v);
      },
      VInt(i) => {
        return v_float32(i.v as f64);
      },
      VInt64(i) => {
        return v_float32(wide_as_f64(i));
      },
      _ => {
        return val;
      }
    }
  }
  // A declared array type stamps an EMPTY array with its element type, the
  // only place that type can enter an untyped value plane (see VArr.elem).
  // A non-empty array needs no stamp — its elements name the type.
  if (name_ends_with(type_name, "[]") || parser.spelling_is_view(type_name)) {
    match (val) {
      VArr(a) => {
        let elem: string = a.elem;
        let declared: string = parser.array_method_element(type_name);
        if (elem.len() == 0 && parser.type_str_vars(declared, []).len() == 0) {
          elem = declared;
        }
        return VArr { ...a, elem: elem, view: parser.spelling_is_view(type_name) };
      },
      _ => {
        return val;
      }
    }
  }
  return val;
}

// is_int_like / is_vint64 / vint_as_i64 bridge the integer variants so
// integer arithmetic can widen to 64 bits when either operand is a VInt64
// (a VUint contributes its ZERO-extended value in that context).
function is_int_like(v: Value): boolean {
  match (v) {
    VInt(_) => {
      return true;
    },
    VInt64(_) => {
      return true;
    },
    VUint(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function is_vint64(v: Value): boolean {
  match (v) {
    VInt64(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

// is_vuint64 reports a 64-bit value tagged u64, which selects the unsigned
// dispatch in eval_binary's 64-bit block.
function is_vuint64(v: Value): boolean {
  match (v) {
    VInt64(i) => {
      return i.unsigned;
    },
    _ => {
      return false;
    }
  }
}

function is_int_value(v: Value): boolean {
  match (v) {
    VInt(_) => {
      return true;
    },
    VInt64(_) => {
      return true;
    },
    VUint(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

// index_in is the integer `v` as an index into `n` elements, or -1 when it
// falls outside [0, n), whatever its width and signedness.
function index_in(v: Value, n: i32): i32 {
  let wide: i64 = vint_as_i64(v);
  if (wide < 0 || wide >= n as i64) {
    return 0 - 1;
  }
  return wide as i32;
}

function vint_as_i64(v: Value): i64 {
  match (v) {
    VInt(i) => {
      return i.v as i64;
    },
    VInt64(i) => {
      return unpack_i64(i);
    },
    VUint(u) => {
      return uint_zext(u.v);
    },
    _ => {
      return 0;
    }
  }
}

// is_vuint / vint_bits mirror the pair above for the 32-bit unsigned
// dispatch: vint_bits reads the raw 32-bit pattern of a compact carrier
// (VInt or VUint) for the sign-agnostic ops.
function is_vuint(v: Value): boolean {
  match (v) {
    VUint(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function vint_bits(v: Value): i32 {
  match (v) {
    VInt(i) => {
      return i.v;
    },
    VUint(u) => {
      return u.v;
    },
    _ => {
      return 0;
    }
  }
}

// is_destructure_name / split_binding_names decode the comma-joined name the
// parser gives a destructuring `let`: a nested tuple position is its own list
// in parens (`a,(b,c)`), so only a top-level comma separates positions.
function is_destructure_name(name: string): boolean {
  let i: i32 = 0;
  while (i < name.len()) {
    if (name[i] == b',') {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function split_binding_names(csv: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i <= csv.len()) {
    if (i == csv.len() || csv[i] == b',' && depth == 0) {
      out = out.append(slice_unchecked(csv, start, i) + "");
      start = i + 1;
    } else if (csv[i] == b'(') {
      depth = depth + 1;
    } else if (csv[i] == b')') {
      depth = depth - 1;
    }
    i = i + 1;
  }
  return out;
}

// destructure_step runs a destructuring `let` of `val`. Kept out of eval_stmt,
// whose frame every interpreted call nests.
@noinline
function destructure_step(env: Env, v: ast.StmtVar, val: Value): StepResult {
  let (denv, derr) = bind_destructure(env, v.name, v.type_name, val);
  if (is_err(derr)) {
    return step_stop(env, derr);
  }
  return step_none(denv);
}

// bind_destructure binds a destructuring `let`, parameter prelude or `for`
// header to `val`: `names` is the parser's binding list and `marker` its
// destructure channel (parser.destr_marker), which names an `@` binding of
// the whole value and, for the struct form, the field each name reads. The
// result is the extended env, or an error value saying why `val` does not fit.
function bind_destructure(env: Env, names: string, marker: string, val: Value): (Env, Value) {
  let dm: parser.DestrMarker = parser.destr_marker_split(marker);
  let out: Env = env;
  if (dm.at.len() > 0) {
    out = out.bind(dm.at, val);
  }
  let binds: string[] = split_binding_names(names);
  if (util.str_has_prefix(dm.tag, "@sd:")) {
    let colon: i32 = util.index_of_sub(slice_unchecked(dm.tag, 4, dm.tag.len()) + "", ":");
    let fields: string[] = split_binding_names(slice_unchecked(dm.tag, 4 + colon + 1, dm.tag.len()) + "");
    if let VStruct(sv) = val {
      let i: i32 = 0;
      while (i < binds.len() && i < fields.len()) {
        let fi: i32 = util.index_of_str(sv.field_names, fields[i]);
        if (fi < 0) {
          return (env, v_err("destructuring `" + names + "`: struct " + sv.type_name + " has no field `" + fields[i] + "`"));
        }
        out = out.bind(binds[i], sv.field_values[fi]);
        i = i + 1;
      }
      return (out, v_void());
    }
    return (env, v_err("destructuring `" + names + "`: initialiser is not a struct"));
  }
  if (binds.len() == 1 && !util.str_has_prefix(names, "(")) {
    return (out.bind(names, val), v_void());
  }
  if let VTuple(tv) = val {
    if (tv.elements.len() != binds.len()) {
      return (env, v_err("destructuring `" + names + "`: tuple has " + util.i32_to_string(tv.elements.len()) + " element(s)"));
    }
    let i: i32 = 0;
    while (i < binds.len()) {
      let b: string = binds[i];
      if (util.str_has_prefix(b, "(")) {
        let (inner, err) = bind_destructure(out, slice_unchecked(b, 1, b.len() - 1) + "", "", tv.elements[i]);
        if (is_err(err)) {
          return (env, err);
        }
        out = inner;
      } else {
        out = out.bind(b, tv.elements[i]);
      }
      i = i + 1;
    }
    return (out, v_void());
  }
  return (env, v_err("destructuring `" + names + "`: initialiser is not a tuple"));
}

// is_i32_arg guards a vint_bits read: the compact carriers are the only
// shapes an i32-typed argument can arrive in, and vint_bits reports 0 for
// everything else rather than failing.
function is_i32_arg(v: Value): boolean {
  match (v) {
    VInt(_) => {
      return true;
    },
    VUint(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

// is_string_arg / vstr_of are the string-side pair of is_i32_arg / vint_bits:
// guard, then read, so a builtin taking more than one string does not pay a
// nested destructure per operand. vstr_of answers "" for every other carrier.
function is_string_arg(v: Value): boolean {
  match (v) {
    VString(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function vstr_of(v: Value): string {
  match (v) {
    VString(s) => {
      return s.v;
    },
    _ => {
      return "";
    }
  }
}

// clamp_offset brings a caller's byte offset into [0, n], which is what every
// range-taking kernel does with one rather than trapping.
function clamp_offset(off: i32, n: i32): i32 {
  if (off < 0) {
    return 0;
  }
  if (off > n) {
    return n;
  }
  return off;
}

// is_float_like / is_vfloat32 / vfloat_as_f64 are the float-side bridges:
// a VFloat32's payload is already rounded, so reading it as f64 is exact.
function is_float_like(v: Value): boolean {
  match (v) {
    VFloat(_) => {
      return true;
    },
    VFloat32(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function is_vfloat32(v: Value): boolean {
  match (v) {
    VFloat32(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function vfloat_as_f64(v: Value): f64 {
  match (v) {
    VFloat(f) => {
      return f.v;
    },
    VFloat32(f) => {
      return f.v;
    },
    _ => {
      return 0.0;
    }
  }
}

function v_bool(b: boolean): Value {
  return VBool { v: b };
}

function v_string(s: string): Value {
  return VString { v: s };
}

function v_float(n: f64): Value {
  return VFloat { v: n };
}

// f32_round rounds an f64 to single precision. The demote uses the
// f32_bits / f32_from_bits builtin pair (not a bare `as f32` round-trip):
// every pipeline that runs this interpreter special-cases the pair with a
// real cvtsd2ss/cvtss2sd narrowing, whereas the legacy self-host AST
// backend treats float→f32 `as` casts as no-ops.
function f32_round(x: f64): f64 {
  return f32_from_bits(f32_bits(x as f32)) as f64;
}

function v_float32(x: f64): Value {
  return VFloat32 { v: f32_round(x) };
}

function v_arr(elements: Value[]): Value {
  return VArr { elements: elements, elem: "", view: false, reserved: [] };
}

function v_arr_of(elements: Value[], elem: string): Value {
  return VArr { elements: elements, elem: elem, view: false, reserved: [] };
}

function v_tuple(elements: Value[]): Value {
  return VTuple { elements: elements };
}

function v_map(keys: Value[], values: Value[]): Value {
  return VMap { keys: keys, values: values };
}

function v_map_new(): Value {
  let ks: Value[] = [];
  let vs: Value[] = [];
  return VMap { keys: ks, values: vs };
}

function v_struct(type_name: string, names: string[], values: Value[]): Value {
  return VStruct { type_name: type_name, field_names: names, field_values: values, owner: "", targs: [] };
}

function v_struct_at(type_name: string, names: string[], values: Value[], targs: string[]): Value {
  return VStruct { type_name: type_name, field_names: names, field_values: values, owner: "", targs: targs };
}

function v_err(msg: string): Value {
  return VErr { msg: msg, abort: false };
}

// v_abort is a fatal stop. `cause` is the line a compiled program prints for
// it, and `detail` is the interpreter's own line under it, where a compiled
// program prints its backtrace.
function v_abort(cause: string, detail: string): Value {
  return VErr { msg: cause + "\n  " + detail, abort: true };
}

// index_abort is the stop for index i into a container of length n.
function index_abort(cause: string, i: string, n: i32): Value {
  return v_abort(cause, "index " + i + ", length " + util.i32_to_string(n));
}

// slice_abort is the stop for a range [lo:hi] that does not fit a source of
// length n.
function slice_abort(cause: string, what: string, lo: i32, hi: i32, n: i32): Value {
  return v_abort(cause, what + " [" + util.i32_to_string(lo) + ":" + util.i32_to_string(hi) + "], length " + util.i32_to_string(n));
}

// v_void is the result of an expression that produces no value — a call to a
// void function, or a body that runs off its end without a `return`, which is
// how a void function returns. The interpreter has no VVoid variant: nothing
// reads a void result, so it reuses the zero the void builtins already
// return.
function v_void(): Value {
  return v_int(0);
}

// v_absent fills a Value slot that is provably never read: the receiver
// argument at a `has_recv: false` call (bind_tyargs reads `recv` only under
// that flag), and the `recv` / `closure_val` initialisers every path
// overwrites before use.
//
// It uses VErr because the union has no neutral variant, NOT because
// anything went wrong — nothing anywhere compares the message. Adding a
// VAbsent variant would put a dead arm in every exhaustive match over Value,
// which is a worse trade than one named constructor.
function v_absent(): Value {
  return VErr { msg: "__absent__", abort: false };
}

// is_err reports an ABRUPT value — one that must propagate out of the
// enclosing expression rather than being operated on. Both bottoms qualify:
// VErr (a diagnostic, which runs to the top) and VTry (a `?` unwind, which
// every function boundary catches and converts back into a return value).
function is_err(v: Value): boolean {
  match (v) {
    VControl(_) => {
      return true;
    },
    VErr(_) => {
      return true;
    },
    VTry(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// unwrap_try converts a `?` unwind that reached a function boundary into that
// function's return value — the box (`None` / `Err(e)`) the operand carried.
// A VErr or an ordinary value passes through untouched.
function unwrap_try(v: Value): Value {
  match (v) {
    VTry(t) => {
      return t.box;
    },
    _ => {
      return v;
    }
  }
  return v;
}

// module_variant_decls collects every enum-variant constructor the program can
// name, as the lowered variant StructDecls the parser already produces for
// `enum E { V(T) }` — `name` is the variant, `enum_owner` the enum, and the
// `__ev` / `__ev1` / … field count the payload arity.
//
// Three sources, matching what the native interpreter registers (its `Enums`
// table is `prog.Enums`, which the checker has already prepended its builtins
// to):
//
//   * the module's own enums, lowered into `mod.structs` by parse_enum_decl;
//   * IoError / Body, which no program declares — `inject_builtin_enums`
//     synthesises the same variant structs, and is idempotent when the real
//     builtins.fern module is already merged in;
//   * Option / Result, which `inject_builtin_enums` leaves out because the
//     backends special-case Some / None / Ok / Err rather than emit variant
//     structs for them. The interpreter has no such special case, so it wants
//     ordinary decls (#5990).
// module_type_decls is every struct declaration in reach — the module's own,
// the front end's injected enums, and the synthesised Option / Result variants.
//
// It used to drop everything with no enum_owner, i.e. every plain struct, which
// left the interpreter unable to name the declared type of a struct FIELD. That
// is what made a `dyn` value held in a field dispatch on the runtime value alone
// and answer from the first provider (#7291). variant_arity does the
// enum_owner test itself now, so the variant consumers are unaffected by the
// wider list.
function module_type_decls(structs: parser.StructDecl[]): parser.StructDecl[] {
  let all: parser.StructDecl[] = parser.inject_builtin_enums(structs);
  all = add_variant_decl(all, "Some", 1, "Option");
  all = add_variant_decl(all, "None", 0, "Option");
  all = add_variant_decl(all, "Ok", 1, "Result");
  all = add_variant_decl(all, "Err", 1, "Result");
  return all;
}

// struct_field_type names the declared type of `field` on the struct `sname`,
// or "" when either is unknown. A lookup, not inference — which is exactly the
// line #7291 draws: a field's type is written on its declaration, an inferred
// binding's is written nowhere.
function struct_field_type(decls: parser.StructDecl[], sname: string, field: string): string {
  let i: i32 = 0;
  while (i < decls.len()) {
    if (decls[i].name == sname) {
      let j: i32 = 0;
      while (j < decls[i].fields.len()) {
        if (decls[i].fields[j].name == field) {
          return decls[i].fields[j].type_name;
        }
        j = j + 1;
      }
      return "";
    }
    i = i + 1;
  }
  return "";
}

// add_variant_decl synthesises one variant struct, skipping it when the
// program already declares that name — a user `enum MyOpt { Some(i32) }`, or a
// plain `struct Ok`, keeps its own decl.
function add_variant_decl(acc: parser.StructDecl[], name: string, arity: i32, enum_name: string): parser.StructDecl[] {
  let i: i32 = 0;
  while (i < acc.len()) {
    if (acc[i].name == name) {
      return acc;
    }
    i = i + 1;
  }
  let fields: parser.StructFieldDecl[] = [];
  let f: i32 = 0;
  while (f < arity) {
    let fname: string = "__ev";
    if (f > 0) {
      fname = "__ev" + util.i32_to_string(f);
    }
    fields = fields.append(parser.StructFieldDecl { name: fname, type_name: "", fn_ret: "", fn_param_types: "" });
    f = f + 1;
  }
  return acc.append(parser.StructDecl { name: name, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: enum_name, must_consume: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" });
}

// variant_arity returns the payload count of the enum variant of this name, or
// -1 when no enum declares it.
//
// The enum_owner test is what keeps this answering about VARIANTS while the
// list it reads also carries plain struct declarations (#7291): a `struct
// Holder` must stay -1 here, or a bare `Holder` would be taken for a
// nullary variant at the three call sites that ask.
function variant_arity(name: string, decls: parser.StructDecl[]): i32 {
  let i: i32 = 0;
  while (i < decls.len()) {
    if (decls[i].name == name && decls[i].enum_owner.len() > 0) {
      return decls[i].fields.len();
    }
    i = i + 1;
  }
  return 0 - 1;
}

// user_func_exists reports whether the module declares a non-method function
// of this name. A program is free to define its own `Ok(...)`; the declaration
// wins, so the builtin constructor is only reached when nothing else answers.
function user_func_exists(name: string, funcs: parser.FuncDecl[]): boolean {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_type.len() == 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// v_variant builds the runtime shape a payload enum variant has: a VStruct
// tagged with the variant name whose fields carry the parser's synthesised
// `__ev` / `__ev1` / … names, which is the marker StmtMatch keys on to bind a
// `V(a, b, …)` pattern positionally. A nullary variant has no fields.
function v_variant(name: string, args: Value[]): Value {
  return v_variant_of("", name, args);
}

// v_variant_of is v_variant built as enum `owner`'s.
function v_variant_of(owner: string, name: string, args: Value[]): Value {
  let vnames: string[] = [];
  let vi: i32 = 0;
  while (vi < args.len()) {
    if (vi == 0) {
      vnames = vnames.append("__ev");
    } else {
      vnames = vnames.append("__ev" + util.i32_to_string(vi));
    }
    vi = vi + 1;
  }
  return VStruct { type_name: name, field_names: vnames, field_values: args, owner: owner, targs: [] };
}

// variant_owner is the one enum declaring variant `name`, or "" when none or
// several do.
function variant_owner(name: string, decls: parser.StructDecl[]): string {
  let owner: string = "";
  for d in decls {
    if (d.name == name && d.enum_owner.len() > 0) {
      if (owner.len() > 0) {
        return "";
      }
      owner = d.enum_owner;
    }
  }
  return owner;
}

// qualified_owner is the enum a `qual.name` variant was built as: `qual` when
// it is an enum declaring `name`, else (a module qualifier) the one enum that
// does.
function qualified_owner(qual: string, name: string, decls: parser.StructDecl[]): string {
  for d in decls {
    if (d.name == name && d.enum_owner == qual) {
      return qual;
    }
  }
  return variant_owner(name, decls);
}

// variant_of_enum reports a variant value of enum `base`: by the enum it was
// built as when that is known, else by its name among the enum's variants.
function variant_of_enum(v: Value, base: string, aliases: parser.TypeAlias[]): boolean {
  if let VStruct(sv) = v {
    if (sv.owner.len() > 0) {
      return sv.owner == base;
    }
    return is_variant_of_alias_interp(sv.type_name, base, aliases);
  }
  return false;
}

// interp_char_boundary reports whether byte offset `i` starts a UTF-8 code
// point in `s`. Mirrors std/utf8.is_char_boundary: a continuation byte is
// 0b10xxxxxx, so 128..191 are interior; both ends of the string are
// boundaries by definition.
function interp_char_boundary(s: string, i: i32): boolean {
  if (i <= 0 || i >= s.len()) {
    return true;
  }
  let icb: i32 = s[i] as i32;
  return icb < 128 || icb >= 192;
}

// =================== SCOPE ====================

// Same shape as the checker's Scope but the parallel slot is
// Value rather than Type. Linear scan, newest binding wins —
// matches `let` semantics for the limited stmt set we handle.
// Env carries both the value scope and the immutable function
// table (so ExprCall can dispatch from anywhere a value lives in
// scope). bind / update / trim preserve `funcs` unchanged.
// aliases carries the module's `pub type X = A | B` decls so
// call_method can dispatch a method declared on a union (e.g.
// `function (sh: Shape) area()`) when the receiver is one of
// the union's variant structs.
//
// type_decls carries every struct declaration the program can name, enum
// variants included — the parser lowers `enum Shape { Circle(i32) }` to a
// StructDecl per variant with `enum_owner` set, and `module_type_decls` adds
// the front-end's injected enums on top. It is what tells a call to `Circle(7)`
// apart from a call to a function nobody declared, and what names the declared
// type of a struct field.
//
// `types` runs parallel to names/values and holds each binding's DECLARED type
// spelling — the annotation the source wrote, or the one its initialiser's
// declaration states, and empty when neither is in reach. The value plane is
// untyped, so a static type — which `dyn Trait` dispatch needs and no runtime
// value carries — can only enter through the annotation a binding was made
// under; this is the slot the checker's Scope holds a Type in.
// `ret` is the declared result of the function whose body this is, "" outside
// one: a `return f()` pins f's type parameters from it, as a `let`'s
// annotation does.
pub struct Env { names: string[], values: Value[], types: string[], funcs: parser.FuncDecl[], aliases: parser.TypeAlias[], type_decls: parser.StructDecl[], outs: OutTable, ret: string }

// new_env seeds a declaration-free scope: the bare-statement driver
// (eval_program) has no module around it, so the only declarations in reach are
// the front-end's own injected enums.
function new_env(): Env {
  let ns: string[] = [];
  let vs: Value[] = [];
  let ts: string[] = [];
  let fs: parser.FuncDecl[] = [];
  let al: parser.TypeAlias[] = [];
  let no_structs: parser.StructDecl[] = [];
  return Env { names: ns, values: vs, types: ts, funcs: fs, aliases: al, type_decls: module_type_decls(no_structs), outs: builtin_outs(), ret: "" };
}

function new_module_env(fs: parser.FuncDecl[], al: parser.TypeAlias[], vd: parser.StructDecl[], outs: OutTable): Env {
  let ns: string[] = [];
  let vs: Value[] = [];
  let ts: string[] = [];
  return Env { names: ns, values: vs, types: ts, funcs: fs, aliases: al, type_decls: vd, outs: outs, ret: "" };
}

function (e: Env) bind(name: string, v: Value): Env {
  return e.bind_decl(name, v, "");
}

// bind_decl binds a name under its DECLARED type: the annotation coerces the
// value's integer width / float precision / empty-array element, and is kept in
// the scope for the static questions the value cannot answer (see Env.types).
function (e: Env) bind_decl(name: string, v: Value, decl_ty: string): Env {
  let ns: string[] = e.names.append(name);
  let vs: Value[] = e.values.append(coerce_int_width(v, decl_ty));
  let ts: string[] = e.types.append(decl_ty);
  return Env { ...e, names: ns, values: vs, types: ts };
}

// decl_type reads back the declared type of a binding, "" when it has none or
// the name is unbound. Newest binding wins, as lookup does.
function (e: Env) decl_type(name: string): string {
  let i: i32 = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return e.types[i];
    }
    i = i - 1;
  }
  return "";
}

// static_type_of names the declared type of an EXPRESSION. Every shape it
// answers reaches a written-down type by lookup, never by inference: an
// identifier's own annotation, an element of an array whose annotation names
// one, a FIELD whose owning struct type is itself answerable, and the result of
// a call — to a top-level function or a method — whose return type the callee's
// declaration states.
//
// Anything reachable only by inferring a type nobody wrote still answers ""
// (#7291, docs/DYN-TRAITS.md §4.3).
//
// "" leaves dispatch on the runtime value alone, which picks the FIRST provider
// when two traits claim one method name — a silent wrong answer, so the set of
// shapes answered here is the set of shapes that dispatch correctly.
function (e: Env) static_type_of(x: ast.Expr): string {
  match (x) {
    ast.ExprIdent(id) => {
      return e.decl_type(id.name);
    },
    ast.ExprIndex(ix) => {
      let at: string = e.static_type_of(ix.array);
      if (name_ends_with(at, "[]")) {
        return slice_unchecked(at, 0, at.len() - 2) + "";
      }
      return "";
    },
    ast.ExprFieldAccess(fa) => {
      let ot: string = e.static_type_of(fa.obj);
      if (ot.len() == 0) {
        return "";
      }
      return struct_field_type(e.type_decls, ot, fa.field);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          // A local binding of the same name shadows the function and
          // holds a closure, whose return type is not declared here.
          if (e.binds_name(id.name)) {
            return "";
          }
          return func_ret_type(e.funcs, id.name);
        },
        ast.ExprFieldAccess(fa) => {
          // A METHOD call: the receiver's own declared type names the
          // definition, whose return type the declaration states. A
          // closure held in a FIELD matches no declaration and answers "".
          let rt: string = e.static_type_of(fa.obj);
          if (rt.len() == 0) {
            return "";
          }
          return method_ret_type(e.funcs, rt, fa.field);
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
}

// method_ret_type names the declared return type of `recv_ty`'s `name` method.
// Two declarations answering one name for one type — which the parser's
// interposition normally rules out — leave it ambiguous, and it answers ""
// rather than picking one.
function method_ret_type(funcs: parser.FuncDecl[], recv_ty: string, name: string): string {
  let found: string = "";
  let seen: boolean = false;
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_type == recv_ty) {
      if (seen && funcs[i].ret_type != found) {
        return "";
      }
      found = funcs[i].ret_type;
      seen = true;
    }
    i = i + 1;
  }
  return found;
}

// binds_name reports whether a local binding shadows `name`.
function (e: Env) binds_name(name: string): boolean {
  let i: i32 = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return true;
    }
    i = i - 1;
  }
  return false;
}

// func_ret_type names the declared return type of a top-level function.
function func_ret_type(funcs: parser.FuncDecl[], name: string): string {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_type.len() == 0) {
      return funcs[i].ret_type;
    }
    i = i + 1;
  }
  return "";
}

function (e: Env) lookup(name: string): Value {
  let i: i32 = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return deref_cell(e.values[i]);
    }
    i = i - 1;
  }
  return v_err("undefined identifier: " + name);
}

// deref_cell reads through a capture cell (SH-057). Every read
// path goes via lookup, so a VCell* is never observed by the rest of the
// interpreter — it exists only in the Env slot and in the closure snapshot that
// shares it. Non-cell values pass straight through.
function deref_cell(v: Value): Value {
  match (v) {
    VCellI(ci) => {
      if (ci.is_bool) {
        return VBool { v: ci.c.get() != 0 };
      }
      return VInt { v: ci.c.get(), is_char: ci.is_char };
    },
    VCellF(cf) => {
      return VFloat { v: cf.c.get() };
    },
    VCellA(ca) => {
      let full: Value[] = [];
      for x in ca.c.get() {
        full = full.append(v_int(x as i32));
      }
      let els: Value[] = full;
      if (ca.length.get() < full.len()) {
        els = [];
        let i: i32 = 0;
        while (i < ca.length.get()) {
          els = els.append(full[i]);
          i = i + 1;
        }
      }
      return VArr { elements: els, elem: ca.elem, view: false, reserved: full };
    },
    VCellV(cv) => {
      return cell_any_value(cv.c.get(), cell_new(0));
    },
    _ => {
      return v;
    }
  }
}

// cell_slot_set writes through a cell slot, returning true when `v` was one.
// The Env is left alone in that case: the mutation lives in the cell, which the
// enclosing scope and every closure that captured it already share.
function cell_slot_set(slot: Value, v: Value): boolean {
  match (slot) {
    VCellI(ci) => {
      match (v) {
        VInt(n) => {
          ci.c.set(n.v);
          return true;
        },
        VBool(bb) => {
          if (bb.v) {
            ci.c.set(1);
          } else {
            ci.c.set(0);
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    VCellF(cf) => {
      match (v) {
        VFloat(f) => {
          cf.c.set(f.v);
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    VCellV(cv) => {
      let (ok, text) = encoded_text(v);
      if (ok) {
        cv.c.set(text);
      }
      return ok;
    },
    _ => {
      return false;
    }
  }
}

// ---- mutable scalar captures: deciding which locals need a cell (SH-057) ----
//
// A local needs one exactly when some lambda in the same statement ASSIGNS to
// it. Reads alone are fine — the by-value snapshot already sees the right
// value — which is why the bug only ever showed on a write, and why the audit
// repro assigns without reading.
//
// The decision is made per STATEMENT rather than per function body: a lambda
// can appear in any expression position (a `let` init, a call argument, an
// array element), and doing it here means every one of those is covered by the
// same code path without threading a set through Env.

// lam_assign_targets collects assignment targets anywhere in a lambda body,
// including nested control flow and nested lambdas. The whole-subtree fold
// WIDENS the old hand-written walk onto a `defer` action's assignment and a
// match-arm guard's nested lambda — shapes where the write previously landed
// in a private copy — in the direction every other engine already answers.
function lam_assign_targets(stmts: ast.Stmt[], own acc: string[]): string[] {
  let a: string[] = acc;
  for st in stmts {
    a = astwalk.fold_stmt_nodes(st, a, assign_target_of, reads_nothing, astwalk.descend_all);
  }
  return a;
}

// ---- the OUTER-write clause of a mutable scalar capture (#5394 / #6578) ----
//
// The rule above cells a local because a LAMBDA writes it. This is the other
// direction, and the one that was never ported: the lambda only READS the
// local, and the ENCLOSING body reassigns it afterwards. A by-value snapshot
// freezes the pre-assignment value, so `let i = 0; let f = (x) => x + i;
// i = 3; f(0)` answered 0 here and 3 on every other engine.
//
// The reassignment guard is what keeps this narrow, and the narrowness is the
// whole point. A local the body never reassigns reads the same either way, so
// celling it is invisible — but a per-iteration `let n = k` captured in a loop
// MUST stay by value, and celling that would hand every closure the last
// iteration's n. Native answers 3 for that shape, not 6.

// ib_ident_of / ib_idents_stmts collect every ident mentioned. Used only to
// approximate what a lambda READS: a superset is safe here because the result
// is intersected with the names the enclosing body actually reassigns, and
// cellify_env only touches names bound in this scope.
function ib_ident_of(e: ast.Expr, own acc: string[]): string[] {
  match (e) {
    ast.ExprIdent(id) => {
      return acc.append(id.name);
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function ib_idents_stmts(stmts: ast.Stmt[], own acc: string[]): string[] {
  let a: string[] = acc;
  for st in stmts {
    a = astwalk.fold_stmt_nodes(st, a, assign_target_of, ib_ident_of, astwalk.descend_all);
  }
  return a;
}

// lam_read_names: the names some lambda in `st` mentions. Only a LAMBDA body
// contributes, exactly as stmt_lambda_writes does — an ident in the statement's
// own expression is an ordinary read in this scope, not a capture.
//
// Same walk as stmt_lambda_writes, and for the same reason: see its comment for
// why it is the statement's OWN expressions and why it stops at a lambda.
function lam_read_names(st: ast.Stmt): string[] {
  return astwalk.fold_stmt_own_pruned(st, no_names(), lam_read_of, not_lambda_expr);
}

// body_assign_names: every name this body reassigns, at any depth. A name NOT
// in here is captured by value, which is what keeps a loop-local `let` per
// iteration — the statement spine is that stop spelled once: statement lists at
// every depth, lambda bodies never, since those hang off expressions.
function body_assign_names(stmts: ast.Stmt[], acc: string[]): string[] {
  let a: string[] = acc;
  for st in stmts {
    a = astwalk.fold_stmt_spine(st, a, assign_target_of);
  }
  return a;
}

// assign_target_of is one statement's contribution to the reassignment scans:
// an assignment's TARGET, a bare string on the statement that the expression
// visitor is never handed.
function assign_target_of(st: ast.Stmt, own acc: string[]): string[] {
  match (st) {
    ast.StmtAssign(asg) => {
      return acc.append(asg.target);
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function reads_nothing(e: ast.Expr, own acc: string[]): string[] {
  return acc;
}

// cellify_captures is the per-statement pre-pass every block driver runs before
// evaluating a statement, and it applies both capture clauses:
//
//   WRITES — a name a lambda in `st` assigns becomes a cell unconditionally,
//     or the closure writes a private copy (SH-057).
//   READS — a name a lambda in `st` reads AND this body reassigns becomes a
//     cell, or the closure freezes the pre-assignment value (#5394).
//
// Both must run BEFORE the statement evaluates, because that is when the
// closure snapshots the env; celling afterwards hands it a slot nobody shares.
function cellify_captures(env: Env, st: ast.Stmt, reassigned: string[]): Env {
  let out: Env = cellify_env(env, stmt_lambda_writes(st));
  if (reassigned.len() == 0) {
    return out;
  }
  let reads: string[] = lam_read_names(st);
  let hit: string[] = [];
  let i: i32 = 0;
  while (i < reads.len()) {
    if (util.index_of_str(reassigned, reads[i]) >= 0) {
      hit = hit.append(reads[i]);
    }
    i = i + 1;
  }
  if (hit.len() == 0) {
    return out;
  }
  return cellify_env(out, hit);
}

// stmt_lambda_writes lists the names some lambda in `st` assigns to.
//
// Every expression the statement OWNS is scanned, not the four shapes a
// hand-written match happened to spell: a lambda in an `if` / `while`
// condition, a `for`'s iterated expression or a `match` scrutinee or guard
// captures the enclosing scope exactly as one in a `let` initialiser does, and
// missing it left the written name uncelled — a write to a private copy. The
// statement's own child BLOCKS are not entered, which is the point of
// fold_stmt_own: each gets its own pass with its own reassignment set, and
// walking in would cell a loop-local `let` that has to stay per-iteration.
//
// Only a lambda body contributes, so the walk stops at one: lam_assign_targets
// already accounts for its whole body, and descending would re-scan it.
function stmt_lambda_writes(st: ast.Stmt): string[] {
  return astwalk.fold_stmt_own_pruned(st, no_names(), lam_target_of, not_lambda_expr);
}

// A fresh, empty name list. A fold's CONSUMING accumulator takes a value the
// caller owns; a local initialised from a literal is not provably one, and a
// call with no reference parameter is.
function no_names(): string[] {
  return [];
}

// lam_target_of / lam_read_of are one node's contribution to the two scans —
// the whole of each that is not the walk.
function lam_target_of(e: ast.Expr, own acc: string[]): string[] {
  match (e) {
    ast.ExprLambda(lm) => {
      return lam_assign_targets(lm.body, acc);
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function lam_read_of(e: ast.Expr, own acc: string[]): string[] {
  match (e) {
    ast.ExprLambda(lm) => {
      return ib_idents_stmts(lm.body, acc);
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function not_lambda_expr(e: ast.Expr): boolean {
  match (e) {
    ast.ExprLambda(_) => {
      return false;
    },
    _ => {
      return true;
    }
  }
  return true;
}

// raw_slot reads a slot WITHOUT the lookup deref — cellify needs to see whether
// a binding is already a cell.
function (e: Env) raw_slot(name: string): i32 {
  let i: i32 = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return i;
    }
    i = i - 1;
  }
  return 0 - 1;
}

// cellify_env converts each named binding into a shared cell, so the
// closure about to be built and the enclosing scope write through the same one.
function cellify_env(e: Env, names: string[]): Env {
  let out: Env = e;
  let i: i32 = 0;
  while (i < names.len()) {
    let idx: i32 = out.raw_slot(names[i]);
    if (idx >= 0) {
      let cur: Value = out.values[idx];
      let boxed: Value = cell_for(cur);
      // cell_for returns its argument unchanged for a value with no cell
      // (a function) and for an already-celled slot, so this is idempotent
      // and never re-seeds a live cell.
      if (!is_cell(cur)) {
        out = out.update(names[i], boxed);
      }
    }
    i = i + 1;
  }
  return out;
}

// ---- arrays a builtin writes into ------------------------------------------
//
// Host input fills an array the caller owns. __arr_set_len changes its length,
// and each frame sees the writes through the program's variable,
// however many functions passed it down. The interpreter's arrays are values,
// so for the length of one statement a variable it passes to an OUT position
// is held in a VCellA, which the builtin writes and every frame the variable
// passed through shares. An out position is one of those builtins' array
// arguments, or a parameter a function passes to an out position itself.
//
// Only the builtin writes through the cell. An assignment to a celled variable
// replaces the slot as it would any other, so a callee rebinding its parameter
// is not seen by its caller, as a copy-on-write array's caller would not. A
// second variable bound to the same array (`let b = a`) does not see the
// write either: the cell follows the variable passed, not the array (#12841).

// OutTable is a module's out positions as "callee#k" keys, and the callees
// that have any.
pub struct OutTable { names: string[], keys: string[] }

function builtin_outs(): OutTable {
  return OutTable { names: ["tcp_recv_into", "udp_recvfrom", "reactor_wait", "__arr_set_len"], keys: ["tcp_recv_into#1", "udp_recvfrom#1", "udp_recvfrom#2", "reactor_wait#1", "__arr_set_len#0"] };
}

function out_key(callee: string, k: i32): string {
  return callee + "#" + util.i32_to_string(k);
}

// callee_names is every name a call's callee may be declared under: a plain
// function, a qualified `ns.f`, or a receiver method named by its field.
function callee_names(callee: ast.Expr): string[] {
  match (callee) {
    ast.ExprIdent(id) => {
      return [id.name];
    },
    ast.ExprFieldAccess(fa) => {
      if let ast.ExprIdent(ns) = fa.obj {
        return [ns.name + "." + fa.field, fa.field];
      }
      return [fa.field];
    },
    _ => {
      return [];
    }
  }
}

// out_idents_of adds each identifier `e`, a call, passes to an out position.
function out_idents_of(e: ast.Expr, own acc: string[], outs: OutTable): string[] {
  let out: string[] = acc;
  match (e) {
    ast.ExprCall(c) => {
      for cn in callee_names(c.callee) {
        if (util.has_str(outs.names, cn)) {
          out = out_args_of(c, cn, out, outs);
        }
      }
    },
    _ => {}
  }
  return out;
}

function out_args_of(c: ast.ExprCall, callee: string, own acc: string[], outs: OutTable): string[] {
  let out: string[] = acc;
  let k: i32 = 0;
  while (k < c.args.len()) {
    if let ast.ExprIdent(id) = c.args[k] {
      if (util.has_str(outs.keys, out_key(callee, k))) {
        out = out.append(id.name);
      }
    }
    k = k + 1;
  }
  return out;
}

// out_table is a module's out positions: the builtins', and every parameter a
// function passes to one, to a fixed point. Only an array parameter can be
// one.
function out_table(funcs: parser.FuncDecl[]): OutTable {
  let t: OutTable = builtin_outs();
  let grown: boolean = true;
  while (grown) {
    let next: OutTable = t;
    for fd in funcs {
      next = mark_out_params(fd, next);
    }
    grown = next.keys.len() > t.keys.len();
    t = next;
  }
  return t;
}

function mark_out_params(fd: parser.FuncDecl, t: OutTable): OutTable {
  let passed: string[] = [];
  let scanned: boolean = false;
  let out: OutTable = t;
  let k: i32 = 0;
  while (k < fd.params.len()) {
    let key: string = out_key(fd.name, k);
    if (name_ends_with(fd.params[k].type_name, "[]") && !util.has_str(out.keys, key)) {
      if (!scanned) {
        passed = body_out_idents(fd.body, out);
        scanned = true;
      }
      if (util.has_str(passed, fd.params[k].name)) {
        out = OutTable { names: out.names.append(fd.name), keys: out.keys.append(key) };
      }
    }
    k = k + 1;
  }
  return out;
}

function body_out_idents(body: ast.Stmt[], outs: OutTable): string[] {
  function visit(e: ast.Expr, own a: string[]): string[] {
    return out_idents_of(e, a, outs);
  }
  let acc: string[] = [];
  for st in body {
    acc = astwalk.fold_stmt_pruned(st, acc, visit, not_lambda_expr);
  }
  return acc;
}

// stmt_out_idents is the variables `st` itself passes to an out position; its
// child blocks are their own statements.
function stmt_out_idents(st: ast.Stmt, outs: OutTable): string[] {
  function visit(e: ast.Expr, own a: string[]): string[] {
    return out_idents_of(e, a, outs);
  }
  return astwalk.fold_stmt_own_pruned(st, no_names(), visit, not_lambda_expr);
}

// eval_out_stmt evaluates `st`, holding each variable it passes to an out
// position in a cell for the length of the statement. A variable already
// celled is a parameter its caller celled, and stays shared.
function eval_out_stmt(st: ast.Stmt, env: Env): StepResult {
  let names: string[] = stmt_out_idents(st, env.outs);
  if (names.len() == 0) {
    return eval_stmt(st, env);
  }
  let celled: Env = env;
  let made: string[] = [];
  for n in names {
    let idx: i32 = celled.raw_slot(n);
    if (idx >= 0) {
      if let VArr(a) = celled.values[idx] {
        let xs: i64[] = [];
        let capacity: i32 = a.elements.len();
        if (a.reserved.len() > capacity) {
          capacity = a.reserved.len();
        }
        let i: i32 = 0;
        while (i < capacity) {
          if (i < a.elements.len()) {
            xs = xs.append(vint_as_i64(a.elements[i]));
          } else {
            xs = xs.append(vint_as_i64(a.reserved[i]));
          }
          i = i + 1;
        }
        celled = celled.update(n, VCellA { c: cell_new(xs), elem: a.elem, length: cell_new(a.elements.len()) });
        made = made.append(n);
      }
    }
  }
  let r: StepResult = eval_stmt(st, celled);
  return StepResult { env: uncell_outs(r.env, made), ret: r.ret, sig: r.sig };
}

function uncell_outs(env: Env, names: string[]): Env {
  let out: Env = env;
  for n in names {
    let idx: i32 = out.raw_slot(n);
    if (idx >= 0) {
      if let VCellA(_) = out.values[idx] {
        out = out.update(n, deref_cell(out.values[idx]));
      }
    }
  }
  return out;
}

// eval_call_arg evaluates argument k of a call to `callee`: at an out
// position, a celled variable is passed as its cell, so the callee's
// parameter shares it.
function eval_call_arg(arg: ast.Expr, callee: string, k: i32, env: Env): Value {
  if let ast.ExprIdent(id) = arg {
    if (util.has_str(env.outs.names, callee) && util.has_str(env.outs.keys, out_key(callee, k))) {
      let idx: i32 = env.raw_slot(id.name);
      if (idx >= 0) {
        if let VCellA(_) = env.values[idx] {
          return env.values[idx];
        }
      }
    }
  }
  return eval_expr(arg, env);
}

// store_out writes a builtin's filled array back through argument k, when that
// argument is a celled variable; any other argument had no holder to see it.
function store_out(args: Value[], k: i32, xs: i64[]): void {
  if (k < args.len()) {
    if let VCellA(ca) = args[k] {
      let old: i64[] = ca.c.get();
      if (xs.len() >= old.len()) {
        ca.c.set(xs);
        ca.length.set(xs.len());
      } else {
        let merged: i64[] = [];
        let i: i32 = 0;
        while (i < old.len()) {
          if (i < xs.len()) {
            merged = merged.append(xs[i]);
          } else {
            merged = merged.append(old[i]);
          }
          i = i + 1;
        }
        ca.c.set(merged);
      }
    }
  }
}

function bytes_as_i64s(b: u8[]): i64[] {
  let out: i64[] = [];
  for x in b {
    out = out.append(x as i64);
  }
  return out;
}

function i32s_as_i64s(b: i32[]): i64[] {
  let out: i64[] = [];
  for x in b {
    out = out.append(x as i64);
  }
  return out;
}

function is_cell(v: Value): boolean {
  match (v) {
    VCellI(_) => {
      return true;
    },
    VCellF(_) => {
      return true;
    },
    VCellV(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

// cell_for makes the by-reference binding for a capture: a scalar's own cell,
// VCellV for any other value the cell encoding holds, or `v` unchanged for one
// it does not (a function).
function cell_for(v: Value): Value {
  match (v) {
    VInt(n) => {
      return VCellI { c: cell_new(n.v), is_char: n.is_char, is_bool: false };
    },
    VBool(bb) => {
      if (bb.v) {
        return VCellI { c: cell_new(1), is_char: false, is_bool: true };
      }
      return VCellI { c: cell_new(0), is_char: false, is_bool: true };
    },
    VFloat(f) => {
      return VCellF { c: cell_new(f.v) };
    },
    VFunc(_) => {
      return v;
    },
    _ => {
      let (ok, text) = encoded_text(v);
      if (ok) {
        return VCellV { c: cell_new(text) };
      }
      return v;
    }
  }
}

// cell_value builds the program's cell over `v`, or an error for an element
// type E057 does not admit.
function cell_value(v: Value): Value {
  let c: VCell = VCell { kind: "", ci: cell_new(0), cl: cell_new(0 as i64), cf: cell_new(0.0), cs: cell_new("") };
  match (v) {
    VInt(n) => {
      c.ci.set(n.v);
      if (n.is_char) {
        return VCell { ...c, kind: "char" };
      }
      return VCell { ...c, kind: "i32" };
    },
    VUint(n) => {
      c.ci.set(n.v);
      return VCell { ...c, kind: "u32" };
    },
    VBool(bb) => {
      if (bb.v) {
        c.ci.set(1);
      }
      return VCell { ...c, kind: "bool" };
    },
    VInt64(n) => {
      c.cl.set(vint_as_i64(v));
      if (n.ptr) {
        return VCell { ...c, kind: "usize" };
      }
      if (n.unsigned) {
        return VCell { ...c, kind: "u64" };
      }
      return VCell { ...c, kind: "i64" };
    },
    VFloat(f) => {
      c.cf.set(f.v);
      return VCell { ...c, kind: "f64" };
    },
    VFloat32(f) => {
      c.cf.set(f.v);
      return VCell { ...c, kind: "f32" };
    },
    VString(sv) => {
      c.cs.set(sv.v);
      return VCell { ...c, kind: "string" };
    },
    _ => {
      let encoded: Value = cell_value_text(v);
      if let VString(s) = encoded {
        c.cs.set(s.v);
        return VCell { ...c, kind: "value" };
      }
      return encoded;
    }
  }
}

// A composite payload (array, tuple, map, struct or enum value) is held as
// text in the cell's string slot, so the interpreter stays buildable by a pin
// whose own E057 admits only scalar and string cells, and a read is a
// snapshot by construction. Compiled application cells hold the value itself.
//
// The encoding is a tag byte per value: a scalar's tag is followed by its bit
// pattern as 16 hex digits, which keeps unsigned and float identity exact; a
// string, and every name (an array's element type, a struct's type and field
// names), is a 16-digit length and its bytes; an array, tuple, map or struct
// gives its count and then its parts.
function cell_hex_text(h: usize, bits: i64): void {
  let digits: string = "0123456789abcdef";
  let shift: i32 = 60;
  while (shift >= 0) {
    let nibble: i32 = (bits >> shift as i64 & 15i64) as i32;
    buf_push_byte(h, digits[nibble] as i32);
    shift = shift - 4;
  }
}

function cell_bits_text(h: usize, tag: i32, bits: i64): void {
  buf_push_byte(h, tag);
  cell_hex_text(h, bits);
}

function cell_name_text(h: usize, s: string): void {
  cell_hex_text(h, s.len() as i64);
  buf_push(h, s);
}

function cell_scalar_text(h: usize, v: Value): boolean {
  match (v) {
    VInt(n) => {
      let tag: i32 = 105;
      if (n.is_char) {
        tag = 99;
      }
      cell_bits_text(h, tag, n.v as i64);
    },
    VUint(n) => {
      cell_bits_text(h, 110, uint_zext(n.v));
    },
    VInt64(n) => {
      let tag: i32 = 108;
      if (n.ptr) {
        tag = 122;
      } else if (n.unsigned) {
        tag = 117;
      }
      cell_bits_text(h, tag, vint_as_i64(v));
    },
    VBool(b) => {
      let bits: i64 = 0i64;
      if (b.v) {
        bits = 1i64;
      }
      cell_bits_text(h, 98, bits);
    },
    VFloat(f) => {
      cell_bits_text(h, 100, f64_bits(f.v));
    },
    VFloat32(f) => {
      cell_bits_text(h, 102, f32_bits(f.v as f32) as i64);
    },
    VString(sv) => {
      buf_push_byte(h, 115);
      cell_name_text(h, sv.v);
    },
    _ => {
      return false;
    }
  }
  return true;
}

// cell_parts_text writes `vs` after their count, or answers false at the first
// one that cannot be held.
function cell_parts_text(h: usize, vs: Value[]): boolean {
  cell_hex_text(h, vs.len() as i64);
  for v in vs {
    if (!cell_any_text(h, v)) {
      return false;
    }
  }
  return true;
}

function cell_any_text(h: usize, v: Value): boolean {
  match (v) {
    VArr(a) => {
      buf_push_byte(h, 97);
      cell_name_text(h, a.elem);
      return cell_parts_text(h, a.elements);
    },
    VTuple(t) => {
      buf_push_byte(h, 116);
      return cell_parts_text(h, t.elements);
    },
    VMap(m) => {
      buf_push_byte(h, 109);
      return cell_parts_text(h, m.keys) && cell_parts_text(h, m.values);
    },
    VStruct(st) => {
      // The enum a variant was built as and the type arguments a struct was
      // built at travel with it: dispatch and tyarg_of_value read them.
      buf_push_byte(h, 83);
      cell_name_text(h, st.type_name);
      cell_name_text(h, st.owner);
      cell_hex_text(h, st.targs.len() as i64);
      for ta in st.targs {
        cell_name_text(h, ta);
      }
      cell_hex_text(h, st.field_names.len() as i64);
      for name in st.field_names {
        cell_name_text(h, name);
      }
      return cell_parts_text(h, st.field_values);
    },
    _ => {
      return cell_scalar_text(h, v);
    }
  }
}

// encoded_text is v in the program cell's text encoding, and whether it has one:
// a function or a cell inside it has none.
function encoded_text(v: Value): (boolean, string) {
  let h: usize = buf_new(64);
  if (!cell_any_text(h, v)) {
    buf_free(h);
    return (false, "");
  }
  let text: string = buf_take(h);
  buf_free(h);
  return (true, text);
}

function cell_value_text(v: Value): Value {
  let (ok, text) = encoded_text(v);
  if (!ok) {
    return v_err("Cell: the value holds a function or a cell, which E057 rejects");
  }
  return v_string(text);
}

function cell_scalar_value(tag: i32, bits: i64): Value {
  if (tag == 105) {
    return v_int(bits as i32);
  }
  if (tag == 99) {
    return VInt { v: bits as i32, is_char: true };
  }
  if (tag == 110) {
    return VUint { v: bits as i32 };
  }
  if (tag == 122) {
    return v_usize(bits);
  }
  if (tag == 108 || tag == 117) {
    return VInt64 { hi: (bits >> 32i64) as i32, lo: bits as i32, unsigned: tag == 117, ptr: false };
  }
  if (tag == 98) {
    return v_bool(bits != 0i64);
  }
  if (tag == 100) {
    return v_float(f64_from_bits(bits));
  }
  return v_float32(f32_from_bits(bits as i32) as f64);
}

// The decoder reads `s` from the cursor `at`, advancing it past what it reads.
function cell_hex_value(s: string, at: Cell[i32]): i64 {
  let i: i32 = at.get();
  let bits: i64 = 0i64;
  let j: i32 = 0;
  while (j < 16) {
    let digit: i32 = s[i + j] as i32 - 48;
    if (digit > 9) {
      digit = digit - 39;
    }
    bits = bits << 4i64 | digit as i64;
    j = j + 1;
  }
  at.set(i + 16);
  return bits;
}

function cell_name_value(s: string, at: Cell[i32]): string {
  let n: i32 = cell_hex_value(s, at) as i32;
  let i: i32 = at.get();
  at.set(i + n);
  return slice_unchecked(s, i, i + n) + "";
}

function cell_parts_value(s: string, at: Cell[i32]): Value[] {
  let n: i32 = cell_hex_value(s, at) as i32;
  let out: Value[] = [];
  let k: i32 = 0;
  while (k < n) {
    out = out.append(cell_any_value(s, at));
    k = k + 1;
  }
  return out;
}

function cell_any_value(s: string, at: Cell[i32]): Value {
  let tag: i32 = s[at.get()] as i32;
  at.set(at.get() + 1);
  if (tag == 115) {
    return v_string(cell_name_value(s, at));
  }
  if (tag == 97) {
    let elem: string = cell_name_value(s, at);
    return v_arr_of(cell_parts_value(s, at), elem);
  }
  if (tag == 116) {
    return v_tuple(cell_parts_value(s, at));
  }
  if (tag == 109) {
    let keys: Value[] = cell_parts_value(s, at);
    return v_map(keys, cell_parts_value(s, at));
  }
  if (tag == 83) {
    let type_name: string = cell_name_value(s, at);
    let owner: string = cell_name_value(s, at);
    let nt: i32 = cell_hex_value(s, at) as i32;
    let targs: string[] = [];
    while (targs.len() < nt) {
      targs = targs.append(cell_name_value(s, at));
    }
    let n: i32 = cell_hex_value(s, at) as i32;
    let names: string[] = [];
    while (names.len() < n) {
      names = names.append(cell_name_value(s, at));
    }
    return VStruct { type_name: type_name, field_names: names, field_values: cell_parts_value(s, at), owner: owner, targs: targs };
  }
  return cell_scalar_value(tag, cell_hex_value(s, at));
}

function cell_set_value(c: VCell, v: Value): Value {
  if (c.kind == "value") {
    let encoded: Value = cell_value_text(v);
    if let VString(s) = encoded {
      c.cs.set(s.v);
      return v_void();
    }
    return encoded;
  }
  if ((c.kind == "i32" || c.kind == "u32" || c.kind == "char") && is_i32_arg(v)) {
    c.ci.set(vint_bits(v));
    return v_void();
  }
  if (c.kind == "bool") {
    match (v) {
      VBool(bb) => {
        if (bb.v) {
          c.ci.set(1);
        } else {
          c.ci.set(0);
        }
        return v_void();
      },
      _ => {}
    }
  }
  if ((c.kind == "i64" || c.kind == "u64" || c.kind == "usize") && is_int_like(v)) {
    c.cl.set(vint_as_i64(v));
    return v_void();
  }
  if (c.kind == "f64" && is_float_like(v)) {
    c.cf.set(vfloat_as_f64(v));
    return v_void();
  }
  if (c.kind == "f32" && is_float_like(v)) {
    c.cf.set(f32_round(vfloat_as_f64(v)));
    return v_void();
  }
  if (c.kind == "string") {
    match (v) {
      VString(sv) => {
        c.cs.set(sv.v);
        return v_void();
      },
      _ => {}
    }
  }
  return v_err("Cell.set: the value is not a " + c.kind);
}

function cell_method(c: VCell, name: string, args: Value[]): Value {
  if (name == "get") {
    if (args.len() != 0) {
      return v_err("Cell.get takes no arguments");
    }
    if (c.kind == "i32") {
      return v_int(c.ci.get());
    }
    if (c.kind == "char") {
      return VInt { v: c.ci.get(), is_char: true };
    }
    if (c.kind == "u32") {
      return v_uint(c.ci.get());
    }
    if (c.kind == "bool") {
      return v_bool(c.ci.get() != 0);
    }
    if (c.kind == "i64") {
      return v_int64(c.cl.get());
    }
    if (c.kind == "u64") {
      return v_uint64(c.cl.get());
    }
    if (c.kind == "usize") {
      return v_usize(c.cl.get());
    }
    if (c.kind == "f64") {
      return VFloat { v: c.cf.get() };
    }
    if (c.kind == "f32") {
      return v_float32(c.cf.get());
    }
    if (c.kind == "value") {
      return cell_any_value(c.cs.get(), cell_new(0));
    }
    return v_string(c.cs.get());
  }
  if (name == "set") {
    if (args.len() != 1) {
      return v_err("Cell.set takes exactly 1 argument");
    }
    return cell_set_value(c, args[0]);
  }
  return v_err("undefined method `" + name + "` on `Cell`");
}

function byte_array_value(bytes: u8[]): Value {
  let out: Value[] = [];
  let i: i32 = 0;
  while (i < bytes.len()) {
    out = out.append(v_int(bytes[i] as i32));
    i = i + 1;
  }
  return v_arr_of(out, "u8");
}

function call_xattr(name: string, args: Value[]): Value {
  let reading: boolean = name == "getxattr" || name == "lgetxattr" || name == "getxattr_bytes" || name == "lgetxattr_bytes";
  let count: i32 = 3;
  if (reading) {
    count = 2;
  }
  if (args.len() != count) {
    return v_err(name + ": wrong argument count");
  }
  if (!is_string_arg(args[0]) || !is_string_arg(args[1])) {
    return v_err(name + ": expected path and attribute name strings");
  }
  let path: string = vstr_of(args[0]);
  let attr: string = vstr_of(args[1]);
  let follow: boolean = name[0] != 108 as u8;
  if (reading) {
    if (name == "getxattr_bytes" || name == "lgetxattr_bytes") {
      let result: Result[u8[], IoError] = Err(Unsupported);
      if (follow) {
        result = getxattr_bytes(path, attr);
      } else {
        result = lgetxattr_bytes(path, attr);
      }
      match (result) {
        Ok(bytes) => {
          return v_variant("Ok", [byte_array_value(bytes)]);
        },
        Err(e) => {
          return v_variant("Err", [io_error_value(e)]);
        }
      }
    }
    let result: Result[string, IoError] = Err(Unsupported);
    if (follow) {
      result = getxattr(path, attr);
    } else {
      result = lgetxattr(path, attr);
    }
    match (result) {
      Ok(text) => {
        return v_variant("Ok", [v_string(text)]);
      },
      Err(e) => {
        return v_variant("Err", [io_error_value(e)]);
      }
    }
  }
  let result: Result[void, IoError] = Err(Unsupported);
  if (name == "setxattr_bytes" || name == "lsetxattr_bytes") {
    if let VArr(a) = args[2] {
      let bytes: u8[] = __alloc_u8(a.elements.len());
      let i: i32 = 0;
      while (i < a.elements.len()) {
        if (!is_i32_arg(a.elements[i])) {
          return v_err(name + ": expected byte array");
        }
        bytes = bytes.with(i, vint_bits(a.elements[i]) as u8);
        i = i + 1;
      }
      if (follow) {
        result = setxattr_bytes(path, attr, bytes);
      } else {
        result = lsetxattr_bytes(path, attr, bytes);
      }
    } else {
      return v_err(name + ": expected byte array");
    }
  } else {
    if (!is_string_arg(args[2])) {
      return v_err(name + ": expected string value");
    }
    let text: string = vstr_of(args[2]);
    if (follow) {
      result = setxattr(path, attr, text);
    } else {
      result = lsetxattr(path, attr, text);
    }
  }
  match (result) {
    Ok(_) => {
      return v_variant("Ok", [v_tuple([])]);
    },
    Err(e) => {
      return v_variant("Err", [io_error_value(e)]);
    }
  }
}

// The interpreted program's Result[void, IoError] for a host handle call,
// from the host outcome's `.failure()`.
function io_failure_value(error: Option[IoError]): Value {
  match (error) {
    Some(e) => {
      return io_err_value(e);
    },
    None => {
      return ok_value(v_tuple([]));
    }
  }
}

function i64_result_value(result: Result[i64, IoError]): Value {
  match (result) {
    Ok(n) => {
      return v_variant("Ok", [box_i64(n)]);
    },
    Err(e) => {
      return v_variant("Err", [io_error_value(e)]);
    }
  }
}

function option_string_value(o: Option[string]): Value {
  match (o) {
    Some(line) => {
      return v_variant("Some", [v_string(line)]);
    },
    None => {
      let none: Value[] = [];
      return v_variant("None", none);
    }
  }
}

// io_error_value is the program's view of a host IoError: the same variant,
// its payloads carried over.
function io_error_value(e: IoError): Value {
  let none: Value[] = [];
  match (e) {
    NotFound(p) => {
      return v_variant_of("IoError", "NotFound", [v_string(p)]);
    },
    PermissionDenied(p) => {
      return v_variant_of("IoError", "PermissionDenied", [v_string(p)]);
    },
    AlreadyExists(p) => {
      return v_variant_of("IoError", "AlreadyExists", [v_string(p)]);
    },
    InvalidUtf8(p) => {
      return v_variant_of("IoError", "InvalidUtf8", [v_string(p)]);
    },
    Interrupted => {
      return v_variant_of("IoError", "Interrupted", none);
    },
    Unsupported => {
      return v_variant_of("IoError", "Unsupported", none);
    },
    Other(p, m, n) => {
      return v_variant_of("IoError", "Other", [v_string(p), v_string(m), v_int(n)]);
    }
  }
}

// =================== HOST BUILTINS ====================
//
// A builtin that reaches the host — a file, a socket, a clock, a signal, the
// process — is answered by calling the same builtin. The interpreter is itself
// a compiled Fern program, so the call is the one the interpreted program
// asked for, made one level up with its arguments unboxed and its answer
// boxed, and the program sees what a build for this host would.
//
// Where the Go interpreter keeps a contract of its own, this one keeps it too:
// it never forks or execs (proc_fork and proc_exec answer -ENOSYS, the waits
// -ECHILD), never rewinds the arena it runs on, keeps every wait on the
// reactor (ring_* and tcp_ktls answer -ENOSYS), cannot splice, and has no
// address space to give the raw syscall and C-call floor.
//
// The playground runs this interpreter as a wasi preview-1 core module. A
// builtin that build cannot reach is kept out of it behind a literal
// target_arch() test, which constant folding prunes, and refused there at run
// time.

function arg_at(args: Value[], i: i32): Value {
  if (i < args.len()) {
    return deref_cell(args[i]);
  }
  return v_absent();
}

function arg_str(args: Value[], i: i32): string {
  return vstr_of(arg_at(args, i));
}

function arg_i32(args: Value[], i: i32): i32 {
  return vint_as_i64(arg_at(args, i)) as i32;
}

function arg_i64(args: Value[], i: i32): i64 {
  return vint_as_i64(arg_at(args, i));
}

function arg_bool(args: Value[], i: i32): boolean {
  if let VBool(b) = arg_at(args, i) {
    return b.v;
  }
  return false;
}

function arg_bytes(args: Value[], i: i32): u8[] {
  let out: u8[] = [];
  if let VArr(a) = arg_at(args, i) {
    for e in a.elements {
      out = out.append(vint_as_i64(e) as u8);
    }
  }
  return out;
}

function arg_i32s(args: Value[], i: i32): i32[] {
  let out: i32[] = [];
  if let VArr(a) = arg_at(args, i) {
    for e in a.elements {
      out = out.append(vint_as_i64(e) as i32);
    }
  }
  return out;
}

function arg_i64s(args: Value[], i: i32): i64[] {
  let out: i64[] = [];
  if let VArr(a) = arg_at(args, i) {
    for e in a.elements {
      out = out.append(vint_as_i64(e));
    }
  }
  return out;
}

function arg_strs(args: Value[], i: i32): string[] {
  let out: string[] = [];
  if let VArr(a) = arg_at(args, i) {
    for e in a.elements {
      out = out.append(vstr_of(e));
    }
  }
  return out;
}

function string_array_value(xs: string[]): Value {
  let out: Value[] = [];
  for x in xs {
    out = out.append(v_string(x));
  }
  return v_arr_of(out, "string");
}

function i64_array_value(xs: i64[]): Value {
  let out: Value[] = [];
  for x in xs {
    out = out.append(v_int64(x));
  }
  return v_arr_of(out, "i64");
}

function ok_value(v: Value): Value {
  return v_variant("Ok", [v]);
}

function io_err_value(e: IoError): Value {
  return v_variant("Err", [io_error_value(e)]);
}

function void_result_value(r: Result[void, IoError]): Value {
  match (r) {
    Ok(_) => {
      return ok_value(v_tuple([]));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function string_result_value(r: Result[string, IoError]): Value {
  match (r) {
    Ok(s) => {
      return ok_value(v_string(s));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function bytes_result_value(r: Result[u8[], IoError]): Value {
  match (r) {
    Ok(b) => {
      return ok_value(byte_array_value(b));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function strings_result_value(r: Result[string[], IoError]): Value {
  match (r) {
    Ok(xs) => {
      return ok_value(string_array_value(xs));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function i64s_result_value(r: Result[i64[], IoError]): Value {
  match (r) {
    Ok(xs) => {
      return ok_value(i64_array_value(xs));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function file_stat_value(st: FileStat): Value {
  return v_struct(
    "FileStat", ["is_file", "is_dir", "size", "mode", "nlink", "uid", "gid", "dev", "rdev", "ino", "blksize", "blocks", "atime", "atime_nsec", "mtime", "mtime_nsec", "ctime", "ctime_nsec", "btime", "btime_nsec"],
    [
      v_bool(st.is_file), v_bool(st.is_dir), v_int64(st.size), v_uint(st.mode as i32), v_uint(st.nlink as i32), v_uint(st.uid as i32), v_uint(st.gid as i32),
      v_int64(st.dev), v_int64(st.rdev), v_int64(st.ino), v_int64(st.blksize), v_int64(st.blocks), v_int64(st.atime), v_int64(st.atime_nsec),
      v_int64(st.mtime), v_int64(st.mtime_nsec), v_int64(st.ctime), v_int64(st.ctime_nsec), v_int64(st.btime), v_int64(st.btime_nsec),
    ],
  );
}

function stat_result_value(r: Result[FileStat, IoError]): Value {
  match (r) {
    Ok(st) => {
      return ok_value(file_stat_value(st));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function dir_entries_result_value(r: Result[DirEntry[], IoError]): Value {
  match (r) {
    Ok(es) => {
      let out: Value[] = [];
      for de in es {
        out = out.append(v_struct("DirEntry", ["name", "ino", "kind"], [v_string(de.name), v_int64(de.ino), v_uint(de.kind as i32)]));
      }
      return ok_value(v_arr_of(out, "DirEntry"));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function fs_stat_result_value(r: Result[FsStat, IoError]): Value {
  match (r) {
    Ok(f) => {
      return ok_value(v_struct(
        "FsStat", ["block_size", "blocks", "blocks_free", "blocks_avail", "files", "files_free", "name_max", "path_max", "fs_type", "fsid", "frag_size", "fs_type_name"],
        [
          v_int64(f.block_size), v_int64(f.blocks), v_int64(f.blocks_free), v_int64(f.blocks_avail), v_int64(f.files), v_int64(f.files_free),
          v_int64(f.name_max), v_int64(f.path_max), v_int64(f.fs_type), v_int64(f.fsid), v_int64(f.frag_size), v_string(f.fs_type_name),
        ],
      ));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function mounts_result_value(r: Result[MountEntry[], IoError]): Value {
  match (r) {
    Ok(ms) => {
      let out: Value[] = [];
      for m in ms {
        out = out.append(v_struct("MountEntry", ["source", "target", "fstype", "dev"], [v_string(m.source), v_string(m.target), v_string(m.fstype), v_int64(m.dev)]));
      }
      return ok_value(v_arr_of(out, "MountEntry"));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function win_size_result_value(r: Result[WinSize, IoError]): Value {
  match (r) {
    Ok(ws) => {
      return ok_value(v_struct("WinSize", ["rows", "cols"], [v_int64(ws.rows), v_int64(ws.cols)]));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function reader_value(r: Reader): Value {
  return VHandle { r: Some(r), w: None, d: None };
}

function writer_value(w: Writer): Value {
  return VHandle { r: None, w: Some(w), d: None };
}

function reader_result_value(r: Result[Reader, IoError]): Value {
  match (r) {
    Ok(h) => {
      return ok_value(reader_value(h));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function writer_result_value(r: Result[Writer, IoError]): Value {
  match (r) {
    Ok(h) => {
      return ok_value(writer_value(h));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function dir_result_value(r: Result[Dir, IoError]): Value {
  match (r) {
    Ok(h) => {
      return ok_value(VHandle { r: None, w: None, d: Some(h) });
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function pipe_result_value(r: Result[Pipe, IoError]): Value {
  match (r) {
    Ok(p) => {
      return ok_value(v_struct("Pipe", ["r", "w"], [reader_value(p.r), writer_value(p.w)]));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

// handle_kind names a handle's type, the receiver its methods are declared on.
function handle_kind(h: VHandle): string {
  match (h.r) {
    Some(_) => {
      return "Reader";
    },
    None => {}
  }
  match (h.w) {
    Some(_) => {
      return "Writer";
    },
    None => {}
  }
  return "Dir";
}

// handle_fd is the descriptor a handle's one public field reports.
function handle_fd(h: VHandle): Value {
  match (h.r) {
    Some(r) => {
      return v_int(r.fd);
    },
    None => {}
  }
  match (h.w) {
    Some(w) => {
      return v_int(w.fd);
    },
    None => {}
  }
  match (h.d) {
    Some(d) => {
      return v_int(d.fd);
    },
    None => {}
  }
  return v_err("empty host handle");
}

// enosys_errno is ENOSYS in this host's numbering.
function enosys_errno(): i32 {
  if (target_os() == "darwin") {
    return 78;
  }
  if (target_arch() == "wasm32") {
    return 52;
  }
  return 38;
}

function host_enosys(): Value {
  return v_int(0 - enosys_errno());
}

// enosys_error is the Err of a call the interpreter refuses to make.
function enosys_error(path: string): Value {
  return io_err_value(Other(path, "Function not implemented", enosys_errno()));
}

// call_host answers a host builtin, or reports `name` undefined. The
// classification in platforms.fern routes it: the capability says both which
// family it belongs to and whether the playground's wasm32-wasi build may
// reach it.
function call_host(name: string, args: Value[]): Value {
  if (is_raw_floor(name)) {
    return v_err(name + " takes machine addresses, and the interpreter has no address space");
  }
  let cap: string = platforms.gated_capability(name);
  let contract: Value = call_host_contract(name, args);
  if (!is_err(contract)) {
    return contract;
  }
  if (playground_provides(name, cap)) {
    return call_host_portable(name, cap, args);
  }
  if (target_arch() == "wasm32") {
    return v_err(name + ": the playground this interpreter runs in does not provide it");
  } else {
    return call_host_native(name, cap, args);
  }
}

// playground_provides reports whether the playground's build of this
// interpreter, a wasi preview-1 core module, can answer a builtin: its
// capability is wasm32-wasi's, and it reaches no socket or pollable, which
// preview 1 has none of.
function playground_provides(name: string, cap: string): boolean {
  if (cap.len() > 0 && !platforms.has_capability("wasm32-wasi", cap)) {
    return false;
  }
  return !util.has_str(["tcp", "reactor"], cap) && !util.has_str(["poll", "sleep_ms", "sleep_ns"], name);
}

// is_raw_floor reports the syscall, C-call and raw-memory floor, whose
// operands are machine words and addresses among them.
function is_raw_floor(name: string): boolean {
  return util.has_str(["__syscall3", "__syscall4", "__syscall5", "__syscall6"], name)
    || util.has_str(["__c_call0", "__c_call0_f32", "__c_call0_f64", "__c_call1", "__c_call1_f32", "__c_call1_f64", "__c_call2", "__c_call2_f32", "__c_call2_f64"], name)
    || util.has_str(["__c_call3", "__c_call3_f32", "__c_call3_f64", "__c_call4", "__c_call4_f32", "__c_call4_f64"], name)
    || util.has_str(["__raw_alloc", "__raw_string", "__raw_arr_box", "__raw_scratch", "__raw_environ", "__raw_splice_pipe", "__raw_cover", "__raw_task_state", "__raw_vdso", "__raw_vg_request"], name);
}

// call_runtime_intrinsic answers the compiled runtime's own intrinsics as
// internal/oracle/interp does. There are no refcounts, arena or copy-on-append
// cliff here, so each counter reads as a clean run's; no task is ever current,
// so the task primitives give the blocking fallback's answers; and the f64
// primitives and the map seed are this process's own.
function call_runtime_intrinsic(name: string, args: Value[]): Value {
  if (typeinfo.lane_builtin_width(name) > 0) {
    return call_lane_builtin(name, typeinfo.lane_builtin_width(name), args);
  }
  if (util.has_str(["__rc_underflow_count", "__arr_push_shared_count", "__arr_push_shared_bytes", "__heap_alloc_count", "__heap_bump_bytes"], name)) {
    return v_int(0);
  }
  if (name == "__map_hash_seed") {
    return v_int(__map_hash_seed());
  }
  if (util.has_str(["__sqrt_f64", "__floor_f64", "__ceil_f64", "__round_f64", "__trunc_f64", "__abs_f64"], name)) {
    if (args.len() != 1 || !is_float_like(args[0])) {
      return v_err(name + ": expected 1 float arg");
    }
    return v_float(f64_primitive(name, vfloat_as_f64(args[0])));
  }
  if (util.has_str(["__task_free", "__task_enter", "__task_set_ready", "__task_set_cancelled"], name)) {
    return v_void();
  }
  if (util.has_str(["__task_cur", "__task_leave", "__task_cancelled"], name)) {
    return v_int(0);
  }
  if (util.has_str(["__task_park", "__task_timeout"], name)) {
    return v_int(0 - 1);
  }
  if (name == "__task_new") {
    return v_int(1);
  }
  if (name == "__task_wait") {
    return v_arr([]);
  }
  return v_err("not a runtime intrinsic");
}

// ---- lane values (docs/SIMD-GENERIC-KERNELS.md §6) ----

// lane_bits is the bits of `x` as a lane of `width`: an f32 lane rounds to
// single precision and keeps its bits in the low 32.
function lane_bits(width: i32, x: f64): i64 {
  if (width == 32) {
    return f32_bits(x as f32) as i64 & 4294967295;
  }
  return f64_bits(x);
}

// lane_at reads lane `i` of `l` as a float.
function lane_at(l: VLanes, i: i32): f64 {
  if (l.width == 32) {
    return f32_from_bits(l.bits[i] as i32) as f64;
  }
  return f64_from_bits(l.bits[i]);
}

// lane_round is `x` at the lane width.
function lane_round(width: i32, x: f64): f64 {
  if (width == 32) {
    return (x as f32) as f64;
  }
  return x;
}

function lane_sign(width: i32): i64 {
  if (width == 32) {
    return 2147483648;
  }
  return 0 - 9223372036854775807 - 1;
}

function lanes_splat(width: i32, x: f64): Value {
  let bits: i64[] = [];
  while (bits.len() < 128 / width) {
    bits = bits.append(lane_bits(width, x));
  }
  return VLanes { width: width, bits: bits };
}

// lanes_map_bits gives each lane's bits flipped by `flip` and with `clear`
// cleared: negation flips the sign bit, and abs clears it.
function lanes_map_bits(l: VLanes, flip: i64, clear: i64): Value {
  let bits: i64[] = [];
  for b in l.bits {
    bits = bits.append((b ^ flip) & (clear ^ 0 - 1));
  }
  return VLanes { width: l.width, bits: bits };
}

// lane_arith is one lane of `+ - * /`. Both operands are exact at the lane
// width, so the f64 operation rounded once to an f32 lane is the single
// precision result.
function lane_arith(op: string, x: f64, y: f64): f64 {
  if (op == "+") {
    return x + y;
  }
  if (op == "-") {
    return x - y;
  }
  if (op == "*") {
    return x * y;
  }
  return x / y;
}

// lanes_binary evaluates `+ - * /` over two values of one lane type.
function lanes_binary(op: string, a: VLanes, rv: Value): Value {
  if let VLanes(b) = rv {
    if (util.has_str(["+", "-", "*", "/"], op)) {
      let bits: i64[] = [];
      let i: i32 = 0;
      while (i < a.bits.len()) {
        bits = bits.append(lane_bits(a.width, lane_arith(op, lane_at(a, i), lane_at(b, i))));
        i = i + 1;
      }
      return VLanes { width: a.width, bits: bits };
    }
  }
  return v_err("operator `" + op + "` on lane values");
}

// lane_value is lane `i` of `l` as a float value of the lane width.
function lane_value(l: VLanes, i: i32): Value {
  if (l.width == 32) {
    return v_float32(lane_at(l, i));
  }
  return v_float(lane_at(l, i));
}

// lane_args is `args` as lane values, empty when one is not.
function lane_args(args: Value[]): VLanes[] {
  let out: VLanes[] = [];
  for a in args {
    if let VLanes(l) = a {
      out = out.append(l);
    } else {
      return [];
    }
  }
  return out;
}

// lane_fn is one lane of a lane builtin over lane operands: `xs` holds each
// operand's lane. `min` and `max` are `b < a ? b : a` and `a < b ? b : a`,
// the order the IR's vmin and vmax define, and `mul_add` is unfused, as the
// scalar mul_add: the product rounds before the add.
function lane_fn(verb: string, width: i32, xs: f64[]): f64 {
  if (verb == "sqrt" || verb == "floor" || verb == "round") {
    return f64_primitive("__" + verb + "_f64", xs[0]);
  }
  if (verb == "mul_add") {
    return lane_round(width, lane_round(width, xs[0] * xs[1]) + xs[2]);
  }
  if (verb == "min" && xs[1] < xs[0] || verb == "max" && xs[0] < xs[1]) {
    return xs[1];
  }
  return xs[0];
}

// lanes_apply maps lane_fn over the lanes of `ls`.
function lanes_apply(verb: string, ls: VLanes[]): Value {
  let w: i32 = ls[0].width;
  let bits: i64[] = [];
  let i: i32 = 0;
  while (i < ls[0].bits.len()) {
    let xs: f64[] = [];
    for l in ls {
      xs = xs.append(lane_at(l, i));
    }
    bits = bits.append(lane_bits(w, lane_fn(verb, w, xs)));
    i = i + 1;
  }
  return VLanes { width: w, bits: bits };
}

// lanes_mask is the lt or ne mask of `a` and `b`: all ones where it holds.
function lanes_mask(verb: string, a: VLanes, b: VLanes): Value {
  let ones: i64 = 0 - 1;
  if (a.width == 32) {
    ones = 4294967295;
  }
  let bits: i64[] = [];
  let i: i32 = 0;
  while (i < a.bits.len()) {
    let x: f64 = lane_at(a, i);
    let y: f64 = lane_at(b, i);
    let hold: boolean = verb == "lt" && x < y || verb == "ne" && x != y;
    bits = bits.append(if (hold) { ones } else { 0 });
    i = i + 1;
  }
  return VLanes { width: a.width, bits: bits };
}

// lanes_select takes a's bits where the mask is set and b's elsewhere.
function lanes_select(ls: VLanes[]): Value {
  let bits: i64[] = [];
  let i: i32 = 0;
  while (i < ls[0].bits.len()) {
    let m: i64 = ls[2].bits[i];
    bits = bits.append(ls[0].bits[i] & m | ls[1].bits[i] & (m ^ 0 - 1));
    i = i + 1;
  }
  return VLanes { width: ls[0].width, bits: bits };
}

// lanes_of builds a lane value from one float per lane.
function lanes_of(width: i32, args: Value[]): Value {
  if (args.len() != 128 / width) {
    return v_err("lane builtin: expected one float per lane");
  }
  let bits: i64[] = [];
  for a in args {
    bits = bits.append(lane_bits(width, vfloat_as_f64(a)));
  }
  return VLanes { width: width, bits: bits };
}

// lane_window is the first index of the lanes a `load` or `with` at args[1]
// covers in the array args[0], or -1 when the array does not hold them all.
function lane_window(width: i32, args: Value[]): i32 {
  if let VArr(a) = args[0] {
    let at: i32 = vint_as_i64(args[1]) as i32;
    if (at >= 0 && at + 128 / width <= a.elements.len()) {
      return at;
    }
  }
  return 0 - 1;
}

// lanes_load reads the lanes from the array at the index.
function lanes_load(width: i32, args: Value[]): Value {
  let at: i32 = lane_window(width, args);
  if (at < 0) {
    return v_err("lane load out of bounds");
  }
  if let VArr(a) = args[0] {
    let xs: Value[] = [];
    while (xs.len() < 128 / width) {
      xs = xs.append(a.elements[at + xs.len()]);
    }
    return lanes_of(width, xs);
  }
  return v_err("lane load: expected an array");
}

// lanes_with is the array with the lanes written at the index.
function lanes_with(width: i32, args: Value[]): Value {
  let at: i32 = lane_window(width, args);
  let ls: VLanes[] = lane_args([args[2]]);
  if (at < 0 || ls.len() != 1) {
    return v_err("lane with out of bounds");
  }
  if let VArr(a) = args[0] {
    let out: Value[] = a.elements;
    let i: i32 = 0;
    while (i < ls[0].bits.len()) {
      out = out.with(at + i, lane_value(ls[0], i));
      i = i + 1;
    }
    return VArr { ...a, elements: out };
  }
  return v_err("lane with: expected an array");
}

// call_lane_builtin evaluates the lane builtin `name` of element width
// `width` (typeinfo.lane_builtin_params has the signatures).
function call_lane_builtin(name: string, width: i32, args: Value[]): Value {
  let verb: string = typeinfo.lane_builtin_verb(name);
  if (verb == "splat" && args.len() == 1) {
    return lanes_splat(width, vfloat_as_f64(args[0]));
  }
  if (verb == "of") {
    return lanes_of(width, args);
  }
  if (verb == "load" && args.len() == 2) {
    return lanes_load(width, args);
  }
  if (verb == "with" && args.len() == 3) {
    return lanes_with(width, args);
  }
  return call_lane_op(verb, width, args);
}

// call_lane_read is `lane`: lane args[1] of the lane value args[0].
function call_lane_read(width: i32, args: Value[]): Value {
  let ls: VLanes[] = lane_args([args[0]]);
  let i: i32 = vint_as_i64(args[1]) as i32;
  if (ls.len() == 1 && i >= 0 && i < 128 / width) {
    return lane_value(ls[0], i);
  }
  return v_err("lane: expected a lane value and an index below the lane count");
}

// call_lane_op evaluates a lane builtin whose operands are lane values, and
// `lane` through call_lane_read.
function call_lane_op(verb: string, width: i32, args: Value[]): Value {
  if (verb == "lane" && args.len() == 2) {
    return call_lane_read(width, args);
  }
  let ls: VLanes[] = lane_args(args);
  if (ls.len() == 0 || ls.len() != args.len()) {
    return v_err("lane builtin: expected lane operands");
  }
  if (verb == "bitmask" && ls.len() == 1) {
    let mask: i32 = 0;
    let k: i32 = 0;
    while (k < ls[0].bits.len()) {
      if ((ls[0].bits[k] & lane_sign(width)) != 0) {
        mask = mask | 1 << k;
      }
      k = k + 1;
    }
    return v_int(mask);
  }
  if (verb == "abs") {
    return lanes_map_bits(ls[0], 0, lane_sign(width));
  }
  if ((verb == "lt" || verb == "ne") && ls.len() == 2) {
    return lanes_mask(verb, ls[0], ls[1]);
  }
  if (verb == "select" && ls.len() == 3) {
    return lanes_select(ls);
  }
  return lanes_apply(verb, ls);
}

function f64_primitive(name: string, x: f64): f64 {
  if (name == "__sqrt_f64") {
    return __sqrt_f64(x);
  }
  if (name == "__floor_f64") {
    return __floor_f64(x);
  }
  if (name == "__ceil_f64") {
    return __ceil_f64(x);
  }
  if (name == "__round_f64") {
    return __round_f64(x);
  }
  if (name == "__trunc_f64") {
    return __trunc_f64(x);
  }
  return __abs_f64(x);
}

// call_host_contract answers the builtins whose interpreter answer is fixed
// rather than the host's, or an error for any other name. The interpreter is
// the compiler's own process: a chroot or a dropped id would outlast the
// program and confine or demote the compiler, so those are refused too.
function call_host_contract(name: string, args: Value[]): Value {
  if (name == "__heap_mark") {
    return v_int64(0);
  }
  if (name == "__heap_release_to") {
    return v_void();
  }
  if (util.has_str(["proc_fork", "proc_exec", "proc_exec_as"], name)) {
    return v_int(0 - 38);
  }
  if (name == "chroot") {
    return enosys_error(arg_str(args, 0));
  }
  if (util.has_str(["setuid", "setgid", "setgroups"], name)) {
    return enosys_error("");
  }
  if (util.has_str(["proc_waitpid", "proc_waitpid_nohang", "proc_waitpid_status"], name)) {
    return v_int(0 - 10);
  }
  if (util.has_str(["ring_new", "ring_ctl", "ring_wait", "ring_recv", "ring_send_zc", "tcp_ktls"], name)) {
    return host_enosys();
  }
  return call_host_stub(name);
}

// call_host_stub answers the builtins with no host behind them here.
function call_host_stub(name: string): Value {
  // No pollable is ever real here, so none is ever ready.
  if (util.has_str(["wasm_poll", "wasm_timer_pollable"], name)) {
    return v_int(0 - 1);
  }
  if (util.has_str(["wasm_block", "wasm_pollable_drop"], name)) {
    return v_int(0);
  }
  // No account database: 0 says use the files.
  if (name == "__account_entry") {
    return v_uint64(0);
  }
  return v_err("not a contract builtin");
}

// call_host_portable answers a builtin every host this interpreter runs on
// provides, wasm32-wasi included.
function call_host_portable(name: string, cap: string, args: Value[]): Value {
  if (cap == "fs") {
    return call_host_fs(name, args);
  }
  if (cap == "now") {
    return call_host_clock(name, args);
  }
  if (cap == "signal") {
    return call_host_signal(name, args);
  }
  if (cap == "stdin" || cap == "stdout") {
    return call_host_stdio(name, args);
  }
  return call_host_process(name, args);
}

function call_host_stdio(name: string, args: Value[]): Value {
  if (name == "stdin") {
    return reader_value(stdin());
  }
  if (name == "stdout") {
    return writer_value(stdout());
  }
  if (name == "stderr") {
    return writer_value(stderr());
  }
  return v_err("undefined function: " + name);
}

// call_host_process answers the process's own surroundings: its argv and
// environment, entropy, its name, its exit, and the descriptor questions every
// target answers.
function call_host_process(name: string, vals: Value[]): Value {
  if (name == "args") {
    return string_array_value(args());
  }
  if (name == "set_args") {
    set_args(arg_strs(vals, 0));
    return v_void();
  }
  if (name == "env" || name == "config_get") {
    return option_string_value(env(arg_str(vals, 0)));
  }
  if (name == "environ") {
    return string_array_value(environ());
  }
  if (name == "hostname") {
    return v_string(hostname());
  }
  if (name == "random_bytes") {
    return byte_array_value(random_bytes(arg_i32(vals, 0)));
  }
  if (name == "random_i32") {
    return v_int(random_i32());
  }
  return call_host_core(name, vals);
}

function call_host_core(name: string, args: Value[]): Value {
  if (name == "exit") {
    exit(arg_i32(args, 0));
    return v_void();
  }
  if (name == "isatty") {
    return v_bool(isatty(arg_i32(args, 0)));
  }
  return v_err("undefined function: " + name);
}

// call_host_wait answers the waits: on a descriptor, and for a while.
function call_host_wait(name: string, args: Value[]): Value {
  if (name == "poll") {
    return v_int(poll(arg_i32s(args, 0), arg_i32(args, 1)));
  }
  if (name == "sleep_ms") {
    sleep_ms(arg_i64(args, 0));
    return v_void();
  }
  if (name == "sleep_ns") {
    sleep_ns(arg_i64(args, 0));
    return v_void();
  }
  return v_err("undefined function: " + name);
}

function call_host_clock(name: string, args: Value[]): Value {
  if (name == "now_unix_ms") {
    return v_int64(now_unix_ms());
  }
  if (name == "now_ns") {
    return v_int64(now_ns());
  }
  if (name == "monotonic_ns") {
    return v_int64(monotonic_ns());
  }
  if (name == "clock_resolution") {
    return v_int64(clock_resolution());
  }
  if (name == "clock_set") {
    return void_result_value(clock_set(arg_i64(args, 0), arg_i64(args, 1)));
  }
  return v_err("undefined function: " + name);
}

function call_host_signal(name: string, args: Value[]): Value {
  let sig: i32 = arg_i32(args, 0);
  if (name == "signal_ignore") {
    return v_int(signal_ignore(sig));
  }
  if (name == "signal_default") {
    return v_int(signal_default(sig));
  }
  if (name == "signal_catch") {
    return v_int(signal_catch(sig));
  }
  if (name == "signal_catch_interrupting") {
    return v_int(signal_catch_interrupting(sig));
  }
  if (name == "signal_disposition") {
    return v_int(signal_disposition(sig));
  }
  if (name == "signal_raise") {
    return v_int(signal_raise(sig));
  }
  if (name == "signal_taken") {
    return v_bool(signal_taken(sig));
  }
  if (name == "signal_mask") {
    return v_int64(signal_mask(sig, arg_i64(args, 1)));
  }
  return v_err("undefined function: " + name);
}

function call_host_reactor(name: string, args: Value[]): Value {
  if (name == "reactor_new") {
    return v_int(reactor_new());
  }
  if (name == "reactor_ctl") {
    return v_int(reactor_ctl(arg_i32(args, 0), arg_i32(args, 1), arg_i32(args, 2), arg_i32(args, 3)));
  }
  if (name == "reactor_wait") {
    let events: i32[] = arg_i32s(args, 1);
    let n: i32 = reactor_wait(arg_i32(args, 0), events, arg_i32(args, 2));
    store_out(args, 1, i32s_as_i64s(events));
    return v_int(n);
  }
  return v_err("undefined function: " + name);
}

function call_host_fs(name: string, args: Value[]): Value {
  if (util.has_str(["remove_file", "remove_dir", "remove_dir_all", "create_dir_all"], name)) {
    return call_host_fs_path(name, arg_str(args, 0));
  }
  if (util.has_str(["create_link", "clone_file", "create_symlink", "rename"], name)) {
    return call_host_fs_paths(name, arg_str(args, 0), arg_str(args, 1));
  }
  if (util.has_str(["open_reader", "open_writer", "open_appender", "open_exclusive", "open_reader_with", "open_writer_with"], name)) {
    return call_host_open(name, args);
  }
  if (util.has_str(["write_file", "write_file_bytes", "create_dir", "truncate", "set_file_times"], name)) {
    return call_host_fs_write(name, args);
  }
  return call_host_fs_read(name, arg_str(args, 0));
}

function call_host_fs_path(name: string, path: string): Value {
  if (name == "remove_file") {
    return void_result_value(remove_file(path));
  }
  if (name == "remove_dir") {
    return void_result_value(remove_dir(path));
  }
  if (name == "remove_dir_all") {
    return void_result_value(remove_dir_all(path));
  }
  return void_result_value(create_dir_all(path));
}

function call_host_fs_paths(name: string, from: string, to: string): Value {
  if (name == "create_link") {
    return void_result_value(create_link(from, to));
  }
  if (name == "clone_file") {
    return void_result_value(clone_file(from, to));
  }
  if (name == "create_symlink") {
    return void_result_value(create_symlink(from, to));
  }
  return void_result_value(rename(from, to));
}

function call_host_open(name: string, args: Value[]): Value {
  let path: string = arg_str(args, 0);
  if (name == "open_reader") {
    return reader_result_value(open_reader(path));
  }
  if (name == "open_reader_with") {
    return reader_result_value(open_reader_with(path, arg_i32(args, 1)));
  }
  if (name == "open_writer") {
    return writer_result_value(open_writer(path));
  }
  if (name == "open_writer_with") {
    return writer_result_value(open_writer_with(path, arg_i32(args, 1)));
  }
  if (name == "open_appender") {
    return writer_result_value(open_appender(path));
  }
  return writer_result_value(open_exclusive(path));
}

function call_host_fs_write(name: string, args: Value[]): Value {
  let path: string = arg_str(args, 0);
  if (name == "write_file") {
    return void_result_value(write_file(path, arg_str(args, 1)));
  }
  if (name == "write_file_bytes") {
    return void_result_value(write_file_bytes(path, arg_bytes(args, 1)));
  }
  if (name == "create_dir") {
    return void_result_value(create_dir(path, arg_i32(args, 1)));
  }
  if (name == "truncate") {
    return void_result_value(truncate(path, arg_i64(args, 1)));
  }
  return void_result_value(set_file_times(path, arg_i64(args, 1), arg_i64(args, 2), arg_i64(args, 3), arg_i64(args, 4), arg_i32(args, 5)));
}

function call_host_fs_read(name: string, path: string): Value {
  if (name == "read_file") {
    return string_result_value(read_file(path));
  }
  if (name == "read_file_bytes") {
    return bytes_result_value(read_file_bytes(path));
  }
  if (name == "read_link") {
    return string_result_value(read_link(path));
  }
  if (name == "temp_dir") {
    return string_result_value(temp_dir(path));
  }
  if (name == "stat") {
    return stat_result_value(stat(path));
  }
  if (name == "lstat") {
    return stat_result_value(lstat(path));
  }
  return call_host_fs_list(name, path);
}

function call_host_fs_list(name: string, path: string): Value {
  if (name == "read_dir") {
    return strings_result_value(read_dir(path));
  }
  if (name == "read_dir_all") {
    return strings_result_value(read_dir_all(path));
  }
  if (name == "read_dir_ino") {
    return dir_entries_result_value(read_dir_ino(path));
  }
  if (name == "read_dir_ino_all") {
    return dir_entries_result_value(read_dir_ino_all(path));
  }
  return v_err("undefined function: " + name);
}

// call_host_net answers the socket builtins: a descriptor is the host's own.
function call_host_net(name: string, args: Value[]): Value {
  if (util.has_str(["udp_sendto", "udp_sendto_bytes"], name)) {
    return call_host_udp_send(name, args);
  }
  if (util.has_str(["udp_bind", "udp_bind_with", "udp_connect", "udp_recvfrom"], name)) {
    return call_host_udp(name, args);
  }
  if (util.has_str(["tcp_listen_with", "tcp_connect_with", "tcp_listen"], name)) {
    return call_host_tcp_open(name, args);
  }
  if (util.has_str(["tcp_send_bytes", "tcp_send_buf", "tcp_sendfile", "tcp_recv_into"], name)) {
    return call_host_tcp_io(name, args);
  }
  return call_host_tcp_fd(name, args);
}

function call_host_udp_send(name: string, args: Value[]): Value {
  if (name == "udp_sendto") {
    return v_int(udp_sendto(arg_i32(args, 0), arg_bytes(args, 1), arg_i32(args, 2), arg_str(args, 3)));
  }
  return v_int(udp_sendto_bytes(arg_i32(args, 0), arg_bytes(args, 1), arg_i32(args, 2), arg_bytes(args, 3)));
}

function call_host_udp(name: string, args: Value[]): Value {
  if (name == "udp_bind") {
    return v_int(udp_bind(arg_bytes(args, 0), arg_i32(args, 1)));
  }
  if (name == "udp_bind_with") {
    return v_int(udp_bind_with(arg_bytes(args, 0), arg_i32(args, 1), arg_bool(args, 2)));
  }
  if (name == "udp_recvfrom") {
    let buf: u8[] = arg_bytes(args, 1);
    let from: u8[] = arg_bytes(args, 2);
    let n: i32 = udp_recvfrom(arg_i32(args, 0), buf, from);
    store_out(args, 1, bytes_as_i64s(buf));
    store_out(args, 2, bytes_as_i64s(from));
    return v_int(n);
  }
  return v_int(udp_connect(arg_i32(args, 0), arg_bytes(args, 1), arg_i32(args, 2)));
}

function call_host_tcp_open(name: string, args: Value[]): Value {
  if (name == "tcp_listen") {
    return v_int(tcp_listen(arg_i32(args, 0)));
  }
  if (name == "tcp_listen_with") {
    return v_int(tcp_listen_with(arg_bytes(args, 0), arg_i32(args, 1), arg_i32(args, 2), arg_bool(args, 3)));
  }
  return v_int(tcp_connect_with(arg_bytes(args, 0), arg_i32(args, 1), arg_bool(args, 2)));
}

function call_host_tcp_io(name: string, args: Value[]): Value {
  let fd: i32 = arg_i32(args, 0);
  if (name == "tcp_send_bytes") {
    return v_int(tcp_send_bytes(fd, arg_bytes(args, 1)));
  }
  if (name == "tcp_send_buf") {
    return v_int(tcp_send_buf(fd, buf_handle_of(arg_at(args, 1)), arg_i32(args, 2)));
  }
  if (name == "tcp_recv_into") {
    let buf: u8[] = arg_bytes(args, 1);
    let n: i32 = tcp_recv_into(fd, buf);
    store_out(args, 1, bytes_as_i64s(buf));
    return v_int(n);
  }
  return v_int(tcp_sendfile(fd, arg_i32(args, 1), arg_i32(args, 2)));
}

function call_host_tcp_fd(name: string, args: Value[]): Value {
  let fd: i32 = arg_i32(args, 0);
  if (name == "tcp_accept") {
    return v_int(tcp_accept(fd));
  }
  if (name == "tcp_close") {
    return v_int(tcp_close(fd));
  }
  if (name == "tcp_local_port") {
    return v_int(tcp_local_port(fd));
  }
  if (name == "tcp_pollable") {
    return v_int(tcp_pollable(fd));
  }
  if (name == "tcp_socket_ctl") {
    return v_int(tcp_socket_ctl(fd, arg_i32(args, 1), arg_i32(args, 2)));
  }
  return v_err("undefined function: " + name);
}

// call_host_native answers a builtin the playground's build does not provide
// (see playground_provides). Its one caller keeps it out of that build.
function call_host_native(name: string, cap: string, args: Value[]): Value {
  if (cap == "tcp") {
    return call_host_net(name, args);
  }
  if (cap == "reactor") {
    return call_host_reactor(name, args);
  }
  if (util.has_str(["poll", "sleep_ms", "sleep_ns"], name)) {
    return call_host_wait(name, args);
  }
  if (cap == "fsmode") {
    return call_host_fsmode(name, args);
  }
  if (cap == "userid") {
    return call_host_userid(name, args);
  }
  if (cap == "tty") {
    return call_host_tty(name, args);
  }
  if (util.has_str(["proc", "rlimit", "sched", "subprocess"], cap)) {
    return call_host_proc(name, args);
  }
  if (util.has_str(["sysinfo", "cwd", "unix", "pollfd", "sysctl"], cap)) {
    return call_host_system(name, args);
  }
  return call_host_fs_native(name, args);
}

function call_host_fsmode(name: string, args: Value[]): Value {
  let path: string = arg_str(args, 0);
  if (name == "write_file_exec") {
    return void_result_value(write_file_exec(path, arg_str(args, 1)));
  }
  if (name == "access") {
    return void_result_value(access(path, arg_i32(args, 1)));
  }
  if (name == "umask") {
    return v_int(umask(arg_i32(args, 0)));
  }
  if (name == "chmod") {
    return void_result_value(chmod(path, arg_i32(args, 1)));
  }
  if (name == "chmod_at") {
    return void_result_value(chmod_at(path, arg_i32(args, 1), arg_bool(args, 2)));
  }
  return v_err("undefined function: " + name);
}

function call_host_userid(name: string, args: Value[]): Value {
  if (name == "geteuid") {
    return v_uint(geteuid() as i32);
  }
  if (name == "getegid") {
    return v_uint(getegid() as i32);
  }
  if (name == "getuid") {
    return v_uint(getuid() as i32);
  }
  if (name == "getgid") {
    return v_uint(getgid() as i32);
  }
  if (name == "getgroups") {
    return i64_array_value(getgroups());
  }
  return v_err("undefined function: " + name);
}

function call_host_tty(name: string, args: Value[]): Value {
  let fd: i32 = arg_i32(args, 0);
  if (name == "window_size") {
    return win_size_result_value(window_size(fd));
  }
  if (name == "set_window_size") {
    return void_result_value(set_window_size(fd, arg_i32(args, 1), arg_i32(args, 2)));
  }
  if (name == "termios_get") {
    return i64s_result_value(termios_get(fd));
  }
  if (name == "termios_set") {
    return void_result_value(termios_set(fd, arg_i32(args, 1), arg_i64s(args, 2)));
  }
  return void_result_value(set_extproc(fd, arg_bool(args, 1)));
}

function call_host_proc(name: string, args: Value[]): Value {
  if (name == "subprocess") {
    let r: ProcessResult = subprocess(arg_str(args, 0), arg_strs(args, 1), arg_str(args, 2));
    return v_struct("ProcessResult", ["stdout", "stderr", "exit_code"], [v_string(r.stdout), v_string(r.stderr), v_int(r.exit_code)]);
  }
  if (name == "pipe") {
    return pipe_result_value(pipe());
  }
  if (name == "process_alive") {
    return v_bool(process_alive(arg_i32(args, 0)));
  }
  if (name == "signal_send") {
    return void_result_value(signal_send(arg_i32(args, 0), arg_i32(args, 1)));
  }
  if (name == "set_process_group") {
    return void_result_value(set_process_group(arg_i32(args, 0), arg_i32(args, 1)));
  }
  return call_host_limits(name, args);
}

function call_host_limits(name: string, args: Value[]): Value {
  if (name == "rlimit_nofile") {
    return v_int64(rlimit_nofile());
  }
  if (name == "disable_core_dumps") {
    return v_bool(disable_core_dumps());
  }
  if (name == "priority") {
    return v_int(priority());
  }
  if (name == "set_priority") {
    return void_result_value(set_priority(arg_i32(args, 0)));
  }
  return v_err("undefined function: " + name);
}

function call_host_system(name: string, args: Value[]): Value {
  if (name == "uname_field") {
    return v_string(uname_field(arg_i32(args, 0)));
  }
  if (name == "cpu_count") {
    return v_int(cpu_count());
  }
  if (name == "getcwd") {
    return string_result_value(getcwd());
  }
  if (name == "chdir") {
    return void_result_value(chdir(arg_str(args, 0)));
  }
  if (name == "unix_listen") {
    return v_int(unix_listen(arg_str(args, 0), arg_i32(args, 1)));
  }
  if (name == "unix_connect") {
    return v_int(unix_connect(arg_str(args, 0)));
  }
  if (name == "timer_fd") {
    return v_int(timer_fd(arg_i32(args, 0)));
  }
  if (name == "sysctl") {
    return call_host_sysctl(arg_i32s(args, 0));
  }
  return v_err("undefined function: " + name);
}

// sysctl is Darwin's alone; elsewhere the kernel has no such call.
function call_host_sysctl(mib: i32[]): Value {
  if (target_os() == "darwin") {
    return bytes_result_value(sysctl(mib));
  } else {
    return enosys_error("");
  }
}

function call_host_fs_native(name: string, args: Value[]): Value {
  let path: string = arg_str(args, 0);
  if (name == "mknod") {
    return void_result_value(mknod(path, arg_i32(args, 1), arg_i32(args, 2), arg_i32(args, 3)));
  }
  if (name == "sync") {
    sync();
    return v_void();
  }
  if (name == "rename_noreplace") {
    return void_result_value(rename_noreplace(path, arg_str(args, 1)));
  }
  if (name == "rename_exchange") {
    return void_result_value(rename_exchange(path, arg_str(args, 1)));
  }
  if (name == "chown_at") {
    return void_result_value(chown_at(path, arg_i32(args, 1), arg_i32(args, 2), arg_bool(args, 3)));
  }
  if (name == "statfs") {
    return fs_stat_result_value(statfs(path));
  }
  if (name == "mounts") {
    return mounts_result_value(mounts());
  }
  if (name == "open_dir") {
    return dir_result_value(open_dir(path));
  }
  return v_err("undefined function: " + name);
}

// ---- methods on host handles --------------------------------------------

// is_handle_method reports whether `name` is a builtin method of a handle of
// `kind`; any other name is a receiver function the program or the stdlib
// declares on the type.
function is_handle_method(kind: string, name: string): boolean {
  if (util.has_str(["close", "stat"], name)) {
    return true;
  }
  if (kind == "Dir") {
    return util.has_str(["open_dir", "entries", "lstat", "access", "remove_file", "remove_dir", "chmod", "chown"], name);
  }
  if (util.has_str(["seek", "flags", "isatty", "fsync", "fdatasync", "syncfs", "drop_cache", "dup_onto"], name)) {
    return true;
  }
  if (kind == "Writer") {
    return util.has_str(["write", "write_some", "write_bytes", "write_some_bytes", "splice_forever", "truncate"], name);
  }
  return util.has_str(["read_chunk", "read_chunk_bytes", "splice_to", "copy_range_to", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc"], name);
}

function handle_method(h: VHandle, name: string, args: Value[]): Value {
  match (h.r) {
    Some(r) => {
      return reader_method(r, name, args);
    },
    None => {}
  }
  match (h.w) {
    Some(w) => {
      return writer_method(w, name, args);
    },
    None => {}
  }
  match (h.d) {
    Some(d) => {
      return call_dir_method(d, name, args);
    },
    None => {}
  }
  return v_err("empty host handle");
}

function reader_method(r: Reader, name: string, args: Value[]): Value {
  if (name == "read_chunk_bytes") {
    return bytes_result_value(r.read_chunk_bytes(arg_i32(args, 0)));
  }
  if (name == "read_chunk") {
    return read_chunk_value(r, arg_i32(args, 0));
  }
  if (name == "close") {
    return io_failure_value(r.close().failure());
  }
  // Nothing moves inside the kernel here: the caller copies the bytes itself.
  if (name == "splice_to" || name == "copy_range_to") {
    return io_err_value(Unsupported);
  }
  if (util.has_str(["window_size", "set_window_size", "termios_get", "termios_set", "set_extproc"], name)) {
    return call_host(name, with_fd_first(r.fd, args));
  }
  return reader_fd_method(r, name, args);
}

// with_fd_first is a handle method's arguments as the free builtin of the
// same name takes them: the handle's descriptor first.
function with_fd_first(fd: i32, args: Value[]): Value[] {
  let out: Value[] = [v_int(fd)];
  for a in args {
    out = out.append(a);
  }
  return out;
}

// read_chunk_value reads one chunk as text. It reads raw bytes and checks the
// text here, so an interpreter stage0 built with an older, unchecked
// read_chunk still answers InvalidUtf8 for bytes that are not text.
function read_chunk_value(r: Reader, n: i32): Value {
  match (r.read_chunk_bytes(n)) {
    Ok(chunk) => {
      match (utf8.from_bytes(chunk)) {
        Some(text) => {
          return ok_value(v_string(text));
        },
        None => {
          return io_err_value(InvalidUtf8(""));
        }
      }
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function reader_fd_method(r: Reader, name: string, args: Value[]): Value {
  if (name == "stat") {
    return stat_result_value(r.stat());
  }
  if (name == "seek") {
    return i64_result_value(r.seek(arg_i64(args, 0), arg_i32(args, 1)));
  }
  if (name == "flags") {
    return i64_result_value(r.flags());
  }
  if (name == "isatty") {
    return v_bool(r.isatty());
  }
  if (name == "fsync") {
    return io_failure_value(r.fsync().failure());
  }
  if (name == "fdatasync") {
    return io_failure_value(r.fdatasync().failure());
  }
  if (name == "syncfs") {
    return io_failure_value(r.syncfs().failure());
  }
  if (name == "drop_cache") {
    return io_failure_value(r.drop_cache(arg_i64(args, 0), arg_i64(args, 1)).failure());
  }
  return io_failure_value(r.dup_onto(arg_i32(args, 0)).failure());
}

function writer_method(w: Writer, name: string, args: Value[]): Value {
  if (name == "write") {
    return io_failure_value(w.write(arg_str(args, 0)).failure());
  }
  if (name == "write_some") {
    return i64_result_value(w.write_some(arg_str(args, 0)));
  }
  if (name == "write_bytes") {
    return io_failure_value(w.write_bytes(arg_bytes(args, 0)).failure());
  }
  if (name == "write_some_bytes") {
    return i64_result_value(w.write_some_bytes(arg_bytes(args, 0)));
  }
  // Nothing reaches the writer, so the caller writes the block itself.
  if (name == "splice_forever") {
    return io_err_value(Unsupported);
  }
  if (name == "close") {
    return io_failure_value(w.close().failure());
  }
  if (name == "truncate") {
    return io_failure_value(w.truncate(arg_i64(args, 0)).failure());
  }
  return writer_fd_method(w, name, args);
}

function writer_fd_method(w: Writer, name: string, args: Value[]): Value {
  if (name == "stat") {
    return stat_result_value(w.stat());
  }
  if (name == "seek") {
    return i64_result_value(w.seek(arg_i64(args, 0), arg_i32(args, 1)));
  }
  if (name == "flags") {
    return i64_result_value(w.flags());
  }
  if (name == "isatty") {
    return v_bool(w.isatty());
  }
  if (name == "fsync") {
    return io_failure_value(w.fsync().failure());
  }
  if (name == "fdatasync") {
    return io_failure_value(w.fdatasync().failure());
  }
  if (name == "syncfs") {
    return io_failure_value(w.syncfs().failure());
  }
  if (name == "drop_cache") {
    return io_failure_value(w.drop_cache(arg_i64(args, 0), arg_i64(args, 1)).failure());
  }
  return io_failure_value(w.dup_onto(arg_i32(args, 0)).failure());
}

// A Dir comes only from open_dir, which wasm32-wasi does not grant, so its
// methods are kept out of that build as open_dir is.
function call_dir_method(d: Dir, name: string, args: Value[]): Value {
  if (target_arch() == "wasm32") {
    return v_err("Dir." + name + ": the host this interpreter runs on does not provide `fsdir`");
  } else {
    return dir_method(d, name, args);
  }
}

function dir_method(d: Dir, name: string, args: Value[]): Value {
  let entry: string = arg_str(args, 0);
  if (name == "open_dir") {
    return dir_result_value(d.open_dir(entry));
  }
  if (name == "entries") {
    return strings_result_value(d.entries());
  }
  if (name == "stat") {
    return stat_result_value(d.stat(entry));
  }
  if (name == "lstat") {
    return stat_result_value(d.lstat(entry));
  }
  if (name == "close") {
    return io_failure_value(d.close().failure());
  }
  return dir_change_method(d, name, entry, args);
}

function dir_change_method(d: Dir, name: string, entry: string, args: Value[]): Value {
  if (name == "access") {
    return void_result_value(d.access(entry, arg_i32(args, 1)));
  }
  if (name == "remove_file") {
    return void_result_value(d.remove_file(entry));
  }
  if (name == "remove_dir") {
    return void_result_value(d.remove_dir(entry));
  }
  if (name == "chmod") {
    return void_result_value(d.chmod(entry, arg_i32(args, 1), arg_bool(args, 2)));
  }
  return void_result_value(d.chown(entry, arg_i32(args, 1), arg_i32(args, 2), arg_bool(args, 3)));
}

// update mutates the slot for an existing name. Linear back-to-
// front scan so the most-recent shadowing binding wins (matches
// lookup). Returns a fresh Env — the parallel-array shape is
// rebuilt with the slot replaced because the underlying arrays
// are value-typed (push returns a new array). Returns the
// original env unchanged when the name isn't bound; the checker
// is supposed to surface that as a type error, but the interp
// guards against it via VErr-on-read at the call site.
// update rebinds the INNERMOST binding of `name`, or returns the env unchanged
// when there is none. Scanning from the end finds the innermost first, and
// `.with` is copy-on-write, so only the one slot is written and `names` is
// untouched — no array is rebuilt.
function (e: Env) update(name: string, v: Value): Env {
  let i: i32 = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return Env { ...e, values: e.values.with(i, v) };
    }
    i = i - 1;
  }
  return e;
}

// =================== EVAL ====================

// eval_expr: a depth-first walk of the parser's Expr tree.
// Errors propagate via VErr — the moment any sub-expression
// errors, the surrounding op returns the same VErr. This keeps
// the early-return pattern out of the body and matches the
// checker's TypeUnknown threading.
// is_sat_op_name reports whether `op` is a saturating arithmetic operator
// (`+|` / `-|` / `*|` / `<<|`, #5542) — clamping to the operand type's
// [MIN, MAX] rather than wrapping.
function is_sat_op_name(op: string): boolean {
  return op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}

// sat_exact computes a saturating op EXACTLY in the host i64, valid only when
// both operands are 32-bit-or-narrower (so no host overflow is possible); the
// caller clamps the wide result to the operand type's range.
function sat_exact(op: string, a: i64, b: i64): i64 {
  if (op == "+|") {
    return a + b;
  }
  if (op == "-|") {
    return a - b;
  }
  // An out-of-range count saturates any non-zero value, so it answers a
  // value past every 32-bit bound with `a`'s sign. In range, the widest
  // exact result is (2^32-1) * 2^31, still inside i64.
  if (op == "<<|") {
    if (b < 0 || b >= 32) {
      return sat_shl_oor(a);
    }
    return a << b;
  }
  return a * b;
}

// sat_shl_oor is `a <<| n` for a count past the width at host i64: zero stays
// zero, anything else lands beyond the clamp bound on its own side.
function sat_shl_oor(a: i64): i64 {
  let big: i64 = 4611686018427387904;
  if (a > 0) {
    return big;
  }
  if (a < 0) {
    return 0 - big;
  }
  return 0;
}

// sat_clamp clamps an exact result into [minv, maxv].
function sat_clamp(v: i64, minv: i64, maxv: i64): i64 {
  if (v > maxv) {
    return maxv;
  }
  if (v < minv) {
    return minv;
  }
  return v;
}

// sat_i64 saturates at full 64-bit width, where no wider host type exists.
// Add / sub pre-check against the bound; mul post-checks the WRAPPED product
// with a division round-trip, plus the `a == -1 && b == MIN` term that a total
// `MIN / -1 == MIN` would otherwise hide. Mirrors the IR lowering
// (irtables.sat_binary_ops).
function sat_i64(op: string, a: i64, b: i64): i64 {
  let maxv: i64 = 9223372036854775807;
  let minv: i64 = 0 - 9223372036854775807 - 1;
  if (op == "+|") {
    if (b > 0 && a > maxv - b) {
      return maxv;
    }
    if (b < 0 && a < minv - b) {
      return minv;
    }
    return a + b;
  }
  if (op == "-|") {
    if (b < 0 && a > maxv + b) {
      return maxv;
    }
    if (b > 0 && a < minv + b) {
      return minv;
    }
    return a - b;
  }
  if (op == "<<|") {
    // Round-trip check: at 64 bits there is no wider host type to
    // compute the exact result in, and the negative-side pre-check
    // bound would need a ceiling division an arithmetic shift cannot
    // give. `>>` is arithmetic, so it restores `a` iff nothing was
    // shifted out.
    if (b >= 0 && b < 64) {
      let sh: i64 = a << b;
      if (sh >> b == a) {
        return sh;
      }
    }
    if (a < 0) {
      return minv;
    }
    if (a == 0) {
      return 0;
    }
    return maxv;
  }
  let prod: i64 = a * b;
  if (a != 0) {
    let bad: boolean = prod / a != b;
    if (a == 0 - 1 && b == minv) {
      bad = true;
    }
    if (bad) {
      let neg: boolean = false;
      if (a < 0) {
        neg = !neg;
      }
      if (b < 0) {
        neg = !neg;
      }
      if (neg) {
        return minv;
      }
      return maxv;
    }
  }
  return prod;
}

// sat_u64 is sat_i64's unsigned twin: the floor is 0 rather than i64::MIN and
// every overflow test is a wraparound check, since an unsigned result can only
// leave the range at the top. Returns the saturated pattern as an i64.
function sat_u64(op: string, a: u64, b: u64): i64 {
  let one: u64 = 1 as u64;
  let maxv: u64 = 0 as u64 - one;
  if (op == "+|") {
    let s: u64 = a + b;
    if (s < a) {
      return maxv as i64;
    }
    return s as i64;
  }
  if (op == "-|") {
    if (a < b) {
      return 0;
    }
    let d: u64 = a - b;
    return d as i64;
  }
  if (op == "<<|") {
    if (b < 64 as u64) {
      let sh: u64 = a << b;
      if (sh >> b == a) {
        return sh as i64;
      }
    }
    if (a == 0 as u64) {
      return 0;
    }
    return maxv as i64;
  }
  let prod: u64 = a * b;
  if (a != 0 as u64 && prod / a != b) {
    return maxv as i64;
  }
  return prod as i64;
}

// eval_usize_binary is eval_binary at the pointer width: the operands read
// unsigned, every result wraps at ptr_bits(), and a shift count masks to it.
function eval_usize_binary(op: string, a: u64, b: u64): Value {
  let sh: u64 = b & (ptr_bits() - 1) as u64;
  if (op == "+") {
    return v_usize((a + b) as i64);
  }
  if (op == "-") {
    return v_usize((a - b) as i64);
  }
  if (op == "*") {
    return v_usize((a * b) as i64);
  }
  if (op == "/" || op == "%") {
    return usize_divide(op == "/", a, b);
  }
  if (op == "<<") {
    return v_usize((a << sh) as i64);
  }
  if (op == ">>") {
    return v_usize((a >> sh) as i64);
  }
  return usize_bitwise(op, a, b);
}

function usize_bitwise(op: string, a: u64, b: u64): Value {
  if (op == "&") {
    return v_usize((a & b) as i64);
  }
  if (op == "|") {
    return v_usize((a | b) as i64);
  }
  if (op == "^") {
    return v_usize((a ^ b) as i64);
  }
  return usize_compare(op, a, b);
}

// usize_divide is the total division and remainder: x / 0 == 0, x % 0 == x.
function usize_divide(quotient: boolean, a: u64, b: u64): Value {
  if (b == 0 as u64) {
    if (quotient) {
      return v_usize(0);
    }
    return v_usize(a as i64);
  }
  if (quotient) {
    return v_usize((a / b) as i64);
  }
  return v_usize((a % b) as i64);
}

function usize_compare(op: string, a: u64, b: u64): Value {
  if (op == "==") {
    return v_bool(a == b);
  }
  if (op == "!=") {
    return v_bool(a != b);
  }
  if (op == "<") {
    return v_bool(a < b);
  }
  if (op == "<=") {
    return v_bool(a <= b);
  }
  if (op == ">") {
    return v_bool(a > b);
  }
  if (op == ">=") {
    return v_bool(a >= b);
  }
  return v_err("operator `" + op + "` is not defined on usize");
}

// eval_binary applies a binary operator to two already-evaluated
// operands. Pure in (op, lv, rv) — extracted from eval_expr's
// ExprBinary arm so the operator semantics live in one place,
// mirroring the VM's apply_binary (SH-048).
// strings_ordered applies an ordering operator to two strings, compared by
// their bytes.
function strings_ordered(op: string, a: string, b: string): boolean {
  if (op == "<") {
    return a < b;
  }
  if (op == "<=") {
    return a <= b;
  }
  if (op == ">") {
    return a > b;
  }
  return a >= b;
}

function is_checked_op(op: string): boolean {
  return util.has_str(["+?", "-?", "*?", "/?", "%?", "<<?", ">>?"], op);
}

// checked_operand_type is the integer type a checked operator computes in:
// the type the checker stamped on an operand (a literal operand is settled to
// its sibling's), else the left operand's carrier.
function checked_operand_type(b: ast.ExprBinary, lv: Value): string {
  let ints: string[] = ["u8", "i32", "u32", "i64", "u64"];
  for side in [b.left, b.right] {
    let tag: string = ast.expr_ty(side);
    if let ast.ExprNumber(n) = side {
      tag = n.suffix;
    }
    if (util.has_str(ints, tag)) {
      return tag;
    }
  }
  return value_type_name(lv);
}

// eval_checked is a checked operator (#5542): Some(result) when the exact
// result fits `ty`, None on overflow, a zero divisor, the signed MIN / -1, a
// shift count outside [0, width) or a left shift that loses bits.
function eval_checked(op: string, lv: Value, rv: Value, ty: string): Value {
  if (!is_int_like(lv) || !is_int_like(rv)) {
    return v_err("checked operator `" + op + "` on a non-integer");
  }
  let signed: boolean = ty == "i32" || ty == "i64";
  let width: i64 = 32;
  if (ty == "u8") {
    width = 8;
  } else if (ty == "i64" || ty == "u64") {
    width = 64;
  }
  let a: i64 = vint_as_i64(coerce_int_width(lv, ty));
  let b: i64 = vint_as_i64(coerce_int_width(rv, ty));
  let none_args: Value[] = [];
  if (op == "<<?" || op == ">>?") {
    if (b < 0 || b >= width) {
      return v_variant("None", none_args);
    }
  }
  let r: Option[i64] = None;
  if (width == 64) {
    r = checked_64(op, a, b, signed);
  } else {
    r = checked_narrow(op, a, b, signed, width);
  }
  if let Some(v) = r {
    return v_variant("Some", [coerce_int_width(v_int64(v), ty)]);
  }
  return v_variant("None", none_args);
}

// checked_narrow computes a checked operator on operands of at most 32 bits,
// whose exact result always fits an i64.
function checked_narrow(op: string, a: i64, b: i64, signed: boolean, width: i64): Option[i64] {
  let minv: i64 = 0;
  let maxv: i64 = (1 as i64 << width) - 1;
  if (signed) {
    minv = 0 - (1 as i64 << width - 1);
    maxv = (1 as i64 << width - 1) - 1;
  }
  let exact: i64 = 0;
  if (op == "+?") {
    exact = a + b;
  } else if (op == "-?") {
    exact = a - b;
  } else if (op == "*?") {
    exact = a * b;
  } else if (op == "/?" || op == "%?") {
    if (b == 0) {
      return None;
    }
    if (op == "/?") {
      exact = a / b;
    } else {
      exact = a % b;
    }
    if (signed && a == minv && b == 0 - 1) {
      return None;
    }
  } else if (op == "<<?") {
    exact = a << b;
  } else {
    exact = a >> b;
  }
  if (exact < minv || exact > maxv) {
    return None;
  }
  return Some(exact);
}

// checked_64 is checked_narrow at 64 bits, where the overflow is read off the
// wrapped result rather than an exact one.
function checked_64(op: string, a: i64, b: i64, signed: boolean): Option[i64] {
  let minv: i64 = 0 - 9223372036854775807 - 1;
  if (op == "+?") {
    let r: i64 = a + b;
    if (signed && ((a ^ r) & (b ^ r)) < 0 || !signed && r as u64 < a as u64) {
      return None;
    }
    return Some(r);
  }
  if (op == "-?") {
    let r: i64 = a - b;
    if (signed && ((a ^ b) & (a ^ r)) < 0 || !signed && a as u64 < b as u64) {
      return None;
    }
    return Some(r);
  }
  if (op == "*?") {
    let r: i64 = a * b;
    if (a == 0) {
      return Some(r);
    }
    if (signed && (r / a != b || a == 0 - 1 && b == minv)) {
      return None;
    }
    if (!signed && r as u64 / (a as u64) != b as u64) {
      return None;
    }
    return Some(r);
  }
  if (op == "/?" || op == "%?") {
    if (b == 0 || signed && a == minv && b == 0 - 1) {
      return None;
    }
    if (!signed) {
      if (op == "/?") {
        return Some((a as u64 / (b as u64)) as i64);
      }
      return Some((a as u64 % (b as u64)) as i64);
    }
    if (op == "/?") {
      return Some(a / b);
    }
    return Some(a % b);
  }
  if (op == "<<?") {
    let r: i64 = a << b;
    if (signed && r >> b != a || !signed && (r as u64 >> b as u64) as i64 != a) {
      return None;
    }
    return Some(r);
  }
  if (signed) {
    return Some(a >> b);
  }
  return Some((a as u64 >> b as u64) as i64);
}

// eval_typed_binary is eval_binary wrapped to the integer type the checker
// stamped on the expression: the value plane has no u8, and an operand read
// wide is narrowed back to i32.
function eval_typed_binary(op: string, lv: Value, rv: Value, ty: string): Value {
  if (ty == "u8" && is_sat_op_name(op) && is_int_like(lv) && is_int_like(rv)) {
    return v_int(sat_clamp(sat_exact(op, vint_as_i64(lv), vint_as_i64(rv)), 0, 255) as i32);
  }
  let v: Value = eval_binary(op, lv, rv);
  if (util.has_str(["u8", "i32", "u32", "i64", "u64", "usize"], ty)) {
    return coerce_int_width(v, ty);
  }
  return v;
}

function eval_binary(op: string, lv: Value, rv: Value): Value {
  if let VLanes(a) = lv {
    return lanes_binary(op, a, rv);
  }
  // 64-bit integer arithmetic: when either operand is a VInt64, widen
  // both to i64, compute in 64 bits, then box back (narrowing to a VInt
  // when the result fits i32). The pure VInt (i32) path below is left
  // untouched, so i32 overflow wrapping and every existing case behave
  // exactly as before. Total div/mod semantics match the i32 path
  // (x/0 == 0, x%0 == x).
  if (is_int_like(lv) && is_int_like(rv) && (is_vusize(lv) || is_vusize(rv))) {
    return eval_usize_binary(op, vint_as_i64(lv) as u64, vint_as_i64(rv) as u64);
  }
  if (is_int_like(lv) && is_int_like(rv) && (is_vint64(lv) || is_vint64(rv))) {
    let a: i64 = vint_as_i64(lv);
    let b: i64 = vint_as_i64(rv);
    // u64 semantics are sticky, like VUint's at 32 bits: the ops whose
    // result depends on how the pattern is READ (div / rem / `>>` /
    // ordering compares / saturation) take the unsigned branch, and the
    // width-preserving ops carry the tag through unchanged.
    let uns: boolean = is_vuint64(lv) || is_vuint64(rv);
    // A 64-bit operation always yields a VInt64, even when the
    // result happens to fit i32: narrowing here would strip the width
    // from e.g. a running accumulator (`s = s + 1000000000` whose
    // partial sum dips into i32 range), so the next op would wrap on
    // the i32 path. Only literals narrow by magnitude (box_i64 in
    // ExprNumber); an explicit `as i32` is the way back to a VInt.
    if (op == "+") {
      return v_wide(a + b, uns);
    }
    if (op == "-") {
      return v_wide(a - b, uns);
    }
    if (op == "*") {
      return v_wide(a * b, uns);
    }
    if (op == "&") {
      return v_wide(a & b, uns);
    }
    if (op == "|") {
      return v_wide(a | b, uns);
    }
    if (op == "^") {
      return v_wide(a ^ b, uns);
    }
    if (op == "<<") {
      return v_wide(a << b, uns);
    }
    if (op == "==") {
      return v_bool(a == b);
    }
    if (op == "!=") {
      return v_bool(a != b);
    }
    if (uns) {
      let ua: u64 = a as u64;
      let ub: u64 = b as u64;
      let uzero: u64 = 0 as u64;
      if (is_sat_op_name(op)) {
        return v_uint64(sat_u64(op, ua, ub));
      }
      if (op == "/") {
        if (ub == uzero) {
          return v_uint64(0);
        }
        let uq: u64 = ua / ub;
        return v_uint64(uq as i64);
      }
      if (op == "%") {
        if (ub == uzero) {
          return v_uint64(a);
        }
        let ur: u64 = ua % ub;
        return v_uint64(ur as i64);
      }
      if (op == ">>") {
        let ush: u64 = ua >> ub;
        return v_uint64(ush as i64);
      }
      if (op == "<") {
        return v_bool(ua < ub);
      }
      if (op == "<=") {
        return v_bool(ua <= ub);
      }
      if (op == ">") {
        return v_bool(ua > ub);
      }
      if (op == ">=") {
        return v_bool(ua >= ub);
      }
    }
    if (is_sat_op_name(op)) {
      return v_int64(sat_i64(op, a, b));
    }
    if (op == "/") {
      if (b == 0) {
        return v_int64(0);
      }
      let q64: i64 = a / b;
      return v_int64(q64);
    }
    if (op == "%") {
      if (b == 0) {
        return v_int64(a);
      }
      let r64: i64 = a % b;
      return v_int64(r64);
    }
    if (op == "<") {
      return v_bool(a < b);
    }
    if (op == "<=") {
      return v_bool(a <= b);
    }
    if (op == ">") {
      return v_bool(a > b);
    }
    if (op == ">=") {
      return v_bool(a >= b);
    }
    if (op == ">>") {
      return v_int64(a >> b);
    }
  }
  // Unsigned 32-bit dispatch (docs/INTEGER-SEMANTICS.md): when either
  // compact operand is a VUint, div / rem / compares / `>>` run UNSIGNED
  // via zero-extension to i64 (shift counts masked &31, total division
  // x/0 == 0 and x%0 == x), and `+ - * & | ^ <<` — bit-identical to
  // signed — compute on the 32-bit patterns. Arithmetic results stay
  // VUint (sticky); a VUint mixed with a VInt64 zero-extends through the
  // 64-bit block above instead.
  if (is_int_like(lv) && is_int_like(rv) && (is_vuint(lv) || is_vuint(rv))) {
    let la: i32 = vint_bits(lv);
    let rb: i32 = vint_bits(rv);
    if (op == "+") {
      return v_uint(la + rb);
    }
    if (op == "-") {
      return v_uint(la - rb);
    }
    if (op == "*") {
      return v_uint(la * rb);
    }
    if (is_sat_op_name(op)) {
      return v_uint(sat_clamp(sat_exact(op, uint_zext(la), uint_zext(rb)), 0, 4294967295) as i32);
    }
    if (op == "&") {
      return v_uint(la & rb);
    }
    if (op == "|") {
      return v_uint(la | rb);
    }
    if (op == "^") {
      return v_uint(la ^ rb);
    }
    if (op == "<<") {
      return v_uint(la << (rb & 31));
    }
    let ua: i64 = uint_zext(la);
    let ub: i64 = uint_zext(rb);
    if (op == ">>") {
      let sc: i64 = (rb & 31) as i64;
      let shifted: i64 = ua >> sc;
      return v_uint(shifted as i32);
    }
    if (op == "/") {
      if (ub == 0) {
        return v_uint(0);
      }
      let uq: i64 = ua / ub;
      return v_uint(uq as i32);
    }
    if (op == "%") {
      if (ub == 0) {
        return v_uint(la);
      }
      let ur: i64 = ua % ub;
      return v_uint(ur as i32);
    }
    if (op == "<") {
      return v_bool(ua < ub);
    }
    if (op == "<=") {
      return v_bool(ua <= ub);
    }
    if (op == ">") {
      return v_bool(ua > ub);
    }
    if (op == ">=") {
      return v_bool(ua >= ub);
    }
    if (op == "==") {
      return v_bool(la == rb);
    }
    if (op == "!=") {
      return v_bool(la != rb);
    }
  }
  // f32 dispatch (#4366 model): when either operand is a VFloat32 and
  // the other is numeric, compute at f64 and round the RESULT to single
  // precision, staying sticky as VFloat32. Comparisons compare the
  // (already rounded) f64 payloads and yield VBool.
  if ((is_vfloat32(lv) || is_vfloat32(rv)) && (is_float_like(lv) || is_int_like(lv)) && (is_float_like(rv) || is_int_like(rv))) {
    let fa: f64 = vfloat_as_f64(lv);
    if (is_int_like(lv)) {
      fa = vint_as_i64(lv) as f64;
    }
    let fb: f64 = vfloat_as_f64(rv);
    if (is_int_like(rv)) {
      fb = vint_as_i64(rv) as f64;
    }
    if (op == "+") {
      return v_float32(fa + fb);
    }
    if (op == "-") {
      return v_float32(fa - fb);
    }
    if (op == "*") {
      return v_float32(fa * fb);
    }
    if (op == "/") {
      return v_float32(fa / fb);
    }
    if (op == "%") {
      return v_err("`%` on f32 is unsupported");
    }
    if (op == "<") {
      return v_bool(fa < fb);
    }
    if (op == "<=") {
      return v_bool(fa <= fb);
    }
    if (op == ">") {
      return v_bool(fa > fb);
    }
    if (op == ">=") {
      return v_bool(fa >= fb);
    }
    if (op == "==") {
      return v_bool(fa == fb);
    }
    if (op == "!=") {
      return v_bool(fa != fb);
    }
  }
  // Saturating arithmetic (#5542) on plain i32: the exact 64-bit result
  // always fits the host i64, so it is computed wide and clamped.
  if (is_sat_op_name(op)) {
    match (lv) {
      VInt(li) => {
        match (rv) {
          VInt(ri) => {
            let sv: i64 = sat_exact(op, li.v as i64, ri.v as i64);
            return v_int(sat_clamp(sv, 0 - 2147483647 - 1, 2147483647) as i32);
          },
          _ => {
            return v_err("saturating rhs not i32");
          }
        }
      },
      _ => {
        return v_err("saturating lhs not i32");
      }
    }
  }
  // `+` overloads i32 (arithmetic) and string (concat).
  if (op == "+") {
    match (lv) {
      VInt(li) => {
        match (rv) {
          VInt(ri) => {
            return v_int(li.v + ri.v);
          },
          _ => {
            return v_err("`+` rhs not i32");
          }
        }
      },
      VString(ls) => {
        match (rv) {
          VString(rs) => {
            return v_string(ls.v + rs.v);
          },
          _ => {
            return v_err("`+` rhs not string");
          }
        }
      },
      VFloat(lf) => {
        match (rv) {
          VFloat(rf) => {
            return v_float(lf.v + rf.v);
          },
          _ => {
            return v_err("`+` rhs not f64");
          }
        }
      },
      _ => {
        return v_err("`+` lhs not i32, string, or f64");
      }
    }
  }
  return eval_binary_arith(op, lv, rv);
}

// eval_binary_arith continues eval_binary: the arithmetic, comparison, logic
// and bitwise operators on scalar operands.
function eval_binary_arith(op: string, lv: Value, rv: Value): Value {
  if (op == "-" || op == "*" || op == "/" || op == "%") {
    match (lv) {
      VInt(li) => {
        match (rv) {
          VInt(ri) => {
            if (op == "-") {
              return v_int(li.v - ri.v);
            }
            if (op == "*") {
              return v_int(li.v * ri.v);
            }
            // Total division semantics (docs/INTEGER-SEMANTICS.md):
            // `x / 0 == 0` and `x % 0 == x`, not a runtime error —
            // matching native (#4348 item 6). The engine also
            // shouldn't trap on data-dependent zero divisors.
            if (op == "/") {
              if (ri.v == 0) {
                return v_int(0);
              }
              return v_int(li.v / ri.v);
            }
            if (ri.v == 0) {
              return v_int(li.v);
            }
            return v_int(li.v % ri.v);
          },
          _ => {
            return v_err("arithmetic rhs not i32");
          }
        }
      },
      VFloat(lf) => {
        match (rv) {
          VFloat(rf) => {
            if (op == "-") {
              return v_float(lf.v - rf.v);
            }
            if (op == "*") {
              return v_float(lf.v * rf.v);
            }
            // IEEE total semantics: `1.0/0.0` is +Inf and
            // `0.0/0.0` is NaN, not a runtime error (#4348 item 6).
            if (op == "/") {
              return v_float(lf.v / rf.v);
            }
            // `%` on floats isn't supported — the
            // semantics differ across languages
            // and the parser side doesn't yet
            // distinguish.
            return v_err("`%` on f64 is unsupported");
          },
          _ => {
            return v_err("arithmetic rhs not f64");
          }
        }
      },
      _ => {
        return v_err("arithmetic lhs not i32 or f64");
      }
    }
  }
  if (op == "<" || op == "<=" || op == ">" || op == ">=") {
    match (lv) {
      VInt(li) => {
        match (rv) {
          VInt(ri) => {
            if (op == "<") {
              return v_bool(li.v < ri.v);
            }
            if (op == "<=") {
              return v_bool(li.v <= ri.v);
            }
            if (op == ">") {
              return v_bool(li.v > ri.v);
            }
            return v_bool(li.v >= ri.v);
          },
          _ => {
            return v_err("comparison rhs not i32");
          }
        }
      },
      VFloat(lf) => {
        match (rv) {
          VFloat(rf) => {
            if (op == "<") {
              return v_bool(lf.v < rf.v);
            }
            if (op == "<=") {
              return v_bool(lf.v <= rf.v);
            }
            if (op == ">") {
              return v_bool(lf.v > rf.v);
            }
            return v_bool(lf.v >= rf.v);
          },
          _ => {
            return v_err("comparison rhs not f64");
          }
        }
      },
      VString(ls) => {
        if let VString(rs) = rv {
          return v_bool(strings_ordered(op, ls.v, rs.v));
        }
        return v_err("comparison rhs not a string");
      },
      _ => {
        return v_err("comparison lhs not i32, f64 or string");
      }
    }
  }
  if (op == "==" || op == "!=") {
    let eq: boolean = value_eq(lv, rv);
    if (op == "==") {
      return v_bool(eq);
    }
    return v_bool(!eq);
  }
  if (op == "&&" || op == "||") {
    match (lv) {
      VBool(lb) => {
        match (rv) {
          VBool(rb) => {
            if (op == "&&") {
              return v_bool(lb.v && rb.v);
            }
            return v_bool(lb.v || rb.v);
          },
          _ => {
            return v_err("logical rhs not bool");
          }
        }
      },
      _ => {
        return v_err("logical lhs not bool");
      }
    }
  }
  // Bitwise / shift ops on i32 (#4348 item 7) — previously unimplemented,
  // so any `& | ^ << >>` program evaluated to VErr (exit 254). The host
  // operators match the native i32 semantics (arithmetic `>>`, shift-count
  // masking as emitted by the compiler).
  if (op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>") {
    match (lv) {
      VInt(li) => {
        match (rv) {
          VInt(ri) => {
            if (op == "&") {
              return v_int(li.v & ri.v);
            }
            if (op == "|") {
              return v_int(li.v | ri.v);
            }
            if (op == "^") {
              return v_int(li.v ^ ri.v);
            }
            if (op == "<<") {
              return v_int(li.v << ri.v);
            }
            return v_int(li.v >> ri.v);
          },
          _ => {
            return v_err("bitwise rhs not i32");
          }
        }
      },
      _ => {
        return v_err("bitwise lhs not i32");
      }
    }
  }
  return v_err("unknown binary op: " + op);
}

// f64_trunc_u32 truncates a float toward zero into the 32-bit UNSIGNED range,
// returning the pattern in the i32 carrier a VUint holds. Saturating, which is
// what the compiled paths emit (f64_to_u32: fcvtzu / i32.trunc_sat_f64_u): a
// negative source and NaN answer 0 rather than their two's-complement bits, and
// a source at or above 2^32 answers u32::MAX. Signed truncation read as
// unsigned gave `-1.0 as u32` 4294967295 and `1e10 as u32` 0 (#9912).
function f64_trunc_u32(v: f64): i32 {
  if (v >= 4294967296.0) {
    return 0 - 1;
  }
  if (v >= 0.0) {
    return (v as i64) as i32;
  }
  return 0;
}

// f64_trunc_u64 is f64_trunc_u32's 64-bit twin, returning the pattern as an
// i64. The band [2^63, 2^64) cannot go through `as i64` — that saturates at
// i64::MAX — so it is converted below 2^63 and the top bit is put back.
function f64_trunc_u64(v: f64): i64 {
  if (v >= 18446744073709551616.0) {
    return (0 as u64 - 1 as u64) as i64;
  }
  if (v >= 9223372036854775808.0) {
    let q: i64 = (v - 9223372036854775808.0) as i64;
    return (q as u64 | 1 as u64 << 63 as u64) as i64;
  }
  if (v >= 0.0) {
    return v as i64;
  }
  return 0;
}

// eval_unary applies a unary operator to an already-evaluated
// operand. Pure in (op, ov) — extracted from eval_expr's ExprUnary
// arm, mirroring eval_binary (SH-048).
function eval_unary(op: string, ov: Value): Value {
  if (op == "-") {
    match (ov) {
      VInt(i) => {
        return v_int(0 - i.v);
      },
      VInt64(i) => {
        if (i.ptr) {
          return v_usize(0 - unpack_i64(i));
        }
        return v_wide(0 - unpack_i64(i), i.unsigned);
      },
      VUint(u) => {
        return v_uint(0 - u.v);
      },
      VFloat(f) => {
        return v_float(-f.v);
      },
      VFloat32(f) => {
        return v_float32(-f.v);
      },
      VLanes(l) => {
        return lanes_map_bits(l, lane_sign(l.width), 0);
      },
      _ => {
        return v_err("unary `-` operand not i32 or f64");
      }
    }
  }
  if (op == "!") {
    match (ov) {
      VBool(b) => {
        return v_bool(!b.v);
      },
      _ => {
        return v_err("unary `!` operand not bool");
      }
    }
  }
  // `expr as <Type>` numeric casts (desugared to `as_<Type>`).
  // The interp's numeric model is VInt (i32) + VFloat (f64): an
  // integer-target cast is identity on an int and truncates a
  // float; a float-target cast widens an int and is identity on a
  // float. Without these every cast fell through to the
  // "unknown unary op" error below.
  // `as u8` / `as byte` truncate to the low 8 bits at runtime (native masks
  // the value, e.g. `(255 + 1) as u8 == 0`) — the interp previously returned
  // the operand unchanged, so a u8 cast was a no-op (#4348 item 3, cast
  // slice). A FLOAT source saturates into the unsigned range before that mask
  // (f64_trunc_u32), so `-1.0 as u8` is 0 and not the 255 its two's-complement
  // low byte gives. u8 is the only sub-i32 integer type in the language, so
  // this is the whole runtime-truncation surface. (An out-of-range u8
  // *literal* is a separate compile-time E047, not a runtime concern here.)
  if (op == "as_char") {
    return char_value(ov);
  }
  if (op == "as_u8" || op == "as_byte") {
    match (ov) {
      VInt(i) => {
        return v_int(i.v & 255);
      },
      VInt64(i) => {
        return v_int((unpack_i64(i) & 255) as i32);
      },
      VUint(u) => {
        return v_int(u.v & 255);
      },
      VFloat(f) => {
        return v_int(f64_trunc_u32(f.v) & 255);
      },
      VFloat32(f) => {
        return v_int(f64_trunc_u32(f.v) & 255);
      },
      _ => {
        return v_err("`as` integer cast operand not numeric");
      }
    }
  }
  // `as i32` narrows a wider integer to 32 bits, SIGNED (a VInt64
  // truncates to its low 32 bits — this is what brings an i64 value back
  // into i32 range, e.g. `(5000000000 as i32)`; a VUint keeps its bit
  // pattern and drops the unsigned tag).
  if (op == "as_i32") {
    return cast_i32_value(ov);
  }
  if (op == "as_usize") {
    return cast_usize_value(ov);
  }
  // `as u32` is the same 32-bit narrowing but tags the pattern unsigned. A
  // float source is the unsigned SATURATING truncation instead (see
  // f64_trunc_u32), since an unsigned destination has no sign bit for a
  // negative source to wrap into.
  if (op == "as_u32") {
    match (ov) {
      VInt(i) => {
        return v_uint(i.v);
      },
      VInt64(i) => {
        return v_uint(i.lo);
      },
      VUint(u) => {
        return ov;
      },
      VFloat(f) => {
        return v_uint(f64_trunc_u32(f.v));
      },
      VFloat32(f) => {
        return v_uint(f64_trunc_u32(f.v));
      },
      _ => {
        return v_err("`as` integer cast operand not numeric");
      }
    }
  }
  // `as i64` / `as u64` give a 64-bit carrier with the signedness tag: the
  // bits are unchanged, only how div / rem / compares / `>>` read them, and
  // the carrier is what an i64 or u64 method dispatches on.
  if (op == "as_i64" || op == "as_u64") {
    let uns: boolean = op == "as_u64";
    match (ov) {
      VInt(i) => {
        return v_wide(i.v as i64, uns);
      },
      VInt64(i) => {
        return v_wide(unpack_i64(i), uns);
      },
      VUint(u) => {
        return v_wide(uint_zext(u.v), uns);
      },
      VFloat(f) => {
        if (uns) {
          return v_wide(f64_trunc_u64(f.v), uns);
        }
        return v_wide(f.v as i64, uns);
      },
      VFloat32(f) => {
        if (uns) {
          return v_wide(f64_trunc_u64(f.v), uns);
        }
        return v_wide(f.v as i64, uns);
      },
      _ => {
        return v_err("`as` integer cast operand not numeric");
      }
    }
  }
  if (op == "as_f64") {
    match (ov) {
      VInt(i) => {
        return v_float(i.v as f64);
      },
      VInt64(i) => {
        return v_float(wide_as_f64(i));
      },
      VUint(u) => {
        return v_float(uint_zext(u.v) as f64);
      },
      VFloat(f) => {
        return v_float(f.v);
      },
      VFloat32(f) => {
        return v_float(f.v);
      },
      _ => {
        return v_err("`as` float cast operand not numeric");
      }
    }
  }
  // `as f32` rounds to single precision and tags the result sticky (an
  // already-f32 value passes through — its payload is already rounded).
  if (op == "as_f32") {
    match (ov) {
      VInt(i) => {
        return v_float32(i.v as f64);
      },
      VInt64(i) => {
        return v_float32(wide_as_f64(i));
      },
      VUint(u) => {
        return v_float32(uint_zext(u.v) as f64);
      },
      VFloat(f) => {
        return v_float32(f.v);
      },
      VFloat32(f) => {
        return ov;
      },
      _ => {
        return v_err("`as` float cast operand not numeric");
      }
    }
  }
  // `expr?` (parsed as the unary `try_`): unwrap a Some / Ok payload, or
  // unwind the None / Err box out to the enclosing function's return via
  // VTry. The operand is the runtime shape v_variant builds, so the payload
  // is field 0 of a `__ev`-tagged VStruct. A `?` on anything else is a
  // checker error upstream (E042), so it can only be reached on an invalid
  // program (#5990).
  if (op == "try_") {
    match (ov) {
      VStruct(sv) => {
        if (sv.type_name == "Some" || sv.type_name == "Ok") {
          if (sv.field_values.len() == 0) {
            return v_err("`?` on a payload-less " + sv.type_name);
          }
          return sv.field_values[0];
        }
        if (sv.type_name == "None" || sv.type_name == "Err") {
          return VTry { box: ov };
        }
        return v_err("`?` operand is not an Option or Result: " + sv.type_name);
      },
      _ => {
        return v_err("`?` operand is not an Option or Result");
      }
    }
  }
  // `x as? T` between integers: Some of the converted value when it holds x
  // exactly, else None (#12708).
  let is_as_opt: boolean = op.len() > 4 && slice_unchecked(op, 0, 4) == "as?_";
  if (is_as_opt && util.has_str(["u8", "i32", "u32", "i64", "u64", "usize"], slice_unchecked(op, 4, op.len())) && is_int_like(ov)) {
    let t: Value = eval_unary("as_" + slice_unchecked(op, 4, op.len()), ov);
    if (vint_as_i64(t) == vint_as_i64(ov) && int_is_negative(t) == int_is_negative(ov)) {
      return v_variant("Some", [t]);
    }
    let none: Value[] = [];
    return v_variant("None", none);
  }
  // `x as? T` on a `dyn` value: Some(x) when its run-time type is T, the
  // struct T or a variant of the enum T, else None. A variant's owner tells
  // it from a struct of its name.
  if (is_as_opt) {
    if (dispatch_type_name(ov) == util.base_type_name(slice_unchecked(op, 4, op.len()) + "")) {
      return v_variant("Some", [ov]);
    }
    let none: Value[] = [];
    return v_variant("None", none);
  }
  // A non-numeric `as <Type>` (`as_i32[]`, `as_string`, `as_Option[i32]`,
  // …) is a zero-cost type ascription — identity on the runtime value.
  // Pass the operand through unchanged (matching the AST/IR emitters, which
  // treat every non-numeric `as_<T>` as a no-op).
  if (op.len() > 3 && slice_unchecked(op, 0, 3) == "as_") {
    return ov;
  }
  return v_err("unknown unary op: " + op);
}

// int_is_negative reads an integer value by its own signedness: a u64 with its
// top bit set is a large number, not a negative one.
function int_is_negative(v: Value): boolean {
  if let VInt64(w) = v {
    if (w.unsigned) {
      return false;
    }
  }
  return vint_as_i64(v) < 0;
}

// `as usize` extends an integer to 64 bits by its own signedness and wraps it
// to the pointer width; a float saturates into the pointer width's unsigned
// range. Anything else is an address reinterpretation, which moves nothing.
function cast_usize_value(v: Value): Value {
  if (is_int_like(v)) {
    return v_usize(vint_as_i64(v));
  }
  if (!is_float_like(v)) {
    return v;
  }
  if (ptr_bits() == 32) {
    return v_usize(uint_zext(f64_trunc_u32(vfloat_as_f64(v))));
  }
  return v_usize(f64_trunc_u64(vfloat_as_f64(v)));
}

// An explicit i32 cast drops scalar identity along with any wider payload.
function cast_i32_value(v: Value): Value {
  match (v) {
    VInt(i) => {
      return v_int(i.v);
    },
    VInt64(i) => {
      return v_int(i.lo);
    },
    VUint(u) => {
      return v_int(u.v);
    },
    VFloat(f) => {
      return v_int(f.v as i32);
    },
    VFloat32(f) => {
      return v_int(f.v as i32);
    },
    _ => {
      return v_err("`as` integer cast operand not numeric");
    }
  }
}

// eval_number_literal parses a numeric literal to a Value. Kept OUT of
// eval_expr's ExprNumber arm on purpose: inlining the i64 path (an extra
// i64 local, the range compare, and the digits_to_i64 / box_i64 calls)
// into the already-huge eval_expr pushed its arm64 frame / register
// pressure over a threshold and tripped a layout-sensitive native-codegen
// abort (the arm64 sibling of the #3425 x86 heap Heisenbug) — even though
// the logic is correct in isolation. A separate function keeps eval_expr
// small. Decimal literals parse as i64 so a value beyond i32 range
// survives, and box_i64 narrows it back to a compact VInt when it fits.
function eval_number_literal(is_float: boolean, t: string, suffix: string): Value {
  return coerce_int_width(eval_unsuffixed_literal(is_float, t), suffix);
}

function eval_unsuffixed_literal(is_float: boolean, t: string): Value {
  if (is_float) {
    return v_float(f64_from_bits(util.parse_f64_bits(t)));
  }
  let hs: i32 = 0;
  if (t.len() > 0 && t[0] == b'-') {
    hs = 1;
  }
  let is_radix: boolean = t.len() > hs + 1 && t[hs] == b'0' && (t[hs + 1] == b'x' || t[hs + 1] == b'X' || t[hs + 1] == b'b' || t[hs + 1] == b'B');
  if (is_radix) {
    return box_i64(util.lit_to_i64(t));
  }
  return box_i64(util.digits_to_i64(t));
}

function resolve_ident_value(name: string, env: Env): Value {
  let idv: Value = env.lookup(name);
  // A bare identifier with no local binding may name a
  // `const`: the parser desugars `const N = expr;` into a
  // zero-arg function `N()` marked is_const, and the native
  // compiler lowers a bare `N` reference to a call. Mirror that
  // here. The marker is what tells a const from a zero-arg
  // function named as a value (`r.it("case", test_case)`): the
  // latter is a function value below, not a call.
  if (is_err(idv)) {
    let ci: i32 = 0;
    while (ci < env.funcs.len()) {
      if (env.funcs[ci].name == name && env.funcs[ci].receiver_type.len() == 0 && env.funcs[ci].params.len() == 0 && env.funcs[ci].is_const) {
        let no_args: Value[] = [];
        return call_func(name, no_args, env.funcs, env.aliases, env.type_decls, env.outs);
      }
      ci = ci + 1;
    }
    // `None` / `Red` / `JNull` — a payload-less enum variant appears as a
    // bare identifier rather than a call. The const lookup above runs
    // first, so a user `const None = …` still wins. Ordinary functions also
    // shadow variants. A variant that DOES
    // carry payloads falls through to the undefined-identifier error, as
    // naming it without calling it is a checker error upstream.
    if (variant_arity(name, env.type_decls) == 0 && !user_func_exists(name, env.funcs)) {
      let none_args: Value[] = [];
      return v_variant_of(variant_owner(name, env.type_decls), name, none_args);
    }
    // A top-level function named as a VALUE rather than called —
    // `[inc, dbl]`, or passing `inc` to a higher-order function
    // (#6611). Consts were evaluated above; same-named variants were skipped.
    let vfi: i32 = 0;
    while (vfi < env.funcs.len()) {
      let vfd: parser.FuncDecl = env.funcs[vfi];
      if (vfd.name == name && vfd.receiver_type.len() == 0) {
        let no_names: string[] = [];
        let no_values: Value[] = [];
        let no_types: string[] = [];
        let generic_name: string = "";
        if (vfd.type_params.len() > 0) {
          generic_name = name;
        }
        return VFunc {
          params: vfd.params,
          ret_type: vfd.ret_type,
          body: vfd.body,
          captured_names: no_names,
          captured_values: no_values,
          captured_types: no_types,
          generic_name: generic_name,
        };
      }
      vfi = vfi + 1;
    }
  }
  return idv;
}

// eval_binary_expr evaluates a binary expression. Kept out of eval_expr, whose
// frame every interpreted call nests.
@noinline
function eval_binary_expr(b: ast.ExprBinary, env: Env): Value {
  let lv: Value = eval_expr(b.left, env);
  if (is_err(lv)) {
    return lv;
  }
  // Short-circuit `&&` / `||`: the RHS is NOT evaluated when the LHS
  // already determines the result (#4348 item 5). Matches native and
  // keeps a guarded side-effecting / out-of-bounds RHS from running
  // (e.g. `i < len && a[i] == x`). The non-short-circuit path still
  // flows through eval_binary with both operands.
  if (b.op == "&&" || b.op == "||") {
    match (lv) {
      VBool(lb) => {
        if (b.op == "&&" && !lb.v) {
          return v_bool(false);
        }
        if (b.op == "||" && lb.v) {
          return v_bool(true);
        }
      },
      _ => {}
    }
  }
  let rv: Value = eval_expr(b.right, env);
  if (is_err(rv)) {
    return rv;
  }
  // An operator on a struct is its impl's method (#2706: `+` is `add`),
  // which the checker resolves by name; here the value's type dispatches it.
  let overload: string = struct_op_method(b.op, lv);
  if (overload.len() > 0) {
    return call_method(lv, overload, [rv], env.funcs, env.aliases, env.type_decls, env.outs);
  }
  if (is_checked_op(b.op)) {
    return eval_checked(b.op, lv, rv, checked_operand_type(b, lv));
  }
  // Ordering two structs or enums is `a.cmp(b) <op> 0`.
  if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
    if let VStruct(sv) = lv {
      let c: Value = call_method(lv, "cmp", [rv], env.funcs, env.aliases, env.type_decls, env.outs);
      if (is_err(c)) {
        return c;
      }
      return eval_binary(b.op, c, v_int(0));
    }
  }
  return eval_typed_binary(b.op, lv, rv, b.ty);
}

// struct_op_method names the impl method a binary operator on a struct value
// desugars to, or "" when the operand is not a struct or the operator has no
// method.
function struct_op_method(op: string, lv: Value): string {
  match (lv) {
    VStruct(_) => {
      if (op == "+") {
        return "add";
      }
      if (op == "-") {
        return "sub";
      }
      if (op == "*") {
        return "mul";
      }
      if (op == "/") {
        return "div";
      }
      if (op == "%") {
        return "rem";
      }
      return bit_op_method(op);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function bit_op_method(op: string): string {
  if (op == "&") {
    return "bitand";
  }
  if (op == "|") {
    return "bitor";
  }
  if (op == "^") {
    return "bitxor";
  }
  if (op == "<<") {
    return "shl";
  }
  if (op == ">>") {
    return "shr";
  }
  return "";
}

function eval_expr(e: ast.Expr, env: Env): Value {
  match (e) {
    ast.ExprNumber(n) => {
      return eval_number_literal(n.is_float, n.text, n.suffix);
    },
    ast.ExprBool(b) => {
      return v_bool(b.value);
    },
    ast.ExprString(s) => {
      return v_string(s.value);
    },
    ast.ExprIdent(id) => {
      return resolve_ident_value(id.name, env);
    },
    ast.ExprBinary(b) => {
      return eval_binary_expr(b, env);
    },
    ast.ExprUnary(u) => {
      let ov: Value = eval_expr(u.operand, env);
      if (is_err(ov)) {
        return ov;
      }
      // Unary minus on a struct is its impl's `neg` (#2706).
      if (u.op == "-") {
        if let VStruct(_) = ov {
          return call_method(ov, "neg", [], env.funcs, env.aliases, env.type_decls, env.outs);
        }
      }
      return eval_unary(u.op, ov);
    },
    ast.ExprCall(c) => {
      return eval_expr_call(c, env);
    },
    ast.ExprTuple(t) => {
      let elems: Value[] = [];
      let i: i32 = 0;
      while (i < t.elements.len()) {
        let ev: Value = eval_expr(t.elements[i], env);
        if (is_err(ev)) {
          return ev;
        }
        elems = elems.append(ev);
        i = i + 1;
      }
      return v_tuple(elems);
    },
    ast.ExprArray(a) => {
      let elems: Value[] = [];
      let i: i32 = 0;
      while (i < a.elements.len()) {
        let ev: Value = eval_expr(a.elements[i], env);
        if (is_err(ev)) {
          return ev;
        }
        elems = elems.append(ev);
        i = i + 1;
      }
      return v_arr(elems);
    },
    ast.ExprBytes(bs) => {
      let elems: Value[] = [];
      for b in bs.value {
        elems = elems.append(v_int(b as i32));
      }
      return v_arr(elems);
    },
    ast.ExprIndex(x) => {
      return eval_expr_index(x, env);
    },
    ast.ExprSlice(sl) => {
      return eval_expr_slice(sl, env);
    },
    ast.ExprStructLit(sl) => {
      return eval_expr_struct_lit(sl, env);
    },
    ast.ExprFieldAccess(fa) => {
      return eval_expr_field_access(fa, env);
    },
    ast.ExprLambda(lm) => {
      // Capture the lexical environment by snapshotting
      // env.names / env.values. The body resolves free
      // idents against this snapshot first; the call
      // site re-binds params on top.
      return VFunc {
        params: lm.params,
        ret_type: lm.ret_type,
        body: lm.body,
        captured_names: env.names,
        captured_values: env.values,
        captured_types: env.types,
        generic_name: "",
      };
    },
    ast.ExprMapLit(_) => {
      return v_err("Map literal: formatter-only node");
    },
    ast.ExprFString(_) => {
      return v_err("f-string: formatter-only node");
    },
    ast.ExprUnknown(u) => {
      // A float literal too large for f64 names its code, like the
      // checker and the asm front end report it (#6842).
      if (util.is_f64_range_kind(u.kind)) {
        return v_err("error[P002]: " + util.f64_range_message(u.kind));
      }
      return v_err("parser-side unknown: " + u.kind);
    },
    ast.ExprZero(z) => {
      // The zero of the declared type. It is not an error value: every
      // defer-using function declares its return temp this way, and a VErr
      // here short-circuits the whole body rather than waiting for a read
      // that never comes. The slot is overwritten before anything reads it,
      // so the TAG is what matters rather than the number — this plane is
      // untyped, and coerce_int_width has no arm for a float, a string or a
      // boolean to correct one later.
      return zero_value_of(z.type_name);
    }
  }
  return v_err("unhandled Expr variant");
}

function eval_expr_call(c: ast.ExprCall, env: Env): Value {
  return eval_expr_call_expect(c, env, "");
}

// eval_expr_call_expect is eval_expr_call with the type the call's binding
// declares, which pins a type parameter only the callee's result names.
function eval_expr_call_expect(c: ast.ExprCall, env: Env, expect: string): Value {
  if let ast.ExprLambda(lm) = c.callee {
    if (c.args.len() == 0 && lm.params.len() == 0 && (lm.origin == parser.ORIGIN_BLOCK || lm.origin == parser.ORIGIN_IF_EXPR || lm.origin == parser.ORIGIN_MATCH_EXPR)) {
      let step = eval_value_body(lm.body, env, expect);
      if (step.sig == 0 || step.sig == 1 && is_err(step.ret)) {
        return step.ret;
      }
      return VControl { box: step.ret, sig: step.sig };
    }
  }
  // Bare-ident callee → plain function call OR
  // closure call when the name is bound to a VFunc.
  // FieldAccess callee → method call.
  // Any other expression evaluates to a callee value
  // — VFunc → closure call, else error.
  let name: string = "";
  let is_method: boolean = false;
  let is_closure: boolean = false;
  let is_variant: boolean = false;
  let variant_name: string = "";
  let variant_enum: string = "";
  let recv: Value = v_absent();
  let closure_val: Value = v_absent();
  match (c.callee) {
    ast.ExprIdent(id) => {
      // If the name is bound in scope to a VFunc,
      // it's a closure call. Plain function names
      // shadow ident bindings via call_func's
      // walk, but a `let f = (...) => {…}`
      // binding is observable here.
      let bound: Value = env.lookup(id.name);
      match (bound) {
        VFunc(_) => {
          is_closure = true;
          closure_val = bound;
        },
        _ => {
          name = id.name;
        }
      }
      // `Circle(7)` / `Some(x)` / `JNumber(s)` — an enum-variant
      // constructor, which no function table declares. Checked
      // after the VFunc probe and behind user_func_exists so a
      // local closure or a user-declared function of the same
      // name still wins (#5990).
      if (!is_closure && variant_arity(name, env.type_decls) >= 0 && !user_func_exists(name, env.funcs)) {
        is_variant = true;
        variant_name = name;
        variant_enum = variant_owner(name, env.type_decls);
        if (id.ty.len() > 0) {
          variant_enum = id.ty;
        }
      }
    },
    ast.ExprFieldAccess(fa) => {
      // Qualified-name call: `Ns.func(...)` where
      // Ns is an imported namespace prefix. We
      // recognise this when fa.obj is a bare
      // ExprIdent (no chained method) AND there's
      // a function in env.funcs literally named
      // `Ns.func`. Falls back to method-call
      // semantics otherwise.
      let qualified_handled: boolean = false;
      match (fa.obj) {
        ast.ExprIdent(ns_id) => {
          let qname: string = ns_id.name + "." + fa.field;
          let qi: i32 = 0;
          let qfound: boolean = false;
          while (qi < env.funcs.len()) {
            if (env.funcs[qi].name == qname && env.funcs[qi].receiver_type.len() == 0) {
              qfound = true;
            }
            qi = qi + 1;
          }
          if (qfound) {
            name = qname;
            qualified_handled = true;
          }
        },
        _ => {}
      }
      if (!qualified_handled) {
        // `E.Some(x)` — a call whose callee object is a
        // bare identifier with no runtime value is a
        // payload enum-variant construction (the nullary
        // sibling `E.Red` is handled on the ExprFieldAccess
        // eval path). Anything with a real object value is a
        // method call.
        let variant_call: boolean = false;
        let static_type: string = "";
        match (fa.obj) {
          ast.ExprIdent(oid) => {
            // Ask the same question the ident evaluator
            // answers, not a narrower one (#6617). A raw
            // env lookup misses a CONST — which is a
            // zero-arg function, not a binding — so
            // `S.len()` was classified as a variant
            // construction and built a variant named
            // `len` instead of dispatching a method.
            let probe: Value = resolve_ident_value(oid.name, env);
            if (is_err(probe)) {
              variant_call = true;
              // `i32.zero()` / `Point.default()` — the object
              // names a TYPE carrying an associated function,
              // which has no runtime value either. Without
              // this the call built a variant named after the
              // FUNCTION (`zero`), and the next method
              // dispatched on that. A real variant still wins,
              // and its arity probe is the cheap test, so the
              // function-table scan only runs for a field no
              // variant answers to.
              if (variant_arity(fa.field, env.type_decls) < 0 && assoc_index(env.funcs, oid.name, fa.field) >= 0) {
                variant_call = false;
                static_type = oid.name;
              }
            }
          },
          _ => {}
        }
        if (variant_call) {
          is_variant = true;
          variant_name = fa.field;
          if let ast.ExprIdent(qid) = fa.obj {
            variant_enum = qualified_owner(qid.name, fa.field, env.type_decls);
          }
        } else {
          name = fa.field;
          is_method = true;
          if (static_type.len() > 0) {
            // The binding's annotation applies the type the call is made on
            // (`let s: G[f64] = G.splat(2.5)` reads `T.LANES` at T = f64), as
            // itself or inside the result it is returned in (`Result[G[f64],
            // string]`).
            let applied: string = applied_type_in(expect, static_type);
            if (applied.len() > 0) {
              static_type = applied;
            }
            recv = v_type(static_type);
          } else {
            recv = eval_expr(fa.obj, env);
            if (is_err(recv)) {
              return recv;
            }
            name = dyn_method_name(name, env.static_type_of(fa.obj), recv, env.funcs);
          }
        }
      }
    },
    _ => {
      // Treat as a value-producing expression
      // (e.g. immediate `() => { … }()`).
      let cv: Value = eval_expr(c.callee, env);
      if (is_err(cv)) {
        return cv;
      }
      match (cv) {
        VFunc(_) => {
          is_closure = true;
          closure_val = cv;
        },
        _ => {
          return v_err("call target is not callable");
        }
      }
    }
  }
  // A written type argument may name the caller's own type parameter
  // (`dd_splat[T](x)` inside a generic body), bound in this env.
  let targs: string[] = bound_type_args(c.type_args, env);
  // Evaluate args in order, propagating the first VErr. An argument that is
  // itself a generic call only its result types (`x.pow(seed(3.0))`) is
  // pinned by the parameter it fills, at the callee's parameters as the
  // receiver and the earlier arguments bind them.
  let (callee_fd, callee_known) = call_target(name, is_method, is_closure, recv, env);
  let arg_vals: Value[] = [];
  let i: i32 = 0;
  while (i < c.args.len()) {
    let av: Value = eval_pinned_arg(c, i, name, callee_fd, callee_known, is_method && !is_type_value(recv), recv, arg_vals, targs, env);
    if (is_err(av)) {
      return av;
    }
    arg_vals = arg_vals.append(av);
    i = i + 1;
  }
  if (is_variant) {
    return v_variant_of(variant_enum, variant_name, arg_vals);
  }
  if (is_method) {
    return call_method_targs(recv, name, arg_vals, targs, env.funcs, env.aliases, env.type_decls, env.outs);
  }
  if (is_closure) {
    return call_closure(closure_val, arg_vals, env.funcs, env.aliases, env.type_decls, env.outs);
  }
  return call_func_targs(name, arg_vals, targs, expect, env.funcs, env.aliases, env.type_decls, env.outs);
}

// eval_pinned_arg evaluates argument i of a call to `fd`: a generic call in
// that position is pinned by the parameter it fills, at `fd`'s type
// parameters as the receiver and the earlier arguments bind them.
function eval_pinned_arg(c: ast.ExprCall, i: i32, name: string, fd: parser.FuncDecl, known: boolean, has_recv: boolean, recv: Value, earlier: Value[], targs: string[], env: Env): Value {
  if (known && i < fd.params.len() && fd.type_params.len() > 0) {
    if let ast.ExprCall(ac) = c.args[i] {
      let pinned: Env = bind_tyargs(env, fd, has_recv, recv, earlier, targs, "");
      let arg_expect: string = bound_type_spelling(fd.params[i].type_name, pinned);
      if (arg_expect.len() > 0) {
        return eval_expr_call_expect(ac, env, arg_expect);
      }
    }
  }
  return eval_call_arg(c.args[i], name, i, env);
}

// call_target is the declaration a call names, for its parameter types: a
// free function by name, a method by the receiver value's type, an
// associated function by the type it is called on. A closure or a builtin
// has none.
function call_target(name: string, is_method: boolean, is_closure: boolean, recv: Value, env: Env): (parser.FuncDecl, boolean) {
  let none: parser.FuncDecl = parser.FuncDecl { stdlib: "", no_inline: false, name: "", receiver_name: "", receiver_type: "", receiver_own: false, type_params: [], params: [], ret_type: "", body: [], line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] };
  if (is_closure) {
    return (none, false);
  }
  let idx: i32 = 0 - 1;
  if (is_method) {
    idx = method_target_index(name, recv, env);
  } else {
    idx = free_target_index(name, env);
  }
  if (idx < 0) {
    return (none, false);
  }
  return (env.funcs[idx], true);
}

// method_target_index is the index in env.funcs of the method `name` the
// receiver value dispatches to, or of the associated function when the
// receiver is a type; -1 when there is none.
function method_target_index(name: string, recv: Value, env: Env): i32 {
  if let VType(tv) = recv {
    return assoc_index(env.funcs, tv.name, name);
  }
  let rt: string = value_type_name(recv);
  let i: i32 = 0;
  while (i < env.funcs.len()) {
    let fd: parser.FuncDecl = env.funcs[i];
    if (fd.name == name && fd.receiver_name.len() > 0 && runtime_receiver_name(fd.receiver_type) == rt) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function free_target_index(name: string, env: Env): i32 {
  let i: i32 = 0;
  while (i < env.funcs.len()) {
    let fd: parser.FuncDecl = env.funcs[i];
    if (fd.name == name && fd.receiver_name.len() == 0 && fd.receiver_type.len() == 0) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function is_type_value(v: Value): boolean {
  if let VType(_) = v {
    return true;
  }
  return false;
}

// bound_type_args reads each written type argument at the type parameters
// the env binds: `T` becomes `f64`, `Dual[T]` becomes `Dual[f64]`.
function bound_type_args(targs: string[], env: Env): string[] {
  let out: string[] = [];
  for ta in targs {
    out = out.append(bound_type_spelling(ta, env));
  }
  return out;
}

function bound_type_spelling(spelling: string, env: Env): string {
  if (spelling.len() == 0) {
    return spelling;
  }
  let ref: parser.TypeRef = parser.parse_type_ref(spelling);
  let base: string = ref.base;
  match (resolve_ident_value(base, env)) {
    VType(tv) => {
      base = tv.name;
    },
    VInt(iv) => {
      // A const parameter passed on (`filled[M]`) is the integer it binds.
      if (ref.args.len() == 0) {
        return util.i32_to_string(iv.v);
      }
    },
    _ => {}
  }
  let args: parser.TypeRef[] = [];
  for a in ref.args {
    args = args.append(parser.parse_type_ref(bound_type_spelling(parser.render_type_ref(a), env)));
  }
  return parser.render_type_ref(parser.TypeRef { ...ref, base: base, args: args });
}

function eval_expr_index(x: ast.ExprIndex, env: Env): Value {
  let av: Value = eval_expr(x.array, env);
  if (is_err(av)) {
    return av;
  }
  let iv: Value = eval_expr(x.index, env);
  if (is_err(iv)) {
    return iv;
  }
  if (!is_int_value(iv)) {
    return v_err("index must be an integer");
  }
  match (av) {
    VArr(arr) => {
      let i: i32 = index_in(iv, arr.elements.len());
      if (i < 0) {
        return index_abort(aborts.arr_oob(), value_text(iv), arr.elements.len());
      }
      return arr.elements[i];
    },
    VString(s) => {
      let si: i32 = index_in(iv, s.v.len());
      if (si < 0) {
        return index_abort(aborts.str_oob(), value_text(iv), s.v.len());
      }
      return v_int(s.v[si] as i32);
    },
    _ => {
      return v_err("can only index into an array or string");
    }
  }
  return v_err("unreachable index arm");
}

function eval_expr_slice(sl: ast.ExprSlice, env: Env): Value {
  let av: Value = eval_expr(sl.array, env);
  if (is_err(av)) {
    return av;
  }
  let sv: Value = eval_expr(sl.start, env);
  if (is_err(sv)) {
    return sv;
  }
  let sb: i32 = 0;
  let eb: i32 = 0;
  match (sv) {
    VInt(i) => {
      sb = i.v;
    },
    _ => {
      return v_err("slice start must be i32");
    }
  }
  if (sl.open_end) {
    // `x[lo:]` — the bound is the receiver's own length, read off
    // the value already evaluated above. sl.end is a placeholder.
    match (av) {
      VString(oes) => {
        eb = oes.v.len();
      },
      VArr(oea) => {
        eb = oea.elements.len();
      },
      _ => {
        return v_err("can only slice array or string");
      }
    }
  } else {
    let ev: Value = eval_expr(sl.end, env);
    if (is_err(ev)) {
      return ev;
    }
    match (ev) {
      VInt(i) => {
        eb = i.v;
      },
      _ => {
        return v_err("slice end must be i32");
      }
    }
  }
  match (av) {
    VString(s) => {
      // `s[a:b]` on a string is checked (#5634): an out-of-range
      // bound or a bound that splits a code point yields `None`
      // rather than an error. `slice_unchecked` keeps the trap.
      if (sb < 0 || eb > s.v.len() || sb > eb) {
        let slcn1: Value[] = [];
        return v_variant("None", slcn1);
      }
      if (!interp_char_boundary(s.v, sb) || !interp_char_boundary(s.v, eb)) {
        let slcn2: Value[] = [];
        return v_variant("None", slcn2);
      }
      return v_variant("Some", [v_string(slice_unchecked(s.v, sb, eb))]);
    },
    VArr(a) => {
      if (sb < 0 || eb > a.elements.len() || sb > eb) {
        return slice_abort(aborts.slice_range(), "slice", sb, eb, a.elements.len());
      }
      let out: Value[] = [];
      let i: i32 = sb;
      while (i < eb) {
        out = out.append(a.elements[i]);
        i = i + 1;
      }
      return VArr { elements: out, elem: a.elem, view: true, reserved: [] };
    },
    _ => {
      return v_err("can only slice array or string");
    }
  }
  return v_err("unreachable slice arm");
}

function eval_expr_struct_lit(sl: ast.ExprStructLit, env: Env): Value {
  // Struct-update `Name { ...base, f: v }`: start from the
  // base struct's fields, then overwrite the named overrides
  // (or append any not already present). Field lookup is by
  // name, so order is irrelevant.
  if (sl.has_base) {
    let bv: Value = eval_expr(sl.base, env);
    if (is_err(bv)) {
      return bv;
    }
    match (bv) {
      VStruct(sv) => {
        let bnames: string[] = sv.field_names;
        let bvals: Value[] = sv.field_values;
        let oi: i32 = 0;
        while (oi < sl.field_values.len()) {
          let ov2: Value = eval_expr(sl.field_values[oi], env);
          if (is_err(ov2)) {
            return ov2;
          }
          let oname: string = sl.field_names[oi];
          let replaced: boolean = false;
          let bi: i32 = 0;
          while (bi < bnames.len()) {
            if (bnames[bi] == oname) {
              bvals = bvals.with(bi, ov2);
              replaced = true;
            }
            bi = bi + 1;
          }
          if (!replaced) {
            bnames = bnames.append(oname);
            bvals = bvals.append(ov2);
          }
          oi = oi + 1;
        }
        return v_struct_at(sl.type_name, bnames, bvals, struct_targs(sl.type_name, env));
      },
      _ => {
        return v_err("struct update base is not a struct");
      }
    }
  }
  // Evaluate each field's value in declaration order,
  // propagating the first VErr. Field names are
  // copied as-is from the parser; the runtime treats
  // them as opaque strings for lookup.
  let fvs: Value[] = [];
  let i: i32 = 0;
  while (i < sl.field_values.len()) {
    let fv: Value = eval_expr(sl.field_values[i], env);
    if (is_err(fv)) {
      return fv;
    }
    fvs = fvs.append(fv);
    i = i + 1;
  }
  return v_struct_at(sl.type_name, sl.field_names, fvs, struct_targs(sl.type_name, env));
}

// eval_var_init evaluates a binding's initialiser; a call sees the declared
// type, so a generic only its result names (`let d: Dual[f64] = seed(2.0)`)
// binds its parameter from it.
function eval_var_init(v: ast.StmtVar, env: Env): Value {
  if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name)) {
    if let ast.ExprCall(c) = v.init {
      return eval_expr_call_expect(c, env, v.type_name);
    }
  }
  return eval_expr(v.init, env);
}

// struct_targs is the type arguments a struct literal is built at: the ones
// written (`Box[i32] { … }`), else the bindings in scope for the struct's
// type parameters, as a generic body has them. Empty when a parameter is
// unbound.
function struct_targs(type_name: string, env: Env): string[] {
  let written: parser.TypeRef = parser.parse_type_ref(type_name);
  let out: string[] = [];
  if (written.args.len() > 0) {
    for a in written.args {
      out = out.append(parser.render_type_ref(a));
    }
    return out;
  }
  for sd in env.type_decls {
    if (sd.name == type_name) {
      for tp in sd.type_params {
        match (resolve_ident_value(tp, env)) {
          VType(tv) => {
            out = out.append(tv.name);
          },
          _ => {
            return [];
          }
        }
      }
      return out;
    }
  }
  return [];
}

function eval_expr_field_access(fa: ast.ExprFieldAccess, env: Env): Value {
  // Evaluate the object. Field can be:
  //   * struct field name (linear scan)
  //   * tuple index `0` / `1` / … (string-of-digits)
  // The parser stores both shapes as a bare string;
  // we disambiguate on the receiver's runtime type.
  let ov: Value = eval_expr(fa.obj, env);
  if (is_err(ov)) {
    // `E.Red` — a field access whose object is a bare
    // identifier that resolves to no runtime value is a
    // nullary enum-variant construction. The parser
    // desugars enum variants into payload-less variant
    // structs named for the variant, so the value is a
    // zero-field VStruct tagged with the variant name; a
    // qualified variant pattern `E.Red` matches it by its
    // final path segment (see StmtMatch / variant_simple_
    // name). Payload variants `E.Some(x)` are constructed
    // on the ExprCall path. On a valid (checker-passed)
    // program a bare undefined-identifier object only
    // arises for an enum type name.
    match (fa.obj) {
      ast.ExprIdent(qid) => {
        let no_vals: Value[] = [];
        return v_variant_of(qualified_owner(qid.name, fa.field, env.type_decls), fa.field, no_vals);
      },
      _ => {
        return ov;
      }
    }
  }
  match (ov) {
    VStruct(sv) => {
      let i: i32 = 0;
      while (i < sv.field_names.len()) {
        if (sv.field_names[i] == fa.field) {
          return sv.field_values[i];
        }
        i = i + 1;
      }
      return v_err("struct " + sv.type_name + " has no field `" + fa.field + "`");
    },
    VTuple(tv) => {
      let idx: i32 = util.digits_to_i32(fa.field);
      if (idx < 0 || idx >= tv.elements.len()) {
        return v_err("tuple index `" + fa.field + "` out of range");
      }
      return tv.elements[idx];
    },
    VHandle(hv) => {
      if (fa.field == "fd") {
        return handle_fd(hv);
      }
      return v_err(handle_kind(hv) + " has no field `" + fa.field + "`");
    },
    _ => {
      return v_err("can only field-access a struct or tuple");
    }
  }
  return v_err("unreachable field-access arm");
}

// call_func looks up `name` in the function table, binds args
// to params in a fresh env that shares the same funcs table, and
// evals the body. A missing function or arity mismatch surfaces
// as VErr. The callee runs with its own scope — caller bindings
// are NOT visible (no closures yet).
// call_method dispatches on the receiver's struct type_name.
// Searches funcs for a method-shaped FuncDecl whose name and
// receiver_type both match — VStruct receivers nominate
// receiver_type by exact name (so a method declared on
// `(c: Circle)` matches a VStruct whose type_name is "Circle").
// The receiver is bound to `receiver_name` first, then the
// remaining args follow in declaration order.
// is_variant_of_alias_interp checks whether struct_name is a
// listed variant of union_name in aliases. Used by call_method
// to dispatch methods declared on a union receiver type when
// the runtime receiver is one of its variant structs.
function is_variant_of_alias_interp(struct_name: string, union_name: string, aliases: parser.TypeAlias[]): boolean {
  let i: i32 = 0;
  while (i < aliases.len()) {
    if (aliases[i].name == union_name) {
      let j: i32 = 0;
      while (j < aliases[i].variants.len()) {
        if (aliases[i].variants[j] == struct_name) {
          return true;
        }
        j = j + 1;
      }
      return false;
    }
    i = i + 1;
  }
  return false;
}

// is_array_recv_type reports an array receiver spelling — `T[]` for a type
// variable or a pinned element like `i32[]` / `string[]`. Both register under
// the single "Array" name, so one untyped VArr answers to all of them with
// nothing to disambiguate here; a receiver whose element does not fit is the
// checker's E043, not the interpreter's problem.
//
// A leading `[` is a slice (`[T]`), a different namespace. A nested element
// (`T[][]`) is E021 and never reaches this.
function is_array_recv_type(t: string): boolean {
  if (t.len() < 3) {
    return false;
  }
  if (t[0] == b'[') {
    return false;
  }
  let n: i32 = t.len();
  if (t[n - 2] != b'[' || t[n - 1] != b']') {
    return false;
  }
  // Nested: the element itself ends in `[]`.
  if (n >= 5 && t[n - 4] == b'[' && t[n - 3] == b']') {
    return false;
  }
  return true;
}

// name_ends_with reports whether `nm` is `suffix` or ends with it, which is
// how a bundler-mangled `<mod>__<name>` is recognised as `<name>`.
function name_ends_with(nm: string, suffix: string): boolean {
  if (nm == suffix) {
    return true;
  }
  if (nm.len() <= suffix.len()) {
    return false;
  }
  return slice_unchecked(nm, nm.len() - suffix.len(), nm.len()) == suffix;
}

// variant_simple_name returns the final `.`-separated segment of a
// (possibly qualified) variant name — `E.Red` → `Red`,
// `lexer.TokIdent` → `TokIdent`, `Red` → `Red`. Used to match a
// qualified variant pattern against a runtime enum value, whose
// type_name is the bare variant name.
function variant_simple_name(name: string): string {
  let last_dot: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < name.len()) {
    if (name[i] == b'.') {
      last_dot = i;
    }
    i = i + 1;
  }
  if (last_dot >= 0) {
    return slice_unchecked(name, last_dot + 1, name.len()) + "";
  }
  return name;
}

// aliases_with_enums appends a synthetic union alias (enum name → variant
// names) for each enum the variant structs in `types` name as their owner —
// the module's own enums and the injected builtin ones (IoError, Body)
// alike. Enums desugar to variant structs but not to a TypeAlias, so
// without this a method declared on the enum type — `function (s: Shape)
// area()` — wouldn't dispatch on a variant value: is_variant_of_alias_interp
// only consults the alias table.
function aliases_with_enums(aliases: parser.TypeAlias[], types: parser.StructDecl[]): parser.TypeAlias[] {
  let out: parser.TypeAlias[] = aliases;
  let base: i32 = aliases.len();
  let i: i32 = 0;
  while (i < types.len()) {
    let owner: string = types[i].enum_owner;
    if (owner.len() > 0) {
      let k: i32 = base;
      while (k < out.len() && out[k].name != owner) {
        k = k + 1;
      }
      if (k == out.len()) {
        out = out.append(parser.TypeAlias { name: owner, variants: [types[i].name], variant_args: [], variant_lines: [], type_params: [], line: 0, col: 0, is_pub: true, is_package: false, module: "" });
      } else {
        out = out.with(k, parser.TypeAlias { ...out[k], variants: out[k].variants.append(types[i].name) });
      }
    }
    i = i + 1;
  }
  return out;
}

// call_closure runs a VFunc with the given args. The closure's
// captured names + values seed the body's env so free idents in
// the lambda body resolve against the enclosing function's
// scope. Args bind on top in declaration order.
function call_closure(cv: Value, args: Value[], funcs: parser.FuncDecl[], aliases: parser.TypeAlias[], type_decls: parser.StructDecl[], outs: OutTable): Value {
  let fv: VFunc = VFunc { params: [], ret_type: "", body: [], captured_names: [], captured_values: [], captured_types: [], generic_name: "" };
  match (cv) {
    VFunc(v) => {
      fv = v;
    },
    _ => {
      return v_err("call_closure: not a VFunc");
    }
  }
  if (fv.generic_name.len() > 0) {
    return call_func_targs(fv.generic_name, args, [], "", funcs, aliases, type_decls, outs);
  }
  if (args.len() != fv.params.len()) {
    return v_err("arity mismatch calling closure");
  }
  let env: Env = Env { names: fv.captured_names, values: fv.captured_values, types: fv.captured_types, funcs: funcs, aliases: aliases, type_decls: type_decls, outs: outs, ret: "" };
  let j: i32 = 0;
  while (j < fv.params.len()) {
    env = env.bind_decl(fv.params[j].name, args[j], fv.params[j].type_name);
    j = j + 1;
  }
  let step: StepResult = eval_block(fv.body, env);
  // Falling off the end is how a void body returns, exactly as it is for a
  // named function — native's callFunc yields Void{} there rather than
  // failing, and a non-void body that does it is a checker error, not the
  // interpreter's to catch.
  if (step.sig != 1) {
    return v_void();
  }
  // A `?` unwind stops at the frame that owns it: unwrap_try turns the
  // in-flight VTry back into the None / Err box this call returns (#5990).
  return coerce_int_width(unwrap_try(step.ret), fv.ret_type);
}

// assoc_index finds the receiver-LESS associated function `<type_name>.<name>`
// — what `impl Zero for i32 { function zero(): Self { … } }` desugars to: an
// empty receiver_name with receiver_type naming the impl type. flatten leaves
// such a function's name unmangled (it keys mangling off receiver_type), so
// the pair is the whole key. A parametric impl's function is declared on
// `Dual[T]` and called on `Dual[f64]`, so the match is on the base name. -1
// when there is none.
function assoc_index(funcs: parser.FuncDecl[], type_name: string, name: string): i32 {
  let base: string = util.base_type_name(type_name);
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_name.len() == 0 && util.base_type_name(funcs[i].receiver_type) == base) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// applied_type_in is the first application of `base` in the type spelling
// `t`, `t` itself included, or "" when `t` names none.
function applied_type_in(t: string, base: string): string {
  if (t.len() == 0) {
    return "";
  }
  return applied_in_ref(parser.parse_type_ref(t), base);
}

function applied_in_ref(r: parser.TypeRef, base: string): string {
  if (r.base == base) {
    return parser.render_type_ref(r);
  }
  for a in r.args {
    let hit: string = applied_in_ref(a, base);
    if (hit.len() > 0) {
      return hit;
    }
  }
  return "";
}

// struct_type_params is the declared type parameters of struct `name`.
function struct_type_params(decls: parser.StructDecl[], name: string): string[] {
  for d in decls {
    if (d.name == name) {
      return d.type_params;
    }
  }
  let none: string[] = [];
  return none;
}

// call_assoc runs `<type_name>.<name>(args)`. The declared return type is the
// impl type (`Self` was rewritten to it at parse time), so coercing the result
// to it gives `i64.zero()` a 64-bit zero rather than the i32 its `return 0`
// body literally evaluates to.
function call_assoc(type_name: string, name: string, args: Value[], funcs: parser.FuncDecl[], aliases: parser.TypeAlias[], type_decls: parser.StructDecl[], outs: OutTable): Value {
  let ai: i32 = assoc_index(funcs, type_name, name);
  if (ai < 0) {
    return v_err("undefined associated function `" + name + "` on `" + type_name + "`");
  }
  let fd: parser.FuncDecl = funcs[ai];
  if (args.len() != fd.params.len()) {
    return v_err("arity mismatch calling `" + type_name + "." + name + "`");
  }
  let env: Env = Env { ...new_module_env(funcs, aliases, type_decls, outs), ret: fd.ret_type };
  // The applied type's arguments bind a parametric impl's type parameters
  // (`Dual[f64].LANES()` reads `T.LANES` at T = f64), or the struct's own
  // where the function declares none, as a derived `default()` does.
  let targs: parser.TypeRef[] = parser.parse_type_ref(type_name).args;
  let tps: string[] = fd.type_params;
  if (tps.len() == 0) {
    tps = struct_type_params(type_decls, util.base_type_name(type_name));
  }
  let t: i32 = 0;
  while (t < tps.len() && t < targs.len()) {
    env = env.bind(tps[t], v_type(parser.render_type_ref(targs[t])));
    t = t + 1;
  }
  let j: i32 = 0;
  while (j < fd.params.len()) {
    env = env.bind_decl(fd.params[j].name, args[j], fd.params[j].type_name);
    j = j + 1;
  }
  let step: StepResult = eval_block(fd.body, env);
  if (step.sig != 1) {
    return v_void();
  }
  return coerce_int_width(unwrap_try(step.ret), fd.ret_type);
}

// tyarg_of_value names the type a runtime value pins a type parameter to —
// the primitive keyword for a scalar, the declared name for a struct. "" when
// the value carries no name to dispatch on.
function tyarg_of_value(v: Value): string {
  match (v) {
    VInt(n) => {
      return int_type_name(n);
    },
    VInt64(w) => {
      return wide_type_name(w);
    },
    VUint(_) => {
      return "u32";
    },
    VBool(_) => {
      return "boolean";
    },
    VString(_) => {
      return "string";
    },
    VFloat(_) => {
      return "f64";
    },
    VFloat32(_) => {
      return "f32";
    },
    VLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    VStruct(sv) => {
      if (sv.targs.len() == 0) {
        return sv.type_name;
      }
      let name: string = util.base_type_name(sv.type_name) + "[";
      let i: i32 = 0;
      while (i < sv.targs.len()) {
        if (i > 0) {
          name = name + ", ";
        }
        name = name + sv.targs[i];
        i = i + 1;
      }
      return name + "]";
    },
    _ => {
      return "";
    }
  }
}

// tyarg_match_names is tyarg_match on two type spellings: the declared one
// names `tp` outright, or applies the same base as the value's and names it
// in a corresponding argument (`Dual[T]` against `Dual[f64]`).
function tyarg_match_names(decl: string, tp: string, actual: string): string {
  if (decl == tp) {
    return actual;
  }
  if (actual.len() == 0 || util.index_of_sub(decl, "[") < 0) {
    return "";
  }
  let dref: parser.TypeRef = parser.parse_type_ref(decl);
  let aref: parser.TypeRef = parser.parse_type_ref(actual);
  if (dref.base != aref.base || dref.args.len() != aref.args.len()) {
    return "";
  }
  let i: i32 = 0;
  while (i < dref.args.len()) {
    let r: string = tyarg_match_names(parser.render_type_ref(dref.args[i]), tp, parser.render_type_ref(aref.args[i]));
    if (r.len() > 0) {
      return r;
    }
    i = i + 1;
  }
  return "";
}

// tyarg_match reads the concrete type a type parameter takes from ONE
// declared/actual pair: a parameter declared `T` takes the argument's own
// type, one declared `T[]` its first element's (its stamped element type when
// it is empty). "" when the declaration does not mention `tp`, or the value
// names no type.
function tyarg_match(decl: string, tp: string, v: Value): string {
  if (decl == tp) {
    return tyarg_of_value(v);
  }
  if (decl == tp + "[]" || decl == "[" + tp + "]") {
    match (v) {
      VArr(a) => {
        if (a.elements.len() > 0) {
          return tyarg_of_value(a.elements[0]);
        }
        return a.elem;
      },
      _ => {}
    }
    return "";
  }
  return tyarg_match_names(decl, tp, tyarg_of_value(v));
}

// bind_tyargs binds each of a generic function's bounded type parameters to
// the type its receiver / arguments carry. Generics are otherwise ERASED in
// this engine — the binding exists so a receiver-less trait call in the body
// (`let acc: T = T.zero();`) has a type to dispatch on, which no runtime value
// supplies. An explicit type argument at the call (`chunk[V2](8)`) binds its
// parameter outright; a parameter nothing pins stays unbound and that call
// still errors. Bound BEFORE the parameters so a value parameter of the same
// name shadows it.
function bind_tyargs(env: Env, fd: parser.FuncDecl, has_recv: boolean, recv: Value, args: Value[], type_args: string[], expect: string): Env {
  let e: Env = env;
  let t: i32 = 0;
  while (t < fd.type_params.len()) {
    let tp: string = fd.type_params[t];
    let concrete: string = "";
    // A written list names every parameter in order, the erased ones too.
    let at: i32 = util.index_of_str(fd.all_type_params, tp);
    if (at < 0) {
      at = t;
    }
    if (at < type_args.len()) {
      concrete = type_args[at];
    }
    if (parser.is_const_arg(concrete)) {
      e = e.bind(tp, v_int(util.digits_to_i32(concrete)));
      t = t + 1;
      continue;
    }
    if (has_recv && concrete.len() == 0) {
      concrete = tyarg_match(fd.receiver_type, tp, recv);
    }
    let j: i32 = 0;
    while (j < fd.params.len() && j < args.len()) {
      if (concrete.len() == 0) {
        concrete = tyarg_match(fd.params[j].type_name, tp, args[j]);
      }
      j = j + 1;
    }
    // A parameter no argument pins may be pinned by the binding's annotation
    // (`let d: Dual[f64] = seed(2.0)`), through the declared result.
    if (concrete.len() == 0 && expect.len() > 0) {
      concrete = tyarg_match_names(fd.ret_type, tp, expect);
    }
    // A parameter cannot pin itself: an empty array reaching a generic
    // from another generic carries THAT one's abstract element spelling.
    if (concrete.len() > 0 && !util.has_str(fd.type_params, concrete)) {
      e = e.bind(tp, v_type(concrete));
    }
    t = t + 1;
  }
  return e;
}

function wide_type_name(w: VInt64): string {
  if (w.ptr) {
    return "usize";
  }
  if (w.unsigned) {
    return "u64";
  }
  return "i64";
}

// value_type_name derives the receiver-type name a runtime value dispatches
// under: a struct's declared type_name, and the language's primitive
// type-keyword for a scalar so `function (s: string) len(): i32 { … }`
// dispatches. Arrays share the single "Array" namespace the checker registers
// `(xs: T[])` methods under. "" for a value with no name to dispatch on.
function value_type_name(v: Value): string {
  match (v) {
    VStruct(sv) => {
      return sv.type_name;
    },
    VString(_) => {
      return "string";
    },
    VInt(n) => {
      return int_type_name(n);
    },
    VInt64(iv64) => {
      return wide_type_name(iv64);
    },
    VUint(_) => {
      return "u32";
    },
    VBool(_) => {
      return "boolean";
    },
    VFloat(_) => {
      return "f64";
    },
    VFloat32(_) => {
      return "f32";
    },
    VLanes(l) => {
      return typeinfo.lanes_spelling(l.width);
    },
    VArr(a) => {
      if (a.view) {
        return "ArrayView";
      }
      return "Array";
    },
    VMap(_) => {
      return "Map";
    },
    VHandle(hv) => {
      return handle_kind(hv);
    },
    _ => {
      return "";
    }
  }
}

// has_receiver_method reports whether some `(r: recv_type) name(...)` is
// declared, generic arguments aside.
function has_receiver_method(funcs: parser.FuncDecl[], recv_type: string, name: string): boolean {
  for fd in funcs {
    if (fd.name == name && fd.receiver_name.len() > 0 && runtime_receiver_name(fd.receiver_type) == recv_type) {
      return true;
    }
  }
  return false;
}

// Runtime arrays retain their source namespace. String views share the
// string method surface, as the checker specifies.
function runtime_receiver_name(spelling: string): string {
  if (parser.spelling_is_view(spelling)) {
    return "ArrayView";
  }
  if (is_array_recv_type(spelling)) {
    return "Array";
  }
  if (spelling == "str") {
    return "string";
  }
  return util.base_type_name(spelling);
}

// dyn_method_name resolves the method a call NAMES to the definition the
// receiver's declared type MEANS: for a `dyn` receiver, the receiver type's
// method whose `dyn_traits` meets the dyn's trait set (parser.dyn_provider_name),
// whatever spelling a claim or a cross-module rename gave it. Receivers with no
// declared dyn type keep the written name.
function dyn_method_name(name: string, decl_ty: string, recv: Value, funcs: parser.FuncDecl[]): string {
  let traits: string[] = parser.dyn_trait_set(decl_ty);
  if (traits.len() == 0) {
    return name;
  }
  return parser.dyn_provider_name(funcs, dispatch_type_name(recv), traits, name);
}

// dispatch_type_name is the type a method call on v dispatches on: a variant's
// enum when it was built as one, so `Shape.Square(3)` does not reach a struct
// named Square's impl, else value_type_name.
function dispatch_type_name(v: Value): string {
  if let VStruct(sv) = v {
    if (sv.owner.len() > 0) {
      return sv.owner;
    }
  }
  return value_type_name(v);
}

// map_key_index is the slot of `m` whose key equals `k`, or -1. A struct or
// enum key compares through its type's cmp.Eq `eq`, derived or written by
// hand, as the compiled map's keyed probe does; any other key by value.
function map_key_index(m: VMap, k: Value, funcs: parser.FuncDecl[], aliases: parser.TypeAlias[], type_decls: parser.StructDecl[], outs: OutTable): i32 {
  let by_eq: boolean = has_key_eq(k, funcs, aliases);
  let i: i32 = 0;
  while (i < m.keys.len()) {
    if (by_eq) {
      if let VBool(b) = call_method(m.keys[i], "eq", [k], funcs, aliases, type_decls, outs) {
        if (b.v) {
          return i;
        }
      }
    } else if (value_eq(m.keys[i], k)) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// has_key_eq reports a struct or enum value whose type has a cmp.Eq `eq`.
function has_key_eq(k: Value, funcs: parser.FuncDecl[], aliases: parser.TypeAlias[]): boolean {
  if let VStruct(sv) = k {
    for fd in funcs {
      let base: string = util.base_type_name(fd.receiver_type);
      if (fd.name == "eq" && fd.impl_trait == "Eq" && (base == sv.type_name || variant_of_enum(k, base, aliases))) {
        return true;
      }
    }
  }
  return false;
}

// map_iter_method is Map.iter()'s cursor: snapshots of the map's columns and a
// position `advance` moves in place, as the compiled cursor does.
function map_iter_method(it: VStruct, name: string): Value {
  let pos: i32 = 0;
  if let VCellI(pc) = it.field_values[2] {
    pos = pc.c.get();
    if (name == "advance") {
      pc.c.set(pos + 1);
      return v_void();
    }
  }
  let col: Value[] = [];
  if (name == "key" || name == "has_next") {
    col = vals_of(it.field_values[0]);
  } else if (name == "value") {
    col = vals_of(it.field_values[1]);
  } else {
    return v_err("MapIter has no method `" + name + "`");
  }
  if (name == "has_next") {
    return v_bool(pos < col.len());
  }
  if (pos >= col.len()) {
    return index_abort(aborts.arr_oob(), util.i32_to_string(pos), col.len());
  }
  return col[pos];
}

function vals_of(v: Value): Value[] {
  if let VArr(a) = v {
    return a.elements;
  }
  return [];
}

function call_method(recv: Value, name: string, args: Value[], funcs: parser.FuncDecl[], aliases: parser.TypeAlias[], type_decls: parser.StructDecl[], outs: OutTable): Value {
  return call_method_targs(recv, name, args, [], funcs, aliases, type_decls, outs);
}

// call_method_targs is call_method with the call's explicit type arguments.
function call_method_targs(recv: Value, name: string, args: Value[], type_args: string[], funcs: parser.FuncDecl[], aliases: parser.TypeAlias[], type_decls: parser.StructDecl[], outs: OutTable): Value {
  // `i32.zero()` / `T.zero()` — the receiver is a TYPE, not a value, so no
  // value-receiver method can match and only the associated table applies.
  match (recv) {
    VType(tv) => {
      return call_assoc(tv.name, name, args, funcs, aliases, type_decls, outs);
    },
    VCell(uc) => {
      return cell_method(uc, name, args);
    },
    VHandle(hv) => {
      if (is_handle_method(handle_kind(hv), name)) {
        return handle_method(hv, name, args);
      }
    },
    VStruct(sv) => {
      if (sv.type_name == "MapIter") {
        return map_iter_method(sv, name);
      }
    },
    _ => {}
  }
  // Built-in VMap methods are dispatched ahead of the user
  // FuncDecl walk — set / get_or / has / delete / len /
  // keys / values are baked in rather than user-defined.
  // String and array carry the zero-import builtin methods the
  // native compiler recognises — `.len()` on both, `.bytes()` /
  // `.as_bytes()` on strings, `.append(x)` / `.with(i, x)` on
  // arrays (the method mirrors of the bare builtins in call_func).
  // Unknown method names fall through to the user-method walk below
  // rather than erroring, so user-declared string/array receivers
  // still dispatch.
  match (recv) {
    VString(sv) => {
      if (name == "len") {
        if (args.len() != 0) {
          return v_err("string.len: takes no arguments");
        }
        return v_int(sv.v.len());
      }
      // `s.bytes()` / `s.as_bytes()` — one VInt per UTF-8 byte. The two
      // diverge on aliasing under codegen (bytes copies, as_bytes shares
      // the payload); a boxed Value tree has no aliasing to share, so
      // both return an independent array, as the native interp does.
      if (name == "bytes" || name == "as_bytes") {
        if (args.len() != 0) {
          return v_err("string." + name + ": takes no arguments");
        }
        let bs: Value[] = [];
        let bi: i32 = 0;
        while (bi < sv.v.len()) {
          bs = bs.append(v_int(sv.v[bi] as i32));
          bi = bi + 1;
        }
        return VArr { elements: bs, elem: "u8", view: name == "as_bytes", reserved: [] };
      }
    },
    VArr(av) => {
      if (name == "len") {
        if (args.len() != 0) {
          return v_err("array.len: takes no arguments");
        }
        return v_int(av.elements.len());
      }
      if (name == "with" && !av.view) {
        if (args.len() != 2) {
          return v_err("array.with: need 2 args");
        }
        if (!is_i32_arg(args[0])) {
          return v_err("array.with: index must be an integer");
        }
        let wi: i32 = vint_bits(args[0]);
        if (wi < 0 || wi >= av.elements.len()) {
          return index_abort(aborts.arr_oob(), util.i32_to_string(wi), av.elements.len());
        }
        let wout: Value[] = [];
        let wj: i32 = 0;
        while (wj < av.elements.len()) {
          if (wj == wi) {
            wout = wout.append(args[1]);
          } else {
            wout = wout.append(av.elements[wj]);
          }
          wj = wj + 1;
        }
        return v_arr(wout);
      }
      if (name == "append" && !av.view) {
        if (args.len() != 1) {
          return v_err("array.append: need 1 arg");
        }
        // Build a fresh element buffer element-by-element
        // rather than appending onto `av.elements`, which is
        // shared with the receiver's binding — appending onto
        // the shared buffer directly can alias it and mutate
        // the original array in place. Mirrors the copy-loop
        // the VMap methods use for the same reason.
        let out: Value[] = [];
        let ai: i32 = 0;
        while (ai < av.elements.len()) {
          out = out.append(av.elements[ai]);
          ai = ai + 1;
        }
        out = out.append(args[0]);
        return v_arr(out);
      }
    },
    VMap(m) => {
      if (name == "insert") {
        if (args.len() != 2) {
          return v_err("map.set: need 2 args");
        }
        let i: i32 = map_key_index(m, args[0], funcs, aliases, type_decls, outs);
        if (i >= 0) {
          // Replace value at slot i.
          let nvs: Value[] = [];
          let j: i32 = 0;
          while (j < m.values.len()) {
            if (j == i) {
              nvs = nvs.append(args[1]);
            } else {
              nvs = nvs.append(m.values[j]);
            }
            j = j + 1;
          }
          return VMap { keys: m.keys, values: nvs };
        }
        return VMap { keys: m.keys.append(args[0]), values: m.values.append(args[1]) };
      }
      if (name == "get") {
        if (args.len() != 1) {
          return v_err("map.get: need 1 arg");
        }
        let oi: i32 = map_key_index(m, args[0], funcs, aliases, type_decls, outs);
        if (oi >= 0) {
          return v_variant("Some", [m.values[oi]]);
        }
        let no_payload: Value[] = [];
        return v_variant("None", no_payload);
      }
      if (name == "get_or") {
        if (args.len() != 2) {
          return v_err("map.get_or: need 2 args");
        }
        let gi: i32 = map_key_index(m, args[0], funcs, aliases, type_decls, outs);
        if (gi >= 0) {
          return m.values[gi];
        }
        return args[1];
      }
      if (name == "contains") {
        if (args.len() != 1) {
          return v_err("map.contains: need 1 arg");
        }
        return v_bool(map_key_index(m, args[0], funcs, aliases, type_decls, outs) >= 0);
      }
      if (name == "remove") {
        if (args.len() != 1) {
          return v_err("map.remove: need 1 arg");
        }
        // core/map deletes by swap-with-last, so the last entry takes the
        // deleted one's place in iteration order.
        let at: i32 = map_key_index(m, args[0], funcs, aliases, type_decls, outs);
        let last: i32 = m.keys.len() - 1;
        let nk: Value[] = [];
        let nv: Value[] = [];
        let di: i32 = 0;
        while (di < m.keys.len()) {
          if (di == at && at != last) {
            nk = nk.append(m.keys[last]);
            nv = nv.append(m.values[last]);
          } else if (at < 0 || di != last) {
            nk = nk.append(m.keys[di]);
            nv = nv.append(m.values[di]);
          }
          di = di + 1;
        }
        return v_map(nk, nv);
      }
      if (name == "len") {
        return v_int(m.keys.len());
      }
      if (name == "keys") {
        return v_arr(m.keys);
      }
      if (name == "values") {
        return v_arr(m.values);
      }
      if (name == "cleared") {
        return v_map_new();
      }
      if (name == "iter") {
        return VStruct { type_name: "MapIter", field_names: ["keys", "values", "pos"], field_values: [v_arr(m.keys), v_arr(m.values), VCellI { c: cell_new(0), is_char: false, is_bool: false }], owner: "", targs: [] };
      }
    },
    _ => {}
  }
  // A fn-valued TUPLE element: `(t.0)(5)` parses as a call whose callee is a
  // field access, so it arrives here as method dispatch (#6611). Checked
  // ahead of the recv_type derivation below, which has no name for a tuple
  // and would reject it first. A tuple has no methods, so a numeric index
  // holding a closure is the only thing this spelling can mean.
  match (recv) {
    VTuple(tv) => {
      let ti: i32 = util.digits_to_i32(name);
      if (ti >= 0 && ti < tv.elements.len()) {
        match (tv.elements[ti]) {
          VFunc(_) => {
            return call_closure(tv.elements[ti], args, funcs, aliases, type_decls, outs);
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  let recv_type: string = dispatch_type_name(recv);
  if (recv_type.len() == 0) {
    return v_err("method `" + name + "`: receiver has no type name to dispatch on");
  }
  // A byte is an int at runtime: `s[i]` and `b as u8` both evaluate to a
  // VInt, so a `(b: u8)` method is reachable from an i32-named receiver when
  // no i32 method claims the name.
  let own_method: boolean = has_receiver_method(funcs, recv_type, name);
  let byte_recv: boolean = recv_type == "i32" && !own_method;
  let i: i32 = 0;
  while (i < funcs.len()) {
    let fd: parser.FuncDecl = funcs[i];
    // Generic struct arguments are erased from VStruct's nominal name.
    // Method registration uses that same base identity. Keep the full module
    // prefix so unrelated structs with the same short name cannot match.
    let receiver_base: string = runtime_receiver_name(fd.receiver_type);
    let rt_match: boolean = receiver_base == recv_type;
    if (!rt_match && byte_recv && fd.receiver_type == "u8") {
      rt_match = true;
    }
    // Union-receiver methods: a method declared on a union
    // (`function (sh: Shape) area()`) matches when recv's
    // struct type_name is in the union's variant list, and its own type
    // declares no method of the name: a struct named like a variant keeps
    // its own.
    if (!rt_match && !own_method && variant_of_enum(recv, receiver_base, aliases)) {
      rt_match = true;
    }
    // Array-receiver methods, all of std/array: every array value answers
    // to every `(xs: T[])` method, the single "Array" namespace the
    // checker registers them under.
    if (!rt_match && recv_type == "Array" && is_array_recv_type(fd.receiver_type)) {
      rt_match = true;
    }
    if (fd.name == name && fd.receiver_name.len() > 0 && rt_match) {
      if (args.len() != fd.params.len()) {
        return v_err("arity mismatch calling method `" + name + "`");
      }
      let env: Env = Env { ...new_module_env(funcs, aliases, type_decls, outs), ret: fd.ret_type };
      env = bind_tyargs(env, fd, true, recv, args, type_args, "");
      // No declared type on the receiver: an array receiver is always the
      // abstract `T[]`, whose element spelling would self-pin an empty
      // VArr. `self` is never a trait object, so nothing asks for it.
      env = env.bind(fd.receiver_name, recv);
      let j: i32 = 0;
      while (j < fd.params.len()) {
        env = env.bind_decl(fd.params[j].name, args[j], fd.params[j].type_name);
        j = j + 1;
      }
      let step: StepResult = eval_block(fd.body, env);
      if (step.sig != 1) {
        return v_void();
      }
      return coerce_int_width(unwrap_try(step.ret), fd.ret_type);
    }
    i = i + 1;
  }
  // No user method matched. Before erroring, try a FIELD holding a closure
  // (#6596): `h.f(3)` where `f: (i32) => i32` is a field, not a method. The
  // compiled path has always supported this — it is the shape #6461 is about,
  // a struct carrying a handler — but this engine read every `recv.name(...)`
  // as method dispatch and gave up here.
  //
  // Deliberately a FALLBACK rather than a check ahead of the walk: a real
  // method keeps winning, so no existing dispatch changes and this can only
  // turn an error into an answer.
  match (recv) {
    VStruct(sv2) => {
      let fi: i32 = 0;
      while (fi < sv2.field_names.len()) {
        if (sv2.field_names[fi] == name) {
          match (sv2.field_values[fi]) {
            VFunc(_) => {
              return call_closure(sv2.field_values[fi], args, funcs, aliases, type_decls, outs);
            },
            _ => {}
          }
        }
        fi = fi + 1;
      }
    },
    VBool(bv) => {
      // A boolean's builtin `to_string`, which a declared one takes over.
      if (name == "to_string" && args.len() == 0) {
        if (bv.v) {
          return v_string("true");
        }
        return v_string("false");
      }
    },
    _ => {}
  }
  return v_err("undefined method `" + name + "` on `" + recv_type + "`");
}

// The capacity-carrying string builder (#8773) — `buf_new` reserves a
// buffer and hands back its handle, the three pushes append to it,
// `buf_len` reports what has accumulated, `buf_take` hands the bytes over
// as a string and leaves the builder ready at its reserve, and `buf_free`
// releases it. std/array's `join` and every std/io_buffered writer bottom
// out here, so a stdlib-importing program reaches them constantly.
//
// The builder is the HOST's, the way `print` and `slice_unchecked` are the
// host's: a handle is the address of a control block, which the boxed value
// plane has no shape for, and an append MUTATES the buffer two copies of a
// handle share, which it has no expression for either.
//
// The handle is carried as a usize, so it survives the round trip out through
// the interpreted program's `usize` variables and back in as an argument.
// That makes a handle an ADDRESS rather than a key into a table of live
// builders, so a handle used after its free is a wild pointer here, not the
// error internal/oracle/interp answers one with.
function is_buf_builtin(name: string): boolean {
  if (name == "buf_push_bytes_range") {
    return true;
  }
  if (name == "buf_new" || name == "buf_push" || name == "buf_push_range") {
    return true;
  }
  if (name == "buf_push_byte" || name == "buf_push_u64" || name == "buf_push_bytes_mapped" || name == "buf_push_bytes_filtered" || name == "buf_push_bytes_expanded" || name == "buf_push_mapped" || name == "buf_push_filtered" || name == "buf_push_expanded") {
    return true;
  }
  return name == "buf_len" || name == "buf_take" || name == "buf_take_bytes" || name == "buf_clear" || name == "buf_free";
}

function v_buf_handle(h: usize): Value {
  return v_usize(h as i64);
}

function buf_handle_of(v: Value): usize {
  return vint_as_i64(v) as usize;
}

// int_arg_i32 reads any integer carrier's low 32 bits, so a `usize` count
// and a compact VInt reach a builtin's i32 parameter the same way.
function int_arg_i32(v: Value): i32 {
  return vint_as_i64(v) as i32;
}

function call_buf_new(args: Value[]): Value {
  if (args.len() != 1 || !is_int_like(args[0])) {
    return v_err("buf_new: expected 1 arg (cap)");
  }
  let reserve: i32 = int_arg_i32(args[0]);
  if (reserve < 0) {
    reserve = 0;
  }
  return v_buf_handle(buf_new(reserve));
}

// Borrow the array and count matching bytes without constructing text.
function call_count_byte_bytes(args: Value[]): Value {
  if (args.len() != 2) {
    return v_err("__count_byte_bytes: expected 2 args (bytes, byte)");
  }
  if (!is_i32_arg(args[1])) {
    return v_err("__count_byte_bytes: byte must be an integer");
  }
  if let VArr(a) = args[0] {
    let byte: i32 = vint_bits(args[1]);
    let at: i32 = 0;
    let count: i32 = 0;
    if (byte < 0 || byte > 255) {
      return v_int(0);
    }
    while (at < a.elements.len()) {
      if (vint_bits(a.elements[at]) == byte) {
        count = count + 1;
      }
      at = at + 1;
    }
    return v_int(count);
  }
  return v_err("__count_byte_bytes: first arg must be a byte array");
}

// byte_args reads each argument as a byte array, the u8 elements packed; a
// non-array or a non-byte element ends the list early.
function byte_args(args: Value[]): u8[][] {
  let out: u8[][] = [];
  for a in args {
    if let VArr(av) = a {
      let b: u8[] = __alloc_u8(av.elements.len());
      let i: i32 = 0;
      while (i < av.elements.len()) {
        let e: Value = av.elements[i];
        if (!is_i32_arg(e) || vint_bits(e) < 0 || vint_bits(e) > 255) {
          return out;
        }
        b = b.with(i, vint_bits(e) as u8);
        i = i + 1;
      }
      out = out.append(b);
    } else {
      return out;
    }
  }
  return out;
}

function byte_value(b: u8[]): Value {
  let out: Value[] = [];
  for x in b {
    out = out.append(v_int(x as i32));
  }
  return v_arr(out);
}

// call_bytes_into is __bytes_into(dst, at, src, from, n): dst with
// src[from .. from + n) written over it from `at`.
function call_bytes_into(args: Value[]): Value {
  if (args.len() != 5) {
    return v_err("__bytes_into: expected 5 arguments");
  }
  let bs: u8[][] = byte_args([args[0], args[2]]);
  let at: i32 = vint_as_i64(args[1]) as i32;
  let from: i32 = vint_as_i64(args[3]) as i32;
  let n: i32 = vint_as_i64(args[4]) as i32;
  if (bs.len() != 2 || n < 0 || at < 0 || from < 0 || at > bs[0].len() - n || from > bs[1].len() - n) {
    return v_err("__bytes_into: range out of bounds");
  }
  let out: u8[] = bs[0];
  let i: i32 = 0;
  while (i < n) {
    out = out.with(at + i, bs[1][from + i]);
    i = i + 1;
  }
  return byte_value(out);
}

// call_bytes_range is __bytes_range(b, from, to): b[from:to] in a fresh array.
function call_bytes_range(args: Value[]): Value {
  if (args.len() != 3) {
    return v_err("__bytes_range: expected 3 arguments");
  }
  let bs: u8[][] = byte_args([args[0]]);
  let from: i32 = vint_as_i64(args[1]) as i32;
  let to: i32 = vint_as_i64(args[2]) as i32;
  if (bs.len() != 1 || from < 0 || to < from || to > bs[0].len()) {
    return v_err("__bytes_range: range out of bounds");
  }
  let out: u8[] = [];
  let i: i32 = from;
  while (i < to) {
    out = out.append(bs[0][i]);
    i = i + 1;
  }
  return byte_value(out);
}

// aes_gcm_arity is how many byte arrays an AES-GCM kernel takes, or 0.
function aes_gcm_arity(name: string): i32 {
  if (name == "__aes_expand_key") {
    return 1;
  }
  if (name == "__aes_ctr32" || name == "__ghash") {
    return 3;
  }
  if (name == "__aes_gcm_seal" || name == "__aes_gcm_open") {
    return 5;
  }
  return 0;
}

// call_aes_gcm runs one of the AES-GCM kernels, which aesref spells from
// their definitions.
function call_aes_gcm(name: string, args: Value[]): Value {
  let want: i32 = aes_gcm_arity(name);
  let bs: u8[][] = byte_args(args);
  if (args.len() != want || bs.len() != want) {
    return v_err(name + ": expected " + util.i32_to_string(want) + " byte arrays");
  }
  if (want == 1) {
    return byte_value(aesref.expand_key(bs[0]));
  }
  if (name == "__ghash") {
    return byte_value(aesref.ghash(bs[0], bs[1], bs[2]));
  }
  if (want == 5) {
    return byte_value(aesref.gcm(bs[0], bs[1], bs[2], bs[3], bs[4], name == "__aes_gcm_seal"));
  }
  return byte_value(aesref.ctr32(bs[0], bs[1], bs[2]));
}

// Reduce a borrowed byte array with wrapping or seeded BSD arithmetic.
function call_crc32_cksum_array(args: Value[]): Value {
  if (args.len() != 2) {
    return v_err("__crc32_cksum_array: expected 2 args");
  }
  if (!is_i32_arg(args[0])) {
    return v_err("__crc32_cksum_array: crc must be an integer");
  }
  if let VArr(a) = args[1] {
    let crc: i32 = vint_bits(args[0]);
    for element in a.elements {
      if (!is_i32_arg(element)) {
        return v_err("__crc32_cksum_array: elements must be u8");
      }
      let b: i32 = vint_bits(element);
      if (b < 0 || b > 255) {
        return v_err("__crc32_cksum_array: elements must be u8");
      }
      crc = crc ^ b << 24;
      let k: i32 = 0;
      while (k < 8) {
        if (crc < 0) {
          crc = crc << 1 ^ 0x04c11db7;
        } else {
          crc = crc << 1;
        }
        k = k + 1;
      }
    }
    return v_int(crc);
  }
  return v_err("__crc32_cksum_array: second arg must be an array");
}

function call_scale_f64(args: Value[]): Value {
  if (args.len() != 2) {
    return v_err("__scale_f64: expected 2 args (xs, k)");
  }
  if let VArr(xa) = args[0] {
    if let VFloat(kf) = args[1] {
      let sout: Value[] = [];
      let sidx: i32 = 0;
      while (sidx < xa.elements.len()) {
        if let VFloat(ef) = xa.elements[sidx] {
          sout = sout.append(v_float(ef.v * kf.v));
        } else {
          return v_err("__scale_f64: elements must be f64");
        }
        sidx = sidx + 1;
      }
      return v_arr_of(sout, "f64");
    }
    return v_err("__scale_f64: k must be an f64");
  }
  return v_err("__scale_f64: first arg must be an array");
}

function inner_mul_values(a: Value[], b: Value[], rows: i32, extent: i32, columns: i32, init: f64): Value {
  let m: i64 = rows as i64;
  let k: i64 = extent as i64;
  let n: i64 = columns as i64;
  if (rows < 0 || extent < 0 || columns < 0 || m * k != a.len() as i64 || k * n != b.len() as i64 || m * n > 2147483647i64) {
    exit(134);
    return v_err("__inner_mul_add_f64: invalid geometry");
  }
  if (rows == 0 || columns == 0) {
    return v_arr_of([], "f64");
  }
  return inner_mul_loop(a, b, rows, extent, columns, init);
}

function inner_mul_loop(a: Value[], b: Value[], rows: i32, extent: i32, columns: i32, init: f64): Value {
  let out: Value[] = [];
  let row: i32 = 0;
  while (row < rows) {
    let col: i32 = 0;
    while (col < columns) {
      let acc: f64 = init;
      let at: i32 = 0;
      while (at < extent) {
        if let VFloat(x) = a[row * extent + at] {
          if let VFloat(y) = b[at * columns + col] {
            let product: f64 = x.v * y.v;
            acc = acc + product;
          } else {
            return v_err("__inner_mul_add_f64: elements must be f64");
          }
        } else {
          return v_err("__inner_mul_add_f64: elements must be f64");
        }
        at = at + 1;
      }
      out = out.append(v_float(acc));
      col = col + 1;
    }
    row = row + 1;
  }
  return v_arr_of(out, "f64");
}

function call_inner_mul_add_f64(args: Value[]): Value {
  if (args.len() != 6) {
    return v_err("__inner_mul_add_f64: expected 6 args");
  }
  if let VArr(a) = args[0] {
    if let VArr(b) = args[1] {
      if let VInt(m) = args[2] {
        if let VInt(k) = args[3] {
          if let VInt(n) = args[4] {
            if let VFloat(init) = args[5] {
              return inner_mul_values(a.elements, b.elements, m.v, k.v, n.v, init.v);
            }
          }
        }
      }
    }
  }
  return v_err("__inner_mul_add_f64: invalid argument types");
}

function outer_mul_values(a: Value[], b: Value[]): Value {
  if (b.len() > 0 && a.len() > 2147483647 / b.len()) {
    exit(134);
    return v_err("__outer_mul_f64: result length overflow");
  }
  let out: Value[] = [];
  for left in a {
    if let VFloat(x) = left {
      for right in b {
        if let VFloat(y) = right {
          out = out.append(v_float(x.v * y.v));
        } else {
          return v_err("__outer_mul_f64: elements must be f64");
        }
      }
    } else {
      return v_err("__outer_mul_f64: elements must be f64");
    }
  }
  return v_arr_of(out, "f64");
}

function call_outer_mul_f64(args: Value[]): Value {
  if (args.len() != 2) {
    return v_err("__outer_mul_f64: expected 2 args");
  }
  if let VArr(a) = args[0] {
    if let VArr(b) = args[1] {
      return outer_mul_values(a.elements, b.elements);
    }
  }
  return v_err("__outer_mul_f64: inputs must be arrays");
}

function call_byte_reduction(name: string, args: Value[]): Value {
  let bsd = name == "__bsd_sum_bytes";
  let argc = 1;
  if (bsd) {
    argc = 2;
  }
  if (args.len() != argc) {
    return v_err(name + ": wrong number of arguments");
  }
  if (bsd && !is_i32_arg(args[1])) {
    return v_err(name + ": seed must be an integer");
  }
  match (args[0]) {
    VArr(a) => {
      let sum: u32 = 0;
      if (bsd) {
        sum = vint_bits(args[1]) as u32 & 0xffff;
      }
      let i = 0;
      while (i < a.elements.len()) {
        if (bsd) {
          sum = (sum >> 1 | sum << 15) & 0xffff;
        }
        sum = sum + vint_bits(a.elements[i]) as u32;
        if (bsd) {
          sum = sum & 0xffff;
        }
        i = i + 1;
      }
      return v_int(sum as i32);
    },
    _ => {
      return v_err(name + ": input must be an array");
    }
  }
}

function call_byte_set_scan(name: string, args: Value[]): Value {
  if (args.len() != 3) {
    return v_err(name + ": expected 3 args (bytes, flag, set)");
  }
  if (!is_i32_arg(args[1])) {
    return v_err(name + ": flag must be an integer");
  }
  match (args[0]) {
    VArr(a) => {
      match (args[2]) {
        VArr(set) => {
          let scan = name == "__scan_set_bytes";
          let at = 0;
          let prev = vint_bits(args[1]) != 0;
          let runs = 0;
          if (scan) {
            at = vint_bits(args[1]);
            if (at < 0) {
              at = 0;
            }
          }
          while (at < a.elements.len()) {
            let b = vint_bits(a.elements[at]);
            let member = b >= 0 && b < set.elements.len() && vint_bits(set.elements[b]) != 0;
            if (scan && member) {
              return v_int(at);
            }
            if (member && !prev) {
              runs = runs + 1;
            }
            prev = member;
            at = at + 1;
          }
          if (scan) {
            return v_int(a.elements.len());
          }
          return v_int(runs);
        },
        _ => {
          return v_err(name + ": set must be a byte array");
        }
      }
    },
    _ => {
      return v_err(name + ": first arg must be a byte array");
    }
  }
}

// Compare borrowed byte ranges after clamping offsets and remaining lengths.
function call_mismatch_bytes(args: Value[]): Value {
  if (args.len() != 5) {
    return v_err("__mismatch_bytes: expected 5 args");
  }
  if (!is_i32_arg(args[1]) || !is_i32_arg(args[3]) || !is_i32_arg(args[4])) {
    return v_err("__mismatch_bytes: bounds must be integers");
  }
  if let VArr(a) = args[0] {
    if let VArr(b) = args[2] {
      let ao: i32 = vint_bits(args[1]);
      let bo: i32 = vint_bits(args[3]);
      let n: i32 = vint_bits(args[4]);
      if (ao < 0) {
        ao = 0;
      }
      if (ao > a.elements.len()) {
        ao = a.elements.len();
      }
      if (bo < 0) {
        bo = 0;
      }
      if (bo > b.elements.len()) {
        bo = b.elements.len();
      }
      if (n > a.elements.len() - ao) {
        n = a.elements.len() - ao;
      }
      if (n > b.elements.len() - bo) {
        n = b.elements.len() - bo;
      }
      if (n < 0) {
        n = 0;
      }
      let i: i32 = 0;
      while (i < n) {
        if (vint_bits(a.elements[ao + i]) != vint_bits(b.elements[bo + i])) {
          return v_int(i);
        }
        i = i + 1;
      }
      return v_int(n);
    }
    return v_err("__mismatch_bytes: second range must be an array");
  }
  return v_err("__mismatch_bytes: first range must be an array");
}

// Compare a borrowed byte-array range with a string range, with the clamps
// __mismatch_bytes applies.
function call_mismatch_bytes_str(args: Value[]): Value {
  if (args.len() != 5) {
    return v_err("__mismatch_bytes_str: expected 5 args");
  }
  if (!is_i32_arg(args[1]) || !is_i32_arg(args[3]) || !is_i32_arg(args[4])) {
    return v_err("__mismatch_bytes_str: bounds must be integers");
  }
  if (!is_string_arg(args[2])) {
    return v_err("__mismatch_bytes_str: second range must be a string");
  }
  if let VArr(a) = args[0] {
    let b: string = vstr_of(args[2]);
    let ao: i32 = clamp_offset(vint_bits(args[1]), a.elements.len());
    let bo: i32 = clamp_offset(vint_bits(args[3]), b.len());
    let n: i32 = vint_bits(args[4]);
    if (n > a.elements.len() - ao) {
      n = a.elements.len() - ao;
    }
    if (n > b.len() - bo) {
      n = b.len() - bo;
    }
    if (n < 0) {
      n = 0;
    }
    let i: i32 = 0;
    while (i < n) {
      if (vint_bits(a.elements[ao + i]) != b[bo + i] as i32) {
        return v_int(i);
      }
      i = i + 1;
    }
    return v_int(n);
  }
  return v_err("__mismatch_bytes_str: first range must be an array");
}

// Borrow the array and find the first matching byte at or after the start.
function call_memchr_bytes(args: Value[]): Value {
  if (args.len() != 3) {
    return v_err("__memchr_bytes: expected 3 args (bytes, byte, from)");
  }
  if (!is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
    return v_err("__memchr_bytes: byte and start must be integers");
  }
  if let VArr(a) = args[0] {
    let byte: i32 = vint_bits(args[1]);
    let at: i32 = vint_bits(args[2]);
    if (byte < 0 || byte > 255) {
      return v_int(0 - 1);
    }
    if (at < 0) {
      at = 0;
    }
    while (at < a.elements.len()) {
      if (vint_bits(a.elements[at]) == byte) {
        return v_int(at);
      }
      at = at + 1;
    }
    return v_int(0 - 1);
  }
  return v_err("__memchr_bytes: first arg must be a byte array");
}

function call_rmemchr_bytes(args: Value[]): Value {
  if (args.len() != 3) {
    return v_err("__rmemchr_bytes: expected 3 args (bytes, byte, from)");
  }
  if (!is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
    return v_err("__rmemchr_bytes: byte and start must be integers");
  }
  if let VArr(a) = args[0] {
    let byte: i32 = vint_bits(args[1]);
    let at: i32 = vint_bits(args[2]);
    if (byte < 0 || byte > 255) {
      return v_int(0 - 1);
    }
    if (at >= a.elements.len()) {
      at = a.elements.len() - 1;
    }
    while (at >= 0) {
      if (vint_bits(a.elements[at]) == byte) {
        return v_int(at);
      }
      at = at - 1;
    }
    return v_int(0 - 1);
  }
  return v_err("__rmemchr_bytes: first arg must be a byte array");
}

// Raw byte ranges use clamped bounds, including empty and inverted ranges.
function call_buf_push_bytes_range(h: usize, args: Value[]): Value {
  if (args.len() != 4) {
    return v_err("buf_push_bytes_range: expected 4 args (b, bytes, lo, hi)");
  }
  if (!is_int_like(args[2]) || !is_int_like(args[3])) {
    return v_err("buf_push_bytes_range: bounds must be integers");
  }
  match (args[1]) {
    VArr(a) => {
      let lo: i32 = int_arg_i32(args[2]);
      let hi: i32 = int_arg_i32(args[3]);
      if (lo < 0) {
        lo = 0;
      }
      if (hi > a.elements.len()) {
        hi = a.elements.len();
      }
      // The bootstrap seed predates the bulk host operation.
      while (lo < hi) {
        buf_push_byte(h, vint_bits(a.elements[lo]) & 255);
        lo = lo + 1;
      }
      return v_void();
    },
    _ => {
      return v_err("buf_push_bytes_range: expected byte array");
    }
  }
}

// String ranges retain the existing unchecked-bounds contract.
function call_buf_push_range(h: usize, args: Value[]): Value {
  if (args.len() != 4) {
    return v_err("buf_push_range: expected 4 args (b, s, lo, hi)");
  }
  if (!is_string_arg(args[1])) {
    return v_err("buf_push_range: expected string arg");
  }
  if (!is_int_like(args[2]) || !is_int_like(args[3])) {
    return v_err("buf_push_range: bounds must be integers");
  }
  let s: string = vstr_of(args[1]);
  let lo: i32 = int_arg_i32(args[2]);
  let hi: i32 = int_arg_i32(args[3]);
  if (lo < 0 || hi > s.len() || lo > hi) {
    return slice_abort(aborts.slice_range(), "buf_push_range", lo, hi, s.len());
  }
  buf_push_range(h, s, lo, hi);
  return v_void();
}

// `buf_push_mapped(b, s, table)` appends table[c] for each byte c of s, or c
// itself when it is past the table's end; `buf_push_filtered(b, s, drop)`
// appends each byte c whose drop[c] is zero, or that is past the table's end;
// `buf_push_expanded(b, s, table)` appends each byte's eight-byte record. The
// bytes go through buf_push_byte rather than the kernels themselves, which the
// bootstrap's stage0 compiler predates.
function call_buf_push_table(name: string, h: usize, args: Value[]): Value {
  if (args.len() != 3) {
    return v_err(name + ": expected 3 args (b, s, table)");
  }
  match (args[2]) {
    VArr(tv) => {
      if (name == "buf_push_bytes_mapped" || name == "buf_push_bytes_filtered" || name == "buf_push_bytes_expanded") {
        if let VArr(src) = args[1] {
          for e in src.elements {
            push_table_byte(name, h, vint_bits(e) & 255, tv.elements);
          }
          return v_void();
        }
        return v_err(name + ": expected u8[] arg");
      }
      if (!is_string_arg(args[1])) {
        return v_err(name + ": expected string arg");
      }
      let s: string = vstr_of(args[1]);
      let i: i32 = 0;
      while (i < s.len()) {
        push_table_byte(name, h, s[i] as i32, tv.elements);
        i = i + 1;
      }
      return v_void();
    },
    _ => {
      return v_err(name + ": table must be a u8[]");
    }
  }
}

// push_table_byte appends what one of those kernels makes of byte `c`.
function push_table_byte(name: string, h: usize, c: i32, table: Value[]): void {
  if (name == "buf_push_expanded" || name == "buf_push_bytes_expanded") {
    if (c * 8 + 8 > table.len()) {
      buf_push_byte(h, c);
      return;
    }
    let n: i32 = vint_bits(table[c * 8]) & 255;
    if (n > 7) {
      n = 7;
    }
    let k: i32 = 1;
    while (k <= n) {
      buf_push_byte(h, vint_bits(table[c * 8 + k]) & 255);
      k = k + 1;
    }
    return;
  }
  if (c >= table.len()) {
    buf_push_byte(h, c);
    return;
  }
  if (name == "buf_push_filtered" || name == "buf_push_bytes_filtered") {
    if ((vint_bits(table[c]) & 255) == 0) {
      buf_push_byte(h, c);
    }
    return;
  }
  buf_push_byte(h, vint_bits(table[c]) & 255);
}

// The three whole-argument appends: a string's bytes, the low byte of a
// number, or the eight bytes of one.
function call_buf_append(name: string, h: usize, args: Value[]): Value {
  if (name == "buf_push") {
    if (args.len() != 2) {
      return v_err("buf_push: expected 2 args (b, s)");
    }
    if (!is_string_arg(args[1])) {
      return v_err("buf_push: expected string arg");
    }
    buf_push(h, vstr_of(args[1]));
    return v_void();
  }
  if (name == "buf_push_u64") {
    if (args.len() != 2) {
      return v_err("buf_push_u64: expected 2 args (b, v)");
    }
    if (!is_int_like(args[1])) {
      return v_err("buf_push_u64: expected number");
    }
    // Eight byte pushes rather than the op itself: these SOURCES have to
    // compile under the pinned stage0 (docs/BOOTSTRAP.md), which knows no
    // builtin added after it was published, and the interpreter's speed is
    // not what the op exists for. Little-endian, which is the order every
    // target stores a u64 in and what the checker's contract states.
    let w: i64 = vint_as_i64(args[1]);
    let k: i32 = 0;
    while (k < 8) {
      buf_push_byte(h, (w >> (k * 8) as i64) as i32 & 255);
      k = k + 1;
    }
    return v_void();
  }
  if (name != "buf_push_byte") {
    return v_err(name + ": not a builder append");
  }
  if (args.len() != 2) {
    return v_err("buf_push_byte: expected 2 args (b, x)");
  }
  if (!is_int_like(args[1])) {
    return v_err("buf_push_byte: expected number byte");
  }
  buf_push_byte(h, int_arg_i32(args[1]) & 255);
  return v_void();
}

// Handle-only builtins: accumulated length, text/byte extraction that leaves
// the builder ready at its reserve, and free that releases it.
function call_buf_read(name: string, h: usize, args: Value[]): Value {
  if (args.len() != 1) {
    return v_err(name + ": expected 1 arg (b)");
  }
  if (name == "buf_len") {
    return v_int(buf_len(h));
  }
  if (name == "buf_take") {
    // The stage0 that builds this interpreter may still expose raw buf_take.
    // Publish text through the current decoder after draining the byte API.
    return v_string(utf8.from_bytes_lossy(buf_take_bytes(h)));
  }
  if (name == "buf_take_bytes") {
    return call_buf_take_bytes(h);
  }
  if (name == "buf_clear") {
    // A take leaves the builder empty with its capacity, as a clear does;
    // the stage0 that builds this interpreter may not have buf_clear.
    let dropped: u8[] = buf_take_bytes(h);
    return v_void();
  }
  if (name != "buf_free") {
    return v_err(name + ": not a builder read");
  }
  buf_free(h);
  return v_void();
}

// Extract through the host byte API, preserving its ownership and reset rules.
function call_buf_take_bytes(h: usize): Value {
  return byte_array_value(buf_take_bytes(h));
}

function call_buf_builtin(name: string, args: Value[]): Value {
  if (name == "buf_new") {
    return call_buf_new(args);
  }
  if (args.len() == 0 || !is_int_like(args[0])) {
    return v_err(name + ": expected a builder handle");
  }
  let h: usize = buf_handle_of(args[0]);
  if (name == "buf_push_range") {
    return call_buf_push_range(h, args);
  }
  if (name == "buf_push_bytes_range") {
    return call_buf_push_bytes_range(h, args);
  }
  if (name == "buf_push_bytes_mapped" || name == "buf_push_bytes_filtered" || name == "buf_push_bytes_expanded" || name == "buf_push_mapped" || name == "buf_push_filtered" || name == "buf_push_expanded") {
    return call_buf_push_table(name, h, args);
  }
  if (name == "buf_push" || name == "buf_push_byte" || name == "buf_push_u64") {
    return call_buf_append(name, h, args);
  }
  return call_buf_read(name, h, args);
}

// str_hash_word is the little-endian word of s[at..at + n], n at most 8,
// the bytes above n zero.
function str_hash_word(s: string, at: i32, n: i32): i64 {
  let w: i64 = 0i64;
  let k: i32 = n - 1;
  while (k >= 0) {
    w = w << 8i64 | s[at + k] as i64;
    k = k - 1;
  }
  return w;
}

// is_sha_hw_name and is_sha_blocks_name are the SHA kernel builtins' two
// shapes.
function is_sha_hw_name(name: string): boolean {
  return name == "__sha256_hw" || name == "__sha1_hw";
}

function is_sha_blocks_name(name: string): boolean {
  return name == "__sha256_hw_blocks" || name == "__sha1_hw_blocks";
}

// str_hash_low32 is h's low 32 bits as an i32, sign per bit 31.
function str_hash_low32(h: i64): i32 {
  let lo: i64 = h & 4294967295i64;
  if (lo >= 2147483648i64) {
    return (lo - 4294967296i64) as i32;
  }
  return lo as i32;
}

function call_func(name: string, args: Value[], funcs: parser.FuncDecl[], aliases: parser.TypeAlias[], type_decls: parser.StructDecl[], outs: OutTable): Value {
  return call_func_targs(name, args, [], "", funcs, aliases, type_decls, outs);
}

// call_func_targs is call_func with the call's explicit type arguments
// (`chunk[V2](8)`), which bind the callee's type parameters ahead of what the
// argument values pin, and the type the call's binding expects, which pins
// a parameter only the result names.
function call_func_targs(name: string, args: Value[], type_args: string[], expect: string, funcs: parser.FuncDecl[], aliases: parser.TypeAlias[], type_decls: parser.StructDecl[], outs: OutTable): Value {
  // The Display-taking I/O trio, matching internal/oracle/interp's builtinPrint /
  // builtinWrite / builtinEprint: print and eprint append a newline, write
  // does not, and eprint goes to stderr. The interpreter is itself a Fern
  // program, so each one is the same builtin the interpreted program asked
  // for, applied one level up.
  //
  // Without these the evaluator could report an exit code and nothing else,
  // so a program's OUTPUT had no self-host witness at all (#6643).
  //
  if (name == "print" || name == "write" || name == "eprint") {
    if (args.len() != 1) {
      return v_err(name + " takes exactly 1 argument");
    }
    // The Display spine: a non-string argument is printed as its
    // `to_string()`, the call native's checker rewrites it to. This engine
    // runs no checker pass, so it dispatches the method here.
    let text_val: Value = args[0];
    match (text_val) {
      VString(_) => {},
      _ => {
        let no_args: Value[] = [];
        text_val = call_method(args[0], "to_string", no_args, funcs, aliases, type_decls, outs);
      }
    }
    match (text_val) {
      VErr(_) => {
        return text_val;
      },
      VString(s) => {
        // The typed local is required for the bootstrap: passing
        // `s.v` straight to a Display-constrained builtin resolves the
        // field against the wrong variant under the pinned stage0
        // (VInt, VBool and VString all name their payload `v`), and
        // stage1 fails to build with E038 on an i32. Elsewhere `s.v`
        // is fine — it is this argument position that misresolves.
        let text: string = s.v;
        if (name == "print") {
          print(text);
        } else if (name == "write") {
          write(text);
        } else {
          eprint(text);
        }
        return v_int(0);
      },
      _ => {
        return v_err(name + ": to_string() did not return a string");
      }
    }
  }
  // `putchar(n)` writes ONE BYTE, the low 8 bits of n — `write(1, &byte, 1)`
  // on every compiled backend. It is not a codepoint encoder, so 233 is the
  // lone byte e9 rather than the two bytes UTF-8 would spell it with, and a
  // value outside 0..255 wraps rather than saturating or erroring.
  if (name == "putchar") {
    if (args.len() != 1 || !is_i32_arg(args[0])) {
      return v_err("putchar takes exactly 1 integer argument");
    }
    putchar(vint_bits(args[0]));
    return v_int(0);
  }
  // target_os(): the program runs where this interpreter runs, so the host
  // is the target — and the host is what this compiler's own target_os()
  // names. Mirrors internal/oracle/interp's builtinTargetOS.
  if (name == "target_os") {
    if (args.len() != 0) {
      return v_err("target_os takes no arguments");
    }
    return v_string(target_os());
  }
  // target_arch(): the ISA half, answered from this compiler's own
  // target_arch() for the same reason. Mirrors internal/oracle/interp's
  // builtinTargetArch.
  if (name == "target_arch") {
    if (args.len() != 0) {
      return v_err("target_arch takes no arguments");
    }
    return v_string(target_arch());
  }
  // map_new(cap) — capacity arg is accepted but ignored
  // since VMap uses dynamic parallel arrays. `__map_new_i32` is the
  // constructor parse_map_lit names for a literal with scalar keys.
  if (name == "map_new" || name == "__map_new_i32") {
    return v_map_new();
  }
  // `__alloc_u8(n)` — the stdlib's staging buffer for every
  // byte-at-a-time string builder (`__string_case_fold`,
  // `slice`, `repeat`, the base64 / hex / json encoders…).
  // Codegen hands back raw zeroed bytes; the boxed model
  // hands back n zero VInts, which `.with(i, b)` then fills
  // and `string_from_bytes_unchecked` packs.
  //
  // The rest of the raw-memory family — `__load_i32`, `__store_ptr`,
  // `__ptr_width`, `__memset`, `__memcpy` — is deliberately absent, as it
  // is from internal/oracle/interp. Those pretend to a flat byte address space no
  // boxed model has, and outside std/jni they are used only by
  // core/map.fern, whose bodies neither engine runs: Map is a native value
  // here (VMap) and in the native interpreter.
  if (name == "__alloc_u8" || name == "__alloc_i32" || name == "__alloc_i64" || name == "__alloc_bool") {
    if (args.len() != 1) {
      return v_err(name + ": expected 1 arg (n)");
    }
    if (!is_i32_arg(args[0])) {
      return v_err(name + ": arg must be an integer");
    }
    let an: i32 = vint_bits(args[0]);
    if (an < 0) {
      return v_abort(aborts.alloc_size(), name + " length " + util.i32_to_string(an));
    }
    let zero: Value = v_int(0);
    if (name == "__alloc_i64") {
      zero = v_int64(0i64);
    }
    if (name == "__alloc_bool") {
      zero = v_bool(false);
    }
    let zs: Value[] = [];
    let zi: i32 = 0;
    while (zi < an) {
      zs = zs.append(zero);
      zi = zi + 1;
    }
    return v_arr(zs);
  }
  if (name == "string_from_bytes_unchecked") {
    if (args.len() != 1) {
      return v_err("string_from_bytes_unchecked: expected 1 arg (bs)");
    }
    match (args[0]) {
      VArr(a) => {
        // Each element is narrowed to its low 8 bits, so a caller-side
        // width mismatch cannot leak a wider value into the result.
        let raw: u8[] = [];
        let ri: i32 = 0;
        while (ri < a.elements.len()) {
          if (!is_i32_arg(a.elements[ri])) {
            return v_err("string_from_bytes_unchecked: element " + util.i32_to_string(ri) + " is not an integer");
          }
          raw = raw.append((vint_bits(a.elements[ri]) & 255) as u8);
          ri = ri + 1;
        }
        return v_string(string_from_bytes_unchecked(raw));
      },
      _ => {
        return v_err("string_from_bytes_unchecked: arg must be an array");
      }
    }
  }
  if (name == "string_from_bytes_range_unchecked") {
    if (args.len() != 3 || !is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
      return v_err("string_from_bytes_range_unchecked: expected 3 args (bs, from, end)");
    }
    let from: i32 = vint_bits(args[1]);
    let end: i32 = vint_bits(args[2]);
    match (args[0]) {
      VArr(a) => {
        if (from < 0 || end > a.elements.len() || from > end) {
          return v_err("string_from_bytes_range_unchecked: range out of bounds");
        }
        let raw: u8[] = [];
        let ri: i32 = from;
        while (ri < end) {
          raw = raw.append((vint_bits(a.elements[ri]) & 255) as u8);
          ri = ri + 1;
        }
        return v_string(string_from_bytes_unchecked(raw));
      },
      _ => {
        return v_err("string_from_bytes_range_unchecked: arg must be an array");
      }
    }
  }
  // `slice_unchecked(s, a, b)` — the byte slice `s[a:b]` as a builtin:
  // same bounds contract as the ExprSlice eval (error on OOB, the
  // interp's stand-in for the codegen trap), no char-boundary check
  // (#5634). Mirrors internal/oracle/interp's builtinSliceUnchecked.
  if (name == "slice_unchecked") {
    if (args.len() != 3) {
      return v_err("slice_unchecked: expected 3 args (s, a, b)");
    }
    if (!is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
      return v_err("slice_unchecked: bounds must be integers");
    }
    match (args[0]) {
      VString(s) => {
        let sua: i32 = vint_bits(args[1]);
        let sub: i32 = vint_bits(args[2]);
        if (sua < 0 || sub > s.v.len() || sua > sub) {
          return slice_abort(aborts.str_oob(), "slice_unchecked", sua, sub, s.v.len());
        }
        return v_string(slice_unchecked(s.v, sua, sub));
      },
      _ => {
        return v_err("slice_unchecked: arg must be a string");
      }
    }
  }
  if (is_buf_builtin(name)) {
    return call_buf_builtin(name, args);
  }
  let rt: Value = call_runtime_intrinsic(name, args);
  if (!is_err(rt)) {
    return rt;
  }
  if (name == "__mulhi_u64") {
    if (args.len() != 2 || !is_int_like(args[0]) || !is_int_like(args[1])) {
      return v_err(name + ": expected 2 integer args");
    }
    return v_uint64(interp_mulhi(vint_as_i64(args[0]) as u64, vint_as_i64(args[1]) as u64) as i64);
  }
  if (name == "__clz32" || name == "__ctz32" || name == "__popcount32" || name == "__clz64" || name == "__ctz64" || name == "__popcount64") {
    if (args.len() != 1) {
      return v_err(name + ": expected 1 arg");
    }
    if (!is_int_like(args[0])) {
      return v_err(name + ": arg must be an integer");
    }
    let bits: u64 = vint_as_i64(args[0]) as u64;
    if (name == "__clz32") {
      return v_int(__clz32(bits as u32));
    }
    if (name == "__ctz32") {
      return v_int(__ctz32(bits as u32));
    }
    if (name == "__popcount32") {
      return v_int(__popcount32(bits as u32));
    }
    if (name == "__clz64") {
      return v_int(__clz64(bits));
    }
    if (name == "__ctz64") {
      return v_int(__ctz64(bits));
    }
    return v_int(__popcount64(bits));
  }
  if (name == "getxattr" || name == "lgetxattr" || name == "setxattr" || name == "lsetxattr"
    || name == "getxattr_bytes" || name == "lgetxattr_bytes" || name == "setxattr_bytes" || name == "lsetxattr_bytes") {
    // The playground interpreter also runs on WASM, where xattr is absent.
    // Keep native calls out of that target's reachable function set.
    if (target_arch() == "wasm32") {
      return v_variant("Err", [io_error_value(Unsupported)]);
    } else {
      return call_xattr(name, args);
    }
  }
  if (name == "__count_byte_bytes") {
    return call_count_byte_bytes(args);
  }
  if (name == "__memchr_bytes") {
    return call_memchr_bytes(args);
  }
  if (name == "__rmemchr_bytes") {
    return call_rmemchr_bytes(args);
  }
  if (name == "__sum_bytes_array" || name == "__bsd_sum_bytes") {
    return call_byte_reduction(name, args);
  }
  if (name == "__crc32_cksum_array") {
    return call_crc32_cksum_array(args);
  }
  if (name == "__scan_set_bytes" || name == "__count_runs_bytes") {
    return call_byte_set_scan(name, args);
  }
  if (name == "__mismatch_bytes") {
    return call_mismatch_bytes(args);
  }
  if (name == "__mismatch_bytes_str") {
    return call_mismatch_bytes_str(args);
  }
  if (name == "__outer_mul_f64") {
    return call_outer_mul_f64(args);
  }
  if (name == "__inner_mul_add_f64") {
    return call_inner_mul_add_f64(args);
  }
  // Only valgrind sees the constant-time marks.
  if (name == "__ct_secret" || name == "__ct_public") {
    return v_void();
  }
  if (name == "__bytes_owned") {
    let bs: u8[][] = byte_args(args);
    if (args.len() != 1 || bs.len() != 1) {
      return v_err("__bytes_owned: expected one byte array");
    }
    return byte_value(bs[0]);
  }
  if (name == "__bytes_range") {
    return call_bytes_range(args);
  }
  if (name == "__bytes_into") {
    return call_bytes_into(args);
  }
  if (aes_gcm_arity(name) > 0) {
    return call_aes_gcm(name, args);
  }
  // No SHA kernels here, so std/crypto runs its own rounds.
  if (args.len() == 0 && is_sha_hw_name(name)) {
    return v_bool(false);
  }
  if (args.len() == 2 && is_sha_blocks_name(name)) {
    return byte_value([]);
  }
  // `__memchr(s, byte, from)` / `__ascii_run(s, from)` — the two scan
  // kernels the compiled backends vectorise, and the byte-search floor
  // under std/string's find family. `from` clamps (negative behaves as 0)
  // and a byte outside 0..255 cannot occur in the haystack, so both stay
  // total; __ascii_run reports len(s) rather than -1 when the rest is
  // ASCII, which is what lets a caller use it as a branchless skip.
  //
  // `__count_byte(s, byte)` reuses __memchr's arms rather than taking its
  // own: it needs the same "first arg is a string" destructure, and the
  // wildcard that destructure costs is ratcheted (§1 of
  // docs/SELFHOST-LANGUAGE-FRICTION.md) with no headroom to spend on a
  // second copy of it. It has no cursor, so no clamp, and both degenerate
  // answers are actual counts rather than sentinels: an out-of-range byte
  // counts 0 because nothing can equal it, an empty string counts 0
  // because it has no bytes.
  // `__scale_f64(xs, k)` — every element of the f64[] times k, as a fresh
  // array: the oracle for the eighth kernel and the first over an array.
  // Each product is one IEEE multiply, so a vector body owes these bits.
  if (name == "__scale_f64") {
    return call_scale_f64(args);
  }
  // `__scan_set(s, from, set)` — the byte-set scan: the first byte at or
  // after `from` whose entry in `set` is nonzero, or len(s). `from` clamps
  // like __memchr's, and a byte past the end of `set` is not in it.
  if (name == "__scan_set") {
    if (args.len() != 3) {
      return v_err("__scan_set: expected 3 args (s, from, set)");
    }
    if (!is_string_arg(args[0]) || !is_i32_arg(args[1])) {
      return v_err("__scan_set: s must be a string and from an integer");
    }
    let ss: string = vstr_of(args[0]);
    let si: i32 = vint_bits(args[1]);
    if (si < 0) {
      si = 0;
    }
    match (args[2]) {
      VArr(set) => {
        while (si < ss.len()) {
          let sb: i32 = ss[si] as i32;
          if (sb < set.elements.len() && vint_bits(set.elements[sb]) != 0) {
            return v_int(si);
          }
          si = si + 1;
        }
        return v_int(ss.len());
      },
      _ => {
        return v_err("__scan_set: set must be a u8[]");
      }
    }
  }
  // `__bsd_sum(s, sum)` — the BSD checksum continued over s from `sum`.
  if (name == "__bsd_sum") {
    if (args.len() != 2) {
      return v_err("__bsd_sum: expected 2 args (s, sum)");
    }
    if (!is_string_arg(args[0]) || !is_i32_arg(args[1])) {
      return v_err("__bsd_sum: s must be a string and sum an integer");
    }
    let bs: string = vstr_of(args[0]);
    let sum: i32 = vint_bits(args[1]) & 65535;
    let bi: i32 = 0;
    while (bi < bs.len()) {
      sum = (sum >> 1 | sum << 15) & 65535;
      sum = sum + bs[bi] as i32 & 65535;
      bi = bi + 1;
    }
    return v_int(sum);
  }
  // `__str_hash(s, seed)` — ir.op_str_hash's hash, computed a byte at a
  // time: each word is assembled little-endian from its bytes.
  if (name == "__str_hash") {
    if (args.len() != 2) {
      return v_err("__str_hash: expected 2 args (s, seed)");
    }
    if (!is_string_arg(args[0]) || !is_i32_arg(args[1])) {
      return v_err("__str_hash: s must be a string and seed an integer");
    }
    let hs: string = vstr_of(args[0]);
    let hn: i32 = hs.len();
    let h: i64 = -3750763034362895579i64 ^ vint_bits(args[1]) as i64 ^ hn as i64;
    let hi: i32 = 0;
    while (hi + 8 <= hn) {
      h = (h ^ str_hash_word(hs, hi, 8)) * 1099511628211i64;
      hi = hi + 8;
    }
    if (hi < hn) {
      if (hn >= 8) {
        h = (h ^ str_hash_word(hs, hn - 8, 8)) * 1099511628211i64;
      } else {
        h = (h ^ str_hash_word(hs, 0, hn)) * 1099511628211i64;
      }
    }
    h = h ^ (h as u64 >> 32u64) as i64;
    return v_int(str_hash_low32(h));
  }
  // `__count_runs(s, inside, set)` — how many runs of `set` members begin in
  // s; `inside` nonzero means the byte before s was a member.
  if (name == "__count_runs") {
    if (args.len() != 3) {
      return v_err("__count_runs: expected 3 args (s, inside, set)");
    }
    if (!is_string_arg(args[0]) || !is_i32_arg(args[1])) {
      return v_err("__count_runs: s must be a string and inside an integer");
    }
    let rs: string = vstr_of(args[0]);
    let prev: boolean = vint_bits(args[1]) != 0;
    match (args[2]) {
      VArr(set) => {
        let runs: i32 = 0;
        let ri: i32 = 0;
        while (ri < rs.len()) {
          let rb: i32 = rs[ri] as i32;
          let member: boolean = rb < set.elements.len() && vint_bits(set.elements[rb]) != 0;
          if (member && !prev) {
            runs = runs + 1;
          }
          prev = member;
          ri = ri + 1;
        }
        return v_int(runs);
      },
      _ => {
        return v_err("__count_runs: set must be a u8[]");
      }
    }
  }
  if (name == "__memchr" || name == "__count_byte" || name == "__sum_bytes") {
    let cb: boolean = name == "__count_byte";
    let sb: boolean = name == "__sum_bytes";
    if (sb) {
      if (args.len() != 1) {
        return v_err("__sum_bytes: expected 1 arg (s)");
      }
    } else if (cb) {
      if (args.len() != 2) {
        return v_err("__count_byte: expected 2 args (s, byte)");
      }
      if (!is_i32_arg(args[1])) {
        return v_err("__count_byte: byte must be an integer");
      }
    } else {
      if (args.len() != 3) {
        return v_err("__memchr: expected 3 args (s, byte, from)");
      }
      if (!is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
        return v_err("__memchr: byte and start must be integers");
      }
    }
    match (args[0]) {
      VString(s) => {
        // Ahead of `want`, which reads args[1]: __sum_bytes has no
        // second argument to read.
        if (sb) {
          let si: i32 = 0;
          let sacc: i32 = 0;
          while (si < s.v.len()) {
            sacc = sacc + s.v[si] as i32;
            si = si + 1;
          }
          return v_int(sacc);
        }
        let want: i32 = vint_bits(args[1]);
        if (cb) {
          if (want < 0 || want > 255) {
            return v_int(0);
          }
          let ci: i32 = 0;
          let cn: i32 = 0;
          while (ci < s.v.len()) {
            if (s.v[ci] as i32 == want) {
              cn = cn + 1;
            }
            ci = ci + 1;
          }
          return v_int(cn);
        }
        if (want < 0 || want > 255) {
          return v_int(-1);
        }
        let mi: i32 = vint_bits(args[2]);
        if (mi < 0) {
          mi = 0;
        }
        while (mi < s.v.len()) {
          if (s.v[mi] as i32 == want) {
            return v_int(mi);
          }
          mi = mi + 1;
        }
        return v_int(-1);
      },
      _ => {
        return v_err("__memchr: first arg must be a string");
      }
    }
  }
  // `__rmemchr(s, byte, from)` — __memchr's backward sibling. The clamp is
  // the mirrored one and it is the only real difference: a forward scan
  // clamps `from` UP to 0, so this clamps it DOWN to len-1 and a negative
  // `from` finds nothing.
  if (name == "__rmemchr") {
    if (args.len() != 3) {
      return v_err("__rmemchr: expected 3 args (s, byte, from)");
    }
    if (!is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
      return v_err("__rmemchr: byte and start must be integers");
    }
    match (args[0]) {
      VString(s) => {
        let rwant: i32 = vint_bits(args[1]);
        if (rwant < 0 || rwant > 255) {
          return v_int(-1);
        }
        let ri: i32 = vint_bits(args[2]);
        if (ri > s.v.len() - 1) {
          ri = s.v.len() - 1;
        }
        while (ri >= 0) {
          if (s.v[ri] as i32 == rwant) {
            return v_int(ri);
          }
          ri = ri - 1;
        }
        return v_int(-1);
      },
      _ => {
        return v_err("__rmemchr: first arg must be a string");
      }
    }
  }
  // `__crc32_cksum(crc, s)` — the CRC-32 cksum(1) prints, with s's bytes
  // folded into the incoming crc: poly 0x04C11DB7, most significant bit
  // first, unreflected, no final complement. The length fold and the
  // complement are std/hash's finish, not a chunk's.
  //
  // Its own arm rather than a ride on __memchr's: the string is args[1]
  // here, so it cannot share that destructure whatever else it shares.
  //
  // Bit-at-a-time, which is the DEFINITION rather than a restatement of a
  // backend: the two native emitters fold with a carry-less multiply and
  // the differential is only worth running if this side is the spec. An
  // empty string returns the incoming crc unchanged.
  if (name == "__crc32_cksum") {
    if (args.len() != 2) {
      return v_err("__crc32_cksum: expected 2 args (crc, s)");
    }
    if (!is_i32_arg(args[0])) {
      return v_err("__crc32_cksum: crc must be an integer");
    }
    match (args[1]) {
      VString(s) => {
        let crc: i32 = vint_bits(args[0]);
        let ci: i32 = 0;
        while (ci < s.v.len()) {
          crc = crc ^ s.v[ci] as i32 << 24;
          let bk: i32 = 0;
          while (bk < 8) {
            // `crc < 0` IS the top bit, and says so without
            // depending on whether `>>` propagates the sign or
            // on an i32 literal with bit 31 set.
            if (crc < 0) {
              crc = crc << 1 ^ 0x04c11db7;
            } else {
              crc = crc << 1;
            }
            bk = bk + 1;
          }
          ci = ci + 1;
        }
        return v_int(crc);
      },
      _ => {
        return v_err("__crc32_cksum: second arg must be a string");
      }
    }
  }
  // `__mismatch(a, ao, b, bo, n)` — the offset of the first byte where
  // a[ao..ao+n) and b[bo..bo+n) differ, or n when the two ranges are equal
  // (#8791). The reference meaning for the kernel the compiled backends
  // vectorise, and deliberately the dumbest correct implementation for the
  // same reason __memchr's is.
  //
  // The clamps ARE the contract: `ao` and `bo` come into [0, len] and `n`
  // down to what both ranges actually hold, so the value returned on
  // equality is the CLAMPED n and a caller's `== n` test correctly fails
  // when it asked to compare more than was there.
  if (name == "__mismatch") {
    if (args.len() != 5) {
      return v_err("__mismatch: expected 5 args (a, ao, b, bo, n)");
    }
    if (!is_string_arg(args[0]) || !is_string_arg(args[2])) {
      return v_err("__mismatch: first and third args must be strings");
    }
    if (!is_i32_arg(args[1]) || !is_i32_arg(args[3]) || !is_i32_arg(args[4])) {
      return v_err("__mismatch: offsets and length must be integers");
    }
    let ma: string = vstr_of(args[0]);
    let mb: string = vstr_of(args[2]);
    let mao: i32 = clamp_offset(vint_bits(args[1]), ma.len());
    let mbo: i32 = clamp_offset(vint_bits(args[3]), mb.len());
    let mn: i32 = vint_bits(args[4]);
    if (mn > ma.len() - mao) {
      mn = ma.len() - mao;
    }
    if (mn > mb.len() - mbo) {
      mn = mb.len() - mbo;
    }
    if (mn < 0) {
      mn = 0;
    }
    let mk: i32 = 0;
    while (mk < mn) {
      if (ma[mao + mk] != mb[mbo + mk]) {
        return v_int(mk);
      }
      mk = mk + 1;
    }
    return v_int(mn);
  }
  if (name == "__ascii_run") {
    if (args.len() != 2) {
      return v_err("__ascii_run: expected 2 args (s, from)");
    }
    if (!is_i32_arg(args[1])) {
      return v_err("__ascii_run: start must be an integer");
    }
    match (args[0]) {
      VString(s) => {
        let ai: i32 = vint_bits(args[1]);
        if (ai < 0) {
          ai = 0;
        }
        while (ai < s.v.len()) {
          if (s.v[ai] as i32 >= 128) {
            return v_int(ai);
          }
          ai = ai + 1;
        }
        return v_int(s.v.len());
      },
      _ => {
        return v_err("__ascii_run: first arg must be a string");
      }
    }
  }
  if (name == "__arr_set_len") {
    if (args.len() != 2 || !is_i32_arg(args[1])) {
      return v_err("__arr_set_len: expected an array and a length");
    }
    if let VCellA(a) = args[0] {
      let n: i32 = vint_bits(args[1]);
      if (n < 0 || n > a.c.get().len()) {
        return v_err("__arr_set_len: length exceeds reserved storage");
      }
      a.length.set(n);
      return v_void();
    }
    return v_err("__arr_set_len: expected an array binding");
  }
  if (name == "cell_new") {
    if (args.len() != 1) {
      return v_err("cell_new takes exactly 1 argument");
    }
    return cell_value(args[0]);
  }
  // The float reinterpret quartet — `std/f64`'s formatter takes a
  // number apart through these, so every f-string on an f64 reaches them.
  if (name == "f64_bits") {
    if (args.len() != 1 || !is_float_like(args[0])) {
      return v_err("f64_bits: expected 1 float arg");
    }
    return box_i64(f64_bits(vfloat_as_f64(args[0])));
  }
  if (name == "f64_from_bits") {
    if (args.len() != 1 || !is_int_like(args[0])) {
      return v_err("f64_from_bits: expected 1 integer arg");
    }
    return v_float(f64_from_bits(vint_as_i64(args[0])));
  }
  if (name == "f32_bits") {
    if (args.len() != 1 || !is_float_like(args[0])) {
      return v_err("f32_bits: expected 1 float arg");
    }
    return v_int(f32_bits(vfloat_as_f64(args[0]) as f32));
  }
  if (name == "f32_from_bits") {
    if (args.len() != 1 || !is_i32_arg(args[0])) {
      return v_err("f32_from_bits: expected 1 integer arg");
    }
    return v_float32(f32_from_bits(vint_bits(args[0])) as f64);
  }
  let i: i32 = 0;
  while (i < funcs.len()) {
    // A plain call names a free function: a method or an associated
    // function (`impl Default for i32`'s `default`) has a receiver type.
    if (funcs[i].name == name && funcs[i].receiver_type.len() == 0) {
      let fd: parser.FuncDecl = funcs[i];
      if (args.len() != fd.params.len()) {
        return v_err("arity mismatch calling `" + name + "`");
      }
      let env: Env = Env { ...new_module_env(funcs, aliases, type_decls, outs), ret: fd.ret_type };
      let no_recv: Value = v_absent();
      env = bind_tyargs(env, fd, false, no_recv, args, type_args, expect);
      let j: i32 = 0;
      while (j < fd.params.len()) {
        env = env.bind_decl(fd.params[j].name, args[j], fd.params[j].type_name);
        j = j + 1;
      }
      let step: StepResult = eval_block(fd.body, env);
      if (step.sig != 1) {
        return v_void();
      }
      return coerce_int_width(unwrap_try(step.ret), fd.ret_type);
    }
    i = i + 1;
  }
  return call_host(name, args);
}

// value_eq: structural equality on Value. Two values of the
// same shape compare by payload; everything else is false.
// VErr never equals anything (including itself) — equality on
// error is itself an error in spirit, but we surface it as
// `false` so the caller branches consistently.
function value_eq(a: Value, b: Value): boolean {
  match (a) {
    VInt(ai) => {
      match (b) {
        VInt(bi) => {
          return ai.v == bi.v;
        },
        VInt64(bi) => {
          return ai.v as i64 == unpack_i64(bi);
        },
        VUint(bu) => {
          return ai.v == bu.v;
        },
        _ => {
          return false;
        }
      }
    },
    VInt64(ai) => {
      match (b) {
        VInt(bi) => {
          return unpack_i64(ai) == bi.v as i64;
        },
        VInt64(bi) => {
          return ai.hi == bi.hi && ai.lo == bi.lo;
        },
        VUint(bu) => {
          return unpack_i64(ai) == uint_zext(bu.v);
        },
        _ => {
          return false;
        }
      }
    },
    VUint(au) => {
      // Same-width compact int compares by bit pattern (a VInt on the
      // other side is the untagged same pattern); a wide VInt64
      // compares against the zero-extended value.
      match (b) {
        VUint(bu) => {
          return au.v == bu.v;
        },
        VInt(bi) => {
          return au.v == bi.v;
        },
        VInt64(bi) => {
          return uint_zext(au.v) == unpack_i64(bi);
        },
        _ => {
          return false;
        }
      }
    },
    VBool(ab) => {
      match (b) {
        VBool(bb) => {
          return ab.v == bb.v;
        },
        _ => {
          return false;
        }
      }
    },
    VString(av) => {
      match (b) {
        VString(bs) => {
          return av.v == bs.v;
        },
        _ => {
          return false;
        }
      }
    },
    VFloat(af) => {
      match (b) {
        VFloat(bf) => {
          return af.v == bf.v;
        },
        VFloat32(bf) => {
          return af.v == bf.v;
        },
        _ => {
          return false;
        }
      }
    },
    VFloat32(af) => {
      // The payload is already rounded, so f64-plane comparison is
      // exact for both same-width and mixed-width operands.
      match (b) {
        VFloat32(bf) => {
          return af.v == bf.v;
        },
        VFloat(bf) => {
          return af.v == bf.v;
        },
        _ => {
          return false;
        }
      }
    },
    VArr(aa) => {
      // Structural equality: same length, each element-pair
      // structurally equal via the same value_eq path.
      match (b) {
        VArr(ba) => {
          if (aa.elements.len() != ba.elements.len()) {
            return false;
          }
          let ai: i32 = 0;
          while (ai < aa.elements.len()) {
            if (!value_eq(aa.elements[ai], ba.elements[ai])) {
              return false;
            }
            ai = ai + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    VFunc(_) => {
      return false;
    },
    VLanes(_) => {
      return false;
    },
    VMap(_) => {
      return false;
    },
    VStruct(asv) => {
      // Structural equality: same type_name + same field
      // count + pairwise structural equality on each
      // field value. Field names already match because
      // the type_name match implies a common StructDecl
      // and the field order is fixed at construction.
      match (b) {
        VStruct(bsv) => {
          if (asv.type_name != bsv.type_name) {
            return false;
          }
          if (asv.field_values.len() != bsv.field_values.len()) {
            return false;
          }
          let si: i32 = 0;
          while (si < asv.field_values.len()) {
            if (!value_eq(asv.field_values[si], bsv.field_values[si])) {
              return false;
            }
            si = si + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    VTuple(at) => {
      // Structural equality: same arity, each element-pair
      // structurally equal via the same value_eq path.
      match (b) {
        VTuple(bt) => {
          if (at.elements.len() != bt.elements.len()) {
            return false;
          }
          let ti: i32 = 0;
          while (ti < at.elements.len()) {
            if (!value_eq(at.elements[ti], bt.elements[ti])) {
              return false;
            }
            ti = ti + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    VCellI(_) => {
      // A cell never reaches a comparison: Env.lookup derefs it, so the only
      // places a VCell* is observable are the slot itself and a closure's
      // captured snapshot. Answering `false` keeps value_eq total without
      // inventing an equality for a binding-site artifact.
      return false;
    },
    VCellF(_) => {
      return false;
    },
    VCellV(_) => {
      return false;
    },
    VCell(_) => {
      return false;
    },
    VErr(_) => {
      // Neither bottom compares equal — a diagnostic and a `?` unwind are
      // both abrupt, and an abrupt value never reaches an ordinary operand
      // position (is_err short-circuits ahead of every comparison).
      return false;
    },
    VTry(_) => {
      return false;
    },
    VControl(_) => {
      return false;
    },
    VType(_) => {
      // A type is not a value: it only ever sits in the object position of
      // an associated call, never in an operand one.
      return false;
    },
    VHandle(ah) => {
      if let VHandle(bh) = b {
        return handle_kind(ah) == handle_kind(bh) && value_eq(handle_fd(ah), handle_fd(bh));
      }
      return false;
    },
    VCellA(_) => {
      // Lives only in an Env slot; lookup reads through it.
      return false;
    }
  }
  return false;
}

// eval_stmt returns (new env, control signal, optional value). The
// returned env carries `let x = …;` bindings forward. Control flow
// uses the DEDICATED `sig` channel (SH-002) — never the Value union,
// so a user value like Err("__break__") can no longer be mistaken for
// a loop signal (the old encoding keyed break/continue/return off
// magic VErr message strings). `ret` is meaningful only for SIG 1:
// a `return`'s value, or a runtime error propagating outward (both
// stop execution identically, exactly as before).
//   sig 0 = none (keep going; ret is a placeholder, never read)
//   sig 1 = stop (return value or runtime error in ret)
//   sig 2 = break     sig 3 = continue
pub struct StepResult { env: Env, ret: Value, sig: i32 }

function step_none(env: Env): StepResult {
  return StepResult { env: env, ret: VErr { msg: "", abort: false }, sig: 0 };
}

function step_stop(env: Env, v: Value): StepResult {
  if let VControl(control) = v {
    return StepResult { env: env, ret: control.box, sig: control.sig };
  }
  return StepResult { env: env, ret: v, sig: 1 };
}

function eval_value_body(body: ast.Stmt[], env: Env, expect: string): StepResult {
  if (body.len() == 0) {
    return step_stop(env, v_err("value expression has no terminal value"));
  }
  let cur = env;
  let assigned = body_assign_names(body, []);
  for i in 0..body.len() - 1 {
    cur = cellify_captures(cur, body[i], assigned);
    let step = eval_out_stmt(body[i], cur);
    if (step.sig != 0) {
      return step;
    }
    cur = step.env;
  }
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      let value: Value = v_void();
      if let ast.ExprCall(call) = r.value {
        value = eval_expr_call_expect(call, cur, expect);
      } else {
        value = eval_expr(r.value, cur);
      }
      if (is_err(value)) {
        return step_stop(cur, value);
      }
      return StepResult { env: cur, ret: value, sig: 0 };
    },
    ast.StmtIf(branch) => {
      let condition = eval_expr(branch.cond, cur);
      if (is_err(condition)) {
        return step_stop(cur, condition);
      }
      let yes: boolean = false;
      match (condition) {
        VBool(b) => {
          yes = b.v;
        },
        VInt(n) => {
          yes = n.v != 0;
        },
        _ => {
          return step_stop(cur, v_err("value condition is not boolean"));
        }
      }
      if (yes) {
        return eval_value_body(branch.then_body, cur, expect);
      }
      return eval_value_body(branch.else_body, cur, expect);
    },
    ast.StmtMatch(m) => {
      return eval_match_stmt_mode(m, cur, true, expect);
    },
    _ => {
      return step_stop(cur, v_err("value expression has no terminal value"));
    }
  }
  return step_stop(cur, v_err("value expression has no terminal value"));
}

// eval_while_stmt runs a `while` / `loop`. Kept out of eval_stmt, whose frame every
// interpreted call nests.
@noinline
function eval_while_stmt(w: ast.StmtWhile, env: Env): StepResult {
  // Loop until cond is false or the body returns.
  // Assignments inside the body need to outlive each
  // iteration — eval_block's "drop branch-local
  // bindings" stance is wrong here, so we step the body
  // ourselves and thread `cur` forward. `let` declared
  // inside the body still doesn't leak past the loop:
  // we snapshot the names-length at entry and trim back
  // on each iteration boundary, simulating block scope.
  //
  // Concretely: the names array grows only by `let`
  // inside the body; truncating to entry-length on each
  // iteration discards those bindings before the next
  // iteration starts, but keeps any updates to
  // outer-scoped names (those slots sit at index < base
  // and update() rewrites them in place). The trim also
  // applies on loop exit so the outer scope sees the
  // env it started with, plus assignment updates.
  let cur: Env = env;
  let base: i32 = env.names.len();
  while (true) {
    let cv: Value = eval_expr(w.cond, cur);
    if (is_err(cv)) {
      return step_stop(env, cv);
    }
    match (cv) {
      VBool(b) => {
        if (!b.v) {
          return step_none(cur);
        }
      },
      _ => {
        return step_stop(env, v_err("while cond not bool"));
      }
    }
    let step: StepResult = eval_block(w.body, cur);
    // break inside the loop exits immediately —
    // discard the body's env, return noreturn so
    // the surrounding stmt list continues.
    if (step.sig == 2) {
      return step_none(trim_env(step.env, base));
    }
    // continue trims body-local bindings and loops.
    if (step.sig == 3) {
      cur = trim_env(step.env, base);
      continue;
    }
    if (step.sig == 1) {
      // A return (or error) inside the loop short-circuits
      // all remaining iterations.
      return step;
    }
    // A deeper labeled break/continue (#4348 item 2): this loop
    // is one of the levels being unwound — peel one level and
    // re-propagate to the enclosing loop.
    if (step.sig > 3) {
      return StepResult { env: trim_env(step.env, base), ret: step.ret, sig: step.sig - 2 };
    }
    cur = trim_env(step.env, base);
  }
  return step_none(cur);
}

// eval_match_stmt runs a statement `match`. Kept out of eval_stmt, whose frame every
// interpreted call nests.
@noinline
function eval_match_stmt(m: ast.StmtMatch, env: Env): StepResult {
  return eval_match_stmt_mode(m, env, false, "");
}

function eval_match_stmt_mode(m: ast.StmtMatch, env: Env, value_form: boolean, expect: string): StepResult {
  // Evaluate the scrutinee. An error in the scrutinee
  // propagates without running any arm.
  let sv: Value = eval_expr(m.scrutinee, env);
  if (is_err(sv)) {
    return step_stop(env, sv);
  }
  // Walk arms top-to-bottom and run the first that
  // matches. Variant patterns require a VStruct
  // scrutinee whose type_name matches the pattern's
  // type_name; PatWildcard always matches.
  let i: i32 = 0;
  while (i < m.arms.len()) {
    let arm: ast.MatchArm = m.arms[i];
    let matched: boolean = false;
    let bind_names: string[] = [];
    let bind_values: Value[] = [];
    match (arm.pattern) {
      ast.PatWildcard(_) => {
        matched = true;
      },
      ast.PatVariant(pv) => {
        // `match (b) { true => …, false => … }` over a bool.
        if (pv.type_name == "true" || pv.type_name == "false") {
          match (sv) {
            VBool(bv) => {
              if (pv.type_name == "true" && bv.v) {
                matched = true;
              }
              if (pv.type_name == "false" && !bv.v) {
                matched = true;
              }
            },
            _ => {}
          }
        }
        match (sv) {
          VStruct(vs) => {
            // A runtime enum/variant value carries the
            // bare variant name as its type_name, so a
            // qualified pattern `E.Red` matches by its
            // final path segment as well as by exact
            // name (a bare `Red` pattern still matches
            // exactly).
            if (vs.type_name == pv.type_name || vs.type_name == variant_simple_name(pv.type_name)) {
              matched = true;
              // A payload enum variant carries the
              // parser's `__ev` marker as its first
              // synthesised field; a `V(a, b, …)`
              // pattern binds each payload field
              // positionally. A plain tagged-struct /
              // union variant `Circle(c)` has no `__ev`
              // marker, so a single binding takes the
              // whole struct (so `c.field` works).
              // Bare `Foo` / `Foo(_)` bind nothing.
              let is_payload: boolean = vs.field_names.len() > 0 && vs.field_names[0] == "__ev";
              if (pv.at_binding.len() > 0) {
                bind_names = bind_names.append(pv.at_binding);
                bind_values = bind_values.append(sv);
              }
              if (is_payload) {
                let pat_binds: string[] = [];
                if (pv.binding.len() > 0) {
                  pat_binds = pat_binds.append(pv.binding);
                }
                let xi: i32 = 0;
                while (xi < pv.extra_bindings.len()) {
                  pat_binds = pat_binds.append(pv.extra_bindings[xi]);
                  xi = xi + 1;
                }
                let pbi: i32 = 0;
                while (pbi < pat_binds.len() && pbi < vs.field_values.len()) {
                  if (pat_binds[pbi] != "_") {
                    bind_names = bind_names.append(pat_binds[pbi]);
                    bind_values = bind_values.append(vs.field_values[pbi]);
                  }
                  pbi = pbi + 1;
                }
              } else {
                if (pv.binding.len() > 0 && pv.binding != "_") {
                  bind_names = bind_names.append(pv.binding);
                  bind_values = bind_values.append(sv);
                }
              }
            }
          },
          _ => {}
        }
      }
    }
    if (matched) {
      // Arm-local bindings die at the close of the
      // arm body, same as branch-local `let`s in
      // StmtIf. Trim env back to the entry length
      // before returning so the surrounding scope
      // doesn't see the binding (or any nested
      // `let`s) leak out.
      let base: i32 = env.names.len();
      let bodyEnv: Env = env;
      let bk: i32 = 0;
      while (bk < bind_names.len()) {
        bodyEnv = bodyEnv.bind(bind_names[bk], bind_values[bk]);
        bk = bk + 1;
      }
      // A guard (`Pat if <expr> =>`) is evaluated with the
      // binding in scope; a false guard falls through to the
      // next arm instead of running this body.
      let pass: boolean = true;
      if (arm.has_guard) {
        let gv: Value = eval_expr(arm.guard, bodyEnv);
        if (is_err(gv)) {
          return step_stop(trim_env(bodyEnv, base), gv);
        }
        match (gv) {
          VBool(gb) => {
            pass = gb.v;
          },
          _ => {
            pass = false;
          }
        }
      }
      if (pass) {
        let step: StepResult = if (value_form) { eval_value_body(arm.body, bodyEnv, expect) } else { eval_block(arm.body, bodyEnv) };
        return StepResult { env: trim_env(step.env, base), ret: step.ret, sig: step.sig };
      }
    }
    i = i + 1;
  }
  return step_stop(env, v_err("non-exhaustive match"));
}

// eval_for_stmt runs a `for`. Kept out of eval_stmt, whose frame every
// interpreted call nests.
@noinline
function eval_for_stmt(f: ast.StmtFor, env: Env): StepResult {
  let iv: Value = eval_expr(f.iter, env);
  if (is_err(iv)) {
    return step_stop(env, iv);
  }
  let elems: Value[] = [];
  match (for_elements(iv)) {
    Some(walked) => {
      elems = walked;
    },
    None => {
      return eval_iterator_for(f, iv, env);
    }
  }
  // Each iteration binds f.var_name to the current
  // element, walks the body, then trims back to the
  // pre-loop env length. An in-body return short-
  // circuits the rest of the iterations. The loop var is declared by
  // the ELEMENT type of the iterable's annotation — `dyn Shape[]`
  // makes each `x` a `dyn Shape`.
  let elem_ty: string = "";
  let iter_ty: string = env.static_type_of(f.iter);
  if (name_ends_with(iter_ty, "[]")) {
    elem_ty = slice_unchecked(iter_ty, 0, iter_ty.len() - 2) + "";
  }
  let base: i32 = env.names.len();
  let cur: Env = env;
  let i: i32 = 0;
  while (i < elems.len()) {
    let iter_env: Env = bind_element(cur, f.var_name, elems[i], elem_ty);
    let step: StepResult = eval_block(f.body, iter_env);
    if (step.sig == 2) {
      return step_none(trim_env(step.env, base));
    }
    if (step.sig == 3) {
      cur = trim_env(step.env, base);
      i = i + 1;
      continue;
    }
    if (step.sig == 1) {
      return step;
    }
    // A deeper labeled break/continue (#4348 item 2): peel one
    // level and re-propagate to the enclosing loop.
    if (step.sig > 3) {
      return StepResult { env: trim_env(step.env, base), ret: step.ret, sig: step.sig - 2 };
    }
    cur = trim_env(step.env, base);
    i = i + 1;
  }
  return step_none(cur);
}

function eval_stmt(st: ast.Stmt, env: Env): StepResult {
  match (st) {
    ast.StmtDefer(d) => {
      // StmtDefer is lowered away by lower_defers_module before eval; this
      // arm recurses on the lowered form.
      return eval_stmt(d.action, env);
    },
    ast.StmtVar(v) => {
      let val: Value = eval_var_init(v, env);
      // A runtime error in the initializer aborts the function rather
      // than being bound and silently swallowed (#4348 item 4). eval_expr
      // only ever yields VALUES (control signals are statement-level,
      // on the sig channel), so any VErr here is a real error to propagate.
      if (is_err(val)) {
        return step_stop(env, val);
      }
      // `let (a, b) = t` arrives as ONE StmtVar whose name is the
      // comma-joined binding list (see parser's tuple-destructure arm),
      // so a name carrying a comma binds per tuple slot, not whole.
      if (is_destructure_name(v.name) || parser.is_destr_marker(v.type_name)) {
        return destructure_step(env, v, val);
      }
      // An unannotated `let` carries its initialiser's declared type, so
      // a `dyn` value keeps the type its dispatch depends on across the
      // binding (#7291).
      let declared: string = v.type_name;
      if (declared.len() == 0) {
        declared = env.static_type_of(v.init);
      }
      let env2: Env = env.bind_decl(v.name, val, declared);
      return step_none(env2);
    },
    ast.StmtReturn(r) => {
      if (parser.bare_return(r.value)) {
        return step_stop(env, v_void());
      }
      if let ast.ExprCall(rc) = r.value {
        return step_stop(env, eval_expr_call_expect(rc, env, bound_type_spelling(env.ret, env)));
      }
      let val: Value = eval_expr(r.value, env);
      return step_stop(env, val);
    },
    ast.StmtExpr(x) => {
      let val: Value = eval_expr(x.value, env);
      // A runtime error in an expression-statement aborts rather than
      // being dropped and swallowed (#4348 item 4). Otherwise the value
      // is discarded (expression-statements are side-effect only here).
      if (is_err(val)) {
        return step_stop(env, val);
      }
      return step_none(env);
    },
    ast.StmtIf(ifs) => {
      let cv: Value = eval_expr(ifs.cond, env);
      if (is_err(cv)) {
        return step_stop(env, cv);
      }
      // A guard a desugar synthesized may carry an integer rather than a
      // boolean, so read a VInt cond as its non-zero truth (#4348 item
      // 1). Checker-validated user programs reach this arm only with a
      // bool, so user-facing semantics are unchanged.
      match (cv) {
        VInt(civ) => {
          cv = VBool { v: civ.v != 0 };
        },
        _ => {}
      }
      match (cv) {
        VBool(b) => {
          let body: ast.Stmt[] = ifs.else_body;
          if (b.v) {
            body = ifs.then_body;
          }
          // Branch-local `let`s don't escape: trim the
          // env back to the entry length. Assignments
          // to outer-scoped names sit at index < base
          // and survive the trim (update() rewrites
          // slots in place).
          let base: i32 = env.names.len();
          let step: StepResult = eval_block(body, env);
          return StepResult { env: trim_env(step.env, base), ret: step.ret, sig: step.sig };
        },
        _ => {
          return step_stop(env, v_err("if cond not bool"));
        }
      }
      return step_stop(env, v_err("unreachable if-arm"));
    },
    ast.StmtWhile(w) => {
      return eval_while_stmt(w, env);
    },
    ast.StmtAssign(a) => {
      let av: Value = eval_expr(a.value, env);
      if (is_err(av)) {
        return step_stop(env, av);
      }
      // update silently no-ops on undefined names; surface
      // the error explicitly so a mistake is observable in
      // tests.
      let i: i32 = env.names.len() - 1;
      let found: boolean = false;
      while (i >= 0 && !found) {
        if (env.names[i] == a.target) {
          found = true;
        }
        i = i - 1;
      }
      if (!found) {
        return step_stop(env, v_err("assign to undefined `" + a.target + "`"));
      }
      // A celled slot is a mutable scalar capture: write THROUGH it and
      // leave the Env alone. That is what makes the write visible to the
      // enclosing scope and to every other closure sharing the cell —
      // env.update would only rebind this copy (SH-057).
      let tslot: i32 = env.raw_slot(a.target);
      if (tslot >= 0 && cell_slot_set(env.values[tslot], av)) {
        return step_none(env);
      }
      return step_none(env.update(a.target, av));
    },
    ast.StmtMatch(m) => {
      return eval_match_stmt(m, env);
    },
    ast.StmtBreak(b) => {
      // A labeled break/continue carries its resolve_labels_module-baked
      // relative loop depth (tag 0 = innermost) in the sig encoding
      // (#4348 item 2): sig 2+2d = break out of d+1 loops, 3+2d =
      // continue the d-th enclosing loop. Each loop arm consumes sig
      // 2/3 and peels one level off anything deeper (sig - 2), so a
      // 2-level `break outer` unwinds both loops instead of silently
      // degrading to the innermost (which hung `outer: while(true)`).
      return StepResult { env: env, ret: VErr { msg: "", abort: false }, sig: 2 + b.tag * 2 };
    },
    ast.StmtContinue(c) => {
      return StepResult { env: env, ret: VErr { msg: "", abort: false }, sig: 3 + c.tag * 2 };
    },
    ast.StmtFor(f) => {
      return eval_for_stmt(f, env);
    },
    ast.StmtUnknown(u) => {
      return step_stop(env, v_err("parser-side unknown stmt: " + u.kind));
    }
  }
  return step_stop(env, v_err("unhandled Stmt variant"));
}

// for_elements is what a `for` walks without the Iterator protocol: an
// array's elements, a string's bytes and a Map's (key, value) entries.
function for_elements(iv: Value): Option[Value[]] {
  let elems: Value[] = [];
  match (iv) {
    VArr(a) => {
      return Some(a.elements);
    },
    VString(sv) => {
      for b in sv.v {
        elems = elems.append(v_int(b as i32));
      }
      return Some(elems);
    },
    VMap(m) => {
      let i: i32 = 0;
      while (i < m.keys.len()) {
        elems = elems.append(v_tuple([m.keys[i], m.values[i]]));
        i = i + 1;
      }
      return Some(elems);
    },
    _ => {
      return None;
    }
  }
  return None;
}

// bind_element binds a `for` header to one element: a tuple header
// (`for (k, v) in m`) binds each name to its slot.
function bind_element(env: Env, header: string, elem: Value, elem_ty: string): Env {
  if (is_destructure_name(header)) {
    let (out, err) = bind_destructure(env, header, "", elem);
    if (!is_err(err)) {
      return out;
    }
  }
  return env.bind_decl(header, elem, elem_ty);
}

// eval_iterator_for runs a `for` whose iterand `iv` is a core/iter Iterator,
// or has an `iter()` returning one, as the loop the compiler lowers it to
// (parser.iterator_loop) over the iterand evaluated once.
function eval_iterator_for(f: ast.StmtFor, iv: Value, env: Env): StepResult {
  let held: ast.Expr = ast.ExprIdent { name: "$for_subject", line: 0, col: 0, ty: "" };
  let subject: ast.Expr = held;
  if (!receiver_has_method(env.funcs, iv, "next")) {
    if (!receiver_has_method(env.funcs, iv, "iter")) {
      return step_stop(env, v_err("for-in iter is not iterable"));
    }
    subject = ast.ExprCall { callee: ast.ExprFieldAccess { obj: held, field: "iter", line: 0, col: 0, ty: "", const_read: false }, args: [], line: 0, col: 0, type_args: [], ty: "" };
  }
  let base: i32 = env.names.len();
  let step: StepResult = eval_stmt(parser.iterator_loop(f, subject, 0), env.bind("$for_subject", iv));
  return StepResult { env: trim_env(step.env, base), ret: step.ret, sig: step.sig };
}

// receiver_has_method reports whether a method `name` dispatches on `recv`
// by its type, as call_method finds one.
function receiver_has_method(funcs: parser.FuncDecl[], recv: Value, name: string): boolean {
  let rt: string = value_type_name(recv);
  for fd in funcs {
    if (fd.name == name && fd.receiver_name.len() > 0 && runtime_receiver_name(fd.receiver_type) == rt) {
      return true;
    }
  }
  return false;
}

// trim_env drops bindings past index `base`. Used by the while
// loop to discard body-local `let`s between iterations while
// preserving any update()s to outer-scoped names (those sit at
// index < base and aren't touched).
function trim_env(e: Env, base: i32): Env {
  if (e.names.len() <= base) {
    return e;
  }
  let ns: string[] = [];
  let vs: Value[] = [];
  let ts: string[] = [];
  let i: i32 = 0;
  while (i < base) {
    ns = ns.append(e.names[i]);
    vs = vs.append(e.values[i]);
    ts = ts.append(e.types[i]);
    i = i + 1;
  }
  return Env { ...e, names: ns, values: vs, types: ts };
}

// eval_block walks a body, threading env forward through every
// stmt. Returns the threaded env so the caller can decide how
// much of it to keep — the StmtIf path trims back to the entry
// length (branch-local `let`s die), while StmtWhile uses the
// same trim per iteration but keeps it. Both rely on the fact
// that update() rewrites slots in place, so reassignments to
// outer-scoped names sit at index < base and survive the trim.
// The first non-zero sig short-circuits the walk.
function eval_block(body: ast.Stmt[], env: Env): StepResult {
  let cur: Env = env;
  let reassigned: string[] = body_assign_names(body, []);
  let i: i32 = 0;
  while (i < body.len()) {
    cur = cellify_captures(cur, body[i], reassigned);
    let r: StepResult = eval_out_stmt(body[i], cur);
    cur = r.env;
    if (r.sig != 0) {
      return StepResult { env: cur, ret: r.ret, sig: r.sig };
    }
    i = i + 1;
  }
  return step_none(cur);
}

// eval_program drives the stmt list. Stops at the first return
// (or end of stmts). Returns the return-value or VErr if no
// explicit return was seen.
function eval_program(prog: ast.Stmt[]): Value {
  let env: Env = new_env();
  let preassigned: string[] = body_assign_names(prog, []);
  let i: i32 = 0;
  while (i < prog.len()) {
    env = cellify_captures(env, prog[i], preassigned);
    let r: StepResult = eval_out_stmt(prog[i], env);
    env = r.env;
    if (r.sig != 0) {
      return r.ret;
    }
    i = i + 1;
  }
  return v_err("program reached end without `return`");
}

// exit_status is the process status `main`'s result maps to, and whether it
// is one: an integer of any width is its status (the kernel keeps the low
// byte), a boolean 1 or 0, as every compiled backend has it.
pub function exit_status(v: Value): (boolean, i32) {
  match (v) {
    VInt(iv) => {
      return (true, iv.v);
    },
    VInt64(lv) => {
      return (true, lv.lo);
    },
    VUint(uv) => {
      return (true, uv.v);
    },
    VBool(bv) => {
      if (bv.v) {
        return (true, 1);
      }
      return (true, 0);
    },
    _ => {
      return (false, 0);
    }
  }
  return (false, 0);
}

// eval_module is the main entry for sources that declare
// functions. If `main` exists, call it with no args. Otherwise
// fall back to running the top-level stmts in a fresh env that
// still has access to the function table.
// eval_module runs a module whose program sees `-` as its argv, the spelling
// the stdin-fed drivers give a program that arrived on stdin.
pub function eval_module(raw_mod: parser.Module): Value {
  let dash: string[] = ["-"];
  return eval_module_argv(raw_mod, dash);
}

// eval_module_argv runs a module; `argv` is what the program's `args()`
// answers, its own path first as the CLI gives a compiled program. It is the
// host's argv from here on, so the program's args() and set_args() are the
// host's own.
pub function eval_module_argv(raw_mod: parser.Module, argv: string[]): Value {
  set_args(argv);
  let mod: parser.Module = lowered(raw_mod);
  // Fold each enum into the alias table as a synthetic union so a method
  // declared on the enum type dispatches on its variant values.
  let all_variants: parser.StructDecl[] = module_type_decls(mod.structs);
  let all_aliases: parser.TypeAlias[] = aliases_with_enums(mod.aliases, all_variants);
  let outs: OutTable = out_table(mod.funcs);
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    if (mod.funcs[i].name == "main") {
      let empty_args: Value[] = [];
      return call_func("main", empty_args, mod.funcs, all_aliases, all_variants, outs);
    }
    i = i + 1;
  }
  let env: Env = new_module_env(mod.funcs, all_aliases, all_variants, outs);
  let mreassigned: string[] = body_assign_names(mod.top_stmts, []);
  let j: i32 = 0;
  while (j < mod.top_stmts.len()) {
    env = cellify_captures(env, mod.top_stmts[j], mreassigned);
    let r: StepResult = eval_out_stmt(mod.top_stmts[j], env);
    env = r.env;
    if (r.sig != 0) {
      return r.ret;
    }
    j = j + 1;
  }
  return v_err("module has no `main` and no top-level `return`");
}

// =================== REPL ====================

// Session is a REPL's state between lines: the declarations entered so far,
// and the environment its statements run in, which sees them.
pub struct Session { decls: parser.Module, env: Env }

// A session's statements see `-` as their argv, as a stdin-fed program does.
pub function new_session(): Session {
  set_args(["-"]);
  return Session { decls: parser.parse_module(lexer.tokenize("")), env: new_module_env([], [], module_type_decls([]), builtin_outs()) };
}

// lowered is the module as the interpreter evaluates it, prepared here rather
// than by each caller. The checker's annotation stamps the static types the
// value plane cannot carry: a literal's settled width and an operator's result
// type. `for i in LOW..HIGH` becomes a counting while-loop, since StmtFor only
// iterates arrays, and a `defer` moves to its scope exits (#4348 item 1).
function lowered(raw: parser.Module): parser.Module {
  let typed: parser.Module = checker.annotate_module(raw);
  let funcs: parser.FuncDecl[] = [];
  for fd in typed.funcs {
    funcs = funcs.append(lexical.resolve_func(fd).func);
  }
  let resolved: parser.Module = parser.Module { ...typed, funcs: funcs };
  return parser.fill_default_args_module(parser.desugar_ranges_module(parser.lower_defers_module(resolved)));
}

// declare adds a line's declarations; a function declared again replaces the
// earlier one.
pub function (s: Session) declare(m: parser.Module): Session {
  let funcs: parser.FuncDecl[] = [];
  for f in s.decls.funcs {
    if (!declares_func(m, f.name)) {
      funcs = funcs.append(f);
    }
  }
  for f in m.funcs {
    funcs = funcs.append(f);
  }
  let structs: parser.StructDecl[] = s.decls.structs;
  for d in m.structs {
    structs = structs.append(d);
  }
  let aliases: parser.TypeAlias[] = s.decls.aliases;
  for a in m.aliases {
    aliases = aliases.append(a);
  }
  let decls: parser.Module = parser.Module { ...s.decls, funcs: funcs, structs: structs, aliases: aliases };
  let mod: parser.Module = lowered(decls);
  let types: parser.StructDecl[] = module_type_decls(mod.structs);
  return Session { decls: decls, env: Env { ...s.env, funcs: mod.funcs, aliases: aliases_with_enums(mod.aliases, types), type_decls: types, outs: out_table(mod.funcs) } };
}

function declares_func(m: parser.Module, name: string): boolean {
  for f in m.funcs {
    if (f.name == name) {
      return true;
    }
  }
  return false;
}

// run executes a line's statements, wrapped as the body of function `name`
// in `m`, against the session. It returns whether a final expression
// statement has a value to show, and that value; a runtime error is a VErr
// to show.
pub function (s: Session) run(m: parser.Module, name: string): (Session, boolean, Value) {
  let body: ast.Stmt[] = [];
  for f in lowered(m).funcs {
    if (f.name == name) {
      body = f.body;
    }
  }
  let env: Env = s.env;
  let k: i32 = 0;
  while (k < body.len()) {
    if (k == body.len() - 1) {
      match (body[k]) {
        ast.StmtExpr(x) => {
          let v: Value = eval_expr(x.value, env);
          return (Session { ...s, env: session_env(env) }, is_err(v) || !returns_void(env, x.value), v);
        },
        _ => {}
      }
    }
    let r: StepResult = eval_out_stmt(body[k], env);
    env = r.env;
    if (r.sig != 0 && is_err(r.ret)) {
      return (Session { ...s, env: session_env(env) }, true, r.ret);
    }
    k = k + 1;
  }
  return (Session { ...s, env: session_env(env) }, false, v_void());
}

// A session exposes top-level locals under their source names on the next line.
// Closure values keep their resolved capture names inside their own environments.
function session_env(env: Env): Env {
  let names: string[] = [];
  for name in env.names {
    names = names.append(lexical.source_name(name));
  }
  return Env { ...env, names: names };
}

// returns_void reports a call with no value: to a function declared `void`,
// or to an output builtin. The interpreter has no void value to tell by.
function returns_void(env: Env, x: ast.Expr): boolean {
  if (env.static_type_of(x) == "void") {
    return true;
  }
  match (x) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          return !env.binds_name(id.name) && func_ret_type(env.funcs, id.name).len() == 0
            && (id.name == "print" || id.name == "write" || id.name == "eprint" || id.name == "putchar");
        },
        _ => {}
      }
    },
    _ => {}
  }
  return false;
}

// show is how the REPL prints a value: through the `to_string()` its type
// has in the session, else as value_text renders it, and a runtime error as
// its message.
pub function (s: Session) show(v: Value): string {
  if (is_err(v)) {
    return value_text(v);
  }
  if (method_ret_type(s.env.funcs, value_type_name(v), "to_string") == "string") {
    match (call_method(v, "to_string", [], s.env.funcs, s.env.aliases, s.env.type_decls, s.env.outs)) {
      VString(t) => {
        let text: string = t.v;
        return text;
      },
      VErr(e) => {
        return "error: " + e.msg;
      },
      _ => {}
    }
  }
  return value_text(v);
}

// value_text renders a value as the Go interpreter's Value.String does.
function value_text(v: Value): string {
  match (v) {
    VInt(n) => {
      if (n.is_char) {
        return utf8.utf8_encode(n.v as char);
      }
      return util.i32_to_string(n.v);
    },
    VInt64(n) => {
      return u64_text(unpack_i64(n), n.unsigned);
    },
    VUint(n) => {
      let mask: i64 = 4294967295;
      return util.i64_to_string(n.v as i64 & mask);
    },
    VBool(b) => {
      if (b.v) {
        return "true";
      }
      return "false";
    },
    VString(t) => {
      let text: string = t.v;
      return text;
    },
    VArr(a) => {
      return "[" + values_text(a.elements) + "]";
    },
    VTuple(t) => {
      return "(" + values_text(t.elements) + ")";
    },
    VStruct(sv) => {
      return struct_text(sv);
    },
    VMap(m) => {
      let out: string = "";
      let i: i32 = 0;
      while (i < m.keys.len()) {
        if (i > 0) {
          out = out + ", ";
        }
        out = out + value_text(m.keys[i]) + ": " + value_text(m.values[i]);
        i = i + 1;
      }
      return "Map { " + out + " }";
    },
    VErr(e) => {
      return "error: " + e.msg;
    },
    _ => {}
  }
  return "<" + value_type_name(v) + ">";
}

function values_text(vs: Value[]): string {
  let out: string = "";
  for x in vs {
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + value_text(x);
  }
  return out;
}

// struct_text is `Name { field: value, … }`, or for an enum variant `Name`
// or `Name(payload, …)`.
function struct_text(sv: VStruct): string {
  let fields: string = "";
  let payloads: string = "";
  let i: i32 = 0;
  while (i < sv.field_names.len()) {
    if (i > 0) {
      fields = fields + ", ";
      payloads = payloads + ", ";
    }
    fields = fields + sv.field_names[i] + ": " + value_text(sv.field_values[i]);
    payloads = payloads + value_text(sv.field_values[i]);
    i = i + 1;
  }
  if (sv.field_names.len() == 0) {
    return sv.type_name;
  }
  if (util.str_has_prefix(sv.field_names[0], "_")) {
    return sv.type_name + "(" + payloads + ")";
  }
  return sv.type_name + " { " + fields + " }";
}

function u64_text(n: i64, unsigned: boolean): string {
  if (!unsigned || n >= 0) {
    return util.i64_to_string(n);
  }
  let u: u64 = n as u64;
  let q: u64 = u / 10;
  return util.i64_to_string(q as i64) + util.i32_to_string((u - q * 10) as i32);
}

// =================== VALIDATION ====================

function run_source(src: string): Value {
  let toks: lexer.Token[] = lexer.tokenize(src);
  let stmts: ast.Stmt[] = parser.parse_program(toks);
  return eval_program(stmts);
}

function run_module(src: string): Value {
  let toks: lexer.Token[] = lexer.tokenize(src);
  let mod: parser.Module = parser.parse_module(toks);
  return eval_module(mod);
}

function main(): i32 {
  let rc: i32 = check_arithmetic_and_idents();
  if (rc != 0) {
    return rc;
  }
  rc = check_conditionals_and_assignment();
  if (rc != 0) {
    return rc;
  }
  rc = check_while_loops();
  if (rc != 0) {
    return rc;
  }
  rc = check_functions_and_recursion();
  if (rc != 0) {
    return rc;
  }
  rc = check_arrays();
  if (rc != 0) {
    return rc;
  }
  rc = check_string_indexing();
  if (rc != 0) {
    return rc;
  }
  rc = check_slicing();
  if (rc != 0) {
    return rc;
  }
  rc = check_compound_assignment();
  if (rc != 0) {
    return rc;
  }
  rc = check_structs_and_fields();
  if (rc != 0) {
    return rc;
  }
  rc = check_match_statements();
  if (rc != 0) {
    return rc;
  }
  rc = check_receiver_methods();
  if (rc != 0) {
    return rc;
  }
  rc = check_floats();
  if (rc != 0) {
    return rc;
  }
  rc = check_for_in_loops();
  if (rc != 0) {
    return rc;
  }
  rc = check_tuples();
  if (rc != 0) {
    return rc;
  }
  rc = check_break_and_continue();
  if (rc != 0) {
    return rc;
  }
  rc = check_primitive_receivers();
  if (rc != 0) {
    return rc;
  }
  rc = check_structural_equality();
  if (rc != 0) {
    return rc;
  }
  rc = check_union_receiver_method();
  if (rc != 0) {
    return rc;
  }
  rc = check_lambdas_and_closures();
  if (rc != 0) {
    return rc;
  }
  rc = check_maps();
  if (rc != 0) {
    return rc;
  }
  rc = check_numeric_widths();
  if (rc != 0) {
    return rc;
  }
  return check_string_ordering();
}

// check_string_ordering: `<` / `<=` / `>` / `>=` order strings by their bytes,
// which core/cmp's `Ord for string` (and so every OrdMap keyed by string)
// relies on.
function check_string_ordering(): i32 {
  let r: Value = run_source("let n = 0; if (\"apple\" < \"pear\") { n = n + 1; } if (\"b\" <= \"b\") { n = n + 2; } if (\"ab\" > \"a\") { n = n + 4; } if (\"a\" >= \"b\") { n = n + 8; } return n;");
  match (r) {
    VInt(i) => {
      if (i.v != 7) {
        return 940;
      }
    },
    _ => {
      return 941;
    }
  }
  return 0;
}

function check_arithmetic_and_idents(): i32 {
  // Arithmetic + ident lookup. let x = 7; let y = 9; return x + y.
  let r1: Value = run_source("let x = 1 + 2 * 3; let y = (1 + 2) * 3; return x + y;");
  match (r1) {
    VInt(i) => {
      if (i.v != 16) {
        return 10;
      }
    },
    _ => {
      return 11;
    }
  }

  // String concat.
  let r2: Value = run_source("let a = \"hi \" + \"there\"; return 0 - 1;");
  match (r2) {
    VInt(i) => {
      if (i.v != 0 - 1) {
        return 20;
      }
    },
    _ => {
      return 21;
    }
  }

  // Logical + equality. let b = 5 < 10; return b && (1 == 1).
  // Can't `return bool` directly — surface as i32 via a
  // separate var + a ternary-shaped return.
  let r3: Value = run_source("let b = 5 < 10; let c = b && (1 == 1); return 42;");
  match (r3) {
    VInt(i) => {
      if (i.v != 42) {
        return 30;
      }
    },
    _ => {
      return 31;
    }
  }

  // Unary minus.
  let r4: Value = run_source("let n = 0 - 5; return n;");
  match (r4) {
    VInt(i) => {
      if (i.v != 0 - 5) {
        return 40;
      }
    },
    _ => {
      return 41;
    }
  }

  // Division.
  let r5: Value = run_source("return 20 / 4;");
  match (r5) {
    VInt(i) => {
      if (i.v != 5) {
        return 50;
      }
    },
    _ => {
      return 51;
    }
  }

  // Division by zero → 0 (total semantics, docs/INTEGER-SEMANTICS.md /
  // #4348 item 6), not a VErr. `x % 0 == x` likewise.
  let r6: Value = run_source("return 1 / 0;");
  match (r6) {
    VInt(i) => {
      if (i.v != 0) {
        return 60;
      }
    },
    _ => {
      return 61;
    }
  }
  let r6b: Value = run_source("return 7 % 0;");
  match (r6b) {
    VInt(i) => {
      if (i.v != 7) {
        return 62;
      }
    },
    _ => {
      return 63;
    }
  }

  // Undefined identifier → VErr.
  let r7: Value = run_source("return missing;");
  match (r7) {
    VErr(_) => {},
    _ => {
      return 70;
    }
  }

  return 0;
}

function check_conditionals_and_assignment(): i32 {
  // If/else, then-branch taken: `let x = 5; if (x < 10) { return 1; } else { return 2; }`
  let r8: Value = run_source("let x = 5; if (x < 10) { return 1; } else { return 2; }");
  match (r8) {
    VInt(i) => {
      if (i.v != 1) {
        return 80;
      }
    },
    _ => {
      return 81;
    }
  }

  // Else-branch taken.
  let r9: Value = run_source("let x = 20; if (x < 10) { return 1; } else { return 2; }");
  match (r9) {
    VInt(i) => {
      if (i.v != 2) {
        return 90;
      }
    },
    _ => {
      return 91;
    }
  }

  // No else, condition false: control falls past the if to the
  // trailing return.
  let r10: Value = run_source("if (false) { return 7; } return 11;");
  match (r10) {
    VInt(i) => {
      if (i.v != 11) {
        return 100;
      }
    },
    _ => {
      return 101;
    }
  }

  // Chained else-if: branches through the second arm.
  let r11: Value = run_source("let k = 2; if (k == 1) { return 10; } else if (k == 2) { return 20; } else { return 30; }");
  match (r11) {
    VInt(i) => {
      if (i.v != 20) {
        return 110;
      }
    },
    _ => {
      return 111;
    }
  }

  // Plain assignment: declared, reassigned, returned.
  let r12: Value = run_source("let n = 1; n = 7; return n;");
  match (r12) {
    VInt(i) => {
      if (i.v != 7) {
        return 120;
      }
    },
    _ => {
      return 121;
    }
  }

  return 0;
}

function check_while_loops(): i32 {
  // While loop, counter. Sum of 1..=5 == 15.
  let r13: Value = run_source(
    "let i = 1; let s = 0; while (i <= 5) { s = s + i; i = i + 1; } return s;",
  );
  match (r13) {
    VInt(i) => {
      if (i.v != 15) {
        return 130;
      }
    },
    _ => {
      return 131;
    }
  }

  // Early `return` inside while short-circuits the loop.
  let r14: Value = run_source(
    "let i = 0; while (i < 10) { if (i == 3) { return i; } i = i + 1; } return 0 - 1;",
  );
  match (r14) {
    VInt(i) => {
      if (i.v != 3) {
        return 140;
      }
    },
    _ => {
      return 141;
    }
  }

  // While with always-false cond: body never runs.
  let r15: Value = run_source("let x = 5; while (false) { x = 99; } return x;");
  match (r15) {
    VInt(i) => {
      if (i.v != 5) {
        return 150;
      }
    },
    _ => {
      return 151;
    }
  }

  return 0;
}

function check_functions_and_recursion(): i32 {
  // Function decl + call: `add(2, 3)` via `main` → 5.
  let r16: Value = run_module(
    "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }",
  );
  match (r16) {
    VInt(i) => {
      if (i.v != 5) {
        return 160;
      }
    },
    _ => {
      return 161;
    }
  }

  // Recursive factorial: fact(5) = 120.
  let r17: Value = run_module(
    "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); } function main(): i32 { return fact(5); }",
  );
  match (r17) {
    VInt(i) => {
      if (i.v != 120) {
        return 170;
      }
    },
    _ => {
      return 171;
    }
  }

  // Mutual recursion: is_even(4) → true (encoded as 1).
  let r18: Value = run_module(
    "function is_even(n: i32): i32 { if (n == 0) { return 1; } return is_odd(n - 1); }"
      + " function is_odd(n: i32): i32 { if (n == 0) { return 0; } return is_even(n - 1); }"
      + " function main(): i32 { return is_even(4); }",
  );
  match (r18) {
    VInt(i) => {
      if (i.v != 1) {
        return 180;
      }
    },
    _ => {
      return 181;
    }
  }

  // Undefined function call → VErr.
  let r19: Value = run_module(
    "function main(): i32 { return missing(1); }",
  );
  match (r19) {
    VErr(_) => {},
    _ => {
      return 190;
    }
  }

  // Arity mismatch → VErr.
  let r20: Value = run_module(
    "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(1); }",
  );
  match (r20) {
    VErr(_) => {},
    _ => {
      return 200;
    }
  }

  return 0;
}

