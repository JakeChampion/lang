import "./ast";
import "./lexer";
import "./lexical";
import "./parser";
import "./util";
import "./aborts";
import "./astwalk";
import "./checker";
import "./builtinsigs";
import "./aesref";
import "./platforms";
import "./typeinfo";
import "./interpheap";
import "core/map";
import "std/utf8";
import "std/f64";
import "std/rand";
import "std/string";

pub struct VInt { v: i32, is_char: boolean, is_byte: boolean }

pub struct VInt64 { hi: i32, lo: i32, unsigned: boolean, ptr: boolean }

pub struct VUint { v: i32 }

pub struct VBool { v: boolean }

pub struct VString { v: string }

pub struct VFloat { v: f64 }

pub struct VFloat32 { v: f64 }

// Every copy of a VArr shares `store`, as every holder of a compiled array
// shares its box: a builtin that fills an array the caller owns, or sets its
// length, writes there. Empty until that first write, and from then on
// [length, each slot of the capacity] and read in place of `items`. A view
// keeps its own length and reads its parent's store from `offset`.
pub struct VArr { items: Value[], elem: string, view: boolean, store: interpheap.Root, offset: i32 }

// A tuple, a map or a record that the program builds has a key that no other
// value has. A shared value is then stored and copied one time. The key is
// zero for a value that a builtin builds.
pub struct VTuple { elements: Value[], key: i64 }

pub struct VFunc { params: ast.ParamDecl[], ret_type: string, body: ast.Stmt[], captured_names: string[], captured_values: Value[], captured_types: string[], generic_name: string }

pub struct VMap { keys: Value[], values: Value[], key: i64 }

pub struct VStruct { type_name: string, field_names: string[], field_values: Value[], owner: string, targs: string[], key: i64 }

pub struct VErr { msg: string, abort: boolean }

pub struct VCell { kind: string, root: interpheap.Root }

pub struct VTry { box: Value }

// A value expression propagates a return or loop jump from its operands.
pub struct VControl { box: Value, sig: i32 }

pub struct VType { name: string }

pub struct VHandle { r: Option[Reader], w: Option[Writer], d: Option[Dir] }

pub struct VCellV { root: interpheap.Root }

// `kind` is the kind of an element, as in typeinfo.TypeLanes. An integer
// lane is in `bits` as an unsigned number.
pub struct VLanes { width: i32, kind: i32, bits: i64[] }

pub type Value = VInt | VInt64 | VUint | VBool | VString | VFloat | VFloat32 | VLanes | VArr | VTuple | VFunc | VMap | VStruct | VCell | VErr | VTry | VControl | VType | VHandle | VCellV;

function v_int(n: i32): Value {
  return VInt { v: n, is_char: false, is_byte: false };
}

// A byte keeps its own receiver namespace, including generic inference.
function v_byte(n: i32): Value {
  return VInt { v: n & 255, is_char: false, is_byte: true };
}

function char_value(v: Value): Value {
  if let VInt(n) = v {
    if (n.is_char) {
      return v;
    }
  }
  if (is_int_like(v)) {
    return VInt { v: vint_as_i64(v) as i32, is_char: true, is_byte: false };
  }
  return v;
}

function int_type_name(n: VInt): string {
  if (n.is_char) {
    return "char";
  }
  if (n.is_byte) {
    return "u8";
  }
  return "i32";
}

function v_type(n: string): Value {
  return VType { name: n };
}

function v_wide(n: i64, unsigned: boolean): Value {
  return VInt64 { hi: (n >> 32) as i32, lo: (n & 4294967295) as i32, unsigned: unsigned, ptr: false };
}

function ptr_bits(): i64 {
  if (target_arch() == "wasm32") {
    return 32;
  }
  return 64;
}

function v_usize(n: i64): Value {
  let w = n;
  if (ptr_bits() == 32) {
    w = uint_zext(n as i32);
  }
  return VInt64 { hi: (w >> 32) as i32, lo: w as i32, unsigned: true, ptr: true };
}

function is_vusize(v: Value): boolean {
  if let VInt64(i) = v {
    return i.ptr;
  }
  return false;
}

function v_int64(n: i64): Value {
  return v_wide(n, false);
}

function v_uint64(n: i64): Value {
  return v_wide(n, true);
}

function unpack_i64(x: VInt64): i64 {
  let lo_mask: i64 = 4294967295;
  return x.hi as i64 << 32 | x.lo as i64 & lo_mask;
}

function v_uint(n: i32): Value {
  return VUint { v: n };
}

function wide_as_f64(x: VInt64): f64 {
  if (x.unsigned) {
    let uw = unpack_i64(x) as u64;
    return uw as f64;
  }
  return unpack_i64(x) as f64;
}

function uint_zext(n: i32): i64 {
  let lo_mask: i64 = 4294967295;
  return n as i64 & lo_mask;
}

function box_i64(n: i64): Value {
  if (n >= -2147483648 && n <= 2147483647) {
    return v_int(n as i32);
  }
  return v_int64(n);
}

function zero_value_of(heap: interpheap.Heap, type_name: string): Value {
  if (parser.spelling_is_view(type_name)) {
    return v_view_of(heap, [], parser.array_method_element(type_name));
  }
  if (name_ends_with(type_name, "[]")) {
    return v_arr_of(heap, [], slice_unchecked(type_name, 0, type_name.len() - 2).to_owned());
  }
  if (type_name == "f64" || type_name == "f32") {
    return v_float(0.0);
  }
  if (type_name == "string" || type_name == "str") {
    return v_string("");
  }
  if (type_name == "boolean" || type_name == "bool") {
    return v_bool(false);
  }
  if (type_name == "i64" || type_name == "u64") {
    return v_wide(0, type_name == "u64");
  }
  if (type_name == "usize") {
    return v_usize(0);
  }
  return v_int(0);
}

function coerce_int_width(val: Value, type_name: string): Value {
  if (type_name == "char") {
    return char_value(val);
  }
  if (type_name == "usize" && is_int_like(val)) {
    return v_usize(vint_as_i64(val));
  }
  if (type_name == "i64" || type_name == "u64") {
    let uns64 = type_name == "u64";
    match (val) {
      VInt(i) => {
        return v_wide(i.v as i64, uns64);
      },
      VInt64(i) => {
        return v_wide(unpack_i64(i), uns64);
      },
      VUint(u) => {
        return v_wide(uint_zext(u.v), uns64);
      },
      _ => {
        return val;
      }
    }
  }
  if (type_name == "i32" && is_int_like(val)) {
    return v_int(vint_as_i64(val) as i32);
  }
  if (type_name == "u8" && is_int_like(val)) {
    return v_byte(vint_as_i64(val) as i32);
  }
  if (type_name == "u32") {
    match (val) {
      VInt(i) => {
        return v_uint(i.v);
      },
      VInt64(i) => {
        return v_uint(i.lo);
      },
      _ => {
        return val;
      }
    }
  }
  if (type_name == "f64") {
    match (val) {
      VFloat32(f) => {
        return v_float(f.v);
      },
      VInt(i) => {
        return v_float(i.v as f64);
      },
      VInt64(i) => {
        return v_float(wide_as_f64(i));
      },
      _ => {}
    }
  }
  if (parser.parse_type_ref(type_name).base == "Cell") {
    if let VCell(c) = val {
      return cell_as_declared(c, type_name);
    }
    return val;
  }
  if (type_name == "f32") {
    match (val) {
      VFloat(f) => {
        return v_float32(f.v);
      },
      VInt(i) => {
        return v_float32(i.v as f64);
      },
      VInt64(i) => {
        return v_float32(wide_as_f64(i));
      },
      _ => {
        return val;
      }
    }
  }
  if (name_ends_with(type_name, "[]") || parser.spelling_is_view(type_name)) {
    match (val) {
      VArr(a) => {
        let elem = a.elem;
        let declared = parser.array_method_element(type_name);
        if (elem.len() == 0 && parser.type_str_vars(declared, []).len() == 0) {
          elem = declared;
        }
        return arr_retyped(a, elem, parser.spelling_is_view(type_name));
      },
      _ => {
        return val;
      }
    }
  }
  return coerce_tuple_parts(val, type_name);
}

// A tuple from a value block takes each part of its declared result type.
function coerce_tuple_parts(val: Value, type_name: string): Value {
  if (type_name.len() == 0) {
    return val;
  }
  if let VTuple(t) = val {
    let ty = parser.parse_type_ref(type_name);
    if (ty.is_tuple && ty.array_depth == 0 && ty.args.len() == t.elements.len()) {
      let parts: Value[] = [];
      for i in 0..t.elements.len() {
        parts = parts.append(coerce_int_width(t.elements[i], parser.render_type_ref(ty.args[i])));
      }
      return v_tuple(parts);
    }
  }
  return val;
}

function is_int_like(v: Value): boolean {
  match (v) {
    VInt(_) => {
      return true;
    },
    VInt64(_) => {
      return true;
    },
    VUint(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function is_vint64(v: Value): boolean {
  match (v) {
    VInt64(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function is_vuint64(v: Value): boolean {
  match (v) {
    VInt64(i) => {
      return i.unsigned;
    },
    _ => {
      return false;
    }
  }
}

function index_in(v: Value, n: i32): i32 {
  let wide = vint_as_i64(v);
  if (wide < 0 || wide >= n as i64) {
    return -1;
  }
  return wide as i32;
}

function vint_as_i64(v: Value): i64 {
  match (v) {
    VInt(i) => {
      return i.v as i64;
    },
    VInt64(i) => {
      return unpack_i64(i);
    },
    VUint(u) => {
      return uint_zext(u.v);
    },
    _ => {
      return 0;
    }
  }
}

function is_vuint(v: Value): boolean {
  match (v) {
    VUint(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function vint_bits(v: Value): i32 {
  match (v) {
    VInt(i) => {
      return i.v;
    },
    VUint(u) => {
      return u.v;
    },
    _ => {
      return 0;
    }
  }
}

function split_binding_names(csv: string): string[] {
  let out: string[] = [];
  let start = 0;
  let depth = 0;
  for i in 0..=csv.len() {
    if (i == csv.len() || csv[i] == b',' && depth == 0) {
      out = out.append(slice_unchecked(csv, start, i).to_owned());
      start = i + 1;
    } else if (csv[i] == b'(') {
      depth += 1;
    } else if (csv[i] == b')') {
      depth -= 1;
    }
  }
  return out;
}

@noinline
function destructure_step(env: Env, v: ast.StmtVar, val: Value): StepResult {
  let (denv, derr) = bind_destructure(env, v.name, v.type_name, val);
  if (is_err(derr)) {
    return step_stop(env, derr);
  }
  return step_none(denv);
}

function bind_destructure(env: Env, names: string, marker: string, val: Value): (Env, Value) {
  let dm = parser.destr_marker_split(marker);
  let out = env;
  if (dm.at.len() > 0) {
    out = out.bind(dm.at, val);
  }
  let binds = split_binding_names(names);
  if (dm.tag.starts_with("@sd:")) {
    let colon = util.index_of_sub(slice_unchecked(dm.tag, 4, dm.tag.len()).to_owned(), ":");
    let fields = split_binding_names(slice_unchecked(dm.tag, 4 + colon + 1, dm.tag.len()).to_owned());
    if let VStruct(sv) = val {
      let i = 0;
      while (i < binds.len() && i < fields.len()) {
        let fi = util.index_of_str(sv.field_names, fields[i]);
        if (fi < 0) {
          return (env, v_err("destructuring `" + names + "`: struct " + sv.type_name + " has no field `" + fields[i] + "`"));
        }
        out = out.bind(binds[i], sv.field_values[fi]);
        i += 1;
      }
      return (out, v_void());
    }
    return (env, v_err("destructuring `" + names + "`: initialiser is not a struct"));
  }
  if (binds.len() == 1 && !names.starts_with("(")) {
    return (out.bind(names, val), v_void());
  }
  if let VTuple(tv) = val {
    if (tv.elements.len() != binds.len()) {
      return (env, v_err("destructuring `" + names + "`: tuple has " + util.i32_to_string(tv.elements.len()) + " element(s)"));
    }
    for i in 0..binds.len() {
      let b = binds[i];
      if (b.starts_with("(")) {
        let (inner, err) = bind_destructure(out, slice_unchecked(b, 1, b.len() - 1).to_owned(), "", tv.elements[i]);
        if (is_err(err)) {
          return (env, err);
        }
        out = inner;
      } else {
        out = out.bind(b, tv.elements[i]);
      }
    }
    return (out, v_void());
  }
  return (env, v_err("destructuring `" + names + "`: initialiser is not a tuple"));
}

function is_i32_arg(v: Value): boolean {
  match (v) {
    VInt(_) => {
      return true;
    },
    VUint(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function is_string_arg(v: Value): boolean {
  match (v) {
    VString(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function vstr_of(v: Value): string {
  match (v) {
    VString(s) => {
      return s.v;
    },
    _ => {
      return "";
    }
  }
}

function clamp_offset(off: i32, n: i32): i32 {
  if (off < 0) {
    return 0;
  }
  if (off > n) {
    return n;
  }
  return off;
}

function is_float_like(v: Value): boolean {
  match (v) {
    VFloat(_) => {
      return true;
    },
    VFloat32(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function is_vfloat32(v: Value): boolean {
  match (v) {
    VFloat32(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function vfloat_as_f64(v: Value): f64 {
  match (v) {
    VFloat(f) => {
      return f.v;
    },
    VFloat32(f) => {
      return f.v;
    },
    _ => {
      return 0.0;
    }
  }
}

function v_bool(b: boolean): Value {
  return VBool { v: b };
}

function v_string(s: string): Value {
  return VString { v: s };
}

function v_float(n: f64): Value {
  return VFloat { v: n };
}

function f32_round(x: f64): f64 {
  return f32_from_bits(f32_bits(x as f32)) as f64;
}

function v_float32(x: f64): Value {
  return VFloat32 { v: f32_round(x) };
}

function v_arr(heap: interpheap.Heap, elements: Value[]): Value {
  return v_arr_of(heap, elements, "");
}

function v_arr_of(heap: interpheap.Heap, elements: Value[], elem: string): Value {
  let unwritten: i64[] = [];
  return VArr { items: elements, elem: elem, view: false, store: interpheap.allocate(heap, "", unwritten, []), offset: 0 };
}

function v_view_of(heap: interpheap.Heap, elements: Value[], elem: string): Value {
  let unwritten: i64[] = [];
  return VArr { items: elements, elem: elem, view: true, store: interpheap.allocate(heap, "", unwritten, []), offset: 0 };
}

function arr_len(a: VArr): i32 {
  let st = interpheap.get(a.store).words;
  if (st.len() == 0 || a.view) {
    return a.items.len();
  }
  return st[0] as i32;
}

function arr_at(a: VArr, i: i32): Value {
  let st = interpheap.get(a.store).words;
  if (st.len() == 0) {
    return coerce_int_width(a.items[i], a.elem);
  }
  return coerce_int_width(v_int(st[1 + a.offset + i] as i32), a.elem);
}

// The elements of an array the caller hands over, moved out when nothing
// else holds them.
function arr_take_els(own a: VArr): Value[] {
  if (interpheap.get(a.store).words.len() > 0) {
    return arr_els(a);
  }
  return a.items;
}

function arr_els(a: VArr): Value[] {
  let st = interpheap.get(a.store).words;
  if (st.len() == 0) {
    return a.items;
  }
  let out: Value[] = [];
  let n = arr_len(a);
  for i in 0..n {
    out = out.append(v_int(st[1 + a.offset + i] as i32));
  }
  return out;
}

// The same array under a declared type. An array taken as a view keeps the
// length it has now; a view taken as an array is a copy.
function arr_retyped(a: VArr, elem: string, view: boolean): Value {
  if (view == a.view) {
    return VArr { ...a, elem: elem };
  }
  if (view) {
    return arr_view(VArr { ...a, elem: elem }, 0, arr_len(a));
  }
  return v_arr_of(a.store.heap, arr_els(a), elem);
}

// A view of a[from:to], reading what a builtin later writes into `a`.
function arr_view(a: VArr, from: i32, to: i32): Value {
  let els = arr_els(a);
  let out: Value[] = [];
  for i in from..to {
    out = out.append(els[i]);
  }
  return VArr { items: out, elem: a.elem, view: true, store: a.store, offset: a.offset + from };
}

// Every slot of the array's capacity, as the integers a builtin writes.
function arr_slots(a: VArr): i64[] {
  let st = interpheap.get(a.store).words;
  let out: i64[] = [];
  if (st.len() > 0) {
    for i in 1..st.len() {
      out = out.append(st[i]);
    }
    return out;
  }
  for e in a.items {
    out = out.append(vint_as_i64(e));
  }
  return out;
}

function arr_store_set(a: VArr, n: i32, slots: i64[]): void {
  let st: i64[] = [n as i64];
  for x in slots {
    st = st.append(x);
  }
  interpheap.replace(a.store, "", st, []);
}

// Writes xs over the array's first elements, for every holder of it.
function arr_fill(v: Value, xs: i64[]): void {
  if let VArr(a) = v {
    let slots = arr_slots(a);
    let i = 0;
    while (i < xs.len() && i < slots.len()) {
      slots = slots.with(i, xs[i]);
      i += 1;
    }
    arr_store_set(a, arr_len(a), slots);
  }
}

function bytes_as_i64s(b: u8[]): i64[] {
  let out: i64[] = [];
  for x in b {
    out = out.append(x as i64);
  }
  return out;
}

function i32s_as_i64s(b: i32[]): i64[] {
  let out: i64[] = [];
  for x in b {
    out = out.append(x as i64);
  }
  return out;
}

function v_tuple(elements: Value[]): Value {
  return VTuple { elements: elements, key: 0i64 };
}

function v_tuple_in(heap: interpheap.Heap, elements: Value[]): Value {
  return VTuple { elements: elements, key: interpheap.serial(heap) };
}

// The copies of one send. An array has the key of its store slot, below zero.
struct SendCopies { at: Map[i64, i32], values: Value[] }

struct Sent { value: Value, copies: SendCopies }

struct SentParts { values: Value[], copies: SendCopies }

function array_key(a: VArr): i64 {
  return -1i64 - interpheap.reference(a.store).slot as i64;
}

function send_copied(c: SendCopies, key: i64): Option[Value] {
  if (key == 0i64) {
    return None;
  }
  let i = c.at.get_or(key, -1);
  if (i < 0) {
    return None;
  }
  return Some(c.values[i]);
}

function send_keep(own c: SendCopies, key: i64, v: Value): Sent {
  if (key == 0i64) {
    return Sent { value: v, copies: c };
  }
  let at = c.values.len();
  return Sent { value: v, copies: SendCopies { at: c.at.insert(key, at), values: c.values.append(v) } };
}

// A builtin can fill an array through its shared store. A send copy needs
// separate stores, including the arrays inside a record or enum payload.
// A value that two parts hold has one copy.
function send_copy_value(heap: interpheap.Heap, v: Value): Value {
  return send_copy_part(heap, v, SendCopies { at: map_new(0), values: [] }).value;
}

function send_copy_array(heap: interpheap.Heap, a: VArr, own c: SendCopies): Sent {
  if (a.view) {
    let els = send_copy_parts(heap, arr_els(a), c);
    return Sent { value: v_arr_of(heap, els.values, a.elem), copies: els.copies };
  }
  let key = array_key(a);
  if let Some(done) = send_copied(c, key) {
    if let VArr(d) = done {
      if (d.elem != a.elem) {
        return Sent { value: VArr { ...d, elem: a.elem }, copies: c };
      }
    }
    return Sent { value: done, copies: c };
  }
  let els = send_copy_parts(heap, arr_els(a), c);
  return send_keep(els.copies, key, v_arr_of(heap, els.values, a.elem));
}

function send_copy_part(heap: interpheap.Heap, v: Value, own c: SendCopies): Sent {
  match (v) {
    VArr(a) => {
      return send_copy_array(heap, a, c);
    },
    VTuple(t) => {
      if let Some(done) = send_copied(c, t.key) {
        return Sent { value: done, copies: c };
      }
      let els = send_copy_parts(heap, t.elements, c);
      return send_keep(els.copies, t.key, v_tuple_in(heap, els.values));
    },
    VStruct(s) => {
      if let Some(done) = send_copied(c, s.key) {
        return Sent { value: done, copies: c };
      }
      let fields = send_copy_parts(heap, s.field_values, c);
      return send_keep(fields.copies, s.key, VStruct { ...s, field_values: fields.values, key: interpheap.serial(heap) });
    },
    VMap(m) => {
      if let Some(done) = send_copied(c, m.key) {
        return Sent { value: done, copies: c };
      }
      let keys = send_copy_parts(heap, m.keys, c);
      let values = send_copy_parts(heap, m.values, keys.copies);
      return send_keep(values.copies, m.key, v_map_in(heap, keys.values, values.values));
    },
    _ => {
      return Sent { value: v, copies: c };
    }
  }
}

function send_copy_parts(heap: interpheap.Heap, values: Value[], own c: SendCopies): SentParts {
  let out: Value[] = [];
  let copies = c;
  for value in values {
    let sent = send_copy_part(heap, value, copies);
    out = out.append(sent.value);
    copies = sent.copies;
  }
  return SentParts { values: out, copies: copies };
}

function v_map(keys: Value[], values: Value[]): Value {
  return VMap { keys: keys, values: values, key: 0i64 };
}

function v_map_in(heap: interpheap.Heap, keys: Value[], values: Value[]): Value {
  return VMap { keys: keys, values: values, key: interpheap.serial(heap) };
}

function v_map_new(): Value {
  let ks: Value[] = [];
  let vs: Value[] = [];
  return v_map(ks, vs);
}

function v_struct(type_name: string, names: string[], values: Value[]): Value {
  return VStruct { type_name: type_name, field_names: names, field_values: values, owner: "", targs: [], key: 0i64 };
}

function v_struct_at(heap: interpheap.Heap, type_name: string, names: string[], values: Value[], targs: string[]): Value {
  return VStruct { type_name: type_name, field_names: names, field_values: values, owner: "", targs: targs, key: interpheap.serial(heap) };
}

pub function v_err(msg: string): Value {
  return VErr { msg: msg, abort: false };
}

function v_abort(cause: string, detail: string): Value {
  return VErr { msg: cause + "\n  " + detail, abort: true };
}

function index_abort(cause: string, i: string, n: i32): Value {
  return v_abort(cause, "index " + i + ", length " + util.i32_to_string(n));
}

function slice_abort(cause: string, what: string, lo: i32, hi: i32, n: i32): Value {
  return v_abort(cause, what + " [" + util.i32_to_string(lo) + ":" + util.i32_to_string(hi) + "], length " + util.i32_to_string(n));
}

function v_void(): Value {
  return v_int(0);
}

function v_absent(): Value {
  return VErr { msg: "__absent__", abort: false };
}

function is_err(v: Value): boolean {
  match (v) {
    VControl(_) => {
      return true;
    },
    VErr(_) => {
      return true;
    },
    VTry(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

function is_abort(v: Value): boolean {
  if let VErr(e) = v {
    return e.abort;
  }
  return false;
}

function unwrap_try(v: Value): Value {
  match (v) {
    VTry(t) => {
      return t.box;
    },
    _ => {
      return v;
    }
  }
}

pub function module_type_decls(structs: parser.StructDecl[]): parser.StructDecl[] {
  let all = parser.inject_builtin_enums(structs);
  all = add_variant_decl(all, "Some", 1, "Option");
  all = add_variant_decl(all, "None", 0, "Option");
  all = add_variant_decl(all, "Ok", 1, "Result");
  all = add_variant_decl(all, "Err", 1, "Result");
  return all;
}

// struct_field_type is the declared type of `field` in the struct type
// `sname`, with the type's arguments put in when it applies a generic struct
// (`Pair[3]`).
function struct_field_type(decls: parser.StructDecl[], sname: string, field: string): string {
  let r = parser.parse_type_ref(sname);
  for i in 0..decls.len() {
    if (decls[i].name == sname || decls[i].name == r.base && r.args.len() > 0) {
      let j = 0;
      while (j < decls[i].fields.len()) {
        if (decls[i].fields[j].name == field) {
          return applied_spelling(decls[i].fields[j].type_name, decls[i].type_params, r.args);
        }
        j += 1;
      }
      return "";
    }
  }
  return "";
}

// applied_spelling is `spelling` with each of `vars` replaced by the matching
// argument, or `spelling` unchanged when the counts differ.
function applied_spelling(spelling: string, vars: string[], args: parser.TypeRef[]): string {
  if (vars.len() == 0 || vars.len() != args.len()) {
    return spelling;
  }
  let cts: string[] = [];
  for a in args {
    cts = cts.append(parser.render_type_ref(a));
  }
  return parser.subst_ty(spelling, vars, cts);
}

function add_variant_decl(acc: parser.StructDecl[], name: string, arity: i32, enum_name: string): parser.StructDecl[] {
  for i in 0..acc.len() {
    if (acc[i].name == name) {
      return acc;
    }
  }
  let fields: parser.StructFieldDecl[] = [];
  for f in 0..arity {
    let fname = "__ev";
    if (f > 0) {
      fname = "__ev" + util.i32_to_string(f);
    }
    fields = fields.append(parser.bare_field(fname, ""));
  }
  return acc.append(parser.StructDecl { name: name, fields: fields, type_params: [], const_params: [], derives: [], line: 0, col: 0, enum_owner: enum_name, must_consume: false, value_type: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" });
}

function variant_arity(name: string, decls: parser.StructDecl[]): i32 {
  for i in 0..decls.len() {
    if (decls[i].name == name && decls[i].enum_owner.len() > 0) {
      return decls[i].fields.len();
    }
  }
  return -1;
}

function user_func_exists(name: string, funcs: Funcs): boolean {
  for at in funcs.named(name) {
    if (funcs.decls[at].name == name && funcs.decls[at].receiver_type.len() == 0) {
      return true;
    }
  }
  return false;
}

function v_variant(name: string, args: Value[]): Value {
  return v_variant_of("", name, args);
}

function v_variant_of(owner: string, name: string, args: Value[]): Value {
  return v_variant_keyed(owner, name, args, 0i64);
}

function v_variant_in(heap: interpheap.Heap, owner: string, name: string, args: Value[]): Value {
  return v_variant_keyed(owner, name, args, interpheap.serial(heap));
}

function v_variant_keyed(owner: string, name: string, args: Value[], key: i64): Value {
  let vnames: string[] = [];
  for vi in 0..args.len() {
    if (vi == 0) {
      vnames = vnames.append("__ev");
    } else {
      vnames = vnames.append("__ev" + util.i32_to_string(vi));
    }
  }
  return VStruct { type_name: name, field_names: vnames, field_values: args, owner: owner, targs: [], key: key };
}

function variant_owner(name: string, decls: parser.StructDecl[]): string {
  let owner = "";
  for d in decls {
    if (d.name == name && d.enum_owner.len() > 0) {
      if (owner.len() > 0) {
        return "";
      }
      owner = d.enum_owner;
    }
  }
  return owner;
}

function qualified_owner(qual: string, name: string, decls: parser.StructDecl[]): string {
  for d in decls {
    if (d.name == name && d.enum_owner == qual) {
      return qual;
    }
  }
  return variant_owner(name, decls);
}

function variant_of_enum(v: Value, base: string, aliases: parser.TypeAlias[]): boolean {
  if let VStruct(sv) = v {
    if (sv.owner.len() > 0) {
      return sv.owner == base;
    }
    return is_variant_of_alias_interp(sv.type_name, base, aliases);
  }
  return false;
}

function interp_char_boundary(s: string, i: i32): boolean {
  if (i <= 0 || i >= s.len()) {
    return true;
  }
  let icb = s[i] as i32;
  return icb < 128 || icb >= 192;
}

pub struct Env { outer: Option[Env], depth: i32, names: string[], values: Value[], types: string[], funcs: Funcs, aliases: parser.TypeAlias[], type_decls: parser.StructDecl[], ret: string, heap: interpheap.Heap }

// The program's functions in declaration order, indexed by the name a call
// uses: the declared name, except that a Map `__iterator` is `iter`.
pub struct Funcs { decls: parser.FuncDecl[], runtime_names: util.NameIndex }

function funcs_of(decls: parser.FuncDecl[]): Funcs {
  let names: string[] = [];
  for fd in decls {
    names = names.append(runtime_method_name(fd));
  }
  return Funcs { decls: decls, runtime_names: util.name_index(names) };
}

// The positions of the functions that a call of `name` can reach, in
// declaration order: those declared or called as `name`.
function (f: Funcs) named(name: string): i32[] {
  let out: i32[] = [];
  if (name == "__iterator") {
    for k in 0..f.decls.len() {
      if (f.decls[k].name == name) {
        out = out.append(k);
      }
    }
    return out;
  }
  let i = f.runtime_names.chain(name);
  while (i >= 0) {
    if (f.runtime_names.names[i] == name) {
      out = out.append(i);
    }
    i = f.runtime_names.next[i];
  }
  return out;
}

pub function new_env(heap: interpheap.Heap): Env {
  let ns: string[] = [];
  let vs: Value[] = [];
  let ts: string[] = [];
  let fs: parser.FuncDecl[] = [];
  let al: parser.TypeAlias[] = [];
  let no_structs: parser.StructDecl[] = [];
  return Env { outer: None, depth: 0, names: ns, values: vs, types: ts, funcs: funcs_of(fs), aliases: al, type_decls: module_type_decls(no_structs), ret: "", heap: heap };
}

function new_module_env(heap: interpheap.Heap, fs: Funcs, al: parser.TypeAlias[], vd: parser.StructDecl[]): Env {
  let ns: string[] = [];
  let vs: Value[] = [];
  let ts: string[] = [];
  return Env { outer: None, depth: 0, names: ns, values: vs, types: ts, funcs: fs, aliases: al, type_decls: vd, ret: "", heap: heap };
}

function (e: Env) bind(name: string, v: Value): Env {
  return e.bind_decl(name, v, "");
}

function (e: Env) bind_decl(name: string, v: Value, decl_ty: string): Env {
  let ns = e.names.append(name);
  let vs = e.values.append(coerce_int_width(v, decl_ty));
  let ts = e.types.append(decl_ty);
  return Env { ...e, names: ns, values: vs, types: ts };
}

function (e: Env) decl_type(name: string): string {
  let i = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return e.types[i];
    }
    i -= 1;
  }
  return match (e.outer) { Some(parent) => parent.decl_type(name), None => "" };
}

function (e: Env) static_type_of(x: ast.Expr): string {
  match (x) {
    ast.ExprIdent(id) => {
      return e.decl_type(id.name);
    },
    ast.ExprIndex(ix) => {
      let at = e.static_type_of(ix.array);
      if (name_ends_with(at, "[]")) {
        return slice_unchecked(at, 0, at.len() - 2).to_owned();
      }
      return "";
    },
    ast.ExprFieldAccess(fa) => {
      let ot = e.static_type_of(fa.obj);
      if (ot.len() == 0) {
        return "";
      }
      return struct_field_type(e.type_decls, ot, fa.field);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          if (e.binds_name(id.name)) {
            return "";
          }
          return func_ret_type(e.funcs, id.name, bound_type_args(c.type_args, e));
        },
        ast.ExprFieldAccess(fa) => {
          let rt = e.static_type_of(fa.obj);
          if (rt.len() == 0) {
            return "";
          }
          return method_ret_type(e.funcs, rt, fa.field);
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
}

function method_ret_type(funcs: Funcs, recv_ty: string, name: string): string {
  let found = "";
  let seen = false;
  for at in funcs.named(name) {
    let fd = funcs.decls[at];
    if (fd.name == name && receiver_matches(fd.receiver_type, recv_ty)) {
      let rt = applied_ret_type(fd, recv_ty);
      if (seen && rt != found) {
        return "";
      }
      found = rt;
      seen = true;
    }
  }
  return found;
}

// receiver_matches reports whether a method declared on `decl` takes a
// receiver of static type `recv_ty`: the same spelling, or the same generic
// type with its variables (`Ring[N, T]` for `Ring[2, i32]`).
function receiver_matches(decl: string, recv_ty: string): boolean {
  if (decl == recv_ty) {
    return true;
  }
  let d = parser.parse_type_ref(decl);
  let r = parser.parse_type_ref(recv_ty);
  return d.args.len() > 0 && d.base == r.base && d.args.len() == r.args.len();
}

// applied_ret_type is fd's result type with the receiver's type variables
// replaced by the arguments of the static receiver type.
function applied_ret_type(fd: parser.FuncDecl, recv_ty: string): string {
  let d = parser.parse_type_ref(fd.receiver_type);
  let r = parser.parse_type_ref(recv_ty);
  if (d.args.len() == 0 || d.args.len() != r.args.len()) {
    return fd.ret_type;
  }
  let vars: string[] = [];
  let cts: string[] = [];
  for i in 0..d.args.len() {
    vars = vars.append(d.args[i].base);
    cts = cts.append(parser.render_type_ref(r.args[i]));
  }
  return parser.subst_ty(fd.ret_type, vars, cts);
}

function (e: Env) binds_name(name: string): boolean {
  let i = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return true;
    }
    i -= 1;
  }
  return match (e.outer) { Some(parent) => parent.binds_name(name), None => false };
}

// func_ret_type is the declared result type of function `name`, with the
// call's written type arguments put in.
function func_ret_type(funcs: Funcs, name: string, targs: string[]): string {
  for at in funcs.named(name) {
    let fd = funcs.decls[at];
    if (fd.name == name && fd.receiver_type.len() == 0) {
      let refs: parser.TypeRef[] = [];
      for ta in targs {
        refs = refs.append(parser.parse_type_ref(ta));
      }
      return applied_spelling(fd.ret_type, fd.all_type_params, refs);
    }
  }
  return "";
}

function (e: Env) lookup(name: string): Value {
  let i = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return deref_cell(e.values[i]);
    }
    i -= 1;
  }
  return match (e.outer) { Some(parent) => parent.lookup(name), None => v_err("undefined identifier: " + name) };
}

function deref_cell(v: Value): Value {
  if let VCellV(cv) = v {
    return managed_cell_value(cv.root);
  }
  return v;
}

function cell_slot_set(slot: Value, v: Value): boolean {
  if let VCellV(cv) = slot {
    let encoded = encoded_binding(v, cv.root.heap);
    if (encoded.ok) {
      interpheap.replace(cv.root, encoded.text, [], encoded.edges);
    }
    return encoded.ok;
  }
  return false;
}

function lam_assign_targets(stmts: ast.Stmt[], own acc: string[]): string[] {
  let a = acc;
  for st in stmts {
    a = astwalk.fold_stmt_nodes(st, a, assign_target_of, astwalk.keep_names, astwalk.descend_all);
  }
  return a;
}

function ib_ident_of(e: ast.Expr, own acc: string[]): string[] {
  match (e) {
    ast.ExprIdent(id) => {
      return acc.append(id.name);
    },
    _ => {
      return acc;
    }
  }
}

function ib_idents_stmts(stmts: ast.Stmt[], own acc: string[]): string[] {
  let a = acc;
  for st in stmts {
    a = astwalk.fold_stmt_nodes(st, a, assign_target_of, ib_ident_of, astwalk.descend_all);
  }
  return a;
}

function lam_read_names(st: ast.Stmt): string[] {
  return astwalk.fold_stmt_own_pruned(st, no_names(), lam_read_of, astwalk.not_lambda);
}

pub function body_assign_names(stmts: ast.Stmt[], own acc: string[]): string[] {
  return lam_assign_targets(stmts, acc);
}

function assign_target_of(st: ast.Stmt, own acc: string[]): string[] {
  match (st) {
    ast.StmtAssign(asg) => {
      return acc.append(asg.target);
    },
    _ => {
      return acc;
    }
  }
}

pub function cellify_captures(own env: Env, st: ast.Stmt, reassigned: string[]): Env {
  let out = cellify_env(env, stmt_lambda_writes(st));
  if (reassigned.len() == 0) {
    return out;
  }
  let reads = lam_read_names(st);
  let hit: string[] = [];
  for i in 0..reads.len() {
    if (util.index_of_str(reassigned, reads[i]) >= 0) {
      hit = hit.append(reads[i]);
    }
  }
  if (hit.len() == 0) {
    return out;
  }
  return cellify_env(Env { ...out }, hit);
}

function stmt_lambda_writes(st: ast.Stmt): string[] {
  return astwalk.fold_stmt_own_pruned(st, no_names(), lam_target_of, astwalk.not_lambda);
}

function no_names(): string[] {
  return [];
}

function lam_target_of(e: ast.Expr, own acc: string[]): string[] {
  match (e) {
    ast.ExprLambda(lm) => {
      return lam_assign_targets(lm.body, acc);
    },
    _ => {
      return acc;
    }
  }
}

function lam_read_of(e: ast.Expr, own acc: string[]): string[] {
  match (e) {
    ast.ExprLambda(lm) => {
      return ib_idents_stmts(lm.body, acc);
    },
    _ => {
      return acc;
    }
  }
}

function (e: Env) raw_value(name: string): Option[Value] {
  let i = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return Some(e.values[i]);
    }
    i -= 1;
  }
  return match (e.outer) { Some(parent) => parent.raw_value(name), None => None };
}

function cellify_env(own e: Env, names: string[]): Env {
  let heap = e.heap;
  let out = e;
  for i in 0..names.len() {
    match (out.raw_value(names[i])) {
      Some(cur) => {
        if (!is_cell(cur)) {
          out = out.update(names[i], cell_for(heap, cur));
        }
      },
      None => {}
    }
  }
  return out;
}

function is_cell(v: Value): boolean {
  if let VCellV(_) = v {
    return true;
  }
  return false;
}

// Function captures reference managed slots. All captured values use the same representation.
function cell_for(heap: interpheap.Heap, v: Value): Value {
  let encoded = encoded_binding(v, heap);
  if (encoded.ok) {
    return VCellV { root: interpheap.allocate(heap, encoded.text, [], encoded.edges) };
  }
  return v;
}

function cell_value(heap: interpheap.Heap, v: Value): Value {
  let encoded = encoded_value(v, heap);
  if (encoded.ok) {
    let c = VCell { kind: cell_value_kind(v), root: interpheap.allocate(heap, encoded.text, [], encoded.edges) };
    return c;
  }
  return v_err("Cell: the value holds a function or a cell, which E057 rejects");
}

function cell_value_kind(v: Value): string {
  match (v) {
    VInt(n) => {
      return int_type_name(n);
    },
    VUint(_) => {
      return "u32";
    },
    VBool(_) => {
      return "bool";
    },
    VInt64(n) => {
      return if (n.ptr) { "usize" } else if (n.unsigned) { "u64" } else { "i64" };
    },
    VFloat(_) => {
      return "f64";
    },
    VFloat32(_) => {
      return "f32";
    },
    VString(_) => {
      return "string";
    },
    _ => {
      return "value";
    }
  }
}

// The kind a cell of the declared element type holds, or "" for a type the
// scalar slots do not hold.
function cell_kind_of(elem: string): string {
  if (elem == "boolean" || elem == "bool") {
    return "bool";
  }
  if (util.has_str(["i32", "u32", "char", "u8", "i64", "u64", "usize", "f64", "f32", "string"], elem)) {
    return elem;
  }
  return "";
}

// A cell declared as `Cell[T]` holds a T. A fresh cell takes its kind from
// its initial value, so `cell_new(2)` is an i32 cell until the declaration
// settles it, as the literal itself settles. Only a numeric cell changes
// kind; the cell comes back unchanged when the kinds agree.
function cell_as_declared(c: VCell, type_name: string): Value {
  let ref = parser.parse_type_ref(type_name);
  if (ref.args.len() != 1) {
    return VCell { ...c };
  }
  let want = cell_kind_of(parser.render_type_ref(ref.args[0]));
  if (!cell_kind_numeric(want) || !cell_kind_numeric(c.kind) || want == c.kind) {
    return VCell { ...c };
  }
  let encoded = encoded_value(coerce_int_width(managed_cell_value(c.root), want), c.root.heap);
  if (encoded.ok) {
    interpheap.replace(c.root, encoded.text, [], encoded.edges);
    return VCell { ...c, kind: want };
  }
  return VCell { ...c };
}

function cell_kind_numeric(kind: string): boolean {
  return util.has_str(["i32", "u32", "u8", "i64", "u64", "usize", "f64", "f32"], kind);
}

function cell_hex_text(h: usize, bits: i64): void {
  let digits = "0123456789abcdef";
  let shift = 60;
  while (shift >= 0) {
    let nibble = (bits >> shift as i64 & 15i64) as i32;
    buf_push_byte(h, digits[nibble] as i32);
    shift -= 4;
  }
}

function cell_bits_text(h: usize, tag: i32, bits: i64): void {
  buf_push_byte(h, tag);
  cell_hex_text(h, bits);
}

function cell_name_text(h: usize, s: string): void {
  cell_hex_text(h, s.len() as i64);
  buf_push(h, s);
}

function cell_scalar_text(h: usize, v: Value): boolean {
  match (v) {
    VInt(n) => {
      let tag = 105;
      if (n.is_char) {
        tag = 99;
      }
      if (n.is_byte) {
        tag = 121;
      }
      cell_bits_text(h, tag, n.v as i64);
    },
    VUint(n) => {
      cell_bits_text(h, 110, uint_zext(n.v));
    },
    VInt64(n) => {
      let tag = 108;
      if (n.ptr) {
        tag = 122;
      } else if (n.unsigned) {
        tag = 117;
      }
      cell_bits_text(h, tag, vint_as_i64(v));
    },
    VBool(b) => {
      let bits: i64 = 0i64;
      if (b.v) {
        bits = 1i64;
      }
      cell_bits_text(h, 98, bits);
    },
    VFloat(f) => {
      cell_bits_text(h, 100, f64_bits(f.v));
    },
    VFloat32(f) => {
      cell_bits_text(h, 102, f32_bits(f.v as f32) as i64);
    },
    VString(sv) => {
      buf_push_byte(h, 115);
      cell_name_text(h, sv.v);
    },
    _ => {
      return false;
    }
  }
  return true;
}

function cell_parts_text(h: usize, vs: Value[], own edges: interpheap.Root[], heap: interpheap.Heap, captures: boolean, seen: Cell[Map[i64, i32]]): (boolean, interpheap.Root[]) {
  cell_hex_text(h, vs.len() as i64);
  for v in vs {
    let (ok, next) = cell_any_text(h, v, edges, heap, captures, seen);
    edges = unsafe { share_unchecked(next) };
    if (!ok) {
      return (false, edges);
    }
  }
  return (true, edges);
}

// The key of a value that the text holds one time, or zero.
function shared_key(v: Value): i64 {
  if let VArr(a) = v {
    if (a.view) {
      return 0i64;
    }
    return array_key(a);
  }
  if let VTuple(t) = v {
    return t.key;
  }
  if let VMap(m) = v {
    return m.key;
  }
  if let VStruct(st) = v {
    return st.key;
  }
  return 0i64;
}

// A value with a key has the tag `K` at its first copy. A later copy is a
// reference to the count of the keyed values that came before the first one.
function cell_any_text(h: usize, v: Value, own edges: interpheap.Root[], heap: interpheap.Heap, captures: boolean, seen: Cell[Map[i64, i32]]): (boolean, interpheap.Root[]) {
  let key = shared_key(v);
  if (key == 0i64) {
    return cell_tree_text(h, v, edges, heap, captures, seen);
  }
  let at = seen.get().get_or(key, -1);
  if (at >= 0) {
    if let VArr(a) = v {
      cell_bits_text(h, 114, at as i64);
      cell_name_text(h, a.elem);
      return (true, edges);
    }
    cell_bits_text(h, 82, at as i64);
    return (true, edges);
  }
  buf_push_byte(h, 75);
  let (ok, next) = cell_tree_text(h, v, edges, heap, captures, seen);
  let known = seen.get();
  seen.set(map_new(0));
  let n = known.len();
  seen.set(known.insert(key, n));
  return (ok, next);
}

function cell_tree_text(h: usize, v: Value, own edges: interpheap.Root[], heap: interpheap.Heap, captures: boolean, seen: Cell[Map[i64, i32]]): (boolean, interpheap.Root[]) {
  if let VHandle(value) = v {
    let handle = interpheap.NativeHandle { reader: value.r, writer: value.w, directory: value.d };
    let root = interpheap.allocate_handle(heap, handle);
    cell_bits_text(h, 72, edges.len() as i64);
    return (true, edges.append(root));
  }
  if (captures) {
    match (v) {
      VCellV(cv) => {
        cell_bits_text(h, 118, edges.len() as i64);
        return (true, edges.append(cv.root));
      },
      VCell(c) => {
        cell_bits_text(h, 67, edges.len() as i64);
        cell_name_text(h, c.kind);
        return (true, edges.append(c.root));
      },
      VFunc(f) => {
        let captured = encoded_captures(f.captured_values, heap);
        if (!captured.ok) {
          return (false, edges);
        }
        let code = interpheap.ClosureCode { params: f.params, ret_type: f.ret_type, body: f.body, captured_names: f.captured_names, captured_types: f.captured_types, generic_name: f.generic_name };
        let root = interpheap.allocate_closure(heap, code, captured.text, captured.edges);
        cell_bits_text(h, 70, edges.len() as i64);
        return (true, edges.append(root));
      },
      _ => {}
    }
  }
  match (v) {
    VArr(a) => {
      buf_push_byte(h, 97);
      cell_hex_text(h, edges.len() as i64);
      cell_hex_text(h, a.offset as i64);
      let view: i64 = 0i64;
      if (a.view) {
        view = 1i64;
      }
      cell_hex_text(h, view);
      cell_name_text(h, a.elem);
      let store = a.store;
      edges = unsafe { share_unchecked(edges.append(store)) };
      return cell_parts_text(h, a.items, edges, heap, captures, seen);
    },
    VTuple(t) => {
      buf_push_byte(h, 116);
      return cell_parts_text(h, t.elements, edges, heap, captures, seen);
    },
    VMap(m) => {
      buf_push_byte(h, 109);
      let (ok, next) = cell_parts_text(h, m.keys, edges, heap, captures, seen);
      if (!ok) {
        return (false, next);
      }
      return cell_parts_text(h, m.values, unsafe { share_unchecked(next) }, heap, captures, seen);
    },
    VStruct(st) => {
      buf_push_byte(h, 83);
      cell_name_text(h, st.type_name);
      cell_name_text(h, st.owner);
      cell_hex_text(h, st.targs.len() as i64);
      for ta in st.targs {
        cell_name_text(h, ta);
      }
      cell_hex_text(h, st.field_names.len() as i64);
      for name in st.field_names {
        cell_name_text(h, name);
      }
      return cell_parts_text(h, st.field_values, edges, heap, captures, seen);
    },
    _ => {
      return (cell_scalar_text(h, v), edges);
    }
  }
}

struct EncodedValue { ok: boolean, text: string, edges: interpheap.Root[] }

// Public Cell values cannot contain functions or cells.
function encoded_value(v: Value, heap: interpheap.Heap): EncodedValue {
  return encoded_value_mode(v, heap, false);
}

// Internal slots store captures through managed edges, which the collector can trace.
function encoded_binding(v: Value, heap: interpheap.Heap): EncodedValue {
  return encoded_value_mode(v, heap, true);
}

function encoded_captures(values: Value[], heap: interpheap.Heap): EncodedValue {
  let h = buf_new(64);
  let (ok, edges) = cell_parts_text(h, values, [], heap, true, cell_new(map_new(0)));
  return encoded_buffer(h, ok, edges);
}

function encoded_value_mode(v: Value, heap: interpheap.Heap, captures: boolean): EncodedValue {
  let h = buf_new(64);
  let (ok, edges) = cell_any_text(h, v, [], heap, captures, cell_new(map_new(0)));
  return encoded_buffer(h, ok, edges);
}

function encoded_buffer(h: usize, ok: boolean, edges: interpheap.Root[]): EncodedValue {
  if (!ok) {
    buf_free(h);
    return EncodedValue { ok: false, text: "", edges: [] };
  }
  // The payload can contain a byte string that is not UTF-8.
  let text = "";
  unsafe {
    text = string_from_bytes_unchecked(buf_take_bytes(h));
  }
  buf_free(h);
  return EncodedValue { ok: true, text: text, edges: edges };
}

function managed_cell_value(root: interpheap.Root): Value {
  let payload = interpheap.get(root);
  let edges = interpheap.children(root);
  return cell_any_value(payload.text, cell_new(0), edges, root.heap, []).value;
}

function cell_scalar_value(tag: i32, bits: i64): Value {
  if (tag == 121) {
    return v_byte(bits as i32);
  }
  if (tag == 105) {
    return v_int(bits as i32);
  }
  if (tag == 99) {
    return VInt { v: bits as i32, is_char: true, is_byte: false };
  }
  if (tag == 110) {
    return VUint { v: bits as i32 };
  }
  if (tag == 122) {
    return v_usize(bits);
  }
  if (tag == 108 || tag == 117) {
    return VInt64 { hi: (bits >> 32i64) as i32, lo: bits as i32, unsigned: tag == 117, ptr: false };
  }
  if (tag == 98) {
    return v_bool(bits != 0i64);
  }
  if (tag == 100) {
    return v_float(f64_from_bits(bits));
  }
  return v_float32(f32_from_bits(bits as i32) as f64);
}

function cell_hex_value(s: string, at: Cell[i32]): i64 {
  let i = at.get();
  let bits: i64 = 0i64;
  for j in 0..16 {
    let digit = s[i + j] as i32 - 48;
    if (digit > 9) {
      digit -= 39;
    }
    bits = bits << 4i64 | digit as i64;
  }
  at.set(i + 16);
  return bits;
}

function cell_name_value(s: string, at: Cell[i32]): string {
  let n = cell_hex_value(s, at) as i32;
  let i = at.get();
  at.set(i + n);
  return slice_unchecked(s, i, i + n).to_owned();
}

// `seen` holds each keyed value that the text gave, in the sequence of the text.
struct Got { value: Value, seen: Value[] }

struct GotParts { values: Value[], seen: Value[] }

function cell_parts_value(s: string, at: Cell[i32], edges: interpheap.Root[], heap: interpheap.Heap, own seen: Value[]): GotParts {
  let n = cell_hex_value(s, at) as i32;
  let out: Value[] = [];
  let known = seen;
  for k in 0..n {
    let got = cell_any_value(s, at, edges, heap, known);
    out = out.append(got.value);
    known = got.seen;
  }
  return GotParts { values: out, seen: known };
}

function cell_any_value(s: string, at: Cell[i32], edges: interpheap.Root[], heap: interpheap.Heap, own seen: Value[]): Got {
  let tag = s[at.get()] as i32;
  at.set(at.get() + 1);
  if (tag == 82) {
    return Got { value: seen[cell_hex_value(s, at) as i32], seen: seen };
  }
  if (tag == 114) {
    let first = seen[cell_hex_value(s, at) as i32];
    let elem = cell_name_value(s, at);
    if let VArr(a) = first {
      if (a.elem != elem) {
        return Got { value: VArr { ...a, elem: elem }, seen: seen };
      }
    }
    return Got { value: first, seen: seen };
  }
  if (tag == 75) {
    let got = cell_compound_value(s, at, edges, heap, seen, true);
    return Got { value: got.value, seen: got.seen.append(got.value) };
  }
  at.set(at.get() - 1);
  return cell_compound_value(s, at, edges, heap, seen, false);
}

function cell_key(heap: interpheap.Heap, keyed: boolean): i64 {
  if (keyed) {
    return interpheap.serial(heap);
  }
  return 0i64;
}

function cell_compound_value(s: string, at: Cell[i32], edges: interpheap.Root[], heap: interpheap.Heap, own seen: Value[], keyed: boolean): Got {
  let tag = s[at.get()] as i32;
  at.set(at.get() + 1);
  if (tag == 97) {
    let edge = cell_hex_value(s, at) as i32;
    let offset = cell_hex_value(s, at) as i32;
    let view = cell_hex_value(s, at) != 0i64;
    let elem = cell_name_value(s, at);
    let items = cell_parts_value(s, at, edges, heap, seen);
    return Got { value: VArr { items: items.values, elem: elem, view: view, store: edges[edge], offset: offset }, seen: items.seen };
  }
  if (tag == 116) {
    let els = cell_parts_value(s, at, edges, heap, seen);
    return Got { value: VTuple { elements: els.values, key: cell_key(heap, keyed) }, seen: els.seen };
  }
  if (tag == 109) {
    let keys = cell_parts_value(s, at, edges, heap, seen);
    let values = cell_parts_value(s, at, edges, heap, keys.seen);
    return Got { value: VMap { keys: keys.values, values: values.values, key: cell_key(heap, keyed) }, seen: values.seen };
  }
  if (tag == 83) {
    let type_name = cell_name_value(s, at);
    let owner = cell_name_value(s, at);
    let nt = cell_hex_value(s, at) as i32;
    let targs: string[] = [];
    while (targs.len() < nt) {
      targs = targs.append(cell_name_value(s, at));
    }
    let n = cell_hex_value(s, at) as i32;
    let names: string[] = [];
    while (names.len() < n) {
      names = names.append(cell_name_value(s, at));
    }
    let fields = cell_parts_value(s, at, edges, heap, seen);
    return Got { value: VStruct { type_name: type_name, field_names: names, field_values: fields.values, owner: owner, targs: targs, key: cell_key(heap, keyed) }, seen: fields.seen };
  }
  return Got { value: cell_leaf_value(s, at, edges, heap, tag), seen: seen };
}

function cell_leaf_value(s: string, at: Cell[i32], edges: interpheap.Root[], heap: interpheap.Heap, tag: i32): Value {
  if (tag == 115) {
    return v_string(cell_name_value(s, at));
  }
  if (tag == 118) {
    return VCellV { root: edges[cell_hex_value(s, at) as i32] };
  }
  if (tag == 67) {
    let root = edges[cell_hex_value(s, at) as i32];
    return VCell { kind: cell_name_value(s, at), root: root };
  }
  if (tag == 72) {
    let root = edges[cell_hex_value(s, at) as i32];
    if let Some(handle) = interpheap.get(root).handle {
      return VHandle { r: handle.reader, w: handle.writer, d: handle.directory };
    }
    return v_err("function capture has no handle");
  }
  if (tag == 70) {
    let root = edges[cell_hex_value(s, at) as i32];
    let payload = interpheap.get(root);
    if let Some(code) = payload.closure {
      let captured = cell_parts_value(payload.text, cell_new(0), interpheap.children(root), heap, []);
      return VFunc { params: code.params, ret_type: code.ret_type, body: code.body, captured_names: code.captured_names, captured_values: captured.values, captured_types: code.captured_types, generic_name: code.generic_name };
    }
    return v_err("function binding has no code");
  }
  return cell_scalar_value(tag, cell_hex_value(s, at));
}

function cell_set_value(c: VCell, v: Value): Value {
  let value = coerce_int_width(v, c.kind);
  if (c.kind != "value" && cell_value_kind(value) != c.kind) {
    return v_err("Cell.set: the value is not a " + c.kind);
  }
  let encoded = encoded_value(value, c.root.heap);
  if (!encoded.ok) {
    return v_err("Cell: the value holds a function or a cell, which E057 rejects");
  }
  interpheap.replace(c.root, encoded.text, [], encoded.edges);
  return v_void();
}

function cell_method(c: VCell, name: string, args: Value[]): Value {
  if (name == "get") {
    if (args.len() != 0) {
      return v_err("Cell.get takes no arguments");
    }
    return managed_cell_value(c.root);
  }
  if (name == "set") {
    if (args.len() != 1) {
      return v_err("Cell.set takes exactly 1 argument");
    }
    return cell_set_value(c, args[0]);
  }
  return v_err("undefined method `" + name + "` on `Cell`");
}

function byte_array_value(heap: interpheap.Heap, bytes: u8[]): Value {
  let out: Value[] = [];
  for i in 0..bytes.len() {
    out = out.append(v_int(bytes[i] as i32));
  }
  return v_arr_of(heap, out, "u8");
}

function call_xattr(heap: interpheap.Heap, name: string, args: Value[]): Value {
  let reading = name == "getxattr" || name == "lgetxattr" || name == "getxattr_bytes" || name == "lgetxattr_bytes";
  let count = 3;
  if (reading) {
    count = 2;
  }
  if (args.len() != count) {
    return v_err(name + ": wrong argument count");
  }
  if (!is_string_arg(args[0]) || !is_string_arg(args[1])) {
    return v_err(name + ": expected path and attribute name strings");
  }
  let path = vstr_of(args[0]);
  let attr = vstr_of(args[1]);
  let follow = name[0] != 108 as u8;
  if (reading) {
    if (name == "getxattr_bytes" || name == "lgetxattr_bytes") {
      let result: Result[u8[], IoError] = Err(Unsupported);
      if (follow) {
        result = getxattr_bytes(path, attr);
      } else {
        result = lgetxattr_bytes(path, attr);
      }
      match (result) {
        Ok(bytes) => {
          return v_variant("Ok", [byte_array_value(heap, bytes)]);
        },
        Err(e) => {
          return v_variant("Err", [io_error_value(e)]);
        }
      }
    }
    let result: Result[string, IoError] = Err(Unsupported);
    if (follow) {
      result = getxattr(path, attr);
    } else {
      result = lgetxattr(path, attr);
    }
    match (result) {
      Ok(text) => {
        return v_variant("Ok", [v_string(text)]);
      },
      Err(e) => {
        return v_variant("Err", [io_error_value(e)]);
      }
    }
  }
  let result: Result[void, IoError] = Err(Unsupported);
  if (name == "setxattr_bytes" || name == "lsetxattr_bytes") {
    if let VArr(a) = args[2] {
      let bytes = __alloc_u8(arr_len(a));
      let i = 0;
      while (i < arr_len(a)) {
        if (!is_i32_arg(arr_at(a, i))) {
          return v_err(name + ": expected byte array");
        }
        bytes = bytes.with(i, vint_bits(arr_at(a, i)) as u8);
        i += 1;
      }
      if (follow) {
        result = setxattr_bytes(path, attr, bytes);
      } else {
        result = lsetxattr_bytes(path, attr, bytes);
      }
    } else {
      return v_err(name + ": expected byte array");
    }
  } else {
    if (!is_string_arg(args[2])) {
      return v_err(name + ": expected string value");
    }
    let text = vstr_of(args[2]);
    if (follow) {
      result = setxattr(path, attr, text);
    } else {
      result = lsetxattr(path, attr, text);
    }
  }
  match (result) {
    Ok(_) => {
      return v_variant("Ok", [v_tuple([])]);
    },
    Err(e) => {
      return v_variant("Err", [io_error_value(e)]);
    }
  }
}

function i64_result_value(result: Result[i64, IoError]): Value {
  match (result) {
    Ok(n) => {
      return v_variant("Ok", [box_i64(n)]);
    },
    Err(e) => {
      return v_variant("Err", [io_error_value(e)]);
    }
  }
}

function option_string_value(o: Option[string]): Value {
  match (o) {
    Some(line) => {
      return v_variant("Some", [v_string(line)]);
    },
    None => {
      let none: Value[] = [];
      return v_variant("None", none);
    }
  }
}

function io_error_value(e: IoError): Value {
  let none: Value[] = [];
  match (e) {
    NotFound(p) => {
      return v_variant_of("IoError", "NotFound", [v_string(p)]);
    },
    PermissionDenied(p) => {
      return v_variant_of("IoError", "PermissionDenied", [v_string(p)]);
    },
    AlreadyExists(p) => {
      return v_variant_of("IoError", "AlreadyExists", [v_string(p)]);
    },
    InvalidUtf8(p) => {
      return v_variant_of("IoError", "InvalidUtf8", [v_string(p)]);
    },
    Interrupted => {
      return v_variant_of("IoError", "Interrupted", none);
    },
    Unsupported => {
      return v_variant_of("IoError", "Unsupported", none);
    },
    Other(p, m, n) => {
      return v_variant_of("IoError", "Other", [v_string(p), v_string(m), v_int(n)]);
    }
  }
}

function arg_at(args: Value[], i: i32): Value {
  if (i < args.len()) {
    return deref_cell(args[i]);
  }
  return v_absent();
}

function arg_str(args: Value[], i: i32): string {
  return vstr_of(arg_at(args, i));
}

function arg_i32(args: Value[], i: i32): i32 {
  return vint_as_i64(arg_at(args, i)) as i32;
}

function arg_i64(args: Value[], i: i32): i64 {
  return vint_as_i64(arg_at(args, i));
}

function arg_bool(args: Value[], i: i32): boolean {
  if let VBool(b) = arg_at(args, i) {
    return b.v;
  }
  return false;
}

function arg_bytes(args: Value[], i: i32): u8[] {
  let out: u8[] = [];
  if let VArr(a) = arg_at(args, i) {
    for e in arr_els(a) {
      out = out.append(vint_as_i64(e) as u8);
    }
  }
  return out;
}

function arg_i32s(args: Value[], i: i32): i32[] {
  let out: i32[] = [];
  if let VArr(a) = arg_at(args, i) {
    for e in arr_els(a) {
      out = out.append(vint_as_i64(e) as i32);
    }
  }
  return out;
}

function arg_i64s(args: Value[], i: i32): i64[] {
  let out: i64[] = [];
  if let VArr(a) = arg_at(args, i) {
    for e in arr_els(a) {
      out = out.append(vint_as_i64(e));
    }
  }
  return out;
}

function arg_strs(args: Value[], i: i32): string[] {
  let out: string[] = [];
  if let VArr(a) = arg_at(args, i) {
    for e in arr_els(a) {
      out = out.append(vstr_of(e));
    }
  }
  return out;
}

function string_array_value(heap: interpheap.Heap, xs: string[]): Value {
  let out: Value[] = [];
  for x in xs {
    out = out.append(v_string(x));
  }
  return v_arr_of(heap, out, "string");
}

function i64_array_value(heap: interpheap.Heap, xs: i64[]): Value {
  let out: Value[] = [];
  for x in xs {
    out = out.append(v_int64(x));
  }
  return v_arr_of(heap, out, "i64");
}

function ok_value(v: Value): Value {
  return v_variant("Ok", [v]);
}

function io_err_value(e: IoError): Value {
  return v_variant("Err", [io_error_value(e)]);
}

function void_result_value(r: Result[void, IoError]): Value {
  match (r) {
    Ok(_) => {
      return ok_value(v_tuple([]));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function string_result_value(r: Result[string, IoError]): Value {
  match (r) {
    Ok(s) => {
      return ok_value(v_string(s));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function bytes_result_value(heap: interpheap.Heap, r: Result[u8[], IoError]): Value {
  match (r) {
    Ok(b) => {
      return ok_value(byte_array_value(heap, b));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function strings_result_value(heap: interpheap.Heap, r: Result[string[], IoError]): Value {
  match (r) {
    Ok(xs) => {
      return ok_value(string_array_value(heap, xs));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function i64s_result_value(heap: interpheap.Heap, r: Result[i64[], IoError]): Value {
  match (r) {
    Ok(xs) => {
      return ok_value(i64_array_value(heap, xs));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function file_stat_value(st: FileStat): Value {
  return v_struct(
    "FileStat", ["is_file", "is_dir", "size", "mode", "nlink", "uid", "gid", "dev", "rdev", "ino", "blksize", "blocks", "atime", "atime_nsec", "mtime", "mtime_nsec", "ctime", "ctime_nsec", "btime", "btime_nsec"],
    [
      v_bool(st.is_file), v_bool(st.is_dir), v_int64(st.size), v_uint(st.mode as i32), v_uint(st.nlink as i32), v_uint(st.uid as i32), v_uint(st.gid as i32),
      v_int64(st.dev), v_int64(st.rdev), v_int64(st.ino), v_int64(st.blksize), v_int64(st.blocks), v_int64(st.atime), v_int64(st.atime_nsec),
      v_int64(st.mtime), v_int64(st.mtime_nsec), v_int64(st.ctime), v_int64(st.ctime_nsec), v_int64(st.btime), v_int64(st.btime_nsec),
    ],
  );
}

function stat_result_value(r: Result[FileStat, IoError]): Value {
  match (r) {
    Ok(st) => {
      return ok_value(file_stat_value(st));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function byte_arrays_result_value(heap: interpheap.Heap, r: Result[u8[][], IoError]): Value {
  match (r) {
    Ok(names) => {
      let out: Value[] = [];
      for name in names {
        out = out.append(byte_array_value(heap, name));
      }
      return ok_value(v_arr_of(heap, out, "u8[]"));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function dir_entries_result_value(heap: interpheap.Heap, r: Result[DirEntry[], IoError]): Value {
  match (r) {
    Ok(es) => {
      let out: Value[] = [];
      for de in es {
        out = out.append(v_struct("DirEntry", ["name", "ino", "kind"], [v_string(de.name), v_int64(de.ino), v_uint(de.kind as i32)]));
      }
      return ok_value(v_arr_of(heap, out, "DirEntry"));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function fs_stat_result_value(r: Result[FsStat, IoError]): Value {
  match (r) {
    Ok(f) => {
      return ok_value(v_struct(
        "FsStat", ["block_size", "blocks", "blocks_free", "blocks_avail", "files", "files_free", "name_max", "path_max", "fs_type", "fsid", "frag_size", "fs_type_name"],
        [
          v_int64(f.block_size), v_int64(f.blocks), v_int64(f.blocks_free), v_int64(f.blocks_avail), v_int64(f.files), v_int64(f.files_free),
          v_int64(f.name_max), v_int64(f.path_max), v_int64(f.fs_type), v_int64(f.fsid), v_int64(f.frag_size), v_string(f.fs_type_name),
        ],
      ));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function mounts_result_value(heap: interpheap.Heap, r: Result[MountEntry[], IoError]): Value {
  match (r) {
    Ok(ms) => {
      let out: Value[] = [];
      for m in ms {
        out = out.append(v_struct("MountEntry", ["source", "target", "fstype", "dev"], [v_string(m.source), v_string(m.target), v_string(m.fstype), v_int64(m.dev)]));
      }
      return ok_value(v_arr_of(heap, out, "MountEntry"));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function win_size_result_value(r: Result[WinSize, IoError]): Value {
  match (r) {
    Ok(ws) => {
      return ok_value(v_struct("WinSize", ["rows", "cols"], [v_int64(ws.rows), v_int64(ws.cols)]));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function reader_value(r: Reader): Value {
  return VHandle { r: Some(r), w: None, d: None };
}

function writer_value(w: Writer): Value {
  return VHandle { r: None, w: Some(w), d: None };
}

function reader_result_value(r: Result[Reader, IoError]): Value {
  match (r) {
    Ok(h) => {
      return ok_value(reader_value(h));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function writer_result_value(r: Result[Writer, IoError]): Value {
  match (r) {
    Ok(h) => {
      return ok_value(writer_value(h));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function dir_result_value(r: Result[Dir, IoError]): Value {
  match (r) {
    Ok(h) => {
      return ok_value(VHandle { r: None, w: None, d: Some(h) });
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function pipe_result_value(r: Result[Pipe, IoError]): Value {
  match (r) {
    Ok(p) => {
      return ok_value(v_struct("Pipe", ["r", "w"], [reader_value(p.r), writer_value(p.w)]));
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function handle_kind(h: VHandle): string {
  match (h.r) {
    Some(_) => {
      return "Reader";
    },
    None => {}
  }
  match (h.w) {
    Some(_) => {
      return "Writer";
    },
    None => {}
  }
  return "Dir";
}

function handle_fd(h: VHandle): Value {
  match (h.r) {
    Some(r) => {
      return v_int(r.fd);
    },
    None => {}
  }
  match (h.w) {
    Some(w) => {
      return v_int(w.fd);
    },
    None => {}
  }
  match (h.d) {
    Some(d) => {
      return v_int(d.fd);
    },
    None => {}
  }
  return v_err("empty host handle");
}

function enosys_errno(): i32 {
  if (target_os() == "darwin") {
    return 78;
  }
  if (target_arch() == "wasm32") {
    return 52;
  }
  return 38;
}

function host_enosys(): Value {
  return v_int(0 - enosys_errno());
}

function enosys_error(path: string): Value {
  return io_err_value(Other(path, "Function not implemented", enosys_errno()));
}

// A worker that exits has no result, which stops the program as the join of
// a worker process does.
function worker_exit(heap: interpheap.Heap, name: string, args: Value[]): void {
  if (name == "exit" && heap.workers.get() > 0i64) {
    eprint("worker: the worker exited with status " + util.i32_to_string(arg_i32(args, 0)) + " and no result");
    exit(134);
  }
}

function call_host(heap: interpheap.Heap, name: string, args: Value[]): Value {
  worker_exit(heap, name, args);
  if (is_raw_floor(name)) {
    return v_err(name + " takes machine addresses, and the interpreter has no address space");
  }
  let cap = platforms.gated_capability(name);
  let contract = call_host_contract(heap, name, args);
  if (!is_err(contract)) {
    return contract;
  }
  if (playground_provides(name, cap)) {
    return call_host_portable(heap, name, cap, args);
  }
  if (target_arch() == "wasm32") {
    return v_err(name + ": the playground this interpreter runs in does not provide it");
  } else {
    return call_host_native(heap, name, cap, args);
  }
}

function playground_provides(name: string, cap: string): boolean {
  if (cap.len() > 0 && !platforms.has_capability("wasm32-wasi", cap)) {
    return false;
  }
  return !util.has_str(["tcp", "reactor"], cap) && !util.has_str(["poll", "sleep_ms", "sleep_ns"], name);
}

function is_raw_floor(name: string): boolean {
  return util.has_str(["__syscall3", "__syscall4", "__syscall5", "__syscall6"], name)
    || util.has_str(["__c_call0", "__c_call0_f32", "__c_call0_f64", "__c_call1", "__c_call1_f32", "__c_call1_f64", "__c_call2", "__c_call2_f32", "__c_call2_f64"], name)
    || util.has_str(["__c_call3", "__c_call3_f32", "__c_call3_f64", "__c_call4", "__c_call4_f32", "__c_call4_f64"], name)
    || util.has_str(["__c_call5", "__c_call5_f32", "__c_call5_f64", "__c_call6", "__c_call6_f32", "__c_call6_f64", "__c_callv"], name)
    || util.has_str(["__raw_alloc", "__raw_string", "__raw_arr_box", "__raw_scratch", "__raw_environ", "__raw_splice_pipe", "__raw_cover", "__raw_task_state", "__raw_vdso", "__raw_vg_request"], name);
}

function call_runtime_intrinsic(heap: interpheap.Heap, name: string, args: Value[]): Value {
  if (typeinfo.lane_builtin_width(name) > 0) {
    return call_lane_builtin(heap, name, typeinfo.lane_builtin_width(name), args);
  }
  if (util.has_str(["__rc_underflow_count", "__arr_push_shared_count", "__arr_push_shared_bytes", "__heap_alloc_count", "__heap_bump_bytes"], name)) {
    return v_int(0);
  }
  if (name == "__map_hash_seed") {
    return v_int(__map_hash_seed());
  }
  if (util.has_str(["__sqrt_f64", "__floor_f64", "__ceil_f64", "__round_f64", "__trunc_f64", "__abs_f64"], name)) {
    if (args.len() != 1 || !is_float_like(args[0])) {
      return v_err(name + ": expected 1 float arg");
    }
    return v_float(f64_primitive(name, vfloat_as_f64(args[0])));
  }
  // The interpreter hands out one task id, so another id names no task record.
  if (util.has_str(["__task_free", "__task_enter", "__task_set_ready", "__task_set_cancelled", "__task_timeout", "__task_until", "__task_wait"], name)) {
    if (args.len() > 0 && is_int_like(args[0]) && int_arg_i32(args[0]) != 1) {
      return index_abort(aborts.arr_oob(), util.i32_to_string(int_arg_i32(args[0])), 2);
    }
  }
  if (util.has_str(["__task_free", "__task_enter", "__task_set_ready", "__task_set_cancelled"], name)) {
    return v_void();
  }
  if (util.has_str(["__task_cur", "__task_leave", "__task_cancelled", "__task_fd_gen"], name)) {
    return v_int(0);
  }
  // The number of worker bodies that run in this process.
  if (name == "__task_inline") {
    heap.workers.set(heap.workers.get() + arg_i64(args, 0));
    return v_int(heap.workers.get() as i32);
  }
  if (util.has_str(["__task_park", "__task_park_until", "__task_timeout"], name)) {
    return v_int(-1);
  }
  return match (name) {
    "__task_until" => v_int64(-1i64),
    "__task_new" => v_int(1),
    "__task_wait" => v_arr(heap, []),
    _ => v_err("not a runtime intrinsic"),
  };
}

function lane_bits(width: i32, x: f64): i64 {
  if (width == 32) {
    return f32_bits(x as f32) as i64 & 4294967295;
  }
  return f64_bits(x);
}

function lane_at(l: VLanes, i: i32): f64 {
  if (l.width == 32) {
    return f32_from_bits(l.bits[i] as i32) as f64;
  }
  return f64_from_bits(l.bits[i]);
}

function lane_round(width: i32, x: f64): f64 {
  if (width == 32) {
    return (x as f32) as f64;
  }
  return x;
}

function lane_sign(width: i32): i64 {
  if (width == 32) {
    return 2147483648;
  }
  return -9223372036854775807 - 1;
}

function lanes_splat(width: i32, x: f64): Value {
  let bits: i64[] = [];
  while (bits.len() < 128 / width) {
    bits = bits.append(lane_bits(width, x));
  }
  return VLanes { width: width, kind: typeinfo.LANE_FLOAT, bits: bits };
}

function lanes_map_bits(l: VLanes, flip: i64, clear: i64): Value {
  let bits: i64[] = [];
  for b in l.bits {
    bits = bits.append((b ^ flip) & (clear ^ -1));
  }
  return VLanes { width: l.width, kind: typeinfo.LANE_FLOAT, bits: bits };
}

function lane_arith(op: string, x: f64, y: f64): f64 {
  return match (op) {
    "+" => x + y,
    "-" => x - y,
    "*" => x * y,
    _ => x / y,
  };
}

// The lanes of 8 bits fn(a, b), with each result cut to 8 bits.
function byte_lanes_map(a: VLanes, b: VLanes, verb: string): Value {
  let bits: i64[] = [];
  for i in 0..16 {
    bits = bits.append(byte_lane_op(verb, a.bits[i], b.bits[i]) & 255i64);
  }
  return VLanes { width: 8, kind: typeinfo.LANE_UNSIGNED, bits: bits };
}

function byte_mask(hold: boolean): i64 {
  return if (hold) { 255i64 } else { 0i64 };
}

function byte_lane_op(verb: string, x: i64, y: i64): i64 {
  return match (verb) {
    "+" => x + y,
    "-" => x - y,
    "min" => if (x < y) { x } else { y },
    "max" => if (x < y) { y } else { x },
    "eq" => byte_mask(x == y),
    "ne" => byte_mask(x != y),
    "lt" => byte_mask(x < y),
    "add_sat" => if (x + y > 255i64) { 255i64 } else { x + y },
    "sub_sat" => if (x < y) { 0i64 } else { x - y },
    "avg" => x + y + 1i64 >> 1i64,
    "and" => x & y,
    "or" => x | y,
    "andnot" => x & (255i64 ^ y),
    _ => x ^ y,
  };
}

// The lanes of 8 bits of the values `xs`. One value is a splat.
function byte_lanes_of(xs: Value[]): Value {
  let bits: i64[] = [];
  for i in 0..16 {
    bits = bits.append(vint_as_i64(xs[i % xs.len()]) & 255i64);
  }
  return VLanes { width: 8, kind: typeinfo.LANE_UNSIGNED, bits: bits };
}

function call_byte_lane_builtin(heap: interpheap.Heap, verb: string, args: Value[]): Value {
  if (verb == "splat" || verb == "of") {
    return byte_lanes_of(args);
  }
  if (verb == "load") {
    let at = lane_window(8, args);
    if (at < 0) {
      return v_err("lane load out of bounds");
    }
    if let VArr(a) = args[0] {
      let xs: Value[] = [];
      while (xs.len() < 16) {
        xs = xs.append(arr_at(a, at + xs.len()));
      }
      return byte_lanes_of(xs);
    }
    return v_err("lane load: expected an array");
  }
  if (verb == "with") {
    return lanes_with(heap, 8, args);
  }
  let ls = lane_args(if (verb == "lane") { [args[0]] } else { args });
  if (ls.len() == 0) {
    return v_err("__u8x16_" + verb + ": expected lane values");
  }
  if (verb == "lane") {
    return v_byte(ls[0].bits[vint_bits(args[1])] as i32);
  }
  if (verb == "bitmask") {
    let mask = 0;
    for i in 0..16 {
      mask = mask | (ls[0].bits[i] >> 7i64) as i32 << i;
    }
    return v_int(mask);
  }
  if (verb == "select") {
    if let VLanes(kept) = byte_lanes_map(ls[0], ls[2], "and") {
      if let VLanes(rest) = byte_lanes_map(ls[1], ls[2], "andnot") {
        return byte_lanes_map(kept, rest, "or");
      }
    }
  }
  return byte_lanes_map(ls[0], ls[1], verb);
}

function lanes_binary(op: string, a: VLanes, rv: Value): Value {
  if let VLanes(b) = rv {
    if (a.kind != typeinfo.LANE_FLOAT && (op == "+" || op == "-")) {
      return byte_lanes_map(a, b, op);
    }
    if (util.has_str(["+", "-", "*", "/"], op)) {
      let bits: i64[] = [];
      for i in 0..a.bits.len() {
        bits = bits.append(lane_bits(a.width, lane_arith(op, lane_at(a, i), lane_at(b, i))));
      }
      return VLanes { width: a.width, kind: typeinfo.LANE_FLOAT, bits: bits };
    }
  }
  return v_err("operator `" + op + "` on lane values");
}

function lane_value(l: VLanes, i: i32): Value {
  if (l.kind != typeinfo.LANE_FLOAT) {
    return v_byte(l.bits[i] as i32);
  }
  if (l.width == 32) {
    return v_float32(lane_at(l, i));
  }
  return v_float(lane_at(l, i));
}

function lane_args(args: Value[]): VLanes[] {
  let out: VLanes[] = [];
  for a in args {
    if let VLanes(l) = a {
      out = out.append(l);
    } else {
      return [];
    }
  }
  return out;
}

function lane_fn(verb: string, width: i32, xs: f64[]): f64 {
  if (verb == "sqrt" || verb == "floor" || verb == "round") {
    return f64_primitive("__" + verb + "_f64", xs[0]);
  }
  if (verb == "mul_add") {
    return lane_round(width, lane_round(width, xs[0] * xs[1]) + xs[2]);
  }
  if (verb == "min" && xs[1] < xs[0] || verb == "max" && xs[0] < xs[1]) {
    return xs[1];
  }
  return xs[0];
}

function lanes_apply(verb: string, ls: VLanes[]): Value {
  let w = ls[0].width;
  let bits: i64[] = [];
  let i = 0;
  while (i < ls[0].bits.len()) {
    let xs: f64[] = [];
    for l in ls {
      xs = xs.append(lane_at(l, i));
    }
    bits = bits.append(lane_bits(w, lane_fn(verb, w, xs)));
    i += 1;
  }
  return VLanes { width: w, kind: typeinfo.LANE_FLOAT, bits: bits };
}

function lanes_mask(verb: string, a: VLanes, b: VLanes): Value {
  let ones: i64 = -1;
  if (a.width == 32) {
    ones = 4294967295;
  }
  let bits: i64[] = [];
  for i in 0..a.bits.len() {
    let x = lane_at(a, i);
    let y = lane_at(b, i);
    let hold = verb == "lt" && x < y || verb == "ne" && x != y;
    bits = bits.append(if (hold) { ones } else { 0 });
  }
  return VLanes { width: a.width, kind: typeinfo.LANE_FLOAT, bits: bits };
}

function lanes_select(ls: VLanes[]): Value {
  let bits: i64[] = [];
  let i = 0;
  while (i < ls[0].bits.len()) {
    let m = ls[2].bits[i];
    bits = bits.append(ls[0].bits[i] & m | ls[1].bits[i] & (m ^ -1));
    i += 1;
  }
  return VLanes { width: ls[0].width, kind: typeinfo.LANE_FLOAT, bits: bits };
}

function lanes_of(width: i32, args: Value[]): Value {
  if (args.len() != 128 / width) {
    return v_err("lane builtin: expected one float per lane");
  }
  let bits: i64[] = [];
  for a in args {
    bits = bits.append(lane_bits(width, vfloat_as_f64(a)));
  }
  return VLanes { width: width, kind: typeinfo.LANE_FLOAT, bits: bits };
}

function lane_window(width: i32, args: Value[]): i32 {
  if let VArr(a) = args[0] {
    let at = vint_as_i64(args[1]) as i32;
    if (at >= 0 && at + 128 / width <= arr_len(a)) {
      return at;
    }
  }
  return -1;
}

function lanes_load(width: i32, args: Value[]): Value {
  let at = lane_window(width, args);
  if (at < 0) {
    return v_err("lane load out of bounds");
  }
  if let VArr(a) = args[0] {
    let xs: Value[] = [];
    while (xs.len() < 128 / width) {
      xs = xs.append(arr_at(a, at + xs.len()));
    }
    return lanes_of(width, xs);
  }
  return v_err("lane load: expected an array");
}

function lanes_with(heap: interpheap.Heap, width: i32, args: Value[]): Value {
  let at = lane_window(width, args);
  let ls = lane_args([args[2]]);
  if (at < 0 || ls.len() != 1) {
    return v_err("lane with out of bounds");
  }
  if let VArr(a) = args[0] {
    let out = arr_els(a);
    let i = 0;
    while (i < ls[0].bits.len()) {
      out = out.with(at + i, lane_value(ls[0], i));
      i += 1;
    }
    if (a.view) {
      return v_view_of(heap, out, a.elem);
    }
    return v_arr_of(heap, out, a.elem);
  }
  return v_err("lane with: expected an array");
}

function lanes_bytes(heap: interpheap.Heap, width: i32, args: Value[], store: boolean): Value {
  if let VArr(a) = args[0] {
    let at = vint_as_i64(args[1]);
    if (at < 0 || at > arr_len(a) as i64 - 16i64) {
      return v_err("packed lane access out of bounds");
    }
    let bytes = width / 8;
    if (store) {
      let lanes = lane_args([args[2]]);
      if (lanes.len() != 1 || lanes[0].width != width) {
        return v_err("packed lane store requires matching lanes");
      }
      let out = arr_els(a);
      for i in 0..16 {
        let value = lanes[0].bits[i / bytes] >> (i % bytes * 8) as i64;
        out = out.with(at as i32 + i, v_byte(value as i32));
      }
      return v_arr_of(heap, out, "u8");
    }
    let bits: i64[] = [];
    for lane in 0..128 / width {
      let value = 0i64;
      for j in 0..bytes {
        value |= vint_as_i64(arr_at(a, at as i32 + lane * bytes + j)) << (8 * j) as i64;
      }
      bits = bits.append(value);
    }
    return VLanes { width: width, kind: typeinfo.LANE_FLOAT, bits: bits };
  }
  return v_err("packed lane access requires bytes");
}

function call_lane_builtin(heap: interpheap.Heap, name: string, width: i32, args: Value[]): Value {
  let verb = typeinfo.lane_builtin_verb(name);
  if (width == 8) {
    return call_byte_lane_builtin(heap, verb, args);
  }
  if (verb == "lane_bits") {
    let lanes = lane_args([args[0]]);
    let at = vint_bits(args[1]);
    if (lanes.len() != 1 || at < 0 || at >= 128 / width) {
      return v_err("invalid vector lane index");
    }
    return if (width == 32) { v_uint(lanes[0].bits[at] as i32) } else { v_uint64(lanes[0].bits[at]) };
  }
  if (verb == "reverse" || verb == "swap_halves" || verb == "zip_lo" || verb == "zip_hi") {
    let lanes = lane_args(args);
    let count = 128 / width;
    let bits: i64[] = [];
    for i in 0..count {
      let source = if (verb == "reverse" || verb == "swap_halves") { 0 } else { i & 1 };
      let at = if (verb == "swap_halves") { (i + count / 2) % count } else if (verb == "reverse") { count - 1 - i } else { i / 2 + (if (verb == "zip_hi") { count / 2 } else { 0 }) };
      bits = bits.append(lanes[source].bits[at]);
    }
    return VLanes { width: width, kind: typeinfo.LANE_FLOAT, bits: bits };
  }
  if (verb == "load_f32_ptr") {
    let address = vint_as_i64(args[0]) as usize;
    unsafe {
      return VLanes { width: 64, kind: typeinfo.LANE_FLOAT, bits: [f64_bits(f32_from_bits(__load_i32(address)) as f64), f64_bits(f32_from_bits(__load_i32(address + 4 as usize)) as f64)] };
    }
  }
  if (verb == "load_ptr") {
    let address = vint_as_i64(args[0]) as usize;
    let bits: i64[] = [];
    unsafe {
      for i in 0..128 / width {
        bits = bits.append(if (width == 32) { (__load_i32(address + (4 * i) as usize) as u32) as i64 } else { __load_i64(address + (8 * i) as usize) });
      }
    }
    return VLanes { width: width, kind: typeinfo.LANE_FLOAT, bits: bits };
  }
  if (verb == "store") {
    let lanes = lane_args([args[1]]);
    if (lanes.len() != 1 || lanes[0].width != width) {
      return v_err("vector store requires matching lanes");
    }
    let address = vint_as_i64(args[0]) as usize;
    unsafe {
      for i in 0..128 / width {
        if (width == 32) {
          __store_i32(address + (4 * i) as usize, lanes[0].bits[i] as i32);
        } else {
          __store_i64(address + (8 * i) as usize, lanes[0].bits[i]);
        }
      }
    }
    return v_void();
  }
  if (verb == "pack") {
    let lanes = lane_args(args);
    if (lanes.len() != 2) {
      return v_err("pack requires two double vectors");
    }
    return lanes_of(32, [lane_value(lanes[0], 0), lane_value(lanes[0], 1), lane_value(lanes[1], 0), lane_value(lanes[1], 1)]);
  }
  if (verb == "load_bytes" || verb == "with_bytes") {
    return lanes_bytes(heap, width, args, verb == "with_bytes");
  }
  if (verb == "splat" && args.len() == 1) {
    return lanes_splat(width, vfloat_as_f64(args[0]));
  }
  if (verb == "of") {
    return lanes_of(width, args);
  }
  if (verb == "load" && args.len() == 2) {
    return lanes_load(width, args);
  }
  if (verb == "with" && args.len() == 3) {
    return lanes_with(heap, width, args);
  }
  return call_lane_op(verb, width, args);
}

function call_lane_read(width: i32, args: Value[]): Value {
  let ls = lane_args([args[0]]);
  let i = vint_as_i64(args[1]) as i32;
  if (ls.len() == 1 && i >= 0 && i < 128 / width) {
    return lane_value(ls[0], i);
  }
  return v_err("lane: expected a lane value and an index below the lane count");
}

function call_lane_op(verb: string, width: i32, args: Value[]): Value {
  if (verb == "lane" && args.len() == 2) {
    return call_lane_read(width, args);
  }
  let ls = lane_args(args);
  if (ls.len() == 0 || ls.len() != args.len()) {
    return v_err("lane builtin: expected lane operands");
  }
  if (verb == "bitmask" && ls.len() == 1) {
    let mask = 0;
    let k = 0;
    while (k < ls[0].bits.len()) {
      if ((ls[0].bits[k] & lane_sign(width)) != 0) {
        mask = mask | 1 << k;
      }
      k += 1;
    }
    return v_int(mask);
  }
  if (verb == "abs") {
    return lanes_map_bits(ls[0], 0, lane_sign(width));
  }
  if ((verb == "lt" || verb == "ne") && ls.len() == 2) {
    return lanes_mask(verb, ls[0], ls[1]);
  }
  if (verb == "select" && ls.len() == 3) {
    return lanes_select(ls);
  }
  return lanes_apply(verb, ls);
}

function f64_primitive(name: string, x: f64): f64 {
  return match (name) {
    "__sqrt_f64" => __sqrt_f64(x),
    "__floor_f64" => __floor_f64(x),
    "__ceil_f64" => __ceil_f64(x),
    "__round_f64" => __round_f64(x),
    "__trunc_f64" => __trunc_f64(x),
    _ => __abs_f64(x),
  };
}

// The worker builtins in an engine that runs every worker inline: the copy
// has its own stores, a rooted value waits as a pinned heap node, no region
// exists, and the rest never run.
function is_worker_contract(name: string): boolean {
  return util.has_str(["__send_copy", "__send_adopt", "__send_root", "__send_release", "__heap_adopt", "__worker_region", "__worker_exit", "__worker_reap", "__worker_unmap"], name);
}

function worker_contract(heap: interpheap.Heap, name: string, args: Value[]): Value {
  if (name == "__send_copy") {
    return send_copy_value(heap, arg_at(args, 0));
  }
  if (name == "__send_root") {
    let encoded = encoded_value(arg_at(args, 0), heap);
    if (!encoded.ok) {
      return v_err("__send_root: the interpreter cannot hand over a function value");
    }
    return v_usize((interpheap.pin(interpheap.allocate(heap, encoded.text, [], encoded.edges)) + 1) as i64);
  }
  if (name == "__send_adopt") {
    let Some(root) = interpheap.unpin(heap, (arg_i64(args, 0) - 1) as i32) else {
      return v_err("__send_adopt: the handle names no root this process holds");
    };
    return managed_cell_value(root);
  }
  if (name == "__worker_unmap") {
    return v_int(-38);
  }
  if (name == "__heap_adopt" || name == "__send_release") {
    return v_void();
  }
  if (name == "__worker_region") {
    return v_int64(0);
  }
  return v_err(name + ": the interpreter runs every worker inline");
}

function call_host_contract(heap: interpheap.Heap, name: string, args: Value[]): Value {
  if (name == "__heap_mark") {
    return v_int64(0);
  }
  if (name == "__heap_release_to") {
    return v_void();
  }
  if (is_worker_contract(name)) {
    return worker_contract(heap, name, args);
  }
  if (util.has_str(["proc_fork", "proc_exec", "proc_exec_as"], name)) {
    return v_int(-38);
  }
  if (name == "chroot") {
    return enosys_error(arg_str(args, 0));
  }
  if (util.has_str(["setuid", "setgid", "setgroups"], name)) {
    return enosys_error("");
  }
  if (util.has_str(["proc_waitpid", "proc_waitpid_nohang", "proc_waitpid_status"], name)) {
    return v_int(-10);
  }
  if (util.has_str(["ring_new", "ring_ctl", "ring_wait", "ring_recv", "ring_send_zc", "tcp_ktls"], name)) {
    return host_enosys();
  }
  return call_host_stub(name);
}

function call_host_stub(name: string): Value {
  if (util.has_str(["wasm_poll", "wasm_timer_pollable"], name)) {
    return v_int(-1);
  }
  if (util.has_str(["wasm_block", "wasm_pollable_drop"], name)) {
    return v_int(0);
  }
  if (name == "__account_entry") {
    return v_uint64(0);
  }
  return v_err("not a contract builtin");
}

function call_host_portable(heap: interpheap.Heap, name: string, cap: string, args: Value[]): Value {
  if (cap == "fs") {
    return call_host_fs(heap, name, args);
  }
  if (cap == "now") {
    return call_host_clock(name, args);
  }
  if (cap == "signal") {
    return call_host_signal(name, args);
  }
  if (cap == "stdin" || cap == "stdout") {
    return call_host_stdio(name, args);
  }
  return call_host_process(heap, name, args);
}

function call_host_stdio(name: string, args: Value[]): Value {
  return match (name) {
    "stdin" => reader_value(stdin()),
    "stdout" => writer_value(stdout()),
    "stderr" => writer_value(stderr()),
    _ => v_err("undefined function: " + name),
  };
}

function call_host_process(heap: interpheap.Heap, name: string, vals: Value[]): Value {
  if (name == "args") {
    return string_array_value(heap, args());
  }
  if (name == "set_args") {
    set_args(arg_strs(vals, 0));
    return v_void();
  }
  if (name == "env" || name == "config_get") {
    return option_string_value(env(arg_str(vals, 0)));
  }
  if (name == "environ") {
    return string_array_value(heap, environ());
  }
  if (name == "hostname") {
    return v_string(hostname());
  }
  if (name == "random_bytes") {
    if (arg_i32(vals, 0) < 0) {
      return v_abort(aborts.alloc_size(), "random_bytes length " + util.i32_to_string(arg_i32(vals, 0)));
    }
    return byte_array_value(heap, rand.bytes(arg_i32(vals, 0)));
  }
  if (name == "random_i32") {
    return v_int(rand.next_i32());
  }
  return call_host_core(name, vals);
}

function call_host_core(name: string, args: Value[]): Value {
  if (name == "exit") {
    exit(arg_i32(args, 0));
    return v_void();
  }
  if (name == "isatty") {
    return v_bool(isatty(arg_i32(args, 0)));
  }
  return v_err("undefined function: " + name);
}

function call_host_wait(name: string, args: Value[]): Value {
  if (name == "poll") {
    return v_int(poll(arg_i32s(args, 0), arg_i32(args, 1)));
  }
  if (name == "sleep_ms") {
    sleep_ms(arg_i64(args, 0));
    return v_void();
  }
  if (name == "sleep_ns") {
    sleep_ns(arg_i64(args, 0));
    return v_void();
  }
  return v_err("undefined function: " + name);
}

function call_host_clock(name: string, args: Value[]): Value {
  return match (name) {
    "now_unix_ms" => v_int64(now_unix_ms()),
    "now_ns" => v_int64(now_ns()),
    "monotonic_ns" => v_int64(monotonic_ns()),
    "clock_resolution" => v_int64(clock_resolution()),
    "clock_set" => void_result_value(clock_set(arg_i64(args, 0), arg_i64(args, 1))),
    _ => v_err("undefined function: " + name),
  };
}

function call_host_signal(name: string, args: Value[]): Value {
  let sig = arg_i32(args, 0);
  return match (name) {
    "signal_ignore" => v_int(signal_ignore(sig)),
    "signal_default" => v_int(signal_default(sig)),
    "signal_catch" => v_int(signal_catch(sig)),
    "signal_catch_interrupting" => v_int(signal_catch_interrupting(sig)),
    "signal_disposition" => v_int(signal_disposition(sig)),
    "signal_raise" => v_int(signal_raise(sig)),
    "signal_taken" => v_bool(signal_taken(sig)),
    "signal_mask" => v_int64(signal_mask(sig, arg_i64(args, 1))),
    _ => v_err("undefined function: " + name),
  };
}

function call_host_reactor(name: string, args: Value[]): Value {
  if (name == "reactor_new") {
    return v_int(reactor_new());
  }
  if (name == "reactor_ctl") {
    return v_int(reactor_ctl(arg_i32(args, 0), arg_i32(args, 1), arg_i32(args, 2), arg_i32(args, 3)));
  }
  if (name == "reactor_wait") {
    let events = arg_i32s(args, 1);
    let n = reactor_wait(arg_i32(args, 0), events, arg_i32(args, 2));
    arr_fill(arg_at(args, 1), i32s_as_i64s(events));
    return v_int(n);
  }
  return v_err("undefined function: " + name);
}

function call_host_fs(heap: interpheap.Heap, name: string, args: Value[]): Value {
  if (util.has_str(["remove_file", "remove_dir", "remove_dir_all", "create_dir_all"], name)) {
    return call_host_fs_path(name, arg_str(args, 0));
  }
  if (util.has_str(["create_link", "clone_file", "create_symlink", "rename"], name)) {
    return call_host_fs_paths(name, arg_str(args, 0), arg_str(args, 1));
  }
  if (util.has_str(["open_reader", "open_writer", "open_appender", "open_exclusive", "open_reader_with", "open_writer_with"], name)) {
    return call_host_open(name, args);
  }
  if (util.has_str(["write_file", "write_file_bytes", "create_dir", "truncate", "set_file_times"], name)) {
    return call_host_fs_write(name, args);
  }
  return call_host_fs_read(heap, name, arg_str(args, 0));
}

function call_host_fs_path(name: string, path: string): Value {
  return match (name) {
    "remove_file" => void_result_value(remove_file(path)),
    "remove_dir" => void_result_value(remove_dir(path)),
    "remove_dir_all" => void_result_value(remove_dir_all(path)),
    _ => void_result_value(create_dir_all(path)),
  };
}

function call_host_fs_paths(name: string, from: string, to: string): Value {
  return match (name) {
    "create_link" => void_result_value(create_link(from, to)),
    "clone_file" => void_result_value(clone_file(from, to)),
    "create_symlink" => void_result_value(create_symlink(from, to)),
    _ => void_result_value(rename(from, to)),
  };
}

function call_host_open(name: string, args: Value[]): Value {
  let path = arg_str(args, 0);
  return match (name) {
    "open_reader" => reader_result_value(open_reader(path)),
    "open_reader_with" => reader_result_value(open_reader_with(path, arg_i32(args, 1))),
    "open_writer" => writer_result_value(open_writer(path)),
    "open_writer_with" => writer_result_value(open_writer_with(path, arg_i32(args, 1))),
    "open_appender" => writer_result_value(open_appender(path)),
    _ => writer_result_value(open_exclusive(path)),
  };
}

function call_host_fs_write(name: string, args: Value[]): Value {
  let path = arg_str(args, 0);
  return match (name) {
    "write_file" => void_result_value(write_file(path, arg_str(args, 1))),
    "write_file_bytes" => void_result_value(write_file_bytes(path, arg_bytes(args, 1))),
    "create_dir" => void_result_value(create_dir(path, arg_i32(args, 1))),
    "truncate" => void_result_value(truncate(path, arg_i64(args, 1))),
    _ => void_result_value(set_file_times(path, arg_i64(args, 1), arg_i64(args, 2), arg_i64(args, 3), arg_i64(args, 4), arg_i32(args, 5))),
  };
}

function call_host_fs_read(heap: interpheap.Heap, name: string, path: string): Value {
  return match (name) {
    "read_file" => string_result_value(read_file(path)),
    "read_file_bytes" => bytes_result_value(heap, read_file_bytes(path)),
    "read_link" => string_result_value(read_link(path)),
    "read_link_bytes" => bytes_result_value(heap, read_link_bytes(path)),
    "temp_dir" => string_result_value(temp_dir(path)),
    "stat" => stat_result_value(stat(path)),
    "lstat" => stat_result_value(lstat(path)),
    _ => call_host_fs_list(heap, name, path),
  };
}

function call_host_fs_list(heap: interpheap.Heap, name: string, path: string): Value {
  return match (name) {
    "read_dir_bytes" => byte_arrays_result_value(heap, read_dir_bytes(path)),
    "read_dir" => strings_result_value(heap, read_dir(path)),
    "read_dir_all" => strings_result_value(heap, read_dir_all(path)),
    "read_dir_ino" => dir_entries_result_value(heap, read_dir_ino(path)),
    "read_dir_ino_all" => dir_entries_result_value(heap, read_dir_ino_all(path)),
    _ => v_err("undefined function: " + name),
  };
}

// A guest Socket is a 64-bit word, as in a compiled program: the descriptor
// number, and above it the close count that the number had at that time.
function socket_word(fd: i32): Value {
  if (fd < 0) {
    return v_int64(fd as i64);
  }
  unsafe {
    return v_int64((__task_fd_gen(fd) as u32) as i64 << 32i64 | fd as i64);
  }
}

// The number of a guest Socket, or -1 when the number closed after the word was made.
function guest_socket_number(word: i64): i32 {
  if (word < 0i64) {
    return word as i32;
  }
  let fd = (word & 4294967295i64) as i32;
  unsafe {
    if ((__task_fd_gen(fd) as u32) as i64 != word >> 32i64) {
      return -1;
    }
  }
  return fd;
}

function host_socket(args: Value[], i: i32): Socket {
  unsafe {
    return __socket_from_fd(guest_socket_number(arg_i64(args, i)));
  }
}

function socket_number(s: Socket): Value {
  return socket_word(s.fd);
}

function call_host_net(name: string, args: Value[]): Value {
  if (name == "__socket_from_fd") {
    return socket_word(arg_i32(args, 0));
  }
  // The argument is a number with no handle, so it has no close count.
  if (name == "__fd_close") {
    unsafe {
      return v_int(__fd_close(arg_i32(args, 0)));
    }
  }
  if (util.has_str(["udp_sendto", "udp_sendto_bytes", "udp_sendmmsg"], name)) {
    return call_host_udp_send(name, args);
  }
  if (util.has_str(["udp_bind", "udp_bind_with", "udp_connect", "udp_recvfrom", "udp_recvmmsg"], name)) {
    return call_host_udp(name, args);
  }
  if (util.has_str(["tcp_listen_with", "tcp_connect_with", "tcp_listen"], name)) {
    return call_host_tcp_open(name, args);
  }
  if (util.has_str(["tcp_send_bytes", "tcp_send_buf", "tcp_sendfile", "tcp_recv_into", "tcp_addr_into"], name)) {
    return call_host_tcp_io(name, args);
  }
  return call_host_tcp_fd(name, args);
}

function call_host_udp_send(name: string, args: Value[]): Value {
  if (name == "udp_sendto") {
    return v_int(udp_sendto(host_socket(args, 0), arg_bytes(args, 1), arg_i32(args, 2), arg_str(args, 3)));
  }
  if (name == "udp_sendmmsg") {
    return v_int(udp_sendmmsg_by_sendto(host_socket(args, 0), arg_bytes(args, 1), arg_bytes(args, 2), arg_i32s(args, 3)));
  }
  return v_int(udp_sendto_bytes(host_socket(args, 0), arg_bytes(args, 1), arg_i32(args, 2), arg_bytes(args, 3)));
}

// udp_recvmmsg_by_recvfrom answers udp_recvmmsg with one message, read by
// udp_recvfrom into the first slot of the buffer, because the pinned stage0
// compiler that builds this interpreter does not know the builtin.
function udp_recvmmsg_by_recvfrom(sock: Socket, buf: u8[], froms: u8[], lens: i32[]): (i32, u8[], u8[], i32[]) {
  let n = lens.len() / 3;
  if (n == 0) {
    return (0, buf, froms, lens);
  }
  let stride = buf.len() / n;
  if (stride == 0) {
    return (-22, buf, froms, lens);
  }
  let from = __alloc_u8(19);
  let got = udp_recvfrom(sock, buf, from);
  if (got < 0) {
    return (got, buf, froms, lens);
  }
  if (got > stride) {
    got = stride;
  }
  let out_froms = froms;
  if (froms.len() >= 19) {
    for k in 0..19 {
      out_froms = out_froms.with(k, from[k]);
    }
  }
  return (1, buf, out_froms, lens.with(0, got).with(1, 0).with(2, 0));
}

// udp_sendmmsg_by_sendto answers udp_sendmmsg with one udp_sendto_bytes per
// datagram, a message whose segment size is set as one datagram per segment,
// and no TOS byte. The pinned stage0 compiler builds this interpreter, so it
// cannot call the builtin itself until a stage0 that knows it is published.
function udp_sendmmsg_by_sendto(sock: Socket, addrs: u8[], data: u8[], lens: i32[]): i32 {
  let n = lens.len() / 3;
  let off = 0;
  let sent = 0;
  for m in 0..n {
    let size = lens[3 * m];
    let seg = lens[3 * m + 1];
    if (size < 0 || off + size > data.len()) {
      if (sent > 0) {
        return sent;
      }
      return -22;
    }
    let addr: u8[] = [];
    let port = 0;
    if (addrs.len() >= 19 * (m + 1)) {
      let n_addr = 4;
      if (addrs[19 * m] == 6u8) {
        n_addr = 16;
      }
      addr = __bytes_owned(addrs[19 * m + 1:19 * m + 1 + n_addr]);
      port = addrs[19 * m + 17] as i32 << 8 | addrs[19 * m + 18] as i32;
    }
    let step = size;
    if (seg > 0 && seg < size) {
      step = seg;
    }
    let at = 0;
    let first = true;
    while (first || at < size) {
      first = false;
      let end = at + step;
      if (end > size) {
        end = size;
      }
      let r = udp_sendto_bytes(sock, addr, port, __bytes_owned(data[off + at:off + end]));
      if (r < 0) {
        if (sent > 0) {
          return sent;
        }
        return r;
      }
      at = end;
    }
    off += size;
    sent += 1;
  }
  return sent;
}

function call_host_udp(name: string, args: Value[]): Value {
  if (name == "udp_bind") {
    return socket_number(udp_bind(arg_bytes(args, 0), arg_i32(args, 1)));
  }
  if (name == "udp_bind_with") {
    return socket_number(udp_bind_with(arg_bytes(args, 0), arg_i32(args, 1), arg_bool(args, 2)));
  }
  if (name == "udp_recvfrom") {
    let buf = arg_bytes(args, 1);
    let from = arg_bytes(args, 2);
    let n = udp_recvfrom(host_socket(args, 0), buf, from);
    arr_fill(arg_at(args, 1), bytes_as_i64s(buf));
    arr_fill(arg_at(args, 2), bytes_as_i64s(from));
    return v_int(n);
  }
  if (name == "udp_recvmmsg") {
    let r = udp_recvmmsg_by_recvfrom(host_socket(args, 0), arg_bytes(args, 1), arg_bytes(args, 2), arg_i32s(args, 3));
    arr_fill(arg_at(args, 1), bytes_as_i64s(r.1));
    arr_fill(arg_at(args, 2), bytes_as_i64s(r.2));
    arr_fill(arg_at(args, 3), i32s_as_i64s(r.3));
    return v_int(r.0);
  }
  return v_int(udp_connect(host_socket(args, 0), arg_bytes(args, 1), arg_i32(args, 2)));
}

function call_host_tcp_open(name: string, args: Value[]): Value {
  if (name == "tcp_listen") {
    return socket_number(tcp_listen(arg_i32(args, 0)));
  }
  if (name == "tcp_listen_with") {
    return socket_number(tcp_listen_with(arg_bytes(args, 0), arg_i32(args, 1), arg_i32(args, 2), arg_bool(args, 3)));
  }
  return socket_number(tcp_connect_with(arg_bytes(args, 0), arg_i32(args, 1), arg_bool(args, 2)));
}

function call_host_tcp_io(name: string, args: Value[]): Value {
  let sock = host_socket(args, 0);
  if (name == "tcp_send_bytes") {
    return v_int(tcp_send_bytes(sock, arg_bytes(args, 1)));
  }
  if (name == "tcp_send_buf") {
    return v_int(tcp_send_buf(sock, buf_handle_of(arg_at(args, 1)), arg_i32(args, 2)));
  }
  if (name == "tcp_recv_into") {
    let buf = arg_bytes(args, 1);
    let n = tcp_recv_into(sock, buf);
    arr_fill(arg_at(args, 1), bytes_as_i64s(buf));
    return v_int(n);
  }
  if (name == "tcp_addr_into") {
    let rec = arg_bytes(args, 2);
    let n = tcp_addr_into(sock, arg_bool(args, 1), rec);
    arr_fill(arg_at(args, 2), bytes_as_i64s(rec));
    return v_int(n);
  }
  return v_int(tcp_sendfile(sock, arg_i32(args, 1), arg_i32(args, 2)));
}

// A guest close borrows the number its value shares, so the host close is unchecked.
function call_host_tcp_fd(name: string, args: Value[]): Value {
  let sock = host_socket(args, 0);
  if (name == "tcp_accept") {
    return socket_number(tcp_accept(sock));
  }
  if (name == "tcp_accept_with") {
    let accepted = tcp_accept(sock);
    if (accepted.fd >= 0 && arg_bool(args, 1)) {
      tcp_socket_ctl(accepted, 3, 1);
    }
    return socket_number(accepted);
  }
  if (util.has_str(["tcp_close", "__tcp_close_unchecked"], name)) {
    unsafe {
      return v_int(__tcp_close_unchecked(sock));
    }
  }
  return match (name) {
    "tcp_local_port" => v_int(tcp_local_port(sock)),
    "tcp_pollable" => v_int(tcp_pollable(sock.fd)),
    "tcp_socket_ctl" => v_int(tcp_socket_ctl(sock, arg_i32(args, 1), arg_i32(args, 2))),
    _ => v_err("undefined function: " + name),
  };
}

function call_host_native(heap: interpheap.Heap, name: string, cap: string, args: Value[]): Value {
  if (cap == "tcp") {
    return call_host_net(name, args);
  }
  if (cap == "reactor") {
    return call_host_reactor(name, args);
  }
  if (util.has_str(["poll", "sleep_ms", "sleep_ns"], name)) {
    return call_host_wait(name, args);
  }
  if (cap == "fsmode") {
    return call_host_fsmode(name, args);
  }
  if (cap == "userid") {
    return call_host_userid(heap, name, args);
  }
  if (cap == "tty") {
    return call_host_tty(heap, name, args);
  }
  if (util.has_str(["proc", "rlimit", "sched", "subprocess"], cap)) {
    return call_host_proc(name, args);
  }
  if (util.has_str(["sysinfo", "cwd", "unix", "pollfd", "sysctl"], cap)) {
    return call_host_system(heap, name, args);
  }
  return call_host_fs_native(heap, name, args);
}

function call_host_fsmode(name: string, args: Value[]): Value {
  let path = arg_str(args, 0);
  return match (name) {
    "write_file_exec" => void_result_value(write_file_exec(path, arg_str(args, 1))),
    "access" => void_result_value(access(path, arg_i32(args, 1))),
    "umask" => v_int(umask(arg_i32(args, 0))),
    "chmod" => void_result_value(chmod(path, arg_i32(args, 1))),
    "chmod_at" => void_result_value(chmod_at(path, arg_i32(args, 1), arg_bool(args, 2))),
    _ => v_err("undefined function: " + name),
  };
}

function call_host_userid(heap: interpheap.Heap, name: string, args: Value[]): Value {
  return match (name) {
    "geteuid" => v_uint(geteuid() as i32),
    "getegid" => v_uint(getegid() as i32),
    "getuid" => v_uint(getuid() as i32),
    "getgid" => v_uint(getgid() as i32),
    "getgroups" => i64_array_value(heap, getgroups()),
    _ => v_err("undefined function: " + name),
  };
}

function call_host_tty(heap: interpheap.Heap, name: string, args: Value[]): Value {
  let fd = arg_i32(args, 0);
  return match (name) {
    "window_size" => win_size_result_value(window_size(fd)),
    "set_window_size" => void_result_value(set_window_size(fd, arg_i32(args, 1), arg_i32(args, 2))),
    "termios_get" => i64s_result_value(heap, termios_get(fd)),
    "termios_set" => void_result_value(termios_set(fd, arg_i32(args, 1), arg_i64s(args, 2))),
    _ => void_result_value(set_extproc(fd, arg_bool(args, 1))),
  };
}

function call_host_proc(name: string, args: Value[]): Value {
  if (name == "subprocess") {
    let r = subprocess(arg_str(args, 0), arg_strs(args, 1), arg_str(args, 2));
    return v_struct("ProcessResult", ["stdout", "stderr", "exit_code"], [v_string(r.stdout), v_string(r.stderr), v_int(r.exit_code)]);
  }
  if (name == "pipe") {
    return pipe_result_value(pipe());
  }
  if (name == "process_alive") {
    return v_bool(process_alive(arg_i32(args, 0)));
  }
  if (name == "signal_send") {
    return void_result_value(signal_send(arg_i32(args, 0), arg_i32(args, 1)));
  }
  if (name == "set_process_group") {
    return void_result_value(set_process_group(arg_i32(args, 0), arg_i32(args, 1)));
  }
  return call_host_limits(name, args);
}

function call_host_limits(name: string, args: Value[]): Value {
  return match (name) {
    "rlimit_nofile" => v_int64(rlimit_nofile()),
    "disable_core_dumps" => v_bool(disable_core_dumps()),
    "priority" => v_int(priority()),
    "set_priority" => void_result_value(set_priority(arg_i32(args, 0))),
    _ => v_err("undefined function: " + name),
  };
}

function call_host_system(heap: interpheap.Heap, name: string, args: Value[]): Value {
  return match (name) {
    "uname_field" => v_string(uname_field(arg_i32(args, 0))),
    "cpu_count" => v_int(cpu_count()),
    "prctl_query" => v_int64(prctl_query(arg_i32(args, 0))),
    "getcwd" => string_result_value(getcwd()),
    "chdir" => void_result_value(chdir(arg_str(args, 0))),
    "unix_listen" => socket_number(unix_listen(arg_str(args, 0), arg_i32(args, 1))),
    "unix_connect" => socket_number(unix_connect(arg_str(args, 0))),
    "timer_fd" => v_int(timer_fd(arg_i32(args, 0))),
    "sysctl" => call_host_sysctl(heap, arg_i32s(args, 0)),
    _ => v_err("undefined function: " + name),
  };
}

function call_host_sysctl(heap: interpheap.Heap, mib: i32[]): Value {
  if (target_os() == "darwin") {
    return bytes_result_value(heap, sysctl(mib));
  } else {
    return enosys_error("");
  }
}

function call_host_fs_native(heap: interpheap.Heap, name: string, args: Value[]): Value {
  let path = arg_str(args, 0);
  if (name == "mknod") {
    return void_result_value(mknod(path, arg_i32(args, 1), arg_i32(args, 2), arg_i32(args, 3)));
  }
  if (name == "sync") {
    sync();
    return v_void();
  }
  if (name == "rename_noreplace") {
    return void_result_value(rename_noreplace(path, arg_str(args, 1)));
  }
  if (name == "rename_exchange") {
    return void_result_value(rename_exchange(path, arg_str(args, 1)));
  }
  if (name == "chown_at") {
    return void_result_value(chown_at(path, arg_i32(args, 1), arg_i32(args, 2), arg_bool(args, 3)));
  }
  if (name == "statfs") {
    return fs_stat_result_value(statfs(path));
  }
  if (name == "mounts") {
    return mounts_result_value(heap, mounts());
  }
  if (name == "open_dir") {
    return dir_result_value(open_dir(path));
  }
  return v_err("undefined function: " + name);
}

function is_handle_method(kind: string, name: string): boolean {
  if (util.has_str(["close", "close_unchecked", "stat"], name)) {
    return true;
  }
  if (kind == "Dir") {
    return util.has_str(["open_dir", "open_reader", "open_writer", "open_reader_with", "open_writer_with", "entries", "entries_bytes", "lstat", "access", "remove_file", "remove_dir", "chmod", "chown"], name);
  }
  if (util.has_str(["seek", "flags", "isatty", "fsync", "fdatasync", "syncfs", "drop_cache", "dup_onto"], name)) {
    return true;
  }
  if (kind == "Writer") {
    return util.has_str(["write", "write_some", "write_bytes", "write_some_bytes", "splice_forever", "truncate", "set_nonblocking", "set_times"], name);
  }
  return util.has_str(["read_chunk", "read_chunk_bytes", "splice_to", "copy_range_to", "window_size", "set_window_size", "termios_get", "termios_set", "set_extproc"], name);
}

// The guest program owns each handle. Its checker refuses a use after close,
// so the interpreter closes the shared host handle through a borrow.
function handle_method(heap: interpheap.Heap, h: VHandle, name: string, args: Value[]): Value {
  match (h.r) {
    Some(r) => {
      return reader_method(heap, r, name, args);
    },
    None => {}
  }
  match (h.w) {
    Some(w) => {
      return writer_method(w, name, args);
    },
    None => {}
  }
  match (h.d) {
    Some(d) => {
      return call_dir_method(heap, d, name, args);
    },
    None => {}
  }
  return v_err("empty host handle");
}

function reader_method(heap: interpheap.Heap, r: Reader, name: string, args: Value[]): Value {
  if (name == "read_chunk_bytes") {
    return bytes_result_value(heap, r.read_chunk_bytes(arg_i32(args, 0)));
  }
  if (name == "read_chunk") {
    return read_chunk_value(r, arg_i32(args, 0));
  }
  if (name == "close" || name == "close_unchecked") {
    unsafe {
      return void_result_value(r.close_unchecked());
    }
  }
  if (name == "splice_to" || name == "copy_range_to") {
    return io_err_value(Unsupported);
  }
  if (util.has_str(["window_size", "set_window_size", "termios_get", "termios_set", "set_extproc"], name)) {
    return call_host(heap, name, with_fd_first(r.fd, args));
  }
  return reader_fd_method(r, name, args);
}

function with_fd_first(fd: i32, args: Value[]): Value[] {
  let out: Value[] = [v_int(fd)];
  for a in args {
    out = out.append(a);
  }
  return out;
}

function read_chunk_value(r: Reader, n: i32): Value {
  match (r.read_chunk_bytes(n)) {
    Ok(chunk) => {
      match (utf8.from_bytes(chunk)) {
        Ok(text) => {
          return ok_value(v_string(text));
        },
        Err(_) => {
          return io_err_value(InvalidUtf8(""));
        }
      }
    },
    Err(e) => {
      return io_err_value(e);
    }
  }
}

function reader_fd_method(r: Reader, name: string, args: Value[]): Value {
  return match (name) {
    "stat" => stat_result_value(r.stat()),
    "seek" => i64_result_value(r.seek(arg_i64(args, 0), arg_i32(args, 1))),
    "flags" => i64_result_value(r.flags()),
    "isatty" => v_bool(r.isatty()),
    "fsync" => void_result_value(r.fsync()),
    "fdatasync" => void_result_value(r.fdatasync()),
    "syncfs" => void_result_value(r.syncfs()),
    "drop_cache" => void_result_value(r.drop_cache(arg_i64(args, 0), arg_i64(args, 1))),
    _ => void_result_value(r.dup_onto(arg_i32(args, 0))),
  };
}

function writer_method(w: Writer, name: string, args: Value[]): Value {
  if (name == "write") {
    return void_result_value(w.write(arg_str(args, 0)));
  }
  if (name == "write_some") {
    return i64_result_value(w.write_some(arg_str(args, 0)));
  }
  if (name == "write_bytes") {
    return void_result_value(w.write_bytes(arg_bytes(args, 0)));
  }
  if (name == "write_some_bytes") {
    return i64_result_value(w.write_some_bytes(arg_bytes(args, 0)));
  }
  if (name == "splice_forever") {
    return io_err_value(Unsupported);
  }
  if (name == "close" || name == "close_unchecked") {
    unsafe {
      return void_result_value(w.close_unchecked());
    }
  }
  if (name == "truncate") {
    return void_result_value(w.truncate(arg_i64(args, 0)));
  }
  if (name == "set_nonblocking") {
    return void_result_value(w.set_nonblocking(arg_bool(args, 0)));
  }
  return writer_fd_method(w, name, args);
}

function writer_fd_method(w: Writer, name: string, args: Value[]): Value {
  return match (name) {
    "set_times" => void_result_value(w.set_times(arg_i64(args, 0), arg_i64(args, 1), arg_i64(args, 2), arg_i64(args, 3), arg_i32(args, 4))),
    "stat" => stat_result_value(w.stat()),
    "seek" => i64_result_value(w.seek(arg_i64(args, 0), arg_i32(args, 1))),
    "flags" => i64_result_value(w.flags()),
    "isatty" => v_bool(w.isatty()),
    "fsync" => void_result_value(w.fsync()),
    "fdatasync" => void_result_value(w.fdatasync()),
    "syncfs" => void_result_value(w.syncfs()),
    "drop_cache" => void_result_value(w.drop_cache(arg_i64(args, 0), arg_i64(args, 1))),
    _ => void_result_value(w.dup_onto(arg_i32(args, 0))),
  };
}

function call_dir_method(heap: interpheap.Heap, d: Dir, name: string, args: Value[]): Value {
  if (target_arch() == "wasm32") {
    return v_err("Dir." + name + ": the host this interpreter runs on does not provide `fsdir`");
  } else {
    return dir_method(heap, d, name, args);
  }
}

function dir_method(heap: interpheap.Heap, d: Dir, name: string, args: Value[]): Value {
  let entry = arg_str(args, 0);
  if (name == "open_dir") {
    return dir_result_value(d.open_dir(entry));
  }
  if (name.starts_with("open_")) {
    return dir_file_method(d, name, entry, args);
  }
  if (name == "entries_bytes") {
    return byte_arrays_result_value(heap, d.entries_bytes());
  }
  if (name == "entries") {
    return strings_result_value(heap, d.entries());
  }
  if (name == "stat") {
    return stat_result_value(d.stat(entry));
  }
  if (name == "lstat") {
    return stat_result_value(d.lstat(entry));
  }
  if (name == "close" || name == "close_unchecked") {
    unsafe {
      return void_result_value(d.close_unchecked());
    }
  }
  return dir_change_method(d, name, entry, args);
}

// The stage0 pin does not carry the Dir file opens yet, so the entry is
// reached through the descriptor's /proc link, which the kernel resolves to
// the directory the handle holds open. A symbolic link in the entry's place is
// refused, as the native open refuses it.
function dir_file_method(d: Dir, name: string, entry: string, args: Value[]): Value {
  if (target_os() != "linux") {
    return io_err_value(Unsupported);
  }
  let path = "/proc/self/fd/" + util.i32_to_string(d.fd) + "/" + entry;
  if (name == "open_reader") {
    return dir_reader_value(open_reader_with(path, 512), entry);
  }
  if (name == "open_reader_with") {
    return dir_reader_value(open_reader_with(path, arg_i32(args, 1) | 512), entry);
  }
  if (name == "open_writer_with") {
    return dir_writer_value(open_writer_with(path, arg_i32(args, 1) | 512), entry);
  }
  match (open_writer_with(path, 1 | 512)) {
    Ok(w) => {
      match (w.truncate(0)) {
        Ok(_) => {},
        Err(e) => {
          match (w.close()) {
            Ok(_) => {},
            Err(_) => {}
          }
          return io_err_value(io_error_named(e, entry));
        }
      }
      return ok_value(writer_value(w));
    },
    Err(e) => {
      return io_err_value(io_error_named(e, entry));
    }
  }
}

function dir_reader_value(r: Result[Reader, IoError], entry: string): Value {
  match (r) {
    Ok(h) => {
      return ok_value(reader_value(h));
    },
    Err(e) => {
      return io_err_value(io_error_named(e, entry));
    }
  }
}

function dir_writer_value(r: Result[Writer, IoError], entry: string): Value {
  match (r) {
    Ok(h) => {
      return ok_value(writer_value(h));
    },
    Err(e) => {
      return io_err_value(io_error_named(e, entry));
    }
  }
}

// Names the entry in an error from the /proc path.

function io_error_named(e: IoError, entry: string): IoError {
  match (e) {
    NotFound(_) => {
      return NotFound(entry);
    },
    PermissionDenied(_) => {
      return PermissionDenied(entry);
    },
    AlreadyExists(_) => {
      return AlreadyExists(entry);
    },
    InvalidUtf8(_) => {
      return InvalidUtf8(entry);
    },
    Interrupted => {
      return Interrupted;
    },
    Unsupported => {
      return Unsupported;
    },
    Other(_, m, n) => {
      return Other(entry, m, n);
    }
  }
}

function dir_change_method(d: Dir, name: string, entry: string, args: Value[]): Value {
  return match (name) {
    "access" => void_result_value(d.access(entry, arg_i32(args, 1))),
    "remove_file" => void_result_value(d.remove_file(entry)),
    "remove_dir" => void_result_value(d.remove_dir(entry)),
    "chmod" => void_result_value(d.chmod(entry, arg_i32(args, 1), arg_bool(args, 2))),
    _ => void_result_value(d.chown(entry, arg_i32(args, 1), arg_i32(args, 2), arg_bool(args, 3))),
  };
}

function (own e: Env) update(name: string, v: Value): Env {
  let i = e.names.len() - 1;
  while (i >= 0) {
    if (e.names[i] == name) {
      return Env { ...e, values: e.values.with(i, v) };
    }
    i -= 1;
  }
  return match (e.outer) { Some(parent) => Env { ...e, outer: Some(unsafe { share_unchecked(parent) }.update(name, v)) }, None => e };
}

function sat_exact(op: string, a: i64, b: i64): i64 {
  if (op == "+|") {
    return a + b;
  }
  if (op == "-|") {
    return a - b;
  }
  if (op == "<<|") {
    if (b < 0 || b >= 32) {
      return sat_shl_oor(a);
    }
    return a << b;
  }
  return a * b;
}

function sat_shl_oor(a: i64): i64 {
  let big: i64 = 4611686018427387904;
  if (a > 0) {
    return big;
  }
  if (a < 0) {
    return -big;
  }
  return 0;
}

function sat_clamp(v: i64, minv: i64, maxv: i64): i64 {
  if (v > maxv) {
    return maxv;
  }
  if (v < minv) {
    return minv;
  }
  return v;
}

function sat_i64(op: string, a: i64, b: i64): i64 {
  let maxv: i64 = 9223372036854775807;
  let minv: i64 = -9223372036854775807 - 1;
  if (op == "+|") {
    if (b > 0 && a > maxv - b) {
      return maxv;
    }
    if (b < 0 && a < minv - b) {
      return minv;
    }
    return a + b;
  }
  if (op == "-|") {
    if (b < 0 && a > maxv + b) {
      return maxv;
    }
    if (b > 0 && a < minv + b) {
      return minv;
    }
    return a - b;
  }
  if (op == "<<|") {
    if (b >= 0 && b < 64) {
      let sh = a << b;
      if (sh >> b == a) {
        return sh;
      }
    }
    if (a < 0) {
      return minv;
    }
    if (a == 0) {
      return 0;
    }
    return maxv;
  }
  let prod = a * b;
  if (a != 0) {
    let bad = prod / a != b;
    if (a == -1 && b == minv) {
      bad = true;
    }
    if (bad) {
      let neg = false;
      if (a < 0) {
        neg = !neg;
      }
      if (b < 0) {
        neg = !neg;
      }
      if (neg) {
        return minv;
      }
      return maxv;
    }
  }
  return prod;
}

function sat_u64(op: string, a: u64, b: u64): i64 {
  let one = 1 as u64;
  let maxv = 0 as u64 - one;
  if (op == "+|") {
    let s = a + b;
    if (s < a) {
      return maxv as i64;
    }
    return s as i64;
  }
  if (op == "-|") {
    if (a < b) {
      return 0;
    }
    let d = a - b;
    return d as i64;
  }
  if (op == "<<|") {
    if (b < 64 as u64) {
      let sh = a << b;
      if (sh >> b == a) {
        return sh as i64;
      }
    }
    if (a == 0 as u64) {
      return 0;
    }
    return maxv as i64;
  }
  let prod = a * b;
  if (a != 0 as u64 && prod / a != b) {
    return maxv as i64;
  }
  return prod as i64;
}

function eval_usize_binary(op: string, a: u64, b: u64): Value {
  let sh = b & (ptr_bits() - 1) as u64;
  if (op == "+") {
    return v_usize((a + b) as i64);
  }
  if (op == "-") {
    return v_usize((a - b) as i64);
  }
  if (op == "*") {
    return v_usize((a * b) as i64);
  }
  if (op == "/" || op == "%") {
    return usize_divide(op == "/", a, b);
  }
  if (op == "<<") {
    return v_usize((a << sh) as i64);
  }
  if (op == ">>") {
    return v_usize((a >> sh) as i64);
  }
  return usize_bitwise(op, a, b);
}

function usize_bitwise(op: string, a: u64, b: u64): Value {
  return match (op) {
    "&" => v_usize((a & b) as i64),
    "|" => v_usize((a | b) as i64),
    "^" => v_usize((a ^ b) as i64),
    _ => usize_compare(op, a, b),
  };
}

function usize_divide(quotient: boolean, a: u64, b: u64): Value {
  if (b == 0 as u64) {
    if (quotient) {
      return v_usize(0);
    }
    return v_usize(a as i64);
  }
  if (quotient) {
    return v_usize((a / b) as i64);
  }
  return v_usize((a % b) as i64);
}

function usize_compare(op: string, a: u64, b: u64): Value {
  return match (op) {
    "==" => v_bool(a == b),
    "!=" => v_bool(a != b),
    "<" => v_bool(a < b),
    "<=" => v_bool(a <= b),
    ">" => v_bool(a > b),
    ">=" => v_bool(a >= b),
    _ => v_err("operator `" + op + "` is not defined on usize"),
  };
}

function strings_ordered(op: string, a: string, b: string): boolean {
  return match (op) {
    "<" => a < b,
    "<=" => a <= b,
    ">" => a > b,
    _ => a >= b,
  };
}

function is_checked_op(op: string): boolean {
  return util.has_str(["+?", "-?", "*?", "/?", "%?", "<<?", ">>?"], op);
}

function checked_operand_type(b: ast.ExprBinary, lv: Value): string {
  let ints: string[] = ["u8", "i32", "u32", "i64", "u64"];
  for side in [b.left, b.right] {
    let tag = ast.expr_ty(side);
    if let ast.ExprNumber(n) = side {
      tag = n.suffix;
    }
    if (util.has_str(ints, tag)) {
      return tag;
    }
  }
  return value_type_name(lv);
}

function eval_checked(op: string, lv: Value, rv: Value, ty: string): Value {
  if (!is_int_like(lv) || !is_int_like(rv)) {
    return v_err("checked operator `" + op + "` on a non-integer");
  }
  let signed = ty == "i32" || ty == "i64";
  let width: i64 = 32;
  if (ty == "u8") {
    width = 8;
  } else if (ty == "i64" || ty == "u64") {
    width = 64;
  }
  let a = vint_as_i64(coerce_int_width(lv, ty));
  let b = vint_as_i64(coerce_int_width(rv, ty));
  let none_args: Value[] = [];
  if (op == "<<?" || op == ">>?") {
    if (b < 0 || b >= width) {
      return v_variant("None", none_args);
    }
  }
  let r: Option[i64] = None;
  if (width == 64) {
    r = checked_64(op, a, b, signed);
  } else {
    r = checked_narrow(op, a, b, signed, width);
  }
  if let Some(v) = r {
    return v_variant("Some", [coerce_int_width(v_int64(v), ty)]);
  }
  return v_variant("None", none_args);
}

function checked_narrow(op: string, a: i64, b: i64, signed: boolean, width: i64): Option[i64] {
  let minv: i64 = 0;
  let maxv: i64 = (1 as i64 << width) - 1;
  if (signed) {
    minv = 0 - (1 as i64 << width - 1);
    maxv = (1 as i64 << width - 1) - 1;
  }
  let exact: i64 = 0;
  if (op == "+?") {
    exact = a + b;
  } else if (op == "-?") {
    exact = a - b;
  } else if (op == "*?") {
    exact = a * b;
  } else if (op == "/?" || op == "%?") {
    if (b == 0) {
      return None;
    }
    if (op == "/?") {
      exact = a / b;
    } else {
      exact = a % b;
    }
    if (signed && a == minv && b == -1) {
      return None;
    }
  } else if (op == "<<?") {
    exact = a << b;
  } else {
    exact = a >> b;
  }
  if (exact < minv || exact > maxv) {
    return None;
  }
  return Some(exact);
}

function checked_64(op: string, a: i64, b: i64, signed: boolean): Option[i64] {
  let minv: i64 = -9223372036854775807 - 1;
  if (op == "+?") {
    let r = a + b;
    if (signed && ((a ^ r) & (b ^ r)) < 0 || !signed && r as u64 < a as u64) {
      return None;
    }
    return Some(r);
  }
  if (op == "-?") {
    let r = a - b;
    if (signed && ((a ^ b) & (a ^ r)) < 0 || !signed && a as u64 < b as u64) {
      return None;
    }
    return Some(r);
  }
  if (op == "*?") {
    let r = a * b;
    if (a == 0) {
      return Some(r);
    }
    if (signed && (r / a != b || a == -1 && b == minv)) {
      return None;
    }
    if (!signed && r as u64 / (a as u64) != b as u64) {
      return None;
    }
    return Some(r);
  }
  if (op == "/?" || op == "%?") {
    if (b == 0 || signed && a == minv && b == -1) {
      return None;
    }
    if (!signed) {
      if (op == "/?") {
        return Some((a as u64 / (b as u64)) as i64);
      }
      return Some((a as u64 % (b as u64)) as i64);
    }
    if (op == "/?") {
      return Some(a / b);
    }
    return Some(a % b);
  }
  if (op == "<<?") {
    let r = a << b;
    if (signed && r >> b != a || !signed && (r as u64 >> b as u64) as i64 != a) {
      return None;
    }
    return Some(r);
  }
  if (signed) {
    return Some(a >> b);
  }
  return Some((a as u64 >> b as u64) as i64);
}

function eval_typed_binary(op: string, lv: Value, rv: Value, ty: string): Value {
  if (ty == "u8" && lexer.is_saturating_op(op) && is_int_like(lv) && is_int_like(rv)) {
    return v_int(sat_clamp(sat_exact(op, vint_as_i64(lv), vint_as_i64(rv)), 0, 255) as i32);
  }
  let v = eval_binary(op, lv, rv);
  if (util.has_str(["u8", "i32", "u32", "i64", "u64", "usize"], ty)) {
    return coerce_int_width(v, ty);
  }
  return v;
}

function eval_binary(op: string, lv: Value, rv: Value): Value {
  if let VLanes(a) = lv {
    return lanes_binary(op, a, rv);
  }
  if (is_int_like(lv) && is_int_like(rv) && (is_vusize(lv) || is_vusize(rv))) {
    return eval_usize_binary(op, vint_as_i64(lv) as u64, vint_as_i64(rv) as u64);
  }
  if (is_int_like(lv) && is_int_like(rv) && (is_vint64(lv) || is_vint64(rv))) {
    let a = vint_as_i64(lv);
    let b = vint_as_i64(rv);
    let uns = is_vuint64(lv) || is_vuint64(rv);
    if (op == "+") {
      return v_wide(a + b, uns);
    }
    if (op == "-") {
      return v_wide(a - b, uns);
    }
    if (op == "*") {
      return v_wide(a * b, uns);
    }
    if (op == "&") {
      return v_wide(a & b, uns);
    }
    if (op == "|") {
      return v_wide(a | b, uns);
    }
    if (op == "^") {
      return v_wide(a ^ b, uns);
    }
    if (op == "<<") {
      return v_wide(a << b, uns);
    }
    if (op == "==") {
      return v_bool(a == b);
    }
    if (op == "!=") {
      return v_bool(a != b);
    }
    if (uns) {
      let ua = a as u64;
      let ub = b as u64;
      let uzero = 0 as u64;
      if (lexer.is_saturating_op(op)) {
        return v_uint64(sat_u64(op, ua, ub));
      }
      if (op == "/") {
        if (ub == uzero) {
          return v_uint64(0);
        }
        let uq = ua / ub;
        return v_uint64(uq as i64);
      }
      if (op == "%") {
        if (ub == uzero) {
          return v_uint64(a);
        }
        let ur = ua % ub;
        return v_uint64(ur as i64);
      }
      if (op == ">>") {
        let ush = ua >> ub;
        return v_uint64(ush as i64);
      }
      if (op == "<") {
        return v_bool(ua < ub);
      }
      if (op == "<=") {
        return v_bool(ua <= ub);
      }
      if (op == ">") {
        return v_bool(ua > ub);
      }
      if (op == ">=") {
        return v_bool(ua >= ub);
      }
    }
    if (lexer.is_saturating_op(op)) {
      return v_int64(sat_i64(op, a, b));
    }
    if (op == "/") {
      if (b == 0) {
        return v_int64(0);
      }
      let q64 = a / b;
      return v_int64(q64);
    }
    if (op == "%") {
      if (b == 0) {
        return v_int64(a);
      }
      let r64 = a % b;
      return v_int64(r64);
    }
    if (op == "<") {
      return v_bool(a < b);
    }
    if (op == "<=") {
      return v_bool(a <= b);
    }
    if (op == ">") {
      return v_bool(a > b);
    }
    if (op == ">=") {
      return v_bool(a >= b);
    }
    if (op == ">>") {
      return v_int64(a >> b);
    }
  }
  if (is_int_like(lv) && is_int_like(rv) && (is_vuint(lv) || is_vuint(rv))) {
    let la = vint_bits(lv);
    let rb = vint_bits(rv);
    if (op == "+") {
      return v_uint(la + rb);
    }
    if (op == "-") {
      return v_uint(la - rb);
    }
    if (op == "*") {
      return v_uint(la * rb);
    }
    if (lexer.is_saturating_op(op)) {
      return v_uint(sat_clamp(sat_exact(op, uint_zext(la), uint_zext(rb)), 0, 4294967295) as i32);
    }
    if (op == "&") {
      return v_uint(la & rb);
    }
    if (op == "|") {
      return v_uint(la | rb);
    }
    if (op == "^") {
      return v_uint(la ^ rb);
    }
    if (op == "<<") {
      return v_uint(la << (rb & 31));
    }
    let ua = uint_zext(la);
    let ub = uint_zext(rb);
    if (op == ">>") {
      let sc = (rb & 31) as i64;
      let shifted = ua >> sc;
      return v_uint(shifted as i32);
    }
    if (op == "/") {
      if (ub == 0) {
        return v_uint(0);
      }
      let uq = ua / ub;
      return v_uint(uq as i32);
    }
    if (op == "%") {
      if (ub == 0) {
        return v_uint(la);
      }
      let ur = ua % ub;
      return v_uint(ur as i32);
    }
    if (op == "<") {
      return v_bool(ua < ub);
    }
    if (op == "<=") {
      return v_bool(ua <= ub);
    }
    if (op == ">") {
      return v_bool(ua > ub);
    }
    if (op == ">=") {
      return v_bool(ua >= ub);
    }
    if (op == "==") {
      return v_bool(la == rb);
    }
    if (op == "!=") {
      return v_bool(la != rb);
    }
  }
  if ((is_vfloat32(lv) || is_vfloat32(rv)) && (is_float_like(lv) || is_int_like(lv)) && (is_float_like(rv) || is_int_like(rv))) {
    let fa = vfloat_as_f64(lv);
    if (is_int_like(lv)) {
      fa = vint_as_i64(lv) as f64;
    }
    let fb = vfloat_as_f64(rv);
    if (is_int_like(rv)) {
      fb = vint_as_i64(rv) as f64;
    }
    if (op == "+") {
      return v_float32(fa + fb);
    }
    if (op == "-") {
      return v_float32(fa - fb);
    }
    if (op == "*") {
      return v_float32(fa * fb);
    }
    if (op == "/") {
      return v_float32(fa / fb);
    }
    if (op == "%") {
      return v_err("`%` on f32 is unsupported");
    }
    if (op == "<") {
      return v_bool(fa < fb);
    }
    if (op == "<=") {
      return v_bool(fa <= fb);
    }
    if (op == ">") {
      return v_bool(fa > fb);
    }
    if (op == ">=") {
      return v_bool(fa >= fb);
    }
    if (op == "==") {
      return v_bool(fa == fb);
    }
    if (op == "!=") {
      return v_bool(fa != fb);
    }
  }
  if (lexer.is_saturating_op(op)) {
    match (lv) {
      VInt(li) => {
        match (rv) {
          VInt(ri) => {
            let sv = sat_exact(op, li.v as i64, ri.v as i64);
            return v_int(sat_clamp(sv, -2147483647 - 1, 2147483647) as i32);
          },
          _ => {
            return v_err("saturating rhs not i32");
          }
        }
      },
      _ => {
        return v_err("saturating lhs not i32");
      }
    }
  }
  if (op == "+") {
    match (lv) {
      VInt(li) => {
        match (rv) {
          VInt(ri) => {
            return v_int(li.v + ri.v);
          },
          _ => {
            return v_err("`+` rhs not i32");
          }
        }
      },
      VString(ls) => {
        match (rv) {
          VString(rs) => {
            return v_string(ls.v + rs.v);
          },
          _ => {
            return v_err("`+` rhs not string");
          }
        }
      },
      VFloat(lf) => {
        match (rv) {
          VFloat(rf) => {
            return v_float(lf.v + rf.v);
          },
          _ => {
            return v_err("`+` rhs not f64");
          }
        }
      },
      _ => {
        return v_err("`+` lhs not i32, string, or f64");
      }
    }
  }
  return eval_binary_arith(op, lv, rv);
}

function eval_binary_arith(op: string, lv: Value, rv: Value): Value {
  if (op == "-" || op == "*" || op == "/" || op == "%") {
    match (lv) {
      VInt(li) => {
        match (rv) {
          VInt(ri) => {
            if (op == "-") {
              return v_int(li.v - ri.v);
            }
            if (op == "*") {
              return v_int(li.v * ri.v);
            }
            if (op == "/") {
              if (ri.v == 0) {
                return v_int(0);
              }
              return v_int(li.v / ri.v);
            }
            if (ri.v == 0) {
              return v_int(li.v);
            }
            return v_int(li.v % ri.v);
          },
          _ => {
            return v_err("arithmetic rhs not i32");
          }
        }
      },
      VFloat(lf) => {
        match (rv) {
          VFloat(rf) => {
            return match (op) {
              "-" => v_float(lf.v - rf.v),
              "*" => v_float(lf.v * rf.v),
              "/" => v_float(lf.v / rf.v),
              _ => v_err("`%` on f64 is unsupported"),
            };
          },
          _ => {
            return v_err("arithmetic rhs not f64");
          }
        }
      },
      _ => {
        return v_err("arithmetic lhs not i32 or f64");
      }
    }
  }
  if (op == "<" || op == "<=" || op == ">" || op == ">=") {
    match (lv) {
      VInt(li) => {
        match (rv) {
          VInt(ri) => {
            return match (op) {
              "<" => v_bool(li.v < ri.v),
              "<=" => v_bool(li.v <= ri.v),
              ">" => v_bool(li.v > ri.v),
              _ => v_bool(li.v >= ri.v),
            };
          },
          _ => {
            return v_err("comparison rhs not i32");
          }
        }
      },
      VFloat(lf) => {
        match (rv) {
          VFloat(rf) => {
            return match (op) {
              "<" => v_bool(lf.v < rf.v),
              "<=" => v_bool(lf.v <= rf.v),
              ">" => v_bool(lf.v > rf.v),
              _ => v_bool(lf.v >= rf.v),
            };
          },
          _ => {
            return v_err("comparison rhs not f64");
          }
        }
      },
      VString(ls) => {
        if let VString(rs) = rv {
          return v_bool(strings_ordered(op, ls.v, rs.v));
        }
        return v_err("comparison rhs not a string");
      },
      _ => {
        return v_err("comparison lhs not i32, f64 or string");
      }
    }
  }
  if (op == "==" || op == "!=") {
    let eq = value_eq(lv, rv);
    if (op == "==") {
      return v_bool(eq);
    }
    return v_bool(!eq);
  }
  if (op == "&&" || op == "||") {
    match (lv) {
      VBool(lb) => {
        match (rv) {
          VBool(rb) => {
            if (op == "&&") {
              return v_bool(lb.v && rb.v);
            }
            return v_bool(lb.v || rb.v);
          },
          _ => {
            return v_err("logical rhs not bool");
          }
        }
      },
      _ => {
        return v_err("logical lhs not bool");
      }
    }
  }
  if (op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>") {
    match (lv) {
      VInt(li) => {
        match (rv) {
          VInt(ri) => {
            return match (op) {
              "&" => v_int(li.v & ri.v),
              "|" => v_int(li.v | ri.v),
              "^" => v_int(li.v ^ ri.v),
              "<<" => v_int(li.v << ri.v),
              _ => v_int(li.v >> ri.v),
            };
          },
          _ => {
            return v_err("bitwise rhs not i32");
          }
        }
      },
      _ => {
        return v_err("bitwise lhs not i32");
      }
    }
  }
  return v_err("unknown binary op: " + op);
}

function f64_trunc_u32(v: f64): i32 {
  if (v >= 4294967296.0) {
    return -1;
  }
  if (v >= 0.0) {
    return (v as i64) as i32;
  }
  return 0;
}

function f64_trunc_u64(v: f64): i64 {
  if (v >= 18446744073709551616.0) {
    return (0 as u64 - 1 as u64) as i64;
  }
  if (v >= 9223372036854775808.0) {
    let q = (v - 9223372036854775808.0) as i64;
    return (q as u64 | 1 as u64 << 63 as u64) as i64;
  }
  if (v >= 0.0) {
    return v as i64;
  }
  return 0;
}

// The bits of an integer value, each one flipped.
function bitwise_not(ov: Value): Value {
  match (ov) {
    VInt(i) => {
      if (i.is_byte) {
        return v_byte(i.v ^ 255);
      }
      return v_int(i.v ^ -1);
    },
    VInt64(i) => {
      if (i.ptr) {
        return v_usize(unpack_i64(i) ^ -1i64);
      }
      return v_wide(unpack_i64(i) ^ -1i64, i.unsigned);
    },
    VUint(u) => {
      return v_uint(u.v ^ -1);
    },
    _ => {
      return v_err("unary `~` operand not an integer");
    }
  }
}

function eval_unary(op: string, ov: Value): Value {
  if (op == "-") {
    match (ov) {
      VInt(i) => {
        return v_int(0 - i.v);
      },
      VInt64(i) => {
        if (i.ptr) {
          return v_usize(0 - unpack_i64(i));
        }
        return v_wide(0 - unpack_i64(i), i.unsigned);
      },
      VUint(u) => {
        return v_uint(0 - u.v);
      },
      VFloat(f) => {
        return v_float(-f.v);
      },
      VFloat32(f) => {
        return v_float32(-f.v);
      },
      VLanes(l) => {
        return lanes_map_bits(l, lane_sign(l.width), 0);
      },
      _ => {
        return v_err("unary `-` operand not i32 or f64");
      }
    }
  }
  if (op == "!") {
    match (ov) {
      VBool(b) => {
        return v_bool(!b.v);
      },
      _ => {
        return v_err("unary `!` operand not bool");
      }
    }
  }
  if (op == "~") {
    return bitwise_not(ov);
  }
  if (op == "as_char") {
    return char_value(ov);
  }
  if (op == "as_u8" || op == "as_byte") {
    match (ov) {
      VInt(i) => {
        return v_byte(i.v & 255);
      },
      VInt64(i) => {
        return v_byte((unpack_i64(i) & 255) as i32);
      },
      VUint(u) => {
        return v_byte(u.v & 255);
      },
      VFloat(f) => {
        return v_byte(f64_trunc_u32(f.v) & 255);
      },
      VFloat32(f) => {
        return v_byte(f64_trunc_u32(f.v) & 255);
      },
      _ => {
        return v_err("`as` integer cast operand not numeric");
      }
    }
  }
  if (op == "as_i32") {
    return cast_i32_value(ov);
  }
  if (op == "as_usize") {
    return cast_usize_value(ov);
  }
  if (op == "as_u32") {
    match (ov) {
      VInt(i) => {
        return v_uint(i.v);
      },
      VInt64(i) => {
        return v_uint(i.lo);
      },
      VUint(u) => {
        return ov;
      },
      VFloat(f) => {
        return v_uint(f64_trunc_u32(f.v));
      },
      VFloat32(f) => {
        return v_uint(f64_trunc_u32(f.v));
      },
      _ => {
        return v_err("`as` integer cast operand not numeric");
      }
    }
  }
  if (op == "as_i64" || op == "as_u64") {
    let uns = op == "as_u64";
    match (ov) {
      VInt(i) => {
        return v_wide(i.v as i64, uns);
      },
      VInt64(i) => {
        return v_wide(unpack_i64(i), uns);
      },
      VUint(u) => {
        return v_wide(uint_zext(u.v), uns);
      },
      VFloat(f) => {
        if (uns) {
          return v_wide(f64_trunc_u64(f.v), uns);
        }
        return v_wide(f.v as i64, uns);
      },
      VFloat32(f) => {
        if (uns) {
          return v_wide(f64_trunc_u64(f.v), uns);
        }
        return v_wide(f.v as i64, uns);
      },
      _ => {
        return v_err("`as` integer cast operand not numeric");
      }
    }
  }
  if (op == "as_f64") {
    match (ov) {
      VInt(i) => {
        return v_float(i.v as f64);
      },
      VInt64(i) => {
        return v_float(wide_as_f64(i));
      },
      VUint(u) => {
        return v_float(uint_zext(u.v) as f64);
      },
      VFloat(f) => {
        return v_float(f.v);
      },
      VFloat32(f) => {
        return v_float(f.v);
      },
      _ => {
        return v_err("`as` float cast operand not numeric");
      }
    }
  }
  if (op == "as_f32") {
    match (ov) {
      VInt(i) => {
        return v_float32(i.v as f64);
      },
      VInt64(i) => {
        return v_float32(wide_as_f64(i));
      },
      VUint(u) => {
        return v_float32(uint_zext(u.v) as f64);
      },
      VFloat(f) => {
        return v_float32(f.v);
      },
      VFloat32(f) => {
        return ov;
      },
      _ => {
        return v_err("`as` float cast operand not numeric");
      }
    }
  }
  if (op == "try_") {
    match (ov) {
      VStruct(sv) => {
        if (sv.type_name == "Some" || sv.type_name == "Ok") {
          if (sv.field_values.len() == 0) {
            return v_err("`?` on a payload-less " + sv.type_name);
          }
          return sv.field_values[0];
        }
        if (sv.type_name == "None" || sv.type_name == "Err") {
          return VTry { box: ov };
        }
        return v_err("`?` operand is not an Option or Result: " + sv.type_name);
      },
      _ => {
        return v_err("`?` operand is not an Option or Result");
      }
    }
  }
  let is_as_opt = op.len() > 4 && op.starts_with("as?_");
  if (is_as_opt && util.has_str(["u8", "i32", "u32", "i64", "u64", "usize"], slice_unchecked(op, 4, op.len())) && is_int_like(ov)) {
    let t = eval_unary("as_" + slice_unchecked(op, 4, op.len()), ov);
    if (vint_as_i64(t) == vint_as_i64(ov) && int_is_negative(t) == int_is_negative(ov)) {
      return v_variant("Some", [t]);
    }
    let none: Value[] = [];
    return v_variant("None", none);
  }
  if (is_as_opt) {
    if (dispatch_type_name(ov) == util.base_type_name(slice_unchecked(op, 4, op.len()).to_owned())) {
      return v_variant("Some", [ov]);
    }
    let none: Value[] = [];
    return v_variant("None", none);
  }
  if (op.len() > 3 && op.starts_with("as_")) {
    return ov;
  }
  return v_err("unknown unary op: " + op);
}

function int_is_negative(v: Value): boolean {
  if let VInt64(w) = v {
    if (w.unsigned) {
      return false;
    }
  }
  return vint_as_i64(v) < 0;
}

function cast_usize_value(v: Value): Value {
  if (is_int_like(v)) {
    return v_usize(vint_as_i64(v));
  }
  if (!is_float_like(v)) {
    return v;
  }
  if (ptr_bits() == 32) {
    return v_usize(uint_zext(f64_trunc_u32(vfloat_as_f64(v))));
  }
  return v_usize(f64_trunc_u64(vfloat_as_f64(v)));
}

function cast_i32_value(v: Value): Value {
  match (v) {
    VInt(i) => {
      return v_int(i.v);
    },
    VInt64(i) => {
      return v_int(i.lo);
    },
    VUint(u) => {
      return v_int(u.v);
    },
    VFloat(f) => {
      return v_int(f.v as i32);
    },
    VFloat32(f) => {
      return v_int(f.v as i32);
    },
    _ => {
      return v_err("`as` integer cast operand not numeric");
    }
  }
}

function eval_number_literal(n: ast.ExprNumber): Value {
  if (n.is_float) {
    return coerce_int_width(v_float(f64_from_bits(n.bits)), n.suffix);
  }
  return coerce_int_width(eval_int_literal(n.text), n.suffix);
}

function eval_int_literal(t: string): Value {
  let hs = 0;
  if (t.len() > 0 && t[0] == b'-') {
    hs = 1;
  }
  let is_radix = t.len() > hs + 1 && t[hs] == b'0' && (t[hs + 1] == b'x' || t[hs + 1] == b'X' || t[hs + 1] == b'b' || t[hs + 1] == b'B');
  if (is_radix) {
    return box_i64(util.lit_to_i64(t));
  }
  return box_i64(util.digits_to_i64(t));
}

function resolve_ident_value(name: string, env: Env): Value {
  let idv = env.lookup(name);
  if (is_err(idv)) {
    for ci in env.funcs.named(name) {
      let cfd = env.funcs.decls[ci];
      if (cfd.name == name && cfd.receiver_type.len() == 0 && cfd.params.len() == 0 && cfd.is_const) {
        let no_args: Value[] = [];
        return call_func(env.heap, name, no_args, env.funcs, env.aliases, env.type_decls);
      }
    }
    if (variant_arity(name, env.type_decls) == 0 && !user_func_exists(name, env.funcs)) {
      let none_args: Value[] = [];
      return v_variant_of(variant_owner(name, env.type_decls), name, none_args);
    }
    for vfi in env.funcs.named(name) {
      let vfd = env.funcs.decls[vfi];
      if (vfd.name == name && vfd.receiver_type.len() == 0) {
        let no_names: string[] = [];
        let no_values: Value[] = [];
        let no_types: string[] = [];
        let generic_name = "";
        if (vfd.type_params.len() > 0) {
          generic_name = name;
        }
        return VFunc {
          params: vfd.params,
          ret_type: vfd.ret_type,
          body: vfd.body,
          captured_names: no_names,
          captured_values: no_values,
          captured_types: no_types,
          generic_name: generic_name,
        };
      }
    }
  }
  return idv;
}

@noinline
function eval_binary_expr(b: ast.ExprBinary, env: Env): Value {
  let lv = eval_expr(b.left, env);
  if (is_err(lv)) {
    return lv;
  }
  if (b.op == "&&" || b.op == "||") {
    match (lv) {
      VBool(lb) => {
        if (b.op == "&&" && !lb.v) {
          return v_bool(false);
        }
        if (b.op == "||" && lb.v) {
          return v_bool(true);
        }
      },
      _ => {}
    }
  }
  let rv = eval_expr(float_operand(b.right, b.left, lv), env);
  if (is_err(rv)) {
    return rv;
  }
  if (ast.is_unsettled_int_literal(b.left)) {
    lv = eval_expr(float_operand(b.left, b.right, rv), env);
  }
  let overload = struct_op_method(b.op, lv);
  if (overload.len() > 0) {
    return call_method(env.heap, lv, overload, [rv], env.funcs, env.aliases, env.type_decls);
  }
  if (is_checked_op(b.op)) {
    return eval_checked(b.op, lv, rv, checked_operand_type(b, lv));
  }
  if ((b.op == "==" || b.op == "!=") && has_eq_method(lv, env.funcs, env.aliases)) {
    let e = call_method(env.heap, lv, "eq", [rv], env.funcs, env.aliases, env.type_decls);
    if let VBool(eb) = e {
      if (b.op == "!=") {
        return v_bool(!eb.v);
      }
    }
    return e;
  }
  if ((b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") && orders_by_cmp(lv)) {
    let c = call_method(env.heap, lv, "cmp", [rv], env.funcs, env.aliases, env.type_decls);
    if (is_err(c)) {
      return c;
    }
    return eval_binary(b.op, c, v_int(0));
  }
  return eval_typed_binary(b.op, lv, rv, b.ty);
}

// orders_by_cmp says whether an order on v calls its `cmp` method.
function orders_by_cmp(v: Value): boolean {
  match (v) {
    VStruct(_) => {
      return true;
    },
    VTuple(_) => {
      return true;
    },
    VArr(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

// An integer literal beside a typed float operand is a float of its width, as
// the checker settles it. Beside a float literal it keeps its integer type,
// and the mixed operation is the error the checker reports.
function float_operand(e: ast.Expr, other: ast.Expr, value: Value): ast.Expr {
  if (!ast.is_unsettled_int_literal(e) || ast.float_literal_tree(other)) {
    return e;
  }
  if let VFloat(_) = value {
    return parser.settle_int_tree(e, "f64");
  }
  if let VFloat32(_) = value {
    return parser.settle_int_tree(e, "f32");
  }
  return e;
}

function struct_op_method(op: string, lv: Value): string {
  match (lv) {
    VStruct(_) => {
      return match (op) {
        "+" => "add",
        "-" => "sub",
        "*" => "mul",
        "/" => "div",
        "%" => "rem",
        _ => bit_op_method(op),
      };
    },
    _ => {
      return "";
    }
  }
}

function bit_op_method(op: string): string {
  return match (op) {
    "&" => "bitand",
    "|" => "bitor",
    "^" => "bitxor",
    "<<" => "shl",
    ">>" => "shr",
    _ => "",
  };
}

function eval_expr(e: ast.Expr, env: Env): Value {
  match (e) {
    ast.ExprNumber(n) => {
      return eval_number_literal(n);
    },
    ast.ExprBool(b) => {
      return v_bool(b.value);
    },
    ast.ExprString(s) => {
      return v_string(s.value);
    },
    ast.ExprIdent(id) => {
      return resolve_ident_value(id.name, env);
    },
    ast.ExprBinary(b) => {
      return eval_binary_expr(b, env);
    },
    ast.ExprUnary(u) => {
      let ov = eval_expr(u.operand, env);
      if (is_err(ov)) {
        return ov;
      }
      if (u.op == "-") {
        if let VStruct(_) = ov {
          return call_method(env.heap, ov, "neg", [], env.funcs, env.aliases, env.type_decls);
        }
      }
      // Negate the wide magnitude before conversion to the checked result width.
      return coerce_int_width(eval_unary(u.op, ov), u.ty);
    },
    ast.ExprCall(c) => {
      return eval_expr_call(c, env);
    },
    ast.ExprTuple(t) => {
      let elems: Value[] = [];
      let i = 0;
      while (i < t.elements.len()) {
        let ev = eval_expr(t.elements[i], env);
        if (is_err(ev)) {
          return ev;
        }
        elems = elems.append(ev);
        i += 1;
      }
      return v_tuple_in(env.heap, elems);
    },
    ast.ExprArray(a) => {
      let elems: Value[] = [];
      for i in 0..a.elements.len() {
        let ev = eval_expr(a.elements[i], env);
        if (is_err(ev)) {
          return ev;
        }
        elems = elems.append(ev);
      }
      return v_arr(env.heap, elems);
    },
    ast.ExprBytes(bs) => {
      let elems: Value[] = [];
      for b in bs.value {
        elems = elems.append(v_byte(b as i32));
      }
      return v_arr_of(env.heap, elems, "u8");
    },
    ast.ExprIndex(x) => {
      return eval_expr_index(x, env);
    },
    ast.ExprSlice(sl) => {
      return eval_expr_slice(sl, env);
    },
    ast.ExprStructLit(sl) => {
      return eval_expr_struct_lit(sl, env);
    },
    ast.ExprFieldAccess(fa) => {
      return eval_expr_field_access(fa, env);
    },
    ast.ExprLambda(lm) => {
      let captured = flattened_env(env);
      return VFunc {
        params: lm.params,
        ret_type: lm.ret_type,
        body: lm.body,
        captured_names: captured.names,
        captured_values: captured.values,
        captured_types: captured.types,
        generic_name: "",
      };
    },
    ast.ExprMapLit(_) => {
      return v_err("Map literal: formatter-only node");
    },
    ast.ExprFString(_) => {
      return v_err("f-string: formatter-only node");
    },
    ast.ExprUnknown(u) => {
      if (util.is_f64_range_kind(u.kind)) {
        return v_err("error[P002]: " + util.f64_range_message(u.kind));
      }
      return v_err("parser-side unknown: " + u.kind);
    },
    ast.ExprZero(z) => {
      return zero_value_of(env.heap, z.type_name);
    }
  }
}

function eval_expr_call(c: ast.ExprCall, env: Env): Value {
  return eval_expr_call_expect(c, env, "");
}

function eval_expr_call_expect(c: ast.ExprCall, env: Env, expect: string): Value {
  if let ast.ExprLambda(lm) = c.callee {
    if (c.args.len() == 0 && lm.params.len() == 0 && (lm.origin == parser.ORIGIN_BLOCK || lm.origin == parser.ORIGIN_IF_EXPR || lm.origin == parser.ORIGIN_MATCH_EXPR)) {
      let step = eval_value_body(lm.body, unsafe { share_unchecked(env) }, expect);
      if (step.sig == 0 || step.sig == 1 && is_err(step.ret)) {
        return step.ret;
      }
      return VControl { box: step.ret, sig: step.sig };
    }
  }
  let name = "";
  let is_method = false;
  let is_closure = false;
  let is_variant = false;
  let variant_name = "";
  let variant_enum = "";
  let recv = v_absent();
  let recv_static = "";
  let closure_val = v_absent();
  match (c.callee) {
    ast.ExprIdent(id) => {
      let bound = env.lookup(id.name);
      match (bound) {
        VFunc(_) => {
          is_closure = true;
          closure_val = bound;
        },
        _ => {
          name = id.name;
        }
      }
      if (!is_closure && variant_arity(name, env.type_decls) >= 0 && !user_func_exists(name, env.funcs)) {
        is_variant = true;
        variant_name = name;
        variant_enum = variant_owner(name, env.type_decls);
        if (id.ty.len() > 0) {
          variant_enum = id.ty;
        }
      }
    },
    ast.ExprFieldAccess(fa) => {
      let qualified_handled = false;
      match (fa.obj) {
        ast.ExprIdent(ns_id) => {
          let qname = ns_id.name + "." + fa.field;
          if (user_func_exists(qname, env.funcs)) {
            name = qname;
            qualified_handled = true;
          }
        },
        _ => {}
      }
      if (!qualified_handled) {
        let variant_call = false;
        let static_type = "";
        match (fa.obj) {
          ast.ExprIdent(oid) => {
            let probe = resolve_ident_value(oid.name, env);
            if (is_err(probe)) {
              variant_call = true;
              if (variant_arity(fa.field, env.type_decls) < 0 && assoc_index(env.funcs, oid.name, fa.field) >= 0) {
                variant_call = false;
                static_type = oid.name;
              }
            }
          },
          _ => {}
        }
        if (variant_call) {
          is_variant = true;
          variant_name = fa.field;
          if let ast.ExprIdent(qid) = fa.obj {
            variant_enum = qualified_owner(qid.name, fa.field, env.type_decls);
          }
        } else {
          name = fa.field;
          is_method = true;
          if (static_type.len() > 0) {
            let applied = applied_type_in(expect, static_type);
            if (applied.len() > 0) {
              static_type = applied;
            }
            recv = v_type(static_type);
          } else {
            recv = eval_expr(fa.obj, env);
            if (is_err(recv)) {
              return recv;
            }
            recv_static = bound_type_spelling(env.static_type_of(fa.obj), env);
            name = dyn_method_name(name, recv_static, recv, env.funcs);
          }
        }
      }
    },
    _ => {
      let cv = eval_expr(c.callee, env);
      if (is_err(cv)) {
        return cv;
      }
      match (cv) {
        VFunc(_) => {
          is_closure = true;
          closure_val = cv;
        },
        _ => {
          return v_err("call target is not callable");
        }
      }
    }
  }
  let targs = bound_type_args(c.type_args, env);
  let (callee_fd, callee_known) = call_target(name, is_method, is_closure, recv, env);
  let arg_vals: Value[] = [];
  for i in 0..c.args.len() {
    let av = eval_pinned_arg(c, i, callee_fd, callee_known, is_method && !is_type_value(recv), recv, arg_vals, targs, env);
    if (is_err(av)) {
      return av;
    }
    arg_vals = arg_vals.append(av);
  }
  if (is_variant) {
    return v_variant_in(env.heap, variant_enum, variant_name, arg_vals);
  }
  if (is_method) {
    env.heap.call_at.set((c.line, c.col));
    return call_method_targs(env.heap, recv, recv_static, name, arg_vals, targs, env.funcs, env.aliases, env.type_decls);
  }
  if (targs.len() == 0 && callee_known && !is_closure) {
    targs = static_type_args(callee_fd, c.args, arg_vals, env);
  }
  if (is_closure) {
    let inline_value = false;
    if let ast.ExprLambda(lm) = c.callee {
      if (lm.params.len() == 0 && lm.body.len() >= 3 && parser.is_value_block_origin(lm.origin)) {
        if let ast.StmtVar(v) = lm.body[0] {
          inline_value = parser.is_iflet_value_local(lexical.source_name(v.name));
        }
      }
    }
    env.heap.call_at.set((c.line, c.col));
    return call_closure_mode(env.heap, closure_val, arg_vals, env.funcs, env.aliases, env.type_decls, inline_value);
  }
  if (!callee_known) {
    if let Some(member) = union_member_value(name, arg_vals, env.aliases) {
      return member;
    }
  }
  env.heap.call_at.set((c.line, c.col));
  return call_func_targs(env.heap, name, arg_vals, targs, expect, env.funcs, env.aliases, env.type_decls);
}

function union_member_value(name: string, args: Value[], aliases: parser.TypeAlias[]): Option[Value] {
  if (args.len() != 1) {
    return None;
  }
  if let VStruct(member) = args[0] {
    if (member.type_name == name) {
      for alias in aliases {
        if (util.has_str(alias.variants, name)) {
          return Some(args[0]);
        }
      }
    }
  }
  return None;
}

// static_type_args is the type arguments of a call to fd that writes none,
// where the static type of an argument names more than its value does. A
// struct value does not carry its type arguments: `Ring[16, i32]`, not `Ring`.
// An entry is empty where the value decides.
function static_type_args(fd: parser.FuncDecl, args: ast.Expr[], vals: Value[], env: Env): string[] {
  let n = fd.type_params.len();
  if (fd.all_type_params.len() > n) {
    n = fd.all_type_params.len();
  }
  let out: string[] = [];
  for k in 0..n {
    out = out.append("");
  }
  let found = false;
  for t in 0..fd.type_params.len() {
    let tp = fd.type_params[t];
    let at = util.index_of_str(fd.all_type_params, tp);
    if (at < 0) {
      at = t;
    }
    for j in 0..fd.params.len() {
      if (j >= args.len() || j >= vals.len()) {
        break;
      }
      let vc = tyarg_match(fd.params[j].type_name, tp, vals[j]);
      let sc = tyarg_match_names(fd.params[j].type_name, tp, bound_type_spelling(env.static_type_of(args[j]), env));
      if (vc.len() > 0 && sc.len() > vc.len() && util.base_type_name(sc) == util.base_type_name(vc)) {
        out = out.with(at, sc);
        found = true;
        break;
      }
    }
  }
  if (!found) {
    return [];
  }
  return out;
}

function eval_pinned_arg(c: ast.ExprCall, i: i32, fd: parser.FuncDecl, known: boolean, has_recv: boolean, recv: Value, earlier: Value[], targs: string[], env: Env): Value {
  if (known && i < fd.params.len() && fd.type_params.len() > 0) {
    if let ast.ExprCall(ac) = c.args[i] {
      let pinned = bind_tyargs(env, fd, has_recv, recv, earlier, targs, "");
      let arg_expect = bound_type_spelling(fd.params[i].type_name, pinned);
      if (arg_expect.len() > 0) {
        return eval_expr_call_expect(ac, env, arg_expect);
      }
    }
  }
  return eval_expr(c.args[i], env);
}

function call_target(name: string, is_method: boolean, is_closure: boolean, recv: Value, env: Env): (parser.FuncDecl, boolean) {
  let none = parser.FuncDecl { bound_modules: [], stdlib: "", no_inline: false, always_inline: false, name: "", receiver_name: "", receiver_type: "", receiver_own: false, type_params: [], params: [], ret_own: false, ret_type: "", body: [], line: 0, col: 0, import_iface: "", import_wit: "", import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [], is_unsafe: false };
  if (is_closure) {
    return (none, false);
  }
  let idx: i32 = -1;
  if (is_method) {
    idx = method_target_index(name, recv, env);
  } else {
    idx = free_target_index(name, env);
  }
  if (idx < 0) {
    return (none, false);
  }
  return (env.funcs.decls[idx], true);
}

function method_target_index(name: string, recv: Value, env: Env): i32 {
  if let VType(tv) = recv {
    return assoc_index(env.funcs, tv.name, name);
  }
  let rt = value_type_name(recv);
  for at in env.funcs.named(name) {
    let fd = env.funcs.decls[at];
    if ((fd.name == name || runtime_method_name(fd) == name) && fd.receiver_name.len() > 0 && runtime_receiver_name(fd.receiver_type) == rt) {
      return at;
    }
  }
  return -1;
}

function free_target_index(name: string, env: Env): i32 {
  for at in env.funcs.named(name) {
    let fd = env.funcs.decls[at];
    if (fd.name == name && fd.receiver_name.len() == 0 && fd.receiver_type.len() == 0) {
      return at;
    }
  }
  return -1;
}

function is_type_value(v: Value): boolean {
  if let VType(_) = v {
    return true;
  }
  return false;
}

function bound_type_args(targs: string[], env: Env): string[] {
  let out: string[] = [];
  for ta in targs {
    out = out.append(bound_type_spelling(ta, env));
  }
  return out;
}

function bound_type_spelling(spelling: string, env: Env): string {
  if (spelling.len() == 0) {
    return spelling;
  }
  let ref = parser.parse_type_ref(spelling);
  let base = ref.base;
  match (resolve_ident_value(base, env)) {
    VType(tv) => {
      base = tv.name;
    },
    VInt(iv) => {
      if (ref.args.len() == 0) {
        return util.i32_to_string(iv.v);
      }
    },
    _ => {}
  }
  let args: parser.TypeRef[] = [];
  for a in ref.args {
    args = args.append(parser.parse_type_ref(bound_type_spelling(parser.render_type_ref(a), env)));
  }
  return parser.render_type_ref(parser.TypeRef { ...ref, base: base, args: args });
}

function eval_expr_index(x: ast.ExprIndex, env: Env): Value {
  let av = eval_expr(x.array, env);
  if (is_err(av)) {
    return av;
  }
  let iv = eval_expr(x.index, env);
  if (is_err(iv)) {
    return iv;
  }
  if (!is_int_like(iv)) {
    return v_err("index must be an integer");
  }
  match (av) {
    VArr(arr) => {
      let i = index_in(iv, arr_len(arr));
      if (i < 0) {
        return index_abort(aborts.arr_oob(), value_text(iv), arr_len(arr));
      }
      return arr_at(arr, i);
    },
    VString(s) => {
      let si = index_in(iv, s.v.len());
      if (si < 0) {
        return index_abort(aborts.str_oob(), value_text(iv), s.v.len());
      }
      return v_byte(s.v[si] as i32);
    },
    _ => {
      return v_err("can only index into an array or string");
    }
  }
}

function eval_expr_slice(sl: ast.ExprSlice, env: Env): Value {
  let av = eval_expr(sl.array, env);
  if (is_err(av)) {
    return av;
  }
  let sv = eval_expr(sl.start, env);
  if (is_err(sv)) {
    return sv;
  }
  let sb = 0;
  let eb = 0;
  match (sv) {
    VInt(i) => {
      sb = i.v;
    },
    _ => {
      return v_err("slice start must be i32");
    }
  }
  if (sl.open_end) {
    match (av) {
      VString(oes) => {
        eb = oes.v.len();
      },
      VArr(oea) => {
        eb = arr_len(oea);
      },
      _ => {
        return v_err("can only slice array or string");
      }
    }
  } else {
    let ev = eval_expr(sl.end, env);
    if (is_err(ev)) {
      return ev;
    }
    match (ev) {
      VInt(i) => {
        eb = i.v;
      },
      _ => {
        return v_err("slice end must be i32");
      }
    }
  }
  match (av) {
    VString(s) => {
      if (sb < 0 || eb > s.v.len() || sb > eb) {
        let slcn1: Value[] = [];
        return v_variant("None", slcn1);
      }
      if (!interp_char_boundary(s.v, sb) || !interp_char_boundary(s.v, eb)) {
        let slcn2: Value[] = [];
        return v_variant("None", slcn2);
      }
      return v_variant("Some", [v_string(slice_unchecked(s.v, sb, eb))]);
    },
    VArr(a) => {
      if (sb < 0 || eb > arr_len(a) || sb > eb) {
        return slice_abort(aborts.slice_range(), "slice", sb, eb, arr_len(a));
      }
      return arr_view(a, sb, eb);
    },
    _ => {
      return v_err("can only slice array or string");
    }
  }
}

function eval_expr_struct_lit(sl: ast.ExprStructLit, env: Env): Value {
  if (sl.has_base) {
    let bv = eval_expr(sl.base, env);
    if (is_err(bv)) {
      return bv;
    }
    match (bv) {
      VStruct(sv) => {
        let bnames = sv.field_names;
        let bvals = sv.field_values;
        for oi in 0..sl.field_values.len() {
          let oname = sl.field_names[oi];
          let ov2 = settled_field(sl.type_name, oname, eval_expr(sl.field_values[oi], env), env);
          if (is_err(ov2)) {
            return ov2;
          }
          let replaced = false;
          for bi in 0..bnames.len() {
            if (bnames[bi] == oname) {
              bvals = bvals.with(bi, ov2);
              replaced = true;
            }
          }
          if (!replaced) {
            bnames = bnames.append(oname);
            bvals = bvals.append(ov2);
          }
        }
        return v_struct_at(env.heap, sl.type_name, bnames, bvals, struct_targs(sl.type_name, env));
      },
      _ => {
        return v_err("struct update base is not a struct");
      }
    }
  }
  let fvs: Value[] = [];
  for i in 0..sl.field_values.len() {
    let fv = settled_field(sl.type_name, sl.field_names[i], eval_expr(sl.field_values[i], env), env);
    if (is_err(fv)) {
      return fv;
    }
    fvs = fvs.append(fv);
  }
  return v_struct_at(env.heap, sl.type_name, sl.field_names, fvs, struct_targs(sl.type_name, env));
}

// A field value settles to the declared type of the field, as a let settles
// its initializer: a literal takes the declared width, and a cell the
// declared element type.
function settled_field(type_name: string, field: string, fv: Value, env: Env): Value {
  if (is_err(fv)) {
    return fv;
  }
  let base = util.base_type_name(type_name);
  for sd in env.type_decls {
    if (sd.name == base) {
      for fd in sd.fields {
        if (fd.name == field) {
          return coerce_int_width(fv, fd.type_name);
        }
      }
      return fv;
    }
  }
  return fv;
}

function eval_var_init(v: ast.StmtVar, env: Env): Value {
  if (v.type_name.len() > 0 && !parser.is_destr_marker(v.type_name)) {
    if let ast.ExprCall(c) = v.init {
      return eval_expr_call_expect(c, env, v.type_name);
    }
  }
  return eval_expr(v.init, env);
}

function struct_targs(type_name: string, env: Env): string[] {
  let written = parser.parse_type_ref(type_name);
  let out: string[] = [];
  if (written.args.len() > 0) {
    for a in written.args {
      out = out.append(parser.render_type_ref(a));
    }
    return out;
  }
  for sd in env.type_decls {
    if (sd.name == type_name) {
      for tp in sd.type_params {
        match (resolve_ident_value(tp, env)) {
          VType(tv) => {
            out = out.append(tv.name);
          },
          _ => {
            return [];
          }
        }
      }
      return out;
    }
  }
  return [];
}

function eval_expr_field_access(fa: ast.ExprFieldAccess, env: Env): Value {
  let ov = eval_expr(fa.obj, env);
  if (is_err(ov)) {
    match (fa.obj) {
      ast.ExprIdent(qid) => {
        let no_vals: Value[] = [];
        return v_variant_of(qualified_owner(qid.name, fa.field, env.type_decls), fa.field, no_vals);
      },
      _ => {
        return ov;
      }
    }
  }
  match (ov) {
    VStruct(sv) => {
      for i in 0..sv.field_names.len() {
        if (sv.field_names[i] == fa.field) {
          return sv.field_values[i];
        }
      }
      return v_err("struct " + sv.type_name + " has no field `" + fa.field + "`");
    },
    VTuple(tv) => {
      let idx = util.digits_to_i32(fa.field);
      if (idx < 0 || idx >= tv.elements.len()) {
        return v_err("tuple index `" + fa.field + "` out of range");
      }
      return tv.elements[idx];
    },
    VHandle(hv) => {
      if (fa.field == "fd") {
        return handle_fd(hv);
      }
      return v_err(handle_kind(hv) + " has no field `" + fa.field + "`");
    },
    _ => {
      return socket_field(ov, fa.field);
    }
  }
}

function socket_field(ov: Value, field: string): Value {
  let word = false;
  if let VInt(_) = ov {
    word = true;
  }
  if let VInt64(_) = ov {
    word = true;
  }
  if (word && field == "fd") {
    return v_int(guest_socket_number(vint_as_i64(ov)));
  }
  return v_err("can only field-access a struct or tuple");
}

function is_variant_of_alias_interp(struct_name: string, union_name: string, aliases: parser.TypeAlias[]): boolean {
  for i in 0..aliases.len() {
    if (aliases[i].name == union_name) {
      let j = 0;
      while (j < aliases[i].variants.len()) {
        if (aliases[i].variants[j] == struct_name) {
          return true;
        }
        j += 1;
      }
      return false;
    }
  }
  return false;
}

function is_array_recv_type(t: string): boolean {
  if (t.len() < 3) {
    return false;
  }
  if (t[0] == b'[') {
    return false;
  }
  let n = t.len();
  if (t[n - 2] != b'[' || t[n - 1] != b']') {
    return false;
  }
  if (n >= 5 && t[n - 4] == b'[' && t[n - 3] == b']') {
    return false;
  }
  return true;
}

function name_ends_with(nm: string, suffix: string): boolean {
  if (nm == suffix) {
    return true;
  }
  if (nm.len() <= suffix.len()) {
    return false;
  }
  return nm.ends_with(suffix);
}

function enum_type_params(enums: parser.EnumDecl[], name: string): string[] {
  for ed in enums {
    if (ed.name == name) {
      return ed.type_params;
    }
  }
  let none: string[] = [];
  return none;
}

function aliases_with_enums(aliases: parser.TypeAlias[], types: parser.StructDecl[], enums: parser.EnumDecl[]): parser.TypeAlias[] {
  let out = aliases;
  let base = aliases.len();
  for i in 0..types.len() {
    let owner = types[i].enum_owner;
    if (owner.len() > 0) {
      let k = base;
      while (k < out.len() && out[k].name != owner) {
        k += 1;
      }
      if (k == out.len()) {
        out = out.append(parser.TypeAlias { name: owner, variants: [types[i].name], variant_args: [], variant_lines: [], type_params: enum_type_params(enums, owner), const_params: [], line: 0, col: 0, is_pub: true, is_package: false, module: "" });
      } else {
        out = out.with(k, parser.TypeAlias { ...out[k], variants: out[k].variants.append(types[i].name) });
      }
    }
  }
  return out;
}

// The limit of the Fern calls that are active at one time.
const MAX_CALL_DEPTH: i64 = 1000000;

// The abort of a call at the recursion limit, at its call site, or None.
function too_deep(heap: interpheap.Heap): Option[Value] {
  let depth = heap.depth.get();
  if (depth < MAX_CALL_DEPTH) {
    return None;
  }
  let (line, col) = heap.call_at.get();
  return Some(v_abort(aborts.recursion_limit(), util.i64_to_string(depth) + " calls are active, at line " + util.i32_to_string(line) + " column " + util.i32_to_string(col)));
}

// Runs the body of a call, which is one more active call while it runs.
function call_block(heap: interpheap.Heap, body: ast.Stmt[], own env: Env): StepResult {
  if let Some(abort) = too_deep(heap) {
    return StepResult { env: env, ret: abort, sig: 1 };
  }
  let depth = heap.depth.get();
  heap.depth.set(depth + 1i64);
  let step = eval_block(body, env);
  heap.depth.set(depth);
  return step;
}

function call_closure(heap: interpheap.Heap, cv: Value, args: Value[], funcs: Funcs, aliases: parser.TypeAlias[], type_decls: parser.StructDecl[]): Value {
  return call_closure_mode(heap, cv, args, funcs, aliases, type_decls, false);
}

function call_closure_mode(heap: interpheap.Heap, cv: Value, args: Value[], funcs: Funcs, aliases: parser.TypeAlias[], type_decls: parser.StructDecl[], inline_value: boolean): Value {
  let fv = VFunc { params: [], ret_type: "", body: [], captured_names: [], captured_values: [], captured_types: [], generic_name: "" };
  match (cv) {
    VFunc(v) => {
      fv = v;
    },
    _ => {
      return v_err("call_closure: not a VFunc");
    }
  }
  if (fv.generic_name.len() > 0) {
    return call_func_targs(heap, fv.generic_name, args, [], "", funcs, aliases, type_decls);
  }
  if (args.len() != fv.params.len()) {
    return v_err("arity mismatch calling closure");
  }
  let env = Env { outer: None, depth: 0, names: fv.captured_names, values: fv.captured_values, types: fv.captured_types, funcs: funcs, aliases: aliases, type_decls: type_decls, ret: "", heap: heap };
  for j in 0..fv.params.len() {
    env = env.bind_decl(fv.params[j].name, args[j], fv.params[j].type_name);
  }
  // Each evaluation branch shares the environment with its managed roots.
  if (inline_value) {
    let before_tail: ast.Stmt[] = [];
    for i in 0..fv.body.len() - 1 {
      before_tail = before_tail.append(fv.body[i]);
    }
    let leading = eval_block(before_tail, unsafe { share_unchecked(env) });
    if (leading.sig != 0) {
      if (leading.sig == 1 && is_err(leading.ret)) {
        return leading.ret;
      }
      return VControl { box: leading.ret, sig: leading.sig };
    }
    let tail = eval_stmt(fv.body[fv.body.len() - 1], leading.env);
    return coerce_int_width(tail.ret, fv.ret_type);
  }
  let step = call_block(heap, fv.body, unsafe { share_unchecked(env) });
  if (step.sig != 1) {
    return v_void();
  }
  return coerce_int_width(unwrap_try(step.ret), fv.ret_type);
}

function assoc_index(funcs: Funcs, type_name: string, name: string): i32 {
  let base = util.base_type_name(type_name);
  for at in funcs.named(name) {
    let fd = funcs.decls[at];
    if (fd.name == name && fd.receiver_name.len() == 0 && util.base_type_name(fd.receiver_type) == base) {
      return at;
    }
  }
  return -1;
}

function applied_type_in(t: string, base: string): string {
  if (t.len() == 0) {
    return "";
  }
  return applied_in_ref(parser.parse_type_ref(t), base);
}

function applied_in_ref(r: parser.TypeRef, base: string): string {
  if (r.base == base) {
    return parser.render_type_ref(r);
  }
  for a in r.args {
    let hit = applied_in_ref(a, base);
    if (hit.len() > 0) {
      return hit;
    }
  }
  return "";
}

function decl_type_params(decls: parser.StructDecl[], aliases: parser.TypeAlias[], name: string): string[] {
  for d in decls {
    if (d.name == name) {
      return d.type_params;
    }
  }
  for a in aliases {
    if (a.name == name) {
      return a.type_params;
    }
  }
  let none: string[] = [];
  return none;
}

function call_assoc(heap: interpheap.Heap, type_name: string, name: string, args: Value[], funcs: Funcs, aliases: parser.TypeAlias[], type_decls: parser.StructDecl[]): Value {
  let ai = assoc_index(funcs, type_name, name);
  if (ai < 0) {
    return v_err("undefined associated function `" + name + "` on `" + type_name + "`");
  }
  let fd = funcs.decls[ai];
  if (args.len() != fd.params.len()) {
    return v_err("arity mismatch calling `" + type_name + "." + name + "`");
  }
  let env = Env { ...new_module_env(heap, funcs, aliases, type_decls), ret: fd.ret_type };
  let targs = parser.parse_type_ref(type_name).args;
  let tps = fd.type_params;
  if (tps.len() == 0) {
    tps = decl_type_params(type_decls, aliases, util.base_type_name(type_name));
  }
  let t = 0;
  while (t < tps.len() && t < targs.len()) {
    env = env.bind(tps[t], v_type(parser.render_type_ref(targs[t])));
    t += 1;
  }
  for j in 0..fd.params.len() {
    env = env.bind_decl(fd.params[j].name, args[j], fd.params[j].type_name);
  }
  let step = call_block(heap, fd.body, unsafe { share_unchecked(env) });
  if (step.sig != 1) {
    return v_void();
  }
  return coerce_int_width(unwrap_try(step.ret), fd.ret_type);
}

function tyarg_of_value(v: Value): string {
  match (v) {
    VInt(n) => {
      return int_type_name(n);
    },
    VInt64(w) => {
      return wide_type_name(w);
    },
    VUint(_) => {
      return "u32";
    },
    VBool(_) => {
      return "boolean";
    },
    VString(_) => {
      return "string";
    },
    VFloat(_) => {
      return "f64";
    },
    VFloat32(_) => {
      return "f32";
    },
    VLanes(l) => {
      return typeinfo.lanes_spelling(l.width, l.kind);
    },
    VStruct(sv) => {
      if (sv.targs.len() == 0) {
        return sv.type_name;
      }
      let name = util.base_type_name(sv.type_name) + "[";
      for i in 0..sv.targs.len() {
        if (i > 0) {
          name += ", ";
        }
        name += sv.targs[i];
      }
      return name + "]";
    },
    _ => {
      return "";
    }
  }
}

function tyarg_match_names(decl: string, tp: string, actual: string): string {
  if (decl == tp) {
    return actual;
  }
  if (actual.len() == 0 || util.index_of_sub(decl, "[") < 0) {
    return "";
  }
  let dref = parser.parse_type_ref(decl);
  let aref = parser.parse_type_ref(actual);
  if (dref.base != aref.base || dref.args.len() != aref.args.len()) {
    return "";
  }
  for i in 0..dref.args.len() {
    let r = tyarg_match_names(parser.render_type_ref(dref.args[i]), tp, parser.render_type_ref(aref.args[i]));
    if (r.len() > 0) {
      return r;
    }
  }
  return "";
}

function tyarg_match(decl: string, tp: string, v: Value): string {
  if (decl == tp) {
    return tyarg_of_value(v);
  }
  if (decl == tp + "[]" || decl == "[" + tp + "]") {
    match (v) {
      VArr(a) => {
        if (a.elem.len() > 0) {
          return a.elem;
        }
        if (arr_len(a) > 0) {
          return tyarg_of_value(arr_at(a, 0));
        }
        return "";
      },
      _ => {}
    }
    return "";
  }
  return tyarg_match_names(decl, tp, tyarg_of_value(v));
}

function bind_tyargs(env: Env, fd: parser.FuncDecl, has_recv: boolean, recv: Value, args: Value[], type_args: string[], expect: string): Env {
  let e = env;
  let t = 0;
  while (t < fd.type_params.len()) {
    let tp = fd.type_params[t];
    let concrete = "";
    let at = util.index_of_str(fd.all_type_params, tp);
    if (at < 0) {
      at = t;
    }
    if (at < type_args.len()) {
      concrete = type_args[at];
    }
    if (parser.is_const_arg(concrete)) {
      e = e.bind(tp, v_int(util.digits_to_i32(concrete)));
      t += 1;
      continue;
    }
    if (has_recv && concrete.len() == 0) {
      concrete = tyarg_match(fd.receiver_type, tp, recv);
    }
    let j = 0;
    while (j < fd.params.len() && j < args.len()) {
      if (concrete.len() == 0) {
        concrete = tyarg_match(fd.params[j].type_name, tp, args[j]);
      }
      j += 1;
    }
    if (concrete.len() == 0 && expect.len() > 0) {
      concrete = tyarg_match_names(fd.ret_type, tp, expect);
    }
    if (parser.is_const_arg(concrete)) {
      e = e.bind(tp, v_int(util.digits_to_i32(concrete)));
    } else if (concrete.len() > 0 && !util.has_str(fd.type_params, concrete)) {
      e = e.bind(tp, v_type(concrete));
    }
    t += 1;
  }
  return e;
}

// bind_receiver_consts binds each name of a receiver spelling that the
// receiver's static type fills with a const argument: N in
// `function (r: Ring[N, T]) cap()` called on a `Ring[4, string]`. A struct
// value does not carry its type arguments, so the call site gives the type.
function bind_receiver_consts(env: Env, receiver_type: string, recv_type: string): Env {
  let e = env;
  if (recv_type.len() == 0) {
    return e;
  }
  for a in parser.parse_type_ref(receiver_type).args {
    if (a.args.len() == 0) {
      let concrete = tyarg_match_names(receiver_type, a.base, recv_type);
      if (parser.is_const_arg(concrete)) {
        e = e.bind(a.base, v_int(util.digits_to_i32(concrete)));
      }
    }
  }
  return e;
}

function wide_type_name(w: VInt64): string {
  if (w.ptr) {
    return "usize";
  }
  if (w.unsigned) {
    return "u64";
  }
  return "i64";
}

function value_type_name(v: Value): string {
  match (v) {
    VStruct(sv) => {
      return sv.type_name;
    },
    VString(_) => {
      return "string";
    },
    VInt(n) => {
      return int_type_name(n);
    },
    VInt64(iv64) => {
      return wide_type_name(iv64);
    },
    VUint(_) => {
      return "u32";
    },
    VBool(_) => {
      return "boolean";
    },
    VFloat(_) => {
      return "f64";
    },
    VFloat32(_) => {
      return "f32";
    },
    VLanes(l) => {
      return typeinfo.lanes_spelling(l.width, l.kind);
    },
    VArr(a) => {
      if (a.view) {
        return "ArrayView";
      }
      return "Array";
    },
    VMap(_) => {
      return "Map";
    },
    VHandle(hv) => {
      return handle_kind(hv);
    },
    _ => {
      return "";
    }
  }
}

function runtime_method_name(fd: parser.FuncDecl): string {
  if (fd.name == "__iterator" && runtime_receiver_name(fd.receiver_type) == "Map") {
    return "iter";
  }
  return fd.name;
}

function has_receiver_method(funcs: Funcs, recv_type: string, name: string): boolean {
  for at in funcs.named(name) {
    let fd = funcs.decls[at];
    if ((fd.name == name || runtime_method_name(fd) == name) && fd.receiver_name.len() > 0 && runtime_receiver_name(fd.receiver_type) == recv_type) {
      return true;
    }
  }
  return false;
}

function runtime_receiver_name(spelling: string): string {
  if (parser.spelling_is_view(spelling)) {
    return "ArrayView";
  }
  if (is_array_recv_type(spelling)) {
    return "Array";
  }
  if (spelling == "str") {
    return "string";
  }
  let tuple = parser.tuple_namespace(spelling);
  if (tuple.len() > 0) {
    return tuple;
  }
  return util.base_type_name(spelling);
}

function dyn_method_name(name: string, decl_ty: string, recv: Value, funcs: Funcs): string {
  let traits = parser.dyn_trait_set(decl_ty);
  if (traits.len() == 0) {
    return name;
  }
  return parser.dyn_provider_name(funcs.decls, dispatch_type_name(recv), traits, name);
}

function dispatch_type_name(v: Value): string {
  if let VStruct(sv) = v {
    if (sv.owner.len() > 0) {
      return sv.owner;
    }
  }
  if let VTuple(tv) = v {
    return parser.tuple_arity_namespace(tv.elements.len());
  }
  return value_type_name(v);
}

function map_key_index(heap: interpheap.Heap, m: VMap, k: Value, funcs: Funcs, aliases: parser.TypeAlias[], type_decls: parser.StructDecl[]): i32 {
  let by_eq = has_key_eq(k, funcs, aliases);
  for i in 0..m.keys.len() {
    if (by_eq) {
      if let VBool(b) = call_method(heap, m.keys[i], "eq", [k], funcs, aliases, type_decls) {
        if (b.v) {
          return i;
        }
      }
    } else if (value_eq(m.keys[i], k)) {
      return i;
    }
  }
  return -1;
}

// `==` on a struct or an enum value calls an `eq` method of its type, as
// the compiled code does, whether an impl declares it or the type itself.
function has_eq_method(v: Value, funcs: Funcs, aliases: parser.TypeAlias[]): boolean {
  if let VStruct(sv) = v {
    for at in funcs.named("eq") {
      let fd = funcs.decls[at];
      let base = util.base_type_name(fd.receiver_type);
      if (fd.name == "eq" && (base == sv.type_name || variant_of_enum(v, base, aliases))) {
        return true;
      }
    }
  }
  return false;
}

function has_key_eq(k: Value, funcs: Funcs, aliases: parser.TypeAlias[]): boolean {
  if let VStruct(sv) = k {
    for at in funcs.named("eq") {
      let fd = funcs.decls[at];
      let base = util.base_type_name(fd.receiver_type);
      if (fd.name == "eq" && fd.impl_trait == "Eq" && (base == sv.type_name || variant_of_enum(k, base, aliases))) {
        return true;
      }
    }
  }
  return false;
}

function call_method(heap: interpheap.Heap, recv: Value, name: string, args: Value[], funcs: Funcs, aliases: parser.TypeAlias[], type_decls: parser.StructDecl[]): Value {
  return call_method_targs(heap, recv, "", name, args, [], funcs, aliases, type_decls);
}

// .len, .bytes and .as_bytes on a string; None for any other method.
function string_method(heap: interpheap.Heap, sv: VString, name: string, args: Value[]): Option[Value] {
  if (name == "len") {
    if (args.len() != 0) {
      return Some(v_err("string.len: takes no arguments"));
    }
    return Some(v_int(sv.v.len()));
  }
  if (name == "bytes" || name == "as_bytes") {
    if (args.len() != 0) {
      return Some(v_err("string." + name + ": takes no arguments"));
    }
    let bs: Value[] = [];
    for bi in 0..sv.v.len() {
      bs = bs.append(v_byte(sv.v[bi] as i32));
    }
    if (name == "as_bytes") {
      return Some(v_view_of(heap, bs, "u8"));
    }
    return Some(v_arr_of(heap, bs, "u8"));
  }
  return None;
}

function array_with(heap: interpheap.Heap, own av: VArr, args: Value[]): Value {
  if (args.len() != 2) {
    return v_err("array.with: need 2 args");
  }
  if (!is_i32_arg(args[0])) {
    return v_err("array.with: index must be an integer");
  }
  let wi = vint_bits(args[0]);
  if (wi < 0 || wi >= arr_len(av)) {
    return index_abort(aborts.arr_oob(), util.i32_to_string(wi), arr_len(av));
  }
  let elem = av.elem;
  let reserve = interpheap.get(av.store).words;
  let items = arr_take_els(av);
  return arr_reserved(heap, reserve, items.with(wi, args[1]), elem);
}

function array_truncate(heap: interpheap.Heap, own av: VArr, args: Value[]): Value {
  if (args.len() != 1 || !is_i32_arg(args[0])) {
    return v_err("array.truncate: need an integer length");
  }
  let n = vint_bits(args[0]);
  let elem = av.elem;
  let reserve = interpheap.get(av.store).words;
  let items = arr_take_els(av);
  let keep = n;
  if (keep > items.len()) {
    keep = items.len();
  }
  let kept: Value[] = [];
  for i in 0..keep {
    kept = kept.append(items[i]);
  }
  return arr_reserved(heap, reserve, kept, elem);
}

// A copy of a raw-backed array keeps its reserved slots, as the compiled
// array keeps its capacity, so a later __arr_set_len can reach them.
function arr_reserved(heap: interpheap.Heap, reserve: i64[], items: Value[], elem: string): Value {
  let cap = reserve.len() - 1;
  if (cap <= items.len()) {
    return v_arr_of(heap, items, elem);
  }
  let words: i64[] = [items.len() as i64];
  for x in items {
    if (!is_int_like(x)) {
      return v_arr_of(heap, items, elem);
    }
    words = words.append(vint_as_i64(x));
  }
  for i in items.len()..cap {
    words = words.append(reserve[1 + i]);
  }
  return VArr { items: items, elem: elem, view: false, store: interpheap.allocate(heap, "", words, []), offset: 0 };
}

// .len, .with, .truncate, .append and a reserved .concat on an array; None for
// any other method.
function array_method(heap: interpheap.Heap, own av: VArr, name: string, args: Value[]): Option[Value] {
  if (name == "len") {
    if (args.len() != 0) {
      return Some(v_err("array.len: takes no arguments"));
    }
    return Some(v_int(arr_len(av)));
  }
  if (av.view) {
    return None;
  }
  if (name == "with") {
    return Some(array_with(heap, av, args));
  }
  if (name == "truncate") {
    return Some(array_truncate(heap, av, args));
  }
  if (name == "append") {
    if (args.len() != 1) {
      return Some(v_err("array.append: need 1 arg"));
    }
    let elem = av.elem;
    let reserve = interpheap.get(av.store).words;
    let items = arr_take_els(av);
    return Some(arr_reserved(heap, reserve, items.append(args[0]), elem));
  }
  if (name == "concat") {
    return reserved_concat(heap, av, args);
  }
  return None;
}

// The compiled concat method extends its receiver in place, so a raw-backed
// receiver keeps its reserved slots. Any other receiver takes the declared
// method.
function reserved_concat(heap: interpheap.Heap, av: VArr, args: Value[]): Option[Value] {
  let reserve = interpheap.get(av.store).words;
  if (reserve.len() == 0 || args.len() != 1) {
    return None;
  }
  if let VArr(b) = args[0] {
    return Some(arr_reserved(heap, reserve, util.append_all(arr_els(av), arr_els(b)), av.elem));
  }
  return None;
}

function call_method_targs(heap: interpheap.Heap, recv: Value, recv_static: string, name: string, args: Value[], type_args: string[], funcs: Funcs, aliases: parser.TypeAlias[], type_decls: parser.StructDecl[]): Value {
  match (recv) {
    VType(tv) => {
      return call_assoc(heap, tv.name, name, args, funcs, aliases, type_decls);
    },
    VCell(uc) => {
      return cell_method(uc, name, args);
    },
    VHandle(hv) => {
      if (is_handle_method(handle_kind(hv), name)) {
        return handle_method(heap, hv, name, args);
      }
    },
    _ => {}
  }
  match (recv) {
    VString(sv) => {
      if let Some(r) = string_method(heap, sv, name, args) {
        return r;
      }
    },
    VArr(av) => {
      let found = array_method(heap, unsafe { share_unchecked(av) }, name, args);
      if let Some(r) = found {
        return r;
      }
    },
    VMap(m) => {
      if (name == "insert") {
        if (args.len() != 2) {
          return v_err("map.set: need 2 args");
        }
        let i = map_key_index(heap, m, args[0], funcs, aliases, type_decls);
        if (i >= 0) {
          let nvs: Value[] = [];
          for j in 0..m.values.len() {
            if (j == i) {
              nvs = nvs.append(args[1]);
            } else {
              nvs = nvs.append(m.values[j]);
            }
          }
          return v_map_in(heap, m.keys, nvs);
        }
        return v_map_in(heap, m.keys.append(args[0]), m.values.append(args[1]));
      }
      if (name == "get") {
        if (args.len() != 1) {
          return v_err("map.get: need 1 arg");
        }
        let oi = map_key_index(heap, m, args[0], funcs, aliases, type_decls);
        if (oi >= 0) {
          return v_variant("Some", [m.values[oi]]);
        }
        let no_payload: Value[] = [];
        return v_variant("None", no_payload);
      }
      if (name == "get_or") {
        if (args.len() != 2) {
          return v_err("map.get_or: need 2 args");
        }
        let gi = map_key_index(heap, m, args[0], funcs, aliases, type_decls);
        if (gi >= 0) {
          return m.values[gi];
        }
        return args[1];
      }
      if (name == "contains") {
        if (args.len() != 1) {
          return v_err("map.contains: need 1 arg");
        }
        return v_bool(map_key_index(heap, m, args[0], funcs, aliases, type_decls) >= 0);
      }
      if (name == "remove") {
        if (args.len() != 1) {
          return v_err("map.remove: need 1 arg");
        }
        let at = map_key_index(heap, m, args[0], funcs, aliases, type_decls);
        let last = m.keys.len() - 1;
        let nk: Value[] = [];
        let nv: Value[] = [];
        for di in 0..m.keys.len() {
          if (di == at && at != last) {
            nk = nk.append(m.keys[last]);
            nv = nv.append(m.values[last]);
          } else if (at < 0 || di != last) {
            nk = nk.append(m.keys[di]);
            nv = nv.append(m.values[di]);
          }
        }
        return v_map_in(heap, nk, nv);
      }
      if (name == "len") {
        return v_int(m.keys.len());
      }
      if (name == "keys") {
        return v_arr(heap, m.keys);
      }
      if (name == "values") {
        return v_arr(heap, m.values);
      }
      if (name == "cleared") {
        return v_map_new();
      }
    },
    _ => {}
  }
  match (recv) {
    VTuple(tv) => {
      let ti = util.digits_to_i32(name);
      if (ti >= 0 && ti < tv.elements.len()) {
        match (tv.elements[ti]) {
          VFunc(_) => {
            return call_closure(heap, tv.elements[ti], args, funcs, aliases, type_decls);
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  return call_declared_method(heap, recv, recv_static, name, args, type_args, funcs, aliases, type_decls);
}

function call_declared_method(heap: interpheap.Heap, recv: Value, recv_static: string, name: string, args: Value[], type_args: string[], funcs: Funcs, aliases: parser.TypeAlias[], type_decls: parser.StructDecl[]): Value {
  let recv_type = dispatch_type_name(recv);
  if (recv_type.len() == 0) {
    return v_err("method `" + name + "`: receiver has no type name to dispatch on");
  }
  let own_method = has_receiver_method(funcs, recv_type, name);
  for at in funcs.named(name) {
    let fd = funcs.decls[at];
    let receiver_base = runtime_receiver_name(fd.receiver_type);
    let rt_match = receiver_base == recv_type;
    if (!rt_match && !own_method && variant_of_enum(recv, receiver_base, aliases)) {
      rt_match = true;
    }
    if (!rt_match && recv_type == "Array" && is_array_recv_type(fd.receiver_type)) {
      rt_match = true;
    }
    if ((fd.name == name || runtime_method_name(fd) == name) && fd.receiver_name.len() > 0 && rt_match) {
      if (args.len() != fd.params.len()) {
        return v_err("arity mismatch calling method `" + name + "`");
      }
      let env = Env { ...new_module_env(heap, funcs, aliases, type_decls), ret: fd.ret_type };
      env = bind_tyargs(env, fd, true, recv, args, type_args, "");
      env = bind_receiver_consts(env, fd.receiver_type, recv_static);
      env = env.bind(fd.receiver_name, recv);
      for j in 0..fd.params.len() {
        env = env.bind_decl(fd.params[j].name, args[j], fd.params[j].type_name);
      }
      let step = call_block(heap, fd.body, unsafe { share_unchecked(env) });
      if (step.sig != 1) {
        return v_void();
      }
      return coerce_int_width(unwrap_try(step.ret), fd.ret_type);
    }
  }
  if (name == "to_string" && args.len() == 0) {
    match (recv) {
      VInt(_) => {
        return v_string(value_text(recv));
      },
      VInt64(_) => {
        return v_string(value_text(recv));
      },
      VUint(_) => {
        return v_string(value_text(recv));
      },
      VBool(_) => {
        return v_string(value_text(recv));
      },
      VString(t) => {
        return v_string(t.v);
      },
      VFloat(f) => {
        return v_string(f.v.to_string());
      },
      VFloat32(f) => {
        return v_string((f.v as f32).to_string());
      },
      _ => {}
    }
  }
  match (recv) {
    VStruct(sv2) => {
      for fi in 0..sv2.field_names.len() {
        if (sv2.field_names[fi] == name) {
          match (sv2.field_values[fi]) {
            VFunc(_) => {
              return call_closure(heap, sv2.field_values[fi], args, funcs, aliases, type_decls);
            },
            _ => {}
          }
        }
      }
    },
    VBool(bv) => {
      if (name == "to_string" && args.len() == 0) {
        if (bv.v) {
          return v_string("true");
        }
        return v_string("false");
      }
    },
    _ => {}
  }
  return v_err("undefined method `" + name + "` on `" + recv_type + "`");
}

function is_buf_builtin(name: string): boolean {
  return util.has_str(
    [
      "buf_new", "buf_push", "buf_push_range", "buf_push_bytes_range", "buf_push_base64", "buf_push_base32", "buf_decode_base32",
      "buf_push_byte", "buf_push_u64", "buf_push_decimal", "buf_push_bytes_mapped", "buf_push_bytes_filtered",
      "buf_push_bytes_expanded", "buf_push_mapped", "buf_push_filtered", "buf_push_expanded",
      "buf_len", "buf_take", "buf_take_bytes", "buf_clear", "buf_free",
    ],
    name,
  );
}

function v_buf_handle(h: usize): Value {
  return v_usize(h as i64);
}

function buf_handle_of(v: Value): usize {
  return vint_as_i64(v) as usize;
}

function int_arg_i32(v: Value): i32 {
  return vint_as_i64(v) as i32;
}

function call_buf_new(args: Value[]): Value {
  if (args.len() != 1 || !is_int_like(args[0])) {
    return v_err("buf_new: expected 1 arg (cap)");
  }
  let reserve = int_arg_i32(args[0]);
  if (reserve < 0) {
    reserve = 0;
  }
  return v_buf_handle(buf_new(reserve));
}

function call_count_byte_bytes(args: Value[]): Value {
  if (args.len() != 2) {
    return v_err("__count_byte_bytes: expected 2 args (bytes, byte)");
  }
  if (!is_i32_arg(args[1])) {
    return v_err("__count_byte_bytes: byte must be an integer");
  }
  if let VArr(a) = args[0] {
    let byte = vint_bits(args[1]);
    let at = 0;
    let count = 0;
    if (byte < 0 || byte > 255) {
      return v_int(0);
    }
    while (at < arr_len(a)) {
      if (vint_bits(arr_at(a, at)) == byte) {
        count += 1;
      }
      at += 1;
    }
    return v_int(count);
  }
  return v_err("__count_byte_bytes: first arg must be a byte array");
}

function call_count_below_u64(args: Value[]): Value {
  if (args.len() != 2 || !is_int_like(args[1])) {
    return v_err("__count_below_u64: expected 2 args (words, word)");
  }
  if let VArr(a) = args[0] {
    let w = vint_as_i64(args[1]) as u64;
    let count = 0;
    for at in 0..arr_len(a) {
      if (vint_as_i64(arr_at(a, at)) as u64 < w) {
        count += 1;
      }
    }
    return v_int(count);
  }
  return v_err("__count_below_u64: first arg must be a u64 array");
}

function byte_args(args: Value[]): u8[][] {
  let out: u8[][] = [];
  for a in args {
    if let VArr(av) = a {
      let b = __alloc_u8(arr_len(av));
      let i = 0;
      while (i < arr_len(av)) {
        let e = arr_at(av, i);
        if (!is_i32_arg(e) || vint_bits(e) < 0 || vint_bits(e) > 255) {
          return out;
        }
        b = b.with(i, vint_bits(e) as u8);
        i += 1;
      }
      out = out.append(b);
    } else {
      return out;
    }
  }
  return out;
}

function byte_value(heap: interpheap.Heap, b: u8[]): Value {
  let out: Value[] = [];
  for x in b {
    out = out.append(v_int(x as i32));
  }
  return v_arr(heap, out);
}

// A builtin that writes into its destination returns the destination, so a
// raw-backed one keeps its reserved slots.
function written_bytes(heap: interpheap.Heap, dest: Value, b: u8[]): Value {
  if let VArr(a) = dest {
    let out: Value[] = [];
    for x in b {
      out = out.append(v_int(x as i32));
    }
    return arr_reserved(heap, interpheap.get(a.store).words, out, a.elem);
  }
  return byte_value(heap, b);
}

function call_bytes_into(heap: interpheap.Heap, args: Value[]): Value {
  if (args.len() != 5) {
    return v_err("__bytes_into: expected 5 arguments");
  }
  let bs = byte_args([args[0], args[2]]);
  let at = vint_as_i64(args[1]) as i32;
  let from = vint_as_i64(args[3]) as i32;
  let n = vint_as_i64(args[4]) as i32;
  if (bs.len() != 2 || n < 0 || at < 0 || from < 0 || at > bs[0].len() - n || from > bs[1].len() - n) {
    return v_err("__bytes_into: range out of bounds");
  }
  let out = bs[0];
  for i in 0..n {
    out = out.with(at + i, bs[1][from + i]);
  }
  return written_bytes(heap, args[0], out);
}

function call_bytes_range(heap: interpheap.Heap, args: Value[]): Value {
  if (args.len() != 3) {
    return v_err("__bytes_range: expected 3 arguments");
  }
  let bs = byte_args([args[0]]);
  let from = vint_as_i64(args[1]) as i32;
  let to = vint_as_i64(args[2]) as i32;
  if (bs.len() != 1 || from < 0 || to < from || to > bs[0].len()) {
    return v_err("__bytes_range: range out of bounds");
  }
  let out: u8[] = [];
  for i in from..to {
    out = out.append(bs[0][i]);
  }
  return byte_value(heap, out);
}

function aes_gcm_arity(name: string): i32 {
  if (name == "__aes_expand_key") {
    return 1;
  }
  if (name == "__aes_ctr32" || name == "__ghash") {
    return 3;
  }
  return 0;
}

function sub_bytes(b: u8[], from: i32, n: i32): u8[] {
  let out = __alloc_u8(n);
  for i in 0..n {
    out = out.with(i, b[from + i]);
  }
  return out;
}

// The in-place pair over a copy of the buffer argument, as the compiled kernels leave it.
// The key schedule, the hash key and the nonce have their sizes, and the
// additional data and the sealed range with its tag are inside the buffer.
function gcm_into_fits(bs: u8[][], aad_at: i64, aad_n: i64, at: i64, n: i64): boolean {
  let size = bs[3].len() as i64;
  return bs[0].len() >= 176 && bs[1].len() >= 16 && bs[2].len() == 12 && aad_at >= 0 && aad_n >= 0 && at >= 0 && n >= 0 && at + n + 16 <= size && aad_at + aad_n <= size;
}

function call_aes_gcm_into(heap: interpheap.Heap, name: string, args: Value[]): Value {
  if (args.len() != 9) {
    return v_err(name + ": expected rk, h, iv, seq, buf, aad_at, aad_n, at and n");
  }
  let bs = byte_args([args[0], args[1], args[2], args[4]]);
  if (bs.len() != 4) {
    return v_err(name + ": expected byte arrays");
  }
  let seq = vint_as_i64(args[3]);
  let aad_at = vint_as_i64(args[5]);
  let aad_n = vint_as_i64(args[6]);
  let at = vint_as_i64(args[7]);
  let n = vint_as_i64(args[8]);
  let buf = bs[3];
  if (!gcm_into_fits(bs, aad_at, aad_n, at, n)) {
    return v_err(name + ": range out of bounds");
  }
  let nonce = bs[2];
  for k in 0..8 {
    nonce = nonce.with(4 + k, nonce[4 + k] ^ (seq >> (8 * (7 - k)) as i64 & 255) as u8);
  }
  let seal = name == "__aes_gcm_seal_into";
  let d = at as i32;
  let m = n as i32;
  let out = aesref.gcm(bs[0], bs[1], nonce, sub_bytes(buf, aad_at as i32, aad_n as i32), sub_bytes(buf, d, m), seal);
  let diff: u8 = 0;
  for i in 0..16 {
    diff = diff | out[m + i] ^ buf[d + m + i];
  }
  for i in 0..m {
    buf = buf.with(d + i, out[i]);
  }
  if (seal) {
    for i in 0..16 {
      buf = buf.with(d + m + i, out[m + i]);
    }
  } else if (diff == 0) {
    buf = buf.with(d + m, 0 as u8);
  } else {
    buf = buf.with(d + m, 1 as u8);
  }
  return written_bytes(heap, args[4], buf);
}

function le32_at(b: u8[], at: i32): u32 {
  return b[at] as u32 | b[at + 1] as u32 << 8 | b[at + 2] as u32 << 16 | b[at + 3] as u32 << 24;
}

function rotl32(v: u32, n: u32): u32 {
  return v << n | v >> 32 - n;
}

// The quarter rounds of a ChaCha20 double round: the four columns, then the four diagonals.
const CHACHA_QR: i32[] = [0, 4, 8, 12, 1, 5, 9, 13, 2, 6, 10, 14, 3, 7, 11, 15, 0, 5, 10, 15, 1, 6, 11, 12, 2, 7, 8, 13, 3, 4, 9, 14];

function chacha_qr(own x: u32[], q: i32): u32[] {
  let a = CHACHA_QR[4 * q];
  let b = CHACHA_QR[4 * q + 1];
  let c = CHACHA_QR[4 * q + 2];
  let d = CHACHA_QR[4 * q + 3];
  x = x.with(a, x[a] + x[b]);
  x = x.with(d, rotl32(x[d] ^ x[a], 16));
  x = x.with(c, x[c] + x[d]);
  x = x.with(b, rotl32(x[b] ^ x[c], 12));
  x = x.with(a, x[a] + x[b]);
  x = x.with(d, rotl32(x[d] ^ x[a], 8));
  x = x.with(c, x[c] + x[d]);
  return x.with(b, rotl32(x[b] ^ x[c], 7));
}

function chacha_block(st: u32[]): u32[] {
  let x = st;
  for r in 0..80 {
    x = chacha_qr(x, r % 8);
  }
  for k in 0..16 {
    x = x.with(k, x[k] + st[k]);
  }
  return x;
}

// RFC 8439's ChaCha20 over buf[at:at + n]. The first word of ctr is the block counter, and the nonce follows it.
function chacha20_xor(key: u8[], ctr: u8[], text: u8[], at: i32, n: i32): u8[] {
  let buf = text;
  let st: u32[] = [0x61707865, 0x3320646e, 0x79622d32, 0x6b206574];
  for k in 0..8 {
    st = st.append(le32_at(key, 4 * k));
  }
  for k in 0..4 {
    st = st.append(le32_at(ctr, 4 * k));
  }
  let ks: u32[] = [];
  for i in 0..n {
    if (i % 64 == 0) {
      ks = chacha_block(st);
      st = st.with(12, st[12] + 1);
    }
    let w = ks[i % 64 >> 2] >> ((i & 3) * 8) as u32;
    buf = buf.with(at + i, buf[at + i] ^ (w & 255) as u8);
  }
  return buf;
}

function call_chacha20_xor_into(heap: interpheap.Heap, args: Value[]): Value {
  if (args.len() != 5) {
    return v_err("__chacha20_xor_into: expected key, ctr, buf, at and n");
  }
  let bs = byte_args([args[0], args[1], args[2]]);
  let at = vint_as_i64(args[3]);
  let n = vint_as_i64(args[4]);
  if (bs.len() != 3 || bs[0].len() != 32 || bs[1].len() != 16 || at < 0 || n < 0 || at + n > bs[2].len() as i64) {
    return v_err("__chacha20_xor_into: range out of bounds");
  }
  return written_bytes(heap, args[2], chacha20_xor(bs[0], bs[1], bs[2], at as i32, n as i32));
}

function le64_at(b: u8[], at: i32): u64 {
  return le32_at(b, at) as u64 | le32_at(b, at + 4) as u64 << 32;
}

function put_le64_at(own b: u8[], at: i32, v: u64): u8[] {
  for i in 0..8 {
    b = b.with(at + i, (v >> (8 * i) as u64 & 255) as u8);
  }
  return b;
}

// The sum a + b + c with c 0 or 1, and its carry.
function add_carry(a: u64, b: u64, c: u64): (u64, u64) {
  let s = a + b;
  let t = s + c;
  let k: u64 = if (s < a || t < s) { 1 } else { 0 };
  return (t, k);
}

// __mont_mul: one Montgomery product of a and b by coarsely integrated operand scanning (CIOS). m[0] is
// n0 = -p^-1 mod 2^64 and m[1:] the n limbs of p, little-endian. The result is the CIOS sum a b R^-1 mod p in
// n limbs, less p when that is not negative.
function mont_mul_limbs(a: u64[], b: u64[], m: u64[]): u64[] {
  let n = m.len() - 1;
  let n0 = m[0];
  let t: u64[] = [];
  for k in 0..n {
    t = t.append(0 as u64);
  }
  let top: u64 = 0;
  for i in 0..n {
    let (s, c0) = add_carry(t[0], a[i] * b[0], 0);
    let c1 = __mulhi_u64(a[i], b[0]) + c0;
    let q = s * n0;
    let (_, d0) = add_carry(s, q * m[1], 0);
    let c2 = __mulhi_u64(q, m[1]) + d0;
    for j in 1..n {
      let (u0, e0) = add_carry(t[j], a[i] * b[j], 0);
      let (u, e1) = add_carry(u0, c1, 0);
      c1 = __mulhi_u64(a[i], b[j]) + e0 + e1;
      let (v0, f0) = add_carry(u, q * m[j + 1], 0);
      let (v, f1) = add_carry(v0, c2, 0);
      c2 = __mulhi_u64(q, m[j + 1]) + f0 + f1;
      t = t.with(j - 1, v);
    }
    let (u0, e0) = add_carry(top, c1, 0);
    let (u, e1) = add_carry(u0, c2, 0);
    t = t.with(n - 1, u);
    top = e0 + e1;
  }
  let borrow: u64 = 0;
  for j in 0..n {
    let (_, bo) = sub_borrow(t[j], m[j + 1], borrow);
    borrow = bo;
  }
  let mask = 0 as u64 - (borrow ^ 1 | top);
  borrow = 0;
  for j in 0..n {
    let (d, bo) = sub_borrow(t[j], m[j + 1] & mask, borrow);
    t = t.with(j, d);
    borrow = bo;
  }
  return t;
}

// The difference a - b - c and its borrow, for a borrow c of 0 or 1.
function sub_borrow(a: u64, b: u64, c: u64): (u64, u64) {
  let d = a - b;
  let e = d - c;
  let k: u64 = if (a < b || d < c) { 1 } else { 0 };
  return (e, k);
}

function limb_args(args: Value[]): u64[][] {
  let out: u64[][] = [];
  for v in args {
    let VArr(av) = v else {
      return out;
    };
    let l: u64[] = [];
    for i in 0..arr_len(av) {
      let e = arr_at(av, i);
      if (!is_int_like(e)) {
        return out;
      }
      l = l.append(vint_as_i64(e) as u64);
    }
    out = out.append(l);
  }
  return out;
}

function call_mont_mul(heap: interpheap.Heap, args: Value[]): Value {
  let ls = limb_args(args);
  if (args.len() != 3 || ls.len() != 3) {
    return v_err("__mont_mul: expected the i64 limbs of a, b and m");
  }
  let n = ls[2].len() - 1;
  if (n < 1 || ls[0].len() != n || ls[1].len() != n) {
    return v_err("__mont_mul: the limbs of a and b do not match the modulus");
  }
  let out: Value[] = [];
  for w in mont_mul_limbs(ls[0], ls[1], ls[2]) {
    out = out.append(v_int64(w as i64));
  }
  return v_arr_of(heap, out, "i64");
}

// __scrypt_block_mix keeps the 16 words of each 64-byte block in this order, two to a slot, the first in the
// low half. Each row of 4 positions is a diagonal of the Salsa20 matrix.
const SCRYPT_ORDER: i32[] = [0, 5, 10, 15, 4, 9, 14, 3, 8, 13, 2, 7, 12, 1, 6, 11];

// The Salsa20/8 core of RFC 7914: eight rounds, and then the input added to the output.
function salsa20_8(w: u32[]): u32[] {
  let x = w;
  let qs: i32[][] = [[0, 4, 8, 12], [5, 9, 13, 1], [10, 14, 2, 6], [15, 3, 7, 11], [0, 1, 2, 3], [5, 6, 7, 4], [10, 11, 8, 9], [15, 12, 13, 14]];
  for _ in 0..4 {
    for q in qs {
      x = x.with(q[1], x[q[1]] ^ rotl32(x[q[0]] + x[q[3]], 7));
      x = x.with(q[2], x[q[2]] ^ rotl32(x[q[1]] + x[q[0]], 9));
      x = x.with(q[3], x[q[3]] ^ rotl32(x[q[2]] + x[q[1]], 13));
      x = x.with(q[0], x[q[0]] ^ rotl32(x[q[3]] + x[q[2]], 18));
    }
  }
  for k in 0..16 {
    x = x.with(k, x[k] + w[k]);
  }
  return x;
}

// XORs the words of the block at b[at:] into x, in RFC order.
function scrypt_xor_words(x: u32[], b: u64[], at: i32): u32[] {
  for k in 0..8 {
    let v = b[at + k];
    x = x.with(SCRYPT_ORDER[2 * k], x[SCRYPT_ORDER[2 * k]] ^ v as u32);
    x = x.with(SCRYPT_ORDER[2 * k + 1], x[SCRYPT_ORDER[2 * k + 1]] ^ (v >> 32) as u32);
  }
  return x;
}

// __scrypt_block_mix: the BlockMix of RFC 7914 of b[from:from + 16r] ^ b[mix:mix + 16r], written to
// b[to:to + 16r]. The even outputs go to the first half of the output and the odd outputs to the second half.
function scrypt_block_mix(b: u64[], from: i32, mix: i32, to: i32, r: i32): u64[] {
  let x: u32[] = [];
  for _ in 0..16 {
    x = x.append(0 as u32);
  }
  x = scrypt_xor_words(scrypt_xor_words(x, b, from + 16 * r - 8), b, mix + 16 * r - 8);
  for i in 0..2 * r {
    x = salsa20_8(scrypt_xor_words(scrypt_xor_words(x, b, from + 8 * i), b, mix + 8 * i));
    let at = to + 8 * (i / 2 + i % 2 * r);
    for k in 0..8 {
      b = b.with(at + k, x[SCRYPT_ORDER[2 * k]] as u64 | x[SCRYPT_ORDER[2 * k + 1]] as u64 << 32);
    }
  }
  return b;
}

// Whether three blocks of 16r slots lie in n slots, with the output block apart from both inputs.
function scrypt_blocks_fit(n: i64, from: i64, mix: i64, to: i64, r: i64): boolean {
  if (r < 1 || from < 0 || mix < 0 || to < 0) {
    return false;
  }
  let h = 16 * r;
  if (from + h > n || mix + h > n || to + h > n) {
    return false;
  }
  return (to - from >= h || from - to >= h) && (to - mix >= h || mix - to >= h);
}

function call_scrypt_block_mix(heap: interpheap.Heap, args: Value[]): Value {
  let ls = limb_args([args[0]]);
  if (args.len() != 5 || ls.len() != 1) {
    return v_err("__scrypt_block_mix: expected b, from, mix, to and r");
  }
  let at: i64[] = [];
  for k in 1..5 {
    if (!is_int_like(args[k])) {
      return v_err("__scrypt_block_mix: expected b, from, mix, to and r");
    }
    at = at.append(vint_as_i64(args[k]));
  }
  if (!scrypt_blocks_fit(ls[0].len() as i64, at[0], at[1], at[2], at[3])) {
    return v_err("__scrypt_block_mix: a block is outside the array or the output overlaps an input");
  }
  let out: Value[] = [];
  for w in scrypt_block_mix(ls[0], at[0] as i32, at[1] as i32, at[2] as i32, at[3] as i32) {
    out = out.append(v_int64(w as i64));
  }
  return v_arr_of(heap, out, "i64");
}

// __poly1305_blocks: the state holds h0, h1, h2, r0 and r1 as little-endian u64. Each 16-byte block of
// msg[at:at + n] is added with 2^128 and multiplied by r. A short last block gets a 1 byte after its end and
// no 2^128. h leaves fully reduced mod 2^130 - 5.
function poly1305_absorb(st: u8[], msg: u8[], at: i32, n: i32): u8[] {
  let r0 = le64_at(st, 24) & 0x0ffffffc0fffffff as u64;
  let r1 = le64_at(st, 32) & 0x0ffffffc0ffffffc as u64;
  let s1 = r1 + (r1 >> 2);
  let h0 = le64_at(st, 0);
  let h1 = le64_at(st, 8);
  let h2 = le64_at(st, 16) & 3;
  let off = 0;
  while (off < n) {
    let k = n - off;
    if (k > 16) {
      k = 16;
    }
    let block = __alloc_u8(16);
    for i in 0..k {
      block = block.with(i, msg[at + off + i]);
    }
    let hibit: u64 = 1;
    if (k < 16) {
      block = block.with(k, 1 as u8);
      hibit = 0;
    }
    let (a0, c0) = add_carry(h0, le64_at(block, 0), 0);
    let (a1, c1) = add_carry(h1, le64_at(block, 8), c0);
    h2 = h2 + hibit + c1;
    let (d0, e0) = add_carry(a0 * r0, a1 * s1, 0);
    let d0_hi = __mulhi_u64(a0, r0) + __mulhi_u64(a1, s1) + e0;
    let (d1, e1) = add_carry(a0 * r1, a1 * r0, 0);
    let (d1g, e2) = add_carry(d1, h2 * s1, 0);
    let d1_hi = __mulhi_u64(a0, r1) + __mulhi_u64(a1, r0) + e1 + e2;
    let (n1, e3) = add_carry(d1g, d0_hi, 0);
    let d2 = h2 * r0 + d1_hi + e3;
    let fold = (d2 & ~(3 as u64)) + (d2 >> 2);
    let (n0, f0) = add_carry(d0, fold, 0);
    let (n1b, f1) = add_carry(n1, f0, 0);
    h0 = n0;
    h1 = n1b;
    h2 = (d2 & 3) + f1;
    off += k;
  }
  let (g0, k0) = add_carry(h0, 5, 0);
  let (g1, k1) = add_carry(h1, k0, 0);
  if (h2 + k1 >= 4) {
    h0 = g0;
    h1 = g1;
    h2 = h2 + k1 - 4;
  }
  let out = st;
  return put_le64_at(put_le64_at(put_le64_at(out, 0, h0), 8, h1), 16, h2);
}

function call_poly1305_blocks(heap: interpheap.Heap, args: Value[]): Value {
  if (args.len() != 4) {
    return v_err("__poly1305_blocks: expected st, msg, at and n");
  }
  let bs = byte_args([args[0], args[1]]);
  let at = vint_as_i64(args[2]);
  let n = vint_as_i64(args[3]);
  if (bs.len() != 2 || bs[0].len() != 40 || at < 0 || n < 0 || at + n > bs[1].len() as i64) {
    return v_err("__poly1305_blocks: range out of bounds");
  }
  return written_bytes(heap, args[0], poly1305_absorb(bs[0], bs[1], at as i32, n as i32));
}

// Absorbs b with zeros after a short last block, as the AEAD of RFC 8439 pads its parts.
function poly1305_padded(st: u8[], b: u8[]): u8[] {
  let full = b.len() - b.len() % 16;
  let out = poly1305_absorb(st, b, 0, full);
  if (full == b.len()) {
    return out;
  }
  let last = __alloc_u8(16);
  for i in full..b.len() {
    last = last.with(i - full, b[i]);
  }
  return poly1305_absorb(out, last, 0, 16);
}

// The tag of RFC 8439's AEAD over aad and ct under the one-time key otk.
function chacha20_poly1305_tag(otk: u8[], aad: u8[], ct: u8[]): u8[] {
  let st = __alloc_u8(40);
  for i in 0..16 {
    st = st.with(24 + i, otk[i]);
  }
  st = poly1305_padded(poly1305_padded(st, aad), ct);
  st = poly1305_absorb(st, put_le64_at(put_le64_at(__alloc_u8(16), 0, aad.len() as u64), 8, ct.len() as u64), 0, 16);
  let (t0, c) = add_carry(le64_at(st, 0), le64_at(otk, 16), 0);
  let (t1, _) = add_carry(le64_at(st, 8), le64_at(otk, 24), c);
  return put_le64_at(put_le64_at(__alloc_u8(16), 0, t0), 8, t1);
}

// The in-place pair of ChaCha20-Poly1305 over a copy of the buffer argument, as the compiled kernels leave it. The
// key stream of block ctr is the one-time key, and the text starts at block ctr + 1.
function call_chacha20_poly1305_into(heap: interpheap.Heap, name: string, args: Value[]): Value {
  if (args.len() != 7) {
    return v_err(name + ": expected key, ctr, buf, aad_at, aad_n, at and n");
  }
  let bs = byte_args([args[0], args[1], args[2]]);
  let aad_at = vint_as_i64(args[3]);
  let aad_n = vint_as_i64(args[4]);
  let at = vint_as_i64(args[5]);
  let n = vint_as_i64(args[6]);
  if (bs.len() != 3 || bs[0].len() != 32 || bs[1].len() != 16 || aad_at < 0 || aad_n < 0 || at < 0 || n < 0) {
    return v_err(name + ": range out of bounds");
  }
  let size = bs[2].len() as i64;
  if (at + n + 16 > size || aad_at + aad_n > size) {
    return v_err(name + ": range out of bounds");
  }
  let otk = chacha20_xor(bs[0], bs[1], __alloc_u8(32), 0, 32);
  let c = le32_at(bs[1], 0) + 1;
  let next = bs[1];
  for i in 0..4 {
    next = next.with(i, (c >> (8 * i) as u32 & 255) as u8);
  }
  let d = at as i32;
  let m = n as i32;
  let buf = bs[2];
  let aad = sub_bytes(buf, aad_at as i32, aad_n as i32);
  if (name == "__chacha20_poly1305_seal_into") {
    buf = chacha20_xor(bs[0], next, buf, d, m);
    let tag = chacha20_poly1305_tag(otk, aad, sub_bytes(buf, d, m));
    for i in 0..16 {
      buf = buf.with(d + m + i, tag[i]);
    }
    return written_bytes(heap, args[2], buf);
  }
  let want = chacha20_poly1305_tag(otk, aad, sub_bytes(buf, d, m));
  let diff: u8 = 0;
  for i in 0..16 {
    diff = diff | want[i] ^ buf[d + m + i];
  }
  buf = chacha20_xor(bs[0], next, buf, d, m);
  let verdict: u8 = if (diff == 0) { 0 } else { 1 };
  return written_bytes(heap, args[2], buf.with(d + m, verdict));
}

// A kernel that writes into a byte array it takes. The interpreter runs it over a copy of the array.
function is_byte_into_kernel(name: string): boolean {
  return name == "__aes_gcm_seal_into" || name == "__aes_gcm_open_into" || name == "__chacha20_xor_into" || name == "__poly1305_blocks"
    || name == "__chacha20_poly1305_seal_into" || name == "__chacha20_poly1305_open_into";
}

function call_byte_into_kernel(heap: interpheap.Heap, name: string, args: Value[]): Value {
  if (name == "__chacha20_xor_into") {
    return call_chacha20_xor_into(heap, args);
  }
  if (name == "__poly1305_blocks") {
    return call_poly1305_blocks(heap, args);
  }
  if (name == "__chacha20_poly1305_seal_into" || name == "__chacha20_poly1305_open_into") {
    return call_chacha20_poly1305_into(heap, name, args);
  }
  return call_aes_gcm_into(heap, name, args);
}

function call_aes_gcm(heap: interpheap.Heap, name: string, args: Value[]): Value {
  let want = aes_gcm_arity(name);
  let bs = byte_args(args);
  if (args.len() != want || bs.len() != want) {
    return v_err(name + ": expected " + util.i32_to_string(want) + " byte arrays");
  }
  if (want == 1) {
    if (bs[0].len() != 16 && bs[0].len() != 32) {
      return v_err(name + ": the key is not 16 or 32 bytes");
    }
    return byte_value(heap, aesref.expand_key(bs[0]));
  }
  if (name == "__ghash") {
    if (bs[0].len() < 16 || bs[1].len() < 16) {
      return v_err(name + ": the hash key or the block is too short");
    }
    return byte_value(heap, aesref.ghash(bs[0], bs[1], bs[2]));
  }
  if (bs[0].len() < 176 || bs[1].len() < 16) {
    return v_err(name + ": the round keys or the counter are too short");
  }
  return byte_value(heap, aesref.ctr32(bs[0], bs[1], bs[2]));
}

function crc32_cksum_byte(crc: i32, b: i32): i32 {
  crc = crc ^ b << 24;
  for k in 0..8 {
    if (crc < 0) {
      crc = crc << 1 ^ 0x04c11db7;
    } else {
      crc = crc << 1;
    }
  }
  return crc;
}

function crc32_ieee_byte(crc: i32, b: i32): i32 {
  let c = (crc ^ b) as u32;
  for k in 0..8 {
    if ((c & 1) != 0) {
      c = c >> 1 ^ 0xedb88320;
    } else {
      c = c >> 1;
    }
  }
  return c as i32;
}

function call_crc32_array(name: string, args: Value[]): Value {
  if (args.len() != 2) {
    return v_err(name + ": expected 2 args");
  }
  if (!is_i32_arg(args[0])) {
    return v_err(name + ": crc must be an integer");
  }
  if let VArr(a) = args[1] {
    let crc = vint_bits(args[0]);
    let ieee = name == "__crc32_ieee_array";
    for element in arr_els(a) {
      if (!is_i32_arg(element)) {
        return v_err(name + ": elements must be u8");
      }
      let b = vint_bits(element);
      if (b < 0 || b > 255) {
        return v_err(name + ": elements must be u8");
      }
      if (ieee) {
        crc = crc32_ieee_byte(crc, b);
      } else {
        crc = crc32_cksum_byte(crc, b);
      }
    }
    return v_int(crc);
  }
  return v_err(name + ": second arg must be an array");
}

function call_scale_f64(heap: interpheap.Heap, args: Value[]): Value {
  if (args.len() != 2) {
    return v_err("__scale_f64: expected 2 args (xs, k)");
  }
  if let VArr(xa) = args[0] {
    if let VFloat(kf) = args[1] {
      let sout: Value[] = [];
      let sidx = 0;
      while (sidx < arr_len(xa)) {
        if let VFloat(ef) = arr_at(xa, sidx) {
          sout = sout.append(v_float(ef.v * kf.v));
        } else {
          return v_err("__scale_f64: elements must be f64");
        }
        sidx += 1;
      }
      return v_arr_of(heap, sout, "f64");
    }
    return v_err("__scale_f64: k must be an f64");
  }
  return v_err("__scale_f64: first arg must be an array");
}

function inner_mul_values(heap: interpheap.Heap, a: Value[], b: Value[], rows: i32, extent: i32, columns: i32, init: f64): Value {
  let m = rows as i64;
  let k = extent as i64;
  let n = columns as i64;
  if (rows < 0 || extent < 0 || columns < 0 || m * k != a.len() as i64 || k * n != b.len() as i64 || m * n > 2147483647i64) {
    exit(134);
    return v_err("__inner_mul_add_f64: invalid geometry");
  }
  if (rows == 0 || columns == 0) {
    return v_arr_of(heap, [], "f64");
  }
  return inner_mul_loop(heap, a, b, rows, extent, columns, init);
}

function inner_mul_loop(heap: interpheap.Heap, a: Value[], b: Value[], rows: i32, extent: i32, columns: i32, init: f64): Value {
  let out: Value[] = [];
  for row in 0..rows {
    for col in 0..columns {
      let acc = init;
      for at in 0..extent {
        if let VFloat(x) = a[row * extent + at] {
          if let VFloat(y) = b[at * columns + col] {
            let product = x.v * y.v;
            acc += product;
          } else {
            return v_err("__inner_mul_add_f64: elements must be f64");
          }
        } else {
          return v_err("__inner_mul_add_f64: elements must be f64");
        }
      }
      out = out.append(v_float(acc));
    }
  }
  return v_arr_of(heap, out, "f64");
}

function call_inner_mul_add_f64(heap: interpheap.Heap, args: Value[]): Value {
  if (args.len() != 6) {
    return v_err("__inner_mul_add_f64: expected 6 args");
  }
  if let VArr(a) = args[0] {
    if let VArr(b) = args[1] {
      if let VInt(m) = args[2] {
        if let VInt(k) = args[3] {
          if let VInt(n) = args[4] {
            if let VFloat(init) = args[5] {
              return inner_mul_values(heap, arr_els(a), arr_els(b), m.v, k.v, n.v, init.v);
            }
          }
        }
      }
    }
  }
  return v_err("__inner_mul_add_f64: invalid argument types");
}

function outer_mul_values(heap: interpheap.Heap, a: Value[], b: Value[]): Value {
  if (b.len() > 0 && a.len() > 2147483647 / b.len()) {
    exit(134);
    return v_err("__outer_mul_f64: result length overflow");
  }
  let out: Value[] = [];
  for left in a {
    if let VFloat(x) = left {
      for right in b {
        if let VFloat(y) = right {
          out = out.append(v_float(x.v * y.v));
        } else {
          return v_err("__outer_mul_f64: elements must be f64");
        }
      }
    } else {
      return v_err("__outer_mul_f64: elements must be f64");
    }
  }
  return v_arr_of(heap, out, "f64");
}

function call_outer_mul_f64(heap: interpheap.Heap, args: Value[]): Value {
  if (args.len() != 2) {
    return v_err("__outer_mul_f64: expected 2 args");
  }
  if let VArr(a) = args[0] {
    if let VArr(b) = args[1] {
      return outer_mul_values(heap, arr_els(a), arr_els(b));
    }
  }
  return v_err("__outer_mul_f64: inputs must be arrays");
}

function call_byte_reduction(name: string, args: Value[]): Value {
  let bsd = name == "__bsd_sum_bytes";
  let argc = 1;
  if (bsd) {
    argc = 2;
  }
  if (args.len() != argc) {
    return v_err(name + ": wrong number of arguments");
  }
  if (bsd && !is_i32_arg(args[1])) {
    return v_err(name + ": seed must be an integer");
  }
  match (args[0]) {
    VArr(a) => {
      let sum: u32 = 0;
      if (bsd) {
        sum = vint_bits(args[1]) as u32 & 0xffff;
      }
      let i = 0;
      while (i < arr_len(a)) {
        if (bsd) {
          sum = (sum >> 1 | sum << 15) & 0xffff;
        }
        sum = sum + vint_bits(arr_at(a, i)) as u32;
        if (bsd) {
          sum = sum & 0xffff;
        }
        i += 1;
      }
      return v_int(sum as i32);
    },
    _ => {
      return v_err(name + ": input must be an array");
    }
  }
}

function call_byte_set_scan(name: string, args: Value[]): Value {
  if (args.len() != 3) {
    return v_err(name + ": expected 3 args (bytes, flag, set)");
  }
  if (!is_i32_arg(args[1])) {
    return v_err(name + ": flag must be an integer");
  }
  match (args[0]) {
    VArr(a) => {
      match (args[2]) {
        VArr(set) => {
          let scan = name == "__scan_set_bytes";
          let at = 0;
          let prev = vint_bits(args[1]) != 0;
          let runs = 0;
          if (scan) {
            at = vint_bits(args[1]);
            if (at < 0) {
              at = 0;
            }
          }
          while (at < arr_len(a)) {
            let b = vint_bits(arr_at(a, at));
            let member = b >= 0 && b < arr_len(set) && vint_bits(arr_at(set, b)) != 0;
            if (scan && member) {
              return v_int(at);
            }
            if (member && !prev) {
              runs += 1;
            }
            prev = member;
            at += 1;
          }
          if (scan) {
            return v_int(arr_len(a));
          }
          return v_int(runs);
        },
        _ => {
          return v_err(name + ": set must be a byte array");
        }
      }
    },
    _ => {
      return v_err(name + ": first arg must be a byte array");
    }
  }
}

function call_mismatch_bytes(args: Value[]): Value {
  if (args.len() != 5) {
    return v_err("__mismatch_bytes: expected 5 args");
  }
  if (!is_i32_arg(args[1]) || !is_i32_arg(args[3]) || !is_i32_arg(args[4])) {
    return v_err("__mismatch_bytes: bounds must be integers");
  }
  if let VArr(a) = args[0] {
    if let VArr(b) = args[2] {
      let ao = clamp_offset(vint_bits(args[1]), arr_len(a));
      let bo = clamp_offset(vint_bits(args[3]), arr_len(b));
      let room = arr_len(a) - ao;
      if (arr_len(b) - bo < room) {
        room = arr_len(b) - bo;
      }
      let n = clamp_offset(vint_bits(args[4]), room);
      for i in 0..n {
        if (vint_bits(arr_at(a, ao + i)) != vint_bits(arr_at(b, bo + i))) {
          return v_int(i);
        }
      }
      return v_int(n);
    }
    return v_err("__mismatch_bytes: second range must be an array");
  }
  return v_err("__mismatch_bytes: first range must be an array");
}

function call_mismatch_bytes_str(args: Value[]): Value {
  if (args.len() != 5) {
    return v_err("__mismatch_bytes_str: expected 5 args");
  }
  if (!is_i32_arg(args[1]) || !is_i32_arg(args[3]) || !is_i32_arg(args[4])) {
    return v_err("__mismatch_bytes_str: bounds must be integers");
  }
  if (!is_string_arg(args[2])) {
    return v_err("__mismatch_bytes_str: second range must be a string");
  }
  if let VArr(a) = args[0] {
    let b = vstr_of(args[2]);
    let ao = clamp_offset(vint_bits(args[1]), arr_len(a));
    let bo = clamp_offset(vint_bits(args[3]), b.len());
    let n = vint_bits(args[4]);
    if (n > arr_len(a) - ao) {
      n = arr_len(a) - ao;
    }
    if (n > b.len() - bo) {
      n = b.len() - bo;
    }
    if (n < 0) {
      n = 0;
    }
    for i in 0..n {
      if (vint_bits(arr_at(a, ao + i)) != b[bo + i] as i32) {
        return v_int(i);
      }
    }
    return v_int(n);
  }
  return v_err("__mismatch_bytes_str: first range must be an array");
}

function call_memchr_bytes(args: Value[]): Value {
  if (args.len() != 3) {
    return v_err("__memchr_bytes: expected 3 args (bytes, byte, from)");
  }
  if (!is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
    return v_err("__memchr_bytes: byte and start must be integers");
  }
  if let VArr(a) = args[0] {
    let byte = vint_bits(args[1]);
    let at = vint_bits(args[2]);
    if (byte < 0 || byte > 255) {
      return v_int(-1);
    }
    if (at < 0) {
      at = 0;
    }
    while (at < arr_len(a)) {
      if (vint_bits(arr_at(a, at)) == byte) {
        return v_int(at);
      }
      at += 1;
    }
    return v_int(-1);
  }
  return v_err("__memchr_bytes: first arg must be a byte array");
}

function call_rmemchr_bytes(args: Value[]): Value {
  if (args.len() != 3) {
    return v_err("__rmemchr_bytes: expected 3 args (bytes, byte, from)");
  }
  if (!is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
    return v_err("__rmemchr_bytes: byte and start must be integers");
  }
  if let VArr(a) = args[0] {
    let byte = vint_bits(args[1]);
    let at = vint_bits(args[2]);
    if (byte < 0 || byte > 255) {
      return v_int(-1);
    }
    if (at >= arr_len(a)) {
      at = arr_len(a) - 1;
    }
    while (at >= 0) {
      if (vint_bits(arr_at(a, at)) == byte) {
        return v_int(at);
      }
      at -= 1;
    }
    return v_int(-1);
  }
  return v_err("__rmemchr_bytes: first arg must be a byte array");
}

function call_buf_push_bytes_range(h: usize, args: Value[]): Value {
  if (args.len() != 4) {
    return v_err("buf_push_bytes_range: expected 4 args (b, bytes, lo, hi)");
  }
  if (!is_int_like(args[2]) || !is_int_like(args[3])) {
    return v_err("buf_push_bytes_range: bounds must be integers");
  }
  match (args[1]) {
    VArr(a) => {
      let lo = int_arg_i32(args[2]);
      let hi = int_arg_i32(args[3]);
      if (lo < 0) {
        lo = 0;
      }
      if (hi > arr_len(a)) {
        hi = arr_len(a);
      }
      while (lo < hi) {
        buf_push_byte(h, vint_bits(arr_at(a, lo)) & 255);
        lo += 1;
      }
      return v_void();
    },
    _ => {
      return v_err("buf_push_bytes_range: expected byte array");
    }
  }
}

// The alphabet characters for each whole group of bytes in a[lo..hi), with
// `bits` bits a character: groups of 3 bytes for 6 bits, of 5 for 5.
function call_buf_push_based(name: string, h: usize, args: Value[], bits: i32): Value {
  if (args.len() != 5) {
    return v_err(name + ": expected 5 args (b, bytes, lo, hi, alphabet)");
  }
  if (!is_int_like(args[2]) || !is_int_like(args[3])) {
    return v_err(name + ": bounds must be integers");
  }
  match (args[1]) {
    VArr(a) => {
      match (args[4]) {
        VArr(t) => {
          return push_based_range(h, a, t, int_arg_i32(args[2]), int_arg_i32(args[3]), bits);
        },
        _ => {
          return v_err(name + ": expected an alphabet array");
        }
      }
    },
    _ => {
      return v_err(name + ": expected byte array");
    }
  }
}

function push_based_range(h: usize, a: VArr, t: VArr, lo0: i32, hi0: i32, bits: i32): Value {
  let lo: i32 = if (lo0 < 0) { 0 } else { lo0 };
  let hi: i32 = if (hi0 > arr_len(a)) { arr_len(a) } else { hi0 };
  let group: i32 = if (bits == 6) { 3 } else { 5 };
  if (hi - lo >= group && arr_len(t) < 1 << bits) {
    return index_abort(aborts.arr_oob(), util.i32_to_string((1 << bits) - 1), arr_len(t));
  }
  for g in 0..(hi - lo) / group {
    push_based_group(h, a, t, lo + g * group, group, bits);
  }
  return v_void();
}

// Five bytes for each whole group of eight characters in a[lo..hi), up to the
// first group with a character outside both ranges in r: the start and count
// of the values from 0, then the start and count of the rest.
function call_buf_decode_base32(h: usize, args: Value[]): Value {
  if (args.len() != 5 || !is_int_like(args[2]) || !is_int_like(args[3])) {
    return v_err("buf_decode_base32: expected 5 args (b, bytes, lo, hi, ranges)");
  }
  match (args[1]) {
    VArr(a) => {
      match (args[4]) {
        VArr(r) => {
          return decode_base32_range(h, a, r, int_arg_i32(args[2]), int_arg_i32(args[3]));
        },
        _ => {
          return v_err("buf_decode_base32: expected a ranges array");
        }
      }
    },
    _ => {
      return v_err("buf_decode_base32: expected byte array");
    }
  }
}

function decode_base32_range(h: usize, a: VArr, r: VArr, lo0: i32, hi0: i32): Value {
  let lo: i32 = if (lo0 < 0) { 0 } else { lo0 };
  let hi: i32 = if (hi0 > arr_len(a)) { arr_len(a) } else { hi0 };
  if (hi - lo >= 8 && arr_len(r) < 4) {
    return index_abort(aborts.arr_oob(), "3", arr_len(r));
  }
  let at = lo;
  while (at + 8 <= hi && decode_base32_group(h, a, r, at)) {
    at += 8;
  }
  return v_int(at);
}

function decode_base32_group(h: usize, a: VArr, r: VArr, at: i32): boolean {
  let v = 0 as i64;
  for k in 0..8 {
    let c = vint_bits(arr_at(a, at + k)) & 255;
    let d1 = c - (vint_bits(arr_at(r, 0)) & 255) & 255;
    let d2 = c - (vint_bits(arr_at(r, 2)) & 255) & 255;
    let n1 = vint_bits(arr_at(r, 1)) & 255;
    if (d1 < n1) {
      v = v << 5 | d1 as i64;
    } else if (d2 < (vint_bits(arr_at(r, 3)) & 255)) {
      v = v << 5 | (d2 + n1) as i64;
    } else {
      return false;
    }
  }
  for s in [32, 24, 16, 8, 0] {
    buf_push_byte(h, (v >> s) as i32 & 255);
  }
  return true;
}

function push_based_group(h: usize, a: VArr, t: VArr, at: i32, group: i32, bits: i32): void {
  let v = 0 as i64;
  for k in 0..group {
    v = v << 8 | (vint_bits(arr_at(a, at + k)) & 255) as i64;
  }
  let shift = group * 8 - bits;
  while (shift >= 0) {
    buf_push_byte(h, vint_bits(arr_at(t, (v >> shift) as i32 & (1 << bits) - 1)) & 255);
    shift -= bits;
  }
}

function call_buf_push_range(h: usize, args: Value[]): Value {
  if (args.len() != 4) {
    return v_err("buf_push_range: expected 4 args (b, s, lo, hi)");
  }
  if (!is_string_arg(args[1])) {
    return v_err("buf_push_range: expected string arg");
  }
  if (!is_int_like(args[2]) || !is_int_like(args[3])) {
    return v_err("buf_push_range: bounds must be integers");
  }
  let s = vstr_of(args[1]);
  let lo = int_arg_i32(args[2]);
  let hi = int_arg_i32(args[3]);
  if (lo < 0 || hi > s.len() || lo > hi) {
    return slice_abort(aborts.slice_range(), "buf_push_range", lo, hi, s.len());
  }
  buf_push_range(h, s, lo, hi);
  return v_void();
}

function call_buf_push_table(name: string, h: usize, args: Value[]): Value {
  if (args.len() != 3) {
    return v_err(name + ": expected 3 args (b, s, table)");
  }
  match (args[2]) {
    VArr(tv) => {
      let table = arr_els(tv);
      if (name == "buf_push_bytes_mapped" || name == "buf_push_bytes_filtered" || name == "buf_push_bytes_expanded") {
        if let VArr(src) = args[1] {
          for e in arr_els(src) {
            push_table_byte(name, h, vint_bits(e) & 255, table);
          }
          return v_void();
        }
        return v_err(name + ": expected u8[] arg");
      }
      if (!is_string_arg(args[1])) {
        return v_err(name + ": expected string arg");
      }
      let s = vstr_of(args[1]);
      for i in 0..s.len() {
        push_table_byte(name, h, s[i] as i32, table);
      }
      return v_void();
    },
    _ => {
      return v_err(name + ": table must be a u8[]");
    }
  }
}

function push_table_byte(name: string, h: usize, c: i32, table: Value[]): void {
  if (name == "buf_push_expanded" || name == "buf_push_bytes_expanded") {
    if (c * 8 + 8 > table.len()) {
      buf_push_byte(h, c);
      return;
    }
    let n = vint_bits(table[c * 8]) & 255;
    if (n > 7) {
      n = 7;
    }
    for k in 1..=n {
      buf_push_byte(h, vint_bits(table[c * 8 + k]) & 255);
    }
    return;
  }
  if (c >= table.len()) {
    buf_push_byte(h, c);
    return;
  }
  if (name == "buf_push_filtered" || name == "buf_push_bytes_filtered") {
    if ((vint_bits(table[c]) & 255) == 0) {
      buf_push_byte(h, c);
    }
    return;
  }
  buf_push_byte(h, vint_bits(table[c]) & 255);
}

function call_buf_append(name: string, h: usize, args: Value[]): Value {
  if (name == "buf_push") {
    if (args.len() != 2) {
      return v_err("buf_push: expected 2 args (b, s)");
    }
    if (!is_string_arg(args[1])) {
      return v_err("buf_push: expected string arg");
    }
    buf_push(h, vstr_of(args[1]));
    return v_void();
  }
  if (name == "buf_push_u64") {
    if (args.len() != 2) {
      return v_err("buf_push_u64: expected 2 args (b, v)");
    }
    if (!is_int_like(args[1])) {
      return v_err("buf_push_u64: expected number");
    }
    let w = vint_as_i64(args[1]);
    for k in 0..8 {
      buf_push_byte(h, (w >> (k * 8) as i64) as i32 & 255);
    }
    return v_void();
  }
  if (name == "buf_push_decimal") {
    if (args.len() != 2) {
      return v_err("buf_push_decimal: expected 2 args (b, n)");
    }
    if (!is_int_like(args[1])) {
      return v_err("buf_push_decimal: expected number");
    }
    buf_push(h, u64_text(vint_as_i64(args[1]), true));
    return v_void();
  }
  if (name != "buf_push_byte") {
    return v_err(name + ": not a builder append");
  }
  if (args.len() != 2) {
    return v_err("buf_push_byte: expected 2 args (b, x)");
  }
  if (!is_int_like(args[1])) {
    return v_err("buf_push_byte: expected number byte");
  }
  buf_push_byte(h, int_arg_i32(args[1]) & 255);
  return v_void();
}

function call_buf_read(heap: interpheap.Heap, name: string, h: usize, args: Value[]): Value {
  if (args.len() != 1) {
    return v_err(name + ": expected 1 arg (b)");
  }
  if (name == "buf_len") {
    return v_int(buf_len(h));
  }
  if (name == "buf_take") {
    return v_string(utf8.from_bytes_lossy(buf_take_bytes(h)));
  }
  if (name == "buf_take_bytes") {
    return call_buf_take_bytes(heap, h);
  }
  if (name == "buf_clear") {
    let dropped = buf_take_bytes(h);
    return v_void();
  }
  if (name != "buf_free") {
    return v_err(name + ": not a builder read");
  }
  buf_free(h);
  return v_void();
}

function call_buf_take_bytes(heap: interpheap.Heap, h: usize): Value {
  return byte_array_value(heap, buf_take_bytes(h));
}

function is_raw_mem_builtin(name: string): boolean {
  if (name == "__alloc" || name == "__free" || name == "__memcpy" || name == "__memset" || name == "__ptr_width") {
    return true;
  }
  if (name == "__load_u8" || name == "__load_i32" || name == "__load_i64" || name == "__load_ptr" || builtinsigs.device_intrinsic(name)) {
    return true;
  }
  return name == "__store_u8" || name == "__store_i32" || name == "__store_i64" || name == "__store_ptr";
}

// The interpreter is a compiled program, so the raw builtins act on its own
// heap, as the buffer builtins do.
function call_raw_mem_builtin(heap: interpheap.Heap, name: string, args: Value[]): Value {
  if (builtinsigs.device_intrinsic(name)) {
    return call_mmio_builtin(name, args);
  }
  let want = 1;
  if (name == "__ptr_width") {
    want = 0;
  }
  if (name == "__free" || name.starts_with("__store_")) {
    want = 2;
  }
  if (name == "__memcpy" || name == "__memset") {
    want = 3;
  }
  if (args.len() != want) {
    return v_err(name + ": expected " + util.i32_to_string(want) + " args");
  }
  let w: i64[] = [];
  for k in 0..want {
    if (!is_int_like(args[k])) {
      return v_err(name + ": arg " + util.i32_to_string(k + 1) + " must be an integer");
    }
    w = w.append(vint_as_i64(args[k]));
  }
  if (name == "__ptr_width") {
    return v_int((ptr_bits() / 8i64) as i32);
  }
  if (name == "__alloc" || name == "__memcpy" || name == "__memset") {
    let n = w[want - 1];
    if (n < 0i64) {
      return v_err(name + ": size " + util.i64_to_string(n) + " is below zero");
    }
  }
  if (name.starts_with("__load_")) {
    return raw_mem_load(name, w[0] as usize);
  }
  return raw_mem_effect(heap, name, w);
}

function call_mmio_builtin(name: string, args: Value[]): Value {
  if (name == "__fence") {
    return v_void();
  }
  if (builtinsigs.privileged_intrinsic(name) || builtinsigs.port_intrinsic(name)) {
    return v_err(name + ": needs a kernel target");
  }
  let want = 1;
  if (builtinsigs.access_store(name)) {
    want = 2;
  }
  if (args.len() != want) {
    return v_err(name + ": expected " + util.i32_to_string(want) + " args");
  }
  let w: i64[] = [];
  for a in args {
    if (!is_int_like(a)) {
      return v_err(name + ": args must be integers");
    }
    w = w.append(vint_as_i64(a));
  }
  return raw_mmio(name, w);
}

// No device answers the interpreter, so an MMIO or raw memory access is an
// ordinary access to its own memory.
function raw_mmio(name: string, w: i64[]): Value {
  let bits = builtinsigs.access_width(name);
  let p = w[0] as usize;
  unsafe {
    if (!builtinsigs.access_store(name)) {
      return match (bits) {
        8 => v_int(__load_u8(p)),
        16 => v_int(__load_u8(p) | __load_u8(p + 1) << 8),
        32 => v_int(__load_i32(p)),
        _ => v_int64(__load_i64(p)),
      };
    }
    if (bits == 8) {
      __store_u8(p, w[1] as i32 & 255);
    } else if (bits == 16) {
      __store_u8(p, w[1] as i32 & 255);
      __store_u8(p + 1, w[1] as i32 >> 8 & 255);
    } else if (bits == 32) {
      __store_i32(p, w[1] as i32);
    } else {
      __store_i64(p, w[1]);
    }
  }
  return v_void();
}

function raw_mem_load(name: string, p: usize): Value {
  unsafe {
    return match (name) {
      "__load_u8" => v_int(__load_u8(p)),
      "__load_i32" => v_int(__load_i32(p)),
      "__load_i64" => v_int64(__load_i64(p)),
      _ => v_usize(__load_ptr(p) as i64),
    };
  }
}

function raw_mem_effect(heap: interpheap.Heap, name: string, w: i64[]): Value {
  unsafe {
    if (name == "__alloc") {
      let fresh = __alloc(w[0] as i32);
      interpheap.raw_record(heap, fresh as i64, w[0] as i32);
      return v_usize(fresh as i64);
    }
    let p = w[0] as usize;
    if (name == "__free") {
      if (w[0] == 0i64) {
        return v_void();
      }
      let state = interpheap.raw_release(heap, w[0]);
      if (state == 0) {
        return v_abort(aborts.free_range(), "address " + util.i64_to_string(w[0]) + " is not a block from __alloc");
      }
      if (state < 0) {
        return v_abort(aborts.double_free(), "block at " + util.i64_to_string(w[0]) + ", " + util.i64_to_string(w[1]) + " bytes");
      }
      __free(p, w[1] as i32);
    } else if (name == "__memcpy") {
      __memcpy(p, w[1] as usize, w[2] as i32);
    } else if (name == "__memset") {
      __memset(p, w[1] as i32, w[2] as i32);
    } else if (name == "__store_u8") {
      __store_u8(p, w[1] as i32);
    } else if (name == "__store_i32") {
      __store_i32(p, w[1] as i32);
    } else if (name == "__store_i64") {
      __store_i64(p, w[1]);
    } else {
      __store_ptr(p, w[1] as usize);
    }
  }
  return v_void();
}

function call_buf_builtin(heap: interpheap.Heap, name: string, args: Value[]): Value {
  if (name == "buf_new") {
    return call_buf_new(args);
  }
  if (args.len() == 0 || !is_int_like(args[0])) {
    return v_err(name + ": expected a builder handle");
  }
  let h = buf_handle_of(args[0]);
  if (name == "buf_push_range") {
    return call_buf_push_range(h, args);
  }
  if (name == "buf_push_bytes_range") {
    return call_buf_push_bytes_range(h, args);
  }
  if (name == "buf_push_base64") {
    return call_buf_push_based(name, h, args, 6);
  }
  if (name == "buf_push_base32") {
    return call_buf_push_based(name, h, args, 5);
  }
  if (name == "buf_decode_base32") {
    return call_buf_decode_base32(h, args);
  }
  if (name == "buf_push_bytes_mapped" || name == "buf_push_bytes_filtered" || name == "buf_push_bytes_expanded" || name == "buf_push_mapped" || name == "buf_push_filtered" || name == "buf_push_expanded") {
    return call_buf_push_table(name, h, args);
  }
  if (name == "buf_push" || name == "buf_push_byte" || name == "buf_push_u64" || name == "buf_push_decimal") {
    return call_buf_append(name, h, args);
  }
  return call_buf_read(heap, name, h, args);
}

function str_hash_word(s: string, at: i32, n: i32): i64 {
  let w: i64 = 0i64;
  let k = n - 1;
  while (k >= 0) {
    w = w << 8i64 | s[at + k] as i64;
    k -= 1;
  }
  return w;
}

function is_sha_blocks_name(name: string): boolean {
  return name == "__sha256_hw_blocks" || name == "__sha1_hw_blocks" || name == "__sha1x8_hw_blocks";
}

function str_hash_low32(h: i64): i32 {
  let lo = h & 4294967295i64;
  if (lo >= 2147483648i64) {
    return (lo - 4294967296i64) as i32;
  }
  return lo as i32;
}

function call_func(heap: interpheap.Heap, name: string, args: Value[], funcs: Funcs, aliases: parser.TypeAlias[], type_decls: parser.StructDecl[]): Value {
  return call_func_targs(heap, name, args, [], "", funcs, aliases, type_decls);
}

function call_func_targs(heap: interpheap.Heap, name: string, args: Value[], type_args: string[], expect: string, funcs: Funcs, aliases: parser.TypeAlias[], type_decls: parser.StructDecl[]): Value {
  if (name == "print" || name == "write" || name == "eprint") {
    if (args.len() != 1) {
      return v_err(name + " takes exactly 1 argument");
    }
    let text_val = args[0];
    match (text_val) {
      VString(_) => {},
      _ => {
        let no_args: Value[] = [];
        text_val = call_method(heap, args[0], "to_string", no_args, funcs, aliases, type_decls);
      }
    }
    match (text_val) {
      VErr(_) => {
        return text_val;
      },
      VString(s) => {
        let text = s.v;
        if (name == "print") {
          print(text);
        } else if (name == "write") {
          write(text);
        } else {
          eprint(text);
        }
        return v_int(0);
      },
      _ => {
        return v_err(name + ": to_string() did not return a string");
      }
    }
  }
  if (name == "putchar") {
    if (args.len() != 1 || !is_i32_arg(args[0])) {
      return v_err("putchar takes exactly 1 integer argument");
    }
    putchar(vint_bits(args[0]));
    return v_int(0);
  }
  if (name == "target_os") {
    if (args.len() != 0) {
      return v_err("target_os takes no arguments");
    }
    return v_string(target_os());
  }
  if (name == "target_arch") {
    if (args.len() != 0) {
      return v_err("target_arch takes no arguments");
    }
    return v_string(target_arch());
  }
  if (name == "map_new" || name == "__map_new_i32") {
    return v_map_new();
  }
  if (name == "__alloc_u8" || name == "__alloc_u8_uninit" || name == "__alloc_i32" || name == "__alloc_i64" || name == "__alloc_f64" || name == "__alloc_bool") {
    if (args.len() != 1) {
      return v_err(name + ": expected 1 arg (n)");
    }
    if (!is_i32_arg(args[0])) {
      return v_err(name + ": arg must be an integer");
    }
    let an = vint_bits(args[0]);
    if (an < 0) {
      return v_abort(aborts.alloc_size(), name + " length " + util.i32_to_string(an));
    }
    let zero = v_int(0);
    if (name == "__alloc_i64") {
      zero = v_int64(0i64);
    }
    if (name == "__alloc_f64") {
      zero = v_float(0.0);
    }
    if (name == "__alloc_bool") {
      zero = v_bool(false);
    }
    let zs: Value[] = [];
    for zi in 0..an {
      zs = zs.append(zero);
    }
    return v_arr(heap, zs);
  }
  if (name == "string_from_bytes_unchecked") {
    if (args.len() != 1) {
      return v_err("string_from_bytes_unchecked: expected 1 arg (bs)");
    }
    match (args[0]) {
      VArr(a) => {
        let raw: u8[] = [];
        let ri = 0;
        while (ri < arr_len(a)) {
          if (!is_i32_arg(arr_at(a, ri))) {
            return v_err("string_from_bytes_unchecked: element " + util.i32_to_string(ri) + " is not an integer");
          }
          raw = raw.append((vint_bits(arr_at(a, ri)) & 255) as u8);
          ri += 1;
        }
        unsafe {
          return v_string(string_from_bytes_unchecked(raw));
        }
      },
      _ => {
        return v_err("string_from_bytes_unchecked: arg must be an array");
      }
    }
  }
  if (name == "share_unchecked") {
    if (args.len() != 1) {
      return v_err("share_unchecked: expected 1 arg");
    }
    return args[0];
  }
  if (name == "string_from_bytes_range_unchecked") {
    if (args.len() != 3 || !is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
      return v_err("string_from_bytes_range_unchecked: expected 3 args (bs, from, end)");
    }
    let from = vint_bits(args[1]);
    let end = vint_bits(args[2]);
    match (args[0]) {
      VArr(a) => {
        if (from < 0 || end > arr_len(a) || from > end) {
          return v_err("string_from_bytes_range_unchecked: range out of bounds");
        }
        let raw: u8[] = [];
        let ri = from;
        while (ri < end) {
          raw = raw.append((vint_bits(arr_at(a, ri)) & 255) as u8);
          ri += 1;
        }
        unsafe {
          return v_string(string_from_bytes_unchecked(raw));
        }
      },
      _ => {
        return v_err("string_from_bytes_range_unchecked: arg must be an array");
      }
    }
  }
  if (name == "slice_unchecked") {
    if (args.len() != 3) {
      return v_err("slice_unchecked: expected 3 args (s, a, b)");
    }
    if (!is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
      return v_err("slice_unchecked: bounds must be integers");
    }
    match (args[0]) {
      VString(s) => {
        let sua = vint_bits(args[1]);
        let sub = vint_bits(args[2]);
        if (sua < 0 || sub > s.v.len() || sua > sub) {
          return slice_abort(aborts.str_oob(), "slice_unchecked", sua, sub, s.v.len());
        }
        return v_string(slice_unchecked(s.v, sua, sub));
      },
      _ => {
        return v_err("slice_unchecked: arg must be a string");
      }
    }
  }
  if (is_buf_builtin(name)) {
    return call_buf_builtin(heap, name, args);
  }
  if (is_raw_mem_builtin(name)) {
    return call_raw_mem_builtin(heap, name, args);
  }
  let rt = call_runtime_intrinsic(heap, name, args);
  if (!is_err(rt) || is_abort(rt)) {
    return rt;
  }
  if (name == "__mulhi_u64") {
    if (args.len() != 2 || !is_int_like(args[0]) || !is_int_like(args[1])) {
      return v_err(name + ": expected 2 integer args");
    }
    return v_uint64(interp_mulhi(vint_as_i64(args[0]) as u64, vint_as_i64(args[1]) as u64) as i64);
  }
  if (name == "__clz32" || name == "__ctz32" || name == "__popcount32" || name == "__clz64" || name == "__ctz64" || name == "__popcount64") {
    if (args.len() != 1) {
      return v_err(name + ": expected 1 arg");
    }
    if (!is_int_like(args[0])) {
      return v_err(name + ": arg must be an integer");
    }
    let bits = vint_as_i64(args[0]) as u64;
    return match (name) {
      "__clz32" => v_int(__clz32(bits as u32)),
      "__ctz32" => v_int(__ctz32(bits as u32)),
      "__popcount32" => v_int(__popcount32(bits as u32)),
      "__clz64" => v_int(__clz64(bits)),
      "__ctz64" => v_int(__ctz64(bits)),
      _ => v_int(__popcount64(bits)),
    };
  }
  if (name == "getxattr" || name == "lgetxattr" || name == "setxattr" || name == "lsetxattr"
    || name == "getxattr_bytes" || name == "lgetxattr_bytes" || name == "setxattr_bytes" || name == "lsetxattr_bytes") {
    if (target_arch() == "wasm32") {
      return v_variant("Err", [io_error_value(Unsupported)]);
    } else {
      return call_xattr(heap, name, args);
    }
  }
  if (name == "__count_byte_bytes") {
    return call_count_byte_bytes(args);
  }
  if (name == "__count_below_u64") {
    return call_count_below_u64(args);
  }
  if (name == "__memchr_bytes") {
    return call_memchr_bytes(args);
  }
  if (name == "__rmemchr_bytes") {
    return call_rmemchr_bytes(args);
  }
  if (name == "__sum_bytes_array" || name == "__bsd_sum_bytes") {
    return call_byte_reduction(name, args);
  }
  if (name == "__crc32_cksum_array" || name == "__crc32_ieee_array") {
    return call_crc32_array(name, args);
  }
  if (name == "__scan_set_bytes" || name == "__count_runs_bytes") {
    return call_byte_set_scan(name, args);
  }
  if (name == "__mismatch_bytes") {
    return call_mismatch_bytes(args);
  }
  if (name == "__mismatch_bytes_str") {
    return call_mismatch_bytes_str(args);
  }
  if (name == "__outer_mul_f64") {
    return call_outer_mul_f64(heap, args);
  }
  if (name == "__inner_mul_add_f64") {
    return call_inner_mul_add_f64(heap, args);
  }
  if (name == "__ct_secret" || name == "__ct_public") {
    return v_void();
  }
  if (name == "__bytes_owned") {
    let bs = byte_args(args);
    if (args.len() != 1 || bs.len() != 1) {
      return v_err("__bytes_owned: expected one byte array");
    }
    return byte_value(heap, bs[0]);
  }
  if (name == "__bytes_range") {
    return call_bytes_range(heap, args);
  }
  if (name == "__bytes_into") {
    return call_bytes_into(heap, args);
  }
  if (aes_gcm_arity(name) > 0) {
    return call_aes_gcm(heap, name, args);
  }
  if (is_byte_into_kernel(name)) {
    return call_byte_into_kernel(heap, name, args);
  }
  if (name == "__mont_mul") {
    return call_mont_mul(heap, args);
  }
  if (name == "__scrypt_block_mix") {
    return call_scrypt_block_mix(heap, args);
  }
  if (args.len() == 0 && checker.is_sha_hw_builtin(name)) {
    return v_bool(false);
  }
  if (args.len() == 2 && is_sha_blocks_name(name)) {
    return byte_value(heap, []);
  }
  if (name == "__scale_f64") {
    return call_scale_f64(heap, args);
  }
  if (name == "__scan_set") {
    if (args.len() != 3) {
      return v_err("__scan_set: expected 3 args (s, from, set)");
    }
    if (!is_string_arg(args[0]) || !is_i32_arg(args[1])) {
      return v_err("__scan_set: s must be a string and from an integer");
    }
    let ss = vstr_of(args[0]);
    let si = vint_bits(args[1]);
    if (si < 0) {
      si = 0;
    }
    match (args[2]) {
      VArr(set) => {
        while (si < ss.len()) {
          let sb = ss[si] as i32;
          if (sb < arr_len(set) && vint_bits(arr_at(set, sb)) != 0) {
            return v_int(si);
          }
          si += 1;
        }
        return v_int(ss.len());
      },
      _ => {
        return v_err("__scan_set: set must be a u8[]");
      }
    }
  }
  if (name == "__bsd_sum") {
    if (args.len() != 2) {
      return v_err("__bsd_sum: expected 2 args (s, sum)");
    }
    if (!is_string_arg(args[0]) || !is_i32_arg(args[1])) {
      return v_err("__bsd_sum: s must be a string and sum an integer");
    }
    let bs = vstr_of(args[0]);
    let sum = vint_bits(args[1]) & 65535;
    for bi in 0..bs.len() {
      sum = (sum >> 1 | sum << 15) & 65535;
      sum = sum + bs[bi] as i32 & 65535;
    }
    return v_int(sum);
  }
  if (name == "__str_hash") {
    if (args.len() != 2) {
      return v_err("__str_hash: expected 2 args (s, seed)");
    }
    if (!is_string_arg(args[0]) || !is_i32_arg(args[1])) {
      return v_err("__str_hash: s must be a string and seed an integer");
    }
    let hs = vstr_of(args[0]);
    let hn = hs.len();
    let h = -3750763034362895579i64 ^ vint_bits(args[1]) as i64 ^ hn as i64;
    let hi = 0;
    while (hi + 8 <= hn) {
      h = (h ^ str_hash_word(hs, hi, 8)) * 1099511628211i64;
      hi += 8;
    }
    if (hi < hn) {
      if (hn >= 8) {
        h = (h ^ str_hash_word(hs, hn - 8, 8)) * 1099511628211i64;
      } else {
        h = (h ^ str_hash_word(hs, 0, hn)) * 1099511628211i64;
      }
    }
    h = h ^ (h as u64 >> 33u64) as i64;
    h = h * -49064778989728563i64;
    h = h ^ (h as u64 >> 33u64) as i64;
    h = h * -4265267296055464877i64;
    h = h ^ (h as u64 >> 33u64) as i64;
    return v_int(str_hash_low32(h));
  }
  if (name == "__count_runs") {
    if (args.len() != 3) {
      return v_err("__count_runs: expected 3 args (s, inside, set)");
    }
    if (!is_string_arg(args[0]) || !is_i32_arg(args[1])) {
      return v_err("__count_runs: s must be a string and inside an integer");
    }
    let rs = vstr_of(args[0]);
    let prev = vint_bits(args[1]) != 0;
    match (args[2]) {
      VArr(set) => {
        let runs = 0;
        let ri = 0;
        while (ri < rs.len()) {
          let rb = rs[ri] as i32;
          let member = rb < arr_len(set) && vint_bits(arr_at(set, rb)) != 0;
          if (member && !prev) {
            runs += 1;
          }
          prev = member;
          ri += 1;
        }
        return v_int(runs);
      },
      _ => {
        return v_err("__count_runs: set must be a u8[]");
      }
    }
  }
  if (name == "__memchr" || name == "__count_byte" || name == "__sum_bytes") {
    let cb = name == "__count_byte";
    let sb = name == "__sum_bytes";
    if (sb) {
      if (args.len() != 1) {
        return v_err("__sum_bytes: expected 1 arg (s)");
      }
    } else if (cb) {
      if (args.len() != 2) {
        return v_err("__count_byte: expected 2 args (s, byte)");
      }
      if (!is_i32_arg(args[1])) {
        return v_err("__count_byte: byte must be an integer");
      }
    } else {
      if (args.len() != 3) {
        return v_err("__memchr: expected 3 args (s, byte, from)");
      }
      if (!is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
        return v_err("__memchr: byte and start must be integers");
      }
    }
    match (args[0]) {
      VString(s) => {
        if (sb) {
          let si = 0;
          let sacc = 0;
          while (si < s.v.len()) {
            sacc = sacc + s.v[si] as i32;
            si += 1;
          }
          return v_int(sacc);
        }
        let want = vint_bits(args[1]);
        if (cb) {
          if (want < 0 || want > 255) {
            return v_int(0);
          }
          let ci = 0;
          let cn = 0;
          while (ci < s.v.len()) {
            if (s.v[ci] as i32 == want) {
              cn += 1;
            }
            ci += 1;
          }
          return v_int(cn);
        }
        if (want < 0 || want > 255) {
          return v_int(-1);
        }
        let mi = vint_bits(args[2]);
        if (mi < 0) {
          mi = 0;
        }
        while (mi < s.v.len()) {
          if (s.v[mi] as i32 == want) {
            return v_int(mi);
          }
          mi += 1;
        }
        return v_int(-1);
      },
      _ => {
        return v_err("__memchr: first arg must be a string");
      }
    }
  }
  if (name == "__rmemchr") {
    if (args.len() != 3) {
      return v_err("__rmemchr: expected 3 args (s, byte, from)");
    }
    if (!is_i32_arg(args[1]) || !is_i32_arg(args[2])) {
      return v_err("__rmemchr: byte and start must be integers");
    }
    match (args[0]) {
      VString(s) => {
        let rwant = vint_bits(args[1]);
        if (rwant < 0 || rwant > 255) {
          return v_int(-1);
        }
        let ri = vint_bits(args[2]);
        if (ri > s.v.len() - 1) {
          ri = s.v.len() - 1;
        }
        while (ri >= 0) {
          if (s.v[ri] as i32 == rwant) {
            return v_int(ri);
          }
          ri -= 1;
        }
        return v_int(-1);
      },
      _ => {
        return v_err("__rmemchr: first arg must be a string");
      }
    }
  }
  if (name == "__crc32_cksum") {
    if (args.len() != 2) {
      return v_err("__crc32_cksum: expected 2 args (crc, s)");
    }
    if (!is_i32_arg(args[0])) {
      return v_err("__crc32_cksum: crc must be an integer");
    }
    match (args[1]) {
      VString(s) => {
        let crc = vint_bits(args[0]);
        for ci in 0..s.v.len() {
          crc = crc32_cksum_byte(crc, s.v[ci] as i32);
        }
        return v_int(crc);
      },
      _ => {
        return v_err("__crc32_cksum: second arg must be a string");
      }
    }
  }
  if (name == "__mismatch") {
    if (args.len() != 5) {
      return v_err("__mismatch: expected 5 args (a, ao, b, bo, n)");
    }
    if (!is_string_arg(args[0]) || !is_string_arg(args[2])) {
      return v_err("__mismatch: first and third args must be strings");
    }
    if (!is_i32_arg(args[1]) || !is_i32_arg(args[3]) || !is_i32_arg(args[4])) {
      return v_err("__mismatch: offsets and length must be integers");
    }
    let ma = vstr_of(args[0]);
    let mb = vstr_of(args[2]);
    let mao = clamp_offset(vint_bits(args[1]), ma.len());
    let mbo = clamp_offset(vint_bits(args[3]), mb.len());
    let mn = vint_bits(args[4]);
    if (mn > ma.len() - mao) {
      mn = ma.len() - mao;
    }
    if (mn > mb.len() - mbo) {
      mn = mb.len() - mbo;
    }
    if (mn < 0) {
      mn = 0;
    }
    for mk in 0..mn {
      if (ma[mao + mk] != mb[mbo + mk]) {
        return v_int(mk);
      }
    }
    return v_int(mn);
  }
  if (name == "__ascii_run") {
    if (args.len() != 2) {
      return v_err("__ascii_run: expected 2 args (s, from)");
    }
    if (!is_i32_arg(args[1])) {
      return v_err("__ascii_run: start must be an integer");
    }
    match (args[0]) {
      VString(s) => {
        let ai = vint_bits(args[1]);
        if (ai < 0) {
          ai = 0;
        }
        while (ai < s.v.len()) {
          if (s.v[ai] as i32 >= 128) {
            return v_int(ai);
          }
          ai += 1;
        }
        return v_int(s.v.len());
      },
      _ => {
        return v_err("__ascii_run: first arg must be a string");
      }
    }
  }
  if (name == "__arr_set_len") {
    if (args.len() != 2 || !is_i32_arg(args[1])) {
      return v_err("__arr_set_len: expected an array and a length");
    }
    if let VArr(a) = args[0] {
      let n = vint_bits(args[1]);
      let slots = arr_slots(a);
      if (n < 0 || n > slots.len()) {
        return v_err("__arr_set_len: length exceeds reserved storage");
      }
      arr_store_set(a, n, slots);
      return v_void();
    }
    return v_err("__arr_set_len: expected an array");
  }
  if (name == "cell_new") {
    if (args.len() != 1) {
      return v_err("cell_new takes exactly 1 argument");
    }
    return cell_value(heap, args[0]);
  }
  if (name == "f64_bits") {
    if (args.len() != 1 || !is_float_like(args[0])) {
      return v_err("f64_bits: expected 1 float arg");
    }
    return box_i64(f64_bits(vfloat_as_f64(args[0])));
  }
  if (name == "f64_from_bits") {
    if (args.len() != 1 || !is_int_like(args[0])) {
      return v_err("f64_from_bits: expected 1 integer arg");
    }
    return v_float(f64_from_bits(vint_as_i64(args[0])));
  }
  if (name == "f32_bits") {
    if (args.len() != 1 || !is_float_like(args[0])) {
      return v_err("f32_bits: expected 1 float arg");
    }
    return v_int(f32_bits(vfloat_as_f64(args[0]) as f32));
  }
  if (name == "f32_from_bits") {
    if (args.len() != 1 || !is_i32_arg(args[0])) {
      return v_err("f32_from_bits: expected 1 integer arg");
    }
    return v_float32(f32_from_bits(vint_bits(args[0])) as f64);
  }
  for at in funcs.named(name) {
    let fd = funcs.decls[at];
    if (fd.name == name && fd.receiver_type.len() == 0) {
      if (args.len() != fd.params.len()) {
        return v_err("arity mismatch calling `" + name + "`");
      }
      let env = Env { ...new_module_env(heap, funcs, aliases, type_decls), ret: fd.ret_type };
      let no_recv = v_absent();
      env = bind_tyargs(env, fd, false, no_recv, args, type_args, expect);
      for j in 0..fd.params.len() {
        env = env.bind_decl(fd.params[j].name, args[j], fd.params[j].type_name);
      }
      let step = call_block(heap, fd.body, unsafe { share_unchecked(env) });
      if (step.sig != 1) {
        return v_void();
      }
      return coerce_int_width(unwrap_try(step.ret), fd.ret_type);
    }
  }
  return call_host(heap, name, args);
}

function value_eq(a: Value, b: Value): boolean {
  match (a) {
    VInt(ai) => {
      match (b) {
        VInt(bi) => {
          return ai.v == bi.v;
        },
        VInt64(bi) => {
          return ai.v as i64 == unpack_i64(bi);
        },
        VUint(bu) => {
          return ai.v == bu.v;
        },
        _ => {
          return false;
        }
      }
    },
    VInt64(ai) => {
      match (b) {
        VInt(bi) => {
          return unpack_i64(ai) == bi.v as i64;
        },
        VInt64(bi) => {
          return ai.hi == bi.hi && ai.lo == bi.lo;
        },
        VUint(bu) => {
          return unpack_i64(ai) == uint_zext(bu.v);
        },
        _ => {
          return false;
        }
      }
    },
    VUint(au) => {
      match (b) {
        VUint(bu) => {
          return au.v == bu.v;
        },
        VInt(bi) => {
          return au.v == bi.v;
        },
        VInt64(bi) => {
          return uint_zext(au.v) == unpack_i64(bi);
        },
        _ => {
          return false;
        }
      }
    },
    VBool(ab) => {
      match (b) {
        VBool(bb) => {
          return ab.v == bb.v;
        },
        _ => {
          return false;
        }
      }
    },
    VString(av) => {
      match (b) {
        VString(bs) => {
          return av.v == bs.v;
        },
        _ => {
          return false;
        }
      }
    },
    VFloat(af) => {
      match (b) {
        VFloat(bf) => {
          return af.v == bf.v;
        },
        VFloat32(bf) => {
          return af.v == bf.v;
        },
        _ => {
          return false;
        }
      }
    },
    VFloat32(af) => {
      match (b) {
        VFloat32(bf) => {
          return af.v == bf.v;
        },
        VFloat(bf) => {
          return af.v == bf.v;
        },
        _ => {
          return false;
        }
      }
    },
    VArr(aa) => {
      match (b) {
        VArr(ba) => {
          if (arr_len(aa) != arr_len(ba)) {
            return false;
          }
          let ai = 0;
          while (ai < arr_len(aa)) {
            if (!value_eq(arr_at(aa, ai), arr_at(ba, ai))) {
              return false;
            }
            ai += 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    VFunc(_) => {
      return false;
    },
    VLanes(_) => {
      return false;
    },
    VMap(_) => {
      return false;
    },
    VStruct(asv) => {
      match (b) {
        VStruct(bsv) => {
          if (asv.type_name != bsv.type_name) {
            return false;
          }
          if (asv.field_values.len() != bsv.field_values.len()) {
            return false;
          }
          for si in 0..asv.field_values.len() {
            if (!value_eq(asv.field_values[si], bsv.field_values[si])) {
              return false;
            }
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    VTuple(at) => {
      match (b) {
        VTuple(bt) => {
          if (at.elements.len() != bt.elements.len()) {
            return false;
          }
          for ti in 0..at.elements.len() {
            if (!value_eq(at.elements[ti], bt.elements[ti])) {
              return false;
            }
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    VCellV(_) => {
      return false;
    },
    VCell(_) => {
      return false;
    },
    VErr(_) => {
      return false;
    },
    VTry(_) => {
      return false;
    },
    VControl(_) => {
      return false;
    },
    VType(_) => {
      return false;
    },
    VHandle(ah) => {
      if let VHandle(bh) = b {
        return handle_kind(ah) == handle_kind(bh) && value_eq(handle_fd(ah), handle_fd(bh));
      }
      return false;
    }
  }
}

pub struct StepResult { env: Env, ret: Value, sig: i32 }

function step_none(env: Env): StepResult {
  return StepResult { env: env, ret: VErr { msg: "", abort: false }, sig: 0 };
}

function step_stop(env: Env, v: Value): StepResult {
  if let VControl(control) = v {
    return StepResult { env: env, ret: control.box, sig: control.sig };
  }
  return StepResult { env: env, ret: v, sig: 1 };
}

function eval_value_body(body: ast.Stmt[], own env: Env, expect: string): StepResult {
  if (body.len() == 0) {
    return step_stop(env, v_err("value expression has no terminal value"));
  }
  let cur = env;
  let assigned = body_assign_names(body, []);
  for i in 0..body.len() - 1 {
    cur = cellify_captures(cur, body[i], assigned);
    let step = eval_stmt(body[i], unsafe { share_unchecked(cur) });
    if (step.sig != 0) {
      return step;
    }
    cur = step.env;
  }
  match (body[body.len() - 1]) {
    ast.StmtReturn(r) => {
      let value = v_void();
      if let ast.ExprCall(call) = r.value {
        value = eval_expr_call_expect(call, cur, expect);
      } else {
        value = eval_expr(r.value, cur);
      }
      if (is_err(value)) {
        return step_stop(cur, value);
      }
      return StepResult { env: cur, ret: value, sig: 0 };
    },
    ast.StmtIf(branch) => {
      let condition = eval_expr(branch.cond, cur);
      if (is_err(condition)) {
        return step_stop(cur, condition);
      }
      let yes = false;
      match (condition) {
        VBool(b) => {
          yes = b.v;
        },
        VInt(n) => {
          yes = n.v != 0;
        },
        _ => {
          return step_stop(cur, v_err("value condition is not boolean"));
        }
      }
      if (yes) {
        return eval_value_body(branch.then_body, unsafe { share_unchecked(cur) }, expect);
      }
      return eval_value_body(branch.else_body, unsafe { share_unchecked(cur) }, expect);
    },
    ast.StmtMatch(m) => {
      return eval_match_stmt_mode(m, unsafe { share_unchecked(cur) }, true, expect);
    },
    _ => {
      return step_stop(cur, v_err("value expression has no terminal value"));
    }
  }
}

@noinline
function eval_while_stmt(w: ast.StmtWhile, own env: Env): StepResult {
  let base = env.depth;
  let cur = env;
  let scoped = body_binds(w.body);
  while (true) {
    let cv = eval_expr(w.cond, cur);
    if (is_err(cv)) {
      return step_stop(cur, cv);
    }
    match (cv) {
      VBool(b) => {
        if (!b.v) {
          return step_none(cur);
        }
      },
      _ => {
        return step_stop(cur, v_err("while cond not bool"));
      }
    }
    let step = eval_block(w.body, scope_env(Env { ...cur }, scoped));
    if (step.sig == 2) {
      return step_none(trim_env(unsafe { share_unchecked(step.env) }, base));
    }
    if (step.sig == 3) {
      cur = trim_env(Env { ...step.env }, base);
      continue;
    }
    if (step.sig == 1) {
      return step;
    }
    if (step.sig > 3) {
      return StepResult { env: trim_env(unsafe { share_unchecked(step.env) }, base), ret: step.ret, sig: step.sig - 2 };
    }
    cur = trim_env(step.env, base);
  }
}

@noinline
function eval_match_stmt(m: ast.StmtMatch, own env: Env): StepResult {
  return eval_match_stmt_mode(m, env, false, "");
}

// payload_decl_type is the declared type of payload k of the variant
// `vname`, with the arguments of the scrutinee's static type put in:
// `Ring[4, string]` for the payload `Ring[N, T]` of `Full` in a
// `Slot[4, string]`.
function payload_decl_type(env: Env, pattern: string, vname: string, k: i32, scrutinee: ast.Expr): string {
  let r = parser.parse_type_ref(bound_type_spelling(env.static_type_of(scrutinee), env));
  let owner = r.base;
  let simple = parser.derive_simple_name(pattern);
  if (simple.len() < pattern.len()) {
    owner = slice_unchecked(pattern, 0, pattern.len() - simple.len() - 1).to_owned();
  }
  let only: i32 = -1;
  let many = false;
  for i in 0..env.type_decls.len() {
    let sd = env.type_decls[i];
    if (sd.name == vname && sd.enum_owner.len() > 0 && k < sd.fields.len()) {
      if (sd.enum_owner == r.base) {
        return applied_spelling(sd.fields[k].type_name, decl_type_params(env.type_decls, env.aliases, sd.enum_owner), r.args);
      }
      if (sd.enum_owner == owner) {
        return bound_type_spelling(sd.fields[k].type_name, env);
      }
      many = only >= 0;
      only = i;
    }
  }
  if (only >= 0 && !many && owner.len() == 0) {
    return bound_type_spelling(env.type_decls[only].fields[k].type_name, env);
  }
  return "";
}

function match_test_passes(value: Value): boolean {
  if let VBool(test) = value {
    return test.v;
  }
  return false;
}

function eval_match_stmt_mode(m: ast.StmtMatch, own env: Env, value_form: boolean, expect: string): StepResult {
  let sv = eval_expr(m.scrutinee, env);
  if (is_err(sv)) {
    return step_stop(env, sv);
  }
  for i in 0..m.arms.len() {
    let arm = m.arms[i];
    let matched = false;
    let bind_names: string[] = [];
    let bind_values: Value[] = [];
    let bind_types: string[] = [];
    match (arm.pattern) {
      ast.PatLiteral(literal) => {
        let low = eval_expr(literal.lit, env);
        if (is_err(low)) {
          return step_stop(env, low);
        }
        matched = match_test_passes(eval_binary("==", sv, low));
        if (literal.has_range) {
          let high = eval_expr(literal.range_hi, env);
          if (is_err(high)) {
            return step_stop(env, high);
          }
          let upper: string = if (literal.range_inclusive) { "<=" } else { "<" };
          matched = match_test_passes(eval_binary(">=", sv, low)) && match_test_passes(eval_binary(upper, sv, high));
        }
        if (matched && literal.at_binding.len() > 0) {
          bind_names = bind_names.append(literal.at_binding);
          bind_values = bind_values.append(sv);
          bind_types = bind_types.append("");
        }
      },
      ast.PatWildcard(_) => {
        matched = true;
      },
      ast.PatVariant(pv) => {
        if (pv.scalar_binding) {
          matched = true;
          bind_names = bind_names.append(pv.type_name);
          bind_values = bind_values.append(sv);
          bind_types = bind_types.append("");
          if (pv.at_binding.len() > 0) {
            bind_names = bind_names.append(pv.at_binding);
            bind_values = bind_values.append(sv);
            bind_types = bind_types.append("");
          }
        }
        if (pv.type_name == "true" || pv.type_name == "false") {
          match (sv) {
            VBool(bv) => {
              if (pv.type_name == "true" && bv.v) {
                matched = true;
              }
              if (pv.type_name == "false" && !bv.v) {
                matched = true;
              }
            },
            _ => {}
          }
        }
        match (sv) {
          VStruct(vs) => {
            if (vs.type_name == pv.type_name || vs.type_name == parser.derive_simple_name(pv.type_name)) {
              matched = true;
              let is_payload = vs.field_names.len() > 0 && vs.field_names[0] == "__ev";
              if (pv.at_binding.len() > 0) {
                bind_names = bind_names.append(pv.at_binding);
                bind_values = bind_values.append(sv);
                bind_types = bind_types.append("");
              }
              if (is_payload) {
                let pat_binds: string[] = [];
                if (pv.binding.len() > 0) {
                  pat_binds = pat_binds.append(pv.binding);
                }
                for xi in 0..pv.extra_bindings.len() {
                  pat_binds = pat_binds.append(pv.extra_bindings[xi]);
                }
                let pbi = 0;
                while (pbi < pat_binds.len() && pbi < vs.field_values.len()) {
                  if (pat_binds[pbi] != "_") {
                    bind_names = bind_names.append(pat_binds[pbi]);
                    bind_values = bind_values.append(vs.field_values[pbi]);
                    bind_types = bind_types.append(payload_decl_type(env, pv.type_name, vs.type_name, pbi, m.scrutinee));
                  }
                  pbi += 1;
                }
              } else {
                if (pv.binding.len() > 0 && pv.binding != "_") {
                  bind_names = bind_names.append(pv.binding);
                  bind_values = bind_values.append(sv);
                  bind_types = bind_types.append("");
                }
              }
            }
          },
          _ => {}
        }
      }
    }
    if (matched) {
      let base = env.depth;
      let bodyEnv = scope_env(Env { ...env }, bind_names.len() > 0 || body_binds(arm.body));
      for bk in 0..bind_names.len() {
        bodyEnv = bodyEnv.bind_decl(bind_names[bk], bind_values[bk], bind_types[bk]);
      }
      let reassigned = body_assign_names(arm.body, []);
      for st in arm.body {
        bodyEnv = cellify_captures(bodyEnv, st, reassigned);
      }
      if (arm.has_guard) {
        let guard_stmt: ast.Stmt = ast.StmtExpr { value: arm.guard, line: arm.line, op: "" };
        bodyEnv = cellify_captures(bodyEnv, guard_stmt, reassigned);
      }
      let pass = true;
      if (arm.has_guard) {
        let gv = eval_expr(arm.guard, bodyEnv);
        if (is_err(gv)) {
          return step_stop(trim_env(unsafe { share_unchecked(bodyEnv) }, base), gv);
        }
        match (gv) {
          VBool(gb) => {
            pass = gb.v;
          },
          _ => {
            pass = false;
          }
        }
      }
      if (pass) {
        let step: StepResult = if (value_form) { eval_value_body(arm.body, unsafe { share_unchecked(bodyEnv) }, expect) } else { eval_block(arm.body, unsafe { share_unchecked(bodyEnv) }) };
        return StepResult { env: trim_env(Env { ...step.env }, base), ret: step.ret, sig: step.sig };
      }
    }
  }
  return step_stop(env, v_err("non-exhaustive match"));
}

@noinline
function eval_for_stmt(f: ast.StmtFor, own env: Env): StepResult {
  let iv = eval_expr(f.iter, env);
  if (is_err(iv)) {
    return step_stop(env, iv);
  }
  let elems: Value[] = [];
  match (for_elements(iv)) {
    Some(walked) => {
      elems = walked;
    },
    None => {
      return eval_iterator_for(f, iv, env);
    }
  }
  let elem_ty = "";
  let iter_ty = env.static_type_of(f.iter);
  if (name_ends_with(iter_ty, "[]")) {
    elem_ty = slice_unchecked(iter_ty, 0, iter_ty.len() - 2).to_owned();
  }
  if (elem_ty.len() == 0) {
    if let VArr(a) = iv {
      elem_ty = a.elem;
    }
    if let VString(_) = iv {
      elem_ty = "u8";
    }
  }
  let base = env.depth;
  let cur = env;
  let i = 0;
  while (i < elems.len()) {
    let iter_env = bind_element(scope_env(Env { ...cur }, true), f.var_name, elems[i], elem_ty);
    let step = eval_block(f.body, unsafe { share_unchecked(iter_env) });
    if (step.sig == 2) {
      return step_none(trim_env(unsafe { share_unchecked(step.env) }, base));
    }
    if (step.sig == 3) {
      cur = trim_env(Env { ...step.env }, base);
      i += 1;
      continue;
    }
    if (step.sig == 1) {
      return step;
    }
    if (step.sig > 3) {
      return StepResult { env: trim_env(unsafe { share_unchecked(step.env) }, base), ret: step.ret, sig: step.sig - 2 };
    }
    cur = trim_env(step.env, base);
    i += 1;
  }
  return step_none(cur);
}

pub function eval_stmt(st: ast.Stmt, own env: Env): StepResult {
  match (st) {
    ast.StmtDefer(d) => {
      return eval_stmt(d.action, env);
    },
    ast.StmtVar(v) => {
      let val = eval_var_init(v, env);
      if (is_err(val)) {
        return step_stop(env, val);
      }
      if (util.contains(v.name, ",") || parser.is_destr_marker(v.type_name)) {
        return destructure_step(env, v, val);
      }
      let declared = v.type_name;
      if (declared.len() == 0) {
        declared = env.static_type_of(v.init);
      }
      let env2 = env.bind_decl(v.name, val, declared);
      return step_none(env2);
    },
    ast.StmtReturn(r) => {
      if (parser.bare_return(r.value)) {
        return step_stop(env, v_void());
      }
      if let ast.ExprCall(rc) = r.value {
        return step_stop(env, eval_expr_call_expect(rc, env, bound_type_spelling(env.ret, env)));
      }
      let val = eval_expr(r.value, env);
      return step_stop(env, val);
    },
    ast.StmtExpr(x) => {
      let val = eval_expr(x.value, env);
      if (is_err(val)) {
        return step_stop(env, val);
      }
      return step_none(env);
    },
    ast.StmtIf(ifs) => {
      let cv = eval_expr(ifs.cond, env);
      if (is_err(cv)) {
        return step_stop(env, cv);
      }
      match (cv) {
        VInt(civ) => {
          cv = VBool { v: civ.v != 0 };
        },
        _ => {}
      }
      match (cv) {
        VBool(b) => {
          let body = ifs.else_body;
          if (b.v) {
            body = ifs.then_body;
          }
          let base = env.depth;
          let step = eval_block(body, scope_env(env, body_binds(body)));
          return StepResult { env: trim_env(step.env, base), ret: step.ret, sig: step.sig };
        },
        _ => {
          return step_stop(env, v_err("if cond not bool"));
        }
      }
      return step_stop(env, v_err("unreachable if-arm"));
    },
    ast.StmtWhile(w) => {
      return eval_while_stmt(w, env);
    },
    ast.StmtAssign(a) => {
      return eval_assign_stmt(a, env);
    },
    ast.StmtMatch(m) => {
      return eval_match_stmt(m, env);
    },
    ast.StmtBreak(b) => {
      return StepResult { env: env, ret: VErr { msg: "", abort: false }, sig: 2 + b.tag * 2 };
    },
    ast.StmtContinue(c) => {
      return StepResult { env: env, ret: VErr { msg: "", abort: false }, sig: 3 + c.tag * 2 };
    },
    ast.StmtFor(f) => {
      return eval_for_stmt(f, env);
    },
    ast.StmtUnknown(u) => {
      return step_stop(env, v_err("parser-side unknown stmt: " + u.kind));
    }
  }
}

function eval_assign_stmt(a: ast.StmtAssign, own env: Env): StepResult {
  if (in_place_array_write(a, env)) {
    return write_array_in_place(a, env);
  }
  let av = eval_expr(a.value, env);
  if (is_err(av)) {
    return step_stop(env, av);
  }
  if (!env.binds_name(a.target)) {
    return step_stop(env, v_err("assign to undefined `" + a.target + "`"));
  }
  match (env.raw_value(a.target)) {
    Some(value) => {
      if (cell_slot_set(value, av)) {
        return step_none(env);
      }
    },
    None => {}
  }
  return step_none(env.update(a.target, av));
}

// `x = x.with(i, v)` and `x = x.append(v)`, or a chain of them on x, release
// x's slot before the writes, so an array that no other value holds is updated
// in place. The check reads env and the write takes it, so the write holds
// env's only reference.
function in_place_array_write(a: ast.StmtAssign, env: Env): boolean {
  if (array_write_chain(a.value, a.target).len() == 0) {
    return false;
  }
  let value = match (env.raw_value(a.target)) { Some(v) => v, None => { return false; } };
  let VArr(av) = value else {
    return false;
  };
  if (av.view || interpheap.get(av.store).words.len() > 0) {
    return false;
  }
  let (fd, known) = call_target("with", true, false, value, env);
  let (fd2, known2) = call_target("append", true, false, value, env);
  return !known && !known2;
}

// The `.with` and `.append` calls of e, innermost first, when e chains them on
// the variable `target`. Empty for any other expression.
function array_write_chain(e: ast.Expr, target: string): ast.ExprCall[] {
  let ast.ExprCall(c) = e else {
    return [];
  };
  let ast.ExprFieldAccess(fa) = c.callee else {
    return [];
  };
  if (fa.field != "with" && fa.field != "append" || c.type_args.len() > 0) {
    return [];
  }
  if let ast.ExprIdent(id) = fa.obj {
    if (id.name == target) {
      return [c];
    }
    return [];
  }
  let inner = array_write_chain(fa.obj, target);
  if (inner.len() == 0) {
    return [];
  }
  return inner.append(c);
}

function write_array_in_place(a: ast.StmtAssign, own env: Env): StepResult {
  let calls = array_write_chain(a.value, a.target);
  let names: string[] = [];
  let args: Value[][] = [];
  for c in calls {
    let ast.ExprFieldAccess(fa) = c.callee else {
      return step_stop(env, v_err("in-place write: not a method call"));
    };
    let vs: Value[] = [];
    for arg in c.args {
      let v = eval_expr(arg, env);
      if (is_err(v)) {
        return step_stop(env, v);
      }
      vs = vs.append(v);
    }
    names = names.append(fa.field);
    args = args.append(vs);
  }
  let cur = match (env.raw_value(a.target)) { Some(v) => v, None => { return step_stop(env, v_err("in-place write: missing binding")); } };
  let heap = env.heap;
  let released = env.update(a.target, v_int(0));
  for i in 0..names.len() {
    let VArr(av) = cur else {
      return step_stop(released, v_err("in-place write: not an array"));
    };
    let Some(out) = array_method(heap, unsafe { share_unchecked(VArr { ...av }) }, names[i], args[i]) else {
      return step_stop(released, v_err("in-place write: not an array method"));
    };
    if (is_err(out)) {
      return step_stop(released, out);
    }
    cur = out;
  }
  return step_none(released.update(a.target, cur));
}

function for_elements(iv: Value): Option[Value[]] {
  let elems: Value[] = [];
  match (iv) {
    VArr(a) => {
      return Some(arr_els(a));
    },
    VString(sv) => {
      for b in sv.v {
        elems = elems.append(v_byte(b as i32));
      }
      return Some(elems);
    },
    VMap(m) => {
      for i in 0..m.keys.len() {
        elems = elems.append(v_tuple([m.keys[i], m.values[i]]));
      }
      return Some(elems);
    },
    _ => {
      return None;
    }
  }
}

function bind_element(env: Env, header: string, elem: Value, elem_ty: string): Env {
  if (util.contains(header, ",")) {
    let (out, err) = bind_destructure(env, header, "", elem);
    if (!is_err(err)) {
      return out;
    }
  }
  return env.bind_decl(header, elem, elem_ty);
}

function eval_iterator_for(f: ast.StmtFor, iv: Value, own env: Env): StepResult {
  let held: ast.Expr = ast.ExprIdent { name: "$for_subject", line: 0, col: 0, ty: "", builtin: false };
  let subject: ast.Expr = held;
  if (!receiver_has_method(env.funcs, iv, "next")) {
    if (!receiver_has_method(env.funcs, iv, "iter")) {
      return step_stop(env, v_err("for-in iter is not iterable"));
    }
    subject = ast.ExprCall { callee: ast.ExprFieldAccess { obj: held, field: "iter", line: 0, col: 0, ty: "", const_read: false }, args: [], line: 0, col: 0, type_args: [], ty: "" };
  }
  let base = env.depth;
  let step = eval_stmt(parser.iterator_loop(f, subject, 0), unsafe { share_unchecked(scope_env(env, true).bind("$for_subject", iv)) });
  return StepResult { env: trim_env(step.env, base), ret: step.ret, sig: step.sig };
}

function receiver_has_method(funcs: Funcs, recv: Value, name: string): boolean {
  let rt = value_type_name(recv);
  for at in funcs.named(name) {
    let fd = funcs.decls[at];
    if ((fd.name == name || runtime_method_name(fd) == name) && fd.receiver_name.len() > 0 && runtime_receiver_name(fd.receiver_type) == rt) {
      return true;
    }
  }
  return false;
}

function body_binds(body: ast.Stmt[]): boolean {
  for st in body {
    if (stmt_binds(st)) {
      return true;
    }
  }
  return false;
}

function stmt_binds(st: ast.Stmt): boolean {
  return match (st) { ast.StmtVar(_) => true, ast.StmtDefer(d) => stmt_binds(d.action), _ => false };
}

function scope_env(own e: Env, needed: boolean): Env {
  if (!needed) {
    return e;
  }
  return unsafe { share_unchecked(Env { ...e, outer: Some(e), depth: e.depth + 1, names: [], values: [], types: [] }) };
}

function trim_env(own e: Env, base: i32): Env {
  let out = e;
  while (out.depth > base) {
    match (out.outer) {
      Some(parent) => {
        out = parent;
      },
      None => {
        return out;
      }
    }
  }
  return out;
}

function flattened_env(e: Env): Env {
  if (e.depth == 0) {
    return e;
  }
  let frames: Env[] = [];
  let cursor = Some(e);
  while (true) {
    match (cursor) {
      Some(frame) => {
        frames = frames.append(frame);
        cursor = frame.outer;
      },
      None => {
        break;
      }
    }
  }
  let names: string[] = [];
  let values: Value[] = [];
  let types: string[] = [];
  let i = frames.len();
  while (i > 0) {
    i -= 1;
    names = util.append_all(names, frames[i].names);
    values = util.append_all(values, frames[i].values);
    types = util.append_all(types, frames[i].types);
  }
  return Env { ...e, outer: None, depth: 0, names: names, values: values, types: types };
}

function eval_block(body: ast.Stmt[], own env: Env): StepResult {
  let cur = env;
  let reassigned = body_assign_names(body, []);
  for i in 0..body.len() {
    cur = cellify_captures(cur, body[i], reassigned);
    let r = eval_stmt(body[i], cur);
    cur = r.env;
    if (r.sig != 0) {
      return StepResult { env: cur, ret: r.ret, sig: r.sig };
    }
  }
  return step_none(cur);
}

pub function exit_status(v: Value): (boolean, i32) {
  match (v) {
    VInt(iv) => {
      return (true, iv.v);
    },
    VInt64(lv) => {
      return (true, lv.lo);
    },
    VUint(uv) => {
      return (true, uv.v);
    },
    VBool(bv) => {
      if (bv.v) {
        return (true, 1);
      }
      return (true, 0);
    },
    _ => {
      return (false, 0);
    }
  }
}

pub function eval_module(raw_mod: parser.Module): Value {
  let dash: string[] = ["-"];
  return eval_module_argv(raw_mod, dash);
}

pub function eval_module_argv(raw_mod: parser.Module, argv: string[]): Value {
  let heap = interpheap.create();
  set_args(argv);
  let mod = lowered(raw_mod);
  let all_variants = module_type_decls(mod.structs);
  let all_aliases = aliases_with_enums(mod.aliases, all_variants, mod.enums);
  let funcs = funcs_of(mod.funcs);
  if (funcs.named("main").len() > 0) {
    let empty_args: Value[] = [];
    return call_func(heap, "main", empty_args, funcs, all_aliases, all_variants);
  }
  let env = new_module_env(heap, funcs, all_aliases, all_variants);
  let mreassigned = body_assign_names(mod.top_stmts, []);
  for j in 0..mod.top_stmts.len() {
    env = cellify_captures(env, mod.top_stmts[j], mreassigned);
    let r = eval_stmt(mod.top_stmts[j], unsafe { share_unchecked(env) });
    env = r.env;
    if (r.sig != 0) {
      return r.ret;
    }
  }
  return v_err("module has no `main` and no top-level `return`");
}

pub struct Session { decls: parser.Module, env: Env }

pub function new_session(): Session {
  let heap = interpheap.create();
  set_args(["-"]);
  return Session { decls: parser.parse_module(lexer.tokenize("")), env: new_module_env(heap, funcs_of([]), [], module_type_decls([])) };
}

function lowered(raw: parser.Module): parser.Module {
  let typed = checker.annotate_module(raw);
  let funcs: parser.FuncDecl[] = [];
  for fd in typed.funcs {
    funcs = funcs.append(lexical.resolve_func(fd).func);
  }
  let resolved = parser.Module { ...typed, funcs: funcs };
  return parser.fill_default_args_module(parser.desugar_ranges_module(parser.lower_defers_module(resolved)));
}

pub function (s: Session) declare(m: parser.Module): Session {
  let funcs: parser.FuncDecl[] = [];
  for f in s.decls.funcs {
    if (!declares_func(m, f.name)) {
      funcs = funcs.append(f);
    }
  }
  for f in m.funcs {
    funcs = funcs.append(f);
  }
  let structs = s.decls.structs;
  for d in m.structs {
    structs = structs.append(d);
  }
  let aliases = s.decls.aliases;
  for a in m.aliases {
    aliases = aliases.append(a);
  }
  let decls = parser.Module { ...s.decls, funcs: funcs, structs: structs, aliases: aliases };
  let mod = lowered(decls);
  let types = module_type_decls(mod.structs);
  return Session { decls: decls, env: Env { ...s.env, funcs: funcs_of(mod.funcs), aliases: aliases_with_enums(mod.aliases, types, mod.enums), type_decls: types } };
}

function declares_func(m: parser.Module, name: string): boolean {
  for f in m.funcs {
    if (f.name == name) {
      return true;
    }
  }
  return false;
}

pub function (s: Session) run(m: parser.Module, name: string): (Session, boolean, Value) {
  let body: ast.Stmt[] = [];
  for f in lowered(m).funcs {
    if (f.name == name) {
      body = f.body;
    }
  }
  let env = s.env;
  for k in 0..body.len() {
    if (k == body.len() - 1) {
      match (body[k]) {
        ast.StmtExpr(x) => {
          let v = eval_expr(x.value, env);
          return (Session { ...s, env: session_env(env) }, is_err(v) || !returns_void(env, x.value), v);
        },
        _ => {}
      }
    }
    let r = eval_stmt(body[k], unsafe { share_unchecked(env) });
    env = r.env;
    if (r.sig != 0 && is_err(r.ret)) {
      return (Session { ...s, env: session_env(env) }, true, r.ret);
    }
  }
  return (Session { ...s, env: session_env(env) }, false, v_void());
}

function session_env(env: Env): Env {
  let flat = flattened_env(env);
  let names: string[] = [];
  for name in flat.names {
    names = names.append(lexical.source_name(name));
  }
  return Env { ...flat, names: names };
}

function returns_void(env: Env, x: ast.Expr): boolean {
  if (env.static_type_of(x) == "void") {
    return true;
  }
  match (x) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          return !env.binds_name(id.name) && func_ret_type(env.funcs, id.name, []).len() == 0
            && (id.name == "print" || id.name == "write" || id.name == "eprint" || id.name == "putchar");
        },
        _ => {}
      }
    },
    _ => {}
  }
  return false;
}

pub function (s: Session) show(v: Value): string {
  if (is_err(v)) {
    return value_text(v);
  }
  if (method_ret_type(s.env.funcs, value_type_name(v), "to_string") == "string") {
    match (call_method(s.env.heap, v, "to_string", [], s.env.funcs, s.env.aliases, s.env.type_decls)) {
      VString(t) => {
        let text = t.v;
        return text;
      },
      VErr(e) => {
        return "error: " + e.msg;
      },
      _ => {}
    }
  }
  return value_text(v);
}

function value_text(v: Value): string {
  match (v) {
    VInt(n) => {
      if (n.is_char) {
        return utf8.encode(n.v as char);
      }
      return util.i32_to_string(n.v);
    },
    VInt64(n) => {
      return u64_text(unpack_i64(n), n.unsigned);
    },
    VUint(n) => {
      let mask: i64 = 4294967295;
      return util.i64_to_string(n.v as i64 & mask);
    },
    VBool(b) => {
      if (b.v) {
        return "true";
      }
      return "false";
    },
    VString(t) => {
      let text = t.v;
      return text;
    },
    VArr(a) => {
      return "[" + values_text(arr_els(a)) + "]";
    },
    VTuple(t) => {
      return "(" + values_text(t.elements) + ")";
    },
    VStruct(sv) => {
      return struct_text(sv);
    },
    VMap(m) => {
      let out = "";
      for i in 0..m.keys.len() {
        if (i > 0) {
          out += ", ";
        }
        out = out + value_text(m.keys[i]) + ": " + value_text(m.values[i]);
      }
      return "Map { " + out + " }";
    },
    VErr(e) => {
      return "error: " + e.msg;
    },
    _ => {}
  }
  return "<" + value_type_name(v) + ">";
}

function values_text(vs: Value[]): string {
  let out = "";
  for x in vs {
    if (out.len() > 0) {
      out += ", ";
    }
    out += value_text(x);
  }
  return out;
}

function struct_text(sv: VStruct): string {
  let fields = "";
  let payloads = "";
  for i in 0..sv.field_names.len() {
    if (i > 0) {
      fields += ", ";
      payloads += ", ";
    }
    fields = fields + sv.field_names[i] + ": " + value_text(sv.field_values[i]);
    payloads += value_text(sv.field_values[i]);
  }
  if (sv.field_names.len() == 0) {
    return sv.type_name;
  }
  if (sv.field_names[0].starts_with("_")) {
    return sv.type_name + "(" + payloads + ")";
  }
  return sv.type_name + " { " + fields + " }";
}

function u64_text(n: i64, unsigned: boolean): string {
  if (!unsigned || n >= 0) {
    return util.i64_to_string(n);
  }
  let u = n as u64;
  let q = u / 10;
  return util.i64_to_string(q as i64) + util.i32_to_string((u - q * 10) as i32);
}

function interp_mulhi(a: u64, b: u64): u64 {
  let m = 4294967295 as u64;
  let sh = 32 as u64;
  let al = a & m;
  let ah = a >> sh;
  let bl = b & m;
  let bh = b >> sh;
  let mid = ah * bl + (al * bl >> sh);
  return ah * bh + (mid >> sh) + ((mid & m) + al * bh >> sh);
}
