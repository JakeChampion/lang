function check_slicing(): i32 {
  // String slicing is checked (#5634): `"hello"[1:4]` → `Some("ell")`.
  let r29: Value = run_source("let s = \"hello\"; return s[1:4];");
  match (r29) {
    VStruct(sv29) => {
      if (sv29.type_name != "Some") {
        return 290;
      }
      match (sv29.field_values[0]) {
        VString(s29) => {
          if (s29.v != "ell") {
            return 292;
          }
        },
        _ => {
          return 293;
        }
      }
    },
    _ => {
      return 291;
    }
  }

  // The unchecked byte slice keeps the raw string: slice + index
  // → 'l' = 108.
  let r30: Value = run_source("let s = \"hello\"; return slice_unchecked(s, 1, 4)[1];");
  match (r30) {
    VInt(i) => {
      if (i.v != 108) {
        return 300;
      }
    },
    _ => {
      return 301;
    }
  }

  // Array slicing: `[10,20,30,40,50][1:4]` → length 3, first
  // element 20.
  let r31: Value = run_source("let a = [10, 20, 30, 40, 50]; let b = a[1:4]; return b[0];");
  match (r31) {
    VInt(i) => {
      if (i.v != 20) {
        return 310;
      }
    },
    _ => {
      return 311;
    }
  }

  // Out-of-range slice → `None`, not an error (#5634).
  let r32: Value = run_source("let s = \"hi\"; return s[0:99];");
  match (r32) {
    VStruct(sv32) => {
      if (sv32.type_name != "None") {
        return 320;
      }
    },
    _ => {
      return 321;
    }
  }

  // A bound that splits a code point → `None`. "héllo" is 6 bytes,
  // with the two-byte é at offsets 1..2, so 2 is interior.
  let r32b: Value = run_source("let s = \"héllo\"; return s[0:2];");
  match (r32b) {
    VStruct(sv32b) => {
      if (sv32b.type_name != "None") {
        return 322;
      }
    },
    _ => {
      return 323;
    }
  }

  // The trap the expression form gave up lives on `slice_unchecked`:
  // an out-of-range bound is still an error there. (Surface it through
  // .len() so it reaches the program's return rather than getting
  // silently stored in a var.)
  let r32u: Value = run_source("let s = \"hi\"; return slice_unchecked(s, 0, 99).len();");
  match (r32u) {
    VErr(_) => {},
    _ => {
      return 324;
    }
  }

  return 0;
}

function check_compound_assignment(): i32 {
  // Compound assignment lowers to plain assign at parse time —
  // `x += 1` is `x = x + 1` by the time the interp sees it.
  // Sum 1..=10 via `+=` in the body: 55.
  let r33: Value = run_source(
    "let i = 1; let s = 0; while (i <= 10) { s += i; i += 1; } return s;",
