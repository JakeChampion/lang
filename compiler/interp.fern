function check_match_statements(): i32 {
  // StmtMatch — variant pattern binds the scrutinee and the
  // body reads a field off it.
  let src39: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 5 }; match (c) { Circle(x) => { return x.r; }, _ => { return -1; } } return -2; }";
  let r39: Value = run_module(src39);
  match (r39) {
    VInt(i) => {
      if (i.v != 5) {
        return 390;
      }
    },
    _ => {
      return 391;
    }
  }

  // StmtMatch — second variant matches, first is skipped.
  let src40: string = "struct Circle { r: i32 } struct Square { s: i32 } function main(): i32 { let q = Square { s: 7 }; match (q) { Circle(_) => { return 1; }, Square(sq) => { return sq.s; }, _ => { return -1; } } return -2; }";
  let r40: Value = run_module(src40);
  match (r40) {
    VInt(i) => {
      if (i.v != 7) {
        return 400;
      }
    },
    _ => {
      return 401;
    }
  }

  // StmtMatch — wildcard catches when no variant matches.
  let src41: string = "struct Circle { r: i32 } struct Square { s: i32 } struct Triangle { b: i32 } function main(): i32 { let t = Triangle { b: 3 }; match (t) { Circle(_) => { return 1; }, Square(_) => { return 2; }, _ => { return 99; } } return -1; }";
  let r41: Value = run_module(src41);
  match (r41) {
    VInt(i) => {
      if (i.v != 99) {
        return 410;
      }
    },
    _ => {
      return 411;
    }
  }

  // StmtMatch — bare variant pattern (no binding), arm body
  // doesn't reference the value.
  let src42: string = "struct Empty { } function main(): i32 { let e = Empty { }; match (e) { Empty => { return 42; }, _ => { return -1; } } return -2; }";
  let r42: Value = run_module(src42);
  match (r42) {
    VInt(i) => {
      if (i.v != 42) {
        return 420;
      }
    },
    _ => {
      return 421;
    }
  }

  // StmtMatch — non-exhaustive: scrutinee doesn't match any
  // arm and there's no wildcard. v_err("non-exhaustive match")
  // bubbles out as the function's return value.
  let src43: string = "struct Circle { r: i32 } struct Square { s: i32 } function main(): i32 { let c = Circle { r: 1 }; match (c) { Square(_) => { return 2; } } return -1; }";
  let r43: Value = run_module(src43);
  match (r43) {
    VErr(_) => {},
    _ => {
      return 430;
    }
  }

  // StmtMatch — arm body without `return` falls through to
  // the stmt after the match. Verifies the no-return signal
  // doesn't accidentally short-circuit.
  let src44: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 8 }; let n: i32 = 0; match (c) { Circle(x) => { n = x.r; }, _ => { n = -1; } } return n; }";
  let r44: Value = run_module(src44);
  match (r44) {
    VInt(i) => {
      if (i.v != 8) {
        return 440;
      }
    },
    _ => {
      return 441;
    }
  }

  // StmtMatch — arm-local bindings die after the arm. After
  // the match closes, the outer scope must NOT see `x`.
  // Re-binding `x` in the surrounding scope to a different
  // value verifies the inner binding was dropped.
  let src45: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 1 }; match (c) { Circle(x) => { }, _ => { } } let x: i32 = 77; return x; }";
  let r45: Value = run_module(src45);
  match (r45) {
    VInt(i) => {
      if (i.v != 77) {
        return 450;
      }
    },
    _ => {
      return 451;
    }
  }

  return 0;
}

function check_receiver_methods(): i32 {
  // Receiver method on a struct: `c.area()` dispatches to
  // the method whose receiver_type matches the struct type
  // (Circle). The method body reads the receiver via its
  // bound name and returns a derived value.
  let src46: string = "struct Circle { r: i32 } function (c: Circle) area(): i32 { return c.r * c.r; } function main(): i32 { let k = Circle { r: 5 }; return k.area(); }";
  let r46: Value = run_module(src46);
  match (r46) {
    VInt(i) => {
      if (i.v != 25) {
        return 460;
      }
    },
    _ => {
      return 461;
    }
  }

  // Method takes an arg. `b.scale(3)` binds c=b and n=3.
  let src47: string = "struct Box { v: i32 } function (b: Box) scale(n: i32): i32 { return b.v * n; } function main(): i32 { let x = Box { v: 4 }; return x.scale(3); }";
  let r47: Value = run_module(src47);
  match (r47) {
    VInt(i) => {
      if (i.v != 12) {
        return 470;
      }
    },
    _ => {
      return 471;
    }
  }

  // Method name and plain function name don't collide. Plain
  // call resolves to the non-method (receiver_name empty).
  let src48: string = "struct Circle { r: i32 } function (c: Circle) area(): i32 { return c.r * c.r; } function area(): i32 { return 100; } function main(): i32 { let k = Circle { r: 5 }; let m: i32 = area(); let n: i32 = k.area(); return m + n; }";
  let r48: Value = run_module(src48);
  match (r48) {
    VInt(i) => {
      if (i.v != 125) {
        return 480;
      }
    },
    _ => {
      return 481;
    }
  }

  // Method on wrong receiver type → VErr. Circle has an
  // `area` method; Square does not.
  let src49: string = "struct Circle { r: i32 } struct Square { s: i32 } function (c: Circle) area(): i32 { return c.r; } function main(): i32 { let sq = Square { s: 7 }; return sq.area(); }";
  let r49: Value = run_module(src49);
  match (r49) {
    VErr(_) => {},
    _ => {
      return 490;
    }
  }

  return 0;
}

function check_floats(): i32 {
  // Float literal — `3.14` evaluates to a VFloat.
  let r50: Value = run_source("return 3.14;");
  match (r50) {
    VFloat(f) => {
      if (f.v < 3.13 || f.v > 3.15) {
        return 500;
      }
    },
    _ => {
      return 501;
    }
  }

  // Float arithmetic: `1.5 + 2.5` → 4.0.
  let r51: Value = run_source("return 1.5 + 2.5;");
  match (r51) {
    VFloat(f) => {
      if (f.v < 3.99 || f.v > 4.01) {
        return 510;
      }
    },
    _ => {
      return 511;
    }
  }

  // Float multiplication: `2.5 * 4.0` → 10.0.
  let r52: Value = run_source("return 2.5 * 4.0;");
  match (r52) {
    VFloat(f) => {
      if (f.v < 9.99 || f.v > 10.01) {
        return 520;
      }
    },
    _ => {
      return 521;
    }
  }

  // Float comparison: `3.14 > 3.0` → true.
  let r53: Value = run_source("return 3.14 > 3.0;");
  match (r53) {
    VBool(b) => {
      if (!b.v) {
        return 530;
      }
    },
    _ => {
      return 531;
    }
  }

  // Float equality through ==: `1.5 == 1.5` → true.
  let r54: Value = run_source("return 1.5 == 1.5;");
  match (r54) {
    VBool(b) => {
      if (!b.v) {
        return 540;
      }
    },
    _ => {
      return 541;
    }
  }

  // Mixed-numeric `+` is rejected: `1 + 2.5` → VErr.
  let r55: Value = run_source("return 1 + 2.5;");
  match (r55) {
    VErr(_) => {},
    _ => {
      return 550;
    }
  }

  // Float division: `10.0 / 4.0` → 2.5.
  let r56: Value = run_source("return 10.0 / 4.0;");
  match (r56) {
    VFloat(f) => {
      if (f.v < 2.49 || f.v > 2.51) {
        return 560;
      }
    },
    _ => {
      return 561;
    }
  }

  // Unary minus on a float: `-3.5` → -3.5.
  let r57: Value = run_source("return 0.0 - 3.5;");
  match (r57) {
    VFloat(f) => {
      if (f.v > 0.0 - 3.49 || f.v < 0.0 - 3.51) {
        return 570;
      }
    },
    _ => {
      return 571;
    }
  }

  return 0;
}

function check_for_in_loops(): i32 {
  // For-in: sum [1, 2, 3] via in-loop accumulator.
  let src58: string = "function main(): i32 { let arr = [1, 2, 3]; let s: i32 = 0; for n in arr { s = s + n; } return s; }";
  let r58: Value = run_module(src58);
  match (r58) {
    VInt(i) => {
      if (i.v != 6) {
        return 580;
      }
    },
    _ => {
      return 581;
    }
  }

  // For-in: in-body `return` short-circuits the loop.
  let src59: string = "function main(): i32 { for n in [10, 20, 30] { return n; } return 0 - 1; }";
  let r59: Value = run_module(src59);
  match (r59) {
    VInt(i) => {
      if (i.v != 10) {
        return 590;
      }
    },
    _ => {
      return 591;
    }
  }

  // For-in: iter not iterable → VErr.
  let src60: string = "function main(): i32 { for n in 7 { } return 0; }";
  let r60: Value = run_module(src60);
  match (r60) {
    VErr(_) => {},
    _ => {
      return 600;
    }
  }
  return check_for_in_subjects();
}

// check_for_in_subjects: a string walks its bytes, a Map and an array of
// tuples bind a pattern header per entry, and a value with `next()` (or an
// `iter()` returning one) walks through the Iterator protocol, advancing
// before the body so `continue` moves on.
function check_for_in_subjects(): i32 {
  let srcs: string[] = [
    "function main(): i32 { let n: i32 = 0; for b in \"ab\" { n = n + (b as i32); } return n; }",
    "function main(): i32 { let m = map_new(); m = m.insert(\"a\", 1); m = m.insert(\"bc\", 2); let n: i32 = 0; for (k, v) in m { n = n + k.len() * 10 + v; } return n; }",
    "function main(): i32 { let n: i32 = 0; for (a, b) in [(1, 2), (3, 4)] { n = n + a * b; } return n; }",
    "struct Cd { n: i32 }\nfunction (c: Cd) next(): Option[(i32, Cd)] { if (c.n == 0) { return None; } return Some((c.n, Cd { n: c.n - 1 })); }\nfunction main(): i32 { let n: i32 = 0; let c: Cd = Cd { n: 4 }; for v in c { if (v == 2) { continue; } n = n + v; } return n; }",
    "struct Cd { n: i32 }\nstruct Box { n: i32 }\nfunction (c: Cd) next(): Option[(i32, Cd)] { if (c.n == 0) { return None; } return Some((c.n, Cd { n: c.n - 1 })); }\nfunction (b: Box) iter(): Cd { return Cd { n: b.n }; }\nfunction main(): i32 { let n: i32 = 0; let b: Box = Box { n: 3 }; for v in b { n = n + v; } return n; }",
  ];
  let wants: i32[] = [195, 33, 14, 8, 6];
  let i: i32 = 0;
  while (i < srcs.len()) {
    let r: Value = run_module(srcs[i]);
    match (r) {
      VInt(got) => {
        if (got.v != wants[i]) {
          return 920 + i;
        }
      },
      _ => {
        return 930 + i;
      }
    }
    i = i + 1;
  }
  return 0;
}

function check_tuples(): i32 {
  // Tuple literal — evaluates to VTuple.
  let r61: Value = run_source("let t = (1, 2, 3); return 0;");
  match (r61) {
    VInt(i) => {
      if (i.v != 0) {
        return 610;
      }
    },
    _ => {
      return 611;
    }
  }

  // Tuple field access — `(10, 20, 30).0` → 10.
  let r62: Value = run_source("let t = (10, 20, 30); return t.0;");
  match (r62) {
    VInt(i) => {
      if (i.v != 10) {
        return 620;
      }
    },
    _ => {
      return 621;
    }
  }

  // Tuple index 1.
  let r63: Value = run_source("let t = (10, 20, 30); return t.1;");
  match (r63) {
    VInt(i) => {
      if (i.v != 20) {
        return 630;
      }
    },
    _ => {
      return 631;
    }
  }

  // Tuple index out of range → VErr.
  let r64: Value = run_source("let t = (10, 20); return t.5;");
  match (r64) {
    VErr(_) => {},
    _ => {
      return 640;
    }
  }

  // Heterogeneous tuple — int + string slot.
  let r65: Value = run_source("let t = (42, \"hi\"); return t.0;");
  match (r65) {
    VInt(i) => {
      if (i.v != 42) {
        return 650;
      }
    },
    _ => {
      return 651;
    }
  }

  return 0;
}

function check_break_and_continue(): i32 {
  // break inside a while exits the loop. The accumulator
  // stops growing once i hits 3.
  let src66: string = "function main(): i32 { let i: i32 = 0; let s: i32 = 0; while (i < 10) { if (i == 3) { break; } s = s + i; i = i + 1; } return s; }";
  let r66: Value = run_module(src66);
  match (r66) {
    VInt(i) => {
      if (i.v != 3) {
        return 660;
      }
    },
    _ => {
      return 661;
    }
  }

  // continue skips the rest of the iter. `s` accumulates
  // only the even values in 0..5: 0 + 2 + 4 = 6.
  let src67: string = "function main(): i32 { let i: i32 = 0; let s: i32 = 0; while (i < 5) { if (i % 2 == 1) { i = i + 1; continue; } s = s + i; i = i + 1; } return s; }";
  let r67: Value = run_module(src67);
  match (r67) {
    VInt(i) => {
      if (i.v != 6) {
        return 670;
      }
    },
    _ => {
      return 671;
    }
  }

  // for-in + break — sums [1, 2, 10, 20] only until 10 then
  // stops: 1 + 2 = 3.
  let src68: string = "function main(): i32 { let s: i32 = 0; for n in [1, 2, 10, 20] { if (n > 5) { break; } s = s + n; } return s; }";
  let r68: Value = run_module(src68);
  match (r68) {
    VInt(i) => {
      if (i.v != 3) {
        return 680;
      }
    },
    _ => {
      return 681;
    }
  }

  // for-in + continue — skips elements that match.
  let src69: string = "function main(): i32 { let s: i32 = 0; for n in [1, 2, 3, 4, 5] { if (n == 3) { continue; } s = s + n; } return s; }";
  let r69: Value = run_module(src69);
  match (r69) {
    VInt(i) => {
      if (i.v != 12) {
        return 690;
      }
    },
    _ => {
      return 691;
    }
  }

  return 0;
}

function check_primitive_receivers(): i32 {
  // Method on a primitive receiver — `function (s: string)
  // doubled(): string { return s + s; }` dispatches when
  // called on a string value.
  let src70: string = "function (s: string) doubled(): string { return s + s; } function main(): i32 { let v: string = \"ab\"; let w: string = v.doubled(); if (w == \"abab\") { return 0; } return 1; }";
  let r70: Value = run_module(src70);
  match (r70) {
    VInt(i) => {
      if (i.v != 0) {
        return 700;
      }
    },
    _ => {
      return 701;
    }
  }

  // Method on an i32 receiver.
  let src71: string = "function (n: i32) twice(): i32 { return n * 2; } function main(): i32 { let x: i32 = 21; return x.twice(); }";
  let r71: Value = run_module(src71);
  match (r71) {
    VInt(i) => {
      if (i.v != 42) {
        return 710;
      }
    },
    _ => {
      return 711;
    }
  }

  return 0;
}

function check_structural_equality(): i32 {
  // Tuple structural equality.
  let r72: Value = run_source("return (1, 2, 3) == (1, 2, 3);");
  match (r72) {
    VBool(b) => {
      if (!b.v) {
        return 720;
      }
    },
    _ => {
      return 721;
    }
  }

  // Tuple inequality (one element differs).
  let r73: Value = run_source("return (1, 2, 3) == (1, 2, 4);");
  match (r73) {
    VBool(b) => {
      if (b.v) {
        return 730;
      }
    },
    _ => {
      return 731;
    }
  }

  // Heterogeneous tuple equality.
  let r74: Value = run_source("return (1, \"hi\") == (1, \"hi\");");
  match (r74) {
    VBool(b) => {
      if (!b.v) {
        return 740;
      }
    },
    _ => {
      return 741;
    }
  }

  // Array structural equality.
  let r75: Value = run_source("return [1, 2, 3] == [1, 2, 3];");
  match (r75) {
    VBool(b) => {
      if (!b.v) {
        return 750;
      }
    },
    _ => {
      return 751;
    }
  }

  // Array inequality.
  let r76: Value = run_source("return [1, 2, 3] == [1, 2, 4];");
  match (r76) {
    VBool(b) => {
      if (b.v) {
        return 760;
      }
    },
    _ => {
      return 761;
    }
  }

  // Different lengths → not equal.
  let r77: Value = run_source("return [1, 2] == [1, 2, 3];");
  match (r77) {
    VBool(b) => {
      if (b.v) {
        return 770;
      }
    },
    _ => {
      return 771;
    }
  }

  // Struct structural equality.
  let src78: string = "struct Point { x: i32, y: i32 } function main(): i32 { let a = Point { x: 1, y: 2 }; let b = Point { x: 1, y: 2 }; if (a == b) { return 0; } return 1; }";
  let r78: Value = run_module(src78);
  match (r78) {
    VInt(i) => {
      if (i.v != 0) {
        return 780;
      }
    },
    _ => {
      return 781;
    }
  }

  // Struct inequality (one field differs).
  let src79: string = "struct Point { x: i32, y: i32 } function main(): i32 { let a = Point { x: 1, y: 2 }; let b = Point { x: 1, y: 3 }; if (a == b) { return 1; } return 0; }";
  let r79: Value = run_module(src79);
  match (r79) {
    VInt(i) => {
      if (i.v != 0) {
        return 790;
      }
    },
    _ => {
      return 791;
    }
  }

  return 0;
}

function check_union_receiver_method(): i32 {
  // Union-receiver method: a method declared on a union
  // (`function (sh: Shape) tag(): i32`) dispatches when the
  // receiver is one of the union's variant structs.
  let src80: string = "struct Circle { r: i32 } struct Square { s: i32 } pub type Shape = Circle | Square; function (sh: Shape) tag(): i32 { return 1; } function main(): i32 { let c = Circle { r: 3 }; return c.tag(); }";
  let r80: Value = run_module(src80);
  match (r80) {
    VInt(i) => {
      if (i.v != 1) {
        return 800;
      }
    },
    _ => {
      return 801;
    }
  }

  return 0;
}

function check_lambdas_and_closures(): i32 {
  // Lambda expression bound to a var, then called.
  let src81: string = "function main(): i32 { let f = (x: i32): i32 => { return x + 1; }; return f(41); }";
  let r81: Value = run_module(src81);
  match (r81) {
    VInt(i) => {
      if (i.v != 42) {
        return 810;
      }
    },
    _ => {
      return 811;
    }
  }

  // Closure captures an outer local var.
  let src82: string = "function main(): i32 { let k: i32 = 10; let f = (x: i32): i32 => { return x + k; }; return f(5); }";
  let r82: Value = run_module(src82);
  match (r82) {
    VInt(i) => {
      if (i.v != 15) {
        return 820;
      }
    },
    _ => {
      return 821;
    }
  }

  // Immediate-invoked function expression.
  let src83: string = "function main(): i32 { return (n: i32): i32 => { return n * 2; }(21); }";
  let r83: Value = run_module(src83);
  match (r83) {
    VInt(i) => {
      if (i.v != 42) {
        return 830;
      }
    },
    _ => {
      return 831;
    }
  }

  return 0;
}

function check_maps(): i32 {
  // Map: set / get_or / has / len.
  let src84: string = "function main(): i32 { let m = map_new(); m = m.insert(\"a\", 1); m = m.insert(\"b\", 2); let got: i32 = m.get_or(\"a\", 0 - 1); return got; }";
  let r84: Value = run_module(src84);
  match (r84) {
    VInt(i) => {
      if (i.v != 1) {
        return 840;
      }
    },
    _ => {
      return 841;
    }
  }

  // Map: get_or returns default on miss.
  let src85: string = "function main(): i32 { let m = map_new(); m = m.insert(\"a\", 1); return m.get_or(\"missing\", 99); }";
  let r85: Value = run_module(src85);
  match (r85) {
    VInt(i) => {
      if (i.v != 99) {
        return 850;
      }
    },
    _ => {
      return 851;
    }
  }

  // Map: len after multiple sets.
  let src86: string = "function main(): i32 { let m = map_new(); m = m.insert(\"a\", 1); m = m.insert(\"b\", 2); m = m.insert(\"c\", 3); return m.len(); }";
  let r86: Value = run_module(src86);
  match (r86) {
    VInt(i) => {
      if (i.v != 3) {
        return 860;
      }
    },
    _ => {
      return 861;
    }
  }

  // Map: overwrite same key keeps the latest value.
  let src87: string = "function main(): i32 { let m = map_new(); m = m.insert(\"k\", 1); m = m.insert(\"k\", 99); return m.get_or(\"k\", 0); }";
  let r87: Value = run_module(src87);
  match (r87) {
    VInt(i) => {
      if (i.v != 99) {
        return 870;
      }
    },
    _ => {
      return 871;
    }
  }

  // Cross-file imports via merge_module_prefixed: the
  // "main" module calls `parser.parse_module()` which
  // resolves to a function named `parser.parse_module`
  // after the prefix merge. ExprFieldAccess(ExprIdent
  // "parser", "parse_module") dispatches as a qualified-
  // name function call.
  let mainSrc88: string = "function main(): i32 { return parser.parse_module(); }";
  let modSrc88: string = "pub function parse_module(): i32 { return 42; }";
  let mainMod88: parser.Module = parser.parse_module(lexer.tokenize(mainSrc88));
  let pMod88: parser.Module = parser.parse_module(lexer.tokenize(modSrc88));
  let merged88: parser.Module = parser.merge_module_prefixed(mainMod88, pMod88, "parser");
  let r88: Value = eval_module(merged88);
  match (r88) {
    VInt(i) => {
      if (i.v != 42) {
        return 880;
      }
    },
    _ => {
      return 881;
    }
  }

  return 0;
}

function check_numeric_widths(): i32 {
  // u32 unsigned semantics (#4348 final slice): logical `>>` on a
  // high-bit pattern (arithmetic shift would smear the sign) and
  // unsigned div/compare (signed would see -6).
  let src89: string = "function main(): i32 { let x: u32 = 4294967288 as u32; let y = x >> 2; if (y == (1073741822 as u32)) { return 1; } return 0; }";
  let r89: Value = run_module(src89);
  match (r89) {
    VInt(i) => {
      if (i.v != 1) {
        return 890;
      }
    },
    _ => {
      return 891;
    }
  }
  let src90: string = "function main(): i32 { let x: u32 = 4294967290 as u32; let y: u32 = 5 as u32; if (x / y > (100 as u32) && x > y) { return 1; } return 0; }";
  let r90: Value = run_module(src90);
  match (r90) {
    VInt(i) => {
      if (i.v != 1) {
        return 900;
      }
    },
    _ => {
      return 901;
    }
  }

  // f32 single-precision rounding: 2^24 + 1 is not representable at
  // f32, so the sum rounds back to 2^24 (at f64 it would stay 2^24+1).
  let src91: string = "function main(): i32 { let a: f32 = 16777216.0 as f32; let b = a + (1.0 as f32); if ((b as f64) > 16777215.5 && (b as f64) < 16777216.5) { return 1; } return 0; }";
  let r91: Value = run_module(src91);
  match (r91) {
    VInt(i) => {
      if (i.v != 1) {
        return 910;
      }
    },
    _ => {
      return 911;
    }
  }

  return 0;
}

// interp_mulhi is the high 64 bits of the unsigned 128-bit product, in four
// 32x32 partial products: written out rather than through __mulhi_u64, which
// a compiler older than the builtin cannot compile.
function interp_mulhi(a: u64, b: u64): u64 {
  let m: u64 = 4294967295 as u64;
  let sh: u64 = 32 as u64;
  let al: u64 = a & m;
  let ah: u64 = a >> sh;
  let bl: u64 = b & m;
  let bh: u64 = b >> sh;
  let mid: u64 = ah * bl + (al * bl >> sh);
  return ah * bh + (mid >> sh) + ((mid & m) + al * bh >> sh);
}
