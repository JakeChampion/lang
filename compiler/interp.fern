  let r34: Value = run_source("let x = 1; x *= 2; x *= 3; return x;");
  match (r34) {
    VInt(i) => {
      if (i.v != 6) {
        return 340;
      }
    },
    _ => {
      return 341;
    }
  }

  return 0;
}

