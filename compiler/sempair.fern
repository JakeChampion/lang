import "./ssa";
import "./util";
import "./ssasem";
import "./typeinfo";
import "./semtypes";
import "./semrecords";
import "./semscalarreturn";

pub struct Paired { funcs: ssasem.Func[], changed: boolean[] }

// split: a variant whose payload is two words (parts) returns them in the two
// pair words beside its position, so the payload is never built.
struct Shape { ty: typeinfo.Type, names: string[], payloads: typeinfo.Type[], has: boolean[], pair: boolean, lanes: boolean, split: boolean, parts: typeinfo.Type[][] }

struct Pairing { ok: boolean[], split: boolean[] }

function max_variants(): i32 {
  return 16;
}

pub function pair_returns(funcs: ssasem.Func[], names: string[], rewrite: boolean[], unnamed: boolean[]): Paired {
  let ix: util.NameIndex = util.name_index(names);
  let pg: Pairing = pairable(funcs, names, ix, rewrite, unnamed);
  let paired: boolean[] = pg.ok;
  let out: ssasem.Func[] = [];
  let changed: boolean[] = [];
  for i in 0..funcs.len() {
    let f: ssasem.Func = funcs[i];
    let c: boolean = false;
    if (paired[i]) {
      if (semscalarreturn.eligible(f, f.result)) {
        f = semscalarreturn.callee(f);
      } else {
        f = pair_callee(f, shape_of(f, f.result, pg.split[i]));
      }
      c = true;
    }
    if (rewrite[i] && calls_paired(f, ix, paired)) {
      f = rebuild_calls(f, funcs, ix, pg);
      c = true;
    }
    out = out.append(f);
    changed = changed.append(c);
  }
  return Paired { funcs: out, changed: changed };
}

function pairable(funcs: ssasem.Func[], names: string[], ix: util.NameIndex, rewrite: boolean[], unnamed: boolean[]): Pairing {
  let refs: Refs = refs_of(funcs, ix, rewrite);
  let ok: boolean[] = [];
  let split: boolean[] = [];
  let dead: boolean[] = [];
  for i in 0..funcs.len() {
    let direct: boolean = refs.calls[i] > 0 && !refs.other[i];
    let paired: boolean = direct && rewrite[i] && unnamed[i] && shaped(funcs[i]);
    ok = ok.append(paired);
    split = split.append(paired && splits(funcs[i]));
    dead = dead.append(refs.calls[i] == 0 && !refs.other[i] && rewrite[i] && unnamed[i]);
  }
  return taken_apart(funcs, ix, Pairing { ok: ok, split: split }, dead);
}

// A callee stays paired while no caller keeps its value whole, and returns a
// payload in two words while no caller keeps that payload whole either.
function taken_apart(funcs: ssasem.Func[], ix: util.NameIndex, pg0: Pairing, dead: boolean[]): Pairing {
  let ok: boolean[] = pg0.ok;
  let split: boolean[] = pg0.split;
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let j: i32 = 0;
    while (j < funcs.len()) {
      if (dead[j]) {
        j = j + 1;
        continue;
      }
      let whole: boolean[] = [];
      let scalar_whole: boolean[] = [];
      let inner: boolean[] = [];
      let computed: boolean = false;
      for b in funcs[j].graph.blocks {
        for ins in b.insts {
          let at: i32 = paired_callee(ins, ix, ok);
          if (at >= 0 && !computed) {
            let defs: ssa.SInst[] = defs_of(funcs[j].graph);
            whole = whole_values(funcs[j], ix, ok, ok[j]);
            scalar_whole = semscalarreturn.donors(funcs[j], defs, whole);
            inner = payloads_whole(funcs[j], defs, ix, Pairing { ok: ok, split: split }, ok[j], ok[j] && !split[j]);
            computed = true;
          }
          if (at >= 0 && keeps_result(funcs[at], ins.result, whole, scalar_whole)) {
            ok = ok.with(at, false);
            split = split.with(at, false);
            changed = true;
          } else if (at >= 0 && split[at] && inner[ins.result]) {
            split = split.with(at, false);
            changed = true;
          }
        }
      }
      j = j + 1;
    }
  }
  return Pairing { ok: ok, split: split };
}

// The values whose two-word variant payload is kept whole: read out and used
// whole, or returned whole by a callee that hands it on in one word.
function payloads_whole(f: ssasem.Func, defs: ssa.SInst[], ix: util.NameIndex, pg: Pairing, paired: boolean, returns_whole: boolean): boolean[] {
  let returned: boolean[] = [];
  if (paired && !returns_whole) {
    returned = returned_constructions(f, defs);
  }
  let whole: boolean[] = through_joins(defs, seeded(f, defs, ix, pg.ok, pg.split, paired, returned));
  let inner: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.variant_get() && whole[ins.result] && may_split(f.values[ins.result])) {
        inner = marked_all(inner, ins.args);
      }
    }
    if (b.term.kind_tag == 1 && returns_whole) {
      inner = marked_all(inner, [b.term.value]);
    }
  }
  return through_joins(defs, inner);
}

function returned_constructions(f: ssasem.Func, defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      let d: ssa.SInst = semscalarreturn.through_copies(defs, b.term.value);
      if (d.kind_tag == ssasem.variant_new() && d.result >= 0 && semtypes.equal(f.values[d.result], f.result)) {
        out = out.with(d.result, true);
      }
    }
  }
  return out;
}

function keeps_result(callee: ssasem.Func, value: i32, whole: boolean[], scalar_whole: boolean[]): boolean {
  return whole[value] || semscalarreturn.eligible(callee, callee.result) && scalar_whole[value];
}

function paired_callee(ins: ssa.SInst, ix: util.NameIndex, ok: boolean[]): i32 {
  if (ins.kind_tag != ssasem.call()) {
    return 0 - 1;
  }
  let at: i32 = ix.find(ins.str);
  if (at >= 0 && ok[at]) {
    return at;
  }
  return 0 - 1;
}

pub function whole_values(f: ssasem.Func, ix: util.NameIndex, ok: boolean[], paired: boolean): boolean[] {
  let defs: ssa.SInst[] = defs_of(f.graph);
  let none: boolean[] = [];
  return through_joins(defs, seeded(f, defs, ix, ok, none, paired, []));
}

// split names the callees whose payloads a caller rebuilds as constructions.
// returned marks the variants a split function returns: its return takes
// their payloads apart, so they keep nothing whole.
function seeded(f: ssasem.Func, defs: ssa.SInst[], ix: util.NameIndex, ok: boolean[], split: boolean[], paired: boolean, returned: boolean[]): boolean[] {
  let g: ssa.SFunc = f.graph;
  let whole: boolean[] = __alloc_bool(g.nvals);
  for b in g.blocks {
    for ins in b.insts {
      let apart: boolean = reads_apart(ins.kind_tag) || ins.result >= 0 && ins.result < returned.len() && returned[ins.result];
      if (!apart && ins.kind_tag != 7 && ins.kind_tag != 8) {
        whole = marked_all(whole, ins.args);
      }
      if (ins.kind_tag == 8 && !joins_apart(ins, defs, ix, ok, split)) {
        whole = marked_all(whole, [ins.result]);
      }
      let donor: i32 = ssasem.update_base(ins);
      if (donor >= 0) {
        whole = marked_all(whole, [donor]);
      }
    }
    if (b.term.kind_tag == 1 && !paired) {
      whole = marked_all(whole, [b.term.value]);
    }
  }
  return whole;
}

function through_joins(defs: ssa.SInst[], whole0: boolean[]): boolean[] {
  let whole: boolean[] = whole0;
  let work: i32[] = [];
  let v: i32 = 0;
  while (v < whole.len()) {
    if (whole[v]) {
      work = work.append(v);
    }
    v = v + 1;
  }
  let k: i32 = 0;
  while (k < work.len()) {
    let w: i32 = work[k];
    k = k + 1;
    if (w >= defs.len()) {
      continue;
    }
    let ins: ssa.SInst = defs[w];
    if (ins.kind_tag != 7 && ins.kind_tag != 8) {
      continue;
    }
    for a in ins.args {
      if (a >= 0 && a < whole.len() && !whole[a]) {
        whole = whole.with(a, true);
        work = work.append(a);
      }
    }
  }
  return whole;
}

pub function reads_apart(k: i32): boolean {
  return k == ssasem.variant_is() || k == ssasem.variant_get() || k == ssasem.tuple_get() || k == ssasem.record_get();
}

function joins_apart(phi: ssa.SInst, defs: ssa.SInst[], ix: util.NameIndex, ok: boolean[], split: boolean[]): boolean {
  for a in phi.args {
    let d: ssa.SInst = semscalarreturn.through_copies(defs, a);
    let k: i32 = d.kind_tag;
    if (k != ssasem.variant_new() && k != ssasem.tuple_new() && k != ssasem.record_new() && k != ssasem.zero() && k != 8 && paired_callee(d, ix, ok) < 0 && !split_payload(d, defs, ix, split)) {
      return false;
    }
  }
  return true;
}

function split_payload(d: ssa.SInst, defs: ssa.SInst[], ix: util.NameIndex, split: boolean[]): boolean {
  return split.len() > 0 && d.kind_tag == ssasem.variant_get() && d.args.len() == 1 && paired_callee(semscalarreturn.through_copies(defs, d.args[0]), ix, split) >= 0;
}

function marked_all(own flags: boolean[], vs: i32[]): boolean[] {
  let out: boolean[] = flags;
  for v in vs {
    if (v >= 0 && v < out.len()) {
      out = out.with(v, true);
    }
  }
  return out;
}

function all_marked(flags: boolean[], vs: i32[]): boolean {
  for v in vs {
    if (v >= 0 && v < flags.len() && !flags[v]) {
      return false;
    }
  }
  return true;
}

struct Refs { calls: i32[], other: boolean[] }

function refs_of(funcs: ssasem.Func[], ix: util.NameIndex, rewrite: boolean[]): Refs {
  let calls: i32[] = [];
  let other: boolean[] = [];
  for f in funcs {
    calls = calls.append(0);
    other = other.append(false);
  }
  let j: i32 = 0;
  while (j < funcs.len()) {
    for b in funcs[j].graph.blocks {
      for ins in b.insts {
        let at: i32 = ix.find(ins.str);
        if (at >= 0 && ins.kind_tag == ssasem.call() && rewrite[j]) {
          calls = calls.with(at, calls[at] + 1);
        } else if (at >= 0 && !names_data(ins.kind_tag)) {
          other = other.with(at, true);
        }
      }
    }
    j = j + 1;
  }
  return Refs { calls: calls, other: other };
}

// These instructions carry data names or parameter labels, never function references.
function names_data(k: i32): boolean {
  return k == 5 || k == 8 || reads_apart(k) || k == ssasem.record_new() || k == ssasem.variant_new();
}

function shaped(f: ssasem.Func): boolean {
  if (pair_type(f, f.result) || semscalarreturn.eligible(f, f.result)) {
    return true;
  }
  let at: i32 = semrecords.find_enum(f.enums, f.result);
  if (at < 0) {
    return false;
  }
  let e: semrecords.Enum = f.enums[at];
  if (e.layout != semrecords.layout_variant() && e.layout != semrecords.layout_option()) {
    return false;
  }
  if (e.views || e.variants.len() == 0 || e.variants.len() > max_variants()) {
    return false;
  }
  return !ssasem.has_finalizer(f, f.result) && (payloads_fit(f, e) || semscalarreturn.variant_in_lanes(e));
}

function pair_type(f: ssasem.Func, t: typeinfo.Type): boolean {
  let parts: typeinfo.Type[] = pair_types(f, t);
  return parts.len() == 2 && carried(f, parts[0]) && word(f, parts[1]);
}

function pair_types(f: ssasem.Func, t: typeinfo.Type): typeinfo.Type[] {
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements;
  }
  return split_parts(f.records, f.finalizers, t);
}

function payloads_fit(f: ssasem.Func, e: semrecords.Enum): boolean {
  for v in e.variants {
    if (v.fields.len() > 1 || v.fields.len() == 1 && !word(f, v.fields[0].ty) && !ssasem.is_wide(v.fields[0].ty)) {
      return false;
    }
  }
  return true;
}

function word(f: ssasem.Func, t: typeinfo.Type): boolean {
  return fits_word(t) && !(ssasem.reference(t) && ssasem.holds_view(f, t));
}

function fits_word(t: typeinfo.Type): boolean {
  if (ssasem.reference(t)) {
    return true;
  }
  if (ssasem.is_wide(t) || ssasem.is_float(t)) {
    return false;
  }
  return ssasem.is_integer(t) || ssasem.is_bool(t) || ssasem.is_char(t) || semtypes.is_handle(t);
}

function may_split(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  return false;
}

function splits(f: ssasem.Func): boolean {
  let at: i32 = semrecords.find_enum(f.enums, f.result);
  if (at < 0 || semscalarreturn.variant_in_lanes(f.enums[at])) {
    return false;
  }
  for v in f.enums[at].variants {
    if (v.fields.len() == 1 && split_parts(f.records, f.finalizers, v.fields[0].ty).len() == 2) {
      return true;
    }
  }
  return false;
}

// The two words a variant payload splits into: a pair, or a record of two
// fields, each of which fits a word. Empty when the payload stays one word.
// The payload of a paired variant holds no view, so neither part does.
pub function split_parts(records: semrecords.Records, finalizers: ssasem.Finalizer[], t: typeinfo.Type): typeinfo.Type[] {
  if let typeinfo.TypeTuple(tup) = t {
    return two_words(tup.elements);
  }
  let parts: typeinfo.Type[] = [];
  if let typeinfo.TypeStruct(s) = t {
    let at: i32 = semrecords.find(records, t);
    if (at >= 0 && !records.list[at].views && ssasem.finalizer_index(finalizers, s.name) < 0) {
      for field in records.list[at].fields {
        parts = parts.append(field.ty);
      }
    }
  }
  return two_words(parts);
}

function two_words(parts: typeinfo.Type[]): typeinfo.Type[] {
  if (parts.len() != 2 || !fits_part(parts[0]) || !fits_part(parts[1])) {
    return [];
  }
  return parts;
}

// A split part fits its pair word, or is a 64-bit integer, which goes in the
// 64-bit lane of the same slot: the same register on x86-64 and arm64, an
// i64 global on wasm.
function fits_part(t: typeinfo.Type): boolean {
  return fits_word(t) || ssasem.is_wide(t);
}

function carried(f: ssasem.Func, t: typeinfo.Type): boolean {
  return word(f, t) || ssasem.is_wide(t) || ssasem.is_float(t);
}

function shape_of(f: ssasem.Func, ty: typeinfo.Type, split: boolean): Shape {
  let pair: typeinfo.Type[] = pair_types(f, ty);
  if (pair.len() == 2) {
    return Shape { ty: ty, names: [], payloads: pair, has: [true, true], pair: true, lanes: false, split: false, parts: [] };
  }
  let e: semrecords.Enum = f.enums[semrecords.find_enum(f.enums, ty)];
  let names: string[] = [];
  let payloads: typeinfo.Type[] = [];
  let has: boolean[] = [];
  let parts: typeinfo.Type[][] = [];
  for v in e.variants {
    names = names.append(v.name);
    let two: typeinfo.Type[] = [];
    if (v.fields.len() == 1) {
      payloads = payloads.append(v.fields[0].ty);
      has = has.append(true);
      if (split) {
        two = split_parts(f.records, f.finalizers, v.fields[0].ty);
      }
    } else {
      payloads = payloads.append(ty);
      has = has.append(false);
    }
    parts = parts.append(two);
  }
  return Shape { ty: ty, names: names, payloads: payloads, has: has, pair: false, lanes: semscalarreturn.variant_in_lanes(e), split: split, parts: parts };
}

// The types a variant's payload goes back in, one per pair word.
function word_types(sh: Shape, at: i32): typeinfo.Type[] {
  if (sh.parts[at].len() == 2) {
    return sh.parts[at];
  }
  return [sh.payloads[at]];
}

function pair_callee(f0: ssasem.Func, sh: Shape): ssasem.Func {
  let f: ssasem.Func = f0;
  let defs: ssa.SInst[] = defs_of(f.graph);
  let n: i32 = f.graph.blocks.len();
  let bi: i32 = 0;
  while (bi < n) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      let d: ssa.SInst = semscalarreturn.through_copies(defs, b.term.value);
      if (sh.pair) {
        f = pair_return(f, bi, sh, defs);
      } else if (d.kind_tag == ssasem.variant_new() && semtypes.equal(f.values[d.result], sh.ty)) {
        let at: i32 = util.index_of_str(sh.names, d.str);
        let arm: Arm = arm_return(Arm { f: f, insts: b.insts, tag: 0 - 1 }, sh, at, d.args, defs);
        f = with_block(arm.f, bi, ssa.SBlock { ...b, insts: arm.insts, term: ret(arm.tag) });
      } else {
        f = return_tested(f, bi, sh, defs);
      }
    }
    bi = bi + 1;
  }
  let calls: ssasem.Contract[] = f.calls;
  if (sh.pair) {
    calls = with_contract(calls, pair_set_contract(sh.payloads[1], 0));
  } else if (!sh.lanes) {
    for i in 0..sh.payloads.len() {
      let ts: typeinfo.Type[] = word_types(sh, i);
      for slot in 0..ts.len() {
        if (!in_lane(ts, slot)) {
          calls = with_contract(calls, pair_set_contract(ts[slot], slot));
        }
      }
    }
  }
  return ssasem.Func { ...f, result: pair_result(sh), calls: calls };
}

function pair_result(sh: Shape): typeinfo.Type {
  if (sh.pair) {
    return sh.payloads[0];
  }
  if (sh.lanes) {
    return semscalarreturn.word_type();
  }
  return t_i32();
}

function pair_return(f0: ssasem.Func, bi: i32, sh: Shape, defs: ssa.SInst[]): ssasem.Func {
  let b: ssa.SBlock = f0.graph.blocks[bi];
  let a: Parts = parts_of(Arm { f: f0, insts: b.insts, tag: 0 - 1 }, b.term.value, sh.ty, sh.payloads, defs);
  let f: ssasem.Func = a.a.f;
  let set: i32 = f.values.len();
  f = with_value(f, t_i32());
  let insts: ssa.SInst[] = a.a.insts.append(ssa.SInst { kind_tag: ssasem.call(), result: set, args: [a.words[1]], imm: 0, str: pair_set_name(sh.payloads[1], 0) });
  return with_block(f, bi, ssa.SBlock { ...b, insts: insts, term: ret(a.words[0]) });
}

struct Arm { f: ssasem.Func, insts: ssa.SInst[], tag: i32 }

function arm_return(a0: Arm, sh: Shape, at: i32, payload: i32[], defs: ssa.SInst[]): Arm {
  if (sh.lanes) {
    return arm_lanes(a0, sh, at, payload);
  }
  let a: Arm = a0;
  let words: i32[] = payload;
  let ts: typeinfo.Type[] = word_types(sh, at);
  if (payload.len() == 1 && ts.len() == 2) {
    let p: Parts = parts_of(a, payload[0], sh.payloads[at], ts, defs);
    a = p.a;
    words = p.words;
  }
  let f: ssasem.Func = a.f;
  let insts: ssa.SInst[] = a.insts;
  for slot in 0..words.len() {
    if (in_lane(ts, slot)) {
      let l: semscalarreturn.Lanes = semscalarreturn.lane_set(f, insts, words[slot], ts[slot], slot);
      f = l.f;
      insts = l.insts;
    } else {
      let set: i32 = f.values.len();
      f = with_value(f, t_i32());
      insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: set, args: [words[slot]], imm: 0, str: pair_set_name(ts[slot], slot) });
    }
  }
  let tag: i32 = f.values.len();
  f = with_value(f, t_i32());
  insts = insts.append(ssa.SInst { kind_tag: 1, result: tag, args: [], imm: at, str: "" });
  return Arm { f: f, insts: insts, tag: tag };
}

struct Parts { a: Arm, words: i32[] }

// A two-word payload's parts: a construction's arguments, or else read out of
// the payload.
function parts_of(a: Arm, v: i32, ty: typeinfo.Type, ts: typeinfo.Type[], defs: ssa.SInst[]): Parts {
  let d: ssa.SInst = semscalarreturn.through_copies(defs, v);
  let built: boolean = d.kind_tag == ssasem.record_new() || d.kind_tag == ssasem.tuple_new();
  if (built && d.args.len() == 2 && semtypes.equal(a.f.values[d.result], ty)) {
    return Parts { a: a, words: d.args };
  }
  let f: ssasem.Func = a.f;
  let insts: ssa.SInst[] = a.insts;
  let rec: i32 = semrecords.find(f.records, ty);
  let words: i32[] = [];
  for i in 0..ts.len() {
    let x: i32 = f.values.len();
    f = with_value(f, ts[i]);
    if (rec >= 0) {
      insts = insts.append(ssa.SInst { kind_tag: ssasem.record_get(), result: x, args: [v], imm: i, str: f.records.list[rec].fields[i].name });
    } else {
      insts = insts.append(ssa.SInst { kind_tag: ssasem.tuple_get(), result: x, args: [v], imm: i, str: "" });
    }
    words = words.append(x);
  }
  return Parts { a: Arm { ...a, f: f, insts: insts }, words: words };
}

function arm_lanes(a: Arm, sh: Shape, at: i32, payload: i32[]): Arm {
  let l: semscalarreturn.Lanes = semscalarreturn.Lanes { f: a.f, insts: a.insts, value: 0 - 1 };
  if (payload.len() == 1) {
    l = semscalarreturn.set_lanes(l.f, l.insts, payload[0], sh.payloads[at]);
  }
  l = semscalarreturn.tag_word(l.f, l.insts, at);
  return Arm { f: l.f, insts: l.insts, tag: l.value };
}

function return_tested(f0: ssasem.Func, bi: i32, sh: Shape, defs: ssa.SInst[]): ssasem.Func {
  let f: ssasem.Func = f0;
  let b: ssa.SBlock = f.graph.blocks[bi];
  let v: i32 = b.term.value;
  let n: i32 = sh.names.len();
  let first: i32 = next_block_id(f.graph);
  let tests: i32[] = test_ids(b.id, first + n, n);
  let i: i32 = 0;
  while (i < n) {
    let a: Arm = Arm { f: f, insts: [], tag: 0 - 1 };
    let payload: i32[] = [];
    if (sh.has[i]) {
      let x: i32 = a.f.values.len();
      a = Arm { ...a, f: with_value(a.f, sh.payloads[i]), insts: [ssa.SInst { kind_tag: ssasem.variant_get(), result: x, args: [v], imm: 0, str: sh.names[i] }] };
      payload = [x];
    }
    a = arm_return(a, sh, i, payload, defs);
    f = with_new_block(a.f, ssa.SBlock { id: first + i, insts: a.insts, term: ret(a.tag), preds: [tests[arm_test(i, n)]] });
    i = i + 1;
  }
  return tests_on(f, bi, tests, first, n, v, sh);
}

function calls_paired(f: ssasem.Func, ix: util.NameIndex, paired: boolean[]): boolean {
  for b in f.graph.blocks {
    if (paired_call_at(b, ix, paired) >= 0) {
      return true;
    }
  }
  return false;
}

function paired_call_at(b: ssa.SBlock, ix: util.NameIndex, paired: boolean[]): i32 {
  let k: i32 = 0;
  while (k < b.insts.len()) {
    let ins: ssa.SInst = b.insts[k];
    if (ins.kind_tag == ssasem.call() && ins.imm == 0) {
      let at: i32 = ix.find(ins.str);
      if (at >= 0 && paired[at]) {
        return k;
      }
    }
    k = k + 1;
  }
  return 0 - 1;
}

function rebuild_calls(f0: ssasem.Func, funcs: ssasem.Func[], ix: util.NameIndex, pg: Pairing): ssasem.Func {
  let f: ssasem.Func = f0;
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let k: i32 = paired_call_at(f.graph.blocks[bi], ix, pg.ok);
    if (k >= 0) {
      let at: i32 = ix.find(f.graph.blocks[bi].insts[k].str);
      f = rebuild_at(f, bi, k, funcs[at], pg.split[at]);
    } else {
      bi = bi + 1;
    }
  }
  return f;
}

function rebuild_at(f0: ssasem.Func, bi: i32, k: i32, callee: ssasem.Func, split: boolean): ssasem.Func {
  if (semscalarreturn.eligible(callee, callee.result)) {
    return semscalarreturn.caller(f0, bi, k, callee);
  }
  let f: ssasem.Func = f0;
  let b: ssa.SBlock = f.graph.blocks[bi];
  let call: ssa.SInst = b.insts[k];
  let sh: Shape = shape_of(callee, callee.result, split);
  if (sh.pair) {
    return rebuild_pair(f, bi, k, sh);
  }
  return dispatched(bi, k, sh, captured(f, call, sh), callee);
}

// lanes holds, per pair slot, the value its 64-bit lane is captured in, or -1.
struct Captured { f: ssasem.Func, insts: ssa.SInst[], tag: i32, w: i32, words: i32[], lanes: i32[] }

function captured(f0: ssasem.Func, call: ssa.SInst, sh: Shape): Captured {
  if (sh.lanes) {
    return captured_lanes(f0, call, sh);
  }
  let count: i32 = 1;
  if (sh.split) {
    count = 2;
  }
  let wide: i32 = 0;
  for i in 0..sh.payloads.len() {
    let ts: typeinfo.Type[] = word_types(sh, i);
    for slot in 0..ts.len() {
      if (in_lane(ts, slot)) {
        wide = wide | 1 << slot;
      }
    }
  }
  let tag: i32 = f0.values.len();
  let w: i32 = tag + 1;
  let f: ssasem.Func = with_value(f0, t_i32());
  let insts: ssa.SInst[] = [ssa.SInst { ...call, result: tag, imm: ssasem.pair_capture_imm(w, count, wide) }];
  let words: i32[] = [];
  for slot in 0..count {
    f = with_value(f, t_usize());
    insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: w + slot, args: [tag], imm: 0, str: pair_word_name(slot) });
    words = words.append(w + slot);
  }
  let lanes: i32[] = [0 - 1, 0 - 1];
  for slot in 0..2 {
    if ((wide >> slot & 1) != 0) {
      let lane: i32 = f.values.len();
      f = with_value(f, semscalarreturn.word_type());
      f = ssasem.Func { ...f, calls: with_contract(f.calls, lane_contract(slot)) };
      insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: lane, args: [tag], imm: 0, str: pair_lane_name(slot) });
      lanes = lanes.with(slot, lane);
    }
  }
  return Captured { f: f, insts: insts, tag: tag, w: w, words: words, lanes: lanes };
}

// in_lane says the split part at slot goes in that slot's 64-bit lane.
function in_lane(parts: typeinfo.Type[], slot: i32): boolean {
  return ssasem.is_wide(parts[slot]);
}

function captured_lanes(f0: ssasem.Func, call: ssa.SInst, sh: Shape): Captured {
  let count: i32 = 0;
  for t in sh.payloads {
    let n: i32 = semscalarreturn.lanes_of(t).len();
    if (n > count) {
      count = n;
    }
  }
  let w: i32 = f0.values.len();
  let f: ssasem.Func = with_value(f0, semscalarreturn.word_type());
  let words: i32[] = [];
  let k: i32 = 0;
  while (k < count) {
    words = words.append(f.values.len());
    f = with_value(f, semscalarreturn.word_type());
    k = k + 1;
  }
  let l: semscalarreturn.Lanes = semscalarreturn.Lanes { f: f, insts: [ssa.SInst { ...call, result: w, imm: semscalarreturn.capture_imm(w + 1, count) }], value: 0 - 1 };
  k = 0;
  while (k < count) {
    l = semscalarreturn.lane_word(l.f, l.insts, w, words[k], k);
    k = k + 1;
  }
  l = semscalarreturn.word_tag(l.f, l.insts, w);
  return Captured { f: l.f, insts: l.insts, tag: l.value, w: w, words: words, lanes: [] };
}

function arm_payload(f: ssasem.Func, insts: ssa.SInst[], sh: Shape, i: i32, c: Captured): semscalarreturn.Lanes {
  if (sh.lanes) {
    return semscalarreturn.from_lanes(f, insts, c.words, sh.payloads[i]);
  }
  let ts: typeinfo.Type[] = word_types(sh, i);
  let g: ssasem.Func = f;
  let out: ssa.SInst[] = insts;
  let parts: i32[] = [];
  for slot in 0..ts.len() {
    if (in_lane(ts, slot)) {
      let l: semscalarreturn.Lanes = semscalarreturn.lane_as(g, out, c.lanes[slot], ts[slot]);
      g = l.f;
      out = l.insts;
      parts = parts.append(l.value);
    } else {
      let x: i32 = g.values.len();
      g = with_value(g, ts[slot]);
      out = out.append(ssa.SInst { kind_tag: ssasem.call(), result: x, args: [c.words[slot]], imm: 0, str: word_as_name(ts[slot]) });
      parts = parts.append(x);
    }
  }
  if (ts.len() == 1) {
    return semscalarreturn.Lanes { f: g, insts: out, value: parts[0] };
  }
  let kind: i32 = ssasem.record_new();
  if let typeinfo.TypeTuple(_) = sh.payloads[i] {
    kind = ssasem.tuple_new();
  }
  let v: i32 = g.values.len();
  return semscalarreturn.Lanes { f: with_value(g, sh.payloads[i]), insts: out.append(ssa.SInst { kind_tag: kind, result: v, args: parts, imm: 0, str: "" }), value: v };
}

function dispatched(bi: i32, k: i32, sh: Shape, c: Captured, callee: ssasem.Func): ssasem.Func {
  let f: ssasem.Func = c.f;
  let b: ssa.SBlock = f.graph.blocks[bi];
  let call: ssa.SInst = b.insts[k];
  let n: i32 = sh.names.len();
  let first: i32 = next_block_id(f.graph);
  let tests: i32[] = test_ids(b.id, first + n, n);
  let join: i32 = first + n + tests.len() - 1;
  let head: ssa.SInst[] = util.append_all(before(b.insts, k), c.insts);
  let built: i32[] = [];
  let arms: i32[] = [];
  let i: i32 = 0;
  while (i < n) {
    let l: semscalarreturn.Lanes = semscalarreturn.Lanes { f: f, insts: [], value: 0 - 1 };
    let args: i32[] = [];
    if (sh.has[i]) {
      l = arm_payload(f, [], sh, i, c);
      args = [l.value];
    }
    let r: i32 = l.f.values.len();
    f = with_value(l.f, sh.ty);
    let insts: ssa.SInst[] = l.insts.append(ssa.SInst { kind_tag: ssasem.variant_new(), result: r, args: args, imm: 0, str: sh.names[i] });
    f = with_new_block(f, ssa.SBlock { id: first + i, insts: insts, term: br(join), preds: [tests[arm_test(i, n)]] });
    built = built.append(r);
    arms = arms.append(first + i);
    i = i + 1;
  }
  let joined: ssa.SInst[] = [ssa.SInst { kind_tag: 8, result: call.result, args: built, imm: 0, str: "" }];
  f = with_new_block(f, ssa.SBlock { id: join, insts: util.append_all(joined, after(b.insts, k)), term: b.term, preds: arms });
  f = repointed(f, term_targets(b.term), b.id, join);
  f = with_block(f, bi, ssa.SBlock { ...f.graph.blocks[bi], insts: head });
  f = tests_on(f, bi, tests, first, n, c.tag, sh);
  return with_callee_enum(ssasem.Func { ...f, calls: dispatch_contracts(f.calls, call.str, sh) }, callee, sh);
}

function before(insts: ssa.SInst[], k: i32): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  let p: i32 = 0;
  while (p < k) {
    out = out.append(insts[p]);
    p = p + 1;
  }
  return out;
}

function after(insts: ssa.SInst[], k: i32): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  let p: i32 = k + 1;
  while (p < insts.len()) {
    out = out.append(insts[p]);
    p = p + 1;
  }
  return out;
}

function dispatch_contracts(calls0: ssasem.Contract[], name: string, sh: Shape): ssasem.Contract[] {
  let calls: ssasem.Contract[] = calls0;
  let at: i32 = ssasem.find_contract_in(calls, name);
  calls = calls.with(at, ssasem.Contract { ...calls[at], result: pair_result(sh) });
  if (sh.lanes) {
    return calls;
  }
  calls = with_contract(calls, word_contract(0));
  if (sh.split) {
    calls = with_contract(calls, word_contract(1));
  }
  for i in 0..sh.payloads.len() {
    let ts: typeinfo.Type[] = word_types(sh, i);
    for slot in 0..ts.len() {
      if (!in_lane(ts, slot)) {
        calls = with_contract(calls, ssasem.Contract { name: word_as_name(ts[slot]), params: [t_usize()], modes: [ssasem.value_mode()], result: ts[slot] });
      }
    }
  }
  return calls;
}

function word_contract(slot: i32): ssasem.Contract {
  return ssasem.Contract { name: pair_word_name(slot), params: [t_i32()], modes: [ssasem.value_mode()], result: t_usize() };
}

function with_callee_enum(f0: ssasem.Func, callee: ssasem.Func, sh: Shape): ssasem.Func {
  let f: ssasem.Func = f0;
  if (semrecords.find_enum(f.enums, sh.ty) < 0) {
    f = ssasem.Func { ...f, enums: f.enums.append(callee.enums[semrecords.find_enum(callee.enums, sh.ty)]) };
  }
  for i in 0..sh.payloads.len() {
    let at: i32 = semrecords.find(callee.records, sh.payloads[i]);
    if (sh.parts[i].len() == 2 && at >= 0 && semrecords.find(f.records, sh.payloads[i]) < 0) {
      f = ssasem.Func { ...f, records: semrecords.records_of(f.records.list.append(callee.records.list[at])) };
    }
  }
  return f;
}

function rebuild_pair(f0: ssasem.Func, bi: i32, k: i32, sh: Shape): ssasem.Func {
  let f: ssasem.Func = f0;
  let b: ssa.SBlock = f.graph.blocks[bi];
  let call: ssa.SInst = b.insts[k];
  let first: i32 = f.values.len();
  let zero: i32 = first + 1;
  let w: i32 = zero + 1;
  let second: i32 = w + 1;
  let kind: i32 = ssasem.tuple_new();
  if let typeinfo.TypeStruct(_) = sh.ty {
    kind = ssasem.record_new();
  }
  f = with_value(with_value(with_value(with_value(f, sh.payloads[0]), t_i32()), t_usize()), sh.payloads[1]);
  let insts: ssa.SInst[] = [];
  let p: i32 = 0;
  while (p < b.insts.len()) {
    if (p == k) {
      insts = insts.append(ssa.SInst { ...call, result: first, imm: ssasem.pair_capture_imm(w, 1, 0) });
      insts = insts.append(ssa.SInst { kind_tag: 1, result: zero, args: [], imm: 0, str: "" });
      insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: w, args: [zero], imm: 0, str: pair_word_name(0) });
      insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: second, args: [w], imm: 0, str: word_as_name(sh.payloads[1]) });
      insts = insts.append(ssa.SInst { kind_tag: kind, result: call.result, args: [first, second], imm: 0, str: "" });
    } else {
      insts = insts.append(b.insts[p]);
    }
    p = p + 1;
  }
  f = with_block(f, bi, ssa.SBlock { ...b, insts: insts });
  let calls: ssasem.Contract[] = f.calls;
  let at: i32 = ssasem.find_contract_in(calls, call.str);
  calls = calls.with(at, ssasem.Contract { ...calls[at], result: sh.payloads[0] });
  calls = with_contract(calls, word_contract(0));
  calls = with_contract(calls, ssasem.Contract { name: word_as_name(sh.payloads[1]), params: [t_usize()], modes: [ssasem.value_mode()], result: sh.payloads[1] });
  return ssasem.Func { ...f, calls: calls };
}

function test_ids(start: i32, next: i32, n: i32): i32[] {
  let out: i32[] = [start];
  let j: i32 = 1;
  while (j < n - 1) {
    out = out.append(next + j - 1);
    j = j + 1;
  }
  return out;
}

function arm_test(i: i32, n: i32): i32 {
  if (i < n - 1) {
    return i;
  }
  if (n > 1) {
    return n - 2;
  }
  return 0;
}

function tests_on(f0: ssasem.Func, bi: i32, tests: i32[], first: i32, n: i32, v: i32, sh: Shape): ssasem.Func {
  let f: ssasem.Func = f0;
  if (n == 1) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    return with_block(f, bi, ssa.SBlock { ...b, term: br(first) });
  }
  let j: i32 = 0;
  while (j < n - 1) {
    let next: i32 = first + n - 1;
    if (j + 1 < n - 1) {
      next = tests[j + 1];
    }
    let t: Test = test(f, v, j, sh);
    let term: ssa.STerm = ssa.STerm { kind_tag: 3, cond: t.cond, target: 0, t: first + j, f: next, value: 0 };
    f = t.f;
    if (j == 0) {
      let b: ssa.SBlock = f.graph.blocks[bi];
      f = with_block(f, bi, ssa.SBlock { ...b, insts: util.append_all(b.insts, t.insts), term: term });
    } else {
      f = with_new_block(f, ssa.SBlock { id: tests[j], insts: t.insts, term: term, preds: [tests[j - 1]] });
    }
    j = j + 1;
  }
  return f;
}

struct Test { f: ssasem.Func, insts: ssa.SInst[], cond: i32 }

function test(f0: ssasem.Func, v: i32, j: i32, sh: Shape): Test {
  let f: ssasem.Func = f0;
  let cond: i32 = f.values.len();
  if (semtypes.equal(f.values[v], sh.ty)) {
    f = with_value(f, t_bool());
    return Test { f: f, insts: [ssa.SInst { kind_tag: ssasem.variant_is(), result: cond, args: [v], imm: 0, str: sh.names[j] }], cond: cond };
  }
  let c: i32 = cond;
  cond = c + 1;
  f = with_value(with_value(f, t_i32()), t_bool());
  let insts: ssa.SInst[] = [
    ssa.SInst { kind_tag: 1, result: c, args: [], imm: j, str: "" },
    ssa.SInst { kind_tag: 9, result: cond, args: [v, c], imm: 0, str: "==" },
  ];
  return Test { f: f, insts: insts, cond: cond };
}

function pair_lane_name(slot: i32): string {
  if (slot == 1) {
    return "__pair_lane1";
  }
  return "__pair_lane";
}

// The pair slot whose 64-bit lane a caller's read names, or -1.
pub function pair_lane_slot(name: string): i32 {
  if (name == "__pair_lane") {
    return 0;
  }
  if (name == "__pair_lane1") {
    return 1;
  }
  return 0 - 1;
}

function lane_contract(slot: i32): ssasem.Contract {
  return ssasem.Contract { name: pair_lane_name(slot), params: [t_i32()], modes: [ssasem.value_mode()], result: semscalarreturn.word_type() };
}

function pair_word_name(slot: i32): string {
  if (slot == 1) {
    return "__pair_word1";
  }
  return "__pair_word";
}

// The pair word a caller's read names, or -1.
pub function pair_word_slot(name: string): i32 {
  if (name == "__pair_word") {
    return 0;
  }
  if (name == "__pair_word1") {
    return 1;
  }
  return 0 - 1;
}

pub function word_as_prefix(): string {
  return "__word_as:";
}

function pair_set_prefix(slot: i32): string {
  if (slot == 1) {
    return "__pair_set1:";
  }
  return "__pair_set:";
}

// The pair word a callee's set names, or -1.
pub function pair_set_slot(name: string): i32 {
  if (util.str_has_prefix(name, pair_set_prefix(0))) {
    return 0;
  }
  if (util.str_has_prefix(name, pair_set_prefix(1))) {
    return 1;
  }
  return 0 - 1;
}

function word_as_name(t: typeinfo.Type): string {
  return word_as_prefix() + typeinfo.spelling(t);
}

function pair_set_name(t: typeinfo.Type, slot: i32): string {
  return pair_set_prefix(slot) + typeinfo.spelling(t);
}

function pair_set_contract(t: typeinfo.Type, slot: i32): ssasem.Contract {
  let mode: i32 = ssasem.value_mode();
  if (semtypes.needs_anchor(t)) {
    mode = ssasem.counted_mode();
  }
  return ssasem.Contract { name: pair_set_name(t, slot), params: [t], modes: [mode], result: t_i32() };
}

function t_i32(): typeinfo.Type {
  return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: false };
}

function t_usize(): typeinfo.Type {
  return typeinfo.TypeI32 { width: typeinfo.width_ptr(), unsigned: true, is_char: false, polymorphic: false };
}

function t_bool(): typeinfo.Type {
  return typeinfo.TypeBool { tag: 0 };
}

function ret(value: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: value };
}

function br(target: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function term_targets(t: ssa.STerm): i32[] {
  if (t.kind_tag == 2) {
    return [t.target];
  }
  if (t.kind_tag == 3) {
    return [t.t, t.f];
  }
  return [];
}

function next_block_id(g: ssa.SFunc): i32 {
  let hi: i32 = 0;
  for b in g.blocks {
    if (b.id >= hi) {
      hi = b.id + 1;
    }
  }
  return hi;
}

function with_value(f: ssasem.Func, t: typeinfo.Type): ssasem.Func {
  let n: i32 = f.values.len() + 1;
  return ssasem.Func { ...f, graph: ssa.SFunc { ...f.graph, nvals: n }, values: f.values.append(t) };
}

function with_block(f: ssasem.Func, bi: i32, b: ssa.SBlock): ssasem.Func {
  return ssasem.Func { ...f, graph: ssa.SFunc { ...f.graph, blocks: f.graph.blocks.with(bi, b) } };
}

function with_new_block(f: ssasem.Func, b: ssa.SBlock): ssasem.Func {
  return ssasem.Func { ...f, graph: ssa.SFunc { ...f.graph, blocks: f.graph.blocks.append(b) } };
}

function repointed(f: ssasem.Func, targets: i32[], from: i32, to: i32): ssasem.Func {
  let blocks: ssa.SBlock[] = [];
  for b in f.graph.blocks {
    if (has(targets, b.id)) {
      let preds: i32[] = [];
      for q in b.preds {
        if (q == from) {
          preds = preds.append(to);
        } else {
          preds = preds.append(q);
        }
      }
      blocks = blocks.append(ssa.SBlock { ...b, preds: preds });
    } else {
      blocks = blocks.append(b);
    }
  }
  return ssasem.Func { ...f, graph: ssa.SFunc { ...f.graph, blocks: blocks } };
}

function has(xs: i32[], v: i32): boolean {
  for x in xs {
    if (x == v) {
      return true;
    }
  }
  return false;
}

function with_contract(calls: ssasem.Contract[], c: ssasem.Contract): ssasem.Contract[] {
  if (ssasem.find_contract_in(calls, c.name) >= 0) {
    return calls;
  }
  return calls.append(c);
}

function defs_of(g: ssa.SFunc): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  let v: i32 = 0;
  while (v < g.nvals) {
    out = out.append(ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" });
    v = v + 1;
  }
  for b in g.blocks {
    for ins in b.insts {
      if (ins.result >= 0 && ins.result < out.len()) {
        out = out.with(ins.result, ins);
      }
    }
  }
  return out;
}

pub struct Scalarized { funcs: ssasem.Func[], modes: i32[][], changed: boolean[] }

// Passes a record parameter of scalar fields as its fields when every call
// names the callee directly and the callee only reads the record apart or
// hands it on to another such parameter.
pub function scalar_params(funcs: ssasem.Func[], names: string[], rewrite: boolean[], unnamed: boolean[], modes: i32[][]): Scalarized {
  let ix: util.NameIndex = util.name_index(names);
  let split: boolean[][] = param_candidates(funcs, names, ix, rewrite, unnamed, modes);
  split = params_kept_apart(funcs, ix, split, modes);
  let sites: Sites = Sites { funcs: funcs, modes: modes, ix: ix, split: split, lay: no_layout() };
  let out: ssasem.Func[] = [];
  let out_modes: i32[][] = [];
  let changed: boolean[] = [];
  for i in 0..funcs.len() {
    let f: ssasem.Func = funcs[i];
    let m: i32[] = modes[i];
    let c: boolean = false;
    if (rewrite[i] && has_sites(f, sites)) {
      f = split_calls(f, sites, split[i]);
      c = true;
    }
    let p: i32 = split[i].len() - 1;
    while (p >= 0) {
      if (split[i][p]) {
        let parts: typeinfo.Type[] = semscalarreturn.param_parts(f, f.params[p]);
        f = semscalarreturn.split_param(f, p, parts);
        m = spliced_modes(m, p, parts.len());
        c = true;
      }
      p = p - 1;
    }
    out = out.append(f);
    out_modes = out_modes.append(m);
    changed = changed.append(c);
  }
  return Scalarized { funcs: out, modes: out_modes, changed: changed };
}

function param_candidates(funcs: ssasem.Func[], names: string[], ix: util.NameIndex, rewrite: boolean[], unnamed: boolean[], modes: i32[][]): boolean[][] {
  let refs: Refs = refs_of(funcs, ix, rewrite);
  let anchored: util.NameIndex = util.name_index(anchored_callees(funcs));
  let out: boolean[][] = [];
  for i in 0..funcs.len() {
    let f: ssasem.Func = funcs[i];
    let ok: boolean = refs.calls[i] > 0 && !refs.other[i] && rewrite[i] && unnamed[i] && !anchored.has(names[i]) && modes[i].len() == f.params.len() && f.graph.nparams == f.params.len();
    let row: boolean[] = [];
    for t in f.params {
      row = row.append(ok && semscalarreturn.param_parts(f, t).len() > 0);
    }
    out = out.append(row);
  }
  return out;
}

function anchored_callees(funcs: ssasem.Func[]): string[] {
  let out: string[] = [];
  for f in funcs {
    for a in f.anchors {
      out = out.append(a.name);
    }
  }
  return out;
}

// Drops a candidate whose parameter some body uses whole, other than by
// handing it on to a candidate parameter of the same type.
function params_kept_apart(funcs: ssasem.Func[], ix: util.NameIndex, split0: boolean[][], modes: i32[][]): boolean[][] {
  let split: boolean[][] = split0;
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for j in 0..funcs.len() {
      let f: ssasem.Func = funcs[j];
      for b in f.graph.blocks {
        for ins in b.insts {
          // A consumed update donor must retain its box for in-place reuse.
          let donor: i32 = ssasem.update_base(ins);
          if (donor >= 0 && donor < split[j].len() && split[j][donor] && modes[j][donor] == ssasem.counted_mode()) {
            split = split.with(j, split[j].with(donor, false));
            changed = true;
          }
          for pos in 0..ins.args.len() {
            let a: i32 = ins.args[pos];
            if (a >= 0 && a < split[j].len() && split[j][a] && !param_read_apart(funcs, ix, split, f, ins, pos)) {
              split = split.with(j, split[j].with(a, false));
              changed = true;
            }
          }
        }
        let t: ssa.STerm = b.term;
        let used: i32 = 0 - 1;
        if (t.kind_tag == 1) {
          used = t.value;
        }
        if (t.kind_tag == 3) {
          used = t.cond;
        }
        if (used >= 0 && used < split[j].len() && split[j][used]) {
          split = split.with(j, split[j].with(used, false));
          changed = true;
        }
      }
    }
  }
  return split;
}

function param_read_apart(funcs: ssasem.Func[], ix: util.NameIndex, split: boolean[][], f: ssasem.Func, ins: ssa.SInst, pos: i32): boolean {
  if (reads_apart(ins.kind_tag) && ins.args.len() == 1) {
    return true;
  }
  if (ins.kind_tag != ssasem.call()) {
    return false;
  }
  let at: i32 = ix.find(ins.str);
  return at >= 0 && pos < split[at].len() && split[at][pos] && semtypes.equal(funcs[at].params[pos], f.params[ins.args[pos]]);
}

// The instructions whose operands travel as parts: calls to callees taking
// split parameters, and constructions of records laid out in place.
struct Sites { funcs: ssasem.Func[], modes: i32[][], ix: util.NameIndex, split: boolean[][], lay: Layout }

struct Site { decl: ssasem.Contract, split: boolean[], call: boolean }

function site_of(f: ssasem.Func, ins: ssa.SInst, s: Sites): Site {
  let at: i32 = split_callee(ins, s.ix, s.split);
  if (at >= 0) {
    let decl: ssasem.Contract = ssasem.Contract { name: ins.str, params: s.funcs[at].params, modes: s.modes[at], result: s.funcs[at].result };
    return Site { decl: decl, split: s.split[at], call: true };
  }
  if (ins.kind_tag == ssasem.record_new()) {
    let r: i32 = laid_index(s.lay, f.values[ins.result]);
    if (r >= 0) {
      let decl: ssasem.Contract = ssasem.Contract { name: "", params: field_types(s.lay.list[r].old), modes: [], result: f.values[ins.result] };
      return Site { decl: decl, split: s.lay.list[r].flat, call: false };
    }
  }
  return Site { decl: ssasem.Contract { name: "", params: [], modes: [], result: t_i32() }, split: [], call: false };
}

function has_sites(f: ssasem.Func, s: Sites): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (site_of(f, ins, s).split.len() > 0) {
        return true;
      }
    }
  }
  return false;
}

function split_site(f: ssasem.Func, ins: ssa.SInst, site: Site, defs: ssa.SInst[], given: semscalarreturn.Given): semscalarreturn.SplitCall {
  if (site.call) {
    return semscalarreturn.split_args(f, ins, site.decl, site.split, defs, given);
  }
  let ops: semscalarreturn.Operands = semscalarreturn.split_operands(f, ins, site.decl, site.split, defs, given);
  return semscalarreturn.SplitCall { f: ops.f, insts: ops.insts, call: ssa.SInst { ...ins, args: ops.args } };
}

function split_callee(ins: ssa.SInst, ix: util.NameIndex, split: boolean[][]): i32 {
  if (ins.kind_tag != ssasem.call()) {
    return 0 - 1;
  }
  let at: i32 = ix.find(ins.str);
  if (at < 0) {
    return 0 - 1;
  }
  for s in split[at] {
    if (s) {
      return at;
    }
  }
  return 0 - 1;
}

// Rewrites each site to take its operands as parts. An Option operand that
// is neither built for the site nor already travelling as parts is taken
// apart on a branch on whether it is Some. The branch splits the site's
// block and moves the site, still unrewritten, to the join, where `pending`
// holds the parts read so far; `done` counts the leading instructions of a
// block already rewritten.
function split_calls(f0: ssasem.Func, sites: Sites, own: boolean[]): ssasem.Func {
  let f: ssasem.Func = f0;
  let defs: ssa.SInst[] = defs_of(f.graph);
  let done: i32[] = [];
  let pending: semscalarreturn.Given[] = [];
  for b in f.graph.blocks {
    done = done.append(0);
    pending = pending.append(semscalarreturn.no_given());
  }
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    let insts: ssa.SInst[] = [];
    for j in 0..done[bi] {
      insts = insts.append(b.insts[j]);
    }
    let branched: boolean = false;
    for k in done[bi]..b.insts.len() {
      let ins: ssa.SInst = b.insts[k];
      let site: Site = site_of(f, ins, sites);
      if (site.split.len() == 0) {
        insts = insts.append(ins);
        continue;
      }
      let given: semscalarreturn.Given = semscalarreturn.no_given();
      if (k == done[bi]) {
        given = pending[bi];
      }
      let u: i32 = branch_position(f, defs, site, ins, own, given);
      if (u < 0) {
        let sc: semscalarreturn.SplitCall = split_site(f, ins, site, defs, given);
        f = sc.f;
        insts = util.append_all(insts, sc.insts).append(sc.call);
        continue;
      }
      let br: semscalarreturn.Branch = semscalarreturn.branch_parts(f, ins.args[u], site.decl.params[u]);
      f = branched_block(br.f, bi, b, util.append_all(insts, br.head), br, br.joins.append(ins), k + 1);
      done = done.append(0).append(0).append(br.joins.len());
      let read: semscalarreturn.Given = semscalarreturn.Given { at: given.at.append(u), parts: given.parts.append(br.parts) };
      pending = pending.append(semscalarreturn.no_given()).append(semscalarreturn.no_given()).append(read);
      branched = true;
      break;
    }
    if (!branched) {
      f = with_block(f, bi, ssa.SBlock { ...b, insts: insts });
    }
    bi = bi + 1;
  }
  return f;
}

function branch_position(f: ssasem.Func, defs: ssa.SInst[], site: Site, ins: ssa.SInst, own: boolean[], given: semscalarreturn.Given): i32 {
  for pos in 0..ins.args.len() {
    let open: boolean = pos < site.split.len() && site.split[pos] && !has(given.at, pos);
    if (open && semscalarreturn.needs_branch(f, defs, site.decl.params[pos], ins.args[pos], own)) {
      return pos;
    }
  }
  return 0 - 1;
}

// Ends block `bi` with a branch on the Option's flag to a block reading its
// payload and a block of zeros, both joining in a new block that holds the
// site and the rest of the old block, and takes over its terminator.
function branched_block(f0: ssasem.Func, bi: i32, b: ssa.SBlock, head: ssa.SInst[], branch: semscalarreturn.Branch, joined: ssa.SInst[], rest: i32): ssasem.Func {
  let some_id: i32 = next_block_id(f0.graph);
  let none_id: i32 = some_id + 1;
  let join_id: i32 = some_id + 2;
  let tail: ssa.SInst[] = joined;
  for k in rest..b.insts.len() {
    tail = tail.append(b.insts[k]);
  }
  let f: ssasem.Func = repointed(f0, term_targets(b.term), b.id, join_id);
  let start: ssa.SBlock = ssa.SBlock { ...b, insts: head, term: ssa.STerm { kind_tag: 3, cond: branch.flag, target: 0, t: some_id, f: none_id, value: 0 } };
  f = with_block(f, bi, start);
  f = with_new_block(f, ssa.SBlock { id: some_id, insts: branch.some, term: br(join_id), preds: [b.id] });
  f = with_new_block(f, ssa.SBlock { id: none_id, insts: branch.none, term: br(join_id), preds: [b.id] });
  return with_new_block(f, ssa.SBlock { id: join_id, insts: tail, term: b.term, preds: [some_id, none_id] });
}

function spliced_modes(modes: i32[], at: i32, n: i32): i32[] {
  let out: i32[] = [];
  for i in 0..modes.len() {
    if (i == at) {
      for _ in 0..n {
        out = out.append(ssasem.value_mode());
      }
    } else {
      out = out.append(modes[i]);
    }
  }
  return out;
}

// A record whose fields of scalar records or Options are laid out in its own
// box, each as its parts. `flat` marks those fields; `at` is where each old
// field starts in `laid`.
struct Relay { key: string, old: semrecords.Record, flat: boolean[], parts: typeinfo.Type[][], payloads: typeinfo.Type[][], laid: semrecords.Record, at: i32[] }

pub struct Layout { keys: util.NameIndex, list: Relay[] }

function no_layout(): Layout {
  return Layout { keys: util.name_index([]), list: [] };
}

function laid_index(lay: Layout, t: typeinfo.Type): i32 {
  if (lay.list.len() == 0) {
    return 0 - 1;
  }
  if let typeinfo.TypeStruct(_) = t {
    return lay.keys.find(ssasem.type_key(t));
  }
  return 0 - 1;
}

function field_types(r: semrecords.Record): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for fl in r.fields {
    out = out.append(fl.ty);
  }
  return out;
}

function any_true(xs: boolean[]): boolean {
  for x in xs {
    if (x) {
      return true;
    }
  }
  return false;
}

pub struct Laid { funcs: ssasem.Func[], records: semrecords.Record[], changed: boolean[] }

// Lays out each record field that is a record of one to four scalars, or an
// Option of one or of a scalar, as its parts in its record's own box. A field
// is laid out when every read of it takes it apart and no code outside these
// bodies can see its record's layout.
pub function laid_fields(funcs: ssasem.Func[], names: string[], rewrite: boolean[]): Laid {
  let ix: util.NameIndex = util.name_index(names);
  let lay: Layout = field_candidates(funcs, rewrite);
  lay = unexposed(lay, funcs, ix, rewrite);
  lay = settled(fields_kept_apart(lay, funcs, rewrite));
  let records: semrecords.Record[] = [];
  for r in lay.list {
    records = records.append(r.laid);
  }
  let out: ssasem.Func[] = [];
  let changed: boolean[] = [];
  for i in 0..funcs.len() {
    let f: ssasem.Func = funcs[i];
    let c: boolean = records.len() > 0 && rewrite[i] && touches(f, lay);
    if (c) {
      f = relaid(f, lay);
    }
    if (records.len() > 0) {
      f = with_laid_records(f, lay);
    }
    out = out.append(f);
    changed = changed.append(c);
  }
  return Laid { funcs: out, records: records, changed: changed };
}

function field_candidates(funcs: ssasem.Func[], rewrite: boolean[]): Layout {
  let seen: util.NameIndex = util.name_index([]);
  let list: Relay[] = [];
  let keys: string[] = [];
  for i in 0..funcs.len() {
    if (!rewrite[i]) {
      continue;
    }
    let f: ssasem.Func = funcs[i];
    for rec in f.records.list {
      let key: string = ssasem.type_key(rec.ty);
      if (seen.has(key)) {
        continue;
      }
      seen = seen.added(key);
      let r: Relay = relay_of(f, rec, key);
      if (laid_candidate(f, rec) && any_true(r.flat)) {
        list = list.append(r);
        keys = keys.append(key);
      }
    }
  }
  return Layout { keys: util.name_index(keys), list: list };
}

function laid_candidate(f: ssasem.Func, rec: semrecords.Record): boolean {
  if let typeinfo.TypeStruct(s) = rec.ty {
    return s.args.len() == 0 && !semtypes.is_env(rec.ty) && !rec.views && !rec.nests_func && !ssasem.has_finalizer(f, rec.ty);
  }
  return false;
}

function relay_of(f: ssasem.Func, rec: semrecords.Record, key: string): Relay {
  let flat: boolean[] = [];
  let parts: typeinfo.Type[][] = [];
  let payloads: typeinfo.Type[][] = [];
  for fl in rec.fields {
    let p: typeinfo.Type[] = semscalarreturn.param_parts(f, fl.ty);
    flat = flat.append(p.len() > 0);
    parts = parts.append(p);
    payloads = payloads.append(semscalarreturn.option_payload(f, fl.ty));
  }
  return Relay { key: key, old: rec, flat: flat, parts: parts, payloads: payloads, laid: rec, at: [] };
}

// Drops every record that code outside these bodies could see: one reaching a
// callee without a body here, a dynamic value, a map, or a construction hole.
function unexposed(lay0: Layout, funcs: ssasem.Func[], ix: util.NameIndex, rewrite: boolean[]): Layout {
  let lay: Layout = lay0;
  for i in 0..funcs.len() {
    if (rewrite[i] && lay.list.len() > 0) {
      lay = unexposed_in(lay, funcs[i], ix, rewrite);
    }
  }
  return lay;
}

function unexposed_in(lay0: Layout, f: ssasem.Func, ix: util.NameIndex, rewrite: boolean[]): Layout {
  let lay: Layout = lay0;
  let seen: util.NameIndex = util.name_index([]);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (!exposes(ins, ix, rewrite)) {
        continue;
      }
      for t in operand_types(f, ins) {
        let key: string = ssasem.type_key(t);
        if (!seen.has(key)) {
          seen = seen.added(key);
          lay = without_records(lay, reached_records(f, t));
        }
      }
    }
  }
  return lay;
}

function exposes(ins: ssa.SInst, ix: util.NameIndex, rewrite: boolean[]): boolean {
  let k: i32 = ins.kind_tag;
  if (k == ssasem.call()) {
    let at: i32 = ix.find(ins.str);
    return at < 0 || !rewrite[at];
  }
  let maps: boolean = k <= ssasem.map_new() && k >= ssasem.map_cleared();
  let dyns: boolean = k <= ssasem.dyn_up() && k >= ssasem.dyn_as();
  return maps || dyns || k == ssasem.hole_at() || k == ssasem.hole_fill();
}

function operand_types(f: ssasem.Func, ins: ssa.SInst): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for a in ins.args {
    if (a >= 0 && a < f.values.len()) {
      out = out.append(f.values[a]);
    }
  }
  if (ins.result >= 0 && ins.result < f.values.len()) {
    out = out.append(f.values[ins.result]);
  }
  return out;
}

// The keys of the records a value of type `t0` can hold. A function or a
// dynamic value hides nothing here: its body, or the conversion to it, is
// one of these bodies.
function reached_records(f: ssasem.Func, t0: typeinfo.Type): string[] {
  let out: string[] = [];
  let seen: util.NameIndex = util.name_index([]);
  let work: typeinfo.Type[] = [t0];
  while (work.len() > 0) {
    let next: typeinfo.Type[] = [];
    for t in work {
      let key: string = ssasem.type_key(t);
      if (seen.has(key)) {
        continue;
      }
      seen = seen.added(key);
      if (semrecords.find(f.records, t) >= 0) {
        out = out.append(key);
      }
      next = util.append_all(next, held_types(f, t));
    }
    work = next;
  }
  return out;
}

function held_types(f: ssasem.Func, t: typeinfo.Type): typeinfo.Type[] {
  if (semtypes.is_cell(t)) {
    return [semtypes.cell_elem(t)];
  }
  match (t) {
    typeinfo.TypeArray(a) => {
      return [a.elem];
    },
    typeinfo.TypeTuple(tup) => {
      return tup.elements;
    },
    typeinfo.TypeMap(m) => {
      return [m.key, m.value];
    },
    typeinfo.TypeStruct(_) => {
      let at: i32 = semrecords.find(f.records, t);
      if (at >= 0) {
        return field_types(f.records.list[at]);
      }
    },
    typeinfo.TypeUnion(_) => {
      return variant_types(f, t);
    },
    _ => {}
  }
  return [];
}

function variant_types(f: ssasem.Func, t: typeinfo.Type): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0) {
    return out;
  }
  for v in f.enums[at].variants {
    for fl in v.fields {
      out = out.append(fl.ty);
    }
  }
  return out;
}

function without_records(lay: Layout, keys: string[]): Layout {
  let list: Relay[] = lay.list;
  for key in keys {
    let r: i32 = lay.keys.find(key);
    if (r >= 0) {
      list = list.with(r, Relay { ...list[r], flat: __alloc_bool(list[r].flat.len()) });
    }
  }
  return Layout { ...lay, list: list };
}

struct FieldRef { r: i32, i: i32 }

function no_field(): FieldRef {
  return FieldRef { r: 0 - 1, i: 0 };
}

// The field of a laid-out record that `ins` reads, if it reads one.
function read_field(f: ssasem.Func, lay: Layout, ins: ssa.SInst): FieldRef {
  if (ins.kind_tag != ssasem.record_get() || ins.args.len() != 1) {
    return no_field();
  }
  let r: i32 = laid_index(lay, f.values[ins.args[0]]);
  if (r < 0 || ins.imm < 0 || ins.imm >= lay.list[r].flat.len()) {
    return no_field();
  }
  return FieldRef { r: r, i: ins.imm };
}

function flat_read(f: ssasem.Func, lay: Layout, defs: ssa.SInst[], v: i32): FieldRef {
  if (v < 0 || v >= defs.len()) {
    return no_field();
  }
  let fl: FieldRef = read_field(f, lay, defs[v]);
  if (fl.r >= 0 && lay.list[fl.r].flat[fl.i]) {
    return fl;
  }
  return no_field();
}

// Drops a field some body uses whole: other than read apart, or handed to a
// laid-out field of the same type in a construction.
function fields_kept_apart(lay0: Layout, funcs: ssasem.Func[], rewrite: boolean[]): Layout {
  let lay: Layout = lay0;
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for i in 0..funcs.len() {
      if (rewrite[i] && touches(funcs[i], lay)) {
        let next: Narrowed = apart_in(lay, funcs[i]);
        changed = changed || next.changed;
        lay = next.lay;
      }
    }
  }
  return lay;
}

struct Narrowed { lay: Layout, changed: boolean }

function apart_in(lay0: Layout, f: ssasem.Func): Narrowed {
  let lay: Layout = lay0;
  let changed: boolean = false;
  let defs: ssa.SInst[] = defs_of(f.graph);
  for b in f.graph.blocks {
    for ins in b.insts {
      for pos in 0..ins.args.len() {
        let fl: FieldRef = flat_read(f, lay, defs, ins.args[pos]);
        if (fl.r >= 0 && !field_read_apart(f, lay, ins, pos, fl)) {
          lay = without_field(lay, fl);
          changed = true;
        }
      }
    }
    let fl: FieldRef = flat_read(f, lay, defs, term_use(b.term));
    if (fl.r >= 0) {
      lay = without_field(lay, fl);
      changed = true;
    }
  }
  return Narrowed { lay: lay, changed: changed };
}

function term_use(t: ssa.STerm): i32 {
  if (t.kind_tag == 1) {
    return t.value;
  }
  if (t.kind_tag == 3) {
    return t.cond;
  }
  return 0 - 1;
}

function field_read_apart(f: ssasem.Func, lay: Layout, ins: ssa.SInst, pos: i32, fl: FieldRef): boolean {
  if (reads_apart(ins.kind_tag) && ins.args.len() == 1) {
    return true;
  }
  if (ins.kind_tag != ssasem.record_new()) {
    return false;
  }
  let r: i32 = laid_index(lay, f.values[ins.result]);
  if (r < 0 || pos >= lay.list[r].flat.len() || !lay.list[r].flat[pos]) {
    return false;
  }
  return semtypes.equal(lay.list[r].old.fields[pos].ty, lay.list[fl.r].old.fields[fl.i].ty);
}

function without_field(lay: Layout, fl: FieldRef): Layout {
  let r: Relay = lay.list[fl.r];
  return Layout { ...lay, list: lay.list.with(fl.r, Relay { ...r, flat: r.flat.with(fl.i, false) }) };
}

// The layout of the records keeping a laid-out field: each such field becomes
// one field per part, named after it.
function settled(lay: Layout): Layout {
  let list: Relay[] = [];
  let keys: string[] = [];
  for r in lay.list {
    if (any_true(r.flat)) {
      list = list.append(laid_relay(r));
      keys = keys.append(r.key);
    }
  }
  return Layout { keys: util.name_index(keys), list: list };
}

function laid_relay(r: Relay): Relay {
  let fields: semrecords.Field[] = [];
  let at: i32[] = [];
  for i in 0..r.old.fields.len() {
    at = at.append(fields.len());
    let fl: semrecords.Field = r.old.fields[i];
    if (!r.flat[i]) {
      fields = fields.append(fl);
      continue;
    }
    for k in 0..r.parts[i].len() {
      fields = fields.append(semrecords.Field { name: fl.name + "$" + util.i32_to_string(k), ty: r.parts[i][k] });
    }
  }
  return Relay { ...r, laid: semrecords.Record { ...r.old, fields: fields, declared: r.old.fields }, at: at };
}

function touches(f: ssasem.Func, lay: Layout): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      let built: boolean = ins.kind_tag == ssasem.record_new() && laid_index(lay, f.values[ins.result]) >= 0;
      if (built || read_field(f, lay, ins).r >= 0) {
        return true;
      }
    }
  }
  return false;
}

function relaid(f0: ssasem.Func, lay: Layout): ssasem.Func {
  let f: ssasem.Func = f0;
  let sites: Sites = Sites { funcs: [], modes: [], ix: util.name_index([]), split: [], lay: lay };
  if (has_sites(f, sites)) {
    f = split_calls(f, sites, flat_reads(f, lay));
  }
  return read_laid(f, lay);
}

function flat_reads(f: ssasem.Func, lay: Layout): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      let fl: FieldRef = read_field(f, lay, ins);
      if (fl.r >= 0 && lay.list[fl.r].flat[fl.i]) {
        out = out.with(ins.result, true);
      }
    }
  }
  return out;
}

// The reads of laid-out fields, made of their parts: a read of such a field
// becomes one read per part, and each read taking it apart reads its parts.
struct Reads { f: ssasem.Func, slot: i32[], parts: i32[][], payloads: typeinfo.Type[][] }

function read_laid(f0: ssasem.Func, lay: Layout): ssasem.Func {
  let rd: Reads = Reads { f: f0, slot: __alloc_i32(f0.graph.nvals), parts: [], payloads: [] };
  for b in f0.graph.blocks {
    for ins in b.insts {
      let fl: FieldRef = read_field(f0, lay, ins);
      if (fl.r >= 0 && lay.list[fl.r].flat[fl.i]) {
        rd = part_values(rd, ins.result, lay.list[fl.r].parts[fl.i], lay.list[fl.r].payloads[fl.i]);
      }
    }
  }
  let f: ssasem.Func = rd.f;
  let blocks: ssa.SBlock[] = [];
  for b in f.graph.blocks {
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      insts = util.append_all(insts, laid_reads(f, lay, rd, ins));
    }
    blocks = blocks.append(ssa.SBlock { ...b, insts: insts });
  }
  return ssasem.Func { ...f, graph: ssa.SFunc { ...f.graph, blocks: blocks } };
}

function part_values(rd: Reads, v: i32, types: typeinfo.Type[], payload: typeinfo.Type[]): Reads {
  let f: ssasem.Func = rd.f;
  let ids: i32[] = [];
  for t in types {
    ids = ids.append(f.values.len());
    f = with_value(f, t);
  }
  let parts: i32[][] = rd.parts.append(ids);
  return Reads { f: f, slot: rd.slot.with(v, parts.len()), parts: parts, payloads: rd.payloads.append(payload) };
}

function laid_reads(f: ssasem.Func, lay: Layout, rd: Reads, ins: ssa.SInst): ssa.SInst[] {
  let fl: FieldRef = read_field(f, lay, ins);
  if (fl.r >= 0) {
    return field_reads(lay.list[fl.r], fl.i, rd, ins);
  }
  if (ins.args.len() == 1 && reads_apart(ins.kind_tag)) {
    let a: i32 = ins.args[0];
    if (a >= 0 && a < rd.slot.len() && rd.slot[a] > 0) {
      return [semscalarreturn.read_of_parts(ins, ins.result, rd.parts[rd.slot[a] - 1], rd.payloads[rd.slot[a] - 1])];
    }
  }
  return [ins];
}

function field_reads(r: Relay, i: i32, rd: Reads, ins: ssa.SInst): ssa.SInst[] {
  if (!r.flat[i]) {
    return [ssa.SInst { ...ins, imm: r.at[i] }];
  }
  let ids: i32[] = rd.parts[rd.slot[ins.result] - 1];
  let out: ssa.SInst[] = [];
  for k in 0..ids.len() {
    let at: i32 = r.at[i] + k;
    out = out.append(ssa.SInst { kind_tag: ssasem.record_get(), result: ids[k], args: ins.args, imm: at, str: r.laid.fields[at].name });
  }
  return out;
}

function with_laid_records(f: ssasem.Func, lay: Layout): ssasem.Func {
  let list: semrecords.Record[] = [];
  let changed: boolean = false;
  for rec in f.records.list {
    let r: i32 = laid_index(lay, rec.ty);
    if (r >= 0) {
      list = list.append(lay.list[r].laid);
      changed = true;
    } else {
      list = list.append(rec);
    }
  }
  if (!changed) {
    return f;
  }
  return ssasem.Func { ...f, records: semrecords.records_of(list) };
}
