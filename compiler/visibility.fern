// compiler/visibility.fern — cross-module `pub` enforcement (#6714).
//
// Kept out of modloader.fern deliberately. The rule needs astwalk + checker,
// and modloader is imported by every minimal driver (checker_modload_run,
// asm_modload_run, asm_load_run, …) whose project dir carries a fixed,
// small source list. Putting the rule there widened modloader's import closure
// and broke those drivers; a separate module keeps the loader's dependencies
// as narrow as they were and costs the full driver one import.

import "./ast";
import "./parser";
import "./flatten";
import "./util";
import "./astwalk";
import "./checker";

// --- cross-module visibility (#6714) --------------------------------------
//
// Native enforces `pub` in modload's rewriter: a `mod.X` naming a declaration
// `mod` did not export is an error, not a resolvable reference. The self-host
// swallowed the modifier entirely, so a private member was callable from any
// module — a program native REFUSES TO BUILD produced a working binary here.
//
// The check runs on the PRE-FLATTEN ASTs, one module at a time, because that is
// the only place the distinction survives. Bundling rewrites a qualified
// `bigint.__bi_make` and a bare same-module `__bi_make` into the SAME ident
// `bigint____bi_make`, so a bundle-level rule cannot tell an outside caller
// from the module's own internals — and core/bigint, whose methods call its
// private helpers by bare name, is exactly the shape that exposes it.

// import_quals returns the qualifiers a module's source may write: the import's
// alias when it has one, else the path's basename (`import "std/io_buffered" as
// io` → `io`; `import "./lexer"` → `lexer`). Built by concatenation rather than
// slicing — a slice is a `str` view of the path, and this outlives it.
function import_quals(mod: parser.Module): string[] {
  let out: string[] = [];
  for im in mod.imports {
    if (im.alias.len() > 0) {
      out = out.append(im.alias);
    } else {
      out = out.append(base_name_of(im.path));
    }
  }
  return out;
}

// base_name_of is modloader.base_name, duplicated rather than imported: this
// module is on the full driver's path only, and importing modloader for one
// eight-line helper would drag the loader's whole closure back in — the
// dependency widening that broke six minimal drivers the first time.
function base_name_of(path: string): string {
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < path.len()) {
    if (path[i] == b'/') {
      start = i + 1;
    }
    i = i + 1;
  }
  return slice_unchecked(path, start, path.len()) + "";
}

// module_named finds a loaded module by its namespace name.
function module_named(loaded: flatten.LoadedModule[], name: string): i32 {
  let i: i32 = 0;
  while (i < loaded.len()) {
    if (loaded[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// private_keys builds `<mod>.<name>` for every private top-level FUNCTION and
// TYPE across the loaded set, once per run, so a reference is one lookup rather
// than a scan of the target module's declarations. Receiver-bearing methods are
// reached through a value, never module-qualified, so `pub` does not gate them.
// A `pub(package)` declaration is exported, so it is not a key here.
function private_keys(loaded: flatten.LoadedModule[]): string[] {
  let out: string[] = [];
  for lm in loaded {
    for f in lm.mod.funcs {
      if (!f.is_pub && !f.is_package && f.receiver_name.len() == 0 && f.name.len() > 0) {
        out = out.append(lm.name + "." + f.name);
      }
    }
    for sd in lm.mod.structs {
      // A variant defers to its enum, so it contributes no key of its own.
      if (!sd.is_pub && !sd.is_package && sd.enum_owner.len() == 0 && sd.name.len() > 0) {
        out = out.append(lm.name + "." + sd.name);
      }
    }
    for en in lm.mod.enums {
      if (!en.is_pub && !en.is_package) {
        out = out.append(lm.name + "." + en.name);
      }
    }
    for al in lm.mod.aliases {
      if (!al.is_pub && !al.is_package) {
        out = out.append(lm.name + "." + al.name);
      }
    }
  }
  return out;
}

// private_const_keys is private_keys' const subset. The keyword the message
// tells the reader to write has to name the declaration they will find: a
// `const` told to become a `pub function` sends them nowhere, the same way a
// private enum told to become a `pub struct` would. A const reaches the parser
// as a FuncDecl carrying `is_const`, so it is in private_keys already; this
// picks it out.
function private_const_keys(loaded: flatten.LoadedModule[]): string[] {
  let out: string[] = [];
  for lm in loaded {
    for f in lm.mod.funcs {
      if (f.is_const && !f.is_pub && !f.is_package && f.receiver_name.len() == 0 && f.name.len() > 0) {
        out = out.append(lm.name + "." + f.name);
      }
    }
  }
  return out;
}

// package_of returns the PACKAGE of the module whose resolved file is `ident`:
// its directory, with the whole stdlib (`std/…` + `core/…` under `root`)
// counting as one. See docs/PUB-PACKAGE.md.
function package_of(ident: string, root: string): string {
  if (root.len() > 0 && (util.str_has_prefix(ident, root + "/std/") || util.str_has_prefix(ident, root + "/core/"))) {
    return "(stdlib)";
  }
  return util.clean_path(util.dir_of(ident));
}

// package_keys builds `<ident>.<name>` for every `pub(package)` top-level
// function and type: declarations visible within their own package and nowhere
// else. Keyed on the module's resolved file rather than its name, since the
// rule turns on which directory that file is in.
function package_keys(loaded: flatten.LoadedModule[]): string[] {
  let out: string[] = [];
  for lm in loaded {
    for f in lm.mod.funcs {
      if (f.is_package && f.receiver_name.len() == 0 && f.name.len() > 0) {
        out = out.append(lm.ident + "." + f.name);
      }
    }
    for sd in lm.mod.structs {
      if (sd.is_package && sd.enum_owner.len() == 0 && sd.name.len() > 0) {
        out = out.append(lm.ident + "." + sd.name);
      }
    }
    for en in lm.mod.enums {
      if (en.is_package) {
        out = out.append(lm.ident + "." + en.name);
      }
    }
    for al in lm.mod.aliases {
      if (al.is_package) {
        out = out.append(lm.ident + "." + al.name);
      }
    }
  }
  return out;
}

// VisCtx is what checking one module's references needs: its source, the
// qualifiers that source may write, the loaded set, the private and
// package-scoped keys, the module's own package, and the stdlib root.
struct VisCtx {
  src: parser.Module,
  quals: string[],
  loaded: flatten.LoadedModule[],
  priv: util.NameIndex,
  priv_consts: string[],
  pkg: util.NameIndex,
  src_pkg: string,
  root: string,
}

function vis_ctx(src: parser.Module, src_ident: string, loaded: flatten.LoadedModule[], priv: util.NameIndex, priv_consts: string[], pkg: util.NameIndex, root: string): VisCtx {
  return VisCtx { src: src, quals: import_quals(src), loaded: loaded, priv: priv, priv_consts: priv_consts, pkg: pkg, src_pkg: package_of(src_ident, root), root: root };
}

// owner_ident returns the resolved file of the module `qual` names in `src`,
// or "" when no import of `src` is written that way.
function owner_ident(src: parser.Module, qual: string): string {
  for im in src.imports {
    if (im.alias == qual || im.alias.len() == 0 && base_name_of(im.path) == qual) {
      return im.resolved;
    }
  }
  return "";
}

// package_scope reports whether `qual.name` names a `pub(package)`
// declaration, and whether the module being checked is outside its package.
function package_scope(cx: VisCtx, qual: string, name: string): (boolean, boolean) {
  let owner: string = owner_ident(cx.src, qual);
  if (owner.len() == 0 || !cx.pkg.has(owner + "." + name)) {
    return (false, false);
  }
  return (true, package_of(owner, cx.root) != cx.src_pkg);
}

// package_diag is native's message for a package-scoped declaration reached
// from another package.
function package_diag(cx: VisCtx, qual: string, name: string, line: i32, col: i32): util.Diag {
  let m: string = base_name_of(owner_ident(cx.src, qual));
  return util.Diag {
    code: "",
    message: m + "." + name + " is `pub(package)` — only modules in the same package as " + m + " may use it",
    line: line,
    col: col,
  };
}

// module_diags reports every `<qual>.<name>` in the module's own functions that
// names a private top-level declaration of another module, or a package-scoped
// one from outside its package.
function module_diags(cx: VisCtx): util.Diag[] {
  let out: util.Diag[] = [];
  if (cx.quals.len() == 0) {
    return out;
  }
  let refs: astwalk.QualRef[] = [];
  for fd in cx.src.funcs {
    for st in fd.body {
      refs = astwalk.collect_qualrefs_stmt(st, cx.quals, refs);
    }
  }
  for r in refs {
    let key: string = r.qual + "." + r.name;
    let (scoped, refused) = package_scope(cx, r.qual, r.name);
    if (scoped) {
      if (refused) {
        out = out.append(package_diag(cx, r.qual, r.name, r.line, r.col));
      }
    } else if (cx.priv.has(key)) {
      let kw: string = "function";
      if (util.has_str(cx.priv_consts, key)) {
        kw = "const";
      }
      out = out.append(util.Diag {
        code: "",
        message: key + " is not exported (declare it as `pub " + kw + " " + r.name + " …` to make it accessible from other modules)",
        line: r.line,
        col: r.col,
      });
    }
  }
  return out;
}

// export_diags checks the entry and every loaded module against the visibility
// rule. A module's references to its OWN declarations are bare idents, never
// qualified, so they are structurally out of scope here rather than filtered —
// which is what makes this formulation immune to the false positives the
// bundle-level one produced. `entry` carries resolved imports, `entry_ident` is
// its own resolved file, and `root` is the stdlib root.
pub function export_diags(entry: parser.Module, entry_ident: string, loaded: flatten.LoadedModule[], root: string): util.Diag[] {
  let priv: util.NameIndex = util.name_index(private_keys(loaded));
  let priv_consts: string[] = private_const_keys(loaded);
  let pkg: util.NameIndex = util.name_index(package_keys(loaded));
  let ecx: VisCtx = vis_ctx(entry, entry_ident, loaded, priv, priv_consts, pkg, root);
  let out: util.Diag[] = module_diags(ecx);
  for d in type_diags(ecx) {
    out = out.append(d);
  }
  for lm in loaded {
    let cx: VisCtx = vis_ctx(lm.mod, lm.ident, loaded, priv, priv_consts, pkg, root);
    for d in module_diags(cx) {
      out = out.append(d);
    }
    for d in type_diags(cx) {
      out = out.append(d);
    }
  }
  return out;
}

// --- qualified TYPE references (#6723) ------------------------------------
//
// The function half above walks EXPRESSIONS. A qualified type never appears
// there: it lives in type-name STRINGS — a var's declared type, a param type, a
// return type, a struct field type, and the type_name of a struct literal
// (`lib.Secret { … }` carries the qualifier in the literal, not in an
// expression). So this half is a scan over those strings, splitting on the
// first `.` the way flatten.rewrite_type_name does.

// qual_type_parts splits `mod.Name` into its two halves, with any generic or
// array suffix stripped off the name — `facade.Point[]` looks up `Point`, and
// `m.Box[T]` looks up `Box`. Without that cut the lookup asks for `Point[]`,
// finds nothing, and the rule silently never fires. Returns "" for `qual` when
// the string carries no qualifier.
function qual_type_parts(tn: string): (string, string) {
  let dot: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < tn.len()) {
    if (tn[i] == b'.') {  // first only
      dot = i;
      i = tn.len();
    }
    i = i + 1;
  }
  if (dot < 0) {
    return ("", "");
  }
  let q: string = slice_unchecked(tn, 0, dot) + "";
  let rest: string = slice_unchecked(tn, dot + 1, tn.len()) + "";
  let cut: i32 = rest.len();
  let j: i32 = 0;
  while (j < rest.len()) {
    if (rest[j] == b'[') {
      cut = j;
      j = rest.len();
    }
    j = j + 1;
  }
  return (q, slice_unchecked(rest, 0, cut) + "");
}

// declares_private_type reports whether `mod` declares `name` as a NON-pub
// struct, enum or type alias.
//
// A VARIANT struct (enum_owner non-empty) defers to its enum: a variant is
// reachable as `mod.Variant` exactly when the enum that owns it is exported, so
// gating on the variant's own flag — which the parser never stamps, since a
// variant carries no `pub` of its own — would reject every qualified variant
// construction in the stdlib.
function declares_private_type(mod: parser.Module, name: string): boolean {
  let i: i32 = 0;
  while (i < mod.structs.len()) {
    if (mod.structs[i].name == name) {
      let owner: string = mod.structs[i].enum_owner;
      if (owner.len() > 0) {
        return declares_private_type(mod, owner);
      }
      return !mod.structs[i].is_pub && !mod.structs[i].is_package;
    }
    i = i + 1;
  }
  let e: i32 = 0;
  while (e < mod.enums.len()) {
    if (mod.enums[e].name == name) {
      return !mod.enums[e].is_pub && !mod.enums[e].is_package;
    }
    e = e + 1;
  }
  let a: i32 = 0;
  while (a < mod.aliases.len()) {
    if (mod.aliases[a].name == name) {
      return !mod.aliases[a].is_pub && !mod.aliases[a].is_package;
    }
    a = a + 1;
  }
  return false;  // not declared here — somebody else's diagnostic
}

// type_kind_word names the declaration kind in the message, so the hint tells
// the reader which keyword to put `pub` in front of, as native's does.
function type_kind_word(mod: parser.Module, name: string): string {
  let i: i32 = 0;
  while (i < mod.structs.len()) {
    if (mod.structs[i].name == name) {
      return "struct";
    }
    i = i + 1;
  }
  let e: i32 = 0;
  while (e < mod.enums.len()) {
    if (mod.enums[e].name == name) {
      return "enum";
    }
    e = e + 1;
  }
  return "type";
}

// check_type_name appends a diagnostic when `tn` is a qualified reference to a
// private type of a loaded module, or to a package-scoped one from outside its
// package.
function check_type_name(tn: string, cx: VisCtx, line: i32, col: i32, acc: util.Diag[]): util.Diag[] {
  let (q, base) = qual_type_parts(tn);
  if (q.len() == 0 || base.len() == 0) {
    return acc;
  }
  if (!util.has_str(cx.quals, q)) {
    return acc;
  }
  let (scoped, refused) = package_scope(cx, q, base);
  if (scoped) {
    if (refused) {
      return acc.append(package_diag(cx, q, base, line, col));
    }
    return acc;
  }
  if (!cx.priv.has(q + "." + base)) {
    return acc;
  }
  let mi: i32 = module_named(cx.loaded, q);
  if (mi < 0) {
    return acc;
  }
  // Only reached for a name already known private, so the declaration scan
  // behind the kind word runs once per DIAGNOSTIC, not once per reference.
  if (!declares_private_type(cx.loaded[mi].mod, base)) {
    return acc;
  }
  let kind: string = type_kind_word(cx.loaded[mi].mod, base);
  return acc.append(util.Diag {
    code: "",
    message: q + "." + base + " is not exported (declare it as `pub " + kind + " " + base + " …` to make it accessible from other modules)",
    line: line,
    col: col,
  });
}

// type_diags scans every type-name position a module writes: each function's
// params and return type, each local `let`'s declared type, and each struct
// literal's type name. Struct FIELD types are covered through the decl walk.
function type_diags(cx: VisCtx): util.Diag[] {
  let out: util.Diag[] = [];
  if (cx.quals.len() == 0) {
    return out;
  }
  let src: parser.Module = cx.src;
  let i: i32 = 0;
  while (i < src.funcs.len()) {
    let f: parser.FuncDecl = src.funcs[i];
    let pi: i32 = 0;
    while (pi < f.params.len()) {
      out = check_type_name(f.params[pi].type_name, cx, f.line, f.col, out);
      pi = pi + 1;
    }
    out = check_type_name(f.ret_type, cx, f.line, f.col, out);
    let bi: i32 = 0;
    while (bi < f.body.len()) {
      out = stmt_type_diags(f.body[bi], cx, out);
      bi = bi + 1;
    }
    i = i + 1;
  }
  let si: i32 = 0;
  while (si < src.structs.len()) {
    let sd: parser.StructDecl = src.structs[si];
    let fi: i32 = 0;
    while (fi < sd.fields.len()) {
      out = check_type_name(sd.fields[fi].type_name, cx, sd.line, sd.col, out);
      fi = fi + 1;
    }
    si = si + 1;
  }
  return out;
}

// stmt_type_diags walks a statement for declared type names and struct-literal
// type names. Deliberately shallow on expressions: a struct literal is the only
// expression carrying a type NAME, and it is reached through the statement
// positions that can hold one.
function stmt_type_diags(st: ast.Stmt, cx: VisCtx, acc: util.Diag[]): util.Diag[] {
  match (st) {
    ast.StmtVar(v) => {
      acc = check_type_name(v.type_name, cx, v.line, v.col, acc);
      return expr_type_diags(v.init, cx, acc);
    },
    ast.StmtReturn(r) => {
      return expr_type_diags(r.value, cx, acc);
    },
    ast.StmtExpr(e) => {
      return expr_type_diags(e.value, cx, acc);
    },
    ast.StmtAssign(a) => {
      return expr_type_diags(a.value, cx, acc);
    },
    ast.StmtDefer(d) => {
      return stmt_type_diags(d.action, cx, acc);
    },
    ast.StmtIf(i) => {
      acc = expr_type_diags(i.cond, cx, acc);
      let ti: i32 = 0;
      while (ti < i.then_body.len()) {
        acc = stmt_type_diags(i.then_body[ti], cx, acc);
        ti = ti + 1;
      }
      let ei: i32 = 0;
      while (ei < i.else_body.len()) {
        acc = stmt_type_diags(i.else_body[ei], cx, acc);
        ei = ei + 1;
      }
      return acc;
    },
    ast.StmtWhile(w) => {
      acc = expr_type_diags(w.cond, cx, acc);
      let wi: i32 = 0;
      while (wi < w.body.len()) {
        acc = stmt_type_diags(w.body[wi], cx, acc);
        wi = wi + 1;
      }
      return acc;
    },
    ast.StmtFor(f) => {
      acc = expr_type_diags(f.iter, cx, acc);
      let fi: i32 = 0;
      while (fi < f.body.len()) {
        acc = stmt_type_diags(f.body[fi], cx, acc);
        fi = fi + 1;
      }
      return acc;
    },
    ast.StmtMatch(m) => {
      acc = expr_type_diags(m.scrutinee, cx, acc);
      let ai: i32 = 0;
      while (ai < m.arms.len()) {
        let bi: i32 = 0;
        while (bi < m.arms[ai].body.len()) {
          acc = stmt_type_diags(m.arms[ai].body[bi], cx, acc);
          bi = bi + 1;
        }
        ai = ai + 1;
      }
      return acc;
    },
    ast.StmtBreak(_) => {
      return acc;
    },
    ast.StmtContinue(_) => {
      return acc;
    },
    ast.StmtUnknown(_) => {
      return acc;
    }
  }
  return acc;
}

// expr_type_diags finds struct-literal type names inside an expression.
function expr_type_diags(e: ast.Expr, cx: VisCtx, acc: util.Diag[]): util.Diag[] {
  match (e) {
    ast.ExprStructLit(sl) => {
      acc = check_type_name(sl.type_name, cx, sl.line, sl.col, acc);
      if (sl.has_base) {
        acc = expr_type_diags(sl.base, cx, acc);
      }
      let i: i32 = 0;
      while (i < sl.field_values.len()) {
        acc = expr_type_diags(sl.field_values[i], cx, acc);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprBinary(b) => {
      acc = expr_type_diags(b.left, cx, acc);
      return expr_type_diags(b.right, cx, acc);
    },
    ast.ExprUnary(u) => {
      return expr_type_diags(u.operand, cx, acc);
    },
    ast.ExprCall(c) => {
      let i: i32 = 0;
      while (i < c.args.len()) {
        acc = expr_type_diags(c.args[i], cx, acc);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprArray(a) => {
      let i: i32 = 0;
      while (i < a.elements.len()) {
        acc = expr_type_diags(a.elements[i], cx, acc);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprTuple(t) => {
      let i: i32 = 0;
      while (i < t.elements.len()) {
        acc = expr_type_diags(t.elements[i], cx, acc);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprIndex(x) => {
      acc = expr_type_diags(x.array, cx, acc);
      return expr_type_diags(x.index, cx, acc);
    },
    ast.ExprLambda(lm) => {
      let i: i32 = 0;
      while (i < lm.body.len()) {
        acc = stmt_type_diags(lm.body[i], cx, acc);
        i = i + 1;
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}
