import "./ast";
import "./parser";
import "./flatten";
import "./util";
import "./astwalk";
import "./checker";

function import_quals(mod: parser.Module): string[] {
  let out: string[] = [];
  for im in mod.imports {
    if (im.alias.len() > 0) {
      out = out.append(im.alias);
    } else {
      out = out.append(util.import_qualifier(im.path));
    }
  }
  return out;
}

function base_name_of(path: string): string {
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < path.len()) {
    if (path[i] == b'/') {
      start = i + 1;
    }
    i = i + 1;
  }
  return slice_unchecked(path, start, path.len()) + "";
}

function module_named(loaded: flatten.LoadedModule[], name: string): i32 {
  let i: i32 = 0;
  while (i < loaded.len()) {
    if (loaded[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function module_key(lm: flatten.LoadedModule): string {
  if (lm.ident.len() > 0) {
    return lm.ident;
  }
  return lm.name;
}

function private_keys(loaded: flatten.LoadedModule[]): string[] {
  let out: string[] = [];
  for lm in loaded {
    for f in lm.mod.funcs {
      if (!f.is_pub && !f.is_package && f.receiver_name.len() == 0 && f.name.len() > 0) {
        out = out.append(module_key(lm) + "." + f.name);
      }
    }
    for sd in lm.mod.structs {
      if (!sd.is_pub && !sd.is_package && sd.enum_owner.len() == 0 && sd.name.len() > 0) {
        out = out.append(module_key(lm) + "." + sd.name);
      }
    }
    for en in lm.mod.enums {
      if (!en.is_pub && !en.is_package) {
        out = out.append(module_key(lm) + "." + en.name);
      }
    }
    for al in lm.mod.aliases {
      if (!al.is_pub && !al.is_package) {
        out = out.append(module_key(lm) + "." + al.name);
      }
    }
  }
  return out;
}

function private_const_keys(loaded: flatten.LoadedModule[]): string[] {
  let out: string[] = [];
  for lm in loaded {
    for f in lm.mod.funcs {
      if (f.is_const && !f.is_pub && !f.is_package && f.receiver_name.len() == 0 && f.name.len() > 0) {
        out = out.append(module_key(lm) + "." + f.name);
      }
    }
  }
  return out;
}

function package_of(ident: string, root: string): string {
  if (root.len() > 0 && (util.str_has_prefix(ident, root + "/std/") || util.str_has_prefix(ident, root + "/core/"))) {
    return "(stdlib)";
  }
  return util.clean_path(util.dir_of(ident));
}

function package_keys(loaded: flatten.LoadedModule[]): string[] {
  let out: string[] = [];
  for lm in loaded {
    for f in lm.mod.funcs {
      if (f.is_package && f.receiver_name.len() == 0 && f.name.len() > 0) {
        out = out.append(lm.ident + "." + f.name);
      }
    }
    for sd in lm.mod.structs {
      if (sd.is_package && sd.enum_owner.len() == 0 && sd.name.len() > 0) {
        out = out.append(lm.ident + "." + sd.name);
      }
    }
    for en in lm.mod.enums {
      if (en.is_package) {
        out = out.append(lm.ident + "." + en.name);
      }
    }
    for al in lm.mod.aliases {
      if (al.is_package) {
        out = out.append(lm.ident + "." + al.name);
      }
    }
  }
  return out;
}

struct VisCtx {
  src: parser.Module,
  quals: string[],
  loaded: flatten.LoadedModule[],
  priv: util.NameIndex,
  priv_consts: string[],
  pkg: util.NameIndex,
  src_pkg: string,
  root: string,
}

function vis_ctx(src: parser.Module, src_ident: string, loaded: flatten.LoadedModule[], priv: util.NameIndex, priv_consts: string[], pkg: util.NameIndex, root: string): VisCtx {
  return VisCtx { src: src, quals: import_quals(src), loaded: loaded, priv: priv, priv_consts: priv_consts, pkg: pkg, src_pkg: package_of(src_ident, root), root: root };
}

function owner_ident(src: parser.Module, qual: string): string {
  for im in src.imports {
    if (im.alias == qual || im.alias.len() == 0 && util.import_qualifier(im.path) == qual) {
      return im.resolved;
    }
  }
  return "";
}

function loaded_index(cx: VisCtx, qual: string): i32 {
  let owner: string = owner_ident(cx.src, qual);
  if (owner.len() == 0) {
    return module_named(cx.loaded, qual);
  }
  let i: i32 = 0;
  while (i < cx.loaded.len()) {
    if (cx.loaded[i].ident == owner) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function package_scope(cx: VisCtx, qual: string, name: string): (boolean, boolean) {
  let owner: string = owner_ident(cx.src, qual);
  if (owner.len() == 0 || !cx.pkg.has(owner + "." + name)) {
    return (false, false);
  }
  return (true, package_of(owner, cx.root) != cx.src_pkg);
}

function package_diag(cx: VisCtx, qual: string, name: string, line: i32, col: i32): util.Diag {
  let m: string = base_name_of(owner_ident(cx.src, qual));
  return util.Diag {
    length: 0,
    related: [],
    code: "E087",
    message: m + "." + name + " is `pub(package)` — only modules in the same package as " + m + " may use it",
    line: line,
    col: col,
    fix: None,
  };
}

function module_diags(cx: VisCtx): util.Diag[] {
  let out: util.Diag[] = [];
  if (cx.quals.len() == 0) {
    return out;
  }
  let refs: astwalk.QualRef[] = [];
  for fd in cx.src.funcs {
    for st in fd.body {
      refs = astwalk.collect_qualrefs_stmt(st, cx.quals, refs);
    }
  }
  for r in refs {
    out = ref_diag(cx, r, out);
  }
  return out;
}

function ref_diag(cx: VisCtx, r: astwalk.QualRef, out: util.Diag[]): util.Diag[] {
  let (scoped, refused) = package_scope(cx, r.qual, r.name);
  if (scoped) {
    if (refused) {
      return out.append(package_diag(cx, r.qual, r.name, r.line, r.col));
    }
    return out;
  }
  let mi: i32 = loaded_index(cx, r.qual);
  if (mi < 0) {
    return out;
  }
  let key: string = module_key(cx.loaded[mi]) + "." + r.name;
  if (!cx.priv.has(key)) {
    return out;
  }
  let kw: string = "function";
  if (util.has_str(cx.priv_consts, key)) {
    kw = "const";
  }
  return out.append(util.Diag {
    length: 0,
    related: [],
    code: "E087",
    message: cx.loaded[mi].name + "." + r.name + " is not exported (declare it as `pub " + kw + " " + r.name + " …` to make it accessible from other modules)",
    line: r.line,
    col: r.col,
    fix: None,
  });
}

pub function export_diags(entry: parser.Module, entry_ident: string, loaded: flatten.LoadedModule[], root: string): util.Diag[] {
  let priv: util.NameIndex = util.name_index(private_keys(loaded));
  let priv_consts: string[] = private_const_keys(loaded);
  let pkg: util.NameIndex = util.name_index(package_keys(loaded));
  let ecx: VisCtx = vis_ctx(entry, entry_ident, loaded, priv, priv_consts, pkg, root);
  let out: util.Diag[] = module_diags(ecx);
  for d in type_diags(ecx) {
    out = out.append(d);
  }
  for lm in loaded {
    let cx: VisCtx = vis_ctx(lm.mod, lm.ident, loaded, priv, priv_consts, pkg, root);
    for d in module_diags(cx) {
      out = out.append(d);
    }
    for d in type_diags(cx) {
      out = out.append(d);
    }
  }
  return out;
}

function qual_type_parts(tn: string): (string, string) {
  let dot: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < tn.len()) {
    if (tn[i] == b'.') {
      dot = i;
      i = tn.len();
    }
    i = i + 1;
  }
  if (dot < 0) {
    return ("", "");
  }
  let q: string = slice_unchecked(tn, 0, dot) + "";
  let rest: string = slice_unchecked(tn, dot + 1, tn.len()) + "";
  let cut: i32 = rest.len();
  let j: i32 = 0;
  while (j < rest.len()) {
    if (rest[j] == b'[' || rest[j] == b'.') {
      cut = j;
      j = rest.len();
    }
    j = j + 1;
  }
  return (q, slice_unchecked(rest, 0, cut) + "");
}

function declares_private_type(mod: parser.Module, name: string): boolean {
  let i: i32 = 0;
  while (i < mod.structs.len()) {
    if (mod.structs[i].name == name) {
      let owner: string = mod.structs[i].enum_owner;
      if (owner.len() > 0) {
        return declares_private_type(mod, owner);
      }
      return !mod.structs[i].is_pub && !mod.structs[i].is_package;
    }
    i = i + 1;
  }
  let e: i32 = 0;
  while (e < mod.enums.len()) {
    if (mod.enums[e].name == name) {
      return !mod.enums[e].is_pub && !mod.enums[e].is_package;
    }
    e = e + 1;
  }
  let a: i32 = 0;
  while (a < mod.aliases.len()) {
    if (mod.aliases[a].name == name) {
      return !mod.aliases[a].is_pub && !mod.aliases[a].is_package;
    }
    a = a + 1;
  }
  return false;
}

function type_kind_word(mod: parser.Module, name: string): string {
  let i: i32 = 0;
  while (i < mod.structs.len()) {
    if (mod.structs[i].name == name) {
      return "struct";
    }
    i = i + 1;
  }
  let e: i32 = 0;
  while (e < mod.enums.len()) {
    if (mod.enums[e].name == name) {
      return "enum";
    }
    e = e + 1;
  }
  return "type";
}

function check_type_name(tn: string, cx: VisCtx, line: i32, col: i32, acc: util.Diag[]): util.Diag[] {
  let (q, base) = qual_type_parts(tn);
  if (q.len() == 0 || base.len() == 0) {
    return acc;
  }
  if (!util.has_str(cx.quals, q)) {
    return acc;
  }
  let (scoped, refused) = package_scope(cx, q, base);
  if (scoped) {
    if (refused) {
      return acc.append(package_diag(cx, q, base, line, col));
    }
    return acc;
  }
  let mi: i32 = loaded_index(cx, q);
  if (mi < 0 || !cx.priv.has(module_key(cx.loaded[mi]) + "." + base)) {
    return acc;
  }
  let m: string = cx.loaded[mi].name;
  if (!declares_private_type(cx.loaded[mi].mod, base)) {
    return acc;
  }
  let kind: string = type_kind_word(cx.loaded[mi].mod, base);
  return acc.append(util.Diag {
    length: 0,
    related: [],
    code: "E087",
    message: m + "." + base + " is not exported (declare it as `pub " + kind + " " + base + " …` to make it accessible from other modules)",
    line: line,
    col: col,
    fix: None,
  });
}

function type_diags(cx: VisCtx): util.Diag[] {
  let out: util.Diag[] = [];
  if (cx.quals.len() == 0) {
    return out;
  }
  let src: parser.Module = cx.src;
  let i: i32 = 0;
  while (i < src.funcs.len()) {
    let f: parser.FuncDecl = src.funcs[i];
    let pi: i32 = 0;
    while (pi < f.params.len()) {
      out = check_type_name(f.params[pi].type_name, cx, f.line, f.col, out);
      pi = pi + 1;
    }
    out = check_type_name(f.ret_type, cx, f.line, f.col, out);
    let bi: i32 = 0;
    while (bi < f.body.len()) {
      out = stmt_type_diags(f.body[bi], cx, out);
      bi = bi + 1;
    }
    i = i + 1;
  }
  let si: i32 = 0;
  while (si < src.structs.len()) {
    let sd: parser.StructDecl = src.structs[si];
    let fi: i32 = 0;
    while (fi < sd.fields.len()) {
      out = check_type_name(sd.fields[fi].type_name, cx, sd.line, sd.col, out);
      fi = fi + 1;
    }
    si = si + 1;
  }
  return out;
}

function pattern_type_diags(p: ast.Pattern, cx: VisCtx, line: i32, col: i32, acc: util.Diag[]): util.Diag[] {
  if let ast.PatVariant(v) = p {
    acc = check_type_name(v.type_name, cx, line, col, acc);
    for child in v.nested {
      acc = pattern_type_diags(child, cx, line, col, acc);
    }
    for child in v.tup_pats {
      acc = pattern_type_diags(child, cx, line, col, acc);
    }
  }
  return acc;
}

function stmt_type_diags(st: ast.Stmt, cx: VisCtx, acc: util.Diag[]): util.Diag[] {
  match (st) {
    ast.StmtVar(v) => {
      acc = check_type_name(v.type_name, cx, v.line, v.col, acc);
      return expr_type_diags(v.init, cx, acc);
    },
    ast.StmtReturn(r) => {
      return expr_type_diags(r.value, cx, acc);
    },
    ast.StmtExpr(e) => {
      return expr_type_diags(e.value, cx, acc);
    },
    ast.StmtAssign(a) => {
      return expr_type_diags(a.value, cx, acc);
    },
    ast.StmtDefer(d) => {
      return stmt_type_diags(d.action, cx, acc);
    },
    ast.StmtIf(i) => {
      acc = expr_type_diags(i.cond, cx, acc);
      let ti: i32 = 0;
      while (ti < i.then_body.len()) {
        acc = stmt_type_diags(i.then_body[ti], cx, acc);
        ti = ti + 1;
      }
      let ei: i32 = 0;
      while (ei < i.else_body.len()) {
        acc = stmt_type_diags(i.else_body[ei], cx, acc);
        ei = ei + 1;
      }
      return acc;
    },
    ast.StmtWhile(w) => {
      acc = expr_type_diags(w.cond, cx, acc);
      let wi: i32 = 0;
      while (wi < w.body.len()) {
        acc = stmt_type_diags(w.body[wi], cx, acc);
        wi = wi + 1;
      }
      return acc;
    },
    ast.StmtFor(f) => {
      acc = expr_type_diags(f.iter, cx, acc);
      let fi: i32 = 0;
      while (fi < f.body.len()) {
        acc = stmt_type_diags(f.body[fi], cx, acc);
        fi = fi + 1;
      }
      return acc;
    },
    ast.StmtMatch(m) => {
      acc = expr_type_diags(m.scrutinee, cx, acc);
      let ai: i32 = 0;
      while (ai < m.arms.len()) {
        acc = pattern_type_diags(m.arms[ai].pattern, cx, m.arms[ai].line, m.arms[ai].col, acc);
        let bi: i32 = 0;
        while (bi < m.arms[ai].body.len()) {
          acc = stmt_type_diags(m.arms[ai].body[bi], cx, acc);
          bi = bi + 1;
        }
        ai = ai + 1;
      }
      return acc;
    },
    ast.StmtBreak(_) => {
      return acc;
    },
    ast.StmtContinue(_) => {
      return acc;
    },
    ast.StmtUnknown(_) => {
      return acc;
    }
  }
  return acc;
}

function expr_type_diags(e: ast.Expr, cx: VisCtx, acc: util.Diag[]): util.Diag[] {
  match (e) {
    ast.ExprStructLit(sl) => {
      acc = check_type_name(sl.type_name, cx, sl.line, sl.col, acc);
      if (sl.has_base) {
        acc = expr_type_diags(sl.base, cx, acc);
      }
      let i: i32 = 0;
      while (i < sl.field_values.len()) {
        acc = expr_type_diags(sl.field_values[i], cx, acc);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprBinary(b) => {
      acc = expr_type_diags(b.left, cx, acc);
      return expr_type_diags(b.right, cx, acc);
    },
    ast.ExprUnary(u) => {
      return expr_type_diags(u.operand, cx, acc);
    },
    ast.ExprCall(c) => {
      let i: i32 = 0;
      while (i < c.args.len()) {
        acc = expr_type_diags(c.args[i], cx, acc);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprArray(a) => {
      let i: i32 = 0;
      while (i < a.elements.len()) {
        acc = expr_type_diags(a.elements[i], cx, acc);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprTuple(t) => {
      let i: i32 = 0;
      while (i < t.elements.len()) {
        acc = expr_type_diags(t.elements[i], cx, acc);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprIndex(x) => {
      acc = expr_type_diags(x.array, cx, acc);
      return expr_type_diags(x.index, cx, acc);
    },
    ast.ExprLambda(lm) => {
      let i: i32 = 0;
      while (i < lm.body.len()) {
        acc = stmt_type_diags(lm.body[i], cx, acc);
        i = i + 1;
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}
