import "./fern";
import "./pkgfetch";
import "./util";
import "core/error";
import "std/rand";
import "std/string";

function main(): i32 {
  let root = stdlib_root();
  if (root.len() == 0) {
    return 1;
  }
  return util.arr_push_cliff_report("fern", fern.run_with(args(), root, fern.Fetcher { fetch: pkgfetch.fetch }));
}

function stdlib_installed(root: string): boolean {
  match (read_file(root + "/std/io.fern")) {
    Ok(_) => {
      return true;
    },
    Err(_) => {}
  }
  match (read_file(root + "/std/io.fern.md")) {
    Ok(_) => {
      return true;
    },
    Err(_) => {}
  }
  return false;
}

function stdlib_root(): string {
  let base = util.cache_base();
  if (base.len() == 0) {
    eprint("fern: no cache directory for the stdlib: set FERN_CACHE_DIR, XDG_CACHE_HOME or HOME");
    return "";
  }
  let root = base + "/stdlib-" + __fern_asset("DIGEST");
  if (stdlib_installed(root)) {
    return root;
  }
  let suffix = "";
  for b in rand.bytes(6) {
    suffix += util.i32_to_string(b as i32);
  }
  let tmp = root + ".tmp-" + suffix;
  for a in __fern_assets() {
    let path = tmp + "/" + a.0;
    match (create_dir_all(util.dir_of(path))) {
      Ok(_) => {},
      Err(e) => {
        eprint("fern: cannot create " + util.dir_of(path) + ": " + e.message());
        return "";
      }
    }
    match (write_file(path, a.1)) {
      Ok(_) => {},
      Err(e) => {
        eprint("fern: cannot write " + path + ": " + e.message());
        return "";
      }
    }
  }
  match (rename(tmp, root)) {
    Ok(_) => {
      return root;
    },
    Err(e) => {
      if (stdlib_installed(root)) {
        return root;
      }
      eprint("fern: cannot install the stdlib at " + root + ": " + e.message());
      return "";
    }
  }
}
