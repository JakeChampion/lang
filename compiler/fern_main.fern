import "./fern";
import "./pkgfetch";
import "./util";
import "std/crypto";
import "std/error";

function main(): i32 {
  let root: string = stdlib_root();
  if (root.len() == 0) {
    return 1;
  }
  return util.arr_push_cliff_report("fern", fern.run_with(args(), root, fern.Fetcher { fetch: pkgfetch.fetch }));
}

function stdlib_digest(): string {
  let h: crypto.Sha256 = crypto.sha256_new();
  for a in __fern_assets() {
    h = h.update(a.0.as_bytes()).update("\n".as_bytes()).update(util.i32_to_string(a.1.len()).as_bytes()).update("\n".as_bytes()).update(a.1.as_bytes());
  }
  return slice_unchecked(h.final_hex(), 0, 16) + "";
}

function stdlib_root(): string {
  let base: string = util.cache_base();
  if (base.len() == 0) {
    eprint("fern: no cache directory for the stdlib: set FERN_CACHE_DIR, XDG_CACHE_HOME or HOME");
    return "";
  }
  let root: string = base + "/stdlib-" + stdlib_digest();
  match (read_file(root + "/std/io.fern")) {
    Ok(_) => {
      return root;
    },
    Err(_) => {}
  }
  let suffix: string = "";
  for b in random_bytes(6) {
    suffix = suffix + util.i32_to_string(b as i32);
  }
  let tmp: string = root + ".tmp-" + suffix;
  for a in __fern_assets() {
    let path: string = tmp + "/" + a.0;
    match (create_dir_all(util.dir_of(path))) {
      Ok(_) => {},
      Err(e) => {
        eprint("fern: cannot create " + util.dir_of(path) + ": " + e.message());
        return "";
      }
    }
    match (write_file(path, a.1)) {
      Ok(_) => {},
      Err(e) => {
        eprint("fern: cannot write " + path + ": " + e.message());
        return "";
      }
    }
  }
  match (rename(tmp, root)) {
    Ok(_) => {
      return root;
    },
    Err(e) => {
      match (read_file(root + "/std/io.fern")) {
        Ok(_) => {
          return root;
        },
        Err(_) => {}
      }
      eprint("fern: cannot install the stdlib at " + root + ": " + e.message());
      return "";
    }
  }
}
