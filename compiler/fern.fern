function blank_line_map(src: string): boolean[] {
  let out: boolean[] = [false];
  let i = 0;
  let n = src.len();
  let blank = true;
  while (i < n) {
    let b = src[i] as i32;
    if (b == 10) {
      out = out.append(blank);
      blank = true;
    } else if (b != 32 && b != 9 && b != 13) {
      blank = false;
    }
    i += 1;
  }
  out = out.append(blank);
  return out;
}

function fmt_output_is_readable(path: string, src: string, formatted: string): boolean {
  if (is_literate(path)) {
    return literate_output_is_readable(src, formatted);
  }
  let (again, errs) = format_source(formatted);
  return errs.len() == 0 && again == formatted && content_print(src) == content_print(formatted);
}

function content_print(src: string): string {
  let lx = lexer.tokenize_full(src);
  let m = parser.parse_module(lx.tokens);
  let out: string[] = [];
  for c in lx.comments {
    out = out.append("//" + c.text.trim() + "\n");
  }
  for im in m.imports {
    out = out.append("import " + im.path + " " + im.alias + "\n");
  }
  for f in m.funcs {
    out = out.append("function " + f.receiver_type + "." + f.name + " " + util.i32_to_string(f.body.len()) + "\n");
  }
  for s in m.structs {
    out = out.append("struct " + s.name + " " + util.i32_to_string(s.fields.len()) + "\n");
  }
  for e in m.enums {
    out = out.append("enum " + e.name + " " + util.i32_to_string(e.variant_names.len()) + "\n");
  }
  for a in m.aliases {
    out = out.append("type " + a.name + "\n");
  }
  for t in m.trait_decls {
    out = out.append("trait " + t.name + " " + util.i32_to_string(t.methods.len()) + "\n");
  }
  for ii in m.impls {
    out = out.append("impl " + ii.trait_name + " " + ii.impl_type + " " + util.i32_to_string(ii.method_names.len()) + "\n");
  }
  out = out.append("statements " + util.i32_to_string(m.top_stmts.len()));
  return util.str_join_chunks(out);
}

function format_source(src: string): (string, Finding[]) {
  let flex = lexer.tokenize_full(src);
  let pf = parser.parse_module_verbatim(flex.tokens);
  let errs = parse_findings(pf.pmod);
  if (errs.len() > 0) {
    return ("", errs);
  }
  return (printer.format_parsed(pf, flex.comments, blank_line_map(src)), errs);
}

function format_text(path: string, src: string): (string, Finding[]) {
  if (is_literate(path)) {
    let none: Finding[] = [];
    return (format_literate(src), none);
  }
  return format_source(src);
}

const FMT_WRAP_OPEN: string = "function __fern_fmt_wrap__() {\n";

function fmt_wrap(body: string): string {
  return FMT_WRAP_OPEN + body + "\n}\n";
}

function parses_as_decls(src: string): boolean {
  let m = parser.parse_module(lexer.tokenize(src));
  return m.top_stmts.len() == 0 && parse_findings(m).len() == 0;
}

function trim_trailing_newlines(s: string): string {
  let n = s.len();
  while (n > 0 && s[n - 1] == b'\n') {
    n -= 1;
  }
  return slice_unchecked(s, 0, n).to_owned();
}

function unwrap_formatted(formatted: string): string {
  let lines = literate.split_lines(trim_trailing_newlines(formatted));
  let out: string[] = [];
  for i in 1..lines.len() - 1 {
    if (i > 1) {
      out = out.append("\n");
    }
    let ln = lines[i];
    if (ln.starts_with("  ")) {
      ln = slice_unchecked(ln, 2, ln.len()).to_owned();
    }
    out = out.append(ln);
  }
  return util.str_join_chunks(out);
}

function format_chunk_body(body: string): (boolean, string) {
  if (body.trim().len() == 0) {
    return (false, "");
  }
  if (parses_as_decls(body)) {
    let (formatted, _) = format_source(body);
    return (true, trim_trailing_newlines(formatted));
  }
  let wrapped = fmt_wrap(body);
  if (parses_as_decls(wrapped)) {
    let (formatted, _) = format_source(wrapped);
    return (true, unwrap_formatted(formatted));
  }
  return (false, "");
}

function formats_body(b: literate.Block): boolean {
  return b.kind == literate.CHUNK || b.kind == literate.FILE;
}

function format_literate(src: string): string {
  let d = literate.parse(src);
  let parts: string[] = [];
  let next = 0;
  for b in d.blocks {
    if (formats_body(b) && b.count > 0) {
      let (ok, formatted) = format_chunk_body(literate.join_range(d.lines, b.first, b.first + b.count));
      if (ok) {
        parts = append_lines(parts, d.lines, next, b.first);
        parts = append_line(parts, formatted);
        next = b.first + b.count;
      }
    }
  }
  parts = append_lines(parts, d.lines, next, d.lines.len());
  return util.str_join_chunks(parts);
}

function append_line(parts: string[], line: string): string[] {
  if (parts.len() > 0) {
    parts = parts.append("\n");
  }
  return parts.append(line);
}

function append_lines(parts: string[], lines: string[], from: i32, to: i32): string[] {
  for i in from..to {
    parts = append_line(parts, lines[i]);
  }
  return parts;
}

function literate_output_is_readable(src: string, formatted: string): boolean {
  if (format_literate(formatted) != formatted) {
    return false;
  }
  let a = literate.parse(src);
  let b = literate.parse(formatted);
  if (doc_outside_bodies(a) != doc_outside_bodies(b)) {
    return false;
  }
  for i in 0..a.blocks.len() {
    let x = a.blocks[i];
    let y = b.blocks[i];
    if (formats_body(x)) {
      let before = literate.join_range(a.lines, x.first, x.first + x.count);
      let after = literate.join_range(b.lines, y.first, y.first + y.count);
      if (before != after && !chunk_keeps_content(before, after)) {
        return false;
      }
    }
  }
  return true;
}

function doc_outside_bodies(d: literate.Doc): string {
  let parts: string[] = [];
  for b in d.blocks {
    parts = append_line(parts, util.i32_to_string(b.kind) + " " + b.name);
  }
  let next = 0;
  for b in d.blocks {
    if (formats_body(b)) {
      parts = append_lines(parts, d.lines, next, b.first);
      next = b.first + b.count;
    }
  }
  parts = append_lines(parts, d.lines, next, d.lines.len());
  return util.str_join_chunks(parts);
}

function chunk_keeps_content(before: string, after: string): boolean {
  if (parses_as_decls(before)) {
    return content_print(before) == content_print(after);
  }
  return content_print(fmt_wrap(before)) == content_print(fmt_wrap(after));
}

function comma_joined(xs: string[]): string {
  let joined = "";
  for x in xs {
    if (joined.len() > 0) {
      joined += ", ";
    }
    joined += x;
  }
  return joined;
}

function read_source(path: string): Result[string, lexer.TokError] {
  return read_source_file(path, true);
}

function read_source_file(path: string, stdin_allowed: boolean): Result[string, lexer.TokError] {
  if (path == "-" && stdin_allowed) {
    return decode_source_read(io.read_all_stdin_bytes());
  }
  return decode_source_read(read_file_bytes(path));
}

function decode_source_read(input: Result[u8[], IoError]): Result[string, lexer.TokError] {
  match (input) {
    Ok(bytes) => {
      return lexer.decode_source(bytes);
    },
    Err(e) => {
      return Err(lexer.TokError { msg: e.message(), code: "", line: 0, col: 0 });
    }
  }
}

function report_source_read_failure(st: DiagStyle, what: string, path: string, e: lexer.TokError): void {
  if (e.code.len() > 0) {
    let d = util.Diag { related: [], length: 0, code: e.code, message: e.msg, line: e.line, col: e.col, fix: None };
    let no_files: string[] = [];
    let no_maps: util.LineMap[] = [];
    eprint_findings(st, errors_of([d]), entry_display(path), no_files, no_maps);
  } else {
    eprint(read_failure(what, path, e.msg));
  }
}

function read_failure(what: string, path: string, reason: string): string {
  return "fern: cannot read " + what + " " + path + ": " + reason;
}

// A mode written with no dash is read as the entry file. The line names the
// flag.
function report_entry_read_failure(st: DiagStyle, path: string, e: lexer.TokError): void {
  report_source_read_failure(st, "entry file", path, e);
  if (find_flag("-" + path).mode) {
    eprint("fern: " + path + " is not a file: the mode flag is -" + path);
  }
}

// With -d, exit 1 means that a file differs. A file with no diff to show
// exits 2, as diff(1) does.
function fmt_failure_code(fmt_diff: boolean): i32 {
  if (fmt_diff) {
    return 2;
  }
  return 1;
}

function fmt_file(st: DiagStyle, path: string, fmt_write: boolean, fmt_diff: boolean, out_path: string): i32 {
  if (path == "-" && fmt_write) {
    eprint("fern: -fmt -w cannot write back stdin; drop -w to print the result");
    return 2;
  }
  let esrc = "";
  match (read_source(path)) {
    Ok(s) => {
      esrc = s;
    },
    Err(e) => {
      report_source_read_failure(st, "file", path, e);
      return fmt_failure_code(fmt_diff);
    }
  }
  let name = entry_display(path);
  let (formatted, errs) = format_text(name, esrc);
  let no_files: string[] = [];
  if (eprint_findings(st, errs, name, no_files, [util.no_line_map()])) {
    return fmt_failure_code(fmt_diff);
  }
  if (fmt_diff) {
    let d = printer.unified_diff(esrc, formatted, name, name);
    if (d.len() == 0) {
      return 0;
    }
    write(d);
    return 1;
  }
  if (fmt_write) {
    return fmt_write_back(path, esrc, formatted);
  }
  if (out_path.len() > 0) {
    match (write_file(out_path, formatted)) {
      Err(e) => {
        eprint("fern: cannot write output " + out_path + ": " + e.message());
        return 1;
      },
      Ok(_) => {}
    }
  } else {
    write(formatted);
  }
  return 0;
}

function fmt_write_back(path: string, src: string, formatted: string): i32 {
  if (!fmt_output_is_readable(path, src, formatted)) {
    eprint("fern: " + path + ": refusing to write back — the formatted output does not re-parse to the same content; this is a formatter bug, please report it");
    return 1;
  }
  match (write_file(path, formatted)) {
    Err(e) => {
      eprint("fern: cannot write back " + path + ": " + e.message());
      return 1;
    },
    Ok(_) => {}
  }
  return 0;
}

struct Finding { diag: util.Diag, warning: boolean, path: string }

struct Checked { findings: Finding[], entry: string, files: string[], maps: util.LineMap[], ok: boolean }

function errors_of(ds: util.Diag[]): Finding[] {
  let out: Finding[] = [];
  for d in ds {
    out = out.append(Finding { diag: d, warning: false, path: "" });
  }
  return out;
}

function refusal(msg: string): Finding {
  return Finding { diag: util.Diag { related: [], length: 0, code: "", message: msg, line: 0, col: 0, fix: None }, warning: false, path: "" };
}

function has_error(fs: Finding[]): boolean {
  for f in fs {
    if (!f.warning) {
      return true;
    }
  }
  return false;
}

pub struct DiagStyle { color: boolean, ascii: boolean, terse: boolean, json: boolean }

pub function plain_style(): DiagStyle {
  return DiagStyle { color: false, ascii: true, terse: false, json: false };
}

function diag_style(mode: string, force_ascii: boolean, format: string): DiagStyle {
  if (format != "full") {
    return DiagStyle { color: false, ascii: true, terse: true, json: format == "json" };
  }
  let color = mode == "always";
  if (mode == "auto") {
    color = isatty(2);
    match (env("NO_COLOR")) {
      Some(v) => {
        if (v.len() > 0) {
          color = false;
        }
      },
      None => {}
    }
  }
  let ascii = true;
  if (!force_ascii) {
    for k in ["LC_ALL", "LC_CTYPE", "LANG"] {
      match (env(k)) {
        Some(v) => {
          if (v.len() > 0) {
            let up = v.to_upper();
            ascii = !util.contains(up, "UTF-8") && !util.contains(up, "UTF8");
            break;
          }
        },
        None => {}
      }
    }
  }
  return DiagStyle { color: color, ascii: ascii, terse: false, json: false };
}

function diag_format_from_env(): string {
  match (env("FERN_DIAG_FORMAT")) {
    Some(value) => {
      if (value == "terse" || value == "json") {
        return value;
      }
      return "full";
    },
    None => {
      return "full";
    }
  }
}

function json_position(file: string, line: i32, col: i32, length: i32): string {
  return "\"file\":\"" + json.escape(file) + "\",\"line\":" + util.i32_to_string(line) + ",\"col\":" + util.i32_to_string(col)
    + ",\"length\":" + util.i32_to_string(length);
}

function json_diagnostic(position: string, severity: string, code: string, message: string, related: string[]): string {
  return "{" + position + ",\"severity\":\"" + severity + "\",\"code\":\"" + json.escape(code) + "\",\"message\":\""
    + json.escape(message) + "\",\"related\":[" + comma_joined(related) + "]}";
}

function finding_file(f: Finding, entry: string, files: string[], line: i32): string {
  if (line <= 0) {
    return "";
  }
  if (f.path.len() > 0) {
    return f.path;
  }
  let path = util.pos_file(files, line);
  if (path.len() == 0) {
    return entry_display(entry);
  }
  return path;
}

function finding_json(f: Finding, entry: string, files: string[], d: util.Diag): string {
  let related: string[] = [];
  let unplaced = Finding { diag: d, warning: false, path: "" };
  for r in d.related {
    related = related.append("{" + json_position(finding_file(unplaced, entry, files, r.line), util.pos_line(r.line), r.col, r.length)
      + ",\"message\":\"" + json.escape(r.message) + "\"}");
  }
  let severity: string = if (f.warning) { "warning" } else { "error" };
  let line: i32 = if (d.line > 0) { util.pos_line(d.line) } else { 0 };
  return json_diagnostic(json_position(finding_file(f, entry, files, d.line), line, d.col, d.length), severity, f.diag.code, d.message, related);
}

function paint(st: DiagStyle, sgr: string, text: string): string {
  if (!st.color) {
    return text;
  }
  return "\x1b[" + sgr + "m" + text + "\x1b[0m";
}

function source_line(path: string, n: i32): string {
  if (path.len() == 0 || path == "<stdin>" || n <= 0) {
    return "";
  }
  match (read_file(path)) {
    Ok(src) => {
      let cur = 1;
      let start = 0;
      for i in 0..=src.len() {
        if (i == src.len() || src[i] == b'\n') {
          if (cur == n) {
            return slice_unchecked(src, start, i).replace("\t", " ");
          }
          cur += 1;
          start = i + 1;
        }
      }
      return "";
    },
    Err(_) => {
      return "";
    }
  }
}

function snippet(st: DiagStyle, path: string, line: i32, col: i32, sgr: string, length: i32): string {
  return marked_snippet(st, path, line, col, sgr, length, false);
}

function marked_snippet(st: DiagStyle, path: string, line: i32, col: i32, sgr: string, length: i32, related: boolean): string {
  let text = source_line(path, line);
  if (text.len() == 0) {
    return "";
  }
  let pad = "";
  let w = col - 1;
  if (w > text.len()) {
    w = text.len();
  }
  let room = text.len() - w;
  while (w > 0) {
    pad += " ";
    w -= 1;
  }
  let mark = paint(st, sgr, snippet_mark(length, room, related));
  let indent = "    ";
  if (related) {
    indent = "        ";
  }
  if (!st.color) {
    return "\n" + indent + text + "\n" + indent + pad + mark;
  }
  return "\n " + util.i32_to_string(line) + " " + gutter_sep(st) + " " + text + "\n" + note_prefix(st, line) + pad + mark;
}

function snippet_mark(length: i32, room: i32, related: boolean): string {
  let n = length;
  if (n > room) {
    n = room;
  }
  let mark = "^";
  let fill = "~";
  if (related) {
    mark = "-";
    fill = "-";
  }
  while (n > 1) {
    mark += fill;
    n -= 1;
  }
  return mark;
}

function note_prefix(st: DiagStyle, line: i32): string {
  if (!st.color) {
    return "    ";
  }
  let blank = "";
  let b = 0;
  while (b < util.i32_to_string(line).len()) {
    blank += " ";
    b += 1;
  }
  return " " + blank + " " + gutter_sep(st) + " ";
}

function gutter_sep(st: DiagStyle): string {
  if (st.ascii) {
    return paint(st, "34", "|");
  }
  return paint(st, "34", "│");
}

function help_line(st: DiagStyle, d: util.Diag): string {
  if let Some(f) = d.fix {
    return "\n" + note_prefix(st, util.pos_line(d.line)) + paint(st, "34", "help:") + " " + f.title;
  }
  return "";
}

function finding_header(st: DiagStyle, f: Finding, entry: string, files: string[], d: util.Diag): string {
  let tag = "";
  if (f.warning) {
    tag = paint(st, "1;33", "warning[" + f.diag.code + "]") + ": ";
  } else if (f.diag.code.len() > 0) {
    tag = paint(st, "1;31", "error[" + f.diag.code + "]") + ": ";
  } else if (d.line > 0) {
    tag = paint(st, "1;31", "error") + ": ";
  }
  if (d.line <= 0) {
    return tag + d.message;
  }
  let head = "";
  if (f.path.len() > 0) {
    head = f.path + ":" + util.pos_str("", files, d.line, d.col);
  } else {
    head = util.pos_str(entry_display(entry), files, d.line, d.col);
  }
  return head + ": " + tag + d.message;
}

function finding_text(st: DiagStyle, f: Finding, entry: string, files: string[], maps: util.LineMap[]): string {
  let d = util.doc_diag(maps, f.diag);
  if (st.json) {
    return finding_json(f, entry, files, d);
  }
  let head = finding_header(st, f, entry, files, d);
  if (st.terse) {
    return head.replace("\r", "\\r").replace("\n", "\\n");
  }
  let related = related_text(st, d.related, entry, files);
  if (d.line <= 0) {
    return head + related;
  }
  let path = util.pos_file(files, d.line);
  if (f.path.len() > 0) {
    path = f.path;
  } else if (path.len() == 0) {
    path = entry_display(entry);
  }
  let sgr: string = if (f.warning) { "33" } else { "31" };
  return head + snippet(st, path, util.pos_line(d.line), d.col, sgr, d.length) + related + help_line(st, d);
}

function related_text(st: DiagStyle, related: util.Related[], entry: string, files: string[]): string {
  let out = "";
  for r in related {
    let path = util.pos_file(files, r.line);
    if (path.len() == 0) {
      path = entry_display(entry);
    }
    out = out + "\n    " + util.pos_str(entry_display(entry), files, r.line, r.col) + ": " + paint(st, "34", "note:") + " " + r.message;
    out += marked_snippet(st, path, util.pos_line(r.line), r.col, "34", r.length, true);
  }
  return out;
}

function entry_display(entry_path: string): string {
  if (entry_path == "-") {
    return "<stdin>";
  }
  return entry_path;
}

function eprint_findings(st: DiagStyle, fs: Finding[], entry: string, files: string[], maps: util.LineMap[]): boolean {
  for f in by_position(fs, maps) {
    eprint(finding_text(st, f, entry, files, maps));
  }
  return has_error(fs);
}

function by_position(fs: Finding[], maps: util.LineMap[]): Finding[] {
  return util.sorted_by(fs, (a: Finding, b: Finding) => finding_after(a, b, maps));
}

function finding_after(a: Finding, b: Finding, maps: util.LineMap[]): boolean {
  if (a.path != b.path) {
    return util.str_less(b.path, a.path);
  }
  return util.diag_after(util.doc_diag(maps, a.diag), util.doc_diag(maps, b.diag));
}

function word_buf(emit_text: boolean): usize {
  if (emit_text) {
    return 0 as usize;
  }
  return buf_new(1048576);
}

function words_of(recs: usize): u8[] {
  let words = buf_take_bytes(recs);
  buf_free(recs);
  return words;
}

function comp_dir(): string {
  match (getcwd()) {
    Ok(wd) => {
      return wd;
    },
    Err(_) => {
      return ".";
    }
  }
}

function darwin_dwarf(p: arm64_native.Arm64GasProg, tv: i64, dv: i64, cu_name: string, dir: string): i32[][] {
  let a = p.asm;
  let names: string[] = [];
  for n in a.lab_names {
    if (n.len() > 0 && n[0] == b'L') {
      names = names.append("");
    } else {
      names = names.append(n);
    }
  }
  let nosec: i32[] = [];
  let end = arm64_native.arm64_code_len(p);
  let dw: elf.DwSections = elf.dw_sections(
    tv, end,
    elf.elf_func_sym_names(names, a.lab_offs, nosec, -1, end),
    elf.elf_func_sym_offs(names, a.lab_offs, nosec, -1, end),
    elf.elf_func_sym_sizes(names, a.lab_offs, nosec, -1, end),
    cu_name, dir,
    a.files, a.loc_offs, a.loc_files, a.loc_lines, a.loc_cols, a.loc_flags,
    elfimage.arm64_var_ranges(p),
  );
  return [dw.abbrev, dw.info, dw.line, dw.loc];
}

// A kernel image: the position-independent layout at `base`, as an ET_EXEC that
// the loader enters at _start.
function arm64_kernel_image(asm: string, words: u8[], base: i64): u8[] {
  let p = arm64_native.arm64_gas_program_words(asm, words, elf.elf_text_vaddr_pie(false));
  if (p.unknown.len() > 0) {
    return elfimage.arm64_refusals("arm64-kernel", "assembler", p.unknown);
  }
  let tv = base + elf.elf_text_vaddr_pie(false) as i64;
  let dv = base + elf.elf_data_vaddr_kernel(p.asm.text.len()) as i64;
  let gap = elf.elf_executable_relro_gap(p.relro_pad, elf.elf_page_align());
  p = arm64_native.arm64_relro_gap(p, gap);
  p = arm64_native.arm64_gas_link(p, tv, dv);
  if (p.unknown.len() > 0) {
    return elfimage.arm64_refusals("arm64-kernel", "linker", p.unknown);
  }
  let eoff = arm64_native.arm64_asm_label_off(p.asm, "_start");
  return elf.elf_image_kernel(p.asm.text, p.data, elf.elf_em_aarch64(), eoff, p.bss_size, p.relro_pad, base);
}

function arm64_linux_image(image: u8[], base: i64, size: i64): u8[] {
  let b = elf.elf_arm64_linux_image(image[:], base, size);
  if (b.len() == 0) {
    eprint("fern: the load segments of the arm64-kernel image do not ascend, so it has no Image form");
  }
  return b;
}

// A PVH kernel image: the fixed layout at `base`, which a VMM enters at the
// 32-bit _start.
function x86_kernel_image(asm: string, words: u8[], base: i64): u8[] {
  let a = x86_native.x86_gas_assemble_words_unlinked(asm, words);
  let tv = base + elf.elf_text_off_pvh() as i64;
  let dv = base + elf.elf_data_vaddr_pvh(a.text.len()) as i64;
  let gap = elf.elf_executable_relro_gap(a.relro_pad, elf.elf_x86_page_align());
  a = x86_native.x86_relro_gap(a, gap);
  a = x86_native.x86_link(a, tv as i32, dv as i32);
  if (a.unknown.len() > 0) {
    eprint("fern: -target x86-64-kernel: in-process assembler could not encode: " + a.unknown[0]);
    return [];
  }
  let eoff = x86_native.x86_label_off(a, "_start");
  return elf.elf_image_kernel_pvh(a.text, a.rodata, eoff, a.bss_size, a.relro_pad, base);
}

// The -export names and the JNI symbols. With neither, a shared object
// exports main.
function shared_export_names(list: string, jni: JniMethod[]): string[] {
  let out: string[] = [];
  if (list.len() > 0) {
    out = list.split(",");
  }
  for jm in jni {
    out = out.append(jm.symbol);
  }
  if (out.len() == 0) {
    return ["main"];
  }
  return out;
}

function shared_export_refusal(merged: parser.Module, names: string[]): string {
  for n in names {
    let k = export_func_index(merged, n);
    if (k < 0) {
      return "-export " + n + ": the program has no top-level function " + n;
    }
    if (merged.funcs[k].all_type_params.len() > 0) {
      return "-export " + n + ": a generic function has no single body to export";
    }
    let jni = jni_export_refusal(merged.funcs[k]);
    if (jni.len() > 0) {
      return "-export " + n + ": " + jni;
    }
  }
  return "";
}

// A C import is a function with @import(library, symbol) and no body, where
// the library is a shared-object name such as "liblog.so" or "libc.so.6". A
// WIT interface such as "wasi:http/types@0.2.0" names a wasm import instead.
function is_c_library(iface: string): boolean {
  return !iface.contains(":") && (iface.ends_with(".so") || iface.contains(".so."));
}

// On a native target a C import becomes a Fern function that calls through a slot, which
// the dynamic loader fills with the symbol's address. The stub
// __fern_import_<k> keeps the @import, and the emitter gives it a body that
// reads that slot.
function import_stub(k: i32): string {
  return "__fern_import_" + util.i32_to_string(k);
}

function c_import_floats(f: parser.FuncDecl): i32 {
  let n = 0;
  for p in f.params {
    if (cabi.is_float(p.type_name)) {
      n += 1;
    }
  }
  return n;
}

function c_import_refusal(f: parser.FuncDecl, structs: parser.StructDecl[], target: string): string {
  let what = "@import " + f.name + ": ";
  let floats = c_import_floats(f);
  let ints = f.params.len() - floats;
  if (ints > 14 || floats > 8) {
    return what + "a C import takes at most 14 integer parameters and 8 float parameters (it has " + util.i32_to_string(ints) + " and " + util.i32_to_string(floats) + ")";
  }
  let bad = cabi.refusal(f, structs, is_native_target(target), target.starts_with("arm64"));
  if (bad.len() > 0) {
    return what + bad;
  }
  return "";
}

pub function native_import_refusal(m: parser.Module, target: string): string {
  for f in m.funcs {
    if (is_c_library(f.import_iface)) {
      let bad = c_import_refusal(f, m.structs, target);
      if (bad.len() > 0) {
        return bad;
      }
    }
  }
  return "";
}

// The first @callback or C @import that the program still reaches after
// tree shaking, and that the build cannot give it: a callback needs a
// native -shared object, and a C import needs a dynamic loader. A
// declaration that nothing reaches is not refused, so a host program can
// use the types of a module for Android.
function reached_native_refusal(m: parser.Module, target: string, shared: boolean): string {
  for f in m.funcs {
    if (is_callback(f) && !(shared && is_native_target(target))) {
      return "@callback " + f.name + ": a callback needs -shared and a native target";
    }
    if (is_c_library(f.import_iface) && !is_native_target(target)) {
      return "@import " + f.name + ": -target " + target + " cannot load the C library " + f.import_iface;
    }
    if (is_c_library(f.import_iface) && !shared) {
      return "@import " + f.name + ": an executable for -target " + target + " has no dynamic loader; build a -shared object to import " + f.import_wit + " from " + f.import_iface;
    }
  }
  return "";
}

// The data slot of import stub `stub`.
function got_label(stub: string): string {
  return "__fern_got" + slice_unchecked(stub, "__fern_import".len(), stub.len());
}

function is_callback(f: parser.FuncDecl): boolean {
  return f.import_iface == parser.CALLBACK_IFACE;
}

// The functions that @callback declarations give to C. Each one gets a C
// entry, and no dynamic symbol.
function callback_targets(m: parser.Module): string[] {
  let out: string[] = [];
  for f in m.funcs {
    if (is_callback(f) && !util.has_str(out, f.import_wit)) {
      out = out.append(f.import_wit);
    }
  }
  return out;
}

function callback_refusal(m: parser.Module): string {
  for f in m.funcs {
    if (is_callback(f)) {
      let what = "@callback " + f.name + ": ";
      if (f.params.len() > 0 || f.ret_type != "usize") {
        return what + "the declaration takes no parameters and returns usize";
      }
      let k = export_func_index(m, f.import_wit);
      if (k < 0) {
        return what + "the program has no top-level function " + f.import_wit;
      }
      if (m.funcs[k].all_type_params.len() > 0) {
        return what + "a generic function has no single body to give to C";
      }
    }
  }
  return "";
}

// The C entries of a shared object: its exports, then the callback targets
// that are not exports.
function entry_names(merged: parser.Module, roots: string[]): string[] {
  let out = roots;
  for t in callback_targets(merged) {
    if (!util.has_str(out, t)) {
      out = out.append(t);
    }
  }
  return out;
}

// The body of callback declaration `f`: it returns the address of the C
// entry of its target.
function callback_entry(f: parser.FuncDecl, arm64: boolean): string {
  let entry = "__fern_export_" + f.import_wit;
  if (arm64) {
    return "__fn_" + f.name + ":\n    adrp x0, " + entry + "\n    add x0, x0, :lo12:" + entry + "\n    ret\n";
  }
  return "__fn_" + f.name + ":\n    leaq " + entry + "(%rip), %rax\n    ret\n";
}

// Each import stub's slot, and the stub's body, which returns the slot's
// contents: the address that the dynamic loader writes there. Then the body
// of each callback declaration.
function import_entries(merged: parser.Module, arm64: boolean): string {
  let out = "";
  for f in merged.funcs {
    if (is_callback(f)) {
      out += callback_entry(f, arm64);
    }
    if (is_c_library(f.import_iface)) {
      let got = got_label(f.name);
      if (arm64) {
        out = out + "    .section .data\n    .align 3\n" + got + ":\n    .quad 0\n    .text\n";
        out = out + "__fn_" + f.name + ":\n    adrp x0, " + got + "\n    ldr x0, [x0, :lo12:" + got + "]\n    ret\n";
      } else {
        out = out + "    .section .data\n    .align 8\n" + got + ":\n    .quad 0\n    .text\n";
        out = out + "__fn_" + f.name + ":\n    movq " + got + "(%rip), %rax\n    ret\n";
      }
    }
  }
  return out;
}

// The libraries and symbols of the import stubs. The slots are found after
// assembly.
function so_imports(merged: parser.Module): elf.SoImports {
  let imp = elf.no_so_imports();
  for f in merged.funcs {
    if (is_c_library(f.import_iface)) {
      imp = elf.SoImports { libs: imp.libs.append(f.import_iface), syms: imp.syms.append(f.import_wit), slots: imp.slots.append(0), data: imp.data.append(false), weak: imp.weak.append(f.import_weak) };
    }
  }
  return imp;
}

function shared_environ_import(imp: elf.SoImports, slot: i32, target: string): elf.SoImports {
  let libc = "libc.so.6";
  if (asmcore.is_android(target)) {
    libc = "libc.so";
  }
  return elf.SoImports { libs: imp.libs.append(libc), syms: imp.syms.append("environ"), slots: imp.slots.append(slot), data: imp.data.append(true), weak: imp.weak.append(false) };
}

function import_stub_names(merged: parser.Module): string[] {
  let out: string[] = [];
  for f in merged.funcs {
    if (is_c_library(f.import_iface)) {
      out = out.append(f.name);
    }
  }
  return out;
}

// The declaration of stub `k`, which keeps the @import of `f`.
function stub_decl(f: parser.FuncDecl, k: i32): string {
  let weak = "";
  if (f.import_weak) {
    weak = ", weak";
  }
  return "@import(\"" + f.import_iface + "\", \"" + f.import_wit + "\"" + weak + ")\nfunction " + import_stub(k) + "(): usize;\n";
}

// The source of the body that calls C import `f` through stub `k`.
function c_import_body(f: parser.FuncDecl, k: i32, structs: parser.StructDecl[], arm64: boolean): string {
  if (c_import_floats(f) > 0 || f.params.len() > 6 || cabi.has_struct(f)) {
    return cabi.body(f, structs, arm64, "body_" + util.i32_to_string(k), import_stub(k) + "()") + stub_decl(f, k);
  }
  let args = import_stub(k) + "()";
  let params = "";
  for p in f.params {
    args = args + ", " + p.name + " as usize";
    if (params.len() > 0) {
      params += ", ";
    }
    params = params + p.name + ": " + p.type_name;
  }
  let n = util.i32_to_string(f.params.len());
  let call = "__c_call" + n + "(" + args + ")";
  let ret = "";
  let stmt = "let ignored: usize = " + call + ";";
  if (f.ret_type == "f32" || f.ret_type == "f64") {
    ret = ": " + f.ret_type;
    stmt = "return __c_call" + n + "_" + f.ret_type + "(" + args + ");";
  } else if (f.ret_type != "" && f.ret_type != "void") {
    ret = ": " + f.ret_type;
    stmt = "return " + call + " as " + f.ret_type + ";";
  }
  return "function body_" + util.i32_to_string(k) + "(" + params + ")" + ret + " {\n  unsafe {\n    " + stmt + "\n  }\n}\n"
    + stub_decl(f, k);
}

function has_c_imports(m: parser.Module): boolean {
  for f in m.funcs {
    if (is_c_library(f.import_iface)) {
      return true;
    }
  }
  return false;
}

pub function native_imports(m: parser.Module, target: string, shared: boolean): parser.Module {
  if (!is_native_target(target) || !shared || !has_c_imports(m)) {
    return m;
  }
  let funcs: parser.FuncDecl[] = [];
  for k in 0..m.funcs.len() {
    let f = m.funcs[k];
    if (!is_c_library(f.import_iface)) {
      funcs = funcs.append(f);
    } else {
      let gen = parser.parse_module(lexer.tokenize(c_import_body(f, k, m.structs, target.starts_with("arm64"))));
      let body = gen.funcs[0];
      let stub = gen.funcs[1];
      funcs = funcs.append(parser.FuncDecl { ...f, body: body.body, import_iface: "", import_wit: "", import_weak: false });
      funcs = funcs.append(parser.FuncDecl { ...stub, module: f.module, stdlib: f.stdlib, line: f.line, col: f.col });
    }
  }
  return parser.Module { ...m, funcs: funcs };
}

// A JNI method from @jni(class, declaration). The declaration is Java:
// "[static] result name(type, ...)". `symbol` is the JNI symbol of the
// generated wrapper that calls `func`.
struct JniMethod { func: parser.FuncDecl, class: string, superclass: string, interfaces: string[], is_static: boolean, result: string, name: string, types: string[], params: string[], symbol: string }

// The class argument of @jni: a class name, with "extends S" and
// "implements A, B" after it as a Java class head has them. `superclass` is
// "" when the head does not name one.
struct JavaClassHead { ok: boolean, name: string, superclass: string, interfaces: string[] }

function java_class_head(text: string): JavaClassHead {
  let none: string[] = [];
  let bad = JavaClassHead { ok: false, name: "", superclass: "", interfaces: none };
  let rest = text.trim();
  let interfaces: string[] = [];
  let at = util.index_of_sub(rest, " implements ");
  if (at >= 0) {
    for part in slice_unchecked(rest, at + 12, rest.len()).split(",") {
      interfaces = interfaces.append(part.trim());
    }
    rest = slice_unchecked(rest, 0, at).trim();
  }
  let superclass = "";
  let ext = util.index_of_sub(rest, " extends ");
  if (ext >= 0) {
    superclass = slice_unchecked(rest, ext + 9, rest.len()).trim();
    rest = slice_unchecked(rest, 0, ext).trim();
  }
  for n in interfaces.append(superclass) {
    if (n.len() > 0 && !jni_type_name_ok(n)) {
      return bad;
    }
  }
  if (!jni_name_ok(rest)) {
    return bad;
  }
  return JavaClassHead { ok: true, name: rest, superclass: superclass, interfaces: interfaces };
}

function has_head(jm: JniMethod): boolean {
  return jm.superclass.len() > 0 || jm.interfaces.len() > 0;
}

// The head as Java source writes it: a nested type has "." in place of "$".
function head_text(jm: JniMethod): string {
  let out = "";
  if (jm.superclass.len() > 0) {
    out = " extends " + jm.superclass.replace("$", ".");
  }
  for k in 0..jm.interfaces.len() {
    if (k == 0) {
      out += " implements ";
    } else {
      out += ", ";
    }
    out += jm.interfaces[k].replace("$", ".");
  }
  return out;
}

// Gives each method the head of its class. One method of a class can name
// the head, and two different heads of one class are a refusal.
function jni_unify_heads(methods: JniMethod[]): (JniMethod[], string) {
  let out: JniMethod[] = [];
  for jm in methods {
    let head = jm;
    for other in methods {
      if (other.class == jm.class && has_head(other)) {
        if (has_head(head) && head_text(head) != head_text(other)) {
          return (out, "@jni " + other.func.name + ": class " + jm.class + " is declared as" + head_text(head) + " and as" + head_text(other));
        }
        head = other;
      }
    }
    out = out.append(JniMethod { ...jm, superclass: head.superclass, interfaces: head.interfaces });
  }
  return (out, "");
}

// The Fern type of Java type `t`, or "" for void. A Java reference, such as
// String or int[], is a usize. A byte, char or short is an i32, and the
// wrapper extends it with jni_extend.
function jni_fern_type(t: string): string {
  let java: string[] = ["void", "boolean", "byte", "char", "short", "int", "long", "float", "double"];
  let fern: string[] = ["", "u8", "i32", "i32", "i32", "i32", "i64", "f32", "f64"];
  let k = util.index_of_str(java, t);
  if (k >= 0) {
    return fern[k];
  }
  return "usize";
}

// The expression `e` extended from the width of Java type `t` to 32 bits.
// The C ABIs do not specify the bits above a narrow argument or result.
function jni_extend(t: string, e: string): string {
  return match (t) {
    "byte" => "((" + e + ") << 24) >> 24",
    "short" => "((" + e + ") << 16) >> 16",
    "char" => "(" + e + ") & 65535",
    _ => e,
  };
}

function jni_name_char(c: u8): boolean {
  return c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c >= b'0' && c <= b'9' || c == b'_' || c == b'.';
}

// A superclass or an interface can be a nested type, such as
// "android.media.AudioManager$OnAudioFocusChangeListener".
function jni_type_name_ok(s: string): boolean {
  return s.len() > 0 && jni_name_ok(s.replace("$", "_"));
}

function jni_name_ok(s: string): boolean {
  if (s.len() == 0) {
    return false;
  }
  for c in s.bytes() {
    if (!jni_name_char(c)) {
      return false;
    }
  }
  return true;
}

// A Java name as a JNI symbol spells it: "." becomes "_" and "_" becomes "_1".
function jni_mangle(s: string): string {
  let out = "";
  for c in s.bytes() {
    if (c == b'.') {
      out += "_";
    } else if (c == b'_') {
      out += "_1";
    } else {
      unsafe {
        out += string_from_bytes_unchecked([c]);
      }
    }
  }
  return out;
}

function char_at(s: string, c: u8): i32 {
  for i in 0..s.len() {
    if (s[i] == c) {
      return i;
    }
  }
  return -1;
}

function jni_bad(f: parser.FuncDecl, why: string): (JniMethod, string) {
  let none: string[] = [];
  return (JniMethod { func: f, class: "", superclass: "", interfaces: none, is_static: false, result: "", name: "", types: none, params: none, symbol: "" }, "@jni " + f.name + ": " + why);
}

// A parsed Java declaration "[static] result name(type, ...)". `ok` is
// false when it does not parse.
struct JavaDecl { ok: boolean, is_static: boolean, result: string, name: string, types: string[] }

function java_decl(class: string, decl: string): JavaDecl {
  let none: string[] = [];
  let bad = JavaDecl { ok: false, is_static: false, result: "", name: "", types: none };
  let d = decl.trim();
  let is_static = d.starts_with("static ");
  if (is_static) {
    d = slice_unchecked(d, 7, d.len()).trim();
  }
  let open = char_at(d, b'(');
  if (open < 0 || d[d.len() - 1] != b')') {
    return bad;
  }
  let head = slice_unchecked(d, 0, open).trim().split(" ");
  if (head.len() != 2 || !jni_name_ok(class) || !jni_name_ok(head[1])) {
    return bad;
  }
  let types: string[] = [];
  let inner = slice_unchecked(d, open + 1, d.len() - 1).trim();
  if (inner.len() > 0) {
    for part in inner.split(",") {
      types = types.append(part.trim().split(" ")[0]);
    }
  }
  return JavaDecl { ok: true, is_static: is_static, result: head[0], name: head[1], types: types };
}

// Why the Fern signature of `f` does not fit the Java declaration `jd`, or "".
function jni_signature_refusal(f: parser.FuncDecl, jd: JavaDecl): string {
  if (f.params.len() != jd.types.len() + 2) {
    return "it takes the JNIEnv*, the jobject or jclass and " + util.i32_to_string(jd.types.len()) + " arguments, so it needs " + util.i32_to_string(jd.types.len() + 2) + " parameters (it has " + util.i32_to_string(f.params.len()) + ")";
  }
  if (f.params[0].type_name != "usize" || f.params[1].type_name != "usize") {
    return "the JNIEnv* and the jobject or jclass come first, each as usize";
  }
  for k in 0..jd.types.len() {
    let p = f.params[k + 2];
    if (p.type_name != jni_fern_type(jd.types[k])) {
      return "parameter " + p.name + " is " + p.type_name + ", but the Java " + jd.types[k] + " needs " + jni_fern_type(jd.types[k]);
    }
  }
  let ret = f.ret_type;
  if (ret == "void") {
    ret = "";
  }
  if (ret != jni_fern_type(jd.result)) {
    return "the result is " + f.ret_type + ", but the Java " + jd.result + " needs " + jni_fern_type(jd.result);
  }
  return "";
}

// The JNI method of `f`, or a refusal: the Java declaration must parse, and
// each Fern type must have the width of its Java type.
function jni_method(f: parser.FuncDecl, class_text: string, decl: string): (JniMethod, string) {
  let head = java_class_head(class_text);
  if (!head.ok) {
    return jni_bad(f, "the class \"" + class_text + "\" is not \"name [extends class] [implements interface, ...]\"");
  }
  let class = head.name;
  let jd = java_decl(class, decl);
  if (!jd.ok) {
    return jni_bad(f, "the declaration \"" + decl + "\" is not \"[static] result name(type, ...)\"");
  }
  let bad = jni_signature_refusal(f, jd);
  if (bad.len() > 0) {
    return jni_bad(f, bad);
  }
  let params: string[] = [];
  for k in 0..jd.types.len() {
    params = params.append(f.params[k + 2].name);
  }
  let symbol = "Java_" + jni_mangle(class) + "_" + jni_mangle(jd.name);
  return (JniMethod { func: f, class: class, superclass: head.superclass, interfaces: head.interfaces, is_static: jd.is_static, result: jd.result, name: jd.name, types: jd.types, params: params, symbol: symbol }, "");
}

// The module with its C imports and its JNI wrappers, and the JNI methods,
// or the first refusal of either.
function native_bindings(m: parser.Module, target: string, shared: boolean, java_dir: string): (parser.Module, JniMethod[], string) {
  let none: JniMethod[] = [];
  let callback_bad = callback_refusal(m);
  if (callback_bad.len() > 0) {
    return (m, none, callback_bad);
  }
  let import_bad = native_import_refusal(m, target);
  if (import_bad.len() > 0) {
    return (m, none, import_bad);
  }
  let imported = native_imports(m, target, shared);
  let (jni, jni_bad) = jni_build_methods(imported, target, shared, java_dir);
  if (jni_bad.len() > 0) {
    return (imported, jni, jni_bad);
  }
  return (jni_wrappers(imported, jni), jni, "");
}

// The JNI methods of a build, or a refusal: they need a native -shared
// build, and -jni-java needs at least one.
function jni_build_methods(m: parser.Module, target: string, shared: boolean, java_dir: string): (JniMethod[], string) {
  let (jni, bad) = jni_methods(m);
  if (bad.len() > 0) {
    return (jni, bad);
  }
  if (jni.len() > 0 && !(shared && is_native_target(target))) {
    return (jni, "@jni " + jni[0].func.name + ": a JNI method needs -shared and a native target");
  }
  if (java_dir.len() > 0 && jni.len() == 0) {
    return (jni, "-jni-java: the program has no @jni function");
  }
  return (jni, "");
}

// The JNI methods of the module, or the first refusal.
pub function jni_methods(m: parser.Module): (JniMethod[], string) {
  let out: JniMethod[] = [];
  let symbols: string[] = [];
  for b in m.exports {
    if (b.jni) {
      let k = export_func_index(m, b.func_name);
      if (k < 0) {
        let none: JniMethod[] = [];
        return (none, "@jni " + b.func_name + ": no such function");
      }
      let (jm, bad) = jni_method(m.funcs[k], b.iface, b.wit);
      if (bad.len() > 0) {
        let none: JniMethod[] = [];
        return (none, bad);
      }
      if (util.has_str(symbols, jm.symbol)) {
        let none: JniMethod[] = [];
        return (none, "@jni " + b.func_name + ": " + jm.class + "." + jm.name + " is bound twice, and JNI overloads are not supported");
      }
      symbols = symbols.append(jm.symbol);
      out = out.append(jm);
    }
  }
  return jni_unify_heads(out);
}

// The call of the Fern function of `jm`, with each Java argument extended.
function jni_call(jm: JniMethod): string {
  let f = jm.func;
  let args = f.params[0].name + ", " + f.params[1].name;
  for k in 0..jm.types.len() {
    args = args + ", " + jni_extend(jm.types[k], f.params[k + 2].name);
  }
  return f.name + "(" + args + ")";
}

// Each JNI method becomes a C-ABI export named by its JNI symbol, which
// calls the Fern function.
pub function jni_wrappers(m: parser.Module, methods: JniMethod[]): parser.Module {
  if (methods.len() == 0) {
    return m;
  }
  let src = "";
  for jm in methods {
    let f = jm.func;
    let decl = "";
    for p in f.params {
      if (decl.len() > 0) {
        decl += ", ";
      }
      decl = decl + p.name + ": " + p.type_name;
    }
    let call = jni_call(jm);
    if (f.ret_type.len() > 0 && f.ret_type != "void") {
      src = src + "pub function " + jm.symbol + "(" + decl + "): " + f.ret_type + " {\n  return " + jni_extend(jm.result, call) + ";\n}\n";
    } else {
      src = src + "pub function " + jm.symbol + "(" + decl + "): void {\n  " + call + ";\n}\n";
    }
  }
  let gen = parser.parse_module(lexer.tokenize(src));
  let funcs = m.funcs;
  let exports: parser.ExportBinding[] = [];
  for b in m.exports {
    if (!b.jni) {
      exports = exports.append(b);
    }
  }
  for i in 0..gen.funcs.len() {
    let g = gen.funcs[i];
    let f = methods[i].func;
    funcs = funcs.append(parser.FuncDecl { ...g, module: f.module, stdlib: f.stdlib, line: f.line, col: f.col });
  }
  return parser.Module { ...m, funcs: funcs, exports: exports };
}

// The native declaration of `jm` in its Java class.
function jni_java_method(jm: JniMethod): string {
  let args = "";
  for k in 0..jm.types.len() {
    if (k > 0) {
      args += ", ";
    }
    args = args + jm.types[k] + " " + jm.params[k];
  }
  let st = "";
  if (has_head(jm)) {
    st = "public ";
  }
  if (jm.is_static) {
    st += "static ";
  }
  return "    " + st + "native " + jm.result + " " + jm.name + "(" + args + ");\n";
}

// The header and the static block of `class`. A class with a head, such as
// "implements Runnable", is public. A class of static methods alone and no
// head is final, with a private constructor.
function jni_java_head(class: string, library: string, all_static: boolean, head: string): string {
  let dot: i32 = -1;
  for i in 0..class.len() {
    if (class[i] == b'.') {
      dot = i;
    }
  }
  let simple = slice_unchecked(class, dot + 1, class.len()).to_owned();
  let out = "// Generated by fern -jni-java from the @jni functions. Do not edit.\n";
  if (dot > 0) {
    out = out + "package " + slice_unchecked(class, 0, dot) + ";\n\n";
  }
  let mods = "";
  let ctor = "";
  if (head.len() > 0) {
    mods = "public ";
  } else if (all_static) {
    mods = "final ";
    ctor = "\n    private " + simple + "() {}\n";
  }
  return out + mods + "class " + simple + head + " {\n    static {\n        System.loadLibrary(\"" + library + "\");\n    }\n\n    // The state of the native library, for its callbacks.\n    public static long fern;\n" + ctor + "\n";
}

// The Java source of `class`: its JNI methods as native declarations, and
// the static block that loads `library`.
function jni_java_class(class: string, library: string, methods: JniMethod[]): string {
  let all_static = true;
  let body = "";
  let head = "";
  for jm in methods {
    if (jm.class == class) {
      all_static = all_static && jm.is_static;
      body += jni_java_method(jm);
      head = head_text(jm);
    }
  }
  return jni_java_head(class, library, all_static, head) + body + "}\n";
}

// The library name that System.loadLibrary takes for `out_path`, such as
// "fern" for "lib/arm64-v8a/libfern.so".
function jni_library(out_path: string): string {
  let base = slice_unchecked(out_path, util.last_slash(out_path) + 1, out_path.len()).to_owned();
  if (base.starts_with("lib")) {
    base = slice_unchecked(base, 3, base.len()).to_owned();
  }
  if (base.ends_with(".so")) {
    base = slice_unchecked(base, 0, base.len() - 3).to_owned();
  }
  return base;
}

// Writes one Java file for each class of `methods` under `dir`, when -jni-java
// names one.
function write_jni_java(dir: string, out_path: string, methods: JniMethod[]): string {
  if (dir.len() == 0) {
    return "";
  }
  let classes: string[] = [];
  for jm in methods {
    if (!util.has_str(classes, jm.class)) {
      classes = classes.append(jm.class);
    }
  }
  for class in classes {
    let path = dir + "/" + class.replace(".", "/") + ".java";
    let parent = slice_unchecked(path, 0, util.last_slash(path)).to_owned();
    match (create_dir_all(parent)) {
      Err(e) => {
        return "-jni-java: cannot make " + parent + ": " + e.message();
      },
      Ok(_) => {}
    }
    match (write_file(path, jni_java_class(class, jni_library(out_path), methods))) {
      Err(e) => {
        return "-jni-java: cannot write " + path + ": " + e.message();
      },
      Ok(_) => {}
    }
  }
  return "";
}

// The DEX classes of the JNI methods: one class for each @jni class, with
// java.lang.Object as the superclass when the head names none.
function jni_dex_classes(methods: JniMethod[]): dex.Class[] {
  let out: dex.Class[] = [];
  let names: string[] = [];
  for jm in methods {
    if (!util.has_str(names, jm.class)) {
      names = names.append(jm.class);
      let superclass = jm.superclass;
      if (superclass.len() == 0) {
        superclass = "java.lang.Object";
      }
      let ifaces: string[] = [];
      for i in jm.interfaces {
        ifaces = ifaces.append(dex.descriptor(i));
      }
      out = out.append(dex.Class { name: dex.descriptor(jm.class), superclass: dex.descriptor(superclass), interfaces: ifaces, methods: [] });
    }
    let k = util.index_of_str(names, jm.class);
    let params: string[] = [];
    for t in jm.types {
      params = params.append(dex.descriptor(t));
    }
    let m = dex.Method { name: jm.name, is_static: jm.is_static, ret: dex.descriptor(jm.result), params: params };
    out = out.with(k, dex.Class { ...out[k], methods: out[k].methods.append(m) });
  }
  return out;
}

// Writes the DEX file of the @jni classes to `path`, when -jni-dex names one
// and the program has a @jni class.
function write_jni_dex(path: string, out_path: string, methods: JniMethod[]): string {
  if (path.len() == 0 || methods.len() == 0) {
    return "";
  }
  match (write_file_bytes(path, dex.write(jni_dex_classes(methods), jni_library(out_path)))) {
    Err(e) => {
      return "-jni-dex: cannot write " + path + ": " + e.message();
    },
    Ok(_) => {
      return "";
    }
  }
}

// The Fern types with the width of a JNI type: usize for a reference or a
// JNIEnv*, and the scalars jbyte, jboolean, jshort, jchar, jint, jlong,
// jfloat and jdouble.
function jni_width(t: string): boolean {
  return util.has_str(["usize", "i8", "u8", "i16", "u16", "i32", "i64", "f32", "f64"], t);
}

// A JNI method named Java_* takes the JNIEnv* and a jobject or jclass, then
// its arguments. The JVM passes a 32-bit jint in a 64-bit register with
// undefined upper bits, so each type must have the width of its JNI type.
function jni_export_refusal(f: parser.FuncDecl): string {
  if (!f.name.starts_with("Java_")) {
    return "";
  }
  if (f.params.len() < 2 || f.params[0].type_name != "usize" || f.params[1].type_name != "usize") {
    return "a JNI method takes the JNIEnv* and a jobject or jclass first, each as usize";
  }
  for p in f.params {
    if (!jni_width(p.type_name)) {
      return "parameter " + p.name + " is " + p.type_name + ", which has no JNI type of its width; use usize for a reference, i32 for jint, i64 for jlong or u8 for jboolean";
    }
  }
  if (f.ret_type != "void" && f.ret_type != "" && !jni_width(f.ret_type)) {
    return "the result is " + f.ret_type + ", which has no JNI type of its width; use usize for a reference, i32 for jint, i64 for jlong or u8 for jboolean";
  }
  return "";
}

// The functions a freestanding build exports: -export, or main without it.
pub function freestanding_roots(merged: parser.Module, export_list: string): (parser.Module, string[], string) {
  return shared_exports(merged, true, export_list, []);
}

// A provider of a capability that the target does not grant is an entry. The
// runtime calls it, as an embedder calls an -export entry.
pub function provider_entries(m: parser.Module, target: string): parser.Module {
  for pv in parser.marked(m, "provide") {
    if (platforms.provider_used(target, pv.arg)) {
      m = parser.Module { ...m, exports: m.exports.append(parser.ExportBinding { func_name: pv.func_name, iface: "", wit: "", c_abi: true, method: false, jni: false }) };
    }
  }
  return m;
}

function shared_exports(merged: parser.Module, shared: boolean, export_list: string, jni: JniMethod[]): (parser.Module, string[], string) {
  let roots: string[] = [];
  if (!shared) {
    return (merged, roots, "");
  }
  roots = shared_export_names(export_list, jni);
  let bad = shared_export_refusal(merged, roots);
  if (bad.len() > 0) {
    return (merged, roots, bad);
  }
  for name in entry_names(merged, roots) {
    let f = merged.funcs[export_func_index(merged, name)];
    merged = parser.Module { ...merged, exports: merged.exports.append(parser.ExportBinding { func_name: f.name, iface: "", wit: "", c_abi: true, method: false, jni: false }) };
  }
  return (merged, roots, "");
}

function export_func_index(merged: parser.Module, name: string): i32 {
  for i in 0..merged.funcs.len() {
    let f = merged.funcs[i];
    if ((f.name == name || f.name == util.ENTRY_SHADOW_PREFIX + name) && f.receiver_name == "" && f.import_iface == "" && f.import_wit == "") {
      return i;
    }
  }
  return -1;
}

function export_entries(merged: parser.Module, names: string[], arm64: boolean, harden: boolean): string {
  let out = "";
  for n in names {
    let f = merged.funcs[export_func_index(merged, n)];
    let unshared = norc.marked(merged, f);
    if (arm64) {
      out += export_entry_arm64(f, n, harden, true, unshared);
    } else {
      out += export_entry(f, n, harden, true, unshared);
    }
  }
  return out;
}

// The export entries of a freestanding artifact. Each one is a global symbol
// with the name of its function, and no lock, because only one context calls
// in.
pub function freestanding_exports(merged: parser.Module, names: string[], arm64: boolean): string {
  let out = "";
  for n in names {
    let f = merged.funcs[export_func_index(merged, n)];
    if (arm64) {
      out += "    .globl " + n + "\n    .type " + n + ", %function\n" + n + ":\n" + export_entry_arm64(f, n, false, false, false);
    } else {
      out += "    .globl " + n + "\n    .type " + n + ", @function\n" + n + ":\n" + export_entry(f, n, false, false, false);
    }
  }
  return out;
}

// A locked entry takes the busy lock, because a shared object can be called
// from more than one thread. The entry of a `@norc` function is `unshared`:
// that function touches no heap, so the entry takes no lock and leaves the
// state of the thread that holds the heap alone.
function export_entry(f: parser.FuncDecl, name: string, harden: boolean, locked: boolean, unshared: boolean): string {
  let ints: string[] = ["%rdi", "%rsi", "%rdx", "%rcx", "%r8", "%r9"];
  let srcs: string[] = [];
  let ni = 0;
  let nf = 0;
  let stack = 16;
  for p in f.params {
    let fp = p.type_name == "f64" || p.type_name == "f32";
    if (fp && nf < 8) {
      srcs = srcs.append("%xmm" + util.i32_to_string(nf));
      nf += 1;
    } else if (!fp && ni < 6) {
      srcs = srcs.append(ints[ni]);
      ni += 1;
    } else {
      srcs = srcs.append(util.i32_to_string(stack) + "(%rbp)");
      stack += 8;
    }
  }
  let out = "__fern_export_" + name + ":\n" + text_when(harden, "    endbr64\n") + "    pushq %rbp\n    movq %rsp, %rbp\n    subq $16, %rsp\n" + text_when(!unshared, entry_open_x86(name, harden, locked));
  let i = f.params.len() - 1;
  while (i >= 0) {
    out = out + export_arg(srcs[i], f.params[i].type_name) + "    pushq %rax\n";
    i -= 1;
  }
  out = out + "    call __fn_" + f.name + "\n";
  if (f.ret_type == "f64") {
    out += "    movq %rax, %xmm0\n";
  } else if (f.ret_type == "f32") {
    out += "    movq %rax, %xmm0\n    cvtsd2ss %xmm0, %xmm0\n";
  }
  return out + text_when(!unshared, "    movq -8(%rbp), %rcx\n    movq %rcx, __fern_stack_top(%rip)\n" + text_when(locked, asm_ir.busy_give_x86())) + "    movq %rbp, %rsp\n    popq %rbp\n    ret\n";
}

// The part of an x86-64 entry for a function that uses the heap: the turn
// on the busy lock, the stack top of the thread, and the start of the
// hardened runtime.
function entry_open_x86(name: string, harden: boolean, locked: boolean): string {
  return text_when(locked, asm_ir.busy_take_x86()) + "    movq __fern_stack_top(%rip), %rax\n    movq %rax, -8(%rbp)\n    movq %rbp, __fern_stack_top(%rip)\n" + text_when(harden, "    cmpq $0, __fern_rng_state(%rip)\n    jne .Lfern_export_ready_" + name + "\n    call __fern_harden_start\n.Lfern_export_ready_" + name + ":\n");
}

function export_arg(src: string, t: string): string {
  if (t == "f32") {
    if (src.starts_with("%xmm")) {
      return "    cvtss2sd " + src + ", %xmm15\n    movq %xmm15, %rax\n";
    }
    return "    movl " + src + ", %eax\n    movd %eax, %xmm15\n    cvtss2sd %xmm15, %xmm15\n    movq %xmm15, %rax\n";
  }
  let load = "    movq " + src + ", %rax\n";
  if (t == "i32") {
    return load + "    movslq %eax, %rax\n";
  }
  if (t == "u32") {
    return load + "    movl %eax, %eax\n";
  }
  if (t == "u8" || t == "boolean") {
    return load + "    movzbl %al, %eax\n";
  }
  return load;
}

function export_entry_arm64(f: parser.FuncDecl, name: string, harden: boolean, locked: boolean, unshared: boolean): string {
  let srcs: string[] = [];
  let ni = 0;
  let nf = 0;
  let stack = 16;
  for p in f.params {
    let fp = p.type_name == "f64" || p.type_name == "f32";
    if (fp && nf < 8) {
      srcs = srcs.append(util.i32_to_string(nf));
      nf += 1;
    } else if (!fp && ni < 8) {
      srcs = srcs.append(util.i32_to_string(ni));
      ni += 1;
    } else {
      srcs = srcs.append("[x29, #" + util.i32_to_string(stack) + "]");
      stack += 8;
    }
  }
  let n = f.params.len();
  let out = "__fern_export_" + name + ":\n" + text_when(harden, "    bti c\n    paciasp\n") + "    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n" + entry_open_arm64(name, harden, locked, unshared);
  if (n > 0) {
    out = out + "    sub sp, sp, #" + util.i32_to_string(16 * n) + "\n";
  }
  for i in 0..n {
    out = out + export_arg_arm64(srcs[i], f.params[i].type_name) + "    str x16, [sp, #" + util.i32_to_string(16 * i) + "]\n";
  }
  out = out + "    bl __fn_" + f.name + "\n";
  if (f.ret_type == "f64") {
    out += "    fmov d0, x0\n";
  } else if (f.ret_type == "f32") {
    out += "    fmov d0, x0\n    fcvt s0, d0\n";
  }
  return out + text_when(!unshared, "    ldr x17, [x29, #-16]\n    adrp x16, __fern_stack_top\n    add x16, x16, :lo12:__fern_stack_top\n    str x17, [x16]\n" + text_when(locked, asm_arm64_ir.busy_give_arm64())) + "    mov sp, x29\n    ldp x29, x30, [sp], #16\n" + text_when(harden, "    autiasp\n") + "    ret\n";
}

// The part of an arm64 entry for a function that uses the heap: the turn on
// the busy lock, the stack top of the thread, and the start of the hardened
// runtime. The entry of a `@norc` function keeps only the slot of the stack
// top, so its frame has the same shape.
function entry_open_arm64(name: string, harden: boolean, locked: boolean, unshared: boolean): string {
  if (unshared) {
    return "    sub sp, sp, #16\n";
  }
  return text_when(locked, asm_arm64_ir.busy_take_arm64()) + "    adrp x16, __fern_stack_top\n    add x16, x16, :lo12:__fern_stack_top\n    ldr x17, [x16]\n    str x17, [sp, #-16]!\n    str x29, [x16]\n" + text_when(harden, "    adrp x16, __fern_rng_state\n    ldr x16, [x16, :lo12:__fern_rng_state]\n    cbnz x16, .Lfern_export_ready_" + name + "\n    bl __fern_harden_start\n.Lfern_export_ready_" + name + ":\n");
}

// `text` when `on`, else nothing.
function text_when(on: boolean, text: string): string {
  if (on) {
    return text;
  }
  return "";
}

function export_arg_arm64(src: string, t: string): string {
  if (src.starts_with("[")) {
    if (t == "f32") {
      return "    ldr s16, " + src + "\n    fcvt d16, s16\n    fmov x16, d16\n";
    }
    return "    ldr x16, " + src + "\n" + export_widen_arm64("x16", "w16", t);
  }
  if (t == "f64") {
    return "    fmov x16, d" + src + "\n";
  }
  if (t == "f32") {
    return "    fcvt d16, s" + src + "\n    fmov x16, d16\n";
  }
  return export_widen_arm64("x" + src, "w" + src, t);
}

function export_widen_arm64(x: string, w: string, t: string): string {
  if (t == "i32") {
    return "    sxtw x16, " + w + "\n";
  }
  if (t == "u32") {
    return "    mov w16, " + w + "\n";
  }
  if (t == "u8" || t == "boolean") {
    return "    and x16, " + x + ", #255\n";
  }
  if (x == "x16") {
    return "";
  }
  return "    mov x16, " + x + "\n";
}

function arm64_elf_shared(asm: string, words: u8[], names: string[], soname: string, target: string, merged: parser.Module, note: boolean): u8[] {
  let p = arm64_native.arm64_gas_program_words(asm, words, -1);
  if (p.unknown.len() > 0) {
    return elfimage.arm64_refusals(target, "assembler", p.unknown);
  }
  let text_len = p.asm.text.len();
  let tv = elf.elf_text_off_so(note);
  let hdr_len = arm64_native.arm64_eh_frame_hdr_len(p);
  let hv = elf.elf_eh_hdr_off_so(text_len, note);
  let ev = elf.elf_eh_frame_off_so(text_len, hdr_len, note);
  let eh = arm64_native.arm64_eh_frame(p, tv as i64, ev as i64);
  let hdr = arm64_native.arm64_eh_frame_hdr(p, tv as i64, ev as i64, hv as i64);
  let dv = elf.elf_data_off_so(text_len, hdr.len(), eh.len(), note);
  p = arm64_native.arm64_gas_link(p, tv as i64, dv as i64);
  if (p.unknown.len() > 0) {
    return elfimage.arm64_refusals(target, "linker", p.unknown);
  }
  let rel_offs: i32[] = [];
  let rel_adds: i64[] = [];
  for off in arm64_native.arm64_gas_rebase_offs(p) {
    rel_offs = rel_offs.append(dv + off);
    rel_adds = rel_adds.append(le64_at(p.data, off));
  }
  let pa = p.asm;
  let nosec: i32[] = [];
  let sym_names = elf.elf_func_sym_names(pa.lab_names, pa.lab_offs, nosec, -1, text_len);
  let sym_offs = elf.elf_func_sym_offs(pa.lab_names, pa.lab_offs, nosec, -1, text_len);
  let sym_sizes = elf.elf_func_sym_sizes(pa.lab_names, pa.lab_offs, nosec, -1, text_len);
  let vals: i32[] = [];
  let sizes: i32[] = [];
  for n in names {
    let k = util.index_of_str(sym_names, "__fern_export_" + n);
    vals = vals.append(tv + sym_offs[k]);
    sizes = sizes.append(sym_sizes[k]);
  }
  let imp = so_imports(merged);
  let slots: i32[] = [];
  for stub in import_stub_names(merged) {
    slots = slots.append(arm64_native.arm64_symbol_addr(p, got_label(stub), tv as i64, dv as i64) as i32);
  }
  imp = elf.SoImports { ...imp, slots: slots };
  let env_slot = arm64_native.arm64_symbol_addr(p, "__fern_environ_slot", tv as i64, dv as i64);
  if (env_slot >= 0i64) {
    imp = shared_environ_import(imp, env_slot as i32, target);
  }
  let init_at = arm64_native.arm64_symbol_addr(p, "__fern_init_array", tv as i64, dv as i64) as i32;
  let so = elf.elf_shared(elf.elf_em_aarch64(), elf.elf_cat_u8([], pa.text), hdr, eh, p.data, dv, p.bss_size, rel_offs, rel_adds, names, vals, sizes, soname, imp, note, init_at);
  return util.to_u8(so);
}

function x86_elf_shared(asm: string, words: u8[], names: string[], soname: string, target: string, merged: parser.Module): u8[] {
  let a = x86_native.x86_gas_assemble_words_unlinked(asm, words);
  let tv = elf.elf_text_off_so(false);
  let hdr_len = x86_native.x86_eh_frame_hdr_len(a);
  let hv = elf.elf_eh_hdr_off_so(a.text.len(), false);
  let ev = elf.elf_eh_frame_off_so(a.text.len(), hdr_len, false);
  let eh = x86_native.x86_eh_frame(a, tv as i64, ev as i64);
  let hdr = x86_native.x86_eh_frame_hdr(a, tv as i64, ev as i64, hv as i64);
  let data_at = elf.elf_data_off_so(a.text.len(), hdr.len(), eh.len(), false);
  a = x86_native.x86_link(a, tv, data_at);
  if (a.afix_offs.len() > 0 && a.unknown.len() == 0) {
    a = x86_native.X86Asm { ...a, unknown: ["an absolute code address in a shared object: " + a.afix_names[0]] };
  }
  if (a.unknown.len() > 0) {
    eprint("fern: -target x86-64-linux: in-process assembler could not encode: " + a.unknown[0]);
    return [];
  }
  let rel_offs: i32[] = [];
  let rel_adds: i64[] = [];
  for off in a.dfix_offs {
    rel_offs = rel_offs.append(data_at + off);
    rel_adds = rel_adds.append(le64_at(a.rodata, off));
  }
  let end = x86_native.x86_code_len(a);
  let sym_names = elf.elf_func_sym_names(a.lab_names, a.lab_offs, a.lab_secs, 0, end);
  let sym_offs = elf.elf_func_sym_offs(a.lab_names, a.lab_offs, a.lab_secs, 0, end);
  let sym_sizes = elf.elf_func_sym_sizes(a.lab_names, a.lab_offs, a.lab_secs, 0, end);
  let vals: i32[] = [];
  let sizes: i32[] = [];
  for n in names {
    let k = util.index_of_str(sym_names, "__fern_export_" + n);
    vals = vals.append(tv + sym_offs[k]);
    sizes = sizes.append(sym_sizes[k]);
  }
  let imp = so_imports(merged);
  let slots: i32[] = [];
  let base = x86_native.x86_data_base(a, a.text.len());
  for stub in import_stub_names(merged) {
    slots = slots.append(data_at + x86_native.x86_symbol_addr(a, got_label(stub), 0) - base);
  }
  imp = elf.SoImports { ...imp, slots: slots };
  let env_slot = x86_native.x86_symbol_addr(a, "__fern_environ_slot", 0);
  if (env_slot >= 0) {
    imp = shared_environ_import(imp, data_at + env_slot - base, target);
  }
  let init_at = x86_native.x86_symbol_addr(a, "__fern_init_array", 0);
  if (init_at >= 0) {
    init_at = data_at + init_at - base;
  }
  let so = elf.elf_shared(elf.elf_em_x86_64(), elf.elf_cat_u8([], a.text), hdr, eh, a.rodata, data_at, a.bss_size, rel_offs, rel_adds, names, vals, sizes, soname, imp, false, init_at);
  return util.to_u8(so);
}

function le64_at(b: i32[], off: i32): i64 {
  let v: i64 = 0;
  let j = 7;
  while (j >= 0) {
    v = v << 8 as i64 | b[off + j] as i64;
    j -= 1;
  }
  return v;
}

struct ImportQueue { paths: string[], dirs: string[], lines: i32[], cols: i32[], stdlibs: boolean[], unrooted: string, display_queued: boolean }

function queued(paths: string[], dirs: string[], ip: string, from_dir: string): boolean {
  for i in 0..paths.len() {
    if (paths[i] == ip && dirs[i] == from_dir) {
      return true;
    }
  }
  return false;
}

function queue_display(q: ImportQueue, mod: parser.Module, from_dir: string, root: string): ImportQueue {
  if (root.len() == 0 || q.display_queued || !modloader.needs_primitive_display(mod)) {
    return q;
  }
  return ImportQueue {
    ...q,
    paths: q.paths.append("core/primitive_text"),
    dirs: q.dirs.append(from_dir),
    lines: q.lines.append(0),
    cols: q.cols.append(0),
    stdlibs: q.stdlibs.append(true),
    display_queued: true,
  };
}

function queue_imports(q: ImportQueue, mod: parser.Module, from_dir: string, root: string, deps: string[], parent_stdlib: boolean): ImportQueue {
  let paths = q.paths;
  let dirs = q.dirs;
  let lines = q.lines;
  let cols = q.cols;
  let stdlibs = q.stdlibs;
  let unrooted = q.unrooted;
  let display_queued = q.display_queued;
  for i in 0..mod.imports.len() {
    let ip = mod.imports[i].path;
    if (ip == "core/primitive_text" || ip == "core/primitive_text.fern") {
      display_queued = true;
    }
    if (root.len() == 0 && unrooted.len() == 0 && util.is_stdlib_path(ip) && !util.should_load(ip, root, deps)) {
      unrooted = ip;
    }
    if (util.should_load(ip, root, deps) && !queued(paths, dirs, ip, from_dir)) {
      paths = paths.append(ip);
      dirs = dirs.append(from_dir + "");
      lines = lines.append(mod.imports[i].line);
      cols = cols.append(mod.imports[i].col);
      stdlibs = stdlibs.append(util.is_stdlib_path(ip) || parent_stdlib && !util.has_str(deps, util.dep_name(ip)));
    }
  }
  return queue_display(ImportQueue { paths: paths, dirs: dirs, lines: lines, cols: cols, stdlibs: stdlibs, unrooted: unrooted, display_queued: display_queued }, mod, from_dir, root);
}

function is_flag(a: string): boolean {
  if (a.len() < 2) {
    return false;
  }
  return a[0] == b'-';
}

// A target with no host: its artifact is assembly that an embedder links and
// calls through the -export functions.
pub function is_freestanding(t: string): boolean {
  return platforms.for_target(t).environment == "freestanding";
}

// A target with no host under the program: freestanding or a kernel image.
function is_hostless(t: string): boolean {
  return platforms.for_target(t).capabilities.len() == 0 && platforms.for_target(t).known;
}

// The targets with a native backend and a binary image.
function is_native_target(t: string): boolean {
  return t == "x86-64-linux" || t == "arm64-linux" || t == "x86-64-android" || t == "arm64-android" || t == "arm64-darwin";
}

function sanitize_warning(target: string): string {
  if (is_native_target(target)) {
    return "";
  }
  let census = "the leak census only, not the rc over-release or use-after-free detectors";
  if (target == "wasm32-wasi") {
    return "fern: warning: -sanitize on -target " + target + " carries " + census;
  }
  if (target == "wasm32-wasi-http") {
    return "fern: warning: -sanitize on -target " + target + " carries " + census + " — and it prints at process exit, which a request handler never reaches";
  }
  return "fern: warning: -sanitize has no effect on -target " + target + " (the detectors are native x86-64 and arm64, the leak census also wasm); this build carries no checks";
}

function dw_file_table(entry: string, files: string[], remaps: PathRemap[]): string {
  let o = "    .file 1 \"" + remap_path(remaps, entry) + "\"\n";
  for k in 0..files.len() {
    o = o + "    .file " + util.i32_to_string(k + 2) + " \"" + remap_path(remaps, files[k]) + "\"\n";
  }
  return o;
}

// One -remap-path-prefix FROM=TO pair, FROM without a trailing slash.
struct PathRemap { from: string, to: string }

// The -remap-path-prefix pairs, and false after a refusal for a malformed one.
function path_remaps(specs: string[]): (PathRemap[], boolean) {
  let out: PathRemap[] = [];
  for spec in specs {
    let eq = util.index_of_sub(spec, "=");
    if (eq <= 0) {
      eprint("fern: -remap-path-prefix takes FROM=TO with a non-empty FROM (got \"" + spec + "\")");
      return (out, false);
    }
    let from = slice_unchecked(spec, 0, eq).to_owned();
    while (from.len() > 1 && from.ends_with("/")) {
      from = slice_unchecked(from, 0, from.len() - 1).to_owned();
    }
    out = out.append(PathRemap { from: from, to: slice_unchecked(spec, eq + 1, spec.len()).to_owned() });
  }
  return (out, true);
}

// The path with the prefix of the last matching remap replaced. A FROM
// matches whole path components only, so /a does not match /ab.
function remap_path(remaps: PathRemap[], path: string): string {
  let k = remaps.len() - 1;
  while (k >= 0) {
    let from = remaps[k].from;
    let to = remaps[k].to;
    if (path == from) {
      return to;
    }
    let dir = from;
    if (!from.ends_with("/")) {
      dir = from + "/";
    }
    if (path.starts_with(dir)) {
      let rest = slice_unchecked(path, dir.len(), path.len()).to_owned();
      if (to.len() == 0) {
        return rest;
      }
      if (to.ends_with("/")) {
        return to + rest;
      }
      return to + "/" + rest;
    }
    k -= 1;
  }
  return path;
}

function harden_refused(harden: boolean, target: string): boolean {
  if (!harden || target == "arm64-linux" || target == "x86-64-linux" || asmcore.is_android(target)) {
    return false;
  }
  eprint("fern: -harden is only supported for -target arm64-linux, x86-64-linux, arm64-android and x86-64-android (got \"" + target + "\")");
  return true;
}

// The -harden, -pie, -heap-limit and -quarantine refusals as one answer; the
// two size values are below zero after their own refusal.
function switches_refused(harden: boolean, pie: boolean, target: string, shared: boolean, heap_limit: i64, quarantine: i64, cpu_limit: i64): boolean {
  return harden_refused(harden, target) || pie_refused(pie, target, shared) || heap_limit < 0i64 || quarantine < 0i64 || cpu_limit < 0i64;
}

// An Android executable is position independent with or without the flag.
function pie_refused(pie: boolean, target: string, shared: boolean): boolean {
  if (!pie || (target == "arm64-linux" || target == "x86-64-linux" || asmcore.is_android(target)) && !shared) {
    return false;
  }
  let with = "";
  if (shared) {
    with = " with -shared";
  }
  eprint("fern: -pie is only supported for -target arm64-linux, x86-64-linux, arm64-android and x86-64-android executables (got \"" + target + "\"" + with + ")");
  return true;
}

// The -cpu-limit value in seconds: zero without the flag, below zero after a
// refusal. Only the Linux kernel of a process target takes the limit at startup.
function cpu_limit_seconds(text: string, target: string): i64 {
  if (text.len() == 0) {
    return 0i64;
  }
  if (!util.has_str(["x86-64-linux", "arm64-linux", "x86-64-android", "arm64-android"], target)) {
    eprint("fern: -cpu-limit is only supported for the Linux and Android targets (got \"" + target + "\")");
    return 0i64 - 1i64;
  }
  let value = 0i64;
  for b in text.bytes() {
    if (b < b'0' || b > b'9' || value > 99999999i64) {
      value = 0i64 - 1i64;
      break;
    }
    value = value * 10i64 + (b - b'0') as i64;
  }
  if (value < 1i64 || value > 31536000i64) {
    eprint("fern: -cpu-limit takes a number of seconds from 1 to 31536000 (got \"" + text + "\")");
    return 0i64 - 1i64;
  }
  return value;
}

// The -heap-limit value in bytes: zero without the flag, below zero after a refusal.
function heap_limit_bytes(text: string, target: string): i64 {
  if (text.len() == 0) {
    return 0i64;
  }
  if (!is_native_target(target)) {
    eprint("fern: -heap-limit is only supported for the native targets (got \"" + target + "\")");
    return 0i64 - 1i64;
  }
  let value = size_bytes(text);
  if (value < 1048576i64 || value > 17179869184i64) {
    eprint("fern: -heap-limit takes a size from 1M to 16G, as digits with an optional K, M or G suffix (got \"" + text + "\")");
    return 0i64 - 1i64;
  }
  return value;
}

// The -ram layout of a kernel image: its base and its size in bytes. The base
// is a multiple of 64K, the end is in the 40-bit physical address space, and
// the size holds the 1M stack and some heap.
function ram_layout(text: string, target: string): (i64, i64, boolean) {
  let kernel = platforms.entry_shape(target) == "reset";
  if (text.len() == 0) {
    if (kernel) {
      eprint("fern: -target " + target + " needs -ram BASE,SIZE, the RAM that the loader puts the image in");
    }
    return (0i64, 0i64, !kernel);
  }
  if (!kernel) {
    eprint("fern: -ram is only for a kernel target such as arm64-kernel (got \"" + target + "\")");
    return (0i64, 0i64, false);
  }
  let parts = text.split(",");
  let base = -1i64;
  let size = -1i64;
  if (parts.len() == 2) {
    base = ram_number(parts[0]);
    size = ram_number(parts[1]);
  }
  let limit = ram_limit(target);
  if (base < 0i64 || base > limit || size < 4194304i64 || base % 65536i64 != 0i64 || size % 4096i64 != 0i64 || size > limit - base) {
    eprint("fern: -ram takes BASE,SIZE: a BASE that is a multiple of 64K, a SIZE of at least 4M that is a multiple of 4K, and an end at or below " + ram_limit_text(target) + " (got \"" + text + "\")");
    return (0i64, 0i64, false);
  }
  return (base, size, true);
}

// The end of the RAM a kernel image can use. An arm64 image has the 40-bit
// physical address space. An x86-64 image starts in 32-bit protected mode, and
// its linker keeps 32-bit addresses.
function ram_limit(target: string): i64 {
  if (platforms.target_isa(target) == "x86-64") {
    return 2147483648i64;
  }
  return 1099511627776i64;
}

function ram_limit_text(target: string): string {
  if (platforms.target_isa(target) == "x86-64") {
    return "2G";
  }
  return "1T";
}

// A decimal or 0x hex number with an optional K, M or G suffix, or -1.
function ram_number(text: string): i64 {
  if (!text.starts_with("0x")) {
    let v = size_bytes(text);
    if (v <= 0i64 && text != "0") {
      return -1i64;
    }
    return v;
  }
  let v = 0i64;
  for i in 2..text.len() {
    let d = util.hex_value(text[i]);
    if (d < 0 || v > 1099511627776i64) {
      return -1i64;
    }
    v = v * 16i64 + d as i64;
  }
  if (text.len() == 2) {
    return -1i64;
  }
  return v;
}

// The -quarantine value in bytes: the default without the flag, zero for an
// unbounded quarantine, below zero after a refusal.
function quarantine_bytes(text: string, sanitize: boolean): i64 {
  if (text.len() == 0) {
    return asmcore.quarantine_default();
  }
  if (!sanitize) {
    eprint("fern: -quarantine is the -sanitize quarantine budget and needs -sanitize");
    return 0i64 - 1i64;
  }
  if (text == "0") {
    return 0i64;
  }
  let value = size_bytes(text);
  if (value < 1048576i64 || value > 17179869184i64) {
    eprint("fern: -quarantine takes 0 for no bound, or a size from 1M to 16G as digits with an optional K, M or G suffix (got \"" + text + "\")");
    return 0i64 - 1i64;
  }
  return value;
}

// Digits with an optional K, M or G suffix, as bytes. Malformed text, and a
// value that does not fit in an i64, is zero.
function size_bytes(text: string): i64 {
  let n = text.len();
  if (n == 0) {
    return 0i64;
  }
  let scale: i64 = 1i64;
  let last = text[n - 1];
  if (last == b'K') {
    scale = 1024i64;
    n -= 1;
  } else if (last == b'M') {
    scale = 1048576i64;
    n -= 1;
  } else if (last == b'G') {
    scale = 1073741824i64;
    n -= 1;
  }
  let limit = 9223372036854775807i64 / scale;
  let value: i64 = 0i64;
  for i in 0..n {
    let d = text[i] as i32 - 48;
    if (d < 0 || d > 9 || value > (limit - d as i64) / 10i64) {
      return 0i64;
    }
    value = value * 10i64 + d as i64;
  }
  return value * scale;
}

function bti_property_text(on: boolean): string {
  if (!on) {
    return "";
  }
  return "    .section .note.gnu.property,\"a\"\n    .p2align 3\n    .word 4\n    .word 16\n    .word 5\n    .asciz \"GNU\"\n    .word 0xc0000000\n    .word 4\n    .word 1\n    .word 0\n    .text\n";
}

function flag_after_entry(a: string, embedded: boolean): i32 {
  eprint("fern: " + a + " comes after the source file, where driver flags are no longer parsed");
  eprint("  a driver flag goes before FILE; an argument for the program goes after a `--` separator:");
  eprint("    fern FILE.fern" + unless_embedded(embedded, " STDLIB") + " -- " + a);
  return 2;
}

function unless_embedded(embedded: boolean, text: string): string {
  if (embedded) {
    return "";
  }
  return text;
}

// A `mode` flag selects what fern does, so a command takes at most one. A
// flag with `needs` takes effect only beside one of the flags it names.
// `needs` holds the flags that one of must be given with this one, and
// `not_with` the flags that cannot be.
struct CliFlag { name: string, also: string[], value: string, help: string, mode: boolean, needs: string[], not_with: string[] }

struct FlagGroup { title: string, flags: CliFlag[] }

function cli_flag(name: string, value: string, help: string): CliFlag {
  let none: string[] = [];
  return CliFlag { name: name, also: none, value: value, help: help, mode: false, needs: none, not_with: none };
}

function mode_flag(name: string, value: string, help: string): CliFlag {
  return CliFlag { ...cli_flag(name, value, help), mode: true };
}

function sub_flag(name: string, value: string, needs: string[], help: string): CliFlag {
  return CliFlag { ...cli_flag(name, value, help), needs: needs };
}

function flag_groups(): FlagGroup[] {
  return [
    FlagGroup { title: "compile", flags: [
      cli_flag("-target", "ISA-ENV", "the target to build for (default: the host of the compiler); -targets lists them"),
      cli_flag("-o", "OUT", "write the output to OUT; without it a native target prints its assembly"),
      cli_flag("-emit", "FORM", "output form instead of the target's default: asm, core-module, command-module, or image (an arm64 Linux Image of an arm64-kernel image, which a loader puts 2M above the start of its RAM, so BASE of -ram is that start plus 2M)"),
      cli_flag("-backend", "NAME", "name the target's emitter: ssa on the native ISAs, flat on wasm"),
      cli_flag("-stdlib", "DIR", "compile against the standard library in DIR, not the one that this binary embeds"),
      cli_flag("-embed", "DIR", "the asset directory __fern_asset, __fern_asset_bytes, __fern_assets and __fern_assets_bytes read"),
      cli_flag("-O", "", "release build: elide every assert() check"),
      cli_flag("-shared", "", "a shared object exporting the -export functions, not an executable"),
      cli_flag("-export", "NAMES", "with -shared or a freestanding -target: the comma-separated functions to export, besides the @jni ones (default main)"),
      sub_flag("-jni-java", "DIR", ["-shared"], "with -shared: write the Java class of each @jni class under DIR, with its native methods and System.loadLibrary"),
      sub_flag("-jni-dex", "FILE", ["-shared"], "with -shared: write the @jni classes to the DEX file FILE, with native methods, a public constructor and System.loadLibrary; nothing is written when there is no @jni class"),
      mode_flag("-apk", "OUT", "build FILE for arm64-android and x86-64-android, and write a signed NativeActivity APK to OUT; the [android] table of the fern.toml of FILE gives the -apk- settings that no flag gives"),
      sub_flag("-apk-package", "NAME", ["-apk"], "with -apk: the Android package name (default dev.fern.LIB, where FILE is LIB.fern)"),
      sub_flag("-apk-label", "TEXT", ["-apk"], "with -apk: the name of the app on the launcher (default LIB)"),
      sub_flag("-apk-permission", "NAMES", ["-apk"], "with -apk: the comma-separated permissions the app uses, such as RECORD_AUDIO; a name with no dot is in android.permission; each FOREGROUND_SERVICE_TYPE permission, such as FOREGROUND_SERVICE_MICROPHONE, gives that foreground service type to each @jni class that extends android.app.Service"),
      sub_flag("-apk-icon", "FILE", ["-apk"], "with -apk: the PNG of the launcher icon (default: the icon of the system)"),
      sub_flag("-apk-min-sdk", "LEVEL", ["-apk"], "with -apk: the lowest Android API level the app runs on (default 24)"),
      sub_flag("-apk-compress", "", ["-apk"], "with -apk: deflate the libraries, so the APK is smaller, and Android extracts them at install (default: store them, so Android maps them from the APK)"),
      sub_flag("-apk-cleartext", "", ["-apk"], "with -apk: let the app's Java networking, such as the media player, use http:// with no TLS (android:usesCleartextTraffic); the Fern sockets of the app do not need it"),
      sub_flag("-apk-debuggable", "", ["-apk"], "with -apk: mark the app debuggable (android:debuggable), so adb run-as can read its files; do not ship such an APK"),
      sub_flag("-apk-key", "FILE", ["-apk"], "with -apk: the P-256 signing key, a PEM file; a new key is written there when FILE does not exist (default OUT with .key.pem for .apk)"),
      sub_flag("-apk-home", "", ["-apk"], "with -apk: make the app a home screen: Android offers it as the home app, keeps one task of it, and shows the wallpaper behind it"),
      sub_flag("-apk-widget", "ITEMS", ["-apk"], "with -apk: the comma-separated items of the row of the app widget of the home screen, each text:NAME:LABEL or button:NAME:LABEL; the app has one @jni class that extends android.appwidget.AppWidgetProvider"),
      sub_flag("-apk-run", "", ["-apk"], "with -apk: install the APK with adb on the device that adb sees, start it, and show the log lines of its process until it stops; the APK holds the library of the ABI of that device only"),
      sub_flag("-apk-asset", "FILES", ["-apk"], "with -apk: the comma-separated files to put under assets/ in the APK, each with its own file name, for AAssetManager"),
      cli_flag("-harden", "", "Linux and Android executables and shared objects: stack canaries, a check on every indirect call, a random pick among a free list's first eight blocks behind encoded links, and a guard page after every 64th large block; on arm64 also BTI landing pads and signed return addresses, on an x86-64 executable the shadow stack where the kernel offers it"),
      cli_flag("-pie", "", "x86-64-linux and arm64-linux executables: a position-independent image, loaded at a random base"),
      cli_flag("-ram", "BASE,SIZE", "arm64-kernel and x86-64-kernel: the RAM that the loader puts the image in; the image starts at BASE, and the stack top is BASE + SIZE; each number is decimal or 0x hex, with an optional K, M or G suffix"),
      cli_flag("-cpu-limit", "SECONDS", "Linux and Android executables: the processor time of the process, 1 to 31536000 seconds; the kernel stops a process that passes it"),
      cli_flag("-heap-limit", "SIZE", "native executables: the heap arena size, 1M to 16G with a K, M or G suffix (default 16G); a full arena exits 125"),
      cli_flag("-quarantine", "SIZE", "with -sanitize: the byte budget of released blocks held before reuse, 1M to 16G with a K, M or G suffix, or 0 for no bound (default 64M)"),
      cli_flag("-profile", "NAME", "a flag set: safe (the defaults), hardened (-harden -pie), diagnostic (-sanitize -backtrace -g) or minimal (-size)"),
    ] },
    FlagGroup { title: "run", flags: [
      mode_flag("-run", "", "build to a temporary binary (or -o) and run it with the program's arguments"),
      sub_flag("-qemu", "EMULATOR", ["-run"], "with -run: the emulator for a foreign ISA (default qemu-aarch64)"),
      mode_flag("-interp", "", "run FILE (or - for stdin) through the interpreter, building nothing"),
      mode_flag("-repl", "", "an interactive interpreter session"),
    ] },
    FlagGroup { title: "check", flags: [
      mode_flag("-check", "", "type-check FILE, - for stdin, or the package or workspace under DIR"),
      mode_flag("-capabilities", "", "the capabilities each package of the program reaches"),
      mode_flag("-effects", "", "the effect row of every function"),
      mode_flag("-array-report", "", "the array decisions compiling FILE makes, on stdout, writing no output (also FERN_ARRAY_REPORT=1 on stderr)"),
      mode_flag("-targets", "", "list the supported targets and what each provides"),
      mode_flag("-manifest", "", "print the build manifest stamped into the native image FILE: its target, profile and flags"),
    ] },
    FlagGroup { title: "fmt", flags: [
      mode_flag("-fmt", "", "print each FILE formatted: - for stdin, a DIR for every source beneath it (-o OUT takes one FILE)"),
      sub_flag("-w", "", ["-fmt"], "with -fmt: overwrite each file"),
      CliFlag { ...sub_flag("-d", "", ["-fmt"], "with -fmt: print unified diffs, exiting 1 when any file differs and 2 when one cannot be read or parsed"), not_with: ["-w"] },
    ] },
    FlagGroup { title: "lint", flags: [
      mode_flag("-lint", "", "lint each PATH: a .fern or .fern.md file, a directory of them, or - for stdin"),
      mode_flag("-lint-rules", "", "list the lint rules with their severities and options"),
      sub_flag("-lint-set", "RULE=LEVEL", ["-lint"], "with -lint: set a rule to allow, warn or deny (repeatable)"),
      sub_flag("-lint-opt", "RULE.OPT=VALUE", ["-lint"], "with -lint: set a rule option (repeatable)"),
      sub_flag("-lint-cover", "FILE", ["-lint"], "with -lint: score change-risk from FILE, a saved -cover run's stderr"),
    ] },
    FlagGroup { title: "doc", flags: [
      mode_flag("-doc", "", "a module's Markdown reference page, or with -o OUTDIR one per module under DIR"),
      sub_flag("-doc-source", "TEMPLATE", ["-doc"], "with -doc: link each declaration to its source, TEMPLATE with {path} and {line} in it"),
      mode_flag("-tangle", "", "the Fern source a literate DOC.fern.md tangles to"),
      sub_flag("-chunk", "NAME", ["-tangle"], "with -tangle: only the named chunk"),
      mode_flag("-weave", "", "the woven Markdown of a literate DOC.fern.md"),
      sub_flag("-html", "", ["-weave"], "with -weave: an HTML page instead of Markdown"),
      mode_flag("-doctest", "", "run a literate DOC.fern.md's test examples, reporting TAP"),
    ] },
    FlagGroup { title: "lsp", flags: [
      mode_flag("-lsp", "", "the language server on stdin and stdout"),
    ] },
    FlagGroup { title: "packages", flags: [
      mode_flag("-add", "", "declare a dependency in fern.toml (SPEC is path:DIR, url:URL, workspace or version:X.Y.Z)"),
      sub_flag("-grant", "CAPS", ["-add"], "with -add: the comma-separated capabilities the dependency may reach, or none"),
      mode_flag("-resolve", "", "run MVS over the manifest's index and write fern.lock"),
      mode_flag("-sign-index", "", "write INDEX.sig, the ed25519 signature over the package index INDEX, and print its index_key line"),
      sub_flag("-key", "FILE", ["-sign-index"], "with -sign-index: the ed25519 private key in PKCS#8 PEM, as `openssl genpkey -algorithm ed25519` writes it"),
      mode_flag("-index-keygen", "", "write a new ed25519 private key to the new file KEY with mode 0600, and print its index_key line"),
      mode_flag("-vendor", "", "flatten the dependency graph into vendor/"),
      mode_flag("-fetch", "", "download the url dependencies into the package store"),
    ] },
    FlagGroup { title: "diagnostics", flags: [
      cli_flag("-color", "MODE", "colour diagnostics: auto (the default), always or never"),
      cli_flag("-ascii", "", "draw the diagnostic gutter with | rather than box drawing"),
      CliFlag { ...cli_flag("-q", "", "one plain line per diagnostic (also FERN_DIAG_FORMAT=terse)"), not_with: ["-diag-format"] },
      cli_flag("-diag-format", "FORMAT", "print diagnostics as full (the default), terse or json (also FERN_DIAG_FORMAT)"),
      mode_flag("-explain", "[CODE]", "explain an error code, or list the codes"),
      mode_flag("-version", "", "the commit this binary was built from"),
      CliFlag { ...cli_flag("-h", "", "print this help"), also: ["-help"] },
    ] },
    FlagGroup { title: "debug, size and sanitizers", flags: [
      cli_flag("-g", "", "a symbol table and DWARF for debuggers and profilers"),
      cli_flag("-remap-path-prefix", "FROM=TO", "with -g: write TO for the FROM prefix of each source path and the compile directory; repeatable, the last match wins"),
      cli_flag("-backtrace", "", "walk the frames under a fatal abort's cause line (default FERN_BACKTRACE)"),
      cli_flag("-size", "", "build for size over speed (default FERN_SIZE)"),
      cli_flag("-sanitize", "", "the heap memory-safety detectors (also FERN_SANITIZE=1)"),
      cli_flag("-cover", "", "count line and branch hits, reported to stderr at exit (also FERN_COVER=1)"),
      mode_flag("-cover-report", "", "summarise a saved -cover run's stderr (FILE, or - for stdin)"),
      sub_flag("-lcov", "", ["-cover-report"], "with -cover-report: an lcov tracefile instead of the summary"),
    ] },
  ];
}

function flag_spelling(f: CliFlag): string {
  let s = f.name;
  for a in f.also {
    s = s + ", " + a;
  }
  if (f.value.len() == 0) {
    return s;
  }
  return s + " " + f.value;
}

struct CliArg { name: string, value: string, on: boolean, last: i32, err: string }

function find_flag(name: string): CliFlag {
  for g in flag_groups() {
    for f in g.flags {
      if (f.name == name || util.has_str(f.also, name)) {
        return f;
      }
    }
  }
  return cli_flag("", "", "");
}

// ": the nearest flag is -x" for a spelling near a flag, or "".
function nearest_flag(given: string): string {
  let names: string[] = [];
  for g in flag_groups() {
    for f in g.flags {
      names = names.append(f.name);
    }
  }
  let near = util.suggest(given, names);
  if (near.len() == 0) {
    return "";
  }
  return ": the nearest flag is " + near;
}

function read_flag(av: string[], i: i32): CliArg {
  let a = av[i];
  let body = slice_unchecked(a, 1, a.len()).to_owned();
  if (body.starts_with("-")) {
    body = slice_unchecked(body, 1, body.len()).to_owned();
  }
  let eq = util.index_of_sub(body, "=");
  let given = "";
  if (eq >= 0) {
    given = slice_unchecked(body, eq + 1, body.len()).to_owned();
    body = slice_unchecked(body, 0, eq).to_owned();
  }
  let f = find_flag("-" + body);
  let arg = CliArg { name: f.name, value: "", on: true, last: i, err: "" };
  if (f.name.len() == 0) {
    return CliArg { ...arg, err: "unknown flag: " + a + nearest_flag("-" + body) };
  }
  if (f.value.len() == 0) {
    return read_bool(arg, eq >= 0, given);
  }
  let optional = f.value.starts_with("[");
  if (eq >= 0) {
    if (given.len() == 0 && !optional) {
      return CliArg { ...arg, err: f.name + "= has no value: write " + f.name + " " + f.value + " or " + f.name + "=" + f.value };
    }
    return CliArg { ...arg, value: given };
  }
  if (i + 1 < av.len() && !(optional && is_flag(av[i + 1]))) {
    return CliArg { ...arg, value: av[i + 1], last: i + 1 };
  }
  if (optional) {
    return arg;
  }
  return CliArg { ...arg, err: f.name + " needs a value: write " + f.name + " " + f.value + " or " + f.name + "=" + f.value };
}

// The flags before FILE that are on, in the order given, or None when one does
// not parse: the main loop reports that flag first.
function given_flags(av: string[]): Option[string[]] {
  let out: string[] = [];
  let i = 1;
  while (i < av.len() && is_flag(av[i]) && av[i] != "--") {
    let f = read_flag(av, i);
    if (f.err.len() > 0) {
      return None;
    }
    if (f.on && !util.has_str(out, f.name)) {
      out = out.append(f.name);
    }
    i = f.last + 1;
  }
  return Some(out);
}

function flag_combination_error(given: string[]): Option[string] {
  let mode = "";
  for name in given {
    let f = find_flag(name);
    if (f.mode && mode.len() > 0) {
      return Some(mode + " and " + name + " are separate modes: give one of them");
    }
    if (f.mode) {
      mode = name;
    }
    if (f.needs.len() > 0 && !gives_any(given, f.needs)) {
      return Some(name + " takes effect only with " + either(f.needs));
    }
    for other in f.not_with {
      if (util.has_str(given, other)) {
        return Some(other + " and " + name + " do different things with the result: give one of them");
      }
    }
  }
  return None;
}

function gives_any(given: string[], names: string[]): boolean {
  for n in names {
    if (util.has_str(given, n)) {
      return true;
    }
  }
  return false;
}

function either(names: string[]): string {
  let out = names[0];
  for i in 1..names.len() {
    out = f"{out} or {names[i]}";
  }
  return out;
}

function read_bool(arg: CliArg, has_eq: boolean, given: string): CliArg {
  if (!has_eq || util.has_str(["1", "t", "T", "true", "TRUE", "True"], given)) {
    return arg;
  }
  if (util.has_str(["0", "f", "F", "false", "FALSE", "False"], given)) {
    return CliArg { ...arg, on: false };
  }
  return CliArg { ...arg, err: arg.name + " is a boolean: write " + arg.name + "=true or " + arg.name + "=false (got \"" + given + "\")" };
}

function usage_lines(embedded: boolean): string[] {
  let root = unless_embedded(embedded, " [STDLIB]");
  let lines: string[] = [
    "usage: fern [FLAG...] FILE.fern" + unless_embedded(embedded, " [STDLIB") + " [--] [ARG...]" + unless_embedded(embedded, "]"),
    "       fern -check [FLAG...] DIR" + root,
    "       fern -check | -interp [FLAG...] -             (the program on stdin)",
    "       fern -fmt [-w | -d | -o OUT] FILE | DIR | -...",
    "       fern -lint [-lint-set RULE=LEVEL] [-lint-cover FILE] PATH...",
    "       fern -doc [-o OUT] MODULE.fern | -doc -o OUTDIR DIR",
    "       fern -tangle | -weave | -doctest DOC.fern.md",
    "       fern [-grant CAPS] -add NAME SPEC [DIR]",
    "       fern -resolve | -vendor | -fetch [DIR]",
    "       fern -lsp | -repl [-target ISA-ENV]" + root,
    "       fern -cover-report [-lcov] FILE",
    "       fern -explain [CODE]" + root,
    "       fern -targets | -lint-rules | -version | -h",
    "Flags go before FILE. The program's arguments follow FILE" + unless_embedded(embedded, " and STDLIB") + ", behind -- when the first begins with -.",
    "A flag takes one dash or two. A value follows as -flag VALUE or -flag=VALUE; a flag without one is a boolean, also written -flag=true or -flag=false.",
  ];
  for g in flag_groups() {
    lines = lines.append(g.title + ":");
    for f in g.flags {
      let left = "  " + flag_spelling(f);
      while (left.len() < 26) {
        left += " ";
      }
      lines = lines.append(left + "  " + f.help);
    }
  }
  return lines;
}

function usage(embedded: boolean): i32 {
  for l in usage_lines(embedded) {
    eprint(l);
  }
  return 2;
}

function help(embedded: boolean): i32 {
  for l in usage_lines(embedded) {
    write(l + "\n");
  }
  return 0;
}

// Prints the build manifest a native or wasm image carries, one field per line.
function run_manifest(path: string): i32 {
  let image: u8[] = [];
  match (read_file_bytes(path)) {
    Ok(b) => {
      image = b;
    },
    Err(e) => {
      eprint("fern: cannot read " + path + ": " + e.message());
      return 1;
    }
  }
  let fields = imagemanifest.manifest_fields(image);
  if (fields.len() == 0) {
    eprint("fern: no build manifest in " + path + ": not a native Fern executable, or one built before the manifest");
    return 1;
  }
  for field in fields {
    print(field);
  }
  return 0;
}

function list_targets(): i32 {
  let all = platforms.targets();
  for i in 0..all.len() {
    let name = all[i];
    let line = name + ": " + platforms.description(name) + "\n";
    line = line + "    capabilities: " + bracket_words(platforms.for_target(name).capabilities) + "\n";
    let kinds = platforms.handler_kinds(name);
    if (kinds.len() > 0) {
      line = line + "    handlers:     " + bracket_words(kinds) + "\n";
    }
    write(line);
  }
  return 0;
}

function bracket_words(xs: string[]): string {
  let out = "[";
  for i in 0..xs.len() {
    if (i > 0) {
      out += " ";
    }
    out += xs[i];
  }
  return out + "]";
}

function main(): i32 {
  return util.arr_push_cliff_report("fern", run());
}

function target_writes_binary(t: string, emit: string): boolean {
  if (emit.len() > 0) {
    return false;
  }
  return is_native_target(t);
}

// An image with the mode of an executable file.
function write_image_exec(out_path: string, image: u8[]): Result[void, IoError] {
  match (write_file_bytes(out_path, image)) {
    Err(e) => {
      return Err(e);
    },
    Ok(_) => {}
  }
  return chmod(out_path, 493);
}

// The output is the image when the build made one, and the text otherwise.
function write_output(out_path: string, text: string, image: u8[], t: string, emit: string): Result[void, IoError] {
  if (image.len() == 0) {
    return write_file(out_path, text);
  }
  if (!target_writes_binary(t, emit)) {
    return write_file_bytes(out_path, image);
  }
  if let Ok(link) = lstat(out_path) {
    if (!link.is_file) {
      if let Ok(st) = stat(out_path) {
        if (!st.is_file) {
          return write_file_bytes(out_path, image);
        }
      }
      return write_image_exec(out_path, image);
    }
    match (remove_file(out_path)) {
      Ok(_) => {},
      Err(_) => {}
    }
  }
  return write_image_exec(out_path, image);
}

pub function capability_diags(merged: parser.Module, target: string): util.Diag[] {
  let out = util.append_diags(util.append_diags(util.append_diags(platforms.provider_diags(merged), norc.interrupt_target_diags(merged, target)), norc.early_target_diags(merged, target)), norc.secondary_target_diags(merged, target));
  if (out.len() > 0 || platforms.enforce(merged, target).len() == 0) {
    return out;
  }
  let desc = platforms.for_target(target);
  let built = constfold.prune_literal_branches(constfold.fold_target_name(merged, desc.environment, desc.isa));
  for v in platforms.enforce(treeshake.treeshake(checker.annotate_module(built)), target) {
    out = out.append(platforms.violation_diag(v));
  }
  return out;
}

// Each `@interrupt` handler as "slot symbol", for the vector table of the
// kernel image.
function interrupt_entries(merged: parser.Module): string[] {
  let out: string[] = [];
  for m in parser.marked(merged, "interrupt") {
    out = out.append(m.arg + " __fn_" + asmcore.sanitize_label(m.func_name));
  }
  return out;
}

// Whether a function calls __user_run. A kernel image then holds the
// lower-level trap entries that return to it.
function calls_user_run(merged: parser.Module): boolean {
  let want = util.name_index(["__user_run"]);
  for fd in merged.funcs {
    let calls: astwalk.CallSite[] = [];
    for st in fd.body {
      calls = astwalk.collect_calls_stmt(st, want, calls);
    }
    for c in calls {
      if (!c.method && c.name == "__user_run") {
        return true;
      }
    }
  }
  return false;
}

// The label of the function that marks `attr`: the `@early` hook, which the
// reset entry calls before the heap starts, or the `@secondary` entry, which
// the secondary entry of another core calls. "" without one.
function marked_entry(merged: parser.Module, attr: string): string {
  for m in parser.marked(merged, attr) {
    return "__fn_" + asmcore.sanitize_label(m.func_name);
  }
  return "";
}

// The diagnostics of the rules that read the annotated module: E080, E102,
// E103 and E104.
pub function annotated_diags(merged: parser.Module): util.Diag[] {
  return util.append_diags(ambient_diags(merged), norc_diags(merged));
}

function norc_diags(merged: parser.Module): util.Diag[] {
  if (norc.marks(merged).len() == 0) {
    let none: util.Diag[] = [];
    return none;
  }
  return util.append_diags(util.append_diags(util.append_diags(norc.interrupt_diags(merged), norc.early_diags(merged)), norc.secondary_diags(merged)), norc.diags(checker.annotate_module(merged)));
}

function ambient_diags(merged: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let has_bag = false;
  for fd in merged.funcs {
    if (fd.body.len() > 0 && ambient.bag_param(fd).len() > 0) {
      has_bag = true;
      break;
    }
  }
  if (!has_bag) {
    return out;
  }
  for v in ambient.enforce(checker.annotate_module(merged)) {
    out = out.append(util.violation_diag("E080", ambient.violation_message(v), v.fn_module, v.line, v.col));
  }
  return out;
}

// The refusal when IPATH.sig, 128 hex digits of an ed25519 signature
// over the index bytes, is absent, malformed or does not verify against
// the manifest's index_key. Empty when the signature verifies.
function index_signature_error(ipath: string, isrc: string, key: string): string {
  let spath = ipath + ".sig";
  let pub_hex = slice_unchecked(key, 8, key.len()).to_owned();
  let pubkey: u8[] = match (hex.decode(pub_hex)) { Ok(bytes) => bytes, Err(e) => [] };
  let pk: ed25519.PublicKey = match (ed25519.public_key(pubkey)) { Ok(k) => k, Err(e) => { return "index " + ipath + ": index_key is not an ed25519 public key"; } };
  let stext = "";
  match (read_file(spath)) {
    Ok(s) => {
      stext = s;
    },
    Err(e) => {
      return "index " + ipath + ": fern.toml names index_key but " + spath + " cannot be read";
    }
  }
  let sig: u8[] = match (hex.decode(strip_lines(stext))) { Ok(bytes) => bytes, Err(e) => [] };
  if (sig.len() != 64) {
    return "index " + spath + ": must be 128 hex digits of the ed25519 signature over the index";
  }
  if (!pk.verify(isrc.bytes(), sig)) {
    return "index " + ipath + ": the signature in " + spath + " does not verify against index_key";
  }
  return "";
}

// The refusal when the existing lock records an index serial that the
// index's serial is below or that the index has lost. Empty otherwise.
function index_serial_error(ipath: string, serial: string, mdir: string): string {
  let lock = mdir + "/fern.lock";
  let recorded = "";
  match (read_file(lock)) {
    Ok(src) => {
      recorded = match (fern_toml.parse_lock(src)) { Ok(l) => l.index_serial, Err(message) => { return mdir + "/" + message; } };
    },
    Err(e) => {}
  }
  if (recorded.len() == 0) {
    return "";
  }
  if (serial.len() == 0) {
    return "index " + ipath + ": has no serial but " + lock + " records index serial " + recorded;
  }
  if (fern_toml.serial_below(serial, recorded)) {
    return "index " + ipath + ": serial " + serial + " is below index serial " + recorded + " that " + lock + " records";
  }
  return "";
}

// The text without the spaces, tabs and line ends at either end.
function strip_lines(s: string): string {
  let a = 0;
  let b = s.len();
  while (a < b && (s[a] == b' ' || s[a] == b'\t' || s[a] == b'\r' || s[a] == b'\n')) {
    a += 1;
  }
  while (b > a && (s[b - 1] == b' ' || s[b - 1] == b'\t' || s[b - 1] == b'\r' || s[b - 1] == b'\n')) {
    b -= 1;
  }
  return slice_unchecked(s, a, b).to_owned();
}

function read_manifest(dir_slash: string): fern_toml.Manifest {
  match (read_file(dir_slash + "fern.toml")) {
    Ok(src) => {
      return fern_toml.parse(src);
    },
    Err(e) => {}
  }
  let no_deps: fern_toml.Dep[] = [];
  let no_members: string[] = [];
  let no_excl: string[] = [];
  return fern_toml.Manifest {
    name: "", lib: "lib.fern", index: "", index_key: "", deps: no_deps, members: no_members,
    excl_pkg: no_excl, excl_ver: no_excl, lint_keys: no_excl, lint_vals: no_excl, android_keys: no_excl, android_vals: no_excl, err: "", err_line: 0,
  };
}

function manifest_path(dir: string): string {
  let abs = pkggrants.canonical_dir(dir);
  if (abs != "/") {
    abs += "/";
  }
  return abs + "fern.toml";
}

function manifest_error(dir: string, man: fern_toml.Manifest): string {
  if (man.err.len() == 0) {
    return "";
  }
  return fern_toml.diagnostic(manifest_path(dir), man);
}

function manifest_refused(b: Bundle, dir: string, man: fern_toml.Manifest): Bundle {
  let at = with_manifest_file(b, dir);
  return Bundle { ...at, errs: [load_diag("E088", man.err, manifest_line(at, dir, man.err_line), 1)] };
}

function grants_refused(b: Bundle, refused: pkggrants.Refusal[]): Bundle {
  let errs: util.Diag[] = [];
  for r in refused {
    b = with_manifest_file(b, r.dir);
    errs = errs.append(load_diag("E088", r.message, manifest_line(b, r.dir, r.line), 1));
  }
  return Bundle { ...b, errs: errs };
}

function with_manifest_file(b: Bundle, dir: string): Bundle {
  if (util.has_str(b.files, manifest_path(dir))) {
    return b;
  }
  return Bundle { ...b, files: b.files.append(manifest_path(dir)), maps: b.maps.append(util.no_line_map()), srcs: b.srcs.append("") };
}

function manifest_line(b: Bundle, dir: string, line: i32): i32 {
  return util.line_base(util.index_of_str(b.files, manifest_path(dir))) + line;
}

function load_diag(code: string, message: string, line: i32, col: i32): util.Diag {
  return util.Diag { related: [], length: 0, code: code, message: message, line: line, col: col, fix: None };
}

function manifest_reqs(man: fern_toml.Manifest): mvs.Req[] {
  let out: mvs.Req[] = [];
  for i in 0..man.deps.len() {
    if (man.deps[i].kind == "version" && man.deps[i].version.len() > 0) {
      out = out.append(mvs.Req { pkg: man.deps[i].name + "", min: man.deps[i].version + "" });
    }
  }
  return out;
}

struct Governed { man: fern_toml.Manifest, dir: string, found: boolean }

function governing_manifest(dir_slash: string): Governed {
  match (modloader.find_manifest(dir_slash)) {
    Some(mdir) => {
      return Governed { man: read_manifest(mdir), dir: mdir, found: true };
    },
    None => {
      return Governed { man: read_manifest(dir_slash), dir: dir_slash, found: false };
    }
  }
}

function find_manifest_dir(dir: string): string {
  let d = dir;
  if (d.len() > 0 && d[d.len() - 1] != b'/') {
    d += "/";
  }
  match (modloader.find_manifest(d)) {
    Some(m) => {
      if (m.len() == 0) {
        return ".";
      }
      if (m == "/") {
        return m;
      }
      return slice_unchecked(m, 0, m.len() - 1).to_owned();
    },
    None => {
      return "";
    }
  }
}

function run_resolve(start: string, fetcher: Fetcher): i32 {
  let dir = start;
  match (read_file(start)) {
    Ok(s) => {
      dir = util.dir_of(start);
    },
    Err(e) => {}
  }
  let mdir = find_manifest_dir(dir);
  if (mdir.len() == 0) {
    eprint("resolve: no fern.toml governs " + dir);
    return 1;
  }
  let mpath = mdir + "/fern.toml";
  let man = read_manifest(mdir + "/");
  if (man.err.len() > 0) {
    eprint(manifest_error(mdir, man));
    return 1;
  }
  let roots = manifest_reqs(man);
  if (roots.len() == 0) {
    eprint("resolve: " + mpath + " declares no versioned dependencies (nothing to resolve)");
    return 1;
  }
  if (man.index.len() == 0) {
    eprint("resolve: " + mpath + " has versioned dependencies but no `index = \"…\"` under [package]");
    return 1;
  }
  let ipath = man.index;
  if (!mvs.is_abs(ipath)) {
    ipath = mvs.join_path(mdir, ipath);
  }
  let isrc = "";
  let iok = false;
  match (read_file(ipath)) {
    Ok(s) => {
      isrc = s;
      iok = true;
    },
    Err(e) => {}
  }
  if (!iok) {
    eprint("index " + ipath + ": cannot read");
    return 1;
  }
  if (man.index_key.len() > 0) {
    let why = index_signature_error(ipath, isrc, man.index_key);
    if (why.len() > 0) {
      eprint(why);
      return 1;
    }
  }
  let ix: mvs.Index = match (mvs.parse_index(isrc)) { Ok(index) => index, Err(message) => { eprint("index " + ipath + ": " + message); return 1; } };
  ix = mvs.with_dir(ix, mvs.join_path(util.dir_of(ipath), "."));
  let lock = mdir + "/fern.lock";
  let stale = index_serial_error(ipath, ix.serial, mdir);
  if (stale.len() > 0) {
    eprint(stale);
    return 1;
  }

  let bans: mvs.Ban[] = [];
  for bi in 0..man.excl_pkg.len() {
    bans = bans.append(mvs.Ban { pkg: man.excl_pkg[bi] + "", ver: man.excl_ver[bi] + "" });
  }

  let st = mvs.begin(roots, bans, ix);
  while (st.err.len() == 0 && !mvs.done(st)) {
    let src: mvs.Source = match (mvs.index_source(ix, st.need_pkg, st.need_ver)) { Some(value) => value, None => { st = mvs.fail(st, "registry has no source for " + st.need_pkg + "@" + st.need_ver); continue; } };
    if (src.path.len() == 0) {
      let got = fetch_into_store(fetcher, src.url, src.hash);
      src = mvs.Source { ...src, path: got.dir };
      if (got.err.len() > 0) {
        st = mvs.fail(st, st.need_pkg + "@" + st.need_ver + ": " + got.err);
      }
    }
    if (st.err.len() == 0) {
      let dsrc = "";
      let dok = false;
      match (read_file(src.path + "/fern.toml")) {
        Ok(s) => {
          dsrc = s;
          dok = true;
        },
        Err(e) => {}
      }
      let dman = fern_toml.parse(dsrc);
      if (!dok) {
        st = mvs.fail(st, st.need_pkg + "@" + st.need_ver + " has no fern.toml");
      } else if (dman.err.len() > 0) {
        st = mvs.fail(st, manifest_error(src.path, dman));
      } else {
        st = mvs.supply(st, manifest_reqs(dman));
      }
    }
  }
  if (st.err.len() > 0) {
    eprint(st.err);
    return 1;
  }

  let sel: mvs.Sel[] = match (mvs.selected(st)) { Ok(value) => value, Err(message) => { eprint(message); return 1; } };
  match (write_file(lock, mvs.lock_text(ix.serial, sel))) {
    Ok(u) => {},
    Err(e) => {
      eprint("resolve: cannot write " + lock + ": " + e.message());
      return 1;
    }
  }
  eprint("resolve: " + util.i32_to_string(sel.len()) + " package(s) pinned in " + lock);
  for i in 0..sel.len() {
    eprint("  " + sel[i].name + " " + sel[i].ver);
  }
  return 0;
}

function run_add(pos: string[], grant: string, fetcher: Fetcher): i32 {
  if (add_args_refused(pos)) {
    return 2;
  }
  let name = pos[0];
  let spec = pos[1];
  let dir = "";
  if (pos.len() > 2) {
    dir = pos[2];
  }
  dir = abs_dir(dir);
  if (!fern_toml.valid_dep_name(name)) {
    eprint("fern: -add: invalid dependency name " + util.quoted(name) + " (letters, digits, `_`, `-`; must not start with a digit)");
    return 1;
  }
  let mdir = find_manifest_dir(dir);
  if (mdir.len() == 0) {
    eprint("fern: -add: no fern.toml governs " + dir + " — create one with a [package] table first");
    return 1;
  }
  let mpath = mdir + "/fern.toml";
  let man = read_manifest(mdir + "/");
  if (man.err.len() > 0) {
    eprint(manifest_error(mdir, man));
    return 1;
  }
  if (fern_toml.has_dep(man, name)) {
    eprint("fern: -add: " + util.quoted(name) + " is already a dependency in " + mpath + " (edit it by hand to change its source)");
    return 1;
  }
  let line = dep_line(name, spec, grant, fetcher);
  if (line.len() == 0) {
    return 1;
  }

  let orig = "";
  let ok = false;
  match (read_file(mpath)) {
    Ok(s) => {
      orig = s;
      ok = true;
    },
    Err(e) => {}
  }
  if (!ok) {
    eprint("fern: -add: cannot read " + mpath);
    return 1;
  }
  let updated = insert_dependency(orig, line);
  let edited = fern_toml.parse(updated);
  if (edited.err.len() > 0) {
    eprint("fern: -add: the edit would produce an invalid manifest (" + edited.err + ") — no change written");
    return 1;
  }
  match (write_file(mpath, updated)) {
    Ok(u) => {},
    Err(e) => {
      eprint("fern: -add: cannot write " + mpath + ": " + e.message());
      return 1;
    }
  }
  eprint("fern: added " + line);
  return 0;
}

function add_args_refused(pos: string[]): boolean {
  for a in pos {
    if (is_flag(a)) {
      eprint("fern: " + a + " comes after -add's arguments, where flags are no longer parsed; put it before -add");
      return true;
    }
  }
  if (pos.len() < 2 || pos.len() > 3) {
    eprint("usage: fern [-grant CAPS] -add NAME SPEC [DIR]   (SPEC = path:../dir | url:https://… | workspace | version:X.Y.Z)");
    return true;
  }
  return false;
}

function dep_line(name: string, spec: string, grant: string, fetcher: Fetcher): string {
  let fields = dep_source(spec, fetcher);
  if (fields.len() == 0) {
    return "";
  }
  if (grant.len() == 0) {
    if (spec.starts_with("version:")) {
      return name + " = " + util.quoted(slice_unchecked(spec, 8, spec.len()).to_owned());
    }
    return name + " = { " + fields + " }";
  }
  let granted = grant_list(grant);
  if (granted.len() == 0) {
    return "";
  }
  return name + " = { " + fields + ", capabilities = " + granted + " }";
}

function dep_source(spec: string, fetcher: Fetcher): string {
  if (spec == "workspace") {
    return "workspace = true";
  } else if (spec.starts_with("path:")) {
    let p = slice_unchecked(spec, 5, spec.len()).to_owned();
    if (p.len() == 0) {
      eprint("fern: -add: empty path in " + util.quoted(spec));
      return "";
    }
    return "path = " + util.quoted(p);
  } else if (spec.starts_with("version:")) {
    let v = slice_unchecked(spec, 8, spec.len()).to_owned();
    if (!fern_toml.is_version(v)) {
      eprint("fern: -add: version must be MAJOR.MINOR.PATCH digits, got " + util.quoted(v));
      return "";
    }
    return "version = " + util.quoted(v);
  } else if (spec.starts_with("url:")) {
    let u = slice_unchecked(spec, 4, spec.len()).to_owned();
    if (!u.starts_with("https://") && !u.starts_with("http://")) {
      eprint("fern: -add: url must be http(s), got " + util.quoted(u));
      return "";
    }
    eprint("fetching " + u + " to compute its hash…");
    let got = fetcher.fetch(u, "");
    if (got.err.len() > 0) {
      eprint("fern: -add: " + got.err);
      return "";
    }
    return "url = " + util.quoted(u) + ", hash = " + util.quoted(got.hash);
  }
  eprint("fern: -add: unrecognised source " + util.quoted(spec) + " — use path:DIR, url:HTTPS_URL, workspace or version:X.Y.Z");
  return "";
}

function grant_list(grant: string): string {
  if (grant == "none") {
    return "[]";
  }
  let quoted = "";
  for name in mvs.split_char(grant, b',') {
    if (quoted.len() > 0) {
      quoted += ", ";
    }
    quoted += util.quoted(name);
  }
  match (fern_toml.parse_capabilities("[" + quoted + "]")) {
    Ok(caps) => {
      let out = "";
      for cap in caps {
        if (out.len() > 0) {
          out += ", ";
        }
        out += util.quoted(cap);
      }
      return "[" + out + "]";
    },
    Err(message) => {
      eprint("fern: -add: -grant: " + message);
      return "";
    }
  }
}

function insert_dependency(src: string, line: string): string {
  let lines = mvs.split_char(src, b'\n');
  for i in 0..lines.len() {
    if (fern_toml.line_content(lines[i]).trim() == "[dependencies]") {
      let out = "";
      for k in 0..lines.len() {
        if (k > 0) {
          out += "\n";
        }
        out += lines[k];
        if (k == i) {
          out = out + "\n" + line;
        }
      }
      return out;
    }
  }
  let sep = "\n";
  if (src.len() > 0 && src[src.len() - 1] == b'\n') {
    sep = "";
  }
  return src + sep + "\n[dependencies]\n" + line + "\n";
}

struct VendorSrc { dir: string, err: string }

struct VendorSet { names: string[], srcs: string[], err: string }

function fetch_into_store(fetcher: Fetcher, url: string, hash: string): Fetched {
  let have = store_dir(hash);
  if (have.len() > 0) {
    return Fetched { hash: hash, dir: have, err: "" };
  }
  return fetcher.fetch(url, hash);
}

struct FetchWalk { seen: string[], fetched: i32, err: string }

function run_fetch(start: string, fetcher: Fetcher): i32 {
  let dir = start;
  if (!util.is_dir(start)) {
    dir = util.dir_of(start);
  }
  let mdir = find_manifest_dir(dir);
  if (mdir.len() == 0) {
    eprint("fetch: no fern.toml governs " + dir);
    return 1;
  }
  let w = fetch_walk(fetcher, FetchWalk { seen: [], fetched: 0, err: "" }, mdir);
  if (w.err.len() == 0) {
    w = fetch_locked(fetcher, w, mdir);
  }
  if (w.err.len() > 0) {
    eprint(w.err);
    return 1;
  }
  eprint("fetch: " + util.i32_to_string(w.fetched) + " downloaded, " + util.i32_to_string(w.seen.len()) + " package(s) checked");
  return 0;
}

function fetch_walk(fetcher: Fetcher, w: FetchWalk, mdir: string): FetchWalk {
  if (str_index(w.seen, mdir) >= 0) {
    return w;
  }
  let out = FetchWalk { ...w, seen: w.seen.append(mdir) };
  let man = read_manifest(mdir + "/");
  if (man.err.len() > 0) {
    return FetchWalk { ...out, err: manifest_error(mdir, man) };
  }
  for d in man.deps {
    if (out.err.len() > 0) {
      return out;
    }
    let ddir = "";
    if (d.kind == "url") {
      if (store_dir(d.hash).len() == 0) {
        eprint("fetching " + d.name + " (" + d.url + ")");
        out = FetchWalk { ...out, fetched: out.fetched + 1 };
      }
      let got = fetch_into_store(fetcher, d.url, d.hash);
      if (got.err.len() > 0) {
        return FetchWalk { ...out, err: "dependency " + util.quoted(d.name) + ": " + got.err };
      }
      ddir = got.dir;
    } else if (d.kind == "path") {
      ddir = vendor_dep_dir(mdir, d).dir;
    }
    if (ddir.len() > 0 && has_manifest(ddir)) {
      out = fetch_walk(fetcher, out, ddir);
    }
  }
  return out;
}

function fetch_locked(fetcher: Fetcher, w: FetchWalk, mdir: string): FetchWalk {
  let lsrc = "";
  match (read_file(mdir + "/fern.lock")) {
    Ok(s) => {
      lsrc = s;
    },
    Err(e) => {
      return w;
    }
  }
  let entries: fern_toml.LockEntry[] = match (fern_toml.parse_lock(lsrc)) { Ok(lock) => lock.entries, Err(message) => { return FetchWalk { ...w, err: mdir + "/" + message }; } };
  let out = w;
  for e in entries {
    if (e.url.len() > 0 && store_dir(e.hash).len() == 0) {
      eprint("fetching " + e.name + "@" + e.version + " (" + e.url + ")");
      let got = fetcher.fetch(e.url, e.hash);
      if (got.err.len() > 0) {
        return FetchWalk { ...out, err: "locked dependency " + util.quoted(e.name) + ": " + got.err };
      }
      out = FetchWalk { ...out, fetched: out.fetched + 1 };
    }
  }
  return out;
}

function run_vendor(start: string): i32 {
  let dir = start;
  if (!util.is_dir(start)) {
    let readable = false;
    match (read_file(start)) {
      Ok(s) => {
        readable = true;
      },
      Err(e) => {}
    }
    if (!readable) {
      eprint("vendor: cannot read " + start);
      return 1;
    }
    dir = util.dir_of(start);
  }
  let mdir = find_manifest_dir(dir);
  if (mdir.len() == 0) {
    eprint("vendor: no fern.toml governs " + dir);
    return 1;
  }
  let root = read_manifest(mdir + "/");
  if (root.err.len() > 0) {
    eprint(manifest_error(mdir, root));
    return 1;
  }

  let starts: string[] = [];
  if (root.members.len() == 0) {
    starts = starts.append(mdir + "");
  } else {
    let mi = 0;
    while (mi < root.members.len()) {
      let rel = root.members[mi];
      mi += 1;
      let mem = rel;
      if (!mvs.is_abs(rel)) {
        mem = mvs.join_path(mdir, rel);
      }
      if (!has_manifest(mem)) {
        eprint("vendor: workspace member " + util.quoted(rel) + " has no fern.toml");
        return 1;
      }
      starts = starts.append(mem + "");
    }
  }

  let set = vendor_collect(starts);
  if (set.err.len() > 0) {
    eprint(set.err);
    return 1;
  }

  let vdir = mdir + "/vendor";
  match (remove_dir_all(vdir)) {
    Ok(u) => {},
    Err(e) => {
      eprint("vendor: clearing " + vdir);
      return 1;
    }
  }
  for i in 0..set.names.len() {
    let err = copy_package(set.srcs[i], vdir + "/" + set.names[i]);
    if (err.len() > 0) {
      eprint("vendor: copying " + util.quoted(set.names[i]) + ": " + err);
      return 1;
    }
  }
  eprint("vendor: " + util.i32_to_string(set.names.len()) + " package(s) written to " + vdir);
  return 0;
}

function vendor_collect(starts: string[]): VendorSet {
  let names: string[] = [];
  let srcs: string[] = [];
  let seen: string[] = [];
  let queue = starts;
  let qi = 0;
  while (qi < queue.len()) {
    let mdir = queue[qi];
    qi += 1;
    if (str_index(seen, mdir) >= 0) {
      continue;
    }
    seen = seen.append(mdir + "");
    let man = read_manifest(mdir + "/");
    if (man.err.len() > 0) {
      return VendorSet { names: names, srcs: srcs, err: manifest_error(mdir, man) };
    }
    let di = 0;
    while (di < man.deps.len()) {
      let d = man.deps[di];
      di += 1;
      if (d.kind == "workspace") {
        continue;
      }
      let src = vendor_dep_dir(mdir, d);
      if (src.err.len() > 0) {
        return VendorSet { names: names, srcs: srcs, err: src.err };
      }
      let key = d.name + "";
      let pkg_name = read_manifest(src.dir + "/").name;
      if (pkg_name.len() > 0) {
        key = pkg_name;
      }
      let at = str_index(names, key);
      if (at >= 0) {
        if (srcs[at] != src.dir) {
          return VendorSet {
            names: names, srcs: srcs,
            err: "vendor: two different packages both named " + util.quoted(key)
              + " (" + srcs[at] + " and " + src.dir + ") — package names must be unique to vendor",
          };
        }
      } else {
        names = names.append(key + "");
        srcs = srcs.append(src.dir + "");
      }
      if (has_manifest(src.dir)) {
        queue = queue.append(src.dir + "");
      }
    }
  }
  return VendorSet { names: names, srcs: srcs, err: "" };
}

function vendor_dep_dir(mdir: string, d: fern_toml.Dep): VendorSrc {
  if (d.kind == "version") {
    return vendor_locked_dir(mdir, d.name);
  }
  if (d.kind == "url") {
    let store = store_dir(d.hash);
    if (store.len() == 0) {
      return VendorSrc { dir: "", err: "dependency " + util.quoted(d.name) + " (" + d.hash
        + ") is not in the package store — run `fern -fetch " + mdir + "/fern.toml` before vendoring" };
    }
    return VendorSrc { dir: store, err: "" };
  }
  if (mvs.is_abs(d.path)) {
    return VendorSrc { dir: mvs.join_path(d.path, "."), err: "" };
  }
  return VendorSrc { dir: mvs.join_path(mdir, d.path), err: "" };
}

function vendor_locked_dir(mdir: string, name: string): VendorSrc {
  let lsrc = "";
  let have = false;
  match (read_file(mdir + "/fern.lock")) {
    Ok(s) => {
      lsrc = s;
      have = true;
    },
    Err(e) => {}
  }
  if (!have) {
    return VendorSrc { dir: "", err: "dependency " + util.quoted(name) + " is versioned but " + mdir
      + " has no fern.lock — run `fern -resolve " + mdir + "/fern.toml`" };
  }
  let entries: fern_toml.LockEntry[] = match (fern_toml.parse_lock(lsrc)) { Ok(lock) => lock.entries, Err(message) => { return VendorSrc { dir: "", err: mdir + "/" + message }; } };
  if (!fern_toml.lock_has(entries, name)) {
    return VendorSrc { dir: "", err: "dependency " + util.quoted(name) + " is not in " + mdir
      + "/fern.lock — run `fern -resolve " + mdir + "/fern.toml`" };
  }
  match (fern_toml.lock_path_of(entries, name)) {
    Some(p) => {
      return VendorSrc { dir: p, err: "" };
    },
    None => {}
  }
  match (fern_toml.lock_hash_of(entries, name)) {
    Some(h) => {
      let store = store_dir(h);
      if (store.len() == 0) {
        return VendorSrc { dir: "", err: "dependency " + util.quoted(name) + "@"
          + fern_toml.lock_version_of(entries, name) + " (" + h
          + ") is not in the package store — run `fern -fetch " + mdir + "/fern.toml`" };
      }
      return VendorSrc { dir: store, err: "" };
    },
    None => {}
  }
  return VendorSrc { dir: "", err: "dependency " + util.quoted(name) + " is not in " + mdir
    + "/fern.lock — run `fern -resolve " + mdir + "/fern.toml`" };
}

function store_dir(hash: string): string {
  match (modloader.store_dir(hash)) {
    Some(d) => {
      return dir_or_empty(slice_unchecked(d, 0, d.len() - 1).to_owned());
    },
    None => {}
  }
  return "";
}

function dir_or_empty(p: string): string {
  if (util.is_dir(p)) {
    return p;
  }
  return "";
}

function has_manifest(dir: string): boolean {
  match (read_file(dir + "/fern.toml")) {
    Ok(s) => {
      return true;
    },
    Err(e) => {}
  }
  return false;
}

function str_index(xs: string[], want: string): i32 {
  for i in 0..xs.len() {
    if (xs[i] == want) {
      return i;
    }
  }
  return -1;
}

function copy_package(src: string, dst: string): string {
  let rels: string[] = [""];
  let ri = 0;
  while (ri < rels.len()) {
    let rel = rels[ri];
    ri += 1;
    let sdir = src;
    if (rel.len() > 0) {
      sdir = src + "/" + rel;
    }
    let entries: string[] = [];
    let listed = false;
    match (read_dir(sdir)) {
      Ok(ns) => {
        entries = ns;
        listed = true;
      },
      Err(e) => {}
    }
    if (!listed) {
      return "cannot read " + sdir;
    }
    let i = 0;
    while (i < entries.len()) {
      let name = entries[i];
      i += 1;
      let child_rel = name + "";
      if (rel.len() > 0) {
        child_rel = rel + "/" + name;
      }
      let child = src + "/" + child_rel;
      if (util.is_dir(child)) {
        if (name == "vendor") {
          continue;
        }
        if (name.len() > 0 && name[0] == b'.') {
          continue;
        }
        rels = rels.append(child_rel + "");
        continue;
      }
      if (!is_vendorable(name)) {
        continue;
      }
      let body = "";
      match (read_file(child)) {
        Ok(s) => {
          body = s;
        },
        Err(e) => {
          return "cannot read " + child + ": " + e.message();
        }
      }
      let out = dst + "/" + child_rel;
      match (create_dir_all(util.dir_of(out))) {
        Ok(u) => {},
        Err(e) => {
          return "cannot create " + util.dir_of(out) + ": " + e.message();
        }
      }
      match (write_file(out, body)) {
        Ok(u) => {},
        Err(e) => {
          return "cannot write " + out + ": " + e.message();
        }
      }
    }
  }
  return "";
}

function is_vendorable(name: string): boolean {
  if (name == "fern.toml") {
    return true;
  }
  if (name.len() >= 8 && name.ends_with(".fern.md")) {
    return true;
  }
  if (name.len() >= 5 && name.ends_with(".fern")) {
    return true;
  }
  return false;
}

struct Bundle {
  entry: parser.Module,
  entry_ident: string,
  root: string,
  loaded: flatten.LoadedModule[],
  merged: parser.Module,
  pkgs: caps.Pkg[],
  package_roots: string[],
  files: string[],
  maps: util.LineMap[],
  srcs: string[],
  errs: util.Diag[],
}

struct Sources { paths: string[], srcs: string[], maps: util.LineMap[], open: modloader.Buffers }

function is_literate(path: string): boolean {
  return path.ends_with(".fern.md");
}

function entry_sources(path: string, src: string): (Sources, string) {
  let plain = Sources { paths: [path], srcs: [src], maps: [util.no_line_map()], open: modloader.no_buffers() };
  if (!is_literate(path)) {
    return (plain, "");
  }
  if (literate.parse_file_pieces(src).len() > 0) {
    return multi_file_sources(path, src);
  }
  match (literate.tangle(src)) {
    literate.TangleOk(o) => {
      return (Sources { ...plain, srcs: [o.code], maps: [util.LineMap { doc: path, lits: o.lits, shifts: o.shifts }] }, "");
    },
    literate.TangleErr(e) => {
      return (plain, tangle_error(path, e.line, e.col, e.msg));
    }
  }
}

function multi_file_sources(path: string, src: string): (Sources, string) {
  let none = Sources { paths: [], srcs: [], maps: [], open: modloader.no_buffers() };
  let files: literate.FileResult[] = [];
  match (literate.tangle_files(src)) {
    literate.FileTangleOk(o) => {
      files = o.files;
    },
    literate.FileTangleErr(e) => {
      return (none, tangle_error(path, e.line, e.col, e.msg));
    }
  }
  let entry = literate.entry_file(files);
  if (entry.len() == 0) {
    let marked: string[] = [];
    let names = "";
    let marked_names = "";
    for f in files {
      names = list_add(names, f.path);
      if (f.is_entry) {
        marked = marked.append(f.path);
        marked_names = list_add(marked_names, f.path);
      }
    }
    if (marked.len() > 1) {
      return (none, tangle_error(path, literate.fence_line(src, marked[1]), 1, "literate: multiple files marked `entry` (" + marked_names + ") — exactly one is the compile entry"));
    }
    return (none, tangle_error(path, 1, 1, "literate: " + util.i32_to_string(files.len()) + " output files (" + names + ") but none marked `entry` — add `entry` to the ```fern file=… block that holds main"));
  }
  let out = none;
  for f in files {
    if (f.path == entry) {
      out = add_generated(out, path, f);
    }
  }
  for f in files {
    if (f.path != entry) {
      out = add_generated(out, path, f);
    }
  }
  return (out, "");
}

function list_add(list: string, item: string): string {
  if (list.len() == 0) {
    return item;
  }
  return list + ", " + item;
}

function add_generated(s: Sources, doc: string, f: literate.FileResult): Sources {
  let mpath = f.path;
  if (!mpath.starts_with("/")) {
    mpath = modloader.dirname(doc) + mpath;
  }
  return Sources {
    ...s,
    paths: s.paths.append(util.clean_path(mpath)),
    srcs: s.srcs.append(f.code),
    maps: s.maps.append(util.LineMap { doc: doc, lits: f.lits, shifts: f.shifts }),
  };
}

function tangle_error(path: string, line: i32, col: i32, msg: string): string {
  return path + ":" + util.i32_to_string(line) + ":" + util.i32_to_string(col) + ": error[E092]: " + msg;
}

function eprint_tangle_error(path: string, line: i32, col: i32, msg: string): void {
  eprint(tangle_error(path, line, col, msg) + snippet(plain_style(), path, line, col, "31", 0));
}

function display_path(mpath: string, root: string): string {
  if (root.len() == 0 || !mpath.starts_with(root)) {
    return mpath;
  }
  let at = root.len();
  if (at < mpath.len() && mpath[at] != b'/' && root[root.len() - 1] != b'/') {
    return mpath;
  }
  while (at < mpath.len() && mpath[at] == b'/') {
    at += 1;
  }
  return "stdlib://" + slice_unchecked(mpath, at, mpath.len());
}

function read_bundle_module(s: Sources, mpath: string, from: string, ipath: string): modloader.Resolved {
  let ov = modloader.Overlay { ...modloader.no_overlay(), files: s.open };
  if let Some(declared) = modloader.declared_module(ov, from, ipath) {
    return declared;
  }
  let gi = util.index_of_str(s.paths, mpath);
  if (gi >= 0) {
    return modloader.Resolved { src: s.srcs[gi], ok: true, err: "", err_path: "", shown: mpath, map: s.maps[gi] };
  }
  let r = modloader.read_module(s.open, mpath);
  if (r.ok || r.err.len() > 0) {
    return r;
  }
  return modloader.try_manifest(ov, from, ipath);
}

function module_package_at(mdir: string, module_gov: Governed, root_gov_dir: string, root_package: caps.Pkg, is_stdlib: boolean): pkggrants.ModuleAt {
  let package_dir = root_package.dir;
  let package_name = root_package.name;
  if (module_gov.found && module_gov.dir != root_gov_dir) {
    package_dir = pkggrants.canonical_dir(module_gov.dir);
    if (module_gov.man.name.len() > 0) {
      package_name = module_gov.man.name;
    }
  }
  let actual_dir = package_dir;
  if (mdir != module_gov.dir || !module_gov.found) {
    actual_dir = pkggrants.canonical_dir(mdir);
  }
  return pkggrants.ModuleAt { dir: actual_dir, owner_dir: package_dir, name: package_name, stdlib: is_stdlib };
}

function load_bundle(s: Sources, entry_mod: parser.Module, root: string, target: string): Bundle {
  let entry_path = s.paths[0];
  let entry_ident = flatten.module_ident(util.clean_path(entry_path));
  let dir = util.dir_of(entry_path);
  let dir_slash = "";
  if (dir.len() > 0) {
    dir_slash = dir + "/";
  }
  let gov = governing_manifest(dir_slash);
  let deps = fern_toml.dep_names(gov.man);
  let root_package = root_pkg(gov.man, pkggrants.canonical_dir(gov.dir));
  let pkgs: caps.Pkg[] = [root_package];
  let package_roots: string[] = [visibility.package_root(entry_ident, root, root_package.dir)];
  let module_packages: pkggrants.ModuleAt[] = [];
  let grant_mans = pkggrants.with_manifest([], gov.dir, gov.man);
  let gov_dirs: string[] = [];
  let govs: Governed[] = [];
  let no_mods: flatten.LoadedModule[] = [];
  let no_files: string[] = [];
  let maps: util.LineMap[] = [s.maps[0]];
  let srcs: string[] = [s.srcs[0]];
  if (gov.man.err.len() > 0) {
    return manifest_refused(Bundle { entry: entry_mod, entry_ident: "", root: root, loaded: no_mods, merged: entry_mod, pkgs: pkgs, package_roots: package_roots, files: no_files, maps: maps, srcs: srcs, errs: [] }, gov.dir, gov.man);
  }
  let missing = emitforms.http_entry_refused(entry_mod, target);
  if (missing.message.len() > 0) {
    return Bundle { entry: entry_mod, entry_ident: "", root: root, loaded: no_mods, merged: entry_mod, pkgs: pkgs, package_roots: package_roots, files: no_files, maps: maps, srcs: srcs, errs: [missing] };
  }

  let q = queue_imports(ImportQueue { paths: [], dirs: [], lines: [], cols: [], stdlibs: [], unrooted: "", display_queued: false }, entry_mod, dir_slash, root, deps, false);
  let loaded: flatten.LoadedModule[] = [];
  let files: string[] = [];
  let done_paths: string[] = [];
  let j = 0;
  while (j < q.paths.len()) {
    let ipath = q.paths[j];
    let from = q.dirs[j];
    let at_line = q.lines[j];
    let at_col = q.cols[j];
    let is_stdlib = q.stdlibs[j];
    j += 1;
    let from_dir = from;
    if (from_dir.len() > 1) {
      from_dir = slice_unchecked(from_dir, 0, from_dir.len() - 1).to_owned();
    }
    let mpath = util.resolve_path(ipath, from_dir, root);
    if (!util.has_str(done_paths, mpath)) {
      done_paths = done_paths.append(mpath);
      let rm = read_bundle_module(s, mpath, from, ipath);
      if (!rm.ok) {
        return Bundle { entry: entry_mod, entry_ident: "", root: root, loaded: no_mods, merged: entry_mod, pkgs: pkgs, package_roots: package_roots, files: files, maps: maps, srcs: srcs, errs: [load_diag("E086", unloaded_error(rm, ipath), at_line, at_col)] };
      }
      let mdir = modloader.dirname(util.clean_path(rm.shown));
      let origin = "";
      if (root.len() > 0 && rm.shown == mpath) {
        origin = ipath;
      }
      let m = parser.with_stdlib_origin(parser.parse_module(lexer.tokenize_from(rm.src, util.line_base(files.len()) + 1)), origin);
      let shown = display_path(rm.shown, root);
      if (rm.map.doc.len() > 0) {
        shown = display_path(rm.map.doc, root);
      }
      files = files.append(shown);
      maps = maps.append(rm.map);
      srcs = srcs.append(rm.src);
      m = flatten.resolve_imports(m, mdir, root);
      loaded = loaded.append(flatten.LoadedModule { name: util.module_name(ipath), ident: flatten.module_ident(mpath), mod: m });
      // Most modules share a few directories, so each one is searched once.
      let gi = util.index_of_str(gov_dirs, mdir);
      if (gi < 0) {
        gov_dirs = gov_dirs.append(mdir);
        govs = govs.append(governing_manifest(mdir));
        gi = govs.len() - 1;
      }
      let module_gov = govs[gi];
      if (module_gov.man.err.len() > 0) {
        return manifest_refused(Bundle { entry: entry_mod, entry_ident: "", root: root, loaded: no_mods, merged: entry_mod, pkgs: pkgs, package_roots: package_roots, files: files, maps: maps, srcs: srcs, errs: [] }, module_gov.dir, module_gov.man);
      }
      let module_at = module_package_at(mdir, module_gov, gov.dir, root_package, is_stdlib);
      module_packages = module_packages.append(module_at);
      let owner = module_at.dir;
      if (module_gov.found) {
        owner = module_at.owner_dir;
      }
      package_roots = package_roots.append(visibility.package_root(flatten.module_ident(mpath), root, owner));
      grant_mans = pkggrants.with_manifest(grant_mans, module_gov.dir, module_gov.man);
      q = queue_imports(q, m, mdir, root, fern_toml.dep_names(module_gov.man), is_stdlib);
    }
  }
  if (q.unrooted.len() > 0) {
    return Bundle { entry: entry_mod, entry_ident: "", root: root, loaded: no_mods, merged: entry_mod, pkgs: pkgs, package_roots: package_roots, files: files, maps: maps, srcs: srcs, errs: [load_diag("", "fern: import \"" + q.unrooted + "\" needs the stdlib root: pass its directory after the entry file", 0, 0)] };
  }
  let entry_r = flatten.resolve_imports(entry_mod, dir_slash, root);
  if let Some(imp) = flatten.import_cycle(entry_r, entry_ident, loaded, root) {
    return Bundle { entry: entry_mod, entry_ident: "", root: root, loaded: no_mods, merged: entry_mod, pkgs: pkgs, package_roots: package_roots, files: files, maps: maps, srcs: srcs, errs: [load_diag("E086", modloader.import_cycle_message(imp.path), imp.line, imp.col)] };
  }
  let prefixes = flatten.assign_prefixes(loaded);
  let checked = pkggrants.checked(grant_mans, root_package, module_packages, prefixes);
  pkgs = checked.pkgs;
  if (checked.refused.len() > 0) {
    return grants_refused(Bundle { entry: entry_mod, entry_ident: "", root: root, loaded: no_mods, merged: entry_mod, pkgs: pkgs, package_roots: package_roots, files: files, maps: maps, srcs: srcs, errs: [] }, checked.refused);
  }
  let reexports = visibility.reexport_diags(entry_r, loaded);
  if (reexports.len() > 0) {
    return Bundle { entry: entry_r, entry_ident: entry_ident, root: root, loaded: loaded, merged: entry_r, pkgs: pkgs, package_roots: package_roots, files: files, maps: maps, srcs: srcs, errs: reexports };
  }
  let merged = flatten.bundle_with_prefixes(entry_r, loaded, target, prefixes);
  merged = visibility.scope_enums(merged, prefixes, package_roots);

  merged = parser.fill_default_args_module(merged);
  merged = parser.resolve_variant_fields_module(merged);
  return Bundle { entry: entry_r, entry_ident: entry_ident, root: root, loaded: loaded, merged: merged, pkgs: pkgs, package_roots: package_roots, files: files, maps: maps, srcs: srcs, errs: [] };
}

function unloaded_error(rm: modloader.Resolved, ipath: string): string {
  if (rm.err.len() == 0 && util.is_stdlib_path(ipath)) {
    return modloader.unknown_stdlib_module(ipath);
  }
  return modloader.unresolved_import(ipath, rm.err_path, rm.err);
}

struct Loaded { b: Bundle, refused: Finding[] }

function load_checked(s: Sources, root: string, target: string, embed_dir: string): Loaded {
  let entry_mod = emitforms.entry_module(parser.parse_module(lexer.tokenize(s.srcs[0])), target);
  let b = load_bundle(s, entry_mod, root, target);
  if (b.errs.len() > 0) {
    return Loaded { b: b, refused: errors_of(b.errs) };
  }
  let imported = errors_of(asmcore.imported_parse_errors(flatten.modules(b.loaded)));
  if (imported.len() > 0) {
    return Loaded { b: b, refused: imported };
  }
  let (folded, fold_errs) = fold_embedded_assets(b, embed_dir);
  if (fold_errs.len() > 0) {
    return Loaded { b: b, refused: fold_errs };
  }
  let vis = visibility.export_diags(folded.entry, folded.entry_ident, folded.loaded, folded.package_roots);
  return Loaded { b: folded, refused: errors_of(vis) };
}

function parse_findings(mod: parser.Module): Finding[] {
  return errors_of(asmcore.parse_errors_before_check(mod));
}

function fold_embedded_assets(b: Bundle, embed_dir: string): (Bundle, Finding[]) {
  let assets = embed.no_assets();
  if (embed_dir.len() > 0) {
    match (embed.load(embed_dir)) {
      Ok(loaded) => {
        assets = loaded;
      },
      Err(message) => {
        return (b, [refusal("fern: " + message)]);
      }
    }
  }
  let folded = embed.fold_assets(b.merged, assets);
  let errs = errors_of(folded.errs);
  if (errs.len() > 0) {
    return (b, errs);
  }
  return (Bundle { ...b, merged: folded.module }, errs);
}

function check_source(entry_path: string, src: string, open: modloader.Buffers, root: string, target: string, target_given: boolean, embed_dir: string): Checked {
  return check_loaded(load_source(entry_path, src, open, root, target, embed_dir), entry_path, target, target_given);
}

function load_source(entry_path: string, src: string, open: modloader.Buffers, root: string, target: string, embed_dir: string): Loaded {
  let (s, err) = entry_sources(entry_path, src);
  if (err.len() > 0) {
    let none = parser.parse_module(lexer.tokenize(""));
    return Loaded { b: Bundle { entry: none, entry_ident: "", root: root, loaded: [], merged: none, pkgs: [], package_roots: [], files: [], maps: [], srcs: [], errs: [] }, refused: [refusal(err)] };
  }
  return load_checked(Sources { ...s, open: open }, root, target, embed_dir);
}

function check_loaded(ld: Loaded, entry_path: string, target: string, target_given: boolean): Checked {
  if (ld.refused.len() > 0) {
    return Checked { findings: ld.refused, entry: entry_path, files: ld.b.files, maps: ld.b.maps, ok: false };
  }
  return check_bundle(ld.b, entry_path, target, target_given);
}

function report_checked(st: DiagStyle, c: Checked): i32 {
  let _rejected = eprint_findings(st, c.findings, c.entry, c.files, c.maps);
  if (c.ok) {
    return 0;
  }
  return 1;
}

function executable_entry_diags(mod: parser.Module, target: string, shared: boolean, form: string): util.Diag[] {
  if (shared || form == "asm" || mod.top_stmts.len() > 0 || platforms.for_target(target).environment == "wasi-http") {
    return [];
  }
  if (platforms.for_target(target).isa == "wasm32" && mod.exports.len() > 0) {
    return [];
  }
  for fd in mod.funcs {
    if (fd.name == "main" && fd.receiver_name.len() == 0) {
      return [];
    }
  }
  return [util.Diag { code: "E001", message: "an executable requires a top-level `main` or `handle`", line: 1, col: 1, length: 0, related: [], fix: None }];
}

function check_bundle(b: Bundle, entry_path: string, target: string, target_given: boolean): Checked {
  let merged = b.merged;
  let parsed = parse_findings(merged);
  if (parsed.len() > 0) {
    return Checked { findings: parsed, entry: entry_path, files: b.files, maps: b.maps, ok: false };
  }
  let entry_diags = errors_of(flatten.handler_serve_diags(b.entry, target));
  if (entry_diags.len() > 0) {
    return Checked { findings: entry_diags, entry: entry_path, files: b.files, maps: b.maps, ok: false };
  }
  let mt = checker.check_module_with_file(merged, util.path_base(entry_display(entry_path)));
  let bounds = errors_of(platforms.provider_diags(merged));
  if (target_given) {
    bounds = errors_of(capability_diags(merged, target));
  }
  bounds = util.append_all(bounds, package_findings(merged, b.pkgs));
  bounds = util.append_all(bounds, errors_of(annotated_diags(merged)));
  let fs = util.append_all(errors_of(mt.diags), bounds);
  if (mt.all_well_typed) {
    if (has_error(bounds)) {
      return Checked { findings: fs, entry: entry_path, files: b.files, maps: b.maps, ok: false };
    }
    let views = errors_of(semlower.view_escape_diags(merged));
    if (views.len() > 0) {
      return Checked { findings: util.append_all(fs, views), entry: entry_path, files: b.files, maps: b.maps, ok: false };
    }
    return Checked { findings: util.append_all(fs, todo_warnings(merged.todo_sites, entry_path)), entry: entry_path, files: b.files, maps: b.maps, ok: true };
  }
  if (mt.diags.len() == 0) {
    fs = util.append_all(fs, errors_of(checker.ill_typed_hint(merged)));
  }
  return Checked { findings: fs, entry: entry_path, files: b.files, maps: b.maps, ok: false };
}

function todo_warnings(sites: parser.TodoSite[], entry_path: string): Finding[] {
  let name = entry_display(entry_path);
  let out: Finding[] = [];
  for site in sites {
    out = out.append(Finding { diag: util.Diag { related: [], length: 0, code: "W001", message: "`todo` stub remaining", line: site.line, col: site.col, fix: None }, warning: true, path: name });
  }
  return out;
}

function package_entry(dir: string): string {
  let lib = read_manifest(dir + "/").lib;
  if (file_readable(dir + "/" + lib)) {
    return dir + "/" + lib;
  }
  if (file_readable(dir + "/main.fern")) {
    return dir + "/main.fern";
  }
  return "";
}

function file_readable(path: string): boolean {
  match (read_file(path)) {
    Ok(s) => {
      return true;
    },
    Err(e) => {
      return false;
    }
  }
}

function interp_findings(merged: parser.Module, pkgs: caps.Pkg[]): Finding[] {
  return interp_findings_with_file(merged, pkgs, "");
}

function interp_findings_with_file(merged: parser.Module, pkgs: caps.Pkg[], entry_file: string): Finding[] {
  let fs = parse_findings(merged);
  if (!has_error(fs)) {
    fs = with_findings(fs, errors_of(checker.build_gate_diags_with_file(merged, entry_file)));
  }
  if (!has_error(fs)) {
    fs = with_findings(fs, package_findings(merged, pkgs));
  }
  if (!has_error(fs)) {
    fs = with_findings(fs, errors_of(annotated_diags(merged)));
  }
  return fs;
}

function with_findings(fs: Finding[], more: Finding[]): Finding[] {
  let out = fs;
  for f in more {
    out = out.append(f);
  }
  return out;
}

function interp_status(v: interp.Value): (i32, string) {
  let (is_status, status) = interp.exit_status(v);
  if (is_status) {
    return (status, "");
  }
  match (v) {
    interp.VErr(ev) => {
      if (ev.abort) {
        return (134, ev.msg);
      }
      if (ev.msg.len() == 0) {
        return (254, "");
      }
      return (254, "fern: interp: " + ev.msg);
    },
    _ => {
      return (254, "");
    }
  }
}

function run_repl(root: string, target: string): i32 {
  print("fern REPL — Ctrl+D to exit");
  let s = interp.new_session();
  if (root.len() > 0) {
    let ld = load_checked(Sources { paths: ["repl.fern"], srcs: ["import \"std/f64\";\n"], maps: [util.no_line_map()], open: modloader.no_buffers() }, root, target, "");
    if (ld.refused.len() == 0) {
      s = s.declare(ld.b.merged);
    }
  }
  let done = false;
  while (!done) {
    write("> ");
    match (io.read_line(stdin())) {
      Ok(Some(raw)) => {
        let line = raw.trim();
        if (line.len() > 0) {
          s = repl_line(s, line);
        }
      },
      Ok(None()) => {
        print("");
        done = true;
      },
      Err(e) => {
        eprint("fern: cannot read stdin: " + e.message());
        return 1;
      }
    }
  }
  return 0;
}

function repl_line(s: interp.Session, line: string): interp.Session {
  if (repl_declares(line)) {
    let m = parser.parse_module(lexer.tokenize(line));
    if (repl_parse_error(m)) {
      return s;
    }
    return s.declare(m);
  }
  let src = line;
  if (!src.ends_with(";") && !src.ends_with("}")) {
    src += ";";
  }
  let m = parser.parse_module(lexer.tokenize("function __repl(): void { " + src + " }"));
  if (repl_parse_error(m)) {
    return s;
  }
  let (next, shows, v) = s.run(m, "__repl");
  if (shows) {
    print(next.show(v));
  }
  return next;
}

function repl_declares(line: string): boolean {
  for kw in ["function ", "fn ", "pub ", "struct ", "enum ", "type "] {
    if (line.starts_with(kw)) {
      return true;
    }
  }
  return false;
}

function repl_parse_error(m: parser.Module): boolean {
  let fs = parse_findings(m);
  for f in fs {
    print("error: " + f.diag.message);
  }
  return fs.len() > 0;
}

function run_doctests(path: string, root: string, target: string, embed_dir: string): i32 {
  let (src, ok) = read_document(path);
  if (!ok) {
    return 1;
  }
  let tests: literate.Doctest[] = [];
  match (literate.doctests(src)) {
    literate.DoctestsOk(o) => {
      tests = o.tests;
    },
    literate.DoctestsErr(e) => {
      eprint_tangle_error(path, e.line, e.col, e.msg);
      return 1;
    }
  }
  write("1.." + util.i32_to_string(tests.len()) + "\n");
  if (tests.len() == 0) {
    eprint(path + ": no `test` blocks found");
    return 0;
  }
  let failed = 0;
  let n = 1;
  for tc in tests {
    let name = tc.name;
    if (name.len() == 0) {
      name = "doctest " + util.i32_to_string(n) + " (line " + util.i32_to_string(tc.line) + ")";
    }
    let why = run_doctest(path, tc, root, target, embed_dir);
    if (why.len() == 0) {
      write("ok " + util.i32_to_string(n) + " - " + name + "\n");
    } else {
      failed += 1;
      write("not ok " + util.i32_to_string(n) + " - " + name + "\n");
      for line in literate.split_lines(why) {
        write("# " + line + "\n");
      }
    }
    n += 1;
  }
  if (failed > 0) {
    return 1;
  }
  return 0;
}

function run_doctest(path: string, tc: literate.Doctest, root: string, target: string, embed_dir: string): string {
  let st = DiagStyle { color: false, ascii: false, terse: false, json: false };
  let srcs = Sources { paths: [path], srcs: [tc.code], maps: [util.LineMap { doc: path, lits: tc.lits, shifts: tc.shifts }], open: modloader.no_buffers() };
  let ld = load_checked(srcs, root, target, embed_dir);
  let fs = ld.refused;
  if (!has_error(fs)) {
    fs = with_findings(fs, interp_findings(ld.b.merged, ld.b.pkgs));
  }
  if (has_error(fs)) {
    let text = "";
    for f in fs {
      if (text.len() > 0) {
        text += "\n";
      }
      text += finding_text(st, f, path, ld.b.files, ld.b.maps);
    }
    return text;
  }
  let (status, why) = interp_status(interp.eval_module_argv(ld.b.merged, [path]));
  if (why.len() > 0) {
    return why;
  }
  if (status != 0) {
    return "example failed: main returned " + util.i32_to_string(status) + " (expected 0)";
  }
  return "";
}

function read_document(path: string): (string, boolean) {
  match (read_file(path)) {
    Ok(s) => {
      return (s, true);
    },
    Err(e) => {
      eprint("fern: cannot read " + path);
    }
  }
  return ("", false);
}

function warn_unused_chunks(path: string, src: string): void {
  let d = literate.parse(src);
  for name in literate.unused_chunks(src) {
    eprint(path + ":" + util.i32_to_string(literate.chunk_line(d, name)) + ":1: warning[W003]: chunk <<" + name + ">> is defined but never used");
  }
}

function run_tangle(path: string, out_path: string, chunk: string, weave_it: boolean, html: boolean): i32 {
  let (src, ok) = read_document(path);
  if (!ok) {
    return 1;
  }
  warn_unused_chunks(path, src);
  if (weave_it && html) {
    return write_generated(weave.weave_html(src), out_path);
  }
  if (weave_it) {
    return write_generated(weave.weave(src), out_path);
  }
  if (chunk.len() > 0) {
    match (literate.tangle_chunk(src, chunk)) {
      literate.TangleOk(o) => {
        return write_generated(end_with_newline(o.code), out_path);
      },
      literate.TangleErr(e) => {
        eprint_tangle_error(path, e.line, e.col, e.msg);
        return 1;
      }
    }
  }
  let files = literate.parse_file_pieces(src);
  if (files.len() > 0) {
    match (literate.tangle_files(src)) {
      literate.FileTangleOk(o) => {
        if (out_path.len() > 0) {
          return tangle_write_files(o.files, out_path);
        }
        let out = "";
        for i in 0..o.files.len() {
          if (i > 0) {
            out += "\n";
          }
          out = out + "// ==> " + o.files[i].path + " <==\n" + end_with_newline(o.files[i].code);
        }
        return write_generated(out, "");
      },
      literate.FileTangleErr(e) => {
        eprint_tangle_error(path, e.line, e.col, e.msg);
        return 1;
      }
    }
  }
  match (literate.tangle(src)) {
    literate.TangleOk(o) => {
      return write_generated(end_with_newline(o.code), out_path);
    },
    literate.TangleErr(e) => {
      eprint_tangle_error(path, e.line, e.col, e.msg);
      return 1;
    }
  }
}

function end_with_newline(code: string): string {
  if (code.len() > 0 && code[code.len() - 1] == b'\n') {
    return code;
  }
  return code + "\n";
}

function write_generated(code: string, out_path: string): i32 {
  if (out_path.len() == 0) {
    write(code);
    return 0;
  }
  let parent = util.dir_of(out_path);
  if (parent.len() > 0) {
    match (create_dir_all(parent)) {
      Ok(u) => {},
      Err(e) => {
        eprint("fern: cannot create output directory " + parent + ": " + e.message());
        return 1;
      }
    }
  }
  match (write_file(out_path, code)) {
    Ok(u) => {
      eprint("wrote " + out_path);
      return 0;
    },
    Err(e) => {
      eprint("fern: cannot write output " + out_path + ": " + e.message());
      return 1;
    }
  }
}

function tangle_write_files(files: literate.FileResult[], dir: string): i32 {
  for i in 0..files.len() {
    let rel = files[i].path;
    let code = write_generated(files[i].code, dir + "/" + rel);
    if (code != 0) {
      return code;
    }
  }
  return 0;
}

function run_doc(path: string, out_path: string, links: string): i32 {
  if (util.is_dir(path)) {
    return doc_tree(path, out_path, links);
  }
  let src = "";
  let read_ok = false;
  match (read_file(path)) {
    Ok(s) => {
      src = s;
      read_ok = true;
    },
    Err(e) => {}
  }
  if (!read_ok) {
    eprint("fern: -doc: cannot read " + path);
    return 1;
  }
  let (code, map, terr) = doc_source(path, src);
  if (terr.len() > 0) {
    eprint(terr);
    return 1;
  }
  let page = ferndoc.render_page(code, doc_module_path(path_base(util.dir_of(path)), doc_stem(path_base(path))), ferndoc.SourceLinks { template: links, path: path, map: map });
  if (out_path.len() == 0) {
    write(page);
    return 0;
  }
  match (write_file(out_path, page)) {
    Ok(u) => {
      return 0;
    },
    Err(e) => {
      eprint("fern: -doc: cannot write " + out_path + ": " + e.message());
      return 1;
    }
  }
}

function doc_tree(dir: string, out_dir: string, links: string): i32 {
  if (out_dir.len() == 0) {
    eprint("fern: -doc <DIR> needs -o OUTDIR — a directory of pages has nowhere else to go");
    return 2;
  }
  match (create_dir_all(out_dir)) {
    Ok(u) => {},
    Err(e) => {
      eprint("fern: -doc: cannot create " + out_dir + ": " + e.message());
      return 1;
    }
  }
  let ns = path_base(dir);
  let rels: string[] = [""];
  let ri = 0;
  let status = 0;
  while (ri < rels.len()) {
    let rel = rels[ri];
    ri += 1;
    let sdir = dir;
    if (rel.len() > 0) {
      sdir = dir + "/" + rel;
    }
    let entries: string[] = [];
    let listed = false;
    match (read_dir(sdir)) {
      Ok(ns2) => {
        entries = ns2;
        listed = true;
      },
      Err(e) => {}
    }
    if (!listed) {
      eprint("fern: -doc: cannot read " + sdir);
      return 1;
    }
    let i = 0;
    while (i < entries.len()) {
      let name = entries[i];
      i += 1;
      let child_rel = name + "";
      if (rel.len() > 0) {
        child_rel = rel + "/" + name;
      }
      let child = dir + "/" + child_rel;
      if (util.is_dir(child)) {
        if (name.len() > 0 && name[0] == b'.') {
          continue;
        }
        rels = rels.append(child_rel + "");
        continue;
      }
      if (!is_doc_module(name)) {
        continue;
      }
      if (is_literate(name) && util.has_str(entries, slice_unchecked(name, 0, name.len() - 3).to_owned())) {
        continue;
      }
      let src = "";
      let read_ok = false;
      match (read_file(child)) {
        Ok(s) => {
          src = s;
          read_ok = true;
        },
        Err(e) => {}
      }
      if (!read_ok) {
        eprint("fern: -doc: cannot read " + child);
        return 1;
      }
      if (is_literate(name) && !literate.is_program(src)) {
        continue;
      }
      let stem = doc_stem(child_rel);
      let (code, map, terr) = doc_source(child, src);
      if (terr.len() > 0) {
        eprint(terr);
        status = 1;
        continue;
      }
      let page = ferndoc.render_page(code, doc_module_path(ns, stem), ferndoc.SourceLinks { template: links, path: child, map: map });
      if (page.len() == 0) {
        continue;
      }
      let dest = out_dir + "/" + flatten_path(stem) + ".md";
      match (write_file(dest, page)) {
        Ok(u) => {},
        Err(e) => {
          eprint("fern: -doc: cannot write " + dest + ": " + e.message());
          return 1;
        }
      }
    }
  }
  return status;
}

function is_doc_module(name: string): boolean {
  if (!name.ends_with(".fern") && !is_literate(name)) {
    return false;
  }
  return !(name.len() >= 6 && name.starts_with("_test_"));
}

// The Fern source of a module, a literate one tangled, and the map from its
// lines to the lines of the file.
function doc_source(path: string, src: string): (string, util.LineMap, string) {
  let (mods, terr) = entry_sources(path, src);
  if (terr.len() > 0) {
    return ("", util.no_line_map(), terr);
  }
  return (mods.srcs[0], mods.maps[0], "");
}

function doc_stem(p: string): string {
  if (is_literate(p)) {
    return slice_unchecked(p, 0, p.len() - 8).to_owned();
  }
  if (p.len() >= 5 && p.ends_with(".fern")) {
    return slice_unchecked(p, 0, p.len() - 5).to_owned();
  }
  return p;
}

function doc_module_path(ns: string, stem: string): string {
  if (ns.len() == 0) {
    return stem;
  }
  return ns + "/" + stem;
}

function path_base(p: string): string {
  let end = p.len();
  while (end > 0 && p[end - 1] == b'/') {
    end -= 1;
  }
  let start = end;
  while (start > 0 && p[start - 1] != b'/') {
    start -= 1;
  }
  return slice_unchecked(p, start, end).to_owned();
}

function flatten_path(p: string): string {
  return p.replace("/", "_");
}

function check_dir(st: DiagStyle, dir: string, root: string, target: string, target_given: boolean, embed_dir: string): i32 {
  let mdir = find_manifest_dir(dir);
  if (mdir.len() == 0) {
    eprint("check: " + dir + " is a directory with no fern.toml — pass a .fern file, or run inside a package");
    return 1;
  }
  let man = read_manifest(mdir + "/");
  if (man.err.len() > 0) {
    eprint(manifest_error(mdir, man));
    return 1;
  }
  if (man.members.len() == 0) {
    let entry = package_entry(mdir);
    if (entry.len() == 0) {
      eprint("no entry module in " + mdir + " (looked for " + man.lib + " and main.fern)");
      return 1;
    }
    return check_file(st, entry, root, target, target_given, embed_dir);
  }
  let failed = 0;
  let i = 0;
  while (i < man.members.len()) {
    let rel = man.members[i];
    i += 1;
    let mem = rel;
    if (!mvs.is_abs(rel)) {
      mem = mvs.join_path(mdir, rel);
    }
    let mentry = package_entry(mem);
    if (mentry.len() == 0) {
      eprint("FAIL " + rel + ": no entry module in " + mem + " (looked for " + read_manifest(mem + "/").lib + " and main.fern)");
      failed += 1;
      continue;
    }
    if (check_file(st, mentry, root, target, target_given, embed_dir) != 0) {
      eprint("FAIL " + rel);
      failed += 1;
      continue;
    }
    eprint("ok   " + rel);
  }
  if (failed > 0) {
    eprint("check: " + util.i32_to_string(failed) + " of " + util.i32_to_string(man.members.len()) + " workspace member(s) failed");
    return 1;
  }
  eprint("check: " + util.i32_to_string(man.members.len()) + " workspace member(s) ok");
  return 0;
}

function check_file(st: DiagStyle, entry_path: string, root: string, target: string, target_given: boolean, embed_dir: string): i32 {
  match (read_source_file(entry_path, false)) {
    Ok(src) => {
      return report_checked(st, check_source(entry_path, src, modloader.no_buffers(), root, target, target_given, embed_dir));
    },
    Err(e) => {
      report_entry_read_failure(st, entry_path, e);
      return 1;
    }
  }
}

struct Server {
  root: string,
  stdlib: modloader.Buffers,
  target: string,
  target_given: boolean,
  embed_dir: string,
  uris: string[],
  srcs: string[],
  published: string[],
  docs: Doc[],
  shutdown: boolean,
}

struct Doc { loaded: boolean, prog: lspquery.Program, files: string[], maps: util.LineMap[] }

function serve_lsp(pos: string[], embedded_root: string, target: string, target_given: boolean, embed_dir: string): i32 {
  let root = embedded_root;
  if (pos.len() > 1 || pos.len() == 1 && root.len() > 0) {
    return usage(embedded_root.len() > 0);
  }
  if (pos.len() == 1) {
    root = util.clean_path(pos[0]);
  }
  return run_lsp(Server { root: root, stdlib: modloader.no_buffers(), target: target, target_given: target_given, embed_dir: embed_dir, uris: [], srcs: [], published: [], docs: [], shutdown: false });
}

pub function serve_lsp_in_memory(root: string, stdlib: modloader.Buffers, target: string, target_given: boolean): i32 {
  return run_lsp(Server { root: root, stdlib: stdlib, target: target, target_given: target_given, embed_dir: "", uris: [], srcs: [], published: [], docs: [], shutdown: false });
}

function run_lsp(s: Server): i32 {
  let inp = lsp.stdin_input();
  while (true) {
    let f = lsp.read_frame(inp);
    inp = f.inp;
    if (f.done) {
      if (f.err.len() > 0) {
        eprint("fern -lsp: " + f.err);
        return 2;
      }
      return 0;
    }
    match (lsp.parse_message(f.body)) {
      Some(m) => {
        if (m.method == "exit") {
          if (s.shutdown) {
            return 0;
          }
          return 1;
        }
        s = lsp_handle(s, m);
      },
      None => {}
    }
  }
}

function lsp_handle(s: Server, m: lsp.Message): Server {
  if (m.id.len() == 0) {
    return lsp_notification(s, m);
  }
  if (m.method == "initialize") {
    lsp.send(lsp.response(m.id, lsp.initialize_result()));
  } else if (m.method == "shutdown") {
    s = Server { ...s, shutdown: true };
    lsp.send(lsp.response(m.id, "null"));
  } else if (m.method == "textDocument/formatting") {
    lsp.send(lsp.response(m.id, lsp_formatting(s, lsp.document_uri(m.params))));
  } else if (m.method == "textDocument/codeAction") {
    lsp.send(lsp.response(m.id, lsp.code_actions(m.params)));
  } else if (lsp_answers(m.method)) {
    let (next, result) = lsp_query(s, m);
    s = next;
    lsp.send(lsp.response(m.id, result));
  } else {
    lsp.send(lsp.method_not_found(m.id, m.method));
  }
  return s;
}

function lsp_notification(s: Server, m: lsp.Message): Server {
  let uri = lsp.document_uri(m.params);
  if (m.method == "textDocument/didOpen") {
    return lsp_update(s, uri, lsp.get_string(lsp.get_value(m.params, "textDocument"), "text"));
  }
  if (m.method == "textDocument/didChange") {
    match (lsp.changed_text(m.params)) {
      Some(text) => {
        return lsp_update(s, uri, text);
      },
      None => {}
    }
    return s;
  }
  if (m.method == "textDocument/didClose") {
    return lsp_close(s, uri);
  }
  return s;
}

function lsp_update(s: Server, uri: string, src: string): Server {
  let i = util.index_of_str(s.uris, uri);
  if (i >= 0 && s.srcs[i] == src) {
    return s;
  }
  let opened = i < 0;
  if (opened) {
    s = Server { ...s, uris: s.uris.append(uri), srcs: s.srcs.append(src), published: s.published.append("") };
    i = s.uris.len() - 1;
  } else {
    s = Server { ...s, srcs: s.srcs.with(i, src) };
  }
  let path = lsp_doc_path(uri);
  let ld = load_source(path, src, lsp_buffers(s), s.root, s.target, s.embed_dir);
  let c = check_loaded(ld, path, s.target, s.target_given);
  if (opened) {
    s = Server { ...s, docs: s.docs.append(lsp_doc(ld)) };
  } else {
    s = Server { ...s, docs: s.docs.with(i, lsp_doc(ld)) };
  }
  let files = lsp_checked_files(c, s.root);
  s = lsp_publish(s, i, lsp_diagnostics(s, c, files, path, src));
  let j = 0;
  while (j < s.uris.len()) {
    let other = lsp_doc_path(s.uris[j]);
    if (j != i && other != "-" && util.has_str(files, other)) {
      s = lsp_publish(s, j, lsp_diagnostics(s, c, files, other, s.srcs[j]));
    }
    j += 1;
  }
  return s;
}

function lsp_publish(s: Server, i: i32, diags: string[]): Server {
  let ds = lsp.json_array(diags);
  if (ds == s.published[i]) {
    return s;
  }
  lsp.send(lsp.publish_diagnostics(s.uris[i], ds));
  return Server { ...s, published: s.published.with(i, ds) };
}

function lsp_doc_path(uri: string): string {
  let path = lsp.uri_path(uri);
  if (path.len() == 0) {
    return "-";
  }
  return util.clean_path(path);
}

function lsp_buffers(s: Server): modloader.Buffers {
  let b = s.stdlib;
  for i in 0..s.uris.len() {
    let path = lsp_doc_path(s.uris[i]);
    if (path != "-") {
      b = modloader.Buffers { paths: b.paths.append(path), srcs: b.srcs.append(s.srcs[i]) };
    }
  }
  return b;
}

function lsp_checked_files(c: Checked, root: string): string[] {
  let out: string[] = [c.entry];
  for f in c.files {
    if (root.len() > 0 && f.starts_with("stdlib://")) {
      out = out.append(util.clean_path(root + "/" + slice_unchecked(f, 9, f.len())));
    } else {
      out = out.append(util.clean_path(f));
    }
  }
  return out;
}

function lsp_close(s: Server, uri: string): Server {
  let uris: string[] = [];
  let srcs: string[] = [];
  let published: string[] = [];
  let docs: Doc[] = [];
  for i in 0..s.uris.len() {
    if (s.uris[i] != uri) {
      uris = uris.append(s.uris[i]);
      srcs = srcs.append(s.srcs[i]);
      published = published.append(s.published[i]);
      docs = docs.append(s.docs[i]);
    }
  }
  lsp.send(lsp.publish_diagnostics(uri, "[]"));
  return Server { ...s, uris: uris, srcs: srcs, published: published, docs: docs };
}

function lsp_doc(ld: Loaded): Doc {
  let b = ld.b;
  return Doc { loaded: b.errs.len() == 0, prog: lspquery.program(b.merged, b.entry, b.loaded, b.srcs), files: b.files, maps: b.maps };
}

function lsp_query(s: Server, m: lsp.Message): (Server, string) {
  let uri = lsp.document_uri(m.params);
  let i = util.index_of_str(s.uris, uri);
  if (i < 0 || !s.docs[i].loaded) {
    return (s, lsp_no_answer(m.method));
  }
  let d = Doc { ...s.docs[i], prog: lspquery.viewed(s.docs[i].prog) };
  s = Server { ...s, docs: s.docs.with(i, d) };
  let q = Asked { uri: uri, path: lsp_doc_path(uri), text: lsp.text_of(s.srcs[i]), d: d };
  if (m.method == "textDocument/documentSymbol") {
    return (s, lsp_symbols(q));
  }
  if (m.method == "textDocument/inlayHint") {
    return (s, lsp_inlay_hints(q, m));
  }
  if (m.method == "textDocument/semanticTokens/full") {
    return (s, lsp_semantic_tokens(q));
  }
  let (line, col) = lsp_request_position(q, m);
  if (line <= 0) {
    return (s, lsp_no_answer(m.method));
  }
  return (s, lsp_answer_at(s, q, m, line, col));
}

struct Asked { uri: string, path: string, text: lsp.Text, d: Doc }

function lsp_answers(method: string): boolean {
  return method == "textDocument/hover" || method == "textDocument/definition" || method == "textDocument/completion"
    || method == "textDocument/signatureHelp" || method == "textDocument/documentSymbol" || method == "textDocument/inlayHint"
    || method == "textDocument/references" || method == "textDocument/rename" || method == "textDocument/semanticTokens/full";
}

function lsp_no_answer(method: string): string {
  if (method == "textDocument/completion") {
    return lsp.completion_list([]);
  }
  if (method == "textDocument/semanticTokens/full") {
    return lsp.semantic_tokens([]);
  }
  if (method == "textDocument/documentSymbol" || method == "textDocument/inlayHint" || method == "textDocument/references") {
    return "[]";
  }
  return "null";
}

function lsp_request_position(q: Asked, m: lsp.Message): (i32, i32) {
  let (pl, pc) = lsp.position(m.params);
  if (pl < 0) {
    return (0, 0);
  }
  return lsp_into_bundle(q.d, q.path, pl + 1, lsp.byte_col(lsp.line_text(q.text, pl + 1), pc));
}

function lsp_answer_at(s: Server, q: Asked, m: lsp.Message, line: i32, col: i32): string {
  let method = m.method;
  if (method == "textDocument/references") {
    return lsp_references(s, q, lsprefs.references(q.d.prog, line, col), lsp.include_declaration(m.params));
  }
  if (method == "textDocument/rename") {
    return lsp_rename(s, q, lsprefs.references(q.d.prog, line, col), lsp.get_string(m.params, "newName"));
  }
  if (method == "textDocument/completion") {
    return lsp_completion(lspassist.completion(q.d.prog, line, col));
  }
  if (method == "textDocument/signatureHelp") {
    let sh: lspassist.Signature = match (lspassist.signature_help(q.d.prog, line, col)) { Some(value) => value, None => { return "null"; } };
    return lsp.signature_help(sh.label, sh.starts, sh.ends, sh.active);
  }
  if (method == "textDocument/hover") {
    let h: lspquery.Hover = match (lspquery.hover(q.d.prog, line, col)) { Some(value) => value, None => { return "null"; } };
    return lsp.hover_result(h.text, lspquery.hover_doc(q.d.prog, line, col), lsp_answer_range(q.d, q.text, h.line, h.col, h.len));
  }
  return lsp_definition(s, q, line, col);
}

function lsp_definition(s: Server, q: Asked, line: i32, col: i32): string {
  let a: lspquery.SourceSpan = match (lspquery.definition(q.d.prog, line, col)) { Some(value) => value, None => { return "null"; } };
  let target = lsp_module_doc(s, q.d, util.pos_file_index(a.line), q.path);
  if (target == q.path) {
    return lsp.location(q.uri, lsp_answer_range(q.d, q.text, a.line, a.col, a.len));
  }
  return lsp.location(lsp.file_uri(target), lsp_answer_range(q.d, lsp.text_of(lsp_doc_text(s, target)), a.line, a.col, a.len));
}

function lsp_references(s: Server, q: Asked, refs: lsprefs.Ref[], with_decl: boolean): string {
  let out: string[] = [];
  let at = ref_doc_none();
  for r in refs {
    at = lsp_ref_doc(s, q, at, util.pos_file_index(r.line));
    let range = lsp_ref_range(q, at, r);
    if ((with_decl || !r.decl) && range.len() > 0) {
      out = out.append(lsp.location(at.uri, range));
    }
  }
  return lsp.json_array(out);
}

function lsp_rename(s: Server, q: Asked, refs: lsprefs.Ref[], name: string): string {
  let declared = false;
  for r in refs {
    declared = declared || r.decl;
  }
  if (!declared || !lsp_identifier(name)) {
    return "null";
  }
  let uris: string[] = [];
  let edits: string[][] = [];
  let at = ref_doc_none();
  for r in refs {
    at = lsp_ref_doc(s, q, at, util.pos_file_index(r.line));
    if (at.stdlib) {
      return "null";
    }
    let range = lsp_ref_range(q, at, r);
    let i = util.index_of_str(uris, at.uri);
    if (range.len() > 0 && i < 0) {
      uris = uris.append(at.uri);
      edits = edits.append([lsp.text_edit(range, name)]);
    } else if (range.len() > 0) {
      edits = edits.with(i, edits[i].append(lsp.text_edit(range, name)));
    }
  }
  return lsp.workspace_edit(uris, edits);
}

function lsp_identifier(name: string): boolean {
  return util.is_ident(name) && !util.has_str(lexer.keywords(), name);
}

struct RefDoc { m: i32, uri: string, text: lsp.Text, stdlib: boolean }

function ref_doc_none(): RefDoc {
  return RefDoc { m: -1, uri: "", text: lsp.text_of(""), stdlib: false };
}

function lsp_ref_doc(s: Server, q: Asked, at: RefDoc, m: i32): RefDoc {
  if (at.m == m) {
    return at;
  }
  let path = lsp_module_doc(s, q.d, m, q.path);
  let stdlib = display_path(path, s.root).starts_with("stdlib://") || m > 0 && m <= q.d.files.len() && q.d.files[m - 1].starts_with("stdlib://");
  if (path == q.path) {
    return RefDoc { m: m, uri: q.uri, text: q.text, stdlib: stdlib };
  }
  return RefDoc { m: m, uri: lsp.file_uri(path), text: lsp.text_of(lsp_doc_text(s, path)), stdlib: stdlib };
}

function lsp_ref_range(q: Asked, at: RefDoc, r: lsprefs.Ref): string {
  let (line, col) = util.doc_pos(q.d.maps, r.line, r.col);
  if (line == 0) {
    return "";
  }
  return lsp.span_range(at.text, util.pos_line(line), col, r.len);
}

function lsp_completion(items: lspassist.Item[]): string {
  let out: string[] = [];
  for it in items {
    out = out.append(lsp.completion_item(it.label, it.kind, it.detail));
  }
  return lsp.completion_list(out);
}

function lsp_doc_modules(d: Doc, path: string): i32[] {
  if (d.maps.len() > 0 && d.maps[0].doc.len() == 0) {
    return [0];
  }
  let out: i32[] = [];
  for m in 0..d.maps.len() {
    if (d.maps[m].doc == path) {
      out = out.append(m);
    }
  }
  return out;
}

function lsp_symbols(q: Asked): string {
  let out: string[] = [];
  for m in lsp_doc_modules(q.d, q.path) {
    for sym in lspassist.symbols(q.d.prog, m) {
      out = out.append(lsp_symbol(q, sym));
    }
  }
  return lsp.json_array(out);
}

function lsp_symbol(q: Asked, sym: lspassist.Symbol): string {
  let children: string[] = [];
  for c in sym.children {
    children = children.append(lsp_symbol(q, c));
  }
  let range = lsp_doc_span(q, sym.line, sym.col, sym.end_line, sym.end_col);
  let selection = lsp_doc_span(q, sym.name_line, sym.name_col, sym.name_line, sym.name_col + sym.name.len());
  return lsp.document_symbol(sym.name, sym.detail, sym.kind, range, selection, children);
}

function lsp_doc_span(q: Asked, l0: i32, c0: i32, l1: i32, c1: i32): string {
  let (al, ac) = util.doc_pos(q.d.maps, l0, c0);
  let (bl, bc) = util.doc_pos(q.d.maps, l1, c1);
  if (bl == 0) {
    bl = al;
    bc = ac;
  }
  return lsp.span_between(q.text, util.pos_line(al), ac, util.pos_line(bl), bc);
}

function lsp_inlay_hints(q: Asked, m: lsp.Message): string {
  let (l0, c0, l1, c1) = lsp.request_range(m.params);
  let out: string[] = [];
  if (l0 < 0) {
    return lsp.json_array(out);
  }
  for mi in lsp_doc_modules(q.d, q.path) {
    let (lo, hi) = lsp_bundle_lines(q.d, mi, l0 + 1, l1 + 1);
    for h in lspassist.inlay_hints(q.d.prog, mi, lo, hi) {
      let (al, ac) = util.doc_pos(q.d.maps, h.line, h.col);
      let (hl, hc) = lsp.lsp_position(q.text, util.pos_line(al), ac);
      if (al > 0 && lsp_in_range(hl, hc, l0, c0, l1, c1)) {
        out = out.append(lsp.inlay_hint(hl, hc, h.label));
      }
    }
  }
  return lsp.json_array(out);
}

function lsp_semantic_tokens(q: Asked): string {
  let out: lsp.SemanticToken[] = [];
  for mi in lsp_doc_modules(q.d, q.path) {
    for t in lsptokens.semantic_tokens(q.d.prog, mi) {
      let (line, col) = util.doc_pos(q.d.maps, t.line, t.col);
      if (line > 0) {
        let text = lsp.line_text(q.text, util.pos_line(line));
        let start = lsp.utf16_col(text, col);
        out = out.append(lsp.SemanticToken { line: util.pos_line(line) - 1, start: start, len: lsp.utf16_col(text, col + t.len) - start, kind: t.kind });
      }
    }
  }
  return lsp.semantic_tokens(out);
}

function lsp_bundle_lines(d: Doc, m: i32, first: i32, last: i32): (i32, i32) {
  let base = util.line_base(m - 1);
  if (d.maps[m].doc.len() == 0) {
    return (base + first, base + last);
  }
  let lo = 0;
  let hi: i32 = -1;
  let k = 0;
  while (k < d.maps[m].lits.len()) {
    let lit = d.maps[m].lits[k];
    if (lit >= first && lit <= last) {
      if (hi < lo) {
        lo = base + k + 1;
      }
      hi = base + k + 1;
    }
    k += 1;
  }
  return (lo, hi);
}

function lsp_in_range(line: i32, ch: i32, l0: i32, c0: i32, l1: i32, c1: i32): boolean {
  if (line < l0 || line > l1) {
    return false;
  }
  return !(line == l0 && ch < c0 || line == l1 && ch > c1);
}

function lsp_into_bundle(d: Doc, path: string, line: i32, col: i32): (i32, i32) {
  for m in 0..d.maps.len() {
    let lm = d.maps[m];
    if (lm.doc == path) {
      let k = util.index_of_i32(lm.lits, line);
      if (k >= 0) {
        return (util.line_base(m - 1) + k + 1, col + lm.shifts[k]);
      }
    }
  }
  if (d.maps.len() > 0 && d.maps[0].doc.len() == 0) {
    return (line, col);
  }
  return (0, 0);
}

function lsp_answer_range(d: Doc, text: lsp.Text, line: i32, col: i32, width: i32): string {
  let (al, ac) = util.doc_pos(d.maps, line, col);
  return lsp.span_range(text, util.pos_line(al), ac, width);
}

function lsp_module_doc(s: Server, d: Doc, m: i32, entry: string): string {
  if (m < d.maps.len() && d.maps[m].doc.len() > 0) {
    return d.maps[m].doc;
  }
  if (m == 0 || m > d.files.len()) {
    return entry;
  }
  let f = d.files[m - 1];
  let std = "stdlib://";
  if (f.starts_with(std)) {
    return util.clean_path(s.root + "/" + slice_unchecked(f, std.len(), f.len()));
  }
  return util.clean_path(f);
}

function lsp_doc_text(s: Server, path: string): string {
  for i in 0..s.uris.len() {
    if (lsp_doc_path(s.uris[i]) == path) {
      return s.srcs[i];
    }
  }
  let si = util.index_of_str(s.stdlib.paths, path);
  if (si >= 0) {
    return s.stdlib.srcs[si];
  }
  match (read_file(path)) {
    Ok(text) => {
      return text;
    },
    Err(_) => {}
  }
  return "";
}

function lsp_diagnostics(s: Server, c: Checked, files: string[], path: string, text: string): string[] {
  let t = lsp.text_of(text);
  let out: string[] = [];
  for f in by_position(c.findings, c.maps) {
    let d = util.doc_diag(c.maps, f.diag);
    let m = util.pos_file_index(d.line);
    if (m < files.len() && files[m] == path) {
      out = out.append(lsp.diagnostic_with_related(t, util.pos_line(d.line), d.col, d.code, lsp_message(d.message), f.warning, lsp_fix_data(t, d), lsp_related(s, files, d.related)));
    }
  }
  return out;
}

function lsp_related(s: Server, files: string[], related: util.Related[]): string[] {
  let out: string[] = [];
  for r in related {
    let m = util.pos_file_index(r.line);
    if (m < files.len()) {
      let path = files[m];
      out = out.append(lsp.related_information(lsp.file_uri(path), lsp.text_of(lsp_doc_text(s, path)), r));
    }
  }
  return out;
}

function lsp_fix_data(t: lsp.Text, d: util.Diag): string {
  if let Some(f) = d.fix {
    let col = util.ident_from(lsp.line_text(t, util.pos_line(f.line)), f.col, f.old);
    if (col > 0) {
      return lsp.fix_data(lsp.span_range(t, util.pos_line(f.line), col, f.old.len()), f.new_text, f.title);
    }
  }
  return "";
}

function lsp_message(msg: string): string {
  if (msg.len() > 6 && msg.starts_with("fern: ")) {
    return slice_unchecked(msg, 6, msg.len()).to_owned();
  }
  return msg;
}

function lsp_formatting(s: Server, uri: string): string {
  let i = util.index_of_str(s.uris, uri);
  if (i < 0) {
    return "[]";
  }
  let src = s.srcs[i];
  let (formatted, errs) = format_text(uri, src);
  if (errs.len() > 0 || formatted == src || !fmt_output_is_readable(uri, src, formatted)) {
    return "[]";
  }
  return "[" + lsp.whole_document_edit(src, formatted) + "]";
}

function root_pkg(man: fern_toml.Manifest, dir: string): caps.Pkg {
  let name = "(root)";
  if (man.name.len() > 0) {
    name = man.name;
  }
  let no_grants: string[] = [];
  return caps.Pkg { module: "", dir: dir, name: name, root: true, governed: false, grants: no_grants };
}

function package_findings(merged: parser.Module, pkgs: caps.Pkg[]): Finding[] {
  let out: Finding[] = [];
  if (!caps.enforceable(merged, pkgs)) {
    return out;
  }
  let vs = caps.enforce(caps.analyze(checker.annotate_module(merged), pkgs), pkgs);
  for v in vs {
    if (!v.governed) {
      out = out.append(Finding { diag: util.Diag { ...violation_diag(merged, v), code: "W002" }, warning: true, path: "" });
    }
  }
  for v in vs {
    if (v.governed) {
      out = out.append(Finding { diag: violation_diag(merged, v), warning: false, path: "" });
    }
  }
  return out;
}

function violation_diag(merged: parser.Module, v: caps.Violation): util.Diag {
  let line = 0;
  let col = 0;
  if (v.chain.len() > 0) {
    let fi = caps.func_index(merged, v.chain[0]);
    if (fi >= 0) {
      line = merged.funcs[fi].line;
      col = merged.funcs[fi].col;
    }
  }
  let shown = caps.Violation { ...v, chain: caps.source_chain(merged, v.chain) };
  return util.Diag { related: [], length: 0, code: "E070", message: caps.violation_message(shown), line: line, col: col, fix: None };
}

function find_on_path(name: string): string {
  match (env("PATH")) {
    Some(path) => {
      let start = 0;
      for i in 0..=path.len() {
        if (i == path.len() || path[i] == b':') {
          if (i > start) {
            let cand = slice_unchecked(path, start, i) + "/" + name;
            if let Ok(_) = access(cand, 1) {
              return cand;
            }
          }
          start = i + 1;
        }
      }
    },
    None => {}
  }
  return "";
}

function exec_and_wait(path: string, argv: string[]): i32 {
  let rest: string[] = [];
  for i in 1..argv.len() {
    rest = rest.append(argv[i]);
  }
  let pid = proc_fork();
  if (pid < 0) {
    eprint("fern: -run: cannot start " + path + " (fork failed: " + util.i32_to_string(-pid) + ")");
    return 1;
  }
  if (pid == 0) {
    let rc = proc_exec(path, rest);
    eprint("fern: -run: cannot execute " + path + " (" + util.i32_to_string(-rc) + ")");
    exit(127);
  }
  return proc_waitpid(pid);
}

function run_built(target: string, out: string, prog_args: string[], qemu: string): i32 {
  let desc = platforms.for_target(target);
  if (desc.isa == "wasm32") {
    let wt = find_on_path("wasmtime");
    if (wt.len() == 0) {
      eprint("fern: -run: wasmtime is not on PATH");
      return 1;
    }
    let argv: string[] = [wt, "run", out];
    for a in prog_args {
      argv = argv.append(a);
    }
    return exec_and_wait(wt, argv);
  }
  let argv: string[] = [out];
  for a in prog_args {
    argv = argv.append(a);
  }
  if (desc.isa == target_arch() && desc.environment == target_os()) {
    return exec_and_wait(out, argv);
  }
  if (desc.environment == "darwin") {
    eprint("fern: -run: a Mach-O binary runs only on Apple Silicon macOS; the output at " + out + " is ready to run there");
    return 1;
  }
  let emu = qemu;
  if (desc.isa == "x86-64" && emu == "qemu-aarch64") {
    emu = "qemu-x86_64";
  }
  let emu_path = emu;
  if (util.last_slash(emu) < 0) {
    emu_path = find_on_path(emu);
  }
  if (emu_path.len() == 0) {
    eprint("fern: -run: " + emu + " is not on PATH (pass -qemu to name the emulator)");
    return 1;
  }
  let qargv: string[] = [emu_path];
  for a in argv {
    qargv = qargv.append(a);
  }
  return exec_and_wait(emu_path, qargv);
}

function print_version(root: string): i32 {
  let commit = "(unknown build)";
  if (root.len() > 0) {
    if let Ok(v) = read_file(root + "/VERSION") {
      commit = v.trim();
    }
  }
  write("fern " + commit + "\nbuilt for " + target_arch() + "-" + target_os() + "\n");
  return 0;
}

function explain_cli(pos: string[], embedded_root: string, code: string): i32 {
  if (pos.len() > 1 || pos.len() == 1 && embedded_root.len() > 0) {
    return usage(embedded_root.len() > 0);
  }
  if (pos.len() == 1) {
    return explain(explanations_dir(util.clean_path(pos[0])), code);
  }
  if (embedded_root.len() == 0) {
    eprint("fern: -explain: this build carries no explanations: pass the stdlib root after the code (-explain CODE STDLIB, or -explain= STDLIB to list the codes)");
    return 2;
  }
  return explain(embedded_root + "/explanations", code);
}

function explanations_dir(root: string): string {
  if let Ok(_) = read_dir(root + "/explanations") {
    return root + "/explanations";
  }
  return util.clean_path(root + "/../syntax/diag/explanations");
}

function explain(dir: string, code: string): i32 {
  let codes: string[] = [];
  if let Ok(names) = read_dir(dir) {
    for n in names {
      if (n.len() > 3 && n.ends_with(".md")) {
        codes = literate.insert_sorted(codes, slice_unchecked(n, 0, n.len() - 3).to_owned());
      }
    }
  }
  if (codes.len() == 0) {
    eprint("fern: -explain: no explanations under " + dir);
    return 1;
  }
  if (code.len() == 0) {
    let listing = "";
    for c in codes {
      listing = listing + c + "\n";
    }
    write(listing);
    return 0;
  }
  let canonical = code.trim().to_upper();
  match (read_file(dir + "/" + canonical + ".md")) {
    Ok(body) => {
      write(explain_text(canonical, body));
      return 0;
    },
    Err(_) => {
      let avail = "";
      for c in codes {
        if (avail.len() > 0) {
          avail += " ";
        }
        avail += c;
      }
      eprint("unknown error code \"" + code + "\"\navailable codes: [" + avail + "]");
      return 1;
    }
  }
}

function explain_text(canonical: string, body: string): string {
  let header = "error " + canonical + ":";
  if (isatty(1)) {
    match (env("NO_COLOR")) {
      Some(_) => {},
      None => {
        header = "\x1b[1;31m" + header + "\x1b[0m";
      }
    }
  }
  let heading = "# " + canonical + " — ";
  let nl = util.index_of_sub(body, "\n");
  if (nl <= heading.len() || !body.starts_with(heading)) {
    return header + "\n\n" + body + "\n";
  }
  let at = nl;
  while (at < body.len() && body[at] == b'\n') {
    at += 1;
  }
  return header + " " + slice_unchecked(body, heading.len(), nl) + "\n\n" + slice_unchecked(body, at, body.len()) + "\n";
}

function cover_report(path: string, have_path: boolean, as_lcov: boolean): i32 {
  if (!have_path) {
    eprint("usage: fern -cover-report [-lcov] FILE   (FILE is a saved -cover run's stderr, or - for stdin)");
    return 2;
  }
  let text = "";
  if (path == "-") {
    match (io.read_all_stdin()) {
      Ok(t) => {
        text = t;
      },
      Err(e) => {
        eprint("fern: -cover-report: cannot read stdin: " + e.message());
        return 1;
      }
    }
  } else {
    match (read_file(path)) {
      Ok(t) => {
        text = t;
      },
      Err(e) => {
        eprint("fern: -cover-report: cannot read " + path + ": " + e.message());
        return 1;
      }
    }
  }
  let (out, err) = coverreport.report(text, as_lcov);
  if (err.len() > 0) {
    eprint("fern: -cover-report: " + err);
    return 1;
  }
  write(out);
  return 0;
}

struct ToolFlags {
  run_it: boolean,
  qemu: string,
  version: boolean,
  explain: boolean,
  explain_code: string,
  cover_report: boolean,
  lcov: boolean,
  color_mode: string,
  ascii: boolean,
  diag_format: string,
  lint: boolean,
  lint_rules: boolean,
  lint_sets: string[],
  lint_opts: string[],
  lint_cover: string,
  weave: boolean,
  html: boolean,
  doctest: boolean,
}

function tool_flag(f: CliArg): boolean {
  return f.name == "-run" || f.name == "-qemu" || f.name == "-version" || f.name == "-explain"
    || f.name == "-cover-report" || f.name == "-lcov" || f.name == "-color" || f.name == "-ascii"
    || f.name == "-q" || f.name == "-diag-format" || f.name == "-lint" || f.name == "-lint-rules" || f.name == "-lint-set"
    || f.name == "-lint-opt" || f.name == "-lint-cover" || f.name == "-weave" || f.name == "-html"
    || f.name == "-doctest";
}

function parse_tool_flag(tf: ToolFlags, f: CliArg): (ToolFlags, i32) {
  if (f.name == "-run") {
    return (ToolFlags { ...tf, run_it: f.on }, 0);
  }
  if (f.name == "-version") {
    return (ToolFlags { ...tf, version: f.on }, 0);
  }
  if (f.name == "-cover-report") {
    return (ToolFlags { ...tf, cover_report: f.on }, 0);
  }
  if (f.name == "-lcov") {
    return (ToolFlags { ...tf, lcov: f.on }, 0);
  }
  if (f.name == "-ascii") {
    return (ToolFlags { ...tf, ascii: f.on }, 0);
  }
  if (f.name == "-q") {
    let format: string = if (f.on) { "terse" } else { "full" };
    return (ToolFlags { ...tf, diag_format: format }, 0);
  }
  if (f.name == "-diag-format") {
    if (f.value != "full" && f.value != "terse" && f.value != "json") {
      eprint("fern: -diag-format wants full, terse or json (got \"" + f.value + "\")");
      return (tf, 2);
    }
    return (ToolFlags { ...tf, diag_format: f.value }, 0);
  }
  if (f.name == "-lint") {
    return (ToolFlags { ...tf, lint: f.on }, 0);
  }
  if (f.name == "-lint-rules") {
    return (ToolFlags { ...tf, lint_rules: f.on }, 0);
  }
  if (f.name == "-weave") {
    return (ToolFlags { ...tf, weave: f.on }, 0);
  }
  if (f.name == "-html") {
    return (ToolFlags { ...tf, html: f.on }, 0);
  }
  if (f.name == "-doctest") {
    return (ToolFlags { ...tf, doctest: f.on }, 0);
  }
  if (f.name == "-lint-set") {
    return (ToolFlags { ...tf, lint_sets: tf.lint_sets.append(f.value) }, 0);
  }
  if (f.name == "-lint-opt") {
    return (ToolFlags { ...tf, lint_opts: tf.lint_opts.append(f.value) }, 0);
  }
  if (f.name == "-lint-cover") {
    return (ToolFlags { ...tf, lint_cover: f.value }, 0);
  }
  if (f.name == "-qemu") {
    return (ToolFlags { ...tf, qemu: f.value }, 0);
  }
  if (f.name == "-explain") {
    return (ToolFlags { ...tf, explain: true, explain_code: f.value }, 0);
  }
  if (f.value != "auto" && f.value != "always" && f.value != "never") {
    eprint("fern: -color wants auto, always or never (got \"" + f.value + "\")");
    return (tf, 2);
  }
  return (ToolFlags { ...tf, color_mode: f.value }, 0);
}

pub function target_refusal(target: string): string {
  if (platforms.for_target(target).known) {
    return "";
  }
  let msg = "fern: unknown -target: " + target + " (want one of:";
  for t in platforms.targets() {
    msg = msg + " " + t;
  }
  return msg + ")";
}

pub function emit_refusal(target: string, emit: string): string {
  if (emit == "command-module" && target != "wasm32-wasi") {
    return "fern: -emit command-module is not available for -target " + target + " (available for: wasm32-wasi)";
  }
  if (emit.len() > 0 && emit != "asm" && emit != "core-module" && emit != "command-module" && emit != "image") {
    return "fern: unknown -emit: " + emit + " (want asm, core-module, command-module, image, or omit it for the target's default output form)";
  }
  if (emit == "image" && target != "arm64-kernel") {
    return "fern: -emit image is the arm64 Linux Image form of -target arm64-kernel; -target " + target + " has no image form";
  }
  if (emit == "core-module" && platforms.for_target(target).isa != "wasm32") {
    return "fern: -emit core-module is a wasm output form; -target " + target + " has no core module to emit";
  }
  return "";
}

function output_form(target: string, emit: string, has_out: boolean): (string, string) {
  if (is_freestanding(target) && has_out && emit != "asm") {
    return ("", "-target " + target + " writes assembly only; pass -emit asm");
  }
  if (has_out || emit == "asm") {
    return (core_form(emit), "");
  }
  if (platforms.for_target(target).isa != "wasm32") {
    return ("asm", "");
  }
  if (emit.len() > 0) {
    return ("", "-emit " + emit + " for -target " + target + " writes a binary; pass -o OUTPUT");
  }
  return ("", "-target " + target + " requires -o OUTPUT (the component is a binary)");
}

pub function core_form(emit: string): string {
  if (emit == "command-module") {
    return "core-module";
  }
  return emit;
}

function run_output(target: string, emit: string, shared: boolean, out_path: string): (string, string, i32) {
  if (emit == "asm" || shared) {
    eprint("fern: -run executes the built program; it cannot be combined with -emit asm or -shared");
    return ("", "", 2);
  }
  if (target == "wasm32-wasi-http") {
    eprint("fern: -run cannot serve -target wasm32-wasi-http; build it with -o OUT.wasm and run `wasmtime serve OUT.wasm`");
    return ("", "", 2);
  }
  if (is_hostless(target)) {
    eprint("fern: -run cannot run -target " + target + ": the target has no host to run it on");
    return ("", "", 2);
  }
  if (out_path.len() > 0) {
    return (out_path, "", 0);
  }
  let tmp = "/tmp";
  match (env("TMPDIR")) {
    Some(t) => {
      if (t.len() > 0) {
        tmp = t;
      }
    },
    None => {}
  }
  let suffix = "";
  for rb in rand.bytes(6) {
    suffix += util.i32_to_string(rb as i32);
  }
  let dir = tmp + "/fern-run-" + suffix;
  match (create_dir_all(dir)) {
    Ok(_) => {},
    Err(e) => {
      eprint("fern: -run: cannot create " + dir + ": " + e.message());
      return ("", "", 1);
    }
  }
  let out = dir + "/prog";
  if (platforms.for_target(target).isa == "wasm32") {
    out += ".wasm";
  }
  return (out, dir, 0);
}

function run_and_clean(target: string, out: string, dir: string, prog_args: string[], qemu: string): i32 {
  let status = run_built(target, out, prog_args, qemu);
  if (dir.len() > 0) {
    let _ = remove_file(out);
    let _ = remove_dir(dir);
  }
  return status;
}

function source_files(paths: string[]): (string[], boolean[], string) {
  let out: string[] = [];
  let walked: boolean[] = [];
  for p in paths {
    if (util.is_dir(p)) {
      for f in dir_sources(p) {
        if (!util.has_str(out, f)) {
          out = out.append(f);
          walked = walked.append(true);
        }
      }
      continue;
    }
    if (p != "-" && !p.ends_with(".fern") && !is_literate(p)) {
      let no: string[] = [];
      let none: boolean[] = [];
      if let Err(e) = read_file(p) {
        return (no, none, p + ": " + e.message());
      }
      return (no, none, p + ": not a .fern source");
    }
    if (!util.has_str(out, p)) {
      out = out.append(p);
      walked = walked.append(false);
    }
  }
  return (out, walked, "");
}

function dir_sources(dir: string): string[] {
  let base = dir;
  while (base.len() > 1 && base[base.len() - 1] == b'/') {
    base = slice_unchecked(base, 0, base.len() - 1).to_owned();
  }
  let out: string[] = [];
  let todo: string[] = [base];
  let ti = 0;
  while (ti < todo.len()) {
    let d = todo[ti];
    ti += 1;
    if let Ok(names) = read_dir(d) {
      for n in names {
        let child = d + "/" + n;
        if (util.is_dir(child)) {
          todo = todo.append(child);
        } else if (n.ends_with(".fern") || is_literate(n)) {
          out = out.append(child);
        }
      }
    }
  }
  let i = 1;
  while (i < out.len()) {
    let f = out[i];
    let j = i - 1;
    while (j >= 0 && util.str_less(f, out[j])) {
      out = out.with(j + 1, out[j]);
      j -= 1;
    }
    out = out.with(j + 1, f);
    i += 1;
  }
  return out;
}

function lint_config(first: string, sets: string[], opts: string[]): (lint.Config, string) {
  let c = lint.default_config();
  let dir = util.dir_of(first);
  if (dir.len() > 0) {
    dir += "/";
  }
  let g = governing_manifest(dir);
  let mpath = g.dir + "fern.toml";
  if (g.man.err.len() > 0) {
    return (c, fern_toml.diagnostic(mpath, g.man));
  }
  let keys: string[] = [];
  let vals: string[] = [];
  let i = 0;
  while (i < g.man.lint_keys.len()) {
    let k = g.man.lint_keys[i];
    let at = keys.len();
    while (at > 0 && util.str_less(k, keys[at - 1])) {
      at -= 1;
    }
    let nk: string[] = [];
    let nv: string[] = [];
    for j in 0..keys.len() {
      if (j == at) {
        nk = nk.append(k);
        nv = nv.append(g.man.lint_vals[i]);
      }
      nk = nk.append(keys[j]);
      nv = nv.append(vals[j]);
    }
    if (at == keys.len()) {
      nk = nk.append(k);
      nv = nv.append(g.man.lint_vals[i]);
    }
    keys = nk;
    vals = nv;
    i += 1;
  }
  for i in 0..keys.len() {
    let (nc, err) = lint.set_pair(c, keys[i], vals[i]);
    if (err.len() > 0) {
      return (c, mpath + ": " + err);
    }
    c = nc;
  }
  for sv in sets {
    let eq = util.index_of_sub(sv, "=");
    if (eq < 0) {
      return (c, "-lint-set \"" + sv + "\" must be spelled RULE=SEVERITY");
    }
    let (nc, err) = lint.set_pair(c, slice_unchecked(sv, 0, eq).to_owned(), slice_unchecked(sv, eq + 1, sv.len()).to_owned());
    if (err.len() > 0) {
      return (c, err);
    }
    c = nc;
  }
  for o in opts {
    let eq = util.index_of_sub(o, "=");
    if (eq < 0) {
      return (c, "-lint-opt \"" + o + "\" must be spelled RULE.OPTION=VALUE");
    }
    let (nc, err) = lint.set_option(c, slice_unchecked(o, 0, eq).to_owned(), slice_unchecked(o, eq + 1, o.len()).to_owned());
    if (err.len() > 0) {
      return (c, err);
    }
    c = nc;
  }
  return (c, "");
}

function lint_text(st: DiagStyle, f: lint.Finding, src: string): string {
  let label = "warning";
  let sgr = "1;33";
  if (f.severity == lint.DENY) {
    label = "error";
    sgr = "1;31";
  }
  if (st.json) {
    let none: string[] = [];
    return json_diagnostic(json_position(f.file, f.line, f.col, 0), label, f.rule, f.msg, none);
  }
  let out: string = f.file + ":" + util.i32_to_string(f.line) + ":" + util.i32_to_string(f.col) + ": "
    + paint(st, sgr, label + "[" + f.rule + "]") + ": " + f.msg;
  if (st.terse) {
    return out;
  }
  let lines: string[] = [];
  let start = 0;
  for i in 0..=src.len() {
    if (i == src.len() || src[i] == b'\n') {
      lines = lines.append(slice_unchecked(src, start, i).to_owned());
      start = i + 1;
    }
  }
  let line = "";
  if (f.line >= 1 && f.line <= lines.len()) {
    line = lines[f.line - 1];
    if (line.ends_with("\r")) {
      line = slice_unchecked(line, 0, line.len() - 1).to_owned();
    }
  }
  if (line.len() > 0) {
    let pad = "";
    let w = f.col - 1;
    if (w > line.len()) {
      w = line.len();
    }
    while (w > 0) {
      pad += " ";
      w -= 1;
    }
    out = out + "\n    " + line + "\n    " + pad + paint(st, sgr, "^");
  }
  if (f.help.len() > 0) {
    out = out + "\n    " + paint(st, "34", "help:") + " " + f.help;
  }
  return out;
}

function lint_module(st: DiagStyle, cfg: lint.Config, shown: string, code: string, lm: util.LineMap, cov_files: coverreport.File[]): (lint.Finding[], boolean) {
  let lx = lexer.tokenize_full(code);
  let m = parser.parse_module(lx.tokens);
  let perrs: Finding[] = [];
  for pf in parse_findings(m) {
    if (pf.diag.code.len() == 0 || pf.diag.code[0] == b'P') {
      perrs = perrs.append(pf);
    }
  }
  let no_files: string[] = [];
  let out: lint.Finding[] = [];
  if (eprint_findings(st, perrs, shown, no_files, [lm])) {
    return (out, false);
  }
  for fd in lint.lint_file(cfg, shown, code, m, lx.comments, cov_files) {
    let (line, col) = util.doc_pos([lm], fd.line, fd.col);
    out = out.append(lint.Finding { ...fd, line: line, col: col });
  }
  return (out, true);
}

function lint_cover(cfg: lint.Config, cover_path: string): (coverreport.File[], string) {
  let none: coverreport.File[] = [];
  if (cover_path.len() == 0) {
    if (cfg.risk_configured && cfg.risk != lint.ALLOW) {
      return (none, lint.RISK + " is configured but no coverage was given: pass -lint-cover FILE, a saved -cover run's stderr");
    }
    return (none, "");
  }
  match (read_file(cover_path)) {
    Ok(t) => {
      let folded = coverreport.fold(t);
      if (folded.err.len() > 0) {
        return (none, "-lint-cover " + cover_path + ": " + folded.err);
      }
      if (folded.files.len() == 0) {
        return (none, "-lint-cover " + cover_path + ": no fern-cover rows (want a -cover run's stderr)");
      }
      return (folded.files, "");
    },
    Err(e) => {
      return (none, "-lint-cover: cannot read " + cover_path + ": " + e.message());
    }
  }
}

function run_lint(st: DiagStyle, paths: string[], sets: string[], opts: string[], cover_path: string): i32 {
  if (paths.len() == 0) {
    eprint("usage: fern -lint PATH... (a .fern or .fern.md file, or a directory of them)");
    return 2;
  }
  let (files, walked, terr) = source_files(paths);
  if (terr.len() > 0) {
    eprint("fern: " + terr);
    return 2;
  }
  if (files.len() == 0) {
    eprint("fern: no .fern or .fern.md files under " + comma_joined(paths));
    return 2;
  }
  let (cfg, cerr) = lint_config(files[0], sets, opts);
  if (cerr.len() > 0) {
    eprint("fern: " + cerr);
    return 2;
  }
  let (cov_files, cov_err) = lint_cover(cfg, cover_path);
  if (cov_err.len() > 0) {
    eprint("fern: " + cov_err);
    return 2;
  }
  let covered_files = 0;
  let all: lint.Finding[] = [];
  let out = "";
  let broken = false;
  let fi = 0;
  while (fi < files.len()) {
    let f = files[fi];
    let found = walked[fi];
    fi += 1;
    let src = "";
    match (read_source(f)) {
      Ok(t) => {
        src = t;
      },
      Err(e) => {
        report_source_read_failure(st, "file", f, e);
        return 2;
      }
    }
    if (found && is_literate(f) && !literate.is_program(src)) {
      continue;
    }
    let (mods, terr) = entry_sources(f, src);
    if (terr.len() > 0) {
      eprint(terr);
      broken = true;
      continue;
    }
    if (lint.cover_of(cov_files, f) >= 0) {
      covered_files += 1;
    }
    for mi in 0..mods.srcs.len() {
      let (fds, parsed) = lint_module(st, cfg, entry_display(f), mods.srcs[mi], mods.maps[mi], cov_files);
      broken = broken || !parsed;
      for fd in fds {
        if (all.len() > 0 && !st.terse) {
          out += "\n";
        }
        out = out + lint_text(st, fd, src) + "\n";
        all = all.append(fd);
      }
    }
  }
  if (cfg.risk != lint.ALLOW && cov_files.len() > 0 && covered_files == 0) {
    eprint("fern: -lint-cover " + cover_path + " covers none of the linted files: it names " + lint.cover_names(cov_files));
    return 2;
  }
  let sum = lint.summary(all);
  if (sum.len() > 0 && !st.json) {
    out = out + sum + "\n";
  }
  if (out.len() > 0) {
    eprint(slice_unchecked(out, 0, out.len() - 1));
  }
  if (broken || lint.failed(all)) {
    return 1;
  }
  return 0;
}

function run(): i32 {
  return run_with(args(), "", no_fetcher());
}

pub struct Fetched { hash: string, dir: string, err: string }

pub struct Fetcher { fetch: (string, string) => Fetched }

pub function no_fetcher(): Fetcher {
  return Fetcher { fetch: cannot_fetch };
}

function cannot_fetch(url: string, hash: string): Fetched {
  return Fetched { hash: "", dir: "", err: "fetching " + url + " needs the shipped `fern`; this build has no HTTP client" };
}

function abs_dir(p: string): string {
  if (mvs.is_abs(p)) {
    return p;
  }
  match (getcwd()) {
    Ok(cwd) => {
      if (p.len() == 0) {
        return cwd;
      }
      return mvs.join_path(cwd, p);
    },
    Err(_) => {}
  }
  return p;
}

pub function run_runtime(av: string[]): i32 {
  return run_with_gate(av, "", no_fetcher(), checker.build_runtime_gate_with_file);
}

pub function run_with(av: string[], embedded_root: string, fetcher: Fetcher): i32 {
  return run_with_gate(av, embedded_root, fetcher, checker.build_gate_with_file);
}

function run_format_files(st: DiagStyle, pos: string[], fmt_write: boolean, fmt_diff: boolean, out_path: string): i32 {
  let (files, _, ferr) = source_files(pos);
  if (ferr.len() > 0) {
    eprint("fern: " + ferr);
    return 2;
  }
  if (files.len() == 0) {
    eprint("fern: -fmt: no .fern or .fern.md files under " + comma_joined(pos));
    return 2;
  }
  if (out_path.len() > 0 && files.len() > 1) {
    eprint("fern: -fmt -o takes a single input file (" + util.i32_to_string(files.len()) + " given)");
    return 2;
  }
  let code = 0;
  for fi in 0..files.len() {
    let fc = fmt_file(st, files[fi], fmt_write, fmt_diff, out_path);
    if (fc > code) {
      code = fc;
    }
  }
  return code;
}

function coverage_refusal(cover_on: boolean, mode_interp: boolean, mode_check: boolean, target: string): string {
  if (cover_on && mode_interp) {
    return "fern: -cover instruments compiled code; -interp does not lower, so it has no coverage to report";
  }
  if (cover_on && !mode_check && target != "x86-64-linux" && target != "arm64-linux") {
    return "fern: -cover: -target " + target + " has no coverage instrumentation — build for x86-64-linux or arm64-linux, or drop -cover";
  }
  return "";
}

// An x86 Android executable uses PIE, like its ARM counterpart.
function executable_pie(pie: boolean, target: string, shared: boolean): boolean {
  return pie || target == "x86-64-android" && !shared;
}

function x86_executable_page_align(target: string): i32 {
  if (target == "x86-64-android") {
    return elf.elf_x86_android_page_align();
  }
  return elf.elf_x86_page_align();
}

function shared_refusal(shared: boolean, target: string, out_path: string, emit: string): string {
  if (!shared) {
    return "";
  }
  if (!is_native_target(target) || target == "arm64-darwin") {
    return "fern: -shared is only supported with -target x86-64-linux, arm64-linux, x86-64-android or arm64-android (got \"" + target + "\")";
  }
  if (out_path.len() == 0 && emit != "asm") {
    return "fern: -shared requires -o OUTPUT.so";
  }
  return "";
}

function cli_backend_refusal(backend: string, target: string): string {
  if (backend != "" && backend != "ssa" && backend != "flat") {
    return "fern: unknown -backend: " + backend + " (want flat or ssa, or omit it for the target's default emitter)";
  }
  let ssa_isa = platforms.for_target(target).isa == "arm64" || platforms.for_target(target).isa == "x86-64";
  if (backend == "ssa" && !ssa_isa) {
    return "fern: -backend ssa is not available for -target " + target + " (available for: arm64-linux, arm64-darwin, arm64-android, x86-64-linux, x86-64-android)";
  }
  if (backend == "flat" && ssa_isa) {
    return "fern: -backend flat is not available for -target " + target + ": the stack machine's function emitter was retired, and the register path (-backend ssa, the default) is the only emitter on arm64 and x86-64";
  }
  return "";
}

// The Android flags: -jni-java, and the output, package, label, icon and key
// file of -apk.
struct ApkOpts { jni_java: string, jni_dex: string, out: string, package: string, label: string, icon: string, key: string, permissions: string, min_sdk: string, compress: boolean, cleartext: boolean, debuggable: boolean, home: boolean, assets: string, widget: string, run: boolean }

function is_android_flag(name: string): boolean {
  return util.has_str(["-jni-java", "-jni-dex", "-apk", "-apk-package", "-apk-label", "-apk-icon", "-apk-key", "-apk-permission", "-apk-min-sdk", "-apk-compress", "-apk-cleartext", "-apk-debuggable", "-apk-home", "-apk-asset", "-apk-widget", "-apk-run"], name);
}

// The -apk flags that take no value.
function apk_switch(name: string): boolean {
  return util.has_str(["-apk-compress", "-apk-cleartext", "-apk-debuggable", "-apk-home", "-apk-run"], name);
}

function android_flag(o: ApkOpts, f: CliArg): ApkOpts {
  return match (f.name) {
    "-jni-java" => ApkOpts { ...o, jni_java: f.value },
    "-jni-dex" => ApkOpts { ...o, jni_dex: f.value },
    "-apk" => ApkOpts { ...o, out: f.value },
    "-apk-package" => ApkOpts { ...o, package: f.value },
    "-apk-label" => ApkOpts { ...o, label: f.value },
    "-apk-icon" => ApkOpts { ...o, icon: f.value },
    "-apk-key" => ApkOpts { ...o, key: f.value },
    "-apk-permission" => ApkOpts { ...o, permissions: f.value },
    "-apk-min-sdk" => ApkOpts { ...o, min_sdk: f.value },
    "-apk-compress" => ApkOpts { ...o, compress: true },
    "-apk-cleartext" => ApkOpts { ...o, cleartext: true },
    "-apk-debuggable" => ApkOpts { ...o, debuggable: true },
    "-apk-home" => ApkOpts { ...o, home: true },
    "-apk-asset" => ApkOpts { ...o, assets: f.value },
    "-apk-widget" => ApkOpts { ...o, widget: f.value },
    "-apk-run" => ApkOpts { ...o, run: true },
    _ => o,
  };
}

// The arguments of one -apk build: the command line without the -apk flags.
function apk_build_args(av: string[]): (string[], string) {
  let out: string[] = [];
  let value_next = false;
  for a in av[1:av.len()] {
    let name = apk_flag_name(a);
    if (value_next) {
      value_next = false;
    } else if (util.has_str(["-target", "-o", "-shared", "-export", "-run", "-emit", "-jni-java", "-jni-dex"], name)) {
      return (out, "fern: -apk builds the library for both Android ABIs itself, so it takes no " + a);
    } else if (name.starts_with("-apk")) {
      value_next = !apk_switch(name) && !a.contains("=");
    } else {
      out = out.append(a);
    }
  }
  return (out, "");
}

// The name of flag `a`, with one dash and no "=value".
function apk_flag_name(a: string): string {
  if (!is_flag(a)) {
    return "";
  }
  let body = slice_unchecked(a, 1, a.len()).to_owned();
  if (body.starts_with("-")) {
    body = slice_unchecked(body, 1, body.len()).to_owned();
  }
  let eq = util.index_of_sub(body, "=");
  if (eq >= 0) {
    body = slice_unchecked(body, 0, eq).to_owned();
  }
  return "-" + body;
}

// The library name of the app: the base name of FILE, as a C identifier.
function apk_lib_name(entry_path: string): string {
  let base = util.path_base(entry_path);
  let out = "";
  for i in 0..base.len() {
    let c = base[i];
    if (c == b'.') {
      break;
    }
    if (c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c >= b'0' && c <= b'9') {
      out += slice_unchecked(base, i, i + 1);
    } else {
      out += "_";
    }
  }
  return out;
}

// The signing scalar from `path`, or a new one, which it writes there.
function apk_key(path: string): (u8[], string) {
  match (read_file(path)) {
    Ok(pem) => {
      let d = apk.key_scalar(pem);
      if (d.len() != 32) {
        return (d, "fern: " + path + " is not a P-256 private key in PEM form");
      }
      return (d, "");
    },
    Err(NotFound(_)) => {},
    Err(e) => {
      let none: u8[] = [];
      return (none, "fern: cannot read the signing key " + path + ": " + e.message());
    }
  }
  let d = apk.new_scalar();
  match (util.write_new_file(path, apk.key_pem(d))) {
    Ok(_) => {
      eprint("fern: wrote a new signing key to " + path + "; sign each update of the app with it");
      return (d, "");
    },
    Err(e) => {
      return (d, "fern: cannot write " + path + ": " + e.message());
    }
  }
}

// The library of the app for each Android ABI, built under `dir` with the
// name lib<lib>.so, which is also its SONAME.
// The arm64 build also writes the DEX file of the @jni classes, which is
// empty when there is none.
// The Android ABIs that -apk builds, each with its -target.
function apk_abis(): (string, string)[] {
  return [("arm64-v8a", "arm64-android"), ("x86_64", "x86-64-android")];
}

function apk_libs(fern: string, rest: string[], dir: string, lib: string, abis: (string, string)[], embedded_root: string, fetcher: Fetcher, gate: (parser.Module, string) => checker.GateResult): (apk.Lib[], u8[], i32) {
  let libs: apk.Lib[] = [];
  let status = 0;
  let dex_path = dir + "/classes.dex";
  let flags: string[] = ["-jni-dex", dex_path];
  for abi in abis {
    let so = dir + "/" + abi.0 + "/lib" + lib + ".so";
    if let Err(e) = create_dir_all(dir + "/" + abi.0) {
      if (status == 0) {
        eprint("fern: cannot create " + dir + "/" + abi.0 + ": " + e.message());
        status = 1;
      }
    }
    if (status == 0) {
      status = run_with_gate(util.append_all(util.append_all([fern, "-target", abi.1, "-shared", "-export", "ANativeActivity_onCreate", "-o", so], flags), rest), embedded_root, fetcher, gate);
    }
    flags = [];
    match (read_file_bytes(so)) {
      Ok(image) => {
        libs = libs.append(apk.Lib { abi: abi.0, image: image });
      },
      Err(e) => {
        if (status == 0) {
          eprint("fern: cannot read " + so + ": " + e.message());
          status = 1;
        }
      }
    }
  }
  let classes: u8[] = [];
  match (read_file_bytes(dex_path)) {
    Ok(b) => {
      classes = b;
    },
    Err(NotFound(_)) => {},
    Err(e) => {
      if (status == 0) {
        eprint("fern: cannot read " + dex_path + ": " + e.message());
        status = 1;
      }
    }
  }
  let _ = remove_dir_all(dir);
  return (libs, classes, status);
}

// The -apk-key file, or by default the APK path with .key.pem for .apk.
function apk_key_path(o: ApkOpts): string {
  if (o.key.len() > 0) {
    return o.key;
  }
  if (o.out.ends_with(".apk")) {
    return slice_unchecked(o.out, 0, o.out.len() - 4) + ".key.pem";
  }
  return o.out + ".key.pem";
}

function apk_level_ok(n: i64): boolean {
  return n >= apk.MIN_SDK as i64 && n <= apk.TARGET_SDK as i64;
}

// The full names of the -apk-permission list. A name with no dot is in
// android.permission.
function apk_permissions(list: string): string[] {
  let out: string[] = [];
  if (list.len() == 0) {
    return out;
  }
  for name in list.split(",") {
    let n = name.trim();
    if (!n.contains(".")) {
      n = "android.permission." + n;
    }
    out = out.append(n);
  }
  return out;
}

// The app of the APK. A @jni class that extends NativeActivity is the
// activity, and NativeActivity itself is the activity otherwise. Each @jni
// class that extends Service is a service, with the foreground service
// types that the permissions allow. Each @jni class that extends
// NotificationListenerService is a service that only the system binds.
function apk_app(o: ApkOpts, lib: string, classes: u8[]): apk.App {
  let activity = dex.subclass_of(classes, "android.app.NativeActivity");
  if (activity.len() == 0) {
    activity = "android.app.NativeActivity";
  }
  let permissions = apk_permissions(o.permissions);
  let services: apk.Service[] = [];
  for name in dex.subclasses_of(classes, "android.app.Service") {
    services = services.append(apk.Service { name: name, types: apk.foreground_types(permissions), permission: "", action: "" });
  }
  for name in dex.subclasses_of(classes, apk.LISTENER_ACTION) {
    services = services.append(apk.Service { name: name, types: 0, permission: apk.LISTENER_PERMISSION, action: apk.LISTENER_ACTION });
  }
  let app = apk.App { package: "dev.fern." + lib, label: lib, lib: lib, version_code: 1, version_name: "1.0", activity: activity, dex: classes, permissions: permissions, min_sdk: apk.MIN_SDK, services: services, icon: [], compress: o.compress, cleartext: o.cleartext, debuggable: o.debuggable, home: o.home, assets: [], widget: apk.no_widget() };
  if (o.min_sdk.len() > 0) {
    app = apk.App { ...app, min_sdk: size_bytes(o.min_sdk) as i32 };
  }
  if (o.package.len() > 0) {
    app = apk.App { ...app, package: o.package };
  }
  if (o.label.len() > 0) {
    app = apk.App { ...app, label: o.label };
  }
  return app;
}

// A name of a resource: small letters, digits and `_`, with a letter first.
function resource_name(name: string): boolean {
  if (name.len() == 0 || name[0] < b'a' || name[0] > b'z') {
    return false;
  }
  for i in 0..name.len() {
    let c = name[i];
    if (!(c >= b'a' && c <= b'z' || c >= b'0' && c <= b'9' || c == b'_')) {
      return false;
    }
  }
  return true;
}

// The item of the widget that `text` names, or the error.
function apk_widget_item(text: string, seen: string[]): (apk.Item, string) {
  let parts: string[] = [];
  for part in text.trim().split(":") {
    parts = parts.append(part.to_owned());
  }
  let none = apk.Item { button: false, name: "", label: "" };
  if (parts.len() < 3 || parts[0] != "text" && parts[0] != "button") {
    return (none, "fern: -apk-widget takes items such as text:title:Song or button:next:Next, and \"" + text + "\" is not one");
  }
  if (!resource_name(parts[1])) {
    return (none, "fern: -apk-widget: the name \"" + parts[1] + "\" of an item has small letters, digits and _ only, with a letter first");
  }
  let label = parts[2];
  for k in 3..parts.len() {
    label = label + ":" + parts[k];
  }
  if (util.has_str(seen, parts[1])) {
    return (none, "fern: -apk-widget: two items have the name \"" + parts[1] + "\"");
  }
  return (apk.Item { button: parts[0] == "button", name: parts[1], label: label }, "");
}

// The widget of the -apk-widget list and of the class in `classes` that
// extends AppWidgetProvider. The second value is the error when the list
// and the class are not there together, or when an item is not valid.
function apk_widget(list: string, classes: u8[]): (apk.Widget, string) {
  let providers = dex.subclasses_of(classes, "android.appwidget.AppWidgetProvider");
  if (list.len() == 0) {
    if (providers.len() > 0) {
      return (apk.no_widget(), "fern: " + providers[0] + " extends android.appwidget.AppWidgetProvider, and the widget has no items: give them with -apk-widget, or with widget in the [android] table of fern.toml");
    }
    return (apk.no_widget(), "");
  }
  if (providers.len() != 1) {
    return (apk.no_widget(), "fern: -apk-widget needs one @jni class that extends android.appwidget.AppWidgetProvider, and the app has " + util.i32_to_string(providers.len()));
  }
  let items: apk.Item[] = [];
  let names: string[] = [];
  for text in list.split(",") {
    let (item, bad) = apk_widget_item(text.to_owned(), names);
    if (bad.len() > 0) {
      return (apk.no_widget(), bad);
    }
    items = items.append(item);
    names = names.append(item.name);
  }
  if (items.len() > 8) {
    return (apk.no_widget(), "fern: -apk-widget takes at most 8 items, and got " + util.i32_to_string(items.len()));
  }
  return (apk.Widget { provider: providers[0], items: items }, "");
}

// The files of the -apk-asset list, each under its own file name. The second
// value is the error when a file cannot be read, or when two files have one
// name.
function apk_assets(list: string): (apk.Asset[], string) {
  let out: apk.Asset[] = [];
  if (list.len() == 0) {
    return (out, "");
  }
  let names: string[] = [];
  for item in list.split(",") {
    let path = item.trim();
    let name = path;
    if let Some(slash) = path.last_index_of("/") {
      name = slice_unchecked(path, slash + 1, path.len()).to_owned();
    }
    if (name.len() == 0 || util.has_str(names, name)) {
      return (out, "fern: -apk-asset takes files with different names, and " + path + " is not one");
    }
    match (read_file_bytes(path)) {
      Ok(data) => {
        out = out.append(apk.Asset { name: name, data: data });
        names = names.append(name);
      },
      Err(e) => {
        return (out, "fern: cannot read the -apk-asset file " + path + ": " + e.message());
      }
    }
  }
  return (out, "");
}

// The PNG at `path`, or no bytes when `path` is "". The second value is the
// error when the file cannot be read or is not a PNG.
function apk_icon(path: string): (u8[], string) {
  if (path.len() == 0) {
    return ([], "");
  }
  match (read_file_bytes(path)) {
    Ok(b) => {
      let magic: i32[] = [137, 80, 78, 71, 13, 10, 26, 10];
      let png = b.len() >= 8;
      for k in 0..8 {
        if (png && b[k] as i32 != magic[k]) {
          png = false;
        }
      }
      if (!png) {
        return ([], "fern: -apk-icon takes a PNG file, and " + path + " is not one");
      }
      return (b, "");
    },
    Err(e) => {
      return ([], "fern: cannot read the -apk-icon file " + path + ": " + e.message());
    }
  }
}

// The -apk options with the [android] settings of the fern.toml that
// governs the entry file. A flag on the command line takes priority, and a
// path in the file is relative to the directory of the file.
function apk_with_manifest(o: ApkOpts, entry_path: string): (ApkOpts, string) {
  let dir = util.dir_of(entry_path);
  if (dir.len() > 0) {
    dir += "/";
  }
  let g = governing_manifest(dir);
  if (!g.found) {
    return (o, "");
  }
  if (g.man.err.len() > 0) {
    return (o, fern_toml.diagnostic(g.dir + "fern.toml", g.man));
  }
  let m = g.man;
  let assets = o.assets;
  if (assets.len() == 0) {
    let paths: string[] = [];
    for a in util.split_char(fern_toml.android(m, "assets"), b',') {
      if (a.len() > 0) {
        paths = paths.append(android_path(g.dir, a));
      }
    }
    assets = paths.join(",");
  }
  return (ApkOpts {
    ...o,
    package: or_text(o.package, fern_toml.android(m, "package")),
    label: or_text(o.label, fern_toml.android(m, "label")),
    icon: or_text(o.icon, android_path(g.dir, fern_toml.android(m, "icon"))),
    key: or_text(o.key, android_path(g.dir, fern_toml.android(m, "key"))),
    permissions: or_text(o.permissions, fern_toml.android(m, "permissions")),
    min_sdk: or_text(o.min_sdk, fern_toml.android(m, "min_sdk")),
    compress: o.compress || fern_toml.android(m, "compress") == "true",
    cleartext: o.cleartext || fern_toml.android(m, "cleartext") == "true",
    debuggable: o.debuggable || fern_toml.android(m, "debuggable") == "true",
    home: o.home || fern_toml.android(m, "home") == "true",
    assets: assets,
    widget: or_text(o.widget, fern_toml.android(m, "widget")),
  }, "");
}

function or_text(flag: string, file: string): string {
  if (flag.len() > 0) {
    return flag;
  }
  return file;
}

// `path` from a manifest in the directory `dir`, which is "" or ends in a
// slash.
function android_path(dir: string, path: string): string {
  if (path.len() == 0 || path[0] == b'/') {
    return path;
  }
  return dir + path;
}

// fern -apk: builds the library of the app for each Android ABI, then
// writes the signed APK.
function run_apk(av: string[], flags: ApkOpts, entry_path: string, embedded_root: string, fetcher: Fetcher, gate: (parser.Module, string) => checker.GateResult): i32 {
  let (rest, bad) = apk_build_args(av);
  if (bad.len() > 0) {
    eprint(bad);
    return 2;
  }
  let (o, manifest_bad) = apk_with_manifest(flags, entry_path);
  if (manifest_bad.len() > 0) {
    eprint(manifest_bad);
    return 2;
  }
  if (o.min_sdk.len() > 0 && !apk_level_ok(size_bytes(o.min_sdk))) {
    eprint("fern: -apk-min-sdk takes an API level from " + util.i32_to_string(apk.MIN_SDK) + " to " + util.i32_to_string(apk.TARGET_SDK) + " (got \"" + o.min_sdk + "\")");
    return 2;
  }
  let (icon, icon_bad) = apk_icon(o.icon);
  if (icon_bad.len() > 0) {
    eprint(icon_bad);
    return 2;
  }
  let (assets, assets_bad) = apk_assets(o.assets);
  if (assets_bad.len() > 0) {
    eprint(assets_bad);
    return 2;
  }
  let lib = apk_lib_name(entry_path);
  let abis = apk_abis();
  let adb = "";
  if (o.run) {
    adb = find_on_path("adb");
    if (adb.len() == 0) {
      eprint("fern: -apk-run: adb is not on PATH");
      return 1;
    }
    let (device, abi_bad) = device_abi(adb);
    if (abi_bad.len() > 0) {
      eprint(abi_bad);
      return 1;
    }
    abis = [device];
  }
  let (libs, classes, status) = apk_libs(av[0], rest, o.out + ".lib", lib, abis, embedded_root, fetcher, gate);
  if (status != 0) {
    return status;
  }
  let (d, key_bad) = apk_key(apk_key_path(o));
  if (key_bad.len() > 0) {
    eprint(key_bad);
    return 1;
  }
  let (widget, widget_bad) = apk_widget(o.widget, classes);
  if (widget_bad.len() > 0) {
    eprint(widget_bad);
    return 2;
  }
  let app = apk.App { ...apk_app(o, lib, classes), icon: icon, assets: assets, widget: widget };
  if let Err(e) = write_file_bytes(o.out, apk.write(app, libs, d)) {
    eprint("fern: cannot write " + o.out + ": " + e.message());
    return 1;
  }
  if (o.run) {
    return apk_launch(adb, o.out, app);
  }
  return 0;
}

// The ABI of the device that adb sees, with its -target.
function device_abi(adb: string): ((string, string), string) {
  let r = subprocess(adb, ["shell", "getprop", "ro.product.cpu.abi"], "");
  let abi = strip_lines(r.stdout);
  for a in apk_abis() {
    if (a.0 == abi) {
      return (a, "");
    }
  }
  if (r.exit_code != 0) {
    return (("", ""), "fern: -apk-run: adb found no device: " + strip_lines(r.stderr));
  }
  return (("", ""), "fern: -apk-run: the device ABI " + abi + " is not arm64-v8a or x86_64");
}

// Installs the APK at `path`, starts its activity, and shows the log lines
// of its process until the process stops. The shell of the device waits
// for the process, so adb ends when the app does.
function apk_launch(adb: string, path: string, app: apk.App): i32 {
  let installed = subprocess(adb, ["install", "-r", path], "");
  if (installed.exit_code != 0) {
    eprint("fern: -apk-run: adb install failed: " + strip_lines(installed.stdout + installed.stderr));
    return 1;
  }
  let component = app.package + "/" + app.activity;
  let started = subprocess(adb, ["shell", "am", "start", "-W", "-n", component], "");
  if (started.exit_code != 0 || started.stdout.contains("Error")) {
    eprint("fern: -apk-run: cannot start " + component + ": " + strip_lines(started.stdout + started.stderr));
    return 1;
  }
  let pid = "";
  let tries = 0;
  while (pid.len() == 0 && tries < 50) {
    pid = strip_lines(subprocess(adb, ["shell", "pidof", app.package], "").stdout);
    if (pid.len() == 0) {
      sleep_ms(100i64);
    }
    tries += 1;
  }
  if (pid.len() == 0) {
    eprint("fern: -apk-run: " + app.package + " started, but its process is gone");
    return 1;
  }
  let script = "logcat -v brief --pid=" + pid + " & L=$!; while [ -d /proc/" + pid + " ]; do sleep 1; done; kill $L";
  return exec_and_wait(adb, [adb, "shell", script]);
}

function run_repl_paths(pos: string[], embedded_root: string, target: string): i32 {
  let embedded = embedded_root.len() > 0;
  if (pos.len() > 1 || pos.len() == 1 && embedded) {
    return usage(embedded);
  }
  if (pos.len() == 1) {
    return run_repl(util.clean_path(pos[0]), target);
  }
  return run_repl(embedded_root, target);
}

function run_document_mode(entry_path: string, have_entry: boolean, embedded: boolean, prog_args: string[], tf: ToolFlags, root: string, target: string, embed_dir: string, out_path: string, chunk: string): i32 {
  if (!have_entry) {
    return usage(embedded);
  }
  if (prog_args.len() > 0) {
    eprint("fern: one document expected, got \"" + entry_path + "\" and \"" + prog_args[0] + "\"");
    return 2;
  }
  if (tf.doctest) {
    return run_doctests(entry_path, root, target, embed_dir);
  }
  return run_tangle(entry_path, out_path, chunk, tf.weave, tf.html);
}

function interpret_bundle(st: DiagStyle, b: Bundle, entry_path: string, target: string, prog_args: string[]): i32 {
  let merged = b.merged;
  if (eprint_findings(st, parse_findings(merged), entry_path, b.files, b.maps)) {
    return 1;
  }
  if (eprint_findings(st, errors_of(flatten.handler_serve_diags(b.entry, target)), entry_path, b.files, b.maps)) {
    return 1;
  }
  if (eprint_findings(st, interp_findings_with_file(merged, b.pkgs, util.path_base(entry_display(entry_path))), entry_path, b.files, b.maps)) {
    return 1;
  }
  let argv: string[] = [entry_path];
  for pa in 0..prog_args.len() {
    argv = argv.append(prog_args[pa]);
  }
  let (status, why) = interp_status(interp.eval_module_argv(merged, argv));
  if (why.len() > 0) {
    eprint(why);
  }
  return status;
}

function run_with_gate(av: string[], embedded_root: string, fetcher: Fetcher, gate: (parser.Module, string) => checker.GateResult): i32 {
  let entry_path = "";
  let out_path = "";
  let root = embedded_root;
  let embedded = embedded_root.len() > 0;
  let have_root = embedded;
  let prog_args: string[] = [];
  let target = target_arch() + "-" + target_os();
  let emit = "";
  let mode_check = false;
  let mode_interp = false;
  let no_strs: string[] = [];
  let tf = ToolFlags { run_it: false, qemu: "qemu-aarch64", version: false, explain: false, explain_code: "", cover_report: false, lcov: false, color_mode: "auto", ascii: false, diag_format: diag_format_from_env(), lint: false, lint_rules: false, lint_sets: no_strs, lint_opts: no_strs, lint_cover: "", weave: false, html: false, doctest: false };
  let mode_fmt = false;
  let fmt_write = false;
  let fmt_diff = false;
  let mode_caps = false;
  let mode_manifest = false;
  let mode_sign_index = false;
  let mode_index_keygen = false;
  let sign_key = "";
  let profile_name = "";
  let mode_effects = false;
  let mode_targets = false;
  let mode_resolve = false;
  let mode_tangle = false;
  let chunk = "";
  let grant = "";
  let mode_doc = false;
  let doc_links = "";
  let mode_add = false;
  let mode_vendor = false;
  let mode_fetch = false;
  let mode_lsp = false;
  let mode_repl = false;
  let pos: string[] = [];
  let backend = "";
  let embed_dir = "";
  let optimize = false;
  let emit_syms = false;
  let backtrace = asmcore.backtrace_on();
  let backtrace_set = false;
  let size = asmcore.size_on();
  let sanitize_flag = false;
  let shared = false;
  let export_list = "";
  let apk_opts = ApkOpts { jni_java: "", jni_dex: "", out: "", package: "", label: "", icon: "", key: "", permissions: "", min_sdk: "", compress: false, cleartext: false, debuggable: false, home: false, assets: "", widget: "", run: false };
  let harden = false;
  let heap_limit_text = "";
  let cpu_limit_text = "";
  let ram_text = "";
  let quarantine_text = "";
  let pie = false;
  let remap_specs: string[] = [];
  let cover_on = envflag.on("FERN_COVER");
  let array_report = semarrayreport.from_env();
  let have_entry = false;
  let target_given = false;

  if let Some(given) = given_flags(av) {
    if let Some(why) = flag_combination_error(given) {
      eprint("fern: " + why);
      return 2;
    }
  }
  let i = 1;
  let prog_sep = false;
  while (i < av.len()) {
    let a = av[i];
    let f = CliArg { name: "", value: "", on: false, last: i, err: "" };
    if (!have_entry && is_flag(a)) {
      f = read_flag(av, i);
      if (f.err.len() > 0) {
        eprint("fern: " + f.err);
        return 2;
      }
      i = f.last;
    }
    if (have_entry) {
      if (!have_root) {
        if (is_flag(a)) {
          return flag_after_entry(a, embedded);
        }
        pos = pos.append(a);
        root = util.clean_path(a);
        have_root = true;
      } else if (prog_args.len() == 0 && !prog_sep && a == "--") {
        prog_sep = true;
      } else if (prog_args.len() == 0 && !prog_sep && is_flag(a)) {
        return flag_after_entry(a, embedded);
      } else {
        pos = pos.append(a);
        prog_args = prog_args.append(a);
      }
    } else if (f.name.len() == 0) {
      pos = pos.append(a);
      entry_path = a;
      have_entry = true;
    } else if (f.name == "-h") {
      if (f.on) {
        return help(embedded);
      }
    } else if (f.name == "-check") {
      mode_check = f.on;
    } else if (tool_flag(f)) {
      let (ntf, bad) = parse_tool_flag(tf, f);
      if (bad != 0) {
        return bad;
      }
      tf = ntf;
    } else if (f.name == "-interp") {
      mode_interp = f.on;
    } else if (f.name == "-repl") {
      mode_repl = f.on;
    } else if (f.name == "-fmt") {
      mode_fmt = f.on;
    } else if (f.name == "-w") {
      fmt_write = f.on;
    } else if (f.name == "-d") {
      fmt_diff = f.on;
    } else if (f.name == "-backend") {
      backend = f.value;
    } else if (f.name == "-cover") {
      cover_on = f.on;
    } else if (f.name == "-g") {
      emit_syms = f.on;
    } else if (f.name == "-backtrace") {
      backtrace = f.on;
      backtrace_set = true;
    } else if (f.name == "-size") {
      size = f.on;
    } else if (f.name == "-sanitize") {
      sanitize_flag = f.on;
    } else if (f.name == "-harden") {
      harden = f.on;
    } else if (f.name == "-heap-limit") {
      heap_limit_text = f.value;
    } else if (f.name == "-cpu-limit") {
      cpu_limit_text = f.value;
    } else if (f.name == "-ram") {
      ram_text = f.value;
    } else if (f.name == "-quarantine") {
      quarantine_text = f.value;
    } else if (f.name == "-pie") {
      pie = f.on;
    } else if (f.name == "-remap-path-prefix") {
      remap_specs = remap_specs.append(f.value);
    } else if (f.name == "-profile") {
      profile_name = f.value;
    } else if (f.name == "-manifest") {
      mode_manifest = f.on;
    } else if (f.name == "-sign-index") {
      mode_sign_index = f.on;
    } else if (f.name == "-index-keygen") {
      mode_index_keygen = f.on;
    } else if (f.name == "-key") {
      sign_key = f.value;
    } else if (f.name == "-shared") {
      shared = f.on;
    } else if (f.name == "-export") {
      export_list = f.value;
    } else if (is_android_flag(f.name)) {
      apk_opts = android_flag(apk_opts, f);
    } else if (f.name == "-capabilities") {
      mode_caps = f.on;
    } else if (f.name == "-effects") {
      mode_effects = f.on;
    } else if (f.name == "-array-report") {
      if (f.on) {
        array_report = semarrayreport.to_stdout();
      }
    } else if (f.name == "-tangle") {
      mode_tangle = f.on;
    } else if (f.name == "-doc") {
      mode_doc = f.on;
    } else if (f.name == "-doc-source") {
      doc_links = f.value;
    } else if (f.name == "-add") {
      mode_add = f.on;
    } else if (f.name == "-fetch") {
      mode_fetch = f.on;
    } else if (f.name == "-vendor") {
      mode_vendor = f.on;
    } else if (f.name == "-lsp") {
      mode_lsp = f.on;
    } else if (f.name == "-resolve") {
      mode_resolve = f.on;
    } else if (f.name == "-targets") {
      mode_targets = f.on;
    } else if (f.name == "-chunk") {
      chunk = f.value;
    } else if (f.name == "-grant") {
      grant = f.value;
    } else if (f.name == "-emit") {
      emit = f.value;
    } else if (f.name == "-O") {
      optimize = f.on;
    } else if (f.name == "-target") {
      target = f.value;
      target_given = true;
    } else if (f.name == "-embed") {
      embed_dir = f.value;
    } else if (f.name == "-o") {
      out_path = f.value;
    } else if (f.name == "-stdlib") {
      root = util.clean_path(f.value);
      have_root = true;
    }
    i += 1;
  }

  let st = diag_style(tf.color_mode, tf.ascii, tf.diag_format);

  if (profile_name == "hardened") {
    harden = true;
    pie = true;
  } else if (profile_name == "diagnostic") {
    sanitize_flag = true;
    backtrace = true;
    backtrace_set = true;
    emit_syms = true;
  } else if (profile_name == "minimal") {
    size = true;
  } else if (profile_name != "" && profile_name != "safe") {
    eprint("fern: -profile takes safe, hardened, diagnostic or minimal (got \"" + profile_name + "\")");
    return 2;
  }
  if (mode_targets) {
    return list_targets();
  }
  if (mode_manifest) {
    return run_manifest(entry_path);
  }
  if (mode_sign_index) {
    return indexsign.run(entry_path, sign_key);
  }
  if (mode_index_keygen) {
    return indexsign.keygen(entry_path);
  }
  if (tf.version) {
    return print_version(root);
  }
  if (tf.explain) {
    return explain_cli(pos, embedded_root, tf.explain_code);
  }
  if (tf.cover_report) {
    return cover_report(entry_path, have_entry, tf.lcov);
  }
  if (tf.lint_rules) {
    write(lint.rules_listing());
    return 0;
  }
  if (tf.lint) {
    return run_lint(st, pos, tf.lint_sets, tf.lint_opts, tf.lint_cover);
  }

  if (mode_resolve) {
    return run_resolve(abs_dir(entry_path), fetcher);
  }

  if (mode_fetch) {
    return run_fetch(abs_dir(entry_path), fetcher);
  }

  if (mode_vendor) {
    return run_vendor(abs_dir(entry_path));
  }

  if (mode_tangle || tf.weave || tf.doctest) {
    return run_document_mode(entry_path, have_entry, embedded, prog_args, tf, root, target, embed_dir, out_path, chunk);
  }

  if (mode_doc) {
    if (!have_entry) {
      return usage(embedded);
    }
    return run_doc(entry_path, out_path, doc_links);
  }

  if (mode_add) {
    return run_add(pos, grant, fetcher);
  }

  let bad_target = target_refusal(target);
  if (bad_target.len() > 0) {
    eprint(bad_target);
    return 2;
  }

  if (sanitize_flag) {
    let warning = sanitize_warning(target);
    if (warning.len() > 0) {
      eprint(warning);
    }
  }

  if (mode_lsp) {
    return serve_lsp(pos, embedded_root, target, target_given, embed_dir);
  }
  if (mode_repl) {
    return run_repl_paths(pos, embedded_root, target);
  }

  if (!have_entry && (mode_check || mode_interp)) {
    entry_path = "-";
    have_entry = true;
  }
  if (!have_entry) {
    return usage(embedded);
  }
  if (array_report == semarrayreport.to_stdout() && out_path.len() > 0) {
    eprint("fern: -array-report prints the report and writes no output, so it takes no -o");
    return 2;
  }
  if (apk_opts.out.len() > 0) {
    return run_apk(av, apk_opts, entry_path, embedded_root, fetcher, gate);
  }

  if (mode_check && util.is_dir(entry_path)) {
    return check_dir(st, entry_path, root, target, target_given, embed_dir);
  }

  let bad_cover = coverage_refusal(cover_on, mode_interp, mode_check, target);
  if (bad_cover.len() > 0) {
    eprint(bad_cover);
    return 2;
  }
  let bad_emit = emit_refusal(target, emit);
  if (bad_emit.len() > 0) {
    eprint(bad_emit);
    return 2;
  }
  let run_dir = "";
  if (tf.run_it) {
    let (rout, rdir, rcode) = run_output(target, emit, shared, out_path);
    if (rcode != 0) {
      return rcode;
    }
    out_path = rout;
    run_dir = rdir;
  }
  let bad_shared = shared_refusal(shared, target, out_path, emit);
  if (bad_shared.len() > 0) {
    eprint(bad_shared);
    return 2;
  }
  let profile_mode = rtprofile.mode();
  let profile_error = rtprofile.error(profile_mode, target, shared);
  if (profile_error.len() > 0) {
    eprint(profile_error);
    return 2;
  }
  emit_syms = rtprofile.symbols(emit_syms, profile_mode);
  let heap_limit = heap_limit_bytes(heap_limit_text, target);
  let quarantine = quarantine_bytes(quarantine_text, sanitize_flag || asmcore.sanitize_on());
  let cpu_limit = cpu_limit_seconds(cpu_limit_text, target);
  if (switches_refused(harden, pie, target, shared, heap_limit, quarantine, cpu_limit)) {
    return 2;
  }
  let (ram_base, ram_size, ram_ok) = ram_layout(ram_text, target);
  if (!ram_ok) {
    return 2;
  }
  if (emit == "image" && ram_base % 2097152i64 != 0i64) {
    eprint("fern: -emit image needs a BASE of -ram that is a multiple of 2M: a loader puts an arm64 Image 2 MiB above the start of its RAM, which is on a 2 MiB boundary (got \"" + ram_text + "\")");
    return 2;
  }
  pie = executable_pie(pie, target, shared);
  let (remaps, remaps_ok) = path_remaps(remap_specs);
  if (!remaps_ok) {
    return 2;
  }
  let bad_backend = cli_backend_refusal(backend, target);
  if (bad_backend.len() > 0) {
    eprint(bad_backend);
    return 2;
  }

  if (mode_fmt) {
    return run_format_files(st, pos, fmt_write, fmt_diff, out_path);
  }
  let (form, refused) = output_form(target, emit, out_path.len() > 0);
  if (refused.len() > 0 && !(mode_check || mode_interp || mode_caps || mode_effects || array_report == semarrayreport.to_stdout())) {
    eprint("fern: " + refused);
    return 2;
  }

  let esrc = "";
  match (read_source_file(entry_path, mode_check || mode_interp)) {
    Ok(src) => {
      esrc = src;
    },
    Err(e) => {
      report_entry_read_failure(st, entry_path, e);
      return 1;
    }
  }
  if (is_literate(entry_path)) {
    warn_unused_chunks(entry_path, esrc);
  }
  let (srcs, serr) = entry_sources(entry_path, esrc);
  if (serr.len() > 0) {
    eprint(serr);
    return 1;
  }
  let ld = load_checked(srcs, root, target, embed_dir);
  if (eprint_findings(st, ld.refused, entry_path, ld.b.files, ld.b.maps)) {
    return 1;
  }
  let b = ld.b;
  let merged = b.merged;
  let pkgs = b.pkgs;

  if (mode_caps) {
    write(caps.format_rows(caps.analyze(checker.annotate_module(merged), pkgs)));
    return 0;
  }

  if (mode_effects) {
    let c = check_bundle(b, entry_path, target, target_given);
    if (!c.ok) {
      return report_checked(st, c);
    }
    write(effects.report(checker.annotate_module(merged)));
    return 0;
  }

  if (mode_check) {
    return report_checked(st, check_bundle(b, entry_path, target, target_given));
  }

  if (mode_interp) {
    return interpret_bundle(st, b, entry_path, target, prog_args);
  }
  emit = form;

  if (eprint_findings(st, parse_findings(merged), entry_path, b.files, b.maps)) {
    return 1;
  }

  if (eprint_findings(st, errors_of(flatten.handler_serve_diags(b.entry, target)), entry_path, b.files, b.maps)) {
    return 1;
  }

  let (bound, jni, bind_bad) = native_bindings(merged, target, shared, apk_opts.jni_java);
  if (bind_bad.len() > 0) {
    eprint("fern: " + bind_bad);
    return 2;
  }
  merged = bound;
  let gate_result = gate(merged, util.path_base(entry_display(entry_path)));
  if (eprint_findings(st, errors_of(gate_result.diags), entry_path, b.files, b.maps)) {
    return 1;
  }
  merged = gate_result.typed;
  if (eprint_findings(st, errors_of(executable_entry_diags(merged, target, shared, emit)), entry_path, b.files, b.maps)) {
    return 1;
  }

  let desc = platforms.for_target(target);
  merged = constfold.fold_target_name(merged, desc.environment, desc.isa);
  merged = constfold.prune_literal_branches(merged);

  let (exported_module, shared_roots, export_bad) = shared_exports(merged, shared || is_freestanding(target), export_list, jni);
  if (export_bad.len() > 0) {
    eprint("fern: " + export_bad);
    return 2;
  }
  merged = provider_entries(exported_module, target);
  if (eprint_findings(st, errors_of(capability_diags(merged, target)), entry_path, b.files, b.maps)) {
    return 1;
  }

  if (eprint_findings(st, package_findings(merged, pkgs), entry_path, b.files, b.maps)) {
    return 1;
  }

  if (eprint_findings(st, errors_of(annotated_diags(merged)), entry_path, b.files, b.maps)) {
    return 1;
  }

  merged = constfold.fold_module(merged);

  if (cover_on) {
    merged = cover.instrument(merged, b.files, entry_path);
  }

  if (optimize) {
    merged = constfold.elide_asserts(merged);
  }

  merged = treeshake.treeshake(merged);
  let reached_bad = reached_native_refusal(merged, target, shared);
  if (reached_bad.len() > 0) {
    eprint("fern: " + reached_bad);
    return 2;
  }

  let typed = parser.module_with_builtins_typed(merged);
  let full = parser.erase_view_module(typed);
  let debug_lines = emit_syms && (target == "x86-64-linux" || target == "arm64-linux" || target == "arm64-android" || target == "arm64-darwin");
  let sub = ircore.Sub { ...semlower.target_substitution(typed, target, semlower.build_opts(debug_lines, size, true, array_report)), switches: asmcore.Switches { backtrace: backtrace && (backtrace_set || !size), sanitize: sanitize_flag || asmcore.sanitize_on(), sandbox: asmcore.sandbox_on(), cover: cover_on, symbols: emit_syms, optimize: optimize, leak_check: asmcore.leak_check_on(), rc_free_debug: asmcore.rc_free_debug_on(), var_rows: debug_lines && emit != "asm", shared: shared, size: size, harden: harden, heap_limit: heap_limit, quarantine: quarantine, cpu_limit: cpu_limit, pie: pie, profile: profile_name, target: target, line_maps: b.maps, ram_base: ram_base, ram_size: ram_size, interrupts: interrupt_entries(merged), early: marked_entry(merged, "early"), secondary: marked_entry(merged, "secondary"), user_mode: calls_user_run(merged) } };
  if (array_report == semarrayreport.to_stdout()) {
    return 0;
  }
  if (eprint_findings(st, errors_of(sub.refused), entry_path, b.files, b.maps)) {
    return 1;
  }
  let out_asm = "";
  let image: u8[] = [];
  let emit_text = emit == "asm";
  if (target == "arm64-linux") {
    let recs = word_buf(emit_text);
    out_asm = asm_arm64_ir.emit_module_or_error_sub(full, false, sub, recs);
    util.arr_push_cliff_report("arm64:emitted", 0);
    if (out_asm.len() == 0) {
      return 2;
    }
    if (debug_lines) {
      out_asm = dw_file_table(entry_path, b.files, remaps) + out_asm;
    }
    if (shared) {
      out_asm = export_entries(merged, entry_names(merged, shared_roots), true, harden) + import_entries(merged, true) + out_asm;
    }
    out_asm += bti_property_text(emit_text && harden);
    if (!emit_text && shared) {
      image = arm64_elf_shared(out_asm, words_of(recs), shared_roots, slice_unchecked(out_path, util.last_slash(out_path) + 1, out_path.len()).to_owned(), target, merged, harden);
      if (image.len() == 0) {
        return 2;
      }
    } else if (!emit_text) {
      image = elfimage.arm64_elf_binary(out_asm, words_of(recs), emit_syms, remap_path(remaps, entry_path), remap_path(remaps, comp_dir()), harden, pie);
      util.arr_push_cliff_report("arm64:image", 0);
      if (image.len() == 0) {
        return 2;
      }
    }
  } else if (target == "arm64-kernel") {
    let recs = word_buf(emit_text);
    out_asm = asm_arm64_ir.emit_module_or_error_sub(full, false, sub, recs);
    if (out_asm.len() == 0) {
      return 2;
    }
    if (!emit_text) {
      image = arm64_kernel_image(out_asm, words_of(recs), ram_base);
      if (image.len() == 0) {
        return 2;
      }
      if (emit == "image") {
        image = arm64_linux_image(image, ram_base, ram_size);
        if (image.len() == 0) {
          return 2;
        }
      }
    }
  } else if (target == "x86-64-kernel") {
    let recs = word_buf(emit_text);
    out_asm = asm_ir.emit_module_or_error_sub(full, sub, recs);
    if (out_asm.len() == 0) {
      return 2;
    }
    if (!emit_text) {
      image = x86_kernel_image(out_asm, words_of(recs), ram_base);
      if (image.len() == 0) {
        return 2;
      }
    }
  } else if (target == "arm64-freestanding") {
    out_asm = asm_arm64_ir.emit_module_or_error_sub(full, false, sub, 0 as usize);
    if (out_asm.len() == 0) {
      return 2;
    }
    out_asm = freestanding_exports(merged, shared_roots, true) + out_asm;
  } else if (target == "arm64-android") {
    let recs = word_buf(emit_text);
    out_asm = asm_arm64_ir.emit_module_or_error_sub(full, false, sub, recs);
    if (out_asm.len() == 0) {
      return 2;
    }
    if (debug_lines) {
      out_asm = dw_file_table(entry_path, b.files, remaps) + out_asm;
    }
    if (shared) {
      out_asm = export_entries(merged, entry_names(merged, shared_roots), true, harden) + import_entries(merged, true) + out_asm;
    }
    out_asm += bti_property_text(emit_text && harden);
    if (!emit_text && shared) {
      image = arm64_elf_shared(out_asm, words_of(recs), shared_roots, slice_unchecked(out_path, util.last_slash(out_path) + 1, out_path.len()).to_owned(), target, merged, harden);
      if (image.len() == 0) {
        return 2;
      }
    } else if (!emit_text) {
      image = elfimage.arm64_elf_binary_pie(out_asm, words_of(recs), emit_syms, remap_path(remaps, entry_path), remap_path(remaps, comp_dir()), harden);
      if (image.len() == 0) {
        return 2;
      }
    }
  } else if (target == "arm64-darwin") {
    out_asm = asm_arm64_ir.emit_module_or_error_sub(full, true, sub, 0 as usize);
    util.arr_push_cliff_report("darwin:emitted", 0);
    out_asm = asm_arm64_ir.darwinize(out_asm);
    util.arr_push_cliff_report("darwin:darwinized", 0);
    if (out_asm.len() == 0) {
      return 2;
    }
    if (debug_lines) {
      out_asm = dw_file_table(entry_path, b.files, remaps) + out_asm;
    }
    if (!emit_text) {
      let prog = arm64_native.arm64_gas_program(out_asm);
      util.arr_push_cliff_report("darwin:assembled", 0);
      if (prog.unknown.len() > 0) {
        let _ar = elfimage.arm64_refusals("arm64-darwin", "assembler", prog.unknown);
        return 2;
      }
      let pa = prog.asm;
      let deh_len = arm64_native.arm64_eh_frame_darwin_len(prog);
      let tv = arm64_native.macho_text_vaddr_dw(pa.text.len(), deh_len, prog.data.len(), prog.bss_size, emit_syms);
      let ev = arm64_native.macho_eh_vaddr_dw(pa.text.len(), deh_len, prog.data.len(), prog.bss_size, emit_syms);
      let dv = arm64_native.macho_data_vaddr_dw(pa.text.len(), deh_len, prog.data.len(), prog.bss_size, emit_syms);
      let deh = arm64_native.arm64_eh_frame_darwin(prog, tv, ev);
      util.arr_push_cliff_report("darwin:unwind", 0);
      prog = arm64_native.arm64_gas_link_macho(prog, tv, dv);
      util.arr_push_cliff_report("darwin:linked", 0);
      if (prog.unknown.len() > 0) {
        let _lr = elfimage.arm64_refusals("arm64-darwin", "linker", prog.unknown);
        return 2;
      }
      let pa2 = prog.asm;
      let deoff = arm64_native.macho_entry_off(pa2);
      let dreb = arm64_native.arm64_gas_rebase_offs(prog);
      let dsym_names: string[] = [];
      let dsym_offs: i32[] = [];
      let dwarf: i32[][] = [];
      if (emit_syms) {
        dsym_names = pa2.lab_names;
        dsym_offs = pa2.lab_offs;
        dwarf = darwin_dwarf(prog, tv, dv, remap_path(remaps, entry_path), remap_path(remaps, comp_dir()));
      }
      image = util.to_u8(arm64_native.macho_executable_binds(pa2.text, arm64_native.arm64_code_len(prog), deh, prog.data, "fern", deoff, prog.bss_size, dreb, prog.bind_offs, prog.bind_syms, dsym_names, dsym_offs, dwarf));
      util.arr_push_cliff_report("darwin:image", 0);
    }
  } else if (target == "wasm32-wasi" && emit_text) {
    out_asm = wasm_ir.emit_module_mode_or_error_sub(full, false, false, sub);
  } else if (target == "wasm32-wasi" && emit == "core-module") {
    image = util.to_u8(emitforms.stamped_core(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error_sub(full, false, false, sub)), sub.switches));
  } else if (target == "wasm32-wasi") {
    let comp = emitforms.wasm_component(full, sub);
    if (comp.bytes.len() == 0) {
      if (comp.refused.len() > 0) {
        eprint(comp.refused);
      }
      return 2;
    }
    image = util.to_u8(comp.bytes);
  } else if (target == "wasm32-wasi-http" && emit_text) {
    out_asm = emitforms.wasm_http_core(full, sub);
  } else if (target == "wasm32-wasi-http" && emit == "core-module") {
    let hwat = emitforms.wasm_http_core(full, sub);
    if (hwat.len() == 0) {
      return 2;
    }
    image = util.to_u8(emitforms.stamped_core(watbin.wat_to_binary(hwat), sub.switches));
  } else if (target == "wasm32-wasi-http") {
    let hc = emitforms.wasm_http_component(full, sub);
    if (hc.bytes.len() == 0) {
      if (hc.refused.len() > 0) {
        eprint(emitforms.http_refused(hc.refused));
      }
      return 2;
    }
    image = util.to_u8(hc.bytes);
  } else if (target == "x86-64-freestanding") {
    out_asm = asm_ir.emit_module_or_error_sub(full, sub, 0 as usize);
    if (out_asm.len() == 0) {
      return 2;
    }
    out_asm = freestanding_exports(merged, shared_roots, false) + out_asm;
  } else {
    let recs = word_buf(emit_text);
    out_asm = asm_ir.emit_module_or_error_sub(full, sub, recs);
    if (debug_lines && out_asm.len() > 0) {
      out_asm = dw_file_table(entry_path, b.files, remaps) + out_asm;
    }
    if (shared && out_asm.len() > 0) {
      out_asm = export_entries(merged, entry_names(merged, shared_roots), false, harden) + import_entries(merged, false) + out_asm;
    }
    if (!emit_text && shared) {
      image = x86_elf_shared(out_asm, words_of(recs), shared_roots, slice_unchecked(out_path, util.last_slash(out_path) + 1, out_path.len()).to_owned(), target, merged);
      if (image.len() == 0) {
        return 2;
      }
    } else if (!emit_text) {
      image = elfimage.x86_elf_binary(out_asm, words_of(recs), emit_syms, remap_path(remaps, entry_path), remap_path(remaps, comp_dir()), pie, x86_executable_page_align(target));
      if (image.len() == 0) {
        return 2;
      }
    }
  }
  if (out_path.len() > 0) {
    match (write_output(out_path, out_asm, image, target, emit)) {
      Err(e) => {
        eprint("fern: cannot write output " + out_path + ": " + e.message());
        return 1;
      },
      Ok(_) => {}
    }
  } else if (image.len() > 0) {
    if let Err(e) = stdout().write_bytes(image[:]) {
      eprint("fern: cannot write output: " + e.message());
      return 1;
    }
  } else {
    write(out_asm);
  }
  let java_bad = write_jni_java(apk_opts.jni_java, out_path, jni) + write_jni_dex(apk_opts.jni_dex, out_path, jni);
  if (java_bad.len() > 0) {
    eprint("fern: " + java_bad);
    return 1;
  }
  if (tf.run_it) {
    return run_and_clean(target, out_path, run_dir, prog_args, tf.qemu);
  }
  return 0;
}
