function arm64_gas_scalar_class(tok: string): i32 {
  let t: string = arm64_gas_trim(tok);
  if (t.len() < 2) {
    return 0 - 1;
  }
  let c: i32 = t[0] as i32;
  let cls: i32 = 0 - 1;
  if (c == 98) {
    cls = 0;
  }
  if (c == 104) {
    cls = 1;
  }
  if (c == 115) {
    cls = 2;
  }
  if (c == 100) {
    cls = 3;
  }
  if (cls < 0) {
    return 0 - 1;
  }
  if (arm64_gas_scalar_reg(tok) < 0) {
    return 0 - 1;
  }
  return cls;
}

function arm64_gas_scalar_reg(tok: string): i32 {
  let t: string = arm64_gas_trim(tok);
  if (t.len() < 2) {
    return 0 - 1;
  }
  let n: i32 = 0;
  let i: i32 = 1;
  while (i < t.len()) {
    let c: i32 = t[i] as i32;
    if (c < 48 || c > 57) {
      return 0 - 1;
    }
    n = n * 10 + (c - 48);
    i = i + 1;
  }
  if (n > 31) {
    return 0 - 1;
  }
  return n;
}

function arm64_gas_vlist_one(tok: string): i32 {
  let t: string = arm64_gas_trim(tok);
  if (t.len() < 3 || t[0] != b'{' || t[t.len() - 1] != b'}') {
    return 0 - 1;
  }
  return arm64_gas_vreg_any(slice_unchecked(t, 1, t.len() - 1) + "");
}

function arm64_gas_vlist_table(tok: string): i32 {
  let t: string = arm64_gas_trim(tok);
  if (t.len() < 3 || t[0] != b'{' || t[t.len() - 1] != b'}') {
    return 0 - 1;
  }
  let inner: string = slice_unchecked(t, 1, t.len() - 1) + "";
  let dash: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < inner.len()) {
    if (inner[i] == b'-') {
      dash = i;
    }
    i = i + 1;
  }
  let first: string = inner;
  let last: string = inner;
  if (dash >= 0) {
    first = slice_unchecked(inner, 0, dash) + "";
    last = slice_unchecked(inner, dash + 1, inner.len()) + "";
  }
  let n: i32 = arm64_gas_vreg_any(first);
  let m: i32 = arm64_gas_vreg_any(last);
  if (n < 0 || m < 0 || arm64_gas_vreg_arrof(first) != 1 || arm64_gas_vreg_arrof(last) != 1) {
    return 0 - 1;
  }
  let span: i32 = (m - n + 32) % 32;
  if (span > 3 || dash >= 0 && span == 0) {
    return 0 - 1;
  }
  return span * 32 + n;
}

function arm64_gas_vlist_one_arr(tok: string): i32 {
  let t: string = arm64_gas_trim(tok);
  if (t.len() < 3 || t[0] != b'{' || t[t.len() - 1] != b'}') {
    return 0 - 1;
  }
  return arm64_gas_vreg_arrof(slice_unchecked(t, 1, t.len() - 1) + "");
}

function arm64_gas_narrow_wide_ok(narrow: i32, wide: i32, hi: boolean): boolean {
  if (narrow < 0 || wide < 0) {
    return false;
  }
  if (arm64_gas_arr_size(narrow) > 2) {
    return false;
  }
  if (arm64_gas_arr_q(narrow) != hi) {
    return false;
  }
  if (arm64_gas_arr_size(wide) != arm64_gas_arr_size(narrow) + 1) {
    return false;
  }
  return arm64_gas_arr_q(wide);
}

function arm64_gas_vecgen_handles(mnem: string): boolean {
  return arm64_v3int_entry(mnem) >= 0 || arm64_vlogical_entry(mnem) >= 0
    || arm64_vcmpzero_entry(mnem) >= 0 || arm64_v2misc_entry(mnem) >= 0
    || arm64_vfp3_entry(mnem) >= 0 || arm64_vfp2_entry(mnem) >= 0
    || arm64_vfpcmpzero_entry(mnem) >= 0 || arm64_vshift_entry(mnem) >= 0
    || arm64_vpermute_opc(mnem) >= 0 || arm64_vpolylong_entry(mnem) >= 0
    || arm64_pairlong_entry(mnem) >= 0
    || arm64_gas_family(mnem) == arm64_fam_shll() || arm64_gas_family(mnem) == arm64_fam_narrow()
    || arm64_gas_family(mnem) == arm64_fam_vecext();
}

function arm64_gas_emit_narrowwide(own a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
  if (arm64_gas_fcvt_nl(mnem) >= 0) {
    return arm64_gas_emit_fcvt_nl(a, mnem, ops);
  }
  if (mnem == "xtn" || mnem == "xtn2") {
    if (ops.len() != 2) {
      return a;
    }
    let xc: i32 = arm64_gas_vreg_arrof(ops[0]);
    arm64_push_arr(a.code, arm64_vec2misc(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      18, arm64_gas_arr_size(xc), arm64_gas_arr_q(xc), false,
    ));
    return a;
  }
  let kind: i32 = arm64_gas_shll_kind(mnem);
  if (kind < 0) {
    if (ops.len() != 3) {
      return a;
    }
    let nc: i32 = arm64_gas_vreg_arrof(ops[0]);
    let nes: i32 = arm64_gas_esize(nc);
    arm64_push_arr(a.code, arm64_vecshift(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      16, 2 * nes - arm64_gas_imm(ops[2]), arm64_gas_arr_q(nc), false,
    ));
    return a;
  }
  let alias: boolean = kind >= 4;
  if (ops.len() != 3 && !alias) {
    return a;
  }
  if (ops.len() != 2 && alias) {
    return a;
  }
  let sc: i32 = arm64_gas_vreg_arrof(ops[1]);
  let amt: i32 = 0;
  if (!alias) {
    amt = arm64_gas_imm(ops[2]);
  }
  arm64_push_arr(a.code, arm64_vecshift(
    [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
    20, arm64_gas_esize(sc) + amt, kind % 4 >= 2, kind % 2 == 1,
  ));
  return a;
}

function arm64_gas_emit_fcvt_nl(own a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
  if (ops.len() != 2) {
    return a;
  }
  arm64_push_arr(a.code, arm64_vec2misc(
    [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
    arm64_gas_fcvt_nl(mnem), 1, arm64_str_indexof(mnem, "2") == mnem.len() - 1, false,
  ));
  return a;
}

function arm64_gas_bad_fcvt_nl(mnem: string, ops: string[]): string {
  if (ops.len() != 2) {
    return mnem + ":arity";
  }
  if (arm64_gas_vreg_any(ops[0]) < 0 || arm64_gas_vreg_any(ops[1]) < 0) {
    return mnem + ":reg";
  }
  let narrow: i32 = arm64_gas_vreg_arrof(ops[0]);
  let wide: i32 = arm64_gas_vreg_arrof(ops[1]);
  if (arm64_gas_fcvt_nl(mnem) == 23) {
    narrow = arm64_gas_vreg_arrof(ops[1]);
    wide = arm64_gas_vreg_arrof(ops[0]);
  }
  if (arm64_gas_arr_size(narrow) != 2 || !arm64_gas_narrow_wide_ok(narrow, wide, arm64_str_indexof(mnem, "2") == mnem.len() - 1)) {
    return mnem + ":arr";
  }
  return "";
}

function arm64_gas_fcvt_nl(mnem: string): i32 {
  if (mnem == "fcvtn" || mnem == "fcvtn2") {
    return 22;
  }
  if (mnem == "fcvtl" || mnem == "fcvtl2") {
    return 23;
  }
  return 0 - 1;
}

function arm64_gas_emit_vecgen(own a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
  let czero: i32 = arm64_vcmpzero_entry(mnem);
  let three: i32 = arm64_v3int_entry(mnem);
  if (czero >= 0 && (three < 0 || ops.len() == 3 && ops[2].len() > 0 && ops[2][0] == b'#')) {
    if (ops.len() != 3) {
      return a;
    }
    let cc: i32 = arm64_gas_vreg_arrof(ops[0]);
    arm64_push_arr(a.code, arm64_vec2misc(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_vec_entry_op(czero), arm64_gas_arr_size(cc), arm64_gas_arr_q(cc), arm64_vec_entry_u(czero),
    ));
    return a;
  }
  if (three >= 0) {
    if (ops.len() != 3) {
      return a;
    }
    let tc: i32 = arm64_gas_vreg_arrof(ops[0]);
