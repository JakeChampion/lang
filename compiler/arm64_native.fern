    "adcs" => {
      return 0xba000000;
    },
    "sbc" => {
      return 0xda000000;
    },
    "sbcs" => {
      return 0xfa000000;
    },
    "ngc" => {
      return 0xda000000;
    },
    "ngcs" => {
      return 0xfa000000;
    },
    _ => {
      return -1;
    }
  }
}

