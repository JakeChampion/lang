// arm64_logical2_base maps a mnemonic to its base word (every register field zero); -1 = not one.
function arm64_logical2_base(mnem: string): i64 {
  match (mnem) {
    "ands" => {
      return 0xea000000;
    },
    "bic" => {
      return 0x8a200000;
    },
    "bics" => {
      return 0xea200000;
    },
    "orn" => {
      return 0xaa200000;
    },
    "eon" => {
      return 0xca200000;
    },
    "tst" => {
      return 0xea000000;
    },
    "mvn" => {
      return 0xaa200000;
    },
    _ => {
      return 0 - 1;
    }
  }
}

// arm64_carry_base maps a mnemonic to its base word (every register field zero); -1 = not one.
function arm64_carry_base(mnem: string): i64 {
  match (mnem) {
    "adc" => {
      return 0x9a000000;
    },
    "adcs" => {
      return 0xba000000;
    },
    "sbc" => {
      return 0xda000000;
    },
    "sbcs" => {
      return 0xfa000000;
    },
    "ngc" => {
      return 0xda000000;
    },
    "ngcs" => {
      return 0xfa000000;
    },
    _ => {
      return 0 - 1;
    }
  }
}

