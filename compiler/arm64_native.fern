function arm64_gas_addsub_imm_unsupported(mnem: string, ops: string[]): boolean {
  let at = 2;
  if (mnem == "cmp" || mnem == "cmn") {
    at = 1;
  } else if (mnem != "add" && mnem != "sub" && mnem != "adds" && mnem != "subs") {
    return false;
  }
  if (ops.len() <= at) {
    return false;
  }
  if (ops[at].len() == 0 || ops[at][0] != b'#') {
    return false;
  }
  let mag = arm64_addsub_imm_mag(arm64_gas_imm(ops[at]));
  if (ops.len() > at + 1) {
    if (arm64_gas_shift_type(ops[at + 1]) != 0) {
      return true;
    }
    let sh = arm64_gas_lsl_amount(ops[at + 1]);
    if (sh != 0 && sh != 12) {
      return true;
    }
    return mag < 0 || mag > 4095;
  }
  return !arm64_addsub_imm_ok(mag);
}

function arm64_gas_addsub_operand_unsupported(mnem: string, ops: string[]): boolean {
  if (mnem != "add" && mnem != "sub") {
    return false;
  }
  if (ops.len() < 4) {
    return false;
  }
  if (arm64_gas_shift_type(ops[3]) >= 0) {
    return false;
  }
  if (arm64_gas_extend_option(ops[3]).is_some()) {
    return false;
  }
  return true;
}

