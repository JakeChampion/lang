      return 0x9b407c00;
    },
    "madd" => {
      return 0x9b000000;
    },
    "smull" => {
      return 0x9b200000;
    },
    "umull" => {
      return 0x9ba00000;
    },
    "smaddl" => {
      return 0x9b200000;
    },
    "umaddl" => {
      return 0x9ba00000;
    },
    "smsubl" => {
      return 0x9b208000;
    },
    "umsubl" => {
      return 0x9ba08000;
    },
    _ => {
      return 0 - 1;
    }
  }
}

