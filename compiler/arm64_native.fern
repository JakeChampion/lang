    | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

function arm64_vecmovi(buf: i32[], rd: i32, imm8: i32, cmode: i32, q: boolean, op: boolean): i32[] {
  let abc = (imm8 / 32 & 7) as i64;
  let defgh = (imm8 & 31) as i64;
  let word = 0x0f000400 | abc << 16 | (cmode & 15) as i64 << 12 | defgh << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  if (op) {
    word = word | 0x20000000;
  }
  return arm64_le32(buf, word);
}

