// arm64_gas_esize is the element width in bits of an arrangement.
function arm64_gas_esize(code: i32): i32 {
  return 8 * arm64_gas_pow2(arm64_gas_arr_size(code));
}

// ---- the lane-move and load-structure classes (#8000 wave 2d) ----
//
// These address ONE LANE rather than a whole arrangement, and every one of
// them says which lane in the same field: imm5 packs the element size and the
// index together as (index<<1 | 1) << size, so the size is recoverable from
// the position of the lowest set bit. Get the size wrong and the index is
// wrong too, on a word that still decodes.

// arm64_gas_lane_size decodes the element letter of a `vN.<Ts>[i]` lane
// operand to 0=B, 1=H, 2=S, 3=D, or -1 when the token is not a lane.
function arm64_gas_lane_size(tok: string): i32 {
  let t: string = arm64_gas_trim(tok);
  let dot: i32 = arm64_str_indexof(t, ".");
  let ob: i32 = arm64_str_indexof(t, "[");
  if (t.len() < 5 || t[0] != b'v' || dot < 2 || ob < dot || t[t.len() - 1] != b']') {
    return 0 - 1;
  }
  if (ob != dot + 2) {
    return 0 - 1;
  }
  let c: i32 = t[dot + 1] as i32;
  if (c == 98) {  // 'b'
    return 0;
  }
  if (c == 104) {  // 'h'
    return 1;
  }
  if (c == 115) {  // 's'
    return 2;
  }
  if (c == 100) {  // 'd'
    return 3;
  }
  return 0 - 1;
}

function arm64_gas_lane_reg(tok: string): i32 {
  let t: string = arm64_gas_trim(tok);
  if (arm64_gas_lane_size(tok) < 0) {
    return 0 - 1;
  }
  let dot: i32 = arm64_str_indexof(t, ".");
  let n: i32 = 0;
  let i: i32 = 1;
  while (i < dot) {
    let c: i32 = t[i] as i32;
    if (c < 48 || c > 57) {
      return 0 - 1;
    }
    n = n * 10 + (c - 48);
    i = i + 1;
  }
  if (n > 31) {
    return 0 - 1;
  }
  return n;
}

function arm64_gas_lane_index(tok: string): i32 {
  let t: string = arm64_gas_trim(tok);
  let size: i32 = arm64_gas_lane_size(tok);
  if (size < 0) {
    return 0 - 1;
  }
  let ob: i32 = arm64_str_indexof(t, "[");
  let n: i32 = 0;
  let i: i32 = ob + 1;
  if (i >= t.len() - 1) {
    return 0 - 1;
  }
  while (i < t.len() - 1) {
    let c: i32 = t[i] as i32;
    if (c < 48 || c > 57) {
      return 0 - 1;
    }
    n = n * 10 + (c - 48);
    i = i + 1;
  }
  // A lane index runs 0..(16/esize - 1), which is 15>>size.
  if (n > 15 / arm64_gas_pow2(size)) {
    return 0 - 1;
  }
  return n;
}

// arm64_vec_imm5 packs an element size and lane index into the imm5 field:
// (index<<1 | 1) << size, so the size is the position of the lowest set bit.
function arm64_vec_imm5(size: i32, index: i32): i32 {
  return (index * 2 + 1) * arm64_gas_pow2(size);
}

// umov/smov move one lane to a general register; ins moves a general register
// or another lane INTO one. All four share the imm5 field.
//   umov 0x0E003C00, smov 0x0E002C00, ins-from-GPR 0x4E001C00
//   (ins is always Q=1: it writes into the 128-bit register)
function arm64_vecmovlane(buf: i32[], base: i64, rd: i32, rn: i32, imm5: i32, q: boolean): i32[] {
  let word: i64 = base | (imm5 & 31) as i64 << 16 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  return arm64_le32(buf, word);
}

// ins Vd.<Ts>[i], Vn.<Ts>[j] — lane to lane. imm4 is the SOURCE index scaled
// by the element size, in a field the GPR form does not have.
//   0x6E000400 | imm5<<16 | imm4<<11 | Rn<<5 | Rd
function arm64_vecinselem(buf: i32[], rd: i32, rn: i32, imm5: i32, imm4: i32): i32[] {
  return arm64_le32(buf, 0x6e000400 | (imm5 & 31) as i64 << 16 | (imm4 & 15) as i64 << 11
    | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

// dup broadcasts a general register or one lane across every lane.
//   from GPR  0x0E000C00 | Q<<30 | imm5<<16 | Rn<<5 | Rd, imm5 = 1<<size
//   from lane 0x0E000400 | Q<<30 | imm5<<16 | Rn<<5 | Rd
function arm64_vecdup(buf: i32[], base: i64, rd: i32, rn: i32, imm5: i32, q: boolean): i32[] {
  let word: i64 = base | (imm5 & 31) as i64 << 16 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  return arm64_le32(buf, word);
}

// movi Vd.<T>, #imm8{, lsl #shift} — the modified immediate. cmode says which
// BYTE POSITION of each element the imm8 lands in, so the shift is not a
// shift field: it selects the cmode. The .2d form is different again — each
// bit of imm8 expands to a whole byte of 0x00 or 0xff.
//   0x0F000400 | Q<<30 | op<<29 | abc<<16 | cmode<<12 | defgh<<5 | Rd
function arm64_vecmovi(buf: i32[], rd: i32, imm8: i32, cmode: i32, q: boolean, op: boolean): i32[] {
  let abc: i64 = (imm8 / 32 & 7) as i64;
  let defgh: i64 = (imm8 & 31) as i64;
  let word: i64 = 0x0f000400 | abc << 16 | (cmode & 15) as i64 << 12 | defgh << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  if (op) {
    word = word | 0x20000000;
  }
  return arm64_le32(buf, word);
}

// The single-register load/store-structure forms, `[Xn]` with no offset:
//   ld1r 0x0D40C000, ld1 0x0C407000, st1 0x0C007000, each | Q<<30 | size<<10
function arm64_vecldst1(buf: i32[], base: i64, rt: i32, rn: i32, size: i32, q: boolean): i32[] {
  let word: i64 = base | (size & 3) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  return arm64_le32(buf, word);
}

// ---- the narrowing / widening / across-lanes classes (#8000 wave 2c) ----

// arm64_vecext encodes `ext Vd.<T>, Vn.<T>, Vm.<T>, #index` — the byte-wise
// extract from a register pair, NEON's sliding window and palignr's
// counterpart. Byte arrangements only; the index counts bytes.
//   0x2E000000 | Q<<30 | Rm<<16 | index<<11 | Rn<<5 | Rd
function arm64_vecext(buf: i32[], rd: i32, rn: i32, rm: i32, index: i32, q: boolean): i32[] {
  let word: i64 = 0x2e000000 | (rm & 31) as i64 << 16 | (index & 15) as i64 << 11
    | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  return arm64_le32(buf, word);
}

// arm64_vectbl1 encodes `tbl Vd.<T>, {Vn.16b}, Vm.<T>` — the single-table
// byte shuffle, pshufb's counterpart. The table is always .16b.
//   0x0E000000 | Q<<30 | Rm<<16 | Rn<<5 | Rd
function arm64_vectbl1(buf: i32[], rd: i32, rn: i32, rm: i32, q: boolean): i32[] {
  let word: i64 = 0x0e000000 | (rm & 31) as i64 << 16
    | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  return arm64_le32(buf, word);
}

// arm64_vecacross encodes the across-lanes reductions: a horizontal fold of
// every lane into a scalar register.
//   0x0E300800 | Q<<30 | U<<29 | size<<22 | opcode<<12 | Rn<<5 | Rd
function arm64_vecacross(buf: i32[], rd: i32, rn: i32, opcode: i32, size: i32, q: boolean, u: boolean): i32[] {
  let word: i64 = 0x0e300800 | (size & 3) as i64 << 22
    | (opcode & 31) as i64 << 12 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  if (u) {
    word = word | 0x20000000;
  }
  return arm64_le32(buf, word);
}

