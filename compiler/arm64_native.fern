function arm64_gas_esize(code: i32): i32 {
  return 8 * arm64_gas_pow2(arm64_gas_arr_size(code));
}

function arm64_gas_lane_size(tok: string): i32 {
  let t = arm64_gas_trim(tok);
  let dot = util.index_of_sub(t, ".");
  let ob = util.index_of_sub(t, "[");
  if (t.len() < 5 || t[0] != b'v' || dot < 2 || ob < dot || t[t.len() - 1] != b']') {
    return -1;
  }
  if (ob != dot + 2) {
    return -1;
  }
  let c = t[dot + 1] as i32;
  return match (c) {
    98 => 0,
    104 => 1,
    115 => 2,
    100 => 3,
    _ => -1,
  };
}

function arm64_gas_lane_reg(tok: string): i32 {
  let t = arm64_gas_trim(tok);
  if (arm64_gas_lane_size(tok) < 0) {
    return -1;
  }
  let dot = util.index_of_sub(t, ".");
  let n = 0;
  let i = 1;
  while (i < dot) {
    let c = t[i] as i32;
    if (c < 48 || c > 57) {
      return -1;
    }
    n = n * 10 + (c - 48);
    i += 1;
  }
  if (n > 31) {
    return -1;
  }
  return n;
}

function arm64_gas_lane_index(tok: string): i32 {
  let t = arm64_gas_trim(tok);
  let size = arm64_gas_lane_size(tok);
  if (size < 0) {
    return -1;
  }
  let ob = util.index_of_sub(t, "[");
  let n = 0;
  let i = ob + 1;
  if (i >= t.len() - 1) {
    return -1;
  }
  while (i < t.len() - 1) {
    let c = t[i] as i32;
    if (c < 48 || c > 57) {
      return -1;
    }
    n = n * 10 + (c - 48);
    i += 1;
  }
  if (n > 15 / arm64_gas_pow2(size)) {
    return -1;
  }
  return n;
}

function arm64_vec_imm5(size: i32, index: i32): i32 {
  return (index * 2 + 1) * arm64_gas_pow2(size);
}

function arm64_veccopy(buf: i32[], base: i64, rd: i32, rn: i32, imm5: i32, q: boolean): i32[] {
  let word = base | (imm5 & 31) as i64 << 16 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
