function arm64_gas_family_len7_s(mnem: string): i32 {
  return match (mnem) {
    "sha256h" => arm64_fam_vecext(),
    "sha1su0" => arm64_fam_vecext(),
    "sha1su1" => arm64_fam_vecext(),
    _ => -1,
  };
}

function arm64_gas_family_len8(mnem: string): i32 {
  if (mnem == "sha256h2") {
    return arm64_fam_vecext();
  }
  return -1;
}

function arm64_gas_family_len9(mnem: string): i32 {
  if (mnem == "sha256su0") {
    return arm64_fam_vecext();
  }
  if (mnem == "sha256su1") {
    return arm64_fam_vecext();
  }
  return -1;
}

// arm64_logical2_base returns the base word with zero register fields, or -1 for an unknown mnemonic.
function arm64_logical2_base(mnem: string): i64 {
  match (mnem) {
    "ands" => {
      return 0xea000000;
    },
    "bic" => {
      return 0x8a200000;
    },
    "bics" => {
      return 0xea200000;
    },
    "orn" => {
      return 0xaa200000;
    },
    "eon" => {
      return 0xca200000;
    },
    "tst" => {
      return 0xea000000;
    },
    "mvn" => {
      return 0xaa200000;
    },
    _ => {
      return -1;
    }
  }
}

