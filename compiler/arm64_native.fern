// arm64_vecshift encodes the shift-by-immediate class. The element size and
// the shift amount SHARE the immh:immb field — immh's top set bit IS the
// element size, which is why the class has no size field of its own — so the
// caller derives it: esize+shift for a left shift, 2*esize-shift for a right
// one. Out of range the value carries into immh and selects a different
// element size, so the range check is the encoding's, not a nicety.
//   0x0F000400 | Q<<30 | U<<29 | immhb<<16 | opcode<<11 | Rn<<5 | Rd
function arm64_vecshift(buf: i32[], rd: i32, rn: i32, opcode: i32, immhb: i32, q: boolean, u: boolean): i32[] {
  let word: i64 = 0x0f000400 | (immhb & 0x7f) as i64 << 16
    | (opcode & 31) as i64 << 11 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  if (u) {
    word = word | 0x20000000;
  }
  return arm64_le32(buf, word);
}

// arm64_vecpermute encodes zip1/zip2/uzp1/uzp2/trn1/trn2.
//   0x0E000800 | Q<<30 | size<<22 | Rm<<16 | opc<<12 | Rn<<5 | Rd
function arm64_vecpermute(buf: i32[], rd: i32, rn: i32, rm: i32, opc: i32, size: i32, q: boolean): i32[] {
  let word: i64 = 0x0e000800 | (size & 3) as i64 << 22 | (rm & 31) as i64 << 16
    | (opc & 7) as i64 << 12 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  return arm64_le32(buf, word);
}

// The lane-wise FP ops read `size` as szHi<<1 | (D lanes) rather than as an
// element width, so their tables carry szHi where the integer ones carry a
// size mask; the arrangements are 2s/4s/2d throughout (mask 12 = S|D).
function arm64_gas_fp_size(code: i32, szhi: boolean): i32 {
  let v: i32 = 0;
  if (arm64_gas_arr_size(code) == 3) {
    v = 1;
  }
  if (szhi) {
    v = v + 2;
  }
  return v;
}

