  let aes: i32 = arm64_aes_opcode(mnem);
  if (aes >= 0) {
    if (ops.len() != 2) {
      return a;
    }
    arm64_push_arr(a.code, arm64_vecaes([], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]), aes));
    return a;
  }
  let sha: i32 = arm64_sha_opcode(mnem);
  if (sha >= 0) {
    let rm: i32 = 0;
    if (ops.len() == 3) {
      rm = arm64_gas_sha_reg(sha, 2, ops[2]);
    }
    arm64_push_arr(a.code, arm64_vecsha([], arm64_gas_sha_reg(sha, 0, ops[0]), arm64_gas_sha_reg(sha, 1, ops[1]), rm, sha));
