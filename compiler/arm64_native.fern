// arm64_gas_family is the index in the table of the family a mnemonic
// belongs to, or -1: length first, then the leading bytes, then the
// spellings left. The dispatch and arm64_gas_known read it.
function arm64_gas_family(mnem: string): i32 {
  let n: i32 = mnem.len();
  if (n == 1) {
    return arm64_gas_family_len1(mnem);
  }
  if (n == 2) {
    return arm64_gas_family_len2(mnem);
  }
  if (n == 3) {
    return arm64_gas_family_len3(mnem);
  }
  if (n == 4) {
    return arm64_gas_family_len4(mnem);
  }
  if (n == 5) {
    return arm64_gas_family_len5(mnem);
  }
  if (n == 6) {
    return arm64_gas_family_len6(mnem);
  }
  return 0 - 1;
}

function arm64_gas_family_len1(mnem: string): i32 {
  if (mnem == "b") {
    return arm64_fam_branch();
  }
  return 0 - 1;
}

function arm64_gas_family_len2(mnem: string): i32 {
  if (mnem == "br") {
    return arm64_fam_indirect();
  }
  if (mnem == "bl") {
    return arm64_fam_branch();
  }
  return 0 - 1;
}

function arm64_gas_family_len3(mnem: string): i32 {
  let c: u8 = mnem[0];
  if (c == b'a') {
    return arm64_gas_family_len3_a(mnem);
  }
  if (c == b'b') {
    return arm64_gas_family_len3_b(mnem);
  }
  if (c == b'c') {
    return arm64_gas_family_len3_c(mnem);
  }
  if (c == b'd') {
    return arm64_gas_family_len3_d(mnem);
  }
  if (c == b'e') {
    return arm64_gas_family_len3_e(mnem);
  }
  if (c == b'i') {
    return arm64_gas_family_len3_i(mnem);
  }
  if (c == b'l') {
    return arm64_gas_family_len3_l(mnem);
  }
  if (c == b'm') {
