    },
    "cset" => {
      return 0x9a800400;
    },
    "csetm" => {
      return 0xda800000;
    },
    "cinc" => {
      return 0x9a800400;
    },
    "cinv" => {
      return 0xda800000;
    },
    "cneg" => {
      return 0xda800400;
