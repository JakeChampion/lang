    if (ops.len() != 3) {
      return a;
    }
    let tc: i32 = arm64_gas_vreg_arrof(ops[0]);
    arm64_push_arr(a.code, arm64_vectbl(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vlist_table(ops[1]),
      arm64_gas_vreg_any(ops[2]), arm64_gas_arr_q(tc), mnem == "tbx",
    ));
    return a;
  }
  let poly: i32 = arm64_vpolylong_entry(mnem);
  if (poly >= 0) {
    if (ops.len() != 3) {
      return a;
    }
    let yc: i32 = arm64_gas_vreg_arrof(ops[1]);
    arm64_push_arr(a.code, arm64_vec3diff(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_gas_vreg_any(ops[2]), arm64_vec_entry_op(poly), arm64_gas_arr_size(yc), arm64_gas_arr_q(yc), arm64_vec_entry_u(poly),
    ));
    return a;
  }
  let pm: i32 = arm64_vpermute_opc(mnem);
  if (pm < 0 || ops.len() != 3) {
    return a;
  }
  let pc: i32 = arm64_gas_vreg_arrof(ops[0]);
  arm64_push_arr(a.code, arm64_vecpermute(
    [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
    arm64_gas_vreg_any(ops[2]), pm, arm64_gas_arr_size(pc), arm64_gas_arr_q(pc),
  ));
  return a;
}

function arm64_ldrb(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x39400000 | (off & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_strb(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x39000000 | (off & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_ldrb_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x38400400 | (off & 0x1ff) as i64 << 12 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_strb_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x38000400 | (off & 0x1ff) as i64 << 12 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_ldrh(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x79400000 | (off / 2 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_strh(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x79000000 | (off / 2 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_ldrsw(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0xb9800000 | (off / 4 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_ldrsb(buf: i32[], rt: i32, rn: i32, off: i32, w: boolean): i32[] {
  let base: i64 = 0x39800000;
  if (w) {
    base = 0x39c00000;
  }
  return arm64_le32(buf, base | (off & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_ldrsh(buf: i32[], rt: i32, rn: i32, off: i32, w: boolean): i32[] {
  let base: i64 = 0x79800000;
  if (w) {
    base = 0x79c00000;
  }
  return arm64_le32(buf, base | (off / 2 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_mrs_base(name: string): i64 {
  if (name == "cntvct_el0") {
    return 0xd53be040;
  }
  if (name == "cntfrq_el0") {
    return 0xd53be000;
  }
  if (name == "tpidr_el0") {
    return 0xd53bd040;
  }
  if (name == "nzcv") {
    return 0xd53b4200;
  }
  if (name == "fpcr") {
    return 0xd53b4400;
  }
  if (name == "fpsr") {
    return 0xd53b4420;
  }
  if (name == "dczid_el0") {
    return 0xd53b00e0;
  }
  return 0 - 1;
}

function arm64_mrs(buf: i32[], rt: i32, name: string): i32[] {
  return arm64_le32(buf, arm64_mrs_base(name) | (rt & 31) as i64);
}

function arm64_msr_base(name: string): i64 {
  if (name == "tpidr_el0") {
    return 0xd51bd040;
  }
  if (name == "nzcv") {
    return 0xd51b4200;
  }
  if (name == "fpcr") {
    return 0xd51b4400;
  }
  if (name == "fpsr") {
    return 0xd51b4420;
  }
  return 0 - 1;
}

function arm64_msr(buf: i32[], rt: i32, name: string): i32[] {
  return arm64_le32(buf, arm64_msr_base(name) | (rt & 31) as i64);
}

function arm64_fp_single(word: i64, single: boolean): i64 {
  if (single) {
    return word & 0xffbfffff;
  }
  return word;
}

function arm64_fp3(buf: i32[], base: i64, rd: i32, rn: i32, rm: i32, single: boolean): i32[] {
  let word: i64 = base | (rm & 31) as i64 << 16 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  return arm64_le32(buf, arm64_fp_single(word, single));
}

function arm64_fp4(buf: i32[], base: i64, rd: i32, rn: i32, rm: i32, ra: i32, single: boolean): i32[] {
  let word: i64 = base | (rm & 31) as i64 << 16 | (ra & 31) as i64 << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  return arm64_le32(buf, arm64_fp_single(word, single));
}

function arm64_fcsel(buf: i32[], rd: i32, rn: i32, rm: i32, cond: i32, single: boolean): i32[] {
  let word: i64 = 0x1e600c00 | (rm & 31) as i64 << 16 | (cond & 15) as i64 << 12 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  return arm64_le32(buf, arm64_fp_single(word, single));
}

function arm64_fccmp(buf: i32[], rn: i32, rm: i32, nzcv: i32, cond: i32, single: boolean): i32[] {
  let word: i64 = 0x1e600400 | (rm & 31) as i64 << 16 | (cond & 15) as i64 << 12 | (rn & 31) as i64 << 5 | (nzcv & 15) as i64;
  return arm64_le32(buf, arm64_fp_single(word, single));
}

function arm64_funary_d(buf: i32[], base: i64, rd: i32, rn: i32, single: boolean): i32[] {
  return arm64_le32(buf, arm64_fp_single(base | (rn & 31) as i64 << 5 | (rd & 31) as i64, single));
}

function arm64_fcmp(buf: i32[], rn: i32, rm: i32, opc: i32, single: boolean): i32[] {
  let word: i64 = 0x1e602000 | (rm & 31) as i64 << 16 | (rn & 31) as i64 << 5 | (opc & 0x18) as i64;
  return arm64_le32(buf, arm64_fp_single(word, single));
}

function arm64_fmov_dd(buf: i32[], rd: i32, rn: i32): i32[] {
  return arm64_le32(buf, 0x1e604000 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

function arm64_fmov_from_gpr(buf: i32[], rd_fp: i32, rn_gpr: i32): i32[] {
  return arm64_le32(buf, 0x9e670000 | (rn_gpr & 31) as i64 << 5 | (rd_fp & 31) as i64);
}

function arm64_fmov_to_gpr(buf: i32[], rd_gpr: i32, rn_fp: i32): i32[] {
  return arm64_le32(buf, 0x9e660000 | (rn_fp & 31) as i64 << 5 | (rd_gpr & 31) as i64);
}

function arm64_fmov_s_from_gpr(buf: i32[], rd_fp: i32, rn_gpr: i32): i32[] {
  return arm64_le32(buf, 0x1e270000 | (rn_gpr & 31) as i64 << 5 | (rd_fp & 31) as i64);
}

function arm64_fmov_s_to_gpr(buf: i32[], rd_gpr: i32, rn_fp: i32): i32[] {
  return arm64_le32(buf, 0x1e260000 | (rn_fp & 31) as i64 << 5 | (rd_gpr & 31) as i64);
}

function arm64_fcvt_s_d(buf: i32[], rd: i32, rn: i32): i32[] {
  return arm64_le32(buf, 0x1e624000 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

function arm64_fcvt_d_s(buf: i32[], rd: i32, rn: i32): i32[] {
  return arm64_le32(buf, 0x1e22c000 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

function arm64_fcvtz_int(buf: i32[], rd_gpr: i32, rn_fp: i32, w: boolean, unsigned: boolean): i32[] {
  let base: i64 = 0x9e780000;
  if (unsigned) {
    base = 0x9e790000;
  }
  if (w) {
    base = 0x1e780000;
    if (unsigned) {
      base = 0x1e790000;
    }
  }
  return arm64_le32(buf, base | (rn_fp & 31) as i64 << 5 | (rd_gpr & 31) as i64);
}

function arm64_cvtf(buf: i32[], rd_fp: i32, rn_gpr: i32, w: boolean, unsigned: boolean): i32[] {
  let base: i64 = 0x9e620000;
  if (unsigned) {
    base = 0x9e630000;
  }
  if (w) {
    base = 0x1e620000;
    if (unsigned) {
      base = 0x1e630000;
    }
  }
  return arm64_le32(buf, base | (rn_gpr & 31) as i64 << 5 | (rd_fp & 31) as i64);
}

function arm64_str_indexof(s: string, sub: string): i32 {
  let n: i32 = s.len();
  let m: i32 = sub.len();
  if (m == 0) {
    return 0;
  }
  if (m > n) {
    return 0 - 1;
  }
  let c0: u8 = sub[0];
  if (m == 1) {
    return __memchr(s, c0 as i32, 0);
  }
  let last: i32 = n - m;
  let i: i32 = 0;
  while (i <= last) {
    i = __memchr(s, c0 as i32, i);
    if (i < 0 || i > last) {
      return 0 - 1;
    }
    let j: i32 = 1;
    while (j < m && s[i + j] == sub[j]) {
      j = j + 1;
    }
    if (j == m) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function arm64_str_starts_with(s: string, pre: string): boolean {
  let m: i32 = pre.len();
  if (m > s.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < m) {
    if (s[i] != pre[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function arm64_str_contains(s: string, sub: string): boolean {
  return arm64_str_indexof(s, sub) >= 0;
}

function arm64_gas_trim_lo(s: string, from: i32, to: i32): i32 {
  let i: i32 = from;
  while (i < to && (s[i] == b' ' || s[i] == b'\t')) {
    i = i + 1;
  }
  return i;
}

function arm64_gas_trim_hi(s: string, from: i32, to: i32): i32 {
  let j: i32 = to;
  while (j > from && (s[j - 1] == b' ' || s[j - 1] == b'\t')) {
    j = j - 1;
  }
  return j;
}

function arm64_gas_trim_span(s: string, from: i32, to: i32): string {
  let i: i32 = arm64_gas_trim_lo(s, from, to);
  return slice_unchecked(s, i, arm64_gas_trim_hi(s, i, to)) + "";
}

function arm64_gas_trim(s: string): string {
  return arm64_gas_trim_span(s, 0, s.len());
}

function arm64_gas_atoi(tok: string): i32 {
  let s: string = tok;
  let neg: boolean = false;
  let i: i32 = 0;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  }
  let v: i32 = 0;
  if (i + 1 < s.len() && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
    i = i + 2;
    while (i < s.len()) {
      let c: i32 = s[i] as i32;
      let d: i32 = 0 - 1;
      if (c >= 48 && c <= 57) {
        d = c - 48;
      } else {
        if (c >= 97 && c <= 102) {
          d = c - 97 + 10;
        } else {
          if (c >= 65 && c <= 70) {
            d = c - 65 + 10;
          }
        }
      }
      if (d >= 0) {
        v = v * 16 + d;
      }
      i = i + 1;
    }
  } else {
    while (i < s.len()) {
      let c2: i32 = s[i] as i32;
      if (c2 >= 48 && c2 <= 57) {
        v = v * 10 + (c2 - 48);
      }
      i = i + 1;
    }
  }
  if (neg) {
    return 0 - v;
  }
  return v;
}

function arm64_gas_imm(tok: string): i32 {
  let i: i32 = arm64_gas_trim_lo(tok, 0, tok.len());
  let j: i32 = arm64_gas_trim_hi(tok, i, tok.len());
  if (j > i && tok[i] == b'#') {
    i = i + 1;
  }
  return arm64_gas_atoi(slice_unchecked(tok, i, j));
}

function arm64_gas_imm64(tok: string): i64 {
  let i: i32 = arm64_gas_trim_lo(tok, 0, tok.len());
  let j: i32 = arm64_gas_trim_hi(tok, i, tok.len());
  if (j > i && tok[i] == b'#') {
    i = i + 1;
  }
  return arm64_gas_atoi64(slice_unchecked(tok, i, j));
}

function arm64_gas_reg(tok: string): i32 {
  let i: i32 = arm64_gas_trim_lo(tok, 0, tok.len());
  let j: i32 = arm64_gas_trim_hi(tok, i, tok.len());
  let alias: i32 = arm64_gas_reg_alias(tok, i, j);
  if (alias >= 0) {
    return alias;
  }
  if (j - i < 2 || !(tok[i] == b'x' || tok[i] == b'w' || tok[i] == b'd' || tok[i] == b's')) {
    return 0 - 1;
  }
  let n: i32 = 0;
  let k: i32 = i + 1;
  while (k < j) {
    let c: i32 = tok[k] as i32;
    if (c < 48 || c > 57) {
      return 0 - 1;
    }
    n = n * 10 + (c - 48);
    k = k + 1;
  }
  let lim: i32 = 30;
  if (tok[i] == b'd' || tok[i] == b's') {
    lim = 31;
  }
  if (n > lim) {
    return 0 - 1;
  }
  return n;
}

function arm64_gas_reg_alias(tok: string, i: i32, j: i32): i32 {
  let len: i32 = j - i;
  if (len == 2) {
    if (tok[i] == b's' && tok[i + 1] == b'p') {
      return 31;
    }
    if (tok[i] == b'l' && tok[i + 1] == b'r') {
      return 30;
    }
    if (tok[i] == b'f' && tok[i + 1] == b'p') {
      return 29;
    }
  }
  if (len == 3 && (tok[i] == b'x' || tok[i] == b'w') && tok[i + 1] == b'z' && tok[i + 2] == b'r') {
    return 31;
  }
  return 0 - 1;
}

function arm64_gas_bad_reg_token(ops: string[]): string {
  let i: i32 = 0;
  while (i < ops.len()) {
    let t: string = ops[i];
    if (t.len() > 0 && t[0] == b'[') {
      let rb: i32 = arm64_str_indexof(t, "]");
      if (rb > 1) {
        let bad: string = arm64_gas_bad_reg_piece(t, 1, rb);
        if (bad.len() > 0) {
          return bad;
        }
      }
    } else if (arm64_gas_reg_shaped_bad(t)) {
      return t;
    }
    i = i + 1;
  }
  return "";
}

function arm64_gas_bad_reg_piece(s: string, lo: i32, hi: i32): string {
  let depth: i32 = 0;
  let start: i32 = lo;
  let i: i32 = lo;
  while (i <= hi) {
    if (i == hi || s[i] == b',' && depth == 0) {
      let a: i32 = arm64_gas_trim_lo(s, start, i);
      let tok: str = slice_unchecked(s, a, arm64_gas_trim_hi(s, a, i));
      if (arm64_gas_reg_shaped_bad(tok)) {
        return tok + "";
      }
      start = i + 1;
    } else if (s[i] == b'[') {
      depth = depth + 1;
    } else if (s[i] == b']') {
      depth = depth - 1;
    }
    i = i + 1;
  }
  return "";
}

function arm64_gas_bad_ldst_reg(mnem: string, ops: string[]): string {
  if (arm64_sha_opcode(mnem) >= 0) {
    return "";
  }
  let n: i32 = 0;
  if (mnem == "ldp" || mnem == "stp" || mnem == "ldpsw") {
    n = 2;
  } else if (mnem == "ldr" || mnem == "str" || mnem == "ldur" || mnem == "stur"
    || mnem == "ldrb" || mnem == "strb" || mnem == "ldrh" || mnem == "strh"
    || mnem == "ldrsb" || mnem == "ldrsh" || mnem == "ldrsw") {
    n = 1;
  }
  let qok: boolean = mnem == "ldr" || mnem == "str" || mnem == "ldur" || mnem == "stur" || mnem == "ldp" || mnem == "stp";
  let i: i32 = 0;
  while (i < ops.len()) {
    let q: boolean = arm64_gas_is_qreg(ops[i]);
    if (q && (i >= n || !qok || arm64_gas_qreg(ops[i]) < 0)) {
      return arm64_gas_trim(ops[i]);
    }
    if (i < n && !q && arm64_gas_reg(ops[i]) < 0) {
      return arm64_gas_trim(ops[i]);
    }
    i = i + 1;
  }
  return "";
}

function arm64_gas_is_qreg(tok: string): boolean {
  let n: i32 = tok.len();
  let i: i32 = arm64_gas_trim_lo(tok, 0, n);
  return i + 1 < n && tok[i] == b'q' && tok[i + 1] >= b'0' && tok[i + 1] <= b'9';
}

function arm64_gas_qreg(tok: string): i32 {
  if (!arm64_gas_is_qreg(tok)) {
    return 0 - 1;
  }
  let i: i32 = arm64_gas_trim_lo(tok, 0, tok.len());
  let j: i32 = arm64_gas_trim_hi(tok, i, tok.len());
  let n: i32 = 0;
  let k: i32 = i + 1;
  while (k < j) {
    let c: i32 = tok[k] as i32;
    if (c < 48 || c > 57) {
      return 0 - 1;
    }
    n = n * 10 + (c - 48);
    k = k + 1;
  }
  if (n > 31) {
    return 0 - 1;
  }
  return n;
}

function arm64_gas_fp_ldst_size(tok: string): i32 {
  if (arm64_gas_is_qreg(tok)) {
    return 4;
  }
  if (arm64_gas_is_d(tok)) {
    return 3;
  }
  if (arm64_gas_is_sreg(tok)) {
    return 2;
  }
  return 0;
}

function arm64_gas_fp_regnum(tok: string): i32 {
  if (arm64_gas_is_qreg(tok)) {
    return arm64_gas_qreg(tok);
  }
  return arm64_gas_reg(tok);
}

function arm64_gas_reg_shaped_bad(t: string): boolean {
  return t.len() >= 2 && (t[0] == b'x' || t[0] == b'w' || t[0] == b'd' || t[0] == b's')
    && t[1] >= b'0' && t[1] <= b'9' && arm64_gas_reg(t) < 0;
}

function arm64_gas_cond(s: string): i32 {
  if (s == "eq") {
    return 0;
  }
  if (s == "ne") {
    return 1;
  }
  if (s == "cs" || s == "hs") {
    return 2;
  }
  if (s == "cc" || s == "lo") {
    return 3;
  }
  if (s == "mi") {
    return 4;
  }
  if (s == "pl") {
    return 5;
  }
  if (s == "vs") {
    return 6;
  }
  if (s == "vc") {
    return 7;
  }
  if (s == "hi") {
    return 8;
  }
  if (s == "ls") {
    return 9;
  }
  if (s == "ge") {
    return 10;
  }
  if (s == "lt") {
    return 11;
  }
  if (s == "gt") {
    return 12;
  }
  if (s == "le") {
    return 13;
  }
  if (s == "al") {
    return 14;
  }
  if (s == "nv") {
    return 15;
  }
  return 0 - 1;
}

function arm64_gas_is_cond(s: string): boolean {
  return s == "eq" || s == "ne" || s == "cs" || s == "hs" || s == "cc" || s == "lo"
    || s == "mi" || s == "pl" || s == "vs" || s == "vc" || s == "hi" || s == "ls"
    || s == "ge" || s == "lt" || s == "gt" || s == "le" || s == "al" || s == "nv";
}

function arm64_gas_is_w(tok: string): boolean {
  let n: i32 = tok.len();
  let i: i32 = arm64_gas_trim_lo(tok, 0, n);
  return i < n && tok[i] == b'w';
}

function arm64_gas_is_d(tok: string): boolean {
  let n: i32 = tok.len();
  let i: i32 = arm64_gas_trim_lo(tok, 0, n);
  return i < n && tok[i] == b'd';
}

function arm64_gas_is_s(tok: string): boolean {
  let n: i32 = tok.len();
  let i: i32 = arm64_gas_trim_lo(tok, 0, n);
  return i < n && tok[i] == b's';
}

function arm64_gas_is_sreg(tok: string): boolean {
  let n: i32 = tok.len();
  let i: i32 = arm64_gas_trim_lo(tok, 0, n);
  return i + 1 < n && tok[i] == b's' && tok[i + 1] >= b'0' && tok[i + 1] <= b'9';
}

function arm64_gas_arr_code(arr: string): i32 {
  if (arr == "8b") {
    return 0;
  }
  if (arr == "16b") {
    return 1;
  }
  if (arr == "4h") {
    return 2;
  }
  if (arr == "8h") {
    return 3;
  }
  if (arr == "2s") {
    return 4;
  }
  if (arr == "4s") {
    return 5;
  }
  if (arr == "1d") {
    return 6;
  }
  if (arr == "2d") {
    return 7;
  }
  if (arr == "1q") {
    return 9;
  }
  return 0 - 1;
}

function arm64_gas_arr_size(code: i32): i32 {
  return code / 2;
}

function arm64_gas_arr_q(code: i32): boolean {
  return code % 2 == 1;
}

function arm64_gas_vreg_any(tok: string): i32 {
  let s: string = arm64_gas_trim(tok);
  let dot: i32 = arm64_str_indexof(s, ".");
  if (s.len() < 4 || s[0] != b'v' || dot < 2) {
    return 0 - 1;
  }
  let n: i32 = 0;
  let i: i32 = 1;
  while (i < dot) {
    let c: i32 = s[i] as i32;
    if (c < 48 || c > 57) {
      return 0 - 1;
    }
    n = n * 10 + (c - 48);
    i = i + 1;
  }
  if (n > 31) {
    return 0 - 1;
  }
  if (arm64_gas_arr_code(slice_unchecked(s, dot + 1, s.len()) + "") < 0) {
    return 0 - 1;
  }
  return n;
}

function arm64_gas_vreg_arrof(tok: string): i32 {
  let s: string = arm64_gas_trim(tok);
  let dot: i32 = arm64_str_indexof(s, ".");
  if (dot < 0 || dot + 1 >= s.len()) {
    return 0 - 1;
  }
  return arm64_gas_arr_code(slice_unchecked(s, dot + 1, s.len()) + "");
}

function arm64_gas_is_vecarr(tok: string): boolean {
  let n: i32 = tok.len();
  let i: i32 = arm64_gas_trim_lo(tok, 0, n);
  return i + 1 < n && tok[i] == b'v' && tok[i + 1] >= b'0' && tok[i + 1] <= b'9'
    && arm64_str_indexof(tok, ".") > 0;
}

function arm64_gas_routes_vec(mnem: string, ops: string[]): boolean {
  return ops.len() > 0 && (arm64_gas_is_vecarr(ops[0]) || arm64_sha_opcode(mnem) >= 0);
}

function arm64_gas_arr_allowed(sizes: i32, code: i32): boolean {
  let size: i32 = arm64_gas_arr_size(code);
  if (size == 3 && !arm64_gas_arr_q(code)) {
    return false;
  }
  return sizes / arm64_gas_pow2(size) % 2 == 1;
}

function arm64_gas_pow2(n: i32): i32 {
  let v: i32 = 1;
  let i: i32 = 0;
  while (i < n) {
    v = v * 2;
    i = i + 1;
  }
  return v;
}

function arm64_gas_cond_operand(mnem: string): i32 {
  if (mnem == "cset" || mnem == "csetm") {
    return 1;
  }
  if (mnem == "cinc" || mnem == "cinv" || mnem == "cneg") {
    return 2;
  }
  if (mnem == "csel" || mnem == "csinc" || mnem == "csinv" || mnem == "csneg"
    || mnem == "ccmp" || mnem == "ccmn"
    || mnem == "fcsel" || mnem == "fccmp") {
    return 3;
  }
  return 0 - 1;
}

function arm64_gas_cond_inverts(mnem: string): boolean {
  return mnem == "cset" || mnem == "csetm"
    || mnem == "cinc" || mnem == "cinv" || mnem == "cneg";
}

function arm64_gas_bad_cond_token(mnem: string, ops: string[]): string {
  let idx: i32 = arm64_gas_cond_operand(mnem);
  if (idx < 0) {
    return "";
  }
  if (ops.len() <= idx) {
    return mnem + ":arity";
  }
  let c: string = ops[idx];
  if (arm64_gas_cond(c) < 0) {
    return c;
  }
  if (arm64_gas_cond_inverts(mnem) && (c == "al" || c == "nv")) {
    return c;
  }
  return "";
}

function arm64_gas_bad_lane(mnem: string, ops: string[], lm: Arm64Mem): string {
  if (mnem == "ld1" || mnem == "st1" || mnem == "ld1r") {
    if (ops.len() != 2) {
      return mnem + ":arity";
    }
    if (arm64_gas_vlist_one(ops[0]) < 0) {
      return arm64_gas_trim(ops[0]);
    }
    let lc: i32 = arm64_gas_vlist_one_arr(ops[0]);
    if (lc < 0) {
      return arm64_gas_trim(ops[0]);
    }
    if (arm64_gas_arr_size(lc) > 3) {
      return arm64_gas_trim(ops[0]);
    }
    let m: Arm64Mem = arm64_gas_mem_at(ops, 1, lm);
    if (m.base < 0 || m.off != 0 || m.off_reg >= 0) {
      return arm64_gas_trim(ops[1]);
    }
    return "";
  }
  if (mnem == "umov" || mnem == "smov") {
    if (ops.len() != 2) {
      return mnem + ":arity";
    }
    let usz: i32 = arm64_gas_lane_size(ops[1]);
    if (usz < 0 || arm64_gas_lane_index(ops[1]) < 0) {
      return arm64_gas_trim(ops[1]);
    }
    if (arm64_gas_reg(ops[0]) < 0) {
      return arm64_gas_trim(ops[0]);
    }
    let uw: boolean = arm64_gas_is_w(ops[0]);
    if (mnem == "umov") {
      if (uw == (usz == 3)) {
        return mnem + ":dst";
      }
      return "";
    }
    if (usz == 3) {
      return mnem + ":arr";
    }
    if (uw && usz > 1) {
      return mnem + ":dst";
    }
    return "";
  }
  if (mnem == "ins") {
    if (ops.len() != 2) {
      return mnem + ":arity";
    }
    let isz: i32 = arm64_gas_lane_size(ops[0]);
    if (isz < 0 || arm64_gas_lane_index(ops[0]) < 0) {
      return arm64_gas_trim(ops[0]);
    }
    let ssz: i32 = arm64_gas_lane_size(ops[1]);
    if (ssz >= 0) {
      if (ssz != isz) {
        return mnem + ":arr";
      }
      if (arm64_gas_lane_index(ops[1]) < 0) {
        return arm64_gas_trim(ops[1]);
      }
      return "";
    }
    if (arm64_gas_reg(ops[1]) < 0) {
      return arm64_gas_trim(ops[1]);
    }
    if (arm64_gas_is_w(ops[1]) == (isz == 3)) {
      return mnem + ":src";
    }
    return "";
  }
  if (mnem == "dup") {
    if (ops.len() != 2) {
      return mnem + ":arity";
    }
    let dc: i32 = arm64_gas_vreg_arrof(ops[0]);
    if (arm64_gas_vreg_any(ops[0]) < 0) {
      return arm64_gas_trim(ops[0]);
    }
    if (!arm64_gas_arr_allowed(15, dc)) {
      return mnem + ":arr";
    }
    let dsz: i32 = arm64_gas_arr_size(dc);
    let lsz: i32 = arm64_gas_lane_size(ops[1]);
    if (lsz >= 0) {
      if (lsz != dsz) {
        return mnem + ":arr";
      }
      if (arm64_gas_lane_index(ops[1]) < 0) {
        return arm64_gas_trim(ops[1]);
      }
      return "";
    }
    if (arm64_gas_reg(ops[1]) < 0) {
      return arm64_gas_trim(ops[1]);
    }
    if (arm64_gas_is_w(ops[1]) == (dsz == 3)) {
      return mnem + ":src";
    }
    return "";
  }
  if (ops.len() < 2 || ops.len() > 3) {
    return mnem + ":arity";
  }
  let vc: i32 = arm64_gas_vreg_arrof(ops[0]);
  if (arm64_gas_vreg_any(ops[0]) < 0) {
    return arm64_gas_trim(ops[0]);
  }
  if (!arm64_gas_arr_allowed(15, vc)) {
    return mnem + ":arr";
  }
  let vimm: i32 = arm64_gas_imm(ops[1]);
  if (vimm < 0 || vimm > 255) {
    return mnem + ":imm";
  }
  let vsz: i32 = arm64_gas_arr_size(vc);
  let vshift: i32 = 0;
  if (ops.len() == 3) {
    vshift = arm64_gas_lsl_amount(ops[2]);
  }
  if (vsz == 3 && ops.len() != 2) {
    return mnem + ":imm";
  }
  if (vsz == 0 && vshift != 0) {
    return mnem + ":imm";
  }
  if (vsz == 1 && vshift != 0 && vshift != 8) {
    return mnem + ":imm";
  }
  if (vsz == 2 && (vshift % 8 != 0 || vshift > 24)) {
    return mnem + ":imm";
  }
  return "";
}

function arm64_gas_bad_vec_token(mnem: string, ops: string[], lm: Arm64Mem): string {
  let fam: i32 = arm64_gas_family(mnem);
  if (fam == arm64_fam_vecldst() || fam == arm64_fam_vecmov() || fam == arm64_fam_movi()) {
    return arm64_gas_bad_lane(mnem, ops, lm);
  }
  if (arm64_across_entry(mnem) >= 0) {
    return arm64_gas_bad_across(mnem, ops);
  }
  if (arm64_gas_routes_vec(mnem, ops)) {
    return arm64_gas_bad_vecgen(mnem, ops);
  }
  return "";
}

function arm64_gas_bad_across(mnem: string, ops: string[]): string {
  let e: i32 = arm64_across_entry(mnem);
  if (ops.len() != 2) {
    return mnem + ":arity";
  }
  if (arm64_gas_vreg_any(ops[1]) < 0) {
    return arm64_gas_trim(ops[1]);
  }
  let code: i32 = arm64_gas_vreg_arrof(ops[1]);
  let size: i32 = arm64_gas_arr_size(code);
  if (size == 3 || size == 2 && !arm64_gas_arr_q(code)) {
    return mnem + ":arr";
  }
  let cls: i32 = arm64_gas_scalar_class(ops[0]);
  if (cls < 0) {
    return arm64_gas_trim(ops[0]);
  }
  let want: i32 = size;
  if (arm64_vec_entry_sizes(e) == 1) {
    want = want + 1;
  }
  if (cls != want) {
    return mnem + ":dst";
  }
  return "";
}

function arm64_gas_bad_pairlong(mnem: string, ops: string[]): string {
  if (ops.len() != 2) {
    return mnem + ":arity";
  }
  let dst: i32 = arm64_gas_vreg_arrof(ops[0]);
  let src: i32 = arm64_gas_vreg_arrof(ops[1]);
  if (dst < 0) {
    return arm64_gas_trim(ops[0]);
  }
  if (src < 0) {
    return arm64_gas_trim(ops[1]);
  }
  if (arm64_gas_arr_size(src) > 2) {
    return mnem + ":arr";
  }
  if (arm64_gas_arr_size(dst) != arm64_gas_arr_size(src) + 1 || arm64_gas_arr_q(dst) != arm64_gas_arr_q(src)) {
    return mnem + ":dst";
  }
  return "";
}

function arm64_gas_bad_vecgen(mnem: string, ops: string[]): string {
  let pmbad: string = arm64_gas_bad_pmull(mnem, ops);
  if (pmbad != "-") {
    return pmbad;
  }
  let aesbad: string = arm64_gas_bad_aes(mnem, ops);
  if (aesbad != "-") {
    return aesbad;
  }
  let shabad: string = arm64_gas_bad_sha(mnem, ops);
  if (shabad != "-") {
    return shabad;
  }
  let nwbad: string = arm64_gas_bad_narrowwide(mnem, ops);
  if (nwbad != "-") {
    return nwbad;
  }
  if (arm64_pairlong_entry(mnem) >= 0) {
    return arm64_gas_bad_pairlong(mnem, ops);
  }
  let fpbad: string = arm64_gas_bad_vecfp(mnem, ops);
  if (fpbad != "-") {
    return fpbad;
  }
  let three: i32 = arm64_v3int_entry(mnem);
  let logic: i32 = arm64_vlogical_entry(mnem);
  let czero: i32 = arm64_vcmpzero_entry(mnem);
  let misc: i32 = arm64_v2misc_entry(mnem);
  let is_czero: boolean = czero >= 0 && (three < 0
    || ops.len() == 3 && ops[2].len() > 0 && ops[2][0] == b'#');
  let want: i32 = 3;
  let entry: i32 = three;
  if (is_czero) {
    want = 3;
    entry = czero;
  } else {
    if (three >= 0) {
      want = 3;
      entry = three;
    } else {
      if (logic >= 0) {
        want = 3;
        entry = logic;
      } else {
        if (misc >= 0) {
          want = 2;
          entry = misc;
        } else {
          return "";
        }
      }
    }
  }
  if (ops.len() != want) {
    return mnem + ":arity";
  }
  let nvec: i32 = want;
  if (is_czero) {
    nvec = 2;
  }
  let code: i32 = arm64_gas_vreg_arrof(ops[0]);
  let i: i32 = 0;
  while (i < nvec) {
    if (arm64_gas_vreg_any(ops[i]) < 0) {
      return arm64_gas_trim(ops[i]);
    }
    if (arm64_gas_vreg_arrof(ops[i]) != code) {
      return mnem + ":arr";
    }
    i = i + 1;
  }
  if (is_czero && arm64_gas_imm(ops[2]) != 0) {
    return mnem + ":imm";
  }
  if (!arm64_gas_arr_allowed(arm64_vec_entry_sizes(entry), code)) {
    return mnem + ":arr";
  }
  return "";
}

function arm64_gas_bad_pmull(mnem: string, ops: string[]): string {
  let e: i32 = arm64_vpolylong_entry(mnem);
  if (e < 0) {
    return "-";
  }
  if (ops.len() != 3) {
    return mnem + ":arity";
  }
  let i: i32 = 0;
  while (i < 3) {
    if (arm64_gas_vreg_any(ops[i]) < 0) {
      return arm64_gas_trim(ops[i]);
    }
    i = i + 1;
  }
  let sc: i32 = arm64_gas_vreg_arrof(ops[1]);
  if (arm64_gas_vreg_arrof(ops[2]) != sc) {
    return mnem + ":arr";
  }
  let size: i32 = arm64_gas_arr_size(sc);
  if (size != 0 && size != 3) {
    return mnem + ":arr";
  }
  if (arm64_gas_arr_q(sc) != (arm64_vec_entry_sizes(e) == 1)) {
    return mnem + ":arr";
  }
  if (arm64_gas_vreg_arrof(ops[0]) != (size + 1) * 2 + 1) {
    return mnem + ":arr";
  }
  return "";
}

function arm64_gas_bad_aes(mnem: string, ops: string[]): string {
  if (arm64_aes_opcode(mnem) < 0) {
    return "-";
  }
  if (ops.len() != 2) {
    return mnem + ":arity";
  }
  let i: i32 = 0;
  while (i < 2) {
    if (arm64_gas_vreg_any(ops[i]) < 0) {
      return arm64_gas_trim(ops[i]);
    }
    if (arm64_gas_vreg_arrof(ops[i]) != 1) {
      return mnem + ":arr";
    }
    i = i + 1;
  }
  return "";
}

function arm64_gas_bad_sha(mnem: string, ops: string[]): string {
  let opcode: i32 = arm64_sha_opcode(mnem);
  if (opcode < 0) {
    return "-";
  }
  let want: i32 = 3;
  if (opcode >= 8) {
    want = 2;
  }
  if (ops.len() != want) {
    return mnem + ":arity";
  }
  let i: i32 = 0;
  while (i < want) {
    if (arm64_gas_sha_reg(opcode, i, ops[i]) < 0) {
      return mnem + ":reg";
    }
    i = i + 1;
  }
  return "";
}

function arm64_gas_bad_narrowwide(mnem: string, ops: string[]): string {
  if (arm64_gas_fcvt_nl(mnem) >= 0) {
    return arm64_gas_bad_fcvt_nl(mnem, ops);
  }
  let kind: i32 = arm64_gas_shll_kind(mnem);
  let is_xtn: boolean = mnem == "xtn" || mnem == "xtn2";
  let is_shrn: boolean = mnem == "shrn" || mnem == "shrn2";
  if (kind < 0 && !is_xtn && !is_shrn && mnem != "ext" && mnem != "tbl" && mnem != "tbx") {
    return "-";
  }
  if (mnem == "ext") {
    if (ops.len() != 4) {
      return mnem + ":arity";
    }
    let ec: i32 = arm64_gas_vreg_arrof(ops[0]);
    let ei: i32 = 0;
    while (ei < 3) {
      if (arm64_gas_vreg_any(ops[ei]) < 0) {
        return arm64_gas_trim(ops[ei]);
      }
      if (arm64_gas_vreg_arrof(ops[ei]) != ec) {
        return mnem + ":arr";
      }
      ei = ei + 1;
    }
    if (!arm64_gas_arr_allowed(1, ec)) {
      return mnem + ":arr";
    }
    let emax: i32 = 7;
    if (arm64_gas_arr_q(ec)) {
      emax = 15;
    }
    let eidx: i32 = arm64_gas_imm(ops[3]);
    if (eidx < 0 || eidx > emax) {
      return mnem + ":imm";
    }
    return "";
  }
  if (mnem == "tbl" || mnem == "tbx") {
    if (ops.len() != 3) {
      return mnem + ":arity";
    }
    let tc: i32 = arm64_gas_vreg_arrof(ops[0]);
    if (arm64_gas_vreg_any(ops[0]) < 0) {
      return arm64_gas_trim(ops[0]);
    }
    if (arm64_gas_vlist_table(ops[1]) < 0) {
      return arm64_gas_trim(ops[1]);
    }
    if (arm64_gas_vreg_any(ops[2]) < 0) {
      return arm64_gas_trim(ops[2]);
    }
    if (arm64_gas_vreg_arrof(ops[2]) != tc) {
      return mnem + ":arr";
    }
    if (!arm64_gas_arr_allowed(1, tc)) {
      return mnem + ":arr";
    }
    return "";
  }
  let want: i32 = 3;
  if (is_xtn || kind >= 4) {
    want = 2;
  }
  if (ops.len() != want) {
    return mnem + ":arity";
  }
  if (arm64_gas_vreg_any(ops[0]) < 0) {
    return arm64_gas_trim(ops[0]);
  }
  if (arm64_gas_vreg_any(ops[1]) < 0) {
    return arm64_gas_trim(ops[1]);
  }
  let d: i32 = arm64_gas_vreg_arrof(ops[0]);
  let n: i32 = arm64_gas_vreg_arrof(ops[1]);
  let hi: boolean = arm64_str_indexof(mnem, "2") == mnem.len() - 1;
  if (is_xtn || is_shrn) {
    if (!arm64_gas_narrow_wide_ok(d, n, hi)) {
      return mnem + ":arr";
    }
    if (is_shrn) {
      let nes: i32 = arm64_gas_esize(d);
      let sh: i32 = arm64_gas_imm(ops[2]);
      if (sh < 1 || sh > nes) {
        return mnem + ":imm";
      }
    }
    return "";
  }
  if (!arm64_gas_narrow_wide_ok(n, d, hi)) {
    return mnem + ":arr";
  }
  if (kind < 4) {
    let ses: i32 = arm64_gas_esize(n);
    let amt: i32 = arm64_gas_imm(ops[2]);
    if (amt < 0 || amt >= ses) {
      return mnem + ":imm";
    }
  }
  return "";
}

function arm64_gas_bad_vecfp(mnem: string, ops: string[]): string {
  let fz: i32 = arm64_vfpcmpzero_entry(mnem);
  let f3: i32 = arm64_vfp3_entry(mnem);
  let f2: i32 = arm64_vfp2_entry(mnem);
  let sh: i32 = arm64_vshift_entry(mnem);
  let pm: i32 = arm64_vpermute_opc(mnem);
  if (fz < 0 && f3 < 0 && f2 < 0 && sh < 0 && pm < 0) {
    return "-";
  }
  let is_fz: boolean = fz >= 0 && (f3 < 0
    || ops.len() == 3 && ops[2].len() > 0 && ops[2][0] == b'#');
  let want: i32 = 3;
  let nvec: i32 = 3;
  if (is_fz || sh >= 0) {
    nvec = 2;
  } else {
    if (f3 < 0 && pm < 0 && f2 >= 0) {
      want = 2;
      nvec = 2;
    }
  }
  if (ops.len() != want) {
    return mnem + ":arity";
  }
  let code: i32 = arm64_gas_vreg_arrof(ops[0]);
  let i: i32 = 0;
  while (i < nvec) {
    if (arm64_gas_vreg_any(ops[i]) < 0) {
      return arm64_gas_trim(ops[i]);
    }
    if (arm64_gas_vreg_arrof(ops[i]) != code) {
      return mnem + ":arr";
    }
    i = i + 1;
  }
  if (sh >= 0) {
    if (!arm64_gas_arr_allowed(15, code)) {
      return mnem + ":arr";
    }
    let es: i32 = arm64_gas_esize(code);
    let amt: i32 = arm64_gas_imm(ops[2]);
    if (arm64_vec_entry_sizes(sh) == 1) {
      if (amt < 0 || amt >= es) {
        return mnem + ":imm";
      }
    } else {
      if (amt < 1 || amt > es) {
        return mnem + ":imm";
      }
    }
    return "";
  }
  if (pm >= 0) {
    if (!arm64_gas_arr_allowed(15, code)) {
      return mnem + ":arr";
    }
    return "";
  }
  if (!arm64_gas_arr_allowed(12, code)) {
    return mnem + ":arr";
  }
  if (is_fz) {
    let z: string = arm64_gas_trim(ops[2]);
    if (z != "#0.0" && z != "#0") {
      return mnem + ":imm";
    }
  }
  return "";
}

function arm64_gas_operands(rest: string): string[] {
  let out: string[] = [];
  let depth: i32 = 0;
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < rest.len()) {
    let c: u8 = rest[i];
    if (c == b'[') {
      depth = depth + 1;
    } else if (c == b']') {
      depth = depth - 1;
    } else if (c == b',' && depth == 0) {
      out = out.append(arm64_gas_trim_span(rest, start, i));
      start = i + 1;
    }
    i = i + 1;
  }
  let last: string = arm64_gas_trim_span(rest, start, rest.len());
  if (last.len() > 0) {
    out = out.append(last);
  }
  return out;
}

struct Arm64Mem {
  base: i32,
  off: i32,
  off_reg: i32,
  idx_w: boolean,
  ext_opt: i32,
  ext_amt: i32,
  ext_has_amt: boolean,
  at: i32,
}

function arm64_gas_mem(op: string): Arm64Mem {
  let lb: i32 = arm64_str_indexof(op, "[");
  let rb: i32 = arm64_str_indexof(op, "]");
  let parts: string[] = [];
  if (lb >= 0 && rb > lb) {
    parts = arm64_gas_operands(slice_unchecked(op, lb + 1, rb));
  } else {
    parts = arm64_gas_operands(op);
  }
  let base: i32 = arm64_gas_reg(parts[0]);
  let off: i32 = 0;
  let off_reg: i32 = 0 - 1;
  let idx_w: boolean = false;
  let ext_opt: i32 = 3;
  let ext_amt: i32 = 0;
  let ext_has_amt: boolean = false;
  if (parts.len() > 1) {
    let r: i32 = arm64_gas_reg(parts[1]);
    if (arm64_str_indexof(parts[1], "#") < 0 && r >= 0) {
      off_reg = r;
      idx_w = arm64_gas_is_w(parts[1]);
      if (parts.len() > 2) {
        ext_opt = arm64_gas_mem_opt(parts[2]);
        if (arm64_str_indexof(parts[2], "#") >= 0) {
          ext_amt = arm64_gas_lsl_amount(parts[2]);
          ext_has_amt = true;
        }
      }
    } else {
      off = arm64_gas_imm(parts[1]);
    }
  }
  return Arm64Mem {
    base: base, off: off, off_reg: off_reg,
    idx_w: idx_w, ext_opt: ext_opt, ext_amt: ext_amt, ext_has_amt: ext_has_amt,
    at: 0 - 1,
  };
}

function arm64_gas_line_mem(ops: string[]): Arm64Mem {
  let i: i32 = 0;
  while (i < ops.len()) {
    if (arm64_str_indexof(ops[i], "[") >= 0) {
      let m: Arm64Mem = arm64_gas_mem(ops[i]);
      return Arm64Mem { ...m, at: i };
    }
    i = i + 1;
  }
  return Arm64Mem {
    base: 0 - 1, off: 0, off_reg: 0 - 1, idx_w: false,
    ext_opt: 3, ext_amt: 0, ext_has_amt: false, at: 0 - 1,
  };
}

function arm64_gas_mem_at(ops: string[], k: i32, lm: Arm64Mem): Arm64Mem {
  if (lm.at == k) {
    return lm;
  }
  return arm64_gas_mem(ops[k]);
}

function arm64_gas_mem_opt(p: string): i32 {
  if (arm64_str_indexof(p, "lsl") == 0) {
    if (arm64_str_indexof(p, "#") < 0) {
      return 0 - 1;
    }
    return 3;
  }
  if (arm64_str_indexof(p, "uxtw") == 0) {
    return 2;
  }
  if (arm64_str_indexof(p, "sxtw") == 0) {
    return 6;
  }
  if (arm64_str_indexof(p, "sxtx") == 0) {
    return 7;
  }
  return 0 - 1;
}

function arm64_movwide_hw(v: i64): i32 {
  if (v == 0) {
    return 0;
  }
  let sh: i32 = 0;
  let found: i32 = 0 - 1;
  while (sh < 64) {
    let chunk: i64 = v >> sh & 0xffff;
    if (chunk != 0) {
      if (found >= 0) {
        return 0 - 1;
      }
      found = sh;
    }
    sh = sh + 16;
  }
  return found;
}

function arm64_gas_movwide_out_of_range(mnem: string, ops: string[]): boolean {
  if (mnem != "mov" && mnem != "movz" && mnem != "movn") {
    return false;
  }
  if (ops.len() < 2) {
    return false;
  }
  if (ops[1].len() == 0 || ops[1][0] != b'#') {
    return false;
  }
  if (ops.len() > 2 && arm64_gas_lsl_amount(ops[2]) != 0) {
    return false;
  }
  let v: i64 = arm64_gas_imm64(ops[1]);
  if (v < 0) {
    v = 0 - v - 1;
  }
  return arm64_movwide_hw(v) < 0;
}

function arm64_gas_regoff_unsupported(mnem: string, ops: string[], lm: Arm64Mem): boolean {
  if (mnem != "ldrsw" && mnem != "ldrsb" && mnem != "ldrsh" && mnem != "ldur" && mnem != "stur") {
    return false;
  }
  return lm.at >= 0 && lm.off_reg >= 0;
}

function arm64_gas_has_bang(op: string): boolean {
  return arm64_str_indexof(op, "!") >= 0;
}

function arm64_gas_writeback_unsupported(mnem: string, ops: string[]): boolean {
  if (mnem != "ldrb" && mnem != "strb" && mnem != "ldrh" && mnem != "strh" && mnem != "ldrsw"
    && mnem != "ldrsb" && mnem != "ldrsh" && mnem != "ldur" && mnem != "stur") {
    return false;
  }
  let i: i32 = 0;
  while (i < ops.len()) {
    if (arm64_str_indexof(ops[i], "[") >= 0 && arm64_gas_has_bang(ops[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function arm64_gas_lsl_amount(tok: string): i32 {
  let s: string = arm64_gas_trim(tok);
  let h: i32 = arm64_str_indexof(s, "#");
  if (h < 0) {
    return 0;
  }
  return arm64_gas_atoi(arm64_gas_trim(slice_unchecked(s, h + 1, s.len())));
}

function arm64_gas_shift_type(tok: string): i32 {
  let s: string = arm64_gas_trim(tok);
  if (arm64_str_indexof(s, "lsl") == 0) {
    return 0;
  }
  if (arm64_str_indexof(s, "lsr") == 0) {
    return 1;
  }
  if (arm64_str_indexof(s, "asr") == 0) {
    return 2;
  }
  if (arm64_str_indexof(s, "ror") == 0) {
    return 3;
  }
  return 0 - 1;
}

function arm64_gas_extend_option(tok: string): i32 {
  let s: string = arm64_gas_trim(tok);
  if (arm64_str_indexof(s, "uxtb") == 0) {
    return 0;
  }
  if (arm64_str_indexof(s, "uxth") == 0) {
    return 1;
  }
  if (arm64_str_indexof(s, "uxtw") == 0) {
    return 2;
  }
