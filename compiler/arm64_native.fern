  if (mnem == "ext") {
    if (ops.len() != 4) {
      return a;
    }
    let ec: i32 = arm64_gas_vreg_arrof(ops[0]);
    arm64_push_arr(a.code, arm64_vecext(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_gas_vreg_any(ops[2]), arm64_gas_imm(ops[3]), arm64_gas_arr_q(ec),
    ));
    return a;
