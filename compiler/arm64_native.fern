  match (mnem) {
    "csel" => {
      return 0x9a800000;
    },
    "csinc" => {
      return 0x9a800400;
    },
    "csinv" => {
      return 0xda800000;
    },
    "csneg" => {
      return 0xda800400;
    },
    "cset" => {
      return 0x9a800400;
    },
    "csetm" => {
      return 0xda800000;
    },
    "cinc" => {
      return 0x9a800400;
    },
    "cinv" => {
      return 0xda800000;
    },
    "cneg" => {
      return 0xda800400;
