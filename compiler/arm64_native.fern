// compiler/arm64_native.fern — the arm64-darwin native-binary
// backend as a single module: the AArch64 machine-code encoder + named-
// label assembler (was arm64_encode.fern), the GAS-text assembler + data/
// symbol relocation (was arm64_gas.fern), and the ad-hoc-signed Mach-O
// writer + SHA-256 (was macho.fern). Merged into one module so the unified
// fern CLI can `import "./arm64_native"` and drive emit -> assemble ->
// Mach-O without cross-module bare references. The pieces stay logically
// separable; the section banners below mark the former file boundaries.

// ============================================================
// PART 1 — AArch64 encoder + named-label assembler
// ============================================================

// compiler/arm64_encode.fern — a self-hosted AArch64 (arm64)
// machine-code encoder: one function per instruction form, each appending
// the 4-byte fixed-width little-endian encoding to an `i32[]` byte buffer.
// It is the arm64 counterpart of x86_native.fern PART 1 and the assembler half of
// the arm64-darwin native-binary path (the container half is macho.fern).
//
// AArch64 instructions are all exactly 32 bits, little-endian. Each
// encoder is pinned byte-for-byte against the Go reference (itself pinned
// against `llvm-mc -triple=aarch64 --show-encoding`). This is a tiny
// starting subset — enough to assemble an `exit(N)` program end-to-end
// (MOVZ + SVC) and small integer arithmetic — so the Mach-O writer and the
// encode -> wrap -> run pipeline can be proven before the full instruction
// surface lands.
//
// Conventions (matching x86_native.fern / elf.fern):
//   * A byte buffer is an `i32[]` of values in 0..255; each encoder appends
//     to it and returns the (possibly grown) buffer (`buf = f(buf, …)`).
//   * Instruction *word* helpers (`arm64_*_word`) return the 32-bit
//     encoding in an i64 (so the 0xD2…/0xF2…/0xAA… bases stay positive);
//     the append wrappers thread the byte buffer.
//   * This module is import-free so the native emitter can `import
//     "./arm64_encode"` and the unit test can concatenate it with a driver.

// ---- register name helpers (5-bit register numbers) ----

function arm64_x0(): i32 {
  return 0;
}

function arm64_x1(): i32 {
  return 1;
}

function arm64_x2(): i32 {
  return 2;
}

function arm64_x16(): i32 {
  return 16;
}

function arm64_lr(): i32 {  // x30, the link register
  return 30;
}

// ---- byte emitter ----

// arm64_le32 appends a 32-bit instruction word (held in an i64),
// little-endian.
function arm64_le32(buf: i32[], v: i64): i32[] {
  buf = buf.append((v & 255) as i32);
  buf = buf.append((v >> 8 & 255) as i32);
  buf = buf.append((v >> 16 & 255) as i32);
  buf = buf.append((v >> 24 & 255) as i32);
  return buf;
}

// arm64_push_word appends an instruction word to a code builder,
// little-endian, and arm64_push_arr an encoder's raw bytes.
function arm64_push_word(b: usize, v: i64): void {
  buf_push_byte(b, (v & 255) as i32);
  buf_push_byte(b, (v >> 8 & 255) as i32);
  buf_push_byte(b, (v >> 16 & 255) as i32);
  buf_push_byte(b, (v >> 24 & 255) as i32);
}

function arm64_push_arr(b: usize, xs: i32[]): void {
  for x in xs {
    buf_push_byte(b, x);
  }
}

// arm64_word_bytes appends the instruction word an emitter recorded at
// `at` in `words`, whose low four bytes are already little-endian.
// ---- record forms ----
//
// An emitter writing a binary hands the assembler encoded words for the shapes
// generated code writes most. Each arm64_rec_* takes the operands as the text
// form spells them and returns the word that text assembles to, or -1 when
// they fall outside the shapes it covers; the caller then writes the text, so
// anything the text path would refuse is still refused.

// arm64_rec_gpr decodes x0..x30 or w0..w30, exactly as spelled, or -1.
function arm64_rec_gpr(tok: string): i32 {
  let n: i32 = tok.len();
  if (n < 2 || n > 3 || tok[0] != b'x' && tok[0] != b'w') {
    return 0 - 1;
  }
  let v: i32 = 0;
  let k: i32 = 1;
  while (k < n) {
    let c: i32 = tok[k] as i32;
    if (c < 48 || c > 57) {
      return 0 - 1;
    }
    v = v * 10 + (c - 48);
    k = k + 1;
  }
  if (v > 30) {
    return 0 - 1;
  }
  return v;
}

// arm64_rec_mov is `mov dst, src` between two registers of one width, or
// with sp on either side and an x register on the other the 64-bit `add #0`
// the text path encodes it as.
pub function arm64_rec_mov(dst: string, src: string): i64 {
  if (dst == "sp" || src == "sp") {
    let d: i32 = arm64_rec_base(dst);
    let n: i32 = arm64_rec_base(src);
    if (d < 0 || n < 0) {
      return 0 - 1;
    }
    return arm64_addimm_word(d, n, 0);
  }
  let rd: i32 = arm64_rec_gpr(dst);
  let rm: i32 = arm64_rec_gpr(src);
  if (rd < 0 || rm < 0 || dst[0] != src[0]) {
    return 0 - 1;
  }
  return arm64_movreg_sized_word(rd, rm, dst[0] == b'w');
}

// arm64_rec_mov_imm is `mov d, #imm` for an immediate one move-wide carries
// unshifted: movz for 0..65535, movn for -65536..-1, as
// arm64_gas_emit_movwide encodes them.
pub function arm64_rec_mov_imm(d: string, imm: i64): i64 {
  let rd: i32 = arm64_rec_gpr(d);
  if (rd < 0 || imm < 0 - 65536 || imm > 65535) {
    return 0 - 1;
  }
  let w: i64 = arm64_movz_word(rd, imm as i32, 0);
  if (imm < 0) {
    w = arm64_movn_word(rd, (0 - imm - 1) as i32, 0);
  }
  if (d[0] == b'w') {
    w = w & 0x7fffffff;
  }
  return w;
}

// arm64_rec_addsub_imm is `add|sub|adds|subs d, n, #imm`, or with d "" the
// cmp/cmn form writing the zero register of n's width. A negative imm is the
// opposite op carrying the magnitude, as arm64_gas_emit_addsub encodes it.
// The flag-free forms take sp as d or n, with x registers beside it.
pub function arm64_rec_addsub_imm(is_sub: boolean, sets: boolean, d: string, n: string, imm: i64): i64 {
  let nsp: boolean = n == "sp" && !sets;
  let rn: i32 = arm64_rec_gpr(n);
  if (nsp) {
    rn = 31;
  }
  let rd: i32 = 31;
  if (d == "sp" && !sets) {
    if (!nsp && n[0] != b'x') {
      return 0 - 1;
    }
  } else if (d != "") {
    rd = arm64_rec_gpr(d);
    if (rd >= 0 && (nsp && d[0] != b'x' || !nsp && d[0] != n[0])) {
      return 0 - 1;
    }
  }
  if (rn < 0 || rd < 0 || imm < 0 - 4095 || imm > 4095) {
    return 0 - 1;
  }
  let mag: i32 = imm as i32;
  if (imm < 0) {
    is_sub = !is_sub;
    mag = 0 - mag;
  }
  return arm64_addsub_imm_word(is_sub, sets, !nsp && n[0] == b'w', rd, rn, mag);
}

// arm64_rec_addsub_reg is the register form of arm64_rec_addsub_imm.
pub function arm64_rec_addsub_reg(is_sub: boolean, sets: boolean, d: string, n: string, m: string): i64 {
  let rn: i32 = arm64_rec_gpr(n);
  let rm: i32 = arm64_rec_gpr(m);
  let rd: i32 = 31;
  if (d != "") {
    rd = arm64_rec_gpr(d);
    if (rd >= 0 && d[0] != n[0]) {
      return 0 - 1;
    }
  }
  if (rn < 0 || rm < 0 || rd < 0 || n[0] != m[0]) {
    return 0 - 1;
  }
  return arm64_addsub_reg_word(is_sub, sets, n[0] == b'w', rd, rn, rm, 0, 0);
}

// arm64_rec_label reports whether a branch target can travel as a record: a
// symbol name the emitter composed itself, from its label prefix or through
// sanitize_label, never a numeric local (`1f`), which the text path resolves.
pub function arm64_rec_label(name: string): boolean {
  return name.len() > 0 && (name[0] < b'0' || name[0] > b'9');
}

// arm64_rec_b is `b` or, linking, `bl` with the displacement left for the
// label's fixup.
pub function arm64_rec_b(link: boolean): i64 {
  if (link) {
    return arm64_bl_word(0);
  }
  return arm64_b_word(0);
}

// arm64_rec_bcond is the conditional branch `b.<cond>` on condition code
// `cond`, and arm64_cond_name the code's spelling, the one arm64_gas_cond
// reads back.
pub function arm64_rec_bcond(cond: i32): i64 {
  return arm64_bcond_word(cond & 15, 0);
}

pub function arm64_cond_name(cond: i32): string {
  let names: string[] = ["eq", "ne", "hs", "lo", "mi", "pl", "vs", "vc", "hi", "ls", "ge", "lt", "gt", "le", "al", "nv"];
  return names[cond & 15];
}

// arm64_rec_cbz is `cbz` or, nonzero, `cbnz` on a register.
pub function arm64_rec_cbz(nonzero: boolean, rt: string): i64 {
  let r: i32 = arm64_rec_gpr(rt);
  if (r < 0) {
    return 0 - 1;
  }
  let w: i64 = arm64_cbz_word(r, 0);
  if (nonzero) {
    w = arm64_cbnz_word(r, 0);
  }
  if (rt[0] == b'w') {
    w = w & 0x7fffffff;
  }
  return w;
}

// arm64_rec_tbz is `tbz` or, nonzero, `tbnz` testing one bit of a register.
pub function arm64_rec_tbz(nonzero: boolean, rt: string, bit: i32): i64 {
  let r: i32 = arm64_rec_gpr(rt);
  let top: i32 = 63;
  if (r >= 0 && rt[0] == b'w') {
    top = 31;
  }
  if (r < 0 || bit < 0 || bit > top) {
    return 0 - 1;
  }
  if (nonzero) {
    return arm64_tbnz_word(r, bit, 0);
  }
  return arm64_tbz_word(r, bit, 0);
}

// arm64_rec_cmp_shifted is `cmp n, #imm, lsl #12`.
pub function arm64_rec_cmp_shifted(n: string, imm: i32): i64 {
  let rn: i32 = arm64_rec_gpr(n);
  if (rn < 0 || imm < 0 || imm > 4095) {
    return 0 - 1;
  }
  return arm64_addsub_imm_word_sh(true, true, n[0] == b'w', 31, rn, imm, true);
}

// arm64_rec_unscaled is `ldur|stur rt, [base, #off]`.
pub function arm64_rec_unscaled(load: boolean, rt: string, base: string, off: i32): i64 {
  let t: i32 = arm64_rec_gpr(rt);
  let rn: i32 = arm64_rec_base(base);
  if (t < 0 || rn < 0 || off < 0 - 256 || off > 255) {
    return 0 - 1;
  }
  if (load) {
    return arm64_unscaled_word(0xf8400000, t, rn, off, rt[0] == b'w');
  }
  return arm64_unscaled_word(0xf8000000, t, rn, off, rt[0] == b'w');
}

// arm64_rec_ldst is `ldr|str rt, [base, #off]` with base sp or an x-register:
// the scaled form when off is a non-negative multiple of the access size in
// range, otherwise ldur/stur for -256..255, the choice arm64_gas_emit_ldst makes.
pub function arm64_rec_ldst(load: boolean, rt: string, base: string, off: i32): i64 {
  let t: i32 = arm64_rec_gpr(rt);
  let rn: i32 = arm64_rec_base(base);
  let w: boolean = t >= 0 && rt[0] == b'w';
  let size: i32 = 8;
  if (w) {
    size = 4;
  }
  if (t < 0 || rn < 0 || off < 0 || off % size != 0 || off / size > 4095) {
    return arm64_rec_unscaled(load, rt, base, off);
  }
  if (load) {
    if (w) {
      return arm64_ldr_word_w(t, rn, off);
    }
    return arm64_ldr_word(t, rn, off);
  }
  if (w) {
    return arm64_str_word_w(t, rn, off);
  }
  return arm64_str_word(t, rn, off);
}

// arm64_rec_base decodes a load/store base, sp or an x-register, or -1.
function arm64_rec_base(base: string): i32 {
  if (base == "sp") {
    return 31;
  }
  if (base.len() == 0 || base[0] != b'x') {
    return 0 - 1;
  }
  return arm64_rec_gpr(base);
}

// arm64_rec_pair is `stp|ldp a, b, [base, #off]!` (mode 3, pre-index) or
// `[base], #off` (mode 1, post-index) on x registers, as arm64_gas_emit_pair
// encodes them; any other mode is refused.
pub function arm64_rec_pair(load: boolean, mode: i32, a: string, b: string, base: string, off: i32): i64 {
  let ra: i32 = arm64_rec_gpr(a);
  let rb: i32 = arm64_rec_gpr(b);
  let rn: i32 = arm64_rec_base(base);
  if (mode != 1 && mode != 3 || ra < 0 || rb < 0 || rn < 0 || a[0] != b'x' || b[0] != b'x' || off % 8 != 0 || off < 0 - 512 || off > 504) {
    return 0 - 1;
  }
  let w: i64 = 0xa8000000 | mode as i64 << 23;
  if (load) {
    w = w | 0x00400000;
  }
  return w | (off / 8 & 0x7f) as i64 << 15 | (rb & 31) as i64 << 10 | (rn & 31) as i64 << 5 | (ra & 31) as i64;
}

// arm64_rec_ldst_wb is `str|ldr rt, [base, #off]!` (pre-index) or
// `[base], #off` (post-index) on an x register.
pub function arm64_rec_ldst_wb(load: boolean, pre: boolean, rt: string, base: string, off: i32): i64 {
  let t: i32 = arm64_rec_gpr(rt);
  let rn: i32 = arm64_rec_base(base);
  if (t < 0 || rn < 0 || rt[0] != b'x' || off < 0 - 256 || off > 255) {
    return 0 - 1;
  }
  if (load) {
    if (pre) {
      return arm64_ldr_pre_word(t, rn, off);
    }
    return arm64_ldr_post_word(t, rn, off);
  }
  if (pre) {
    return arm64_str_pre_word(t, rn, off);
  }
  return arm64_str_post_word(t, rn, off);
}

// arm64_rec_ret is `ret`.
pub function arm64_rec_ret(): i64 {
  return arm64_ret_word(30);
}

// arm64_rec_ldst_reg is `ldr|str Xt, [Xn, Xm, lsl #3]`, the register offset
// scaled by the access size.
pub function arm64_rec_ldst_reg(load: boolean, rt: string, base: string, idx: string): i64 {
  let t: i32 = arm64_rec_gpr(rt);
  let rn: i32 = arm64_rec_base(base);
  let rm: i32 = arm64_rec_gpr(idx);
  if (t < 0 || rn < 0 || rm < 0 || rt[0] != b'x' || idx[0] != b'x') {
    return 0 - 1;
  }
  return arm64_ldst_regext_word(3, load, t, rn, rm, 3, true);
}

// arm64_rec_ldrb is `ldrb Wt, [Xn, #off]` and arm64_rec_strb `strb Wt,
// [Xn, #off]`, off a byte offset 0..4095; arm64_rec_ldrb_reg is
// `ldrb Wt, [Xn, Xm]`.
pub function arm64_rec_ldrb(rt: string, base: string, off: i32): i64 {
  let t: i32 = arm64_rec_gpr(rt);
  let rn: i32 = arm64_rec_base(base);
  if (t < 0 || rn < 0 || rt[0] != b'w' || off < 0 || off > 4095) {
    return 0 - 1;
  }
  return 0x39400000 | (off & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (t & 31) as i64;
}

pub function arm64_rec_strb(rt: string, base: string, off: i32): i64 {
  let t: i32 = arm64_rec_gpr(rt);
  let rn: i32 = arm64_rec_base(base);
  if (t < 0 || rn < 0 || rt[0] != b'w' || off < 0 || off > 4095) {
    return 0 - 1;
  }
  return 0x39000000 | (off & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (t & 31) as i64;
}

pub function arm64_rec_ldrb_reg(rt: string, base: string, idx: string): i64 {
  let t: i32 = arm64_rec_gpr(rt);
  let rn: i32 = arm64_rec_base(base);
  let rm: i32 = arm64_rec_gpr(idx);
  if (t < 0 || rn < 0 || rm < 0 || rt[0] != b'w' || idx[0] != b'x') {
    return 0 - 1;
  }
  return arm64_ldst_regext_word(0, true, t, rn, rm, 3, false);
}

// arm64_rec_lsl_imm is `lsl d, n, #sh` on registers of one width.
pub function arm64_rec_lsl_imm(d: string, n: string, sh: i32): i64 {
  let rd: i32 = arm64_rec_gpr(d);
  let rn: i32 = arm64_rec_gpr(n);
  let top: i32 = 63;
  if (rd >= 0 && d[0] == b'w') {
    top = 31;
  }
  if (rd < 0 || rn < 0 || d[0] != n[0] || sh < 0 || sh > top) {
    return 0 - 1;
  }
  return arm64_lsl_imm_word(rd, rn, sh, d[0] == b'w');
}

// arm64_rec_tst_imm is `tst n, #imm` and arm64_rec_and_imm `and d, n, #imm`,
// for a bitmask immediate the width encodes, as arm64_gas_emit_logical2 and
// the and-immediate arm encode them.
pub function arm64_rec_tst_imm(n: string, imm: i64): i64 {
  let rn: i32 = arm64_rec_gpr(n);
  if (rn < 0 || !arm64_logical_imm_ok(imm, n[0] == b'w')) {
    return 0 - 1;
  }
  return arm64_logical_imm_word(0xf2000000, n[0] == b'w', 31, rn, imm);
}

pub function arm64_rec_and_imm(d: string, n: string, imm: i64): i64 {
  let rd: i32 = arm64_rec_gpr(d);
  let rn: i32 = arm64_rec_gpr(n);
  if (rd < 0 || rn < 0 || d[0] != n[0] || !arm64_logical_imm_ok(imm, n[0] == b'w')) {
    return 0 - 1;
  }
  return arm64_logical_imm_word(0x92000000, n[0] == b'w', rd, rn, imm);
}

// arm64_rec_adrp is `adrp d, sym` with the page delta left for the symbol's
// fixup; arm64_rec_add_lo12 is its `add d, n, :lo12:sym` half with the low
// twelve bits left. Both travel as named records (\x02), and the assembler
// tells them from a branch by the word.
pub function arm64_rec_adrp(d: string): i64 {
  let rd: i32 = arm64_rec_gpr(d);
  if (rd < 0 || d[0] != b'x') {
    return 0 - 1;
  }
  return arm64_adrp_word(rd, 0);
}

pub function arm64_rec_add_lo12(d: string, n: string): i64 {
  let rd: i32 = arm64_rec_gpr(d);
  let rn: i32 = arm64_rec_gpr(n);
  if (rd < 0 || rn < 0 || d[0] != b'x' || n[0] != b'x') {
    return 0 - 1;
  }
  return arm64_addimm_word(rd, rn, 0);
}

// arm64_named_kind sorts a named record by its word's top byte: 0 for a
// branch, 1 for adrp with the zero page delta a record carries, 2 for the
// unshifted 64-bit add immediate that carries :lo12:.
function arm64_named_kind(top: u8): i32 {
  if (top == 0x90) {
    return 1;
  }
  if (top == 0x91) {
    return 2;
  }
  return 0;
}

// arm64_branch_kind is the fixup kind of a label branch from its top byte:
// 0 for b/bl (imm26), 2 for tbz/tbnz (imm14), 1 for b.cond/cbz/cbnz (imm19).
function arm64_branch_kind(top: u8): i32 {
  if ((top & 0x7c) == 0x14) {
    return 0;
  }
  if ((top & 0x7e) == 0x36) {
    return 2;
  }
  return 1;
}

// arm64_words_i32 reads the little-endian 32-bit value at `at` in the words.
function arm64_words_i32(words: u8[], at: i32): i32 {
  return words[at] as i32 | words[at + 1] as i32 << 8 | words[at + 2] as i32 << 16 | words[at + 3] as i32 << 24;
}

// ---- move-wide family ----

// arm64_movz_word encodes `movz Xd, #imm16, lsl #shift` (move-wide-zero):
// load imm16 into the given 16-bit slot of Xd, zeroing the rest. shift
// must be one of 0, 16, 32, 48.
//   sf=1 opc=10 100101 hw(2) imm16(16) Rd(5) -> 0xD2800000 | hw<<21 | imm16<<5 | Rd
function arm64_movz_word(rd: i32, imm16: i32, shift: i32): i64 {
  let hw: i64 = (shift / 16 & 3) as i64;
  return 0xd2800000 | hw << 21 | (imm16 & 0xffff) as i64 << 5 | (rd & 31) as i64;
}

// arm64_movk_word encodes `movk Xd, #imm16, lsl #shift` (move-wide-keep):
// write imm16 into one 16-bit slot of Xd, leaving the rest unchanged.
//   sf=1 opc=11 -> base 0xF2800000.
function arm64_movk_word(rd: i32, imm16: i32, shift: i32): i64 {
  let hw: i64 = (shift / 16 & 3) as i64;
  return 0xf2800000 | hw << 21 | (imm16 & 0xffff) as i64 << 5 | (rd & 31) as i64;
}

// arm64_movn_word encodes `movn Xd, #imm16, lsl #shift` (move-wide-not):
// load the bitwise complement of (imm16 << shift) into Xd.
//   sf=1 opc=00 -> base 0x92800000.
function arm64_movn_word(rd: i32, imm16: i32, shift: i32): i64 {
  let hw: i64 = (shift / 16 & 3) as i64;
  return 0x92800000 | hw << 21 | (imm16 & 0xffff) as i64 << 5 | (rd & 31) as i64;
}

// The `w` flag selects the 32-bit form. AArch64 encodes operand width in the
// instruction, not the register name, and arm64_gas_reg deliberately maps w0 and
// x0 to the same number — so every site that can see a `w` operand must pass the
// flag or the assembler silently widens the operation (#6054).
function arm64_movz(buf: i32[], rd: i32, imm16: i32, shift: i32, w: boolean): i32[] {
  let word: i64 = arm64_movz_word(rd, imm16, shift);
  if (w) {  // sf=0: 0xd2800000 -> 0x52800000
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// `w` clears sf: 0xf2800000 -> 0x72800000, the 32-bit form. movk was the one
// member of the move-wide family that took no width and so assembled `movk w4,
// #imm, lsl #16` as the 64-bit MOVK — the same shape as movn silently emitting
// nothing (#6060), and caught the same way, by
// TestSelfHostArm64WholeProgramMatchesGas differing from GNU as in one bit.
function arm64_movk(buf: i32[], rd: i32, imm16: i32, shift: i32, w: boolean): i32[] {
  let word: i64 = arm64_movk_word(rd, imm16, shift);
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// `w` clears sf: 0x92800000 -> 0x12800000. Verified vs clang:
// mov x0,#-100 = 0x92800c60 (movn x0,#99), mov w0,#-100 = 0x12800c60,
// mov x1,#-1 = 0x92800001 (movn x1,#0).
function arm64_movn(buf: i32[], rd: i32, imm16: i32, shift: i32, w: boolean): i32[] {
  let word: i64 = arm64_movn_word(rd, imm16, shift);
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// ---- add / sub (immediate) ----

// ---- the add / sub / adds / subs family ----
//
// One family, four mnemonics, three operand forms. They differ only in fixed
// bits: op picks add from sub, S the flag-setting pair, sf the width, and one
// more bit the immediate form from the shifted-register one. Writing them as
// ten separate encoders is what let each of these hide independently — the
// register forms never took a width at all (`add w1, w2, w3` assembled as
// `add x1, x2, x3`), `subs` dropped its shift, `adds` refused every form but
// the bare register one, and every immediate at or above 4096 was masked to
// twelve bits and silently lost (`sub sp, sp, #4096` became `sub sp, sp, #0`,
// so a frame that big was never allocated).

// arm64_addsub_base is the fixed-bit prefix: add is 0, sub sets bit 30, the
// flag-setting pair sets bit 29, a 64-bit operation sets sf, and the immediate
// form has a different opcode field from the shifted-register one.
function arm64_addsub_base(is_sub: boolean, s: boolean, w: boolean, imm: boolean): i64 {
  let base: i64 = 0x0b000000;  // shifted register, 32-bit, add
  if (imm) {  // immediate, 32-bit, add
    base = 0x11000000;
  }
  if (is_sub) {
    base = base | 0x40000000;
  }
  if (s) {
    base = base | 0x20000000;
  }
  if (!w) {
    base = base | 0x80000000;
  }
  return base;
}

// arm64_addsub_imm_ok reports whether an immediate is encodable at all. imm12
// is unsigned and either unshifted or shifted left twelve, so 0..4095 and the
// multiples of 4096 up to 0xFFF000 are reachable and NOTHING else is. A value
// between two multiples above 4095 needs a materialise, which is the caller's
// job — encoding it anyway adds a different number.
function arm64_addsub_imm_ok(imm: i32): boolean {
  if (imm < 0) {
    return false;
  }
  if (imm <= 4095) {
    return true;
  }
  if ((imm & 4095) != 0) {
    return false;
  }
  return imm / 4096 <= 4095;
}

// arm64_addsub_imm_mag is the magnitude of an add/sub immediate. imm12 is
// unsigned, so a negative is spelled under the opposite mnemonic carrying
// the magnitude -- `add #-16` is `sub #16` -- and it is the magnitude that
// has to fit the field. The most negative i32 negates to itself and stays
// negative, which arm64_addsub_imm_ok then refuses.
function arm64_addsub_imm_mag(imm: i32): i32 {
  if (imm < 0) {
    return 0 - imm;
  }
  return imm;
}

// arm64_addsub_imm_word_sh places imm12 with the shift bit given rather than
// derived, which is what an explicit `, lsl #12` needs: `#0, lsl #12` keeps
// sh=1 even though the value is reachable unshifted.
function arm64_addsub_imm_word_sh(is_sub: boolean, s: boolean, w: boolean, rd: i32, rn: i32, imm12: i32, sh12: boolean): i64 {
  let base: i64 = arm64_addsub_base(is_sub, s, w, true);
  if (sh12) {  // sh = 1: the field counts units of 4096
    base = base | 0x400000;
  }
  return base | (imm12 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
}

function arm64_addsub_imm_word(is_sub: boolean, s: boolean, w: boolean, rd: i32, rn: i32, imm: i32): i64 {
  if (imm > 4095) {
    return arm64_addsub_imm_word_sh(is_sub, s, w, rd, rn, imm / 4096, true);
  }
  return arm64_addsub_imm_word_sh(is_sub, s, w, rd, rn, imm, false);
}

// arm64_addsub_reg_word is the shifted-register form. `st` is the shift type
// (0 lsl, 1 lsr, 2 asr) and `amount` its 6-bit count; a bare `add Xd, Xn, Xm`
// is this form with both zero.
function arm64_addsub_reg_word(is_sub: boolean, s: boolean, w: boolean, rd: i32, rn: i32, rm: i32, st: i32, amount: i32): i64 {
  return arm64_addsub_base(is_sub, s, w, false)
    | (st & 3) as i64 << 22 | (rm & 31) as i64 << 16
    | (amount & 63) as i64 << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
}

// arm64_addimm_word encodes `add Xd, Xn, #imm12` (64-bit, no lsl #12).
//   sf=1 op=0 S=0 100010 sh=0 imm12 Rn Rd -> 0x91000000 | imm12<<10 | Rn<<5 | Rd
function arm64_addimm_word(rd: i32, rn: i32, imm12: i32): i64 {
  return arm64_addsub_imm_word(false, false, false, rd, rn, imm12);
}

// arm64_subimm_word encodes `sub Xd, Xn, #imm12` (64-bit) — base 0xD1000000.
function arm64_subimm_word(rd: i32, rn: i32, imm12: i32): i64 {
  return arm64_addsub_imm_word(true, false, false, rd, rn, imm12);
}

// `w` clears sf: add 0x91000000 -> 0x11000000, sub 0xd1000000 -> 0x51000000.
function arm64_addimm(buf: i32[], rd: i32, rn: i32, imm12: i32, w: boolean): i32[] {
  let word: i64 = arm64_addimm_word(rd, rn, imm12);
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

function arm64_subimm(buf: i32[], rd: i32, rn: i32, imm12: i32, w: boolean): i32[] {
  let word: i64 = arm64_subimm_word(rd, rn, imm12);
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// ---- add / sub / mov (register) ----

// SP is not addressable as Rn in the shifted-register form — there Rn=31 means
// XZR — so `add x0, sp, x0` assembled as a shifted-register add computes
// `x0 = 0 + x0` and silently DROPS THE STACK BASE (#6060). GAS uses the
// extended-register form (option=011 UXTX, imm3=0) when an operand is SP.
// Verified vs clang: add x0,sp,x0 = 0x8b2063e0, add x3,sp,x4 = 0x8b2463e3,
// sub x0,sp,x1 = 0xcb2163e0.
function arm64_addsub_ext_word(is_sub: boolean, rd: i32, rn: i32, rm: i32, option: i32, amount: i32): i64 {
  let base: i64 = 0x8b200000;
  if (is_sub) {
    base = 0xcb200000;
  }
  return base | (rm & 31) as i64 << 16 | (option & 7) as i64 << 13
    | (amount & 7) as i64 << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
}

function arm64_addsub_ext(buf: i32[], is_sub: boolean, rd: i32, rn: i32, rm: i32, option: i32, amount: i32): i32[] {
  return arm64_le32(buf, arm64_addsub_ext_word(is_sub, rd, rn, rm, option, amount));
}

function arm64_addsub_ext_sp_word(is_sub: boolean, rd: i32, rn: i32, rm: i32): i64 {
  return arm64_addsub_ext_word(is_sub, rd, rn, rm, 3, 0);  // UXTX, no shift
}

function arm64_addsub_ext_sp(buf: i32[], is_sub: boolean, rd: i32, rn: i32, rm: i32): i32[] {
  return arm64_le32(buf, arm64_addsub_ext_sp_word(is_sub, rd, rn, rm));
}

// arm64_addreg_word encodes `add Xd, Xn, Xm` (shifted-register, zero shift).
//   sf=1 op=0 S=0 01011 -> 0x8B000000 | Rm<<16 | Rn<<5 | Rd
function arm64_addreg_word(rd: i32, rn: i32, rm: i32): i64 {
  return arm64_addsub_reg_word(false, false, false, rd, rn, rm, 0, 0);
}

// arm64_subreg_word encodes `sub Xd, Xn, Xm` -> base 0xCB000000.
function arm64_subreg_word(rd: i32, rn: i32, rm: i32): i64 {
  return arm64_addsub_reg_word(true, false, false, rd, rn, rm, 0, 0);
}

// arm64_movreg_word encodes `mov Xd, Xm` — AArch64 spells it
// `orr Xd, XZR, Xm` -> 0xAA000000 | Rm<<16 | 31<<5 | Rd.
function arm64_movreg_word(rd: i32, rm: i32): i64 {
  return 0xaa000000 | (rm & 31) as i64 << 16 | 31 << 5 | (rd & 31) as i64;
}

function arm64_addreg(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
  return arm64_le32(buf, arm64_addreg_word(rd, rn, rm));
}

function arm64_subreg(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
  return arm64_le32(buf, arm64_subreg_word(rd, rn, rm));
}

function arm64_movreg(buf: i32[], rd: i32, rm: i32, w: boolean): i32[] {
  return arm64_le32(buf, arm64_movreg_sized_word(rd, rm, w));
}

// arm64_movreg_sized_word is `mov Rd, Rm` at either width: the W form clears
// the sf bit of the X form's `orr`.
function arm64_movreg_sized_word(rd: i32, rm: i32, w: boolean): i64 {
  let word: i64 = arm64_movreg_word(rd, rm);
  if (w) {
    word = word & 0x7fffffff;
  }
  return word;
}

// ---- system / control ----

// arm64_svc_word encodes `svc #imm16` -> 0xD4000001 | imm16<<5.
// The Darwin syscall trap is `svc #0x80`.
function arm64_svc_word(imm16: i32): i64 {
  return 0xd4000001 | (imm16 & 0xffff) as i64 << 5;
}

// arm64_ret_word encodes `ret Xn` (default x30) -> 0xD65F0000 | Rn<<5.
function arm64_ret_word(rn: i32): i64 {
  return 0xd65f0000 | (rn & 31) as i64 << 5;
}

function arm64_svc(buf: i32[], imm16: i32): i32[] {
  return arm64_le32(buf, arm64_svc_word(imm16));
}

// arm64_brk encodes `brk #imm16` -> 0xD4200000 | imm16<<5.
function arm64_brk(buf: i32[], imm16: i32): i32[] {
  return arm64_le32(buf, 0xd4200000 | (imm16 & 0xffff) as i64 << 5);
}

function arm64_ret(buf: i32[], rn: i32): i32[] {
  return arm64_le32(buf, arm64_ret_word(rn));
}

// arm64_blr_word encodes `blr Xn` (branch-with-link to register — the
// indirect call a closure / function-pointer call lowers to) ->
// 0xD63F0000 | Rn<<5.
function arm64_blr_word(rn: i32): i64 {
  return 0xd63f0000 | (rn & 31) as i64 << 5;
}

function arm64_blr(buf: i32[], rn: i32): i32[] {
  return arm64_le32(buf, arm64_blr_word(rn));
}

// ---- compare (subs to XZR) ----

// arm64_cmpreg_word encodes `cmp Xn, Xm` — AArch64 spells it
// `subs XZR, Xn, Xm` (shifted-register, zero shift) -> sets NZCV.
//   0xEB000000 | Rm<<16 | Rn<<5 | 31
function arm64_cmpreg_word(rn: i32, rm: i32): i64 {
  return 0xeb000000 | (rm & 31) as i64 << 16 | (rn & 31) as i64 << 5 | 31;
}

// arm64_cmpimm_word encodes `cmp Xn, #imm12` — `subs XZR, Xn, #imm12`.
//   0xF1000000 | imm12<<10 | Rn<<5 | 31
function arm64_cmpimm_word(rn: i32, imm12: i32): i64 {
  return arm64_addsub_imm_word(true, true, false, 31, rn, imm12);
}

// `w` clears sf: cmp-reg 0xeb.. -> 0x6b.., cmp-imm 0xf1.. -> 0x71... A 64-bit
// compare of a value produced by 32-bit arithmetic reads the neighbouring bytes
// as part of the operand, which is why this matters even when the low half is
// correct (#6054).
function arm64_cmpreg(buf: i32[], rn: i32, rm: i32, w: boolean): i32[] {
  let word: i64 = arm64_cmpreg_word(rn, rm);
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

function arm64_cmpimm(buf: i32[], rn: i32, imm12: i32, w: boolean): i32[] {
  let word: i64 = arm64_cmpimm_word(rn, imm12);
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// ---- condition codes (the 4-bit cond field of B.cond) ----
function arm64_eq(): i32 {  // ==
  return 0;
}

function arm64_ne(): i32 {  // !=
  return 1;
}

function arm64_ge(): i32 {  // >= (signed)
  return 10;
}

function arm64_lt(): i32 {  // <  (signed)
  return 11;
}

// ---- branches ----
//
// Branch targets are PC-relative byte deltas (target - branch_site),
// always a multiple of 4; the encoders divide by 4 to form the immediate.
// A *backward* branch (the bottom of a loop) knows its target offset when
// it is emitted, so the byte delta is `target_off - buf.len()`; forward
// branches await the label/fixup pass (a later slice).

// arm64_b_word encodes `b <rel>` -> 0x14000000 | imm26, imm26 = rel/4
// as a signed 26-bit field.
function arm64_b_word(rel: i32): i64 {
  return 0x14000000 | (rel >> 2 & 0x3ffffff) as i64;
}

// arm64_bcond_word encodes `b.<cond> <rel>` -> 0x54000000 | imm19<<5 |
// cond, imm19 = rel/4 as a signed 19-bit field.
function arm64_bcond_word(cond: i32, rel: i32): i64 {
  return 0x54000000 | (rel >> 2 & 0x7ffff) as i64 << 5 | (cond & 15) as i64;
}

// arm64_cbz_word / arm64_cbnz_word encode `cbz/cbnz Xt, <rel>` (compare
// the register against zero and branch) -> 0xB4000000 / 0xB5000000 |
// imm19<<5 | Rt. No flags needed (they test the register directly).
function arm64_cbz_word(rt: i32, rel: i32): i64 {
  return 0xb4000000 | (rel >> 2 & 0x7ffff) as i64 << 5 | (rt & 31) as i64;
}

function arm64_cbnz_word(rt: i32, rel: i32): i64 {
  return 0xb5000000 | (rel >> 2 & 0x7ffff) as i64 << 5 | (rt & 31) as i64;
}

function arm64_b(buf: i32[], rel: i32): i32[] {
  return arm64_le32(buf, arm64_b_word(rel));
}

function arm64_bcond(buf: i32[], cond: i32, rel: i32): i32[] {
  return arm64_le32(buf, arm64_bcond_word(cond, rel));
}

// `w` clears sf: cbz 0xb4.. -> 0x34.., cbnz 0xb5.. -> 0x35... The 64-bit form
// tests all 64 bits, so a `cbz w0` assembled as `cbz x0` takes the branch on a
// different condition whenever the upper half is dirty.
function arm64_cbz(buf: i32[], rt: i32, rel: i32, w: boolean): i32[] {
  let word: i64 = arm64_cbz_word(rt, rel);
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

function arm64_cbnz(buf: i32[], rt: i32, rel: i32, w: boolean): i32[] {
  let word: i64 = arm64_cbnz_word(rt, rel);
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// ---- forward references (placeholder + patch) ----
//
// A forward branch is emitted with a zero displacement (a placeholder),
// its byte offset recorded; once the target label's offset is known, the
// immediate field is spliced in with a patch helper. Unlike the backward
// case there is no label table yet — the driver tracks the one offset it
// needs. arm64 branch displacements are relative to the branch instruction
// itself, so the byte delta is simply `target_off - branch_off`.

// arm64_rel returns the PC-relative byte delta from a branch at branch_off
// to target_off.
function arm64_rel(target_off: i32, branch_off: i32): i32 {
  return target_off - branch_off;
}

// arm64_read_word reads the little-endian 32-bit instruction word at byte
// offset `at` (held in an i64 so the top bit stays positive).
function arm64_read_word(buf: i32[], at: i32): i64 {
  return buf[at] as i64
    | buf[at + 1] as i64 << 8
    | buf[at + 2] as i64 << 16
    | buf[at + 3] as i64 << 24;
}

// arm64_write_word overwrites the 4 little-endian bytes of the instruction
// word at byte offset `at`.
//
// `own buf` is what makes the patch path linear rather than O(code_len^2).
// A BORROWED array parameter forces every `.with` down the copy-on-write
// path — the callee cannot know the caller has no other reader — so each
// patched word cloned the whole buffer. Consuming the buffer lets the
// rc check see a unique owner and overwrite in place. The whole patch family
// below threads it the same way, and so must every caller: an owned argument
// has to be a fresh value, another `own` parameter, or a self-reassign
// `code = arm64_patch_x(code, …)` (E051).
function arm64_write_word(own buf: i32[], at: i32, w: i64): i32[] {
  buf = buf.with(at, (w & 255) as i32);
  buf = buf.with(at + 1, (w >> 8 & 255) as i32);
  buf = buf.with(at + 2, (w >> 16 & 255) as i32);
  buf = buf.with(at + 3, (w >> 24 & 255) as i32);
  return buf;
}

// arm64_patch_bytes rewrites the instruction word at byte offset `at` of
// assembled .text, keeping the bits in `keep` and or-ing in `field`. The
// i32[] patchers below are the raw encoder API's form.
function arm64_patch_bytes(own buf: u8[], at: i32, keep: i64, field: i64): u8[] {
  let w: i64 = (buf[at] as i64 | buf[at + 1] as i64 << 8 | buf[at + 2] as i64 << 16 | buf[at + 3] as i64 << 24) & keep | field;
  buf = buf.with(at, (w & 255) as u8);
  buf = buf.with(at + 1, (w >> 8 & 255) as u8);
  buf = buf.with(at + 2, (w >> 16 & 255) as u8);
  buf = buf.with(at + 3, (w >> 24 & 255) as u8);
  return buf;
}

// arm64_branch_keep is the mask of the bits a branch patch of `kind` leaves
// alone, and arm64_branch_field places a byte displacement in its immediate:
// 0 = imm26 (b / bl), 1 = imm19 at bits 23:5 (b.cond / cbz / cbnz, and the
// LDR literal), 2 = imm14 at bits 18:5 (tbz / tbnz).
function arm64_branch_keep(kind: i32): i64 {
  if (kind == 1) {
    return 0xff00001f;
  }
  if (kind == 2) {
    return 0xfff8001f;
  }
  return 0xfc000000;
}

function arm64_branch_field(kind: i32, rel: i32): i64 {
  if (kind == 1) {
    return (rel >> 2 & 0x7ffff) as i64 << 5;
  }
  if (kind == 2) {
    return (rel >> 2 & 0x3fff) as i64 << 5;
  }
  return (rel >> 2 & 0x3ffffff) as i64;
}

function arm64_patch_branch(own buf: i32[], at: i32, kind: i32, rel: i32): i32[] {
  let w: i64 = arm64_read_word(buf, at) & arm64_branch_keep(kind) | arm64_branch_field(kind, rel);
  return arm64_write_word(buf, at, w);
}

// arm64_patch_b splices a rel into the imm26 field of a `b` placeholder at
// byte offset `at`, preserving the top 6 opcode bits.
function arm64_patch_b(own buf: i32[], at: i32, rel: i32): i32[] {
  return arm64_patch_branch(buf, at, 0, rel);
}

// arm64_patch_b19 splices a rel into the imm19 field (bits 23:5) of a
// `b.cond` / `cbz` / `cbnz` placeholder at byte offset `at`, preserving
// the opcode plus the cond/Rt bits.
function arm64_patch_b19(own buf: i32[], at: i32, rel: i32): i32[] {
  return arm64_patch_branch(buf, at, 1, rel);
}

// ---- bl (branch-with-link, the call instruction) ----

// arm64_bl_word encodes `bl <rel>` -> 0x94000000 | imm26 (rel/4). It sets
// x30 = address of the following instruction; `ret` returns through x30.
function arm64_bl_word(rel: i32): i64 {
  return 0x94000000 | (rel >> 2 & 0x3ffffff) as i64;
}

function arm64_bl(buf: i32[], rel: i32): i32[] {
  return arm64_le32(buf, arm64_bl_word(rel));
}

// ============================================================
// named-label assembler
// ============================================================
//
// Arm64Asm threads the code buffer plus a label table (name -> byte
// offset) and a fixup queue for branches whose target is not yet placed.
// It is the arm64 counterpart of X86Asm in x86_native.fern. Branch
// displacements are PC-relative to the branch instruction itself, so a
// fixup records the instruction's byte offset and resolve patches with
// rel = target_off - instr_off. A fixup's kind names the immediate field
// (arm64_branch_keep).

pub struct Arm64Asm {
  // The code goes into a builder; arm64_asm_resolve takes it into `text` and
  // applies `patq` and the fixups there.
  code: usize,
  text: u8[],
  // Branch and literal patches whose displacement was known when queued, one
  // u64 each: the word's offset low, the displacement or'd with its kind
  // (arm64_branch_keep) high. 0 until the first.
  patq: usize,
  lab_names: string[],
  lab_offs: i32[],
  // The `.file N "path"` table (files[N - 1]) and the `.loc` rows, one entry
  // per row: the code offset the row starts at, its file number, line and
  // column, and its flags (1 = prologue_end). The ELF writer's .debug_line
  // program replays them (#11410).
  files: string[],
  loc_offs: i32[],
  loc_files: i32[],
  loc_lines: i32[],
  loc_cols: i32[],
  loc_flags: i32[],
  // The `.fern_var` rows (asmcore.DbgVars), kept verbatim for the ELF
  // writer's variable DIEs (#11410).
  dvars: string[],
  // Label lookup by name hashes into arm64_label_buckets() chains:
  // lab_head[b] is the first label in bucket b, lab_next[i] the label after
  // i in its chain, lab_tail[b] the chain's last so a new label joins it
  // without a walk. The twin of X86Asm's table (#6911).
  lab_head: i32[],
  lab_next: i32[],
  lab_tail: i32[],
  // The forward fixups, one u64 each in a builder (0 until the first): the
  // branch's offset in the low 32 bits, and in the high 32 its target shifted
  // left three, its kind (arm64_branch_keep) in bits 2:1, and bit 0 set when
  // the target is a name, the target then indexing fix_names rather than
  // being a label id.
  fixq: usize,
  fix_names: string[],
  // A label defined by id (the \x04 record) is placed in lid_offs[id], -1
  // until it is.
  lid_offs: i32[],
  // Branch targets arm64_asm_resolve could not find. Collected there rather
  // than rescanned afterwards: resolve already looks every fixup name up, and
  // a second pass over both tables would be quadratic on a real program.
  unres: string[],
  oor: string[],  // branches whose displacement overflows its field (see arm64_rel_fits)
}

// arm64_asm_new returns an empty assembler state.
// arm64_dw_fields splits a directive line on blanks: the directive, then its
// operands.
function arm64_dw_fields(line: string): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < line.len()) {
    while (i < line.len() && (line[i] == b' ' || line[i] == b'\t')) {
      i = i + 1;
    }
    let start: i32 = i;
    while (i < line.len() && line[i] != b' ' && line[i] != b'\t') {
      i = i + 1;
    }
    if (i > start) {
      out = out.append(slice_unchecked(line, start, i) + "");
    }
  }
  return out;
}

// arm64_file_entry records `.file N "path"` as files[N - 1].
function arm64_file_entry(own a: Arm64Asm, line: string): Arm64Asm {
  let f: string[] = arm64_dw_fields(line);
  if (f.len() < 3) {
    return a;
  }
  let n: i32 = arm64_gas_atoi(f[1]);
  let q1: i32 = arm64_str_indexof(line, "\"");
  let q2: i32 = line.len() - 1;
  while (q2 > q1 && line[q2] != b'"') {
    q2 = q2 - 1;
  }
  if (n < 1 || q1 < 0 || q2 <= q1) {
    return a;
  }
  let files: string[] = a.files;
  while (files.len() < n) {
    files = files.append("");
  }
  return Arm64Asm { ...a, files: files.with(n - 1, slice_unchecked(line, q1 + 1, q2) + "") };
}

// arm64_loc_row records `.loc FILE LINE COL [prologue_end]` at the current
// code offset.
function arm64_loc_row(own a: Arm64Asm, line: string): Arm64Asm {
  let f: string[] = arm64_dw_fields(line);
  if (f.len() < 3) {
    return a;
  }
  let col: i32 = 0;
  if (f.len() > 3) {
    col = arm64_gas_atoi(f[3]);
  }
  let flags: i32 = 0;
  let i: i32 = 3;
  while (i < f.len()) {
    if (f[i] == "prologue_end") {
      flags = 1;
    }
    i = i + 1;
  }
  return Arm64Asm {
    ...a,
    loc_offs: a.loc_offs.append(buf_len(a.code)), loc_files: a.loc_files.append(arm64_gas_atoi(f[1])),
    loc_lines: a.loc_lines.append(arm64_gas_atoi(f[2])), loc_cols: a.loc_cols.append(col), loc_flags: a.loc_flags.append(flags),
  };
}

function arm64_asm_new(): Arm64Asm {
  return Arm64Asm { ...arm64_asm_vacant(), code: buf_new(4096) };
}

// arm64_asm_vacant is an assembler with no builder: the placeholder left in a
// struct the live one was moved out of.
function arm64_asm_vacant(): Arm64Asm {
  return Arm64Asm {
    code: 0 as usize, text: [], patq: 0 as usize, lab_names: [], lab_offs: [], files: [], loc_offs: [], loc_files: [], loc_lines: [], loc_cols: [], loc_flags: [], dvars: [],
    lab_head: arm64_empty_buckets(), lab_next: [], lab_tail: arm64_empty_buckets(),
    fixq: 0 as usize, fix_names: [], lid_offs: [], unres: [], oor: [],
  };
}

function arm64_label_buckets(): i32 {
  return 4093;
}

// arm64_name_bucket hashes a label name to a bucket: the accumulator is
// masked to 23 bits each step so `h * 131` stays in i32, and reduced once at
// the end.
function arm64_name_bucket(name: string): i32 {
  let h: i32 = 0;
  let i: i32 = 0;
  let n: i32 = name.len();
  while (i < n) {
    h = h * 131 + name[i] as i32 & 8388607;
    i = i + 1;
  }
  return h % arm64_label_buckets();
}

function arm64_empty_buckets(): i32[] {
  let n: i32 = arm64_label_buckets();
  let b: i32[] = __alloc_i32(n);
  let i: i32 = 0;
  while (i < n) {
    b = b.with(i, 0 - 1);
    i = i + 1;
  }
  return b;
}

// arm64_asm_label records `name` at the current code offset and links it
// to the end of its bucket's chain, so a name defined twice resolves to its
// first definition exactly as the table scan it replaces did. Each chain
// write is a field-receiver `.with` on the `own` root, the shape the
// self-host stores in place (#8419).
function arm64_asm_label(own a: Arm64Asm, name: string): Arm64Asm {
  let at: i32 = a.lab_names.len();
  let b: i32 = arm64_name_bucket(name);
  let prev: i32 = a.lab_tail[b];
  a = Arm64Asm { ...a, lab_names: a.lab_names.append(name) };
  a = Arm64Asm { ...a, lab_offs: a.lab_offs.append(buf_len(a.code)) };
  a = Arm64Asm { ...a, lab_next: a.lab_next.append(0 - 1) };
  if (prev < 0) {
    a = Arm64Asm { ...a, lab_head: a.lab_head.with(b, at) };
  } else {
    a = Arm64Asm { ...a, lab_next: a.lab_next.with(prev, at) };
  }
  a = Arm64Asm { ...a, lab_tail: a.lab_tail.with(b, at) };
  return a;
}

// arm64_asm_label_off returns the byte offset of label `name`, or -1 if it
// has not been placed yet. Walks the name's bucket chain: the whole-table
// scan it replaces ran once per branch and again per resolve.
pub function arm64_asm_label_off(a: Arm64Asm, name: string): i32 {
  let i: i32 = a.lab_head[arm64_name_bucket(name)];
  while (i >= 0) {
    if (a.lab_names[i] == name) {
      return a.lab_offs[i];
    }
    i = a.lab_next[i];
  }
  return 0 - 1;
}

// ---- branch reach ----
//
// The three patchers below MASK the displacement into its immediate field, so
// an overflow does not fail — it wraps into a different, valid-looking branch.
// Nothing downstream can tell: the assembler reports success, the binary links,
// and it jumps somewhere arbitrary at run time. That is the same silence the
// undefined-label case used to produce, and it is reachable here: clang refuses
// to link the self-host compiler's own text because its `bl __fern_*` calls
// exceed imm26's ±128 MB, and this assembler links that text without comment.
//
// The retired Go assembler inserted veneers for imm26; this refuses instead:
// a diagnostic rather than a wrong branch.

// arm64_branch_field_bits is the immediate width a fixup kind patches: imm26
// for b/bl, imm19 for b.cond/cbz/cbnz, imm14 for tbz/tbnz.
function arm64_branch_field_bits(kind: i32): i32 {
  if (kind == 1) {
    return 19;
  }
  if (kind == 2) {
    return 14;
  }
  return 26;
}

// arm64_rel_fits reports whether a byte displacement is encodable in a signed
// `bits`-wide instruction-count field. AArch64 scales branch offsets by 4, so
// the field holds rel/4 and the reach is +/- (1 << (bits + 1)) bytes: 128 MB
// for imm26, 1 MB for imm19, 32 KB for imm14. A displacement that is not
// 4-aligned is unencodable at any width.
function arm64_rel_fits(rel: i32, bits: i32): boolean {
  if ((rel & 3) != 0) {
    return false;
  }
  let half: i32 = 1;
  let k: i32 = 0;
  while (k < bits - 1) {
    half = half * 2;
    k = k + 1;
  }
  let insns: i32 = rel / 4;
  return insns >= 0 - half && insns < half;
}

// arm64_oor_note describes an over-range branch for the refusal list.
function arm64_oor_note(name: string, rel: i32, bits: i32): string {
  return name + " (" + arm64_gas_dec(rel) + " bytes, imm" + arm64_gas_dec(bits) + ")";
}

// arm64_asm_fixup_or_patch handles a branch placeholder just emitted into
// a.code (its instruction word at buf_len(a.code)-4). `kind` selects the
// immediate field. If the target label is already placed, queue the patch;
// otherwise queue a fixup for arm64_asm_resolve to look the label up.
function arm64_asm_fixup_or_patch(own a: Arm64Asm, name: string, kind: i32): Arm64Asm {
  let at: i32 = buf_len(a.code) - 4;
  let target: i32 = arm64_asm_label_off(a, name);
  if (target >= 0) {
    let bits: i32 = arm64_branch_field_bits(kind);
    if (!arm64_rel_fits(target - at, bits)) {
      return Arm64Asm { ...a, oor: a.oor.append(arm64_oor_note(name, target - at, bits)) };
    }
    a = arm64_queue_patch(a, at, kind, target - at);
  } else {
    let ref: i32 = a.fix_names.len();
    a = Arm64Asm { ...a, fix_names: a.fix_names.append(name) };
    a = arm64_queue_fixup(a, at, ref << 3 | kind << 1 | 1);
  }
  return a;
}

// arm64_queue_fixup records a forward fixup at `at` whose high word is `hi`.
function arm64_queue_fixup(own a: Arm64Asm, at: i32, hi: i32): Arm64Asm {
  if (a.fixq == 0 as usize) {
    a = Arm64Asm { ...a, fixq: buf_new(8192) };
  }
  buf_push_u64(a.fixq, (hi as i64 << 32 | at as i64 & 4294967295i64) as u64);
  return a;
}

// arm64_fix_count is how many forward fixups are queued.
function arm64_fix_count(a: Arm64Asm): i32 {
  if (a.fixq == 0 as usize) {
    return 0;
  }
  return buf_len(a.fixq) / 8;
}

// arm64_asm_label_id places label id `id` at the current offset.
function arm64_asm_label_id(own a: Arm64Asm, id: i32): Arm64Asm {
  let offs: i32[] = a.lid_offs;
  a = Arm64Asm { ...a, lid_offs: [] };
  while (offs.len() <= id) {
    offs = offs.append(0 - 1);
  }
  return Arm64Asm { ...a, lid_offs: offs.with(id, buf_len(a.code)) };
}

function arm64_lid_off(a: Arm64Asm, id: i32): i32 {
  if (id < 0 || id >= a.lid_offs.len()) {
    return 0 - 1;
  }
  return a.lid_offs[id];
}

// arm64_asm_fixup_id is arm64_asm_fixup_or_patch for a branch, just
// appended, to label id `id`.
function arm64_asm_fixup_id(own a: Arm64Asm, id: i32, kind: i32): Arm64Asm {
  let at: i32 = buf_len(a.code) - 4;
  let target: i32 = arm64_lid_off(a, id);
  if (target < 0) {
    return arm64_queue_fixup(a, at, id << 3 | kind << 1);
  }
  let bits: i32 = arm64_branch_field_bits(kind);
  if (!arm64_rel_fits(target - at, bits)) {
    return Arm64Asm { ...a, oor: a.oor.append(arm64_oor_note("#" + arm64_gas_dec(id), target - at, bits)) };
  }
  return arm64_queue_patch(a, at, kind, target - at);
}

// arm64_queue_patch records a patch of `kind` at `at` whose displacement is
// already known. `rel` is a multiple of four, so the kind rides its low bits.
function arm64_queue_patch(own a: Arm64Asm, at: i32, kind: i32, rel: i32): Arm64Asm {
  if (a.patq == 0 as usize) {
    a = Arm64Asm { ...a, patq: buf_new(8192) };
  }
  buf_push_u64(a.patq, ((rel | kind) as i64 << 32 | at as i64 & 4294967295i64) as u64);
  return a;
}

// arm64_asm_b / arm64_asm_bl emit an unconditional branch / call to a
// (possibly forward) label.
function arm64_asm_b(own a: Arm64Asm, name: string): Arm64Asm {
  arm64_push_arr(a.code, arm64_b([], 0));
  return arm64_asm_fixup_or_patch(a, name, 0);
}

function arm64_asm_bl(own a: Arm64Asm, name: string): Arm64Asm {
  arm64_push_arr(a.code, arm64_bl([], 0));
  return arm64_asm_fixup_or_patch(a, name, 0);
}

// arm64_asm_bcond / arm64_asm_cbz / arm64_asm_cbnz emit a conditional
// branch to a (possibly forward) label.
function arm64_asm_bcond(own a: Arm64Asm, cond: i32, name: string): Arm64Asm {
  arm64_push_arr(a.code, arm64_bcond([], cond, 0));
  return arm64_asm_fixup_or_patch(a, name, 1);
}

function arm64_asm_cbz(own a: Arm64Asm, rt: i32, name: string, w: boolean): Arm64Asm {
  arm64_push_arr(a.code, arm64_cbz([], rt, 0, w));
  return arm64_asm_fixup_or_patch(a, name, 1);
}

function arm64_asm_cbnz(own a: Arm64Asm, rt: i32, name: string, w: boolean): Arm64Asm {
  arm64_push_arr(a.code, arm64_cbnz([], rt, 0, w));
  return arm64_asm_fixup_or_patch(a, name, 1);
}

// arm64_fixup_name names a fixup's target for a message: its label, or
// `#id`.
function arm64_fixup_name(a: Arm64Asm, hi: i32): string {
  if ((hi & 1) != 0) {
    return a.fix_names[hi >> 3];
  }
  return "#" + arm64_gas_dec(hi >> 3);
}

// arm64_asm_resolve takes the code out of its builder, applies the queued
// patches, and patches every fixup now that all labels are placed. Call once
// after emitting the whole program; afterwards a.text is the final .text.
// The bytes are threaded through both loops as a uniquely-owned local and
// folded back at the end, so each patch writes in place (#6011).
function arm64_asm_resolve(own a: Arm64Asm): Arm64Asm {
  let code: u8[] = buf_take_bytes(a.code);
  buf_free(a.code);
  a = Arm64Asm { ...a, code: 0 as usize };
  if (a.patq != 0 as usize) {
    let pq: u8[] = buf_take_bytes(a.patq);
    buf_free(a.patq);
    a = Arm64Asm { ...a, patq: 0 as usize };
    let q: i32 = 0;
    let nq: i32 = pq.len();
    while (q < nq) {
      let at: i32 = pq[q] as i32 | pq[q + 1] as i32 << 8 | pq[q + 2] as i32 << 16 | pq[q + 3] as i32 << 24;
      let hi: i32 = pq[q + 4] as i32 | pq[q + 5] as i32 << 8 | pq[q + 6] as i32 << 16 | pq[q + 7] as i32 << 24;
      let kind: i32 = hi & 3;
      code = arm64_patch_bytes(code, at, arm64_branch_keep(kind), arm64_branch_field(kind, hi - kind));
      q = q + 8;
    }
  }
  let fq: u8[] = [];
  if (a.fixq != 0 as usize) {
    fq = buf_take_bytes(a.fixq);
    buf_free(a.fixq);
    a = Arm64Asm { ...a, fixq: 0 as usize };
  }
  let i: i32 = 0;
  let nf: i32 = fq.len();
  while (i < nf) {
    let at: i32 = fq[i] as i32 | fq[i + 1] as i32 << 8 | fq[i + 2] as i32 << 16 | fq[i + 3] as i32 << 24;
    let hi: i32 = fq[i + 4] as i32 | fq[i + 5] as i32 << 8 | fq[i + 6] as i32 << 16 | fq[i + 7] as i32 << 24;
    let kind: i32 = hi >> 1 & 3;
    let target: i32 = 0 - 1;
    if ((hi & 1) != 0) {
      target = arm64_asm_label_off(a, a.fix_names[hi >> 3]);
    } else {
      target = arm64_lid_off(a, hi >> 3);
    }
    if (target < 0) {
      // A target that was never defined used to be patched as if the -1
      // sentinel were an offset, producing a well-formed binary that
      // branched to `-1 - here` — inside the ELF header, where the word is
      // zero, which is UDF #0. That silence is what let #6045 read as a
      // codegen mystery for as long as it did. Record the name and leave
      // the placeholder alone; arm64_gas_program folds these into the
      // refusal list, so the CLI reports the label instead of emitting a
      // binary that traps.
      a = Arm64Asm { ...a, unres: a.unres.append(arm64_fixup_name(a, hi)) };
      i = i + 8;
      continue;
    }
    let rbits: i32 = arm64_branch_field_bits(kind);
    if (!arm64_rel_fits(target - at, rbits)) {
      a = Arm64Asm { ...a, oor: a.oor.append(arm64_oor_note(arm64_fixup_name(a, hi), target - at, rbits)) };
      i = i + 8;
      continue;
    }
    code = arm64_patch_bytes(code, at, arm64_branch_keep(kind), arm64_branch_field(kind, target - at));
    i = i + 8;
  }
  return Arm64Asm { ...a, text: code };
}

// ---- load / store (64-bit, unsigned scaled immediate) ----
//
// The base+offset forms `ldr/str Xt, [Xn, #off]`. The 12-bit immediate is
// scaled by 8 (the access size), so `off` must be a multiple of 8 in
// 0..32760. Register 31 names SP here (the stack pointer), not XZR — used
// for spills to the stack frame.
//   str: (3<<30)|0x39000000              = 0xF9000000
//   ldr: 0xF9000000 | 0x00400000          = 0xF9400000
//        | (off/8)<<10 | Rn<<5 | Rt

function arm64_sp(): i32 {  // SP in load/store + add/sub-imm context
  return 31;
}

function arm64_str_word(rt: i32, rn: i32, off: i32): i64 {
  return 0xf9000000 | (off / 8 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64;
}

function arm64_ldr_word(rt: i32, rn: i32, off: i32): i64 {
  return 0xf9400000 | (off / 8 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64;
}

// The 32-bit forms are NOT a cleared sf bit: the width lives in the size field
// (bits 31:30), 11 -> 10, and the scaled immediate is divided by the ACCESS SIZE,
// so a 32-bit offset scales by 4 where the 64-bit one scales by 8. Getting only
// the base right would keep the width bug and add an addressing bug.
// Verified vs clang: str w0,[x1] = 0xb9000020, str w2,[x0,#8] = 0xb9000802,
// ldr w0,[sp,#8] = 0xb9400be0, ldr w3,[x4,#4] = 0xb9400483.
function arm64_str_word_w(rt: i32, rn: i32, off: i32): i64 {
  return 0xb9000000 | (off / 4 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64;
}

function arm64_ldr_word_w(rt: i32, rn: i32, off: i32): i64 {
  return 0xb9400000 | (off / 4 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64;
}

function arm64_str(buf: i32[], rt: i32, rn: i32, off: i32, w: boolean): i32[] {
  if (w) {
    return arm64_le32(buf, arm64_str_word_w(rt, rn, off));
  }
  return arm64_le32(buf, arm64_str_word(rt, rn, off));
}

function arm64_ldr(buf: i32[], rt: i32, rn: i32, off: i32, w: boolean): i32[] {
  if (w) {
    return arm64_le32(buf, arm64_ldr_word_w(rt, rn, off));
  }
  return arm64_le32(buf, arm64_ldr_word(rt, rn, off));
}

// SIMD&FP load/store of an S, D or Q register; `size` is the access's
// log2 (2, 3, 4). S clears bit 30 of the size-11 D encoding and halves the
// offset scale; Q is size 00 with opc 1x (0x3D8/0x3DC00000 scaled,
// 0x3C8/0x3CC00000 imm9) and scales by 16. Two encoding shapes:
//
//   scaled unsigned imm12 : ldr 0xFD400000 / str 0xFD000000, imm12 =
//     off/8 (off/4 for S) — the f64 constant-load form. Verified vs
//     llvm-mc: ldr d0,[x0,#8] = 0xfd400400.
//   signed unscaled imm9  : ldr 0xFC400000 / str 0xFC000000 with index
//     bits 11:10 selecting no-writeback (00, the ldur/stur form), post-
//     index (01) or pre-index (11) — `idx` is 0 / 0x400 / 0xC00. The
//     float path emits `str d8, [sp, #-16]!` and `ldr d8, [sp], #16`;
//     routing them through the scaled encoder wrapped the offset and
//     dropped the writeback (#6060). Verified vs clang:
//     str d8,[sp,#-16]! = 0xfc1f0fe8, ldr d8,[sp],#16 = 0xfc4107e8,
//     stur d0,[x12,#-8] = 0xfc1f8180.
function arm64_ldst_fp_scaled(buf: i32[], load: boolean, rt: i32, rn: i32, off: i32, size: i32): i32[] {
  let base: i64 = 0xfd000000;
  if (load) {
    base = 0xfd400000;
  }
  let scale: i32 = 8;
  if (size == 2) {
    base = base & 0xbfffffff;
    scale = 4;
  }
  if (size == 4) {
    base = 0x3d800000;
    if (load) {
      base = 0x3dc00000;
    }
    scale = 16;
  }
  return arm64_le32(buf, base | (off / scale & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_ldst_fp_imm9(buf: i32[], load: boolean, rt: i32, rn: i32, off: i32, idx: i32, size: i32): i32[] {
  let base: i64 = 0xfc000000;
  if (load) {
    base = 0xfc400000;
  }
  if (size == 2) {
    base = base & 0xbfffffff;
  }
  if (size == 4) {
    base = 0x3c800000;
    if (load) {
      base = 0x3cc00000;
    }
  }
  return arm64_le32(buf, base | (idx & 0xc00) as i64 | (off & 0x1ff) as i64 << 12 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

// ---- PC-relative page addressing (@PAGE / @PAGEOFF) ----
//
// A 64-bit constant in __DATA is addressed in two steps, exactly as ld64's
// @PAGE / @PAGEOFF relocations resolve:
//   adrp Xn, sym@PAGE      ; Xn = (PC & ~0xFFF) + (page_delta << 12)
//   ldr  Xt, [Xn, #off]    ; off = sym & 0xFFF  (the @PAGEOFF)
// page_delta is the signed 4 KiB-page distance between the symbol and the
// adrp instruction, computed from the fixed addresses macho.fern lays the
// image out at (macho_text_vaddr / macho_data_vaddr — the SegmentAddrs
// parity). Because both segments share the 16 KiB Mach-O page alignment,
// @PAGEOFF is always 4 KiB-aligned here, but the math is general.

// arm64_page_delta returns the 4 KiB-page delta from the adrp instruction
// at `adrp_addr` to the target at `target_addr` (the adrp immediate).
function arm64_page_delta(target_addr: i64, adrp_addr: i64): i32 {
  return ((target_addr >> 12) - (adrp_addr >> 12)) as i32;
}

// arm64_page_off returns the in-page byte offset of `addr` (the @PAGEOFF).
function arm64_page_off(addr: i64): i32 {
  return (addr & 0xfff) as i32;
}

// arm64_adrp_word encodes `adrp Xd, #page_delta` -> 0x90000000 |
// immlo<<29 | immhi<<5 | Rd, where the 21-bit page delta splits into
// immlo (bits 1:0) and immhi (bits 20:2).
function arm64_adrp_word(rd: i32, page_delta: i32): i64 {
  let immlo: i64 = (page_delta & 3) as i64;
  let immhi: i64 = (page_delta >> 2 & 0x7ffff) as i64;
  return 0x90000000 | immlo << 29 | immhi << 5 | (rd & 31) as i64;
}

function arm64_adrp(buf: i32[], rd: i32, page_delta: i32): i32[] {
  return arm64_le32(buf, arm64_adrp_word(rd, page_delta));
}

// arm64_adr encodes `adr Xd, #byte_delta` -> 0x10000000 | immlo<<29 |
// immhi<<5 | Rd. Unlike adrp the signed 21-bit immediate is in BYTES
// (±1 MB), so no companion :lo12: add is needed; the immlo/immhi field
// layout is adrp's, so arm64_patch_adrp splices either.
function arm64_adr(buf: i32[], rd: i32, delta: i32): i32[] {
  let immlo: i64 = (delta & 3) as i64;
  let immhi: i64 = (delta >> 2 & 0x7ffff) as i64;
  return arm64_le32(buf, 0x10000000 | immlo << 29 | immhi << 5 | (rd & 31) as i64);
}

// arm64_adrp_field places a page delta — or, for `adr`, a byte delta, the
// field layout is shared — in the immlo:immhi field, beside the opcode + Rd
// that the mask 0x9f00001f keeps.
function arm64_adrp_field(delta: i32): i64 {
  return (delta & 3) as i64 << 29 | (delta >> 2 & 0x7ffff) as i64 << 5;
}

// arm64_imm12_field places a 12-bit immediate in bits 21:10, beside the
// opcode + Rd/Rn that the mask 0xffc003ff keeps.
function arm64_imm12_field(v: i32): i64 {
  return (v & 0xfff) as i64 << 10;
}

// arm64_patch_adrp splices a page_delta into an `adrp` placeholder, or a
// byte delta into an `adr` one, at byte offset `at`.
function arm64_patch_adrp(own buf: i32[], at: i32, page_delta: i32): i32[] {
  let w: i64 = arm64_read_word(buf, at) & 0x9f00001f | arm64_adrp_field(page_delta);
  return arm64_write_word(buf, at, w);
}

// arm64_patch_ldr_off splices a byte offset, scaled by 8, into the imm12
// field of an `ldr` placeholder at byte offset `at`.
function arm64_patch_ldr_off(own buf: i32[], at: i32, off: i32): i32[] {
  let w: i64 = arm64_read_word(buf, at) & 0xffc003ff | arm64_imm12_field(off / 8);
  return arm64_write_word(buf, at, w);
}

// ---- PC-relative literal load (`ldr Xt, =N` + `.ltorg` pool) ----
//
// asm_arm64 loads any 64-bit immediate via `ldr Xt, =N` and flushes the
// constants into an in-.text literal pool at each `.ltorg` (after every
// function). The LDR (literal) form (64-bit, opc=01) is
//   0x58000000 | imm19<<5 | Rt
// where imm19 = (pool_addr - ldr_addr) / 4 (signed, the label is PC-
// relative from the ldr). Verified vs llvm-mc: a ldr to PC+8 = 0x58000040.
function arm64_ldr_lit_word(rt: i32, imm19: i32): i64 {
  return 0x58000000 | (imm19 & 0x7ffff) as i64 << 5 | (rt & 31) as i64;
}

function arm64_ldr_lit(buf: i32[], rt: i32, imm19: i32): i32[] {
  return arm64_le32(buf, arm64_ldr_lit_word(rt, imm19));
}

// ---- pair load/store (the prologue/epilogue idiom, and W/D/Q pairs) ----
//
// stp/ldp for X (class base 0xA8000000, offset scale 8), W (0x28000000,
// scale 4), D (0x6C000000, scale 8) and Q (0xAC000000, scale 16) register
// pairs in all three addressing modes. The caller folds the load bit (0x00400000) and the
// addressing mode (post=1, offset=2, pre=3 at bits 24:23) into `base`;
// `off` is the byte offset, which callers must range-check to a signed
// multiple of `scale` reaching the imm7 field (the mask here would
// otherwise wrap it into a different, valid instruction).
function arm64_pair(buf: i32[], base: i64, rt: i32, rt2: i32, rn: i32, off: i32, scale: i32): i32[] {
  let imm7: i64 = (off / scale & 0x7f) as i64;
  return arm64_le32(buf, base | imm7 << 15 | (rt2 & 31) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

// ---- single load/store with writeback (signed 9-bit unscaled imm9) ----
//
// `str Xt, [Xn, #off]!` (pre) / `ldr Xt, [Xn], #off` (post) and the two
// mirror forms — the bare push/pop idiom. imm9 is a signed byte offset
// (NOT scaled). Index bits 11:10: pre = 0b11, post = 0b01.
//   base: (3<<30)|0x38000000 | (load?0x00400000)

function arm64_str_pre_word(rt: i32, rn: i32, off: i32): i64 {
  return 0xf8000000 | (off & 0x1ff) as i64 << 12 | 0xc00 | (rn & 31) as i64 << 5 | (rt & 31) as i64;
}

function arm64_str_post_word(rt: i32, rn: i32, off: i32): i64 {
  return 0xf8000000 | (off & 0x1ff) as i64 << 12 | 0x400 | (rn & 31) as i64 << 5 | (rt & 31) as i64;
}

function arm64_ldr_pre_word(rt: i32, rn: i32, off: i32): i64 {
  return 0xf8400000 | (off & 0x1ff) as i64 << 12 | 0xc00 | (rn & 31) as i64 << 5 | (rt & 31) as i64;
}

function arm64_ldr_post_word(rt: i32, rn: i32, off: i32): i64 {
  return 0xf8400000 | (off & 0x1ff) as i64 << 12 | 0x400 | (rn & 31) as i64 << 5 | (rt & 31) as i64;
}

function arm64_str_pre(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, arm64_str_pre_word(rt, rn, off));
}

function arm64_str_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, arm64_str_post_word(rt, rn, off));
}

function arm64_ldr_pre(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, arm64_ldr_pre_word(rt, rn, off));
}

function arm64_ldr_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, arm64_ldr_post_word(rt, rn, off));
}

// ---- bitfield extract + negate + test-bit branch ----

// arm64_ubfx_word encodes `ubfx Rd, Rn, #lsb, #width` (unsigned bitfield
// extract) — the UBFM alias with immr=lsb, imms=lsb+width-1.
function arm64_ubfx_word(rd: i32, rn: i32, lsb: i32, width: i32, w: boolean): i64 {
  let immr: i64 = (lsb & 63) as i64;
  let imms: i64 = (lsb + width - 1 & 63) as i64;
  // The 32-bit form is not the 64-bit word with sf cleared: N drops too,
  // so the base is 0x53000000 rather than 0x93400000.
  // Verified vs gas: ubfx w1,w2,#3,#8 = 0x53032841, ubfx x1,x2,#3,#8 = 0xd3432841.
  let base: i64 = 0xd3400000;
  if (w) {
    base = 0x53000000;
  }
  return base | immr << 16 | imms << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
}

function arm64_ubfx(buf: i32[], rd: i32, rn: i32, lsb: i32, width: i32, w: boolean): i32[] {
  return arm64_le32(buf, arm64_ubfx_word(rd, rn, lsb, width, w));
}

// sbfx is the same alias over SBFM: opc 00 instead of 10.
// Verified vs gas: sbfx x1,x2,#3,#8 = 0x93432841, sbfx w1,w2,#3,#8 = 0x13032841.
function arm64_sbfx_word(rd: i32, rn: i32, lsb: i32, width: i32, w: boolean): i64 {
  let immr: i64 = (lsb & 63) as i64;
  let imms: i64 = (lsb + width - 1 & 63) as i64;
  let base: i64 = 0x93400000;
  if (w) {
    base = 0x13000000;
  }
  return base | immr << 16 | imms << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
}

function arm64_sbfx(buf: i32[], rd: i32, rn: i32, lsb: i32, width: i32, w: boolean): i32[] {
  return arm64_le32(buf, arm64_sbfx_word(rd, rn, lsb, width, w));
}

// arm64_sxtw_word encodes `sxtw Xd, Wn` — sign-extend a 32-bit word to
// 64 bits. It's the SBFM-64 alias `sbfm Xd, Xn, #0, #31` (N=1, immr=0,
// imms=31). asm_arm64 emits it widening an i32 to i64 before 64-bit math.
//   0x93407c00 | Rn<<5 | Rd  (verified vs llvm-mc: sxtw x9,w9 = 0x93407d29)
function arm64_sxtw_word(rd: i32, rn: i32): i64 {
  return 0x93407c00 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
}

function arm64_sxtw(buf: i32[], rd: i32, rn: i32): i32[] {
  return arm64_le32(buf, arm64_sxtw_word(rd, rn));
}

// arm64_rec_sxtw is the word of `sxtw Xd, Wn`, -1 for operands that are
// not an x destination and a w source.
pub function arm64_rec_sxtw(d: string, w: string): i64 {
  let rd: i32 = arm64_rec_gpr(d);
  let rn: i32 = arm64_rec_gpr(w);
  if (rd < 0 || rn < 0 || d[0] != b'x' || w[0] != b'w') {
    return 0 - 1;
  }
  return arm64_sxtw_word(rd, rn);
}

// arm64_extend_word encodes the sxtb/sxth/uxtb/uxth aliases of SBFM/UBFM:
// immr=0 and imms=7 (byte) or 15 (halfword). The unsigned pair has no
// 64-bit form: gas takes `uxtb x0, w1` and emits the W word for it, so `x`
// is consulted only for the signed one.
// Verified vs gas: sxtb x0,w1 = 0x93401c20, sxtb w0,w1 = 0x13001c20,
// sxth x0,w1 = 0x93403c20, uxtb w0,w1 = 0x53001c20, uxth w0,w1 = 0x53003c20.
function arm64_extend_word(rd: i32, rn: i32, sign: boolean, half: boolean, x: boolean): i64 {
  let base: i64 = 0x53000000;
  if (sign) {
    base = 0x13000000;
    if (x) {
      base = 0x93400000;
    }
  }
  let imms: i64 = 7;
  if (half) {
    imms = 15;
  }
  return base | imms << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
}

function arm64_extend(buf: i32[], rd: i32, rn: i32, sign: boolean, half: boolean, x: boolean): i32[] {
  return arm64_le32(buf, arm64_extend_word(rd, rn, sign, half, x));
}

// arm64_nop_word is the canonical NOP (`hint #0`); arm64_br_word is the
// unconditional indirect branch `br Xn`, blr's tail-call sibling.
// Verified vs gas: nop = 0xd503201f, br x5 = 0xd61f00a0.
function arm64_nop_word(): i64 {
  return 0xd503201f;
}

function arm64_nop(buf: i32[]): i32[] {
  return arm64_le32(buf, arm64_nop_word());
}

function arm64_br_word(rn: i32): i64 {
  return 0xd61f0000 | (rn & 31) as i64 << 5;
}

function arm64_br(buf: i32[], rn: i32): i32[] {
  return arm64_le32(buf, arm64_br_word(rn));
}

// arm64_tbz_word / arm64_tbnz_word encode `tbz/tbnz Xt, #bit, <rel>` —
// test bit `bit` and branch if zero / nonzero. rel is a PC-relative byte
// delta (÷4 -> signed imm14 at bits 18:5). The tested bit splits into b5
// (bit 31) and b40 (bits 23:19).
//   tbz base 0x36000000, tbnz base 0x37000000.
function arm64_tbz_word(rt: i32, bit: i32, rel: i32): i64 {
  let b5: i64 = (bit >> 5 & 1) as i64;
  let b40: i64 = (bit & 31) as i64;
  return 0x36000000 | b5 << 31 | b40 << 19 | (rel >> 2 & 0x3fff) as i64 << 5 | (rt & 31) as i64;
}

function arm64_tbnz_word(rt: i32, bit: i32, rel: i32): i64 {
  let b5: i64 = (bit >> 5 & 1) as i64;
  let b40: i64 = (bit & 31) as i64;
  return 0x37000000 | b5 << 31 | b40 << 19 | (rel >> 2 & 0x3fff) as i64 << 5 | (rt & 31) as i64;
}

function arm64_tbz(buf: i32[], rt: i32, bit: i32, rel: i32): i32[] {
  return arm64_le32(buf, arm64_tbz_word(rt, bit, rel));
}

// tbz/tbnz put the bit index's high bit in position 31 (b5), so a 32-bit test
// simply has b5 = 0 — which arm64_tbnz_word already produces for bit < 32. The
// `w` flag is accepted for symmetry with the other forms and asserts nothing:
// clearing bit 31 for a bit index >= 32 would silently test the WRONG BIT, so
// the width comes from the index, not from the register spelling. Verified vs
// clang: tbnz w2,#31 = 0x37f800a2 (same word the 64-bit builder emits for
// bit 31).
function arm64_tbnz(buf: i32[], rt: i32, bit: i32, rel: i32): i32[] {
  return arm64_le32(buf, arm64_tbnz_word(rt, bit, rel));
}

// arm64_asm_tbz / arm64_asm_tbnz emit a test-bit branch to a (possibly
// forward) label (fixup kind 2 = imm14).
function arm64_asm_tbz(own a: Arm64Asm, rt: i32, bit: i32, name: string): Arm64Asm {
  arm64_push_arr(a.code, arm64_tbz([], rt, bit, 0));
  return arm64_asm_fixup_or_patch(a, name, 2);
}

function arm64_asm_tbnz(own a: Arm64Asm, rt: i32, bit: i32, name: string): Arm64Asm {
  arm64_push_arr(a.code, arm64_tbnz([], rt, bit, 0));
  return arm64_asm_fixup_or_patch(a, name, 2);
}

// ---- register-offset load/store, unscaled load/store, conditional-set ----

// arm64_ldst_regext encodes the register / extended-register offset loads
// and stores `[Xn, Rm, <ext> {#amt}]` for any size (0=b, 1=h, 2=w, 3=x):
// (size<<30) | 0x38200800 | load<<22 | Rm<<16 | option<<13 | S<<12.
// option: UXTW=2, LSL/UXTX=3, SXTW=6, SXTX=7 — the W-indexed options
// widen a 32-bit offset register. `scaled` sets S, shifting the index by
// log2 of the access size. This form is what the string-copy loops emit
// (`ldrb w0, [x0, x1]` — base + index; its absence was #6047).
function arm64_ldst_regext(buf: i32[], size: i32, load: boolean, rt: i32, rn: i32, rm: i32, option: i32, scaled: boolean): i32[] {
  return arm64_le32(buf, arm64_ldst_regext_word(size, load, rt, rn, rm, option, scaled));
}

function arm64_ldst_regext_word(size: i32, load: boolean, rt: i32, rn: i32, rm: i32, option: i32, scaled: boolean): i64 {
  let word: i64 = (size & 3) as i64 << 30 | 0x38200800;
  if (load) {
    word = word | 0x00400000;
  }
  if (scaled) {
    word = word | 0x1000;
  }
  return word | (rm & 31) as i64 << 16 | (option & 7) as i64 << 13 | (rn & 31) as i64 << 5 | (rt & 31) as i64;
}

// arm64_ldur / arm64_stur encode `ldur/stur Xt, [Xn, #off]` — the unscaled
// signed-imm9 load/store (no writeback, no scaling), the form the backend
// uses for frame-slot access. 0xF8400000 / 0xF8000000 | imm9<<12 | Rn<<5 | Rt.
// Unscaled (imm9), so unlike ldr/str above only the size field changes:
// 0xf8400000 -> 0xb8400000 and 0xf8000000 -> 0xb8000000. Verified vs clang:
// ldur w1,[x0,#-8] = 0xb85f8001, stur w1,[x0,#-16] = 0xb81f0001.
function arm64_ldur(buf: i32[], rt: i32, rn: i32, off: i32, w32: boolean): i32[] {
  return arm64_le32(buf, arm64_unscaled_word(0xf8400000, rt, rn, off, w32));
}

function arm64_stur(buf: i32[], rt: i32, rn: i32, off: i32, w32: boolean): i32[] {
  return arm64_le32(buf, arm64_unscaled_word(0xf8000000, rt, rn, off, w32));
}

// arm64_unscaled_word is the X-form ldur/stur `base` at either width: the W
// form clears bit 30 of the size field.
function arm64_unscaled_word(base: i64, rt: i32, rn: i32, off: i32, w32: boolean): i64 {
  if (w32) {
    base = base & 0xbfffffff;
  }
  return base | (off & 0x1ff) as i64 << 12 | (rn & 31) as i64 << 5 | (rt & 31) as i64;
}

// arm64_ldst_unscaled is the size-general ldur/stur (0=b, 1=h — the w/x
// forms above are its size-2/3 specialisations): (size<<30) | 0x38000000
// | load<<22 | imm9<<12.
function arm64_ldst_unscaled(buf: i32[], size: i32, load: boolean, rt: i32, rn: i32, off: i32): i32[] {
  let base: i64 = (size & 3) as i64 << 30 | 0x38000000;
  if (load) {
    base = base | 0x00400000;
  }
  return arm64_le32(buf, base | (off & 0x1ff) as i64 << 12 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

// arm64_ldst_sun encodes ldursb/ldursh/ldursw — the sign-extending loads
// with a signed unscaled imm9: (size<<30) | 0x38800000, opc=10 for an X
// destination, 11 for W (ldursw is size 2, X only).
function arm64_ldst_sun(buf: i32[], size: i32, to64: boolean, rt: i32, rn: i32, off: i32): i32[] {
  let base: i64 = (size & 3) as i64 << 30 | 0x38800000;
  if (!to64) {
    base = base | 0x00400000;
  }
  return arm64_le32(buf, base | (off & 0x1ff) as i64 << 12 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

// ---- exclusive / acquire-release accesses (ARMv8.0, no LSE) ----
//
// size 0=b, 1=h, 2=w, 3=x. ldxr is (size<<30)|0x085F7C00, +0x8000 for the
// acquire (ldaxr) form; stxr is (size<<30)|0x08007C00 with the W status
// register at Rs, +0x8000 for release (stlxr); the non-exclusive ordered
// ldar/stlr are (size<<30)|0x08DFFC00 / 0x089FFC00.
function arm64_excl_load(buf: i32[], size: i32, acquire: boolean, rt: i32, rn: i32): i32[] {
  let base: i64 = (size & 3) as i64 << 30 | 0x085f7c00;
  if (acquire) {
    base = base | 0x8000;
  }
  return arm64_le32(buf, base | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_excl_store(buf: i32[], size: i32, release: boolean, rs: i32, rt: i32, rn: i32): i32[] {
  let base: i64 = (size & 3) as i64 << 30 | 0x08007c00;
  if (release) {
    base = base | 0x8000;
  }
  return arm64_le32(buf, base | (rs & 31) as i64 << 16 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

// The LSE swap (ARMv8.1, on the ARMv8.2-A baseline): (size<<30)|0x38208000,
// acquire at bit 23 and release at bit 22, the value stored in Rs at 16 and
// the old value loaded into Rt.
function arm64_swap(buf: i32[], size: i32, acquire: boolean, release: boolean, rs: i32, rt: i32, rn: i32): i32[] {
  let base: i64 = (size & 3) as i64 << 30 | 0x38208000;
  if (acquire) {
    base = base | 0x800000;
  }
  if (release) {
    base = base | 0x400000;
  }
  return arm64_le32(buf, base | (rs & 31) as i64 << 16 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_acqrel(buf: i32[], size: i32, load: boolean, rt: i32, rn: i32): i32[] {
  let base: i64 = (size & 3) as i64 << 30 | 0x089ffc00;
  if (load) {
    base = (size & 3) as i64 << 30 | 0x08dffc00;
  }
  return arm64_le32(buf, base | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

// dmb/dsb carry a 4-bit option (sy=0xF, st=0xE, ld=0xD, ish=0xB,
// ishst=0xA, ishld=0x9) at bits 11:8; an unlisted name would encode a
// different (weaker) barrier, so it is -1 and the caller refuses. isb
// exists only as the fixed full-system word 0xD5033FDF.
function arm64_barrier_opt(name: string): i32 {
  if (name == "sy") {
    return 15;
  }
  if (name == "st") {
    return 14;
  }
  if (name == "ld") {
    return 13;
  }
  if (name == "ish") {
    return 11;
  }
  if (name == "ishst") {
    return 10;
  }
  if (name == "ishld") {
    return 9;
  }
  return 0 - 1;
}

function arm64_barrier(buf: i32[], is_dsb: boolean, opt: i32): i32[] {
  let base: i64 = 0xd50330bf;
  if (is_dsb) {
    base = 0xd503309f;
  }
  return arm64_le32(buf, base | (opt & 15) as i64 << 8);
}

// ---- shifts (immediate), cmn, csel, and ----

// arm64_lsl_imm / arm64_lsr_imm encode `lsl/lsr Rd, Rn, #sh` — the UBFM
// aliases. `w` selects the 32-bit form (sf=0, base 0x53000000); else the
// 64-bit form (base 0xD3400000, N=1 folded in). lsl uses immr=(width-sh),
// imms=(width-1-sh); lsr uses immr=sh, imms=width-1.
function arm64_lsl_imm(buf: i32[], rd: i32, rn: i32, sh: i32, w: boolean): i32[] {
  return arm64_le32(buf, arm64_lsl_imm_word(rd, rn, sh, w));
}

function arm64_lsl_imm_word(rd: i32, rn: i32, sh: i32, w: boolean): i64 {
  let width: i32 = 64;
  let base: i64 = 0xd3400000;
  if (w) {
    width = 32;
    base = 0x53000000;
  }
  let immr: i64 = (width - sh & width - 1) as i64;
  let imms: i64 = (width - 1 - sh & 63) as i64;
  return base | immr << 16 | imms << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
}

function arm64_lsr_imm(buf: i32[], rd: i32, rn: i32, sh: i32, w: boolean): i32[] {
  let width: i32 = 64;
  let base: i64 = 0xd3400000;
  if (w) {
    width = 32;
    base = 0x53000000;
  }
  let immr: i64 = (sh & width - 1) as i64;
  let imms: i64 = (width - 1 & 63) as i64;
  return arm64_le32(buf, base | immr << 16 | imms << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

// asr's immediate form is SBFM (the SIGNED sibling of lsr's UBFM): same
// immr=sh / imms=width-1 fields, base 0x93400000 (64-bit) / 0x13000000 (32-bit).
// Verified vs clang --target=aarch64-linux-gnu: asr x0,x1,#4 = 0x9344fc20,
// asr x3,x4,#1 = 0x9341fc83, asr x5,x6,#63 = 0x937ffcc5.
//
// The dispatcher previously sent `asr Xd, Xn, #k` down the REGISTER path on the
// grounds that the emitter only produces the variable form. That was true and
// still is, but the fallback was silent and wrong: arm64_gas_reg("#4") is -1,
// masked to 31, so it assembled as `asrv Xd, Xn, xzr` — a shift by ZERO. The
// same silent-wrong-encoding shape as #6047, found by the encoding differential
// added with that fix, so it is closed here rather than left as a trap for
// whoever teaches the emitter a signed constant shift.
function arm64_asr_imm(buf: i32[], rd: i32, rn: i32, sh: i32, w: boolean): i32[] {
  let width: i32 = 64;
  let base: i64 = 0x93400000;
  if (w) {
    width = 32;
    base = 0x13000000;
  }
  let immr: i64 = (sh & width - 1) as i64;
  let imms: i64 = (width - 1 & 63) as i64;
  return arm64_le32(buf, base | immr << 16 | imms << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

// arm64_rrr appends a three-register data-processing word from its
// 64-bit base — base | Rm<<16 | Rn<<5 | Rd, with `w` clearing sf.
// Shared by the variable shifts (LSLV 0x9ac02000 / LSRV 0x9ac02400 /
// ASRV 0x9ac02800 / RORV 0x9ac02c00), the carry chain (adc 0x9a000000,
// adcs 0xba000000, sbc 0xda000000, sbcs 0xfa000000; ngc/ngcs are the
// Rn=XZR aliases), the high multiplies (umulh 0x9bc07c00, smulh
// 0x9b407c00 — X only, callers pass w=false), cmn's register form
// (adds 0xab000000, Rd=XZR) and negs (subs 0xeb000000, Rn=XZR).
function arm64_rrr(buf: i32[], base64: i64, rd: i32, rn: i32, rm: i32, w: boolean): i32[] {
  let base: i64 = base64;
  if (w) {
    base = base64 & 0x7fffffff;
  }
  return arm64_le32(buf, base | (rm & 31) as i64 << 16 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

function arm64_lslv(buf: i32[], rd: i32, rn: i32, rm: i32, w: boolean): i32[] {
  return arm64_rrr(buf, 0x9ac02000, rd, rn, rm, w);
}

function arm64_lsrv(buf: i32[], rd: i32, rn: i32, rm: i32, w: boolean): i32[] {
  return arm64_rrr(buf, 0x9ac02400, rd, rn, rm, w);
}

function arm64_asrv(buf: i32[], rd: i32, rn: i32, rm: i32, w: boolean): i32[] {
  return arm64_rrr(buf, 0x9ac02800, rd, rn, rm, w);
}

// arm64_condsel encodes the conditional-select family `<op> Rd, Rn, Rm,
// <cond>` from its 64-bit base: csel 0x9A800000, csinc 0x9A800400,
// csinv 0xDA800000, csneg 0xDA800400. The cinc/cinv/cneg/csetm aliases
// (Rn=Rm and/or XZR, inverted cond) are formed in the GAS layer.
function arm64_condsel(buf: i32[], base: i64, rd: i32, rn: i32, rm: i32, cond: i32, w: boolean): i32[] {
  let word: i64 = base | (rm & 31) as i64 << 16 | (cond & 15) as i64 << 12 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// arm64_condcmp encodes `ccmp/ccmn Rn, Rm|#imm5, #nzcv, <cond>` from its
// 64-bit base: ccmp reg 0xFA400000 / imm 0xFA400800, ccmn reg 0xBA400000
// / imm 0xBA400800. rm5 carries the Rm number or the unsigned imm5.
function arm64_condcmp(buf: i32[], base: i64, rn: i32, rm5: i32, nzcv: i32, cond: i32, w: boolean): i32[] {
  let word: i64 = base | (rm5 & 31) as i64 << 16 | (cond & 15) as i64 << 12 | (rn & 31) as i64 << 5 | (nzcv & 15) as i64;
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// arm64_muladd encodes the multiply-add class `<op> Rd, Rn, Rm, Ra` from
// its 64-bit base: madd 0x9B000000 (mul is the Ra=XZR alias), msub
// 0x9B008000, and the fixed-width widening smaddl 0x9B200000 / umaddl
// 0x9BA00000 / smsubl 0x9B208000 / umsubl 0x9BA08000 (smull/umull are
// their Ra=XZR aliases; callers pass w=false — the widths have no sf bit).
function arm64_muladd(buf: i32[], base: i64, rd: i32, rn: i32, rm: i32, ra: i32, w: boolean): i32[] {
  let word: i64 = base | (rm & 31) as i64 << 16 | (ra & 31) as i64 << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// arm64_logical_shift encodes the logical shifted-register class
// `<op> Rd, Rn, Rm{, <shift> #amt}` from its 64-bit base: and 0x8A000000,
// orr 0xAA000000, eor 0xCA000000, ands 0xEA000000, and the Rm-inverting
// bic 0x8A200000 / orn 0xAA200000 / eon 0xCA200000 / bics 0xEA200000
// (which have NO immediate encoding — the bitmask class has no invert
// bit). tst/mvn are the Rd=XZR / Rn=XZR aliases.
function arm64_logical_shift(buf: i32[], base: i64, rd: i32, rn: i32, rm: i32, st: i32, amt: i32, w: boolean): i32[] {
  let word: i64 = base | (st & 3) as i64 << 22 | (rm & 31) as i64 << 16
    | (amt & 63) as i64 << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// arm64_extr encodes `extr Rd, Rn, Rm, #lsb`. The X and W bases differ in
// the N bit as well as sf (X 0x93C00000, W 0x13800000), so this is not a
// bare sf clear. `ror Rd, Rn, #n` is the Rn=Rm alias.
function arm64_extr(buf: i32[], rd: i32, rn: i32, rm: i32, lsb: i32, w: boolean): i32[] {
  let base: i64 = 0x93c00000;
  let m: i32 = 63;
  if (w) {
    base = 0x13800000;
    m = 31;
  }
  return arm64_le32(buf, base | (rm & 31) as i64 << 16 | (lsb & m) as i64 << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

// arm64_bitfield appends a bitfield-move word: base | immr<<16 | imms<<10
// | Rn<<5 | Rd. Bases (N folded in): UBFM X 0xD3400000 / W 0x53000000,
// SBFM X 0x93400000 / W 0x13000000, BFM X 0xB3400000 / W 0x33000000. The
// bfi/bfxil/ubfiz/sbfiz alias arithmetic lives in the GAS layer.
function arm64_bitfield(buf: i32[], base: i64, rd: i32, rn: i32, immr: i32, imms: i32): i32[] {
  return arm64_le32(buf, base | (immr & 63) as i64 << 16 | (imms & 63) as i64 << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

// rev / rev32 / cls (DP 1-source, the rev16/clz family). rev's X and W
// forms differ in opc, not just sf: X 0xDAC00C00, W 0x5AC00800. rev32 is
// X only (the 32-bit-wide operation IS `rev Wd, Wn`): 0xDAC00800. cls is
// 0xDAC01400 with sf cleared for the W form.
function arm64_rev(buf: i32[], rd: i32, rn: i32, w: boolean): i32[] {
  let base: i64 = 0xdac00c00;
  if (w) {
    base = 0x5ac00800;
  }
  return arm64_le32(buf, base | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

function arm64_rev32(buf: i32[], rd: i32, rn: i32): i32[] {
  return arm64_le32(buf, 0xdac00800 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

function arm64_cls(buf: i32[], rd: i32, rn: i32, w: boolean): i32[] {
  let word: i64 = 0xdac01400 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// ---- AArch64 bitmask (logical) immediate encoder ----
//
// The encoder for
// the 64-bit `and/orr/eor Xd, Xn, #imm` immediate forms. Returns the
// (N, immr, imms) fields and whether `imm` is a legal bitmask immediate.
// Pinned vs llvm-mc. The few i64 bit-twiddles Fern lacks natively are
// provided below (logical shift right, ctz, clz) — `>>` is arithmetic, so
// logical shifts mask off the sign-extended high bits.

struct Arm64Bm {
  n: i32,
  immr: i32,
  imms: i32,
  ok: boolean,
}

// arm64_bm_lowmask returns the low-k-bits-set mask (k in 0..64).
function arm64_bm_lowmask(k: i32): i64 {
  if (k <= 0) {
    return 0;
  }
  if (k >= 64) {
    return 0 - 1;
  }
  return (1 as i64 << k) - 1;
}

// arm64_bm_lsr is a logical (unsigned) shift right of a 64-bit value.
function arm64_bm_lsr(x: i64, n: i32): i64 {
  if (n <= 0) {
    return x;
  }
  if (n >= 64) {
    return 0;
  }
  return x >> n & arm64_bm_lowmask(64 - n);
}

// arm64_bm_ctz / arm64_bm_clz count trailing / leading zero bits of a
// nonzero 64-bit value (64 if zero). Bit i is `(x >> i) & 1` — masking the
// low bit is correct regardless of the shift's sign behaviour.
function arm64_bm_ctz(x: i64): i32 {
  let i: i32 = 0;
  while (i < 64) {
    if ((x >> i & 1) == 1) {
      return i;
    }
    i = i + 1;
  }
  return 64;
}

function arm64_bm_clz(x: i64): i32 {
  let i: i32 = 0;
  while (i < 64) {
    if ((x >> 63 - i & 1) == 1) {
      return i;
    }
    i = i + 1;
  }
  return 64;
}

// arm64_bm_isshifted is true when v is a contiguous run of low ones
// (v != 0 and v+1 is a power of two): ((v-1)|v)+1 has no bits in common
// with ((v-1)|v).
function arm64_bm_isshifted(v: i64): boolean {
  if (v == 0) {
    return false;
  }
  let m: i64 = v - 1 | v;
  return (m + 1 & m) == 0;
}

// arm64_encode_bitmask encodes a 64-bit `imm` as an AArch64 logical
// immediate (N, immr, imms). ok=false if imm is not a legal bitmask value.
function arm64_encode_bitmask(imm: i64): Arm64Bm {
  if (imm == 0 || imm == 0 - 1) {
    return Arm64Bm { n: 0, immr: 0, imms: 0, ok: false };
  }
  let size: i32 = 64;
  let done: boolean = false;
  while (!done) {
    size = size / 2;
    let m: i64 = arm64_bm_lowmask(size);
    if ((imm & m) != (arm64_bm_lsr(imm, size) & m)) {
      size = size * 2;
      done = true;
    } else if (size <= 2) {
      done = true;
    }
  }
  let allones: i64 = 0 - 1;
  let mask: i64 = arm64_bm_lsr(allones, 64 - size);
  imm = imm & mask;
  let i: i32 = 0;
  let cto: i32 = 0;
  if (arm64_bm_isshifted(imm)) {
    i = arm64_bm_ctz(imm);
    cto = arm64_bm_ctz(arm64_bm_lsr(imm, i) ^ allones);
  } else {
    imm = imm | mask ^ allones;
    if (!arm64_bm_isshifted(imm ^ allones)) {
      return Arm64Bm { n: 0, immr: 0, imms: 0, ok: false };
    }
    let clo: i32 = arm64_bm_clz(imm ^ allones);
    i = 64 - clo;
    cto = clo + arm64_bm_ctz(imm ^ allones) - (64 - size);
  }
  let immr: i32 = size - i & size - 1;
  let nimms: i32 = (size - 1 ^ 0 - 1) << 1;
  nimms = nimms | cto - 1;
  let nbit: i32 = nimms >> 6 & 1 ^ 1;
  let imms: i32 = nimms & 0x3f;
  return Arm64Bm { n: nbit, immr: immr, imms: imms, ok: true };
}

// arm64_and_imm_ok reports whether `imm` (sign-extended from the parsed
// i32) is a legal `and` bitmask immediate.
function arm64_and_imm_ok(imm: i32): boolean {
  return arm64_encode_bitmask(imm as i64).ok;
}

// arm64_and_imm encodes `and Xd, Xn, #imm` / `and Wd, Wn, #imm` (logical
// immediate). Callers must check arm64_and_imm_ok(imm) first.
//
// The 32-bit form is base 0x12000000 with **N = 0**: a 32-bit logical immediate
// has no 64-bit element size to select, so the N bit is not merely the sf bit
// moved. immr/imms carry over unchanged for a single contiguous run, which is
// every mask this emitter produces (1, 31, 127, 255). Verified vs clang:
// and w10,w9,#255 = 0x12001d2a, and w9,w9,#1 = 0x12000129,
// and w0,w1,#31 = 0x12001020, and x10,x9,#255 = 0x92401d2a.
function arm64_and_imm(buf: i32[], rd: i32, rn: i32, imm: i32, w: boolean): i32[] {
  return arm64_le32(buf, arm64_logical_imm_word(0x92000000, w, rd, rn, imm as i64));
}

// ---- the logical-immediate family ----
//
// and, ands, orr and eor share one immediate encoding and differ only in the
// opcode above it, so they share one encoder here. The 32-bit form is NOT the
// 64-bit one with sf cleared: it needs N=0 and the pattern REPLICATED across
// both halves, so its fields come from encoding (v<<32)|v rather than from
// passing the 64-bit immr/imms through. Passing them through was why a run
// rotated off bit 0 — `and w1, w2, #0xfffe`, which gas encodes — was refused
// (#8138).

// arm64_bm_rep32 writes a 32-bit pattern out at 64 bits, which is what it
// means as a 32-bit logical immediate.
function arm64_bm_rep32(v: i64): i64 {
  let lo: i64 = v & 0xffffffff;
  return lo << 32 | lo;
}

// arm64_logical_imm_bits gives the (N, immr, imms) for `imm` at the width, or
// ok=false when it is not a bitmask there. A 32-bit immediate must come out
// with N=0: N=1 selects the 64-bit element size, which the 32-bit instruction
// has no room to name.
function arm64_logical_imm_bits(imm: i64, w: boolean): Arm64Bm {
  if (!w) {
    return arm64_encode_bitmask(imm);
  }
  // A positive value wider than the register is not this instruction's
  // immediate at all; rep32 would quietly keep its low half.
  if (imm > 0xffffffff) {
    return Arm64Bm { n: 0, immr: 0, imms: 0, ok: false };
  }
  // Replicating forces an element size of 32 or less, so N comes back 0 on
  // its own — the 32-bit form has no way to say otherwise.
  return arm64_encode_bitmask(arm64_bm_rep32(imm));
}

function arm64_logical_imm_ok(imm: i64, w: boolean): boolean {
  return arm64_logical_imm_bits(imm, w).ok;
}

// arm64_logical_imm_word builds the word. `base` is the 64-bit opcode; the
// 32-bit one is the same with sf cleared, for all four mnemonics.
function arm64_logical_imm_word(base: i64, w: boolean, rd: i32, rn: i32, imm: i64): i64 {
  let bm: Arm64Bm = arm64_logical_imm_bits(imm, w);
  let b: i64 = base;
  if (w) {
    b = base & 0x7fffffff;
  }
  return b | bm.n as i64 << 22 | bm.immr as i64 << 16 | bm.imms as i64 << 10
    | (rn & 31) as i64 << 5 | (rd & 31) as i64;
}

// arm64_ands_imm encodes the flag-setting `ands Rd, Rn, #imm` (tst is the
// Rd=XZR alias): base 0xF2000000, or 0x72000000 with N dropped for the
// 32-bit form — the same N rule as arm64_and_imm. Callers must check
// arm64_and_imm_ok first.
function arm64_ands_imm(buf: i32[], rd: i32, rn: i32, imm: i64, w: boolean): i32[] {
  return arm64_le32(buf, arm64_logical_imm_word(0xf2000000, w, rd, rn, imm));
}

// ---- subs / divide / rev16 ----
//
// The integer-runtime ops the self-host asm_arm64 emitter uses beyond the
// arithmetic above (verified vs llvm-mc).

// The `w` forms of the divides: sf clears, as everywhere else.
function arm64_div_w(buf: i32[], signed: boolean, rd: i32, rn: i32, rm: i32, w: boolean): i32[] {
  let word: i64 = 0x9ac00800;
  if (signed) {
    word = 0x9ac00c00;
  }
  word = word | (rm & 31) as i64 << 16 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// rev16 Xd, Xn -> 0xDAC00400 | Rn<<5 | Rd.
// `w` clears sf: 0xdac00400 -> 0x5ac00400. rev16 on a 32-bit value byte-swaps
// two halfwords; the 64-bit form swaps four, so the width is the operation.
function arm64_rev16(buf: i32[], rd: i32, rn: i32, w: boolean): i32[] {
  let word: i64 = 0xdac00400 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// clz Xd, Xn -> 0xDAC01000 | Rn<<5 | Rd (same DP-1-source family as rev16;
// the Go arm64 backend emits it for the freelist size-class log2).
//
// The `w` flag clears the sf bit for the 32-bit form, exactly as rev16 above
// does. It used to be absent, so `clz w0, w0` silently encoded the X-form and
// counted over 64 bits -- `__clz32(1)` returned 63 instead of 31, and the
// clz-derived ctz returned a NEGATIVE number (31 - 60), which surfaced as exit
// code 227 (-29 truncated to a byte) rather than as anything resembling a
// bit count. Every caller before #6197 happened to want the 64-bit form, which
// is why the missing flag went unnoticed.
function arm64_clz(buf: i32[], rd: i32, rn: i32, w: boolean): i32[] {
  let word: i64 = 0xdac01000 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// rbit Xd, Xn -> 0xDAC00000 | Rn<<5 | Rd. Third member of the same DP-1-source
// family as rev16/clz, and the ctz idiom's first half: `rbit` then `clz`
// counts trailing zeros, inheriting clz's width-at-zero (reversing zero
// leaves zero). The `w` flag clears sf exactly as clz's does -- without it a
// 32-bit ctz would reverse over 64 bits and count the empty upper half.
function arm64_rbit(buf: i32[], rd: i32, rn: i32, w: boolean): i32[] {
  let word: i64 = 0xdac00000 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (w) {
    word = word & 0x7fffffff;
  }
  return arm64_le32(buf, word);
}

// ---- the general Advanced SIMD classes (#8000) ----
//
// Two encodings carry most of the vector surface. Both read `size` as a
// field, which is what makes them general where the byte-only kernels below
// are not.

// arm64_vec3same encodes three-registers-same-arrangement: the integer ALU
// ops, the bitwise ops (where `size` selects the OPERATION, not a width),
// and the lane-wise FP ops.
//   0x0E200400 | Q<<30 | U<<29 | size<<22 | Rm<<16 | opcode<<11 | Rn<<5 | Rd
function arm64_vec3same_word(rd: i32, rn: i32, rm: i32, opcode: i32, size: i32, q: boolean, u: boolean): i64 {
  let word: i64 = 0x0e200400 | (size & 3) as i64 << 22 | (rm & 31) as i64 << 16
    | (opcode & 31) as i64 << 11 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  if (u) {
    word = word | 0x20000000;
  }
  return word;
}

function arm64_vec3same(buf: i32[], rd: i32, rn: i32, rm: i32, opcode: i32, size: i32, q: boolean, u: boolean): i32[] {
  return arm64_le32(buf, arm64_vec3same_word(rd, rn, rm, opcode, size, q, u));
}

// arm64_vec3diff encodes three-registers-DIFFERENT: the widening ops, whose
// result elements are one size up, so the opcode field is four bits and bits
// 11:10 are zero rather than the `01` arm64_vec3same carries.
//   0x0E200000 | Q<<30 | U<<29 | size<<22 | Rm<<16 | opcode<<12 | Rn<<5 | Rd
function arm64_vec3diff_word(rd: i32, rn: i32, rm: i32, opcode: i32, size: i32, q: boolean, u: boolean): i64 {
  let word: i64 = 0x0e200000 | (size & 3) as i64 << 22 | (rm & 31) as i64 << 16
    | (opcode & 15) as i64 << 12 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  if (u) {
    word = word | 0x20000000;
  }
  return word;
}

function arm64_vec3diff(buf: i32[], rd: i32, rn: i32, rm: i32, opcode: i32, size: i32, q: boolean, u: boolean): i32[] {
  return arm64_le32(buf, arm64_vec3diff_word(rd, rn, rm, opcode, size, q, u));
}

// arm64_vec2misc encodes two-register miscellaneous: the unary ops and the
// compare-against-zero forms, where the #0 is part of the opcode rather than
// an immediate field.
//   0x0E200800 | Q<<30 | U<<29 | size<<22 | opcode<<12 | Rn<<5 | Rd
function arm64_vec2misc_word(rd: i32, rn: i32, opcode: i32, size: i32, q: boolean, u: boolean): i64 {
  let word: i64 = 0x0e200800 | (size & 3) as i64 << 22
    | (opcode & 31) as i64 << 12 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  if (u) {
    word = word | 0x20000000;
  }
  return word;
}

function arm64_vec2misc(buf: i32[], rd: i32, rn: i32, opcode: i32, size: i32, q: boolean, u: boolean): i32[] {
  return arm64_le32(buf, arm64_vec2misc_word(rd, rn, opcode, size, q, u));
}

// The per-mnemonic tables pack U, opcode and the size mask into one entry —
// U<<12 | opcode<<4 | sizes — so a mnemonic is one lookup and `-1` answers
// "not one of these". Every size set here, and every one deliberately absent
// (mul/min/max have no .2d, the bitwise ops are byte-only), matches what GNU
// as accepts; a mask that is too wide encodes a different instruction rather
// than failing.
function arm64_vec_entry(u: boolean, opcode: i32, sizes: i32): i32 {
  let v: i32 = opcode * 16 + sizes;
  if (u) {
    v = v + 4096;
  }
  return v;
}

function arm64_vec_entry_u(e: i32): boolean {
  return e >= 4096;
}

function arm64_vec_entry_op(e: i32): i32 {
  return e % 4096 / 16;
}

function arm64_vec_entry_sizes(e: i32): i32 {
  return e % 16;
}

// BEGIN GENERATED ARM64 V3INT_ENTRY TABLE (cmd/arm64tblgen) — do not edit by hand.
// Three-register integer ops. 15 = BHSD, 7 = BHS.
function arm64_v3int_entry(mnem: string): i32 {
  match (mnem) {
    "add" => {
      return arm64_vec_entry(false, 16, 15);
    },
    "sub" => {
      return arm64_vec_entry(true, 16, 15);
    },
    "mul" => {
      return arm64_vec_entry(false, 19, 7);
    },
    "cmeq" => {
      return arm64_vec_entry(true, 17, 15);
    },
    "cmtst" => {
      return arm64_vec_entry(false, 17, 15);
    },
    "cmgt" => {
      return arm64_vec_entry(false, 6, 15);
    },
    "cmge" => {
      return arm64_vec_entry(false, 7, 15);
    },
    "cmhi" => {
      return arm64_vec_entry(true, 6, 15);
    },
    "cmhs" => {
      return arm64_vec_entry(true, 7, 15);
    },
    "smax" => {
      return arm64_vec_entry(false, 12, 7);
    },
    "smin" => {
      return arm64_vec_entry(false, 13, 7);
    },
