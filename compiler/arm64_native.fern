// arm64_gas_shll_kind returns the packed kind for a shift mnemonic, or -1 for an unknown mnemonic.
function arm64_gas_shll_kind(mnem: string): i32 {
  match (mnem) {
    "sshll" => {
      return 0;
    },
    "sshll2" => {
      return 2;
    },
    "ushll" => {
      return 1;
    },
    "ushll2" => {
      return 3;
    },
    "sxtl" => {
      return 4;
    },
    "sxtl2" => {
      return 6;
    },
    "uxtl" => {
      return 5;
    },
    "uxtl2" => {
      return 7;
    },
    _ => {
      return 0 - 1;
    }
